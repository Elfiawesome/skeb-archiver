ds/origins/df56adbe-8606-468d-9f6f-bb508c18e374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8387ef0b5ccc7cf23536a43cf5ad962a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mugennosuna01/works/46", "thumbnail_src": "https://si.imgix.net/5c6a7d2e/uploads/origins/6b76e9e0-fc5e-4646-be67-8172ac6a4880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82bed5f495a5faacde25403d4244680d", "thumbnail_srcset": "https://si.imgix.net/5c6a7d2e/uploads/origins/6b76e9e0-fc5e-4646-be67-8172ac6a4880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82bed5f495a5faacde25403d4244680d, https://si.imgix.net/5c6a7d2e/uploads/origins/6b76e9e0-fc5e-4646-be67-8172ac6a4880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=465788b6592f2d9410e3db0b284796bd 2x, https://si.imgix.net/5c6a7d2e/uploads/origins/6b76e9e0-fc5e-4646-be67-8172ac6a4880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12995cec19453b79ebff96560532b304 3x", "genre": "art", "nsfw": true, "body": "こんにちは。無限の須田時計さん、\n普段Xとpixivの絵をよく見ています。\n\n無限の須田時計さんの絵が大好きでリクエストを申し込もうと思います。\n\n不知火舞ちゃんとテリーのラブラブエッチする様子、\nキスをして中出しする様子お願いします。\n（舞ちゃんの服はkofの方、おっぱいと膣が露出。\nテリーはショタではなく普段の様子をお願いします。）\n\n*二人の仲が柔らかく優しく表現されたらいいと思います。\n\n何卒、よろしくお願いします。\n\nURL : https://gifyu.com/album/Vv8/?sort=title_asc&page=1\n1. コンセプト\n2. 舞ちゃんの服装\n3. テリーの様子", "created_at": "", "completed_at": ""}, {"path": "/@Mugennosuna01/works/45", "thumbnail_src": "https://si.imgix.net/69f2bf65/uploads/origins/d9574af9-d5ea-418c-97e3-a14c30d89586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e75fddb662c7fe0ad483e3a8a8833246", "thumbnail_srcset": "https://si.imgix.net/69f2bf65/uploads/origins/d9574af9-d5ea-418c-97e3-a14c30d89586?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop