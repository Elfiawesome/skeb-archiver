ます。検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ao_madousi/works/769", "thumbnail_src": "https://si.imgix.net/aecf0e33/uploads/origins/440e564e-e5f9-4ddc-b997-01791dd21f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d8cede8ae94383c102cf1128e86e91c", "thumbnail_srcset": "https://si.imgix.net/aecf0e33/uploads/origins/440e564e-e5f9-4ddc-b997-01791dd21f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d8cede8ae94383c102cf1128e86e91c, https://si.imgix.net/aecf0e33/uploads/origins/440e564e-e5f9-4ddc-b997-01791dd21f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbac8cfa9dad6ba158e9af108f25442d 2x, https://si.imgix.net/aecf0e33/uploads/origins/440e564e-e5f9-4ddc-b997-01791dd21f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58eaf396c460adc308d71bdd17f7e43e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ao_madousi/works/768", "thumbnail_src": "https://si.imgix.net/a40246d7/uploads/origins/2f552bb4-fa6c-4b51-8054-1fbeba7d3346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99af58e70dc8705e0298cba6abadc0bc", "thumbnail_srcset": "https://si.imgix.net/a40246d7/uploads/origins/2f552bb4-fa6c-4b51-8054-1fbeba7d3346?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99af58e70dc8705e0298cba6a