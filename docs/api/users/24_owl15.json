d&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6beddc8722902da72d61218f8d0e8c59", "thumbnail_srcset": "https://si.imgix.net/d7bb6549/uploads/origins/632f6c7d-12bc-4587-85d1-5bfe833073b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6beddc8722902da72d61218f8d0e8c59, https://si.imgix.net/d7bb6549/uploads/origins/632f6c7d-12bc-4587-85d1-5bfe833073b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c210aeb8b4d340fad2d0f54edf868e6 2x, https://si.imgix.net/d7bb6549/uploads/origins/632f6c7d-12bc-4587-85d1-5bfe833073b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2390af085fb25173fcd9ee6370d5a282 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@24_owl15/works/112", "thumbnail_src": "https://si.imgix.net/1e005e0a/uploads/origins/f2ab17a6-2e72-4a34-81cc-4adc989d506d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd1a5a29d51621925df9333dbe81fa6b", "thumbnail_srcset": "https://si.imgix.net/1e005e0a/uploads/origins/f2ab17a6-2e72-4a34-81cc-4adc989d506d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd1a5a29d51621925df9333dbe81fa6b, https://si.imgix.net/1e005e0a/uploads/origins/f2ab17a6-2e72-4a34-81cc-4adc989d506d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=726a392b16ffcda1b3864345f44f3eb3 2x, https://si.imgix.net/1e005e0a/uploads/origins/f2ab17a6-2e72-4a34-81cc-4adc989d506d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d65b61f24c1bc406ddda602630f3b794 3x", "genre": "art", "nsfw": false, "body": "Vtuberの苺野みるきぃちゃんのファンアートを描いて欲しくてリクエストします！✨\nご本人様の配信でのサムネやSNSなどで使ってもらいたいので人物のみがあるPSDファイルで頂けたら嬉しいです。\n\n苺野みるきぃちゃんの待つテーマを元に、あと細かいところはみづさんのおまかせで描いてください☺️\n\n必要テーマは〜\n全体のイメージカラーとしてはパステルピンク\n後は濃度が違うピンク系など使いつつ少し差し色でマット系の茶色を使ったりも可\n\n１．ほっぺに白いそばかす(位置やそばかす量はVキャラ参照)\n２．髪型は足首ぐらいまでの長さでゆらゆらしたウェーブのボリュームがあるロングツインテ(毛先がハートになるかどうかは自由)\n3．頭にショートケーキとリボン、髪にはマカロンが絡んでいる感じ(ミニキャラ参照)\n4．ドレスの全体イメージはマリーアントワネット風\n上半身はコルセットがあると良く、スカートの前の部分はミニスカートになるような感じで、ガーターはおまかせ、靴は全体にあうリボン付きのヒールだと良いです。\n5．尻尾(ストレートタイプ)にはリボンがついてるととても嬉しいです🐈🎀\n6．Vキャラくらいのスリーサイズでナイスボディにして欲しいです(お胸サイズは品の良い形で大きいと良き♡)\n\n資料\nミニキャラ\nhttps://x.com/YoroshikuMyun/status/1822193682306466084/photo/1\nVキャラ\nhttps://www.youtube.com/watch?v=Ljj7ntQHVYw\n\nそしてまたもしよければ前回のファンアートのご依頼でもお願いしたチビキャラがあったら嬉しいです！✨よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@24_owl15/works/111", "thumbnail_src": "https://si.imgix.net/6f85e4ff/uploads/origins/252e4f64-8c80-4caa-8406-83d64de46678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc12dd30074c31d06b2127237fe104e", "thumbnail_srcset": "https://si.imgix.net/6f85e4ff/uploads/origins/252e4f64-8c80-4caa-8406-83d64de46678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcc12dd30074c31d06b2127237fe104e, https://si.imgix.net/6f85e4ff/uploads/origins/252e4f64-8c80-4caa-8406-83d64de46678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d10c04a91fc177d49c8e29a3dfd708a 2x, https://si.imgix.net/6f85e4ff/uploads/origins/252e4f64-8c80-4caa-8406-83d64de46678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26a81b91ca8356ee48fcf504f49aab57 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！\nあなたの作品はとても美しいです！FF14のもう一人のOCのために、また作品をお願いしたいです。\n\n女性のエレゼン（エルフ）です。彼女は大人です：\nhttps://drive.google.com/drive/folders/1jdwN9RYFTSXo9FnJsVst_eKX4Jx67poI?usp=sharing\n長身でスレンダー、バストサイズはCカップ。目の色はピンク。髪の色は深い黒。メイクは口紅とアイシャドウ。\n\n服装は自由に選べるが、スカート、ガーターベルト付きストッキング、参考資料のネックレスとチョーカー（クリスタルは瞳と同じ色）が必須。足元を見せる場合は、参考資料のハイヒールを選んでください。\n\nポーズはお任せしますが、ストッキングを履いた太ももが見えるようにしてください。\nまた、背景付きでお願いします。\nそしてポートレートで描いてください。\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@24_owl15/works/110", "thumbnail_src": "https://si.imgix.net/62020961/uploads/origins/8a4e2d1f-2c1e-45ce-b3b6-eaff2c7685e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55dab32fd77ed9cf0924e2dce4108f02", "thumbnail_srcset": "https://si.imgix.net/62020961/uploads/origins/8a4e2d1f-2c1e-45ce-b3b6-eaff2c7685e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55dab32fd77ed9cf0924e2dce4108f02, https://si.imgix.net/62020961/uploads/origins/8a4e2d1f-2c1e-45ce-b3b6-eaff2c7685e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e52e707852a20bf22195873a9d2e8e70 2x, https://si.imgix.net/62020961/uploads/origins/8a4e2d1f-2c1e-45ce-b3b6-eaff2c7685e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62051253e4e794bb24c97669fd247033 3x", "genre": "art", "nsfw": false, "body": "初めまして。普段からこよちゃんなど素敵なイラストを拝見しぜひご依頼したいと思い連絡させていただきました。\n【依頼内容】\n推しの個人VtuberのMirea Sheltzsさんのイラストを描いて頂きたいです。\nMirea Sheltzsさんの二次創作に関する規約の範囲で服装やポーズ等はお任せ致します。\n\n■参考資料\nMirea Sheltzsさんの三面図等\nhttps://twitter.com/Mirea_Sheltzs\nMirea Sheltzsさんの二次創作に関する規約\nhttps://twpf.jp/Mirea_Sheltzs\n\n【使用用途】\nご本人様へのプレゼント。\nご本人様に限り配信活動（配信内や、配信のサムネ、X(旧Twitter)、FANBOX等）で使用する可能性がありますので、許可を頂ければと願います。\n\n背景等を付けていただける場合は、透過のデータも含めて納品いただけますとありがたいです。\n背景なしでも問題ありません。\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@24_owl15/works/109", "thumbnail_src": "https://si.imgix.net/64a3de4b/uploads/origins/5a9f81e9-7486-4c46-a5ae-edfee1317708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e189eac2fe68b8c85cca095511c74d3", "thumbnail_srcset": "https://si.imgix.net/64a3de4b/uploads/origins/5a9f81e9-7486-4c46-a5ae-edfee1317708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e189eac2fe68b8c85cca095511c74d3, https://si.imgix.net/64a3de4b/uploads/origins/5a9f81e9-7486-4c46-a5ae-edfee1317708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5061205e144080af589ac36ad0506bac 2x, https://si.imgix.net/64a3de4b/uploads/origins/5a9f81e9-7486-4c46-a5ae-edfee1317708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d619b45805bd31af2c969a8a7e7bdf 3x", "genre": "art", "nsfw": false, "body": "みづ様\n\n今回はとてもお気に入りの衣装をまとった私のキャラを描いて欲しくてご依頼させて頂きます。\nhttps://x.com/usa_lucil/status/1856499557095616726?s=46&t=Fuiv1NYsmLbxmFWI_u2erA\nまたみづさんの以前の作品の中でちょこさんの学生服でシャツのボタンが弾けとぶ演出がありましたが、是非それをやって頂けたら幸いです♡\n基本的にはみづさんの好きに楽しんで描いていただけたらと思うので全ておまかせします。\nどうぞ本年もよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@24_owl15/works/108", "thumbnail_src": "https://si.imgix.net/32eeca71/uploads/origins/3208c2cd-6482-42fd-a8a6-4a64a89eb549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34bc823bdb00bbfc5429d83ded890c73", "thumbnail_srcset": "https://si.imgix.net/32eeca71/uploads/origins/3208c2cd-6482-42fd-a8a6-4a64a89eb549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34bc823bdb00bbfc5429d83ded890c73, https://si.imgix.net/32eeca71/uploads/origins/3208c2cd-6482-42fd-a8a6-4a64a89eb549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9ce066ad2c36e73aee687d61f5f6bcc 2x, https://si.imgix.net/32eeca71/uploads/origins/3208c2cd-6482-42fd-a8a6-4a64a89eb549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8d88e1c4bcc5188939cb4bf04b0ffaa 3x", "genre": "art", "nsfw": false, "body": "みづ先生、初めまして\n\nいつも様々なシチュエーションのイラストを見て、元気をもらっています\n\nこの度、Twitter等のアイコン用に自分仕様にした開拓者を書いて頂きたく依頼致しました\n\n開拓者の仕様として\n・試験管を込めたカートリッジベルト\n・首にヘッドホンをかけている\n　デザインはおまかせ致します\n\n読書の秋っぽい感じでおまかせしたいです\n再送致しますので、よろしくお願いします\n\n参考資料\n開拓者\nhttps://twitter.com/AZKi_VDiVA/status/1725882906772656450\nカートリッジベルト\nhttps://drive.google.com/file/d/1XxT3cuW2i_-XvnERwyLWfHpHBSB8hc0e/view?usp=drive_link", "created_at": "", "completed_at": ""}