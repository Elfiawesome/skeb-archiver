origins/bfd16b72-fa9f-4fa2-a01a-4544efde0e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a311dd37df061d86d28bbe62563b805e 2x, https://si.imgix.net/40268a51/uploads/origins/bfd16b72-fa9f-4fa2-a01a-4544efde0e27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa82d00c48e39bc9c02d0b8b8ba4cea4 3x", "genre": "art", "nsfw": false, "body": "maimaiの百合咲ミカをお願いします。\n構図などはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@wagomu2/works/2", "thumbnail_src": "https://si.imgix.net/2dd99175/uploads/origins/1ed8bac8-a921-4514-912b-9dba7ac8d7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47b95d25e6163762c7f02a9c9b57d4c", "thumbnail_srcset": "https://si.imgix.net/2dd99175/uploads/origins/1ed8bac8-a921-4514-912b-9dba7ac8d7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47b95d25e6163762c7f02a9c9b57d4c, https://si.imgix.net/2dd99175/uploads/origins/1ed8bac8-a921-4514-912b-9dba7ac8d7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54d1289e9365765b2611f211d3102df8 2x, https://si.imgix.net/2dd99175/uploads/origins/1ed8bac8-a921-4514-912b-9dba7ac8d7ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10e48388827e9266d567c3c80392cbd1 3x", "genre": "art", "nsfw": false, "body": "柏木美亜ちゃんお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@wagomu2/works/1", "thumbnail_src": "https://si.imgix.net/43844220/uploads/origins/52d473d2-3306-44c9-b259-a01cb553311c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a37a73199376aaa2687c4b1e8945402", "thumbnail_srcset": "https://si.imgix.net/43844220/uploads/origins/52d473d2-3306-44c9-b259-a01cb553311c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a37a73199376aaa2687c4b1e8945402, https://si.imgix.net/43844220/uploads/origins/52d473d2-3306-44c9-b259-a01cb553311c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=