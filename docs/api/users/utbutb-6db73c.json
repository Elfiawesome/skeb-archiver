き物をスリッパに指定しています)\n\nキャラクター\nご注文はうさぎですか？\nチノちゃん\n\n服装\n学校の制服、ディアンドル衣装もしくは白いワンピース\n足元ですが学校や病院にある緑色の来客用スリッパを履いている状態でお願いします\n(また全身が写っている状態でお願いしたいです)\n\n背景\nコンクリート調の部屋、木組の街、草原等\n\n以上、スリッパを履いている女の子が好きで毎回似たような内容になりますが今回も描いてもらえると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@utbutb/works/164", "thumbnail_src": "https://si.imgix.net/7a23723b/uploads/origins/908d518a-5dcb-4ca2-8bae-e84e7f668a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9cbe8b807a29f325304947c104f0c0d", "thumbnail_srcset": "https://si.imgix.net/7a23723b/uploads/origins/908d518a-5dcb-4ca2-8bae-e84e7f668a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9cbe8b807a29f325304947c104f0c0d, https://si.imgix.net/7a23723b/uploads/origins/908d518a-5dcb-4ca2-8bae-e84e7f668a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0c8bac6ec4db628b230f5c0fb2219d3 2x, https://si.imgix.net/7a23723b/uploads/origins/908d518a-5dcb-4ca2-8bae-e84e7f668a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0ee4ad88f9b651e3eb12c99b828c06e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@utbutb/works/163", "thumbnail_src": "https://si.imgix.net/4ba30258/uploads/origins/6e1984f5-ea5e-4b8f-9ddd-89aea6d7f2e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36d4496edad661a2fcde112188429c2c", "thumbnail_srcset": "https://si.imgix.net/4ba30258/uploads/origins/6e1984f5-ea5e-4b8f-9ddd-89aea6d7f2e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36d4496edad