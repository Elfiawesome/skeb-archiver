5b84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc9df1018f298b99981314673bf7431b 3x", "genre": "comic", "nsfw": true, "body": "私のキャラクターは、門の点検、盗賊、あるいはその他の出来事によって、装備品や衣服をすべて失ってしまった。\n\nしかし、彼女は全裸になり、町から家までこっそり戻らなければならなくなり、友人と会ってから隠れようとするが、捕まってしまい、通り抜けようとするが、結局捕まってしまい、罰として、彼女がとても好きそうなので、体を見せることを強要される。\n\nそして結局、彼女は罰を楽しんでいるようだ。\n人々は裸の女の子を見ることができ、彼女も裸を見られて喜んでいる。\n\nhttps://drive.google.com/file/d/17FK1KjxCzADLvDI0a1W6r7zi5C1SRWBi/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/43", "thumbnail_src": "https://si.imgix.net/74d3cae5/uploads/origins/cd4a3f23-0583-4bb9-a45d-7782964bcbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97606820d31520126d21a87345e90394", "thumbnail_srcset": "https://si.imgix.net/74d3cae5/uploads/origins/cd4a3f23-0583-4bb9-a45d-7782964bcbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=97606820d31520126d21a87345e90394, https://si.imgix.net/74d3cae5/uploads/origins/cd4a3f23-0583-4bb9-a45d-7782964bcbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31a60901a585aa93dae54ff86d5cce88 2x, https://si.imgix.net/74d3cae5/uploads/origins/cd4a3f23-0583-4bb9-a45d-7782964bcbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2cf9d95a4c480e8e1951b9e27ac69e46 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/42", "thumbnail_src": "https://si.imgix.net/0bd1c95d/uploads/origins/df642a6d-8afc-42e0-8bfd-ff4ec8dcd6a3?bg=%23fff&auto=format%2C