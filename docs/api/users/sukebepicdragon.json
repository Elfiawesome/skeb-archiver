talign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ae19e38d37e08d24b3aa0a77eb4c50d 2x, https://si.imgix.net/04caa1f8/uploads/origins/0d62d0a3-9607-493e-89f1-92f33baf719f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfea54dc9265c300ed7ed0554cda3cd1 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/40", "thumbnail_src": "https://si.imgix.net/307917e9/uploads/origins/47638c2f-1769-40fd-9fc7-6835999370e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed25b5e2210bc10a0681d7814ca977f2", "thumbnail_srcset": "https://si.imgix.net/307917e9/uploads/origins/47638c2f-1769-40fd-9fc7-6835999370e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed25b5e2210bc10a0681d7814ca977f2, https://si.imgix.net/307917e9/uploads/origins/47638c2f-1769-40fd-9fc7-6835999370e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=781a7cc15369468e10faeb30cd749e0e 2x, https://si.imgix.net/307917e9/uploads/origins/47638c2f-1769-40fd-9fc7-6835999370e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac9c6d4e43057ae0579920d5d684ffd7 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/39", "thumbnail_src": "https://si.imgix.net/46e4d4c3/uploads/origins/3cc87479-9101-43d3-b2c9-8103a740fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65c59b845ba69b545c545b8b8e8c6de", "thumbnail_srcset": "https://si.imgix.net/46e4d4c3/uploads/origins/3cc87479-9101-43d3-b2c9-8103a740fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65c59b845ba69b545c545b8b8e8c6de, https://si.imgix.net/46e4d4c3/uploads/origins/3cc87479-9101-43d3-b2c9-8103a740fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cefa1e8e60fbb60ba8dba26961db7ffa 2x, https://si.imgix.net/46e4d4c3/uploads/origins/3cc87479-9101-43d3-b2c9-8103a740fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85dce814ff4f8c4a30af6b18a79fb3f3 3x", "genre": "comic", "nsfw": true, "body": "Twitterに投稿されてたしゅがみんが子宝の湯でおじさんたちに囲まれるイラスト（https://x.com/sukebepicdragon/status/1782821549835448673）の続きが見たいです。\nしゅがみんが秘湯で村の人達に犯されまくる漫画を2ページほどお願いします。\nおじさん達に囲まれて胸揉まれたり膣弄られたりする2人。\n子宝の湯の理由はワシらが入ってきたお嬢さん達を全員孕ませてるからじゃよwwwと笑いながら2人にしゃぶらせるおじさん達。\nその後、地面にタオルや手ぬぐい敷いて2人を寝かせ生本番。周りの男たちも手や口を使っていく。\nいろんな体位で犯して中出しさせまくってください。\n・温泉の中でパチャパチャ音たてながら立ちバック（https://blog-imgs-167.fc2.com/h/n/a/hnalady/onsen3_36.jpg）\n・湯べりに座って背面座位（https://img2.erogazou.gallery/article3/780/b/06.jpg）\nなどがあると嬉しいです。\n最後は膣からコポコポ大量の精液垂れ流してる2人をお願いします。\nこの内容でいけるようでしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/38", "thumbnail_src": "https://si.imgix.net/c3e1a829/uploads/origins/753f7b1b-0662-41af-a6ba-d30c4c85fcfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa02ff14c1be1aec5282203638ce97a", "thumbnail_srcset": "https://si.imgix.net/c3e1a829/uploads/origins/753f7b1b-0662-41af-a6ba-d30c4c85fcfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aa02ff14c1be1aec5282203638ce97a, https://si.imgix.net/c3e1a829/uploads/origins/753f7b1b-0662-41af-a6ba-d30c4c85fcfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75e68a877e772bef8d9e93132b10cb21 2x, https://si.imgix.net/c3e1a829/uploads/origins/753f7b1b-0662-41af-a6ba-d30c4c85fcfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d92e341621a7775889968985afd54c21 3x", "genre": "art", "nsfw": true, "body": "シンデレラガールズの佐々木千枝とそのお母さん（千枝ママ）の母娘乱交漫画を2ページくらいでお願いします。\n以前描かれた千枝と千枝ママの母娘ちつくらべ（https://twitter.com/sukebepicdragon/status/1360247578844045313/photo/1）のお股見せつけダブルピースの比べっこが股間に効きました。\nこの写真の続きで実際の使い心地も比べてみようとスタッフ達が母娘に何度もズボズボハメまくってるシーンをお願いしたいです。\n千枝はギチギチに締め付ける感じ、千枝ママはにゅるにゅると絡みつく感じという感想をスタッフ達がパンパン突きながらコメントする。\n中出しした後は出した穴の方にお掃除フェラしてもらいすぐに次のスタッフが挿入。我慢できずにぶっかけたり口内射精する者も。\nスタッフ全員が2人を味わい尽くしたところで終了。全身ベトベト、膣からボトボト精液垂らしながら最初のポーズと同じように膣を見せつけながらピースする2人で〆。\n細かいところはトカゲさんが描きやすいように変えてもらって構いません。\n2人は気持ち良さそうに楽しんでる感じでお願いします。\nこの内容で問題ないようでしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/37", "thumbnail_src": "https://si.imgix.net/efcdeb8f/uploads/origins/ed280aad-383e-405b-abad-09558507b5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bfcc97c0598b4fdb4e5a78c0e8694b6", "thumbnail_srcset": "https://si.imgix.net/efcdeb8f/uploads/origins/ed280aad-383e-405b-abad-09558507b5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bfcc97c0598b4fdb4e5a78c0e8694b6, https://si.imgix.net/efcdeb8f/uploads/origins/ed280aad-383e-405b-abad-09558507b5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f46986801893c520ccbbdfdc9ac8fb0 2x, https://si.imgix.net/efcdeb8f/uploads/origins/ed280aad-383e-405b-abad-09558507b5b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb01c4c55a3139c650de53887c836a48 3x", "genre": "art", "nsfw": true, "body": "再送させていただきます\n\nデレマスの棟方愛海が首輪はめられて自分からプロデューサーのオナホ兼ペットにされいるイラストをお願いします\n衣装は無しでもエロ下着でも何か描きやすいもので大丈夫です", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/36", "thumbnail_src": "https://si.imgix.net/06921da2/uploads/origins/e9addf9c-6702-4bd5-9568-452a5ae2a881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48abc4dbbc7d774eff5759738b16edca", "thumbnail_srcset": "https://si.imgix.net/06921da2/uploads/origins/e9addf9c-6702-4bd5-9568-452a5ae2a881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48abc4dbbc7d774eff5759738b16edca, https://si.imgix.net/06921da2/uploads/origins/e9addf9c-6702-4bd5-9568-452a5ae2a881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7560a5a0cbcf22d907c30a3e7284aa01 2x, https://si.imgix.net/06921da2/uploads/origins/e9addf9c-6702-4bd5-9568-452a5ae2a881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a85a516e817f279e699319e108e7b215 3x", "genre": "art", "nsfw": true, "body": "和久井留美さんでアイドルになる前の秘書時代に接待で女体盛りをさせられていたという内容でお願いします。希望としては\n1.いつものスーツ姿の留美さんが社長から「今回の接待は君に働いてもらうよ」と言われて、留美さんは「かしこまりました」とお辞儀をして了承する。\n2.接待場の料亭の厨房で全裸になる留美さん\n3.宴会場に刺身を盛り付けられて女体盛りになった留美さんが運ばれてくる。股間にはバイブが挿入されて動いているが、留美さんは女体盛りとしてクール表情を変えずに耐えている……\nというような感じだと嬉しいです。\n出来ればよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/35", "thumbnail_src": "https://si.imgix.net/0aec7e70/uploads/origins/88732c56-15b6-44c2-a068-b1a38f1ad4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bce58e50b8037e9327985554574d2a25", "thumbnail_srcset": "https://si.imgix.net/0aec7e70/uploads/origins/88732c56-15b6-44c2-a068-b1a38f1ad4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bce58e50b8037e9327985554574d2a25, https://si.imgix.net/0aec7e70/uploads/origins/88732c56-15b6-44c2-a068-b1a38f1ad4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc7e0e39856fd2462c9acadc535bdb37 2x, https://si.imgix.net/0aec7e70/uploads/origins/88732c56-15b6-44c2-a068-b1a38f1ad4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3482f50a809d60e39747ccbadf52e3f3 3x", "genre": "art", "nsfw": true, "body": "1、2ページのひたすらアイドル達がパコパコしまくる漫画をお願いします。1ページ分の料金で送っていますがもし2ページいけるようでしたら御手数ですが料金変更の再送をお願いします、\nビートシューターが腹ボテになるイラスト（https://twitter.com/sukebepicdragon/status/1679898165917679617）がえっちで好きです。\n1ページ目はこの2人がボテ腹になるまでヤリまくってる様子の漫画をお願いします。服を着たままか脱がすかはトカゲさんの描きやすい方でお願いします。ひたすら中出しさせちゃってください。\n2ページ目はボテ腹になった2人をハメ撮り（グラビアの写真や動画撮り）しながらの乱交でお願いします。腹ボテがわかりやすいようにマイクロビキニなどの腹だしのコスチュームでお願いします。こちらは中出しだけでなく顔射やボテ腹へのぶっかけもお願いします。\nこの内容でよろしければぜひお願いしたいです。\n\nhttps://twitter.com/sukebepicdragon/status/1679898165917679617", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/34", "thumbnail_src": "https://si.imgix.net/de25bea0/uploads/origins/68264f1d-40ff-4703-9c10-c126bc400f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86c2f19e23e817f86467a866a6b8b378", "thumbnail_srcset": "https://si.imgix.net/de25bea0/uploads/origins/68264f1d-40ff-4703-9c10-c126bc400f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86c2f19e23e817f86467a866a6b8b378, https://si.imgix.net/de25bea0/uploads/origins/68264f1d-40ff-4703-9c10-c126bc400f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0a6b2a3ae93f08caab214cf40be2ad6 2x, https://si.imgix.net/de25bea0/uploads/origins/68264f1d-40ff-4703-9c10-c126bc400f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2326e40d3fce07fccc749e89fa73303 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n神々しくも妖艶な依田芳乃が、男達の為に朝まで４Ｐ乱交するシチュをお願いしたいです\n\nシチュ概要\n下記URLの\n願掛け・失せもの捜し等を性交を通じて叶えている、慈愛と妖艶さを併せ持つ\nよしのんが人里離れた屋敷にてショタ、青年、おじさんとまぐわうシチュの続きで\n\n・１ラウンド後休憩を終え、ますます昂る男達の欲望を全身白濁まみれで受け止め、それに巧みな性技で応えていくよしのん\n◎芳乃はスカウト前ー現在より浮世離れ度強めで慈愛の女神っぽい　器量堂々としつつも蠱惑的ーあまり表情を崩し過ぎず、艶やかでそそられるリアクション\n◎男達にとって芳乃は崇拝・祈願する対象ゆえ、行為はエロエロでも彼女への無礼はＮＧ\n\nシーン\n◎取り囲む三本肉棒を交互に舐めしゃぶりまくりしごきまくり、立て続けに抜きまくり飲みまくり（口内→顔射→舌載せ発射）\n◎大人二人で駅弁二穴サンドイッチ＋抜かず連発ピストンで泡立つザーメン飛び散る結合部とそれを生唾を飲みつつ眺め、その様子を語るショタ\n〇縦割り３コマで三者三様正常位フィニッシュ\n〇事後、皆で大浴場にてまったり「みなさま、おつかれさまでしてー」\n\nボリュームに無理がありそうなら◎のところだけでぶった切ってかまいません\nひとつよろしくお願いいたします\n\nhttps://skeb.jp/@trok_mebachi/works/20", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/33", "thumbnail_src": "https://si.imgix.net/49920b83/uploads/origins/bf333252-9127-4991-811a-c7f4b4ffe132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f8134d96a20253d55190de384981a2", "thumbnail_srcset": "https://si.imgix.net/49920b83/uploads/origins/bf333252-9127-4991-811a-c7f4b4ffe132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f8134d96a20253d55190de384981a2, https://si.imgix.net/49920b83/uploads/origins/bf333252-9127-4991-811a-c7f4b4ffe132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc0c4efd618be1521f843041a899c5b5 2x, https://si.imgix.net/49920b83/uploads/origins/bf333252-9127-4991-811a-c7f4b4ffe132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb3e7c2a7046a87235063e7d92f46927 3x", "genre": "art", "nsfw": true, "body": "以前ダークイルミネイトのパンツこうかんぶを描かれていましたが、それの上条春菜、荒木比奈のサイバーグラス版をよろしくお願い致します。\n\nhttps://twitter.com/sukebepicdragon/status/1640416973812273153?t=-C9jN7PeF7dRqnaAIl1zmw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/32", "thumbnail_src": "https://si.imgix.net/bc2736d4/uploads/origins/5cbc0ba1-be0e-4370-a453-e115754df15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3d17f23eaaeb882ba74204379a9594b", "thumbnail_srcset": "https://si.imgix.net/bc2736d4/uploads/origins/5cbc0ba1-be0e-4370-a453-e115754df15a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3d17f23eaaeb882ba74204379a9594b, https://si.imgix.net/bc2736d4/uploads/origins/5cbc0ba1-be0e-4370-a453-e115754df15a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2597941d73584498d0d54937f7710688 2x, https://si.imgix.net/bc2736d4/uploads/origins/5cbc0ba1-be0e-4370-a453-e115754df15a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd37cf2b534fb999bc3e5c3b2e5e7968 3x", "genre": "art", "nsfw": true, "body": "Twitterで出されていた男湯から出てくる結城晴（https://twitter.com/sukebepicdragon/status/1643294627800428544）の尻穴とマンすじがめっちゃエロかったです。\n男湯に混ざって入っている晴が興奮した周りの男たちと風呂場でヤリまくる1、2ページのマンガをお願いします。\n正常位やバックで突かれながら手や口で男たちのちんこをしごいたりしゃぶったりしているシーンがあると嬉しいです。\n晴はエロい事されてもしょーがねーなーみたいな感じで嫌がらずに付き合ってくれる。\n露天風呂やサウナ、更衣室など風呂場以外でもやってるシーンがあると嬉しいです。\n最後は仰向けにひっくり返ったカエルみたいなポーズで膣や口から精液ドロドロ垂らしながらイッてる晴でお願いします。\nもし2ページ描けるようでしたらページ分の金額に変更したいのでお手数ですが金額変更の再送をお願いします。\nこの内容で描けるようでしたら是非お願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/31", "thumbnail_src": "https://si.imgix.net/a3497da5/uploads/origins/0d6957f5-59ab-4b24-91ad-b87aa86e489a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=265c4f3f98f7696d391fe7903a9eb3be", "thumbnail_srcset": "https://si.imgix.net/a3497da5/uploads/origins/0d6957f5-59ab-4b24-91ad-b87aa86e489a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=265c4f3f98f7696d391fe7903a9eb3be, https://si.imgix.net/a3497da5/uploads/origins/0d6957f5-59ab-4b24-91ad-b87aa86e489a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3cb13576e7e52664d4e529dae1efe28 2x, https://si.imgix.net/a3497da5/uploads/origins/0d6957f5-59ab-4b24-91ad-b87aa86e489a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cf9e58625cd39712e52af6e45043b42 3x", "genre": "art", "nsfw": true, "body": "こんにちは、以前G11をお願いした者です。とても良い作品をありがとうございました。\n良ければまたリクエストしたい物があります。\nモノクロでお願いします。\n\n以前のG11(今回は帽子も無しで良いです)で、以下の作品の下コマと殆ど同じような激しい仰け反りセックスが見たいです。\nhttps://skeb.jp/@sukebepicdragon/works/10\n左に断面図、結合部大アップ、舌出し仰け反りで唾液を飛ばして喘ぐなど、そのまま同じで良いです。\n「しっしぬ♡しぬうう♡♡」のようなセリフも交えて欲しいです。\nにゅぐっにゅるっといった擬音、ねとねとの愛液もかなり大量に飛び散っていると嬉しいです。\n出来れば中出し差分があると助かります。\n\n良ければご検討下さい。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/30", "thumbnail_src": "https://si.imgix.net/11fa145b/uploads/origins/d8c67af1-1e27-424d-9a30-ecf26391f1cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a264f04cac515f051166859bbeafc4a", "thumbnail_srcset": "https://si.imgix.net/11fa145b/uploads/origins/d8c67af1-1e27-424d-9a30-ecf26391f1cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a264f04cac515f051166859bbeafc4a, https://si.imgix.net/11fa145b/uploads/origins/d8c67af1-1e27-424d-9a30-ecf26391f1cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbb1dac4a3532f88be6295ea60d30905 2x, https://si.imgix.net/11fa145b/uploads/origins/d8c67af1-1e27-424d-9a30-ecf26391f1cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=328bf6a3865419fe52feae89437dcb13 3x", "genre": "art", "nsfw": true, "body": "デレマスの棟方愛海が、イスに座ったプロデューサーにフェラをして、口内射精され精液を飲んでくれていて、その後、お掃除フェラでぺろぺろと舐めて綺麗にしてくれながら、「いっぱい精子でたね」みたいな事を言い、気持ち良くなってくれた事に無邪気に喜んでいるシチュエーションのイラストをお願いします。\n可能ならフェラしている愛海を見たプロデューサーが、本当はダメだとは思いつつも快楽に溺れて、その行動を止める事をできずに頭の中で葛藤している描写もあれば嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/29", "thumbnail_src": "https://si.imgix.net/a223d65e/uploads/origins/4c36d773-573b-411b-a1c9-8d32dae8a40e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed0b189aaa4d9894bee012089f9393ac", "thumbnail_srcset": "https://si.imgix.net/a223d65e/uploads/origins/4c36d773-573b-411b-a1c9-8d32dae8a40e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed0b189aaa4d9894bee012089f9393ac, https://si.imgix.net/a223d65e/uploads/origins/4c36d773-573b-411b-a1c9-8d32dae8a40e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2ee23e104c4036447ded975738da4ca 2x, https://si.imgix.net/a223d65e/uploads/origins/4c36d773-573b-411b-a1c9-8d32dae8a40e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e3efe0d53e0a956d7260130ea38baf15 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/28", "thumbnail_src": "https://si.imgix.net/808bd349/uploads/origins/85897c6b-8988-4358-8cbf-3bebe42b6006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65fc2809d2d4913ae752d18b347ed7a1", "thumbnail_srcset": "https://si.imgix.net/808bd349/uploads/origins/85897c6b-8988-4358-8cbf-3bebe42b6006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65fc2809d2d4913ae752d18b347ed7a1, https://si.imgix.net/808bd349/uploads/origins/85897c6b-8988-4358-8cbf-3bebe42b6006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a26d857890cb12c8100e33df9392c270 2x, https://si.imgix.net/808bd349/uploads/origins/85897c6b-8988-4358-8cbf-3bebe42b6006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b33fd6ea082ca147d19d4ffd920816e 3x", "genre": "art", "nsfw": true, "body": "リクエストさせていただきます。\n\nアイドル\n夢見りあむ\n\nシチュエーション\n童貞卒業企画で現役相撲力士(りあむと同い年)とセックスが決まったりあむ。不満たらたらなりあむだが、ベッドの上で全裸セックスを開始すると即堕ちする。\n\n激しいセックスの後二人は添い寝。りあむは小動物のように力士に寄り、力士はりあむの頭を撫でる。\n\n以上です。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/27", "thumbnail_src": "https://si.imgix.net/276b1382/uploads/origins/983a0f50-0ad9-48c5-b93d-fa2eb2941c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec171e3bc54df00f1343dac90b67338", "thumbnail_srcset": "https://si.imgix.net/276b1382/uploads/origins/983a0f50-0ad9-48c5-b93d-fa2eb2941c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fec171e3bc54df00f1343dac90b67338, https://si.imgix.net/276b1382/uploads/origins/983a0f50-0ad9-48c5-b93d-fa2eb2941c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62b53c1bd12b6f0ffb040d5fce3754ab 2x, https://si.imgix.net/276b1382/uploads/origins/983a0f50-0ad9-48c5-b93d-fa2eb2941c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcd9f636782bab3ac153e71c27afe588 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/26", "thumbnail_src": "https://si.imgix.net/efa17515/uploads/origins/2e2a6597-8cf7-43f4-b85e-b0e7d94f6d75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0d41fee0764fae91e71a47cec63e570", "thumbnail_srcset": "https://si.imgix.net/efa17515/uploads/origins/2e2a6597-8cf7-43f4-b85e-b0e7d94f6d75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0d41fee0764fae91e71a47cec63e570, https://si.imgix.net/efa17515/uploads/origins/2e2a6597-8cf7-43f4-b85e-b0e7d94f6d75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6369c17242f3b0601f86726581fcf43 2x, https://si.imgix.net/efa17515/uploads/origins/2e2a6597-8cf7-43f4-b85e-b0e7d94f6d75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8dd582a896470e0a535d68ede36d802 3x", "genre": "art", "nsfw": true, "body": "以前Twitterで投稿されたかな子と菜帆の裸ピクニック（https://mobile.twitter.com/sukebepicdragon/status/1590371781680181248）の漫画をお願いしたいです。\n裸ピクニック場のフリーセックス会場に行った2人が参加している男たちと乱交する漫画をお願いします。2人の体型は太っている訳ではなく少しぽっちゃりくらいでお願いします。\n2人は少し恥ずかしがりながらも楽しんでセックスしている感じで描いてもらえると嬉しいです。\n乱交途中でゴムが無くなって結局中出しされちゃう2人。\n最後は口や膣にチンコを入れたまま記念写真を撮る2人と男たち（全員が入るのが難しいようならちんこと体の一部が入っている感じで）でお願いします。\n可能なようでしたら薫のSの部でのセックスシーンも2、3コマの漫画で欲しいです。こちらも描いていただけるようでしたら2ページ分の金額で依頼したいのでお手数ですが金額変更の再送をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/25", "thumbnail_src": "https://si.imgix.net/391040ce/uploads/origins/e0efcbf4-6050-442c-a1e4-890eb16ebb66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53331d78eb5cb53019ce5f66b4ab736", "thumbnail_srcset": "https://si.imgix.net/391040ce/uploads/origins/e0efcbf4-6050-442c-a1e4-890eb16ebb66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53331d78eb5cb53019ce5f66b4ab736, https://si.imgix.net/391040ce/uploads/origins/e0efcbf4-6050-442c-a1e4-890eb16ebb66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fffa92d9b9daa997a274b20f1b549dc 2x, https://si.imgix.net/391040ce/uploads/origins/e0efcbf4-6050-442c-a1e4-890eb16ebb66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52e1dc24eea5ca74350d150bab9556a9 3x", "genre": "art", "nsfw": true, "body": "他の方のリクエスト作品のしゅがみんAVパッケージ（https://skeb.jp/@sukebepicdragon/works/23）がめっちゃエロくて好きです。このAVの本編シーンを見たいです。\n·胸や尻を揉まれまくりバイブやディルドを遠慮なしに突っ込まれる\n·手コキやフェラで同時に何人も相手をしてぶっかけ\n·パッケージに書かれている野外での乱交。中出し＆お掃除フェラ\nなどをお願いします。こう描いた方がいいと思ったところは変えてしまって構いません。\nしゅがみんの服は最後まで着たままでお願いします。多少破れていたり部分的に脱げていても構いません。\n出来れば2、3ページのマンガ形式で見たいです。\nこの内容でよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/24", "thumbnail_src": "https://si.imgix.net/370123b1/uploads/origins/2d98b8a5-fb64-47ef-bb06-fb7fdbe67644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=836322a245ec48f61a5085d23e6d9b13", "thumbnail_srcset": "https://si.imgix.net/370123b1/uploads/origins/2d98b8a5-fb64-47ef-bb06-fb7fdbe67644?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=836322a245ec48f61a5085d23e6d9b13, https://si.imgix.net/370123b1/uploads/origins/2d98b8a5-fb64-47ef-bb06-fb7fdbe67644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=344539845d4fab7985ef4223ecabdd06 2x, https://si.imgix.net/370123b1/uploads/origins/2d98b8a5-fb64-47ef-bb06-fb7fdbe67644?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c417319f6e182131c0f34131a9c7e3b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/23", "thumbnail_src": "https://si.imgix.net/1507a511/uploads/origins/afa3b59e-3d02-4d7b-8acc-97177949ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a34d18874b76fd5f3cc437843f8c0185", "thumbnail_srcset": "https://si.imgix.net/1507a511/uploads/origins/afa3b59e-3d02-4d7b-8acc-97177949ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a34d18874b76fd5f3cc437843f8c0185, https://si.imgix.net/1507a511/uploads/origins/afa3b59e-3d02-4d7b-8acc-97177949ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=840a9da98f0e58bbefb6fb0682775ff9 2x, https://si.imgix.net/1507a511/uploads/origins/afa3b59e-3d02-4d7b-8acc-97177949ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b47893406cd53dbaa656f15e54b15223 3x", "genre": "art", "nsfw": true, "body": "お受け頂ければと思います。\n\n【キャラクター】\nシンデレラガールズのユニット「しゅがしゅが☆み～ん」。\n※佐藤心（新米魔法少女スウィート☆シュガー）、安部菜々（魔法少女メルヘン☆ウサミン）の2人組。\n\n【シチュエーション】\nhttps://twitter.com/sukebepicdragon/status/1571940464277979136\n↑と似た構図。「あの人気？魔法少女ユニットがファンの子どもたちとSEX」のような感じのAVパケイメージ。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/22", "thumbnail_src": "https://si.imgix.net/54ea4355/uploads/origins/2a9f203c-a264-4255-a51e-562391725a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fb735630a1eff6886914bab851dd231", "thumbnail_srcset": "https://si.imgix.net/54ea4355/uploads/origins/2a9f203c-a264-4255-a51e-562391725a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fb735630a1eff6886914bab851dd231, https://si.imgix.net/54ea4355/uploads/origins/2a9f203c-a264-4255-a51e-562391725a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d066caf5bd1c58325c5d776a02920dd8 2x, https://si.imgix.net/54ea4355/uploads/origins/2a9f203c-a264-4255-a51e-562391725a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcf35f364a8dafd83f9b6d70da5e4f79 3x", "genre": "art", "nsfw": true, "body": "以前描かれていた中野有香の黒人相手のAV風イラスト（https://sp.nijie.info/view.php?id=444151）の本編シーンのマンガが欲しいです。\nまた前半後半の2、3ページでお願いしたいです。\n前半は1体1のエロ試合をお願いします。空手着の上だけを来て下半身丸出しの友香が手マンやイラマチオでぐったりしてる間にデカくて長いちんこでガンガン突かれて中だしされ、1本負け。倒れてビクンビクンしている友香に試合開始の合図を待たず2人目が挿入、ピストンしているシーンで前半終了。\n後半ではエロ試合5戦全敗した友香が特訓として全員をいっぺんに相手する輪姦をお願いします。口、手、膣、尻穴、足やツインテールなど身体中勝手に使われてる感じで描いてくれると興奮します。ぶっかけや中出しシーンを多めに描いてくれると嬉しいです。最後は全身ドロドロのベタベタになった友香が膣や尻から精液噴き出しながら試合の礼をするポーズで終了。\nもし可能なら3枚目に資料イラストと同じ構図で撮影終了後の精液まみれになった友香が黒人たちのちんこに囲まれて跪いてるパッケージ風イラストをお願いします。こちらは可能ならばで問題ありません。\nこれらの内容と金額でよろしければ是非お願いします。\n\nhttps://sp.nijie.info/view.php?id=444151", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/21", "thumbnail_src": "https://si.imgix.net/31bab624/uploads/origins/c3f74b45-e53a-49c2-acd0-db4243fe4e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87b59f29ceaed7c7139fe56909da1419", "thumbnail_srcset": "https://si.imgix.net/31bab624/uploads/origins/c3f74b45-e53a-49c2-acd0-db4243fe4e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87b59f29ceaed7c7139fe56909da1419, https://si.imgix.net/31bab624/uploads/origins/c3f74b45-e53a-49c2-acd0-db4243fe4e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d27eb87dcb4fc85e94b2862f20811b7 2x, https://si.imgix.net/31bab624/uploads/origins/c3f74b45-e53a-49c2-acd0-db4243fe4e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4120c02581077e72bc447eee948739c7 3x", "genre": "art", "nsfw": true, "body": "デレマスの棟方愛海が、事務所でこっそりプロデューサーといちゃつきながらキスをしまくっているシチュエーションのイラストをお願いします。\n全身は描かなくてもいいので、首に手を回してのディープキス、舌を絡ませるキス、お互いの口内を味わうようにむしゃぶりついて唾液交換したりと、ねっとりベロチューしている感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/20", "thumbnail_src": "https://si.imgix.net/51434f3a/uploads/origins/2052855d-8a9c-432c-bf95-f0f6b270527c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a2d1f7be1867ba0bbfd6bf4737c507c", "thumbnail_srcset": "https://si.imgix.net/51434f3a/uploads/origins/2052855d-8a9c-432c-bf95-f0f6b270527c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a2d1f7be1867ba0bbfd6bf4737c507c, https://si.imgix.net/51434f3a/uploads/origins/2052855d-8a9c-432c-bf95-f0f6b270527c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=003d6a1b8e87f7f42c66fb145b4fa927 2x, https://si.imgix.net/51434f3a/uploads/origins/2052855d-8a9c-432c-bf95-f0f6b270527c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ae0a7b81244b7ff12d8b019dddb46c9 3x", "genre": "art", "nsfw": true, "body": "久川颯と凪\nなーちゃんはバストアップ薬を買う。はーちゃんと同じくらい胸が大きくなりたいです。\nしかし、はーちゃんは飲み物を見つけます。それが何であるかを知らず、それを飲みます。\n服が破裂しそうなほどおっぱいが大きくなる。\n怒るなーちゃんに謝ろうとするはーちゃん。しかし、シャツがギリギリと音を立て始める。\nおっぱいが再び成長すると、ボタンが破裂します。\n薬が効きすぎ！推奨用量があったのでしょうか？でも…はーちゃん、全部飲み干して…\nおっぱいは及川さんのサイズに近づいています。成長は減速の兆しを見せていません。\nはーちゃんはどこまで大きくなるの!?\n最終的なバストサイズはあなた次第です。\nありがとございます。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/19", "thumbnail_src": "https://si.imgix.net/a76ffc9f/uploads/origins/15c05bb5-ed4a-45d7-8b1b-2a48836b4de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e81d2553f8279701eb73fda2223e645", "thumbnail_srcset": "https://si.imgix.net/a76ffc9f/uploads/origins/15c05bb5-ed4a-45d7-8b1b-2a48836b4de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e81d2553f8279701eb73fda2223e645, https://si.imgix.net/a76ffc9f/uploads/origins/15c05bb5-ed4a-45d7-8b1b-2a48836b4de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=560109a95db0530743dbb450b8444267 2x, https://si.imgix.net/a76ffc9f/uploads/origins/15c05bb5-ed4a-45d7-8b1b-2a48836b4de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40fc1186c677576203b6abb76a893dee 3x", "genre": "art", "nsfw": true, "body": "リクエストします！ \n\nキャラ:大石泉\n\n竿役:同級生の太った男子 \n\nシチュエーション \n倉庫で男子に童貞を卒業させてほしいと土下座され、しぶしぶ了承する泉。そのまま全裸セックスに入り、男子のアレがかなり大きいため、快楽に堕ちる。\n\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/18", "thumbnail_src": "https://si.imgix.net/cde284f0/uploads/origins/975b3749-efd2-4f4f-9f28-444f001a77cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4ac533ec34eed85a4e194fab3b1c07f", "thumbnail_srcset": "https://si.imgix.net/cde284f0/uploads/origins/975b3749-efd2-4f4f-9f28-444f001a77cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4ac533ec34eed85a4e194fab3b1c07f, https://si.imgix.net/cde284f0/uploads/origins/975b3749-efd2-4f4f-9f28-444f001a77cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=212835dd25eb0b59e65826262c85b833 2x, https://si.imgix.net/cde284f0/uploads/origins/975b3749-efd2-4f4f-9f28-444f001a77cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=484897a43ed70a2ae1274c8da0768e68 3x", "genre": "art", "nsfw": true, "body": "リクエストさせていただきます。\n\nアイドル\n小早川紗枝\n\nシチュエーション\nテレビの相撲大会の企画で優勝した巨漢男子(紗枝と同い年)。ご褒美として、紗枝と用意された部屋で全裸の生セックス。\n\n最初は手玉に取ろうと考えていた紗枝だが、男子の巨根と化け物級の性欲で徐々に乱れ、最終的に心の中でPに謝りながら快楽堕ちする。\n\n以上です。", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/17", "thumbnail_src": "https://si.imgix.net/d91a0feb/uploads/origins/129d34d0-f5e5-42be-87eb-da40318000cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f8c8dc0c111e124ec1e5a7c7affe0ab", "thumbnail_srcset": "https://si.imgix.net/d91a0feb/uploads/origins/129d34d0-f5e5-42be-87eb-da40318000cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f8c8dc0c111e124ec1e5a7c7affe0ab, https://si.imgix.net/d91a0feb/uploads/origins/129d34d0-f5e5-42be-87eb-da40318000cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4682631e0b871f9b215ff1352b79710c 2x, https://si.imgix.net/d91a0feb/uploads/origins/129d34d0-f5e5-42be-87eb-da40318000cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0ce5c300f4dca4bb108cc711154bcf6 3x", "genre": "art", "nsfw": true, "body": "Twitterて見た城ヶ崎姉妹のボテ腹プリクラがめっちゃ好みなのでこの2人のエロ漫画をリクエストさせてください。（https://mobile.twitter.com/sukebepicdragon/status/1571513660513853440）\n前半後半の2ページでお願いします。\n前半は2人が妊プリのイメージキャラに選ばれたので妊娠するまで頑張ってセックスしまくる乱交ものをお願いします。2人を妊娠させるために選ばれた何人もの竿役の男達（スタッフでも抽選で選ばれたファンでもOKです）に中出しされまくる様子を撮影していく様子をお願いします。2人ともノリノリで自分からすすんで妊娠しようとしてると嬉しいです。膣以外にも手や口も使われてると興奮します。最後は膣から精液が垂れている様子をカメラに見せながら「数ヶ月後をお楽しみに！」とポーズを決めている2人をお願いします。\n後半はそれから数ヶ月後、見事に妊娠した2人がイメージPVとしてボテ腹でプリクラ内でハメ撮りをしている動画を撮っているマンガをお願いします。竿役の男は2人か3人くらいで2人並んでバックで突かれたり下から突き上げられている体位があると嬉しいです。出産シーンを描くかはオオトカゲさんにお任せします。\n2人の服装はデフォルトの制服姿がいいです。セックス中にどんどん脱げてもいいですし最後まで着たままでも構いません。\nこうしたほうがもっとエロくできると思ったところは変えてしまって構いません。\nこれらの内容で問題ないようでしたらぜひお願いします。\n\nhttps://mobile.twitter.com/sukebepicdragon/status/1571513660513853440", "created_at": "", "completed_at": ""}, {"path": "/@sukebepicdragon/works/16", "thumbnail_src": "https://si.imgix.net/1d48537c/uploads/origins/73b8be37-e24f-4be7-9f85-62df907143b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a2fe472a57a9bb2692229a72d778a6b", "thumbnail_srcset": "https://si.imgix.net/1d48537c/uploads/origins/73b8be37-e24f-4be7-9f85-62df907143b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a2fe472a57a9bb2692229a72d778a6b, https://si.imgix.net/1d48537c/uploads/origins/73b8be37-e24f-4be7-9