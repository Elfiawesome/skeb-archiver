//www.pixiv.net/artworks/8000741\nhttps://www.pixiv.net/artworks/59482245\nhttps://www.pixiv.net/artworks/51894291\nhttps://rule34.xxx/index.php?page=post&s=view&id=118386", "created_at": "", "completed_at": ""}, {"path": "/@miyako18998904/works/11", "thumbnail_src": "https://si.imgix.net/39ce50e5/uploads/origins/c500bf49-6987-4c2a-a386-d82716e5bd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dfb53d7b56dcf64f1f3b97fd509a467", "thumbnail_srcset": "https://si.imgix.net/39ce50e5/uploads/origins/c500bf49-6987-4c2a-a386-d82716e5bd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dfb53d7b56dcf64f1f3b97fd509a467, https://si.imgix.net/39ce50e5/uploads/origins/c500bf49-6987-4c2a-a386-d82716e5bd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdf6268322fd52dfe92000360614f5e0 2x, https://si.imgix.net/39ce50e5/uploads/origins/c500bf49-6987-4c2a-a386-d82716e5bd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fec7b6ae49b9d9ad83cda2f919bce25a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたの作品が本当に大好きです!私のオリジナルキャラクターを、あなたのアートスタイルで、机の上で足を組んでアップにした絵を描いていただけないでしょうか？彼女はこんな感じです。https://sta.sh/01eugfgtjk56", "created_at": "", "completed_at": ""}, {"path": "/@miyako18998904/works/10", "thumbnail_src": "https://si.imgix.net/f69550a4/uploads/origins/640f57e2-ff76-40d3-b1e4-e213cb4bbb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a1f8fe09aff18f1d744ae7d41175843", "thumbnail_srcset": "https://si.imgix.net/f69550a4/uploads/origins/640f57e2-ff76-40d3-b1e4-e213cb4bbb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a1f8fe09aff18f1d744ae7d41175843, https://si.imgix.net/f69550a4/uploads/origins/640f57e2-ff76-40d3-b1e4-e213cb4bbb40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8469f1c6cf5758fa5897fc5a86900fec 2x, https://si.imgix.net/f69550a4/uploads/origins/640f57e2-ff76-40d3-b1e4