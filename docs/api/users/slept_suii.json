04-a58c-b280bdee4c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdef1ad2f7ae504bc40aeb7a975a623d", "thumbnail_srcset": "https://si.imgix.net/d02f39ef/uploads/origins/30490c5f-7821-4a04-a58c-b280bdee4c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdef1ad2f7ae504bc40aeb7a975a623d, https://si.imgix.net/d02f39ef/uploads/origins/30490c5f-7821-4a04-a58c-b280bdee4c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b9a10f5d9dc312f075b44a462ae0ce8 2x, https://si.imgix.net/d02f39ef/uploads/origins/30490c5f-7821-4a04-a58c-b280bdee4c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdbe4dfab26873c5e9d188758de44ddd 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you, I always enjoy looking at your wonderful illustrations...!\n\nThis time, we would like an original character that is completely original and includes the following elements.\nI would like to use it for personal viewing and as an icon on social networking sites.\n\nA girl with silver hair (with a hint of blue or pink)\nBlue eyes (honestly, we would be happy if they are accentuated, so we leave it up to you).\nWearing a sanitary eye patch or bandage.\n・White and black based clothing if possible (with frills or ribbons as points of interest).\n　Maid's or Sister's uniform (more revealing is better).\nSome kind of head accessory (bunny ears, maid's brim, crown, mini hat, etc.)\nBlue (sky blue, light-colored) eyes or any shade of odd eyes\nSocks with knee-highs, garters, etc.\nWearing boots (length is up to you)\nSome kind of accessories (cute stuffed animals or weapons that are easy to carry)\n\nThe composition, including hairstyle and pose, will be left up to you.\nSince this is an original work, you may eliminate or rearrange elements that are difficult to coexist with.\n\nI am afraid this is a rough order, but I would appreciate it if you could cook it up...!", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/33", "thumbnail_src": "https://si.imgix.net/eafe59f8/uploads/origins/ed1aa57f-d060-4cef-b913-47ab0243edb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50ff7f84400736dcf9fcd5fb044ee35b", "thumbnail_srcset": "https://si.imgix.net/eafe59f8/uploads/origins/ed1aa57f-d060-4cef-b913-47ab0243edb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50ff7f84400736dcf9fcd5fb044ee35b, https://si.imgix.net/eafe59f8/uploads/origins/ed1aa57f-d060-4cef-b913-47ab0243edb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e79065b4c965328b758948839a6e26a3 2x, https://si.imgix.net/eafe59f8/uploads/origins/ed1aa57f-d060-4cef-b913-47ab0243edb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ce0d6c035e07be2b815bb7b5861a394 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/32", "thumbnail_src": "https://si.imgix.net/1a9125af/uploads/origins/9d60b0d8-80fe-4029-871d-b88b802ce6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f790bacfd489baba3873481d5905a5", "thumbnail_srcset": "https://si.imgix.net/1a9125af/uploads/origins/9d60b0d8-80fe-4029-871d-b88b802ce6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f790bacfd489baba3873481d5905a5, https://si.imgix.net/1a9125af/uploads/origins/9d60b0d8-80fe-4029-871d-b88b802ce6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfd9bb9a1cbfac3aeae51369b6819431 2x, https://si.imgix.net/1a9125af/uploads/origins/9d60b0d8-80fe-4029-871d-b88b802ce6a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8a947880f32ac04b24e14bb41734d84 3x", "genre": "art", "nsfw": false, "body": "Hello! Nice to meet you, I am in love with your art style and I wanted to request a commission from you! \nI would like you to draw the new vtuber model for yuniepix, she may use the artwork on social media, on banner/profile on twitch... with proper credit! \nThe pose would be similar to the reference with a hand making a claw gesture, a cute expression like she's roaring to the camera\n\nPose reference https://drive.google.com/file/d/1LT7YMZg-K2nmyqu1EnAECImP2Ri9epWs/view\nHands examples: https://drive.google.com/file/d/1HY1suRVHsWdJALD3ouGvSGOU8Oqtmxdd/view , https://drive.google.com/file/d/1wn8l2EAhc5I7ZP8zes3YAec60aev6dKb/view \nFace expression: https://drive.google.com/file/d/1uhPvt5UgQqIymS-NaoC2yuxihZUT0vZz/view\n\nIf possible, I would like to request an additional version with a \"\"tomato\"\" 😉 stain  on her face like in this drawing i saw from you: https://drive.google.com/file/d/11uCFCCaiO1IZexwxAp4FEiHnqU-mUUCq/view\n\nThank you for considering my request!<3\n\nhttps://drive.google.com/drive/folders/1z6UciUsOWahNYiz5KEU1imZySFcnwtkA", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/31", "thumbnail_src": "https://si.imgix.net/4ad103fd/uploads/origins/ff7bf62b-b42d-4990-ab80-6b3ed8dbe71b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d38ce7051a339be969cdc6943a486c0a", "thumbnail_srcset": "https://si.imgix.net/4ad103fd/uploads/origins/ff7bf62b-b42d-4990-ab80-6b3ed8dbe71b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d38ce7051a339be969cdc6943a486c0a, https://si.imgix.net/4ad103fd/uploads/origins/ff7bf62b-b42d-4990-ab80-6b3ed8dbe71b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0536571ec64d8b092a2e465a24a4f1e1 2x, https://si.imgix.net/4ad103fd/uploads/origins/ff7bf62b-b42d-4990-ab80-6b3ed8dbe71b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a0a76db0e2adaab2468a1cc6c836d91 3x", "genre": "art", "nsfw": false, "body": "寝枕すい様\n\nお忙しい中、リクエストを確認いただきありがとうございます。\nはじめまして！Vtuberの伊倉と申します。\n\n寝枕すい様の色遣い・絵柄がとっっても大好きで、skebのオープンを心待ちにしておりました。\n\nもしよろしければ私(メンヘラ天使)のイラストを描いていただけないでしょうか？\nポーズ等はおまかせで、上部と左右の見切れがないように作成いただけますととても嬉しいです。\n\nまた、可能でしたら、表情は両眼を開き微笑む姿で、\n涙を流す姿の差分を頂戴できますと嬉しいです。不可な場合は無視していただいて問題ございません！\n\n【希望納品形式】\n納品形式は人物が透過背景となるよう、\nサインや背景と分け、psd形式できますと大変ありがたいです。\n\n【使用用途】\n収益化しているTwitch配信にて、サムネや待機画面、\nグッズ制作、ネットプリント等で利用をさせていただきたいです。\n上記利用について、不足ございましたら再送要請にて適正な金額をお知らせいただけますと幸いです。\n\n商的な利用がNGな場合、お手数ですがリクエストをキャンセルをいただけますと幸いです。\n\nお忙しいところ恐縮ですが、ご一考賜れますと幸いです。\n\n【キャラクター】\n・白髪ハーフアップツイン（インナーカラーピンク）\n・天使（とろけた天使の輪と簡易な羽根）\n・タレ目\n・くちもとのほくろ、八重歯\n・胸E\n・太もものベルト\n・軍服ロリータ\n・注射器（中身がピンクの液体）\n\nhttps://drive.google.com/drive/folders/1_GLJmLd2tGQF3R16KE6eLC2Y9kAHF0d9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/30", "thumbnail_src": "https://si.imgix.net/7982c0ef/uploads/origins/cb12060f-6292-4793-bdac-1ca0d027a69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=747118006ac729d6b932a3d62282be40", "thumbnail_srcset": "https://si.imgix.net/7982c0ef/uploads/origins/cb12060f-6292-4793-bdac-1ca0d027a69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=747118006ac729d6b932a3d62282be40, https://si.imgix.net/7982c0ef/uploads/origins/cb12060f-6292-4793-bdac-1ca0d027a69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7e89be948fefce9089314f040d9b55e 2x, https://si.imgix.net/7982c0ef/uploads/origins/cb12060f-6292-4793-bdac-1ca0d027a69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91b125e7766bf5622a17568c0e606e2a 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you, my name is Myaoto, a former stray cat who grew up in a slum and is now preparing to become a Vtuber!\n\nI was attracted by your cute and wonderful illustration and I would like to request you to draw it for me 🙇♀️.\n\nI would like you to draw me \"Myao\".\n\nThe theme is \"Yumekawa Yandere\" (dreamy and cute Yandere)\nI would be happy if you could draw me in a Yandere-like style.\n\nI would be happy if you could draw me in any pose, expression, clothes, hairstyle, etc. as you like.\nWe will use them as icons for YouTube and Twitter, and as thumbnails for our videos.\nPlease make sure that the ears, tail, and hair are not cut off.\nI would like to see your illustrations as psd data with separate layers for the background and the character if possible.\n\nWe apologize for the many requests. If this is not acceptable, you may cancel your request.\nThank you for your consideration.\n\n\nReference image: https://twitter.com/meow_meow_ch/status/1563561072514060289?s=21", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/29", "thumbnail_src": "https://si.imgix.net/f20f6395/uploads/origins/eb1a1aad-aaa2-44af-90de-a240822a32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94b5fcabc4dca83200dac67f47cc4789", "thumbnail_srcset": "https://si.imgix.net/f20f6395/uploads/origins/eb1a1aad-aaa2-44af-90de-a240822a32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94b5fcabc4dca83200dac67f47cc4789, https://si.imgix.net/f20f6395/uploads/origins/eb1a1aad-aaa2-44af-90de-a240822a32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22c60604e9095b0aa6edc8a970943d6f 2x, https://si.imgix.net/f20f6395/uploads/origins/eb1a1aad-aaa2-44af-90de-a240822a32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbce41a9c807a907da0b3e54502230f4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/28", "thumbnail_src": "https://si.imgix.net/deae6a1f/uploads/origins/6940a0d6-3da6-48c7-8f3d-9f5c2bc88b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8df28397a3ab26ee3f06622629ec5cb5", "thumbnail_srcset": "https://si.imgix.net/deae6a1f/uploads/origins/6940a0d6-3da6-48c7-8f3d-9f5c2bc88b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8df28397a3ab26ee3f06622629ec5cb5, https://si.imgix.net/deae6a1f/uploads/origins/6940a0d6-3da6-48c7-8f3d-9f5c2bc88b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89f32fd6d573b003250545417600dffc 2x, https://si.imgix.net/deae6a1f/uploads/origins/6940a0d6-3da6-48c7-8f3d-9f5c2bc88b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d04a6034261b1230788294e3d3e1991 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you!\nI am in love with the very cute drawings of Sleeping Pillow Sui, and I would like to make a request to draw a new character of my own creation.\nThe features of the character are\nHairstyle: Two side updos up to the shoulder blades, lightly permed at the ends. Her hair color is brown with a hint of red.\nEyes: Eyelashes are long and full.\nPersonality: A tsundere with a high self-esteem.\nShe wears moe sleeves and has a sweet expression on her face.\nClothing] I leave it up to you.\nI apologize for the many requests.\nI have written a lot of things, but you are free to rearrange them in any way you think is cute.\nI would appreciate your consideration.", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/27", "thumbnail_src": "https://si.imgix.net/7849fd12/uploads/origins/97b88e6f-febd-4cfa-87a4-a880c2c7d1c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3473535abddff93b2796bafcd5ad6cb3", "thumbnail_srcset": "https://si.imgix.net/7849fd12/uploads/origins/97b88e6f-febd-4cfa-87a4-a880c2c7d1c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3473535abddff93b2796bafcd5ad6cb3, https://si.imgix.net/7849fd12/uploads/origins/97b88e6f-febd-4cfa-87a4-a880c2c7d1c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b175e314876633f49bbbe8b6ea4364d 2x, https://si.imgix.net/7849fd12/uploads/origins/97b88e6f-febd-4cfa-87a4-a880c2c7d1c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfebd1a167648d8da40efeca682b4454 3x", "genre": "art", "nsfw": false, "body": "I've been waiting for your request to resume...!\n\nIf you don't mind, I would appreciate it if you could draw my delivery avatar pretty!\nPlease make it easy for me to draw!\n\nI will use it for my delivery screen, thumbnails of my songs, and icons on YouTube and sns.\n(If you have a background, transparency would also be helpful...!)\n\nThank you very much!\n\n Below is the character description! I hope this will be helpful...!\nShe is a cheerful young girl (looks about 13 years old? (She looks about 13 years old, but her mental age is 5 years old)\nInnocent\nShe is a gamer (APEX, FF14, etc.), sings, draws, and delivers.\nLikes sweet things, sweets, and rabbits.\n∙ Loves anything sparkly! She even has sparkles in her pupils (like shiitake eyes)!\n  https://twitter.com/i/events/1466733015921397765?s=20\n\nhttps://twitter.com/monaco_trpg/status/1467393962311053319?s=21&t=BlVYwqR67gsZl5fszBEyiQ", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/26", "thumbnail_src": "https://si.imgix.net/997185e3/uploads/origins/c040c967-80ab-4f61-a851-55498392fca5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=884febb24547924e371eb0303cd27a42", "thumbnail_srcset": "https://si.imgix.net/997185e3/uploads/origins/c040c967-80ab-4f61-a851-55498392fca5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=884febb24547924e371eb0303cd27a42, https://si.imgix.net/997185e3/uploads/origins/c040c967-80ab-4f61-a851-55498392fca5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=faca43acc7cc3934260795122fa9fde2 2x, https://si.imgix.net/997185e3/uploads/origins/c040c967-80ab-4f61-a851-55498392fca5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d9c3e5ef523cdedbbd38281d2997be7 3x", "genre": "art", "nsfw": false, "body": "Dear Mr. Sleepy Pillow Sui\nNice to meet you. My name is Ramune.\nI always follow you on Twitter. I have been wanting to request this for a long time, so I am glad that I was able to do so this time...\n\nI would like to use it as an icon, although it is not for Twitter. So please use a bust-up if possible.\nPlease refer to the following URL for the character's material, and feel free to choose which of the two you would like to draw. I would like to have two different facial expressions, one crying with no expression and the other smiling. Sorry for so many orders...!\n\nThank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1vvWHOXSbbCbmvxiiajg87iBhmkt6yso5", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/25", "thumbnail_src": "https://si.imgix.net/b7675383/uploads/origins/42930648-613d-4b0e-85d3-813c7834b6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13bec28fe16549632f541d48a15ebb93", "thumbnail_srcset": "https://si.imgix.net/b7675383/uploads/origins/42930648-613d-4b0e-85d3-813c7834b6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13bec28fe16549632f541d48a15ebb93, https://si.imgix.net/b7675383/uploads/origins/42930648-613d-4b0e-85d3-813c7834b6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f8dfa4dab1fd2a46551414ca654794a 2x, https://si.imgix.net/b7675383/uploads/origins/42930648-613d-4b0e-85d3-813c7834b6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7208df7cdc2e0ad84fec5e635dd695cb 3x", "genre": "art", "nsfw": false, "body": "It is nice to meet you. I always look forward to seeing your wonderful illustrations.\nI would like to send a request to you because I like the transparent girls you draw very much.\nI would like to ask you to draw a two-shot illustration of me and my friend.\nMy proxy characters are as follows\nhttps://drive.google.com/drive/folders/1-1nSsP-AyZdCE-RMSuKQGWlDXt_-Rz4F\nMy friend\nhttps://twitter.com/oo_ka_ren_oo/status/1324706585235480576?s=21&t=K8bgzl1LsmAaxUpAaPUKdw\nI would like to ask you to draw an illustration of my surrogate character below and my friend below, who are a couple, with their cheeks pressed together.\nI would appreciate it if you could draw the friend as the receiver.\nI would appreciate it if you would consider my request.", "created_at": "", "completed_at": ""}, {"path": "/@slept_suii/works/24", "thumbnail_src": "https://si.imgix.net/d001150b/uploads/origins/242bc427-327d-47a6-ae39-5d0714d0f302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2756eea7eda575996837a2dc97fd5013", "thumbnail_srcset": "https://si.imgix.net/d001150b/uploads/origins/242bc427-327d-47a6-ae39-5d0714d0f302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2756eea7eda575996837a2dc97fd5013, https://si.imgix.net/d001150b/uploads/origins/242bc427-327d-47a6-ae39-5d0714d0f302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e9e7e16e23a77aebfeb587297414015 2x, https://si.imgix.net/d001150b/uploads/origins/242bc427-327d-47a6-ae39-