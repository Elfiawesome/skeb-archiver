ある感じで。\n　　　　　　　胸の大きさはお任せで。\n　　　　　　　バニーガールの格好での胸の描写は、谷間がハッキリと分かる様な形で。\n\n希望としてはモノクロ版とカラー版の両方ですが、難しいようでしたらモノクロ版の方を希望します。\nもし、モノクロ版とカラー版の両方が可能な場合は、それぞれにサイン入りとサイン無しを。\nモノクロ版のみの場合も、サイン入りとサイン無しを。\n　　　　　　　\n\n参考URL先↓\nhttps://yahoo.jp/h2g2md", "created_at": "", "completed_at": ""}, {"path": "/@syatey_12/works/20", "thumbnail_src": "https://si.imgix.net/953aa8be/uploads/origins/8a01c0e2-31a1-4f6f-8c8c-4a35187eb85e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7bfd87f71ea4912131aceb1b542307a", "thumbnail_srcset": "https://si.imgix.net/953aa8be/uploads/origins/8a01c0e2-31a1-4f6f-8c8c-4a35187eb85e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7bfd87f71ea4912131aceb1b542307a, https://si.imgix.net/953aa8be/uploads/origins/8a01c0e2-31a1-4f6f-8c8c-4a35187eb85e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=296411ebeabd81a29db15d99aaf2faf8 2x, https://si.imgix.net/953aa8be/uploads/origins/8a01c0e2-31a1-4f6f-8c8c-4a35187eb85e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8377efaf247315c2e9cbc6bd6c78d163 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@syatey_12/works/19", "thumbnail_src": "https://si.imgix.net/ee16170c/uploads/origins/2e331eb4-6819-4bd2-ba96-deccd1757284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aaa920e73a9304acd764cd1466a7364e", "thumbnail_srcset": "https://si.imgix.net/ee16170c/uploads/origins/2e331eb4-6819-4b