8d3ba5fbfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16877485d4351cc2383208c8b365fca2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/43", "thumbnail_src": "https://si.imgix.net/ce3bab88/uploads/origins/5127ab66-5c73-4299-86e2-8df9422b7856?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22035d0e6ad4b304066c470af72fbd2e", "thumbnail_srcset": "https://si.imgix.net/ce3bab88/uploads/origins/5127ab66-5c73-4299-86e2-8df9422b7856?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22035d0e6ad4b304066c470af72fbd2e, https://si.imgix.net/ce3bab88/uploads/origins/5127ab66-5c73-4299-86e2-8df9422b7856?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97d08538bd929c79c35007410f0ce7e3 2x, https://si.imgix.net/ce3bab88/uploads/origins/5127ab66-5c73-4299-86e2-8df9422b7856?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=536e0643ac61f2f68f1139ebf8703446 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n\nチュウニズムのキャラクター「レナ・イシュメイル」をお願いします。\n\nフェラをお願いします。\n流れは、\n男性器にキスをする→亀頭を舌で舐める→咥える（バキュームフェラにはならないようお願いします。口に含む程度）→射精→射精後精液が口から溢れたり顔にかかる、ふやけた表情\nのような感じで差分をお願いします。\n\nローターを膣内に入れながらフェラをしています。竿役射精時にレナも絶頂します。愛液を垂らしてください。\n\n背景はベッドの上でお願いします。愛液でベッドを汚してる感じを表現してほしいです。\n\n服装はゲーム内の通常衣装（資料内の「レナ通常」）の上着だけ着ていて他は脱いでいる状態と全裸で差分が欲しいです。\n\nポーズは、脚は女の子座り、もしくはエロ蹲踞みたいな感じになるのかなと思います。手は男性器の根の方を持つか、床に手を付けるか脚に手を置いているか…あまり思いつかないので任せます。\n\nキャラクターは正面、もしくは正面から少し斜めくらいを向いています。\n\n以前描かれてましたWフェラのイラスト（https://skeb.jp/@echizen_sun/works/33）がめちゃくちゃ刺さりました。\n\n御検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1A4trDTNnR-NGTeITjzkHvz_QHoYxrGsT", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/42", "thumbnail_src": "https://si.imgix.net/7efc4e2c/uploads/origins/825f7f02-9f8c-4f20-92d3-08227e791246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c75edf6fdeeb5ecfc78ca84e6f0d6c58", "thumbnail_srcset": "https://si.imgix.net/7efc4e2c/uploads/origins/825f7f02-9f8c-4f20-92d3-08227e791246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c75edf6fdeeb5ecfc78ca84e6f0d6c58, https://si.imgix.net/7efc4e2c/uploads/origins/825f7f02-9f8c-4f20-92d3-08227e791246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d2c03e5c950a8f37cde70ea8f3b58bb 2x, https://si.imgix.net/7efc4e2c/uploads/origins/825f7f02-9f8c-4f20-92d3-08227e791246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31a9cae77579cd4e0e62396343711a9d 3x", "genre": "art", "nsfw": true, "body": "オンゲキの珠洲島有栖ちゃんのえっちなイラストをお願いします。\n\n・構図としては正面からの視点か一人称視点で、正常位で挿入して中出ししているところをお願いします。\n・格好としては以下の猫下着からぱんつだけ脱がせた格好で。\nhttps://x.com/_AM__01_/status/1824008226477891668/photo/1\n・シーンとして以下のイメージで差分を作っていただきたいです。\n①挿入前\n②挿入\n③中出し\n④事後（挿入したまま）\n・その他として断面図を横に添えていただいて、おちんちんは根元まで挿入してるような感じでお願いします。\n\nまた、可能な範囲で以下の差分を追加してもらえると嬉しいです。\n・リード付き首輪\n・目隠し\n・膣内放尿\n\n良かったらお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/41", "thumbnail_src": "https://si.imgix.net/d4ee1b07/uploads/origins/452e9280-b9cd-4f03-8f02-6b8a15c3f517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c724e71f9658f92e3e32b4edea4aab", "thumbnail_srcset": "https://si.imgix.net/d4ee1b07/uploads/origins/452e9280-b9cd-4f03-8f02-6b8a15c3f517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c724e71f9658f92e3e32b4edea4aab, https://si.imgix.net/d4ee1b07/uploads/origins/452e9280-b9cd-4f03-8f02-6b8a15c3f517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2cb3fbea922b58bc0340581854daf4f 2x, https://si.imgix.net/d4ee1b07/uploads/origins/452e9280-b9cd-4f03-8f02-6b8a15c3f517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b91c314bfbcc8dcd0b2aa1a5d1b7ffcd 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼致します。 プレイマットのイラストをお願い致します。 WIXOSSのアルフォウをお願い致します。構図等はおまかせでお願い致します。 サイズが縦35cm×横60cmでお願い致します。プレイマットにして自分が主催する無料大会で無料配布等する予定です。ご検討して頂けたら幸いです。  また運営様からは許可は得ております。 https://postimg.cc/0rHJt3vH \n 服装はウェディングドレス姿でお願いいたします。 https://www.google.com/imgres?imgurl=https%3A%2F%2Fm.media-amazon.com%2Fimages%2FI%2F61obXtqjuAL._AC_UF894%2C1000_QL80_.jpg&tbnid=1e98nSWiolEvgM&vet=1&imgrefurl=https%3A%2F%2Fwww.amazon.co.jp%2F%25E3%2582%25A6%25E3%2582%25A3%25E3%2582%25AF%25E3%2583%25AD%25E3%2582%25B9-WXDi-P11-020-%25E3%2582%25A2%25E3%2583%25AB%25E3%2583%2595%25E3%2582%25A9%25E3%2582%25A6%25EF%25BC%2588LC%25EF%25BC%2589-REUNION-%25E3%2582%25BF%25E3%2582%25AB%25E3%2583%25A9%25E3%2583%2588%25E3%2583%259F%25E3%2583%25BC%2Fdp%2FB0BHNRBDH4&docid=9pQCSpO-wI6m7M&w=716&h=1000&hl=ja&source=sh%2Fx%2Fim%2Fm5%2F3&kgs=3b11ff05cb93034f", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/40", "thumbnail_src": "https://si.imgix.net/081363a2/uploads/origins/231b7e06-5e2f-4cb3-b808-be9588dd9be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4f46e760b9e8ea11bcaa244f8f875f", "thumbnail_srcset": "https://si.imgix.net/081363a2/uploads/origins/231b7e06-5e2f-4cb3-b808-be9588dd9be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b4f46e760b9e8ea11bcaa244f8f875f, https://si.imgix.net/081363a2/uploads/origins/231b7e06-5e2f-4cb3-b808-be9588dd9be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3ca0967a6ad5c71cd1e0423b35f7ca7 2x, https://si.imgix.net/081363a2/uploads/origins/231b7e06-5e2f-4cb3-b808-be9588dd9be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afc4f8c4defbaecd4b0919131831a0d7 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼します。\n↓依頼内容\n自分が弐寺で使ってるクプロ3人(さなえ、アカネ、ラピス)のイラストをお願いします。\n衣装はチア衣装でお願いします。\nスク水差分、スク水半脱ぎ差分、全裸差分もお願いします。\n表情、ポーズ等その他諸々はおまかせでお願いします。\n\n資料(さなえ)\nhttps://drive.google.com/file/d/1JlT1YLATySD6TmDSsFthG0PaD57Ro4-W/view?usp=drivesdk\n\n資料(アカネ)\nhttps://drive.google.com/file/d/1JlA_y7KUKuhp41viU8CbdXa3ImCk8I8s/view?usp=drivesdk\n\n資料(ラピス)\nhttps://drive.google.com/file/d/1Jjk48fzYWefmFt6ZiG3Ua6n9bw_lb6dg/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/39", "thumbnail_src": "https://si.imgix.net/a5542a4c/uploads/origins/d1243ad6-4b0f-4a80-81d9-b38bc71ba6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f189af07146355b2e17519385f1142c", "thumbnail_srcset": "https://si.imgix.net/a5542a4c/uploads/origins/d1243ad6-4b0f-4a80-81d9-b38bc71ba6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f189af07146355b2e17519385f1142c, https://si.imgix.net/a5542a4c/uploads/origins/d1243ad6-4b0f-4a80-81d9-b38bc71ba6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2e49a35c619b3421db12ffd59e2b050 2x, https://si.imgix.net/a5542a4c/uploads/origins/d1243ad6-4b0f-4a80-81d9-b38bc71ba6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4e95cc648437e7db20cdc204a7ed96a 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です！いつも有栖などのとてもかわいいイラスト拝見させてもらってます！！\n今回依頼したいキャラなんですけどもチュウニズムに出てきますアーリア・ネージュっていう子をお願いしたいと思っております！資料含め最後にURL貼らせていただきます！\n(服装・表情につきまして)\n服装につきましてはbrilliant for youの方(トランスフォームした後)でお願いします！\n表情は楽しく笑ってるような明るい感じにしていただければと思います！\n(構図につきまして)\n構図やポーズにつきましてはくらげ先生のおまかせでお願い出来ればと思います！！\n是非ともくらげ先生のネージュ見てみたいのでよろしくお願い致します！\nURL… https://gamerch.com/chunithm/entry/488795", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/38", "thumbnail_src": "https://si.imgix.net/6ade9259/uploads/origins/1a372c24-ce23-4745-94f2-12211a1e0c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08d9c3822e973da5de18c486111cb933", "thumbnail_srcset": "https://si.imgix.net/6ade9259/uploads/origins/1a372c24-ce23-4745-94f2-12211a1e0c54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08d9c3822e973da5de18c486111cb933, https://si.imgix.net/6ade9259/uploads/origins/1a372c24-ce23-4745-94f2-12211a1e0c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f926a3ab06306135d9dddd2034d89fd 2x, https://si.imgix.net/6ade9259/uploads/origins/1a372c24-ce23-4745-94f2-12211a1e0c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f48c7320ba54fc3c5900a46bfdc95a7 3x", "genre": "art", "nsfw": false, "body": "はじめまして…！\nくらげさんさんଳさんの絵をずっと見て、今回skebで依頼して見たいと思って依頼する事になりました\n\n自分はオンゲキの珠洲島 有栖と言うキャラが大好きなので、今回依頼しょうとしてるのも勿論有栖のイラストでしようと思います\n\n衣装はウェディングドレスで、手には花束を持っている感じで描かせて頂きたいと思います\nそれ以外のポーズ、構図、表情などはあんまり詳しくないために全部くらげさんさんଳさんにお任せしたいと思います\n\nではご検討の程宜しくお願い致します🙏", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/37", "thumbnail_src": "https://si.imgix.net/97e36943/uploads/origins/a8578ad4-bb56-43cb-aed1-5a657699a9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d40e629cae1621f727e649e2cb4c943f", "thumbnail_srcset": "https://si.imgix.net/97e36943/uploads/origins/a8578ad4-bb56-43cb-aed1-5a657699a9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d40e629cae1621f727e649e2cb4c943f, https://si.imgix.net/97e36943/uploads/origins/a8578ad4-bb56-43cb-aed1-5a657699a9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3aff6490a5c1c02675a166b7468cd66 2x, https://si.imgix.net/97e36943/uploads/origins/a8578ad4-bb56-43cb-aed1-5a657699a9c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f06cc582cf3a767698d49ff53f5a97e 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nかなり前ではありますが、前回依頼したイラストがかなり気に入っており、再度依頼させていただきたいです。\n\nチュウニズムのキャラクター「マジカルスター☆リリィ」のイラストをお願いいたします。\n\n【イラストイメージ】\n雰囲気としては、音楽ゲームで高得点を出した時のリザルトに表示されるイメージだと嬉しいです。\nポーズについてはおまかせいたします。\n参考用イメージ：https://twitter.com/pika_2000/status/1777659160894583199\n\n【キャラクター参考資料】\n公式キャラ紹介ページ：https://chunithm.sega.jp/character/#/chunithm/マジカルスター☆リリィ\n攻略Wiki(別差分のイラストが載っています)：https://wikiwiki.jp/chunithmwiki/マジカルスター☆リリィ\n\n\nもし可能であれば、前回と同様に何も着ていない差分があるととても嬉しいです。\n(お胸も前回同様小さめだと私が喜びます……！)\n\nまたしても参考資料が少ないキャラクターで申し訳ないですが、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/36", "thumbnail_src": "https://si.imgix.net/f604bf4b/uploads/origins/58a01d9f-6dd1-4ddb-ba03-2d64b71d6a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69bbca02b11e76f08494d21e52ca0532", "thumbnail_srcset": "https://si.imgix.net/f604bf4b/uploads/origins/58a01d9f-6dd1-4ddb-ba03-2d64b71d6a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69bbca02b11e76f08494d21e52ca0532, https://si.imgix.net/f604bf4b/uploads/origins/58a01d9f-6dd1-4ddb-ba03-2d64b71d6a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5e7cdfa780f50251e4eb087e4aaaade 2x, https://si.imgix.net/f604bf4b/uploads/origins/58a01d9f-6dd1-4ddb-ba03-2d64b71d6a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41bf0e8a36a4e702050d5b52031e1b20 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@echizen_sun/works/35", "thumbnail_src": "https://si.imgix.net/c3750c5b/uploads/origins/ce550a9a-6a0a-465a-a673-f7cb82278a1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffa402bbb04b4b2594f84248bb493f05", "thumbnail_srcset": "https://si.imgix.net/c3750c5b/uploads/origins/ce550a9a-6a0a-465a-a673-f7cb82278a1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=