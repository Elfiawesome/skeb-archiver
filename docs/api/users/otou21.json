-8ed4-4e06d26198dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83b0dcdb141f95eabf3591c5531e9607 2x, https://si.imgix.net/49d492bb/uploads/origins/355e08b8-54bd-4e00-8ed4-4e06d26198dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4761d2761c79f2a2457721aaaff28c87 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otou21/works/73", "thumbnail_src": "https://si.imgix.net/14508950/uploads/origins/030fe349-db84-49ac-ae4b-52578f2180f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42c6befb012ac15a3640c1d5cebb78ea", "thumbnail_srcset": "https://si.imgix.net/14508950/uploads/origins/030fe349-db84-49ac-ae4b-52578f2180f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42c6befb012ac15a3640c1d5cebb78ea, https://si.imgix.net/14508950/uploads/origins/030fe349-db84-49ac-ae4b-52578f2180f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a14c3c4a96738156e6a6611853586cd 2x, https://si.imgix.net/14508950/uploads/origins/030fe349-db84-49ac-ae4b-52578f2180f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eef41ccbf5cdd753aec1f1aed382e18 3x", "genre": "art", "nsfw": true, "body": "おとうさんのファンで是非推しのエッチなイラストをお願いしたいです\n\nキャラ　仲村ゆり\n\nジャンル　R18 フルカラー　全身図\n\nシチュエーションの参考↓\nhttps://www.pixiv.net/artworks/112104373#manga\n敵に捕まったイメージ　\n\n細かな要望\n1 資料の2枚目の様に全体的に体の向きは真っ直ぐで顔も正面カメラ目線\n2 資料は服を着てますが全裸でアソコは毛は無し、赤い首を付けて手鎖、足枷を付けて拘束されてください、首輪のリードは無し\n3 ゆりの表情は赤らめながら歯を噛み締めて悔しそうなのと辱めな顔でお願いします\n4 頭のカチューシャは無し\n5 イラスト自体は基本明るめで背景はお任せします\n6 可能であればおとうさんが考えた別パターンをお願いします\n\n以上になります、可能であればよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@otou21/works/72", "thumbnail_src": "https://si.imgix.net/97c62168/uploads/origins/4466f9ab-d270-4f34-b133-a7188c531aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f200b9ab917312a89aeeb1ca73f1bbb0", "thumbnail_srcset": "https://si.imgix.net/97c62168/uploads/origins/4466f9ab-d270-4f34-b133-a7188c531aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f200b9ab917312a89aeeb1ca73f1bbb0, https://si.imgix.net/97c62168/uploads/origins/4466f9ab-d270-4f34-b133-a7188c531aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c49063209246ef070e9f704497c1ba3 2x, https://si.imgix.net/97c62168/uploads/origins/4466f9ab-d270-4f34-b133-a7188c531aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dda2b9a92bb693e6394f82cddf1194ee 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト拝見させて頂いております！\n今回はSkebにて依頼させて頂きます\n\nキャラは蒼と蒼の娘を描いて頂きたいです。娘のキャラデザは以前描いて頂いた通りです。娘の服装は蒼がお役目する時の巫女服を着させて欲しいです。蒼の服装はおまかせ致します。\n以上になります。背景や表情等はお任せ致します。もしよろしければ何かしらの差分があると嬉しいです。ご検討頂けますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@otou21/works/71", "thumbnail_src": "https://si.imgix.net/367cdf59/uploads/origins/5a61eb1f-7dcf-4376-b0be-67bbca761e55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c200d2e945ccccfced9ba3f14ca93c10", "thumbnail_srcset": "https://si.imgix.net/367cdf59/uploads/origins/5a61eb1f-7dcf-4376-b0be-67bbca761e55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c200d2e945ccccfced9ba3f14ca93c10, https://si.imgix.net/367cdf59/uploads/origins/5a61eb1f-7dcf-4376-b0be-67bbca761e55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf98362f10f91d6e4b767820e2660e87 2x, https://si.imgix.net/367cdf59/uploads/origins/5a61eb1f-7dcf-4376-b0be-67bbca761e55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d36eeb64d7f280a982c8b3919da2de2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otou21/works/70", "thumbnail_src": "https://si.imgix.net/977b2009/uploads/origins/0b73a050-d86c-4582-b9ab-8841f359b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4051a6bdb1f56b44672b5eeb0bd612a2", "thumbnail_srcset": "https://si.imgix.net/977b2009/uploads/origins/0b73a050-d86c-4582-b9ab-8841f359b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4051a6bdb1f56b44672b5eeb0bd612a2, https://si.imgix.net/977b2009/uploads/origins/0b73a050-d86c-4582-b9ab-8841f359b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fead5b6a63df9059738e2f974ab5f22 2x, https://si.imgix.net/977b2009/uploads/origins/0b73a050-d86c-4582-b9ab-8841f359b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27d733e3963153c6c3e907d67ae5d8a3 3x", "genre": "art", "nsfw": true, "body": "いつもありがとうございます。\n「CLANNAD」「古河渚」が「仁科りえ」「杉坂」と一緒に、バイト先のファミレス「https://www.tbs.co.jp/clannad/03story/story14.html」で接客乱交しているというシチュエーションのイラストをお願い致します。\n\nイラストの構成は各々挿入含め2名以上を相手にしている感じであれば、三人共同じような扱いで客と性交している物でも、渚がメインで残り2人は画面奥で性交している物でも構いません。\n基本的に顔、乳首、結合部が見える物希望ですが、渚以外は配置により体の一部が隠れても大丈夫です。\n\nできれば客にフルーツやお菓子類を口移しで食べさせてあげたり、客に母乳を飲ませたり、胸にドリンクバーに繋がれた搾乳機(https://assets.clip-studio.com/ja-jp/detail?id=1908781のような半透明で中身の見えるもの)を取りけられて搾乳されているような飲食接客系のプレイをしたり、\n可能であれば仁科さんと杉坂さんは、ダブルフェラや、一人がフェラないし性交しつつ、もう一人がその相手に上記の口移しや授乳をするといった感じで2人一緒に奉仕している感じでお願いします。\nなお、複数人で一人の男性に奉仕する場合でも、3人共女性器は別の男性の男性器が挿入された状態でお願い致します。\n\n服装はウエイトレスの制服「https://www.1999.co.jp/10087749」で、胸元のずり下げによる胸露出以外は髪飾り等一切取らずの着たままで、\nワンピース下部は開脚等で適度に捲れて女性器が見えたものでお願い致します。\n\nまた、好みでなかったら申し訳ないのですが、もし可能であれば渚は妊娠した状態で、\n作中の時系列基準でなくてよいので大き目のボテ腹でお願い致します。\nその際はワンピース部は妊娠による丈不足とお腹に引っかかることで、前側のみが適度に捲れて結合部が見えた状態でお願いします。\nなお、妊娠している方が好みであれば、他2人も妊娠していても大丈夫です。\n\n瞳は通常に近い状態(アヘらず瞳孔開かず目を細めない)で開いた状態で、\n表情は陵辱系ではなく状況を受けれているものでお願いします。\n\n竿役は子供～青年くらいの年齢幅のプレーンな造形でお願いします。\n\n納品はPSD等で、以前と同程度に各パーツを分けてください。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@otou21/works/69", "thumbnail_src": "https://si.imgix.net/ea41163a/uploads/origins/dd9dfabd-0f6f-4843-9c11-516b3c6d9f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17f905b89e2539ee942fca91d085c5e7", "thumbnail_srcset": "https://si.imgix.net/ea41163a/uploads/origins/dd9dfabd-0f6f-4843-9c11-516b3c6d9f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17f905b89e2539ee942fca91d085c5e7, https://si.imgix.net/ea41163a/uploads/origins/dd9dfabd-0f6f-4843-9c11-516b3c6d9f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a460bb94074022c8bd150d2c7ca07dbe 2x, https://si.imgix.net/ea41163a/uploads/origins/dd9dfabd-0f6f-4843-9c11-516b3c6d9f5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa97ed54a711be5d2e9e1af9fc5d14d0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@otou21/works/68", "thumbnail_src": "https://si.imgix.net/95c7485c/uploads/origins/406e0163-5943-45cc-b25b-2f7038a05919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86e538dd5c2aa68f625d391febab4d97", "thumbnail_srcset": "https://si.imgix.net/95c7485c/uploads/origins/406e0163-5943-45cc-b25b-2f7038a05919?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86e538dd5c2aa68f625d391febab4d97, https://si.imgix.net/95c7485c/uploads/origins/406e0163-5943-45cc-b25b-2f7038a05919?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfefc0f422d7682e65c30b7883fbe3e4 2x, https://si.imgix.net/95c7485c/uploads/origins/406e0163-5943-45cc-b25b-2f7038a05919?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=631b3d8f5a37a10fdbcfbfd2818ce6e5 3x", "genre": "art", "nsfw": false, "body": "おとう様\n\nいつも世話になっております。\nこの度もご縁がありましたらと思い依頼させていただきます。 \n好きな作品×好きな作品という発想に目覚めまして、summer pocketsの空門蒼がアズールレーンの信濃の通常衣装を着ているようなイラストをお願いいたします。 \nアズレンの信濃は「眠り」「狐」「胡蝶」「夢(記憶)」といった蒼と共通する点が多く存在するキャラのため、相性のいい組み合わせだと思いまして。  \n\n空門蒼 \n・服装：参考資料を元に信濃の通常衣装、可能であれば艤装有りでお願いします \n・髪型等：アズレン信濃の狐耳あり（色は蒼寄り）、信濃の髪飾りと蒼のトンボ玉有で髪型は公式の蒼に寄せるかアズレンの信濃のようにおろしてたなびかせるかはお任せします \n・表情：儚げな表情、差分で眠そうに微睡む表情、瞳を閉じている表情 \n・構図：ふわふわと浮いているイメージで七影蝶が周りに羽ばたいている。また、胸元（いわゆる\"北半球\")が強調されていると嬉しいです \n・背景：月光の下、夜空の幻想的なイメージ \n・備考：尻尾ももふもふな感じで描写されていると嬉しいですが全体的な収まりが悪くなるようであればアレンジしたり多少省略していただいてでも大丈夫です  \n\n以上です。 \nこの度もお目通り叶えば幸いです。 よろしくお願いします。  \n\n信濃 \n公式の紹介 https://x.com/azurlane_staff/status/1304759109875499010?s=20 wiki（設定や他衣装等載ってます） https://azurlane.wikiru.jp/?%E4%BF%A1%E6%BF%83", "created_at": "", "completed_at": ""}, {"path": "/@otou21/works/67", "thumbnail_src": "https://si.imgix.net/b1f41b71/uploads/origins/5ea245b7-4bff-4ab3-8356-70c57a8dc037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b34ad0209c0a03ffcc0ea41bbd70266d", "thumbnail_srcset": "https://si.imgix.net/b1f41b71/uploads/origins/5ea245b7-4bff-4ab3-8356-70c57a8dc037?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b34ad0209c0a03ffcc0ea41bbd70266d, https://si.imgix.net/b1f41b71/uploads/origins/5ea245b7-4bff-4ab3-8356-70c57a8dc037?bg=