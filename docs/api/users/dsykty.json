e3-48a7-be3e-3c2f19f06304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed0947ee2f30c235fb37db234b448d37", "thumbnail_srcset": "https://si.imgix.net/18ba7d37/uploads/origins/e6edeec5-36e3-48a7-be3e-3c2f19f06304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed0947ee2f30c235fb37db234b448d37, https://si.imgix.net/18ba7d37/uploads/origins/e6edeec5-36e3-48a7-be3e-3c2f19f06304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc4fbd129d37f4b8ca1601ce84388818 2x, https://si.imgix.net/18ba7d37/uploads/origins/e6edeec5-36e3-48a7-be3e-3c2f19f06304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=801556f686404565efa24dc4b437fcd6 3x", "genre": "art", "nsfw": true, "body": "今回もリクエストさせていただきます。\n\nキャラクター：「アイドルマスターミリオンライブ！」から「天空橋朋花」でお願いします。\n\nシチュエーション：さきっぽ舐める朋花ちゃんでお願いします。\n\nその他：\n・胸元や太ももをアピールして、描いていただきたいです。\n・可能であれば、ぶっかけ・ごっくん差分もお願いしたいです。\n\n衣装の参考：https://mltd.matsurihi.me/cards/2680\n\n構図の参考：https://1drv.ms/i/c/41ce4fd8c07899a2/EW2rzQNEkeFOkT90RZYJ4BABp7yDzRXqWauOlJVMDdzurw?e=hKUibO\n\n以上です、要望多くて申し訳ございませんが、\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@dsykty/works/141", "thumbnail_src": "https://si.imgix.net/919b6717/uploads/origins/709bd1e6-86a4-46c3-82f5-67d50fed6ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2e1fb49e78e2d5933a702387fae6095", "thumbnail_srcset": "https://si.imgix.net/919b6717/uploads/origins/709bd1e6-86a4-46c3-82f5-67d50fed6ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2e1fb49e78e2d5933a702387fae6095, https://si.imgix.net/919b6717/uploads/origins/709bd1e6-86a4-46c3-82f5-67d50fed6ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7a762e1825d9d69f82271b007828efc 2x, https://si.imgix.net/919b6717/uploads/origins/709bd1e6-86a4-46c3-82f5-67d50fed6ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fecb29cc6bd5a4d890d89cc606e03872 3x", "genre": "art", "nsfw": true, "body": "前回はパイパーのアルティメット最高なイラストありがとうございました。今でも私のお供になっています！再びリクエストさせて頂きます。\n\n今回はパイパーと青衣のダブル亀頭舐めをお願いします。\n\nシチュエーション\n・前回のパイパーと同じ構図。\n・衣装は着衣。\n・発情した二人が亀頭に舌を押し当てれろ～っと舐め舐め。\n最後に今か今かと舌出し顔射待ちをしている二人の顔にぶっかけ。\n\n金額的、作業量的に可能なものだけで良いので、二人の舌の動きや形が変わる差分や、二人の舌と舌がむにゅっとくっついている状態での亀頭舐め差分をお願いしたく思います。\n\n前回より細かい依頼になってしまい申し訳ありませんが、よければご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@dsykty/works/140", "thumbnail_src": "https://si.imgix.net/9baa48f3/uploads/origins/ad7fb68e-9fbe-474c-8b21-60ddb3639e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b21b08cbd89e295967e5d623ec5fbf49", "thumbnail_srcset": "https://si.imgix.net/9baa48f3/uploads/origins/ad7fb68e-9fbe-474c-8b21-60ddb3639e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b21b08cbd89e295967e5d623ec5fbf49, https://si.imgix.net/9baa48f3/uploads/origins/ad7fb68e-9fbe-474c-8b21-60ddb3639e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1656317c42ae420feab2591d532902d3 2x, https://si.imgix.net/9baa48f3/uploads/origins/ad7fb68e-9fbe-474c-8b21-60ddb3639e0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8352d50ae9b415fd298b0ba3b42a778a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dsykty/works/139", "thumbnail_src": "https://si.imgix.net/0728b282/uploads/origins/b5ab19ff-feb1-49fb-9fbf-d30aff4a78d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ab88ec7eac627b45c327336ca44144", "thumbnail_srcset": "https://si.imgix.net/0728b282/uploads/origins/b5ab19ff-feb1-49fb-9fbf-d30aff4a78d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ab88ec7eac627b45c327336ca44144, https://si.imgix.net/0728b282/uploads/origins/b5ab19ff-feb1-49fb-9fbf-d30aff4a78d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92929b79dfff46f2fbf8cb99f9d37681 2x, https://si.imgix.net/0728b282/uploads/origins/b5ab19ff-feb1-49fb-9fbf-d30aff4a78d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cae05b63000d688d8e801539502a2ec0 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n他の方が依頼されていたナオミちゃんのイラストがエロ過ぎて堪りません。\nお肌の質感や空気感など最高です。\n是非私からもリクエストさせて頂きたく。何卒ご検討頂ければ。\n\n\n・作品\n『BLEACH』\n\n・キャラクター\n「井上織姫」&「朽木ルキア」\n\n・シチュエーション\n敵に敗れ捕虜になった2人。\n他の仲間を守るために敵の辱めを甘んじて受け入れています。\n\n・体型\n井上織姫\n巨乳〜爆乳（現実的なサイズ感）\n朽木ルキア\n大きくはないが美乳。\n\n・衣装\n2人とも制服（半袖白シャツ）。雑に脱がされ胸が見えています。\nhttps://www.amiami.jp/top/detail/review?gcode=FIG-MOE-0263-R\n\n・ポーズなど\n2人とも正常位。拘束はされていません。\n激しく乱暴にズボズボされています。\n井上織姫\n初めての感覚に戸惑い、喘ぎ悶えています。\n中出し後は切なそうに相手を見つめます。\nhttps://www.pixiv.net/artworks/122433532\nhttps://www.pixiv.net/artworks/112128440\n朽木ルキア\n相手に屈しまいと睨みつけるが結局飲み込まれてしまいます。\nhttps://www.pixiv.net/artworks/100857170\nhttps://www.pixiv.net/artworks/102739267\nhttps://www.pixiv.net/artworks/110655257\n\n・ちんちん\n形状やサイズはこちら寄りで。\nhttps://skeb.jp/@dsykty/works/49\n\n・背景\n下記のイラストのような若干薄暗くて暖かそうな空間で。\nhttps://skeb.jp/@dsykty/works/103\n\n\nその他詳細はお任せでお願いします。\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@dsykty/works/138", "thumbnail_src": "https://si.imgix.net/06255443/uploads/origins/6e1e60ac-30c6-4f07-9480-39a08162d228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23758410f74e185174f29e1451a52145", "thumbnail_srcset": "https://si.imgix.net/06255443/uploads/origins/6e1e60ac-30c6-4f07-9480-39a08162d228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23758410f74e185174f29e1451a52145, https://si.imgix.net/06255443/uploads/origins/6e1e60ac-30c6-4f07-9480-39a08162d228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de9075bf1f00c571859b140223c6ace0 2x, https://si.imgix.net/06255443/uploads/origins/6e1e60ac-30c6-4f07-9480-39a08162d228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=838cefd10898af395a79a65c08580fb3 3x", "genre": "art", "nsfw": true, "body": "えっっに 様\n\nこんばんは。\n前回「梅枝ナオミ」をリクエストさせて頂いた者です。\nその節はお世話になりました。\nよろしければ別キャラでもう1枚お願いしたく。\n何卒ご検討のほどよろしくお願い致します。\n\n\n※［★］＝作画用資料あり\n　全て参考程度のものと考えて頂いて構いません。\n\n\n■キャラ\nアニメ『響け！ユーフォニアム』の「田中あすか」をお願いします。［★1］\n容姿端麗、頭脳明晰。\n抜群の美貌とプロポーションを誇る長身の女子生徒です。\n理知的な印象とは裏腹にノリが良く陽気に振る舞まっていますが、\n実は他人に無関心で冷徹かつ利己的。\nしかし聡明で合理的であるが故に悲観的な状況を受け入れ、\n自分を犠牲にしてしまうことも。\n\n■シチュ\n母に部活動を禁止され、悲嘆に暮れるあすか。\nしかし、それを知った担任の教師が母を説得してくれるという。\n渡りに船かと思いきや、その見返りは彼女の体だった。\n吹奏楽…ユーフォニアムは彼女の全て。\nあすかは苦渋の決断を余儀なくされる。\n\n■服装\n北宇治高校の冬服を着用。\n両胸と結合部が見える程度の半裸にして頂けますでしょうか。\nタイツは股間部のみ綺麗に裂かれています。［★2］\nショーツはずらし挿入。\n靴は脱いでいます。\n\n■体位\n腰を押し付けられての正常位を希望です。\n両膝を捕まれ股をこじ開けられながらガン突きされています。［★3］\n男性器の前回同様、比較的大きめでお願いします。\n今回も根元まで捩じ込ませて頂きたく。\n\n■表情など\n諦観したように体を差し出していますが、いざ挿入されると状況は一変。\n喘ぎ悶えそうになるのを懸命に堪え、体を固くしながら耐えています。\n中出しされたとわかると熱った顔に侮蔑の表情を浮かべ、\n冷たい目線を相手に向けます。\n\n■背景\nマンション（教師の自宅）の薄暗い部屋のベッドを希望です。［★4］\n時刻は昼過ぎ頃。晴天。\n冬の日差しがカーテン越しに若干差し込んでいます。\n\n■その他の要望\n①差分で射精断面図をお願いしたく。\n②マフラーをベッド上やあすかの下に無造作に置いて頂きたく。［★5］\n※殆ど見切れてしまっても構いません。\n③もし可能でしたらタイツを脱いだバージョンもお願いしたく。\n※こちらは難しい場合はお忘れください。\n\n\n以上になります。\n何卒ご検討のほどよろしくお願いします。\n\nhttps://x.com/momotaking01/status/1890825782382965145", "created_at": "", "completed_at": ""}, {"path": "/@dsykty/works/137", "thumbnail_src": "https://si.imgix.net/e465b4d6/uploads/origins/cf622b8a-ae7f-450e-8a92-4fdffdbe6b0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae3fc7f6b18acccf540535bb990f3406", "thumbnail_srcset": "https://si.imgix.net/e465b4d6/uploads/origins/cf622b8a-ae7f-450e-8a92-4fdffdbe6b0b