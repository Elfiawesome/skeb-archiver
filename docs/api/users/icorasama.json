0&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=033b4227363fb6c16f85fb21450de9cf, https://si.imgix.net/647490ff/uploads/origins/05f85fb2-6863-496f-8ee1-6c27b8a7bd16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=beb4c90d1046c21c696963b0f03820d0 2x, https://si.imgix.net/647490ff/uploads/origins/05f85fb2-6863-496f-8ee1-6c27b8a7bd16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86bd5569ff84707acff18631b36f2ee2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@icorasama/works/361", "thumbnail_src": "https://si.imgix.net/bfe62d48/uploads/origins/ba87db6e-d93d-41ed-87a1-ae1d896fa709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a9f5a047e45c219eee99b861f9b16f", "thumbnail_srcset": "https://si.imgix.net/bfe62d48/uploads/origins/ba87db6e-d93d-41ed-87a1-ae1d896fa709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a9f5a047e45c219eee99b861f9b16f, https://si.imgix.net/bfe62d48/uploads/origins/ba87db6e-d93d-41ed-87a1-ae1d896fa709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1ad579c8f0f805debf24da7f35cfb20 2x, https://si.imgix.net/bfe62d48/uploads/origins/ba87db6e-d93d-41ed-87a1-ae1d896fa709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd6781466dd5e428957238e7bc553edc 3x", "genre": "art", "nsfw": false, "body": "ウサギ系VTuberのキキ・ピョンピョンを描いていただけませんか？キキはとても内気で愛情深く、動物が大好きです。ペットのウサギ、リトルマンとリトルレディを飼っています。重要な特徴は、頭のクローバー、ウサギの耳、青い目、そしてサイズです。彼女はとても小柄で、体は非常に平らです。人間の耳はありません。参考画像はこちらです。\nhttps://drive.google.com/file/d/1MxOr2sK-g_a2GipPJw8iqFDv4u25Xpjv/view?usp=sharinghttps://drive.google.com/file/d/1XiBUy6rcRXmazoowHpWip5giX3IKVzRu/view?usp=sharing\n\nキキがベッドに横たわり、2匹のウサギの隣で大きな本を読んでいる様子を描いてください。繰り返しますが、ウサギの耳は重要なディテールです。リトルマンは茶色で小さなひげがあります。リトルレディは白です。\nhttps://drive.google.com/drive/folders/1JMFqpftNHjd4tW-73MRLCf8j73hdh8qO?usp=sharingこのイラストはSNSやYouTubeサムネイルに使用可能です。可能であれば透明背景版も追加していただけると助かります。本当にありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@icorasama/works/360", "thumbnail_src": "https://si.imgix.net/f06f759f/uploads/origins/1befc9e6-611d-40e7-9d99-c3ae79fdba92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a32e3d46cd12702287b69d97c89944be", "thumbnail_srcset": "https://si.imgix.net/f06f759f/uploads/origins/1befc9e6-611d-40e7-9d99-c3ae79fdba92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a32e3d46cd12702287b69d97c89944be, https://si.imgix.net/f06f759f/uploads/origins/1befc9e6-611d-40e7-9d99-c3ae79fdba92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa7b069efb1ece0de13e726e395b6c93 2x, https://si.imgix.net/f06f759f/uploads/origins/1befc9e6-611d-40e7-9d99-c3ae79fdba92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=797528606fd6eafcd267460233292b43 3x", "genre": "art", "nsfw": false, "body": "いこら@DQX先生はじめまして。\n納品済みのイラストを拝見し、その淡い色遣いと柔らかな大変かわいいイラストに惹かれました。是非ご依頼させていただきたいです!!\n\n描いていただきたいのは個人勢Vtuber\n汐空なみり( @Shiozora_Namiri)さん\nhttps://x.com/shiozora_namiri\n\n下記イラストのように船の舵輪を手にとり振り向いているイラストを描いていただきたいです。\nhttps://share.google/jQvFL2GjpTsI3xzBZ\n\nまた加えて以下の2点をお願いしたいです。\n\n①汐空なみりさんの活動に使用することの許可をくださること。\n②可能であれば「人物(+舵輪)の透過PNG」「レイヤーの分かれたPSD」のファイルをいただきたい。\n\n何卒よろしくお願いいたします。\n\nhttps://lit.link/shiozoranamiri", "created_at": "", "completed_at": ""}, {"path": "/@icorasama/works/359", "thumbnail_src": "https://si.imgix.net/e1073433/uploads/origins/7d38d07b-65d9-44bd-aedb-689f84ce6867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1596a5dab31c700d7b95950b732af510", "thumbnail_srcset": "https://si.imgix.net/e1073433/uploads/origins/7d38d07b-65d9-44bd-aedb-689f84ce6867?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1596a5dab31c700d7b95950b732af510, https://si.imgix.net/e1073433/uploads/origins/7d38d07b-65d9-44bd-aedb-689f84ce6867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccd468c5eb0b84ecf32b11dbae68b621 2x, https://si.imgix.net/e1073433/uploads/origins/7d38d07b-65d9-44bd-aedb-689f84ce6867?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=415b4449ee105f2039d9a4f9ce12c4fa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@icorasama/works/358", "thumbnail_src": "https://si.imgix.net/25b7f42e/uploads/origins/7b272081-7a68-4d70-a80f-28fe7721f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72a5cd519015a1c660e32b81b29a62f6", "thumbnail_srcset": "https://si.imgix.net/25b7f42e/uploads/origins/7b272081-7a68-4d70-a80f-28fe7721f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72a5cd519015a1c660e32b81b29a62f6, https://si.imgix.net/25b7f42e/uploads/origins/7b272081-7a68-4d70-a80f-28fe7721f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bee3c509b222c523124ad25b10e7a84 2x, https://si.imgix.net/25b7f42e/uploads/origins/7b272081-7a68-4d70-a80f-28fe7721f5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=247b98ded69f38eb489a3c9750103c49 3x", "genre": "art", "nsfw": false, "body": "いらこ様、はじめまして！\nSkebで素敵なイラストを拝見して、是非私が応援しているVtuberの夢咲ひぽぽさんを描いていただきたいと思い、リクエストさせていただきました！\n夢咲ひぽぽさんは「かば」をモチーフにしたVtuberで、可愛い笑顔と裏表の無い素直な人柄、ちょっぴりポンコツなところが魅力の女の子です。\n何卒、よろしくお願いします！\n\n【使用用途】\n・いらこ様のイラストをプレゼントしたいです！\n・リスナーから寄せ書きを募り送る予定です。その寄せ書き(yosetti)の挿絵として、イラストを使用したいです！\n・夢咲ひぽぽさんご本人に限り、活動全般（収益化を含む配信活動や動画、サムネイル、X(旧Twitter)のアイコン・ポスト、切り抜き動画等）で使用許諾をいただきたいです。\n\n【内容】\n・夢咲ひぽぽさんの１枚絵をお願いします。\n・髪型はショート（ウルフカット）、帽子無し、上着有りでお願いしたいです。衣装は参考資料をご確認お願いします。\n・構図・ポーズはお任せいたします。可能であれば、頭部・左右が見切れていない構図にしてもらえると助かります。\n・背景は推しマークの桜をイメージした雰囲気にしてもらえると嬉しいです。\n\n【納品について】\n可能でしたら、キャラクターだけの背景透過データ（PSD、png)も頂けると助かります。\nサインはレイヤーでON・OFFできるようにお願いしたいです。\n\n【参考資料】\nキービジュアル：https://x.com/warewa_kaba/status/1970840406796779911\n新衣装お披露目配信のスクショ：https://drive.google.com/drive/folders/1M2e6qb3O6p-jRjxnWs93WA5ibJuC2osp?usp=sharing\n※三面図が無いため、不明点はアレンジして頂いて構いません。\n\n参考資料少なくて申し訳ありませんが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@icorasama/works/357", "thumbnail_src": "https://si.imgix.net/8c3de658/uploads/origins/2e6749e8-88fe-4ffc-a0d6-61f9e40c10d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a0d6f5bf0171dad9568dfc287547dad", "thumbnail_srcset": "https://si.imgix.net/8c3de658/uploads/origins/2e6749e8-88fe-4ffc-a0d6-61f9e40c10d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a0d6f5bf0171dad9568dfc287547dad, https://si.imgix.net/8c3de658/uploads/origins/2e6749e8-88fe-4ffc-a0d6-61f9e40c10d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db871f87ea955fbfaea26b43ab0f24b5 2x, https://si.imgix.net/8c3de658/uploads/origins/2e6749e8-88fe-4ffc-a0d6-61f9e40c10d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8385cbb94b7fbacdff0e5bff24783915 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@icorasama/works/356", "thumbnail_src": "https://si.imgix.net/17bedf97/uploads/origins/28bb5010-ae95-48e2-b2ba-e231445952cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfbaecf63371de4ab29d4c2a458c133d", "thumbnail_srcset": "https://si.imgix.net/17bedf97/uploads/origins/28bb5010-ae95-48e2-b2ba-e231445952cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfbaecf63371de4ab29d4c2a458c133d, https://si.imgix.net/17bedf97/uploads/origins/28bb5010-ae95-48e2-b2ba-e231445952cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=765a0144d109fad84c4074881f5a00e1 2x, https://si.imgix.net/17bedf97/uploads/origins/28bb5010-ae95-48e2-b2ba-e231445952cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=813ed505dc636bca9c128b9154eb67bd 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\nうちの子たちのイラストをお願いします。\n\nインフルエンザにかかって寝込んでいるありすちゃんと\nありすちゃんを看病するるるちゃんというシチュです。\n\nタオルでありすちゃんの体を拭くるるちゃん。\nありすちゃんは上半身裸。乳首OKです。\n\nるるちゃんはアリスちゃんが「看病するときはナースだよ」という言葉に従い\nミニスカピンクナースワンピースです。\n\nありすちゃんは、るるちゃんに体を拭かれながら、るるちゃんが風邪をひいたら\n裸のるるちゃんの体をたんのうできるなど不埒な妄想をしてにやにやしています。\n（るるちゃんはアンドロイドなので風邪はひきません）\n\n妄想の中のるるちゃんは乳首NGです。\n\nるる「いかがですか？」\nありす「すごく気持ちいー、ありがとう」\n\nるる「……変なこと考えてませんか？」\nありす「んー、よくわからないー」\n\n以上\n\nhttps://skeb.jp/requests/3274128", "created_at": "", "completed_at": ""}, {"path": "/@icorasama/works/355", "thumbnail_src": "https://si.imgix.net/3b14db8f/uploads/origins/84a4db06-e06f-4e3e-bec6-2ca5e8124537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9281356cb684a417260a83ab18e64da8", "thumbnail_srcset": "https://si.imgix.net/3b14db8f/uploads/origins/84a4db06-e06f-4e3e-bec6-2ca5e8124537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9281356cb684a417260a83ab18e64da8, https://si.imgix.net/3b14db8f/uploads/origins/84a4db06-e06f-4e3e-bec6-2ca5e8124537?bg=%23fff&auto=format%2Ccom