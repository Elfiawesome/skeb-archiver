mpress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a840fc778efe1c435bd3c9b7377203d6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nihyaku200/works/18", "thumbnail_src": "https://si.imgix.net/5544a685/uploads/origins/fd9fd9bd-dc7b-40cc-a122-4483d8145b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae86940f34fed7fc1ce168d45dbcc9fe", "thumbnail_srcset": "https://si.imgix.net/5544a685/uploads/origins/fd9fd9bd-dc7b-40cc-a122-4483d8145b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae86940f34fed7fc1ce168d45dbcc9fe, https://si.imgix.net/5544a685/uploads/origins/fd9fd9bd-dc7b-40cc-a122-4483d8145b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ac41ab1654161cbfb63fdc098d9f9ba 2x, https://si.imgix.net/5544a685/uploads/origins/fd9fd9bd-dc7b-40cc-a122-4483d8145b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0414d86c367bc2580902091f146f0da1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のキャラクターを描いていただけませんか？あなたのスタイルなら、彼女は本当にかっこよく見えると思います。\nキャラクター参考：https://i.imgur.com/ZjbT6iB.jpg\nイヤーアクセサリーを?めて、?\n性格は？ドMで、ちょっとチャラくて、お人好しで、自信家。\n服装は？彼女の性格に合うようなものを選んでください。\n表情、ポーズ、背景。表情、ポーズ、背景：すべてお任せします。\n\nhttps://i.imgur.com/ZjbT6iB.jpg", "created_at": "", "completed_at": ""}, {"path": "/@nihyaku200/works/17", "thumbnail_src": "https://si.imgix.net/115a0cb5/uploads/origins/09835877-e3eb-44de-934f-7fe5e87aaea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71fa175f1241a6f2d7c6ebc1d8a1cec4", "thumbnail_srcset": "https://si.imgix.net/115a0cb5/uploads/origins/09835877-e3eb-44de-934f-7fe5e87aaea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71fa175f1241a6f2d7c6ebc1d8a1cec4, https://si.imgix.net/115a0cb5/uploads/origins/09835877-e3eb-44de-934f-7fe5e87aaea8?bg=%23fff&auto=forma