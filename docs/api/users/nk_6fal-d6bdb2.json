dle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bb1cfe4238c099fb7b682b27313a317 2x, https://si.imgix.net/0efea814/uploads/origins/2f8797bf-de7e-4248-aada-663b04c4f4b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01e71564aff16a63e4beb34ebb6b8661 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nk_6fal/works/9", "thumbnail_src": "https://si.imgix.net/f7e14f44/uploads/origins/a35d1936-fd33-41b0-9007-cfff5bc04c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77097c662a8d6722bd5a850e2c976f23", "thumbnail_srcset": "https://si.imgix.net/f7e14f44/uploads/origins/a35d1936-fd33-41b0-9007-cfff5bc04c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77097c662a8d6722bd5a850e2c976f23, https://si.imgix.net/f7e14f44/uploads/origins/a35d1936-fd33-41b0-9007-cfff5bc04c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16f35120092b7d8261fecf9a3351b524 2x, https://si.imgix.net/f7e14f44/uploads/origins/a35d1936-fd33-41b0-9007-cfff5bc04c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ca24836d58e923aefc63e85f4d72aa9 3x", "genre": "art", "nsfw": false, "body": "てんさん初めまして！\n私のOCのイラストを描いて頂きたくリクエスト送らせて頂きました。\n\nキャラクター、服装は資料を添付させて頂いてます。\n下部分に膨らみがあるピンクブラウンのボブヘアーが特徴です。前髪はこちらから見て右側に8割残り2割を左に流しています。\n全て耳にかけるようなスタイルになっています。\n目は少したれ目寄り、瞳は髪色とほぼ同じです。眉は困り眉になりがち。\n表情は柔らかいものが多いです。\n\n服装は添付資料の中から描きやすいものを選んで頂ければと思います。足元まで映る場合靴等はお任せします。\n\n構図等は指定ありませんのでお任せします！\n\n\n是非よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1J9vzCdgiKesIE081Wfl3qZnLP4iMQgYO", "created_at": "", "completed_at": ""}, {"path": "/@nk_6fal/works/8", "thumbnail_src": "https://si.imgix.net/ddb5d178/uploads/origins/8eb32045-3ff3-4274-b871-378006a37408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc3291075ca3299425c2f715c05e6214", "thumbnail_srcset": "https://si.imgix.net/ddb5d178/uploads/origins/8eb32045-3ff3-4274-b871-378006a37408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc3291075ca3299425c2f715c05e6214, https://si.imgix.net/ddb5d178/uploads/origins/8eb32045-3ff3-4274-b871-378006a37408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=297468180769a9748d774b67c533af43 2x, https://si.imgix.net/ddb5d178/uploads/origins/8eb32045-3ff3-4274-b871-378006a37408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a303fa4056dcb1a4d1fd7f1c9f4d462b 3x", "genre": "art", "nsfw": false, "body": "はじめまして、リクエスト失礼します。 てん先生のイラストが好きでリクエストをお送りいたしました。 リンク先のキャラを描いていただいたいです。  \n\nhttps://drive.google.com/drive/folders/1JDPcZ7ZMa3rlFkxrrfR6Swhxdi9Ztwdk\n\n目の色はグレーです。特に細かい指定はないです、カッコよければいいです。\nタバコを吸っている姿が見たいです。服装は水色背景の一枚を参考してください。黒のセットアップのジャージです。\n  ご検討いただけると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JDPcZ7ZMa3rlFkxrrfR6Swhxdi9Ztwdk", "created_at": "", "completed_at": ""}, {"path": "/@nk_6fal/works/7", "thumbnail_src": "https://si.imgix.net/f251b553/uploads/origins/f5a5ea60-7d45-4120-8376-86933087cde1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccc3daa83e4822cd7b978e64a9967deb", "thumbnail_srcset": "https://si.imgix.net/f251b553/uploads/origins/f5a5ea60-7d45-4120-8376-86933087cde1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccc3daa83e4822cd7b978e64a9967deb, https://si.imgix.net/f251b553/uploads/origins/f5a5ea60-7d45-4120-8376-86933087cde1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea241aa5bf7002768422cf013ac210a8 2x, https://si.imgix.net/f251b553/uploads/origins/f5a5ea60-7d45-4120-8376-86933087cde1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a84cc50395356bcebf9fddeb9f8bb08 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nてんさんのイラストが好きで、描いて頂きたくリクエストをお送りいたしました。\n希望する内容は以下の通りです。\n\n▫️うす暗めピンクショートウルフ、前髪ぱっつん\n▫️瞳ピンクブラウン、ボストンメガネ\n▫️黒のダブルスーツ、白のワイシャツ、黒のネクタイ\n▫️黒ネイル、指にシンプルリング複数\n\n特にメガネの有無に関して拘りがありません。\n\n下まつ毛が特に好きでして、バサバサだと嬉しいです。\n表情はにこにこしていてほしいです。\n構図はおまかせいたします。\n\n\nsnsのアイコン、個人用のグッズ作成に使用したいと考えております。\nご検討頂けますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@nk_6fal/works/6", "thumbnail_src": "https://si.imgix.net/49a7e17f/uploads/origins/6301d02a-f5a2-4302-9c74-8fd75bdfea08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09b95a4104f67b33142cda9e53808e56", "thumbnail_srcset": "https://si.imgix.net/49a7e17f/uploads/origins/6301d02a-f5a2-4302-9c74-8fd75bdfea08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09b95a4104f67b33142cda9e53808e56, https://si.imgix.net/49a7e17f/uploads/origins/6301d02a-f5a2-4302-9c74-8fd75bdfea08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a4323b99ca8186555f4388330181b98 2x, https://si.imgix.net/49a7e17f/uploads/origins/6301d02a-f5a2-4302-9c74-8fd75bdfea08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8fc025086aadd26dcd63b2523729b750 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nk_6fal/works/5", "thumbnail_src": "https://si.imgix.net/36b921c2/uploads/origins/4464e0dc-cfda-4bfa-b752-0cf1e1f79f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b221363ec4366ed7593758b15bef6173", "thumbnail_srcset": "https://si.imgix.net/36b921c2/uploads/origins/4464e0dc-cfda-4bfa-b752-0cf1e1f79f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b221363ec4