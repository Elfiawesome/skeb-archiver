ebp&fit=crop&crop=top&w=200&h=200&s=8c969a146dc9ece5f26ec441ae722634, https://si.imgix.net/a32f2a4e/uploads/origins/dfa0ff1b-33a6-4cc2-81c8-4163f0723e15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abec143275d0385971a5f20cbd145bba 2x, https://si.imgix.net/a32f2a4e/uploads/origins/dfa0ff1b-33a6-4cc2-81c8-4163f0723e15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a45d53e77f082daafa006851f0e14f8 3x", "genre": "art", "nsfw": false, "body": "大変お世話になっております。\n薬剤さぷりと申します。\n構図はお任せで薬剤さぷりを描いていただきたいです。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@lol_rakugaki/works/3", "thumbnail_src": "https://si.imgix.net/b058a997/uploads/origins/c9e107da-f18a-4112-85f5-1a82a77f168c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbd8d615db8c358c374fce611e645785", "thumbnail_srcset": "https://si.imgix.net/b058a997/uploads/origins/c9e107da-f18a-4112-85f5-1a82a77f168c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbd8d615db8c358c374fce611e645785, https://si.imgix.net/b058a997/uploads/origins/c9e107da-f18a-4112-85f5-1a82a77f168c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4fe64ffe5fda87f8cc633dda8c613ac 2x, https://si.imgix.net/b058a997/uploads/origins/c9e107da-f18a-4112-85f5-1a82a77f168c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6404f0986c05487a2881803f6b6655da 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lol_rakugaki/works/2", "thumbnail_src": "https://si.imgix.net