t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3321a54e84cd641484aa388c2e9b921 2x, https://si.imgix.net/2858ab34/uploads/origins/8ee786b6-c934-43b2-9ab5-c17b97e7a788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e00d44d4d8d03e2ba0df6c5d438123be 3x", "genre": "art", "nsfw": false, "body": "はじめまして、Twitterで刀ラブのイラストがとても綺麗で好きです。 スケブ再開ありがとうございます！\n私の審神者設定のイラストを依頼したいと思います。\n\n金髮、明るい性格、ほとんど笑っている元気の子です（最近の近侍はおおくりからさん）\n身長は145-150cmくらい\nスーツの姿は正式場て着る、雰囲気は普段とちょっと違う、少々シリアスになる（でも笑顔も全然OK！）\n\n⚠注意：\n①口の形は→「ω」です、笑う時も見えます。笑いないの時は→「^」\n②前髪の上はアホ毛がいる、もみあげは後ろの髮より長い、末はくるくる\n後ろの髮はちょっとくせ毛\n③コートは肩の上につけろ、普段は袖はまくないです\n\nポーズ、構図は全てお任せしますお好きなようにご自由にお絵かきください。\nもし送り方が足りなければ調整しますので、アピールしてください。 何卒よろしくお願い致します...！\n\nhttps://drive.google.com/drive/folders/1G1SyMkYFWD6mTOYRwYuQ7fApKPMtaAZh", "created_at": "", "completed_at": ""}, {"path": "/@hinyariTyomo/works/5", "thumbnail_src": "https://si.imgix.net/f596275a/uploads/origins/d416eabd-ab1f-414d-835b-0d50470101c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8093526a1cd7cbf247960aaee605b22", "thumbnail_srcset": "https://si.imgix.net/f596275a/uploads/origins/d416eabd-ab1f-414d-835b-0d50470101c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8093526a1cd7cbf247960aaee605b22, https://si.imgix.net/f596275a/uploads/origins/d416eabd-ab1f-414d-835b-0d50470101c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be72a19e06d4979229f91310b296aa55 2x, https://si.imgix.net/f596275a/uploads/origins/d416eabd-ab1f-414d-835b-0d50470101c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7031eb1afd9d154d91dbedc2b5b8ad5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hinyariTyomo/works/4", "thumbnail_src": "https://si.imgix.net/665ea266/uploads/origins/c853e46a-7097-4c5d-9716-4afc8266387d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a02ff800f6d1f6411cea1cb43452203", "thumbnail_srcset": "https://si.imgix.net/665ea266/uploads/origins/c853e46a-7097-4c5d-9716-4afc8266387d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a02ff800f6d1f6411cea1cb43452203, https://si.imgix.net/665ea266/uploads/origins/c853e46a-7097-4c5d-9716-4afc8266387d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4898adece7988b8fccfaad42816002c6 2x, https://si.imgix.net/665ea266/uploads/origins/c853e46a-7097-4c5d-9716-4afc8266387d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e3cc324e35dc2d21797dc488b1bad77 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私のダンピールキャラクターの絵をお願いしたいです。\n\n彼はとても陽気で友好的で、少し奇妙です。彼は放浪者でレンジャーです。夫を亡くして以来、世界中を放浪している。迷子になるのが趣味のひとつ。猫と音楽も好きで、竪琴を演奏する。\n\n構図、雰囲気、服装はお任せします。アイパッチとモノクルを忘れずに。ファッションのインスピレーションはこちら：https://www.pinterest.se/toffepajja/jakhein-winterwood/\n\nhttps://toyhou.se/15506671.jakhein-winterwood/gallery", "created_at": "", "completed_at": ""}, {"path": "/@hinyariTyomo/works/3", "thumbnail_src": "https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02433376283a0acb26e6d4e303926011", "thumbnail_srcset": "https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02433376283a0acb26e6d4e303926011, https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e48fa7cd14513622704d0ce0dbe989f 2x, https://si.imgix.net/b9bb95c3/uploads/origins/e0dffe0e-087f-4440-a8b4-5ea125b31d65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61933a786353f095a25c840251165565 3x", "genre": "art", "nsfw": false, "body": "初めまして。Skeb内でお見かけし大変魅力的な絵柄に惹かれましてリクエストさせていただきました。\n以下のキャラクターを描いていただけませんでしょうか？\nもし金額等不備がありましたら再送いただけますと幸いです。\n\n【詳細】\n鼬川 朧(いたちがわ おぼろ):黒髪、黒縁メガネ、まろ眉の男性。\n左目の下と口の右上にホクロがある。26歳。\nほっぺが大体赤い。\nカウンセラーで、なかなかの知識の持ち主。白衣がトレードマーク。\n穏やかで明るいが、どこか引っ込み思案な所もある。\n他人を信じやすく、騙されやすい1面も。他人には天然だと思われることが多い。身長176cm\n\n織織 織(しきおり はとり):化学を中心に理系科目を教えている教師。26歳。\n白衣がトレードマークで、その下はシャツやニットなど落ち着いた装いをしている。先生らしく真面目な印象を受けるが、悪く言えばぱっとしない、何処にでも居そうな成人男性といった雰囲気。\n基本穏やかで物腰も柔らかいが、物事を真っ直ぐ伝える芯の強さのようなものもある。\n黒髪で目元はぼんやりしている。緑眼がやや印象的。ピンクのハイライトが入っている。身長178cm\n\n2人ともお付き合いしている。\n\nhttps://drive.google.com/drive/folders/1EH2n4A8J4ugHwMBCGVMZ4AhinNzeLkv2\n\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hinyariTyomo/works/2", "thumbnail_src": "https://si.imgix.net/bd653421/uploads/origins/a91bf5da-5025-4fbe-8ba5-3f38e338c023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44132ebb3d6b17d188bd96ffc4adef5b", "thumbnail_srcset": "https://si.imgix.net/bd653421/uploads/origins/a91bf5da-5025-4fbe-8ba5-3f38e338c023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44132ebb3d6b17d188bd96ffc4adef5b, https://si.imgix.net/bd653421/uploads/origins/a91bf5da-5025-4fbe-8ba5-3f38e338c023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35848f9070c82598646ca4691eca892a 2x, https://si.imgix.net/bd653421/uploads/origins/a91bf5da-5025-4fbe-8ba5-3f38e338c023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=346b04722781ef565cedf7298d14808d 3x", "genre": "art", "nsfw": false, "body": "Twitterで見たデフォルメ絵が素敵すぎて来ました！オリジナルで、特に資料はないんですが、\n1.眼鏡の男の子\n黒髪色白。ラルフローレンみたいなポロシャツを着ている。坊ちゃん風。真面目。瞳大きめ。本を読んでいる。\n2.女の子\n金欠で泣いてる。黒髪ロング。\n\nという設定で、この2人組の茜さん風のデフォルメ絵を描いていただきたいです。\n用途としてはSNSのヘッダーなどに使いたいです。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hinyariTyomo/works/1", "thumbnail_src": "https://si.imgix.net/924949f6/uploads/origins/127127df-3962-4abe-b442-a45c86828922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=511fa11c781d26ddbba2c3f1ddeef1ed", "thumbnail_srcset": "https://si.imgix.net/924949f6/uploads/origins/127127df-3962-4abe-b442-a45c86828922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=511fa11c781d26ddbba2c3f1ddeef1ed, https://si.imgix.net/924949f6/uploads/origins/127127df-3962-4abe-b442-a45c86828922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1007f4ee7b86ff29d0f1d22290cc0611 2x, https://si.imgix.net/924949f6/uploads/origins/127127df-3962-4abe-b442-a45c86828922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf1a86ba07d485f90341527267290db1 3x", "genre": "art", "nsfw": false, "body": "こんにちは　ロイくんをばリクエストさせていただきます\n季節の変わり目で大変なことも多いと思いますがご自愛くださいな", "created_at": "", "completed_at": ""}]}