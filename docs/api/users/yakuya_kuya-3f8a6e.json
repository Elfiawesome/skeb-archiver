bfb3-aaca115ac1bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f43487158b8edd096c269883c8e72e1 2x, https://si.imgix.net/f530b919/uploads/origins/4ea6d43d-304d-4208-bfb3-aaca115ac1bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8b83374572c0d0ad77a3b110d655a9c 3x", "genre": "art", "nsfw": true, "body": "BLEACHのリルトット・ランパードが資料4枚目のように陵辱されながら食ザーさせられてる絵をお願いします\n\n4枚目の構図が難しいようでしたら、背面座位でアナルを犯されながら両手で手コキをさせられ、マンコから大量のザーメンがこぼれ落ちているような構図でお願いします\n\nリルトットの表情はいずれの場合も\n力さえあればこんな奴ら…！\nというように己の無力さを呪いつつ犯してくる男どもを睨みつけるような感じでお願いします\n\nhttps://imgur.com/a/fj6oxGj", "created_at": "", "completed_at": ""}, {"path": "/@yakuya_kuya/works/10", "thumbnail_src": "https://si.imgix.net/276dea53/uploads/origins/2ae99f97-a76a-46f5-8ef9-b5f61e452a54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32bdb117182cce02ef46569ecf089a49", "thumbnail_srcset": "https://si.imgix.net/276dea53/uploads/origins/2ae99f97-a76a-46f5-8ef9-b5f61e452a54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32bdb117182cce02ef46569ecf089a49, https://si.imgix.net/276dea53/uploads/origins/2ae99f97-a76a-46f5-8ef9-b5f61e452a54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5dcfe9c186a2da33f89ef091dbfc8b1 2x, https://si.imgix.net/276dea53/uploads/origins/2ae99f97-a76a-46f5-8ef9-b5f61e452a54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0d7567bf9e5e78f88f7d9bcb2351ff1 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n\n先生の絵がとても好きなので、お願いがあります。\n艦これの時雨と夕立のイラストを描いていただけませんか？二人とも裸で、床に座る時雨の後ろに夕立が座っています。夕立はいじわるな表情で時雨の片方の胸を弄んでいます。同時に、もう片方の手の指を時雨の口の中に入れて、時雨の口蓋垂を弄る。\n時雨は非常に興奮した表情を浮かべ、全く抵抗しない。\n\n時雨の参考画像：https://i.ibb.co/GnHzKFQ/shigure.jpg\n夕立参考画像：https://i.ibb.co/pQdxJTJ/yuudachi.jpg\n\nご検討いただき、誠にありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yakuya_kuya/works/9", "thumbnail_src": "https://si.imgix.net/d3e9b9a2/uploads/origins/c715df08-cfde-4242-af29-1ecde3043404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8b9be8a1844748cb4698d127b1dec06", "thumbnail_srcset": "https://si.imgix.net/d3e9b9a2/uploads/origins/c715df08-cfde-4242-af29-1ecde3043404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8b9be8a1844748cb4698d127b1dec06, https://si.imgix.net/d3e9b9a2/uploads/origins/c715df08-cfde-4242-af29-1ecde3043404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d60c8c6d0d2d9f956fa96fe6d0244a68 2x, https://si.imgix.net/d3e9b9a2/uploads/origins/c715df08-cfde-4242-af29-1ecde3043404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fe1b205c32102bf7ae7efe606e17d50 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nいつもイラスト拝見しております\n早速リクエストさせて頂きます\n\nキャラ\nアイドルマスターシャイニーカラーズの浅倉透\n\nシチュ\nおねショタシチュでお願いします\nPとこっそり付き合っているのに、どこかPに似たショタに手を出して浮気セックスしちゃうみたいなイメージです\n必死に腰を振るショタに中出しされてイカされるシーンをお願いします\n\nその他要望\n・おっぱいと結合部が見える構図にして欲しいです\n・おっぱいは少し盛ってもらって、大きめの乳輪のぷっくりした乳首にして欲しいです\n\n条件等合いませんでしたら、キャンセル頂けると助かります\nご検討の程、宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@yakuya_kuya/works/8", "thumbnail_src": "https://si.imgix.net/2e785025/uploads/origins/80a5dc32-48f9-41a6-b366-760591ed8866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60c4ea1819bca39ff67ff55c3b0f8279", "thumbnail_srcset": "https://si.imgix.net/2e785025/uploads/origins/80a5dc32-48f9-41a6-b366-760591ed8866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60c4ea1819bca39ff67ff55c3b0f8279, https://si.imgix.net/2e785025/uploads/origins/80a5dc32-48f9-41a6-b366-760591ed8866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&tx