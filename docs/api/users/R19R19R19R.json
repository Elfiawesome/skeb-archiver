の体は輪郭として突き出される（リンク3）。フェローチェェはすぐにヨウをタマに飲み込み、濃厚な精液とフェロモンを浴びせる。フェローチェは、発情期の「メス側」に間に合うように、かわいいトレーナーを「成長」させることができたと喜び、自分の袋をなでる。\n\nhttps://www.pixiv.net/artworks/126794809", "created_at": "", "completed_at": ""}, {"path": "/@R19R19R19R/works/44", "thumbnail_src": "https://si.imgix.net/36b42577/uploads/origins/8e52c36d-5d49-4edd-9bf6-add9c9bf5a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74e957b5f4e2b8567323adf9acd4c6f8", "thumbnail_srcset": "https://si.imgix.net/36b42577/uploads/origins/8e52c36d-5d49-4edd-9bf6-add9c9bf5a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74e957b5f4e2b8567323adf9acd4c6f8, https://si.imgix.net/36b42577/uploads/origins/8e52c36d-5d49-4edd-9bf6-add9c9bf5a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fedfcc7b951c295fa6ff8a4925a7fd2 2x, https://si.imgix.net/36b42577/uploads/origins/8e52c36d-5d49-4edd-9bf6-add9c9bf5a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96abb40f1e1c28f0b992472b28f3ba78 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@R19R19R19R/works/43", "thumbnail_src": "https://si.imgix.net/8b799baf/uploads/origins/0497f209-1fea-4afc-ab6a-83623aaa592b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02f56aaec571450a87dd05fc780d52ac", "thumbnail_srcset": "https://si.imgix.net/8b799baf/uploads/origins/0497f209-1fea-4afc-ab6a-83623aaa592b?bg=%23fff&auto=format%2Ccompress&fm=webp&fi