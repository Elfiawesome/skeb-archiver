fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18f1a3907595fe472d17fb6d709d8b3b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/27", "thumbnail_src": "https://si.imgix.net/8c1d7835/uploads/origins/ba6325e5-3ed1-49ef-b5f8-9fef3d6111ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88d65c8180bb7bbd758d8198ac510151", "thumbnail_srcset": "https://si.imgix.net/8c1d7835/uploads/origins/ba6325e5-3ed1-49ef-b5f8-9fef3d6111ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88d65c8180bb7bbd758d8198ac510151, https://si.imgix.net/8c1d7835/uploads/origins/ba6325e5-3ed1-49ef-b5f8-9fef3d6111ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1aca3ab30abe142c09eb57b5854fa2da 2x, https://si.imgix.net/8c1d7835/uploads/origins/ba6325e5-3ed1-49ef-b5f8-9fef3d6111ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64cd1d973c4e7df46f697c7948afd8fe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/26", "thumbnail_src": "https://si.imgix.net/6ba9cf89/uploads/origins/230f4fcc-3d3e-4cd5-9a85-a9d55fe96f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08783e30c46a382387d5912a7061ca07", "thumbnail_srcset": "https://si.imgix.net/6ba9cf89/uploads/origins/230f4fcc-3d3e-4cd5-9a85-a9d55fe96f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08783e30c46a382387d5912a7061ca07, https://si.imgix.net/6ba9cf89/uploads/origins/230f4fcc-3d3e-4cd5-9a85-a9d55fe96f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c92d1f0c86e7ea5a494da1f5911f4e42 2x, https://si.imgix.net/6ba9cf89/uploads/origins/230f4fcc-3d3e-4cd5-9a85-a9d55fe96f1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be2b5ecb17121389da1de3454a759a4c 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ダイヤのリクエストありがとうございます！\n今回は松浦果南選手をリクエストしたいと思います！URLをご覧ください\n巨根の黒人男性と後背位でナカ出しハードセックス！果南ちゃんのアナルとマンコが丸見え、乳首も丸見え\n果南ちゃんの桃尻をお願いします\nまた、スパンキングや男性の手が果南のお尻に当たり、少し広げてほしい。男性はとても自己主張が強く、果南の中で何度もクンニします\nできれば、アフターセックスで後ろからマンコにザーメンを垂らしながら、果南がお掃除フェラをしているところを見てみたい。あるいは、もう一人の男性がフェラチオをするのもいい。\n男性のディテールは必要ないので、下半身、手、チンコでも可\n残りのディテールはあなたの好みに任せる！  果南のビキニが好ましいが、どんな服装でも構わない。\n果南は自己主張が強く、表情はムラムラしているが、チンコの快感に堕ち、ハートアイでエッチな顔をする＋大量のオシッコ・潮吹き\n可南はハートの中にいて、とても汗ばんでいて、湯気が出ていて、ムラムラしている。\n背景は何でもいいです。\nありがとうございました！\n\nhttps://catbox.moe/c/g6pvd7", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/25", "thumbnail_src": "https://si.imgix.net/5782e172/uploads/origins/12e2202d-476e-4734-91f5-d7cdebd07380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4441abe3eb709b6e8c3bd0931d31c04", "thumbnail_srcset": "https://si.imgix.net/5782e172/uploads/origins/12e2202d-476e-4734-91f5-d7cdebd07380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4441abe3eb709b6e8c3bd0931d31c04, https://si.imgix.net/5782e172/uploads/origins/12e2202d-476e-4734-91f5-d7cdebd07380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc479953bbf161f9d5aa038d85be6c76 2x, https://si.imgix.net/5782e172/uploads/origins/12e2202d-476e-4734-91f5-d7cdebd07380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6680355b26a97181e3d6831084f9c59 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になってます！\n今回はバイト彼方を依頼しに来ました！\n全体的になし崩しで手コキ→フェラ→後背位アナルセックス\n構図：手コキ、フェラは巫女平安名。後背位アナセはナース梨子と同じ。\nこの間のナース梨子の上目遣いやバックの尻の大きい感じや流し目が良かったのでまたお願いします！\n服：彼方→三角巾にエプロンのバイト服(胸は最後まではだけなくて良し)\n店長→チノパンのような下に白シャツ(エプロン等はなくて良し)\n\nバイトで休憩中の彼方(パイプ椅子に座ってる)に店長が話しかける。(まだ竿役は画面になし)\nお疲れ様、いつも頑張ってるね、助かるよと軽い会話後、もう少し稼ぎたいなら頼みたいことがと切り出す。\n私にできることならとやる気。\n最近忙しくて…と話し、これ処理してくれない？と服越しに膨らんだ物を見せる。(平安名の時のように少し斜め気味に竿役)\n面食らった後、冗談やめてくださいよ〜と困惑の愛想笑い。\n竿を見せ再度依頼。彼方はえ〜…と目を逸らしながら困惑笑いで考えるも、内緒にしてくださいよと困惑照れ気味に了承。\n\n手コキしつつどうかと会話を続ける。(困惑というより勝手がわからない感じ)\n店長は良い感じと返しつつ限界が来ると言う。\n急な事に驚きつつかかるとマズいと口で塞ぎ口内射精。(アヘ系より目を閉じて耐えてる感じ)\nこぼすわけにもいかず精飲。\n満足したか聞くと、まだ萎えないからとフェラ要求、なし崩しフェラ→口内射精(少し意識飛び)。しゃぶり方は平安名と同じ感じ。\nもう良いか聞くと最後にお尻見せてと言われ、目を逸らし恥ずかしがりつつ了承。\n\n後背位構図(エプロンスカートを捲り、白パンツが見えてる)\n羞恥に耐えていると尻を揉まれる。\nなし崩しでそのままパンツを下ろされ、この流れは…と思っているとセックスをせがまれる。\nやっぱり〜と笑いつつ焦り、流石にこれ以上は…と避妊等理由を並べているとアナルならとせがまれ、長考の後、了承。\nまさか初めてがバイト先でしかもお尻とは…と目を逸らしながら自虐的に考えていると出るからこのまま出すと言われる。\n急に言われ反射で返事後、また流れで了承したことを考えているうちに腸内射精。\n長い射精が終わり、竿を抜かれる。\n特殊な初体験を終え、店長からまた頼んでいいか聞かれる。\n少し考え色付けてくれるならと困惑了承。\n\n以上です！よければお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/24", "thumbnail_src": "https://si.imgix.net/cceea5fa/uploads/origins/7540127c-75cc-4892-ad67-549a35db321e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84e15494f27a21d41c90ec6cc1f51950", "thumbnail_srcset": "https://si.imgix.net/cceea5fa/uploads/origins/7540127c-75cc-4892-ad67-549a35db321e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84e15494f27a21d41c90ec6cc1f51950, https://si.imgix.net/cceea5fa/uploads/origins/7540127c-75cc-4892-ad67-549a35db321e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a59b400925e2f07202dbcdda66db5ca 2x, https://si.imgix.net/cceea5fa/uploads/origins/7540127c-75cc-4892-ad67-549a35db321e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd56a0c3b2b004929922eb8b9a7c7864 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/23", "thumbnail_src": "https://si.imgix.net/749f3d8b/uploads/origins/54a604cf-76ab-442b-b001-23413861982e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac989d6d352aa1b8d4d66791c18c4a3e", "thumbnail_srcset": "https://si.imgix.net/749f3d8b/uploads/origins/54a604cf-76ab-442b-b001-23413861982e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac989d6d352aa1b8d4d66791c18c4a3e, https://si.imgix.net/749f3d8b/uploads/origins/54a604cf-76ab-442b-b001-23413861982e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18454651aba0b7c3fd04535aabc281cb 2x, https://si.imgix.net/749f3d8b/uploads/origins/54a604cf-76ab-442b-b001-23413861982e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28de463efcf34166664984f3d071ac29 3x", "genre": "art", "nsfw": true, "body": "作品・キャラクター: アイドルマスターシンデレラガールズの棟方愛海（https://imas.gamedbs.jp/cg/idol/detail/22?h=imcgss-c1485）\n\nシチュエーション:\n・服装は白いラインが入った赤のジャージの上着だけ着てジャージのズボンとパンツを脱いだ状態\n\n・両手をロープか何かで頭の上で拘束されている\n\n・正常位で腰を掴まれて激しく突かれて中出しされている\n\n・相手の男の「膣内に精子出すぞ！」「孕め！妊娠しろ！」などのセリフあり\n\n・露出している肌の部分は汗をかいている\n\n・表情は歯を食いしばりながら、目を見開いて涙を流しながら痛みと快感を感じている表情で、「う゛っ」「いい゛っ」「ううう～っ！」のような痛みと快感をこらえるセリフと擬音を入れて欲しいです", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/22", "thumbnail_src": "https://si.imgix.net/ff232981/uploads/origins/7b2b40b2-469f-4f71-9d67-f0d6b08a5309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee18804852046b608ee102f8acfc0a6f", "thumbnail_srcset": "https://si.imgix.net/ff232981/uploads/origins/7b2b40b2-469f-4f71-9d67-f0d6b08a5309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee18804852046b608ee102f8acfc0a6f, https://si.imgix.net/ff232981/uploads/origins/7b2b40b2-469f-4f71-9d67-f0d6b08a5309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec546b2d7252d569a932ef73243fdc13 2x, https://si.imgix.net/ff232981/uploads/origins/7b2b40b2-469f-4f71-9d67-f0d6b08a5309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22f24883f261a1a783952e4a2db28798 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/21", "thumbnail_src": "https://si.imgix.net/33c5dcc8/uploads/origins/68ff9646-5656-4ed7-920e-be39fc5d3f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f480ebdba8731f71523291ecee1f470", "thumbnail_srcset": "https://si.imgix.net/33c5dcc8/uploads/origins/68ff9646-5656-4ed7-920e-be39fc5d3f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f480ebdba8731f71523291ecee1f470, https://si.imgix.net/33c5dcc8/uploads/origins/68ff9646-5656-4ed7-920e-be39fc5d3f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60f9d80e49260647466b55d1f43f9219 2x, https://si.imgix.net/33c5dcc8/uploads/origins/68ff9646-5656-4ed7-920e-be39fc5d3f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dc1f36e01d030ad7dbb39b2da66abd4 3x", "genre": "art", "nsfw": true, "body": "納品直後ですが早速次のを依頼しにきました！\n今回もナース梨子ちゃんをお願いします！\n\nED治療に来た患者の主治医診察後の治療対応というシチュ。お互い服は着ていてセックス時で男が下を脱ぎ、梨子肩・胸まで出す感じ。\nフェラ→口内射精→後背位アナルセックス→飲尿の流れ。\n今回は梨子が優位寄り、患者は調子に乗らず終始敬語。\n\nアナルセックスはpixivに2023/10/13に投稿していたスパンキング西木野さんの構図で接合部が見える感じで、\nそこ以外の部分は前の平安名と同じ構図でお願いします。\n\nフェラシーン構図からのスタートで\n①EDで奥さんとの情事に悩んでいる患者に対して「先生には内緒だけど良い治療法がある」と提案(このシーンでは患者は椅子に座ってるので平安名時と違い梨子の顔を間に脚が見える感じ)\n②奥さんとマンネリなのかも。違う相手や環境が治るきっかけになるかもと唆す。\n③理解しきれない患者に対し、私とシたくない？と直球に聞く。患者は言葉を濁し驚くが提案に呑まれる。\n④「口出してあげるからチンポ出して♡」と出させてフェラ開始。フェラ時の顔は上目で睨むでも笑うでもなくフェラと患者の顔に集中してる感じ。最初はあまり大きくならなかったがちゃんと勃ち褒める梨子。\n⑤限界が来た患者が出そうと言うが、特に反応もせずそのままフェラを続け口内射精。驚くでもなく淡々と射精を受け入れ飲み込む。\n⑥まだ硬いけど続きする？と提案し患者もそれに乗る。\n⑦アナルセックスシーンに移行。挿れてごらんと誘惑。梨子の予想と違いアナルに挿れられる。\n⑧驚きながらも「そっちなんだ♡変態♡」と煽る。患者はせっかくだから試したかったと白状。\n⑨梨子の言動が「浮気チンポ気持ちいい♡」等卑猥に。少し快楽堕ちしつつも最初のビッチ感が残ってる状態でお願いします。(完堕ちまでいかない感じ)\n⑩限界が来て腸内射精。長い射精が終わり抜いた後に綺麗にしなきゃねと再度フェラシーンへ\n11 ここのフェラシーンはベッドに座ってる感じ。お掃除フェラで綺麗にしたところで催してしまった患者。流石に焦って口を離しトイレに案内しようとするが、限界だと頭を抑えられ口内放尿からの飲尿。トイレ扱いに驚きながらも受け入れる。\n12 最後まで新鮮な体験に満足しつつ、また治療に来ると伝える患者。\n\nすぐの依頼で申し訳ありませんが、良ければお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/20", "thumbnail_src": "https://si.imgix.net/4d3df782/uploads/origins/f3f884cb-6463-4ff0-bdeb-bb650012df44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c74511f213d325cd1e2032f7b4f0f08", "thumbnail_srcset": "https://si.imgix.net/4d3df782/uploads/origins/f3f884cb-6463-4ff0-bdeb-bb650012df44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c74511f213d325cd1e2032f7b4f0f08, https://si.imgix.net/4d3df782/uploads/origins/f3f884cb-6463-4ff0-bdeb-bb650012df44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bad6b416266790f890478e09c6b631e2 2x, https://si.imgix.net/4d3df782/uploads/origins/f3f884cb-6463-4ff0-bdeb-bb650012df44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7f7c050dc79589964b1585a6d64e140 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nskeb制作途中で申し訳ないとは思ったのですがナース梨子ちゃんが良すぎたので依頼しに来ました！\n\n夜の見回りをしていた時、眠れないと言う患者を発見。体位は正常位で膣内射精→アナルセックス中出し→腸内放尿の流れをお願いします。描いていたようなスケベな笑みや意識飛び顔が見たいです。\n\n以下シチュの詳細です。\n・体位は2022/12/19にpixivに投稿されていた「西木野さんAV編 act4:正常位編」のような斜めから見た正常位\n・描いていたイラストのような薄暗い夜の患者ベッド\n・竿役はＨ時は段々と強気になるがそれ以外では当たりの良い青年のイメージ\n・竿枠は全裸かはだけた患者服(どちらでも構いません)、梨子はナース服(ぱんつは脚に掛けるか無くても大丈夫です)\n\n【導入シーン】\nベッドで寝ている患者が見回りにきた梨子を見上げている構図(背景が少し開いたコントラクトカーテン)\nもう寝る時間だと伝えにきた梨子に眠れないと言う患者。「じゃあ少し体動かそっか♡」と梨子が提案する。\n\nＨシーンは上記構図で挿入前からのスタート\n①本当に良いのか確認する患者に対し、「早くしないとバレちゃうよ？」と煽り微笑む。\n②挿入。すごい♡ちんぽおっきい♡もっと動いて♡等喘ぐ梨子。\n③そろそろ出ると伝える患者にこのまま出してと喘ぎ、少し驚くも奥まで突き入れ中出し。中出しシーンでは感じながらも笑みを浮かべる少し余裕のある表情。\n④竿を抜いた後、少し精液が垂れた状態。「じゃあ、そろそろ寝よっか」と促すと、まだシ足りない。次はアナルに入れてみたいと言う患者。\n⑤まだできることに驚くと共にお尻は…と止めようとするが間髪入れず挿入される。\n⑥さっきとは打って変わって獣のように喘ぎ散らす梨子。(ここからはオホ声でケツやイク等言葉も下品な感じ)\n⑦このままケツ穴に出すぞと言い、腸内射精。(意識飛び顔)\n⑧長い射精にも感じ喘ぎ続ける梨子。その後、催したが夜でトイレに動くのも面倒だからと腸内放尿を提案。\n⑨冗談よね？と焦り笑いを浮かべる梨子を無視して腸内放尿。\n10：意識飛び顔でオホ声を上げる梨子\n11：抜いて色んな穴から色々漏れる梨子を見て感謝すると共にまたお願いと伝える。\n\n今回も都合によりキャンセルしていただいて構いません。(依頼を重ねてしまいすみません)\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/19", "thumbnail_src": "https://si.imgix.net/b4dfcdb5/uploads/origins/d12cdb31-f566-406f-861e-43d7a7d08768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ee0df0920a64c7abd7bca0f963de76", "thumbnail_srcset": "https://si.imgix.net/b4dfcdb5/uploads/origins/d12cdb31-f566-406f-861e-43d7a7d08768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ee0df0920a64c7abd7bca0f963de76, https://si.imgix.net/b4dfcdb5/uploads/origins/d12cdb31-f566-406f-861e-43d7a7d08768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=127505983d85a4202a16837de078f9d8 2x, https://si.imgix.net/b4dfcdb5/uploads/origins/d12cdb31-f566-406f-861e-43d7a7d08768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d2a88f2cda9b81c98c44dda59176b37 3x", "genre": "art", "nsfw": true, "body": "今回は巫女服平安名を依頼しにきました！ \n\n以下シチュの詳細です。 \n ・フェラを斜め上から見る感じの構図(前回の真姫のような顔〜尻、太ももが見える感じでお願いします。竿役は竿から太ももあたりが見えていれば問題ないです。無理やり足先まで見せる必要はありません。構図上見えてしまう分には大丈夫です)\n ・場所は外の神社の物影。(そこまで暗い雰囲気にしなくても大丈夫です。) \n 導入シーン(外で神社周辺のような背景に平安名が箒を持って立ってる)：神社の裏の方を掃除している平安名が男を見つける。男が賽銭箱を探していると思い、ここは裏側なので表の方に行かないといけないと伝える。 すると、男からその場所までの道案内を頼まれた、了承し付いてくるように言う。物陰に入った所で襲われフェラシーンへ。\n①上記構図で男はスーツを着ている。\n② 札を見せ、この金でフェラをしてくれと頼まれる。\n ③賽銭目的じゃないことを察し、睨み顔で拒否する。\n④男が竿を出し再度せがむ。平安名は困惑、驚きながらもなおも拒否。\n ⑤遠くから妹が自分を探す声が聞こえ驚く平安名。男は妹がいることと平安名を探していることを察し、バレる前に早く済ませた方が良いと揺さぶる。\n⑥状況を考慮し、嫌々了承。竿の根本付近を指先で掴みながら舐め始める。\n⑦男は巫女にフェラされることに感動しながらも、ある程度舐められたところで少し物足りないと咥えるように促す。\n⑧言う通り咥えフェラ続行。\n⑨ 限界が近い男がこのまま口に出すと言い、平安名は嫌がる素振りを見せるも頭を抑えられ、口内射精。竿を握っている手は離してて良いです。(平安名は意識飛び掛けの顔)\n⑩長い射精が終わり口を離したところで口を開けて飲んだことを確認させられる。\n(11)済んだなら早く帰れと睨みながら言い放つと、男は近くにトイレがないかと聞く。\n(12)ないと言うと間に合わないから飲んでくれないかと言われ、全力で拒否。\n(13)だが頭を抑えられ有無を言わさず飲尿。(意識飛び掛けの顔)\n(14)飲尿後再度飲んだことを確認させられる。\n\n今回も差分の多い内容となってしまいました。\n前回の2段階の意識飛びかけ顔や睨み顔が良く、回を重ねるごとにえっちさが増しているので今回もぜひお願いします！\n今回は上目遣いのフェラが見てみたいです！\n 余裕がありましたらぜひよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/18", "thumbnail_src": "https://si.imgix.net/8f780599/uploads/origins/8cab100f-f32c-497d-9455-aa05716397ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=485c28390f9f85da19810b4dd9f2fe8b", "thumbnail_srcset": "https://si.imgix.net/8f780599/uploads/origins/8cab100f-f32c-497d-9455-aa05716397ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=485c28390f9f85da19810b4dd9f2fe8b, https://si.imgix.net/8f780599/uploads/origins/8cab100f-f32c-497d-9455-aa05716397ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5902ff88224a0f2f326e4c2d1642ae0d 2x, https://si.imgix.net/8f780599/uploads/origins/8cab100f-f32c-497d-9455-aa05716397ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5845db41f349111bfcd2b5746b10017a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/17", "thumbnail_src": "https://si.imgix.net/e4024e76/uploads/origins/b6fedaae-6a08-47cd-a831-cb4f60a50249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6415160a6e2c6aa2bdd3da1cfe948238", "thumbnail_srcset": "https://si.imgix.net/e4024e76/uploads/origins/b6fedaae-6a08-47cd-a831-cb4f60a50249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6415160a6e2c6aa2bdd3da1cfe948238, https://si.imgix.net/e4024e76/uploads/origins/b6fedaae-6a08-47cd-a831-cb4f60a50249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4235b551e66edf8ce4212b90cbe2d1d2 2x, https://si.imgix.net/e4024e76/uploads/origins/b6fedaae-6a08-47cd-a831-cb4f60a50249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ee76b46c29e68babe354816ae5d075d 3x", "genre": "art", "nsfw": true, "body": "こんにちは！  \n今回も思い付きOL西木野さんシチュを依頼しにきました！\n前回の取引相手に体を求められてしまい断れず行為へ。行為中別社員が来てしまい3P二穴挿入の流れをお願いします。今回も終始渋々、困惑、嫌がる睨み顔多めでお願いします。\n\n以下シチュの詳細です。 \n・四つん這い気味の騎乗位で斜め前からの構図(顔、尻、太ももが見える感じでお願いします。)\n・部屋は前回の社長室の床\n・竿役、真姫共に下だけ脱いでいる。(社長と社員でスーツの色に違いがある)\n\n導入シーン(前回の1シーン目と同じ構図で構いません。前回と違い男の足が見えず、真姫はソファは座っている)：仕事の話(契約変更・更新、別の案件等会話の中で使いやすいもので構いません)をしている途中で男から行為をせがまれる。真姫は予想はしていたが、受け入れるまで少し時間がかかり渋々了承。\n\n①上記構図で行為。\n② 少し会話をした後キスをせがまれる。\n③舌先を当てるくらいのキスから絡ませるキスへ。(睨み気味、目を瞑る等の嫌々顔)側面から見た口元のカットインをお願いします。\n④射精を予告され、外に出すように言うがキスで口を塞がれ膣内射精。(前側からの構図で見えないので挿入部分の射精カットインが欲しいです。)\n④余韻を感じているところに別社員が来てしまい見られてしまう。\n⑤混ざるように言われ社員も困惑しつつ尻穴が開いていると誘導される。真姫は嫌がる素振りを見せるが竿をあてがわれそのまま挿入。穴に竿を当てる時以降④と同じ構図の接合部のカットインをお願いします。(④で射精した精液はこの時なくて大丈夫です。)\n⑤二穴挿入のまま射精(真姫は意識飛びかけのイキ顔)\n⑥社長が社員に真姫が飲尿したことを話し、尻穴に放尿することを提案。\n⑦社員はその話に驚きながらも興奮し、嫌がる真姫を無視し放尿。\n⑧尻穴から竿を抜かれ、耐えようとするが大量の尿を堪え切れず大噴出。男達に嘲笑われる。\n\n今回の設定もカットイン等細かい上、導入シーンの希望も出してしまいました。金額的に厳しい場合、キャンセルしていただいて構いません。 \n前回の真姫ちゃんも意識飛びかけ、嫌々の睨み顔・目瞑り顔がとてもえっちでしたので今回もそそる表情をお願いします！\n余裕がありましたらぜひよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/16", "thumbnail_src": "https://si.imgix.net/d06ec421/uploads/origins/c66fabe3-c08f-47c0-ac49-a4fef31a40ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb459b6b049afd1f72a1148ce3a23361", "thumbnail_srcset": "https://si.imgix.net/d06ec421/uploads/origins/c66fabe3-c08f-47c0-ac49-a4fef31a40ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb459b6b049afd1f72a1148ce3a23361, https://si.imgix.net/d06ec421/uploads/origins/c66fabe3-c08f-47c0-ac49-a4fef31a40ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=387de9230279d4222a572ba65f775bd6 2x, https://si.imgix.net/d06ec421/uploads/origins/c66fabe3-c08f-47c0-ac49-a4fef31a40ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9613cb37891fac2041957032841a23bb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/15", "thumbnail_src": "https://si.imgix.net/3ddc72b3/uploads/origins/0aa2a007-d2c9-4d43-b708-b50703703c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=686cd993addd7adcc3f2b62a6693b6dc", "thumbnail_srcset": "https://si.imgix.net/3ddc72b3/uploads/origins/0aa2a007-d2c9-4d43-b708-b50703703c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=686cd993addd7adcc3f2b62a6693b6dc, https://si.imgix.net/3ddc72b3/uploads/origins/0aa2a007-d2c9-4d43-b708-b50703703c09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80618bb7ff19a44714268294f5b2d7e5 2x, https://si.imgix.net/3ddc72b3/uploads/origins/0aa2a007-d2c9-4d43-b708-b50703703c09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41cf52d3bd6ce9a14fef6d7b8a4a43a8 3x", "genre": "art", "nsfw": true, "body": "こんにちは！  \n毎度毎度ですがまたOL西木野さんでの思い付きシチュを依頼させていただきたいです！ \n\n今回は大手取引先のお偉いさんへのゴマすりとして向かった真姫ちゃんが相手からファラチオを要求され、最後には口内放尿の流れをお願いします。\n  以下シチュの状態です。 \n状況：真姫は上司から取引先へ粗相がないように念入りに言われたため嫌々要求を承諾している。(今回は堕ちなしで終始嫌がる睨み多めでお願いします。)\n・主観構図 \n・部屋のイメージは社長室なような少し高そうな部屋\n・男はスーツ\n・男はソファに座っており真姫は男の脚の間に正座している。\n①取引先が案件が欲しいならと相手するように要求(まだスラックスからは竿を出していない)\n真姫は驚きながらも悪い冗談と思っている。\n② スラックスから竿を出した男に軽蔑の目を向け、渋々了承。\n③竿舐め→しゃぶるの流れでフェラ\n④男は射精を口で受け止めるよう言い、口内射精(イラマのように頭に手は置かず真姫が仕方なく受け入れている状態)\n⑤全部飲んだことを確認するため口を開けさせる。\n⑥催したので飲尿を要求。真姫は本気で驚きながらも案件は自分の対応次第であることを弱みにされ嫌々咥える。\n⑦口内放尿→飲尿\n⑧最後も飲み切ったことを確認するため口を開けさせる。\n⑨男が案件では色をつける代わりこれからもこの関係を要求する。\n\n真姫ちゃんの睨み顔や上目で意識が飛びかけている感じの顔がとても好きなので今回も多めでお願いします！\n真希ちゃんと竿役のセリフや心情も背徳心をそそるものを期待してます！\n今回はより設定が多めなので金額的に厳しい場合、キャンセルしていただいて構いません。 \n余裕がありましたらぜひよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/14", "thumbnail_src": "https://si.imgix.net/3532f226/uploads/origins/e4bb403c-17fc-459c-8bb9-92b690fc5f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ed198c5c584aaaf23945054837ed5eb", "thumbnail_srcset": "https://si.imgix.net/3532f226/uploads/origins/e4bb403c-17fc-459c-8bb9-92b690fc5f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ed198c5c584aaaf23945054837ed5eb, https://si.imgix.net/3532f226/uploads/origins/e4bb403c-17fc-459c-8bb9-92b690fc5f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61f62dc412ed48a944436173e3f73b67 2x, https://si.imgix.net/3532f226/uploads/origins/e4bb403c-17fc-459c-8bb9-92b690fc5f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83ff9cc88de69f34825d5ae84d33aeba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/13", "thumbnail_src": "https://si.imgix.net/1f932be0/uploads/origins/edc8ac7a-f49e-4e3b-b571-5c06deab4976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c4b856c0c03bcf96034094d1c17285", "thumbnail_srcset": "https://si.imgix.net/1f932be0/uploads/origins/edc8ac7a-f49e-4e3b-b571-5c06deab4976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c4b856c0c03bcf96034094d1c17285, https://si.imgix.net/1f932be0/uploads/origins/edc8ac7a-f49e-4e3b-b571-5c06deab4976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e4283fea551da46b6ea763ccc4149c9 2x, https://si.imgix.net/1f932be0/uploads/origins/edc8ac7a-f49e-4e3b-b571-5c06deab4976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1a0d9d49c7bc737fea2f94f528a4727 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n黒澤ダイヤをお願いします！    美しいダイヤが性欲にまかせてセックスしているシチュエーション～。\n色黒の巨根オヤジと騎乗位で向かい合ってナカ出しセックス！  ダイヤちゃんのパーフェクトボディに似合う丸々としたいいお尻をお願いします～。\n男性とダイヤはキスを交わしており、口の間には唾液の裁判が行われている。  また、スパンキングや男性の手がダイヤのお尻に当たり、少し広げているところも見てみたい！\n男性のディテールは必要ない。口があれば無表情でもいい。\nあとはお好みで！  服装は問いません。  パルヘリオンのヨハネの衣装か、浦の星の女子校生の衣装が望ましい。\nディアの表情は嬉しそうでムラムラしているのが良いが、性格に合わせて最初は緊張していたり、恥ずかしそうにしていたり、その後淫乱になるのが良いかもしれない。\n背景は問いません。\nよろしくお願いします！\n\nhttps://files.catbox.moe/whhkls.png", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/12", "thumbnail_src": "https://si.imgix.net/93ccc7bd/uploads/origins/9bc2e785-72cb-4fb9-b3c4-407bff58cf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89e43bd550685186d542d93cc166df46", "thumbnail_srcset": "https://si.imgix.net/93ccc7bd/uploads/origins/9bc2e785-72cb-4fb9-b3c4-407bff58cf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89e43bd550685186d542d93cc166df46, https://si.imgix.net/93ccc7bd/uploads/origins/9bc2e785-72cb-4fb9-b3c4-407bff58cf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7c21751d897720c6efc68fae958f7be 2x, https://si.imgix.net/93ccc7bd/uploads/origins/9bc2e785-72cb-4fb9-b3c4-407bff58cf1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c27dabfd52f9f6dc4c4937e8cdefc05 3x", "genre": "art", "nsfw": true, "body": "政治家の懇親会でビキニにチップを入れられている西木野真姫ちゃんをお願いします\n「夏色えがおで1,2,Jump!」の水着を下品に加工した過激な衣装で、\n恥ずかしながらも媚びている表情が見たいです\n政治家たちはその様子を楽しんだり馬鹿にしてる感じでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/11", "thumbnail_src": "https://si.imgix.net/6b22b085/uploads/origins/4c0f8267-be16-4c82-b71b-7e5cb855f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=866dc05dc9c7e7b3949eae8547c0d39b", "thumbnail_srcset": "https://si.imgix.net/6b22b085/uploads/origins/4c0f8267-be16-4c82-b71b-7e5cb855f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=866dc05dc9c7e7b3949eae8547c0d39b, https://si.imgix.net/6b22b085/uploads/origins/4c0f8267-be16-4c82-b71b-7e5cb855f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a51513c790adb947c36177839b4d132 2x, https://si.imgix.net/6b22b085/uploads/origins/4c0f8267-be16-4c82-b71b-7e5cb855f4b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ceafb2d1e6aa69c33de4966427e81f4 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nOL西木野さんシリーズをまた依頼させていただきたいです！\n今回は会社の洋式トイレにまんぐり返しの状態でガムテープで拘束され、同僚男の肉便器にされている真姫ちゃんをお願いします！\n\n以下シチュの状態です。\n・斜め前からの構図\n・上はスーツを着たままで、下は何も履いてない。\n既に膣内射精がされた後がわかる感じがあれば嬉しいです。\nマジック等での体へのラクガキ描写は少し苦手なので避けていただければ助かります。\n\n①他社員から肉便器にされている情報を得た同僚男。\n②同僚男はアナルセックス派のためアナルセックスをして腸内へ射精後、そのまま抜かずに放尿。\n③事が一通り済んだ後イラマチオで綺麗にさせられる。\n④真姫ちゃんは腸内に出された尿を堪えられず尻から吹き出してしまう。\n\n今までの嫌々の睨み顔が堕ちていく感じが大好きなので今回もセリフ煽りで堕としてもらえると嬉しいです！\n\n今回も内容が多めなので金額的に厳しい場合、キャンセルしていただいて構いません。\n余裕がありましたらぜひよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/10", "thumbnail_src": "https://si.imgix.net/ffaf718f/uploads/origins/c3b36cb3-8b91-4bb9-a1ba-c2c7b8af7d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e76fcf86a3d492ee364d427bce86777", "thumbnail_srcset": "https://si.imgix.net/ffaf718f/uploads/origins/c3b36cb3-8b91-4bb9-a1ba-c2c7b8af7d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e76fcf86a3d492ee364d427bce86777, https://si.imgix.net/ffaf718f/uploads/origins/c3b36cb3-8b91-4bb9-a1ba-c2c7b8af7d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d20bd919afb47f404ff32abb9400942 2x, https://si.imgix.net/ffaf718f/uploads/origins/c3b36cb3-8b91-4bb9-a1ba-c2c7b8af7d9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b425c5c9c34ef555528f23a8b106a9c 3x", "genre": "art", "nsfw": true, "body": "初めまして \nもしよろしければラブライブの花丸&花陽ちゃんのエッチイラストをお願いしたいと思います\n\n[背景と衣装]\nまず背景は電車のクロスシートから,花陽と花丸の両方とも冬制服です\n花陽はジャケット、花丸は黄色のカーディガンを除いた残りは着たままで、2人とも上着は左右に広げ おっぱいが見えながら、スカートは上に上がった姿で、パンツと黒ストは膝まで下がってアソコが見える姿で描いてください\n（花丸のカーディガンを除いた制服姿は善子やルビィの冬制服を参考にしてください）\n\n[状況]\n花陽は事後（中出し）で足を開脚したまま涙を流しながら、逆に体は快感を覚えてしまい自分で指を入れてオナニーする姿で、隣に座った花丸は背面座位で男は花丸のおっぱいを揉みながら思いっきり犯しています\n\n差分で全裸の違いをお願いします、金額的に無理なら再送を、その他の理由ならスルーしてください\n\nまた陰毛の描写は不要です、 残りは全部お任せします\n\nでは、どうかご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/9", "thumbnail_src": "https://si.imgix.net/7a189a4b/uploads/origins/ce44291b-b1a4-4386-99b5-0f8fd011e643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3548bf7890804eeb99c16ca8e0a4c7e5", "thumbnail_srcset": "https://si.imgix.net/7a189a4b/uploads/origins/ce44291b-b1a4-4386-99b5-0f8fd011e643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3548bf7890804eeb99c16ca8e0a4c7e5, https://si.imgix.net/7a189a4b/uploads/origins/ce44291b-b1a4-4386-99b5-0f8fd011e643?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8626ab073aa847106ae3e93f317760e 2x, https://si.imgix.net/7a189a4b/uploads/origins/ce44291b-b1a4-4386-99b5-0f8fd011e643?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e879c9b824eb842dc5da2c3bd3550e6 3x", "genre": "art", "nsfw": true, "body": "アイドルマスターシンデレラガールズというゲームの棟方愛海（https://imas.gamedbs.jp/cg/idol/detail/22?h=imcgss-c1485）をお願いします。  \n\n・服装は体操服とブルマ\n\n・横から見たアングルで、跳び箱に上半身を乗せた格好で立ちバック\n\n・｢おっ♡｣｢お゛おっ♡｣「おほぉっ♡」等の声をあげて、お互いに快感を貪る獣みたいな激しいセックスをしている\n\n・セックスの擬音や、中出しされた差分も入れて欲しいです", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/8", "thumbnail_src": "https://si.imgix.net/1aa08fb9/uploads/origins/75a1e852-8c85-441b-a023-07e1ee1101c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aaabdc3ca503eba088595afca18b084", "thumbnail_srcset": "https://si.imgix.net/1aa08fb9/uploads/origins/75a1e852-8c85-441b-a023-07e1ee1101c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aaabdc3ca503eba088595afca18b084, https://si.imgix.net/1aa08fb9/uploads/origins/75a1e852-8c85-441b-a023-07e1ee1101c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f46c7f2dae7adcaf5dcde66f72b983c 2x, https://si.imgix.net/1aa08fb9/uploads/origins/75a1e852-8c85-441b-a023-07e1ee1101c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c58342ceaedd8f5dd25adc98f24798e5 3x", "genre": "art", "nsfw": true, "body": "こんにちは( ˘ω˘ ) \n\nOL真姫ちゃんのフェラが良かったのでまた依頼に来ました。  \n\n前回のデスク下でのフェラ後でシチュエーションをお願いします！\n\n前回の社員とは違う社員からフェラをしていたことを脅しにまたフェラをさせられることに。  \n(背景はキングファイル等の保管されている棚がある書庫室)\n構図はティーティーさんのpixivで2023/5/12に投稿されていた真姫ちゃんと同じ感じでお願いします。\n 以下差分の流れです。\n①嫌々フェラ \n②口内射精  \n③射精後催した社員が口内に放尿\n④ 驚きながらも飲尿\n\n今回も飲んだ描写もあると嬉しいです。 \n前回の社員とのセリフが背徳感がありとても良かったので今回も何かあると嬉しいです。\n予算の都合で厳しい場合キャンセルしていただいて構いません。  \n再度のリクエストですみませんがよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/7", "thumbnail_src": "https://si.imgix.net/de0acfb8/uploads/origins/e1e49f94-196b-4aaa-9af0-fa55e432d028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66f265f4a5bcef8eb4facb8b32043255", "thumbnail_srcset": "https://si.imgix.net/de0acfb8/uploads/origins/e1e49f94-196b-4aaa-9af0-fa55e432d028?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66f265f4a5bcef8eb4facb8b32043255, https://si.imgix.net/de0acfb8/uploads/origins/e1e49f94-196b-4aaa-9af0-fa55e432d028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c52d22ae34dd41f7c3eccf37127a251 2x, https://si.imgix.net/de0acfb8/uploads/origins/e1e49f94-196b-4aaa-9af0-fa55e432d028?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=098558594f4248a1c9da59a70441ec49 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nラブライブ！の葉月恋がセックスしている絵が欲しいです。\n体位は逆騎乗位でお願いします。\n彼女を正面から見たいです。\n彼女は目を上に向け、口を開けているはずだ。\nペニスが彼女の膣の中に入っているはずだ。\n彼女はパートナーと一緒にオーガズムを感じていて、精液が滴り落ちている。\n最後に、彼女の陰毛は濃くしてほしい。\n\nこの参考画像のような絵にしたい：\nhttps://sta.sh/02d0zsmi1ipe\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/6", "thumbnail_src": "https://si.imgix.net/68138eb1/uploads/origins/e7b68f11-e5ee-464e-b06f-3960aaf629f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a38f2f15d5fb1fa0f35d9d9ebe5988a6", "thumbnail_srcset": "https://si.imgix.net/68138eb1/uploads/origins/e7b68f11-e5ee-464e-b06f-3960aaf629f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a38f2f15d5fb1fa0f35d9d9ebe5988a6, https://si.imgix.net/68138eb1/uploads/origins/e7b68f11-e5ee-464e-b06f-3960aaf629f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d860313eadb85d30c4cc237054772a6 2x, https://si.imgix.net/68138eb1/uploads/origins/e7b68f11-e5ee-464e-b06f-3960aaf629f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c202baadb105469fc33f04111dd64f07 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nラブライブ虹ヶ咲の川本美里と三船薫子を描いてほしいです。2コマでお願いします。上のコマでは、二人が座ってビールを飲んでいて、その真ん中に男性が座っている。二人の女の子は酔っぱらって顔を赤らめ、彼といちゃつくはずだ。台詞は自由に考えてください。一番下のコマでは、3人が裸でベッドの上に乗ってセックスしているところを描いてほしい。男は後ろから薫子とセックスしてほしい。そうしている間、彼は美里にキスをしたり抱きついたりしているはずだ。アングルなど細かいことはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/5", "thumbnail_src": "https://si.imgix.net/bb780f56/uploads/origins/9e45011a-8522-4a9a-80bb-73088a9054ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61aa7f2b36534d171b1b6c811f9e107d", "thumbnail_srcset": "https://si.imgix.net/bb780f56/uploads/origins/9e45011a-8522-4a9a-80bb-73088a9054ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61aa7f2b36534d171b1b6c811f9e107d, https://si.imgix.net/bb780f56/uploads/origins/9e45011a-8522-4a9a-80bb-73088a9054ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f66cb327cddd13feaa1c855221481f59 2x, https://si.imgix.net/bb780f56/uploads/origins/9e45011a-8522-4a9a-80bb-73088a9054ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15b1d1641eaf4f385e53643b9338784b 3x", "genre": "art", "nsfw": true, "body": "こんにちは( ˘ω˘ )  \n依頼文を調整しましたのでリクエストし直しました。\n\n前に描かれていたOL真姫ちゃんが好き過ぎるのでリクエストします！\nデスクワーク中の男性社員の机の下でOL真姫ちゃんがフェラをしているシチュエーションをお願いします。 \n構図は少し斜め上からの若干引き気味(近過ぎない程度で構いません)でお願いします。\n 以下差分の流れです。\n ①弱みを握られてる感じで嫌々フェラ\n ②口内射精 \n③咥えたまま息を整えようとしているところでイラマチオされる。\n ④そのままもう一度口内射精 \n飲んでる描写もあると嬉しいです。 \n 予算の都合で厳しい場合キャンセルしていただいて構いません。 \nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/4", "thumbnail_src": "https://si.imgix.net/4a5038ea/uploads/origins/73ee0259-823a-4df5-a7ad-05688c12597f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e283688c6f46b7158c1cff1a9128ba6d", "thumbnail_srcset": "https://si.imgix.net/4a5038ea/uploads/origins/73ee0259-823a-4df5-a7ad-05688c12597f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e283688c6f46b7158c1cff1a9128ba6d, https://si.imgix.net/4a5038ea/uploads/origins/73ee0259-823a-4df5-a7ad-05688c12597f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9144df61a879cfab3a5e019c88e1a627 2x, https://si.imgix.net/4a5038ea/uploads/origins/73ee0259-823a-4df5-a7ad-05688c12597f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a23e78cd88684a6b5f9a5b26c29dbdc 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nティーティー様のイラストを素晴らしいと思いながら私はいつも拝見させていただいております！\n特にバック桜内さんと正常位桜内さんが私のお気に入りで、是非リクエストをさせていただければと思います！\n\nキャラクター\n桜内梨子\n\nシチュエーション\n西木野真姫av編でいつも真姫ちゃんを調教している男に、桜内梨子(マン毛ありで、黒ニーソのみ着用以外は全裸)が正面を向き、後ろに鏡がある部屋でY字バランスをさせられ、背後からスパンキングをされる\n→お尻が真っ赤になっても、梨子ちゃんも嫌がるセリフや様子を見せるが、強めの渾身の一発をお尻を叩かれた瞬間、おしっこを大量に吹き出しオホ顔で絶頂。(鼻水やよだれも出ていると嬉しいです)\n→アヘ顔で快感に溺れ、アナルからもエロ汁を滴し、足元に水溜まりを作りながら、もっとスパンキングをくださいと言いながらチョロチョロとおしっこを漏らし続ける\n\n※梨子ちゃんの背後の鏡ですが、お尻が見えれば良いので、全身の背面イラストが面倒ならば、イラストの端にお尻部分のみの状況を描写していただくかたちでも大丈夫です\nそれと、もし可能であればで良いのですが、パンティ(薄ピンク)ありの差分もいただけると嬉しいです…\n\n出来ればセリフは多めに、ティーティー様にお任せで付けていただきたいです\n\n内容が細かく申し訳ないのですが、是非お願いできればと思います🙇", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/3", "thumbnail_src": "https://si.imgix.net/365dfd78/uploads/origins/ce409cbd-035e-4cbd-bfd7-0773b2de4f36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50e962738d315e725426bf24aebd5d42", "thumbnail_srcset": "https://si.imgix.net/365dfd78/uploads/origins/ce409cbd-035e-4cbd-bfd7-0773b2de4f36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50e962738d315e725426bf24aebd5d42, https://si.imgix.net/365dfd78/uploads/origins/ce409cbd-035e-4cbd-bfd7-0773b2de4f36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b150e0029cc0bf0c5b983bb82861f991 2x, https://si.imgix.net/365dfd78/uploads/origins/ce409cbd-035e-4cbd-bfd7-0773b2de4f36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4342ab505c868aa69bccf15ee402bc29 3x", "genre": "art", "nsfw": true, "body": "ラブライブ！西木野真姫ちゃんが\n手マンされながらカラオケで歌い、\n採点で90点以上を出せれば100万円もらえる\n「手マンカラオケ」というエロバラエティに参加しているシーンをお願いします。\n\n衣装はレザーグロス・クイーン\n課題曲は「PSYCHIC FIRE」で、\nイケメンAV男優の手マンによって雌にされ、\nテレビに映せるギリギリの顔にされる感じが欲しいです。\n※実際に描いていただく必要はないですが、\n1曲歌い切るまでに3回以上イってしまうくらいのよわよわ真姫ちゃんでお願いします。\n\n真姫ちゃんと男優の2人とも腰より上だけ描いていただき、\n実際に手マンされているところは見せないようにお願い致します。\n男優の顔は適当で大丈夫です。", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/2", "thumbnail_src": "https://si.imgix.net/6145f092/uploads/origins/b6684071-9805-4dd5-9b2a-bc9186ba089a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d882da75ae87cf4dab45b9e4cf90aff7", "thumbnail_srcset": "https://si.imgix.net/6145f092/uploads/origins/b6684071-9805-4dd5-9b2a-bc9186ba089a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d882da75ae87cf4dab45b9e4cf90aff7, https://si.imgix.net/6145f092/uploads/origins/b6684071-9805-4dd5-9b2a-bc9186ba089a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29255198cc988d5bb28c56d3beb739fc 2x, https://si.imgix.net/6145f092/uploads/origins/b6684071-9805-4dd5-9b2a-bc9186ba089a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d374da762f856e8b249e3bd6a61d4dde 3x", "genre": "art", "nsfw": true, "body": "アイドルマスターシンデレラガールズというゲームの棟方愛海（https://imas.gamedbs.jp/cg/idol/detail/22?h=imcgss-c1485）をお願いします。\n\n・前にpixivに投稿された西木野真姫のイラスト（https://www.pixiv.net/artworks/109219816）のような主観視点で、口に注がれたおしっこを飲んでくれている\n\n・服装は全裸\n\n・注がれている擬音や飲んでくれている擬音、おしっこプレイを楽しんで興奮している感じのセリフを入れて欲しいです", "created_at": "", "completed_at": ""}, {"path": "/@ej_ri5/works/1", "thumbnail_src": "https://si.imgix.net/85d8c3af/uploads/origins/2b2cf92c-a9c8-4766-baa9-624de598e680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47761a8f09f72c1fc1978e37de57f8a", "thumbnail_srcset": "https://si.imgix.net/85d8c3af/uploads/origins/2b2cf92c-a9c8-4766-baa9-624de598e680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47761a8f09f72c1fc1978e37de57f8a, https://si.imgix.net/85d8c3af/uploads/origins/2b2cf92c-a9c8-4766-baa9-624de598e680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfd6716ffb541e1e1c90746f350f2df8 2x, https://si.imgix.net/85d8c3af/uploads/origins/2b2cf92c-a9c8-4766-baa9-624de598e680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4118ad176201e21302eccfd749bdc06 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nおしっこがお好きとプロフィールに書かれていたので、依頼させていただきました。\n\nオリジナルキャラクターがOKでしたら、うちの子（参考URLの青い子）が野外で全裸になって、気持ちよく放尿している姿をお願いします。\n下の毛はなく、つるつるのすじ状態です。\n靴と靴下だけ残っていると野外っぽいかもしれません。\n大変そうであれば、背景は無くても構いません。\nポーズや構図はお任せしますが、出ている部分がよく見えるように大胆なポーズがいいなと思います。例えば、立ったままや、大きく開脚したポーズ、ワンちゃんのちんちんボーズや、ワンちゃんの片足を上げたポーズなど。\nお任せが多いですが、どうかよろしくお願いします。\nhttps://twitter.com/NagatabiP/status/1508037058677587969?t=P37rfxbIlvVlMKG7TrUD5g&s=19", "created_at": "", "completed_at": ""}]}