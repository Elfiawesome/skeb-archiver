-8ac6-ada23c09e43c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d54f205cfecaf211b5f828c8e76025, https://si.imgix.net/a775dc12/uploads/origins/03135227-cbc9-488d-8ac6-ada23c09e43c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41b196951e923f034b27ea9870f082df 2x, https://si.imgix.net/a775dc12/uploads/origins/03135227-cbc9-488d-8ac6-ada23c09e43c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0510def29aae6bdb4365472828eb0ac 3x", "genre": "art", "nsfw": false, "body": "鉢田エク先生、初めまして！\nいつも素適なイラストを拝見し、とても可愛い絵柄に惹かれ、\nこの度リクエストを送らせて頂きました。\n\nBILIBILIで活動しているVliver の步玎Puddingさんのイラストをお願いしたいのです。\nポーズや構図、表情など詳細は先生にお任せしたいですが、明るく可愛らしい雰囲気で描いて頂けると幸いです！\n用途としては主に配信、動画、SNSやBILIBILIでのプロモーションなどです。\n\n可能であれば、PSDファイルでキャラクターと背景のレイヤーを分けして頂けますと幸いです。\n\nお忙しいところ恐縮ですが、\nご検討のほど、何卒よろしくお願い致します。\nご縁がありますように…！\n\nhttps://drive.google.com/file/d/16UCarLnScWq4UcK5dJ98F6KdPLVQLuQs/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@8DAEK/works/41", "thumbnail_src": "https://si.imgix.net/69bcf2b1/uploads/origins/b7a5b7ea-0f50-4b5d-a015-2bfbb79f89bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b5aa9efc09118437bc5b6cdb3b5685", "thumbnail_srcset": "https://si.imgix.net/69bcf2b1/uploads/origins/b7a5b7ea-0f50-4b5d-a015-2bfbb79f89bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b5aa9efc09118437bc5b6cdb3b5685, https://si.imgix.net/69bcf2b1/uploads/origins/b7a5b7ea-0f50-4b5d-a015-2bfbb79f89bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f88fa30da6a05f9e8b04110e40ef72a4 2x, https://si.imgix.net/69bcf2b1/uploads/origins/b7a5b7ea-0f50-4b5d-a015-2bfbb79f89bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13d659316a40ccbc5b32c5b0420267af 3x", "genre": "art", "nsfw": false, "body": "はじめまして、いつも素敵なイラスト拝見させて頂いております。先生の描かれるヨシヅキ参謀さんが大好きなので今回依頼させていただきたいです。\n\nかっこいい雰囲気の参謀さんが、小さくなった探索者を抱えているイラストでお願いしたいです。探索者の希望は深水暁ちゃん、淀水蝶花ちゃん、玄冬鶍ちゃんの3人なのですが、金額に合わせて調整して頂ければと思います。\n\n【資料】\n・深水暁ちゃん\nhttps://twitter.com/chief_sunbow/status/1464335083419025410\n・淀水蝶花ちゃん\nhttps://twitter.com/chief_sunbow/status/1637558173694582784\n・玄冬鶍ちゃん\nhttps://twitter.com/chief_sunbow/status/1669740304898084864", "created_at": "", "completed_at": ""}, {"path": "/@8DAEK/works/40", "thumbnail_src": "https://si.imgix.net/557e95ab/uploads/origins/c2c79d5b-e2f1-447b-a59f-77163d8ae7fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=569a93734426db2d9bf8523b0b4c1d1b", "thumbnail_srcset": "https://si.imgix.net/557e95ab/uploads/origins/c2c79d5b-e2f1-447b-a59f-77163d8ae7fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=569a93734426db2d9bf8523b0b4c1d1b, https://si.imgix.net/557e95ab/uploads/origins/c2c79d5b-e2f1-447b-a59f-77163d8ae7fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bed496c4c60f7a250765a60c5c8d0f4e 2x, https://si.imgix.net/557e95ab/uploads/origins/c2c79d5b-e2f1-447b-a59f-77163d8ae7fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab9688b1cd50ae01eecfc729ee324495 3x", "genre": "art", "nsfw": false, "body": "初めまして！ \nとても綺麗なイラストに惹かれ依頼させて頂きます！ \n依頼内容としては私の推しである陽月るるふさんのファンアートを描いて頂きたいです！\n\n衣装は以下リンクの衣装でお願いします！\n\nhttps://x.com/rurufuhizuki/status/1645412895151501312?s=46&t=WoGgMdEvBKbscs6ctXyNiA\n\nポーズや構図はおまかせします。\n\n人物・背景等がレイヤー分け出来るPSDデータで頂けるとありがたいです。  \n\n陽月るるふさん本人が活動(配信サムネやSNS等への投稿)で使うことがあることをご了承ください。 \n\n陽月るるふさんは二次創作公認プログラムに登録されています。\n\n 検討下さい。 \n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@8DAEK/works/39", "thumbnail_src": "https://si.imgix.net/ec98e22f/uploads/origins/d3b15c06-792f-4dd3-bcb6-8d6b9742e134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b155605099d6f297305ad75381b373c2", "thumbnail_srcset": "https://si.imgix.net/ec98e22f/uploads/origins/d3b15c06-792f-4dd3-bcb6-8d6b9742e134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b155605099d6f297305ad75381b373c2, https://si.imgix.net/ec98e22f/uploads/origins/d3b15c06-792f-4dd3-bcb6-8d6b9742e134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0615846f7990048062547e5e01f4b4f4 2x, https://si.imgix.net/ec98e22f/uploads/origins/d3b15c06-792f-4dd3-bcb6-8d6b9742e134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe64c03a2e802f9ff90010c923b64280 3x", "genre": "art", "nsfw": false, "body": "初めまして\n鉢田エク様\n\nSkebに納品しましたイラストを拝見致しました。とても素敵なイラストだと感じた為、リクエストを送りたく思い、送らせていただきました。\n\n今回のリクエストキャラクターはOCの「ナナシちゃん」になります。\n\n範囲は金額に応じてお願い致します。\n\n構図は祈りのポーズを取っているようにお願い致します(目は開いているようにお願い致します)。\n\n翼と天使の輪っかが写るように描いていただけるとありがたいです。\n\n以上となります。\nこちらでご検討いただけますと幸いです。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1DTq6vH9XJxHAZWdt5xrMnrgKQ5DYJdoH", "created_at": "", "completed_at": ""}, {"path": "/@8DAEK/works/38", "thumbnail_src": "https://si.imgix.net/c78c75ef/uploads/origins/5ab61cfc-66bf-4726-b2f2-f7b2efc35ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=015e026366874ca8d71bcaf20a3f955a", "thumbnail_srcset": "https://si.imgix.net/c78c75ef/uploads/origins/5ab61cfc-66bf-4726-b2f2-f7b2efc35ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=015e026366874ca8d71bcaf20a3f955a, https://si.imgix.net/c78c75ef/uploads/origins/5ab61cfc-66bf-4726-b2f2-f7b2efc35ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=616734eb9106ca088254b9231232574d 2x, https://si.imgix.net/c78c75ef/uploads/origins/5ab61cfc-66bf-4726-b2f2-f7b2efc35ad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=b