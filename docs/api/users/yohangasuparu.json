%2Ccenter&txtsize=30&txt=PRIVATE&s=36871d77ecdd32e84bd09e6bb7a5cd16, https://si.imgix.net/e95dcb08/uploads/origins/78a15fa6-f9b4-406a-a204-4103c1b004e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77fb0e3fa24ae7981ad210d2a709dad6 2x, https://si.imgix.net/e95dcb08/uploads/origins/78a15fa6-f9b4-406a-a204-4103c1b004e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14dcd92446a6b8897ed3abacd990097b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yohangasuparu/works/43", "thumbnail_src": "https://si.imgix.net/dd62a3cb/uploads/origins/4895a08f-6430-4690-a311-31b24506e6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0e7722d3420e35381b17a1c3c2c11d5", "thumbnail_srcset": "https://si.imgix.net/dd62a3cb/uploads/origins/4895a08f-6430-4690-a311-31b24506e6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0e7722d3420e35381b17a1c3c2c11d5, https://si.imgix.net/dd62a3cb/uploads/origins/4895a08f-6430-4690-a311-31b24506e6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e0707a3dc21bf0637a84e2729518b4b 2x, https://si.imgix.net/dd62a3cb/uploads/origins/4895a08f-6430-4690-a311-31b24506e6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23abb2a2374c9304d995d8095be08605 3x", "genre": "art", "nsfw": true, "body": "こんばんは。初めて依頼します。\nこちらのこいしちゃんの絵がとても気に入っていて、こちらと同じ構図で東方のアリスちゃんを依頼したいです。\nhttps://www.pixiv.net/artworks/70706093\n表情も同じようにして、舌を出して唾液を垂らし、こちらを誘っている感じに。\n\n衣装はこちらのバニーガールアリスちゃんでお願いします。\nhttps://www.pixiv.net/artworks/44004654\nこの絵のように股の部分にスリットが入っていて、そこを指くぱぁしてアソコを見せつける。\n\nまた、こちらの金額で可能でしたら元のこいしちゃん絵のように足裏アップ差分をお願いしたいです。\n\n内容は以上となります。何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yohangasuparu/works/42", "thumbnail_src": "https://si.imgix.net/91f0e382/uploads/origins/55088296-24bf-43bc-bd98-09eaa676bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9d5af18b4238b9a2d7b6fdf5c50fd93", "thumbnail_srcset": "https://si.imgix.net/91f0e382/uploads/origins/55088296-24bf-43bc-bd98-09eaa676bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9d5af18b4238b9a2d7b6fdf5c50fd93, https://si.imgix.net/91f0e382/uploads/origins/55088296-24bf-43bc-bd98-09eaa676bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da61577441ffba1b8c4b178f1c443b20 2x, https://si.imgix.net/91f0e382/uploads/origins/55088296-24bf-43bc-bd98-09eaa676bae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4f33f344b51315bc7bd798e46b3bdbd 3x", "genre": "art", "nsfw": true, "body": "初めまして、pixivで拝見した天子の催眠イラストが素晴らしかったので依頼させていただきます。\n\n〇キャラクター\n東方の「比那名居天子」と「秦こころ」\n\n〇内容\n特殊性癖なのですがハイグレ洗脳(https://dic.pixiv.net/a/%E3%83%8F%E3%82%A4%E3%82%B0%E3%83%AC)というシチュエーションをお願いします。\n・衣装はハイレグ水着+長手袋+ニーソ(デザインや色等の細かい部分はお任せします)\n・肉体だけ操られてハイグレポーズをさせられている\n・顔を赤らめて羞恥心に苛まれている表情\n・差分で完堕ちして快楽に酔いしている表情\nもし可能であれば台詞を付けていただければ有難いです。\n\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yohangasuparu/works/41", "thumbnail_src": "https://si.imgix.net/1702f621/uploads/origins/a323a1c6-c8a7-42d6-b451-5b0da341a5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=456d2d964c14accc7318807d99a72417", "thumbnail_srcset": "https://si.imgix.net/1702f621/uploads/origins/a323a1c6-c8a7-42d6-b451-5b0da341a5ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=456d2d964c14accc7318807d99a72417, https://si.imgix.net/1702f621/uploads/origins/a323a1c6-c8a7-42d6-b