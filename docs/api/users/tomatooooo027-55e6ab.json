%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40db91dd63345d7d13ed49885f6e84ec, https://si.imgix.net/8703c38b/requests/216527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6419c66fe121fbc6145225e3ec1a0d72 2x, https://si.imgix.net/8703c38b/requests/216527_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9b5097ab97b72eb90f14cf54c475b66 3x", "genre": "art", "nsfw": false, "body": "はじめまして、この度当麻さんにリクエストできるとのことで思い切って送らせていただきます。\n\n版権創作どちらでも構わないとのことだったので、バンドリの瀬田薫を描いていただきたいです。衣装の指定が可能でしたら「1番、センター」のカードでお願いします。絵を描いていただけるだけで嬉しいので衣装の指定など不可能でしたらお好きなものを描いてほしいです。\nしばらく二次創作のアカウントが動くことがなかったので本当に見たいんです…\n当麻さんの描かれる彼女が公式の絵の次に好きです。あなたのアカウントを見つけたことをきっかけにまやかおを好きになったりしました、見つけた頃は自分の絵に自信がなかったのでバンドリ関係の絵を投稿することもなかったのですが今になって悔やんでいます。\nこの機会に頼むことができて嬉しいです、ぜひよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tomatooooo027/works/2", "thumbnail_src": "https://si.imgix.net/c142b953/requests/211574_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d99ccfcc45e94616d983fd57b79e8733", "thumbnail_srcset": "https://si.imgix.net/c142b953/requests/211574_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d99ccfcc45e94616d983fd57b79e8733, https://si.imgix.net/c142b953/requests/211574_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2136ea27ad58fa094d8fe8c58ea31629 2x, https://si.imgix.net/c142b953/requests/211574_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=399c8703fd9411f869e78f8b4c0efb9a 3x", "genre": "art", "nsfw": false, "body": "fgoの織田信長をお願いします。アーチャーかアヴェンジャーのどちらかで、かっこいい感じだと嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@tomatooooo027/works/1", "thumbnail_src": "https://si.imgix.net/9f5eac6b/requests/211545_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cd55b4fce26eccb7f53013bd2997ddc", "thumbnail_srcset": "https://si.imgix.net/9f5eac6b/requests/211545_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cd55b4fce26eccb7f53013bd2997ddc, https://si.imgix.net/9f5eac6b/requests/211545_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67d2a247d61ac99fa8cc31fff318a79c 2x, https://si.imgix.net/9f5eac6b/requests/211545_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13b28246c8001bd739658ef6c4446cd1 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラスト拝見させて頂き、ありがとうございます。\n早速のお願いで申し訳ないのですが、pcのデスクトップ背景画像をお願いしてもよろしいでしょうか？\nイラストの要望は2点あります。\n・サイズは1920×1080でお願いします。\n・左側にアイコンを設置するためのスペースをお願いします。\nそれ以外は当麻さんにお任せ致します。\nお好きなように描いて頂ければ幸いです。\n長々とした依頼内容で申し訳ありません。\n何卒宜しくお願いいたします。", "created_at": "", "completed_at": ""}]}