2-c732ed3e5241?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46186a345ab7ad6ed10549d124e50047", "thumbnail_srcset": "https://si.imgix.net/947766d2/uploads/origins/819305ee-6ff1-46ca-bc22-c732ed3e5241?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46186a345ab7ad6ed10549d124e50047, https://si.imgix.net/947766d2/uploads/origins/819305ee-6ff1-46ca-bc22-c732ed3e5241?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da2ffb70eac56a67abc22b7da6220b94 2x, https://si.imgix.net/947766d2/uploads/origins/819305ee-6ff1-46ca-bc22-c732ed3e5241?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82f5d5b75719a7d7b53f08a340d446d2 3x", "genre": "art", "nsfw": false, "body": "ななたる様、初めまして。\nもしよろしければ当方のTRPGの探索者と相方さんを描いて頂きたくリクエストの方を失礼致します。\nCOCシナリオ「AE」の探索者になります。\n(本文中にネタバレは含まれませんが、ドライブ資料には別フォルダに含まれます)\n\n①子供　アンネッタ\n11歳/149cm/男　(ほとんど女の子に見える)\n子どもらしからぬ冷静さと聡明さ、年相応の少年らしい無邪気さと奔放さを併せ持っている。\n第二次性徴をまったく迎えていない少年です。\n\n②大人　ジルド\n26歳/190cm/男　瘦せ型\n皮肉屋で悲観的で不器用\n頬のコケは削除して頂いて大丈夫＆三白眼もアンネと比べて黒目が小さい程度でも大丈夫です。\n\nななたる様の素敵なイラストを拝見して、是非二人のイラストをお願いできればと思いました！\n・2人で手を取り街で買い物を楽しんでいる様子（子どもが引っ張る形）\n・海の浅瀬or砂浜を2人で歩いている様子\n上記のいずれか、またはお好きな様に描いて頂ければと思います！\n\nもしよろしければご検討お願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1WwejYUh_ddFnONCbSvte7A4sK43VJwua", "created_at": "", "completed_at": ""}, {"path": "/@Taru7_10/works/42", "thumbnail_src": "https://si.imgix.net/679091f9/uploads/origins/e742a6d7-81c7-42e2-91c4-02aa98d3295b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9488da3b0755317b321677b059d39656", "thumbnail_srcset": "https://si.imgix.net/679091f9/uploads/origins/e742a6d7-81c7-42e2-91c4-02aa98d3295b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9488da3b0755317b321677b059d39656, https://si.imgix.net/679091f9/uploads/origins/e742a6d7-81c7-42e2-91c4-02aa98d3295b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d04dc48274cf2df215a66a026d82daf1 2x, https://si.imgix.net/679091f9/uploads/origins/e742a6d7-81c7-42e2-91c4-02aa98d3295b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=480f2896f92d3af8b2fd1fa42408e452 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nななたるさんのイラストがとても好きです！\nもし宜ければ、私のオリジナルキャラクターを描いて頂きたいと思いご依頼させて頂きました。\n\n【设定】\n·黒髪の男：\n名前はイマリー。身長210 cm（翼を含まない）、見た目年齢25～30歳前後。人間の魔法使い組織に破られ捕らえられ、契約を経て働いた堕天使の残片。傲慢で性格が悪く、囚人の自覚が全くなく、常に怒っている。状態が不安定で、時々暴走する、かなりの危険分子です。\n·青い髪の男：\n名前はフレデリッヒ。身長170 cm、見た目年齢17歳。人間魔法使い。イマリーの体と精神状態の維持を担当している。性格は温和で責任感が強く、強く純粋な信念と守護願望を持っている。\n·2人の関係：\nリアルマリーにとってフレデリッヒは鎮痛薬と麻酔薬のような存在である。二人は相性がいいから、フレデリッヒは彼の発狂状態を落ち着かせ、苦痛を一時停止させることができ、それに対してイマリーは非常に強い独占欲と排他性を生んだ。フレデリッヒにとって相手の世話は必要な仕事と責任にすぎず、この独り占めの欲望は結局実現しにくい。\nしかし長いパートナーシップを経て、イマリーの精神で穏やかになったと同時に、心の中ではパートナーとみなしているのかもしれないが、口だけでは認めない。\n二人はxx「友達以上だけど恋人ではない」の関係で、こんな感じで描いてください。\n\n【テーマとその他】\n··構図などその他の詳細については、ご自由にお決めください。\n※金額が足りなければ金額変更していただいて大丈夫です。\n\n資料は下記URLよりご確認ください：\n\nhttps://drive.google.com/drive/folders/12fr12u2-U7etmHeVPOmR3-iYlVwAd6CL", "created_at": "", "completed_at": ""}, {"path": "/@Taru7_10/works/41", "thumbnail_src": "https://si.imgix.net/f820148d/uploads/origins/53259b18-d49e-490c-a3f7-28e656f70cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61f6bbe8c41a2d88113aa3a6ebf8eb42", "thumbnail_srcset": "https://si.imgix.net/f820148d/uploads/origins/53259b18-d49e-490c-a3f7-28e656f70cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61f6bbe8c41a2d88113aa3a6ebf8eb42, https://si.imgix.net/f820148d/uploads/origins/53259b18-d49e-490c-a3f7-28e656f70cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c2793e56912e90152173bae937e8b61 2x, https://si.imgix.net/f820148d/uploads/origins/53259b18-d49e-490c-a3f7-28e656f70cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=342aeab4d42adbc1bb1cd47093e68308 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Taru7_10/works/40", "thumbnail_src": "https://si.imgix.net/e42f799b/uploads/origins/265649f8-1df6-4de4-9161-edc7871e05fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69df37a37a1fa7fd786d5d09861e16f", "thumbnail_srcset": "https://si.imgix.net/e42f799b/uploads/origins/265649f8-1df6-4de4-9161-edc7871e05fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69df37a37a1fa7fd786d5d09861e16f, https://si.imgix.net/e42f799b/uploads/origins/265649f8-1df6-4de4-9161-edc7871e05fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cae0fd198a9bf5b218e87b33013f8bd2 2x, https://si.imgix.net/e42f799b/uploads/origins/265649f8-1df6-4de4-9161-edc7871e05fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d88ed9d594a3b199b529207da2b44d1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！友人と私のOCのために別のアートをお願いしたいです。\n\n舞台は \"青い霧 \"から超自然的な生物が出現する世界。二人とも同じ民間警備会社に所属し、怪物を駆逐する。\n\nハマ（32歳、身長200cm）\n楽観的で優しく穏やかな性格で、情に厚く人を許しがちな医療のスペシャリスト。\nモチーフ：春、花、教会、墓地、懺悔。\n\nベル（34歳、身長175cm）\n物流担当官。穏やかで物静か、礼儀正しい性格。自分の欲望や欲求を隠しながら、指導を必要とする人々を助けようと常に努力している。\n右目が欠けている。\nモチーフ：静寂、内省、愛と手放すことを学ぶ。\n\nベルとハマは多くの共通点を持ちながら、愛し方を学ぶ静かな恋人同士。仕事で直面する危険の中、ふたりは互いの存在に慰めを見出す。ふたりは料理やガーデニングが好きで、一緒に新しいことをするのが好きだ。\n\nhttps://drive.google.com/drive/u/1/folders/1qMuSDVGm9e-WIJrW0KdU3jrFprZDfjKf", "created_at": "", "completed_at": ""}, {"path": "/@Taru7_10/works/39", "thumbnail_src": "https://si.imgix.net/35a3d658/uploads/origins/5f736a3a-9b77-4207-91f2-d5d991c98997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&