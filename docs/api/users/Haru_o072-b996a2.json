けたら嬉しいです。\nhttps://x.com/Haru_o072/status/1888888276301525232\nhttps://x.com/Haru_o072/status/1763918324327653822", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/16", "thumbnail_src": "https://si.imgix.net/54ea93e6/uploads/origins/fc1183bb-0435-43b7-942c-7e18d6cd998f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a976867df73dd5a1b922d78aff9efb0", "thumbnail_srcset": "https://si.imgix.net/54ea93e6/uploads/origins/fc1183bb-0435-43b7-942c-7e18d6cd998f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a976867df73dd5a1b922d78aff9efb0, https://si.imgix.net/54ea93e6/uploads/origins/fc1183bb-0435-43b7-942c-7e18d6cd998f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f9f19421291d5576470caea2d17e5a1 2x, https://si.imgix.net/54ea93e6/uploads/origins/fc1183bb-0435-43b7-942c-7e18d6cd998f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=353ffe308d26280cd4f4763dcb0294df 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/15", "thumbnail_src": "https://si.imgix.net/fcdfa444/uploads/origins/08952d77-02d1-4e7a-a608-3841fdf65327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=245c41beae31b020f42163f5f4706ae5", "thumbnail_srcset": "https://si.imgix.net/fcdfa444/uploads/origins/08952d77-02d1-4e7a-a608-3841fdf65327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=245c41beae31b020f42163f5f4706ae5, https://si.imgix.net/fcdfa444/uploads/origins/08952d77-02d1-4e7a-a608-3841fdf65327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f222aa403111247deac4c071c3d6fa7f 2x, https://si.imgix.net/fcdfa444/uploads/origins/08952d77-02d1-4e7a-a608-3841fdf65327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=063a6f1cb63f5b71e6092d435e29e36d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/14", "thumbnail_src": "https://si.imgix.net/f2f1275a/uploads/origins/2d972f28-c057-43a7-96ed-c753ee35043c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2298e7711df914492ef5998329439056", "thumbnail_srcset": "https://si.imgix.net/f2f1275a/uploads/origins/2d972f28-c057-43a7-96ed-c753ee35043c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2298e7711df914492ef5998329439056, https://si.imgix.net/f2f1275a/uploads/origins/2d972f28-c057-43a7-96ed-c753ee35043c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0335a62c2b04645f2d6b98b13cace729 2x, https://si.imgix.net/f2f1275a/uploads/origins/2d972f28-c057-43a7-96ed-c753ee35043c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=beb08ed46c88037ac39519c20901c028 3x", "genre": "art", "nsfw": true, "body": "失礼します、春千代さん！お久しぶりです！\nいつも素晴らしいイラスト、拝見させて頂いております！\nリクエストさせて頂きたく、まいりました！\n\nキャラ：資料URLのJK呪術師\n\nシチュ：\n敵側の一人称視点でJKちゃん追い詰められる。血まみれ(結構グロくてもokです！)になりながらも反転術式で治しており、涙目になりながら諦めずに隙を伺う\n\n「反転術式しぶとすぎんだろ…だが、雑魚だな」\n(ハァ…ハァ…諦めちゃダメ…何とか…隙を…)\n↓\n頭を潰されるギリギリで反撃し、逆転勝利。\n服はボロボロながらも傷をほぼ治しており、男側の一人称視点で男の死体を見下ろしている。\nコガネボイス「5点が追加されました」\n「ハァ…ハァ…私の…勝ちです…！」\n\nできれば複数ページでお願いしたいです！\n\n呪術全盛の猛者の一人たる烏鷺さんや、五条悟に並ぶ才能の原石たる日車さんでも中々できない、腕をすぐ生やすレベルの反転術式使いという才能ありまくりで、春千代さんの見事なまでのキャラデザに心を奪われました！\n\nどうか宜しくお願い致します！！🙇\n\nhttps://twitter.com/haru_o072/status/1627140946570919936?s=46&t=SBuCMKX2UUarcBiwKoJMcw", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/13", "thumbnail_src": "https://si.imgix.net/9290b66c/uploads/origins/68c431ff-0911-48d5-867e-df3ef387fa92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27fea2227ba665ed12ac0425caff1ac5", "thumbnail_srcset": "https://si.imgix.net/9290b66c/uploads/origins/68c431ff-0911-48d5-867e-df3ef387fa92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27fea2227ba665ed12ac0425caff1ac5, https://si.imgix.net/9290b66c/uploads/origins/68c431ff-0911-48d5-867e-df3ef387fa92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1b05fa2b1f5cf27e7f698b3b9d0e02e 2x, https://si.imgix.net/9290b66c/uploads/origins/68c431ff-0911-48d5-867e-df3ef387fa92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=785a19ca9403da9574c2b6aa94c67a07 3x", "genre": "art", "nsfw": true, "body": "以前描かれていた蛍ちゃんの絵がとても素敵だったので依頼させていただきます。二次創作絵が可能であれば原神よりニィロウちゃんのイラストをお願いします\n傷や出血描写は描いていただきたいですが欠損や内臓描写は無しでお願いしたいです\n是非よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/12", "thumbnail_src": "https://si.imgix.net/f54fc7fd/uploads/origins/843923cb-7275-4529-b948-f1cafbda665c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf8342763506ab9e1f42a52bb63588d6", "thumbnail_srcset": "https://si.imgix.net/f54fc7fd/uploads/origins/843923cb-7275-4529-b948-f1cafbda665c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf8342763506ab9e1f42a52bb63588d6, https://si.imgix.net/f54fc7fd/uploads/origins/843923cb-7275-4529-b948-f1cafbda665c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ee859ee748b57510c6f17ba6546631c 2x, https://si.imgix.net/f54fc7fd/uploads/origins/843923cb-7275-4529-b948-f1cafbda665c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d932421ac9c7713f5ec3807bfdb3a52f 3x", "genre": "art", "nsfw": true, "body": "こんにちは。二部構成のシーンを描いていただけないでしょうか。1コマ目は、重傷を負って地面に倒れている女子学生が、襲ってきた人に「助けてください」と懇願しています。2コマ目は、重たいもので頭を潰された女子生徒。2コマ目では頭は見えず、無残な姿と頭の周りに飛び散った血だけが見えます。ご自由に追加・変更してください。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/11", "thumbnail_src": "https://si.imgix.net/608a2171/uploads/origins/043ea2db-4490-41db-bf3b-9126125fd6c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=837a3e5feee7de2b9c17485ade5e94a5", "thumbnail_srcset": "https://si.imgix.net/608a2171/uploads/origins/043ea2db-4490-41db-bf3b-9126125fd6c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=837a3e5feee7de2b9c17485ade5e94a5, https://si.imgix.net/608a2171/uploads/origins/043ea2db-4490-41db-bf3b-9126125fd6c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2480fb8e8880453505a6454fb3f14be4 2x, https://si.imgix.net/608a2171/uploads/origins/043ea2db-4490-41db-bf3b-9126125fd6c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=286910c692bc0630b6a98dacd1b90109 3x", "genre": "art", "nsfw": true, "body": "こんにちは、早速リクエストさせていただきます。依頼内容をお読みいただき、もし不可と判断された場合は遠慮なくお断り下さい。\n\n猫耳のメスガキが心臓を貫かれて死んでいるイラストをお願いします。自作小説「掃除家」4話でウララが死ぬシーンなのですが構図などは全てお任せします。\n\n・大まかにこんなイメージです\n主人公の腹パンが炸裂。衝撃で腹部を中心に服が破れ、発育途中の胸の先端が見えてしまう。その後、嘔吐。そのまま倒れ、味方のシオンに助けを求めるが、何とそのシオンに心臓を貫かれて涙を流し血を吐きながら生き絶える。\n\n↓一応、設定を載せておきますがこの通りじゃなくても良いので描きやすいようにして下さい\n\n・ウララについて\nリリー女子学園の上級戦闘員『Kittys』。年齢は初等部の高学年、髪色はピンク、髪の長さはこれくらい(https://www.pixiv.net/artworks/91615363)\n制服はダブルブレストのブレザー、色はオフホワイト。中に着るブラウスは白。胸元のスクールリボンは緑。スカートは薄いグレーのグレンチェック。白のニーハイソックス。茶色のローファー。\n\nhttps://www.pixiv.net/novel/show.php?id=15224010", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/10", "thumbnail_src": "https://si.imgix.net/9acf5b56/uploads/origins/6a88aab7-d979-415c-bf9a-8711cf067b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=441c900d81df48fe6e0745e07b531f06", "thumbnail_srcset": "https://si.imgix.net/9acf5b56/uploads/origins/6a88aab7-d979-415c-bf9a-8711cf067b62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=441c900d81df48fe6e0745e07b531f06, https://si.imgix.net/9acf5b56/uploads/origins/6a88aab7-d979-415c-bf9a-8711cf067b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d22fba6bdfd162f539a2da4c6f6faf6 2x, https://si.imgix.net/9acf5b56/uploads/origins/6a88aab7-d979-415c-bf9a-8711cf067b62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff28a46c9b4329ee5e91beebc3602e46 3x", "genre": "art", "nsfw": true, "body": "捕まってしまった武装JKを描いていただけますか？彼女は地面に座り、壁にもたれかかり、両手を後ろで縛られています。彼女の口には銃が押し込まれています。彼女は恐怖で震えていて、泣いています。彼女は捕虜に \"殺さないで \"と伝えようとしている。彼女の隣には、もう一人の武装JKの死体が横たわっています。壁には血が飛び散っています。その他の詳細については、あなた次第です。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/9", "thumbnail_src": "https://si.imgix.net/50d1da69/uploads/origins/d6b2c916-5327-4b5c-b1ff-521a116ed757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3c5f077d6ae4064efae297fc0e3cd6b", "thumbnail_srcset": "https://si.imgix.net/50d1da69/uploads/origins/d6b2c916-5327-4b5c-b1ff-521a116ed757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3c5f077d6ae4064efae297fc0e3cd6b, https://si.imgix.net/50d1da69/uploads/origins/d6b2c916-5327-4b5c-b1ff-521a116ed757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9f17cae535c88744b465b257625d98c 2x, https://si.imgix.net/50d1da69/uploads/origins/d6b2c916-5327-4b5c-b1ff-521a116ed757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=470e493813ff7d964ba20a8dc8cae629 3x", "genre": "art", "nsfw": true, "body": "戦闘で重傷を負った武装JKを見てみたいものです。彼女は壁の後ろに座っている。出血多量で苦しそうに泣いています。その他の詳細については、あなた次第です。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/8", "thumbnail_src": "https://si.imgix.net/3e6bd7fd/uploads/origins/8dbdc1ce-b7d8-41c3-a41e-d2f17d310c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31bdbb88f944ad9fbf4f258a1c05d1dd", "thumbnail_srcset": "https://si.imgix.net/3e6bd7fd/uploads/origins/8dbdc1ce-b7d8-41c3-a41e-d2f17d310c22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31bdbb88f944ad9fbf4f258a1c05d1dd, https://si.imgix.net/3e6bd7fd/uploads/origins/8dbdc1ce-b7d8-41c3-a41e-d2f17d310c22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdb0a816c644a1339726585bac7a3a41 2x, https://si.imgix.net/3e6bd7fd/uploads/origins/8dbdc1ce-b7d8-41c3-a41e-d2f17d310c22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e65c592a4b202e0d70e07f25d6ab1e6 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\n以前描いていただいた絆創膏の女の子の続きで、もっと傷つき絆創膏だらけになっている姿をお願いします！\n\n女の子も絆創膏も以前と同じもので、前回と同じ場所に加え、首筋、鎖骨、首と肩の間のライン、鼠蹊部には是非貼っていただきたいです。\nそれ以外にも身体中いっぱい追加してほしいです。\n\nバランスとるために包帯を巻いていただいても構いませんが、包帯巻くような怪我を絆創膏で済ませちゃうような余裕のなさも好きなので、不自然でも構わないので貼れば貼るほど嬉しいです。\n\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Haru_o072/works/7", "thumbnail_src": "https://si.imgix.net/f20f9ab8/uploads/origins/ffc1fe3d-99c5-413f-b211-aba39ce08688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a3ee36c812b1d9a8936b63d742ba323", "thumbnail_srcset": "https://si.imgix.net/f20f9ab8/uploads/origins/ffc1fe3d-99c5-413f-b211-aba39ce08688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a3ee36c812b1d9a8936b63d742ba323, https://si.imgix.net/f20f9ab8/uploads/origins/ffc1fe3d-99c5-413f-b211-aba39ce08688?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0ae26b4d35751aae2befc8f3767989e 2x, https://si.imgix.net/f20f9ab8/uploads/origins/ffc1fe3d-99c5-413f-b211-aba39ce08688?bg=%23fff&aut