d7d-4230-b2c1-3136f8b21b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7829fa7656a8b693ded4085fed930113 2x, https://si.imgix.net/22f813b9/uploads/origins/67acf897-fd7d-4230-b2c1-3136f8b21b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6190cb1e8902f589be691e2c96a55c01 3x", "genre": "art", "nsfw": false, "body": "かふぇおれさんの過去作の「着ぐるみを飼おう。」 https://twitter.com/doggycoffee/status/806033244500045824?s=20 において描かれている様なplush fursuitを、海外絵師NaughtyCatNick/Draconicus_Nick氏の作品群の様に上下逆に着用している絵を所望します。\nポーズは犬の芸の「チ〇チ〇」で、手だけ顔文字の「¯\\_(ツ)_/¯」の様に上を向ける事で見た目fursuitが逆立ちしている様に見えるようにして下さい。また、fursuitの首にはリード付きの首輪がつけられていて、fursuitの脚(中の人の腕inside)に軽く巻き付いている様にして下さい。\nもし可能ならばで構いませんが、fursuitの尻尾だけ脱いで中の人の頭部が見えているマスクオフ(尻尾オフ？)差分を作っていただく事は可能でしょうか。その場合、中の人の頭部は https://twitter.com/doggycoffee/status/933360518156263425?s=20 の様に目・口が無く鼻だけの黒一色で処理して頂き、脱いだ尻尾は中の人の首周りにぶら下がっている様にして下さい。\n\nhttps://www.furaffinity.net/gallery/naughtycatnick/folder/382807/Upside-Down-Suiting-or-Dressing", "created_at": "", "completed_at": ""}, {"path": "/@doggycoffee/works/4", "thumbnail_src": "https://si.imgix.net/c014edb2/uploads/origins/ea556763-0b92-465b-b99e-d972d62ade97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7ab90bac1b8eca37bc08e9eeb4a09b3", "thumbnail_srcset": "https://si.imgix.net/c014edb2/uploads/origins/ea556763-0b92-465b-b99e-d972d62ade97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7ab90bac1b8eca37bc08e9eeb4a09b3, https://si.imgix.net/c014edb2/uploads/origins/ea556763-0b92-465b-b99e-d972d62ade97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31bf520855b977c4dc9228b692d51325 2x, https://si.imgix.net/c014edb2/uploads/origins/ea556763-0b92-465b-b99e-d972d62ade97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=710a70be7e0fa251a91e8fe4f4b73eb9 3x", "genre": "art", "nsfw": true, "body": "度々すみません\n以前描いて頂いたスク水姿の白熊獣人が、スク水姿のまま電車で痴漢されて感じてるような絵をお願いできないでしょうか\n（変なシチュエーションですみません…。", "created_at": "", "completed_at": ""}, {"path": "/@doggycoffee/works/3", "thumbnail_src": "https://si.imgix.net/dd89d6ae/uploads/origins/903e2c30-8bc8-4def-b433-6602ff722e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=887d3df4d4f053282090f341d8b03f37", "thumbnail_srcset": "https://si.imgix.net/dd89d6ae/uploads/origins/903e2c30-8bc8-4def-b433-6602ff722e13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=887d3df4d4f053282090f341d8b03f37, https://si.imgix.net/dd89d6ae/uploads/origins/903e2c30-8bc8-4def-b433-6602ff722e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b849973281dcc64cf69b782eb6855ad8 2x, https://si.imgix.net/dd89d6ae/uploads/origins/903e2c30-8bc8-4def-b433-6602ff722e13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3003c8a958db539165eae2f79e6d73f2 3x", "genre": "art", "nsfw": true, "body": "はじめまして、匿名で失礼いたします。\nドラゴン（西洋)とタヌキの混合種をお願いいたします。\n\n構図 : 足を大きく開いて（がに股）腹太鼓をしている。 \n\n体の特徴 : 目の周りから顔の輪郭までタヌキのような隈がある。\n胸や手足にあたりにフサフサした茶色い体毛。\n肥満体型でかなりお腹（蛇腹）が出でていて（弛んでいる、というより\"張\"がある感じ) かなり大きいデベソ（×印）がある。\n巨大な金玉。\n\nカラーは資料URL先の画像を参考にしていただけると幸いです。\n\n長々となってしまい申し訳ございません。\nよろしくお願いいたします。\n\nhttps://dl.dropboxusercontent.com/s/jmdr3xmz4b1674p/BodyColor.png", "created_at": "", "completed_at": ""}, {"path": "/@doggycoffee/works/2", "thumbnail_src": "https://si.imgix.net/9715b976/uploads/origins/75dc3c89-b288-454b-b769-63b58c7e9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c206bb2c6c839a9a113091276cbb30", "thumbnail_srcset": "https://si.imgix.net/9715b976/uploads/origins/75dc3c89-b288-454b-b769-63b58c7e9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c206bb2c6c839a9a113091276cbb30, https://si.imgix.net/9715b976/uploads/origins/75dc3c89-b288-454b-b769-63b58c7e9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb3d5e9077ecd090d2fc08e5a1f876df 2x, https://si.imgix.net/9715b976/uploads/origins/75dc3c89-b288-454b-b769-63b58c7e9dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=596c15a0d0e78457b6190858b6b55ef1 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n「シロクマ獣人がタヌキの着ぐるみを着させられて、金玉を蹴られる」という内容でお願いします。細部ですが、\n\n・着ぐるみの股間の部分から、シロクマ獣人の金玉が露出してる。(陰茎は隠れてる)\n・信楽焼きみたいなイメージ。元々大きめの金玉だが、蹴って、より大きく(腫れ)させる感じ\n\n上記の内容でお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@doggycoffee/works/1", "thumbnail_src": "https://si.imgix.net/87463758/uploads/origins/8b459941-fb9b-4b2e-80d4-6f06c35987c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49a154a994c0cf867870b5a15e9ba238", "thumbnail_srcset": "https://si.imgix.net/87463758/uploads/origins/8b459941-fb9b-4b2e-80d4-6f06c35987c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49a154a994c0cf867870b5a15e9ba238, https://si.imgix.net/87463758/uploads/origins/8b459941-fb9b-4b2e-80d4-6f06c35987c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baa7919ea26b890ab6056f901663e66f 2x, https://si.imgix.net/87463758/uploads/origins/8b459941-fb9b-4b2e-80d4-6f06c35987c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b4a7557484205e0663e876aac5f3e28 3x", "genre": "art", "nsfw": true, "body": "初めまして\nガチムチの白熊獣人がピチピチの女子用スク水を着て\nオナニーしてる絵をリクエストさせて頂きたいです\nお尻が強調されてるような構図だったら尚良いです！", "created_at": "", "completed_at": ""}]}