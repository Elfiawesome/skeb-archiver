e=30&txt=PRIVATE&s=5a02f2087f4d16be6dd8524091e63737 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@LelNeru/works/3", "thumbnail_src": "https://si.imgix.net/63b41485/uploads/origins/26af5d14-8337-4ba0-b98d-71328a147adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24c1a0db14583d6456d4f1ee629c88d9", "thumbnail_srcset": "https://si.imgix.net/63b41485/uploads/origins/26af5d14-8337-4ba0-b98d-71328a147adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24c1a0db14583d6456d4f1ee629c88d9, https://si.imgix.net/63b41485/uploads/origins/26af5d14-8337-4ba0-b98d-71328a147adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34b031db48e6a4f41203a76daa583cdc 2x, https://si.imgix.net/63b41485/uploads/origins/26af5d14-8337-4ba0-b98d-71328a147adf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48189a77a5b7f14668bcf1f9c7b6ff51 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます。是非OCを書いていただきたいです。\nSNSアイコンや鑑賞などに使う予定です。\n\nOC参考\nhttps://x.com/jirai_flamingo/status/1916622265069998097?s=46\nナイフの有無はお任せします。\n耳飾りは左耳です。\n\n構図や表情、背景は全てneru様にお任せします。\nお忙しいところ恐れ入りますが、ご検討の程宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@LelNeru/works/2", "thumbnail_src": "https://si.imgix.net/d6ba1ecb/uploads/origins/43556266-1766-49d1-86ab-78550db57678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec9a47d43893e185a633d11ae5b676dc", "thumbnail_srcset": "https://si.imgix.net/d6ba1ecb/uploads/origins/43556266-1766-49d1-86ab-78550db57678?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec9a47d43893e185a633d11ae5b676dc, https://si.imgix.net/d6ba1ecb/uploads/origins/43556266-1766-49d1-86ab-78550db57678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce91cc6c63f3fe5fda61bff9330f469d 2x, https://si.imgix.net/d6ba1ecb/uploads/origins/43556266-1766-49d1-86ab-78550db57678?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ff996b14e44e5fb10083f65be488c9a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nTLで拝見した際に素敵な絵を描かれる方だな〜と思っており、コミッションを開始されないかなと考えていたのですが、フォロー中のクリエイター欄を確認するとお名前がありましたのでリクエスト送らさせて頂きます。\n\nリクエストしたいキャラクターについては「原神」のリネくんをお願い出来ればと思います。\n\nポーズやシチュエーションについてですが、私はリネくんと照れたり恥ずかしがっている表情をもっと見たいので下記のようなイメージでお願いできればと思います。\n\n・本編のマジックでリネットがリネの格好をするトリックがありましたが、当然その逆のシチュも起こると考えました。\nリネットには猫耳が生えているので、格好を真似る場合はカチューシャ等で代用する必要があると思います。\n\nですので、鏡の前で頭に猫耳カチューシャを当てて照れているリネくんのイラストをお願い出来ればと思います。", "created_at": "", "completed_at": ""}, {"path": "/@LelNeru/works/1", "thumbnail_src": "https://si.imgix.net/6044a49f/uploads/origins/e31986cf-3eab-4ffe-b747-3e9567b6aeef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e048961c253b834e08566b8c3bcb743", "thumbnail_srcset": "https://si.imgix.net/6044a49f/uploads/origins/e31986cf-3eab-4ffe-b747-3e9567b6aeef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e048961c253b834e08566b8c3bcb743, https://si.imgix.net/6044a49f/uploads/origins/e31986cf-3eab-4ffe-b747-3e9567b6aeef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22101efc2d655c401bd63c4f7a711a9f 2x, https://si.imgix.net/6044a49f/uploads/origins/e31986cf-3eab-4ffe-b747-3e9567b6aeef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b45c59cd1c25fc7acbca35209d59ee5c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}