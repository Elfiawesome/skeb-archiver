2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb8f35503181e1b1a94292f6d0a8f5cf 2x, https://si.imgix.net/8242eff5/uploads/origins/3e6762d0-b9a8-4063-8439-a1d311e1af8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab91cf7ce4afc415ad22f7b394e241e4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@i_kitsugi/works/17", "thumbnail_src": "https://si.imgix.net/285518a5/uploads/origins/f25b9667-68f8-4e69-ac01-b7a1c1496e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0581f02654645379084b68034f70bdc1", "thumbnail_srcset": "https://si.imgix.net/285518a5/uploads/origins/f25b9667-68f8-4e69-ac01-b7a1c1496e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0581f02654645379084b68034f70bdc1, https://si.imgix.net/285518a5/uploads/origins/f25b9667-68f8-4e69-ac01-b7a1c1496e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28be1bae8f5dcb79245c182e07eb5802 2x, https://si.imgix.net/285518a5/uploads/origins/f25b9667-68f8-4e69-ac01-b7a1c1496e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3233f0f1ef0a58049e8fda17e2e3759 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nいつもきつぎさんのイラスト楽しみにしています！\ntmeさんのスイカや、hspのジェラピケ、３人のチェキ等とても刺さるものが多く、\n肉感や湿り気がある感じがとても良いなと感じて、とても好みです！\n\nもしよければtmeさんで、下記のシチュエーションでカラーイラストをお願いできないでしょうか。\nご検討をよろしくお願いいたします。\n\n\n◆人物：\nにじさ〇じ　白〇巴\n\n◆服装：\nドンキのコスプレ、マイクロミニ丈の透けセーラー服に紺のニーソックス、白Ｔバックにローターが複数。\n参考(https://skeb.jp/@Masuka_Atatame/works/95)\n\nきつぎさんが以前描かれていた、スイカ耐久や、長乳のtmeさんがとても良かったので、\nエロく乳を盛ってくださると嬉しいです。\n\n\n◆シチュエーション：\nチャラ男に弱みを握られ、辱められながら夜のラブホテル街を目的のホテルまで連れ歩かされているというシチュエーションです。\n\n◆構図：\n他の方が描かれたイラストで恐縮ですが(https://www.pixiv.net/artworks/84066275）のような感じです。\n\n右側は、ネオンの光る夜のラブホテル街を巴がチャラ男に連れられて辱められながら歩いている様子を正面から見た構図。\n\n巴は、悔しそうな表情で羞恥とローターの快感に耐えながら内股で歩いています。\n右手は、短すぎてショーツも隠せないスカートを引っ張って隠そうとしている。\n左手は、アナルをほじる男の手を止めさせようとして後ろに回しています。\n両手が塞がっているため、上が疎かになり短すぎるブラウスからは長乳が見えている。\n\n左側は参考と同じで、背面の視点。\n巴は男に逆手で後ろからショーツに手を入れられアナルをほじられていて、\n片手でやめさせようとしている感じでお願いします。\n\n\nもし可能でしたら、イってしまった差分があると嬉しいです。\n\n以上となります。", "created_at": "", "completed_at": ""}, {"path": "/@i_kitsugi/works/16", "thumbnail_src": "https://si.imgix.net/45223dba/uploads/origins/3f297076-0a11-4cef-896e-722a73175022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f7f22bef286dfa7ba0694117aebce02", "thumbnail_srcset": "https://si.imgix.net/45223dba/uploads/origins/3f297076-0a11-4cef-896e-722a73175022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f7f22bef286dfa7ba0694117aebce02, https://si.imgix.net/45223dba/uploads/origins/3f297076-0a11-4cef-896e-722a73175022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82ae60915c9959a742f8ca7d8ff3dc36 2x, https://si.imgix.net/45223dba/uploads/origins/3f297076-0a11-4cef-896e-722a73175022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e97c87ac9f2d0744f5856d8b3cda3b5 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n私のオリキャラでイラストお願いできますでしょうか。\n\n\n■キャラ\n私のオリキャラ、銀髪神官「ルーナ」\n衣装いくつかありますが、こちらでお願いします！（今回ヴェールはなしで大丈夫です）\nhttps://twitter.com/moryotton/status/1708826184891674656\n\n〇参考/skebで依頼してきたもの（同キャラですが別の衣装、参考になります）\nhttps://skeb.jp/@ligmki8/works/51\nhttps://skeb.jp/@yamaP_mako/works/220\nhttps://skeb.jp/@kurehi_mari/works/22\nhttps://skeb.jp/@haranonegaDoor/works/91\nhttps://skeb.jp/@hariganeshinsh1/works/158\n\n〇参考/セリフイメージ\nhttps://skeb.jp/@kujiran/works/136\nhttps://skeb.jp/@shyake_umama18/works/71\nhttps://skeb.jp/@sumari_r18/works/78\n\n\n■ シチュ\n・主観、乳首責めひょっとこフェラ\n（抜け陰毛が何本のまわりに付着している状態）\n\n・女性優位シチュ\n\n・竿役はショタ体型で童貞精液を頂いてしまう、という感じのイメージになります。\n\n\n簡素な依頼文ですが、詳細構図やそのほか記載のない部分はお任せいたします。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@i_kitsugi/works/15", "thumbnail_src": "https://si.imgix.net/a3d15a9a/uploads/origins/1ce651cd-7ffc-42f3-958c-203106f6302f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff27e6935735423e103f8a90a0970ef3", "thumbnail_srcset": "https://si.imgix.net/a3d15a9a/uploads/origins/1ce651cd-7ffc-42f3-958c-203106f6302f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff27e6935735423e103f8a90a0970ef3, https://si.imgix.net/a3d15a9a/uploads/origins/1ce651cd-7ffc-42f3-958c-203106f6302f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a98670c21663ee07de6e5bf980bf59d 2x, https://si.imgix.net/a3d15a9a/uploads/origins/1ce651cd-7ffc-42f3-958c-203106f6302f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1ad70d0e594787804ab40bb9b8742fe 3x", "genre": "art", "nsfw": true, "body": "初めまして。いつも作品を楽しみに拝見させて頂いております。\nきつぎさんの絵柄が非常に好みでしたのでリクエストさせて頂きます。\n普段とは違うジャンルのキャラクターとなってしまいますがご検討頂きたく。\n\n■キャラクター\n五等分の花嫁の中野五月をお願いします\n（参考：ttps://www.tbs.co.jp/anime/5hanayome/1st/chara/chara_itsuki.html）\n\n■服装\nシースルーのような透ける素材でできたスク水で、\n乳首と局部が丸出しになる穴が空いている服装でお願いします。\n穴のイメージは以前お描きになられていた静凛と樋口楓の服装が近いです。\n参考：https://skeb.jp/@i_kitsugi/works/7\nハイレグとまでは行きませんがV字はきつめでお願いします。\n腋毛と陰毛もありでお願いします。\n\n胸や太ももは大きめに盛って頂いて構いません。\n\n■表情\nハメることしか考えていないような表情\n口元は陰毛と精液で汚れている\n\n\n■シチュエーション\n騎乗位でおっさんのような竿役の上で思いっきり腰を振っている構図でお願いします。\nポーズは両腕を頭の後ろで組み脇を見せつけながら腰を振っているイメージです。\n\n■背景\n汗だくで臭いがこもり薄暗い部屋のようなイメージです。\n\n■その他\n作中では清楚なイメージですが可能な限り下品に描いていただいて構いません。\n金銭的に可能であれば腕と脚に網タイツを履いた差分を頂けますと嬉しいです。\n\n\n以上になります。ご検討のほど宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@i_kitsugi/works/14", "thumbnail_src": "https://si.imgix.net/ebe923c3/uploads/origins/0dcf9b47-26b4-4abb-b6f9-04f9aab9621d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fad164d16ad2dc8ba54a7a824b9857c2", "thumbnail_srcset": "https://si.imgix.net/ebe923c3/uploads/origins/0dcf9b47-26b4-4abb-b6f9-04f9aab9621d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fad164d16ad2dc8ba54a7a824b9857c2, https://si.imgix.net/ebe923c3/uploads/origins/0dcf9b47-26b4-4abb-b6f9-04f9aab9621d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d00eb230ac6b6708c95003444b7ba2cd 2x, https://si.imgix.net/ebe923c3/uploads/origins/0dcf9b47-26b4-4abb-b6f9-04f9aab9621d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25141b4ccec936aae161e29e3f848ef 3x", "genre": "art", "nsfw": true, "body": "こんにちは！前回は、素晴らしい作品をありがとうございました！よろしければ、以下のイラストのご依頼をお願い致します。\n\n・キャラ\nlz様\n・シチュ\nおねショタで、lz様がつま先立ちガニ股にて、バックより挿入されている。\n体型は、きつぎ様のお好きなようにムチムチでお描きください。\n衣装は、通常の配信衣装でお願いします。\nまた、金額内で可能であれば中出し差分もお願い致します。\n\n細かなご指定をしてしまい、申し訳ありませんが是非ご検討の程よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@i_kitsugi/works/13", "thumbnail_src": "https://si.imgix.net/e0d83de0/uploads/origins/f86468f5-b328-4264-a5f4-9891752d6ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed1f8587f187ffc7f9ed7ecfe0d582b", "thumbnail_srcset": "https://si.imgix.net/e0d83de0/uploads/origins/f86468f5-b328-4264-a5f4-9891752d6ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed1f8587f187ffc7f9ed7ecfe0d582b, https://si.imgix.net/e0d83de0/uploads/origins/f86468f5-b328-4264-a5f4-9891752d6ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e36b43d61d819176e709a6616b05fff 2x, https://si.imgix.net/e0d83de0/uploads/origins/f86468f5-b328-4264-a5f4-9891752d6ccb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e19a9997f4fec5eb84630608a9884bb 3x", "genre": "art", "nsfw": true, "body": "乱暴に犯される竜胆尊の無様エロ漫画お願いしたいです\n衣装はおまかせで陰毛や腋毛フサフサか剃り残し的な感じでジョリジョリ、胸爆乳でだらしない感じ乳首長めがいいです\nキツめのアヘ顔やオホ顔が好きです\n\nオナホ扱いされて乳首を思いっきりつねられたり髪の毛引っ張られたり卑猥な落書きをされてほしいです\nブサイクなアへ顔やレイプ目晒してほしいです\n\n鼻ザー、腹ボコ喉ボコ、ひょっとこフェラ、イラマや首絞め、スパンキング、体に落書き、殴打、などハードな描写が大好きです\nNGないので自由に描いて頂けると嬉しいです\n\n無様なのが大好きなので鬼畜でハードな表現大歓迎です\n\n金額的に大丈夫であれば漫画的な感じで何ページか頂きたいですよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@i_kitsugi/works/12", "thumbnail_src": "https://si.imgix.net/0588a692/uploads/origins/2d4c244c-379b-4a5d-8f78-d3f9bbf99faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bc1565e6875d69752df058648477ff8", "thumbnail_srcset": "https://si.imgix.net/0588a692/uploads/origins/2d4c244c-379b-4a5d-8f78-d3f9bbf99faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bc1565e6875d69752df058648477ff8, https://si.imgix.net/0588a692/uploads/origins/2d4c244c-379b-4a5d-8f78-d3f9bbf99faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09d6addd340258c8d1a3a4b319ad3d7e 2x, https://si.imgix.net/0588a692/uploads/origins/2d4c244c-379b-4a5d-8f78-d3f9bbf99faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3976544b0195c3be75abae23b3e8c7db 3x", "genre": "art", "nsfw": true, "body": "こんにちわ！いつも素晴らしいイラストを拝見させていただいております。\nいつもお描きになられているジャンルと違ってしまうのですが、是非きつぎ様に以下のリクエストをご依頼させていただきたく、ご検討の程よろしくお願い致します。\n\n●キャラ\nガルパンのマリー\n・https://x.gd/BIYVM\n・https://x.gd/HXs3V\n・https://x.gd/F97Cr\n●服装参考画像\n・https://x.gd/91RQW\n\n●構図\n・エロ蹲踞にて、口の前で指わっかをつくりこちらを挑発しているイメージ\n　先生のお描きになるふとももが素晴らしく、ムチムチでお描きいただければ幸いです\n・表情は、犯されることを期待した発情、挑発するような表情\n・服装は、上は着崩さず下はスカートがめくれ、パンツから陰毛（髪色と同系色）がはみ出している\n・金額内で可能であれば、口の周りに陰毛、精液が付着している差分をお願い致します\n\n細かなご指定をしてしまい申し訳ありませんが、是非ご検討の程よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@i_kitsugi/works/11", "thumbnail_src": "https://si.imgix.net/81771b0e/uploads/origins/97d875b7-c706-44f0-94f5-4dbb06e2ddbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1b0fdcb5ab816ac75c9bbf59c67952", "thumbnail_srcset": "https://si.imgix.net/81771b0e/uploads/origins/97d875b7-c706-44f0-94f5-4dbb06e2ddbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1b0fdcb5ab816ac75c9bbf59c67952, https://si.imgix.net/81771b0e/uploads/origins/97d875b7-c706-44f0-94f5-4dbb06e2dd