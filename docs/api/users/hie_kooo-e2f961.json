f-4a33-bac2-b2bd60340f95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e6f136c4603a963df8da1419e5cd1a2, https://si.imgix.net/329f074f/uploads/origins/e1755313-413f-4a33-bac2-b2bd60340f95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa037e5ad4126ac182b59b5555483fca 2x, https://si.imgix.net/329f074f/uploads/origins/e1755313-413f-4a33-bac2-b2bd60340f95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4828a1914f76e9cc6965a4e953cc25ea 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートスタイルはとても素敵です。二人のキャラクターを一緒に描いたアートをお願いしたいです。彼らはカップルです。\n\n▶キャラクターについて\n-キャラクターA(183cm)。\n暴力的な一面を持つ若きイケメン刑事。外見は温厚な紳士だが、様々な組織から逃亡したスパイの追跡を仕事としている。手錠の他に縛り紐も使う。肩幅が広い。\n\n-キャラクターB(170cm)。\nやんちゃで生意気な悪魔で、暴力やトラブルが好き。色白の肌と赤い角、尻尾が特徴。なお、黒い髪と瞳は光を反射しないので、ハイライトは入れないようにしましょう。\n\n▶人間関係の詳細\nキャラクターBはAを非常にうっとうしく思っており、いつも彼を煽ろうとしている。お互いに愛憎半ばする関係だが、相手のことをとても魅力的に感じている。\n\nポーズや構図はお任せします。ありがとうございました。\n\nhttps://sta.sh/21exe7umloxn", "created_at": "", "completed_at": ""}, {"path": "/@hie_kooo/works/58", "thumbnail_src": "https://si.imgix.net/e915269a/uploads/origins/40498181-2e3c-4192-bd62-ada3d6ae7322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4ec90e6e4b8af8576e11d562cc6b58", "thumbnail_srcset": "https://si.imgix.net/e915269a/uploads/origins/40498181-2e3c-4192-bd62-ada3d6ae7322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4ec90e6e4b8af8576e11d562cc6b58, https://si.imgix.net/e915269a/uploads/origins/40498181-2e3c-4192-bd62-ada3d6ae7322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d4a0a9fd7a439b3414f2c73a6c63347 2x, https://si.imgix.net/e915269a/uploads/origins/40498181-2e3c-4192-bd62-ada3d6ae7322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe93fe7ab1e00acddb373378147c264d 3x", "genre": "art", "nsfw": false, "body": "Hi! I really love the art you made for me so I would love to ask for another