7e-8321-b34d6604aecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65ec081208a114f371c9cf4680124eee 2x, https://si.imgix.net/daa710bf/uploads/origins/51a29f93-8b3f-417e-8321-b34d6604aecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e6a89f383f6656b0021d7726af7b3da 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/25", "thumbnail_src": "https://si.imgix.net/23e7aa02/uploads/origins/a7ba18ba-fb21-4308-996f-45943d689d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962bfc9703e83755d3ed5a8665a12dfe", "thumbnail_srcset": "https://si.imgix.net/23e7aa02/uploads/origins/a7ba18ba-fb21-4308-996f-45943d689d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=962bfc9703e83755d3ed5a8665a12dfe, https://si.imgix.net/23e7aa02/uploads/origins/a7ba18ba-fb21-4308-996f-45943d689d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd2dca39f7205883f7936a973f575c6e 2x, https://si.imgix.net/23e7aa02/uploads/origins/a7ba18ba-fb21-4308-996f-45943d689d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=497aa5a98b6f871942a8b5a3c98e2382 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ファイアーエムブレムヒーローズのエイトリを描いていただけませんか？\nhttps://imgur.com/a/fuNnnrv\n\n参考までに、彼女が3Dで動き回っている動画をどうぞ。\nhttps://youtu.be/f48FOLHcILY?si=LOYHX902MZKZuMTs\n\n彼女が持っている銃を使って、かっこいいアクションポーズを描いてください。また、何か良いアイデアがあれば、違うアイデアを選ぶのも自由です。\n\nポーズも何もかもあなた次第です。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/24", "thumbnail_src": "https://si.imgix.net/c712ac36/uploads/origins/a48f14e2-d2a5-4378-b0db-b40a7dc5c491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb7a33a82e8536fee0cec7763b5d8771", "thumbnail_srcset": "https://si.imgix.net/c712ac36/uploads/origins/a48f14e2-d2a5-4378-b0db-b40a7dc5c491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb7a33a82e8536fee0cec7763b5d8771, https://si.imgix.net/c712ac36/uploads/origins/a48f14e2-d2a5-4378-b0db-b40a7dc5c491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f33d5cfd18b129f86764b7b5d5c6d88a 2x, https://si.imgix.net/c712ac36/uploads/origins/a48f14e2-d2a5-4378-b0db-b40a7dc5c491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=201dff950bbc8f5f22a26c3bd9c5c22c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/23", "thumbnail_src": "https://si.imgix.net/6002ee1c/uploads/origins/40983124-e67e-420a-9eb3-b072a5f03121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eed0c194f9f07ba65dcf4fa3505ab85", "thumbnail_srcset": "https://si.imgix.net/6002ee1c/uploads/origins/40983124-e67e-420a-9eb3-b072a5f03121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eed0c194f9f07ba65dcf4fa3505ab85, https://si.imgix.net/6002ee1c/uploads/origins/40983124-e67e-420a-9eb3-b072a5f03121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=075580b2482cb30016620b28d849e829 2x, https://si.imgix.net/6002ee1c/uploads/origins/40983124-e67e-420a-9eb3-b072a5f03121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec1ecfd1e9471dcf611ab6c4d88e3065 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nイラスト・漫画はもちろんですが、もやしさんのセンスがとても魅力的で大好きです！\nリクエストお願いします。\n\nバトル・ロワイアル(原作小説版)の\n三村信史と松井知里をお願いしたいです。\n\nふたりとも中3、同じクラスです。\n学ランとセーラーで、日常風景(登下校中や休み時間でも、授業でも)で二人でいる所が見てみたいです！\nその他、ポーズや表情などは全ておまかせします。\n\n(キャラクターの特徴)\n小説のキャラクターのため、資料が文章しかなく申し訳ありません。\n\n①三村信史はバスケ部天才ガード、知識の幅が広くハッキングが得意で切れ者、\n飄々としていてモテるけれどプレイボーイなのが玉に瑕です。\n外見の特徴は、短髪、スタイリングウォーターで持ち上げた前髪、シュッと真っ直ぐな眉、切れ長でユーモアのある瞳(小説から抜粋)、左耳に形見のリングピアスをしています。\n\n②松井知里は、クラスの女子からプレイボーイのためあまりウケの良くない三村にクラスで唯一密かに片想いしています。\n小柄で髪が長く、声が細くて控えめな性格です。\n\n映画化・マンガ化はされていますが、そちらではなく、原作小説版の情報から想像したもやしさんの描くふたりが是非見てみたいです！\nお忙しいところ、とてもマニアックなお願いで申し訳ありませんが、リクエスト受けていただけたらとても嬉しいです。\nよろしくお願い致します。\n\n今描かれている漫画の発売も楽しみにしております！", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/22", "thumbnail_src": "https://si.imgix.net/3294fb45/uploads/origins/c815d909-0f0c-4378-9584-bd60e31b2b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7661e81db12ee96f30157f46450ca7ee", "thumbnail_srcset": "https://si.imgix.net/3294fb45/uploads/origins/c815d909-0f0c-4378-9584-bd60e31b2b32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7661e81db12ee96f30157f46450ca7ee, https://si.imgix.net/3294fb45/uploads/origins/c815d909-0f0c-4378-9584-bd60e31b2b32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76cec691bbc2d0a6db027779c1e4d524 2x, https://si.imgix.net/3294fb45/uploads/origins/c815d909-0f0c-4378-9584-bd60e31b2b32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4d102ea7590fbef26b447ce24f41901 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nファイヤーエンブレム風花雪月のイングリット=ブランドル=ガラテアを描いていただけないかと思い、リクエストさせてもらいました。\n服装は制服姿で、ルーンを持たせてもらい、戦闘中のようなカッコイイ感じにしていただきたいです。　\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/21", "thumbnail_src": "https://si.imgix.net/55f5da05/uploads/origins/e5f01b48-81f2-4462-af0f-6f60710187f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2c492e682d79184cb6d00a1578762e5", "thumbnail_srcset": "https://si.imgix.net/55f5da05/uploads/origins/e5f01b48-81f2-4462-af0f-6f60710187f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2c492e682d79184cb6d00a1578762e5, https://si.imgix.net/55f5da05/uploads/origins/e5f01b48-81f2-4462-af0f-6f60710187f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85806bf662ca7a0df3e66438a6c2b1b1 2x, https://si.imgix.net/55f5da05/uploads/origins/e5f01b48-81f2-4462-af0f-6f60710187f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd036b5959112f2990a4973547a6561e 3x", "genre": "art", "nsfw": false, "body": "はじめまして、突然のリクエスト失礼します。\nファイアーエムブレム新紋章の謎・ヒーローズのエレミヤ様（http://imgur.com/LmiVv0W.png）を描いて欲しいです。\nエレミヤ様は優しそうな笑顔を浮かべながらとても辛辣な言葉を発する過激なシスターです。\n原作では暗闇の中からメティオという炎の魔法で攻撃してくる敵キャラでした。\nなので、薄暗い部屋の中で右手に炎を纏わせ、不敵に笑うエレミヤ様を描いて欲しいです。\n細かい構図などはお任せします。\nとても大雑把なリクエストになってしまいましたが、何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/20", "thumbnail_src": "https://si.imgix.net/b66ea3b2/uploads/origins/cd711c2a-9024-4446-8e05-483ab4cedf25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bafd9c469dc17ab7de4f1dc1232a8a60", "thumbnail_srcset": "https://si.imgix.net/b66ea3b2/uploads/origins/cd711c2a-9024-4446-8e05-483ab4cedf25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bafd9c469dc17ab7de4f1dc1232a8a60, https://si.imgix.net/b66ea3b2/uploads/origins/cd711c2a-9024-4446-8e05-483ab4cedf25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de3a596bea7347b6e7229cd54d06cb30 2x, https://si.imgix.net/b66ea3b2/uploads/origins/cd711c2a-9024-4446-8e05-483ab4cedf25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=370a4a633e60f19cc39fa27a76d1119c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\nファイアーエムブレムのファンアートをリクエストしたいです。ファイアーエムブレム 風花雪月』のフェリックス（5年後バージョン）と『ファイアーエムブレム エンゲージ』のカゲツをリクエストしたいです。\n\nフェリックスの参考文献：https://imgur.com/a/GKrOz8W\n\n花月の参考文献：https://imgur.com/a/548316R\n\nポーズは、二人とも剣の腕を磨きたい剣士なので、スパーリングをしているようなイメージでお願いしたいです。構図は、香月さんがとても上手なので、細かいところはお任せしたいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/19", "thumbnail_src": "https://si.imgix.net/a2f69fbe/uploads/origins/912fea4e-0632-4051-a1cd-a1862c0c2496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b25521e6a5cabc99304298556bb000", "thumbnail_srcset": "https://si.imgix.net/a2f69fbe/uploads/origins/912fea4e-0632-4051-a1cd-a1862c0c2496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b25521e6a5cabc99304298556bb000, https://si.imgix.net/a2f69fbe/uploads/origins/912fea4e-0632-4051-a1cd-a1862c0c2496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6da1a83ccb2b32e864132ed62063e781 2x, https://si.imgix.net/a2f69fbe/uploads/origins/912fea4e-0632-4051-a1cd-a1862c0c2496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7317a889d3903c736aa7a608b30ac8b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ファイアーエムブレムヒーローズのクヴァジールを描いていただけませんか？\nhttps://imgur.com/a/t3vpIIb\n\n魔法を使っているアクションポーズと、使っている武器・トームを描いてください。また、夜の野原で流れ星を見ながらくつろいでいる姿や、柔らかな微笑みを浮かべている姿でも構いません。お好きな方をどうぞ。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/18", "thumbnail_src": "https://si.imgix.net/fec17b14/uploads/origins/6ab83ea4-7d10-437c-8b28-d3c77dd5db7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8814c2caa8b5b4bc46bc3e68b058ac24", "thumbnail_srcset": "https://si.imgix.net/fec17b14/uploads/origins/6ab83ea4-7d10-437c-8b28-d3c77dd5db7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8814c2caa8b5b4bc46bc3e68b058ac24, https://si.imgix.net/fec17b14/uploads/origins/6ab83ea4-7d10-437c-8b28-d3c77dd5db7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8150956f15ed8a87b6d82b8ad43c97ec 2x, https://si.imgix.net/fec17b14/uploads/origins/6ab83ea4-7d10-437c-8b28-d3c77dd5db7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec3e88161187f264d5b3c6f4cce47727 3x", "genre": "art", "nsfw": false, "body": "もやし様\nリクエスト失礼いたします\n\nリクエスト内容ですが、\n①キャラ：ファイアーエムブレム・蒼炎の軌跡・暁の女神に登場する、「レテ」のイラスト\n（レテの参考資料です→https://imgur.com/gallery/bmtwWmD）\n\n②キックで戦っているアクションシーン\n（敵兵等はえがいていただかなくて問題ございません）\n（具体的なポーズや、原作ゲームの挙動に合わせていただく必要もございませんので、イラストの構図やキャラクターのポーズ・表情等々、すべてもやし様におまかせしたいです）\n\n\n\n\nこのキャラクターは基本的に化身状態や爪で戦うのですが、原作の暁の女神においてのみ非化身（人型）状態で蹴りで反撃ができるという特徴があり、\nそのアクション・戦闘シーンを、\n過去リクエスト等（https://skeb.jp/@moyashi_mou2/works/12）で、\n超々素敵な光景で表現されるもやし様に、是非えがいていただけたらと思い、リクエストを送らせていただきました。\nリクエストをお受け頂けましたらとても嬉しいです\nどうかよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/17", "thumbnail_src": "https://si.imgix.net/e9135456/uploads/origins/ecfd7569-c2c9-44a2-86e0-f3afcbf88c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=632ae873e63df0535a7c640d903cdbe8", "thumbnail_srcset": "https://si.imgix.net/e9135456/uploads/origins/ecfd7569-c2c9-44a2-86e0-f3afcbf88c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=632ae873e63df0535a7c640d903cdbe8, https://si.imgix.net/e9135456/uploads/origins/ecfd7569-c2c9-44a2-86e0-f3afcbf88c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4daafb4798596622a4e8b9eb5888a18 2x, https://si.imgix.net/e9135456/uploads/origins/ecfd7569-c2c9-44a2-86e0-f3afcbf88c7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20ee870ba82eb9afbcf2ae41fcd1352f 3x", "genre": "art", "nsfw": false, "body": "もやし様、はじめまして。\nいつもTwitterで素敵なイラストを拝見しております。\nもやし様の柔らかな色遣いや臨場感のある構図、キャラクター同士の掛け合いが聞こえてきそうなファンアートの数々が大好きで、是非拙宅のOCを描いていただきたいと思いリクエストを送らせていただきました。\n\nこちら（https://twitter.com/moyashi_mou2/status/1188395152005459969?s=46&t=xDAD19ZFw_81KTDzz1f7gg）の各学級のイラストが特に大好きで、可能でしたらこのようなスタイルでOCを描いていただきたいです。\nOCは極度の恋愛脳で 強さにときめく性格なので、負けた相手に見惚れてうっとりとしている様子をイメージして描いてください。武器を持たせる場合は槍でお願いします。\n背景は無しで大丈夫です。ポーズに具体的な指定はありません。楽しんで制作してもらうことが1番だと思っていますので、そうしていただけたら嬉しいです。\nOCの資料は以下のドライブにあります。\nhttps://drive.google.com/drive/folders/1-pGeL4FpjsN7NmiwK7SWxwEC9DcnYpvW\n\nフェルディナントとのペアエンドを創作する目的で作ったキャラクターなので、そういったものに抵抗がありましたら申し訳ありません。\nもし不快に思われたり難しい内容でしたら気兼ねなくキャンセルしてください。\n\n料金が不足する場合は恐れ入りますが再送要請をしていただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-pGeL4FpjsN7NmiwK7SWxwEC9DcnYpvW", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/16", "thumbnail_src": "https://si.imgix.net/035ac3ea/uploads/origins/2c36a61a-2d56-4c4a-be7d-d80cf51eecc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6528bb03ca4ab141252a8b46b34ebdc7", "thumbnail_srcset": "https://si.imgix.net/035ac3ea/uploads/origins/2c36a61a-2d56-4c4a-be7d-d80cf51eecc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6528bb03ca4ab141252a8b46b34ebdc7, https://si.imgix.net/035ac3ea/uploads/origins/2c36a61a-2d56-4c4a-be7d-d80cf51eecc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d4b9f6f8b849de1dd60a63a469d4f0f 2x, https://si.imgix.net/035ac3ea/uploads/origins/2c36a61a-2d56-4c4a-be7d-d80cf51eecc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c931ac68c93ee9d55497b6d748834ff 3x", "genre": "art", "nsfw": false, "body": "こんにちは、フーターズの衣装を着たファイアーエムブレムのルキナをお願いします。\n\nポーズや表情はおまかせします。シャツのフーターズロゴは、気になるようでしたら省略・修正可能です。この衣装は、あなたの好みやスタイルに合わせて、少しずつ変更することができます。オプションで、ルキナはビールが入ったジョッキのトレイやチキンウィング（フーターズレストランの人気メニュー）の皿を持つことができます。\n\n一応、過去の例も含めて参考までにご紹介しますと、https://imgur.com/a/bSvS2Wh。\n\nhttps://imgur.com/a/bSvS2Wh", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/15", "thumbnail_src": "https://si.imgix.net/6c5a3143/uploads/origins/15646759-92ac-4160-adb5-0f9bc9f3851d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0015289c00685b233d15863c204d7f86", "thumbnail_srcset": "https://si.imgix.net/6c5a3143/uploads/origins/15646759-92ac-4160-adb5-0f9bc9f3851d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0015289c00685b233d15863c204d7f86, https://si.imgix.net/6c5a3143/uploads/origins/15646759-92ac-4160-adb5-0f9bc9f3851d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a4f2d9e09600c979431275d593af303 2x, https://si.imgix.net/6c5a3143/uploads/origins/15646759-92ac-4160-adb5-0f9bc9f3851d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c802ec1e3d0f2aadb1300d807815a60b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風はとても豪華なので、イラストをお願いします！\nファイアーエムブレム覚醒のルキナと男性ロビンが寄り添っているものです。\nルキナ姫のベッドで一緒にいて、二人とも戦闘後、服を脱いで下着姿になるのが希望です。ロビンは眠っていて、ルキナはこの写真（https://i.imgur.com/cmJDnnP.png）のように、ロビンを自分の体に抱きしめている状態にしてほしいです。\n衣装は写真のような感じでお願いしたいのですが、自由に変更していただいて結構です。\n私の要望を聞いてくれてありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/14", "thumbnail_src": "https://si.imgix.net/b718c1c6/uploads/origins/581d9abb-ea94-4e6a-916d-4e03de084931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=367e0141d03b122c8a2c4a083cdd85cd", "thumbnail_srcset": "https://si.imgix.net/b718c1c6/uploads/origins/581d9abb-ea94-4e6a-916d-4e03de084931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=367e0141d03b122c8a2c4a083cdd85cd, https://si.imgix.net/b718c1c6/uploads/origins/581d9abb-ea94-4e6a-916d-4e03de084931?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e997acc9c9079da06919dcf5915b298 2x, https://si.imgix.net/b718c1c6/uploads/origins/581d9abb-ea94-4e6a-916d-4e03de084931?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=721a75b6096c0c7be4e0baba3c375380 3x", "genre": "art", "nsfw": false, "body": "Hello! I loved the art series you did several years ago of the Fire Emblem 風花雪月students reacting to them losing a battle while training! I would like artwork similar to that of my FE風花雪月 original character, Hillevi!\n\nInformation: Hillevi is a 黒鷲の学級 student. She has a huge ego and does not react to loss well. She uses an axe like Edelgard. I like to imagine her wiping dust off of her face as she tries to get up and fight again, but you are welcome to interpret the idea however you like as long as it looks like she's not ready to accept that she lost!\n\nhttps://drive.google.com/drive/folders/1Sbjd9-hUJ4pNbEtE0SkL0j9l0XIPq5e4?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/13", "thumbnail_src": "https://si.imgix.net/76aa7172/uploads/origins/1a176215-73ec-4b2b-8dbf-727822786007?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd11afa02b1aa7200465b9e77f53e718", "thumbnail_srcset": "https://si.imgix.net/76aa7172/uploads/origins/1a176215-73ec-4b2b-8dbf-727822786007?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd11afa02b1aa7200465b9e77f53e718, https://si.imgix.net/76aa7172/uploads/origins/1a176215-73ec-4b2b-8dbf-727822786007?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2f5381b7780ca1d7be77df9e5a7415a 2x, https://si.imgix.net/76aa7172/uploads/origins/1a176215-73ec-4b2b-8dbf-727822786007?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9989cc41e4aa752490786ab981c719d2 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n日頃より、様々なファイアーエムブレムのイラストを楽しませていただいております。\nよろしければリクエストさせていただけたらと思います。\n\nキャラクターはファイアーエムブレムのンンです。\nンンが朝の身支度中、髪を結っている途中の姿を描いていただけないでしょうか。\n\n具体的なイメージとしては、\nンンは片方の三つ編みを既に結い終わり、もう片方に取りかかろうとしている。\nリボンは口に咥えている。\n衣装はいつものワンピース。手袋やブーツ、鞄やマントはまだ身に着けていない。おそらく近くに綺麗に畳んである。\n竜石を手鏡の代わりに置いて利用している。\n朝の陽の光が差し込んでいる。\n\nこのようなイメージです。\n片方の三つ編みでンンだとわかりつつも、もう片方の解けた長髪で普段と違った印象のンンが見れたら嬉しいです。\n\nもやしさんの側でアイディアがあれば、この通りでなくとも構いません。\n無理がありそうな部分や、もっとこうした方が良くなりそうな部分、他アレンジ等も含めて自由に描いていただけたらと思います。\n\n何か問題などありましたら申し訳ありません。\nご検討いただけましたら幸いです。\n\nhttps://imgur.com/a/MsveEsM", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/12", "thumbnail_src": "https://si.imgix.net/a07e59bb/uploads/origins/f5027707-5dc6-489c-80f0-76e8ba205e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1265364a7f2d6f764d96131bc45b8a", "thumbnail_srcset": "https://si.imgix.net/a07e59bb/uploads/origins/f5027707-5dc6-489c-80f0-76e8ba205e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1265364a7f2d6f764d96131bc45b8a, https://si.imgix.net/a07e59bb/uploads/origins/f5027707-5dc6-489c-80f0-76e8ba205e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a54af74bdd976ee3728959de692fd7ef 2x, https://si.imgix.net/a07e59bb/uploads/origins/f5027707-5dc6-489c-80f0-76e8ba205e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2f44e9dfd3a69f73dc560df424d2f5a 3x", "genre": "art", "nsfw": false, "body": "もやし様\nリクエスト失礼いたします\n先日は素敵なレテのイラストをありがとうございました！\n素晴らしい光景で最高でした！！\n今回もぜひリクエストを受けていただければ幸いです\n\n\nリクエスト内容ですが、\n①キャラ：ファイアーエムブレム・蒼炎の軌跡・暁の女神に登場する、「レテ」と「アイク」の２人のイラストを描いていただけたらと思っています！\nアイクの参考資料です→https://imgur.com/gallery/T0xJi7J\nレテの参考資料です→https://imgur.com/gallery/bmtwWmD\n2人の身長差はほとんどなく、レテの顔半分ほどアイクのほうが大きい程度です。なので身長差についてはあまり気にしないでください\n\n②シュチュエーション：二人が鍛錬している様子をお願いします！\n（場所は野外でも、風花雪月のガルグ＝マクの訓練場のような室内風の場所でも、どういった場所でもかまいません！））\n（デティールはもやし様にお任せできればと思っています。片方の顔が見えないような構図でも、どのような形でもかまいません！）\n（もやしさまの想像された形で、描いていただけると幸いです！）\n\n\n\nキャラクターのポーズや表情、イラストの構図などすべてもやし様におまかせいたします！\nどうかよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/11", "thumbnail_src": "https://si.imgix.net/b8903bc7/uploads/origins/30975b97-a7a8-462d-bcf2-2cf8a243580f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2edfbaf189ce6998802503d85f7e008", "thumbnail_srcset": "https://si.imgix.net/b8903bc7/uploads/origins/30975b97-a7a8-462d-bcf2-2cf8a243580f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2edfbaf189ce6998802503d85f7e008, https://si.imgix.net/b8903bc7/uploads/origins/30975b97-a7a8-462d-bcf2-2cf8a243580f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d7733f4b25e75dbf88bd05282d9ac5a 2x, https://si.imgix.net/b8903bc7/uploads/origins/30975b97-a7a8-462d-bcf2-2cf8a243580f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d257be947e47bf49cc697de6e69c7b3b 3x", "genre": "art", "nsfw": false, "body": "Hello!\n\nYour art is very beautiful. I would like to make a request!\n\nI would like to request BB from FGO dressed elegantly and sitting upon a throne. I want her to look powerful and commanding, like a modern day queen or empress. You may pose her like the references and use whichever outfit you desire.\n\nPlease have her hair be very long and flowing, reaching the ground, and include her red hair ribbon please!\n\nBB: https://imgur.com/a/mKi41VV\nQueen Reference: https://imgur.com/a/43TAqA4\nHair Reference: https://i.imgur.com/7TiGffR.jpg\n\nThank you for your consideration.", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/10", "thumbnail_src": "https://si.imgix.net/b92f9fe1/uploads/origins/b07cf70a-eea2-4092-88bf-28efd263745b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9859780f830ee310b8dd4565a8ab4c9a", "thumbnail_srcset": "https://si.imgix.net/b92f9fe1/uploads/origins/b07cf70a-eea2-4092-88bf-28efd263745b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9859780f830ee310b8dd4565a8ab4c9a, https://si.imgix.net/b92f9fe1/uploads/origins/b07cf70a-eea2-4092-88bf-28efd263745b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=def6363323fa6bdda27512e8218d820a 2x, https://si.imgix.net/b92f9fe1/uploads/origins/b07cf70a-eea2-4092-88bf-28efd263745b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a15db7ef1ba3cbec79b4f7c83082ea2 3x", "genre": "art", "nsfw": false, "body": "はじめまして。skebで作品を拝見してリクエストさせていただきたくなりました。\n描いてもらいたいのはラグナロクマスターズというゲームで私が使用している兄弟設定のキャラクターです。資料URLを添付しています。\n兄は左の頬にチョコレート色のハートマークがあり、弟は左目にコットンの眼帯をしています。兄弟の場面設定、装飾品のアレンジはお任せいたします。納品の後に印刷サービスを利用したいと思っていますので、サムネ1枚目でサインをいただけるのでしたら作品内にデザインしてもらえると嬉しいです。宛名も入っていて構いません。作品の縦横サイズも問いません。ご検討いただければと思います。\n\nhttps://imgur.com/a/42GtTrG", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/9", "thumbnail_src": "https://si.imgix.net/9ea9d479/uploads/origins/91cbf993-dbf6-4d31-ab1f-ac00c6070615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277cb2a39321848089e54be27a30447a", "thumbnail_srcset": "https://si.imgix.net/9ea9d479/uploads/origins/91cbf993-dbf6-4d31-ab1f-ac00c6070615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277cb2a39321848089e54be27a30447a, https://si.imgix.net/9ea9d479/uploads/origins/91cbf993-dbf6-4d31-ab1f-ac00c6070615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b35c0c994efc1e4c0cace3e711f5e76e 2x, https://si.imgix.net/9ea9d479/uploads/origins/91cbf993-dbf6-4d31-ab1f-ac00c6070615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6153708e8d53da3a48409f726db90fea 3x", "genre": "art", "nsfw": false, "body": "私のFE3HのOC、菊とディミトリの絵が欲しいです。二人は戦後結婚し、やがて息子を授かります。シナリオは、生まれたばかりの息子をフェールグスの市民に見せるというものです。王位継承者の誕生です。息子のデザインは私が作ったので、参考にしながら赤ちゃんの時の姿を想像してください。\n\n場所は首都の宮殿のバルコニーで、たぶん下には人だかりがあるはずです。菊の髪は解いてあり、少し乱れているかもしれません。彼女はとても疲れていますが、幸せそうです。ディミトリは片方の手で群衆に手を振り、もう片方の手で菊を抱きしめているかもしれません。二人ともシンプルな白い服を着ている。菊は寝巻きで、ディミトリはシャツを着ている。\n\n最終的な構図や遠近法はあなた次第です。面倒だったり、他の方がいいと思えば、細部を変えてもかまいません。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1NMsTtkIchtkGvtpwRcZUvyEJMElmK9tg?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/8", "thumbnail_src": "https://si.imgix.net/69ce0ddf/uploads/origins/23106a96-3c3f-4c19-a5f9-f0cbe899e795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=828dec277a3499a0b491f1bca4caaeeb", "thumbnail_srcset": "https://si.imgix.net/69ce0ddf/uploads/origins/23106a96-3c3f-4c19-a5f9-f0cbe899e795?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=828dec277a3499a0b491f1bca4caaeeb, https://si.imgix.net/69ce0ddf/uploads/origins/23106a96-3c3f-4c19-a5f9-f0cbe899e795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5750fbf94f507275f1f97e77a97affd7 2x, https://si.imgix.net/69ce0ddf/uploads/origins/23106a96-3c3f-4c19-a5f9-f0cbe899e795?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=527221e21b634c065a38d9e00550a1d8 3x", "genre": "art", "nsfw": false, "body": "はじめまして！(*^^*)あなたの絵はすごいですね。私のFFXIVのキャラクター、Noaを依頼してもいいでしょうか？\n彼は優しくて内気な吟遊詩人です。他の人を幸せにするために音楽を書いたり演奏したりしています。アーチェリーと魔法を使って戦います。服装は提供されたリファレンスのどちらを使ってもかまいません。\nポーズについては、2つの提案があります。\n1：リラックスした表情でハープ（ホワイトハープ）を演奏しているところ。\n2：弓を持ったアクションポーズ（黒い服には金の弓、白い服には白い弓）。リファレンスの追加フォルダは、アクションポーズを作りたい場合に戦闘エフェクトのアイデアを提供しますが、必須ではありません。\nあなたの裁量にお任せします!この度はありがとうございました\n\nhttps://drive.google.com/drive/folders/1Owu6F9OZikG2X3uXAe0ashAvKI0uROMP?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/7", "thumbnail_src": "https://si.imgix.net/64fa8dca/uploads/origins/7aa32a3b-d234-407b-a294-251c62ce4f51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bbbe179c33104f8fff1621a3264dfbd", "thumbnail_srcset": "https://si.imgix.net/64fa8dca/uploads/origins/7aa32a3b-d234-407b-a294-251c62ce4f51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bbbe179c33104f8fff1621a3264dfbd, https://si.imgix.net/64fa8dca/uploads/origins/7aa32a3b-d234-407b-a294-251c62ce4f51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d49d36d200ac0a186a8d26b7588c134 2x, https://si.imgix.net/64fa8dca/uploads/origins/7aa32a3b-d234-407b-a294-251c62ce4f51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe7479ff56dd7569c9305d5be4728a1d 3x", "genre": "art", "nsfw": false, "body": "リクエストよろしくお願いいたします！\nTwitterでFE風花雪月の素晴らしいアートを拝見して、今回リクエストを送らせていただきました！\n\nファイアーエムブレム、蒼炎の軌跡・暁の女神に登場する「レテ」を描いていただけたら嬉しいです\nレテは獣牙族というケモノのキャラで、誇り高い戦士で武人です。\nポーズやシュチュエーション、表情などはすべておまかせいたします！\nどうかよろしくお願いいたします！\n\n下記URLはレテの参考資料です↓\n\nhttps://imgur.com/gallery/bmtwWmD", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/6", "thumbnail_src": "https://si.imgix.net/18d90262/uploads/origins/eb9d0c23-abc3-4545-8c96-9add9e43f90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dbc839b5b6c2495a021a17a248406d5", "thumbnail_srcset": "https://si.imgix.net/18d90262/uploads/origins/eb9d0c23-abc3-4545-8c96-9add9e43f90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dbc839b5b6c2495a021a17a248406d5, https://si.imgix.net/18d90262/uploads/origins/eb9d0c23-abc3-4545-8c96-9add9e43f90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf72da8f6bb7809e507b8f6b0317c7e1 2x, https://si.imgix.net/18d90262/uploads/origins/eb9d0c23-abc3-4545-8c96-9add9e43f90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bebf451d540f1185cb545ac9873d827c 3x", "genre": "art", "nsfw": false, "body": "リク失礼します。\n\n○キャラクター\n資料urlのオリジナルキャラターをお願いします\nhttps://skeb.jp/@zenmaibook/works/14\n正面のデザイン以外無いので、不明な部分のデザインは想像で補完してください\n\n○背景（というか世界観的なもの）\nhttps://skeb.jp/@hachio81/works/29\nあくまで参考ですので適宜アレンジしてくださってOKです\n\nポーズ、構図などはお任せします", "created_at": "", "completed_at": ""}, {"path": "/@moyashi_mou2/works/5", "thumbnail_src": "https://si.imgix.net/39541f15/uploads/origins/4a66ade7-2d20-462e-b51c-98c9b4782263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6cdf056590072b1b2950db4f1556ea2", "thumbnail_srcset": "https://si.imgix.net/39541f15/uploads/origins/4a66ade7-2d20-462e-b51c-98c9b4782263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6cdf056590072b1b2950db4f15