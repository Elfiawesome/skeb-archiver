d67-7a510e4cb848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15310bbdc7cbecc2ce341e29a9a9836e 2x, https://si.imgix.net/834147d4/uploads/origins/82ef8ac1-36d9-4eb3-9d67-7a510e4cb848?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42f52ffb807d7765f55a40d893893521 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵がとても好きなので、私のオリジナルキャラクターを描いてほしいです。彼らはBloodborneというゲームに登場する私のOCで、世界設定はビクトリア時代とゴシックとスチームパンクスタイルのミックスです。思いつくままに描いてください！構図やポーズも自由です。よろしくお願いします！\n\nインフォメーション二人は愛し合っていて、良きパートナーである。テオはハンターで、イーはこの街に戻ってきたばかりの女の子。テオはイーの世話をし、イーはテオの武器の修理を手伝う。二人は血を消費してHPを回復する。(彼らは人間だが、この街の血は治癒能力を持っている。）\n\nキャラクターデザインはフォルダ内の画像4、画像A1、画像B1を参考にしてください。できれば、キャラクターと背景のレイヤーが入ったPSDファイルも欲しいのですが、ご迷惑をおかけしたらすみません。\n\n用途：個人使用のみ（例：個人サイトでの表示／非商用印刷）\n\nhttps://drive.google.com/drive/folders/11N2iEuv3UYuiefYTTQAAQEp4deSgZrsM", "created_at": "", "completed_at": ""}, {"path": "/@tikokuda/works/167", "thumbnail_src": "https://si.imgix.net/66bf6121/uploads/origins/6ff749fa-5c44-42ac-b005-39a54c9b5a45?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=94110b6961f018e48defb89cdb1c9fe2", "thumbnail_srcset": "https://si.imgix.net/66bf6121/uploads/origins/6ff749fa-5c44-42ac-b005-39a54c9b5a45?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=94110b6961f018e48defb89cdb1c9fe2, https://si.imgix.net/66bf6121/uploads/origins/6ff749fa-5c44-42ac-b005-39a54c9b5a45?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=24a75dd93e0386e863a262bc112f16f3 2x, https://si.imgix.net/66bf6121/uploads/origins/6ff749fa-5c44-42ac-b005-39a54c9b5a45?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=deb1a5bf670b00dfd1808967b407e1ff 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！前回の依頼がとても気に入ったので、今回もお願いしたいと思います！\n\n名前は木山、23歳（女）、探偵をしています。\n\n白髪のショートヘアで、三日月をモチーフにしています。(丸メガネはお好みで！)服装はリラックスしているが仕事着が多い。彼女の表情はたいてい微笑んでいる。\n\n前回のリクエストと同じような感じでも大丈夫です！\n\nhttps://drive.google.com/file/d/1XLjKKtq4KQz4B6TiglOTgBr38bVdWjhZ/view?usp=sharing\n\nhttps://drive.google.com/file/d/1XLjKKtq4KQz4B6TiglOTgBr38bVdWjhZ/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tikokuda/works/166", "thumbnail_src": "https://si.imgix.net/34ad8469/uploads/origins/cf89aa1b-9f60-45ed-bf26-a9287f19bc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3978bf8040b06be68ed44a3503f71a35", "thumbnail_srcset": "https://si.imgix.net/34ad8469/uploads/origins/cf89aa1b-9f60-45ed-bf26-a9287f19bc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3978bf8040b06be68ed44a3503f71a35, https://si.imgix.net/34ad8469/uploads/origins/cf89aa1b-9f60-45ed-bf26-a9287f19bc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e420cafdf58a5efadf57b01998a51683 2x, https://si.imgix.net/34ad8469/uploads/origins/cf89aa1b-9f60-45ed-bf26-a9287f19bc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db864dbdcce90d02fce4289850c2be6c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたのピクセルアートはとてもかわいいです！ポーズはあなた次第です！\n\nGloomyByteはとても疲れたIT技術者のタコです。瞳孔の周りに歯車のディテールがある黄金色の目をしていて、背中から4本の触手が伸びています。\n\nhttps://drive.google.com/drive/folders/1AezQw2jmHVkPbbfoWtw3tMsWpazOrC7t?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tikokuda/works/165", "thumbnail_src": "https://si.imgix.net/02dcd32c/uploads/origins/a2500d89-66d8-4694-b143-1963d09c5b5c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8009502cbff079583ec8ac5499e1067c", "thumbnail_srcset": "https://si.imgix.net/02dcd32c/uploads/origins/a2500d89-66d8-4694-b143-1963d09c5b5c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8009502cbff079583ec8ac5499e1067c, https://si.imgix.net/02dcd32c/uploads/origins/a2500d89-66d8-4694-b143-1963d09c5b5c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=30d3b3910e18442c96ed24cad6a16eeb 2x, https://si.imgix.net/02dcd32c/uploads/origins/a2500d89-66d8-4694-b143-1963d09c5b5c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0000e1add01f8f8fcd19d0060b8c9ce2 3x", "genre": "art", "nsfw": false, "body": "初めまして！以前からあなたの作品が大好きです。私のOCも是非描いて頂きたいです❣️\n\n資料内にある男の子2人のピクセルアートを描いて頂きたいです。\n\n\n⬇️キャラクター\n\nhttps://drive.google.com/drive/folders/1-KcKo4w72jV5uR00pRQeiuoOD2HUqYjC\n\n💙小栗 蓮(白髪の方)\n身長180cm\n青いツリ目\n髪には青いインナーカラー\n両目の下にホクロ\n奏の事が大好き\n\n🩵日倉 奏(薄茶髪の方)\n身長160cm\nミントカラーのジト目\n髪にはミントカラーのインナーカラー\nこちらから見て左頬にホクロ\n蓮は大事な幼なじみ\n\n\n衣装やポーズなどお任せします。\nもし可能なら2頭身の絵があれば嬉しいです。\nホクロや身長などの特徴がピクセルで再現が難しい場合省略して頂いて大丈夫です。\n\n\n絵の使用用途\n観賞用に印刷。SNSに投稿。プロフィール写真に設定。個人で楽しむ為のグッズ化。他の方へ依頼する際の資料...等に使う可能性があります。\n\n\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}