微笑んでいるものだと嬉しいです。雰囲気は暗めでも明るめでも構いません。\n服装など参考資料はURLに添付させていただきます。\n\n希望ファイル形式：カラー、png（可能であればpsdも）\nキャンバスサイズ：おまかせ\n使用用途：観賞用(スマホやPCの壁紙、SNSのアイコン等)。また、個人的に鑑賞する目的で写真紙での印刷も予定しております。\n\n初心者故不手際ございましたら申し訳ありません…！ご検討の程、どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/13Hi5HvV3443bEbIuQqJWxvvsxQLIVxnQ", "created_at": "", "completed_at": ""}, {"path": "/@kotatumrin/works/12", "thumbnail_src": "https://si.imgix.net/a1534634/uploads/origins/0f34cd0d-4290-4a45-972c-741b6b5091bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=576068c8ef1708731092a2b87428b23b", "thumbnail_srcset": "https://si.imgix.net/a1534634/uploads/origins/0f34cd0d-4290-4a45-972c-741b6b5091bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=576068c8ef1708731092a2b87428b23b, https://si.imgix.net/a1534634/uploads/origins/0f34cd0d-4290-4a45-972c-741b6b5091bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e2fdbb62b2f567ae8a4b4d42ef44075 2x, https://si.imgix.net/a1534634/uploads/origins/0f34cd0d-4290-4a45-972c-741b6b5091bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18f67150dc252caaaa13e4c9f97835a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kotatumrin/works/11", "thumbnail_src": "https://si.imgix.net/9484da69/uploads/origins/c2b5cabf-beba-4225-aed9-81aa834c26ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cebe05f23dc933ac6adcb0b8e887790e", "thumbnail_srcset"