3-a8cb-4e1ad681f84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f3444a7deb37c3f44ee37a3cf643f85 2x, https://si.imgix.net/1157d5f6/uploads/origins/62f4ae33-9d6d-4b53-a8cb-4e1ad681f84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62af551c8b08fdc29d5cfdee3ee6a05b 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ばっかんきさん、\n\nまほあこ(魔法少女にあこがれて)のMagia BaiserとMagia Azulのイラストをお願いします。\n\n以下のポーズでマギア・アズールを圧倒するマギア・バイザーを見たいです。https://ibb.co/qNDTrCL\n\n衣装は、基本的な変身した姿がいい。だから、後のエピソードで見られるような「パワーアップした」衣装ではない。\n\n最後に、マギア・アズールの服は少しボロボロにして、これが戦闘の後の出来事であることを暗示したい。これは原作でもよくあることだ。\n\nあとはお任せします。\n\nありがとうございました！\n\nhttps://ibb.co/qNDTrCL\nhttps://ibb.co/7j9Bc3Y\nhttps://ibb.co/VV2RrYx", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/66", "thumbnail_src": "https://si.imgix.net/c9edf43e/uploads/origins/58de0dcd-33bc-4ef7-862f-37734b0c05cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb4d7232f5cd191588a8067467bc6238", "thumbnail_srcset": "https://si.imgix.net/c9edf43e/uploads/origins/58de0dcd-33bc-4ef7-862f-37734b0c05cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb4d7232f5cd191588a8067467bc6238, https://si.imgix.net/c9edf43e/uploads/origins/58de0dcd-33bc-4ef7-862f-37734b0c05cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aada35e971efea4f347ed2375d39f554 2x, https://si.imgix.net/c9edf43e/uploads/origins/58de0dcd-33bc-4ef7-862f-37734b0c05cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12e90bf92c127d09bf855886bd700607 3x", "genre": "art", "nsfw": true, "body": "私のOCであるサム・ガードナーは、ダンジョンズ＆ドラゴンズのペルソナであるバーバリアン！サムに痴漢/ファックされる。トップレスで、表情や胸に焦点を当てる。\n\nhttps://cdn.imgchest.com/files/4apc55pjdd4.jpg <--サイズの違い。\n\nhttps://imgchest.com/p/5xy2b5l6zyl", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/65", "thumbnail_src": "https://si.imgix.net/2da9d8f7/uploads/origins/096afb16-bb58-4e0b-ab54-9a717ca05058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163c3335cd72e98276d4dc5e837ece8d", "thumbnail_srcset": "https://si.imgix.net/2da9d8f7/uploads/origins/096afb16-bb58-4e0b-ab54-9a717ca05058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163c3335cd72e98276d4dc5e837ece8d, https://si.imgix.net/2da9d8f7/uploads/origins/096afb16-bb58-4e0b-ab54-9a717ca05058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fd3881b034f47c6bcbb8d940269a5ec 2x, https://si.imgix.net/2da9d8f7/uploads/origins/096afb16-bb58-4e0b-ab54-9a717ca05058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afd4f2c510ddf3162abfc6a038785265 3x", "genre": "art", "nsfw": true, "body": "こんにちは！^_^\nご指示に従いました。2ページは大丈夫です。2ページ以上だと嬉しいです。\nペルソナ5の新島真と新島冴の百合アートを希望します。\n真琴はお尻と腹筋がきれいで、紗枝はもっと豊満です。\n紗枝は支配されるのが好きで、でもコントロールできる。真琴はもっと恥ずかしがり屋だが、それでもセックスを楽しんでいる。\nディープキスでも、顔面騎乗でも、69でも、何でも好きなように描いてください。ポーズも自由。あなたの選択を信じます。^_^\nでも、特に2つのポーズを入れてほしい：\n1.真琴が紗枝の上に横たわっている。紗枝の脚が誠の腰に巻きついている。二人はディープキスをしている。\n2.誠が横になっている。紗枝は誠の腹筋を舐め、誠のアソコに指を入れている。\nごゆっくりどうぞ。楽しんでね！", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/64", "thumbnail_src": "https://si.imgix.net/51abc867/uploads/origins/512278c5-2135-4021-98b2-57ae27d5a351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbe6c313fea91470e5c5e3095d9652f1", "thumbnail_srcset": "https://si.imgix.net/51abc867/uploads/origins/512278c5-2135-4021-98b2-57ae27d5a351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbe6c313fea91470e5c5e3095d9652f1, https://si.imgix.net/51abc867/uploads/origins/512278c5-2135-4021-98b2-57ae27d5a351?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=149b86d57cac8dd32d35c53b05db97eb 2x, https://si.imgix.net/51abc867/uploads/origins/512278c5-2135-4021-98b2-57ae27d5a351?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e90fb49c58b3555ee5a2ddaafb3d3708 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/63", "thumbnail_src": "https://si.imgix.net/3a3a7e37/uploads/origins/1fd39c07-d97e-4d50-8da1-134b232f86be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e21330a1cbd2dd9e0bf96c5f0a7f62f", "thumbnail_srcset": "https://si.imgix.net/3a3a7e37/uploads/origins/1fd39c07-d97e-4d50-8da1-134b232f86be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e21330a1cbd2dd9e0bf96c5f0a7f62f, https://si.imgix.net/3a3a7e37/uploads/origins/1fd39c07-d97e-4d50-8da1-134b232f86be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7062b873796cc5e38bfee8f2449030cf 2x, https://si.imgix.net/3a3a7e37/uploads/origins/1fd39c07-d97e-4d50-8da1-134b232f86be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8081fc24df3f483d7b31d547b00c0b6c 3x", "genre": "art", "nsfw": true, "body": "こんにちは、さとりわっぱサン！\n\nポケモンのシロナのイラストをお願いします。\n\nシロナの巨乳が露わになる、ヒカリのようなシナリオが見たいです。\n\nシロナの後ろに、シロナと同じような身長の茶髪のイケメン（20代）が立っていて、シャツからおっぱいを出して、シロナのおっぱいを抱いている。\n\n男は裸で、顔が見えていて、温かく微笑んでいることもある。\n\n普段の黒い服を着ているシロナ。\n\n胸が露わになって嬉しそうな、艶めかしい笑顔がかわいいシロナ。\n\n乳首は柔らかくピンク色に描く。\n\nシロナと男が情熱的なキスをしている小さなシーンもお願いします。\n\n彼はキスをしながらシロナのオッパイを鷲掴みにする。\n\n柔らかいピンクの唇でフルマウスキス。\n\nその他、かわいいと思うものがあれば何でも追加してください。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1Px_N8dO7UukJqfwHDidFoJxeVLeUtXfd?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/62", "thumbnail_src": "https://si.imgix.net/54d3d62f/uploads/origins/75fbd4ff-ce10-4f0b-83ae-b47807b89b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e97e96dd93f5e6ab69d3da6a51df483", "thumbnail_srcset": "https://si.imgix.net/54d3d62f/uploads/origins/75fbd4ff-ce10-4f0b-83ae-b47807b89b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e97e96dd93f5e6ab69d3da6a51df483, https://si.imgix.net/54d3d62f/uploads/origins/75fbd4ff-ce10-4f0b-83ae-b47807b89b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddbea176ba17ec473bb0e2aa607e0939 2x, https://si.imgix.net/54d3d62f/uploads/origins/75fbd4ff-ce10-4f0b-83ae-b47807b89b3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1edbd426b525d7d78eac870b165fc19e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、RWBYのヤン・シャオロンが彼女のブレイク・ベラドンナとブレイクの母親カリに犯されている写真をリクエストしたいのですが。ブレイクもカリもペニスがあるはずです。\n\nベラドンナのキッチンで、ブレイクがカウンターに座り、ヤンが膝の上に乗って、彼女のお尻にペニスを入れている設定です。ブレイクはヤンの足を開かせ、カリはその前に立ち、ヤンの口にキスし胸を触りながらヤンのオマンコを犯す。\n\nご検討ありがとうございました\n\nhttps://imgur.com/a/rjXciK8", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/61", "thumbnail_src": "https://si.imgix.net/834e6660/uploads/origins/092fb504-a6ad-4823-97db-01a67244a27d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85c60db0c947ebee3fc2f7e78125219a", "thumbnail_srcset": "https://si.imgix.net/834e6660/uploads/origins/092fb504-a6ad-4823-97db-01a67244a27d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85c60db0c947ebee3fc2f7e78125219a, https://si.imgix.net/834e6660/uploads/origins/092fb504-a6ad-4823-97db-01a67244a27d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e8d9c9f2886f68364502ab5b1db63ee 2x, https://si.imgix.net/834e6660/uploads/origins/092fb504-a6ad-4823-97db-01a67244a27d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e4b0c1b38ef2f96fccfc71ea818654a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。ここの大ファンでパトロンです!あなたの絵が大好きです!\n\nパルテナがフタナリになって、ヒカリを骨抜きにする絵をお願いします。シナリオはパルテナは大乱闘スマッシュブラザーズでヒカリを倒し、ヒカリとヤるようになる。パルテナは支配感を大いに味わい、ヒカリは恥ずかしがりながらも密かにマゾヒストとなり、強烈な潮吹きのオーガズムを味わう。曖昧な挿入（アナルか膣か）もいいかもしれない。\n\nスマブラではキャラクターは縮尺されていませんが、正史ではヒカリの身長は150cm、パルテナの身長は175cm程度です。そこで、パルテナはヒカリよりも背が高く、豊満な体型であることをお願いしたいです。また、背景は「ファイナルデスティネーション」のステージでお願いします（詳細は簡略化していただいてかまいません）。\n\n要望を聞いていただきありがとうございました。\n\nhttps://imgur.com/a/V2AtDYQ", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/60", "thumbnail_src": "https://si.imgix.net/62219423/uploads/origins/a3502d50-3fef-4aa9-b6ce-e22754b24aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14bc185fd16cc3c1cd3c394b50d7dcd9", "thumbnail_srcset": "https://si.imgix.net/62219423/uploads/origins/a3502d50-3fef-4aa9-b6ce-e22754b24aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14bc185fd16cc3c1cd3c394b50d7dcd9, https://si.imgix.net/62219423/uploads/origins/a3502d50-3fef-4aa9-b6ce-e22754b24aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad52c3ee0e33e8e2d61ec127636daba8 2x, https://si.imgix.net/62219423/uploads/origins/a3502d50-3fef-4aa9-b6ce-e22754b24aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ce87910ab0efbc6ed9703b75c475647 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@satoriwappa/works/59", "thumbnail_src": "https://si.imgix.net/20d95296/uploads/origins/39fd7d0d-1049-4fff-b752-c4c7c82a5f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04430c7732ab0aa487ec83490fbd240c", "thumbnail_srcset": "https://si.imgi