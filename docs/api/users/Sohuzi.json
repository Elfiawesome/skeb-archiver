78-4eff-93ca-5197b6b05de1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f13d89b936817bdc619e67f09e91320a, https://si.imgix.net/eda07139/uploads/origins/d11c4ca1-e878-4eff-93ca-5197b6b05de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25ca3f5fabeee5d53652f8f46209cfd2 2x, https://si.imgix.net/eda07139/uploads/origins/d11c4ca1-e878-4eff-93ca-5197b6b05de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d79472215349ebe5ea0ccf713b80aaed 3x", "genre": "art", "nsfw": false, "body": "リクエストさせていただきます。\nウマ娘のサクラチヨノオーを描いていただきたいです。\n\n服装 : 陸上ユニフォーム（セパレートタイプ、下はレーシングブルマ）\n\nシチュエーションはストレッチをしているシーンです。腕を伸ばし、わきがよく見えるポーズを希望します。\n\n可能であればよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Sohuzi/works/35", "thumbnail_src": "https://si.imgix.net/a6d86f1f/uploads/origins/cf5413d7-370c-4936-b654-595421683063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ab38b5316d18fb9c79a0ad87f26788c", "thumbnail_srcset": "https://si.imgix.net/a6d86f1f/uploads/origins/cf5413d7-370c-4936-b654-595421683063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ab38b5316d18fb9c79a0ad87f26788c, https://si.imgix.net/a6d86f1f/uploads/origins/cf5413d7-370c-4936-b654-595421683063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c767040e2ad8a9f11e7335e620792465 2x, https://si.imgix.net/a6d86f1f/uploads/origins/cf5413d7-370c-4936-b654-595421683063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f65c3e5aafcea0481d331d22168fec6 3x", "genre": "art", "nsfw": false, "body": "こんにちは。この度、イラストをお願い出来ないかと参りました。\n\nキャラクターは、ウマ娘の『ライスシャワー』で、陸上競技ユニフォームでお願い出来ないでしょうか。ユニフォームタイプとしては、セパレートタイプのショートスパッツ、ゼッケンは無しでお願いしたいです。\n競技前で身体をほぐしているシチュエーションにしていただけると嬉しいです。その他の構図や背景などは、全てお任せいたします。\n\nご検討いただけますと幸いです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Sohuzi/works/34", "thumbnail_src": "https://si.imgix.net/7c679351/uploads/origins/2c461073-e144-4d67-8aed-8a9507e47886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32ec218a8c103f78ca3cdc17263928f8", "thumbnail_srcset": "https://si.imgix.net/7c679351/uploads/origins/2c461073-e144-4d67-8aed-8a9507e47886?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32ec218a8c103f78ca3cdc17263928f8, https://si.imgix.net/7c679351/uploads/origins/2c461073-e144-4d67-8aed-8a9507e47886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b7a57d5e73f22c171ac5721875eb83a 2x, https://si.imgix.net/7c679351/uploads/origins/2c461073-e144-4d67-8aed-8a9507e47886?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27e19e295e9d8378a978c67134cb340d 3x", "genre": "art", "nsfw": false, "body": "シギノソウジさん初めまして。あなたの競泳水着絵が気に入ったのでリクエストいたします。\n競泳水着姿のうちの子をお願いします。\n私が描いたうちの子は以下の通りです。\nhttps://twitter.com/Chain_Samidare/status/1685905956797124610?s=20\n原案は\nhttps://cdn.discordapp.com/attachments/976084626995036160/980114374687612928/IMG_5354.jpg\n大まかな特徴は\nhttps://twitter.com/Chain_Samidare/status/1445696469776801800?s=20\nです。\n私が描いた絵が原案とかけ離れているのはご容赦ください。\nその他はすべてお任せします。\nもしよろしければリクエストを承認いただけると嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Sohuzi/works/33", "thumbnail_src": "https://si.imgix.net/b0606fae/uploads/origins/e27b5c0b-4d26-4175-b662-df8adb72fa49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4975e76079ada27118d1a6897f6c15be", "thumbnail_srcset": "https://si.imgix.net/b0606fae/uploads/origins/e27b5c0b-4d26-4175-b662-df8adb72fa49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4975e76079ada27118d1a6897f6c15be, https://si.imgix.net/b0606fae/uploads/origins/e27b5c0b-4d26-4175-b662-df8adb72fa49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50c4a8e9c40ba679b759e5776598bf54 2x, https://si.imgix.net/b0606fae/uploads/origins/e27b5c0b-4d26-4175-b662-df8adb72fa49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d865e806eaa597c73e3400489ade2b1f 3x", "genre": "art", "nsfw": false, "body": "※前回から、金額上げて再送させていただきます。「もうちょい出してくれたら…」などありましたら、金額上げて再送希望です。\n今回は「うちのこ黒朱景が、陸上セパレートユニ着て、走り高跳びしてるイラスト」をお願いします!!\nせっかくシギノさんに頼むので「競泳水着」も是非着せてください。なぜなら、どっちで頼もうか迷ってはや半月……結局、どちらか片方とか選べなかったくらい、どちらも好きなので。(PSDでユニと水着を両方オンにすると、陸上ユニの下にインナー着てる感じになるようになってるとありがたいです。)\nうちのこ資料https://twitter.com/kurosuke_g/status/1429822887997841416?t=tt7EZs6489Us53a-Clr5PA&s=19\n「締め付け」が無いと、胸はこのくらいあります\nhttps://skeb.jp/@106Pd_Pallad/works/172\nhttps://skeb.jp/@106Pd_Pallad/works/217\nポイント\n・(美女ではなく)美少女\n・大きめ美乳\n・腹筋はうっすら割れてる\n・むっちりしっかり太もも\n高跳び参考\nhttps://skeb.jp/@YZPYN/works/8\nhttps://www.pixiv.net/artworks/112035836\nhttps://youtu.be/FExbTfkIBOI?si=9TLv0GhrdtxJePs9(アングル等の関係でそのまま参考にはできないと思いますが、前後の動きの参考になれば。もちろん、イラスト映えのためにある程度「ウソ」をつくのも大歓迎です)\nポイント\n・全身(せっかく描いてもらうユニフォーム)がよく見えるように\n・背景は走り高跳びのバーだけあれば、あとは白でも分かるのでOKです\nユニフォーム・水着(&スパイク)に入れていただきたいロゴ\nhttps://twitter.com/kurosuke_g/status/1683039693183799296?t=JsCbr6Ppn9GLWsuZGBwiLg&s=19\n(描く場合)高跳び用スパイクには踵にもピンがあります\nhttps://www.asics.com/jp/ja-jp/high-jump-pro-2-l/p/1093A140-701.html\nご検討を、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Sohuzi/works/32", "thumbnail_src": "https://si.imgix.net/365fc0e5/uploads/origins/5ff830ca-6ee8-4613-9e48-ef3a1b6f1ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316679a7d0d235820139bde490d9c39d", "thumbnail_srcset": "https://si.imgix.net/365fc0e5/uploads/origins/5ff830ca-6ee8-4613-9e48-ef3a1b6f1ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=316679a7d0d235820139bde490d9c39d, https://si.imgix.net/365fc0e5/uploads/origins/5ff830ca-6ee8-4613-9e48-ef3a1b6f1ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr