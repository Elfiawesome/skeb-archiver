すが、今回はのほほんさんに30代後半になったサムス・アランを描いて頂きたいです。\n\n具体的には\nポーズはのほほんさんが描かれていたプロセカの東雲絵名ちゃんと同じ様なポーズでお願いします。\n表情も同じ様な少し恥ずかしい感じでお願いします。\n服装はベージュ色のブラジャーとショーツで、ブラジャーはレース柄のフルカップブラで、ショーツは深履きタイプのレース柄でお願いします。\n体型はのほほんさんの東雲絵名ちゃんと同じか更にムチムチさせて下さい。\n胸は東雲絵名ちゃんより1サイズ大きくお腹の肉はバウンティハンターを引退してたっぷりとお肉がついたボテ腹でお願いします。\nあと可能でしたら下着の色差分とヌード差分もお願いします。\n\nのほほんさんの描く可愛らしさと色気が同時にある熟女が好きで、私の大好きなキャラクターであるサムス・アランを描いて頂きたいですどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@NOHOHON_pic/works/26", "thumbnail_src": "https://si.imgix.net/8693f756/uploads/origins/77639c4d-90b4-48d6-b956-47b3ae5670be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=909dd9864e8e4d0d36e4e66510fbc529", "thumbnail_srcset": "https://si.imgix.net/8693f756/uploads/origins/77639c4d-90b4-48d6-b956-47b3ae5670be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=909dd9864e8e4d0d36e4e66510fbc529, https://si.imgix.net/8693f756/uploads/origins/77639c4d-90b4-48d6-b956-47b3ae5670be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=685b232c41eff6591a914e2f54338e7e 2x, https://si.imgix.net/8693f756/uploads/origins/77639c4d-90b4-48d6-b956-47b3ae5670be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30e253a35edac1bfabfddc5e7dcda660 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NOHOHON_pic/works/25", "thumbnail_src": "https://si.imgix.net/6ccbbc8f/uploads/origins/fbb1116d-41f2-4bce-be08-28b1f91344ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&tx