d-ab16-9da374d2b315?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8dae3ef51b13602146c73ee1f908292, https://si.imgix.net/3bfd4df6/uploads/origins/a85c3ea5-7492-4f6d-ab16-9da374d2b315?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24953dac73ecf5adc48189ac4a955137 2x, https://si.imgix.net/3bfd4df6/uploads/origins/a85c3ea5-7492-4f6d-ab16-9da374d2b315?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d4daa5daa4a23f45c3b1c06c35706de 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuusakura4242/works/216", "thumbnail_src": "https://si.imgix.net/06846526/uploads/origins/7eb33bd9-23cc-4d1e-bc06-1bdcf9a00efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418a2aa19dfa3f976a6401d546691f34", "thumbnail_srcset": "https://si.imgix.net/06846526/uploads/origins/7eb33bd9-23cc-4d1e-bc06-1bdcf9a00efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418a2aa19dfa3f976a6401d546691f34, https://si.imgix.net/06846526/uploads/origins/7eb33bd9-23cc-4d1e-bc06-1bdcf9a00efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=926bfc32d9ccb6fd27d504194e42611a 2x, https://si.imgix.net/06846526/uploads/origins/7eb33bd9-23cc-4d1e-bc06-1bdcf9a00efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4367a33924ee25c5ccbecee55e1551a 3x", "genre": "art", "nsfw": true, "body": "納品期限を過ぎてしまいましたので、改めてリクエストをお送りいたします。\nお引き受けいただけましたら大変嬉しく思います。ぜひご検討のほどよろしくお願いいたします。\n以下、前回と同じ内容となります。\n\n桜湯ハル様\n\nお世話になっております。バーチャルブロガーとして活動している、真白くりすと申します。\n前回はとても素敵なイラストをありがとうございました！\n仕上がりが最高すぎて、読者さんからも「シコり倒した」と大好評でした！\n\n今回はぜひもう一度、私のイラストをご依頼させていただきたくご連絡しました。\n瞳に星があります。おっぱいはやや盛り気味だと嬉しいです。\nhttps://drive.google.com/file/d/1IatU7Q6srWN_tqkuvw3Zz2M3J65DHR_6/view\nhttps://drive.google.com/file/d/1-jumm57CsO7oVfzVezCTm8Q7RTnpefS3/view\n\nシチュエーションは以下のとおりです。\n【1枚目】\n・全裸でフェラチオ\n・「女の子にちんぽしゃぶらせるのってさいてーなんだよ？」（セリフ調整可）的なセリフとともに割と積極的にしゃぶってるところ\n・陰毛なし\n\n【2枚目】\n・外出し射精\n\n以上が依頼内容となります。\nご検討よろしくお願いいたします！！", "created_at": "", "completed_at": ""}, {"path": "/@yuusakura4242/works/215", "thumbnail_src": "https://si.imgix.net/c8adc157/uploads/origins/d41eb499-c6b8-4328-9c02-ba328fc01b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f9b9cfa5da0ad4a8f2139ec8827a387", "thumbnail_srcset": "https://si.imgix.net/c8adc157/uploads/origins/d41eb499-c6b8-4328-9c02-ba328fc01b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f9b9cfa5da0ad4a8f2139ec8827a387, https://si.imgix.net/c8adc157/uploads/origins/d41eb499-c6b8-4328-9c02-ba328fc01b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b88aaa2b791fd4d1c2a347693a1b1129 2x, https://si.imgix.net/c8adc157/uploads/origins/d41eb499-c6b8-4328-9c02-ba328fc01b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75aeb81df1f52cce46bdde68599ac80c 3x", "genre": "art", "nsfw": true, "body": "【再送失礼します】\n\n以前 https://skeb.jp/@yuusakura4242/works/196 のイラストを描いていただきました。\nその節は素敵な作品をありがとうございました。\n今回も同じく私のオリジナルキャラ「秋山令」のスカトロイラストを描いていただけると嬉しいです。\n\n【キャラクター設定】\n前回と同じキャラクターです。\n参考画像は資料URLにて、\n・柔和な顔つき、巨乳（B90くらい？）低身長 \n・陰毛濃いめ\n\n【シチュエーション】\n彼氏とのプレイで浣腸して便秘うんちを排泄するという設定でお願いいたします。\n部屋の中でしゃがみ込んで、太い大便を排泄音と共にのっそりとひり出しています。\n下は何も履いておらず上はシャツの前を開けてブラが見えており、片方の胸が\nあらわになっているような半脱げ状態、\n口には白いボールに黒いベルトの穴あきボールギャグを咥えてよだれを垂らし\n「んも゛っ…お゛っ…んおぉぉぉぉお…ん…」とくぐもった喘ぎ声を上げている様子をお願いします。\n\nhttps://imgur.com/a/bkKZb8C", "created_at": "", "completed_at": ""}, {"path": "/@yuusakura4242/works/214", "thumbnail_src": "https://si.imgix.net/2f0c48eb/uploads/origins/099a0ec4-0b22-4100-b667-217e91f757fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bef0a12540639611e0585040d0c66a40", "thumbnail_srcset": "https://si.imgix.net/2f0c48eb/uploads/origins/099a0ec4-0b22-4100-b667-217e91f757fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bef0a12540639611e0585040d0c66a40, https://si.imgix.net/2f0c48eb/uploads/origins/099a0ec4-0b22-4100-b667-217e91f757fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf27a43a5b619401a6bd607c7408d66f 2x, https://si.imgix.net/2f0c48eb/uploads/origins/099a0ec4-0b22-4100-b667-217e91f757fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ddc8d420abad4d5695f5409f3fe8b89 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuusakura4242/works/213", "thumbnail_src": "https://si.imgix.net/dee52ffa/uploads/origins/756ef977-8963-4420-86d3-edfb23c5ee44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d99c699bdf11ba783c39d79b141f812", "thumbnail_srcset": "https://si.imgix.net/dee52ffa/uploads/origins/756ef977-8963-4420-86d3-edfb23c5ee44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d99c699bdf11ba783c39d79b141f812, https://si.imgix.net/dee52ffa/uploads/origins/756ef977-8963-4420-86d3-edfb23c5ee44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7348a1f623ab3c66ed5b2692844aa9db 2x, https://si.imgix.net/dee52ffa/uploads/origins/756ef977-8963-4420-86d3-edfb23c5ee44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab9c0193a4118a6fa396f39337a3c6b3 3x", "genre": "art", "nsfw": true, "body": "桜湯ハル先生\nこんにちは、匿名で失礼します\n\npixivであげられていた先生の過去作\nhttps://www.pixiv.net/artworks/109946813\nhttps://www.pixiv.net/artworks/109890080\nの雰囲気がとても刺さりまして、もしよろしければ承認をお願いします。\n\n先生の描く黒髪の女の子とても好きなのですが、可能でしたらキャラはこちらhttps://dic.pixiv.net/a/%E5%AE%9D%E5%A4%9A%E5%85%AD%E8%8A%B1\nの宝多六花に、近い感じの黒髪ロングJKで、\n\n【『お掃除フェラなんて出来ないし、お願いされたって絶対にしない』と言っていたのに、事後、彼氏君(上記のキャラの同年代位の男の子で体型は先生の地味子サキュバスマンガの中田君位、顔は画面外でお願いします。)のを愛おしそうにお掃除フェラしている】というシチュエーションでイラストをお願いします。\n\n事後の服装は制服の半脱ぎで胸を露出、スカートは、捲り上がっていて下着は脱いでいる、又は、片足に引掛っている、でお願いします。\n\n事後の構図は脚を大きく開いていて、胸やお腹にも精液が飛んでいて、出しされて少し開いた秘所からは逆流した様精液が溢れ出しているのが見える構図でお願いします\n\n先生の考えるセリフ回しが好きなので、セリフの改変、追加などお願いしたいです\n\n金額的に問題があるなどの場合はキャンセルや再送気兼ね無くお願いします。\n\nご検討の程、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@yuusakura4242/works/212", "thumbnail_src": "https://si.imgix.net/3d34c63d/uploads/origins/4c56ce96-4806-4dd1-a272-5857a4cc843c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=090ef2cca4381a815c6541c94e8160ee", "thumbnail_srcset": "https://si.imgix.net/3d34c63d/uploads/origins/4c56ce96-4806-4dd1-a272-5857a4cc843c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=090ef2cca4381a815c6541c94e8160ee, https://si.imgix.net/3d34c63d/uploads/origins/4c56ce96-4806-4dd1-a272-5857a4cc843c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b80bc976b3d6a713122aa608d0cadea1 2x, https://si.imgix.net/3d34c63d/uploads/origins/4c56ce96-4806-4dd1-a272-5857a4cc843c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41de37f9eeaa266fb25aded71ce3ca25 3x", "genre": "art", "nsfw": true, "body": "桜湯ハル様\n\n初めましてシシンと申します。\nうちの子「天理」のイラストをお任せでお願いしたいです。\n好きにやっちゃってください。\n\nhttps://drive.google.com/file/d/1Cb6YVvwpUbxrW0N0LIwjSKI_RVSNBVQi/view?usp=sharing\nhttps://drive.google.com/file/d/187j5vFh73mUQurOv4aUEq139mI0W4kri/view?usp=sharing\nhttps://drive.google.com/file/d/14aYNb49NF45F5083RN9b1B4wJX44Wl98/view?usp=sharing\n\nコンセプトはお淑やかで礼儀正しい巨乳の箱入り娘\n身長１６５ｃｍ、体重６０ｋｇ\nスリーサイズＢ：９０（Ｅ）　Ｗ：６４　Ｈ：８９\n\n腰まである黒いロングストレートの髪に黒い瞳、落ち着いた雰囲気の美人。\nスタイルがよく着痩せするタイプ。\nシンプルで露出の少ない落ち着いた雰囲気の服装を好む。\n大人しく社交的で大抵の事はそつなくこなせるが探究心旺盛で興味を持った事柄をとことん識ろうと行動、結果を出し天才とも呼ばれる。\nしかし、止まる事を知らず暴走とも呼べるほど突っ走るのでいつも幼馴染みの玲子にフォローされている。\n\nご都合が合わなかったり、難しいようでしたらキャンセルしてください。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yuusakura4242/works/211", "thumbnail_src": "https://si.imgix.net/2bc74867/uploads/origins/7a30b554-e139-4a7c-8d58-13125dcc190d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c56d7855924c9d9d80d9814f48145a2", "thumbnail_srcset": "https://si.imgix.net/2bc74867/uploads/origins/7a30b554-e139-4a7c-8d58-13125dcc190d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c56d7855924c9d9d80d9814f48145a2, https://si.imgix.net/2bc74867/uploads/origins/7a30b554-e139-4a7c-8d58-13125dcc190d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d1acea2ee1db1d6ab3c9574f095b2cb 2x, https://si.imgix.net/2bc74867/uploads/origins/7a30b554-e139-4a7c-8d58-13125dcc190d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41d7890efccc33c461f1740309344dae 3x", "genre": "art", "nsfw": true, "body": "ストリートファイター https://photos.app.goo.gl/hHpJGciuFwQMvD857 観月かりんさんとの仕事をお願いしたいです。\n\nいろいろな彼女を描いてほしい。\n\n服を着たまま嫌そうな顔をして、服の下から大男に胸やアソコを触られている。\n\n次に彼女は後背位で犯され、淫らな表情で男のペニスに屈服している。", "created_at": "", "completed_at": ""}, {"path": "/@yuusakura4242/works/210", "thumbnail_src": "https://si.imgix.net/7be23d90/uploads/origins/9dde606d-5905-4975-afa2-28b1e6a11446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6647284f4e1e19fd3e945e5059fbf34", "thumbnail_srcset": "https://si.imgix.net/7be23d90/uploads/origins/9dde606d-5905-4975-afa2-28b1e6a11446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6647284f4e1e19fd3e945e5059fbf34, https://si.imgix.net/7be23d90/uploads/origins/9dde606d-5905-4975-afa2-28b1e6a11