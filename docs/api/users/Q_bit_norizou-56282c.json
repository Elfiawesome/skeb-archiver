1/uploads/origins/8065a3f5-5d92-4a54-acca-47d7a0c89204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e39efad533679f530400a7877b4156c7", "thumbnail_srcset": "https://si.imgix.net/68edea41/uploads/origins/8065a3f5-5d92-4a54-acca-47d7a0c89204?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e39efad533679f530400a7877b4156c7, https://si.imgix.net/68edea41/uploads/origins/8065a3f5-5d92-4a54-acca-47d7a0c89204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efa9f08b726d726a2b43d962ea8dafd7 2x, https://si.imgix.net/68edea41/uploads/origins/8065a3f5-5d92-4a54-acca-47d7a0c89204?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f04ea7c78bc3240145a3423c45a681d5 3x", "genre": "art", "nsfw": true, "body": "改めまして、よろしくお願いします！\n初めてなので勝手がわからないのですが、\n銀髪、メガネ、褐色、舌出し、縦セーター\nこのうち全て満たしてなくてもOK\n既存キャラ、オリジナル問いません\nエロいよりかっこいい重視だと嬉しいです\n\nて感じでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Q_bit_norizou/works/9", "thumbnail_src": "https://si.imgix.net/df04adba/uploads/origins/884d5cfc-f29a-448c-87f9-3218de0b8a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0859e606a5bfa2df7d371b56e34878e6", "thumbnail_srcset": "https://si.imgix.net/df04adba/uploads/origins/884d5cfc-f29a-448c-87f9-3218de0b8a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0859e606a5bfa2df7d371b56e34878e6, https://si.imgix.net/df04adba/uploads/origins/884d5cfc-f29a-448c-87f9-3218de0b8a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d3bca5161891e059f89b1b815a26a79 2x, https://si.imgix.net/df04adba/uploads/origins/884d5cfc-f29a-448c-87f9-3218de0b8a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91483cd92bb7d13a041e468a00b9c550 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Q_bit_norizou/works/8", "thumbnail_src": "https://si.imgix.net/ad410896/uploads/origins/b723ae8c-013d-4d16-b63c-08ce2217a44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e2bdf0048dc6175bb32fa18e7bbd2b", "thumbnail_srcset": "https://si.imgix.net/ad410896/uploads/origins/b723ae8c-013d-4d16-b63c-08ce2217a44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e2bdf0048dc6175bb32fa18e7bbd2b, https://si.imgix.net/ad410896/uploads/origins/b723ae8c-013d-4d16-b63c-08ce2217a44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86f43ae52914ceda787b7bd062c1b97d 2x, https://si.imgix.net/ad410896/uploads/origins/b723ae8c-013d-4d16-b63c-08ce2217a44e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1456b52e02450974dd94e8051fc39aa 3x", "genre": "art", "nsfw": true, "body": "ドレスアップしたBaccaratのフルヌードボディをお願いします。\nバカラの参考資料： https://imgur.com/a/xBuX6vH\nボディとポーズのリファレンス： https://imgur.com/a/YGFzKwM\n\n姿勢は正面からの立ち姿で、体を見せるために手足を開いてつま先立ちになります。  足の姿勢は、参考資料のようにハイヒールを見せるようにしています。\n女の子の体は、スリムで背が高く、細くて長い脚と非常に細いウエストに大きな胸があります。\n\n肌：白い光沢のある肌に、ピンクの乳首、マンコ、長い爪、ピンクのつま先の爪\nそして、ピンクのリップグロスとアイシャドウでお化粧をしてあげてください。\n服装：ハイヒール、ストッキング、コルセット、ロンググローブ、チョーカー。そして彼女のチョンサンとレザーグローブ\n服の参照: https://imgur.com/a/6b4FxgW\n\nまた、服の各レイヤーと彼女のイヤリングとネックレスを分けます。\n全身ヌードも別のレイヤーです。髪の毛もできれば別レイヤーにしてください。\n最終的な作品はPSDレイヤーファイルで、すべて別のレイヤーになっています。\nPSDの参照先\nhttps://mega.nz/file/sJMikJYB#qh7H6w0wCI9N-GrLFPC81n1aBjSrNKnXeJykhxZJVVg\n\nhttps://mega.nz/file/sJMikJYB#qh7H6w0wCI9N-GrLFPC81n1aBjSrNKnXeJykhxZJVVg", "created_at": "", "completed_at": ""}, {"path": "/@Q_bit_norizou/works/7", "thumbnail_src": "https://si.imgix.net/c067a5b1/upload