b8257d2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0814936c65da442b78f8e79f3910307", "thumbnail_srcset": "https://si.imgix.net/8941bb8d/uploads/origins/533d0f9b-dc9b-4b3f-af90-eefb8257d2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0814936c65da442b78f8e79f3910307, https://si.imgix.net/8941bb8d/uploads/origins/533d0f9b-dc9b-4b3f-af90-eefb8257d2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4016389c48ab692bc4af8975cc4a8f21 2x, https://si.imgix.net/8941bb8d/uploads/origins/533d0f9b-dc9b-4b3f-af90-eefb8257d2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=286e72e54612f320a661c4a7995418d4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私は日本語を話すことができません、とても残念です。あなたの絵が大好きです、私のキャラクターを描いてください!\n\nhttps://files.catbox.moe/xto507.jpg", "created_at": "", "completed_at": ""}, {"path": "/@salt_10r00/works/6", "thumbnail_src": "https://si.imgix.net/fbd572fb/uploads/origins/d146f9b4-eaa5-4f79-9208-a648168897d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d01b631f3cb297e10d545ed8bfc75767", "thumbnail_srcset": "https://si.imgix.net/fbd572fb/uploads/origins/d146f9b4-eaa5-4f79-9208-a648168897d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d01b631f3cb297e10d545ed8bfc75767, https://si.imgix.net/fbd572fb/uploads/origins/d146f9b4-eaa5-4f79-9208-a648168897d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8087bd4a888423c0cb742f830897b276 2x, https://si.imgix.net/fbd572fb/uploads/origins/d146f9b4-eaa5-4f79-9208-a648168897d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b57f6f26b330297daa1ea8ab6c7a117 3x", "genre": "art", "nsfw": false, "body": "せんえん様、初めまして！夜遅くに申し訳ありません。素敵な絵を楽しく拝見させて頂きました！綺麗な絵柄に惹かれて、可能ならばせんえん様に私の自キャラのイラストを依頼したいと思っております。\n\n【１】\nキャラと服装の参照は下記のURLをご覧ください。中華ファンタジーの設定に、小さい頃から「外の世界」に憧れを抱いているのハーフエルフの女性です(161cm、24歳)。いつも礼儀正しくて、大人しい性格が持っている方です。趣味は読書と折り紙を作ること。\n\n【依頼内容】\n可能ならば、この子で「牡丹」のモチーフを入れて、一枚のイラストをお願い致します。明るい雰囲気で描いて頂ければ大変嬉しいです。その他のポーズや構図などはせんえん様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://sta.sh/21pcdjus30ko", "created_at": "", "completed_at": ""}, {"path": "/@salt_10r00/works/5", "thumbnail_src": "https://si.imgix.net/bcd8b8a8/uploads/origins/96f717cc-c742-45c7-a303-272d7a880a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0df5806c8cb512bab8826253cc4d3f22", "thumbnail_srcset": "https://si.imgix.net/bcd8b8a8/uploads/origins/96f717cc-c742-45c7-a303-272d7a880a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0df5806c8cb512bab8826253cc4d3f22, https://si.imgix.net/bcd8b8a8/uploads/origins/96f717cc-c742-45c7-a303-272d7a880a62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dbbf2d96c8018b4f3a54a7f468021a3 2x, https://si.imgix.net/bcd8b8a8/uploads/origins/96f717cc-c742-45c7-a303-272d7a880a62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=064ecc5005d45ab1cf3e969ecdec1381 3x", "genre": "art", "nsfw": false, "body": "せんえん様\n全身図、背景無しでお願いします。\n描いて頂きたいのは、資料URLの黒髪の方の子のみです。\n髪型　黒髪のストレートセミロング、前髪は資料URLの1枚目参照\n顔　下記URLの1枚目が近い、垂れ目がちの黒目、黄金比で中性的\nhttps://twitter.com/lost_nov/status/1595366956726558720?t=K6Z0iQWDfatOqotyq1eORg&s=19\n体型　スレンダーで、胸は大きめ\n肌　白磁の肌\n服装　スクエアネックのロングワンピースにコルセット、靴はピンヒールのブーツ\n構図　立っていて、小脇に一冊本を抱えている\nよろしくお願い致します。\n\nhttps://twitter.com/lost_nov/status/1594736143374831616?t=CBP850q7Zg4LClP9XGPd4Q&s=19", "created_at": "", "completed_at": ""}, {"path": "/@salt_10r00/works/4", "thumbnail_src": "https://si.imgix.net/4962b674/uploads/origins/76618bda-a25e-4016-a205-ae6a8128dc7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f67d0ab6930d298130fb4c0463fefe6", "thumbnail_srcset": "https://si.imgix.net/4962b674/uploads/origins/76618bda-a25e-4016-a205-ae6a8128dc7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f67d0ab6930d298130fb4c0463fefe6, https://si.imgix.net/4962b674/uploads/origins/76618bda-a25e-4016-a205-ae6a8128dc7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=226ded7d8cb98d59a567ba7551e39d8b 2x, https://si.imgix.net/4962b674/uploads/origins/76618bda-a25e-4016-a205-ae6a8128dc7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bf48dc767aef6efb3be208535db99b1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@salt_10r00/works/3", "thumbnail_src": "https://si.imgix.net/289fddad/uploads/origins/7c455647-7b4a-41dd-9353-4bd177ba08fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8199bd70ebc8d19ac32b2ae5830005e", "thumbnail_srcset": "https://si.imgix.net/289fddad/uploads/origins/7c455647-7b4a-41dd-9353-4bd177ba08fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8199bd70ebc8d19ac32b2ae5830005e, https://si.imgix.net/289fddad/uploads/origins/7c455647-7b4a-41dd-9353-4bd177ba08fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddbcee0e93f695473799d59d45b64b86 2x, https://si.imgix.net/289fddad/uploads/origins/7c455647-7b4a-41dd-9353-4bd177ba08fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53e7294db44f59030e291f2a793a3bc1 3x", "genre": "art", "nsfw": false, "body": "初めまして。VTuberのはるるんと申します。\n素敵な絵柄に惹かれ、ぜひ書いて頂きたくご依頼させて頂きました。\n\nはるるんのデザインは資料URLからご確認ください。\n構図やポージングは全てお任せいたします。\nキャラのデザインと上記のイメージから連想して、自由に描いて頂きたいです！\n\nイラストはYouTubeのサムネやTwitterなど各種SNSに使わせていただきます。\nそのため、頭の先や横の髪の毛などは先が切れないように書いて頂けると嬉しいです。\nできればキャラのみの透過でも利用できるようにしていただけると幸いです。\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Ldkh_wW-RoE0LOw66yXnzpiC_6Hh5XAb?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@salt_10r00/works/2", "thumbnail_src": "https://si.imgix.net/ee21e742/uploads/origins/899c9d62-8808-4659-b59b-7eafd9ef77e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd0a132a06c27e65dfd4915fdd661931", "thumbnail_srcset": "https://si.imgix.net/ee21e742/uploads/origins/899c9d62-8808-4659-b59b-7eafd9ef77e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd0a132a06c27e65dfd4915fdd661931, https://si.imgix.net/ee21e742/uploads/origins/899c9d62-8808-4659-b59b-7eafd9ef77e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04d951fc4bfde86fa00ded966e31ad27 2x, https://si.imgix.net/ee21e742/uploads/origins/899c9d62-8808-4659-b59b-7eafd9ef77e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d68167ed476785bd9fabc197ed4714df 3x", "genre": "art", "nsfw": false, "body": "こんにちは......私のTRPGのキャラクターをリクエストしたいのですが。\n\nメルリンは、大きなバトルアックスを振り回すバーサーカーです。普段は笑顔でいることが多い。ファイアーエムブレムのヒルダに似ていますね。彼女は休暇を楽しむ人で、とても頭が良いのですが、分別がありません。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1Zc4OkbTvR1vM5oA4aeVVRz1F1snnNJux?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@salt_10r00/works/1", "thumbnail_src": "https://si.imgix.net/9840d7ef/uploads/origins/2b5b692e-e39e-4536-987a-5f20687065e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=010ffbfd756c437e5dbbcd891d10149d", "thumbnail_srcset": "https://si.imgix.net/9840d7ef/uploads/origins/2b5b692e-e39e-4536-987a-5f20687065e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=010ffbfd756c437e5dbbcd891d10149d, https://si.imgix.net/9840d7ef/uploads/origins/2b5b692e-e39e-4536-987a-5f20687065e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e35620b8ed0dafd8b4f4b20d81c670f 2x, https://si.imgix.net/9840d7ef/uploads/origins/2b5b692e-e39e-4536-987a-5f20687065e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3f7941509e425f9669cae43f3101a1c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私は新しいクリエイターのセクションであなたのSkebを見つけ、あなたのスタイルは非常に豪華です！もしよろしければ、私のキャラクターデルタの絵をお願いしたいです\n彼は、人々に良い夢を届けるキツネです！彼は控えめで、しばしば自分自身の中に閉じこもり、夏には人と一緒にいるよりも、庭のアジサイと鯉の池の手入れをすることを好みます。\n構図はお任せしますので、お好きなようにお断りしてください！ ありがとうございました！😊🙏。\n\nhttps://sta.sh/2dg8zoq76w5?edit=1", "created_at": "", "completed_at": ""}]}