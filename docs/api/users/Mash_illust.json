-96a1-baaa4e65e98c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8976be5fac169054d282067aa40c3e1d, https://si.imgix.net/99d32183/uploads/origins/c47afc80-834d-421c-96a1-baaa4e65e98c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7085e5924289185823cc1fb1d15c6b8f 2x, https://si.imgix.net/99d32183/uploads/origins/c47afc80-834d-421c-96a1-baaa4e65e98c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ec001d400c655866f5cb7d711206aec 3x", "genre": "art", "nsfw": true, "body": "こちらのミネ団長がめちゃくちゃ刺さったので同じシチュエーションでワカモのおくちえっちを描いていただけないでしょうか？\nhttps://skeb.jp/@Mash_illust/works/52\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Mash_illust/works/53", "thumbnail_src": "https://si.imgix.net/3c3c099f/uploads/origins/1589c957-f7d3-4f64-bce5-d8018f72eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a668232280aff8019ffe6e10d66d5566", "thumbnail_srcset": "https://si.imgix.net/3c3c099f/uploads/origins/1589c957-f7d3-4f64-bce5-d8018f72eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a668232280aff8019ffe6e10d66d5566, https://si.imgix.net/3c3c099f/uploads/origins/1589c957-f7d3-4f64-bce5-d8018f72eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3d22610b03a38723574eef7f541435a 2x, https://si.imgix.net/3c3c099f/uploads/origins/1589c957-f7d3-4f64-bce5-d8018f72eca4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8330c0193b4048063fc1476d894b9666 3x", "genre": "art", "nsfw": true, "body": "マッシュ様、こんにちは。\n\n投稿されている作品が素晴らしいと感じたので依頼させて頂きます。\n\nキャラクター\nブルーアーカイブの百合園セイア\n\n希望するシチュエーション\n半裸のセイアが先生に後ろから犯されている。私はこんなシチュエーションで興奮する変態ではないよとセイアは言うがセイアの左胸に手を押し当てた先生にセイアの心臓（ここ）は正直だねと言われて誰かに見つかるかもしれないという背徳感に興奮して心臓の鼓動が速くなっているのがバレて耳まで真っ赤になってしまい、そのまま中出しされて絶頂してしまう。\n\n私は心臓フェチなので心臓（心音）の描写には過去に依頼した作品を参考に力を入れてもらえると嬉しいです。指定した箇所以外は信頼してお任せします。アドリブも歓迎します。以上の内容で受けて頂ける場合はよろしくお願いします。\n\nhttps://skeb.jp/@nShiTsuGaIKoTsu/works/10\n\nhttps://skeb.jp/@karimatagundan/works/13\n\nhttps://skeb.jp/@mokuu__/works/9\n\nhttps://skeb.jp/@puyochocolate/works/121", "created_at": "", "completed_at": ""}, {"path": "/@Mash_illust/works/52", "thumbnail_src": "https://si.imgix.net/22c5137f/uploads/origins/b2fda256-b062-41e2-a8e4-28a575a8642f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d480451f61d0153dbd06ed559b91957e", "thumbnail_srcset": "https://si.imgix.net/22c5137f/uploads/origins/b2fda256-b062-41e2-a8e4-28a575a8642f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d480451f61d0153dbd06ed559b91957e, https://si.imgix.net/22c5137f/uploads/origins/b2fda256-b062-41e2-a8e4-28a575a8642f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a09a928a571d3470e78f4d6c6fed9cb0 2x, https://si.imgix.net/22c5137f/uploads/origins/b2fda256-b062-41e2-a8e4-28a575a8642f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8eae1ab9d9a4c0997435b95496ccd2db 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nブルアカの蒼森ミネのイラストをお願いしたいです。服装は着衣の有無含めてなんでもいいです。\n\n希望プレイ内容は過去描かれていましたURL先のマリーのイラストのような主観視点での亀頭を咥えながらの手コキフェラ口内射精です。\nhttps://www.pixiv.net/artworks/107838821\nセリフは無くても構いませんが効果音付きだと嬉しいです。\n\n以上、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Mash_illust/works/51", "thumbnail_src": "https://si.imgix.net/03803451/uploads/origins/2faaa99e-b32d-4440-af30-47877be1dbbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c1f0fe0def3f18649a2bf7876374de4", "thumbnail_srcset": "https://si.imgix.net/03803451/uploads/origins/2faaa99e-b32d-4440-af30-47877be1dbbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c1f0fe0def3f18649a2bf7876374de4, https://si.imgix.net/03803451/uploads/origins/2faaa99e-b32d-4440-af30-47877be1dbbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00e8cf366e328a2e9b51595a727cf4fd 2x, https://si.imgix.net/03803451/uploads/origins/2faaa99e-b32d-4440-af30-47877be1dbbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca4efe5ed91e580b6f5f6b528ac66964 3x", "genre": "art", "nsfw": true, "body": "こんにちは、マッシュさん。\n\nマッシュさんの女の子の描き方がとても好きなので、お願いがあります。\n\nキャラクター：聖園ミカ（ブルーアーカイブ） \n\nシナリオ：シュンさんのために、間違えて不思議な薬を飲んで小さくなってしまったミカさん。その後、先生の好みに合った体を手に入れたことに気づき（11～12歳くらい）、即座に攻勢に出る。\n\nポーズ： 決められなかったので、お任せします、 \n① ：小柄なミカがタオルケット一枚になり、魅惑的にタオルケットを持ち上げ、胸と陰部を見せる。\n②： 小さな女の子になりながらも、ミカはその優れた力で先生を押さえつけ、騎乗位でセックスする。\n\n若いミカの体についてのメモ \nミカは小さくなったが、体はまだ少しふにゃふにゃしている。\n胸がある： ココナみたい。\n羽: コハルみたい\n陰毛: もちろんない。", "created_at": "", "completed_at": ""}, {"path": "/@Mash_illust/works/50", "thumbnail_src": "https://si.imgix.net/152f4644/uploads/origins/df0e3b1c-5d04-4866-ace2-8d135b05b32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8e094dc2b74411f8dbb4400e5ad7f9a", "thumbnail_srcset": "https://si.imgix.net/152f4644/uploads/origins/df0e3b1c-5d04-4866-ace2-8d135b05b32b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8e094dc2b74411f8dbb4400e5ad7f9a, https://si.imgix.net/152f4644/uploads/origins/df0e3b1c-5d04-4866-ace2-8d135b05b32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3563f4238689b9648e2985237e7816c0 2x, https://si.imgix.net/152f4644/uploads/origins/df0e3b1c-5d04-4866-ace2-8d135b05b32b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fb481ccab4f19472bd9f852934d1090 3x", "genre": "art", "nsfw": true, "body": "菌糸先生、ご無沙汰しております。\n\n前回のプラナちゃんのskeb依頼の時はありがとうございました。\n\n急な依頼で申し訳ないのですが、ブルーアーカイブの水着姿のアロナちゃんとプラナちゃんの甘マゾえっちな絵を依頼したくお願いいたします。\n\nシチュエーションは、砂浜で水着姿のアロナちゃんとプラナちゃんにちんちんを舌先で気持ちよくされて、先生のちんちんを咥えずに亀頭の穴、尿道口に舌先を挿れて、先生に見せつけるように尿道口を開いてそのままぐにぐにと尿道の中を舌先でほじほじ刺激されて、アロナちゃんとプラナちゃんに「いいですよ♡このまま射精しちゃってください♡」と言われながら射精を促されるような尿道ほじほじWフェラをしてくれるえっちな絵をお願い致します。\n\n希望\n・アロナちゃんとプラナの水着は着服\n（アロプラ水着姿は資料URL参照）\n・フルカラー\n・コマ割断面図（可能であれば）\n・射精差分（可能であれば）\n・イラストの構図はこちらのリンクから参考にお願いいたします。\nhttps://www.pixiv.net/artworks/108613231\nhttps://www.pixiv.net/artworks/113650428\n\nその他の細かい部分はお任せいたします。\n\nお気に召さなかった場合はキャンセルしても構いません。\n\n本当に誠に勝手な依頼ではございますがご検討の程、\nよろしくお願いいたします。\n\nhttps://youtu.be/6KIcO3ka7wM?si=F1X7pqPBBkAhSzZZ", "created_at": "", "completed_at": ""}, {"path": "/@Mash_illust/works/49", "thumbnail_src": "https://si.imgix.net/9e1ba568/uploads/origins/eea9234f-09a0-4323-9ba8-855e4b5aaeaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0218fcf78e37d2a9ce9ba92fc3404e0", "thumbnail_srcset": "https://si.imgix.net/9e1ba568/uploads/origins/eea9234f-09a0-4323-9ba8-855e4b5aaeaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0218fcf78e37d2a9ce9ba92fc3404e0, https://si.imgix.net/9e1ba568/uploads/origins/eea9234f-09a0-4323-9ba8-855e4b5aaeaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=549e72fad24a8bf42598aecb67f5a504 2x, https://si.imgix.net/9e1ba568/uploads/origins/eea9234f-09a0-4323-9ba8-855e4b5aaeaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9890267adc67dc31695ec34353433175 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mash_illust/works/48", "thumbnail_src": "https://si.imgix.net/b0edc444/uploads/origins/703cbc43-eb24-4486-8cb9-93f4445039c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f52f56210c67c8c2cf077a19924580c8", "thumbnail_srcset": "https://si.imgix.net/b0edc444/uploads/origins/703cbc43-eb24-4486-8cb9-93f4445039c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&