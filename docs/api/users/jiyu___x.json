200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27601c1d169d65ed1940083f3b18aff1 2x, https://si.imgix.net/49e20e7b/uploads/origins/1272e34c-55ab-46bc-aaf0-56a9dcec459a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a78c5aa419e618996cb09f658eb0215 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jiyu___x/works/8", "thumbnail_src": "https://si.imgix.net/8397ff41/uploads/origins/0d194b15-5848-4831-bf4e-f56da6138e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe9cf3ee693c0710dd7bfdbead2a169f", "thumbnail_srcset": "https://si.imgix.net/8397ff41/uploads/origins/0d194b15-5848-4831-bf4e-f56da6138e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe9cf3ee693c0710dd7bfdbead2a169f, https://si.imgix.net/8397ff41/uploads/origins/0d194b15-5848-4831-bf4e-f56da6138e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e4d0630d6c6276894bf87de20b779a6 2x, https://si.imgix.net/8397ff41/uploads/origins/0d194b15-5848-4831-bf4e-f56da6138e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9eaab58bf3a004fc2fbbba6de774d06f 3x", "genre": "art", "nsfw": false, "body": "\"こんにちは、クトゥルフ神話TRPGに使用するイラスト(全身立ち絵)をリクエストしたいです。\nよろしくお願いします。\n\n使用は個人利用に限り、商用利用はありません。\n使用時は背景を透過させたイラストになります。\n貴方の絵がとても好きなので、指定のない部分はお任せします。\n\n以下がキャラクターの詳細になります。\"\n年齢：15\n性別：女性\n血液型：AB\n\n職業：中学生(ミュージシャン希望)\n\nSTR(筋　力)[3D6/MAX18]：14\nCON(体　力)[3D6/MAX18]：15\nPOW(精神力)[3D6/MAX18]：12\nDEX(敏捷性)[3D6/MAX18]：16\nAPP(魅　力)[3D6/MAX18]：13\nSIZ(体　格)[2D6+6/MAX18]：14\nINT(知　能)[2D6+6/MAX18]：13\nEDU(教　養)[3D6+3/MAX21]：11\n\n身長：159\n体格：肉付きがいい\n\nメインの性格：裏表がない\nサブの性格：自制心が強い\n\nキャラクターイメージ\n軽音楽部の元気な女子中学生。\n担当楽器はドラム。(ドラムスティック持ってたら嬉しいです)\n弟と妹が沢山いるタイプの長女。\n\nイメージカラー：76EEAB\n\"イメージカラーとしていますが、差し色や小物、服などに似た色を取り入れていただければ幸いです。\n(もちろん、メインカラーとして頂いても構いません。)\"\n\n服装イメージ\nhttps://i.imgur.com/ND0Opa8.jpeg\nhttps://i.imgur.com/QzxhMAp.jpeg\n画像のようなヒップホップ系のへそ出しファッションを考えています。\n\n肉体のイメージ\n胸とお尻にお肉がついています\n\n表　情：笑顔\n髪　色：黒～イメージカラーあたりを考えています。家計もあるのであまり染めず。\n髪　型：ショート～ボブ\n\nポーズ・構図：お任せします\n\n小物・取り入れて欲しい要素：ドラムスティック", "created_at": "", "completed_at": ""}, {"path": "/@jiyu___x/works/7", "thumbnail_src": "https://si.imgix.net/9a948a29/uploads/origins/56f24cb5-82ff-436a-965b-5d9398827f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbabe498a2ff969da1624612d9479c03", "thumbnail_srcset": "https://si.imgix.net/9a948a29/uploads/origins/56f24cb5-82ff-436a-965b-5d9398827f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbabe498a2ff969da1624612d9479c03, https://si.imgix.net/9a948a29/uploads/origins/56f24cb5-82ff-436a-965b-5d9398827f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4893da119a9c490aca00c415420dec99 2x, https://si.imgix.net/9a948a29/uploads/origins/56f24cb5-82ff-436a-965b-5d9398827f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=199ef56208f3118c764a6e04b2046172 3x", "genre": "art", "nsfw": false, "body": "やあ、はじめまして！\n\n私のOC、桜花美を褒めてくれてありがとう！\n\nどんなOCでも、どんな衣装でも、自由に描いてください！\n\nさくらのメイン衣装\nhttps://imgur.com/a/zCNbCYW\n\nさくらのパジャマ\nhttps://imgur.com/a/qREYXML\n\nさくらのモダンな衣装：\nhttps://imgur.com/a/duuEDnp", "created_at": "", "completed_at": ""}, {"path": "/@jiyu___x/works/6", "thumbnail_src": "https://si.imgix.net/bd2cabed/uploads/origins/0ecc785c-7275-4f70-9392-83e778cb5cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24752aa0b894fb23700868901fed57b0", "thumbnail_srcset": "https://si.imgix.net/bd2cabed/uploads/origins/0ecc785c-7275-4f70-9392-83e778cb5cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24752aa0b894fb23700868901fed57b0, https://si.imgix.net/bd2cabed/uploads/origins/0ecc785c-7275-4f70-9392-83e778cb5cbc?bg=%23fff&auto=format%2Cc