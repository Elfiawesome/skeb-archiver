igins/c9c881a0-58d8-4bae-8fda-a55fa1da9b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba2f66e031808a6834775aab1174e9f1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Mizuuchilucia/works/8", "thumbnail_src": "https://si.imgix.net/55ca714b/uploads/origins/63e8e250-35f7-4206-bf0e-0e3c7b9c8d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e262258f469668c11e3cc9c1d2dd1fe", "thumbnail_srcset": "https://si.imgix.net/55ca714b/uploads/origins/63e8e250-35f7-4206-bf0e-0e3c7b9c8d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e262258f469668c11e3cc9c1d2dd1fe, https://si.imgix.net/55ca714b/uploads/origins/63e8e250-35f7-4206-bf0e-0e3c7b9c8d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0628d31dd12dd15e502a81ccaefe829 2x, https://si.imgix.net/55ca714b/uploads/origins/63e8e250-35f7-4206-bf0e-0e3c7b9c8d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cc442ea74b2f1a1bd18b52352543a5e 3x", "genre": "art", "nsfw": false, "body": "ゆめさかゆいなです。 \n水野さんのおさない感じのイラスト、大変かわいくて好みです〜！\n もしよろしければ、ゆいなのイラストをお願いできませんか？ \n特に指定はないので、自由に書いていただければと思います。\n 衣装の資料をURLにて添付いたしますが、省略や改変して頂いても構いません。 \nご検討よろしくお願いいたします。\n\nhttps://fantia.jp/posts/307906", "created_at": "", "completed_at": ""}, {"path": "/@Mizuuchilucia/works/7", "thumbnail_src": "https://si.imgix.net/8264dfc1/requests/243214_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=762f1c2b6350104fc3c53613c2d927c5", "thumbnail_srcset": "https://si.imgix.net/8264dfc1/requests/243214_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=762f1c2b6350104fc3c53613c2d927c5, https://si.imgix.net/8264dfc1/requests/243214_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39edb7b0e4a9d23be