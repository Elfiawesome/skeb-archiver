e=30&txt=PRIVATE&s=2fcbed41980f6c45152b02e430e7bd8a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chizuimo/works/18", "thumbnail_src": "https://si.imgix.net/93c00adf/uploads/origins/f78efec4-43e0-4c4c-83e9-65b0ef121013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de13c75ca64e76ff2c742258110b603", "thumbnail_srcset": "https://si.imgix.net/93c00adf/uploads/origins/f78efec4-43e0-4c4c-83e9-65b0ef121013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de13c75ca64e76ff2c742258110b603, https://si.imgix.net/93c00adf/uploads/origins/f78efec4-43e0-4c4c-83e9-65b0ef121013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bbe90792c2dbfb8fecf1661a5ffc4c7 2x, https://si.imgix.net/93c00adf/uploads/origins/f78efec4-43e0-4c4c-83e9-65b0ef121013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5a12f8faf8b190beccb47fd6e1cacc8 3x", "genre": "art", "nsfw": false, "body": "初めまして。以前から絵柄が好みで、依頼をしたいと思っていたのでよろしければリクエストさせてください。\n個人勢Vtuberの「金糸雀こはく」ちゃんのファンアートをお願いします。\n\n【構図など】\n・ベッドに女の子座りで座って、右手に梵天付きの耳かきを持っているようお願いします。\n・部屋に入ってきたこっちを見て、微笑みながら左手で手招きしてる感じでお願いします。\n・髪型はツインテールを解いたロングヘア―で、衣装は添付2枚目の部屋着衣装でお願いします。\n・長袖の上着を着崩して、肩が見えている。\n・その他細かい部分はお任せします。\n\n【参考資料】\n・三面図\nhttps://twitter.com/kanaria_ko89/status/1452814761406590981\n・部屋着衣装\nhttps://twitter.com/kanaria_ko89/status/1561867886830178304\n・ご本人Twitter\nhttps://twitter.com/kanaria_ko89\n\n【使用用途】\n・こはくちゃん本人に限りイラストの使用許可（Twitterのアイコンやヘッダー、Youtubeのサムネイル利用等）をいただければ幸いです。\n・納品データは宛名ありと宛名無しがあると幸いです。\n\n以上になります、ご検討のほどよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@chizuimo/works/17", "thumbnail_src": "https://si.imgix.net/db52d14d/uploads/origins/4b2252ed-fc00-4592-b18b-ee9045e60c70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45bf9b62d76b5216b5b6cfa8b6aaef67", "thumbnail_srcset": "https://si.imgix.net/db52d14d/uploads/origins/4b2252ed-fc00-4592-b18b-ee9045e60c70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45bf9b62d76b5216b5b6cfa8b6aaef67, https://si.imgix.net/db52d14d/uploads/origins/4b2252ed-fc00-4592-b18b-ee9045e60c70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=176377c8e721ab873e61c2f02c393903 2x, https://si.imgix.net/db52d14d/uploads/origins/4b2252ed-fc00-4592-b18b-ee9045e60c70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c9363d9db3eba25b41b069ea1b27561 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chizuimo/works/16", "thumbnail_src": "https://si.imgix.net/c3062031/uploads/origins/8a70a3ef-dccc-4d25-b486-4d9d02978a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=402bffafad7fb3cecbc01ea2c919548c", "thumbnail_srcset": "https://si.imgix.net/c3062031/uploads/origins/8a70a3ef-dccc-4d25-b486-4d9d02978a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=402bffafad7fb3cecbc01ea2c919548c, https://si.imgix.net/c3062031/uploads/origins/8a70a3ef-dccc-4d25-b486-4d9d02978a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8934be72eb21a8d6de118ae992f5b0fb 2x, https://si.imgix.net/c3062031/uploads/origins/8a70a3ef-dccc-4d25-b486-4d9d02978a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bebbd8db6e02b38c7fc8767011bd3e1b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のFF14キャラクターの私服姿を描いていただけないでしょうか？彼女は情熱的で、生意気で、ちょっとお茶目なパワフルなメイジです。  武器は描かないでください。彼女の表情、ポーズ、背景はお任せします。\n\n参考までに写真を載せておきます。\nhttps://imgur.com/a/2bSNs61", "created_at": "", "completed_at": ""}, {"path": "/@chizuimo/works/15", "thumbnail_src": "https://si.imgix.net/305b5f4f/uploads/origins/55ccdf86-fb33-4711-99ed-2dd1968f00b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d125a671ba8e22ad029ba5bc659f8d1c", "thumbnail_srcset": "https://si.imgix.net/305b5f4f/uploads/origins/55ccdf86-fb33-4711-99ed-2dd1968f00b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d125a671ba8e22ad029ba5bc659f8d1c, https://si.imgix.net/305b5f4f/uploads/origins/55ccdf86-fb33-4711-99ed-2dd1968f00b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b17e74755d05162da2b07e56610adf6 2x, https://si.imgix.net/305b5f4f/uploads/origins/55ccdf86-fb33-4711-99ed-2dd1968f00b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0620943628bb3aaa58101df1a428366d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの作品が大好きです。私はあなたの作品がとても好きです、それは美しいです!\n私のVTUBERのアバターAmariiを描いてもらえませんか？やわらかくて、かわいくて、ちょっとセクシーな女性です。胸が大きくて、太ももがぽっちゃりしていて、とても曲線的です。いつも黄色の服を着ています。\nワイングラスを持って赤ワインを飲みながら、バレンタインデーのデートをしているような絵が描けると思いますか？服装は普段着でも黄色のワンピースでもどちらでもOK!\nワインを飲んでほっぺたがピンクになっています。\n\n本当にありがとうございました。\n\nhttps://drive.google.com/file/d/1CWjKu5FpMlgzw3gxQVdjnY8PWi2z8MSq/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@chizuimo/works/14", "thumbnail_src": "https://si.imgix.net/d307483a/uploads/origins/4a10786a-2060-49a9-8037-1e1a2c855549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c51ecd8be8869453eb694cb677b120", "thumbnail_srcset": "https://si.imgix.net/d307483a/uploads/origins/4a10786a-2060-49a9-8037-1e1a2c855549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c51ecd8be8869453eb694cb677b120, https://si.imgix.net/d307483a/uploads/origins/4a10786a-2060-49a9-8037-1e1a2c855549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aed46c792518297171f4cfb71444034c 2x, https://si.imgix.net/d307483a/uploads/origins/4a10786a-2060-49a9-8037-1e1a2c855549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5a36fac89b873fc129e15d9c4a79b3c 3x", "genre": "art", "nsfw": false, "body": "初めまして。spoonという配信アプリで配信をしております、あくびと申します。\n\nお姉さん系のイラストで探しており、ある方のご依頼イラストを拝見しまして自分のイメージとピッタリな上に素敵な作品だと思いリクエストさせて頂きます。(リクエスト文も多少引用させて頂きます)\n\n■使用用途\n・配信中の背景、アイコン\n・Twitterのアイコン、ヘッダー\n・配信告知用のスケジュール表\n※グッズ化はいたしません。\n\n■サイズ、\n1080×1920、 9:16\n※背景が縦の為、縦にして頂きたいです\n\n■希望イラストイメージ\n・おっとりお姉さん\n・服装は私服(キレイめ系)。季節を問わず使えるようなものですと嬉しいです。(少し肩の部分だけレースだったりと肌見せ要素があると嬉しいです)\n・片耳に髪をかきあげてるポージング(その際にピアスが見えていると嬉しいです。デザインはキレイめ系のシンプルなものであればお任せします。)\n・頭や髪の毛も含めて上半身が見切れていないように描いてもらえる幸いです\n髪型、色味等は現在Twitterで使っているアイコンに沿って頂きたく思います。\nhttps://twitter.com/spoon_akubi?t=ubmVhy3eY5OK_uJnPTM9fQ&s=09\n\n■その他\n・本イラストの他に背景透過した人物のみのものも頂ければ幸いです\n・納品形式はJPEG\n\nそのほかすべてお任せいたします。\nスケブを使った依頼が初めてですので至らない点がございましたらご指摘頂ければと思います。\nファイル形式に関してはAndroidにて受け取る為JPEGを指定しましたが他何かおすすめがあればご指摘頂ければ助かります。\n\nふんわりとした色使い、雰囲気のお姉さんイラストを描ける方を探しておりましたのでソヲスケ様のイラストを拝見して是非私もイラストを描いて頂きたくご連絡させて頂きました。\n\nどうぞ、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chizuimo/works/13", "thumbnail_src": "https://si.imgix.net/9db4ebc7/uploads/origins/30648d9c-00b1-4e13-b2af-6e0e9c87ab00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24fef909eeeedb0544de1ceeee454d1e", "thumbnail_srcset": "https://si.imgix.net/9db4ebc7/uploads/origins/30648d9c-00b1-4e13-b2af-6e0e9c87ab00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24fef909eeeedb0544de1ceeee454d1e, https://si.imgix.net/9db4ebc7/uploads/origins/30648d9c-00b1-4e13-b2af-6e0e9c87ab00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bad588a6b396ffc2a3f23217123d7228 2x, https://si.imgix.net/9db4ebc7/uploads/origins/30648d9c-00b1-4e13-b2af-6e0e9c87ab00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a257e50fe264800bbd6a43decb584105 3x", "genre": "art", "nsfw": false, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、優しい感じであれば嬉しいです)\n作者さんの理想の嫁を自由に描いてください\n\n特徴　けもみみ(キツネ耳)\n(作者様判断で「けもみみ無し」でも可です。その場合の注意点を一番下に記載)\n（現在の依頼完了分がほぼケモミミ有りです。作者様にはケモミミ無しverの制作をご一考頂けると嬉しいです)\n\n髪のスタイル　作者様におまかせします\n髪の色　おまかせします。白狐等も可\n\n服装　白無垢\n服の色は少し黄色味のある白色、又は白　(他色を薄く混ぜ可)\n白無垢のライン色　基本の白無垢はなしですが、作者様判断で入れても構いません\n\n使用しないで欲しい物のお願い(小物や装飾品で使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため)\n赤色和傘の所持　なし　(人物よりも目立つため)\n狐のお面の装着　なし　(顔が隠れるため。所持は可)\n\nその他の装飾品や小物等はおまかせします\n\nキャラクターの方向性は、優しい感じのお姉さんでお願いします\n（花嫁の髪は装飾品等を用いて綺麗にセットしてあげてください)\n\n季節　収穫の秋(イチョウ、モミジ)、又は芽吹きの季節の春(サクラ)\n（季節は参考情報ですので自由に描いてください）\n\n構図、背景、解像度はおまかせします\n\n宛名等はナシでお願いします\n\n参考資料等ＵＲＬまとめ１～４\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報・地域の祭り等、非商用に限る)\n\n山口県の稲穂祭（きつねの嫁入り）を応援しています\n\nご検討お願いします\n\n※例外\nけもみみ無しの場合\n通常の人として扱います\n狐の嫁入り祭り参加（主役の花嫁）の設定\n髪色は黒か茶が一般的と思われますが、作者様の好みを最優先に、他の髪色も可です\nこんな花嫁が欲しい！という思いを具現化していただければと思います\nなお、狐の嫁入り設定のため、白無垢に「白狐のお面」を所持等してください\n（狐面と猫面は似ているのでご注意ください）\nさらに下記の例からひとつ願います\n例１．綿帽子なし\n例２．綿帽子を着用。帽子をけもみみっぽく加工\n例３．綿帽子を着用。帽子の加工無し", "created_at": "", "completed_at": ""}, {"path": "/@chizuimo/works/12", "thumbnail_src": "https://si.imgix.net/ca118307/uploads/origins/288c0011-2027-4d1e-9f57-7683c2b82555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=683c19985bcecdf2446d96ccee3fa589", "thumbnail_srcset": "https://si.imgix.net/ca118307/uploads/origins/288c0011-2027-4d1e-9f57-7683c2b82555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=683c19985bcecdf2446d96ccee3fa589, https://si.imgix.net/ca118307/uploads/origins/288c0011-2027-4d1e-9f57-7683c2b82555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&t