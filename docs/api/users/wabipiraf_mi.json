-4d51-90e5-7a41c9fe7f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d045d2849d4e1f91f69777be92c74ac 2x, https://si.imgix.net/29d2e11d/uploads/origins/ffa235dd-f71b-4d51-90e5-7a41c9fe7f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbefea99f2cddd18fd423fd61c6f8180 3x", "genre": "art", "nsfw": false, "body": "みかむろと申します。\nイラストを描いていただきたく存じます。\n具体的には、イリアムというアプリにおけるヘッダーのイラストをお願いしたいです。\nイメージとしては、文字にて「CHAOS」と全体的に描いてあり紫色の背景に黄緑や黄色、白色で文字がデフォルメしてある感じです。\nトランプのスート（ﾀﾞｲﾔ、ｽﾍﾟｰﾄﾞなど）がイラストに散りばめられていたり、文字の一部がスートであっても素敵だと思います（Aの三角形の部位が♥など）。\nどうぞよろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@wabipiraf_mi/works/147", "thumbnail_src": "https://si.imgix.net/7cf5bbac/uploads/origins/b2c40161-0591-4d5f-8571-5cfa3043d9d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554d264bf877e2e3a91b95e0e4051fe5", "thumbnail_srcset": "https://si.imgix.net/7cf5bbac/uploads/origins/b2c40161-0591-4d5f-8571-5cfa3043d9d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554d264bf877e2e3a91b95e0e4051fe5, https://si.imgix.net/7cf5bbac/uploads/origins/b2c40161-0591-4d5f-8571-5cfa3043d9d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc7e0af83d8a5984ecfe80aa5ebe3d11 2x, https://si.imgix.net/7cf5bbac/uploads/origins/b2c40161-0591-4d5f-8571-5cfa3043d9d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e34750c5af69736925812450c0735f10 3x", "genre": "art", "nsfw": false, "body": "初めまして、Vtuberの『遊城マコ（アスキマコ）』と申します。\n\nXでの素敵なイラストを拝見し、目の書き方が本当にドタイプでぜひ依頼をさせていただきたいと思いご連絡させていただきました。\n\n今回依頼させていただくのは、私自身のイラストになりますので、キャラクター設定資料を送らせていただきます。\n\n【キャラクター】\n- 戦うゲームが大好きな戦闘狂なVTuber\n- ゲーマー×ネオンPOPなデザイン\n- 脳筋で破天荒な性格だが、仕事熱心\n- 基本リスナーからはゲラで色気ないといわれるが、胸と慎重と尻がデカい（むっつりリスナーが多い）\n\n\n【設定資料】\nhttps://drive.google.com/drive/folders/1MSdMwz3kGd25IRTo9oJHIbZ68AkYO7l1?usp=drive_link\n\n【イラスト依頼内容】\n詫ピラフ先生が描いている、強気そうな女の子の表情がとても好きです！\nにぃっと笑っているようないたずらっ子なイメージで、フリーにイラストをお願いできますでしょうか。（セクシー要素などはいっても大丈夫です！）\n縦横比は16:9にしていただけると嬉しいです。\nXに一部載せていたこちらの雰囲気がとても好きです....！\nhttps://x.com/wabipi_mimi/status/1903229578136653844/photo/1\nhttps://x.com/wabipi_mimi/status/1784941852678086845/photo/1\n\nイラストを描いていただいた際は、\n\n- SNS投稿\n- YouTubeサムネイルでの使用\n-配信のOP/EDに使用\n上記にて使用させていただきます。\n\n詳細でわかりにくいところなどがありましたら申し訳ありません。\n分かりにくいところなどがあれば、先生のイメージで全く問題ございません！\n\n可能でしたら、人物、背景、宛名等が分けられたPSDデータ\nもしくはPNGファイルだと嬉しいです。\n\nリクエスト内容等可能な範囲で結構ですので、ぜひご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1MSdMwz3kGd25IRTo9oJHIbZ68AkYO7l1?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@wabipiraf_mi/works/146", "thumbnail_src": "https://si.imgix.net/ee65655f/uploads/origins/b866a587-eb7d-46bc-8487-1c0cf8fbf358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4f89a2f79eed10ac50cb4dd96c72225", "thumbnail_srcset": "https://si.imgix.net/ee65655f/uploads/origins/b866a587-eb7d-46bc-8487-1c0cf8fbf358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4f89a2f79eed10ac50cb4dd96c72225, https://si.imgix.net/ee65655f/uploads/origins/b866a587-eb7d-46bc-8487-1c0cf8fbf358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae7c494c9ca56c4eccb20e0d1ce27a97 2x, https://si.imgix.net/ee65655f/uploads/origins/b866a587-eb7d-46bc-8487-1c0cf8fbf358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcd093dd23ae64bf2654e4e82ee0408e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wabipiraf_mi/works/145", "thumbnail_src": "https://si.imgix.ne