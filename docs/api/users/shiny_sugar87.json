f5fcf80/uploads/origins/86c7779a-7bbd-4d34-adc6-fc004ced2290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ded0dc72ba4a1b92c434386c06c094c", "thumbnail_srcset": "https://si.imgix.net/4f5fcf80/uploads/origins/86c7779a-7bbd-4d34-adc6-fc004ced2290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ded0dc72ba4a1b92c434386c06c094c, https://si.imgix.net/4f5fcf80/uploads/origins/86c7779a-7bbd-4d34-adc6-fc004ced2290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3898e9a1f505890c3c69469bed23ccf5 2x, https://si.imgix.net/4f5fcf80/uploads/origins/86c7779a-7bbd-4d34-adc6-fc004ced2290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20e233d3cf284b4c280b8037c10597c2 3x", "genre": "art", "nsfw": false, "body": "とても可愛いデフォルメイラストでしたので、よろしければVtuberさんへのプレゼント用イラストを描いていただけなないでしょうか。\n\n描いていただきたいVtuberさん：名古屋なも(https://x.com/758namo) さん \n参考画像 https://drive.google.com/drive/folders/1NLwoWGlfKyDz7AknkQuSq1ftZ7yRHjUN?usp=drive_link \n2次創作ガイドライン：https://758namo.com/guidline.html \n（コミッションでの依頼に関してはOKされています。） \n\nイラストの委細に関してはお任せしますので、可愛いデフォルメイラスト描いていただけると嬉しいです。\n\n使用用途 \n・作者さまの名前を記載の上でFAとして投稿、 グッズ作成(個人利用の範囲)\n ・名古屋なも様ご本人がYouTube(収益化済み)等の配信やTwitterなどのSNSでの使用 \n\n希望納品形式 \n宛名、背景、人物などが別れたPSDファイル \nPSDが無理であればpngでも可です\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shiny_sugar87/works/4", "thumbnail_src": "https://si.imgix.net/29369e8a/uploads/origins/4b3e8e37-a69d-43d1-9001-0c2ceb7a6af0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a88dd04ea7a4bf81f8062ed66501130", "thumbnail_srcset": "https://si.imgix.net/29369e8a/uploads/origins/4b3e8e37-a69d-43d1-9001-0c2ceb7a6af0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a88dd04ea7a4bf81f8062ed66501130, https://si.imgix.net/29369e8a/uploads/origins/4b3e8e37-a69d-43d1-9001-0c2ceb7a6af0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68ba68790