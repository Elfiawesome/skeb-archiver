d7d6/uploads/origins/a5b1d0b1-d057-47b8-9a3c-22543dcc6658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fa7c1672d4eb97f1a56ac4fa1081a26 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@azarashi_suki/works/49", "thumbnail_src": "https://si.imgix.net/ec2afd88/uploads/origins/e6406522-04c8-4152-ad27-605d45ae3f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ffe493b202c89333c413521a303008", "thumbnail_srcset": "https://si.imgix.net/ec2afd88/uploads/origins/e6406522-04c8-4152-ad27-605d45ae3f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ffe493b202c89333c413521a303008, https://si.imgix.net/ec2afd88/uploads/origins/e6406522-04c8-4152-ad27-605d45ae3f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc790537e305ba6fa8953d866d81dbee 2x, https://si.imgix.net/ec2afd88/uploads/origins/e6406522-04c8-4152-ad27-605d45ae3f0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea5c9a7488483b143e00d0cbdc842ac6 3x", "genre": "art", "nsfw": false, "body": "はじめまして！猫宮にぃとと申します！\npandaさんのミニキャラ絵が大好きです！\nぜひ、ヘッダー用のミニキャラを描いて頂きたく思います！\nミニキャラを真ん中より右か左に寄せて頂けると嬉しいです！\n\nサイズは縦500、横1200程でよろしくお願いします！\n\n\nhttps://twitter.com/mao_mao84/status/1657703519594610689?s=46&t=Ok_0Jf573SlhZkSqNMiFrA\n\nhttps://twitter.com/mao_mao84/status/1657703519594610689?s=46&t=Ok_0Jf573SlhZkSqNMiFrA", "created_at": "", "completed_at": ""}, {"path": "/@azarashi_suki/works/48", "thumbnail_src": "https://si.imgix.net/eb02ad7a/uploads/origins/d9cab9c5-4549-479e-93a2-669f3b86c9fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20831e6ddf9eba61203f3b1f2a33df41", "thumbnail_srcset": "https://si.imgix.net/eb02ad7a/uploads/origins/d9cab9c5-4549-479e-93a2-669f3b86c9fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20831e6ddf9eba61203f3b1f2a33df41, https://si.imgix.net/eb02ad7a/uploads/origins/d9cab9c5-4549-479e-93a2-669f3b86c9fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d4a25a2fd962aec4801b68390b36a4b 2x, https://si.imgix.net/eb02ad7a/uploads/origins/d9cab9c5-4549-479e-93a2-669f3b86c9fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06f819cfc6cca330075a393f5b11c4a4 3x", "genre": "art", "nsfw": false, "body": "本文\n\nツイッター、YouTube、Discord、Misskeyのヘッダーに共用(1500×500)と、切り抜きでプロフィール用に使用(丸いやつ、ツイッター、YouTube、Discord、Misskey)として依頼したいです。\n\n絵の内容ですが\n以前描いていただいた黒髪セミロング猫耳娘が魚(鯉のぼりみたいな)をかじってご満悦な感じで。後、以前描いていただいた地球は横にでも適当に転がして貰えれば。デフォルメ風でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@azarashi_suki/works/47", "thumbnail_src": "https://si.imgix.net/4b177ce6/uploads/origins/55a73d3e-ccdb-4c9d-b018-0c242bce1bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46d7e9b8837f3e9a93d1c977ddb2454e", "thumbnail_srcset": "https://si.imgix.net/4b177ce6/uploads/origins/55a73d3e-ccdb-4c9d-b018-0c242bce1bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46d7e9b8837f3e9a93d1c977ddb2454e, https://si.imgix.net/4b177ce6/uploads/origins/55a73d3e-ccdb-4c9d-b018-0c242bce1bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0ea18e401083921b8b048b700f91c54 2x, https://si.imgix.net/4b177ce6/uploads/origins/55a73d3e-ccdb-4c9d-b018-0c242bce1bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=254ec0439ec2627910ba341c3147cb88 3x", "genre": "art