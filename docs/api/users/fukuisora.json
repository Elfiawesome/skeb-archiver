c5/uploads/origins/f2b690b0-324a-498f-a627-2340150560b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac5220eaac4ab4ea731cf941d5369ac3, https://si.imgix.net/a3434fc5/uploads/origins/f2b690b0-324a-498f-a627-2340150560b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5cc4746866cfce8777ce0a1bec698f4 2x, https://si.imgix.net/a3434fc5/uploads/origins/f2b690b0-324a-498f-a627-2340150560b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=312688749fa1a8dabcb261d84dff3486 3x", "genre": "art", "nsfw": true, "body": "はじめまして！ルーンファクトリー３のトゥーナとマイスがイチャラブエッチしている所をお願いします！\n\n・キャラ資料→資料URL（公式サイト）\n・二人の関係は新婚の夫婦で、左手の薬指を描く際は指輪をしていて欲しいです。\n・イラストのメインはトゥーナで。マイスは見切れていても大丈夫です。\n・プレイ内容の詳細はお任せしますが、最初は服を着ていて徐々に脱がしていってほしいです。\n\n以上よろしくお願いします！\n\nhttps://runefactory.marv.jp/series/rf3SP/character.html", "created_at": "", "completed_at": ""}, {"path": "/@fukuisora/works/542", "thumbnail_src": "https://si.imgix.net/a9a6bf15/uploads/origins/93f3c3ea-2fd1-4a3c-8960-eb5ec3b9e3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f52e0b3d750f364d52ea2efa7728835", "thumbnail_srcset": "https://si.imgix.net/a9a6bf15/uploads/origins/93f3c3ea-2fd1-4a3c-8960-eb5ec3b9e3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f52e0b3d750f364d52ea2efa7728835, https://si.imgix.net/a9a6bf15/uploads/origins/93f3c3ea-2fd1-4a3c-8960-eb5ec3b9e3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a3a1aa90d18ec52a78fae70884b8d8e 2x, https://si.imgix.net/a9a6bf15/uploads/origins/93f3c3ea-2fd1-4a3c-8960-eb5ec3b9e3aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2945904d0bde11c6efe88b947c79acd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fukuisora/works/541", "thumbnail_src": "https://si.imgix.net/3ea51da7/uploads/origins/1118163b-f6e3-408b-8c40-5b03596b44fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c05ede32937a327c598e131ee25da253", "thumbnail_srcset": "https://si.imgix.net/3ea51da7/uploads/origins/1118163b-f6e3-408b-8c40-5b03596b44fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c05ede32937a327c598e131ee25da253, https://si.imgix.net/3ea51da7/uploads/origins/1118163b-f6e3-408b-8c40-5b03596b44fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7073000a0ead03195b1c6f77baa31d8 2x, https://si.imgix.net/3ea51da7/uploads/origins/1118163b-f6e3-408b-8c40-5b03596b44fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cb0cb248f3b7241608fdd083061e66c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fukuisora/works/540", "thumbnail_src": "https://si.imgix.net/d22a7183/uploads/origins/5b7db6ae-06ee-410e-9c6d-f5939697ba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bdeeaa341c992a731c45676c39467e1", "thumbnail_srcset": "https://si.imgix.net/d22a7183/uploads/origins/5b7db6ae-06ee-410e-9c6d-f5939697ba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bdeeaa341c992a731c45676c39467e1, https://si.imgix.net/d22a7183/uploads/origins/5b7db6ae-06ee-410e-9c6d-f5939697ba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5326d2be0b9627ec2db930174c345673 2x, https://si.imgix.net/d22a7183/uploads/origins/5b7db6ae-06ee-410e-9c6d-f5939697ba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b5f78430f6a4299daa5aea9545690af 3x", "genre": "art", "nsfw": true, "body": "はじめまして、ゲーム『リーグ・オブ・レジェンド（LoL）』のイラストをお願いしたいです。「雨の導き手」の4人全員：トリスターナ、グウェン、ミリオ、フィズです。彼らは人間2人（男性と女性）と魔法の生き物2人（男性と女性）です。\n\nエナメルレインコートを着たまま、4人で楽しげに性行為にふけっています。舞台は自然の中の睡蓮の浮かぶ池です。可能であれば、男性も画面に収め、切れたり顔が隠れたりしないようにしてください。私の焦点は4人が共に楽しむ様子にあり、女性だけを鑑賞するものではありません。キャラクターの組み合わせなどはご判断にお任せします。ご検討いただきありがとうございます。\n\nhttps://imgur.com/a/ZnrdIMX", "created_at": "", "completed_at": ""}, {"path": "/@fukuisora/works/539", "thumbnail_src": "https://si.imgix.net/556eb10f/uploads/origins/ebc96db1-c246-4100-9afd-e1319a515642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d25065a6626b6897327eaa73262c27", "thumbnail_srcset": "https://si.imgix.net/556eb10f/uploads/origins/ebc96db1-c246-4100-9afd-e1319a515642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d25065a6626b6897327eaa73262c27, https://si.imgix.net/556eb10f/uploads/origins/ebc96db1-c246-4100-9afd-e1319a515642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cac0e648aa21568d5e04dce46a6d66bb 2x, https://si.imgix.net/556eb10f/uploads/origins/ebc96db1-c246-4100-9afd-e1319a515642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45cb694bccef9360ad81bdcb02460e06 3x", "genre": "comic", "nsfw": true, "body": "ソラさん\n\nこちらであげられていたような、オナラで変身ヒロインが苦しめられるコミックをリクエストさせてください。\nhttps://x.com/i/status/1941454140229681294\n\nキャラクターは私のオリジナルキャラ\nエトワール・ウイエです。\nhttps://x.com/i/status/2005225507898687953\n\n内容は以下の通りです。\n※セリフの中の（）の内側はモノローグなので吹き出しの形を変えてください\n①オナラを浴びるウイエ。驚いた表情を見せる。\nオノマトペ「ぶうぅっ！！」\nウイエ「えっ！？」\n\n②両手で鼻を覆ってニオイに苦しむ。\nオノマトペ「もわぁん」\nウイエ「くさいっ！！（鼻が曲がりそうっ！）」\n両目をギュッと瞑った顔\n\n③内股で足をガクガクと震わせるウイエ\nオノマトペ「ぶっ！ぶうぅ！！もわぁっ」\nウイエ「けほっ、こほっ！（ダメッ！息が、できない…）」\n\n④膝を付いてしまうウイエ\nオノマトペ「ずさっ」\nウイエ「あぅっ！（いけない……このままじゃ）」\n\n⑤顔に男の尻が押し付けられる\nオノマトペ「ぎゅむっ」\nウイエ「んむぅっ！？」\n\n⑥そのまますかしっ屁を嗅がされる\nオノマトペ「むっすうぅ」\nウイエ「☠（こんなの……毒、ガス…）」\n※☠は描き文字でお願いします。\n\n⑦たっぷりオナラ漬にされたウイエが倒れる\nオノマトペ「くたあ」\nウイエ「ぅ、ぁ……」\n\n\n以上になります。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@fukuisora/works/538", "thumbnail_src": "https://si.imgix.net/ee1ac7d2/uploads/origins/9aabbed4-4309-4c9e-a431-8457a5b0877f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60f0e98fadcfd6d2c4bbcd168dbbb1f9", "thumbnail_srcset": "https://si.imgix.net/ee1ac7d2/uploads/origins/9aabbed4-4309-4c9e-a431-8457a5b0877f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60f0e98fadcfd6d2c4bbcd168dbbb1f9, https://si.imgix.net/ee1ac7d2/uploads/origins/9aabbed4-4309-4c9e-a431-8457a5b0877f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2daea0c0da976f4715a162f884a0fdd 2x, https://si.imgix.net/ee1ac7d2/uploads/origins/9aabbed4-4309-4c9e-a431-8457a5b0877f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=135e7ba90232a4c50b698fbfc80fdb96 3x", "genre": "comic", "nsfw": true, "body": "櫻井桃華が橘ありすを家に誘って、合意の上で（意識はあるけど話せないし動けない）小さいサイズの人形に一時的に変えて、色々エッチな目に合わせながら一夜を過ごす感じのコミックをお願いします\nありすの小ささに焦点が当たる感じで、台詞っぽいものがあると嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@fukuisora/works/537", "thumbnail_src": "https://si.imgix.net/4122ae1f/uploads/origins/9efab184-dc36-4f6d-a5d8-3c6dce42a0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19462c46049a7345da8cdece8aa5801f", "thumbnail_srcset": "https://si.imgix.net/4122ae1f/uploads/origins/9efab184-dc36-4f6d-a5d8-3c6dce42a0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19462c46049a7345da8cdece8aa5801f, https://si.imgix.net/4122ae1f/uploads/origins/9efab184-dc36-4f6d-a5d8-3c6dce42a0ee?bg=%23fff&