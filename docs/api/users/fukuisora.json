f12-87ee-5dcb8b3ddb1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e116ec995e10e5090cdcad252eb62389", "thumbnail_srcset": "https://si.imgix.net/47ecbbd3/uploads/origins/c19494ba-3f69-4f12-87ee-5dcb8b3ddb1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e116ec995e10e5090cdcad252eb62389, https://si.imgix.net/47ecbbd3/uploads/origins/c19494ba-3f69-4f12-87ee-5dcb8b3ddb1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb86eb2adafc1a0bc9142601111cdc2c 2x, https://si.imgix.net/47ecbbd3/uploads/origins/c19494ba-3f69-4f12-87ee-5dcb8b3ddb1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5065ec1786f08e2504a70ba8be2e8160 3x", "genre": "comic", "nsfw": true, "body": "お世話になっております、今回は和風ソシャゲ「式姫project」より「超かぶきりひめ」とショタをおねがいします。\n\nシチュエーションとしては\nかぶきりひめが着替えている最中にうっかり戸を開けてしまったショタにお仕置きする内容ですが\n以前流行った「次やったらコレ（パイズリ）ですからね？」のように\nパイズリでお仕置きをお願いします。\n\n最後は変化の術でショタが小さくされて全身パイズリで搾られフィニッシュをお願いします。\n和風ゲームが題材なのでショタの衣装も和風なものでお願いします。\n\n以下　設定資料\nhttps://www.shikihime-project.com/unit/0104030101\n「五行覚醒」版を参考にお願いします。\n\nかぶきりひめ\n悪戯好きな物腰の柔らかい狐のお姉さん\n\nhttps://www.shikihime-project.com/unit/0104030101", "created_at": "", "completed_at": ""}, {"path": "/@fukuisora/works/534", "thumbnail_src": "https://si.imgix.net/5736242a/uploads/origins/acf48a6f-0ad7-45ad-849c-95d63406e457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=553f50bdc870068803be01c86952a05a", "thumbnail_srcset": "https://si.imgix.net/5736242a/uploads/origins/acf48a6f-0ad7-45ad-849c-95d63406e457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=553f50bdc870068803be01c86952a05a, https://si.imgix.net/5736242a/uploads/origins/acf48a6f-0ad7-45ad-849c-95d63406e457?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f05103091bd7146e23714ef266ddb50e 2x, https://si.imgix.net/5736242a/uploads/origins/acf48a6f-0ad7-45ad-849c-95d63406e457?bg=%23fff&auto=format%2Ccom