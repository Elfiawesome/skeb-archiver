5e-b96d-89ebaddfc72a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=010545fef9d26050fc36a4e8eb8bda9b 2x, https://si.imgix.net/a5264380/uploads/origins/091b4ad3-efa3-425e-b96d-89ebaddfc72a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b59a2be4751fa886f1bf44ca4d19c876 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@u_br72/works/10", "thumbnail_src": "https://si.imgix.net/86bb6f29/uploads/origins/40f09dd3-7a01-490c-9b68-ac260cff18d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0a3d7a663752cc88e4ee8e72dab06d4", "thumbnail_srcset": "https://si.imgix.net/86bb6f29/uploads/origins/40f09dd3-7a01-490c-9b68-ac260cff18d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0a3d7a663752cc88e4ee8e72dab06d4, https://si.imgix.net/86bb6f29/uploads/origins/40f09dd3-7a01-490c-9b68-ac260cff18d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40e6b67f5e1e244595973333bc626673 2x, https://si.imgix.net/86bb6f29/uploads/origins/40f09dd3-7a01-490c-9b68-ac260cff18d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04b175cb489a3453a1b96b81a0db40c0 3x", "genre": "art", "nsfw": false, "body": "はじめまして。えめ栗と申します。\n先生のイラストが大好きで、閲覧用アカウントからいつも作品を拝見しております。繊細で魅力的な塗り、関係性の描かれ方、美麗な背景など、本当に憧れております……！\n\nそこでこのたびは、創作百合キャラクター二人を先生に描いていただきたいと思い、リクエストを送信させていただきました。\n\n以下、簡単な関係性の説明をささていただきます。\n二人は魔法が存在するファンタジー世界に住む同年の幼馴染で、正反対の性格のためよく喧嘩もしますが、お互い唯一無二の関係です。表出しない感情として、紺髪の女の子は精神的に不安定なところがあり、これ以上縋ってはいけないと思いながら相手に寄りかかってしまうことへの焦りがありつつ安心してしまっています。一方、金髪の女の子は自分に縋ってくる相手に都合良いよなと思いつつも、そうされる相手が自分であることに仄暗い喜びも抱いています。\n\n容姿の資料として、URLを掲載させていただきました。着ている衣服などに絶対的なこだわりはございませんので、ご自由にアレンジ、あるいは変更していただいてもかまいません。\n構図や表情などは先生におまかせさせていただきたく存じますが、距離の近い構図、感情が垣間見える構図ですと幸甚の極みです……！\n\n金額なども含めて不備などございましたらご遠慮なく再送依頼・キャンセルしてください……！　どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dSsENgPCxKLqxGkX7ekNDa6t3-NPPqTy", "created_at": "", "completed_at": ""}, {"path": "/@u_br72/works/9", "thumbnail_src": "https://si.imgix.net/b5e56268/uploads/origins/376d9338-dd47-4805-9c9c-b1f131f6f7e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ed4deb28886be5073f8a8cec8a35690", "thumbnail_srcset": "https://si.imgix.net/b5e56268/uploads/origins/376d9338-dd47-4805-9c9c-b1f131f6f7e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ed4deb28886be5073f8a8cec8a35690, https://si.imgix.net/b5e56268/uploads/origins/376d9338-dd47-4805-9c9c-b1f131f6f7e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e77e230d685f9207cb1988963d191500 2x, https://si.imgix.net/b5e56268/uploads/origins/376d9338-dd47-4805-9c9c-b1f131f6f7e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82572e58926e25aa5b8ce857f4007948 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nイラストを拝見しまして絵のタッチ等気に入りましたので、リクエストしたいと思い、依頼しました。\n可能でしたら宜しくお願い致します。\n\n■キャラ\n八月のシンデレラナインの本庄千景と塚原雫\n\n■シチュエーション\n百合な雰囲気をだしたイラストをお願いします。\n服装は制服で背景は海orひまわり畑でお願いします。\nそれ以外はお任せします。\n\n■参考URL\nhttps://hachinai.com/character/honjo\nhttps://hachinai.com/character/tsukahara\nhttps://drive.google.com/file/d/1ZSJwEbIOxSm7oi-eD3PQK18FrBV-QIbD/view?usp=sharing\nhttps://drive.google.com/file/d/1Fl50zh9a-KZqPM8Rpnn8zYPXWvmrZne8/view?usp=sharing\n\n以上、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@u_br72/works/8", "thumbnail_src": "https://si.imgix.net/4dd47bb1/uploads/origins/85ecb97d-406a-4ac9-9d44-0e2a6545592c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1add227417b680ea30ce011e5f2a1fe3", "thumbnail_srcset": "https://si.imgix.net/4dd47bb1/uploads/origins/85ecb97d-406a-4ac9-9d44-0e2a6545592c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1add227417b680ea30ce011e5f2a1fe3, https://si.imgix.net/4dd47bb1/uploads/origins/85ecb97d-406a-4ac9-9d44-0e2a6545592c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e82d1460abb217b7188605f7d575c4ea 2x, https://si.imgix.net/4dd47bb1/uploads/origins/85ecb97d-406a-4ac9-9d44-0e2a6545592c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7305b08f4bdcaea7b3db06655d16c76 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ビジュアルノベル「SeaBed」のサチコとタカコの写真が欲しいです！二人はレズビアンで、お互いに愛し合っています。\n\nサチコとタカコの参考写真\nhttps://x.com/KiyoyoKusakari/status/1887370249609035988\nhttps://x.com/KiyoyoKusakari/status/1887370360770994205\n\n写真は好きなものでOKです。できればかわいくてロマンチックなものがいいです！服装は着心地のいいものを！私はこだわらない。楽しんで！私は緑と紫の色が好きなので、彼らの目が開いているところが見たいです。ちなみに、サチコは紫の髪の女の子で、かなり真面目で、ほとんど冷静な人です。タカコは緑の髪の女性で、とてもエネルギッシュです！ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@u_br72/works/7", "thumbnail_src": "https://si.imgix.net/296252a3/uploads/origins/00c69ea8-7a51-4180-9f2f-125f1e445cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b38279b4675bfe4308a7986cb8e770ae", "thumbnail_srcset": "https://si.imgix.net/296252a3/uploads/origins/00c69ea8-7a51-4180-9f2f-125f1e445cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b38279b4675bfe4308a7986cb8e770ae, https://si.imgix.net/296252a3/uploads/origins/00c69ea8-7a51-4180-9f2f-125f1e445cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e997072a9df6d295d3c9f30a98da756 2x, https://si.imgix.net/296252a3/uploads/origins/00c69ea8-7a51-4180-9f2f-125f1e445cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89830b507d952beffc6bacd6a68f630d 3x", "genre": "art", "nsfw": false, "body": "先生のイラストが放つオーラが大好きなので、FFXIVのOCの絵をお願いしたいです。\n\n日焼けした肌、毛先がカールしたショートボブヘア、赤い瞳、そばかす、目の下にホクロがあるおてんばな女の子です。最近の2枚のイラストのように上から見下ろすような感じでお願いします。\n\n参考資料では冬物のコートにマフラーを巻いています。全てお任せしますので、好きなように創作してください。\n\nhttps://dri