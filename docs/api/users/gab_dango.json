す。\n\n正面または斜め下からの煽り構図の全身立ち絵で、服は初期の黒レオタードタイプのものです。\n片手を腰に当て、敵女らしくキリっとした表情で、モデルの様な佇まいです。\n妙齢女性の豊満な肉付で、レオタードもお腹周りが露出多めのハイレグ仕様にしてフェロモン満載にして下さい。一方で肩の装飾やマントは重量感を出して、レオタードの露出具合とのギャップを出してほしいです。\nhttps://image01.seesaawiki.jp/v/s/villainess/92bae13949ce6b90.jpg\n\n背景には氷の塊や氷の棘が舞っている様子をお願いします。予算的に厳しければ省いてください。\n\nよろしくお願いします。\n\nhttps://seesaawiki.jp/villainess/d/%a5%a2%a5%eb%a5%b7%a5%aa%a1%bc%a5%cd%a1%ca%cb%e2%cb%a1%b5%b3%bb%ce%a5%ec%a5%a4%a5%a2%a1%bc%a5%b9%a1%cb", "created_at": "", "completed_at": ""}, {"path": "/@gab_dango/works/145", "thumbnail_src": "https://si.imgix.net/2e22be96/uploads/origins/582db82f-a1f6-4372-b644-7c7c6db4268f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ffbba840ac4f702d98470995ca35c71", "thumbnail_srcset": "https://si.imgix.net/2e22be96/uploads/origins/582db82f-a1f6-4372-b644-7c7c6db4268f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ffbba840ac4f702d98470995ca35c71, https://si.imgix.net/2e22be96/uploads/origins/582db82f-a1f6-4372-b644-7c7c6db4268f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b27ddbfd1b201995241b6556b94a8963 2x, https://si.imgix.net/2e22be96/uploads/origins/582db82f-a1f6-4372-b644-7c7c6db4268f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e7d498f68e1a05fb52f331e9fa820a0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gab_dango/works/144", "thumbnail_src": "https://si.imgix.net/86d34990/uploads/origins/76429c2c-c855-4653-bb61-796371fc5246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w