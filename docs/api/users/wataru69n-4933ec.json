20299/uploads/origins/f007a0ab-61e2-4762-9060-762f838c54dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b14ca6a06e8c3111c9a6fee18c170aa 2x, https://si.imgix.net/25420299/uploads/origins/f007a0ab-61e2-4762-9060-762f838c54dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=416623c6abf2ddf1dd3621161d5b8df4 3x", "genre": "art", "nsfw": false, "body": "渉様はじめまして！Sorry for the slow reply, and thanks for your support of my character!\n\nI'm happy to request a cover image for the Radwimpsの曲「なんでもないや」 ( https://www.youtube.com/watch?v=r01cEH34NNc ) for my OC. I will use it on my cover of this song.\n\nOCの設定のリンクが付けられました。ありがとうございます！\n\nhttps://closed-lancer-774.notion.site/7268eac35b264494a98cfaa4c70f8111", "created_at": "", "completed_at": ""}, {"path": "/@wataru69n/works/14", "thumbnail_src": "https://si.imgix.net/c65479fa/uploads/origins/14d4de55-7ae4-41ac-acb5-b20f38f536c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a896dd52dc218da59577e238c3f9383", "thumbnail_srcset": "https://si.imgix.net/c65479fa/uploads/origins/14d4de55-7ae4-41ac-acb5-b20f38f536c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a896dd52dc218da59577e238c3f9383, https://si.imgix.net/c65479fa/uploads/origins/14d4de55-7ae4-41ac-acb5-b20f38f536c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e50bada6a85932c17a315400f0de832 2x, https://si.imgix.net/c65479fa/uploads/origins/14d4de55-7ae4-41ac-acb5-b20f38f536c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=727c20b6feef05e0995d6854e8ef43b5 3x", "genre": "art", "nsfw": false, "body": "はじめまして。【飛天】渉様。\nかほと申します。\nアピールありがとうございます。\n\n私のキャラクターは17歲。身長は154cmのJKです。\nキャラクターの参考画像：\nhttps://drive.google.com/file/d/1HLoVYTMo_bBx_aB5d6ymA7oaMYt5agNH/view?usp=sharing\n\nご自由に描いてください。\nイラストは自分のSNSに使用します。\n宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@wataru69n/works/13", "thumb