=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b83cd5863ab8b3f4f31f2f6ebc9c6162 2x, https://si.imgix.net/8640e40b/uploads/origins/b58c3f33-b043-40df-80d7-cedd0db5d065?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dedaa6486fb9a7b7051ef7b15d804081 3x", "genre": "art", "nsfw": true, "body": "山葉由芽で牛柄のマイクロビキニ姿で着衣セックス後、正常位で外出しされた事後のシチュをお願いします。\n\n・由芽の頭側または頭側の斜め上からのカメラアングルで竿役の腹筋が映る視点\n・正常位から外出しでぶっかけられた後で由芽の体の中央部に沿って精液がかかっている（股間、腹、胸、顔、頭に加えて頭を飛び越えて枕にまでかかっている）\n・由芽は何度もイカされた後でセックスの余韻が抜けておらず、体を仰け反らせてシーツを握りながら、ほおけた表情で口をだらしなく開いてうわ言のように「セックス最高♥」といったセリフを繰り返している。\n・竿役は「はぁ～気持ちよかったねぇ由芽ちゃん」といったことを話しかけているが、全く反応できる状態でない由芽の様子を見て嘲笑するセリフを吐いている。\n・セリフ例はコンセプトをお伝えするためのものなので全面的に作者様のセンスにお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/121", "thumbnail_src": "https://si.imgix.net/190915f3/uploads/origins/27129edf-746d-42af-ad93-7ea8ff1c83f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5b1cf3ef6eca16e9ff00af589104cdc", "thumbnail_srcset": "https://si.imgix.net/190915f3/uploads/origins/27129edf-746d-42af-ad93-7ea8ff1c83f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5b1cf3ef6eca16e9ff00af589104cdc, https://si.imgix.net/190915f3/uploads/origins/27129edf-746d-42af-ad93-7ea8ff1c83f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f30b9cd8d9f5109d7865a9f588e3e05 2x, https://si.imgix.net/190915f3/uploads/origins/27129edf-746d-42af-ad93-7ea8ff1c83f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fbfba269db01c7411396950552b5588 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/120", "thumbnail_src": "https://si.imgix.net/f2453c44/uploads/origins/8b3be263-8bd6-421c-9599-8008109fbb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f685c4a91ec6126396ebfe3e2d2556", "thumbnail_srcset": "https://si.imgix.net/f2453c44/uploads/origins/8b3be263-8bd6-421c-9599-8008109fbb18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f685c4a91ec6126396ebfe3e2d2556, https://si.imgix.net/f2453c44/uploads/origins/8b3be263-8bd6-421c-9599-8008109fbb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59938c696ada6d52985cc785b269f181 2x, https://si.imgix.net/f2453c44/uploads/origins/8b3be263-8bd6-421c-9599-8008109fbb18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17bce24770b7179e153ff0fdc7a0c2eb 3x", "genre": "art", "nsfw": true, "body": "山葉由芽で「牛柄のマイクロビキニ姿で着衣セックスして正常位でゴム射後、その体制のままコンドームの中の精液を飲まされる」シチュをお願いします。\nアサギ3のアスカのシーン（下記URL参照）みたいな感じで。\n\nhttps://drive.google.com/file/d/1RaVp0X6_o0P6nMDF3cSJQPOOmWJCaMTN/view\n\nできれば下記差分欲しいです。\n・挿入前見せ槍\n竿役がこれから挿入するゴム付きペニスを股間～腹に当てている（へそまで届くデカチン）\n由芽は竿を見つめて不安そうな表情\n\n・挿入、行為中\n軽く感じてる表情\n\n・射精、絶頂\nオホ顔を晒してアクメっている\n\n・事後直後、ゴム付きペニス引き抜き\nセックス終了後、竿役がペニスを引き抜いた状態、竿を脈打たせながら大量に精液を吐き出したコンドームを震わせている\n由芽は、セックスの余韻でまだ絶頂が継続している様子で、だらしないオホ顔のまま\n\n・強制ゴム精飲\n竿役がゴムを外して由芽の口の中に中身を注いでいる。\n由芽はセックスの余韻が完全に抜けて我に返った状態、涙を流しながら睨んだ表情で精液を舌で受け止めている。\n\n・飲み干し\nゴムがほぼからになった状態で吸っている\n\n・ごっくん後\n飲み干して空になった口内を見せている\n\n差分指定が多い場合は適宜カットください\n4つ目の事後直後と5つ目の飲み始めの差分は必ず欲しいです", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/119", "thumbnail_src": "https://si.imgix.net/72b8bc96/uploads/origins/070c0216-868e-43f0-8185-a614f7def02d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2be2f243c656e51bc21b50f5549c602", "thumbnail_srcset": "https://si.imgix.net/72b8bc96/uploads/origins/070c0216-868e-43f0-8185-a614f7def02d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2be2f243c656e51bc21b50f5549c602, https://si.imgix.net/72b8bc96/uploads/origins/070c0216-868e-43f0-8185-a614f7def02d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64c31553eb9427898aea3d51e6785e09 2x, https://si.imgix.net/72b8bc96/uploads/origins/070c0216-868e-43f0-8185-a614f7def02d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e7283fd05376bf66e9f2434346b9e06 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/118", "thumbnail_src": "https://si.imgix.net/8b2d7bbc/uploads/origins/ec2164fd-9f01-433f-b8ee-2ba7cd857cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=687f221311722183aa7919fc053bef7c", "thumbnail_srcset": "https://si.imgix.net/8b2d7bbc/uploads/origins/ec2164fd-9f01-433f-b8ee-2ba7cd857cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=687f221311722183aa7919fc053bef7c, https://si.imgix.net/8b2d7bbc/uploads/origins/ec2164fd-9f01-433f-b8ee-2ba7cd857cda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb80c15bb642f518cf21db41e2914949 2x, https://si.imgix.net/8b2d7bbc/uploads/origins/ec2164fd-9f01-433f-b8ee-2ba7cd857cda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a59bd4094580128fa05cd2ad6903628 3x", "genre": "art", "nsfw": true, "body": "永雪氷織 で下記作品のように添い寝手コキ後に大量発射され竿役の胸元についた精液を舐めとっているシチュをお願いします。\n\nhttps://skeb.jp/@Hachira_0901/works/75\n・主観視点で睨みながら舐め取っている\n・片脚を竿役の脚に乗せており竿役の体に体重半分くらいを預けて乗っている状態\n・射精時はあちこちに撒き散らしながら発射した様子で、女性の体や頭や顔にところどころ精液がついている（そこまで大量ではなくさりげない程度）\n\nまたできれば以下差分が欲しいです\n・射精後睨み\n・睨みながら舐めとり（舌に精液が乗ってる）\n・胸元の精液が綺麗に舐め取られ、口内に溜めた精液を見せている状態\n・ごっくん\n・目に涙を溜めながら空になった口内を見せる", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/117", "thumbnail_src": "https://si.imgix.net/82b639c8/uploads/origins/82ce39e4-6489-4044-8dc6-89bff60e618b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d85c1bd7ec1b836df8bf471db67a506", "thumbnail_srcset": "https://si.imgix.net/82b639c8/uploads/origins/82ce39e4-6489-4044-8dc6-89bff60e618b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d85c1bd7ec1b836df8bf471db67a506, https://si.imgix.net/82b639c8/uploads/origins/82ce39e4-6489-4044-8dc6-89bff60e618b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd87e14143320171c71ac34f5f65c02c 2x, https://si.imgix.net/82b639c8/uploads/origins/82ce39e4-6489-4044-8dc6-89bff60e618b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ce32c42341f19d5967c50b611d6668d 3x", "genre": "art", "nsfw": true, "body": "リクエスト送信失礼します。前回入華を描いていただきありがとうございます。今回は天城ブリリアントパークの千斗いすずで前回同様競泳水着コキでお願いします。背景やシチュエーションは特に希望は無しで 今回も前回同様に差分は射精後までと裸バージョンを入れていただけたら嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/116", "thumbnail_src": "https://si.imgix.net/0f029513/uploads/origins/7841b1f2-8502-4c45-8357-7d21053760d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6868925d6947c540a092f22a551b5531", "thumbnail_srcset": "https://si.imgix.net/0f029513/uploads/origins/7841b1f2-8502-4c45-8357-7d21053760d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6868925d6947c540a092f22a551b5531, https://si.imgix.net/0f029513/uploads/origins/7841b1f2-8502-4c45-8357-7d21053760d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=adc6cdb4b1da6e71334b23c2f6e0f4c6 2x, https://si.imgix.net/0f029513/uploads/origins/7841b1f2-8502-4c45-8357-7d21053760d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13d6835481733535a7a857ee4219c761 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/115", "thumbnail_src": "https://si.imgix.net/c392b57f/uploads/origins/62fa958e-b325-4ed0-bcd7-8d0d53d05d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905f54eaeb805cdd97bdacff1e661d68", "thumbnail_srcset": "https://si.imgix.net/c392b57f/uploads/origins/62fa958e-b325-4ed0-bcd7-8d0d53d05d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=905f54eaeb805cdd97bdacff1e661d68, https://si.imgix.net/c392b57f/uploads/origins/62fa958e-b325-4ed0-bcd7-8d0d53d05d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bd9b631d6dde831b0abf46b39374de4 2x, https://si.imgix.net/c392b57f/uploads/origins/62fa958e-b325-4ed0-bcd7-8d0d53d05d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f86bfe39b3d8240237c0bee01a71e687 3x", "genre": "art", "nsfw": true, "body": "山葉由芽がラブホでマイクロビキニ姿でパイズリして、1mくらい噴き上がる凄まじい射精をされてぶっかけられるシチュをお願いします。\n4差分ほしいです\n・パイズリ序盤、敵意ある表情（不本意にやらされている雰囲気）\n・パイズリ終盤、竿役のイキそうな反応を感じ取って少し強気な表情に\n・発射、目の前で勢いよく1mくらい噴き上がるものを見て驚いた表情（まだ体にかかっていない）\n・頭、顔、胸元までベトベトになり困った表情（顔まで飛ばされるとは思っていない様子で困惑顔）", "created_at": "", "completed_at": ""}, {"path": "/@Hachira_0901/works/114", "thumbnail_src": "https://si.imgix.net/1a9528ee/uploads/origins/0d8a3b6a-056e-4eb2-b841-338c428bbc25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=