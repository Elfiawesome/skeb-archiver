61+00:00"}, {"amount": 6000, "recorded_at": "2026-03-03T23:18:02.416388+00:00"}, {"amount": 11000, "recorded_at": "2026-03-04T14:02:44.150042+00:00"}, {"amount": 6000, "recorded_at": "2026-03-05T05:50:51.004364+00:00"}, {"amount": 8000, "recorded_at": "2026-03-05T21:51:50.481607+00:00"}]}, "current_prices": {"art": 8000}, "price_range": {"art": {"min": 5000, "max": 11000}}, "links": [{"label": "Twitter", "url": "https://x.com/motidori_46", "name": "motidori_46"}, {"label": "Website", "url": "https://marshmallow-qa.com/motidori_46", "name": ""}], "flags": {"from_archive": true}, "works": [{"path": "/@motidori_46/works/217", "thumbnail_src": "https://si.imgix.net/884c8ad9/uploads/origins/621a9e50-d39b-4692-92e1-559caf416279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bbe32a2382625d7705dcd780ac2447", "thumbnail_srcset": "https://si.imgix.net/884c8ad9/uploads/origins/621a9e50-d39b-4692-92e1-559caf416279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6bbe32a2382625d7705dcd780ac2447, https://si.imgix.net/884c8ad9/uploads/origins/621a9e50-d39b-4692-92e1-559caf416279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eed77f75fdce45b0d648d41545ddd6f7 2x, https://si.imgix.net/884c8ad9/uploads/origins/621a9e50-d39b-4692-92e1-559caf416279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89f7a0205859cf01923621eb5e8ff8a0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの美しい絵が大好きです！\nエリダヌス座という星座と川にインスパイアされています。\n\nエリダンは25歳の占い師で、月・川・星の魔法と手相を使う。\n実存的危機を抱えた人々を助け、セラピーを行う。\n\n性格的には、派手で穏やか。王宮のちょっとした道化師、あるいはミステリアスでエキセントリックな、とても魅力的な人助けをする男という見方が多い。\nしかし、彼を欺瞞に満ちた人物とみなす噂もあり、\"ブラックホール \"というあだ名までつけられている。\n\nバックストーリー彼は密かにファエトンであるが、ギリシャ神話（戦車と転落）に反して、代わりに酔っぱらって演説をした。屈辱的な扱いを受け、引きずられた後、彼は号泣し、誰も自分に同情していないことに気づいて動揺し、川に入る。彼は不思議な力を得て、自分を変えた。\n\nご清聴ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1VRb-ILoM5jrgsT2lf-ARbt9kijux8PFD?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/216", "thumbnail_src": "https://si.imgix.net/198d5c8a/uploads/origins/1c9b6c88-62c2-4c3f-8c91-fb87a86f4c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30200cefc7bd1ff075c8b29106e578b7", "thumbnail_srcset": "https://si.imgix.net/198d5c8a/uploads/origins/1c9b6c88-62c2-4c3f-8c91-fb87a86f4c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30200cefc7bd1ff075c8b29106e578b7, https://si.imgix.net/198d5c8a/uploads/origins/1c9b6c88-62c2-4c3f-8c91-fb87a86f4c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bac779463fddfdea7a6742cceb5e932 2x, https://si.imgix.net/198d5c8a/uploads/origins/1c9b6c88-62c2-4c3f-8c91-fb87a86f4c2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a9c0060709c97c263c7080f56a8c5e6 3x", "genre": "art", "nsfw": false, "body": "餠鳥先生はじめまして！\n先生の作品のダークな空気感がとても気にいているので、宜しければうちの子たちの久遠くんと麗王くんを描いて頂けますか。二人はヴィジュアル系のアーティスト、そしてライバルです。\n\n■キャラクター：\nhttps://wafanic.notion.site/JP-15634701bdde808da886e8d9d68f0f74\n①KUON YAMIUCHI（闇内 久遠）・25歳・186cm\n＊上から下まで暗い茶色で黒くなるのグラデーションの髪\n②REIOU SHIROGANE（白銀 麗王）・22歳・181cm\n＊白黒の髪\n久遠くんと麗王くんについて（デザインの詳細、性格、二人の関係...など）詳しくはURLをご覧ください。\n\n※Note：久遠くんは麗王くんよりも少し筋肉質です。また、麗王くんの肌の色は久遠くんよりもっと白い。\n\n■その他\nイラストのテーマ、ポーズ、構図、背景など先生にお任せします。\n宛名とキャラ単体をpsdでon/offできると助かります。\nもし、先生を不快にさせるような依頼であれば、遠慮なくキャンセルしてもかまいません。金額が足りない場合はアピールも構いません。よろしくお願い致します。\n\nhttps://wafanic.notion.site/JP-15634701bdde808da886e8d9d68f0f74", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/215", "thumbnail_src": "https://si.imgix.net/fa8f9457/uploads/origins/1e0d9755-999c-4d08-8d31-1426f5e7f7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6591578bb9fe39611f87557c70d2494", "thumbnail_srcset": "https://si.imgix.net/fa8f9457/uploads/origins/1e0d9755-999c-4d08-8d31-1426f5e7f7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6591578bb9fe39611f87557c70d2494, https://si.imgix.net/fa8f9457/uploads/origins/1e0d9755-999c-4d08-8d31-1426f5e7f7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d4cfa0af796e52d0dc7cbd849b93729 2x, https://si.imgix.net/fa8f9457/uploads/origins/1e0d9755-999c-4d08-8d31-1426f5e7f7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1217ff5f80f4098807af4bf13de9c3d6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/214", "thumbnail_src": "https://si.imgix.net/b5f1da3a/uploads/origins/351d9cb4-a537-4956-9920-1a31fce69186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e65c451fa82a5949abea27a4c11ec0", "thumbnail_srcset": "https://si.imgix.net/b5f1da3a/uploads/origins/351d9cb4-a537-4956-9920-1a31fce69186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e65c451fa82a5949abea27a4c11ec0, https://si.imgix.net/b5f1da3a/uploads/origins/351d9cb4-a537-4956-9920-1a31fce69186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e32e4598ccb22de3ed8720a3e28c2213 2x, https://si.imgix.net/b5f1da3a/uploads/origins/351d9cb4-a537-4956-9920-1a31fce69186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=046558224bd99812ea4badb3384e76d8 3x", "genre": "art", "nsfw": false, "body": "餠鳥先生、初めまして。突然のご連絡失礼いたします。\n\n私は先生のイラストに大変魅了され、その華やかさと独特の雰囲気に憧れて、ご依頼をお願いしたくご連絡いたしました。\n\nもし可能でしたら、私のOCを描いていただけませんでしょうか？\n彼は中性的な風貌の男性で、軍人という設定です。\n性格はかなり悪く、常に冷酷で自己中心的です。\n\n具体的な構図や背景は先生の自由に発想していただいて構いません。\n衣装は、ご参考までにリンク先のデザインから自由にお選びいただいても構いません。\n\nぜひこのご依頼をお引き受けいただけましたら嬉しく思います。\n最後までお読みいただき、誠にありがとうございました。🫶🫶🫶\nhttps://drive.google.com/drive/folders/1MFCmKWoWxGbEBRBg4OQq7QiVoaken-iw", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/213", "thumbnail_src": "https://si.imgix.net/40be0f37/uploads/origins/1ee04b9f-00a4-4d65-b21c-0f2b23036a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8415005d2c8faec61b663a5f1e270ab", "thumbnail_srcset": "https://si.imgix.net/40be0f37/uploads/origins/1ee04b9f-00a4-4d65-b21c-0f2b23036a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8415005d2c8faec61b663a5f1e270ab, https://si.imgix.net/40be0f37/uploads/origins/1ee04b9f-00a4-4d65-b21c-0f2b23036a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57ca51583bf705d7f4b4b1cb3ba04e2a 2x, https://si.imgix.net/40be0f37/uploads/origins/1ee04b9f-00a4-4d65-b21c-0f2b23036a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d853b9182ddaa29cbc92ad609fa4cc3 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生！先生の素敵なイラストが大好きです。僕と友達のOCをリクエストしてもいいですか？  \n\n血や危険な構図でもOKです！どんな格好でもOKです！構図はお任せしますので、自由に描いてください！\n\n設定ダークファンタジー。魔法の才能を持つ魔法使いが支配する世界。彼らは呪文を刻むことで何でも可能にすることで知られている。ひっそりと、魔法の才能を持たない人々が科学の名の下に同様の奇跡を生み出していた。\n\nREN｜170cm｜黒衣の魔法使い\n- 虚無的で皮肉屋、感情的に世間から切り離されている。いつも無表情。しかし、微笑むときは恨みと皮肉に満ちた意地の悪い笑みを浮かべる。\n- 自由を渇望するスリルシーカー。\n- より強力な魔女のパッパーの一員。彼の筋肉と骨には呪文が刻まれ、本人の意思に反して永遠に魔法を研究するよう呪われている。捕らえられた科学者を監視し、人体実験に利用するよう命じられる。\n\nヴァニス｜170cm｜白衣の科学者\n- 冷静で謎めいた雰囲気を持ち、いつも生気のない微笑みを浮かべている。暗い研究室の外での自由を望み、しばしば魔法使いをからかう。\n- 不死身で、彼に刻まれた魔法はすべて消え去る。魔法が効かないため、魔女にとっては危険な存在である。\n- 科学者であり、科学者の不死の研究を生き延びた唯一の奇跡の被験者。彼は意図的に魔女に捕らえられ、その体を彼らの研究に提供し、終わりを見つける。\n\n関係：曖昧。親しい他人。友人ではないが、お互いの存在が心地よい。相反する存在であるにもかかわらず、彼らは暗いユーモアを共有し、さりげなく理想を語り合う。二人は研究パートナーであると同時に実験台でもあり、どんな危険や興味にも挑戦する正気ではない。どうぞ自由に解釈してください！\n\nご検討ありがとうございました！\n \nhttps://drive.google.com/drive/folders/1-3VT5FeyIjgmpmSwBMR9nSZSHp612CRA", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/212",