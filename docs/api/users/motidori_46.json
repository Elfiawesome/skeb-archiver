4ad8-b06f-a63d0f84fc6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6ce8625a63eb0861ef1f32283b41425 2x, https://si.imgix.net/094e930f/uploads/origins/d9bda0da-9e98-4ad8-b06f-a63d0f84fc6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=935e29e31d0ce3197462e5125a2d1245 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が大好きです！本当に感動しました。私のOCを描いていただけませんか？どちらか、または両方描いてください。\n\n「Opheliel」は20代のエレガントな紳士に見えます。実はクトゥルフ神話に登場する「古き者」という名のクリーチャーである。人間の姿に変身し、娯楽や旅行のために人間社会に潜んでいる。覆われている右目は紫色で、#9350FFくらい。\n\n妹のふりをした従者を連れていることが多く、「オフィーリア」と名付けている。彼女の正体はクトゥルフ神話に登場する \"ショゴス \"と呼ばれるクリーチャーで、古きものの手下である。オフェリエルから渡された本を熱心に読み、黙っていることが多いので、交流はオフェリエルが始めることが多い。オフェリエルは彼女を可愛いペットのように見ており、他のショゴスよりも気に入っている。\n\nポーズなどは自由です！\nもし問題があれば、再送させてください。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1SkxwNRGb3TouBQcbpEYRkr3S7CfiFkn7?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/204", "thumbnail_src": "https://si.imgix.net/9b684563/uploads/origins/d096773c-cb68-45ef-a0a8-a61fd8a62be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=553f95095c9ae9ab563a793a25e79b11", "thumbnail_srcset": "https://si.imgix.net/9b684563/uploads/origins/d096773c-cb68-45ef-a0a8-a61fd8a62be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=553f95095c9ae9ab563a793a25e79b11, https://si.imgix.net/9b684563/uploads/origins/d096773c-cb68-45ef-a0a8-a61fd8a62be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e4cfaeb29142372fa45cfa867f378ee 2x, https://si.imgix.net/9b684563/uploads/origins/d096773c-cb68-45ef-a0a8-a61fd8a62be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e50f655acfd6433dd8618d61de5d0b7e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お忙しいところ大変申し訳ありません！今回の依頼ですが、可能であれば私のocたちのインタラクティブなイラストを描いていただきたいです↓以下、彼らの性格や要望を簡単に説明します。\n\nどちらも20世紀が舞台です\n(下）コンスタンティン：24歳、金髪、赤い瞳孔、182cm、長身痩躯、エレガントな風貌。コンスタンチーヌは貴族で、家はとても裕福、両親と兄は彼をとても愛している。貴族気質でプライドが高く、自尊心も高いが、非常に頭が良く優秀で、人に優しく接するが、人に距離を感じさせることもある。大学を早々に卒業し、文学の道に進んだ彼は、文筆業でもジャーナリズムでも中心的な存在であり、その頭の良さから警察から事件の捜査協力を依頼されることもある。ヴィラカスに憧れ、その憧れは後に秘密を共有したことで好意を抱くようになる。\n\n(上）ヴィラカス：21歳、186cm、茶色の少しカールした髪、緑の目、標準的な体格、穏やかで礼儀正しい。ヴィラカスは裕福な家庭の平民で、コンスタンティンの助手である。コンスタンティンに憧れ、相手の通信社に応募に来たところ、アシスタントに抜擢された。コンスタンチンの日常生活や生活の世話をし、とても従順で、忠犬のような性格に見え、コンスタンチンをとても頼りにしている。\n\nどのようなコスチュームで描くかは自由です！(西洋ファンタジーの設定が好きなら、写真28のコスチュームを選んでもいい！もちろん、他のコスチュームもあります！)\n\n金額に満たない場合は、再度リクエストを送っていただけると助かります！ご面倒であれば、キャンセルしていただいても構いません。この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/203", "thumbnail_src": "https://si.imgix.net/7ac868c7/uploads/origins/ae2a7f8a-e68f-4a6d-a6de-130d0229eebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1e7f27152c11b0a758fad5ce85ab357", "thumbnail_srcset": "https://si.imgix.net/7ac868c7/uploads/origins/ae2a7f8a-e68f-4a6d-a6de-130d0229eebd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1e7f27152c11b0a758fad5ce85ab357, https://si.imgix.net/7ac868c7/uploads/origins/ae2a7f8a-e68f-4a6d-a6de-130d0229eebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f554fa21132ff076dd91818deb8ec244 2x, https://si.imgix.net/7ac868c7/uploads/origins/ae2a7f8a-e68f-4a6d-a6de-130d0229eebd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2faf879da5be203b8f5327062e6ec709 3x", "genre": "art", "nsfw": false, "body": "餠鳥様。\nいつもお世話になっております。\n早速依頼をさせて頂きます。\n\n御城プロジェクトのアーケシュフース城をお願い致します。\n\n衣装は公式のものでも、それ以外のものでも差し支えありません。\n構図はお任せ致します。\n\nご検討宜しくお願い致します。\n\nhttps://imgur.com/a/Cwhbvor", "created_at": "", "completed_at": ""}, {"path": "/@motidori_46/works/202", "thumbnail_src": "https://si.imgix.net/a3ccedd4/uploads/origins/c43062a9-a92b-4719-afc7-df76b0edf72a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=2