Bの絹の唾に絡め取られ、地面に押さえつけられるシーンから始まる。[2-1、2-2参照）。\nそしてBはAを上から少しずつ食べ始める。\n最後には、Aは絹糸で覆われ、Bの体の中で縛られる。2-4、2-5参照。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1pVGZYGBzb2bMLfB9J4ejN8ue_Q05HoM2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@WoL0YpqZDW8ZsEO/works/423", "thumbnail_src": "https://si.imgix.net/1dba4b49/uploads/origins/11f96c76-d052-43c9-b531-b9f503011064?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=127e9887f8760687921dd91b57d7ae66", "thumbnail_srcset": "https://si.imgix.net/1dba4b49/uploads/origins/11f96c76-d052-43c9-b531-b9f503011064?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=127e9887f8760687921dd91b57d7ae66, https://si.imgix.net/1dba4b49/uploads/origins/11f96c76-d052-43c9-b531-b9f503011064?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e0f7bb7197072f1aa6a376b5cfec1bd 2x, https://si.imgix.net/1dba4b49/uploads/origins/11f96c76-d052-43c9-b531-b9f503011064?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5e9e364476046d822255b28f6bc9d4e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@WoL0YpqZDW8ZsEO/works/422", "thumbnail_src": "https://si.imgix.net/82570532/uploads/origins/e9eb9273-f1ba-45b7-a7bb-6cd53e54cb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=398548a900ff62d005d685f1aef12346", "thumbnail_srcset": "https://si.imgix.net/82570532/uploads/origins/e9eb9273-f1ba-45b7-a7bb-6cd53e54cb38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=398548a900ff62d