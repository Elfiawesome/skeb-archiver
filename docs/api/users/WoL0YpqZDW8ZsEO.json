3%83%AC\n\nシーン\n 1触手に全裸でX字で拘束されている。\n 2黒い光線が胸に当たり苦しそうに悲鳴をあげている。\n 3ピュアな心が抜き取られ虚な目でぐったりしている。\n\nポーズは前回と同じように触手にX字で拘束されいる状態 \nアングルは正面からで頭から膝上まで収まるようにお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@WoL0YpqZDW8ZsEO/works/410", "thumbnail_src": "https://si.imgix.net/0912ca6f/uploads/origins/e1c7b619-e6aa-4a56-bfa9-8bbe46de1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47fbf57f02f2ba6a8dd7690d6018666f", "thumbnail_srcset": "https://si.imgix.net/0912ca6f/uploads/origins/e1c7b619-e6aa-4a56-bfa9-8bbe46de1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=47fbf57f02f2ba6a8dd7690d6018666f, https://si.imgix.net/0912ca6f/uploads/origins/e1c7b619-e6aa-4a56-bfa9-8bbe46de1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c408f76e339d11a2f797b43e5cc4072f 2x, https://si.imgix.net/0912ca6f/uploads/origins/e1c7b619-e6aa-4a56-bfa9-8bbe46de1b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91eaf5b11c6243fef8cee17ffceb62cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@WoL0YpqZDW8ZsEO/works/409", "thumbnail_src": "https://si.imgix.net/2143c1a5/uploads/origins/45ef4001-f13a-4bb3-b72c-fffaf98d9f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f3c5ad8b9c21bd3a8f911f006102e33", "thumbnail_srcset": "https://si.imgix.net/2143c1a5/uploads/origins/45ef4001-f13a-4bb3-b72c-fffaf98d9f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f3c5ad8b9c21bd3a8f911f006102e33, https://si.imgix.net/2143c1a5/u