format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d91e3206b07a5c99a3aba3462860cab 2x, https://si.imgix.net/fe8570d1/uploads/origins/06f424be-2d60-4da9-b46d-4b5fb59d2af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c80cf0070235f04fcbad1db9fec65f8 3x", "genre": "art", "nsfw": false, "body": "平素よりお世話になっております。\n募集を拝見し、依頼を送らせていただきます。\n\n遊戯王OCGよりM∀LICE＜Q＞WHITE BINDERを、遊戯王ラッシュデュエルのP・M(プラズマティックモデル)として描いて頂けないでしょうか。\nコラボ商品としての位置付けで、P・M同様可動の為の関節が各所に備えられています。\n造形面で困難と判断したパーツ・ディティールは省いていただいて構いません。\n\n以上、ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@uktnnthmdbpn/works/25", "thumbnail_src": "https://si.imgix.net/9fa3ca79/uploads/origins/607ede84-1b14-4af7-82b3-e9b1202bd0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=817124912164b8d5f21e6105ba3bbde4", "thumbnail_srcset": "https://si.imgix.net/9fa3ca79/uploads/origins/607ede84-1b14-4af7-82b3-e9b1202bd0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=817124912164b8d5f21e6105ba3bbde4, https://si.imgix.net/9fa3ca79/uploads/origins/607ede84-1b14-4af7-82b3-e9b1202bd0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=800e63b58e7c01a8ccd801677f7c0c7b 2x, https://si.imgix.net/9fa3ca79/uploads/origins/607ede84-1b14-4af7-82b3-e9b1202bd0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23ca46daaa8083bfd3ed18e97db241df 3x", "genre": "art", "nsfw": false, "body": "大掃除の後自分もちょっと埃っぽくなってしまったので\n布巾やらエアダスターやらで自分を掃除するナクセさんをお願いします", "created_at": "", "completed_at": ""}, {"path": "/@uktnnthmdbpn/works/24", "thumbnail_src": "https://si.imgix.net/86e7d380/uploads/origins/0c382965-f79a-415f-b73a-6c50305e98be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1de18a03a43bfa7c9482081d0832f6", "thumbnail_srcset": "https://si.imgix.net/86e7d380/uploads/origins/0c382965-f79a-415f-b73a-6c50305e98be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1de18a03a43bfa7c9482081d0832f6, https://si.imgix.net/86e7d380/uploads/origins/0c382965-f79a-415f-b73a-6c50305e98be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e43ccb8a312db8550d4557451422d0c0 2x, https://si.imgix.net/86e7d380/uploads/origins/0c382965-f79a-415f-b73a-6c50305e98be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e60047cd54061a21aec481df76dad57 3x", "genre": "art", "nsfw": true, "body": "初めまして。Dredge the Depthのニルナリヤ＝クナリちゃんのキャラクターデザインに一目惚れ致しまして、是非とも私好みのシチュエーションでセンシティブな目に遭うクナリちゃんが見たいと思いリクエストさせていただきました\nニッチな内容で大変恐縮なのですが、クナリちゃんがくすぐられて笑っているイラストを描いていただくことは可能でしょうか？\nもし可能でしたら、以下の内容で描いていただけますと幸いです\n\n【シチュエーション】\nとある廃屋を探索中、壁に掛かっている少女の肖像画を調べようと近づいたところ、いきなり肖像画がひとりでに動き出しクナリちゃんを絵画の中に引きずり込もうと襲い掛かって来た！といった感じでピンチになっている場面をイメージして描いていただければと思います\n\n【構図】\n・クナリちゃんは既に太腿のあたりまで絵画に引きずり込まれており、まだ自由の利く両手で額縁の上縁を掴んで、これ以上取り込まれるわけにはいかないと必死に抗っている\n・額縁の上縁は少し高い位置にあり、クナリちゃんは両手を掲げてバンザイするかのような姿勢になってしまう\n・すると肖像の少女が絵画の中から出てきて、無防備に曝け出されたクナリちゃんの両腋をくすぐって弄び、額縁から手を放させようとする\n・肖像の少女の外見はクナリちゃんと同年代か少し幼いぐらいの見た目で描いていただければと思います。衣装、髪型、顔立ち等のデザインはお任せ致します\n\n\n以上の内容でお願い致します\n細かな指定が多く大変恐縮でございますが、何卒ご一考いただけますと幸いです", "created_at": "", "completed_at": ""}, {"path": "/@uktnnthmdbpn/works/23", "thumbnail_src": "https://si.imgix.net/90070d55/uploads/origins/151f31d4-bba2-45ee-a339-384109544698?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6647609c7689d4c2a93ffff4ae62341", "thumbnail_srcset": "https://si.imgix.net/90070d55/uploads/origins/151f31d4-bba2-45ee-a339-384109544698?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6647609c7689d4c2a93ffff4ae62341, https://si.imgix.net/90070d55/uploads/origins/151f31d4-bba2-45ee-a339-384109544698?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a7d6b23e825351c1c89c3677765b4dd 2x, https://si.imgix.net/90070d55/uploads/origins/151f31d4-bba2-45ee-a339-384109544698?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=