4db2-8e04-3ace8a593fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2819160d53f0a4a406a2bd14ba503948", "thumbnail_srcset": "https://si.imgix.net/4d379025/uploads/origins/482f5a1c-db69-4db2-8e04-3ace8a593fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2819160d53f0a4a406a2bd14ba503948, https://si.imgix.net/4d379025/uploads/origins/482f5a1c-db69-4db2-8e04-3ace8a593fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=019b5c6349b53e61844c27b03af1f86a 2x, https://si.imgix.net/4d379025/uploads/origins/482f5a1c-db69-4db2-8e04-3ace8a593fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2449dd2a5c9f9c6f11e7f2973c7f27c0 3x", "genre": "art", "nsfw": false, "body": "オフィーリアを描いてくれてありがとう。\n\n可能であれば、2人のキャラクターを戦わせたいのですが。\n\n最初のキャラクターはオフィーリアという悪魔です。\n\nオフィーリアの参考文献\n\nhttps://files.catbox.moe/db4u3x.png\nhttps://files.catbox.moe/lkasy1.png\n\nオフィーリアは誇り高く、力強い悪魔であり、非常に自信家で自己中心的である。  \n\nオフィーリアは暗黒魔法と悪魔魔法を使って戦うが、肉体的にも強い。\n\n2人目のキャラクターは、ライズという名のドラゴンだ。\n\nライズの参考文献\n\nhttps://files.catbox.moe/yu8lv7.png\nhttps://files.catbox.moe/u32rxi.png\n\nRhaizeは狡猾で狡猾な性格をしている。彼女は肉体的にも魔法的にも有能なトリックスターだ。青やオレンジの炎を操ることができる。\n\n身長の参考: https://files.catbox.moe/l544hm.png\n\n激しく互角に戦う二人を描いてほしいが、構図は自由にしてほしい", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/14", "thumbnail_src": "https://si.imgix.net/cb2091de/uploads/origins/3217adb5-6cde-4f29-8557-50edfcf69072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=107c191f72641d418792353add2aa6ec", "thumbnail_srcset": "https://si.imgix.net/cb2091de/uploads/origins/3217adb5-6cde-4f29-8557-50edfcf69072?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=107c191f72641d418792353add2aa6ec, https://si.imgix.net/cb2091de/uploads/origins/3217adb5-6cde-4f29-8557-50edfcf69072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7675cc586dea3c0218abb67237831451 2x, https://si.imgix.net/cb2091de/uploads/origins/3217adb5-6cde-4f29-8557-50edfcf69072?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7dbe22ebccff9c97cb5d775ee039959 3x", "genre": "art", "nsfw": false, "body": "オフィーリアという悪魔のキャラクターをリクエストしたいんだ。\n\nオフィーリアの参考文献\n\nhttps://imgchest.com/p/ej7m85qxjyd\n\nオフィーリアは誇り高く強力な悪魔で、非常に自信家で自己中心的である。オフィーリアはまた、暗黒魔術と悪魔魔術の使い手で、彼女を崇拝するカルト集団を持っている。\n\nできれば戦闘シーンで勝利する彼女を見たい。\n\nオフィーリアは極めて強力な悪魔で、暗黒魔術や悪魔的魔術を使う\n\n彼女が倒した相手は、フード付きのローブを着た教会からの刺客である。暗殺者の顔は見えない\n\nオフィーリアは背が低いので、両者の身長差はかなり大きい。\n\nhttps://imgchest.com/p/ne7bqjbwk75\n\n暗殺者は床に倒れ、疲れきっている\n\nオフィーリアは暗殺者の顔を手でつかみ、相手を仕留めるために闇の魔法をかけ始めた。\n\nオフィーリアは倒した相手をほくそ笑んでいるように見える。彼女のプライドとパワーが存分に発揮されている。おそらくニヤニヤと、あるいは狂ったような笑いを浮かべているのだろう。\n\nご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/13", "thumbnail_src": "https://si.imgix.net/ecce783a/uploads/origins/24b25447-3466-4e9d-9909-8e0355909d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a78d480ab17d977e4d6a812f1410114d", "thumbnail_srcset": "https://si.imgix.net/ecce783a/uploads/origins/24b25447-3466-4e9d-9909-8e0355909d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a78d480ab17d977e4d6a812f1410114d, https://si.imgix.net/ecce783a/uploads/origins/24b25447-3466-4e9d-9909-8e0355909d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bca148d57bad1f17f860108de05d31f 2x, https://si.imgix.net/ecce783a/uploads/origins/24b25447-3466-4e9d-9909-8e0355909d1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d11f5263c75372547ba677d43672290 3x", "genre": "art", "nsfw": false, "body": "こんにちは！今回はニンジャスレイヤーA oMのマスラダ・カイにリンバスカンパニーのEGO:凶弾に着る絵でお願いします！\nポーズは片手でペンダントを掴む、炎に半分の顔を包み込む、残った目の中に無限のような悲しみと憎しみが炎のように燃えている。\n参考資料はこちら: https://imgur.com/a/N2oxASr\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/12", "thumbnail_src": "https://si.imgix.net/7238bcad/uploads/origins/16cba747-cba1-4731-8ee6-f0472f1db5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65e9ce8c2335169156039f6f5de2403", "thumbnail_srcset": "https://si.imgix.net/7238bcad/uploads/origins/16cba747-cba1-4731-8ee6-f0472f1db5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65e9ce8c2335169156039f6f5de2403, https://si.imgix.net/7238bcad/uploads/origins/16cba747-cba1-4731-8ee6-f0472f1db5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ceac1a752de3031b172213e60c4158fe 2x, https://si.imgix.net/7238bcad/uploads/origins/16cba747-cba1-4731-8ee6-f0472f1db5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77060e55820e38e4b4a0980cf33af845 3x", "genre": "art", "nsfw": false, "body": "はじめまして、プロムン作品の幻想体を絡めた素敵なイラストに感動させてもらっています！\n\nプロムン作品の配信をされている個人VTuber「六原小森」さんのイラストをお願いします。\n六原小森さんの見た目、三面図などはツイッターの固定ツイートや画像欄などをご参照ください。\nhttps://twitter.com/666hara_k \nhttps://lit.link/666haraK\n\n【依頼内容】\n・六原小森さんの全体像が入っているイラストを、オリジナルの衣装でお願いします。\n・衣装はリンバスのEGO「厳粛な哀悼」でお願いします。\n  髪・瞳の色と三角形の髪飾りは小森さん本人の紅ひわ色のまま残していただきたいです。\n・ポーズは戦闘中など動きの激しいものではなく、静かに構えているような感じをお願いしたいです。  冷たい微笑や凛と引き締まった顔など、静かな/クールな感じの表情で\n(以前のくたくた様からのリクエストと同じようなイメージでかまいません)\n・背景やその他の細部はお任せします。\n\n【ご注意事項】\n・背景と人物が分かれたPSDデータもいただけるとありがたいです。\n・いただいた作品は、私と六原小森さんがSNSやYouTubeのチャンネルのサムネイルで使用する場合があります。\n\nご検討いただければ幸いです。何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/11", "thumbnail_src": "https://si.imgix.net/1d32056d/uploads/origins/da5df904-b8ad-4ff8-996f-5438d637af74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=129e0593958248e844a98c314281577b", "thumbnail_srcset": "https://si.imgix.net/1d32056d/uploads/origins/da5df904-b8ad-4ff8-996f-5438d637af74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=129e0593958248e844a98c314281577b, https://si.imgix.net/1d32056d/uploads/origins/da5df904-b8ad-4ff8-996f-5438d637af74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5c3e24e94fb7f803937c5ae7cb463b5 2x, https://si.imgix.net/1d32056d/uploads/origins/da5df904-b8ad-4ff8-996f-5438d637af74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac77709161ee945c88d13308e4c1e68f 3x", "genre": "art", "nsfw": false, "body": "ドーモー！前回のフィルギアの絵は素晴らしいかたです。今回依頼したいのはまたニンジャスレイヤーのフジキドケンジです。彼が何もないのego ミミクを身に纏う。ポーズは両手で大剣を変形して大鎌になる、上方から下の薙ぎ払うみたいなポーズ。ギフトの複眼は、原作のニンジャスレイヤーで彼を身に纏うナラク・ニンジャの目みたいな邪悪と凶悪の同時に、赤黒の炎が目の中燃えるように光る。\n参考資料はこちらです: https://imgur.com/a/3f7tUqv\nフジキドケンジ本人とナラク・ニンジャ\nどうかよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/10", "thumbnail_src": "https://si.imgix.net/596aeffa/uploads/origins/9b97a701-e084-4959-be59-5bfeb4e31b9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=008347fdbe24023c11386799a61ef5a7", "thumbnail_srcset": "https://si.imgix.net/596aeffa/uploads/origins/9b97a701-e084-4959-be59-5bfeb4e31b9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=008347fdbe24023c11386799a61ef5a7, https://si.imgix.net/596aeffa/uploads/origins/9b97a701-e084-4959-be59-5bfeb4e31b9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d45963e6dd1900e7362e60122f66112d 2x, https://si.imgix.net/596aeffa/uploads/origins/9b97a701-e084-4959-be59-5bfeb4e31b9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=872cfed68da1d9053ea1e4aee05a8c92 3x", "genre": "art", "nsfw": false, "body": "こんにちは！skebのトップページで、\"terrors of nowhere \"というゲームの依頼をしてくれる人を探していて、あなたの絵を偶然見つけました。このゲームにはロボトミーコーポレーションのものがたくさん使われているんだ。あなたがロボトミーコーポレーションのアートをたくさん手がけているのを見て、ぴったりだと思いました！黒と赤をメインカラーにしたいんだ。そして、参考写真のアニメの女の子が、少し縮小されたジャスティシアを持っているように。彼女はどこか獰猛で、威圧的に見えるはずだ。そして、もしあなたが血を描いてもいいのであれば、ジャスティシアにかなりの量の血と、彼女にも少し血がついたら素晴らしいだろう。でも、血が苦手な人は気にしないでください！また、ウイルスと呼ばれるもう一人のロボットヘッドの男も、彼の3人の小さなドローンと一緒にアートに入れてもらいたいです。あなたがミグスのために描いたアートと似ていますが、もっとシリアスで残忍なトーンで。そして、絵の中の2つの存在の間により闘争的な雰囲気。これで理解してもらえたかな？もちろん、あなたのクリエイティブな自由を好きなだけ使ってください。ここまで読んでくれて、そして考えてくれて、本当にありがとう <3\n\nhttps://drive.google.com/drive/folders/1v8r1HxQBnEZX6NYAAHRATztZcGIxzZQI?usp=sharing\n\nhttps://drive.google.com/drive/folders/1v8r1HxQBnEZX6NYAAHRATztZcGIxzZQI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/9", "thumbnail_src": "https://si.imgix.net/c6ead4b4/uploads/origins/787d4138-26db-479f-9c41-1d33c8f74c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db77e28d2ec270f4f69c591133b7019f", "thumbnail_srcset": "https://si.imgix.net/c6ead4b4/uploads/origins/787d4138-26db-479f-9c41-1d33c8f74c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db77e28d2ec270f4f69c591133b7019f, https://si.imgix.net/c6ead4b4/uploads/origins/787d4138-26db-479f-9c41-1d33c8f74c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98cb0867daf39e4c94061a8ff77038d3 2x, https://si.imgix.net/c6ead4b4/uploads/origins/787d4138-26db-479f-9c41-1d33c8f74c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4216058ee019115f1eb6503988df8d9 3x", "genre": "art", "nsfw": false, "body": "はじめまして！E.G.O装備職員を描かれている方を探していて辿り着きました。\npixivのまとめも拝見してきましたが、夢見る流れくんに齧られそうになっている子の表情や使徒化した職員さん等凄く好きでした。沢山あったので楽しく最後まで見させて頂きました。\n\nさて、本題になりますがアブノーマリティも一緒に描かれているskeb作品がとても格好良かったのでうちの子でそうした作品をお願いしたいです。ただ、自職員ではないゲームアバターなのでOC×版権が好みでなければ遠慮なく断ってください。\n内容は下記の通りとなります。\n\n【キャラクターについて】\n少し幼め、ダウナー系でボーイッシュな感じの白い狐の女の子。僕っ子。\n資料だと銀髪っぽい部分もありますが、綺麗な白髪をイメージしています。\nまた、デザインは資料に忠実すぎなくても構いません。内容に合わせて描きたい/描きやすいようにアレンジして頂ければと思います。\n\n【内容について】\nアブノーマリティ 死んだ蝶の葬儀と、そのE.G.O一式 崇高な誓いを装備した資料の子を描いて欲しいです。\n戦闘中など動きの激しいものではなく、静かに構えているような感じをお願いしたいです。\nお願いしたい要素は\n☆冷たい微笑や凛と引き締まった顔など、静かな/クールな感じの表情で\n☆(上記に付随して)オッドアイが特徴の子なので、目は閉じないで欲しい\n☆眼鏡は外して、静かなオーケストラのギフトのモノクルを装備\n☆腕章は福祉チームのもの\n〇キャラクターはイラスト中央に\n〇ポーズは静かに銃を構えて佇むイメージ。例:両腕を胸の前でX字に交差させた構えや、銃を持った両腕を下ろして立っている姿など※あくまで例です\n〇死んだ蝶の葬儀はキャラクターの後ろに立ち、頭はそんなに下げずに恭しいお辞儀のポーズ(口では説明しにくいので調べたところ、『bow and scrape』と言うそうです)。\n〇薄暗い感じの雰囲気で、周囲には蝶が舞う\n\n以上となります。\n☆は必ず従って欲しい部分ですが、〇は出来ればお願いしたいくらいの感じです。描きにくくなったりするのであれば気にしなくても大丈夫です。\n指定のない部分はお任せします。資料やリクエスト内容で描きにくい/分かり難い部分があればそこは描きやすいように描いて頂いて構いません。\n\nそれでは、ぜひともよろしくお願いいたします。\n\nhttps://twitter.com/Kuta2Channel/status/1757018411018932535?t=PKjwNZTmzdY2Ac2PffdbXw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/8", "thumbnail_src": "https://si.imgix.net/ad289ef6/uploads/origins/9f9019e9-f996-47e9-961a-11fe428550ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2ac2105cb4211c36bea3a7515988e86", "thumbnail_srcset": "https://si.imgix.net/ad289ef6/uploads/origins/9f9019e9-f996-47e9-961a-11fe428550ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2ac2105cb4211c36bea3a7515988e86, https://si.imgix.net/ad289ef6/uploads/origins/9f9019e9-f996-47e9-961a-11fe428550ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b95d7dffe20ecbc8063611520dc0c4e 2x, https://si.imgix.net/ad289ef6/uploads/origins/9f9019e9-f996-47e9-961a-11fe428550ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f00a571d6a010fd2ed8c0a669c3191a2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のリンバスカンパニーのシナーOCの写真をリクエストしたいと思います。彼女の名前はThursdayで、今のところ私が持っている唯一の本当の参考画像は、付属の参考フォルダにあるpicrewです。彼女を説明するためにベストを尽くしますが、多少の自由はご自由にどうぞ。彼女は30代後半の女性で、肌は黒く、そばかすがあり、目は灰色。眼鏡をかけ、ダークブラウンの長い髪は乱れ髪で、長いポニーテールにまとめている。標準的なシナーのユニフォームを着ている。ベスト、ボタンアップシャツ、ロングジャケットの組み合わせだ。写真では、白で \"TRUTH \"と書かれた重いリボルバーを持たせたかった。彼女はそれを頭にかざし、もう片方にはウィスキーのボトルを抱えている。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1wr-PBinzJwRbn1iS3-As3L0LkeoYQlmS", "created_at": "", "completed_at": ""}, {"path": "/@Lamprey_8/works/7", "thumbnail_src": "https://si.imgix.net/103351b3/uploads/origins/b5aed0bc-653b-4c2b-b511-ff306fe610c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=705a93623cc517ead6348abc287c692a", "thumbnail_srcset": "https://si.imgix.net/103351b3/uploads/origins/b5aed0bc-653b-4c2b-b511-ff306fe610c7?bg=