er活動に使用することを許可していただけるとありがたいです。主に動画のサムネイルや、XなどのSNSへの掲載などです。\n\nもしよろしければ、レイヤーあり、背景なしのイラストを.pngまたは.psdファイルでご提供いただけると幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\nもしよろしければ、依頼をお受けいただければ幸いです。\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@su3ka_/works/90", "thumbnail_src": "https://si.imgix.net/205add9d/uploads/origins/c5fc6a3d-f1d0-4eb9-a915-2a00d98f2f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=193b3c8ba0fdb8ced67045937d94d7e3", "thumbnail_srcset": "https://si.imgix.net/205add9d/uploads/origins/c5fc6a3d-f1d0-4eb9-a915-2a00d98f2f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=193b3c8ba0fdb8ced67045937d94d7e3, https://si.imgix.net/205add9d/uploads/origins/c5fc6a3d-f1d0-4eb9-a915-2a00d98f2f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1d1f96a631abab0d7de40d2d546e98d 2x, https://si.imgix.net/205add9d/uploads/origins/c5fc6a3d-f1d0-4eb9-a915-2a00d98f2f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c084223daad1d2ab4c9324465f74e3ec 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@su3ka_/works/89", "thumbnail_src": "https://si.imgix.net/fa5a77d3/uploads/origins/935e6415-3220-4000-bf17-c943b353d460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62e5cf66a952b4950010c6165987e7ea", "thumbnail_srcset": "https://si.imgix.net/fa5a77d3/uploads/origins/935e6415-3220-4000-bf17-c943b353d460?bg=%23fff&auto=format%2Ccompress&