it=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb20f1f746298a22e45af546707a8b18", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kotokoto_kottan/works/148", "thumbnail_src": "https://si.imgix.net/baac7ca7/uploads/origins/7baada29-9b78-49f9-b495-2d6c36b371f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=581ecb8d051cc627092b6bf774cc30db", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵がとても好きなので、オープンするのをずっと待っていました！\n鉄拳8も好きです。好きなキャラクターはリン・シャオユウと風間飛鳥です。\n\n私がシャオユウのコスプレをしているアートを作ってほしいです！シャオユウと同じコスチュームで、色は違います。ポーズはあなた次第です！\n\n\n以下は私の参考資料です：\n\n私のモデル: https://drive.google.com/file/d/1flQ8lQlB2RDheIzQ2--1bTpEnrgFDMyq/view?usp=sharing\n私のXiaoyuのサンプルスクリーンショット：\n- https://drive.google.com/file/d/1kxOZXszBb8OPlwXGjmqHQq-dXacJWkl5/view?usp=drive_link\n- https://drive.google.com/file/d/1YLPpI_cep4gcEEDDvJp-nVLaB8L_QjV5/view?usp=drive_link\nシャオユウのチビアート例\n- https://drive.google.com/file/d/1050-SX2jUE5t3lIE4qmMX8ursnhRnMsj/view?usp=drive_link\n\nhttps://drive.google.com/file/d/1flQ8lQlB2RDheIzQ2--1bTpEnrgFDMyq/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kotokoto_kottan/works/147", "thumbnail_src": "https://si.imgix.net/5ff0ff73/uploads/origins/30156f17-2c94-44c8-a2c1-03a691cb617c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99cb20fc73ecb55fd953101cbb0cfc46", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kotokoto_kottan/works/146", "thumbnail_src": "https://si.imgix.net/105e4788/uploads/origins/cb4b9aee-a40a-497c-8c6e-29fd2295b83b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6754416757da59321c26ceab3deb62e3", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kotokoto_kottan/works/145", "thumbnail_src": "https://si.imgix.net/092dcaa9/uploads/origins/95f44dc2-0df2-4c41-a046-9c5d939b4c38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55fbb60debda15367ea2a01e5ef79ae6", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、私の名前はアンディです！私の大好きな鉄拳のキャラクターの一人、風間仁のコミッションを作りたいと思いました。鉄拳8のポーズのような絵が欲しいです。デフォルトのコスチュームか、できれば僕が普段プレイするときに着ているカスタマイズコスチューム（鉄拳6のようなドレススーツのコスチュームが多い）に描けるような、デビルフォームで翼を見せながら怒りのアートをするポーズ。背景はあまり具体的なものはいらないと思っているんだけど、うまく調和していれば何でも構わないよ。必要なら追加料金も払うよ。最後に、僕のゲーマータグをサインとして入れてほしい！あなたの標準に最も合うと思うものは何でも、あなたのアートワークに感謝します！\n\nhttps://images.app.goo.gl/NMgRbkhm9epjdn2K9", "created_at": "", "completed_at": ""}, {"path": "/@kotokoto_kottan/works/144", "thumbnail_src": "https://si.imgix.net/5c5c25df/uploads/origins/9bb3225e-109a-4b7b-af37-365bef73baed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fea5b0746382873aefb1ecd32a7a01f0", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kotokoto_kottan/works/143", "thumbnail_src": "https://si.imgix.net/c15a8bd0/uploads/origins/98136bc1-9afa-491e-8ee3-b99500f00de1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b586d97bc7a2a09f5c30eb6ba750830", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kotokoto_kottan/works/142", "thumbnail_src": "https://si.imgix.net/303c68bd/uploads/origins/0b3664e0-b053-4811-8980-7ac98b7efb1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=b