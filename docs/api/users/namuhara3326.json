773/uploads/origins/50f1cca8-c706-4735-a7c8-6a18a70f003b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec5f1e3ef264495255b8979e430f9782", "thumbnail_srcset": "https://si.imgix.net/23594773/uploads/origins/50f1cca8-c706-4735-a7c8-6a18a70f003b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec5f1e3ef264495255b8979e430f9782, https://si.imgix.net/23594773/uploads/origins/50f1cca8-c706-4735-a7c8-6a18a70f003b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9d9ae13f3dae8038a465f00643bbed3 2x, https://si.imgix.net/23594773/uploads/origins/50f1cca8-c706-4735-a7c8-6a18a70f003b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b382ef6ae7dbd3a8f8bdb77cdbc27e4 3x", "genre": "art", "nsfw": false, "body": "私はあなたが人のキャラクターを描くのがとても好きで、もしあなたが私のキャラクターを描いてくれたらと思います！\n\n好きなように描いてください\n\nhttps://drive.google.com/file/d/1kZy8idhOzPF89aPEpgS-WNLhP77XigWc/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/24", "thumbnail_src": "https://si.imgix.net/76281ceb/uploads/origins/dda81f5c-65f7-44b9-9f92-655fe0befada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7db1ddef0361fa97e2a0f151049297f6", "thumbnail_srcset": "https://si.imgix.net/76281ceb/uploads/origins/dda81f5c-65f7-44b9-9f92-655fe0befada?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7db1ddef0361fa97e2a0f151049297f6, https://si.imgix.net/76281ceb/uploads/origins/dda81f5c-65f7-44b9-9f92-655fe0befada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a0116921257f2e8ea2a7d7c189bfce6 2x, https://si.imgix.net/76281ceb/uploads/origins/dda81f5c-65f7-44b9-9f92-655fe0befada?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=863ea139be31b3a6330952a74a6f61e6 3x", "genre": "art", "nsfw": true, "body": "なむはら老師你好,我覺得你的作品都好可愛，想替自己的孩子報名看看\n\n我想嘗試看看戰敗風格配上枷鎖~有想到的要素給老師參考，看那些您覺得適合的，或是您有其他的想法，都沒問題~\n受傷、繃帶、項圈、手銬、腳鐐、破舊的衣服、疲倦或弱氣的表情\n\n我的設定:\nhttps://drive.google.com/drive/folders/1LNLXbip3rNM0nlzhduL1k8mzdMewXUPL?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1LNLXbip3rNM0nlzhduL1k8mzdMewXUPL?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/23", "thumbnail_src": "https://si.imgix.net/d0739ae0/uploads/origins/6d7b807b-a21e-405c-b0aa-c9998c7bfcb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77441978a7a02d23544e3053cc81832a", "thumbnail_srcset": "https://si.imgix.net/d0739ae0/uploads/origins/6d7b807b-a21e-405c-b0aa-c9998c7bfcb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77441978a7a02d23544e3053cc81832a, https://si.imgix.net/d0739ae0/uploads/origins/6d7b807b-a21e-405c-b0aa-c9998c7bfcb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5be214fab0b168798c68c0f086829290 2x, https://si.imgix.net/d0739ae0/uploads/origins/6d7b807b-a21e-405c-b0aa-c9998c7bfcb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7d814ddf8caca370b89578b2ef564f3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！  私の着ぐるみキャラを描いていただけますか？ \nポーズやシチュエーションはおまかせでお願いします\nでは、よろしくお願いします！  \nhttps://drive.google.com/drive/folders/1D229rl-qxb2EatiNRl4xxem3nxpolA6v?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/22", "thumbnail_src": "https://si.imgix.net/bd23ed57/uploads/origins/15c9ed61-0f84-47a0-ad9a-2d877329b8b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d2f0e029c14a1f9b482f12738bdc471", "thumbnail_srcset": "https://si.imgix.net/bd23ed57/uploads/origins/15c9ed61-0f84-47a0-ad9a-2d877329b8b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d2f0e029c14a1f9b482f12738bdc471, https://si.imgix.net/bd23ed57/uploads/origins/15c9ed61-0f84-47a0-ad9a-2d877329b8b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c4d6be3c70b2959201a463b4217b6ff 2x, https://si.imgix.net/bd23ed57/uploads/origins/15c9ed61-0f84-47a0-ad9a-2d877329b8b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2b0ee2f78a99a7a0713d3979ce44abb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作風はかわいいと思うので、私のocの絵を依頼したいです！\nどんな風に描いても構いません！\n\nジュエリーは入れないでください！\n\nhttps://drive.google.com/drive/folders/1fCskME9ed3Z6d_nU546no6Lw9st1XgBX", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/21", "thumbnail_src": "https://si.imgix.net/a697b11b/uploads/origins/53817c98-abf7-4258-a3c8-0ba61953f0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17bb5bb5e86845cddad51546d1fbc745", "thumbnail_srcset": "https://si.imgix.net/a697b11b/uploads/origins/53817c98-abf7-4258-a3c8-0ba61953f0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17bb5bb5e86845cddad51546d1fbc745, https://si.imgix.net/a697b11b/uploads/origins/53817c98-abf7-4258-a3c8-0ba61953f0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57482fe253999a8ae27c88b13abf4fe8 2x, https://si.imgix.net/a697b11b/uploads/origins/53817c98-abf7-4258-a3c8-0ba61953f0fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5191f8a6c4fd37089e9734fdc8014db3 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n今度は自分のオリキャラを依頼したいと思います。\n資料↓\n種族は白狼、左の顔に青い稲妻の痣があり，年齢は14歳くらいな男の子\nhttps://drive.google.com/drive/folders/1lP5AH9rBOo6czVb0DmuJvBEHW384EvwW\n上に展示されているデザインはお好きなものをお選びくださいますようお願いします\nポーズや背景等々はお任せしたいと思います！ご自由に描いていただければ嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/20", "thumbnail_src": "https://si.imgix.net/30e74e00/uploads/origins/842d3b1a-0e29-430a-a3f6-a4c5a282c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bc5fcc94b9a78dae44106d67e61cc8b", "thumbnail_srcset": "https://si.imgix.net/30e74e00/uploads/origins/842d3b1a-0e29-430a-a3f6-a4c5a282c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bc5fcc94b9a78dae44106d67e61cc8b, https://si.imgix.net/30e74e00/uploads/origins/842d3b1a-0e29-430a-a3f6-a4c5a282c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a1a6fd6772b1625676b0906cee6c105 2x, https://si.imgix.net/30e74e00/uploads/origins/842d3b1a-0e29-430a-a3f6-a4c5a282c840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cba7d3a92b7c52792f10d71bd3cb185 3x", "genre": "art", "nsfw": false, "body": "こんにちは :>\n\nあなたの絵が大好きで、私のキャラクターを好きなように描いていただけませんか？\n\n以下はキャラクターのgoogleドキュメントです： https://drive.google.com/file/d/1LmL8WfaJOrpyn7u0XaTLbDp5cC6YERbC/view\n\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/19", "thumbnail_src": "https://si.imgix.net/e78bfc71/uploads/origins/966bb0c9-08d0-4175-9f95-d123fccdcf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0caa3ebaf1b55f8c30f48438e7f6205b", "thumbnail_srcset": "https://si.imgix.net/e78bfc71/uploads/origins/966bb0c9-08d0-4175-9f95-d123fccdcf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0caa3ebaf1b55f8c30f48438e7f6205b, https://si.imgix.net/e78bfc71/uploads/origins/966bb0c9-08d0-4175-9f95-d123fccdcf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82859e34334de79a404c21afb5b26e80 2x, https://si.imgix.net/e78bfc71/uploads/origins/966bb0c9-08d0-4175-9f95-d123fccdcf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b9d3d0642f41f98ca02374d74be9d6f 3x", "genre": "art", "nsfw": false, "body": "なむはらさん、こんにちは！\nなむはらさんの作品はとてもかわいくて、ふわふわした雰囲気がとても好きです！\n私のキャラクターも描いていただけませんか？\nテーマは特にないので、自由に創造してください！\nデザインも服装もお任せします。\nありがとうございました！\n\nhttps://drive.google.com/file/d/1BzrjMUfBhiYt8BMAmj-pcQsA-QkQCkcg/view", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/18", "thumbnail_src": "https://si.imgix.net/cec0dd63/uploads/origins/045a1c8f-5f90-44ff-9dc5-96b98357a1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb42dbc6d3f8f047b4bdd3d2bd609ef9", "thumbnail_srcset": "https://si.imgix.net/cec0dd63/uploads/origins/045a1c8f-5f90-44ff-9dc5-96b98357a1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb42dbc6d3f8f047b4bdd3d2bd609ef9, https://si.imgix.net/cec0dd63/uploads/origins/045a1c8f-5f90-44ff-9dc5-96b98357a1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61905d89bb9c627e001b28fd1ffc0143 2x, https://si.imgix.net/cec0dd63/uploads/origins/045a1c8f-5f90-44ff-9dc5-96b98357a1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b2fbce6de4a323cfafa85abdb485366 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの絵がとてもきれいです！\n だから私のキャラクターをあなたに任せたいです。\n\n私のキャラクターは額に角があって、そのうちの一つが折れている猫のキャラクターです。\nポーズや構図は作家様の自由にしていただいて大丈夫です。\n\n私のキャラクターをよろしくお願いします！\nありがとうございました！では、いつも良い一日をお過ごしください！ 😊\n\nhttps://drive.google.com/file/d/1mlIcmpiPqNLry7MReTESWl4wDmuvHTxh/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/17", "thumbnail_src": "https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c7b581259fe8ee0140a6806370000d1", "thumbnail_srcset": "https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c7b581259fe8ee0140a6806370000d1, https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93495dfd12964c5bd3b607655e3dae85 2x, https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69c755df327499a77a52a62feea34a18 3x", "genre": "art", "nsfw": false, "body": "はじめまして、乾太です。 \n\nうちの子を描いていただけないでしょうか。\n\nキャラ設定はこちらをご参照ください → https://blog.init.engineer/ja/kemono/\n\nもし閲覧できない場合 → https://drive.google.com/drive/folders/1y-iruLv9qqW0EAD1TM9_lfLCQKPoZITT?usp=drive_link\n\n好きなように描いてください。 \n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/16", "thumbnail_src": "https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a772dfaa0f76500ddbe87165ba933c", "thumbnail_srcset": "https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a772dfaa0f76500ddbe87165ba933c, https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1a7f7e0e67935da8702da20c46531da 2x, https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c53801bd218bd857798eb4f995ce18c2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ \n\n私のキャラクターを描いてくれませんか？\n\n好きなように描いてください！よろしくおねがいします！\n\nhttps://www.dropbox.com/scl/fi/8z15mycjbfwili3l5280k/fursecuted_ref.jpg?rlkey=fvjsppktf3yqa3pedts9ens0i&st=9dhifxzs&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/15", "thumbnail_src": "https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b21b62ddc19349acff2a454a29ab3358", "thumbnail_srcset": "https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b21b62ddc19349acff2a454a29ab3358, https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b337ef4bbf38db0ffe9e37d51b24c41 2x, https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=919ef5c0712db4c5455f1974072d0f5f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！自分のキャラクターのイラストをお願いします。基本的にネコで、尻尾がふわふわしています。指は4本、足指は3本です。ポーズやシチュエーションはお任せします。よろしくお願いします！:)\n\n参考リンク : https://drive.google.com/drive/folders/1DMps_vqcfZP44MRDUdAsMvl0unL2dkYR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/14", "thumbnail_src": "https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c8f4383b562612d35a3efba8cfabdf4", "thumbnail_srcset": "https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c8f4383b562612d35a3efba8cfabdf4, https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea52478e911facf5146a20d784cc1055 2x, https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1ce9f30b46432b23152384488cad8a3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が大好きで、ぜひ私のキャラクターを描いてもらいたいと思っています。\nアルカスは猫の姿をした宇宙から来たモンスターなので、可愛く描いてください。それ以外はお任せします。\n\nhttps://drive.google.com/drive/folders/1_XYUcoPSF4wbP8bjXaYr6Vm1nggcgXii", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/13", "thumbnail_src": "https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57b076df8729cbf0dcd291a679e4199", "thumbnail_srcset": "https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57b076df8729cbf0dcd291a679e4199, https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79db2c75f0d15e3f8bf8802e0c27a714 2x, https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e51a155d289e6d70e9f725cb66cece4f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして！あなたの作品に出会って、とても可愛くて気に入りました！\n\n私のキャラを好きなように描いてくださいでも、長方形のメガネは忘れないでください！\n\nありがとうございましたよろしくお願いします\n\n参考：https://alfyn.page/ref/\n\nhttps://alfyn.page/ref/", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/12", "thumbnail_src": "https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e12b5cab7200db1a5491e4e988de57", "thumbnail_srcset": "https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e12b5cab7200db1a5491e4e988de57, https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=388a4f3bca4c3a2ac5892a7e0c74b312 2x, https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4fabb1706cc4a0f1c36041aba73ae87 3x", "genre": "art", "nsfw": false, "body": "なむはらさん、こんばんは！あなたの描くネコがとっても可愛くて大好きです。ぜひ私のネコのキャラをイラストにしていただけたら嬉しいです！\n\n私の設定はこんな感じです...\n疲れた雰囲気の「ちょっと厭世気味のネコ」です。\n仕事が忙しくていつも目の下にクマ（アイバッグ）があり、よく眠れていません。\n他人に褒められると恥ずかしくて正面を見られず、つい横を向いてしまうような表情が欲しいです（照れ隠しの感じ）。\n\nざっくりはこんなイメージで、細かい部分や表現はなむはらさんにおまかせします。どうぞご自由に発揮してください！\nよろしくお願いいたします!ヽ(・∀・)ノ\n\nhttps://drive.google.com/drive/folders/12l95jxd_S_MKIe_qQCSjqAFw59x5uMjw?usp=drive_link", "created_at": "", "completed_at