g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb42dbc6d3f8f047b4bdd3d2bd609ef9, https://si.imgix.net/cec0dd63/uploads/origins/045a1c8f-5f90-44ff-9dc5-96b98357a1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61905d89bb9c627e001b28fd1ffc0143 2x, https://si.imgix.net/cec0dd63/uploads/origins/045a1c8f-5f90-44ff-9dc5-96b98357a1a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b2fbce6de4a323cfafa85abdb485366 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの絵がとてもきれいです！\n だから私のキャラクターをあなたに任せたいです。\n\n私のキャラクターは額に角があって、そのうちの一つが折れている猫のキャラクターです。\nポーズや構図は作家様の自由にしていただいて大丈夫です。\n\n私のキャラクターをよろしくお願いします！\nありがとうございました！では、いつも良い一日をお過ごしください！ 😊\n\nhttps://drive.google.com/file/d/1mlIcmpiPqNLry7MReTESWl4wDmuvHTxh/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/17", "thumbnail_src": "https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c7b581259fe8ee0140a6806370000d1", "thumbnail_srcset": "https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c7b581259fe8ee0140a6806370000d1, https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93495dfd12964c5bd3b607655e3dae85 2x, https://si.imgix.net/7b6a7abc/uploads/origins/ee77feba-ecdf-4381-8cfa-833f07a551bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69c755df327499a77a52a62feea34a18 3x", "genre": "art", "nsfw": false, "body": "はじめまして、乾太です。 \n\nうちの子を描いていただけないでしょうか。\n\nキャラ設定はこちらをご参照ください → https://blog.init.engineer/ja/kemono/\n\nもし閲覧できない場合 → https://drive.google.com/drive/folders/1y-iruLv9qqW0EAD1TM9_lfLCQKPoZITT?usp=drive_link\n\n好きなように描いてください。 \n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/16", "thumbnail_src": "https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a772dfaa0f76500ddbe87165ba933c", "thumbnail_srcset": "https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a772dfaa0f76500ddbe87165ba933c, https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1a7f7e0e67935da8702da20c46531da 2x, https://si.imgix.net/dc026c9a/uploads/origins/1f7bbcc9-cbbf-4057-a70c-d3250114685a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c53801bd218bd857798eb4f995ce18c2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！ \n\n私のキャラクターを描いてくれませんか？\n\n好きなように描いてください！よろしくおねがいします！\n\nhttps://www.dropbox.com/scl/fi/8z15mycjbfwili3l5280k/fursecuted_ref.jpg?rlkey=fvjsppktf3yqa3pedts9ens0i&st=9dhifxzs&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/15", "thumbnail_src": "https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b21b62ddc19349acff2a454a29ab3358", "thumbnail_srcset": "https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b21b62ddc19349acff2a454a29ab3358, https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b337ef4bbf38db0ffe9e37d51b24c41 2x, https://si.imgix.net/67da9729/uploads/origins/85202546-00e1-4df7-83f2-800c98024fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=919ef5c0712db4c5455f1974072d0f5f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！自分のキャラクターのイラストをお願いします。基本的にネコで、尻尾がふわふわしています。指は4本、足指は3本です。ポーズやシチュエーションはお任せします。よろしくお願いします！:)\n\n参考リンク : https://drive.google.com/drive/folders/1DMps_vqcfZP44MRDUdAsMvl0unL2dkYR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/14", "thumbnail_src": "https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c8f4383b562612d35a3efba8cfabdf4", "thumbnail_srcset": "https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c8f4383b562612d35a3efba8cfabdf4, https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea52478e911facf5146a20d784cc1055 2x, https://si.imgix.net/d1755eaf/uploads/origins/603c91eb-d677-4746-a1b3-24dae456a46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1ce9f30b46432b23152384488cad8a3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が大好きで、ぜひ私のキャラクターを描いてもらいたいと思っています。\nアルカスは猫の姿をした宇宙から来たモンスターなので、可愛く描いてください。それ以外はお任せします。\n\nhttps://drive.google.com/drive/folders/1_XYUcoPSF4wbP8bjXaYr6Vm1nggcgXii", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/13", "thumbnail_src": "https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57b076df8729cbf0dcd291a679e4199", "thumbnail_srcset": "https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a57b076df8729cbf0dcd291a679e4199, https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79db2c75f0d15e3f8bf8802e0c27a714 2x, https://si.imgix.net/f9d5ba59/uploads/origins/9715348c-c06e-4365-a396-7500283e3143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e51a155d289e6d70e9f725cb66cece4f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして！あなたの作品に出会って、とても可愛くて気に入りました！\n\n私のキャラを好きなように描いてくださいでも、長方形のメガネは忘れないでください！\n\nありがとうございましたよろしくお願いします\n\n参考：https://alfyn.page/ref/\n\nhttps://alfyn.page/ref/", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/12", "thumbnail_src": "https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e12b5cab7200db1a5491e4e988de57", "thumbnail_srcset": "https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e12b5cab7200db1a5491e4e988de57, https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=388a4f3bca4c3a2ac5892a7e0c74b312 2x, https://si.imgix.net/8bc673a4/uploads/origins/4a04f107-3656-455f-8132-0137d51071be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4fabb1706cc4a0f1c36041aba73ae87 3x", "genre": "art", "nsfw": false, "body": "なむはらさん、こんばんは！あなたの描くネコがとっても可愛くて大好きです。ぜひ私のネコのキャラをイラストにしていただけたら嬉しいです！\n\n私の設定はこんな感じです...\n疲れた雰囲気の「ちょっと厭世気味のネコ」です。\n仕事が忙しくていつも目の下にクマ（アイバッグ）があり、よく眠れていません。\n他人に褒められると恥ずかしくて正面を見られず、つい横を向いてしまうような表情が欲しいです（照れ隠しの感じ）。\n\nざっくりはこんなイメージで、細かい部分や表現はなむはらさんにおまかせします。どうぞご自由に発揮してください！\nよろしくお願いいたします!ヽ(・∀・)ノ\n\nhttps://drive.google.com/drive/folders/12l95jxd_S_MKIe_qQCSjqAFw59x5uMjw?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@namuhara3326/works/11", "thumbnail_src": "https://si.imgix.net/6474f356/uploads/origins/b72e9503-905a-4e13-92c2-033cc7df3950?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t