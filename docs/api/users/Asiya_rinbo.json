756-03e61925d82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e0f7eded256598871b22eccaffc6c6", "thumbnail_srcset": "https://si.imgix.net/654f1630/uploads/origins/24f719f4-9ca5-4588-b756-03e61925d82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e0f7eded256598871b22eccaffc6c6, https://si.imgix.net/654f1630/uploads/origins/24f719f4-9ca5-4588-b756-03e61925d82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c640b094971bfbd8aea7c0461aee90b 2x, https://si.imgix.net/654f1630/uploads/origins/24f719f4-9ca5-4588-b756-03e61925d82f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=059239ebd249d27c5bf5f71d1c98c449 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの作品は素晴らしいです!\n\n私の柴犬の女の子を描いていただけませんか？不良っぽいキャラなんですが、曲がったタバコを吸っているところを描いていただけないでしょうか？\n\nありがとうございました。\n\nhttps://twitter.com/doqmeet/status/1572012960482209792?t=ZxQwUcKwGc5gCn00FURQDQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Asiya_rinbo/works/20", "thumbnail_src": "https://si.imgix.net/2ca3e3a6/uploads/origins/0946f202-d716-4b3b-8823-3a6b3a974453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6a64bb3a3d95ae6734c1a6481e3528", "thumbnail_srcset": "https://si.imgix.net/2ca3e3a6/uploads/origins/0946f202-d716-4b3b-8823-3a6b3a974453?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6a64bb3a3d95ae6734c1a6481e3528, https://si.imgix.net/2ca3e3a6/uploads/origins/0946f202-d716-4b3b-8823-3a6b3a974453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f37ffb535c8c3798ff35936032789ed 2x, https://si.imgix.net/2ca3e3a6/uploads/origins/0946f202-d716-4b3b-8823-3a6b3a974453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b22081a46e13f951e1ad1242117af305 3x", "genre": "art", "nsfw": true, "body": "こんにちは！あなたの絵は信じられないほど美しいです。この二人のキャラクターを一緒に描いていただけないでしょうか？\n赤鬼の女の子は、身長280cmで、黄色い目をしています。腕は4本で、太い尻尾を持っています。性格はとても母性的で、少しぽっちゃりしています。角が1本折れています。折れた角の内側は燃えるタバコのようで、触るととても熱い。彼女の目はいつも渦を巻いている。\n\n肌の色が濃い鬼の女の子は、200cm。彼女は体の片側に青い雲の入れ墨をしています。瞳は紫色で、面白い性格。少しぽっちゃりしている。\n\n両方のキャラクターをこの淫らなポーズで描いてください。https://imgur.com/a/ZK9gwpl\n\nhttps://imgur.com/a/E2f8ErS", "created_at": "", "completed_at": ""}, {"path": "/@Asiya_rinbo/works/19", "thumbnail_src": "https://si.imgix.net/8d7f5fa1/uploads/origins/fa6b254e-bd12-4c25-b58d-8204e118015b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f30687dbf2c4dcb9f4b9224589f54add", "thumbnail_srcset": "https://si.imgix.net/8d7f5fa1/uploads/origins/fa6b254e-bd12-4c25-b58d-8204e118015b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f30687dbf2c4dcb9f4b9224589f54add, https://si.imgix.net/8d7f5fa1/uploads/origins/fa6b254e-bd12-4c25-b58d-8204e118015b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0a403e0915a632db308b2cd40885d7a 2x, https://si.imgix.net/8d7f5fa1/uploads/origins/fa6b254e-bd12-4c25-b58d-8204e118015b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=095b8c4f5d243448a2a916f0b2c99cfb 3x", "genre": "art", "nsfw": false, "body": "こんにちは!\n前回のリクエストのぬいぐるみ拝見しました。めっちゃかわいいですねー。私のキャラクターと同じような絵が欲しいなと思いました。\nこれは私のキャラクターです。\nhttps://toyhou.se/17720534.yuu#54086016\n\nこのぬいぐるみと一緒に描いてほしいです。\nhttps://twitter.com/_omocat/status/1570850010434093058/photo/1\n\nゲーム「OMORI」のぬいぐるみです。ケル、ヒーロー、オーブリー、マリ、大森、バジルのぬいぐるみです。\nそれぞれのぬいぐるみのツイッターの投稿をリンクしておきますので、もっとよく見てみてください。\nOmori - https://twitter.com/_omocat/status/1563239865919176704/photo/1\nBasil - https://twitter.com/_omocat/status/1569400454328598538/photo/1\nAubrey - https://twitter.com/_omocat/status/1564327026214985728/photo/1\nKel - https://twitter.com/_omocat/status/1565776576284876801/photo/1\nHero - https://twitter.com/_omocat/status/1566863742662352897/photo/1\nMari - https://twitter.com/_omocat/status/1568313296394018816/photo/1\n\n大森とバジルのぬいぐるみ（白黒のぬいぐるみと緑のぬいぐるみ）を抱かせることができるといいですね。\n\nできれば、もう一人のキャラとそのペットのぬいぐるみも入れてほしいです。\nhttps://toyhou.se/14952958.my-xiv-character#54172412\nもうすでにたくさんのぬいぐるみをお願いしているので、絶対に入れなくてもいいのですが。\n\nありがとうございました。\n\nhttps://toyhou.se/17720534.yuu#54086016", "created_at": "", "completed_at": ""}, {"path": "/@Asiya_rinbo/works/18", "thumbnail_src": "https://si.imgix.net/0e4da5e4/uploads/origins/c00dcbdd-39a4-464d-8d48-5dcd791f8080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb1a0bde91b6998d064c7aff9e95ad1d", "thumbnail_srcset": "https://si.imgix.net/0e4da5e4/uploads/origins/c00dcbdd-39a4-464d-8d48-5dcd791f8080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb1a0bde91b6998d064c7aff9e95ad1d, https://si.imgix.net/0e4da5e4/uploads/origins/c00dcbdd-39a4-464d-8d48-5dcd791f8080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f4cbceab2653348aa10c0beddfe63c9 2x, https://si.imgix.net/0e4da5e4/uploads/origins/c00dcbdd-39a4-464d-8d48-5dcd791f8080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a94467457e82e72a04913e4e57225b51 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のVTUBERキャラクターの絵をお願いします。ピンクのダブルポニーテールの元気なメイドさんです～ ツイートしてヘッドポストに使いたいです よろしくお願いします～ キャラクターはこんな感じです：https://img.onl/Kagn9g\n\nhttps://img.onl/Kagn9g", "created_at": "", "completed_at": ""}]}