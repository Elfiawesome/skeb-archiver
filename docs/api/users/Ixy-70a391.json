/7a0e0521-44a2-4b07-b9a1-bf70c7f729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8a79546cac0b0608ede98e18f4901b", "thumbnail_srcset": "https://si.imgix.net/26cb49b8/uploads/origins/7a0e0521-44a2-4b07-b9a1-bf70c7f729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8a79546cac0b0608ede98e18f4901b, https://si.imgix.net/26cb49b8/uploads/origins/7a0e0521-44a2-4b07-b9a1-bf70c7f729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a250a636ea514174fdde7bf8c819c6e 2x, https://si.imgix.net/26cb49b8/uploads/origins/7a0e0521-44a2-4b07-b9a1-bf70c7f729c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a2d1cb4b44064f4190d82d1ace86e63 3x", "genre": "art", "nsfw": false, "body": "Ｉｘｙ先生！初めてまして！むぎと申します\nいつもＩｘｙ先生の絵を拝見して本当に素晴らしい作品だと思います！\n心の中から先生の絵が好きですからこのチャンスを見逃さずぜひリクエストしたいです。。。\nポーズも服装も全部お任せで私のocを描いてください！！( T_T)\nよろしくお願いします！これからも応援します！！\n\n参考リンク\nhttps://drive.google.com/file/d/1KyQJTLJqggxA8JIrFMfwPhXGF_R8wWc1/view?usp=drivesdk\nhttps://drive.google.com/file/d/1kOrtOYaV7PFXRWfhVe6A0_p4y8ANrl62/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@Ixy/works/112", "thumbnail_src": "https://si.imgix.net/625976ef/uploads/origins/21674839-0f84-4954-b7b4-a7e4e7d7addd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b1e5ede90e9c2b3ed8e325702647219", "thumbnail_srcset": "https://si.imgix.net/625976ef/uploads/origins/21674839-0f84-4954-b7b4-a7e4e7d7addd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b1e5ede90e9c2b3ed8e325702647219, https://si.imgix.net/625976ef/uploads/origins/21674839-0f84-4954-b7b4-a7e4e7d7addd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&