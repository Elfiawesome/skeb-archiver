6d-9073-d22932d97cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9bf72707db3a4bac4542ae4d4eae067, https://si.imgix.net/2853d43e/uploads/origins/44eb1255-d3bb-4c6d-9073-d22932d97cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bedc1f16d876d69e7c5eda83bac592a 2x, https://si.imgix.net/2853d43e/uploads/origins/44eb1255-d3bb-4c6d-9073-d22932d97cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48a00ad7c56111d8dd2eeafd73572eb3 3x", "genre": "art", "nsfw": false, "body": "たろベえちやんこんにちは、前に私のオリジナルキャラをすごく可愛く描いてくれてありがとう！今回は新しい衣装を描いてほしいです。ビーチみたいな背景🏖で、ポーズは自由にしてください！日本語があまり上手じゃないので、文法や表現に間違いがあったらごめんなさい！キャラのイメージはこちらのリンクを参考にしてください\n\nhttps://drive.google.com/file/d/18SILdPMgtOyC7WJH-PYXzmZxvMbhqJDs/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/865", "thumbnail_src": "https://si.imgix.net/5e07e761/uploads/outputs/4c733940-0ca3-4173-8fd6-feec1d0d89ed?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=837df8df75dcf0fee541e2b91eebfb09", "thumbnail_srcset": "https://si.imgix.net/5e07e761/uploads/outputs/4c733940-0ca3-4173-8fd6-feec1d0d89ed?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=837df8df75dcf0fee541e2b91eebfb09, https://si.imgix.net/5e07e761/uploads/outputs/4c733940-0ca3-4173-8fd6-feec1d0d89ed?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=db3ddfc335ce7be0a60ebd63dedee6fa 2x, https://si.imgix.net/5e07e761/uploads/outputs/4c733940-0ca3-4173-8fd6-feec1d0d89ed?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=69ee98746903b0ccdf2cc8d13bc73e70 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたの超可愛いアニメーションのコミッションをぜひお願いしたいです！私のキャラクターの名前はクエンビーで、冥界の各部署の間を移動する秘書です。クエンビーがデスクに気軽に向かい仕事をしている様子、時々隣の紙の山から一枚取り出して、まるで近くに置いてあるおやつみたいにムシャムシャ食べているアニメーションが欲しいです。 \nクエンビーはネズミなので物をむしゃむしゃ食べるのが好きで、秘書として働く中でシュレッダーを使わずに書類をかじり始めたという設定です。参考画像では体の後ろに隠れて見えにくいですが、尾も必ず描いてくださいね（笑）\nご依頼お受けいただきありがとうございます〜 https://drive.google.com/drive/folders/1kdClmEqtFjAyEMDmOM7rEakQSrP8841L", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/864", "thumbnail_src": "https://si.imgix.net/4389c2b2/uploads/origins/d0a6d330-1967-48d4-a05b-825b2bf3561e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e699f8f3514dd6e2506634ce657d5784", "thumbnail_srcset": "https://si.imgix.net/4389c2b2/uploads/origins/d0a6d330-1967-48d4-a05b-825b2bf3561e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e699f8f3514dd6e2506634ce657d5784, https://si.imgix.net/4389c2b2/uploads/origins/d0a6d330-1967-48d4-a05b-825b2bf3561e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b48f79959b026eee14ef16ec35031f12 2x, https://si.imgix.net/4389c2b2/uploads/origins/d0a6d330-1967-48d4-a05b-825b2bf3561e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=666389ca6c2989519438ad119a849f6c 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！\n\nうちの2羽のペットの鳥と一緒に、OCを描いていただけますか？\n控えめな微笑みを浮かべたOCを、両脇に幸せそうな二羽の鳥を添えて描いてください。\n鳥の絵が描きづらいなら、デフォルメして構いません。\n\nOC: https://toyhou.se/25232908.spica-sona/26253859.references\nセキセイインコ: https://toyhou.se/18519641.kamil-pikopiko/gallery\nハト: https://toyhou.se/37506715.remil-poppo-pikopiko/gallery\n\nNGがある場合は、再申請またはリクエストをキャンセルしてください。\nご配慮いただきありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/863", "thumbnail_src": "https://si.imgix.net/3d54ed50/uploads/origins/b944a776-ee06-4a8b-be79-d37f61c1508d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ed6c832cf534089b759acccc334351", "thumbnail_srcset": "https://si.imgix.net/3d54ed50/uploads/origins/b944a776-ee06-4a8b-be79-d37f61c1508d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ed6c832cf534089b759acccc334351, https://si.imgix.net/3d54ed50/uploads/origins/b944a776-ee06-4a8b-be79-d37f61c1508d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebfe2006771a95db9439a41d97ba2596 2x, https://si.imgix.net/3d54ed50/uploads/origins/b944a776-ee06-4a8b-be79-d37f61c1508d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3109004fcc9eb2b0da7d2b083d7a8e5c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのイラスト、とっても可愛いです！私のVtuber「カガリ」のリクエストをお願いできますか？ポーズなどはご自由に決めてください！https://x.com/Kagari_channel/status/2011087566045659638/photo/1https://imgur.com/a/kagari-6s3je9m", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/862", "thumbnail_src": "https://si.imgix.net/44cbbc8b/uploads/outputs/d47531a9-4231-4dd4-879b-8670b68e9add?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c356191865bf1c60386b2e8e54521cb6", "thumbnail_srcset": "https://si.imgix.net/44cbbc8b/uploads/outputs/d47531a9-4231-4dd4-879b-8670b68e9add?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=c356191865bf1c60386b2e8e54521cb6, https://si.imgix.net/44cbbc8b/uploads/outputs/d47531a9-4231-4dd4-879b-8670b68e9add?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=c702b8d0b9ecdd24ccf96551ed004a46 2x, https://si.imgix.net/44cbbc8b/uploads/outputs/d47531a9-4231-4dd4-879b-8670b68e9add?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c489851b83f0d5d8a2055b7a8d968eb 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたのちびGIFがすごく可愛くて、私のプロジェクトで一緒に仕事したいです！私がデザインしたメイド服を着たVTuberが、ほうきで掃除する姿（GIFでは何も掃除していません。配信のオーバーレイで使いたいので、動きだけ表現してほしいです）を見たいです！\n\n二つ目のGIFでは、執事衣装（ドライブフォルダ内）のVTuberが皿を持っている姿をお願いします。皿の上には自由に何かを載せていただいて構いません（可能であれば、皿が空のバージョンもお願いします）。\n\n私のVTuberについて補足：彼は人間/ホッキョクギツネです！重要なディテールは：三つの星、目の傷、そして耳と尾のキツネです！よろしくお願いします、楽しんでください！！https://drive.google.com/drive/folders/15jjWMQJyIE7QEDGek8IHZa6liEGKZqbv?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/861", "thumbnail_src": "https://si.imgix.net/990beff3/uploads/outputs/58db24e9-8a0a-4331-910b-7bd3ee215c11?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7fac1e790887d37bb668344c2b82a581", "thumbnail_srcset": "https://si.imgix.net/990beff3/uploads/outputs/58db24e9-8a0a-4331-910b-7bd3ee215c11?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7fac1e790887d37bb668344c2b82a581, https://si.imgix.net/990beff3/uploads/outputs/58db24e9-8a0a-4331-910b-7bd3ee215c11?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=89a862e0a2dcbf99f30fe3e543cfaf2b 2x, https://si.imgix.net/990beff3/uploads/outputs/58db24e9-8a0a-4331-910b-7bd3ee215c11?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4b96b3ff5a0bf6b56fff2a6d75b9325 3x", "genre": "video", "nsfw": false, "body": "こんにちは！\nイラストのご依頼です。私は小さくて眠そうなネズミ娘（身長156cm）で、黒く長くてボサボサの髪をしています。黒のメガネをかけ、黒い瞳で、唇の左端にほくろがあります。睡眠不足のため目の下のクマがすごく濃いです。胸は平らです。ネズミの耳は大きく、ネズミのしっぽもあります。好きなものは銃、昆虫、蜘蛛、自然、飛行機、車、チーズ、そしてネズミです。 黒のシャツには「brat」と書いてあります。ジャケットは大きめサイズです。VTuber参考：https://drive.google.com/drive/folders/1poSraUedyg2YUibGOBY1H7k2UmFSz4B8?usp=drive_linkネズミを抱きしめている姿を描いていただけますか？よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/860", "thumbnail_src": "https://si.imgix.net/c754aa7d/uploads/origins/bd36ec44-ac15-44be-89c1-741d00dfdf7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=386e48363f3a32203116793ad5a16f95", "thumbnail_srcset": "https://si.imgix.net/c754aa7d/uploads/origins/bd36ec44-ac15-44be-89c1-741d00dfdf7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=386e48363f3a32203116793ad5a16f95, https://si.imgix.net/c754aa7d/uploads/origins/bd36ec44-ac15-44be-89c1-741d00dfdf7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5cd2adfba5da9beda37dd827f6e51f7 2x, https://si.imgix.net/c754aa7d/uploads/origins/bd36ec44-ac15-44be-89c1-741d00dfdf7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e795b90ac9c7792efa358eb233de3c7c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！リクエストをご検討いただきありがとうございます。このオリ