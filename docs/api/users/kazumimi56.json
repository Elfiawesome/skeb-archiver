65d643af594?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=564ac53cfa3a9e6abcde05b58335d601, https://si.imgix.net/f0b87ba0/uploads/outputs/6dac134a-1653-49ed-adc7-365d643af594?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=d01972b61f6f02368224d988083331d0 2x, https://si.imgix.net/f0b87ba0/uploads/outputs/6dac134a-1653-49ed-adc7-365d643af594?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f78e5d59184564644e96fc8c92162ad 3x", "genre": "video", "nsfw": false, "body": "こんにちは！以前、2体のキャラクター分のお支払いを済ませておりましたが、参考画像のアップロードに問題が生じたため、1体しか描いていただけなかったかと存じます。追加料金をお支払いすることで、両方のオリジナルキャラクターを一緒に描いていただけませんか？ご迷惑をおかけして申し訳ございません。\nhttps://drive.google.com/drive/folders/1geiBI9nHkMyca_XAYTd7aOZuTdkYYwtd https://drive.google.com/drive/folders/1geiBI9nHkMyca_XAYTd7aOZuTdkYYwtd", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/857", "thumbnail_src": "https://si.imgix.net/a8e7e18e/uploads/outputs/e27d35a5-2a54-45b6-a346-0d2dfb205a81?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2bd7a7fe4b5318d70cffc21b73da8762", "thumbnail_srcset": "https://si.imgix.net/a8e7e18e/uploads/outputs/e27d35a5-2a54-45b6-a346-0d2dfb205a81?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2bd7a7fe4b5318d70cffc21b73da8762, https://si.imgix.net/a8e7e18e/uploads/outputs/e27d35a5-2a54-45b6-a346-0d2dfb205a81?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba396da09de7fbad82d68ab9b33ddcf7 2x, https://si.imgix.net/a8e7e18e/uploads/outputs/e27d35a5-2a54-45b6-a346-0d2dfb205a81?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2914a0c884d9f813d77abc0c5b8c25a 3x", "genre": "video", "nsfw": false, "body": "ねえ！！あなたが一度にたくさん作る小さなアニメーション、本当に大好きです！だから私のVtuberオリジナルキャラにもそれを取り入れたいんです！彼女はクールな透明なお腹を持つ小さなサイボーグなんです！どうぞお好きなように作ってください、どんなものでも嬉しいです！お引き受けくださったら本当にありがとうございます！！\n\nhttps://drive.google.com/file/d/1o21J5WOIN3IEV_BQvTzRmannE8pNRzTO/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/856", "thumbnail_src": "https://si.imgix.net/c8d6e13d/uploads/outputs/17bf6d7b-2d6e-4cd2-bead-bcf0f6a2317c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5a0b44640a9687ce712042a92152d796", "thumbnail_srcset": "https://si.imgix.net/c8d6e13d/uploads/outputs/17bf6d7b-2d6e-4cd2-bead-bcf0f6a2317c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5a0b44640a9687ce712042a92152d796, https://si.imgix.net/c8d6e13d/uploads/outputs/17bf6d7b-2d6e-4cd2-bead-bcf0f6a2317c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa6a75d753e8775e4d635f2b2425bd77 2x, https://si.imgix.net/c8d6e13d/uploads/outputs/17bf6d7b-2d6e-4cd2-bead-bcf0f6a2317c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=545a5c81228e043edf8697e92d5f2821 3x", "genre": "video", "nsfw": false, "body": "Request: Can you draw my being really smug and raising their hands to their mouth and then a version where it just stand there. \n\nMy character: https://drive.google.com/drive/u/1/folders/1gfxz732c315jJVAh_8pvUaTVA1H_GLCL\n\nMy character is a Dice Magician vtuber with a rolling dice hat and a dice eye. I have most of the cards throughout my outfit. Usually smug and mischievous is my personality. \n\nFormat: I would like it to be Gif and PNG format\n\nUsage: SNS, Twitch, Youtube", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/855", "thumbnail_src": "https://si.imgix.net/10619452/uploads/outputs/ba846ca7-e1dd-448a-91c4-795a5774e7a2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d58f33ea09f2739548e17b0153efc506", "thumbnail_srcset": "https://si.imgix.net/10619452/uploads/outputs/ba846ca7-e1dd-448a-91c4-795a5774e7a2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d58f33ea09f2739548e17b0153efc506, https://si.imgix.net/10619452/uploads/outputs/ba846ca7-e1dd-448a-91c4-795a5774e7a2?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a87c9fd574ff291430ed721132cb3c0 2x, https://si.imgix.net/10619452/uploads/outputs/ba846ca7-e1dd-448a-91c4-795a5774e7a2?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=da725b4129eb7b8c49b7889156451e54 3x", "genre": "video", "nsfw": false, "body": "こんにちは！あなたのアニメーション作品がとても可愛いです！添付のオリジナルキャラクター（OC）は、二種類のデザインと数種類の衣装があります。お好きな方／描いてみたい方を選んでください。キャラクター：ラックス小鳥のような小さな生き物で、とても臆病ですが優しい性格です。小さな機械工具を作るエンジニアです。体の色と模様は参考画像と同じにしてください。\n\n衣装は自由に簡略化して構いません。参考画像の衣装を使用しても、ご自身のスタイルに合うなら裸体でも構いません。ポーズ／表情：唯一の要望は、彼の臆病さが表情に表れることです。「表情例」フォルダーの表情のように、最初は臆病な表情で、その後少し圧倒されたような表情を描いていただけますか？ポーズは最もインスピレーションを受ける形で描いてください。\n\nご依頼をご検討いただき誠にありがとうございます！https://drive.google.com/drive/folders/1GZf4epcQsSJLhrMMezPM1wjP0p3kkamu", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/854", "thumbnail_src": "https://si.imgix.net/d5a02602/uploads/outputs/00719922-cd8e-4f24-aa30-257c83cf8930?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2ac9e75bccd845efb74e296582d4b0e3", "thumbnail_srcset": "https://si.imgix.net/d5a02602/uploads/outputs/00719922-cd8e-4f24-aa30-257c83cf8930?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2ac9e75bccd845efb74e296582d4b0e3, https://si.imgix.net/d5a02602/uploads/outputs/00719922-cd8e-4f24-aa30-257c83cf8930?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d623d09fd9305f5b81036129a5b3bc4 2x, https://si.imgix.net/d5a02602/uploads/outputs/00719922-cd8e-4f24-aa30-257c83cf8930?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=11d59d0ac2c0bbc5ca9795152762dadd 3x", "genre": "video", "nsfw": false, "body": "こんにちは、お気に入りのVTuberのアニメーションを依頼したいです。彼女の名前はクビーです。昨年彼女を描いていただきましたが、モデルを大きく変更したので、あなたの画風で再び彼女を見られるのを楽しみにしています！\n\n「ウマウマダンス」をしている姿を描いていただけませんか？このイラストはYouTubeのサムネイルやスケジュール表に使用される可能性があります。ご検討いただきありがとうございます！https://drive.google.com/drive/folders/1gV3IiY8bZI5vMN2SrfyG_bZbNSkp2gRl?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kazumimi56/works/853", "thumbnail_src": "https://si.imgix.net