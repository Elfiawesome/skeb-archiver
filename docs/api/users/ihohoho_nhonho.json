ません。他にも面白いアイデアがあれば、ぜひ描いてください。また、ラフや下絵があれば、いただけるとうれしいです。ご一読、ご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1U7uD9l4i3K2XXExYsZpChwFGQBo9tFei?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@ihohoho_nhonho/works/39", "thumbnail_src": "https://si.imgix.net/88103b9c/uploads/origins/58e6fb9a-ac2a-4b15-9345-f24b55c8cd96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5dd6879840ce77213fc1a67260a9c44", "thumbnail_srcset": "https://si.imgix.net/88103b9c/uploads/origins/58e6fb9a-ac2a-4b15-9345-f24b55c8cd96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5dd6879840ce77213fc1a67260a9c44, https://si.imgix.net/88103b9c/uploads/origins/58e6fb9a-ac2a-4b15-9345-f24b55c8cd96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6c0c85821ce3d7d7b08db6a26a1c875 2x, https://si.imgix.net/88103b9c/uploads/origins/58e6fb9a-ac2a-4b15-9345-f24b55c8cd96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a991a0e7f875e4f8ff5f3f638aa0eaa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ihohoho_nhonho/works/38", "thumbnail_src": "https://si.imgix.net/5cd8fbc4/uploads/origins/f9966e88-87ae-4d28-a0de-cdc8e7e8a8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=facc1c51baabb1e135c87471644e08cc", "thumbnail_srcset": "https://si.imgix.net/5cd8fbc4/uploads/origins/f9966e88-87ae-4d28-a0de-cdc8e7e8a8c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=facc1c51baabb1e135c87471644e08cc, https://si.imgix.ne