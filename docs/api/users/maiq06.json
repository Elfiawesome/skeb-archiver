1a52/uploads/origins/f956dff1-1312-464f-96f1-c58b61483e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9665e6890afc0825f112db1867a2ce58 2x, https://si.imgix.net/ef911a52/uploads/origins/f956dff1-1312-464f-96f1-c58b61483e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=953c2473105aa6d47a6fddd32e9d476f 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アークナイツのOC \"ヴァンダ \"を描いていただけませんか？\n\nヴァンダはルポの少女で、ラテラーノの学校に通う高校生。物静かで生真面目、音楽が好きで、自分の中に閉じこもっている。銃の撃ち方を知っているが、あまり上手ではない。\n\n好きなように描いてください。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1akOZDFBHNvy5ekXVEleDXtlXUJFrC3c8?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@maiq06/works/38", "thumbnail_src": "https://si.imgix.net/98cc2f6e/uploads/origins/89e4e5c6-3e6d-4f93-be21-14d5fa18c9b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba1e2b83dddb1e0a26fd9affd6b1577", "thumbnail_srcset": "https://si.imgix.net/98cc2f6e/uploads/origins/89e4e5c6-3e6d-4f93-be21-14d5fa18c9b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba1e2b83dddb1e0a26fd9affd6b1577, https://si.imgix.net/98cc2f6e/uploads/origins/89e4e5c6-3e6d-4f93-be21-14d5fa18c9b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b83b64ab683698cf74c015913ed5267 2x, https://si.imgix.net/98cc2f6e/uploads/origins/89e4e5c6-3e6d-4f93-be21-14d5fa18c9b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee218fae7cdf2c3438ab6e8f86d54875 3x", "genre": "art", "nsfw": true, "body": "授乳しているウタゲのアートワークがとても好きで、もっと見たいです。\n最初のバリエーションでは、ウタゲは恥ずかしがってセーターの隙間からミルクを垂らしながら胸を隠している。\n2つ目のバリエーションでは、セーターを持ち上げて乳房を見せ、乳房が勝手にミルクを吹き出している。\nウタゲのおっぱいがどれだけ膨らんで、ミルクがいっぱい出ているかを強調してもらえるとうれしいです。\n\nありがとうございました！\n\nhttps://x.com/maiq06/status/1779177287054934311", "created_at": "", "completed_at": ""}, {"path": "/@maiq06/works/37", "thumbnail_src": "https://si.imgix.net/8a21d605/uploads/origins/9806d473-0bf7-45d1-bc0b-23dae