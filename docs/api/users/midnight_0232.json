=200&h=200&s=2e7e21fec3c8188e30a1bb80d4594cab, https://si.imgix.net/bd7a12b7/uploads/origins/d7907e4f-c8d9-47b8-96f8-42d29731c5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d9b7429422aa30e3987e7445c5e6c4e 2x, https://si.imgix.net/bd7a12b7/uploads/origins/d7907e4f-c8d9-47b8-96f8-42d29731c5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e41eefaa1d88302d4fe7f811c1f04ff 3x", "genre": "art", "nsfw": false, "body": "はじめまして！アピール読ませて頂きました！\nうちのS-2をお褒め頂きありがとうございます！とても嬉しいです！\n私もHiyori Kanna様の絵柄でうちのS-2をどのように描いてくださるか気になりますので是非こちらからもご依頼させて頂きたいです！\n構図、ポージング、背景などHiyori Kanna様に全てお任せいたします！(グッズ制作に利用したいのでR-18以外でお願いします、また、衣装等はプラモデルがモチーフの為整合性が取れていない部分がありますので多少Hiyori Kanna様の方で補完、アレンジしてもらっても構いません)\n\n(補足として左耳のピアスの数、形状だけお間違えのないようにお願い致します。上の物がシルバー、下の物が黒、シルバー、黒で全てリング状の物になります)\n\nhttps://x.com/kiyosi9999/status/1870608148413010019?t=6Zj8py44BnFLbvvXsJfvZQ&s=19\n\nhttps://x.com/kiyosi9999/status/1870608259893379366?t=8LVYk7xiHgJ7_VznTh0FcA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@midnight_0232/works/67", "thumbnail_src": "https://si.imgix.net/166dd7d8/uploads/origins/311743a0-1564-44d7-aa66-c0d50d1b7171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ca84ce740bcb5e9fc6e04822c34cebb", "thumbnail_srcset": "https://si.imgix.net/166dd7d8/uploads/origins/311743a0-1564-44d7-aa66-c0d50d1b7171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ca84ce740bcb5e9fc6e04822c34cebb, https://si.imgix.net/166dd7d8/uploads/origins/311743a0-1564-44d7-aa66-c0d50d1b7171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4d38ddc3b42c8f30b4d6daf3e9ed627 2x, https://si.imgix.net/166dd7d8/uploads/origins/311743a0-1564-44d7-aa66-c0d50d1b7171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ca9c4283c975ea2899e715128f4a810 3x", "genre": "art", "nsfw": false, "body": "ひよりさん、こんにちは、\nこちらこそ、よろしくお願いします。\n\nララの新しい衣装のデザインに興味を持っていただき、ありがとうございます。\n私はどちらのアイデアも気に入っていますが、春が訪れようとしていることと、春が一年で最も好きな季節であることを考えると、春のカジュアルな服装の方がずっといいと思います。\n\n春は、誰もが、そしてすべてのものが、より活動的になり、楽しく、明るくなる季節です。\nそんな気持ちをあなたのアートで表現してほしい。\n\nあなたのデザインを楽しみにしています。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/u/0/folders/1XiY_rqZ_LYWaJfwYve8seZ2w1weDFXsH", "created_at": "", "completed_at": ""}, {"path": "/@midnight_0232/works/66", "thumbnail_src": "https://si.imgix.net/31c7cdec/uploads/origins/a156908e-6e95-4543-b169-47384ef11607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04d34f6f4aa196cab1d274f6f1fc9966", "thumbnail_srcset": "https://si.imgix.net/31c7cdec/uploads/origins/a156908e-6e95-4543-b169-47384ef11607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04d34f6f4aa196cab1d274f6f1fc9966, https://si.imgix.net/31c7cdec/uploads/origins/a156908e-6e95-4543-b169-47384ef11607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d338d73dd862e25aaf1becb90676efe6 2x, https://si.imgix.net/31c7cdec/uploads/origins/a156908e-6e95-4543-b169-47384ef11607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d636a4f27ed1abc62708094f8cf7de84 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして。アピールありがとうございます。\n\n私のキャラクター、ミウォシュを描いてください。彼はライオンのフェムボーイです。  彼はトランスジェンダー（女の子として生まれ、今は男の子）なので、とても背が低く、女性的です。  自意識過剰で恥ずかしがり屋なので、たくさんの服を重ね着し、特に大きなパーカーやセーターを着ています。  ピアスやタトゥーが多く、ストリートファッションやグランジファッションが好き。カフェイン（コーヒー、紅茶、エナジードリンク）、エレキベースを弾くこと、メタル／ゴシック／ヴィジュアル系の音楽を聴くこと、ビデオゲームをすること、昼寝をすることが大好き。疲れていることが多く、家猫のように不機嫌になることもある。^^\n\n表情、衣装、ポーズなど自由に描いてください！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1iJZ6Gs2aLtAsaQ3aT0LRqWZ-g5bhY7vl?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@midnight_0232/works/65", "thumbnail_src": "https://si.imgix.net/cb77638e/uploads/origins/17234d97-9408-4dae-8256-1f0a9ceede90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f24724da02b5fc3dca2a48c0c2dde44f", "thumbnail_srcset": "https://si.imgix