itter.com/bravegirls1/status/1154334958783123456?s=20", "created_at": "", "completed_at": ""}, {"path": "/@kirituki_next/works/6", "thumbnail_src": "https://si.imgix.net/b9b3eba1/uploads/origins/f7905563-987e-4cd7-91af-0d551299ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9663ca8d046546cb75db48da21f68702", "thumbnail_srcset": "https://si.imgix.net/b9b3eba1/uploads/origins/f7905563-987e-4cd7-91af-0d551299ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9663ca8d046546cb75db48da21f68702, https://si.imgix.net/b9b3eba1/uploads/origins/f7905563-987e-4cd7-91af-0d551299ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f76a6e47ae0ba0b00eaa57c95d4e28e8 2x, https://si.imgix.net/b9b3eba1/uploads/origins/f7905563-987e-4cd7-91af-0d551299ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6312e592969a81684a1cb216a67e0812 3x", "genre": "art", "nsfw": false, "body": "こんにちは\nブレイヴガールレイヴンズのファンアートを希望します\n新装版ヘレノアの服を着て戦っているセシルさんを描いてくれませんか\nよろしくおねがいします\n\nブレガwikiのセシル\nhttps://bravegirl2.wiki.fc2.com/wiki/%E3%82%BB%E3%82%B7%E3%83%AB \nヘレノア\nhttps://bravegirl2.wiki.fc2.com/wiki/%E3%83%98%E3%83%AC%E3%83%8E%E3%82%A2 \n新装版ヘレノアの寝室\nhttps://i.imgur.com/AT4L7t2.jpg", "created_at": "", "completed_at": ""}, {"path": "/@kirituki_next/works/5", "thumbnail_src": "https://si.imgix.net/a1839034/uploads/origins/37595390-ac2c-4678-8e33-467a863ef627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acebabe4402f18c8c446ddb43ef5bfee", "thumbnail_srcset": "https://si.imgix.net/a1839034/uploads/origins/37595390-ac2c-4678-8e33-467a863ef627?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acebabe4402f18c8c446ddb43ef5bfee, https://si.imgix.net/a1839034/uploads/origins/37595390-ac2c-4678-8e33-467a863ef627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae23b47739426f7df28363ab7205d7e6 2x, https://si.imgix.net/a183