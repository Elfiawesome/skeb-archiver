-3e10-4d3f-b144-f75318cbd6ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8315ca47921924aaa5d12f423f8ea73", "thumbnail_srcset": "https://si.imgix.net/27df2be0/uploads/origins/3db5fd89-3e10-4d3f-b144-f75318cbd6ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8315ca47921924aaa5d12f423f8ea73, https://si.imgix.net/27df2be0/uploads/origins/3db5fd89-3e10-4d3f-b144-f75318cbd6ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be0df5268493dcdb6802c4e9f62b0c93 2x, https://si.imgix.net/27df2be0/uploads/origins/3db5fd89-3e10-4d3f-b144-f75318cbd6ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb6d34ab79990d31e8efd22f6dfb6465 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、是非にとご依頼をさせていただきたくメッセージ送らせていただきました。\nご依頼という事でお願いしたいのはうちの子のイラストをお願いいたします。\nシチュに関してはお任せします、がっちょん様の持つ姫のイメージと世界を描いていただき問題ありません。\n今現在の服装は参考URLに載せていただきました、ご参考にしていただけたら幸いです。\nご面倒をお掛けしますがよろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/z3ktuzjooym7llv/AABERPdf38y0q48XqhMvF9iya?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@gachog/works/1", "thumbnail_src": "https://si.imgix.net/5647782b/requests/231115_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=564e8dbe703a502a70464d9b29e01ffb", "thumbnail_srcset": "https://si.imgix.net/5647782b/requests/231115_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=564e8dbe703a502a70464d9b29e01ffb, https://si.imgix.net/5647782b/requests/231115_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=841ded00570d6d62cf351b37e10177db 2x, https://si.imgix.net/5647782b/requests/231115_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2150d4c63e2d699c1480bc800fe668aa 3x", "genre": "art", "nsfw": false, "body": "skeb開始おめでとうございます。少し遅くなってしまいましたが依頼をさせて頂きます。\n神姫熱が再燃しましたので、よろしければうちのジルダリアのイラストをお願い致します。内容に関しましてはすべてお任せいたします。（ネタっぽいのでも全然OKです）\n一応、今のお気に入りの衣装を載せておき