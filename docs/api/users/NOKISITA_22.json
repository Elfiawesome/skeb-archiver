/1928700656988336473?s=46&amp;t=1ybHbZHivtU1QVFQM5AyPA）のアデライド姫の16:9の壁紙を描いていただきたく思います。 \n\n彼女のデザインが大好きです。特にメガネといたずらっぽい表情がいいですね。豊かな胸と大きなお尻も…。\n\n彼女をヌードで、王家のベッドに親密な雰囲気で横たわる姿で描いていただきたいです。\n\n彼女の表情は、自分に子供を授けてくれる相手への期待に満ちている。\n\n彼女の長い赤い髪と目（メガネあり）を特に際立たせてほしいです。そして、このアートワークには全身を描き入れてほしいです。\n\nもし可能でしたら、アデライド姫がセクシーなランジェリーだけを身に着けた別バージョンもお願いしたいです。 \n\nポーズの参考資料は添付のリンクにあります - https://www.dropbox.com/scl/fo/zccj5al2gebxci7xtbyuj/ABhMJ18aH1PBb92cL5wjTZ0?rlkey=fi14ivuuptxhgcwgzvybdkp9a&st=oujvngzh&dl=0\n\nhttps://www.dropbox.com/scl/fo/zccj5al2gebxci7xtbyuj/ABhMJ18aH1PBb92cL5wjTZ0?rlkey=fi14ivuuptxhgcwgzvybdkp9a&st=oujvngzh&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@NOKISITA_22/works/152", "thumbnail_src": "https://si.imgix.net/6006ccd8/uploads/origins/fdad50c3-1f09-4723-b02f-8ddbdddd4d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bb8463f69f0c6e0cccf9c29296df9bd", "thumbnail_srcset": "https://si.imgix.net/6006ccd8/uploads/origins/fdad50c3-1f09-4723-b02f-8ddbdddd4d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bb8463f69f0c6e0cccf9c29296df9bd, https://si.imgix.net/6006ccd8/uploads/origins/fdad50c3-1f09-4723-b02f-8ddbdddd4d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=188edf57a5e8f14e952c2d4962b90ff3 2x, https://si.imgix.net/6006ccd8/uploads/origins/fdad50c3-1f09-4723-b02f-8ddbdddd4d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99de9004dd66ca1ec5846d7be23e7bb2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NOKISITA_22/works/