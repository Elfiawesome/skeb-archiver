okomiin\n\n背景はビーチで傘をさしてブランケットに座っているような感じでお願いします。https://drive.google.com/drive/folders/1BL1IS5HpBoG2Hsa6t2WEbEy1GjAVNA3x?usp=drive_link。\n\n近くに「Koko-cola」と書かれたガラス瓶に入った炭酸飲料を用意していただけませんか？\n\nありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@Ishijimajirou/works/27", "thumbnail_src": "https://si.imgix.net/164018aa/uploads/origins/de7d6f86-7693-43a2-a16e-3d655d3b78bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86d8e8c4cd44d087e557d2db2febd9d7", "thumbnail_srcset": "https://si.imgix.net/164018aa/uploads/origins/de7d6f86-7693-43a2-a16e-3d655d3b78bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86d8e8c4cd44d087e557d2db2febd9d7, https://si.imgix.net/164018aa/uploads/origins/de7d6f86-7693-43a2-a16e-3d655d3b78bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88b3b5107667185b9193f50fd70843ae 2x, https://si.imgix.net/164018aa/uploads/origins/de7d6f86-7693-43a2-a16e-3d655d3b78bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3067488f0af4d371169de21fa2dd788d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ishijimajirou/works/26", "thumbnail_src": "https://si.imgix.net/f4675c89/uploads/origins/d7f2f0b0-068e-4e77-a32f-7b371d270cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae3865101793d962f57614798ac36ed6", "thumbnail_srcset": "https://si.imgix.net/f4675c89/uploads/origins/d7f2f0b0-068e-4e77-a32f-7b371d270cd6?bg=%2