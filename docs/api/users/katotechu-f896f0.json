しては加糖哲哉さんが考えてる限り描いてください！\n体形に関してはムチムチでもいいですし筋肉質でも構いません！後はそのほかの事は加糖哲哉さんにお任せします！\n\n確認の程よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@katotechu/works/47", "thumbnail_src": "https://si.imgix.net/8930af68/uploads/origins/62455cbd-bc2b-4594-8afe-a04ebb1a2426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca07bd250b18531ef0a9fb13c58e7347", "thumbnail_srcset": "https://si.imgix.net/8930af68/uploads/origins/62455cbd-bc2b-4594-8afe-a04ebb1a2426?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca07bd250b18531ef0a9fb13c58e7347, https://si.imgix.net/8930af68/uploads/origins/62455cbd-bc2b-4594-8afe-a04ebb1a2426?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9887e70ebec75b29dfb12798da014996 2x, https://si.imgix.net/8930af68/uploads/origins/62455cbd-bc2b-4594-8afe-a04ebb1a2426?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71320dea4a507ea2f110903ce8b8eb9f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@katotechu/works/46", "thumbnail_src": "https://si.imgix.net/c5d974ee/uploads/origins/717fbc83-ef48-42c3-b518-4b720284fce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d2ae85d113929cfce7696da907c8fc7", "thumbnail_srcset": "https://si.imgix.net/c5d974ee/uploads/origins/717fbc83-ef48-42c3-b518-4b720284fce4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&