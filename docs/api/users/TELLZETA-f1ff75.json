-4526-847e-66cfeb01fbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31057bfca04e95ca74d684b13c287362", "thumbnail_srcset": "https://si.imgix.net/cb66baf0/uploads/origins/1e58eb4d-86ff-4526-847e-66cfeb01fbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31057bfca04e95ca74d684b13c287362, https://si.imgix.net/cb66baf0/uploads/origins/1e58eb4d-86ff-4526-847e-66cfeb01fbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3f300616158fb94d4eca30866b5e5b2 2x, https://si.imgix.net/cb66baf0/uploads/origins/1e58eb4d-86ff-4526-847e-66cfeb01fbb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f35bdbc2f271cd08499e2cd54e9750e 3x", "genre": "art", "nsfw": false, "body": "テルZETA(テルゼータ)【Skeb募集中】さん、おはようございます。\n先日はありがとうございました！\nこの度、再びリクエストさせていただきます！キャラクターは4人で、ポケモンBWの女主人公のトウコとポケモンBW2の女主人公のメイとポケモンXYの女主人公のセレナとポケモン剣盾の女主人公のユウリです！\n作品はキャラが全身が写っていて、シチュエーションは、トウコとメイとセレナとユウリが裸足になって、レッドブルやモンスターエナジーを片手に持ちながら各々決めポーズをしている感じでお願いします！\nちなみに、4人がそれぞれ持っているのが、トウコとメイがモンスターエナジー、セレナとユウリがレッドブルです！(資料URLに画像を貼っておきます！)\n以上になります、よろしくお願いします！\n\nhttps://www.google.com/imgres?imgurl=https%3A%2F%2Fascii.jp%2Fimg%2F2023%2F07%2F11%2F3568427%2Fxl%2Ff3d5367c6497d2cb.png&tbnid=UuQGXU37m76D_M&vet=1&imgrefurl=https%3A%2F%2Fascii.jp%2Felem%2F000%2F004%2F144%2F4144772%2F&docid=egDZ0ZYcQQ51wM&w=1200&h=800&hl=", "created_at": "", "completed_at": ""}, {"path": "/@TELLZETA/works/14", "thumbnail_src": "https://si.imgix.net/241f361f/uploads/origins/f9228ec6-44cf-4136-850f-136f103511cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6994ccba9b96bf832e655d6e9dd2f7c", "thumbnail_srcset": "https://si.imgix.net/241f361f/uploads/origins/f9228ec6-44cf-4136-850f-136f103511cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6994ccba9b96bf832e655d6e9dd2f7c, https://si.imgix.net/241f361f/uploads/origins/f9228ec6-44cf-4136-850f-136f103511cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92b8a353367f7ff06aa70e87127cdce7 2x, https://si.imgix.net/241f361f/uploads/origins/f9228ec6-44cf-4136-850f-136f103511cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92640662d5b87fb38f977aeb933e8632 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのスタイルが大好きで、私のキャラクターであるジェイド(https://imgur.com/a/A4srrC3)がアニメ(https://imgur.com/a/vK22zxQ)のセレナの2番目の服を着て、その横にアロランナインテールをつけているのをリクエストしたいのですが、もしご面倒でなければ。", "created_at": "", "completed_at": ""}, {"path": "/@TELLZETA/works/13", "thumbnail_src": "https://si.imgix.net/75c57615/uploads/origins/81b16c6c-c562-466b-80c8-6d2a6abb2357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f989ebf9aacd24c833b66994941b48d8", "thumbnail_srcset": "https://si.imgix.net/75c57615/uploads/origins/81b16c6c-c562-466b-80c8-6d2a6abb2357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f989ebf9aacd24c833b66994941b48d8, https://si.imgix.net/75c57615/uploads/origins/81b16c6c-c562-466b-80c8-6d2a6abb2357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6280011f45d16a9a17af86e5f1e04bb 2x, https://si.imgix.net/75c57615/uploads/origins/81b16c6c-c562-466b-80c8-6d2a6abb2357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae9100c526c98717f720dedf81bff6de 3x", "genre": "art", "nsfw": false, "body": "ポケモンSVのダウンロードコンテンツで出てきたゼイユを描いて欲しいです。詳細は以下のとおり\n・ゲームで出てきた甚平姿\n・縁側でお祭り用のペディキュアを塗っている姿\n（色やデザインはお任せします）\n※本編中でネイルしてる描写はありませんが、脚長いからペディキュア似合うかなと思いました。", "created_at": "", "completed_at": ""}, {"path": "/@TELLZETA/works/12", "thumbnail_src": "https://si.imgix.net/cf4e8f09/uploads/origins/e5262c1b-5eec-4b9d-8c14-dffbcb6e5abd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f3e85f89f7378734d5238d3250051c8", "thumbnail_srcset": "https://si.imgix.net/cf4e8f09/uploads/origins/e5262c1b-5eec-4b9d-8c14-dffbcb6e5abd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f3e85f89f7378734d5238d3250051c8, https://si.imgix.net/cf4e8f09/uploads/origins/e5262c1b-5eec-4b9d-8c14-dffbcb6e5abd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=996065e06e9cb01aa0443dab8373bc09 2x, https://si.imgix.net/cf4e8f09/uploads/origins/e5262c1b-5eec-4b9d-8c14-dffbcb6e5abd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a3a4dd2e4dbc2868379fc8111d86d5b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n\n私のキャラクターを描いていただけませんか？\n\n私のキャラクター\nhttps://drive.google.com/file/d/1zlmsB7W7MUTTFlKKXLCeHh22tIYI04Ec/view?usp=drive_link\n\nキャラクター「メインツインテール髪型参考\nhttps://drive.google.com/file/d/1AavZ1a3PsLABtEFiymnubTkkOYAw4mk1/view?usp=sharing\n\n彼女の詳細です：\n【1】人間の女の子\n【2】赤いツインテールの髪と赤い目をしている。\n【3】恥ずかしがり屋\n【4】胸がぺったんこ、またはAカップ。\n【5】身長は149cm前後\n\n目の瞳孔をポケモンBW2のローザのような瞳孔にすることは可能でしょうか？\n\nポーズ\n彼女はポケボールを持っています。今日はポケモントレーナーになる最初の日なので、少し緊張して恥ずかしがっています。\n\n他のポーズを考えている人は、彼女が恥ずかしがっているように見える限り、自由に描いてください。\n\nオプションです：\nカーディガンを羽織っている姿と羽織っていない姿を描いてください。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@TELLZETA/works/11", "thumbnail_src": "https://si.imgix.net/1949f574/uploads/origins/0fdba995-5ffc-48a4-ad2b-4e8f9c671316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9246985b742eb9aff6358d969dac52d2", "thumbnail_srcset": "https://si.imgix.net/1949f574/uploads/origins/0fdba995-5ffc-48a4-ad2b-4e8f9c671316?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9246985b742eb9aff6358d969dac52d2, https://si.imgix.net/1949f574/uploads/origins/0fdba995-5ffc-48a4-ad2b-4e8f9c671316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eed716fef20291ac3656d0c30c429e33 2x, https://si.imgix.net/1949f574/uploads/origins/0fdba995-5ffc-48a4-ad2b-4e8f9c671316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed05526e2428a9a9c74c002aa33b77b3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回に引き続きありがとうございました。魔法少女キャラ2人でお願いしたいことがありました。\n\nアイリス：https://i.ibb.co/DYgtnf0/1793117-2.png\n\nアーニャ。彼女のそばかすを忘れないでください。\nhttps://i.ibb.co/dPBzmQ6/2116238-1.png\n\n身長はどちらも130cm。この前の配信のように、2人でポーズを決めてほしい。\nhttps://skeb.jp/@TELLZETA/works/5\n\n参考写真よりも、もう少し二人の距離が近いといいですね。頬が触れるくらいの距離。アイリスはキスのジェスチャーをして、アーニャは少し恥ずかしそうにしているはずです。ご配慮ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@TELLZETA/works/10", "thumbnail_src": "https://si.imgix.net/588b435e/uploads/origins/f4f55588-8201-4ff1-a2a3-cec283502023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66d8651f045d22dedfa7e8080219da38", "thumbnail_srcset": "https://si.imgix.net/588b435e/uploads/origins/f4f55588-8201-4ff1-a2a3-cec283502023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66d8651f045d22dedfa7e8080219da38, https://si.imgix.net/588b435e/uploads/origins/f4f55588-8201-4ff1-a2a3-cec283502023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d29a02db1642745254d8b655e2215187 2x, https://si.imgix.net/588b435e/uploads/origins/f4f55588-8201-4ff1-a2a3-cec283502023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ab245255a15563ff3a4265ecbf0d661 3x", "genre": "art", "nsfw": false, "body": "テルZETA様、ご無沙汰しております。\n以前は、MyGO!!!!!の愛音ちゃんと色違いメレシーのイラストを描いてくださりありがとうございました！\nとても気に入っており、ずっとブログのアイコンとして使わせていただいております。\n\n今回も他作品とポケモンのクロスオーバーのイラストをリクエストさせていただきます。\n内容や金額に不備があったり、テルZETA様にとって不都合なことがございましたら、遠慮なく再送申請やキャンセル等していただけたらと存じます。\n\n《描いていただきたいもの》\n学園アイドルマスターというゲームに登場する『篠澤 広』というキャラクターと、『ドラパルト(色違い)』\n\n・篠澤 広 ▶︎https://gakuen.idolmaster-official.jp/idol/hiro/ \n・色違いドラパルト ▶︎https://www.serebii.net/pokedex-swsh/dragapult/\n\n○篠澤広は、添付資料内のフォルダにあります「体操服」の衣装で描いていただけますと幸いです。\n○他にも添付資料内に篠澤広のいろいろな表情のスクリーンショットや体操服姿でのライブ映像などもありますので、表情やポーズの参考になれば幸いです。\n○構図や各キャラクターのポーズ・表情などはテルZETA様にお任せいたしますので、ご自由にお描きください。\n\n可能であれば、キャラとポケモンを別レイヤーに分けたもの・背景透過のものもいただけると嬉しいです。\n\nお忙しい中大変恐縮ですが、何卒よろしくお願いいたします。\nどうかご縁がありますように。\n\nhttps://drive.google.com/drive/folders/1--PDzmMGW_dAkzmezEFRQ1WIj96KkjtV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@TELLZETA/works/9", "thumbnail_src": "https://si.imgix.net/ac399cd5/uploads/origins/a6e900d6-0ef7-45e0-b59e-8b16d77b6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b01b6b69b3c023ae5b8e26c6fcf9463", "thumbnail_srcset": "https://si.imgix.net/ac399cd5/uploads/origins/a6e900d6-0ef7-45e0-b59e-8b16d77b6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b01b6b69b3c023ae5b8e26c6fcf9463, https://si.imgix.net/ac399cd5/uploads/origins/a6e900d6-0ef7-45e0-b59e-8b16d77b6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=358cd501636fea834e8672d06a326371 2x, https://si.imgix.net/ac399cd5/uploads/origins/a6e900d6-0ef7-45e0-b59e-8b16d77b6b0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8bde3f4cc7713b12adb549fc64eab1f 3x", "genre": "art", "nsfw": false, "body": "キャラクター：トウコ\n\n彼女がこのポーズで地面に横たわっているのを見たいです：https://sta.sh/21b2i1rjvdta?edit=1 (両手を合わせて指を組んでいる差分も、彼女の手は花を持っているはず)\n顔の上にある天使の光輪は、合掌した両手差分だけに見えるようにする。\n\nアーケードゲームのゲームオーバー画面に似ている。\n\n注：\n彼女の全身を描いてください\nゲームや公式イラストのように太ももを大きく見せてください", "created_at": "", "completed_at": ""}]}