ae5-4f7e-9098-86a6ae1c9c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0d26495c6b1de6771db4a17cf5d34f3, https://si.imgix.net/ef6777d1/uploads/origins/6297c81e-dae5-4f7e-9098-86a6ae1c9c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7aaf95a21b61ace012ee650ccaff7f98 2x, https://si.imgix.net/ef6777d1/uploads/origins/6297c81e-dae5-4f7e-9098-86a6ae1c9c0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e94faf524fe6a71a739615d6544270e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵を見て、とても気に入りました。\nレミリア・ネフィスというVtuberの絵が欲しいです。\n身長は139cmで、胸はとても平らで、お尻が広く、太ももが太いキャラクターです。\nポケモンのメイ（ハルカ）のコスプレをしてほしいです。\nポケモンのトーチカを抱きしめてほしい。\nキャラクターは？\nhttps://imgur.com/a/l1BdZGz\n髪型\nhttps://i.imgur.com/NcTNfYB.png\nコスプレ：\nhttps://files.catbox.moe/jupjii.png\nポケモン\nhttps://files.catbox.moe/53yrjg.png\n柔らかい笑顔のバージョンと、歯が見える笑顔のバージョンが欲しいです。\n背景がある場合、背景ありバージョンと背景なしバージョンが欲しいです。\nTwitterやYouTube、TwitchなどのSNSで使用可能です。NGでしたらお断りさせてください。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@TELLZETA/works/17", "thumbnail_src": "https://si.imgix.net/e6ac9b2d/uploads/origins/05b37be1-e32f-47b5-b97a-c8e11fab4422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a274492653d214cd0e0563eae49d5fa", "thumbnail_srcset": "https://si.imgix.net/e6ac9b2d/uploads/origins/05b37be1-e32f-47b5-b97a-c8e11fab4422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a274492653d214cd0e0563eae49d5fa, https://si.imgix.net/e6ac9b2d/uploads/origins/05b37be1-e32f-47b5-b97a-c8e11fab4422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec284ef280b6a5db8a73524fa57404fc 2x, https:/