ix.net/7fbaed13/uploads/origins/e0caf385-b6f9-409b-a07e-eb3b6e32b611?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1784c2b95ba4719729da5b272cd3e03b, https://si.imgix.net/7fbaed13/uploads/origins/e0caf385-b6f9-409b-a07e-eb3b6e32b611?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23d1795d25af4f8045e7f5040b1b4af9 2x, https://si.imgix.net/7fbaed13/uploads/origins/e0caf385-b6f9-409b-a07e-eb3b6e32b611?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dbaca7bbe07a63e8b144aad768918be 3x", "genre": "art", "nsfw": true, "body": "東方のミスティア・ローレライが騎乗位をしているイラストをリクエストしたいです。\n\nhttps://x.com/newsyamonabe/status/1733532539288248784/photo/1 の雰囲気が好きです。鳥獣伎楽をイメージした黒系のエッチな衣装でお願いします。\n\n男の主観視点風で、顔が近い構図・体位で、いやらしい笑顔をしていると嬉しいです（https://skeb.jp/@newsyamonabe/works/15 のルーミアや https://skeb.jp/@newsyamonabe/works/17 の挿入し始める所が好みです）", "created_at": "", "completed_at": ""}, {"path": "/@newsyamonabe/works/19", "thumbnail_src": "https://si.imgix.net/642e279c/uploads/origins/354a16aa-875a-405f-8623-c12715f0297d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aece9fea7c4b3eb60c37807a674dea66", "thumbnail_srcset": "https://si.imgix.net/642e279c/uploads/origins/354a16aa-875a-405f-8623-c12715f0297d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aece9fea7c4b3eb60c37807a674dea66, https://si.imgix.net/642e279c/uploads/origins/354a16aa-875a-405f-8623-c12715f0297d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11125dc591a0496bb9627e1a6f83b20c 2x, https://si.imgix.net/642e279c/uploads/origins/354a16aa-875a-405f-8623-c12715f0297d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2d377e2c7b14399b219617bedd4453a 3x", "genre": "art", "nsfw": true, "body": "はじめまして、よろしくお願いします。\n今回私のリクエストは\n古明地こいしちゃんがおしっこ出して、\nこいしちゃんの布団でおねしょお漏らしする\n顔が恥ずかしいけど涙がポロポロする\nイラストを描いてもう大丈夫ですか？\nそれでは、もう一度よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@newsyamonabe/works/18", "thumbnail_src": "https://si.imgix.net/3d545970/uploads/origins/834b186c-4f12-4d21-a1b0-191ea24e1e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72b36cef3127931b4bbf5315090ca9e0", "thumbnail_srcset": "https://si.imgix.net/3d545970/uploads/origins/834b186c-4f12-4d21-a1b0-191ea24e1e09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72b36cef3127931b4bbf5315090ca9e0, https://si.imgix.net/3d545970/uploads/origins/834b186c-4f12-4d21-a1b0-191ea24e1e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaa7b75d29904f8c7edfc150c3fe551b 2x, https://si.imgix.net/3d545970/uploads/origins/834b186c-4f12-4d21-a1b0-191ea24e1e09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9149c460a5e41171c0671b9b16e37377 3x", "genre": "art", "nsfw": true, "body": "トイレ前でおもらししちゃったパジャマ姿のルーミアちゃんおねがいします！\nズボンを濡らして裾から派手に水溜りを作って赤面な感じでおねがいします！\n開襟タイプのパジャマで淡い系の色のシンプルなデザインでおねがいします！", "created_at": "", "completed_at": ""}, {"path": "/@newsyamonabe/works/17", "thumbnail_src": "https://si.imgix.net/7dacd99a/uploads/origins/572d6874-8fa8-498d-8339-c41cdd0026e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a622832c930ce4a769d275154b817db", "thumbnail_srcset": "https://si.imgix.net/7dacd99a/uploads/origins/572d6874-8fa8-498d-8339-c41cdd0026e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a622832c930ce4a769d275154b817db, https://si.imgix.net/7dacd99a/uploads/origins/572d6874-8fa8-498d-8339-c41cdd0026e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f83967be839072f6dd80ce0e19a283d7 2x, https://si.imgix.net/7dacd99a/uploads/origins/572d6874-8fa8-498d-8339-c41cdd0026e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=150bd5862930adb6c78ab809a1019426 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n以前描かれていた角オナするナズーリンがとてもよかったです！\nhttps://skeb.jp/@newsyamonabe/works/12\nなので、少し近いシチュエーションにはなりますが、ナズーリンで依頼をさせていただきたいです！\n\n・全体的なシチュエーション\nディルドをつかったオナニーにはまるようになってしまったナズーリン。\n\n・詳細なシチュエーション\n以下のような複数のシチュエーションが含んでいただきたいです。\n①ディルドを自分の手で出し入れして自慰する。\n②別の「床に上向きに固定できるタイプのディルド」を使って騎乗位スタイルで自慰を始めようとするが、想定よりも大きく、入れてすぐに絶頂してしまう。\n③絶頂した後も止まらなくなってしまい、ひたすら腰をうちつけてしまう。\n④幾度も絶頂した後、とろけた顔で横たわりながら、またやろうと心の中で思うナズーリン。\n\n・その他\n角オナナズーリンの時のように、効果音やナズーリン自身のモノローグがあると嬉しいです。\n\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@newsyamonabe/works/16", "thumbnail_src": "https://si.imgix.net/3aea22ad/uploads/origins/f33e52dd-6f62-4a60-8a6f-247d6950bca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b048c7c85608bd9b630eb80e352c00c4", "thumbnail_srcset": "https://si.imgix.net/3aea22ad/uploads/origins/f33e52dd-6f62-4a60-8a6f-247d6950bca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b048c7c85608bd9b630eb80e352c00c4, https://si.imgix.net/3aea22ad/uploads/origins/f33e52dd-6f62-4a60-8a6f-247d6950bca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b360db9bca96b3c1b7d392e6ba611fc 2x, https://si.imgix.net/3aea22ad/uploads/origins/f33e52dd-6f62-4a60-8a6f-247d6950bca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbbdefe7af90c1a628c08179fa6b8d26 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@newsyamonabe/works/15", "thumbnail_src": "https://si.imgix.net/08c3e5a6/uploads/origins/4d784052-671f-48e2-836a-65cd46ee4eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a41cd7ff530f12c4ae7a