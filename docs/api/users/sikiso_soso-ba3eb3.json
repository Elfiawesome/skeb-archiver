bbf6-4946-a17a-e828b85cb56b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82e2dbc90a9bb1f41b0e0874b8dc726f", "thumbnail_srcset": "https://si.imgix.net/a227d67b/uploads/origins/f3a0a334-bbf6-4946-a17a-e828b85cb56b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82e2dbc90a9bb1f41b0e0874b8dc726f, https://si.imgix.net/a227d67b/uploads/origins/f3a0a334-bbf6-4946-a17a-e828b85cb56b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e95665187047fe76a4aaf9a2cd5eab92 2x, https://si.imgix.net/a227d67b/uploads/origins/f3a0a334-bbf6-4946-a17a-e828b85cb56b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64b6018ebf58d9d6e66cf6a8414ad3f4 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\n前回描いていただいた作品がとても気に入ったので、今回もスフェーネと一緒にロマンティックな作品をお願いしたいと思います。\n\n今回のテーマはホリデー／ウィンターです。テサとスフェーンが一緒に暖炉のそばに座っているところを描いてほしいです。私が考えているポーズは、暖炉のそばで暖かい飲み物を一緒に飲んだり、スフェーンがテサの肩に頭を乗せて寄り添ったりするものです。参考となるポーズをgoogle driveのリンクに残しておきましたが、もし他にアイデアがあれば、ぜひ見てみたいです！\n\nテサの新しい衣装と一緒に、google driveのリンクにすべての参考資料を残しておきました。私のリクエストを見てくれてありがとう！\n\nhttps://drive.google.com/drive/folders/11W1qYJem462xUO-tXJKcSMDxQ9QCbcXF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sikiso_soso/works/425", "thumbnail_src": "https://si.imgix.net/1afe26fd/uploads/origins/e9dbc0d6-54af-42c9-abc4-a7f909aa3553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91acc9f7e6d0dcb002a8c1999bd72e21", "thumbnail_srcset": "https://si.imgix.net/1afe26fd/uploads/origins/e9dbc0d6-54af-42c9-abc4-a7f909aa3553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91acc9f7e6d0dcb002a8c1999bd72e21, https://si.imgix.net/1afe26fd/uploads/origins/e9dbc0d6-54af-42c9-abc4-a7f909aa3553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3f54a442d8b3519d9f509e092977f16 2x, https://si.imgix.net/1afe26fd/uploads/origins/e9dbc0d6-54af-42c9-abc4-a7f909aa3553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ece212286b30b47739c916a2b50a82d6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n新年早々、この3人で初詣のテーマが欲しいです！\nいつものように自由に創造してください。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Scg6zCrYlp3YeiHUls78RsfQZkR9bvj6?usp=drive_link\nhttps://drive.google.com/drive/folders/1ih3U78bhF0xx9njNxJXm8QfdLghiey8k?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@sikiso_soso/works/424", "thumbnail_src": "https://si.imgix.net/d54e7070/uploads/origins/39b99d59-1e96-49ac-8727-88f16fec0aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd745fddf715fe36040841b3c63fa94c", "thumbnail_srcset": "https://si.imgix.net/d54e7070/uploads/origins/39b99d59-1e96-49ac-8727-88f16fec0aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd745fddf715fe36040841b3c63fa94c, https://si.imgix.net/d54e7070/uploads/origins/39b99d59-1e96-49ac-8727-88f16fec0aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50d8c6e8f777558636524255b7c9bdd8 2x, https://si.imgix.net/d54e7070/uploads/origins/39b99d59-1e96-49ac-8727-88f16fec0aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b53ef22f0b3c61443d4187101251da82 3x", "genre": "art", "nsfw": false, "body": "こんにちは、しきそさん！いつもお世話になっております！\n数日前、セキとアオイの素晴らしい着物デザインを貰いました！どうしても二人の着物姿のイラストが見たいです！！この繊細なデザインを描くなら、すぐに思い浮かんだのはしきそさんでした。もしよければ、是非また腕前を借りたいです！\n\n着物姿のお二人でお正月をテーマに描いていただきたいです!\n唯一の入用は、アオイのイヤリングとセキの目尻の化粧をそのまま残していただくことだけです。構図、ポーズ、その他はあなたにお任せします。セキアオに関しては、しきそさんを完全に信頼しております！\n\nデザインや新年のテーマがご都合に合わなければ、遠慮なくキャンセルして下さい！迷惑を掛けたくないので。また、遠慮なく価格を調整してくださいね！\n\nいつもありがとうございます。お忙しい中、ご検討本当にありがとうございます！\n楽しいクリスマスと良き新年を迎えられますように✨！\n\nhttps://drive.google.com/drive/folders/1I7tCPGt7vavR7F4Wp9gM06srGuJHDRkk", "created_at": "", "completed_at": ""}, {"path": "/@sikiso_soso/works/423", "thumbnail_src": "https://si.imgix.net/67cb392a/uploads/origins/b373a599-4f4e-4615-b31b-e848b9ee32c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4aebf418a755ea209afc6b9a50b4d7", "thumbnail_srcset": "https://si.imgix.net/67cb392a/uploads/origins/b373a599-4f4e-4615-b31b-e848b9ee32c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4aebf418a755ea209afc6b9a50b4d7, https://si.imgix.net/67cb392a/uploads/origins/b373a599-4f4e-4615-b31b-e848b9ee32c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c63e19b7bcfc6bdb13776c5f35ea78b 2x, https://si.imgix.net/67cb392a/uploads/origins/b373a599-4f4e-4615-b31b-e848b9ee32c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab6367c49e16100fa07d2d6ec2c25dcd 3x", "genre": "comic", "nsfw": false, "body": "敷草先生、こんにちは！前回は素敵な漫画をありがとうございました。今回も私のOCであるエレノアとアルハイゼンをお願いしたいと思います。今回はどんなシチュエーションでもいいので描いてください。˶ᵔ ᵕ ᵔ˶\n\nエレノアは元貴族の北極狐の女の子です。彼女は社交的で、優雅で落ち着いた外見をしている。ヴァイオリンの天才で、芸術的な趣味を愛する。\n\nアルハイゼンゼンは実用性を重んじる知的な男性。趣味は研究、読書。内向的で、人と話すときはとても率直。\n\nエレノアとアルハイゼンハイはお互いに隠れた感情を抱いているが、それは微妙な行動によってのみ示される。二人は互いに大きく異なるため、しばしば妥協する。例えば、アルハイゼンゼンは、エレノアが彼にさりげなく触れることを許す。エレノアは、アルハイゼンゼンが内向的な性格であることを理解しているので、彼が必要とするときにはスペースを与える。\n\nお願いを聞いてくれてありがとう！\n\nhttps://drive.google.com/drive/folders/13j5-RfHL56HLn725CITvwNMt7kVEKPli?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sikiso_soso/works/422", "thumbnail_src": "https://si.imgix.net/0363cfd1/uploads/origins/2bac6ef3-0cbd-4ca2-b492-e9ef4c636094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77b056b20dca3f378dc2eefa4a8262ee", "thumbnail_srcset": "https://si.imgix.net/0363cfd1/uploads/origins/2bac6ef3-0cbd-4ca2-b492-e9ef4c636094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77b056b20dca3f378dc2eefa4a8262ee, https://si.imgix.net/0363cfd1/uploads/origins/2bac6ef3-0cbd-4ca2-b492-e9ef4c