7/uploads/origins/2bca53d7-1fee-49e8-a8b5-a8525e25a8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52b5a3b51633bba0ac1b5aa3e4f4e2be 2x, https://si.imgix.net/b36b22d7/uploads/origins/2bca53d7-1fee-49e8-a8b5-a8525e25a8e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd453468f58f7130c3b712c925ae0625 3x", "genre": "art", "nsfw": false, "body": "こんにちは。リクエスト失礼いたします。\n\nリクエスト内容ですが、両手両足を使ってSwitchとPS5を同時にプレイする大崎甜花をお願いします。\n\n・構図は両手でSwitchを持ちながら、床に置かれたPS5を両足で操作する感じでお願いします。視点と体勢は下記URLみたいなイメージでお願いします。\n\n・衣装はデビ太郎のパーカー姿でお願いします。\n\nご検討の程、何卒よろしくお願いします！\n\nhttps://www.pixiv.net/artworks/102423013", "created_at": "", "completed_at": ""}, {"path": "/@Ronpa88/works/17", "thumbnail_src": "https://si.imgix.net/803f477a/uploads/origins/4a78489f-23c9-4d87-85b3-77620c2dc2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c8c3b6b277ee453d45295dc9696674d", "thumbnail_srcset": "https://si.imgix.net/803f477a/uploads/origins/4a78489f-23c9-4d87-85b3-77620c2dc2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c8c3b6b277ee453d45295dc9696674d, https://si.imgix.net/803f477a/uploads/origins/4a78489f-23c9-4d87-85b3-77620c2dc2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ff3cd742213c416dbae0c735a643577 2x, https://si.imgix.net/803f477a/uploads/origins/4a78489f-23c9-4d87-85b3-77620c2dc2f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=413041fb87f8e70c57f50116e9afd59d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ronpa88/works/16", "thumbnail_src": "https://si.imgix.net/4d368296/uploads/origins/6dc23ae3-af35-47c6-8efc-23f6720fd13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff7e76e92fb60239a22d9769a51c25e", "thumbnail_srcset": "https://si.imgix.net/4d368296/uploads/origins/6dc23ae3-af35-47c6-8efc-23f6720fd13f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff7e76e92fb60239a22d9769a51c25e, https://si.imgix.net/4d368296/uploads/origins/6dc23ae3-af35-47c6-8efc-23f6720fd13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=944db09f4aa5a0cf5609bf9750cf62a7 2x, https://si.imgix.net/4d368296/uploads/origins/6dc23ae3-af35-47c6-8efc-23f6720fd13f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60a8853a818520a625ffaf9993f8a962 3x", "genre": "art", "nsfw": true, "body": "こんばんは\n氷沼悠理という子をお願いします\nhttp://www.getchu.com/sp/soft.phtml?id=1190\nhttps://drive.google.com/drive/folders/1IwML5k39fvT-axqqDQd9sn5Ym7GOIG2q\n元お嬢様で常時敬語、読書が趣味のおっとりとした子です\n華奢で胸は僅かに膨みがある程度(AAカップ)\n乳首は淡い桃色で乳輪乳頭小さめ\n陰毛なし\n\n\n・服装等\nセーラーワンピースの上をはだけて胸露出(腕部分のみ脱がないイメージ)\nhttps://drive.google.com/file/d/1JCC7uSO5FjIPl7ZeK90DeQbr3g-sn9SZ\nhttps://drive.google.com/file/d/19RwSUk6huRNG6fM-Pqc1PQjD_16Pxz4P\n+膝下丈の黒ハイソックス\n下着は上下共シンプルな白ですが、見えないようお願いします(ブラは外す)\n\n\n・シチュ等\n真横からの構図で全身画面内\nhttps://skeb.jp/@rei_namako/works/19\nhttps://skeb.jp/@hutomashi1take/works/22\nの真横版のイメージ(両足は男の腕より内側だと嬉しいです)\n\n男性の背後から抱きついて胸を押し当て\n+\n足を腰の辺りから前に出して両足裏でカリの辺りをガッチリ挟んだ状態での足コキ\n+\n両乳首責め(右は優しく、左は強くのイメージ)\n+\n耳たぶ甘噛みや舐め\nの目を開いた優しい表情\n\n三か所同時(+背中に胸を押し当て)責め\n↓\n大量射精\n↓\nホールドしたままの靴下及び足が精液まみれ\n\n髪や顔、口内から服や足(靴下含む)まで全身に大量ぶっかけ差分もお願いします\n\nレイヤーは可能な限り細かく残し、いろいろなパターンが作れると大変捗ります\n黒ではなく白\n\n\n・背景\n自室想定で白いシーツのベッドの上\n\n\n・男性\n同年代想定で特徴がない普通の男性(全裸)\n顔なしorエロゲの主人公のようなボサボサ頭で目隠れ\n\n\n\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Ronpa88/works/15", "thumbnail_src": "https://si.imgix.net/2722f674/uploads/origins/9b205b47-794c-46e5-8058-682095f0c807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d41d8d6f78905ee1e0a006ec052ba1c0", "thumbnail_srcset": "https://si.imgix.net/2722f674/uploads/origins/9b205b47-794c-46e5-8058-682095f0c807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d41d8d6f78905ee1e0a006ec052ba1c0, https://si.imgix.net/2722f674/uploads/origins/9b205b47-794c-46e5-8058-682095f0c807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cb6b9f7d0f3c4346b18905a4ab75181 2x, https://si.imgix.net/2722f674/uploads/origins/9b205b47-794c-46e5-8058-682095f0c807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a96c9e6833249c823d0cd4289595df30 3x", "genre": "art", "nsfw": true, "body": "はじめまして、Ray先生 \n再送させていただきます。\n\n SyngUp!の新しいファンサとして、ファンを金蹴りで射精させる燐羽様の絵をお願いしたいです。  \n\n男性側の描写としては過去絵の手毬や広のように裸の下半身で、\n燐羽は初星学園の制服を着て蹴り上げているところが全身入る描写で\n\nSyngUp!のファンサというシチュエーションですが手毬や美鈴に関しては驚いている顔だけ入るか、登場無しでも大丈夫です。\n\nあらためて検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Ronpa88/works/14", "thumbnail_src": "https://si.imgix.net/f51994e7/uploads/origins/6d22d257-ef9f-4284-99fe-44e1ee107fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e15690dc42b350f0fd34109c1b3bfaad", "thumbnail_srcset": "https://si.imgix.net/f51994e7/uploads/origins/6d22d257-ef9f-4284-99fe-44e1ee107fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e15690dc42b350f0fd34109c1b3bfaad, https://si.imgix.net/f51994e7/uploads/origins/6d22d257-ef9f-4284-99fe-44e1ee107fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d6bd198959b36e195b05c28d7199f25 2x, https://si.imgix.net/