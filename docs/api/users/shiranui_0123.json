0&h=200&s=ba22995ba85eedf4f5d9eda2530b2309", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "アイカツスターズの香澄真昼。姉の夜空にたっぷり愛撫されてイかされまくった事後というシチュをお願いしたいです。裸でベッドの上で仰向けになった真昼が、とろけた表情で絶頂の余韻にひたっている。股間部分のシーツには大量に潮吹きした跡が染みになって広がっている。夜空はすぐそばで身を起こしていて、真昼のトロ顔を眺めていたり、後戯で髪を撫でていたり（夜空の姿は描かれなくても構いません）。\nご検討よろしくお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@shiranui_0123/works/2", "thumbnail_src": "https://si.imgix.net/456da21c/uploads/origins/40c0c79f-f77d-4e0e-af6d-8700dc315b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52e706f4b1c2d2bb285afc23e9ea906a", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shiranui_0123/works/1", "thumbnail_src": "https://si.imgix.net/9e93ac97/requests/242122_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae01ce62b4b92525221605c63d333457", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}