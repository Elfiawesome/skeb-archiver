-2dfa7e8eeb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eb25e4a5eeb7612e06f18fc8a0f17c0", "thumbnail_srcset": "https://si.imgix.net/c7af2bf9/uploads/origins/f874b499-ee10-4195-90c0-2dfa7e8eeb17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eb25e4a5eeb7612e06f18fc8a0f17c0, https://si.imgix.net/c7af2bf9/uploads/origins/f874b499-ee10-4195-90c0-2dfa7e8eeb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b8b2cfb463f11af0f021848fc3b717f 2x, https://si.imgix.net/c7af2bf9/uploads/origins/f874b499-ee10-4195-90c0-2dfa7e8eeb17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df985035a3d9177de1b561f2808bea7d 3x", "genre": "art", "nsfw": false, "body": "こちらこそ、本当にありがとうございます✨✨\n\n色に関しては、ファイルAを基準にしてください。\n\nhttps://drive.google.com/drive/folders/1FOo-tDjigzAIjeUCO6PJNjARH4g1V_LK", "created_at": "", "completed_at": ""}, {"path": "/@nozuomu/works/19", "thumbnail_src": "https://si.imgix.net/f66b5e16/uploads/origins/eaf10805-e77c-4c01-be96-2a329b383ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bfdf5aa62f7c2fd328d95645b2cf24b", "thumbnail_srcset": "https://si.imgix.net/f66b5e16/uploads/origins/eaf10805-e77c-4c01-be96-2a329b383ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bfdf5aa62f7c2fd328d95645b2cf24b, https://si.imgix.net/f66b5e16/uploads/origins/eaf10805-e77c-4c01-be96-2a329b383ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8702169324a210064b7556183a952c4b 2x, https://si.imgix.net/f66b5e16/uploads/origins/eaf10805-e77c-4c01-be96-2a329b383ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97ed2c2a949244be5909b2e08393cb28 3x", "genre": "art", "nsfw": false, "body": "こんばんは、 ノズオムさん 初めまして。\nツイッターでノズオムさんの絵を見てからぜひリクエストしたいと思て来ました。　\nテーマとか内容はすべておまかせでお願いしたいです。\nよろしくお願いします。\n\n\n\n指は4本、足の指は3本でお願いします。\nうちの子かかけている手錠とか首輪は描かなくてもいいです。\n(状況によって自由に描いてください。構図やスタイルによっては翼を簡単に描いても大丈夫です。)\n\nhttps://drive.google.com/drive/folders/143cDiocWfSb0dbFLZjLVluX1rKrOOMqi?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nozuomu/works/18", "thumbnail_src": "https://si.imgix.net/7dc21b98/uploads/origins/88bd0a08-f51b-4f2a-80cc-790036d703a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7b64fb8cb839d4de7c7d9cf06a78454", "thumbnail_srcset": "https://si.imgix.net/7dc21b98/uploads/origins/88bd0a08-f51b-4f2a-80cc-790036d703a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7b64fb8cb839d4de7c7d9cf06a78454, https://si.imgix.net/7dc21b98/uploads/origins/88bd0a08-f51b-4f2a-80cc-790036d703a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab673d2ec3e2db1afd9a10f9f3205c2d 2x, https://si.imgix.net/7dc21b98/uploads/origins/88bd0a08-f51b-4f2a-80cc-790036d703a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83fa89eb19085e13fd9e55e356d1a8cd 3x", "genre": "art", "nsfw": false, "body": "フォッフォッフォ！ワシは謎のFurmony大好きおじさんじゃ！\n今回はクッソドヤ顔で作業妨害してくるクソガキチディくん概念をお願いするぞい！\nキーボードをぺちぺちしだしたり、マウスで遊び出したり、読書中急に飛びついてきたり、掃除の邪魔してきたり、、、かまってちゃん全開で頼むぞい！\nどんなシチュかはノズオムさんにおまかせじゃ！3パターンくらいあると嬉しすぎて失神するぞい！\n匿名はonにしてあるのじゃが、謎のFurmony大好きおじさんからの依頼という形で公表して頂いて大丈夫じゃぞ！\nでは、さらばじゃ！フォーーーッフォッフォッフォ！\n\nhttps://x.com/marioluigi633/status/1883156509330452691?t=qxF0xJlv4rBJl5l89ZFY6w&s=19", "created_at": "", "completed_at": ""}, {"path": "/@nozuomu/works/17", "thumbnail_src": "https://si.imgix.net/b09c6f81/uploads/origins/48265386-7b2a-4b14-acd3-f5839003d1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b0d3e8921a586b86f595f7809233725", "thumbnail_srcset": "https://si.imgix.net/b09c6f81/uploads/origins/48265386-7b2a-4b14-acd3-f5839003d1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b0d3e8921a586b86f595f7809233725, https://si.imgix.net/b09c6f81/uploads/origins/48265386-7b2a-4b14-acd3-f5839003d1bb?bg=%23ff