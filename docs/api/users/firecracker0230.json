5c/uploads/origins/1248d3b3-cd57-48a5-ab1b-889ba342f8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43a5f61b3055f89cb0e6c3950c16b36a 2x, https://si.imgix.net/7b7ff15c/uploads/origins/1248d3b3-cd57-48a5-ab1b-889ba342f8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=193a676d98a8aaee733eaac10634c929 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@firecracker0230/works/8", "thumbnail_src": "https://si.imgix.net/aff4dcf5/uploads/origins/4243b0e7-591a-4085-acc1-d855c9ecfaf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49060cda19eb0964f54ef798a4750ccc", "thumbnail_srcset": "https://si.imgix.net/aff4dcf5/uploads/origins/4243b0e7-591a-4085-acc1-d855c9ecfaf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49060cda19eb0964f54ef798a4750ccc, https://si.imgix.net/aff4dcf5/uploads/origins/4243b0e7-591a-4085-acc1-d855c9ecfaf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0646ddca24d9554bfc62c4079d642946 2x, https://si.imgix.net/aff4dcf5/uploads/origins/4243b0e7-591a-4085-acc1-d855c9ecfaf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=383247b68d2995e206ba6ddadb5db659 3x", "genre": "art", "nsfw": false, "body": "この2人のキャラクターを依頼したいのですが。ユル（ピンク髪）、ラエル（黒髪）\n\nYllはおっちょこちょいで二面性があるが、Laelに対してはとても誠実で正直である。\nラエルは頑固で、自分の感情に対してとても保守的です。\nユルはラエルの存在を切望する片思い。(しかし、相手が同じように感じているかどうかはわからない。\n\nユルはヘアアクセサリーなし、ラエルはロングヘアーのデザインで、黒のパンツも着用しています。自由に描いていただいて結構です。\n\n設定としては、一緒にお花見をしているところを見たいです。\n\n参考：https://drive.google.com/drive/u/0/folders/1SDda-BLNVOwuCpqjdFQ-MmRpTInxFNmL", "created_at": "", "completed_at": ""}, {"path": "/@firecracker0230/works/7", "thumbnail_src": "https://si.imgix.net/4be543cf/uploads/origins/e4628f9e-cf31-4f35-8be7-58736453cf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fdc6a1df4635b492511f366d79432af", "thumbnail_srcset": "https://si.imgix.net/4be543cf/uploads/origins/e4628f9e-cf31-4f35-8be7-58736453cf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fdc6a1df4635b492511f366d79432af, https://si.imgix.net/4be543cf/uploads/origins/e4628f9e-cf31-4f35-8be7-58736453cf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83b5c0cca47cb62be47b0b4e7d5c123a 2x, https://si.imgix.net/4be543cf/uploads/origins/e4628f9e-cf31-4f35-8be7-58736453cf6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718691dd863c962d8ce36706eb064855 3x", "genre": "art", "nsfw": false, "body": "はじめまして、いつもひいろ様の素敵な作品を拝見させていただいております！\nひいろ様の物の質を感じさせる透き通る様な美しい色塗りが大好きで、今回思い切ってSkeb依頼をさせていただきました。\n今回TRPGで使用している私と友人(許可済)のオリキャラのリクエストを失礼致します。\n和風系アイドル「龍虎」というユニットを組んでいる2人の5周年記念にお披露目した、和中華風衣装での1枚絵をお願いします。\n\n■キャラクター\n暁虎琉\nモチーフ：虎、太陽\n年齢：26　\n身長：176\n肌色：褐色\n体格：ややしっかりめ\n瞳：つり目/琥珀色/虎の目のように眼孔が黒く丸い\nその他：両耳にピアス1つずつ/八重歯\n性格：表情豊かで明るく笑顔が多い陽キャ/頭はキレる方で食えないやつ\n愛嬌の良さと艶やかな雰囲気を出したりなどギャップで売っている\n\n夜月龍\nモチーフ：龍と月\n年齢：26\n身長：175\n肌色：色白\n体格：細身\n瞳：つり目/梔子色/爬虫類のように眼光が黒く縦に細い\nその他：両耳にピアス1つずつ/下睫毛1本長く特徴的/眉毛くっきりめ/アホ毛あり\n性格：真面目でストイック/冷静クールかと思いきや少し天然が入っている\n静かに微笑んでいる事も多いが、要所要所で的確にファンサを仕込んでいくタイプ\n\n■リクエスト内容\nアイドルとして和中華風衣装を身に纏ってる2人、ライブ会場というよりPV撮影のような1枚絵。\n少し浮世離れしたような人外的な雰囲気を持つ2人なのでそういった雰囲気があると嬉しいです！\n細々とした部分は省略したりひいろ様の描きやすい形で描いていただければなと\nその他構図やポーズなどお任せ致します。\n\n\n■資料(リンク先Twitterになります)\n暁虎琉\nhttps://twitter.com/eibon_kt/status/1449020592485666817?s=20&t=6L8Tlvd_Gob049o_BoW5bQ\n夜月龍\nhttps://twitter.com/KogeMOFU/status/1449022146563350540?s=20&t=6L8Tlvd_Gob049o_BoW5b\n3枚目の画像\nhttps://twitter.com/eibon_kt/status/1500821234828791808?s=20&t=6L8Tlvd_Gob049o_BoW5bQ", "created_at": "", "completed_at": ""}, {"path": "/@firecracker0230/works/6", "thumbnail_src": "https://si.imgix.net/a4adb4b7/uploads/origins/28079