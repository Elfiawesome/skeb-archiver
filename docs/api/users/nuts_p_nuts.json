ated_at": "", "completed_at": ""}, {"path": "/@nuts_p_nuts/works/18", "thumbnail_src": "https://si.imgix.net/393f6396/uploads/origins/236344f5-5d77-4427-a452-f7e6ea585069?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f72fa493554967dff3fc18f05c8617", "thumbnail_srcset": "https://si.imgix.net/393f6396/uploads/origins/236344f5-5d77-4427-a452-f7e6ea585069?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f72fa493554967dff3fc18f05c8617, https://si.imgix.net/393f6396/uploads/origins/236344f5-5d77-4427-a452-f7e6ea585069?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9977e91a07804bd8a5810c1d386331b 2x, https://si.imgix.net/393f6396/uploads/origins/236344f5-5d77-4427-a452-f7e6ea585069?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=087978ee864769958fdeef0b8ad624e7 3x", "genre": "art", "nsfw": true, "body": "NUTSさん,\nリクエスト受付に復帰していただき、ありがとうございます久々にジャンヌが描かれるベッドでくつろぐ彼女を描いてくれませんか？R18でも普段着でも構いません。", "created_at": "", "completed_at": ""}, {"path": "/@nuts_p_nuts/works/17", "thumbnail_src": "https://si.imgix.net/15ed491e/uploads/origins/4e624e81-994b-4776-8091-3e836874ee8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b55fe65351771575b4fa0bf753b3b4", "thumbnail_srcset": "https://si.imgix.net/15ed491e/uploads/origins/4e624e81-994b-4776-8091-3e836874ee8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3b55fe65351771575b4fa0bf753b3b4, https://si.imgix.net/15ed491e/uploads/origins/4e624e81-994b-4776-8091-3e836874ee8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16a3f1056bcd4ed53baa932c2f59075b 2x, https://si.imgix.net/15ed491e/uploads/origins/4e624e81-994b-4776-8091-3e836874ee8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=387933255a281bef55f8ebc27c00b68c 3x", "genre": "art", "nsfw": false, "body": "ブルーアーカイブより、氷室セナをお願いします。\nブルアカの推しの1人ですが、あまりファンアート見ない