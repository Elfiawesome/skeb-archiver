s/115178143\n\nあくまで希望ですが、完成した作品は可能であればpixivに公開して頂けるとうれしいです（もしくはSNS・掲示板等に掲載される可能性があります）。獣化兵シリーズリクの用途は全てこの使い方なので今後同じくして頂けると幸いです\nご検討宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@higanorio/works/74", "thumbnail_src": "https://si.imgix.net/3a27c953/uploads/origins/14fc6c50-aa27-4770-a5a7-e5702105b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e252c4be0de6e78d81b18bdf6ccea763", "thumbnail_srcset": "https://si.imgix.net/3a27c953/uploads/origins/14fc6c50-aa27-4770-a5a7-e5702105b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e252c4be0de6e78d81b18bdf6ccea763, https://si.imgix.net/3a27c953/uploads/origins/14fc6c50-aa27-4770-a5a7-e5702105b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=757fe51576b6d26f47f5d4074e8dddc8 2x, https://si.imgix.net/3a27c953/uploads/origins/14fc6c50-aa27-4770-a5a7-e5702105b14f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6edaf4b79c5f119d135a74a2b1fac7f7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@higanorio/works/73", "thumbnail_src": "https://si.imgix.net/4cb92c3f/uploads/origins/a1b4dd93-2d0f-4789-b87d-b989bab51ce1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=798722ccd36058400dc823c6677fb01a", "thumbnail_srcset": "https://si.imgix.net/4cb92c3f/uploads/origins/a1b4dd93-2d0f-4789-b87d-b989bab51ce1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=798722ccd36058400dc823c6677fb01a, https://si.imgix.net/4cb92c3f/uploads/origins/a1b4dd93-2d0f