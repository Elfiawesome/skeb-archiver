s/4b0dca3c-35a9-4627-b41a-0c969924fdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bce586f2cc7c0ca7550432ada8083e9a", "thumbnail_srcset": "https://si.imgix.net/33954e5e/uploads/origins/4b0dca3c-35a9-4627-b41a-0c969924fdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bce586f2cc7c0ca7550432ada8083e9a, https://si.imgix.net/33954e5e/uploads/origins/4b0dca3c-35a9-4627-b41a-0c969924fdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f7ade5d0b29dd762185a509892246d9 2x, https://si.imgix.net/33954e5e/uploads/origins/4b0dca3c-35a9-4627-b41a-0c969924fdf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a24310d14f1d7532c9bc50d011eb46b 3x", "genre": "art", "nsfw": true, "body": "こんにちは！またアートをお願いしたいと思っています！\n私のOC（https://drive.google.com/file/d/1Z-rpYnjkcPVg3n94T8RqDtzDd8QcnpgB/view?usp=drivesdk）にシンプルなサンドレスを着せてもらうことは可能でしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@underchikichan/works/38", "thumbnail_src": "https://si.imgix.net/a20a2317/uploads/origins/448c3686-12e6-4972-a0d5-1695688005bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e2b5015268533fd546ad4251585037e", "thumbnail_srcset": "https://si.imgix.net/a20a2317/uploads/origins/448c3686-12e6-4972-a0d5-1695688005bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e2b5015268533fd546ad4251585037e, https://si.imgix.net/a20a2317/uploads/origins/448c3686-12e6-4972-a0d5-1695688005bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ba7ff20e5d888ea7742ae754f77adb9 2x, https://si.imgix.net/a20a2317/uploads/origins/448c3686-12e6-4972-a0d5-1695688005bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6aae968d62afa6deaa7f157bf39a4f02 3x", "genre": "art", "nsfw": true, "body": "こんにちは、また来ました！\n\n他の方々にも依頼をするのですが、一定の体型が必要なようなので\n今回は私のキャラクターのキャラクターシートを作っていただけませんか？\nhttps://imgur.com/a/v5OmTnx\n\n形式は特