5a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deace6e135c0cd35a860c10061bee855 2x, https://si.imgix.net/2c2f8d57/uploads/origins/0dc061ab-b00b-4a6b-9ad2-f12b9d05a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cce4b3c746716092e570ae5bf9ae203 3x", "genre": "art", "nsfw": false, "body": "私のキャラクター、マルセリーヌのアートをお願いしたい。彼女はカジュアルなペルソナを超えて、実はサフォスの王子なんだ。いざとなれば正装もするし、戦闘服にもなる。海軍大国の後継者として、船の指揮もお手の物。のんびり屋で浮気性な性格はまったく変わっておらず、恋人の好みは美人で高貴な身分の女性で、王子様のような魅力とカリスマ性を使ってそのような女性を確保する。残念ながら、王家の血筋を継ぐためには、男性の妃も見つけなければならない。\n\nお好きなように描いてください。\n\nhttps://drive.google.com/drive/folders/1QLrhKUUPMNht352UzsSMUP7FXoytA2w2", "created_at": "", "completed_at": ""}, {"path": "/@ageha_asg/works/151", "thumbnail_src": "https://si.imgix.net/5f54eeb2/uploads/origins/70c92382-1f97-4512-9e3a-d458cfb84f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c92f72b7ecadd4a933176576ee1831", "thumbnail_srcset": "https://si.imgix.net/5f54eeb2/uploads/origins/70c92382-1f97-4512-9e3a-d458cfb84f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c92f72b7ecadd4a933176576ee1831, https://si.imgix.net/5f54eeb2/uploads/origins/70c92382-1f97-4512-9e3a-d458cfb84f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=898f3060e2688eacacc30bf574ec0dc9 2x, https://si.imgix.net/5f54eeb2/uploads/origins/70c92382-1f97-4512-9e3a-d458cfb84f92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e6b8f1b0ab9938e729a5adf8cb9830b 3x", "genre": "art", "nsfw": false, "body": "私のキャラクター、アンリのアートをお願いしたいのです。彼はマルセリーヌの弟で、彼女とは正反対で、他の男性に興味を持つ女々しい少年です。彼女は外向的で浮気性だが、彼は控えめで上品。風魔法を得意とする魔道士だが、最後の手段として小刀を使った護身術の訓練も受けている。余暇にはお茶会を開いたり、出席したりするのが趣味。姉と同様、ブラウスにミサゴが魚を捕らえる姿を描いた銅製のピンをつけている。\n\nお好きなように描いてください。\n\nhttps://drive.google.com/drive/folders/1VzfKzeA5vvTZgZdN_7-W-0QnslZT-Z4Y", "created_at": "", "completed_at": ""}, {"path": "/@ageha_asg/works/150", "thumbnail_src": "https://si.im