6739/uploads/origins/6da2a871-3c0f-4e5e-9cda-7c4a44d250ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c560efaee16320790c0d6087220ffe3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@red_rokomoko/works/18", "thumbnail_src": "https://si.imgix.net/520b4342/uploads/origins/d0bcf532-ead7-4d29-be9f-4148727a08ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd7f080aafe9e43cd24ac468de8d897f", "thumbnail_srcset": "https://si.imgix.net/520b4342/uploads/origins/d0bcf532-ead7-4d29-be9f-4148727a08ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd7f080aafe9e43cd24ac468de8d897f, https://si.imgix.net/520b4342/uploads/origins/d0bcf532-ead7-4d29-be9f-4148727a08ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca84bfb16a2fc3b7026a5f61841f9e31 2x, https://si.imgix.net/520b4342/uploads/origins/d0bcf532-ead7-4d29-be9f-4148727a08ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7d693b6615a19a6bde04fcefb8b5070 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@red_rokomoko/works/17", "thumbnail_src": "https://si.imgix.net/22607351/uploads/origins/d385e542-35bd-4d3b-994f-a24197a94ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6330362831c3b1203e9175135992430f", "thumbnail_srcset": "https://si.imgix.net/22607351/uploads/origins/d385e542-35bd-4d3b-994f-a24197a94ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6330362831c3b1203e9175135992430f, https://si.imgix.net/22607351/uploads/origins/d385e542-35bd-4d3b-994f-a24197a94ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b322ad30b522fa7831d1928bb0a429d9 2x, https://si.imgix.net/22607351/uploads/origins/d385e542-35bd-4d3b-994f-a24197a94ac7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56a8cb882e6f3e27bd1997fddcc6c2b9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！今回のリクエストは、あなたが昔作ったWIPで、未完成だったものを見返しています：\n- https://twitter.com/red_rokomoko/status/1654474576863326209\n(いつか完成するかもしれません！)\n\nルギア/シャドールギア（ヒーロー/ダーク \"堕落した \"ヒーロー）のスーツを描くのが好きなので、そのようなスーツを続けたいと思っています！このようなポケモンの描き方も好きです：\n- https://twitter.com/red_rokomoko/status/1737592828442849378.\n\nただ、ギラティナの代わりにアルセウスをイメージしたものを描いてほしいです。私が考えている2つのバージョンは、選ばれているタイプに基づいています：\n- ノーマル\n- ダーク\n(アルセウスはダークプレート/タイプの影響下にあるとはいえ、悪ではないだろう。ダーク(アルセウスがダークプレート/タイプの影響を受けていても悪にはならない。）\nポーズはお任せしますが、できればタイプに合わせてポーズを変えていただけませんか？\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@red_rokomoko/works/16", "thumbnail_src": "https://si.imgix.net/ac604506/uploads/origins/75d4ad57-8abb-4ed0-bc6c-ad19577a7448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a00a290f4cf46d69e591e2588b87d1a", "thumbnail_srcset": "https://si.imgix.net/ac604506/uploads/origins/75d4ad57-8abb-4ed0-bc6c-ad19577a7448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a00a290f4cf46d69e591e2588b87d1a, https://si.imgix.net/ac604506/uploads/origins/75d4ad57-8abb-4ed0-bc6c-ad19577a7448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d64bfa703ee21133399dcb586fe67d11 2x, https://si.imgix.net/ac604506/uploads/origins/75d4ad57-8abb-4ed0-bc6c-ad19577a7448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79af1452b5b96e73a1188c2d7c4aee75 3x", "genre": "art", "nsfw": false, "body": "前回に引き続き、メカけものヘッドラバースーツを着た紅葉のイラストをありがとうございました。\nhttps://skeb.jp/@red_rokomoko/works/9\n\nもしよろしければ、紅葉が着ぐるみを着たままの続きをお願いしたいです。\n\n仕様は前回と同様です：\nこのイラストの2つのバリエーション：\n1.メカけものヘッド口閉じ\n2.口が開き、紅葉の顔が見える状態。\n\nこれも、前のリクエストと同じように、台詞を横にずらす。\n\nこのイラストのシチュエーションに指定はないだろう。コスチュームについては教えていただけると嬉しいですが、全体的なシチュエーションはお任せします。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@red_rokomoko/works/15", "thumbnail_src": "https://si.imgix.net/c8e40654/uploads/origins/9d569336-4512-4fa3-9257-c1904b8c5bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c905d4f6622b0b414d6f78ec063fa8c8", "thumbnail_srcset": "https://si.imgix.net/c8e40654/uploads/origins/9d569336-4512-4fa3-9257-c1904b8c5bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c905d4f6622b0b414d6f78ec063fa8c8, https://si.imgix.net/c8e40654/uploads/origins/9d569336-4512-4fa3-9257-c1904b8c5bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25073bba4bfc11a6106de01b01b0c517 2x, https://si.imgix.net/c8e40654/uploads/origins/9d569336-4512-4fa3-9257-c1904b8c5bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74cf0824d667cd5b04aaea8bdcb2fe95 3x", "genre": "art", "nsfw": false, "body": "ルギア／シャドー・ルギアのリクエストに応えてくれて、とても嬉しかった！だから、もしあなたが気にしないなら、私はそのようなことを続けたいです！XD\n\nこのリクエストでは、バリエーションは僕の前回のリクエストhttps://www。pixiv.net/ja/artworks/106929346。このことを念頭に置いて、（人型／ヒーローの）ルギアそのもの（体と顔）を使うというテーマを維持したいと思っています；前回のPixivのリクエストと同様です。バリエーションはこれらを参考にすることができます：\n(1) https://twitter.com/red_rokomoko/status/1646418801481895937\n(2) https://twitter.com/red_rokomoko/status/1659682478850994176\n\n(願わくば、この2つのアイデアは、前のSkebのリクエストの「(3)」と「(4)」と合わせても意味があります。）ありがとうございました！", "created_at": "", "completed_at": ""}]}