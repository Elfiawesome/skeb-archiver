している」というものです。\n具体的に分身の数は4人ほどで、ルナマリアは二穴に挿入されて、両手で男性器をもってそれに舌を伸ばしているという構図でお願いできますでしょうか。\n\n男性の顔等は描かなくても大丈夫ですが、ただ台詞や体の一部等でシンとわかるようにしていただけると幸いです。\nまた、可能でしたら、表情や全体への汁差分等お願いします。\n\n色々とすみません、何卒、よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@jeminiremu/works/55", "thumbnail_src": "https://si.imgix.net/d8930098/uploads/origins/9fd3bb96-bcce-4f8e-9ec3-c52b06b85b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf3ce17e652f9e7837baa3ba74941fe", "thumbnail_srcset": "https://si.imgix.net/d8930098/uploads/origins/9fd3bb96-bcce-4f8e-9ec3-c52b06b85b03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf3ce17e652f9e7837baa3ba74941fe, https://si.imgix.net/d8930098/uploads/origins/9fd3bb96-bcce-4f8e-9ec3-c52b06b85b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0ed155b8780fe6e9233d259cb6cbb6a 2x, https://si.imgix.net/d8930098/uploads/origins/9fd3bb96-bcce-4f8e-9ec3-c52b06b85b03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6313df9a070715d54af1629788f18c62 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jeminiremu/works/54", "thumbnail_src": "https://si.imgix.net/0c23ce0e/uploads/origins/738723ea-0c44-481e-9f6b-dfd178037057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb19e8ee7d7c575cc7fd14227a10700a", "thumbnail_srcset": "https://si.imgix.net/0c23ce0e/uploads/origins/738723ea-0c44-481e-9f6b-dfd178037057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb19e8ee7d7c575cc7fd14227a10700a