したいです。\n犬耳はそのまま残して、片目が隠れる前髪の雰囲気を維持していただけると嬉しいです。\nアイパッチのデザインも新しくアレンジしていただいて大丈夫です。\n髪の長さはあまり長くならないようにお願いしたいです。\n\nそして、もし可能であれば、和服以外の新しい衣装デザインもお願いしたいです。\n\nご検討いただけましたら本当に嬉しいです。\nどうぞよろしくお願いいたします…！❄️💖\n\nhttps://drive.google.com/drive/folders/18NHP694nl6iTQ9H4-dVgH_1jrr7qFHca", "created_at": "", "completed_at": ""}, {"path": "/@3359QQ/works/19", "thumbnail_src": "https://si.imgix.net/98f47657/uploads/origins/66e0d1ec-fbef-4f6e-8afd-516bd84364f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a4381e49e4a92368aa84055215bf4dc", "thumbnail_srcset": "https://si.imgix.net/98f47657/uploads/origins/66e0d1ec-fbef-4f6e-8afd-516bd84364f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a4381e49e4a92368aa84055215bf4dc, https://si.imgix.net/98f47657/uploads/origins/66e0d1ec-fbef-4f6e-8afd-516bd84364f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcec3f16f04492eb945812212a130f8b 2x, https://si.imgix.net/98f47657/uploads/origins/66e0d1ec-fbef-4f6e-8afd-516bd84364f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e2ddd854208dfb49b97d201c3a9ae3a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@3359QQ/works/18", "thumbnail_src": "https://si.imgix.net/fbc851f1/uploads/origins/d2bdffb5-e2d1-4369-91ff-1c525e1ae51e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1349f9192898c13dc0d5ccd1e3dee589", "thumbnail_srcset": "https://si.imgix.net/fbc851f1/uploads/origins/d2bdffb5-e2d1-4369-91ff-1c525e1ae51e?bg=%23fff&auto=format%2Ccompress&fm=webp