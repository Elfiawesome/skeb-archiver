。水滴のようなパールが髪の毛やスカートに複数個ついています。\n\n■用途\nいただいたイラストは個人での鑑賞のほか、趣味の範囲でSNSのヘッダーやアイコンに使用する等させていただければと思います。\n\n🐟さんのお好きなように描いてくださるとうれしいです！\nよければご検討ください🙇‍♀️よろしくお願いします……！", "created_at": "", "completed_at": ""}, {"path": "/@admmdk/works/63", "thumbnail_src": "https://si.imgix.net/b2b0d364/uploads/origins/1754ffe6-6394-44d2-bcbe-c7e29f14171f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f59ecb6328a9a6538dcf55661be06b04", "thumbnail_srcset": "https://si.imgix.net/b2b0d364/uploads/origins/1754ffe6-6394-44d2-bcbe-c7e29f14171f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f59ecb6328a9a6538dcf55661be06b04, https://si.imgix.net/b2b0d364/uploads/origins/1754ffe6-6394-44d2-bcbe-c7e29f14171f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2f2ec92baaad81bbdaf593238ba93ec 2x, https://si.imgix.net/b2b0d364/uploads/origins/1754ffe6-6394-44d2-bcbe-c7e29f14171f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3102231a03b6d3024159ae78b7423452 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@admmdk/works/62", "thumbnail_src": "https://si.imgix.net/bbacfdc6/uploads/origins/86ef1cd3-3468-4edb-a4e2-12e9509f7882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfb7e530d4fda363a51d6666ee51e9f7", "thumbnail_srcset": "https://si.imgix.net/bbacfdc6/uploads/origins/86ef1cd3-3468-4edb-a4e2-12e9509f7882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w