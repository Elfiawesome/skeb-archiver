c-8d75-5879d5ea0eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7183428c96f28d7ff18bc43a10ac2d94", "thumbnail_srcset": "https://si.imgix.net/fcb3100d/uploads/origins/69515910-51c9-4c2c-8d75-5879d5ea0eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7183428c96f28d7ff18bc43a10ac2d94, https://si.imgix.net/fcb3100d/uploads/origins/69515910-51c9-4c2c-8d75-5879d5ea0eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c957b80ef24e9a8a032cb0ddf782324 2x, https://si.imgix.net/fcb3100d/uploads/origins/69515910-51c9-4c2c-8d75-5879d5ea0eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3b80f29a37bb5a96fc514b47638a765 3x", "genre": "art", "nsfw": false, "body": "こんにちは、今回もvtuberのキャラクターをお願いしたいと思います！前の作品がとても気に入っていたので、ありがとうございました。\n\n腕に花をいっぱいつけて、楽しそうに落ちたり跳ねたりしているようなポーズで、花びらが周りにあったり、水の中にあったりするような感じでお願いしたいです。身長は157cm、バストサイズはD～DDで左にほくろがあり、体重は50kgです。これは、私のソーシャルメディアやユーチューブに公平に使用されます。\n\n投稿する場合は、ツイッターで「#niniatelier」を使ってください！ご検討よろしくお願いします。今回も楽しみにしています\n\nhttps://sta.sh/21u7moue5y87", "created_at": "", "completed_at": ""}, {"path": "/@guruguru_7suB/works/30", "thumbnail_src": "https://si.imgix.net/22e9f715/uploads/origins/04ba11ff-c326-4a12-8301-19a22c427014?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc48ecea032ed0c0083246b48ba4c5d5", "thumbnail_srcset": "https://si.imgix.net/22e9f715/uploads/origins/04ba11ff-c326-4a12-8301-19a22c427014?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc48ecea032ed0c0083246b48ba4c5d5, https://si.imgix.net/22e9f715/uploads/origins/04ba11ff-c326-4a12-8301-19a22c427014?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee8261d00dec0935899340ae0752a589 2x, https://si.imgix.net/22e9f715/uploads/origins/04ba11ff-c326-4a12-8301-19a22c427014?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f396b8d93823065968c9d82aa99ad10 3x", "genre": "art", "nsfw": false, "body": "またリクエストを開いてくれたことが嬉しいです。\n\n私のキャラクターであるアリシアを、今度は普段着でお願いします。彼女の元気で自信に満ちた性格を表現できるような、キュートでダイナミックなポーズをお願いします。また、金色のアクセサリーの形は自由にアレンジしてください。魔法の力で形が変わります。  ポーズ、表情、背景、構図など、すべてお任せします。\n\nご検討のほど、よろしくお願いいたします。\n\nアリシア： https://sta.sh/23pn4u0z36w?edit=1\n\nhttps://sta.sh/23pn4u0z36w?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@guruguru_7suB/works/29", "thumbnail_src": "https://si.imgix.net/8486d921/uploads/origins/020e878b-2394-4ff1-ac84-b6d25a95c428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0244bb76b18305cfd6155a6e33f4a723", "thumbnail_srcset": "https://si.imgix.net/8486d921/uploads/origins/020e878b-2394-4ff1-ac84-b6d25a95c428?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0244bb76b18305cfd6155a6e33f4a723, https://si.imgix.net/8486d921/uploads/origins/020e878b-2394-4ff1-ac84-b6d25a95c428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d3386ac64721515a0154527ce946c66 2x, https://si.imgix.net/8486d921/uploads/origins/020e878b-2394-4ff1-ac84-b6d25a95c428?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85f78ab9be8ffb696bdb8fdb845ac46a 3x", "genre": "art", "nsfw": false, "body": "とぐろなすさま\n\nはじめまして…！個人勢Vtuberとして活動しております、紗彩木ひそりと申します！\nTwitter＊https://twitter.com/Sasayaki_Hisori\nYoutube＊https://www.youtube.com/channel/UCHCbWdtJmZX9pEFtSye_juA\n\nずっととぐろなすさまの描かれる女の子の表情が好きで、大ファンで…！\nリクエスト再開されたと聞き、飛んできました…！(´；ω；`)✨\n\n使用用途＊SNS（Twitter・Youtube）での活用\n（収益化ON状態もあるのでご周知いただけますと幸いです）\n春に出す歌ってみたの動画での使用（収益OFF）を検討しています\n桜の中に立っている紗彩木ひそりの儚い一瞬を切り取っていただきたいです！\n\n画面サイズ＊構図等すべておまかせします！\nサムネに使用する際、横髪まで描き切っていただけますと\n見切れず助かります！衣装や髪型などアレンジたくさんしていただけたら嬉しいです！\n\n切ない表情と、涙を浮かべて微笑んでいる表情があると大変助かります…\n人物透過のPSDデータで納品いただけますと幸いです…！\n\n紗彩木ひそりビジュアル資料\n：https://twitter.com/Sasayaki_Hisori/status/1414106285138534401?s=20\n\n活動にめいっぱい使用させていただければと思っております\n何卒よろしくお願いいたします…！\n\n紗彩木ひそり", "created_at": "", "completed_at": ""}, {"path": "/@guruguru_7suB/works/28", "thu