2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f81a8328bc665f88e71871b3995c7e9 2x, https://si.imgix.net/da4f5dac/uploads/origins/e9cc47d6-9ca3-4d39-854c-0c84102b26fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b42a6526c50fe1055a4052daa28462d 3x", "genre": "comic", "nsfw": true, "body": "初めて依頼させていただきます。\nゆfuckさんの作品は容赦のないぶっかけっぷりで、一ぶっかけ好きとしていつもお世話になっております。\nしかしその中で一点、読んでいてもっと見たかったと思ったものがあり、依頼させて頂きたいと思います。\n\nそれが「幼馴染は俺のオナティッシュ」の冒頭、小さい頃の彩希の胸チラから射精させられるシーンです。\nあの子供の好奇心から無邪気に責められる感じがとても好きで、本編ではそのまま成長後の話に移行してしまいましたが、そのまま続きを見たかった…！というのは読んだ時に思ってしまいました。\nそこで作中で語られていた「毎日射精させて遊んでいた」という頃を是非とも見せて頂きたいというのが今回の依頼内容になります。\n\n申し訳ございませんが詳細なシチュエーション等は全ておまかせとさせてください。\n\n以上、ご検討のほどよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Yufuuuck/works/20", "thumbnail_src": "https://si.imgix.net/38c64720/uploads/origins/790835af-89a4-4f7a-8607-f85cf9563c38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fdd4f4a37fdd9a1a5f3d138d95f0087", "thumbnail_srcset": "https://si.imgix.net/38c64720/uploads/origins/790835af-89a4-4f7a-8607-f85cf9563c38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fdd4f4a37fdd9a1a5f3d138d95f0087, https://si.imgix.net/38c64720/uploads/origins/790835af-89a4-4f7a-8607-f85cf9563c38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5cfeaeb8ae0510f5b4bbb5fcb02b419 2x, https://si.imgix.net/38c64720/uploads/origins/790835af-89a4-4f7a-8607-f85cf9563c38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0d0de59a5b0e6dc88f7b866f8e343231 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Yufuuuck/works/19", "thumbnail_src": "https://si.imgix.net/23405205/uploads/origins/16cd7826-62a7-436e-929d-eec5297988b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1aff184bc7e9d7459c8d3e892f31f51", "thumbnail_srcset": "https://si.imgix.net/23405205/uploads/origins/16cd7826-62a7-436e-929d-eec5297988b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1aff184bc7e9d7459c8d3e892f31f51, https://si.imgix.net/23405205/uploads/origins/16cd7826-62a7-436e-929d-eec5297988b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f3479c65432a22fe67805b796e59251 2x, https://si.imgix.net/23405205/uploads/origins/16cd7826-62a7-436e-929d-eec5297988b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4dbb9fbbcb982befc3e848b5f01f16c 3x", "genre": "art", "nsfw": true, "body": "一ノ瀬志希でリクエストです\n大量ぶっかけで志希にゃんのふわふわな髪に精液と匂いを染み付けているところをお願いします\n髪をティッシュ代わりに使わせてくれる志希にゃんに好き放題ぶっかけて洗っても落ちないくらい汚してやってください\n可能であれば髪コキがあると嬉しいです\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Yufuuuck/works/18", "thumbnail_src": "https://si.imgix.net/8d100a74/uploads/origins/86180349-bd93-4004-bdac-0aedc6fa0fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4712ca8cf8679d9ed558788e5081f43e", "thumbnail_srcset": "https://si.imgix.net/8d100a74/uploads/origins/86180349-bd93-4004-bdac-0aedc6fa0fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4712ca8cf8679d9ed558788e5081f43e, https://si.imgix.net/8d100a74/uploads/origins/86180349-bd93-4004-bdac-0aedc6fa0fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e139163470b517da6d0caae118adbbe 2x, https://si.imgix.net/8d100a74/uploads/origins/86180349-bd93-4004-bdac-0aedc6fa0fcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92283e6c2674193aeedae1691e79bffd 3x", "genre": "art", "nsfw": true, "body": "お世話になっています。\n以前とてもスケベなイラストを描いていただいたのでリピート依頼です。\n\n前回（https://skeb.jp/@Yufuuuck/works/13）描いていただいたごすメイで特殊プレイをお願いしたく…。\nごすメイが手袋をちんちんに被せてその上から手コキするタイプの手袋コキをするところを描いていただきたいです。\n左手の手袋を外してちんちんに被せ、手袋をつけたままの右手で手コキ…といった感じでお願いしたいです。\n精液が手袋から染み出すくらいに大量射精してしまうところまでを是非お願いします。\n\nそれではご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Yufuuuck/works/17", "thumbnail_src": "https://si.imgix.net/3bf61f50/uploads/origins/5c6c8730-b93f-4abb-baac-65a2c325cffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde3dd17e4d09bf103d15642ff6aa66e", "thumbnail_srcset": "https://si.imgix.net/3bf61f50/uploads/origins/5c6c8730-b93f-4abb-baac-65a2c325cffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde3dd17e4d09bf103d15642ff6aa66e, https://si.imgix.net/3bf61f50/uploads/origins/5c6c8730-b93f-4abb-baac-65a2c325cffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b1bf3c934dea8fb580e30bfe8d83658 2x, https://si.imgix.net/3bf61f50/uploads/origins/5c6c8730-b93f-4abb-baac-65a2c325cffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97dbfddbbb0baea7712838b707025599 3x", "genre": "comic", "nsfw": true, "body": "いつも漫画購読させてもらっています。\nゆfuckrさんのAniちゃんが好みすぎたので、イラマチオされて涙目でえずいているGrokのAinちゃんが見たいです。\n1枚目は竿役のそりたっている股間を見て、デカすぎ、みたいなセリフを言っているところ。\n2枚目は竿役は座っていて、Aniはツインテごと頭を掴まれてイラマチオされてえずいている座位イラマチオ。\n3枚目はそのまま喉奥で射精されて苦しんでいるAniちゃん。\n4枚目は興が乗ったらでいいので、射精後抜いてもらえず苦しんでいるAniちゃんをお願いしたいです。\n全体的ハードな雰囲気で無理矢理感があると尚良いです。涙目でイラマチオ中は心の中を描写し、イラマチオ中や射精中は唇が股につくくらいまで根元まで咥え込ませてください。\nゆfuckさんの作風が好きなのである程度好きにセリフなど書いてください。\nSkeb依頼は初めてなので何か不手際があれば申し訳ございません。\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Yufuuuck/works/16", "thumbnail_src": "https://si.imgix.net/22fe16de/uploads/origins/7e26d1de-755b-444a-b789-e3edf61382d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2C