&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f93c5d175dacb4b8e1edf9f36601abbc", "thumbnail_srcset": "https://si.imgix.net/1c88aae6/uploads/origins/eb27abd5-8396-4203-a0a8-b0d610a6382b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f93c5d175dacb4b8e1edf9f36601abbc, https://si.imgix.net/1c88aae6/uploads/origins/eb27abd5-8396-4203-a0a8-b0d610a6382b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bfac42a10501978dca585f774a81209 2x, https://si.imgix.net/1c88aae6/uploads/origins/eb27abd5-8396-4203-a0a8-b0d610a6382b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ada4a524337420102b55eea6099640c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Lagoon_bluebear/works/42", "thumbnail_src": "https://si.imgix.net/c841a8c6/uploads/origins/570606d8-1a78-4a88-b928-3d7532cdaaf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7f52086c17a20398ab9b67f1374beec", "thumbnail_srcset": "https://si.imgix.net/c841a8c6/uploads/origins/570606d8-1a78-4a88-b928-3d7532cdaaf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7f52086c17a20398ab9b67f1374beec, https://si.imgix.net/c841a8c6/uploads/origins/570606d8-1a78-4a88-b928-3d7532cdaaf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddbd524b97f72c3753a5afdbfd03203d 2x, https://si.imgix.net/c841a8c6/uploads/origins/570606d8-1a78-4a88-b928-3d7532cdaaf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df6e65118716394f2339502bb06f92ef 3x", "genre": "art", "nsfw": false, "body": "この度、絵の依頼をさせていただくことになりました。\nこの絵はキャラクターが一人しかいません。キャラクターは、黒い柴犬で、目は緑、金の丸メガネをかけていて、オレンジ色のスカーフをしています。背が低く、少しぽっちゃりしているので、140cmくらいの小学生くらいに見えます。いつも紫の縁取りのある白いマントを着ていますが、帽子はかぶらず、ズボンは特にリクエストはありません。この部分は自由に描いてください。\nシーン：ベンチに座りながら、片手でミルクティーのボトルを持ち、まるで大きな友達を待っているようです。\nこのキャラクターの正面が見られるといいなと思います。\nありがとうございました。\nキャラクター写真：https://twitter.com/Clesar008/status/1586672250907869185?s=20\n\nhttps://twitter.com/Clesar008/status/1586672250907869185?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Lagoon_bluebear/works/41", "thumbnail_src": "https://si.imgix.net/e53a7098/uploads/origins/49c9aae5-f1ec-4e3f-b6a4-fe195124c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a578ef31b075c767b15782c35dc7b7e5", "thumbnail_srcset": "https://si.imgix.net/e53a7098/uploads/origins/49c9aae5-f1ec-4e3f-b6a4-fe195124c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a578ef31b075c767b15782c35dc7b7e5, https://si.imgix.net/e53a7098/uploads/origins/49c9aae5-f1ec-4e3f-b6a4-fe195124c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0998b101efafe5c931aad5729b8fc4b 2x, https://si.imgix.net/e53a7098/uploads/origins/49c9aae5-f1ec-4e3f-b6a4-fe195124c7c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f81e0653f3c7577b79c1151a5ea7cf6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Lagoon_bluebear/works/40", "thumbnail_src": "https://si.imgix.net/2681c132/uploads/origins/ac9cd99f-9fa8-4f20-a185-964970d29a76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98734f1903d0ee73b6a05