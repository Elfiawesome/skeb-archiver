%2Ccenter&txtsize=30&txt=PRIVATE&s=1e51d340c2c47bad7ff69aef95a04018 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/228", "thumbnail_src": "https://si.imgix.net/30be9e83/uploads/origins/c81f4054-c570-43fb-864f-f5fd48ee77ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01b7e37781953f1b8befbe1d6ed03640", "thumbnail_srcset": "https://si.imgix.net/30be9e83/uploads/origins/c81f4054-c570-43fb-864f-f5fd48ee77ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01b7e37781953f1b8befbe1d6ed03640, https://si.imgix.net/30be9e83/uploads/origins/c81f4054-c570-43fb-864f-f5fd48ee77ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=782ca20a4b8246c57a810f1581453daa 2x, https://si.imgix.net/30be9e83/uploads/origins/c81f4054-c570-43fb-864f-f5fd48ee77ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63b0f9c9a5d357f33b2e4dc04c19d2d6 3x", "genre": "art", "nsfw": true, "body": "原神の凝光で人間公衆便女調教計画のような密閉された空間に正座で座らされて首元までびっしりと蜘蛛や百足、芋虫やゴキブリ等の蟲で拷問されているのをお願いします。\n頭や壁にもびっしりと蟲をお願いします。\nまた正座させられている際の服装は全裸でお願いします。\n顔には鼻フックと口を閉じれないように開口具をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/227", "thumbnail_src": "https://si.imgix.net/19f2dd40/uploads/origins/84613d55-89a1-456b-a5e0-a77f1a446862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0b81b8d2a41678af05bd05fdecc3140", "thumbnail_srcset": "https://si.imgix.net/19f2dd40/uploads/origins/84613d55-89a1-456b-a5e0-a77f1a446862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0b81b8d2a41678af05bd05fdecc3140, https://si.imgix.net/19f2dd40/uploads/origins/84613d55-89a1-456b-a5e0-a77f1a446862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=958edfd64f91d4398ca39fcf60f0d5c2 2x, https://si.imgix.net/19f2dd40/uploads/origins/84613d55-89a1-456b-a5e0-a77f1a446862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc1ee9185cf6bcfd97f8eb450e62756e 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\nこちらの作品（https://skeb.jp/@ningenkuzunokai/works/226）が気に入ってしまいましたので、似た構図とシチュでのリクエストとなりますが、今回は『戦国BASARAシリーズ』に登場する雑賀孫市、井伊直虎、京極マリアの3人を題材にお願いしたいと思います。\n主なシチュと詳細は以下に。\n\n・孫市、直虎、マリアの3人は敗戦の将として敵軍に捕らわれてしまう。\n・屋外にて、首から下を木箱に詰め込まれて頭のみを出した状態で、晒し者のように横並びで拘束された3人。\n・3人の髪は根こそぎまくり上げられた状態で縄で縛り吊るされている（髪を吊る縄と、余った髪先が垂れている描写もお願いします）\n・周囲にいる敵軍の兵士達は「惨めなもんだな」「女が戦に出るからこうなっちまうんだよ」「奴隷になるなら助けてやってもいいんだぜ」など、捕らわれの身となった3人を嘲笑う。\n・敵兵のそんな態度に対し、直虎は激怒、孫市とマリアも珍しく怒りを露わにし、各々に怒りを言葉にする。\n・すると敵兵達は3人のうるさい口を塞ぐために家畜の糞を彼女達の口に詰め込み、糞の臭いと味に耐え切れず3人は嘔吐。\n・嘔吐した後に彼女達は敵兵達に向かってさらに激怒するが、そこで敵兵達は3人の心を折るために、1人ずつ馬と強制交尾をさせてやると告げる。\n・最初は孫市。木箱から解放されるも、直虎とマリアの目の前で馬と交尾をさせられる。\n・孫市は「やめろ！　やめろおおおおお！」と抵抗する言葉を発するも、結局は馬と交尾をさせられて大声で泣き叫ぶ（交尾の様子は描かずにセリフのみで大丈夫です）\n・次はマリア。惨めに助けを乞うが強制的に馬と交尾をさせられ、無様に泣き叫ぶ。\n・最後に残された直虎は目の前で繰り広げられた地獄絵図に絶望し、青ざめた顔で「嫌だ・・・頼む・・・助けて・・・！」と泣きながら懇願するが、兵士達は最後に大型の軍馬を用意しており、「男を見下すバカ女にはコイツとしてもらうぜ」と告げ、直虎は絶望の叫び声を響かせる。\n・最後はナレーションのような形で、「後に、雑賀孫市、井伊直虎、京極マリアの三名は、敵軍の手によってその身を極限まで痛めつけられた挙句に八つ裂きの刑に処せられ、民衆の見ている前で無残な死を迎えた」という文章が流れ、終わりを迎える。\n\nリクエスト内容は以上となります。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/226", "thumbnail_src": "https://si.imgix.net/208a7056/uploads/origins/15b56b1e-926d-4b1f-93be-0971c52d9fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f9df9c986590218143a56ba049defc", "thumbnail_srcset": "https://si.imgix.net/208a7056/uploads/origins/15b56b1e-926d-4b1f-93be-0971c52d9fed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2f9df9c986590218143a56ba049defc, https://si.imgix.net/208a7056/uploads/origins/15b56b1e-926d-4b1f-93be-0971c52d9fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94b6c8e31ac82b850c35b5c3d3844ceb 2x, https://si.imgix.net/208a7056/uploads/origins/15b56b1e-926d-4b1f-93be-0971c52d9fed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2454450a61797ebae60dc8e2165632a7 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\n今回は『六本木サディスティックナイト』に登場する、葉山ユミ、徳寺マリア、向井アンナの3人を題材としたイラストをお願いしたいと思います。\n主なシチュと設定は以下に。\n\n・ユミ、マリア、アンナの3人は、主人公が率いる美女チームに協力しているという理由で犯罪組織に捕まってしまう。\n・汚らしいトイレ内にて、和式便所から頭だけを出した状態で横並びで拘束された3人。\n・3人の髪は根こそぎまくり上げられた状態でロープで縛り吊るされている（髪を吊るすロープと、余った髪先が垂れている描写もお願いします）\n・周りにいる犯罪組織の男達は彼女達から情報を引き出そうとするが、アンナとユミは挑発的な態度で、マリアは真っ向から反抗心を剥き出しにして、決して仲間を売ろうとはしなかった。\n・その結果、3人は男達から暴行を受ける羽目に。\n・髪を吊るすロープを引っ張り上げられて髪を痛めつけられ、苦悶する3人は悲鳴を上げながらも男達に決して屈しない。\n・そこで最悪の拷問手段として『人間便所』が行われる。\n・これから1週間、便所として糞尿を受け続ける生活をさせられると知らされ、3人は絶望に青ざめるが、抵抗する間も無く3人の鼻の両穴に消臭ボールが詰め込まれ、口には小便器の底蓋がはめ込まれる。\n・そして、「んー！　んー！」と大声で泣き叫ぶ彼女達を放置して、男達はトイレを立ち去る。\n・1週間後。汚らしい糞尿まみれとなって拷問に耐え切った3人の前に男達が再び現れ、「噂の美女チームのメンバーは全員捕まえた。テメェらの努力はムダになっちまったなwww」「後で美女チーム共のレイプ映像を見せてやるから楽しみにしてな」と告げ、救いのないバッドエンドな展開で終わる。\n\nリクエスト内容は以上となります。\nどうかご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/225", "thumbnail_src": "https://si.imgix.net/26c815ff/uploads/origins/539051c5-b39f-42ed-9b31-efe3cfa52102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc4ee49bcf1220ff2dded76361d510a3", "thumbnail_srcset": "https://si.imgix.net/26c815ff/uploads/origins/539051c5-b39f-42ed-9b31-efe3cfa52102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc4ee49bcf1220ff2dded76361d510a3, https://si.imgix.net/26c815ff/uploads/origins/539051c5-b39f-42ed-9b31-efe3cfa52102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5687ff71095468529cfe909eba5a750c 2x, https://si.imgix.net/26c815ff/uploads/origins/539051c5-b39f-42ed-9b31-efe3cfa52102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3232c12b2620a358cb17f8c4c7af82f9 3x", "genre": "art", "nsfw": true, "body": "かなり以前のものなのですがこちらの作品が気に入りまして\n1枚目の身体に落書きがない状態をベースに差分をつくっていただくことは可能でしょうか？\nhttps://skeb.jp/@ningenkuzunokai/works/32\n\n希望の差分→ウンコ入りのビニール袋を下記URLのような感じでかぶせた窒息責め　　\nhttps://cdn.up-timely.com/image/15/content/32198/JBD100_10.jpg\nビニールの出口から呼吸できないよう首にロープを巻いて絞り上げてウンコの臭いごと密封。顔に張りついたビニールにひっぱられて顔面が豚鼻ブチュ顔に崩壊。無様になった顔が見えるように袋の中の汚物はきもち少なめにしてほしいです。\n\n便所ブラシホルダーとして役に立たなかった巨乳女を廃棄処分してる的な設定で女をゴミみたいに扱う台詞を入れてほしいです。\n・ゴキブリ並みの生命力だなwとしぶとく息を続ける袋の中にゴキブリ用殺虫剤を噴霧して呼吸困難にさせる\n・乳首立ってんぞwと引火させた殺虫剤をバーナーにして乳首を焼く\n・さっさと死ねよwと女の胸に電極を刺して電流を流しこむ(胸に刺せるだけたくさん)\n・くたばった女に\"粗大ごみ\"と書かれた貼り紙をして小便をかける\n↑みたいな鬼畜な感じで責めてほしいです。細かな台詞や展開はおまかせします。ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/224", "thumbnail_src": "https://si.imgix.net/278cab33/uploads/origins/aa228144-0954-45e0-9aa4-3924e62ebe48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c614a160431d921af22ecfce46beea3e", "thumbnail_srcset": "https://si.imgix.net/278cab33/uploads/origins/aa228144-0954-45e0-9aa4-3924e62ebe48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c614a160431d921af22ecfce46beea3e, https://si.imgix.net/278cab33/uploads/origins/aa228144-0954-45e0-9aa4-3924e62ebe48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14dfcff688ec3532ed597da6e970985d 2x, https://si.imgix.net/278cab33/uploads/origins/aa228144-0954-45e0-9aa4-3924e62ebe48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d5df6a7b5db55a613d8905f57a01da0 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\n以前お描きになったこちらの作品（https://skeb.jp/@ningenkuzunokai/works/223）と似た構図でのイラストを、『ヒプノシスマイク』に登場する東方天乙統女と勘解由小路無花果を題材にしてリクエストしたいと思います。\n主なシチュと設定は以下に。\n\n・女を蔑視するテロ集団の男達に捕らわれた乙統女と無花果。\n・全裸にさせられた2人は汚らしい部屋に監禁され、腰から下を床に埋め込まれた姿で横並びとなる。\n・顔を固定する為、2人の長い髪が根こそぎ捲り上げられた状態で縛り吊るされている（こちらの画像 https://drive.google.com/file/d/10DR8FOsfsmjtn5BsvyJj3v7p7Qtkf1Id/view?usp=drive_link のように、髪を吊るしている縄と、余った髪先が垂れている描写を入れていただきたいです）\n・絶体絶命の状況だが2人は気丈な様子を見せ、乙統女は「女の髪をこのような扱いにするとは恥を知りなさい」と言い放ち、無花果は「お前達は最低のクズだ。これだから男は」と言う。\n・対する男達は、「うるせぇよメス豚！」「クズはてめぇらだろ！」「ババアが髪を大事にしても意味ねぇんだよ！」等の罵声を浴びせ、乙統女の額には「ババア」、無花果の額には「ブタ」と落書きを書き込み、2人は激しく怒る。\n・その後、鼻フックを装着させられ、鼻くそをほじられる。\n・「女の鼻クソってこんなにでけぇんだなwww」などの嘲笑が飛び交う。\n・さらに汚物まみれの歯ブラシで歯を掃除させられ、仕上げには小便で口をゆすがれる。\n・おやつとしてうじ虫のわいたうんこを見せつけられ、2人は必死に嫌がるが、結局はうんこを口一杯に食べさせられ、号泣しながら嘔吐。\n・最後は助けを乞うが、これから死ぬまで汚物を食わせ続けてやると告げられ、乙統女と無花果は無様に泣き叫ぶ。\n\nリクエスト内容は以上となります。\nどうかご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/223", "thumbnail_src": "https://si.imgix.net/32014d2e/uploads/origins/494634b5-f6dd-41c4-a244-ee2d973ef251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18f860451e6fe87dbafeaaebbfb357d3", "thumbnail_srcset": "https://si.imgix.net/32014d2e/uploads/origins/494634b5-f6dd-41c4-a244-ee2d973ef251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18f860451e6fe87dbafeaaebbfb357d3, https://si.imgix.net/32014d2e/uploads/origins/494634b5-f6dd-41c4-a244-ee2d973ef251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c55a6d27e05d68e2156676428ec2e95 2x, https://si.imgix.net/32014d2e/uploads/origins/494634b5-f6dd-41c4-a244-ee2d973ef251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f19aa388bf8feb430d3b58e2e96fc7c3 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\n『ワンピース』に登場する黒檻のヒナとカリファをターゲットとした悪臭責めのイラストをリクエストしたいと思います。\n\n主なシチュと設定は。\n・海賊達に捕まったヒナとカリファ。\n・こちらの画像（https://drive.google.com/file/d/1xWtKoc6_n7eFB18mlRD5HJp2GP_qVrJP/view?usp=drive_link）と同じ方法で髪を吊るされ、全裸となった姿で横並びに拘束されているが、2人はまだ強気な目つきと態度をしている。\n・そして拷問開始。\n・鼻の両穴に透明なチューブが差し込まれ、チューブを通じてひどい悪臭を注入される。\n・2人はゲロを吐いて涙を流しながらも、「お前たちのような卑劣な海賊には屈しない！」といった感じの内容の言葉を叫ぶ。\n・すると2人の頭に透明な円筒形の容器が装着され、ほっぺたが潰れた豚鼻顔を晒される。\n・それでもまだ強気だったのもつかの間、強烈な悪臭を伴った大量のウンコが容器の中へ放り込まれ、彼女達の口が埋まる高さまでうんこが盛られる。\n・ヒナとカリファはブサイクな豚鼻顔で悪臭に悶え苦しむ。\n・2人はそのまま半日近く放置され、後に海賊達が様子を見に来ると、既に何度も悪臭で気絶を繰り返した彼女達は白目を剥いて、再び気絶しかけていた。\n・容器を外すと、2人はすっかり心が折れた様子で「もう許じでえええええ！」「何でもするから助げでえええええ！」といった感じに命乞いを叫ぶ。\n・そして最後は体中に卑猥で侮辱的な落書きをされた姿で、自分達の口から惨めな敗北宣言をさせられる。\n\nリクエスト内容は以上となります。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/222", "thumbnail_src": "https://si.imgix.net/8907d1f0/uploads/origins/e203583d-6118-4f43-a441-b916a21da47c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd49f73e53d254084f44c3ae4ae15bf", "thumbnail_srcset": "https://si.imgix.net/8907d1f0/uploads/origins/e203583d-6118-4f43-a441-b916a21da47c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbd49f73e53d254084f44c3ae4ae15bf, https://si.imgix.net/8907d1f0/uploads/origins/e203583d-6118-4f43-a441-b916a21da47c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91d640e44b1d5768eb297ed3360d37a1 2x, https://si.imgix.net/8907d1f0/uploads/origins/e203583d-6118-4f43-a441-b916a21da47c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3be2f0562d391332fa2ce4f9b320f9ae 3x", "genre": "art", "nsfw": true, "body": "先生の作品をいつも楽しませてもらっています。\n今回送りたいリクエスト内容は、無期迷途のハクイツとゾーヤが無様な汚物責めに遭うイラストです。\n\n「リクエスト内容」\n横並びで拘束されている2人は全裸で鼻フックを装着されていたが、まだどこか余裕のある笑みを浮かべていた。\nしかし、トイレ掃除に使った後のウンコのついた歯ブラシで鼻の中をほじくられてから、余裕が少しずつ消えていく。\n「罪人がキレイな髪をしてんじゃねぇぞ！」と罵られながら髪にドロドロのウンコをぶっかけられ、便所ブラシでゴシゴシとウンコを髪に擦り付けられる。\n2人はブチギレるが、硬くて太いウンコを口に咥えさせられ、まるでチンコをしゃぶっているかのような顔となり。\nそして最後は口とまぶたを器具で強制的に開けさせられ、小便、ゲロ、蛆虫、家畜の糞などを食べさせられて、いつものクールな雰囲気から一変して無様に大号泣する。\n\nリクエストよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/221", "thumbnail_src": "https://si.imgix.net/9ca30562/uploads/origins/6990137a-af52-4c62-9c7b-f2dace235fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43b91080f1b8d182e324d0c931b55889", "thumbnail_srcset": "https://si.imgix.net/9ca30562/uploads/origins/6990137a-af52-4c62-9c7b-f2dace235fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43b91080f1b8d182e324d0c931b55889, https://si.imgix.net/9ca30562/uploads/origins/6990137a-af52-4c62-9c7b-f2dace235fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12c88b5c745b7170b1893a54c2c6a85f 2x, https://si.imgix.net/9ca30562/uploads/origins/6990137a-af52-4c62-9c7b-f2dace235fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60ce48a8ea970959c9c188469fd50813 3x", "genre": "art", "nsfw": true, "body": "以前にリクエストしました作品の納品、ありがとうございました。\nそして今回もリクエストのほうを失礼いたします。\n『魔法少女リリカルなのはStrikerS』に登場するフェイト・T・ハラオウンをターゲットとしたイラストをリクエストしたいと思います。\n\n主なシチュと設定は以下に。\n・フェイトの見た目は大人バージョンで、髪を下ろした姿で全裸にされ、椅子に縛り付けられている。\n・彼女が縛り付けられた椅子の目の前にあるテーブルには大皿が置いてあり、皿の上には彼女の仲間達の髪の毛（なのはのサイドテール、シグナムのポニテ、ヴィータの三つ編み、ティアナのツインテ）が盛られ、それを全部食べろと命令されるが、フェイトはハッキリ「嫌です！」と拒否する。\n・しかし拒むフェイトは無理矢理に仲間達の髪の毛を全部まとめて口内に押し込まれ、大量の髪の毛をほおばって両方の頬が滑稽なぐらいにパンパンに膨れるも、気持ち悪さのせいで結局は食べる事が出来ずに、口へ押し込まれた髪の毛ごとゲロを吐き出す。\n・大量のゲロと色とりどりの髪の毛が散る中でフェイトはこう告げられる。「食材を提供してくれた仲間達は今頃別室で頑張って拷問に耐えているのに、もったいない事をしやがるぜ」\n・その情報を聞かされて恐怖し、目を見開くフェイトに向かって、「テメェの母親、たしかリンディって名前の緑髪のババアだったか。次はソイツの髪に特製うんこソースをかけた一品を用意してやるが、食べきれなかったらテメェのうんこを母親に食わせてやる」と男は告げ、フェイトは絶望に青ざめた顔で「やめてえええええ！　母さんにひどい事しないでえええええ！　お願いだから助けてえええええ！」と泣き叫ぶが、フェイトを襲う地獄はまだまだ終わりを見せなかった。\n\nリクエスト内容は以上となります。\nどうかご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/220", "thumbnail_src": "https://si.imgix.net/531501ad/uploads/origins/9ae8fba8-15af-4a36-b60b-bf91c0230a90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12ec73b1fd45f624c96ced6dd0b3ea9b", "thumbnail_srcset": "https://si.imgix.net/531501ad/uploads/origins/9ae8fba8-15af-4a36-b60b-bf91c0230a90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12ec73b1fd45f624c96ced6dd0b3ea9b, https://si.imgix.net/531501ad/uploads/origins/9ae8fba8-15af-4a36-b60b-bf91c0230a90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f1259d4604f475a19375badfa75b3f3 2x, https://si.imgix.net/531501ad/uploads/origins/9ae8fba8-15af-4a36-b60b-bf91c0230a90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae448ce0cae33b29025632c445c9fb04 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\n『魔法少女リリカルなのはA's』に登場するシグナムをターゲットにした顔面汚物拷問のイラストをリクエストしたいと思います。\n\n主な設定とシチュは。\n・全裸姿のシグナムは両腕を後ろ手に縛られ、蹲踞の姿勢で拘束されている。\n・ピンク色の長いポニーテールを縄で縛り吊るされて無理矢理に上げさせられた顔には鼻フックを装着させられ、鼻の穴が広がっている状態。\n・その状態のまま綿棒で鼻クソをほじられ、鼻水を垂れ流した顔で彼女は激しい怒りを露わにするが、そこへ無理矢理ウンコまみれの便所ブラシを口一杯にほおばらされて鼻ゲロを出す。\n・吐瀉物で床を汚した罰として、開口器で強制的に開かされた口へ小便、ウンコ、陰毛、虫の死骸などを食べさせられ、口いっぱいに広がる最悪の味と臭いに苦しんで汗だくとなったシグナムが、涙ながらに絶叫を轟かせるも、汚物拷問の手は彼女が気絶するまで止まる事はなかった。\n\nリクエストしたい内容は以上となります。\nご検討のほど、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/219", "thumbnail_src": "https://si.imgix.net/20dd3834/uploads/origins/4fc01d67-dc9f-4288-8701-3c16d289c9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=111772a698bc682ff7cc191936ab244c", "thumbnail_srcset": "https://si.imgix.net/20dd3834/uploads/origins/4fc01d67-dc9f-4288-8701-3c16d289c9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=111772a698bc682ff7cc191936ab244c, https://si.imgix.net/20dd3834/uploads/origins/4fc01d67-dc9f-4288-8701-3c16d289c9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e115286fae61e4db04ac62e4e9a68c1 2x, https://si.imgix.net/20dd3834/uploads/origins/4fc01d67-dc9f-4288-8701-3c16d289c9dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0adb492f99c07c2333e34a901d2fd2c 3x", "genre": "art", "nsfw": true, "body": "変身前の姿で乳房破壊リョナをされるキューティーハニーFの如月ハニーをお願いします\nhttps://imgur.com/a/DlxiNIb\n\nhttps://www.toei-anim.co.jp/tv/honey/chara/chara.html\n\n敵に捕まりおっぱい丸出しで磔にされてるシチュエーションで\nカチューシャと首のチョーカーはつけたままでお願いします。\nURLの服がキャラの特徴にもなってるのでできたら部分的に残してほしいです。\n\n過去の作品での身体にダメージがどんどん増えていく差分が大好きなので傷つけまくって巨乳をめちゃくちゃに破壊してほしいです。拷問方法はお任せしますができたらミートローラーとかミートテンダライザーみたいな肉を破壊するための道具を使った責めも入れてほしいです。\nhttps://www.kobo-aizawa.co.jp/?p=2954\n\nhttps://wowma.jp/item/649353721?aff_id=PLA_m_5401\n\n変身すれば勝てると最初は余裕の態度だったのが変身する隙もなく拷問が続くと屈してしまって降参、聞き入れられず、失神して反応なくなるまで拷問が続く、みたいな情けない姿にしてほしいです\n\n拷問中に意図せず母乳が出てしまい、拷問官は勝手にお漏らしした罰として、栓になるものを乳首に刺すか、潰れるまで乳首を変形させるか、あるいは乳首それぞれに違う罰を与えるかして強制的に母乳が出ないようにする、という展開を可能でしたらいれてほしいです(F版のハニーは最終回で子供つくって育ててるので母乳がでる)\n\n最後は鼻水とか涎垂れ流して無様な顔で気を失ってるハニーの身体にザコヒロイン、雌牛とか馬鹿にしてこきおろした落書きを隙間ないぐらい描き込んで、磔のまま人目につく場所で晒し者にする完全敗北ENDにしてほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/218", "thumbnail_src": "https://si.imgix.net/42804436/uploads/origins/be144fef-c83a-484c-84af-7fad4954ef2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37230169b3b9d7ddfb8d37065e6b4620", "thumbnail_srcset": "https://si.imgix.net/42804436/uploads/origins/be144fef-c83a-484c-84af-7fad4954ef2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37230169b3b9d7ddfb8d37065e6b4620, https://si.imgix.net/42804436/uploads/origins/be144fef-c83a-484c-84af-7fad4954ef2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf2d3b0b6addf9626dd889c25da1ccb6 2x, https://si.imgix.net/42804436/uploads/origins/be144fef-c83a-484c-84af-7fad4954ef2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c7349338340409de5f732ca9432a788 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ningenkuzunokai/works/217", "thumbnail_src": "https://si.imgix.net/f130f98e/uploads/origins/ba19d262-75a5-4c00-9917-e7b728efd53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84d88b92b505d6d7d9fb666fb138d1d2", "thumbnail_srcset": "https://si.imgix.net/f130f98e/uploads/origins/ba19d262-75a5-4c00-9917-e7b728efd53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c