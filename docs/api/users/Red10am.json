=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd43a92f53ef470917470980eafed961, https://si.imgix.net/0b1fb40f/uploads/origins/b274e0b1-cdc0-4f9d-a7b1-a914d41d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4cebbb96bd62a4d806e67c59a88967b 2x, https://si.imgix.net/0b1fb40f/uploads/origins/b274e0b1-cdc0-4f9d-a7b1-a914d41d6316?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64a5b0a70b80586ae2eaaaa30800237a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/49", "thumbnail_src": "https://si.imgix.net/6905b63c/uploads/origins/6d49b395-e6bd-4ed3-bd78-5e605032cf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17db6903a16bfdbec74fe9332d806928", "thumbnail_srcset": "https://si.imgix.net/6905b63c/uploads/origins/6d49b395-e6bd-4ed3-bd78-5e605032cf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17db6903a16bfdbec74fe9332d806928, https://si.imgix.net/6905b63c/uploads/origins/6d49b395-e6bd-4ed3-bd78-5e605032cf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01e5b2535949267ee774c80c94aadcbc 2x, https://si.imgix.net/6905b63c/uploads/origins/6d49b395-e6bd-4ed3-bd78-5e605032cf4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=684a1ad7ba415cde0fbc9ff34a83d58e 3x", "genre": "art", "nsfw": false, "body": "10時様\n\nお世話になっております、いつも素敵なイラストをありがとうございます！\n今回も是非依頼したくリクエスト送らせていただきました。\n\n✧依頼内容\nCoC TRPG探索者のイラスト\n構図おまかせ\n\n✧用途\n10時様の名前を明記してTRPGアカウント/リットリンクに掲載、アイコンなどに使用\n完全私用でグッズ化\n\n資料はリンク先に格納しています。\n\n金額及び資料に不備不足ございましたら気兼ねなくキャンセル又は再送要請してください。\n\nhttps://drive.google.com/drive/folders/1Oaa2ZjHnW5gn7dP6z9Fq3134wHb4BcNt", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/48", "thumbnail_src": "https://si.imgix.net/2d064be0/uploads/origins/63cdd0b9-64c5-4919-ab6d-e2f1c99ab042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f73fab4c77e8d62631250d2c8fff8409", "thumbnail_srcset": "https://si.imgix.net/2d064be0/uploads/origins/63cdd0b9-64c5-4919-ab6d-e2f1c99ab042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f73fab4c77e8d62631250d2c8fff8409, https://si.imgix.net/2d064be0/uploads/origins/63cdd0b9-64c5-4919-ab6d-e2f1c99ab042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b931ededcbccf8997b0cc968bce1625e 2x, https://si.imgix.net/2d064be0/uploads/origins/63cdd0b9-64c5-4919-ab6d-e2f1c99ab042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efdc5c92cf8a9fdd0de28e0c5a66b42b 3x", "genre": "art", "nsfw": false, "body": "10時様\n\nはじめまして！skebで10時様の描かれる可愛いSDイラストを拝見し、ぜひ私のキャラクターもお願いしたく思いリクエストを送らせていただきました。\n\n\n◇キャラクター雰囲気参考資料\nhttps://drive.google.com/drive/folders/1lmX-j8PewWmzPDEahMNJW-LvbW2JCYxi?usp=sharing\n\n・鎖骨の下にハートの模様があります\n\n\n【リクエスト内容】\n・こちらのキャラクターと、資料にはないのですがこのキャラクターがもし男性になったら…バージョンの2人でのペア画をお願いしたいです。\n　◆男性キャラのイメージ\n　(女性キャラと反転する感じで)\n　髪色→ピンク\n　瞳の色→水色\n　鎖骨下のハート模様も、右側に\n\n・構図やポーズ、衣装などおまかせいたします。\n・髪型は雰囲気に合うようにアレンジしていただけると嬉しいです。\n\n\n配信画面やサムネイル画像に使用したいので、頭や髪、上半身が見切れないように描いていただけますと助かります。\n\n\n【使用用途】\n・配信画面やアーカイブ\n・SNS(Xなどのアイコンやポスト等)\n・支援サイト(アイコンやサムネイル、壁紙配布等)\n・ネットプリント\n\n\n可能でしたら、人物のみのレイヤーを分けたpsdデータをお送りいただけますと幸いです。\n\n\n10時様の描かれるペア画の雰囲気が素敵で資料のないキャラクターをお願いしてしまいましたが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/47", "thumbnail_src": "https://si.imgix.net/2781f3e9/uploads/origins/c62bfba7-3493-44f6-8700-3f52fb121b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06149752fb007f7fd725e31181d452a7", "thumbnail_srcset": "https://si.imgix.net/2781f3e9/uploads/origins/c62bfba7-3493-44f6-8700-3f52fb121b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06149752fb007f7fd725e31181d452a7, https://si.imgix.net/2781f3e9/uploads/origins/c62bfba7-3493-44f6-8700-3f52fb121b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa76a01dff67f5b6c9cb647d346185e5 2x, https://si.imgix.net/2781f3e9/uploads/origins/c62bfba7-3493-44f6-8700-3f52fb121b8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2877f0f099e81a386c7cf0ec3ed10ba7 3x", "genre": "art", "nsfw": false, "body": "Vtuberのまさるドット子と申します！\n是非とも私のことを描いていただきたいと思いましてリクエストを送らせて頂きました！\n\n【用途】\nYoutube(収益化済み)とTwitterでの活動内で使用するイラスト\n主にサムネイル、動画内、配信内などに使用\n\n【仕様】\nデータ形式はPSDかPNGで背景とキャラが分かれているデータ\n\n【詳細】\n・キャラクターデザインはこちらhttp://masarudottocom.but.jp/00.png\n・ペットも一緒にいると嬉しいです\n・構図、ボーズなどおまかせ（サムネイルなどに使いたいので頭部が切れていない構図だと嬉しいです）\n\n【活動場所】\n普段はお絵描き・雑談・たまに歌やゲームをしています。\nhttps://www.youtube.com/@masarudottoko\nhttps://x.com/masarudottoko", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/46", "thumbnail_src": "https://si.imgix.net/d12dec5b/uploads/origins/aff44342-c622-4c15-bd22-2405871b01c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f2e95d414bc92a0198a60b01c4e2d62", "thumbnail_srcset": "https://si.imgix.net/d12dec5b/uploads/origins/aff44342-c622-4c15-bd22-2405871b01c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f2e95d414bc92a0198a60b01c4e2d62, https://si.imgix.net/d12dec5b/uploads/origins/aff44342-c622-4c15-bd22-2405871b01c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57532eb30c4ea785a88ae4b95f6b6797 2x, https://si.imgix.net/d12dec5b/uploads/origins/aff44342-c622-4c15-bd22-2405871b01c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22946606f1fd00031383e1bc3311ff0d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/45", "thumbnail_src": "https://si.imgix.net/3f1ac158/uploads/origins/c76d1cca-bdf4-4ba8-938f-49e3cf6f433b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5837cce5233e296814d4f02b85ecca4d", "thumbnail_srcset": "https://si.imgix.net/3f1ac158/uploads/origins/c76d1cca-bdf4-4ba8-938f-49e3cf6f433b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5837cce5233e296814d4f02b85ecca4d, https://si.imgix.net/3f1ac158/uploads/origins/c76d1cca-bdf4-4ba8-938f-49e3cf6f433b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e2dbc2d3f1f63b35697801cca45e02b 2x, https://si.imgix.net/3f1ac158/uploads/origins/c76d1cca-bdf4-4ba8-938f-49e3cf6f433b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fa3abcf2b216eed5e8f0f887bdabe46 3x", "genre": "art", "nsfw": false, "body": "かわいいチビたちのギャラリーをお持ちですね。\n私のOCのことでお願いがあるのですが。ゆずきとたまきです。\nSF魔法少女の鬼姉妹です。姉がたまき。生意気で、気が強く、騒々しい。下は柚希。  おっちょこちょいで明るく、のんびり屋。二人とも元気いっぱいのガキ大将だ。\n\nここに2人のリファレンス・ドライブがある：\n\n柚希：\nhttps://drive.google.com/drive/folders/1m7zyIABP-Yo7kphQcFYY0Qs7D5c00DSX\n\nそして玉城：\nhttps://drive.google.com/drive/folders/1xA3Ep6maIdQGAOpJ72HWV1e3ZCBlwJ8F\n\n似たような衣装のセットを持っています。デュオ・ピースでお揃いにしたいのですが、どちらかお好きなほうを選んでいただけますか？", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/44", "thumbnail_src": "https://si.imgix.net/5b56075b/uploads/origins/c2d7a7b1-11a3-4eb7-a759-4466a0fd51f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b961b3cb172f0cf746dfb81c9c7f558", "thumbnail_srcset": "https://si.imgix.net/5b56075b/uploads/origins/c2d7a7b1-11a3-4eb7-a759-4466a0fd51f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b961b3cb172f0cf746dfb81c9c7f558, https://si.imgix.net/5b56075b/uploads/origins/c2d7a7b1-11a3-4eb7-a759-4466a0fd51f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7eb6b7fcff2ad007b38666cd118615c 2x, https://si.imgix.net/5b56075b/uploads/origins/c2d7a7b1-11a3-4eb7-a759-4466a0fd51f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1f10c0ed908e8293c346f416a9a0c73 3x", "genre": "art", "nsfw": false, "body": "10時 様、初めまして。誘宵（いざよい）と申します。\nskeb依頼の再開をお待ちしておりました…！\n素敵なイラストをX(旧Twitter)やskebにて拝見し、10時 様の絵柄に惹かれ\n是非私と私の友達のOCを描いていただきたく依頼させていただきました。\n\n使用用途 と致しましてこちらの通りになります。\n・X、discordでのアイコン使用\n・個人での鑑賞、他の方にイラスト依頼をする際に資料として提示\n・お友達にイラストをプレゼント\n\n描いて頂きたい子の特徴やカラー等に関しまして\n私とお友達のOCの参考資料(私①、お友達②)を貼らせていただきました。\n\n構図・ポージングにつきましては、10時 様にお任せします。\n服装につきましては参考資料③で、髪型につきましては参考資料①の子(私のOC)はその中の衣装⑤の髪型で、参考資料②の子(お友達のOC)の髪型はその通りに描いていただけると嬉しいです。\n可能であれば、別々の背景透過データもいただきたいです。ご検討よろしくお願いいたします。 \n\n以上となります。金額など不備等ございましたら再送、キャンセル等していただけますと幸いです。\nお忙しいところ恐れ入りますが、ご検討の程よろしくお願い致します。 \n\n参考資料 \n① https://drive.google.com/drive/folders/1H31ntyPPFf6v73V9Ia_QyXMj0vDwaYm-?usp=sharing\n②  https://x.com/0ran_9/status/1947455125741813881?s=61&t=NNT4ZMcIMHEo7HCx0\n③ https://x.com/rabi_yi53/status/1962302731831697531?s=61&t=NNT4ZMcIMHEo7HCx0vgjtA", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/43", "thumbnail_src": "https://si.imgix.net/2e8f0a49/uploads/origins/f455a4a3-b8e5-49d4-9bd7-4a1bcbef8ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a4da42f86fb946deb473a8380b3ae2", "thumbnail_srcset": "https://si.imgix.net/2e8f0a49/uploads/origins/f455a4a3-b8e5-49d4-9bd7-4a1bcbef8ace?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a4da42f86fb946deb473a8380b3ae2, https://si.imgix.net/2e8f0a49/uploads/origins/f455a4a3-b8e5-49d4-9bd7-4a1bcbef8ace?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24cdd52d6d3a87be02b2c1429e8c1e55 2x, https://si.imgix.net/2e8f0a49/uploads/origins/f455a4a3-b8e5-49d4-9bd7-4a1bcbef8ace?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34496d7f2889515677d99d2db313174c 3x", "genre": "art", "nsfw": false, "body": "はじめまして。突然失礼いたします。   \n可愛いSDイラストを見かけて、私の創作キャラのイラストを描いていただけないかと思い、リクエスト送信をしました。   アイコン等に使う予定です。   \n\nキャラの内容としては、 男、銀髪のストレートロング(背中下の方くらいまで)、紫の目(つり目気味)、眉は下がり気味、体型は普通、身長は普通〜高   それ以外の背景、構図、服装等はおまかせいたします。\n\n和風テイストだと嬉しいです。(これはできればで大丈夫です)\n https://drive.google.com/drive/folders/1QHifyyce9VbsC9Z9-M-eHCIWEntAE80d", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/42", "thumbnail_src": "https://si.imgix.net/b750f9ff/uploads/origins/3f448a66-f418-4f1b-b628-fef76ddf6ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ea0517e35c9ebf3c10575c98a76377f", "thumbnail_srcset": "https://si.imgix.net/b750f9ff/uploads/origins/3f448a66-f418-4f1b-b628-fef76ddf6ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ea0517e35c9ebf3c10575c98a76377f, https://si.imgix.net/b750f9ff/uploads/origins/3f448a66-f418-4f1b-b628-fef76ddf6ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef55e7b5b38edbb9265243c302359a3c 2x, https://si.imgix.net/b750f9ff/uploads/origins/3f448a66-f418-4f1b-b628-fef76ddf6ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b725ce3fe664d16e70d9721a36f9a56 3x", "genre": "art", "nsfw": false, "body": "10時様\n\n初めまして、突然のメッセージ失礼致します。\n以前より10時様の素敵な作品を拝見して、ぜひ作品を依頼したく連絡差し上げました。\n\nもしよろしければ、友人と私のTRPGキャラクターのイラストを描いていただけないでしょうか？(友人並びに立ち絵を制作して頂いた絵師様の許可は得ております)\nポーズ並びに表情は10時様におまかせしますので、10時様の解釈で制作していただければと存じます。\nキャラクターの詳細及び資料は、下記のURL先にてフォルダにまとめておりますので、ご参照下さいませ。\nまた、可能でしたらそれぞれの透過画像も添付していただけるとありがたく存じます。\n\nお忙しい中誠に恐縮ですが、差し支えなければご検討頂ければ幸いです。\n金額に不足がありましたら、遠慮なく再送・キャンセルして下さいませ。\n\nよろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/z8ixhu34lgsc5xv2xq6pi/AMfm8QpSi70-ESImsGf14hI?rlkey=rfo0k0eat7xatj0ydlz2gaz0f&st=hbnr4e3v&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/41", "thumbnail_src": "https://si.imgix.net/26b33e6e/uploads/origins/b946ab77-b994-49ac-89d2-1d5cf7b318b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fa00ff9c9f8162d69bdc3e6cd0b9788", "thumbnail_srcset": "https://si.imgix.net/26b33e6e/uploads/origins/b946ab77-b994-49ac-89d2-1d5cf7b318b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fa00ff9c9f8162d69bdc3e6cd0b9788, https://si.imgix.net/26b33e6e/uploads/origins/b946ab77-b994-49ac-89d2-1d5cf7b318b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a32c16d7a63d6c67b5f8e95dd3e9f397 2x, https://si.imgix.net/26b33e6e/uploads/origins/b946ab77-b994-49ac-89d2-1d5cf7b318b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15299e14bbdcafafd1541e8b16924a74 3x", "genre": "art", "nsfw": false, "body": "初めまして！\n 個人勢として活動しております、VStreamerの鳳梨まおと申します。 \n\n10時様の可愛いかつかっこいい雰囲気もあるイラストに惹かれ、この度依頼させていただきました。\n今回はペア画をお願いいたします\n※相手様には許可をいただいております\n\n使用用途:相手様へFAとしてプレゼント/Xにて投稿での使用/おはVへの使用\n\n●共通:服装は【チャイナドレス】でお願い致します。 相手様が\"スリットが大きく入ったロングのチャイナドレス\"が好きとの事でしたので、色違いでお揃いにしていただけますと幸いです。\nそれ以外は基本おまかせで問題ございません\n \n●キャラクター情報 \n◾︎鳳梨まお(私) まったりパンダ系VStreamer アクティブな見た目ですが、性格はおっとりです。年齢は大体高校生くらいのイメージですが、お顔は目が大きく童顔です。 そして丸目とまろ眉が特徴です。\n\nメインカラー:彩度低めの紫 \n\n ◾︎覇道しらべ(相手方) 鼓舞系Streamer 圧倒的美人が強みで、宝塚にいそうな見た目です。ほんと色々強い女です。\nどんなゲームでもタンク系を好んでるイメージです\nですがチャイナドレスが着たいなど中身は乙女なところもあります。\n\n メインカラー:臙脂色(ボルドー)  \n\n●相手様との関係 私が一方的にラブコール送ってる側です！\n 一緒にコラボをしたり、リプでよく会話してくれます！ \n相手様のことを\"しら姉\"と呼んでおります。\nそれくらい尊敬できて頼れるお姉様です！  \n\n以上となります。 よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1_CEmLuAo7nRrhxqkJr18QeNXzxVJoWh9", "created_at": "", "completed_at": ""}, {"path": "/@Red10am/works/40", "thumbnail_src": "https://si.imgix.net/b8bdd693/uploads/origins/c14ce128-44ed-47ae-a03a-d1c844866305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aab716c6bd28f79b82f9737d1f7884d6", "thumbnail_srcse