9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d92d06f08fc1cf654f1593836cb364af, https://si.imgix.net/42e63e9e/uploads/origins/68ab078c-d772-4776-82e0-9dcaa015fbe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7413eb8e13c536c473447b658e173ff 2x, https://si.imgix.net/42e63e9e/uploads/origins/68ab078c-d772-4776-82e0-9dcaa015fbe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3db974421a78eb112b6168856cf09f3 3x", "genre": "art", "nsfw": false, "body": "私服ゆかりさんと街ブラおデート！おみ足がチャームポイント！", "created_at": "", "completed_at": ""}, {"path": "/@sazinoki/works/16", "thumbnail_src": "https://si.imgix.net/792b0476/uploads/origins/18f58eae-585b-4d6f-bfce-7a8f9b0da52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69372ecda86689802d879909af0820c2", "thumbnail_srcset": "https://si.imgix.net/792b0476/uploads/origins/18f58eae-585b-4d6f-bfce-7a8f9b0da52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69372ecda86689802d879909af0820c2, https://si.imgix.net/792b0476/uploads/origins/18f58eae-585b-4d6f-bfce-7a8f9b0da52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc695133621a179567464717d8df4eb6 2x, https://si.imgix.net/792b0476/uploads/origins/18f58eae-585b-4d6f-bfce-7a8f9b0da52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a963a71c20987c6b8f5476501a80f17f 3x", "genre": "art", "nsfw": false, "body": "はじめまして、もしよろしければユーステラ（@U_StellaWeb）の子達の中で「CCD-0001　ユニ」という子をお願いします。\n先日さじのき様がボイコネで出された本がとても良かったので、そこからインスピレーションを受けてせっかくですので、ユニちゃんがお洒落な秋っぽい感じの格好をしているイラストを描いていただけるととても嬉しいです。\n\nよろしくお願い致します。\n\nhttps://x.com/CCD0001_UNI/status/1666012563048656896?s=20", "created_at": "", "completed_at": ""}, {"path": "/@sazinoki/works/15", "thumbnail_src": "https://si.imgix.net/e7367615/uploads/origins/d2344259-00b1-428d-a01c-3dcaae4aa371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20