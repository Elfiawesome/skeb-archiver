771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18fd3dcfbafe79133208a5a26b256d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=804a87520843f12d82d066caf68c4e69 3x", "genre": "music", "nsfw": false, "body": "はじめまして。おいし水さんの作られる曲が大好きです。\nもしよければ、以下の文章から自由に曲を作っていただけないでしょうか？\n\n『氷でできた鯨の背に乗り、海を渡って旅をする少年（いつか鯨は溶けてしまい、旅にも終わりが訪れる）』\n\nチルだけど、ちょっと切ない感じのイメージです。\nループありだと嬉しいです。\n用途は個人的に、または動画配信などで使用させていただく可能性がございます。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oississui/works/11", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18fd3dcfbafe79133208a5a26b256d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=804a87520843f12d82d066caf68c4e69 3x", "genre": "music", "nsfw": false, "body": "おいし水さま\n\nはじめまして、モヨコと申します。\n「ファミレスを享受せよ」、大好きなゲームです。BGMもYoutubeでヘビロテしていたのですが、このたびskebを開けられていることを知りご依頼させていただきます。\n\n▼依頼内容\nオリジナルキャラクターの2人を表すようなBGMをお願いしたいです。\nキャラクターの見た目は添付いたします。黒い髪の方が「月」、ピンクの髪のほうが「星」をイメージしたキャラクターです。\n「惹かれ合う月と星」をテーマにロマンチックで神秘的な曲をお願いできますでしょうか。\n\n▼用途\n個人鑑賞用です。ループBGMでも問題ありません。\n\nご縁がありましたら、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10APZ5InAAogrRfpLxhIaje-5tRKFhzYF", "created_at": "", "completed_at": ""}, {"path": "/@oississui/works/10", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18fd3dcfbafe79133208a5a26b256d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=804a87520843f12d82d066caf68c4e69 3x", "genre": "music", "nsfw": false, "body": "初めまして。\n作品から感じる切なさやときめき、心の奥にそっと寄り添ってくれるような優しい雰囲気が大好きで、ぜひ曲を制作していただきたくご依頼いたしました。\n\nリクエスト内容ですが、「雪山の奥で静かに暮らしている魔法使い」をイメージした曲をお願いしたいです。冬の静謐さや人と交わって生きられない切なさを感じる作品だと嬉しいです。\n既存のキャラクターを意識しているわけではございませんので、ご自由に制作していただければ幸いです。\n\n個人鑑賞用として楽しませていただきます。ループする仕様にしていただけるとありがたいです。\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oississui/works/9", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18fd3dcfbafe79133208a5a26b256d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=804a87520843f12d82d066caf68c4e69 3x", "genre": "music", "nsfw": false, "body": "おいし水　様\n\nこんにちは。\n『ファミレスを享受せよ』、とても楽しいゲームでした。素敵な作品を制作してくださり、ありがとうございます。ゲーム自体はもちろん、劇中の音楽がすごく好きです。YouTubeに上げてくださったBGMを深夜に聴きながら絵を描いているのですが、生活の楽しみがひとつ増えました。\n\nskeb再開されたとのことで、ぜひリクエストさせて頂きたいです。\n\n【内容】\n自分の話になってしまうのですが、朝起きるのが小学生の頃からつらく、高校時代はさらに早起きをしなければならず、JR北海道から札幌の地下歩行空間を少し沈んだ気持ちで歩く生活が続いていました。\n\n現在でもそれは変わらず、朝は毎日なんとも言えない気怠さがあり、家を出る準備をするのがしんどいです。\n\n深夜にファミレスを享受せよのBGMを聴くようになってからは深夜が好きになれたので、朝をともにできる音楽があるととても嬉しいです。\n\n【資料】\n以前撮った地元の写真を添付します。さわやかで騒々しい朝というよりは、比較的静かな、深夜とまだ地続きな朝のイメージです。\n\nhttps://drive.google.com/drive/folders/10rQqgrWkRPCA60wE0ibWPnJs7z0hmyzJ\n\n【用途】\n・朝、起きれるようにするため\n・朝の準備のためのBGMとして\n・絵を描くときのBGMとして\n・まれに動画投稿や配信をするのでその際のBGMとして\n使用できたら幸いです。\n\nループや長さなどは特に指定ありません。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oississui/works/8", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18fd3dcfbafe79133208a5a26b256d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=804a87520843f12d82d066caf68c4e69 3x", "genre": "music", "nsfw": false, "body": "おいし水さま初めまして。『ファミレスを享受せよ』の世界観、キャラ、曲どれも大好きです。\n主人公の明るくガンガン人と交流していく性格はとても惹かれるものがありました。と言いつつセロニカさん推しです。\nskebをやってらっしゃるのを知り、よろしければご依頼させて頂けましたらと思いリクエストを失礼いたします。\n\n【使用用途】\n作業用としてずっと聴いていられたらと思っています。また、創作活動の動画を上げた際、BGMにしたいとも考えています。個人用です。\n\n【イメージ】\nわたしの創作の子になります。小さな女の子で、あかるく元気・やんちゃでちょっとおちゃらけたイメージ。けれど偶に静謐な雰囲気をみせる…みたいな。色だと白やピンク、水色なイメージです。", "created_at": "", "completed_at": ""}, {"path": "/@oississui/works/7", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18fd3dcfbafe79133208a5a26b256d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=804a87520843f12d82d066caf68c4e69 3x", "genre": "music", "nsfw": false, "body": "こんにちは。\n夫婦そろっておいし水さんのファンをやらせていただいてます。\n\nジャジーな感じのループBGMをお願いしたいです。\n「クジラ(夫)と小さいゴールデンレトリーバー(妻)がBARでお酒を飲んでいる」ようなイメージです(分かりづらくてすみません)\n\nまっっっったく圧をかけるとかそういうわけではないのですが、今後もしイラストのskebも始めるようなことがあればぜひTwitterやブログでその旨宣伝していただけると嬉しいです。\nすぐに飛んできます。\n需要がある、ということを伝えるだけでも意味があるかと思いましたので、恐縮ながら書かせていただきました。(やってくれと圧をかける意図は毛ほどもございません！)\n\n新作ゲームも楽しみにしています。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@oississui/works/6", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb2958673c37f9510c784f0b1c4f8bdf, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18fd3dcfbafe79133208a5a26b256d9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=804a87520843f12d82d066caf68c4e69 3x", "genre": "music", "nsfw": false, "body": "おいし水様\n初めまして！ファミレスを享受せよ、とても素敵な作品でした。\nBGMもYOUTUBEで聞いております、ノスタルジックな感じがしてとても好きです！\nよければリクエストをお願いしたく送らせていただきます。\n\n【内容】\nオリジナルキャラクターのBGMをお願いしたいと思っています。\n名前が【ふわふわ蒸気機関いぬ】\n概要が【木炭で動くスチームパンクないぬ型アンドロイド、または人型アンドロイド】【喫茶も出来る移動図書館の主】\nキーワードとしては【スチームパンク】【コーヒー】【図書館】【いぬ】といったものになります。\n曲としては、その図書館に流れる空気のような曲をお願いしたいです。\n資料URLにはそのキャラクターのイラストや情報などを乗せておりますが、上記キーワードだけの使用でも構いません。そこはお任せしたいと思います。是非とも、おいし水さんの個性を出していただければなと思います。\n\n【用途】個人観賞（作業BGM）及び動画作成などに使用したいと考えています。\nループBGMですとありがたいです。\n\nご縁が有りましたらぜひ、よろしくお願いいたします。\n\nhttps://wel-0.jp/welinu.html", "created_at": "", "completed_at": ""}, {"path": "/@oississui/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1523663745511456771%2FB7tFL3l0.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=260c4fecebfa42e7138a70ff10385c6d", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofi