iddle%2Ccenter&txtsize=30&txt=PRIVATE&s=38a621af792bdfbe7e2e968d3c171704 2x, https://si.imgix.net/47f40c52/uploads/origins/81bd6f7f-bbc9-47a0-bf67-9160f4dc2c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27a88c14725e1d6571d2c2641d9b16ba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mayamaya36/works/15", "thumbnail_src": "https://si.imgix.net/a87d165c/uploads/origins/63b43c4b-9c09-453d-ac1f-acafdef0cabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07a09f427e92785074b713838a3f68b2", "thumbnail_srcset": "https://si.imgix.net/a87d165c/uploads/origins/63b43c4b-9c09-453d-ac1f-acafdef0cabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07a09f427e92785074b713838a3f68b2, https://si.imgix.net/a87d165c/uploads/origins/63b43c4b-9c09-453d-ac1f-acafdef0cabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2ee626f4605a4ad202843fc7f9fd63c 2x, https://si.imgix.net/a87d165c/uploads/origins/63b43c4b-9c09-453d-ac1f-acafdef0cabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=455733e21a28c9d7cf3c3d74bc0c824b 3x", "genre": "art", "nsfw": false, "body": "前回はキャンセルとなってしまいましたので、改めてリクエストを送らせて頂きました。\n【作品】フラワーナイトガール\n【キャラクター】ハギ\nhttps://imgur.io/a/C8BbCmE\n先生の銘菓ちゃんシリーズから『萩の月』と並び座って、萩の月を食べているシチュエーション、初めて食べる萩の月に笑顔のハギを暖かく見つめる『萩の月』という感じの構図をお願いします。\n背景やその他細かな部分についての裁量はお任せします。\nどうぞご検討の程、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@mayamaya36/works/14", "thumbnail_src": "https://si.imgix.net/d3dad980/uploads/origins/f17673be-d692-4e10-a365-f0a601689b38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=817b66439864079b4ba19db563d01249", "thumbnail_srcset": "https://si.imgix.net/d3dad980/uploads/origins/f17673be-d692-4e10-a365-f0a601689b38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=817b66439864079b4ba19db563d01249, https://si.imgix.net/d3dad980/uploads/origins/f17673be-d692-4e10-a365-f0a601689b38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4fc44411b17dae44fa5546375b76339 2x, https://si.imgix.net/d3dad980/uploads/origins/f17673be-d692-4e10-a365-f0a601689b38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=641ce55322142f3742078354fb9872ea 3x", "genre": "art", "nsfw": false, "body": "はじめまして。いつも素敵な作品で楽しませていただいております。\nリクエストの内容ですが、\nにゃんことカイザーにでてくるりんごちゃんが好きなので\nりんごちゃんをメインに、にゃんこちゃん、からすさん、犬カイザーを\nお願いします。\n\nりんごちゃんの指定ですが、両目は開けていて、困り眉の表情がかわいいのでお願いしたいです。\nにゃんこちゃん、からすさん、犬カイザーは小さくてよいので描かれていると嬉しいです。\n\nＰＣの壁紙として使用したいので横長の構図でお願いします。\n服装、シチュエーション等はおまかせします。\n\nお体の具合悪いところ恐縮ですが、金額等あわせてご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mayamaya36/works/13", "thumbnail_src": "https://si.imgix.net/f22a0693/uploads/origins/90865b5c-459f-471d-8e91-6d1ff434e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fbdebbe8fc865bc7e9995d30b8faf3f", "thumbnail_srcset": "https://si.imgix.net/f22a0693/uploads/origins/90865b5c-459f-471d-8e91-6d1ff434e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fbdebbe8fc865bc7e9995d30b8faf3f, https://si.imgix.net/f22a0693/uploads/origins/90865b5c-459f-471d-8e91-6d1ff434e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21dae24210216dbf9e69dfa0a95dc0a9 2x, https://si.imgix.net/f22a0693/uploads/origins/90865b5c-459f-471d-8e91-6d1ff434e85b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9745a84b7a8a61157242507e4fc5cf03 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストをありがとうございます。今回はプラネットのアバターのイラストをお願いします\n下記リンクに資料があります\n\nhttps://twitter.com/souya_rin_ron/status/1615321745568989185?t=HmrTqdx9NHPoVrFIISPNOw&s=19\n\n以下依頼内容となります\n\nアバターですが、それぞれの中は今までの依頼で描いて頂いた\nりん→ベル\nめぐみ→ブルーム\nとなっております。顔つきはそれぞれのイメージを引き継いだ感じでお願いします\n\nシチュエーションは、立ち位置は画像3で、ブルームにベルが横から抱きついているような感じにお願いします\n\nブルームは正面を向いて立っていて、ベルはブルームの隣に立ち、向かって真横もしくは斜めを向いて、ブルームの腕に軽く寄りかかっているような体勢で、顔は首から肩の高さに寄せて正面向きのような体勢にお願いします\n抱きついている腕はお腹〜腰の辺りに回しているような感じです\n\nブルームは嬉しさと照れくささが混じったような表情、ベルは無邪気に笑っている表情\n可能であれば2人の視線が合っているような感じでお願いします\n\nコーデはベルがPRブライトサファイア、ブルームがPRラグジュアリーローゼ\n胸は大きめで、2人とも同じ位の大きさでお願いします。\n背景等はお任せします\n\n頂いたイラストは当方のSNSアカウントのアイコンやヘッダー等で利用させて頂きたいです\nお忙しいところ恐縮ですが、よろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@mayamaya36/works/12", "thumbnail_src": "https://si.imgix.net/419a64b2/uploads/origins/6333df55-beef-41cd-ab9b-5dc8cf418edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c36fa2afbf136bf35bcf85dcebecb8cd", "thumbnail_srcset": "https://si.imgix.net/419a64b2/uploads/origins/6333df55-beef-41cd-ab9b-5dc8cf418edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c36fa2afbf136bf35bcf85dcebecb8cd, https://si.imgix.net/419a64b2/uploads/origins/6333df55-beef-41cd-ab9b-5dc8cf418edd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d1d27bcf514aa960d5e8e49a7d2c90e 2x, https://si.imgix.net/419a64b2/uploads/origins/6333df55-beef-41cd-ab9b-5dc8cf418edd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bcafdbce7f67bcf3fed5f7a14538547 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mayamaya36/works/11", "thumbnail_src": "https://si.imgix.net/a650ecf1/uploads/origins/9dc79bea-f98d-48c5-b634-743f95328d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90053c13bd4079374506f71664945410", "thumbnail_srcset": "https://si.imgix.net/a650ecf1/uploads/origins/9dc79bea-f98d-48c5-b634-743f95328d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90053c13bd4079374506f71664945410, https://si.imgix.net/a650ecf1/uploads/origins/9dc79bea-f98d-48c5-b634-743f95328d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96f15fe7074370d35ba55735eacab080 2x, https://si.imgix.net/a650ecf1/uploads/origins/9dc79bea-f98d-48c5-b634-743f95328d3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=448f00671ff2e747eb127973e1f0a7f8 3x", "genre": "art", "nsfw": false, "body": "前回は本当にありがとうございました！\n今回は前回描いて頂いた右側の方の\"めぐみ\"のイラストをお願いします。顔、色、体型は同じようにお願いします\n(https://skeb.jp/@mayamaya36/works/6 )\nシチュエーションとしましては、人魚姿のめぐみが海の中で淑やかに佇んでいる様子を希望します\n構図は全身が入るようにお願いします\n以下、服装のお願いです\n上半身の服は貝殻ビキニで、耳は魚のヒレのようにして下さい。両脇腹に魚のヒレ(細く縦長)を付けて頂きたいです(色は下半身と同じ色です)\n下半身は薄黄緑の魚で、鱗の有無はお任せします。尾ヒレはイルカのようにお願いします\n変わり目の部分は馴染ませるようにして下さい\nその他装飾等お任せします。ちょっとしたお姫様みたいにして頂けると嬉しいです\nお忙しい中大変申し訳ありませんが、是非よろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@mayamaya36/works/10", "thumbnail_src": "https://si.imgix.net/a2dba00e/uploads/origins/fca488f8-a0bd-4b1e-a16a-04a49125f106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6153d392d4ffd95f287effa601376f4", "thumbnail_srcset": "https://si.imgix.net/a2dba00e/uploads/origins/fca488f8-a0bd-4b1e-a16a-04a49125f106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6153d392d4ffd95f287effa601376f4, https://si.imgix.net/a2dba00e/uploads/origins/fca488f8-a0bd-4b1e-a16a-04a49125f106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff1eb3f0dee2a034b5c94b0f05b46f29 2x, https://si.imgix.net/a2dba00e/uploads/origins/fca488f8-a0bd-4b1e-a16a-04a49125f106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7277bfd5d642873b16d19bc10b7d4770 3x", "genre": "art", "nsfw": false, "body": "