dde73-a297-47e4-9f5f-fef5bde27b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0616ca08aca653d3c5785e860e5d239", "thumbnail_srcset": "https://si.imgix.net/23de8533/uploads/origins/588dde73-a297-47e4-9f5f-fef5bde27b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0616ca08aca653d3c5785e860e5d239, https://si.imgix.net/23de8533/uploads/origins/588dde73-a297-47e4-9f5f-fef5bde27b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ac9b68f26934d65f8c8877ce69e4a9d 2x, https://si.imgix.net/23de8533/uploads/origins/588dde73-a297-47e4-9f5f-fef5bde27b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a141b3faed638987e66a3b808fb7b85 3x", "genre": "art", "nsfw": false, "body": "FF14のキャラクターのイラストをdiscordとtwitterの写真用にお願いしたいのですが、いかがでしょうか？名前はルロリタンです。  強くて、セクシーで、自立している人です。ポーズ、構図、背景はおまかせします!ありがとうございます。服装は写真を見ていただければと思いますが、一応服装の名前をここに書いておきました\n\n頭：魔界マークスウーマンのリボン。\nトップ：Makai Markswoman's Battle Dress,\nボトムスマカイマークスウーマンのクォータータイツ。\n靴ブラックボッサムブーツ\nイヤリング紫蛾蘭のコサージュ\n\nhttps://drive.google.com/drive/folders/1rkuRZCwnpxXE2z-meFwvFhbj3K-qzNHq?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@yuru_yuru_draw/works/2", "thumbnail_src": "https://si.imgix.net/0f1e4562/uploads/origins/195e662e-39c2-4f15-8ef2-765b982a8440?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e6271c234c4e95996b3cf94421ed049", "thumbnail_srcset": "https://si.imgix.net/0f1e4562/uploads/origins/195e662e-39c2-4f15-8ef2-765b982a8440?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e6271c234c4e95996b3cf94421ed049, https://si.imgix.net/0f1e4562/uploads/origins/195e662e-39c2-4f15-8ef2-765b982a8440?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad58a960479def872e9823a025d0ace3 2x, https://si.imgix.net/0f1e4562/uploads/origins/195e662e-39c2-4f15-8ef2-765b982a8440?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top