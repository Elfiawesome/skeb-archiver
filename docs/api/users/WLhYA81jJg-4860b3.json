ad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fce5c9770db66dd9957aee3c463cedb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@WLhYA81jJg/works/16", "thumbnail_src": "https://si.imgix.net/32384e09/uploads/origins/98ede693-f82a-4bd2-b810-273818dc0fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c891abe8ece2fe718983ef4516b0e06", "thumbnail_srcset": "https://si.imgix.net/32384e09/uploads/origins/98ede693-f82a-4bd2-b810-273818dc0fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c891abe8ece2fe718983ef4516b0e06, https://si.imgix.net/32384e09/uploads/origins/98ede693-f82a-4bd2-b810-273818dc0fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70309499dff2b2096fa492475e75e489 2x, https://si.imgix.net/32384e09/uploads/origins/98ede693-f82a-4bd2-b810-273818dc0fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=357425fb50cd24649b0e33a6a8747895 3x", "genre": "art", "nsfw": false, "body": "今年もありがとうございました。\nいつも素敵なイラストありがとうございます。\n\nOCのイラストをお願いしたいです。構図はお任せします。\n（可能でしたらバイザーとマスクが別レイヤーであると嬉しいです。）\n\nhttps://drive.google.com/drive/folders/1_twstIRJT4KtMByLHHPXslgQXB1kv9Ba?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@WLhYA81jJg/works/15", "thumbnail_src": "https://si.imgix.net/7a83886e/uploads/origins/0d4d8c43-3130-4366-a27f-2715a2c59ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb62e1caba69eafe7e3cd5546782b008", "thumbnail_srcset": "https://si.imgix.net/7a83886e/uploads/origins/0d4d8c43-3130-4366-a27f-2715a2c59ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb62e1caba69eafe7e3cd5546782b008, https://si.imgix.net/7a83886e/uploads/origins/0d4d8c43-3130-4366-a27f-2715a2c59ca1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=197ead11a41aedd3706047225d9cdeed 2x, https://si.imgix.net/7a83886