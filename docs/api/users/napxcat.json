6-02-26T11:54:12.775717+00:00"}, {"amount": 12000, "recorded_at": "2026-02-26T21:23:27.635961+00:00"}, {"amount": 21000, "recorded_at": "2026-02-27T11:53:18.922257+00:00"}]}, "current_prices": {"art": 21000}, "price_range": {"art": {"min": 10000, "max": 22000}}, "links": [{"label": "Twitter", "url": "https://x.com/napxcat", "name": "napxcat"}, {"label": "Misskey_io", "url": "https://misskey.io/@napxcat", "name": "napxcat"}, {"label": "Website", "url": "https://www.twitch.tv/napxcat", "name": ""}, {"label": "Fanbox", "url": "https://napxcat.fanbox.cc", "name": "napxcat"}], "flags": {"from_archive": true}, "acceptable": false, "works": [{"path": "/@napxcat/works/211", "thumbnail_src": "https://si.imgix.net/7c4a5698/uploads/origins/79b1ec7a-049f-47e0-8083-00477db67403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6737edd2ffc2635cd58fc3a1ceb515", "thumbnail_srcset": "https://si.imgix.net/7c4a5698/uploads/origins/79b1ec7a-049f-47e0-8083-00477db67403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6737edd2ffc2635cd58fc3a1ceb515, https://si.imgix.net/7c4a5698/uploads/origins/79b1ec7a-049f-47e0-8083-00477db67403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01042f45a2197130b5f7c338a0ee02d1 2x, https://si.imgix.net/7c4a5698/uploads/origins/79b1ec7a-049f-47e0-8083-00477db67403?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=117f379ae57132e1b3f7c05c857966f2 3x", "genre": "art", "nsfw": false, "body": "前回は素晴らしい作品ありがとうございます。\n募集開始の通知を受け、リクエストさせていただきました。\nもしよければ、ケイカちゃんとうちの子フィムのイラストをお願いします。\n\n【シチュエーション】\n以下のシチュエーションのお好きな方でお願いします。\n・うちの子がケーキ(あるいはお菓子)を作ってるところをケイカちゃんが眺める(ケイカちゃんがつまみ食いしようとしててもかわいいかも)\n・2人でケーキ(あるいはお菓子)を食べる\n\n服装はシチュエーションに合いそうなものに変更していただいても大丈夫です。\n\n 【資料】\n立ち絵、設定 \nhttps://www.pixiv.net/artworks/131783541", "created_at": "", "completed_at": ""}, {"path": "/@napxcat/works/210", "thumbnail_src": "https://si.imgix.net/617c343b/uploads/origins/e1205198-1658-4b6e-8103-c7718e4b1b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2348e0a50a02326a2fb3b50d93d8af7", "thumbnail_srcset": "https://si.imgix.net/617c343b/uploads/origins/e1205198-1658-4b6e-8103-c7718e4b1b68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2348e0a50a02326a2fb3b50d93d8af7, https://si.imgix.net/617c343b/uploads/origins/e1205198-1658-4b6e-8103-c7718e4b1b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1674c64eac052f1abb396f04e5684e1e 2x, https://si.imgix.net/617c343b/uploads/origins/e1205198-1658-4b6e-8103-c7718e4b1b68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9c936aa5471a2f6949453c506a97b65 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nいつも素敵なイラストありがとうございます！\n\n私のOCの「やまかみきゃっと」と「シャラート」の二匹を描いて頂けないでしょうか？\n主な用途はアクスタにしてお出かけに持って行ければと考えています！\n詳細部分に関してはお任せしますが、二匹が並んでポージングしている形でお願いできればと思っています。\n\n■資料\n・やまかみきゃっと\nhttps://drive.google.com/drive/folders/1njg11-fdZkyQlL-HqRsulDUu8iMipim6?usp=sharing\n・シャラート\nhttps://drive.google.com/drive/folders/1JxhO2gS1a8SYuvnx3jU37-w8Q9_VgNBZ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@napxcat/works/209", "thumbnail_src": "https://si.imgix.net/32d5f223/uploads/origins/6bc82f4c-2ce6-48ae-8484-6c0a862e6d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03323fd29763a2a86b1e5bd20cbe1f9e", "thumbnail_srcset": "https://si.imgix.net/32d5f223/uploads/origins/6bc82f4c-2ce6-48ae-8484-6c0a862e6d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03323fd29763a2a86b1e5bd20cbe1f9e, https://si.imgix.net/32d5f223/uploads/origins/6bc82f4c-2ce6-48ae-8484-6c0a862e6d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a1c9604da697f01699181c8f3b5d553 2x, https://si.imgix.net/32d5f223/uploads/origins/6bc82f4c-2ce6-48ae-8484-6c0a862e6d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f21823d135f1acf6f24ba9b018fff66c 3x", "genre": "art", "nsfw": false, "body": "お初のご依頼失礼します！\nいつも可愛いイラストに癒されておりますm(_ _)m\n\n今回ご依頼したいのは、私のOCのスナネコちゃんで、ちょっとだらけた服装（ダボTとパンツのみなど）のをお願いしたいです！\n※キャラシートではスリムですが、出来ればちょっと冬毛多め（むっちり）にして頂けると助かります！\n表情、背景、ポーズ等はお任せ致します！\n何卒宜しくお願いします！\n\nhttps://x.com/sunaneko_KEMO/status/1643220351609090049?t=GcDd_j_s8DEVzRAiza7SvA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@napxcat/works/208", "thumbnail_src": "https://si.imgix.net/22a4d88a/uploads/origins/018927c1-940a-458e-9798-fbf2e31ce974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7ab549da2579bbf0007926c1d05d9a3", "thumbnail_srcset": "https://si.imgix.net/22a4d88a/uploads/origins/018927c1-940a-458e-9798-fbf2e31ce974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7ab549da2579bbf0007926c1d05d9a3, https://si.imgix.net/22a4d88a/uploads/origins/018927c1-940a-458e-9798-fbf2e31ce974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f68b2b639ce62d69acd5721456d9a83c 2x, https://si.imgix.net/22a4d88a/uploads/origins/018927c1-940a-458e-9798-fbf2e31ce974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5318b5fe66f684d4541babbfdecbb3a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、おりはたと申します。以前にも描いていただいた、私がVRChatで使用しているアバターのイラストを再度お願いしたく思い、リクエストを送らせていただきました。\nこちらがアバターについての資料になります。資料から分からない部分は自由に補完していただいて問題ございません。\nhttps://olihata.notion.site/lessermokuri-document\nhttps://olihata.notion.site/miminomi-document\n\nシチュエーションなどはねこまじん様にお任せいたしますが、2匹の生活感が感じられるようなイラストだと嬉しいです（ラスカがリェータの尻尾のブラッシングをしている、一緒になにかを食べている、2匹でリェータの尻尾を抱きまくらにして寝ているなど）\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@napxcat/works/207", "thumbnail_src": "https://si.imgix.net/783acb46/uploads/origins/24d2cdd9-5915-49b6-9cea-64cacf37964b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbfaa86c21ed9a672dcb702792bfd8d8", "thumbnail_srcset": "https://si.imgix.net/783acb46/uploads/origins/24d2cdd9-5915-49b6-9cea-64cacf37964b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbfaa86c21ed9a672dcb702792bfd8d8, https://si.imgix.net/783acb46/uploads/origins/24d2cdd9-5915-49b6-9cea-64cacf37964b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=896983cb6a9eb34abe70b092105ab9f0 2x, https://si.imgix.net/783acb46/uploads/origins/24d2cdd9-5915-49b6-9cea-64cacf37964b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c8ef377eecc7ba7db90877681b5c3d6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！👋\nはじめまして！お元気ですか？😄\n\nSkebのリクエスト受付が再開されているのを見て、ぜひイラストをお願いしたいと思いました！！\nあなたのとても可愛くてユニークな絵柄が本当に大好きで、キャラクターたちをとても愛らしく描かれているところが素晴らしいです。あなたのスタイルは本当に唯一無二ですね！🥰🥰🥰\n\n私のふわふわしたドラゴンを描いていただきたいです！\n彼はエネルギッシュで、カリスマ性があり、冒険好きで、魅力的で、いつも明るい性格です。\n描き方はすべてお任せします☺️\nあなたの才能なら、きっと素敵な作品にしてくださると思います！😆\n\nご検討いただけたらとても嬉しいです。\nどうぞよろしくお願いいたします！❤️💜\n\nhttps://drive.google.com/drive/folders/175SL7H91hYIrIsWqU6FdTguZo3Bag6aQ", "created_at": "", "completed_at": ""}, {"path": "/@napxcat/works/206", "thumbnail_src": "https://si.imgix.net/deb5dbc8/uploads/origins/2a509da0-a074-410f-b06b-c54621cfc061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1371c70279bc70da086c24859a6f1cd", "thumbnail_srcset": "https://si.imgix.net/deb5dbc8/uploads/origins/2a509da0-a074-410f-b06b-c54621cfc061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1371c70279bc70da086c24859a6f1cd, https://si.imgix.net/deb5dbc8/uploads/origins/2a509da0-a074-410f-b06b-c54621cfc061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb1b0d62f63b823d78ec4bf2564d91cc 2x, https://si.imgix.net/deb5dbc8/uploads/origins/2a509da0-a074-410f-b06b-c54621cfc061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c4f538ef6fe27ea5bf9f847d8367a96 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n以前ねこまじんさんにご依頼させていただきました、Vtuberとして活動しております、胡桃つむぎと申します。\n\nskebの募集を開始されたと拝見し、ぜひリクエストさせて頂きたくまいりました！\n\nリクエスト内容は胡桃つむぎのお酒をおいしく飲んでいるイラストになります。\n楽しそうに飲んでいる雰囲気だと嬉しいです。\n\n構図やポーズにこだわりはありませんが、耳と尻尾の部分が切れてないと嬉しいです…！足元などは切れていても大丈夫です。\n\n参考までにお酒は梅酒・ビール・ハイボールを好んで飲んでいます。なんでも飲めるのであくまで参考で大丈夫です！\n \n衣装はデフォルトの物がありますが、描きやすいように変更いただいても大丈夫です。\n\nYouTubeのサムネイルやSNSでの活動で使用せて頂きたく、可能であれば人物のみの透過バージョンもいただければ幸いです…！\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-BDDNs8BNWb4ly5lhOXoSDwjBe5A7NL5", "created_at": "", "completed_at": ""}, {"path": "/@napxcat/works/205", "thumbnail_src": "https://si.imgix.net/89bca349/uploads/origins/71dd9799-9c2c-4f7a-ba1c-72cdcda073c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76d145697c22738607e3bf6bdb208c6f", "thumbnail_srcset": "https://si.imgix.net/89bca349/uploads/origins/71dd9799-9c2c-4f7a-ba1c-72cdcda073c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76d145697c22738607e3bf6bdb208c6f, https://si.imgix.net/89bca349/uploads/origins/71dd9799-9c2c-4f7a-ba1c-72cdcda073c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2debd34ed694fa9544c66056e53d9364 2x, https://si.imgix.net/89bca349/uploads/origins/71dd9799-9c2c-4f7a-ba1c-72cdcda073c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2298f00dd99aa95f601bf079ec8be6f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@napxcat/works/204", "thumbnail_src": "https://si.imgix.net/574bdf5b/uploads/origins/35b03ba8-5b71-4d8d-a039-ec842ae503ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=762876e45f8cec616b9f659c28dde084