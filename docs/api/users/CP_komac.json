_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cad2d04b1585073950cb44dd9e18c812, https://si.imgix.net/ae1f98bc/requests/158277_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93f05037df87ee5805032fa3de8cd83a 2x, https://si.imgix.net/ae1f98bc/requests/158277_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=835cb92ca82a80517bd9741907089276 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生。\n\n私はあなたの絵が好きな韓国のファンです。\n\n今回はオリジナルキャラクターを描いて頂きたくご連絡致します。\n\n添付された最初のリンクを基準にご説明いたします。\n\n二人は神という設定のキャラクターで、右側は狩りを司る蛇神であり、左側は武芸全般と戦争を司る神です。\n\n二人とも現代の文明に接触して、ダメ神になりました。\n\n右側の白いお子は世の中が面倒くさくなり、左側の青いお子はよく言う陰キャとなりました。\n\n二人は戦争を経験しながら姉妹神として後世に伝えられたものなので、互いにいがみ合ったりもしますが、基本的には仲は悪くありません。\n\n構図と背景は先生が自由に描いていただければ幸いです。\n\n暗い部屋でテレビの光を照明して二人でゲームをしている姿とか、些細なことでケンカしている姿とか、何でもいいです。\n\nキャラクターの衣装は二人とも2番目のリンクに描かれた制服でお願いします。\n\n​\n\nキャラクターのデザインが描かれたリンクを添付します。\n\n1つ目は2人とも描かれた姿で、2つ目は白い子の設定画のようなものです。\n\n青い子の方の髪は、3つ目のリンクにあるようになります。\n\n​\n\nhttps://picrew.me/share?cd=9X3iHviMmO\n\nhttps://bbs.tunaground.net/upload/image/1599290064545-339593797----.jpg\n\nhttp://li.nu/attrade/item.php?id=11177603", "created_at": "", "completed_at": ""}, {"path": "/@CP_komac/works/5", "thumbnail_src": "https://si.imgix.net/524845f3/requests/142536_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=947390ccbb643662ede1001ed4e722c8", "thumbnail_srcset": "https://si.imgix.net/524845f3/requests/142536_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=947390ccbb643662ede1001ed4e722c8, https://si.imgix.net/524845f3/requests/142536_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59cb5f69c99d78e9e4474f4919e13f1b 2x, https://si.imgix.net/524845f3/requests/142536_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc2cf357e258606aea87be615fb63165 3x", "genre": "art", "nsfw": false, "body": "紫ちゃま（藍ちゃま状態の紫）と通常サイズの藍・橙でお願いします。", "cre