いします\n\n資料まとめ\nhttps://drive.google.com/drive/folders/1YgSBJftwQTeqwdtcT3iD7XY9Kwp9rHsk?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kuromizuKey/works/6", "thumbnail_src": "https://si.imgix.net/4b5b2e45/uploads/origins/c7949a5a-37f8-4ea7-b1ca-e1117512bac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da94fb520af6f518080358e964ea69b3", "thumbnail_srcset": "https://si.imgix.net/4b5b2e45/uploads/origins/c7949a5a-37f8-4ea7-b1ca-e1117512bac3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da94fb520af6f518080358e964ea69b3, https://si.imgix.net/4b5b2e45/uploads/origins/c7949a5a-37f8-4ea7-b1ca-e1117512bac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=442fc409d1aab086321892328e047064 2x, https://si.imgix.net/4b5b2e45/uploads/origins/c7949a5a-37f8-4ea7-b1ca-e1117512bac3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7e266e101e4dabf884d84e6c9533a7d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromizuKey/works/5", "thumbnail_src": "https://si.imgix.net/5788a333/uploads/origins/daaa6703-7b58-4e7a-acbe-8420b6b2c59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8daf80c6bb7e07c6506429b552392bf1", "thumbnail_srcset": "https://si.imgix.net/5788a333/uploads/origins/daaa6703-7b58-4e7a-acbe-8420b6b2c59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=