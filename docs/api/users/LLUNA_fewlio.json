-4040-a6fb-26a9f19dcd76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05283ce146ce6191f1c4610fa4a8fe46", "thumbnail_srcset": "https://si.imgix.net/3a68eca2/uploads/origins/4d06c244-e14b-4040-a6fb-26a9f19dcd76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05283ce146ce6191f1c4610fa4a8fe46, https://si.imgix.net/3a68eca2/uploads/origins/4d06c244-e14b-4040-a6fb-26a9f19dcd76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bed9a0e78406b5737c5c1ca0b6d1e2f 2x, https://si.imgix.net/3a68eca2/uploads/origins/4d06c244-e14b-4040-a6fb-26a9f19dcd76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c59c28cf293b3ec1bf54f22d7f4b5d7 3x", "genre": "art", "nsfw": false, "body": "Hello, I love your art, and would love to get a piece from you! \n\nI would like to use this as a PNGtuber so that it can be used during stream.\n\nI would like 2 illustrations, one illustration with  eyes opened, mouth closed, and the 2nd illustration would be eyes closed, mouth opened. If you would like to do more I will leave those up to you!\n\nPlease note that her left eye is pink and her right is purple, and her 2 different hair tones. I included the hex colors for her hair in the tips note in the google drive.\n\nThank you, and I hope I get to see my persona in your style!\n\nhttps://drive.google.com/drive/folders/102XPdPE-3tRc0DO5BtX5_NBupepNK9mH?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@LLUNA_fewlio/works/16", "thumbnail_src": "https://si.imgix.net/b5fa10d4/uploads/origins/22ba9ed5-d0d9-4b98-9a08-7f2f2169cc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15788e1363c414ecb06566f41cbd0904", "thumbnail_srcset": "https://si.imgix.net/b5fa10d4/uploads/origins/22ba9ed5-d0d9-4b98-9a08-7f2f2169cc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15788e1363c414ecb06566f41cbd0904, https://si.imgix.net/b5fa10d4/uploads/origins/22ba9ed5-d0d9-4b98-9a08-7f2f2169cc04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fc418515ba588d398906e00ea0eb45c 2x, https://si.imgix.net/b5fa10d4/uploads/origins/22ba9ed5-d0d9-4b98-9a08-7f2f2169cc04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=214efacf46d19c2fba2e752bdb62a643 3x", "genre": "art", "nsfw": false, "body": "Hello, it is nice to meet you.   I love your stickers!\n\nMay I request for you to draw my VTuber and a little sphere frog in the stickers?  The pose and expressions are completely up to you!\n\nMy VTuber has a bold and expressive nerdy personality, similar to \"Futaba\" from Persona 5!  Can you please include my VTuber's glasses with every sticker?  A reference with the glasses on is linked down below.\n\nThe circle frog can have any personality you would like!  Dress him up if you would like to as well.\n\nI would like to request this for use on Twitch, Discord, and Youtube.  \nI would also like to request a transparent background.\n\nPlease use either the side ponytail or long hairstyles!  Up to you!\n\nReferences-\nGlasses: https://twitter.com/Huntress_VT/status/1625074219267547136/photo/1\nFrog: https://twitter.com/Huntress_VT/status/1636869517224685569/photo/1\nFull body reference (Long Hair): https://imgur.com/SMsLDTe\nAlternate hairstyle (Side Ponytail): https://imgur.com/pNN3gWV\n\nhttps://imgur.com/SMsLDTe", "created_at": "", "completed_at": ""}, {"path": "/@LLUNA_fewlio/works/15", "thumbnail_src": "https://si.imgix.net/46ffdfdd/uploads/origins/803805b2-9c82-49ee-9941-bcedff07bf30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b13e7e31ab57dad3075deb905cc7c472", "thumbnail_srcset": "https://si.imgix.net/46ffdfdd/uploads/origins/803805b2-9c82-49ee-9941-bcedff07bf30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b13e7e31ab57dad3075deb905cc7c472, https://si.imgix.net/46ffdfdd/uploads/origins/803805b2-9c82-49ee-9941-bcedff07bf30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d14d118ced73219d3a5b210b742896e 2x, https://si.imgix.net/46ffdfdd/uploads/origins/803805b2-9c82-49ee-9941-bcedff07bf30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89c206a9895454789786bf7e642b0bdb 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n私のDiscordコミュニティがあなたのステッカーをとても気に入ったので、私のVTuber、Mayoのためにまた描いてもらえないかお願いしたいのです。\n\n彼女は遊び好きで不器用な図書館猫です。\n最初の表情は、困惑しているような感じにしてほしいです。\n2つ目の表情は、肩をすくめているような感じ（例：「何が起きているのかわからないけど、まあいいか」）。\n残りの2つの表現はお任せします。\n\nPSDファイルで背景を透過して作っていただけると助かります。\n私のDiscordサーバーで使用する予定です。\n\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/17dEuLmd7QJRBbBCEO8tDa6aFkfVz2j5R?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@LLUNA_fewlio/works/14", "thumbnail_src": "https://si.imgix.net/59fed3e4/uploads/origins/79f8470d-4f4e-4bea-80cf-d42c29e0ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6361ff90447a9309072efd7ec2bd20a3", "thumbnail_srcset": "https://si.imgix.net/59fed3e4/uploads/origins/79f8470d-4f4e-4bea-80cf-d42c29e0ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6361ff90447a9309072efd7ec2bd20a3, https://si.imgix.net/59fed3e4/uploads/origins/79f8470d-4f4e-4bea-80cf-d42c29e0ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbdc26f0b0c17005d4ceda8a154390d3 2x, https://si.imgix.net/59fed3e4/uploads/origins/79f8470d-4f4e-4bea-80cf-d42c29e0ef7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee8ef4e1c6f54e68555dc5a41a766fe1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの芸術が大好きです私のVtuberのキャラのチビを4人分お願いできますか？\n\n私は教育コンテンツを作る予定なので、できれば学校をテーマにしたチビをお願いできますか？私が先生役、勉強している生徒役などが考えられます。表情やポーズはお任せします!\n\n背景は透明/レイヤー分けをお願いします！ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1g_ELRPpCeKf8DeRala4Fu9QsFzaPnIra?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@LLUNA_fewlio/w