1d32009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=582a4bf3df5901ab64bfbf37cab0ecc2, https://si.imgix.net/8e28ed85/uploads/origins/9be16fde-58c7-4415-8936-4589e1d32009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02bbf146821c83bb1a4391a87e49667d 2x, https://si.imgix.net/8e28ed85/uploads/origins/9be16fde-58c7-4415-8936-4589e1d32009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a39ecdfb005da360c0007d1f588855b 3x", "genre": "art", "nsfw": true, "body": "① ナンジャモ(ポケモンSV) ②黄色のニーハイブーツとロンググローブつきのハイレグ姿 ③笑顔 ④陰毛無し", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/50", "thumbnail_src": "https://si.imgix.net/cbe72385/uploads/origins/5ddcbaf0-1083-4dbd-96f6-5da4c9a4d5bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d618a59b8b3c503ee6c055f9ce179872", "thumbnail_srcset": "https://si.imgix.net/cbe72385/uploads/origins/5ddcbaf0-1083-4dbd-96f6-5da4c9a4d5bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d618a59b8b3c503ee6c055f9ce179872, https://si.imgix.net/cbe72385/uploads/origins/5ddcbaf0-1083-4dbd-96f6-5da4c9a4d5bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3844ce96ba12e70c930cc5f40f5e7e52 2x, https://si.imgix.net/cbe72385/uploads/origins/5ddcbaf0-1083-4dbd-96f6-5da4c9a4d5bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=768c992914c4ed99a3050b9b12a5e536 3x", "genre": "comic", "nsfw": true, "body": "初リクエストです!!いつも作品を見させてもらってます。\n魔法つかいプリキュアの朝日奈みらいが十六夜リコを光線銃で堕とすところを描いて欲しいです!!\n2人とも見た目は大人の姿でみらいは、はち切れそうな爆乳とデカ尻でムッチムチにして白いハイグレでおまるに跨らせてほしいです。\nリコが堕ちたあとはおまるから降りて2人で仲良くハイグレさせて欲しいです!!\n要望が多いかもしれませんがぜひよろしくお願いします!!", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/49", "thumbnail_src": "https://si.imgix.net/51d09f32/uploads/origins/f0d2b045-44c9-4a42-b34e-66a72dfff69d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6e064f18ec3a0899179f8ce5aab3889", "thumbnail_srcset": "https://si.imgix.net/51d09f32/uploads/origins/f0d2b045-44c9-4a42-b34e-66a72dfff69d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6e064f18ec3a0899179f8ce5aab3889, https://si.imgix.net/51d09f32/uploads/origins/f0d2b045-44c9-4a42-b34e-66a72dfff69d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfe918019abc9807cca058c756ff02bf 2x, https://si.imgix.net/51d09f32/uploads/origins/f0d2b045-44c9-4a42-b34e-66a72dfff69d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc83a3581f626d0b5771a9fac0c85e89 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。 \n久しぶりの依頼なので性癖を爆発してます。\n\nキャラは\n杜野凛世と園田智代子でお願いします\n\nシチュとして\nパンスト兵がそれぞれのアイドルの横か後ろにいる状態での作品をお願いします。\n\nアイドルの表情としてはスパイを暴露した、既にパンスト兵に洗脳されていたという感じでお願いします。\n\nパンスト兵は凛世とチョコ先輩それぞれ個別にいるという設定でお願いします。\n\nその際パンスト兵はアイドルの肩や腰に手を添えているなどで所有している感を表現しているようにして欲しいです。\n※2人ともではなくどっちか片方だけでも大丈夫です。\n\n要素として\n2人とも陰毛は濃いめでお願いします。\nニーソ手袋はありでお願いします。\nチョコ先輩のおっぱいは大きくお願いします。\n\n今回は台詞の置く位置が難しそうなため有無は問わないです。", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/48", "thumbnail_src": "https://si.imgix.net/882a6ca6/uploads/origins/38c5c61a-0320-45ce-bcd0-052c253d6049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2feec50e9f80138ce88f9414844183e", "thumbnail_srcset": "https://si.imgix.net/882a6ca6/uploads/origins/38c5c61a-0320-45ce-bcd0-052c253d6049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2feec50e9f80138ce88f9414844183e, https://si.imgix.net/882a6ca6/uploads/origins/38c5c61a-0320-45ce-bcd0-052c253d6049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bba3b7e5eb4ba4e0c8e042fc4e477e6 2x, https://si.imgix.net/882a6ca6/uploads/origins/38c5c61a-0320-45ce-bcd0-052c253d6049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b63a3e160ac58d7e33c516bdd1385bea 3x", "genre": "art", "nsfw": true, "body": "学マスのダンストレーナーとシャニマスの有栖川夏葉でハイグレイラストをお願いします。\n生徒たちの前でハイグレポーズの見本を見せているシチュエーションでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/47", "thumbnail_src": "https://si.imgix.net/a1bccde4/uploads/origins/94b79f9d-3862-4155-a781-21d7da059017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28bce8869b63cf47e986633338305b2d", "thumbnail_srcset": "https://si.imgix.net/a1bccde4/uploads/origins/94b79f9d-3862-4155-a781-21d7da059017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28bce8869b63cf47e986633338305b2d, https://si.imgix.net/a1bccde4/uploads/origins/94b79f9d-3862-4155-a781-21d7da059017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca4ec8c96b00056e89cbcce1f3a5cc18 2x, https://si.imgix.net/a1bccde4/uploads/origins/94b79f9d-3862-4155-a781-21d7da059017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7eaf6dd4c7c947efd83791b513594dee 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/46", "thumbnail_src": "https://si.imgix.net/e00b6311/uploads/origins/bf8ac125-462d-4854-ba1f-dc24e2fab55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32ebeb6386fc66a2b9cb9f06d562eaf9", "thumbnail_srcset": "https://si.imgix.net/e00b6311/uploads/origins/bf8ac125-462d-4854-ba1f-dc24e2fab55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32ebeb6386fc66a2b9cb9f06d562eaf9, https://si.imgix.net/e00b6311/uploads/origins/bf8ac125-462d-4854-ba1f-dc24e2fab55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1771847f7f59a9d61772843a3e2a8fa 2x, https://si.imgix.net/e00b6311/uploads/origins/bf8ac125-462d-4854-ba1f-dc24e2fab55f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fbab5a79dc42bd6cd0ae32d0bf4631c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/45", "thumbnail_src": "https://si.imgix.net/2cbee663/uploads/origins/92c28d90-5924-4114-bb32-3a3227ce8406?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75aa75eea5fbd36c943a9aafbf4b967", "thumbnail_srcset": "https://si.imgix.net/2cbee663/uploads/origins/92c28d90-5924-4114-bb32-3a3227ce8406?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75aa75eea5fbd36c943a9aafbf4b967, https://si.imgix.net/2cbee663/uploads/origins/92c28d90-5924-4114-bb32-3a3227ce8406?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ba3106208e8d4e71580180aeea89732 2x, https://si.imgix.net/2cbee663/uploads/origins/92c28d90-5924-4114-bb32-3a3227ce8406?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16f54684cc3d86cc94c9517b4dbf46f2 3x", "genre": "comic", "nsfw": true, "body": "お疲れ様です\n以前リクエストさせていただいた母＋未央ハイグレの続きを依頼させていただきます\n未央の持っている水着企画書を３人でハイグレ企画にする話し合い的なシーンをお願いします\n島村ママが未央に密着するように座って耳元でアイディアを囁き、渋谷ママがハイグレをして未央を応援する\n未央はそんな背徳的な状況でアイディアを絞り出そうとする内容でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/44", "thumbnail_src": "https://si.imgix.net/5a5cee13/uploads/origins/62b03834-cb21-4836-90a3-413bf3880eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=387e69be5dc8d7f6b3d501e856867bb5", "thumbnail_srcset": "https://si.imgix.net/5a5cee13/uploads/origins/62b03834-cb21-4836-90a3-413bf3880eba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=387e69be5dc8d7f6b3d501e856867bb5, https://si.imgix.net/5a5cee13/uploads/origins/62b03834-cb21-4836-90a3-413bf3880eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c8ec95420e6e8983a0a3f78d7934cbd 2x, https://si.imgix.net/5a5cee13/uploads/origins/62b03834-cb21-4836-90a3-413bf3880eba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=535a70bd0b7d4594f41d661f4d3ed7fb 3x", "genre": "art", "nsfw": true, "body": "シャニマスのイルミネの3人(櫻木 真乃,風野 灯織,八宮 めぐる)でハイグレイラストをお願いします。\n敬礼して並んでいるシチュエーションでお願いします。\n・表情は笑顔\n・ハイレグの色は真乃がピンク、灯織が水色、めぐるが黄色\n・長手袋とロングニーハイソックス\n・左から灯織→真乃→めぐるの並び順\n\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/43", "thumbnail_src": "https://si.imgix.net/6186ce81/uploads/origins/3bc126ca-c37b-4a70-8a94-87b072719a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95144c14457be863c6add9d7b5fa6b6a", "thumbnail_srcset": "https://si.imgix.net/6186ce81/uploads/origins/3bc126ca-c37b-4a70-8a94-87b072719a80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95144c14457be863c6add9d7b5fa6b6a, https://si.imgix.net/6186ce81/uploads/origins/3bc126ca-c37b-4a70-8a94-87b072719a80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21195aff2d9ccbbaf354501f2bfbe64b 2x, https://si.imgix.net/6186ce81/uploads/origins/3bc126ca-c37b-4a70-8a94-87b072719a80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87d152c482fec40172cfee7c1c22a626 3x", "genre": "comic", "nsfw": true, "body": "初めてのリクエストになります。\nハイグレ洗脳公開ショーをモノクロームリリィ（速水奏・北条加蓮）の2人でお願いします。\n\n構図は以前のミステリアスアイズ（https://www.pixiv.net/artworks/103146061）を参考に、\n上部のコマについては、\n司会者は高垣楓にしていただき、\nセリフは以前と同様な感じで少しアレンジしていただければと思います。\n\n下部のコマについては、\n加蓮の髪型は髪を解いて下ろした状態、\nハイレグの色はそれぞれのイメージカラーに近い色（奏は#033087、加蓮は#2ad2c9）、\n2人の表情は悔しさと恥ずかしさが入り混じった表情で、\n「ハイグレ」と口走りながら、下記のようなセリフを入れていただければと思います。\n奏「何よこれ…ハイグレ…ダメ…か、体が勝手に…ハイグレ…」\n加蓮「何でこんな格好で…ハイグレ…こんなポーズしなきゃいけないのよ…！」\n\nモブのセリフとして下記のような感じで入れていただければと思います。\n「あのクールな奏さんがあんなガニ股で恥ずかしい姿を…」\n「奏ってやっぱりおっぱい大きいよね。いつも清ました顔しておいてw」\n「いつもは強気で生意気な加蓮のあんな無様な姿を見られるなんてw」\n「ほら、加蓮ちゃんもっと腰動かして！」\n\n可能であれば、2人のハイレグ衣装の色がピンクのバージョンと\nセリフなしのバージョンも用意していただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/42", "thumbnail_src": "https://si.imgix.net/127b5919/uploads/origins/f7898ca2-38f2-4b78-8123-f0e4cb2f98e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f086b105a8ee6b87ecbb45e0603b74", "thumbnail_srcset": "https://si.imgix.net/127b5919/uploads/origins/f7898ca2-38f2-4b78-8123-f0e4cb2f98e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2f086b105a8ee6b87ecbb45e0603b74, https://si.imgix.net/127b5919/uploads/origins/f7898ca2-38f2-4b78-8123-f0e4cb2f98e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=441c7ae58ec4ed9ed60ab38163eb0bd8 2x, https://si.imgix.net/127b5919/uploads/origins/f7898ca2-38f2-4b78-8123-f0e4cb2f98e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2723c84b060377f55d5e6177abb8aa49 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。 \n久しぶりにデレマスの各属性御三家選択の続編、第四弾を今回は依頼させていただきます。  \n\nキャラは 三村かな子、新田美波、大槻唯をお願いします。  \n要素としてかな子は陰毛を濃くお願いします 残りの2人の陰毛の濃さはお任せします。  \nニーソ手袋をお願いします。 \n \n1枚目は 3人がハイグレポーズを取っている様子をお願いします。  \n2〜4枚目は 各キャラの解説をお願いします。  可能要素として 1弾〜3弾の時のように各キャラの台詞をつけていただきたいです。\n\nHになるのでしたら改変は大丈夫です。\n以上です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/41", "thumbnail_src": "https://si.imgix.net/51f3f146/uploads/origins/72a15c4c-8369-4e10-a945-8210b1fd65fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1431461867587605b6c7b7e4b62143d6", "thumbnail_srcset": "https://si.imgix.net/51f3f146/uploads/origins/72a15c4c-8369-4e10-a945-8210b1fd65fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1431461867587605b6c7b7e4b62143d6, https://si.imgix.net/51f3f146/uploads/origins/72a15c4c-8369-4e10-a945-8210b1fd65fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b7aa212add97892c4c0f80e98236eb8 2x, https://si.imgix.net/51f3f146/uploads/origins/72a15c4c-8369-4e10-a945-8210b1fd65fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=410da9e3d1a7209a008e6b1738f8c5e4 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させていただきます。\n\n千川ちひろさんのハイグレマグショット絵をお願いします。\n\nチョーカー、長手袋、ニーハイソックスを着せてください。また、乳首は立たせ陰毛は濃くし、両穴にバイブを挿入してハイレグで固定してほしいです。\n表情は恥ずかしそうだが気丈な感じでお願いします。\n構図は、足は開くだけでガニ股にはせず、片手は股間に添えハイグレポーズをし、もう片手にスリーサイズ(82/58/84)、身長体重(154cm、45kg)、年齢(25歳)の書かれたボードを持たせてください。\n\nまた、説明文も付けてほしいです。\n「アイドル達を逃がすために自ら囮になって捕まり過酷な尋問にも耐えたが、自分が人質になったせいでアイドルも捕まり心が折れ、今ではハイグレの虜」といった感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/40", "thumbnail_src": "https://si.imgix.net/78c67661/uploads/origins/e73cdfcd-ee05-4d69-b36c-d9fe07829ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0286f577d1e9bcd716736dfa63807da7", "thumbnail_srcset": "https://si.imgix.net/78c67661/uploads/origins/e73cdfcd-ee05-4d69-b36c-d9fe07829ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0286f577d1e9bcd716736dfa63807da7, https://si.imgix.net/78c67661/uploads/origins/e73cdfcd-ee05-4d69-b36c-d9fe07829ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=092cdfac0cea595dd7025068210f6ff8 2x, https://si.imgix.net/78c67661/uploads/origins/e73cdfcd-ee05-4d69-b36c-d9fe07829ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=912dfbb4a8686150332309221b499f4b 3x", "genre": "art", "nsfw": true, "body": "お忙しいところ失礼します。\n\n是非自分の好きなキャラでも見てみたいと思い、