ddefd6-8963-484d-8e5e-e68a66d1ab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=146e01f5417d37f3aad3ffcaa7a53741, https://si.imgix.net/bd93a8a7/uploads/origins/f8ddefd6-8963-484d-8e5e-e68a66d1ab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42fdba3dcc52e698190daeba65ef0327 2x, https://si.imgix.net/bd93a8a7/uploads/origins/f8ddefd6-8963-484d-8e5e-e68a66d1ab1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2631dc2015bcf20c4157e4a006b03c4f 3x", "genre": "art", "nsfw": true, "body": "いつもありがとうございます。\n今回は佐久間まゆをお願いします。\n\nシチュエーションとして\n\nまゆがハイグレ人間になった直後でパンスト兵に向けて嬉しそうにハイグレをしている内容でお願いします。\n\n過去の千枝ママ作品のような感じのイメージで依頼しました。\n\n\n要素として\nニーソと手袋をお願いします。\n陰毛はハートでお願いします。\nパンスト兵に対しては様付けをお願いします。\n\n可能ならハイグレ人間◯◯とカタカナ表記をお願いします。\n\nいつもありがとうございます。これからもよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/32", "thumbnail_src": "https://si.imgix.net/473a25a2/uploads/origins/2795e220-75fc-4568-9c80-f4b4f282f733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8290b297a86bb32f9e731e31346bd7f2", "thumbnail_srcset": "https://si.imgix.net/473a25a2/uploads/origins/2795e220-75fc-4568-9c80-f4b4f282f733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8290b297a86bb32f9e731e31346bd7f2, https://si.imgix.net/473a25a2/uploads/origins/2795e220-75fc-4568-9c80-f4b4f282f733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57f7f0aa5d269cfae0836dcbee2fb06a 2x, https://si.imgix.net/473a25a2/uploads/origins/2795e220-75fc-4568-9c80-f4b4f282f733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=355c1245e2a5036d9fa05974841fae56 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/31", "thumbnail_src": "https://si.imgix.net/e99c6c4f/uploads/origins/d36427d9-c53d-4de4-ad5d-9056ddf0c93e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e5a93cf7db4eba6eefa44bf908f0f8e", "thumbnail_srcset": "https://si.imgix.net/e99c6c4f/uploads/origins/d36427d9-c53d-4de4-ad5d-9056ddf0c93e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e5a93cf7db4eba6eefa44bf908f0f8e, https://si.imgix.net/e99c6c4f/uploads/origins/d36427d9-c53d-4de4-ad5d-9056ddf0c93e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=306ecf2a1fac7791d152f5d7c7a69a04 2x, https://si.imgix.net/e99c6c4f/uploads/origins/d36427d9-c53d-4de4-ad5d-9056ddf0c93e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd4d936530a007064514c4421ac5eacf 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です\n今回のリクエストは、デレステの島村ママと渋谷ママをお願いします\n２人で街中で洗脳されてハイグレしながら逃げ惑う未洗脳者に向かってハイグレ姿になるよう呼び掛ける様子をお願いします\n色は２人とも年甲斐のない派手な色にして、陰毛を生やしてくれると嬉しいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/30", "thumbnail_src": "https://si.imgix.net/403a7c37/uploads/origins/0e4722a5-7416-4735-8c1d-624888c4481a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46340e7a8c6771fcc5f3914b87b8be4a", "thumbnail_srcset": "https://si.imgix.net/403a7c37/uploads/origins/0e4722a5-7416-4735-8c1d-624888c4481a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46340e7a8c6771fcc5f3914b87b8be4a, https://si.imgix.net/403a7c37/uploads/origins/0e4722a5-7416-4735-8c1d-624888c4481a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=578bb61a36dedcfbb7793972186dbd49 2x, https://si.imgix.net/403a7c37/uploads/origins/0e4722a5-7416-4735-8c1d-624888c4481a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fd83883e0c0c696870e61543839bac0 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になってます。\n\n今回のキャラは月岡恋鐘をお願いします。\n\nシチュ内容は\n疲れてるPを癒してる恋鐘をお願いします。\nどんな風に恋鐘はPを癒しているのかは磯辺揚げさんにお任せします。\n\n枚数なのですが\n差分を含め4枚程度でお願いします。\n\n要素として\n\n恋鐘はハイグレ人間に100%洗脳されてる状態でお願いします。\n\nハイグレをしている恋鐘をお願いします。\n(あれば最高に喜びます)\n\nニーソ手袋をお願いします！\n\n陰毛は過去作品でありました唯ちゃんが擦り付けてたぐらいの濃さでお願いします。それよりも濃くなるのはOKです。\n\n\n今回シチュの理由としては個人的にだいぶ疲れが溜まりすぎているので少しでも私も元気になりたくこんなシチュを希望しました。これからもよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/29", "thumbnail_src": "https://si.imgix.net/d82bd69f/uploads/origins/e3fc66d9-6d23-41bf-901c-73d784ee09c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3aff27bfd4944209aa060505abe5fe3", "thumbnail_srcset": "https://si.imgix.net/d82bd69f/uploads/origins/e3fc66d9-6d23-41bf-901c-73d784ee09c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3aff27bfd4944209aa060505abe5fe3, https://si.imgix.net/d82bd69f/uploads/origins/e3fc66d9-6d23-41bf-901c-73d784ee09c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10dd06f02132589a594790a855630dbb 2x, https://si.imgix.net/d82bd69f/uploads/origins/e3fc66d9-6d23-41bf-901c-73d784ee09c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd8a67e64776c9eaac07a919cc62df9f 3x", "genre": "art", "nsfw": true, "body": "十時愛梨がショタハイグレ人間に公開ご褒美ハイグレフェラチオショーする絵をお願いします\n\nシチュとしては地球人側の最重要防衛拠点の１つを落とすことに成功\nその作戦成功の立役者に避難民として保護されるふりをして内部に潜入して\nハイグレ兵たちを拠点に入れるように手引きしたハイグレ人間（年齢：小学生）が\nMVPとして表彰台に立った\n（司会者はhttps://www.pixiv.net/artworks/105226375のミナミ\n　場所は煙上がる防衛拠点をバックに設けた会場？上記URL同様で良いです）\n皆に拍手される中、ゲストとしてそのハイグレショタの大好きなアイドルとときんが登場\n（恰好はhttps://www.pixiv.net/artworks/95595416）\nショタが喜ぶなか、愛梨が表彰台前（位置的にとときんの顔がショタの股間の位置にくる）に立つと愛梨がショタのハイレグ股間部分をずらしショタチンポを出す\nショタが驚く中、ミナミが「さあこれよりハイグレショタくんに魔王様からのご褒美♡ショタくんの大好きな愛梨ちゃんがショタくんの勇敢さを称えてフェラチオいたします♡皆さまもう一度盛大な拍手を♡」とナレーション\n表彰式でよく流れるBGMが流れて観客席の皆がまた拍手をする中、愛梨が\n「うふっ♡いつも応援ありがとう♡今から貴方が頑張った分、とときんハイグレフェラで\n　たくさん癒してあげる♡愛情込めていっぱい気持ちよくしてあげるね♡」と\nハイグレハイグレしながらまずはショタチンポの先っぽにとときんチンポキッス\nショタが快楽で身震いしてる中、愛梨はショタチンポを激しくハイグレ＆バキュームフェラ（乳首も勃つかも？\nたまらずショタは愛梨の口に射精する\nおめでとーと祝福される中でミナミが「またショタくんには副賞としてショタくんの優秀なハイグレ人間DNAを保存するべく愛梨ちゃんと生エッチしてもらいます♡」とナレーション\n愛梨は腰砕けになってるショタを表彰台から優しく手招き\n舞台裏に設けられたVIPルームへ入るのだった…\n\n以上です\nご検討お願いします", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/28", "thumbnail_src": "https://si.imgix.net/874d6515/uploads/origins/cc0f7f0b-ff18-4153-a985-b9be4ba14078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=679722c0d6e24055401217c48b2ef1c4", "thumbnail_srcset": "https://si.imgix.net/874d6515/uploads/origins/cc0f7f0b-ff18-4153-a985-b9be4ba14078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=679722c0d6e24055401217c48b2ef1c4, https://si.imgix.net/874d6515/uploads/origins/cc0f7f0b-ff18-4153-a985-b9be4ba14078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be384aeb9ba653d070f6e53b2b863674 2x, https://si.imgix.net/874d6515/uploads/origins/cc0f7f0b-ff18-4153-a985-b9be4ba14078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d61a705f8a99ca474d17718a9a2409a0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@haigure_suki/works/27", "thumbnail_src": "https://si.imgix.net/8de39555/uploads/origins/6d6a3b52-8cfb-4329-b156-e4c5a7b54703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0032b0dcee514b1979fe6a058257dda2", "thumbnail_srcset": "https