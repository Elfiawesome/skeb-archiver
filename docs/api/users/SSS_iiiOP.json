e%2Ccenter&txtsize=30&txt=PRIVATE&s=b13cd736b329af0a99f7b0eac651b6b3, https://si.imgix.net/2de96e65/uploads/origins/bd9f2747-584f-4068-82ef-baf442832d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0676552317e526d174fec85707361a46 2x, https://si.imgix.net/2de96e65/uploads/origins/bd9f2747-584f-4068-82ef-baf442832d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40d60f241f1875ed3cc4d27ccff18dd9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SSS_iiiOP/works/39", "thumbnail_src": "https://si.imgix.net/cf318db1/uploads/origins/f0b9896d-c55b-4aa6-8cc1-71819d04b8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53627045c07d7a34089cf4ab351580ce", "thumbnail_srcset": "https://si.imgix.net/cf318db1/uploads/origins/f0b9896d-c55b-4aa6-8cc1-71819d04b8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53627045c07d7a34089cf4ab351580ce, https://si.imgix.net/cf318db1/uploads/origins/f0b9896d-c55b-4aa6-8cc1-71819d04b8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b9d3ca350b1a0801b2ed0a47b305a47 2x, https://si.imgix.net/cf318db1/uploads/origins/f0b9896d-c55b-4aa6-8cc1-71819d04b8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b432cf972b3f5c488bd195851c9a7cc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵が大好きです！私のOCを好きなように描いて欲しいです。٩(＾◡＾)۶!\n\nでも、できれば16:9でお願いしたいです。\n\nキャラクターの背景情報です：\n\nノースノードは天空の雄羊のような存在だが、実際は動物園のようなもので、人間と創造そのものと結びついた生物のコロニーからできている。人間のノースはかつて科学者だったが、ノースノードの誕生につながる実験で死亡した。ノースノードは空間や物質そのものを操ることができる。ノースノードは世界を行き来する旅人であり、カミデレに似ているがデレデレである。ノースノードは利他主義者で、行く先々で人助けをするのが大好きだ。世界をありのままに体験できるよう、自分の力を秘密にしている。\n\n参考資料には数種類の服装オプションが掲載されているので、好きなものを選んでほしい。また、古い参考資料もあるが、デザインはパンツが変更されているほか、やや男らしくなっているので、これを参考にしないでほしい。\n\nhttps://drive.google.com/drive/u/1/folders/1WMpoySzwAFc_vqGUvUDNFqqCDRpFpFZq", "created_at": "", "completed_at": ""}, {"path": "/@SSS_iiiOP/works/38", "thumbnail_src": "https://si.imgix.net/a24845ed/uploads/origins/d0e77a6e-e7b7-4e55-8328-e33c7f0375f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb5c717847145bd811d320ff8453ab6d", "thumbnail_srcset": "https://si.imgix.net/a24845ed/uploads/origins/d0e77a6e-e7b7-4e55-8328-e33c7f0375f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb5c717847145bd811d320ff8453ab6d, https://si.imgix.net/a24845ed/uploads/origins/d0e77a6e-e7b7-4e55-8328-e33c7f0375f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=732064cba5bfd20e679b8e99efcf109c 2x, https://si.imgix.net/a24845ed/uploads/origins/d0e77a6e-e7b7-4e55-8328-e33c7f0375f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9842104c8be692f854d1272c89816d1b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。lafiと申します。\n塩だれ様の透明感のあるイラストが私のオリキャラの雰囲気にぴったりだと感じ、ぜひお願いしたいと思います。ポーズや構図はお任せいたします。\n\n世界観：淡い青緑色に輝く小さなウサギの姿をした彼女は、森の風や鳥たちが運んでくる人間の忘れ物や願いごとに宿る物語を聞くことができ、それを楽しむのが大好き。やがて人間の世界に興味を持ち、森の力で人間の少女の姿に変わり、自らその感情や物語を体験するための旅に出ました。\n\n性格：人間の世界をよく知らず、好奇心が旺盛。かわいくて元気だけど、騒がしい感じではない。\n\n衣装：その中からお好きな1着を選んで描いていただければ大丈夫です。\nおすすめの雰囲気としては、空気感＞森系となります。\n\n利用範囲：個人観賞用\n可能であれば、PSDデータで人物、背景、サインが分かれていると嬉しいです。\n※人物の頭や手などが切れない構図だとうれしいです。\n\nhttps://drive.google.com/drive/folders/1s10gsarTWoRCeX7V7mARCDO1u4Vsa5kG?usp=sharing\nキャラクターシートを参考にしてください。\n\nまた、塩だれ様のこれらの作品がとても素敵だと思います。このような雰囲気でお願いできれば幸いです。\nhttps://skeb.jp/@SSS_iiiOP/works/23\nhttps://skeb.jp/@SSS_iiiOP/works/26", "created_at": "", "completed_at": ""}, {"path": "/@SSS_iiiOP/works/37", "thumbnail_src": "https://si.imgix.net/da44a83f/uploads/origins/5973719b-733d-4d59-b288-5d4c6d25c983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e65b62572cd513dc5051dff65c4