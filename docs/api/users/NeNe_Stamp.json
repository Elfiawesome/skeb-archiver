619-4c19-8e41-f075136e1530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63e1b066c9e7627778494f8ea5c7f9f9", "thumbnail_srcset": "https://si.imgix.net/3f569ea6/uploads/origins/60fb4f4c-6619-4c19-8e41-f075136e1530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63e1b066c9e7627778494f8ea5c7f9f9, https://si.imgix.net/3f569ea6/uploads/origins/60fb4f4c-6619-4c19-8e41-f075136e1530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1cca562b43b4355bbc7f714967ccb0f 2x, https://si.imgix.net/3f569ea6/uploads/origins/60fb4f4c-6619-4c19-8e41-f075136e1530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e53c1e2b716f242b585cf50b4306c148 3x", "genre": "art", "nsfw": false, "body": "Twitterのヘッダーで使う依頼です\n３人同時に載っているイラストをお願いします。\nぶいすぽの胡桃のあちゃん、兎咲ミミちゃん、神成きゅぴちゃんをお願いします。\n衣装やポーズ等はおまかせします。\n並び順だけ左にミミちゃん、真ん中のあちゃん、右にきゅぴちゃんでお願いします。\nお時間は掛かっても問題ありませんのでよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@NeNe_Stamp/works/10", "thumbnail_src": "https://si.imgix.net/a97bae75/uploads/origins/3ee7387f-580c-4cfe-9696-18688efb6429?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57a3af7653b0ff304d804e94534caa4", "thumbnail_srcset": "https://si.imgix.net/a97bae75/uploads/origins/3ee7387f-580c-4cfe-9696-18688efb6429?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57a3af7653b0ff304d804e94534caa4, https://si.imgix.net/a97bae75/uploads/origins/3ee7387f-580c-4cfe-9696-18688efb6429?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b245b4ffec836039a7fa964e8682251 2x, https://si.imgix.net/a97bae75/uploads/origins/3ee7387f-580c-4cfe-9696-18688efb6429?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e88eed23da1dbc906383f8a7ff3f670 3x", "genre": "art", "nsfw": false, "body": "セナちゃん(新衣装)お願いします！", "created_at": "", "completed_at": ""}]}