e91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b1ef43298afd721ee5e79cb00a8f8ad 2x, https://si.imgix.net/55891647/uploads/origins/e2d170a5-e21c-457f-96a6-3c9605bf2e91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29b540f51e61e802a705541285f4bc05 3x", "genre": "art", "nsfw": false, "body": "こんにちは!!!またまた作品の依頼に来ました!アレンというキャラクターです\n\nhttps://toyhou.se/18410860.-\n\n彼は限界空間のキャラクターで、とても生意気な奴です。ってな感じです。とてものんびりしていて、淡々としています!構図などは自由自在です!ただ、限界空間の雰囲気に合っていればOKです!", "created_at": "", "completed_at": ""}, {"path": "/@_knbn_0728/works/57", "thumbnail_src": "https://si.imgix.net/fc2ee4f4/uploads/origins/d5f64642-9cc3-4ca7-9f9d-dfbde2e0328c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2447f529493804b8cbeff4668b8c4a68", "thumbnail_srcset": "https://si.imgix.net/fc2ee4f4/uploads/origins/d5f64642-9cc3-4ca7-9f9d-dfbde2e0328c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2447f529493804b8cbeff4668b8c4a68, https://si.imgix.net/fc2ee4f4/uploads/origins/d5f64642-9cc3-4ca7-9f9d-dfbde2e0328c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=106f015695727a53ec3898d3ad68c499 2x, https://si.imgix.net/fc2ee4f4/uploads/origins/d5f64642-9cc3-4ca7-9f9d-dfbde2e0328c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8400ff8706c435377b34a8f0468dbef3 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたのスタイルが本当に好きです!私と友達のキャラクターを描いていただけるとありがたいです。\n\n[1】SHAUN｜198cm｜一見すると威圧的で攻撃的な男。無鉄砲で、よく後先考えずに危険なところに突っ込んでいく。しかし、信頼できる相手には優しい一面も見せる。\n\n[2】マーリック｜183cm｜真面目で責任感が強く、その物言いで周囲を威圧することが多い。人をなかなか信用せず、普段は仲間に理屈をこねることが多い。\n\n▶ご注意ください\n- ショーンの傷跡とタトゥー（簡略化はご自由にどうぞ）\n- マフリックの肌の色\n\nロマンチックなカップルです。当初はライバル関係で、よく喧嘩をしていた。長い時間をかけて、ようやく心を通わせることができた。ショーンはマフリックに初めて告白した。今でも時々喧嘩をするけれど、お互いをとても信頼している。ショーンはマフリックの短気な面を引き出すこともある。マフリックはそんなショーンの短気を抑えてくれる。彼らは互いにバランスをとっている。\n\n自由に描いていただいて構いませんし、お好みで街着系など新しい服装を与えていただいても結構です。\n\nご検討のほど、よろしくお願いいたします。依頼内容に問題があれば、遠慮なくお断りください。\n\nhttps://sta.sh/22eihgxh2ufy", "created_at": "", "completed_at": ""}, {"path": "/@_knbn_0728/works/56", "thumbnail_src": "https://si.imgix.net/71025922/uploads/origins/90c41cf5-c45c-455e-a96d-dfeeaa063f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c7048a79a1fa9fb2e69cc905daee5e", "thumbnail_srcset": "https://si.imgix.net/71025922/uploads/origins/90c41cf5-c45c-455e-a96d-dfeeaa063f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c7048a79a1fa9fb2e69cc905daee5e, https://si.imgix.net/71025922/uploads/origins/90c41cf5-c45c-455e-a96d-dfeeaa063f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d32045d85cff2dda6a305f641d5d714 2x, https://si.imgix.net/71025922/uploads/origins/90c41cf5-c45c-455e-a96d-dfeeaa063f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=891dfbe1db7a1f85ef59bef0fe049032 3x", "genre": "art", "nsfw": false, "body": "こんにちは！貴方のイラストがとても好きで、依頼したいと思っていたんです！\n初めて仕事を依頼するから、失礼がありましたら、大変申し訳ございません！\n\nこれは私のキャラクター設定です！\n\nhttps://twitter.com/xiongxiongchon1/status/1601178000485412865\n\nキャラクターの注意点:\n①魚の鰭みたいの耳\n②魚の尾\n③顔で魚の鱗がある\n④両目の色が違います\n\nできれば血が混じっていて、悪役的の雰囲気を見てみたいです！それ以外はご自由に描いてください。\nポーズや構図はお任せします！\n\nありがとうございます！\n\nhttps://twitter.com/xiongxiongchon1/status/1601178000485412865", "created_at": "", "completed_at": ""}, {"path": "/@_knbn_0728/works/55", "thumbnail_src": "https://si.imgix.net/4e83bca5/uploads/origins/1ecb9c71-ebb5-4a04-8b32-4f83b99d5038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d577999714f201cbb331098006a4565", "thumbnail_srcset": "https://si.imgix.net/4e83bca5/uploads/origins/1ecb9c71-ebb5-4a04-8b32-4f83b99d5038?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d577999714f201cbb331098006a4565, https://si.imgix.net/4e83bca5/uploads/origins/1ecb9c71-ebb5-4a04-8b32-4f83b99d5038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fae69014e7550f85a378e5b1c558086 2x, https://si.imgix.net/4e83bca5/uploads/origins/1ecb9c71-ebb5-4a04-8b32-4f83b99d5038?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f681453d9501ba4620b222ab469440ea 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私はあなたのアートスタイルがとても好きで、私のFFXIVキャラクターBarakyndの画像を依頼したいのです。彼は占星術が好きなローガディンの中年男性で、父親的存在です。彼は思いやりがあり、社交的で、他の人をハグするのが好きです。\n\n以下は彼の参考資料と他のスクリーンショットです： https://drive.google.com/drive/folders/1y3BxbrAO68ErTKIwii-S8M9sNEwu6FdB?usp=sharing\n\nポーズや構図はあなた次第ですが、カジュアルかウィンターカジュアルで描いて欲しいです。また、ポーズや設定のインスピレーションが欲しい場合は、スクリーンショットを見ることができます。また、この画像（https://skeb.jp/@_knbn_0728/works/41）の描き方がとても好きなので、これに似たものもカッコイイと思います！（笑）。\n\nご検討のほど、よろしくお願いします!  ( ⸝⸝´꒳`⸝⸝)", "created_at": "", "completed_at": ""}, {"path": "/@_knbn_0728/works/54", "thumbnail_src": "https://si.imgix.net/3b436ac1/uploads/origins/881a27f1-f1bd-43ea-8038-5363be02fe48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf3c03737091e9fb17e0fe7ced68e434", "thumbnail_srcset": "https://si.imgix.net/3b436ac1/uploads/origins/881a27f1-f1bd-43ea-8038-5363be02fe48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf3c03737091e9fb17e0fe7ced68e434, https://si.imgix.net/3b436ac1/uploads/origins/881a27f1-f1bd-43ea-8038-5363be02fe48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9b4396cec6bcd8c35e1544e0a05259 2x, https://si.imgix.net/3b436ac1/uploads/origins/881a27f1-f1bd-43ea-8038-5363be02fe48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34dee4451e61ea93668713dd762c0a8d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はFFXIVのキャラクターのアートワークを取得したいです。笑顔ではなく、退屈そうな表情で描いてください。ブラシは必要ありませんが、入れても構いません。隠れ巨乳です。\n\nご検討よろしくお願いします。\n\nhttps://imgur.com/a/LtYP1vr", "created_at": "", "completed_at": ""}, {"path": "/@_knbn_0728/works/53", "thumbnail_src": "https://si.imgix.net/c999b52e/uploads/origins/b92fb07a-01d8-4afd-8389-48aaf7819b36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c8d97d60d0d0b71cec36a690c80859", "thumbnail_srcset": "https://si.imgix.net/c999b52e/uploads/origins/b92fb07a-01d8-4afd-8389-48aaf7819b36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c8d97d60d0d0b71cec36a690c80859, https://si.imgix.net/c999b52e/uploads/origins/b92fb07a-01d8-4afd-8389-48aaf7819b36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b412e562a727b65ce4eacddcae96045 2x, https://si.imgix.net/c999b52e/uploads/origins/b92fb07a-01d8-4afd-8389-48aaf7819b36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b045bf73713d6d7c7ef2412cc8196cf 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵はとても美しく、表現力が豊かです私のキャラクターを描いてもらえたら嬉しいです。\n\n彼はとても静かで、地味で、内向的です。夢を通して数々の前世のビジョンを見ており、その結果、とてもメランコリックで内省的な性格になっています。彼は生涯を一人で過ごしてきたため、人と話したり、何らかの形で交流したりすることが苦手です。口数の少ない男である。感情をあまり表に出さず、普段は真顔か物思いにふけった表情をしている。唯一笑うのは、一人でいるときにペットの鳥と一緒にいるときだけ。しかし、心優しく、穏やかで、物わかりが良い。\n\n参考文献 ▷https://drive.google.com/drive/folders/1zQ3rowumTCPY8G83PWdCyjU51HfOXPih?usp=share_link\n\nポーズや構図はあなた次第！？\nこんな写真が欲しい！ https://skeb.jp/@_knbn_0728/works/44\n\n読んでいただき、私のリクエストを検討していただきありがとうございます", "created_at": "", "completed_at": ""}, {"path": "/@_knbn_0728/works/52", "thumbnail_src": "https://si.imgix.net/7fdb35bf/uploads/origins/ba06628b-132a-48c8-ab9f-acbed99536ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da2471e60ad2570b8e8a79dc72928f90", "thumbnail_srcset": "https://si.imgix.net/7fdb35bf/uploads/origins/ba06628b-132a-48c8-ab9f-acbed99536ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da2471e60ad2570b8e8a79dc72928f90, https://si.imgix.net/7fdb35bf/uploads/origins/ba06628b-132a-48c8-ab9f-acbed99536ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a1c9be3211672753b6842934d98d1f1 2x, https://si.imgix.net/7fdb35bf/uploads/origins/ba06628b-132a-48c8-ab9f-acbed99536ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88acf02a5cd0eb2cfafb32b62802b3d8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。あなたの画風と色彩がとても好きです私のオリジナルキャラクターのイラストをお願いしたいです。金額が足りなかったり、違和感がある場合は遠慮なくキャンセルしてください。\nブルボン：白髪のキャラクターはヴァンパイアの少女（12~15歳くらいに見える）で、機械工です。身長155cm、赤い目、薄い肌色、かわいい牙、右足は義足です。おてんば娘と小悪魔をミックスしたような性格で、馬とお菓子とおもちゃと武器と機械が大好き。そして、射撃が得意。\nアンゴスチュラ：黒髪のストレートヘアで、成人男性（35〜45歳くらい）。身長195cm、黒い瞳、アイボリーの肌色、シワがある。見た目は気さくで温厚そうだが、威圧的で道徳心が全くない。\nビジネスパートナーであり、幽霊や超自然的な存在に対処するエクソシストでもある。お互いに嫌っているようだが、危険が迫るといつも協力し合っている。  また、実は実の親子なのですが、本人はそのことを知りません。\n特に好きなシーンは、男がタバコに火をつけようとしたら、少女がロリポップを口にくわえてタバコを吸わないようにするところです。その他のやりとりも大歓迎です\n具体的な内容はありません。詳細はお任せしますので、このコンセプトで思い切りやってください。色、服装、構図、装飾など、自由に選んでください。ご検討のほど、よろしくお願いいたします。\n参考までに、キャラクターの画像はこちらです。\nhttps://drive.google.com/drive/folders/1U7uD9l4i3K2XXExYsZpChwFGQBo9tFei?usp=share_link", "created_at": "", "completed_at": ""}]}