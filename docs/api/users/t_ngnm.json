f-9869-3f60e95dab5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d2a41f5cfc1525244f89c74fb933750", "thumbnail_srcset": "https://si.imgix.net/fe887a19/uploads/origins/005a2b52-38d1-425f-9869-3f60e95dab5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d2a41f5cfc1525244f89c74fb933750, https://si.imgix.net/fe887a19/uploads/origins/005a2b52-38d1-425f-9869-3f60e95dab5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e6464510ae1a9e30ef58acd96351044 2x, https://si.imgix.net/fe887a19/uploads/origins/005a2b52-38d1-425f-9869-3f60e95dab5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35ef92eb69ef38ca91f5f9496f2fbd47 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nあなたの作品はとてもかわいいですね。ブリーフをはいたドーナツくんを描いてください。前足を出して！膨らみが大事です。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1NdwHVCfKUC6AnZfWNbXLDeRJVmsLWBy3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@t_ngnm/works/9", "thumbnail_src": "https://si.imgix.net/e9ca1dbe/uploads/origins/232c7915-5575-4c8b-9cb1-7e7d7a195353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aeae60ebe348ab08bee3b727607523d", "thumbnail_srcset": "https://si.imgix.net/e9ca1dbe/uploads/origins/232c7915-5575-4c8b-9cb1-7e7d7a195353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aeae60ebe348ab08bee3b727607523d, https://si.imgix.net/e9ca1dbe/uploads/origins/232c7915-5575-4c8b-9cb1-7e7d7a195353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86c333d317a923ac14e2042de2f0c3d0 2x, https://si.imgix.net/e9ca1dbe/uploads/origins/232c7915-5575-4c8b-9cb1-7e7d7a195353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1f937be242307da0aab92bf9c84957d 3x", "genre": "art", "nsfw": false, "body": "前回の絵は本当にありがとうございました！ もう一度お願いします！ 荒いシルムをした後、土俵に倒れた場面をお願いしたいです。 2人のキャラクターが互いに胸を突き合わせて「Senlock」が上から重なりながら「Rapi」が下に敷かれたまま2人でかろうじて息を