rigins/af2cc01a-e4f9-4387-bbfc-b5b5078f68c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26d08d01b53be563b96882ba7885c610 2x, https://si.imgix.net/a4366d3d/uploads/origins/af2cc01a-e4f9-4387-bbfc-b5b5078f68c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8301d3c54a87f1c7247854b2cbe72f42 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zattaaka770/works/8", "thumbnail_src": "https://si.imgix.net/7269c38f/uploads/origins/2120ea64-b0c1-44d8-a619-52fa6c4f6540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f069dea26f58efb5a77d881a189d7718", "thumbnail_srcset": "https://si.imgix.net/7269c38f/uploads/origins/2120ea64-b0c1-44d8-a619-52fa6c4f6540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f069dea26f58efb5a77d881a189d7718, https://si.imgix.net/7269c38f/uploads/origins/2120ea64-b0c1-44d8-a619-52fa6c4f6540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=534e9bbf6f576e945b7876ee48b0e75f 2x, https://si.imgix.net/7269c38f/uploads/origins/2120ea64-b0c1-44d8-a619-52fa6c4f6540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad19c5c018ee45e6a15bcdc3ff374b7b 3x", "genre": "comic", "nsfw": false, "body": "私のオリジナルキャラクター「ハゼル」と友達オリジナルキャラクター「ソング」をもう一度描いてください!今回は「ハゼル」が「ソング」を誘惑する様子を、ぜひ見たい形で見せてください!お好みのコーディネートにもぜひ描いてみてくださいね!\n\nhttps://imgur.com/Zuj4WHY\n\nhttps://www.dropbox.com/sh/k49y11h9q99asrg/AACioS2Vqk8gnN1hlxEGxZlVa?dl=0\n\nhttps://www.dropbox.com/sh/2rcuixhg9bw824b/AABi4DtkRK3EQDRWmzfeTDJja?dl=0\n\nhttps://www.dropbox.com/sh/z7uz7rkv7hsp1fs/AACxqIlesJvPyKxC3tsMHfRBa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@zattaaka770/works/7", "thumbnail_src": "https://si.imgix.net/126daf6d/uploads/origins/cc97e4c5-2ece-429b-867b-5e161c654143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4b94ecf0e32b3a438d4b1c91f43b5c", "thumbnail_srcset": "https://si.imgix.net/126daf6d/uploads/origins/cc97e4c5-2ece-429b-867b-5e161c654143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4b94ecf0e32b3a438d4b1c91f43b5c, https://si.imgix.net/126daf6d/uploads/origins/cc97e4c5-2ece-429b-867b-5e161c654143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcd0481642440a46f38034efcd3d84db 2x, https://si.imgix.net/126daf6d/uploads/origins/cc97e4c5-2ece-429b-867b-5e161c654143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3567c3f263062f0fe1adb8c68748af06 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nいつも陰ながらまるさんのイラストを拝見させていただいている者です。\nシュッとしたフェイスライン、彫刻や絵画を思わせる薄い中に芯のあるシルエット、何より、人を慈しむような弄ぶような魅惑的な表情の描き方が最高で、何度も絵を見返しては喜んでいます。\nいつもありがとうございます。\nまるさんに是非描いていただきたいキャラクターがおりまして、この度skebリクエストをさせていただきました。\n\n※事前に、キャラクターデザインをしている方から許可をいただいております。\n\n\nTRPGの「かいぶつたちとマホラカルト」というシナリオ出身の探索者（キャラクター）です。\nとある犯罪組織（サークルのようなものです）に創設時からいる素敵なお姉様です。\n他のメンバーがドタバタしているのをあらあらと眺めていたり、助言をくれたりします。\n髪は赤色のふわふわショートヘア。前髪は右目にかかるかかからないかくらいの長さで流してまいます。\n常にニコニコ微笑んでるか澄ました顔しているので、目は普段閉じています。開くと、右が真っ黒でハイライト無、左が金色でしいたけハイライトのオッドアイです。\n口元左側にほくろがあります。\n身長は168cm。+10cmのハイヒールを履いています。またとてもスタイルがいいです。\n服装は露出高め裾長めのドレスです。普段は隠れて見えませんが、太腿には蜘蛛のタトゥーが入ってます。\n耳はいかついピアスがバチバチに開いてます。舌ピも開けてます。\n\n\n服装、構図について、全てまるさんにお任せします。\n\n\n添付資料は私が以前描いた全身の立ち絵イラストです。参考になりましたら幸いです。\n\nhttps://x.com/tkg_str9/status/1878434943098839127?s=46&t=n5EEeMOinoGg0sgcEEl0Bw", "created_at": "", "completed_at": ""}, {"path": "/@zattaaka770/works/6", "thumbnail_src": "https://si.imgix.net/6f14be4b/uploads/origins/8e1e63aa-c2dc-4320-acaa-5aca504bb515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8aefa824b2d2a66128aae8b487dcd16a", "thumbnail_srcset": "https://si.imgix.net/6f14be4b/uploads/origins/8e1e63aa-c2dc-4320-acaa-5aca504bb515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8aefa824b2d2a66128aae8b487dcd16a, https://si.imgix.net/6f14be4b/uploads/origins/8e1e63aa-c2dc-4320-acaa-5aca504bb515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc17fa9fe2f637aaea3885fee5044dff 2x, https://si.imgix.net/6f14be4b/uploads/origins/8e1e63aa-c2dc-4320-acaa-5aca504bb515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc759ab42e2ab4496d397b14a39968cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@zattaaka770/works/5", "thumbnail_src": "https://si.imgix.net/01e02d47/uploads/origins/0681437a-252e-4b75-a43f-72a17dc5ff90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c49a90ca95fb169d323abae7c32ffe", "thumbnail_srcset": "https://si.imgix.net/01e02d47/uploads/origins/0681437a-252e-4b75-a43f-72a17dc5ff90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60c49a90ca95fb169d323abae7c32ffe, https://si.imgix.net/01e02d47/uploads/origins/0681437a-252e-4b75-a43f-72a17dc5ff90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dde00383d21db3697b60996972addc0f 2x, https://si.imgix.net/01e02d47/uploads/origins/0681437a-252e-4b75-a43f-72a17dc5ff90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ed54ad12418267f219343f22a3543c7 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！ Hahzel \"と \"Song \"のスキンシップを見せてください！ 「ソング」は「ハーゼル」の上に乗って、彼女の温かい体を感じるのが好きです。 「Hahzel \"は \"Song \"の顔を撫でたり、\"Song \"の