52f-8fca-a1320d5ee9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae25da37cb2e74d23e09e4f2e6d950de 3x", "genre": "art", "nsfw": false, "body": "こんにちは、カラス天狗のハーピー「あけみ」の写真をお願いしたいのです。温泉でくつろいでいるようなリラックスしたシーンがいいのですが。\n\nhttps://imgur.com/a/JFR4VA4", "created_at": "", "completed_at": ""}, {"path": "/@mimizuku_suana/works/9", "thumbnail_src": "https://si.imgix.net/c4dc838e/uploads/origins/71bb7d13-1437-41aa-a128-69ca1d6e984e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a32149d105c821aefe26db384dc52be", "thumbnail_srcset": "https://si.imgix.net/c4dc838e/uploads/origins/71bb7d13-1437-41aa-a128-69ca1d6e984e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a32149d105c821aefe26db384dc52be, https://si.imgix.net/c4dc838e/uploads/origins/71bb7d13-1437-41aa-a128-69ca1d6e984e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=684ab0f730fb68afd9ce825d7332221c 2x, https://si.imgix.net/c4dc838e/uploads/origins/71bb7d13-1437-41aa-a128-69ca1d6e984e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c9046f90ae27189c38abd8bcf6b8aaa 3x", "genre": "art", "nsfw": false, "body": "お世話になります！\nお時間ある時で良いのでリクエストさせてください！\n\n私が「pixivファンタジアMOH」で投稿していたキャラクターのアパリを描いていただきたいです！\n資料↓\nhttps://www.pixiv.net/artworks/88074459\nポージング等はお任せいたします！\n急ぎませんので無理のない時で大丈夫です。\nよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@mimizuku_suana/works/8", "thumbnail_src": "https://si.imgix.net/a5e4fa49/uploads/origins/97d85aba-d8e0-4ccb-8682-6c2eb307694e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13c0a0b11310c633e5e309e4766723d6", "thumbnail_srcset": "https://si.imgix.net/a5e4fa49/uploads/origins/97d85aba-d8e0-4ccb-8682-6c2eb307694e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13c0a0b11310c633e5e309e4766723d6, https://si.imgix.net/a5e4fa49/uploads/origins/97d85aba-d8e0-4ccb-8682-6c2eb307694e?bg=%23fff&auto=f