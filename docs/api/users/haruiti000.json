-4f34-a4d2-e5d8c20f7cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c950a23fe86e7d1a9aac941c3c6f63c, https://si.imgix.net/2803b7da/uploads/origins/09f3665f-50fc-4f34-a4d2-e5d8c20f7cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5e42f3b19b7bd35d25967cd657fb7bf 2x, https://si.imgix.net/2803b7da/uploads/origins/09f3665f-50fc-4f34-a4d2-e5d8c20f7cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7916d9f51b701739d41ab0965e9b151 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@haruiti000/works/46", "thumbnail_src": "https://si.imgix.net/5a2958cb/uploads/origins/488f3dd5-889d-4c45-a3b9-5ca7185371be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a1287b6cacb41c9c8e48313f18ed7e", "thumbnail_srcset": "https://si.imgix.net/5a2958cb/uploads/origins/488f3dd5-889d-4c45-a3b9-5ca7185371be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a1287b6cacb41c9c8e48313f18ed7e, https://si.imgix.net/5a2958cb/uploads/origins/488f3dd5-889d-4c45-a3b9-5ca7185371be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae6ae4e08bc3bcdba1d0c9edf56fb6f7 2x, https://si.imgix.net/5a2958cb/uploads/origins/488f3dd5-889d-4c45-a3b9-5ca7185371be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a324dfc7d40af0ece664f09bd0bdf02f 3x", "genre": "art", "nsfw": true, "body": "TLに流れてきたハーレムイラストがとてもよかったので依頼します\n十時愛梨・ナターリア・榊原里美・西園寺琴歌・及川雫のハーレムイラストをお願いします\n構図は資料を参考に、愛梨ナターリアに資料の愛梨同様おっぱいを揉むように左右の手を誘導され、里美琴歌雫にトリプルパイズリされているシチュを主観視点で\n全員全裸で、視線はこちら、表情は微笑みか蕩け顔\n背景は薄暗い和室に提灯照明が灯っている雰囲気で。セリフ擬音なし\n可能なら射精差分