c3e5/uploads/origins/9e26c35d-c048-4d20-890f-dd050e38091d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7651141004cfe04e248b40bb2bbb7c6 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_mizumikan/works/6", "thumbnail_src": "https://si.imgix.net/401001ee/uploads/origins/55b6651b-5a27-430f-82c8-bac17850a71d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e608084384a19f788ee0d1a8c70f8055", "thumbnail_srcset": "https://si.imgix.net/401001ee/uploads/origins/55b6651b-5a27-430f-82c8-bac17850a71d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e608084384a19f788ee0d1a8c70f8055, https://si.imgix.net/401001ee/uploads/origins/55b6651b-5a27-430f-82c8-bac17850a71d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3475f6582119276fe62e62ca944fb90f 2x, https://si.imgix.net/401001ee/uploads/origins/55b6651b-5a27-430f-82c8-bac17850a71d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ec81eb9451b44ec379d0949b2b53827 3x", "genre": "art", "nsfw": true, "body": "リクエストおねがいします。\n\n二人の女の子がお菓子を買ってに食べてしまったら太ってぽっちゃり体型になってしまった。\nモノクロ漫画形式でおねがいします。\n\nお菓子を食べる。\n太り始める\n服パツパツもしくは一部破けみたいなイメージ", "created_at": "", "completed_at": ""}, {"path": "/@_mizumikan/works/5", "thumbnail_src": "https://si.imgix.net/57be5fac/uploads/origins/5f987240-f14e-440d-9422-467a7728e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=472eddc1e669f0c84fc11aef0ade1c6b", "thumbnail_srcset": "https://si.imgix.net/57be5fac/uploads/origins/5f987240-f14e-440d-9422-467a7728e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=472eddc1e669f0c84fc11aef0ade1c6b, https://si.imgix.net/57be5fac/uploads/origins/5f987240-f14e-440d-9422-467a7728e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c6b8d69fd6f44f9ccb0aa4ba7b97c45 2x, https://si.imgix.net/57be5fac/uploads/origins/5f987240-f14e-440d-9422-467a7728e5cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b12fb14e7d06dd9512bdecc06b45561 3x", "genre": "art", "nsfw": true, "body": "こんにちは!\n\n【漫画】P√後、思春期フリ(ズには忘れられない人がいてそれが前時間軸のP√後フリ(恋人だった)っていうややこしいサンフリ※(ズのみ前周記憶あり)は水蜜柑さんの漫画が好きです! \n\nUnderfellの版をお願いしたい。\n\nサンスがフリスクの気持ちの回復を待つことができず、心を痛め、行動に出るというもの？フリスクは密かに感情を抱いているが、それを認める強さを見いだせていない。沈黙による合併症 🙏", "created_at": "", "completed_at": ""}, {"path": "/@_mizumikan/works/4", "thumbnail_src": "https://si.imgix.net/b8198c77/uploads/origins/e8bfa46d-a6a8-44eb-b5a4-5de0d1f41958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e7b4ed7c775c4527ff54e0dc4e72f4", "thumbnail_srcset": "https://si.imgix.net/b8198c77/uploads/origins/e8bfa46d-a6a8-44eb-b5a4-5de0d1f41958?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e7b4ed7c775c4527ff54e0dc4e72f4, https://si.imgix.net/b8198c77/uploads/origins/e8bfa46d-a6a8-44eb-b5a4-5de0d1f41958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a423b16f9c65bde2d2bbb9fd30694ef5 2x, https://si.imgix.net/b8198c77/uploads/origins/e8bfa46d-a6a8-44eb-b5a4-5de0d1f41958?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ab66b1d81846c0c0dec8251f680b980 3x", "genre": "art", "nsfw": false, "body": "水みかん様初めまして！\n水みかんさんの作品をお見かけして以来\nいつかリクエストさせていただきたいと思っておりました。(描かれるフリスクちゃんがとても可愛いです)\n\n\nもしよろしければご検討いただければとおもいます。\n\n　リクエストしますのはうちの子のモノクロ漫画作品です。\n\nお題がザッパになってしまいまいますが\nうちの子の資料をみてなにかインスピレーションが浮かんでいただければ、それを描いていただければと思います。\n\n服装や髪型、シチュ、なにからなにまでお任せします。\n\nうちの子(全部で二人と一匹です)\n\n柄葉五鈴(つかは いすず)ちゃん\n･･･うちの子の主軸の子\nとても元気で明るい子\n⚠️肌の色は資料内に褐色ぽいのもありますが通常の肌色で\n\n\nhttps://www.dropbox.com/sh/ry67ocwtc20fgy8/AACve8MF2Y9B5RILo_RFvaeKa?dl=0\n\n\n悪鈴ちゃん\n･･･ある作品から生まれた五鈴ちゃんの別個体\n性格は簡単に言えばツンデレ\n肌の色は資料通りで問題ありません。\n\nhttps://www.dropbox.com/sh/4oifk7qyv2ix3cx/AADyWShtMDVeBGPqPTQ9xTsra?dl=0\n\n\nたまり醤油\n謎の生命体　ペット\n↑資料上に入ってます。", "created_at": "", "completed_at": ""}, {"path": "/@_mizumikan/works/3", "thumbnail_src": "https://si.imgix.net/a7cf4396/uploads/origins/dc02c662-789e-4a1c-b78f-379e07a76bc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c9c7d05c4c4d0be217575270509c165", "thumbnail_srcset": "https://si.imgix.net/a7cf4396/uploads/origins/dc02c662-789e-4a1c-b78f-379e07a76bc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c9c7d05c4c4d0be217575270509c165, https://si.imgix.net/a7cf4396/uploads/origins/dc02c662-789e-4a1c-b78f-379e07a76bc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58f4211ed4bc5cf3c66ccf875abb5a37 2x, https://si.imgix.net/a7cf4396/uploads/origins/dc02c662-789e-4a1c-b78f-379e07a76bc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfef4d6136e73f8255fe659fbe9793a7 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n私はYouTubeで配信活動をしてます。\n個人VTuberのナタリシア・シックス申します。 \n普段プライベートでサンフリの漫画とても楽しく拝見しています！！\nスケブをやってるとの事でしたので、漫画の方をお願いします！\n\nご依頼内容⤵\n\n・個人鑑賞、知って頂くためのPR活動に使用\n\n※本は全て黒い表紙\n\n以下セリフ、展開などでお願いしたいもの\n\nかなり量のある原稿用紙を抱えた黒髪の女(参考資料:七瀬なな)の涙と原稿用紙から溢れ出たインクが白紙の原稿用紙の上に落ちる\n\n↓\n\n原稿用紙が涙とインクで滲む\n黒髪の女が消える\n複数の本がバラバラと周りに散らばる\n\n↓\n\n代わりにインクの生物(参考資料:3面図人外時)が白紙だった原稿用紙(涙とインクで滲んだもの)から生まれる\n\n↓\n\nインクの生物とても悲しそうに散らばった本たちと一緒に画面外(コマの外？)へ\n\n↓\n\n「大丈夫、僕たちが貴方〔作者〕のことを必ず…」 手袋をキュッとして歩き出す白髪の女(参考資料:おかしなうさぎ ナタリシア)\n表情としては苦しそうに、でも決意したような顔\n\n↓\n\n場面切り替わり(?)\n\n\n↓\n\nニマァっと笑った白髪の女がコマに大きく(?)\n片手を胸に起きながらのお辞儀などあると嬉しい\n「おやおや！？現世にお疲れのようですねぇ〜！ようこそ、閲覧者様々！！ここは辛い事も苦しいこともないのない幸福な世界！狂信ナイトメアの物語へようこそ！」\nと言う\n\n\nその他裏設定等を参考ファイルに入れてあるので\nこの設定ならこうかな？と言う解釈アレンジを入れて頂いても大丈夫です！\n\n衣装の方を資料内「おかしなうさぎ」の方でお願い致します！目はオッドアイの方でお願い致します！\n\nご縁がございましたら、ぜひ検討頂けると嬉しいです\n\nYouTubeリンク1分39秒あたりにも過去を少し描いていただいてるのでイメージ参考にどうぞ！\n\n\nhttps://drive.google.com/drive/folders/1uAZCMiI4Q8uHJgFIl5a3n3ymrEnm7eBo?usp=sharing\n\nhttps://youtu.be/rm43yk1M21I?si=I7mRT_SgfzsLg7_1", "created_at": "", 