ef-4eed-81d7-24cda342cfa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8d5745f73f8daba43babefb7b363393 2x, https://si.imgix.net/938419e2/uploads/origins/f4afa924-acef-4eed-81d7-24cda342cfa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=848dd8a2b1dead97090721ac00595f0d 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです。前回頂いた絵、本当に気に入っています！\nぜひまた裏方先生の淡く儚げな絵柄で見てみたいと思い、リクエストを失礼致します。\n\nこの度は、タイムとライム（特にタイム）の絵をお願いできたらと思います。\nシチュエーションや作風、色味等々はすべて裏方先生流でお願いできますと幸いです。\nURLに設定等ありますが、参考程度にしていただけたらと思います。\n\n・タイム\nhttps://x.com/104_working/status/1825878999819854129\n・ライム\nhttps://x.com/104_working/status/1745620206788190395", "created_at": "", "completed_at": ""}, {"path": "/@urct/works/116", "thumbnail_src": "https://si.imgix.net/a88e45f8/uploads/origins/08109a77-253e-4f3b-a06b-d84b0e4980c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84bfe8b897607c9fb3f4cf2a357dbbc5", "thumbnail_srcset": "https://si.imgix.net/a88e45f8/uploads/origins/08109a77-253e-4f3b-a06b-d84b0e4980c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84bfe8b897607c9fb3f4cf2a357dbbc5, https://si.imgix.net/a88e45f8/uploads/origins/08109a77-253e-4f3b-a06b-d84b0e4980c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f26ad7e4fcea9dd335c54a80e7de519 2x, https://si.imgix.net/a88e45f8/uploads/origins/08109a77-253e-4f3b-a06b-d84b0e4980c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf09cdaecca6fa7783f204fac595d9a9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵はとてもきれいですね！\n私のキャラクター「キューピッド」を描いてほしいんだ。\n彼女はまだ若く、とても陽気で、優しくて、不器用なキューピッド／天使です。頭には矢が刺さっていて、頭、背中、足には羽が生えています。  \nhttps://toyhou.se/8791076.stupid-cupid/gallery\n\nhttps://toyhou.se/8791076.stupid-cupid/gallery", "created_at": "", "completed_at": ""}, {"path": "/@urct/works/115", "thumbnail_src": "https://si.imgix.net/6a55f5bc/uploads/origins/62bb2118-e46c-4c60-88e7-5615fe2a