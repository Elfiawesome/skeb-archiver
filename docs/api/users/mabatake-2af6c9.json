_src": "https://si.imgix.net/2aaeed54/uploads/origins/fbe82707-ab2d-4a30-a51f-de2e9e17bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18a7726617267c8d21ce581a2b95d55a", "thumbnail_srcset": "https://si.imgix.net/2aaeed54/uploads/origins/fbe82707-ab2d-4a30-a51f-de2e9e17bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18a7726617267c8d21ce581a2b95d55a, https://si.imgix.net/2aaeed54/uploads/origins/fbe82707-ab2d-4a30-a51f-de2e9e17bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=336be9392c567088cb2ce03c998af0c0 2x, https://si.imgix.net/2aaeed54/uploads/origins/fbe82707-ab2d-4a30-a51f-de2e9e17bab7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7d653fe80c60999f1e902dafea3ab88 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mabatake/works/227", "thumbnail_src": "https://si.imgix.net/1a0e78fe/uploads/origins/cd1cfde9-9a96-4185-b1d7-00f29dce0cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1725e1a2280516616692576c8985cf7", "thumbnail_srcset": "https://si.imgix.net/1a0e78fe/uploads/origins/cd1cfde9-9a96-4185-b1d7-00f29dce0cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1725e1a2280516616692576c8985cf7, https://si.imgix.net/1a0e78fe/uploads/origins/cd1cfde9-9a96-4185-b1d7-00f29dce0cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f25118eb05649c864367f651f043ea61 2x, https://si.imgix.net/1a0e78fe/uploads/origins/cd1cfde9-9a96-4185-b1d7-00f29dce0cc9?