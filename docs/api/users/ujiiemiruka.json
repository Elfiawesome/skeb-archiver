41b7-812e-25a037d71a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d36c28f0fe9b081f848350a25570a66, https://si.imgix.net/21de8d2a/uploads/origins/510daf28-65a8-41b7-812e-25a037d71a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e929228b2acdf4011eb2ed1940154b7 2x, https://si.imgix.net/21de8d2a/uploads/origins/510daf28-65a8-41b7-812e-25a037d71a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38e40aad22dec68e9c3fde15f3e7c6d7 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは！先生の作品に出会って、私のOCを描いていただきたいと思いました。\n名前は \"原罪 \"で、閻魔大王です。背が高く（200cm）、堂々とした体格と厳しい顔つきをしています（感情をあまり表に出さないけれど、どこか優しい心を持っています）。\n男性でも女性でもないため、かなりアンドロジナスな外見をしている（少し男性寄り）。腕、首、脚の皮膚は赤い花柄や抽象的なタトゥーで覆われている（資料では少し見づらいかもしれないが、存在する）。彼らはしばしば、武器として浄化された鏡か真紅の鞭を持っている。\n彼らは仏教徒なので）少し宗教的でダークな雰囲気の絵になると思います！初めてのSkeb依頼なので、驚かれることを期待しています :)\n私のキャラを描いてくれたらありがたいです。お忙しい中、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/19M-21S8fFwIppTSdTLKAA0kl63LoB-n_?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ujiiemiruka/works/5", "thumbnail_src": "https://si.imgix.net/c981fff5/uploads/origins/7e5f0218-65a3-41f7-88aa-44c83e6c3d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3b20ac93af25852d03ddd13a045d90", "thumbnail_srcset": "https://si.imgix.net/c981fff5/uploads/origins/7e5f0218-65a3-41f7-88aa-44c83e6c3d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3b20ac93af25852d03ddd13a045d90, https://si.imgix.net/c981fff5/uploads/origins/7e5f0218-65a3-41f7-88aa-44c83e6c3d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37be09e52e166c799a7be49105f7bc2b 2x, https://si.imgix.net/c981fff5/uploads/origins/7e5f0218-65a3-41f7-88aa-44c83e6c3d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e7e1e28dbd4ae49a0c207dd47a4b3b4 3x", "genre": "art", "nsfw": false, "body": "氏家 様\n\n初めまして、個人VTuberのシャルバートと申します。\n新着作品に