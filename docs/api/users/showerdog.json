dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ada10932c5d5284e4e13fa609caee14 2x, https://si.imgix.net/3ee0efe1/uploads/origins/8d6a0d69-6100-4e06-a80d-b15f80d39599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=159f80f17f995b298989eb996ff81002 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/102", "thumbnail_src": "https://si.imgix.net/937f98a4/uploads/origins/4de69bea-0bff-4dba-a509-18adbef8f4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d575bf0a6bbe378dd0387997995054a", "thumbnail_srcset": "https://si.imgix.net/937f98a4/uploads/origins/4de69bea-0bff-4dba-a509-18adbef8f4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d575bf0a6bbe378dd0387997995054a, https://si.imgix.net/937f98a4/uploads/origins/4de69bea-0bff-4dba-a509-18adbef8f4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a314105eca62042e74def48ab6706ce9 2x, https://si.imgix.net/937f98a4/uploads/origins/4de69bea-0bff-4dba-a509-18adbef8f4d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37eb6eb0bd5b92ffa4deee961a900966 3x", "genre": "art", "nsfw": true, "body": "白犬さんこんにちは、先日はステキなイラストありがとうございました\n手数料無料キャンペーン中らしいので、お時間よろしければまた描いていただきたいイラストがあり、ご検討いただけたら嬉しいです\n放送中のアニメ「妃教育から逃げたい私」から王子クラークと、アニコミ「聖女なのに国を追い出されたので、崩壊寸前の隣国へ来ました」から隣国の王ラオウハルトのリバセックスをお願いできないでしょうか\n衣装不要(小物類はお任せします)、構図・体位・表情・背景などは白犬さんのご自由に描いていただければと思います\nストーリーとか人物像とかも考慮しなくて大丈夫です\n雄尻、雄っぱい、生中出し、結合部丸見えとか大好きです\n\n無断利用/AI学習禁止のため、顔部分など一部カット＆テキスト追加してＳＮＳに投稿予定なのでご了承いただければ幸いです\n\nセックスを楽しんでる２人を拝見できるのを楽しみにしています！\nご検討、よろしくお願いします！！", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/101", "thumbnail_src": "https://si.imgix.net/4cd88733/uploads/origins/2e031ead-2b59-4155-a195-74d153816751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f36e48419844ac0c86e937059cbb798", "thumbnail_srcset": "https://si.imgix.net/4cd88733/uploads/origins/2e031ead-2b59-4155-a195-74d153816751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f36e48419844ac0c86e937059cbb798, https://si.imgix.net/4cd88733/uploads/origins/2e031ead-2b59-4155-a195-74d153816751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1ba34c1f9ad3183a3fe85f9687669e0 2x, https://si.imgix.net/4cd88733/uploads/origins/2e031ead-2b59-4155-a195-74d153816751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bca5d950459df15d1b02c19b79555f5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n前回のイラストに感銘を受け、もう一枚イラストをお願いしたいのですが。\nデザインシートを添付します。\nhttps://drive.google.com/drive/folders/1zREZbJLaM9h-zT8WuwJxZaCXtugaL48A?usp=drive_link\n\nシゲ（オレンジ髪の男の子）179cm\nアストラ（黒髪少年）172cm\n\n二人ともベッドの上に座っている。シゲはアストラを背中から抱きしめ、アストラの頬を噛んでいる。二人とも幸せそうに笑っている。\nファイルにポーズの参考画像がある。\n二人ともコートを脱いでおり、コートはベッドの上に広げられている。コートはベッドに広げられ、服と靴下は身に着けているが、靴は履いていない。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/100", "thumbnail_src": "https://si.imgix.net/62c6481b/uploads/origins/69ee39d9-32b7-4adb-8953-73afe36cd59f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e311ee52bf2d948908569a8f98c6b6b8", "thumbnail_srcset": "https://si.imgix.net/62c6481b/uploads/origins/69ee39d9-32b7-4adb-8953-73afe36cd59f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e311ee52bf2d948908569a8f98c6b6b8, https://si.imgix.net/62c6481b/uploads/origins/69ee39d9-32b7-4adb-8953-73afe36cd59f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6afb72f740793ec7380f9c5786b7695f 2x, https://si.imgix.net/62c6481b/uploads/origins/69ee39d9-32b7-4adb-8953-73afe36cd59f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=856fa9e108f294e1f8c585eee374f660 3x", "genre": "art", "nsfw": true, "body": "こんにちは！君のストリートファイター6のアートを見つけたばかりなんだ！\n\n私はミュージシャンのエルフのキャラクターを持っているのですが、あなたが描いたこの素晴らしい画像と同じような感じの画像を作ってほしいです！https://skeb.jp/@showerdog/works/67\n\nアイデア：私のキャラクターがお風呂で濡れて、宇宙船の窓の前を歩いているところを想像しています。彼は濡れて光っており、外の銀河からの色とりどりの光が彼に反射して美しく見える。アイデアのヒントになったリファレンスを提供しましたが、最終的なポーズはもちろん自由です！ヘアスタイルも同じです！\n\n窓の外は美しい銀河で、色、星、雲、惑星など、美しく幻想的な宇宙のシーンのために必要だと思うものを使ってほしい。\n\nあなたのアートはとてもゴージャスなので、ぜひ引き受けてほしい！\n\nDropboxファイル: https://www.dropbox.com/scl/fo/he7zwf4srju7yhcfywkml/AJQGJ_e8gURXGjAnQUSLto0?rlkey=t3ui11ycprpot5ngkk0g4hnga&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/99", "thumbnail_src": "https://si.imgix.net/4eb19a34/uploads/origins/9995566e-29c2-4726-9f1f-f7101696c7e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=605dbdd5e2cd5c4fe3375775ae41f7f3", "thumbnail_srcset": "https://si.imgix.net/4eb19a34/uploads/origins/9995566e-29c2-4726-9f1f-f7101696c7e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=605dbdd5e2cd5c4fe3375775ae41f7f3, https://si.imgix.net/4eb19a34/uploads/origins/9995566e-29c2-4726-9f1f-f7101696c7e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=359d0870603a316796f00143e67ec238 2x, https://si.imgix.net/4eb19a34/uploads/origins/9995566e-29c2-4726-9f1f-f7101696c7e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5d83fe28eb40fe2c365a098e0bed9b9 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私の友人と私のocのためにNSFWイラストをお願いしたいです。\n私のOC：タイツを履いた黒猫の少年。（受け）\n友人のOC：スーツを着た狼男の少年。(攻め）\nキャラクターデザインとポーズリファレンスはファイルに添付されています：\n\nhttps://drive.google.com/drive/folders/1bPVZK1ACH8XuAcZbj7cGSk-7ZiKnDWuk?direction=d\n\nシチュエーション\n狼少年は猫少年の背中に横たわり、猫少年を犯して中に大量の精液を出した。狼少年はソックスガーターと靴下しか履いていない。猫少年はタイツを履いています。", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/98", "thumbnail_src": "https://si.imgix.net/51b1b848/uploads/origins/1667a172-5521-497a-9a31-fb5e08448bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39d42139ef5894b29a1ea75ca40df2e6", "thumbnail_srcset": "https://si.imgix.net/51b1b848/uploads/origins/1667a172-5521-497a-9a31-fb5e08448bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39d42139ef5894b29a1ea75ca40df2e6, https://si.imgix.net/51b1b848/uploads/origins/1667a172-5521-497a-9a31-fb5e08448bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=847c683305c3abf26aace4bbfef26cf8 2x, https://si.imgix.net/51b1b848/uploads/origins/1667a172-5521-497a-9a31-fb5e08448bbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9178936cc5e3b7ebb5b8219ba26eb548 3x", "genre": "art", "nsfw": true, "body": "白犬さんこんにちは、先日はステキなイラストありがとうございました\nお時間よろしければまた描いていただきたいイラストがあるのですが、ご検討いただけたら嬉しいです\n放送中のアニメ「星降る王国のニナ」から、アズールとセトのリバセックスをお願いできないでしょうか\n衣装不要(小物類はお任せします)、構図・体位・表情・背景などは白犬さんのご自由に描いていただければと思います\nストーリーとか人物像とかも考慮しなくて大丈夫です\n雄尻、雄っぱい、生中出し、結合部丸見えとか大好きです\n感情を表に出さない２人がエッチな時にどんな表情を見せるのか楽しみです\nご検討、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/97", "thumbnail_src": "https://si.imgix.net/85525dc4/uploads/origins/4036793a-8120-4a18-bbaa-7c6da0614401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1c6437207b12e2f6edd42be0978c74d", "thumbnail_srcset": "https://si.imgix.net/85525dc4/uploads/origins/4036793a-8120-4a18-bbaa-7c6da0614401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1c6437207b12e2f6edd42be0978c74d, https://si.imgix.net/85525dc4/uploads/origins/4036793a-8120-4a18-bbaa-7c6da0614401?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cad0a8e88d94ed4eee05e