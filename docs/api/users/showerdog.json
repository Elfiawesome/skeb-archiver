dfa-4510-8943-a6adaa1c1cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcd05fd7f1f7a3a96f2090c5fcf03c5", "thumbnail_srcset": "https://si.imgix.net/b9539772/uploads/origins/60cb96c7-8dfa-4510-8943-a6adaa1c1cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcd05fd7f1f7a3a96f2090c5fcf03c5, https://si.imgix.net/b9539772/uploads/origins/60cb96c7-8dfa-4510-8943-a6adaa1c1cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d1e894d9553f515ff3cfd1192cf73fa 2x, https://si.imgix.net/b9539772/uploads/origins/60cb96c7-8dfa-4510-8943-a6adaa1c1cd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb59c5ec79e6f28b797326121d6450f3 3x", "genre": "art", "nsfw": true, "body": "私のニンジャボーイズに対するあなたの仕事は素晴らしい！だから、また描いてください。\n伝統的なお祭りの衣装で描いてくれることを願っています：\nhttps://drive.google.com/file/d/1ZtvHobeyBxgM3as3CzauaR901fY6tqUk/view?usp=sharing\nお祭りの最中、神社のどこかでこっそりセックスしている二人。ミストは地面に座る。レイヴンはミストに向かってしゃがみ、ミストの股間に座る。そしてレイヴンはミストのペニスをふんどしから出し、お尻に差し込んでミストと騎乗位セックスをする。そして二人ともオーガズムに達し、大量に射精する。Ravenはふんどし越しに射精する。\n同じポーズで、ふんどしを脱いで、レイヴンがミストの胸に大量のザーメンをぶちまけるものと、同じポーズで、ふたりとも全裸のもの。\nその他、詳細がリクエストされていないものについては、すべてあなたの選択次第です。ペニスが挿入されているところをもっと詳しく見せてほしい。気に入ったよ！\nお忙しいところ申し訳ありません！\n\nhttps://drive.google.com/file/d/1ZtvHobeyBxgM3as3CzauaR901fY6tqUk/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/79", "thumbnail_src": "https://si.imgix.net/1a6d84aa/uploads/origins/9dba8f29-1fa8-4c68-a1b1-e94048521b44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=985d0613a4b0d8281c5b4110d9d1c50f", "thumbnail_srcset": "https://si.imgix.net/1a6d84aa/uploads/origins/9dba8f29-1fa8-4c68-a1b1-e94048521b44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=985d0613a4b