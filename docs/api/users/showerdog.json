少年は快感を味わい、大量に精液を出す。Ravenの精液は少年たちの胸を乱し、Mistがペニスを抜いた後、Ravenのお尻から液体が漏れる。\n支払い内で可能なら、忍者スーツ姿、全裸のバリエーションが欲しい。\n二人のがっしりした体つきや、仲の良さをうまく表現してほしい。\nその他、細かい要望はありません。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/86", "thumbnail_src": "https://si.imgix.net/52b924c4/uploads/origins/d19609c0-3dca-45ca-9315-e0ed4b820e84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff396987207b60d6220a47d3c3a247f8", "thumbnail_srcset": "https://si.imgix.net/52b924c4/uploads/origins/d19609c0-3dca-45ca-9315-e0ed4b820e84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff396987207b60d6220a47d3c3a247f8, https://si.imgix.net/52b924c4/uploads/origins/d19609c0-3dca-45ca-9315-e0ed4b820e84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80eefca87ca990abea1ac2ce36b84f3c 2x, https://si.imgix.net/52b924c4/uploads/origins/d19609c0-3dca-45ca-9315-e0ed4b820e84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0d6610ebc3197ebb675cdd43147ef14 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@showerdog/works/85", "thumbnail_src": "https://si.imgix.net/309f51a3/uploads/origins/01c92fb6-02ce-4278-b7a0-8ce678e136ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21725b0d5dee47a259c09f41a09405c5", "thumbnail_srcset": "https://si.imgix.net/309f51a3/uploads/origins/01c92fb6-02ce-4278-b7a0-8ce678e136ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200