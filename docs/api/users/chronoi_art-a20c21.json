/shinshu/\n目：\n・真朱色（目の色、明るい部分等）\nhttps://irocore.com/shinshu/\n・葡萄色（影等の暗い部分）\nhttps://irocore.com/ebi-iro/\n・海老色（中間色として使用する色）\nhttps://irocore.com/ebi-iro2/\n\n以上です。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@chronoi_art/works/36", "thumbnail_src": "https://si.imgix.net/0dedc650/uploads/origins/8935e24b-21fa-42e5-b080-fb269c5735af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3d6a69e5f863eb72c08e88a618c9492", "thumbnail_srcset": "https://si.imgix.net/0dedc650/uploads/origins/8935e24b-21fa-42e5-b080-fb269c5735af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3d6a69e5f863eb72c08e88a618c9492, https://si.imgix.net/0dedc650/uploads/origins/8935e24b-21fa-42e5-b080-fb269c5735af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2777a836915bf1eaf45d01a7e9026a2e 2x, https://si.imgix.net/0dedc650/uploads/origins/8935e24b-21fa-42e5-b080-fb269c5735af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d658c7f9f74466acf9617be988610dca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@chronoi_art/works/35", "thumbnail_src": "https://si.imgix.net/85e2806a/uploads/origins/23595299-66c6-42e6-b081-67c4b2f36abf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fd71f6fb05e59e0c29c041cf3341790", "thumbnail_srcset": "https://si.imgix.net/85e2806a/uploads/origins/23595299-66c6-42e6-b081-67c4b2f36abf?bg=%23fff&auto=format%2Ccompres