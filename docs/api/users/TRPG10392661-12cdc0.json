", "created_at": "", "completed_at": ""}, {"path": "/@TRPG10392661/works/13", "thumbnail_src": "https://si.imgix.net/9bb6723e/uploads/origins/d3afca6f-9af7-4fd8-b6f0-df4c625169a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bc0b817776f2fcae051163860fb1860", "thumbnail_srcset": "https://si.imgix.net/9bb6723e/uploads/origins/d3afca6f-9af7-4fd8-b6f0-df4c625169a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bc0b817776f2fcae051163860fb1860, https://si.imgix.net/9bb6723e/uploads/origins/d3afca6f-9af7-4fd8-b6f0-df4c625169a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b899795b335d8b7afdfa8d7429465ee0 2x, https://si.imgix.net/9bb6723e/uploads/origins/d3afca6f-9af7-4fd8-b6f0-df4c625169a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33c076668538cac0c161aa174a376c56 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TRPG10392661/works/12", "thumbnail_src": "https://si.imgix.net/210b57a0/uploads/origins/034b689c-cc30-4cb2-84d5-51a5a7ec3ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=711aa47ccb93289bd9c519442e61d9ca", "thumbnail_srcset": "https://si.imgix.net/210b57a0/uploads/origins/034b689c-cc30-4cb2-84d5-51a5a7ec3ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=711aa47ccb93289bd9c519442e61d9ca, https://si.imgix.net/210b57a0/uploads/origins/034b689c-cc30-4cb2-84d5-51a5a7ec3ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3496bf63719c5349bb70eb15b3ecba0