-44ad-8216-cead013a7699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9336ae96ec1cab708991e90672c44845, https://si.imgix.net/d3b72b33/uploads/origins/2a02d2dd-a7ec-44ad-8216-cead013a7699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfc728337ef840665e18ce03626f415e 2x, https://si.imgix.net/d3b72b33/uploads/origins/2a02d2dd-a7ec-44ad-8216-cead013a7699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6561dd37b2336d1b6eddac1bd365079 3x", "genre": "art", "nsfw": false, "body": "ぴろぴろさん、こんにちは！！！\nぴろぴろさんのイラスト大好きです！この度はぜひステガノグラフィの自陣のSDを描いていただけたらと思いご連絡致しました。（依頼に際して、友人からの許可は取っております）\n\n■使用用途\n・鑑賞\n・友人とのイラスト共有\n・名前やIDを記載した上でSNSのアイコンやヘッダーに使用\n・個人的なグッズ制作(利益の発生しないもの)\n\n■資料\nhttps://drive.google.com/drive/folders/1oCn3Ury1OkK-DQB9o-mzT27TLIKn6Ugn?usp=drive_link\n\nご多忙の中大変恐縮ですが、よろしければご一考いただけましたら幸いです！\n不適切と判断された場合は、遠慮なくキャンセルしても大丈夫です。よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@pilo_pilo_trpg/works/2", "thumbnail_src": "https://si.imgix.net/b08819a9/uploads/origins/7f8187c8-ffa5-44cf-bca0-f72d4b9619b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a3a10c1140cb39b030b69919bb8e8a6", "thumbnail_srcset": "https://si.imgix.net/b08819a9/uploads/origins/7f8187c8-ffa5-44cf-bca0-f72d4b9619b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a3a10c1140cb39b030b69919bb8e8a6, https://si.imgix.net/b08819a9/uploads/origins/7f8187c8-ffa5-44cf-bca0-f72d4b9619b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9015bef269faaf9c75e53abfc611109e 2x, https://si.imgix.net/b08819a9/uploads/origins/7f8187c8-ffa5-44cf-bca0-f72d4b9619b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=386589048054f2b58dc55397c5c0eacc 3x", "genre": "art", "nsfw": false, "body": "はじめまして。素敵な絵柄に惹かれまして、ご依頼に伺いました。\n可能でありましたら下記の資料にある二人のSD絵をお願いしたいです。\n(TRPGのPCですが、資料内にシナリオのネタバレは一切含みません。)\n構図等はおまかせ致しますので、お好きなように描いて頂けますと嬉しいです。\n細かいところやわからない部分があれば描きやすいように省略して頂いて構いません。\n依頼内容が金額に見合わない、不備等ありましたらできる限り対応させて頂きますので、お気兼ねなく再送要請してください。\n\n【可能性がある使用用途】\n・X、またはDiscordのアイコン\n・個人鑑賞\n\nご検討よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1VuFSxhOBKGR7gMBJOKRd8tPUUPnxlair?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@pilo_pilo_trpg/works/1", "thumbnail_src": "https://si.imgix.net/f498f96d/uploads/origins/d947ce9f-7678-47b3-91d6-d8e1f896cbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79d52f161857ca4c08a0918e025349e7", "thumbnail_srcset": "https://si.imgix.net/f498f96d/uploads/origins/d947ce9f-7678-47b3-91d6-d8e1f896cbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79d52f161857ca4c08a0918e025349e7, https://si.imgix.net/f498f96d/uploads/origins/d947ce9f-7678-47b3-91d6-d8e1f896cbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d26518f0a58bb62a3de3a4aae540c181 2x, https://si.imgix.net/f498f96d/uploads/origins/d947ce9f-7678-47b3-91d6-d8e1f896cbfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb663571aa8fff69c443c9398bd2af31 3x", "genre": "art", "nsfw": false, "body": "ぴろぴろ様\n\n初めまして、\nもしよろしければこの下記リンク先のオリジナルキャラクターをぴろぴろ様の絵柄で描いていただけないでしょうか。\n可能でしたらアイコンにされているようなSDのお二人のように描いていただけますと嬉しいです。\n\n二人は同じチームに所属しているメンバーです。\n\nキャラ①（白髪の方）147cm 18歳\n・無邪気\n・年齢よりだいぶ幼い言動、行動\n（ご飯を食べる時に口の周りがべたべたになるなど）\n・チームのみんなのことが大好き\n・甘えん坊で寂しがりや（夜眠れないと誰かが寝ているところに潜り込んで一緒に寝る）\n\nキャラ②（ピンク髪の方）175cm 22歳\n・神経質（潔癖症の気がある）\n・リーダー第一主義であるがなんだかんだ面倒見がいい\n・料理担当だったり家事全般をやってくれている\n・ツンデレ\n（キャラ①がうまく箸が持てないのを見て、ちゃんとさせようと思い立った際に、いつもの食器では①が気乗りしないのではないかと思い①の好きそうな箸を買いに行き、選んでいる最中で我に返り「なぜ俺が！」となって最終的にチームメンバー全員分の新しい箸を買って帰るような子です）\n\n【リクエスト内容】\n構図、ポーズ、他小物などは全ておまかせします。服装などは適宜変更していただいて問題ないです。\n\n\n\nもしご縁がありましたら何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1DLDI5S1fiG5dmDAWUXyPkO9Ig-HEiNLZ?usp=drive_link", "created_at": "", "completed_at": ""}]}