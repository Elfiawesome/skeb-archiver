d6/uploads/origins/0b6158c3-837b-42b1-941e-11795d9db480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c62723c3bd926619ad234e5a8c4fc60f", "thumbnail_srcset": "https://si.imgix.net/c78aeed6/uploads/origins/0b6158c3-837b-42b1-941e-11795d9db480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c62723c3bd926619ad234e5a8c4fc60f, https://si.imgix.net/c78aeed6/uploads/origins/0b6158c3-837b-42b1-941e-11795d9db480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06f204a18639e83632258c73229ea157 2x, https://si.imgix.net/c78aeed6/uploads/origins/0b6158c3-837b-42b1-941e-11795d9db480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f64322fb05cccc45b8245df854b747b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品が大好きだと言いたかったのです！お願いがあるのですが、TFではないので引き受けていただけるかどうかわかりませんでした。\n\n生きているデキッドアイのスーツの反応を画像にしていただけないでしょうか？スーツに「着てもいいですか？できれば、誰かが着ようとしているように、中央のファスナーを開けながら、ちょっと恥ずかしがっているような感じでお願いできますか？", "created_at": "", "completed_at": ""}, {"path": "/@kusochibikemona/works/14", "thumbnail_src": "https://si.imgix.net/9e021f1e/uploads/origins/9c55e904-80b0-4525-983a-ac30b0577f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232696bd5e361a242101293a1cf25c2a", "thumbnail_srcset": "https://si.imgix.net/9e021f1e/uploads/origins/9c55e904-80b0-4525-983a-ac30b0577f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232696bd5e361a242101293a1cf25c2a, https://si.imgix.net/9e021f1e/uploads/origins/9c55e904-80b0-4525-983a-ac30b0577f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c091bdf9af3e8392f17b27b303ab3ac4 2x, https://si.imgix.net/9e021f1e/uploads/origins/9c55e904-80b0-4525-983a-ac30b0577f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e10264d82592d651ff6d9bbd54f076b 3x", "genre": "art", "nsfw": false, "body": "はじめまして　ゑび津さん。HBと申します。 \n\nゑび津さんのTFの絵がずっと好きだったのですが、先日、SKEBに投稿された絵を見ました。 その絵がとても可愛くて、ゑび津さんに絵を申し込んでみたくなりました。\n\nhttps://skeb.jp/@kusochibikemona/works/2\n\nゑび津さんに私のケモノオリジナルキャラクターの絵をお願いしたいと思います。キャラクターはキツネザメで、なめらかな肌をしています。キャラクターの性格は繊細でシニカルで、少し傲慢な性格です。 それに基づいたポーズや構図はすべてゑび津さんにお任せしたいと思います。どうぞお好きなように描いてください。\n\nhttps://www.dropbox.com/scl/fi/hmz2qfpil8agqhntnf2ek/commission.zip?rlkey=8bu60yxrpcz2q9bjolz8z1xe0&st=oo50ju09&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@kusochibikemona/works/13", "thumbnail_src": "https://si.imgix.net/bbab82e0/uploads/origins/c4538f58-c14b-44d3-b737-f34a725ec0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06bec54ba285cf14cd089b4c6ca431d", "thumbnail_srcset": "https://si.imgix.net/bbab82e0/uploads/origins/c4538f58-c14b-44d3-b737-f34a725ec0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06bec54ba285cf14cd089b4c6ca431d, https://si.imgix.net/bbab82e0/uploads/origins/c4538f58-c14b-44d3-b737-f34a725ec0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cb6ea884b91168805c2469be1451077 2x, https://si.imgix.net/bbab82e0/uploads/origins/c4538f58-c14b-44d3-b737-f34a725ec0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d45b11a340e4886805304734f75ebd8c 3x", "genre": "art", "nsfw": false, "body": "こんなTFはいかがでしょうか？\n「歯医者志望の少年が虫歯菌にTF」\n\n・歯医者志望の少年\n→Tシャツに綺麗な歯のマークがある、「歯医者になりたかったのに！」みたいなセリフがある、でお願いします。\n・虫歯菌(人外or獣人)\n→紫っぽい灰色の肌、ヘルメットを被っている、槍を持っている、悪魔みたいなツノと尻尾がある、「虫歯を作りたい！」みたいなセリフがある、でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kusochibikemona/works/12", "thumbnail_src": "https://si.imgix.net/a896692f/uploads/origins/c23bc7a5-45de-4cf4-9434-f61fdb9474a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9506efa79c630d0c176621598931e1b", "thumbnail_srcset": "https://si.imgix.net/a896692f/uploads/origins/c23bc7a5-45de-4cf4-9434-f61fdb9474a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9506efa79c630d0c176621598931e1b, https://si.imgix.net/a896692f/uploads/origins/c23bc7a5-45de-4cf4-9434-f61fdb9474a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e88909dff98bd1a82d9c41e0664405af 2x, https://si.imgix.net/a896692f/uploads/origins/c23bc7a5-45de-4cf4-9434-f61fdb9474a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=110aa6fd0aed52b7427dbe1e9476a5c7 3x", "genre": "art", "nsfw": false, "body": "ケモノキャラクターが40本の脚を持つ多脚ケモノタウルにTFするのを見たい！(昆虫じゃないけど）\n\n解剖学的には、2本の腕、2本の前脚、38本の後脚があり、それぞれの脚の間にフルサイズの胴体があるようなキャラクターにしたい。詳しくは以下のドキュメントをご覧ください。\n\n特定のクリーチャー、デザイン、ポーズはなく、全身と脚が見えていれば満足です。\n\nhttps://cdn.discordapp.com/attachments/749476684662833255/1104320790406627458/Taurtrain_anatomy_reference.doc", "created_at": "", "completed_at": ""}, {"path": "/@kusochibikemona/works/11", "thumbnail_src": "https://si.imgix.net/2f10ce8b/uploads/origins/89cdff42-72b5-4962-af62-422ec9026fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69607f6f6881936bd459aef46e9b6f8", "thumbnail_srcset": "https://si.imgix.net/2f10ce8b/uploads/origins/89cdff42-72b5-4962-af62-422ec9026fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69607f6f6881936bd459aef46e9b6f8, https://si.imgix.net/2f10ce8b/uploads/origins/89cdff42-72b5-4962-af62-422ec9026fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7efd2fc2c6c64cea28e050e74f6fe09b 2x, https://si.imgix.net/2f10ce8b/uploads/origins/89cdff42-72b5-4962-af62-422ec9026fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be9a7f99fbbfc52d0b8ae34c66193ae8 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートをとても楽しみました！だから、私のOCのために依頼をしたいです。\n2つのイメージを描いてください！\n一枚は、人間の姿のOCがベッドで寝ていて、毛皮の姿に変身しているところ。そしてもう1つの画像では、彼が目を覚まし、鏡に映った毛皮姿の自分を見て驚いています！\n私のOCの人間の姿のリファレンスはGoogleドライブに含まれています！\n毛皮姿のOCの右頬には三日月型の模様があり、肩と足にも同じような模様がある。ありがとう！\n参考：https://drive.google.com/drive/folders/1fmVxTrpz3zj0a1bqJLlwqG3gH3VJIifH?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@kusochibikemona/works/10", "thumbnail_src": "https://si.imgix.net/7e97673c/uploads/origins/1f9d170f-161f-4265-9d88-26e980373199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8319cd04362ea94c41cc09b2e59527db", "thumbnail_srcset": "https://si.imgix.net/7e97673c/uploads/origins/1f9d170f-161f-4265-9d88-26e980373199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8319cd04362ea94c41cc09b2e59527db, https://si.imgix.net/7e97673c/uploads/origins/1f9d170f-161f-4265-9d88-26e980373199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f43a4b92174d5c2d68f3bcbf5d6cb755 2x, https://si.imgix.net/7e97673c/uploads/origins/1f9d170f-161f-4265-9d88-26e980373199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33ac07371ca38617ea4b4589f473a735 3x", "genre": "art", "nsfw": false, "body": "ゑびさんはじめまして\n\nもしよろしければうちの子のTFを描いていただきたく依頼いたしました…っ\n内容としましては、中学生or高校生男子がうちの子にTFする…といった内容でお願いしたく思いますっ\n\nうちの子の資料に関しては以下に添付いたします…っ\n参考程度にですが、うちの子の大きさは0.8mほどになります\nhttps://www.dropbox.com/s/28zvcbh3ywylszl/%E3%83%A8%E3%83%A2%E3%82%AE.jpg?dl=0\n\n以上です、何卒よろしくお願いいたします…！", "created_at": "", "completed_at": ""}, {"path": "/@kusochibikemona/works/9", "thumbnail_src": "https://si.imgix.net/4e1514c9/uploads/origins/78501f24-f54f-4e01-8350-a47484d77941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08e9aa53fa8dc39e1c906cad39915dd3", "thumbnail_srcset": "https://si.imgix.net/4e1514c9/uploads/origins/78501f24-f54f-4e01-8350-a47484d77941?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08e9aa53fa8dc39e1c906cad39915dd3, https://si.imgix.net/4e1514c9/uploads/origins/78501f24-f54f-4e01-8350-a47484d77941?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10933aaf8a0c56bf1049936aa7899fb2 2x, https://si.imgix.net/4e1514c9/uploads/origins/78501f24-f54f-4e01-8350-a47484d77941?bg=%23fff&auto=format%2Ccompress&f