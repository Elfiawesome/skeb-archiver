b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b091afe35cdd3f2801f945fd30fca932 2x, https://si.imgix.net/88b11d77/uploads/origins/0df7b0a6-e928-4209-b303-a456dcc25ab1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=424b6963b5eb9a2046a93df59f90568a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！英語のリクエストで申し訳ありません。機械翻訳がわかりやすいといいのですが。\nごちうさをはじめ、きららのイラストが大好きです。最新章のココアちゃん、ふゆちゃん、ゆらちゃん（「野生の地獄うさぎ」）のような服装で、「ごちうさ」のめぐちゃんのイラストをお願いしたいです。イヤリングは最低限で構いません。  さらに、髪はJKの制服のようにおろすかツインテールにしてほしい。\n\nまた、\"ズォォォォォ \"ポーズで、舌を出し、目の色も普通にしてほしい。\n\n背景はシンプルなものでもいいし、ハーフティンバーの町をモチーフにしたものでもいい。\n\n参考画像：https://imgur.com/a/NHgqn6u\n\nリクエストはあくまで提案です！好きな服装やポーズ、描きやすいポーズを自由に考えてください！", "created_at": "", "completed_at": ""}, {"path": "/@CRANE1192/works/12", "thumbnail_src": "https://si.imgix.net/5bdb4b3a/uploads/origins/534f7c43-4792-4765-9cf9-a2acb781bef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61acd9b1228994f12628c8d926f128aa", "thumbnail_srcset": "https://si.imgix.net/5bdb4b3a/uploads/origins/534f7c43-4792-4765-9cf9-a2acb781bef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61acd9b1228994f12628c8d926f128aa, https://si.imgix.net/5bdb4b3a/uploads/origins/534f7c43-4792-4765-9cf9-a2acb781bef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62f933d11e9b759f044cba5cf9474288 2x, https://si.imgix.net/5bdb4b3a/uploads/origins/534f7c43-4792-4765-9cf9-a2acb781bef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ee607d4919fbf81ae2d98673e9c5405 3x", "genre": "art", "nsfw": false, "body": "ドールズフロントラインというゲームに登場するM16A1というキャラクターのイラストをお願いします。カフェのサーバーのような格好をしていますが、仕事を抜け出してネスカフェ原宿のスリープカフェで寝ていたらユーモラスだと思います。\n\nhttps://drive.google.com/drive/folders/1Qu0O8PbPuqHf6VpM1gNBlMe69hCMA6zN", "created_at": "", "completed_at": ""}, {"path": "/@CRANE1192/works/11", "thumbnail_src": "https://si.imgix.net/92f7a9f5/uploads/origins/3b8bf93c-5158-411a-a9c2-b31fea394ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee35e3b5167a3b356059a351152470b7", "thumbnail_srcset": "https://si.imgix.net/92f7a9f5/uploads/origins/3b8bf93c-5158-411a-a9c2-b31fea394ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee35e3b5167a3b356059a351152470b7, https://si.imgix.net/92f7a9f5/uploads/origins/3b8bf93c-5158-411a-a9c2-b31fea394ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=317c90a8a598f82c49479aac2efde8c6 2x, https://si.imgix.net/92f7a9f5/uploads/origins/3b8bf93c-5158-411a-a9c2-b31fea394ba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adcf146e2c60f459ef9899bb667c7bbc 3x", "genre": "art", "nsfw": false, "body": "先日はとても素晴らしいミポリン絵を有難う御座いました。\n似たような内容で恐縮ですが、今回もAチャンネル×ポケモンのイラストを依頼させて頂きたいと思います。\n\nケイ子がメッソンとワニノコと、初のバトルで勝てて皆で喜んでいるようなのをお願いします。\n服装は↓の左側2～4コマ目のもので、服は青と白のボーダー、スカートは黒にして頂けると嬉しいです。\nhttps://pbs.twimg.com/media/EsJQWOvXIAc_92G?format=jpg&name=large\n\n自分が知る限りでは、コーテー音さんのケイ子は見たことがない為、今回是非とも描いて頂きたいです。\n何卒ご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@CRANE1192/works/10", "thumbnail_src": "https://si.imgix.net/4dc1f0c9/uploads/origins/d2cfa074-9aab-4a2c-b0c9-259b770e9c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc925cb2406d52e9ecfde688fd9e4056", "thumbnail_srcset": "https://si.imgix.net/4dc1f0c9/uploads/origins/d2cfa074-9aab-4a2c-b0c9-259b770e9c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc925cb2406d52e9ecfde688fd9e4056, https://si.imgix.net/4dc1f0c9/uploads/origins/d2cfa074-9aab-4a2c-b0c9-259b770e9c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aba9c5742f75f9e0e949f16f4a3d7e50 2x, https://si.imgix.net/4dc1f0c9/uploads/origins/d2cfa074-9aab-4a2c-b0c9-259b770e9c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc870a43643fd4342ead1a15898d4b29 3x", "genre": "art", "nsfw": false, "body": "Aチャンネルのナギが水着姿で姿見鏡の前でポーズを取るも、可愛らしくも際どい水着に顔を赤らめているイラストをお願いします。\n\n構図は鏡に正面が映っている鏡越し。\nポーズは布の隙間に手を添えた棒立ちに近いポーズ。\n\n水着は夢喰いメリーのキャラ由衣のきららファンタジアの☆５水着でカチューシャや服はなし\n進化前、進化後はおまかせします。\n水着後ろ側のデザインはおまかせします。", "created_at": "", "completed_at": ""}, {"path": "/@CRANE1192/works/9", "thumbnail_src": "https://si.imgix.net/4ce6bf8e/uploads/origins/6aa59a09-127d-4c39-9c0b-e4e1cf7416b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=832bb205f150dcff94ae721ec2ad1ee7", "thumbnail_srcset": "https://si.imgix.net/4ce6bf8e/uploads/origins/6aa59a09-127d-4c39-9c0b-e4e1cf7416b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=832bb205f150dcff94ae721ec2ad1ee7, https://si.imgix.net/4ce6bf8e/uploads/origins/6aa59a09-127d-4c39-9c0b-e4e1cf7416b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=884710dacfdd33860974b6c6c6bc105b 2x, https://si.imgix.net/4ce6bf8e/uploads/origins/6aa59a09-127d-4c39-9c0b-e4e1cf7416b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c045b275ade7886139bbae6e14ebf5c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@CRANE1192/works/8", "thumbnail_src": "https://si.imgix.net/d53a9927/uploads/origins/5adaa963-2542-4516-a96a-e6582206c657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d006b54d2c10e92b72006eefd646d12", "thumbnail_srcset": "https://si.imgix.net/d53a9927/uploads/origins/5adaa963-2542-4516-a96a-e6582206c657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d006b54d2c10e92b72006eefd646d12, https://si.imgix.net/d53a9927/uploads/origins/5adaa963-2542-4516-a96a-e6582206c657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d21fd507d10198e09b813eaac52e436 2x, https://si.imgix.net/d53a9927/uploads/origins/5adaa963-2542-4516-a96a-e6582206c657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0da068d83e397abeea8f9de91da03b11 3x", "genre": "art", "nsfw": false, "body": "はじめまして！いつもイラスト楽しませて頂いています。\n\nきらら×ポケモンの流れに乗らせて頂こうと思いまして、『ななどなどなど』吉岡るる×ルナアーラをメインとしたイラストをお願いしたいです。\n\n他のキャラやポケモンを登場させるかは全てお任せいたします。もしお許しを頂ければ、切り取ってSNSのアイコンにさせて頂くことも考えています。\n\n差し支えなければ、よろしくお願いします！", "created_at": "", "completed_at": ""}]}