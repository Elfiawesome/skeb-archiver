dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb8c1dd0633b280925d8e222c6eb9eb4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuyu_kiro/works/50", "thumbnail_src": "https://si.imgix.net/1136f4a6/uploads/origins/f14da5a4-8938-4890-a3ae-d1df099aaad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfa9d20f49c5c4a29786bbf8cf785e62", "thumbnail_srcset": "https://si.imgix.net/1136f4a6/uploads/origins/f14da5a4-8938-4890-a3ae-d1df099aaad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfa9d20f49c5c4a29786bbf8cf785e62, https://si.imgix.net/1136f4a6/uploads/origins/f14da5a4-8938-4890-a3ae-d1df099aaad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ae2fd8148ac1ccfd6daf6aa757109cb 2x, https://si.imgix.net/1136f4a6/uploads/origins/f14da5a4-8938-4890-a3ae-d1df099aaad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb731e4db35b89fae1493f67ad0f87b5 3x", "genre": "art", "nsfw": true, "body": "はじめまして\nご興味あればこちらのオリキャラ\nhttps://skeb.jp/@ryksn1297/works/119\nhttps://skeb.jp/@akisuke06080608/works/470\nにて下記リクエストお受け頂けますと幸いです\n\n＜オリキャラ特徴＞\n・茶髪のルーズサイドテール \n・乳輪が大きい \n・右胸の谷間にホクロ \n・ハリ＜柔らかさなスライム乳\n\n＜シチュ＞\n正常位or 側位でイチャラブ子作りしながら乳吸い\n\n＜詳細＞\n・挿入しながら左胸を吸い上げる夫\n・乳首でなくしっかりと乳輪にしゃぶりつく\n・右乳首は吸われた痕跡として唾液の後が残っている\n・16:9の横長構図で\n・喘ぎ声や状況に応じたセリフ(おまかせ)もあると嬉しいです\n・母乳の有無もおまかせします\n\n以上ご検討のほどよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@yuyu_kiro/works/49", "thumbnail_src": "https://si.imgix.net/a1b79c00/uploads/origins/6420957d-1f79-448e-a8b4-e0142fe3952b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6bc7f2d45892c2733d36c05c313fb84", "thumbnail_srcset": "https://si.imgix.net/a1b79c00/uploads/origins/6420957d-1f79-448e-a8b4-e0142fe3952b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6bc7f2d45892c2733d36c05c313fb84, https://si.imgix.net/a1b79c00/uploads/origins/6420957d-1f79-448e-a8b4-e0142fe3952b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6efe9e943ec0d76a0767ad629530889 2x, https://si.imgix.net/a1b79c00/uploads/origins/6420957d-1f79-448e-a8b4-e0142fe3952b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a28b466935fd2b777dd88d48fd90dee3 3x", "genre": "art", "nsfw": true, "body": "FGOのタマモキャット（霊基再臨の服装はお任せします）のスライム憑依ものなのですがよろしければ…\n\n\n横向きのタマモキャットの口に、目玉のあるスライムがゴポゴポと入り込んでいてタマモキャットは顔を上に向けつつ苦しそうに喉をゴクゴク膨らませながらスライムを飲み込んでいる\n\nそれからタマモキャットの頭からグチュグチュと音がしていてタマモキャットは首を傾げつつハイライトの無い虚ろな目（片方の目がグリッと別の方を向いている）で「あっ…お…う…？」と震えながら無表情でスライムに脳を支配されている最中の状態になり\n\nそして片キツネ耳からドロリと目玉一つが付いたスライムが垂れ出ている、スライムに乗っ取られた虚ろな目のままタマモキャットはニィ…と歯を見せた悪い笑みをして自分のおっぱいを揉んでいる…と言う感じの絵をお願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@yuyu_kiro/works/48", "thumbnail_src": "https://si.imgix.net/7885409d/uploads/origins/c33cfc19-a842-4da1-afd2-803fb1228181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74f74c386677a4950053fee27f3a46f7", "thumbnail_srcset": "https://si.imgix.net/7885409d/uploads/origins/c33cfc19-a842-4da1-afd2-803fb1228181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74f74c386677a4950053fee27f3a46f7, https://si.imgix.net/7885409d/uploads/origins/c33cfc19-a842-4da1-afd2-803fb1228181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bc9d800165a759314ae39bfbd7598b6 2x, https://si.imgix.net/7885409d/uploads/origins/c33cfc19-a842-4da1-afd2-803fb1228181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c7509787801f52224955abac9cd12d7 3x", "genre": "art", "nsfw": true, "body": "募集再開お待ちしておりました\nリクエストさせて頂きます\n\n久川颯\n衣装：水着\nhttps://imas.gamedbs.jp/cg/idol/detail/211?h=imcgss-c2039\n※乳は中〇生にしてはデカめでお願いします\n\nはーちゃんに催眠エッチです\n\n催眠を掛けられたはーちゃんは\n水着をずらされおっぱいを露出\n男はおっぱいを揉む\n男「はーちゃん、水着のこの瞬間を狙ってたよ」\n颯「・・・・」\n催眠状態のはーちゃんは無表情です。\n\n男ははーぱいに吸い付きます\n吸われると母乳も出てきます\n男「俺のために母乳も出す準備もできてるんだね」\n颯「・・・・」\n\n何も感じることができないはーちゃんに中出しエッチします\nはーちゃんは受け入れることしかできない\n男「はーちゃんはそのままでいいからね！受け止めろ！」\n颯「・・・・」\n\n細かいセリフ等はおまかせします。\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yuyu_kiro/works/47", "thumbnail_src": "https://si.imgix.net/c6ae9c51/uploads/origins/2ed11c58-1bb4-4a2b-bbf3-5480ebc50ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a6ae51cd694772004ee6f29f8a66b99", "thumbnail_srcset": "https://si.imgix.net/c6ae9c51/uploads/origins/2ed11c58-1bb4-4a2b-bbf3-5480ebc50ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a6ae51cd694772004ee6f29f8a66b99, https://si.imgix.net/c6ae9c51/uploads/origins/2ed11c58-1bb4-4a2b-bbf3-5480ebc50ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=112c0dabf273c75db9be92b48f66ed2e 2x, https://si.imgix.net/c6ae9c51/uploads/origins/2ed11c58-1bb4-4a2b-bbf3-5480ebc50ba4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1abcab4f13e5a69b5748d0e18f4f259b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuyu_kiro/works/46", "thumbnail_src": "https://si.imgix.net/bc32b33c/uploads/origins/43daaa25-1d9d-459d-bac5-ff27cef0af41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c211f84c27e950f6cd9323c67c71064", "thumbnail_srcset": "https://si.imgix.net/bc32b33c/uploads/origins/43daaa25-1d9d-459d-bac5-ff27cef0af41?bg=%23fff&auto=format%2C