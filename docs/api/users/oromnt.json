2026-02-23T14:26:25.218553+00:00"}, {"amount": 6000, "recorded_at": "2026-02-23T21:41:18.746796+00:00"}, {"amount": 7000, "recorded_at": "2026-02-25T05:35:01.758620+00:00"}, {"amount": 6000, "recorded_at": "2026-02-25T12:25:44.573447+00:00"}, {"amount": 12000, "recorded_at": "2026-02-26T21:23:27.635961+00:00"}, {"amount": 6000, "recorded_at": "2026-02-27T17:44:19.872226+00:00"}, {"amount": 10000, "recorded_at": "2026-03-02T23:49:04.147883+00:00"}, {"amount": 12000, "recorded_at": "2026-03-16T05:18:13.028617+00:00"}, {"amount": 13000, "recorded_at": "2026-03-16T23:44:47.231855+00:00"}, {"amount": 9000, "recorded_at": "2026-03-18T02:43:43.976714+00:00"}]}, "current_prices": {"art": 9000}, "price_range": {"art": {"min": 5000, "max": 13000}}, "links": [{"label": "Twitter", "url": "https://x.com/oromnt", "name": "oromnt"}], "flags": {}, "works": [{"path": "/@oromnt/works/42", "thumbnail_src": "https://si.imgix.net/abb9eafe/uploads/origins/5a34ec95-eece-4e96-821d-505c4bbe85b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6a47ee36faea4063af0e9647e0a7988", "thumbnail_srcset": "https://si.imgix.net/abb9eafe/uploads/origins/5a34ec95-eece-4e96-821d-505c4bbe85b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6a47ee36faea4063af0e9647e0a7988, https://si.imgix.net/abb9eafe/uploads/origins/5a34ec95-eece-4e96-821d-505c4bbe85b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b34074e384dfa8c53efac48cd7f3b36 2x, https://si.imgix.net/abb9eafe/uploads/origins/5a34ec95-eece-4e96-821d-505c4bbe85b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caf07303f3b58d53240ae49979601dcc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！ \nいつもまだごはん様の素敵なイラストを楽しく拝見しております。 \nもしご縁がありましたら、ぜひとも創作キャラクターたちを描いていただければと思い、リクエストを送らせていただきました。   \nキャラクター設定とこちらの要望は以下のようにまとめました。   \n\n=====   \n\n>>月上/25歳、179cm、一人称：あたし  \n容姿端麗な女装男子、常にほほ笑みで、穏やかな口調を使っている、ふわふわで無害そうに見えるが中身はシンプルにヤバい。  \nよく自分の幼馴染をからかっているが、裏側では相手のことについて何だかんだの過保護傾向が見られる。 \n変人としての自覚はあまりない。   \n\n>>小鳥遊/25歳、171cm、一人称：僕 \n真面目な新米刑事、一見愛想悪そうだが実は人に流されやすい普通ないい奴。ただのツンデレ。  \n可愛いものが大好物。自分はまともな人間というプライドを持ちながら、幼馴染の好き勝手の生き方にちょっとだけ羨ましいと思う。 \n口下手の割りに時々超直球でぶつけてくる。   \n\n>>関係性 \n長年の付き合いで相手という存在を仕方なく慣れてきて、幼馴染と書く腐れ縁。本人たちはそう思っていないが他の人から見れば結構仲良し。 \nふたりとも自分こそ相手の世話係だと思っているがふたりともお互い様でダメダメ。\n\n   【キャラクター設定図・他の参考画像など↓】 https://drive.google.com/drive/folders/1-Aw9n-lIsSdWT4aJ_X2E2amQ7WoYOigc   \n\n=====   \n\n先生の描かれるデフォルメキャラクターがとても大好きで、もしよろしければ、このふたりのデフォルメ詰めをお願いしたいです。\n衣装・構図などに特に要望がありませんので、リンク先の資料に基づきご自由に描いていただければ嬉しいです。\n\n金額・依頼内容について問題がございましたら気軽にキャンセルし、または再送要請していただけると幸いです。 \nご検討のほど、どうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@oromnt/works/41", "thumbnail_src": "https://si.imgix.net/27802eca/uploads/origins/614f8bba-300e-423b-8c38-141df84bbba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b27295a6492ad504170d8cc8ac50d0bd", "thumbnail_srcset": "https://si.imgix.net/27802eca/uploads/origins/614f8bba-300e-423b-8c38-141df84bbba9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b27295a6492ad504170d8cc8ac50d0bd, https://si.imgix.net/27802eca/uploads/origins/614f8bba-300e-423b-8c38-141df84bbba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74cfcdfd9a12488c223b4758a5277b0b 2x, https://si.imgix.net/27802eca/uploads/origins/614f8bba-300e-423b-8c38-141df84bbba9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d40f29f9259fe8499f76360b8ccc6f21 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは、初めまして！\n海外のファンです。先生のイラストをSkebにて拝見しとても素敵できれいだと思っておりました。私の二人のキャラクターを描いていただけませんか。\n\nキャラクター\n秋山 彩（165cm）職業は探偵で、彼女の性格は明るくまっすぐで、心は非常に良いですが、問題を解決するために力を使用することを好む、みんなに距離がない。\n朝比奈 千昼（175cm）職業は元歴史研究者、今は少女に同行するために辞任し、性格は少し冷たいです、他の人から離れているが、唯一の少女に優しい側面を持っているでしょう。\n二人の関係は探偵と助手のようなもので、実はお互いに片思いをしているのですが、誰も口にする片思いはしていません。デフォルトでお互いが一番大切な人であることがわかる。\n具体的にはURL参照してください。\n\n新しいデザインの服が欲しいくて、日常服のスタイルで大丈夫です。\n具体的な構図やポーズ等はまた先生にお任せしたいと思いますので、ご自由に描いて頂けたら幸いです。\nもし、この依頼が合わない場合は、遠慮なくキャンセルしてください。金額が足りない場合は、適切な金額をご提案ください。\n宜しければご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1jMcF3Lm9HJ5DY7tlYp3LPUPEPShqMiii?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@oromnt/works/40", "thumbnail_src": "https://si.imgix.net/25880fbf/uploads/origins/bac9c25e-16f9-485e-9a92-18737ca9c437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=424450d868b4416dcf1b2a7cb563d6bf", "thumbnail_srcset": "https://si.imgix.net/25880fbf/uploads/origins/bac9c25e-16f9-485e-9a92-18737ca9c437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=424450d868b4416dcf1b2a7cb563d6bf, https://si.imgix.net/25880fbf/uploads/origins/bac9c25e-16f9-485e-9a92-18737ca9c437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab5985438ebc0f87aa2eda6e801cede7 2x, https://si.imgix.net/25880fbf/uploads/origins/bac9c25e-16f9-485e-9a92-18737ca9c437?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ef478c0339d11677485a175071ae9aa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@oromnt/works/39", "thumbnail_src": "https://si.imgix.net/4ffd11e5/uploads/origins/b06077f2-593d-4740-9722-e02e03245dfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ade1e829ece02d46fe28b03ffa0cae0a", "thumbnail_srcset": "https://si.imgix.net/4ffd11e5/uploads/origins/b06077f2-593d-4740-9722-e02e03245dfb?bg=%23fff&auto=format