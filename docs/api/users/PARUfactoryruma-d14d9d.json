b-9f02-09d4dd1a4057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1beccd42ed11d666516e26d185287e62 2x, https://si.imgix.net/99c01f55/uploads/origins/b0a6b82a-7c5e-4d7b-9f02-09d4dd1a4057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9063c6ee3d178bd76f5fe5dabb36e719 3x", "genre": "comic", "nsfw": true, "body": "いつもお世話になっております。\n以前描いて頂いたこちらのキャラの「ルルファ」と「ヴァニティア」が、\nパルマシィンさんのキャラクターのルマさんが住む世界で”商談”するお話をお願いします。\n『同業者との”商品”の交換試供をするシーン』や『順番待ちの客に輪姦されるヴァニティア』などあれば幸いです。\n\nhttps://x.com/sabituki_Lab/status/1829843700127797750/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@PARUfactoryruma/works/38", "thumbnail_src": "https://si.imgix.net/06bc8874/uploads/origins/14f4c347-ae24-4f17-bf9f-325346d8dc10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f61298973940343002cd175830a8155b", "thumbnail_srcset": "https://si.imgix.net/06bc8874/uploads/origins/14f4c347-ae24-4f17-bf9f-325346d8dc10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f61298973940343002cd175830a8155b, https://si.imgix.net/06bc8874/uploads/origins/14f4c347-ae24-4f17-bf9f-325346d8dc10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b2109416cd018be3399a8a96bc1b033 2x, https://si.imgix.net/06bc8874/uploads/origins/14f4c347-ae24-4f17-bf9f-325346d8dc10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a14a16f1cf1aeac7e00f9625d2246b52 3x", "genre": "comic", "nsfw": true, "body": "先日遊ばせていただいたVENTANGLEオンラインセッションのキャラクター『ファイアフライ』の漫画を依頼させていただきます\n内容としては勇気にあふれ溌剌と依頼に挑む姿と、奮戦するも力尽き敗北の咎を受けた姿、というビフォーアフターを描いてほしいです\n・セッション中のストーリーの流れを全部描写する必要はありません、シーン描写を自由に取捨選択しダイジェストに描いてもらってOKです、またはセッションで描写したラスト以後の様子（末路の姿）を描いてもらっても大丈夫です\n・漫画にするにあたってキャラクターの見た目やセリフのアレンジや改変もしていただいてOKです\n・敗北前、敗北後のどちらも最低でも１ページ以上であれば、後のページ配分やページ数はお任せします\n\nhttps://www.pixiv.net/artworks/127203674", "created_at": "", "completed_at": ""}, {"path": "/@PARUfactoryruma/works/37", "thumbnail_src": "https://si.imgix.net/17a8f4c8/uploads/origins/654a43ed-3f2f-48f1-9a8e-532ece2fc2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27b6b54a9fafc8c93b473794734709e5", "thumbnail_srcset": "https://si.imgix.net/17a8f4c8/uploads/origins/654a43ed-3f2f-48f1-9a8e-532ece2fc2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27b6b54a9fafc8c93b473794734709e5, https://si.imgix.net/17a8f4c8/uploads/origins/654a43ed-3f2f-48f1-9a8e-532ece2fc2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ee7497c16780c6776e524e23666bd21 2x, https://si.imgix.net/17a8f4c8/uploads/origins/654a43ed-3f2f-48f1-9a8e-532ece2fc2fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a45489523535cc12c6b063ca1313be19 3x", "genre": "comic", "nsfw": true, "body": "いつもお世話になっております。\n私の創作世界観「七罪の淫魔たち」キャラクター「ルルファ・ドライド」とその眷属の「ヴァニティア・ヒュブリリス」のエッチな漫画を依頼させていただきます。\nシチュエーションは、ルルファが裏社会の顧客に隷属化した商品(問題児だった冒険者)を受け渡す話でお願いします。\n\n可能であれば以下のシーンを描写していただければ幸いです。\n1.商品の紹介\n2.所有権(呪言の命令権)の譲渡、呪言の試運転\n3.待合室にて、ルルファの命令で次の顧客へ奉仕をしているヴァニティア\n4.商談の準備ができ、ルルファに呼ばれて待合室から出る顧客と、待合室に放置されるヴァニティア\n\n顧客と商品はモブですのでデザインは自由にしていただいて構いません。\nよろしくお願いいたします。\n\nhttps://x.com/sabituki_Lab/status/1829843700127797750", "created_at": "", "completed_at": ""}, {"path": "/@PARUfactoryruma/works/36", "thumbnail_src": "https://si.imgix.net/397cf256/uploads/origins/a5bd90bd-63dd-4e62-bbb7-7c3ed95dda91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd330b05e940f5a8cd7bf4a1fadd0ebb", "thumbnail_srcset": "https://si.imgix.net/397cf256/uploads/origins/a5bd90bd-63dd-4e62-bbb7-7c3ed95dda91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd330b05e940f5a8cd7bf4a1fadd0ebb, https://si.imgix.net/397cf256/uploads/origins/a5bd90bd-63dd-4e62-bbb7-7c3ed95dda91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce08089fef7ee5b4caab10e10417b725 2x, https://si.imgix.net/397cf256/uploads/origins/a5bd90bd-63dd-4e62-bbb7-7c3ed95dda91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e5f8a280f0f10c95293084437e4a42e 3x", "genre": "comic", "nsfw": true, "body": "現在制作中の淫街観光の続きをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@PARUfactoryruma/works/35", "thumbnail_src": "https://si.imgix.net/57598331/uploads/origins/9d10a1e8-3fdb-4765-a30b-886c014861f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2111eb6347bc836dd663a33400bbfcdc", "thumbnail_srcset": "https://si.imgix.net/57598331/uploads/origins/9d10a1e8-3fdb-4765-a30b-886c014861f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2111eb6347bc836dd663a33400bbfcdc, https://si.imgix.net/57598331/uploads/origins/9d10a1e8-3fdb-4765-a30b-886c014861f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=998c4428eab7f0758016af918d752d51 2x, https://si.imgix.net/57598331/uploads/origins/9d10a1e8-3fdb-4765-a30b-886c014861f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8152f670f10c196eae5c864d57f4571 3x", "genre": "comic", "nsfw": true, "body": "フタナリ娘のオナホ性奴隷コレクション紹介\nをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@PARUfactoryruma/works/34", "thumbnail_src": "https://si.imgix.net/75da82d1/uploads/origins/001b56f8-3df2-4074-b15f-b22deb023534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c1df7dfb4b99561eea7c6a397741e22", "thumbnail_srcset": "https://si.imgix.net/75da82d1/uploads/origins/001b56f8-3df2-4074-b15f-b22deb023534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c1df7dfb4b99561eea7c6a397741e22, https://si.imgix.net/75da82d1/uploads/origins/001b56f8-3df2-4074-b15f-b22deb023534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2