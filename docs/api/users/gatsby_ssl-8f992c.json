かと控えめな子ですが、少々（？）大胆な衣装を用意され、（これは、本当に私に用意された仕事なのか…？）と疑念を浮かべつつ、プロデューサーの私欲が混ざっていることに気付きつつも、まんざらでもなく応じている──？\n\nキャラ以外の内容はすべておまかせいたします。我欲と妄想が強く恐縮です…。\nご検討のほどどうぞよろしくお願いいたします。\n\nhttps://imas.gamedbs.jp/cg/idol/detail/208", "created_at": "", "completed_at": ""}, {"path": "/@gatsby_ssl/works/34", "thumbnail_src": "https://si.imgix.net/8e194092/uploads/origins/0725bcdf-b77d-4b08-b8f2-e9a3f12cb15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f38f2fd133509fc7f2c3fc68715a8ba3", "thumbnail_srcset": "https://si.imgix.net/8e194092/uploads/origins/0725bcdf-b77d-4b08-b8f2-e9a3f12cb15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f38f2fd133509fc7f2c3fc68715a8ba3, https://si.imgix.net/8e194092/uploads/origins/0725bcdf-b77d-4b08-b8f2-e9a3f12cb15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdb3d01113c476060c56d624e26d7d03 2x, https://si.imgix.net/8e194092/uploads/origins/0725bcdf-b77d-4b08-b8f2-e9a3f12cb15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a0ac4586255c2d032cae7af8701fb60 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gatsby_ssl/works/33", "thumbnail_src": "https://si.imgix.net/a33939d6/uploads/origins/d79a2058-47c5-4ece-b250-826a4d232c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4207d1a30fe1b1d5a918bc3a3ecb45b9", "thumbnail_srcset": "https://si.imgix.net/a33939d6/uploads/origins/d79a2058-47c5-4ece-b250-826a4d232c2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4207d1a30fe1b1d5a9