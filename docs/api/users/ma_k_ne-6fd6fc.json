8d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e88c9909a676aef43524b675da257fc", "thumbnail_srcset": "https://si.imgix.net/c601766e/uploads/origins/c61ac2fc-8360-4c45-a007-55216b6138d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e88c9909a676aef43524b675da257fc, https://si.imgix.net/c601766e/uploads/origins/c61ac2fc-8360-4c45-a007-55216b6138d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bfcf6321203452b8ab58e7f32a7ed37 2x, https://si.imgix.net/c601766e/uploads/origins/c61ac2fc-8360-4c45-a007-55216b6138d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60d251aef78df6e86414e817d76e6919 3x", "genre": "art", "nsfw": false, "body": "霧雨魔理沙が流砂に裸足で沈むシークエンスは大丈夫だろうか？\nhttps://danbooru.donmai.us/posts/5838463?q=jill_07km+\n素足で泥に沈んでいる写真、腰まで浸かっている写真、目まで浸かって見ている写真など、6～8枚くらいでしょうか？よろしくお願いします。\n\nhttps://danbooru.donmai.us/posts/5838463?q=jill_07km+", "created_at": "", "completed_at": ""}, {"path": "/@ma_k_ne/works/33", "thumbnail_src": "https://si.imgix.net/dff0ba38/uploads/origins/299dde22-82ac-4a4a-8c11-dce15dc9304b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a089ea2ec01be0c53024addccdbf9635", "thumbnail_srcset": "https://si.imgix.net/dff0ba38/uploads/origins/299dde22-82ac-4a4a-8c11-dce15dc9304b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a089ea2ec01be0c53024addccdbf9635, https://si.imgix.net/dff0ba38/uploads/origins/299dde22-82ac-4a4a-8c11-dce15dc9304b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94a47db042b51837083a8b288bbd3701 2x, https://si.imgix.net/dff0ba38/uploads/origins/299dde22-82ac-4a4a-8c11-dce15dc9304b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8769f45b3aa6ecd5b1cde61274ba08d2 3x", "genre": "art", "nsfw": true, "body": "何度もお世話になっています。毎回素晴らしいイラストをありがとうございます。募集を再開したと伺いましたので、またリクエストさせていただきます。\n今回依頼するのは永江衣玖さんの粘着拘束ですが、今回は複数のコマに分けての描写をお願いします。具体的には以下の通りです。\n1コマ目：ピンク色のネバネバを踏んでしまう。\n2コマ目：「あっ!」と言いたげな表情で片手で口を押える。\n3コマ目：そのまま立った状態でネバネバまみれになる。\nこの中で3コマ目をメインとし、1コマ目と2コマ目は小さなコマで描写してください。また、1コマ目は足、2コマ目は顔と手のアップでお願いします。なお、羽衣は省略して構いません。", "created_at": "", "completed_at": ""}, {"path": "/@ma_k_ne/works/32", "thumbnail_src": "https://si.imgix.net/67851365/uploads/origins/007c18f5-340d-4679-9eb2-06cc12231a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=295aa22e0993cdb38a8c791d8277ab62", "thumbnail_srcset": "https://si.imgix.net/67851365/uploads/origins/007c18f5-340d-4679-9eb2-06cc12231a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=295aa22e0993cdb38a8c791d8277ab62, https://si.imgix.net/67851365/uploads/origins/007c18f5-340d-4679-9eb2-06cc12231a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9d2c300e8f54970851694220dc29919 2x, https://si.imgix.net/67851365/uploads/origins/007c18f5-340d-4679-9eb2-06cc12231a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bcfee54e019b08dbd053533b9c5527e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、前のリクエストありがとうございます。\n東方の九十九姊妹の粘着拘束のイラストをお願いします。\n状況は2人の両足をトリモチトラップを踏んで両足の裏をネバネバが粘着拘束されて離れない、ネバネバから足を引き剥がそうと必死な姿をお願い致します。\n粘着液の色は黄色半透明でお願いします。\n\n◯参考\n九十九姊妹\n\n九十九弁々\nhttps://img.altema.jp/lostword/chara/stand/39.jpg\n九十九八橋\nhttps://img.altema.jp/lostword/chara/stand/40.jpg", "created_at": "", "completed_at": ""}, {"path": "/@ma_k_ne/works/31", "thumbnail_src": "https://si.imgix.net/40fb01c2/uploads/origins/4b61a522-2aa6-4c87-a65c-f602721d2b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4988611337abcf39788244a69ed0bb30", "thumbnail_srcset": "https://si.imgix.net/40fb01c2/uploads/origins/4b61a522-2aa6-4c87-a65c-f602721d2b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=F