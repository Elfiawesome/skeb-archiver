M7rC-INb_XUpg-LJn5tkFEjA\n\nhttps://www.evernote.com/shard/s564/sh/de3d53b3-a275-c7c9-22f6-5bcd50d78291/0gIGJ8oHKJzJBcxoxQhjS-EprCHjBZ1zMCM7rC-INb_XUpg-LJn5tkFEjA", "created_at": "", "completed_at": ""}, {"path": "/@_nrt0/works/24", "thumbnail_src": "https://si.imgix.net/bdf56abe/uploads/origins/6987177c-d9a1-4195-9e32-fa682cb41fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51506ea989d5540503d3794b26660a00", "thumbnail_srcset": "https://si.imgix.net/bdf56abe/uploads/origins/6987177c-d9a1-4195-9e32-fa682cb41fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51506ea989d5540503d3794b26660a00, https://si.imgix.net/bdf56abe/uploads/origins/6987177c-d9a1-4195-9e32-fa682cb41fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6771d85e2df21bdc60f6f2fadde47e18 2x, https://si.imgix.net/bdf56abe/uploads/origins/6987177c-d9a1-4195-9e32-fa682cb41fbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75bd2cf1e3e7fa0ae6c115549106f115 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたのイラストがとても好きで、あなたの持っているダークなスタイルが大好きです！\n\n私のキャラクターはクレイジーで狂気じみたフランケンシュタインなので、彼をそう見せる方法なら何でもいいと思います。ポーズについては自由に、一番似合いそうなものを選んでください！下に私の参考画像と、他のアーティストが描いた絵があるので、彼らのスタイルを見たい人は見てみてください！\n服は2着ありますが、参考画像にある「自分の服2」を描いてほしいです！\n\nhttps://drive.google.com/drive/folders/1DQ6VQ2vLz-xrK6kP4Spc77uqVwZk0J7v?usp=drive_link\nhttps://twitter.com/search?q=%23selfshart&src=hashtag_click\n\nhttps://drive.google.com/drive/folders/1DQ6VQ2vLz-xrK6kP4Spc77uqVwZk0J7v?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@_nrt0/works/23", "thumbnail_src": "https://si.imgix.net/16a8892b/uploads/origins/89ba7429-fd97-4e0e-b6b1-de4d9da2c810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04d17a49d605ed64428995c105d80fe3", "thumbnail_srcset": "https://si.imgix.net/16a8892b/uploads/origins/89ba7429-fd97-4e0e-b6b1-de4d9da2c810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04d17a49d605ed64428995c105d80fe3, https://si.imgix.net/16a8892b/uploads/origins/89ba7429-fd97-4e0e-b6b1-de4d9da2c810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ae3e0055e94841fabe2e540789439df 2x, https://si.imgix.net/16a8892b/uploads/origins/89ba7429-fd97-4e0e-b6b1-de4d9da2c810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e1e9064da340dd4b5bfa24d6f97e923 3x", "genre": "art", "nsfw": false, "body": "歌い手の熊子です、今回は相対性理論様の昔の曲「 BATACO 」の歌カバーを作りましてPVも作りたくて、またイラストの依頼で参りました。公開予定などスケジュールも全然決めってないんで、特に締め切りもありません。前回の依頼はSKEB初めての利用なので勝手な連絡や不適切な行動にずっと申し訳なく思っています…なると様の作品が本当に好きで、もし良ければ今回の依頼もご検討させて頂ければ幸いです＞＜\n\n・PV動画用なので構図は横で（１６：９）お願いしたいです。\n\n・イラストの雰囲気かスタイルは原曲のアルバムカバー（参考リンク：https://www.youtube.com/watch?v=H7H2aYcBo4I　と　https://www.youtube.com/watch?v=a_6quQ994JI）に似たようなスケッチブック風がいいと思って、なると様のこの作品にイメージが近いかもしれませんのでここで添付：https://x.com/_nrt0/status/1788839954069815727\n\n・イラストにまた自分のOC「月からの子熊」という少女を含めて欲しいです。設定少々変わりましたけど、髪色・目のは「白」に近い感じになりましたというだけ、そのほか「色白、無口、涙ほくろ、前髪に三日月が浮かぶ、白熊耳(人耳ない)甘い物とお酒好き、大体はいつもパジャマドレスのようなふんわりな白い洋服」などの特徴は変わりがありません。参考だけにしてください。参考画像はリンクに添付しました。\n\nそれ以外全然曲のイメージに合わせてご自由に描いていただければ嬉しいです。お忙しいところ恐縮ですが、何卒、ご検討の程宜しくお願い致します。\nもしご依頼お受け頂ければ嬉しいです><！！楽しみにしています\n\nhttps://drive.google.com/drive/folders/1TJ7yuTgThfYRVMTdLiuFeF634T6wyzjT?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@_nrt0/works/22", "thumbnail_src": "https://si.imgix.net/dc3ae8fe/uploads/origins/32f9acee-65d0-4ead-b26c-3d40de65aea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ca0ccfcdd51165d3aac91a7de5f50d6", "thumbnail_srcset": "https://si.imgix.net/dc3ae8fe/uploads/origins/32f9acee-65d0-4ead-b26c-3d40de65aea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ca0ccfcdd51165d3aac91