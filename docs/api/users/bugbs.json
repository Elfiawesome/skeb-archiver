る生の停止にとどまらず、最後の目的地へと移行する魂の指導と後見も含んでいる。\n\n静謐な水のように、生と死を支配する深遠な力とは裏腹に、不穏な静けさを漂わせる。彼女の存在は静謐であると同時に不吉であり、究極の終末に直面するよう誘惑する磁力で他者を引き寄せる。\n\n構図はご自由にどうぞ！また、彼女の服装もお好きなものをお選びください。\n\nありがとうございました。\n\nhttps://sta.sh/2wf2ok43xmd", "created_at": "", "completed_at": ""}, {"path": "/@bugbs/works/19", "thumbnail_src": "https://si.imgix.net/112926c8/uploads/origins/c624d88a-6bec-41c4-a560-90c4df633dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa5469bb1345ed72b3eba4bc1d6640b8", "thumbnail_srcset": "https://si.imgix.net/112926c8/uploads/origins/c624d88a-6bec-41c4-a560-90c4df633dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa5469bb1345ed72b3eba4bc1d6640b8, https://si.imgix.net/112926c8/uploads/origins/c624d88a-6bec-41c4-a560-90c4df633dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5592c93a12ed2ca30a69d354380600bc 2x, https://si.imgix.net/112926c8/uploads/origins/c624d88a-6bec-41c4-a560-90c4df633dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73b14c7bbefa524b12ff8ca4ad5cd023 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bugbs/works/18", "thumbnail_src": "https://si.imgix.net/b96fc112/uploads/origins/3a0f5cc7-183b-4115-8d0e-5635f46e73ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=959594a61c1f6206f6e50878cec120f3", "thumbnail_srcset": "https://si.imgix.net/b96fc112/uploads/origins/3a0f5cc7-183b-4115-8d0e-5635f46e73ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=959594a61c1f6206f6e50878ce