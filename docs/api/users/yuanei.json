-a3f2-14820804b759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5354cc00fd9ce0b462b5134f9425843a 2x, https://si.imgix.net/d1078da1/uploads/origins/83b1c050-c617-4208-a3f2-14820804b759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7816a53323d785b399e116ea31f0eaeb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuanei/works/212", "thumbnail_src": "https://si.imgix.net/a932be18/uploads/origins/14cab44e-4f6b-4e12-a8d5-3838d4b5f175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1460804da1369c6e9a8cf108a6d5653", "thumbnail_srcset": "https://si.imgix.net/a932be18/uploads/origins/14cab44e-4f6b-4e12-a8d5-3838d4b5f175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1460804da1369c6e9a8cf108a6d5653, https://si.imgix.net/a932be18/uploads/origins/14cab44e-4f6b-4e12-a8d5-3838d4b5f175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=326163f87c1d6201c260b68c249ae9c2 2x, https://si.imgix.net/a932be18/uploads/origins/14cab44e-4f6b-4e12-a8d5-3838d4b5f175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e27660f1dcee1fb29aa223c6baf2901c 3x", "genre": "art", "nsfw": true, "body": "はじめまして！スケブの枠が空いてましたら以下の内容で依頼お願いしてもよろしいですか？ \n●キャラ \n・銀城七海( https://youtu.be/qCW28gKQx5A?si=U9rNFe8Aiagh7OIL\n・紫咲由梨香( https://youtu.be/R93iwnfnKgU?si=mSaPLUSquBeEPKLv\n(オメガラビリンスライフ)\nhttps://drive.google.com/drive/folders/1JfLoOo3_bBJ-C739zDf2ahHCkanpKtxs\n\n●シチュエーション \n・膨乳トラップにより、おっぱいが超乳に膨らまされた。Zカップ以上あるバストにされ、バランスボールよりもふた周りも大きいサイズ。(膝下まで届く感じだと嬉しいです)\n( https://drive.google.com/file/d/1TAZvu_FIYnWOx6gFri8u0jcPKO7YM5zI/view?usp=drivesdk\n・脱衣トラップにより、パンツ一枚になっている。\n( https://skeb.jp/@yuanei/works/191 )\n・慌てて胸を隠そうとするも乳首まで手が届かず下から持ち上げるような形になっている。\n●ポーズ　\n・必死に胸と股間を隠しているものの、豊満すぎる胸が逆に強調されてしまっている。乳首露出しています。\n・2人とも特大サイズのバストにされて重たそうにしていると嬉しいです。\n ●その他 \n・可能でしたら太もも迄描いてくださると嬉しいです。  \n・URLに細かいポーズや希望するおっぱいのサイズなど載せてありますので参考にしてください。\n\n以上となります。上記以外はお任せしますので検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/10FspnnTk5ML03lU43H7DxNdovqzKKd5H\n\nhttps://drive.google.com/drive/folders/10FspnnTk5ML03lU43H7DxNdovqzKKd5H", "created_at": "", "completed_at": ""}]}