8f1-8637-88a6c3a27079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abcfda9d6546dacaa3e7aa8f4da7b212 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shiki1206_rough/works/6", "thumbnail_src": "https://si.imgix.net/66962ec4/uploads/origins/88f1137e-83e9-441c-b20b-43e0008a0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e7e16d033716e1325d3b03a13d319f2", "thumbnail_srcset": "https://si.imgix.net/66962ec4/uploads/origins/88f1137e-83e9-441c-b20b-43e0008a0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e7e16d033716e1325d3b03a13d319f2, https://si.imgix.net/66962ec4/uploads/origins/88f1137e-83e9-441c-b20b-43e0008a0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96e3b6a93aa23539cccee333040a15cc 2x, https://si.imgix.net/66962ec4/uploads/origins/88f1137e-83e9-441c-b20b-43e0008a0b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86107a71037120b61281d15da9a64fdd 3x", "genre": "art", "nsfw": false, "body": "はじめまして。資料内にあるうちのオリキャラのイラストお願いしたいです。\n\n褐色で狼の獣人な踊り子の女の子です。\n内容は明るくもセクシーな雰囲気を醸し出してダンスっぽい動きをしているイメージでお任せします。\n描写的に問題ない範囲で可愛らしくもセクシーな感じに希望。\n場所のシチュエーションは夜の砂漠の街中or酒場をイメージしています。（イメージなのでとくに背景なしでもokです）\n\nhttps://ibb.co/6cjYWFYn\nhttps://ibb.co/album/xmPJsp", "created_at": "", "completed_at": ""}, {"path": "/@shiki1206_rough/works/5", "thumbnail_src": "https://si.imgix.net/60c84f9b/uploads/origins/ec4f68da-55d5-4f91-830f-7fe51415783d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6e847c5ffb355eb550ce98b0453daf7", "thumbnail_srcset": "https://si.imgix.net/60c84f9b/uploads/origins/ec4f68da-55d5-4f91-830f-7fe51415783d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6e847c5ffb355eb550ce98b0453daf7, https://si.imgix.net/60c84f9b/uploads/origins/ec4f68da-55d5-4f91-830f-7fe51415783d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f1ab6ac74ee7ff3185e588df6dd168f 2x, https://si.imgix.net/60c84f9b/uploads/origins/ec4f68da-55d5-4f91-830f-7fe51415783d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a234f72ac0933e7a64069300ae8b7347 3x", "genre": "art", "nsfw": false, "body": "お世話になります。\n\n初めまして、Youtubeでゲーム実況をしている村崎カインと申します。\nXで偶然ポストをお見掛けしましたので、依頼させていただきました。\nとても素晴らしく、好みの絵柄なので、ぜひとも自分を描いていただきたいと考えております。\n\n■依頼内容\n私、「村崎カイン」を描いていただきたいです。\n参考：https://x.com/Cain_Murasaki/status/1805256920443535384\nツリーにある、顔の戦化粧なし、紫色の白黒目のイラストを参考にしてください。\n服の詳細などはツリー上部にあります。\n\n■構図など\n基本的にすべておまかせします。\nキャラクター設定は毒使いの悪の女幹部。でも、すぐに負けちゃうポンコツ。\nといった感じです。ご参考までに。\n\n■受け取り形式\npngでキャラクター透過でお願いします。\n背景がある場合は2ファイルに分けていただけると幸いです。\n\n■使用用途\nSNSやYoutubeのサムネイルや動画内での使用を考えております。\n\n以上となります。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@shiki1206_rough/works/4", "thumbnail_src": "https://si.imgix.net/59427db7/uploads/origins/f8e2ca20-0953-4320-b915-a407361016bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42df8852b0264840176b03fa4bc30c00", "thumbnail_srcset": "https://si.imgix.net/59427db7/uploads/origins/f8e2ca20-0953-4320-b915-a407361016bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42df8852b0264840176b03fa4bc30c00, https://si.imgix.net/59427db7/uploads/origins/f8e2ca20-0953-4320-b915-a407361016bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cf9e42ca3787fc4b93f502244cdbe0b 2x, https://si.imgix.net/59427db7/uploads/origins/f8e2ca20-0953-4320-b915-a407361016bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0da968930bbc2e2c943f87dbdaf0e0bd 3x", "genre": "art", "nsfw": false, "body": "いつも応援しております🌈\n以下依頼内容です✨️\n\nキャラクターは奈奈でお願いします。\nシーンは私服→部屋着等に着替えようとしているシーンをお願いしたいです。\n\n･服装は下はスカート系のもので、それ以外は椎木先生の感性におまかせします。\n\n･脱ぎかけなので下着が見えていると嬉しい(全部丸見えにはしないでください)\n\n･表情は恥ずかしいけど見られるのは嫌じゃない…というイメージでお願いします。\n(びっくり系、ショックを受けてるはNG)\n\n今回余力があれば以下2つを含んだ差分をお願いしたいです。報酬や負荷と相談しながら椎木先生の方でご判断をお願いします。\n①より恥ずかしがっている表情＋頬を赤らめる\n②更に着崩している(脱いでいる)状態\n\n以上です。よろしくお願いします🙇‍♀️", "created_at": "", "completed_at": ""}, {"path": "/@shiki1206_rough/works/3", "thumbnail_src": "https://si.imgix.net/180de24f/uploads/origins/586681c3-5ff4-427a-82f5-b16fa07a3385?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5221f198495594e505c2c128a885a42f", "thumbnail_srcset": "https://si.imgix.net/180de24f/uploads/origins/586681c3-5ff4-427a-82f5-b16fa07a3385?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5221f198495594e505c2c128a885a42f, https://si.imgix.net/180de24f/uploads/origins/586681c3-5ff4-427a-82f5-b16fa07a3385?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1101c845d876e0e867c4be5567c8ae3 2x, https://si.imgix.net/180de24f/uploads/origins/586681c3-5ff4-427a-82f5-b16fa07a3385?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10af14df80a5b08baa0dfc2fb2e0329a 3x", "genre": "art", "nsfw": false, "body": "初めまして！朝弱い奈奈ちゃん見て良いなぁと思い、依頼させて頂きました🌈\n\nキャラクターは奈奈ちゃんでお願いします！\n部屋着でPCを使い仕事をしていた所(奈奈が)、自分が帰ってきて｢おかえり｣と言っているような構図をイメージしてます。\n\n半身でこちらを向いていて、表情はほんのり笑顔でお願いします。\n可能であればメガネ有り無し差分が見たいです！\n\n本人以外の描写ですが、机の上に紅茶か何か置いてあると嬉しいです(カップは極端に豪華な装飾でなければ何でもOK)\n背景･PC･家具のデザインはお任せします\n\n以上になります！よろしくお願いします🙏", "created_at": "", "completed_at": ""}, {"path": "/@shiki1206_rough/works/2", "thumbnail_src": "https://si.imgix.net/31561bbb/uploads/origins/a3913534-c462-4dd8-8bf1-6f6b04ef8aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c0963f88dd5c2b0ee6514e52aa851433", "thumbnail_srcset": "https://si.imgix.net/31561bbb/uploads/origins/a3913534-c462-4dd8-8bf1-6f6b04ef8aa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtc