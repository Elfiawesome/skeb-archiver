23efe6-fced-495e-8929-1323c4187ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79e94268c20cdeb26ba1d560a5b5ddcf", "thumbnail_srcset": "https://si.imgix.net/a6f0f83b/uploads/origins/fc23efe6-fced-495e-8929-1323c4187ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79e94268c20cdeb26ba1d560a5b5ddcf, https://si.imgix.net/a6f0f83b/uploads/origins/fc23efe6-fced-495e-8929-1323c4187ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1704cfa168001be4e345140580370631 2x, https://si.imgix.net/a6f0f83b/uploads/origins/fc23efe6-fced-495e-8929-1323c4187ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a3ba96926e13ef31fcc1e637130a2b6 3x", "genre": "art", "nsfw": true, "body": "・キャラ\n久々利トモ(ドルフィンウェーブ)\n\n・おおまかな流れ\nトモのマネージャーを辞めようと思ってるコーチを引き留めるためにパイズリの刑を実行する\n↓\nコーチがいつもトモの胸をチラ見してることに本人は気付いており、「こんなことしてあげられるのは\nトモちんだけだよ？本当に辞めちゃってもいいの？」と必死でアピールする\n↓\nパイズリ射精後は「どう？トモちんのパイズリは気持ちよかったでしょ？マネージャーの件、考え直してくれた？」\n↓\n選択肢「実はあれは冗談で・・・」\n↓\n「もう！心配して損しちゃったじゃん！こうなったら２度と辞めるって言えなくなるよう搾り取るからね！」怒りのパイズリ２回戦\nEND\n\n可能なら1枚目に「コーチちゃん！次、トモちんのマネージャー辞めるって言ったらコレだからね！(パイズリのジェスチャー)」があると助かります\n\n※台詞(「」内のテキスト)はあくまでイメージなので合わないと感じたら好きに改変して下さい", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/43", "thumbnail_src": "https://si.imgix.net/73d9b711/uploads/origins/e2d23a3b-c696-4fc4-8e25-779a563338dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80fa9f5ebe3570f180d4e94d8f1e6d56", "thumbnail_srcset": "https://si.imgix.net/73d9b711/uploads/origins/e2d23a3b-c696-4fc4-8e25-779a563338dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80fa9f5ebe3570f180d4e94d8f1e6d56, https://si.imgix.net/73d9b711/uploads/origins/e2d23a3b-c696-4fc4-8e25-779a563338dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef6f1b193e0033201e81f80cb2fa9a6b 2x, https://si.imgix.net/73d9b711/uploads/origins/e2d23a3b-c696-4fc4-8e25-779a563338dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c8b362b1b27ca7241f396263bbabc23 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n今回もプリコネからリクエストさせて頂きます。\n\nキャラ：クローチェ（エアリアル）\nどのくらい脱がせるかは今回もお任せします。\n\nシチュ：\n機械拘束…からの洗脳セクサロイド化\n\n流れとしては、\nエネルギー切れになったところを狙われて捕まってしまい、\n以前描かれていたビルドダイバーズのメイのように拘束され、\n腹部にレーザーでバーコードor淫紋を刻まれ洗脳完了。\n\n「セクサロイド・クローチェ、いつでもご主人様に──」\nといった感じでニコニコで男性器を受け入れ、射精され、\nやがてボテ腹になり「えへへぇ…繁殖機能も順調に動作しています、ご主人様ぁ…♡」\nといった感じになる…\n大まかにはこんな流れでお願いします。\n\n\n今回も検討頂ければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/42", "thumbnail_src": "https://si.imgix.net/00ab975c/uploads/origins/780308a3-0d6c-4cee-967b-6fe040bc6658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0daab84a31de1c9215b416eb7913180", "thumbnail_srcset": "https://si.imgix.net/00ab975c/uploads/origins/780308a3-0d6c-4cee-967b-6fe040bc6658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0daab84a31de1c9215b416eb7913180, https://si.imgix.net/00ab975c/uploads/origins/780308a3-0d6c-4cee-967b-6fe040bc6658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7317cd92cc6e6055a26b62f80f247d4 2x, https://si.imgix.net/00ab975c/uploads/origins/780308a3-0d6c-4cee-967b-6fe040bc6658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb43b5ba286ef79b5b7ab14ce6e17d94 3x", "genre": "art", "nsfw": true, "body": "もしよろしければ、こちらの内容もリクエストさせてください。\n\nドルフィンウェーブの咲宮小針。\n紫苑や入華も自分の女にした竿役が引き続き小針も手に入れる。\n催眠凌辱シチュで無理矢理竿役の事を好きになるように催眠してセックスしている様子。\n大好きな入華と同じような存在になることで幸せになるように催眠されている。\n入華が崇める男を御主人様と呼ぶ事で幸せの絶頂を感じる。\n体位は先生の作品のこちらのような背面駅弁です。\nhttps://www.pixiv.net/artworks/127889175", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/41", "thumbnail_src": "https://si.imgix.net/319f9881/uploads/origins/4b927aad-afb2-4972-8bde-4aed6916435e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e243d887136c61e5d68a4b3d839cead4", "thumbnail_srcset": "https://si.imgix.net/319f9881/uploads/origins/4b927aad-afb2-4972-8bde-4aed6916435e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e243d887136c61e5d68a4b3d839cead4, https://si.imgix.net/319f9881/uploads/origins/4b927aad-afb2-4972-8bde-4aed6916435e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89baa86a4f9c74be21e5327ac31d62f1 2x, https://si.imgix.net/319f9881/uploads/origins/4b927aad-afb2-4972-8bde-4aed6916435e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51626f72ce1215b1b4c1f3eec2db342e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/40", "thumbnail_src": "https://si.imgix.net/758823a0/uploads/origins/c5bd5746-0ccb-4cde-8855-b93ccaeec3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a0cc082e06509f98d86d77f5a1dbaf", "thumbnail_srcset": "https://si.imgix.net/758823a0/uploads/origins/c5bd5746-0ccb-4cde-8855-b93ccaeec3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a0cc082e06509f98d86d77f5a1dbaf, https://si.imgix.net/758823a0/uploads/origins/c5bd5746-0ccb-4cde-8855-b93ccaeec3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40dd6019116ed8f4f38459181d855ad6 2x, https://si.imgix.net/758823a0/uploads/origins/c5bd5746-0ccb-4cde-8855-b93ccaeec3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bf15ecba2a4bc7c3ad7f645d40cbdc6 3x", "genre": "art", "nsfw": true, "body": "ロリシルトの触手ボロス凌辱をお願いします\n具体的には前の触手美海の後ろにいたシルトにフォーカス当てた感じの触手姦お願いします\nアヘイキ、闇堕ち、ボテ差分があると嬉しいです\n\nそれ以外の指定は特にないので、ロリ凌辱ボロス成分を補給したい時にでもお願いしますの", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/39", "thumbnail_src": "https://si.imgix.net/8040035e/uploads/origins/7236d551-1c60-4594-8d94-56a27c754293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b49e0982b580eddd4fd799e5697099f5", "thumbnail_srcset": "https://si.imgix.net/8040035e/uploads/origins/7236d551-1c60-4594-8d94-56a27c754293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b49e0982b580eddd4fd799e5697099f5, https://si.imgix.net/8040035e/uploads/origins/7236d551-1c60-4594-8d94-56a27c754293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3e4310c692d306bdd603eba93d74b03 2x, https://si.imgix.net/8040035e/uploads/origins/7236d551-1c60-4594-8d94-56a27c754293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eabaebd2432c7b60a519177ddce598ab 3x", "genre": "art", "nsfw": true, "body": "匿名依頼失礼します。\n【キャラ】キミプリの『咲良はもり』\n【内容】本編3話で怪物の素体にされてしまったはもりちゃん。怪物の体内にいる間に、ちっぱいやアソコ、全身に触手凌辱を受けているといったイラストをお願いします。\n・触手は太目の粘液まみれを希望します。\n・上半身の黄色い服は触手で破かれてorたくし上げられてちっぱいがみえるように。下の服は脱がしてしまってかまいません。\n・以下差分お願いします。\n1. 触手挿入前。触手に捕らわれて身動き取れない状態。口や局部に迫る触手の他、周りを多くの触手が取り囲む。\n2. 触手挿入。口と女性器に挿入。\n3. 触手ピストン中。\n4. 全部の触手から一斉に白濁液を放出、膣出し・口内発射の他、顔中心に全身に黄ばんだ濃厚白濁液を大量ぶっかけ。\n5. 全身ぶっかけ後のドロドロ状態。膣や口から触手が引き抜かれ、ドロっと白濁液が垂れる。\n・参考URLのような本編テロップ風で、怯えたり抵抗するも感じてイっちゃうはもりちゃんのセリフや心の声、凌辱を主導するザックリーのセリフも入れてください。\n細かい構図などはお任せします、ご検討よろしくお願いします！\n\nhttps://www.pixiv.net/artworks/126844180", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/38", "thumbnail_src": "https://si.imgix.net/f0793b04/uploads/origins/c1531b92-b275-472f-a15c-55915bf17824?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7734eb9065113ea40babf5083d697e73", "thumbnail_srcset": "https://si.imgix.net/f0793b04/uploads/origins/c1531b92-b275-472f-a15c-55915bf17824?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7734eb9065113ea40babf5083d697e73, https://si.imgix.net/f0793b04/uploads/origins/c1531b92-b275-472f-a15c-55915bf17824?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f4d28c1b79cbe554888470bc0d8589 2x, https://si.imgix.net/f0793b04/uploads/origins/c1531b92-b275-472f-a15c-55915bf17824?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66a96925acc8b8db2290a44390467485 3x", "genre": "art", "nsfw": true, "body": "もし宜しければ、こちらもご一考ください。\n\nドルフィンウェーブの咲宮入華\n紫苑を手に入れた竿役が入華も自分の女にしようとしているシチュです。\n催眠凌辱シチュで無理矢理竿役の事を好きになるように催眠してセックスしている様子。\n紫苑と同様にすぐそばに生徒手帳を置いて、全裸の入華と正常位セックス。\n構図としては竿役が入華のおっぱいを揉みながらちんぽでおまんこを責めたてる。\nおっぱいとおまんこの両方から快楽を覚えさせ、何度も膣内射精をする。\nお腹を満たす事で入華は幸せに感じるようにされており、恋心も身体も竿役に捧げるよに誓わせる。", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/37", "thumbnail_src": "https://si.imgix.net/a4b5da3c/uploads/origins/166c1c05-1a44-4878-9a5b-dc7e144799bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c212852ca291ba395cb14e3eb2418e0a", "thumbnail_srcset": "https://si.imgix.net/a4b5da3c/uploads/origins/166c1c05-1a44-4878-9a5b-dc7e144799bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c212852ca291ba395cb14e3eb2418e0a, https://si.imgix.net/a4b5da3c/uploads/origins/166c1c05-1a44-4878-9a5b-dc7e144799bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa2a2f81c1844fa37d04156641670a8e 2x, https://si.imgix.net/a4b5da3c/uploads/origins/166c1c05-1a44-4878-9a5b-dc7e144799bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81450526263e6a2e8b268a932e19ce57 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております\n新しくリクエストを送らせていただきます\n\nキャラ：アネモネ（プリコネ）\n\n恰好：全裸\n\nシチュ：\n異種姦孕ませ\n竿役はゴブリンロード・ツインピッグス・ノイジーオークの中からお好きなものを選んで下さい\n\n彼女が持つ花の力が効かない魔物に敗北し連れ去られ\n「そんなの、入るワケ…」と抵抗と怯えを見せるが、拘束された身ではどうする事も出来ず\nそのまま魔物の孕み袋に…といった感じ\n\n以前描かれていたイオ×ゴブリンや\n他者の作品になりますが\nhttps://www.pixiv.net/artworks/124024500\nこちら等のように、竿役の魔物本体があまり映ってない構図で問題ありません\n\nまたボテ腹差分では、腹部に淫紋・もしくは孕み袋の証として魔物の顔の印か、そのどちらかをつけて欲しいのと\n（後者の参考の一例は資料用に）\n\n以前描いて頂いたプレシアのように目の色を変えつつ、\n参考URLで用いられている混乱エフェクトを浮かべてくれると非常にありがたいです\n（邪魔になりそうならエフェクトはなくても可）\n\n今回も注文が多くなってしまいましたが、検討頂ければ幸いです。\n\nhttps://www.pixiv.net/artworks/94484410", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/36", "thumbnail_src": "https://si.imgix.net/f0fa884f/uploads/origins/58b87667-575e-4e7e-962d-fb07901f1a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2f82123ef619929d27743e650174955", "thumbnail_srcset": "https://si.imgix.net/f0fa884f/uploads/origins/58b87667-575e-4e7e-962d-fb07901f1a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2f82123ef619929d27743e650174955, https://si.imgix.net/f0fa884f/uploads/origins/58b87667-575e-4e7e-962d-fb07901f1a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=741c647558d8ee63b94e856b2005023f 2x, https://si.imgix.net/f0fa884f/uploads/origins/58b87667-575e-4e7e-962d-fb07901f1a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f314a9d68c9376d8f7864a5424ee2f35 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@cx9KA8pPDtoW5a1/works/35", "thumbnail_src": "https://si.imgix.net/dc840b3e/uploads/origins/ac174fd7-a7e6-4b98-9657-abe7b7288dca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21877315e81f9c6de7f511e4b2269726", "thumbnail_srcset": "https://si.imgix.net/dc840b3e/uploads/origins/ac174fd7-a7e6-4b98-9657-abe7b72