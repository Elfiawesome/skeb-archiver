a30d-179c4f7bc8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=278577e8b03d5bd84e021b0c89cced12 3x", "genre": "art", "nsfw": true, "body": "あなたの絵が大好きです！私のキャラクターを描いてください。スイカ柄のビキニに注目してください。\n\n今までのイラストのように、騎乗位で男の上に乗っているイラストが見たいです。\nhttps://skeb.jp/@be9459/works/52\nビーチでの彼女のシーンを描いてください。\n水着を着た状態と着ていない状態のバリエーションもお願いします。\n\nhttps://drive.google.com/drive/folders/12fAz7uaPYPqx-WatxmKcPM29sdOnbzR5?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@be9459/works/54", "thumbnail_src": "https://si.imgix.net/ca52c668/uploads/origins/e3fe3a4a-c97c-446b-ad35-b75d866fcc10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5204500764eb68fc7fabf4493ab79570", "thumbnail_srcset": "https://si.imgix.net/ca52c668/uploads/origins/e3fe3a4a-c97c-446b-ad35-b75d866fcc10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5204500764eb68fc7fabf4493ab79570, https://si.imgix.net/ca52c668/uploads/origins/e3fe3a4a-c97c-446b-ad35-b75d866fcc10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b4431ab621be0873b9774271a6253fa 2x, https://si.imgix.net/ca52c668/uploads/origins/e3fe3a4a-c97c-446b-ad35-b75d866fcc10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35f1cfaf7c7369b5d0e03817f62f8538 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！前回していただいたことが大好きで、またお願いしたいと思いました！\n\n私のVtuberのデジを描いて欲しいです。今回はどのように描くかはお任せします！どんなポーズやシチュエーションでも構いません！\n\nよろしくお願いします！\n\nhttps://i.imgur.com/UwiCQyn.png", "created_at": "", "completed_at": ""}, {"path": "/@be9459/works/53", "thumbnail_src": "https://si.imgix.net/9509c86d/uploads/origins/198938d9-ef42-48fb-9ad6-6b2f4f44cb86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b927ea0614b90bfe0527f8372db955e", "thumbnail_srcset": "https://si.imgix.net/9509c86d/uploads/origins/198938d9-ef42-48fb-9ad6-6b2f4f44cb86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b927ea0614b90bfe0527f8372db955e, https://si.imgix.net/9509c86d/uploads/origins/198938d9-ef42-48fb-9ad6-6b2f4f44cb86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ada26b3e641da7f24f2fd5db9360a8b6 2x, https://si.imgix.net/9509c86d/uploads/origins/198938d9-ef42-48fb-9ad6-6b2f4f44cb86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90bb059bb95592f8ab523209cbe2d413 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@be9459/works/52", "thumbnail_src": "https://si.imgix.net/152c611b/uploads/origins/a99799ae-87af-4bd2-a1cf-7a4aad621591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcf588fc370c21586413bd836c270b2", "thumbnail_srcset": "https://si.imgix.net/152c611b/uploads/origins/a99799ae-87af-4bd2-a1cf-7a4aad621591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcf588fc370c21586413bd836c270b2, https://si.imgix.net/152c611b/uploads/origins/a99799ae-87af-4bd2-a1cf-7a4aad621591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64dd5e27fc879d391c93ce2ac903cd25 2x, https://si.imgix.net/152c611b/uploads/origins/a99799ae-87af-4bd2-a1cf-7a4aad621591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc7d0500fbaf7567c4cd6d98cd807e66 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n 以前よりイラストを拝見してまして、絵柄が大好きなので、キャラクターを描いていただきたくリクエストを送らせていただきました。\n今回依頼させていただきたいのは「ユリシーズ ジャンヌ・ダルクと錬金の騎士」に登場するシャルロットというキャラクターです。\n \n 資料は公式サイトを参考にしていただければと思います\n \n 構図、シチュエーションとしては公式特典イラストの水色のマイクロビキニ衣装で女性優位での騎乗位、差分で全裸、射精差分をお願いしたいです。\n胸を強調した構図にして頂けると有り難いです。\n\n \n 内容が合わなければキャンセルしていただいて大丈夫です。\n お忙しい中恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://ulysses-anime.jp/sp/bd/tokuten.php\n\nhttps://ulysses-anime.jp/sp/", "created_at": "", "completed_at": ""}, {"path": "/@be9459/works/51", "thumbnail_src": "https://si.imgix.net/61c23fcf/uploads/origins/537bc54f-d6f7-4899-bd02-e1e5fc022dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f371c12dbff1999e208ae8e6836aec50", "thumbnail_srcset": "https://si.imgix.net/61c23fcf/uploads/origins/537bc54f-d6f7-4899-bd02-e1e5fc022dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f371c12dbff1999e208ae8e6836aec50, https://si.imgix.net/61c23fcf/uploads/origins/537bc54f-d6f7-4899-bd02-e1e5fc022dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d3086772eae60506c8e1e2af6f0ad98 2x, https://si.imgix.net/61c23fcf/uploads/origins/537bc54f-d6f7-4899-bd02-e1e5fc022dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5028425e2ac908c83a0e301079b53ae9 3x", "genre": "art", "nsfw": true, "body": "前回のリクエストに応えていただき、ありがとうございました！とても楽しかったので、またお願いしたいと思います。\n\nキャラクターファイアーエムブレムifのアズーラ\n\n今回は、立ち担ぎを希望します。その他、詳細はお任せします。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/128Env6Vu36d-pcrU1d1VVHveWFBPV4g_", "created_at": "", "completed_at": ""}, {"path": "/@be9459/works/50", "thumbnail_src": "https://si.imgix.net/316e4fbe/uploads/origins/567818b6-480c-4878-9aa3-2f57f63baeee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c4c10425c791911bb77e7c87f59fbe9", "thumbnail_srcset": "https://si.imgix.net/316e4fbe/uploads/origins/567818b6-480c-4878-9aa3-2f57f63baeee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c4c10425c791911bb77e7c87f59fbe9, https://si.imgix.net