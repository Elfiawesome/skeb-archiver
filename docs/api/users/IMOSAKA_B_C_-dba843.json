ロさとパイズリが好きなので是非「音で」聞ければと思います。\n\n↑のは要望ではないです、言わされてる感でなく自由奔放に「真奈美ちゃん」を演じてくれればそれが一番「生きて」いるのだと思います。\n演者の域を越えて独り歩きしてくれたら嬉しいです。\n色々書きましたがいつも通りの「真奈美ちゃん」を音にしてもらえればという想いです。\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@IMOSAKA_B_C_/works/93", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1770311850271662080%2FpWFoL0TF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be4a0266d5959aa4b63b11c6628ff251", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1770311850271662080%2FpWFoL0TF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be4a0266d5959aa4b63b11c6628ff251, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1770311850271662080%2FpWFoL0TF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67605c97e1f00625741e0651e0224a14 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1770311850271662080%2FpWFoL0TF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25c9738ba1498c3125529c97c796a9ae 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@IMOSAKA_B_C_/works/92", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1770311850271662080%2FpWFoL0TF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be4a0266d5959aa4b63b11c