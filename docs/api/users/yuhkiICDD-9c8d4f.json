79-4da8-bcf4-87b442533634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2db1eb5a89bb89766e2feee75e75ddd 2x, https://si.imgix.net/720b2989/uploads/origins/e59c439f-c179-4da8-bcf4-87b442533634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0201a1e974f2b86e5877c38bee58f0ae 3x", "genre": "art", "nsfw": true, "body": "お世話になっています。\n\nhttps://www.pixiv.net/artworks/116121602\n前回のこちらの作品がキャラクター、描写とも大変素晴らしかったので今回もまたこの二人で\n体格差ふた×男シチュエーションをお願いできればと思います。\n\n希望は筋肉質なふたなり娘、体格差重視、そしてふたなり娘完全上位のパワーセックスの3点です。\nそれ以外は作品形式含めて全てお任せします。\nモノクロコミック形式でも、カラーイラスト形式でもどちらでも構いません。\n\nご検討いただけると幸いです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yuhkiICDD/works/33", "thumbnail_src": "https://si.imgix.net/805137e0/uploads/origins/1b127ced-d57b-43da-a738-a41030cc38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=355e8dd186c257de55985bfce7ee58db", "thumbnail_srcset": "https://si.imgix.net/805137e0/uploads/origins/1b127ced-d57b-43da-a738-a41030cc38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=355e8dd186c257de55985bfce7ee58db, https://si.imgix.net/805137e0/uploads/origins/1b127ced-d57b-43da-a738-a41030cc38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab4a966f1d22b2d77711fdd3164dfe2a 2x, https://si.imgix.net/805137e0/uploads/origins/1b127ced-d57b-43da-a738-a41030cc38c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d8ac731f578788d53f334dc40f7a008 3x", "genre": "art", "nsfw": true, "body": "初めまして。先生の漫画を見て絵柄が好きになりリクエストいたしました。先生が過去にふたなりを描かれていたこともあり、ふたなりでのリクエストになります。\n\n◯キャラ\n1次創作のJK\nロングヘア、つり目、ギャル、制服姿の要素を満たす形をお願い致します。\n※制服についてはスカートのみ資料URLのようなボックスプリーツの形状で描いていただきたいです。制服の形はブレザーになります。色に指定はございません。\n※ふたなりですが、玉無しを希望します。またパイパンになります。\n\n◯シチュエーション\nムラムラした彼女が制服のスカートで自分のTNTNをいじる流れになります。\n①ムラムラしている(まだボッキしていない)\n②スカートテントを立てる。(チンチンは完全にスカートの中)\n③スカートをローションガーゼのようにしてちんちんをこする。\n④スカートの中で大量射精する\n⑤賢者タイム\n\n構図は全身を希望で、それ以外特に指定はございません。\n何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-FSRr9wEoKP5sScCAUdI5r2s1JDAqdBt", "created_at": "", "completed_at": ""}, {"path": "/@yuhkiICDD/works/32", "thumbnail_src": "https://si.imgix.net/708245c0/uploads/origins/ad810cfe-f2c2-4b10-9f92-e5cb5e79f80f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25870b7910d77f77b4c95639c391f34a", "thumbnail_srcset": "https://si.imgix.net/708245c0/uploads/origins/ad810cfe-f2c2-4b10-9f92-e5cb5e79f80f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25870b7910d77f77b4c95639c391f34a, https://si.imgix.net/708245c0/uploads/origins/ad810cfe-f2c2-4b10-9f92-e5cb5e79f80f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a483533143768f6d9c9879a3dca0d1d2 2x, https://si.imgix.net/708245c0/uploads/origins/ad810cfe-f2c2-4b10-9f92-e5cb5e79f80f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1699522b17ea371771d16116520274fb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuhkiICDD/works/31", "thumbnail_src": "https://si.imgix.net/48327e36/uploads/origins/6d37f65d-81ff-4707-843c-75b2670246a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbad4e8bb6dd47d10a9173da41b66e4f", "thumbnail_srcset": "https://si.imgix.net/48327e36/uploads/origins/6d37f65d-81ff-4707-843c-75b2670246a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FF