7899b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c454942f52753e5e6f56ea6c33b55132 2x, https://si.imgix.net/2aa15739/uploads/origins/7a6ac13c-4d73-4f3a-aecc-adaf987899b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9363951623d2332027ed794640851639 3x", "genre": "art", "nsfw": false, "body": "Hello, I really love your art style! I’d really like it if you could draw my character in your style. You can choose the pose and expression. I leave all of the details to you.  Thank you very much!\n\nhttps://drive.google.com/drive/folders/1NK4YdML75uf_D6XYqm2SPfw_hP650Grk?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@z_z__Z_cat/works/32", "thumbnail_src": "https://si.imgix.net/b6b976e1/uploads/origins/ae63b212-b70e-4b2d-9310-06c5c1217c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c358361e155e88acb53332a3f916e8e0", "thumbnail_srcset": "https://si.imgix.net/b6b976e1/uploads/origins/ae63b212-b70e-4b2d-9310-06c5c1217c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c358361e155e88acb53332a3f916e8e0, https://si.imgix.net/b6b976e1/uploads/origins/ae63b212-b70e-4b2d-9310-06c5c1217c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beeba55359e9f5da81d567fe30f5b19d 2x, https://si.imgix.net/b6b976e1/uploads/origins/ae63b212-b70e-4b2d-9310-06c5c1217c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c68241aba57f2a5e0e2eea06184a48a7 3x", "genre": "art", "nsfw": false, "body": "老師您好，我想請你畫我的OC.\n,想請你幫我畫成毛茸茸且胖乎乎可愛的樣子，OC能戴上圓形眼鏡，姿勢的話就交給你了 謝謝！\n\nhttps://drive.google.com/file/d/1FqdxU73oNQ2MgR5jdqzwyvDWcQJoaTW1/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@z_z__Z_cat/works/31", "thumbnail_src": "https://si.imgix.net/1d5fe84b/uploads/origins/694104f1-9f38-4ffc-aae5-59befddd56be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04a63bfa57d6db551e7694ae94792448", "thumbnail_srcset": "https://si.imgix.net/1d5fe84b/uploads/origins/694104f1-9f38-4ffc-aae5-59befddd56be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04a63bfa57d6db551e7694ae94792448, https://si.imgix.net/1d5fe84b/uploads/origins/694104f1-9f38-4ffc-aae5-59befddd56be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b7d6ed785c058c2c1238286a3534aa0 2x, https://si.imgix.net/1d5fe84b/uploads/origins/694104f1-9f38-4ffc-aae5-59befddd56be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2f8348d59cc2e1bc81ea906e334d37c 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは。先生の描くイラストがとても好きです。もし可能であれば、私のオリジナルキャラクター（OC）も描いていただけませんか？彼の名前は旭比（シュウビ）で、ぽっちゃりした白いキツネです。胸のペンダントはエビの形をしています。笑顔で楽しそうな姿を描いていただけると嬉しいです。その他の細かい部分は先生の自由な解釈でお願いします。\n\nhttps://drive.google.com/drive/folders/1yEyxyuGizpQGUDtEgFu_fji1qKwJlW2Y", "created_at": "", "completed_at": ""}, {"path": "/@z_z__Z_cat/works/30", "thumbnail_src": "https://si.imgix.net/4efd7b98/uploads/origins/c2bf33b2-1356-4c77-ae48-fb2f0de31758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3b3ee38a52971d654ac9f3d310c0d92", "thumbnail_srcset": "https://si.imgix.net/4efd7b98/uploads/origins/c2bf33b2-1356-4c77-ae48-fb2f0de31758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3b3ee38a52971d654ac9f3d310c0d92, https://si.imgix.net/4efd7b98/uploads/origins/c2bf33b2-1356-4c77-ae48-fb2f0de31758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a415c855c991b5834e71b65a1a1c6ac 2x, https://si.imgix.net/4efd7b98/uploads/origins/c2bf33b2-1356-4c77-ae48-fb2f0de31758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2ab09e6e42d0a7f7fbeb04a111c3384 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@z_z__Z_cat/works/29", "thumbnail_src": "https://si.imgix.net/b0d13a45/uploads/origins/827f3659-063f-41a8-a3f9-139f935b2720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e9d57bd04a1fe1cbeb5d2d678a77fad", "thumbnail_srcset": "https://si.imgix.net/b0d13a45/uploads/origins/827f3659-063f-41a8-a3f9-139f935b2720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e9d57bd04a1fe1cbeb5d2d678a77fad, https://si.imgix.net/b0d13a45/uploads/origins/827f3659-063f-41a8-a3f9-139f935b2720?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a7bf66d39dad3c12e4a5035f278cad7 2x, https://si.imgix.net/b0d13a45/uploads/origins/827f3659-063f-41a8-a3f9-139f935b2720?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=291a8ca03f8839e0b922a708c960cc23 3x", "genre": "art", "nsfw": false, "body": "ふわふわな可愛いイラストを最近たくさんお見かけしますのでうちの子もふんわり可愛い姿を見てみたいです🙏\n少し模様はややこしいですが、うちの可愛い天使なパンダのルノワール君です。もしよろしければ🙏\n\nhttps://drive.google.com/drive/folders/1XVLuwjhxssAdLUcZSt3w0fz48KYCALAu", "created_at": "", "completed_at": ""}, {"path": "/@z_z__Z_cat/works/28", "thumbnail_src": "https://si.imgix.net/1f0a5732/uploads/origins/c95922c9-41c0-4c7d-9480-a2099c1cb243?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a85124f2b9604fd0a0850eb39cff22b", "thumbnail_srcset": "https://si.imgix.net/1f0a5732/uploads/origins/c95922c9-41c0-4c7d-9480-a2099c1cb243?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a85124f2b9604fd0a0850eb39cff22b, https://si.imgix.net/1f0a5732/uploads/origins/c95922c9-41c0-4c7d-9480-a2099c1cb243?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7089466de4991d667c