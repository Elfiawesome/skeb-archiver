f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f9dc8ad764dcbc52e5e52e75061f68d, https://si.imgix.net/4e7bee8e/uploads/origins/1d8c1339-60c1-454e-a022-597c15775177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b17e96b47a5689bebc23f62c1887c5cd 2x, https://si.imgix.net/4e7bee8e/uploads/origins/1d8c1339-60c1-454e-a022-597c15775177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=624f24a864f1e6676fafcd8fcea608a0 3x", "genre": "art", "nsfw": false, "body": "はじめまして、こんにちは。\n\n10月に推し様（@_Raokun_）のanniversaryがあるので、お祝いに送りたいと思い、リクエストさせていただきました。\n\n16:9の1枚絵でお願いしたいです。\n服装はanniversaryっぽくお祝いされている感じでお願いします。ポーズや背景はおまかせしたいです。\nキャラデザは\n・男性\n・猫耳\n・ほぼ黒に近い茶にえんじの赤メッシュ\n・目は黄色〜オレンジ\n・両八重歯\n・黒の首輪（皮みたいなやつ）\n・黒ネイル\nです。\n「6th anniversary」の文字もお願いします。\n可能であれば文字ありと文字なし、どちらもお願いしたいです。\n\n無理を承知なのですが、予算内でできるイラストをお願いしたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@iyuiyun/works/4", "thumbnail_src": "https://si.imgix.net/90be66bf/uploads/origins/973f6ff4-7982-4f9b-9a3c-cfed9c3fe246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b19e7a9332d0e8c185c8375eecf37a", "thumbnail_srcset": "https://si.imgix.net/90be66bf/uploads/origins/973f6ff4-7982-4f9b-9a3c-cfed9c3fe246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1b19e7a9332d0e8c185c8375eecf37a, https://si.imgix.net/90be66bf/uploads/origins/973f6ff4-7982-4f9b-9a3c-cfed9c3fe246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e4ec93d5f882af5c830aeddf0505d98 2x, https://si.imgix.net/90be66bf/uploads/origins/973f6ff4-7982-4f9b-9a3c-cfed9c3fe246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c618a162ecd4708e9231416162b45dda 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します\nVライバーとして活動している木春きくさん(@KoharuKiku)が9月に誕生日ということなのでイラストを送りたくリクエストさせて頂きました\nポーズ等、こうしてほしいなどは特にはありません\n本当にできれば、無理は承知なのですがスチームパンク系の衣装にして下さるととても有難いです…\nもちろん無理を承知で言っているのでそれでは見合わないということであれば通常衣装で全く問題ないです\nほとんどおまかせになってしまうのですがよろしくお願いします\n長文失礼しました", "created_at": "", "completed_at": ""}, {"path": "/@iyuiyun/works/3", "thumbnail_src": "https://si.imgix.net/f6169085/uploads/origins/ddd770a7-58ef-4e88-8139-8a0a8744c555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=585e212fdf6971f880e7c091c5b68562", "thumbnail_srcset": "https://si.imgix.net/f6169085/uploads/origins/ddd770a7-58ef-4e88-8139-8a0a8744c555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=585e212fdf6971f880e7c091c5b68562, https://si.imgix.net/f6169085/uploads/origins/ddd770a7-58ef-4e88-8139-8a0a8744c555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5b0c9d52e3d4a50a2a2ba6407a0b3db 2x, https://si.imgix.net/f6169085/uploads/origins/ddd770a7-58ef-4e88-8139-8a0a8744c555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a14519831ad5d02cb1fb5659982b4791 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの絵はとても可愛いですね私のvtuberキャラの絵をお願いしたいです好きなポーズで描いてくださいねありがとうございました。\n\nhttps://drive.google.com/file/d/14f4c20OSTDNBwvQvVikAjmt7BYrRPmRz/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@iyuiyun/works/2", "thumbnail_src": "https://si.imgix.net/78a75f81/uploads/origins/b58728de-7e98-476d-bb5f-ef904ffa714a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f674bfd4b4c1737aecd9b7bb793207f8", "thumbnail_srcset": "https://si.imgix.net/78a75f81/uploads/origins/b58728de-7e98-476d-bb5f-ef904ffa714a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f674bfd4b4c1737aecd9b7bb793207f8, https://si.imgix.net/78a75f81/uploads/origins/b58728de-7e98-476d-bb5f-ef904ffa714a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a83c01f8f2c52cdb6744ba889f1adbdc 2x, https://si.imgix.net/78a75f81/uploads/origins/b58728de-7e98-476d-bb5f-ef904ffa714a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dae3b8843aab73d4f86f23ffa81e57bc 3x", "genre": "art", "nsfw": false, "body": "今回は1枚絵イラストを希望してます！\nツイキャスでキャス画としての\n使用を考えておりますので\nサイズは16:9でお願いしたいです。\nコメント表記させるので左右どちらかに\nキャラを寄せてもらえると嬉しいです。\n\n顔 : まる顔童顔\n目 : たれ丸目 ピンク\n(できれば目の中にハート)\n髪型 : ピンクブラウン系の色  \nぱっつん気味流し前髪  ロングウェーブ\n耳上くらいの高さでゆるふわツインテール\n(ピンクor白のリボン髪飾り)\n服装 : ピンクスモック+白スカート\n足が見えるポーズであれば\n白かパステルピンクのニーハイ\n(衣服はリボンやレースなどでデザイン\nお好みでアレンジしてもらいたいです)\nその他 : おしゃぶり *必須*\n･背景どこかにパステルピンクのSwitch\n･うさちゃんの人形、\n･桜型かウサギ型の名札に｢なるせ｣とひらがなで\n描いて胸あたりに付けたいです。\n(上記3つは可能であればで…)\n基本的には過去に\n依頼させていただいた時の\nコテキャラちゃんと同じ感じで大丈夫です！\n身長150cmほどの小柄な女の子で、\n全体的にピンクや白が基調のふわっと\n可愛らしいお部屋でのんびりお話してるようなものを\nイメージしております。\n\n伝わりづらかったらすみません…。\n背景やポーズに詳しく指定ありませんので\n予算内でできるイラストをお願いしたいです！\n特に急ぎではないので、\nぜひよろしくお願いします(❁ᴗ͈ˬᴗ͈)", "created_at": "", "completed_at": ""}, {"path": "/@iyuiyun/works/1", "thumbnail_src": "https://si.imgix.net/adad0737/uploads/origins/7d6024e9-7389-4b50-a256-fe43623c80aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c31d5cf7d8e70eb77924d0ec26164ce", "thumbnail_srcset": "https://si.imgix.net/adad0737/uploads/origins/7d6024e9-7389-4b50-a256-fe43623c80aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c31d5cf7d8e70eb77924d0ec26164ce, https://si.imgix.net/adad0737/uploads/origins/7d6024e9-7389-4b50-a256-fe43623c80aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=548d8edc5e471093f2b8ac5d32755ae7 2x, https://si.imgix.net/adad0737/uploads/origins/7d6024e9-7389-4b50-a256-fe43623c80aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8b37488dcf36a9bc64a204d8aa04cfe 3x", "genre": "art", "nsfw": false, "body": "初めまして、VTuberとして活動しております、大切ねむりと申します。\n素敵なイラストを拝見し是非イラストを描いていただきたいとご連絡させて頂きました。\nhttps://twitter.com/7brg_nemuri/status/1379829436791447554\n\n服装、髪型等はすべてアレンジ頂いて大丈夫です。\n動画サムネ等に使用させて頂ける場合はサイン等はレイヤー分けをお願いしたいです。\nもし不可の場合は統合頂ければSNSのアイコンなどで使用させて頂きたいと考えております。\n\n秋っぽいイラストをお願いできれば幸いです。\nお忙しい中とは存じますがご検討お願い致します。", "created_at": "", "completed_at": ""}]}