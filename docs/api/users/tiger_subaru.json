AQuiomByiWBwSV/view?usp=drive_link\n\nでは、彼を鳥のポケモンと一緒に描いてもらえませんか？例えば、ピードーブ（マメパト）とかダックレット（コヒーアル）とか。\n\n細かいことはあなた次第なので、好きなように描いてください。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1H7fei7bcZfHq1zhRqoOyLGrB7fWaVVsH", "created_at": "", "completed_at": ""}, {"path": "/@tiger_subaru/works/126", "thumbnail_src": "https://si.imgix.net/83c96c56/uploads/origins/d4c19ace-084e-44a1-a0c9-14b6b8163bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7c34169e19405b812c0b35ca87f433b", "thumbnail_srcset": "https://si.imgix.net/83c96c56/uploads/origins/d4c19ace-084e-44a1-a0c9-14b6b8163bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7c34169e19405b812c0b35ca87f433b, https://si.imgix.net/83c96c56/uploads/origins/d4c19ace-084e-44a1-a0c9-14b6b8163bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12d1e765bef98e07c363b7d9a7d3e3a9 2x, https://si.imgix.net/83c96c56/uploads/origins/d4c19ace-084e-44a1-a0c9-14b6b8163bd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5428988b3fef3f0f8aeca3ec314f52e9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tiger_subaru/works/125", "thumbnail_src": "https://si.imgix.net/7b20cbf4/uploads/origins/b1648a81-cea2-4102-a1bc-a9cd80f8e1ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=559ab4d85e89c0194adbd1817ea74292", "thumbnail_srcset": "https://si.imgix.net/7b20cbf4/uploads/origins/b1648a81-cea2-4102-a1