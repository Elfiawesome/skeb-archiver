63-aa9f-e6528abaa2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b85fb216dfbebd14d275de96248f8be", "thumbnail_srcset": "https://si.imgix.net/395e8d41/uploads/origins/a9fdf014-d9d7-4b63-aa9f-e6528abaa2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b85fb216dfbebd14d275de96248f8be, https://si.imgix.net/395e8d41/uploads/origins/a9fdf014-d9d7-4b63-aa9f-e6528abaa2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04d089cc7e531b548f64d280137d132d 2x, https://si.imgix.net/395e8d41/uploads/origins/a9fdf014-d9d7-4b63-aa9f-e6528abaa2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4711c3f5bfb41f2f77ec34ed82be420 3x", "genre": "art", "nsfw": true, "body": "以前よりお世話になっております！\n今回、リクエストしてみたいものがあり、もし受けて貰えたら嬉しいです！\n\nキャラクターは、テイルズオブシンフォニアのコレットちゃんでお願いします。\n\n内容は、猟師に捕らわれたコレットというようなイメージで\n皮なめし台に服やタイツ、下着などがそれぞれの台に並べられ\nコレットはベッドの上で種付けプレスをされているような感じがいいなぁと思います！\n男の人は実体があっても半透明でも透明でもなんでも構いません！\n種付けプレスされるコレット、その窓から見える皮なめし台…\n逆に外に並ぶ皮なめし台、窓から見えるコレットの足のみ…というのでも構いませんっ\n足のみの場合は出来たらアヘ顔？とろ顔？な顔をアップでつけて貰えると嬉しいな～と思ったりしてます\n\nちょっと色々書いてしまって申し訳ないですが、こういうのは出来ますでしょうか？\nう主シさんの好きな風に、好きな感じで描いてもらえれば大丈夫です！\nもし良ければ、是非ともお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@U_nushi/works/3", "thumbnail_src": "https://si.imgix.net/d8a88894/uploads/origins/a705df8e-85f7-4999-99ee-632a9429849a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4dffa459717a9c97185924fcfce73ec", "thumbnail_srcset": "https://si.imgix.net/d8a88894/uploads/origins/a705df8e-85f7-4999-99ee-632a9429849a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4dffa459717a9c97185924fcfce73ec, https://si.imgix.net/d8a88894/uploads/origins/a705df8e-85f7-4999-99ee-632a9429849a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08c820148adfd10b8207c5b07f435a8d 2x, https://si.imgix.net/d8a88894/uploads/origins/a705df8e-85f7-4999-99ee-632a9429849a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b28298d98360fcf7193313e36f241934 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nう主さんのところの神崎陽ちゃんのイラストをお願いします。\nシチュ：モブの男性(主観視点or描写薄めでお願いします)とのいちゃらぶえっち、乳首が見える構図だと嬉しいです\n以上、検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@U_nushi/works/2", "thumbnail_src": "https://si.imgix.net/5ab07100/uploads/origins/a831deb9-0c27-40d4-b93d-a1f7f94e46f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1edb9afb56e233f30ead0e264e40dbaa", "thumbnail_srcset": "https://si.imgix.net/5ab07100/uploads/origins/a831deb9-0c27-40d4-b93d-a1f7f94e46f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1edb9afb56e233f30ead0e264e40dbaa, https://si.imgix.net/5ab07100/uploads/origins/a831deb9-0c27-40d4-b93d-a1f7f94e46f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a024d1189c3a22eea391d431155a0ded 2x, https://si.imgix.net/5ab07100/uploads/origins/a831deb9-0c27-40d4-b93d-a1f7f94e46f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4eac6de29625077ef780cee044c681d1 3x", "genre": "art", "nsfw": true, "body": "バヤルん氏（@bayarun）のとこの憑神計ちゃんのえちちなやつをお願いしたいですー（許可は貰ってます）\n昔色々あって激しい行為じゃないとイケなくなったらしいの散々ヤラれてる感じのをお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@U_nushi/works/1", "thumbnail_src": "https://si.imgix.net/deeb3d18/requests/223854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=808c160d1d4d32ceb315e14807106c2a", "thumbnail_srcset": "https://si.imgix.net/deeb3d18/requests/223854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=808c160d1d4d32ceb315e14807106c2a, https://si.imgix.net/deeb3d18/requests/223854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da1cecb024af685beb97de2c0e008889 2x, https://si.imgix.net/deeb3d18/requests/223854_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&