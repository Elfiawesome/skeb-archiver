1-8add-d58a0b1b8c0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c40a533598e01d8bb257964a57f08b94 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@daihuku_osiri/works/30", "thumbnail_src": "https://si.imgix.net/f23894c3/uploads/origins/85bf06bc-933d-4300-b284-4fd10d72520e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2216434e8672289fa46ae7c03cc10e8", "thumbnail_srcset": "https://si.imgix.net/f23894c3/uploads/origins/85bf06bc-933d-4300-b284-4fd10d72520e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2216434e8672289fa46ae7c03cc10e8, https://si.imgix.net/f23894c3/uploads/origins/85bf06bc-933d-4300-b284-4fd10d72520e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45b56c7ee047f03d0d048e1382a14732 2x, https://si.imgix.net/f23894c3/uploads/origins/85bf06bc-933d-4300-b284-4fd10d72520e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f234113843beb0e5d4249735d3e4086c 3x", "genre": "comic", "nsfw": false, "body": "初めまして、吾妻大福さん。「2MDKシェアハウス」を見てあなたのことを知りました。リクエストなんですけど、\n　褐色肌の筋肉質な男性が失恋してしまい、その絶望を引きずったままヤケ食いをして生活していたら太ってしまった。\n　新しくできた彼氏のおかげでトラウマを克服して、幸せで満たされたことで、さらに太り服がキツキツになったりズボンが中々入らなかったりチャックが閉めづらかったり、歩くのが億劫になったが、彼氏は増量し脂肪に包まれ大きくなった彼をヨギボーのように使用し、そして彼も自分に身を預ける彼氏をお腹を含めた全身で感じ、お互い興奮する。\nという漫画を描いてほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@daihuku_osiri/works/29", "thumbnail_src": "https://si.imgix.net/120b160d/uploads/origins/ac73529f-690b-48ff-a174-ecaa41b726bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f464af26230d4f647ee134934b01d4", "thumbnail_srcset": "https://si.imgix.net/120b160d/uploads/origins/ac73529f-690b-48ff-a174-ecaa41b726bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f464af26230d4f647ee134934b01d4, https://si.imgix.net/120b160d/uploads/origins/ac73529f-690b-48ff-a174-ecaa41b726bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4d9ce3a5abfa0198f4cbd5f502622dc 2x, https://si.imgix.net/120b160d/uploads/origins/ac73529f-690b-48ff-a174-ecaa41b726bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17fd605e4f9561758c8ae052b5d526b8 3x", "genre": "art", "nsfw": false, "body": "そこで、辰巳と樽の楽しいやりとりをお願いしたい。辰巳と樽がぽっこりお腹を比べている。互いのお腹を押し付け合う。タタルは「こっちの方がいい」と言い、タツミは「こっちの方がいい」と言う。", "created_at": "", "completed_at": ""}, {"path": "/@daihuku_osiri/works/28", "thumbnail_src": "https://si.imgix.net/51b18d7b/uploads/origins/b27c8f90-4909-42e8-bb0f-e08c795f5f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e5366a1678afb778a4f659e6dc98a52", "thumbnail_srcset": "https://si.imgix.net/51b18d7b/uploads/origins/b27c8f90-4909-42e8-bb0f-e08c795f5f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e5366a1678afb778a4f659e6dc98a52, https://si.imgix.net/51b18d7b/uploads/origins/b27c8f90-4909-42e8-bb0f-e08c795f5f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d35062a45a273ac8d229a0e31493a40 2x, https://si.imgix.net/51b18d7b/uploads/origins/b27c8f90-4909-42e8-bb0f-e08c795f5f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c166594974b2e92688d48344df0e9e49 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@daihuku_osiri/works/27", "thumbnail_src": "https://si.imgix.net/5f1f8c6f/uploads/origins/933c86a3-2204-412e-