d1-b8153cceaf2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f50e7f83bffbe350f14bdd0309c68a71, https://si.imgix.net/5aacc6f6/uploads/origins/959a10a3-84d9-4bd2-b3d1-b8153cceaf2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a6c5b3ae612f3b02aaae6c3bc7b37bb 2x, https://si.imgix.net/5aacc6f6/uploads/origins/959a10a3-84d9-4bd2-b3d1-b8153cceaf2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=933e30ab93b8e1831e94821720c7b72b 3x", "genre": "art", "nsfw": true, "body": "インフィニット・ストラトスよりシャルロット・デュノアの凍結をお願いします！\n\n彼女の服装はISスーツ。\nシチュエーションは\n（1）氷属性系の敵が、彼女の左右に氷の柱を生成し、彼女の手足の一部がそれに飲み込まれる形で拘束される。\n（2）催淫効果をもつピンク色の細い光線が彼女の股間に照射される。\n（3）彼女は喘ぎ股を濡らし愛液を太ももへと伝わせる。\n（4）催淫光線とは別に低出力の細い冷凍光線も彼女の股に照射され、彼女の股間を起点に全身をじわじわと凍らせていく。\n（5）催淫光線で愛液を流し、冷凍光線がそれを凍らせる。これの繰り返しによって彼女の股には盛大にお漏らししたように見えるほどツララが形成される。\n（6）彼女は最終的に全身が凍てつき、股間のツララが目立つ恥ずかしい氷像となり果てる。\nの流れでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/52", "thumbnail_src": "https://si.imgix.net/8f10f750/uploads/origins/8b5467a2-770f-476f-80da-73839be47023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3979e0172e0ab8bb76d2061aced4b23", "thumbnail_srcset": "https://si.imgix.net/8f10f750/uploads/origins/8b5467a2-770f-476f-80da-73839be47023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3979e0172e0ab8bb76d2061aced4b23, https://si.imgix.net/8f10f750/uploads/origins/8b5467a2-770f-476f-80da-73839be47023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef249efdbc9927ce4b922ee873b5bde4 2x, https://si.imgix.net/8f10f750/uploads/origins/8b5467a2-770f-476f-80da-73839be47023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee9d031a4a5297050312ed5ddfb8c96b 3x", "genre": "art", "nsfw": true, "body": "以前は実質新キャラである片石夫妻をありがとうございました。\nまた新しいイラスト依頼となります。\n\nAomatu先生のOCのシュネフィのイラストを希望します。\n状況は、１ページ目は服と鎧を着ている状態でのメタル化でスーパーマ〇オ64の「やみにとけるどうくつ」の煙迷路の中で佇んでいる様子を希望します。このときかぶっているものは冠かメタル帽子かはお任せします。\n差分として全裸でのメタル化で水中で同じように佇んでいる様子を希望します。\n\n版権上難しいかもしれないのですが可能であればイラストをよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/51", "thumbnail_src": "https://si.imgix.net/a5e20596/uploads/origins/beab7df4-7a68-4800-be21-1fb1259e1a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cdf3b93d251dc181f1666997c8be666", "thumbnail_srcset": "https://si.imgix.net/a5e20596/uploads/origins/beab7df4-7a68-4800-be21-1fb1259e1a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cdf3b93d251dc181f1666997c8be666, https://si.imgix.net/a5e20596/uploads/origins/beab7df4-7a68-4800-be21-1fb1259e1a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09b3750126fa69dcdf5ae6226c052cbc 2x, https://si.imgix.net/a5e20596/uploads/origins/beab7df4-7a68-4800-be21-1fb1259e1a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2705aa01ace71fcca6d9d4dc2d57a59 3x", "genre": "art", "nsfw": false, "body": "viprpg合同誌でお世話になっています\n一次創作のドラゴン娘が錬金術を始めました　のキャラ\n「ウィザードドラゴン」の絵を描いていただけないでしょうか\n描いていただける場合よろしくお願いします\n資料\n↓\nhttps://www.pixiv.net/artworks/128924306", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/50", "thumbnail_src": "https://si.imgix.net/cc1c6dec/uploads/origins/58be9d0a-b4cb-4412-85e1-cb7e9c45a722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c44fa2081f275e63022d5ecb264d53c3", "thumbnail_srcset": "https://si.imgix.net/cc1c6dec/uploads/origins/58be9d0a-b4cb-4412-85e1-cb7e9c45a722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c44fa2081f275e63022d5ecb264d53c3, https://si.imgix.net/cc1c6dec/uploads/origins/58be9d0a-b4cb-4412-85e1-cb7e9c45a722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e665365b8bd94e8d0f3fc48051f2544 2x, https://si.imgix.net/cc1c6dec/uploads/origins/58be9d0a-b4cb-4412-85e1-cb7e9c45a722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16a6e7e37823f3a49b0aea07422f3642 3x", "genre": "art", "nsfw": false, "body": "メタル化ドラ子(viprpgのキャラ)をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/49", "thumbnail_src": "https://si.imgix.net/2b02f95b/uploads/origins/ca8310db-bc71-4dd7-8650-2316d4301adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17c7d95fc35a00feb070a55a9b8f7d2a", "thumbnail_srcset": "https://si.imgix.net/2b02f95b/uploads/origins/ca8310db-bc71-4dd7-8650-2316d4301adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17c7d95fc35a00feb070a55a9b8f7d2a, https://si.imgix.net/2b02f95b/uploads/origins/ca8310db-bc71-4dd7-8650-2316d4301adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7fbe7cd8ec9bfad89a4c9f7737d6388 2x, https://si.imgix.net/2b02f95b/uploads/origins/ca8310db-bc71-4dd7-8650-2316d4301adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b16df143275fc1e0b325df44613ad227 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/48", "thumbnail_src": "https://si.imgix.net/8098532f/uploads/origins/8eaf89e8-e98e-41e5-9810-a54c753388e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fe358c44ab0c6831311774dc9ce4624", "thumbnail_srcset": "https://si.imgix.net/8098532f/uploads/origins/8eaf89e8-e98e-41e5-9810-a54c753388e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fe358c44ab0c6831311774dc9ce4624, https://si.imgix.net/8098532f/uploads/origins/8eaf89e8-e98e-41e5-9810-a54c753388e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46f3dbdbe3d3b6400595a214d0038e7c 2x, https://si.imgix.net/8098532f/uploads/origins/8eaf89e8-e98e-41e5-9810-a54c753388e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7eccb3bac34ec52028e16e750993a5f2 3x", "genre": "art", "nsfw": true, "body": "こんばんは。今回は艦これの吹雪ちゃんが改二制服と靴下を着ている霞さんと霰ちゃんを巻き込み、足から目と口を残した状態までだんだん全身が金粉に染めていき、最後は頭上から金粉を浴びて目と口が染まっていく過程の細かい差分が多くあると嬉しいです。（予算内で可能な量で充分です）（予算内で可能な範囲で）\n背景は前回と同じものでお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/47", "thumbnail_src": "https://si.imgix.net/6a0eef9b/uploads/origins/1afe16ac-656e-480e-886e-90562fd1a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a878677b8bb303ed1305b0fff3e846", "thumbnail_srcset": "https://si.imgix.net/6a0eef9b/uploads/origins/1afe16ac-656e-480e-886e-90562fd1a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a878677b8bb303ed1305b0fff3e846, https://si.imgix.net/6a0eef9b/uploads/origins/1afe16ac-656e-480e-886e-90562fd1a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=721debe3a313b1273d07672a47ccd0c2 2x, https://si.imgix.net/6a0eef9b/uploads/origins/1afe16ac-656e-480e-886e-90562fd1a48e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15a059f766d653b2421eb29a2bae39d0 3x", "genre": "art", "nsfw": true, "body": "学園アイドルマスターより、相手を金に変える能力を得て力に溺れた藤田ことねによって、素っ裸の黄金像に変えられそして愛でられる月村手毬をお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/46", "thumbnail_src": "https://si.imgix.net/00f25fa1/uploads/origins/e995e3b6-0943-42d6-b981-cc394060903c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbdfdd1022e7d966c84b40cbeda02fe", "thumbnail_srcset": "https://si.imgix.net/00f25fa1/uploads/origins/e995e3b6-0943-42d6-b981-cc394060903c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbdfdd1022e7d966c84b40cbeda02fe, https://si.imgix.net/00f25fa1/uploads/origins/e995e3b6-0943-42d6-b981-cc394060903c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abeb72ccb521c72c995b60810a7d113d 2x, https://si.imgix.net/00f25fa1/uploads/origins/e995e3b6-0943-42d6-b981-cc394060903c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29f967d51e81a49a7add1c9a5c9850a3 3x", "genre": "art", "nsfw": false, "body": "うちのこのジャスティスさんの絵をお願いいたします。\n半分ケモノ、半分金属の状態でお願いします。\n\n（反乱時の姿）\nhttps://x.com/netutu/status/1841826989394571579\n\n設定：\n　尻尾に能力を持ち、今回、周囲を金属にする力を使用してます。\n\n共通：\n　ケモノです。\n　色は黒と白です。\n　身体中にけもみみと尻尾が生えてます。本数や尻尾の先の形は自由です。伸縮自在です。\n\n反乱時の姿：\n　愛に目覚めています。しかし、感情をコントロールできてません。\n　肩と腰の尻尾を手足として使います。（本体は小さい）\n　胸とお尻の部分は毛が膨らんでおり、もふもふしてます。\n　この世界はけもみみとけものが存在すれば良いと考えてます。人間は駆除対象です。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/45", "thumbnail_src": "https://si.imgix.net/5a783c98/uploads/origins/48b9ee1d-ac93-411e-9ccf-154eb73ab074?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2ac66f0d7cd1b2ab7e8fd402569b1bc", "thumbnail_srcset": "https://si.imgix.net/5a783c98/uploads/origins/48b9ee1d-ac93-411e-9ccf-154eb73ab074?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2ac66f0d7cd1b2ab7e8fd402569b1bc, https://si.imgix.net/5a783c98/uploads/origins/48b9ee1d-ac93-411e-9ccf-154eb73ab074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9a8f6ba17af343a11924931ae73d269 2x, https://si.imgix.net/5a783c98/uploads/origins/48b9ee1d-ac93-411e-9ccf-154eb73ab074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf5fcf1d0029bc9a059c575618668d65 3x", "genre": "art", "nsfw": true, "body": "こんにちは。今回は艦これの「朝潮」さんが「満潮」さん・「大潮」さん・「荒潮」さんを巻き込み、改二制服と靴下を着て銀粉を足から顔と髪以外にだんだん塗っていき、最後は頭上から大量の銀粉を浴びて完全に染まる過程の細かい差分が多くあると嬉しいです。（予算内で可能な範囲で）\n背景は前回と同じものでお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/44", "thumbnail_src": "https://si.imgix.net/e4da97c2/uploads/origins/c8a4a47a-2c61-44f1-9f60-fab6cbb79225?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d9917005c66b7d07f22ddcda2befddf", "thumbnail_srcset": "https://si.imgix.net/e4da97c2/uploads/origins/c8a4a47a-2c61-44f1-9f60-fab6cbb79225?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d9917005c66b7d07f22ddcda2befddf, https://si.imgix.net/e4da97c2/uploads/origins/c8a4a47a-2c61-44f1-9f60-fab6cbb79225?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34b36d17e2ee3d105c5de5feacff367 2x, https://si.imgix.net/e4da97c2/uploads/origins/c8a4a47a-2c61-44f1-9f60-fab6cbb79225?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07061608e50828153ba4d1cf9a6666be 3x", "genre": "art", "nsfw": true, "body": "マギアレコードより五十鈴れんのブロンズ化を依頼させていただきます。\n\nシチュエーション:\nブロンズの台座に足を埋められ拘束された彼女が、無数の手に群がられ愛撫・くすぐり・マッサージを同時に受けながらブロンズ液を塗りつけられ、涙目で赤面しながらも笑わされてしまいます。\n全身がブロンズ色に染まってもなお責めは続き、やがて羞恥心に耐えられなくなった彼女が敵に許しを請うた瞬間、リーダー格の手が指をパチンと鳴らし、ブロンズ液が瞬間硬化します。\n根底に羞恥がありつつも笑みを強制された表情、抵抗を忘れなすがままにされたが故の奇妙なポーズ、身も心も敗北した情けないブロンズ像にされた彼女は、手から解放されてもなお、恥辱を宿した体を晒し続けます。\n\n参考:水着衣装の五十鈴れん\nhttps://x.com/magireco/status/1019839329903038464?t=HlICSjYQdhb16ovmNCLfng&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/43", "thumbnail_src": "https://si.imgix.net/63021867/uploads/origins/d15a771b-7a19-4b90-b75b-9206adaadf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3ff27e4ba51f4b14fc430d91c149dea", "thumbnail_srcset": "https://si.imgix.net/63021867/uploads/origins/d15a771b-7a19-4b90-b75b-9206adaadf36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3ff27e4ba51f4b14fc430d91c149dea, https://si.imgix.net/63021867/uploads/origins/d15a771b-7a19-4b90-b75b-9206adaadf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82320a1cba2ea74aa37fd8f24db93402 2x, https://si.imgix.net/63021867/uploads/origins/d15a771b-7a19-4b90-b75b-9206adaadf36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c0fec94f8f777f5427d6162e8220f15 3x", "genre": "art", "nsfw": true, "body": "Aomatu_Tagliaさん、こんばんは。今回は、艦これの「高雄改」さん・「愛宕改」さん・「朝潮改二」さんの３人が制服と靴下を着ている状態で銀粉メッシーするイラストをお願いしたいです。シチュエーションは、足から顔と髪以外が銀粉にだんだん染まっていき、最後は頭上から大量の銀粉を浴びて顔や髪も完全に染まっていく過程の細かい差分が多くあると嬉しいです。（予算内で可能な量で充分です）\n背景は吹雪ちゃんの時と同じものでお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/42", "thumbnail_src": "https://si.imgix.net/8b02cdc6/uploads/origins/3272480c-a4ab-4152-83ad-b9a7cf20e337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c6f8088c6914a7167f36d3f2f6101e", "thumbnail_srcset": "https://si.imgix.net/8b02cdc6/uploads/origins/3272480c-a4ab-4152-83ad-b9a7cf20e337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c6f8088c6914a7167f36d3f2f6101e, https://si.imgix.net/8b02cdc6/uploads/origins/3272480c-a4ab-4152-83ad-b9a7cf20e337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d7171245053d834fe02b06fdc7077c6 2x, https://si.imgix.net/8b02cdc6/uploads/origins/3272480c-a4ab-4152-83ad-b9a7cf20e337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e15571a345d05d7dda79911dc5ac3bc 3x", "genre": "art", "nsfw": true, "body": "Aomatuさん、こんばんは。今回は改二となった艦これの「白雪」と「深雪」が金粉メッシーをするイラストをお願いしたいです。URLの写真みたいな表情で、制服と靴下を着用にてお願いします。シチュエーションは前回と同じく、足から目と口を残した状態まで全身が金粉に染まっていき、最後は頭上から金粉を浴びて目と口も染まっていく過程の細かい差分が多くあると嬉しいです。（予算内で可能な量で充分です）\n背景は「吹雪改二」の時と同じものでお願いします。\nご検討よろしくお願いします。\n\nhttps://livedoor.sp.blogimg.jp/asternaru/imgs/6/0/60aadb1e-s.png\n\nhttps://livedoor.blogimg.jp/asternaru/imgs/2/8/283621a1.png", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/41", "thumbnail_src": "https://si.imgix.net/df15f65c/uploads/origins/40cd91b1-b038-45b5-b648-690df7afadc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd192d838676e6144f6ac4b6604a024e", "thumbnail_srcset": "https://si.imgix.net/df15f65c/uploads/origins/40cd91b1-b038-45b5-b648-690df7afadc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd192d838676e6144f6ac4b6604a024e, https://si.imgix.net/df15f65c/uploads/origins/40cd91b1-b038-45b5-b648-690df7afadc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5774da5cf7cafdd61f72735cdbed7de3 2x, https://si.imgix.net/df15f65c/uploads/origins/40cd91b1-b038-45b5-b648-690df7afadc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e78e26aeed462e8199e8070bfd9c81c4 3x", "genre": "art", "nsfw": true, "body": "魔法少女まどか☆マギカシリーズより詩音千里のブロンズ像化をお願いします！\n衣装は魔法少女衣装。\n戦闘中に、「ブロンズ液が出続ける魔法」を膀胱に掛けられてしまい、我慢できずにブロンズ液を股間からお漏らししてしまう。そしてブロンズ液に肉体が侵食されていくも、恥ずかしいから身を隠したい感情と固まる前に敵を倒したい感情が相反し、ろくな行動ができずそのまま全身がブロンズに侵食されて固まってしまうシチュエーションでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/40", "thumbnail_src": "https://si.imgix.net/b0c6cf80/uploads/origins/a44599c3-664a-4a0b-a009-9bf3f606c694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8229a1058aab15c0982a6bde9dfb4766", "thumbnail_srcset": "https://si.imgix.net/b0c6cf80/uploads/origins/a44599c3-664a-4a0b-a009-9bf3f606c694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8229a1058aab15c0982a6bde9dfb4766, https://si.imgix.net/b0c6cf80/uploads/origins/a44599c3-664a-4a0b-a009-9bf3f606c694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8f0a852838c52671eeed1e8b0fdcf5d 2x, https://si.imgix.net/b0c6cf80/uploads/origins/a44599c3-664a-4a0b-a009-9bf3f606c694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=007cfbd3d9d1e30f4d671c924b355ba5 3x", "genre": "art", "nsfw": true, "body": "こんばんは。先日の「初雪」イラストがとてもよかったので、今度は改二となった艦これの「吹雪」が金粉メッシーをするイラストをお願いしたいです。\n\nURLの写真みたいな感じの表情でピースをしていて、制服と靴下を着た姿でお願いします。\n\nシチュエーションは、足から目と口を残した状態まで全身が金粉に染まっていき、最後は頭上から金粉を浴びて目と口も染まっていく過程の細かい差分が多くあると嬉しいです。（予算内で可能な量で充分です）\n\nご検討よろしくお願いします。\n\nhttps://lh3.googleusercontent.com/bfRneCcpEnC2uPhS0FZcIgHb7BvaraiWxdBph0Oq9ssKx_jdsSZCqpEaLY9WqAfUo0YOFRnzYC7PvRHQGhu7SbmdP6qn6rWvrZ8PiqZDuY7q", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/39", "thumbnail_src": "https://si.imgix.net/ef8cc854/uploads/origins/d768c9f9-eaf4-472d-9c51-53a4b4701c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59276c68594fee28879bc3ca0a88c06b", "thumbnail_srcset": "https://si.imgix.net/ef8cc854/uploads/origins/d768c9f9-eaf4-472d-9c51-53a4b4701c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59276c68594fee28879bc3ca0a88c06b, https://si.imgix.net/ef8cc854/uploads/origins/d768c9f9-eaf4-472d-9c51-53a4b4701c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e0f4d4d24541714d602b6120a9d3820 2x, https://si.imgix.net/ef8cc854/uploads/origins/d768c9f9-eaf4-472d-9c51-53a4b4701c1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63934234f711fb1668c9890521322ee4 3x", "genre": "art", "nsfw": true, "body": "こんばんは。艦これの「初雪」が金粉メッシーをするイラストをお願いします。\nURLの写真みたいな感じの表情で制服姿を着ている姿をお願いします。\n足から全身が金粉に染まっていき、最後は上から金粉をかけられて目が染まっていく過程の細かい差分が多くあると嬉しいです。（予算内で可能な量で充分です）\n\nhttps://lh3.googleusercontent.com/0QguYCzIAD2bHdsDj5na7UQ6feyQ13JFcoBZyHfqvO55tKTT0vURD5dNYqCF1HsPDe5Mp83YHwB9Ol9i-buOaz1OVHguUqwe4TQL3pV8TTkP", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/38", "thumbnail_src": "https://si.imgix.net/1b3fdfc6/uploads/origins/92fad782-ecf6-491a-87ca-b560530fd38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a92a66f272e72a011d1e028858a732ba", "thumbnail_srcset": "https://si.imgix.net/1b3fdfc6/uploads/origins/92fad782-ecf6-491a-87ca-b560530fd38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a92a66f272e72a011d1e028858a732ba, https://si.imgix.net/1b3fdfc6/uploads/origins/92fad782-ecf6-491a-87ca-b560530fd38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70de876745f68fd35827c0b269f6d408 2x, https://si.imgix.net/1b3fdfc6/uploads/origins/92fad782-ecf6-491a-87ca-b560530fd38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d43da58aac4e6e75fdbbec3c1292c076 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/37", "thumbnail_src": "https://si.imgix.net/7c69d346/uploads/origins/da83a3a6-36ff-428a-8b89-c3af2deb35f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6b26d2746dfc9aaac05d7ee588edb8", "thumbnail_srcset": "https://si.imgix.net/7c69d346/uploads/origins/da83a3a6-36ff-428a-8b89-c3af2deb35f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6b26d2746dfc9aaac05d7ee588edb8, https://si.imgix.net/7c69d346/uploads/origins/da83a3a6-36ff-428a-8b89-c3af2deb35f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c794a0f1b3ba90c5edab31761aa04c0 2x, https://si.imgix.net/7c69d346/uploads/origins/da83a3a6-36ff-428a-8b89-c3af2deb35f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ba81a9c47225357665d3fd4402d9f84 3x", "genre": "art", "nsfw": true, "body": "原神インパクトのケチン（刻晴）をブロンズ像にしてください。直接ブロンズ像になるのではなく、実際にはブロンズ色の塗料で覆われている。\nブロンズ像になるのは彼女自身の意志であるという状況だ。彼女は全裸になり、台座の上に立ち、真剣でありながら自信に満ちた笑みを浮かべている。両腕は頭の上に上げられ、交差している。足元から刷毛で直接、ブロンズ色の厚い絵の具を肌に塗り、髪飾りを含む全身を徐々に覆っていく。その間、彼女は慌てる様子も見せず、最終的には動かせない、しかし美しいブロンズ作品となる。\n参考画像\nhttps://x.com/dailykeqing_/status/1857861196457955799/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/36", "thumbnail_src": "https://si.imgix.net/d5530d9f/uploads/origins/516a825b-8a07-4303-b0de-dd0d6a684e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c9afa5fe484564d80e228d9a337b2e", "thumbnail_srcset": "https://si.imgix.net/d5530d9f/uploads/origins/516a825b-8a07-4303-b0de-dd0d6a684e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c9afa5fe484564d80e228d9a337b2e, https://si.imgix.net/d5530d9f/uploads/origins/516a825b-8a07-4303-b0de-dd0d6a684e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0826c41248b1c0939f6de24e09b7ee26 2x, https://si.imgix.net/d5530d9f/uploads/origins/516a825b-8a07-4303-b0de-dd0d6a684e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a23e03c54f7524c95c9826070551c7d0 3x", "genre": "art", "nsfw": true, "body": "こちらはじめての依頼になります。時間がかかるイラスト内容となるのですが、金属化と公式カップリングのジャンルのシチュエーションで片石姉弟の両親をお願いします。\n\n状況は二人とも全裸でメタル化している状態で、片石父がベッドで仰向けで寝転んでいて、片石母は同じベッドの隅に腰掛けていて体ごと振り向きながら片石父を眺めている様子を希望します。\n差分として、周りに液体金属が詰まった避妊具が散らばっていて、片石母がそのうち一つを手に取って眺めている様子。何があったかは『読者のご想像にお任せします』のような雰囲気の場面を希望します。\n\nキャラデザインからになってしまうのですが外見が実年齢よりも幼めで片石父の外見が少年の範囲内であり、可能であればイラストをよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/35", "thumbnail_src": "https://si.imgix.net/d984932a/uploads/origins/a9772a45-05c1-4a6c-8666-292c4b333af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5825537b6c7f2cb8e9ed90ac280f0e5", "thumbnail_srcset": "https://si.imgix.net/d984932a/uploads/origins/a9772a45-05c1-4a6c-8666-292c4b333af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5825537b6c7f2cb8e9ed90ac280f0e5, https://si.imgix.net/d984932a/uploads/origins/a9772a45-05c1-4a6c-8666-292c4b333af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=602bc28695a7992f774bea16700ecf47 2x, https://si.imgix.net/d984932a/uploads/origins/a9772a45-05c1-4a6c-8666-292c4b333af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=263136b1d22e1f1e10d0aaea40c610d2 3x", "genre": "comic", "nsfw": true, "body": "おはようございます。100の人と申します。いつもなりたみ深い金属化イラストを有り難うございます。\n手数料無料キャンペーンに乗じてリクエストさせていただきます。\n\nうちの子「100の人」(♂・資料参照) が、\n浸食されて動けないステンレス像化する。\n(服は変化せず・ただし額の宝石部分としっぽはカラダの一部なので変化)\n(固め後の目は、黒目と白目の境界が見えるタイプで)\n\n服を取り除かれて、\n彫刻により、股間も含めて女性の姿に変えられ、\n小便少女として街中に設置され、\n股間から無色透明の液体を吹き出し続ける。\n\n朝には股間から大量の精液を垂らすことになる。\n\n取り外され、最後は再利用のために溶かされていく。\n\nという感じのシチュエーションを、差分による変化をメインとした流れで描いてもらえないでしょうか。\n固め後もずっと意識が残っている何らかの描写が欲しいです。\n\nキャンペーン終了間際のリクエストになり申し訳ございませんが、ご検討よろしくお願いします。\n\n\n【100の人についての資料】\n■立ち絵・設定\n↓の右側 (ヒト型)\nhttps://misskey.io/notes/9kurbpeoy0\n■額の宝石やしっぽ部分の3Dモデル\nhttps://virtualcast.jp/items/acacf505a4d84111c58ade19a42772c3851e0083db9e12b3ab79ae6bb019977a\n100の人の性格等について設定が必要でしたら、一人称ボクの生意気な少年という感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/34", "thumbnail_src": "https://si.imgix.net/9d9a5249/uploads/origins/23a8037c-8ef1-4347-85c1-7ea1177b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c87394a61fd4605fd22132c48597935", "thumbnail_srcset": "https://si.imgix.net/9d9a5249/uploads/origins/23a8037c-8ef1-4347-85c1-7ea1177b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c87394a61fd4605fd22132c48597935, https://si.imgix.net/9d9a5249/uploads/origins/23a8037c-8ef1-4347-85c1-7ea1177b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=103861fdc07b26a9559d75348cf342b3 2x, https://si.imgix.net/9d9a5249/uploads/origins/23a8037c-8ef1-4347-85c1-7ea1177b4100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ded5b03fe86146b54e5f13cecfdb77b5 3x", "genre": "art", "nsfw": true, "body": "転生したら序盤で死ぬ中ボスだった、という作品のココルルというキャラのメタル化（黒光り気味？）が見たいです\nイラストはリンクの5巻の表紙のキャラで\n淫紋はどちらでも結構です\n\n侵食過程の差分が沢山あると嬉しいです\n\nhttps://bookwalker.jp/ded85626ca-e140-46f0-9b03-946900ca125b/\nhttps://novel18.syosetu.com/n3298hj/15/", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/33", "thumbnail_src": "https://si.imgix.net/c665d950/uploads/origins/77e88e40-3bb2-4872-a6ed-d3a572abc3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d610f847f847a5359b1853c2314652", "thumbnail_srcset": "https://si.imgix.net/c665d950/uploads/origins/77e88e40-3bb2-4872-a6ed-d3a572abc3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d610f847f847a5359b1853c2314652, https://si.imgix.net/c665d950/uploads/origins/77e88e40-3bb2-4872-a6ed-d3a572abc3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01fd61c8ea9aead19b4cb2ee829ab5cf 2x, https://si.imgix.net/c665d950/uploads/origins/77e88e40-3bb2-4872-a6ed-d3a572abc3eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58212380e755c6343d7765942bbc83ea 3x", "genre": "art", "nsfw": true, "body": "セメントで固める作品のリクエストはできますか？\n\nキャラクターはプロジェクト・セカイの秋山瑞希です。いわゆる男の娘です。\n\nその姿勢は次のようなものだ：水木は裸で、両足を少し開いて地面に立ち、両腕を頭の上に上げている。瑞希の顔はキュートな笑みを浮かべている。また、瑞希のアナルにはディルドが挿入されている。その姿勢からは、水樹がとても嬉しそうで、キュートでエロティックな少女のような男のヌードを自慢げに見せているように感じられる。\n\nそして、灰色のセメントが瑞希の頭から注がれ、髪飾りを含む全身をゆっくりと覆い、瑞希はエロティックなセメント像と化す。瑞希のペニスは上からセメントを垂らしながら勃起している。\n\n秋山みずきの参考画像：\nhttps://static.wikia.nocookie.net/projectsekai/images/9/9c/Mizuki.png/revision/latest/scale-to-width-down/1000?cb=20231002175001\n\nセメントの質感の参考画像：\nhttps://fantia.jp/posts/2586586", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/32", "thumbnail_src": "https://si.imgix.net/1ed4dd30/uploads/origins/b7643cac-ee08-4d2a-a343-d963df9b154a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b09203091deda3fbf6f32bd99800b5fb", "thumbnail_srcset": "https://si.imgix.net/1ed4dd30/uploads/origins/b7643cac-ee08-4d2a-a343-d963df9b154a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b09203091deda3fbf6f32bd99800b5fb, https://si.imgix.net/1ed4dd30/uploads/origins/b7643cac-ee08-4d2a-a343-d963df9b154a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7ac791c802cefc63a293722a2c0b7ff 2x, https://si.imgix.net/1ed4dd30/uploads/origins/b7643cac-ee08-4d2a-a343-d963df9b154a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f418963ef41033acd85b4c84e45e36c 3x", "genre": "art", "nsfw": true, "body": "はじめまして。アピールありがとうございます。\n \nリクエストさせていただきます。\n \nキャラクターはガンダムシリーズのセシア・アウェアというキャラクターをお願いします。\n \n下記URLはセシア・アウェアのイラスト2つです。\n \nhttps://www.pixiv.net/artworks/33631967\n \nhttps://www.pixiv.net/artworks/31941758\n \n衣装はへそ出しビキニまたは、上はブラのみで下はスカートとソックスをはかせてほしいです。\n \n帽子や装飾品は無しで大丈夫です。\n \n下記URLのような凍結をお願いします。半透明の凍結と完全凍結をお願いします。\n \n \nhttps://twitter.com/Aomatu_Taglia/status/1746559389132357910/photo/1\n \nhttps://skeb.jp/@Aomatu_Spaghe/works/15\n \n顔や胸の谷間やふとももに光沢感があり全身をみえるようにしてほしいです。\n \n下記3項目をお願いします。\n \n①凍結\n \n②完全凍結\n \n③生身（可能なら顔を赤らめてほしいです）\n \n可能な範囲でやりやすいようにしていただいて大丈夫です。\n \n可能であればよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/31", "thumbnail_src": "https://si.imgix.net/729b956b/uploads/origins/786f5652-0c1b-468b-b90e-622fe3d430fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=393ae2a967883ec024614cd674f8e2cc", "thumbnail_srcset": "https://si.imgix.net/729b956b/uploads/origins/786f5652-0c1b-468b-b90e-622fe3d430fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=393ae2a967883ec024614cd674f8e2cc, https://si.imgix.net/729b956b/uploads/origins/786f5652-0c1b-468b-b90e-622fe3d430fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3d6f38c479755649dbb133c30d0288e 2x, https://si.imgix.net/729b956b/uploads/origins/786f5652-0c1b-468b-b90e-622fe3d430fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd134898b171ec450847445b13827770 3x", "genre": "art", "nsfw": false, "body": "初めましてソリッドと申します、リクエストよろしいでしょうか?\n銀色のメタル化したキャプテンコマンダーに登場するキャロルとマーディアの2人をリクエストできますでしょうか?\n銀色のメタル化した2人の虹彩は無しver.で光沢マシマシでお願いいたします。マーディアは目が隠れているように見えますが晒している状態でお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/30", "thumbnail_src": "https://si.imgix.net/0a23b886/uploads/origins/3389cc03-b96d-4c25-8bd6-b803fd986b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69cdee440849712f1e00217c13a9cd28", "thumbnail_srcset": "https://si.imgix.net/0a23b886/uploads/origins/3389cc03-b96d-4c25-8bd6-b803fd986b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69cdee440849712f1e00217c13a9cd28, https://si.imgix.net/0a23b886/uploads/origins/3389cc03-b96d-4c25-8bd6-b803fd986b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e353d9d18ab68cede9371a9ef576dffb 2x, https://si.imgix.net/0a23b886/uploads/origins/3389cc03-b96d-4c25-8bd6-b803fd986b1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ee6e25b5f1453ff4554d34a039969d8 3x", "genre": "art", "nsfw": true, "body": "学園アイドルマスターの藤田ことねの黄金像化をお願いします。\n表情はリンク先画像みたいな感じの明るい状況で（ポーズはこのままでも別なのでも構いません）、全身裸体のバージョンでお願いします。\n体の一部から段々と黄金像へ変わっていく侵食過程の差分が細かくあればあるほど嬉しいです。（もちろん値段相応の分量で結構です）\n\nhttps://twitter.com/gkmas_official/status/1803397567591444578", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/29", "thumbnail_src": "https://si.imgix.net/8fe498b7/uploads/origins/ff852aab-8eb8-4801-a929-f9349c078494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344bed166424a0844da5412674546970", "thumbnail_srcset": "https://si.imgix.net/8fe498b7/uploads/origins/ff852aab-8eb8-4801-a929-f9349c078494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=344bed166424a0844da5412674546970, https://si.imgix.net/8fe498b7/uploads/origins/ff852aab-8eb8-4801-a929-f9349c078494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c7503405edfe7449c8972f0781412b5 2x, https://si.imgix.net/8fe498b7/uploads/origins/ff852aab-8eb8-4801-a929-f9349c078494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32890646dd890adcd253c0869982d6c3 3x", "genre": "art", "nsfw": true, "body": "あなたのアートワークは素晴らしい！液体金属で固めるアートワークのリクエストをしてもいいですか？\n被害者はポニーテールで紺色の髪のオトコノコ（いわゆる「男の娘」。）かわいい女の子に見えるが男の子。\nシチュエーションは、全裸にされ、その裸体に濃い銀色の液体をかけられる。彼は怯えることも抵抗することもなく、酔ったような顔で口を開けている。\n最後に、彼の全身は分厚い銀の液体で覆われ、かわいい銀の像に変身する。目も完全に銀で覆われている。口からは金属液が垂れている。ペニスは銀色の液体を滴らせながら勃起している。\nポーズはリンク先のリクエストに近いですが、全身をお願いします：\nhttps://skeb.jp/@Aomatu_Spaghe/works/7", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/28", "thumbnail_src": "https://si.imgix.net/aa68e0bc/uploads/origins/bdd84790-93b3-4f98-9393-b672a74da270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2acbf6bd86499d686648b936034178b3", "thumbnail_srcset": "https://si.imgix.net/aa68e0bc/uploads/origins/bdd84790-93b3-4f98-9393-b672a74da270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2acbf6bd86499d686648b936034178b3, https://si.imgix.net/aa68e0bc/uploads/origins/bdd84790-93b3-4f98-9393-b672a74da270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7dc5a24a47e2e2d9ae66bb35868a9c0 2x, https://si.imgix.net/aa68e0bc/uploads/origins/bdd84790-93b3-4f98-9393-b672a74da270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6971bb9b85737836b20ef72a45babc06 3x", "genre": "comic", "nsfw": true, "body": "こんばんは。前回リクエストした小宮果穂の続き的なものをお願いします。\n前回同様、全身（目以外）に金粉を塗られた状態、ポーズはガニ股のままで\n・ディルドを2本とも引き抜かれる\n・さらに太いディルドが迫る\n・二穴にディルドの先端が挿入される\n・奥まで挿入された状態\nという流れでお願いします。\n新しい方のディルドも全部金粉を塗られていて、太さも2～3cm太くなっています。", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/27", "thumbnail_src": "https://si.imgix.net/571b918e/uploads/origins/85f944b1-db30-4189-8c7a-ef6644692677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=288920cffbdc5a7ed56e72c270012f6a", "thumbnail_srcset": "https://si.imgix.net/571b918e/uploads/origins/85f944b1-db30-4189-8c7a-ef6644692677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=288920cffbdc5a7ed56e72c270012f6a, https://si.imgix.net/571b918e/uploads/origins/85f944b1-db30-4189-8c7a-ef6644692677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bfeec9dcc8caf89cf7367eed215dcd9 2x, https://si.imgix.net/571b918e/uploads/origins/85f944b1-db30-4189-8c7a-ef6644692677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c9d9b2938ea2ef358f7a0a1eb2eee36 3x", "genre": "art", "nsfw": true, "body": "こんばんは。『アイドルマスターシャイニーカラーズ』の小宮果穂の金粉メッシーをお願いできますか？\n全身（目以外）に金粉を塗られた状態でガニ股になっていて、両手は頭の後ろで、ディルドがマンコとアナルに挿入されていて、恥ずかしがってる表情でお願いします。\nディルドは2本とも金粉で金色になっており、太さは以前リクエストした（URL参照）のと同じぐらいの太さにしてほしいです。\nそれから首より下だけに金粉を塗った状態、顔まで（髪はそのまま）金粉を塗った状態の差分\n可能なら目を瞑っている表情の差分もお願いします。\n\nhttps://skeb.jp/@Aomatu_Spaghe/works/25", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/26", "thumbnail_src": "https://si.imgix.net/d6255c39/uploads/origins/18e8c1df-9395-46e9-988a-65c6f4d64e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a187836c026d369debae066405bd1758", "thumbnail_srcset": "https://si.imgix.net/d6255c39/uploads/origins/18e8c1df-9395-46e9-988a-65c6f4d64e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a187836c026d369debae066405bd1758, https://si.imgix.net/d6255c39/uploads/origins/18e8c1df-9395-46e9-988a-65c6f4d64e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bd9c673744d2df73519b7ae09b92452 2x, https://si.imgix.net/d6255c39/uploads/origins/18e8c1df-9395-46e9-988a-65c6f4d64e9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e993dc58eac3917ad025877211ecb0f7 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nAomatuさんに描いていただきたく、リクエストをさせていただきます。\n『アイドルマスターシンデレラガールズ』の高垣楓の金属化をお願いします。\n\n服装：全裸\nポーズ：ダンス中のポージング\n表情：穏やかな微笑み\n\n描写範囲は頭からつま先までの全身。\n可能でしたら生身状態、固められた後の涙と愛液（両方液体金属）の垂れ流しの差分ありでお願いします！\n\n参考画像：\n・https://starlit-season.idolmaster.jp/images/idol/ill/kaede-takagaki.png\n・https://idollist.idolmaster-official.jp/images/character_main/takagaki_kaede_01.jpg\n・https://livedoor.sp.blogimg.jp/anoyaro06-deremoba/imgs/e/4/e4cbd90d.jpg\n・https://auctions.c.yimg.jp/images.auctions.yahoo.co.jp/image/dr000/auc0212/users/ebf3933bf6d8aef304ab7ab9cb8e54d614be35d9/i-img1200x1133-163983099678mqxa28460.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/25", "thumbnail_src": "https://si.imgix.net/c66239d8/uploads/origins/29ffc4ed-ede8-4e3d-8b6c-abf5b2741a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1989d9452c48447a63f4370e4c98f70e", "thumbnail_srcset": "https://si.imgix.net/c66239d8/uploads/origins/29ffc4ed-ede8-4e3d-8b6c-abf5b2741a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1989d9452c48447a63f4370e4c98f70e, https://si.imgix.net/c66239d8/uploads/origins/29ffc4ed-ede8-4e3d-8b6c-abf5b2741a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8477963fb95f42b91c19b62e68f254a4 2x, https://si.imgix.net/c66239d8/uploads/origins/29ffc4ed-ede8-4e3d-8b6c-abf5b2741a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aae96997b41bf2bb6b2ae5c98e3ac03c 3x", "genre": "art", "nsfw": true, "body": "アピールありがとうございます。\nよければ『ライザのアトリエ』からクラウディア・バレンツの銀粉メッシーをお願いします。\n全身（目以外）に銀粉を塗った状態で膝立ちしていて、片手は自分の乳首を弄り、もう片方はディルドを持っていてそれを自分のマンコに挿入していて、気持ちよくなっている表情でお願いします。\nディルドも銀粉で銀色になっており、太さはURLの35p以降で生えているものよりもさらに太いものだとうれしいです。\n可能なら首より下だけに銀粉を塗った状態の差分もお願いします。\n\nhttps://www.pixiv.net/artworks/92947116", "created_at": "", "completed_at": ""}, {"path": "/@Aomatu_Spaghe/works/24", "thumbnail_src": "https://si.imgix.net/4eed7581/uploads/origins/502fd5dd-95bb-4af9-9081-7828bbb0eeae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d500b8681ba7cef4a01e80f2ef29aec3", "thumbnail_srcset": "https://si.imgix.net/4eed7581/uploads/origins/502fd5dd-95bb-4af9-9081-7828bbb0eeae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d500b8681ba7cef4a01e80f2ef29aec3, https://si.imgix.net/4eed7581/uploads/origins/502fd5dd-95bb-4af9-9081-7828bbb0eeae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a56f54edbc86baaece5d7f5002674aa1 2x, https://si.imgix.net/4eed7581/uploads/origins/502fd5dd-95bb-4af9-9081-7828bbb0eeae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=371be8852efd8a08ba1426a9a0970bed 3x", "genre": "art", "nsfw": true, "body": "Aomatsuさま\nお世話になっております、ぽぴ子です。\nこの度はアピールありがとうございます。\n是非ともご依頼させていただきたく思います。\n\n今回はわたしのオリキャラちゃんの石化を描いていただきたいです。\n\nシチュエーションはメデューサ等の魔眼系の攻撃で本格的な戦闘体勢に入る前に一瞬で石像にされる感じをイメージしてます。\nですので表情は呆然として少し驚いてる状態、ポーズは少し身構えてる状態でお願いします。\n鎧は石にされた後に壊される設定なので服装は裸で剣は持った状態でお願いします。（左利きなので左手で持ってほしいです）\n背景は明るめだと嬉しいです。\n\nよろしければご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-5GJKCdwg89oaO9Nx_vY2791hlP77Dx_", "created_at": "", "completed_at": ""}]}