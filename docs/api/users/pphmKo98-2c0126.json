=30&txt=PRIVATE&s=f72faf7d943b5011df9c1a5cdf0814b6, https://si.imgix.net/34c44f3d/uploads/origins/3438f4f9-61e9-421a-8942-fd9540ac2989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e607c37a4af0dd7d1085e67f7a1ba640 2x, https://si.imgix.net/34c44f3d/uploads/origins/3438f4f9-61e9-421a-8942-fd9540ac2989?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7f1a0d30439c8199ea059dfea164f57 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pphmKo98/works/6", "thumbnail_src": "https://si.imgix.net/3eea2877/uploads/origins/653752c2-8aff-4f6d-a9d6-ef10e777454f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0451bd859100fe97b363d0359448bfd", "thumbnail_srcset": "https://si.imgix.net/3eea2877/uploads/origins/653752c2-8aff-4f6d-a9d6-ef10e777454f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0451bd859100fe97b363d0359448bfd, https://si.imgix.net/3eea2877/uploads/origins/653752c2-8aff-4f6d-a9d6-ef10e777454f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5164bcdb1bfa826ec90739652a3bac62 2x, https://si.imgix.net/3eea2877/uploads/origins/653752c2-8aff-4f6d-a9d6-ef10e777454f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecbabedd74303c5875338dde176c8ba4 3x", "genre": "art", "nsfw": false, "body": "ななはむ様\n\nこんにちは、ななはむ様。\nファンのゼッダルと申します！\nいつもかわいい女の子たちのイラストをいっぱい描いてくださってありがたい限りです…！日々の眼福です！赤面最高！\nもしよろしければそんなななはむ様の可愛い絵で、どうかこちらのオリキャラを頼んでみたいと思います。\n\nお願い申し上げたいのは私のツイッターのプロフ絵とヘッダーにいるオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので外では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないかもしれませんので参考できそうな設定画などを下のURLにつけます。\n\n衣装は設定画のうちの一つで、表情はちょっと照れてる微笑みが良いかな、と思っております。\n色と構図などは全部おまかせします。\nななはむ様のイラスト自体が好きですので、よろしければご自由に表現してくださいませ！\nあ、もし差分の依頼ができればちょっとクールぶってるところから見つめられちゃって照れるような感じがみたいです。\nどうかご検討おねがいします。\n\nほぼ要件のみで申し訳ありません。\nいつも応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pphmKo98/works/5", "thumbnail_src": "https://si.imgix.net/bbec8ea5/uploads/origins/d2ddcf32-e962-43bf-b988-e5677752cf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8632ad135f18f458c7d38af1de93994b", "thumbnail_srcset": "https://si.imgix.net/bbec8ea5/uploads/origins/d2ddcf32-e962-43bf-b988-e5677752cf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8632ad135f18f458c7d38af1de93994b, https://si.imgix.net/bbec8ea5/uploads/origins/d2ddcf32-e962-43bf-b988-e5677752cf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64707649bd3995837af9961d5ffb6966 2x, https://si.imgix.net/bbec8ea5/uploads/origins/d2ddcf32-e962-43bf-b988-e5677752cf4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1e295f936c7a1e0e37279eb358ad817 3x", "genre": "art", "nsfw": false, "body": "ななはむさんこんにちは。skebを始められたと聞いたので、初リクエストさせていただきます‼︎\n・描いていただきたいキャラは艦これの神通改二、能代改二、矢矧改二乙の3人で、うまぴょい伝説の「あたしだけにチュゥする」のシーンのイラストをお願いします‼︎\n配役は\nセンター・神通改二\n向かって右側・矢矧改二乙\n向かって左側・能代改二\nの配役でお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@pphmKo98/works/4", "thumbnail_src": "https://si.imgix.net/fac72f9f/uploads/origins/6c2dc01e-da14-455f-a077-de74cf117a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60ffb9dc614933380dba76f737c0ca6b", "thumbnail_srcset": "https://si.imgix.net/fac72f9f/uploads/origins/6c2dc01e-da14-455f-a077-de74cf117a16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60ffb9dc614933380dba76f737c0ca6b, https://si.imgix.net/fac72f9f/uploads/origins/