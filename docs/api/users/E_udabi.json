3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91a91fa7726070fc8214012a3368feb7", "thumbnail_srcset": "https://si.imgix.net/3ffd5712/uploads/origins/d4bb753e-9e23-41d2-b73f-d4540be56e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91a91fa7726070fc8214012a3368feb7, https://si.imgix.net/3ffd5712/uploads/origins/d4bb753e-9e23-41d2-b73f-d4540be56e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7edac299335f162ded7de3542fba622 2x, https://si.imgix.net/3ffd5712/uploads/origins/d4bb753e-9e23-41d2-b73f-d4540be56e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fb0f62a6b1300cf0e96baf3ebcedf86 3x", "genre": "art", "nsfw": false, "body": "だびさんこんにちは！お世話になっております、はなあさぎです。\n前々からskebを頼んでみたいなと思っていたのですが良いタイミングと思って今回リクエスト出させていただきました！\n\n描いていただきたいのは以前ドリームボックスでお世話になったセレナとエラさんです。\n二人が同じ画面に収まっていればどんな構図・構成でも大丈夫です！雰囲気は優しい・穏やかなものだと嬉しいですがだびさんが描きやすいものがあればそちらを優先していただければと思います！\n\n今回のご縁の有無に関わらず、これからの創作活動を応援しています！\n暑くて過ごし辛い時期ですが、猫ちゃんと一緒に体調にお気をつけて過ごしてください！ここまで読んでくださってありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@E_udabi/works/8", "thumbnail_src": "https://si.imgix.net/e3d457bb/uploads/origins/eb2d5b27-a9c1-487f-954e-b8498add39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b6773c7e681b176cee6e8ad8fa261c", "thumbnail_srcset": "https://si.imgix.net/e3d457bb/uploads/origins/eb2d5b27-a9c1-487f-954e-b8498add39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b6773c7e681b176cee6e8ad8fa261c, https://si.imgix.net/e3d457bb/uploads/origins/eb2d5b27-a9c1-487f-954e-b8498add39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b54edd5c3a7fba9ad8805604db3a758a 2x, https://si.imgix.net/e3d457bb/uploads/origins/eb2d5b27-a9c1-487f-954e-b8498add39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f87fd209a87f2b1ce15b0e3343bff09f 3x", "genre": "art", "nsfw": false, "body": "うだびさん！いつもお世話になっております！味をしめた私は再びリクエスト失礼します！！\n今回のリクエストなのですが、Alice自陣の絵が～見たいです……。\n二人で一緒に画面に映っている構図のが～見たいです…。抱っこしてる構図とかそういうの嬉しいです。\n\n資料はURLに立ち絵一枚だけですが置いておきます！\n片ロス置いて行った側なので本当にあれなんですけどご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/15XZl3fnMdOQZyO3RrxpfUinQfPInIM0A?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@E_udabi/works/7", "thumbnail_src": "https://si.imgix.net/32417649/uploads/origins/004081cc-26a5-42ae-83e3-e27caf9f34c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ded71dc82836386dd9ce6d563f5b0e", "thumbnail_srcset": "https://si.imgix.net/32417649/uploads/origins/004081cc-26a5-42ae-83e3-e27caf9f34c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ded71dc82836386dd9ce6d563f5b0e, https://si.imgix.net/32417649/uploads/origins/004081cc-26a5-42ae-83e3-e27caf9f34c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccfd3037472a16ed066d097ca16d10ca 2x, https://si.imgix.net/32417649/uploads/origins/004081cc-26a5-42ae-83e3-e27caf9f34c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97432f45bf6abd3dbf28cf952ed3b8be 3x", "genre": "art", "nsfw": false, "body": "加治木さんと名塚くんが警察署内等（特に指定はないです、白背景も可）でなにげない会話してるようなワンシーンをください…そこに欠片でもいいのでじろちゃと榊ちゃが見切れてたりするだけでいいです…加治木さんと名塚くんの新規スチルをください………。", "created_at": "", "completed_at": ""}, {"path": "/@E_udabi/works/6", "thumbnail_src": "https://si.imgix.net/3538192b/uploads/origins/7a2aa3ad-de96-445b-97a2-6df4ecaf5cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f87f640881e91132310288ef1c0ae2", "thumbnail_srcset": "https://si.imgix.net/3538192b/uploads/origins/7a2aa3ad-de96-445b-97a2-6df4ecaf5cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f87f640881e91132310288ef1c0ae2, https://si.imgix.net/3538192b/uploads/origins/7a2aa3ad-de96-445b-97a2-6df4ecaf5cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb370ffc1b9e1d16945091998676ab8b 2x, https://si.imgix.net/3538192b/uploads/origins/7a2aa3ad-de96-445b-97a2-6df4ecaf5cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f4aab46418536612ad0a943571d7328 3x", "genre": "art", "nsfw": false, "body": "だびさん…！お世話になっています…！\n悩みに悩んだ結果、『永遠は君が殺した』というシナリオを通過した、PC・KPCの2人の絵を描いて頂きたいな…と思いご依頼です…、！\n\n自分の可愛さが分かってる読者モデルの女の子と、そんな彼女に一目惚れした素直じゃないデザイナー(の卵)の男の子カップルです…‼️\n\n○ネタバレなしのCSです！相方のことも書いてあります～！\nhttps://charasheet.vampire-blood.net/3495135\n\n○ビジュはこれです！\nhttps://twitter.com/shunon_omu/status/1628573540915224576?s=46&t=8uFl87bXb_dDAopKs6qpCg\n\nだびさんの描くかわいい女と成人男性かすきで……照\n構図はおまかせでも大丈夫でしょうか…？\nもう2人がひとつの画面にいるだけで幸せなので…(???)‼️\nぜひ、ご検討をお願い致します…！！", "created_at": "", "completed_at": ""}, {"path": "/@E_udabi/works/5", "thumbnail_src": "https://si.imgix.net/add292ca/uploads/origins/90326437-0dba-477c-801a-838f56dafb5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff05217608e6ab657d6a573ec5145638", "thumbnail_srcset": "https://si.imgix.net/add292ca/uploads/origins/90326437-0dba-477c-801a-838f56dafb5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff05217608e6ab657d6a573ec5145638, https://si.imgix.net/add292ca/uploads/origins/90326437-0dba-477c-801a-838f56dafb5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=128a4c6b405a7fea9a4c2e92f9c2d7bb 2x, https://si.imgix.net/add292ca/uploads/origins/90326437-0dba-477c-801a-838f56dafb5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=700b5898f7153d7a4d40236649674d01 3x", "genre": "art", "nsfw": false, "body": "うだびママ！自陣描いて欲しいです！！！！\n(いつもお世話になっております。この度はうだびさんに回していただきました某卓の自キャラおよび相方キャラのイラストを描いていただきたくリクエストを送らせていただきました。\n基本的にはお任せできると嬉しいです。二人並んでるだけで嬉しいです。\nご検討よろしくお願いいたします。)\n\nhttps://drive.google.com/drive/folders/1-4bGXja6RU9fg3PjdrgyVJaDB7fxBUS2", "created_at": "", "completed_at": ""}, {"path": "/@E_udabi/works/4", "thumbnail_src": "https://si.imgix.net/edb47707/uploads/