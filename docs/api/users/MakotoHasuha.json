23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8b010f91290034ff6815fb1cd87ee23, https://si.imgix.net/0ac0c7f2/uploads/origins/50c6010f-999b-4578-a871-e5bd798dd534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c50e142f8253c614bc98190f5abf9cde 2x, https://si.imgix.net/0ac0c7f2/uploads/origins/50c6010f-999b-4578-a871-e5bd798dd534?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dbd9365da837133fb4ce594e11115de 3x", "genre": "art", "nsfw": false, "body": "キャラクターはたぬきの男の子です。\nhttps://twitter.com/UtaruLive/status/1533924191308632064/photo/1\n\n桜の木と桜の花びらが降っている伝統的な居酒屋の前で掃いているようなイメージでお願いします。\n\n居酒屋のイメージはこんな感じです。\nhttps://twitter.com/UtaruLive/status/1495624337163960323/photo/1\n\n最初の画像はキャラクターの参考としてください。", "created_at": "", "completed_at": ""}, {"path": "/@MakotoHasuha/works/26", "thumbnail_src": "https://si.imgix.net/15334dfa/uploads/origins/d896b1fa-d0e1-4a50-851e-007174411971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fed5fe37e4dcb4e3564027349e5d4df", "thumbnail_srcset": "https://si.imgix.net/15334dfa/uploads/origins/d896b1fa-d0e1-4a50-851e-007174411971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fed5fe37e4dcb4e3564027349e5d4df, https://si.imgix.net/15334dfa/uploads/origins/d896b1fa-d0e1-4a50-851e-007174411971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1844259275d2670dd9188e1d421544b6 2x, https://si.imgix.net/15334dfa/uploads/origins/d896b1fa-d0e1-4a50-851e-007174411971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14c01ead476cf4290bf8dcf9ac3ce8d2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの作品が大好きです\n下のリンクのキャラクターの絵が欲しいです。\n\n招き猫のような動作にすることは可能でしょうか？コインをトーストのように口にくわえて、学校に遅刻しているようなイメージでお願いします。\n\n背景は不要ですが、お好みで追加してください。\n背景が透明なバージョンも希望します。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1FmHcdQoOCGNiAvqGKSnp2w7eW0gGpr9U?usp=sharing", "created_