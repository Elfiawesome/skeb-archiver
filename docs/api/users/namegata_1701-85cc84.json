t/134df13e/uploads/origins/1720f37a-a028-499b-b24a-479ce80e27f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=233036080f2d5de7149eac0a028b4776", "thumbnail_srcset": "https://si.imgix.net/134df13e/uploads/origins/1720f37a-a028-499b-b24a-479ce80e27f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=233036080f2d5de7149eac0a028b4776, https://si.imgix.net/134df13e/uploads/origins/1720f37a-a028-499b-b24a-479ce80e27f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0161430a4dea45e5f6da34be4dbc3def 2x, https://si.imgix.net/134df13e/uploads/origins/1720f37a-a028-499b-b24a-479ce80e27f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bbf8994868c230d2fb793f5358d134c 3x", "genre": "art", "nsfw": false, "body": "行方さん、こんにちは！\nいつもありがとうございました\nよろしければ、私のOCカップルをお願いしたい。\n設定は兄妹だが、女攻めの成分があるので、ご注意してください。\n\n詳しい設定は、以下のURL内「完全版」にてチェックしてください。\nURL内には他のパロ設定も含まれているので、お好きなパロをお選びください。\n服装はお任せ致します。\n\n金額が足りない場合、再送要請をお願いします。\n\nhttps://drive.google.com/drive/folders/1Ea9ZkRbr2gDfpHT0nD7muO6XFD3Xm2-a?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@namegata_1701/works/41", "thumbnail_src": "https://si.imgix.net/e75e12ca/uploads/origins/a287d5b4-403b-4ba8-b1ff-cf8a7c9e788a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=430306c882915b3011b1946deb385395", "thumbnail_srcset": "https://si.imgix.net/e75e12ca/uploads/origins/a287d5b4-403b-4ba8-b1ff-cf8a7c9e788a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=430306c882915b3011b1946deb385395, https://si.imgix.net/e75e12ca/uploads/origins/a287d5b4-403b-4ba8-b1ff-cf8a7c9e788a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=810e35846aaff78e7e8c97b05854c076 2x, https://si.imgix.net/e75e12ca/uploads/origins/a287d5b4-403b-4ba8-b1ff-cf8a7c9e788a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f190b1f896ab256f452b0b9120d570dd 3x", "genre": "art", "nsfw": false, "body": "先生、こんにちは。再びお邪魔してしまい。\n今回は【ヤクザAU】の設定資料をもとに、お二人を自由にイラスト化していただけないでしょうか。\n改めて、心より感謝申し上げます！\nhttps://drive.google.com/drive/folders/1-6CP4XBklbNc3sq4mZAsUdf0_hI9g-4l?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@namegata_1701/works/40", "thumbnail_src": "https://si.imgix.net/bf878e9c/uploads/origins/3cbd8d27-c1ce-46cf-9db9-aac2f20093d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f80d5032b66fc2e98aa48fbc81029af0", "thumbnail_srcset": "https://si.imgix.net/bf878e9c/uploads/origins/3cbd8d27-c1ce-46cf-9db9-aac2f20093d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f80d5032b66fc2e98aa48fbc81029af0, https://si.imgix.net/bf878e9c/uploads/origins/3cbd8d27-c1ce-46cf-9db9-aac2f20093d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8789df072bdf3ee0ad983c522415f91a 2x, https://si.imgix.net/bf878e9c/uploads/origins/3cbd8d27-c1ce-46cf-9db9-aac2f20093d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=322fedee6b1a12abef8f43e199689820 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの作品と作風がとても好きです。そこで、私の2人のキャラクターのイラストを描いていただけないでしょうか。\n\n参考要素：カラス、骨の花、目と口（噂）、古くて使い古された電子機器。\n参考にさせていただき、自由に描いてください！\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1KC8n3FiRPMSR-hBBYDywKr3wTZpMyPqj?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@namegata_1701/works/39", "thumbnail_src": "https://si.imgix.net/1ef61a32/uploads/origins/36ae8603-ce91-4949-a0fd-29bbd0fa760b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15aa2cf96d0a3e1f2968e642e2684dae", "thumbnail_srcset": "https://si.imgix.net/1ef61a32/uploads/origins/36ae8603-ce91-4949-a0fd-29bbd0fa760b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15aa2cf96d0a3e1f2968e642e2684dae, https://si.imgix.net/1ef61a32/uploads/origins/36ae8603-ce91-4949-a0fd-29bbd0fa760b?bg=%23fff&auto=format%2Ccompress