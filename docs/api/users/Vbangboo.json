a237-204e1fd60f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d568c3486e67dd8bab6eca189432a880 2x, https://si.imgix.net/0bd01ae7/uploads/origins/b5f6ebd8-1d7f-4205-a237-204e1fd60f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=556268eafd83409a8a772584afebb384 3x", "genre": "art", "nsfw": true, "body": "かんた様、前回はありがとうございました。\nまた新たにリクエストをしたいのですが、peakに登場するプレイヤーキャラをお願いします。\nｻｰﾌｺﾞｰを描いていただいた時と近いようなシチュエーションですが\n彼氏のststに自分の自慰をしっかりとカメラorスマホ越しで見せてくれている様子のイラストをお願いします。\n資料の中にある01.jpgのスキンのキャラクターでお願いします。\n口調や雰囲気等の設定は資料のほうから確認をお願いします。\nこちらへの三人称は”ststさん”呼びでお願いします、差分は2枚お願いしたいです。\n1枚目はオナニーしている状態\n2枚目は射精時\n3枚目は事後で今後あった時のプレイを妄想している様子\n\nといった形でお願いしたいです。\n問題なさそうでしたら是非今回もよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/19D-ea0_AR9689gwoBPGHALRq1mnuWT_S?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/12", "thumbnail_src": "https://si.imgix.net/eed8a06f/uploads/origins/0c1b5806-52de-4630-a6e8-ecac9b7a3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a45f08552d8050428645c14cbda8c26", "thumbnail_srcset": "https://si.imgix.net/eed8a06f/uploads/origins/0c1b5806-52de-4630-a6e8-ecac9b7a3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a45f08552d8050428645c14cbda8c26, https://si.imgix.net/eed8a06f/uploads/origins/0c1b5806-52de-4630-a6e8-ecac9b7a3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a225f665614a939e227ec9bbdfc4ca0 2x, https://si.imgix.net/eed8a06f/uploads/origins/0c1b5806-52de-4630-a6e8-ecac9b7a3a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ec015da8ead2a283d0ac5f96a897a54 3x", "genre": "art", "nsfw": true, "body": "こんにちは、素敵な絵が流れてきたのでご依頼させていただきたく…\n\n私のOCであるサメ獣人のシバ君がベッドルームで\n大きいモノを扱きオナニーに耽ってしまう絵を描いていただきたいです！\n頭身や体形などは描きやすいようにしていただいて大丈夫です\n\nよろしければお願い致します！\n\nhttps://www.dropbox.com/scl/fo/qdkbvd5qvncot2r9sb86o/AML25lWh2li3GzX7I0qgC0U?rlkey=pzn8cyjwenc8mv9fmw9txbmmu&st=iwogmg8f&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/11", "thumbnail_src": "https://si.imgix.net/9373dac0/uploads/origins/ededfe17-c921-4631-9d80-c2ef56cae5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=511b38bd43950dd2a255a1f499506093", "thumbnail_srcset": "https://si.imgix.net/9373dac0/uploads/origins/ededfe17-c921-4631-9d80-c2ef56cae5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=511b38bd43950dd2a255a1f499506093, https://si.imgix.net/9373dac0/uploads/origins/ededfe17-c921-4631-9d80-c2ef56cae5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed1befb74cd66538f3c15b6b4f1a86b5 2x, https://si.imgix.net/9373dac0/uploads/origins/ededfe17-c921-4631-9d80-c2ef56cae5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c273db7d829cd3923a285b5e38f515db 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/10", "thumbnail_src": "https://si.imgix.net/d01c8a3a/uploads/origins/91ce62fa-38f6-46e9-81e6-2f2c9f858a68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34192942afca85bdbbb175266a762ad8", "thumbnail_srcset": "https://si.imgix.net/d01c8a3a/uploads/origins/91ce62fa-38f6-46e9-81e6-2f2c9f858a68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34192942afca85bdbbb175266a762ad8, https://si.imgix.net/d01c8a3a/uploads/origins/91ce62fa-38f6-46e9-81e6-2f2c9f858a68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdb4abd64edeb1491bed16d24076efef 2x, https://si.imgix.net/d01c8a3a/uploads/origins/91ce62fa-38f6-46e9-81e6-2f2c9f858a68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1822ecc2ac3cb4d3fb8b12544cc8117 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/9", "thumbnail_src": "https://si.imgix.net/01098073/uploads/origins/e94f2e3b-da80-4751-9586-8897583d52c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6955c9813bf2828eca1692dade34eca7", "thumbnail_srcset": "https://si.imgix.net/01098073/uploads/origins/e94f2e3b-da80-4751-9586-8897583d52c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6955c9813bf2828eca1692dade34eca7, https://si.imgix.net/01098073/uploads/origins/e94f2e3b-da80-4751-9586-8897583d52c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16953b0d62b6c635df9a8cd8de4db858 2x, https://si.imgix.net/01098073/uploads/origins/e94f2e3b-da80-4751-9586-8897583d52c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7b0e916e4782aea7153bfffab9db892 3x", "genre": "art", "nsfw": true, "body": "かんた様、前回は素敵なイラストをありがとうございました。\n新たにリクエストをさせてほしいのですが\nでかつよ状態のハチワレを是非描いてほしいです。\nシチュエーションは前回と同じく自慰行為+射精差分のイラストをお願いします。\nまた是非今回も台詞を入れていただけると幸いです。\n性器の形については今回も人間と同じ感じの形でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/8", "thumbnail_src": "https://si.imgix.net/28c5904c/uploads/origins/132fd13e-41bd-4ac2-8a39-d7c0d3af29dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e46bfc5cb7634e961d72e6efffe854", "thumbnail_srcset": "https://si.imgix.net/28c5904c/uploads/origins/132fd13e-41bd-4ac2-8a39-d7c0d3af29dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e46bfc5cb7634e961d72e6efffe854, https://si.imgix.net/28c5904c/uploads/origins/132fd13e-41bd-4ac2-8a39-d7c0d3af29dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1c1ae5f77125896ee5f9947af576477 2x, https://si.imgix.net/28c5904c/uploads/origins/132fd13e-41bd-4ac2-8a39-d7c0d3af29dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2884e6c3d16e4f4b6a1882df00ffc429 3x", "genre": "art", "nsfw": true, "body": "はじめまして、乾太です。 \n\nうちの子を描いていただけないでしょうか。\n\nキャラ設定はこちらをご参照ください → https://blog.init.engineer/ja/kemono/\n\nもし閲覧できない場合 → https://drive.google.com/drive/folders/1y-iruLv9qqW0EAD1TM9_lfLCQKPoZITT?usp=drive_link\n\n好きなように描いてください。 \n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/7", "thumbnail_src": "https://si.imgix.net/30af54fe/uploads/origins/baca7609-e415-4375-9d91-31ba0f7a4716?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc9f35d22c46242e5dbcf7ec5e329221", "thumbnail_srcset": "https://si.imgix.net/30af54fe/uploads/origins/baca7609-e415-4375-9d91-31ba0f7a4716?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc9f35d22c46242e5dbcf7ec5e329221, https://si.imgix.net/30af54fe/uploads/origins/baca7609-e415-4375-9d91-31ba0f7a4716?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d65e66687674042d0b6fcc14173e9bf 2x, https://si.imgix.net/30af54fe/uploads/origins/baca7609-e415-4375-9d91-31ba0f7a4716?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ed0f0df5a5bb2ceb7db4940c2a54949 3x", "genre": "art", "nsfw": true, "body": "もしよろしければマスコットのうちの子を、けもかんたさんがいつも描かれている体型（獣人）で描いていただけますか？\n・筋肉質よりはモチモチというか肉付きが良いぽっちゃり体型\n・性器は巨根巨玉\n・ケモノキャラですが、頭はともかく身体の方は毛が無い素肌でお願いします。\n・うちの子が最初からそういう体型だったでも、マスコット体型から獣人型になってしまったでもどちらでもいいです。\nその他についてはお任せします。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/13lKhgR-SD0c2YxM_njr35cbh6YNyCzRC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/6", "thumbnail_src": "https://si.imgix.net/ae8ab686/uploads/origins/1ab7484d-814b-4fcd-89ba-d1aa3409f352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=696fa53b26d74c90e18c9d0fd16851ff", "thumbnail_srcset": "https://si.imgix.net/ae8ab686/uploads/origins/1ab7484d-814b-4fcd-89ba-d1aa3409f352?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=696fa53b26d74c90e18c9d0fd16851ff, https://si.imgix.net/ae8ab686/uploads/origins/1ab7484d-814b-4fcd-89ba-d1aa3409f352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e529a8e2b16601a887a5657953686eea 2x, https://si.imgix.net/ae8ab686/uploads/origins/1ab7484d-814b-4fcd-89ba-d1aa3409f352?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcdd2895597ed54919434bce3a236717 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Vbangboo/works/5", "thumbnail_src": "https://si.imgix.net/d345b9f4/uploads/origins/fa46a935-27ad-4653-9616-6d236aa1b119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=368695315e325530a37c45d6d459f677", "thumbnail_srcset": "https://si.imgix.net/d345b9f4/uploads/origins/fa46a935-27ad-4653-9616-6d236aa1b119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=368695315e325530a37c45d6d459f677, https://si.imgix.net/d345b9f4/uploads/origins/fa46a935-27ad-4