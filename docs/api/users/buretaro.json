d71-d8080fb31b71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74ebac6cf3aea1cc3991c79e58d5739c, https://si.imgix.net/3e7838b1/uploads/origins/89756983-0555-4c6f-9d71-d8080fb31b71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3526cfdca59e910b46861c660801646 2x, https://si.imgix.net/3e7838b1/uploads/origins/89756983-0555-4c6f-9d71-d8080fb31b71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c8922fe7a48638bcb4bc81cfff013bc 3x", "genre": "art", "nsfw": true, "body": "こんばんは\n前回は素晴らしい作品をありがとうございました\nまた落書きリクでもよろしいでしょうか？\n今回は「爆丸バトルブローラーズ　ニューヴェストロイア編」の「風見駿」をお願いします\n細身の6~6.5等身くらいのクールな忍者キャラです\n\nシチュエーションは以下のようにお願いします\n\n・全裸\n\n・前回前々回の依頼と同じような後ろ手胸縄縛り\n\n・身体を壁にもたせかけた(もしくは前に倒れないように後ろの柱に繋いだ)\n海老責め(江戸時代の拷問用の縛り。首と足首を縄で近づけて固定し、身体を圧迫する責め。首と足をつなぐ縄が少し長いものは胡座縛り・海老縛りとも言う)\n汗も少しかいている\n\n海老責め資料です↓乳房を晒しているものもあるので、r18注意　\nhttps://x.com/fuyukitari/status/1707347994197336491?s=20\n\n上の資料には縄が多いものもありますが、縄の量は最初の画像の絵の\n後ろ手胸縄縛りの縄＋足首を組ませて縛る縄＋足首と首をつなぐ縄だけで結構です\n\n・アングルはおまかせしますが、今回はなるべく顔がしっかり見えるアングルでお願いします\n\n・陰茎が見えるアングルの場合は、ボッキさせられた陰茎もキツく縛られている↓ようにお願いします\nまた、陰茎を縛った紐から伸びた紐は(敵が)引っ張って弄ぶために、体の前に垂らされている感じでお願いします\nhttps://i.imgur.com/IZjD3w3.jpg R18注意\n\n・陰茎が見えるなら、規約に触れぬよう、陰茎は修正をお願いします\n\n・表情は悔しがっている感じでお願いします\n\n風見駿の資料です\nhttps://x.com/fuyukitari/status/1608832117789843457?s=20\n\n駿の後ろ姿\nhttps://i.imgur.com/A559STa.jpg\n\n身体の描き方が面倒な依頼ですみません\n嫌ならば断っても構いませんので、どうかよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@buretaro/works/16", "thumbnail_src": "https://si.imgix.net/a50586f9/uploads/origins/cb9e00ea-7a8c-40c6-b060-c39054184fc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cfd0bf461d43fbd2b0066c44e8c44b2", "thumbnail_srcset": "https://si.imgix.net/a50586f9/uploads/origins/cb9e00ea-7a8c-40c6-b060-c39054184fc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cfd0bf461d43fbd2b0066c44e8c44b2, https://si.imgix.net/a50586f9/uploads/origins/cb9e00ea-7a8c-40c6-b060-c39054184fc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35ebcb7769bc8a8282174dfb62cf0a49 2x, https://si.imgix.net/a50586f9/uploads/origins/cb9e00ea-7a8c-40c6-b060-c39054184fc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e616cf70d2f2d3ae30a19cbdf759303 3x", "genre": "art", "nsfw": true, "body": "こんばんは\n先日は素晴らしいイラストをありがとうございました！\n似たようなシチュエーションですみませんが、今回も同じようならくがきスケブをよろしいでしょうか？\n\n今回は「爆丸 バトルブローラーズ ニューヴェストロイア」の「エース・グリット」(クールなキャラ)というキャラをお願いします\n6~6.5頭身くらいのキャラです\nシチュエーションは以下のようにお願いします\n\n・全裸\n\n・サザのイラストより縄多めの後ろ手胸縄縛り\n\n・膝より下は描かなくて構いません\n\n・滑り落ちないように、縄で身体を吊るされて三角木馬に乗せられている(縄は身体を支えるために2本でお願いします)\n流血は絶対無しでお願いします\n\n・ボールギャグを噛まされて唾液が垂れている\n噛ませ方の資料:https://i.imgur.com/zTKa6aa.jpg\nhttps://i.imgur.com/pTlY8BU.jpg \n\n・陰茎はモザイクでも白塗りでも他でも構いませんが、何かしらの修正をお願いします\n\n・アングルはおまかせします　\n\n・後景は描かなくて構いません\n\n・表情は激痛に耐えているか、苦痛に驚いてうめいているか、どちらかでお願いします\nただ、ぶれをさんがそれよりこっちの方がいいと思う表情があればそちらでも構いません\n\n斜め横顔などのエースの資料です(髪の全体は映っていないものが多くてすみません。)\nhttps://twitter.com/fuyukitari/status/1689205875653906432?s=20\nhttps://twitter.com/fuyukitari/status/1696231157631799403?s=20\n後ろ、横\nhttps://x.com/fuyukitari/status/1701496605348884991?s=20\n正面顔で前から見た髪型全体: \nhttps://i.imgur.com/WG9YRf5.jpg、https://i.imgur.com/oaJIaLv.jpg\n\n拷問イラストになってしまうので、嫌なら断って大丈夫です\n上記の内容でも構わないならば、どうかよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@buretaro/works/15", "thumbnail_src": "https://si.imgix.net/2a0f1ef6/uploads/origins/40cb5a6e-e8e9-487f-9944-54ae444db675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a671d389a321ac79aa94372664eb4554", "thumbnail_srcset": "https://si.imgix.net/2a0f1ef6/uploads/origins/40cb5a6e-e8e9-487f-9944-54ae444db675?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a671d389a321ac79aa94372664eb4554, https://si.imgix.net/2a0f1ef6/uploads/origins/40cb5a6e-e8e9-487f-9944-54ae444db675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63c53842687da77ee07bd06d53fdc54e 2x, https://si.imgix.net/2a0f1ef6/uploads/origins/40cb5a6e-e8e9-487f-9944-54ae444db675?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17b73dd1e4cc22399e8a82f6a8a8b789 3x", "genre": "art", "nsfw": true, "body": "はじめまして　\n\nx等で度々イラストを拝見して、\nXでらくがきスケブも受けられれば、とおっしゃっていたので、依頼したいです\n線画に、多少陰影をつけたものでも構いません\n\n「ファイアーエムブレム　蒼炎の軌跡」の「サザ」の緊縛イラストをお願いします\n(少年の盗賊キャラ)\n資料↓\nhttps://i.imgur.com/SBzMo5k.jpg \nhttps://i.imgur.com/cy7SCnu.jpg \n\nシチュエーションは以下の通りでお願いします\n\n・裸\n\n・だいたい胸の下くらいまで(いわゆるバストアップイラスト)か、上半身\n\n・縄抜けできないよう後ろ手にきつく縛りあげられ、胸の上下に幾重にも厳しく胸縄を巻きつけられ、捕えられている\n縛り方↓\nhttps://i.imgur.com/9q4oqn8.jpg\n\n・表情はこちらを睨みつけている\n\n・猿轡の有無やアングルなど、その他はお任せします\n\n・後景は描かなくても構いません\n\nもし嫌なところ、条件に納得できないところがあれば断って構いませんので、どうかよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@buretaro/works/14", "thumbnail_src": "https://si.imgix.net/3c10dc09/uploads/origins/ccfac49a-a25f-49b8-a722-72ee4724dacb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c25910e31deb127051393982704196", "thumbnail_srcset": "https://si.imgix.net/3c10dc09/uploads/origins/ccfac49a-a25f-49b8-a722-72ee4724dacb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c25910e31deb127051393982704196, https://si.imgix.net/3c10dc09/uploads/origins/ccfac49a-a25f-49b8-a722-72ee4724dacb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77dd30762f3cf7dabbd245832485990e 2x, https://si.imgix.net/3c10dc09/uploads/origins/ccfac49a-a25f-49b8-a722-72ee4724dacb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d41a2027fc7095b8a262a20da25619 3x", "genre": "art", "nsfw": true, "body": "ロックマンエグゼのダークブルースがダーク化した炎山を縛り付けて犯しているイラストをお願いします。\n\n体位は立ちバック意外でお願いしたいです。\n\n\n二人ともヘルメット無しでお願いします。（資料参照。）\n\nスーツは脱がしたり破いたりせずに、にコンドームのように性器に張り付いている感じでお願いします。\n着たまま入れたり入れられたりしています。\n\nBLイラストのような感じで二人とも目立つように書いて頂けると嬉しいです。\nダークブルースのインナーは黒ではなく少し紫がかっています。\n二人とも華奢な体格で肩幅狭めで目が大きく中性的で、少年っぽい感じにしてくれると嬉しいです。\n（参考画の体格イメージです。）\n炎山が140cm、ダークブルースが165cmくらいのイメージです。\n\nhttps://drive.google.com/drive/folders/1pHxtne9V2AX8fZj6yjr-zEhg-QyYXyWI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@buretaro/works/13", "thumbnail_src": "https://si.imgix.net/62a93bd8/uploads/origins/c68ffbef-6659-4a4a-8e7d-51ad1064246b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37e666844d3ed6498becea50d2e6dc7d", "thumbnail_srcset": "https://si.imgix.net/62a93bd8/uploads/origins/c68ffbef-6659-4a4a-8e7d-51ad1064246b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37e666844d3ed6498becea50d2e6dc7d, https://si.imgix.net/62a93bd8/uploads/origins/c68ffbef-6659-4a4a-8e7d-51ad1064246b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5e3f46756c2ee6f782f6b9e8c387ac9 2x, https://si.imgix.net/62a93bd8/uploads/origins/c68ffbef-6659-4a4a-8e7d-51ad1064246b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=456a2b0b2583979542d3d2d5be6d7b10 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@buretaro/works/12", "thumbnail_src": "https://si.imgix.net/06774399/uploads/origins/ce8fffd5-5100-43eb-96d9-0ba6cce60836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b7166d40fd06a527f5d3bf5958fcb47", "thumbnail_srcset": "https://si.imgix.net/06774399/uploads/origins/ce8fffd5-5100-43eb-96d9-0ba6cce60836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b7166d40fd06a527f5d3bf5958fcb47, https://si.imgix.net/06774399/uploads/origins/ce8fffd5-5100-43eb-96d9-0ba6cce60836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1630e4d7f3c3cde37ce3a40969078fae 2x, https://si.imgix.net/06774399/uploads/origins/ce8fffd5-5100-43eb-96d9-0ba6cce60836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59bb6635ffb169f726bcb3be409dbf23 3x", "genre": "art", "nsfw": true, "body": "ぶれ太郎さん初めまして、いつも素敵なイラストを拝見しております。今回はうちの子も描いて頂きたいと思ってリクエストさせていただきます。\n\n透明で小さい立方体に閉じ込められて、触手に弄ばれるながらもがいてるシーンが欲しいです\n\n仰向けで、両手両足は曲げて、伸ばそうとして全力で内壁に突っ張ってる、尻もちょっと上げて、全身が丸まってる感じでお願いします。\n\n触手は乳首、たま、尿道とアナルを弄って、表情は快感に耐え難い絶望の泣き顔。足フェチですので、片足の足指も小さい触手何本に纏まれて欲しいです。そして足裏、玉、アナルとペニスが全部見えるアングルで、立方体外の視角でお願いします。\n\nもしよかったら、tシャツだけは残ってください。\n\nご検討いただけますと幸い、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WMiXYzVixGeFfI53mI5jQgJL_r0qrLNj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@buretaro/works/11", "thumbnail_src": "https://si.imgix.net/58e8e963/uploads/origins/c5e51cf9-7b92-44e4-a65c-fe9ef5cfb57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f448596d1d82caccb756e3de180ce903", "thumbnail_srcset": "https://si.imgix.net/58e8e963/uploads/origins/c5e51cf9-7b92-44e4-a65c-fe9ef5cfb57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f448596d1d82caccb756e3de180ce903, https://si.imgix.net/58e8e963/uploads/origins/c5e51cf9-7b92-44e4-a65c-fe9ef5cfb57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7a0e60aaa9edc41524b663148327667c 2x, https://si.imgix.net/58e8e963/uploads/origins/c5e51cf9-7b92-44e4-a65c-fe9ef5cfb57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cc