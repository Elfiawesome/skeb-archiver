font=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfe949fd7ffe7054bafe1323453437c7 2x, https://si.imgix.net/0dd2fc95/uploads/origins/7cc1ee53-e9f4-4f16-b8e5-d9f427e3ef8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4e649a2eafd3ea253faf05f3b95ae41 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MatyaUma/works/7", "thumbnail_src": "https://si.imgix.net/4c54230b/uploads/origins/5ee1c7fe-9818-4ec1-b4d2-dcc3f59fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1efdc7d13557299ba57d754b0f13267e", "thumbnail_srcset": "https://si.imgix.net/4c54230b/uploads/origins/5ee1c7fe-9818-4ec1-b4d2-dcc3f59fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1efdc7d13557299ba57d754b0f13267e, https://si.imgix.net/4c54230b/uploads/origins/5ee1c7fe-9818-4ec1-b4d2-dcc3f59fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce2611671c1537ad348bcffb6b4f4df7 2x, https://si.imgix.net/4c54230b/uploads/origins/5ee1c7fe-9818-4ec1-b4d2-dcc3f59fc7f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91d70ade15c13f9a37f9e6ec74d4daaa 3x", "genre": "art", "nsfw": false, "body": "こんにちは、1℃様！！あなたの作品がとても好きです。私のオリジナルキャラクターの絵を描いていただきたいのですが。\n\n⚪白い髪の子：15歳で、ずっと昔に死んでしまったが、黒髪の男によって蘇らされた。コミュニケーションが苦手で、現在のすべてのものに興味を持っている。黒髪の男の血を食べて生きている。\n\n⚫黒髪の子：18歳で、右目は瞳孔の色が赤い義眼（片目として描ける）をしており、顔には自分でナイフで切った傷がある。いつも笑顔を浮かべており、自分が長くは生きられないことを知っていてもなお楽観的である。\n\n二人の感情：白はとても名高い宗師であるにも関わらず、生涯の記録を一切残していない。黒は、白があまりにも高い位置に立ち、真にこの世界を見たことがないため、死をもって現実の世界から逃れていると考えています。そのため、白を復活させ、彼にこの現実の世界をしっかりと見せたいと思っています。同時に、黒自身も真の白を見たいという願望を持っています。白も黒の行動や考えが面白いと感じたので、二人は名を隠して平凡で騒がしい生活を送っている。黒は白に対して非常に直接的で、ほとんど何でも話すが、ただ一つだけどう切り出せばいいかわからないことがある。それは、彼らの命が繋がっているということ、黒はほとんど自分の命を燃やし尽くして白を復活させたため、彼らには残り二年しか生きられないということだ。\n\n\n\n\n閲覧お疲れ様でした