imgix.net/1390d574/uploads/origins/584c1e68-4eac-463f-ab60-62546af22c66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=890e02b0cf38cbe9d265c2b80388864b 2x, https://si.imgix.net/1390d574/uploads/origins/584c1e68-4eac-463f-ab60-62546af22c66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3340449034309859d939dac65a89676 3x", "genre": "art", "nsfw": true, "body": "既存イラストのキャラ変更でリクエストします。\n・ベースの既存イラスト https://skeb.jp/@okamotofujio/works/31\n・変更後のキャラ ハピネスチャージプリキュア!のクイーンミラージュ( https://www.toei-anim.co.jp/tv/happinesscharge_precure/images/character/genei01/detail.png )\n・衣装 服部分、スカートの黒い部分、白い部分はそれぞれ別パーツ、白い部分を外すとパンチラするイメージ\nまた、中に黒と白のボーダー柄の穴あきビキニ(形状はベースイラスト2枚目のイメージ)も描いてください。\n・体型 爆乳&ムチムチ\n・その他の要望 顔のデザインはおかもと先生のオリジナル、psdで服部分をパーツごとに脱がしていく感じの差分もお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@okamotofujio/works/46", "thumbnail_src": "https://si.imgix.net/922f622c/uploads/origins/14f5f494-163e-4bb3-96fe-c807b89b0a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7248c1adf3443140f4c604c170ee1ea", "thumbnail_srcset": "https://si.imgix.net/922f622c/uploads/origins/14f5f494-163e-4bb3-96fe-c807b89b0a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7248c1adf3443140f4c604c170ee1ea, https://si.imgix.net/922f622c/uploads/origins/14f5f494-163e-4bb3-96fe-c807b89b0a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d303958bad3dbb3226c7c58275962e2e 2x, https://si.imgix.net/922f622c/uploads/origins/14f5f494-163e-4bb3-96fe-c807b89b0a9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1a59b27f540af49e5f29949062d2c2c 3x", "genre": "art", "nsfw": true, "body": "CG集にはいつもお世話になっております。\nこちら(https://skeb.jp/@okamotofujio/works/20)のような作品をアルカナハートのペトラとソウルキャリバーのソフィーティアで描いていただけないでしょうか？\n\nペトラ(パンツはおまかせ・銃は省略)\nhttps://www.arcsystemworks.jp/ah3lm/character/img/Petra_Johanna_Lagerkvist.png\nhttps://img.atwiki.jp/arcanaheart3/attach/33/1028/petora.jpg\n\nソフィーティアの衣装はソウルキャリバー、ソウルキャリバーⅡ、ソウルキャリバーⅣのどれか(パンツは白系で・武器や盾は省略)\nhttps://pbs.twimg.com/media/DQzlwIlW4AEPUUx.jpg:large\n\n二人とも参考作品同様おっぱいを出したりパンツをずらす差分もお願いします。\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@okamotofujio/works/45", "thumbnail_src": "https://si.imgix.net/a4d852fb/uploads/origins/9cff6491-9cca-4d8c-8634-18de81f888ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9c6b95753637141b2aa1ea4652df000", "thumbnail_srcset": "https://si.imgix.net/a4d852fb/uploads/origins/9cff6491-9cca-4d8c-8634-18de81f888ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9c6b95753637141b2aa1ea4652df000, https://si.imgix.net/a4d852fb/uploads/origins/9cff6491-9cca-4d8c-8634-18de81f888ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79b35cac50a0b8a5ed533f327bc31b8e 2x, https://si.imgix.net/a4d852fb/uploads/origins/9cff6491-9cca-4d8c-8634-18de81f888ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04c8284c4315c2fd03560663824fa068 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@okamotofujio/works/44", "thumbnail_src": "https://si.imgix.net/88644ec7/uploads/origins/a0964687-dc4f-4e85-b3c8-66190198a621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d313e40c386e8ca7cec8bfe26b4f587", "thumbnail_srcset": "https://si.imgix.net/88644ec7/uploads/origins/a0964687-dc4f-4e85-b3c8-66190198a621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d313e40c386e8ca7cec8bfe26