2-4544-8e2a-8eb56238d3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6524542f9415a249b972194078e35d87 2x, https://si.imgix.net/c6eca9f4/uploads/origins/a76eb701-97c2-4544-8e2a-8eb56238d3d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe422a128acac91b8d01c52c6c4adb81 3x", "genre": "art", "nsfw": false, "body": "Vtuberとして活動しております、のりまきゆずゆと申します。\nゆる🐟様に、ぜひ自身も描いていただけたら...とリクエストさせていただきました！\n\n▼内容\n・差分などいただけたら大変嬉しいです。\n・表情は元気過ぎないものが好みです。\n　(クーデレ、ジト目、微笑み、ぽやっと、眠たげ....etc)\n・髪型は資料内にあるボブのデザインでお願いします。\n・衣装カラーは２種ありますが、紺色の方でお願いします。\n　うさぎのフードは無しでお願いします。\n・その他お好きな組み合わせ、構図、ポーズでお願いします。\n・顔周りや髪の毛等が見切れないように描いていただけると、サムネイル等で使用しやすくありがたいです。\n\n▼その他\n・キャラクターを分けたpsdファイル、もしくは透過ファイルで分けていただけると大変ありがたいです。\n・またファンボックスでの投稿が行えたら、させていただきたいです。\n\n\n▼資料URL\nhttps://drive.google.com/drive/u/0/folders/1DVlGaxX3Oi_B9Hsy90BrnAc_gVT3ijKi\n\nhttps://drive.google.com/drive/u/0/folders/1DVlGaxX3Oi_B9Hsy90BrnAc_gVT3ijKi", "created_at": "", "completed_at": ""}, {"path": "/@ymm007xx/works/77", "thumbnail_src": "https://si.imgix.net/3eb2783e/uploads/origins/7f3b7693-982d-4ad0-a386-d89278f06fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=780f921835919dad5908ecd8c1ce76b3", "thumbnail_srcset": "https://si.imgix.net/3eb2783e/uploads/origins/7f3b7693-982d-4ad0-a386-d89278f06fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=780f921835919dad5908ecd8c1ce76b3, https://si.imgix.net/3eb2783e/uploads/origins/7f3b7693-982d-4ad0-a386-d89278f06fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=addf28baa444cdedaeec9ba9d7674391 2x, https://si.imgix.net/3eb2783e/uploads/origins/7f3b7693-982d-4ad0-a386-d89278f06fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa79bf0d2bb0cb035ace2e30c92e75b1 3x", "genre": "art", "nsfw": false, "body": "是非ゆる先生に描いていただきたいうちの子がおり、リクエストさせていただきます✨\n\n\nキャラクター詳細\n・白銀のロングヘアで、猫っ毛っぽい。\n・瞳は銀と紫のオッドアイ。右目の下に涙ボクロがあります。\n・黒いダボダボのカーディガン。\n見た目はクール&キュートというイメージですが、絵本好きだったり甘いものが好きだったりと中身はかなり子供っぽいです。趣味は空を眺めることです。無表情っぽい子ですがそれなりに笑ったりもします。\n\nhttps://drive.google.com/drive/mobile/folders/1WnT-nBumIL66QEdDIDssx1LlNdFjxbYR?usp=sharing\n\n構図やシチュエーションなどはお任せします！\nご検討いただけますと幸いです🙇‍♀️\n\nhttps://drive.google.com/drive/mobile/folders/1WnT-nBumIL66QEdDIDssx1LlNdFjxbYR?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ymm007xx/works/76", "thumbnail_src": "https://si.imgix.net/ccfbf10b/uploads/origins/70b6342c-e6bf-42e7-b697-fe605d304b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=452248eb7c630f18d27fc48dab5a8ff9", "thumbnail_srcset": "https://si.imgix.net/ccfbf10b/uploads/origins/70b6342c-e6bf-42e7-b697-fe605d304b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=452248eb7c630f18d27fc48dab5a8ff9, https://si.imgix.net/ccfbf10b/uploads/origins/70b6342c-e6bf-42e7-b697-fe605d304b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75dcfb2806be412d5bfb52f2565b1123 2x, https://si.imgix.net/ccfbf10b/uploads/origins/70b6342c-e6bf-42e7-b697-fe605d304b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70cf481784d5a4a00615521ba859d4dc 3x", "genre": "art", "nsfw": false, "body": "ゆる様 はじめまして！ 作品めちゃめちゃ可愛いです…！！\n\nゆりかわゆんちゃんを描いていただけたら嬉しいです。\n\n自称アンドロイドの女の子です。\n普段は少し内気な感じで、読書やゲームが好きです…！！\n新衣装は魔法少女×アイドルっぽい衣装で少し明るい自分を出してみる！というイメージです…！！\n\n【使用用途】\nSNSでの投稿や、配信/動画で使用させていただきたいです。\n\n【二面図】\nhttps://x.com/yun_yurikawa/status/1855923245364752473\n\n【新衣装】\nhttps://drive.google.com/drive/folders/1mawPwwayLCCVitDDrRDMbPdCgkwoc0CX?usp=drive_link\n\n・通常衣装でも新衣装でも嬉しいです。\n・通常衣装のジャケットの有無や、髪型の希望も無いです！お任せしたいです！\n通常衣装の場合は、読書中にこっちを見てくれた感じだと嬉しいです…！（ゆる様のイラスト全部好きなのでシチュおまかせでも嬉しいです）\n\n・新衣装の場合は、ステッキがあると超嬉しいです…！！！\nピンチ系も少し見てみたいです…！！！！\n\n・頭部が見切れないようにしていただけますと幸いです。\n・PSDでいただけたらすごく嬉しいです。\n\n何卒ご検討のほどよろしくお願いいたします…！", "created_at": "", "completed_at": ""}, {"path": "/@ymm007xx/works/75", "thumbnail_src": "https://si.imgix.net/1f30