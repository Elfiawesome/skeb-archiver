4-fe180e2ff3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55574d179115c0a72348205571b70e70 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/10", "thumbnail_src": "https://si.imgix.net/8cade170/uploads/origins/2ccfe5cc-d890-4ef7-9c6b-08a3848783ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fbdd5c5c068eae047cb789ff1aede79", "thumbnail_srcset": "https://si.imgix.net/8cade170/uploads/origins/2ccfe5cc-d890-4ef7-9c6b-08a3848783ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fbdd5c5c068eae047cb789ff1aede79, https://si.imgix.net/8cade170/uploads/origins/2ccfe5cc-d890-4ef7-9c6b-08a3848783ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01133b16bc2b631b060c666db6cb9390 2x, https://si.imgix.net/8cade170/uploads/origins/2ccfe5cc-d890-4ef7-9c6b-08a3848783ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e824847e5a20e6f4007ad876500b2c4 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nイラストが好みなので向井拓海のイラストの依頼をお願いしたいです。\n\nポーズや水着は姫川友紀のイラストと同じ感じで水着を口ブラしているポーズでお願いします。\nhttps://skeb.jp/@Tonzura0920/works/5\n\nエロバライティの罰ゲームで10分間くすぐられ我慢する内容でお願いします。\n・羽根箒や筆などで首､腋､脇腹､太ももなどをくすぐられる。\n・歯を食いしばってギリギリ笑わないように我慢している。\n・拓海はくすぐりにめちゃくちゃ弱い設定でお願いします。\n・「こちょこちょ」などの擬音を散りばめてください。\n・外野からの声援もお願いします。\n・TV番組っぽく屈辱感を煽るような感じのテロップをお願いしたいです。\n\n可能であれば我慢できずに笑ってしまい水着が脱げてしまう差分をお願いします。\nセリフや擬音はレイヤーを分けて頂けるとありがたいです。\n\nマニアックな依頼となってしまい恐縮ですがご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/9", "thumbnail_src": "https://si.imgix.net/76e72e8d/uploads/origins/b5e856f3-6b3d-435b-8078-4f58d53ac1bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c821eb330459cc0db4e9f66597dfbe7", "thumbnail_srcset": "https://si.imgix.net/76e72e8d/uploads/origins/b5e856f3-6b3d-435b-8078-4f58d53ac1bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c821eb330459cc0db4e9f66597dfbe7, https://si.imgix.net/76e72e8d/uploads/origins/b5e856f3-6b3d-435b-8078-4f58d53ac1bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68b644ed60c6a0155c6dce2906e6eff1 2x, https://si.imgix.net/76e72e8d/uploads/origins/b5e856f3-6b3d-435b-8078-4f58d53ac1bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bf275f9121b789b397df85ef2dc288c 3x", "genre": "art", "nsfw": true, "body": "前回はとてもHな凪ちゃんをありがとうございました！今回はシンデレラガールズの本田未央をお願いします！\n\n衣装　ヒモ水着やマイクロビキニ。デザインはお任せします。\n\nシチュ\n凪の時と同じような感じのエロバラエティで罰ゲーム、もしくはなんらかの企画でピストンバイブで責められる所をお願いします。\nピストンバイブは https://www.pixiv.net/artworks/73699789 ←のような感じ、もしくは資料URLの上部でまゆを責めているような物を持ったスタッフがガニ股立ちした未央の股下から責めているような感じ、でお願いします。\nどちらにせよ前回の凪の時より激しめの雰囲気で、膣に挿入されたバイブが激しく上下し、未央は乳首が水着から零れるくらい身をよじらせながら大きく絶頂し「まって無理無理！もうイってる！イってるから！」等と叫んでいるような感じで。\n\n以上よろしくお願いします！\n\n他\n・バイブの挿入は水着をずらして挿入してください。\n・胸は少し大きめでお願いします。以前描いていたユッキより少し大きいぐらいで。\n・可能であればユッキの時のような外野からの声援があると嬉しいです。\n・スタッフを描く場合は最低限の描写で大丈夫です。\n・上記セリフも自由に変更して頂いて大丈夫です。\n\n以上よろしくお願いします！\n\nhttps://www.pixiv.net/artworks/86947653", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/8", "thumbnail_src": "https://si.imgix.net/f7a3428d/uploads/origins/501d7447-3471-4906-929a-be2b715d0de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14b383c761e8314c5d037f0bdbffa909", "thumbnail_srcset": "https://si.imgix.net/f7a3428d/uploads/origins/501d7447-3471-4906-929a-be2b715d0de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14b383c761e8314c5d037f0bdbffa909, https://si.imgix.net/f7a3428d/uploads/origins/501d7447-3471-4906-929a-be2b715d0de2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff9f722baed96c4af1aca11b7d8e89cb 2x, https://si.imgix.net/f7a3428d/uploads/origins/501d7447-3471-4906-929a-be2b715d0de2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc17cc1d658041f7c810ea0be6b228eb 3x", "genre": "art", "nsfw": true, "body": "最高にエロい作品を拝見したのでコミッションをお願いさせていただきたいです。\nお願いしたいキャラはデレマスの鷺沢文香。描いていただきたい作品の内容は、エロバラエティー番組の罰ゲームといった雰囲気で文香が両手に淫語を描いた扇子を持って裸踊りを行っているものをお願いしたいです。裸踊りの参考に添付画像をご覧ください。文香の衣装は先生のお好みのものでお願いしたいです(全裸でももちろん大丈夫です)。可能なら文香の腋や陰毛は剛毛にしてもらえると嬉しいです。\n\nhttps://imgur.com/a/SLeMef9", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/7", "thumbnail_src": "https://si.imgix.net/9f9e5936/uploads/origins/0ce8363d-26c8-4697-9550-caaa26364a33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aba039b7a1641422175f972f964bfbe4", "thumbnail_srcset": "https://si.imgix.net/9f9e5936/uploads/origins/0ce8363d-26c8-4697-9550-caaa26364a33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aba039b7a1641422175f972f964bfbe4, https://si.imgix.net/9f9e5936/uploads/origins/0ce8363d-26c8-4697-9550-caaa26364a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b7c8dbef53ce94b7162276b32d00709 2x, https://si.imgix.net/9f9e5936/uploads/origins/0ce8363d-26c8-4697-9550-caaa26364a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f2045ca74e806a5f7da0f9c0f4779e4 3x", "genre": "art", "nsfw": true, "body": "初めまして！ユッキの電マチャレンジがとても素晴らしかったので依頼させていただきます！同じくシンデレラガールズの久川凪をお願いします！\n\n衣装　ヒモ水着やマイクロビキニ。デザインはお任せします。\n\nシチュ\nユッキの時と似たような深夜番組のエロ企画や罰ゲームのような楽しげな雰囲気でシビアン（シビアンの詳細は資料URLで）に乗せられている所をお願いします！\nセリフは「イってるから早くおろして」や「そ、そろそろはーちゃんと交代を…」などのセリフをお願いします。\n\n以上よろしくお願いします！\n\nhttps://twitter.com/ura_macoto/status/1379429088113270788", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/6", "thumbnail_src": "https://si.imgix.net/667d23c7/uploads/origins/63aecace-7e20-40c6-acb7-996ff62e76fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec21d4fe4b583cb368ffa4875d0b9eea", "thumbnail_srcset": "https://si.imgix.net/667d23c7/uploads/origins/63aecace-7e20-40c6-acb7-996ff62e76fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec21d4fe4b583cb368ffa4875d0b9eea, https://si.imgix.net/667d23c7/uploads/origins/63aecace-7e20-40c6-acb7-996ff62e76fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca4ce22c0ec2f46dd9e2f10b34d65699 2x, https://si.imgix.net/667d23c7/uploads/origins/63aecace-7e20-40c6-acb7-996ff62e76fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=674de87952845543ea3436beeeedd90e 3x", "genre": "art", "nsfw": true, "body": "前回は早苗のエッチな絵ありがとうございました\nアイドルマスターシンデレラガールズより安部菜々をリクエストします\nコンセプトはウサミンが劇場版機動戦士ガンダムSEED公開記念のコラボに\nコスプレをするもその服（特に胸元）がサイズが小さかったのか胸元の留め金具がぼんっと飛んで\nファンの皆におっぱいをさらしちゃう、というものです\n（背景というか舞台がソフマップの壁？）\nおっぱいの大きさは原作よりも大きめの爆乳サイズ（前回の早苗のような爆乳で良いです）\n恰好はURLの画像の軍服＋ウサミンのいつものウサミミ装着です\n\n前回の早苗の絵と同じ真正面アングルで敬礼してます\n画像右のように胸元がピチピチパツパツいってる感じになってる中\n「このアニメとても懐かしいです！ナナがちゅうｇゲフンゲフンッ」と言ってる最中に留め金具ボンッ\nノーブラでやってたのか生爆乳おっぱいが飛び出してわわっと驚いてファンがうおおおおおお！となるも\n敬礼をし続け頬を赤くしながらも「劇場版機動戦士ガンダムSEEDをよろしくお願いします♪」とウインクする・・・ような流れでお願いします\n\nhttps://www.dropbox.com/scl/fi/7g990dh2pwj1x0095b5qd/2023_0907_0234_19954.png?rlkey=8v8jm3qnt3v33q023hwps83ip&dl=1", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/5", "thumbnail_src": "https://si.imgix.net/45bdf4aa/uploads/origins/634a9437-012a-44e8-b736-06a3b28c2059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88c30b7d84044b42dd08babee1b6ad83", "thumbnail_srcset": "https://si.imgix.net/45bdf4aa/uploads/origins/634a9437-012a-44e8-b736-06a3b28c2059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88c30b7d84044b42dd08babee1b6ad83, https://si.imgix.net/45bdf4aa/uploads/origins/634a9437-012a-44e8-b736-06a3b28c2059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb36f0a29d11659bfd238c710ff6589d 2x, https://si.imgix.net/45bdf4aa/uploads/origins/634a9437-012a-44e8-b736-06a3b28c2059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4d49667d8353a3be2c445f555c11a0c 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n\nPxivの透け水着のユッキがとてもエロかったので、ご依頼させて頂きました。\n\nマイクロビキニを着て、がに股立ちで電マ責めされる姫川友紀をお願いします。\n\n表情はこちらのユッキと同じ照れ顔\nhttps://www.pixiv.net/artworks/89243038\n\nポーズはこちらのような中腰ガニ股\nhttps://x.com/engawumai/status/1688618794770640896?s=46\n\nマイクロビキニはこちらの比奈と同じスリングショット系の物をお願いします。\nhttps://www.pixiv.net/artworks/82051543\n\nhttps://pics.dmm.co.jp/digital/video/1svnnp00001/1svnnp00001jp-18.jpg\n背景は透け水着のイラストや上記URLの画像のような感じで、深夜番組のエロ企画や罰ゲームのような楽しげな雰囲気にして頂けると嬉しいです。\n\nセリフは透け水着のイラストと同様に吹き出し無しの「ドヒ〜///」や「やば...//// 濡れてきたかも...///」などのセリフをお願いします。\n\n可能であれば全裸差分をお願いします。\nセリフや擬音はレイヤーを分けて頂けるとありがたいです。\n\nお願いの多い依頼となってしまい恐縮ですが\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/4", "thumbnail_src": "https://si.imgix.net/b0a0468e/uploads/origins/16076508-b3d1-4eef-8924-c1212418f124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50276927bcfbcbe7e3cf04b04cb4192b", "thumbnail_srcset": "https://si.imgix.net/b0a0468e/uploads/origins/16076508-b3d1-4eef-8924-c1212418f124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50276927bcfbcbe7e3cf04b04cb4192b, https://si.imgix.net/b0a0468e/uploads/origins/16076508-b3d1-4eef-8924-c1212418f124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2538302bad78dc8d603eaea6a291b814 2x, https://si.imgix.net/b0a0468e/uploads/origins/16076508-b3d1-4eef-8924-c1212418f124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c31992816c71350f388db25cf8750b3 3x", "genre": "art", "nsfw": true, "body": "デレマスの片桐早苗さんをお願いします。\n　　　　　　↓以下内容です↓\n　コスチュームはセクシーギルティのボディコン衣装で脱がさずにお願いします。\n　体勢は両手を手錠で拘束されて仰向けに寝かされたた状態。↓\nhttp://blog.livedoor.jp/enzuigiri0226/archives/67096748.html\n\n　コスチュームには黒い液体をかけられて顔や髪や肌も含めてあちこちが汚れてしまっている。\n↓\nhttps://livedoor.blogimg.jp/ryonamoon/imgs/a/2/a214c610.jpg\n\n　コスチュームのベルトにあるハート型エンブレムには敗北の証の様に同じ液体で✖️印が描かれてしまっている。\n　別カットで✖️が描かれたエンブレムのアップを描いて下さい。\n　可能であれば縦書きで早苗さんは全身を描いて頂きたいです。\n　表情は頬を赤らめ、目に少し涙をためて悔しそうな感じでお願いします。\n　セリフの有無はお任せします。もし書いて頂けるのであれば敵が無様な姿の早苗を嘲笑っている感じでお願いします。\n　一応ですがNSWにしておきます。\n　乳首は立てずに普通でお願いします。\n\n　シチュエーションとしては、ギルティ星人に敗北し、コスチュームや身体を汚されてしまった早苗。象徴のエンブレムには敗北の証として✖️が描かれてしまっている。\n　という感じです。\n\n　なかなかマニアックなお題で申し訳ありませんが、是非ご検討の程宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/3", "thumbnail_src": "https://si.imgix.net/2bd73f7c/uploads/origins/05257d9c-4c58-412a-b098-0fe9a4dd6bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b451236ec1deb80a250b3e3082021390", "thumbnail_srcset": "https://si.imgix.net/2bd73f7c/uploads/origins/05257d9c-4c58-412a-b098-0fe9a4dd6bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b451236ec1deb80a250b3e3082021390, https://si.imgix.net/2bd73f7c/uploads/origins/05257d9c-4c58-412a-b098-0fe9a4dd6bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ce767b12fbaebc43426ae8d6e2f03ef 2x, https://si.imgix.net/2bd73f7c/uploads/origins/05257d9c-4c58-412a-b098-0fe9a4dd6bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b19dfab54425580f6297d95f381ed70d 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nよろしければ、成人池袋晶葉ちゃんがマッサージ用に改造したマジックハンドが暴走し、参考資料（https://twitter.com/areUhentai/status/1188775670844932098?s=20）のようにマジックハンドに拘束された状態で陥没乳首をコリコリ穿られ（陥没乳首を責めている透過描写もお願いします）めちゃくちゃに感じてしまうシチュをお願いします。\n差し支えなければ、乳首イキ差分もあると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/2", "thumbnail_src": "https://si.imgix.net/7fe0041d/uploads/origins/cb1689e3-2f0a-43a1-9e66-996e98712c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcbcb123d323f2b97cc7aefe9abd8f91", "thumbnail_srcset": "https://si.imgix.net/7fe0041d/uploads/origins/cb1689e3-2f0a-43a1-9e66-996e98712c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcbcb123d323f2b97cc7aefe9abd8f91, https://si.imgix.net/7fe0041d/uploads/origins/cb1689e3-2f0a-43a1-9e66-996e98712c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d8f46901a9444b6d624cb5b7ae49445 2x, https://si.imgix.net/7fe0041d/uploads/origins/cb1689e3-2f0a-43a1-9e66-996e98712c1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e214442df540e76a43e1c7f1c4513ce 3x", "genre": "art", "nsfw": true, "body": "及川雫をお願いしたいです。\n衣装はモバマスの[ビーチガール]特訓後のビキニで、プロデューサーと生中出しセックスを楽しんでいる所です。\n衣装参考　https://imas.gamedbs.jp/cg/idol/detail/151?h=cb6e0046c38105c34bf814d7de9faf54\n\n・体位はお任せします。\n・ビキニトップは下か横にずらしたまま、パンツはずらし挿入でも脱がせても構いません。\n・既に何度も中出ししており、竿に精子がこびりついていて、突く度に膣内に残った精子が音を立てて溢れてる描写を付けて欲しいです。\n・可能であれば、「もっと精子下さい…」的なセリフもあると嬉しいです。\n・差分として、更に中出ししてる最中のものもお願いします。\n・更に可能であれば、余韻に浸ってる差分（竿を引き抜いて大量の精子が溢れ出す、挿入したまま緩やかに射精してる）があると嬉しいです。\n\nご検討のほど、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Tonzura0920/works/1", "thumbnail_src": "https://si.imgix.net/3db0cbb8/uploads/origins/d1203970-9707-438a-b054-28f040f3c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c24ae175aa224665afd8acb606581d7", "thumbnail_srcset": "https://si.imgix.net/3db0cbb8/uploads/origins/d1203970-9707-438a-b054-28f040f3c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c24ae175aa224665afd8acb606581d7, https://si.imgix.net/3db0cbb8/uploads/origins/d1203970-9707-438a-b054-28f040f3c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d8198bd003b999e7caa1c9474e6e1f0 2x, https://si.imgix.net/3db0cbb8/uploads/origins/d1203970-9707-438a-b054-28f040f3c49f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3652882384758a46ce1f7aa544ae7c5 3x", "genre": "art", "nsfw": true, "body": "アイドルマスターシンデレラガールズより片桐早苗をリクエストします\n初期ノーマルカードNに当たる警官制服姿にスタンダードの婦人警官帽を被せて\n真正面アングルで乳首部分に星型のニップルシールをつけたおっぱいを晒しながら敬礼する絵をお願いします\nおっぱいの大きさは原作よりも大きめの爆乳サイズ\n表情はhttps://www.pixiv.net/artworks/85232792と同じにしてください\nちなみに可能でしたらシール無し差分をお願いします", "created_at": "", "completed_at": ""}]}