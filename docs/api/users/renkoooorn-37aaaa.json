774d39cffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b397fe5ccdc731636efc366c6fa585c, https://si.imgix.net/680bae8c/uploads/origins/a3c12331-c52a-4a77-8d43-71774d39cffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c231db0215a13fe78e1a9728c6bf0c1 2x, https://si.imgix.net/680bae8c/uploads/origins/a3c12331-c52a-4a77-8d43-71774d39cffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adcaa74ec084610fd3e8b05079a0a44a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの作品のファンで、あなたにお願いがあります。\n\nキャラクターはアイドルマスターの七尾百合子です！友人へのプレゼント用なので、資料フォルダの中にはお気に入りの衣装を集めています。お好きなものをお選びください。\n\nシナリオは彼女がステージでパフォーマンスするものです。ステージには大きなスクリーンをつけてほしい。スクリーンには \"AlkaidP!\"と書いてほしい。\n\nそのほか、この作品にはどんなことでも自由にやってください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1eLkfA2KcGsb9aWjjC9wya-ErrApuF2ID?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@renkoooorn/works/40", "thumbnail_src": "https://si.imgix.net/07e17af2/uploads/origins/1f8c8a44-246d-41ac-be77-dfaeb9f42208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e608056574dc2a8213d035ff7d68aa9a", "thumbnail_srcset": "https://si.imgix.net/07e17af2/uploads/origins/1f8c8a44-246d-41ac-be77-dfaeb9f42208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e608056574dc2a8213d035ff7d68aa9a, https://si.imgix.net/07e17af2/uploads/origins/1f8c8a44-246d-41ac-be77-dfaeb9f42208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef5806a9232d85c3afd88e43f9f0131d 2x, https://si.imgix.net/07e17af2/uploads/origins/1f8c8a44-246d-41ac-be77-dfaeb9f42208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13504b786d6b2d30178867c68fb30267 3x", "genre": "art", "nsfw": false, "body": "リクエストに応えてくれてありがとう！\n\nVtuberのReddyを描いてください！彼は南極で研究をしている植物科学者です。彼が防寒具を着て外で雪を楽しんでいるアートをお願いしたいです。できれば、地面に雪の天使を作ってほしい。そうでなければ、他のポーズを自由に選んでください。\n\n彼の頭の上の植物も生きているので、暖かくする必要がある。\n\nhtt