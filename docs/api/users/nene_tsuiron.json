9-4c60-987e-9a81a2a036cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1ff631c5ff3e1206e80a524ca865217, https://si.imgix.net/10f1fdd4/uploads/origins/3dc90129-a939-4c60-987e-9a81a2a036cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1891f8ca24538537567eb18105b4698e 2x, https://si.imgix.net/10f1fdd4/uploads/origins/3dc90129-a939-4c60-987e-9a81a2a036cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6a681c4ce041a8b2c5e6f31c27d6f79 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nene_tsuiron/works/19", "thumbnail_src": "https://si.imgix.net/2d6deb61/uploads/origins/ca0c92f3-0d85-4d94-aa07-c6e36432d724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820272aa2821e7383ae0102f5c796a9b", "thumbnail_srcset": "https://si.imgix.net/2d6deb61/uploads/origins/ca0c92f3-0d85-4d94-aa07-c6e36432d724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820272aa2821e7383ae0102f5c796a9b, https://si.imgix.net/2d6deb61/uploads/origins/ca0c92f3-0d85-4d94-aa07-c6e36432d724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35c1f711abafe72c4054aa7b9ee74c37 2x, https://si.imgix.net/2d6deb61/uploads/origins/ca0c92f3-0d85-4d94-aa07-c6e36432d724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79535e4ada9a1c5d4f6928565d5210cb 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。紫苑です。\n今回は前回発注したキャラの単体での依頼となります。親御様の許可は得ておりますので、今回も改めて資料の添付をさせていただきます。以下、キャラクターの説明となります。\n\n名前：落枝清くん\n\n１７歳、男、１８０ｃｍ、ウエディングプランナー\n\nノリがよくて社交的。基本的に落ち着いて大人びている人ですが、ふざけ始めると誰よりも男児になります。周りをとてもよく見ていて、相手に合わせて動ける人。自分が楽しく、かつ、その中で周りにとって最善を選べる人です。性質自体が善性の人いうわけでもないですが、善性のある人間はこういう行動を取る、の判断のできる人。頭の回転が早くて要領がよく、口もよく回り、説得力を持って話すことが得意、また、人を楽しませるようなちょっとした特技も多く持っており、他人を巻き込むのがうまく、人の好感や信頼を集めやすい性質。自身が人からどう見えるかについても非常に自覚的で、また、自身の能力の高さにも一定の自負のあるタイプ。前述の、その場での最適解を選んで自分の過ごしやすい場を作る性質と合わせ、自分より下の人間に庇護を与えたり、自身が役割を請け負ったりすることがあります。実際に能力に裏付けされた傲慢性とも言える動きで、宣言通りにその場を収められることも多いですが、いくらかの詰めの甘さも持ち合わせており、失敗することもしばしば。自分が詰めが甘い自覚もあるようで、失敗を引きずらず、これはこれでとすぐに前向きに切り替えられる強みがあります。基本的に、他人に親切に振る舞うのはそういった、こうあるべきの思考からの物ですが、一度懐に入れた相手に対しては甘い側面もあり、多少の不利益があっても自分が折れがち。自身が考えながら動く人なので、他人に対しても場の空気に合わせた振る舞いや思考を、それぞれのレベルで意識することを求める傾向にあり、意識を持てる人間を好みます。前向きな破滅願望の持ち主で、自身の努力が無駄に終わることにある種快感を覚えますが、成果を得ることにも素直に喜びを覚えるため、手をかけたものについてはどう転んでも自分に良い結果が返ってくるという、少し得な性質。ただし、プライドを持って物事に取り組んでいるため、その性質を理由に仕事を貶されることは嫌います。\n\n今回もいつも通り構図等はお任せいたします。お時間ありましたら、是非、お願いします。\n\nhttps://www.dropbox.com/scl/fo/7520pojcuu3xhxj6n1x0j/AFA7o2HWQdR60NEry8RBEfg?rlkey=iniru3hwyiab0m9nsrwow61mn&st=50r0b0wa&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@nene_tsuiron/works/18", "thumbnail_src": "https://si.imgix.net/8f0c92c3/uploads/origins/6e9f5594-8c1e-47bb-9ffc-c6996884e0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4aa278c511a2cbd38b5a626f9cccba6", "thumbnail_srcset": "https://si.imgix.net/8f0c92c3/uploads/origins/6e9f5594-8c1e-47bb-9ffc-c6996884e0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4aa278c511a2cbd38b5a626f9cccba6, https://si.imgix.net/8f0c92c3/uploads/origins/6e9f5594-8c1e-47bb-9ffc-c6996884e0c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9192055d57fb378f7bf570b87110b39b 2x, https://si.imgix.net/8f0c92c3/uploads/origins/6e9f5594-8c1e-47bb-9ffc-c6996884e0c3?bg=%23fff&auto=f