41f7-98a1-dbf2406d994f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d88f3ccf011af39d12b973130d48d1a 3x", "genre": "art", "nsfw": false, "body": "OC\n\n大きなネコ（紫）とオオカミ（グレー）！\nネコがオオカミの上でお昼寝しているのもかわいいです。\nでも、好きなように描いてください。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Ohs2CYGR9N3YA8iEf1fhFsn2Pxlt4c2j", "created_at": "", "completed_at": ""}, {"path": "/@hu_nhey/works/647", "thumbnail_src": "https://si.imgix.net/3ef6386a/uploads/origins/0f478424-d7a8-4ee3-aeea-e491a30ac53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02d4094d7d2f1113aa6a7d2ef782b872", "thumbnail_srcset": "https://si.imgix.net/3ef6386a/uploads/origins/0f478424-d7a8-4ee3-aeea-e491a30ac53b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02d4094d7d2f1113aa6a7d2ef782b872, https://si.imgix.net/3ef6386a/uploads/origins/0f478424-d7a8-4ee3-aeea-e491a30ac53b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23f828caa0469d7408f189f4ded26747 2x, https://si.imgix.net/3ef6386a/uploads/origins/0f478424-d7a8-4ee3-aeea-e491a30ac53b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e0dee7cda46cef164edeb8f7b6e28db 3x", "genre": "art", "nsfw": false, "body": "スケブ募集ありがとうございます！心待ちにしておりました。わやさんの描くイラストはどれも可愛らしくて大ファンです！\n\n依頼内容ですが、知人とのTRPGのOC2人組のケモ化イラストを依頼申し上げます。動物はおまかせ致します！\n\n▶OCの説明\n・彩奈\n20歳/165cm\nピンク髪/刈り上げ/ピアス/ストリッパー\nわがままで気ままなイメージ\nナガのことが大好き\n\n・ナガ\n28歳/178cm\n紫髪/緑目/研究者\n気だるげで飄々としているイメージ\n彩菜を可愛がっている\n\nタバコがモチーフとして入っているため、イラストに書き入れて頂けますと幸いです。\nご検討の程よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1s8BCqqKy060-eK1gSincgJacuYH1ZJPz", "created_at": "", "completed_at": ""}, {"path": "/@hu_nhey/works/646", "thumbnail_src": "https://si.imgix.net/a526f2ca/uploads/origins/46d6ce8d-3d26-4c15-ae19-c2af6dd647a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e9d3f4214b5406f921450a268f09e8c", "thumbnail_srcset": "https://si.imgix.net/a526f2ca/uploads/origins/46d6ce8d-3d26-4c15-ae19-c2af6dd647a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e9d3f4214b5406f921450a268f09e8c, https://si.imgix.net/a526f2ca/uploads/origins/46d6ce8d-3d26-4c15-ae19-c2af6dd647a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bfdd0a26154b2ef4bd7c169a4d4bd34 2x, https://si.imgix.net/a526f2ca/uploads/origins/46d6ce8d-3d26-4c15-ae19-c2af6dd647a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa30ad419203839a7ee2f0da260d9064 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nわや様の動物のイラストが大好きで、Skeb再開心待ちにしておりました！\nCoCTRPGの探索者（OC）の犬化イラストをお願いしたいです！\n\n①\n黒髪の子\n・23歳\n・177cm\n・細身\n・素直で単純。人懐っこい。からかうと拗ねる。\n\n②\n茶髪の子\n・27歳\n・180cm\n・体格が良い\n・元ヤンの気の良い兄ちゃん。優しいが、がさつ。\n\n関係性は刑事のバディです。\n構図やポーズはお任せします！ご検討宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1zZhZ3N2xee9uzFH1vNwihsxEnbsdHefr", "created_at": "", "completed_at": ""}, {"path": "/@hu_nhey/works/645", "thumbnail_src": "https://si.imgix.net/64647d46/uploads/origins/6f644dd8-3a98-4b10-acdb-90f069f7e705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9685280d7872c6c65e1377968af867", "thumbnail_srcset": "https://si.imgix.net/64647d46/uploads/origins/6f644dd8-3a98-4b10-acdb-90f069f7e705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a9685280d7872c6c65e1377968af867, https://si.imgix.net/64647d46/uploads/origins/6f644dd8-3a98-4b10-acdb-90f069f7e705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04c2f0b0e3354b5b12edcb96d3e11cb1 2x, https://si.imgix.net/64647d46/uploads/origins/6f644dd8-3a98-4b10-acdb-90f069f7e705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46a5d2878730a6500e3a1bd3a39caee3 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n今回もOCの獣化を描いていただきたくリクエストいたします。\n以下の2人の絡み絵をお願いします。\n \n◾︎設定\n夜の中華街でオウムの模型を売る2人。良き同僚だったが恋人になり、最近同棲を始めた。\n\n・李玖\n人懐こく愛嬌のある性格。ノリがいいが気分屋。寂しがり屋で嫉妬深い面も。\nイメージは猫。\n\n・冬偉\n穏やかなダウナーチル男。恋人を溺愛して可愛がっている。愛情表現はストレート。\nイメージはヤマネコ。\n\n◾︎使用用途\n・鑑賞\n・相方とのイラスト共有\n・個人的なグッズ制作\n・お名前とID記載の上SNSのヘッダーに使用する可能性がございます\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1aqZ1FHerE2vhWnqROR99z6CAfeU996Dq", "created_at": "", "completed_at": ""}, {"path": "/@hu_nhey/works/644", "thumbnail_src": "https://si.imgix.net/bb342720/uploads/origins/664baafa-e300-4743-a797-5296c0cd39b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53674b4b41cc028841bebc410a9cb466", "thumbnail_srcset": "https://si.imgix.net/bb342720/uploads/origins/664baafa-e300-4743-a797-5296c0cd39b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53674b4b41cc028841bebc410a9cb466, https://si.imgix.net/bb342720/uploads/origins/664baafa-e300-4743-a797-5296c0cd39b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8a90d4eab23e1286f153d93371b591a 2x, https://si.imgix.net/bb342720/uploads/origins/664baafa-e300-4743-a797-5296c0cd39b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ba8aee1f93924f1f9fe38c0b32b4674 3x", "genre": "art", "nsfw": false, "body": "お世話になっております、ﾜﾜと申します。\n先生に以前描いていただいたOCイラストがとても素敵だったので、別の衣装・構図でもう一度描いていただくことは可能でしょうか……！\n\n✦︎ キャラクター\n・八乙女 誠\n探偵。いつも余裕のある笑みを浮かべている。黒髪に白いメッシュが入っている。\n適当なことを言ったり軽口を叩くことも多いが、犯罪には真摯に向き合う真面目な性格。\n\n・小戸森 与一\n探偵助手。日本人とオランダ人のハーフで、金髪碧眼の美青年。\n性格は穏やか。人当たりが良く、誰にでも優しく接する。\n\n✦︎ 使用用途\n個人観賞用。\n\n以上ご検討のほど、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1H3U9jx-TboVex50yibmamJZ5dGPDzvfS?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hu_nhey/works/643", "thumbnail_src": "https://si.imgix.net/94a37883/uploads/origins/2502c1e8-4285-49ca-9c27-8c919650a999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96d580628e8b978dcd434b7d8d860906", "thumbnail_srcset": "https://si.imgix.net/94a37883/uploads/origins/2502c1e8-4285-49ca-9c27-8c919650a999?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&