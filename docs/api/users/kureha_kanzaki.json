4284-ae88-3f1c2e23a824?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09071466db6c833800127578d1eae136 2x, https://si.imgix.net/09ea18ae/uploads/origins/ea750da2-283d-4284-ae88-3f1c2e23a824?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba08d86106f72459cf3b249d77f1bd54 3x", "genre": "art", "nsfw": false, "body": "•抱き枕カバーを意識した感じの頭から足先までの全身構図　\n•縮小学園の副部長　ギガorテラサイズ\n•縮小都市or縮小大陸の上で仰向けになっている(都市か大陸かは描きやすい方で大丈夫です)\n•胸のサイズは凛ちゃんぐらい\n•ブレザー制服　ブレザーとシャツの上から真ん中にかけてのボタンは外れている状態\n•腕は胸を寄せて谷間を強調　谷間に小さなビル群or大陸があって潰してる感じ\n•片足は裸足　もう片足はソックス着用\nローファと片方ソックスは、適当に都市や大陸の上に置かれてる感じ(大変であればローファとソックスは省いても大丈夫です)", "created_at": "", "completed_at": ""}, {"path": "/@kureha_kanzaki/works/14", "thumbnail_src": "https://si.imgix.net/cf5ddb8d/uploads/origins/f9f5eada-3e30-4ef3-a465-1356ccb3603b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8384de96c66bf875d338494eefd3d921", "thumbnail_srcset": "https://si.imgix.net/cf5ddb8d/uploads/origins/f9f5eada-3e30-4ef3-a465-1356ccb3603b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8384de96c66bf875d338494eefd3d921, https://si.imgix.net/cf5ddb8d/uploads/origins/f9f5eada-3e30-4ef3-a465-1356ccb3603b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2fc0b37808db37bc89da4227c8e197e 2x, https://si.imgix.net/cf5ddb8d/uploads/origins/f9f5eada-3e30-4ef3-a465-1356ccb3603b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c284308ceaf5344bc2f20218db47f158 3x", "genre": "art", "nsfw": true, "body": "巨大な凛ちゃんを描いて欲しいです。\n・シチュエーション\n　凛ちゃんが大量の汗や唾液や吐息によって周りの都市や浮遊大陸を、体臭と汗や唾液の洪水で包んで支配する。巨大な胸で都市を挟んだりこびりつかせている。\n・格好\n　周囲の都市に座り込んでいる。服装は上着を脱いで、中の服は胸元を全開に（放熱して体臭を広範囲に広げるイメージ）。パンツ見えてると嬉しいです。\n・凛ちゃん\n　表情は人間を支配して喜んでいる、可能ならば口から唾液を出している。体の大きさはお任せいたします。胸や尻や太ももを盛ってくれると嬉しいです。\nもしよろしければ、お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kureha_kanzaki/works/13", "thumbnail_src": "https://si.imgix.net/cbc7168d/uploads/origins/c46e8739-4368-4510-a07e-ab1a19ddfa91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e03e2254d5f0f0b5c9b73b1bc7b9becb", "thumbnail_srcset": "https://si.imgix.net/cbc7168d/uploads/origins/c46e8739-4368-4510-a07e-ab1a19ddfa91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e03e2254d5f0f0b5c9b73b1bc7b9becb, https://si.imgix.net/cbc7168d/uploads/origins/c46e8739-4368-4510-a07e-ab1a19ddfa91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7b316b31cf2746b8708f4b5c5c568fc 2x, https://si.imgix.net/cbc7168d/uploads/origins/c46e8739-4368-4510-a07e-ab1a19ddfa91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ad58969f8d06aa74582f69a2c8ac6b4 3x", "genre": "art", "nsfw": false, "body": "巨大な東風谷早苗さんを描いて欲しいです。\nシチュエーションはス⚪︎イツリーみたいなタワーを胸に挟んで寝転びで街を胸で破壊してるシチュが見たいです。\n大きさは3000倍以上、胸のサイズは凛さんと同じくらいのサイズ、構図はアオリ、衣装は東方公式の巫女衣装でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kureha_kanzaki/works/12", "thumbnail_src": "https://si.imgix.net/38dc107f/uploads/origins/14cdc03d-4e45-4cf7-9765-e09d62956c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac2812e7dffb60016e61cde5ce9659b2", "thumbnail_srcset": "https://si.imgix.net/38dc107f/uploads/origins/14cdc03d-4e45-4cf7-9765-e09d62956c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac2812e7dffb60016e61cde5ce9659b2, https://si.imgix.net/38dc107f/uploads/origins/14cdc03d-4e45-4cf7-9765-e09d62956c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d18751968109ce0fe74157bb03b32f4 2x, https://si.imgix.net/38dc107f/uploads/origins/14cdc03d-4e45-4cf7-9765-e09d62956c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bbbddc102527a750a42d87aaa2a13c5 3x", "genre": "art", "nsfw": false, "body": "私のオリジナルキャラクター「オクタヴィア・プリンシピ」のギガサイズイラストを依頼させていただきたいです。\n\nキャラクター詳細は添付のファイルご確認お願い致します。\n\n希望するイラストの内容：\n・構図：おっぱいが自慢の子なので、おっぱいが強調される構図でお願いします。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14xFBx-RtS82VS24Q54OU_Z1txVoQrJDc?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kureha_kanzaki/works/11", "thumbnail_src": "https://si.imgix.net/bcb449dc/uploads/origins/b09b0d79-9af4-4b07-aa8a-0d421ff3e65c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=951019cc17c5194106e0a655f58db5b9", "thumbnail_srcset": "https://si.imgix.net/bcb449dc/uploads/origins/b09b0d79-9af4-4b07-aa8a-0d421ff3e65c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=951019cc17c5194106e0a655f58db5b9, https://si.imgix.net/bcb449dc/uploads/origins/b09b0d79-9af4-4b07-aa8a-0d421ff3e65c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=484450e3a2ac85efc75a793c4d7d04ea 2x, https://si.imgix.net/bcb449dc/uploads/origins/b09b0d79-9af4-4b07-aa8a-0d421ff3e65c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f99fec9c9140ea8bf1016f690bbfad6 3x", "genre": "art", "nsfw": false, "body": "•縮小学園の副部長\n•胸のサイズ　オリキャラ凛ちゃんなみ\n•ブレザー制服　ブレザーは前開き　シャツの上から真ん中にかけてのボタンは外れている状態\n•指で胸の谷間の真ん中を開けて谷間の中に浮遊大陸が入っている\n•次のシーンで、手とか腕で胸を寄せて大陸を潰している(予算が厳しければ腕を下ろしたバストアップだけでも大丈夫です)\n•予算が許されるのであれば、ミリサイズの小人に置き換えたシュリバージョンもあると嬉しいです　\n•表情は笑顔", "created_at": "", "completed_at": ""}, {"path": "/@kureha_kanzaki/works/10", "thumbnail_src": "https://si.imgix.net/2a59b1e4/uploads/origins/92577cdf-7c11-49ba-949a-73d1a2bb5f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c362a4a8dd9d1b1f7c7a71bea8a583", "thumbnail_srcset": "https://si.imgix.net/2a59b1e4/uploads/origins/92577cdf-7c11-49ba-949a-73d1a2bb5f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3c362a4a8dd9d1b1f7c7a71bea8a583, https://si.imgix.net/2a59b1e4/uploads/origins/92577cdf-7c11-49ba-949a-73d1a2bb5f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5eefd791cf0be4cc3519013bf6eb049f 2x, https://si.imgix.net/2a59b1e4/uploads/origins/92577cdf-7c11-49ba-949a-73d1a2bb5f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cba311fcaa8c8f44de4b104a973b413e 3x", "genre": "art", "nsfw": false, "body": "縮小学園の部長と副部長の2人\n制服シャツブレザー着用リボンはなしでも可。(オリキャラの沙那さんのような着崩し)\n胸のサイズは両者オリキャラの凛さんと同様ぐらい。表情は笑顔。2人の姿勢は少し前に前屈み。\n胸の谷間には縮小大陸が挟まってる。\n予算の都合次第で、大陸の代わりにビー玉サイズの惑星が挟まっていると嬉しいです。\n予算が合わなければ、部長のみでも可", "created_at": "", "completed_at": ""}, {"path": "/@kureha_kanzaki/works/9", "thumbnail_src": "https://si.imgix.net/51af6da9/uploads/origins/d04721e1-5020-4af0-ad26-b13ff3a25150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fe2512d30ce2e2d9c5aa47535f0171", "thumbnail_srcset": "https://si.imgix.net/51af6da9/uploads/origins/d04721e1-5020-4af0-ad26-b13ff3a25150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54fe2512d30ce2e2d9c5aa47535f0171, https://si.imgix.net/51af6da9/uploads/origins/d04721e1-5020-4af0-ad26-b13ff3a25150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76e1884913e3b56a3057b42792349982 2x, https://si.imgix.net/51af6da9/uploads/origins/d04721e1-5020-4af0-ad26-b13ff3a25150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa0f86f43252653fb458e303c959c2b2 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ホロライブの桐生ココの画像をリクエストしたいです。画像は正面からのアングルで、ココの胸の谷間にタイニーが挟まっているものです。タイニーは自由になろうともがき苦しんでいる。ココは見る者をにやにやしながら、指をタイニーにかざして、タイニーをもっと奥に押し込もうと脅している。\n\nありがとう。\n\nhttps://drive.google.com/drive/u/2/folders/1Reyg0d2HZ3jl9wIq2PQRGgBYyynDeW5c", "created_at": "", "completed_at": ""}, {"path": "/@kureha_kanzaki/works/8", "thumbnail_src": "https://si.imgix.net/96402695/uploads/origins/ce069c7b-0ce1-48a9-8cfd-31c70f7f45ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f86f477aa52c05da53f3838fda75426", "thumbnail_srcset": "https://si.imgix.net/96402695/uploads/origins/ce069c7b-0ce1-48a9-8cfd-31c70f7f45ff?bg=%23fff&auto=format%2Ccompre