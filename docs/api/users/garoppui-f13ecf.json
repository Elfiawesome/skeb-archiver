%2Ccenter&txtsize=30&txt=PRIVATE&s=7afab4e9842b65d9c1638cc274a238cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/15", "thumbnail_src": "https://si.imgix.net/9dfd1bb5/uploads/origins/980bbcb5-e09e-4c5f-bfdb-c933e7a953d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597a229a1d268d7be76e30539f5546e0", "thumbnail_srcset": "https://si.imgix.net/9dfd1bb5/uploads/origins/980bbcb5-e09e-4c5f-bfdb-c933e7a953d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597a229a1d268d7be76e30539f5546e0, https://si.imgix.net/9dfd1bb5/uploads/origins/980bbcb5-e09e-4c5f-bfdb-c933e7a953d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=364f42e926c0350cd6528d4d1c56259f 2x, https://si.imgix.net/9dfd1bb5/uploads/origins/980bbcb5-e09e-4c5f-bfdb-c933e7a953d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=451de1a6e6ab52fe0524b1cae2ca2cc3 3x", "genre": "art", "nsfw": false, "body": "こんにちは。  \n依頼文の微修正のため、キャンセル・再送大変失礼致しました。\n\nよければ資料フォルダ内“ｴﾙﾈｽﾀ･ｱｰﾚﾝｽ”(黒赤髪の方)を描いて頂きたいです。\n\n衣装を戦地へ行くような武装姿にデザインして頂きたいのですが、可能でしょうか。\n膝が出ていないなど、実用的な印象でお願いしたいです。\n時代感は定まっていませんが、携帯電話は無いような時代のイメージで武器も持たせて頂きたいです。(銃などについて疎く、具体的な指示が出来ず申し訳ありません。) \n\nメインカラーは元の衣装のような黒(暗いグレー)の印象で、元の衣装の要素が活かされているとより嬉しいですが、実用面を優先して頂けると幸いです。\n\n頂いたデザインは他の創作に使用させて頂く可能性があります。\nまた、イラストを個人使用の範囲で印刷させて頂く可能性もあります。\n\n金額不足等ありましたら再送申請を頂きたいです。\n\nお手数お掛けしますが、ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1EcEfI_4ssKC37WC1qFzYy1NBsfMYVXFz", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/14", "thumbnail_src": "https://si.imgix.net/df42fda8/uploads/origins/c5c708d1-0821-4e02-a7ac-aca2d4b3e8f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6c330e8e8bbede6a3571f78a6b7eae4", "thumbnail_srcset": "https://si.imgix.net/df42fda8/uploads/origins/c5c708d1-0821-4e02-a7ac-aca2d4b3e8f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6c330e8e8bbede6a3571f78a6b7eae4, https://si.imgix.net/df42fda8/uploads/origins/c5c708d1-0821-4e02-a7ac-aca2d4b3e8f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4136ec25a221e1978b4f036bf41bd2b8 2x, https://si.imgix.net/df42fda8/uploads/origins/c5c708d1-0821-4e02-a7ac-aca2d4b3e8f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2518c04a28e52342f6b63fb8d2c0efec 3x", "genre": "art", "nsfw": false, "body": "初めまして。がろっぷい先生の絵柄を毎度楽しませていただいております。\n今回、ご都合が付けば是非うちのこ(OC)の「ユーリヤ・ジヤチェンコ」のイラストを依頼したく存じ上げます。\n参考資料は添付URLをご確認ください。\n服装としては資料内の礼装を希望します。\nhttps://twitter.com/a_machun/status/1655015718692466688\nhttps://twitter.com/a_machun/status/1639259396810129409\n細かい箇所のアレンジはお任せします。\n宜しければご検討のほどよろしくお願いします。\n\nhttps://twitter.com/a_machun/status/1655015718692466688", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/13", "thumbnail_src": "https://si.imgix.net/46a09557/uploads/origins/ad86d322-d236-40f5-a064-8ee6331a5c56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f400b168a628ce6a935fcd1ebb230813", "thumbnail_srcset": "https://si.imgix.net/46a09557/uploads/origins/ad86d322-d236-40f5-a064-8ee6331a5c56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f400b168a628ce6a935fcd1ebb230813, https://si.imgix.net/46a09557/uploads/origins/ad86d322-d236-40f5-a064-8ee6331a5c56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba11249c71b4a809da367ef4284664a5 2x, https://si.imgix.net/46a09557/uploads/origins/ad86d322-d236-40f5-a064-8ee6331a5c56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d02d66ab3b340fb1b91acbc771e31aa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/12", "thumbnail_src": "https://si.imgix.net/1336f92c/uploads/origins/9e387b03-728d-4599-a78d-d5dbe1372c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23332921fdae48bf57cbef7f81b359d0", "thumbnail_srcset": "https://si.imgix.net/1336f92c/uploads/origins/9e387b03-728d-4599-a78d-d5dbe1372c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23332921fdae48bf57cbef7f81b359d0, https://si.imgix.net/1336f92c/uploads/origins/9e387b03-728d-4599-a78d-d5dbe1372c09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bc49df2413c1091658faf8a095c1980 2x, https://si.imgix.net/1336f92c/uploads/origins/9e387b03-728d-4599-a78d-d5dbe1372c09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d0b5b6b9efabb21b839b1c528d70769 3x", "genre": "art", "nsfw": false, "body": "前回と同じ緑のセーラー服の制服で、赤いランゼルを背負っていることを願う。防寒用の手袋、厚手のレギンスとブーツ、そして暖かそうなスカーフ。ヘアスタイルは、太めのダブルツイストなど、小さな女の子がするような伝統的なヘアスタイルで、髪色は実物に近い黒から茶色がかった黒。このグリルは片膝をついて、真冬の荒廃した学校の机と椅子の壕の後ろで撮影した。しかし、彼女は一瞬敵の銃弾に胸を撃たれる不運に見舞われる。(それが現実的でないと思うなら、建物や農場の廃墟で何か他のものでできたカバーの後ろから撃つこともできる)。\n\nhttps://www.konodai-gs.ac.jp/book2/contents/syougakubu/html5m.html#page=1", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/11", "thumbnail_src": "https://si.imgix.net/bb731ff9/uploads/origins/386e96ca-b5dc-47e7-9b89-d8c6588286dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da09088e260cf080f9cc17d60a5c0ee3", "thumbnail_srcset": "https://si.imgix.net/bb731ff9/uploads/origins/386e96ca-b5dc-47e7-9b89-d8c6588286dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da09088e260cf080f9cc17d60a5c0ee3, https://si.imgix.net/bb731ff9/uploads/origins/386e96ca-b5dc-47e7-9b89-d8c6588286dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdc808cf1177ea45e2d29bd27b5374aa 2x, https://si.imgix.net/bb731ff9/uploads/origins/386e96ca-b5dc-47e7-9b89-d8c6588286dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=821e517b37319e5ef11e22a1ab102dfa 3x", "genre": "art", "nsfw": false, "body": "いつも作品拝見させて頂いております。\n\n武装メイドのイラストをリクエストします。\n\nスカートの丈は、足にかからない程度の長さです。また、腰にポーチの付いたベルトを装着しています。\n\n靴は、重厚感のあるブーツを履いています。\n\n手にはルベルライフルを持ち、リフターを押し下げるために指を入れているところか、もしくは装填を終えた後、リフターを元の位置に戻すためにボルトを自分の側に引いているシチュエーションです。とてもストレスを感じているような表情をしています。\n\nスカートの丈は、これくらいの長さでお願いします。\nhttps://www.pixiv.net/artworks/103339025", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/10", "thumbnail_src": "https://si.imgix.net/f514e994/uploads/origins/14955de8-16aa-4f8b-b1dd-b6fb86a073c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aefb5f1d362c77f04d8834a04438920", "thumbnail_srcset": "https://si.imgix.net/f514e994/uploads/origins/14955de8-16aa-4f8b-b1dd-b6fb86a073c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aefb5f1d362c77f04d8834a04438920, https://si.imgix.net/f514e994/uploads/origins/14955de8-16aa-4f8b-b1dd-b6fb86a073c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d8171338237adf13628128e53f4535d 2x, https://si.imgix.net/f514e994/uploads/origins/14955de8-16aa-4f8b-b1dd-b6fb86a073c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3788b4ac0247283463d132e2d188b834 3x", "genre": "art", "nsfw": false, "body": "こんにちは、garoppui。あなたの絵が好きです。あなたが応募しているキャラクターは黒髪で青い目をした女の子で、両サイドの髪を三つ編みにしています。少女はシュタールヘルムとスコープを取り付けたG43で武装しています。服装はhttps://www.ebay.com/itm/313920243769 このようなトップスに灰緑色のショートパンツ、コッペルトラーゲシュテルなどの装備、茶色のミリタリーブーツとゲートルを履いている。\n表情は明るくなく無表情。ポーズや背景はお任せします。\nサンキュー", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/9", "thumbnail_src": "https://si.imgix.net/2daf1198/uploads/origins/b109eda2-d3ae-49b8-8eff-424709b7d872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0f7ecd1b8e1f573a2e85e4e46242b4", "thumbnail_srcset": "https://si.imgix.net/2daf1198/uploads/origins/b109eda2-d3ae-49b8-8eff-424709b7d872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0f7ecd1b8e1f573a2e85e4e46242b4, https://si.imgix.net/2daf1198/uploads/origins/b109eda2-d3ae-49b8-8eff-424709b7d872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffd6acc3a68b8c3458739826e75ed5e5 2x, https://si.imgix.net/2daf1198/uploads/origins/b109eda2-d3ae-49b8-8eff-424709b7d872?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99c5e506e8a1630f128d7a027ed9e610 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nリクエスト可能でしたら「銃を持った黒髪少女」のイラストをお願いできますか。\n\n黒髪少女\n○髪型、髪色：ロングヘア、黒髪\n○体型：長身(170cm前後)、褐色\n〇性格：素直クール系\n〇服装：クラシックメイド服\nhttps://x.com/mekibozu08/status/1726225622064869562?s=20\n〇銃：アサルトライフルみたいな銃\n〇ポーズ：おまかせ\n\nその他細かい所、アレンジはおまかせします。\nご検討、宜しくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/8", "thumbnail_src": "https://si.imgix.net/c89d6684/uploads/origins/4158a4eb-8d00-4995-ae94-e1c5a9721593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc966f0810c4e053f30f17f2fe835e4a", "thumbnail_srcset": "https://si.imgix.net/c89d6684/uploads/origins/4158a4eb-8d00-4995-ae94-e1c5a9721593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc966f0810c4e053f30f17f2fe835e4a, https://si.imgix.net/c89d6684/uploads/origins/4158a4eb-8d00-4995-ae94-e1c5a9721593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6567662305eb7336571b7d62cefc429f 2x, https://si.imgix.net/c89d6684/uploads/origins/4158a4eb-8d00-4995-ae94-e1c5a9721593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da6ea913cccf1007d08a8206d56dd873 3x", "genre": "art", "nsfw": false, "body": "写真のような名札のついた赤いランドセルを背負っており、シャツを着ていますが、長袖でも半袖でも大丈夫です。胸ポケットと中央にボタンが並んだトラディショナルなシャツです。スカートの色もこんな感じだったら良かったです。スカートの裾は膝が隠れるだろうし、スカートの下にはブルマを履いているだろう。ブルマーは絵には出てこないかもしれませんが、ドレスコードのデザインの一部だったのでそれについても書きました。彼女は本のバッグにそのようなアラームを付ける予定です。これは、彼らが見張りとして勤務しているときに警報を鳴らすのに便利です。彼女の服装、動き、ポーズについては、このように描いていただければ幸いです。この子は MP40 を緊張した様子で持ち、足を内側に入れ、膝を内側に傾けて閉じています。彼女は部隊の最後の一人として、敵によって徐々に窮地に追い込まれていました。彼女は最後の抵抗をするかどうか、緊張しながら考えていました。彼女はそんな古いものを背負っている", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/7", "thumbnail_src": "https://si.imgix.net/b9e5ff71/uploads/origins/66b8183a-2700-4970-b023-fc2dba2f60cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a03404de96be1d69c8dedc7ddcf5649", "thumbnail_srcset": "https://si.imgix.net/b9e5ff71/uploads/origins/66b8183a-2700-4970-b023-fc2dba2f60cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a03404de96be1d69c8dedc7ddcf5649, https://si.imgix.net/b9e5ff71/uploads/origins/66b8183a-2700-4970-b023-fc2dba2f60cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c26ab8f01260b883b08915fa1f072cf9 2x, https://si.imgix.net/b9e5ff71/uploads/origins/66b8183a-2700-4970-b023-fc2dba2f60cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45e7c2c760191da8ad5caff3c4aa2273 3x", "genre": "art", "nsfw": false, "body": "親愛なるgaroppui〜私は：没有存在过。\n明らかに、彼女は武装JSです。私はそれが奇妙であることを知っているが、この絵はこのように感じるようにしてください\n好きな靴のスタイルで描いてください。\n\n彼女はかなり長いスカート（少なくとも膝が隠れるくらい）をはき、厚手の白いパンストをはき、日本風の赤いランゼルを携えている。\n彼女は片手を上げてVサインをし、他の体の部位では好きなポーズを描くことができる。\n銃はモシン・ナガント。弾丸のキャリーバッグや各種バッグは彼女には少しオーバーサイズに見えるし、スタイルも古く見える。\nJKコマンダーで敵を撃退したところ。ということは、おそらく子供のような嬉しそうな勝ち誇った笑顔だろうか。腕には戦傷の包帯がある。\n胸には名札がついている。髪型は自由ですが、子供っぽいほうがいいかもしれません。\nもしよろしければ、よろしくお願いします！\nセーラー服の作例↓はこちら\n\nhttps://postimg.cc/gallery/MxFB36b", "created_at": "", "completed_at": ""}, {"path": "/@garoppui/works/6", "thumbnail_src": "https://si.imgix.net/b432793b/uploads/origins/1ef7cf6c-1ba1-43e1-8f96-f1fc0a52b8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=740053e5a8a3