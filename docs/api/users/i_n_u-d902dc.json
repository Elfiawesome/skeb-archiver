2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a95fad67db4c5b916c791136e5fdd8b 2x, https://si.imgix.net/61ecf32a/uploads/origins/cf430a6b-450a-4c05-8ead-08cf7f8957ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cd7f1a4a485be8bca2a072b6bac1ff7 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ガルパン同人誌からのファンの者です。 このた度スケブをお願いします。\n\n作品名　ガールズ&パンツァー \n \nキャラ　武部沙織&メグミのお姉さんキャラ二人\n\nシチュエーション　目を開けた状態で顔と目線正面まっすぐで沙織は「いいよ来て♡」って言わんばかりの微笑んだ顔でメグミは「ほらほら」と誘う様な感じにニヤついた顔でお願いします。2人の服はフィギュアで話題になったレースクイーン愛里寿ちゃんの衣装でお願いします。ポーズは棒立ちで2人とも上の服は乳首を出しながら片手で胸を持ち上げて片手でスカートをたくし上げてノーパンでお願いします。\n最後に沙織の足は閉じてメグミは開くポーズでお願いします。\n\n参考です↓ 衣装 https://hobbyjapan.co.jp/ltd_items/hj20170803/ \n\n ポーズ \nhttps://www.melonbooks.co.jp/detail/detail.php?product_id=192594\n\nもし金額的に難しいのであればメグミさん単体でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@i_n_u/works/2", "thumbnail_src": "https://si.imgix.net/dcdb4961/uploads/origins/90374796-cdac-402e-8667-a40ba4f0760b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b2f54c83b73d9521227c7eaf6b07f2", "thumbnail_srcset": "https://si.imgix.net/dcdb4961/uploads/origins/90374796-cdac-402e-8667-a40ba4f0760b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b2f54c83b73d9521227c7eaf6b07f2, https://si.imgix.net/dcdb4961/uploads/origins/90374796-cdac-402e-8667-a40ba4f0760b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7de420f037beb999f52f7496cb544f0b 2x, https://si.imgix.net/dcdb4961/uploads/origins/90374796-cdac-402e-8667-a40ba4f0760b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3498acb532c1041c9e26f2fef29d8746 3x", "genre": "art", "nsfw": true, "body": "初めまして、\n新田美波がアナスタシアにクンニしているイラストをお願いします。\nアナスタシアの服装は股間と乳首の部分が開いたのベビードールです。\n背景と構図は先生にお任せします。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@i_n_u/works/1", "thumbnail_src": "https://si.imgix.net/10407bbd/requests/147423_0?bg=%23fff&auto=format%