compress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=340813ef23c219126c00d3df0ed36bbe, https://si.imgix.net/858e1291/uploads/origins/02f47c04-99ee-4ce1-aa15-ff1e52a7e1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbec6d3f7c290376544585b1557e03cb 2x, https://si.imgix.net/858e1291/uploads/origins/02f47c04-99ee-4ce1-aa15-ff1e52a7e1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=17697973cb39817a867072e90c3493af 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@syunrai07/works/39", "thumbnail_src": "https://si.imgix.net/3ec53951/uploads/origins/60fb3b96-da98-4ce8-a751-cecb8c2b02ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3efb50fe52fba99383cb7cab4690f50", "thumbnail_srcset": "https://si.imgix.net/3ec53951/uploads/origins/60fb3b96-da98-4ce8-a751-cecb8c2b02ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3efb50fe52fba99383cb7cab4690f50, https://si.imgix.net/3ec53951/uploads/origins/60fb3b96-da98-4ce8-a751-cecb8c2b02ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74cb983939652c6d33a00856da3fffa0 2x, https://si.imgix.net/3ec53951/uploads/origins/60fb3b96-da98-4ce8-a751-cecb8c2b02ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9509199045995b9184d6551c2bee31c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！もし可能なら、私のVTuberモデル4人のクリスマスをテーマにしたコラボをお願いしたいです！ここ数年の私たちの成長と、それぞれのバリエーションが私にとってどれほどの意味を持つかへのオマージュのようなものです。\n\n参考URLをご覧ください。最初にリストアップされているのが私の現在のモデルで、彼女の下には今でも使っているチビテーマのリデンプションがあります。すべてアライグマなので、ゴミやアライグマのテーマを作品に組み込めたら最高です！リファレンスにある他の2つは、僕の古いモデルで、最初のBlairBearsバージョンと、僕が始めたリアルなアライグマのモデルだ。\n\n作品のトーンに関しては、僕は小児病院のチャリティーのためにストリーミングをしているので、健全でおバカな作品にしたいんだ。僕が持っているチビは、普段はとても小さくしているので、もし彼女の背を低くしてもらえると助かる！クリスマスをテーマにした服装と背景で、全員をイメージしています。ありがとうございました！\n\nhttps://imgur.com/a/TJgWDT8", "created_at": "", "completed_at": ""}, {"path": "/@syunrai07/works/38", "thumbnail_src": "https://si.imgix.net/45f695cc/uploads/origins/ac776fbd-575e-4c4a-90ef-714c181ec297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c219fd012054aadb3e3ad4a3a29ee05c", "thumbnail_srcset": "https://si.imgix.net/45f695cc/uploads/origins/ac776fbd-575e-4c4a-90ef-714c181ec297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c219fd012054aadb3e3ad4a3a29ee05c, https://si.imgix.net/45f695cc/uploads/origins/ac776fbd-575e-4c4a-90ef-714c181ec297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=402881548887f7f3b5cca56bfff26944 2x, https://si.imgix.net/45f695cc/uploads/origins/ac776fbd-575e-4c4a-90ef-714c181ec297?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3df234592c1785f3bbddf25cdac7cac1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@syunrai07/works/37", "thumbnail_src": "https://si.imgix.net/b6dfc658/uploads/origins/b87aadfa-7d68-4f24-b721-afd3117d8772?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38b63d10c2754e8b76bcd40ae9ebe612", "thumbnail_srcset": "https://si.imgix.net/b6dfc658/uploads/origins/b87aadfa-7d68-4f24-b721-afd3117d8772?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38b63d10c2754e8b76bcd40