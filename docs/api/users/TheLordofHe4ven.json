9-db279cd5dcc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=201d51d195317ff4e6c7c8f04bb96ec3 2x, https://si.imgix.net/dd67d8e0/uploads/origins/4ece68fe-5039-49a5-bf39-db279cd5dcc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90aa4cc33fdb3bbe0bb1f8c7ccdacb38 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@TheLordofHe4ven/works/2", "thumbnail_src": "https://si.imgix.net/075c6918/uploads/origins/bb70356d-8cd1-4310-8d18-0fdbbca97c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee45633846cd3626a7ca70520a2bc4f", "thumbnail_srcset": "https://si.imgix.net/075c6918/uploads/origins/bb70356d-8cd1-4310-8d18-0fdbbca97c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee45633846cd3626a7ca70520a2bc4f, https://si.imgix.net/075c6918/uploads/origins/bb70356d-8cd1-4310-8d18-0fdbbca97c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a8ff26428f45a761f3ab02873d364da 2x, https://si.imgix.net/075c6918/uploads/origins/bb70356d-8cd1-4310-8d18-0fdbbca97c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cde82689a5f1fb712e62f910019ab7e2 3x", "genre": "art", "nsfw": false, "body": "厚みのあるタッチがたいへん素敵でリクエストさせていただきました！\n参照資料のオリキャラを内容おまかせでお願いしてみたいです！\n拝見したイラストの空気感、世界観がどれも好みだったので、ぜひお好きな解釈で描いていただけると嬉しいです。\nNG要素なども特にございません。\n用途は個人鑑賞のほか、イラスト発注時の参照資料に使用させていただく場合がございます。\n\n【キャラ設定】\n名前：コメット\n性別：女\n身長：160cm弱（ツノ除く）\n\n現代にファンタジー種族などが存在しているような世界観のキャラ。\nベツレヘムの星（クリスマスツリーの星飾り）などがキャラのメインモチーフ。\n\nサンタクロースに仕えるトナカイ精霊たちの一人。\n自らを「地上に落ちてきた星の生まれ変わり」と宣う個性的な子。\n神秘的でやや無表情、何を考えているか読みづらいタイプ。\n星を通して、未来を見通す不思議な瞳を持ち、ふとした瞬間にぼそっと予言めいたことを呟いて周囲を驚かせる。\n考えを読みづらいだけで、内面はややあどけなく、人見知りでおとなしい性格。\n悪意に敏感で警戒心が強いものの、一度懐いた相手にはわりとひっついて回り、距離感がバグりがち。\n根っこのところは末っ子気質でやや甘えん坊。\n星にまつわる魔術の使い手で、ソリを引く時(※)は最後尾を走り、星の軌跡をあとに残す。\n\n(※)精霊なので、ソリを引く時はトナカイ姿に変身します\n\nhttps://drive.google.com/drive/folders/1-nqkPllEIu9JBZkzCNLcpO0AcEl8sEa4?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@TheLordofHe4ven/works/1", "thumbnail_src": "https://si.imgix.net/700a5d22/uploads/origins/a25ae129-4cd1-40f9-983c-52ba5ebb79d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e44462c64086188a9a16e767a8f6c6e", "thumbnail_srcset": "https://si.imgix.net/700a5d22/uploads/origins/a25ae129-4cd1-40f9-983c-52ba5ebb79d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e44462c64086188a9a16e767a8f6c6e, https://si.imgix.net/700a5d22/uploads/origins/a25ae129-4cd1-40f9-983c-52ba5ebb79d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2f70fd9cc60783eebc182c9fd3ed653 2x, https://si.imgix.net/700a5d22/uploads/origins/a25ae129-4cd1-40f9-983c-52ba5ebb79d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=781a474076c9e5b0d307679f0cdb38a4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}