Cが2バージョンあるのですが、その人間バージョンをお願いしたいです\n\nこの度はありがとうございました!\n\n私の参考文献はこちら：https://imgur.com/a/n2FP6ho", "created_at": "", "completed_at": ""}, {"path": "/@nago_sushi/works/8", "thumbnail_src": "https://si.imgix.net/04a85d53/uploads/origins/d2db8d7b-a1bf-40d9-a3fc-03ed291d8aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e6302da90b9b230ea60edb82cfc4291", "thumbnail_srcset": "https://si.imgix.net/04a85d53/uploads/origins/d2db8d7b-a1bf-40d9-a3fc-03ed291d8aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e6302da90b9b230ea60edb82cfc4291, https://si.imgix.net/04a85d53/uploads/origins/d2db8d7b-a1bf-40d9-a3fc-03ed291d8aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdf1a2498d6a631cb0d190a2034a721e 2x, https://si.imgix.net/04a85d53/uploads/origins/d2db8d7b-a1bf-40d9-a3fc-03ed291d8aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c61caf86a5295f393a36a2428c2a3475 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nago_sushi/works/7", "thumbnail_src": "https://si.imgix.net/eb1b3b74/uploads/origins/5f2e21c4-d4f1-4f29-9953-c77fb9708833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0008047b6109ca469da39ee72a373cb", "thumbnail_srcset": "https://si.imgix.net/eb1b3b74/uploads/origins/5f2e21c4-d4f1-4f29-9953-c77fb9708833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0008047b6109ca469da39ee72a373cb, https://si.imgix.net/eb1b3b74/uploads/origins/5f2e21c4-d4f1-4f29-9953-c77fb9708833?bg=%23fff&auto=format