%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b12eac15e08bb7557cf737a55e9050a7", "thumbnail_srcset": "https://si.imgix.net/8912ce0a/uploads/origins/88ffb386-bbfc-4f94-98d3-e0684cd0620e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b12eac15e08bb7557cf737a55e9050a7, https://si.imgix.net/8912ce0a/uploads/origins/88ffb386-bbfc-4f94-98d3-e0684cd0620e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=760637bd79a185570484a2777d8d1079 2x, https://si.imgix.net/8912ce0a/uploads/origins/88ffb386-bbfc-4f94-98d3-e0684cd0620e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d0e137a72d6a9710b7d47a019a789aa 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼致します。\nいつもパインスフィアさんの描くイラスト楽しみにしています。\n\n【キャラクター】\nドルフィンウェーブの都条みちる先輩\n\n【衣装】\n以前投稿された(https://x.com/pine_sphere/status/1607664525511385089?s=46&t=tc4C5r9QYZxfygpA7J8UMQ)で描かれた普段着ている水着でお願いします。\n\n【シチュエーション】\nクールになる練習と称してコーチにパイズリしているところをお願いいたします。\n\n【構図】\n・みちる先輩の胸は大きめでお願いします。\n・両手で胸を支えながら頑張ってパイズリしている。\n・表情は「本当にこれでクールになれるのですか…？」と戸惑っている表情でお願いいたします。\n\n【その他】\n差分として水着なしで乳首が見えている差分、射精して顔や胸にたくさん精液がかかっている差分をお願い致します。\n\nどうかご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Pine_Sphere/works/29", "thumbnail_src": "https://si.imgix.net/1bd989e3/uploads/origins/22b31690-f0ef-4d20-baec-6e4afd6050d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38421876f2bb7565a1305e4782c2b1d6", "thumbnail_srcset": "https://si.imgix.net/1bd989e3/uploads/origins/22b31690-f0ef-4d20-baec-6e4afd6050d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38421876f2bb7565a1305e4782c2b1d6, https://si.imgix.net/1bd989e3/uploads/origins/22b31690-f0ef-4d20-baec-6e4afd6050d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfffd59d93be6809e499b892bacdc3b9 2x, https://si.imgix.net/1bd989e3/uploads/origins/22b31690-f0ef-4d20-baec-6e4afd6050d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4be9708efca870d195d6069e197d677b 3x", "genre": "art", "nsfw": true, "body": "アニメ「フレームアームズ・ガール」に登場する「寿武希子(ことぶき・ぶきこ)」ちゃんがドルフィンウェーブのKIRISIMAの主人公達が来ているユニフォーム(SR)を着て、喜んでいるイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Pine_Sphere/works/28", "thumbnail_src": "https://si.imgix.net/b25ac94d/uploads/origins/ccea96d6-34b5-40a1-89cd-c1d332469008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b8357b0b70c513e68aeb3ec5483828", "thumbnail_srcset": "https://si.imgix.net/b25ac94d/uploads/origins/ccea96d6-34b5-40a1-89cd-c1d332469008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b8357b0b70c513e68aeb3ec5483828, https://si.imgix.net/b25ac94d/uploads/origins/ccea96d6-34b5-40a1-89cd-c1d332469008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64d80b22dfb056f927fefa5b5151f491 2x, https://si.imgix.net/b25ac94d/uploads/origins/ccea96d6-34b5-40a1-89cd-c1d332469008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cbc0f0d0982093516195998bbaee1c8 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私のOCであるアリッサのイラストをお願いしたいのですが。\n\nアリッサはスポーティーなカジュアルな服を着ています。彼女はフレンドリーでエネルギッシュな性格で、少しチャラチャラしているところもあります。リファレンスはGoogle Driveにあります。\n\nポーズとしては、リラックスしたポーズか、スポーティーなポーズで描いてほしいです。例えば、汗を拭くためにシャツを上げて、スポーツブラが見えているような感じです。彼女の表情は、あなたをからかっていることを自覚しているようで、少しはにかんでいるかもしれませんね。また、参考画像も用意されているので、アイデアも広がります。\n\nNSFWと表記していますが、必ずしもR18のイラストというわけではありません。\n\nお付き合いいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1-5D_ODGB1X1QYXyS2smcTx_fEu8R64bX?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Pine_Sphere/works/27", "thumbnail_src": "https://si.imgix.net/ea8b8569/uploads/origins/9b0a08dd-5907-4b9c-85f7-0cfb54f00aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f7767e56731dedf27fc93978826532", "thumbnail_srcset": "https://si.imgix.net/ea8b8569/uploads/origins/9b0a08dd-5907-4b9c-85f7-0cfb54f00aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f7767e56731dedf27fc93978826532, https://si.imgix.net/ea8b8569/uploads/origins/9b0a08dd-5907-4b9c-85f7-0cfb54f00aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77f5f15f5278432e03fa08c79755ba65 2x, https://si.imgix.net/ea8b8569/uploads/origins/9b0a08dd-5907-4b9c-85f7-0cfb54f00aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddf560b5b879fb129d49fae23e10d0d0 3x", "genre": "art", "nsfw": true, "body": "陸上のセパレートユニフォーム（ゼッケンNG）を着ている巨乳な後輩（女子高生）のイラストをお願いします\n\nシチュや背景などはおまかせしますが\nポーズはできるだけ前を隠さない\n（お腹（重要）と胸と服装が見える）ようにお願いします\n\nR-18差分もお願いします\n上を上にずらして/脱がしておっぱいを見せて\n下を下にずらす/脱がすようにお願いします\n\npsdで\n宛名などをあり/なしの両方か\nレイヤーでON/OFFできるようにお願いします\n\nご検討いただけますと幸いです", "created_at": "", "completed_at": ""}, {"path": "/@Pine_Sphere/works/26", "thumbnail_src": "https://si.imgix.net/5332dbdf/uploads/origins/91dc7931-a84b-4aef-80a9-379a2d3a19eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174795c62e329207d0a2c98d029e6dd4", "thumbnail_srcset": "https://si.imgix.net/5332dbdf/uploads/origins/91dc7931-a84b-4aef-80a9-379a2d3a19eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174795c62e329207d0a2c98d029e6dd4, https://si.imgix.net/5332dbdf/uploads/origins/91dc7931-a84b-4aef-80a9-379a2d3a19eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d9d7fe535790b42acf1af1653675a95 2x, https://si.imgix.net/5332dbdf/uploads/origins/91dc7931-a84b-4aef-80a9-379a2d3a19eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f917839fd27d3172f1a47651c6493541 3x", "genre": "art", "nsfw": true, "body": "初めまして。リクエストの募集を始めたということで依頼したいと思います。\n\nファイアーエムブレム風花雪月のベルナデッタをリクエストします。\n過去に描かれましたマラニー(https://skeb.jp/@Pine_Sphere/works/9)と同じような構図でベッドに押し倒されて本番直前のシチュエーションにしてください。\n制服をはだけさせて大きな胸を露出されて、スパッツを脱がされ秘所がギリギリ見えない程度にパンツをずらして、蕩けた表情にしてください。\n胸のサイズはマラニー以上の大きさでお願いします。\n\nhttps://static.wikia.nocookie.net/feheroes_gamepedia_en/images/a/af/Bernadetta_Eternal_Loner_Face.webp/revision/latest?cb=20200305082620", "created_at": "", "completed_at": ""}, {"path": "/@Pine_Sphere/works/25", "thumbnail_src": "https://si.imgix.net/12f7e057/uploads/origins/11ee47b7-e89e-4138-aa27-9661d7fc1959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=604d05869377a51aec1d7fc0810db234", "thumbnail_srcset": "https://si.imgix.net/12f7e057/uploads/origins/11ee47b7-e89e-4138-aa27-9661d7fc1959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=604d05869377a51aec1d7fc0810db234, https://si.imgix.net/12f7e057/uploads/origins/11ee47b7-e89e-4138-aa27-9661d7fc1959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86f6a6409c06d5b6d0b74cb09f4553f4 2x, https://si.imgix.net/12f7e057/uploads/origins/11ee47b7-e89e-4138-aa27-9661d7fc1959?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99b5c0dabf9b4ddf01cb5d62571847a7 3x", "genre": "art", "nsfw": true, "body": "以前は大変素晴らしい画をありがとうございました。pixivの絵等も大変楽しく拝見させてもらってます、そ以来また強く依頼しようとお待ちしておりました…！\npixivリクで拝見した妹系後輩ちゃんのパイズリ画がとても良かったので、あんな感じの画を、前回依頼したキャラと同じになってしまいますが「ネプチューン」でお願いします。\n前回の画の続き、といったシチュエーションで我慢できなくなった指揮官を抜いてあげる、的な感じです。\n構図や画角共にほぼ同じで構いませんが、あれよりかは手の平全体使って揉みしだいている体でお願いします。\n胸のサイズもあちらと同じくらい、いっそもっと大きくても喜びます。ブラの有無はお任せしますが、乳首はポロリしてれば。\n表情は前回依頼した様な恥じらい、若しくは小悪魔的に楽しく搾精してる様なモノでお願いします。\nそれらの表情や行為前、動かしている最中、事後等の差分あると大いに捗りますが、難しい様でしたら射精直後の1枚でお願いします。（ただその際は所謂、挟射で）\n背景も前回と同じ様な、若しくは暗がりの様な、簡易的なモノで大丈夫です。\n\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Pine_Sphere/works/24", "thumbnail_src": "https://si.imgix.net/215c5c9c/uploads/origins/a627703a-e0da-4dcc-bb09-606e742a5a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7638b3b68d3308e991c73cfcef8bcf46", "thumbnail_srcset": "https://si.imgix.net/215c5c9c/uploads/origins/a627703a-e0da-4dcc-bb09-606e742a5a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7638b3b68d3308e991c73cfcef8bcf46, https://si.imgix.net/215c5c9c/uploads/origins/a627703a-e0da-4dcc-bb09-606e742a5a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=072c5d77771f87aad7ead0f24ee5ec55 2x, https://si.imgix.net/215c5c9c/uploads/origins/a627703a-e0da-4dcc-bb09-606e742a5a5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dee66873b7348b495ee989781cf831eb 3x", "genre": "art", "nsfw": true, "body": "パインスフィア先生こんにちは。いつも可愛いイラストを描いてくださりありがとうございます。\n\n今回リクエストしたいお題は「うちの子(ルーチェちゃん)と混浴露天風呂」です\n\n構図などのおおまかなイメージです(参考:https://drive.google.com/drive/folders/1ACEmXWCgJeBJ77G0DfLyLDznp1HabOOI?usp=share_link)\n細かい仕草や構図などはおまかせします\n\n全裸の差分などもあれば嬉しいです。\n\n完成したイラストは個人的な観賞用として楽しみたいと思っています。ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Pine_Sphere/works/23", "thumbnail_src": "https://si.imgix.net/95b12539/uploads/origins/0c9f9075-d9ad-421d-8d6b-381502e3887a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff26bd15499ee730c52693e51a2c00dd", "thumbnail_srcset": "https://si.imgix.net/95b12539/uploads/origins/0c9f9075-d9ad-421d-8d6b-381502e3887a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff26bd15499ee730c52693e51a2c00dd, https://si.imgix.net/95b12539/uploads/origins/0c9f9075-d9ad-421d-8d6b-381502e3887a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d54838127d88aa6c947812d37deaf187 2x, https://si.imgix.net/95b12539/uploads/origins/0c9f9075-d9ad-421d-8d6b-381502e3887a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb