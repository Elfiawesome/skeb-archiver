%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4248b55a88276bfee5448e78833af650", "thumbnail_srcset": "https://si.imgix.net/c39d3654/requests/93919_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4248b55a88276bfee5448e78833af650, https://si.imgix.net/c39d3654/requests/93919_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac04bbcea7602b206bc31865ddb9276b 2x, https://si.imgix.net/c39d3654/requests/93919_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2292594bff0d93d5ad055406b336207b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n私のオリジナルキャラクターのイラストの設定画への描き起こしをリクエストします。\nアニメ画集にあるような設定画（全身画一枚、表情差分４枚程度、特に横向き、煽り、俯瞰等の様々な角度の髪型がわかるような構図）イラストをお願いします。\n絵柄は五十嵐さんの作風にして頂けるとありがたいです（一部描写を作画指示から変えて頂いてもOKです）\n\nキャラクター資料と作画指示はお手数ですが以下のpixivのページの一枚目のイラストと文書を参考にお願いします。\nhttps://www.pixiv.net/artworks/82534422\n上半身の筋肉の作画資料はこちらの画像を参考にお願いします。\nhttps://www.dropbox.com/s/sdxv5agfggvhdxk/%E7%9F%B3%E6%A3%AE.jpg?dl=0\n\nまた、もし可能でしたら上記のpixivページの三枚目のジャージ姿の全身のラフ画を追加で描いて頂けたら嬉しいです。\n\n用途は自分がイラストを描く際の資料としての使用を想定しています。\n\nリクエスト内容は以上です。よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/82534422", "created_at": "", "completed_at": ""}, {"path": "/@ff_igarashi/works/13", "thumbnail_src": "https://si.imgix.net/30cfbbcf/requests/84985_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=231f3f40237a3e6f5b42cd3aaab37dde", "thumbnail_srcset": "https://si.imgix.net/30cfbbcf/requests/84985_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=231f3f40237a3e6f5b42cd3aaab37dde, https://si.imgix.net/30cfbbcf/requests/84985_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bd86ab7f612561b7ef32557da215223 2x, https://si.imgix.net/30cfbbcf/requests/84985_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68d9193e1ff3d75bb968990207b392d6 3x", "genre": "art", "nsfw": false, "body": "五十嵐様のイラストに惹かれ今回リクエストをお願いさせて頂きました。\n自キャラの絵をお願い致します。\n出来れば以下反映頂ければ幸いです。\n\nウェアウルフの娘(昼間には人で夜には狼獣人になる狼男の娘版です)\n・年齢は20代後半から30代一歩手前くらい\n・中世ファンタジーの飾りっけの無い傭兵剣士\n(服装は布系で肩とお腹に露出あり)\n・黒髪ざんばらポニテ娘(腰辺りまでの長さ)\n・獣人形態の時は黒と灰の狼獣人\n・金色の眼、八重歯(人でも犬歯目立てば幸いです。)\n・締まった体つき、身体も多々傷跡あり\n（腹筋描いて頂けると嬉しいです!）\n・今回はキャラの特長ある一枚を描いて頂きたいので正面から描いて頂きたいのですが、左半身と右半身を線引きしたような形で昼の人形態と夜の獣人形態の姿を半身ずつ描いて頂けないでしょうか?\n真正面からでなくても大丈夫ですし構成やポーズなど細かい部分は五十嵐様にお任せ致します。\n\nイラストはSNSのアイコンに使用と個人で楽しむものになります。\nご都合よろしければ何卒お願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ff_igarashi/works/12", "thumbnail_src": "https://si.imgix.net/9c51d91b/requests/81607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d66af9e3f4ecd20e22a8be02d7630a", "thumbnail_srcset": "https://si.imgix.net/9c51d91b/requests/81607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d66af9e3f4ecd20e22a8be02d7630a, https://si.imgix.net/9c51d91b/requests/81607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=287262b4df9bdf4e016b4ca16993ed8e 2x, https://si.imgix.net/9c51d91b/requests/81607_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=936544095aa2b52ac18d68ab6278ecad 3x", "genre": "art", "nsfw": false, "body": "はじめまして。skeb巡りをしていて五十嵐様の描いた絵に一目惚れしました。\n早速ですが依頼をさせて頂きます。 TwitterやYoutubeのアイコン用にシベリアンハスキー風(オス)の獣人を描いて頂きたいです。\nアイコン用ですので描いていただくのは上半身の途中までで大丈夫です。\n\n構図は真正面からのものか、リク絵にあったようなこちらが斜めから見下ろし、キャラがカメラ目線でこちらを見上げてるもの(両眼が見えるアングルでお願いします)\n\n実物のシベリアンハスキーは目の周りが黒く目立ちますが、そこは少し薄めで目立ちすぎない雰囲気でお願いします\n\n上半身裸(もし後述のアクセサリとの兼ね合いで雰囲気が合わなければ服装はカジュアルな雰囲気のものに変えていただいて大丈夫です)\n\nオッドアイで正面から見て左側(右眼)が明るい水色\n右側(左眼)が明るい紫とピンクの中間のような色\n背景はモノクロで塵が舞うイメージか、少し濃淡のあるグレー\n\n牙は口を閉じてても両側に1本ずつ見える感じ\n\n体格はゴリマッチョまでいかない筋肉質な身体\n\n\n\nもし可能でしたら差分で\n1枚はクールでニヤリと不敵な笑みを浮かべていて、首元にドッグタグ(黒いフチが薄く付いてて中はシルバー)を付けたもの\n\nもう1枚は楽しい雰囲気で明るく少し無邪気な笑顔を見せウインク(左眼閉じ)してるもの。\n首元にはゲーミングヘッドセット(耳当ての外側が光沢のある薄い緑色、内側は黒、マイク部分は白or黒)を下げている\nマイク部分に関しては絵全体の色のバランスを見て白か黒かお任せします。\n全体的に白と黒で構成されていて、色が付いてるのは眼の部分と差分のヘッドセット部分だけでお願いします。\n\n以上のような感じでお願いしたいです。\nお忙しい中恐縮ですがどうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}]}