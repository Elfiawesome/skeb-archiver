9918/uploads/origins/77afe011-aef4-4f94-a5e3-c56678d4a372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02b80e8446ccd8591a8e1381f6838fe", "thumbnail_srcset": "https://si.imgix.net/b0cb9918/uploads/origins/77afe011-aef4-4f94-a5e3-c56678d4a372?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02b80e8446ccd8591a8e1381f6838fe, https://si.imgix.net/b0cb9918/uploads/origins/77afe011-aef4-4f94-a5e3-c56678d4a372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=871af643eec0ca2472d55a7f0dd92f01 2x, https://si.imgix.net/b0cb9918/uploads/origins/77afe011-aef4-4f94-a5e3-c56678d4a372?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0c9d34c198c092f80c03f3819b46771 3x", "genre": "art", "nsfw": false, "body": "お疲れ様です。\nゆきかわじゅり様の美麗なイラストで見てみたい作品があり、今回リクエストを送らせて頂きました。\n\n\n内容は下記の通りになります。\n\n【お題】\nウマ娘グラスワンダーとサイレンススズカが手を繋いでいるイラスト。\n\n【詳細】\nトレセンコートにマスク姿で仲良く手を繋いでいるシチュエーションのスズグラ、という構図でお願いします。\n\nイメージ的なもの資料として添付しております。創作の参考にお使いください。\n\n※参考資料の構図はあくまでイメージですので、描きやすい構図や角度があればアレンジして構いません。\n\n\n【備考】\n・グラスはスズカのことを意識している\n逆にスズカはあくまで自然体の対比\n(表情や仕草)\n\n・2人の身長差\n\n・マスク\nhttps://images.app.goo.gl/EwXV8\nこういう感じの柔らかそうな感じで\n\n\n【可能なら見たい要素】\n差し支えなければ素顔差分、もしくはマスクを顎までずらして表情が見れる状態の差分が見てみたいです(余裕があったらで構いません)\n\n　\nこちらからは以上となります。\n\nどうかゆきかわじゅり様の絵柄で見てみたいです…\nご検討のほど、よろしくお願いします。\n\nうれぎ\n\nhttps://www.pixiv.net/artworks/137674884", "created_at": "", "completed_at": ""}, {"path": "/@yukikawajuri/works/53", "thumbnail_src": "https://si.imgix.net/3bd0974e/uploads/origins/15b65e24-9a70-4d65-9697-4049c3f43910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3c33e17d7e2699d13fb7b30684a4f2a", "thumbnail_srcset": "https://si.imgix.net/3bd0974e/uploads/origins/15b65e24-9a70-4d65-9697-4049c3f43910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3c33e17d7e2699d13fb7b30684a4f2a, https://si.imgix.net/3bd0974e/uploads/origins/15b65e24-9a70-4d65-9697-4049c3f43910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5cf7672b1dfdc93bf5d6da3976acc701 2x, https://si.imgix.net/3bd0974e/uploads/origins/15b65e24-9a70-4d65-9697-4049c3f43910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=176513a13859affd29a38c597dfacc19 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yukikawajuri/works/52", "thumbnail_src": "https://si.imgix.net/5a169bb1/uploads/origins/7eab8667-e4ee-494d-af7e-5f1ac89970fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=986b759ec391ab4f2fc1897d3c2c424e", "thumbnail_srcset": "https://si.imgix.net/5a169bb1/uploads/origins/7eab8667-e4ee-494d-af7e-5f1ac89970fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=986b759ec391ab4f2fc1897d3c2c424e, https://si.imgix.net/5a169bb1/uploads/origins/7eab8667-e4ee-494d-af7e-5f1ac89970fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f46955486cca24bdf38e1dac111c337c 2x, https://si.imgix.net/5a169bb1/uploads/origins/7eab8667-e4ee-494d-af7e-5f1ac89970fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd3e411d6943826b05e83c2ae4313285 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nウマ娘の素敵なイラストを拝見して、今回依頼を出させていただきました。\n\n依頼させていただきたいのは、以前ゆきかわじゅりさんが何度か描かれている「真ん中のウマ娘にトロフィーを持たせて、両隣に他の子が並んでいる」構図のイラストです。\n(https://skeb.jp/@yukikawajuri/works/9)\n(https://skeb.jp/@yukikawajuri/works/36)\n\nお願いしたいウマ娘はそれぞれ\n\n左:ウインバリアシオン(ドラマティック・チュチュ)\n中央:シュヴァルグラン(Grand itinéraire)\n右:サクラチヨノオー(日下開山・花あかり)\n\nで、服装は全員個別の勝負服でお願いします。\n(名前の横に記載している勝負服です)\n\nシュヴァルグランにはゴールドトロフィーを持たせてください。\n表情や背景、細かなポーズなどはお任せしますが、可能であれば「3人で勝利を分かち合うような構図」にしてくださると嬉しいです。\n\nお忙しい中とは思いますが、もしもご縁がありましたら、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yukikawajuri/works/51", "thumbnail_src": "https://si.imgix.net/1f7127cb/uploads/origins/ec19d7b7-02fb-4931-bc24-c2d7864ba4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b56d0438e63f9fc847cfd893a52fa5", "thumbnail_srcset": "https://si.imgix.net/1f7127cb/uploads/origins/ec19d7b7-02fb-4931-bc24-c2d7864ba4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b56d0438e63f9fc847cfd893a52fa5, https://si.imgix.net/1f7127cb/uploads/origins/ec19d7b7-02fb-4931-bc24-c2d7864ba4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18bf926ca69133368fa1be705e24d166 2x, https://si.imgix.net/1f7127cb/uploads/origins/ec19d7b7-02fb-4931-bc24-c2d7864ba4e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5151784b4bd1bd0bb7e4da5aafb429ec 3x", "genre": "art", "nsfw": false, "body": "ご依頼させて頂きます。\n\n前回の\n大学生ぐらいの清楚なお姉さん系の年上彼女さんで、\n夏らしいシチュエーション\nでのイチャラブなデート中のイラストをお願いいたします。\n\n構図やシチュエーション：\nイチャラブのシチュエーションはお任せしますので、\n上下の服装が見える感じで、背景ありのイラストを\nお願いいたします。\n\n年上の先輩女性：\n・ウェーブがかかったロングヘア\n　※ロングヘアであれば、髪型などはご自由にして頂いて構いません。\n・スタイルが良くて、巨乳\n・大学生ぐらいの清楚で優しげな年上の先輩女性\n・清楚系のネックレスやイアリングを身に着けてほしい\n・メガネはなし\n\n服装：\n夏らしい清楚系の服装\n\n上記で指定していない内容は、\nご自由にして頂いた構いません。\n\nよろしくお願い致します。\n\nhttps://skeb.jp/requests/3089182", "created_at": "", "completed_at": ""}, {"path": "/@yukikawajuri/works/50", "thumbnail_src": "https://si.imgix.net/db67df00/uploads/origins/159f0788-706e-4d2a-b3d6-982be4f2024f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d4d710f9d973c13729170fbb80d58f6", "thumbnail_srcset": "https://si.imgix.net/db67df00/uploads/origins/159f0788-706e-4d2a-b3d6-982be4f2024f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d4d710f9d973c13729170fbb80d58f6, https