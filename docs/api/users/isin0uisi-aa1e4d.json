ize=30&txt=PRIVATE&s=4c3af54005a636b22a08eaa83571a622, https://si.imgix.net/3c72dc53/uploads/origins/fcb6992c-77bb-4c06-b2ae-10841ce01dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=082e3dffc70972bff613eece9f619241 2x, https://si.imgix.net/3c72dc53/uploads/origins/fcb6992c-77bb-4c06-b2ae-10841ce01dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5e85bd6375239b8aaf7fd149bdb055b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@isin0uisi/works/50", "thumbnail_src": "https://si.imgix.net/0b796974/uploads/origins/778d6bf6-eaba-4417-8d53-255b917ea6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=830b5cd0411c71ba99a334b669e73da8", "thumbnail_srcset": "https://si.imgix.net/0b796974/uploads/origins/778d6bf6-eaba-4417-8d53-255b917ea6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=830b5cd0411c71ba99a334b669e73da8, https://si.imgix.net/0b796974/uploads/origins/778d6bf6-eaba-4417-8d53-255b917ea6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85e463ef1524cea714b98c45684dbb01 2x, https://si.imgix.net/0b796974/uploads/origins/778d6bf6-eaba-4417-8d53-255b917ea6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10f52f91f96e86367fc850c01e6aa43f 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nこれまで洞窟内での惨殺、磔と二度リクエストさせて頂きました。どちらも素晴らしい御作を、また細部のディテールまでこだわった再納品を頂戴しありがとうございました。\npixivに上げて頂いた最初のリクエストも拝見しました。ご興味を持っていただけたテーマで何よりですし、特にFanboxの細分化版（？）では、挿入されていない生首とのキスや逆に竿のみ表示なども合わせて更に楽しめました。\n\n納品頂戴してすぐで恐縮ですが、特に細分化版の「竿なしの生首とのキス」に惹かれたため、今一度弊OCの最期を手掛けて頂きたくリクエスト出させて頂きます。\n\n・リクエスト内容\n　順番に斬首され、同じカゴに収められたOC二人の生首\n\n・キャラクター見た目と服装\n　資料フォルダをご覧ください。胴体部分については全裸でお願い致します。\n\n・入れて頂きたい要素\n　板の床の上に、中に布を敷いたカゴが置かれ、二人の生首が入っている\n　生首はそれぞれ以前描いて頂いた「翳される生首」のようなぼんやりとした表情、半開きの口でキスをしている\n　（以前描いて頂いた「首を絞められながら生首とキス」の、両方とも生首になっているイメージでお願い致します）\n\n　それぞれの首からの血だまりの広さや出血の量はお任せいたしますが、片方は「先に斬首され、布に広がる血だまりは多めで出血ほぼ無し」、もう片方は「後から斬首、布への広がり少な目で出血中」といった、「順番に首を斬られた、後の方の斬首直後」の雰囲気にして頂きたいです。\n\n　ほか周辺の情景として\n　・カゴの側がくぼんでいる、木製の斬首台と血の付いた斧\n　・後から斬首された方の胴体がうつ伏せで倒れている\n　（背中から上ぐらいの描写で結構です：他の方へのリクエスト品で恐縮ですがイメージを資料に入れております）\n　・傍らに先に斬首された方の死体もあり、後から斬首されたほうと恋人つなぎで手を握っている\n　（こちらは二の腕から先ぐらいの描写で結構です）\n　といった、「最期まで一緒」のような雰囲気の描写をお願いしたいです。\n　\nリクエスト内容は以上となります。ご多忙のところ恐縮ですが、予算面での再送含めご検討のほどよろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1Mk8q48eR-qXCmrKKS43Y1QuEqZtzty8Z", "created_at": "", "completed_at": ""}, {"path": "/@isin0uisi/works/49", "thumbnail_src": "https://si.imgix.net/e790e0cf/uploads/origins/f6e25068-b015-49e2-b311-a3801b339810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de66fcf19a0378722c0298a651087cc4", "thumbnail_srcset": "https://si.imgix.net/e790e0cf/uploads/origins/f6e25068-b015-49e2-b311-a3801b339810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de66fcf19a0378722c0298a651087cc4, https://si.imgix.net/e790e0cf/uploads/origins/f6e25068-b015-49e2-b311-a3801b339810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7955b6070b71514effb09f23dac05cee 2x, https://si.imgix.net/e790e0cf/uploads/origins/f6e25068-b015-49e2-b311-a3801b339810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20b4f7b40d0d9dac7138ffb523c6774f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {