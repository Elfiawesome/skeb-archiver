性感帯等はすべて把握されてしまっている\n・今回の呼び出しは前回からかなり間が空いており、武田君とのSEXに不満もあることからイライラが募っていた\n\n■その他入れてほしい表現\n・結婚指輪\n・腰蓑コンドーム\n・膣内断面図\n・舌出しのけぞりアクメ\n・ハート目\nを入れていただけると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@lanceer24/works/35", "thumbnail_src": "https://si.imgix.net/c512d103/uploads/origins/6be7d058-474a-4ffb-b5dd-3920637ff5ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05e55c2e1050ad65422ea9168391878f", "thumbnail_srcset": "https://si.imgix.net/c512d103/uploads/origins/6be7d058-474a-4ffb-b5dd-3920637ff5ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05e55c2e1050ad65422ea9168391878f, https://si.imgix.net/c512d103/uploads/origins/6be7d058-474a-4ffb-b5dd-3920637ff5ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bd0de2893db6acd8d830df01282db48 2x, https://si.imgix.net/c512d103/uploads/origins/6be7d058-474a-4ffb-b5dd-3920637ff5ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50fa41247368ea5f4e3f50e74e85da88 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lanceer24/works/34", "thumbnail_src": "https://si.imgix.net/f163f3bb/uploads/origins/20a8a143-d975-4725-bc6d-1a61769dee49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a003aeca52718b1ca95ecaec2ba75837", "thumbnail_srcset": "https://si.imgix.net/f163f3bb/uploads/origins/20a8a143-d975-4725-bc6d-1a61769dee49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a003aeca52718b1ca95ecaec2ba75837, https://si.imgix.net/f163f3bb/uploads/origins/2