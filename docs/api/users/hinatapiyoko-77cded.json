.net/7bba75ee/uploads/origins/237d69e2-ab74-4dc5-ba43-cc6e262127e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23fd3705cc328d63009c07536e4604e8 2x, https://si.imgix.net/7bba75ee/uploads/origins/237d69e2-ab74-4dc5-ba43-cc6e262127e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8200d487a19d7d4a30a85e060bb9c212 3x", "genre": "art", "nsfw": false, "body": "Vtuberの咲真あきらちゃんのファンアートをお願いしたいです。\n構図、服装などはおまかせいたします。\nおとものくまいさん（くま）の有無もお任せします。\n\n咲真あきら本人が収益化済み YouTubeチャンネルや、運用しているSNSで使用する可能性があります。 可能であれば人物のみの透過データ、絵師様のサインなしデータもいただきたいです。\n\nhttps://lit.link/akirach1208sakuma", "created_at": "", "completed_at": ""}, {"path": "/@hinatapiyoko/works/8", "thumbnail_src": "https://si.imgix.net/97b4e63b/uploads/origins/98aced92-7441-4ce0-92a8-c38470f0301e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=945b9c5c5df027e4b4eae44316aea29d", "thumbnail_srcset": "https://si.imgix.net/97b4e63b/uploads/origins/98aced92-7441-4ce0-92a8-c38470f0301e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=945b9c5c5df027e4b4eae44316aea29d, https://si.imgix.net/97b4e63b/uploads/origins/98aced92-7441-4ce0-92a8-c38470f0301e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a003726d83e2f457e7c27337b76ece74 2x, https://si.imgix.net/97b4e63b/uploads/origins/98aced92-7441-4ce0-92a8-c38470f0301e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a12df658478e13e6575cb75cd846b3a5 3x", "genre": "art", "nsfw": false, "body": "はじめまして！リクエスト失礼します\nデレとミリで越境ユニットを組んだ設定で\nデレステの橘ありす（ありすの物語）、ミリマスの周防桃子（不思議の国に誘われて）\n「不思議の国のアリス」モチーフのSSR衣装を着た2人のツーショットをお願いします。\n\n参考資料\n・橘ありす（ありすの物語）\nhttps://imas.gamedbs.jp/cg/idol/detail/87?h=imcgss-c1810\n・周防桃子（不思議の国に誘われて）\nhttps://imas.gamedbs.jp/mlth/chara/show/49/1358", "created_at": "", "completed_at": ""}, {"path": "/@hinatapiyoko/works/7", "thumbnail_src": "https://si.imgix.net/0e0af2d6/uploads/origins/519a39a8-0389-4f03-9cd1-bdaa4b3c9bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36b9a2b9ec050552fe6b063c20442ef1", "thumbnail_srcset": "https://si.imgix.net/0e0af2d6/uploads/origins/519a39a8-0389-4f03-9cd1-bdaa4b3c9bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36b9a2b9ec050552fe6b063c20442ef1, https://si.imgix.net/0e0af2d6/uploads/origins/519a39a8-0389-4f03-9cd1-bdaa4b3c9bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee078fc4e386039b0a477a950aa451f2 2x, https://si.imgix.net/0e0af2d6/uploads/origins/519a39a8-0389-4f03-9cd1-bdaa4b3c9bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d72494e705b1ea7c9e87790678bb1fc 3x", "genre": "art", "nsfw": true, "body": "デレマスの喜多日菜子を描いていただきたいです。\nシチュは下着姿で仰向けに寝そべり腕を頭の上にあげ腋を見せるポーズで、照れて恥ずかしそうな顔をしている所をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hinatapiyoko/works/6", "thumbnail_src": "https://si.imgix.net/e734f66b/uploads/origins/be3b7a72-4a1d-49b9-a3e8-a63b4df6d875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75414ddf8addc7d648d6068baaf6428d", "thumbnail_srcset": "https://si.imgix.net/e734f66b/uploads/origins/be3b7a72-4a1d-49b9-a3e8-a63b4df6d875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75414ddf8addc7d648d6068baaf6428d, https://si.imgix.net/e734f66b/uploads/origins/be3b7a72-4a1d-49b9-a3e8-a63b4df6d875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39139b1f283e60b0a09bb260b10f73e0 2x, https://si.imgix.net/e734f66b/uploads/origins/be3b7a72-4a1d-49b9-a3e8-a63b4df6d875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=308f42dbd1c5326eb1ac28ab86d74c17 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。  \nアイドルマスターシンデレラガールズの棟方愛海が、光沢がある黒色のバニーガール姿で、ぺたん座りで座り、手を頭に当ててウサミミに見立てている、『うさみみポーズ』をしているイラストは可能でしょうか？検討して頂けたら嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@hinatapiyoko/works/5", "thumbnail_src": "https://si.imgix.net/cd16ff04/uploads/origins/fc2f9dc2-6669-434d-a3c9-1c59908315ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eea5535c553fc13251096f376e1ef806", "thumbnail_srcset": "https://si.imgix.net/cd16ff04/uploads/origins/fc2f9dc2-6669-434d-a3c9-1c59908315ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eea5535c553fc13251096f376e1ef806, https://si.imgix.net/cd16ff04/uploads/origins/fc2f9dc2-6669-434d-a3c9-1c59908315ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3941c08fb3c695e49a90cb84f4f0ac77 2x, https://si.imgix.net/cd16ff04/uploads/origins/fc2f9dc2-6669-434d-a3c9-1c59908315ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc6aed47ba2204a752d919d893157617 3x", "genre": "art", "nsfw": false, "body": "デレマスの佐藤心のイラストをお願いします！\n衣装はポプマスの「リボンド・はぁと」で、資料URLの画像のように手でハート作っているポーズ・前歯を見せた笑顔でお願いします。\nニーハイに付いているティースプーンが個人的に大好きな衣装なのでそのあたりまで描いてもらえると嬉しいです。\nよろしくお願いいたします！\n\nhttps://twitter.com/ito_rin/status/1668605272812818432?s=46&t=374xMf9-9CWgRwBxfnVvRQ", "created_at": "", "completed_at": ""}, {"path": "/@hinatapiyoko/works/4", "thumbnail_src": "https://si.imgix.net/1e1cf94e/uploads/origins/75edc14a-64bc-4459-9f62-3d12df028d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5ec16186dd2211ff35a2675fc456ba6", "thumbnail_srcset": "https://si.imgix.net/1e1cf94e/uploads/origins/75edc14a-64bc-4459-9f62-3d12df028d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5ec16186dd2211ff35a2675fc456ba6, https://si.imgix.net/1e1cf94e/uploads/origins/75edc14a-64bc-4459-9f62-3d12df028d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e199a06429aa1cb54303c9de84e05644 2x, https://si.imgix.net/1e1cf94e/uploads/origins/75edc14a-64bc-4459-9f62-3d12df028d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e44a1e8349cc7fbdfd7844f6213d474 3x", "genre": "art", "nsfw": false, "body": "アイドルマスターシンデレラガールズの綾瀬穂乃香ちゃんと佐藤心ちゃんをお願いします。\n\n公式の交流はシンデレラガールズ劇場「朝顔に心を重ねて」を参考にしてください。\nシチュエーションなどはおまかせします。", "created_at": "", "completed_at": ""}, {"path": "/@hinatapiyoko/works/3", "thumbnail_src": "https://si.imgix.net/5db703f4/uploads/origins/32a466aa-2772-4ec0-8bc7-6d9935e4ca42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9756ca9e493771fd65769e5fb806057c", "thumbnail_srcset": "https://si.imgix.net/5db703f4/uploads/origins/32a466aa-2772-4ec0-8bc7-6d9935e4ca42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9756ca9e493771fd65769e5fb806057c, https://si.imgix.net/5db703f4/uploads/origins/32a466aa-2772-4ec0-8bc7-6d9935e4ca42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0abed0a1acfedda7fdfa4dc72981f17e 2x, https://si.imgix.net/5db703f4/uploads/origins/32a466aa-2772-4ec0-8bc7-6d9935e4ca42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da5db4e4620c1f92fea16574c09a9945 3x", "genre": "art", "nsfw": false, "body": "初めまして、ぴよこさん。しばらくご依頼いただいてもよろしいでしょうか？\n「チャイナ大作戦」特訓前の衣装を着てるデレマスの桃井あずきちゃんがセクシーなポーズをしている状況をおねがいします。\nよろしければ全身の絵を見たいです！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1wK5hnxOJydrAvRuY2Vn-sSG0f-t9FebD?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@hinatapiyoko/works/2", "thumbnail_src": "https://si.imgix.net/bfaa2705/uploads/origins/b119b74c-6895-4b58-ad44-70d753802891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c023f9c32cce8cdcf1a30540795fbd", "thumbnail_srcset": "https://si.imgix.net/bfaa2705/uploads/origins/b119b74c-6895-4b58-ad44-70d753802891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c023f9c32cce8cdcf1a30540795fbd, https://si.imgix.net/bfaa2705/uploads/origins/b119b74c-6895-4b58-ad44-70d753802891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b365c64260fe0c6f2ab1aa2a3061765d 2x, https://si.imgix.