24003_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7bf89beae4116a233f2a0642245cc99 2x, https://si.imgix.net/1ab6a4a6/requests/224003_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a1ea3d56513398f854ce3a4bb211788 3x", "genre": "art", "nsfw": true, "body": "どうも、以前クリスマスにupされたのセレニケさんの絵を依頼した者です。\n今回もセレニケさんの絵を依頼したいです。\nシチュエーションは情事の真っ最中です。\n\n・ベッドで寝ている相手の男に覆い被さるように四つん這いになって、自分の胸を吸わせている。\n・セレニケさんの表情は舌を出して喘いでいて、絶頂する寸前といった感じの妖艶な表情。\n・服は上はノーブラでユグドミレニアの制服。制服の胸元のボタンを外して、吸わせるために胸を露出させてる感じです。下は下着のみ。\n・相手の男はホムンクルスの少年。無我夢中で胸を吸っている。\n・セレニケさんの胸のサイズは大きめでお願いします。\n・セレニケさんのメガネもありでお願いします。\n\nまた色々マニアックになりましたが、ぜひご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/14", "thumbnail_src": "https://si.imgix.net/0fe08e0a/requests/180730_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473d4852a8ca8a0a1ca4c7c5d1be9cec", "thumbnail_srcset": "https://si.imgix.net/0fe08e0a/requests/180730_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473d4852a8ca8a0a1ca4c7c5d1be9cec, https://si.imgix.net/0fe08e0a/requests/180730_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1a7502abc9345e70c79b31b2694e8e1 2x, https://si.imgix.net/0fe08e0a/requests/180730_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=634e1dc6357bd4bb9489363d13cc576f 3x", "genre": "art", "nsfw": true, "body": "キィンタロウさん、こんにちは！あなたの作品が大好きです。この作品のリクエストは、ショタと大人の女性です。女性はLEAGUE OF LEGENDのアカリで、ショタは何でもいいですが、このビデオにインスパイアされました。\n\nhttps://www.youtube.com/watch?v=HGPoGtSBhu0\n\nアカリには支配的/セックスからの感動、ショタには必死/支配されているか震えているような感じでいてほしいです。マスクをしたままにしたいかどうかはあなたの選択です。\n\nセックスポジションは宣教師かカウガールか、あなたの好きなものであれば何でも構いませんが、アカリは引き締まっていますが筋肉質すぎないようにしてください。\n\n\nあらかじめありがとうございました!", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/13", "thumbnail_src": "https://si.imgix.net/f80d921e/requests/161485_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cfd63d1a346468afc3073c6a2a8c340", "thumbnail_srcset": "https://si.imgix.net/f80d921e/requests/161485_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cfd63d1a346468afc3073c6a2a8c340, https://si.imgix.net/f80d921e/requests/161485_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c8e04d437379b2fb44b3a177150630d 2x, https://si.imgix.net/f80d921e/requests/161485_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2fabeed040e78882f1e0106d07e4662 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n私が依頼したいのは、｢Fate｣シリーズの、セレニケ・アイスコル・ユグドミレニアさんです。描いて欲しいシチュエーションは以下の通りです。\n・相手を誘うような恍惚とした表情を浮かべている。舌を出していると尚良いです。メガネはありでお願いします。\n・片手は反対側の自分の胸の先を強く摘まんでいて、もう片方の手は自分の下腹部に這わせている。\n・服装はいつものユグドミレニアの制服で、前をはだけ下着を見せている。下はスカートを履いていない。下着は｢Fate/Apocrypha｣アニメの3話の時のデザインで。\n・胸の先端は下着の上から摘まんでいる。反対側も形が浮き出ている。\n・胸は大きめでお願いします。サイズ感としては以前描かれていた同人誌のアン・ボニー位で。\n\n色々注文が多くなって申し訳ありませんが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/12", "thumbnail_src": "https://si.imgix.net/1f47a90c/requests/158123_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c61604e31255decff1b4e0b0b89ba169", "thumbnail_srcset": "https://si.imgix.net/1f47a90c/requests/158123_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c61604e31255decff1b4e0b0b89ba169, https://si.imgix.net/1f47a90c/requests/158123_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8caf0bf688f00b4a6240d6b2884317ec 2x, https://si.imgix.net/1f47a90c/requests/158123_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b13adb356cb5769be0b211b1aa26c88 3x", "genre": "art", "nsfw": true, "body": "はじめまして、kinntarouさん。\n下記のリクエストをお願いします。\n\n・キャラクター\n「寝取られチャイナ服」の美月と、美月の夫\n\n・服装\n漫画同様、チャイナドレス&黒ニーソックス&ハイヒール。\n一切脱がさず、破かずお願いします。\n※挿入シーンでパンツをずらす描写は可。\n\n・シチュエーション\n《上》\n夫が美月のアナルに両手の人差し指を挿入。\n美月の表情は感じながらも笑顔で。\n可能であれば断面図の描写もお願いします。\n【ポーズ参考URL】\nhttps://chan.sankakucomplex.com/ja/post/show/19962813\n\n《中央》\n美月が夫のち○ぽをひょっとこフェラ。\n【参考URL】\nhttps://chan.sankakucomplex.com/ja/post/show/6182534\n\n《下》\n美月と夫がいちゃラブSEX。\nURLでは竿役の顔が隠れていますが、夫の顔は描写してください。\n【参考URL】\nhttps://hitomi.la/reader/732393.html#431", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/11", "thumbnail_src": "https://si.imgix.net/e95e81a9/requests/146285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99a17dc29c1e6fd0d8195381d8047afa", "thumbnail_srcset": "https://si.imgix.net/e95e81a9/requests/146285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99a17dc29c1e6fd0d8195381d8047afa, https://si.imgix.net/e95e81a9/requests/146285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bfe50276a44c5fd08152b44189ec322 2x, https://si.imgix.net/e95e81a9/requests/146285_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=038f4979288de6d32a09a93971da7417 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/10", "thumbnail_src": "https://si.imgix.net/d23fe038/requests/142064_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f531dead266659e511c7ee673489de4b", "thumbnail_srcset": "https://si.imgix.net/d23fe038/requests/142064_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f531dead266659e511c7ee673489de4b, https://si.imgix.net/d23fe038/requests/142064_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e94cb7de0599bc0bf30b3d79b48ff49c 2x, https://si.imgix.net/d23fe038/requests/142064_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3516c09eee08a2f358165dd573bba2e2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/8", "thumbnail_src": "https://si.imgix.net/cb2d19cb/requests/87389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=396fdb00ddd20814e1610d62af783a5e", "thumbnail_srcset": "https://si.imgix.net/cb2d19cb/requests/87389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=396fdb00ddd20814e1610d62af783a5e, https://si.imgix.net/cb2d19cb/requests/87389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b688a7f9124f85b755e60ca88589c93 2x, https://si.imgix.net/cb2d19cb/requests/87389_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a8fcc563e62871d7a742b2d2e4396cf 3x", "genre": "art", "nsfw": true, "body": "kinntarou様へ\n黒のガターの下着姿で血飛沫や臓物、美少年の四肢や肌、目の残骸が飛び散っているベッドの上で恍惚な表情を浮かべながら血だらけのナイフを舐めているFate/Apocryphaのセレニケ・アイスコル・ユグドミレニアさんを描いて欲しいです。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/7", "thumbnail_src": "https://si.imgix.net/acafea83/requests/85558_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbe1ff4dc4a489718f3458c545e5d9f8", "thumbnail_srcset": "https://si.imgix.net/acafea83/requests/85558_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbe1ff4dc4a489718f3458c545e5d9f8, https://si.imgix.net/acafea83/requests/85558_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1b99cf740b42ac42aed19b94be05703 2x, https://si.imgix.net/acafea83/requests/85558_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24f34a024d263e6e3744a8387be3a551 3x", "genre": "art", "nsfw": true, "body": "はじめまして！こんばんわ！\n以前ツイッターでアップされていたカイニスがとても良かったのでこの度ご依頼させていただきました！\n\n可能であればカイニスとモードレッドの2人を参考資料URLのようなポーズで両脇を見せて誘っているような構図のものをお願いいたします。\n\n・2人とも両腕を頭のうしろで組んだポーズで、全身絵でお願いいたします。\n\n・カイニスの体系は以前お描きになられたときより一回りほど巨乳な感じでお願いいたします。\n\n・モードレッドも胸大きめで、以前お描きになられたスカサハくらいでお願いいたします。\n\n・衣装は頭にウサミミ、首にリボン、乳首にハート型ニプレス、マイクロビキニ、ハイヒールをお願いいたします。色はそれぞれカイニスが黒、モードレッドが赤でお願いいたします。\n\n・表情は2人とも片目を瞑ってウインクして投げキスして誘ってるような感じでお願いいたします。※以前お描きになられたカイニスのような口で\n\n・左がカイニスでもモードレッドでもどちらでも大丈夫です。\n\n・可能であれば差分でニプレスなしの乳首丸出しのものを別レイヤーでお願いいたします。\n\nhttps://twitter.com/kkobayannnn/status/1269276979867447296", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/6", "thumbnail_src": "https://si.imgix.net/ed3ac1d6/requests/68333_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a31f51f224ca1e51e2f12f1e1f3b6f0e", "thumbnail_srcset": "https://si.imgix.net/ed3ac1d6/requests/68333_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a31f51f224ca1e51e2f12f1e1f3b6f0e, https://si.imgix.net/ed3ac1d6/requests/68333_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a22e4363700c5679c6779b7d14149c2b 2x, https://si.imgix.net/ed3ac1d6/requests/68333_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72d80b3dab91b78af079791b3524b3c9 3x", "genre": "art", "nsfw": true, "body": "自分が石油王だと思い込んでいる一般人ですが、以下の内容で依頼致します。\nキャラ\n→FGOの長尾景虎\nレーティング\n→R-18\nシチュエーション\n→布団の上、全裸、まんぐり返しでセックスする直前、おまんこをくぱぁとしている。竿役は必要なし。セックスに期待している表情で、目にハートマーク付き。陰毛はボーボーではなく、うっすら生えている形で。\n希望構図\n→https://www.pixiv.net/artworks/76708602\n\n備考\n→エロ絵をPCデスクトップ画面にする変態なので、フルカラー・横画像を希望\n\n以上、かなり細かいですが可能な限りで大丈夫です。\n厳しいようならば断って頂いても構いません。\n宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/5", "thumbnail_src": "https://si.imgix.net/2a9469fc/requests/66368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf3a06a793852996677f58c038829682", "thumbnail_srcset": "https://si.imgix.net/2a9469fc/requests/66368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf3a06a793852996677f58c038829682, https://si.imgix.net/2a9469fc/requests/66368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a7894166de844a9ff294413d1b0df03 2x, https://si.imgix.net/2a9469fc/requests/66368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cb24c621b4eaa4e81cd5f9699a4631c 3x", "genre": "art", "nsfw": true, "body": "こんばんは、初めまして！！　Reven（レヴェン）と申します！！\nバテスト神とアヌビス神とのイラストをpixivでお見かけして以来フォローしている、褐色おっぱい百合が大好きな輩ですｗ\n\nさて、描いていただきたいイラストですが、\n騒乱イバラシティ（http://lisge.com/ib/）というWEBゲームのオリジナルキャラクターのイラストをお願いしたいです。\n自分含め３人パーティを組んでおり、以下の３人のイラストをお願いします。メンバーには許可取り済です。\n・山田クレイモア（http://lisge.com/ib/k/now/r198.html）\n・猫ヶ原つくね（http://lisge.com/ib/k/now/r1368.html）←自分のキャラです。\n・百朱傾（http://lisge.com/ib/k/now/r1357.html）\n使用する場所は、戦闘終了後の勝利セリフに設定する演出絵を想定しています。\n戦闘ログ⇒http://lisge.com/ib/k/now/r198b1.html\nこのページ一番下のつくねの台詞『当ったり前だよなァ～』という表示の下に、横800px、縦600pxまでのサイズで表示されます。\n台詞とイラストの配置は、戦闘開始前台詞の部分をご参考にしてください。\n\n○描いていただきたい内容\n・山田－つくね－傾　の順番で3人並んでいる、腰下あたりから上までの範囲、3人とも身長は同じくらいです\n・戦闘終了後、勝ち名乗りでテンションの上がるつくねと、それに巻き込まれる感じの二人\n・つくねの両腕が二人の背中から腕を回して、二人の乳を鷲掴みにしている（乳は特盛り、鷲掴み質感マシマシでお願いします！）\n・山田はめんどくさそうに見返すのみ、傾は「あ、え、あ、やめていただけると。はい……。」的なこと言いながらも抵抗はしない\n・傾の頭か肩に黒いヤギのぬいぐるみ（戦闘中の召喚技イラスト参照）、傾の手にはピンク色の鞭（SM用のバラ鞭）\n・山田の武器はレバーアクションライフルなので、古式な銃を持たせていただければ（Kr98的なもの、そこまで拘りません）\n・背景指定は無しですが元サイトレイアウト、配色から浮かない色使いで\n\n以上です。\n出来れば、高画質データと上記の指定サイズデータと両方をいただけると嬉しいです。\n不明点がございましたら何なりとお尋ねください。", "created_at": "", "completed_at": ""}, {"path": "/@kinntarou0917/works/4", "thumbnail_src": "https://si.imgix.net/d5c51108/requests/65548_0?bg=%23fff&auto=format