00&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6729ef37092356db3fb183495d4dba94 2x, https://si.imgix.net/ada1448b/uploads/origins/2cf57402-082e-42e2-b88c-435b83030273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c2f377a6924e08160bcb4977220d7e9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/47", "thumbnail_src": "https://si.imgix.net/03d72bee/uploads/origins/dc384f10-4aaa-446f-816f-176853c578a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41e049b58e1ee07426c1c1dbe9789598", "thumbnail_srcset": "https://si.imgix.net/03d72bee/uploads/origins/dc384f10-4aaa-446f-816f-176853c578a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41e049b58e1ee07426c1c1dbe9789598, https://si.imgix.net/03d72bee/uploads/origins/dc384f10-4aaa-446f-816f-176853c578a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=791962dbd43f3b368e88512064c00903 2x, https://si.imgix.net/03d72bee/uploads/origins/dc384f10-4aaa-446f-816f-176853c578a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9367bc47ceaaf7e00384e5679a3fb655 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/46", "thumbnail_src": "https://si.imgix.net/a96356d3/uploads/origins/f08ff9ae-f105-4ee3-ba2c-69cd10117693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b20132be4f70b0e6f6e1fd39a3c1d5fc", "thumbnail_srcset": "https://si.imgix.net/a96356d3/uploads/origins/f08ff9ae-f105-4ee3-ba2c-69cd10117693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b20132be4f70b0e6f6e1fd39a3c1d5fc, https://si.imgix.net/a96356d3/uploads/origins/f08ff9ae-f105-4ee3-ba2c-69cd10117693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dde00e873efe6ddbd0d298662e80d2e9 2x, https://si.imgix.net/a96356d3/uploads/origins/f08ff9ae-f105-4ee3-ba2c-69cd10117693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab754e605028032b21bc8f11870b1ff5 3x", "genre": "art", "nsfw": false, "body": "いもーすさんこんにちは！今回はTRPG用に作成した下記自キャラのイラストをご依頼したく存じます。\n\n●出典シナリオ\n「序列祓魔-神を殺す祈祷術-」(弱小亭ろっしー様作)というシナリオの「HO1 絶対王者」の探索者として作成したキャラクターとなります。\n本作は異世界の教会に所属して悪魔と戦い、その成果に応じて序列1位〜100位までランク付けされる祓魔師(エクソシスト)達の戦いを描いたシナリオです。\n\n●キャラクター詳細\n・名前：ルクストリア・ヨハネス\n・25歳、男性、身長175cm\n・髪型：膝まで届く青く長い髪を肩下辺りで一つにまとめている。頭頂部に一房のアホ毛有り。\n・目元：睫毛長めの二重。眉は釣り眉気味。瞳は薔薇色(濃い目のピンク)で、十字型のハイライトが常に浮かぶ。\n・服装：神父服(カソック)にケープとストラを装着。靴はニーハイブーツ。ストラの先端には教会の紋章である「蛇の巻きついた十字架」の装飾。カソックとケープの裏地は瞳と同じ薔薇色。\n・装飾：頭に２つの荊の輪をクロスさせた形状の金冠を被っている。また、後ろに纏めた髪にも金の荊の蔓を巻きつけている。(金の蔓の先端は、髪を後ろで纏めている金の輪から伸びている)\n・武器：薔薇色の宝石と金装飾で彩られた、十字型の黒い大剣。\n\n・設定・性格\nランク付けの制度創設以来、常に序列1位に君臨し続けており、「絶対王者」と称されるエクソシスト。\n黙っていれば、聖職者の神聖なオーラと絶対王者の風格を兼ね備えた眉目秀麗な青年。\nだが、一度口を開けば陽気でフレンドリー、喧しくて大雑把、他人に引かれても気にせず距離を詰める程人懐こくて、時に胡乱でさえある賑やか男子。\nどんなに過酷な状況でも笑みを絶やさない鋼の精神力を持つが、人によっては喜怒哀楽の「怒、哀」が欠けているかのような違和感を感じるかもしれない。\n\n●資料\nキャラクター資料は以下リンク先をご参照ください。依頼元の本アカウント（暮村名義）ではなく、暮須名義のTRPGアカウント側で掲載しております。描きにくい装飾等あれば適宜アレンジして頂いて構いません。\nhttps://twitter.com/cresson_mdms/status/1672977599134572544?s=20\n\n●希望・利用目的\nいもーすさんの描く色鮮やかで滅茶苦茶カッコいい構図の戦闘絵大好き民のため、戦闘シーンのイラストを希望します！！\n資料の立ち絵ディスプレイは目を閉じているのがデフォルトになっておりますが、色的に映えるので、資料2枚目の戦闘差分同様、目は開眼モードでお願いします。\n大剣は手に持っていて欲しいですが、その他の構図やエフェクト・背景有無等はお任せ致します。\n\nイラストを描いて頂けた場合には、上記のTRPG用Twitterアカウントと、私のTRPG用のdiscordでいもーすさんのお名前・Twitter IDを付記して掲載させていただく可能性がございます。\n\nご依頼は以上となります。長文お読みいただきありがとうございます。ご検討の程宜しくお願い申し上げます！\n\nhttps://twitter.com/cresson_mdms/status/1672977599134572544?s=20", "created_at": "", "completed_at": ""}]}