5-b9d4-2199ae621e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fefb7c24533e1d9abed0c7163e9b3364", "thumbnail_srcset": "https://si.imgix.net/ff1bb374/uploads/origins/d8674231-48d3-4a75-b9d4-2199ae621e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fefb7c24533e1d9abed0c7163e9b3364, https://si.imgix.net/ff1bb374/uploads/origins/d8674231-48d3-4a75-b9d4-2199ae621e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e552b5dfcda41a9bcb7517a9dbe1ff9d 2x, https://si.imgix.net/ff1bb374/uploads/origins/d8674231-48d3-4a75-b9d4-2199ae621e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff5778db3eeac6487a0d8c3d7d19d2e8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/58", "thumbnail_src": "https://si.imgix.net/ae1fea90/uploads/origins/f87e6dc9-be70-4072-b3e7-19114dec9dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47506b0caf4687d24a414d5803a8f24b", "thumbnail_srcset": "https://si.imgix.net/ae1fea90/uploads/origins/f87e6dc9-be70-4072-b3e7-19114dec9dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47506b0caf4687d24a414d5803a8f24b, https://si.imgix.net/ae1fea90/uploads/origins/f87e6dc9-be70-4072-b3e7-19114dec9dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cc8234adbbae8b298cb9c20b5adcc89 2x, https://si.imgix.net/ae1fea90/uploads/origins/f87e6dc9-be70-4072-b3e7-19114dec9dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bad4d553be1449bbcb01c55f50f0b9d 3x", "genre": "art", "nsfw": false, "body": "いもーす様   \n\nいもーす様の色彩鮮やかで、キャラクターがとても生き生きとしており表情豊かなイラストがとても好きなファンです。カジノRap\"it fire様大好きです…！\nPFより存じ、リクエストをさせて頂きたく思っておりました…！\nいもーす様のお絵柄にて、下記キャラクターらを拝見させて頂けましたら嬉しいなと思った次第です。\n\n資料にございますオリジナルキャラクターのうちよそ(お相手様のご許可は頂いております)をお願いさせて頂きたく思います。\n関係性は、「夫婦」になります。\n・表情や描写範囲、シチュエーションなどはお任せ致します…！ \n・服装の細かい部分やわかりづらい点などは省略して頂いて一切問題ありません。 \n・用途：個人観賞用(ロック画面など)  \n\n表情のご参考などになれればと、下記、資料の他にキャラクターや関係の詳細な情報になります。\n\n左　ジャジャ・ヴィクトリオ　男性 24歳 190cm\n音楽鬼と言う炎属性鬼種族の青年。(種族や身体的特徴については資料参照)\nぶっきらぼうで短気、喧嘩っ早い性格。口が悪い。赤い炎や腕が武器。\n戦乱の世、治癒の術を持つ者のいない武力国家で戦士として働き、怪我を負い国境付近にいたところ、癒しの青い炎を持つ異国の女性、レヴィと出会う。怪我の治療をきっかけとし、性格も属性も反対ながらに、異なる色と効果の炎を持つ同士、別な“腕”を持つ者同士、互いにないものを補い合いながら惹かれ合い、やがて一緒になった。\n大柄でとても力強い同族の女性に比べて、他種族の女性はか弱く柔らかなものだと考えている。その為見た目性格に反してレヴィには慎重に接して来ており、とても大切に愛している誰から見ても愛妻家。\n\n右　レヴィ・サナタエル　女性　21歳　168cm \n祈りの力の強い宗教国家にて、海神信仰を続けるサナタエル家の当主。\n常に冷静沈着で多くを語らぬ性格であるが、他者を助けたいとの願いを強く抱く優しい女性。炎と触腕は武器でもある。\n怪我の治療にあたり、他者から触腕を気味悪がられることもさえもあったが、後の夫となったジャジャは「美しい」とすら言う。密かな願いであった「誰かに強く抱きしめてもらうこと」を叶えてくれたのも彼であり、互いの“腕”を繋ぎ仲睦まじく寄り添う。\n\n夫婦らしい、距離の近い雰囲気ですと幸いですが、\n共闘的な雰囲気などでもとても嬉しいです…！\n大変ご多忙の折かと存じますが、もしもよろしければ、ご検討頂けますと幸いです。 よろしくお願い致します…！\n\nhttps://drive.google.com/file/d/1-nIcZMxy0tnC9lRm7rMh0e6pdgEfPBvm/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/57", "thumbnail_src": "https://si.imgix.net/78e0385b/uploads/origins/48b3509f-a96e-43da-ad9b-f2831013137f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d31070745b85e0bf029912074d057c8", "thumbnail_srcset": "https://si.imgix.net/78e0385b/uploads/origins/48b3509f-a96e-43da-ad9b-f2831013137f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d31070745b85e0bf029912074d057c8, https://si.imgix.net/78e0385b/uploads/origins/48b3509f-a96e-43da-ad9b-f2831013137f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=341dade691fe697d49dfb3f77f6f4834 2x, https://si.imgix.net/78e0385b/uploads/origins/48b3509f-a96e-43da-ad9b-f2831013137f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5431e04412718f0bbd775921bb66bd1f 3x", "genre": "art", "nsfw": false, "body": "いもーすさん、いつも素敵な作品を楽しく拝読しております。もしよろしければ、サザさんが医療従事者として働いているシーンを描いていただけないでしょうか。そこに加えて、拙作のクロズという男を同じイラスト内に含めて貰いたいです。彼はエイリル教団で雑務をこなしているので、何かしらの物資をサザさんの仕事場に届けている可能性があります。もしくは幼少の頃に酷く負傷した左手の治療のため、患者として訪れているかもしれません。いずれにせよ、自身と比較的年齢が近い(と思われる)サザさんの姿を眩しく感じています。\nお仕事モードでマゼさんを黙らせたサザさんがとてもかっこよかったので、またそんな一面を見たい……という気持ちからのリクエストです。曖昧な指定で恐縮ですが、よろしくご検討ください。\n\n※イラストを自作小説の挿絵・表紙に用いる可能性があります\n※イラスト内のどこかにいもーすさんのサインをご記載ください\n\nhttps://www.pixiv.net/novel/show.php?id=21363257#3", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/56", "thumbnail_src": "https://si.imgix.net/6be54de0/uploads/origins/b689cf2e-7818-4810-b935-a68c0c7654c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89a4c505e697ae851892a47320e06fb6", "thumbnail_srcset": "https://si.imgix.net/6be54de0/uploads/origins/b689cf2e-7818-4810-b935-a68c0c7654c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89a4c505e697ae851892a47320e06fb6, https://si.imgix.net/6be54de0/uploads/origins/b689cf2e-7818-4810-b935-a68c0c7654c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=852396d6ea8c4fd228470c7a9a7d4be1 2x, https://si.imgix.net/6be54de0/uploads/origins/b689cf2e-7818-4810-b935-a68c0c7654c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d4a60b90b85ad3f96dd1cb67221daf3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/55", "thumbnail_src": "https://si.imgix.net/d3ff3c1e/uploads/origins/2ec902b2-aba3-4769-934f-1d4aa86bba78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd04467d558e8256b4290f213ae5da97", "thumbnail_srcset": "https://si.imgix.net/d3ff3c1e/uploads/origins/2ec902b2-aba3-4769-934f-1d4aa86bba78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd04467d558e8256b4290f213ae5da97, https://si.imgix.net/d3ff3c1e/uploads/origins/2ec902b2-aba3-4769-934f-1d4aa86bba78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5427f78723fe0343ef01ee64849a86b 2x, https://si.imgix.net/d3ff3c1e/uploads/origins/2ec902b2-aba3-4769-934f-1d4aa86bba78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27b4a9eb156984405166a48153a9d686 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵のスタイルが大好きで、私のOCのために一枚のイラストを描いていただければ幸いです。\n\nこのキャラクターはRPGの世界観に似た世界の人物で、外見は16歳の少年で、琥珀色の瞳と黒い乱髪、目立つアホ毛があります。普段は質素な服装（単にガチョウ黄色の服を着て、黒いベストを重ね着）と態度ですが、実は伝説級の冒険者で、非常に強力です。彼は優しい性格で、普段は他人に対して温かく自信に満ちた態度を見せます。しかし、任務を遂行する時は、敵に対しては果断で冷酷、無情な姿を見せます。\n\nこのキャラクターは雷神の神格を持っており、雷属性の上級魔法を得意としています。彼の最も特徴的な術式は、『即死』と『必中』の効果を持つ雷電斬撃です（通常、攻撃を発動する時は、指で攻撃対象を指し、必殺の斬撃が瞬時に対象を切り裂きます。同時に術式を発動する時、彼の瞳も光ります）。このイラストについては、被攻撃者の視点から、このキャラクターがその術式を発動して攻撃する様子と圧迫感を表現してほしいです（視界が雷光の斬撃で分割されるような感じ）。\n\nあなたが私の依頼を考慮してくださることに感謝します。以下はそのキャラクターの参考リンクです：\n\nhttps://drive.google.com/drive/folders/1d3Q8-tg9ERGN2cjELyYVXlxQyC1jDrbC?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/54", "thumbnail_src": "https://si.imgix.net/c889368a/uploads/origins/4ddf5dbf-c3e6-41c4-ab7e-ee4ca0665585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bb2717a65a5b63d05b27e648f11e03e", "thumbnail_srcset": "https://si.imgix.net/c889368a/uploads/origins/4ddf5dbf-c3e6-41c4-ab7e-ee4ca0665585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0bb2717a65a5b63d05b27e648f11e03e, https://si.imgix.net/c889368a/uploads/origins/4ddf5dbf-c3e6-41c4-ab7e-ee4ca0665585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ec1c7491295801cf7fd676ea20d4d9c 2x, https://si.imgix.net/c889368a/uploads/origins/4ddf5dbf-c3e6-41c4-ab7e-ee4ca0665585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf1abc525f3bd6e54807d3142a4f2b2a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/53", "thumbnail_src": "https://si.imgix.net/28db1310/uploads/origins/921fad97-b340-4378-93c0-0c20b93b1d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=676f176565d2f3d98c2bbd2447d59590", "thumbnail_srcset": "https://si.imgix.net/28db1310/uploads/origins/921fad97-b340-4378-93c0-0c20b93b1d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=676f176565d2f3d98c2bbd2447d59590, https://si.imgix.net/28db1310/uploads/origins/921fad97-b340-4378-93c0-0c20b93b1d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b3892454ca709dbb773c5db9ee59408 2x, https://si.imgix.net/28db1310/uploads/origins/921fad97-b340-4378-93c0-0c20b93b1d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c52d7246555803a4c66eb1109f272222 3x", "genre": "art", "nsfw": false, "body": "いもーすさん、先日はエアスケブで素敵なイラストを仕上げてくださりありがとうございました。\n\nこれを機にいもーすさんのイラストをもっと拝見したいと思い至りましたので、skebにてお願いに参りました次第です。\n\n私のPFSOZ企画内キャラクター、リシェロの「戦闘シーン」を描いて頂きたいのです。\n\n表情があまり表に出ず、穏やかで優しい一面ばかりが浮き立つキャラクターの仕様上、企画内文章であまり描写が出来ませんでしたが、本来は人を庇護する存在ですので、是非リシェロの勇ましい一面をいもーすさんにお描きいただきたいのです。\n\nこちらからお願いしたい要素は、\n・白孔雀のイメージ（資料に記載頂いています）\n・炎のエフェクトがあって欲しい\n・戦っている姿は人間形態、または半人半鳥いずれかであって欲しい\n以上です。\n\n私自身がよく理解できていないことをいもーすさんにお任せするような形になってしまいますが、この三つがあれば構図などは自由にしていただいて構いません。\n物理攻撃も魔法的な攻撃も出来るので、どちらでも問題ありません。\nいもーすさん独自の解釈をお入れくださっても、もちろん嬉しいです。\n\n何卒宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/103791098", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/52", "thumbnail_src": "https://si.imgix.net/ec5cfe7a/uploads/origins/4e117112-faa8-48cb-ad39-dd33c3087f51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eefac473050da331baf1fe5840dd0ebc", "thumbnail_srcset": "https://si.imgix.net/ec5cfe7a/uploads/origins/4e117112-faa8-48cb-ad39-dd33c3087f51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eefac473050da331baf1fe5840dd0ebc, https://si.imgix.net/ec5cfe7a/uploads/origins/4e117112-faa8-48cb-ad39-dd33c3087f51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47d362e798b3256f25da527422844582 2x, https://si.imgix.net/ec5cfe7a/uploads/origins/4e117112-faa8-48cb-ad39-dd33c3087f51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dba8bf6258e17933ecdacea6de0542f 3x", "genre": "art", "nsfw": false, "body": "はじめまして。IRIAMという配信アプリで活動している千更と言います。\n12月15日に活動半周年を迎えます。その半周年を記念した絵をお願いしたくご連絡させていただきました。(納品が記念日をすぎても構いません)\n\n１，バーテンダーとワイン職人をしております\n２，タトゥーは描きづらいと思うので、簡略化か、描きやすい柄に変更可\n３，ワインやウィスキーなどの色んなお酒、ぶどうを描いて貰えると嬉しいです\n\nお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@imo_su_p/works/51", "thumbnail_src": "https://si.imgix.net/d389967b/uploads/origins/062debde-d56d-41a0-bce4-638994b81794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c6cdf8f9c6bc379e1749cdb3d826f03", "thumbnail_srcset": "https://si.imgix.net/d389967b/uploads/origins/062debde-d56d-41a0-bce4-638994b81794?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&t