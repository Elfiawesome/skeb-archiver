=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6162a92b5e90396ac736eceaa64a742 2x, https://si.imgix.net/15e5232b/uploads/origins/56ad2eb1-b1ff-4950-9169-14da8be08f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abf7d570388dbd42ce21f43189326661 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/31", "thumbnail_src": "https://si.imgix.net/93e0f5bc/uploads/origins/df2f88ec-60f4-40bc-9dfc-78446d814e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c6b93b08121cb5324fbb30dd6e31953", "thumbnail_srcset": "https://si.imgix.net/93e0f5bc/uploads/origins/df2f88ec-60f4-40bc-9dfc-78446d814e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c6b93b08121cb5324fbb30dd6e31953, https://si.imgix.net/93e0f5bc/uploads/origins/df2f88ec-60f4-40bc-9dfc-78446d814e16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27be4c55bf383b781dd1222eece92a8a 2x, https://si.imgix.net/93e0f5bc/uploads/origins/df2f88ec-60f4-40bc-9dfc-78446d814e16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b268cd90c559b81551204be3378c34e 3x", "genre": "art", "nsfw": true, "body": "はじめまして。じぇふと申します。\n先生の描かれたドリーディアやスターアニマが滅茶苦茶癖に刺さったので、ご依頼させて頂きます。\n恐らく先生がご存じないゲームのキャラクターで申し訳ありませんが、メギド72というゲームのウヴァルという冷静な女戦士キャラでご依頼致します。\n\nキャラ：ウヴァル（メギド72）詳細は以下のリンクになります。\nhttps://megido72wiki.com/index.php?%E3%82%A6%E3%83%B4%E3%82%A1%E3%83%AB%EF%BC%88%E3%82%AB%E3%82%A6%E3%83%B3%E3%82%BF%E3%83%BC%EF%BC%89\n\n彼女のギャル蜂怪人化のイラストのビフォーアフターをお願いしたく存じ上げます。\n\nシチュエーション\n①幻獣の群れを殲滅し、一息ついた所で蜂に刺されるウヴァル。毒か！？と思い対処しようとするもそのまま意識が遠のく。\n②ウヴァルが気がついた時にはガングロギャルになっており、男達から精液を搾り取っていた。まずいと思いつつも快楽に流されて、絶頂すると同時に体中から蜜のようなものが溢れて蛹化。\n③蛹の中からボテ腹で体中に淫紋が刻まれたギャル蜂と化したウヴァルが羽化して、舌舐めずりしながら獲物を探そうとする。\n\n構図や衣装に関しましては、お好みに合う形に変えて頂いて大丈夫です。\nご面倒な依頼だと思いますので、気がのらない場合は遠慮せずに蹴って下さい。\n以上、どうかご検討頂けたら幸いです", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/30", "thumbnail_src": "https://si.imgix.net/3438f3b7/uploads/origins/940973bb-a412-4c09-8bb4-34d570bdd7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a2527f95533d5ca059515b0f3c40b8", "thumbnail_srcset": "https://si.imgix.net/3438f3b7/uploads/origins/940973bb-a412-4c09-8bb4-34d570bdd7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a2527f95533d5ca059515b0f3c40b8, https://si.imgix.net/3438f3b7/uploads/origins/940973bb-a412-4c09-8bb4-34d570bdd7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14c6bc4230b6da023a5fae626118a376 2x, https://si.imgix.net/3438f3b7/uploads/origins/940973bb-a412-4c09-8bb4-34d570bdd7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9eb145153affed7c12ba447dd3f296b 3x", "genre": "art", "nsfw": true, "body": "以前より変脳作品を好ませて頂いております！\n有償依頼自体初めてですので、変なところや至らぬ点等御座いましたらキャンセルしてくださって大丈夫です！\n今回は、うちの子変身ヒロイン、『レインボーペタル』の酢メル徒化を依頼させて頂きたく思います。\n資料urlは、レインボーペタルの立ち絵となっております。\nまだ公開予定ではありませんでしたが、依頼のために公開するために別垢になっております、ご了承ください。\n基本絵1枚と、差分たくさんという方式でお願いできると嬉しいです。\n\n以下依頼内容です。\n\n視界内へのワープと、水魔法、それから双剣を扱うヒロインであるレインボーペタル。\n新進気鋭な彼女は、ある時突然何者かに囚われてしまう。\n何らかの催眠の作用か、動きを完全に封じられてしまったレインボーペタル。\n彼女は、臭い責めによって調教されてしまう……。\n\n※攻め手のセリフや、足りないレインボーペタルのセリフは、必要なら追加お願いします。\nレインボーペタルは一人称があたしで、元気っ子って感じの口調です。\n\n\n1 \n\n「あ、あたしどうなったの！？　ここ、どこ！？　なんでこんなに臭いのっ！？」\n\n（どう、しようっ！　動けないっ……！？　と、とにかく！　ここから逃げないとっ！！）\n\nとある部屋で目を覚ましたレインボーペタル。\n武器は失われ、その体は両腕を頭の後ろに回し、腰を深く落とした、所謂エロ蹲踞から動かせなくなっている。\nただ、視界は未だ塞がれていない。\n故に、ワープを用いて、変態どもの手から逃れようとする……。\n衣装はデフォルトの資料通り、まだ改造しない感じでお願いします。\n驚きながらも反抗的に、まだ負けてないぞという決意のこもった表情でお願いします。\n\n2\n\n「ぅうううっ！？！？　く、くさぃいいっ！！　こんな、こんなの、目隠しにするなんてぇえっ！！」\n\nしかし、エロ蹲踞から動かせない体では、そんな抵抗など些事であった。\nレインボーペタルはあっさりと捕まり、その目にくっさい酢メル徒の真っ黄色に黄ばんだ靴下を巻きつけられる。\n顔から香る強烈な匂いに悶絶するレインボーペタル。\n強烈な匂いに苦しんでいる感じでお願いします。\n（もし余裕があれば、以降靴下を外す時まで目元透け差分として涙目で目瞑ってるものが欲しいです）\n\n3\n\n「え、何？　臭いのが、近づいて……！？　むぅううううっ！？！？　くしゃい゛ぃいいいっ！？！？　く゛し゛ゃい゛い゛い゛い゛っ！！！！」\n\nそんなレインボーペタルの顔に、酢メル徒特有の腋毛の生い茂ったじっとり濡れた腋が押し付けられる。\n目隠しで状況がわからない彼女は、突然のそれに、そしてジョリジョリとした触感、強烈な匂いに激しく悶えてしまう。\n\n4 \n\n「や、やめ゛ぇえっ！！　やめ゛、てよお゛ぉおおっ！！！　あ、たしぃい゛っ！！　変に、なり゛ゅぅうう゛うっ！！！！」\n\n（なんで！？　こんなの、こんなの嫌なのに！　臭いのに！！　あたし、これ、いい匂いだって思っちゃう！？　なんで！？　なんでなのっ！？！？）\n\nジョリ、ジョリ、ジョリ、と激しく鼻に擦り付けられる腋。\n臭くて苦しくて仕方がないはずなのに。\n麻痺したのか、おかしくなってしまったのか。\nその体は快感を感じ始めてしまう。\n激しく苦しんでいたはずの口元は、少し緩んで唾液すらうっすら垂らしてしまう有様だ。\n\n5\n\n「だ、めぇえええっ♡♡♡ くしゃいのに、くしゃいのでぇえ゛っ♡♡♡ イ、っちゃうぅうううっ♡♡♡」\n\n……数分後。\nその体は強烈な悪臭漬けに屈服し、アクメ潮を噴き出してしまう。\n表情は、気持ち良さそうなアクメ顔。\nとは言え目隠しされているので口から舌を突き出す感じで。\nその変身ヒロインの衣装は、魔力が変質して酢メル徒に相応しいものへと変わっていく。\n腋に、乳首に、股間に、穴がハート型に開いてしまう。\nまだ堕ちきってはいないため、腋毛はなし、陰毛はうっすら髪と同じ色でお願いします。\n\n6\n\n「あ、あたし、負けちゃ、ったぁあ……♡ もう、くしゃいの、やみつきだよぉ……♡」\n\n彼女の屈服した姿を見て、酢メル徒は目隠し代わりの靴下を解く。\n下から現れたのは、完全に堕ちきったようなトロ顔だった。\n\n7\n\n「こ、これぇっ♡ すんっ♡ すんすんすんっ♡ いい、匂いだよぉおっ♡ また、またイくぅううっ♡♡♡ ごほーび、ありがとうごじゃいましゅぅううっ♡♡♡」\n\nそんなレインボーペタルに対し、洗脳にも用いるアイテムである、マンカスまみれの黄ばんだパンティを、その顔に変態仮面のように被せる。\n変態そのものの姿で、彼女は何度も何度もアクメを迎えるのだった。\n\n8\n\n「元レインボーペタル、酢メル徒洗脳完了致しましたぁっ♡ あたしもくっさい匂いになれたなんて素敵……♡ えへへ、皆にも教えてあげないと……♡」\n\nそれから数時間後。\n散々乱れたレインボーペタルは、完全に酢メル徒に堕ちてしまった。\nその衣装はレインボーペタルの元衣装の意匠を残しつつも、とてつもなく卑猥に改造されたもの（堕落さんぽさんのセンスがめちゃくちゃ好きなのでお任せします！）\n陰毛も腋毛も生え放題で、きったない感じでお願いします。\nそれと、この最後に関しましては、通常肌ノーメイク髪色水色のパターンと、褐色肌ギトギトメイク髪色も変更のパターンが欲しいです。\n\n\n非常に長くなってしまった上、直近のプリキュアの子ととても近しい依頼になってしまいました。\n故に、厳しいようならキャンセル然り削っていただく然りして頂いて大丈夫です。\nご一考よろしくお願いします。\n\nhttps://x.com/rn1dufvjr967085/status/1890417079028740330?s=46&t=JAjU2Q6YAB7D8zMp-fx8bQ", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/29", "thumbnail_src": "https://si.imgix.net/0231ecc5/uploads/origins/59ec6652-bb5b-4ab9-bc95-3df61e7c52d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6e3927e168ed61e66cde7e8106aff46", "thumbnail_srcset": "https://si.imgix.net/0231ecc5/uploads/origins/59ec6652-bb5b-4ab9-bc95-3df61e7c52d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6e3927e168ed61e66cde7e8106aff46, https://si.imgix.net/0231ecc5/uploads/origins/59ec6652-bb5b-4ab9-bc95-3df61e7c52d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f4a477f62909249fcee24455a2fd1d1 2x, https://si.imgix.net/0231ecc5/uploads/origins/59ec6652-bb5b-4ab9-bc95-3df61e7c52d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e98f74da45a88dfbdcbce4b64e0d2f28 3x", "genre": "art", "nsfw": true, "body": "差分形式の一枚絵で、\n\nキュアスパイシー+パムパム(妖精状態)\nの酢メル徒洗脳(おなら要素あり)+悪堕ちシチュをお願いしたいです！(パムパムはあくまでおまけ程度で大丈夫です)\n\nポーズ:エロ蹲踞\n衣装:\nスパイシーの衣装を卑猥にアレンジした感じ\n元カラー→悪堕ちカラーに\n(悪堕ちカラーの色分けはお任せします)\n髪型:\nスパイシーではなく、変身前の、ここねの髪型をベースにしたデザインでお願いします。\n肌の色、メイク:\n全差分を通して、肌色は元の色から変化なし、メイクもなしでお願いします　\nシチュ:\n体を操られ強制エロ蹲踞(この時点でパムパムは洗脳済み)\n→男の尻を押し付けられ、汗や尻の穴の臭いで洗脳されていく\n→ゼロ距離でおならを浴びせられ、トドメを刺される\n→衣装が悪堕ちカラーになり、洗脳完了。男にメロメロのシモベとして生まれ変わる\n\n以下に細かい流れとセリフを記載しています。\n\n\n1.(基本絵)強制エロ蹲踞で困惑顔\nス「………ん……」\n\nパ「あ、起きたパム♡」\n\nス(そうだ…私、街を襲った変態におならを嗅がされてから、気絶して…)\n「………え？何、この姿…」\n\nパ「驚かなくて大丈夫パム♡酢メル妖精として生まれ変わったパムパムが、スパイシーの姿をご主人様好みに変えてあげただけパム♡」\n\nス「パムパム！？何を言ってるの！？一体何が起こって…」\n\nパ「すぐにわかるパム♡」\n\n2.男の尻を顔に押し付けられられる\n顔を赤らめながら必死に洗脳に抵抗\n\nス「くさっ！？」\n(汚い…気持ち悪い…！)\n\nパ「ほら、はやくご主人様のくっさーい臭いで洗脳してもらうパム♡」\n\nス(洗脳…？パムパムはこの臭いで操られたっていうの？)\n「ダメ…私は…負けない…！」\n\n3 ゼロ距離でおならを浴び、悶絶\n\nス「〜〜〜〜〜〜ッ♡♡♡♡」\n\n4 だらしない顔で再び気絶\nス「……………………♡」\n\nパ「あーあ♡幸せそうな顔で気絶しちゃったパム♡」\n\n5 衣装がダークカラーになり、気絶から目覚める\n\nス「あれ、私…」\n\nパ「ようやく起きたパム♡\nほら、ご主人様がお待ちかねパム♡」\n\nス「…………………」\n \n6すっかり虜になってしまい、洗脳完了。おならをしながら、恥ずかしそうにもじもじとした笑顔で男に告白する。瞳にはハートが浮かんでいる\n\nス「好きです…♡ご主人様♡\nご、ごめんなさい、いきなり…\nでも私、あなたの臭いを…おならを嗅いでからあなたのことが好きで好きで仕方なくて…♡\n…私を彼女に…？本当…？\n\nも、もちろん！なる…なります！\nあなただけを守って、あなただけの為に戦う、あなただけのスパイシーに♡」\n\n7悪そうな笑顔で名乗り\n\nス「くっさい酢メルで心に忠誠♡酢メルスパイシー♡ご主人様の素敵な臭いで洗脳完了♡絶対の忠誠、刻みつけるわ♡\n\nご主人様♡あなたの忠実なシモベ、酢メルスパイシーに何なりとご命令を♡」", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/28", "thumbnail_src": "https://si.imgix.net/0f833b9d/uploads/origins/498a5b50-4dfe-4f11-9ee1-7b76b53d3f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d9d5e029644b59ca73e9c7f549727b3", "thumbnail_srcset": "https://si.imgix.net/0f833b9d/uploads/origins/498a5b50-4dfe-4f11-9ee1-7b76b53d3f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d9d5e029644b59ca73e9c7f549727b3, https://si.imgix.net/0f833b9d/uploads/origins/498a5b50-4dfe-4f11-9ee1-7b76b53d3f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=070c4f89473200c72e3548b90866e0ec 2x, https://si.imgix.net/0f833b9d/uploads/origins/498a5b50-4dfe-4f11-9ee1-7b76b53d3f1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de1d1ddb7185e6f79498a0d6443f99a3 3x", "genre": "art", "nsfw": true, "body": "いつも作品楽しみにしております。前回は素敵なイラストありがとうございました。今回もイラストをリクエストしたく思いリクエストを送らせていただきます。\n下記参照画像のオリジナルキャラクターのボディコン変態洗脳イラストを描いていただきたく思います。\n\n参照画像：https://cdn.tw4.jp/i/tw4/basic/2447/168094_d24476_totalbody.jpg\n\nボディコン衣装はこちらの参考画像のような衣装でお願いしたく思います。\n\n衣装参考画像：https://x.gd/7GFik　（amazonの商品ページのURLを短縮したものになります）\nもしくは「SENMHOO 秘書 セクシー ベアトップ インナー ドレス ワンピース 刺激 なりきり チューブトップ ボディコンスーツ ボディコンランジェリー 光沢 ミニ ワンサイズ 01850 (レッド)」で検索していただけると確認できるかと思います。\n\n衣装の色は赤色で、アイシャドウ、リップも赤でケバケバしくお願いします。\nポーズはジュリ扇を振って無様な表情で踊り狂っているような感じでお願いします。\n参照画像にある銃は描写しなくて大丈夫です。\nセリフの有無もお任せします。\n補足としてキャラの性格はツンデレです。\n指定が多くて申し訳ございませんがご検討いただけると幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/27", "thumbnail_src": "https://si.imgix.net/dedb7481/uploads/origins/535e70df-5743-45f9-adbe-393a4a5e34bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0ed8fe75d3f2e1df3a6c252de039ad", "thumbnail_srcset": "https://si.imgix.net/dedb7481/uploads/origins/535e70df-5743-45f9-adbe-393a4a5e34bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0ed8fe75d3f2e1df3a6c252de039ad, https://si.imgix.net/dedb7481/uploads/origins/535e70df-5743-45f9-adbe-393a4a5e34bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25749c1bf24c2f84e092f028ee8b0bc2 2x, https://si.imgix.net/dedb7481/uploads/origins/535e70df-5743-45f9-adbe-393a4a5e34bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3401e00ca57cc729c17e5a1717feec9 3x", "genre": "art", "nsfw": true, "body": "さん様!skebでははじめましてです！\n\nリクエストよろしいでしょうか？\n\nリクエスト内容は、漫画家猗笠怜司様が少年ジャンプ＋で連載していた神のまにまにという漫画に登場していた海の神の超乳女怪人堕ちが見てみたいです！\n\n自分のうちの子の超乳女怪人のウルトラ・ボイン・Zちゃんhttps://www.pixiv.net/artworks/107708891とハイパー・ドタプン・Zさんhttps://www.pixiv.net/artworks/108904677とコラボしてる感じになります!\n\n話の展開としては、\n\n①漫画神のまにまにの最終回で主人公に倒され死んだはずの海の神が目を覚ますと、自分の胸が体よりも巨大になりバランスボールや風船のように丸くてパンパンになった巨大な超乳になり、髪と顔と肌色はそのままだがいつもの服装ではなくウルトラ・ボイン・Zちゃんと同じ奇抜な姿になってることに気付く。（服のカラーは水色と緑と海の神の元の服装と同じカラーでお願いします。）\n\n②海の神が目を醒めるのを待ってたウルトラ・ボイン・Zちゃんとハイパー・ドタプン・Zさんが海の神の前に現れて、2人に事情を教えられ主人公に倒された海の神を誰にもバレないように2人が連れ去り生き返らせるついでに体を改造したという事実を知らされる。\n\n③その事実に怒った海の神が2人を殺そうとするが体を動かすことができなかった。2人によると今のままでは体を動かすことができず、このままだと身も心も超乳になってしまい自分が海の神ではなくなってしまうと言われ、恐怖を覚える海の神。\n\n④ボインちゃんとドタプンさんは海の神を特大の乳イキで絶頂させ超乳堕ちさせようとし、海の神はやめてと泣いて許しを請うが断られ、海の神は体よりも巨大な超乳にビームを当てられて特大の乳イキで絶頂させられる。\n\n⑤身も心も超乳となってしまい、人を襲い支配していた海の神は、ボインちゃんとドタプンさんとかの超乳女怪人に従順で忠誠を誓う超乳の神となり、2人と同じように人々などを超乳化するようになるがそれはまた別のお話…\n\nという感じでお願いします！！\n\nもし可能ならpixivやXにも投稿して欲しいです!", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/26", "thumbnail_src": "https://si.imgix.net/7e7d8ce9/uploads/origins/a6323378-2773-4d85-8d64-a8586d2ca58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fbd703c18d39ac6d5072c5f0a839eaf", "thumbnail_srcset": "https://si.imgix.net/7e7d8ce9/uploads/origins/a6323378-2773-4d85-8d64-a8586d2ca58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fbd703c18d39ac6d5072c5f0a839eaf, https://si.imgix.net/7e7d8ce9/uploads/origins/a6323378-2773-4d85-8d64-a8586d2ca58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=138572265a1829e6d0aaf1791da6f85e 2x, https://si.imgix.net/7e7d8ce9/uploads/origins/a6323378-2773-4d85-8d64-a8586d2ca58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc003e7d9f78aaccdfb6ce64ee54b5fb 3x", "genre": "art", "nsfw": true, "body": "ハートキャッチプリキュア!のキュアブロッサムとキュアマリンがミラピュア2話のナメクジ怪人に変えられてしまうものをお願いします。\nあのシチュエーションがとても好きです。", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/25", "thumbnail_src": "https://si.imgix.net/52aedb80/uploads/origins/9ede64ab-1d4c-40b1-8ebd-554437ab99a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bf5410b210a3eaa5c8ffd625075a7dc", "thumbnail_srcset": "https://si.imgix.net/52aedb80/uploads/origins/9ede64ab-1d4c-40b1-8ebd-554437ab99a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bf5410b210a3eaa5c8ffd625075a7dc, https://si.imgix.net/52aedb80/uploads/origins/9ede64ab-1d4c-40b1-8ebd-554437ab99a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59c6facf0f2c18ab850fec069ecffb9f 2x, https://si.imgix.net/52aedb80/uploads/origins/9ede64ab-1d4c-40b1-8ebd-554437ab99a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b4fea3b97f8992ec53d24dfde0fbb60 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/24", "thumbnail_src": "https://si.imgix.net/f6d675a9/uploads/origins/af09de0d-ffb3-40ad-b5b4-b84742d1be3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=718692c3f29ddaa98d25dc746c0f7fc1", "thumbnail_srcset": "https://si.imgix.net/f6d675a9/uploads/origins/af09de0d-ffb3-40ad-b5b4-b84742d1be3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=718692c3f29ddaa98d25dc746c0f7fc1, https://si.imgix.net/f6d675a9/uploads/origins/af09de0d-ffb3-40ad-b5b4-b84742d1be3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99210d6bd15d4a1a49e1076ecab6e567 2x, https://si.imgix.net/f6d675a9/uploads/origins/af09de0d-ffb3-40ad-b5b4-b84742d1be3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b93a96d3771f7cff0c6e6690cc4d7450 3x", "genre": "art", "nsfw": true, "body": "ワタモテの黒木智子のケースと、乳首もアソコも隠さないナイロンスーツを着て、乳首と舌にピアスをして、オープンカメラの前でオナニーするのが大好きな巨乳の山姥ギャルの比較です。\n前編では恥ずかしそうに服を着たまま普通に立っているはずです。服を脱いでパンストだけになり、目を隠しながら裸体を堂々と見せる。ヌード写真を撮ってネットにアップし、新しい出会いを求めます。\n後編では、黒タイツ一枚の裸がディルドでオナニーを楽しみ、その様子を撮影。彼女は自分の裸の写真の下にあるコメントを読み、セクシーでムラムラと呼ばれる、彼女は非常に賞賛が好きで、それを続けたいと思います。 彼女はもっとオープンにヌード写真を撮るようになり、ディルドでオナニーしている写真も撮るようになります。\nそんな中、彼女はインターネットで同じ趣味を持つ素敵な紳士と出会い、会うようになる。二人はすぐに理解し合い、付き合うことになる。彼は彼女にもっと注目を集めるためのヒントを与え、またバストアップやイメチェンをするようにアドバイスする。パート終了時には、彼女は開放的な服装と金髪で立っているはずです。\n第3部は1年後の話です。彼女は今、黒い肌、濃い化粧、カラフルな髪、大きな胸を持つギャルになっている。指輪やネックレスなどのアクセサリーを身につけ、ピアスや長い爪もつけている。黒いパンストだけの裸体に巨大なディルドを突っ込み、ピースサインをする。ボーイフレンドは彼女のマネージャーでありながら、すでにオーナーのようなもの。2人のフェチは完璧に補完しあい、彼女は時々彼のためにセックス中にペットを演じるのが好きだ。彼らは写真で良いお金を稼ぎ、セックスビデオも作っています。\n第4部は最後のパートで、彼女は巨大な胸を持つ重い黒い肌の妊娠中の山姥ギャルで、高いヒールの靴を履きながら乳首とヴァギナを露出したナイロンスーツを着ている。髪はカラフルに整え、飼い主の犬の首輪を付けている。彼女はセックス依存症で、飼い主のペットである。彼女は彼と多くのビデオを作り、彼らは多くのお金を稼いでいる。彼女は多くのポルノをやり、多くの男性とセックスしてきたが、飼い主と一緒にいる。\nというのが、絵のあるストーリーの考え方でしょう。何コマかで説明するのではなく、絵でナレーションを入れるのですが、それは大まかなものなので、プランがあるのでしょう。友子さんの大きな絵が一枚あるだけでいいんです。\n\nhttps://static.wikia.nocookie.net/watamote/images/c/c2/2_Tomoko%27s_perverted_nature.jpg/revision/latest?cb=20220321144119", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/23", "thumbnail_src": "https://si.imgix.net/3697b688/uploads/origins/7a4faa90-c459-4661-a479-d1cbfae26e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095d1d13f2dbbe90d2b51fbf57018b46", "thumbnail_srcset": "https://si.imgix.net/3697b688/uploads/origins/7a4faa90-c459-4661-a479-d1cbfae26e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=095d1d13f2dbbe90d2b51fbf57018b46, https://si.imgix.net/3697b688/uploads/origins/7a4faa90-c459-4661-a479-d1cbfae26e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25d68ddb775d30bd97acc226bfb42f79 2x, https://si.imgix.net/3697b688/uploads/origins/7a4faa90-c459-4661-a479-d1cbfae26e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eba7f54eb6e4a5153a7964f3fb25e84 3x", "genre": "art", "nsfw": true, "body": "雪泉のマラ頭巾拝見しました。\n素晴らしいイラストでした。\n同じ閃乱カグラから春花のマラ頭巾をお願いしてもよろしいでしょうか。\n①マラ頭巾を被せられたが余裕そうな顔で脱ごうとする\n②マラ頭巾を扱く快感に囚われ人格排泄をさせられると知り命乞いをする\n③あっさり人格ザーメンを吹き出しシコることしか考えられなくなる\n④マラ頭巾春花としてマラシコをしてザーメンを撒き散らす変態怪人に成り下がる\n\nのシーンをお願いします。\nおっぱいと乳首は雪泉の時よりかなり大きくして欲しいです。", "created_at": "", "completed_at": ""}, {"path": "/@SaN1111_/works/22", "thumbnail_src": "https://si.imgix.net/f059868c/uploads/origins/768e4ae4-c40e-4f68-b28e-d8fd0fa61938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abe815eb5cc32577f005e8032a5074bc", "thumbnail_srcset": "https://si.imgix.net/f059868c/uploads/origins/768e4ae4-c40e-4f68-b28e-d8fd0fa61938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abe815eb5cc32577f005e8032a5074bc, https://si.imgix.net/f059868c/uploads/origins/768e4ae4-c40e-4f68-b28e-d8fd0fa61938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57b99c41b8d1c1ea99ab54250be31ca0 2x, https://si.imgix.net/f059868c/uploads/origins/768e4ae4-c40e-4f68-b28e-d8fd0fa61938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cda9a20b3ede10bff3f47b61b9265bb1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "comple