?s=46&t=LpjdAf0qXkml8nByQTnG8w\n\n服装の指定はありません。構図はお部屋にベッドがおいてあるのでこれに会うような形だと嬉しいです\nhttps://media.discordapp.net/attachments/1092812775895617626/1101315293596373072/47.png?width=1119&height=701\nhttps://media.discordapp.net/attachments/1092812775895617626/1101315293298556948/46.png\n\nhttps://cdn.discordapp.com/attachments/899255212399804446/1102614255901085726/c1dc740c3ea63eeb.png", "created_at": "", "completed_at": ""}, {"path": "/@osu4p10/works/1", "thumbnail_src": "https://si.imgix.net/df013536/uploads/origins/a559402c-3d7c-4de3-a99f-543d07ae4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3279cb7f8bd669c3a91ca6cca9b05bec", "thumbnail_srcset": "https://si.imgix.net/df013536/uploads/origins/a559402c-3d7c-4de3-a99f-543d07ae4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3279cb7f8bd669c3a91ca6cca9b05bec, https://si.imgix.net/df013536/uploads/origins/a559402c-3d7c-4de3-a99f-543d07ae4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=98a118e6d694a33380fe25912b19b20a 2x, https://si.imgix.net/df013536/uploads/origins/a559402c-3d7c-4de3-a99f-543d07ae4cf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1694865f8fb57ca4eb4a73cc6131ab7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}