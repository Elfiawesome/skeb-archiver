4960-8cc8-475467c221c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7aa6d4e219fae27fe7fef139be06cf7 2x, https://si.imgix.net/897be4eb/uploads/origins/2c07daac-4793-4960-8cc8-475467c221c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b4d6e8c5883e098f30dc01d297c6706 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n間違いなく描きたいね！描いてくれるほど気に入ってくれてうれしいよ！彼はOC/D&Dのキャラクターで、やんちゃなタンクなんだ。あなたがどんな彼を描けるか見てみたいわ！(私がいつも指摘する2つのことは、彼の巻き毛と尻尾です。時々忘れられるので)\n\n彼のリファレンスはこちら\nhttps://files.catbox.moe/ovi8dh.png", "created_at": "", "completed_at": ""}, {"path": "/@Sakumaru_Create/works/1", "thumbnail_src": "https://si.imgix.net/60fafcb9/uploads/origins/6cc20acc-a623-4ccf-8291-f093b94e67c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e6ee44183d63e0f11be5d2b5348ed33", "thumbnail_srcset": "https://si.imgix.net/60fafcb9/uploads/origins/6cc20acc-a623-4ccf-8291-f093b94e67c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e6ee44183d63e0f11be5d2b5348ed33, https://si.imgix.net/60fafcb9/uploads/origins/6cc20acc-a623-4ccf-8291-f093b94e67c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30304673762491af9dfca05f7849b83e 2x, https://si.imgix.net/60fafcb9/uploads/origins/6cc20acc-a623-4ccf-8291-f093b94e67c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5859893960a7dc91d17d32df9f748f39 3x", "genre": "art", "nsfw": false, "body": "39丸。様\n\nはじめまして。\n私の創作キャラクターを描いて頂きたくリクエスト送信させて致しました。\n\n●資料\n・アイドルをしている高校生の2人組。\n・2人は親友でお互いに支え合っています。\n【いお】17歳/男/177cm/クール＆熱血感時に天然ボケ/担当カラー:黄色\n【てんき】17歳/男/180cm/愛が深いみんなのお兄さん/担当カラー:エメラルドグリーン\nhttps://drive.google.com/drive/folders/1-FtRO94Ls_14cUMA7VuluQ-IifyOq2X-?usp=sharing\n↑の資料の中から好きなキャラクターを描いていただけたらと思います！女装、女体化でもOKです！\n\n・服装、構図等の希望はありません、全てお任せします。\n・可能な範囲で好きなお洋服を着せていただけたら嬉しいです！\n・私の過去のリクエストイラストも参考にしていただいて構いません。\n・ぜひ、普段の貴方様の世界観でお願いします！\n\n●納品形式\n可能であれば、キャラのみの透過画像が欲しいです。\n\n●使用用途\nプライベート用グッズ制作\n個人鑑賞用\n\nもしご縁がございましたら、よろしくお願い致します。", "created_at": "", "completed_at": ""}]}