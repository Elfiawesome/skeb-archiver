ins/8d3d3c78-9d07-45ba-a8cc-8c9e6a78dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcbe99b8b8f78b5a37b2372fd74ce1d7 2x, https://si.imgix.net/4f994e8a/uploads/origins/8d3d3c78-9d07-45ba-a8cc-8c9e6a78dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd8c7101da983f39fc23125364e5dd47 3x", "genre": "art", "nsfw": false, "body": "私のVtuberのキャラクターを描いてほしいです。これは、私が持っている彼女のリファレンスといくつかの追加のアートピースです。\n\nhttps://imgur.com/a/2n5yzUv\n\nどんなポーズでも、どんな表情でも、あなたが一番楽しめるように描いてほしいです。ドヤ顔で自信満々、そしてセクシーなキャラクターです。背景を描くのであれば、背景ありバージョンと背景なしバージョンも欲しいです。本当にありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@malimo_mali/works/23", "thumbnail_src": "https://si.imgix.net/c80fcd3a/uploads/origins/39d0fb93-3346-4534-9551-925658f30733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b3c32ddd6866cffb9fe79a7e4609c64", "thumbnail_srcset": "https://si.imgix.net/c80fcd3a/uploads/origins/39d0fb93-3346-4534-9551-925658f30733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b3c32ddd6866cffb9fe79a7e4609c64, https://si.imgix.net/c80fcd3a/uploads/origins/39d0fb93-3346-4534-9551-925658f30733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bce69a394fb6814f6a0815c46f5841a 2x, https://si.imgix.net/c80fcd3a/uploads/origins/39d0fb93-3346-4534-9551-925658f30733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10affafc9316d8d103e888b8e7c91bc7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@malimo_mali/works/22", "thumbnail_src": "https://si.imgix.net/6dd1e387/uploads/origins/6dcfaebb-e8fc-401b-8d98-8824aaef783f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad554c41165b7444d0c88946217ad722", "thumbnail_srcset": "https://si.imgix.net/6dd1e387/uploads/origins/6dcfaebb-e8fc-401b-8d98-8824aaef783f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad554c41165b7444d0c88946217ad722, https://si.imgix.net/6dd1e387/uploads/origins/6dcfaebb-e8fc-401b-8d98-8824aaef783f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d9eac6b528dad7011e2ac36130df5fe 2x, https://si.imgix.net/6dd1e387/uploads/origins/6dcfaebb-e8fc-401b-8d98-8824aaef783f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b84fa8fc852c116b578c1059dc22956c 3x", "genre": "art", "nsfw": false, "body": "鞠藻_malimoさん、こんにちは!\n私はあなたのイラストがとても好きで、私のキャラクターであるベラの絵をぜひ描いてほしいです。\n\nベラが武器を持っているイラストを描いていただけると嬉しいです。武器は添付した資料の2種類のうち、どちらを選んでも構いません。ポーズや構図はお任せします。自由な発想で、好きなように描いてください。ベラは幸せで自信に満ち溢れ、エレガントな女性です。また、生意気な面も持っています。その他はお任せします。普段の姿の画像を添付しておきます。服装やディテールは自由に変更してください。\n\nご検討のほど、よろしくお願いいたします。\nどんな作品に仕上がるか楽しみです\nベラ 参考：https://imgur.com/a/lUkRMxY", "created_at": "", "completed_at": ""}, {"path": "/@malimo_mali/works/21", "thumbnail_src": "https://si.imgix.net/bbb597d5/uploads/origins/7189bcb0-17af-48bd-96fe-c6c24f7e0256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3962b06919d27977cd6dcaca9993e070", "thumbnail_srcset": "https://si.imgix.net/bbb597d5/uploads/origins/7189bcb0-17af-48bd-96fe-c6c24f7e0256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3962b06919d27977cd6dcaca9993e070, https://si.imgix.net/bbb597d5/uploads/origins/7189bcb0-17af-48bd-96fe-c6c24f7e0256?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=