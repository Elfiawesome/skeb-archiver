net/d8244e28/uploads/origins/6b1952fb-d242-4e1b-bcab-38818ed2634a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=707bfe0fd3fa120cd556cde0653f4a12 2x, https://si.imgix.net/d8244e28/uploads/origins/6b1952fb-d242-4e1b-bcab-38818ed2634a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc8ed3a4163fec66ee67fb63806902d3 3x", "genre": "art", "nsfw": true, "body": "橙ちゃんでこういうのをお願いします\n\nhttps://www.pixiv.net/artworks/65762094", "created_at": "", "completed_at": ""}, {"path": "/@ohitoriplayer/works/3", "thumbnail_src": "https://si.imgix.net/58644cba/uploads/origins/82fcad41-f535-4622-8ed6-5d4cfdfc4b79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd9870393091a0d316cd785d0f3db91b", "thumbnail_srcset": "https://si.imgix.net/58644cba/uploads/origins/82fcad41-f535-4622-8ed6-5d4cfdfc4b79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd9870393091a0d316cd785d0f3db91b, https://si.imgix.net/58644cba/uploads/origins/82fcad41-f535-4622-8ed6-5d4cfdfc4b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8b89fa9bf74241b97a538d070fda964 2x, https://si.imgix.net/58644cba/uploads/origins/82fcad41-f535-4622-8ed6-5d4cfdfc4b79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97911276a021388cabb6272f0867f42c 3x", "genre": "art", "nsfw": false, "body": "こんばんは、早速ですが絵の話をしようと思います\n\n東方智霊奇伝に出てくる幽谷響子(in宮出口瑞霊)を描いてほしいのです\n\nとりあえず全身が写っていればほかは特にありません、可能ならば端霊が憑依ってない通常の響子もほしいです\n\nよろしくお願いいたしますわ", "created_at": "", "completed_at": ""}, {"path": "/@ohitoriplayer/works/2", "thumbnail_src": "https://si.imgix.net/96993cfc/uploads/origins/83b028e6-7a21-4a38-8616-7ead472779b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eba17352b7b262db4fa6f166c10c7f7d", "thumbnail_srcset": "https://si.imgix.net/96993cfc/uploads/origins/83b028e6-7a21-4a38-8616-7ead472779b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eba17352b7b262db4fa6f166c10c7f7d, https://si.imgix.net/96993cfc/uploads/origins/83b028e6-7a21-4a38-8616-7ead472779b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f103e24591b53c1e91040fa58133e707 2x, https://si.imgix.net/96993cfc/uploads/origins/83b028e6-7a21-4a38-8616-7ead472779b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e716984d4650cad5616cbe0d47f49192 3x", "genre": "art", "nsfw": true, "body": "あけましておめでとうございます、早速ですが辰年にちなんだ依頼の話をしようと思います\n\n東方鬼形獣の吉弔八千慧のお腹に　辰年　と描かれた絵をお願いしたいです\n\n流れしては①新年の席でちょっと酔ってる八千慧が服の上下をガバっと手で開き(片腕でブラが見えるほど上着を、もう片方の腕で鼠径部が見えるほどスカートを)\n②お腹を見せて辰年とカワウソ霊に描かせる(ご満悦な八千慧)\n余裕があればおまけとして③徐々に酔いが覚めてきて何故か全裸にまでなってる八千慧\n\n新年いきなりの依頼となりますが…よろしくお願いいたしますわ", "created_at": "", "completed_at": ""}, {"path": "/@ohitoriplayer/works/1", "thumbnail_src": "https://si.imgix.net/0c14acb8/uploads/origins/179a7740-4086-4f1d-99e2-73ca85ff3727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=266d36336647e474f916f8d0a83b91cb", "thumbnail_srcset": "https://si.imgix.net/0c14acb8/uploads/origins/179a7740-4086-4f1d-99e2-73ca85ff3727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=266d36336647e474f916f8d0a83b91cb, https://si.imgix.net/0c14acb8/uploads/origins/179a7740-4086-4f1d-99e2-73ca85ff3727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c32fdac65478be1c116b3220766da225 2x, https://si.imgix.net/0c14acb8/uploads/origins/179a7740-4086-4f1d-99e2-73ca85ff3727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50562967ba4e02c5044c9ff81ab28029 3x", "genre": "art", "nsfw": true, "body": "初めまして、ヘッダーのぷにぷにしさに釣られて依頼したいと言う思いに至りました。早速ですが絵の依頼の話をさせていただきます\n\n東方Projectの因幡てゐと封獣ぬえが扇風機の前でたくし上げて涼んでる絵をお願いしたいです\n\n設定としては幻想郷で初めて扇風機を開発した人間の元に噂を聞きつけたてゐとぬえが服をたくし上げて涼みに来た暑い真夏といった感じで\n\nてゐはだらしない表情で涼み、ぬえは恥じらいはありつつも未知の物にワクワクしてる表情で\n可能ならば暑い設定なので穿いてない差分が欲しいです\n\nもう寒い時期ですが…ご検討宜しくお願い致しますわ", "created_at": "", "completed_at": ""}]}