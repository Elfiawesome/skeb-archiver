06-bd12-fbfe9b80b477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3cf8735ab46b8c469d10efa70bbb754 2x, https://si.imgix.net/3245b189/uploads/origins/b6514682-9d58-4906-bd12-fbfe9b80b477?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f464030a1a72eb129911af054c7bd94 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@una_giman/works/42", "thumbnail_src": "https://si.imgix.net/ee7b7841/uploads/origins/e7b567e6-7f45-4cf1-a426-e04c595d36aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=173615dbb1ef55adab37fc36c4786070", "thumbnail_srcset": "https://si.imgix.net/ee7b7841/uploads/origins/e7b567e6-7f45-4cf1-a426-e04c595d36aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=173615dbb1ef55adab37fc36c4786070, https://si.imgix.net/ee7b7841/uploads/origins/e7b567e6-7f45-4cf1-a426-e04c595d36aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b15c9bfaaed82af87e0d3b3e5be2ace 2x, https://si.imgix.net/ee7b7841/uploads/origins/e7b567e6-7f45-4cf1-a426-e04c595d36aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a819b955ed57983e231940330164665 3x", "genre": "art", "nsfw": true, "body": "しおウナ様\n\n初めまして。\nMSYと申します。\n\nTwitterでイラストを拝見して、素敵なイラストを描かれる方だなと思い、今回ご連絡させていただきました。\n最初に拝見したのは７月ごろに投稿されていたアルルのイラストで、少し大人しそうにも見える目が特に印象的でした。\nよく描かれている暁型の子たちのイラストもとても好きで、ジト目シチュが多いのも好きです。\n\n依頼させていただきたい内容といたしましては、「私がふとした時に空想する『理想の幼馴染』を描いていただきたい」ということになります。\n以下に描いていただきたいイメージを記載します（必ず全て表現してほしいということではありません）。\n・腋を見せつけるようなポーズ（強要されている）。\n・土下座状態で幼馴染を見上げているような構図（スカートの中身が見えていると尚良し）。\n・幼馴染はジト目で見下ろしている。\n・土下座状態の人は描写不要。\n\n作成していただいたイラストの用途としましては、スマホの壁紙に使用させていただければと思います。\n\n参考資料として、one driveにアップロードした画像のURLを記載させていただきます（アイコンの子と同一人物です）。\n\n参考資料は描いていただいたものですが、キャラクターはオリジナルです。\n提示させていただいた参考画像では制服を着ていますが、特にそこはこだわりありませんので、描きやすい服装などで問題ありません。\n\n以上の内容をもって依頼とさせていただきます。\nお時間のある際にご検討いただければ幸いです。\n\nhttps://1drv.ms/i/s!Aj5_ir54kL0w-hRAvuAFe1mDanzE?e=Tx4t1W", "created_at": "", "completed_at": ""}, {"path": "/@una_giman/works/41", "thumbnail_src": "https://si.imgix.net/5e924ba3/uploads/origins/6e06bc09-9a69-488f-8742-2abf839bb5d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51579efe2df27eaf8aea26e79f048189", "thumbnail_srcset": "https://si.imgix.net/5e924ba3/uploads/origins/6e06bc09-9a69-488f-8742-2abf839bb5d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51579efe2df27eaf8aea26e79f048189, https://si.imgix.net/5e924ba3/uploads/origins/6e06bc09-9a69-488f-8742-2abf839bb5d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47e0f9855bb5af88b365d0d1e78101dd 2x, https://si.imgix.net/5e924ba3/uploads/origins/6e06bc09-9a69-488f-8742-2abf839bb5d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d21eea63ebe5ed209a3e1a1b8dfb8f62 3x", "genre": "art", "nsfw": true, "body": "リクエストを送らせて頂きます\n\n艦これの大鳳改で\n塩野ウナ様が2025年4月16日午前2:12に投稿されていた\nマイクロビキニ、ニーソ、襟、スカーフをお願いします\n\n胸部装甲\n小さいけど確実に有る\n\nポーズ\nブラとパンツの紐に手を掛けて引っ張っている\n→結び目では無く、紐そのもの\nイメージ；https://union-creative.jp/goods/detail/?id=1274\n→水着は上記のマイクロビキニでお願いします\n\n表情\n照れているけど此方の反応を伺っている\n\nスタイル\n第六メンバーの様な体型では無く\n2024/12/24の結月ゆかり\n2015/12/9の葛城\nの様なスレンダー型\n\n可能であれば『ジト目』差分もお願いします\n\nご検討宜しくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@una_giman/works/40", "thumbnail_src": "https://si.imgix.net/db3bd1f4/uploads/origins/3a87a48e-18d7-4002-a1f1-718d1f21e99e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6645217dec9d00c20bd15b8b06383c3a", "thumbnail_srcset": "https://si.imgix.net/db3bd1f4/uploads/origins/3a87a48e-18d7-4002-a1f1-718d1f21e99e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6645217dec9d00c20bd15b8b06383c3a, https://si.imgix.net/db3bd1f4/uploads/origins/3a87a48e-18d7-4002-a1f1-718d1f21e99e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a72d4b571b859e1b87cab9305ffa419 2x, https://si.imgix.net/db3bd1f4/uploads/origins/3a87a48e-18d7-4002-a1f1-718d1f21e99e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ac8aad1f69761e359475985eb20cb69 3x", "genre": "art", "nsfw": false, "body": "はじめまして、しおウナ様のイラスト、どれも素晴らしいです！特に雷ちゃんのイラストが特に可愛くて好きです。\nしおウナさんの描く太もも、ニーハイ（サイハイ）は秀逸だと思います！\n\nこの度、ゲーム“リトルバスターズ”に出てくる能美クドリャフカを描いていただけないでしょうか。普段、クドは白ニーハイですが、あえて黒ニーハイ（サイハイ）で駆逐艦風に・・\nその他ポーズ、衣装などはお任せいたします。どうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@una_giman/works/39", "thumbnail_src": "https://si.imgix.net/530e5793/uploads/origins/222934c1-fb4f-4c48-a4ce-5001b7471575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4215d75042557f86ec5f3c59fdf04e46", "thumbnail_srcset": "https://si.imgix.net/530e5793/uploads/origins/222934c1-fb4f-4c48-a4ce-5001b7471575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4215d75042557f86ec5f3c59fdf04e46, https://si.imgix.net/530e5793/uploads/origins/222934c1-fb4f-4c48-a4ce-5001b7471575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd5ad1b4dc66271fb4094a252be9791c 2x, https://si.imgix.net/530e5793/uploads/origins/222934c1-fb4f-4c48-a4ce-5001b7471575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=620b68e0608c653d72131dc73a31862a 3x", "genre": "art", "nsfw": true, "body": "自分が好きなVRChat用3Dモデルの「スヴァルトリリヤ」をしおウナさんが描いたイラストで観たかったのでリクエストさせていただきました。\nイラストの内容は以下になります。\n\n[イラストの構図]\nURLのOneDriveフォルダにある3D人形のポーズをスヴァルトリリヤがとっているのを左右に並べる形（レイアウトとしては左に「正面少し右下からのアオリポーズ」、右に「左後方かがみながら振り返りポーズ」を並べた形ですが、左右を逆にした方がおさまりがいいと感じたら逆にしていただいて構いません）\n\n[キャラクター（スヴァルトリリヤ）の資料]\n同じOneDriveフォルダにスヴァルトリリヤの正面や後方、左右から見た画像や、服装や持ち物の画像資料をまとめています。参考にしていただければ幸いです。\n\n[イラスト中のキャラクターの視線について]\n・「正面少し右下からのアオリポーズ」での視線→こちら（イラストを観ている側）に向けている。\n・「左後方かがみながら振り返りポーズ」での視線→スヴァルトリリヤから見て左後方の人物へ視線を向けている。\n\n[イラストの背景について]\n不要ですので基本的には真っ白で構いません。お好みで簡単な背景色などを設定していただいても構いません。\n\n[その他]\n・キャラの頭身や体型は、しおウナさんが描きやすい頭身や体型に変更していただいて構いません。\n・3D人形のポーズをベースにして、ポーズの細部（手や脚の位置、持ち物の有無など）やパースはお好みで変更していただいて構いません。\n・どちらのポーズもタイツ上に性器のすじが薄く描写されていると嬉しいです。\n\n興味が湧きましたら描いていただけると幸いです。\n\nhttps://1drv.ms/f/s!Au6znWZjfIOKg_suargVYE0yvkdspg?e=XGwThs", "created_at": "", "completed_at": ""}, {"path": "/@una_giman/works/38", "thumbnail_src": "https://si.imgix.net/f57b8767/uploads/origins/97c7e916-bf9a-4dee-948c-b1c19b125486?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d8d50d9599266af508feb48f1ceaad", "thumbnail_srcset": "https://si.imgix.net/f57b8767/uploads/origins/97c7e916-bf9a-4dee-948c-b1c19b125486?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d8d50d9599266af508feb48f1ceaad, https://si.imgix.net/f57b8767/uploads/origins/97c7e916-bf9a-4dee-948c-b1c19b125486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2708d64f74eb20ef045a874b509e9abf 2x, https://si.imgix.net/f57b8767/uploads/origins/97c7e916-bf9a-4dee-948c-b1c19b125486?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=562cd6d2e5fe4efd9d7f0f3ebdaad293 3x", "genre": "art", "nsfw": false, "body": "まるぱのイラストをお願いします。\nまるぱとは艦これのパースが「ぱ」の文字を付けた白スク水を着たものです。\nポーズはおまかせします。\nよろしくお願いします。\nhttps://i.imgur.com/6PCDRPt.jpeg\n\nhttps://i.imgur.com/6PCDRPt.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@una_giman/works/37", "thumbnail_src": "https://si.imgix.net/a8bbcbce/uploads/origins/644151b2-c9e7-4275-8ad0-1c906711a44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dc697be95fb68b5fa6849bb46171639", "thumbnail_srcset": "https://si.imgix.net/a8bbcbce/uploads/origins/644151b2-c9e7-4275-8ad0-1c906711a44d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dc697be95fb68b5fa6849bb46171639, https://si.imgix.