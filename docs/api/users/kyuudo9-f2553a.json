://si.imgix.net/4f4c37e6/uploads/origins/8f3d34cc-1224-40d0-937b-a51810d44548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb26a2ce86926b5f9b94767a512a0504 2x, https://si.imgix.net/4f4c37e6/uploads/origins/8f3d34cc-1224-40d0-937b-a51810d44548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=957770518ebe36d6926e3a0089ff22cd 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kyuudo9/works/44", "thumbnail_src": "https://si.imgix.net/dcd28c5d/uploads/origins/ea0556ba-4352-45f4-820a-14fa18e92d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1511faff988c0a24d725851390fe3c19", "thumbnail_srcset": "https://si.imgix.net/dcd28c5d/uploads/origins/ea0556ba-4352-45f4-820a-14fa18e92d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1511faff988c0a24d725851390fe3c19, https://si.imgix.net/dcd28c5d/uploads/origins/ea0556ba-4352-45f4-820a-14fa18e92d37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7a739f666a936dab366ce3cbe9adb03 2x, https://si.imgix.net/dcd28c5d/uploads/origins/ea0556ba-4352-45f4-820a-14fa18e92d37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b68960d084a4bc08207e9cebe406d2d 3x", "genre": "art", "nsfw": false, "body": "再びzuuさんこんにちは。今回もOCの倉でお願いしたいことがあります。ジャケットのボタンをはずしたスーツを着てほしいです。ネオンをバックに照明も暗くしていただけると嬉しいです。ありがとうございました。\n\nポーズ参考：https://drive.google.com/file/d/1HjtkEWONxQkDQ_6HWGuD8zu61a-hqnkC/view?usp=sharing\n\nhttps://drive.google.com/drive/folders/19BtS9TzzL7pf42kLzhPgHlAwrTOZiUoh?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kyuudo9/works/43", "thumbnail_src": "https://si.imgix.net/e608564d/uploads/origins/8a9af876-9c7c-431a-b8da-7242b23