s": [{"label": "Twitter", "url": "https://x.com/downfallwinter", "name": "downfallwinter"}, {"label": "Misskey_io", "url": "https://misskey.io/@downfallwinter", "name": "downfallwinter"}, {"label": "Website", "url": "https://downfallofwinter.fanbox.cc", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/3132951", "name": "3132951"}, {"label": "Fantia", "url": "https://fantia.jp/fanclubs/478077", "name": "478077"}], "flags": {"from_archive": true}, "works": [{"path": "/@downfallwinter/works/90", "thumbnail_src": "https://si.imgix.net/411ec863/uploads/origins/64bb22d2-f833-4999-9602-1323ef508b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41e5cc817d440956175c74e94406cc85", "thumbnail_srcset": "https://si.imgix.net/411ec863/uploads/origins/64bb22d2-f833-4999-9602-1323ef508b29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41e5cc817d440956175c74e94406cc85, https://si.imgix.net/411ec863/uploads/origins/64bb22d2-f833-4999-9602-1323ef508b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=005f5b265b88be72e8a21b24cb5d3b55 2x, https://si.imgix.net/411ec863/uploads/origins/64bb22d2-f833-4999-9602-1323ef508b29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84409e48013340b550aae779fed31990 3x", "genre": "art", "nsfw": true, "body": "はじめまして！うぃんたぁさんの尻の描写に惹かれてリクエストを投げたいと思います！\nボイスロイドの琴葉茜ちゃんがお尻を指でほじられて粗相をしてしまうシチュエーションが見たいです。\n\n【シチュエーション】\n・椅子（土台なら何でも）の上に肛門を突き出すようなうんこ座りをしていて、マスターにアナルを指でほじほじされる（本人は不本意ながら付き合っている感じで、恥ずかしがっている）\n\n・オナラがメインで、小さな穴からガスが勢いよく「プシューー♡」と一直線に噴き出すようなオナラと、ある程度ほじられた後の開き気味の穴から「ポスッ♡ポスッ♡」とアナル周辺を充満させるようなオナラの最低２つの差分が見たいです。（他にもうんカスや汁など下品にアレンジして下されば嬉しい限りです）\n\n・おまけ程度にうんちが出る差分も見れたら嬉しいですが、お任せします。\n\n【その他希望】\nセリフも軽く入れていただければ嬉しいですが、台詞が浮かばなければ無くて大丈夫です！\n茜ちゃんのケツはデカくて下品なサイズ感が欲しい！\n表情の描写が構図的に難しければワイプでも構いません！", "created_at": "", "completed_at": ""}, {"path": "/@downfallwinter/works/89", "thumbnail_src": "https://si.imgix.net/a6ff30f7/uploads/origins/ceb11f85-75b7-43d9-a1d3-5ba691c8504e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4953414576f3ea5d1c17271afd90f15", "thumbnail_srcset": "https://si.imgix.net/a6ff30f7/uploads/origins/ceb11f85-75b7-43d9-a1d3-5ba691c8504e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4953414576f3ea5d1c17271afd90f15, https://si.imgix.net/a6ff30f7/uploads/origins/ceb11f85-75b7-43d9-a1d3-5ba691c8504e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cbd52515a961b80beebc1f4d0d63233 2x, https://si.imgix.net/a6ff30f7/uploads/origins/ceb11f85-75b7-43d9-a1d3-5ba691c8504e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdbf28c1ec84f7c65edfff54300ccbb9 3x", "genre": "comic", "nsfw": true, "body": "いつも素敵なイラストを描いていただきありがとうございます。今回もリクエストお願いします。\nキャラクターはデート・ア・ライブの村雨令音でお願いします。\nシチュエーションは彼女が和式トイレでおしっことうんちをしているところをカメラで盗撮されるイラストをお願いします。シチュエーションの細かい流れはおしっことうんちをしてそのあとパンツのおりものシートをはがしてサニタリーボックスに捨てる時に盗撮に気づいて、カメラに向かって自分はかまわないが他の子が嫌がるとしてカメラの電源を消す。以上です。服装は資料の服装で深夜の作業中にトイレに来た感じでノーブラで服から乳輪透けてる感じでお願いします。あと白衣のポケットに入ってるクマのぬいぐるみは彼女の大切な物なので描いて欲しいです。その他はお任せします。どうかよろしくお願いします。\n\nhttps://date-a-live-anime.com/character/character_reine.html", "created_at": "", "completed_at": ""}, {"path": "/@downfallwinter/works/88", "thumbnail_src": "https://si.imgix.net/649d6446/uploads/origins/91081b02-1fcc-44da-8404-5a19c70c5de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f407f3c8ce45ba58e2bf4e2f29e7dc", "thumbnail_srcset": "https://si.imgix.net/649d6446/uploads/origins/91081b02-1fcc-44da-8404-5a19c70c5de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f407f3c8ce45ba58e2bf4e2f29e7dc, https://si.imgix.net/649d6446/uploads/origins/91081b02-1fcc-44da-8404-5a19c70c5de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f6fcb00b86b98bcdb6f10a41f57678c 2x, https://si.imgix.net/649d6446/uploads/origins/91081b02-1fcc-44da-8404-5a19c70c5de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eaf7f85d04f0bf76c27cb5e7703ba75b 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nうぃんたぁさんの陰毛＆スカ絵をいつも楽しませてもらっています。\nskeb募集期間なのを見かけたためリクエストさせてもらいました。\n\n遊戯王の珠の御巫フゥリちゃんが和式で大小排泄しているところをお願いします。\nよくfantiaやskebに投稿されているトイレ盗撮モノの形式をイメージしていますが、着衣はありが希望です。\n具体的な構図や台詞の有無・内容などはお任せします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@downfallwinter/works/87", "thumbnail_src": "https://si.imgix.net/b66002fb/uploads/origins/28925c90-325b-4206-ae04-be84413cd045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6816aebf5d262b9aa64548c26e8018fb", "thumbnail_srcset": "https://si.imgix.net/b66002fb/uploads/origins/28925c90-325b-4206-ae04-be84413cd045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6816aebf5d262b9aa64548c26e8018fb, https://si.imgix.net/b66002fb/uploads/origins/28925c90-325b-4206-ae04-be84413cd045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30849817c0307b26109611a5f2caef61 2x, https://si.imgix.net/b66002fb/uploads/origins/28925c90-325b-4206-ae04-be84413cd045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81e0b3f46b4ab3887a14ef3c7b0aa7b4 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n以前より素敵なイラストを拝見させていただいており、今回リクエスト募集再開との事でリクエストさせて頂きます。\n\n描いて頂きたい子\nhttps://x.com/yuino_kitasiro/status/1832718319608270887\nhttps://x.com/yuino_kitasiro/status/1843505520050872691\nこちらの子です。\n\n構図\nエロ蹲踞で杭打ちディルドオナニーするゆいのちゃん\n両手は包茎ちんこを手コキでお願いします。\n徐々に気持ちよくなり興奮していき絶頂\nイク時は潮吹きでお願いします。\nまた絶頂時に手コキしているちんこも射精で全身にぶっかけでお願いします。\n可能であれば事後にお掃除フェラもお願いします。\n\n先生のおっぱいや陰毛の描き方がすごく好きですので、もし機会がありましたらご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@downfallwinter/works/86", "thumbnail_src": "https://si.imgix.net/63585ecd/uploads/origins/17a68eaf-c75a-48ba-9d49-d83d877eb44e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59999e07be4b226a4938306864b2