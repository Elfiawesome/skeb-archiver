%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2eb1659027a14e2b35dd89579bc97b46 2x, https://si.imgix.net/448513d7/uploads/origins/95bab1c6-4c62-4660-9101-617312524497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=616b8a5a4d2aab495d1574d0e6b6d027 3x", "genre": "art", "nsfw": false, "body": "西尾先生初めまして。\nskebにて先生の素敵なイラストをお見かけし、是非私のOCカップルをお願いしたくリクエストさせていただきました。\n\nhttps://drive.google.com/drive/folders/1KLW-7TRKz9_EJejD4jsi1xy9z_WUtEhq\n構図や衣装のアレンジなど、すべてお任せしますのでご自由に描いていただければと思います。\n\nご検討頂けますと幸いです、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@NISHIO_Q/works/124", "thumbnail_src": "https://si.imgix.net/4225cebb/uploads/origins/f08b5fbb-5dfc-4530-8dde-a01a69a6e28e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c10d8e53f657383cdcefe0a07f570a31", "thumbnail_srcset": "https://si.imgix.net/4225cebb/uploads/origins/f08b5fbb-5dfc-4530-8dde-a01a69a6e28e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c10d8e53f657383cdcefe0a07f570a31, https://si.imgix.net/4225cebb/uploads/origins/f08b5fbb-5dfc-4530-8dde-a01a69a6e28e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73365d408d70407608239b45c423bf8b 2x, https://si.imgix.net/4225cebb/uploads/origins/f08b5fbb-5dfc-4530-8dde-a01a69a6e28e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d1d9e1c01c85f934d678fd20bbe1ec5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NISHIO_Q/works/123", "thumbnail_src": "https://si.imgix.net/84434ad2/uploads/origins/27b29848-ed38-44b7-bb4c-976db0c96d77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703ae11b5008e11cc5556df734183f43", "thumbnail_srcset": "https://si.imgix.net/84434ad2/uploads/origins/27b29848-ed38-44b7-bb4c-976db0c96d77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703ae11b5008e11cc5556df734183f43, https://si.imgix.net/84434ad2/uploads/origins/27b29848-ed38-44b7-bb4c-976db0c96d77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa4d184cc8d5b76a011b9ee73315e35e 2x, https://si.imgix.net/84434ad2/uploads/origins/27b29848-ed38-44b7-bb4c-976db0c96d77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a3bdd8f0a0a79baa07481a3bafb64e6 3x", "genre": "art", "nsfw": false, "body": "西尾先生こんにちは！\nこの度は私と友人のOC（♀）のイラストを描いていただきたくリクエストをお送りしました！\n\n以下に簡単なOCの説明とテーマを記載します。\n\nOC1 - 左頬にあるほくろと赤色のスクエアメガネが特徴の女の子。ダークグレージュの髪（鎖骨〜胸上まで伸びたストレートヘアー）とみ空色の瞳（タレ目）をしている。あまのじゃくな性格で常に無表情。特定の友人以外にはあまり感情を表に出さない。\n\nOC2 - 前髪で隠れる片方の瞳と沢山のピアスが特徴の女の子。黒髪（腰まで伸びたストレートヘアー）にアメジストのような紫色の瞳（細いタレ目）をしている。臆病で卑屈、常に不安そうな表情を浮かべている。\n\nテーマ - jamcore\n名前の通り、ジャムにちなんだcore。自然の中でリラックスしながらランチバスケットに入れてきた手作りのサンドイッチ等を食べる様子やいちごを彷彿とさせる赤色のギンガムチェック柄がよく似合う。\n\nその他の詳しい情報と服装についてはURL先にて纏めておりますので、一度目を通していただければ幸いです！\n\n長文とはなりましたが、西尾先生が描きやすくて楽しい方でお描きください！\nなにか不手際や不足した面がありましたら再送申請やキャンセルをしてくださればと思います。\n\n何卒よろしくお願いいたします🙇‍♀️🧺\n\nhttps://photos.app.goo.gl/ReVyUVEzujUg51xC9", "created_at": "", "completed_at": ""}, {"path": "/@NISHIO_Q/works/122", "thumbnail_src": "https://si.imgix.net/85a70093/uploads/origins/0a7a5490-fb8e-4b8a-8f06-6532b9645cfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8955eb85d637a3c60bd6b65ad215a10f", "thumbnail_srcset": "https://si.imgix.net/85a70093/uploads/origins/0a7a5490-fb8e-4b8a-8f06-6532b9645cfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8955eb85d637a3c60bd6b65ad215a10f, https://si.imgix.net/85a70093/uploads/origins/0a7a5490-fb8e-4b8a-8f06-6532b9645cfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18346e38182e615186a912a266c5b544 2x, https://si.imgix.net/85a70093/uploads/origins/0a7a5490-fb8e-4b8a-8f06-6532b9645cfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd527ec5c5bba9c8751684e02489f0f9 3x", "genre": "art", "nsfw": false, "body": "西尾さんこんばんは！西尾さんの絵柄と塗りががとってもとっても好きです‎🤍\n\n可能でしたら、CoCシナリオ『四季送り』にて作成したオリジナルキャラクターとシナリオのNPCを描いて頂きたく、今回リクエストいたしました！(シナリオ作者様には許諾済みです)\n\n【資料URL】\nhttps://drive.google.com/drive/folders/1jHft6Vk-AYS_I7Up7Yz2eWzDtXJpARhf\n\n■詳細\n2人は10年近く同居している仕事仲間です(男性は情報屋、女性は殺し屋)。恋愛関係ではありません。女性の方は口調は大人らしいですが、中身は子供っぽく、怪しいお兄さんとデカいロリみたいな関係です。\n\n■用途\nいただいたイラストは個人での鑑賞のほか、趣味の範囲でSNSのヘッダーやアイコンに使用する等させていただければと思います。\n\n服装は資料に添付されている立ち絵のものでお願いします……！構図やシチュエーションはお好きなように描いてくださると幸いです☺️♡\n\nよければご検討ください🙇‍♀️よろしくお願いします……！", "created_at": "", "completed_at": ""}, {"path": "/@NISHIO_Q/works/121", "thumbnail_src": "https://si.imgix.net/110824d9/uploads/origins/44d26b15-705a-4ac6-8659-948448e1e500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42a6e259fbcf06bd75a338f114498372", "thumbnail_srcset": "https://si.imgix.net/110824d9/uploads/origins/44d26b15-705a-4ac6-8659-948448e1e500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42a6e259fbcf06bd75a338f114498372, https://si.imgix.net/110824d9/uploads/origins/44d26b15-705a-4ac6-8659-948448e1e500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a1aab48b3c833205066bbe85f863ce0 2x, https://si.imgix.net/110824d9/uploads/origins/44d26b15-705a-4ac6-8659-948448e1e500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad