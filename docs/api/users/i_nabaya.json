c8b-4d90-a93b-70972f4f313d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc00cbcf890a16f11232376dbaba692f, https://si.imgix.net/e248d9f8/uploads/origins/0514ef9c-4c8b-4d90-a93b-70972f4f313d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3bc4094a3b6c53960df6f348e5adeb7 2x, https://si.imgix.net/e248d9f8/uploads/origins/0514ef9c-4c8b-4d90-a93b-70972f4f313d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=122a060476f34eb2cab925d01dbf4eb5 3x", "genre": "art", "nsfw": false, "body": "こんばんは、 ヨシヤ🐁さん 初めまして。\nツイッターでヨシヤ🐁さんの絵を見てからぜひリクエストしたいと思て来ました。　\nテーマとか内容はすべておまかせでお願いしたいです。\nよろしくお願いします。\n\n\n\n指は4本、足の指は3本でお願いします。\nうちの子かかけている手錠とか首輪は描かなくてもいいです。\n(状況によって自由に描いてください。構図やスタイルによっては翼を簡単に描いても大丈夫です。)\n\nhttps://drive.google.com/drive/folders/143cDiocWfSb0dbFLZjLVluX1rKrOOMqi?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@i_nabaya/works/62", "thumbnail_src": "https://si.imgix.net/af987a7a/uploads/origins/35efa5a5-3d09-4212-a3a8-732ebcc41b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6077fcf1212dd12d931cef33ece2a34", "thumbnail_srcset": "https://si.imgix.net/af987a7a/uploads/origins/35efa5a5-3d09-4212-a3a8-732ebcc41b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6077fcf1212dd12d931cef33ece2a34, https://si.imgix.net/af987a7a/uploads/origins/35efa5a5-3d09-4212-a3a8-732ebcc41b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9db6012f5c1bc2c36567020cc84b7be9 2x, https://si.imgix.net/af987a7a/uploads/origins/35efa5a5-3d09-4212-a3a8-732ebcc41b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf0f3c7f933bf6890402982e0011a132 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n依頼されたテーマの内容についてはあなたに任せて勝手に発揮したいと思います。\nこれが我が子の設定です。 お疲れ様でした。\n\nhttps://drive.google.com/file/d/10IqcxeuIeI84oEwjOp8NA7A3HX8HkB3J/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@i_nabaya/works/61", "thumbnail_src": "https://si.imgix.net/364f0046/uploads/origins/adc46feb-3eea-4bbb-b131-d2d3be6c1fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c73b9c7265d577a66421c29592dec4", "thumbnail_srcset": "https://si.imgix.net/364f0046/uploads/origins/adc46feb-3eea-4bbb-b131-d2d3be6c1fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c73b9c7265d577a66421c29592dec4, https://si.imgix.net/364f0046/uploads/origins/adc46feb-3eea-4bbb-b131-d2d3be6c1fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e4ddd93c0c7bba9e1c887d409317efe 2x, https://si.imgix.net/364f0046/uploads/origins/adc46feb-3eea-4bbb-b131-d2d3be6c1fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f34e61712b9f3174c57e2dddea1116f6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの画風が大好きで、私の設定にイラストを依頼したいと思っています！\n嵐魂は精霊に包まれた白狐。炎魔法と時間魔法が得意で、司書でもあります。\n絵柄は自由で、可愛く描いていただけると嬉しいです！リクエストを受け入れていただけると本当に嬉しいです(ÒωÓ)\n\n嵐魂の設定画です、参考になれば幸いです！\nhttps://photos.app.goo.gl/CxSLvNS71nCa6Y2m8", "created_at": "", "completed_at": ""}, {"path": "/@i_nabaya/works/60", "thumbnail_src": "https://si.imgix.net/10133a9f/uploads/origins/0767b597-7c34-48fa-8d63-1f906384f52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72b0e5110213fcce9b00fff3dbf03451", "thumbnail_srcset": "https://si.imgix.net/10133a9f/uploads/origins/0767b597-7c34-48fa-8d63-1f906384f52f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72b0e5110213fcce9b00fff3dbf03451, https://si.imgix.net/10133a9f/uploads/origins/0767b597-7c34-48fa-8d63-1f906384f52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96d2c09822c0eb8905327b0b643ac7a9 2x, https://si.imgix.net/10133a9f/uploads/origins/0767b597-7c34-48fa-8d63-1f906384f52f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6f1ebe60543f0ca326c3bdd14f77086 3x", "genre": "art", "nsfw": false, "body": "こんにちは！　よろしければうちの仔たちを描いていただけないでしょうか？\n虎ショタ「秋穂」と竜ショタ「アルバ」がどこかを探検しているような感じを考えていますが、構図や背景等細かい点はおまかせできればと思います。\n\n【キャラクター資料】\n秋穂:\nhttps://drive.google.com/drive/folders/10OLIvjI4LadiJaszi5xGegKeNYZYxPCR?usp=drive_link\nアルバ:\nhttps://drive.google.com/drive/folders/1s1WFV3ekAy5QMDQ-XnTeRsiEuPaN237O?usp=drive_link\n\nご検討いただければ幸いです！！", "created_at": "", "completed_at": ""}, {"path": "/@i_nabaya/works/59", "thumbnail_src": "https://si.imgix.net/43fb6108/uploads/origins/a8ae4153-7f66-4ba7-838b-c7506bc51bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fd01710509061d0c446d08500eccf40", "thumbnail_srcset": "https://si.imgix.net/43fb6108/uploads/origins/a8ae4153-7f66-4ba7-838b-c7506bc51bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fd01710509061d0c446d08500eccf40, https://si.imgix.net/43fb6108/uploads/origins/a8ae4153-7f66-4ba7-838b-c7506bc51bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a9d08ae5617958b735e5ee6bb9dcf1a 2x, https://si.imgix.net/43fb6108/uploads/origins/a8ae4153-7f66-4ba7-838b-c7506bc51bcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f13d6ef09b1c0dfd4ccc8dbdad10c1cd 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ずっと前から尊敬しています！あなたのイラストにはいつも刺激をもらっています。特に印象的な背景と構図に惹かれます＾＾。\n\nこのキャラクター(https://imgur.com/a/2B3XfJh)を日本の神社・鳥居の設定でお願いしたいです!月明かりのある夜空がぴったりだと思います。https://imgur.com/a/zkpvYC7（ただし、デザインを少し調整する前のものなので、前のリンクにある現在のものを参考にしてください）。\n\n注意事項\n\n 額の三日月は髪に透けて（ぼんやりと）光るので、少し透明になっています。\n羽の裏側は青色\n 瞳孔は白、アイラインは赤。\n 尾は4本ある。\nアホ毛\n\nこの度はありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@i_nabaya/works/58", "thumbnail_src": "https://si.imgix.net/b36558da/uploads/origins/9a6ec305-6303-4f89-bbf4-912024e6faf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8acfb0e01b7c97d291243bad1a7f70a7", "thu