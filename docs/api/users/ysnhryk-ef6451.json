程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-4cXdm_E3s-tJucxNlTGUVxdXnenVLf-", "created_at": "", "completed_at": ""}, {"path": "/@ysnhryk/works/8", "thumbnail_src": "https://si.imgix.net/dbfe66a9/uploads/origins/938e6485-9331-4272-bcbc-8900b48e5d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e21d1fb086687c91aca9cdb828577689", "thumbnail_srcset": "https://si.imgix.net/dbfe66a9/uploads/origins/938e6485-9331-4272-bcbc-8900b48e5d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e21d1fb086687c91aca9cdb828577689, https://si.imgix.net/dbfe66a9/uploads/origins/938e6485-9331-4272-bcbc-8900b48e5d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc68ea61647ff9199f661d7e4a3ed1b5 2x, https://si.imgix.net/dbfe66a9/uploads/origins/938e6485-9331-4272-bcbc-8900b48e5d9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a8f708098304f4150f2ce7a21bac331 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ysnhryk/works/7", "thumbnail_src": "https://si.imgix.net/ba48830f/uploads/origins/1e1f43a9-b7c8-45d5-9ab7-d83d02002173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863f63088d3891d3fff72bf5aee26f8c", "thumbnail_srcset": "https://si.imgix.net/ba48830f/uploads/origins/1e1f43a9-b7c8-45d5-9ab7-d83d02002173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=863f63088d3891d3fff72bf5aee26f8c, https://si.imgix.net/ba48830f/uploads/origins/1e1f43a9-b7c8-45d5-9ab7-d83d02002173?bg=%23fff&auto=format%2Ccompress