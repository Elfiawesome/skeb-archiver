3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=284daeef99051009830df70f65612196", "thumbnail_srcset": "https://si.imgix.net/451f7ca9/uploads/origins/25d4077f-33ef-4ea9-861b-814a265afe1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=284daeef99051009830df70f65612196, https://si.imgix.net/451f7ca9/uploads/origins/25d4077f-33ef-4ea9-861b-814a265afe1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=279a1a8e7c4fe7a9bb32703287cc7bd8 2x, https://si.imgix.net/451f7ca9/uploads/origins/25d4077f-33ef-4ea9-861b-814a265afe1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=493a2c62e060e64820739966ac7a474d 3x", "genre": "art", "nsfw": true, "body": "こんにちは、ヒロスケさん。\nキャラはベルちゃんで、影絵ニプルファックをお願いします。\n障子やスクリーンのようなものの奥で行為に及んでいるシルエットを描いてください。\n真横からのアングルで表情などは分からず、爆乳に巨根が挿入されている様子や擬音だけがわかる形でお願いします。\n\nベルちゃん：かなり激しく乱れ、女の子座り(ペタン座り)で後ろに手を突き胸を突きだす姿勢。仰け反り舌を突き出し嬌声をあげる。\n\n相手：下半身のみの描写。手は乳を持つようにしているのが離騒ですが、影絵の都合上分かりづらくなりそうでしたら手の描写も不要です。\n\nまた、今回料金内で可能でしたら、簡易的な差分をお願いしたいです。\n絵そのものに大きな変更は不要ですので、射精前→射精後でそれに合わせた擬音とセリフをつけてください。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Hirosuke/works/6", "thumbnail_src": "https://si.imgix.net/9089f864/uploads/origins/1076b762-780e-42cf-9bf3-e8b687a54f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63276cd69c5e489fc8a73195104da97e", "thumbnail_srcset": "https://si.imgix.net/9089f864/uploads/origins/1076b762-780e-42cf-9bf3-e8b687a54f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63276cd69c5e489fc8a73195104da97e, https://si.imgix.net/9089f864/uploads/origins/1076b762-780e-42cf-9bf3-e8b687a54f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fccfb29bc628bc841ff1bf3b83747722 2x, https://si.imgix.net/9089f864/uploads/origins/1076b762-780e-42cf-9bf3-e8b687a54f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1483dc3d3a4f3e774bd23