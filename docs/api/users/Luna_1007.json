bc1-74f06d22b14d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed61f2d0b20d7e49a231533217975e7f", "thumbnail_srcset": "https://si.imgix.net/da812b65/uploads/origins/d90e2dd0-15ca-4b2d-abc1-74f06d22b14d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed61f2d0b20d7e49a231533217975e7f, https://si.imgix.net/da812b65/uploads/origins/d90e2dd0-15ca-4b2d-abc1-74f06d22b14d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b3127fdc51ed58cfc3a23ae6d2ea184 2x, https://si.imgix.net/da812b65/uploads/origins/d90e2dd0-15ca-4b2d-abc1-74f06d22b14d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f72218d9ecaee96b1ac00d5812b71112 3x", "genre": "art", "nsfw": false, "body": "こんにちは！リクエストさせていただきます。魔性のVtuber兼声優のレノア嬢です。\n\nあなたの絵が大好きです！\n特に完成したこの作品：https://skeb.jp/@Luna_1007/works/40\nそしてこの作品: https://skeb.jp/@Luna_1007/works/28\n\n私のデザインは、セクシー、ミステリアス、母性的、軽薄、魅力的といったテーマが好きです。\n解像度：1920 x 1080以上\n背景とキャラクターを分離したアートピースの透過バージョンもお願いします。\n\nTwitch、Youtube、ソーシャルメディアに使用したいです。\n\nキャラクターにはミストレス・レノアのリファレンスを使用してください。雰囲気作りのためにポーズのリファレンスのアイデアもお願いしますが、ポーズの解釈は大歓迎です！\n\nhttps://drive.google.com/drive/folders/1TUSJ6qfGalBWneNV0b2c_al7LSn-OP7r?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/72", "thumbnail_src": "https://si.imgix.net/072b7eaf/uploads/origins/99ea4c94-dc55-4b8e-9610-72a6bec928e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec0d19b11dfe5ba13ebc514502605566", "thumbnail_srcset": "https://si.imgix.net/072b7eaf/uploads/origins/99ea4c94-dc55-4b8e-9610-72a6bec928e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec0d19b11dfe5ba13ebc514502605566, https://si.imgix.net/072b7eaf/uploads/origins/99ea4c94-dc55-4b8e-9610-72a6bec928e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a2542968043b24ed5c09112de1930ed 2x, https://si.imgix.net/072b7eaf/uploads/origins/99ea4c94-dc55-4b8e-9610-72a6bec928e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc0d3a3faae1feddfe329a36fa835b7f 3x", "genre": "art", "nsfw": false, "body": "もちもちのケアルギョ様\n\nはじめまして！skebの新着でイラストを拝見し、もちもちのケアルギョ様の描かれる綺麗なお顔と色使い、光と影の表現の美しさに見惚れてしまいました。\nよろしければぜひ私のキャラクターもお願いしたく思い、リクエストを送らせていただきます。\n\n\n◆キャラクター雰囲気参考資料\nhttps://drive.google.com/drive/folders/1lmX-j8PewWmzPDEahMNJW-LvbW2JCYxi?usp=sharing\n\n・鎖骨の下にハートの模様があります\n\n\n\n【リクエスト内容】\n・構図やポーズ、表情、衣装などおまかせいたします。\n・色々なお洋服を着せてみたいので、もちもちのケアルギョ様にデザインをお願いできると嬉しいです。\n　(コスプレ、ケモ耳なども大歓迎です。資料にあります衣装でも大丈夫です)\n・髪型は雰囲気に合うようにアレンジしていただけると嬉しいです。\n\n\n配信画面やサムネイル画像に使用したいので、頭や髪、上半身が見切れないように描いていただけますと助かります。\n\n\n【使用用途】\n・配信画面やアーカイブ\n・SNS(アイコンやポスト、スマホ壁紙配布等)\n・ネットプリント\n\n\n可能でしたら、人物のみの透過データもいただけますと幸いです。\n\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/71", "thumbnail_src": "https://si.imgix.net/e76dd487/uploads/origins/f326b62a-103e-4c6f-ad32-c20a5be0fafd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7afe6ac7d2267d4e2255ace574d13073", "thumbnail_srcset": "https://si.imgix.net/e76dd487/uploads/origins/f326b62a-103e-4c6f-ad32-c20a5be0fafd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7afe6ac7d2267d4e2255ace574d13073, https://si.imgix.net/e76dd487/uploads/origins/f326b62a-103e-4c6f-ad32-c20a5be0fafd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8c0282fa1e5b388947e1703d056f59f 2x, https://si.imgix.net/e76dd487/uploads/origins/f326b62a-103e-4c6f-ad32-c20a5be0fafd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2def474ace0a44cdbb066c98946071eb 3x", "genre": "art", "nsfw": false, "body": "アカチャンかわいいbot様\n初めまして、Vtuberのアーテルと申します。 とても素敵なイラストを拝見しまして、是非ご依頼させて頂きたくご連絡をいたしました。  \n\nイラスト内容 \n\nアーテルのイラストを描いて頂きたいです。 \n衣装はパジャマでASMR配信用のサムネや配信画面に合うイラストをお願い致します。\n\n無性別の猫なので胸は描かないで頂けると幸いです。\n\n\n希望納品形式 \n\nレイヤー分けされているpsdかpngでのデータで頂戴出来ますと嬉しいです。  \n\n\n用途 \n\nYouTubeのサムネ、配信画面、Twitterなどで使わせて頂きたいと思っております。\n\n 構図や要望など \n\nASMR要素を入れたいので耳かきを持っているか顔に片手を当てて囁いているような構図でのお願いは可能でしょうか…？\n（ASMRぽさがあればアカチャンかわいいbotさ様の考える構図でも大丈夫です！）\n頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。\n\nhttps://x.com/___ater___/status/1796549304695521426?s=46&t=HfZx1huXADY5htn4epy15A", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/70", "thumbnail_src": "https://si.imgix.net/5c232a4a/uploads/origins/6e8f4ed1-dbe2-4dfb-9ee7-f588df876f4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83dea2c443a3494f0bdd90420e9d9e7b", "thumbnail_srcset": "https://si.imgix.net/5c232a4a/uploads/origins/6e8f4ed1-dbe2-4dfb-9ee7-f588df876f4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83dea2c443a3494f0bdd90420e9d9e7b, https://si.imgix.net/5c232a4a/uploads/origins/6e8f4ed1-dbe2-4dfb-9ee7-f588df876f4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75026982905d2adabb0e861c0ac7a2ed 2x, https://si.imgix.net/5c232a4a/uploads/origins/6e8f4ed1-dbe2-4dfb-9ee7-f588df876f4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b6fabe505afe6f11581b63af56a75e3 3x", "genre": "art", "nsfw": false, "body": "オリジナルキャラクターを描いていただきたいです。\n参考画像は https://x.com/yamaiyurika/highlightsのまとめにあります。\n\nキャラクターの基本的な特徴は以下の通りです：\n\n髪：銀色\n\n瞳：青と紫の中間くらいの色合い\n\n耳：エルフ耳のように少し尖っている\n\n種族：吸血鬼の女の子\n\n服装や髪型は自由にアレンジしていただいて構いません。もし迷った場合は参考画像をベースにしていただければ幸いです。\nポーズや構図、背景の有無もお任せします。SDイラストでも大歓迎です。\n人物と背景を分けてPSD納品していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://x.com/yamaiyurika/highlights", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/69", "thumbnail_src": "https://si.imgix.net/9a55d0aa/uploads/origins/0c82d612-d36f-44e5-9c87-6d76c20dac24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7488387414d50e10418a5f18339ef1de", "thumbnail_srcset": "https://si.imgix.net/9a55d0aa/uploads/origins/0c82d612-d36f-44e5-9c87-6d76c20dac24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7488387414d50e10418a5f18339ef1de, https://si.imgix.net/9a55d0aa/uploads/origins/0c82d612-d36f-44e5-9c87-6d76c20dac24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e37d6105a87012a4045cb70575b72fb 2x, https://si.imgix.net/9a55d0aa/uploads/origins/0c82d612-d36f-44e5-9c87-6d76c20dac24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80b89e8c80fa93a0c9916dcbb21b6d1d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お久しぶりです。\n個人でVtuber活動をしております眠杜(みんと)と申します。\nskebを受け付けているとお聞きしたため、2度目の依頼をさせて頂きたいと思います！\n\n【依頼内容】\n私服な私を描いて頂きたいです！\n私服のデザイン・構図など完全おまかせでお願いいたします。\n私服はもちもちのケアルギョ様の描くタイミングでの季節感で問題ありません。\n\n【キャラクターについて】\n種族:ハーフエルフ\n外見年齢:20代後半\n身長:164cm\n太めタレ眉、タレ目寄り\n片目隠れ、髪の隙間から泣きぼくろが見えます\n(髪から見えていてもいなくても問題ありませんが見えていた方が嬉しいです)\n\n※詳細は資料URLからご確認頂けますと幸いです。\n\n【使用用途】\nSNSでのプロモーションやYoutubeのサムネイルなどに使用します。\n\n【その他】\n背景透過した人物のイラストを別途頂きたいです。\n\nよろしくお願いいたします！\n\nhttps://lit.link/NEMUruMORI", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/68", "thumbnail_src": "https://si.imgix.net/440900e3/uploads/origins/cbfd9367-ca8f-47bc-9ec0-f1822c5bf325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66d8859a21ceb69007d155c912ed1f6b", "thumbnail_srcset": "https://si.imgix.net/440900e3/uploads/origins/cbfd9367-ca8f-47bc-9ec0-f1822c5bf325?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66d8859a21ceb69007d155c912ed1f6b, https://si.imgix.net/440900e3/uploads/origins/cbfd9367-ca8f-47bc-9ec0-f1822c5bf325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75aede6eaa3d070ebc522d677b8d5de8 2x, https://si.imgix.net/440900e3/uploads/origins/cbfd9367-ca8f-47bc-9ec0-f1822c5bf325?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae4ff2a7019b6b20b126dd89a51750d9 3x", "genre": "art", "nsfw": false, "body": "もちもちのケアルギョ様はじめまして！ Vtuber・Vliverとして活動している怪盗アンサーと申します。 もちもちのケアルギョ様の絵柄がとても素敵で、ぜひ私のキャラクターを描いていただきたくリクエストを送らせていただきました。 \n資料はURLをご確認ください。  \n\n表情や細かい構図などおまかせいたしますので、自由に描いてください。 \n元気でかわいい雰囲気だと嬉しいです。  \n配信画面などに使いたいので、髪や手などが見切れてないと嬉しいです。 \nまた、キャラクターのみの透過差分(もしくはPSD)をいただきたいです。\n\n使用する可能性のある用途は下記になります↓ YouTube・17Live・ツイキャス等の配信・動画サムネイル、Twitter等のSNSでの利用、アイコン、ヘッダー、壁紙、返礼グッズ等  \n\n内容が合わなければキャンセルしていただいて大丈夫です。 お忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。  \n\nhttps://drive.google.com/drive/folders/17rhPFvvvYMUJv5GxobDACfc15ubU8Jof", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/67", "thumbnail_src": "https://si.imgix.net/024e492d/uploads/origins/afa202f9-64ef-4262-a0ca-0623e2bb7cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcafdb80a98f29007a987466e2eccb04", "thumbnail_srcset": "https://si.imgix.net/024e492d/uploads/origins/afa202f9-64ef-4262-a0ca-0623e2bb7cff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcafdb80a98f29007a987466e2eccb04, https://si.imgix.net/024e492d/uploads/origins/afa202f9-64ef-4262-a0ca-0623e2bb7cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=111200a28a13c371a29b377370243e2b 2x, https://si.imgix.net/024e492d/uploads/origins/afa202f9-64ef-4262-a0ca-0623e2bb7cff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a01e0be477a0a082588c4869716ab9b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/66", "thumbnail_src": "https://si.imgix.net/9cb9fc32/uploads/origins/364e3cff-0df2-4bbb-93bb-a10ebb19524d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be0a7ed0c6ef18bf832f40b75837cdd8", "thumbnail_srcset": "https://si.imgix