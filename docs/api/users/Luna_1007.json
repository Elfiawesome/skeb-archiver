由に変更してください。背景がある場合は、イラストとは別のレイヤーにしてください。SNSに投稿します。\n\nhttps://drive.google.com/file/d/1kRWT9nE1MqEu4zEW0tclQc9sTx1e2g6f/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/77", "thumbnail_src": "https://si.imgix.net/32792a21/uploads/origins/d2ebc126-0b31-48df-887e-7d5912c24cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aa5b2459ae0b6baccc293e52116b9e4", "thumbnail_srcset": "https://si.imgix.net/32792a21/uploads/origins/d2ebc126-0b31-48df-887e-7d5912c24cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6aa5b2459ae0b6baccc293e52116b9e4, https://si.imgix.net/32792a21/uploads/origins/d2ebc126-0b31-48df-887e-7d5912c24cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b865b881acc8075ec518f43d9637086 2x, https://si.imgix.net/32792a21/uploads/origins/d2ebc126-0b31-48df-887e-7d5912c24cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efd511a0fe5a954129a5beffe1d0dabe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Luna_1007/works/76", "thumbnail_src": "https://si.imgix.net/da6c3abe/uploads/origins/eb3c935e-ce97-4119-b0ab-8a6c0c701aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82361d2e34a5a5b570c1d67dcdfbc50", "thumbnail_srcset": "https://si.imgix.net/da6c3abe/uploads/origins/eb3c935e-ce97-4119-b0ab-8a6c0c701aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82361d2e34a5a5b570c1d67dcdfbc50, https://si.imgix.net/da6c3abe/uploads/origins/eb3c935e-ce97-