ads/origins/3c82f8d5-5a4a-430f-b4e1-b6f2471231b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08a8f93a5db8c6f7b9f4df5a7cb23a98", "thumbnail_srcset": "https://si.imgix.net/2b5264b9/uploads/origins/3c82f8d5-5a4a-430f-b4e1-b6f2471231b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08a8f93a5db8c6f7b9f4df5a7cb23a98, https://si.imgix.net/2b5264b9/uploads/origins/3c82f8d5-5a4a-430f-b4e1-b6f2471231b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a023fe2c4a921e7f73968343e7ad435 2x, https://si.imgix.net/2b5264b9/uploads/origins/3c82f8d5-5a4a-430f-b4e1-b6f2471231b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2f4e2f96834ef8d2c8747c360b436fd 3x", "genre": "art", "nsfw": true, "body": "来月のために、ブレンダン（ポケモン）とセックスしているメイ（ポケモン）の後背位かフルネルソンをしてもらえますか？どちらのポーズも参考にしたいので、前回のリクエストのようにイクバージョンもお願いできますか？\n\nあ、メイのヘアデザインはアニメバージョンで、ブレンダンのチンコはpixivでやってるアッシュのチンコのように大きいか、それ以上にしてください（altのザーメンバージョンだとメイがものすごく孕んでしまうので、ブレンダンのチンコをくわえたときの膨らみを作ってください笑）。\n\nhttps://drive.google.com/drive/folders/14OlvJxf1QEHDhnIR_rYZIVSIYo0xPpiP?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kosei_ryuda/works/159", "thumbnail_src": "https://si.imgix.net/d0096941/uploads/origins/362ca9fd-9e7c-402d-901b-0b0d5903cd44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d7275ef0b009c0cc014b5ef0840fdb3", "thumbnail_srcset": "https://si.imgix.net/d0096941/uploads/origins/362ca9fd-9e7c-402d-901b-0b0d5903cd44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d7275ef0b009c0cc014b5ef0840fdb3, https://si.imgix.net/d0096941/uploads/origins/362ca9fd-9e7c-402d-901b-0b0d5903cd44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c70a5d6387fe4bd33791c536d118c449 2x, https://si.imgix.net/d0096941/uploads/origins/362ca9fd-9e7c-402d-901b-0b0d5903cd44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b86e572c8de1d1fdbfb1587f55f61fe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kosei_ryuda/works/158", "thumbnail_src": "https://si.imgix.net/cf492d77/uploads/origins/81fcafe4-794c-4e1e-9459-71576f006c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c7b8e6c467bfc5b6e098ac575bc6ec0", "thumbnail_srcset": "https://si.imgix.net/cf492d77/uploads/origins/81fcafe4-794c-4e1e-9459-71576f006c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c7b8e6c467bfc5b6e098ac575bc6ec0, https://si.imgix.net/cf492d77/uploads/origins/81fcafe4-794c-4e1e-9459-71576f006c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53946fdafaf1410cac3870c7f1186544 2x, https://si.imgix.net/cf492d77/uploads/origins/81fcafe4-794c-4e1e-9459-71576f006c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abee4903469c0379088429265e74aaa2 3x", "genre": "art", "nsfw": true, "body": "こんばんは。『時々ボソッとロシア語でデレる隣のアーリャさん』のマリヤ・ミハイロヴナ・九条と\nアリサ・ミハイロヴナ・九条が極太の双頭ディルドをマリヤがアナルにアリサがマンコに奥まで挿入した状態で、両手をディルドから完全に放しているところのシーンだけをお願いします。\n前回（https://skeb.jp/@kosei_ryuda/works/153）同様、お互いの視線で、2人とも正面を向いているような感じ（1コマ目と同じ）にしてほしいです。\n既に顔も含め全身を金粉で塗った状態で、双頭ディルドも金粉が塗られています。\n前回（同URL）の2コマ目（右下）で二穴に挿入していましたが、そうではなく片方の穴に挿入した状態でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kosei_ryuda/works/157", "thumbnail_src": "https://si.imgix.net/4bcfb95e/uploads/origins/4d88fb02-acc3-48ad-ba4a-46b515fc8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b173854aaefa3d6a58ffbdb9b62f6e2f", "thumbnail_srcset": "https://si.imgix.net/4bcfb95e/uploads/origins/4d88fb02-acc3-48ad-ba4a-46b515fc8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b173854aaefa3d6a58ffbdb9b62f6e2f, https://si.imgix.net/4bcfb95e/uploads/origins/4d88fb02-acc3-48ad-ba4a-46b515fc8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c714da1f244be62028a2248ad3419b1 2x, https://si.imgix.net/4bcfb95e/uploads/origins/4d88fb02-acc3-48ad-ba4a-46b515fc8b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7124dbea6ccc045e34de35f8ca01ec15 3x", "genre": "art", "nsfw": true, "body": "やあ！君が忙しくてコミックを作れないのは知ってるよ。しかし、私はPOV宣教師ポーズでアダムに犯されるサムス・アランのバリアント/アルトセットの絵のリクエストがあります。URLには参考資料の詳細を残しておきます。\n\n基本的には二人のハネムーンで、サムスがメトロイドのDNAにより発情期に入っているため、アダムがサムスの中でファックして精液を出し、妊娠させるというものだ。この絵は、サムスが舌を出したままアヘガオ（頭を持ち上げ、目を丸くしたり、ハート型にしたりすること）になり、卵巣が精子細胞でいっぱいになり、複数の卵子を孕ませるので、子宮がすでに一杯になり、卵巣自体に入ることを余儀なくされるので、アダムが彼の精子が制御不能に溢れ出し、サムスのプッシーに彼の精子をすべて解き放つ最後のシーンとして機能するだろう。  \n\n私は、その体が映し出されたという言及を残した。シーンの一部ではありませんが、おまけとしてだけでなく、今後の用途としても作っていただけると嬉しいです。1セットはレントゲンなし、もう1セットはレントゲンありです。そしてアダムには最大のチンコを(笑)\n\nhttps://drive.google.com/drive/folders/1gGL05B46moStB-n-Upzvnf_kxPFuElme?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kosei_ryuda/works/156", "thumbnail_src": "https://si.imgix.net/f3cda21a/uploads/origins/eebeb634-2a4f-4d3f-984b-20cad488f349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=763378c35773e6ec10f7a8698052dfa3", "thumbnail_srcset": "https://si.imgix.net/f3cda21a/uploads/origins/eebeb634-2a4f-4d3f-984b-20cad488f349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=763378c35773e6ec10f7a8698052dfa3, https://si.imgix.net/f3cda21a/uploads/origins/eebeb634-2a4f-4d3f-984b-20cad488f349?bg=%23fff&auto=format%2