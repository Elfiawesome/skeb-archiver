mgix.net/b67698a4/uploads/origins/f0a599ce-23a4-436b-a65f-edf4f6dd1c21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc698990fedbfb778bd2e352b7c93493 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SignalViolet/works/22", "thumbnail_src": "https://si.imgix.net/b6bdefa3/uploads/origins/5516c8d5-8ac4-4aec-9282-18180b482364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61923b238e87731e38b918608e218948", "thumbnail_srcset": "https://si.imgix.net/b6bdefa3/uploads/origins/5516c8d5-8ac4-4aec-9282-18180b482364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61923b238e87731e38b918608e218948, https://si.imgix.net/b6bdefa3/uploads/origins/5516c8d5-8ac4-4aec-9282-18180b482364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77d179b9435abb94357f5032938b9221 2x, https://si.imgix.net/b6bdefa3/uploads/origins/5516c8d5-8ac4-4aec-9282-18180b482364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37767d6b7fc723b8c938c6e342a48b92 3x", "genre": "art", "nsfw": true, "body": "こんにちは！夏に出されました「こんなゲームだなんて聞いてない！」すごく良かったです。\n仲の良い４人が１人ずつバラバラに行動した結果それぞれ個別にバッドエンドを迎えてる感がめちゃくちゃ刺さりました！\n\nその中で淫紋の効果で連れ出されていたモモイのフィニッシュ部分が見たく（個人的にモモイが好きなのもありまして）、漫画の一部分の続きのイラストという形で恐縮ですが、もしよろしければお願いさせていただくことはできますでしょうか？\n\nモモイが個別エロパートでごめんみんな…と言いながらも身体は堕ち切ってて、喘ぎながら男性に腕と脚でがっしり組みついてる状況にとても興奮しておりまして、その抱きついている体勢で、真正面からの視点で中出しされる前後（男性の胴体は透過か非表示差分があると嬉しいです）のイラストを、可能であればよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@SignalViolet/works/21", "thumbnail_src": "https://si.imgix.net/0bfe578e/uploads/origins/cd928e30-fa69-498d-9378-01df658ba6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=691ff9769704c23b29ea3effcb03fa77", "thumbnail_srcset": "https://si.imgix.net/0bfe578e/uploads/origins/cd928e30-fa69-49