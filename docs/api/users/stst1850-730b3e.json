ve/w2rSqmghkJw?feature=share\n\n▫️参考資料は下記に添付させていただきますのでご確認ください！\n▫️表情やポーズはお任せ致します。\n▫️当方糸目ですので開眼だけはさせないようお願いします…！\n▫️表情差分があればとっても嬉しいですが、難しければ大丈夫です！\n▫️YouTubeでの歌枠のサムネイルや各種SNSに使用させていただきます。\n▫️髪の毛の先が切れないように描いていただきたく、また、幅広い範囲で使用出来るようレイヤーの分かれたPSDファイルで納品いただけると助かります。\n\n以上、ご検討いただけますと幸いです。\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1egZHqvqTLH7fsa2obGss7DNoSt6HIdhx", "created_at": "", "completed_at": ""}, {"path": "/@stst1850/works/26", "thumbnail_src": "https://si.imgix.net/7a3f5d4e/uploads/origins/d030d9b5-bef7-4f7f-b750-145df340b65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=709bcdd930b5cfb8e4a08859c68aef2e", "thumbnail_srcset": "https://si.imgix.net/7a3f5d4e/uploads/origins/d030d9b5-bef7-4f7f-b750-145df340b65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=709bcdd930b5cfb8e4a08859c68aef2e, https://si.imgix.net/7a3f5d4e/uploads/origins/d030d9b5-bef7-4f7f-b750-145df340b65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9214d7352c33417656b905946610d380 2x, https://si.imgix.net/7a3f5d4e/uploads/origins/d030d9b5-bef7-4f7f-b750-145df340b65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fb9f623ea957ce44940b39f69fba706 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@stst1850/works/25", "thumbnail_src": "https://si.imgix.net/2b2fdca1/uploads/origins/19278ba9-d429-4c97-bbed-9e74ccb0e34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsiz