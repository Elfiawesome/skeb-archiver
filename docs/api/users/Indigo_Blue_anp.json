87d5-5ca95f522142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd0e3bd58c2aed3a94485758754f946f 2x, https://si.imgix.net/0f32bc71/uploads/origins/210d1209-c317-4f38-87d5-5ca95f522142?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e487a47e700428a1a96df5221400820 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nTwitterで可愛らしい絵を拝見しましてご依頼の方をさせていただきました！ \n\n ▼容姿や性格  \n性別:女の子 \n髪色:暗めの茶髪\n髪型:レイヤーボブ \n年齢:18歳 \n服装:桜っぽい春服\nその他はおまかせでお願い致します！\n\nhttps://www.pixiv.net/artworks/85045671", "created_at": "", "completed_at": ""}, {"path": "/@Indigo_Blue_anp/works/217", "thumbnail_src": "https://si.imgix.net/cd9baba2/uploads/origins/03005396-21ac-4eec-a3f7-02d0ede1f993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b64d5ae959101111d02fd8c1aa2fcea", "thumbnail_srcset": "https://si.imgix.net/cd9baba2/uploads/origins/03005396-21ac-4eec-a3f7-02d0ede1f993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b64d5ae959101111d02fd8c1aa2fcea, https://si.imgix.net/cd9baba2/uploads/origins/03005396-21ac-4eec-a3f7-02d0ede1f993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b1d83994ec978bf8ad622ac1c7fa100 2x, https://si.imgix.net/cd9baba2/uploads/origins/03005396-21ac-4eec-a3f7-02d0ede1f993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eaf5b6d88bebcf6149a2fd7a7efaacfb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Indigo_Blue_anp/works/216", "thumbnail_src": "https://si.imgix.net/2b570360/uploads/origins/bdbc30f9-5587-4aff-941c-fc5975dbd66b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad20d0f70a1408d94d01d782540ddec", "thumbnail_srcset": "https://si.imgix.net/2b570360/uploads/origins/bdbc30f9-5587-4aff-941c-fc5975dbd66b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad20d0f70a1408d94d01d782540ddec, https://si.imgix.net/2b570360/uploads/origins/bdbc30f9-5587-4aff-941c-fc5975dbd66b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1228d45104ec62c4bd87da1cae5acd8 2x, https://si.imgix.net/2b570360/uploads/origins/bdbc30f9-5587-4aff-941c-fc5975dbd66b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=311c214f791b1411748601551830f54f 3x", "genre": "art", "nsfw": false, "body": "結木ユウ様\n\nお世話になっております！\nVtuber事務所「ベルプロ」所属\n心恋音むいる（ここねむいる）です✨\n\n以前結木ユウ様に描いていただいたイラストがとてもお気に入りで\nまたぜひお願いさせていただきたく依頼いたしました。\n\n【リクエスト内容】\n私自身をお願いいたします。\n\n〇衣装・髪型・ポーズ・表情など\n基本おまかせですが、もしよろしければセーラー服衣装ですと嬉しいです✨\n色などはおまかせでお願いできればと思います！\n\n〇使用用途\n・TwitterやSNS等での宣伝、Youtubeでのサムネイルとして使用\n（可能であれば、キャラクターのみの透過されたイラストもいただけますと大変助かります。）\n\n・もし可能でしたら髪や衣装がキャンバスの横幅からはみ出ないようにして頂けるととても有難いです。\n\n\n\n私の容姿については、以下のURLにございます。\nhttps://x.com/Kokone_Muiru/status/1914514503187771412\n\n以上となります。ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\n心恋音むいる", "created_at": "", "completed_at": ""}, {"path": "/@Indigo_Blue_anp/works/215", "thumbnail_src": "https://si.imgix.net/9a4500d7/uploads/origins/edeb5da6-30f8-473c-ab27-73acfea0bf96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3148d82bb99dd2b9136476e27199128f", "thumbnail_srcset": "https://si.imgix.net/9a4500d7/uploads/origins/edeb5da6-30f8-473c-ab27-73acfea0bf96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3148d82bb99dd2b9136476e27199128f, https://si.imgix.net/9a4500d7/uploads/origins/edeb5da6-30f8-473c-ab27-73acfea0bf96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfc0a2b65c9dacde7d62727b4e