-1bf57595edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79346ba181930bc86df96c735a9f8428 2x, https://si.imgix.net/6a37a107/uploads/origins/ca9b9e2e-f860-48e1-9375-1bf57595edf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=393d427bf00e174fb65f816c447c7915 3x", "genre": "art", "nsfw": false, "body": "はじめまして個人Vtuberの濡羽娜真【@NrbN_mkt】と申します。\nイラストに惹かれ依頼させて頂きたいと思いました。\n\n【依頼内容】\n私、濡羽娜真のイラストを描いて頂きたいです。\n構図、ポーズなどお任せでお願いします…\n\n\n【使用用途】\nSNSでの掲載 また、配信等でのサムネイルやアイコン等などにご使用させて頂きたいです。\n\n【希望ファイル】\n可能であればPSDで人物と背景のレイヤーを分けて頂けるか、背景透過のデータをいただけると嬉しいです！\n\n以上、どうぞよろしくお願いいたします。\n\n\n以下のURLがキャラの参考資料になります。\n・Googleドライブ(立ち絵)\nhttps://drive.google.com/drive/folders/1TiI_23j-BNQ-963MbhbCxGNLmlpSya8-?usp=sharingusp=sharing\n・Twitter\nhttps://twitter.com/NrbN_mkt", "created_at": "", "completed_at": ""}, {"path": "/@Re_Gatchaman/works/12", "thumbnail_src": "https://si.imgix.net/697bc48a/uploads/origins/84cdf1ca-a849-450c-97fa-ff57ffa5f328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c2dc75cf6d7f47ecf6dda93b0264c28", "thumbnail_srcset": "https://si.imgix.net/697bc48a/uploads/origins/84cdf1ca-a849-450c-97fa-ff57ffa5f328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c2dc75cf6d7f47ecf6dda93b0264c28, https://si.imgix.net/697bc48a/uploads/origins/84cdf1ca-a849-450c-97fa-ff57ffa5f328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7befa63f0be9507d265ca8758caaee47 2x, https://si.imgix.net/697bc48a/uploads/origins/84cdf1ca-a849-450c-97fa-ff57ffa5f328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e4499f26eb03d8468cffc376ffc3e13 3x", "genre": "art", "nsfw": false, "body": "前回はお世話になりました！！よろしければまたお願いします！！\n以前描いて貰いましたが自創作キャラクターのユーフェミアをお願いします。\n■https://www.uchinokomato.me/chara/show/237830\n衣装はURL内のギリシャ風ドレスと言うか、エンパイアスタイルの方でお願いします。\n\n以前のレイヤー技術に感動したのでレイヤー残っていると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Re_Gatchaman/works/11", "thumbnail_src": "https://si.imgix.net/c41c057a/uploads/origins/d142f9c6-50cd-429b-a2fc-ae1a0d8bd72d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95c9935b03c7ebf069edccff325136db", "thumbnail_srcset": "https://si.imgix.net/c41c057a/uploads/origins/d142f9c6-50cd-429b-a2fc-ae1a0d8bd72d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95c9935b03c7ebf069edccff325136db, https://si.imgix.net/c41c057a/uploads/origins/d142f9c6-50cd-429b-a2fc-ae1a0d8bd72d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=839aa73134544ad8278538d8de6f924b 2x, https://si.imgix.net/c41c057a/uploads/origins/d142f9c6-50cd-429b-a2fc-ae1a0d8bd72d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=376b0a006fa080ddfae2b96499091880 3x", "genre": "art", "nsfw": false, "body": "Re 樣\n\nはじめまして、ぺですとりあんと申します。\nいつもイラストを拝見いたしております。\nRe樣の描く絵柄が大変好みでいつかリクエストをしたいと考えておりました！\n\n今回は私のオリジナルキャラクターである「神月 桂華（こうげつ けいか）」をお描きいただきたく存じます。\n\n概要…“キンモクセイ”の擬人化娘\n性格…いわゆる大和撫子。どことなく近寄り難い雰囲気の中に大人の色香を醸すような、上品で慎ましやかな女性。\n頭髪…黒髪がベースカラー。アクセントとしてほのかに鮮やかなアプリコットオレンジのグラデーションが毛先にある。\n容貌…18~25歳の間。可愛いとも美人ともとれる落ち着いた表情の女性。伏し目や流し目が似合う。瞳の色は琥珀色。\nその他…小物として“金木犀“があると嬉しいです。\n＊イラストレーターさんの思い描く姿が見たいので、細部（髪の長さ・髪型・服装・構図 等）はお任せします。\n＊宜しければレイヤー情報を残していただければと存じます！\n\n参考資料：\nhttps://www.uchinokomato.me/chara/show/265139\n\n何卒宜しくお願い申し上げます！", "created_at": "", "completed_at": ""}, {"path": "/@Re_Gatchaman/works/10", "thumbnail_src": "https://si.imgix.net/1caac6e1/uploads/origins/933df28a-b322-475e-bf6e-cd4a5bc8a45a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04e336bfa8065f31db66883ac0ed5da8", "thumbnail_srcset": "https://si.imgix.net/1caac6e1/uploads/origins/933df28a-b322-475e-bf6e-cd4a5bc8a45a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04e336bfa8065f31db66883ac0ed5da8, https://si.imgix.net/1caac6e1/uploads/origins/933df28a-b322-475e-bf6e-cd4a5bc8a45a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ee51c3666c11e0e43542ece181c5920 2x, https://si.imgix.net/1caac6e1/uploads/origins/933df28a-b322-475e-bf6e-cd4a5bc8a45a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a2f4d7a2c6ee55619342d33b28f5d77 3x", "genre": "art", "nsfw": false, "body": "Reさんのスマートな絵柄の大ファンなので、ぜひうちの子を描いていただければとリクエスト送信しております。\n\n資料は自作のキャラクターで「リチャード」といいます。\nhttps://hub.vroid.com/characters/6101787358777148697/models/6848656251668088516\n\n友達が少なく、無愛想な顔をしている事が多いです。気を許した相手の前でも距離感を掴むのが下手で、ぶっきらぼうな態度を取ってしまったりします。打ち解ければ笑顔も見せますが、そもそも笑うのが上手ではありません。好きな女の子の前では保護者ぶって冷静に振る舞っていますが、内心はいつもメロメロにやられています。\n顔の特徴としては眉は吊り眉気味、目元はタレ目気味です。犬歯のような八重歯もあります。\n\nこんな感じのキャラなのですが、構図などはおまかせで描いていただければ幸いです。\n一つ要望があるとすれば、今回の衣装は靴を頑張って作ったので、靴が入る構図だととても嬉しいです。\n\n以上よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Re_Gatchaman/works/9", "thumbnail_src": "https://si.imgix.net/b4507b46/uploads/origins/a31a07c0-f1ba-4984-a890-b762f7cff768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff144196b373b619d70107d00f75a999", "thumbnail_srcset": "https://si.imgix.net/b4507b46/uploads/origins/a31a07c0-f1ba-4984-a890-b762f7cff768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff144196b373b619d70107d00f75a999, https://si.imgix.net/b4507b46/uploads/origins/a31a07c0-f1ba-4984-a890-b762f7cff768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ecdd22c057fd111c06c7d33e75b07fe 2x, https://si.imgix.net/b4507b46/uploads/origins/a31a07c0-f1ba-4984-a890-b762f7cff768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4505d6e799d467ad5330d26b0a80a2f1 3x", "genre": "art", "nsfw": false, "body": "前はかっこいいオズワルドをありがとうございました！めちゃくちゃカッコ良かった…。Reさんに描いて貰ううちの子がめちゃくちゃカッコいいのでよろしければまたお願いしたくて！\n自創作のキャラクター、ソーン(短髪)とユーフェミアをお願いします。恋人同士なのでそれっぽい雰囲気だと嬉しいです。\n服装、構図、シチュエーション等お好きにどうぞ。\nよろしければご検討お願いします！\n■ユーフェミア資料\nhttps://www.uchinokomato.me/chara/show/237830\n\n■ソーン 資料\nhttps://www.uchinokomato.me/chara/show/243766", "created_at": "", "completed_at": ""}, {"path": "/@Re_Gatchaman/works/8", "thumbnail_src": "https://si.imgix.net/845d9c65/uploads/origins/2ec75a40-620c-4107-bc29-72659dce5293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ce532d480e9cea535e18cfd751a802a", "thumbnail_srcset": "https://si.imgix.net/845d9c65/uploads/origins/2ec75a40-620c-4107-bc29-72659dce5293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ce532d480e9cea535e18cfd751a802a, https://si.imgix.net/845d9c65/uploads/origins/2ec75a40-620c-4107-bc29-72659dce5293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5f9ebcbbae5ae05e388d97fd0ad3b49 2x, https://si.imgix.net/845d9c65/uploads/origins/2ec75a40-620c-4107-bc29-72659dce5293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0074bb254319519d81b310f8f047f403 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたのアートスタイルがとても好きです。^_^\n\nゲームファイアーエムブレム無双のリアンを描いていただきたいのですが。彼女が王国の女王になったかのような衣装デザインを持っています。それを使ってください。\n\n参考文献は以下の通りです。\n\nリアン - https://imgur.com/a/IEqGnYa\nクイーン・アウトフィット - https://imgur.com/a/a64yQKH\n\n衣装全体を入れていただけると大変ありがたいです。剣は入れなくても構いません。立ち上がって腰の前で手を組むというシンプルなポーズでお願いします。表情は少し微笑んでいるような感じでお願いします。\n\n私のリクエストを受け入れてくれると嬉しいです。^_^", "created_at": "", "completed_at": ""}, {"path": "/@Re_Gatchaman/works/7", "thumbnail_src": "https://si.imgix.net/dd668fdb/uploads/origins/702434e9-a29d-4cbe-a6f2-b4d41d2d06d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52a635ed399240d182b0fafd2860d035", "thumbnail_srcset": "https://si.imgix.net/dd668fdb/uploads/origins/702434e9-a29d-4cbe-a6f2-b4d41d2d06d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52a635ed399240d182b0fafd2860d035, https://si.imgix.net/dd668fdb/uploads/origins/702434e9-a29d-4cbe-a6f2-b4d41d2d06d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f80decdfac7f0a563485b1c96ea6a