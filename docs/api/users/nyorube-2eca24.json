Ccenter&txtsize=30&txt=PRIVATE&s=acc4112cef3e96dfc6dc0d10868c0416, https://si.imgix.net/6497dd28/uploads/origins/3985400a-4d6d-4545-81a7-4a91dee27cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d4ae13e15b79f7aa8af4696faa61d4e0 2x, https://si.imgix.net/6497dd28/uploads/origins/3985400a-4d6d-4545-81a7-4a91dee27cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8476f9901f04cda9ee580c7f1b0aeedf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nyorube/works/35", "thumbnail_src": "https://si.imgix.net/fc21316a/uploads/origins/d5d33952-4533-4862-bce6-752c789ce3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52abf8e57e993a620c8aeff69db86f35", "thumbnail_srcset": "https://si.imgix.net/fc21316a/uploads/origins/d5d33952-4533-4862-bce6-752c789ce3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52abf8e57e993a620c8aeff69db86f35, https://si.imgix.net/fc21316a/uploads/origins/d5d33952-4533-4862-bce6-752c789ce3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b0e5d1e6e66fa3c35bd5182242cefd5 2x, https://si.imgix.net/fc21316a/uploads/origins/d5d33952-4533-4862-bce6-752c789ce3c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cd005f2439bafa9a38f13c41d832499 3x", "genre": "art", "nsfw": true, "body": "キャラ→梼原ひかり\n 服装→紺色ブルマ(ノーブラ・ノーパンで大きい胸を露出) 黒ハイソ、ローファー。 \nシチュ→体育が自習となり、いじめっ子のクラスメイトの女子達に撮られながら同じくいじめっ子の巨根の太ったクラスメイトとアヘ顔中出しセックス。\n\n女子生徒達は台詞だけで、ひかりはひたすら気持ち良さそうに喘ぐ感じでお願いします。\n\n女子生徒　台詞サンプル\n「ディズニー代稼ぎとはいえ肉便器のアヘ顔きんもッ♡\n喘いでないでちゃんとスパチャのお礼言えよバカマンコw」\n「うちらがディズニー行けなかったら梼原ひかりちゃんの所為だからね〜w\n分かってるの、肉便器のひかりちゃん？♡」\n\n男子生徒　サンプル\n「やっぱ肉便器の割にはちゃんとパイパンマンコ締まるじゃんw\nおら、早く孕め…ッ！」\n\nhttps://book.dmm.co.jp/product/708868/b555acrcl00207/", "created_at": "", "completed_at": ""}, {"path": "/@nyorube/works/34", "thumbnail_src": "https://si.imgix.net/8b9e168a/uploads/origins/75f9e3d1-0bd0-4597-b01b-8b48cfc4ae1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=302aa2f27e2bccbf4d70f5f7d46fdc0d", "thumbnail_srcset": "https://si.imgix.net/8b9e168a/uploads/origins/75f9e3d1-0bd0-4597-b01b-8b48cfc4ae1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=302aa2f27e2bccbf4d70f5f7d46fdc0d, https://si.imgix.net/8b9e168a/uploads/origins/75f9e3d1-0bd0-4597-b01b-8b48cfc4ae1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d68781cd5fb1f064c3dc7779cc851023 2x, https://si.imgix.net/8b9e168a/uploads/origins/75f9e3d1-0bd0-4597-b01b-8b48cfc4ae1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41e9babd573c6d5b5a3491e14ba39c89 3x", "genre": "art", "nsfw": true, "body": "キャラ→梼原ひかり\n 服装→制服(ノーブラ・ノーパンで胸を露出) 黒ハイソ、ローファー。 \n前置き→ひかりがドM向けのふたなり風俗店に制服姿で入店し、見た目小学校高学年くらいのロリのドS巨根お姉さんが通報しない代わりに肉便器のお仕置き専用ルームに連れて行く。\n\nお姉さん→巨根は男性を超えるぐらいにかなり大きく、可愛い見た目に反してかなり雄らしい反り返ったもの。\n風俗嬢らしく卑猥な衣装で一瞬も休ませないように精液塗れのひかりをひたすら連続ピストン&中出し。\n\nひかり→現役JKのパイパンマンコでお姉さんの期待に応えるように腹ボコしつつも気持ち良さそうに喘いでお姉さんを喜ばせる。\nドMな奉仕体質でハードな攻めにも応えて破損や出血等はなし。\n\nお姉さんがひかりを精液塗れにして「現役女子高生の肉便器ってすっごく欲しかったんですよ…♡しかもパイパンのドMマンコ♡」「肉便器なんだから財産も卵子も全部捧げますよね、ひ・か・りッ♡」など揶揄う感じで、巨大ふたなり風俗嬢みたいな感じでセックスしてるところだけお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nyorube/works/33", "thumbnail_src": "https://si.imgix.net/dac568b4/uploads/origins/1b5e3183-5ca8-4ae8-a094-667e5fb11a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d67a6b5c44b1a7da94fb908f469531e1", "thumbnail_srcset": "https://si.imgix.net/dac568b4/uploads/origins/1b5e3183-5ca8-4ae8-a094-667e5fb11a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d67a6b5c44b1a7da94fb908f469531e1, https://si.imgix.net/dac568b4/uploads/origins/1b5e3183-5ca8-4ae8-a094-667e5fb11a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=444d35a522274720a1da9446d8298b3a 2x, https://si.imgix.net/dac568b4/uploads/origins/1b5e3183-5ca8-4ae8-a094-667e5fb11a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13b3fba6d6cfe76fad22e3c61dc3441e 3x", "genre": "art", "nsfw": true, "body": "はじめまして！是非よろしくお願い致します。\n\n <キャラ> \n静海 涼音 (長身スレンダー)\nhttps://syrup-soft.com/mm/megami/chara.html \n\n<衣装> \nラストオリジン:無敵の龍(セーラードラゴン) https://twitter.com/seikazestrans/status/1545755480890286080?s=46&t=MH4x8HXyYiQuGCt71iaL1A \nに首輪と鎖、前後リモコンバイブ(タイツに受信機)\n\n<内容> \nビッ○サイトのコスプレイベントに参加。\n権藤 力男(衣装お任せ)\n https://syrup-soft.com/mm/megami/chara2.html\nが後ろに立ち、手に持った鎖でペットのように扱われる。脇見せポーズ(手は頭の後ろ)で会場を連れ回され、モデルのような体型と過激なコスで注目の的に。\n\n直前までホテルで輪◯、前後中出しの上にバイブで栓をされているが、股間からは精液が漏れてしまう。\n涼音は冷静さを保とうと強がるが、執拗なリモコンバイブ責め快楽と撮影される羞恥で、静かに何度も絶頂してしまう。", "created_at": "", "completed_at": ""}, {"path": "/@nyorube/works/32", "thumbnail_src": "https://si.imgix.net/157121e1/uploads/origins/cf608bc5-6df8-4a8e-a69b-bf64e167680a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb52a7ce104f01866ac062eb05d1229d", "thumbnail_srcset": "https://si.imgix.net/157121e1/uploads/origins/cf608bc5-6df8-4a8e-a69b-bf64e167680a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb52a7ce104f01866ac062eb05d1229d, https://si.imgix.net/157121e1/uploads/origins/cf608bc5-6df8-4a8e-a69b-bf64e167680a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81b1d6dc013b859f57ba78ea732d1e6e 2x, https://si.imgix.net/157121e1/uploads/origins/cf608bc5-6df8-4a8e-a69b-bf64e167680a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w