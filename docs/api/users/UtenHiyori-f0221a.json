0951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef3b5f2b9d5c3c802c038b263591e616 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@UtenHiyori/works/9", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65a5b38ab5c0aea561102f082288c41", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c65a5b38ab5c0aea561102f082288c41, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f843a1f40aa760cc9eb2f9a4f9ad8ae 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de27b41598b7ea653c34574bf2d9c41e 3x", "genre": "voice", "nsfw": false, "body": "0～23時の24時間の時報ボイスをリクエストさせてください！\n内容はすべてお任せします！\n多分思い浮かぶあのボイスに寄せていただいても良いですし、\n気の置けない友達との会話、恋人との恋愛的なシチュエーションなどどのような形式でも構いません。\n\n羽天ひよりの表現する時報ボイスを是非ともお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@UtenHiyori/works/8", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d31dc61e08f05380a07baf57ccae6c9", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F13458684282009