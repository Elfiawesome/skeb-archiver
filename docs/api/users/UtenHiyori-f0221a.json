ます。\n年末に向けて紅葉狩りのシーズン、木々が赤く鮮やかに染まる幻想的な地元（っていう設定）の公園を2人で歩きながら色々なことをお話し。\n「すっかり過ごしやすくなったねー」や「今年の夏は慌ただしかったね」とか、年末が近づいてくるので「クリスマスも一緒に過ごそうね」とか「来年は落ち着いたら旅行とかにも行きたいね」など、のんびりまったりとイチャイチャする感じでお願いします\n今回は宛名、名前呼びはあった方が嬉しいです\n\nリクエストが増えている、新しい方のリクエストが入ってきたりしたらそちら優先していただいて問題ありません！\nいくらでも待ちますし、難しいようでしたらまた別途依頼を投げ直しますー", "created_at": "", "completed_at": ""}, {"path": "/@UtenHiyori/works/6", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d31dc61e08f05380a07baf57ccae6c9", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d31dc61e08f05380a07baf57ccae6c9, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc9f74f9b461fe75f01f1b85a7424f8a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef3b5f2b9d5c3c802c038b263591e616 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@UtenHiyori/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1345868428200951810%2FDwtECUL7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20