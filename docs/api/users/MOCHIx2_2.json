ix.net/93db9401/uploads/origins/3ef2a286-18f6-4ecf-8e05-ea49d29b6f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e15774fc38c58378840fc2b1be575177, https://si.imgix.net/93db9401/uploads/origins/3ef2a286-18f6-4ecf-8e05-ea49d29b6f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c040a04630d6b6032ac8f5cad3cc3db4 2x, https://si.imgix.net/93db9401/uploads/origins/3ef2a286-18f6-4ecf-8e05-ea49d29b6f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9687af61e2fcae8e39b79bd0562f6c0 3x", "genre": "art", "nsfw": false, "body": "フェアリーテイルのブランディッシュ・μミューが露出度の高いバニースーツで登場。\n\nモノの大きさを変えられるという彼女のパワーで、巨人になって迫ってくるようなポーズやアングルをお願いしたい。\n\nよろしくお願いします！\n\nhttps://imgur.com/a/vqHHtPJ", "created_at": "", "completed_at": ""}, {"path": "/@MOCHIx2_2/works/155", "thumbnail_src": "https://si.imgix.net/c59add2a/uploads/origins/2ed5229f-dc95-48e2-b5a2-a1a4ca43bb28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac59a5e80eb257c8f85daca3b55833c2", "thumbnail_srcset": "https://si.imgix.net/c59add2a/uploads/origins/2ed5229f-dc95-48e2-b5a2-a1a4ca43bb28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac59a5e80eb257c8f85daca3b55833c2, https://si.imgix.net/c59add2a/uploads/origins/2ed5229f-dc95-48e2-b5a2-a1a4ca43bb28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91631c8e5ed29b5694b9b1873b3400dc 2x, https://si.imgix.net/c59add2a/uploads/origins/2ed5229f-dc95-48e2-b5a2-a1a4ca43bb28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67ba2b620051044bb590808f228ae3e6 3x", "genre": "art", "nsfw": false, "body": "キャラクター\nアティ(サモンナイト3)\n\n衣装\n白ビキニ\n\nポーズ等はお任せします", "created_at": "", "completed_at": ""}]}