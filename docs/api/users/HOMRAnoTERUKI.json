80p4+%E6%84%9B%E8%8F%9C&udm=2&fbs=AIIjpHzCFIs5", "created_at": "", "completed_at": ""}, {"path": "/@HOMRAnoTERUKI/works/210", "thumbnail_src": "https://si.imgix.net/9a5fc0a4/uploads/origins/2e0fb503-a5c2-4d83-ac8a-2533ccdbf3ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=521caee570f94c7faf48e43f496c53a3", "thumbnail_srcset": "https://si.imgix.net/9a5fc0a4/uploads/origins/2e0fb503-a5c2-4d83-ac8a-2533ccdbf3ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=521caee570f94c7faf48e43f496c53a3, https://si.imgix.net/9a5fc0a4/uploads/origins/2e0fb503-a5c2-4d83-ac8a-2533ccdbf3ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91fc56e353115dd5ca0dc05c9de6ace8 2x, https://si.imgix.net/9a5fc0a4/uploads/origins/2e0fb503-a5c2-4d83-ac8a-2533ccdbf3ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=615b478ad460e350786a0d1ad0d783cb 3x", "genre": "art", "nsfw": true, "body": "シンフォギアの翼さんでイラストをお願いします\n相変わらずお尻丸出し系のイラストですが、何卒宜しくお願いします。\n\n・資料のなのはコラボ時のギア着用\n・お尻丸出し\n・お尻重点のアングル\n\n他の点は自由にしてくださって大丈夫です。\n\nhttps://x.com/symphogear_xd/status/1626854026980491265?s=61", "created_at": "", "completed_at": ""}, {"path": "/@HOMRAnoTERUKI/works/209", "thumbnail_src": "https://si.imgix.net/01d26211/uploads/origins/88b91f38-1aea-48e5-9329-dd3792b7740f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=914ffdae57cf05f3153f2ec5c4b53db0", "thumbnail_srcset": "https://si.imgix.net/01d26211/uploads/origins/88b91f38-1aea-48e5-9329-dd3792b7740f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=914ffdae57cf05f3153f2ec5c4b53db0, https://si.imgix.net/01d26211/uploads/origins/88b91f38-1aea-48e5-9329-dd3792b7740f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d295d7716df9402b1bfa9452e0d7949 2x, https://si.imgix.net/01d26211/uploads/origins/88b91f38-1aea-48e5-9329-dd3792b7740f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0d69ca31b185f712620eba55ea15748 3x", "genre": "art", "nsfw": true, "body": "以前依頼した18号の特殊性癖AVのジャケット絵をイメージしたイラストをお願いします。\n\n・まんぐり返しの姿勢、挑発するような18号の表情\n・スカート衣装で、スカートを上げてパンツとタイツを脱いでいる\n・タイトル名やその他あおり文等はお任せします\n\nhttps://drive.google.com/drive/folders/1EFyDredsjOWfVO79IeipGm9kl3tu-zJQ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@HOMRAnoTERUKI/works/208", "thumbnail_src": "https://si.imgix.net/67868325/uploads/origins/172abd57-2d23-46c3-9f20-4c93f53e2442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59a9e879ce6f1c242e99df6440e697e", "thumbnail_srcset": "https://si.imgix.net/67868325/uploads/origins/172abd57-2d23-46c3-9f20-4c93f53e2442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59a9e879ce6f1c242e99df6440e697e, https://si.imgix.net/67868325/uploads/origins/172abd57-2d23-46c3-9f20-4c93f53e2442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c46f362df2e0a9a01e4a74f1f890f4f3 2x, https://si.imgix.net/67868325/uploads/origins/172abd57-2d23-46c3-9f20-4c93f53e2442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3467b0bf36122c2301797e3ec0486c5 3x", "genre": "art", "nsfw": true, "body": "バニー衣装の大人なのフェイでイラストを一枚お願いします\n\n二人が並んでお尻を突き出したら、突然お尻が丸出しになってしまった！\nそんなシチュでお願いします。\n\n・二人がお尻を突き出している構図\n・「きゃ〜っ！」と二人揃って顔真っ赤で慌てている\n\n資料も参照して頂けると嬉しいです\n\nhttps://drive.google.com/drive/folders/1ZJE9Vti7Wt9hJNCCyc3D7gqtJoMfKP-q?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@HOMRAnoTERUKI/works/207", "thumbnail_src": "https://si.imgix.net/fd684098/uploads/origins/918fecfa-918e-48d9-a89a-b6720d26eff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247a5362e95ab7aec1c181ea3483b09e", "thumbnail_srcset": "https://si.imgix.net/fd684098/uploads/origins/918fecfa-918e-48d9-a89a-b6720d26eff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247a5362e95ab7aec1c181ea3483b09e, https://si.imgix.net/fd684098/uploads/origins/918fecfa-918e-48d9-a89a-b6720d26eff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8930458dcdd1c89fa8aaf996f7e526bd 2x, https://si.imgix.net/fd684098/uploads/origins/918fecfa-918e-48d9-a89a-b6720d26eff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58b19246f7c9415be5a19b3d171c1f68 3x", "genre": "art", "nsfw": true, "body": "暫くぶりですが、リクエストしたいものがピンと頭に浮かびました!\nブレスオブファイア2のリンプーで究極合体モードながら、\n\n・解除しかけで結構ボロボロ\n・だけど表情は気合入っている笑み\n・『痛くないよーだ!』と啖呵切っている感じ\n\nでお願いいたします!\n画像に関する資料は以下のURLです。\n以上となりますが、宜しくお願い致します。\n\nhttps://x.com/hori_hole/status/875379824285503489", "created_at": "", "completed_at": ""}, {"path": "/@HOMRAnoTERUKI/works/206", "thumbnail_src": "https://si.imgix.net/e015ae96/uploads/origins/b6f79353-7d2a-4bdf-a8bf-256cf873403e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b5d9c49eef8c56ca205a5b8b892157", "thumbnail_srcset": "https://si.imgix.net/e015ae96/uploads/origins/b6f79353-7d2a-4bdf-a8bf-256cf873403e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b5d9c49eef8c56ca205a5b8b892157, https://si.imgix.net/e015ae96/uploads/origins/b6f79353-7d2a-4bdf-a8bf-256cf873403e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30a0ab01d9f7ada557b5d26f5cae4df4 2x, https://si.imgix.net/e015ae96/uploads/origins/b6f79353-7d2a-4bdf-a8bf-256cf873403e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3324c16d5303c1bcc8ebb09e9c0ca106 3x", "genre": "art", "nsfw": true, "body": "あけましておめでとうございます。\n新年早速、依頼を送らせていただきます。\n\n今まで送った依頼の中で、ビビッと来た二人でお願いします。\nドラゴンボールの18号とコードギアスのカレンちゃんで依頼をお送りします。\nシチュ的には、個人的な撮影に応じてくれているイメージで。\n\n・紅月カレン（絶対露出でお尻丸出しのパイロットスーツ）\n・18号（AV撮影時のお尻丸出しズボン）\n・二人が並んでお尻を突き出し、股間を手で隠している。\n・我慢の限界を迎えており、おしっこを漏らし、屁も漏れて肛門も盛り上がっている\n・詳しい衣装の状態や構図は資料を参照。\n\nhttps://drive.google.com/drive/folders/1qnc3twS0zDt7Gx1d8xj7k2tFwnGlTa35?usp=sharing", "created_at": "", "completed_at": ""