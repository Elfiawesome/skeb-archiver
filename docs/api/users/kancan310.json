る。\n\n「◈」使用目的\ntoyhou.se\"、\"x/twitter \"などのキャラクターデータベースサイト、またはその他のフォーラムサイトに掲載し、アーティストであるあなたのクレジットを直接表示するための個人使用のみ。\nウォールアートやグッズとして印刷し、一個人（依頼者である私）が消費すること。\n大量生産や商業利用は禁止します。\n\n「◈」参照リンク\n\nhttps://drive.google.com/drive/u/0/folders/1-fciKcmQQZ1EEwcW8mPK54hzRB8k1qPl\n\nhttps://drive.google.com/drive/u/0/folders/1-fciKcmQQZ1EEwcW8mPK54hzRB8k1qPl", "created_at": "", "completed_at": ""}, {"path": "/@kancan310/works/26", "thumbnail_src": "https://si.imgix.net/d4f34f9e/uploads/origins/cd73d131-225e-417f-9483-c626fa14b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dce318b343332afbc03980c63af8fd5c", "thumbnail_srcset": "https://si.imgix.net/d4f34f9e/uploads/origins/cd73d131-225e-417f-9483-c626fa14b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dce318b343332afbc03980c63af8fd5c, https://si.imgix.net/d4f34f9e/uploads/origins/cd73d131-225e-417f-9483-c626fa14b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9f74c228905d03710f9f5219bcc0dff 2x, https://si.imgix.net/d4f34f9e/uploads/origins/cd73d131-225e-417f-9483-c626fa14b05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bb7d46a7235e3fe576ab5444eafdc8f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kancan310/works/25", "thumbnail_src": "https://si.imgix.net/a805ec6f/uploads/origins/bc431522-484e-48c9-8617-7ae287793475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=139f946fd2c5d9ba8fbeb8511b17bee6", "thumbnail_srcset": "https://si.imgix.net/a805ec6f/uploads/origin