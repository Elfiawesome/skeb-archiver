9c50e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=686f081877df0474833b5cb16ab960a8", "thumbnail_srcset": "https://si.imgix.net/3d79c772/uploads/origins/1b9e0842-1f32-4204-987f-91059f9c50e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=686f081877df0474833b5cb16ab960a8, https://si.imgix.net/3d79c772/uploads/origins/1b9e0842-1f32-4204-987f-91059f9c50e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1a02194b97e617964aec09883a13729 2x, https://si.imgix.net/3d79c772/uploads/origins/1b9e0842-1f32-4204-987f-91059f9c50e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45ebbc492a3894c104bf7f85b57ed5d0 3x", "genre": "art", "nsfw": true, "body": "以前描いてくださいました、\n「魔王を倒すために冒険していた魔法使いちゃんが魔王様に快楽落ちさせられる」シチュエーションの続きをお願いしたいと思います！\n\nリク概要\n・魔法使いちゃんが魔王様に犯されたことを忘れられず自ら魔王様に犯されに行く\n・魔法使いちゃんと魔王様とのラブラブセックスしてるシチュエーション\n・魔法使いちゃんは勇者を裏切ってしまった事を最初は葛藤しているけど、快楽に抗えず「勇者のより魔王様のほうがきもちい♥もう勇者なんてどうでもいい、魔王様愛しています」と最終的に完全に落ちてしまう。\n\n\n備考\n基本は着衣ックスでお願いします。\n可能であれば、完全に落ちてからは闇落ち（魔族落ち）しているようば描写をお願いします。（服装が黒っぽくなったりや、目が赤くなったりなど）", "created_at": "", "completed_at": ""}, {"path": "/@act_partner/works/84", "thumbnail_src": "https://si.imgix.net/392a6ecc/uploads/origins/af6a115b-2957-4237-a54f-6e48bca6c854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=636c19f63891c30ea666b5b83c19a928", "thumbnail_srcset": "https://si.imgix.net/392a6ecc/uploads/origins/af6a115b-2957-4237-a54f-6e48bca6c854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=636c19f63891c30ea666b5b83c19a928, https://si.imgix.net/392a6ecc/uploads/origins/af6a115b-2957-4237-a54f-6e48bca6c854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef1a6be20a20f6f679b6c3fda206ef9a 2x, https://si.imgix.net/392a6ecc/uploads/origins/af6a115b-2957-4237-a54f-6e48bca6c854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=334c5e2ec49319e43a10f6cc95ba7555 3x", "genre": "art", "nsfw": true, "body": "こんにちは！  \n\n私はオリジナルキャラクターのイラストをリクエストしたいと思います。  \n\nこちらで見ることができます： \n\nhttps://min.togetter.com/Uxmx3fD  \n\n興味があれば、描きたいキャラクターを自由に選んでください！  \n\nイラストの詳細はあなたに決めていただいて構いません。  \n\nどうもありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@act_partner/works/83", "thumbnail_src": "https://si.imgix.net/c205d3a5/uploads/origins/87e97b89-252c-43d8-b373-2a46d6f7f1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec9143e8e4c5d3247652003175f89181", "thumbnail_srcset": "https://si.imgix.net/c205d3a5/uploads/origins/87e97b89-252c-43d8-b373-2a46d6f7f1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec9143e8e4c5d3247652003175f89181, https://si.imgix.net/c205d3a5/uploads/origins/87e97b89-252c-43d8-b373-2a46d6f7f1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d1fa7806534845941d26698bd871142 2x, https://si.imgix.net/c205d3a5/uploads/origins/87e97b89-252c-43d8-b373-2a46d6f7f1d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78163f7fc449273c33bcf337db3787bf 3x", "genre": "art", "nsfw": true, "body": "Skeb再開お待ちしておりました！以前クロモちゃんのリクエストをお送りした者です。その節は大変お世話になりました。\n前回リクエスト時から今に至るまで、ロリだったりハロウィンだったり、色んなクロモちゃんを見れて滅茶苦茶嬉しかったです！あと、干し芋にてお送りしたプラモのコスしたクロモちゃんもありがとうございました！干し芋楽しんで頂けたなら幸いです！\n\nもしよろしければ今回も、クロモちゃんのNSFWイラストを描いて頂けないでしょうか？\n\n依頼内容\n・前回のキメセク輪姦の続き\n・キメセクで脳みそトロトロになったクロモちゃんが、今度は自分からも求めるようなる……的なシチュ\n・ロケーションも前回同様公衆トイレ(クロモちゃんがエッチに積極的になったので拘束は無くなり、個室から出て小便器のある広い方)\n・竿役も前回同様薄汚いおっさん\n・体位は片足上げ立ちバックをしつつ、お顔側は別の竿役にフェラ(雑ですが、構図の資料を添付してます)\n・竿を咥えると表情やお顔が見え辛くなるかと思いますので、竿や玉を舐めてるのでもOK\n・表情はクスリの影響で思考力が落ち、発情しているような感じ\n<細かい要望>\n・おクスリ追加で肘裏の注射痕も増量\n・全身のザーメンドロドロ具合も前回より増量\n・身体に卑猥な落書き(ヤった回数の正の字や、おまんこマークみたいな……褐色肌で見え辛いと思いますので、ぱるとねる様的にナシだと思われたならオミットしてください)\n・竿役、特にフェラ側のちんこを、チンカスが付いてる等汚めに描いて欲しいです。クロモちゃんもその臭いに発情してる感じでお願いします。\n・セリフとかもあれば嬉しいです！\n\nまた、金額的に可能でしたら、\n・挿入前\n・中出し、ぶっかけ\n・事後\n・ボテ腹(乳首黒ずみ、母乳)\nの差分も欲しいです。\n\n前回のキメセククロモちゃんが大変素晴らしかったので、その後もドロドロに犯されちゃう姿が見たいと思いリクエストさせて頂きました……！\n前回より指定も多く、ハードな内容になってしまい申し訳ございません。もし描写するのが難しい、ぱるとねる様的のポリシーに反する部分があればオミットしてください。\n「こういうのが見たい！」と書き殴った内容ですので、無理な点、クロモちゃんに似合わないと思う要素があれば、ぱるとねる様の裁量で改変等して頂ければと思います。\n何卒宜しくお願い致します…！\n\nhttps://imgur.com/a/HRyCKJx", "created_at": "", "completed_at": ""}, {"path": "/@act_partner/works/82", "thumbnail_src": "https://si.imgix.net/ba267536/uploads/origins/8e902d0d-188f-4279-bba2-7ec696f78dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26fa964aaf9787ce34ab723e43657f66", "thumbnail_srcset": "https://si.imgix.net/ba267536/uploads/origins/8e902d0d-188f-4279-bba2-7ec696f78dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26fa964aaf9787ce34ab723e43657f66, https://si.imgix.net/ba267536/uploads/origins/8e902d0d-188f-4279-bba2-7ec696f78dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e4707edd02555363d2eab22b219d1de 2x, https://si.imgix.net/ba267536/uploads/origins/8e902d0d-188f-4279-bba2-7ec696f78dc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86fe3aa7a48b98c3e221ead52500ec79 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。\n早速ですが、ぱるとねるさんちの子のクロモちゃんがとてもかわいくてえっちですので、セクシーランジェリー(エロ下着)を身に着けたクロモちゃんをリクエストいたします。\n\nセクシーランジェリーはクロモちゃんの豊満な乳房をしっかりと支えつつカップの真ん中に入った縦の切れ込みから乳首が覗くデカブラベースのオープンブラ・お揃いのデザインで切れ込みから性器が覗くオープンショーツといったエロに特化したものだと嬉しいです。\nセクシーランジェリーの色や細かいデザイン(フリル・レース・刺繍・アームカバー・ガーターベルト・ストッキングの有無等)、クロモちゃんのポーズ・表情などの細かい点はお任せします。\n第三者が関わる描写(本番行為等)は無いと嬉しいです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@act_partner/works/81", "thumbnail_src": "https://si.imgix.net/002c37b1/uploads/origins/7ff29169-9ef7-402f-b7a6-3719c51def76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27869e0597bf832dc71c3a8128d5c055", "thumbnail_srcset": "https://si.imgix.net/002c37b1/uploads/origins/7ff29169-9ef7-402f-b7a6-3719c51def76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27869e0597bf832dc71c3a8128d5c055, https://si.imgix.net/002c37b1/uploads/origins/7ff29169-9ef7-402f-b7a6-3719c51def76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e592fe1b697e921e6dd864693c037641 2x, https://si.imgix.net/002c37b1/uploads/origins/7ff29169-9ef7-402f-b7a6-3719c51def76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664a6ddedf56bae237205a3cbc86c814 3x", "genre": "art", "nsfw": true, "body": "こんにちは！https://skeb.jp/requests/2929717の依頼をさせて頂いた者です！\n大変良かったのでまた魔法使いちゃんと勇者のイラストを依頼させて頂こうと思います！\n\n前回同様、射精時の精液描写は多ければ多い程嬉しいです！\n場所は宿屋の一室でベッドの上でお願いします！\n\n1枚目：魔法使いは裸Yシャツとパンツ、https://www.pixiv.net/artworks/102842134のようなスパイダー騎乗位でズラし挿入\n朝、勇者が目覚めると魔法使いが甘々でエッチな笑顔で「おはようございます...♡」と言いながら積極的に腰を振ってる感じ\n差分は「上記の表情で突く・勇者が胸を揉む・乳首を弄る・射精前・大量中出し・さらに大量中出し・竿を抜き中だし事後」を可能な範囲でお願い致します\n中だし事後では逆流した大量の精液と精液まみれの竿をお願いします\n\n2枚目：1枚目の続き、体位はお任せで顔・胸・結合部が見える状態での甘々エッチ\n差分は「射精前・大量中出し・さらに大量中出し・竿が抜け魔法使いの顔や全身がドロドロになる程の超大量ぶっかけ・事後」を可能な範囲でお願い致します\n可能でしたら射精前に魔法使いの胸を揉んだり乳首にしゃぶりつく差分もお願いしたいです\n\n2枚共台詞や表情も差分毎にお任せで変わってると嬉しいです！\nアヘ顔オホ顔は無しでお願いします！\n\n金額が不十分でしたら再送して頂けたらお応え致します！\nよろしければご検討頂けますと幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@act_partner/works/80", "thumbnail_src": "https://si.imgix.net/f656a277/uploads/origins/3074cdee-3a42-488e-8b31-7ac366411eca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c83189cd251344943ad833fd202483c", "thumbnail_srcset": "https://si.imgix.net/f656a277/uploads/origins/3074cdee-3a42-488e-8b31-7ac366411eca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c83189cd251344943ad833fd202483c, https://si.imgix.net/f656a277/uploads/origins/3074cdee-3a42-488e-8b31-7ac366411eca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=126d2d0a83e986fb5749fc8c19e6e0eb 2x, https://si.imgix.net/f656a277/uploads/origins/3074cdee-3a42-488e-8b31-7ac366411eca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdade0d163bf574d32d12e48b0ea8053 3