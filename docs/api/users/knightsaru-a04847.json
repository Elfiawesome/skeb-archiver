c29-ad47-a445d4e7ec9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254886b8063ec4a4e4aaef0e285c353c", "thumbnail_srcset": "https://si.imgix.net/8314b704/uploads/origins/ea5bc12d-8ab5-4c29-ad47-a445d4e7ec9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=254886b8063ec4a4e4aaef0e285c353c, https://si.imgix.net/8314b704/uploads/origins/ea5bc12d-8ab5-4c29-ad47-a445d4e7ec9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1893b2e464090dfc4923fb4cabf48b0e 2x, https://si.imgix.net/8314b704/uploads/origins/ea5bc12d-8ab5-4c29-ad47-a445d4e7ec9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd8622f207e0bc79e24d7e3803e80880 3x", "genre": "art", "nsfw": false, "body": "初めまして\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の20歳位、\n純朴な感じのする黒髪女性のイラストをリクエストしたいです。\n髪型、表情、体型、ポーズ等はお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履きで、手には紺の農作業用の手甲をつけています。\n野良着の色は紺で絣模様、\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/wg5lyu8hc19bmf7ox91ll/si.png?rlkey=bqx1xzta6w4chhlusi4y5li7w&st=ifp4o0d9&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@knightsaru/works/1", "thumbnail_src": "https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f11bcd97d9c4e097431a1373f33fa1", "thumbnail_srcset": "https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f11bcd97d9c4e097431a1373f33fa1, https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3aed0e26036cf8ec42da57c90093ba2 2x, https://si.imgix.net/afb82190/uploads/origins/a011e87a-c95d-4b7a-b03a-136473ff5a3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b00b3b9038fa0f886ce2dc4626b14ce4 3x", "genre": "art", "nsfw": false, "body": "推しキャラを描いて頂きたく依頼しました。\n\nキャラクターは月姫の黒レン。\nhttps://dic.pixiv.net/a/%E9%BB%92%E3%83%AC%E3%83%B3\n\n衣装ですが、レンに色々着せてあげたいので、内藤猿さんのオリジナルで何か衣装を描いて頂けると嬉しいです\n\n構図などはお任せします\n\nどうぞよろしくお願いします。", "created_at": "", "completed_at": ""}]}