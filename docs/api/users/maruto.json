t=PRIVATE&s=c5c722cc3c8896c85813549b0862b9b3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/356", "thumbnail_src": "https://si.imgix.net/d32a1bb9/uploads/origins/2125ec73-b527-43fd-959b-d18df6732bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1411e05179ac24f6217902d344f8d053", "thumbnail_srcset": "https://si.imgix.net/d32a1bb9/uploads/origins/2125ec73-b527-43fd-959b-d18df6732bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1411e05179ac24f6217902d344f8d053, https://si.imgix.net/d32a1bb9/uploads/origins/2125ec73-b527-43fd-959b-d18df6732bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f64ffac12f422c152f144062db5f626 2x, https://si.imgix.net/d32a1bb9/uploads/origins/2125ec73-b527-43fd-959b-d18df6732bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27e2a9a97d0fdb71cec92d35595e39e7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/355", "thumbnail_src": "https://si.imgix.net/2c542f9c/uploads/origins/bbf3e763-5bb7-4a10-af30-274f4dbd5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45329030659b62bc198457c47087e2bb", "thumbnail_srcset": "https://si.imgix.net/2c542f9c/uploads/origins/bbf3e763-5bb7-4a10-af30-274f4dbd5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45329030659b62bc198457c47087e2bb, https://si.imgix.net/2c542f9c/uploads/origins/bbf3e763-5bb7-4a10-af30-274f4dbd5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee913ebc55caace57c8c75260c32bb57 2x, https://si.imgix.net/2c542f9c/uploads/origins/bbf3e763-5bb7-4a10-af30-274f4dbd5a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=085778cc8e3f93557ebf893bd9d2e0c9 3x", "genre": "art", "nsfw": true, "body": "こんにちは！この画像の続編をお願いします。\nhttps://skeb.jp/@maruto/works/320\nhttps://imgchest.com/p/lqye6l26z4d\n\nミミックから足とお尻を出しているが、上半身はすでに食べられている。足とお尻が外に出たままなので、抵抗できないので男か触手が露出したアソコを犯すことにする。", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/354", "thumbnail_src": "https://si.imgix.net/356703b4/uploads/origins/4eca57a9-fca9-4b10-b68b-255152542a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4044c2d1aa502af889be73918169c249", "thumbnail_srcset": "https://si.imgix.net/356703b4/uploads/origins/4eca57a9-fca9-4b10-b68b-255152542a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4044c2d1aa502af889be73918169c249, https://si.imgix.net/356703b4/uploads/origins/4eca57a9-fca9-4b10-b68b-255152542a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccb656b1c46bcc911913e80e2b8232a9 2x, https://si.imgix.net/356703b4/uploads/origins/4eca57a9-fca9-4b10-b68b-255152542a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d663b522d64bc8767172d178b9bca06 3x", "genre": "art", "nsfw": true, "body": "先生こんにちは、前回の抱き枕イラストを依頼した者です。\nいつも素敵なイラストの数々を楽しませていただいております。\n\n　今回も『zzz』の柚葉の個人利用抱き枕カバー用のイラストの制作お願いしたいです。\n添付の参照画像をご覧ください。\n（https://drive.google.com/drive/folders/1Nbt9wcKyfK4KdhO226G2ugFH0ojQajw_?usp=drive_link）\n　\nファイル\n・印刷サイズ　530 x 1630 mm\n・解像度　150〜300 dpi(250が理想、できれば範囲で大きく)\n・画像形式はPNG色はRGB\n\n設定\n・柚葉は妊娠している、臨月ぐらいお腹の大きさでお願いします。（https://drive.google.com/file/d/1XmDt5M34O3NGrb9sHLcuLLTlQGt5NGnl/view?usp=drive_link）前作と同じの様な感じ\n・服装は画像のような水着でお願いいたします。。\n・表情は笑顔表情でお願いします。\n\n　ポーズが前のような仰向けであればその他はすべて作者様自由に描いていただいても問題ありませんので、\nご負担をお掛けすると思いますが修正をお願いします。柚葉のボて腹を目立つ欲しいです。裸しない欲しいです。\n\n　以上の内容で色々要望が多く申し訳ございませんがどうぞよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/353", "thumbnail_src": "https://si.imgix.net/b5f187f9/uploads/origins/4de6b4c2-d477-4232-9b81-86034e4432d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891623fa75d12320df2093862d98cd2d", "thumbnail_srcset": "https://si.imgix.net/b5f187f9/uploads/origins/4de6b4c2-d477-4232-9b81-86034e4432d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891623fa75d12320df2093862d98cd2d, https://si.imgix.net/b5f187f9/uploads/origins/4de6b4c2-d477-4232-9b81-86034e4432d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b0ec860426fee2d8a7ba303d63be08e 2x, https://si.imgix.net/b5f187f9/uploads/origins/4de6b4c2-d477-4232-9b81-86034e4432d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ac2dd9d005ee011e8dea7a657428974 3x", "genre": "art", "nsfw": true, "body": "キャラクタールナ（『ファースト・ディセンダント』より\nhttps://imgchest.com/p/ej7mldzgj4d\nhttps://www.youtube.com/watch?v=RuKCQLL06UU\n\nポーズ：後背位\n\n歌って踊るのが大好きな元気キャラですが、トラブルメーカーで権力に弱いです。セックスは全裸でお願いします。お尻が大きいキャラなので、そこにも注目してほしいです。", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/352", "thumbnail_src": "https://si.imgix.net/78895771/uploads/origins/a30a3343-cc3d-41bb-9899-9ea7cbf30ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5972f90ab0afe64780cbff2cec55e7bf", "thumbnail_srcset": "https://si.imgix.net/78895771/uploads/origins/a30a3343-cc3d-41bb-9899-9ea7cbf30ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5972f90ab0afe64780cbff2cec55e7bf, https://si.imgix.net/78895771/uploads/origins/a30a3343-cc3d-41bb-9899-9ea7cbf30ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20f95f0f808db5e8d02ccf1263aea063 2x, https://si.imgix.net/78895771/uploads/origins/a30a3343-cc3d-41bb-9899-9ea7cbf30ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc80fe13102623340a0b28dd5d93a36a 3x", "genre": "art", "nsfw": true, "body": "やあ、丸藤！元気にしていることを願うよ！\n\n今回は2人のキャラクターを描いてほしい。キヌアとジノアという双子の姉妹です。2人の参考資料です：\n\nキヌア: https://i.imgur.com/664bygH.png\nジノア: https://i.imgur.com/mxLOXmx.png\n\nポーズについては、緑色の触手が両方を活かしているようにしたい。以前作っていただいた作品が好きなので、参考にさせていただきます。https://gelbooru.com/index.php?page=post&s=view&id=11591308&tags=maruto%21+\n\n二人とも全裸になります。一人は左のように背中を見せてもいいし、もう一人は右のようにあなたの作品のように正面を見せてもいい。どちらかに決めてください。両腕は背中に回して、きれいに乱れるようにしてください。あと、表情がやわらかくて、負けず嫌いな感じだとうれしいです。\n\nご検討ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/351", "thumbnail_src": "https://si.imgix.net/4339cd55/uploads/origins/8cea2947-ebb4-4bbe-bc42-5f8412d437fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11fb437b67a4113fbd429e39684eecfa", "thumbnail_srcset": "https://si.imgix.net/4339cd55/uploads/origins/8cea2947-ebb4-4bbe-bc42-5f8412d437fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11fb437b67a4113fbd429e39684eecfa, https://si.imgix.net/4339cd55/uploads/origins/8cea2947-ebb4-4bbe-bc42-5f8412d437fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0483263058850caff41ad3ad73dd5de1 2x, https://si.imgix.net/4339cd55/uploads/origins/8cea2947-ebb4-4bbe-bc42-5f8412d437fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d30b6d0a96b48e99815d89d8082ef725 3x", "genre": "art", "nsfw": true, "body": "前回のイラストありがとうございました！\nまた違うキャラクターでお願いしたいです。\n\nキャラクターマーキュリー（うちの子）\n身長：155cm\nシチュエーションダンジョンに出没し、自作のポーションを駆使して1つのダンジョンをクリアした。最後に開けた宝箱の中身はミミックで、触手でつかまれ、1時間セックスされた後、解放された。\n\n- ミミックがマーキュリーの中でイク代わりに卵を産んでくれたら大満足だが、その必要はない。\n- マーキュリーは長い時間の後、疲れて虚ろな目をしているはずだ。\n\nあとは先生のご判断にお任せします。\nご配慮ありがとうございました！\n-\n\nhttps://lensdump.com/a/K5jYr/?sort=date_asc&page=1", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/350", "thumbnail_src": "https://si.imgix.net/4113026d/uploads/origins/d904a0c9-c42b-4bfe-b725-ab76b6b5378d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=337e1fe0d8080c96cf08c7b1656aa97e", "thumbnail_srcset": "https://si.imgix.net/4113026d/uploads/origins/d904a0c9-c42b-4bfe-b725-ab76b6b5378d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=337e1fe0d8080c96cf08c7b1656aa97e, https://si.imgix.net/4113026d/uploads/origins/d904a0c9-c42b-4bfe-b725-ab76b6b5378d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8eaa0cd4dee28923d22087deb1de710c 2x, https://si.imgix.net/4113026d/uploads/origins/d904a0c9-c42b-4bfe-b725-ab76b6b5378d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d04dd41d2962b1ebde92e8a4dbdd90c 3x", "genre": "art", "nsfw": true, "body": "こんにちは！  アピールしてくれてありがとう！\n\n私のフタナリ狼少女、ナタネを描いてほしい。\nナタネちゃんの服装は、大きなおっぱいの間に大きなおちんちんを隠して、セルフパイズリで自分のおっぱいを犯しています。  彼女のペニスは胸の谷間からほんの少しはみ出しているはずだ。\nナタネは最初、快感を無視しようとしているはずだ。  彼女の腕はわずかに胸を押し、その間に挟まれたペニスを圧迫している。\nやがて彼女は屈服し、セルフ・パイズリを楽しみ、最終的にはかなりイキ、顔や体に飛び散るはずだ。\nできれば、同じ体位で彼女がヌードになる別バージョンも欲しい。\nそれ以外はお任せします！\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1D50oog2YNcURT7tLmHOZsxh6u9jmQB8k?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/349", "thumbnail_src": "https://si.imgix.net/ec88788f/uploads/origins/de0dc5e1-4730-4663-8be8-2585dd464812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0ef6e7c6b8606d35a1138e2e6afdc7", "thumbnail_srcset": "https://si.imgix.net/ec88788f/uploads/origins/de0dc5e1-4730-4663-8be8-2585dd464812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa0ef6e7c6b8606d35a1138e2e6afdc7, https://si.imgix.net/ec88788f/uploads/origins/de0dc5e1-4730-4663-8be8-2585dd464812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28894409ae006ee4de0606945474d759 2x, https://si.imgix.net/ec88788f/uploads/origins/de0dc5e1-4730-4663-8be8-2585dd464812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14d13dad31ff31cf41666560b6558574 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nうちのこのifバージョンをmarutoさんのお描きするイラストで見てみたいと思い、ご依頼させていただきたく思います。\n\n■シチュエーション\n悪堕ちしたうちのこが発情しながらえっちするよう誘惑してくるイラストをお願いします！\n\n■ポーズや構図について\nうちのこが下記URLのようなポーズやエロ鋸で胸を揉みながら秘部を広げて（くぱぁして）いる感じでお願いします！\n下記URLの構図（アングル）のようなイメージか、エロ鋸でローアングルのイメージでお願いします。\nhttps://skeb.jp/@maruto/works/66\n\n■うちのこ（悪堕ちの詳細）や服装について\n＜悪堕ち＞\nmarutoさんにいつも描いていただいているうちのこで、下記をお願いします。\n・髪と瞳の色が変化\n・胸の巨乳化（いつもより大きくても大丈夫です）＋母乳が出ている\n・腹部に淫紋\n※肌の色の変化や魔族のような翼や角といった変化は不要です。上記3点のみの変化でお願いします。\n\n＜服装＞\nカレテラヴィントでお願いします。大変な場合は全裸でも大丈夫です。\n衣装をお描きいただける場合はいつも通り胸と秘部は見えるようにお願いいたします。\n悪堕ちした影響で、ヘッドアクセサリやタイの色が変化しているイメージです。\n\n悪堕ちイメージのカラーは下記URLとなります。\nhttps://www.pixiv.net/artworks/132298770\n※ヘッドアクセサリとタイの色が異なっていますが統一してもらって大丈夫です。\nイメージなので、色合いはmarutoさんにお任せいたします。\n※フリー素材などの淫紋とかの色合いが近いかもしれません。下記のURLの方とかのイメージです。\nhttps://www.pixiv.net/artworks/99147687\n\n■その他\nもし可能でしたらおしっこしている差分母乳の有無差分もあると嬉しいです！\n宛名はレイヤー別にしていただけると嬉しいです。統合前での納品もOKです。\n\n■キャラクター\n・白峰桜夜（いつも依頼している子です）\nhttps://www.pixiv.net/artworks/93250852\n\n要望が多く申し訳ございません。もし可能でしたらぜひお受けいただきたく思います。\nmaruto!さんの描くうちの子が大好きでまたご依頼させていただきました。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@maruto/works/348", "thumbnail_src": "https://si.imgix.net/f1613f5c/uploads/origins/491cdfd9-e52a-4bcb-a41c-1e77d0b82e3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b424f0d6d3ef0e92f6a571e4b9d868db", "thumbnail_srcset": "https://si.imgix.net/f1613f5c/uploads/origins/491cdfd9-e52a-4bcb-a41c-1e77d0b82e3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b424f0d6d3ef0e92f6a571e4b9d868db, https://si.imgix.net/f1613f5c/uploads/origins/491cdfd9-e52a-4bcb-a41c-1e77d0b82e3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=423e53b18f67fc5f5fcd16431d3f0d3a 2x, https://si.imgix.net/f1613f5c/uploads/origins/491cdfd9-e52a-4bcb-a41c-1e77d0b82e3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=2