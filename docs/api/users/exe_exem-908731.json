b09d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a0d5e749a0cdd364cd30ee18541b182 2x, https://si.imgix.net/bb7f4ce5/uploads/origins/dd27a081-0b13-4dd3-ba25-ee33e89db09d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=051b53092ae2a07e54e4187f0ad89012 3x", "genre": "art", "nsfw": true, "body": "私のocがベッドの上で横たわっているのを見たい、彼の体の赤い部分が光って、頭の赤い部分は火のように揺れて、彼が勃起する時亀頭はすべて現れて、色は体の赤色と同じで、彼の屁の目の外部は体の色に近い深い黒色で、内部は体の赤色と同じです。私のocアドレスです：https://x.com/Earth_Garon23/status/1890015898121232475\n参考画像:https://e621.net/posts/5129156?q=thezestiestbone", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/44", "thumbnail_src": "https://si.imgix.net/ec4c7617/uploads/origins/df340ce1-e7f0-41e9-907a-36169d0791e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d984a04a1c0d53892fc579a46149fa62", "thumbnail_srcset": "https://si.imgix.net/ec4c7617/uploads/origins/df340ce1-e7f0-41e9-907a-36169d0791e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d984a04a1c0d53892fc579a46149fa62, https://si.imgix.net/ec4c7617/uploads/origins/df340ce1-e7f0-41e9-907a-36169d0791e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4947ae015937d4476bc734ba305af9e1 2x, https://si.imgix.net/ec4c7617/uploads/origins/df340ce1-e7f0-41e9-907a-36169d0791e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba8a76e24b000708d4441141884bdc05 3x", "genre": "art", "nsfw": true, "body": "エクゼさんこんにちは！いつも沢山のイラスト楽しく拝見しております！\nご依頼したいと思って今回リクエスト送らせていただきますので、可能であれば受けていただければ嬉しいです…！\n\nエクゼさんの以前Twitterで描かれていたシノさんのvoreイラストを改めて描いてもらえれば嬉しいです！雄っぱいと腹筋と胃袋の中を出来ればお願いします…！\n\nhttps://x.com/exe_exem/status/1679326343711039488?t=_WJiEoRG3U1jfpU2j9PRxQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/43", "thumbnail_src": "https://si.imgix.net/efed7008/uploads/origins/c3701034-840d-40c8-b77e-cd15ea4c9bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac19d58baec148b24181f72c32c8e322", "thumbnail_srcset": "https://si.imgix.net/efed7008/uploads/origins/c3701034-840d-40c8-b77e-cd15ea4c9bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac19d58baec148b24181f72c32c8e322, https://si.imgix.net/efed7008/uploads/origins/c3701034-840d-40c8-b77e-cd15ea4c9bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ea8d3c83edb022014aed4a8398ec4a6 2x, https://si.imgix.net/efed7008/uploads/origins/c3701034-840d-40c8-b77e-cd15ea4c9bd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5255e3dcf459b2614a7950de87af734f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/42", "thumbnail_src": "https://si.imgix.net/dd539923/uploads/origins/d3a4450d-0268-4ec6-bc0b-d135df04bab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e36bfcfbb747fe79893400b43e2255fd", "thumbnail_srcset": "https://si.imgix.net/dd539923/uploads/origins/d3a4450d-0268-4ec6-bc0b-d135df04bab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e36bfcfbb747fe79893400b43e2255fd, https://si.imgix.net/dd539923/uploads/origins/d3a4450d-0268-4ec6-bc0b-d135df04bab3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a49693e3378e529f1152e4fe7cfa571 2x, https://si.imgix.net/dd539923/uploads/origins/d3a4450d-0268-4ec6-bc0b-d135df04bab3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=591093a4631b9fff173d0c9edf5bbc9c 3x", "genre": "art", "nsfw": true, "body": "申し訳ありません、語弊が生じるとの事だったので一度依頼を取消しまた新たにリクエストを送らせて貰います。\n黒いエナメルロンググローブとエナメルロングブーツのボンテージファッションに、テカテカとした大きな乳首には金のリングを、\n大きくてイボイボの入った黒魔羅の根元には金のリングを身に着けた、恥部を曝け出した格好の淫魔チェルノボーグが、\n見せ付ける様に自身の大きな乳首を執拗に弄り、黒竿から種汁をドピュッ…トロォ…と湧き水の様に放ち、激しい快感に襲われ淫らに喘ぎ悶えたい所を何とか抑えて、目尻に涙を浮かべて口の端から唾液が垂れつつも余裕を装い此方を挑発してくる、という内容でイラストをリクエスト致します。", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/41", "thumbnail_src": "https://si.imgix.net/ea7e5601/uploads/origins/64306700-f0ae-425e-adba-dfc07f0daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc65c338c68b0665bf75ce678077be8f", "thumbnail_srcset": "https://si.imgix.net/ea7e5601/uploads/origins/64306700-f0ae-425e-adba-dfc07f0daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc65c338c68b0665bf75ce678077be8f, https://si.imgix.net/ea7e5601/uploads/origins/64306700-f0ae-425e-adba-dfc07f0daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ded450f0951bacc8481d5afcfacbdb90 2x, https://si.imgix.net/ea7e5601/uploads/origins/64306700-f0ae-425e-adba-dfc07f0daf0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a46eb075ccfbbbc6f760456aacab8d55 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nfgoの超人オリオンの肥満化シーケンスを描いてほしいです。\n通常(鍛えた肉体に自信)、もうガチムチとは呼べないデブ(かなり太ってきた焦り)、立ち上がるのが精いっぱいな巨デブ(狩人とは思えない体に羞恥)の3段階でお願いします。\n顔や首、脚など、全身にまんべんなく肉を盛っていってほしいです。2段階目はきついのに無理やり肩から斜めにかけたベルトが胸の間や下に食い込んでいたりすると嬉しいですが、衣装なしでも嬉しいです。3段階とも背を向けないポーズでお願いします。\n受けてもらえたらとても喜びます。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/40", "thumbnail_src": "https://si.imgix.net/ebaffa4c/uploads/origins/fb6df0e4-0adc-4470-a37f-34e9caba97de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=224d141fee43fd546ee1552819936b89", "thumbnail_srcset": "https://si.imgix.net/ebaffa4c/uploads/origins/fb6df0e4-0adc-4470-a37f-34e9caba97de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=224d141fee43fd546ee1552819936b89, https://si.imgix.net/ebaffa4c/uploads/origins/fb6df0e4-0adc-4470-a37f-34e9caba97de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21dff3e41674dde8e29da4b6875fa55b 2x, https://si.imgix.net/ebaffa4c/uploads/origins/fb6df0e4-0adc-4470-a37f-34e9caba97de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f276613366ca5af19e936ac28406db5c 3x", "genre": "art", "nsfw": false, "body": "エクゼさんこんにちは！私の設定を描いて欲しい。\n白熊、眼鏡をかけて、頭に十字の傷跡がある，四本指\n\n具体的な服装、動作、そしてシーンはエクゼさんに決めてもらうといいですね！\n\n\n参考：\nhttps://skeb.jp/@hinami0506/works/12\nhttps://skeb.jp/@hinami0506/works/18", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/39", "thumbnail_src": "https://si.imgix.net/27aeafe1/uploads/origins/8d9ec59c-be7f-4f06-be7b-f76b6e192d16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3e201ac84ff614f4b787406cea37b1", "thumbnail_srcset": "https://si.imgix.net/27aeafe1/uploads/origins/8d9ec59c-be7f-4f06-be7b-f76b6e192d16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3e201ac84ff614f4b787406cea37b1, https://si.imgix.net/27aeafe1/uploads/origins/8d9ec59c-be7f-4f06-be7b-f76b6e192d16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbe6d97bf69a40c922f2979b9554731c 2x, https://si.imgix.net/27aeafe1/uploads/origins/8d9ec59c-be7f-4f06-be7b-f76b6e192d16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f20efda01d805de8820b26fafe7cd09f 3x", "genre": "art", "nsfw": false, "body": "足を組んで椅子か何かに腰を下ろして少し見下ろす、上総などで描かれていた構図\n威圧感と重量感が強く感じられて、すごく好きです。\n\n左の足裏をわざとらしく見せつけてニヤニヤするmacroライオンギルマスで\n同じ構図を描いてくれませんか？（巨大感を増すために角度をもっと付けてもらってもOK）\n\nギルド職員衣装に、左足だけ靴も靴下も脱いだナマ足。\n足元では、背丈が足指ぐらいサイズのシルエット人間が、ギルマスに向けて踏んでくれと片手を大きく振っている。", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/38", "thumbnail_src": "https://si.imgix.net/20bd1742/uploads/origins/8133311e-a8ae-43d0-909b-f8cabf8cbf75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62b3590d3b54b3d6a3ee138e5db8640", "thumbnail_srcset": "https://si.imgix.net/20bd1742/uploads/origins/8133311e-a8ae-43d0-909b-f8cabf8cbf75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62b3590d3b54b3d6a3ee138e5db8640, https://si.imgix.net/20bd1742/uploads/origins/8133311e-a8ae-43d0-909b-f8cabf8cbf75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31b43b059c7b51f31c26b57cfb548349 2x, https://si.imgix.net/20bd1742/uploads/origins/8133311e-a8ae-43d0-909b-f8cabf8cbf75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e4249b4e7f1ea6b4fb92a471849cf0a 3x", "genre": "art", "nsfw": true, "body": "拙作のキャラクター「ランドグリズリー」をデザインください。\n元はずんぐり体型の熊獣人が怪人に変貌した姿。\n筋肉と脂肪が膨張して、体は２周りほど大きくなっており、爪は鋭く伸び、牙はギザギザと存在感を増していき、攻撃と破壊に特化した姿へ変わっていく。\nかつて向日葵の様に黄色く明るかった瞳は澱んだ黄土色へ。\n毛皮は黄色みがかった焦げ茶色。\n主人であるイビルフロッグと同様に、右肩にタイラント帝国の紋章が、左胸には蛙頭のマークが焼印として刻まれている。蛙頭のマークの下には怪人管理番号「ＢＭ−１８Ｇ」が焼印として刻まれている。\n構図は③全体図を希望。\n焼印デザインは資料小説の挿絵右上参照。\n\nhttps://www.pixiv.net/novel/show.php?id=21887972", "created_at": "", "completed_at": ""}, {"path": "/@exe_exem/works/37", "thumbnail_src": "https://si.imgix.net/a463179e/uploads/origins/f4fd2314-14eb-4eef-9d87-3114a22c8bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42cd70e0dcd5af5f35b653f264fdd366", "thumbnail_srcset": "https://si.imgix.net/a463179e/uploads/origins/f4fd2314-14eb-4eef-9d87-3114a22c8bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42cd70e0dcd5af5f35b653f264fdd366, https://si.imgix.net/a463179e/uploads/origins/f4fd2314-14eb-4eef-9d87-3114a22c8bee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PR