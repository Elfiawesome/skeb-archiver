de4-c07c299a7ba6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a3faebb257d2221444a4b4a4317a808 2x, https://si.imgix.net/4a937bac/uploads/origins/edb9c15a-7810-461c-9de4-c07c299a7ba6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=70633d079e129429d21e333be87f0380 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは、先生の画風は私には超可愛いです、とても大好きです、ocのイラストをお願いできればと思います、特別な条件はありません、ただ活発で可愛いです、ocの設定はとても気になります、どうぞお気軽にお試しください、どうもありがとうございました💗！\n\nhttps://drive.google.com/file/d/12MiWChFZFcLACF6AdzA8FpjliTy00D8e/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nippokotarou/works/11", "thumbnail_src": "https://si.imgix.net/bd3c846f/uploads/origins/d8869a7e-b2d9-4e87-a5ea-74f430cc89bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd19936b53435f6fe3fc2b511a691012", "thumbnail_srcset": "https://si.imgix.net/bd3c846f/uploads/origins/d8869a7e-b2d9-4e87-a5ea-74f430cc89bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd19936b53435f6fe3fc2b511a691012, https://si.imgix.net/bd3c846f/uploads/origins/d8869a7e-b2d9-4e87-a5ea-74f430cc89bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e8c9b5864696be735a3463769392f58 2x, https://si.imgix.net/bd3c846f/uploads/origins/d8869a7e-b2d9-4e87-a5ea-74f430cc89bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51d7bb6d92424cff5b1f1ba84bc2c2cb 3x", "genre": "art", "nsfw": false, "body": "にっぽこたろうさんおはようございます！\n\n先日描いてくださったリクエストがとても気に入ったので、よろしければもう一度お申し込みしたいです。\nテーマとか内容はおまかせでお願いしたいです。\nよろしくお願いします。\n\n▽キャラクター資料\nリユ\n指は4本、足の指は3本でお願いします。\nうちの子かかけている手錠とか首輪は描かなくてもいいです。\n(状況によって自由に描いてください。構図やスタイルによっては翼を簡単に描いても大丈夫です。)\nhttps://drive.google.com/drive/folders/143cDiocWfSb0dbFLZjLVluX1rKrOOMqi?usp=drive_link\n\n▽使用用途\n個人鑑賞および友人への共有\nSNSへの投稿やヘッダー・アイコンとしての使用（使用時には作家様のお名前やIDを記載いたします）\n個人使用の範囲内でのグッズ制作（商用利用は絶対に行いません）", "created_at": "", "completed_at": ""}, {"path": "/@nippokotarou/works/10", "