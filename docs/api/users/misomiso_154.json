t": 36000, "recorded_at": "2026-03-04T14:02:44.150042+00:00"}, {"amount": 26000, "recorded_at": "2026-03-05T05:50:51.004364+00:00"}, {"amount": 30000, "recorded_at": "2026-03-07T13:44:19.663333+00:00"}, {"amount": 16000, "recorded_at": "2026-03-08T01:29:36.227542+00:00"}, {"amount": 34000, "recorded_at": "2026-03-08T23:09:20.599444+00:00"}, {"amount": 30000, "recorded_at": "2026-03-10T07:29:52.912083+00:00"}, {"amount": 33000, "recorded_at": "2026-03-11T02:26:40.154636+00:00"}, {"amount": 26000, "recorded_at": "2026-03-12T00:28:35.686393+00:00"}]}, "current_prices": {"art": 26000}, "price_range": {"art": {"min": 14000, "max": 36000}}, "links": [{"label": "Twitter", "url": "https://x.com/misomiso_154", "name": "misomiso_154"}, {"label": "Misskey_io", "url": "https://misskey.io/@misomiso_154", "name": "misomiso_154"}, {"label": "Website", "url": "https://x.gd/n4UzH", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/5546161", "name": "5546161"}, {"label": "Fanbox", "url": "https://misomiso154.fanbox.cc", "name": "misomiso154"}], "flags": {"from_archive": true}, "works": [{"path": "/@misomiso_154/works/387", "thumbnail_src": "https://si.imgix.net/7f3fdb94/uploads/origins/086c4d5d-f6bd-4b18-86bf-726f8c1ef6fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f54ad65331763067e60337e8dc279da3", "thumbnail_srcset": "https://si.imgix.net/7f3fdb94/uploads/origins/086c4d5d-f6bd-4b18-86bf-726f8c1ef6fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f54ad65331763067e60337e8dc279da3, https://si.imgix.net/7f3fdb94/uploads/origins/086c4d5d-f6bd-4b18-86bf-726f8c1ef6fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=780cc0a19c752c4029023335a4b29130 2x, https://si.imgix.net/7f3fdb94/uploads/origins/086c4d5d-f6bd-4b18-86bf-726f8c1ef6fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7083dab35c5e0e3b5be8203b2797e1c 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\n差し支え無ければまたリクエストしたくよろしくお願いいたします。\n\n〇概要\nブルアカより宇沢レイサ(マジカル)が、\n両手に茎4P乱交の末に孕まされるイメージのイラストをお願いします。\n\n●イラストの構図/レイアウトに関する希望\n\n・両手に茎4Pセックスは以前に描いていただいた氷上スミレさん4Pのイラストと同じ状態をお願いしたいです。\n\n・ヒロインは前回のスミレさん同様に、頭頂から足先まで全身が映っている状態をお願いします。\n　ヘイローは映っていてもいなくてもどちらでも大丈夫です。\n\n・コスチュームを着衣状態でコスチュームを脱がされたり破られたりしていない状態をお願いします。\n　また、性器の結合部はスカートがめくれて丸見えの状態をお願いします。\n\n・足部は縞パンストを履いているデザインで、\n　パンスト股間部周辺を破かれてその下の可愛らしいリボンが付いたパンティを\n　ずらし挿入されている状態を希望させてください。\n　縞パンストのイメージ：https://www.pixiv.net/artworks/138531506\n\n・不潔なトイレで少しコスチュームが汚れた状態でのシチュを希望させてください。\n\n●差分希望\n　上記の構図で以下の5描写をお願いします。\n\n　①（チ〇ポへの）驚きと羞恥が混じった不安そうな表情をしている。\n\n　②目を上に剥いたアヘ目で、「いー」の口で必死に歯を食いしばっている。\n\n　③大きく口を開け、目を見開いて絶叫する。\n　　（この時の瞳もハイライトを付けていただけるとありがたいです）\n　　同時に男達は中出し＋全身に精液をぶっかけられて全身黄ばんだ汚らしいザーメンにまみれている。\n\n　④全身ザーメンにまみれた状態で、ハイライトが消えたレ〇プ目の絶望しきった表情をしている。\n\n　⑤（数か月後、快楽に堕ちた状態）宇沢レイサらしいドヤ顔笑顔で、\n　　性処理便器として4Pセックスで奉仕している。\n　　ヒロインはコスチュームを着衣状態のまま、\n　　風船やドームのようにパンパンにお腹が膨れた臨月ボテ腹になっている。\n　　上記ボテ腹表現は、氷上スミレさんのイラストと同じように表現いただきたいです。\n\nお手数をおかけして申し訳ありませんが、\nご検討をしていただけると幸いです。\n\nhttps://www.dropbox.com/scl/fo/a0vim1b3k8j7o61fpqhvi/AO2-5KghMuv6WRxm_zDwTxo?rlkey=gnobts27vlazyqev5ssqilj4n&st=9s3lbrxn&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@misomiso_154/works/386", "thumbnail_src": "https://si.imgix.net/ddd6d27c/uploads/origins/bab06110-bb5b-45bd-9930-cb668246390d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caa88e89455db12ab145fdb3a8161d3d", "thumbnail_srcset": "https://si.imgix.net/ddd6d27c/uploads/origins/bab06110-bb5b-45bd-9930-cb668246390d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caa88e89455db12ab145fdb3a8161d3d, https://si.imgix.net/ddd6d27c/uploads/origins/bab06110-bb5b-45bd-9930-cb668246390d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a20647ec56eb2beab50d9bf1ce527e6 2x, https://si.imgix.net/ddd6d27c/uploads/origins/bab06110-bb5b-45bd-9930-cb668246390d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bcad2e67255db7c1837d268c35e9fa6 3x", "genre": "art", "nsfw": true, "body": "以前はとても素晴らしいイラストありがとうございました。\n今回久しぶりにお願いしたいです。\n\nキャラ：ミリオンライブから七尾百合子\n\nシチュエーション：Pと百合子以外帰った誰もいない劇場のドレスアップルームでソファーに寝かされて、手繋ぎ状態で正常位でイチャラブえっち（Pの左手は胸揉み状態で百合子の右手はPの手首を軽く握ってる状態）\n　　百合子は気持ちよさそうで、Pと繋がってることが嬉しそうな表情だったら嬉しいです。\n\n服装：ミリシタの衣装「6th・プレシャスボックス」っぽい衣装\n（参照：https://www.pixiv.net/artworks/117012819　参照２：https://www.pixiv.net/artworks/120216545）\n　　　で、胸元は下にずらされて胸が見える状態、下着は薄ピンクでブラは上にずらされ、ショーツはクロッチ部分だけ横にずらされた状態。\n\n\nその他：Pは細身色白。\n　　　　射精後差分にずらされてたショーツのクロッチ部分が元に戻って精液で滲んでる感じのものが別であったら嬉しいです。金額足りなければ多少増やしてもらって大丈夫です。\n\n以上です。\n\n（※百合子はTeam 3rdなのでその衣装着たことは無いですけど、昴の衣装をまつりに着させられたという体ということで…w、百合子も着たら似合いそう）", "created_at": "", "completed_at": ""}, {"path": "/@misomiso_154/works/385", "thumbnail_src": "https://si.imgix.net/753e6aa6/uploads/origins/bd96c29a-f162-42e0-9dd9-41d171240e68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f71efe798e914375878878d993811ac6", "thumbnail_srcset": "https://si.imgix.net/753e6aa6/uploads/origins/bd96c29a-f162-42e0-9dd9-41d171240e68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f71efe798e914375878878d993811ac6, https://si.imgix.net/753e6aa6/uploads/origins/bd96c29a-f162-42e0-9dd9-41d171240e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a40a34678a9c9661b88735aa143727d 2x, https://si.imgix.net/753e6aa6/uploads/origins/bd96c29a-f162-42e0-9dd9-41d171240e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72f27f3d260ba42b7e6d29c099d5bf6f 3x", "genre": "art", "nsfw": true, "body": "おはようございます。\n『ブルーアーカイブ』より桜井ミヨをお願いします。\n\n・ミヨは両手でお尻側のスカートをめくり上げた構図\n・先生はミヨの背後から片手で胸を揉み\n・片手で膣を指で拡げクリトリスを愛撫\n・足元には潮や愛液で水溜まりを作っている。\n\nhttps://bluearchive.wikiru.jp/?%E3%83%9F%E3%83%A8\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@misomiso_154/works/384", "thumbnail_src": "https://si.imgix.net/a2a6f915/uploads/origins/a27956e3-1c5e-449e-9553-474c76be36b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ed269073f5599d38cda8ab96915c684", "thumbnail_srcset": "https://si.imgix.net/a2a6f915/uploads/origins/a27956e3-1c5e-449e-9553-474c76be36b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ed269073f5599d38cda8ab96915c684, https://si.imgix.net/a2a6f915/uploads/origins/a27956e3-1c5e-449e-9553-474c76be36b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d32d8fb268f2aa2ab25d2f2a63e9b07b 2x, https://si.imgix.net/a2a6f915/uploads/origins/a27956e3-1c5e-449e-9553-474c76be36b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1daf23def7ba31dfcd59681410f5e9fb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@misomiso_154/works/383", "thumbnail_src": "https://si.imgix.net/47dc4f25/uploads/origins/234f2890-94cb-4b5a-af8f-cf9e7eef70d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbad032781fabe10c3c478a0852eae88", "thumbnail_srcset": "https://si.imgix.net/47dc4f25/uploads/origins/234f2890-94cb-4b5a-af8f-cf9e7eef70d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbad032781fabe10c3c478a0852eae88, https://si.imgix.net/47dc4f25/uploads/origins/234f2890-94cb-4b5a-af8f-cf9e7eef70d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b73032476e007bbcaccf0c7fb0db46f 2x, https://si.imgix.net/47dc4f25/uploads/origins/234f2890-94cb-4b5a-af8f-cf9e7eef70d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70c17d0ce5b55baedd3c7403b7b4b570 3x", "genre": "art", "nsfw": true, "body": "またこんにちは。エルソードのノブレスとして登場するルシエラ・R・サワークリームの着衣セックスシーンを描いていただけないでしょうか。服は着たままにすることが強く希望ですが、トップスは脱がせても構いません。彼女の胸はAAカップで、ほぼ平らです。\n\nキャラクターの参考画像は以下です：https://photos.app.goo.gl/1kHN19ZfptaRcAcg6https://www.pixiv.net/artworks/131112330https://www.pixiv.net/artworks/134248028\n\nポーズとカメラアングルの参考はこちら：https://www.pixiv.net/artworks/130040648以下の表情も追加していただけると嬉しいです：https://ibb.co/8g6g2c3whttps://ibb.co/1tv1DSSHご検討いただきありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@misomiso_154/works/382", "thumbnail_src": "https://si.imgix.net/d43372cd/uploads/origins/2aee5cfc-ab0f-4f80-a621-f1252a7f2e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24f89dc621b0b7ea7b156d36826c0ff0", "thumbnail_srcset": "https://si.imgix.net/d43372cd/uploads/origins/2aee5cfc-ab0f-4f80-a621-f1252a7f2e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24f89dc621b0b7ea7b156d36826c0ff0, https://si.imgix.net/d43372cd/uploads/origins/2aee5cfc-ab0f-4f80-a621-f1252a7f2e16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6aaf076330e955349072f54941512f6 2x, https://si.imgix.net/d43372cd/uploads/origins/2aee5cfc-ab0f-4f80-a621-f1252a7f2e16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09c3d40ac2729f328b5e1e06301c29db 3x", "genre": "art", "nsfw": true, "body": "期限超過となった以下ですが再依頼可能でしょうか？ \n以前描かれてたドレス姿のアルバコア(https://x.com/misomiso_154/status/1269569793452945408)がとても良かったので、なるべくこちらの絵柄で以下のハードなのをお願いしたいです。  \n\n▪️キャラ \nアルバコア(ミッション•アカンプリス) https://x.com/azurlane_staff/status/1265110649085911043 \n・なるべく着衣でハイヒール履いたまま。  ハイヒールは資料のようにかなり高くつま先立ち\n\n▪️シチュエーション \nパーティ後に行きずりの男達と乱暴され拘束乱交セックス\n •拘束は鎖付きの首輪、後ろ手にアームバインダー等 \n・竿役との体格差や竿は大きい \n・できれば立ちバック \n\n▪️構図 \n・片足の履いてるハイヒール(特にヒール部分)まではっきり見える \n・竿の挿入は深めで僅かに見えるくらい \n\n▪️台詞 「色んな男の人達とセックスだーいすき♡」、「首輪奴隷みたい〜」、「拘束キツくて気持ち良いっ、子供のハイヒールに興奮しちゃったの〜？」みたいなマゾビッチな台詞をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@misomiso_154/works/381", "thumbnail_src": "https://si.imgix.net/543e7b14/uploads/origins/84db652c-3a75-46b1-8ce9-4227ec08d568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eae31b96389e363b28648aa2adc0897", "thumbnail_srcset": "https://si.imgix.net/543e7b14/uploads/origins/84db652c-3a75-46b1-8ce9-4227ec08d568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eae31b96389e363b28648aa2adc0897, https://si.imgix.net/543e7b14/uploads/origins/84db652c-3a75-46b1-8ce9-4227ec08d568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eabd26d780b06909092d6443bb2f12e 2x, https://si.imgix.net/543e7b14/uploads/origins/84db652c-3a75-46b1-8ce9-4227ec08d568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bfc3f78a8bd763fe16b26d4fc33e2fc 3x", "genre": "art", "nsfw": true, "body": "ご依頼失礼いたします\n前回は『神戸小鳥』のイラストの程、ありがとうございました\n今回は直近でみそ様が描かれたこちらのイラスト（https://skeb.jp/@misomiso_154/works/370）の構図がとても自分に刺さり、もし可能であれば下記キャラverにてご依頼したくリクエストさせていただきました\nよろしければご検討いただけますと幸いです\n\n■キャラ：能美クドリャフカ（リトルバスターズ）\n■シチュ：陵辱・女の子の手首を掴んでの立ちバック\nこちらのイラスト（https://skeb.jp/@misomiso_154/works/370）と似た構図でお願いできますでしょうか\nその際、合わせてお願いしたい点は下記になります\n\n・服装は水着メイド風\n水着メイドの装飾については細かく希望はございません\n上記の構図希望のイラストと同じような衣装でも全く問題なく、『水着メイド風』な衣装でありましたらそれだけで大変助かります。\n(一応ご参考として『ショコラ メイド水着 フィギュア』とご検索していただいた際に出てくるフィギュアの衣装がクライアントがイメージしている衣装のひとつになります)\n\nまた衣装の上は胸がはだけられ、下は脱がされて太ももあたりに残っている状態だとありがたいです\n\n・ハイヒール＋つま先立ち\n靴の部分はハイヒールのサンダル＆両足ともつま先立ちの描写をお願いできますでしょうか\n（こちらも上記希望イラストのサンダルと同じような形でしたら最高でございます）\n\n・女の子は足をピンと伸ばした立ち方\n上記希望イラストより足幅を狭くして、若干足が揃っている状態＋足をピンと伸ばした立ち方にて描写をお願いできますでしょうか\n\n■差分\nご面倒おかけいたしますが、下記のような差分をお願いできますでしょうか\n・乳首に男が吸いついている描写（立ちバックしている男とは別で）\n・乳首から唾液が垂れている描写（この時胸に吸い付いている男の描写はなし）\n\n〇表情\n・小さく口を開けて涙目（視線は背後の男の方）\n・目と口を閉じて耐えている表情\n・口を開けてイっている表情\n・眉をひそめて涙目＆細目のレイ〇目\n\n〇精液\n・射精\n・事後：顔、胸、髪、太ももから精液が垂れている状態\n（何時間もレイプされた後のような状態）\n\nご面倒おかけいたしますがご検討の程、何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@misomiso_154/works/380", "thumbnail_src