ddle%2Ccenter&txtsize=30&txt=PRIVATE&s=48fb3458bcd11199046318d25b1aa8d7", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@skunfan/works/28", "thumbnail_src": "https://si.imgix.net/81f68d12/uploads/origins/27f5ae4b-8d29-4986-b163-8fce6b3a3909?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=990914356bf7f49ed392d99051838bca", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "こんにちは、イラストを依頼したいのですが。胸像くらいの大きさが欲しいです。イチゴケーキを食べている満足そうな顔のアクションを希望します。参考画像を添付します。イラストとサインは別レイヤーでお願いできればと思います。お忙しいところありがとうございました。\nhttps://drive.google.com/drive/folders/1n1oaMrAVXp2yYkclMIf9HBc3XDSQG6ay?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@skunfan/works/27", "thumbnail_src": "https://si.imgix.net/b7a33e0a/uploads/origins/bf3aa589-f10c-4131-83cd-82211073853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55c73b0f44246a0c6fe7a7a819f4494a", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@skunfan/works/26", "thumbnail_src": "https://si.imgix.net/47986cc2/uploads/origins/f875231e-66be-496d-a99b-db97ae4f736d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baee859e346867d2228d23fcb6ff9f66", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "Hi, I really love your artwork! They are so cute T.T Can I request 単体(上半身のみ) for my OC Yayoi? She is a cute jirai onna girl （じらいおん). If it's possible, can she hold a knife with blood on it? Thank you for considering my request!\n\nhttps://drive.google.com/drive/u/1/folders/1ktuqlOnyC2ZBAWo5WvumKwrf0sag3UKD", "created_at": "", "completed_at": ""}, {"path": "/@skunfan/works/25", "thumbnail_src": "https://si.imgix.net/6b2da582/uploads/origins/0a525cb9-470d-463d-a2a5-d1d78307d4ee?bg=%23fff&auto=format%2Ccompress&fm=we