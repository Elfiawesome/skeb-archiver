361537+00:00"}]}, "current_prices": {"art": 25000, "correction": 3000}, "price_range": {"art": {"min": 16000, "max": 25000}, "correction": {"min": 3000, "max": 4000}}, "links": [{"label": "Twitter", "url": "https://x.com/yuutokagura", "name": "yuutokagura"}, {"label": "Misskey_io", "url": "https://misskey.io/@yuutokagura", "name": "yuutokagura"}, {"label": "Website", "url": "http://x.gd/ohfHi", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/273264", "name": "273264"}, {"label": "Fantia", "url": "https://fantia.jp/fanclubs/1599", "name": "1599"}], "flags": {}, "works": [{"path": "/@yuutokagura/works/428", "thumbnail_src": "https://si.imgix.net/c5488ea1/uploads/origins/db07c549-3c6e-4be7-aa80-67a889a1f6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc29f8fef9fa84796c7ca50cddecc919", "thumbnail_srcset": "https://si.imgix.net/c5488ea1/uploads/origins/db07c549-3c6e-4be7-aa80-67a889a1f6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc29f8fef9fa84796c7ca50cddecc919, https://si.imgix.net/c5488ea1/uploads/origins/db07c549-3c6e-4be7-aa80-67a889a1f6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6aa1441cbd7f46af7bbcd0de5b390a9 2x, https://si.imgix.net/c5488ea1/uploads/origins/db07c549-3c6e-4be7-aa80-67a889a1f6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b754cf3ca1b37d14e20b2902a89c7117 3x", "genre": "art", "nsfw": true, "body": "イースXのカルヤ・バルタをリクエスト。顔のバリエーションを複数希望。戦闘に敗れたカルヤが太ったおじさんに下半身を持ち上げられ、背中を壁につけられて犯されている。最初のバリエーションは、カルヤが嫌そうな顔をして、完全に勃起した男の巨根を見つめている。第二のバリエーションは、男がカルヤの中にペニスを挿入し、カルヤは口を大きく開け、目を見開いて叫ぶ。第三のバリエーションは、カルヤが泣きながら、男が自分の中に射精しないように必死になっている。第4のバリエーション、男はカルヤの中に精液を出し、カルヤの表情は生気がない。5番目のバリエーション、カルヤの目はまだ生気がないが、彼女は幸せそうな顔をしていて、男のペニスはぐったりしていて、カルヤのアソコからは精液が垂れている。もし、私の要求を調整する必要があれば、遠慮なくしてください。上下を横にずらして胸とアソコを露出。ご了承ください！衣装参考（レイヴンアバター） https://drive.google.com/file/d/16tmzJPoqKVhiM4cdTwIxeIUGAb5XuVW2/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/427", "thumbnail_src": "https://si.imgix.net/271251b3/uploads/origins/3b4b8c2c-1f4b-4cce-9e95-c4c638d6fb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6150ffc6c7103a387017c79fee4b7495", "thumbnail_srcset": "https://si.imgix.net/271251b3/uploads/origins/3b4b8c2c-1f4b-4cce-9e95-c4c638d6fb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6150ffc6c7103a387017c79fee4b7495, https://si.imgix.net/271251b3/uploads/origins/3b4b8c2c-1f4b-4cce-9e95-c4c638d6fb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b041b72694c366578b96f9197cfbad8 2x, https://si.imgix.net/271251b3/uploads/origins/3b4b8c2c-1f4b-4cce-9e95-c4c638d6fb4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9da82f420954bd632532378eabf6ee41 3x", "genre": "art", "nsfw": true, "body": "軌跡シリーズの「ヨルダ」「ヨルダと同じ姿をした影」「カトル」の3Pイラストをお願いします。\n大まかな状況はネメス島にて天使化の反動で動けないカトルをヨルダが捕まえて弄んでいるというイメージです。\n3人の服はお任せします。\nヨルダは破戒に貰った薬の影響で、一時的に巨乳にしてあげて下さい。\n各々豊満になった胸を使い、片方はパイズリ、もう片方は授乳プレイをして楽しんでいる感じです。\nこのような差分もお願いします。\n・本体がパイズリ、影は授乳ver\n・本体が授乳、影はパイズリver", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/426", "thumbnail_src": "https://si.imgix.net/229ac477/uploads/origins/09aa873d-6f17-4e49-a4e9-63a058e42013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d1c5cd2e722606cbfd77488ec99ca9e", "thumbnail_srcset": "https://si.imgix.net/229ac477/uploads/origins/09aa873d-6f17-4e49-a4e9-63a058e42013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d1c5cd2e722606cbfd77488ec99ca9e, https://si.imgix.net/229ac477/uploads/origins/09aa873d-6f17-4e49-a4e9-63a058e42013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2709924145d7f5e137044b6508be0508 2x, https://si.imgix.net/229ac477/uploads/origins/09aa873d-6f17-4e49-a4e9-63a058e42013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9153ff613648f17155f68fbcf45dfaf8 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n今回は露出系シチュのリクとなります。\n\n<キャラ>\nホロライブ 博衣こより\n水着(URLの③の衣装、パーカー不要)\n\n<シチュ>\nおっぱいを突き出しこちらに見せている。\nブラを下にずり降ろして代わりに両手で下乳を支えている感じです。\n恥ずかしくも苦笑い。\n\n設定としては川辺のキャンプ場で露出AV撮影、物陰に隠れて撮影しているイメージ。\n一般客が間近にいるスリルを出せるとなおよいです。\n\nhttps://x.com/hakuikoyori/status/1680222332751851520", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/425", "thumbnail_src": "https://si.imgix.net/80ffa501/uploads/origins/dd785c90-a992-47d2-853d-32117585b916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=678de69812913484a6bd1da2f43a19e2", "thumbnail_srcset": "https://si.imgix.net/80ffa501/uploads/origins/dd785c90-a992-47d2-853d-32117585b916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=678de69812913484a6bd1da2f43a19e2, https://si.imgix.net/80ffa501/uploads/origins/dd785c90-a992-47d2-853d-32117585b916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c1ca2366013e2919f4168513cd7c96b 2x, https://si.imgix.net/80ffa501/uploads/origins/dd785c90-a992-47d2-853d-32117585b916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab1335543dac0fd6c43c932af96e3f02 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/424", "thumbnail_src": "https://si.imgix.net/78d406d5/uploads/origins/acdbfe51-e8ee-4b72-a7c7-6999a35290f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3555f0c0931610ff3b7bbc12b828b375", "thumbnail_srcset": "https://si.imgix.net/78d406d5/uploads/origins/acdbfe51-e8ee-4b72-a7c7-6999a35290f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3555f0c0931610ff3b7bbc12b828b375, https://si.imgix.net/78d406d5/uploads/origins/acdbfe51-e8ee-4b72-a7c7-6999a35290f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfbf42c195b0eb8f6f67037f92984941 2x, https://si.imgix.net/78d406d5/uploads/origins/acdbfe51-e8ee-4b72-a7c7-6999a35290f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7617cde63b5e00301b58bd0dba3e246 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/423", "thumbnail_src": "https://si.imgix.net/c28c9b0a/uploads/origins/370f7794-4fc1-4c01-be59-7595fa836af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6174cabb0b0391e40571818b79de29dc", "thumbnail_srcset": "https://si.imgix.net/c28c9b0a/uploads/origins/370f7794-4fc1-4c01-be59-7595fa836af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6174cabb0b0391e40571818b79de29dc, https://si.imgix.net/c28c9b0a/uploads/origins/370f7794-4fc1-4c01-be59-7595fa836af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87ae299a81af55684568742157b9aab6 2x, https://si.imgix.net/c28c9b0a/uploads/origins/370f7794-4fc1-4c01-be59-7595fa836af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3623539b9f6b75306fc91280f2ad1a6e 3x", "genre": "art", "nsfw": true, "body": "こんにちは。今回はアルティナオリオンのイラストをお願いします。\n\n作品名：英雄伝説 界の軌跡\n\nキャラクターアルティナ・オライオン(アルティナ・オライオン)\n\nキャラクターや衣装の参考：https://www.falcom.co.jp/kai/character/altina.html (界伝説の軌跡の衣装)\n\n服装：腕と脚の服だけ持っていればいい(手の衣装, 足の衣装, 黒タイツ, 靴)。\n\n男の敵：前回のリクエストと同じ男です。(https://skeb.jp/@yuutokagura/works/395)\n\nシナリオは、アルティナが同じ敵に負けたというもの。敵はアルティナを思いのままに操る。アルティナと敵がディープキスをしながら対面セックスをしているところを描いてください。ナカダシクライマックス差分もお願いします。\n\n表情：両目を開けてください\n\nポーズ、背景、アングル：https://skeb.jp/@yuutokagura/works/395(全身が見える構図) (足を絡めてホールド)\n\n差分: 前回と同じ (https://skeb.jp/@yuutokagura/works/395)\n\nご清聴ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/422", "thumbnail_src": "https://si.imgix.net/4e8d4357/uploads/origins/f84dca33-913a-44e2-94b3-ca36861c09ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a5d4177d32d5dff574c9c9a3b325794", "thumbnail_srcset": "https://si.imgix.net/4e8d4357/uploads/origins/f84dca33-913a-44e2-94b3-ca36861c09ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a5d4177d32d5dff574c9c9a3b325794, https://si.imgix.net/4e8d4357/uploads/origins/f84dca33-913a-44e2-94b3-ca36861c09ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4eb3e2746a17c2f2c93c81bcca267f0 2x, https://si.imgix.net/4e8d4357/uploads/origins/f84dca33-913a-44e2-94b3-ca36861c09ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0c78d7fb36c467268fc43bc9a987036 3x", "genre": "art", "nsfw": true, "body": "こんにちは、神楽先生。\nこれまで神楽先生が描かれた多くのお尻ペンペンのリクエスト作品を拝見し、とても素晴らしいと思いました。\n今回、私もぜひ『ユニコーンオーバーロード』のリクエストをお願いしたく、ご連絡させていただきました。\n\n\n【キャラクター】\nヴァージニア／アレイン（主人公）\n（F/m、生尻OTK）\n\nシナリオ中でヴァージニアは「母親の役はできなくても、お尻叩きならできる」と言っていた場面がありましたので、それを元に、彼女がアレインを膝に乗せて生尻を力強く叩いているシーンをお願いしたいです。\nヴァージニアは真剣な表情で、平手がお尻にしっかり響くように描いていただきたいです。\nアレインは痛みに目をぎゅっと閉じて涙を流し、アレインの右腕はヴァージニアの左手で背中に押さえつけられ、お尻が赤く腫れている様子を強調していただければと思います。\n\n【服装】\nヴァージニアはゲーム中の衣装でお願いしたいですが、可能であれば両手首の小型シールドは描かない形が希望です。\nアレインは重い鎧ではなく、軽めの室内着のような服にしていただければ幸いです。\n\nまた、アレインは生尻状態ですが、性器は描かないようにしていただきたいです。\n\n参考画像：\nhttps://ameblo.jp/etsplove/entry-12935547904.html\nhttps://skeb.jp/@yuutokagura/works/385\nhttps://skeb.jp/@yuutokagura/works/369\n\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/421", "thumbnail_src": "https://si.imgix.net/cb49bf55/uploads/origins/c791ced9-7e46-419a-bf95-ccabd24014e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=108cdba17e5ee56c067742eb3b8f594d", "thumbnail_srcset": "https://si.imgix.net/cb49bf55/uploads/origins/c791ced9-7e46-419a-bf95-ccabd24014e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=108cdba17e5ee56c067742eb3b8f594d, https://si.imgix.net/cb49bf55/uploads/origins/c791ced9-7e46-419a-bf95-ccabd24014e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9a99c10b7ed6d7f7a6e8b3d3aded6dc 2x, https://si.imgix.net/cb49bf55/uploads/origins/c791ced9-7e46-419a-bf95-ccabd24014e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43acabab10470c571bd3cc2625863e88 3x", "genre": "art", "nsfw": true, "body": "神楽さんの素晴らしいイラストにいつもお世話になっています。\n空の軌跡リメイクが発売された記念に、凌辱イラストになってしまいますが、空の軌跡キャラでリクエストさせて頂きます。\n\n今回凌辱されるのはクローゼ・リンツ(クローディア・フォン・アウスレーゼ)になります。\n\n男達に襲われ必死の抵抗も虚しく全裸にひん剥かれ、背後に回った男達に片足ずつ持ち上げられ無理やりM字開脚状態で抱え上げられて、別の男がクローゼの前に立ち、強引に性器に挿入しています。\n\nクローゼは涙を流しながらもじっと耐えています。男達はクローゼの事などお構い無しに自分達だけが満足できれば良いからと、好き放題凌辱し続けます。\n\n台詞差分、挿入している男がクローゼの唇を無理やり奪う差分、中出し差分と可能であれば差分も描いて頂きたいのでご検討のほどよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/420", "thumbnail_src": "https://si.imgix.net/05df57a3/uploads/origins/7bf3d689-34b8-4dcd-8380-15734ff1f41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba534f8812440389ca1f7108c7959e5e", "thumbnail_srcset": "https://si.imgix.net/05df57a3/uploads/origins/7bf3d689-34b8-4dcd-8380-15734ff1f41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba534f8812440389ca1f7108c7959e5e, https://si.imgix.net/05df57a3/uploads/origins/7bf3d689-34b8-4dcd-8380-15734ff1f41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2db93d5eae27598a209e40edce20e0f 2x, https://si.imgix.net/05df57a3/uploads/origins/7bf3d689-34b8-4dcd-8380-15734ff1f41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb3930490b4d7db03440b01265dfa7a2 3x", "genre": "art", "nsfw": true, "body": "初めまして！一枚のエッチなイラストを依頼させていただきます。\n\n•キャラ\nD.Gray-manのリナリーリー\n衣装はエシ戦時のホットパンツスタイル\nhttps://x.com/odakentaku1/status/1959650342947434882?s=46&t=mmCOLlZNBqae46DAq1ImWA\n\n\n•シチュエーション\n全身をピアノ線みたいな強く硬い糸で絡め取られ、絞め上げられて悶絶している。 両手両足を絡め取られ、全身に糸が喰い込んでいる。　\n表情は赤面してて、エロ可愛く恥ずかしそうに感じてる。\n\nなるべく全身を見たいので頭からつま先までお願いします。難しいようでしたら膝まででも大丈夫です。\n\nおっぱいや太もも、マン筋にも糸が食い込むようにお願いします。\n可能なら服の上からでもわかるくらい乳首が勃起しているように描いて欲しいです。\n美脚が魅力的なキャラなので足を長めに書いてください。\nhttps://skeb.jp/@mushikera_hoi2/works/306\n\n金額が足りませんでしたら再送させてください。\n\nhttps://x.com/kousuzumoto1100/status/1969940807764627760?s=46&t=mmCOLlZNBqae46DAq1ImWA\n\nhttps://x.com/odakentaku1/status/1972981288849322342?s=46&t=mmCOLlZNBqae46DAq1ImWA", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/419", "thumbnail_src": "https://si.imgix.net/62a01ae2/uploads/origins/0a097816-3d96-44b3-88b8-9ecc3a9d8eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b32346edd0cf122aa50786bfad11f5", "thumbnail_srcset": "https://si.imgix.net/62a01ae2/uploads/origins/0a097816-3d96-44b3-88b8-9ecc3a9d8eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35b32346edd0cf122aa50786bfad11f5, https://si.imgix.net/62a01ae2/uploads/origins/0a097816-3d96-44b3-88b8-9ecc3a9d8eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec9682bd24e74ec38b8c66828d08175 2x, https://si.imgix.net/62a01ae2/uploads/origins/0a097816-3d96-44b3-88b8-9ecc3a9d8eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5e5f9fd399561c68713c2b3e47b694f 3x", "genre": "art", "nsfw": true, "body": "こんにちは！素晴らしい作品です！(https://skeb.jp/@yuutokagura/works/395)\n今回はエレーヌ・オークレールのイラストをお願いします。\n\nキャラクターは？エレイン・オークレール(エレイン・オークレール)\nキャラクターや衣装の参考：https://www.falcom.co.jp/kuro/character/elaine.html (英雄伝説 黎明の軌跡の衣装)\n服装：腕と脚の服しか持っていない。\n男の敵：前回の依頼と同じ男です。(https://skeb.jp/@yuutokagura/works/395)\nエレーヌが同じ敵に負けたというシナリオになる。敵はエレーヌを思いのままに操ります。エレインと敵がディープキスをしながら対面セックスをしているところを描いてください。ナカダシクライマックスの差分もお願いします。\nポーズと背景：https://skeb.jp/@yuutokagura/works/395(全身が見える構図) (足を絡めてホールド)\n\n差分\n1.エレインの子宮と敵のチンポを示す断面図。\n2.ディープキスをしながらの中出し絶頂。\n3.断面図ではエレインの子宮が精液で満たされている。\n\nご清聴ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/418", "thumbnail_src": "https://si.imgix.net/0650e36c/uploads/origins/25c4f766-568e-471f-90a3-bdc6fddc4cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9714f1425fd237072fb69fcfd56b3858", "thumbnail_srcset": "https://si.imgix.net/0650e36c/uploads/origins/25c4f766-568e-471f-90a3-bdc6fddc4cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9714f1425fd237072fb69fcfd56b3858, https://si.imgix.net/0650e36c/uploads/origins/25c4f766-568e-471f-90a3-bdc6fddc4cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf37b745736f021603f925b93bd02318 2x, https://si.imgix.net/0650e36c/uploads/origins/25c4f766-568e-471f-90a3-bdc6fddc4cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b97ac54d6d96c84dc0c1d2687207dae 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n以前、「英雄伝説 黎の軌跡Ⅱ -CRIMSON SiN」のシズナ・レム・ミスルギでパイズリイラスト（https://skeb.jp/@yuutokagura/works/292）の作成をご依頼したものですが、同じキャラクターで再びイラスト作成のご依頼をさせて頂きます。\n\n・構図とポージングは前回と全く同じで、頭のリボンを戦装束時のもの（https://www.falcom.co.jp/kai/character/shizuna.html参照）にして再度描いて頂きたいです。\n\n・おっぱいの大きさも前回と同じにして下さい。また、パイズリされている男の腹筋についてですが、今回は割れていなくて結構です。\n\n・前回同様、表情差分3種のご用意をお願いします。※今回も各種ともザーメンの描写は無しでOKです。\n①口を閉じて微笑む。\n\n②https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRuIxOeTLZqvHykjT6_OGwGXusWnoQ2GwJ9JNxW6k-8hxFCQvrkMbou2mM&s=10と同じ表情で、口を閉じつつ目を細めながら怪しげな笑みを浮かべる。\n\n③https://img.dlsite.jp/modpub/images2/work/doujin/RJ01037000/RJ01036249_img_main.webpのように舌舐めずりをしながら楽しそうに微笑む。\n\nお忙しい所大変恐縮ですが、何卒宜しくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/417", "thumbnail_src": "https://si.imgix.net/f2dcc972/uploads/origins/5703890c-eb55-40d7-9927-7f16d328dd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110d2c861707a3fd6e6e50727b1fa636", "thumbnail_srcset": "https://si.imgix.net/f2dcc972/uploads/origins/5703890c-eb55-40d7-9927-7f16d328dd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110d2c861707a3fd6e6e50727b1fa636, https://si.imgix.net/f2dcc972/uploads/origins/5703890c-eb55-40d7-9927-7f16d328dd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf515f1b7de4aa551a572b14e502f5c5 2x, https://si.imgix.net/f2dcc972/uploads/origins/5703890c-eb55-40d7-9927-7f16d328dd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=692f4a607ab0889ba748472532dadb68 3x", "genre": "art", "nsfw": true, "body": "いつも神楽さんのイラストにお世話になっています。\n\n以前描かれたエマやラウラの敗北凌辱イラストが可哀想だけど素晴らしくそそられるイラストだったのでまた同じ系統のイラストをリクエストします。\n\nⅦ組繋がりで次はフィー・クラウゼルが敗北して凌辱されるイラストを描いて頂きたいです。創の軌跡や黎の軌跡等では立派に成長した姿を見せていますが、あくまで今回はトールズ士官学院生時代のまだ幼く小柄だった頃のフィーが凌辱されるシチュエーションになります。\n\n当然のように全裸にひん剥かれたフィーは小柄な子を凌辱するのが好きな趣味の悪い大男達に襲われています。\nフィーの両腕は大男にガッチリと抑えつけられ、別の大男がそそり立った大きなものをフィーの小さな身体に無理やり挿入しています。\nまだ小さなフィーの身体では入り切らないものを力付くで挿入している為、フィーは激痛に苦しんで涙を流しています。\nフィーが苦しんでいることなどお構い無しに大男達は自分達が気持ち良くなる為だけに凌辱を続けます。\n\n台詞差分や中出し差分、苦痛から嫌なのに気持ち良くなっていってしまうフィーの表情の変化等は可能な範囲で描いて頂ければ構わないので、ご検討のほどよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/416", "thumbnail_src": "https://si.imgix.net/ab3a410e/uploads/origins/8d8e367e-eb71-4b6d-8830-253989db32ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14489ae0a28dcbd4dc0cf67e8b7bf55c", "thumbnail_srcset": "https://si.imgix.net/ab3a410e/uploads/origins/8d8e367e-eb71-4b6d-8830-253989db32ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14489ae0a28dcbd4dc0cf67e8b7bf55c, https://si.imgix.net/ab3a410e/uploads/origins/8d8e367e-eb71-4b6d-8830-253989db32ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84a2edf6adddc20b6e780719a21da100 2x, https://si.imgix.net/ab3a410e/uploads/origins/8d8e367e-eb71-4b6d-8830-253989db32ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b90a3038bad99f813d93b3c6cce85d15 3x", "genre": "art", "nsfw": true, "body": "過去描かれていたヴァン＆エレインやロイド＆リーシャのシックスナインのイラストがとても良かったのでまた別キャラでリクエストします。\n\n今回はリィン・シュバルツァーとクレア・リーヴェルトがシックスナインをしているイラストを描いて頂きたいです。\n\nリィンもクレアも全裸になっていて、今回はヴァンとエレインのシックスナインと同じような形のオーソドックスなシックスナインで、ベッドに仰向けになったリィンにクレアが覆い被さる形となり、互いの性器を咥えたり舐めたりしています。\n\nリィンもクレアも行為そのものを楽しみつつも、相手を気持ち良くしてあげたいという想いから、丁寧に愛撫し続けています。\n\n構図はヴァンとエレインと基本的には同じ形でお願いしたいですが、神楽さんが描きやすい形を優先して頂いて構いませんのでよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/415", "thumbnail_src": "https://si.imgix.net/ce3651d7/uploads/origins/20976fb6-e4d4-4f5a-90f5-238c9dc0916d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4186ce7a7cfa1742cbd908322b922e8b", "thumbnail_srcset": "https://si.imgix.net/ce3651d7/uploads/origins/20976fb6-e4d4-4f5a-90f5-238c9dc0916d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4186ce7a7cfa1742cbd908322b922e8b, https://si.imgix.net/ce3651d7/uploads/origins/20976fb6-e4d4-4f5a-90f5-238c9dc0916d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72d2af94efa7a3a925eead603ecf4d07 2x, https://si.imgix.net/ce3651d7/uploads/origins/20976fb6-e4d4-4f5a-90f5-238c9dc0916d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=460e1982d9cf3af73781904b2df553db 3x", "genre": "art", "nsfw": true, "body": "初めまして、いつも素敵な作品をありがとうございます。神楽優人@c106 日曜日 東Ｅ－16bさんのスパンキング イラストがすごく好みなので初リクエストしたいです。\n\n「NIKKE」よりヤン(水着衣装)/ドロシー(水着衣装)のスパンキング イラスト(生尻OTK)をお願いしたいです。　\n\n［参考資料］\nドロシー(水着衣装)\nhttps://game8.jp/nikke/705736\nヤン(水着衣装)\nhttps://game8.jp/nikke/492148\n\n(分かりづらいと思いますがスクロールしていけば下の方に立ち絵などがあるのでそちらを参考にしていただければ、ヤンの方はサンライズマーケットと書かれている方でお願いします。)\n\n［シチュエーション］\n・ドロシーがヤンの膝の上に乗せられ、腰をがっちり抱え込まれた状態で思いっきりお尻を平手で叩かれる。\n・ドロシーは赤面&涙目になるが歯を噛み締めて痛みに耐えている(もし可能であれば噛み締め表情とは別で涙目で口が開いている表情のアップをどこかに描いてくれたら嬉しいです。)\n\n［その他］\n背景&場所は適当で大丈夫です、性器の有り無しはどちらでも構いません。\nドロシーの後ろについている翼のようなものは外してください。\nそれともし可能でしたら下記の台詞を入れてください。\nヤン「いきなり人のこと蹴っ飛ばしておいて一言も謝りにこんとかどんな教え受けとるんや!？」\n\nドロシーは台詞無しでい゛ッ、とか　んッ、みたいな声を押し殺してる感じの反応でお願いします。\n\n本編では絶対にありえない展開だけど夢を見たいということで…\n長くなりましたがどうか検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/414", "thumbnail_src": "https://si.imgix.net/bb24c964/uploads/origins/c139a25e-751d-4922-82ee-453c1bafb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01e36b4866852bc3571bea2300777a3", "thumbnail_srcset": "https://si.imgix.net/bb24c964/uploads/origins/c139a25e-751d-4922-82ee-453c1bafb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01e36b4866852bc3571bea2300777a3, https://si.imgix.net/bb24c964/uploads/origins/c139a25e-751d-4922-82ee-453c1bafb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09712a719b09c5a261a7571f4513245f 2x, https://si.imgix.net/bb24c964/uploads/origins/c139a25e-751d-4922-82ee-453c1bafb81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37ffe254bc537ed2b35f13f613ebb730 3x", "genre": "art", "nsfw": true, "body": "こんにちは。前回は作品ありがとうございました。\n\nhttps://skeb.jp/@yuutokagura/works/315\nhttps://skeb.jp/@yuutokagura/works/386\n\n今回はアリサの番です！\n\n作品名：創の軌跡\nキャラクター：アリサ・ラインフォルト\nテーマ: 社員Hサービスです\n背景: 事務所\n衣装: オフィス制服、白いハイヒール\nhttps://fantia.jp/posts/2789550\nhttps://x.com/mou_nanasaki/status/1959263347938828763/photo/1\nhttps://x.com/mou_nanasaki/status/1959263477979062570/photo/1\nポーズ: \nhttps://x.com/mou_nanasaki/status/1959264009376473200/photo/1\n\nシチュエーション：\n\nアリサがオフィス制服を着て社員にラブラブディープ舌キスと手コキでご褒美をしている。\n\nアリサがリードするお姉さんっぽい雰囲気でお願いします。\nセリフも入れていただけると嬉しいですが、自由にアレンジしていただいて構いません。\n\n例としてこういう感じのセリフがあるとうれしいです：\n\n「こんなに硬くなっちゃって…ふふ、かわいいね」\n\n「ずっと私のこと見てたでしょ？ ばれてたんだから」\n\n「ねぇ…どれくらい前から私のことで射精してたの？ 教えて？♡」\n\n「我慢しないで、いっぱい出していいのよ♡」\n\n\n備考:\n\n・全身が見える構図でハイヒールがはっきり見えるようにしてほしいです\n\n・アリサは胸がとても大きくブラがずり上がって下から胸があらわになっている状態でお願いします\n\n・社員は裸で包茎の陰茎がある\n\n\n差分:\n\n① アリサの目線が視聴者視点に向いている\n\n② 射精\n\n③ 射精後", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/413", "thumbnail_src": "https://si.imgix.net/fa8a27a4/uploads/origins/0859f175-fcd9-446c-b279-e2a02c678b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf698a7f51d3139715d60d432379fda1", "thumbnail_srcset": "https://si.imgix.net/fa8a27a4/uploads/origins/0859f175-fcd9-446c-b279-e2a02c678b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf698a7f51d3139715d60d432379fda1, https://si.imgix.net/fa8a27a4/uploads/origins/0859f175-fcd9-446c-b279-e2a02c678b72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a6a1777e6e3eb3fdde846c331043273 2x, https://si.imgix.net/fa8a27a4/uploads/origins/0859f175-fcd9-446c-b279-e2a02c678b72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a02f62c4328cef7e7ed5d23ccbf0568 3x", "genre": "art", "nsfw": true, "body": "神楽優人先生、お疲れ様です。\nいつもお世話になっております。\n\n前回は淫らなポーレットをありがとうございました。嗜虐心がくすぐられますね♪\n\n今回お願いしたいのは、閃の軌跡からロジーヌになります。\n\n【キャラクター】\n閃の軌跡シリーズから、ロジーヌ\n\n【服装】\n星杯騎士団 従騎士の制服(頭のシスターベールのみ)\n資料のようなオープンブラとショーツ\n\n【シチュエーション・ポーズ】\n自ら性的な奉仕をしていると言うシチュエーションで、椅子に腰掛け、足を大きく広げてM字開脚。\nみぞおちあたりで祈るように手を結び、蕩けた表情。\n\n下着の色は濃い紫で、可能であれば全身精液にまみれた姿の差分をお願いしたいです。\n\n\nご検討、よろしくお願いいたします。\n\nhttps://item.rakuten.co.jp/mondoshop/1042/", "created_at": "", "completed_at": ""}, {"path": "/@yuutokagura/works/412", "thumbnail_src": "https://si.imgix.net/3d3080e9/uploads/origins/dd545716-8836-4415-a9c5-8f42d6d1959d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd1b0f515209fabf1aaf065a06481f99", "thumbnail_srcset": "https://si.imgix.n