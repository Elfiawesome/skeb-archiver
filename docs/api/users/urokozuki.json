=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1620e584e6a3c9166096dcf35f1a7fe2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@urokozuki/works/478", "thumbnail_src": "https://si.imgix.net/8b8794d2/uploads/origins/d430b3e4-6448-48d0-95a2-c2f4cf9d32c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df6e48de7a7616d0d54ad2e9257730d1", "thumbnail_srcset": "https://si.imgix.net/8b8794d2/uploads/origins/d430b3e4-6448-48d0-95a2-c2f4cf9d32c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df6e48de7a7616d0d54ad2e9257730d1, https://si.imgix.net/8b8794d2/uploads/origins/d430b3e4-6448-48d0-95a2-c2f4cf9d32c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a512353fbbc9b7d6d338c92b0d015d34 2x, https://si.imgix.net/8b8794d2/uploads/origins/d430b3e4-6448-48d0-95a2-c2f4cf9d32c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=951fc3f28366e44b2fd2069de5f08d56 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@urokozuki/works/477", "thumbnail_src": "https://si.imgix.net/ac1fb3b6/uploads/origins/98d335ac-20ed-49a8-aa16-0cd261db39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1169903b3751a8bfc53e68beda1185ef", "thumbnail_srcset": "https://si.imgix.net/ac1fb3b6/uploads/origins/98d335ac-20ed-49a8-aa16-0cd261db39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1169903b3751a8bfc53e68beda1185ef, https://si.imgix.net/ac1fb3b6/uploads/origins/98d335ac-20ed-49a8-aa16-0cd261db39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=991e6fef0309c999480f7a49c47de032 2x, https://si.imgix.net/ac1fb3b6/uploads/origins/98d335ac-20ed-49a8-aa16-0cd261db39b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb1ba0e21d253b7628c5d89050a89ab8 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です。度々ワレモコウ等のイラストを依頼していた者です。よろしければまたリクエストお願いします。\n\nキャラクター：フラワーナイトガールよりスイカズラ（パラレル学園）（開花後）\n\nシチュエーション：先生に自宅へ連れ込まれての種付け正常位セックス、衣装は半脱ぎで、余裕そうに振舞うも快楽でイキそうになっている様子でお願いします。\n\n何卒よろしくお願いします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%82%B9%E3%82%A4%E3%82%AB%E3%82%BA%E3%83%A9%28%E3%83%91%E3%83%A9%E3%83%AC%E3%83%AB%E5%AD%A6%E5%9C%92%29", "created_at": "", "completed_at": ""}, {"path": "/@urokozuki/works/476", "thumbnail_src": "https://si.imgix.net/cdfd8e42/uploads/origins/6b2cd57e-8980-4a3a-b1a7-9fe749cca269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d7d1c3353646cec41b32a38cf4bb772", "thumbnail_srcset": "https://si.imgix.net/cdfd8e42/uploads/origins/6b2cd57e-8980-4a3a-b1a7-9fe749cca269?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d7d1c3353646cec41b32a38cf4bb772, https://si.imgix.net/cdfd8e42/uploads/origins/6b2cd57e-8980-4a3a-b1a7-9fe749cca269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83db68764e0a5509e6880b54df689573 2x, https://si.imgix.net/cdfd8e42/uploads/origins/6b2cd57e-8980-4a3a-b1a7-9fe749cca269?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c93f9ab8d310dc6f965015ea9036dbd6 3x", "genre": "art", "nsfw": true, "body": "お世話になっております、前回も大変素敵なイラストをありがとうございました。\n今回もよろしければご一考いただけますと幸いです。\n\n【作品】フラワーナイトガール\n【人物】エーデルワイス（新春衣装）\nhttps://i.imgur.com/p948yR1.png\n※体型はこちらの衣装の方がわかりやすいと存じます\nhttps://imgur.com/Duh9GaW\nロリではありませんが小柄な子でちびっ子の様な体格です\n胸小さめ、お尻も小さめでお願いします\n【キャラ設定参考】\nhttps://imgur.com/a/kv8cw4i\n\n【要望】\n今回も先生のこちらのイラスト（https://skeb.jp/@urokozuki/works/265）のような体位で主人公とのらぶらぶセックスを描いてください、お願いします。\n結合部がしっかり見える構図でお願いいたします。\n※鑑賞の際はスマホで見ます、構図を変えないでいただけますと助かります。\n※過去に作られたもので流用可能なものは積極的に流用してください。\n\n衣装は半脱ぎで乳首が見えるようにしてください、 ぱんつは今回は履いてない設定でお願いします。\n\nまた、可能であれば挿入前、挿入中、中だし射精と同時に絶頂、射精後におちんちんを抜いて局部から精液が垂れている姿までの差分をお願いいたします。\n特に挿入中の表情のバリエーションが多いと嬉しいです。\n（序盤、中盤、終盤といった感じをイメージしておりますが、可能な限りで結構です。）\n\n表情差分につきましては\n・気持ちよくなっちゃってお口を開けてよだれを垂らしてあえいでる表情\n・にっこり笑顔\n・ぐったりアヘ顔\n・オホ顔\n・びっくりしたときの顔\n・事後満足した顔\n・気持ちいいのを我慢してる顔（～口、∞口）\n・この（https://imgur.com/HjgHrKi）ような感じで余裕ぶっているようで実は脂汗たらたらでイクのを我慢している顔\nなどからバランスよく選択して作成していただけますと大変嬉しいです。\n（多いほどうれしいですができる限りで結構です）\n\n今回も濃厚にラブラブした感じのものをいただけますと非常に嬉しいです。\n\n以上が私の要望ですが、難しい点や不明な点などございましたら先生のやりやすい様にアレンジしていただいて構いません。\n\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%82%A8%E3%83%BC%E3%83%87%E3%83%AB%E3%83%AF%E3%82%A4%E3%82%B9", "created_at": "", "completed_at": ""}, {"path": "/@urokozuki/works/475", "thumbnail_src": "https://si.imgix.net/cd6de920/uploads/origins/3aa97100-edd6-46da-ad16-45ccd141cfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=533a41d83ac7c104c0aadfba590b0b74", "thumbnail_srcset": "https://si.imgix.net/cd6de920/uploads/origins/3aa97100-edd6-46da-ad16-45ccd141cfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=533a41d83ac7c104c0aadfba590b0b74, https://si.imgix.net/cd6de920/uploads/origins/3aa97100-edd6-46da-ad16-45ccd141cfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1206717491ee7fc252218b8129113acd 2x, https://si.imgix.net/cd6de920/uploads/origins/3aa97100-edd6-46da-ad16-45ccd141cfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fe4e92fda46d011afb5f10e5f67bb61 3x", "genre": "art", "nsfw": true, "body": "ハンドレッドライン\n九十九 過子\n凶鳥狂死香\n\nキャラクター設定資料を用意しました。\nhttps://imgbox.com/RQlljaW9\n\n\n二人とも正面を向いて、胸と膣が見えるヌード画像をお願いします。\n陰毛のない、きれいに剃られたおまんこ。\n前の画像と同様の構図で描いてください\nPhotoshopファイル内のスプライトを、最初のものを隣り合わせに配置できるようにしたいです\nhttps://skeb.jp/@urokozuki/works/469\n\n\n九十九 過子は胸が小さく、背が低いです\n表情は落ち着いた表情と、上の参考写真のように興奮した表情の代替バージョンがあります\n彼女のポーズは自然な形で裸体を強調している\n\n鳥狂死香は背が高く、胸が大きい\n表情は明らかに楽しんでいる様子を隠そうとする照れた表情と、上の参考写真のように赤面しながらもより露骨に興奮した代替案を用意\nコンセプトは「裸を見られることに興奮しているが、その興奮を隠そうとしており、露骨に欲情を露わにはしない」というものです\n\n\n\n\nリクエストをご検討いただきありがとうございます。あなたが描かれたこのゲームのイラストは本当に美しく、リクエストせずにはいられませんでした", "created_at": "", "completed_at": ""}, {"path": "/@urokozuki/works/474", "thumbnail_src": "https://si.imgix.net/1816b99c/uploads/origins/1c2bf006-578e-4569-9f11-84e703beeddf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10b66ad1031c096bbd0e10235f27e0c0", "thumbnail_srcset": "https://si.imgix.net/1816b99c/uploads/origins/1c2bf006-578e-4569-9f11-84e703beeddf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10b66ad1031c096bbd0e10235f27e0c0, https://si.imgix.net/1816b99c/uploads/origins/1c2bf006-578e-4569-9f11-84e703beeddf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d352feb7d13c62285ffc4fec320bc941 2x, https://si.imgix.net/1816b99c/uploads/origins/1c2bf006-578e-4569-9f11-84e703beeddf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9624fe95bfacad469c1c43af0cca0878 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。以前はリクエスト対応ありがとうございます。\n再度描いてもらいたい内容が浮かんだので、リクエストいたします。\n\n以前とは違う自キャラ(♂)を描いてほしいです。（下記URL参照）\nhttps://skeb.jp/@mohemohemincho/works/32\nhttps://skeb.jp/@mohemohemincho/works/62\nhttps://skeb.jp/@mohemohemincho/works/154\nhttps://skeb.jp/@2ljh_mosunosuke/works/15\n\n描いてほしい内容としては、このキャラの水着姿となります。\n下は黒のトランクスタイプで、上は白いTシャツでサイドで裾を結んでいる感じで、お腹周りは露出した感じでお願いします。\n表情は基本は笑顔で、もし出来れば下記の表情もお願いしたいです（無理にとは言いません）\n・むすっとした表情\n・顔真っ赤にしてパニックになる表情（目はグルグル目になってる感じ）\nポーズや、その他記載のない内容についてはお任せします。\nNSFWチェックついてますが、あくまで水着のワードで引っかかったので付けただけで、\n下記使用用途の事もあるため、そういうイメージは求めておりません。\n\nなお、このイラストの使用用途ですが、VERSE SAVER(バースセイバー)というゲームのマイキャラのプロフィール画像及び顔アイコンに使用しようと思っています。\nなので、画像サイズの比率はプロフィール画像の比率（縦5：横3.6）でお願いしたいです。\nまた、その為、背景はあっても良いですが透過にも出来るようにしてもらえるとありがたいです。\n\n内容に問題あるようでしたらキャンセルして頂いて構いません。\n以上、宜しくお願い致しますm(_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@urokozuki/works/473", "thumbnail_src": "https://si.imgix.net/3816edae/uploads/origins/7b4164fa-91a4-448d-aa91-6ffe4dfa010e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=427085860e15eb0916f0938c2d769de7", "thumbnail_srcset": "https://si.imgix.net/3816edae/uploads/origins/7b4164fa-91a4-448d-aa91-6ffe4dfa010e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=427085860e15eb0916f0938c2d769de7, https://si.imgix.net/3816edae/uploads/origins/7b4164fa-91a4-448d-aa91-6ffe4dfa010e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f54cda552ccf91b9078bae4033206621 2x, https://si.imgix.net/3816edae/uploads/origins/7b4164fa-91a4-448d-aa91-6ffe4dfa010e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ea6d89cd5b2d4d91f5441dd6bf8a306 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@urokozuki/works/472", "thumbnail_src": "https://si.imgix.net/ccb87f73/uploads/origins/5d52c42b-5402-40d9-9fe4-fb151113afa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44529501f3133229ac6983337a95ac5b", "thumbnail_srcset": "https://si.imgix.net/ccb87f73/uploads/origins/5d52c42b-5402-40d9-9fe4-fb151113afa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44529501f3133229ac6983337a95ac5b, https://si.imgix.net/ccb87f73/uploads/origins/5d52c42b-5402-40d9-9fe4-fb151113afa7?bg=%23fff&auto=format%2Ccompre