%2Ccenter&txtsize=30&txt=PRIVATE&s=fad989022d96503de5a6bdabf44a77d9 2x, https://si.imgix.net/2555bffe/uploads/origins/cf849453-4332-4574-82c9-d116cebd61f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1199d11806a203a915e869b0cbab2d1f 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kaniloveClub/works/5", "thumbnail_src": "https://si.imgix.net/46cafdaa/uploads/origins/6a2c37a2-f33c-4835-8634-9d0303b766f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58dd4d6fbea4dd394f96c1319c97a2b0", "thumbnail_srcset": "https://si.imgix.net/46cafdaa/uploads/origins/6a2c37a2-f33c-4835-8634-9d0303b766f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58dd4d6fbea4dd394f96c1319c97a2b0, https://si.imgix.net/46cafdaa/uploads/origins/6a2c37a2-f33c-4835-8634-9d0303b766f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adea62829a2282cd08ec14244b79bfb4 2x, https://si.imgix.net/46cafdaa/uploads/origins/6a2c37a2-f33c-4835-8634-9d0303b766f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7a753c4b7cb4915a31a74b8ca9ff233 3x", "genre": "comic", "nsfw": true, "body": "こんばんわ！興味が湧いたのでリクエストを送りました\nティンダロスの猟犬【@TINDAROSU】\n資料URLにキャラクター画像のせてあります\nこのキャラクターを使って描いてほしいです。\nおっぱいは資料にはないですが、Eカップほどでお願いします。\n\n今回かいてほしいコミックなのですが、おねショタで搾精　逆転なしで描いてほしいです\n\n流れとしては\n裸のショタくん（ショートヘア）\nティンダロスの猟犬の服は来たままだけどオマンコの部分だけ丸く切り抜かれて丸見え状態で\n１.愛液で濡れたオマンコを咥えるように挿入\n\n乳首舐め（もしくは責め）M字型騎乗位でショタくん側に体を倒して湿度の高い状態（興奮で湿気がでてる感じ）でセックス\n\n２.乳首を責められ続けながら中出し（精液の量は沢山が好ましく断面図できたらお願いします）ショタくんは余裕のない感じで射精が終わった後にティンダロスの猟犬はハニカミながらよだれまみれの口でショタくんにキスをする。\n\nここまでお願いします。\n作品が納品された際には私の方でも作者様の名前と@マークをつけて投稿する予定です。\nよろしくお願いいたします！\n\nhttps://twitter.com/nakineiriko/status/1779858835269951996?t=vu1lMhVUdKIvolw0Xjg2Kw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@kaniloveClub/works/4", "thumbnail_src": "https://si.imgix.net/0eddeaf8/uploads/origins/c089c889-fa16-43f1-9c0b-7ae89523169e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163596ee1cbe313ed9c4a63aacb18572", "thumbnail_srcset": "https://si.imgix.net/0eddeaf8/uploads/origins/c089c889-fa16-43f1-9c0b-7ae89523169e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163596ee1cbe313ed9c4a63aacb18572, https://si.imgix.net/0eddeaf8/uploads/origins/c089c889-fa16-43f1-9c0b-7ae89523169e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3febba759933df0a3096f04efd9753e 2x, https://si.imgix.net/0eddeaf8/uploads/origins/c089c889-fa16-43f1-9c0b-7ae89523169e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=174c27712720f976c993b441073a8417 3x", "genre": "art", "nsfw": true, "body": "はじめまして。新着クリエイターを確認していましたら、素敵なイラストを描かれるなと思い依頼させていただきます。\nもし可能でしたら、下記内容でイラストをお願いいたします。\n\n・キャラクター\nステーションメモリーズ！（駅メモ！）\n妹尾まりか\n\n・シチュエーションにつきまして\nえっちをリードするお姉さん、という感じのシチュエーションをお願いいたします。\n上記にあっていればポーズなどなどはお任せいたします。\n描きやすい、あるいは得意な体勢で構いません。\n\n・衣服につきまして\n下記参考資料のはじめに出てくる衣装でお願いいたします。サイトはPC版で見て頂けると見やすいかと思います。必要箇所は脱がしたり破いていただけると幸いです。ただし、手袋はつけっぱなしでお願いいたします。\n背中の機械的なものは省略していただいて大丈夫です。\n\n・体格につきまして\n胸や脚等は盛っていただけると嬉しいです…！\n\nご検討のほどよろしくお願いいたします。\n\n【各種資料】\nキャラクター資料\nhttps://ek1mem0.wiki.fc2.com/wiki/%E5%A6%B9%E5%B0%BE%E3%81%BE%E3%82%8A%E3%81%8B\n\n二次創作ガイドライン\nhttps://ekimemo.com/guideline", "created_at": "", "completed_at": ""}, {"path": "/@kaniloveClub/works/3", "thumbnail_src": "https://si.imgix.net/1ae3747c/uploads/origins/0dea4f04-d4f1-472e-a7a9-7837153d1da7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5411293a95dff0235bc064f57e3e6a3e", "thumbnail_srcset": "https://si.imgix.net/1ae3747c/uploads/origins/0dea4f04-d4f1-472e-a7a9-7837153d1da7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5411293a95dff0235bc064f57e3e6a3e, https://si.imgix.net/1ae3747c/uploads/origins/0dea4f04-d4f1-472e-a7a9-7837153d1da7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02c4be9f234471c5d83024abd96e849d 2x, https://si.imgix.net/1ae3747c/uploads/origins/0dea4f04-d4f1-472e-a7a9-7837153d1da7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bc047b2621bb105c0611d87f9376186 3x", "genre": "art", "nsfw": true, "body": "好きな男性は「半ズボンの似合う男の子」なフラワーナイトガール(花騎士)のカルダミネ・リラタさんを\n\n優しく騎乗位で射精に導く感じで中出し\n両乳揉みをセルフ胸タッチで\n(他人の手を使って自分の胸を触らせる行為)\n\n騎乗位は正面騎乗位、座りは膝を立てずに床に\nパイパンで\n服装全裸にするか脱ぎかけにするかはお任せします\n\n背景なし OK\nガッツリ塗らなくても単色やラフな感じでもOKです\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kaniloveClub/works/2", "thumbnail_src": "https://si.imgix.net/85f1eb49/uploads/origins/661bf369-5207-4b61-9722-518fe7413934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e684f59d4ac39382f470f003993cdbd", "thumbnail_srcset": "https://si.imgix.net/85f1eb49/uploads/origins/661bf369-5207-4b61-9722-518fe7413934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e684f59d4ac39382f470f003993cdbd, https://si.imgix.net/85f1eb49/uploads/origins/661bf369-5207-4b61-9722-518fe7413934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08a0e9316e8036a7305010a99e4de9ba 2x, https://si.imgix.net/85f1eb49/uploads/origins/661bf369-5207-4b61-9722-518fe7413934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93407416456f235d6c9682726e9a7d7b 3x", "genre": "art", "nsfw": true, "body": "はじめまして、新着クリエイター一覧から、過去作品に惹かれて来ました\nもしよろしければリクエストを受けていただけないでしょうか\nモデルはサービス終了したネットゲームのマイキャラクターになります\nお淑やかな性格でむっつりスケベ、胸は控えめな、お尻が性感帯な子です\n\n・希望する内容を箇条書きで（共通部分）\n恋人とのいちゃらぶセックス\nとろとろで気持ちよさそうな表情\n資料モデルでは胸が大きいですが、控えめにアレンジをお願いします（Bカップくらいのイメージで）\n衣装は色違いで2種類ありますが、お好きな方で（赤黒の場合でも犬耳はありでお願いします）\n服は着衣～半脱ぎくらいだとありがたいです（細かい装飾などは省略やアレンジしていただいて構いません）\n下着はフォルダ内に候補がありますのでお好きな柄で（好みにアレンジ・デザインしただいても良いです）\n下着は着たままずらすか、脱ぎかけの状態で片方の太ももあたりに残してください\n\n・案1\n犬耳を着け、尻尾型プラグをお尻に挿入した状態で\n犬になりきりながら気持ちよくなっているイメージ\n\n・案2\nアナルセックスで、おしりでとても気持ちよくなっているイメージ\n\n構図についてはお任せします\n上記のような内容で喘ぎ声、セリフがあると嬉しいです\n予算内で可能であれば絶頂・事後などの差分があると嬉しいです\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1fhzXcECCRDrstZLwK__JSU2cEV_1NVpd", "created_at": "", "completed_at": ""}, {"path": "/@kaniloveClub/works/1", "thumbnail_src": "https://si.imgix.net/f6ff5eb9/uploads/origins/db1451be-6133-48ca-9da1-915c48b67f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7dd70fc85b5cbf93c54056748f3b5b", "thumbnail_srcset": "https://si.imgix.net/f6ff5eb9/uploads/origins/db1451be-6133-48ca-9da1-915c48b67f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7dd70fc85b5cbf93c54056748f3b5b, https://si.imgix.net/f6ff5eb9/uploads/origins/db1451be-6133-48ca-9da1-915c48b67f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11fab21caa198d73f73d7032ad3902c8 2x, https://si.imgix.net/f6ff5eb9/uploads/origins/db1451be-6133-48ca-9da1-915c48b67f8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ae75a33ca2248868b30c585bf5c7552 3x", "genre": "art", "nsfw": true, "body": "はじめましてこんにちは。\n\nXとpixivの方でイラスト拝見しました。\n\nうちの子のイラストを描いて頂けないでしょうか。\n\n構図や衣装等はお任せします。\n\nもしよろしければお願い致します。\n\n・資料\nhttps://skeb.jp/@tanonosan/works/116\n\nhttps://drive.google.com/drive/u/1/folders/12R0z2p1Ed5UxPv2gKnbP8U4PhTu50EXv", "created_at": "", "completed_at": ""}]}