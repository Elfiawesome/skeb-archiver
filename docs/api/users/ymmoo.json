df4f/uploads/origins/035f60af-a851-497f-9479-2ad1962e050c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce287fe1366c3af463c7e73e16080236", "thumbnail_srcset": "https://si.imgix.net/8cd5df4f/uploads/origins/035f60af-a851-497f-9479-2ad1962e050c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce287fe1366c3af463c7e73e16080236, https://si.imgix.net/8cd5df4f/uploads/origins/035f60af-a851-497f-9479-2ad1962e050c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3783600a65cf2b0804e835d0aefd88ec 2x, https://si.imgix.net/8cd5df4f/uploads/origins/035f60af-a851-497f-9479-2ad1962e050c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eacf4624246292e2623d752a2007f00d 3x", "genre": "art", "nsfw": false, "body": "I have seen some beautiful stuff so i came to visit~\nDraw anything youd like c:\nThank you \nhttps://drive.google.com/drive/folders/1fCBa6cvletRGtSav04tSjDRGeqYVlGQP\n\nhttps://drive.google.com/drive/folders/1fCBa6cvletRGtSav04tSjDRGeqYVlGQP", "created_at": "", "completed_at": ""}, {"path": "/@ymmoo/works/141", "thumbnail_src": "https://si.imgix.net/7bf321ad/uploads/origins/66484e3c-f9ca-4b8d-98d2-5381ac112925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665b5ce1844c068b3b61e51e0fbf32db", "thumbnail_srcset": "https://si.imgix.net/7bf321ad/uploads/origins/66484e3c-f9ca-4b8d-98d2-5381ac112925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665b5ce1844c068b3b61e51e0fbf32db, https://si.imgix.net/7bf321ad/uploads/origins/66484e3c-f9ca-4b8d-98d2-5381ac112925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb0598487c33d6eb61bece64b086553c 2x, https://si.imgix.net/7bf321ad/uploads/origins/66484e3c-f9ca-4b8d-98d2-5381ac112925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e805a8a1a954ac5cda0f086f9767418 3x", "genre": "art", "nsfw": false, "body": "も 様\n初めましておいもと申します。\n\nも様が以前リクエストにお応えされていらっしゃったピンクのリボンを付けた背中に羽の生えた猫ちゃんのイラストがとてもかわいらしく表情やポーズが好みで、自分もぜひ絵をお願いしたくご連絡しました。\n\n配信の立ち絵のおともになっている猫のイラストをお願いしたいです。\n灰色と白色のハチワレで、青紫のリボンを首元につけています。\n元になっているぬいぐるみが渋めの表情だったのでおじさんのような名前になってしまいましたが、穏やかで優しい子です。\n立ち絵にはぬいぐるみとして持たせていますが、普通の猫ちゃんのように書いていただけると嬉しいです\nかわいいポーズ、可能ならもふもふのおなかがみたいです。\nこれまで目を開いているところを描いてもらったことがないので、もし開眼になる場合は黒や紺に近い色でお願いします。目を閉じたままでも大丈夫です。\n\n参考資料をドライブで添付させていただきます。\nイラストは配信やSNS投稿、グッズに使う場合があります。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1bsu0gUA99eQPkulSfvUmwvDibHlYadi8/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ymmoo/works/140", "thumbnail_src": "https://si.imgix.net/77e71cbd/uploads/origins/ad70ef14-771d-4bea-b14d-a18ef7a181ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fe2c60b3187035372b1b1a0176d700a", "thumbnail_srcset": "https://si.imgix.net/77e71cbd/uploads/origins/ad70ef14-771d-4bea-b14d-a18ef7a181ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fe2c60b3187035372b1b1a0176d700a, https://si.imgix.net/77e71cbd/uploads/origins/ad70ef14-771d-4bea-b14d-a18ef7a181ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10b2de28e377ebb17bfb0a129a2c3226 2x, https://si.imgix.net/77e71cbd/uploads/origins/ad70ef14-771d-4bea-b14d-a18ef7a181ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ca9a5c3cfacf1d30115f7c3ad04cfe7 3x", "genre": "art", "nsfw": false, "body": "も様はじめまして！も様のイラストがとても好みで初めてskebでご依頼させていただきます⟡.*\n不慣れな点が多くご迷惑をおかけします…\n\n写真の子をも様風にイラスト化していただきたいです！\n\n名前 海(かい)くん 男の子 5歳 種ラガマフィン\nお鼻と肉球はピンク🐾\nポーズは猫らしいポーズであればなんでも大丈夫なのでお任せいたします💭\nおめめはまん丸のきゅるきゅるした写真を参考にしていただきたいです˖ ࣪⊹\n背景ありの場合は青系統でお願いいたします⋆*\n\nXで投稿しているアイドルのマークが🌱なため可能であればイラストのどこかに入れていただきたいです…\n\n使用用途…Xアイコン\n(当Xアカウントのアイコンで使用させていただきたいです)\n\n上記可能でしたらよろしくお願いいたします！\n金額が足りない場合は再送をお願いいたします(  . .)\"\n\nいつも素敵なイラストありがとうございます⋆*\n\nhttps://drive.google.com/drive/folders/1zZAwuDXf8gwvbZnxfn2w_cgo_j3UcWh0", "created_at": "", "completed_at"