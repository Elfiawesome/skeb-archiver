op&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c3d8dc85316202379fb89a68cec9890, https://si.imgix.net/dc2db7ac/uploads/origins/820e1daf-1ad6-48fd-9933-b116a7e8841b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea835da23e71ce8c408fa6aacc880f8a 2x, https://si.imgix.net/dc2db7ac/uploads/origins/820e1daf-1ad6-48fd-9933-b116a7e8841b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d93a6355f4638c1d38eeb4d438d4269 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akiha/works/39", "thumbnail_src": "https://si.imgix.net/61d55316/uploads/origins/07b1e499-77dc-4c39-a047-5f7105e8807a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6394671146eee7a4d88802a3dfd198", "thumbnail_srcset": "https://si.imgix.net/61d55316/uploads/origins/07b1e499-77dc-4c39-a047-5f7105e8807a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba6394671146eee7a4d88802a3dfd198, https://si.imgix.net/61d55316/uploads/origins/07b1e499-77dc-4c39-a047-5f7105e8807a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c435f64dd1c2899ad17be7ef2502f280 2x, https://si.imgix.net/61d55316/uploads/origins/07b1e499-77dc-4c39-a047-5f7105e8807a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19f43d258a84aa9f27e71f8629204fb3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたのスタイルが大好きです。私のキツネのキャラクターを着物や好きな服装で描いてもらえますか？赤いフェイスベールもお願いします。ありがとうございます！\n\nhttps://drive.google.com/drive/u/0/folders/1WbXzF9fQOaBdFjk4YhpyCAtMhDBhO2wy", "created_at": "", "completed_at": ""}, {"path": "/@akiha/works/38", "thumbnail_src": "https://si.imgix.net/340909a5/uploads/origins/744fb48c-8321-4c5a-9d84-46207e44e685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5de7ef45b4f8eb0b9e786e4201a8ea", "thumbnail_srcset": "https://si.imgix.net/340909a5/uploads/origins/744fb48c-8321-4c5a-9d84-46207e44e685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5de7ef45b4f8eb0b9e786e4201a8ea, https://si.imgix.net/340909a5/uploads/origins/744fb48c-8321-4c5a-9d84-46207e44e685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=981239b63b0efcaf581df073bcdde468 2x, https://si.imgix.net/340909a5/uploads/origins/744fb48c-8321-4c5a-9d84-46207e44e685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74af4ac4800f9fd4cc972093a56d280a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、秋葉さん！👋 はじめまして！お元気ですか？😄\n\nSkebのリクエスト受付が再開されているのを拝見しました。ぜひイラストをお願いしたいです！！\nあなたのとても可愛くて個性的な絵柄が本当に大好きで、キャラクターをとても愛らしく、そして細かく描かれるところが素晴らしいと思います。あなたのスタイルはまさに唯一無二です！🥰🥰🥰\n\n私の「ふわふわドラゴン」を描いていただきたいです！彼はエネルギッシュで、カリスマ的で、冒険好きで、魅力的、そしてとてもハッピーな性格です。\nその他の要素はすべておまかせします！☺️\nあなたはとても才能のある方なので、きっと素晴らしい作品を描いてくださると信じています！😆\n\nぜひリクエストをご検討いただけると嬉しいです。\nどうぞよろしくお願いいたします。素敵な一日をお過ごしください！！❤️💜", "created_at": "", "completed_at": ""}, {"path": "/@akiha/works/37", "thumbnail_src": "https://si.imgix.net/f253105a/uploads/origins/eb1a1f64-7599-4383-ad8b-f895c3f79fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3033232abc462130e39d0b453b8afe7f", "thumbnail_srcset": "https://si.imgix.net/f253105a/uploads/origins/eb1a1f64-7599-4383-ad8b-f895c3f79fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3033232abc462130e39d0b453b8afe7f, https://si.imgix.net/f253105a/uploads/origins/eb1a1f64-7599-4383-ad8b-f895c3f79fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a1d163767d30001455ba1765ccc299c 2x, https://si.imgix.net/f253105a/uploads/origins/eb1a1f64-7599-4383-ad8b-f895c3f79fb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=934f3e16eb2a8f25f2fd348431b2461a 3x", "genre": "art", "nsfw": false, "body": "はじめまして こんにちは\nいきなりで申し訳ありません､もしもよろしければなと思いまして､リクエストを送らせていただきました。\nうちの仔の獣人のキャラのアルヴァを描いてもらいたいです\n衣装が色々とありますが「新しい衣装」の方で描いてください\n構図やシチュエーションなどは秋羽さんに全てお任せ致します\n【出来ればフードを被っていない姿でお願いします】\n\n【キャラの設定】\n身長は「170㎝」\n年齢「17歳」\n商人ギルドに所属している探検家の青年\n氷のような結晶を扱え、道具などを器用に使いこなせ冷静な表情の裏にも豊かな喜怒悲楽を持っている\nケモ手だが意外と手先も器用である\n\n【分かりにくい所や設定イメージ】\n・ズボン部分は膨らんでいてだぼっとしたズボンのような感じに下半身が大きく見えています\n\n描きたいように描いていただければ幸いです。\nよろしければ､よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/15YcVuyJez3RyUWZLkYrMoXTN1Cp2Fs6H?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@akiha/works/36", "thumbnail_src": "https://si.imgix.net/2daabe58/uploads/origins/bd182205-53f5-4d6f-a167-5fca565a1e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e969b6e836beb8cd9951c798b538e77e", "thumbnail_srcset": "https://si.imgix.net/2daabe58/uploads/origins/bd182205-53f5-4d6f-a167-5fca565a1e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e969b6e836beb8cd9951c798b538e77e, https://si.imgix.net/2daabe58/uploads/origins/bd182205-53f5-4d6f-a167-5fca565a1e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c29aafc308a2dce1dd11ed446ea3fef0 2x, https://si.imgix.net/2daabe58/uploads/origins/bd182205-53f5-4d6f-a167-5fca565a1e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72a9959da981dea75e25a2f5bfaaad61 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akiha/works/35", "thumbnail_src": "https://si.imgix.