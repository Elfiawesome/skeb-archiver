3c-45cd-9580-3ce09726fa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1d066b33d81e7a5c8208369a34a74b", "thumbnail_srcset": "https://si.imgix.net/3218716e/uploads/origins/64014dc4-533c-45cd-9580-3ce09726fa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1d066b33d81e7a5c8208369a34a74b, https://si.imgix.net/3218716e/uploads/origins/64014dc4-533c-45cd-9580-3ce09726fa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eedde66d1e8cc854ec7b7dda505721d4 2x, https://si.imgix.net/3218716e/uploads/origins/64014dc4-533c-45cd-9580-3ce09726fa7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6dbb3deeabb0353f9ba5e8487b43b4b 3x", "genre": "art", "nsfw": false, "body": "こんにちは。リクエスト失礼いたします。\n資料URLにある自キャラ、音希響のイラストをお願いしたいです。\n宝石、鉱石が好きな子なので鉱石がキラキラしているようなロケーションだと嬉しいですが、構図等はヌワラグレイさまにお任せいたします。\nイラストはかせいすきーのアカウントの方で、コミッションへのリンクおよびヌワラグレイさまに描いて頂いた旨を明記して掲載予定です。\n普段はパーカーのフード(ネコミミつき)を被って黄色いにゃんぷっぷーマスクをしているキャラですが、フード被る/被らない、マスクつける/つけないは描きやすい方で結構です。\n何なら体型が分からない程度に適当な夏服に着替えさせていただいてもOKです。\nアバウトな依頼で申し訳ございませんがよろしくお願いいたします。\n\nhttps://kasei.ski/@kyoka_h/pages/1717384906305", "created_at": "", "completed_at": ""}, {"path": "/@Nuwara_Gray/works/11", "thumbnail_src": "https://si.imgix.net/d4cc5a8c/uploads/origins/67fcf9ab-89b6-47a6-8aa4-6bdebe5e37fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab59a68b593ae7c0d61f1f0906c63fa", "thumbnail_srcset": "https://si.imgix.net/d4cc5a8c/uploads/origins/67fcf9ab-89b6-47a6-8aa4-6bdebe5e37fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab59a68b593ae7c0d61f1f0906c63fa, https://si.imgix.net/d4cc5a8c/uploads/origins/67fcf9ab-89b6-47a6-8aa4-6bdebe5e37fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1551f66e73beb743c718d3b03d712c9 2x, https://si.imgix.net/d4cc5a8c/uploads/origins/67fcf9ab-89b6-47a6-8aa4-6bdebe5e37fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cc68c1ea39c617685d42c21771a1551 3x", "genre": "art", "nsfw": false, "body": "すみません、資料元のvroidが非公開になっていたため再送させていただきます……！\n\n初めまして、たべやんと申します。\nmisskey ioでいつも拝見しております！\nリリーちゃんはじめ、かわいくてエモいイラストが大好きなので初めて依頼させていただきます！\n\n・要望\nmisskey ioのアイコンにもしているうちの子を描いていただきたいです！\n細かくはお任せいたしますが、好きなもの(料理や音楽や旅)の要素を入れていただけると幸いです！\n\n・参考資料\nhttps://misskey.io/clips/9umdl28vun5b0e7p\nhttps://hub.vroid.com/characters/806310145009201699/models/4957054064473498771\nVRchat等をしていないため、しっかりとしたキャラ設定ではありませんが、\n髪は金髪でリリーちゃんより少しだけ長いショートで、おでこや耳が出ます\n地雷ずしちゃんより短めのエルフ耳でピアスがあります\nちょっとつり目気味でキリッとしている顔です\nボーイッシュな格好が好きです(描きやすいもので問題ありません)\n\n・使用用途\n頂いたイラストはmisskeyのバナー画像等に使用したいです。\n\n是非よろしくお願いいたします！\n\nhttps://hub.vroid.com/characters/806310145009201699/models/4957054064473498771", "created_at": "", "completed_at": ""}, {"path": "/@Nuwara_Gray/works/10", "thumbnail_src": "https://si.imgix.net/446d427e/uploads/origins/90e4482f-0863-49b1-b733-078063d663a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d6ad83f0c0817711b144642aa9df4f0", "thumbnail_srcset": "https://si.imgix.net/446d427e/uploads/origins/90e4482f-0863-49b1-b733-078063d663a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d6ad83f0c0817711b144642aa9df4f0, https://si.imgix.net/446d427e/uploads/origins/90e4482f-0863-49b1-b733-078063d663a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64000174047cba8c7374cc1258a6fb55 2x, https://si.imgix.net/446d427e/uploads/origins/90e4482f-0863-49b1-b733-078063d663a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e518512c3f60c0c97a57292e459796d3 3x", "genre": "art", "nsfw": true, "body": "はじめまして、こんにちは。\nグランブルーファンタジーのサテュロスとグランの対談ページをお願いしたいです。グランはディジェータの女装になります。\n\nシナリオは、恥ずかしがるサテュロスがグランにフタナリ巨根を見せつけ、バレンタインアートのようなポーズをとりながら助けを求めるというものです。\nhttps://files.catbox.moe/b5d4yz.png\n\n以下、サテュロスがグランを激しく犯すシーン。サテュロスがグランのお尻を犯すと、グランはザーメンを発射する。サテュロスの巨根がグランの前立腺を突く。\n\nサテュアはとても甘く、愛情をこめてグランに感謝する。それとは対照的に、彼女はグランを休ませることなく、何度も何度もアナルセックスでイカせる。\n\n参考文献\nhttps://catbox.moe/c/bnrl40\n\nセックスシーンの正確な構図などはお任せします。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Nuwara_Gray/works/9", "thumbnail_src": "https://si.imgix.net/79507da7/uploads/origins/c8d0386a-0ba8-4200-aee0-ad4c3a1eb0fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ec61699d4970259be3a40bf63d905e2", "thumbnail_srcset": "https://si.imgix.net/79507da7/uploads/origins/c8d0386a-0ba8-4200-aee0-ad4c3a1eb0fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ec61699d4970259be3a40bf63d905e2, https://si.imgix.net/79507da7/uploads/origins/c8d0386a-0ba8-4200-aee0-ad4c3a1eb0fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a67802dfcd1d296af15468e17c7c883 2x, https://si.imgix.net/79507da7/uploads/origins/c8d0386a-0ba8-4200-aee0-ad4c3a1eb0fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac7cc1184a724f1cd6b97fc0f4b81833 3x", "genre": "art", "nsfw": false, "body": "ヌワラグレイ先生こんばんは。\n\n先生のオリジナルキャラのエイプリルちゃんとリリーちゃんのデザインが好きなので、\n二人が一緒にお出かけしているところの絵が見たいです！\nお買い物やカフェなど、シーンはお任せします！\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Nuwara_Gray/works/8", "thumbnail_src": "https://si.imgix.net/024f2ead/uploads/origins/2acc6f3b-b04f-4ae4-bfa2-5e10efb54088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ba6e97368c71817888d7fd003a40d9b", "thumbnail_srcset": "https://si.imgix.net/024f2ead/uploads/origins/2acc6f3b-b04f-4ae4-bfa2-5e10efb54088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ba6e97368c71817888d7fd003a40d9b, https://si.imgix.net/024f2ead/uploads/origins/2acc6f3b-b04f-4ae4-bfa2-5e10efb54088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ab001d36bd19f9c791340132b36f743 2x, https://si.imgix.net/024f2ead/uploads/origins/2acc6f3b-b04f-4ae4-bfa2-5e10efb54088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecced35307e1f91b5b9bb867cbc6376c 3x", "genre": "art", "nsfw": false, "body": "親愛なるヌワラグレイ、\nあなたの絵が本当に大好きです。前回のネウロ様のリクエストは本当に美しかったです。❤️\nあなたの絵のアップデートを見るのもとても楽しかったです。\n\n今回もネウロ様をお願いしたいのですが、今回は妹の悪ネウロ（名前とは裏腹に実はツンデレでとてもいい子です）と一緒にお願いします。\n電車のホームで手をつないで電車を待っているところを描いてください。パソコンのデスクトップ背景サイズ。天候、ディテール、服装、構図などはお任せします。\n\n邪神ネウロはネウロとほぼ同じですが、色が反転して暗くなっています。彼女のモデルはまだ描かれていないため、イービルの公式リファレンスはまだありません。これはアーティストによるWIPですが、まだいくつかのディテールやアクセサリーが欠けています。https://twitter.com/annytf/status/1763122954723033548\n参考になるかもしれないイーヴィルのファンアートがあります：\nhttps://www.pixiv.net/en/artworks/109747132\nhttps://twitter.com/eenightlamp/status/1763\n\nhttps://twitter.com/annytf/status/1662572237080391681", "created_at": "", "completed_at": ""}, {"path": "/@Nuwara_Gray/works/7", "thumbnail_src": "https://si.imgix.net/16f9f5d4/uploads/origins/2c5cb555-9cf0-41dc-90d1-026760a3a544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83dae2aa420197860bf5d19d785aa3a6", "thumbnail_srcset": "https://si.imgix.net/16f9f5d4/uploads/origins/2c5cb555-9cf0-41dc-90d1-026760a3a544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83dae2aa420197860bf5d19d785aa3a6, https://si.imgix.net/16f9f5d4/uploads/origins/2c5cb555-9cf0-41dc-90d1-026760a3a544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47bfb4cfad9173658bb2fdd09c760202 2x, https://si.imgix.net/16f9f5d4/uploads/origins/2c5cb555-9cf0-41dc-90d1-026760a3a544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40813eb483a6812db9aae1810338d5d3 3x", "genre": "art", "nsfw": false, "body": "VTuberのエデル・オーンスタインのイラストをお願い致します！\n\n【シチュエーション・構図】\n・腰に手を当ててドヤ顔をしている\n\n【利用シーン】\n動画上での利用やサムネイル、アイコン等で利用させて頂く可能性があります。\n\n【その他希望】\nサムネイル等で利用させていただきたいため、\nキャラクターのみの透過画像あるいはレイヤー分けされたpsdファイル等をいただけると幸いです。\n\nhttps://misskey.edel-ornstein.pro/notes/9fuqkgc53c", "created_at": "", "completed_at": ""}, {"path": "/@Nuwara_Gray/works/6", "thumbnail_src": "https://si.imgix.net/f0c