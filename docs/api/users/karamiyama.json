ix.net/8ffa669b/uploads/origins/29559d75-4fb8-4ec1-87d7-26ddb6634e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91b907f9518645155518d667732e8933", "thumbnail_srcset": "https://si.imgix.net/8ffa669b/uploads/origins/29559d75-4fb8-4ec1-87d7-26ddb6634e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91b907f9518645155518d667732e8933, https://si.imgix.net/8ffa669b/uploads/origins/29559d75-4fb8-4ec1-87d7-26ddb6634e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b36c3aedb29ff35c2c0f456a0aeb375 2x, https://si.imgix.net/8ffa669b/uploads/origins/29559d75-4fb8-4ec1-87d7-26ddb6634e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0501d7f01d66bdf62ad6c5cabc63b293 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@karamiyama/works/37", "thumbnail_src": "https://si.imgix.net/9b9f48ba/uploads/origins/3afeedf5-0c70-4318-8a06-615e7ea32969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cd4382ca7221db752324980c826bd62", "thumbnail_srcset": "https://si.imgix.net/9b9f48ba/uploads/origins/3afeedf5-0c70-4318-8a06-615e7ea32969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cd4382ca7221db752324980c826bd62, https://si.imgix.net/9b9f48ba/uploads/origins/3afeedf5-0c70-4318-8a06-615e7ea32969?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d7796149f170106dff5232fed6223af 2x, https://si.imgix.net/9b9f48ba/uploads/origins/3afeedf5-0c70-4318-8a06-615e7ea32969?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ee8fabee69458ff04d60e90ffdfe91a 3x", "genre": "comic", "nsfw": true, "body": "リクエストさせていただきます。\nファイアーエムブレム聖戦の系譜のディアドラで、モノクロコミック形式にて以下の内容をお願いいたします。\n\n８ページくらいでお願いしたいのですが、料金等不足あれば再送いただけますと幸いです。\n\n◇内容\nゲームで言うと３章で、夫のシグルドが心配になり息子のセリスをシャナンに預けて会いに行こうとする。\n原作ならマンフロイに捕まるところ、屈強なヤリチン傭兵達に捕まり、ヤリ部屋へ連れていかれキスや愛撫をされつつ服を破かれ輪姦される。\n\n美少女で胸も多きくスタイル抜群のディアドラを犯すことに興奮する男達。\n\nイヤイヤながらも男達の立派な竿やテクニックで感じてしまうディアドラ。\nその内母乳が出て、美少女人妻だと分かるとテンションが上がる男達。\n\n何度も中に出され、最後は後ろから胸を揉まれながら、お掃除フェラをしつつＷ手コキさせられるディアドラ。\nこの女気に入ったから暫くのあいだ飼おうぜ♡と男達。そのセリフを聞きながらお掃除フェラ中に射精した男の竿を、何か期待の眼差しながら丁寧に舐めあげる。\n\n◇END\n\n※Ｈシーンの良きところで全裸に剥いてください。\n※基本Ｈ中は他の男達から胸揉まれたりキスされたり手コキやフェラを要求されている状況で。二穴もＯＫ。\n※アンダーヘアは無しでお願いします。\n\n細かい描写などはお任せします。大筋さえ変更なければ書きやすいようアレンジ頂いても大丈夫です。\n\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@karamiyama/works/36", "thumbnail_src": "https://si.imgix.net/9e424e3a/uploads/origins/20f76812-1f9b-4c48-913a-4cf8d4cf61dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f955ff8858a678b6c8a31eb8522558f", "thumbnail_srcset": "https://si.imgix.net/9e424e3a/uploads/origins/20f76812-1f9b-4c48-913a-4cf8d4cf61dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f955ff8858a678b6c8a31eb8522558f, https://si.imgix.net/9e424e3a/uploads/origins/20f76812-1f9b-4c48-913a-4cf8d4cf61dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a79db0a2029b73896116886b528a00f7 2x, https://si.imgix.net/9e424e3a/uploads/origins/20f76812-1f9b-4c48-913a-4cf8d4cf61dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e8523620ee6fe2cdb30d61e5a4a0355 3x", "genre": "comic", "nsfw": true, "body": "■作品・キャラ：デレマスの棟方愛海\n\n■服装：下記のアイドル衣装、それが難しければチアガール衣装\n\n■シチュエーション：\n・背景にライブ映像をモニターで流しながら、正常位でセックスしている\n\n・「ファンもライブ直後にセックスしてるだなんて夢にも思わないだろうな…」\n「マンコめっちゃ締まる…さすが〇学生アイドル」\n「現役アイドルに中出しするの気持ちいい～！」\nみたいなセリフあり\n\n・中出しされ快感で激しく喘いでいる\n\nという流れのコミックをお願いします\n検討して頂けたら幸いです\n\nhttps://imas.gamedbs.