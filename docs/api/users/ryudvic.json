が地面に転がってる感じで)、\n念入りに心臓を抜かれ(胸の中央を切り裂かれ、抜かれて潰された心臓が地面に転がっている感じで)、斬首され生首になったレゼは涙を流しながら死んでいる。\n\nという内容なのですが可能でしたらよろしくお願いしますm(_ _)m\n\n↓キャラの資料です\nレゼ\nhttps://note.com/hiramatsu123/n/n567a226a8aa4\nhttps://chainsawman.dog/movie_reze/character/\nhttps://dic.pixiv.net/a/%E3%83%AC%E3%82%BC", "created_at": "", "completed_at": ""}, {"path": "/@ryudvic/works/16", "thumbnail_src": "https://si.imgix.net/74f2c2a3/uploads/origins/6a9c45ae-4cb2-4366-b2f8-1a6daa51ebbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9dd55cd7373a9992fad36be6fa7e9f02", "thumbnail_srcset": "https://si.imgix.net/74f2c2a3/uploads/origins/6a9c45ae-4cb2-4366-b2f8-1a6daa51ebbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9dd55cd7373a9992fad36be6fa7e9f02, https://si.imgix.net/74f2c2a3/uploads/origins/6a9c45ae-4cb2-4366-b2f8-1a6daa51ebbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34be464fc554892b680235c1d5fa207c 2x, https://si.imgix.net/74f2c2a3/uploads/origins/6a9c45ae-4cb2-4366-b2f8-1a6daa51ebbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68c7c18feb4a9c84bf5731d2be644428 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ryudvic/works/15", "thumbnail_src": "https://si.imgix.net/326e8b12/uploads/origins/d5ac1576-8887-4f35-92a6-a09e543484c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4dfd1f2b445912a52c1cc712ba78dd22", "thumbnail_srcset": "https://si.imgix.ne