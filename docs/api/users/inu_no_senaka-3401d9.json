mgix.net/1cc4d42e/uploads/origins/63e68b09-65ca-45f5-ba61-9382ba4d1132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01fc40172d6f4a5e62178ae85231fa58, https://si.imgix.net/1cc4d42e/uploads/origins/63e68b09-65ca-45f5-ba61-9382ba4d1132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2f02a531db0b1afb6a2f18afdfc83d3 2x, https://si.imgix.net/1cc4d42e/uploads/origins/63e68b09-65ca-45f5-ba61-9382ba4d1132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95c19d41d5272b691afcf80c41f27140 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inu_no_senaka/works/8", "thumbnail_src": "https://si.imgix.net/9b07032e/uploads/origins/61037f38-ab41-41a4-bfde-68bb7d1231da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e8fdc86e50626f83c399e3d559e080e", "thumbnail_srcset": "https://si.imgix.net/9b07032e/uploads/origins/61037f38-ab41-41a4-bfde-68bb7d1231da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e8fdc86e50626f83c399e3d559e080e, https://si.imgix.net/9b07032e/uploads/origins/61037f38-ab41-41a4-bfde-68bb7d1231da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88c5cc00fb1b914a185e8333601a2608 2x, https://si.imgix.net/9b07032e/uploads/origins/61037f38-ab41-41a4-bfde-68bb7d1231da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee9d811352bbef35dba347f9bcbc7e3c 3x", "genre": "art", "nsfw": false, "body": "はじめまして、リクエストさせていただきます。\nhttps://twitter.com/XM7RP7zj4VUbPpQ/status/1614217964185858048?t=sysao_lb0Ny2oscmlSpL3A&s=19\nこれらの写真は私の飼い犬です。名前はテリーといい、とても元気で陽気な犬です。\nよければ、inunose先生によってイラストにしていただきたいです。\n自分と家族用にTシャツにしたいと思っています。", "created_at": "", "completed_at": ""}, {"path": "/@inu_no_senaka/works/7", "thumbnail_src": "https://si.imgix.net/4662b8aa/uploads/origins/bd980267-ff34-4607-a68b-554481178a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52794c8faf5652f801b5b869c3f9f609", "thumbnail_srcset": "https://si.imgix.net/4662b8aa/uploads/origins/bd980267-ff34-4607-a68b-554481178a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52794c8faf5652f801b5b869c3f9f609, https://si.imgix.net/4662b8aa/uploads/origins/bd980267-ff34-4607-a68b-554481178a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cb4febe32ad6dc8e27576acbefd8d1c 2x, https://si.imgix.net/4662b8aa/uploads/origins/bd980267-ff34-4607-a68b-554481178a9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e056ceb35b095682bcd5d87cd3737308 3x", "genre": "art", "nsfw": false, "body": "こんにちは、またまたリクエストを送らせていただきます。今回は、友達の犬のスケッチを2枚お願いします。\n\n彼女の名前はエグジーです。とても不思議で元気な犬です。よくおかしな表情やポーズをするので、そのおかしなエネルギーを写し出してほしいです。\n\n彼女は中型のマルチーズ（マルチーズとプードルのミックス）で、頭にはグレーの毛が生えています。目の周りは毛が濃く、まるでタヌキのような顔をしています。\n\nhttps://curryforest.notion.site/Friends-dog-skeb-references-2cb96e9e890c4492a52c2a698822e0ef", "created_at": "", "completed_at": ""}, {"path": "/@inu_no_senaka/works/6", "thumbnail_src": "https://si.imgix.net/10299641/uploads/origins/b13ae2ec-f8d8-4cfe-9f07-610375daf7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aced9b6431fe6e8c8bb61ae50f07bd21", "thumbnail_srcset": "https://si.imgix.net/10299641/uploads/origins/b13ae2ec-f8d8-4cfe-9f07-610375daf7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aced9b6431fe6e8c8bb61ae50f07bd21, https://si.imgix.net/10299641/uploads/origins/b13ae2ec-f8d8-4cfe-9f07-610375daf7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adc893e6e40cafccf146a864ed58da17 2x, https://si.imgix.net/10299641/uploads/origins/b13ae2ec-f8d8-4cfe-9f07-610375daf7a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d07a0c7b38363cd8f58aa41e620a6501 3x", "genre": "art", "nsfw": false, "body": "こんにちは!私はあなたのアートが大好きです!うちの犬のスケッチをお願いしたいです(:参考写真を何枚か載せておきますので、一番気に入ったものを選んでください。\n\nhttps://curryforest.notion.site/Dog-skeb-references-b4bbd70e17174a43957a7746c8dd2f11", "created_at": "", "completed_at": ""}, {"path": "/@inu_no_senaka/works/5", "thumbnail_src": "https://si.imgix.net/5c505138/uploads/origins/2c7c965b-65a1-499e-9f85-34422f97d066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6929b431380f01aa388ca3f7acf68414", "thumbnail_srcset": "https://si.imgix.net/5c505138/uploads/origins/2c7c965b-65a1-499e-9f85-34422f97d066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6929b431380f01aa388ca3f7acf68414, https://si.imgix.net/5c505138/uploads/origins/2c7c965b-65a1-499e-9f85-34422f97d066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b44c54f3a62b3ac59364712e8a5dd64 2x, https://si.imgix.net/5c505138/uploads/origins/2c7c965b-65a1-499e-9f85-34422f97d066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d713d8e749481d22a50f17402513ce12 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの作品が大好きです。私の犬とその友達を一緒に描いてくれませんか。\n\nhttps://imgur.com/a/2Rxj4TE\n\n私の犬はドンキーという名前で、白いマルチーズ犬です。彼は怠け者で、寝るのが大好きです。また、とても人懐っこく、人間も他の犬も大好きです。いつもニコニコしていて、下の歯が見えています。\nhttps://imgur.com/a/SXS9de6\n\n彼の友人の名前はパニーニです。この犬は、一部が北京犬、ポメラニアン、その他が混ざったものです。いつもハッピーで、賢い犬ではありませんが、とてもキュートでいつも興奮しています。\nhttps://imgur.com/a/A1wfttE\n\n二人は親友で、お互いをとても愛しています。\n\nhttps://imgur.com/a/2Rxj4TE", "created_at": "", "completed_at": ""}, {"path": "/@inu_no_senaka/works/4", "thumbnail_src": "https://si.imgix.net/700ed2f0/uploads/origins/56ca944f-c3cf-416d-8d03-a8d129e6386e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8131af0d26c1f95fbf39d0cb3fceea8b", "thumbnail_srcse