%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247183b4fb965e239de54adb15468d81, https://si.imgix.net/8dd20e62/uploads/origins/ff7cb317-ebe3-4ec1-acc7-44a06d01d55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e10b88e158ef370209dc2af2e207e877 2x, https://si.imgix.net/8dd20e62/uploads/origins/ff7cb317-ebe3-4ec1-acc7-44a06d01d55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0f2a5ef2f5d67ac81a6329beecfc128 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n最近いただいた色紙に描かれていた長髪の□□□くんに一目惚れしてしまい、またリクエストさせていただきました。\n以前のイラストも本当に素敵で、大切にさせていただいております。\n今回は楽しげに振り向く立ち姿で、ルーズサイドテールに結った長髪□□□くんをお願いしたいです。\n\nアクリルスタンド制作用のため、完成サイズは160×160mm以内を想定しております。\n背景透過・3,780 × 3,898(px)以上でお願いできると助かります。\n\nお手数をおかけしますが、どうぞよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/21", "thumbnail_src": "https://si.imgix.net/295a2525/uploads/origins/30608400-4458-43d3-b898-310890536370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78f7b36fb8efbe452c06abb415df5035", "thumbnail_srcset": "https://si.imgix.net/295a2525/uploads/origins/30608400-4458-43d3-b898-310890536370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78f7b36fb8efbe452c06abb415df5035, https://si.imgix.net/295a2525/uploads/origins/30608400-4458-43d3-b898-310890536370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02196c8cf91727768ee701ae5029e90f 2x, https://si.imgix.net/295a2525/uploads/origins/30608400-4458-43d3-b898-310890536370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=434f46640a97e9bf361ba941ff250deb 3x", "genre": "comic", "nsfw": true, "body": "みお先生、こんにちは！先日は素晴らしいイラストをありがとうございました。本当に大好きで、今回また新たなご依頼をさせていただきます。\n\n今回は漫画形式（数コマ程度）でのご依頼を希望しております。\n\n【希望するシナリオ】\n何かの事情で○○が□□□君の部屋に泊まることになり、□□□君はベッドを○○に譲り、自身はソファか床で寝るという設定です。\n夜中、□□□君は自分のベッドの方からかすかな物音で目を覚まします。\n何事かと心配になり、そっとベッドに近づき、布団をめくってみると、○○は布団の中でもぞもと自慰にふけっていました…。\n□□□君はそのまま彼女を手助けして続けるのか、それともその手を止めて代わりに…という流れになるのか…？　その後の□□□君の行動や二人のやり取りは、先生のお好きなように、ご自由にお描きください。\n\nもしご事情によりご依頼をお受けできない場合や、報酬額についてご相談がございましたら、どうぞ遠慮なくお断りください。\nこのシナリオを先生のタッチで描いていただけますなら、大変嬉しく思います。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1XOys4xlojFUxM2ulvGUH6xHPEd0j7rMD?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/20", "thumbnail_src": "https://si.imgix.net/a5750a4c/uploads/origins/5e2cadfb-5bd2-4900-96f6-a45a9dadcf54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=813c1b9ee464083f8b9240f0ba96e22c", "thumbnail_srcset": "https://si.imgix.net/a5750a4c/uploads/origins/5e2cadfb-5bd2-4900-96f6-a45a9dadcf54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=813c1b9ee464083f8b9240f0ba96e22c, https://si.imgix.net/a5750a4c/uploads/origins/5e2cadfb-5bd2-4900-96f6-a45a9dadcf54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c222f63a0fd8bca9c8a2526240e10940 2x, https://si.imgix.net/a5750a4c/uploads/origins/5e2cadfb-5bd2-4900-96f6-a45a9dadcf54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c08569204a1ac11540006cfb76fe52f4 3x", "genre": "art", "nsfw": false, "body": "みお様、こんにちは！とても可愛いらしく素敵な作品を拝見させていただきました。再度リクエスト失礼いたします…！\n今回はオリ志願者ちゃんとカルマくんの夢女子イラストでお願いします，資料URLに画像を添付したので参考にして下さい！\n【ocちゃんの特徴】\n·黒い指輪\n·身長は157cmです\n·制服のネクタイ\n·性格は\nツンデレ、妹系、少しメンヘラ女子\n可能であればすべてお任せでお願いしたく思います。構図やポーズ等任せたいです！\n長文をここまで読んで頂き、ありがとうございました。何卒ご検討いただければと思います！\n\nhttps://drive.google.com/drive/folders/1NyBVoarKThEEgjBf7tgM154S_eREk2Eq", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/19", "thumbnail_src": "https://si.imgix.net/e36e7421/uploads/origins/76a16446-663f-494a-ae36-6a40e78287ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ead437c856c829aca9f4b47893693b38", "thumbnail_srcset": "https://si.imgix.net/e36e7421/uploads/origins/76a16446-663f-494a-ae36-6a40e78287ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ead437c856c829aca9f4b47893693b38, https://si.imgix.net/e36e7421/uploads/origins/76a16446-663f-494a-ae36-6a40e78287ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa67da8df7b5639cb2ba207747018acc 2x, https://si.imgix.net/e36e7421/uploads/origins/76a16446-663f-494a-ae36-6a40e78287ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfbd73d9f36c61480dfd43c3e563be43 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/18", "thumbnail_src": "https://si.imgix.net/f3007411/uploads/origins/716cc977-76fa-4d19-bcc9-c83c10f178eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0aaa3df2e0464548935bd6ba83f4701", "thumbnail_srcset": "https://si.imgix.net/f3007411/uploads/origins/716cc977-76fa-4d19-bcc9-c83c10f178eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0aaa3df2e0464548935bd6ba83f4701, https://si.imgix.net/f3007411/uploads/origins/716cc977-76fa-4d19-bcc9-c83c10f178eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c02ac206d040c82f89eb23ab56436ec8 2x, https://si.imgix.net/f3007411/uploads/origins/716cc977-76fa-4d19-bcc9-c83c10f178eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=884151d9ee4231dde661ed2b05d8f37a 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは！私はmayuと申します。  最近【私が死ぬための乙女ゲーム】のデモ版を試しに遊んでみて、先生の作品スタイルがとても気に入ったので、個人使用のOCイラストを依頼したいです！\n\nOC設定はちょっとツンデレな猫系の小柄な女の子で、背中に赤いぬいぐるみのうさぎバッグを背負っています！構図やポーズは特に考えていませんが、推しキャラがカルマくんなので、デモ版のCGのように屋上から地面で両手を広げているカルマくんを見下ろす視点の絵が欲しいです！他には特に要望はありません！\n\nhttps://drive.google.com/file/d/1SYFRHfrY9CF2PH4dJyxRv8_n--7SaprX/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/17", "thumbnail_src": "https://si.imgix.net/feea0a2d/uploads/origins/76575719-0a63-4ffe-8993-4d6b836d04af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=149493d897f57f565a7b41ef91549481", "thumbnail_srcset": "https://si.imgix.net/feea0a2d/uploads/origins/76575719-0a63-4ffe-8993-4d6b836d04af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=149493d897f57f565a7b41ef91549481, https://si.imgix.net/feea0a2d/uploads/origins/76575719-0a63-4ffe-8993-4d6b836d04af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ee8d8fc1b564990f6e19dd05bc1aaeb 2x, https://si.imgix.net/feea0a2d/uploads/origins/76575719-0a63-4ffe-8993-4d6b836d04af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70779e71eff094d9ccee41bcdcf48b6a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。今回も□□□くんのイラストをお願いできたらと思い、ご依頼させていただきました。\n\n今回リクエストさせていただきたいのは、□□□くんを組み敷いた構図です。\n視点は□□□くんを見下ろすようなアングルで、両手は頭上で拘束されているような状態（例：手錠など）を希望します。\n首元には名前入りのプレートがついた首輪があり、シャツは胸元と裾がはだけて、乳首とおへそが覗く「着ているのに見えてしまう」状態をイメージしています。\n\n表情は、恥じらいを見せるか、あるいは嘲笑しながら煽るような色気のあるものを希望します。\n特に「どうせ、こういうのが好きなんでしょ？」という雰囲気があると、とても嬉しいです。\n\n細かい部分はおまかせいたしますので、描きやすいようにご調整いただければ幸いです。\n\n※今回のリクエストはセンシティブな内容を含みますので、ご無理のない範囲でご対応いただけますと幸いです。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/16", "thumbnail_src": "https://si.imgix.net/4e690e07/uploads/origins/41f49b18-8f36-4337-aea9-7a6223e4971e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b8360f0b38bc9d35984ffc58ec7fcf", "thumbnail_srcset": "https://si.imgix.net/4e690e07/uploads/origins/41f49b18-8f36-4337-aea9-7a6223e4971e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b8360f0b38bc9d35984ffc58ec7fcf, https://si.imgix.net/4e690e07/uploads/origins/41f49b18-8f36-4337-aea9-7a6223e4971e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69c54e2a7ca3e0c94cf9a90073af01a1 2x, https://si.imgix.net/4e690e07/uploads/origins/41f49b18-8f36-4337-aea9-7a6223e4971e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05d8658e36a28c0ea89d175ff9bd5576 3x", "genre": "art", "nsfw": false, "body": "はじめまして。リクエスト失礼します！\nもしよろしければ執事服の□□□くんのイラストを描いていただきたいです！\n構図、ポーズ、サイズはお任せで使用用途としてはお部屋に飾らせていただきたいと思っております。\nもしよろしければよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/15", "thumbnail_src": "https://si.imgix.net/6a09b71e/uploads/origins/42b79a4a-0eb8-4ff4-ae3a-eeb2e983ea6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f6d804bbb62caf473b9ea121890fd7e", "thumbnail_srcset": "https://si.imgix.net/6a09b71e/uploads/origins/42b79a4a-0eb8-4ff4-ae3a-eeb2e983ea6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f6d804bbb62caf473b9ea121890fd7e, https://si.imgix.net/6a09b71e/uploads/origins/42b79a4a-0eb8-4ff4-ae3a-eeb2e983ea6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7466ace561db1125f815f06292311d40 2x, https://si.imgix.net/6a09b71e/uploads/origins/42b79a4a-0eb8-4ff4-ae3a-eeb2e983ea6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c238903e127abc173d824c5720d6a9bb 3x", "genre": "art", "nsfw": false, "body": "画面の向こうを見つめ、軽蔑や怒りを感じさせる表情をしている□君をみおさんの絵で見たいです...\n\n参考の雰囲気としては、フェイタルエラーの「どの口が？ どの面で？ を言うときの□君ならどんな表情になるかな、くらいです！とにかくプレイヤーに怒りまくっている、あるいは辟易している表情であればなんでもいいです........\n\nよろしくお願いします!!! (*•̀ᴗ•́*)و ̑̑", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/14", "thumbnail_src": "https://si.imgix.net/742c17ac/uploads/origins/92d2611b-a420-4b70-aae7-17fcceeba5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4abc22bddb0f6bb98e83bbce830c0