ated_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/12", "thumbnail_src": "https://si.imgix.net/0955f49e/uploads/origins/7fa655e3-d749-4e32-9a21-58118c884876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5a0aa59d32603489b2e2f3f77d498f0", "thumbnail_srcset": "https://si.imgix.net/0955f49e/uploads/origins/7fa655e3-d749-4e32-9a21-58118c884876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5a0aa59d32603489b2e2f3f77d498f0, https://si.imgix.net/0955f49e/uploads/origins/7fa655e3-d749-4e32-9a21-58118c884876?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fb19a4573abd65cfe1ca3e712695714 2x, https://si.imgix.net/0955f49e/uploads/origins/7fa655e3-d749-4e32-9a21-58118c884876?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=022a3e7a73fc3b1f6c0a67e99bfced12 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mimiomio_bungo/works/11", "thumbnail_src": "https://si.imgix.net/7176e430/uploads/origins/fd37d83c-5a70-4899-9292-9f8777675bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54250bd026280f6c2ff888acf53ffa1b", "thumbnail_srcset": "https://si.imgix.net/7176e430/uploads/origins/fd37d83c-5a70-4899-9292-9f8777675bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54250bd026280f6c2ff888acf53ffa1b, https://si