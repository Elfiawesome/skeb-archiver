36b-4d19-8c9b-f8a991825c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bbaff4c9d37b401a81c497d853d0799", "thumbnail_srcset": "https://si.imgix.net/dd8a4c56/uploads/origins/065062eb-036b-4d19-8c9b-f8a991825c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bbaff4c9d37b401a81c497d853d0799, https://si.imgix.net/dd8a4c56/uploads/origins/065062eb-036b-4d19-8c9b-f8a991825c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d87d87b4a553fe61b2619e65cb010922 2x, https://si.imgix.net/dd8a4c56/uploads/origins/065062eb-036b-4d19-8c9b-f8a991825c0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a6edf86c2b2759c7bee5a13c4d5b047 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍するトラッパー系キャラです。\n陽気で工作好きな女性です。\n羽のある浮いてるメカはサポートマシンです。\n（ペットみたいなもんです＾＾可能ならこいつも入れていただけると嬉しいです）\n衣装はそのまま系でも日常私服系でも良いです。\n\n使用したい範囲は\n自前の紹介サイトや、ＳＮＳでの掲載となります。\nトリミング使用もしたいと考えているので\n合わせて問題ないか御確認ください！\n\n私服参考↓\nhttps://x.com/oniyatsuhashi/status/1622200146229399553\n\n以前にちょっとした\nマンガも描いてもらいましたので\n彼女の雰囲気の参考にしてください。↓\nhttps://x.com/oniyatsuhashi/status/1726563391018586547?s=20\n\n御面倒かけますが\nよろしく御検討ください！\n\nhttps://twitter.com/oniyatsuhashi/status/1695730234216362101?s=20", "created_at": "", "completed_at": ""}, {"path": "/@naaaaaaco369/works/7", "thumbnail_src": "https://si.imgix.net/3e1948a0/uploads/origins/34b4a51c-a5f6-4bb1-a408-f2e5db8b7604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=746928f0b4e38a370c176967e7ee3758", "thumbnail_srcset": "https://si.imgix.net/3e1948a0/uploads/origins/34b4a51c-a5f6-4bb1-a408-f2e5db8b7604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=746928f0b4e38a370c176967e7ee3758, https://si.imgix.net/3e1948a0/uploads/origins/34b4a51c-a5f6-4bb1-a408-f2e5db8b7604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=972f86cc496a56f4227127c8e425e1ad 2x, https://si.imgix.net/3e1948a0/uploads/origins/34b4a51c-a5f6-4bb1-a408-f2e5db8b7604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=552ec9b9224d96dbd7b8123247d5aa4a 3x", "genre": "art", "nsfw": false, "body": "こんにちは、初めてです。\n翻訳が不正確で申し訳ありません。\n私はあなたの作品がとても好きで、キャラクターの表情や動きのシリーズが好きなので、あなたの作品を一枚描いてほしいです。\nあなたの作品からポートフォリオページを依頼したいです。\n 以下は私のOOC参考図面です。\n https://drive.google.com/file/d/1A4gSiDBwLHOSm_Y1loVUi_wZHXMpkqKZ/view?usp=share_link\n 最初に好きな服を選んでもいいし、同時にたくさんの服を描いてもいい。\nOCキャラクター：女性：17歳の女の子、イエローオレンジの髪、カジュアルな前髪、ダラダラしている、表情が豊か、熱心な子、先生は表情も動きも自由にさせてください。\n用途：個人的\n 今回もお読みいただき、ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@naaaaaaco369/works/6", "thumbnail_src": "https://si.imgix.net/90de0288/uploads/origins/01b200d1-4062-4dc7-987b-d0f5a7530134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4435a9b1cd99b2cbf53b095865f7cb8", "thumbnail_srcset": "https://si.imgix.net/90de0288/uploads/origins/01b200d1-4062-4dc7-987b-d0f5a7530134?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4435a9b1cd99b2cbf53b095865f7cb8, https://si.imgix.net/90de0288/uploads/origins/01b200d1-4062-4dc7-987b-d0f5a7530134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8da5ac55514ab70c75fa761fe6c97e98 2x, https://si.imgix.net/90de0288/uploads/origins/01b200d1-4062-4dc7-987b-d0f5a7530134?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1299af002d209e7d79856ec01642ac0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！猫娘アイドルのルマとルカの絵をお願いしたいのです。二卵性の双子で、性格は正反対です。二人とも15歳です。ルマは大人っぽく見られたいと思っていて、真面目で、よく鼻持ちならないお姫様のように振る舞います。ルカは遊び好きで子供っぽく、同い年なのにルマの妹のように振る舞う。ルマは控えめで飄々としているが、ルカは社交的で積極的だ。ルマは服の露出が多いとすぐに自意識過剰になるが、ルカは自信を持って何でも着る。\n\nそんな二人がポーズをとっている写真撮影を依頼したい。ポーズ、表情、服装、髪型は自由です。好きなだけクリエイティブにしてください。彼らの猫耳としっぽは本物で、人間の耳はありません。\n\nhttps://imgur.com/a/luma-ruka-p4UnAnj", "created_at": "", "completed_at": ""}, {"path": "/@naaaaaaco369/works/5", "thumbnail_src": "https://si.imgix.net/569d19c7/uploads/origins/b41e5ded-c10c-4b9b-86bd-2b2e6560bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c446d0f8ade1c876eeaf46cf6f7095b1", "thumbnail_srcset": "https://si.imgix.net/569d19c7/uploads/origins/b41e5ded-c10c-4b9b-86bd-2b2e6560bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c446d0f8ade1c876eeaf46cf6f7095b1, https://si.imgix.net/569d19c7/uploads/origins/b41e5ded-c10c-4b9b-86bd-2b2e6560bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5fc12545a1a6b3972c6c185472b32e0 2x, https://si.imgix.net/569d19c7/uploads/origins/b41e5ded-c10c-4b9b-86bd-2b2e6560bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8a3d6b24b5fbb1a0f5af7c5d83f5904 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートは美しいですね。\n\n私のキャラクターを描いてもらえませんか？マンタ、生物発光をイメージしたキャラクターです。角、尻尾、マーク、耳の内側はすべて光る水でできています。性格は、ドSで、遊び好きで、セクシーで、クールです。ポーズや表情はお任せします。\n\n以前あなたが作ったこのスケブと同じようなスタイルで描いてください。https://skeb.jp/@naaaaaaco369/works/1\n\nキャラクターリファレンス：https://imgur.com/a/G7gDcD3\n\nありがとうございます！^-^", "created_at": "", "completed_at": ""}]}