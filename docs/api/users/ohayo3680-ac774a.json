origins/835bf176-7a7f-4e5f-9ee6-7959efb72aca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bdc9bc94fa6f003e2b3970e80a21c81 2x, https://si.imgix.net/551920cc/uploads/origins/835bf176-7a7f-4e5f-9ee6-7959efb72aca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9624065a6822a6d5965147c9a21243d8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ohayo3680/works/21", "thumbnail_src": "https://si.imgix.net/634567b5/uploads/origins/76c890ba-75bd-4e8f-8803-51b83b383f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f19132b6b2958b0904897552c924a7f", "thumbnail_srcset": "https://si.imgix.net/634567b5/uploads/origins/76c890ba-75bd-4e8f-8803-51b83b383f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f19132b6b2958b0904897552c924a7f, https://si.imgix.net/634567b5/uploads/origins/76c890ba-75bd-4e8f-8803-51b83b383f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47fb9be8a5bb61484631a8aeb8164256 2x, https://si.imgix.net/634567b5/uploads/origins/76c890ba-75bd-4e8f-8803-51b83b383f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9da04b8251de933e195501fdeba29463 3x", "genre": "art", "nsfw": false, "body": "文字様の連載していた漫画「１日1枚脱ぐJS」のキャラクターよりリクエストします！\n「魔が差してJSちゃんのタイツを履いてしまった語り手の男の子」のイラストをお願いできたらな、と思います。\n\n以下シチュエーション。\n洗濯をしている途中、JSちゃんのタイツを目にした男の子が「…そういえば、タイツってどんな履き心地なんだろう？」とか考えてしまった結果、それを着用してちょっといけない気持ちになっている、という流れ。\n\nタイツの伸縮性がギリギリ男の子の身長にフィットするぐらいまであると考えて、腰までしっかり履いた状態でお願いします。\n\nイラストは、タイツを着用して体育座りをしながら、片手は爪先、もう片方の手は脛あたりをすべすべと触りながら「めっちゃ窮屈だけど、なんか…気持ちいい。」と言っている場面を描いてくれると嬉しいです🙏🙏🙏\n\n男の子のタイツ以外の服装は25話で着ていたのと同じ感じで、顔は決まっていなければ描かなくても大丈夫ですが、可能ならば描いてくださると泣いて喜びます。(あの子は絶対かわいい顔してる…😇😇😇)\n\nイラストの