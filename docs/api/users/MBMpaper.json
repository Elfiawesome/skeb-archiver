fced6bacb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a694c2f74f678776fb0bc47aa5600995, https://si.imgix.net/b1f43ee3/uploads/origins/489eceb0-e9c5-4e09-9ae9-ce0fced6bacb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1a3a14e3bea93fcce97b0f66856b43d 2x, https://si.imgix.net/b1f43ee3/uploads/origins/489eceb0-e9c5-4e09-9ae9-ce0fced6bacb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4051b0e1c138f07a4a57b979b95c180b 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n\nこの二人のオリジナルキャラクターのシーンを描いていただけませんか？ヴィクトリア朝（1890年代）のTRPG「コール・オブ・クトゥルフ（CoC）」の設定です。家を持たず、一緒に路上生活をしている親友です。カルト教団の一員で怖い子供たちです。\n\n茶髪の少年シェイは物静かで、普段は無表情か、小さく謎めいた笑みを浮かべている。アロイスをとてもかわいがっている。\n金髪の少年アロイスは大胆でおしゃべり。彼の表情はいつも満面の笑みだ。\n\n以下のようなシーンが考えられます（描きたくなければ描かなくてもかまいません）：\n- 廃墟となった教会を一緒に探検\n- ロウソク、ナイフ、血を使った怖いカルトの儀式を行っている。\n- 怖いモンスターと戦ったり隠れたりしている。\n- お好きなシーン\n\nいずれにせよ、読んでくれて本当にありがとう！\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@MBMpaper/works/2", "thumbnail_src": "https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee711c4c5a583809dcf8ce5c21af57f8", "thumbnail_srcset": "https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee711c4c5a583809dcf8ce5c21af57f8, https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb14b633373be842c7e8129509af442e 2x, https://si.imgix.net/9df48703/uploads/origins/23aa2d1c-2587-4878-b568-0862206133d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc8e4ab51acf21a96611d1fb3bfed623 3x", "genre": "art", "nsfw": false, "body": "はじめの一歩の木村達也をお願いします！", "created_at": "", "c