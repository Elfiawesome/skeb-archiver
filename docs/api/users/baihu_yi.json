のイメージです。\n・おくち霊殿の水橋パルスィみたいな構図のイメージです。\n・可能ならPSDでレイヤー分けあれば。\n\nhttps://www.pixiv.net/artworks/136805842", "created_at": "", "completed_at": ""}, {"path": "/@baihu_yi/works/23", "thumbnail_src": "https://si.imgix.net/63e50d95/uploads/origins/8493bb85-fc35-4404-b74c-24de79c49056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d724fac9dc4a65420392d3f87e0c8fd", "thumbnail_srcset": "https://si.imgix.net/63e50d95/uploads/origins/8493bb85-fc35-4404-b74c-24de79c49056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d724fac9dc4a65420392d3f87e0c8fd, https://si.imgix.net/63e50d95/uploads/origins/8493bb85-fc35-4404-b74c-24de79c49056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02123dea30260a1ec3f85612c8f71b6d 2x, https://si.imgix.net/63e50d95/uploads/origins/8493bb85-fc35-4404-b74c-24de79c49056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40d3b9da8240932ab619ac1a44638c49 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@baihu_yi/works/22", "thumbnail_src": "https://si.imgix.net/52bbb992/uploads/origins/46adde8e-51f3-4b95-ada7-9c3fa154f9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ca40186cfb4a20f3f6060f6dadc9018", "thumbnail_srcset": "https://si.imgix.net/52bbb992/uploads/origins/46adde8e-51f3-4b95-ada7-9c3fa154f9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ca40186cfb4a20f3f6060f6dadc9018, https://si.imgix.net/52bbb992/uploads/origins/46adde8e-51f3-4b95-ada7-9c3fa154f9c3?bg=%23fff&auto=f