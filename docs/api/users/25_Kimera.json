fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f65e1b4547fe891c204390889da248ff 2x, https://si.imgix.net/8089f67f/uploads/origins/f2677a29-097b-4f2d-a555-6a8d585fc20c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9eca16e80e6087174dba3c31f46b295 3x", "genre": "art", "nsfw": false, "body": "こんにちは、素晴らしい友人よ！またお願いできて光栄です！\n\nehebaiさんの新しいOC、Lyraをリクエストさせていただきます！彼女は遊び好きで、人をからかうのが好きで、でも優しい女性です！\n\n親友の皆さん、本当にありがとうございました！🥹\n\nhttps://www.dropbox.com/scl/fo/rkn96v91nlp5kjw7u7z7o/ALnYLqRLMQ2gSXXaml0cDLM?rlkey=tchn2r2f0w4bf8j65k3di66jf&st=469zi8ou&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@25_Kimera/works/51", "thumbnail_src": "https://si.imgix.net/d356e628/uploads/origins/c7682ab4-7a39-4ec7-9009-378da1a8bbe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef92877bb0533dd1cac949b024ae410e", "thumbnail_srcset": "https://si.imgix.net/d356e628/uploads/origins/c7682ab4-7a39-4ec7-9009-378da1a8bbe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef92877bb0533dd1cac949b024ae410e, https://si.imgix.net/d356e628/uploads/origins/c7682ab4-7a39-4ec7-9009-378da1a8bbe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=018c7effcf62063a8c764e473b32f0b3 2x, https://si.imgix.net/d356e628/uploads/origins/c7682ab4-7a39-4ec7-9009-378da1a8bbe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09ad624306a9ffa043bd69dc427fdfe9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私の2人のOC、ソリーナとマイラ、そしてとても大きな蛇の仲間、サラマンドラとケイティラのイラストをお願いしたいです。  2人の女の子は背中合わせに立って、ポーズをとって、見る人を見ていてほしいです。  2人とも微笑んでいてもいい。  2人とも筋肉質な体格だが、ソリーナの方が背が高く、マイラは肩までしかない。  また、ソリーナには蛇のような裂けた瞳孔があるが、マイラにはない。  赤い蛇はソリーナの仲間で、紫の蛇はマイラの仲間だ。  蛇はそれぞれのパートナーの横に巻きつくことができる。\n\nできれば背景はシンプルなジャングルにしたいが、シンプルなものでも構わない。\n\nhttps://www.dropbox.com/scl/fo/e669ojpz8e43fcwj002b7/AMvAzH4AzrJ0wdaEPfKP6oA?rlkey=8kmh18pzwp4ubu4g8zdm1b70b&st=vdo1mi37&dl=0", "created_at": "", "completed_at": ""}, {