b0-4511-9778-d47423f33860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f7c96b8fa57a6b0cab6a2b020437ba5", "thumbnail_srcset": "https://si.imgix.net/f2f1beb8/uploads/origins/d2a9b050-60b0-4511-9778-d47423f33860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f7c96b8fa57a6b0cab6a2b020437ba5, https://si.imgix.net/f2f1beb8/uploads/origins/d2a9b050-60b0-4511-9778-d47423f33860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=586ee401cfca41cdeee656532f13f37f 2x, https://si.imgix.net/f2f1beb8/uploads/origins/d2a9b050-60b0-4511-9778-d47423f33860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0b44edb97a2002d972d0ecb64d1b411 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。ぞうと申します。\n\nべつこさんのイラストや立ち絵の、カッコよくも色気のあるキャラクターメイクや絵柄、鮮やかかつ艶やかな色遣い、生き生きとした表情(シナリオでも差分がたくさん…！)など、本当にいつも素敵でみとれております…！！素敵だ！！\n\nskeb開けてらっしゃるとのことで、\n良かったら、BLOODWOLF-OZを通過した自PCを、一枚絵で描いていただけないか…！とご依頼に上がった次第です。\n立ち絵はURLのキャラシメモ欄に、ツイッターの該当ツイートURL記載しています。\n構図・シチュエーションなどは、もしよろしければお任せしたいなと思っております。\n（サブマシンガンを持っているのでぶっ放していただいたり、ネタバレにはなりますが、某ラストシーンボスとのイラストも嬉しいな、と思っております…！\n服装は、はだけててもはだけてなくても大丈夫です。服装に指定もございません。基本的には、青い色の服を好んでいると思います。）\n以前お邪魔させていただいたとき、ウルオズとてつもなく楽しくって…最高で…！\n最高に幸せになり、この機会に自PC（＋可能ならNPC）イラストも拝見したい！（欲張り）と、ご依頼させていただきました。\n\n他の方からのご依頼などもあったり、ご多忙かとも思いますので、\nご無理のない範囲でご検討いただければ幸いです。(難しい状態や、内容に不備があればお気兼ねなく断っていただいて大丈夫です…！)\n\nお手隙の際にでも、ご確認とご検討の程、何卒よろしくお願いいたします。\n\nhttps://charasheet.vampire-blood.net/m6132e78a71928e589cf8a5bfdb5989df", "created_at": "", "completed_at": ""}, {"path": "/@XpXDXQ/works/4", "thumbnail_src": "https://si.imgix.net/7ab8a655/uploads/origins/9bdbdc0c-5a0b-4851-96ac-e773adc9a475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e8b9e7d8c8e39f8e88cdcb8b4417c14", "thumbnail_srcset": "https://si.imgix.net/7ab8a655/uploads/origins/9bdbdc0c-5a0b-4851-96ac-e773adc9a475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e8b9e7d8c8e39f8e88cdcb8b4417c14, https://si.imgix.net/7ab8a655/uploads/origins/9bdbdc0c-5a0b-4851-96ac-e773adc9a475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8266402474f36e33763d9313a4c80128 2x, https://si.imgix.net/7ab8a655/uploads/origins/9bdbdc0c-5a0b-4851-96ac-e773adc9a475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=02846b8250a125d9413a2abc7c328f40 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@XpXDXQ/works/3", "thumbnail_src": "https://si.imgix.net/9b702661/uploads/origins/7ea61555-b41d-4450-9bb2-aad0a2114017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76580e39f45f09e51b5e379746653ee4", "thumbnail_srcset": "https://si.imgix.net/9b702661/uploads/origins/7ea61555-b41d-4450-9bb2-aad0a2114017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76580e39f45f09e51b5e379746653ee4, https://si.imgix.net/9b702661/uploads/origins/7ea61555-b41d-4450-9bb2-aad0a2114017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7bffc5182e0049037e91ca7381c4367 2x, https://si.imgix.net/9b702661/uploads/origins/7ea61555-b41d-4450-9bb2-aad0a2114017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3442cf1bab32e719be49851f47cf67b 3x", "genre": "art", "nsfw": false, "body": "「救う神あれば捨てる神あり」NPCの松崎知晴をお願いいたします。\n\nKPレスシナリオ「LastResort」で一緒に枝垂れ桜を見ている所がとても印象的でしたので、そのシーンの彼をイメージして描いて頂けたら、と思います。\n無理なようでしたら作者様の自由に描いて頂けたら幸いです。服装や構図などは作者様にお任せいたします。\n\n初めてのリクエストなのでこれで大丈夫なのかとても不安ですが、どうぞ宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@XpXDXQ/works/2", "thumbnail_src": "https://si.imgix.net/181ae412/uploads/origins/03d8eb3b-4611-4ec8-9e2c-f09618b3acdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d4f352215839ba2697ef4de9a282006", "thumbnail_srcset": "https://si.imgix.net/181ae412/uploads/origins/03d8eb3b-4611-4ec8-9e2c-f09618b3acdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d4f352215839ba2697ef4de9a282006, https://si.imgix.net/181ae412/uploads/origins/03d8eb3b-4611-4ec8-9e2c-f09618b3acdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fd58ec60b7a55b99d75fba36e373c94 2x, https://si.imgix.net/181ae412/uploads/origins/03d8eb3b-4611-4ec8-9e2c-f09618b3acdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8beb26c6df5b7e132ad9e95933f091b9 3x", "genre": "art", "nsfw": false, "body": "いつも楽しく拝見させていただいております。でそったと申します。\nスケブ開設されたと聞きまして、恐れ多くもリクエストを送らせていただきます…！\n\n内容といたしましては、\nいりたまご様のシナリオ「きみは100億万ドル」に出させていただきました【富豪探索者のイラスト】をお願いしたいです…！\nV系バンドマンをやっている富豪なので、ブロマイドやジャケ写のようなイメージですと、凄く嬉しいです…！\n\n上記の探索者に関しましては、\n【アンリ・ルボア・ルシフェル3世】という名前の堕天使（V系バンドマン）な大富豪でして…\nハニーは他の探索者に落札されて惨敗したのですが、その後も元気にライブ会場を薔薇で埋め尽くしています。\n【資料URL】にいあきゃらへのリンクを貼らせていただきましたので、キャラの外見やトンチキな設定のご参考までご覧いただけますと幸いです。\nいあきゃらのアイコンはピクルーのメーカーで作成したもののため、衣装や装飾などはご自由に改変していただいて大丈夫です！素敵な✝️堕天使✝️にしてくださいませ…！\n\n\n最後に、100億万ドル本当に楽しかったです…！！！ありがとうございます！！\n『冥界の逢瀬』や『熱情含有チョコレート』も最高でした！『カオガイインジャー』もこれから富豪でハニーを巡って争った卓メンたちとPL参加するのですが楽しみで仕方ありません！シナリオは買ってあるので通過後にニタニタしながら読みます！\n\nお手隙の際で構いませんので、リクエスト受けていただけましたら幸いです。\n何卒よろしくお願いいたします！\n\nhttps://iachara.com/char/488410/view", "created_at": "", "completed_at": ""}, {"path": "/@XpXDXQ/works/1", "thumbnail_src": "https://si.imgix.net/030af09c/uploads/origins/256d6f2b-b7d7-48a1-af5f-e6c0c5e20f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a08ce41903d24e1e248c42ca45171e33", "thumbnail_srcset": "https://si.imgix.net/030af09c/uploads/origins/256d6f2b-b7d7-48a1-af5f-e6c0c5e20f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a08ce41903d24e1e248c42ca45171e33, https://si.imgix.net/030af09c/uploads/origins/256d6f2b-b7d7-48a1-af5f-e6c0c5e20f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a46caedca7a32d0638ce3cd919887db 2x, https://si.imgix.net/030af09c/uploads/origins/256d6f2b-b7d7-48a1-af5f-e6c0c5e20f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7a8877e6acade179f6ee37606728eb3 3x", "genre": "art", "nsfw": false, "body": "べつこさんこんにちは！スケブを開設されたと伺いルンルンで参りました！\n\nお手隙の際で結構ですので、べつこさんの絵柄のかなきみ自陣が見たいです！！！正直かなきみめちゃくちゃ楽しかったし開くんの陰キャ具合にニコニコしちゃうので（？）何卒…何卒…\n\n構図などはおまかせでもよいでしょうか？なんかこう、わちゃわちゃー！たのしー！って感じだと私も楽しくなります！\n\nご検討よろしくお願いします〜！\n\nhttps://twitter.com/osato_trpg/status/1310298615068332032?s=19", "created_at": "", "completed_at": ""}]}