64f577f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39bb5457c11469c4ce0e47ef3336831e 2x, https://si.imgix.net/4aac4a08/uploads/origins/e61b9f84-e2a4-4f23-8681-843964f577f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6b0e83274bc4325dea2ee548d8ccc4c 3x", "genre": "art", "nsfw": false, "body": "ななかわ様\nはじめまして配信のための立ち絵を書いてもらえる人を探しておりましてskebのところでイラストを拝見させていただきました。\nそこでイラストを頼みたいと思いリクエストさせていただきました。\n\n洋服の参考画像はURLで送ります\n髪型はロングでストレートで髪色は上の方がを水色っぽい色で下の方がピンク色でお願いします。\n髪型はアニメのモニカエバレットていうキャラがいるんですけどそのような感じで髪の結び目のとこはちょっと紐長めのリボンにして猫耳をつけてください。\n\n表情と構図はおまかせでお願いします。\n出来ればでいいので3面図などもあればうれしいです。\n\n使用用途\nSNSのアイコンと配信活動に使用したいと考えています。\nまた、リアルグッズなど、壁紙などに使用することも考えています。\n\n内容などが合わなければキャンセルしてもらっていいのでなにとぞよろしくお願いします。\n\nhttps://photos.app.goo.gl/NiXRPGM29Dqo4xjk8", "created_at": "", "completed_at": ""}, {"path": "/@Nanakawa_7/works/2", "thumbnail_src": "https://si.imgix.net/db63aa96/uploads/origins/5fc449fd-b8b8-4d4b-af92-7b3b065647ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b585c1a45ba283518b5172bc3cc91c9e", "thumbnail_srcset": "https://si.imgix.net/db63aa96/uploads/origins/5fc449fd-b8b8-4d4b-af92-7b3b065647ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b585c1a45ba283518b5172bc3cc91c9e, https://si.imgix.net/db63aa96/uploads/origins/5fc449fd-b8b8-4d4b-af92-7b3b065647ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5ad06472df36588177f86a3cda4d67c 2x, https://si.imgix.net/db63aa96/uploads/origins/5fc449fd-b8b8-4d4b-af92-7b3b065647ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fae111db7aff507d75720c2f303043c 3x", "genre": "art", "nsfw": false, "body": "あなたの絵はとてもきれいです！\n片方の腕でスカートを持ち、もう片方の腕で胸を支え、爪は薄く透けるような白に塗ってください。髪は真っ赤！適度な胸！髪の長さは少し長めで、特に後ろ髪は長めにしてください！スカートは少しふわっとさせてください。繊細な晴れ着と鮮やかな赤い髪の魅力が引き立つように。\n彼女は暖かく、優しく、親しみやすいと感じるはずです、\n私は色盲なので、彼女の髪はとても赤くしてほしい（茶色やオレンジに近くない）。\nキュートなサンドレス、オフショルダーの袖、ドレスにアクセントをつけ、適度な胸が欲しい！\nドレスは白で、淡い花柄にしてください。\n髪は少し長めで、特に後ろ髪は長めにしてください！  \nティアラは必ずつけてください。\nhttps://imgur.com/a/iNUM5cF\n\nhttps://imgur.com/a/iNUM5cF", "created_at": "", "completed_at": ""}, {"path": "/@Nanakawa_7/works/1", "thumbnail_src": "https://si.imgix.net/f0bb635d/uploads/origins/5caaf5fc-c36f-484a-a126-6f309f303f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6794fd2bb513cbf64c0fe17e62997c18", "thumbnail_srcset": "https://si.imgix.net/f0bb635d/uploads/origins/5caaf5fc-c36f-484a-a126-6f309f303f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6794fd2bb513cbf64c0fe17e62997c18, https://si.imgix.net/f0bb635d/uploads/origins/5caaf5fc-c36f-484a-a126-6f309f303f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c158d80018f47c66b331e0322a6e753f 2x, https://si.imgix.net/f0bb635d/uploads/origins/5caaf5fc-c36f-484a-a126-6f309f303f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2254117b6e5ebfbf7f23f9d9c364a008 3x", "genre": "art", "nsfw": false, "body": "ななかわ@Skebはじめました！様\n突然のご連絡失礼致します。\nIRIAMで配信をしております、葉月栞帆（はづき しほ）と申します。\nななかわ@Skebはじめました！様に新しい立ち絵を描いていただきたくリクエストを送らせていただきました。\n \n 資料は↓をご確認ください。\n \n現在の立ち絵\n【https://drive.google.com/file/d/1ASHIbWJK_IiScax5jFaKaOMpAq2znoBv/view?usp=drivesdk】\n \n 表情や構図などおまかせいたしますので、自由に描いてください！\n \n 内容が合わなければキャンセルしていただいて大丈夫です。\n お忙しい中恐れ入りますが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}]}