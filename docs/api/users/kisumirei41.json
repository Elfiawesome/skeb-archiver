leted_at": ""}, {"path": "/@kisumirei41/works/59", "thumbnail_src": "https://si.imgix.net/57f32a99/uploads/origins/5d1d6886-d159-4ccd-84be-353944ffd845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916028ad740f6280b01c5a0d558d1223", "thumbnail_srcset": "https://si.imgix.net/57f32a99/uploads/origins/5d1d6886-d159-4ccd-84be-353944ffd845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=916028ad740f6280b01c5a0d558d1223, https://si.imgix.net/57f32a99/uploads/origins/5d1d6886-d159-4ccd-84be-353944ffd845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1e9ae5bc121b47335f1ec140c75c32e 2x, https://si.imgix.net/57f32a99/uploads/origins/5d1d6886-d159-4ccd-84be-353944ffd845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51654ba4f91935c30a1442edc4a7bf0b 3x", "genre": "art", "nsfw": false, "body": "初めまして、Xにて木澄 玲生様の鮮やかなイラストに一目惚れして是非お願いさせて頂きたいと思いました。\n私の推しでVtuberとして活動されている時庭らんぜさん(https://x.com/ranze_t_BW)のイラストをリクエスト致します。\n\n・収益化済みYouTubeやXなどのプロモーションに使用する可能性がございます\n・構図、表情などはお任せ致します。\n・背景、人物はレイヤーを分けて、PSDデータでいただけますとありがたいです。\n・Xに投稿する際にウォーターマーク等必要であれば、有り無しver両方頂きたいです。\n・本人のX固定ポストに三面図がございます。\n\nhttps://x.com/ranze_t_BW", "created_at": "", "completed_at": ""}, {"path": "/@kisumirei41/works/58", "thumbnail_src": "https://si.imgix.net/52646d2e/uploads/origins/6a42fb5c-cd8a-4568-9e41-0bc4c02ec7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35116fc0a4fd71b52bb69e0390c7bf4e", "thumbnail_srcset": "https://si.imgix.net/52646d2e/uploads/origins/6a42fb5c-cd8a-4568-9e41-0bc4c02ec7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35116fc0a4fd71b52bb69e0390c7bf4e, https://si.imgix.net/52646d2e/uploads/origins/6a42fb5c-cd8a-4568-9e41-0bc4c02ec7d2?bg=%23