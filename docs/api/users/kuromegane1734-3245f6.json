2Ccenter&txtsize=30&txt=PRIVATE&s=cfe531ffc65f76ad2c08ee6d3cac4bb5 2x, https://si.imgix.net/12100192/uploads/origins/18110229-c6e5-4d5f-a508-348a28c9ad71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae1212f2ffa259d8329603071e72c2e4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromegane1734/works/17", "thumbnail_src": "https://si.imgix.net/14a47332/uploads/origins/fb68712c-4583-4d41-b122-99090c172882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97941f4071426f2bcf8c95d75ae60b6c", "thumbnail_srcset": "https://si.imgix.net/14a47332/uploads/origins/fb68712c-4583-4d41-b122-99090c172882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97941f4071426f2bcf8c95d75ae60b6c, https://si.imgix.net/14a47332/uploads/origins/fb68712c-4583-4d41-b122-99090c172882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=212371d3d16a30c11b2637dfabb64602 2x, https://si.imgix.net/14a47332/uploads/origins/fb68712c-4583-4d41-b122-99090c172882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f3aa9c93ede12ecf5fdff83211e126b 3x", "genre": "art", "nsfw": true, "body": "王国メイド拘束調教シリーズの馬車馬メイドが特に好みだったのでリクエストさせていただきます。\n荷馬車メイドさんが新人御者のジジちゃんにお仕置きされているイラストをお願いします\nシチュエーションは買い出し中の荷馬車を曳くメイドさんが鞭で打たれたり、お屋敷の馬小屋に繋がれたメイドさんがジジちゃんに「今日は荷馬車を曳くのが遅かった」などと怒られロータやバイブ等を一晩中装着されジジちゃんに従順な馬にされる。\nメイドさんの表情は鞭打たれる苦痛と少し前まで逆の立場だった新人に調教される恥辱と羞恥の表情でお願いします。\n可能でしたらメイドさんの口枷なしでジジちゃんに許しを懇願する差分希望です", "created_at": "", "completed_at": ""}, {"path": "/@kuromegane1734/works/16", "thumbnail_src": "https://si.imgix.net/3e8d3a20/uploads/origins/89b0cedf-c63b-435e-9165-0b9f37fac84a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=957141e911e3b5e42aa3f9b6680ed008", "thumbnail_srcset": "https://si.imgix.net/3e8d3a20/uploads/origins/89b0cedf-c63b-435e-9165-0b9f37fac84a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=957141e911e3b5e42aa3f9b6680ed008, https://si.imgix.net/3e8d3a20/uploads/origins/89b0cedf-c63b-435e-9165-0b9f37fac84a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac24e620decdc5cc9a9fc1d07bbad335 2x, https://si.imgix.net/3e8d3a20/uploads/origins/89b0cedf-c63b-435e-9165-0b9f37fac84a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37a260e93cf2ab6a967c16e30e48fd4f 3x", "genre": "art", "nsfw": true, "body": "キャラ…指定なし\n服装…セーラー服\n\n【背景】\nとある山奥の村では、女子がある年齢になるとお社に連れていかれる。社では村の男衆によって処女を散らされ、三日間社から出ることを許されず、種付けされ続ける。\n子宝祈願としての儀式とされていて、乱暴であればあるほどいいとされる。\n\n最近になると外の情報がネットなどで入ってくるようになり、村の風習がおかしいと思い始める女子が増えてきた。\nそういったときには、四肢を拘束したり、一物を噛まれないように口枷をしたりして、３日を過ごさせている。\nネット通販により、バイブなどの機材も使われるようになっているらしい。\n\n【シチュエーション】\n今年の女子はとくに抵抗が激しいので、種付けのあとは椅子に四肢を縛り付けて、目隠し・口枷をつけ、乳首にはローターを張り付け、バイブを二穴に挿入・して貞操帯で固定・放置することで次の日に大人しくなるようにされている。\n一晩中絶頂を繰り返しているので、椅子のしたには愛液のみずたまりができている。セーラー服は本人の涎や男たちの精液でどろどろになっている。快楽と苦痛がまじったようなうめき声をあげている。\n周囲には日中に使われたであろう玩具が散らばっている。\n\n…背景はイラストに反映させていただいてもいいですし、なくてもどちらでもいいです。また、反映させる場合にはどのように弄っていただいても問題ありません。\nぜひよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@kuromegane1734/works/15", "thumbnail_src": "https://si.imgix.net/b091c36b/uploads/origins/8b7e4c8e-c10d-4367-9547-6610809ba452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d61f8ad3038dfd98a31d7e6133b6b777", "thumbnail_srcset": "https://si.imgix.net/b091c36b/uploads/origins/8b7e4c8e-c10d-4367-9547-6610809ba452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d61f8ad3038dfd98a31d7e6133b6b777, https://si.imgix.net/b091c36b/uploads/origins/8b7e4c8e-c10d-4367-9547-6610809ba452?bg=%23fff&auto=format%2Ccompress&fm