2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec69b3788b70758befd41fc3c8c4967 2x, https://si.imgix.net/d385bbd7/uploads/origins/07e16bdd-ea1c-4b4f-9ac2-d47de021cf75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fd3462987a04ca82558a4bddac07170 3x", "genre": "art", "nsfw": false, "body": "飴さん様\n\n先日は宿星と纳斯の壁紙イラストを制作いただき、本当にありがとうございました。透明感あふれる色彩と生命力に満ちた表現がすばらしく、感激しております。\n\n今回は、同じ二人のオリキャラによる雪の中、寄り添うシーンのイラストをご依頼できればと思っております。構図や画幅も自由に演出していただいて大丈夫です。\n\n衣装などのキャラクター設定の参考資料はURLをご参照ください。\n\nお二人のキャラクターが飴さん様さんの視点で雪景色の中に優しく描かれることを、心から楽しみにしております。よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1JrZhHACIf7wpx6TVLLh8UpfQyFX3LxsF/view", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/25", "thumbnail_src": "https://si.imgix.net/0af8ded9/uploads/origins/715f2e97-0535-441a-b996-212d8103f3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1ea44becd9fbea7e360dac9735cdca", "thumbnail_srcset": "https://si.imgix.net/0af8ded9/uploads/origins/715f2e97-0535-441a-b996-212d8103f3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1ea44becd9fbea7e360dac9735cdca, https://si.imgix.net/0af8ded9/uploads/origins/715f2e97-0535-441a-b996-212d8103f3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0780a52973f20fb64dca93a40207916a 2x, https://si.imgix.net/0af8ded9/uploads/origins/715f2e97-0535-441a-b996-212d8103f3b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a211f6ff3ad3cfff82e3c676a90e7e7 3x", "genre": "art", "nsfw": false, "body": "飴さん🐑 様\n\n飴さん🐑様のイラストをSkebでお見かけして、そこから他のイラストを拝見させていただき絵柄にとても魅了されました！\nぜひよろしければおまかせで制作をしていただけないかと思いお送りいたしました。\nご検討いただけますと幸いです。\n\n●立ち絵\n・資料URLよりご確認いただけますと幸いです。\n\n●イラスト雰囲気\n・服装等変更可能です。\n・設定なども資料に入っておりますが立ち絵の雰囲気で描いていただいて問題ありません…！\n・ご承諾いただける範囲で、表情、ジャケットやメガネの有り無しの差分作成をお願いいただけないでしょうか？\n\n●使用用途\n・X (旧:Twitter)\n・サムネイル、配信、動画内で使用させていただく可能性もあります。\n・FANBOX\n\n●サイズ\n・大きくなってしまうのですが4500以上の大きさで制作可能でしょうか？\n（難しい場合は無視していただいて大丈夫です！）\n\n【お願い】\n サムネイルにも使用させていただくことがあるため、キャラクターのみの透過データか、もしくはPSDをいただけますと幸いです。\n\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1GeWPViMAmxf8D5bkNpQFqs4tFWYZJKmE?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/24", "thumbnail_src": "https://si.imgix.net/56a475c3/uploads/origins/f35da846-ee56-4502-b583-2fc1dcb49c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc42b18e4cb7537b6844c9b822fe5ae5", "thumbnail_srcset": "https://si.imgix.net/56a475c3/uploads/origins/f35da846-ee56-4502-b583-2fc1dcb49c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc42b18e4cb7537b6844c9b822fe5ae5, https://si.imgix.net/56a475c3/uploads/origins/f35da846-ee56-4502-b583-2fc1dcb49c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c0bbc10df49b3ba77ecc731181c09c1 2x, https://si.imgix.net/56a475c3/uploads/origins/f35da846-ee56-4502-b583-2fc1dcb49c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ae31ddd26db133cf57d3680565fc245 3x", "genre": "art", "nsfw": false, "body": "飴さん、こんにちは！先生の画風がとても好きです。私のOC、フィロソフィアのイラストをお願いしたいです。\n\nフィロソフィアの基本的な説明はこんな感じです。\n\nFilosofia:165cmの女性、25歳くらい、茶色の髪、金色がかった茶色の目、いつも笑顔、フリージアとフクロウが好き、旅行が好き。\n\nあなたのスタイルで自由に描いてください。よろしくお願いします！\nhttps://drive.google.com/drive/folders/1cDpAGRWgC3DnMZYVSUmO5DQ7kPcad-kX", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/23", "thumbnail_src": "https://si.imgix.net/9bb70407/uploads/origins/79314f0c-0f05-488d-8352-86058bc629f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da611a4f48af492e071cdb5382047d8c", "thumbnail_srcset": "https://si.imgix.net/9bb70407/uploads/origins/79314f0c-0f05-488d-8352-86058bc629f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da611a4f48af492e071cdb5382047d8c, https://si.imgix.net/9bb70407/uploads/origins/79314f0c-0f05-488d-8352-86058bc629f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e9c1fbe4d7a02f588ff162428bd96c8 2x, https://si.imgix.net/9bb70407/uploads/origins/79314f0c-0f05-488d-8352-86058bc629f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e00851ebad8e8520ecca9d01e649ee1c 3x", "genre": "art", "nsfw": false, "body": "初めまして！！飴さんの透明感溢れるイラストに惹かれずっと依頼させて頂きたかったのですが、なかなかタイミングが掴めずこの度ようやくリスエストを送らせて頂きました……！！\n\n【依頼内容】\n私のOCをお願いしたく思います！\n\n【雰囲気、構図など】\n飴さんの色使いや構図雰囲気全てが好きなのでお任せ致します！！\nラベンダーがモチーフに入ってるので少し要素として入れていただければ嬉しいです。\n\n【キャラクター詳細】\n・紫髪の女性(メインの女)\n→化学者です。女性らしい顔立ち、まつ毛多め、少し特殊な目が特徴です。\n素直になりきれず、ツンとしてしまう少し恥ずかしがり屋な性格。乙女思考持ち。\n分かりやすく言うとツンデレとクーデレのハーフです。\n表情はURLの資料に1部参考でございます。\n\n 【使用用途】 \n個人鑑賞、アイコンなどへの利用が主となります。\n\nお忙しい中すみませんが、何卒よろしくお願いいたします……！！\n\nhttps://drive.google.com/drive/folders/11hOFbWKYrxy-8HRmwYXGGOJLSYFjhD4a", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/22", "thumbnail_src": "https://si.imgix.net/34ce0743/uploads/origins/9624ca31-74cc-4891-a5e9-9e9d0c9bc8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c0ce6ffec7d574e0f9db28e1f38c77a", "thumbnail_srcset": "https://si.imgix.net/34ce0743/uploads/origins/9624ca31-74cc-4891-a5e9-9e9d0c9bc8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c0ce6ffec7d574e0f9db28e1f38c77a, https://si.imgix.net/34ce0743/uploads/origins/9624ca31-74cc-4891-a5e9-9e9d0c9bc8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26ba6bbad87cf7645e520e38f79a63c5 2x, https://si.imgix.net/34ce0743/uploads/origins/9624ca31-74cc-4891-a5e9-9e9d0c9bc8ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8afd22c92ed8f430ec52fc87a1a051f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/21", "thumbnail_src": "https://si.imgix.net/9334be10/uploads/origins/98335c72-5aa9-4a78-afee-b7236ee93de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d884f432a839e7d3a7d29f4d244b0a59", "thumbnail_srcset": "https://si.imgix.net/9334be10/uploads/origins/98335c72-5aa9-4a78-afee-b7236ee93de3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d884f432a839e7d3a7d29f4d244b0a59, https://si.imgix.net/9334be10/uploads/origins/98335c72-5aa9-4a78-afee-b7236ee93de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff0ba921743c16ac8096e55c56fa8dab 2x, https://si.imgix.net/9334be10/uploads/origins/98335c72-5aa9-4a78-afee-b7236ee93de3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2fa1511f418f3aa687991a170c1cce6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回のリクエストがとてもとてもお気に入りで、またお願いしようと思います。\n\n今回は高校時代の咲苗ちゃんを描いていただきたいです！\n下記資料のURLを参考していただければ幸いです！\n語り手で探偵さん。全く素直じゃない。言ってることはほとんど嘘で、周りの人の期待に答えるように演じているが、本当は空っぽで自己がなくなっている。人の前ではほぼいつもふざけている態度を持っている。\n昔はピアノの天才だと思われ、ケガのためやまてしまった。\n犯人を探しながら、自分の過去の向き合ってしまう。この役割で償いを求め、自分の結末に償いの意味を与えたい。\n亡くなった妹の妄想に呪われている。罪悪感と後悔で動いており、自己破壊的な行為しがち。\n\nイラストの方は特にアイディアがないので、ご自由に描いていただければうれしいです。咲苗によく付き合うものは：傘、雨、白い菊・白い花、チェス（特に黒駒）。冷たいや暗い雰囲気、メランコリック的な絵が似合うと思います。ご自由に描いていただきたいですので、お任せします！\n内容がお好みではない、都合が合わない場合、なるべくキャンセルでお願いします。\nよろしくお願いいたします！\n\n彼女に関して詳細がもっとある資料（拝見自由！）：\nhttps://drive.google.com/drive/folders/1DqS5m8W6j_fPDR_pQ6IpIqU5byJeTuj-?usp=drive_link\nhttps://drive.google.com/drive/folders/159Tz-4uFx9DAFXof3RrSOLlzpY5RRD2x?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1zPJt7mqukt7aFP39E28R1E_6Dy-c0Pfh?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/20", "thumbnail_src": "https://si.imgix.net/bf31be47/uploads/origins/974af933-a83c-499c-acf0-aeea0a8f9626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0075ca990f50b74407956303cf532f0", "thumbnail_srcset": "https://si.imgix.net/bf31be47/uploads/origins/974af933-a83c-499c-acf0-aeea0a8f9626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0075ca990f50b74407956303cf532f0, https://si.imgix.net/bf31be47/uploads/origins/974af933-a83c-499c-acf0-aeea0a8f9626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1c0e5842a05b67edc3c7abde0f6d1b3 2x, https://si.imgix.net/bf31be47/uploads/origins/974af933-a83c-499c-acf0-aeea0a8f9626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9780a3aa9b270a6ebe108344141fc19c 3x", "genre": "art", "nsfw": false, "body": "飴さん🐑さま\n\n再度リクエスト失礼いたします！\n\n別の組み合わせのイラストをお願いしたく、\n重ねてご連絡させていただいております。\n\n詳細は資料をご確認くださいませ。\n\nご多用かと思いますので難しい場合は\nお手数をお掛けいたしますがキャンセルをお願いいたします。\n\nこちらも淡く優しい色彩でお願い出来ますと大変嬉しいです！\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1NvKBK-PQmM5rged-CjyEMcDTSbQhQDGo?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/19", "thumbnail_src": "https://si.imgix.net/3cfe7ddb/uploads/origins/8462fe4c-6d31-49d1-bb46-e5610fd09ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01234e0518cb40bf6447d57a49bf3f3c", "thumbnail_srcset": "https://si.imgix.net/3cfe7ddb/uploads/origins/8462fe4c-6d31-49d1-bb46-e5610fd09ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01234e0518cb40bf6447d57a49bf3f3c, https://si.imgix.net/3cfe7ddb/uploads/origins/8462fe4c-6d31-49d1-bb46-e5610fd09ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25317ed124f4ee5e493eae21162dc396 2x, https://si.imgix.net/3cfe7ddb/uploads/origins/8462fe4c-6d31-49d1-bb46-e5610fd09ceb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=892df382d5b694493c3bdce7e99885b3 3x", "genre": "art", "nsfw": false, "body": "飴さんはじめまして！リクエスト失礼します。\nイラストの雰囲気に惹かれて、今回1枚イラストをお願いしたくリクエストさせて頂きました。\n内容によって金額に変わりがある場合は、お手数ですがリクエストを再送して頂きますと幸いでございます。\n\n\n『描いて欲しい人物』\n私自身である、夜因を描いて頂きたいです。\n服装は資料内にあるシスター衣装でお願いします。\n髪型は資料内の中からお任せします。\n\n『人物について』\n・八重歯が両側生えています。\n・ツノは取れません。\n・髪の内側にインナーカラーが入っています。\n・ネイルをしています。\n\n『内容』\nもうすぐ秋なので、金木犀の花びらを全身に浴びてるようなイラストを描いていただきたいです。\n\n『納品時について』\n人物の頭のてっぺんや髪の毛先などは見切れないようにお願いします。\n\n『使用用途』\n・各SNSへの投稿\n・収益化済みのYouTubeチャンネルでの使用(サムネイルや配信内で)\n・YouTubeのメンバーシップへの先行公開\n・商用利用(グッズ化やネットプリントなど)\n\n『納品について』\n納品時、1枚イラストの他、背景が透過されてるそれぞれの人物の単体イラストを納品して頂きたいです。\n\n『ファイル形式』\nファイル形式はお任せします。\n可能であればpngファイル、もしくはレイヤー分けされたpsdファイルの形式でお願いします。\n\n\nリクエスト内容が長くなってしまい申し訳ございません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ScPvr5jbCApK7D7BsxsyVQAUpSfPzRzd", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/18", "thumbnail_src": "https://si.imgix.net/712072ea/uploads/origins/72a3849a-2112-4b21-ae52-af98a859b878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=275a521a1b734985811aed48a2ea7310", "thumbnail_srcset": "https://si.imgix.net/712072ea/uploads/origins/72a3849a-2112-4b21-ae52-af98a859b878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=275a521a1b734985811aed48a2ea7310, https://si.imgix.net/712072ea/uploads/origins/72a3849a-2112-4b21-ae52-af98a859b878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d154d8a8bb75642d4755757037cd732 2x, https://si.imgix.net/712072ea/uploads/origins/72a3849a-2112-4b21-ae52-af98a859b878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85d7321f043a9e5db2918e81c3521a25 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/17", "thumbnail_src": "https://si.imgix.net/077c1525/uploads/origins/c3309b9e-97ba-420c-8f3f-f98cfd5bb2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d825e10fe4cf21d42e402d7067c86d7", "thumbnail_srcset": "https://si.imgix.net/077c1525/uploads/origins/c3309b9e-97ba-420c-8f3f-f98cfd5bb2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d825e10fe4cf21d42e402d7067c86d7, https://si.imgix.net/077c1525/uploads/origins/c3309b9e-97ba-420c-8f3f-f98cfd5bb2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d5f1dace7200a5065fbb078a7f7dc36 2x, https://si.imgix.net/077c1525/uploads/origins/c3309b9e-97ba-420c-8f3f-f98cfd5bb2a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61a293b47d3f2caf88c250c522abd6c0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tagane_sousakuo/works/16", "thumbnail_src": "https://si.imgix.net/166dac29/uploads/origins/0dbb1edb-f016-4044-8aa5-2ad3f7af00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eee6cce2d79c0945240a7c322f4f386", "thumbnail_srcset": "https://si.imgix.net/166dac29/uploads/origins/0dbb1edb-f016-4044-8aa5-2ad3f7af00dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eee6cce2d79c0945240a7c322f4f386, https://si.imgix.net/166dac29/up