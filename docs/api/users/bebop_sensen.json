fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60002fef96c16a8b934efabcb249ce89 2x, https://si.imgix.net/136ea91d/uploads/origins/4bc54654-ad85-4c62-8ad8-124aeb5b168c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2949a8e9b78fbed28f3190a803cbc2fb 3x", "genre": "art", "nsfw": false, "body": "こにちはお久しぶりです！まえのエルフェルトのリクエストは本当に好きだった！だから、またお願いしたいです！\n\n今回、「ゼンレスゾーンゼロ」の「アンビー」と「ニコル」一緒にお願いしたいです！ポーズと表情をおまかせしますが、できればアンビーの表情はかっこいいとニコはどや顔入れていただけると嬉しいです!\n\n※二人のキャラのイラストを見てないから、もし料金が不足している場合それとも何か他の問題があったら、再送リクエストをお送りいただけますと幸いです", "created_at": "", "completed_at": ""}, {"path": "/@bebop_sensen/works/98", "thumbnail_src": "https://si.imgix.net/858e0720/uploads/origins/04c3ea1b-74c1-488e-ace3-e26bc94ccaaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baa04383727f1c55f83f1e6de6cab91c", "thumbnail_srcset": "https://si.imgix.net/858e0720/uploads/origins/04c3ea1b-74c1-488e-ace3-e26bc94ccaaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baa04383727f1c55f83f1e6de6cab91c, https://si.imgix.net/858e0720/uploads/origins/04c3ea1b-74c1-488e-ace3-e26bc94ccaaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b0b054d16c66996cd31a02fceb5db6d 2x, https://si.imgix.net/858e0720/uploads/origins/04c3ea1b-74c1-488e-ace3-e26bc94ccaaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=daf6b9119ceb29be77c599f00b002a8f 3x", "genre": "art", "nsfw": false, "body": "こんにちは鉄坊やさん、私はステファノ・ジュゼッペ・マロッタと申します。今日あなたのイラストを初めて拝見し、その独創的でクリエイティブなスタイルに深く感動しました。ぜひあなたにも「不思議の国のアリス」のイラストをお願いしたく、こちらのリクエストをお送りしました。私はこのイラストを商業用のプリント・オン・デマンドのプロジェクトで使用し、ポスター、キャンバス、Tシャツなどに印刷する予定です。あなたのアートはとても予測不可能なので、あえて具体的な指示は出さず、あなたの魔法の帽子からどんな作品が飛び出すのか楽しみにしています ^__^\n\nENGLISH TRANSLATION\nHello Tetsubouya-san, my name is Stefano Giuseppe Marotta, nice to meet you. I discovered your artwork today for the first time and was truly impressed by your original and creative style. So I couldn’t resist asking you as well for an illustration of Alice in Wonderland, which I plan to use for my print-on-demand commercial project by printing it on posters, canvas, T-shirts, etc. Your art is so wonderfully unpredictable that I prefer not to give you any specific instructions and simply enjoy the surprise of what you will pull out of your magic hat ^__^", "created_at": "", "completed_at": ""}, {"path": "/@bebop_sensen/works/97", "thumbnail_src": "https://si.imgix.net/4109d330/uploads/origins/3607d0e2-768b-44ff-ae2f-6aba8c689c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9cfe7762895fdee0788c49325913a49", "thumbnail_srcset": "https://si.imgix.net/4109d330/uploads/origins/3607d0e2-768b-44ff-ae2f-6aba8c689c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9cfe7762895fdee0788c49325913a49, https://si.imgix.net/4109d330/uploads/origins/3607d0e2-768b-44ff-ae2f-6aba8c689c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e5f029b0e31e442191d2f7ae10f164d 2x, https://si.imgix.net/4109d330/uploads/origins/3607d0e2-768b-44ff-ae2f-6aba8c689c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9369fae946499e2ea7a7f83bbbaf9cf6 3x", "genre": "art", "nsfw": false, "body": "鉄坊や様　はじめまして。\n以前よりイラストを拝見していて気になったので依頼させて頂きました。\n\n■キャラクター\n　ぶいすぽっ！の千燈ゆうひさん\n\n■衣装\n　お部屋着衣装\n\n■使用用途\n　PCの壁紙、twitterのヘッダー。\n\n■内容\n　千燈ゆうひさんがこたつでまったりしている様子。\n　ゆうべこも居ると嬉しいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bebop_sensen/works/96", "thumbnail_src": "https://si.imgix.net/ca814a08/uploads/origins/31252574-2289-45b1-a148-8582f86b0146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=767c8b49533c9ba5e1dc86cb08806ac8", "thumbnail_srcset": "https://si.imgix.net/ca814a08/uploads/origins/31252574-2289-45b1-a148-8582f86b0146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=767c8b49533c9ba5e1dc86cb08806ac8, https://si.imgix.net/ca814a08/uploads/origins/31252574-2289-45b1-a148-8582f86b0146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8a35258d37b130a26187cec7006e6e6 2x, https://si.imgix.net/ca814a08/uploads/origins/31252574-2289-45b1-a148-8582f86b0146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06da459348f305d94c59fbeb76cc0606 3x", "genre": "art", "nsfw": false, "body": "こんにちは、こんにちは、トップページであなたの最新の絵を見ました。大胆な色使い、かわいいポーズ、素敵な表情が大好きです！\n\n小さなVtuberの@AmoraLuminaを描いてみませんか？優しくてかわいい宇宙のお姫様です。彼女の \"宇宙プリンセス \"衣装や現代的なフィット感を自由に描いてください。\n\nポーズや設定はお任せしますので、興味を持っていただけると嬉しいです！\n\nhttps://drive.google.com/drive/folders/1w3pdnnLv7xXojOzdO8Bcsdaq2EZ7eEQD?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@bebop_sensen/works/95", "thumbnail_src": "https://si.imgix.net/e3f61464/uploads/origins/562ca3c2-ef77-46bc-be7e-59d125164c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2da83388a8103e961b9cfd0bbc26e044", "thumbnail_srcset": "https://si.imgix.net/e3f61464/uploads/origins/562ca3c2-ef77-46bc-be7e-59d125164c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2da83388a8103e961b9cfd0bbc26e044, https://si.imgix.net/e3f61464/uploads/origins/562ca3c2-ef77-46bc-be7e-59d125164c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c388b4a40e3f1bf92267d812412fe6cc 2x, https://si.imgix.net/e3f61464/uploads/origins/562ca3c2-ef77-46bc-be7e-59d125164c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ec3c7644411b0a0231f9396a545df24 3x", "genre": "art", "nsfw": fa