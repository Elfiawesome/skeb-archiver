9D9.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99a3c3b135bd377666ab8e905c7c41b2 3x", "genre": "voice", "nsfw": false, "body": "初めて依頼します。\n次のようなボイスを２つよろしくお願いします。\n\n１、文喰シミに飼われている猫「ルイ」を構っているボイス\n２、文喰シミがヤンデレ化して迫っているボイス\n\nできれば２のほうが１よりも長い感じで力を入れてもらえると助かります", "created_at": "", "completed_at": ""}, {"path": "/@VR_humihami/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9136b12afaf392d578c28db1f76e57f", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9136b12afaf392d578c28db1f76e57f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f90ab09ffe2f9fbd0b34d74d8ff191a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99a3c3b135bd377666ab8e905c7c41b2 3x", "genre": "voice", "nsfw": false, "body": "文喰シミ様、ボイスを3つの依頼お願いします！\n\n\n1.「がんばれ～！がんばれ～！」を1～2回お願いします。\n2.「目覚めろ～！」を勢いのある声でお願いします。\n3.「めろめろ～」をひそひそ声でお願いします。\n\nでお願いします。難しかったら何でもいいのでお願いします...", "created_at": "", "completed_at": ""}, {"path": "/@VR_humihami/works/4", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5161a9cfc89b92b63f72fa83932891d0", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5161a9cfc89b92b63f72fa83932891d0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=790dc312f12d4988814a3758df2d9f39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2006129750146940928%2F69V829D9.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1a192a01453cb9de11dd972f11b6821 3x", "genre": "novel", "nsfw": false, "body": "魔女、Phalaenです。\n以前書いて頂いた依頼↓と同じような世界観で、また一作お願いします。\nhttps://skeb.jp/@VR_humihami/works/2\n今回も戦う魔女さんな感じの戦闘描写があると助かります。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@VR_humihami/works/3", "thumbnail_src": "https://si.imgix.net/1ae1fa1f/uploads/origins/208410db-63ee-436a-bbc3-cf9829a5a6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc40740c8e3b6094e5b015697eb52b09", "thumbnail_srcset": "https://si.imgix.net/1ae1fa1f/uploads/origins/208410db-63ee-436a-bbc3-cf9829a5a6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc40740c8e3b6094e5b015697eb52b09, https://si.imgix.net/1ae1fa1f/uploads/origins/208410db-63ee-436a-bbc3-cf9829a5a6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daed794e37f9631386d52ec8b4cf3f89 2x, https://si.imgix.net/1ae1fa1f/uploads/origins/208410db-63ee-436a-bbc3-cf9829a5a6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b372e20e44a43bb8ad134912a19ad9b 3x", "genre": "correction", "nsfw": false, "body": "はじめまして\nリクエストさせていただきます\n\n我が家の近所にはセブンイレブン、LAWSON、Familymartがあります。\nどこも家から殆ど同じくらいの距離にあり、選り取り見取りといえば聞こえは良いのですが、優柔不断な私はどこのコンビニにするかで毎回迷ってしまいます。\nセブンイレブンを悟空、LAWSONをベジータ、ファミマをピッコロとするならば、やはり私は悟空が好きなので結局セブンイレブンに行ってしまうのですがそうなると選ばなかった二人に対してもなんとなく罪悪感を覚えてしまいます。\n\n一重にそれぞれの戦闘力を私が正しく理解していないことが原因に他なりません。\nホットスナックなんて良い例です。\nナナチキ、Lチキ、ファミチキとかありますがぶっちゃけ違いがわかりません。包装紙変えたら間違える自信があります。\nギャリック砲とかめはめ波に色以外の違いがあるのかわからないのと同じです。魔貫光殺砲は辛うじてわかります。\n\nそこで各コンビニの利点を比較してどのコンビニがおすすめかアドバイスをいただきたく思います。できればナナチキ、ファミチキ、Lチキの違いについても教えていただけたらと思います。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@VR_humihami/works/2", "thumbnail_src": "https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e8d560b75f54ea8ef67b6b53eca521", "thumbnail_srcset": "https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e8d560b75f54ea8ef67b6b53eca521, https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da483f144b18c0e8d01263336030fa3e 2x, https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5060a517bcfd820cfd9735489652a31e 3x", "genre": "novel", "nsfw": false, "body": "VRの魔女、Phalaenです。\n今回は文喰シミさんの作風で私を紹介する文章を書いて頂きたく。\n形式は問わず、内容は魔女らしさを前面に出す感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@VR_humihami/works/1", "thumbnail_src": "https://si.imgix.net/e572dda3/uploads/origins/5f3ef466-6f00-449d-8ed1-d21920b7c887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c99ccb65ba7d5ce8c1c13deb3f863244", "thumbnail_srcset": "https://si.imgix.net/e572dda3/uploads/orig