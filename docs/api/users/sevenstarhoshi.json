://si.imgix.net/a37d00ef/uploads/origins/8475f4a5-312e-4c68-92d5-403e1e60d5dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2dac17f86733bcf5b338152fd1ee3bd 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@sevenstarhoshi/works/232", "thumbnail_src": "https://si.imgix.net/9b203bbd/uploads/origins/122fe594-da35-49ad-aeef-88f449ea6f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c48fdcd583a66c9e1e68ed2185c6d25c", "thumbnail_srcset": "https://si.imgix.net/9b203bbd/uploads/origins/122fe594-da35-49ad-aeef-88f449ea6f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c48fdcd583a66c9e1e68ed2185c6d25c, https://si.imgix.net/9b203bbd/uploads/origins/122fe594-da35-49ad-aeef-88f449ea6f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b28ac08f15d1813e84c114a006a8cc4 2x, https://si.imgix.net/9b203bbd/uploads/origins/122fe594-da35-49ad-aeef-88f449ea6f3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20d5a0a4689347df520df40e6f9fb1a4 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です\nアイドルマスターシンデレラガールズの五十嵐響子の、マジックハンドくすぐりイラスト1枚をリクエストします\nメイン絵の他に、イラスト内の上側と下側に枠を計二つ作りサブ絵という構成でお願いします\n\n以下詳細です\n\n\n【メイン絵】\n・上半身裸、下半身パンツのみ\n・立ったままお尻を後ろに突き出したポーズ\n・顔は背後を振り返る、両方の目とおっぱいが見えるくらいの角度で\n・背中側に近づいた方の手で、脱がされそうになっているパンツを掴んで抵抗\n・もう片手の手首はマジックハンドに掴まれ、頭上に持ち上げられる\n・以上の構図を斜め後ろからのアングルで、大きなお尻が一番手前側にくるように\n\n【響子ちゃん】\n・顔を引きつらせながら笑っている表情\n・お尻ふりふり\n・笑い声、感じてる声、マジックハンドに抵抗するセリフ、下着を伸ばされていることに対し文句のセリフ\n\n【マジックハンド】\n・腋、脇腹、お尻くすぐり\n・乳首指先でつんつん\n・お尻もみもみ\n・パンツを掴んで抵抗している方の手を引きはがそうとする\n・パンツを引っ張ってお尻が見えておまんこは見えないくらいの位置まで脱がしている\n\n【サブ絵上】\n・口元～両胸のアップ\n・左右の乳首をそれぞれ、指先でぴんぴん、2本の指でつまんできゅっ\n・腋くすぐり\n・近くに感じているセリフ\n\n【サブ絵下】\n・お尻のドアップ\n・パンツを掴んでいる手を引き剥がされ、パンツを完全に下までずり下ろされお尻丸見え\n・近くに悲鳴のセリフ\n\n【その他】\n・乳首の色は薄め\n・キャラの台詞は入力文字ではなく書き文字\n・おっぱい、乳首、お尻に関する効果音はハートマークあり、くすぐりの効果音はハートマークなし\n\n\n以上、よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@sevenstarhoshi/works/231", "thumbnail_src": "https://si.imgix.net/f735c49e/uploads/origins/6787d96d-6378-466b-8a09-ef9031cd5f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dbd12317933f334db39e8fcc83fb269", "thumbnail_srcset": "https://si.imgix.net/f735c49e/uploads/origins/6787d96d-6378-466b-8a09-ef9031cd5f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dbd12317933f334db39e8fcc83fb269, https://si.imgix.net/f735c49e/uploads/origins/6787d96d-6378-466b-8a09-ef9031cd5f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e7f14541082f462d6baa8c403d2c477 2x, https://si.imgix.net/f735c49e/uploads/origins/6787d96d-6378-466b-8a09-ef9031cd5f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=465268f45646024f2a234226fa7b95e9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}