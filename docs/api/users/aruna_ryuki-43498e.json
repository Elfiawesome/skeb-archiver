2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=223aad19f1fd4027cc894f7aec133b5c 3x", "genre": "music", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aruna_ryuki/works/4", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x", "genre": "music", "nsfw": false, "body": "こんにちは！私はあなたの作る音楽がとても好きで、この芸術的な絵に音楽を付けたいと思っています。\nhttps://drive.google.com/file/d/1E1QtUTQo926LhAhl9aE2CILHMNtwr1jF/view?usp=sharing\n巨大な青い龍が空を舞い、山や尾根を越え、縄張りを巡回する\n絵から感じる気持ちに合わせて自由に音楽を作っていただければ幸いです\n\nhttps://drive.google.com/file/d/1E1QtUTQo926LhAhl9aE2CILHMNtwr1jF/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aruna_ryuki/works/3", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x", "genre": "music", "nsfw": false, "body": "こんにちは。\nALNEARさんに、私のオリジナルゲームのスタート画面用BGMを制作していただきたく、ご連絡いたしました。\n\nゲームジャンル：恋愛向けビジュアルノベル\n世界観：架空ファンタジー\n舞台背景：アラブ・エジプト・オスマンの要素を融合した世界\n\n【BGMについて】\n砂漠の雰囲気を感じさせ、\nゆっくりとしたテンポで激しい部分は不要です。\n神秘的で、どこか孤独な雰囲気を持つ曲にしてください。\n\n【使用用途】\nゲームのスタート画面で再生するBGMです。\n長さ：1分30秒～2分程度で、ループ再生に対応したものをお願いいたします。\n主旋律がはっきり聴こえる曲を希望します。\nフレーズの繰り返しは4回以内に抑えてください。\n\n【その他】\nゲームは個人制作となります。\n公開する際には、作曲者として先生のお名前をクレジットに記載いたします。\n参考用に、男女主人公のイラストを別途送付いたします。\n可能でしたら、MP3とWAVの両フォーマットで納品していただけると大変助かります。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1OsLyxtwJhbjOiddA2GcURyZ8pSpFiPvO", "created_at": "", "completed_at": ""}, {"path": "/@aruna_ryuki/works/2", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x", "genre": "music", "nsfw": false, "body": "初めまして。\n現在、オリジナル作品（現代日本を舞台にした民俗・心理ホラー要素のある物語）を制作しており、\nその中で登場人物が作曲するピアノ曲を、実際の楽曲として形にしたくリクエストをお送りいたします。\n\n【名前】鈴木三郎（偽名）\n【性別】男性\n【年齢】37歳\n【外見】下記のリンクよりご参照ください。\nhttps://x.com/itoonigawara/status/2002733515050533243?s=61&t=5VpJYvFe1jdVyNNRx13sZg\nhttps://x.com/itoonigawara/status/1998701341359669734?s=61&t=5VpJYvFe1jdVyNNRx13sZg\nhttps://x.com/itoonigawara/status/2003767664628674604?s=61&t=5VpJYvFe1jdVyNNRx13sZg\n\n【概要】\nキャラクターは、非常に静かで、感情を表に出さない人物です。\n彼にとってピアノは「表現」ではなく、「自分を保つための行為」に近く、\n誰かに聴かせることを前提としない音楽を弾いています。\n\n楽曲のイメージとしては、\n・激しい感情表現や大きな盛り上がりはなく\n・静かで、内省的\n・美しさはあるが、完全には解決しない\n・聴いていると、感情がゆっくり沈殿していくような曲\nを想定しています。\n\n技巧的である必要はありませんが、\nキャラクターが長年ピアノに触れてきたことが自然に伝わるような、\n左手の低音の使い方や、間の取り方に個性があると嬉しいです。\nこの曲は、「誰にも見せない夜の顔」のような存在であってほしいと思っています。\n\n以上、ご検討の程何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@aruna_ryuki/works/1", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1ca6fb6b5e4a7c5bcd62e55338f78d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c108b40f0ff9148f8eacfc8aaf193c31 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1983563620270448640%2FV4AwTpzo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=718d43bfc75bb5759bbcb9389302a9d9 3x", "genre": "music", "nsfw": false, "body": "ALNEAR様\n\n初めてご連絡いたします。イラスト制作をしているあさまふみと申します。\nALNEAR様の楽曲は主にゲーム音楽でよく聴いております。\n\nお忙しいところ大変恐縮ですが、この度は私のTwitch配信(収益化済)にて使用するBGMを制作していただけないかと思いリクエストいたしました。\n配信では主に背景や自然風景を描いています。\n\n恐れ入りますが作曲依頼は初めてですので勝手がわからず、とりあえず当方のイメージをお伝えします。\n\nテーマ：空、宇宙\n説明：ピアノを主旋律とし、実際には存在しない観念上の空と宇宙の境目に抱く情景のイメージ。広さを感じる曲調が好ましい。\n連想するワード：孤独、情緒的、静謐、祈願、自然\nその他の仕様：インスト、ループして使用したいです。\n\nALNEAR様の過去作品ですと、こちらのリンク先のPVで使用されている楽曲がイメージに近いかもしれません。ただし、曲後半にある壮大なコーラスは今回はなくてもよいです。音圧も抑えめでいいかもしれません。天使とかではなく、あくまで人のスケールでお願いします。\nhttps://x.com/MNSG_official/status/1926533694199636324\n\n以上、抽象的ではありますが、基本的にはお任せいたします。また、参考までに私が使用しているアバターも掲載しますので、必要であればご確認ください。\nhttps://www.pixiv.net/artworks/122074216\n\n\nぜひご検討いただけますと幸いです。何卒よろしくお願いいたします。\n\nhttps://x.com/MNSG_official/status/1926533694199636324", "created_at": "", "completed_at": ""}]}