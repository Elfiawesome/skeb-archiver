ix.net/fb259aa3/uploads/origins/6b744cd2-10b1-4129-9b10-9c343bda006e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d9d297df7bd8756846a1e1de01f3ce1 2x, https://si.imgix.net/fb259aa3/uploads/origins/6b744cd2-10b1-4129-9b10-9c343bda006e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09768d2c3528952b0be983d8827103b6 3x", "genre": "art", "nsfw": false, "body": "はじめまして、乾太です。 \n\nうちの子を描いていただけないでしょうか。\n\nキャラ設定はこちらをご参照ください → https://blog.init.engineer/ja/kemono/\n\nもし閲覧できない場合 → https://drive.google.com/drive/folders/1y-iruLv9qqW0EAD1TM9_lfLCQKPoZITT?usp=drive_link\n\n好きなように描いてください。 \n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@amasawa83/works/46", "thumbnail_src": "https://si.imgix.net/b11e1875/uploads/origins/866b6c63-247f-4d3e-b79b-c081bc8f2b87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e40443354f5c2f2ee47f5bd21b358da1", "thumbnail_srcset": "https://si.imgix.net/b11e1875/uploads/origins/866b6c63-247f-4d3e-b79b-c081bc8f2b87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e40443354f5c2f2ee47f5bd21b358da1, https://si.imgix.net/b11e1875/uploads/origins/866b6c63-247f-4d3e-b79b-c081bc8f2b87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a67e0d0595d2c80c35926b3c1d99e80c 2x, https://si.imgix.net/b11e1875/uploads/origins/866b6c63-247f-4d3e-b79b-c081bc8f2b87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6031067eccda66206fc106fbb5a2ff4d 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\nSKEBを初めて使用するのでこれであっているのか不安ですが(そもそもイラストの依頼自体ほとんどしてない)、ボルニクスくんのゆるゆるイラストをお願いします。\nボルニクスくんはピンクのヒヨコ又はピンクのヨッシーのタマゴを持っていることが多いのでそのどちらかを持っていると嬉しいです。構図などで入れられそうになかったら持たせなくても大丈夫です。\nよろしくお願いします！\n\nhttps://x.com/Mukunoji/status/2017239594299957249?s=20", "created_at": "", "completed_at": ""}, {"path": "/@amasawa83/works/45", "thumbnail_src": "https://si.imgix.net/7403b140/uploads/origins/5bd62008-0199-49f