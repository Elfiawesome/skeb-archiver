53e7-4093-87e4-f3d8d1efe78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d39aba55449ebd2b38377d7b579c2d76", "thumbnail_srcset": "https://si.imgix.net/7a69a858/uploads/origins/5d340426-53e7-4093-87e4-f3d8d1efe78f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d39aba55449ebd2b38377d7b579c2d76, https://si.imgix.net/7a69a858/uploads/origins/5d340426-53e7-4093-87e4-f3d8d1efe78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a44aca49f547072f2c10a9c7baa756e6 2x, https://si.imgix.net/7a69a858/uploads/origins/5d340426-53e7-4093-87e4-f3d8d1efe78f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=981ec5e1ef56782c3699740ada4005b0 3x", "genre": "art", "nsfw": false, "body": "リクエストさせていただきます\n\nキャラ\n\nバルカ・ニル\n（機動戦士ガンダム N-EXTREME）\n\n衣装・設定・その他\n\nTS\n２０歳\n大学生\nギャル\nシスコン\n\n構図\n\n大人気対戦アクションゲーム「機動戦士ガンダム エクストリームバーサス2 オーバーブースト」\n上方修正を貰ったN-EXTREMEガンダム ヴィシャスを使用して\nネイルをばら撒き、前後サブを擦り付けてノリノリで\nオタクくんに優しい天上天下唯我独尊TSギャルなバルカ・ニルちゃんをお願いします\n\nふとももの太さ\n太め\n\n胸の大きさ\n大きめ\n\n覚醒\nギャルは全てを滅ぼすのでF覚醒\n\n宜しくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@koonnyapi/works/44", "thumbnail_src": "https://si.imgix.net/57f82e01/uploads/origins/1a3c2fdf-4e52-43fa-8899-04fa614d6354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c533c331b8114cefe385e8d032d86ec6", "thumbnail_srcset": "https://si.imgix.net/57f82e01/uploads/origins/1a3c2fdf-4e52-43fa-8899-04fa614d6354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c533c331b8114cefe385e8d032d86ec6, https://si.imgix.net/57f82e01/uploads/origins/1a3c2fdf-4e52-43fa-8899-04fa614d6354?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2997d9ccd8383b96fe74950c24dd50e5 2x, https://si.imgix.net/57f82e01/uploads/origins/1a3c2fdf-4e52-43fa-8899-04fa614d6354?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3f8df741802ca1114b429151a6d413a 3x", "genre": "art", "nsfw": true, "body": "ラストオリジンの「生命のセレスティア」を描いてほしいです\nキャラ＆服装資料　https://imgur.com/a/iNGRgDs\n構図というかポーズは\nゆーいんさんがXにて投稿された　次やったら本当にコレだからね？なフミナ先輩のようなポーズでお願いします\nポーズ資料　https://x.com/konnyapi/status/1899378060643991666/photo/1\n\nおっとりマイペース系甘やかせ大好きキャラ（公式で母乳が出る）ですので\n「指揮官さま～？おっぱいの時間ですよ～ぅ」とにっこりほわほわした顔で\n頭並みにでっかい爆乳持ち上げておっぱいアピールな感じで描いてほしいです\n服は多少透けたり輪チラしたりしても問題ありません\n描く必要はありませんが、甘やかせる対象の指揮官は可愛い男の子なイメージで描いて頂けるとありがたいです\n（おねショタ授乳プレイ的な感じ）", "created_at": "", "completed_at": ""}, {"path": "/@koonnyapi/works/43", "thumbnail_src": "https://si.imgix.net/6a8d6c2c/uploads/origins/ab705f14-3963-404d-be11-9120147dfb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a520c3f311dba3e7c66206e305fb249", "thumbnail_srcset": "https://si.imgix.net/6a8d6c2c/uploads/origins/ab705f14-3963-404d-be11-9120147dfb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a520c3f311dba3e7c66206e305fb249, https://si.imgix.net/6a8d6c2c/uploads/origins/ab705f14-3963-404d-be11-9120147dfb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc9827f4799b9efb1916d87082f56c21 2x, https://si.imgix.net/6a8d6c2c/uploads/origins/ab705f14-3963-404d-be11-9120147dfb6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fd3311b9daab0cff0124d0df72ab23d 3x", "genre": "art", "nsfw": false, "body": "先生の絵のジャンルと異なり恐縮ですが、以下が可能でしたらお願いします。\n\nキャラクター：マリ（氷河戦士ガイスラッガー）\n服装：戦闘服とヘルメット姿、戦闘服を装着していないノーマル状態姿を\n並べて描いて頂けないでしょうか。ポーズなどはお任せします。\n以下はアニメ本編の画像ですが、Skebで作品名で検索頂いた方が資料になると思います。\nアニメの絵柄に寄せるよりも先生の絵柄で描いて頂けますと幸いです。\n\n戦闘服とヘルメット姿\nhttps://pbs.twimg.com/media/F6omiuaacAA5Vfd?format=png&name=small\nhttps://pbs.twimg.com/media/F6o5VKIb0AA8nPK?format=png&name=small\nhttps://pbs.twimg.com/media/DTLoNR2VAAAQoJm.jpg:medium\nhttps://pbs.twimg.com/media/F7-WMX9bgAAagNL?format=png&name=small\nhttps://pbs.twimg.com/media/F6o-zN5bsAAhx3w?format=png&name=small\n\n戦闘服を装着していないノーマル状態姿\nhttps://pbs.twimg.com/media/F7-bEQ8bkAEtyVs?format=png&name=sma