の「生命のセレスティア」\nキャラ＆服装資料　https://imgur.com/a/iNGRgDs\n構図というかポーズは\nゆーいんさんが過去に描かれた　https://skeb.jp/@koonnyapi/works/50\nこちらのような構図で、たっぷりたわたわなおっぱいに\n可愛い系少年な指揮官のお顔を挟み込むように抱いてご満悦\n指揮官君は恥ずかしくてたじたじ（でも好意的行動なので逃げたりはしない）\n少年指揮官のデザインはおまかせします\n\nおっとりマイペース系甘やかせ大好きキャラ（公式で母乳が出る）ですので\nおっぱい飲ませてる感じでもなんら問題ありません\nおっぱいが物凄くデカイ（実際デカイ）なので、谷間に少年指揮官くんのお顔を埋めようと思ったら余裕で埋まっちゃう感じだと嬉しい", "created_at": "", "completed_at": ""}, {"path": "/@koonnyapi/works/57", "thumbnail_src": "https://si.imgix.net/08e89465/uploads/origins/0e3ee41c-9fd5-42db-a360-52af3e1af7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e609b969e01cb03a1ede111b6aa43fd3", "thumbnail_srcset": "https://si.imgix.net/08e89465/uploads/origins/0e3ee41c-9fd5-42db-a360-52af3e1af7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e609b969e01cb03a1ede111b6aa43fd3, https://si.imgix.net/08e89465/uploads/origins/0e3ee41c-9fd5-42db-a360-52af3e1af7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=211c5f604eeebedd48f72fba42e8cf2a 2x, https://si.imgix.net/08e89465/uploads/origins/0e3ee41c-9fd5-42db-a360-52af3e1af7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ad459446472eb2fc2c7ccac1ee81769 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@koonnyapi/works/56", "thumbnail_src": "https://si.imgix.net/c7e53fd1/uploads/origins/18419454-1cf1-4cd6-b32f-e252bffd07ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f8dfe1228fe7f523192e99cfd9f7e48", "thumbnail_srcset": "https://si.imgix.net/c7e53fd1/upload