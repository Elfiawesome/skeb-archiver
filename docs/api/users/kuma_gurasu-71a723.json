ラストでお願いしたいです。背景もありなしこだわりないです。勿論難しそうであればお好きに描いてもらって大丈夫です！\n\nキャラについてはリンク内の資料に記載しておりますのでご確認いただけますと幸いです。\n\n○利用内容\n相方の子と個人利用の範囲で使用させていただきたく思います。\n\nご検討のうえご縁がありましたら是非よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1xasfF-KwCVpkwO3jDo0YYz7kY9mOOvsc", "created_at": "", "completed_at": ""}, {"path": "/@kuma_gurasu/works/3", "thumbnail_src": "https://si.imgix.net/32697b19/uploads/origins/bd5d7bbd-8190-4656-bac1-3a89983d55ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53128fbf02a57c4890ea972a0b68766b", "thumbnail_srcset": "https://si.imgix.net/32697b19/uploads/origins/bd5d7bbd-8190-4656-bac1-3a89983d55ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53128fbf02a57c4890ea972a0b68766b, https://si.imgix.net/32697b19/uploads/origins/bd5d7bbd-8190-4656-bac1-3a89983d55ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9abfefa01af97e89d19ab5d5cfbf4d95 2x, https://si.imgix.net/32697b19/uploads/origins/bd5d7bbd-8190-4656-bac1-3a89983d55ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5af08bbb3fbcd88acf7e2efe1f2e2b8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuma_gurasu/works/2", "thumbnail_src": "https://si.imgix.net/1224af2d/uploads/origins/5934c2a9-bcbc-43b6-8761-a88ff9c4641e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=768965e4c35a28b62d37f5669d25430c", "thumbnail_srcset": "https://si.imgix.net/1224af2d/uploads/origins/5934c2a9-bcbc-43b6-8761-a88ff9c4641e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro