press&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28a1dad5fb8ec7a44223c34d48230864 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@adacom_official/works/3", "thumbnail_src": "https://si.imgix.net/b4cee358/uploads/origins/54ca124a-524c-4ee7-bdcd-6e35558b0d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=105ab8533610ed32e90d00e35737e344", "thumbnail_srcset": "https://si.imgix.net/b4cee358/uploads/origins/54ca124a-524c-4ee7-bdcd-6e35558b0d37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=105ab8533610ed32e90d00e35737e344, https://si.imgix.net/b4cee358/uploads/origins/54ca124a-524c-4ee7-bdcd-6e35558b0d37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a0d0675962b48f8d3b04b61e861e405 2x, https://si.imgix.net/b4cee358/uploads/origins/54ca124a-524c-4ee7-bdcd-6e35558b0d37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80aef734a5e5fbcc06fa62914361cad0 3x", "genre": "art", "nsfw": true, "body": "デジモンのタカトとタクヤ、メガマンのラン・ヒカリと一緒にロボット少年のエイダがホットヨガのレッスンをしている漫画をリクエストしたいと思いました。英田は、ホットヨガは裸でやるのがいいと思い、服を脱ぎます。他の少年たちは恥ずかしそうにしながらも、一緒についていく。いろんなポーズをとって汗をかくと、床で滑ってしまい、お尻にペニスを入れられてしまう。", "created_at": "", "completed_at": ""}, {"path": "/@adacom_official/works/2", "thumbnail_src": "https://si.imgix.net/9e842004/requests/279368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33d48e3f318f5f2d7af672d732708c8d", "thumbnail_srcset": "https://si.imgix.net/9e842004/requests/279368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33d48e3f318f5f2d7af672d732708c8d, https://si.imgix.net/9e842004/requests/279368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3ef5820ec4c319edcae1a5b559eefb8 2x, https://si.imgix.net/9e842004/requests/279368_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85131a712d176f46b5ebbde97e648ddf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@adacom_official/works/1", "thumbnail_src": "https://si.imgix.net/250d26aa/requests/252914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50bcefd95bee339dd54bc550201fa20a", "thumbnail_srcset": "https://si.imgix.net/250d26aa/requests/252914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50bcefd95bee339dd54bc550201fa20a, https://si.imgix.net/250d26aa/requests/252914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ec7cfbf90b7d75934f3e2f6c599d7ff 2x, https://si.imgix.net/250d26aa/requests/252914_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e527db0462e4d5764a636ad7d8d8483 3x", "genre": "art", "nsfw": true, "body": "活発そうなショタプロレスラー・「リョウ」vs悪役レスラー(モブ)のプロレスの試合イラストを描いていただきたいです！\nショタレスラーは「リョウ」という名前で\n髪は赤髪で、アクトくんみたいな髪型でお願いします。\nショタレスラーの体型もアクトくんみたいな体型でお願いします。\nコスチュームは\n赤のブーメラン型のビキニパンツばりの小ささのショートタイツ(後ろにアルファベットでRYOと書いてある)\n赤の肘サポーターにニーパッドでお願いします。\n悪役レスラーは大人で、黒のショートタイツのシンプルなコスチュームでお願いします。モブなので表情の描写はなくても大丈夫です。\n試合の流れは、リョウが一方的に責められる展開で\nパワーボムや胸へのチョップやロメロスペシャルなどのプロレス技で責められ、逆エビ固めでギブアップ寸前まで悶絶するも、「負けるもんか…」と言いながらロープブレイクし、ジャーマンスープレックスでの逆転の3カウントフォール勝ちを上げる\nという展開のイラストをお願いします！m(_ _)m", "created_at": "", "completed_at": ""}]}