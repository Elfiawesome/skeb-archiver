8bc-8d829dd13e56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12c661cca58b04831b2c438a02067380", "thumbnail_srcset": "https://si.imgix.net/9959bf7a/uploads/origins/e1dfc739-a1b5-4461-88bc-8d829dd13e56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12c661cca58b04831b2c438a02067380, https://si.imgix.net/9959bf7a/uploads/origins/e1dfc739-a1b5-4461-88bc-8d829dd13e56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=80159679247fc570e64158b4fa7198a6 2x, https://si.imgix.net/9959bf7a/uploads/origins/e1dfc739-a1b5-4461-88bc-8d829dd13e56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7330915f343846f4fd64948e0b0358f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kakatoooo_09/works/89", "thumbnail_src": "https://si.imgix.net/fcacee26/uploads/origins/d1fede98-1406-4009-b3fa-cf2aba259495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c97b5007916e2b6105a7303adeef5474", "thumbnail_srcset": "https://si.imgix.net/fcacee26/uploads/origins/d1fede98-1406-4009-b3fa-cf2aba259495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c97b5007916e2b6105a7303adeef5474, https://si.imgix.net/fcacee26/uploads/origins/d1fede98-1406-4009-b3fa-cf2aba259495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f978cfa52cec0cc4ed5312e0aaaa136 2x, https://si.imgix.net/fcacee26/uploads/origins/d1fede98-1406-4009-b3fa-cf2aba259495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c7c4ca77d692417af670cdd509778c2 3x", "genre": "art", "nsfw": false, "body": "はじめまして、今回当方創作キャラのユキちゃんせんせー(白髪少女)と\nオーエン(白カットソー青髪男)をリクエストさせて頂きたく思います。\n服の三面図は下記参考URLに記載しておきました。\n\nウヲ太先生の描かれる男女イラストの雰囲気が好きなので是非拝見したいなと思っております。\n対格差があり、男が少女の事を死ぬほど好きな感じです。構図等はお任せ致します。\n\nキャラ感の参考に漫画URLも貼っておきます\nhttps://gammaplus.takeshobo.co.jp/manga/yukichansensei/\n\n是非ご検討お願いいたします。\n\nhttps://misskey.io/notes/9sib3q6a089004us", "created_at": "", "completed_at": ""}, {"path": "/@kakatoooo_09/works/88", "thumbnail_src": "https://si.imgix.net/c1845b9a/uploads/origins/63442e8d-a3e7-4178-876d-0b47eda1aabf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=febb7a1cfa1696a18c2d79fb317a1944", "thumbnail_srcset": "https://si.imgix.net/c1845b9a/uploads/origins/63442e8d-a3e7-4178-876d-0b47eda1aabf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=febb7a1cfa1696a18c2d79fb317a1944, https://si.imgix.net/c1845b9a/uploads/origins/63442e8d-a3e7-4178-876d-0b47eda1aabf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b62c7e03c64452aa785b892d6b4c35fc 2x, https://si.imgix.net/c1845b9a/uploads/origins/63442e8d-a3e7-4178-876d-0b47eda1aabf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b0f082c02a6f02fd38fb5e2e843c3bf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kakatoooo_09/works/87", "thumbnail_src": "https://si.imgix.net/674642f8/uploads/origins/664e97c2-065e-4e50-9f24-aa08eb884aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12bbd65372a1fa8c9dfc08cd48521d0c", "thumbnail_srcset": "https://si.imgix.net/674642f8/uploads/origins/664e97c2-065e-4e50-9f24-aa08eb884aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12bbd65372a1fa8c9dfc08cd48521d0c, https://si.imgix.net/674642f8/uploads/origins/664e97c2-065e-4e50-9f24-aa08eb884aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e6367b6a7ea657ad2b9a0119ae92560 2x, https://si.imgix.net/674642f8/uploads/origins/664e97c2-065e-4e50-9f24-aa08eb884aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d02a2cd659cad80cc98ea69637e2431 3x", "genre": "art", "nsfw": false, "body": "こんにちは！失礼します！💕\nデュオの交流のお絵描きの招待が欲しいです！\nもし足りなかったら追加で送っていただいても大丈夫です、ありがとうございます！\n\nキャラはこの二人です\n黒髪の男性：黒髪、金髪の目、右目の下に3つのほくろがある。身長186cm、熱心で明るい男子大学生、義侠心が強くおせっかい好き、趣味は食べ物と旅行。普段はとても明るくニコニコしている。\n紫髪の男：灰色がかった紫色の髪、紫色の目、鼻の近くにほくろがある（普段は眼鏡で隠れている）。身長175cm、ノリが良く頭の回転が速い、突発的で無鉄砲、他人の話にはほとんど無関心で、自分が巻き込まれても全く気にしない。普段の表情は☺️😊。\n関係性：曖昧な時期の友人と解釈できる。紫色の毛むくじゃらの男は、黒髪の男をおだてたり、からかったり、褒めたりする店のカウボーイ的なキャラクターと見ることができ、黒髪の男は相手に対処できず、少しぎこちなく受け入れるか、相手の褒め言葉を楽しむかのどちらかである。通常、旅行やおしゃべりを始めるのは黒髪の男で、食事や観光をし、紫髪の男は話を聞いたり付き合ったりする傾向がある。\n\n2人はドライブ旅行中で、ありがたいことに旅行中に何が起こるか見てみたいと思っている！\n\nhttps://drive.google.com/drive/folders/1-5TFy8fkUNi_-FxRfCp6pnr_bHe9wk-j\n\nhttps://drive.google.com/drive/folders/1-5TFy8fkUNi_-FxRfCp6pnr_bHe9wk-j", "created_at": "", "completed_at": ""}, {"path": "/@kakatoooo_09/works/86", "thumbnail_src": "https://si.imgix.net/dde4e83b/uploads/origins/7d8216c4-2290-4325-85a0-5d54852ba324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0855e6f846cde8019228f62089633889", "thumbnail_srcset": "https://si.imgix.net/dde4e83b/uploads/origins/7d8216c4-2290-4325-85a0-5d54852ba324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0855e6f846cde8019228f62089633889, https://si.imgix.net/dde4e83b/uploads/origins/7d8216c4-2290-4325-85a0-5d54852ba324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=788c13018a4f02aad75d1043ae6cabb0 2x, https://si.imgix.net/dde4e83b/uploads/origins/7d8216c4-2290-4325-85a0-5d54852ba324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d13020bc3f001d432207f8ff99eb1aa6 3x", "genre": "art", "nsfw": false, "body": "ウヲ太さんの絵柄がずっと前から好きで、いつかご依頼したいと思っておりました…！\n\n今回ご依頼したいのはOCの2人です。\n構図などはおまかせしますが、創作男女ですが付き合ってるわけでもなく、どれかというと男側が一方的に近づいてくる関係性です。男側からの距離が近いので女の子側が嫌がってる構図でも大丈夫です。\n\n服装は、女の子がスクールセーターを着ているなら男はスーツにコートを。女の子がブラウスなら男はコートなしで普通のスーツをと、季節感を合わせていただければありがたいです。\n男側はピアスと指に指輪を複数つけてます。お好きなように描いてもらって大丈夫なのでつけてください\n\n参考画像↓\n\nhttps://drive.google.com/drive/folders/1TQ9o32t__cFMGlYzZ9TBjGboriM-Hbrp\n\n金額が足りない場合は再送要請をお願いいたします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1TQ9o32t__cFMGlYzZ9TBjGboriM-Hbrp", "created_at": "", "completed_at": ""}, {"path": "/@kakatoooo_09/works/85", "thumbnail_src": "https://si.imgix.net/1ec8fca1/uploads/origins/aba7457e-30a6-49ce-9267-902dea8ea40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab27e78b927397958085f5c73e2f21f0", "thumbnail_srcset": "https://si.imgix.net/1ec8fca1/uploads/origins/aba7457e-30a6-49ce-9267-902dea8ea40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab27e78b927397958085f5c73e2f21f0, https://si.imgix.net/1ec8fca1/uploads/origins/aba7457e-30a6-49ce-9267-902dea8ea40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb0d6e15634746815223b13402227c67 2x, https://si.imgix.net/1ec8fca1/uploads/origins/aba7457e-30a6-49ce-9267-902dea8ea40d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae650e08a7f4911df9f3c71581cf5e49 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kakatoooo_09/works/84", "thumbnail_src": "https://si.imgix.net/8fca7df7/uploads/origins/5cd47bc3-efc1-4634-9434-3dd29c99ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b221969ac92e0a3b7780ebacc077f4e", "thumbnail_srcset": "https://si.imgix.net/8fca7df7/uploads/origins/5cd47bc3-efc1-4634-9434-3dd29c99ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b221969ac92e0a3b7780ebacc077f4e, https://si.imgix.net/8fca7df7/uploads/origins/5cd47bc3-efc1-4634-9434-3dd29c99ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=715447549f06d7fe1e33f022d670bc91 2x, https://si.imgix.net/8fca7df7/uploads/origins/5cd47bc3-efc1-4634-9434-3dd29c99ec54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39f30d4edceec61b40e48a6c5d3a467b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！あなたの美しい絵がとても好きなので、私のオリジナルキャラクターに絵を描いていただきたいと思います。\n\nキャラクター(カップルです)\n黒髪(179cm〜):航空機デザイナー、雪国在住、美男美女。\n茶髪(185+):心理学者、外交官、黒髪を愛し、理解する大人のイケメン。\n参考情報\nhttps://drive.google.com/drive/folders/12nKgkO24np10WBaityD-SdqR3NYAd33p\n\n内容が不適切な場合はキャンセルしてください！金額が足りない場合は再送をお願いします。ご検討のほど、よろしくお願いいたします！\n用途：個人閲覧、個人非商用印刷。", "created_at": "", "completed_at": ""}, {"path": "/@kakatoooo_09/works/83", "thumbnail_src": "https://si.imgix.net/19c8560a/uploads/origins/9d528557-a778-4c2c-94f2-5a438d864405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fa38efd405c04379ea589bd6efab949", "thumbnail_srcset": "https://si.imgix.net/19c8560a/uploads/origins/9d528557-a778-4c2c-94f2-5a438d864405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fa38efd405c