%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09b2b6ead3641968efdacc590149cd2f, https://si.imgix.net/cfddf127/uploads/origins/f969c47e-538e-4001-9cfa-0eff96c785e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7222d2cec7ef787044c1eec6b3744ef1 2x, https://si.imgix.net/cfddf127/uploads/origins/f969c47e-538e-4001-9cfa-0eff96c785e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99c0ae437ef5252ca4f9b8d9b74bd5c2 3x", "genre": "art", "nsfw": false, "body": "eviさんこんにちは、お世話になっております果取です\nいつかご依頼させて頂きたい！と密かに思っておりましたので意を決してリクエスト失礼いたします！\n\neviさんの描かれる淡い色味の女の子がとても好きなので、良ければ記載しておりますリンクの子を描いて頂きたいです\n生クリーム入り苺大福が好きで、マイペースな性格の科捜研勤務の女です\n雰囲気や構図等お任せします、服装もこの通りでなくても構いません\n\n個人的観賞用でのご依頼になります\n商用利用はございません\nご検討いただけますと幸いです\n\nhttps://x.com/katori_trpg/status/1769222291228148214", "created_at": "", "completed_at": ""}, {"path": "/@tabenai_yo_/works/11", "thumbnail_src": "https://si.imgix.net/3b01443c/uploads/origins/11e61430-417c-46df-9de0-123eea9c1e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c0f542b9ad7f23e42610cd9faecf89", "thumbnail_srcset": "https://si.imgix.net/3b01443c/uploads/origins/11e61430-417c-46df-9de0-123eea9c1e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c0f542b9ad7f23e42610cd9faecf89, https://si.imgix.net/3b01443c/uploads/origins/11e61430-417c-46df-9de0-123eea9c1e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bd40c5234e0a2e94e8673cd0868b367 2x, https://si.imgix.net/3b01443c/uploads/origins/11e61430-417c-46df-9de0-123eea9c1e85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c06948c5eb13edbd97da564df11878e 3x", "genre": "art", "nsfw": false, "body": "evi先生こんにちは、初めまして！\n先生の絵が絶対好きで、キャラクターがイラストをお願いしたいです!\n使用用途：\n*個人観賞用\nキャラクター説明：\n外見（172cm）：オレンジ色の髪、青い目、長いまつげ。22歳。\n帝国の100年に一度の天才。非常に傲慢で、その強さゆえに人と話すことを好まない。 あらゆる武器が得意。 好きなことは新しい武器を試すことと体を鍛えること。 ある男のガードマンとして働いており、相手の利益のためなら何でもする。 根は少々ひねくれ者。\n雰囲気は暗くても明るくても構いません、自由に描いてください！\n衣装、髪型は資料URLと同じものでも、自由にデザインしていただいても構いません。\nよろしくお願いします！\nhttps://photos.app.goo.gl/2SPx5qx8pjSmWyLy5", "created_at": "", "completed_at": ""}, {"path": "/@tabenai_yo_/works/10", "thumbnail_src": "https://si.imgix.net/0806e0cd/uploads/origins/aaaaa214-914b-43ad-a482-68acf67b6e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9214d2d17ac6d38c01b57e5bb9c5df8a", "thumbnail_srcset": "https://si.imgix.net/0806e0cd/uploads/origins/aaaaa214-914b-43ad-a482-68acf67b6e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9214d2d17ac6d38c01b57e5bb9c5df8a, https://si.imgix.net/0806e0cd/uploads/origins/aaaaa214-914b-43ad-a482-68acf67b6e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa3c3f9f7cd191ee8558765c2d132aaf 2x, https://si.imgix.net/0806e0cd/uploads/origins/aaaaa214-914b-43ad-a482-68acf67b6e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c249f0735a73b5f635359dc0085ac026 3x", "genre": "art", "nsfw": false, "body": "Dear eviさん,\n\nHello, I love your paintings very much, especially the outfits that you design. I would love it if you can design an outfit for my characters, Cecilia and Lee. \n\nCharacter impressions:\nCecilia is a witch with an impression of flowers and gems.\nLee is a tomgirl as the offspring of a cat goddess governing dreams.\nCecilia and Lee are lovers and Cecilia is dominant in their relationship.\n\nOutfit style wanted:\nLolita風/和風\n\nDetailed character information and other clothes reference link: https://sta.sh/216i6p2p5j38. \n\nThank you very much for your time.\nHave a nice day!\n\nhttps://sta.sh/216i6p2p5j38", "created_at": "", "completed_at": ""}, {"path": "/@tabenai_yo_/works/9", "thumbnail_src": "https://si.imgix.net/3746ad64/uploads/origins/ad53d438-3970-4470-9122-8340bf6abfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d72590528fbcf3db0586ed84d85166", "thumbnail_srcset": "https://si.imgix.net/3746ad64/uploads/origins/ad53d438-3970-4470-9122-8340bf6abfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48d72590528fbcf3db0586ed84d85166, https://si.imgix.net/3746ad64/uploads/origins/ad53d438-3970-4470-9122-8340bf6abfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2152107159ab97516caa64855cc6b8fb 2x, https://si.imgix.net/3746ad64/uploads/origins/ad53d438-3970-4470-9122-8340bf6abfd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8c5a0a30572404ae5251c2d1a066ebd 3x", "genre": "art", "nsfw": false, "body": "初めまして。eviさんのskeb作品の絵柄がとても好みだったので依頼させていただきました。\n\n資料のOCを描いていただきたいです。\n自由に描いていただいて大丈夫ですが、可能であればOCに青緑色の花を持たせてほしいです。本数はお任せします。花の種類に関しては、彼女に似合いそうなものをチョイスしていただければ嬉しいです。\n\n【設定】 \n・車椅子に乗っている  \n・イメージカラーは青緑色 \n・年齢20歳、身長157㎝\n ・髪質ふわふわ、白色の長髪\n・髪型は、左側に髪で薔薇を作った三つ編みハーフアップ  \n・肌は色白  \n・青緑色の目(色は資料参照)\n・長い下まつげが特徴(上まつ毛も長い) \n・右耳に、青緑色のリボンの片耳ピアスをつけてる(色と形は資料参照)\n ・儚さを感じるふわふわとした雰囲気のかなりの美人 \n・服は資料のものでも、新しくデザインしていただいたもののどちらでもいいです。(新しくデザインしていただける場合は、ワンピースもしくは下がスカートの服を希望)\n\nもし表情差分を描いていただける場合は、泣き顔もお願いしたいです。\n用途はSNSのアイコン・ヘッダー、ホーム画面、個人用に印刷となります。\n\nご検討お願いいたします。\n\nhttps://drive.google.com/drive/folders/151tvbcIIIhymcWmDgvfoaPAe5_p7xs-J", "created_at": "", "completed_at": ""}, {"path": "/@tabenai_yo_/works/8", "thumbnail_src": "https://si.imgix.net/fb1ac5cc/uploads/origins/f3844883-6ea6-4598-a5c7-c6127256b537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9851ebb06fd79027d6b337765b3ad6e1", "thumbnail_srcset": "https://si.imgix.net/fb1ac5cc/uploads/origins/f3844883-6ea6-4598-a5c7-c6127256b537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9851ebb06fd79027d6b337765b3ad6e1, https://si.imgix.net/fb1ac5cc/uploads/origins/f3844883-6ea6-4598-a5c7-c6127256b537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73aff674b7b337d63be54b9723f3f061 2x, https://si.imgix.net/fb1ac5cc/uploads/origins/f3844883-6ea6-4598-a5c7-c6127256b537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6c403e373a306805e03c838b051dc51 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nTLにてevi様の描かれたSkebイラストを拝見し、透明感や繊細な表情に惹かれてリクエストを送らせていただきます。\nCoCシナリオ「新生・ジャンヌの猟犬」にて使用したキャラクターをお願いできれば嬉しいです。\n\n＝＝＝\n\n【Claude･Tournier（クロード・トゥルニエ）】\n29歳・男・181㎝\n教会の司祭。茶目っ気があり、人をからかうことを楽しんでいるタイプ。\n文句を言いつつも仕事は真面目にこなすが、落ち着きがなく子供っぽくはしゃぎがち。\n複数人のチームでは率先して緩衝材や賑やかしに回るが、どちらかといえば誰かに手を引かれるのが似合う方。\n\n＝＝＝\n\nロストしてしまいましたが、向かう先に救いがありますとようにと餞としてリクエストさせていただきました。\nシーンや構図、服装などはevi様にお任せできればと考えております。\n\n連休も後半に入りました。寒暖差の激しい日が続きますが、どうぞお身体ご自愛ください。\n\nhttps://drive.google.com/file/d/1Kr-ZN8zG3Qd3IdL-yTuKfGxUa3nwIJZn/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@tabenai_yo_/works/7", "thumbnail_src": "https://si.imgix.net/f12854d5/uploads/origins/50c66d76-ddec-4c8a-915e-223737442f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=261b60f1ed8aa36a1a9800deebfb6427", "thumbnail_srcset": "https://si.imgix.net/f12854d5/uploads/origins/50c66d76-ddec-4c8a-915e-223737442f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=261b60f1ed8aa36a1a9800deebfb6427, https://si.imgix.net/f12854d5/uploads/origins/50c66d76-ddec-4c8a-915e-223737442f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abcc935b22a765a70eb9a144d3cbe6d0 2x, https://si.imgix.net/f12854d5/uploads/origins/50c66d76-ddec-4c8a-915e-223737442f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=959d02d73318902212f49da9de04b3a4 3x", "genre": "art", "nsfw": false, "body": "evi様こんにちは、TLで素敵な絵を拝見し一目惚れしてしまいました！\nぜひご依頼出来たらと思っています！\nもしよければ私とフォロワーさんのオリジナルキャラクターの探偵と助手を描いていただけないでしょうか？\nおじさんの探偵と女子高生の助手の二人で一緒に探偵業をしています。恋人っぽい雰囲気だと嬉しいです！\n\n▽希望\nevi様の描かれる絵の色合いや雰囲気が好きなので、雰囲気や構図などはお任せで描いていただけたら思っています。服装などは描きやすい形で描いていただけたら幸いです。\n\n▽資料/詳細\nおじさん探偵と女子高生の助手の女の子\nhttps://drive.google.com/drive/folders/1nr-jEFPsNHxVSPPalPTnblh2DVxPt8Y6?usp=sharing\nへらへらしてるおじさんの探偵と、しっかりものの助手の女の子です！\n探偵である男性は今現在は紫の目から緑の目に変化しています。\n今現在は二人とも恋人関係となり、婚約していて指輪を付けています。\n\n▽使用用途\n個人観賞及びSNSなどでの画像アップロード\nアクリルキーホルダー等のグッズ制作\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nr-jEFPsNHxVSPPalPTnblh2DVxPt8Y6?usp=sharing", "created_at": "", "completed_at": ""}]}