1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abf4536e88235d76c73fd83e6b0d622b 2x, https://si.imgix.net/8ed6fe3b/uploads/origins/2feca4d1-83e8-45e0-83fc-ca8d53aa95d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4c6663b662b0e35e3a368c5009a77e9 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n僕のキャラクターに興味を持ってくれてありがとう。\n\n彼の愛らしく無邪気な一面を捉えたイラストを依頼したいと思います。\n\n私のキャラクターを気に入っていただけてとても嬉しいです。\n\nhttps://drive.google.com/drive/folders/1egQ0p-r4f_uKnZR9n6PQNVFZLrbLkY5Y?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/12", "thumbnail_src": "https://si.imgix.net/0a42caab/uploads/origins/d9d98f41-efee-45b8-bf7b-487dcf1f5940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c1334b26f51ec1cf726784a5a89bce1", "thumbnail_srcset": "https://si.imgix.net/0a42caab/uploads/origins/d9d98f41-efee-45b8-bf7b-487dcf1f5940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c1334b26f51ec1cf726784a5a89bce1, https://si.imgix.net/0a42caab/uploads/origins/d9d98f41-efee-45b8-bf7b-487dcf1f5940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc20e0d4901f4011d49020f8e02a5d60 2x, https://si.imgix.net/0a42caab/uploads/origins/d9d98f41-efee-45b8-bf7b-487dcf1f5940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a21d4398d29e89479801369e0a86f56c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアピールを受け取りました。あなたのアートスタイルは本当にかわいいです！私のキャラクターは、優しくてかわいいピンクのキツネです！お茶を飲むのが大好きで、のんびりとした時間を過ごしています。彼女のイラストは自由に描いてください！表情も選べます！\n\nあなたの作品を楽しみにしています！:3\n\n参考：https://drive.google.com/drive/folders/1REF0EO9xvCiMd4B_GGBauSDVCVZqFEsz?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1REF0EO9xvCiMd4B_GGBauSDVCVZqFEsz?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/11", "thumbnail_src": "https://si.imgix.net/847fb18e/uploads/origins/30528ccf-9af8-426f-a8f3-c7fef1de8606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ef36dab86ae5119bfcbb5bf58bb7680", "thumbnail_srcset": "https://si.imgix.net/847fb18e/uploads/origins/30528ccf-9af8-426f-a8f3-c7fef1de8606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ef36dab86ae5119bfcbb5bf58bb7680, https://si.imgix.net/847fb18e/uploads/origins/30528ccf-9af8-426f-a8f3-c7fef1de8606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db4df4002606f5ab09367958cc4a5c8c 2x, https://si.imgix.net/847fb18e/uploads/origins/30528ccf-9af8-426f-a8f3-c7fef1de8606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5d9729251337645b94cc9073521d028 3x", "genre": "art", "nsfw": false, "body": "もし可能なのであれば、小南んくさんが以前作成されていた、\nキプフェルとまめひなたのイラスト(https://x.com/nnku000/status/1908124414081990766)の、\nオマージュを後述の改変アバターで作成していただきたく存じます。\n\nhttps://drive.google.com/drive/folders/1nQ3qdL3Il_xFvgwg1C8ccZ83tEGaAA__?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/10", "thumbnail_src": "https://si.imgix.net/d4369649/uploads/origins/348bbf75-c593-4eba-b245-f08277d923d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4c9c2965863db99308ade809022a065", "thumbnail_srcset": "https://si.imgix.net/d4369649/uploads/origins/348bbf75-c593-4eba-b245-f08277d923d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4c9c2965863db99308ade809022a065, https://si.imgix.net/d4369649/uploads/origins/348bbf75-c593-4eba-b245-f08277d923d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8de0a2b31b8c6c821eab08db94cffc0f 2x, https://si.imgix.net/d4369649/uploads/origins/348bbf75-c593-4eba-b245-f08277d923d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dcf9f75e1e98855723360cc909d1e72 3x", "genre": "art", "nsfw": false, "body": "先生こんにちは、先生の画風は私には超可愛いです、とても大好きです、ocのイラストをお願いできればと思います、特別な条件はありません、ただ活発で可愛いです、ocの設定はとても気になります、どうぞお気軽にお試しください、どうもありがとうございました💗！\n\nhttps://drive.google.com/file/d/12MiWChFZFcLACF6AdzA8FpjliTy00D8e/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/9", "thumbnail_src": "https://si.imgix.net/2a2149d6/uploads/origins/527fcddf-a1c4-4c36-a66b-98c7c683f307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5efd67df92897b13ff8eabc973b2a66c", "thumbnail_srcset": "https://si.imgix.net/2a2149d6/uploads/origins/527fcddf-a1c4-4c36-a66b-98c7c683f307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5efd67df92897b13ff8eabc973b2a66c, https://si.imgix.net/2a2149d6/uploads/origins/527fcddf-a1c4-4c36-a66b-98c7c683f307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c4bd54df5ee24bcef89fd0d4ef32415 2x, https://si.imgix.net/2a2149d6/uploads/origins/527fcddf-a1c4-4c36-a66b-98c7c683f307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e416976433cac73f3b362bf3a6ede5bb 3x", "genre": "art", "nsfw": false, "body": "このキャラクターを描けますか？\n\nhttps://files.catbox.moe/hf7blv.png\n\nポーズやシチュエーションは問いません。", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/8", "thumbnail_src": "https://si.imgix.net/137f594d/uploads/origins/e7d9c943-f7d7-4126-8f37-9a631963e367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87113eaa55f07dfd981fbf37cb63a12d", "thumbnail_srcset": "https://si.imgix.net/137f594d/uploads/origins/e7d9c943-f7d7-4126-8f37-9a631963e367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87113eaa55f07dfd981fbf37cb63a12d, https://si.imgix.net/137f594d/uploads/origins/e7d9c943-f7d7-4126-8f37-9a631963e367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c1a4a7fd38b786bddec2f65b194f6b7 2x, https://si.imgix.net/137f594d/uploads/origins/e7d9c943-f7d7-4126-8f37-9a631963e367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bca2fa04552f8e24685a069c55d237e9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアピールを受け取りました！私のキャラクターは、普段はとてものんびりしていて、かわいい表情やポーズで自然の中で楽しんでいます！今回もありがとうございました。結果を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1BN1Kd2W6_n5mS1oolRDTfuoG5OU-t63e", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/7", "thumbnail_src": "https://si.imgix.net/88e5cbe4/uploads/origins/1f1ee708-76ee-4457-a854-6e116f98e6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efbcae855392c290433a58498b92f7ee", "thumbnail_srcset": "https://si.imgix.net/88e5cbe4/uploads/origins/1f1ee708-76ee-4457-a854-6e116f98e6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efbcae855392c290433a58498b92f7ee, https://si.imgix.net/88e5cbe4/uploads/origins/1f1ee708-76ee-4457-a854-6e116f98e6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2cf0b414c52162a7dafd539b9588c1c 2x, https://si.imgix.net/88e5cbe4/uploads/origins/1f1ee708-76ee-4457-a854-6e116f98e6ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea7c5661cbbc7f2b8adf9619dbe2f2f4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！自己推薦見ました！私のocを気に入ってくれてありがとうございます！\nhttps://drive.google.com/file/d/17YF3C-83v9I_SzuESiZ6dPqDz6w0nHpk/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/17YF3C-83v9I_SzuESiZ6dPqDz6w0nHpk/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/6", "thumbnail_src": "https://si.imgix.net/ca77fc22/uploads/origins/81ef71d7-58b4-413b-89f1-b5a4cf6700e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3afc780b90836445ba418a89f29a1d6", "thumbnail_srcset": "https://si.imgix.net/ca77fc22/uploads/origins/81ef71d7-58b4-413b-89f1-b5a4cf6700e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3afc780b90836445ba418a89f29a1d6, https://si.imgix.net/ca77fc22/uploads/origins/81ef71d7-58b4-413b-89f1-b5a4cf6700e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b2cd327f4fc63daa34ce477e7a78690 2x, https://si.imgix.net/ca77fc22/uploads/origins/81ef71d7-58b4-413b-89f1-b5a4cf6700e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e8e4bff6ec933c2c86935cc25ebac5d 3x", "genre": "art", "nsfw": false, "body": "こんにちは、自己アピールを拝見しました！私のOCを気に入ってくれてとても感謝しています！\nその時は遠慮なく創作してください！どんなOCでも大丈夫です、ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/5", "thumbnail_src": "https://si.imgix.net/2b2589fa/uploads/origins/fc599a6e-556b-401a-bcc5-22a852be8593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5c76f857413186b558947353bf984d0", "thumbnail_srcset": "https://si.imgix.net/2b2589fa/uploads/origins/fc599a6e-556b-401a-bcc5-22a852be8593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5c76f857413186b558947353bf984d0, https://si.imgix.net/2b2589fa/uploads/origins/fc599a6e-556b-401a-bcc5-22a852be8593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c86c3d784dd597d689bad5100c5b1fbd 2x, https://si.imgix.net/2b2589fa/uploads/origins/fc599a6e-556b-401a-bcc5-22a852be8593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dba39d7aa88c12dd9bbbbbb1b78e1e7 3x", "genre": "art", "nsfw": false, "body": "小南んく様\n\n初めてまして、Oqicyと申します。\n\nよろしければ、うちの子のイラストをリクエストさせてください！\n構図などは小南んくさんの自由に描いていただけると嬉しいです。\n\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1CAX7w8Uk0nHQIoZEpaSqJ9EbJ-_V8reu/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/4", "thumbnail_src": "https://si.imgix.net/26a8fa68/uploads/origins/bd462c33-bb24-4dd0-a6e2-7c1322bca6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6a54fcca8e18ad1009da347fb3bcf7", "thumbnail_srcset": "https://si.imgix.net/26a8fa68/uploads/origins/bd462c33-bb24-4dd0-a6e2-7c1322bca6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6a54fcca8e18ad1009da347fb3bcf7, https://si.imgix.net/26a8fa68/uploads/origins/bd462c33-bb24-4dd0-a6e2-7c1322bca6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd1e0b85c7ca8b63d225b2be330780bd 2x, https://si.imgix.net/26a8fa68/uploads/origins/bd462c33-bb24-4dd0-a6e2-7c1322bca6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55adede2ea9356a2c27a4bf8afb089f0 3x", "genre": "art", "nsfw": false, "body": "こんにちは、アピールをありがとうございます！あなたの絵はとてもかわいいです🥰 私のキャラクターを好きなように描いてください。\n\nこの度はありがとうございました！\n\nhttps://drive.google.com/drive/folders/193qYtCHzosGHtzdQJLgBkp2lGoK6NxT0?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/3", "thumbnail_src": "https://si.imgix.net/75de4c44/uploads/origins/6e9574cf-0a6a-44c8-b99d-d0347dd8dcf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3581828408f6cdb0692e1e2cc83b2e8", "thumbnail_srcset": "https://si.imgix.net/75de4c44/uploads/origins/6e9574cf-0a6a-44c8-b99d-d0347dd8dcf6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3581828408f6cdb0692e1e2cc83b2e8, https://si.imgix.net/75de4c44/uploads/origins/6e9574cf-0a6a-44c8-b99d-d0347dd8dcf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b58409c07e121f6abf8156369204b43 2x, https://si.imgix.net/75de4c44/uploads/origins/6e9574cf-0a6a-44c8-b99d-d0347dd8dcf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4d9911179d09bb336a5b5a7766db8c3 3x", "genre": "art", "nsfw": false, "body": "小南んく様\n\nお世話になっております。\n冬藤かさねです。\n\nおかげさまで、\nかさねこ もたくさんのリスナーさんに愛されていてボクも嬉しいです。\nかさねこのファンもいるくらいです🐾\n\nよろしければ、かさねこのイラストをリクエストさせてください。\n構図などはおまかせしますので、可愛い感じに自由に描いていただければ。\n\nご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nnku000/works/2", "thumbnail_src": "https://si.imgix.net/1529b3e6/requests/294585_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b31f24b9e76f7893f9983156b15af703", "thumbnail_srcset": "h