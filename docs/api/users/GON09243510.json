6d7-866d-2b41d82f9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=853ca9d8c183434b5c077aa90af9e2be, https://si.imgix.net/d36def37/uploads/origins/07d940eb-2095-46d7-866d-2b41d82f9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e95c9fd0962cd2124d841c213b292a7 2x, https://si.imgix.net/d36def37/uploads/origins/07d940eb-2095-46d7-866d-2b41d82f9a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72ddaab9b197bf8d44acfd26c6ec3d05 3x", "genre": "art", "nsfw": false, "body": "こんにちは!私は本当にあなたの芸術のスタイルが好きです!\n\n私のキャラクター「すこ」の絵をお願いしたいです。彼女はとてもかわいくて、恥ずかしがり屋で、でも元気な子です。ビキニ姿のアートをお願いします。すこ: https://imgur.com/a/5bu6iCm\n\nこのポーズでお願いします。https://imgur.com/pdmN7Xi\n髪型は参考画像と同じでお願いします。可愛くてセクシーな感じにしたいです。\n\nもしよろしければ、ツイッターに投稿させていただきます。\nご検討よろしくお願いします\n\nhttps://imgur.com/a/5bu6iCm", "created_at": "", "completed_at": ""}, {"path": "/@GON09243510/works/6", "thumbnail_src": "https://si.imgix.net/95a34fd5/uploads/origins/d0ed1ffd-1ac6-4590-83fa-ab12b07ab7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2ebbd01398d7bbf6fb4e224883db00a", "thumbnail_srcset": "https://si.imgix.net/95a34fd5/uploads/origins/d0ed1ffd-1ac6-4590-83fa-ab12b07ab7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2ebbd01398d7bbf6fb4e224883db00a, https://si.imgix.net/95a34fd5/uploads/origins/d0ed1ffd-1ac6-4590-83fa-ab12b07ab7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=165fe5da236d08394db17cd833105795 2x, https://si.imgix.net/95a34fd5/uploads/origins/d0ed1ffd-1ac6-4590-83fa-ab12b07ab7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=937b8e0d549aa537caa73362e02982b6 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n前回の依頼であなたの作品がとても気に入ったので、これからもお願いしたいと思っています。\n\n今回はLeague of LegendsのAhri（私の好きなチャンピオン）の絵をお願いしたいです。この絵は、もしかしたらディスプレイ用の絵として使うかもしれません。描いてくれるなら何でもOKです。もし提案があれば、アーリはキスをしている（彼女の魅力的な動き）とか、アーリは両手を広げてハグをしている、とか。\n\n読んでくれてありがとう、そしてあなたのスタイルが本当に好きです。これからも素晴らしい作品を作ってください。", "created_at": "", "completed_at": ""}, {"path": "/@GON09243510/works/5", "thumbnail_src": "https://si.imgix.net/bd3940bf/uploads/origins/3738991b-cc9b-43e1-b9c4-25b862c5b4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff5edaecf9b2b5ad2123e88fcec17ba", "thumbnail_srcset": "https://si.imgix.net/bd3940bf/uploads/origins/3738991b-cc9b-43e1-b9c4-25b862c5b4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff5edaecf9b2b5ad2123e88fcec17ba, https://si.imgix.net/bd3940bf/uploads/origins/3738991b-cc9b-43e1-b9c4-25b862c5b4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b8b8f3e940ff5c7c0e79fee331ba581 2x, https://si.imgix.net/bd3940bf/uploads/origins/3738991b-cc9b-43e1-b9c4-25b862c5b4f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d4a40ab8135089d1c57f25fdaf102d1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Gon!\nあなたのアートワークはとても素敵で、私の友人のOC Vtuberのために作品を作ってもらいたいくらいです。\n\nバニーガールのコスプレをお願いしたいです。\n\nこれは私の友人のOCです。お花のVtuberをやっている優しくて可愛い子です。\nhttps://drive.google.com/file/d/1FfclsACyTw6grnYASYyy1xDuntNBACF2/view?usp=sharing\n\nもう少し大人っぽく描いて欲しいです!\nこんな感じで描いて欲しいです。\nバニーガール姿で恥ずかしそうに顔を赤らめているのもお願いしたいです!\nhttps://drive.google.com/file/d/1ralGI3voNJ79dRtiW-2IC03PatRbh-Q0/view?usp=sharing\n\n誕生日プレゼントのため、クレジットのない絵のコピーを希望します\n\n本当にありがとうございました!\n\nhttps://drive.google.com/drive/folders/18P_KN6XfGjR-mf0MbviSP0NkJXVLubUI?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@GON09243510/works/4", "thumbnail_src": "https://si.imgix.net/30863d43/uploads/origins/da1ea107-df24-4159-98c3-857ad7a88304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9e4f8da8da697f269a5567ed933742", "thumbnail_srcset": "https://si.imgix.net/30863d43/uploads/origins/da1ea107-df24-4159-98c3-857ad7a88304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9e4f8da8da697f269a5567ed933742, https://si.imgix.net/30863d43/uploads/origins/da1ea107-df24-4159-98c3-857ad7a88304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56beac07d8876143ee08c40344e97d98 2x, https://si.imgix.net/30863d43/uploads/origins/da1ea107-df24-4159-98c3-857ad7a88304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba7f1acdffc5092229274e144f6985c2 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\n友人へのプレゼントとしてアートワークをお願いしています。彼女はvtuberです。\n彼女のツイッター→https://twitter.com/mocaverse/status/1535769153721753601\nこのキャラのようなお姉さん体型をお願いします→https://azurlane.koumakan.jp/wiki/Atago\nどんなポーズでもいいです。\n\nよろしくお願いします。\n\nhttps://azurlane.koumakan.jp/wiki/Atago", "created_at": "", "completed_at": ""}, {"path": "/@GON09243510/works/3", "thumbnail_src": "https://si.imgix.net/5678f417/uploads/origins/5ac367ea-dcb4-4c69-9a09-44a768fd3498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51501e01ac0069e6671811fd850c2aa2", "thumbnail_srcset": "https://si.imgix.net/5678f417/uploads/origins/5ac367ea-dcb4-4c69-9a09-44a768fd3498?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51501e01ac0069e6671811fd850c2aa2, https://si.imgix.net/5678f417/uploads/origins/5ac367ea-dcb4-4c69-9a09-44a768fd3498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5d7f63ebaef949658c0e954ac813618 2x, https://si.imgix.net/5678f417/uploads/origins/5ac367ea-dcb4-4c69-9a09-44a768fd3498?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b14dcd3f67eea6167aac726154839166 3x", "genre": "art", "nsfw": false, "body": "はじめまして。私の好きなvtuberを描いてください。\n\nキャラクター設定です。なでしこは魔女のお姫様。MMORPGでギルドマスターを務めている。かわいくて上品で、ちょっと恥ずかしがり屋。お茶とお花が好き。\n\nバニーガール姿で照れくさそうにしているところをお願いします。\n\nありがとうございます。この絵は、彼女のスケジュール帳の中で使わせていただくことがあります。可能であれば、透過PNGファイルを添付してください。\n\nhttps://twitter.com/nadechama/status/1545810114661167104", "created_at": "", "completed_at": ""}, {"path": "/@GON09243510/works/2", "thumbnail_src": "https://si.imgix.net/42eda1c1/uploads/origins/d0035716-63ca-4340-bc1e-80ef777ef8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db01ce97e06c651f70c8f9861ebd7345", "thumbnail_srcset": "https://si.imgix.net/42eda1c1/uploads/origins/d0035716-63ca-4340-bc1e-80ef777ef8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db01ce97e06c651f70c8f9861ebd7345, https://si.imgix.net/42eda1c1/uploads/origins/d0035716-63ca-4340-bc1e-80ef777ef8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7137c343c6147795933b0304b2d7a14c 2x, https://si.imgix.net/42eda1c1/uploads/origins/d0035716-63ca-4340-bc1e-80ef777ef8ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98c4ba9b5790e37dedbc4ad91349d449 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\nグランブルーファンタジーのレオナの絵をお願いしたいです。この絵は展示用の絵として使うかもしれません。描いてくれるなら何でもいいです。もし提案があれば、レオナは槍を後ろに持って、腕を頭の上に持っているのがいいかもしれません。\n\n読んでくれてありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@GON09243510/works/1", "thumbnail_src": "https://si.imgix.net/2b0ade43/uploads/origins/01e61bac-6a88-422c-934b-0be21ff82c30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cb69dacb9d4175e53a7e178a8f90e69", "thumbnail_srcset": "https://si.imgix.net/2b0ade43/uploads/origins/01e61bac-6a88-422c-934b-0be21ff82c30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cb69dacb9d4175e53a7e178a8f90e69, https://si.imgix.net/2b0ade43/uploads/origins/01e61bac-6a88-422c-934b-0be21ff82c30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f90249646a94485e4a2ca22575799ef 2x, https://si.imgix.net/2b0ade43/uploads/origins/01e61bac-6a88-422c-934b-0be21ff82c30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bb695827ee63171557191a4d8f006b7 3x", "genre": "art", "nsfw": false, "body": "はじめまして、リクエスト失礼します。\n■キャラクター\nFGO　マシュ・キリエライト\n■衣装\nバニーガール\nオーソドックスなものでなくクリエイター様なりのアレンジした衣装だと嬉しいです\nキャラクターをイメージしたアレンジでなくても何も問題ありません\nウサギの耳があるからバニーガールだというくらいアレンジは自由にしていただいて構いません\n他作品やキャラのバニー衣装でも大丈夫です\n■ポーズ\n具体的な指定はありませんがセクシーな感じでお願いします\n\nよろしくお願いします", "created_at": "", "completed_at": ""}]}