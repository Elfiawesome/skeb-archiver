-ad47-b13ae7418465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abb42949b32fc754b412ef496cfe291c 2x, https://si.imgix.net/97c622b6/uploads/origins/c7c4ee31-4d7f-4984-ad47-b13ae7418465?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b136579431e20d3525af73c33db8424 3x", "genre": "art", "nsfw": true, "body": "アブリボンにドレインキッスをされて、体力を吸われてぐるぐる目になっているチェリム(ポジフォルム)をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/30", "thumbnail_src": "https://si.imgix.net/fe0a4bc0/uploads/origins/260ef4e8-6874-49d3-96da-fe13b72adf74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efb7242414bb4588246efb493dc8a6c3", "thumbnail_srcset": "https://si.imgix.net/fe0a4bc0/uploads/origins/260ef4e8-6874-49d3-96da-fe13b72adf74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efb7242414bb4588246efb493dc8a6c3, https://si.imgix.net/fe0a4bc0/uploads/origins/260ef4e8-6874-49d3-96da-fe13b72adf74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23e110d9513857672842e455c7c14a22 2x, https://si.imgix.net/fe0a4bc0/uploads/origins/260ef4e8-6874-49d3-96da-fe13b72adf74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=481faf7da7579cf0ad4e0d6eb7d448a3 3x", "genre": "art", "nsfw": false, "body": "うちの子のみーくん（https://twitter.com/haidamadesu/status/1518964320586977280?t=BZJdIqbhSHkd5LsrUuMFYQ&s=19）のぼあ絵をお願い致します...！\n\n被食側は適当な白ハゲで、全体的な構図はお任せですが、長い舌が見える感じだと嬉しいです ...！\n\nhttps://twitter.com/haidamadesu/status/1518964320586977280?t=BZJdIqbhSHkd5LsrUuMFYQ&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/29", "thumbnail_src": "https://si.imgix.net/efba6c66/uploads/origins/fc92cfad-48bd-4880-9376-20f946572ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6938ad8a1996a80bc317706abd60aa5e", "thumbnail_srcset": "https://si.imgix.net/efba6c66/uploads/origins/fc92cfad-48bd-4880-9376-20f946572ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6938ad8a1996a80bc317706abd60aa5e, https://si.imgix.net/efba6c66/uploads/origins/fc92cfad-48bd-4880-9376-20f946572ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f97908b5c60d11f44e670829b68d493 2x, https://si.imgix.net/efba6c66/uploads/origins/fc92cfad-48bd-4880-9376-20f946572ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2859b682206654867836c74c5c0c43cf 3x", "genre": "art", "nsfw": false, "body": "某シャケバイトで、かきのはさんのクーベル君がモグラシャケにvoreされてしまうイラストをお願いします！\n口の中で味わい尽くすように舐め回される描写にして頂けると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/28", "thumbnail_src": "https://si.imgix.net/8e9655aa/uploads/origins/cf7816f8-7257-448d-b02b-fc0e6dbb9f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=064d9d58b040c3aa7250258c56c9596e", "thumbnail_srcset": "https://si.imgix.net/8e9655aa/uploads/origins/cf7816f8-7257-448d-b02b-fc0e6dbb9f83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=064d9d58b040c3aa7250258c56c9596e, https://si.imgix.net/8e9655aa/uploads/origins/cf7816f8-7257-448d-b02b-fc0e6dbb9f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c845ee708d324e48022adcb039a1c98 2x, https://si.imgix.net/8e9655aa/uploads/origins/cf7816f8-7257-448d-b02b-fc0e6dbb9f83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e16bd9c752bf4d66d8a2904bd4e4f1e 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n私のうちの子であるぬいぐるみっ子のテンカくんと、かきのは様のクロッシェちゃんの絡みを見てみたいです。\n\nとても珍しい動くぬいぐるみであるテンカくんを見つけたクロッシェちゃんが、おうちに誘い込んでいろんなことをしたりクロッシェちゃんなりに「大切に」扱っているシチュエーションをお願いしたいです。\n\nテンカくんは既にぬいぐるみ化している子なので、ぬいぐるみ化する針は効かない子ですが、かきのは様のクロッシェちゃんの設定との錯誤が生じてしまっていた場合は申し訳ございません。\n\nよろしくお願いいたします。\n\n・テンカくん資料（リンク先にDriveへのURLもございます）\nhttps://twitter.com/tenka_fumizuki/status/1546427647777206275?s=20&t=8aLD_BHK8wuAEO2UXGWf0A\n・３D資料\nhttps://hub.vroid.com/characters/2668412993316130570/models/1529586775584767143", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/27", "thumbnail_src": "https://si.imgix.net/fdd6c2fa/uploads/origins/0073daef-f9a3-4c48-83a9-399a86a73ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=162a6e5e7ccf327fea7d6918dadb47e3", "thumbnail_srcset": "https://si.imgix.net/fdd6c2fa/uploads/origins/0073daef-f9a3-4c48-83a9-399a86a73ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=162a6e5e7ccf327fea7d6918dadb47e3, https://si.imgix.net/fdd6c2fa/uploads/origins/0073daef-f9a3-4c48-83a9-399a86a73ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a85e4b4dd2018cd251b04ad47b90fd9 2x, https://si.imgix.net/fdd6c2fa/uploads/origins/0073daef-f9a3-4c48-83a9-399a86a73ac2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e82a025bfc513dedf3a72592deac35e 3x", "genre": "art", "nsfw": false, "body": "かきのはさん、いつもお世話になっています。\nもしよければシャルべくんとうちの代理くんのツーショット写真風イラストをリクエストしたいと思います。\nシャルべくんは通常色、そして専用マフラー着ています。\n背景とポーズとかはかきのはさんに任せたいと思います。\n何卒よろしくお願いします！\n\nhttps://twitter.com/tanutaroraccoon/status/1497884771497951235?s=21&t=dJnSyYsexesiYs6cFPkiqg", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/26", "thumbnail_src": "https://si.imgix.net/b844e8d4/uploads/origins/b1986986-5bbc-4520-a870-e98b2bcf41c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c051e6505f1107fdfbfbd79df7bb5f", "thumbnail_srcset": "https://si.imgix.net/b844e8d4/uploads/origins/b1986986-5bbc-4520-a870-e98b2bcf41c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c051e6505f1107fdfbfbd79df7bb5f, https://si.imgix.net/b844e8d4/uploads/origins/b1986986-5bbc-4520-a870-e98b2bcf41c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e326161d0ad47ef7e4bde505c5a9f028 2x, https://si.imgix.net/b844e8d4/uploads/origins/b1986986-5bbc-4520-a870-e98b2bcf41c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6726f1524219e441dc50cc8e8db201e 3x", "genre": "art", "nsfw": false, "body": "僕（ほしかけくん）がフォリアさんにたべられちゃってるイラストを…見てみたいかもですっ……！\n（具体的なイラストの内容に関しては かきのはさんの好きなようにやっちゃってください…！）\n\nずっっと前からかきのはさんのイラストが好きで見て楽しませて頂いているので、\n感謝の気持ちをこめて skebでスパチャしに（？）きました…！今後もご活躍 応援してますっ…！\n\nhttps://twitter.com/aaaa_secret_nya/status/1568913546859401223", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/25", "thumbnail_src": "https://si.imgix.net/f8a6a50c/uploads/origins/06c2b002-83ba-4e80-9ac9-9a7453e5234d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6708f53752dfca9b2c91ae85b306de", "thumbnail_srcset": "https://si.imgix.net/f8a6a50c/uploads/origins/06c2b002-83ba-4e80-9ac9-9a7453e5234d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a6708f53752dfca9b2c91ae85b306de, https://si.imgix.net/f8a6a50c/uploads/origins/06c2b002-83ba-4e80-9ac9-9a7453e5234d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9e1bb7214570bf33aa52842f15e8f0a 2x, https://si.imgix.net/f8a6a50c/uploads/origins/06c2b002-83ba-4e80-9ac9-9a7453e5234d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b697c6a14840afc8938e6aa876b190ea 3x", "genre": "art", "nsfw": false, "body": "ヨッシーのトロピカルアイランドでツヤツヤのクッパうきわで捕らえられているヨッシーと、舌舐めずりしてるクッパをお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/24", "thumbnail_src": "https://si.imgix.net/1c911474/uploads/origins/076b3d86-573f-4cd8-a2ac-486bb007dfa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36ddeb4ac10cd10a48f8779c4c829e8b", "thumbnail_srcset": "https://si.imgix.net/1c911474/uploads/origins/076b3d86-573f-4cd8-a2ac-486bb007dfa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36ddeb4ac10cd10a48f8779c4c829e8b, https://si.imgix.net/1c911474/uploads/origins/076b3d86-573f-4cd8-a2ac-486bb007dfa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d94edfbe0e8fa653e4314a1938601df 2x, https://si.imgix.net/1c911474/uploads/origins/076b3d86-573f-4cd8-a2ac-486bb007dfa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a575da9ffedbc1049bfccb50bb42cb8d 3x", "genre": "art", "nsfw": true, "body": "カイオーガの口の中で舐め回されているマナフィをお願いします。\n可能であれば、カイオーガがマナフィをぱっくんする所も描いて頂けましたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/23", "thumbnail_src": "https://si.imgix.net/4df2ad77/uploads/origins/95824bc3-47f1-4988-927c-94e17ac96448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8debc0878d580f8922a00d4c083c7a8c", "thumbnail_srcset": "https://si.imgix.net/4df2ad77/uploads/origins/95824bc3-47f1-4988-927c-94e17ac96448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8debc0878d580f8922a00d4c083c7a8c, https://si.imgix.net/4df2ad77/uploads/origins/95824bc3-47f1-4988-927c-94e17ac96448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c4ac8f924c21069d6a6932408deb62d 2x, https://si.imgix.net/4df2ad77/uploads/origins/95824bc3-47f1-4988-927c-94e17ac96448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7383e9e5b367d80a4ca41c3584ffe7ce 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Khaki_leaf/works/22", "thumbnail_src": "https://si.imgix.net/4abc9112/uploads/origins/0d99b45f-8434-4505-82c0-1014dee23415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4435fc633191576697b210