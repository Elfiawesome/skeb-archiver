デザインだと助かります\n\n【目・表情差分】\n・ウインク、白ジト目　（ふたばはしたち：ジト2の感じ）も追加\n他いつもの感じで！\n\n【手・腕差分】\n・片腕\n　上、上前、上後、腰に手、中前、\n　手をパー、指を曲げる（がおー・恐怖）、ピース、人差し指をたてる、オッケー、グッド、下\n・両腕\n　考え事（片腕を胸の下にしつつ、もう片手をあごの方にするポーズ）\n　腕組み、お願いのポーズ、胸に手、下前\n\n【その他パーツ】\n・衣装デザインに合わせたお帽子など小物があると嬉しいです\n・のるねこと猫セット\n・冬服用マフラー及びもこもこセット", "created_at": "", "completed_at": ""}, {"path": "/@hibino_000/works/84", "thumbnail_src": "https://si.imgix.net/876bdbab/uploads/origins/fc0e1baa-e972-4d07-bfd2-7dc60325ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d8f0b91ee4ae1d16b866f0ca57ceed8", "thumbnail_srcset": "https://si.imgix.net/876bdbab/uploads/origins/fc0e1baa-e972-4d07-bfd2-7dc60325ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d8f0b91ee4ae1d16b866f0ca57ceed8, https://si.imgix.net/876bdbab/uploads/origins/fc0e1baa-e972-4d07-bfd2-7dc60325ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=240ea4dbc4a2eefee09021fc1b555dd5 2x, https://si.imgix.net/876bdbab/uploads/origins/fc0e1baa-e972-4d07-bfd2-7dc60325ff03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7ab86d6ede2fc77779290fd66b9e58a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hibino_000/works/83", "thumbnail_src": "https://si.imgix.net/c3a041eb/uploads/origins/f6ed3671-0c0f-43ce-adb7-f776e7d3d495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd0006ee0ea65a0b3eac17e32c386ea4", "thumbnail_srcset": "https://si.imgix.net/c3a041eb/uploads/origins/f6ed3671-0c0f-43ce-adb7-f776e7d3d495?bg=%23fff&auto=format%2Cco