48f18b7a88b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1da011d4f3ba2962c6a1329cea8f2c81", "thumbnail_srcset": "https://si.imgix.net/115ae947/uploads/origins/89c34d45-9088-462e-92e8-48f18b7a88b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1da011d4f3ba2962c6a1329cea8f2c81, https://si.imgix.net/115ae947/uploads/origins/89c34d45-9088-462e-92e8-48f18b7a88b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e36fda5a2e44191d68317e59ba52736 2x, https://si.imgix.net/115ae947/uploads/origins/89c34d45-9088-462e-92e8-48f18b7a88b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45a8d5bef31701c4bea333032e9207ee 3x", "genre": "art", "nsfw": false, "body": "初めまして。この度はアピールありがとうございました。\nそれでは、私のOCである「アビス」を描いて頂きたいと思っています。\n冷めた人外キャラで感情が希薄なので、クールorアンニュイな表情であると嬉しいです。\n\n以下参考URLです。\nhttps://drive.google.com/drive/folders/1i81IG_xUxIhMvunl33WDHxRt7hZLmNmL?usp=sharing\n\n服装は元のデザインからして適当なので描きやすいように描いて下さい。\nワンピースっぽい服装ですがパンツとかでも構いません。\n但し服装イメージとしてはシンプルorクールなものが良いです（可愛らしいものはNG）\n出来れば色味はダーク系が好ましいです。が、必ずしも黒に拘らなくても良いです。\n（例えばワンポイントでビビッドな差し色を入れてみる等）\n特に思い付かないとかであれば、参考URLにあるような黒のオフショルダー系ワンピースの服みたいなので良いですし…それに関してもご自由にアレンジして下さって結構です。\n\n髪型は紫がかったロングヘアですが、ショート以外であればアップにしたり結ったり等髪型をアレンジして頂いても構いません。面倒なら勿論ロングヘアのままでも大丈夫です。\n\n瞳に関しては、基本金目ですが人間らしい黒い丸瞳孔ver.と\n人外らしく赤い縦瞳孔になってるver.の２通りありますが仕上げるイラストの雰囲気でご自由にお決め下さって結構です。\n\nご検討の程、宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ef_avianoid/works/3", "thumbnail_src": "https://si.imgix.net/ce145fd7/uploads/origins/3b663290-d0da-4823-af62-53729da3d3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5724fc248d47e4eb6c30a398e4790ed", "thumbnail_srcset": "https://si.imgix.net/ce145fd7/uploads/origins/3b663290-d0da-4823-af62-53729da3d3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5724fc248d47e4eb6c30a398e4790ed, https://si.imgix.net/ce145fd7/uploads/origins/3b663290-d0da-4823-af62-53729da3d3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd46593670f06a34c4db35a78a83a533 2x, https://si.imgix.net/ce145fd7/uploads/origins/3b663290-d0da-4823-af62-53729da3d3ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c026429cbd4cfb73c2bebfdbd641205 3x", "genre": "art", "nsfw": false, "body": "初めまして。アピールありがとうございます！\n私のアバターを褒めていただき光栄です。\n\nお言葉に甘えて私のアバターのイラストを希望します。\n鳥擬さんの得意なクールな雰囲気で描いていただけると嬉しいです。\nイラストの構図やキャラの表情、ポーズなどはお任せとさせていただきます。\nまた、資料の中に私のアバターの様々な衣装のパターンを揃えているので、お好きな衣装で描いていただいて大丈夫です。\n\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/file/d/1YO7JZTWgSWFhSdA-4EMNyX4qxJ2HjPkg", "created_at": "", "completed_at": ""}, {"path": "/@ef_avianoid/works/2", "thumbnail_src": "https://si.imgix.net/4a872ba3/uploads/origins/ee1fdbff-ebee-43a5-b07c-e1cf72507263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3142588eb68218476df6d5a62fe826c4", "thumbnail_srcset": "https://si.imgix.net/4a872ba3/uploads/origins/ee1fdbff-ebee-43a5-b07c-e1cf72507263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3142588eb68218476df6d5a62fe826c4, https://si.imgix.net/4a872ba3/uploads/origins/ee1fdbff-ebee-43a5-b07c-e1cf72507263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e16b28127c0d553866a5a5895b05b224 2x, https://si.imgix.net/4a872ba3/uploads/origins/ee1fdbff-ebee-43a5-b07c-e1cf72507263?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48a7460c3d72bc9816307aeb1b76cac5 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます\n頂きましたケイの方をお願いしたいと思います\nダボっとした服装から伸びる手足が細めでクールな感じで描いていただけたらと思います\nよろしくお願いします\n\nhttps://www.pixiv.net/artworks/98434628", "created_at": "", "completed_at": ""}, {"path": "/@ef_avianoid/works/1", "thumbnail_src": "https://si.imgix.net/e34888f9/uploads/origins/52a24510-e284-4860-be24-4bdb1b103ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=285e2512c5f4020ee3953a39cb41