ac-45e1-bd0d-718ccae5ef15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d54dc33521e609a3ff00826fb0d4e21e, https://si.imgix.net/ba25f076/uploads/origins/dea2ffe5-d8ac-45e1-bd0d-718ccae5ef15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b38957e67378f77433a6e6a6485625db 2x, https://si.imgix.net/ba25f076/uploads/origins/dea2ffe5-d8ac-45e1-bd0d-718ccae5ef15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22ca055c3fd223b0500d25d871a71d16 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nTwitter / Xを見ていて、あなたの絵を見つけました。\nVRChatのキャラクターに今のビキニを着せてみたいです。\n可能であれば、ジャケットを着たバージョンと着ていないバージョン。\nできればgoogleドライブにあるポーズもお願いします。\n表情は丁寧な笑顔でお願いします。両目を開けてください。\nまた、自由に自分のアイデアやひねりを加えてください！\n\nもしタトゥーが気になるようであれば、タトゥーがなくてもかまいません。\n\nありがとうございました！<3\n\nhttps://drive.google.com/drive/folders/13Jgw86wafkRuOA-PgSQT31DaKiNIumTB?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kyaz_4328/works/28", "thumbnail_src": "https://si.imgix.net/4b4c9f52/uploads/origins/27c9576e-60d5-4329-8cdb-6366c2ea8b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f19bb8ee86e27f09659209712bc90d9", "thumbnail_srcset": "https://si.imgix.net/4b4c9f52/uploads/origins/27c9576e-60d5-4329-8cdb-6366c2ea8b53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f19bb8ee86e27f09659209712bc90d9, https://si.imgix.net/4b4c9f52/uploads/origins/27c9576e-60d5-4329-8cdb-6366c2ea8b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da9f75a3a627a499e346baf02a3763ca 2x, https://si.imgix.net/4b4c9f52/uploads/origins/27c9576e-60d5-4329-8cdb-6366c2ea8b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=576e5f63285725f72cb604444e260362 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n私のキャラクター、フロストのデッサンをお願いします。\n\nコンセプトについては、クリエイティブな自由を与えたいと思います。彼女のポジティブで好奇心旺盛な性格が反映されていれば、ゴシックで不気味な美学に関連することなら何でも自由に探求してください。\n\nフロストの趣味は\n\nメタルとオーケストラ音楽\n\n超自然的でオカルト的なテーマ\n\nホラー映画\n\n紅茶を飲む\n\n不思議なことを研究する\n\n彼女はダークで不気味なものを好むタイプのゴスだが、エッジーになったり怒ったりするのではなく、冷静で思慮深い雰囲気を保っている。\n\nあなたがどんなシーンやアイデアを思いつくか楽しみだわ！  :)\n\nhttps://drive.google.com/drive/folders/16h5Jwqy6x-PxXJf5FfXCghSE9JWqUnSG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@kyaz_4328/works/27", "thumbnail_src": "https://si.imgix.net/6d5e40f8/uploads/origins/368003d3-7a4d-4429-8a08-c7ad64991d12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af7606db9c36abedbc37e1774c0db9a1", "thumbnail_srcset": "https://si.imgix.net/6d5e40f8/uploads/origins/368003d3-7a4d-4429-8a08-c7ad64991d12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af7606db9c36abedbc37e1774c0db9a1, https://si.imgix.net/6d5e40f8/uploads/origins/368003d3-7a4d-4429-8a08-c7ad64991d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2871c50484f671c1eb01a9337db2743 2x, https://si.imgix.net/6d5e40f8/uploads/origins/368003d3-7a4d-4429-8a08-c7ad64991d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=124ff32b02a61d39420f02673d6f8930 3x", "genre": "art", "nsfw": false, "body": "キャラクター\n- ジャンヌ・オルタ（FGO）\n\n衣装\n- https://static.wikia.nocookie.net/fategrandorder/images/0/0b/S106_Sheet_Stage2_SchoolUniform1.webp/revision/latest?cb=20240326140914\n\nポーズと表情：\n- 怒っているが微笑んでいる。\n- 片方の目がもう片方より開いているのは、彼女が少し動揺していることを示すため。\n- 攻撃的な姿勢\n\n彼女にとても大きな胸を与えてください。\n\n彼女の頭には、このような黒い平たい帽子をかぶせてください。https://americanhatmakers.com/cdn/shop/products/Bookie-Black-Leather-Cap-AmericanHatMakers-Ladies-STUD_2__eb.jpg\n\n帽子のてっぺんには、彼女のアホ毛を貼り付けてください。\n\nYouTubeのサムネイルに使いたいので、背景なしでも構いません。透過PNGか、PSDファイルへのアクセスがベストです！動画で使用する際は、あなたのソーシャルメディアにリンクします。", "created_at": "", "completed_at": ""}, {"path": "/@kyaz_4328/works/26", "thumbnail_src": "https://si.imgix.net/16b21efd/uploads/origins/c6e868ff-69f8-406a-b7d6-5ca9dd3eea83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad430a97d0608cb1f9e6cef7cba437c4", "thumbnail_srcset": "https://si.imgix.net/16b21efd/uploads/origins/c6e868ff-69f8-406a-b7d6-5ca9dd3eea83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad430a97d0608cb1f9e6cef7cba437c4, https://si.imgix.net/16b21efd/uploads/origins/c6e868ff-69f8-406a-b7d6-5ca9dd3eea83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6ad7e07386b1ff08bee6d300c727889 2x, https://si.imgix.net/16b21efd/uploads/origins/c6e868ff-69f8-406a-b7d6-5ca9dd3eea83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5b9569c781da503774b9b43d1a6397a 3x", "genre": "art", "nsfw": false, "body": "非常に長いお久しぶりです\nうちのOC、ジェニをありがとうございます\n今回もジェニをよろしくお願いします\n\n【シチュ】\nカズヲク様のOCである傭兵ちゃんの企業に政府系研究機関であるジェニが装備試験の依頼をするところです\nジェニが貸与する装備について傭兵ちゃんと意見交換している様は「うおでっか……」なところかと思われます。その空間を描いていただきとうございます。\n\n参考として、ジェニの身長は183センチお胸は三桁ｷﾞﾘｷﾞﾘ到達です\n\nhttps://x.com/monat253/status/1918185494112027114", "created_at": "", "completed_at": ""}, {"path": "/@kyaz_4328/works/25", "thumbnail_src": "https://si.imgix.net/da6993a7/uploads/origins/6d33632d-057e-416b-b9d1-1e9de58710b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aadfccd6c786726cca58f2560ff7ed3", "thumbnail_srcset": "https://si.imgix.net/da6993a7/uploads/origins/6d33632d-057e-416b-b9d1-1e9de58710b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aadfccd6c786726cca58f2560ff7ed3, https://si.imgix.net/da6993a7/uploads/origins/6d33632d-057e-416b-b9d1-1e9de58710b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70be624faae8aa6cfaa57fef545ae375 2x, https://si.imgix.net/da6993a7/uploads/origins/6d33632d-057e-416b-b9d1-1e9de58710b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f94558645fe9c31ec3e8dba68773ca3 3x", "genre": "art", "nsfw": false, "body": "こんばんは カズヲクタンさん，初依頼失礼します。\n\nゼロチームのスピンをお願いします。\nhttps://youtu.be/nKrXBZ6RHRs?si=08rgztG6qRyuzOGi\n\nスピンのイラストを探しました、しかし残念ながら見つかりません\n\n構図、衣