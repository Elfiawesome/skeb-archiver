=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8fe18f0f931bfaf58647f6a5d697321 2x, https://si.imgix.net/d2feb9d9/uploads/origins/07fce9dc-a2bb-4973-a848-e3eec97e1ad9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55a4477c820908ea0ad938858907b37d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@no53291827/works/17", "thumbnail_src": "https://si.imgix.net/a37babf3/uploads/origins/a093ac99-afbb-4fba-83c7-e4d23fb97e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dc87b456901c3d12c7d94fac18d678a", "thumbnail_srcset": "https://si.imgix.net/a37babf3/uploads/origins/a093ac99-afbb-4fba-83c7-e4d23fb97e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dc87b456901c3d12c7d94fac18d678a, https://si.imgix.net/a37babf3/uploads/origins/a093ac99-afbb-4fba-83c7-e4d23fb97e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=394fc2def0a01a4367c232082b806e6f 2x, https://si.imgix.net/a37babf3/uploads/origins/a093ac99-afbb-4fba-83c7-e4d23fb97e5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91f306f11862886488da1fa0732bdb7e 3x", "genre": "art", "nsfw": false, "body": "またまたno53さん、こんにちは！私のOCの全身イラストをお願いできますか？彼女は軍人の家系に生まれたヴァンパイアです。普段はおっとりしているが、内心はサディストで、人を批判するときは口が悪く、親に甘やかされている。ここで紹介した資料（https://skeb.jp/@karan_koron100/works/73）を参考に、イヤーマフや装飾品、白いブーツやストッキングはそのままに、天の31A分隊の制服を着て赤く燃えて戦ってもらいたい。電気を操るスピードと武術を武器に戦うので、それを生かしたアグレッシブな構えをしてほしい。また、ブーツを履かず、ストッキングを履いただけのバリエーションも入れていただけるとありがたいです。ただ、ストッキングはあぶみとつま先が開いているデザインであることに注意してください。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/19noy-tIO8TNGJLMy-LfXjvVBq7mu-tZ3?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@no53291827/works/16", "thumbnail_src": "https://si.imgix.net/6aee8686/uploads