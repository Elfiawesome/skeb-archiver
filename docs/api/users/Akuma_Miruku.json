5f801da0abc86b1a94d3543bfb7 2x, https://si.imgix.net/96082fa5/uploads/outputs/1920bea0-819c-4c5d-8756-fcf30b30b1c0?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da1abaa2b32bfc3ac48c98198d8d5d6d 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Akuma_Miruku/works/7", "thumbnail_src": "https://si.imgix.net/5d3c7a19/uploads/outputs/336bba42-aab0-4e82-a5c3-0b4d01598548?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=718012c63deda0394e650eb31b050fb5", "thumbnail_srcset": "https://si.imgix.net/5d3c7a19/uploads/outputs/336bba42-aab0-4e82-a5c3-0b4d01598548?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=718012c63deda0394e650eb31b050fb5, https://si.imgix.net/5d3c7a19/uploads/outputs/336bba42-aab0-4e82-a5c3-0b4d01598548?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=af8a9871343b8319f2c8f556f8e1d1d2 2x, https://si.imgix.net/5d3c7a19/uploads/outputs/336bba42-aab0-4e82-a5c3-0b4d01598548?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d7c182d8f904983086fea3887d26fc8 3x", "genre": "video", "nsfw": true, "body": "みるく先生、はじめまして。以前から先生の作品のファンで、娘のクロエ・クレメンツを主人公にした動くイラストをお願いしたいです。足が麻痺しているので、車椅子に乗っているか、下半身が出ていれば座っている姿を描いてください。\n\nクロエは目隠しをして、男友達と当てっこゲームをしています。彼は衝動を抑えきれず、彼女の目の前でペニスを取り出す。クロエはそれが何なのか戸惑いながら、男友達のペニスを触ったり撫でたりする。男友達はクロエの顔中に射精し、クロエはさらに困惑する。不思議な液体の出所を突き止めようと決意した彼女は、彼のペニスを舐めたり吸ったりする。男友達はクロエの口の中に射精し、クロエはそれを飲み干す。彼女は味は気にしないが、最終的には困ってしまう。彼女は目隠しをはずし、先から精液を垂らしている友人のペニスのどろどろした姿を見て顔を赤らめる。\n\nこれが基本的なアイデアですが、創作は自由です。\n\nSNSに投稿するかもしれないので、納品はmp4形式で送っていただけるとありがたいです。🙏\n\nご検討よろしくお願いします。🙇‍♂️\n\nhttps://x.com/hanashiroharu/status/1829855730016666050?s=61&t=S9IYXsXmP9ZNg9qSCxkldw", "created_at": "", "completed_at": ""}, {"path": "/@Akuma_Miruku/works/6", "thumbnail_src": "https://si.imgix.net/4e017143/uploads/outputs/853788e4-902f-4426-9f9b-7f7c7cf2c4d7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7e0010efc571143f8296216d0c2ebb28", "thumbnail_srcset": "https://si.imgix.net/4e017143/uploads/outputs/853788e4-902f-4426-9f9b-7f7c7cf2c4d7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7e0010efc571143f8296216d0c2ebb28, https://si.imgix.net/4e017143/uploads/outputs/853788e4-902f-4426-9f9b-7f7c7cf2c4d7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7f39d9df7fbeaa1850c4c60f97e5c3e 2x, https://si.imgix.net/4e017143/uploads/outputs/853788e4-902f-4426-9f9b-7f7c7cf2c4d7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=24e3e3408949422cde82d5c8f3ada425 3x", "genre": "video", "nsfw": true, "body": "はじめまして。娘のあいすちゃんのオナニーを描いたアニメをお願いしたいです。あいすちゃんはフェネックギツネなので耳がとても大きいです。本物のキツネのように鋭い歯を持っています。細かいところはお任せしますが、あいすちゃんは見た目以上にフェネックギツネなので、動物的な欲望が感じられるアニメーションだと嬉しいです。愛須ちゃんが \"ドギースタイル \"になっているポーズとか、男性の服の匂いを嗅いでいるポーズとか。\n\nあいすちゃんはロリ系なので、小柄でかわいく描いてほしいです。耳としっぽの表現に気をつけていただけるとありがたいです。もし可能であれば、絶頂に近づくにつれて、大人しい女の子から徐々に淫らな女の子になっていってほしいです。あいすちゃんの服装は自由ですが、全裸はNGです。あいすちゃんの指やアソコが見えなくても大丈夫です。あいすちゃんがイクときは、体が震えるような体験をしてほしいです。\n\n読んでくださってありがとうございました。\n\nhttps://drive.google.com/drive/folders/1H77L-GE-3dH82YDIHbg6RI_uBbUzqUtu?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Akuma_Miruku/works/5", "thumbnail_src": "https://si.imgix.net/e3b6e792/uploads/outputs/a6b963ab-5b0d-499a-aae8-a1071720721e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=eb1a7bbde1df6565465c304e762ac0d9", "thumbnail_srcset": "https://si.imgix.net/e3b6e792/uploads/outputs/a6b963ab-5b0d-499a-aae8-a1071720721e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=eb1a7bbde1df6565465c304e762ac0d9, https://si.imgix.net/e3b6e792/uploads/outputs/a6b963ab-5b0d-499a-aae8-a1071720721e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=32a79c2923dd16e84f1e58aafbbdec56 2x, https://si.imgix.net/e3b6e792/uploads/outputs/a6b963ab-5b0d-499a-aae8-a1071720721e?bg=%23fff&fm=webp