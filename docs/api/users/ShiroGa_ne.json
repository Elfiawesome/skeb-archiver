com/amagami_koko/status/1765906917359329524\n\n参考URL2～3:幸紫雷怨(2:服装、3:身体の設定)\nhttps://x.com/Yukimura_Lion/status/1768728832079769924\nhttps://x.com/Yukimura_Lion/status/1368296255676366852\n\nそれでは、よろしければよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ShiroGa_ne/works/125", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/13d08569/uploads/origins/11996019-2b1a-4f1f-af39-2ca78b5cae67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=922017c5d593b8bb01a355ed902af753", "thumbnail_srcset": "https://si.imgix.net/13d08569/uploads/origins/11996019-2b1a-4f1f-af39-2ca78b5cae67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=922017c5d593b8bb01a355ed902af753, https://si.imgix.net/13d08569/uploads/origins/11996019-2b1a-4f1f-af39-2ca78b5cae67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24393d899d5e29e686453ce318815962 2x, https://si.imgix.net/13d08569/uploads/origins/11996019-2b1a-4f1f-af39-2ca78b5cae67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d6252f20f97cb2726a458b407d9b58e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ShiroGa_ne/works/124", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/441b2075/uploads/origins/e96e85fd-415e-4383-b9e8-f5cefcaf08fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9dde16b9603f7480869e1d318f8bfce", "thumbnail_srcset": "https://si.imgix.net/441b2075/uploads/origins/e96e85fd-415e-4383-b9e8-f