、ご依頼失礼します\n\n過去リクエストのよその娘イラストのピチインナーに惹かれまして、スマホゲームアズールレーンに登場する、霞改のR18イラストをお願いしたく\n\nシチュエーションとしては淫紋、もしくは媚薬等で感度を上げられた霞ちゃんが、上手に縛り上げられ拘束された状態で乳首を刺激され秘部に挿入され…感度を上げられた状態で性感帯をひたすらに刺激され感じまくりながら犯されて…なイメージのものをお願いしたく\nこの際、表情は舌出し、感じ過ぎて目線が見えない状態にして頂きたく\n\n服装はインナー部は残して頂きたく秘部の部分のみ開けてある状態で、トップス、スカートの有無に関してははどちらでも構いません\n\n以上です、可能な範囲で構いませんので宜しくお願い致します\n\nhttps://twitter.com/azurlane_staff/status/1405842032489242625", "created_at": "", "completed_at": ""}, {"path": "/@ShiroGa_ne/works/147", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/efc8afeb/uploads/origins/62428862-0150-4041-84d2-132405c7bb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1011c8ed16a5b1f2e189e02fc1f2a4f7", "thumbnail_srcset": "https://si.imgix.net/efc8afeb/uploads/origins/62428862-0150-4041-84d2-132405c7bb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1011c8ed16a5b1f2e189e02fc1f2a4f7, https://si.imgix.net/efc8afeb/uploads/origins/62428862-0150-4041-84d2-132405c7bb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54809fabb5da0ab3c7a04cd1437cfd4d 2x, https://si.imgix.net/efc8afeb/uploads/origins/62428862-0150-4041-84d2-132405c7bb3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dfe1721adf65a87e8b5ccb72c8924cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ShiroGa_ne/works/146", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/8bf27664/uploads/origins/bd6ef60e-0eba-4087-99e9-f644414348fa?bg=%23fff&auto