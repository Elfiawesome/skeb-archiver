e48-a1932bfb7223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b22287c01db3e5346637a4d1eb270548 2x, https://si.imgix.net/06ebcfc6/uploads/origins/a7c2350f-0d78-4da0-be48-a1932bfb7223?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1b84f46743761b5c6f2a500b1ebf389 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/22", "thumbnail_src": "https://si.imgix.net/7d6bba08/uploads/origins/9fbcb683-f591-4f7f-82d2-c7ee25ed7066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43289dbe35cbdb0086d61c37703fe5ab", "thumbnail_srcset": "https://si.imgix.net/7d6bba08/uploads/origins/9fbcb683-f591-4f7f-82d2-c7ee25ed7066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43289dbe35cbdb0086d61c37703fe5ab, https://si.imgix.net/7d6bba08/uploads/origins/9fbcb683-f591-4f7f-82d2-c7ee25ed7066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac0889d6ada07d380439187bbd299a6c 2x, https://si.imgix.net/7d6bba08/uploads/origins/9fbcb683-f591-4f7f-82d2-c7ee25ed7066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38dcc91ae42693c725da7cc49838d402 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアピールに感謝します。あなたの画風は本当にかわいいので、私のキャラクターを描いていただけたら嬉しいです。好きなように描いてください。よろしくお願いします！\n\n参考リンク：https://drive.google.com/file/d/1-xfT0sA3MaZhskcxE65S2PWdXkPdeXUk/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/21", "thumbnail_src": "https://si.imgix.net/734e472c/uploads/origins/da8aaee5-9248-412c-b5f8-e16ee3ab8f23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a63b46758447fe0b84c3d9aa6d43fbfd", "thumbnail_srcset": "https://si.imgix.net/734e472c/uploads/origins/da8aaee5-9248-412c-b5f8-e16ee3ab8f23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a63b46758447fe0b84c3d9aa6d43fbfd, https://si.imgix.net/734e472c/uploads/origins/da8aaee5-9248-412c-b5f8-e16ee3ab8f23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dda00801d6b5e380b1ebdde2263592bc 2x, https://si.imgix.net/734e472c/uploads/origins/da8aaee5-9248-412c-b5f8-e16ee3ab8f23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64a748cc44026e2c2c1814522c6f861f 3x", "genre": "art", "nsfw": false, "body": "明也さん、はじめまして！アピールありがとうございます。\n\nあなたの画風は超クールだと思うので、ぜひ私のVtuberアバターをあなたの画風で描いてほしいです。どんな風に描いても構いません。楽しみにしています！\n\nありがとうございました！\n\nキャラクター\nhttps://drive.google.com/file/d/1orl7j28mIe_fFSktf3z_81d1krzMjcaW/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/20", "thumbnail_src": "https://si.imgix.net/6c36d10b/uploads/origins/71a70dad-541a-479c-b117-0a1172586d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5408efe233c96d13c35b055c40fc562b", "thumbnail_srcset": "https://si.imgix.net/6c36d10b/uploads/origins/71a70dad-541a-479c-b117-0a1172586d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5408efe233c96d13c35b055c40fc562b, https://si.imgix.net/6c36d10b/uploads/origins/71a70dad-541a-479c-b117-0a1172586d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbf1017ec5f126d985d3afd50e05e72d 2x, https://si.imgix.net/6c36d10b/uploads/origins/71a70dad-541a-479c-b117-0a1172586d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8481794aa45b98aefdd518944524f217 3x", "genre": "art", "nsfw": false, "body": "お世話になります。アピールありがとうございます。受諾頂ければ幸いです。\n\n私の好きな「世界の終わりに柴犬と」の一場面をアニメ風に書いていただきます。\nhttps://www.youtube.com/watch?v=p1V5YwXjMHM\n（音量注意。開始5秒くらいでたぬきに顔を引っ張られる柴犬と\n爆走するJK。JKのデザインは以下の通りです。\n\n女の子のキャラ設定は\n…都内某有名女子高に通学（理系）\n・制服はミッション系のどでかい蝶々リボン（淡い水色で縛り方はかなりゆるい）先生の独創的な制服を期待します。\n・髪型はツインテール＋りぼん（金髪）\n・丸めがね必須（強調して）\n・実験白衣を着ている(前は全開)小物もあれば嬉しいです。(胸にボールペンなど)\n…ネームブレート着用（学生証・写真付き）\n・手首にはシュシュ、腰にはカーディガンが結んである。\n・スカートもビンクのチェックの入った柄。かわいいスカート希望。長さは短め\nニーハイ＋ガーターベルト(かわいいとセクシーさを両立)目立つように。太ももの所に細かい装飾。\n…あとは先生にお任せします。\n・横3840☓縦2160ピクセル並\n画面比率は4K並み\n・保存形式はpsd（レイヤー未結合）、jpgでお願いします。\n最後までお読み頂きまして、貴重な時間を頂戴しました。感謝です。ご検討を宜しくお願いします。失礼します。", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/19", "thumbnail_src": "https://si.imgix.net/fa8a5564/uploads/origins/cf45017d-3136-4bf9-b025-b2f0189df169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c4317c349e7c25183d1265e32bbccf5", "thumbnail_srcset": "https://si.imgix.net/fa8a5564/uploads/origins/cf45017d-3136-4bf9-b025-b2f0189df169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c4317c349e7c25183d1265e32bbccf5, https://si.imgix.net/fa8a5564/uploads/origins/cf45017d-3136-4bf9-b025-b2f0189df169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3655dbea39f3f1e526d65b6bcbc9e3d 2x, https://si.imgix.net/fa8a5564/uploads/origins/cf45017d-3136-4bf9-b025-b2f0189df169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98fb52f1718380b2625ed1febacf8c9f 3x", "genre": "art", "nsfw": false, "body": "アピールをありがとうございます！\n猫の絵のふわっとした毛の質感が素敵でした。\n直近のリクエストとは別の子なのですが、うちの猫をお願いできますか？\n内容等ご自由にしていただけたらと思っています。\n\n下記に色々書き連ねますが、何かしらがアイデアのヒントになりましたら幸いです。\n(全部を拾っていただく必要はありません)\n\n★三毛猫：https://livedoor.blogimg.jp/mochimako/imgs/7/a/7a20d2a9.jpg\n5kgの♀で、しっぽはまっすぐで長め。お転婆でいたずら好き。コアラの鼻みたいな顔の模様がチャームポイント。\nうちの猫の中で一番若く、未だに子猫のテンションが残っています。\n何にでもじゃれ、元気よく飛び回り、よくやんのかステップもします。喜怒哀楽の振れ幅が大きめ。\n悪いことは大体こいつのせい。特にいけない場所での爪とぎ・噛みつき、盗み食いはほぼ確定で犯人。\n最近は柱で爪とぎをしたり、シリコン・ゴム製品(輪ゴムや哺乳瓶の先端など……)を噛み千切ったり、かぼちゃを盗み食いしたりしました。食べ物は肉や魚より、意外と野菜・米や芋などの炭水化物系を盗んでいます。\n子供と新入りの雄猫が嫌い。来客があると一応隠れるものの割とすぐに出てくる。恐怖より好奇心が勝りがちな感じです。\n\nご検討いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/18", "thumbnail_src": "https://si.imgix.net/bf56fb5e/uploads/origins/a99c2807-6b12-4558-9919-51e76129d5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2394516ce60afa7ec2567c5c3f93d90f", "thumbnail_srcset": "https://si.imgix.net/bf56fb5e/uploads/origins/a99c2807-6b12-4558-9919-51e76129d5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2394516ce60afa7ec2567c5c3f93d90f, https://si.imgix.net/bf56fb5e/uploads/origins/a99c2807-6b12-4558-9919-51e76129d5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fafdee395becb718c0033c92566ae0e 2x, https://si.imgix.net/bf56fb5e/uploads/origins/a99c2807-6b12-4558-9919-51e76129d5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc06f57f9bfddc5c2696c780455329f4 3x", "genre": "art", "nsfw": false, "body": "MEIYAさん、はじめまして！\n\n昨年、あなたのアピールを見つけたばかりなのに、すぐに返信できなくてごめんなさい...。\n\nとにかく、あなたの最高のイマジネーションでアンスロンのクールなアートをお願いします：\nhttps://x.com/AnsronL/status/1882279718319440248\n(またはプロフィールの他のアートワーク）\n\nアンスロンの魅力を引き出すポーズはお任せします。\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/17", "thumbnail_src": "https://si.imgix.net/0994134d/uploads/origins/25c497e1-afae-411f-8bf0-5e5fc8ec530b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f4997c4792f151736454714ff83dd54", "thumbnail_srcset": "https://si.imgix.net/0994134d/uploads/origins/25c497e1-afae-411f-8bf0-5e5fc8ec530b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f4997c4792f151736454714ff83dd54, https://si.imgix.net/0994134d/uploads/origins/25c497e1-afae-411f-8bf0-5e5fc8ec530b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00c67a13c6e7d17be249c5f1f33345a0 2x, https://si.imgix.net/0994134d/uploads/origins/25c497e1-afae-411f-8bf0-5e5fc8ec530b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52f6b34698befe46f9ed2b94ca06ff0d 3x", "genre": "art", "nsfw": false, "body": "心のこもった言葉をありがとう！ぜひうちの猫も描いてほしいな。以下、情報です。\n\n私の大切な2匹の猫、ナラとルディです。ナラは茶色のタビーで、激しい性格をしています。彼女は私の遊び好きな赤ちゃんで、羽のおもちゃで遊ぶのが大好きです。ルディはグレーの猫。とても冷静で、怠け者で、食べることが大好きです。この猫たちの携帯電話の背景や壁紙を作っていただけませんか？\n\nお好きなようにしてください！\n\nhttps://imgur.com/a/sHmpwew\n\nhttps://imgur.com/a/PVDoXbR", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/16", "thumbnail_src": "https://si.imgix.net/592bf055/uploads/origins/97b496e8-3d46-4caf-8808-216bac64d507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f245d40f17b68acb129f4126be11f5", "thumbnail_srcset": "https://si.imgix.net/592bf055/uploads/origins/97b496e8-3d46-4caf-8808-216bac64d507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8f245d40f17b68acb129f4126be11f5, https://si.imgix.net/592bf055/uploads/origins/97b496e8-3d46-4caf-8808-216bac64d507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2740c8fd08f27d4a03e384c7331d7fbd 2x, https://si.imgix.net/592bf055/uploads/origins/97b496e8-3d46-4caf-8808-216bac64d507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=603413562a450fa0e10f70a990c4588d 3x", "genre": "art", "nsfw": false, "body": "MEIYA様、こんにちは。先日はアピールをお送りいただきまして、ありがとうございました。\n当方のキャラクターに興味を持っていただいたことにお応えして、リクエストをお送りします。\n\nアピールではドラゴンライダーの「レト」にご関心をお寄せいただいたようでしたから、そのまま「何かしらドラゴンライダー要素を帯びたレト」というお題でお願いしたく思います。装束やシチュエーションなどについてはお好みのままにお願い致します。既存の応用でも、全く新しい創案でも歓迎です。\n外見の基本スペックと、これまで皆さんにどのようにイメージしていただいたかを資料URLにまとめてありますので、参考になさってください。\n\nイラストの用途は\n・SNSやBlogでの紹介\n・オリジナルキャラクターを持ち込めるタイプのゲームでのキャラ絵\n・他イラストレーターへの同キャラクターのイラスト等依頼の際の参照画像\nなどになります。\nまた、イラストからインスピレーションを得た場合はイラストのシチュエーションを絡めた掌編を書いて公開する場合があります。\n\nご検討宜しくお願い致します。\n\nhttps://auc-lvx.blog.ss-blog.jp/2011-11-15", "created_at": "", "completed_at": ""}, {"path": "/@naito_mm3/works/15", "thumbnail_src": "https://si.imgix.net/56ea69b1/uploads/origins/3aca41f7-6d51-4528-a221-8c55e79e0d59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d24d271c1760c4b46d64b227dd3d550f", "thumbnail_src