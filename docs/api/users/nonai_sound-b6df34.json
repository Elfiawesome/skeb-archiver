=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2e1c19fe994921d9cdcbf889ed4d7c7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ecaa67da51b62227cc2bb19a493ea92 3x", "genre": "music", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nonai_sound/works/24", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5abe935f15226452d76a9d0014a467", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5abe935f15226452d76a9d0014a467, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64bc6734797a4bf7230cf36e4394047a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44b8b2bebc61c5daef451594903199ab 3x", "genre": "music", "nsfw": false, "body": "初めまして。紫眞桜と申します。\n\nこの度はクトゥルフのうちよそBGMが欲しくてリクエストを送らせていただきました。\n\n・作ってほしい曲のイメージ \n→和風の戦闘シナリオ出身なので、和風曲がいいです。\nTRPGのOP画面に使えそうな曲が嬉しいです。\n（和/ピアノの要素が欲しいです）\n\n・曲の使い方（ループにするかどうか決める） \n→TRPGの卓内使用。うちよそイメージソング。\n\n・シナリオや画像などの参考URL \n『探索者画像』\nhttps://drive.google.com/drive/folders/1I-u8BBvSiKpwijrBnD7IIFYXYDG6vohU?usp=sharing\n\n『簡易探索者プロフィール』\n・紫髪の男の子\n→天真爛漫で正義感に溢れている。人懐っこく誰にでも優しい。\n「君大丈夫？俺でよければ力になるよ！」\n\n・黄色髪の男の子\n→誰にでも気さくで、真面目。ボケに毎回突っ込んでくれる。怪異を前にすると殺意マシマシになる。\n「ふう、一件落着かな。お兄さん大丈夫？」\n\n『関係性』\n背中を預ける相棒の関係。お互い未成年。\n\n・参考楽曲（というより好みの曲ですすみません……！）\n→『和と集落』https://m.youtube.com/watch?v=ETw91PwL7UQ#bottom-sheet\n（別作品で言えば『https://bgmer.net/music/229』『https://www.nicovideo.jp/watch/sm33666927』のような雰囲気の曲が好きです……！）", "created_at": "", "completed_at": ""}, {"path": "/@nonai_sound/works/23", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5abe935f15226452d76a9d0014a467", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5abe935f15226452d76a9d0014a467, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64bc6734797a4bf7230cf36e4394047a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44b8b2bebc61c5daef451594903199ab 3x", "genre": "music", "nsfw": false, "body": "◆曲のイメージ\n前半はほの暗く、穏やかな雰囲気。（灰の楽園がイメージと近いです。）\n後半になるにつれて徐々に緊張感のある退廃的な雰囲気。(seeker in the dark【android × dystopia】)\n◆曲の使い方\nTRPGのキャラクターのイメージソングとして個人的鑑賞用に楽しみたいです。\n◆シナリオや画像などの参考URL\nこちらの男女2名がイメージキャラクターです。\n女性が少し陰鬱な教祖、男性は教祖を慕っている明るい性格の信者です。\nhttps://twitter.com/2nske_poke/status/1558419333415862274\n◆参考楽曲\n前半パートイメージ\n・灰の楽園\nhttps://www.youtube.com/watch?v=gUXVTTKNKmw\n後半パートイメージ\n・seeker in the dark【android × dystopia】\nhttps://www.youtube.com/watch?v=_d0YJaBErMQ\n\nhttps://twitter.com/2nske_poke/status/1558419333415862274", "created_at": "", "completed_at": ""}, {"path": "/@nonai_sound/works/22", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=210997c0a8523ad9e1ce65192a063493", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=210997c0a8523ad9e1ce65192a063493, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2e1c19fe994921d9cdcbf889ed4d7c7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ecaa67da51b62227cc2bb19a493ea92 3x", "genre": "music", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nonai_sound/works/21", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5abe935f15226452d76a9d0014a467", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5abe935f15226452d76a9d0014a467, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64bc6734797a4bf7230cf36e4394047a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44b8b2bebc61c5daef451594903199ab 3x", "genre": "music", "nsfw": false, "body": "・作ってほしい曲のイメージ \n→自創作の作品テーマ曲（キーワード：退廃的、魔法があるファンタジー、綺麗）\n\n・曲の使い方\n→当方のHPに楽曲掲載・個人利用（自主制作GIFアニメーションのBGM使用）\n※クレジット記載致します\n\n・シナリオや画像などの参考URL \n作品キービジュアル：　https://twitter.com/ariga_000/status/1500806634255257600\n→こちらの連ツイに絵に関する小説が連ツイ、キービジュアル内キャラクターのキャラ設定があります\n作品あらすじ：　https://arigamitugetu.wixsite.com/ariga-creation\n→自創作HPのhome下に「箱庭の命たち/人獣ラメント」のあらすじがあります\n※現在サイト工事中によりキャラ設定はキービジュアルに連ツイされているキャラ設定をご参照ください\n\n・参考楽曲\nhttps://www.youtube.com/watch?v=6V6-IVEMXH4\n「dampness」のような落ち着いた雰囲気＋綺麗な＋退廃的なイメージです\n\n【以下参考までに物語あらすじ】\n\n舞台となる世界は私たちの知る世界よりずっと先の時代。\n人と魔法と獣の特徴を持つ亜人と呼ばれる種族が存在する世界。\n亜人は虐げられており、主人公である白虎の亜人シリウスは現状を打破したいと考えている。\nこの世界には「禁域」と呼ばれる立入禁止区域が存在する（キービジュアル、連ツイSS参照）シリウスは禁じられた場所に、この世界の秘密が隠されていると考え、各地にある「禁域」へと足を踏み入れることとなる。\n\n一言で纏めると、「廃墟と化した実験施設探索系RPG」です。\n\nご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nonai_sound/works/20", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=210997c0a8523ad9e1ce65192a063493", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=210997c0a8523ad9e1ce65192a063493, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1631640025019592704%2FG6PYpUwJ.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&