a/uploads/origins/f15df979-1d37-4851-bf63-c3c852d6c124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3bc42dc0ba0824477d11a99eb094679 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/99", "thumbnail_src": "https://si.imgix.net/fa68f6d5/uploads/origins/e5acc517-71d1-4d6d-ac1a-4ff6eb578929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0fb6e2ada3c600f8a9a7c72fb1cca9", "thumbnail_srcset": "https://si.imgix.net/fa68f6d5/uploads/origins/e5acc517-71d1-4d6d-ac1a-4ff6eb578929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0fb6e2ada3c600f8a9a7c72fb1cca9, https://si.imgix.net/fa68f6d5/uploads/origins/e5acc517-71d1-4d6d-ac1a-4ff6eb578929?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c2b0f42fa9b224dcbcd3d6e31746ca8 2x, https://si.imgix.net/fa68f6d5/uploads/origins/e5acc517-71d1-4d6d-ac1a-4ff6eb578929?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccc2309f7eb52433a3c41716c37a5444 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの絵が大好きです！内気で優しい魔法少女です。頑固で悲観的なところもあるけど、好奇心旺盛でいたずら好き。いつも一生懸命だけど、とっても不器用。かわいいもの、ぬいぐるみ、お菓子作りが大好き。\n\nポーズも自由です！\nお洋服の水玉模様（リストバンドと髪のリボン）と小さな牙もお忘れなく！ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1f5MTh5vzUuJptmQHSF25ndLhx06I31Pk", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/98", "thumbnail_src": "https://si.imgix.net/4215f31e/uploads/origins/381d12a9-2285-4500-88f8-c468a2cb85c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dc003e3149b16cb8b69f60687d48799", "thumbnail_srcset": "https://si.imgix.net/4215f31e/uploads/origins/381d12a9-2285-4500-88f8-c468a2cb85c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dc003e3149b16cb8b69f60687d48799, https://si.imgix.net/4215f31e/uploads/origins/381d12a9-2285-4500-88f8-c468a2cb85c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74c47e8501104fc67f31293b51114b2b 2x, https://si.imgix.net/4215f31e/uploads/origins/381d12a9-2285-4500-88f8-c468a2cb85c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe7e3f549f96f3e09cfa50ca1cbd4168 3x", "genre": "art", "nsfw": false, "body": "とま子先生、こんにちは！\n\nあなたの絵がとても好きです！私のVtuberを描いてください！\n\n某RPGのヒーラーで、ちょっと淫乱な元気娘です。\n\nこの絵はtwitchとsnsで使います！\n\nhttps://drive.google.com/drive/folders/1Wx8CIZUIZ1mR6YQe4BsDAABcx16c8K5P", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/97", "thumbnail_src": "https://si.imgix.net/a4b1171e/uploads/origins/e4e23ae9-536e-41e0-968d-1770e05abbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac428595c730de3edb58a96a5fa05f2b", "thumbnail_srcset": "https://si.imgix.net/a4b1171e/uploads/origins/e4e23ae9-536e-41e0-968d-1770e05abbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac428595c730de3edb58a96a5fa05f2b, https://si.imgix.net/a4b1171e/uploads/origins/e4e23ae9-536e-41e0-968d-1770e05abbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb7173e8df2bef919e15d4f08ab628fa 2x, https://si.imgix.net/a4b1171e/uploads/origins/e4e23ae9-536e-41e0-968d-1770e05abbe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d67257220e866527364e6fee89d84ae 3x", "genre": "art", "nsfw": false, "body": "hello again! I love all the previous artworks you’ve drawn for me and was hoping you could draw my new elf princess, Ellarues! She is a warm and friendly girl who is always smiling and loves to make people happy. \n\nshe has brown hair, pointed ears, and gold cuffs over her ears. Her dress is light pink and falls off the shoulder. Her eyes are hazel and also have flowers in them. Please remember to add the mole under her eye. \n\nI hope we can work together again! Thank you for your time! 💗\n\nhttps://drive.google.com/drive/folders/1KIPWBI31OSGvMwh0T7yhu1vpGcjDiII3", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/96", "thumbnail_src": "https://si.imgix.net/280c8a7d/uploads/origins/48ea1756-61c2-4827-a158-b2ec28377a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6371fc68016148174dcc8ed08827a65", "thumbnail_srcset": "https://si.imgix.net/280c8a7d/uploads/origins/48ea1756-61c2-4827-a158-b2ec28377a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6371fc68016148174dcc8ed08827a65, https://si.imgix.net/280c8a7d/uploads/origins/48ea1756-61c2-4827-a158-b2ec28377a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c896d484b15d3cd5c010b5fa1f630bbf 2x, https://si.imgix.net/280c8a7d/uploads/origins/48ea1756-61c2-4827-a158-b2ec28377a8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba613bee431e7e611583aa8bc414863b 3x", "genre": "art", "nsfw": false, "body": "Hello Tomako!\nI loved the illustration you made for me previously.\nI would like to request another illustration with two expressions, if possible. I would like to use it while streaming the game 'Elden Ring'.\n\n1. Mori holding a magical staff, looking a little bit worried.\n2. The same illustration, but looking a little bit surprised.\n\nPlease feel free to adjust the colour and style of the clothing and staff.\n\nThank you for your consideration!\n\nReference: https://imgur.com/a/S2hhr3x\n\nhttps://imgur.com/a/S2hhr3x", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/95", "thumbnail_src": "https://si.imgix.net/44147de3/uploads/origins/6ca2cd14-82d6-4e30-87f0-c893e4431ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2b4451512a37af864f86a50c8a9846", "thumbnail_srcset": "https://si.imgix.net/44147de3/uploads/origins/6ca2cd14-82d6-4e30-87f0-c893e4431ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2b4451512a37af864f86a50c8a9846, https://si.imgix.net/44147de3/uploads/origins/6ca2cd14-82d6-4e30-87f0-c893e4431ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c89e46d57a468c78c1005564c972bfdd 2x, https://si.imgix.net/44147de3/uploads/origins/6ca2cd14-82d6-4e30-87f0-c893e4431ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd62550dae420ac8d82daf17a4472b44 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n僕のOCのユキのアートをお願いしたいんだ。\n彼女は氷の魔法使いのキツネで、ぜひあなたのスタイルで描いてほしいです。\nポーズや背景はお任せしますが、できれば絵のどこかに氷を使ってほしいのと、ミステリアスでクールな感じでお願いします！\nよろしくお願いします！\n\nアフターBRNR\n\nhttps://imgur.com/a/GxNnyEv", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/94", "thumbnail_src": "https://si.imgix.net/298eb8b0/uploads/origins/6f735873-388c-42e1-8b73-84527f16a497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=addadd9b2ac5e22a39ed68d0596dabe8", "thumbnail_srcset": "https://si.imgix.net/298eb8b0/uploads/origins/6f735873-388c-42e1-8b73-84527f16a497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=addadd9b2ac5e22a39ed68d0596dabe8, https://si.imgix.net/298eb8b0/uploads/origins/6f735873-388c-42e1-8b73-84527f16a497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=135a01995fee04e58bcc5b5a59233b90 2x, https://si.imgix.net/298eb8b0/uploads/origins/6f735873-388c-42e1-8b73-84527f16a497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e8cadc48bf604b9ee28c4de2073e646 3x", "genre": "art", "nsfw": false, "body": "はじめまして、個人Vtuberとして活動をしておりますアン・アヴァンと申します。\nとま子様のイラストをX（旧twitter）で拝見し、思わず一目ぼれしてしまったSDイラストがあるためそちらのイラストをベースにSDキャラを一枚依頼できないかと思い、リクエストさせていただきました。\n以下、ご検討いただけますでしょうか…！\n\n■拝見したSDイラスト\nhttps://x.com/tomakodaaayo/status/1729769196223947197\n\n■お願いしたいキャラクター資料\nhttps://drive.google.com/drive/folders/1Nsdf89IQ5LHoZXS6tH2XI1hjtJhsCEG9?usp=sharing\n（キービジュアル・三面図・表情の参考資料があります）\n※衣装につきまして、後述するシチュエーションの都合上、資料内の和装ではなくジェラード〇ケ風のシンプルなナイトウェアに変更いただけると嬉しいです…！\n\n■お願いしたいイラストについて\n拝見したイラストをベースに、「就寝前」のシチュエーションで描いていただきたいです！\n・上半身のみのSDイラストから、下半身込みの全身SDイラストに変更\n・持っているアイテムを枕に変更\n・すでにケモ耳のあるキャラデザインのため、犬耳をキャラデザインのケモ耳へ置き換え\n・ふわっとした色使い、守ってあげたくなるうるうるな瞳は拝見したイラストそのままでぜひお願いします…！\n\n■使用用途について\n・X（旧Twitter）での宣伝活動\n・サムネイルや動画などでの使用\n上記を想定しています。\n（体調の都合で配信をお休みする時や怖い夢を見たよ～という日常ツイートをする際、描いていただいたイラストも併せて掲載させていただくイメージです）\nまた、可能であればキャラの部位が見切れないカットで描いていただき、背景とキャラが分離したpsd形式で納品いただけると用途の都合上大変助かります！\n\n■その他\n過去のskeb実績にSDイラストがなかったため、もし何かSDイラストの発注に不都合などございましたらリクエスト取り下げていただければと存じます…！\n直近まで悩んだのですが、諦めきれずリクエストさせていただいた次第です！\n\n以上、長くなってしまいましたが、ぜひご検討のほどよろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/93", "thumbnail_src": "https://si.imgix.net/6e032033/uploads/origins/a5a460c7-8644-4576-97ba-c0e51822c811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=adb04a37d30a9330f319bdd1dcb93349", "thumbnail_srcset": "https://si.imgix.net/6e032033/uploads/origins/a5a460c7-8644-4576-97ba-c0e51822c811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=adb04a37d30a9330f319bdd1dcb93349, https://si.imgix.net/6e032033/uploads/origins/a5a460c7-8644-4576-97ba-c0e51822c811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=276ee2fd0d71c4cedab60a43342f5022 2x, https://si.imgix.net/6e032033/uploads/origins/a5a460c7-8644-4576-97ba-c0e51822c811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f92583e9badb8c8f105d469425731f82 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/92", "thumbnail_src": "https://si.imgix.net/690372b6/uploads/origins/516ef27c-26a7-4c82-a723-ed57914f86e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf906389a9603a554cc3f062fe3a1ca2", "thumbnail_srcset": "https://si.imgix.net/690372b6/uploads/origins/516ef27c-26a7-4c82-a723-ed57914f86e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf906389a9603a554cc3f062fe3a1ca2, https://si.imgix.net/690372b6/uploads/origins/516ef27c-26a7-4c82-a723-ed57914f86e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed3250e110130b351ff3a32a5feb8030 2x, https://si.imgix.net/690372b6/uploads/origins/516ef27c-26a7-4c82-a723-ed57914f86e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=028d85e459ac8d7f5f3609a638b92a8c 3x", "genre": "art", "nsfw": false, "body": "Hello, my name is Remi and I'm a vtuber who streams video games! I'm a pink cyberpunk rabbit who is playful and cute and mischievous. \n\nI hope you can draw my character in your art style! I'll leave the outfit, pose, and background up to you.\n\nhttps://remivespertine.carrd.co/", "created_at": "", "completed_at": ""}, {"path": "/@tomakodaaayo/works/91", "thumbnail_src": "https://si.imgix.net/a7e081c7/uploads/origins/983d5cce-9792-4f15-bc24-b81c97b64e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8078bbedd57d8e1288dbaa67f09e6120", "thumbnail_srcset": "https://si.imgix.net/a7e081c7/uploads/origins/983d5cce-9792-4f15-bc24-b81c97b64e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8078bbedd57d8e1288dbaa67f09e6120, https://si.imgix.net/a7e081c7/uploads/origins/983d5cce-9792-4f15-bc24-b81c97b64e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7552a5facad2efd3856d17225fd1d35 2x, https://si.imgix.net/a7e081c7/uploads/origins/983d5cce-9792-4f15-bc24-b81c97b64e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cro