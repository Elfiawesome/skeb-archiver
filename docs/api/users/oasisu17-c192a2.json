fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ac3b82ae6541794a8c2b11abda0fd7c 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\n\nオリキャラのラブリーテイルのイラストを依頼したいです。\nhttps://www.deviantart.com/dlrowdog/art/Lovely-Tail-New-Sheet-2019-798529523\n\nラブリーテイルは身体がゴムのようなリス獣人の女の子でヒーローをしています。\nゴムのように伸び縮みしたり好きな形に変形したりすることができます。\n\n元気いっぱいな様子で、\n可能であれば、身体の一部を伸ばしたり変形したりして能力を使用している姿が望ましいです。\nよろしくお願いします。\n\n※下記↓資料URLに全身資料と過去絵がまとめてあります。\n\nhttps://www.deviantart.com/dlrowdog/gallery/71451827/lovelytail", "created_at": "", "completed_at": ""}, {"path": "/@oasisu17/works/87", "thumbnail_src": "https://si.imgix.net/5a48db32/uploads/origins/a4a3ab1f-4aea-4012-9e05-169d6329f633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3568b1bb62d3757ecae91b191b265a", "thumbnail_srcset": "https://si.imgix.net/5a48db32/uploads/origins/a4a3ab1f-4aea-4012-9e05-169d6329f633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd3568b1bb62d3757ecae91b191b265a, https://si.imgix.net/5a48db32/uploads/origins/a4a3ab1f-4aea-4012-9e05-169d6329f633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=908e07b4e6c7376f0f7f2c882558c2c0 2x, https://si.imgix.net/5a48db32/uploads/origins/a4a3ab1f-4aea-4012-9e05-169d6329f633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=897cf190ecd1e778b8f09f04540ead41 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております！\n以前に登場人物を描いていただいた拙作が、お陰様で連載のはこびとなりました。\nそこで、お世話になったオアシスさんに応援コメントつきのイラストを描いていただきたいと思います。\n以下、リクエスト詳細です。\n\n・ケモ化顔のオアシスちゃん\n・ポーズお任せ、顔は笑顔\n・ビキニアンドビーストにちなんでビキニ着用\n・お手間でなければおっぱいポロリ差分があると嬉しいです（漫画は乳首NGなので……）\n・背景は単色or無地、応援コメントを添えていただきたいです\n\nオアシスちゃんからの応援という雰囲気が欲しいので、拙作に寄せずにオアシスさんの色を前面に出してもらいたいと思います。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@oasisu17/works/86", "thumbnail_src": "https://si.imgix.net/d38fefa2/uploads/origins/98d251b5-3f6b-43d7-a533-769fd1507c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fc6fbbdb7e85415271169b4d300e93", "thumbnail_srcset": "https://si.imgix.net/d38fefa2/uploads/origins/98d251b5-3f6b-43d7-a533-769fd1507c75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fc6fbbdb7e85415271169b4d300e93, https://si.imgix.net/d38fefa2/uploads/origins/98d251b5-3f6b-43d7-a533-769fd1507c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3c795a757ca7eba9c4948612d8fa8f2 2x, https://si.imgix.net/d38fefa2/uploads/origins/98d251b5-3f6b-43d7-a533-769fd1507c75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb9085e12acd5517b7cf5bedef195d3b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、お久しぶりです！前回、オオカミ少女イルバを描いていただいて、私も友達もとても気に入りました。それで、また描いていただけないかとお願いしに来ました。\n前回もかっこよく描いてくれたし、もし気が向いたら何でもいいから描いてほしい！彼女は体力勝負のタイプ。肉系の食べ物もどんどん食べちゃう！何か思いついたら、やってみてください！\nお読みいただき、ありがとうございました。\n\nhttps://sta.sh/25e35h6ji5s", "created_at": "", "completed_at": ""}, {"path": "/@oasisu17/works/85", "thumbnail_src": "https://si.imgix.net/17f6bec8/uploads/origins/38987649-248d-4678-811b-9e82dbdd7473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7e240fc3d4ad98bed36f482dac07b6", "thumbnail_srcset": "https://si.imgix.net/17f6bec8/uploads/origins/38987649-248d-4678-811b-9e82dbdd7473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7e240fc3d4ad98bed36f482dac07b6, https://si.imgix.net/17f6bec8/uploads/origins/38987649-248d-4678-811b-9e82dbdd7473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83361ddaf491e30981d63d788fdc4ccb 2x, https://si.imgix.net/17f6bec8/uploads/origins/38987649-248d-4678-811b-9e82dbdd7473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd5fb47ae2af2e2389df4dfc6f9e3d70 3x", "genre": "art", "nsfw": false, "body": "おつオアー。\nニートだったけど働き始めたので好きなクリエーターに投げ銭。\n応援しておるよ。\n\n投げ銭が目的だから特にリクエストはないんだけど、\n夏っぽいオアシスちゃんのイラストとか見たいかなそろそろ夏だし。（海でも山でも）\n別の絵でも構いません。\nだらっと自由にかいてください。\n\nさとー", "created_at": "", "completed_at": ""}, {"path": "/@oasisu17/works/84", "thumbnail_src": "https://si.imgix.net/5d9624b6/uploads/origins/153494c5-5958-4377-83b2-844f93c4d382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e858c47aaed181db3dabee0aac6c0a24", "thumbnail_srcset": "https://si.imgix.net/5d9624b6/uploads/origins/153494c5-5958-4377-83b2-844f93c4d382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e858c47aaed181db3dabee0aac6c0a24, https://si.imgix.net/5d9624b6/uploads/origins/153494c5-5958-4377-83b2-844f93c4d382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c35549d24e3395d099802390815d5bdc 2x, https://si.imgix.net/5d9624b6/uploads/origins/153494c5-5958-4377-83b2-844f93c4d382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea3f2e1b2cb8e1bc2dfdc48acf1f8033 3x", "genre": "art", "nsfw": true, "body": "初めまして、むっちりと肉感的な表現がとても素敵で依頼をお送り致しました。\nご検討をお願い致します！\n\n描いて頂きたいのは参考URLのタヌキ獣人のキャラクターです。\n\nポーズや構図などはお任せしたいのですが、できれば全身図でヒロイックで…体型の強調されたちょっと色っぽい感じが希望です。\n念のためNSFW設定にしておりますが、上記の通りカッコ可愛く、どことなくエロい…そんな雰囲気でお願い致します！\n\n細かな希望ですがスーツはツヤツヤした光沢がありお腹はまん丸の太鼓腹、胸はスーツ越しに乳首の形が浮き気味な感じでお願いしたいので、全体的なプロポーションについてはオアシスさんのボリュームの盛り方が大変素晴らしいので、画風に合わせてアレンジもして頂けると嬉しいです！\n\n♂のキャラクターで、普段とだいぶ毛色の違う依頼かと思います。\nオアシスさんの豊満な肉体の描き方、特に腰からお尻・太ももにかけての艶めかしいラインとぴっちりとした衣装の質感表現に強く心惹かれ、可能であればこのキャラクターを描いて頂きたいと思いお送りした次第です。\n\nもし不快に感じられましたらごめんなさい、どうか遠慮無くお断り頂ければと思います。\nよろしくお願い致します…！\n\nhttps://twitter.com/gar_ger_k/status/1475509434109804544?s=46&t=XwpEYqoycM1YCGF8x3t34A", "created_at": "", "completed_at": ""}, {"path": "/@oasisu17/works/83", "thumbnail_src": "https://si.imgix.net/7f85370b/uploads/origins/9ac6eff9-dc60-4ceb-bc1b-ff92d3e285ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc549599679a5503c8c8f751cb676723", "thumbnail_srcset": "https://si.imgix.net/7f85370b/uploads/origins/9ac6eff9-dc60-4ceb-bc1b-ff92d3e285ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc549599679a5503c8c8f751cb676723, https://si.imgix.net/7f85370b/uploads/origins/9ac6eff9-dc60-4ceb-bc1b-ff92d3e285ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8c551380cc1d8e90de82179356cb085 2x, https://si.imgix.net/7f85370b/uploads/origins/9ac6eff9-dc60-4ceb-bc1b-ff92d3e285ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=410f24c53653b809894c267f5a888894 3x", "genre": "art", "nsfw": true, "body": "オアシス様\n\n以前描かれていた狐と狸の絵の狐にすごく惹かれましたので依頼させていただきます！\n若干オリキャラ作製のようになってしまいますが受けていただけると幸いです！\n\nシチュエーション:メスケモの狐さんがベッドに寝転び、ショタを蒸れ蒸れの左腋で挟んでむわぁ...♡っと獣臭嗅がせつつ、そのまま右手で手コキしてあげちゃう場面。\n\nキャラについて:顔つきは以前オアシス様が描かれていた若いきつねと同じような感じでお願いします。髪も無しでお願いします。身体に関しましては、太ももも胸もむっちむちに描いてくださると嬉しいです。\n\nキャラの衣装:引っ張れるような紐がついた金色の丸型ニプレスに金色のビキニパンツを装着しつつ、右狐耳に勾玉の飾り(資料リンク先参照)をお願いします。\n\n以上になります、細かい部分に関しましてはお任せ致します！\n\nhttps://twitter.com/hakugakitsune/status/1663322376141176832?s=46&t=Cl-8dIfLhQ3QRl3gNkR-GQ", "created_at": "", "completed_at": ""}, {"path": "/@oasisu17/works/82", "thumbnail_src": "https://si.imgix.net/303d1212/uploads/origins/ae4de2fb-fbd7-460c-96f2-9b0fc873bc58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ea15002a24f776d36eab3d58929935", "thumbnail_srcset": "https://si.imgix.net/303d1212/uploads/origins/ae4de2fb-fbd7-460c-96f2-9b0fc873bc58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ea15002a24f776d36eab3d58929935, https://si.imgix.net/303d1212/uploads/origins/ae4de2fb-fbd7-460c-96f2-9b0fc873bc58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebd6606e10286e245fd3284a2a86558c 2x, https://si.imgix.net/303d1212/uploads/origins/ae4de2fb-fbd7-460c-96f2-9b0fc873bc58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cd13c66595dc8e543a44cebf748c397 3x", "genre": "art", "nsfw": false, "body": "【概要】\n　https://twitter.com/oasisu17/status/1312754672264835072\n　このifで「待ってくれ！」と彼に手を握られ\n　『あ……』と振り返るオアシスちゃんを