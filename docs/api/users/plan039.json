df7d5d521d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4febce4b085d696d74d4009a18da0138 2x, https://si.imgix.net/5c4e2878/uploads/origins/b47c46a6-57ad-4e09-9d45-aedf7d5d521d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3b2e7ca7569c60067a3bf336e0cb7eb 3x", "genre": "art", "nsfw": false, "body": "熊野プラン様の「虫ノ少女ト」シリーズが好きなので、同シリーズで描かれていたような虫娘のイラストをリクエストさせてください。\n虫娘は陸棲の等脚類でお願いしたいです。\nワラジでもダンゴでも、等脚類の種類はお好みでお任せします。\n設定、服装、ポーズなどもお任せします。\nどうか心の赴くままに、熊野プラン様が想像される娘を自由に描いていただけると嬉しいです。\nご検討いただけると幸いです。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@plan039/works/9", "thumbnail_src": "https://si.imgix.net/a64f7e31/uploads/origins/e08ad5a6-1d94-4e37-88ad-e6ae9e0b881d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=178514d8e4bd05e96b2397465c10ac54", "thumbnail_srcset": "https://si.imgix.net/a64f7e31/uploads/origins/e08ad5a6-1d94-4e37-88ad-e6ae9e0b881d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=178514d8e4bd05e96b2397465c10ac54, https://si.imgix.net/a64f7e31/uploads/origins/e08ad5a6-1d94-4e37-88ad-e6ae9e0b881d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ef91f324f70b2517859a0ffd24cba2e 2x, https://si.imgix.net/a64f7e31/uploads/origins/e08ad5a6-1d94-4e37-88ad-e6ae9e0b881d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c386ca34b5a247712a3b6b348e7f70e 3x", "genre": "art", "nsfw": false, "body": "いつも所々にてお世話になっております、\n春のそよ風を感じる中で、夏に向けて依頼させて頂きたく存じます。\n\n個人勢VTuberの「花丸ちよ」(https://twitter.com/hanamaru_chiyo)のファンアートを描いて欲しいです。\n\n下記URLが三面図になります。\nhttps://twitter.com/hanamaru_chiyo/status/1604522003221794816\n\n【シチュエーション】\n清々しく麦茶を飲む（飲んだ）花丸ちよ\n\n【イラスト使用用途】\n①納品イラストを「#はなまるあーと」ハッシュタグ込めた、私のRTの許可\n②上記ハッシュタグの意図通りの、花丸ちよ本人によるイラストの使用\n\n何卒、ご検討の程を宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@plan039/works/8", "thumbnail_src": "https://si.imgix.net/1820ecd5/uploads/origins/7d890202-5