いです。\n髪型も通常からアレンジされていると\n嬉しいです。構図などはお任せいたします\n\n使用用途は、\n継続卓での利用など私的利用が主です\n卓報告のスクショやディスプレイ掲載でSNSに投稿する事もあるかもしれません\n\n何か料金設定など不備がありましたら再送して頂けますとと幸いです\n良ければご検討お願い致します...！\n\nhttps://drive.google.com/drive/folders/1UpC_UF7s0s0Sw-Hf7WyhaFVwgzD302gb", "created_at": "", "completed_at": ""}, {"path": "/@Kakaricyo_o/works/13", "thumbnail_src": "https://si.imgix.net/d9ffda63/uploads/origins/c7ce5e60-70fc-4b1e-ab7d-700bc5656732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=462df7232be347f1f033d18b762c3679", "thumbnail_srcset": "https://si.imgix.net/d9ffda63/uploads/origins/c7ce5e60-70fc-4b1e-ab7d-700bc5656732?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=462df7232be347f1f033d18b762c3679, https://si.imgix.net/d9ffda63/uploads/origins/c7ce5e60-70fc-4b1e-ab7d-700bc5656732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39c2c20103d6d5030dbd452c99581d30 2x, https://si.imgix.net/d9ffda63/uploads/origins/c7ce5e60-70fc-4b1e-ab7d-700bc5656732?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79c101291bc8a91e0a56bbab546128de 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kakaricyo_o/works/12", "thumbnail_src": "https://si.imgix.net/50123126/uploads/origins/1fddd7fa-fe5a-4203-9f3e-855b44f21f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05c858b682a4c70f5451d3db170f1c97", "thumbnail_srcset": "https://si.imgix.net/50123126/uploads/origins/1fd