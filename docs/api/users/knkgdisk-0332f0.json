f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3805ce2e9743c8bef5e30e2ae4623b6c 3x", "genre": "art", "nsfw": true, "body": "Hello, thank you for your appeal. My character is a nekomimi female with rose pink hair and light teal eyes. Feel free to draw her any way you like.", "created_at": "", "completed_at": ""}, {"path": "/@knkgdisk/works/37", "thumbnail_src": "https://si.imgix.net/e5bf35c7/uploads/origins/ad418ac7-75be-48a8-ba87-c909bf056318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2880562147ef6fa6da23c6eabe5373ec", "thumbnail_srcset": "https://si.imgix.net/e5bf35c7/uploads/origins/ad418ac7-75be-48a8-ba87-c909bf056318?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2880562147ef6fa6da23c6eabe5373ec, https://si.imgix.net/e5bf35c7/uploads/origins/ad418ac7-75be-48a8-ba87-c909bf056318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ce85e4e0095511ecca2b01c6709e92b 2x, https://si.imgix.net/e5bf35c7/uploads/origins/ad418ac7-75be-48a8-ba87-c909bf056318?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=289dfeb66af641c395090b2d3a4ece9b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアピールを見ました！\n\nもしよろしければ、キリエが戦場のヴァルキュリアシリーズのセルベリア・ブレスのコスプレをして、ノースリーブの戦闘服を着ているアートをお願いします。もし、彼女の服装が複雑だと感じたら、デザインを簡略化しても構いません！\n\nhttps://drive.google.com/drive/folders/1O_G9JYC4LcqCuetZaVZFySKl3QT_1R-s?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1-95vve3TA6naMBdXrAbM3YgaURBk30Sh?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@knkgdisk/works/36", "thumbnail_src": "https://si.imgix.net/e1029693/uploads/origins/4eb16892-77bb-4321-93ab-abf679b96ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c6406967fb8880e3acae3c07fda17a0", "thumbnail_srcset": "https://si.imgix.net/e1029693/uploads/origins/4eb16892-77bb-4321-93ab-abf679b96ff2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&