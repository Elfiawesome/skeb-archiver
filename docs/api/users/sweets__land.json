200&s=2e02a8fe5a53a2198705d0ddaa37c9b5, https://si.imgix.net/ff20f403/uploads/origins/4c16452b-d2c3-4d1d-b05b-a08739b0a7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fa0117fc1d2ee8e1c92f47c4829bde1 2x, https://si.imgix.net/ff20f403/uploads/origins/4c16452b-d2c3-4d1d-b05b-a08739b0a7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8c0a08a3b85b207b5170832b0f60989 3x", "genre": "art", "nsfw": false, "body": "BABUMILK先生こんばんは！\nBABUMILK先生のかっこいい絵のスタイル、大好きです！\n私のOC「尚矢」にはとても似合うと思いますので、リクエストさせていただきます！\nクールや反逆者な雰囲気で描いていただけるとうれしいです！\n28歳の殺し屋で、ヴィランタイプです。タトゥーのデザインはまだ完全に決まっていないのでご自由にデザインを考えても、タトゥーが見えないように描いても構いません。\nもしお金が足りない場合はぜひアピールをください。\n\nhttps://drive.google.com/drive/folders/16hA6DqQXHjmtUFmVvoXLsVc1CutB8sQK", "created_at": "", "completed_at": ""}, {"path": "/@sweets__land/works/542", "thumbnail_src": "https://si.imgix.net/4c683d6d/uploads/origins/5c54082b-e363-4057-b047-176584f274b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5b7c31f4a2669cd8de603875536964e", "thumbnail_srcset": "https://si.imgix.net/4c683d6d/uploads/origins/5c54082b-e363-4057-b047-176584f274b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5b7c31f4a2669cd8de603875536964e, https://si.imgix.net/4c683d6d/uploads/origins/5c54082b-e363-4057-b047-176584f274b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b79b3d7e8bfed5b0b059f255f14aaa9f 2x, https://si.imgix.net/4c683d6d/uploads/origins/5c54082b-e363-4057-b047-176584f274b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47e239865a0727add0b42aaedc4144ea 3x", "genre": "art", "nsfw": false, "body": "こんにちは！このオリジナルキャラクターの絵をお願いしたいです。\nhttps://vsona.co/roseberry\n\n好きなように描いていただいて構いませんが、牙を見せているところだけお願いします。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1LDRzNBpgPMyG96LTUkpm5jF47vA_JM8N?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@sweets__land/works/541", "thumbnail_src": "https://si.imgix.net/68915ce8/uploads/origins/9f90fcf9-ff7f-40ce-a8fc-ebcd4f4b7306?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf5a9166276a7facadc7e6b29c3dca8d", "thumbnail_srcset": "https://si.imgix.net/68915ce8/uploads/origins/9f90fcf9-ff7f-40ce-a8fc-ebcd4f4b7306?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf5a9166276a7facadc7e6b29c3dca8d, https://si.imgix.net/68915ce8/uploads/origins/9f90fcf9-ff7f-40ce-a8fc-ebcd4f4b7306?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc9b891b51e35299facd0412b2250019 2x, https://si.imgix.net/68915ce8/uploads/origins/9f90fcf9-ff7f-40ce-a8fc-ebcd4f4b7306?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7185667f803ef227c84cdf5d3b28d473 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Twitterで偶然あなたの作品に出会い、とても気に入りました！とても物欲しそうなタコ女です。TwitterやYoutube、TwitchなどのSNSや壁紙に使いたいです。あと舌が紫です！\n\nhttps://drive.google.com/drive/folders/1-3kSEJq64Azp7V1nUF6rfTsrDmkPzn7Q", "created_at": "", "completed_at": ""}, {"path": "/@sweets__land/works/540", "thumbnail_src": "https://si.imgix.net/0825c38e/uploads/origins/1acf1112-317f-471e-af95-857fd9036bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33fa7d6aa3c622256058137e0d40a8ce", "thumbnail_srcset": "https://si.imgix.net/0825c38e/uploads/origins/1acf1112-317f-471e-af95-857fd9036bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33fa7d6aa3c622256058137e0d40a8ce, https://si.imgix.net/0825c38e/uploads/origins/1acf1112-317f-471e-af95-857fd9036bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a2cfe8471070b3cd947261eba8b8a9e 2x, https://si.imgix.net/0825c38e/uploads/origins/1acf1112-317f-471e-af95-857fd9036bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a950da107ffff8e3b81c2b6209707d5d 3x", "genre": "art", "nsfw": false, "body": "ʙᴀʙᴜᴍɪʟᴋ様、初めまして！\n\nVtu