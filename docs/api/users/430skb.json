る。\n\n一応イメージ画像をおいておきます。\nhttps://www.pixiv.net/artworks/85008924#big_3\n\nあとスペースが残っていたらで良いので、下のurlイラストの構図でやられてる男の子のイラストをお願いします。相手は、一枚目と同じピエロマスクでお願いします。\nhttps://www.pixiv.net/artworks/105077350#big_1\n\nピエロマスクは、巨漢の褐色肌でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@430skb/works/53", "thumbnail_src": "https://si.imgix.net/f6a0ee50/uploads/origins/559e1956-5221-41f8-9fb6-6ebbb1f617a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ec659db05944e96acf991b7e30e7811", "thumbnail_srcset": "https://si.imgix.net/f6a0ee50/uploads/origins/559e1956-5221-41f8-9fb6-6ebbb1f617a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ec659db05944e96acf991b7e30e7811, https://si.imgix.net/f6a0ee50/uploads/origins/559e1956-5221-41f8-9fb6-6ebbb1f617a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed5774849a131849c75282786b129cf6 2x, https://si.imgix.net/f6a0ee50/uploads/origins/559e1956-5221-41f8-9fb6-6ebbb1f617a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=867b4270729dd2afd064451c2791717f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@430skb/works/52", "thumbnail_src": "https://si.imgix.net/09cd3819/uploads/origins/c7c29b5a-7ace-43ad-9ca0-b244959e8925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33396abbd50ff77e52fdff772e6af790", "thumbnail_srcset": "https://si.imgix.net/09cd3819/uploads/origins/c7c29b5a-7ace-43ad-9ca0-b244959e8925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33396abbd50ff7