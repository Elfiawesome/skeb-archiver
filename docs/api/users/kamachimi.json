40.596063+00:00", "thumbnail_src": "https://si.imgix.net/5baa5b64/uploads/origins/e8a4dec8-c165-4aff-9e3f-1cbaa1183b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14d3e4411f201d4397d0df0af439ee5a", "thumbnail_srcset": "https://si.imgix.net/5baa5b64/uploads/origins/e8a4dec8-c165-4aff-9e3f-1cbaa1183b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14d3e4411f201d4397d0df0af439ee5a, https://si.imgix.net/5baa5b64/uploads/origins/e8a4dec8-c165-4aff-9e3f-1cbaa1183b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e06b4e400374596db76a5e65021f591e 2x, https://si.imgix.net/5baa5b64/uploads/origins/e8a4dec8-c165-4aff-9e3f-1cbaa1183b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e9c13113ccf5cc1e0834b712318768c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kamachimi/works/128", "scraped_at": "2026-02-14T15:15:40.596063+00:00", "thumbnail_src": "https://si.imgix.net/53a61d80/uploads/origins/71a2f4e5-1c34-4a51-b8a9-84b60b14a6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=691dc03740c16e2dd51a2373cddbbc40", "thumbnail_srcset": "https://si.imgix.net/53a61d80/uploads/origins/71a2f4e5-1c34-4a51-b8a9-84b60b14a6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=691dc03740c16e2dd51a2373cddbbc40, https://si.imgix.net/53a61d80/uploads/origins/71a2f4e5-1c34-4a51-b8a9-84b60b14a6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccb83de098fb7058923fb0654f907064 2x, https://si.imgix.net/53a61d80/uploads/origins/71a2f4e5-1c34-4a51-b8a9-84b60b14a6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fb4e34f8d1c611ab480bf0ac3c96713 3x", "genre": "art", "nsfw": true, "body": "かまち先生、お久しぶりです。\n\nアメキというV:\n【drive.google.com/file/d/1w5erDSU1sNKFnTv5NecoeCiXf4LI0H47】\n\n今回はこのキャラクターの胸を揉むシーンを描いてほしい。\nシーンは人が少ない教室で起こるが、ドアや窓の外を人が通りかかる可能性があるので、完全にプライベートな空間ではない。キャラクターとその背後にいる人物は、前後2席にそれぞれ座っています。\n行為が目立たないように、キャラクターはジャケットを逆さに着ている。つまり背中に開いた部分があり、他人が手を差し込んでシャツ越しに胸を揉めるようになっている。(手はジャケットの下、シャツの上にある)\nキャラクターの後ろにいる人物は両腕を前に伸ばし、キャラクターの胸を掴みながら指で乳首を揉みます。キャラクターは平静を装い、手に持った本を読み続けることに必死です。\n胸を揉む人物の顔は明確に描く必要はなく、普通体型の普段着姿とする。\n可能な構図の一つをスケッチで試み、大まかな状況を説明しました。ご自身の理解に基づいて自由に描いてください。\n【drive.google.com/file/d/1xqI0zjs0q1fHrZryxgWPJnQsqgUkiz7C/】\n可能であれば、ジャケット越しに透けて見える透明効果差分を加え、乳房が揉まれる様子を描いてください。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kamachimi/works/127", "scraped_at": "2026-02-14T15:15:40.596063+00:00", "thumbnail_src": "https://si.imgix.net/dbd00aed/uploads/origins/42f4c0a8-0cbc-4c00-8657-5a0c1c8cdb4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1fb6fac9eb81bd1b2b147362201f965", "thumbnail_srcset": "https://si.imgix.net/dbd00aed/uploads/origins/42f4c0a8-0cbc-4c00-8657-5a0c1c8cdb4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1fb6fac9eb81bd1b2b147362201f965, https://si.imgix.net/dbd00aed/uploads/origins/42f4c0a8-0cbc-4c00-8657-5a0c1c8cdb4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa2d97c2d72828d1ea5f85202639d84c 2x, https://si.imgix.net/dbd00aed/uploads/origins/42f4c0a8-0cbc-4c00-8657-5a0c1c8cdb4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68c7ecf8957ca714de24a3dfaf2bff36 3x", "genre": "art", "nsfw": true, "body": "ネロちゃまありがとうございました……！差分のキラキラ目笑顔可愛すぎました。\n\n今回はBBちゃんのごっくん見せ、衣装はバニーです！\n\n【キャラ】BB(fgo)\n【衣装】バニー衣装(肌は白)乳首が浮き出ている、首輪と鎖\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR3k_DhKuR7PIny7kjtgqG7w1zQt2tKIyn6VUrKO4TKXw&s=10\n【設定】いつものです！\n【シーン】\nBBを正面に、両足を崩して片側に流した女座り。睨みつけながら髪コキ〜フェラをする。\n\n①嫌悪し睨みつける\n②勃起したチンコに恐怖\n③髪を巻きつけ手コキ\n④顔へぶっかけ射精(固形感のある大量の精液が顔に乗ってると嬉しいです)\n⑤お掃除フェラ\n⑥口内射精、涙を流して苦しそう\n⑦溜めた精液を口から垂らして両手で受ける\n\n【希望(出来ればで大丈夫です！)】\n何度も出された後、全身精液でドロドロ濡れスケ、ウサギ耳と手袋の脱着(可能であれば狐耳も見たく……)\n\nいかがでしょうか〜？次回辺りは文字付き玉藻の依頼するかもです！\n口内射精とか着衣ぶっかけばかりですいません……\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR3k_DhKuR7PIny7kjtgqG7w1zQt2tKIyn6VUrKO4TKXw&s=10", "created_at": "", "completed_at": ""}, {"path": "/@kamachimi/works/126", "scraped_at": "2026-02-14T15:15:40.596063+00:00", "thumbnail_src": "https://si.imgix.net/2d6706e2/uploads/origins/f3828523-dfae-4946-bfd7-c6ff0af69735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc7157c484077040c5f857c0da033344", "thumbnail_srcset": "https://si.imgix.net/2d6706e2/uploads/origins/f3828523-dfae-4946-bfd7-c6ff0af69735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc7157c484077040c5f857c0da033344, https://si.imgix.net/2d6706e2/uploads/origins/f3828523-dfae-4946-bfd7-c6ff0af69735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa26a89ee0140b8a04877d0dab5e2453 2x, https://si.imgix.net/2d6706e2/uploads/origins/f3828523-dfae-4946-bfd7-c6ff0af69735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19fffcd3278704dfd0ae3ccbdf51d9f2 3x", "genre": "art", "nsfw": true, "body": "また会ったね！\n\nレッサーパンダのVtuber、Toffeeのエロいシチュエーションを描いてください。衣装の参考にしたプロレス衣装を着てほしいです。彼女はリングの上で敗北し、肛門を犯されているはずです。負けたにもかかわらず、彼女は明らかにアナルを犯されて楽しんでいるはずです。\n\nありがとう！\n\nタフィーの引用：\nhttps://pbs.twimg.com/media/Gygz1ukWAAAFH4l?format=jpg&name=4096x4096\n\n衣装の参考\nhttps://pbs.twimg.com/media/G0e85-zXwAA6pNB?format=jpg&name=4096x4096\n\nポーズ参考：\nhttps://img4.gelbooru.com/images/ce/e3/cee3e94a1ac721574f5e366702ce6622.png", "created_at": "", "completed_at": ""}, {"path": "/@kamachimi/works/125", "scraped_at": "2026-02-14T15:15:40.596063+00:00", "thumbnail_src": 