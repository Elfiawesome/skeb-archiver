0&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d89957970ee4b34d45a43141dbcbc92c", "thumbnail_srcset": "https://si.imgix.net/9af69923/uploads/origins/e2b7473b-1857-4b2e-8509-32dec3b16aee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d89957970ee4b34d45a43141dbcbc92c, https://si.imgix.net/9af69923/uploads/origins/e2b7473b-1857-4b2e-8509-32dec3b16aee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ce8e15246f407c60918c800c780d0be 2x, https://si.imgix.net/9af69923/uploads/origins/e2b7473b-1857-4b2e-8509-32dec3b16aee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9d9b3f9d395191a5e68ff21abfa0c53 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@godbaan/works/62", "thumbnail_src": "https://si.imgix.net/9b033a9b/uploads/origins/a3b519f4-fec3-4aa5-b3da-cea2e03b3c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242e75e478b3360443d13885b2be68b2", "thumbnail_srcset": "https://si.imgix.net/9b033a9b/uploads/origins/a3b519f4-fec3-4aa5-b3da-cea2e03b3c86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242e75e478b3360443d13885b2be68b2, https://si.imgix.net/9b033a9b/uploads/origins/a3b519f4-fec3-4aa5-b3da-cea2e03b3c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d962a8c91cd0ffdf7f78f513105e3ee 2x, https://si.imgix.net/9b033a9b/uploads/origins/a3b519f4-fec3-4aa5-b3da-cea2e03b3c86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8524e2e3640d3d009e24b43d9674fcaa 3x", "genre": "art", "nsfw": true, "body": "こんにちは。このすばのゆんゆんのイラストをお願いします。\n\n巨乳のゆんゆんが普通の服を着て、催眠術で認識を変えられているのを見たいです。そして、催眠術をかけた男が、彼女が淫らな表情をしている間に彼女のオマンコに射精します。最後に、ゆんゆんは、少し茶色くなった乳首と妊娠で膨らんだお腹が見える淫らな服を着て、とても欲情して誘惑するような表情をしています。彼女が売春婦であることを表す淫らな体のタトゥーやジュエリーは自由に追加できます。", "created_at": "", "completed_at": ""}, {"path": "/@godbaan/works/61", "thumbnail_src": "https://si.imgix.net/8463757c/uploads/origins/90ac912a-752a-46a3-968b-caf3c7558f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf6beea6d1829a1ced24c713735c7e90", "thumbnail_srcset": "https://si.imgix.net/8463757c/uploads/origins/90ac912a-752a-46a3-968b-caf3c7558f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf6beea6d1829a1ced24c713735c7e90, https://si.imgix.net/8463757c/uploads/origins/90ac912a-752a-46a3-968b-caf3c7558f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c986f64600c5695bdf319d8b83283b6d 2x, https://si.imgix.net/8463757c/uploads/origins/90ac912a-752a-46a3-968b-caf3c7558f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e278f0861e255479716cd1a48707536 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nアイマスより鷺沢文香をお願いします。\n２コマ漫画みたいな感じ\n①文香ファンの一般人視点で、文香がドスケベな格好をしながら、男と一緒にラブホに入る所を見られる。\nまさかな…みたいな男のセリフ\n\n②ハメ尽くされて横たわる文香\nhttps://www.pixiv.net/artworks/122714270\nに近い構図\n精液や落書きとかいっぱい\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@godbaan/works/60", "thumbnail_src": "https://si.imgix.net/fd551e38/uploads/origins/19473165-4eda-407d-9d51-aa287eb884f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4995ccdd84235920f6a326c4e93568ec", "thumbnail_srcset": "https://si.imgix.net/fd551e38/uploads/origins/19473165-4eda-407d-9d51-aa287eb884f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4995ccdd84235920f6a326c4e93568ec, https://si.imgix.net/fd551e38/uploads/origins/19473165-4eda-407d-9d51-aa287eb884f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62d143e2b06b5c0840538a221108a7fa 2x, https://si.imgix.net/fd551e38/uploads/origins/19473165-4eda-407d-9d51-aa287eb884f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=305bdcc943c0e1da7ff48342d3c11532 3x", "genre": "art", "nsfw": true, "body": "スマイルプリキュアのキュアビューティをリクエストさせてください。\n\nシチュは悪人はエッチで勝負して懲らしめないといけないという催眠を受け、セックス勝負するが敗北。\n快楽堕ちしてオナホとしてオチンポに使えることに。\n\n勝負前の毅然とした表情の立ち絵。マンぐり返しで責められ敗北宣言しながらイキまくり負ける。堕ちて淫乱な衣装（淫紋付き）でオチンポにご奉仕。もっとオチンポでオマンコ負かしてほしい、オチンポに負かされるの気持ちいいと言って絶頂する。\nという構成を希望します。可能なら台詞をお願いしたいです。竿役は1人でも複数でも指定はありません。", "created_at": "", "completed_at": ""}, {"path": "/@godbaan/works/59", "thumbnail_src": "https://si.imgix.net/1bfb222c/uploads/origins/ee9d6469-2072-4b4c-95d4-bf676e07ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eabd14ca895efd3143bdb83434ca6527", "thumbnail_srcset": "https://si.imgix.net/1bfb222c/uploads/origins/ee9d6469-2072-4b4c-95d4-bf676e07ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eabd14ca895efd3143bdb83434ca6527, https://si.imgix.net/1bfb222c/uploads/origins/ee9d6469-2072-4b4c-95d4-bf676e07ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=debe425f551881fa1b3101dce9636a35 2x, https://si.imgix.net/1bfb222c/uploads/origins/ee9d6469-2072-4b4c-95d4-bf676e07ce62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d22f865488cfbfcec3bb91eb47899e26 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@godbaan/works/58", "thumbnail_src": "https://si.imgix.net/cd601468/uploads/origins/3d0