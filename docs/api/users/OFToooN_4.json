font=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df39a15abdd40c8645004ff4ce53181d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OFToooN_4/works/72", "thumbnail_src": "https://si.imgix.net/6d451265/uploads/origins/f1139cdb-b072-48ba-8b07-511b73a8297e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69e3645b3402516caf81c33f2bc99bae", "thumbnail_srcset": "https://si.imgix.net/6d451265/uploads/origins/f1139cdb-b072-48ba-8b07-511b73a8297e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69e3645b3402516caf81c33f2bc99bae, https://si.imgix.net/6d451265/uploads/origins/f1139cdb-b072-48ba-8b07-511b73a8297e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=494346f7924a7d88143753755933804a 2x, https://si.imgix.net/6d451265/uploads/origins/f1139cdb-b072-48ba-8b07-511b73a8297e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b33749eff45e1400c7034e757da5145 3x", "genre": "art", "nsfw": false, "body": "Hi!\n\nI really like your art, especially the colors you use.\n\nI want you to please draw a vtuber I follow, Qynoa. She really likes blue, SFW please.\nIf possible, I want her to be petting her cat.\n\nReferences: \nQynoa: https://imgur.com/a/mcgwJNY | \nCat: https://imgur.com/a/DcuhCyX\n\nThanks!", "created_at": "", "completed_at": ""}, {"path": "/@OFToooN_4/works/71", "thumbnail_src": "https://si.imgix.net/c4197282/uploads/origins/82db298a-b805-4f0f-9559-d96c2c52652e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=456c0d56444a936824ecb5e2c7729e8d", "thumbnail_srcset": "https://si.imgix.net/c4197282/uploads/origins/82db298a-b805-4f0f-9559-d96c2c52652e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=456c0d56444a936824ecb5e2c7729e8d, https://si.imgix.net/c4197282/uploads/origins/82db298a-b805-4f0f-9559-d96c2c52652e?bg=%23fff&auto=format%2Cco