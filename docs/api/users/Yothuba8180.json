9b8c-58d23d899836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfd9eb751144b531f22089b384411023 3x", "genre": "art", "nsfw": true, "body": "こなみよつば様、はじめまして。素敵なイラストを拝見しましたのでリクエストさせていただきます！\n\n今回は私のオリジナルキャラクターのアルエットがキスハメしているイラストを依頼させていただきたいです。\n\nキャラクターの資料はこちらをご覧ください。\n\n資料1\n(https://x.com/urapanSKB/status/1653029691517976577)\n資料2\n(https://drive.google.com/drive/folders/1_wBfEO1Lzrmc32UdK-6JRuaAtEgv9H-l?usp=drive_link)\n\n服装は資料2の006を参考にお願いします。\n衣装の装飾等が複雑な場合は描きやすいようにアレンジしていただければと思います。\n\n構図はこちらのイラスト(https://www.pixiv.net/artworks/134049696)のようなイメージで、竿役は以前描かれていたこちらのイラスト(https://www.pixiv.net/artworks/132338153)のような色黒めな無個性マッチョでお願います。\n\n差分に関しましては、挿入〜中出し・事後までの一連の流れを描いていただけますと幸いです！\n\n以上が依頼内容となります。お忙しい中とは存じますが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Yothuba8180/works/12", "thumbnail_src": "https://si.imgix.net/1b29c22c/uploads/origins/b4172475-fd71-40d8-9af6-7200a4b9a363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=693699d667bb1fa874686d33645a754a", "thumbnail_srcset": "https://si.imgix.net/1b29c22c/uploads/origins/b4172475-fd71-40d8-9af6-7200a4b9a363?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=693699d667bb1fa874686d33645a754a, https://si.imgix.net/1b29c22c/uploads/origins/b4172475-fd71-40d8-9af6-7200a4b9a363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8c0f38759d4863f77610f1baff44c8c 2x, https://si.imgix.net/1b29c22c/uploads/origins/b4172475-fd71-40d8-9af6-7200a4b9a363?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8516a3bc345554bf3f9b9bd6b0e688da 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Yothuba8180/works/11", "thumbnail_src": "https://si.imgix.net/d0c5993a/uploads/origins/5d790e05-b71f-4b6e-bc7a-7d1c51513fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ec90167437e8a26af4662f901df470", "thumbnail_srcset": "https://si.imgix.net/d0c5993a/uploads/origins/5d790e05-b71f-4b6e-bc7a-7d1c51513fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ec90167437e8a26af4662f901df470, https://si.imgix.net/d0c5993a/uploads/origins/5d790e05-b71f-4b6e-bc7a-7d1c51513fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b27655646d4a63c8caf8d8d39aa51b8 2x, https://si.imgix.net/d0c5993a/uploads/origins/5d790e05-b71f-4b6e-bc7a-7d1c51513fb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e81ac4f44af8a853e5e00f72a1460f7d 3x", "genre": "art", "nsfw": true, "body": "前回は素晴らしいイラストをありがとうございます。大変気に入りまして、新たに1枚依頼させて頂きたいと思います。具体的な内容としましては、\n\n「荒野の女戦士コスチューム姿のヒビキ、コトネ、クリス、リーフ」\n・コスチュームは遊戯王の荒野の女戦士の格好をベースに、それぞれの主人公時のカラーリングに変更。ヒビキのみ、男子にも似合う格好に変更\n・全員の荒野の女戦士の帽子には、主人公時の帽子の名残がある\n・ヒビキは通常体型だが、女子組はかなりのぽっちゃり体型。コトネは顔以外更に贅肉がつく\n・ダンジョン内で、ヒビキならギリギリ通れる通路で詰まってしまい、引き返そうとしたリーフとリーフの後に続いたクリス、コトネにヒビキが挟まれてしまい、密着。全員まともに身動きが取れない中、起死回生？でえっちに突入。\n・並び順は、リーフ、ヒビキ、クリス、コトネになります\n・コトネはクリスと場所を入れ替わるために必死にクリスをヒビキから引き離そうとしている\nに、なります。何卒よろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@Yothuba8180/works/10", "thumbnail_src": "https://si.imgix.net/bbd17fdc/uploads/origins/6c5e7992-26d7-462a-b94c-f801975872ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3253f44c6efedcce121611e60444904", "thumbnail_srcset": "https://si.imgix.net/bbd17fdc/uploads/origins/6c5e7992-26d7-462a-b94c-f801975872ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3253f44c6efedcce121611e60444904, https://si.imgix.net/bbd17fdc/uploads/origins/6c5e7992-26d7-462a-b94c-f801975872ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce43ecd59f52af1f194a2af05192c45c 2x, https://si.imgix.net/bbd17fdc/uploads/origins/6c5e7992-26d7-462a-b94c-f801975872ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75146d752c24e417171eeb781e7ea9d2 3x", "genre": "art", "nsfw": true, "body": "ヒビキ君に愛されすぎて贅肉をたっぷりと蓄えたコトネちゃんとコトネ大好き人間のヒビキ君がバレーボールの試合中にも関わらず、ベンチで指導しながら贅肉を揉む等、かなり際どい行為をしているイラストをお願いしたいです。ヒビキとコトネは双方共に今すぐえっちしたくて仕方がないのを必死に我慢しています", "created_at": "", "completed_at": ""}, {"path": "/@Yothuba8180/works/9", "thumbnail_src": "https://si.imgix.net/de42d20e/uploads/origins/0d49752c-543b-4cdc-8dcc-b325715c4f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f49fa46bde3495c9aec1be82003ff5c9", "thumbnail_srcset": "https://si.imgix.net/de42d20e/uploads/origins/0d49752c-543b-4cdc-8dcc-b325715c4f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f49fa46bde3495c9aec1be82003ff5c9, https://si.imgix.net/de42d20e/uploads/origins/0d49752c-543b-4cdc-8dcc-b325715c4f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba6295988490943f2e622cb7d5003d7f 2x, https://si.imgix.net/de42d20e/uploads/origins/0d49752c-543b-4cdc-8dcc-b325715c4f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=481c1f19de7a8b9aba90840e875dd4a4 3x", "genre": "art", "nsfw": true, "body": "先日ウマ娘のイラストをリクエストをした者です。Twitterで確認しました。\n挑戦しようとして頂きありがとうございます！\n実は小浪さんにもう1枚依頼しようと思っていたのでもう一度リクエスします！\n\nキャラクター【神谷奈緒（アイドルマスターシンデレラガールズ）と有村麻央（学園アイドルマスター）】\n服装【全裸】\nシチュ【強制的に密着】\n\n入れて欲しい要素\n　・キス＆乳合わせ、股には電動双頭ディルド（振動強）を挿入されている状況で密着させらている。\n　・離れる事は不可能な状態で快楽に抗っている。\n　・キスの音や喘ぎ声、ディルドの動く音、柔らかい胸同士が密着する音（むにゅ）、股からくちゅくちゅ粘液が擦れたりする音などが聞こえる。\n\n・2人とも（離れない…♡♡）（何でこんなことに〜！！♡）的なことを思いながら快楽に抗っている。\n\n差分として2人とも同時に絶頂してしまってる絵もあると嬉しいです。\n2人の心情（（誰か助けて〜♡♡♡））的なこと\nがわかるようになっていると嬉しいです。\n\n　このようなイラストをお願いしたいです。\n密着して離れらない理由は、『狭い場所にすっぽり挟まってしまって』とか『接着剤のせいで』とか『超能力で無理矢理』とか何でもいいので小浪さんのやりやすい理由で自分の推しをくっつけて離れない状況をぜひ作って欲しいです！　\nまたすぐで大変申し訳ないのですがご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Yothuba8180/works/8", "thumbnail_src": "https://si.imgix.net/4a92186a/uploads/origins/6d0e8e21-7d45-4eb8-a7ba-fd08673262fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11075ab5ec28171c777ea67bfe394449", "thumbnail_srcset": "https://si.imgix.net/4a92186a/uploads/origins/6d0e8e21-7d45-4eb8-a7ba-fd08673262fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11075ab5ec28171c777ea67bfe394449, https://si.imgix.net/4a92186a/uploads/origins/6d0e8e21-7d45-4eb8-a7ba-fd08673262fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b195d527d60407a96332469e612269e 2x, https://si.imgix.net/4a92186a/uploads/origins/6d0e8e21-7d45-4eb8-a7ba-fd08673262fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90539ed1f9081307d1a7630a4f36a358 3x", "genre": "art", "nsfw": true, "body": "御世話になります。\n「十六夜咲夜が男にクロロホルムを嗅がされて眠らされるシーン」をお願いします。\n・基本表情に「驚き」差分に「もがき」「目がとろーん」「薬が効き目の焦点が合わない」「白目を向き、気絶寸前（こちらは余裕があれば、で大丈夫です）」「目を閉じ気絶」「ハンカチ無しで寝顔が見える」をお願いします。\n・犯人は腕など一部分やシルエットで大丈夫です。背景もこだわりません。\n・全裸で、おっぱいやスジ(陰毛)が見える構図でお願いいたします。\n・犯人に抱きしめられる感じで眠らされます。\n・よければ台詞や効果音の有無差分もよろしいでしょうか。", "created_at": "", "completed_at": ""}, {"path": "/@Yothuba8180/works/7", "thumbnail_src": "https://si.imgix.net/903f75e6/uploads/origins/8dd9737a-4e22-4265-bac8-e08c61a2dd76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4c1f31f1b4d2ae4511d8b0f3a3df407", "thumbnail_srcset": "https://si.imgix.net/903f75e6/uploads/origins/8dd9737a-4e22-4265-bac8-e08c61a2dd76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4c1f31f1b4d2ae4511d8b0f3a3df407, https://si.imgix.net/903f75e6/uploads/origins/8dd9737a-4e22-4265-bac8-e08c61a2dd76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d4dde1ee2041c20824152fd3b2ecf5f 2x, https://s