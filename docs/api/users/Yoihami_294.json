rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6675e930aa30c69c4c57a63812b9f04a 2x, https://si.imgix.net/2f832845/uploads/origins/aaf64dda-1b70-4f95-a5bc-1a8f8b3f629b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=caf183800ec699a2063d31d394e82144 3x", "genre": "art", "nsfw": false, "body": "すいちゃんのGHOSTのイラストがかっこよくてリクエストさせて頂きます。\t\n\t\n【リクエスト内容】\t\n人物：星街すいせい（ホロライブ）\n表情：GHOSTの時のような凛とした表情\n服装：普段着風アイドル衣装またはFGOの沖田総司のような服装※1\n小物：ヘッドフォン装着\t\n構図：右下に座っている状態\t\n注文内容が多くなりましたが、ご多忙とは存じますが可能であれば是非とも宜しくお願い致します。\t\n\t\n【参考】\t\n※1　https://gyazo.com/a1ad5dd6e28d59387fb99d6d084d01aa", "created_at": "", "completed_at": ""}, {"path": "/@Yoihami_294/works/13", "thumbnail_src": "https://si.imgix.net/df6667ea/uploads/origins/12278a43-1bef-44a4-b54a-f526e2aa9efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ebc07bb26d4a744567ff1a14035dce6", "thumbnail_srcset": "https://si.imgix.net/df6667ea/uploads/origins/12278a43-1bef-44a4-b54a-f526e2aa9efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ebc07bb26d4a744567ff1a14035dce6, https://si.imgix.net/df6667ea/uploads/origins/12278a43-1bef-44a4-b54a-f526e2aa9efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=584d24a4a1cd5e5a3edd28d4590a93be 2x, https://si.imgix.net/df6667ea/uploads/origins/12278a43-1bef-44a4-b54a-f526e2aa9efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e7b635a4ffb8d04200da198570864af 3x", "genre": "art", "nsfw": false, "body": "初めまして。\n先生のイラストとても好きです。いろんなテーマ面白いし凄くカッコイイ。\nこの機会に描いて頂きたくリクエストさせて頂きました。\n\n推しの織田詩信さん@Unifee_nobu を描いていただきたいです。「本能寺の変」のイメージでお願いします。カッコイイ雰囲気でお願いします｡構図は先生のお好きに描いて嬉しいです｡\n\n可能であれば織田詩信さん本人に限り、イラストの使用許諾をいただければ幸いです。\n彼女所属ゆにふぃ！の二次創作ガイドライン はこちらですhttp://evestar.jp/unifee-guidelines/\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Yoihami_294/works/12", "thumbnail_src": "https://si.imgix.net/6714369c/uploads/origins/d65abf54-074d-4786-a2b5-7de2c4e651b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c98759a8c14c224259ac57e45fa987c6", "thumbnail_srcset": "https://si.imgix.net/6714369c/uploads/origins/d65abf54-074d-4786-a2b5-7de2c4e651b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c98759a8c14c224259ac57e45fa987c6, https://si.imgix.net/6714369c/uploads/origins/d65abf54-074d-4786-a2b5-7de2c4e651b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=758fe58b433d0e5a622c6d1aee2eb90a 2x, https://si.imgix.net/6714369c/uploads/origins/d65abf54-074d-4786-a2b5-7de2c4e651b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c444fb80ff5d17a4928f75f12fea923c 3x", "genre": "art", "nsfw": false, "body": "Skebを募集しているのを見かけたのでリクエストさせて頂きます。\n\nブラウザゲーム「天穹ノ彼方の錬星郷（そらノかなたのディストピア）」\n略称「ソラカナ」のキャラクターを描いて頂きたいです。\n\n描いて頂くキャラクターですが、\nお手数ですが、資料から気になったキャラクターをお願いします。\n\n資料のリスト一番下の「コラボユニット」は、コラボイベント時の他作品のキャラクターなので、\nコラボキャラ以外でお願いします。\n\n描いて頂くイラストについて、\nキャラクターの構図やポーズ、背景の有無に関してはお任せ致します。\n\n以上となります、よろしくお願いします。\n\nhttps://sd.swiki.jp/index.php?%E5%8C%BA%E5%88%86%E5%88%A5%E3%83%A6%E3%83%8B%E3%83%83%E3%83%88%E4%B8%80%E8%A6%A7#x86a9666", "created_at": "", "completed_at": ""}, {"path": "/@Yoihami_294/works/11", "thumbnail_src": "https://si.imgix.net/bb4bcdfe/uploads/origins/3bcdb5be-13cf-45c3-bb7f-a640f64ef100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add4c00927a528cf7b8b45c4e9f99c70", "thumbnail_srcset": "https://si.imgix.net/bb4bcdfe/uploads/origins/3bcdb5be-13cf-45c3-bb7f-a640f64ef100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=add4c00927a528cf7b8b45c4e9f99c70, https://si.imgix.net/bb4bcdfe/uploads/origins/3bcdb5be-13cf-45c3-bb7f-a640f64ef100?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7938ff09ccd4752e572f519dda1ada91 2x, https://si.imgix.net/bb4bcdfe/uploads/origins/3bcdb5be-13cf-45c3-bb7f-a640f64ef100?bg=%23fff&auto=format%2Ccompress