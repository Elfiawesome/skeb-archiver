pinterest.com/meiraine/idony/\nファッションキーワード\n- クリーム、アイボリー、淡い色\n- 生地の質感とシルエットの重視\n- ミニマルなパターン\n- ポップな明るい色\n- 透け感のある生地\n\n服装にこだわりはありません。あなたが楽しいと思うものを描いてください。より方向性をお望みでしたら、いくつかご提案させていただきます：\n- 春の気候に合わせたデート服\n- 夏のビーチコーデ\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@maroyaka_8/works/6", "thumbnail_src": "https://si.imgix.net/7e02ed6d/uploads/origins/41dc30c0-de22-4e37-a57e-8d38a78e8335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddd7a85370de4a9164fd47a967f093d5", "thumbnail_srcset": "https://si.imgix.net/7e02ed6d/uploads/origins/41dc30c0-de22-4e37-a57e-8d38a78e8335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddd7a85370de4a9164fd47a967f093d5, https://si.imgix.net/7e02ed6d/uploads/origins/41dc30c0-de22-4e37-a57e-8d38a78e8335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d6ea5348f9de7c9d4b291b53d129feb 2x, https://si.imgix.net/7e02ed6d/uploads/origins/41dc30c0-de22-4e37-a57e-8d38a78e8335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7bceba05fce7c20dd2b1c280f6340ab6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@maroyaka_8/works/5", "thumbnail_src": "https://si.imgix.net/32ec8b75/uploads/origins/1865e38a-d264-4015-bb55-89217d50160d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c28e9f22d264099685e5f357e7b491b", "thumbnail_srcset": "https://si.imgix.net/32ec8b75/uploads/origins/1865e38a-d264-4015-b