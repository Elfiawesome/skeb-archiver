bd5-80e325260d96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=937ba8c21a123c31de8780cb6a23edde, https://si.imgix.net/d90752a1/uploads/origins/0b0b8397-fa0f-4643-bbd5-80e325260d96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ead2a390e79193cc849bd76fa96810eb 2x, https://si.imgix.net/d90752a1/uploads/origins/0b0b8397-fa0f-4643-bbd5-80e325260d96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e689b312780e9b8271ba0d7f22fc643 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Vライバーをしてる愛羽あう(あいうあう)です。先日は素晴らしいまろやか様の素敵なイラストを本当にありがとうございました！！！！\n\n\nそして、再びの依頼をしたいなと思いましてお願いしたいのは、まろやか様にを涼しそうな立ち絵を描いて頂きたくお願いしたいと思います！デザインは資料URLに添付しました！（衣装のワンピースは水着ではありません）\n構図は正面を向いていて、目は両目開いている状態で目に髪がかからないようにお願いしたいです。ポーズ･表情はお任せします。\n\n使用用途は配信での立ち絵使用、Xでの投稿、アイコンやヘッダー等の返礼品です。\n\nもし可能であれば背景等を分けて頂きたいです。\n\nお値段変更や内容など厳しい部分ありましたらキャンセルや再送要請して下さいませ...！\nお忙しいとは思いますが、ご検討の程よろしくお願いいたします。\n\n愛羽あうの活動のリンク\nhttps://x.com/aiuau_wonbat?t=9MC3odzVIyk77VdDUWD0cQ&s=09\n\nhttps://drive.google.com/file/d/1I0cA49QUN3dbnzgU0Va8aHdGBqwtvxcR/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@maroyaka_8/works/11", "thumbnail_src": "https://si.imgix.net/11db1956/uploads/origins/72dd6393-d590-4575-a3fc-7d0bd33347f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b388247418caebb8fb57566967cfc4", "thumbnail_srcset": "https://si.imgix.net/11db1956/uploads/origins/72dd6393-d590-4575-a3fc-7d0bd33347f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b388247418caebb8fb57566967cfc4, https://si.imgix.net/11db1956/uploads/origins/72dd6393-d590-4575-a3fc-7d0bd33347f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdf2711868ead795e3d05770d04d1902 2x, https://si.imgix.net/11db1956/uploads/origins/72dd6393-d590-4575-a3fc-7d0bd33347f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61afd78967e16e8ad106e6fc4e800d84 3x"