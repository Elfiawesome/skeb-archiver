-8cf3-317c02b3efc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6a89bffc460895df5cdff601fda7f16 2x, https://si.imgix.net/8f257b61/uploads/origins/c1f6900c-81df-4204-8cf3-317c02b3efc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abc9b610099e452f78a13c506fd742e9 3x", "genre": "art", "nsfw": false, "body": "こんにちは!!\nろーりえ🌿🎀先生\n\nVtuberの 天満ニア (@amamania_vtuber) さんを描いてお願いしたいです。\n服: イブニングドレス\n他の要素はお好きなように描いてください！\nサムネイルで使用するため、耳や髪が見切れないようにして頂けると幸いです。\n\n完成したイラストは 天満ニア さんにもお送りいたします\n宛名・人物・背景でレイヤー分けされたPSDで頂けますと幸いです。\nまた、 天満ニア さんご本人に限りイラストの使用許可をいただけないでしょうか。\n※Twitterへの投稿、配信サムネイル等で使用される可能性がございます。\n※天満ニアさんは、skebの二次創作公認プログラムに登録済みです\n\nよろしくお願いいたします!!\n\n■天満ニアの画像&資料\n▷https://lit.link/en/amamania\nhttps://twitter.com/amamania_vtuber", "created_at": "", "completed_at": ""}, {"path": "/@Laurier_rori/works/12", "thumbnail_src": "https://si.imgix.net/ce1e34f8/uploads/origins/8e101d42-cd90-41f1-9542-ad762a56378b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1a6a4304bda6b0ef2652abc5456ee77", "thumbnail_srcset": "https://si.imgix.net/ce1e34f8/uploads/origins/8e101d42-cd90-41f1-9542-ad762a56378b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1a6a4304bda6b0ef2652abc5456ee77, https://si.imgix.net/ce1e34f8/uploads/origins/8e101d42-cd90-41f1-9542-ad762a56378b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=480a52e3ab24bd7c56c0808f78e25914 2x, https://si.imgix.net/ce1e34f8/uploads/origins/8e101d42-cd90-41f1-9542-ad762a56378b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16caf64a15558488c7e12a4c48805b28 3x", "genre": "art", "nsfw": false, "body": "ろーりえ様、以前は素敵なイラストをありがとうございました！！\nリピート可能でしたら、ぜひ今回は私の新衣装のイラストを描いていただきたく、リクエストさせていただきました。\n\n■用途\nYouTubeの配信サムネイル，Twitterでのプロモーション等\n\n■イラストの概要\n・キャラクターや宛名・背景等が分かれているファイルで納品していただけるとありがたいです。\n・配信のサムネイルとしても使いたいので、人物は左右が切れないようにお願い出来たら嬉しいです。\n・構図・ポーズはお任せいたします。\n・もし可能であれば表情差分をいただけると嬉しいのですが、難しい場合は大丈夫です…！\n\n■衣装について\n以下をご参考ください。\n髪形と服装の差分が複数あるのですが、ろーりえ様の描きやすい組み合わせで描いていただけたらと思います。\n\n＊三面図\nhttps://drive.google.com/file/d/1WoGecwor9SXwaAbV73GAWEnU98porpXt/view?usp=sharing\n\n＊立ち絵\nhttps://drive.google.com/file/d/16XVURO7hJ8nEeefGIF-9Ujhxxak0cDza/view?usp=sharing\n\n以上です。ご検討の程よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Laurier_rori/works/11", "thumbnail_src": "https://si.imgix.net/dc098ae1/uploads/origins/f31eaf61-4805-4eb5-a6f0-d617f0e11930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc94a062f644732d1b103ce2f726a59b", "thumbnail_srcset": "https://si.imgix.net/dc098ae1/uploads/origins/f31eaf61-4805-4eb5-a6f0-d617f0e11930?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc94a062f644732d1b103ce2f726a59b, https://si.imgix.net/dc098ae1/uploads/origins/f31eaf61-4805-4eb5-a6f0-d617f0e11930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd34b7952869dd9da570f398a9825312 2x, https://si.imgix.net/dc098ae1/uploads/origins/f31eaf61-4805-4eb5-a6f0-d617f0e11930?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6deca46c1edb687fef9c56ad242c3629 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\n画家、Vtuber準備中のかおるえねこと申します！\n先生の素敵なイラストを拝見させていただきまして、\nご依頼をさせていただきたいとおもいました！\n\n■キャラクター特徴\n・黒猫もどき（しっぽはつけしっぽ）\n・職業は画家（キャンパス×えのぐ）\n・元気すぎる大和撫子\n・瞳の色が虹色\n・瞳のなかに肉球スタンプ\n・イメージカラーはピンク×黒\n・全体的にポップな雰囲気\n・左胸と左ももに小さなホクロ\n・ベルトのバックルに猫（資料参照）\n・お供に黒猫（資料参照）\nその他添付資料を参考におねがいします。\n\n■表情・ポーズ\n構図などおまかせします！\n歯を出した悪戯な表情や、ほほえみ、満面のえみなど可能な範囲での表情差分をいただけるとうれしいです！\n\n様々な用途で使用したいため髪の毛や頭部、腕などが途切れない構図で\n背景とキャラクターのレイヤーわけファイルをおねがいします！\n\n■使用用途\n・youtube動画内での使用\n・SNS・メディアへの掲載\n・商用利用\n・いただいたものに文字やトリミング、色調補正などの加工をいれる場合があります\n\nご検討のほどをよろしくおねがいいたします！\n\nhttps://drive.google.com/drive/folders/1JYQYFxnnP_4p37pkiW-G7qgpe2ipM-pC?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Laurier_rori/works/10", "thumbnail_src": "https://si.imgix.net/3ba5e1e9/uploads/origins/ca95c6ab-de5b-466e-aa67-892b489ba951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5841d7d8973fcf7285597bb46b2cbec7", "thumbnail_srcset": "https://si.imgix.net/3ba5e1e9/uploads/origins/ca95c6ab-de5b-466e-aa67-892b489ba951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5841d7d8973fcf7285597bb46b2cbec7, https://si.imgix.net/3ba5e1e9/uploads/origins/ca95c6ab-de5b-466e-aa67-892b489ba951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5c12e37262e71ee72370795c77c568d 2x, https://si.imgix.net/3ba5e1e9/uploads/origins/ca95c6ab-de5b-466e-aa67-892b489ba951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f571a95c4da2e7e7dbc1d7d148c6937 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。クラブです。\n今回初めてリクエストさせていただきます。\n一応下記で詳細を記載しておりますが、すべてにおいてろーりえ様にイメージがあればそちらを優先していただいて構いません。\n\n◆用途\n将来的に実施するかもしれないオフ会告知用のイラスト\n（実施されるかもわからないので、だいたい個人が楽しむ用）\n\n◆キャラクター\n星結ろりこ\n衣装は「星結ろりこがわかる本2」15ページの私服イラストがよいです。\n\n◆シチュエーション・構図\n都会を歩いている構図がよいです。イメージとしてはそれこそ「星結ろりこがわかる本２」でのショッピングモールのイラストの続きのような。\n一応オフ会をするならば都会だろうということで、そこにろりこさんと一緒に向かっている、というようなシチュエーションを考えています。\n\nリクエストは以上です。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Laurier_rori/works/9", "thumbnail_src": "https://si.imgix.net/c77a6ca1/uploads/origins/0aefc7d7-a595-499f-926c-290154afaecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=742cb0e32e23a8627ad9cacbfe0b5ba1", "thumbnail_srcset": "https://si.imgix.net/c77a6ca1/uploads/origins/0aefc7d7-a595-499f-926c-290154afaecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=742cb0e32e23a8627ad9cacbfe0b5ba1, https://si.imgix.net/c77a6ca1/uploads/origins/0aefc7d7-a595-499f-926c-290154afaecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58441e37c8a2dbc0d0d16c90a24addc0 2x, https://si.imgix.net/c77a6ca1/uploads/origins/0aefc7d7-a595-499f-926c-290154afaecd?bg=%23fff&au