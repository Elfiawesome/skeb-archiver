ebf38/uploads/origins/4dc4c2ca-d4ba-41d7-b3b3-27973d8b5feb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2c2113018487dd9976afe45c1d5719", "thumbnail_srcset": "https://si.imgix.net/731ebf38/uploads/origins/4dc4c2ca-d4ba-41d7-b3b3-27973d8b5feb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f2c2113018487dd9976afe45c1d5719, https://si.imgix.net/731ebf38/uploads/origins/4dc4c2ca-d4ba-41d7-b3b3-27973d8b5feb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70ff246033f3365e09468712ec812ed3 2x, https://si.imgix.net/731ebf38/uploads/origins/4dc4c2ca-d4ba-41d7-b3b3-27973d8b5feb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=767874eb94105bbd9d171b6c9a71d2e1 3x", "genre": "art", "nsfw": true, "body": "ブルアカのカズサをお願いします。\nトリニティイベントで見せてくれたあの衣装を着させてください。体型はしっかり肥満体。汗と脂と蒸れ多めで。", "created_at": "", "completed_at": ""}, {"path": "/@kururu0402/works/13", "thumbnail_src": "https://si.imgix.net/953ba28a/uploads/origins/98067d69-86aa-4fbf-9492-4a927872496e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b84881599dc4e8f749cceeef1ba45e0", "thumbnail_srcset": "https://si.imgix.net/953ba28a/uploads/origins/98067d69-86aa-4fbf-9492-4a927872496e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b84881599dc4e8f749cceeef1ba45e0, https://si.imgix.net/953ba28a/uploads/origins/98067d69-86aa-4fbf-9492-4a927872496e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b298d703b368175edf83fc157f1fa32 2x, https://si.imgix.net/953ba28a/uploads/origins/98067d69-86aa-4fbf-9492-4a927872496e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68ed31edeef5f4f9b94f36d80414b738 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\nブルーアーカイブから和泉元エイミの肥満化をお願いしたいです。\n通常衣装で体型やポーズは資料URLにある水着メイドヒビキと同じくらいでお腹を持ち上げている様子でお願いします。\n\nhttps://x.com/kururu_kurukur/status/1817578846050550125?s=46&t=HiancHEnZQ8G6GWueGvmMA", "created_at": "", "completed_at": ""}, {"path": "/@kururu0402/works/12", "thumbnail_src": "https://si.imgix.net/f3443a30/uploads/origins/81025a1f-3921-4f17-bb67-b943bc88249d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37664c960422adcdfafa5b2b2d85a2cf", "thumbnail_srcset": "https://si.imgix.net/f3443a30/uploads/origins/81025a1f-3921-4f17-bb67-b943bc88249d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37664c960422adcdfafa5b2b2d85a2cf, https://si.imgix.net/f3443a30/uploads/origins/81025a1f-3921-4f17-bb67-b943bc88249d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d979f26f392120cb8229bec04c160e68 2x, https://si.imgix.net/f3443a30/uploads/origins/81025a1f-3921-4f17-bb67-b943bc88249d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6d6c5c3f4c45289f5bd3f455c119f41 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お願いがあります。\n\nキャラクター: 春原シュン(幼女) 春原ココナ\nシナリオ：春原シュンは外で甘いものを食べ過ぎているところを春原ココナに見つかった。\n春原シュンは道路を歩いていて、ケーキを口に入れたところを見つかった。恥ずかしそうにしている。参考文献(https://skeb.jp/@Great_sushi_man/works/71)にあるように、彼女は太っていて、腹が詰まっていて、ビール腹のはずだ。ドレスは体にぴったりフィットしていない。\n春原ココナは写真のほんの一部しか占めていない。写真の右側には彼女の一部しか写っていない。吹き出しに💢を使って、彼女が少しイライラしていることを表しましょう。ぽっちゃりした彼女を描けば最高！\n\n細かいところは、あなた次第です。\nそれでは、良い一日を :)", "created_at": "", "completed_at": ""}, {"path": "/@kururu0402/works/11", "thumbnail_src": "https://si.imgix.net/bc9ee094/uploads/origins/e5be443e-3a73-48b3-8423-d7c7505acc07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a14851992799d2f3e3532df55351403b", "thumbnail_srcset": "https://si.imgix.net/bc9ee094/uploads/origins/e5be443e-3a73-48b3-8423-d7c7505acc07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a14851992799d2f3e3532df55351403b, https://si.imgix.net/bc9ee094/uploads/origins/e5be443e-3a73-48b3-8423-d7c7505acc07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b74067c241174442105ce85c03a43ebf 2