4a993/uploads/origins/2ac2cd4e-30d5-4eba-b4a3-5aa8038d0333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff162a3c20bd75bf0387f9b47b3c439b, https://si.imgix.net/00d4a993/uploads/origins/2ac2cd4e-30d5-4eba-b4a3-5aa8038d0333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f7140420dade21a1190d4eb0d801144 2x, https://si.imgix.net/00d4a993/uploads/origins/2ac2cd4e-30d5-4eba-b4a3-5aa8038d0333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=329eeaa2608058d32e1cb66c09e48c92 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nVtuberの白姫城シレンと申します。\n個人で活動していてASMRメインで活動しています！\nメンバーシップで使用する予定のスタンプの作成をお願いしたいです！\n\n【ご依頼内容】\nスタンプ作成\n①ヘッドホンを付けて目を閉じているスタンプ\n②ハート目で「好き」の文字入りスタンプ\n③うとうとしていてるスタンプ\n④恥ずかしがってるスタンプ\n⑤「おやすみ」の文字入りスタンプ\n⑥「こんばんは」の文字入りスタンプ\n\nメンバーシップ用のバッジ作成\n⑦笑顔のバッジ\n⑧⑦に追加できらきら✨がでてるバッジ\n⑧⑦に追加で小さいハートを飛ばしているバッジ\n\nhttps://drive.google.com/file/d/11t5nPGaX04xfhj1QVOcSEt4pjWOtPc8s/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@tyuna_24/works/112", "thumbnail_src": "https://si.imgix.net/8a87efc9/uploads/origins/cb0a2b10-dbfc-499f-89a4-12e729bffdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c86cdea287729424dfd155599f9556ae", "thumbnail_srcset": "https://si.imgix.net/8a87efc9/uploads/origins/cb0a2b10-dbfc-499f-89a4-12e729bffdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c86cdea287729424dfd155599f9556ae, https://si.imgix.net/8a87efc9/uploads/origins/cb0a2b10-dbfc-499f-89a4-12e729bffdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fa2b355501c04a1cec44b23a9ed8e11 2x, https://si.imgix.net/8a87efc9/uploads/origins