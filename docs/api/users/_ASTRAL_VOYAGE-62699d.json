3c38-4f8a-a213-94696d5643b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaae7da669d99e4b95ff8c76b929dc60", "thumbnail_srcset": "https://si.imgix.net/af343f8d/uploads/origins/712bfcef-3c38-4f8a-a213-94696d5643b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaae7da669d99e4b95ff8c76b929dc60, https://si.imgix.net/af343f8d/uploads/origins/712bfcef-3c38-4f8a-a213-94696d5643b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc09bbe46e50af29965791f998adb454 2x, https://si.imgix.net/af343f8d/uploads/origins/712bfcef-3c38-4f8a-a213-94696d5643b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a07e91920f99d74762e6250d194bdc88 3x", "genre": "art", "nsfw": false, "body": "はやしさん、こんにちは！頂天眼です。前回は本当にありがとうございました！先輩後輩二人が一緒に出かけるシーンはかわいい過ぎる。\nもしよければ、今回も私のTRPG探索者と友人の公開予定無しオリシNPCを描いていただけますか？\n\n構図などはご自由にどうぞ！お好きなように描いてください！見た目の参考、キャラ設定と二人のストーリーはこちらで↓\nhttps://drive.google.com/drive/folders/1sISGuN9aQRNfgyJz5igJ_xJgkb_pUmUW?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@_ASTRAL_VOYAGE/works/17", "thumbnail_src": "https://si.imgix.net/35699435/uploads/origins/d51b701b-f649-4a05-955b-1f8ce1012c46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f985d3ca82d5594c68a449948fcc75e", "thumbnail_srcset": "https://si.imgix.net/35699435/uploads/origins/d51b701b-f649-4a05-955b-1f8ce1012c46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f985d3ca82d5594c68a449948fcc75e, https://si.imgix.net/35699435/uploads/origins/d51b701b-f649-4a05-955b-1f8ce1012c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6489dd6f3923560ef41f75aa7723ceb9 2x, https://si.imgix.net/35699435/uploads/origins/d51b701b-f649-4a05-955b-1f8ce1012c46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00a0ff4c45d870772278553de6ef039f 3x", "genre": "art", "nsfw": false, "body": "はじめまして、Dingという宇宙人Vtuberです。 \n先生の絵柄、キャラの関係性が大好きです。   \n\nもしできれば、Dingと友のイラストを描いていただきたいです。 \n友の誕生日祝いなので、\n彼女たちが楽しく遊び中、まだは食事中のイラストをお願いします。\n\n先生のこれらのイラストは特に気に入ります！\nhttps://skeb.jp/@_ASTRAL_VOYAGE/works/12\nhttps://skeb.jp/@_ASTRAL_VOYAGE/works/14\nhttps://skeb.jp/@_ASTRAL_VOYAGE/works/6\nこういう感じの仲良しイラストにするのは幸いです。\n\n▷使用用途 ・SNS活動 ・配信活動  \nもし良ければ透過背景なPNGもお願いします。 \n   \nキャラの設定についでリングを参考↓  https://drive.google.com/file/d/1_o4v7tUw2b6Hy4bl3edczWnvI9yA4_JE/view?usp=drive_link\nhttps://x.com/DingGamingHK\nDingはコーヒー、任天堂さんのゲーム、猫も大好きです。 \n普段は大人しい性格ですがゲームする時はかなり悪口になる性格です。\n\n友の設定参考↓\nhttps://drive.google.com/drive/u/1/folders/1H3y8g1GVOYA08v-46rCnY05flzAVUwaT\nhttps://x.com/Donuteatdoodle\n糖ナツは明るくて優しい子、実は非常に賢いです。 \nウクレレもお料理も上手で、器用なドーナツです。\n\nご検討ありがどうございます！", "created_at": "", "completed_at": ""}, {"path": "/@_ASTRAL_VOYAGE/works/16", "thumbnail_src": "https://si.imgix.net/2967d833/uploads/origins/bc5a3d92-fa2b-40d7-af03-3f08543a0982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4af0ec320005b161133bf06013f2e9f", "thumbnail_srcset": "https://si.imgix.net/2967d833/uploads/origins/bc5a3d92-fa2b-40d7-af03-3f08543a0982?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4af0ec320005b161133bf06013f2e9f, https://si.imgix.net/2967d833/uploads/origins/bc5a3d92-fa2b-40d7-af03-3f08543a0982?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62bf0c042cf3e72033b3e21ce196f869 2x, https://si.imgix.net/2967d833/uploads/origins/bc5a3d92-fa2b-40d7-af03-3f08543a0982?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca80c7560b8212bd09a22af02ac5fc7a 3x", "genre": "art", "nsfw": false, "body": "Hello.\nI am a vtuber from Hong Kong\nI love your style.\nI'd like to request a drawing of my Vtuber image.\nref:https://skeb.jp/@_ASTRAL_VOYAGE/works/1\ni hope it look like a bit morning beginning or almost night.\nPlease keep her choker and earrings.\nLink to my character: https://drive.google.com/file/d/19cFubS4CPZ5Pm50bw9Fg