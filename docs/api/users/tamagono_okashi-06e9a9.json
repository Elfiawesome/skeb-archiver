63-ab99-8d7c7d79da7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=293059fcea9ba29d65d950e6f738dd1d, https://si.imgix.net/3b2143e7/uploads/origins/7e3839aa-2003-4a63-ab99-8d7c7d79da7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c1855814c544382be1c6c83dd40380e 2x, https://si.imgix.net/3b2143e7/uploads/origins/7e3839aa-2003-4a63-ab99-8d7c7d79da7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db87900a1bc16d56a2f0936751622160 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして。二人のキャラクターのアートをお願いしたいです。二人は親友のペアです。お互いに想い合っているが、それを認めようとしない。\n\n▶🎋キャラクターA(186cm、ドラマー)。\nA参考URL：https://sta.sh/21duj369ciwf\nバンドのドラマー。厳しい環境で育ち、ようやく自分らしくいられる余裕が出てきた。キャラクターAとは、ステージ上でかなり茶目っ気があり、公然とイチャイチャしがちだが、2人の中では優しい方である。\n\n▶🔖キャラクターB（188cm、ギタリスト）。\nB参考URL：https://sta.sh/2neagwlmzz\nカオスを好むイケメン・カリスマギタリスト。観客やキャラクターAから注目を浴びるのが特に好き。ステージ上ではとてもエネルギッシュだが、そのカリスマ性とは裏腹に、キャラクターAにだけは優しくしてくれる。\n\nご注意ください。\n- キャラクターAの肌色\n- AとBの傷跡＆タトゥー(簡略化はご自由に)\n- Bのほくろ\n\n楽器は必須ではありません。視覚的に参考にするため、それぞれの参考URLをご参照ください。", "created_at": "", "completed_at": ""}, {"path": "/@tamagono_okashi/works/2", "thumbnail_src": "https://si.imgix.net/bdaf2d56/uploads/origins/8dadca04-7cb8-49f3-8bbb-e7e4ad610487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=192bfb98164a2d30bdea716278000d7c", "thumbnail_srcset": "https://si.imgix.net/bdaf2d56/uploads/origins/8dadca04-7cb8-49f3-8bbb-e7e4ad610487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=192bfb98164a2d30bdea716278000d7c, https://si.imgix.net/bdaf2d56/uploads/origins/8dadca04-7cb8-49f3-8bbb-e7e4ad610487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=P