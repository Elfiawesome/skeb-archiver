fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e42ac517a021af71ed9cdbef54137fbd 2x, https://si.imgix.net/4e3b0d89/uploads/origins/63f23cb9-6301-4cb6-84d3-9b06add03229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2c527465f56ab389707e309440ad4d8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵が大好きです！FFXIVのキャラクターを描いてくれませんか?\n\n白い髪に黒いハイライト。目はオレンジと紫。\n\n牙は一本でお願いします。それ以外はお任せします！\n\nよろしくお願いします。\n\nhttps://imgur.com/a/msrw9Vk", "created_at": "", "completed_at": ""}, {"path": "/@aque_48/works/3", "thumbnail_src": "https://si.imgix.net/ad5063d3/uploads/origins/d073af6c-10c6-4d1d-8860-ce38d76a3302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63834e160fef960c433ee321dff75745", "thumbnail_srcset": "https://si.imgix.net/ad5063d3/uploads/origins/d073af6c-10c6-4d1d-8860-ce38d76a3302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63834e160fef960c433ee321dff75745, https://si.imgix.net/ad5063d3/uploads/origins/d073af6c-10c6-4d1d-8860-ce38d76a3302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13c583404994a4aa45897ded9d0cb6bc 2x, https://si.imgix.net/ad5063d3/uploads/origins/d073af6c-10c6-4d1d-8860-ce38d76a3302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=753bc26b1120c5667a0613721653f58d 3x", "genre": "art", "nsfw": false, "body": "Hello I really like your art. I would like to request a picture of my xiv character. Pose and Background is up to you. You could also change the outfit if you want. Reference: https://imgur.com/a/bAtQchu\n\nhttps://imgur.com/a/bAtQchu", "created_at": "", "completed_at": ""}, {"path": "/@aque_48/works/2", "thumbnail_src": "https://si.imgix.net/f1035d77/uploads/origins/899e1575-85d9-4d61-9c24-da4c3c5da8bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f4d6d6ddd0b059e9032e5891da889df", "thumbnail_srcset": "https://si.imgix.net/f1035d77/uploads/origi