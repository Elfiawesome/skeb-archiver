ca1d1ed9b5aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9515ba308375e9a62ab71ba2e8e3b144, https://si.imgix.net/8126affb/uploads/origins/62cccdf4-f338-4a05-84b8-ca1d1ed9b5aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed35c3abedf5a21e2565933aa4026a2c 2x, https://si.imgix.net/8126affb/uploads/origins/62cccdf4-f338-4a05-84b8-ca1d1ed9b5aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4568e1dc77630eddaaebea5b72fca91c 3x", "genre": "art", "nsfw": false, "body": "初めまして、いつもステキなイラストを見させてもらってます。\n依頼ですが、ネオポルテ５期生の麻倉シノさんがValorantのサイファーと言うキャラクターの衣装を着ている姿を描いていただきたいです。構図はお任せしますが、顔が分かるように帽子は左手に持っていて欲しいです。\nAtisaさんに描いてもらった旨を記載し、FAタグをつけてＸに投稿したいと思ってます。その為、ご本人様の使用許可もいただきたいです。\n\n3面図とLive2D\nhttps://x.com/shino_asakura5/status/1746910650046316878?s=46&t=SuSSCpa3-ngolrQO9d2Egg\n\nhttps://x.com/nokoyama6/status/1746534286621303208?s=53&t=SuSSCpa3-ngolrQO9d2Egg\n\nValorant サイファー\nhttps://x.com/valojpnews/status/1785296332359659811?s=53&t=SuSSCpa3-ngolrQO9d2Egg", "created_at": "", "completed_at": ""}, {"path": "/@Atisa/works/3", "thumbnail_src": "https://si.imgix.net/221d48bc/uploads/origins/8b820179-f980-4318-ba41-737bdb2c98fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fdca012c302835b3ca27f1749cae4fe", "thumbnail_srcset": "https://si.imgix.net/221d48bc/uploads/origins/8b820179-f980-4318-ba41-737bdb2c98fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fdca012c302835b3ca27f1749cae4fe, https://si.imgix.net/221d48bc/uploads/origins/8b820179-f980-4318-ba41-737bdb2c98fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9c27dd7fb69216b6f4a17a1727a8d6b 2x, https://si.imgix.net/221d48bc/uploads/origins/8b820179-f980-4318-ba41-737bdb2c98fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e8306bad6cb49b8b0c69edc0e5a75ed 3x", "genre": "art", "nsfw": false, "body": "Atisa＠ご依頼募集中様\n初めまして\nアルト・アイリスと申します。\n個人Vtuberとしてデビューに向けて準備中の新人Vtuberです。\n\nAtisa＠ご依頼募集中様のイラストを見つけて一目で惹きつけるられたのでぜひ私を描いていただきたく依頼させていただきました。\n\n使用用途はキービジュアルとして\n・動画や配信での使用（サムネイル、ティザーPV、待ち受け画面）\n・デビュー前のXでの宣伝、アイコンやヘッダー\n以上のようなvtuber活動で使用させていただきたいです。\n\nキャラクターデザイン、衣装の参考資料は資料URLに貼らせていただきます\n(衣装のデザインで仕組みが分からない等があればそちらの想像で描いてもらってもかまいません)。\nポーズ、表情、背景等はAtisa＠ご依頼募集中様におまかせいたします。\n\nイメージしやすい参考設定としましては\n\nお姉さんの魅力に恵まれた女の子\n1000年以上の時を生きた「真祖系吸血鬼」だが\n血は吸うのも、見るのも嫌らしい\n一方で日光に関しては克服しており\n日光を浴びでもダルくなる程度で済むらしい\n自堕落な所があり、ゲームが大好き\n銀色の長髪は青紫の光を伴って美しく輝き\n金色の瞳は、満月の光のような美しさを持つ\n漆黒のドレスは、彼女に「吸血鬼のお嬢様」のような\n魅力をもたらしているかのよう\n\n\nあとXで＃おはようVtuber等のVtuber素材で使用できるように背景透過のキャラクターのみのpsdや画面外で切れてしまった髪や体の可能な範囲の描画をお願いしたいです。\n\nご検討いただけましたら幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/12XA31B9BlW6JeHzDq4vvplFUx9Fbs7LA/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Atisa/works/2", "thumbnail_src": "https://si.imgix.net/5b277fae/uploads/origins/a02ce5a4-7996-408f-a980-86b45a404806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc23bc04a52f2fc71e41a1e4534b01fa", "thumbnail_srcset": "https://si.imgix.net/5b277fae/uploads/origins/a02ce5a4-7996-408f-a980-86b45a404806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc23bc04a52f2fc71e41a1e4534b01fa, https://si.imgix.net/5b277fae/uploads/origins/a02ce5a4-7996-408f-a980-86b45a404806?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d32cddf7505e035b042eea146fa4a207 2x, https://si.imgix.net/5b277fae/uploads/origins/a02ce5a4-7996-408f-a980-86b45a404806?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIV