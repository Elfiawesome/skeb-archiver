21-8806a30a67bd?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7ec0e38b519a29915b1398f65c46d3c 2x, https://si.imgix.net/17af9783/uploads/origins/5b8187fd-fcdc-415a-ad21-8806a30a67bd?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ceee6bd7c589b0a351f53d2c97084250 3x", "genre": "art", "nsfw": false, "body": "あなたのピクセルアート、とっても可愛いです！私のVTuberキャラと猫のアニメーションピクセルアートを作ってくれませんか？参考画像を送信しました。表情やポーズはお任せします！私のVTuberキャラは、お姉さん的な雰囲気のくつろぎ系キャラです。お茶を飲んだりポケモンゲームをしたりするのが好きです。この作品は配信やYouTube動画で使用します、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1xrUP7URkkXdAaknv_grCtEe3jH4ReM3A", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/152", "thumbnail_src": "https://si.imgix.net/986886ba/uploads/origins/445da177-8fed-4fff-a24f-ceaabbe7cb25?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ffd923d6e77fdd6e670b4c47b805c9a1", "thumbnail_srcset": "https://si.imgix.net/986886ba/uploads/origins/445da177-8fed-4fff-a24f-ceaabbe7cb25?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ffd923d6e77fdd6e670b4c47b805c9a1, https://si.imgix.net/986886ba/uploads/origins/445da177-8fed-4fff-a24f-ceaabbe7cb25?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae8b1e662a4032aabe6e4c5171c3953a 2x, https://si.imgix.net/986886ba/uploads/origins/445da177-8fed-4fff-a24f-ceaabbe7cb25?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=db279feb40fe4824279b23488c421613 3x", "genre": "art", "nsfw": false, "body": "らぴす教授さま\n\nこんばんは！\n雨夜水澪です！\n\n教授のもちもちぴこぴこのドットがいつもかわちくて大好きです( *´꒳`*)っ🍫\nお気に入りは挨拶のぴょこぴょこです。\n\nサイズ(32×32でもそれ以外でも)、形式、構図等特に問いませんので、教授の好きなドットをおひとつ頂きたいです。\n\nリクエストが曖昧で困らせてしまったらすみません💦\n\n配信に載せても大丈夫だと大変うれしいです。\n\n何卒、ご検討のほどよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/151", "thumbnail_src": "https://si.imgix.net/889b8a19/uploads/origins/da42b10b-b569-4a3c-9181-6bf791cd49c8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=285c4ad81675b985777eda1f5e916f16", "thumbnail_srcset": "https://si.imgix.net/889b8a19/uploads/origins/da42b10b-b569-4a3c-9181-6bf791cd49c8?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=285c4ad81675b985777eda1f5e916f16, https://si.imgix.net/889b8a19/uploads/origins/da42b10b-b569-4a3c-9181-6bf791cd49c8?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=080d51ffb7a18d050bc64971587c890e 2x, https://si.imgix.net/889b8a19/uploads/origins/da42b10b-b569-4a3c-9181-6bf791cd49c8?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=103aebd7f0c40e3fc6cfefe68c0fa4f1 3x", "genre": "art", "nsfw": false, "body": "らぴすさまのドット絵がとてもだいすきなので再度ご依頼いたします！\n\nーーー\n🔽依頼内容\n・Valorantのマップ隠し\n└マップ隠しがわかりかねる場合、詳細はGoogleドライブをご確認ください。\n・サイズはお任せいたしますが、円でお願いいたします。\n・らぴすさまのご自由に描いていただけますとうれしいです！\nーーー\n🔽納品ファイルの形式\nおまかせ\nーーー\n🔽使用用途\n・Valorantランク配信の際に左上にマップ隠しとして使用させていただきます。\nーーー\n※お値段が足りない場合、再送お願いいたします。\nーーー\n🔽参考立ち絵、URL\nhttps://drive.google.com/drive/u/0/folders/1rUbisyUJbXkAA3Z-IsQ0g9WFMgvgaHQ6\n\nご多忙の中大変恐れ入りますが、ご検討いただけますと幸いです。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/150", "thumbnail_src": "https://si.imgix.net/cb18ab83/uploads/origins/c7419bd6-64a1-4b81-862a-4499869ad082?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e20f49f9c9e32e9b97abfa1d7649b57", "thumbnail_srcset": "https://si.imgix.net/cb18ab83/uploads/origins/c7419bd6-64a1-4b81-862a-4499869ad082?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e20f49f9c9e32e9b97abfa1d7649b57, https://si.imgix.net/cb18ab83/uploads/origins/c7419bd6-64a1-4b81-862a-4499869ad082?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63368241453793e21ffa05f307d42ede 2x, https://si.imgix.net/cb18ab83/uploads/origins/c7419bd6-64a1-4b81-862a-4499869ad082?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b9d9caa286f50d863fdd2df2edbe149 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/149", "thumbnail_src": "https://si.imgix.net/e8ae6729/uploads/origins/39fe7005-6e78-44c9-abf5-7d5a90488478?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=740179a6e3e741dea755ce2033e29473", "thumbnail_srcset": "https://si.imgix.net/e8ae6729/uploads/origins/39fe7005-6e78-44c9-abf5-7d5a90488478?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=740179a6e3e741dea755ce2033e29473, https://si.imgix.net/e8ae6729/uploads/origins/39fe7005-6e78-44c9-abf5-7d5a90488478?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=18b94cc36d29a3c759c59be97bb4879d 2x, https://si.imgix.net/e8ae6729/uploads/origins/39fe7005-6e78-44c9-abf5-7d5a90488478?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ade136617651408349ff6a58c5e76ed 3x", "genre": "art", "nsfw": false, "body": "らぴすさんいつもいつもお世話になっております🦁🐾\n今回はtwitchエモートのRAID用スタンプを作って頂きたく依頼させて頂きました…！\nお忙しい中すみませぬがよろしくお願い致します💜", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/148", "thumbnail_src": "https://si.imgix.net/6e92449e/uploads/origins/b7703586-397a-4e84-84c8-9ccffc5fae79?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=647aee03db79c857dee127f2d89ccb01", "thumbnail_srcset": "https://si.imgix.net/6e92449e/uploads/origins/b7703586-397a-4e84-84c8-9ccffc5fae79?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=647aee03db79c857dee127f2d89ccb01, https://si.imgix.net/6e92449e/uploads/origins/b7703586-397a-4e84-84c8-9ccffc5fae79?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa1c39ae01c3ca3c843a9e044b7e6cf0 2x, https://si.imgix.net/6e92449e/uploads/origins/b7703586-397a-4e84-84c8-9ccffc5fae79?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=76ac137865362655fe6255d8e21f2c9b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！あなたのアニメーションはどれも可愛くてよくできていて、一ついただけたら本当に嬉しいです～FPSゲーム『VALORANT』の銃を持った私のオリジナルキャラクター（OC）のアニメーションを作成していただけませんか？同じゲームの短剣を持っているバージョンもお願いします！！銃と短剣については、赤い要素ではなく、私のOCのデザインに合うように淡いパステル調の紫色にしてください！！ 構図の詳細はご自由に決めていただいて構いませんが、ストリーミング用にアニメーションを見せたいです。もし可能なら、背景が透明なバージョンもいただけると嬉しいです～本当にありがとうございます！このリクエストが楽しみです ^o^)\n\nOC参考画像: https://drive.google.com/drive/folders/1xd3OmPcXJZDVUn6_YtQrdovjw8RxV6g7?usp=sharing\nVALORANTの銃と短剣の参考画像: https://drive.google.com/drive/folders/1bzwCU7_rV21U8iHbboP3_cE8QXoHnKrL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/147", "thumbnail_src": "https://si.imgix.net/ebc3cf91/uploads/origins/424e13d6-e340-44f8-bbd8-26e8ab488363?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=edd140426cd7f5dc7834f5db7b67b2b7", "thumbnail_srcset": "https://si.imgix.net/ebc3cf91/uploads/origins/424e13d6-e340-44f8-bbd8-26e8ab488363?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=edd140426cd7f5dc7834f5db7b67b2b7, https://si.imgix.net/ebc3cf91/uploads/origins/424e13d6-e340-44f8-bbd8-26e8ab488363?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=608865d458af4cd99d45a03e656b119a 2x, https://si.imgix.net/ebc3cf91/uploads/origins/424e13d6-e340-44f8-bbd8-26e8ab488363?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=5728aa3a77c630abf5f267331357fa6c 3x", "genre": "art", "nsfw": false, "body": "らぴす教授🍮様\n初めてご連絡させていただきます。\nVtuberの閏もああと申します。\n現在スーパーマリオワールドのゲーム実況動画を投稿しているのですがサムネに置いても違和感のないドット絵(らぴす教授🍮様アイコンくらいのデフォルメが希望です)を作っていただけないかと思いご連絡させていただきました。\n\n作成して頂きたいのは閏もああで細かい装飾は省略して下さい。\nほぼほぼチビマリオがサムネになるので合わせたサイズでお願いします。\nバリエーションを作成頂けるのであれば、横向き歩き、ジャンプと滑空、しゃがみ、のマリオと同じ基本動作（正面とゲームオーバーは不要です）があると嬉しいです。\n難しければ横向きのジャンプ（もしくは滑空）のみお願いします。\n\n使用用途はマリオやドット絵のゲーム実況動画と切り抜きのショート動画への使用を予定しております。\n金額等見合わないようでしたらキャンセルをお願いします。\n\nお忙しい中大変恐縮ですがご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/1fnlQ_pCbmDDrtYTI8Hkic4upXe4SZk0O/view?usp=drive_link\n\nhttps://hub.vroid.com/characters/3374724459955893908/models/2281796907877717259", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/146", "thumbnail_src": "https://si.imgix.net/aa1ef19d/uploads/origins/8659ed3f-54a4-491a-84c9-93e6d6440a08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7831ac546c0ab7f78162f22334204f3d", "thumbnail_srcset": "https://si.imgix.net/aa1ef19d/uploads/origins/8659ed3f-54a4-491a-84c9-93e6d6440a08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7831ac546c0ab7f78162f22334204f3d, https://si.imgix.net/aa1ef19d/uploads/origins/8659ed3f-54a4-491a-84c9-93e6d6440a08?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d9f9e72e9f5001c6c1866a63fb0d5e5 2x, https://si.imgix.net/aa1ef19d/uploads/origins/8659ed3f-54a4-491a-84c9-93e6d6440a08?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e5a9e7123de6d29b86afe1226f61796 3x", "genre": "art", "nsfw": false, "body": "らぴす教授🍮様\n初めまして。\n新着イラストにてお見かけしました。\n作品を色々と見させていただきまして、\nドット絵でありながら滑らかで\n細やかな表現が素敵だと感じまして、\n依頼させていただきました。\n\n今回描いていただきたいのは\nVtuberの上月みやこさんです。\n\nチョコレートをモリモリ食べている様子を\n描いていただきたいです。\n\nらぴす教授🍮様の好きな構図で描いていただければと思います。\n\n可能であれば差分もお願いします。\n\n用途としましては、\n自身の動画で使用したり、\nVtuberの上月みやこさんへの\nプレゼントを予定しております。\nなので配信のサムネイル及び\n配信画面での使用の許可をいただきたいです。\n\n以上になります。\nぜひご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1RNbqDqUIioQtbRQkcpZCKBfklslCq2q0", "created_at": "", "completed_at": ""}, {"path": "/@RPS_dot/works/145", "thumbnail_src": "https://si.imgix.net/f085dfc2/uploads/origins/8ddd1efe-e644-4f56-b4a4-85525e6fbde9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fd2773816150ff29f34d6ca7897f57a7", "thumbnail_srcset": "https://si.imgix.net/f085dfc2/uploads/origins/8ddd1efe-e644-4f56-b4a4-85525e6fbde9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fd