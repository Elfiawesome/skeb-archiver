, https://si.imgix.net/75d6883a/requests/221929_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e42d26291156890728132e1c5e6c9882 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@I_yukiru/works/8", "thumbnail_src": "https://si.imgix.net/109c1430/requests/161139_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c82095e2dccd8328b15e74502a5f82a2", "thumbnail_srcset": "https://si.imgix.net/109c1430/requests/161139_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c82095e2dccd8328b15e74502a5f82a2, https://si.imgix.net/109c1430/requests/161139_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f3805289480aeabb3e575eca289b6b0 2x, https://si.imgix.net/109c1430/requests/161139_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ec85b1e7eed32370218753a7fdc658d 3x", "genre": "art", "nsfw": true, "body": "はじめまして、同人誌やキルタイムの漫画で楽しませていただいております。\nミストトレインガールのパンツちゃんことパンクラスちゃんで輪姦シチュをリクエストしたいと思います。\n\n・SSのドレス衣装半裸\n・騎乗位パンツずらし挿入\n・頭を掴んでのイラマチオ\n・長い髪を男性器に巻き付けての強制手コキ\n・背後から胸元の服をずり下げてそれぞれ胸揉み、乳首責め\n・嫌悪感たっぷりの表情\n\n擬音等はお任せします。\n可能であれば射精差分をお願いできればと思います。\n色々と注文してしまいましたがご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@I_yukiru/works/7", "thumbnail_src": "https://si.imgix.net/41bb508a/requests/154578_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40524268c77944e433d56a4bf2f8b940", "thumbnail_srcset": "https://si.imgix.net/41bb508a/requests/154578_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40524268c77944e433d56a4bf2f8b940, https://si.imgix.net/41bb508a/requests/154578_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b42a2212b21bfc6165350bc3c9927ed3 2x, https://si.imgix.net/41bb508a/requests/154578_0?bg=%23fff&a