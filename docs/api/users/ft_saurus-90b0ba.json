-4107-9cb0-237988bb7e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e172fa0aae15d7986b758303377319f1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ft_saurus/works/27", "thumbnail_src": "https://si.imgix.net/2c0c5b2e/uploads/origins/1c0c34c3-f1f1-4d3d-97da-964ae9fef08c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e088dd6f171a11b0d82642f18817c11c", "thumbnail_srcset": "https://si.imgix.net/2c0c5b2e/uploads/origins/1c0c34c3-f1f1-4d3d-97da-964ae9fef08c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e088dd6f171a11b0d82642f18817c11c, https://si.imgix.net/2c0c5b2e/uploads/origins/1c0c34c3-f1f1-4d3d-97da-964ae9fef08c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5efd3fa3f5e900940ec40b09924ddcfb 2x, https://si.imgix.net/2c0c5b2e/uploads/origins/1c0c34c3-f1f1-4d3d-97da-964ae9fef08c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e9fc8a453f75ac770ff21c46bf4e9bf 3x", "genre": "art", "nsfw": true, "body": "初めまして。こんにちは。早速で恐縮なのですが、ゼンレスゾーンゼロのルーシーとパイパーのふたなりイラストをお願いしても宜しいでしょうか。\nここから依頼内容と併せて推測を語っていくのですが、ルーシーの育成画面で見せる指ハートは彼女のちんちんのサイズを示唆していると私は考えていて、それくらいのミニサイズかなと。ただ、短小ちんちんだとしても、あれほどのパツパツキツキツパンツだとかなり窮屈で蒸れると思います。ベルトを緩め、粗ちんを外気に当てる様子が日常にあってもおかしくないと思いますし、同じようなパツパツキツキツパンツのパイパーも同じようにちんちんを除湿しているのではないかと考えています。ルーシーはお嬢様ですから他人の前で恥部を見せるなんてはしたないと言うかもしれませんが、気持ち良さそうに除湿しているパイパーを見て蒸れるちんちんには逆らえず二人で一緒に除湿。こういったイラストをお願いします。パイパーのサイズはまだ示唆されていると思われるものが見当たらないためお任せいたします。パイパンだとは思います。\n長々と申し訳ありませんが以上が依頼になります。お忙しいと思いますが是非ともよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ft_saurus/works/26", "thumbnail_src": "https://si.imgix.net/ccf4e245/uploads/origins/7c3beb7f-ec2b-46b2-940f-040835fc1cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86f4229b112fd9aae27565ea39c91087", "thumbnail_srcset": "https://si.imgix.net/ccf4e245/uploads/origins/7c3beb7f-ec2b-46b2-940f-040835fc1cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86f4229b112fd9aae27565ea39c91087, https://si.imgix.net/ccf4e245/uploads/origins/7c3beb7f-ec2b-46b2-940f-040835fc1cce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4842f96ffc599188a43a4e14fbd01117 2x, https://si.imgix.net/ccf4e245/uploads/origins/7c3beb7f-ec2b-46b2-940f-040835fc1cce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fb539555c2f152d9939d4dfe5a3f322 3x", "genre": "art", "nsfw": true, "body": "モノクロ仕上げで構いませんのでゆうちゃんのマイクロビキニちんちんはみ出し絵をお願いできませんか？\n\nビキニからやや小さめのちんちんがはみ出している姿が見られれば満足なので背景なども省いていただいても問題ないです\n\nシチュもお任せで良いのですが\n思いついたの適当に描いておきます\nこの中から選んで頂かなくても問題ないです\n・Tシャツなど上に着ていた物を脱いで着替え中にボロン\n・（理由はおいておいて）水着で遊んでいる最中に若干勃起してしまい指摘されて恥じらう\n・鏡の前でセクシーポーズを取る（脈絡はないですがはみだしふたなりちんちんが見たいのでポロリはさせる）\n\n気が向きましたらお受け頂けると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@ft_saurus/works/25", "thumbnail_src": "https://si.imgix.net/71ec7789/uploads/origins/4f984be5-b827-4625-91ae-8b1105a2de45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=615493a6ab44ff4d3123f441e31c4018", "thumbnail_srcset": "https://si.imgix.net/71ec7789/uploads/origins/4f984be5-b827-4625-91ae-8b1105a2de45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=615493a6ab44ff4d3123f441e31c4018, https://si.imgix.net/71ec7789/uploads/origins/4f984be5-b827-4625-91ae-8b1105a2de45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42189b7d4f1140ac392d219605ac3756 2x, https://si.imgix.net/71ec7789/uploads/origins/4f984be5-b827-4625-91ae-8b1105a2de45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=584f9a9937fb65444c07763f073e3fb2 3x", "genre": "art", "nsfw": true, "body": "久々の依頼になります。\n今回たまたまTwitterで見かけたキャラが刺さったので先生にリクエストしました。\n\n・キャラ\n鬼堂魔美(▲学館コ●コ●連載中のももいろ討鬼伝モモタロウくん・URL参照)\nURL①→https://www.pixiv.net/artworks/48831573\nURL②→https://www.pixiv.net/artworks/48720661\n※この2枚から制服スカートの両腰側に一部網状のものがあると分かります。\n\n・シチュ\n鬼に金棒(意味深)ということでふたなりネタです。スカートの中でテントを立ててる4枚をお願い致します。\n①通常時(ボッキしていない)\n②ボッキ時(成人男性サイズくらい)\n③ボッキ時(かなり大きい。スカートテントが生地を引っ張っており破ける寸前)\n④ボッキ時(スカートテント突き破り+射精)\n\n構図は正面全身、表情はオホ顔以外でお願い致します。その他指定のない部分は先生にお任せしたいと思います。\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ft_saurus/works/24", "thumbnail_src": "https://si.imgix.net/949d0bc3/uploads/origins/31a5bf46-67cc-4be6-baef-6db487bcf849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=587a26715749ae042a878f2ad60c729f", "thumbnail_srcset": "https://si.imgix.net/949d0bc3/uploads/origins/31a5bf46-67cc-4be6-baef-6db487bcf849?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=587a26715749ae042a878f2ad60c729f, https://si.imgix.net/949d0bc3/uploads/origins/31a5bf46-67cc-4be6-baef-6db487bcf849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03c6641e27ee23fbf9ab91e2f8e27edd 2x, https://si.imgix.net/949d0bc3/uploads/origins/31a5bf46-67cc-4be6-baef-6db487bcf849?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0b979e2e1ab62c27c3aa8947bb001b2 3x", "genre": "art", "nsfw": true, "body": "ふたなりの北上麗花に後ろからアナルを犯され、胸をいじられながら手コキされて何度もイカされる真壁瑞希をお願いします。\n瑞希は目を閉じた表情で無理矢理イカされてる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ft_saurus/works/23", "thumbnail_src": "https://si.imgix.net/68f24e89/uploads/origins/0572193f-edfc-48c8-8631-6e01be4d4ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffcb13b942d587149e47426af676f0df", "thumbnail_srcset": "https://si.imgix.net/68f24e89/uploads/origins/0572193f-edfc-48c8-8631-6e01be4d4ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffcb13b942d587149e47426af676f0df, https://si.imgix.net/68f24e89/uploads/origins/0572193f-edfc-48c8-8631-6e01be4d4ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab338354476f9a4ce7d479bdaf61816c 2x, https://si.imgix.net/68f24e89/uploads/origins/0572193f-edfc-48c8-8631-6e01be4d4ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=219e8c5293bb261bb9c8f1cc375c0f29 3x", "genre": "art", "nsfw": true, "body": "以前ふたなり金髪ギャルのかりんちゃんを依頼した者です。\n次の内容でリクエスト依頼します。\n\n(構図)\n・かりんちゃんは正座の体勢で座っていて、複数の男から精液をぶっかけられている(男の姿は不要です。画面端から精液が飛んでる感じ)\n・かりんちゃんは資料の制服ネクタイとスカート(ヒダが少ないタイプ)だけの姿\n・かりんちゃんが興奮して勃起した時はスカートの中でテントを立てている\n・可能であればかりんちゃんの勃起前、勃起中、大量射精中、大量射精後もあると嬉しいです\n\nこの上記4点以外は特に指定はありません。\n何卒よろしくお願い致します。\n\nhttps://seifukudoncky.com/shopdetail/000000060416/", "created_at": "", "completed_at": ""}, {"path": "/@ft_saurus/works/22", "thumbnail_src": "https://si.imgix.net/c6a687ac/uploads/origins/e177334c-945c-49ae-95b3-44608c9aa622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bfcd7ea6c4d38df6e7ebb3bb5ee3712", "thumbnail_srcset": "https://si.imgix.net/c6a687ac/uploads/origins/e177334c-945c-49ae-95b3-44608c9aa622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bfcd7ea6c4d38df6e7ebb3bb5ee3712, https://si.imgix.net/c6a687ac/uploads/origins/e177334c-945c-49ae-95b3-44608c9aa622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6f2833c0e2839b4226992e51046fc92 2x, https://si.imgix.net/c6a687ac/uploads/origins/e177334c-945c-49ae-95b3-44608c9aa622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e380da6746cb21250f3164861bdc0182 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ft_sauru