。表情やポーズはご自由に決めてください。ポーズに合うと思うなら、ショートヘアでもロングヘアでも問題ありません！重要なデザインポイント：口の中と舌はピンクではなくシアン（青緑）です。イラストはSNS、YouTube、Twitchで使用します。\n\nhttps://drive.google.com/drive/folders/1Po9C498sfakMX5Z9lgNm-yAaS3pRmQqQ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@wwma28/works/10", "thumbnail_src": "https://si.imgix.net/e17a78d0/uploads/origins/9dc0fbf5-9a19-40c3-96fd-b15131f98619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87c13dc8f5e9eafd7d85890ef0031eb2", "thumbnail_srcset": "https://si.imgix.net/e17a78d0/uploads/origins/9dc0fbf5-9a19-40c3-96fd-b15131f98619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87c13dc8f5e9eafd7d85890ef0031eb2, https://si.imgix.net/e17a78d0/uploads/origins/9dc0fbf5-9a19-40c3-96fd-b15131f98619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3acb8740f5ba0ae4d4aff3926e711fb7 2x, https://si.imgix.net/e17a78d0/uploads/origins/9dc0fbf5-9a19-40c3-96fd-b15131f98619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44a46a619670f6caced32e9693b2c0ff 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@wwma28/works/9", "thumbnail_src": "https://si.imgix.net/6b960fcb/uploads/origins/7580432e-b959-4e24-b70c-5ccbb098bd97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d45115f371712f2c70e353bcaf44ae2", "thumbnail_srcset": "https://si.imgix.net/6b960fcb/uploads/origins/7580432e-b959-4e24-b70c-5ccbb098bd97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d45115f371712f2c70e353bcaf44ae2