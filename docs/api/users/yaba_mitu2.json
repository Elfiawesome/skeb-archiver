6c4cd7b985 2x, https://si.imgix.net/f30a143e/uploads/origins/1f3dfbc5-3b8f-4068-a431-6725c285ff11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e3b5b39579484ededa0e4ce08a8ed0ce 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/36", "thumbnail_src": "https://si.imgix.net/724525b8/uploads/origins/7d238443-70db-4808-97f1-6053c9ba69ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74f73972e680361ec630961e848fd11f", "thumbnail_srcset": "https://si.imgix.net/724525b8/uploads/origins/7d238443-70db-4808-97f1-6053c9ba69ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74f73972e680361ec630961e848fd11f, https://si.imgix.net/724525b8/uploads/origins/7d238443-70db-4808-97f1-6053c9ba69ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b371bbb81fe2acb1185e7e795351af0f 2x, https://si.imgix.net/724525b8/uploads/origins/7d238443-70db-4808-97f1-6053c9ba69ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18383840d74102d8a748125b5851919a 3x", "genre": "art", "nsfw": true, "body": "また会ったね！\n\n私はあなたが私のためにしてくれたすべての以前の作品が本当に大好きでした！\n\nまた私のマンタの女の子を描いてくれませんか？\n\n今回は新しい人間のデザインです：\nhttps://files.catbox.moe/ul4z2b.png\nhttps://files.catbox.moe/ky9djp.png\n\n彼女が新しい武器（銃とMP7）でエイリアンの怪物と戦うシーンを描いてほしい。\n\nエイリアンの敵のデザインはあなた次第ですが、触手があれば最高です。\n\n舞台は地下鉄やオフィスビルなど、お好きな都市環境を選んでください。\n\n戦いの最中、彼女は少し怪我をし、服も傷んでしまう。\n\n可能であれば、ダメージを受けたショーツやパンティから尻尾が生え始め、まるで怪獣の姿に変身して戦いを続けるかのようなシーンやバリエーションを別途用意してほしい。\n\nhttps://files.catbox.moe/c4v7au.png\nhttps://files.catbox.moe/smcous.png\nhttps://files.catbox.moe/r7pa70.png\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/35", "thumbnail_src": "https://si.imgix.net/f91a44ee/uploads/origins/b2fa6158-f7f5-4841-9065-ac1840ae9d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aea8a0e8ffc5301d3eb4c9e21620911e", "thumbnail_srcset": "https://si.imgix.net/f91a44ee/uploads/origins/b2fa6158-f7f5-4841-9065-ac1840ae9d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aea8a0e8ffc5301d3eb4c9e21620911e, https://si.imgix.net/f91a44ee/uploads/origins/b2fa6158-f7f5-4841-9065-ac1840ae9d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b563dbd8f65795593275aeffeaa1953 2x, https://si.imgix.net/f91a44ee/uploads/origins/b2fa6158-f7f5-4841-9065-ac1840ae9d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1d122d46b980609adcda6a07317850c 3x", "genre": "art", "nsfw": true, "body": "私のツイッターアイコン(https://pbs.twimg.com/profile_images/1073575089671593985/QWzE7sh_.jpg)のキャラ、ルークが、一口サイズくらいのサイズ感で、そちらのアルクさんに丸呑みにされてしまい、生きたままお尻から出されてしまう作品をお願いします\n丸呑みは、翼を摘まれて持ち上げられて口に運ばれている様子\n口に入れてしまいもぐもぐな様子\n飲み込まれてしまう様子\nお腹に入れられてしまった様子\nを体内の様子を吹き出しで…といった形でお願いしたいと思います\nお尻から出すところは捕食者さんのお腹が鳴って排泄が近い様子\n捕食者さんが踏ん張って排泄している様子\n排泄を終えてすっきりな捕食者さんと排泄されてぐったりなルークという感じでお願いしたいです\nお尻から出されるまでにたっぷり時間を掛けたような描写があると嬉しいです(数日後…と書く等)\nまた、ツイートによる紹介を許可頂きたく思います\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/34", "thumbnail_src": "https://si.imgix.net/cebf948c/uploads/origins/dd6bea70-78dc-4fd2-b5f2-86829c0a2d35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bcd0cd70adf8c980c52e17aec474368", "thumbnail_srcset": "https://si.imgix.net/cebf948c/uploads/origins/dd6bea70-78dc-4fd2-b5f2-86829c0a2d35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bcd0cd70adf8c980c52e17aec474368, https://si.imgix.net/cebf948c/uploads/origins/dd6bea70-78dc-4fd2-b5f2-86829c0a2d35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bd0744be167ebd9b102a5d716de7ebe 2x, https://si.imgix.net/cebf948c/uploads/origins/dd6bea70-78dc-4fd2-b5f2-86829c0a2d35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=687478a2c4b6d32dc47ccffeb978b8aa 3x", "genre": "art", "nsfw": true, "body": "こんにちは！もう一枚写真をお願いします。この写真にはワニの女の子とオオカミの友達が写っています。ビーチでセックスしている写真です。ワニの女の子は日焼けするためにタオルの上に横たわって、彼女の腹の上にいる。\n\nオオカミ少女は彼女の上に乗ってセックスしている。ワニの女の子は、自分の日焼けが欲望にまみれたオオカミに邪魔されたことに苛立っているように見えるだろうが、それでも彼女は楽しんでいるはずだ！できれば、ワニ娘に日焼けラインをお願いします！ありがとうございました！\n\nオオカミ少女参考：https://drive.google.com/drive/folders/13uxnwFcNOUNfmV_G9cD1az0P4Pmcwdm5\n\nhttps://drive.google.com/drive/folders/1m9U32tYoDlztUYdjNuodOsZl6l2WBsT_?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/33", "thumbnail_src": "https://si.imgix.net/42c7eb3f/uploads/origins/dafd55cc-abc2-4880-a4f9-6221d49e0606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8bcaadb420adf707e915dccb3942306", "thumbnail_srcset": "https://si.imgix.net/42c7eb3f/uploads/origins/dafd55cc-abc2-4880-a4f9-6221d49e0606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8bcaadb420adf707e915dccb3942306, https://si.imgix.net/42c7eb3f/uploads/origins/dafd55cc-abc2-4880-a4f9-6221d49e0606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60005677f835736575686ce3d90b3346 2x, https://si.imgix.net/42c7eb3f/uploads/origins/dafd55cc-abc2-4880-a4f9-6221d49e0606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cfc37891139dbbbde6f2e29589ac08f 3x", "genre": "art", "nsfw": true, "body": "可能であれば、オルガというキャラクターをリクエストしたい。\n\nhttps://files.catbox.moe/hw3x2s.png\nhttps://files.catbox.moe/23r9yi.png\nhttps://files.catbox.moe/u11d71.png\nhttps://files.catbox.moe/pahxrb.png\n\nオルガは身長135cmで巨乳\n\nできれば全裸で、得意げに、いたずらっぽい表情で立っていてほしい。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/32", "thumbnail_src": "https://si.imgix.net/69fbbdbc/uploads/origins/2c770564-c2c1-458c-9ca1-5b12e8b7d1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e939812d6a2682560f9176ca8c07b97d", "thumbnail_srcset": "https://si.imgix.net/69fbbdbc/uploads/origins/2c770564-c2c1-458c-9ca1-5b12e8b7d1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e939812d6a2682560f9176ca8c07b97d, https://si.imgix.net/69fbbdbc/uploads/origins/2c770564-c2c1-458c-9ca1-5b12e8b7d1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25ab49003cf2aedf8e6913635aec90a8 2x, https://si.imgix.net/69fbbdbc/uploads/origins/2c770564-c2c1-458c-9ca1-5b12e8b7d1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97cef046ecce08227536dd566451de6c 3x", "genre": "art", "nsfw": false, "body": "やばみつさん、こんにちは！\nあなたのイラストは本当にかっこいいですね！私の怪獣キャラでお願いします。\n\nかわいいドラゴンの男の子は「イジ」、ゴスなリバイアサンの女の子は「レヴィ」という名前です。\nイジ - https://drive.google.com/drive/folders/1rAMoRFIApnb5fslvlEhY-dJ15E1RMRld?usp=sharing\nレヴィ - https://drive.google.com/drive/folders/1NXblFtBkgBaJkHSzdy2xKm9O4m6Z9Gd2?usp=sharing\n\nこのシーンでは、二人は街でくつろいでいる。イジはレヴィの膝の上に座り、腕を彼の腰にぴったりと巻き付けている。イジはアイスクリームトラックを手のひらに乗せ、アイスクリームコーンを2つ注文している。レヴィの巨大なスケートボードはビルに寄りかかり、彼女の興奮した尻尾も破壊を引き起こしている。天気は良く、青空と時折ふわふわした雲が見える。あとはあなたにお任せします！", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/31", "thumbnail_src": "https://si.imgix.net/a2f3ddcf/uploads/origins/388dc681-df50-4f42-b802-7e70b57c8a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af55e5612e3e495756c22fe12fc9b3ab", "thumbnail_srcset": "https://si.imgix.net/a2f3ddcf/uploads/origins/388dc681-df50-4f42-b802-7e70b57c8a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af55e5612e3e495756c22fe12fc9b3ab, https://si.imgix.net/a2f3ddcf/uploads/origins/388dc681-df50-4f42-b802-7e70b57c8a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d21debc36401ccf8f99486c5a53f6c0f 2x, https://si.imgix.net/a2f3ddcf/uploads/origins/388dc681-df50-4f42-b802-7e70b57c8a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c1c2989a0207a071126e455fac9d821 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/30", "thumbnail_src": "https://si.imgix.net/304ca65c/uploads/origins/d91cf5a8-20ff-43a4-879f-0b1cf0d78126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5214d3240bbb9737f1971b56f2829e", "thumbnail_srcset": "https://si.imgix.net/304ca65c/uploads/origins/d91cf5a8-20ff-43a4-879f-0b1cf0d78126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a5214d3240bbb9737f1971b56f2829e, https://si.imgix.net/304ca65c/uploads/origins/d91cf5a8-20ff-43a4-879f-0b1cf0d78126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d5e6b25aac2c05bc9319cfa2f63b966 2x, https://si.imgix.net/304ca65c/uploads/origins/d91cf5a8-20ff-43a4-879f-0b1cf0d78126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2015d896366c9ef7f661fbfe8b6a3af 3x", "genre": "art", "nsfw": true, "body": "こんにちは！以前描いていただいた作品が大好きでした。最近、私のワニの女の子をデザインし直したので、また描いてほしいんです。彼女は疲れた目をしていて、体には鱗があり、尻尾は太い。彼女は時々タバコも吸います。\n\n裸でデスクトップパソコンの前に座っている彼女を描いてください。パソコンでポルノを見てオナニーしている彼女を描いてください。彼女は一人なので、クールに振る舞って欲情的に見せる必要はありません。\n\n残りの構図はお任せします。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1m9U32tYoDlztUYdjNuodOsZl6l2WBsT_", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/29", "thumbnail_src": "https://si.imgix.net/1a388650/uploads/origins/a4101864-844d-453b-8216-a897335b5a01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6366495eaa19fdbbe066d9f72a9c047", "thumbnail_srcset": "https://si.imgix.net/1a388650/uploads/origins/a4101864-844d-453b-8216-a897335b5a01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6366495eaa19fdbbe066d9f72a9c047, https://si.imgix.net/1a388650/uploads/origins/a4101864-844d-453b-8216-a897335b5a01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=decc31edca45f0a02b9a0a19bce08b00 2x, https://si.imgix.net/1a388650/uploads/origins/a4101864-844d-453b-8216-a897335b5a01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59583a84fe4778d602df2af38ecaf585 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/28", "thumbnail_src": "https://si.imgix.net/a0262b74/uploads/origins/f3453db9-969b-4159-965d-1ebb2c1273b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26f6f0393c4c5230fddccdacbe1023cc", "thumbnail_srcset": "https://si.imgix.net/a0262b74/uploads/origins/f3453db9-969b-4159-965d-1ebb2c1273b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26f6f0393c4c5230fddccdacbe1023cc, https://si.imgix.net/a0262b74/uploads/origins/f3453db9-969b-4159-965d-1ebb2c1273b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ea1b4bc88689daa77d571adb263d325 2x, https://si.imgix.net/a0262b74/uploads/origins/f3453db9-969b-4159-965d-1ebb2c1273b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f772e2b4d59844984755f08592f0de8e 3x", "genre": "art", "nsfw": true, "body": "こんにちは、はじめまして。もしよろしければ、私のゴブリンキャラクターを3人リクエストしてもよろしいでしょうか？\n\nパンドラ：白い髪のゴブリン。身長132センチ。内気で繊細で優しい。もともとは人間だったが、ゴブリンとして幸せに暮らしている。\nhttps://drive.google.com/drive/folders/1OOTwkQdAK5Bg1srE7_275t8hJo82cq0d\n\nリコリア：黒髪のゴブリン。身長138cm。厳格で真面目だが、優しい一面も。パンドラを妹のように可愛がる。ゴブリンの頭領。\nhttps://drive.google.com/drive/folders/1KRBwt4nMqtuHXhDBAurLr041s6cOo2qz?usp=sharing\n\nスミレ：金髪のゴブリン。身長120センチ。パンドラと同じく元は人間。他のゴブリンになじめないと感じている。\nhttps://drive.google.com/drive/folders/1bl97uppq95VrDykLMHp_3EubZBuFqoqU?usp=drive_link\n\n温泉でお願いします。すみれは真ん中で、他のゴブリンにもみくちゃにされて恥ずかしそうにしています。お願いを聞いてくれてありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/27", "thumbnail_src": "https://si.imgix.net/96bcbc92/uploads/origins/33ce0088-e7f5-4d5a-be2a-d056a329bba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d232c10a06508a43610da4bf3bace20", "thumbnail_srcset": "https://si.imgix.net/96bcbc92/uploads/origins/33ce0088-e7f5-4d5a-be2a-d056a329bba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d232c10a06508a43610da4bf3bace20, https://si.imgix.net/96bcbc92/uploads/origins/33ce0088-e7f5-4d5a-be2a-d056a329bba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=358e5d58bc33136514dac802b7c1bb24 2x, https://si.imgix.net/96bcbc92/uploads/origins/33ce0088-e7f5-4d5a-be2a-d056a329bba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14b74cd571f1e92adc83491c15693950 3x", "genre": "art", "nsfw": true, "body": "こんにちは。このキャラクターを別のシーンで描いてもらえますか？\n\n(レイン)\nhttps://drive.google.com/drive/folders/1x1JELmVE2QBdi3USIQI_sCCmO82oFIac\n\n（ヴィオラ）\nhttps://drive.google.com/drive/folders/1_j8hPUvUMXs6cDp10CrxZJro3DcAmoxS\n\nヴァイオラが大きなプレゼントを開けるシーンで、中にはレインが入っている。レインは裸のリボンの衣装で、必ずしもきちんと結ばれているわけではないが、彼女の敏感な部分をカバーしている。照れ笑いを浮かべている。ヴァイオラにしてみれば、がっかりしたような、ショックを受けたような、呆れたような表情で開けられたプレゼントを見下ろしている。具体的には、顔の上部が薄暗くなり、言葉を失っている。また、ヴィオラの服装については、普段着である必要はない。着心地のいい室内着でもいい。\n\nディテールの追加やチャンスは自由に楽しんでください。ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/26", "thumbnail_src": "https://si.imgix.net/8406121f/uploads/origins/bfb47042-1002-4a88-9309-02f9198048f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b439d6d2705a98e6ea6f3ed07d265dd", "thumbnail_srcset": "https://si.imgix.net/8406121f/uploads/origins/bfb47042-1002-4a88-9309-02f9198048f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b439d6d2705a98e6ea6f3ed07d265dd, https://si.imgix.net/8406121f/uploads/origins/bfb47042-1002-4a88-9309-02f9198048f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74b6ec944fa603d03037049651e81072 2x, https://si.imgix.net/8406121f/uploads/origins/bfb47042-1002-4a88-9309-02f9198048f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=587a8f5b6672b17699b6ebb6b9ec4f45 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ワニの女の子とオオカミの女の子との続きの画像をお願いしたいです。\n\nこの画像は背景が同じで、前の画像が終わった後に何が起こったかを含みます。ワニの女の子は温泉の縁で犬のような体勢になっています。\n\nワニの女の子は淫らな表情をしており、オオカミの女の子はドヤ顔をしている。二人とも大きなペニスを持っていて、オオカミ少女はずっと大きなペニスでワニ少女のアソコを犯している。\n\n狼少女はワニ少女の周りに手を伸ばし、彼女のペニスを撫でながら、狼少女はワニ少女を後ろから犯している。\n\nオオカミ少女が尻尾を振って大きなお尻を見せながらワニ少女とファックしている後ろからの視点の別のアングルを入れることができれば、それも素晴らしいだろうが、それは必須ではない。\n\nメリークリスマス！\nオオカミ少女 参照：https://drive.google.com/drive/folders/1znFnTdyyYz5-Nge9g3vf9nIjQlTWcWWj?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1NlEDEHCzXJOLVhZ4_dNKF5lAV6N4lzSV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/25", "thumbnail_src": "https://si.imgix.net/63b9f8c6/uploads/origins/14c732cb-5d00-4397-a3b0-462be5b0faab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d48775dcd39cad2d4d383e95a2454ee", "thumbnail_srcset": "https://si.imgix.net/63b9f8c6/uploads/origins/14c732cb-5d00-4397-a3b0-462be5b0faab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d48775dcd39cad2d4d383e95a2454ee, https://si.imgix.net/63b9f8c6/uploads/origins/14c732cb-5d00-4397-a3b0-462be5b0faab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31cd893c56fd2fb8b06ac8a9b2a74182 2x, https://si.imgix.net/63b9f8c6/uploads/origins/14c732cb-5d00-4397-a3b0-462be5b0faab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=676d16f52bf94130fa206e8ff2983b45 3x", "genre": "art", "nsfw": true, "body": "また会ったね！\n\nワニの女の子とオオカミの友達の絵を描いてください。\n\n二人は温泉でくつろいでいます。二人とも裸でお湯につかっています。背景に日本酒を入れてもいい。\n\nできれば、二人のペニスが水面から出ているバージョンもお願いします。オオカミ少女はワニ少女より大きなペニスで描いてください。ワニ女がそれを見たら、ショックを受けるでしょう。\n\nそれ以外の構図はお任せします。\n\nオオカミ少女参考：https://drive.google.com/drive/folders/1znFnTdyyYz5-Nge9g3vf9nIjQlTWcWWj?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1NlEDEHCzXJOLVhZ4_dNKF5lAV6N4lzSV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/24", "thumbnail_src": "https://si.imgix.net/fb11314d/uploads/origins/24d43f14-f633-43b7-9686-928e0c918088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a719e5b2c663c38f255c1084e9db84f", "thumbnail_srcset": "https://si.imgix.net/fb11314d/uploads/origins/24d43f14-f633-43b7-9686-928e0c918088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a719e5b2c663c38f255c1084e9db84f, https://si.imgix.net/fb11314d/uploads/origins/24d43f14-f633-43b7-9686-928e0c918088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69e6eed813f6f324ea25388f831d2290 2x, https://si.imgix.net/fb11314d/uploads/origins/24d43f14-f633-43b7-9686-928e0c918088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be3d56d8ccaac94f43add0047b203a6a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/23", "thumbnail_src": "https://si.imgix.net/325bd54e/uploads/origins/936df38f-a0c1-4605-bcf4-2f2db29ead57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0203d6b2ca045de2f46a70335a7d68e5", "thumbnail_srcset": "https://si.imgix.net/325bd54e/uploads/origins/936df38f-a0c1-4605-bcf4-2f2db29ead57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0203d6b2ca045de2f46a70335a7d68e5, https://si.imgix.net/325bd54e/uploads/origins/936df38f-a0c1-4605-bcf4-2f2db29ead57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfab74e2af915fe083f3ef9cc7b12d8c 2x, https://si.imgix.net/325bd54e/uploads/origins/936df38f-a0c1-4605-bcf4-2f2db29ead57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c822c03815173efc95913457ce4a336 3x", "genre": "art", "nsfw": true, "body": "また会ったね！\n\n今回はマンタの女の子とサメの女の子を一緒に描いてほしい。\n\nキャラクター1\nhttps://imgur.com/a/eRKE7P0\nhttps://files.catbox.moe/ibj73n.png\nhttps://files.catbox.moe/smcous.png\n\nキャラクター2\nhttps://imgur.com/a/roesia-gallery-refs-OzW9qnx\nhttps://i.imgur.com/9RjIUUS.png\nhttps://i.imgur.com/z1ngmmx.png\n\n一緒にビーチでくつろぐ二人をセクシーなポーズで描いてください。\n\nインスピレーションの源になるような例をいくつか：\n\nhttps://files.catbox.moe/n87o22.jpg\nhttps://files.catbox.moe/5soisj.jpg\nhttps://files.catbox.moe/3rmpe8.jpg\nhttps://files.catbox.moe/mzbwv7.jpg\n\n彼らの足、特に網目のあるつま先を必ず描いてください。\n\n二人の女の子は手にも網があります。\n\nサメの女の子は遊び心でマンタの女の子にじゃれついているが、マンタの女の子は少し恥ずかしがっている。\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/22", "thumbnail_src": "https://si.imgix.net/ebc76f4c/uploads/origins/b7346cbe-0f93-49cb-910f-cb6df9e53c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d867c6481425c5492cf75314e507cf62", "thumbnail_srcset": "https://si.imgix.net/ebc76f4c/uploads/origins/b7346cbe-0f93-49cb-910f-cb6df9e53c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d867c6481425c5492cf75314e507cf62, https://si.imgix.net/ebc76f4c/uploads/origins/b7346cbe-0f93-49cb-910f-cb6df9e53c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=659cdfdc8810e3e40ea329a44a614add 2x, https://si.imgix.net/ebc76f4c/uploads/origins/b7346cbe-0f93-49cb-910f-cb6df9e53c8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45fdab953e259e3e8d6c22c2495124c5 3x", "genre": "art", "nsfw": true, "body": "前回の写真、素晴らしかったわ。僕のクロコダイルちゃんを絡めた続きの写真を撮りたかったんだ。\n\nその写真は、彼女が酔っ払って楽しい夜を過ごした翌朝のものだ。胸が出て、パンツが脱げて、満足そうな顔でベッドに横になっている。残りの写真の詳細は君に任せるよ。ありがとう！\n\nhttps://drive.google.com/drive/folders/1NlEDEHCzXJOLVhZ4_dNKF5lAV6N4lzSV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/21", "thumbnail_src": "https://si.imgix.net/02411e8f/uploads/origins/31f22761-3000-43c6-a40b-31b8d78172cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ab1beed881e8c3e6a1c78e2be1f0f21", "thumbnail_srcset": "https://si.imgix.net/02411e8f/uploads/origins/31f22761-3000-43c6-a40b-31b8d78172cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ab1beed881e8c3e6a1c78e2be1f0f21, https://si.imgix.net/02411e8f/uploads/origins/31f22761-3000-43c6-a40b-31b8d78172cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e940137a1c4ffa38c75a041af92ec0eb 2x, https://si.imgix.net/02411e8f/uploads/origins/31f22761-3000-43c6-a40b-31b8d78172cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2f561964ca57b2a2a801c65fea76792 3x", "genre": "art", "nsfw": true, "body": "こんにちは！僕のキャラクターを描いてほしいんだ。彼女はワニの尻尾を持っていて、顔に傷がある。彼女は生意気で、本当に強情なところがあります。  \n\n絵は、ワニ娘が酔っぱらって胸を出して座っているような感じでお願いします。缶ビールを飲みながら、満足げなしぐさをするようにお願いします！彼女はお酒を飲んで夜を楽しんでいるので、顔が赤くなっているはずです。あとはお任せします！ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1NlEDEHCzXJOLVhZ4_dNKF5lAV6N4lzSV?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/20", "thumbnail_src": "https://si.imgix.net/8e804d56/uploads/origins/006fcd8b-6d8f-4386-89de-e124f05a8159?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7f8a977b3dff14d7b1b5c7b8f74b24", "thumbnail_srcset": "https://si.imgix.net/8e804d56/uploads/origins/006fcd8b-6d8f-4386-89de-e124f05a8159?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7f8a977b3dff14d7b1b5c7b8f74b24, https://si.imgix.net/8e804d56/uploads/origins/006fcd8b-6d8f-4386-89de-e124f05a8159?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e9f3abf5f7d9742c0c0315d224c9e7b 2x, https://si.imgix.net/8e804d56/uploads/origins/006fcd8b-6d8f-4386-89de-e124f05a8159?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12c87934e70204da897fdc7b5ac66db7 3x", "genre": "art", "nsfw": true, "body": "こんにちは。あなたの絵はとても素敵ですね。ぜひ僕のキャラクターを描いてほしい。好きなように描いてください。おてんば娘です。\n\nhttps://drive.google.com/drive/folders/1IwhYhL1MtsM-dIQ3WuGuIuiJQDYX1zh6?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/19", "thumbnail_src": "https://si.imgix.net/331ff2f7/uploads/origins/9664c238-db1f-479f-91be-7c519dbc2a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8175eb199e365ba82d43f68055d00ead", "thumbnail_srcset": "https://si.imgix.net/331ff2f7/uploads/origins/9664c238-db1f-479f-91be-7c519dbc2a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8175eb199e365ba82d43f68055d00ead, https://si.imgix.net/331ff2f7/uploads/origins/9664c238-db1f-479f-91be-7c519dbc2a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c00d54bf29cf777b3ce76d28c457f8a5 2x, https://si.imgix.net/331ff2f7/uploads/origins/9664c238-db1f-479f-91be-7c519dbc2a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebf617e2881d66ae388598a1d503d223 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\n私のサメの女の子を描いてほしいです。\nhttps://imgur.com/a/Q1EMZZn\n\n釣り用のルアーをピアスにしていて、左頬にほくろがある陽気なおてんば娘。また、少し空気が読めず、人というよりサメのように振る舞うこともある。背中に背びれがある。尾の側面の付け根近くには小さなヒレが2つある。尾びれ近くの尾の上下に2つの小さなひれがある。両前腕にヒレがある。\n\nこの画像では、釣りのルアーを彼女の耳から外してほしい。この画像は、彼女がどうやってルアーを手に入れたかの物語になる。ユーモラスにするつもりだ。この画像では、彼女はルアーを使って漁師に釣り上げられ、後にそれを記念に取ってイヤリングとして身につけることになる。\n\nルアーに食いついた彼女を水中でクローズアップしてほしい。バストアップの額装でもいい。ルアーにはこの画像のようにフック一式がついているのが望ましい：\nhttps://i.imgur.com/85HZQbI.png\n\nさらに、彼女の首にエラを追加してください。", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/18", "thumbnail_src": "https://si.imgix.net/d56e253d/uploads/origins/dce9eef1-d018-44bf-b834-040dd615e2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820d0dbbc19ad58025f0ca7f0fbba2fe", "thumbnail_srcset": "https://si.imgix.net/d56e253d/uploads/origins/dce9eef1-d018-44bf-b834-040dd615e2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820d0dbbc19ad58025f0ca7f0fbba2fe, https://si.imgix.net/d56e253d/uploads/origins/dce9eef1-d018-44bf-b834-040dd615e2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1c6db1c9f2ba41ac998159b36eee406 2x, https://si.imgix.net/d56e253d/uploads/origins/dce9eef1-d018-44bf-b834-040dd615e2bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17708ff5ed1bdceb61daf57c3ae0c209 3x", "genre": "art", "nsfw": false, "body": "また会ったね！\n\nいろいろなキャラクターをお願いしたいです。\n\nキャラクター1：\nhttps://imgur.com/a/TIhCG71\n\nこのキャラクターはとても大きな怪獣で、街を破壊しているところをお好きなように描いてください。\n\nもし望むなら、彼女と戦う自分の怪獣キャラクターAlkも描いてください。\nhttps://twitter.com/yaba_mitu2/status/1533357971090046981\n\nキャラクター2：\nhttps://imgur.com/a/q6A3xNp\n\nカタナを振り回す彼女が描けます。\n\nキャラクター3\nhttps://imgur.com/a/48i4I91\n\n怪獣が街を破壊している後ろで、この2人のキャラクターが戦っているところを描いてください。\n\nキャラクター2のポーズは自由ですが、キャラクター3の仮面ライダーキックを描いてください。\n\n細かい部分はほとんど自由です。\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@yaba_mitu2/works/17", "thumbnail_src": "https://si.imgix.net/7db004a8/uploads/origins/94f255e6-22fa-423e-9270-ba15d7fe3780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to