.net/e34788c5/uploads/origins/ceee3e46-5f42-49f7-a454-9e28833ba34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4fba9d18d758be982d105fbd2907339", "thumbnail_srcset": "https://si.imgix.net/e34788c5/uploads/origins/ceee3e46-5f42-49f7-a454-9e28833ba34b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4fba9d18d758be982d105fbd2907339, https://si.imgix.net/e34788c5/uploads/origins/ceee3e46-5f42-49f7-a454-9e28833ba34b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af8e5622f674d1d920ef0ace0c202cd0 2x, https://si.imgix.net/e34788c5/uploads/origins/ceee3e46-5f42-49f7-a454-9e28833ba34b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d37366f6a806baed653791f35258cae 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Fate/Grand Orderの男性主人公、マッシュ・カイリライトのアートワークをお願いしたいです。\n\n私服です。背景はマスターの部屋（https://i.imgur.com/25n4EYL.png）です。主人公のベッドの端に座りながら、抱き合ってキスをしています。\n\nありがとう。", "created_at": "", "completed_at": ""}, {"path": "/@snowrich114/works/4", "thumbnail_src": "https://si.imgix.net/0e04827c/uploads/origins/85a614b6-f505-498d-b138-80454bddd29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4450deb5b7e50afcbebaffb8e3e474", "thumbnail_srcset": "https://si.imgix.net/0e04827c/uploads/origins/85a614b6-f505-498d-b138-80454bddd29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4450deb5b7e50afcbebaffb8e3e474, https://si.imgix.net/0e04827c/uploads/origins/85a614b6-f505-498d-b138-80454bddd29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66ed03fa14175d1e0a18bd4b1a70fb8e 2x, https://si.imgix.net/0e04827c/uploads/origins/85a614b6-f505-498d-b138-80454bddd29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=409a781f0d516a3afd15f235f80e9270 3x", "genre": "art", "nsfw": false, "body": "月姫の秋葉と遠野四季の恋愛イラストをお願いしたいです。月姫の秋葉と遠野志貴の恋愛イラストをリメイク版のデザインでお願いしたいです。  (https://imgur.com/a/rSjaGmd) (https://imgur.com/a/DSmSgAg)\n\n秋葉が左側、志希が右側（https://imgur.com/a/8x9OPwV）で、秋葉の目から涙を流しながら熱いキスを交わしているようなイメージです。\n\n舞台は夜の秋葉の洋室ですが、この作品（https://imgur.com/a/uOpSQ8a）のように、夜空が見える大きな窓を背景の大部分を占めるように描いていただきたいです。", "created_at": "", "completed_at": ""}, {"path": "/@snowrich114/works/3", "thumbnail_src": "https://si.imgix.net/adda5a64/uploads/origins/9dbfeb18-b243-46cb-8b42-3945508e0d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=680400ca2ad1271626a188a82ebca6b5", "thumbnail_srcset": "https://si.imgix.net/adda5a64/uploads/origins/9dbfeb18-b243-46cb-8b42-3945508e0d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=680400ca2ad1271626a188a82ebca6b5, https://si.imgix.net/adda5a64/uploads/origins/9dbfeb18-b243-46cb-8b42-3945508e0d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f17919eb2eeaac0a968924d0f0c3bd22 2x, https://si.imgix.net/adda5a64/uploads/origins/9dbfeb18-b243-46cb-8b42-3945508e0d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af9d25d8876dd1563f13ff43db1d738b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！Fate/Extra CCCの女性岸波白野とギルガメッシュのロマンチックなファンアートをお願いしたいです。二人がデートをしていて、街を歩いていて、手をつないでいてほしいです。白野は『フェイト／エクストラ CCC』の黒っぽい制服を着ている。ギルガメッシュは真っ白なシャツにジーンズ。白野は顔を赤くして楽しそうに笑っている。\n\n その他、細かいことはあなた次第。\n\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@snowrich114/works/2", "thumbnail_src": "https://si.imgix.net/e245cc02/uploads/origins/09a0d03b-c0ef-4296-8e30-e2c93bb163ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc585d68dc9ae6442a21398c6e26c05d", "thumbnail_srcset": "https://si.imgix.net/e245cc02/uploads/origins/09a0d03b-c0ef-4296-8e30-e2c93bb163ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc585d68dc9ae6442a21398c6e26c05d, https://si.imgix.net/e245cc02/uploads/origins/09a0d03b-c0ef-4296-8e30-e2c93bb163ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=