d-5121-494d-bf0b-b2234532ee9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e5ef0ee973506f0a2bfcfd2bc8c79c3 2x, https://si.imgix.net/670e4ad5/uploads/origins/70d85f8d-5121-494d-bf0b-b2234532ee9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e4a72059f39aca074fde427846070d3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/66", "thumbnail_src": "https://si.imgix.net/ec3638bf/uploads/origins/84938aba-9c7e-422c-a96c-3ea24cead4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b5d0faf6a4bfd19fbf6f1eb77dc344d", "thumbnail_srcset": "https://si.imgix.net/ec3638bf/uploads/origins/84938aba-9c7e-422c-a96c-3ea24cead4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b5d0faf6a4bfd19fbf6f1eb77dc344d, https://si.imgix.net/ec3638bf/uploads/origins/84938aba-9c7e-422c-a96c-3ea24cead4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea203d1de91d399bc5d519879da3d82a 2x, https://si.imgix.net/ec3638bf/uploads/origins/84938aba-9c7e-422c-a96c-3ea24cead4e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d6914f488cd8b0682eda14423d0064b 3x", "genre": "art", "nsfw": false, "body": "はじめまして、先日Xに投稿された初音ミクゼロEWのイラストがとても素晴らしかったため、依頼させていただきます。\n先生に依頼したいイラストは「背中から体躯に見合わない巨大な機械翼を生やし、片手には重火器を装着し、何かを憂うような表情の双葉湊音」です。\n双葉湊音とはガソリンアレイ社が展開する合成音声ソフトキャラクターで黒髪ロングに青のインナーカラーが特徴の少女です。\n背景につきましては夜明けを連想させるものであれば嬉しいです。\n構図等記載されていない点につきましてはお任せいたします。\n機械翼につきましてはガンダムで言うとゼロEWだけでなくSフリーダムやオーライザーなども含むと考えております。\n\nご検討のほどよろしくお願いします。\n\nhttps://www.futabaminato.com/character/", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/65", "thumbnail_src": "https://si.imgix.net/cd78b785/uploads/origins/2d8ab1f0-f20a-42b6-8e43-8fe2a8b201bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4402ceab7385a89841d859d0a68df9b", "thumbnail_srcset": "https://si.imgix.net/cd78b785/uploads/origins/2d8ab1f0-f20a-42b6-8e43-8fe2a8b201bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4402ceab7385a89841d859d0a68df9b, https://si.imgix.net/cd78b785/uploads/origins/2d8ab1f0-f20a-42b6-8e43-8fe2a8b201bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=980af656620d4b4ff7630d8f6201d4e9 2x, https://si.imgix.net/cd78b785/uploads/origins/2d8ab1f0-f20a-42b6-8e43-8fe2a8b201bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3564169a6c341c828a18e5c0231a653 3x", "genre": "art", "nsfw": false, "body": "こんにちは！白と金のローブを着た私のロボットガールをここに描いてもらえますか？https://www.dropbox.com/scl/fi/r8lz7hqa9xa024548y962/lullabyposesimplebg.png?rlkey=nvu3nzfdormqhm3eny4zc4st1&st=khg6ahak&dl=0\n\nでも、解剖学とフラットカラーは、こちらの参考文献から使ってください: https://www.dropbox.com/scl/fi/4v4r5r30ccf5u4htqw9iy/image-7ref.png?rlkey=wwdoyfs7iu8a2qm6gr7toj6ol&st=h5ut4icm&dl=0\n\n彼女のまつげとゴールドもお願いします: https://drive.google.com/file/d/108xQ17ZgVxaMUHxXFjwzQtu68qurCejY/view?usp=sharing\n\nこの資料には彼女のゴールドの指輪とバングルがあります: https://www.dropbox.com/scl/fi/gcb2hvefwswak6ctjs497/Lulla_lowres.png?rlkey=3lfyc3536umxpwhzyayxxd8hs&st=igal6mmh&dl=0\n\nキュート、フェミニン、エレガントなポーズなら何でもOKです！", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/64", "thumbnail_src": "https://si.imgix.net/944d53c6/uploads/origins/4604f13d-d177-4cea-88bd-37e756e91027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a85382fc0643ba93e2e595d9c3ce555", "thumbnail_srcset": "https://si.imgix.net/944d53c6/uploads/origins/4604f13d-d177-4cea-88bd-37e756e91027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a85382fc0643ba93e2e595d9c3ce555, https://si.imgix.net/944d53c6/uploads/origins/4604f13d-d177-4cea-88bd-37e756e91027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=411ea2e39b0e57ee10a01124e7c39d6c 2x, https://si.imgix.net/944d53c6/uploads/origins/4604f13d-d177-4cea-88bd-37e756e91027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=552548e20fdb4c0ffc5b78d6d654ff43 3x", "genre": "art", "nsfw": false, "body": "お初にお目にかかります。ちょっと無茶なご依頼となるのですが興味があればご検討お願いします。\n\n『戦国BASARA』本多忠勝のコスをした『ネギま』の絡繰茶々丸のイラストをお願いします。\n■コスと言っても茶々丸の体型(後述)に合わせたスマートな装甲を装着した感じ(所謂『MS少女』や『フレームアームズガール』みたいなもの)でお願いします。\n■周囲に「援護形態」発動時に出現する小型支援機を4〜6機程添えて。\n■茶々丸のボディは麻帆良学園祭編中盤あたりから登場した、より人間の身体に近いボディで。\n■胸鎧を女性用に合わせる、腰鎧をスカート状にする等、多少のアレンジを加えてもOKです。\n\n以上、上記の通り無茶な内容となりますがよろしければご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/63", "thumbnail_src": "https://si.imgix.net/362ad3f4/uploads/origins/9b1fc95a-3e0b-4e65-8c04-67dc8dbe665c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbc127f0b93f1699bccd4bfed1fee056", "thumbnail_srcset": "https://si.imgix.net/362ad3f4/uploads/origins/9b1fc95a-3e0b-4e65-8c04-67dc8dbe665c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbc127f0b93f1699bccd4bfed1fee056, https://si.imgix.net/362ad3f4/uploads/origins/9b1fc95a-3e0b-4e65-8c04-67dc8dbe665c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cddd832a5bfc01d537ceaaa757187f5 2x, https://si.imgix.net/362ad3f4/uploads/origins/9b1fc95a-3e0b-4e65-8c04-67dc8dbe665c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f8b24d74a54091a8559449d50cd0763 3x", "genre": "art", "nsfw": false, "body": "虹色ではなく、白と赤の2色を持っています。彼女の武器の腕もお願いします。\n\nhttps://www.dropbox.com/scl/fi/5bjs9x80ly55me0hd83tw/BCNv49-I9Es.jpg?rlkey=u3kveb6dowtjgfg2hq7dvhmlc&st=rcm0j8i3&dl=0\n\nhttps://www.dropbox.com/scl/fi/9f6jhhdrd8tcg5ew7lo5g/export202409280534119010-1.png?rlkey=pgmo46p86sevj6mnt1s8s5cx3&st=jklo9zjp&dl=0\n\nhttps://www.dropbox.com/scl/fi/5xy7bbctrx5dcqkldm7by/kofi3-F.png?rlkey=d1byfhc8wbetn93oygirvk8yj&st=i6ytmj56&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/62", "thumbnail_src": "https://si.imgix.net/fcb6f001/uploads/origins/b8731768-cccc-4f0d-8f7e-698af5446123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8afba64d5c3425d985934e1a275f3c", "thumbnail_srcset": "https://si.imgix.net/fcb6f001/uploads/origins/b8731768-cccc-4f0d-8f7e-698af5446123?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8afba64d5c3425d985934e1a275f3c, https://si.imgix.net/fcb6f001/uploads/origins/b8731768-cccc-4f0d-8f7e-698af5446123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15af891a91c5f1087e07d74e641b41b9 2x, https://si.imgix.net/fcb6f001/uploads/origins/b8731768-cccc-4f0d-8f7e-698af5446123?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4988d62d8af4c6826b1ac03f251aaea 3x", "genre": "art", "nsfw": false, "body": "お世話になります。声優・Vtuberとして活動しておりますくんぺー。と申します。\nSNSアイコン・配信サムネイル用に自身のVtuberモデルのSDイラストをお願いします。\nVtuberモデルの立ち絵・設定画をお送りします。\nhttps://drive.google.com/drive/folders/1U-5DY2QTVKimG5gpgBh1syjfoVOgQvvd?usp=sharing\n\n画像サイズはSNS利用のため正方形ですと幸いです。また、可能であれば配信サムネイル用に背景透過したファイルをいただけると大変うれしく存じます。\nご検討のほどお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/61", "thumbnail_src": "https://si.imgix.net/864d941b/uploads/origins/de8b23dc-c1a7-4813-9eb0-843bdc826a54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb7d618288b234f346626fbfde44bf8", "thumbnail_srcset": "https://si.imgix.net/864d941b/uploads/origins/de8b23dc-c1a7-4813-9eb0-843bdc826a54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb7d618288b234f346626fbfde44bf8, https://si.imgix.net/864d941b/uploads/origins/de8b23dc-c1a7-4813-9eb0-843bdc826a54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46548cc7535464d990662ced6c8ec8b2 2x, https://si.imgix.net/864d941b/uploads/origins/de8b23dc-c1a7-4813-9eb0-843bdc826a54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0080e0b15a7531069019b97f7ab87bf 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのSDガンダムのイラストが大好きで、以前から自分のイラストが欲しいと思っていました。もしよろしければ、配信用のアバターとして使用させていただきます。\n改造RX-122ガンダムヘイズル・ケルデレックのSDガンダムイラストをお願いしたいです。\n改造します：\n+ RGM-79Q GMクゥエルの頭部\n+ RX-178BビルドガンダムMk-IIのビームライフルMk-IIのようなロングライフル。\n+ カラーパターン参考：https://files.catbox.moe/7bmur8.png\nかっこいいポーズはあなたのデザインセンスにお任せします。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/60", "thumbnail_src": "https://si.imgix.net/4f6c652b/uploads/origins/2fa08877-2417-4987-8e85-9b49d057d8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee65ae74889e704daab426da8fc2472", "thumbnail_srcset": "https://si.imgix.net/4f6c652b/uploads/origins/2fa08877-2417-4987-8e85-9b49d057d8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee65ae74889e704daab426da8fc2472, https://si.imgix.net/4f6c652b/uploads/origins/2fa08877-2417-4987-8e85-9b49d057d8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc70928405512a7b514e43922a66fc1a 2x, https://si.imgix.net/4f6c652b/uploads/origins/2fa08877-2417-4987-8e85-9b49d057d8d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf29192566e503d8350b340245a25d4b 3x", "genre": "art", "nsfw": false, "body": "先生の絵のジャンルと異なり恐縮ですが、以下が可能でしたらお願いします。\n\nキャラクター：マリ（氷河戦士ガイスラッガー）\n服装：戦闘服とヘルメット姿、戦闘服を装着していないノーマル状態姿を\n並べて描いて頂けないでしょうか。ポーズなどはお任せします。\n以下はアニメ本編の画像ですが、Skebで作品名で検索頂いた方が資料になると思います。\n\n戦闘服とヘルメット姿\nhttps://pbs.twimg.com/media/F6omiuaacAA5Vfd?format=png&name=small\nhttps://pbs.twimg.com/media/F6o5VKIb0AA8nPK?format=png&name=small\nhttps://pbs.twimg.com/media/DTLoNR2VAAAQoJm.jpg:medium\nhttps://pbs.twimg.com/media/F7-WMX9bgAAagNL?format=png&name=small\nhttps://pbs.twimg.com/media/F6o-zN5bsAAhx3w?format=png&name=small\n\n戦闘服を装着していないノーマル状態姿\nhttps://pbs.twimg.com/media/F7-bEQ8bkAEtyVs?format=png&name=small\nhttps://pbs.twimg.com/media/FxxXfAEaIAcRKqy?format=jpg&name=large\nhttps://pbs.twimg.com/media/F8d6zjEbYAAxqy3?format=png&name=small\nhttps://pbs.twimg.com/media/DTqJQGtV4AAGU2X.jpg\n\n以上、よろしくお願いします。\n\nhttps://www.youtube.com/watch?v=KHBwef7qTYc", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/59", "thumbnail_src": "https://si.imgix.net/0e411560/uploads/origins/028452ff-a5c5-49e5-879d-d59db57161ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1729a5b693375e235a33dd8d4c571a50", "thumbnail_srcset": "https://si.imgix.net/0e411560/uploads/origins/028452ff-a5c5-49e5-879d-d59db57161ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1729a5b693375e235a33dd8d4c571a50, https://si.imgix.net/0e411560/uploads/origins/028452ff-a5c5-49e5-879d-d59db57161ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7479ee86718257ccae685815c4cc8ec 2x, https://si.imgix.net/0e411560/uploads/origins/028452ff-a5c5-49e5-879d-d59db57161ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c8159712d1bfa967a681001e621b6bf 3x", "genre": "art", "nsfw": false, "body": "ガンダムストライクフリーダムSDスタイル、ビームキャノンを手にお好みのポーズでクールにアクション。", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/58", "thumbnail_src": "https://si.imgix.net/efaa051e/uploads/origins/bd8c0af2-a70f-4cdd-8c25-afd3a7d78c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34c1f458d9bff31b1f5e2dd03abd76c3", "thumbnail_srcset": "https://si.imgix.net/efaa051e/uploads/origins/bd8c0af2-a70f-4cdd-8c25-afd3a7d78c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34c1f458d9bff31b1f5e2dd03abd76c3, https://si.imgix.net/efaa051e/uploads/origins/bd8c0af2-a70f-4cdd-8c25-afd3a7d78c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3568aa7d0efee446a2ceac070cea3c8d 2x, https://si.imgix.net/efaa051e/uploads/origins/bd8c0af2-a70f-4cdd-8c25-afd3a7d78c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95f77441b2c241a52d8a44804597e59c 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは、須長根。\n\nついにまた、あなたのクールなSDスタイルでイラストを描いてもらいたいモデルができました！\n\n参考写真はこのスレッドにあります： https://x.com/elliottgray/status/1886307407753871505\n\nありがとうございました！\n\nhttps://x.com/elliottgray/status/1886307407753871505", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/57", "thumbnail_src": "https://si.imgix.net/36888f7c/uploads/origins/f361b8a1-665c-49d5-bef2-81ae2d1a5084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28337f4ae7c4821c60f200bd857e057e", "thumbnail_srcset": "https://si.imgix.net/36888f7c/uploads/origins/f361b8a1-665c-49d5-bef2-81ae2d1a5084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28337f4ae7c4821c60f200bd857e057e, https://si.imgix.net/36888f7c/uploads/origins/f361b8a1-665c-49d5-bef2-81ae2d1a5084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b218e0dda9066d2efc7ed5b3d5be8073 2x, https://si.imgix.net/36888f7c/uploads/origins/f361b8a1-665c-49d5-bef2-81ae2d1a5084?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee7aed40d861a2bfbfe2cfada3901302 3x", "genre": "art", "nsfw": false, "body": "ジャックボックス(synduality echo of ada)を描いていただきたいです！\n\nポーズはダブルピースでお願いします！\n\nhttps://x.com/ippeigyoubu/status/1826816641746768347", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/56", "thumbnail_src": "https://si.imgix.net/51da9c61/uploads/origins/7fa984a1-396b-4e2b-babe-a66ac4057e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c521d98cb09b4d116bffb7a1ec5601d8", "thumbnail_srcset": "https://si.imgix.net/51da9c61/uploads/origins/7fa984a1-396b-4e2b-babe-a66ac4057e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c521d98cb09b4d116bffb7a1ec5601d8, https://si.imgix.net/51da9c61/uploads/origins/7fa984a1-396b-4e2b-babe-a66ac4057e53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58b701a56d820fd63efa2b3b6e3a81c7 2x, https://si.imgix.net/51da9c61/uploads/origins/7fa984a1-396b-4e2b-babe-a66ac4057e53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85cb23d490bf48dc40f11a3ab33b1e65 3x", "genre": "art", "nsfw": false, "body": "SDスタイルのガンダム・バルバトスルプスレックスが、クールなアクションポーズで尾翼を見せる。", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/55", "thumbnail_src": "https://si.imgix.net/d0d0d818/uploads/origins/1b1522fd-1a30-4bc2-9a87-df8bfd8955f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a08f95caca8f434114f12f161d17de5e", "thumbnail_srcset": "https://si.imgix.net/d0d0d818/uploads/origins/1b1522fd-1a30-4bc2-9a87-df8bfd8955f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a08f95caca8f434114f12f161d17de5e, https://si.imgix.net/d0d0d818/uploads/origins/1b1522fd-1a30-4bc2-9a87-df8bfd8955f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1152e6f887930523d00ad5bf25d23ac 2x, https://si.imgix.net/d0d0d818/uploads/origins/1b1522fd-1a30-4bc2-9a87-df8bfd8955f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7bdf0ec4371e210fea78a7a847fc63f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/54", "thumbnail_src": "https://si.imgix.net/052462fd/uploads/origins/158dd070-5af0-4fc2-abf6-ef463ac4d4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee24af267050484e915c1cc9536c09e", "thumbnail_srcset": "https://si.imgix.net/052462fd/uploads/origins/158dd070-5af0-4fc2-abf6-ef463ac4d4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee24af267050484e915c1cc9536c09e, https://si.imgix.net/052462fd/uploads/origins/158dd070-5af0-4fc2-abf6-ef463ac4d4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82d5bff322f7f533e1a7e390f8013e1f 2x, https://si.imgix.net/052462fd/uploads/origins/158dd070-5af0-4fc2-abf6-ef463ac4d4e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bac7d7daff2cae76e581929511f4f229 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n前回、間違えて金額を入力してしまったので、再リクエストです、すみません！\n私はあなたのメカ絵が本当に大好きで、あなたに何かお願いしたいと思っていました。\nいつもと少し違うかもしれませんが、私のFFXIVのキャラクターと彼女のロボットを描いていただけませんか？参考画像をたくさん載せておきますので、ポーズはお任せします！\n\nhttps://imgur.com/a/jaHTz2r\n\nhttps://imgur.com/a/nia-refs-jaHTz2r", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/53", "thumbnail_src": "https://si.imgix.net/6b9ad77d/uploads/origins/821acbf4-49ca-499a-a6cb-ff066ad23e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58edcc66bae900bad739e317a9a6ef04", "thumbnail_srcset": "https://si.imgix.net/6b9ad77d/uploads/origins/821acbf4-49ca-499a-a6cb-ff066ad23e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58edcc66bae900bad739e317a9a6ef04, https://si.imgix.net/6b9ad77d/uploads/origins/821acbf4-49ca-499a-a6cb-ff066ad23e05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43f632472c10e69aff728a4b99ec2834 2x, https://si.imgix.net/6b9ad77d/uploads/origins/821acbf4-49ca-499a-a6cb-ff066ad23e05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbec15b393c4dfa62a8e214b98b26482 3x", "genre": "art", "nsfw": false, "body": "初めましてリクエストさせていただきます。\n投稿されているSDメカイラストの絵柄が大変素晴らしく感銘を受けたので、\n依頼を出させていただきます。\n\n\n■おおまかなシチュエーション\nガンダムSEED FREEDOMより、こちらが作成したガンプラ(https://x.com/AkamiHamachi/status/1811710234483917266)のブラックナイトスコードルドラのポージング・・・というシチュで。\n\n■細かい点\n・元機体と異なる点は、パーソナルカラーの差し色がシルバーな所と左手にヒートソード(グフカスタムの物と似た形状)を持たせている所です。\n\n・元キット(https://schizophonic9.com/re8/hgce_rudroa.html)のカメラアイは2種類ありますが、シール右側のモノアイ＋スリット状のラインセンサーでお願いします。\n\n・武器は右手に対モビルスーツ重斬刀、左手にシールド＋ヒートソード(シヴァのヒートソードと同じように刃部分が赤熱化した状態で)。\n付属品としては腰の後ろにマウントしたビームライフル、展開状態のビームマントでお願いします。\n\n・ポーズとしては、戦闘機動中でヒートソードが目立つようなポージングでお願いしたいです。\nもし難しそうならモノアイを目立たせたりした何かカッコイイ構図をお任せします。\n(シールドは基部で回転するようになっているので角度ある程度変えても大丈夫です。)\n\n・背景は黒や宇宙だと目立たないと思うので白背景や大気圏内の空中をイメージしていますが、この点もお任せします。\n\n\n以上、長くなってしまいましたがご検討の程よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/52", "thumbnail_src": "https://si.imgix.net/6fc5194a/uploads/origins/e4091627-edd7-467e-8751-c370bdf6bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e97d5ebc84da52176f51b80216539b", "thumbnail_srcset": "https://si.imgix.net/6fc5194a/uploads/origins/e4091627-edd7-467e-8751-c370bdf6bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e97d5ebc84da52176f51b80216539b, https://si.imgix.net/6fc5194a/uploads/origins/e4091627-edd7-467e-8751-c370bdf6bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f06773f02d8bea41afcb16605f1ffe76 2x, https://si.imgix.net/6fc5194a/uploads/origins/e4091627-edd7-467e-8751-c370bdf6bfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f0e53b454e7dde646ef9125f1fc5b80 3x", "genre": "art", "nsfw": false, "body": "また会ったね。\n\n今回もSDリボーンズガンダムの改造をお願いしたいのですが、アーシェガンダムの下部シャーシ＋前腕部をミックスして、モビルアーマー風の小型ユニットを作りたいと思います。\n\nリボーンズは最終決戦で脚部、右前腕部、メインライフル＋シールドが大破しましたが、アーシェガンダムは対チェルディム戦で胴体部のみ破壊されました。\n\nこのスーツは、ELS戦において、旧派閥に関係なくすべての武器を使用する必要があるという絶望的なシナリオで存在した。\n\nGNフラッグが作られたのと同じように、迅速なサルベージ修理として2つをくっつけて見せてください。シャーシはあまりうまく組み合わされず、重力下で正しく立つのに苦労するが、4基のGNドライブによる長距離戦闘用の極端な出力＋リボーンズ・ファンネル＋アーシェ・ファングによる力強さで、宇宙空間でも活動することができる。\n\n戦闘ダメージのある機体とオリジナルカラーを提示してください。もし可能であれば、ESFブルーの配色もお願いします。\n\nありがとうございました。\n\nhttps://drive.google.com/file/d/1JUN2XepPpJp2pLDka_gxGvkCgixcMXQh/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/51", "thumbnail_src": "https://si.imgix.net/7fb9e36d/uploads/origins/121a715f-2b85-484c-b360-122ba50cdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df38db17db00b8e3897a7d4018f643de", "thumbnail_srcset": "https://si.imgix.net/7fb9e36d/uploads/origins/121a715f-2b85-484c-b360-122ba50cdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df38db17db00b8e3897a7d4018f643de, https://si.imgix.net/7fb9e36d/uploads/origins/121a715f-2b85-484c-b360-122ba50cdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4db9a5637cbf6f31d0c4f206cbf806fd 2x, https://si.imgix.net/7fb9e36d/uploads/origins/121a715f-2b85-484c-b360-122ba50cdeab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dc20556636f274f2fe7982ae55dcd14 3x", "genre": "art", "nsfw": false, "body": "前回の依頼、本当にありがとうございました！また別のカスタムガンプラのイラストをお願いします！\n\n参考写真はこちらです：\nhttps://twitter.com/elliottgray/status/1683276243603701760\nhttps://twitter.com/elliottgray/status/1612259425338916864\nhttps://twitter.com/elliottgray/status/1607557924171436033\nhttps://twitter.com/elliottgray/status/1606537223985565698\nhttps://twitter.com/elliottgray/status/1605771399167188996", "created_at": "", "completed_at": ""}, {"path": "/@susagane03/works/50", "thumbnail_src": "https://si.imgix.net/471c565a/uploads/origins/f933547b-8ec3-4647-bd8e-909c5c812785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac28e5f6e39c1acba8c0df2c7240b57a", "thumbnail_srcset": "https://si.imgix.net/471c565a/uploads/origins/f933547b-8ec3-4647-bd8e-909c5c812785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&