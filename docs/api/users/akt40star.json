-4be6-8414-13d2fe88f01d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da83b43eba2a75d9ca6c825522f13110", "thumbnail_srcset": "https://si.imgix.net/e467793a/uploads/origins/8ced335d-97d5-4be6-8414-13d2fe88f01d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da83b43eba2a75d9ca6c825522f13110, https://si.imgix.net/e467793a/uploads/origins/8ced335d-97d5-4be6-8414-13d2fe88f01d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a90a839cf35cc8275a436b324522a5d0 2x, https://si.imgix.net/e467793a/uploads/origins/8ced335d-97d5-4be6-8414-13d2fe88f01d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74daf038fb60b3ae4f9b06b67a86dd64 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n\n遊戯王OCGからM∀LICE＜Q＞RED RANSOMのイラストを依頼したいです\n\nシチュエーションはマスターデュエルの\n制限改訂によって禁止カードになった。　　\nレッドランサムがマスターに見放されない為に縋る様に必死で奉仕している。\n\n体位は反り返り騎乗位で\n構図はおまかせします\n\n金額内で可能であれば中だしの差分と\nレッドランサムの台詞をお願いしたいです\n\nまた、金額に見合わなければお手数ですが再送して頂けると助かります。\nご検討頂けますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/26", "thumbnail_src": "https://si.imgix.net/79379969/uploads/origins/d423f608-affe-4fd5-b4fc-c0e6fc50862b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29240ff84f310829a6b831810beae781", "thumbnail_srcset": "https://si.imgix.net/79379969/uploads/origins/d423f608-affe-4fd5-b4fc-c0e6fc50862b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29240ff84f310829a6b831810beae781, https://si.imgix.net/79379969/uploads/origins/d423f608-affe-4fd5-b4fc-c0e6fc50862b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c3ad151226e9384a1f565a5e0d57ba9 2x, https://si.imgix.net/79379969/uploads/origins/d423f608-affe-4fd5-b4fc-c0e6fc50862b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4906067301ed3030f1b0287666a9b5a 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n素敵なイラストを書かれているので、リクエストさせてください。\n\n・キャラクター\n遊戯王VRAINSのブルーエンジェル\n\n・シチュエーション\nアンダーグランウンドなデュエル大会で敗北した彼女が\nペナルティとして公開レイプされてしまうイラストをお願いします。\n体位は腕を頭上で拘束されながらの正常位。\n衣装は半脱ぎで詳細はお任せします。\n\n以上です。\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/25", "thumbnail_src": "https://si.imgix.net/1f01b692/uploads/origins/e0e85db2-d9b8-4ab2-a6cb-7c6c75e772d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3709489eaee242f6da7c8a610527d0f", "thumbnail_srcset": "https://si.imgix.net/1f01b692/uploads/origins/e0e85db2-d9b8-4ab2-a6cb-7c6c75e772d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3709489eaee242f6da7c8a610527d0f, https://si.imgix.net/1f01b692/uploads/origins/e0e85db2-d9b8-4ab2-a6cb-7c6c75e772d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edc5ba18d51bfcda6ce5717fb7488574 2x, https://si.imgix.net/1f01b692/uploads/origins/e0e85db2-d9b8-4ab2-a6cb-7c6c75e772d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3ac559dc5d2ac2fd7ddd5f6998a6efe 3x", "genre": "art", "nsfw": true, "body": "とりすた@FANBOX始めました様。\n初リクエスト失礼します。今回リクエストしたいものですが、\nふたなりの千夜丸ちゃんが、黄色の風船の様な物に包まれ、首から下が球体に包まれたすがたに、ふたなりのちん○が浮き出たものをマスカレーナに亀頭を虐められるというものです。\n千夜丸ちゃんは気持ちよさそうな表情だと嬉しいです。\n以前描いていらっしゃったふたなりロゼ、レイの手コキイラストを拝見させてもらい、それからずっとリクエストさせていただきたく思っておりました。\nよろしければ検討お願いします。もし無理とのことでしたら遠慮なく断ってもいただいても大丈夫です。\n資料は下記に記します。\n\nhttps://www.pixiv.net/artworks/112506149", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/24", "thumbnail_src": "https://si.imgix.net/54f82929/uploads/origins/689c81c4-263c-4d6f-842e-ed6b1dcb6fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5892c54157b868ef6bce9905d7804e6c", "thumbnail_srcset": "https://si.imgix.net/54f82929/uploads/origins/689c81c4-263c-4d6f-842e-ed6b1dcb6fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5892c54157b868ef6bce9905d7804e6c, https://si.imgix.net/54f82929/uploads/origins/689c81c4-263c-4d6f-842e-ed6b1dcb6fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1a8230b3603861f6f605412698b2a4b 2x, https://si.imgix.net/54f82929/uploads/origins/689c81c4-263c-4d6f-842e-ed6b1dcb6fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78710f4f522587e88b118f387821f700 3x", "genre": "art", "nsfw": true, "body": "ポケモントレーナのメイちゃん(BW2の女主人公)が、催眠術を賭けられて、資料URLのようなムチムチドスケベボディが丸見えの構図で犯されまくって、ドスケベ顔になりながら下品なオホ声を上げまくっているエッチイラストが見たいです。\n\nお目目にハートマークがあるとエッチかもです。\n\n竿役は、ポケモンじゃなくて人間にして欲しいです。（ムキムキおじさん等）\n\n衣装は、半着衣もしくは全裸で、エロいボディと肌が露出しているようにして欲しいです。\n\nhttps://x.com/akt40star/status/1908468147633717572", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/23", "thumbnail_src": "https://si.imgix.net/d633fcd2/uploads/origins/73536e62-6411-4591-8e91-75a41d22b1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37a8dfdfa71750d8d0e19d39a781b366", "thumbnail_srcset": "https://si.imgix.net/d633fcd2/uploads/origins/73536e62-6411-4591-8e91-75a41d22b1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37a8dfdfa71750d8d0e19d39a781b366, https://si.imgix.net/d633fcd2/uploads/origins/73536e62-6411-4591-8e91-75a41d22b1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68211b4d1ab07a54d4db425346795636 2x, https://si.imgix.net/d633fcd2/uploads/origins/73536e62-6411-4591-8e91-75a41d22b1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b33d888f010c329b9f4ffbbcf62f4ebb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/22", "thumbnail_src": "https://si.imgix.net/f781f180/uploads/origins/31d7ba47-6328-47a0-84b9-6e613e5a01e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=419f7bda79962b73e232389ecbbbb42a", "thumbnail_srcset": "https://si.imgix.net/f781f180/uploads/origins/31d7ba47-6328-47a0-84b9-6e613e5a01e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=419f7bda79962b73e232389ecbbbb42a, https://si.imgix.net/f781f180/uploads/origins/31d7ba47-6328-47a0-84b9-6e613e5a01e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c26541047cbddfe5d3f2beae5fb8bcbb 2x, https://si.imgix.net/f781f180/uploads/origins/31d7ba47-6328-47a0-84b9-6e613e5a01e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c6ff52df4c1a7398c084bf5c73cbaa0 3x", "genre": "art", "nsfw": true, "body": "霊使いのふたなりえっちがすごく好きなので宜しければリクエストをお願いしたいです。\nアウスとヒータの組み合わせでこちらのおっぱいをむぎゅっと押し付けながらの対面座位をお願いします。\n\nhttps://akt40star.fanbox.cc/posts/9702096\n\nエリア→アウス(ふたなり)\nウィン→ヒータ\n\nヒータが自分のペースで動ける体位なら……と仕方なく応じているシチュエーションでお願いします。\n押し付け合うおっぱいとアウスのデカチンに喘ぐヒータを是非お願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/21", "thumbnail_src": "https://si.imgix.net/ae1ead8d/uploads/origins/b57cd6a6-7a29-4fa3-9572-75a10a1353a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f786d42e5155a2c01f0ae32dc2969bc7", "thumbnail_srcset": "https://si.imgix.net/ae1ead8d/uploads/origins/b57cd6a6-7a29-4fa3-9572-75a10a1353a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f786d42e5155a2c01f0ae32dc2969bc7, https://si.imgix.net/ae1ead8d/uploads/origins/b57cd6a6-7a29-4fa3-9572-75a10a1353a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fda5514a7fd34177ae282b1eb9251876 2x, https://si.imgix.net/ae1ead8d/uploads/origins/b57cd6a6-7a29-4fa3-9572-75a10a1353a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ed219b9da5936fa40e415fabe5ec553 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエスト失礼します\n\n●キャラクター\nうちの子の呑んだくれ人妻エルフ「ノーミ・スギ」\n身長は130cm~140cm台、B-大 W-並 H-大\n緩い喋り方や雰囲気の軽口が好きなお茶目さんで、お酒と旦那と娘が大好きな人妻エルフさんです\n口調は～だねぇ、～かなぁ、へぇ～、等ゆるい様な喋り方（ブルーアーカイブのホシノや、ちびまる子ちゃんのまる子の様な喋り方が近いです）1人称は私、旦那に対してはあなた呼び\n\n●お願いしたい内容\n背が高い旦那（170cm程をイメージ）との純愛前提即堕ち風イラスト\n\n●具体的にお願いしたい内容\n酔っぱらったのか、乱れた服装or下着姿の状態、赤ら顔で旦那に抱き着き甘えるように絡むうちの子\n↓\n旦那優位の分からせえっち。\n体位は腰や尻を掴まれての強制密着騎乗位、腰高位、バック系のいずれか。（好みは密着騎乗＞腰高位＞バック系）滅茶苦茶イかされているにも関わらずやめて貰えない様なイメージで。旦那は背が高くデカチンで、うちの子は背が低いので身長差を意識して頂けるとありがたいです。\nまた可能であれば中出し差分をお願いしたいです。\n\n\nどうか御一考お願いします\n\nhttps://drive.google.com/drive/folders/1pioGDxz79UdAHEHRHitqqnSSpZ5hW_Vx", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/20", "thumbnail_src": "https://si.imgix.net/fb343c36/uploads/origins/f91c1c29-b4c6-4117-80b3-9e3efe7afe8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfd38f66f84c6cc4ec820c8c0e84e16c", "thumbnail_srcset": "https://si.imgix.net/fb343c36/uploads/origins/f91c1c29-b4c6-4117-80b3-9e3efe7afe8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfd38f66f84c6cc4ec820c8c0e84e16c, https://si.imgix.net/fb343c36/uploads/origins/f91c1c29-b4c6-4117-80b3-9e3efe7afe8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=222bfd770b94598fb61c29c36640ce96 2x, https://si.imgix.net/fb343c36/uploads/origins/f91c1c29-b4c6-4117-80b3-9e3efe7afe8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82aea45579f0a4171ebca42d1bf41d1c 3x", "genre": "art", "nsfw": true, "body": "初めましてになります。\nいつもｴｯｯｯなイラスト楽しませていただいております。\n\n今回、スケブ公開していただいたので急遽依頼したく思い連絡させていただきました。\n\n【依頼内容】\n遊戯王の「Ｍ∀ＬＩＣＥマリス＜Ｑ＞ＲＥＤ ＲＡＮＳＯＭ」\nレッドランサムのえっちなイラストをお願いしたく思います。\n\nレッドランサムが主人公(男)のパソコンにクラッキングを仕掛けたのですが、厳重なプロテクトで阻まれバレてしまいます。\nそこで主人公は罰として、レッドランサムに騎乗位えっちでお仕置きすることに。\n騎乗位でピストンしながら、はだけた胸元に両手で乳首をコリコリしている。\n断面図もあると嬉しいです。\n罰を受けていることに納得できず、抵抗的な台詞などあるとなお嬉しいです。\n\n【お願い】\n差分も１枚お願いしたいのです！\n乳首をきゅッ、と摘まむ。\nレッドランサムが絶頂し、精液がびゅるる、どくどく、と注ぎ込まれている。\n(断面図も同様に)\n\n\n※最後に\n\nどうしても、とりすたさんに描いてもらいたくてずっとお待ちしておりました。\nレッドランサムが好きなんですが、どうしてもとりすたさんに依頼したくて温めておりました！", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/19", "thumbnail_src": "https://si.imgix.net/ccfda57b/uploads/origins/1e308048-fa20-4182-8b45-c58cd70c544e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=118e79508d3a6296d6e2e3e439e932a6", "thumbnail_srcset": "https://si.imgix.net/ccfda57b/uploads/origins/1e308048-fa20-4182-8b45-c58cd70c544e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=118e79508d3a6296d6e2e3e439e932a6, https://si.imgix.net/ccfda57b/uploads/origins/1e308048-fa20-4182-8b45-c58cd70c544e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0eba42820ed1597f050cf0f930bd3ba 2x, https://si.imgix.net/ccfda57b/uploads/origins/1e308048-fa20-4182-8b45-c58cd70c544e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75fcefb3da1f075b553a348f0c9b76ee 3x", "genre": "art", "nsfw": true, "body": "閃刀姫-レイのおっぱいが徹底的に開発されている絵を描いていただきたいです。\n\n既に二回りほど膨らんでいる乳房の表面にいくつもパッドが貼り付けられて、そこからパルスがバチバチしているといいです。\nパルスが乳房の神経を焼いて広げて、軽く撫でられるだけでイっちゃうように改造されているようなイメージです。\n目元は洗脳用みたいなバイザーに覆われていて、口元は(まだギリギリ抵抗を失ってない感じに)喘いでくれてると好ましいです。\n四肢については、拘束椅子のようなイメージの機械的でガッチリ目な拘束が施されていると良いなと思いますが、とりすた様の好みや構図に合わせて全然別の物にしていただいても構いません。\n\nパルスパッドについては最低限乳房には何枚か貼ってほしいですが、その他の部位に同様のパルスパッドや別の責め具を付けるかどうかはとりすた様にお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/18", "thumbnail_src": "https://si.imgix.net/60c25a3e/uploads/origins/e1d7a66d-1b2a-4a6a-a79e-2a65a632ac54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96a10c92fbdb531dd6db71b835cdc8a5", "thumbnail_srcset": "https://si.imgix.net/60c25a3e/uploads/origins/e1d7a66d-1b2a-4a6a-a79e-2a65a632ac54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96a10c92fbdb531dd6db71b835cdc8a5, https://si.imgix.net/60c25a3e/uploads/origins/e1d7a66d-1b2a-4a6a-a79e-2a65a632ac54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98d58917b2035084d6e8f1b12e175772 2x, https://si.imgix.net/60c25a3e/uploads/origins/e1d7a66d-1b2a-4a6a-a79e-2a65a632ac54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bbad96ae1939fa3737656e5d49fdb91 3x", "genre": "art", "nsfw": true, "body": "遊戯王の《キラーチューン・キュー》が、竿役に資料URLのような構図でドスケベセックスされている絵が見てみたいです。\n\n細かなシチュエーションですが、現代の遊戯王に詳しくないのでお任せしたいのですが、\n以下の2パターンのどちらかが良いかなと思いました。\n\n①《キラーチューン・キュー》の効果とキラーチューンSモンスターのテーマに則って、\n竿役はチューナーキャラにして、竿役と《キラーチューン・キュー》でドスケベセックスS召喚している。\n\n②《心変わり》や《ブレインコントローラー》や《洗脳－ブレインコントロール》などで快楽堕ちしてて、相手の非チューナーモンスターの竿役とドスケベNTRセックスS召喚させられている。\n\n衣装ですが、全裸でも良いですし、スケスケ衣装がエッチなので半着衣などでも良いです。\nお任せします。\n\n他の構図が良さそうでしたら、資料URLは無視して頂いても大丈夫です。\n\n宛名は別レイヤーでお願いしたいです。\n\nhttps://x.com/akt40star/status/1918996003165777961", "created_at": "", "completed_at": ""}, {"path": "/@akt40star/works/17", "thumbnail_src": "https://si.imgix.net/52fe2d0f/uploads/origins/2a894240-209d-46f8-9e25-ce75696cbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc1341a1855568bed90e32d6af7658b0", "thumbnail_srcset": "https://si.imgix.net/52fe2d0f/uploads/origins/2a894240-209d-46f8-9e25-ce75696cbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc1341a1855568bed90e32d6af7658b0, https://si.imgix.net/52fe2d0f/uploads/origins/2a894240-209d-46f8-9e25-ce75696cbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d6241316069041f85b3091428060d8f 2x, https://si.imgix.net/52fe2d0f/uploads/origins/2a894240-209d-46f8-9e25-ce75696cbf48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfo