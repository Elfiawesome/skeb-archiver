複数（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "created_at": "", "completed_at": ""}, {"path": "/@Aya_emn/works/8", "thumbnail_src": "https://si.imgix.net/375589cc/requests/276314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de7931ac18a887b54b5af9a3e4a4c435", "thumbnail_srcset": "https://si.imgix.net/375589cc/requests/276314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de7931ac18a887b54b5af9a3e4a4c435, https://si.imgix.net/375589cc/requests/276314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b6891c04308b46bbda370c49cbb2e4f 2x, https://si.imgix.net/375589cc/requests/276314_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f817aa96712f92f0a4a6bc511a6460ad 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Aya_emn/works/6", "thumbnail_src": "https://si.imgix.net/54830385/requests/94214_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=367d6906ba96f216d61ae5ed493833f7", "thumbnail_srcset": "https://si.imgix.net/54830385/requests/94214_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=367d6906ba96f216d61ae5ed493833f7, https://si.imgix.net/54830385/requests/94214_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb8b15721e05f2b1d83ce84f4669ef26 2x, https://si.imgix.net/54830385/requests/94214_1?bg=%23fff&auto=f