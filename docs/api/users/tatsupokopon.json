mbnail_srcset": "https://si.imgix.net/9b99a4b0/uploads/origins/8f36067e-7b8b-4743-a919-45dc314e355a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=387d97369584e8792d406b1df000dbac, https://si.imgix.net/9b99a4b0/uploads/origins/8f36067e-7b8b-4743-a919-45dc314e355a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f4d4ce29c74658fee6279718b5e8472 2x, https://si.imgix.net/9b99a4b0/uploads/origins/8f36067e-7b8b-4743-a919-45dc314e355a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=398197de155a4a3dbeebacde12ef4a39 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tatsupokopon/works/98", "thumbnail_src": "https://si.imgix.net/ef4a6c06/uploads/origins/23eb39cf-046a-43cc-87f3-dd231d14e788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fe4267d92d4aadcdde57a0e53fbefa3", "thumbnail_srcset": "https://si.imgix.net/ef4a6c06/uploads/origins/23eb39cf-046a-43cc-87f3-dd231d14e788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fe4267d92d4aadcdde57a0e53fbefa3, https://si.imgix.net/ef4a6c06/uploads/origins/23eb39cf-046a-43cc-87f3-dd231d14e788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7138b25fa59ebc67868690158234befb 2x, https://si.imgix.net/ef4a6c06/uploads/origins/23eb39cf-046a-43cc-87f3-dd231d14e788?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=049c5865a833a9c76f015c3577a453bb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のキャラクターを描いてくれませんか？\n\n内気でおとなしいオコジョです。\n\n秋がテーマで、もみじの葉が落ちているような絵が希望です。その他はお任せします。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://i.ibb.co/YFnVDc