ca9-8d24-b18d733a1da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0ff71a580276e0c4c4fa08a98e249e1, https://si.imgix.net/fcde713d/uploads/origins/7daa7652-f07d-4ca9-8d24-b18d733a1da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bff571398002d88d8a8a44dd1f4eba12 2x, https://si.imgix.net/fcde713d/uploads/origins/7daa7652-f07d-4ca9-8d24-b18d733a1da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=919e97c07455ff400910c4ab40178861 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！僕のキャラクターが別の毛皮の動物に変身するトランスファーアートを描いてほしいんだ！どんなアイデアでも大歓迎ですが、もしとてもクールで、変わっていて、面白いものを作ってもらえたら最高です！\n\nhttps://drive.google.com/file/d/1TQjvG0rlxhpufXx1jIa1hIQPI9Rk_FGF/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@tatsupokopon/works/87", "thumbnail_src": "https://si.imgix.net/7b0b3779/uploads/origins/32f74641-17bf-408f-8d8f-f4970b2db380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee473c160ed257cab33d3c6e51f64c91", "thumbnail_srcset": "https://si.imgix.net/7b0b3779/uploads/origins/32f74641-17bf-408f-8d8f-f4970b2db380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee473c160ed257cab33d3c6e51f64c91, https://si.imgix.net/7b0b3779/uploads/origins/32f74641-17bf-408f-8d8f-f4970b2db380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd9e50d45ec1550ce6624a80e926b615 2x, https://si.imgix.net/7b0b3779/uploads/origins/32f74641-17bf-408f-8d8f-f4970b2db380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63c7b8bfc6a78c258a28336aa4e2cea5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のOCの敵役、ブラック・ロータス軍の主要メンバーのグループアートが欲しいんだ。ヴォルタを中心に、司令官と2人の将軍が、それぞれの個性に合ったポーズで彼を囲んでいるかもしれません。彼らのメカや飛行船、一般的な兵士のシルエットやビューを含める方法があれば、それは素晴らしいことです！ありがとうございます！\n\nヴォルタ - カリスマ的なサイボーグ・ドラゴンであり、軍のリーダー。彼は騒々しく、獰猛で、知的だが、軍隊を心から大切に思っている。\n\nサディ - ヴォルタの副官。優しくて控えめだが、財務と戦略に長けた知性的な指揮官でもある。\n\nヴァレスカ - 口うるさく、遺伝子操作で強化された猫の女の子。スターパイロットとしてダイアンサス部隊を率い、ユニークな実験的メカを操り、悪魔的勢力との戦いに身を投じている。\n\nバラバ - ヴォルタを深く敬愛する狡猾な将軍。砂漠の地でドラゴンの遺物を発掘し、生物実験を行うマグノリア部隊を率いる。\n\nhttps://drive.google.com/drive/u/1/folders/1XCn_JBY8ZQe42b56MdKXwxIeKU93RGNq", "created_at": "", "completed_at": ""}, {"path": "/@tatsupokopon/works/86", "thumbnail_src": "https://si.imgix.net/d2b8a789/uploads/origins/829c5ff1-749b-47b9-a380-48026509b041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abbb095babcd116485c09a34e902de77", "thumbnail_srcset": "https://si.imgix.net/d2b8a789/uploads/origins/829c5ff1-749b-47b9-a380-48026509b041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abbb095babcd116485c09a34e902de77, https://si.imgix.net/d2b8a789/uploads/origins/829c5ff1-749b-47b9-a380-48026509b041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ee24c56ffaa1e6ae8adc58d9202b020 2x, https://si.imgix.net/d2b8a789/uploads/origins/829c5ff1-749b-47b9-a380-48026509b041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57821e77160b0f57939be04de91ada98 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nこの2人のオリジナルキャラクターのイラストを描いていただけませんか？現代SFの設定で、一緒にエイリアンと戦います。\n\nアロイス\nディンゴ\n180センチ。金髪の男性。とても痩せている。\nおしゃべりでいたずら好き、ずるがしこい性格だが、照れ屋でもある。普段の表情は満面の笑み。\nゲイブの忠実な部下。ゲイブのことが大好き。\n\nゲイブ\nホッキョクグマ\n186センチ。グレーヘアーのオス。\n普段の表情は笑顔。不遜でカジュアルな性格だが、内心はとても危険。\nアロイスのクールでチャーミングな上司。\nアロイスを素行の悪い部下のように扱うが、アロイスのことも大切に思っている。\n\n一緒にエイリアンの怪物と戦うなど、かっこいいアクションポーズを描いてください。\n\n使用用途SNS、OC活動、印刷など個人的な閲覧のみ\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Zovag9J6SWh0jPvzh-SwAMHRSSJlVgUV?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tatsupokopon/works/85", "thumbnail_src": "https://si.imgix.net/627f8f21/uploads/origins/798bc9d9-f2f8-4f8b-9b59-a03cadae002a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c96b296e3ead9ea1925a6074146b7c13", "thumbnail_srcset": "https://si.imgix.net/627f8f21/uploads/origins/798bc9d9-f2f8-4f8b-9b59-a03cadae002a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c96b296e3ead9ea1925a6074146b7c13, https://si.imgix.net/627f8f21/uploads/origins/798bc9d9-f2f8-4f8b-9b59-a03cadae002a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6e64bd6bceac11475d2572b1560e631 2x, https://si.imgix.net/627f8f21/uploads/origins/798bc9d9-f2f8-4f8b-9b59-a03cadae002a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ab69952a6067a844b4d68625357fd41 3x", "genre": "art", "nsfw": false, "body": "タツぽん様、初めまして\nYoutubeで配信活動をさせて頂いております、屋根裏ソウジと申します。\nタツぽん様のイラストを拝見しまして、是非今回依頼させていただきたくメッセージを送らさせて頂きました。\n使用用途とはしては配信内やサムネイルに使わさせて頂ければと思います。\n\n依頼内容に関しましては、寝落ちしそうな屋根裏ソウジを描いて頂ければと思います。\n夜23時の暗い寝室で服装は添付している画像の黒いタンクトップでお願い致します。\n参考画像も一緒に送っておきます。\n\n差分で寝ている表情もあれば嬉しいです。\n配信で使わさせて頂くので16：9のサイズでお願いしたいです。\n\n検討して頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/19xfjm7bOg-rEDPlxYVB0RDhu3n1DfjDs?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@tatsupokopon/works/84", "thumbnail_src": "https://si.imgix.net/9380ce91/uploads/origins/94dde068-9b3f-42b5-b08f-d3b6d7818a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aaea70c44d9d8bff508ef11a9f0224e", "thumbnail_srcset": "https://si.imgix.net/9380ce91/uploads/origins/94dde068-9b3f-42b5-b08f-d3b6d7818a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aaea70c44d9d8bff508ef11a9f0224e, https://si.imgix.net/9380ce91/uploads/origins/94dde068-9b3f-42b5-b08f-d3b6d7818a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=679c22d5bc02f20693490fc374b874c6 2x, https://si.imgix.net/9380ce91/uploads/origins/94dde068-9b3f-42b5-b08f-d3b6d7818a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1cda9988e02fb4de82ec670c4ca66cb 3x", "genre": "art", "nsfw": false, "body": "こんにちは！TTRPG「FLUX DESTINY」の設定で、私のキャラクターの衣装を描いてもらえますか？\nhttps://bsky.app/profile/fluxdestiny.bsky.social/post/3lirwrr74rs2e\n\n設定としては、アニメやアメリカのカートゥーンを通して見た、理想化された1990年代のアメリカを彷彿とさせるようなものを想定しています。ポーズや背景の参考になれば幸いです！\n\n彼の服装は自由に微調整してディテールを追加してください。ただし、彼が着ている服のタイプは同じにしてください（後ろ向きの野球帽、未来的なボディスーツ、股なしのショートパンツ、ベスト、スカーフ、ベルト）。銃の代わりに、この作品のナイフで描いてください。\nhttps://skeb.jp/@_if8_/works/19\n\nTTRPGでの私のキャラクターは、政府のために魔法犯罪や魔法法違反を監視・阻止する「特別捜査官」です。専門は機械いじり。21歳の彼は、訓練のために大学のクラスに通っている。\n\nこのアートワークのスタイルがとても好きで、同じようなスタイルのものが欲しいと思っている！\nhttps://skeb.jp/@tatsupokopon/works/82\n\nhttps://drive.google.com/drive/folders/1icV3YhNX97P5pLvaz-q0cnBzpc9sno9C", "created_at": "", "completed_at": ""}, {"path": "/@tatsupokopon/works/83", "thumbnail_src": "https://si.imgix.net/985d9d7c/uploads/origins/63844ffe-4834-4572-81b7-c4b228f19328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88fa2f34b6d90912f5aaf74cee121a2a", "thumbnail_srcset": "https://si.imgix.net/985d9d7c/uploads/origins/63844ffe-4834-4572-81b7-c4b228f19328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88fa2f34b6d90912f5aaf74cee121a2a, https://si.imgix.net/985d9d7c/uploads/origins/63844ffe-4834-4572-81b7-c4b228f19328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2238a0f681e416f9ce259807fa7d3d32 2x, https://si.imgix.net/985d9d7c/uploads/origins/63844ffe-4834-4572-81b7-c4b228f19328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcc81ea689268cb45d5b109507cd331b 3x", "genre": "art", "nsfw": false, "body": "タツぽん様\n\nはじめまして、YouTubeで配信活動をしている摩耶パンダと申します。\nタツぽん様のお描きになるイラストを拝見し、とても心を惹かれたのでこの度リクエストいたしました。\n\n描いていただきたいのは、資料URL内のキャラクターでございます。パンダ体と獣人体の２つの姿があるのですが、今回は獣人体をリクエストさせてください。\n服装や構図等はお任せいたします。\n\n描いていただいた場合の使用用途としてTwitter等のSNSやYouTubeでのサムネイルでの使用を想定しております。\nそのため、お手数ですが透過素材もいただけると嬉しいです。\n\n注文が多くなってしまい申し訳ございません。\nご検討のほど、よろしくお願いいたします。\n\nhttps://x.com/mayapanda_v/status/1870766075094458426?s=46&t=z_P1Mac2YYWe7bgCbNebXA", "created_at": "", "completed_at": ""}]}