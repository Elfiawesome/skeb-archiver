le%2Ccenter&txtsize=30&txt=PRIVATE&s=6a9eac83f849e5666ced8fa9d28a096b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/12", "thumbnail_src": "https://si.imgix.net/46223455/uploads/origins/85c838a6-c145-4f2a-ab04-f2863d9d99b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c852966d9e9c39da9d39d76fbd7353", "thumbnail_srcset": "https://si.imgix.net/46223455/uploads/origins/85c838a6-c145-4f2a-ab04-f2863d9d99b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c852966d9e9c39da9d39d76fbd7353, https://si.imgix.net/46223455/uploads/origins/85c838a6-c145-4f2a-ab04-f2863d9d99b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea55421bd466281399b5d3abedd3f5c4 2x, https://si.imgix.net/46223455/uploads/origins/85c838a6-c145-4f2a-ab04-f2863d9d99b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c515d04e6764482237f3f8d8dea2fc0 3x", "genre": "art", "nsfw": true, "body": "戦場のヴァルキュリア2のコゼットとリコリスが絞首刑で処刑されて吊るされてる絵と\nそのあと吊るされたまま死姦されてる絵をお願いしたいです。\n\n二人の背景としては二人とも捕虜となりレイプされたあと処刑された感じです\n\n死体の状態(処刑後)\n死んで間もない状態で、二人とも裸です\n手は後ろで縛られてます\n舌をだらしなく出して涙や涎が垂れてます。\n目は半分くらい上を向いてます。\n二人とも陰毛が生えておりコゼットの方は剛毛です。\n\n死体の状態(死姦時)\nすでに数日すぎて肌の色も変色してきてハエもとんでもます少しウジも沸いてます\nお腹の子宮あたりくらいの場所から精子が外に出てきてます\nコゼットの右眼は腐って垂れそうになってます。\nリコリスは両目が無くなり眼孔から精子が垂れてます\n\n\n絵の最終的な枚数、セリフなどを入れる、他の細かい部分は先生にお任せします\nご検討のほどお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/11", "thumbnail_src": "https://si.imgix.net/50fbaf35/uploads/origins/d5ba8df6-1557-4d07-8299-34d87495dc60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ed465dc8d0b4303727daa3529d464cc", "thumbnail_srcset": "https://si.imgix.net/50fbaf35/uploads/origins/d5ba8df6-1557-4d07-8299-34d87495dc60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ed465dc8d0b4303727daa3529d464cc, https://si.imgix.net/50fbaf35/uploads/origins/d5ba8df6-1557-4d07-8299-34d87495dc60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6586c7e9daa81440b8b783b16901c24 2x, https://si.imgix.net/50fbaf35/uploads/origins/d5ba8df6-1557-4d07-8299-34d87495dc60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c32c3c9363bf5ce329bf868f8e104f4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/10", "thumbnail_src": "https://si.imgix.net/03b3c706/uploads/origins/319c0977-b079-485c-a046-899ec86a39f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bae4cf4a62a01073b4a75d50809b3f39", "thumbnail_srcset": "https://si.imgix.net/03b3c706/uploads/origins/319c0977-b079-485c-a046-899ec86a39f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bae4cf4a62a01073b4a75d50809b3f39, https://si.imgix.net/03b3c706/uploads/origins/319c0977-b079-485c-a046-899ec86a39f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d82635ddf13daa4b0a9ecbc9008b9bb6 2x, https://si.imgix.net/03b3c706/uploads/origins/319c0977-b079-485c-a046-899ec86a39f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=756924c92ef730d72b32c49720a96149 3x", "genre": "art", "nsfw": true, "body": "SNSで事前・事後報告のシチュがとても好きです。今回、GTAの石神のぞみさんで同じような感じでお願いしたいです。\n・GTAの石神さんが牛柄衣装で野球場のビールの売り子さんのように生搾り母乳を売り歩くというシチュ（近いシチュとしてはpixiv大百科で母乳鉄砲とされているものです）胸だけ露出していて、両胸に装着された搾乳器から背中のミルクサーバーに母乳が送られていて、そこからコップに注いでくれる感じです。\n羞恥というよりは仕事としてしっかり稼ごうとしている感じです。\nSNSで「今日はお店を飛び出してミルクを売り歩くよ～！ぜひ買いに来てね～！」みたいな文章と一緒に写真が投稿されている感じでお願いします。\n↓\n・ミルク売り歩いていると路地裏に連れ込まれて生ハメレイプされて中出しされてしまった石神さん。体位などはおまかせしますが、搾乳機が外れて母乳が噴き出していると嬉しいです。\nSNSで「みんなごめ～ん！路地裏に連れ込まれて生ハメレイプされちゃって今日の母乳屋さん閉店しましたぁ～。今も連れ込まれて生ハメされてるからしばらく無理かも～！それにしても母乳の出が前より良くなったんだけど、もしかしてこれ孕んじゃってない…？？」みたいな文章\n\n\n文章などはベーコンさんのセンスで適宜変更いただいて大丈夫です。よろしくお願いいたします。\n\nhttps://dic.pixiv.net/a/%E6%AF%8D%E4%B9%B3%E9%89%84%E7%A0%B2", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/9", "thumbnail_src": "https://si.imgix.net/44cd714d/uploads/origins/9021a7d5-3662-4d22-bfdd-e7322ce9aa68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20fc04bcd93603ba789b278e8b63a9fc", "thumbnail_srcset": "https://si.imgix.net/44cd714d/uploads/origins/9021a7d5-3662-4d22-bfdd-e7322ce9aa68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20fc04bcd93603ba789b278e8b63a9fc, https://si.imgix.net/44cd714d/uploads/origins/9021a7d5-3662-4d22-bfdd-e7322ce9aa68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7012995b144df946c2096e48669c07be 2x, https://si.imgix.net/44cd714d/uploads/origins/9021a7d5-3662-4d22-bfdd-e7322ce9aa68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb79e24445e958cacc09b2f799a009bc 3x", "genre": "art", "nsfw": true, "body": "スターオーシャンのカーリン・ケイソンのイラストをお願いします。\n最初に大きなチンコで目を隠しています。\n彼女はひょっとこフェラをしています。\nパートナーは彼女のツインテールをイルマチオで押さえている。\nツンデレなのであまり見せないが、結構楽しんでいる。\n怒ったような目で相手を見ながらも、顔を赤くして興奮している。\nカーリンはこのような扱いをされるのが大好きで、フェラチオをされながら唾液をたっぷり使うようにしている。\n鼻の穴から少し精液を溢れさせながら、パートナーは彼女の口の中に精液を出す。\n彼女の乳房を描く場合は、乳房の上部に注意してください。彼女には不思議なタトゥーがある。でも、乳房を見せる必要はない。\n\nhttps://drive.google.com/drive/folders/11InznrTWti_68YFEwys4nOWozcLCc6ja?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/8", "thumbnail_src": "https://si.imgix.net/cb038d1b/uploads/origins/8290c8fc-db2e-4650-8639-e2efbb6446b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d833a2d04b85e4442d1da97e3c62337", "thumbnail_srcset": "https://si.imgix.net/cb038d1b/uploads/origins/8290c8fc-db2e-4650-8639-e2efbb6446b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d833a2d04b85e4442d1da97e3c62337, https://si.imgix.net/cb038d1b/uploads/origins/8290c8fc-db2e-4650-8639-e2efbb6446b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b33e8510d0c721f1ebaff8dce0f2879a 2x, https://si.imgix.net/cb038d1b/uploads/origins/8290c8fc-db2e-4650-8639-e2efbb6446b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3067ea40fce397282f0b0efc45b42d6 3x", "genre": "art", "nsfw": true, "body": "コミケお疲れ様です。\n脳姦貫通のイラストを依頼したい所存です。\n\n参考資料のURL：\nhttps://www.dropbox.com/scl/fo/osypee1am2mjo1f0oip17/AEN7WIVjDzwOFnjrCrd6Uq0?rlkey=5nw2zthhuow0f4sr351l98gc3&st=dpjccffu&dl=0\n\nキャラは『艦これ』の榛名改二と『アイドルマスター』の四条貴音です。\n自分の一番好きなキャラの組み合わせです。\n\n二人は脳がおちんぽに貫通されて絶命し、最後に腐乱化するというシナリオです【参考図1∼5】。\n\nおっぱいの露出も見たいでの、腰ぐらいまで描いてください。全身を描いていただけますと嬉しいです\nそしておっぱい露出のために、衣装は破損の状態【参考図6】です。全身の場合、パンツの露出もお願いします。\n\n榛名は公式の改二巫女服です。艤装は不要です。\n四条貴音はRe:FLAMEの衣装ですが、ポニーテールも追加してください。\n\n腐乱前の最後の一枚に、顔に赤いバツ符号【参考図7】、おっぱいに淫紋（赤色）【参考図8】を追加してください。\n\nセリフなどほかの事項は先生にお任せします。\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/7", "thumbnail_src": "https://si.imgix.net/45da4a6f/uploads/origins/ca0bf63e-dd5f-4127-b704-1214f7ee388f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697f9c403642ed9fd0ef3c1ec8a43768", "thumbnail_srcset": "https://si.imgix.net/45da4a6f/uploads/origins/ca0bf63e-dd5f-4127-b704-1214f7ee388f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=697f9c403642ed9fd0ef3c1ec8a43768, https://si.imgix.net/45da4a6f/uploads/origins/ca0bf63e-dd5f-4127-b704-1214f7ee388f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960e3f41f6ed0fca23107397a8cf67cc 2x, https://si.imgix.net/45da4a6f/uploads/origins/ca0bf63e-dd5f-4127-b704-1214f7ee388f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c9c032906d1187b2b308af4b32f0be8 3x", "genre": "art", "nsfw": true, "body": "過去のCG集ベロスナで書かれていた、口を掴まれてオナホのように使われる雪子がすごく好きなので、それに近いイメージでリクエストさせて頂きます。\n・キャラクター\n→ペルソナ4のりせ、千枝（、直斗、雪子）\n※カッコ内の2キャラは、可能な範囲で追加してください。\n→服装は制服、必要に応じて一部脱ぎや剥ぎ\n・竿役\n→汚くて臭そうな浮浪者のおっさん達\n・シチュ\n→画面を二つに分けて顔部分と下半身部分をそれぞれ描写、キャラは横に並べる\n→顔部分はテレビから出し、口をオナホのように使われてくっさいチンカスチンポを強制お掃除\n→下半身部分はバックから突かれる。りせは蒸れた足裏が見える感じに固定していただけると嬉しいです。\n→ベロスナはビッチ化していましたが、今回は、最初は絶対に負けない！な抵抗から始まるものの、臭いチンポとチンカスとザーメンで躾けられて肉便器化する流れでお願いします\n→りせや雪子は、口内射精後に鼻射されて臭い漬け、スメルアクメをキめる変態性癖を植え付けてあげて欲しいです\n→千枝と直斗は、口をしつこく犯されてフェラするだけでイく身体にしてあげてください。\n→千枝や雪子のスパッツやタイツはムレムレな感じでお願いします。また、りせの蒸れたくっさい足裏も含め、セリフ付与が可能であれば、匂いを指摘して辱めてあげてください。\n→抜け陰毛や竿へのルージュリングやキスマークの付与、学生証晒し等、色々と装飾して頂ければと思います。\n・その他の事項\n→セリフ付与やPSD納品が可能であればお願いします\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/6", "thumbnail_src": "https://si.imgix.net/177e52ff/uploads/origins/32982513-5770-4671-a781-7586988f11ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0532b499dfb2c256b327ca4f25a1ccf", "thumbnail_srcset": "https://si.imgix.net/177e52ff/uploads/origins/32982513-5770-4671-a781-7586988f11ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0532b499dfb2c256b327ca4f25a1ccf, https://si.imgix.net/177e52ff/uploads/origins/32982513-5770-4671-a781-7586988f11ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0bd0d23c1dc1ca6362db787b86bf5cb 2x, https://si.imgix.net/177e52ff/uploads/origins/32982513-5770-4671-a781-7586988f11ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3582601b72bead7bfdb35bd675a9ff3 3x", "genre": "art", "nsfw": true, "body": "キャラクター：「ONI」このこ\n\n服装と容姿：\nhttps://imgur.com/a/Whn8P7B\n\n依頼したいシーン：\n蹲踞姿勢で自分の銃を口に突っ込んで自決するシーンをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/5", "thumbnail_src": "https://si.imgix.net/99d185f4/uploads/origins/66903472-398a-40fd-87eb-fdc484539197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbf168497fb20d77b5f2161935fe9217", "thumbnail_srcset": "https://si.imgix.net/99d185f4/uploads/origins/66903472-398a-40fd-87eb-fdc484539197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbf168497fb20d77b5f2161935fe9217, https://si.imgix.net/99d185f4/uploads/origins/66903472-398a-40fd-87eb-fdc484539197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08ab4b51c9e3a8f9f298411bc656a383 2x, https://si.imgix.net/99d185f4/uploads/origins/66903472-398a-40fd-87eb-fdc484539197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d9cdb4e16b3ce96ba5cff96b6b15094 3x", "genre": "art", "nsfw": true, "body": "初めまして、pixivに投稿されているましろメメのイラストが好みだったのでリスエストいたしました。\n下記キャラクターのnsfwイラストお願いできますでしょうか。\n\n概要\n9Sのひょっとこフェラ\n\nキャラクター\n9S（NieR:Automata)\n\n衣装\nデフォルト衣装、目隠しあり", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/4", "thumbnail_src": "https://si.imgix.net/875931a9/uploads/origins/c9f32766-c645-436f-8655-4f323d91453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c4be070ed4590108e9530926d3759a", "thumbnail_srcset": "https://si.imgix.net/875931a9/uploads/origins/c9f32766-c645-436f-8655-4f323d91453f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30c4be070ed4590108e9530926d3759a, https://si.imgix.net/875931a9/uploads/origins/c9f32766-c645-436f-8655-4f323d91453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b31d2c8c900199085ff0c97b814f832c 2x, https://si.imgix.net/875931a9/uploads/origins/c9f32766-c645-436f-8655-4f323d91453f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14b1c1fad5c390312b1903cfe6aee5e7 3x", "genre": "art", "nsfw": true, "body": "初めまして、日頃Ｖの作品を楽しませて頂いております。\nリクエストをお願いしたく何卒ご検討よろしくお願いいたします。\n\n■キャラクター\nにじさんじの夜見れなさん、葉加瀬冬雪さんを初期衣装でお願いします。\n\n■内容\n・過去作の乳山ズリのイメージでSMC組でＷパイズリフェラしているイラストをお願いします\n　https://www.pixiv.net/artworks/78887390\n・葉加瀬は服をまくりあげる等胸は露出していると嬉しいです\n・竿役はズボン周りの描写で問題ありません\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/3", "thumbnail_src": "https://si.imgix.net/7079b2c9/uploads/origins/3b0dcb4a-6f40-491a-bd25-094864d3a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45ad19806eee3423f07ad9a3ba766085", "thumbnail_srcset": "https://si.imgix.net/7079b2c9/uploads/origins/3b0dcb4a-6f40-491a-bd25-094864d3a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45ad19806eee3423f07ad9a3ba766085, https://si.imgix.net/7079b2c9/uploads/origins/3b0dcb4a-6f40-491a-bd25-094864d3a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f3f27d7b07618a77b0fd91a2097546e 2x, https://si.imgix.net/7079b2c9/uploads/origins/3b0dcb4a-6f40-491a-bd25-094864d3a40c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96244c70be5b56b2608174c584dfe082 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエストをお送りさせていただきます。\n\n▽キャラ\n鉄拳シリーズのキャラ、風間飛鳥を描いていただきたいです。\n\n▽シチュエーション\n飛鳥が男2人組にナンパされ、懲らしめてやろうと誘いに乗ったふりでラブホテルに行くも返り討ちで3Pでハメられているところをお願いします。\n\n▽衣装・体型\n飛鳥の衣装は鉄拳5～7のゲーム中コスチュームの青ハーフトップ＆ツナギでお願いします。\n体型は巨乳で、身体は格闘家らしく鍛えられている感じ、オッパイは露出した状態でお願いします。\n竿役は屈強なヤリチン風で全裸のイメージです。\n\n▽その他\n可能でしたら射精差分と、台詞テキストをお願いいたします。\n\nご検討いただければ幸いです。\nどうかよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/2", "thumbnail_src": "https://si.imgix.net/a2719514/uploads/origins/3135ec16-3b09-43d1-87ba-f3399ea52cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea6a357662bf4c7f9d3d2180fa972e7", "thumbnail_srcset": "https://si.imgix.net/a2719514/uploads/origins/3135ec16-3b09-43d1-87ba-f3399ea52cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cea6a357662bf4c7f9d3d2180fa972e7, https://si.imgix.net/a2719514/uploads/origins/3135ec16-3b09-43d1-87ba-f3399ea52cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42a862c6b6595e3b6dec074cf3908127 2x, https://si.imgix.net/a2719514/uploads/origins/3135ec16-3b09-43d1-87ba-f3399ea52cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=841d8ae2513e3f6915bf10985900dc52 3x", "genre": "art", "nsfw": true, "body": "いつも最高の作品をありがとうございます。\n下記のとおりリクエストいたします。\n○キャラ\n・ポケモンのトウコとメイ\n・服は胸出し半脱ぎ\n○シチュ概要\n・レズキスしている所にロケット団の汚っさん達が乱入し、さいみんじゅつによって認識改変される\n・極太のくっさいチンカスチンポを、レズキス挟まりチンカスお掃除フェラさせられる\n・周りにもくっさいチンカスチンポ包囲網、いくつかは手コキ(メイ)や、雌蒸れ腋コキ(トウコ)、髪コキ(両方)など\n・もう片方の手(イメージは画面奥側)で相方の股間や胸をいじる\n(メイ→トウコ：胸、トウコ→メイ：股間)\n・射精とともにアヘ顔、お互いへの好意がロケット団に向かうよう認識改変完了、メイは潮吹き大量でタイツに染み、トウコは噴乳\n・認識改変後の丹念なチンカスお掃除フェラ、臭いや味が無くなるまでしゃぶる\n○その他\n・いくつか書かれているレズキス絵を意識しています\n・舌を絡ませたしゃぶりでお願いします\n・体勢は立ちや、可能なら蹲踞等でお願いします\n・マスカラ落ちはキャラ的に良さそうであればお願いします。\n・セリフは可能であればお願いします。\n・PSD納品希望です。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@bekon15/works/1", "thumbnail_src": "https://si.imgix.net/a34b965f/uploads/origins/09792e95-78e8-4f5f-b9b2-3918cddd9c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=291e864f285746e2e139da9ff57e9a38", "thumbnail_srcset": "https://si.imgix.net/a34b965f/uploads/origins/09792e95-78e8-4f5f-b9b2-3918cddd9c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=291e864f285746e2e139da9ff57e9a38, https://si.imgix.net/a34b965f/uploads/origins/09792e95-78e8-4f5f-b9b2-3918cddd9c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30c89a8f9c186efacdc4d03727d16f5d 2x, https://si.imgix.net/a34b965f/uploads/origins/09792e95-78e8-4f5f-b9b2-3918cddd9c8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d17d74769f2ca80ea78b23409255d693 3x", "genre": "art", "nsfw": true, "body": "遊戯王\nブラックマジシャンガール\nhttps://www.pixiv.net/artworks/30244545これの続きな感じでフェラさせたい\n服の脱がし具合は同じにしたい(胸出し、パンツ無し)\nぶっかけ差分と口内射精差分もお願いします", "created_at": "", "completed_at": ""}]}