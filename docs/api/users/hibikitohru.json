dd5-9f83-2fe0954928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a44657399e79a40bf52dd64aa5468eb", "thumbnail_srcset": "https://si.imgix.net/9f0a6678/uploads/origins/bbcd9b4f-5b11-4dd5-9f83-2fe0954928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a44657399e79a40bf52dd64aa5468eb, https://si.imgix.net/9f0a6678/uploads/origins/bbcd9b4f-5b11-4dd5-9f83-2fe0954928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd65da0046d0d0a36cfc7e2562b8d9d7 2x, https://si.imgix.net/9f0a6678/uploads/origins/bbcd9b4f-5b11-4dd5-9f83-2fe0954928c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=061c2a36507e39faa9325b1395604c33 3x", "genre": "art", "nsfw": false, "body": "いつも素敵なイラストを拝見しております！\nもしよろしければ、[やさしい木漏れ日]特訓前の美穂ちゃんと[Blooming days]特訓前(デレステ内SR)の智絵里ちゃんのイラストをお願いできますでしょうか。\n\n涼やか・爽やかな初夏のお出かけ、というイメージでかわいらしい感じでお願いできれば嬉しいです。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/22", "thumbnail_src": "https://si.imgix.net/d9a2ba94/uploads/origins/6a656d61-030f-4ba7-b39a-047ca09cf79d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca26423a3855ea84a02ff4d8d7b290b7", "thumbnail_srcset": "https://si.imgix.net/d9a2ba94/uploads/origins/6a656d61-030f-4ba7-b39a-047ca09cf79d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca26423a3855ea84a02ff4d8d7b290b7, https://si.imgix.net/d9a2ba94/uploads/origins/6a656d61-030f-4ba7-b39a-047ca09cf79d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaf0319352bb7f4811008565dda7635f 2x, https://si.imgix.net/d9a2ba94/uploads/origins/6a656d61-030f-4ba7-b39a-047ca09cf79d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4935f6f708078235f5e46d31f6c91e0 3x", "genre": "art", "nsfw": false, "body": "■作品・キャラクター：アイドルマスターシンデレラガールズの小日向美穂、乙倉悠貴\n■衣装：デレステの衣装「がんばろ！フィットネスウェア」(美穂と悠貴の二人はゲーム内では着用不可)\n■シチュエーション：二人でダンスレッスンをしている様子。屋内、屋外などはお任せします。\n■雰囲気：二人とも明るい笑顔で、汗が弾けるような爽やかな雰囲気\n\n元気いっぱいのソラーナ・チーカの二人を是非ひびき透さんに描いていただきたく、よろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/21", "thumbnail_src": "https://si.imgix.net/e456b720/uploads/origins/da5dfc0b-a5be-446e-827c-deeed1c3431a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b57eb49c859d7a2fefc269afc0996b2", "thumbnail_srcset": "https://si.imgix.net/e456b720/uploads/origins/da5dfc0b-a5be-446e-827c-deeed1c3431a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b57eb49c859d7a2fefc269afc0996b2, https://si.imgix.net/e456b720/uploads/origins/da5dfc0b-a5be-446e-827c-deeed1c3431a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=321573f23f52e9c44f77434d758002e5 2x, https://si.imgix.net/e456b720/uploads/origins/da5dfc0b-a5be-446e-827c-deeed1c3431a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92a5024789dfd8dd3bdb77ddbf80b0b1 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nもしよろしければ、アイドルマスターシンデレラガールズの小日向美穂ちゃんのイラストを描いていただけないでしょうか。\nシチュエーションは大河ドラマの収録中で衣装はSSRの「とこしえの想い」の特訓後のような感じでお願い致します。\n構図等はお任せ致します。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/20", "thumbnail_src": "https://si.imgix.net/5102c1ff/uploads/origins/117926fb-b672-4e64-ac5e-47dcbf417cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b36d79cfde4a38d959a167d0cf998aa9", "thumbnail_srcset": "https://si.imgix.net/5102c1ff/uploads/origins/117926fb-b672-4e64-ac5e-47dcbf417cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b36d79cfde4a38d959a167d0cf998aa9, https://si.imgix.net/5102c1ff/uploads/origins/117926fb-b672-4e64-ac5e-47dcbf417cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c25ab841d8ed8841694a684b280b3325 2x, https://si.imgix.net/5102c1ff/uploads/origins/117926fb-b672-4e64-ac5e-47dcbf417cf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=309ac2ef198377edd4c5cfacdb5388e9 3x", "genre": "art", "nsfw": false, "body": "■作品・キャラクター：ウマ娘のニシノフラワー\n■シチュエーション・衣装：勝負服のニシノフラワーがお花（デイジー）を愛でながら微笑んでいるところ\n\n以前描かれていたイラスト（下記）の柔らかい表情がとても素敵でしたので、近しいシチュエーションとなってしまいますが、ひびき透さんの描くニシノフラワーちゃんも見たいと思いリクエストします。\nhttps://www.pixiv.net/artworks/80545218\n\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/19", "thumbnail_src": "https://si.imgix.net/cbd713aa/uploads/origins/73ccc4fc-80ad-4b8a-90ce-2e85103e53aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454ef81e8a48709ca92e63bec6d3ca3b", "thumbnail_srcset": "https://si.imgix.net/cbd713aa/uploads/origins/73ccc4fc-80ad-4b8a-90ce-2e85103e53aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=454ef81e8a48709ca92e63bec6d3ca3b, https://si.imgix.net/cbd713aa/uploads/origins/73ccc4fc-80ad-4b8a-90ce-2e85103e53aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f09fa7e3dc64af5f3cd0529af421bbf 2x, https://si.imgix.net/cbd713aa/uploads/origins/73ccc4fc-80ad-4b8a-90ce-2e85103e53aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55945a1b08669bcc3d7a021426ebd28c 3x", "genre": "art", "nsfw": false, "body": "いつもイラスト拝見させてもらってます。\nピンキーキュート（卯月美穂智絵里）のイラストを依頼したいです。\n私服の服装だとありがたいです。\nその他構図などはお任せしますが可愛らしさが伝わってくるのだとありがたいです。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/18", "thumbnail_src": "https://si.imgix.net/8f83898a/uploads/origins/257d92d7-956a-4ff9-9446-087a6bb3baf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d3f79e24577e4deeb0e3b3d18286402", "thumbnail_srcset": "https://si.imgix.net/8f83898a/uploads/origins/257d92d7-956a-4ff9-9446-087a6bb3baf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d3f79e24577e4deeb0e3b3d18286402, https://si.imgix.net/8f83898a/uploads/origins/257d92d7-956a-4ff9-9446-087a6bb3baf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a1d0450d64b64e10e9ec5c0a5c284e8 2x, https://si.imgix.net/8f83898a/uploads/origins/257d92d7-956a-4ff9-9446-087a6bb3baf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44ce61bde4583e4e22c449fdc887daf4 3x", "genre": "art", "nsfw": false, "body": "■作品・キャラクター：ウマ娘のスーパークリーク\n■シチュエーション・衣装：勝負服のスーパークリークがトレーナーを甘やかしているところ\n\nトレーナーを目一杯甘やかすスーパークリークが見たいです！\nよろしければお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/17", "thumbnail_src": "https://si.imgix.net/13142456/uploads/origins/15b145a5-a81d-4a68-98fc-6b825a4f0f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b36b0a5c807918e8516cb4ceb00b3624", "thumbnail_srcset": "https://si.imgix.net/13142456/uploads/origins/15b145a5-a81d-4a68-98fc-6b825a4f0f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b36b0a5c807918e8516cb4ceb00b3624, https://si.imgix.net/13142456/uploads/origins/15b145a5-a81d-4a68-98fc-6b825a4f0f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c14d8051f4fb13459df8dfc52c30646 2x, https://si.imgix.net/13142456/uploads/origins/15b145a5-a81d-4a68-98fc-6b825a4f0f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d15bd52a474fa494554fbc9e0c517a8 3x", "genre": "art", "nsfw": false, "body": "アイドルマスターシンデレラガールズの道明寺歌鈴ちゃんと小日向美穂ちゃんのイラストをお願いいたします。\n2人の衣装は「Home Sweet Home」の衣装、シチュエーションは歌鈴ちゃんのHome Sweet Homeのカードのような形でお願いできればと思います。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/16", "thumbnail_src": "https://si.imgix.net/9ccfd6dc/uploads/origins/9ceb076c-fd1b-48db-a0f9-3fb78a08a05d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e3cd5b6365b3354c9f70bd49013227c", "thumbnail_srcset": "https://si.imgix.net/9ccfd6dc/uploads/origins/9ceb076c-fd1b-48db-a0f9-3fb78a08a05d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e3cd5b6365b3354c9f70bd49013227c, https://si.imgix.net/9ccfd6dc/uploads/origins/9ceb076c-fd1b-48db-a0f9-3fb78a08a05d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45dd4735525b9dab640f251cea6f6160 2x, https://si.imgix.net/9ccfd6dc/uploads/origins/9ceb076c-fd1b-48db-a0f9-3fb78a08a05d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a8c08e0828c1964e86ab906757eb4bf 3x", "genre": "art", "nsfw": false, "body": "いつも可愛いイラスト拝見しております！\nハロウィンうぃっち美穂ちゃん(特訓後)とうさぎさんわーるど智絵里ちゃん(特訓後)で、メルヘンな感じのイラストをお願いしたいです！\n細かいところはお任せします、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/15", "thumbnail_src": "https://si.imgix.net/9475dfca/uploads/origins/c0d0b58c-ce7d-400a-82b5-7216ddaa0e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b56f86fb2efc1fbb9d56b8997865ad", "thumbnail_srcset": "https://si.imgix.net/9475dfca/uploads/origins/c0d0b58c-ce7d-400a-82b5-7216ddaa0e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b56f86fb2efc1fbb9d56b8997865ad, https://si.imgix.net/9475dfca/uploads/origins/c0d0b58c-ce7d-400a-82b5-7216ddaa0e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2b48e3b11dc69b8ab9820148ae6aba4 2x, https://si.imgix.net/9475dfca/uploads/origins/c0d0b58c-ce7d-400a-82b5-7216ddaa0e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ef7cad021cd6934494b133a90c30896 3x", "genre": "art", "nsfw": false, "body": "先日は素敵なイラストありがとうございました。\n今回、ひびき透さんが描いたチャイナドレスを着ている『ららマジ』の楓智美が見てみたいのでリクエストしました。\n\n赤面して恥ずかしがっている様子かカッコよく決めている様子ですと助かります。\nその他はお任せします。どうぞよろしくお願いします。\n\nhttps://twitter.com/tnzreg/status/1287308538285441026?s=20&t=Y39ybJZD7Sa6gqZPCL86Gw", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/14", "thumbnail_src": "https://si.imgix.net/038dc130/uploads/origins/328620b2-bfc6-451e-b827-0c183a4886e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8634d8c2bde294ab68b5f86b18b24d54", "thumbnail_srcset": "https://si.imgix.net/038dc130/uploads/origins/328620b2-bfc6-451e-b827-0c183a4886e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8634d8c2bde294ab68b5f86b18b24d54, https://si.imgix.net/038dc130/uploads/origins/328620b2-bfc6-451e-b827-0c183a4886e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48b8eb02c2fc6a95389d317bb54b5877 2x, https://si.imgix.net/038dc130/uploads/origins/328620b2-bfc6-451e-b827-0c183a4886e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1a722dc050b9f81e8c43514817281e5 3x", "genre": "art", "nsfw": false, "body": "■作品・キャラクター：アイドルマスターシンデレラガールズのイヴ・サンタクロース\n■シチュエーション・衣装：水着(オリジナルでも既存カード衣装でも)\n\n以前、聖ちゃん、クラリスさんと水着衣装の依頼をさせていただいた者です。\n今度は、ひびき透さんの描くイヴさんの水着姿を是非見たいと思いリクエストさせていただきます。\nよろしければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/13", "thumbnail_src": "https://si.imgix.net/a2f4538e/uploads/origins/1c725e05-8a82-4f7a-b5c5-7cd1dc44e122?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1a7a3698f16e6573bbc858550ca7e8", "thumbnail_srcset": "https://si.imgix.net/a2f4538e/uploads/origins/1c725e05-8a82-4f7a-b5c5-7cd1dc44e122?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a1a7a3698f16e6573bbc858550ca7e8, https://si.imgix.net/a2f4538e/uploads/origins/1c725e05-8a82-4f7a-b5c5-7cd1dc44e122?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4c90fdcdb12463ee30154920c92cf59 2x, https://si.imgix.net/a2f4538e/uploads/origins/1c725e05-8a82-4f7a-b5c5-7cd1dc44e122?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dc6e77fc2338ebd3f3c333a21d400b7 3x", "genre": "art", "nsfw": false, "body": "はじめまして、ひびき透さんの描く素敵なイラストが好きでリクエストしました。\n\nジャンル外になって申し訳ないのですが、『ららマジ』の卯月真中華がエプロン姿でこちらに微笑みかけているイラストをお願いします。\n\n差し支えなければ完成したイラストはTwitterやpixivでも公開して頂けると嬉しいです。\nその他はお任せします。どうぞお願いします。\n\nhttps://twitter.com/tnzreg/status/1280743764042977280?s=21", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/12", "thumbnail_src": "https://si.imgix.net/a216994a/uploads/origins/fb2551c1-b319-4229-9e76-be2fba8acec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e61cb999b32b79b3f56e9d771cedd5f3", "thumbnail_srcset": "https://si.imgix.net/a216994a/uploads/origins/fb2551c1-b319-4229-9e76-be2fba8acec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e61cb999b32b79b3f56e9d771cedd5f3, https://si.imgix.net/a216994a/uploads/origins/fb2551c1-b319-4229-9e76-be2fba8acec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb762d4d64566c5ccd103ba3ba55ed55 2x, https://si.imgix.net/a216994a/uploads/origins/fb2551c1-b319-4229-9e76-be2fba8acec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3730b505d32c44843a7f0babcdc407f0 3x", "genre": "art", "nsfw": false, "body": "■作品・キャラクター：アイドルマスターシンデレラガールズのクラリス\n■シチュエーション・衣装：水着(あるいは水着風衣装)\n普段はなかなか見せることのないクラリスさんの水着姿をひびき透さんのイラストで見たく…。\n少し恥ずかしがっている描写があると嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/11", "thumbnail_src": "https://si.imgix.net/c2fc3666/uploads/origins/2fa3ec9f-2596-4716-a482-7dfb4b2d99cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aec1eebf386f1c3af19425ef5b71657", "thumbnail_srcset": "https://si.imgix.net/c2fc3666/uploads/origins/2fa3ec9f-2596-4716-a482-7dfb4b2d99cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aec1eebf386f1c3af19425ef5b71657, https://si.imgix.net/c2fc3666/uploads/origins/2fa3ec9f-2596-4716-a482-7dfb4b2d99cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d50186dafd2901a754bb59ce5fddbcec 2x, https://si.imgix.net/c2fc3666/uploads/origins/2fa3ec9f-2596-4716-a482-7dfb4b2d99cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b36fb0b8483980667e890339cb73607d 3x", "genre": "art", "nsfw": false, "body": "前回はかわいい小日向ちゃんの新妻イラストをありがとうございました。\n今回も小日向ちゃんのイラストをリクエストさせていただきます。\n\nシチュエーションは『かっこよくキメていたので壁ドンして秒で女の子に戻す』\n衣装は乙女の帰還の特訓後\n構図としては小さなコマでファンに向けてカッコよくしてるけど\n大きなコマで舞台裏or誰もいない楽屋で衣装のまま壁ドンしたら恥ずかしがってるor照れている状態になるといった感じ、プロデューサー目線でお願いします。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/10", "thumbnail_src": "https://si.imgix.net/f3e7b8ab/requests/183758_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=991981af54305f8c8bc09951f93d390b", "thumbnail_srcset": "https://si.imgix.net/f3e7b8ab/requests/183758_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=991981af54305f8c8bc09951f93d390b, https://si.imgix.net/f3e7b8ab/requests/183758_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67ef55c2459e3f3faa3b3c1a396142a4 2x, https://si.imgix.net/f3e7b8ab/requests/183758_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=329c37bce869d42c0c5314d9c8951a4e 3x", "genre": "art", "nsfw": false, "body": "お世話になります。\n小日向ちゃんのイラストをリクエストさせていただきます。\n\nシチュエーションは『新妻小日向ちゃんがお出迎え』\n愛しい妻の小日向ちゃんにエプロン姿で「おかえりなさい！」と笑顔で出迎えられたいです（願望\n差分か可能であれば「な、なんて・・・えへへ///」みたいな感じで顔を赤らめながら照れてると幸せです。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/9", "thumbnail_src": "https://si.imgix.net/4a202e88/requests/182906_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e0c277abba0afecf5cf416e11f6e27", "thumbnail_srcset": "https://si.imgix.net/4a202e88/requests/182906_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e0c277abba0afecf5cf416e11f6e27, https://si.imgix.net/4a202e88/requests/182906_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e69418c2d3911d41713259055c002f4 2x, https://si.imgix.net/4a202e88/requests/182906_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e663330ac02a39784baddc0af2d361e4 3x", "genre": "art", "nsfw": false, "body": "十時愛梨のはずむ花の湯特訓後と高森藍子のあたたかな居場所特訓後をお願いします。二人並んで和やかな雰囲気のものだと嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/8", "thumbnail_src": "https://si.imgix.net/a0cfba13/requests/181395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23cdd2976d5fe1443b1da9d180f05169", "thumbnail_srcset": "https://si.imgix.net/a0cfba13/requests/181395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23cdd2976d5fe1443b1da9d180f05169, https://si.imgix.net/a0cfba13/requests/181395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=478c45bbce2121161fc66c39629bb6f8 2x, https://si.imgix.net/a0cfba13/requests/181395_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2da1ae55e586d70b69e54ffa1f0d9e9 3x", "genre": "art", "nsfw": false, "body": "■作品・キャラクター：アイドルマスターシンデレラガールズの小日向美穂、神崎蘭子\n■衣装：ファンタジー世界風に、蘭子は魔王のような衣装で、美穂は勇者のような衣装でお願いします。(オリジナルでも既存カード絵でも)\n■構図：魔王蘭子　対　勇者美穂\n■雰囲気：シリアスでお願いします\n\n以前描かれていた蘭子のイラストの雰囲気がとても素敵でしたので、その時のようなシリアスな雰囲気の魔王蘭子と、それと対峙する勇者美穂をリクエストします。", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/7", "thumbnail_src": "https://si.imgix.net/09e7d291/requests/131040_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee9b198126ff490dad8f76d3149ec674", "thumbnail_srcset": "https://si.imgix.net/09e7d291/requests/131040_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee9b198126ff490dad8f76d3149ec674, https://si.imgix.net/09e7d291/requests/131040_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f356ca3727b170a4e57cc9d37f969404 2x, https://si.imgix.net/09e7d291/requests/131040_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69aed8507fb0b19368d1132d594e9401 3x", "genre": "art", "nsfw": false, "body": "■作品・キャラクター：アイドルマスターシンデレラガールズの小日向美穂、高森藍子\n■衣装：美穂は[ビタースイート・タイム]特訓後、藍子は[笑顔のレセプション]特訓後\n■シチュエーション：美穂は館の女主人、藍子は館のメイドという設定でお芝居中のワンシーン。館の女主人(美穂)が戯れにメイド(藍子)を誘惑して顎クイするシチュエーション。\n■構図：画面奥にいる美穂が画面手前の藍子を顎クイで誘惑している構図。美穂の表情が見えるよう、人物を配置ください。また、美穂と藍子は両名とも身長155cmですが、美穂が藍子を顎クイできるよう身長差はお芝居補正をかけて調整ください。\n■表情：美穂は余裕ある表情でクールな笑みを浮かべている様子。藍子は頬を赤らめている様子。藍子は構図的に表情が見えていなくても問題ありません。\n■その他：可能であれば、お芝居が終わった後に一息つくor恥ずかしがる美穂と藍子を一コマとして追加していただければ嬉しいです。\n\n女主人・美穂とメイド・藍子の組み合わせを是非ひびき透さんに描いてもらいたくリクエストします。\n人物数、服装、シチュエーション、構図等リクエストが多くなってしまいますが、よろしければお願いします…！", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/5", "thumbnail_src": "https://si.imgix.net/96c4def4/requests/114148_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff5a986ba9ab65c3c648a24c5799ab4", "thumbnail_srcset": "https://si.imgix.net/96c4def4/requests/114148_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff5a986ba9ab65c3c648a24c5799ab4, https://si.imgix.net/96c4def4/requests/114148_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cc40ab290b87284a41c768d10da90aa 2x, https://si.imgix.net/96c4def4/requests/114148_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff37b36e9120e7a69fe735e17caef252 3x", "genre": "art", "nsfw": false, "body": "アイドルマスターシンデレラガールズの望月聖\n水着(オリジナルでも既存カード絵でも)\n\nひじりん(13歳-150cm-B82-W59-H86)のおもち(B82)をもちもちにしてください！\nおもち以外ももちもちにしてくださると大変うれしいです！", "created_at": "", "completed_at": ""}, {"path": "/@hibikitohru/works/4", "thumbnail_src": "https://si.imgix.net/e88b1ddd/requests/95855_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662bca53dec32915e51a6e93ca0f4ec2", "thumbnail_srcset": "https://si.imgix.net/e88b1ddd/requests/95855_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=662bca53dec32915e51a6e93ca0f4ec2, https://si.imgix.net/e88b1ddd/requests/95855_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ad4fe13af1ac0e3b8b27a39fadce2e3 2x, https://si.imgix.net/e88b1ddd/requests/95855_0?bg=%23fff&auto=f