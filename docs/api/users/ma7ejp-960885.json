69-b4f5-62fe270a8093?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b17a54d469e503fb1f878123d0171be0", "thumbnail_srcset": "https://si.imgix.net/e048b480/uploads/origins/e243ea80-e872-4c69-b4f5-62fe270a8093?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b17a54d469e503fb1f878123d0171be0, https://si.imgix.net/e048b480/uploads/origins/e243ea80-e872-4c69-b4f5-62fe270a8093?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81f5158012a9e7db759a90764cad6588 2x, https://si.imgix.net/e048b480/uploads/origins/e243ea80-e872-4c69-b4f5-62fe270a8093?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59f26fde15d6ed53ab2d4a6f00e04141 3x", "genre": "art", "nsfw": false, "body": "はじめまして。VTuberの星飴あゆきと申します！コアラのツイートから飛んできました。AMRAさまの描く世界感がとても好きだと思いぜひ自分の姿を描いて欲しいと思いリクエストさせて頂きました。\n\n◆資料◆\n名前:星飴あゆき\nお菓子の国からやってた好奇心旺盛なVTuberです。悪戯っ子で元気なヤンデレです。\n見た目は資料をご参照ください。\n\n見落としやすそうな特徴として、瞳の中と毛先が長髪の場合はグラデーションカラーです。また性別内緒のため胸の膨らみは無しでお願い致します。\n\n◆リクエスト内容◆\n顔周りの髪の毛、頭が切れないように描いていただける助かります。\n髪型服装は自由に着替えさせていただいても大丈夫です。\n背景は透過のものも頂けるとうれしいです。\n\n◆ポーズ◆\nお任せ致します。\n\n◆表情◆\nお任せ致します。\n\nもし小物や背景、メッセージ等を描いていただける場合は人物とレイヤーを分けて、PSD形式かそれぞれをPNG形式で納品いただけるありがたいです\n\n◆使用目的◆Youtubeなど収益化済の動画サイトでの配信や動画内での使用や、配信や動画のサムネイルにて利用させていただきたいです。\nSNSでの宣伝等にも使わせて頂きたいです。\nまた利益の発生しないネットプリントでの使用も希望します。\nデジタル配布の待受(メンバーシップ加入者向け)などの使用もしたいです。\n無料素材の背景やフレームと組み合わせて使用することもあります。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10FB-4sCLAA7tnxUEIAm4h9XOiFsBO-lI", "created_at": "", "completed_at": ""}, {"path": "/@ma7ejp/works/6", "thumbnail_src": "https://si.imgix.net/4d62485c/uploads/origins/05368889-eacb-4b55-b281-eeefe1266d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b7fc7e9a1186ea7bedef9eee0925981", "thumbnail_srcset": "https://si.imgix.net/4d62485c/uploads/origins/05368889-eacb-4b55-b281-eeefe1266d80?bg=%2