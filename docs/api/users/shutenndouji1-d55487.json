adb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2423908327d7d70d86391ff2aca206e 2x, https://si.imgix.net/4dfe6ac3/uploads/origins/2a4d48b6-2db5-46ea-bcb6-391b919ddadb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ab3359ff06c00cf584185a6a1499729 3x", "genre": "art", "nsfw": false, "body": "こんにちは、またお会いできて嬉しいです。以前描いてくださった私のエルフのイラスト、そしてあなたの作品全般がとても気に入りました。もう一度彼女を描いていただけませんか？https://imgur.com/a/ClDsdHtどんなポーズや衣装でも、あなたが適切と思われるものなら何でも大丈夫です。良い一日を", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/130", "thumbnail_src": "https://si.imgix.net/5d102d39/uploads/origins/e67f35eb-d640-4dd1-88a6-1d831a4b79de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759751c9e24e96f93367232806ce3903", "thumbnail_srcset": "https://si.imgix.net/5d102d39/uploads/origins/e67f35eb-d640-4dd1-88a6-1d831a4b79de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759751c9e24e96f93367232806ce3903, https://si.imgix.net/5d102d39/uploads/origins/e67f35eb-d640-4dd1-88a6-1d831a4b79de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=910825c01dce93977fc3d1a8b1e018ae 2x, https://si.imgix.net/5d102d39/uploads/origins/e67f35eb-d640-4dd1-88a6-1d831a4b79de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17417f244de7e68f8b7af6f5937d4d08 3x", "genre": "art", "nsfw": false, "body": "こんにちは、kenさん。新しい一年、よろしくお願いします。\n\n今回の依頼キャラはうちの新しいOC、ウォースパイトでございます。キャラ本体がすでにいますので、細かい部分を修正していただいて、指定のシーンを描いていただけるとは幸いです。\n\n修正のところ：目色は黄緑色に変更\n\nシーン参考：エースコンバットZEROの最後、ピクシーのシーン（よう相棒、まだ生きてるか?）\n座り方がご自由に、銃の部分は剣に変更してください。もしよければ、セリフもお願いします。\n\n「こんにちは、先輩。まだ、生きてるかい？」\n\nキャラクタと指定のシーンは、URLを参照してください。\n\nではまだ、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1DXv9kT3lUTI7TUIvLRP-eGUPQecbmGr8?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/129", "thumbnail_src": "https://si.imgix.net/416a48f7/uploads/origins/af655b60-b29a-4e77-9f51-475443f90aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1be64c9ebf8f294a49ae778662d9411c", "thumbnail_srcset": "https://si.imgix.net/416a48f7/uploads/origins/af655b60-b29a-4e77-9f51-475443f90aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1be64c9ebf8f294a49ae778662d9411c, https://si.imgix.net/416a48f7/uploads/origins/af655b60-b29a-4e77-9f51-475443f90aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2795794e57d75fb11cca07f6bb9b5549 2x, https://si.imgix.net/416a48f7/uploads/origins/af655b60-b29a-4e77-9f51-475443f90aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00ce7d16745c7495f577b6b74e73326c 3x", "genre": "art", "nsfw": false, "body": "すみません、前回はありがとうございました。今回も、衣装交換のイラストをリクエストしたいのですが、よろしいでしょうか？今回は、cv小澤亜季さん繋がりで、バンドリの氷川日菜と艦これの秋月の衣装交換のイラストをお願いします。秋月は日菜の初期のステージ衣装姿をしており、日菜は秋月の衣装（通常でも改二でもどちらか好きな方で構いません）と鉢巻を身につけています。髪型は、日菜も秋月も通常の髪型でお願いします。今回も、気に入ってくれたら嬉しいです。どうか、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/128", "thumbnail_src": "https://si.imgix.net/0db74b62/uploads/origins/a02a9987-5b09-4628-a056-17722a477666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2941063330c55f357ea50b72182b9de", "thumbnail_srcset": "https://si.imgix.net/0db74b62/uploads/origins/a02a9987-5b09-4628-a056-17722a477666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2941063330c55f357ea50b72182b9de, https://si.imgix.net/0db74b62/uploads/origins/a02a9987-5b09-4628-a056-17722a477666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=672da04f415a79fe53acdeae33ccf01f 2x, https://si.imgix.net/0db74b62/uploads/origins/a02a9987-5b09-4628-a056-17722a477666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9271f4c549b775ca01b4c1ff2da4f1f1 3x", "genre": "art", "nsfw": false, "body": "お久しぶりです、また依頼したいと思い、手数料無料期間中で依頼送らせて頂きました\n\n依頼内容は前回と同じくドールズフロントラインより、SV-98mod3とAR-15mod3で「武装メイド姿」です\n\n両名ともゲーム内でメイドスキン（SV−98は日本未実装）は有りますがデザインは寄せたりする必要はありません、今回もken様のセンスに頼ります\n\nシチュ前提としては夜の街の違法なお店に潜入捜査の内定の為着用し（そういう目的の危うい、肌色多めなデザインでお願いします）、荒事になる直前にメイド服のまま各種軍用装具（ギア）を上から付けて『パーティ』に戻る直前、のシチュで描いて頂ければ\n\n保持する銃に関しては原作通りにして貰いたいですが、装具デザインはそれっぽい、デザインと見栄えとメイド服とのギャップ優先としてもらえば\n\n参考として深井亮介氏「アームズノート」より、「パワードバニー」のイラストにかなり依頼影響されているため資料としてもらえば幸いです\n\nまたken様のセンスに頼る依頼となりますが、宜しければお願いします", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/127", "thumbnail_src": "https://si.imgix.net/32646371/uploads/origins/61008e94-989b-487b-8029-9aaa1bdaf05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e47b127bef2970fc9445a87c2b50f85", "thumbnail_srcset": "https://si.imgix.net/32646371/uploads/origins/61008e94-989b-487b-8029-9aaa1bdaf05b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e47b127bef2970fc9445a87c2b50f85, https://si.imgix.net/32646371/uploads/origins/61008e94-989b-487b-8029-9aaa1bdaf05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b4d3f3bc3a51477008b8460abfcc813 2x, https://si.imgix.net/32646371/uploads/origins/61008e94-989b-487b-8029-9aaa1bdaf05b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55e68a84a186249f4214969e5ea725cc 3x", "genre": "art", "nsfw": false, "body": "こんにちは！前回のイラスト、ありがとうございました！今回は、私の大好きなポッピとレムで、クリスマスをテーマにした作品をお願いしたいと思います。\n\nゼノブレイドクロニクル2のポッピQTπ。身長181cm。サンタのドレスを着て。https://www.pixiv.net/en/artworks/129534295、舌を少し出したキュートな笑顔もお願いします。\n\nRe:ゼロのレム。154cm）トナカイのコスチュームを着てもらいましょう。おちゃらけたコスチュームを着ているので、迷惑そうな顔をしているように。\n\n可能であれば、2人が隣り合って立ち、ポッピがレムの首や肩に腕を回すようにしてください。コスチュームと表現のリファレンスはURLの中にありますが、あなたが望むなら、自分でデザインしてもかまいません。\n\nポッピの参考：https://imgur.com/a/GZrRctO\n\nレムのリファレンス：https://imgur.com/a/L2cjno1\n\nコスチューム例：https://imgur.com/a/vv3Q5v5\n\n表現例：https://imgur.com/a/8QoNrbL\n\nポーズ：https://www.pixiv.net/en/artworks/135556087\n\n私の依頼を検討していただき、ありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/126", "thumbnail_src": "https://si.imgix.net/13ddfff6/uploads/origins/0ec4f10e-cd53-4a8c-9d31-0a39284c78d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a4a763d037b19b621165ad4c5bb66b", "thumbnail_srcset": "https://si.imgix.net/13ddfff6/uploads/origins/0ec4f10e-cd53-4a8c-9d31-0a39284c78d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7a4a763d037b19b621165ad4c5bb66b, https://si.imgix.net/13ddfff6/uploads/origins/0ec4f10e-cd53-4a8c-9d31-0a39284c78d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b28fffff1e76ab129602f8f50d94542 2x, https://si.imgix.net/13ddfff6/uploads/origins/0ec4f10e-cd53-4a8c-9d31-0a39284c78d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b2fa9c71e2c5950187a34bf30265317 3x", "genre": "art", "nsfw": false, "body": "初めまして。私も、バンドリキャラと艦娘の衣装交換イラストをリクエストしたいのですが、よろしいでしょうか？リクエストしたいのは、バンドリの白鷺千聖と艦これの蒼龍の衣装交換イラストです。千聖は蒼龍改二の衣装と鉢巻をしており、蒼龍は千聖の初期のステージ衣装姿をしています。髪型に関しては、もし出来たら、千聖は蒼龍と同じツインテールで、蒼龍はツインテールを解いたロングヘアーでお願いします。もし気に入ってくれたら、検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/125", "thumbnail_src": "https://si.imgix.net/9ee1ab41/uploads/origins/4faa57d4-40bc-4257-8468-4c9cacd14276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e7fa279738677df9c6ea47a27b36139", "thumbnail_srcset": "https://si.imgix.net/9ee1ab41/uploads/origins/4faa57d4-40bc-4257-8468-4c9cacd14276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e7fa279738677df9c6ea47a27b36139, https://si.imgix.net/9ee1ab41/uploads/origins/4faa57d4-40bc-4257-8468-4c9cacd14276?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b45f3b1789b8b630351b2602e6419e8e 2x, https://si.imgix.net/9ee1ab41/uploads/origins/4faa57d4-40bc-4257-8468-4c9cacd14276?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8ec08d92b2d0bdc749e26eea91b4eaf 3x", "genre": "art", "nsfw": false, "body": "私の要望を考慮してくれてありがとう！\n\nあなたの絵が大好きなので、キャラクターを一人描いてほしいです！\n\nhttps://imgur.com/a/n9Qeuly。\n\n彼女は塔に住んでいるお姫様で、顔が呪われているので、人々を守るためにベールをかぶっています！彼女はとても優しくて、ロマンス小説を読むのが大好きで、ちょっとオタク（特に大型機械！）。彼女はとても庇護欲が強く、あまり人と会わない。\n\n好きなポーズと設定で描いてください！  ありがとうございました！\n\nhttps://imgur.com/a/n9Qeuly", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/124", "thumbnail_src": "https://si.imgix.net/b5baaa31/uploads/origins/92079920-b297-4ef9-84ef-0db44b911286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092a626f030d72ce7994cbccf924c9ca", "thumbnail_srcset": "https://si.imgix.net/b5baaa31/uploads/origins/92079920-b297-4ef9-84ef-0db44b911286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092a626f030d72ce7994cbccf924c9ca, https://si.imgix.net/b5baaa31/uploads/origins/92079920-b297-4ef9-84ef-0db44b911286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee3bdede00626f20e59ebbb7830a6a57 2x, https://si.imgix.net/b5baaa31/uploads/origins/92079920-b297-4ef9-84ef-0db44b911286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcfc027c81fede7c0b4b986390e3b7ee 3x", "genre": "art", "nsfw": true, "body": "『アークナイツ』のスプリアさんはランジェリー姿で腕を頭上に上げ、脇の下を露出している。", "created_at": "", "completed_at": ""}, {"path": "/@shutenndouji1/works/123", "thumbnail_src": "https://si.imgix.net/68158d94/uploads/origins/064ce369-e582-4699-8102-daad29279ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220f7039a04d2218c7befdf2b755eef2", "thumbnail_srcset": "https://si.imgix.net/68158d94/uploads/origins/064ce369-e582-4699-8102-daad29279ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=220f7039a04d2218c7befdf2b755eef2, https://si.imgix.net/68158d94/uploads/origins/064ce369-e582-4699-8102-daad29279ca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b80c0cab6eecff173f12d709520271c6 2x, https