2Ccenter&txtsize=30&txt=PRIVATE&s=e56a2f611d619b99c1b647604e7615e4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@arikawa44/works/264", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/890883bc/uploads/origins/e351475c-cadd-4ac4-b350-353eee1d7633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8cc608b8c81a1b6958d8d10688bf440", "thumbnail_srcset": "https://si.imgix.net/890883bc/uploads/origins/e351475c-cadd-4ac4-b350-353eee1d7633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8cc608b8c81a1b6958d8d10688bf440, https://si.imgix.net/890883bc/uploads/origins/e351475c-cadd-4ac4-b350-353eee1d7633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f5673d52482d642e00dd3161126af52 2x, https://si.imgix.net/890883bc/uploads/origins/e351475c-cadd-4ac4-b350-353eee1d7633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd4d45aee51d9d110b8f8bb5cd587183 3x", "genre": "art", "nsfw": true, "body": "キャラはデッドアイライブのかすみとあやねをお願いします。\n\n・シチュと構図は参考URLの画像のような感じで、ふたなり化したかすみ(右)があやね(左)に手コキされている様子。\n・かすみのコスはqk141601と同じで髪型は三つ編み、あやねのコスはqk163401と同じにしてください。\n・かすみは服の後ろ垂れ部分を右側によけてお尻丸出しになり、ペニスを太ももの間から出している。(両膝はくっついた状態に)\n・かすみはペニスとタマ全体を包み込んでくれる白無地のTバックを穿いていて、包み込まれたペニスの先は穴が空いてないフラットにしてほしいです。\n・あやねがかすみのTバックに包まれたペニスのカリ首を右手の親指と人差し指で作った輪っかでガッチリ掴んでしごいている。\n・さらに左手の人差し指でTバックの紐を引っ掛けて『クイッ！クイッ！』と吊り上げている。\n・引っ張られた極細Tバックがかすみのピンク色のアナルを縦に割っている状態を描いてほしいです。\n・アナルの形と大きさはqk143901と同じで、完全に紐がアナルの肉に挟み込まれて見えないくらい極限まで食い込ませてください。\n・今回も局部は修正がかからないように上手く誤魔化してください。 \n・qk157901のように背景は暗めの色にしてください。\n・表情など細かい部分はお任せします。 \n\n差分は以下の通りお願いします。\n・1枚目(非ふたなり) \n　サンプル用にペニスがないバージョンがほしいです。\n　あやねが右手の人差し指でかすみのパンティ越しに割れ目をなぞり、ゾクゾクさせている感じにしてほしいです。\n\n・2枚目(射精前)\n　あやねが『イカせてあげる』とサディステックな目つきでセルフパンコキし、かすみのズリセンTバックが肉棒と直腸に激しく擦りついて、カウパーを飛び散らしながら射精の快感を得ようと喘いでいる様子。\n\n・3枚目(射精中)\n　かすみが凄まじいアクメで白目を剥き舌を突き出しながらパンティ越しにトコロテン射精している様子。\n\n・4枚目(射精後)\n　かすみが大量のザーメンを床にぶちまけて悦に浸りアヘ顔を晒し、粘っこいザーメンがペニスの先から『ドロォ〜』っと垂れている様子。\n　あやねの手もザーメンまみれに汚れている様子を描いてください。\n\n・5〜8枚目\n　上記4枚のセミヌードバージョン(2人とも素手素足パンティだけ)がほしいです。\n\nhttps://www.dropbox.com/scl/fi/i4l43eeakepwt8y7fr1kl/IMG_0183.jpg?rlkey=dcx3qx2m6opsd0rkfqrt8p47x&st=6ax44n4v&raw=1", "created_at": "", "completed_at": ""}, {"path": "/@arikawa44/works/263", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/40bca8d4/uploads/origins/6bf733cc-97e5-4f16-a54b-54f87e3999ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fa64db972e06bda32be3ce2ea93d31f", "thumbnail_srcset": "https://si.imgix.net/40bca8d4/uploads/origins/6bf733cc-97e5-4f16-a54b-54f87e3999ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fa64db972e06bda32be3ce2ea93d31f, https://si.imgix.net/40bca8d4/uploads/origins/6bf733cc-97e5-4f16-a54b-54f87e3999ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cf198b14e26a3b6ba7c609c41a74565 2x, https://si.imgix.net/40bca8d4/uploads/origins/6bf733cc-97e5-4f16-a54b-54f87e3999ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46402af298b75c5ca8a7dc39294cae26 3x", "genre": "art", "nsfw": true, "body": "絵の依頼をさせて頂いてもよいでしょうか。\n\nキャラクター\nスーパーリアル麻雀P4　香織\n服装：下着（黒のレース、紐パン、ガーターベルト）\n\nシチュエーション\nhttps://www.pixiv.net/artworks/91928350\nシティハンター、野上冴子の資料URLのシチュエーションを香織で描いてください\n\n①：資料通りのポーズ\n\n②：ライフルの銃口か棒状のものでブラのフロントホックを引っ張る。\n\n③：ブラのホックが外れて乳首露出\n　　香織、頬を赤らめる。\n\n④：ショーツが引っ張られる。\n　　香織、動揺の表情\n\n⑤：ショーツをずり降ろされ、女性器露出\n　　香織、羞恥の表情\n\n⑥：香織、怒りのハイキック\n\n可能でしたらふたなり（玉なし）の差分もください。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@arikawa44/works/262", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/8633a6e9/uploads/origins/e26abe64-2b9a-481a-94e2-90e60010ea65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c98318886b774eee2fed16393fe4e49d", "thumbnail_srcset": "https://si.imgix.net/8633a6e9/uploads/origins/e26abe64-2b9a-481a-94e2-90e60010ea65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c98318886b774eee2fed16393fe4e49d, https://si.imgix.net/8633a6e9/uploads/origins/e26abe64-2b9a-481a-94e2-90e60010ea65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71ccc4ceb746fda62e92dbf8bb7d7725 2x, https://si.imgix.net/8633a6e9/uploads/origins/e26abe64-2b9a-481a-94e2-90e60010ea65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb23c1104016fc12cbc0fdf869100af3 3x", "genre": "art", "nsfw": true, "body": "こんにちわ。先生にまたイラストを描いて欲しくリクエストさせてください。\n\n依頼させて頂きたいイラストですが、機動戦士ガンダムジークアクスから制服姿のニャアンをお願いいたします。\nマチュと同様、Figure-rise Standardのボックスアート風イラストをお願いできませんでしょうか。\n構図や細かい点はお任せいたします。 可能な範囲で差分として下着姿、ヌード、ふたなり、射精状態をお願いできませんでしょうか。\n個人的にデスクトップの壁紙に飾りたいので、横長のサイズ（１６：９）だと嬉しいです。\n\nご多忙かと存じますがよろしければご検討お願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@arikawa44/works/261", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/de926d0e/uploads/origins/e0ab67d7-804c-48c7-b333-5c21e112f8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0987afe6862644c9b4a3cf8c2912bf29", "thumbnail_srcset": "https://si.imgix.net/de926d0e/uploads/origins/e0ab67d7-804c-48c7-b333-5c21e112f8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0987afe6862644c9b4a3cf8c2912bf29, https://si.imgix.net/de926d0e/uploads/origins/e0ab67d7-804c-48c7-b333-5c21e112f8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7111b29cf7a74a1e10aa963b3570d2b6 2x, https://si.imgix.net/de926d0e/uploads/origins/e0ab67d7-804c-48c7-b333-5c21e112f8f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b6d822bcd3d0af0030b7c786bae7f9a 3x", "genre": "art", "nsfw": true, "body": "エバクラ学園のセーラー服を着たティファを願いします。\nhttps://x.com/FFVII_EC_JP/status/1926156206722167249\n\n・構図とシチュは資料URLのようにふたなり化して大股開きで手コキさせている様子。\n・しごいている手はqk141603と同じ影のような手で、レイヤーで表示を切り替えできるようにしてほしいです。\n・ペニスとタマ全体を包み込んでくれる白無地のTバックを穿いていて、包み込まれたペニスの先は穴が空いてないフラットにしてほしいです。\n・両手で尻肉を掴み、極細Tバックがアナルの肉に完全に挟み込まれて見えないくらい極限まで食い込ませてほしいです。\n・今回も局部は修正がかからないように上手く誤魔化してください。\n・背景など細かい部分はお任せします。\n\n差分は以下の通りお願いします。\n\n・1枚目(非ふたなり)\n　サンプル用にペニスがないをバージョンをお願いします。\n　Tバックの食い込みを見せつけ、『ふーん、こういうのがいいんだ』とニヤついた表情で。\n\n・2枚目(射精前)\n　親指と人差し指で作った輪っかでペニスのカリ首の辺りをガッチリ掴んでパンティに覆われた尿道口がカウパーを垂らしている様子を描いてください。\n　変態Tバックが肉棒と直腸に激しく擦りつく快感で『ああんっ❤︎イク！イクゥ！』と喘いでいる表情にしてほしいです。\n\n・3枚目(射精中)\n　凄まじいアクメで白目を剥き、舌を突き出しながら噴水の如くザーメンを排泄している様子を描いてください。\n　あまりの気持ちよさに目をウルウル涙を流して『おおおぉんッッ❤︎』とガクガクしながらイカされてるように描いてほしいです。\n\n・4枚目(射精後)\n　ペニスを包み込んだTバックをドロドロのザーメンまみれに汚し、射精の余韻でアヘってる様子を描いてください。\n　大量のザーメンがペニス～タマ～アナルを伝わり床まで垂れているように描いてほしいです。\n\n・5枚目(パンティ見せつけ)\n　Tバックを脱いでザーメンを滴らせながら、以下URLのような感じに広げて見せつけている様子を描いてほしいです。\n　https://skeb.jp/@Tulipman18/works/11\n　カットイン形式か別シーンの絵にするかはお任せします。\n\n・6～10枚目\n　上記5枚のTバックだけのセミヌードバージョンがほしいです。\n\nhttps://www.dropbox.com/scl/fi/z6494fii9h6uhpxlb4ptj/IMG_0147.JPG?rlkey=i78fhjx93t2i3o63ub107iz5g&st=qg9cuf6z&raw=1", "created_at": "", "completed_at": ""}, {"path": "/@arikawa44/works/260", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/a1890671/uploads/origins/b45ee76a-4759-4db3-baa5-f93244d69dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6911ac32b2b3e7f51825b828aa422df3", "thumbnail_srcset": "https://si.imgix.net/a1890671/uploads/origins/b45ee76a-4759-4db3-baa5-f93244d69dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6911ac32b2b3e7f51825b828aa422df3, https://si.imgix.net/a1890671/uploads/origins/b45ee76a-4759-4db3-baa5-f93244d69dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea460c94481bb1ec4f25932988c7746c 2x, https://si.imgix.net/a1890671/uploads/origins/b45ee76a-4759-4db3-baa5-f93244d69dbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a96b26712d66b90414d0eac35b57d789 3x", "genre": "art", "nsfw": true, "body": "ありかわかときち先生が昔描いていたモノクロラフ絵を、差分付きフルカラーでお願いします。\n\n◎https://i4.nhentai.net/galleries/324006/8.jpg\n\n◎絵を元に、姿勢やシチュエーションはそのままでお願いします。\n\n※競泳水着の上から、乳首、乳輪、スジやクリの形が分かるように（以下同様）。\n\n参考例\n\n★https://skeb.jp/@arikawa44/works/70\n\n※スイミングキャップは白で（以下同様）。\n\n※女の子の瞳の色や髪色はお任せします。\n\n※プールの水の色は、競泳水着やシチュエーションが見やすい、透明な水色は可能でしょうか？\n\n参考例\n\nhttps://skeb.jp/@1000mm/works/71\n\n\n※競泳水着の色やデザインはお任せ致します。個人的には、無地で紺色や無地で藍色や青色、無地で赤色や無地でエンジ色を思いつきました。緑色だとキャミィっぽくてそれも良いかもですね・・・\n\n以下差分、\n\n①プールサイドで女の子が、リラックスして微笑む様子\n\n※この時点で競泳水着のめくれや、男の手は無し\n\n\n②◎絵の様に、男が寄って来て、水着股間をめくられることに、驚き焦る様子\n\n※男の手は、黒で透明（以下同様）\n\n\n③水着をめくられた割れ目に陰茎が挿入され、泣き叫ぶ様子\n\n※男の陰茎は、黒で透明（以下同様）\n\n\n④水着股間のめくりを元に戻し、水着の上から割れ目に陰茎を挿入され、瞳を閉じ泣き叫ぶ様子\n\n\n⑤射精され、舌を出し、瞳を閉じ、泣き叫びながら、イク様子\n\n\n⑥事後で放心した様子\n\n（男の手や陰茎は無し）\n\n\n⑦競泳水着の上から、尻穴に挿入され、歯を食いしばり白目を剥き快楽に痺れる様子\n\n\n⑧絶頂し、舌を出しながら泣きながら、アヘ顔でプールに大便と小便をお漏らし\n\n（★リンクのような、尿の色で。競泳水着尻の中で大便が盛り上がる様子を。プールの水を汚すように）\n\n\n⑨レイプ目でお漏らしして放心して口元が悦んでいる様子\n\n（競泳水着尻から盛り上がった大便がはみ出し、プールに大便の切れ端が浮くように）\n\n\n差分はいずれもｐｓｄで出し入れできるように、設定お願い致します。\n\n何卒よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@arikawa44/works/259", "scraped_at": "2026-02-14T14:57:26.827357+00:00", "thumbnail_src": "https://si.imgix.net/e5c3f122/uploads/origins/20ac5b28-9bba-4317-958a-0b19a1c583f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=625eb2025e002e0b30be99e9d6275fcf", "thumbnail_srcset": "https://si.imgix.net/e5c3f122/uploads/origins/20ac5b28-9bba-4317-958a-0b19a1c583f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=625eb2025e002e0b30be99e9d6275fcf, https://si.imgix.net/e5c3f122/uploads/origins/20ac5b28-9bba-4317-958a-0b19a1c583f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=49e3ede9463298503