文が非常に細かくなってしまいましたが、どうかご検討願います。\nみかんさんが描きやすい様に一部改変しても構いません。", "created_at": "", "completed_at": ""}, {"path": "/@hana_mori17/works/27", "thumbnail_src": "https://si.imgix.net/bab14155/uploads/origins/d57dd07f-4ca0-4cab-9bfe-5249735f4929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fae50f62812fc3e16fec9e807b1b29d0", "thumbnail_srcset": "https://si.imgix.net/bab14155/uploads/origins/d57dd07f-4ca0-4cab-9bfe-5249735f4929?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fae50f62812fc3e16fec9e807b1b29d0, https://si.imgix.net/bab14155/uploads/origins/d57dd07f-4ca0-4cab-9bfe-5249735f4929?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b2bb4494785b0b17a7d7b60e3692ff5 2x, https://si.imgix.net/bab14155/uploads/origins/d57dd07f-4ca0-4cab-9bfe-5249735f4929?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db7e10614b823ac41e881184d70eda69 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hana_mori17/works/26", "thumbnail_src": "https://si.imgix.net/79082c25/uploads/origins/22eba4aa-08ba-4454-85e7-4bf4223125b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e601aded026baeb2385d7371510f712d", "thumbnail_srcset": "https://si.imgix.net/79082c25/uploads/origins/22eba4aa-08ba-4454-85e7-4bf4223125b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e601aded026baeb2385d7371510f712d, https://si.imgix.net/79082c25/uploads/origins/22eba4aa-08ba-4454-85e7-4bf4223125b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cro