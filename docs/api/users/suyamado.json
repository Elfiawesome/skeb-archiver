ところを目撃されてしまい問い詰められてしまう\n・しかしそれは委員会での事務的な会話で、誤解と判明した彼女は機嫌を直して次のデートの計画を話し始め…\n\nといった内容をデレ成分多めでお願いできたらなと思います。\n大雑把な指定だけで申し訳ないですがもし良ければお受けしていただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@suyamado/works/15", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1999680262050054152%2F3GeIs-cv.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08a3c2332f1a1b4298e543371e33ec89", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1999680262050054152%2F3GeIs-cv.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08a3c2332f1a1b4298e543371e33ec89, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1999680262050054152%2F3GeIs-cv.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1142dd13315d4aa4e9648577ff2f257 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1999680262050054152%2F3GeIs-cv.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8a9286d27030c5181d68beccd1a93cf 3x", "genre": "voice", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suyamado/works/14", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1999680262050054152%2F3GeIs-cv.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08a3c2332f1a1b4298e543371e33ec89", "thumbnail_srcset": "http