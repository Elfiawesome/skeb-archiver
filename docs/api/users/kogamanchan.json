無理そうなら、お気軽にキャンセル頂いて構いません\n\nhttps://ln2.sync.com/dl/6587b7d40/nf6g9cpa-wp6zj7z6-in8py26k-78ys7mef", "created_at": "", "completed_at": ""}, {"path": "/@kogamanchan/works/4", "thumbnail_src": "https://si.imgix.net/80677249/requests/162309_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78e39086fb45b48092ca1f9901542b65", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kogamanchan/works/3", "thumbnail_src": "https://si.imgix.net/142d135c/requests/147346_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68aaec59389a91ba76012e1eae65ffd3", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kogamanchan/works/2", "thumbnail_src": "https://si.imgix.net/eb8bc864/requests/147591_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11a1e5b21fa253538bfab6e22f5fe9e2", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "柴菜々さん、こんにちは。\n僕のキャラクターを描いてくれませんか？\nツイッターに投稿されたスケッチで奈々さんに負けているところがとても気に入りました！(笑)\n\nhttps://drive.google.com/drive/folders/1JKa9hNW-3Jng46WxObcCnjED-QEAph87?usp=sharing", "created_at": "", "completed_at": ""}]}