e48a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f8a9e283d0dad1ccd0e2705e367cb17 3x", "genre": "art", "nsfw": true, "body": "ドラゴンボールのコンキチが両手を縛られズボンをパンツごと脱がされて四つんばいの状態で恥部を晒されたイラストをお願いします。NSFWでお尻を重点的にお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@DinoChargeCurio/works/23", "thumbnail_src": "https://si.imgix.net/60c5cf49/uploads/origins/8826be0d-9811-45bf-95c1-ef83a4db159f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38d0732748221c94beb4fd1d7d3adc0", "thumbnail_srcset": "https://si.imgix.net/60c5cf49/uploads/origins/8826be0d-9811-45bf-95c1-ef83a4db159f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38d0732748221c94beb4fd1d7d3adc0, https://si.imgix.net/60c5cf49/uploads/origins/8826be0d-9811-45bf-95c1-ef83a4db159f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00023a58f72d2f444d7ba468d2bef305 2x, https://si.imgix.net/60c5cf49/uploads/origins/8826be0d-9811-45bf-95c1-ef83a4db159f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55762c40f4b6cd919a3c69fd0b5d003a 3x", "genre": "art", "nsfw": true, "body": "首を絞められながらチンポぶち込まれて、窒息して泡拭きながらも無様にアクメキメてるにゃん太班長的なものをもしよろしければ拝見させていただきたく…！\n(表情のイメージ的には以前アップされていた無理矢理ピアッシングされていた絵の感じです)", "created_at": "", "completed_at": ""}, {"path": "/@DinoChargeCurio/works/22", "thumbnail_src": "https://si.imgix.net/da27184b/uploads/origins/8f99fd24-11b4-4eed-a0ac-6d2698a4e6da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28cdf05c885c0323f78c61fbffc17983", "thumbnail_srcset": "https://si.imgix.net/da27184b/uploads/origins/8f99fd24-11b4-4eed-a0ac-6d2698a4e6da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28cdf05c885c0323f78c61fbffc17983, https://si.imgix.net/da27184b/uploads/origins/8f99fd24-11b4-4eed-a0ac-6d2698a4e6da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32aee9dbb8b080124b411406108e2ddf 2x, htt