人ともヒトチン。２人とも全裸で。\n\n体位は資料の通りでオセのアナルと全身が良く見えるようにしてください。セックスしてから１時間後の絵。オセは斧神のセックスが上手すぎて快感以上に心地よさと幸福感と愛おしさを感じてトロトロの顔になりながらもギリギリで耐えている表情で、顔を真っ赤にして汗だくにしてください。\n\n差分を1枚お願いします。セックスしてから６時間後の絵。オセは斧神のセックスが上手すぎて一突きごとに深すぎるメスイキをしてしまい、快感が天井知らずに上がっている。心地よさと幸福感と愛おしさも凄まじく、堕ちて機密情報を自白する寸前の表情。\n\nhttps://x.com/DinoChargeCurio/status/1467081862766297092", "created_at": "", "completed_at": ""}, {"path": "/@DinoChargeCurio/works/42", "thumbnail_src": "https://si.imgix.net/d9b3c575/uploads/origins/7403bbd3-4e94-41b2-b3dc-3d8a092e1847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b8d8d052a0e3a2525a5af33cba2c9a6", "thumbnail_srcset": "https://si.imgix.net/d9b3c575/uploads/origins/7403bbd3-4e94-41b2-b3dc-3d8a092e1847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b8d8d052a0e3a2525a5af33cba2c9a6, https://si.imgix.net/d9b3c575/uploads/origins/7403bbd3-4e94-41b2-b3dc-3d8a092e1847?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c0dab34781515bc27c1df03f0e1ab1a 2x, https://si.imgix.net/d9b3c575/uploads/origins/7403bbd3-4e94-41b2-b3dc-3d8a092e1847?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ade53d1897031625a54145dacf2dbf8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@DinoChargeCurio/works/41", "thumbnail_src": "https://si.imgix.net/07cc596e/uploads/origins/ad175238-ed7f-4ec9-88ae-eabd9ab8539e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f07cde