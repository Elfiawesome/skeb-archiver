%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8c086a9a0ff475bbaf9ed76f535b1ae 2x, https://si.imgix.net/dd827ec7/uploads/origins/83e3ee12-8ed0-4e03-aae6-37441d779e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb2fc08302a3c3709b1c7b25b94c250e 3x", "genre": "art", "nsfw": false, "body": "ｔ子先生、よろしくお願いします。\nにゅう工房と申します。\n\n私が作ったゲームに出てくる女ラスボスが居まして、\nその子をカッコよく描いていただけないでしょうか？\n『悲しみ』と『決意』を感じる絵にして欲しいです。\n\nキャラ造形　https://www.dropbox.com/scl/fi/yqx9vdhuc9zpgqdfp5z9z/037_T1_0001.png?rlkey=evk7r8tr8a90hel9qjesz7zfv&dl=0\n名前　テレサ　ゲーム内では総帥と呼ばれている\n身長　180くらい　足が細長い\n正体　自らが仕えたお嬢様を弔うため、2000年稼働しているロボメイド\n属性は善ですが、使命の為に人類を滅ぼすことになります（主人公サイドはそれを止める）\n\n※全年齢向けの依頼ですが、このキャラは成人向けゲームのキャラなので\n依頼自体が失礼にあたるかもしれません、その際は、どうかお許しください。\n\n頂いた絵は、出力して部屋に飾る予定です。\n作者名付きにて、Xに投稿する可能性もあります。\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@_tonko_from_/works/34", "thumbnail_src": "https://si.imgix.net/341491f9/uploads/origins/aa211fa3-1e5d-46f9-bbbf-354781858863?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dcb329e526048c57af2554471d254c2", "thumbnail_srcset": "https://si.imgix.net/341491f9/uploads/origins/aa211fa3-1e5d-46f9-bbbf-354781858863?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dcb329e526048c57af2554471d254c2, https://si.imgix.net/341491f9/uploads/origins/aa211fa3-1e5d-46f9-bbbf-354781858863?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee2cddc85d54d1f4e27185a946aa698a 2x, https://si.imgix.net/341491f9/uploads/origins/aa211fa3-1e5d-46f9-bbbf-354781858863?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=881f6b156466fe47d756e2bfc89afab7 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nFate Grand Orderの源雷光をお願いしたいです。  以前の投稿（https://x.com/_tonko_from_2/status/1971727180888789276/photo/1）を見て衝撃を受けたので、似たような、でもユニークなものを希望します。\nポーズや表情はお任せします。\n背景は任意です。\n\nありがとうございます！\n\nhttps://static.wikia.nocookie.net/typemoon/images/6/64/Raiko_1.png/revision/latest?cb=20201216010133", "created_at": "", "completed_at": ""}, {"path": "/@_tonko_from_/works/33", "thumbnail_src": "https://si.imgix.net/aeccc706/uploads/origins/d7e24a0c-8093-4470-b353-310f2dd1c898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edd6bb88b8968056548ce77a18388739", "thumbnail_srcset": "https://si.imgix.net/aeccc706/uploads/origins/d7e24a0c-8093-4470-b353-310f2dd1c898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edd6bb88b8968056548ce77a18388739, https://si.imgix.net/aeccc706/uploads/origins/d7e24a0c-8093-4470-b353-310f2dd1c898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9937aa37b6c8edfdf01d24b87295642 2x, https://si.imgix.net/aeccc706/uploads/origins/d7e24a0c-8093-4470-b353-310f2dd1c898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c73732693ab59b45262c43ed1277c24 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの素敵な作風がとても好きです。\n私のオリジナルキャラクター「ザリヤ」のイラストをお願いできますでしょうか？\nザリヤは筋肉質な女狼で、戦うことが好きで、美しい人に弱いキャラクターです。\nクールなお姉さん系の性格で、少し色っぽく冒険好きです。\n夜のパーティーで、セクシーなドレスを着たザリヤを描いていただきたいです。\n白かシルバーのドレスが好みですが、キャラに似合う色でお任せしても大丈夫です。\nドレスは胸元と腹部が見えるデザインで、豊かな胸元と腹筋が見えるようにお願いします。\nまた、横にスリットを入れて、太ももの筋肉が見えるようにしていただけると嬉しいです。\n参考にポーズ画像を添付しましたが、バーのスツールに座っているポーズでも大丈夫です。\n背景は夜のバーのような、簡単なもので構いません。\n表情はお任せしますが、楽しそう、または少し色っぽい雰囲気だと嬉しいです。\n右胸の上に新しくできた傷跡を入れてください。これは最近のストーリーでついたものです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1QhTOKtwBeKICd148zHC92zpPT7n1xSwz", "created_at": "", "completed_at": ""}, {"path": "/@_tonko_from_/works/32", "thumbnail_src": "https://si.imgix.net/254ba0e7/uploads/origins/4f1f1c3e-ff53-4921-9f91-babe2e0ce027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dde01ceb5a39229566c391e77d1b3cbc", "thumbnail_srcset": "https://si.imgix.net/254ba0e7/uploads/origins/4f1f1c3e-ff53-4921-9f91-babe2e0ce027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dde01ceb5a392295