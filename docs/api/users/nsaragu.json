%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4d2256468a88bd31266c29c78ac2cb9", "thumbnail_srcset": "https://si.imgix.net/aca66f88/uploads/origins/bb0c73e2-11ee-4f34-87f3-be246404b709?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4d2256468a88bd31266c29c78ac2cb9, https://si.imgix.net/aca66f88/uploads/origins/bb0c73e2-11ee-4f34-87f3-be246404b709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd52690e6dd00656ec683237c7f1d564 2x, https://si.imgix.net/aca66f88/uploads/origins/bb0c73e2-11ee-4f34-87f3-be246404b709?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a1efa6c807d2913896692d53ff25adb 3x", "genre": "art", "nsfw": true, "body": "リクエストを再開していただき、ありがとうございます。\n以前と同じような写真をお願いしたいのは変わりませんが、違うキャラクターにも挑戦してみたいので...。\n元画像：https://skeb.jp/@nsaragu/works/156\n女性\nhttps://www.pixiv.net/artworks/124476645\n男\nhttps://www.pixiv.net/artworks/124476645\nこれからも原画のディテールを維持しつつ、今の表情を維持するだけで、ちょっと痛そうで楽しそう。\n私の度重なる申し込みに、あなたが疲れて迷惑になったかどうか分かりません。もしそうなら、ごめんなさい。悪気はなかったんです。あなたの仕事は本当に好きです。", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/198", "thumbnail_src": "https://si.imgix.net/e8b9a5ba/uploads/origins/7c8f15db-eccd-4bba-be31-eedca387094b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=510eea8e1c6cd5dbfcf311528038e4c9", "thumbnail_srcset": "https://si.imgix.net/e8b9a5ba/uploads/origins/7c8f15db-eccd-4bba-be31-eedca387094b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=510eea8e1c6cd5dbfcf311528038e4c9, https://si.imgix.net/e8b9a5ba/uploads/origins/7c8f15db-eccd-4bba-be31-eedca387094b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe4fea5f5ceb015142e341c7e7a1a9b3 2x, https://si.imgix.net/e8b9a5ba/uploads/origins/7c8f15db-eccd-4bba-be31-eedca387094b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b928f398e1d00a11b027f4dca9524c75 3x", "genre": "art", "nsfw": true, "body": "【攻め】ぐだ男\n【受け】ケツァル・コアトル　サンバサンタ\n【技】卍固め\n\n\nいつもお世話になっております。\n再度リクエストさせていただきたいと思います。\nぐだ男がコアトルに卍固めをかけてギブアップを迫ってる技絵をお願いします。\n参考絵のようなアングルで、ぐだ男がコアトルの腕を固めたうえで、空いた右手はコアトルのお尻から股間に手を回してがっちりとフックして体勢を固めた方式の卍固めを希望します。\nぐだ男が盤石の体制で卍固めを決めているためコアトルは動くことができず、そしてぐだ男の右手がコアトルのお尻や股間に食い込んで擦れているいることが刺激となって感じてしまい、痛さも相まって涙目で苦悶の表情を浮かべながら喘ぎ声をだすというシチュエーションを描いていただければと思います。\nご検討宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/131882895", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/197", "thumbnail_src": "https://si.imgix.net/e2dc3654/uploads/origins/1668604f-00a4-4366-b2b9-e4fcad742f37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bd12b34f2e5a78146df8bfdc39090ac", "thumbnail_srcset": "https://si.imgix.net/e2dc3654/uploads/origins/1668604f-00a4-4366-b2b9-e4fcad742f37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bd12b34f2e5a78146df8bfdc39090ac, https://si.imgix.net/e2dc3654/uploads/origins/1668604f-00a4-4366-b2b9-e4fcad742f37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd22c8fa3cf5239974bdf3d0c57bbcca 2x, https://si.imgix.net/e2dc3654/uploads/origins/1668604f-00a4-4366-b2b9-e4fcad742f37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c4f4bdd4a2e3c720911d269e63ba7d8 3x", "genre": "art", "nsfw": true, "body": "お世話になります。鳴潮という作品の技絵リクエストを送らせていただきます。\n【攻め】鳴潮は、格闘タイプの男キャラに乏しく、んさらぐさんの男キャラから誰か一人出場をお願いします。\n【受け】ルパ\nhttps://www.youtube.com/watch?v=Ne9eEyp_9rE\nhttps://x.com/WW_JP_Official/status/1938447199551295733\nこちらのキャラを、露出度高めにリンコス化をお願いします。\n【内容】アンクルロック\nhttps://skeb.jp/@nsaragu/works/40\nこちらの過去作品で描かれている技です。\n構図の要望ですが、受け手が悶えながら体をひねって必死に逃れようとしていてr、体の正面がよく見えるような構図でお願いしたいです。\n例えば、違う技ですが、受け手の姿勢はこちらの過去作品がイメージが近いです。攻め手の姿勢はお任せします。\nhttps://skeb.jp/@nsaragu/works/147\nその他要望です。\n・乳首やまんすじ、体のラインがよく出ているようにお願いします。\n・攻め手が「オラア、ギブか！？」とギブを迫り、ルパが「ギ、ギブアッ・・・やだ！やだあ！」とギブ寸前で必死にこらえているように台詞をお願いしたいです。\n・ユサユサと攻め手が絞り上げ、悶え悶絶するルパをよく表現いただきたいです。\nご検討のほど、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/196", "thumbnail_src": "https://si.imgix.net/599e4962/uploads/origins/8d171e68-e324-472b-b983-451308d41267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4282b526d92a1754c0ec835d5b4ecbfc", "thumbnail_srcset": "https://si.imgix.net/599e4962/uploads/origins/8d171e68-e324-472b-b983-451308d41267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4282b526d92a1754c0ec835d5b4ecbfc, https://si.imgix.net/599e4962/uploads/origins/8d171e68-e324-472b-b983-451308d41267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f057e2079e27988f48f619d535fbb8c 2x, https://si.imgix.net/599e4962/uploads/origins/8d171e68-e324-472b-b983-451308d41267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=593c4b96b6cde3ba11d97fb1d188ecba 3x", "genre": "art", "nsfw": true, "body": "こんにちは、またはこんばんは。いつも楽しく拝見しております。\n今回、募集を再開されるということで、技絵のリクエストさせていただきます。\n\n【技名】パッケージパイルドライバー\n【掛け手】ブルーサンダーマスク(以下、BTM)\n【受け手】南利美(サバイバーコス)\n\n【構図等】\n①：正面の構図、急角度で脳天から着弾直後の状態をお願い致します。\n②：試合終盤、両者汗びっしょりで表情について、南さんは目をつぶった状態で、\n　　BTMも必死な表情でお願い致します。\n③：南さんの胸ポチ、筋が入ると嬉しいです。\n④：背景は通常のリング、もしくは金網であると嬉しく思います。\n⑤：セリフはBTMが「これでとどめだっ！！」南さんが「ぐうっ！！」でお願いします。\n\n以上、複雑な構図のリクエストですが、ご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/195", "thumbnail_src": "https://si.imgix.net/49822b6c/uploads/origins/fe321ac3-9eaa-42a4-8e04-2b203069624c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3639b316c60d3db2303eae4e567eb8", "thumbnail_srcset": "https://si.imgix.net/49822b6c/uploads/origins/fe321ac3-9eaa-42a4-8e04-2b203069624c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba3639b316c60d3db2303eae4e567eb8, https://si.imgix.net/49822b6c/uploads/origins/fe321ac3-9eaa-42a4-8e04-2b203069624c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a30ee5a4c9e518221960718b11cc46ab 2x, https://si.imgix.net/49822b6c/uploads/origins/fe321ac3-9eaa-42a4-8e04-2b203069624c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd09ff123bf78b36ef0c371ec148615a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nせっかくの機会ですので、以前資料URL等で公開されていた大乱闘スマッシュプロレス関連でリクエストさせていただきます。\n\n概要は下記の通りです。\n【攻め】ホムラ\n【受け】マルス\n【内容】 \nホムラ→マルスでのキン肉バスターをお願いいたします。\n構図は「涼太郎vsブレア(https://www.fanbox.cc/@nsaragu/posts/7683087)」のような両者の身体が正面から見えるようなアングルにしていただけますと幸いです。\nマルスは技を受けた衝撃で白目を剥いたアヘ顔のような表情でお願いできればと思います。また可能であれば勃起・射精差分を付けていただけますと大変嬉しいです。\n\n要望が多く、また男性受けのR-18となる内容で大変恐縮ですが、ご検討の程、何卒よろしくお願いいたします。\n\nhttps://www.fanbox.cc/@nsaragu/posts/8566304", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/194", "thumbnail_src": "https://si.imgix.net/f15f5f3d/uploads/origins/4c013626-2d8c-4377-8074-74d2cc4caa9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7ea31c8006e1f07157c329cf96cda8", "thumbnail_srcset": "https://si.imgix.net/f15f5f3d/uploads/origins/4c013626-2d8c-4377-8074-74d2cc4caa9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa7ea31c8006e1f07157c329cf96cda8, https://si.imgix.net/f15f5f3d/uploads/origins/4c013626-2d8c-4377-8074-74d2cc4caa9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ae775a92e5b41343de058b5adcc5bc5 2x, https://si.imgix.net/f15f5f3d/uploads/origins/4c013626-2d8c-4377-8074-74d2cc4caa9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=583178655e7e7509f126b09016358272 3x", "genre": "art", "nsfw": true, "body": "いつも素晴らしい作品をありがとうございます。\n今回もゼンレスゾーンゼロから技絵（喘ぎ声と台詞付き）の依頼をさせていただきます。\n【攻め】アキラ\n【受け】イーシェン\nhttps://game.watch.impress.co.jp/docs/preview/2019190.html\nhttps://www.youtube.com/watch?v=IXam2-BTRcE\n\n２人ともリンコス化をお願いします。2人は師弟で、イーシェンが師匠です。\nアキラはブーメランパンツの男らしいシンプルなコスで細マッチョに。\nイーシェンは、ジャケットを脱いだ状態を元にリンコスにアレンジいただきたいです。元にする衣装は、デフォルトの黄色が入った方のコスでお願いします。\nもっとハイレグ気味にしてハミケツさせていただき、股間やお尻の食い込ませて欲しいです。\n黒ベースのコスも好きなので、そちらベースでもOKです。\n\n【内容】オクトパス・ストレッチ\n卍固めとマフラーホールドの複合のような技です。\nhttps://www.pixiv.net/artworks/124598650\nhttps://www.tokyo-sports.co.jp/articles/photo/277392\n両者汗びっしょりで、イーシェンはチクピン＆まんすじくっきりさせていただくようお願いします。\n上側のものをもう少し正面側から見たような、開脚させられた屈辱的な体勢で悶える受け手がよく映える構図でお願いします。\n\nシチュエーションです。\n師であるイーシェンに軟弱と煽られたアキラがプロレス勝負を挑む。\n頭脳明晰なアキラは、研究し会得した脱出不能技で、師匠であるイーシェンを捉える。師の権威形無し、あられもない姿で悶絶させられるイーシェン。\n\n台詞のイメージです。\nアキラ：イーシェンの顔を見つめながら「ほら師匠、ギブギブ？」\nイーシェン：「ノ、ノー！のおおん！あはああ・・」\n「あっ♡」「ああん」とか「はぁはぁ」のような、セクシーな喘ぎ声の吹き出しをバックにつけていただきたいです。\n\n台詞はあくまでイメージですので、一緒でなくて構いません。\n\n相変わらず複雑なリクで恐縮ですが、何卒よろしくお願いいたします\n\nhttps://dic.pixiv.net/a/%E3%82%BC%E3%83%B3%E3%83%AC%E3%82%B9%E3%82%BE%E3%83%BC%E3%83%B3%E3%82%BC%E3%83%AD%E7%99%BB%E5%A0%B4%E3%82%AD%E3%83%A3%E3%83%A9%E3%82%AF%E3%82%BF%E3%83%BC%E4%B8%80%E8%A6%A7", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/193", "thumbnail_src": "https://si.imgix.net/3adc7239/uploads/origins/99474080-e5b4-4140-a417-f7e95ade6b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06c121850cd38180fbfedf18eacabad2", "thumbnail_srcset": "https://si.imgix.net/3adc7239/uploads/origins/99474080-e5b4-4140-a417-f7e95ade6b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06c121850cd38180fbfedf18eacabad2, https://si.imgix.net/3adc7239/uploads/origins/99474080-e5b4-4140-a417-f7e95ade6b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a97cdcad38cb09a2f9c32b9051effb2a 2x, https://si.imgix.net/3adc7239/uploads/origins/99474080-e5b4-4140-a417-f7e95ade6b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85da63a3296f6b1617447210bbc90dbd 3x", "genre": "art", "nsfw": true, "body": "リング☆ドリーム×先生のオリジナルキャラのミックスファイト技絵（喘ぎ声とセリフ付き）を依頼させていただきます。\n【攻め】涼太郎君。いつものコスでお願いします。\n【受け】姫小路由樹（涼太郎君vs姫のキャメルクラッチと同じコスでお願いします。）\n【内容】まるでSEXしているかのような、パワーボムからのセクシーなピンフォール\nhttps://skeb.jp/@nsaragu/works/140\nhttps://skeb.jp/@nsaragu/works/115\nこれらの過去作品のような技をお願いしたいです。\n\n上に添付した140番のように、腰をユサユサと揺らしながらの、オスの強さを分からせるような、挑発的なピンフォールを、ダイナミックに描いていただきたいです。\n\n構図についてですが115のように、受け手の股間も見えるような角度の構図でお願いしたいです。\nまた、完全勝利のマウンティングをするように、股間を押し付け、姫の顔を見つめながらフォールして欲しいのですが、受け手が見えにくくならないよう、太もものあたりを掴んで、カパッと開脚させてフォールするようにして欲しいです。\n\n姫は試合でやられた興奮から、勃起した乳首がリンコスの上からでも分かってしまうようなチクピン、まんすじもくっきりしているようにお願いします。\n\nスカートがめくれて、白いセクシーなパンツが見えているようにお願いします。汗もびっしょりでお願いします。\nまた、アイアンマンマッチをイメージしてまして、2-1の表示をお願いします。涼太郎君が２本目です。\n\n台詞は以下のイメージでお願いします。\n涼太郎君：「わーん、つー、すりー！もう降参か？」と自ら3カウントを数えて挑発して欲しいです。\n姫小路「ああん、んはあああ、まだまだぁ♡」とやられながらも興奮しており、挑発するようなイメージです。\n\nその他、姫小路由樹にはエロい悲鳴をあげさせていただきたく、「あんっ♡」とか「はぁはぁ」のような、喘ぎ声の吹き出しをバックにつけていただきたいです。\n\nイケメンな涼太郎君と美しい姫の対決、大好きです！\n\n是非宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/192", "thumbnail_src": "https://si.imgix.net/96b2f30d/uploads/origins/e831f337-abdf-42ce-aaef-be04a384016c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ce3640030e7a6cb250db0681e7ced20", "thumbnail_srcset": "https://si.imgix.net/96b2f30d/uploads/origins/e831f337-abdf-42ce-aaef-be04a384016c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ce3640030e7a6cb250db0681e7ced20, https://si.imgix.net/96b2f30d/uploads/origins/e831f337-abdf-42ce-aaef-be04a384016c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1536b72aa92345e794da51edc4982d5d 2x, https://si.imgix.net/96b2f30d/uploads/origins/e831f337-abdf-42ce-aaef-be04a384016c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d747adc99ae8d1017301ec43f9850439 3x", "genre": "art", "nsfw": true, "body": "fateプロレスからリクエストを送らせていただきます。\n【攻め】フェルグス\n過去作品と同じく、男らしい露出度高めのブーメランパンツにシューズの男らしい衣装でお願いします。\n【受け】メイドオルタ\nhttps://skeb.jp/@nsaragu/works/147\nこちらの依頼と同じ、水着をモチーフにしたリンコスでお願いします。\n【内容】フルネルソンホールド\nhttps://www.pixiv.net/artworks/112681591\nhttps://skeb.jp/@nsaragu/works/102\nこれらのような、受け手の正面からの、オルタのやられ姿がよく見える構図でお願いします。\n様々な掛け方のある技ですが、掛け方はお任せします。フェルグスがオルタのやられ姿を、ユサユサとゆさぶって悶絶させながら、観客に見せつけているようなイメージでお願いします。\n・乳首やまんすじ、体のラインがよく出ているようにお願いします。\n・オルタはパンツが見えてしまっているようにお願いします。\n・https://skeb.jp/@nsaragu/works/176、こちらの作品のようにの吐オルタの吐息をつけて欲しいです。\n・オルタは、「ギブギブギブゥ！許してえ！」と許しを乞うているようにセルフをつけて欲しいです。\n\nご検討のほど、よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/191", "thumbnail_src": "https://si.imgix.net/4473df30/uploads/origins/6f66a8c4-de79-494e-ac2e-3ef3ae568768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8b99527b679a96526a7e7d3d708a26d", "thumbnail_srcset": "https://si.imgix.net/4473df30/uploads/origins/6f66a8c4-de79-494e-ac2e-3ef3ae568768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8b99527b679a96526a7e7d3d708a26d, https://si.imgix.net/4473df30/uploads/origins/6f66a8c4-de79-494e-ac2e-3ef3ae568768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b7148ec827af8432d3e5a80a377edfa 2x, https://si.imgix.net/4473df30/uploads/origins/6f66a8c4-de79-494e-ac2e-3ef3ae568768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afabc087cf7c3d7edd26823b8e0c3d6e 3x", "genre": "art", "nsfw": false, "body": "いつも楽しみにしております。\nリクエストお願いしたいです。\n\n今回はFGOの宮本武蔵がプロレスのリングに王者として君臨している立ち絵をリクエストします。\n衣装はプロレスラーらしさを出すために第三段階の水着衣装（参考：https://www.pixiv.net/artworks/76580777）を基調に膝のサポーターやリングシューズをつける等プロレスラーっぽくして、髪型は通常時の髪型（参考：https://www.pixiv.net/artworks/130669502）にしていただければと思います。\nポーズとしては、チャンピオンベルトを右肩に掛け、左手は腰に当てて好戦的な笑みを見せながら挑戦者を見据えている構図でお願いします（ポーズの参考：https://www.pixiv.net/artworks/124940513）。\n\n現在、FGOでは冠位戴冠戦が実装され、宮本武蔵がセイバー枠に起用されて話題になっているのですが、そこで\n「冠位戴冠戦の舞台に赴いたら、プロレスのリングの上で挑戦者を待つ武蔵がいた」というシチュエーションを思いつきましたので、このリクエストをさせていただきました。\n\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/190", "thumbnail_src": "https://si.imgix.net/c46ed36d/uploads/origins/c961b1f7-bdc6-4145-b82a-446b68972af8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5e0671dd94275831874d9acedd42723", "thumbnail_srcset": "https://si.imgix.net/c46ed36d/uploads/origins/c961b1f7-bdc6-4145-b82a-446b68972af8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5e0671dd94275831874d9acedd42723, https://si.imgix.net/c46ed36d/uploads/origins/c961b1f7-bdc6-4145-b82a-446b68972af8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8fe6b18860089b2c346766fd05481ca 2x, https://si.imgix.net/c46ed36d/uploads/origins/c961b1f7-bdc6-4145-b82a-446b68972af8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ea6126ca7ea00fca2f3c23dd5918b7b 3x", "genre": "art", "nsfw": true, "body": "ポケトレスラーでリクエストお願いします。\n描いていただきたいキャラはモミ。\nイラストは以前先生が描かれた「制服を脱いだらプロレスラー」のモミver.をお願いします。\n\n細かい内容として、\n・衣装は公式の私服姿と先生が描かれレオタード衣装。\n・ポーズは先生にお任せします。\n・イラストは出来るだけ私服を半脱ぎ状態で、胸の谷間とレオタードのハイレグ部、鼠蹊部が見えるようお願いします。\n・可能でしたらチクピン、まんすじくっきりで。\n\n上記の内容でリクエストお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nsaragu/works/189", "thumbnail_src": "https://si.imgix.net/f68c5e9f/uploads/origins/39533991-1319-414d-83aa-8d97df907b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=356f248ea93a81a6ec68de11f310fd3c", "thumbnail_srcset": "https://si.imgix.net/f68c5e9f/uploads/origins/39533991-1319-414d-83aa-8d97df907b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=356f248ea93a81a6ec68de11f310fd3c, https://si.imgix.net/f68c5e9f/uploads/origins/39533991-1319-414d-83aa-8d97df907b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8292e003ef49f7d49225b02f70c33f69 2x, https://si.imgix.net/f68c5e9f/uploads/origins/39533991-1319-414d-83aa-8d97df907b4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b87561f7a103f05bba0b5f8bb56db6f3 3