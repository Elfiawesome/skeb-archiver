%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092a271b2c7bbd8f6024667e97c3415e", "thumbnail_srcset": "https://si.imgix.net/5f4474f6/uploads/origins/d82f28d3-d5ed-4741-a7e7-d41361302d07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092a271b2c7bbd8f6024667e97c3415e, https://si.imgix.net/5f4474f6/uploads/origins/d82f28d3-d5ed-4741-a7e7-d41361302d07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=078d94e5dcb9d467f9e41a3e9aec3a80 2x, https://si.imgix.net/5f4474f6/uploads/origins/d82f28d3-d5ed-4741-a7e7-d41361302d07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2544dfd3475e44accf91c922238b746 3x", "genre": "art", "nsfw": false, "body": "こんにちは。またリクエストを送らせていただきます。つのことを描いてください：\n\n1) 翡翠の服をもう一着。(お好きなものを）\n2) \"フリースペース\" - 月姫または魔法使いの夜から、同じ（またはお揃いの）衣装のキャラクターを選んでください。\n\n別々のイラストに描くこともできます。あるいは、1つのイラストに2つのキャラクターを描いても構いません。つまり、好きなように描いてください。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/28", "thumbnail_src": "https://si.imgix.net/f584b495/uploads/origins/11fe2991-5f17-49ba-bbe3-7d24de01f487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8107b4564a7f4087c64fd0b046342d50", "thumbnail_srcset": "https://si.imgix.net/f584b495/uploads/origins/11fe2991-5f17-49ba-bbe3-7d24de01f487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8107b4564a7f4087c64fd0b046342d50, https://si.imgix.net/f584b495/uploads/origins/11fe2991-5f17-49ba-bbe3-7d24de01f487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0481439c638e598940f10c8997f886e 2x, https://si.imgix.net/f584b495/uploads/origins/11fe2991-5f17-49ba-bbe3-7d24de01f487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be86e0642484d48ff240d3ce0b8f6077 3x", "genre": "art", "nsfw": false, "body": "アピールありがとうございます!実は前々からお願いしたいと思っていたんです!\n\nこのキャラのことかわからないんですけど、僕のOCのサフランを描いてくれませんか？彼は多動で破壊的で、蛾、宇宙、エイリアン、ナイフ、生肉、かわいいものが大好きです!\n\nリファレンスフォルダにある服装で、自由にサフランを描いてください！\n\nどんな風に仕上がるか楽しみです!\n\nhttps://drive.google.com/drive/folders/1h2exs41JYrVW-60UCq176sWU3sgA0ppF", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/27", "thumbnail_src": "https://si.imgix.net/0bd889cb/uploads/origins/51d94485-f35d-414c-ba6d-c621ce4f20e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20087b802ecec669806f8d09c1ebb6f7", "thumbnail_srcset": "https://si.imgix.net/0bd889cb/uploads/origins/51d94485-f35d-414c-ba6d-c621ce4f20e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20087b802ecec669806f8d09c1ebb6f7, https://si.imgix.net/0bd889cb/uploads/origins/51d94485-f35d-414c-ba6d-c621ce4f20e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c645506b9ce9f3ec79462701296cc77 2x, https://si.imgix.net/0bd889cb/uploads/origins/51d94485-f35d-414c-ba6d-c621ce4f20e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84fe87719571822dc6ef5cff9ff055bd 3x", "genre": "art", "nsfw": false, "body": "こんにちは、アピールありがとうございます！私はFGOがとても好きで、あなたのイラストも大好きです。\n\n私のキャラの侍姿を描いていただけませんか？FGOの宮本武蔵のような雰囲気で描いていただけると嬉しいです。武器はいくつか参考にさせてもらったので、ポーズや表情はお任せします。刀を抜くか鞘に収めるかは、あなたの判断にお任せします。\n\n腕のタトゥーは、面倒ならそのまま描かなくてもいいし、似たようなものや簡略化したものでも構わない。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1negoNQB-VMknj1B7CobnPhDTBaBiqXZb?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/26", "thumbnail_src": "https://si.imgix.net/4413c53b/uploads/origins/5ad0dd73-0dce-4275-be26-149ae9920671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc54fed3b0a02cc14d24d4460dd76cc3", "thumbnail_srcset": "https://si.imgix.net/4413c53b/uploads/origins/5ad0dd73-0dce-4275-be26-149ae9920671?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc54fed3b0a02cc14d24d4460dd76cc3, https://si.imgix.net/4413c53b/uploads/origins/5ad0dd73-0dce-4275-be26-149ae9920671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a09fd2b0364877408a4d416db13aef8 2x, https://si.imgix.net/4413c53b/uploads/origins/5ad0dd73-0dce-4275-be26-149ae9920671?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d993b5010167b0d3f2eec3163b57e92b 3x", "genre": "art", "nsfw": false, "body": "アピール頂きありがとうございます!\n自創作キャラを依頼したく、リクエストを送らせていただきます。\n\n資料URLにある、私の創作キャラクターをお願いしたいです。\n衣装については資料のものからアレンジを加えたり、全く別の衣装にしても問題ございませんが、資料にある太もものリボンのみは見える構図の場合は外さないようお願いしたいです。(見えない構図の場合は気にしないで頂いて結構です。)\n構図･表情等の詳細な指定は特にございません。\n\nご検討頂ければ幸いです、宜しくお願いします!\n\nhttps://imgur.com/jAuAEH6", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/25", "thumbnail_src": "https://si.imgix.net/8514fd69/uploads/origins/5dadad03-e2b9-49b3-b261-30593f853e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ee104df419e1f796f490b4fdb1af8d", "thumbnail_srcset": "https://si.imgix.net/8514fd69/uploads/origins/5dadad03-e2b9-49b3-b261-30593f853e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0ee104df419e1f796f490b4fdb1af8d, https://si.imgix.net/8514fd69/uploads/origins/5dadad03-e2b9-49b3-b261-30593f853e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae04e98fea38fcaa20a82419e46c11ba 2x, https://si.imgix.net/8514fd69/uploads/origins/5dadad03-e2b9-49b3-b261-30593f853e6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f838dff3dbde5899debe88636224938 3x", "genre": "art", "nsfw": false, "body": "こんにちは。\nあなたの作品はとても素敵で、私のOCのためにぜひ依頼したいと思っています。\n\n内気でおてんばなAuRaです。\nすべてお任せしたいと思います。\n左目の細部にご注目ください。\n\n私のOCの参考文献はこちら：https://drive.google.com/drive/folders/1NoyEozHg_-NlYDO4uEE5hLX8n_UgPot4\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/24", "thumbnail_src": "https://si.imgix.net/b135df2f/uploads/origins/48eb945e-00cc-46c9-b5ed-cc032ed53dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba4c9162f27ac0b7bc54b695e20067ce", "thumbnail_srcset": "https://si.imgix.net/b135df2f/uploads/origins/48eb945e-00cc-46c9-b5ed-cc032ed53dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba4c9162f27ac0b7bc54b695e20067ce, https://si.imgix.net/b135df2f/uploads/origins/48eb945e-00cc-46c9-b5ed-cc032ed53dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c5e25053f201c88acd5561d0f484ae7 2x, https://si.imgix.net/b135df2f/uploads/origins/48eb945e-00cc-46c9-b5ed-cc032ed53dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d144765417514977dca90050ef00fc97 3x", "genre": "art", "nsfw": false, "body": "Fate Stay Nightの衛宮士郎のアートを依頼したい。参考資料の1枚目の画像の服装で、赤髪がいい。参考資料の2枚目の画像のアーチャーのポーズで、剣の白夜をあのように構える。士郎だけで、凛はいない。\n彼はポーズで微笑んでいるはずだ。\n\nhttps://imgur.com/a/h9WPDor", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/23", "thumbnail_src": "https://si.imgix.net/9c39e274/uploads/origins/acb0a005-bbc9-4d4e-af1b-fe160bb8da00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91a8873672d3e10ec7989ee0d4b21138", "thumbnail_srcset": "https://si.imgix.net/9c39e274/uploads/origins/acb0a005-bbc9-4d4e-af1b-fe160bb8da00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91a8873672d3e10ec7989ee0d4b21138, https://si.imgix.net/9c39e274/uploads/origins/acb0a005-bbc9-4d4e-af1b-fe160bb8da00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98e7018beb496d35bace6bf94a2a1872 2x, https://si.imgix.net/9c39e274/uploads/origins/acb0a005-bbc9-4d4e-af1b-fe160bb8da00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d71e20ef9c9381952c28899e4090486a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！アピールをありがとう。まだ間に合いますでしょうか？もしよろしければ、私のOCみゆの依頼をお願いしたいです！\n\n下のURLに貼ってある衣装でお願いします：\nhttps://drive.google.com/drive/u/1/folders/1wqNf1hAqxCip-3Nzy-MmWPDSq9Ro6y6W\n\nあとはお任せします。よろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/1wqNf1hAqxCip-3Nzy-MmWPDSq9Ro6y6W", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/22", "thumbnail_src": "https://si.imgix.net/a3705c93/uploads/origins/32a3c2d6-4148-4c1a-a174-ed5fe124f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7baa1aeed659fb9dd857e71804620d48", "thumbnail_srcset": "https://si.imgix.net/a3705c93/uploads/origins/32a3c2d6-4148-4c1a-a174-ed5fe124f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7baa1aeed659fb9dd857e71804620d48, https://si.imgix.net/a3705c93/uploads/origins/32a3c2d6-4148-4c1a-a174-ed5fe124f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3c3ff23e514e89225193fb643b05b8a 2x, https://si.imgix.net/a3705c93/uploads/origins/32a3c2d6-4148-4c1a-a174-ed5fe124f7d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8fa55005c014a81e9ed488e2ed06037 3x", "genre": "art", "nsfw": false, "body": "こんにちは。私のキャラクターはローズピンクの髪に薄いティールの瞳をしたネコミミの女性です。どんな風に描いても構いません。", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/21", "thumbnail_src": "https://si.imgix.net/caebf896/uploads/origins/b735bf07-3267-4c77-aa96-baa11e61812d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0cf85cbbd33bf049c25d04a00aaa43c", "thumbnail_srcset": "https://si.imgix.net/caebf896/uploads/origins/b735bf07-3267-4c77-aa96-baa11e61812d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0cf85cbbd33bf049c25d04a00aaa43c, https://si.imgix.net/caebf896/uploads/origins/b735bf07-3267-4c77-aa96-baa11e61812d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25a49c811d1672e83227fedac1f8871f 2x, https://si.imgix.net/caebf896/uploads/origins/b735bf07-3267-4c77-aa96-baa11e61812d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=473da9ae7acde4430fe43b93476cb265 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お申し込みありがとうございます！ご依頼をお受けしたいと思います。\n\n『装甲悪鬼村正』より、三世村正の作品をお願いしたいです。\n\n以前の作品に似た彼氏シャツを着た姿が見たいです。優しく愛情深い表情を浮かべていただき、できれば脚も見える全身像でお願いします。\n\nお時間をいただきありがとうございました！あなたの作品は本当に気に入っています！\n\n衣装：https://www.pixiv.net/en/artworks/118457948\n\nhttps://imgur.com/a/L54VDr5", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/20", "thumbnail_src": "https://si.imgix.net/8e1abf34/uploads/origins/992679bd-99cf-4982-881a-4e8831a5a6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8991cdea88253bfdcd87ca16bbe191dd", "thumbnail_srcset": "https://si.imgix.net/8e1abf34/uploads/origins/992679bd-99cf-4982-881a-4e8831a5a6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8991cdea88253bfdcd87ca16bbe191dd, https://si.imgix.net/8e1abf34/uploads/origins/992679bd-99cf-4982-881a-4e8831a5a6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cf7a694b69faed72d56c0e6561ed507 2x, https://si.imgix.net/8e1abf34/uploads/origins/992679bd-99cf-4982-881a-4e8831a5a6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f12b9d6827cba71d9bf5c4b8c51ab598 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアピールに感謝します！あなたのバターのような滑らかなアートスタイルがとても好きです！\n\n私のキャラクターを気に入ってくれてとても嬉しいです。彼女はブルームーンウルフギャングのリーダーです！\n\n驚かせてください！\n\n参考：https://drive.google.com/file/d/1h2s86WqefsLvksAsByTnO_V6O4_To2yw/view?usp=sharing\n\nhttps://drive.google.com/file/d/1h2s86WqefsLvksAsByTnO_V6O4_To2yw/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/19", "thumbnail_src": "https://si.imgix.net/c1f673ed/uploads/origins/fba91222-2009-4e06-ba75-d15c766284e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=731372ea218b8b1fcd2ab124c8a034fb", "thumbnail_srcset": "https://si.imgix.net/c1f673ed/uploads/origins/fba91222-2009-4e06-ba75-d15c766284e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=731372ea218b8b1fcd2ab124c8a034fb, https://si.imgix.net/c1f673ed/uploads/origins/fba91222-2009-4e06-ba75-d15c766284e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07f7f7bb4155ab6c877ec0172cec73b7 2x, https://si.imgix.net/c1f673ed/uploads/origins/fba91222-2009-4e06-ba75-d15c766284e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bed2c1857b81003fbb86d733f8f98b7d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nアピールをありがとう！あなたがアピールを送ってから、SNSであなたのアートをフォローしてるんだけど、あなたのアートスタイルは本当に素敵ね！アピールの返信が遅くなって申し訳ない ^^;;\nLiabellのデザインはどちらをご覧になったのか分かりません。でも、2つのデザインのどれでもいいので、彼女のイラストが欲しいです！\n\nLiabellは元不良ですが、今は星を愛する錬金術師です！どこか飄々とした性格だが、いざとなると責任感が強いのは蒼崎青子に似ている！彼女の剣士のデザインは性格が似ているが、剣術と放浪の生活のため、より自信に満ちている！\n\nアルケミスト： \nhttps://drive.google.com/file/d/10zrNXyrfb25wYBiiKqx-Gt9J6Q4zD39t/view?usp=drive_link\nhttps://drive.google.com/file/d/1Pyf6y6tf1lUF5yVYTsW3x27RB09OkWSL/view?usp=sharing\n\nソードウーマン ： \nhttps://drive.google.com/file/d/1P75JawP3pkhGxYXO7xErBEFLVOcyxQ9Q/view?usp=drive_link \nhttps://drive.google.com/file/d/1txNUkyr17x8dolckRD1I9fS22FYEx59w/view?usp=sharing\n\n構図やポーズは問いません。あなたのアートスタイルで私のキャラクターが見れたら嬉しいです！\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/18", "thumbnail_src": "https://si.imgix.net/e4b4ea94/uploads/origins/d2e3d56d-a53a-4993-af2c-a5da1e02ac81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=426349bcb00687b7d9588c9779db8b82", "thumbnail_srcset": "https://si.imgix.net/e4b4ea94/uploads/origins/d2e3d56d-a53a-4993-af2c-a5da1e02ac81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=426349bcb00687b7d9588c9779db8b82, https://si.imgix.net/e4b4ea94/uploads/origins/d2e3d56d-a53a-4993-af2c-a5da1e02ac81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ede46bba4c2bd4546b8165eaff30105d 2x, https://si.imgix.net/e4b4ea94/uploads/origins/d2e3d56d-a53a-4993-af2c-a5da1e02ac81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86053024ee339c79bdb29be61df5727f 3x", "genre": "art", "nsfw": false, "body": "初めまして、巌守怒鬼様。\n個人Vstreamerの藪内ぱんだと申します。\n\nアピールいただきありがとうございます！\n是非とも巌守怒鬼様に素敵なイラストを描いていただきたいです！\n\nリクエスト内容は藪内ぱんだの通常衣装のイラスト、もしくはFGOのランサー・スカサハ師匠のコスプレをしているぱんだを描いていただきたいです...!\n衣装や構図、ヘアアレンジ等はお任せします!衣装のぴっちり感が感じられるととても喜びます！\n衣装をそのまま描かれる場合はXにて使用しているイラストタグを参考にしていただけますと幸いです。\n\nX URL : https://twitter.com/YabuuchiPanda\nイラストタグ #ぱんだのお宝画廊\n全身立ち絵：https://x.com/YabuuchiPanda/status/1735948991693738442\n\n\n・使用用途\n配信活動(SNS投稿等)に使用させていただきたいです。\n\n・納品形式\n金額の範囲内で可能であれば人物データと背景、宛名が分かれているPSDでの納品希望です\n\nお忙しいとは思いますが、何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/17", "thumbnail_src": "https://si.imgix.net/eb4afc81/uploads/origins/35f7696c-007d-4998-ac61-5e2e849dcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbe588571a23f5ada1442e35f572957a", "thumbnail_srcset": "https://si.imgix.net/eb4afc81/uploads/origins/35f7696c-007d-4998-ac61-5e2e849dcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbe588571a23f5ada1442e35f572957a, https://si.imgix.net/eb4afc81/uploads/origins/35f7696c-007d-4998-ac61-5e2e849dcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3412792958370eb19138d0956031330 2x, https://si.imgix.net/eb4afc81/uploads/origins/35f7696c-007d-4998-ac61-5e2e849dcb52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ea6df7a5747956d420647b412b6cd0d 3x", "genre": "art", "nsfw": false, "body": "お返事遅くなってしまいました\nアピールありがとうございます\nFGOより水着か通常のカーマの第3再臨を描いていただけないでしょうか\n構図等はお任せします\n完成品はサインあり、なし、人物のみの物が欲しいです\n\n学習への賛否で判断が分かれると思いますので私から各種SNSへのアップロードはしません\n\n各種SNSや配信サイトでのアイコンやヘッダーへの使用許可をいただきたいです\n\n個人で利用するアクセサリー程度への印刷使用の許可をいただきたいです\n\n色々書かせていただきました\nもし条件に合いましたらよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@gannmodoki17/works/16", "thumbnail_src": "https://si.imgix.net/e506c862/uploads/origins/2b58cad3-fec0-43c2-8528-dcacb0767511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop