があります。\nお手数おかけしますがキャラのみ透過差分も欲しいです。\n形式はpsdまたはpngでお願いします。\n\n以上の内容でお受けできそうであれば、お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@waowaoland/works/13", "thumbnail_src": "https://si.imgix.net/a14ea75b/uploads/origins/9f9d4d88-c9d4-4f78-8667-32c255d83555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aba4b82a4961db001c8928f6aee7dfec", "thumbnail_srcset": "https://si.imgix.net/a14ea75b/uploads/origins/9f9d4d88-c9d4-4f78-8667-32c255d83555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aba4b82a4961db001c8928f6aee7dfec, https://si.imgix.net/a14ea75b/uploads/origins/9f9d4d88-c9d4-4f78-8667-32c255d83555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c6cc6879c7a2aabc9093e166ec0fe68 2x, https://si.imgix.net/a14ea75b/uploads/origins/9f9d4d88-c9d4-4f78-8667-32c255d83555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=475802029b21ec8910034ad89ea97ac8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@waowaoland/works/12", "thumbnail_src": "https://si.imgix.net/e1bfe87e/uploads/origins/7f811173-a025-443b-9dc9-80282bf74c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee94d5e1df61d2e15c75b2e06ffbca8", "thumbnail_srcset": "https://si.imgix.net/e1bfe87e/uploads/origins/7f811173-a025-443b-9dc9-80282bf74c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee94d5e1df61d2e15c75b2e06ffbca8, https://si.imgix.net/e1bfe87e/uploads/origins/7f811173-a025-443b-9dc9-80282bf74c09?bg=%23fff&auto=format%2Ccompr