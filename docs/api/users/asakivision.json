d=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cbf469c47c1c4a7992bfb8f8c7b6576, https://si.imgix.net/a32fc9df/uploads/origins/44277515-aec1-4cb0-8c84-3a9fe546d340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d2cac2e149e05eb30ae41a8a3f9427d 2x, https://si.imgix.net/a32fc9df/uploads/origins/44277515-aec1-4cb0-8c84-3a9fe546d340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d9045120e82a8243903cc0e71b0e810 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/15", "thumbnail_src": "https://si.imgix.net/1f1216fd/uploads/origins/0641963f-7898-47ab-b152-ccd2050588f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56dcbff830c1d05e95411127db4412dc", "thumbnail_srcset": "https://si.imgix.net/1f1216fd/uploads/origins/0641963f-7898-47ab-b152-ccd2050588f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56dcbff830c1d05e95411127db4412dc, https://si.imgix.net/1f1216fd/uploads/origins/0641963f-7898-47ab-b152-ccd2050588f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5b8ff5274d484a2ba9a2a0d59e31eea 2x, https://si.imgix.net/1f1216fd/uploads/origins/0641963f-7898-47ab-b152-ccd2050588f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f4b9bc4e6cc77c27efb9cc186ac6c9d 3x", "genre": "art", "nsfw": false, "body": "作品：遊戯王\nキャラクター：波動竜騎士 ドラゴエクィテス\n\n内容：ドラゴエクィテスが槍を投擲しようと構えている絵\n・背景は青空で、空中にいる設定でお願いします\n・それ以外の要素はお任せします\n\n流星輝巧群の絵がとても好みだったので依頼させて頂きました\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/14", "thumbnail_src": "https://si.imgix.net/2e99d388/uploads/origins/5ec8c1d9-ad38-4ace-b08e-c88f4866c2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca38162795d2ac14cf9af47aae9ef22f", "thumbnail_srcset": "https://si.imgix.net/2e99d388/uploads/origins/5ec8c1d9-ad38-4ace-b08e-c88f4866c2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca38162795d2ac14cf9af47aae9ef22f, https://si.imgix.net/2e99d388/uploads/origins/5ec8c1d9-ad38-4ace-b08e-c88f4866c2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a6e65755349054e615ea5d1c48846be 2x, https://si.imgix.net/2e99d388/uploads/origins/5ec8c1d9-ad38-4ace-b08e-c88f4866c2f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4277279c5224540342a052e23ac7b7b1 3x", "genre": "art", "nsfw": false, "body": "初めまして、Twitterなどでイラストをよく拝見しています。\nAsakiさんの描かれる、ドラゴンや機械系モンスターのイラストがとても好きです。メディア欄にあったアルティメット・ファルコンのイラストもとても神々しくて素敵だったので依頼させて頂きます。\n\n遊戯王OCGより「デストーイ・シザー・タイガー」と、「RR-アルティメット・ファルコン」もしくは「RR-ライジング・リベリオン・ファルコン」のイラストをお願いします。カードイラスト等資料で見えない部分は想像で補完して頂いて構いません。\n夜のビル街で、RRモンスターにシザー・タイガーがが飛びかかるような構図だと嬉しいです。\n\nシザー・タイガーのサイズ感資料です(私のツイートです)。\nhttps://twitter.com/rate_kansoAKA/status/1730261800221053131\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/13", "thumbnail_src": "https://si.imgix.net/76a8d143/uploads/origins/6a01ad2c-c5e4-4fcc-99c2-6a4edf18abd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86076449fc880e867348d968b6599209", "thumbnail_srcset": "https://si.imgix.net/76a8d143/uploads/origins/6a01ad2c-c5e4-4fcc-99c2-6a4edf18abd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86076449fc880e867348d968b6599209, https://si.imgix.net/76a8d143/uploads/origins/6a01ad2c-c5e4-4fcc-99c2-6a4edf18abd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae4a6216118338f61ec66d87f015ca30 2x, https://si.imgix.net/76a8d143/uploads/origins/6a01ad2c-c5e4-4fcc-99c2-6a4edf18abd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b853bb185f9a38e737bc1366104a6f8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/12", "thumbnail_src": "https://si.imgix.net/44e09cc3/uploads/origins/22b390ad-4146-445c-b786-124e66e70729?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57c798fd33116de5b78d7642d9f3a515", "thumbnail_srcset": "https://si.imgix.net/44e09cc3/uploads/origins/22b390ad-4146-445c-b786-124e66e70729?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57c798fd33116de5b78d7642d9f3a515, https://si.imgix.net/44e09cc3/uploads/origins/22b390ad-4146-445c-b786-124e66e70729?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb4092312622d13691353368e96c6fc8 2x, https://si.imgix.net/44e09cc3/uploads/origins/22b390ad-4146-445c-b786-124e66e70729?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6875408cde252625efa5f6a88477210 3x", "genre": "art", "nsfw": false, "body": "Asaki様\n\n初めまして凌央と申します。\n先日投稿されておりましたアライズハートのイラスト非常に美しかったです。\n\nこの度、遊戯王カードのイラストを描いていただきたくご連絡させていただきました。\n描いていただきたいと考えているカードは『智天の神星龍(セフィラ・トーラ・グラマトン)』です。\n↓下記リンクに参考イラストがございます\nhttps://x.com/YuGiOh_OCG_INFO/status/1176330413012332546?s=20\nhttps://www.db.yugioh-card.com/yugiohdb/card_search.action?ope=2&cid=12944&request_locale=ja\n\n構図は以前投稿されておりましたガルニクスのように巨大さが伝わるような雰囲気を出していただければと思います。\n\n用途といたしましてはPCの壁紙、またご許可いただければ個人利用のみでプレイマットにして使用させていただきたいです。\n\nつたない文章で申し訳ございませんがご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/11", "thumbnail_src": "https://si.imgix.net/fabb28e5/uploads/origins/4ad4088d-086b-4d7e-89fe-6906af47f8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f600653bc28d6b4bc5fc97d4be0dd373", "thumbnail_srcset": "https://si.imgix.net/fabb28e5/uploads/origins/4ad4088d-086b-4d7e-89fe-6906af47f8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f600653bc28d6b4bc5fc97d4be0dd373, https://si.imgix.net/fabb28e5/uploads/origins/4ad4088d-086b-4d7e-89fe-6906af47f8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8a5693c558a531514cb9a8aab621991 2x, https://si.imgix.net/fabb28e5/uploads/origins/4ad4088d-086b-4d7e-89fe-6906af47f8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd22f6d5747037547a683435c5bb8c82 3x", "genre": "art", "nsfw": false, "body": "您好、很喜歡您的風格\n想委託TRPG角色的立繪，\n以您的風格呈現就好，這是提供參考的角色資料\nhttps://drive.google.com/drive/folders/1T18GZqghowC_36QFqDx37zCmWoguYA3t?usp=sharing\n\n背後希望能加上這一種太陽的寶輪，背景則為黃昏色的天空\nhttps://cdn.discordapp.com/attachments/744884296719794276/929548927076810832/commission122_1.png", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/10", "thumbnail_src": "https://si.imgix.net/f7f2912f/uploads/origins/432a0262-ea32-435e-8a96-3093d95539a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f27387ef8460b4c66431d41a66b36f77", "thumbnail_srcset": "https://si.imgix.net/f7f2912f/uploads/origins/432a0262-ea32-435e-8a96-3093d95539a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f27387ef8460b4c66431d41a66b36f77, https://si.imgix.net/f7f2912f/uploads/origins/432a0262-ea32-435e-8a96-3093d95539a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2315684eaaf46d41d4f0cd22a61b4ad 2x, https://si.imgix.net/f7f2912f/uploads/origins/432a0262-ea32-435e-8a96-3093d95539a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5cea3865192d4f47791384b14ed8052 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ハマヌーンと申します。\n2回目の依頼となりますが何卒よろしくお願い申し上げます。今回は大型モンスターのイラストをお願いいたします。\n\nモンスター：Kozmo - ダークシミター\n\n・アスペクト比はいつもの大きさで大丈夫です。(pc壁紙のサイズ)\n・構図/背景はお任せします。\n・巨大でメタリックな雰囲気があると嬉しいです。\n・ビームとエンジンを出すか否かはお任せします。(Asakiさんのしっくり来た方で大丈夫です。)\n\n参考資料ですがカードイラストの他に、遊戯王デュエルリンクスのモンスター映像があります。他人のYouTubeのショート動画になりますが、描画の手助けになれば幸いです。\n\nよろしくお願いいたします。\n\nhttps://youtube.com/shorts/1tNsyf1kGbE?si=sW2bGr6FAz_NcnXp", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/9", "thumbnail_src": "https://si.imgix.net/c8d1990b/uploads/origins/3e0eeb54-9da9-4e5b-a187-31404362d768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=589bdb542ff852b4ec7ba00e9f288d8a", "thumbnail_srcset": "https://si.imgix.net/c8d1990b/uploads/origins/3e0eeb54-9da9-4e5b-a187-31404362d768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=589bdb542ff852b4ec7ba00e9f288d8a, https://si.imgix.net/c8d1990b/uploads/origins/3e0eeb54-9da9-4e5b-a187-31404362d768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f4dcce0624a1201e35ff084fbee03ab 2x, https://si.imgix.net/c8d1990b/uploads/origins/3e0eeb54-9da9-4e5b-a187-31404362d768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d470658fdf4e2408cc7b124e3db3044 3x", "genre": "art", "nsfw": false, "body": "遊戯王OCGのクシャトリラ・アライズハートートを描いてください。\n赤の配色、翼、尻尾を強調してください。\n崖の上にいるアライズハートを描いてください。景色は地平線まで広がっている。\nこのようなイメージだが、座っているのではなく立っている。カメラアングルの関係で、これが最良の例である。https://gelbooru.com/index.php?page=post&s=view&id=6333926\n\n他にもいくつか例がある。\nhttps://gelbooru.com/index.php?page=post&s=view&id=3510649\nhttps://gelbooru.com/index.php?page=post&s=view&id=3421265\n建築はこのようになる。\nhttps://yugipedia.com/wiki/File:KashtiraBirth-MADU-EN-VG-artwork.png\nhttps://yugipedia.com/wiki/File:PressuredPlanetWraitsoth-MADU-EN-VG-artwork.png\nhttps://yugipedia.com/wiki/File:KashtiraFenrir-MADU-EN-VG-artwork.png\n\nhttps://yugipedia.com/wiki/File:KashtiraAriseHeart-MADU-EN-VG-artwork.png", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/8", "thumbnail_src": "https://si.imgix.net/d88fe5b8/uploads/origins/7c1b9090-f8ad-4fd8-ae80-e1ab27610b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e665bccb91a17caeb789039bfd36d24", "thumbnail_srcset": "https://si.imgix.net/d88fe5b8/uploads/origins/7c1b9090-f8ad-4fd8-ae80-e1ab27610b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e665bccb91a17caeb789039bfd36d24, https://si.imgix.net/d88fe5b8/uploads/origins/7c1b9090-f8ad-4fd8-ae80-e1ab27610b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74ed6941d1e130f1a5398a5c744dccc7 2x, https://si.imgix.net/d88fe5b8/uploads/origins/7c1b9090-f8ad-4fd8-ae80-e1ab27610b9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c800a2263b35444b2949843d725605b 3x", "genre": "art", "nsfw": false, "body": "マスターデュエルで印象に残ったところをイラストにしたいのです。\n\n《鏡の御巫ニニ》と《御巫の水舞踏》を踊る《スケアクロー・トライヒハート》、ニニをからかっている《灰流うらら》をお願いします。\n\nトライヒに水舞踏をうららで止めたらその後の天底ヌトスや烙印の獣も水舞踏が無効化する友情コンボが成立して勝ったのが印象的でした。\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/7", "thumbnail_src": "https://si.imgix.net/32fdc047/uploads/origins/0fa70f11-008d-4fed-b825-38cbc17754f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08c52344ce50b0fde6eb1b32fb3fc25a", "thumbnail_srcset": "https://si.imgix.net/32fdc047/uploads/origins/0fa70f11-008d-4fed-b825-38cbc17754f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08c52344ce50b0fde6eb1b32fb3fc25a, https://si.imgix.net/32fdc047/uploads/origins/0fa70f11-008d-4fed-b825-38cbc17754f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=408de68ded904bfe456548f7e6ee0ae4 2x, https://si.imgix.net/32fdc047/uploads/origins/0fa70f11-008d-4fed-b825-38cbc17754f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88c868dfddee202ded91ab0d0a7181a5 3x", "genre": "art", "nsfw": false, "body": "こんにちは、依頼をお願いしたいです。神器AA-ゼウスと同じスタイルで、代わりにガルニクス・エタニティ、火王の香をお願いしたいです。これは新しい火王構成のデッキで登場する新しいランク8です。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/6", "thumbnail_src": "https://si.imgix.net/fa99737e/uploads/origins/96ed154f-66d6-4623-ad36-6d62f9a265b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3d976894d0d28393c57515b5bd1aee4", "thumbnail_srcset": "https://si.imgix.net/fa99737e/uploads/origins/96ed154f-66d6-4623-ad36-6d62f9a265b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3d976894d0d28393c57515b5bd1aee4, https://si.imgix.net/fa99737e/uploads/origins/96ed154f-66d6-4623-ad36-6d62f9a265b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b827d81b9f156920b3e370f876057b7 2x, https://si.imgix.net/fa99737e/uploads/origins/96ed154f-66d6-4623-ad36-6d62f9a265b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a03c6ebfcbc63a8ca78d76331860bbd8 3x", "genre": "art", "nsfw": false, "body": "初めましてMakyuと申します\n\n古代の機械巨人のイラストをお願いいたします\n\n・画角はお任せします。\n・アスペクト比はPCの壁紙に使える横に広がりがあるものでお願いします\n・パーツを構成する歯車等、パーツは元のイラストにできるだけ準拠でお願いいたします（細かい話になりますが、もし必要な場合、腰の後ろ掛けは初期のカードの絵にはありませんが有る方でお願いします。）\n・構図・ポーズはお任せします。\n・背景はお任せしますが巨大な感じが出れば最高です。\n・雰囲気は全体的に無骨な重々しさがあると助かります。\n・最後に何よりもアンティークの機械としての錆びや色褪せ、へこみなどを意識していただけるようお願いいたします。\n\n注文が多くなって申し訳ありません。\n\n参考資料等を下記のリンクに置いておきます\nhttps://drive.google.com/drive/folders/17RiIHEU3sezZWK3_98Bp7WMLTbVYRdyx?usp=drive_link\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/5", "thumbnail_src": "https://si.imgix.net/ce6c7681/uploads/origins/895714c1-37a3-4a7d-b37b-adb1537df4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=826913e17f1a685b35b3b7f5a7140d2a", "thumbnail_srcset": "https://si.imgix.net/ce6c7681/uploads/origins/895714c1-37a3-4a7d-b37b-adb1537df4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=826913e17f1a685b35b3b7f5a7140d2a, https://si.imgix.net/ce6c7681/uploads/origins/895714c1-37a3-4a7d-b37b-adb1537df4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3d8b450c6016644b6c0deec99b70e49 2x, https://si.imgix.net/ce6c7681/uploads/origins/895714c1-37a3-4a7d-b37b-adb1537df4b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b399d8120b310f10b82ca742429de76 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/4", "thumbnail_src": "https://si.imgix.net/7924f50a/uploads/origins/9d70f930-3c05-4af8-9209-a022b7bb1888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca078cee8d7882df5b7c80a496f98383", "thumbnail_srcset": "https://si.imgix.net/7924f50a/uploads/origins/9d70f930-3c05-4af8-9209-a022b7bb1888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca078cee8d7882df5b7c80a496f98383, https://si.imgix.net/7924f50a/uploads/origins/9d70f930-3c05-4af8-9209-a022b7bb1888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2a7c1f3caf90bd02350d898c92dd57c 2x, https://si.imgix.net/7924f50a/uploads/origins/9d70f930-3c05-4af8-9209-a022b7bb1888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3a256c71c95671ad51397e02774c333 3x", "genre": "art", "nsfw": false, "body": "水晶機巧-サルファフナーのイラストをお願いします。\n\n・用途\nPCの壁紙として用います。\n・全体の雰囲気\n荘厳なものにしてください。\n・構図\n左右それぞれ、全体の幅に対する1割程度は背景のみにしてください。なお、キャラクターの羽など部分的に重なることは構いません。\n・キャラクターのポーズ\nカードイラストを意識したものにしてください。口は閉じていてください。\n・キャラクターのデザイン\n宝石がテーマのキャラクターではありますが、燦然と輝かせるのは避けてください。\n・イラストの背景\nカードイラストのようなきらきらしたものではなく、暗めなものにしてください。\n\nカードイラストについてはX(旧Twitter)に投稿したものを記載します。\nhttps://x.com/GICTSS/status/1703391596610470329?s=20\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/3", "thumbnail_src": "https://si.imgix.net/d5a582bb/uploads/origins/6af64001-9a47-410a-b3fa-48d69e29a234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7ab6d47edf258335669de4d3567c63f", "thumbnail_srcset": "https://si.imgix.net/d5a582bb/uploads/origins/6af64001-9a47-410a-b3fa-48d69e29a234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7ab6d47edf258335669de4d3567c63f, https://si.imgix.net/d5a582bb/uploads/origins/6af64001-9a47-410a-b3fa-48d69e29a234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d90edac8af6da6e91aaf2d5a168f60b8 2x, https://si.imgix.net/d5a582bb/uploads/origins/6af64001-9a47-410a-b3fa-48d69e29a234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bed4168fdcc654c5d634cfd1b06b70c 3x", "genre": "art", "nsfw": false, "body": "遊戯王OCGのモンスター達で、よくあるオールスターお祭り映画のワンシーン的なイラストを描いて頂きたいです。\n\nシチュエーション\n赤黒い煙で覆われた空の下、下記のキャラクター達が破壊された都市の瓦礫の上に立っていて、ある一点を見つめて各々の武器を構えている。ラスボス戦直前のシリアスでひりついた雰囲気。個々のキャラの立ち位置や構図、ポーズや表情についてはお任せします。\n\nキャラクター\n・剣聖の影霊衣－セフィラセイバー\n・真竜剣皇マスターP\n・双穹の騎士アストラム\n・アルバスの落胤\n・ヴィサス=アムリターラ\n・閃刀姫－カガリ\n・S-Force乱破小夜丸\n・リブロマンサー・ファイアバースト\n・黒魔女ディアベルスター\n・聖殿の水遣い\n\nよろしければ検討をお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/2", "thumbnail_src": "https://si.imgix.net/42faebb9/uploads/origins/0baff572-37e5-4056-8a22-ab709a5625db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b74c92040d49664815c7c7a4b0aca6eb", "thumbnail_srcset": "https://si.imgix.net/42faebb9/uploads/origins/0baff572-37e5-4056-8a22-ab709a5625db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b74c92040d49664815c7c7a4b0aca6eb, https://si.imgix.net/42faebb9/uploads/origins/0baff572-37e5-4056-8a22-ab709a5625db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49bd4b2e7ef1fb4b288a2bdb77f0d06c 2x, https://si.imgix.net/42faebb9/uploads/origins/0baff572-37e5-4056-8a22-ab709a5625db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0649e7cb502a5820708c06ca0a26c3c8 3x", "genre": "art", "nsfw": false, "body": "初めまして、ハマヌーンと申します。\nAsakiさんの絵の雰囲気が好きでいつも楽しみにしております。巨大なモンスターと淡い人物画の2つで迷いましたが、今回は人物画の方を依頼させていただきます。\n\nキャラクター：レプティレス・エキドゥーナ\n\n・ポーズ/画角はお任せします。\n・腰のラインがシャープ/尻のボリュームがあると嬉しいです。\n・金の装飾は全て描くよりはAsakiさんの絵の雰囲気を第一にして、くどくなった箇所は省いても構いません。\n・背景も概ねお任せします。レプティレスモンスターの背景が大体モヤモヤしてるのでその路線でお願いします。\n\n\n＊以下はもし可能だったら程度で無理なら無視してください。\n・「エキドゥーナの冠」単体のみの画像\n(こちらの冠の方のイラストはプライベートのアカウントのアイコンに使用したいと思っています。)\n\n以上、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@asakivision/works/1", "thumbnail_src": "https://si.imgix.net/b77393ae/uploads/origins/182e50e0-3832-4297-add8-433760a6bfff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77137bc8af61247c854daca8711c7131", "thumbnail_srcset": "https://si.imgix.net/b77393ae/uploads/origins/182e50e0-3832-4297-add8-433760a6bfff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77137bc8af61247c854daca8711c7131, https://si.imgix.net/b77393ae/uploads/origins/182e50e0-3832-4297-add8-433760a6bfff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=785a1f42043253c12f00306e900fa518 2x, https://si.imgix.net/b77393ae/uploads/origins/182e50e0-3832-4297-add8-433760a6bfff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed063864d5504d709f0162c479f9b060 3x", "genre": "art", "nsfw": false, "body": "私の要望を考慮してくれてありがとう！\n\n私はTwitchでTRPGを配信しており、メカTTRPGでプレイしています！もしよろしければ、私のキャラクターのメカの絵を頂きたいです！もし可能であれば、その画像をtwitterで配信の宣伝に使いたいですし、休憩中に視聴者に見せたいです！\n\nこれが私のキャラクターのメカです： https://imgur.com/a/Eg6uSgV\n大きな一つ目で、巨大な潜水服がベースになっています！背中には半透明の液体で満たされた大きな翼があり、まるで海の天使の腕のようです。https://www.montereybayaquarium.org/globalassets/mba/images/animals/deep-sea/mba/sea-angels-tr20-0137-composite.jpg\n\n好きなポーズや設定で描いてください！\n\nありがとうございました！", "created_at": "", "completed_at": ""}]}