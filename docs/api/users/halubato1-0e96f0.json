8-457b-b81a-6d17de3576f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db9f910201961e7e68906ef63576a9a5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/45", "thumbnail_src": "https://si.imgix.net/9c8f7403/uploads/origins/64adb314-36ba-48bf-a519-60bed1944fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87adb95adb04d5d5049e3ea703bcd365", "thumbnail_srcset": "https://si.imgix.net/9c8f7403/uploads/origins/64adb314-36ba-48bf-a519-60bed1944fae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87adb95adb04d5d5049e3ea703bcd365, https://si.imgix.net/9c8f7403/uploads/origins/64adb314-36ba-48bf-a519-60bed1944fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81aed3f405801d978d4cf5fe8d84d3e2 2x, https://si.imgix.net/9c8f7403/uploads/origins/64adb314-36ba-48bf-a519-60bed1944fae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=baf491aae17034713caa1dea3d4941a1 3x", "genre": "art", "nsfw": true, "body": "ラジュルネには\n反抗的上向き乳首と\n分からせひょっとこフェラがよく合う。\n\n上記作品には大変お世話になりました…！\nラジュルネが好きなためぜひともリクをお願いしたいです。\n\nトリプルバトルでなす術なく負かされたラジュルネちゃんがマジの実力を〜〜\nと言い出したところで手抜きに竿役激怒\n手持ちのサザンドラによって犯されてしまうというようなシチュを見てみたいです。\n\n竿役は自慢のサザンを相手に負け惜しみされたこと＋トリプルの名手と聞いていたのに\n口だけで拍子抜けのためサザンに交尾させるという形となります。\n\n弱々なシャトレーヌはタマゴ孕むまで濃厚交尾してな笑\n\nシャトレーヌとしてよりポケモンとのSEXの方が才能あるんじゃない笑\n\nとか煽り台詞多めで\n\n最終的にラジュルネはサザンの大量精液で完堕ちし\nポケモン専属のAV女優デビューを宣言しちゃうみたいなのを見てみたいです。\n\n胸の大きさは過去絵のハルヒカくぱぁのヒカリくらいでお願いできればと思います。\n\nアナ○プレイはNG\n課長に関しては博多弁は難しいと思いますので通常の手加減時のたかびーお嬢さま的な口調参照で問題ございません。\n\n台詞あった方がなどあればご対応可能でございますのでその際は再送依頼いただければと思います、ご検討のほど何卒よろしくお願いいたします。\n\nhttps://skeb.jp/@halubato1/works/33", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/44", "thumbnail_src": "https://si.imgix.net/43126b47/uploads/origins/e5d6698c-9387-48a5-b927-09d9c2e9060c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c81c000907e7fc8571f60601b288be", "thumbnail_srcset": "https://si.imgix.net/43126b47/uploads/origins/e5d6698c-9387-48a5-b927-09d9c2e9060c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81c81c000907e7fc8571f60601b288be, https://si.imgix.net/43126b47/uploads/origins/e5d6698c-9387-48a5-b927-09d9c2e9060c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=debe78e6651b327707e6c6a0aa20bfa5 2x, https://si.imgix.net/43126b47/uploads/origins/e5d6698c-9387-48a5-b927-09d9c2e9060c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdc9f7bd47549614af35b2bf9d9c9bdd 3x", "genre": "art", "nsfw": true, "body": "遊戯王ラッシュデュエルのハーピィ・チェーロのイラストをお願いします。\n\n・服装はレオタードを脱いでおり足部分は履いたまま。\n・ポーズはエロ蹲踞。\n・シチュエーションは偶然にも産卵のタイミングで召喚されてしまい、デュエル中に卵を産みながら絶頂する姿を晒してしまう。\n・よろしければ以下の差分をお願いします。\n1.卵が女性器から飛び出そうな状態でいきんでいる。\n2.自分が見られていることに気付き、驚いて赤面するが産卵が止められない。\n3.卵を産み落とし、性器が広がったまま潮吹き絶頂、噴乳。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/43", "thumbnail_src": "https://si.imgix.net/0f549f49/uploads/origins/fac17272-b0e4-4165-8e54-166f17a02b67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf20a6b0e4373315cdb705e6698e306c", "thumbnail_srcset": "https://si.imgix.net/0f549f49/uploads/origins/fac17272-b0e4-4165-8e54-166f17a02b67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf20a6b0e4373315cdb705e6698e306c, https://si.imgix.net/0f549f49/uploads/origins/fac17272-b0e4-4165-8e54-166f17a02b67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90e64e6549edf18f54cee19f38badf59 2x, https://si.imgix.net/0f549f49/uploads/origins/fac17272-b0e4-4165-8e54-166f17a02b67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffef27a6f86d0413a7ee2f440157c009 3x", "genre": "art", "nsfw": true, "body": "いつもイラスト楽しませて頂いております。\n他の方のリクエストへの便乗になってしまうのですが、『ハナJDでデリヘル傭兵団ネタ』をお願いできますでしょうか？\n\n一枚目\n・無知シチュ\n・複数の客に言われるがままにオマ◯コ挨拶をさせられ、写真に収められる。\n\n二枚目\n・輪姦されるハナJD\n・初めは嫌がっていたが、段々と快楽落ち\n\nお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/42", "thumbnail_src": "https://si.imgix.net/73260fff/uploads/origins/41a2c31f-f541-4d0f-85c4-c69557337aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62a49f27a7ecc4fd9a9970dacb44235c", "thumbnail_srcset": "https://si.imgix.net/73260fff/uploads/origins/41a2c31f-f541-4d0f-85c4-c69557337aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62a49f27a7ecc4fd9a9970dacb44235c, https://si.imgix.net/73260fff/uploads/origins/41a2c31f-f541-4d0f-85c4-c69557337aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbb95d9ae55fcdc29a30f8f3f456d696 2x, https://si.imgix.net/73260fff/uploads/origins/41a2c31f-f541-4d0f-85c4-c69557337aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c92d07ac8159ca48220260786867d2a 3x", "genre": "art", "nsfw": true, "body": "こんにちは、はるばとさんが過去にpixivで上げられていた\nトップレスのサキュバスさんでお願いできますでしょうか。\nhttps://www.pixiv.net/artworks/74607426\n\n腰に手を当てるポーズをとったサキュバスさんに見下ろされているアングルでお願いします。\n\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/41", "thumbnail_src": "https://si.imgix.net/dceaf8fa/uploads/origins/71913f76-2502-4f81-9fa6-0408a7067c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a55b29bb481a4b50da2e15fd05931f6c", "thumbnail_srcset": "https://si.imgix.net/dceaf8fa/uploads/origins/71913f76-2502-4f81-9fa6-0408a7067c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a55b29bb481a4b50da2e15fd05931f6c, https://si.imgix.net/dceaf8fa/uploads/origins/71913f76-2502-4f81-9fa6-0408a7067c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14647d99be29ed59e841994ec337f7dc 2x, https://si.imgix.net/dceaf8fa/uploads/origins/71913f76-2502-4f81-9fa6-0408a7067c9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=216430ff2a08d987eb57a9d1766dfae1 3x", "genre": "art", "nsfw": true, "body": "お世話になっております\n匿名希望ながら申し訳ございません\nhttps://skeb.jp/@halubato1/works/33\n上記リクエストを行った者です\n\n手掛けていただいたイラスト日々大変重宝しておりまして、もし叶うようであれば以下内容でのリクエストが出来ますと嬉しいです\n\n・キャラクター\n漫画「ポケスペ」より「クリスタル」\n・シチュエーション\n前回イラストの後半と同一、腕を掴まれての立ちバックを表情が見える別アングルで\nフィニッシュである中出しシーンをお願いできればと思っております\n可能でしたら射精の熱に悶える彼女のセリフもいただけると嬉しいです\n\nお考えあってのリクエスト再開とのことでしたので本旨でない内容であったり、同一キャラクター故にお手数になるようでしたら気兼ねのないキャンセルをお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/40", "thumbnail_src": "https://si.imgix.net/7a0eb35f/uploads/origins/20613108-9e44-46c9-a558-25620d941c30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=048086dbc6c65088131b7643e18f1a0a", "thumbnail_srcset": "https://si.imgix.net/7a0eb35f/uploads/origins/20613108-9e44-46c9-a558-25620d941c30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=048086dbc6c65088131b7643e18f1a0a, https://si.imgix.net/7a0eb35f/uploads/origins/20613108-9e44-46c9-a558-25620d941c30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8eb3315bbbdc5da751bad21a59aa0475 2x, https://si.imgix.net/7a0eb35f/uploads/origins/20613108-9e44-46c9-a558-25620d941c30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=225a997bb067c54b44436e2cf2e379e1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/39", "thumbnail_src": "https://si.imgix.net/ea03b44e/uploads/origins/1f36f652-fb2f-48b2-88c1-08fbd274c9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50d10f3439417b20fd9b1b77b8452b73", "thumbnail_srcset": "https://si.imgix.net/ea03b44e/uploads/origins/1f36f652-fb2f-48b2-88c1-08fbd274c9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50d10f3439417b20fd9b1b77b8452b73, https://si.imgix.net/ea03b44e/uploads/origins/1f36f652-fb2f-48b2-88c1-08fbd274c9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e61e897f5ecf33fe2f78f36cd0010ec6 2x, https://si.imgix.net/ea03b44e/uploads/origins/1f36f652-fb2f-48b2-88c1-08fbd274c9a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc0a7148b987cc3915eddaa5c9975eb4 3x", "genre": "art", "nsfw": true, "body": "キャラ\nナタネ（ポケモンDP）\nおっぱいはいつも描いているような巨乳で\n\nシチュ\n①ナタネが黒インナーを着忘れてきたことを気にしてジムバトルしている。\n②チャレンジャー側のわざ『かぜおこし』で緑の服が舞い上がり、乳首をポロリしてしまう。ついでにチャレンジャーのおちんちんを勃起させてしまう。\n\nセリフ例（改訂可）\n①ナ（やばっ、今日インナー着てくるの忘れた…。）\n　　（…まあ誰も言って来ないからこのままやり過ごして…）\n　チ「ミツハニー！かぜおこしだ！！」\n②ナ「あ」ﾌﾞﾜｯ\n　チ「え」ﾑｸﾑｸﾑｸﾑｸ\n　ナレーション「ダメだ！ナタネのおっぱいを見て、勃起してしまい集中できない！」\n\nその他\n漫画形式でもナタネのみの一枚絵でも構いません。\n漫画形式の場合チャレンジャーの勃起シーンは両手で恥ずかしそうに抑えているのがいいです。\n差分が大変そうなので、金額が足りない場合は条件付き再送を、お手数をおかけしますがお願い致します。\n\nご検討宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/38", "thumbnail_src": "https://si.imgix.net/4b6c613a/uploads/origins/38d7f520-c5f9-4fa9-94d5-7561d44da988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cf5f40f3dc32579a6e2f9b54accd161", "thumbnail_srcset": "https://si.imgix.net/4b6c613a/uploads/origins/38d7f520-c5f9-4fa9-94d5-7561d44da988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cf5f40f3dc32579a6e2f9b54accd161, https://si.imgix.net/4b6c613a/uploads/origins/38d7f520-c5f9-4fa9-94d5-7561d44da988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eec8d57235894a3559d5745a6ff2c2f9 2x, https://si.imgix.net/4b6c613a/uploads/origins/38d7f520-c5f9-4fa9-94d5-7561d44da988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4c8d6e77c8855d245a036d6465654ac 3x", "genre": "art", "nsfw": true, "body": "すいません、こちらも回覧変更忘れていました。はるばとさんこんにちは。ずっと依頼したいと思いこの時を待っておりました。一件よろしくお願いします。以前投稿されたピーチ姫が某キャラクターに2穴を開かされたイラストがあったと思うのですがその続編を描いて頂けないでしょうか？内容は太い指2本で2穴を入れたり戻したりしてピーチ姫が感じてしまっているイラストです。この内容で厳しい場合変更して再度お送り致します。ご検討頂ければと思います。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/37", "thumbnail_src": "https://si.imgix.net/2e7430c6/uploads/origins/686c3e1a-58b5-4ade-8cfa-09dc6a060860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30e8d76b0b3caa6c16e77dce720b25bf", "thumbnail_srcset": "https://si.imgix.net/2e7430c6/uploads/origins/686c3e1a-58b5-4ade-8cfa-09dc6a060860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30e8d76b0b3caa6c16e77dce720b25bf, https://si.imgix.net/2e7430c6/uploads/origins/686c3e1a-58b5-4ade-8cfa-09dc6a060860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af0eb49f6a358cfbb447f408ab3addfc 2x, https://si.imgix.net/2e7430c6/uploads/origins/686c3e1a-58b5-4ade-8cfa-09dc6a060860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=913dbe2505f29ab5c167c494a2c96e2f 3x", "genre": "art", "nsfw": true, "body": "前回はリクエストに応えてくださりありがとうございました！今回も再びリクエストさせて頂きます！\n\n■キャラ\nフウロ（ポケモン）&トウコ（ポケモン）\n■シチュ\nいいフウロの日にも掲載したハートスタンプフウロ＆ヒートスタンプトウコの続きで、\nシキミの妄想でフウロがココロモリと、トウコがチャオブーとSEXする場面をお願いします。\nhttps://twitter.com/halubato1/status/1331973538249469953/photo/2\nhttps://pbs.twimg.com/media/Enwe3DAVQAIrz5y?format=jpg&name=large\n■希望\nフウロとトウコのマンコの中に射精する差分もお願いします。\nフウロとトウコの目にハートが入っており、表情はメロメロになった感じでお願いします。\n因みにシキミの妄想がフウロとトウコにバレて、シキミは2人から怒られるが、実際にはその妄想は事実で、トウヤやシキミ達には隠していこうとするオチでお願いします。\nあと、可能であれば程度で構わないのですが\n①服の有り無し差分\n②台詞の有り無し差分\nを希望したいです。\n■注釈\nココロモリとチャオブーは目や口等の顔は見えない感じでお願いします。（特にココロモリとチャオブーの目だけでも絶対に描かずにお願いします。）\n体位はお任せしますが、話の流れや服の有り無し差分的に立ちバックが良いと思うので構図は以下を参考にお願いします。\nhttps://www.pixiv.net/artworks/96329563\nhttps://www.pixiv.net/artworks/99253635\nhttps://www.pixiv.net/artworks/100425064\nhttps://www.pixiv.net/artworks/103492031\n\nどうかご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/36", "thumbnail_src": "https://si.imgix.net/1dd0e9b1/uploads/origins/c1fdc880-1089-47eb-a804-67001fc927b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea63dc3e66fcdf31f6ddb6994d0ae173", "thumbnail_srcset": "https://si.imgix.net/1dd0e9b1/uploads/origins/c1fdc880-1089-47eb-a804-67001fc927b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea63dc3e66fcdf31f6ddb6994d0ae173, https://si.imgix.net/1dd0e9b1/uploads/origins/c1fdc880-1089-47eb-a804-67001fc927b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf2250e2c6692439caf0046cb08e6d43 2x, https://si.imgix.net/1dd0e9b1/uploads/origins/c1fdc880-1089-47eb-a804-67001fc927b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f45903bbe72aec71fdf2fec247e848c3 3x", "genre": "art", "nsfw": true, "body": "ゼノブレイド２のホムラお願いします。\n\n露出性癖持ちのホムラが際どい水着姿でビーチを練り歩くシチュ。\n・スリングショットorマイクロビキニ。\n・可能ならば全裸差分希望。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/35", "thumbnail_src": "https://si.imgix.net/432237c5/uploads/origins/cf25e4bc-3ae5-4111-aae2-a1276096db39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23a59f84c0dbbb16df01e48e9fdb9358", "thumbnail_srcset": "https://si.imgix.net/432237c5/uploads/origins/cf25e4bc-3ae5-4111-aae2-a1276096db39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23a59f84c0dbbb16df01e48e9fdb9358, https://si.imgix.net/432237c5/uploads/origins/cf25e4bc-3ae5-4111-aae2-a1276096db39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d19c5f1558fb0a43da5c726a54fd29d 2x, https://si.imgix.net/432237c5/uploads/origins/cf25e4bc-3ae5-4111-aae2-a1276096db39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b0e62cf80e713eb5542c5e26275e074 3x", "genre": "art", "nsfw": true, "body": "受付再開お待ちしておりました。\nポケモンのウチキド博士を依頼いたします。\nシチュエーションはお尻を後ろから、アナルとアソコ（子宮口まで見えるよう）両方を大きく拡げて見せつけているポースを。\n参考　https://www.pixiv.net/artworks/105019225\n服装は全裸、表情は少し恥じらい、口は開いて。\n背景は風呂場のイメージ（簡易でいいです）、差分で背景に局部アップをお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/34", "thumbnail_src": "https://si.imgix.net/727b172f/uploads/origins/a7417f30-e53d-4dc8-b2e8-a1214521b64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daa5efb07156e8462999e71b8673c137", "thumbnail_srcset": "https://si.imgix.net/727b172f/uploads/origins/a7417f30-e53d-4dc8-b2e8-a1214521b64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=daa5efb07156e8462999e71b8673c137, https://si.imgix.net/727b172f/uploads/origins/a7417f30-e53d-4dc8-b2e8-a1214521b64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=540f4e471f48617e1a6dae4b89538ffb 2x, https://si.imgix.net/727b172f/uploads/origins/a7417f30-e53d-4dc8-b2e8-a1214521b64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e0fdc30a21fa5202a80b04d77e75360 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/33", "thumbnail_src": "https://si.imgix.net/5171d698/uploads/origins/e4aadff4-5b80-4c9c-b720-f7d1294dbb95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b6a92b7f1fc193ca7b8440c393cd61", "thumbnail_srcset": "https://si.imgix.net/5171d698/uploads/origins/e4aadff4-5b80-4c9c-b720-f7d1294dbb95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b6a92b7f1fc193ca7b8440c393cd61, https://si.imgix.net/5171d698/uploads/origins/e4aadff4-5b80-4c9c-b720-f7d1294dbb95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c60b91877ee12a02cabc76b49b9679c0 2x, https://si.imgix.net/5171d698/uploads/origins/e4aadff4-5b80-4c9c-b720-f7d1294dbb95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fb280f297aecacf9bacf28079acdd57 3x", "genre": "art", "nsfw": true, "body": "はじめまして！\nいつも素敵な作品をありがとうございます\n作者様の手掛ける作品に、勝手ながら日々大変お世話になっております\n\n素人からのリクエストにて恐縮なのですが、下記内容にて是非ご検討の程をいただければと思います\nご存知ではない作品であったり、似たようなキャラクターを何度か手掛けておられるかと思われますので、お手数になるようでしたら気兼ねなのないキャンセルをお願いいたします\n\n以下内容です\n\n漫画「ポケットモンスターSPECIAL」より主人公の一人「クリスタル」のイラストをお願いできませんでしょうか？\nゲーム版と異なり黒味の強い髪色をしており、星形のイヤリングをしているのが特徴の娘(資料URL)で、心優しく「捕える者」と評される捕獲の達人です\n下記ピクシブ百科事典\nhttps://dic.pixiv.net/a/%E3%82%AF%E3%83%AA%E3%82%B9%E3%82%BF%E3%83%AB%28%E3%83%9D%E3%82%B1%E3%82%B9%E3%83%9A%29\n漫画内の画風には拘らず、作者なりに描き下ろしていただければと思っております\n難しくなければ気持ち大人目の等身にしてくださると助かるかもしれません\n\n劇中にもあった展開なのですが、メタモン(という設定)のスライム状の物質に足元を捕らわれ、自身の捕獲チームを取り上げられた彼女が悪者相手に好き放題されてしまうシチュエーションをお願いいたします\n\nhttps://www.pixiv.net/artworks/95816009\n上記イラストが理想に近く、強制的に股を開かされたうえで、胸を触られたり、スパッツ越しに股間を擦られたり、最終的には挿入を許し膣内射精とともに仰け反り絶頂させられてしまう等の要素を何点かだけでも構いませんので、料金内とご判断いただける範囲で描いてくださると嬉しいです\n\n悪者が楽しそうに彼女をもてあそんでいる様子が伝わる容赦のない言葉責めや、自身のてもちを守るため歯を食いしばるも最終的には「やだやだ」と情けなく悲鳴をあげてしまう彼女のセリフなどもいただけたらとても嬉しいです\n\nイラスト作成に無知な人間からの読みづらい文章で申し訳ございません\n上手にお伝えできたかとても不安なのですが、ご検討の程だけでも何卒よろしくお願いいたします\n\nhttp://imepic.jp/LTL6BecD", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/32", "thumbnail_src": "https://si.imgix.net/6352302c/uploads/origins/c04ed8a4-b875-49b5-ac41-38399c41fee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c924e49fab34933471552244c42d7764", "thumbnail_srcset": "https://si.imgix.net/6352302c/uploads/origins/c04ed8a4-b875-49b5-ac41-38399c41fee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c924e49fab34933471552244c42d7764, https://si.imgix.net/6352302c/uploads/origins/c04ed8a4-b875-49b5-ac41-38399c41fee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5ba7cdd50858f11f8a779643b411412 2x, https://si.imgix.net/6352302c/uploads/origins/c04ed8a4-b875-49b5-ac41-38399c41fee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e9c97d1b676c7e94b8634fbd8dda207 3x", "genre": "art", "nsfw": true, "body": "先日は最高のレンジャーをありがとうございました！とてもお世話になっています。\nまたポケモンキャラでお願いがあって依頼しました。\n早速ですが、ポケモン+ノブナガの野望からイナヒメをお願いします。\nシチュエーション:敵(コタロウかヨシモトまたはそれ以外のモブ敵を想定しています。)の作戦にはまり、ベストリンクポケモンもろともピンチに陥る。\nパートナーを守るために敵ショーグンに体を差し出し、徹底的に初めてを味わわされてしまう。\nという感じでお願いします。\nあまり見ないキャラで細かい依頼で申し訳ないです。\nもし気に入っていただければよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/31", "thumbnail_src": "https://si.imgix.net/cb40e963/uploads/origins/e7b60bdc-1c70-4545-a748-355f49a4fa47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20d616acfee70ea4d43d0b467d8c3929", "thumbnail_srcset": "https://si.imgix.net/cb40e963/uploads/origins/e7b60bdc-1c70-4545-a748-355f49a4fa47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20d616acfee70ea4d43d0b467d8c3929, https://si.imgix.net/cb40e963/uploads/origins/e7b60bdc-1c70-4545-a748-355f49a4fa47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=614bbc90a9ddda6e624fc194daae6ad6 2x, https://si.imgix.net/cb40e963/uploads/origins/e7b60bdc-1c70-4545-a748-355f49a4fa47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02d68ddcedee4f5747e028abc195609e 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させていただきます！\nいつも可愛くてエロいキャラをありがとうございます！\n特にポケモンの女キャラが最高です。\nということで二番煎じにならないようなキャラで…\nポケモンレンジャーのヒナタ\nポケモンレンジャーバトナージのヒトミ\nポケモンレンジャー光の軌跡のミナミ\n女主人公三人が、キャプチャに失敗して敵の悪役(できれば人間で)に犯されるところをお願いいたします。\n強がっていた三人が散々にされているところを\nもし気に入っていただけたらお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/30", "thumbnail_src": "https://si.imgix.net/ec440aab/uploads/origins/d899e538-cb51-45e6-9f5a-470a7c857f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f81c146816b54fffe856948387e26db9", "thumbnail_srcset": "https://si.imgix.net/ec440aab/uploads/origins/d899e538-cb51-45e6-9f5a-470a7c857f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f81c146816b54fffe856948387e26db9, https://si.imgix.net/ec440aab/uploads/origins/d899e538-cb51-45e6-9f5a-470a7c857f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3977bfd7631c09a01ea82677af7e3cae 2x, https://si.imgix.net/ec440aab/uploads/origins/d899e538-cb51-45e6-9f5a-470a7c857f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41293053657fd0edbbf1bd216b638290 3x", "genre": "art", "nsfw": true, "body": "是非描いていただきたいシチュエーションがあり、再募集を心待ちにしておりました！\n\n【キャラクター】\nBDSP発売ということで、スズナ＆ナタネを描いていただきたいです！\n\n【シチュエーション・服装など】\n過去にはるばとさんの描いていたローアングル自撮りくぱぁシチュ（https://skeb.jp/@halubato1/works/1）がすごく好きなので、今回そのイメージで描いていただきたいです。\n二人からそれぞれエッチのお誘い写真が同時に送られてきて、どちらとエッチするのか困ってしまうようなシチュエーション。\n\n■ナタネ\n・下半身には何も着ていない状態\n・膝立ちになって、片手で服をめくりあげておっぱいを露出、片手の指で左右におまんこをくぱぁ\n\n■スズナ\n・寝転んだ状態でYシャツをはだけさせておっぱいを露出、太ももの裏から両手を回して左右におまんこをくぱぁ\n\n工数に見合わない、他NGなどありましたら遠慮なくキャンセルしていただいて大丈夫です。\nご検討よろしくお願いいたします！\n\nhttps://skeb.jp/@halubato1/works/1", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/29", "thumbnail_src": "https://si.imgix.net/b52ad5de/uploads/origins/404d137b-e9ab-40ef-b1c4-a00da5c91a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=725c2797568be2322ebce51f9cdea267", "thumbnail_srcset": "https://si.imgix.net/b52ad5de/uploads/origins/404d137b-e9ab-40ef-b1c4-a00da5c91a94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=725c2797568be2322ebce51f9cdea267, https://si.imgix.net/b52ad5de/uploads/origins/404d137b-e9ab-40ef-b1c4-a00da5c91a94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84169b3161c060c89e603cf514b5abba 2x, https://si.imgix.net/b52ad5de/uploads/origins/404d137b-e9ab-40ef-b1c4-a00da5c91a94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a34ca8db33b5ad345ccc38050c08525 3x", "genre": "art", "nsfw": true, "body": "以前のトウコ＆クリス(https://www.pixiv.net/artworks/84235732)と同じ様な感じでポケモンのカリンとイブキの即堕ち2コマ(3コマ)をお願いします。\n概ね同じ流れで、しっかり着衣で余裕な感じ挑発→全裸に剥かれておしおきセックス→そのまま中出し絶頂といった感じで。２、3コマ目メインな感じでお願いしたいです。\n・2人とも引き締まった身体に乳や尻は巨乳でムチムチな感じ\n・性格の対比として、イブキの方が生意気気味に挑発→2コマ目以降は情けない感じで\n・可能でしたら別窓等でも構わないので、絶頂時の無様なイキ顔の描写をお願いしたいです\n\n細かい部分ははるばと様の描きやすい様に描いていただければと思います。\nご勘案いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/28", "thumbnail_src": "https://si.imgix.net/4e8a5ad8/uploads/origins/064c4ead-2460-4a1f-b52d-f130f51bcb71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eff705ad2f0e77ad74e56667d780cd75", "thumbnail_srcset": "https://si.imgix.net/4e8a5ad8/uploads/origins/064c4ead-2460-4a1f-b52d-f130f51bcb71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eff705ad2f0e77ad74e56667d780cd75, https://si.imgix.net/4e8a5ad8/uploads/origins/064c4ead-2460-4a1f-b52d-f130f51bcb71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0cc83b487822f4e2567ea5900094f1f 2x, https://si.imgix.net/4e8a5ad8/uploads/origins/064c4ead-2460-4a1f-b52d-f130f51bcb71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2a5135c8af6df7448bee018d48cd68a 3x", "genre": "art", "nsfw": true, "body": "ゼノブレイド2のホムラとヒカリお願いします。\nデリヘルモノの続きです。\n\nシチュ概要\n本編後レックスは二人と3Pで初セックスをする事に。二人はついデリヘルやってる時のノリで淫らな格好でレックスを誘惑してしまう。戸惑いつつもドスケベな二人に興奮し喜ぶレックス。\n\n・全裸で資料のように左右対称のI字バランス。\n・テープでくぱぁ。\n・乳首ピアス。\n・乳首とクリが大きくなっている。\n・くぱぁ無しの差分。\n\nこの金額で可能ならよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/89305728", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/27", "thumbnail_src": "https://si.imgix.net/2c7503df/uploads/origins/f4f9a184-0177-4944-8e0d-8ff8943091ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac91533edc3bd90aab15911fd59fc84b", "thumbnail_srcset": "https://si.imgix.net/2c7503df/uploads/origins/f4f9a184-0177-4944-8e0d-8ff8943091ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac91533edc3bd90aab15911fd59fc84b, https://si.imgix.net/2c7503df/uploads/origins/f4f9a184-0177-4944-8e0d-8ff8943091ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48b01d9171481767b88794b91258f8af 2x, https://si.imgix.net/2c7503df/uploads/origins/f4f9a184-0177-4944-8e0d-8ff8943091ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=752ab4802685feae06513643cfd626c9 3x", "genre": "art", "nsfw": true, "body": "勝負に敗けた後、武装解除させられ全裸にされたポケモン金銀（GBC）のロケット団のしたっぱ♀をお願いします。\n\n・流れのイメージ的には以前描かれていたhttps://www.pixiv.net/artworks/84778898の様な感じ\n・とても悔しそうな恥ずかしそうな表情だが、持ち物の不所持を示すため身体を隠さない様に指示される\n・銃を向けられた時のホールドアップの様なポーズ（手を上げるポーズ、手を開き、肘を少し曲げた状態で脇が見えるぐらい腕を上に上げる。脚はややガニ股気味で股間を見せるつける感じ）\n・本人は全裸で脱いだ服や下着、ボールや身分証など所持物が周りに落ちている\n・悪事を認めさせられ、謝罪の言葉を述べさせれており、その様子を相手に撮影されている\n・スケベな身体や愛液の湧出、クリトリスの勃起を指摘され恥ずかしがる\n・長身巨乳のドスケベボディなイメージ\n\n文字や背景など別レイヤーで分けて頂けますとありがたいです。\n\nややマイナーなキャラですが、原作ドット絵の他、旧裏ポケモンカードの「ロケット団のおねーさん」や「ロケット団のワナ」等を参考にして頂ければと思います。\nご一考頂けますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/26", "thumbnail_src": "https://si.imgix.net/31fb4abd/uploads/origins/2e8af09e-34cb-4fc0-87ea-effea635d42a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3aa5d3ba272613f083af44d49b97d3be", "thumbnail_srcset": "https://si.imgix.net/31fb4abd/uploads/origins/2e8af09e-34cb-4fc0-87ea-effea635d42a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3aa5d3ba272613f083af44d49b97d3be, https://si.imgix.net/31fb4abd/uploads/origins/2e8af09e-34cb-4fc0-87ea-effea635d42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=706bbe8122d08629b5e771ba78eaf94e 2x, https://si.imgix.net/31fb4abd/uploads/origins/2e8af09e-34cb-4fc0-87ea-effea635d42a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad096108f9bb3ddeeedb5053268c8fa4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/25", "thumbnail_src": "https://si.imgix.net/55cb91bd/uploads/origins/cb8907af-bcd9-417f-beb7-3cc150d21680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4223f964707b8805c120a6b753452091", "thumbnail_srcset": "https://si.imgix.net/55cb91bd/uploads/origins/cb8907af-bcd9-417f-beb7-3cc150d21680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4223f964707b8805c120a6b753452091, https://si.imgix.net/55cb91bd/uploads/origins/cb8907af-bcd9-417f-beb7-3cc150d21680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3810cf1bb3ad013be5163ce6b6ae4e2b 2x, https://si.imgix.net/55cb91bd/uploads/origins/cb8907af-bcd9-417f-beb7-3cc150d21680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2669fe0951b56605be4520494464d6b1 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。今回はお引き受けいただけるか分かりませんが、スレイヤーズの「ナーガ」を依頼いたします。\n\n構図は下記を参照ください。\nhttps://www.pixiv.net/artworks/91539669\n\n明るい部屋のベッドの上で、服装は額＆首の飾り、ブーツ以外は裸で。\nアソコはテープで大きくクパァ、右手を口元に添えて、両目を開けての高笑い顔で。\n今回も画面右上に局部アップをお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/24", "thumbnail_src": "https://si.imgix.net/f821794d/uploads/origins/abd55aed-9d8e-42d9-a256-18976ce9ca9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1268ab84c4f5ea6cd73047a157e4370e", "thumbnail_srcset": "https://si.imgix.net/f821794d/uploads/origins/abd55aed-9d8e-42d9-a256-18976ce9ca9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1268ab84c4f5ea6cd73047a157e4370e, https://si.imgix.net/f821794d/uploads/origins/abd55aed-9d8e-42d9-a256-18976ce9ca9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=284f13691d4f4fb458fc7de6bc8c9c5f 2x, https://si.imgix.net/f821794d/uploads/origins/abd55aed-9d8e-42d9-a256-18976ce9ca9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d905eb4ba22242e16297e1d408520729 3x", "genre": "art", "nsfw": true, "body": "初めまして！\nリクエストをさせてください。\n以前に投稿されていたゼロスーツサムスがモブ男に責められても全く動じない作品(https://www.pixiv.net/artworks/74923472)\nでねちっこく責められ続け、ついに屈服して無様お漏らししながら仰け反り絶頂してしまいモブ男達に煽るように言葉責めされているシチュエーションをお願いします。\n\n\n\n可能ならば仰け反る前に感じ始めて赤面しながら\n「この…っ！いい加減にっ！」\nとモブ男達を睨みつけているシーンもお願いします。\nモブ男達は感じ始めたサムスを見て調子に乗り、バカにして煽りながらそれまでの鬱憤を晴らすような感じの台詞", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/23", "thumbnail_src": "https://si.imgix.net/44c2d575/uploads/origins/215ee062-7711-4172-9da5-0ae737c14f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89163004bda351c5ed8144b4e21b34cd", "thumbnail_srcset": "https://si.imgix.net/44c2d575/uploads/origins/215ee062-7711-4172-9da5-0ae737c14f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89163004bda351c5ed8144b4e21b34cd, https://si.imgix.net/44c2d575/uploads/origins/215ee062-7711-4172-9da5-0ae737c14f39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ea9cbc69b47a600c0273a239b17aba5 2x, https://si.imgix.net/44c2d575/uploads/origins/215ee062-7711-4172-9da5-0ae737c14f39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=617d591aef5959f8cedf433cafcfbdcf 3x", "genre": "art", "nsfw": true, "body": "ゼノブレイド2のヒカリお願いします。\nホムラ温泉姦の続き。ホムラと感覚共有していたヒカリが多人数プレイにハマり本当にデリヘル始めてしまう。\n・全裸でくぱぁして客を誘惑する。\n・客は複数。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/22", "thumbnail_src": "https://si.imgix.net/8f74aa94/uploads/origins/d4966847-920e-45ea-b9da-0515192a96c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffd96d890be29de84565d4592424c5cf", "thumbnail_srcset": "https://si.imgix.net/8f74aa94/uploads/origins/d4966847-920e-45ea-b9da-0515192a96c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffd96d890be29de84565d4592424c5cf, https://si.imgix.net/8f74aa94/uploads/origins/d4966847-920e-45ea-b9da-0515192a96c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ec7d1002b29e85d98083180bce42aa7 2x, https://si.imgix.net/8f74aa94/uploads/origins/d4966847-920e-45ea-b9da-0515192a96c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccc9b9d516189e470ffd5e975070b6fb 3x", "genre": "art", "nsfw": true, "body": "Hi, I really like your art of Fuuro in sling bikini! https://www.pixiv.net/en/artworks/80014524\n\n同じスリングビキニを着て、ビーチでセックスしている複数のシーンがある絵を描いてほしい。\n\n最初のシーンでは、男性（肌の色が薄い）が後ろから彼女を触っていて、彼のコックが彼女の太ももの間に入っています。そして、フウロは両腕を上げて彼の首に回し、このように脇の下を見せています。\nhttp://imgur.com/a/yC4wCM8\n\n2つ目のシーンは、彼女がフェラチオをしているところが小さく写っています。\nhttp://imgur.com/a/0J2g2fr\n\nそして3つ目のシーンでは、ドギースタイルでファックされています。\nhttp://imgur.com/a/9nPVfhg\n\nそして、最後のシーンは、この写真のように、スリングビキニを脱いで乳首を出し、手をつないでクリープ/ナカダシされながら、この体勢でセックスしています。\nhttp://imgur.com/a/5q5Z0Ec", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/21", "thumbnail_src": "https://si.imgix.net/a4b2e5de/uploads/origins/983ea4fe-44a9-4c8c-8de0-31a55400a351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5af92616347eabed6c45ebf23a34f62b", "thumbnail_srcset": "https://si.imgix.net/a4b2e5de/uploads/origins/983ea4fe-44a9-4c8c-8de0-31a55400a351?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5af92616347eabed6c45ebf23a34f62b, https://si.imgix.net/a4b2e5de/uploads/origins/983ea4fe-44a9-4c8c-8de0-31a55400a351?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c0eb0dc3b17da9ea2ebaa52752810ed 2x, https://si.imgix.net/a4b2e5de/uploads/origins/983ea4fe-44a9-4c8c-8de0-31a55400a351?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe61bdfae156bd6337bbfbc36285fce8 3x", "genre": "art", "nsfw": true, "body": "はるばとさんのポケモントレーナーくぱぁ絵どれも大好きなので依頼させていただきます！\n\n【キャラクター】\nポケモンルビー・サファイアのハルカ、ダイヤモンド・パールのヒカリ\n\n【シチュエーション・構図】\n全裸でベッドに二人並んで座った状態でどっちが先にセックスしてもらえるかアピールしている状況。\n\n・ハルカ\n自信アリといった様子で片手でおまんこをくぱぁ、もう片手は陥没乳首をくぱぁして乳首を見せつけ\n\n・ヒカリ\n恥じらいながらもハルカに負けたくない様子で一生懸命両手で左右におまんこくぱぁ\n\n二人とも愛液トロトロで準備万端といった感じで、\n他作品と同様に局部アップ（アナルも見えると嬉しいです）のカットがあると助かります。\n\nご検討よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@halubato1/works/20", "thumbnail_src": "https://si.imgix.net/d29eb3f6/uploads/origins/a0886500-8213-4e4b-ac18-75608c34d18f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5913b88a56db2c4464ff0e303545e68", "thumbnail_srcset": "https://si.imgix.net/d29eb3f6/uploads/origins/a0886500-8213-4e4b-ac18-75608c34d18f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5913b88a56db2c4464ff0e303545e68, https://si.imgix.net/d29eb3f6/uploads/origins/a0886500-8213-4e4b-ac18-75608c34d18f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a45d799deb9350b069b095461de9c8e 2x, https://si.imgix.net/d29eb3f6/uploads/origins/a0886500-8213-4e4b-ac18-75608c34d18f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee6c81715f7af5bd502dbd05958ffb7a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。私のプリンセスがあなたのスタイルで、シャツが開いていても、携帯電話を持って自分の写真を撮っているような、セクシーで美しい姿を見てみたいですね。\nhttps://drive.google.com/file/d/1Uj9M2YUNdg5G9v2WIhJzWw5-yrxgn-m2/view?usp=drivesdk\nhttps://drive.google.com/file/d/1P1X3splXU0DvJ2gFnJUf47aZjlvI61w_/view?usp=drivesdk\nht