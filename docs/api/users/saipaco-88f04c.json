6f1308f9d54f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32b6110f97b2a5348d983f7d1675cef5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@saipaco/works/23", "thumbnail_src": "https://si.imgix.net/f308431e/uploads/origins/bb05eb7b-ad00-43aa-baf7-ff12dda6ff44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2be28a7bbe229a66f2f9525449ee4e86", "thumbnail_srcset": "https://si.imgix.net/f308431e/uploads/origins/bb05eb7b-ad00-43aa-baf7-ff12dda6ff44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2be28a7bbe229a66f2f9525449ee4e86, https://si.imgix.net/f308431e/uploads/origins/bb05eb7b-ad00-43aa-baf7-ff12dda6ff44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a7b25dc9169c9073de4174a119e687b 2x, https://si.imgix.net/f308431e/uploads/origins/bb05eb7b-ad00-43aa-baf7-ff12dda6ff44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e29441be1b35758ef3c4cb90362be959 3x", "genre": "art", "nsfw": false, "body": "はじめまして!　投稿されたイラストを拝見し　今回リク再開と聞き是非ともと思いリクいたします\n\n内容　オリキャラ(ベースキャラあり)の立ち絵(キャラクリに使用したい為透過の都合にて背景はなし)\n\nキャラ　エルフの竜騎士(♀)  ベースになっているキャラは艦これのコロラド(下記にアドレス)\nhttps://wikiwiki.jp/kancolle/Colorado\n「私が一族の悲願、竜騎士として大輪の華をさかせようじゃないの!」\nという言葉通りかつて一族の中から世界でも一握りしかいない竜騎士になり、竜の背に乗って戦で活躍\nエルフの国でも他国でさえも名を轟かせたエルフを尊敬しており　その名はいまだ知られているものの\nほぼ伝承、おとぎ話の範疇になっておりこれに危機感を抱いた為一念発起し竜騎士として冒険者になった\n\nなおほぼ見かけないことと恰好だけ真似る者もいるため信じられていない中で「おお、すげー！(あとおっぱいでけー)」とあっさり信じた冒険者とPTを組むという感じです\n\n身体特徴　ベースキャラと同じ割と小柄(髪型や顔の造形、瞳の色は都合で変更可)おっぱい大きい　\n\n装備　資料URLにあるものがベース、違いは頭部についてはコロラドのカチューシャ(耳上あたりの)\nの部分を竜の角に変換したようなものに　胴装備については所謂レオタード(体のラインがわかるタイプで\n上乳横乳が拝める贅沢仕様)　描きづらい装備については簡略、省略可\n\n立ち絵について\n後ろ手で槍を構え(横乳が見える)「さあいくわよ!」というイメージのポーズです\n\nいきなりのオリキャラ作成依頼ですが　お時間等問題なければよろしくお願いいたします\n\nhttp://noraneco.tea-nifty.com/comimi/2014/06/post-02f2.html", "created_at": "", "completed_at": ""}, {"path": "/@saipaco/works/22", "thumbnail_src": "https://si.imgix.net/2be0cd44/uploads/origins/bc66c425-9170-4562-a189-f7d55a740596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df109e39c2807eb47183b1899ea0a6bb", "thumbnail_srcset": "https://si.imgix.net/2be0cd44/uploads/origins/bc66c425-9170-4562-a189-f7d55a740596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df109e39c2807eb47183b1899ea0a6bb, https://si.imgix.net/2be0cd44/uploads/origins/bc66c425-9170-4562-a189-f7d55a740596?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98ae52af77f7dafea9477b2dad4f9bc4 2x, https://si.imgix.net/2be0cd44/uploads/origins/bc66c425-9170-4562-a189-f7d55a740596?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6ee709bca29261e2af74dea6a661930 3x", "genre": "art", "nsfw": false, "body": "また、こんにちは。前回と似たようなことをリクエスト（https://skeb.jp/@saipaco/works/14）したいのですが、大丈夫でしょうか？前回の結果があまりにもすごかったので、単純にそうせざるを得なかったのです！\n\n今回、すごく縮んでしまったのが美遊ちゃんで、身長はわずか1cm（またはそれ以下）になってしまった。第三再臨水着イリヤ(アーチャー)の近くにいる。イリヤちゃんはとっても非常に大きく見える。。。水滴さえも巨大に見える！イリヤちゃんは楽しそうにしていて、美遊ちゃんの存在にはまったく気づいていない。美遊ちゃん自身が水着を着ている（どんなデザインでもOK）。\n\n前回似たよう、美遊ちゃんの小ささに比べて、イリヤちゃんがやたらと大きいという、スケールの違いを感じさせる構図にしたいですね。ローアングルは本当に描きにくいと実感していますが、もう一度あったらすごいですね。。。！だが、コンセプトの解釈やイラストの描き方は自由です。考慮のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@saipaco/works/21", "thumbnail_src": "https://si.imgix.net/4df90b1c/uploads/origins/9112b322-d396-4e68-9779-cde089c09501?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a95c154c5f45ae9625d4eb815b8d1bdb", "thumbnail_srcset": "https://si.imgix.net/4df90b1c/uploads/origins/9112b322-d396-4e68-9779-cde089c09501?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a95c154c5f45ae9625d4eb815b8d1bdb, https://si.imgix.net/4df90b1c/uploads/origins/9112b322-d396-4e68-9779-cde089c09501?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8f42f59ea2ab588c8dae9560e7d4ed3 2x, https://si.imgix.net/4df90b1c/uploads/origins/9112b322-d396-4e68-9779-cde089c09501?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0095b900c6b550b533d61e394dab193c 3x", "genre": "art", "nsfw": false, "body": "SAIPACo. 様\n\nいつも素敵なイラスト、本当にありがとうございます♪(*´∀｀*)\n\n可能かどうか分かりませんが、リクエストを出させて頂きます♪\n\nシンプルに…\n\nキャラクターは、FGOの\nラムダリリス　の最終再臨（一番肌面積多い）です☆\n細身、繊細な女の子良き♪\n\n構図ですが、正面です。\n座りで、あぐらをかいています。\n視点は斜め上から彼女を見下ろしている感じ。\n彼女は切長の瞳でこちらを不敵な笑みで、少し上目遣いで見据えてる感じ。舌ペロは雰囲気でどちらでも！\n腕ですが脚フェチなので、ほぼ隠れない様に描いて下さると嬉しい…です。\n片手は頭の上、逆の手は後ろに伸ばして床に付いて、少し後ろに沿ったバランス取ってる感じ\n。\n何処と無く、お姉さんの様な妖艶な雰囲気があるとこれもまた凄く嬉しい…(*´ω`*)\n\n頭身は気持ち高めでお願い致します。\n\n背景は雰囲気でお任せで♪\n\n以上となります！！\nアイディアが紆余曲折した結果、この様になりましたが、何卒宜しくお願い致します♪\n\nヴィスコル", "created_at": "", "completed_at": ""}, {"path": "/@saipaco/works/20", "thumbnail_src": "https://si.imgix.net/4b0b6d56/uploads/origins/9ab906af-29c9-4c27-acbd-31c56937731d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b6ec4d53f86c9b4912a784a3ec3aae0", "thumbnail_srcset": "https://si.imgix.net/4b0b6d56/uploads/origins/9ab906af-29c9-4c27-acbd-31c56937731d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b6ec4d53f86c9b4912a784a3ec3aae0, https://si.imgix.net/4b0b6d56/uploads/origins/9ab906af-29c9-4c27-acbd-31c56937731d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=837311391e0e1b114b942b12cc91d4bf 2x, https://si.imgix.net/4b0b6d56/uploads/origins/9ab906af-29c9-4c27-acbd-31c56937731d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=841b4291e4324e9469576ce0b55d985d 3x", "genre": "art", "nsfw": false, "body": "Hello! I loved the previous illustration you made for me, so I'd like to request another one.\nIt is a character from my Dungeons & Dragons game, she is a dark elf archer.\nYou can see the references for her in the Dropbox folder below. Feel free to tweak and adapat things as you see fit. I'll 