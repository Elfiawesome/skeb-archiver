お任せ致します。\n\nまた髪型に関してですが、ツインテールを腰を越える位の長さで原作のボリュームに近づけて頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@shizu_summer/works/22", "thumbnail_src": "https://si.imgix.net/2437e996/uploads/origins/cbc7b25f-01af-4262-b74b-222ee15c3fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abdc173e9b2558d10dbdf3f3bbf3a04d", "thumbnail_srcset": "https://si.imgix.net/2437e996/uploads/origins/cbc7b25f-01af-4262-b74b-222ee15c3fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abdc173e9b2558d10dbdf3f3bbf3a04d, https://si.imgix.net/2437e996/uploads/origins/cbc7b25f-01af-4262-b74b-222ee15c3fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39e1d1dee2427fc508f0cd2ccfeb78eb 2x, https://si.imgix.net/2437e996/uploads/origins/cbc7b25f-01af-4262-b74b-222ee15c3fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86a0ffe1b8cb95d26b463ed60aa02a1f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@shizu_summer/works/21", "thumbnail_src": "https://si.imgix.net/acd898d1/uploads/origins/6da6e4e0-801d-41c0-94bb-48bd9ae8a566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1c08bcc754ec5cc03929d24c4c53829", "thumbnail_srcset": "https://si.imgix.net/acd898d1/uploads/origins/6da6e4e0-801d-41c0-94bb-48bd9ae8a566?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2