}, {"path": "/@naooo_03/works/1", "thumbnail_src": "https://si.imgix.net/64e5f765/uploads/origins/bfda46fd-a7b7-4777-a564-72edaecbf06f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae8e7ffaa399f12eb01b4b0c4ffdc8d7", "thumbnail_srcset": "https://si.imgix.net/64e5f765/uploads/origins/bfda46fd-a7b7-4777-a564-72edaecbf06f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae8e7ffaa399f12eb01b4b0c4ffdc8d7, https://si.imgix.net/64e5f765/uploads/origins/bfda46fd-a7b7-4777-a564-72edaecbf06f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdbfe83080ddeb41dc99f974d0b7f2d0 2x, https://si.imgix.net/64e5f765/uploads/origins/bfda46fd-a7b7-4777-a564-72edaecbf06f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=183492d20c8bd664a8cb0fa64ecfaf17 3x", "genre": "art", "nsfw": false, "body": "Nice to meet you! If you don't mind, I would like to ask you to illustrate two of my TRPGs...!\n\nhttps://drive.google.com/drive/folders/1-DGE6fm0e19Ags8QLQGXlrfrTO8wLKWI\n\nThe situation, composition, etc. are completely up to you!\nIf possible, I would like to use them for printing or other purposes within the scope of personal use, so I would appreciate it if you could give me the data without signatures.\n\nIf there are any deficiencies in the data or insufficient amounts, we would be happy to consider your request.\nThank you very much for your time...!", "created_at": "", "completed_at": ""}]}