b60-a2e1d1498e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a562cbef878b2ba9da0452ea9a59aeb7", "thumbnail_srcset": "https://si.imgix.net/781ac612/uploads/origins/17dd0d2b-d3af-4f0a-bb60-a2e1d1498e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a562cbef878b2ba9da0452ea9a59aeb7, https://si.imgix.net/781ac612/uploads/origins/17dd0d2b-d3af-4f0a-bb60-a2e1d1498e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c7af5bbdcaaaf03cd53377383bf23ae 2x, https://si.imgix.net/781ac612/uploads/origins/17dd0d2b-d3af-4f0a-bb60-a2e1d1498e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e560293a8eb5cc2ecb49435d7cc55b04 3x", "genre": "art", "nsfw": false, "body": "こんにちは、よろしくお願いします！\n\nファイアーエムブレムフェイトのかげろうを描いていただけませんか？\n\nhttps://fireemblem.fandom.com/wiki/Kagero/Gallery\n\nこの参考文献の水着を着せてください。\n\nhttps://skeb.jp/@akinoEX/works/58\n\nhttps://skeb.jp/@MarOgnvw4HzaBTg/works/116\n\nかげろうが男性の恋人と海辺を歩いているシチュエーションが欲しいです。影郎は楽しそうに、男性の腕に抱きついて腕枕をしています。巨乳が男性の腕に押し付けられている。こんな感じです。(恋人の男性については特に必要ありません)\n\nhttps://gelbooru.com/index.php?page=post&s=view&id=7705323&tags=hugging_arm\n\nかげろうは、穏やかな/幸せそうな表情で彼を見ています。それだけである。\n\nお忙しい中、ご配慮いただきありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@shibata3gb/works/33", "thumbnail_src": "https://si.imgix.net/2e4993b7/uploads/origins/4679e1d8-23ca-464e-bf10-01d3eb1909d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5cb23baace428110d832b7e5fb2d6f", "thumbnail_srcset": "https://si.imgix.net/2e4993b7/uploads/origins/4679e1d8-23ca-464e-bf10-01d3eb1909d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e5cb23baace428110d832b7e5fb2d6f, https://si.imgix.net/2e4993b7/uploads/origins/4679e1d8-23ca-464e-bf10-01d3eb1909d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87c8c0cfdc37fd18d6902d12607e3431 2x, https://si.imgix.net/2e4993b7/uploads/origins/4679e1d8-23ca-464e-bf10-01d3eb1909d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61374723e7261d3c5bdcfcb22b0faafc 3x", "genre": "art", "nsfw": false, "body": "▼作品\nアクセル・ワールド\n\n▼キャラ\n上月由仁子\n\n▼概要\nウエディング下着\n\n▼詳細\nウエディングドレス風の下着に身を包んだ上月由仁子のイラストをお願いします。\n\n抱き枕イラストのような感じで好きな男の子を受け入れているような雰囲気で描写してください。\n首のアクセサリは残してもらえるとありがたいです。\n\nそばかすのある女の子なので描写をおねがいします。\n\n▼資料\n・キャラ資料\nhttps://dengekionline.com/elem/000/001/437/1437190/aw_18_cs1w1_720x1280.jpg\n\n・服装のイメージ\nhttps://livedoor.blogimg.jp/maxell011/imgs/9/1/91400187.jpg", "created_at": "", "completed_at": ""}, {"path": "/@shibata3gb/works/32", "thumbnail_src": "https://si.imgix.net/5ef5f732/uploads/origins/90239988-d01b-4369-93f9-3a63fe874864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=883095f21bafaeafdbb4fcf98f326035", "thumbnail_srcset": "https://si.imgix.net/5ef5f732/uploads/origins/90239988-d01b-4369-93f9-3a63fe874864?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=883095f21bafaeafdbb4fcf98f326035, https://si.imgix.net/5ef5f732/uploads/origins/90239988-d01b-4369-93f9-3a63fe874864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ee47f013995effbbb214e4ef143220a 2x, https://si.imgix.net/5ef5f732/uploads/origins/90239988-d01b-4369-93f9-3a63fe874864?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02b848c9b85ce82b6a5a2e7ffde24248 3x", "genre": "art", "nsfw": false, "body": "普段より素敵なイラストにお世話になっております。\n中の人繋がりでショートパンツキャラのコスプレした千葉エリカと渡辺摩利のイラストお願いします！\n【衣装】\nエリカ→仙都木優麻\nhttp://www.strike-the-blood.com/first/#/character3\n摩利→天塚・弥生\nhttps://sigururi.com/chara/other/#chara_17\n【シチュ】\nお腹周りの露出を恥ずかしがっている摩利をエリカが背後からからかう感じの構図でお願いします。\n\n何卒ご一考いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@shibata3gb/works/31", "thumbnail_src": "https://si.imgix.net/080e26f8/uploads/origins/482de135-0efa-441b-b90e-b6b650c03893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d025448da79dc79a3dc82f71d7b0b3f8", "thumbnail_srcset": "https://si.imgix.net/080e26f8/uploads/origins/482de135-0efa-441b-b90e-b6b650c03893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d025448da79dc79a3dc82f71d7b0b3f8, https://si.imgix.net/080e26f8/uploads/origins/482de135-0efa-441b-b90e-b6b650c03893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b22654057e2ce3597e685809f0a1c08b 2x, https://si.imgix.net/080e26f8/uploads/origins/482de135-0efa-441b-b90e-b6b650c03893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd5408cf4ece0a07f011021974dd25ec 3x", "genre": "art", "nsfw": false, "body": "はじめまして、\nえすです。\n\nアニメ塗りとても好きですので依頼させてください。\nキャラはうちの子です。もうすぐ夏なので衣装は水着でお願いします。\nそれ以外お任せます。\n\nhttps://drive.google.com/drive/u/3/folders/1pJqnGxZNZL5dPsbkH2fa2s64MCi9bg4U", "created_at": "", "completed_at": ""}, {"path": "/@shibata3gb/works/30", "thumbnail_src": "https://si.imgix.net/dcbb6029/uploads/origins/de2d6a22-84af-4f7b-970b-d787bbd33800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cbb79b4d321dcd4a2cd91695b5ada6d", "thumbnail_srcset": "https://si.imgix.net/dcbb6029/uploads/origins/de2d6a22-84af-4f7b-970b-d787bbd33800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cbb79b4d321dcd4a2cd91695b5ada6d, https://si.imgix.net/dcbb6029/uploads/origins/de2d6a22-84af-4f7b-970b-d787bbd33800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6fe218f67961f56e3e31648bb907557 2x, https://si.imgix.net/dcbb6029/uploads/origins/de2d6a22-84af-4f7b-970b-d787bbd33800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0843da484f9a2c2ce6e2d5badb03f3b7 3x", "genre": "art", "nsfw": false, "body": "前回も赤沢さんと恒一の素敵なイラストをありがとうございました。\n是非もう一度この二人をカップルらしく描いて頂きたいです。\n詳細はお任せします。資料を参考にご自由にお描きください。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "created_at": "", "completed_at": ""}, {"path": "/@shibata3gb/works/29", "thumbnail_src": "https://si.imgix.net/0567d4c0/uploads/origins/6dcf0b68-1c79-43a7-b8e8-55fbcb86e224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0cdc0975caea14e153df17d3a156b26", "thumbnail_srcset": "https://si.imgix.net/0567d4c0/uploads/origins/6dcf0b68-1c79-43a7-b8e8-55fbcb86e224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0cdc0975caea14e153df17d3a156b26, https://si.imgix.net/0567d4c0/uploads/origins/6dcf0b68-1c79-43a7-b8e8-55fbcb86e224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18219e58e4ce6f3e2f483832f0d642e2 2x, https://si.imgix.net/0567d4c0/uploads/origins/6dcf0b68-1c79-43a7-b8e8-55fbcb86e224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b0e5bab8be9191fbcd83c8dcb96a830 3x", "genre": "art", "nsfw": false, "body": "炭　様\n\nこんにちは。\n\nリクエスト再開ありがとうございます。\nこちらをリクエストさせて下さい。\n\n■キャラクター\n書籍『マンガの基礎デッサン　セクシーキャラ編 (マンガの技法書)』より表紙のピンク髪の女の子(http://amzn.to/1jm4OxG)\n※下記資料URLでも確認可能です。\n\n■内容\n朝。男物のYシャツ姿だけを着た女の子が、恋人の男性にお姫様抱っこをされて、照れつつも嬉しそうな表情を浮かべている。\n・男物のYシャツや部屋は他のクリエイター様のイラストになりますが、下記を参考にして下さい。\nhttps://skeb.jp/@aco_bearchannel/works/34\n・女の子の耳飾りは無くていいです。\n・男性は長身のイケメンといった感じの背丈ですが、顔は分からないようにして下さい。\n・男性の服装は上半身裸、下はGパンでお願いします。\n・その他細部に関してはお任せします。\n\n以上、よろしければお願いします。\n\nhttps://imgur.com/a/R3SKF1X", "created_at": "", "completed_at": ""}, {"path": "/@shibata3gb/works/28", "thumbnail_src": "https://si.imgix.net/eccc5f42/uploads/origins/819e5403-fe1b-4d17-9723-a0fd0d8adcc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0605361c6ba788f1756655de646a2c70", "thumbnail_srcset": "https://si.imgix.net/eccc5f42/uploads/origins/819e5403-fe1b-4d17-9723-a0fd0d8adcc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0605361c6ba788f1756655de646a2c70, https://si.imgix.net/eccc5f42/uploads/origins/819e5403-fe1b-4d17-9723-a0fd0d8adcc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a95083c7c29e350b0ad0346225cfcfeb 2x, https://si.imgix.net/eccc5f42/uploads/origins/819e5403-fe1b-4d17-9723-a0fd0d8adcc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=973eaac59d26a700a345b22f71264158 3x", "genre": "art", "nsfw": false, "body": "お世話になります。劣等生キャラの依頼になります。\n\n資料URLにある水着を着た七草真由美（メイジアンカンパニー）をお願いします。\n\n海水浴デートの後、デート時には人目もあるので恥ずかしくて着なかったけど用意だけはしておいた彼好みの水着を、帰宅後に他の人の目がない部屋で着てあげた。と言う様なシチュエーションを想定しています。\nラップタオルの下に着ていた水着を恥ずかしいけど二人きりだし…とご開帳して見せている様なイメージです。\n版権イラストやソシャゲでは設定から外れすぎない範囲でおっぱい盛られがちですが、\n極端におっぱいが大きいキャラ達には及ばない範囲で盛られてる時の方が好みなのでおっぱいのサイズ感はそのくらいだとありがたいです。\n希望として、恥ずかしいけどモジモジはしていないと言うか、股は閉じていないと嬉しいです。\nもう一点、イマイチ後ろ髪の長さが安定しないのですが長い方が好みなのでそちらに寄せて頂けると助かります。\n\nメイジアンカンパニー版はアニメやソシャゲで出番が多い学生時と比べて資料が少なく、\nそれに加えて要望も多く恐縮ですがご一考いただけますと幸いです。\nクリエイター様の判断で学生時のイメージに変更していただいても問題ありません。\nよろしくお願いします。\n\nhttps://twitter.com/RIMdabe/status/1643099501790633984?s=20", "created_at": "", "completed_at": ""}, {"path": "/@shibata3gb/works/27", "thumbnail_src": "https://si.imgix.net/f8587fb0/uploads/origins/5d6d6f6a-0c2b-4495-a628-4f555c2b9e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=770fff1b9fb5f8b72b703fe6e966df1c", "thumbnail_srcset": "https://si.imgix.net/f8587fb0/uploads/origins/5d6d6f6a-0c2b-4495-a628-4f555c2b9e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=770fff1b9fb5f8b72b703fe6e966df1c, https://si.imgix.net/f8587fb0/uploads/origins/5d6d6f6a-0c2b-4495-a628-4f555c2b9e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b597f87662df86440a7c6429feeaffc 2x, https://si.imgix.net/f8587fb0/uploads/origins/5d6d6f6a-0c2b-4495-a628-4f555c2b9e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7454e35d4b2fbd13c669404fe6004a6c 3x", "genre": "art", "nsfw": false, "body": "以前は素敵なイラストをありがとうございました。\n再度光翼戦姫エクスティアシリーズから紫峰真理奈と紫峰創真のイラストをお願いできますでしょうか。\nシチュエーションとしまして、本編終了数年参考資料のとおり二人に子供が生まれるのですが\n主人公である創ちゃんが子供を抱きかかえ、真理奈が微笑みながら並んで外を散歩しているような場面をお願いできますでしょうか。\n