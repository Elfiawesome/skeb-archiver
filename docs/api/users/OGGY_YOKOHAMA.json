507292\n\n表情もご自由にお決めください。また、負担でなければ、彼女への技の描写を格闘ゲームのフィニッシャーのような演出で表現していただけると嬉しいです。補足：セリュウムのパワーが低下すると、胸のゲージが赤く光ります。\n\nお時間をいただき誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/19BudVwaIDZ9OeVGD2m-O9tjQs2lGlgRS", "created_at": "", "completed_at": ""}, {"path": "/@OGGY_YOKOHAMA/works/87", "thumbnail_src": "https://si.imgix.net/c26e17b9/uploads/origins/367a02de-84d3-4c59-84e7-777c0debf4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f734d89677396a46b24273b9ae99c801", "thumbnail_srcset": "https://si.imgix.net/c26e17b9/uploads/origins/367a02de-84d3-4c59-84e7-777c0debf4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f734d89677396a46b24273b9ae99c801, https://si.imgix.net/c26e17b9/uploads/origins/367a02de-84d3-4c59-84e7-777c0debf4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3eee1a84a2f406cb2a7277079527ffd9 2x, https://si.imgix.net/c26e17b9/uploads/origins/367a02de-84d3-4c59-84e7-777c0debf4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=440402e517892cdfdbf2a0d9e196cecc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@OGGY_YOKOHAMA/works/86", "thumbnail_src": "https://si.imgix.net/bf35d43c/uploads/origins/da4c9372-f40a-4135-8680-7ef91e81b6ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=145f828c52d2690af53c6a1f832f3b31", "thumbnail_srcset": "https://si.imgix.net/bf35d43c/uploads/origins/da4c9372-f40a-4135-8680-7ef91e81b6ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=145f828c52d