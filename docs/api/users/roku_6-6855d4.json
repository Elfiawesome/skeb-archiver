旨のツイートをすることがあるのですが、その際に使用するイラストをお願いしたいです。\n\nTwitter上やYoutubeのサムネイルに使用させて頂きたいので、許可を頂ける場合にリクエスト承認して頂ければと思います。\nキャタクター、背景、サインのレイヤーが別の状態のpsdデータで頂けるとありがたいです。\n\nよろしくお願いいたします！\n\nhttps://twitter.com/shi_na_matatabi/status/1518023720584974336", "created_at": "", "completed_at": ""}, {"path": "/@roku_6/works/83", "thumbnail_src": "https://si.imgix.net/66dba318/uploads/origins/fd155285-5de0-4081-9a00-e25c79f1f850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a7c5b5ac6e4c65b271b0813d07755e7", "thumbnail_srcset": "https://si.imgix.net/66dba318/uploads/origins/fd155285-5de0-4081-9a00-e25c79f1f850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a7c5b5ac6e4c65b271b0813d07755e7, https://si.imgix.net/66dba318/uploads/origins/fd155285-5de0-4081-9a00-e25c79f1f850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab9c945f07787b9a1a98ddf9f2f632f0 2x, https://si.imgix.net/66dba318/uploads/origins/fd155285-5de0-4081-9a00-e25c79f1f850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=381c7309c0b4b981d6b7d35e6da43d27 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@roku_6/works/82", "thumbnail_src": "https://si.imgix.net/27072091/uploads/origins/53bb8703-ddc7-4b38-9db6-fba298e9d491?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e3538a22b8051ba6b68d8e7f9d12ba5", "thumbnail_srcset": "https://si.imgix.net/27072091/uploads/origins/53bb8703-ddc7-4b38-9