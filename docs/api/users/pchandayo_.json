2556rqq2elferxx/AHYWizGIOwCQEn12CSVXvlE?rlkey=lwzzuxtllrqedzgrn3k7wjeuj&st=0yloef5f&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@pchandayo_/works/140", "thumbnail_src": "https://si.imgix.net/47b1c594/uploads/origins/0e04b1fd-4cff-48f2-9e16-6d47573c3ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f667f9620e0542fb081736c8c262346", "thumbnail_srcset": "https://si.imgix.net/47b1c594/uploads/origins/0e04b1fd-4cff-48f2-9e16-6d47573c3ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f667f9620e0542fb081736c8c262346, https://si.imgix.net/47b1c594/uploads/origins/0e04b1fd-4cff-48f2-9e16-6d47573c3ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efa9decfcbd6be3f3cb5a4f7d2bb35ff 2x, https://si.imgix.net/47b1c594/uploads/origins/0e04b1fd-4cff-48f2-9e16-6d47573c3ca7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d505a90dee99eefc8a3de692a175a69f 3x", "genre": "art", "nsfw": false, "body": "ぴ様こんにちは！\n新着で拝見したぴ様の作品に心を奪われました。\nキャラクターと背景の親和性、ペンのタッチ、キャラクターの造形、色彩センス。そのどれもが大好きです！\n是非、ぴ様に友人とのOC達を描いてもらいたいです！\n\nリクエストしたい内容はこちらです。\n\n──\n\n￤キャラクター（OC/TRPGキャラクター）\n名前：織珂（おるか）／10年後\n性別：男\n\n名前：瑚花（こはる）\n性別：女\n\n関係性：大切な友達。瑚花から織珂へ片思いをしており、織珂もそれを認識している。\n\n\n希望：背景付きでお好きに描いてもらえたら嬉しいです！！織珂は10年後のビジュアルでお願いします。\n\n使用用途：個人鑑賞、アイコンや壁紙への使用、非商用のもの。TRPGのセッションへの使用。\nキャラクターと背景がレイヤー分けされたpsdファイルでお願いします。\n（AI学習の防止を希望する場合、学習を防止したデータも別でいただけると嬉しいです）\n\n──\n\n以上となります。金額などに不備がありましたら遠慮なく再送信して頂けたら幸いです。何卒よろしくお願いします。\n\nhttps://www.notion.so/1f0a84379c7380ee95b9e9f6622530f0?source=copy_link", "created_at": "", "completed_at": ""}, {"path": "/@pchandayo_/works/139", "thumbnail_src": "https://si.imgix.net/83105ec2/uploads/origins/fab8130b-6e7b-457e-9356-20d976e7faa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d79197f13976c76f75d52fbe80cc875", "thumbnail_srcset": "https://si.imgix.net/83105ec2/uploads/origins/fab8130b-6e7b-457e-9356-20d976e7faa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d79197f13976c76f75d52fbe80cc875, https://si.imgix.net/83105ec2/uploads/origins/fab8130b-6e7b-457e-9356-20d976e7faa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1e07343d19427fec9b8358fb5cc1f05 2x, https://si.imgix.net/83105ec2/uploads/origins/fab8130b-6e7b-457e-9356-20d976e7faa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70059edd3c0e121dc6d2a7f63f5f4393 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pchandayo_/works/138", "thumbnail_src": "https://si.imgix.net/d0107873/uploads/origins/7251f625-e1bf-4ef8-911e-2f7fbde99ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09a3bf74f8b09c2f760eca021db2ed2d", "thumbnail_srcset": "https://si.imgix.net/d0107873/uploads/origins/7251f625-e1bf-4ef8-911e-2f7fbde99ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09a3bf74f8b09c2f760eca021db2ed2d, https://si.imgix.net/d0107873/uploads/origins/7251f625-e1bf-4ef8-911e-2f7fbde99ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fab73586c88d73ef998112eebcbee4fc 2x, https://si.imgix.net/d0107873/uploads/origins/7251f625-e1bf-4ef8-911e-2f7fbde99ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a506da0048d8a2485186cfb47c04dec 3x", "genre": "art", "nsfw": false, "body": "ぴ様\n\n初めまして、素敵な絵がとても好きです！\n私と親友のオリジナルキャラ2人のイラストをお願いしたいです。\n金額が足りない場合は、遠慮なく再送依頼をいただければと思います。\n\nOCの2人は、古代中国の仙侠（中華風ファンタジー）世界の、仙女（銀髪）と魔尊（黒髪）です。\n具体的な容姿やキャラ設定などは下記の資料URLにございます。\nhttps://drive.google.com/drive/folders/1k_8tCwPq5vkJZh9nfhS7m0Vxqgsqsnm8\n※服飾は資料に添付しましたが、特に指定は無いので、服飾の簡略化やアレンジ、 変更など自由にしていただいて大丈夫です。\n\n表情、ポーズなどの解釈、イラストの構図、背景、不明点やアレンジも全てお任せ致します。\n\n▼【使用用途】\n・本イラストは個人利用に限定させていただきます。\n・SNSのアイコンへの使用や、個人鑑賞目的でのみ印刷させていただく場合があります。\n\nまた、ご依頼内容が難しいと感じられた場合は、キャンセルしていただいても構いません。\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。\n何卒よろしくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@pchandayo_/works/137", "thumbnail_src": "https://si.imgix.net/15887fbd/uploads/origins/463a3023-781e-4604-8ab8-17a813699ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=962eb8c0054509f876b9bec5cbb7220a", "thumbnail_srcset": "https://si.imgix.net/15887fbd/uploads/origins/463a3023-781e-4604-8ab8-17a813699ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=962eb8c0054509f876b9bec5cbb7220a, https://si.imgix.net/15887fbd/uploads/origins/463a3023-781e-4604-8ab8-17a813699ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=120784af4b0acf13172828af106d2e9a 2x, https://si.imgix.net/15887fbd/uploads/origins/463a3023-781e-4604-8ab8-17a813699ec2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bbc3a47618e1bca68f7d3cdc34ed708 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pchandayo_/works/136", "thumbnail_src": "https://si.imgix.net/30d9c0f3/uploads/origins/7d690427-d5fa-4d3b-9c42-192656ab40b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=532674ec4c5f33e4e4791bcc97f4cb01", "thumbnail_srcset": "https://si.imgix.net/30d9c0f3/uploads/origins/7d690427-d5fa-4d3b-9c42-192656ab40b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=532674ec4c5f33e4e4791bcc97f4cb01, https://si.imgix.net/30d9c0f3/uploads/origins/7d690427-d5fa-4d3b-9c42-192656ab40b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdc8b8ed97f1ffae0ce60ce6fb5ab29d 2x, https://si.imgix.net/30d9c0f3/uploads/origins/7d690427-d5fa-4d3b-9c42-192656ab40b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bac84556f1b4e949bb5c58588d08dbb 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ぴー先生、\n\n先生の作品の美しさにすっかり魅了されてしまいました。光と色の使い方が本当にまぶしいです！光と色の使い方が本当にまぶしいです！だからこそ、ぜひあなたにリクエストを送りたいのです。\n\n私が考えているイラストは、古代中国風の服を着た二人のキャラクターです：\n\nキャラクターA：権力者で、自信に満ち、狡猾で、少し傲慢。\n\nキャラクターB-執権下にある若い皇帝で、しばしば無力感を感じ、静かに不満を募らせている。\n\n身長も体格も似ている2人の間に、宿命的なライバル意識と絡み合った運命が感じられるような作品になればと思います。\n\n彼らのビジュアル・リファレンスと外見の詳細については、末尾のグーグル・ドライブのリンクを参照されたい。\n\n最後までお読みいただき、ありがとうございました！\nご迷惑であれば、遠慮なくお断りください。\nご検討のほど、よろしくお願いいたします！💐\n\nhttps://drive.google.com/drive/folders/1Rd86SEFkgQNNT7Yujmy62ItccXWmtfu7?usp=drive_link", "created_at": "", "completed_at": ""}]}