ix.net/546be35b/uploads/origins/8c28a7e0-31d3-42ca-b20e-82c38a4bb598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=210f3ecc09dcb6800f2802907345b6bc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして。\n\nできれば手短に済ませたいのですが、エヴァのアスカを描いていただけないでしょうか？プラグスーツのデザインは何でも構いません。レイの絵がとても好きなので、選ぶのも大丈夫だと思います。長文になり申し訳ありませんが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@raisu_eito/works/2", "thumbnail_src": "https://si.imgix.net/a1b5d567/uploads/origins/2ac34e54-a395-4074-92bb-a673b9911f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c400c86577e21ea06e6a792a4b42327", "thumbnail_srcset": "https://si.imgix.net/a1b5d567/uploads/origins/2ac34e54-a395-4074-92bb-a673b9911f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c400c86577e21ea06e6a792a4b42327, https://si.imgix.net/a1b5d567/uploads/origins/2ac34e54-a395-4074-92bb-a673b9911f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=773f89c5be982525427baad155974ad2 2x, https://si.imgix.net/a1b5d567/uploads/origins/2ac34e54-a395-4074-92bb-a673b9911f4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25c319579203470917a7c2088ace05f 3x", "genre": "art", "nsfw": false, "body": "あなたの絵を見ましたが、とてもかわいいですね。私のキャラクターを描いてくれませんか？\nhttps://i.imgur.com/UYOeyOE.png\n衣装はどちらでも構いません。\n疲れていて、目の下に袋があるような感じだといいですね。\n\n手すりにもたれて立っているポーズを描いてください。\nhttps://i.imgur.com/3XSmvos.png", "created_at": "", "completed_at": ""}, {"path": "/@raisu_eito/works/1", "thumbnail_src": "https://si.imgix.net/e4bd1314/uploads/origins/780a395c-2880-4655-9cac-faa34f55a407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc28894f4b2edee88f5ba24c75c5aa4", "thumbnail_srcset": "https://si.imgix.net/e4bd1314/uploads/origins/780a395c-2880-4655-9cac-faa34f55a407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc28894f4b2edee88f5ba24c75c5aa4, https://si.imgix.net/e4bd1314/uploads/origins/780a395c-2880-4655-9cac-faa34f55a407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16802b0b36aba9e2250643a873f33e66 2x, https://si.imgix.net/e4bd1314/uploads/origins/780a395c-2880-4655-9cac-faa34f55a407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34e83f1539248e98328e0b1dd7afa027 3x", "genre": "art", "nsfw": false, "body": "Hello my friend, its Baka ^_^\nPlease can I see Ciel Senpai from Tsukihime in your style. Please draw her in the full battle style from her route with the tattoos and 7th scripture gun. Make her wear glasses. Please draw her hair and glasses like the old style. Posed similar to reference image. Also please show her battle damaged (damaged clothes and bloody).\n\nhttps://i.pinimg.com/originals/db/24/e1/db24e139995e835bb1ca87ddc81b8322.jpg", "created_at": "", "completed_at": ""}]}