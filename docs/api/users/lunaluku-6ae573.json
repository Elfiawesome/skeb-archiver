%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac178191803fb99ab76bf3d6b2a18c7d, https://si.imgix.net/f26211c9/uploads/origins/00750313-44a6-48be-be1c-95411f9bfadf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf198a6deb94e37d13b9a3518c4993d3 2x, https://si.imgix.net/f26211c9/uploads/origins/00750313-44a6-48be-be1c-95411f9bfadf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4823d26a350caa48cb4af0142f9a2481 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lunaluku/works/53", "thumbnail_src": "https://si.imgix.net/528400ea/uploads/origins/bebcde4b-1cf9-43cc-96bf-fb43b11deb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0c222e11c2e49b57ca0ea592c5e1a36", "thumbnail_srcset": "https://si.imgix.net/528400ea/uploads/origins/bebcde4b-1cf9-43cc-96bf-fb43b11deb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0c222e11c2e49b57ca0ea592c5e1a36, https://si.imgix.net/528400ea/uploads/origins/bebcde4b-1cf9-43cc-96bf-fb43b11deb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43c4257ee6f1fb17cb57b1ce1e13d672 2x, https://si.imgix.net/528400ea/uploads/origins/bebcde4b-1cf9-43cc-96bf-fb43b11deb4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae0b40ba804a64c019e7d3e1d3200953 3x", "genre": "art", "nsfw": true, "body": "こんにちは、お久しぶりです。\n私の友人があなたの大ファンで、あなたの作品が好きなんだ。\n彼はプリヤの大ファンでもある。\n3Pのシナリオになるだろう\n\n【作品】 プリヤ (プリズマ☆イリヤ)\n【キャラ】 イリヤ, クロエ, 美遊 (イリヤの三姉妹)\nテーマはカーテン魂の最近描き下ろしグッズのベビードール衣装です！\n服装に合わせてオムツを履かせるべきだ。\nおむつのブランドはバニーホップスで、色はキャラクターに合わせて。\n\n【シチュ】\nイリヤと美優はオムツ姿でベッドの上でセックスしている。\nミユはイリヤのベッドの端に横たわり、イリヤを股間に挟んで宣教師的な体位で寝ている。\n仲間はずれにされたと感じているクロエは、イリヤの背後から攻撃しようとする。クロエもオムツをしている。\nポーズのリファレンスはリンク先にある。\n\n【構図】\n友人の好みが特殊なので、ピース用に数種類のバージョンが欲しい。\nおむつバージョンとパンツバージョンがあるはずだ。\n両方の作品について、清潔なバージョンと、オムツやパンツが使用された（ウンチやオシッコが漏れた）バージョンが必要である。\n女の子全員がフタナリというバージョンもあると嬉しい。\n私の友人は小さいペニスが好きなので、サイズは大きくなくてもいいんです。\nバージョンが違うことをあらかじめお詫びする。\n\n【表情】\nその表現はあなたにお任せします。\n\n【参考用】\nhttps://drive.google.com/drive/folders/1k1cm8EA9FyLheJ9Vw4zlLxf_NPG3PTuC?usp=drive_link\n\n【その他】 \n人物・背景等がレイヤー分け出来るPSDデータで頂けると有難いです。\n\n以上です！是非よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@lunaluku/works/52", "thumbnail_src": "https://si.imgix.net/66825654/uploads/origins/137aa1e2-5fa4-46d1-b2d7-cdd84d90656f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29406c0dbc628fa8effe456c35f09fdc", "thumbnail_srcset": "https://si.imgix.net/66825654/uploads/origins/137aa1e2-5fa4-46d1-b2d7-cdd84d90656f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29406c0dbc628fa8effe456c35f09fdc, https://si.imgix.net/66825654/uploads/origins/137aa1e2-5fa4-46d1-b2d7-cdd84d90656f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0fa8134a06b1d0812e51f808df58b64 2x, https://si.imgix.net/66825654/uploads/origins/137aa1e2-5fa4-46d1-b2d7-cdd84d90656f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddc7b58cca3a42cb51529a23917b1b27 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\nイラスト2点とバリエーション1点をお願いしたいです。キャラクターは、人前でラバーバニーのランジェリーとかわいいマーメイドのレインコートを着て恥ずかしい思いをするのが好きな大人の女の子です。今日、彼女はもっとセクシーになりたいと考えています。\n\nA) 浣腸をしばらく我慢した後、静かな場所を見つける。かわいいリュックの上にしゃがむ。汗と涙にまみれた表情で、パンティ越しに大量のおしっことうんこをリュックに入れる。全部回収して証拠を残したくない。\n\nB1) Aに続いて、目立たないようにこっそり逃げようとする。公共の場所を歩き、興奮を高める。至福の表情で、汚い秘密を背負っていることを楽しんでいる。\n実際はリュックサックに入りきらない。彼女の背後には汚れた痕跡が漏れている。彼女はまだ知らない。\n\nB2) 少女は自分の秘密が暴露されたことに気づく。怯えた表情、涙、失禁。\n\nご検討ありがとうございました。\n\nhttps://pansyn.com/dl/cute_raincoat_ref.png", "created_at": "", "completed_at": ""}, {"path": "/@lunaluku/works/51", "thumbnail_src": "https://si.imgix.net/327d9896/uploads/origins/bd3d482f-9587-4ce6-95dc-ef3ba1f45b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a292e936a324831638b2c43a4415e72", "thumbnail_srcset": "https://si.imgix.net/327d9896/uploads/origins/bd3d482f-9587-4ce6-95dc-ef3ba1f45b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a292e936a324831638b2c43a4415e72, https://si.imgix.net/327d9896/uploads/origins/bd3d482f-9587-4ce6-95dc-ef3ba1f45b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1903bd533c304f390d3dcabab6b2c66 2x, https://si.imgix.net/327d9896/uploads/origins/bd3d482f-9587-4ce6-95dc-ef3ba1f45b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b393fad0a9aab370f0b0258f85c5bfd5 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n以下の内容でリクエストします\n\n【キャラクター】\nグレイス(作品:SOUND VOLTEX)\nこちらキャラクター資料です。1番下のキャラクターになります。\nhttps://x.com/soundvoltex573/status/1322009092680896512?s=46&t=3FccnHHq6yhTT2F7k907cQ\n\n【内容】\n・先生の以下のCG作品の伊藤千佳が洋式便器で大量脱糞しているイラストと同じようにグレイスが洋式便器に極太大量脱糞しているイラスト\n・また同じように出したうんこと一緒にピースしているイラスト\n・グレイス脱糞後のうんこがたっぷり詰まった洋式便器を上から見たイラスト\n\n以上3枚のイラストをお願いします\n\n【欲しい要素】\n・アナルが火山の噴火口のように盛り上がって排泄\n・うんこに未消化物が多く含まれている\n・排泄中は気持ちよさそうな表情\n・ピース時の表情は笑顔で少し恥ずかしそうに\n\n以上になります\n検討のほどよろしくお願いします\n\nhttps://sms.booth.pm/items/29301", "created_at": "", "completed_at": ""}, {"path": "/@lunaluku/works/50", "thumbnail_src": "https://si.imgix.net/f134c2e6/uploads/origins/f87461ac-bebc-4914-bd4b-9fc28318e107?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fbae8fdae9ec67a724d37abd3d07c0d", "thumbnail_srcset": "https://si.imgix.net/f134c2e6/uploads/origins/f87461ac-bebc-4914-bd4b-9fc28318e107?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fbae8fdae9ec67a724d37abd3d07c0d, https://si.imgix.net/f134c2e6/uploads/origins/f87461ac-bebc-4914-bd4b-9fc28318e107?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5727fdf5358e23cf583f83b622d7c7f 2x, https://si.imgix.net/f134c2e6/uploads/origins/f87461ac-bebc-4914-bd4b-9fc28318e107?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2792e501004db99d7768bafd04cc3be8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@lunaluku/works/49", "thumbnail_src": "https://si.imgix.net/22929c0b/uploads/origins/afe856e9-2113-4b6e-b2af-3f53031f8482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d155db9c56af8ff3694eb99f948f8548", "thumbnail_srcset": "https://si.imgix.net/22929c0b/uploads/origins/afe856e9-2113-4b6e-b2af-3f53031f8482?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d155db9c56af8ff3694eb99f948f8548, https://si.imgix.net/22929c0b/uploads/origins/afe856e9-2113-4b6e-b2af-3f53031f8482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a5abba4d72d938aef26dbd5f475a128 2x, https://si.imgix.net/22929c0b/uploads/origins/afe856e9-2113-4b6e-b2af-3f53031f8482?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a33b1edd4ecc48d0753838e88ad5fe49 3x", "genre": "art", "nsfw": true, "body": "はじめまして、\n\nアクアとウィズを使ったイラストをお願いします。\n二人は可愛いシャツにゴムエプロン、手袋に長靴。ウィズはエナメルシャツ。\nhttps://pansyn.com/dl/aw_apron.png\n\nストーリー\nアクアとウィズは切磋琢磨している。どちらが長く浣腸を我慢できるかを競う。相手はそれを難しくするために後ろからいじめる。負けると、パンティの中にオシッコとウンコをする。溢れて相手のエプロンも汚してしまう。顔を赤らめながらも興奮した表情。涙目で、我慢して汗だく。\n\n2アングルでお願いしたい：\nhttps://pansyn.com/dl/aw_version.png\nA) 後ろから。アクアは上。後ろから見るとパンティが見えている。\nB) 正面から。ウィズが上。汚れたエプロンが見える。\n\n清潔、失禁、ウンチ、前回からの汚れという進行も見せたい。\n\nスケッチのポーズに忠実に従う必要はない。あくまでフレーミングを説明するためのものです。\n\nご検討ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@lunaluku/works/48", "thumbnail_src": "https://si.imgix.net/2966fac9/uploads/origins/db06b869-c571-4095-9179-2008fc27cd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b6a8a292af1b4f6090f3084133bddc", "thumbnail_srcset": "https://si.imgix.net/2966fac9/uploads/origins/db06b869-c571-4095-9179-2008fc27cd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b6a8a292af1b4f6090f3084133bddc, https://si.imgix.net/2966fac9/uploads/origins/db06b869-c571-4095-9179-2008fc27cd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8526b91a9c0587f226e8c31526e4e69b 2x, https://si.imgix.net/2966fac9/uploads/origins/db06b869-c571-4095-9179-2008fc27cd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5384d7070e0bcb0fcd1a8ced80c41b9f 3x", "genre": "art", "nsfw": true, "body": "【作品】ゆずソフト 【キャラ】矢来美羽、正宗静流 【シチュ】 ・正宗静流は制服姿、矢来美羽は軍服で・正宗静流が攻めで矢来美羽が受けで正宗静流と矢来美羽がお互いに服を着てる状態で脱糞してる状態で正宗静流が手に便を握ってて矢来美羽の口とか軍服に糞を塗りたくってお互いに糞まみれになっているのを見たいです！ 最後にメイド喫茶プラス見たいなうんちレズディープキス見たいです！", "created_at": "", "completed_at": ""}, {"path": "/@lunaluku/works/47", "thumbnail_src": "https://si.imgix.net/f0f1c528/uploads/origins/05552975-96f3-4d56-b013-8b7177b27d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22c89f8153eb027d4eca99257b8a1d18", "thumbnail_srcset": "https://si.imgix.net/f0f1c528/uploads/origins/05552975-96f3-4d56-b013-8b7177b27d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22c89f8153eb027d4eca99257b8a1d18, https://si.imgix.net/f0f1c528/uploads/origins/05552975-96f3-4d56-b013-8b7177b27d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px