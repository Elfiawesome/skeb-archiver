c6c-9659951f07dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85d8b2e1b5b1e7bb66339e7ade0c644e 3x", "genre": "comic", "nsfw": false, "body": "お世話になっております。\nまたコミックを描いて頂きたくリクエストを送らせて頂きました！\n\n[内容]\n\n資料の私のキャラクターの日常のワンシーンなどを\nHEROさんの解釈で描いて頂けたらなと思います。今回は\n\n「翠ちゃんがベースを触りながら、楽器に興味なさそうな小糸ちゃんと話してる話」\n　(ベースとギターって同じじゃないんですか？みたいな)\n　翠ちゃんはアウター脱いでる感じでお願いしたいです。\n\nと\n\n「夏の暑さに負けた翠ちゃんが職場のガレージで人目を気にせず水着着て小さいビニールプールで水浴びしてる話」\n\nでお願いしたいです。\n服装等状況によって変えて頂いたりして構いません。\n\n[用途]\n\n依頼用資料や紹介としてSNSやドライブ等のストレージ、\nコミュニケーションツールで利用させていただければと思います。\nよろしくお願いします。\n\n[設定・資料]\n\n翠　：後輩。銀髪片メカクレ狐耳メガネっ子\n　　　人見知りだけど小生意気な後輩系な内弁慶です。\n　　　※人の耳はありません。最後に尻尾を忘れてないか確認してください。\n\n小糸：先輩。アンニュイな雰囲気のダウナー系。\n　　　小柄、薄め、眠そうな目、敬語キャラ、天然。\n　　　かわいい服装と素麺が好き\n\n以上よろしくお願いします。\n\n水着参考\nhttps://skeb.jp/@SakumaGinmaru/works/65\nhttps://skeb.jp/@NaTa/works/13\n\nキャラクター資料\nhttps://drive.google.com/drive/folders/1SABBfJJ8og1TAFGjhK7Edc6og_BrEQ_u?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@dka_hero/works/179", "thumbnail_src": "https://si.imgix.net/68241abf/uploads/origins/1cb11670-ce9c-4b22-948c-60106f97a719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4cdbb01209e1fcc3b71b9c2fb725c73", "thumbnail_srcset": "https://si.imgix.net/68241abf/uploads/origins/1cb11670-ce9c-4b22-948c-60106f97a719?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4cdbb01209e1fcc3b71b9c2fb725c73, https://si.imgix.net/68241abf/uploads/origins/1cb11670-ce9c-4b22-948c-60106f97a719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04122bbe8dbe5eebe3e374292d0bba28 2x, https://si.imgix.net/68241abf/uploads/origins/1cb11670-ce9c-4b22-948c-60106f97a719?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd0f94c61bb00ff025e10edad9d490f0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dka_hero/works/178", "thumbnail_src": "https://si.imgix.net/818daa08/uploads/origins/bd15c6d5-60f4-4141-9609-f3e6800d097c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc91c9ae8d4699ffc549271c639d942e", "thumbnail_srcset": "https://si.imgix.net/818daa08/uploads/origins/bd15c6d5-60f4-4141-9609-f3e6800d097c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc91c9ae8d4699ffc549271c639d942e, https://si.imgix.net/818daa08/uploads/origins/bd15c6d5-60f4-4141-9609-f3e6800d097c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e79f1c11327d6037167a094b83814071 2x, https://si.imgix.net/818daa08/uploads/origins/bd15c6d5-60f4-4141-9609-f3e6800d097c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b735d5c7bfe0c4bac6db416ce259ce9d 3x", "genre": "art", "nsfw": false, "body": "はじめまして、個人勢Vtuberの碧ななぎといいます。\n\n学生時代に読解アヘンで堀さんと宮村くんをずっと読んでました。先生の絵が好きです！ぜひわたしのOCを書いてほしいです\n\n▧使用目的\nYoutubeのShortsやサムネイル、XなどのSNSで使用します。\n\n▧活動内容\nFF14などのゲーム配信をしてきましたが今後はプラモ組み立て実写配信・同時視聴会も活動の一環にしていこうと考えています。\n\n▧デザイン\nプラモデルを作ってる様子を描いてください。服装はタンクトップなどラフなもので大丈夫です。細かい構図等はお任せします\n\n▧お願い\nサムネイルに使用したいので頭部や身体が切れてないと嬉しいです\n\nお忙しいところ恐縮ですがご一考いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1QQr8IT9uHcGyLbulPO-_f0w0ftUjJILc?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@dka_hero/works/177", "thumbnail_src": "https://si.imgix.net/087778c7/uploads/origins/4e3c8e13-89f9-488e-aa64-fe99e4544358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=946ba460ff4a3f07a996a0a893ce9415", "thumbnail_srcset": "https://si.imgix.net/087778c7/uploads/origins/4e3c8e13-89f9-488e-aa64-fe99e4544358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=946ba460ff4a3f07a996a0a893ce9415, https://si.imgix.net/087778c7/uploads/origins/4e3c8e13-89f9-488e-aa64-fe99e4544358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ee5d559879b4346975d0500363de76a 2x, https://si.imgix.net/087778c7/uploads/origins/4e3c8e13-89f9-488e-aa64-fe99e4544358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4129f5a9fdd3353a965f8702c82e3673 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。 以前pixivFANBOXの書き下ろしアイコン企画（https://www.fanbox.cc/@d-hero/posts/3093030）でオバケのイラストを描いていただいた者です。 いただいたオバケのイラストがとても好きで、アイコンとして活躍してもらっています。 今回は描いていただいたオバケの別バージョンを描いていただきたく思い依頼させていただきました。 別バージョンとして自分の中で想定しているのは別の表情（泣いている、焦っているなど）や別のシチュエーション（寝ている、ゲームをしているなど）となります。 ただ自分の想定しているものでなくても、HERO様の中で描きやすい、しっくりくるようなものがあればその形で描いていただいた方が私としてはとても嬉しいです。 用途としてはSNSのアイコンにさせていただく予定です。 日々の暑さは厳しいですが、十分にご自愛ください。", "created_at": "", "completed_at": ""}, {"path": "/@dka_hero/works/176", "thumbnail_src": "https://si.imgix.net/581bcf2f/uploads/origins/64f3099d-a258-4fc5-a5e7-ab614355af8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dce03c9d2cbd3727b4ebb193d4079e8d", "thumbnail_srcset": "https://si.imgix.net/581bcf2f/uploads/origins/64f3099d-a258-4fc5-a5e7-ab614355af8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dce03c9d2cbd3727b4ebb193d4079e8d, https://si.imgix.net/581bcf2f/uploads/origins/64f3099d-a258-4fc5-a5e7-ab614355af8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a196e94dbc9470c1869a365212fc3453 2x, https://si.imgix.net/581bcf2f/uploads/origins/64f3099d-a258-4fc5-a5e7-ab614355af8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0085e58884cd2825edaa17af9c3d22e5 3x", "genre": "art", "nsfw": false, "body": "HERO先生初めましていつもイラストや漫画など楽しみに見させてもらっています。\n私はアニメのホリミヤを見て堀さんと宮村くんなどのHERO先生の作品を知りファンになっていきました。\n\nこの度は配信活動を初めてみたいと考えておりそれに先立ちHERO先生にアイコンなどのイラストを描いていだだきたく思っております。\n\n使用用途につきましては\n各種SNS等のアイコン\n配信時画面にVTuberさんのように\n表示する\n等に使用したいと考えております。\n\nキャラクターのデザインの詳細についてですが構図や服装などは先生にお任せします。\n・可愛らしい男の子\n・髪型は肩にかからないくらいのストレート\n・髪色は白がメインのグラデーションで\n青(グラデーションの加減につきまして\nはお任せします)\n・3、4等身\nでお願いしたいです。\n出来ればアイコン用のイラスト1種類と配信にのせる用のイラスト2種類を描いていただきたいです。\n何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@dka_hero/works/175", "thumbnail_src": "https://si.imgix.net/fa7a5768/uploads/origins/c549e56f-b930-4998-af72-85d49ca42367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0a5b2ec57084c08559b7541c6be5507", "thumbnail_srcset": "https://si.imgix.net/fa7a5768/uploads/origins/c549e56f-b930-4998-af72-85d49ca42367?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0a5b2ec57084c08559b7541c6be5507, https://si.imgix.net/fa7a5768/uploads/origins/c549e56f-b930-4998-af72-85d49ca42367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2f9387344f58e4b30c2c2864a282115 2x, https://si.imgix.net/fa7a5768/uploads/origins/c549e56f-b930-4998-af72-85d49ca42367?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8655a6f7c76ec9f0a5e3eb02f082d67d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@dka_hero/works/174", "thumbnail_src": "https://si.imgix.net/e1a2986c/uploads/origins/a9406e54-9c50-48f8-9e99-118d6d440043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a0ad7a83196c32a4526f399a2733196", "thumbnail_srcset": "https://si.imgix.net/e1a2986c/uploads/origins/a9406e54-9c50-48f8-9e99-118d6d440043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a0ad7a83196c32a4526f399a2733196, https://si.imgix.net/e1a2986c/uploads/origins/a9406e54-9c50-48f8-9e99-118d6d440043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=028f851b80ff8b4bcfc5b438a30ce2cf 2x, https://si.imgix.net/e1a2986c/uploads/origins/a9406e54-9c50-48f8-9e99-118d6d440043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c70d28156502de764f5bb5da2845e0d 3x", "genre": "comic", "nsfw": false, "body": "初めまして！貴方の絵がとても好きなのでうちの子の漫画を依頼させてください！\nシチュエーションを提案させてください！\n書き方や内容は描きやすいようにアレンジして貰って構いません\n以下、シチュエーションです\n・黒セーラーコートを着ながら暑そうに\n「暑い……」と漏らす星井 巴\n   「この時期にそんな格好をしていたら暑いに決まっているだろう」と返す仮面さん\n・(そういえば使ってない夏服があったな……)と思い出し、白半袖のセーラー服に着替え、髪をポニーテールにし見せる巴。\n「こっちも涼しいし新鮮だね！どう？仮面さん」\n「似合っているとは思うが……夜に活動するには目立たないか？」\n\n大筋はこういう会話でお願いします！\n細かい部分や不足している部分は補完してくださると嬉しいです！\n以下はキャラ設定ですが、資料に詳しい内容が添付してあります！よろしくお願いします！\n\n星井巴\n年齢:17\n種族:人間\n趣味:食事、旅行\n性格\n自身の好奇心や趣味を中心に生きており、仮面さんは振り回されがち。\n見知らぬ土地や景色を渡り歩いたり、眺めるのが好き。\nまた、食べることも好きで華奢な見た目に反してかなり食べる。\n依頼と称して観光目的で旅行し食べ歩きすることもよくあり仮面さんに呆れられている。\n怪奇現象に巻き込まれ異世界に迷い込んだ時ですら観光気分でいるため仮面さんにとても呆れられている。\n背景\n中学生の時にとある怪異に巻き込まれた際に仮面を拾い、力を貸す代わりに妖怪を狩る手伝いをして欲しいと言われ協力関係になる。\n仮面を付けると身体能力が上がり大鎌を扱うことができるようになる。これにより人や妖怪から依頼を受け仮面の力を使い怪異や現象を追い払ったり退治し生計を立てている。\n好奇心旺盛が故かよく怪異や異常現象によく巻き込まれている。\n\n仮面さん\n年齢:不明\n種族:妖怪\n趣味:特になし\n性格\n基本冷静沈着で落ち着いており、妖怪や怪異の知識も豊富で遭遇しても取り乱すことはほとんど無い。\nが最近は巴に振り回されがちのため保護者役として苦労している。\n背景\n彼女が着けている仮面型の妖怪。\n髪飾りに変化することも可能で、授業中や人前では髪飾りになっている。\n仮面から物の見聞きやコミュニケーションが可能で、仮面だけで浮いて移動も少しなら出来るらしい。\n妖怪や怪異などに対する知識がとても豊富。\n\nhttps://drive.google.com/drive/folders/1-5LGOzG_HnTVZqgpEIKTNNhtIk0LKkWH", "created_at": "", "completed_at": ""}, {"path": "/@dka_hero/works/173", "thumbnail_src": "https://si.imgix.net/b08fa8b9/uploads/origins/3cc75f1d-91cf-42d5-b7c7-2e43fd9c0a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5552d6ad3fbcfa9092fcdb3bb64b1b1d", "thumbnail_srcset": "https://si.imgix.net/b08fa8b9/uploads/origins/3cc75f1d-91cf-42d5-b7c7-2e43fd9c0a12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5552d6ad3fbcfa9092fcdb3bb64b1b1d, https://si.imgix.net/b08fa8b9/uploads/origins/3cc75f1d-91cf-42d5-b7c7-2e43fd9c0a12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62ff1524c9a0c15655444ef984686bec 2x, https://si.imgix.net/b08fa8b9/uploads/origins/3cc75f1d-91cf-42d5-b7c7-2e43fd9c0a12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68757b7d6766a5fc7ec3070448d488a5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}