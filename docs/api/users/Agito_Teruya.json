バス。(食われた冒険者は記憶がなくなる)\n・今回、魔力が高く有望な新人冒険者が入ったと噂を聞きつけ、早速新人教育と称してクエストに連れていく。クエスト中に人気が少ない場所に連れこんだところで正体を現し身動き取れなくして搾精パイズリが始まる\n\n\n\n以上よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Agito_Teruya/works/36", "thumbnail_src": "https://si.imgix.net/96afd2b7/uploads/origins/1abd1978-ee46-4844-8a02-364aa9a2b908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92515c9a43c19b813ec1817ac79e3907", "thumbnail_srcset": "https://si.imgix.net/96afd2b7/uploads/origins/1abd1978-ee46-4844-8a02-364aa9a2b908?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92515c9a43c19b813ec1817ac79e3907, https://si.imgix.net/96afd2b7/uploads/origins/1abd1978-ee46-4844-8a02-364aa9a2b908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91727c0680f94a480ce6b28bb114734f 2x, https://si.imgix.net/96afd2b7/uploads/origins/1abd1978-ee46-4844-8a02-364aa9a2b908?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1684b8ae6d6890b6641bfd2163923afb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Agito_Teruya/works/35", "thumbnail_src": "https://si.imgix.net/d687fa99/uploads/origins/4bb436cf-bcbc-4089-ab8d-a88aaccdeead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b92b11afd77fd447708785f45b387b8", "thumbnail_srcset": "https://si.imgix.net/d687fa99/uploads/origins/4bb436cf-bcbc-4089-ab8d-a88aaccdeead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b92b11afd77fd447708785f45b387b8, https://si.imgix.net/d687fa99/uploads/origins/4bb4