t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e84fa29029878e5836f2c3a3403a86f5 2x, https://si.imgix.net/6928f3bc/uploads/origins/05296757-17b9-4218-9375-64daac02dcd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1be1a715c3e2ff3b46a2d4b5faed2525 3x", "genre": "art", "nsfw": false, "body": "うちの子の銀髪片メカクレ狐耳メガネっ子翠ちゃんのカラーイラストを描いて頂きたく依頼しました。\n\n[内容]\n\nかわいい、もしくはかっこよく翠ちゃんを描いて下さい。\nポーズ、構図等はお好きな感じでお任せ致します。\n衣装はオレンジのアウターを着ているパターンでお願いします。\n\nまた背景で翠ちゃんのいる世界観の雑多な感じではあるがネオンや\n派手な看板もある中華風なイメージの背景をお願いしたいです。\n\nPCの壁紙としても使えるとうれしいので横長レイアウトでお願います。\n\n[用途]\n\n依頼用資料や紹介としてSNSやドライブ等のストレージ、\nコミュニケーションツールで利用させていただければと思います。\n\n可能でしたらPSDファイルで納品お願いします。\n宛名なしも別ファイル(png可)にて納品お願いします。\n\nよろしくお願いします。\n\n[設定・資料]\n\n小生意気な後輩系で人見知りの内弁慶です。\nキャラクターについては資料URLをご参照ください。\n※人の耳はありません。最後に尻尾を忘れてないか確認してください。\n\n翠ちゃん資料_251028\nhttps://drive.google.com/drive/folders/1eTlmqneZq4eoO7CBC2KxD83Z0dlHvml2?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/47", "thumbnail_src": "https://si.imgix.net/7f9a41a6/uploads/origins/26d49f49-1981-424b-a2a7-882d9bb53312?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01b6f7b003e675059a2f3cc78cb1e273", "thumbnail_srcset": "https://si.imgix.net/7f9a41a6/uploads/origins/26d49f49-1981-424b-a2a7-882d9bb53312?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01b6f7b003e675059a2f3cc78cb1e273, https://si.imgix.net/7f9a41a6/uploads/origins/26d49f49-1981-424b-a2a7-882d9bb53312?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b9f963ec56507462fd0eac83254aff7 2x, https://si.imgix.net/7f9a41a6/uploads/origins/26d49f49-1981-424b-a2a7-882d9bb53312?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f529d14702745cd630280f579de93bc2 3x", "genre": "comic", "nsfw": false, "body": "ttps://x.com/megapann/status/1968590418779513106\n\nこのイラストのシチュが刺さったので、漫画化してほしいです。\n真面目な感じの子が寄生されて思考をゆがめられてギャル化してオタクくんと接触して卵を産み付けるまでとその後。\nあと、この寄生された子は一生ギャルなままなのか、寄生解けた後は元に戻るのかとか、\nその辺も描写して欲しいです。出来ればオチはハッピーエンドで。", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/46", "thumbnail_src": "https://si.imgix.net/9035f3e0/uploads/origins/2ffe9a23-b096-4aed-a78b-420f4d3c4fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f29de9072bd271adabf02273455c79", "thumbnail_srcset": "https://si.imgix.net/9035f3e0/uploads/origins/2ffe9a23-b096-4aed-a78b-420f4d3c4fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65f29de9072bd271adabf02273455c79, https://si.imgix.net/9035f3e0/uploads/origins/2ffe9a23-b096-4aed-a78b-420f4d3c4fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b323a69000814d5d06c70c91e2e58da9 2x, https://si.imgix.net/9035f3e0/uploads/origins/2ffe9a23-b096-4aed-a78b-420f4d3c4fc0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14b07afa23f00c7d0ca1ddd83b7af2f6 3x", "genre": "art", "nsfw": false, "body": "初めまして。ジャンプでダビデ君を楽しく拝読させて頂いておりました。\n女の子の絵が更にめちゃくちゃ可愛く描かれてて\n\n巨大娘の納品をお見かけしたので、自分のOCもリクエストさせて頂きたいと思います…！\n\n自分の漫画「ジャイアントリトルシスター」の巨大化妹を描いて頂けないでしょうか。\n裸足で建物か乗り物などを踏みつけているところが見たいです。体のサイズは任意で大丈夫です。\n\n参考漫画（※ヒトミ先生の保健室20巻収録）\nhttps://x.com/shakekoujou/status/1970333502098006498\n\n参照イラスト\nhttps://www.pixiv.net/artworks/129944665\nhttps://www.pixiv.net/artworks/88722225\n\nどこかに「ジャイアントリトルシスター」または「GIANT LITTLE SISTER」のようにタイトルを入れていただけると幸いです。\n\nSNSの他、FANBOXで掲載・紹介させて頂きたいと思っています。\n\nご検討よろしくお願いいたします…！", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/45", "thumbnail_src": "https://si.imgix.net/4cd2d7ee/uploads/origins/b5076e47-cc6c-400d-b1a0-2a0028757d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=465ba9b2ddba9f4c5476cb9252ca4819", "thumbnail_srcset": "https://si.imgix.net/4cd2d7ee/uploads/origins/b5076e47-cc6c-400d-b1a0-2a0028757d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=465ba9b2ddba9f4c5476cb9252ca4819, https://si.imgix.net/4cd2d7ee/uploads/origins/b5076e47-cc6c-400d-b1a0-2a0028757d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c07da6068f05c5fe1a03d3d4fb1ef1b 2x, https://si.imgix.net/4cd2d7ee/uploads/origins/b5076e47-cc6c-400d-b1a0-2a0028757d4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7940f9a7f0c27d9411cac87ce7402e0 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/44", "thumbnail_src": "https://si.imgix.net/ee0ac607/uploads/origins/196ba1e6-f342-4a79-85ec-b51a09f698ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=475f20b0343a22bbd27715ad1f80516a", "thumbnail_srcset": "https://si.imgix.net/ee0ac607/uploads/origins/196ba1e6-f342-4a79-85ec-b51a09f698ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=475f20b0343a22bbd27715ad1f80516a, https://si.imgix.net/ee0ac607/uploads/origins/196ba1e6-f342-4a79-85ec-b51a09f698ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d312e5ec91d5f058a8ed1b4ce51da86 2x, https://si.imgix.net/ee0ac607/uploads/origins/196ba1e6-f342-4a79-85ec-b51a09f698ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=453dae6cb51acd09c89ffdfb1f6e1daa 3x", "genre": "comic", "nsfw": true, "body": "初めまして。\n絵柄にとても惹かれまして今回リクエストを送らせていただきました。\n不都合がなければお引き受けいただけますとありがたいです。\n\n【内容】\nブラウスの制服を着た幼児体型、黒髪ショートの女子高生がコンプレックスである体型を解消するために自作した薬を飲む。\n薬を飲み干したところで苦しみだすと髪がザワザワと伸びはじめ、背も伸び、胸が徐々に膨らんでゆき巨乳になり制服のボタンが弾け飛ぶ。\n呼吸が落ち着いたところでスタイルの良い姿になれたことに大喜びするが、成長によりサイズが合わなくなりあちこち破れた制服姿の自分を冷静に見て恥ずかしそうな顔で「服どうしよう…」とつぶやく。", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/43", "thumbnail_src": "https://si.imgix.net/87f4cfb2/uploads/origins/832a335e-7f2a-4745-8cb8-786f6f1d1555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8bbe9424ef6797c0e9de062ad60fc3b", "thumbnail_srcset": "https://si.imgix.net/87f4cfb2/uploads/origins/832a335e-7f2a-4745-8cb8-786f6f1d1555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8bbe9424ef6797c0e9de062ad60fc3b, https://si.imgix.net/87f4cfb2/uploads/origins/832a335e-7f2a-4745-8cb8-786f6f1d1555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50acb5907c92498e11bf2b283a6aab01 2x, https://si.imgix.net/87f4cfb2/uploads/origins/832a335e-7f2a-4745-8cb8-786f6f1d1555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f5dd0c64b9694bb11c5f417dcaf9dd3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/42", "thumbnail_src": "https://si.imgix.net/369aec83/uploads/origins/2588f4a9-5e4f-4ddc-8c56-389e8666108b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439a6bb7d871b5eea2a2d983b00ab3c3", "thumbnail_srcset": "https://si.imgix.net/369aec83/uploads/origins/2588f4a9-5e4f-4ddc-8c56-389e8666108b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=439a6bb7d871b5eea2a2d983b00ab3c3, https://si.imgix.net/369aec83/uploads/origins/2588f4a9-5e4f-4ddc-8c56-389e8666108b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb2a847a37eac6063842985202deca76 2x, https://si.imgix.net/369aec83/uploads/origins/2588f4a9-5e4f-4ddc-8c56-389e8666108b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7beef28ae8ec40ca4ef18ebbb7ceb287 3x", "genre": "art", "nsfw": false, "body": "初めてのリクエスト失礼します。\n\n・キャラクター\nVOICEROID CeVIOの「IA」\nhttps://www.pixiv.net/artworks/23353742\n\n・構図\nファン達の前でIAちゃんが巨人になって屋外ライブをやっている場面をお願いします。\n胸は黒木雄心様が過去に載せたチャイナ娘と同じ位に盛って貰えると幸いです。\nhttps://x.com/megapann/status/1967130840259064067\n\n\n以上になります。\nご検討の程よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/41", "thumbnail_src": "https://si.imgix.net/9764a336/uploads/origins/d6d5e566-3e58-4678-8411-16ea442512c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=428f01d91d30a4bd86b9d91faec8f145", "thumbnail_srcset": "https://si.imgix.net/9764a336/uploads/origins/d6d5e566-3e58-4678-8411-16ea442512c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=428f01d91d30a4bd86b9d91faec8f145, https://si.imgix.net/9764a336/uploads/origins/d6d5e566-3e58-4678-8411-16ea442512c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a2804f28320b058daeec897718ad3ff 2x, https://si.imgix.net/9764a336/uploads/origins/d6d5e566-3e58-4678-8411-16ea442512c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20100c723cc4bc802d8e19bbf0a60be5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/40", "thumbnail_src": "https://si.imgix.net/cbf28038/uploads/origins/193e56a7-ce93-442f-8518-4fed91a7982b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c35dafc48a13bd5ffbcb3ef28cb75083", "thumbnail_srcset": "https://si.imgix.net/cbf28038/uploads/origins/193e56a7-ce93-442f-8518-4fed91a7982b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c35dafc48a13bd5ffbcb3ef28cb75083, https://si.imgix.net/cbf28038/uploads/origins/193e56a7-ce93-442f-8518-4fed91a7982b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f52af2968ea700049eb9a09e07d5666d 2x, https://si.imgix.net/cbf28038/uploads/origins/193e56a7-ce93-442f-8518-4fed91a7982b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb9b5d1beb3bbcad1637df6916999abe 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/39", "thumbnail_src": "https://si.imgix.net/ce5c35a9/uploads/origins/59013570-80d7-4b7b-b3a7-c0117376be75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a56bc953ceb74c9d6d5f9ad1b890d0f", "thumbnail_srcset": "https://si.imgix.net/ce5c35a9/uploads/origins/59013570-80d7-4b7b-b3a7-c0117376be75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a56bc953ceb74c9d6d5f9ad1b890d0f, https://si.imgix.net/ce5c35a9/uploads/origins/59013570-80d7-4b7b-b3a7-c0117376be75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c6ff85b52a5ac7b07faf31ec43b47d1 2x, https://si.imgix.net/ce5c35a9/uploads/origins/59013570-80d7-4b7b-b3a7-c0117376be75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2393ea531003970595c612dd32c4b0ec 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n「Library of Ruina」のホッドちゃんの描画をお願いしたいのですが。気弱だけど一生懸命な女の子です。特にリクエストはないので、かわいく描いてください！\n\nありがとうございました", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/38", "thumbnail_src": "https://si.imgix.net/3174d64c/uploads/origins/3c336d25-12e1-4883-8217-dc184c7e3669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e513fb814c8533d8a9634a292584fe7", "thumbnail_srcset": "https://si.imgix.net/3174d64c/uploads/origins/3c336d25-12e1-4883-8217-dc184c7e3669?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e513fb814c8533d8a9634a292584fe7, https://si.imgix.net/3174d64c/uploads/origins/3c336d25-12e1-4883-8217-dc184c7e3669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62e7211718e38a98bb5019adb70bae61 2x, https://si.imgix.net/3174d64c/uploads/origins/3c336d25-12e1-4883-8217-dc184c7e3669?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43f43191d2d3c6f1a4c05ee69c65a4ca 3x", "genre": "art", "nsfw": false, "body": "初めまして、ホラー専門VTuberの奈々瀬ひかげと申します。\n「だぼだぼカーディガン」があまりに良かったため、リクエストいたします。\n色っぽさやツヤツヤ感、表情とても良かったです…\n「地球滅亡後初ラクガキ」の体のラインもとても良く「夏ですね」も良かったので、\nカラーイラストというよりああいった漫画のようなタッチだと嬉しいです。\n\n【用途】\n・使用は主にYoutube(収益化済)\n・FANBOXでの公開\n・各種SNSでの公開・アイコン使用\n\n服装・シチュエーションについてはお任せします。\nキャラクターのみの透過データをPSDまたはPNGにていただけますと幸いです。\nNGはございませんので好きに描いていただいて問題ありません。\n何卒ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JyvUPyAoNcOeYC-_26XL7RURdqmlF_aX?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/37", "thumbnail_src": "https://si.imgix.net/99c1c822/uploads/origins/0dd30740-b309-4f74-b318-cdbb968a8845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7f47ee3a85eea6917a3b05a535911bf", "thumbnail_srcset": "https://si.imgix.net/99c1c822/uploads/origins/0dd30740-b309-4f74-b318-cdbb968a8845?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7f47ee3a85eea6917a3b05a535911bf, https://si.imgix.net/99c1c822/uploads/origins/0dd30740-b309-4f74-b318-cdbb968a8845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2104845427f9c848cdaa221df0b5f372 2x, https://si.imgix.net/99c1c822/uploads/origins/0dd30740-b309-4f74-b318-cdbb968a8845?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27cab5b2ec8a1353a6c7c182a55a05bc 3x", "genre": "art", "nsfw": false, "body": "連続のリクエストになって申し訳ありません。\nもう一人、va-livのメンバーの上水流宇宙（かみずる　こすも）さんを描いていただきたく、リクエストを送らせていただきます。\n\n彼女は最近、ASMRに本格的に取り組みはじめているので、画面に向かって囁きかけるようなイメージのイラストをお願いできますでしょうか？\n\n衣装は、下記のイメージのような感じだと嬉しいですが、お任せします。下記の衣装で描いていただける場合でも、細部に関してはこだわりません。\n\nイメージ　https://x.com/valiv_official/status/1834239234313769090\n\nイラスト全体のテイストは、先生が最近XにアップされていたAniちゃんのような感じだと嬉しいです。構図などはお任せいたします。\n\n【使用用途】\n・自分のSNSに「#宇宙の輝き」というタグつきでアップロードさせていただきたいです（その際は、描いていただいた旨と、Xのアカウントを併記させていただきます）。\n・現在のところ予定はありませんが、個人の利用の範囲でグッズを作成するかもしれません（可能性としては、ポスターやアクリルスタンドを作成し、本人に送るなど。販売や頒布はいたしません）。\n・本人が配信のサムネイル等で使用するかもしれません。その際、所属事務所の方針で名前などが表記されないので、問題を感じるようであればキャンセルしていただいて構いません。\n・上記の理由から、可能であればサインなどがない、透過したファイルも納品いただけると嬉しいです。\n\n何卒、よろしくお願いいたします。\n\nva-livファンメイドコンテンツポリシー\nhttps://idolmaster-official.jp/va-liv/policy\n※Skebでのイラスト依頼は、他のファンの方も行っているので、問題ないという認識です。\n\nhttps://idolmaster-official.jp/va-liv/cosmo", "created_at": "", "completed_at": ""}, {"path": "/@megapann/works/36", "thumbnail_src": "https://si.imgix.net/f0a547a9/uploads/origins/d5dbb4b4-ff03-4da5-a484-06c197ea425a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bee7c14b2426bd5d714fb2bcc6c8c189", "thumbnail_srcset": "https://si.imgix.net/f0a547a9/uploads/origins/d5dbb4b4-ff03-4da5-a484-06c197ea425a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bee7c14b2426bd5d714fb2bcc6c8c189, https://si.imgix.net/f0a547a9/uploads/origins/d5dbb4b4-ff03-4da5-a484-06c197ea425a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e6c7953f0e14ff63