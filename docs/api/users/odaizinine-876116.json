/17e8EBjXYfD_rSNoF55uc25wDK_61th9I/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@odaizinine/works/6", "thumbnail_src": "https://si.imgix.net/6b0b64d1/uploads/origins/592ae49a-44ea-4ae4-99f7-c32bdb6b3f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69494d859373199a0567b3f0150deef", "thumbnail_srcset": "https://si.imgix.net/6b0b64d1/uploads/origins/592ae49a-44ea-4ae4-99f7-c32bdb6b3f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69494d859373199a0567b3f0150deef, https://si.imgix.net/6b0b64d1/uploads/origins/592ae49a-44ea-4ae4-99f7-c32bdb6b3f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13bc2253aea78ea696b6346b6e6d3b2c 2x, https://si.imgix.net/6b0b64d1/uploads/origins/592ae49a-44ea-4ae4-99f7-c32bdb6b3f1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d84909a4ff6d9b59eadb96a3cb6da087 3x", "genre": "art", "nsfw": false, "body": "きりしまさんこんにちは！　はじめてリクエストさせていただきます。\n私のオリジナルキャラクターを描いていただきたいです！\n\nビジュアルは以下の画像をご参照ください（設定画等でなくすみません……！）\nhttps://twitter.com/sh1nohara/status/1494484846777081856?s=20&t=jQauLBhotxWMxacNhnPRkA\n\n怪異と戦う部署で働いている市役所職員ですが、泣き虫でよくケガをしている内気な女の子です。絆創膏やおくすりなどをちりばめて、きりしまさんカラーに染めていただけるとうれしいです……！！！\nどうぞよろしくお願いします～！", "created_at": "", "completed_at": ""}, {"path": "/@odaizinine/works/5", "thumbnail_src": "https://si.imgix.net/a9cc2a4f/uploads/origins/89edb273-9310-4e81-981e-5689f268f0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77500d9acdc9eaf207ed8bef45465314", "thumbnail_srcset": "https://si.imgix.net/a9cc2a4f/uploads/origins/89edb273-9310-4e81-981e-5689f268f0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77500d9acdc9eaf207ed8bef45465314, https://si.imgix.net/a9cc2a4f/uploads/origins/89edb273-9310-4e81-981e-5689f268f0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a6608e4d41550c661da28887dbbb502 2x, https://si.imgix.net