e4-ba6a-7e72fa5830d7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=843ae81e0f0944d397f43a3fd57d6d6d 2x, https://si.imgix.net/3d7fbd1e/uploads/origins/7943697b-466d-49e4-ba6a-7e72fa5830d7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=6079a505f97efc610a0ad1ff61827f45 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！前作に引き続き、ありがとうございました！\n\nこの2人のオリジナルキャラのピクセルアートをまたお願いしてもいいのでしょうか？\n\n今回は、中世ゴシックファンタジー風の衣装で、ヴァンパイアとヴァンパイアハンターの設定で、悪魔城ドラキュラやブラッドボーンなどを彷彿とさせるようなデザインをお願いしたいです。\n(参考資料の現在の現代的な衣装は無視してください。彼らの新しい衣装のデザインをお願いします。例）https://drive.google.com/file/d/1_TjpCDNRfuIqYSnsyzPs4NrCBCdHvF_9/view?usp=sharing\nただし、この例を使う必要はありません)。\n\nアロイス\n180cm。金髪の男性。痩せ型。\nおしゃべりでお茶目な性格で、ずるがしこい。普段の表情は満面の笑み。\nヴァンパイアハンターとして旅をしている。武器は伝統的な杭。\n\nゲイブ\n186cm。グレーヘアーの男性。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、密かに非常に危険な人物でもある。\n彼はヴァンパイアである。天文学の勉強も好き。\n\n今回は、2人が戦っているシーンを描いてください。お互いに戦っているところです。\nゲイブの姿勢はとても落ち着いていて自信に満ちているように見え、威嚇しています\nアロイスはもっとエネルギッシュです。\n可能であれば、少しアニメーションをつけていただけませんでしょうか？\n\nいずれにせよ、このリクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Fbbu_xaIu2Om7r4oH4BxG5OzxqK-qHC7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@satozz/works/2", "thumbnail_src": "https://si.imgix.net/98660a32/uploads/origins/5b30202a-3611-447d-be3e-48293e06b634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e01d9374cea5001da797eac1440e31c", "thumbnail_srcset": "https://si.imgix.net/98660a32/uploads/origins/5b30202a-3611-447d-be3e-48293e06b634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e01d9374cea5001da797eac1440e31c, https://si.imgix.net/98660a32/uploads/origins/5b30202a-3611-447d-be3e-48293e06b634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfce3ad9a810fd7f4b1dcdf3864fb828 2x, https://si.imgix.net/98660a32/uploads/origins/5b30202a-3611-447d-be3e-48293e06b634?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59be610ba96040ff47b8357a19f046ca 3x", "genre": "art", "nsfw": false, "body": "初めまして。\npixivなどで作品を拝見し、クールで重厚感のあるドット絵に惹かれました！\n\nもしご都合よろしければ、下記のOC二人のドット絵をお願いしたいです。\nhttps://drive.google.com/drive/folders/1nGRW2QPo2PG0-Fh07kjW5JkCQyFLBCyk\n\n■キャラクター詳細\n二人とも26歳です。\nクトゥルフ神話TRPGで使うキャラクターです。\n都会の夜が似合う二人で、神話生物と戦うことがあります。\n\n▼青髪： 王賀(おうが)\n殺し屋/身長185cm/虚弱で細身/ノリが軽くよく笑う。道徳観に欠けており破壊的\n拳銃やライフルなど銃火器を扱います。\n\n▼黒髪：樋野(ひの)\n探偵/身長180cm/やや筋肉質/堅実で生真面目。表情が硬く口数も少ない。保守的\n柔道など体術を使います。\n\n■内容\n可能であれば、下記のようなかっこいいアクションポーズをお願いできるでしょうか。\nhttps://skeb.jp/@satozz/works/1\n\n■用途\nいただいた作品は個人での鑑賞のほか、佐藤さんのお名前を記載の上、趣味の範囲でTwitterのヘッダーやアイコンに使用させていただければと思います。\n\n―――――\n\nここまで読んでいただき誠にありがとうございました！\n先生のドット絵がとても好きなので、お時間ありましたら何卒ご検討いただけると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@satozz/works/1", "thumbnail_src": "https://si.imgix.net/0e5138e0/uploads/origins/b51ba97b-b550-41eb-986d-1b4ef0999a75?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2f3dd2ad05a4be6095d3adde869c9315", "thumbnail_srcset": "https://si.imgix.net/0e5138e0/uploads/origins/b51ba97b-b550-41eb-986d-1b4ef0999a75?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2f3dd2ad05a4be6095d3adde869c9315, https://si.imgix.net/0e5138e0/uploads/origins/b51ba97b-b550-41eb-986d-1b4ef0999a75?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fecf0a19531784be97a4a23c6b4e2e6 2x, https://si.imgix.net/0e5138e0/uploads/origins/b51ba97b-b550-41eb-986d-1b4ef0999a75?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=38be98d721c17c23f809167629f63f45 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたのアートはとてもクールです！\n\nこの2人のキャラクターのピクセルアートイラストを描いていただけませんか？この2人は、現代のTRPG「Call of Cthulhu（CoC）」の設定に登場します。ヒーローとヴィランのダイナミックさがあります。\n\nアロイス\n180cm。金髪の男性。とても痩せている。\n性格はおしゃべりでやんちゃでずるがしこい。普段の表情は満面の笑み。\n超自然的な脅威と戦う組織の一員。\n\nゲイブ\n186cm。グレーヘアーの男性。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、密かに非常に危険な人物でもある。\n物語の悪役である。\n\n一緒にアクションポーズをとっているところを描いてください。ミーゴなどのラブクラフト系モンスターと一緒に戦うためのものです。\n可能であれば、簡単なアニメーションもお願いします。\n\nいずれにせよ、このリクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mXKC_rlghyqgATsf5ty5CzcUQrC0nfwE?usp=share_link", "created_at": "", "completed_at": ""}]}