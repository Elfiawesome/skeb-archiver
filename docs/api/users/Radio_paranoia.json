b-8b02-d52ceadcce44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48bbca585a0c9b0b7a6d4e5bafcc9b5e", "thumbnail_srcset": "https://si.imgix.net/0f14309e/uploads/origins/96332988-7f6a-4f7b-8b02-d52ceadcce44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48bbca585a0c9b0b7a6d4e5bafcc9b5e, https://si.imgix.net/0f14309e/uploads/origins/96332988-7f6a-4f7b-8b02-d52ceadcce44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e84a5fc8b4641e1144806ebc86732186 2x, https://si.imgix.net/0f14309e/uploads/origins/96332988-7f6a-4f7b-8b02-d52ceadcce44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fe5a0d2c789e822ccaf0e48eb02e557 3x", "genre": "art", "nsfw": true, "body": "こんにちは。このシリーズのキャラクター2人を描いていただけますか？参考画像をご覧ください。黒人の瑠璃さんが先生/恋人にアナルフィストファックをしているシーンを描いてほしいです。先生はスクワットポーズです。瑠璃さんの腕は汚れていて、先生の糞まみれです。できれば、絵の後に肛門脱のシーンも描いてください。よろしくお願いします。\n\nhttps://www.pixiv.net/en/artworks/11847622", "created_at": "", "completed_at": ""}, {"path": "/@Radio_paranoia/works/36", "thumbnail_src": "https://si.imgix.net/7dbc5d37/uploads/origins/1956f64b-7a59-462e-82a6-7f2f4c193492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb21bf21b0bcffdf230f46b31c6bfd66", "thumbnail_srcset": "https://si.imgix.net/7dbc5d37/uploads/origins/1956f64b-7a59-462e-82a6-7f2f4c193492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb21bf21b0bcffdf230f46b31c6bfd66, https://si.imgix.net/7dbc5d37/uploads/origins/1956f64b-7a59-462e-82a6-7f2f4c193492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eda6d12dc586452b9b3fb45a1686e221 2x, https://si.imgix.net/7dbc5d37/uploads/origins/1956f64b-7a59-462e-82a6-7f2f4c193492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36465df0a779d9ce23225055615f5098 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です、いつも作品楽しみにしております。\n\n下記内容でお願いします。\n\n【キャラクター】\nわたモテの黒木智子・田村ゆり・根元陽菜(3人が無理