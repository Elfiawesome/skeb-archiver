お願いしたいです\n\n.𖥔 ݁詳細\n白うさぎがモチーフのお昼寝だいすきな女の子、うさぎと宇宙がモチーフの元気いっぱいな女の子の2人組です\nそれぞれ外見の詳細は資料に記載しております！\n\n.𖥔 ݁使用用途\nSNSのアイコンやキャラクターシートへの掲載\n個人用にアクスタの作成を考えています\n\n\nご縁がありましたらよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1viqtRWwn3GTpHOrL56izkOB10UoSaMiw", "created_at": "", "completed_at": ""}, {"path": "/@popotowari/works/2243", "thumbnail_src": "https://si.imgix.net/502542f6/uploads/origins/733b4a05-538c-40d1-addc-bfe4ab954d19?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0506a0503feb57336a9036775de2ce7f", "thumbnail_srcset": "https://si.imgix.net/502542f6/uploads/origins/733b4a05-538c-40d1-addc-bfe4ab954d19?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0506a0503feb57336a9036775de2ce7f, https://si.imgix.net/502542f6/uploads/origins/733b4a05-538c-40d1-addc-bfe4ab954d19?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76a29bb92d8275823ca690b0159b773e 2x, https://si.imgix.net/502542f6/uploads/origins/733b4a05-538c-40d1-addc-bfe4ab954d19?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=188182590a07902d97e92c7ed1d924e5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@popotowari/works/2242", "thumbnail_src": "https://si.imgix.net/6b47a57d/uploads/origins/cf126986-74bc-4ce6-8bab-029b074fe073?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dbc14bb7c18286b8ac5636223a473650", "thumbnail_srcset": "https://si.imgix.net/6b47a57d/uploads/origins/cf126986-74bc-4ce6-8bab-029b074fe073?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dbc14bb7c18286b8ac5636223a47