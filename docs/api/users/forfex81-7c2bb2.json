ploads/origins/4c7fbe17-20da-401d-9956-b95128a7beb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4036b16060ac319a62a0d4c9828d2383 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@forfex81/works/36", "thumbnail_src": "https://si.imgix.net/12f4cc3a/uploads/origins/dd8cbf6a-9907-4cc8-8469-29a82cb20a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec86e95f367a1ceac50ab19bf1ccd262", "thumbnail_srcset": "https://si.imgix.net/12f4cc3a/uploads/origins/dd8cbf6a-9907-4cc8-8469-29a82cb20a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec86e95f367a1ceac50ab19bf1ccd262, https://si.imgix.net/12f4cc3a/uploads/origins/dd8cbf6a-9907-4cc8-8469-29a82cb20a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7345f4ef3a527579db66a95a48ebdff1 2x, https://si.imgix.net/12f4cc3a/uploads/origins/dd8cbf6a-9907-4cc8-8469-29a82cb20a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63693ac7307477216154b855f27bf797 3x", "genre": "art", "nsfw": false, "body": "十厭厽 医 様  初めまして。\n\n読書好き元人魚Vtuberとして活動しています、歌方しずくと申します。 かねてよりTwitterをフォローさせていただいておりまして、今回歌方自身のイラストをお願いしたく、リクエストをお送りいたしました。  \n\n構図、服装、髪型、色合いなど、全てお好きなようにお描きいただけたら嬉しいです。  またVtuberとして活動しているため、可能でしたらYouTubeのサムネ等での使用許可を頂けたら幸いです。 使用する際は十厭厽 医様の名前をクレジット表記するほか、収益を得る形での利用はいたしません。\n\n  資料としてTwitterの固定ツイートのURLをお送りいたします。デフォルトの衣装の画像がいくつか載っていますので、イメージの参考になれば幸いです。ご検討のほど何卒よろしくお願いいたします。\n\nhttps://twitter.com/shizuku_mermaid/status/1474149121552687109?s=21", "created_at": "", "completed_at": ""}, {"path": "/@forfex81/works/35", "thumbnail_src": "https://si.imgix.net/12fc7c2e/uploads/origins/8d4ed3aa-52db-4ac3-a2f2-ac561ed78b83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fbe19eb890fd7af66e4c3e53b8aa952", "thumbnail_srcset": "https://si.imgix.net