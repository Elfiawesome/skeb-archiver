の暴言、腹ボコや喉ボコ、殴打、チンカス掃除、タバコの灰皿にされる、開口機や全頭マスク鼻フック、子宮潰れるぅ的な描写等の尊厳破壊するような無様なことされるのが好きです\n胸や乳首を乱暴に扱う描写が好きなのでねじったり抓ったりビンタ、洗濯バサミやリング等の道具、握り潰したり噛み跡つけたり痛そうな事があると嬉しいです\nエグいアへ顔、白目向きそうなイキ顔、食いしばって痛がる、ブサイクなグポグポ必死なフェラ顔、無様にンホ声オホ声等の表情が崩れるのも大好きです\n\nNGないので無様でハードな内容だと嬉しいです\n\n欲望を書きなぐってしまいすみません\n上記は本当に参考程度無視でも問題ないです\n気に入らない場合全く関係なくても大丈夫ですのでおまかせで自由に描いて頂けるとありがたいです\nもし金額的に大丈夫なら数ページの漫画のような形で描いて頂けないでしょうか", "created_at": "", "completed_at": ""}, {"path": "/@NewTsunapiko/works/24", "thumbnail_src": "https://si.imgix.net/7fb28e8e/uploads/origins/7f82f177-bdf8-4b11-9a68-fe1e3bade51e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b0aa33284912d7da99d4a8a3fa36af7", "thumbnail_srcset": "https://si.imgix.net/7fb28e8e/uploads/origins/7f82f177-bdf8-4b11-9a68-fe1e3bade51e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b0aa33284912d7da99d4a8a3fa36af7, https://si.imgix.net/7fb28e8e/uploads/origins/7f82f177-bdf8-4b11-9a68-fe1e3bade51e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7e9c477349e5aa8a8d13140f08db8c0 2x, https://si.imgix.net/7fb28e8e/uploads/origins/7f82f177-bdf8-4b11-9a68-fe1e3bade51e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ecc6e42d9a3118b7291a550aea8e6ca 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@NewTsunapiko/works/23", "thumbnail_src": "https://si.imgix.net/e68921a6/uploads/origins/8fe69d62-d21c-4b4b-993f-a2934f8205c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle