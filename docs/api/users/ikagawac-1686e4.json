cfa-aa7e-3abda9900de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9fb930fc3aab101e50c3e13b3a8df27 2x, https://si.imgix.net/540c7033/uploads/origins/b89fb082-c9aa-4cfa-aa7e-3abda9900de1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46787992ffcc74e8a8e1654ffbdf59e0 3x", "genre": "art", "nsfw": true, "body": "VTuberのがうる・ぐらとsabaちゃんとの3P(？)を描いて欲しいです。\n\n散々に犯して孕ませたぐらちゃん(ボディ)の母乳を吸いつつ、魂を移行させた先のsabaちゃんが正常位でガツガツ犯されてるシチュエーションでお願いします。\n\n2人とも全裸で、ぐらちゃんはsabaちゃんの頭上で頭を挟むようにして膝立ちして、前のめりの男に乳を吸わせてください。軽めのボテ腹で、妊娠により乳房も少し大きくなっていて、両乳から母乳を垂らしてください。意識(魂)がsabaちゃんに移行してるのでぐらちゃんはぐったりして意識がありません。\n\nsabaちゃんは正常位で犯されながら、頭上のぐらの膣から溢れ出る精液を口を開けて受け止めさせられており、涙目で絶望的な表情、嫌がる表情をさせてください。\n\n男は片手はsabaちゃんの手を押さえ付けて、片手でぐらちゃんを抱き寄せてる感じです。\nsabaちゃんの空いた手は男を押し退けようと無駄な抵抗してる感じにして欲しいです。半ば諦めながら気持ちばかりの抵抗してるイメージです。\n\n男は透過あると助かります\n\nよければよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@ikagawac/works/56", "thumbnail_src": "https://si.imgix.net/716f115a/uploads/origins/5f5f5026-241f-4a78-9d6b-3ee14ec89a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=800bc1f6f7251116304f3f0ee0254e43", "thumbnail_srcset": "https://si.imgix.net/716f115a/uploads/origins/5f5f5026-241f-4a78-9d6b-3ee14ec89a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=800bc1f6f7251116304f3f0ee0254e43, https://si.imgix.net/716f115a/uploads/origins/5f5f5026-241f-4a78-9d6b-3ee14ec89a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab92702b8df61108c12083c4177c9edd 2x, https://si.imgix.net/716f115a/uploads/origins/5f5f5026-241f-4a78-9d6b-3ee14ec89a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc3d2271620ddb2519f7c336a98018f2 3x", "genre": "art", "nsfw": true, "body": "こんにちは、今回もストリートファイターのカリンとローラのアートワークをお願いします！\n\nカリン (160cm) https://photos.app.goo.gl/hHpJGciuFwQMvD857\n\nラウラ (175cm) https://photos.app.goo.gl/iTWuvkQcVfgcR7U7A\n\nローラはフタナリ\n\nかりんちゃんを思いっきり犯し、子宮の奥まで巨根で犯しまくるローラちゃん\n\nこれは参考ポーズです。ご自由に解釈してください。https://photos.app.goo.gl/r4WufaKD9cBPkipc6\n\n衣装はお好きなものを選んでください。かりんの髪のデザインにもご注目ください。", "created_at": "", "completed_at": ""}, {"path": "/@ikagawac/works/55", "thumbnail_src": "https://si.imgix.net/2cd15c44/uploads/origins/629c474c-69e4-40c3-9d9f-5403352cf5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d44a5c59f9135baf5937b7b63dde9bd", "thumbnail_srcset": "https://si.imgix.net/2cd15c44/uploads/origins/629c474c-69e4-40c3-9d9f-5403352cf5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d44a5c59f9135baf5937b7b63dde9bd, https://si.imgix.net/2cd15c44/uploads/origins/629c474c-69e4-40c3-9d9f-5403352cf5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be1e0deb50e4667b3f5e1ace61e4e328 2x, https://si.imgix.net/2cd15c44/uploads/origins/629c474c-69e4-40c3-9d9f-5403352cf5dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=139563af7e15c15d31e99e5e7dc4ac80 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ikagawac/works/54", "thumbnail_src": "https://si.imgix.net/40a2867a/uploads/origins/4f70fd90-297c-434c-8476-8687faa33822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fd40bcdac3e1828d839637af46c66f4", "thumbnail_srcset": "https://si.imgix.net/40a2867a/uploads/origins/4f70fd90-297c-434c-8476-8687faa33822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fd40bcdac3e1828d839637af46c66f4, https://si.imgix.net/40a2867a/uploads/origins/4f70fd90-297c-434c-8476-8687faa33822?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e00c7ec2f8c11b2794789969c240cac 2x, https://si.imgix.net/40a2867a/uploads/origins/4f70fd90-297c-434c-8476-8687faa33822?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=667b5d5bb940dd22a538e618197ee754 3x", "genre": "art", "nsfw": true, "body": "イカガワCさん、こんにちは。\npixivでタグ化されている、「モルゲッソヨ化」というジャンルを知っていますか？(頭に金属の物体をかぶせられてふたなりチンコを勃起し、全裸・起立の姿勢で固定させられて射精しながら金属化していくシチュエーションです。)\n\nこのモルゲッソヨ化をホロ○イブのフブみ○めっとさんの３人で見たいのでリクエストします。\n\nシチュ:\nフブみ○めっとさんが案件企画として美術館に誘われる。美術館には元ホ○メンと思わしきモルゲッソヨと、隣に展示された衣装がチンコを勃起させて射精していた。\n３人が気持ち悪がっていると、頭上からモルゲッソヨキャップに襲われて侵食が始まり、ふたなりチンコから射精しながらオブジェ化する。\n\n後日、ま○り、お○ゆなどの下ネタが好きなホ○メンが美術館に訪れ、３人のモルゲッソヨを見て、まさか本人だとは思わずにチンコや玉袋を触って射精させて楽しんでしまう。\n\nフブ○ッソヨ\n美乳　\n頭の被り物にケモ耳がつく\n\nすいせッソヨ\n貧乳\n乳首がツンツン\n\nみこッソヨ\nデカ乳\nデカチンコ\n\n３人ともいつもの衣装だが、モルゲッソヨの侵食で全裸にひんむかれて横に展示される。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ikagawac/works/53", "thumbnail_src": "https://si.imgix.net/df59cb7d/uploads/origins/c323bcef-bf49-4508-a6ef-c0ec3610e2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1452037ab72e110e2173684d639e37b4", "thumbnail_srcset": "https://si.imgix.net/df59cb7d/uploads/origins/c323bcef-bf49-4508-a6ef-c0ec3610e2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1452037ab72e110e2173684d639e37b4, https://si.imgix.net/df59cb7d/uploads/origins/c323bcef-bf49-4508-a6ef-c0ec3610e2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6a805fd92f29069b0653236040ba1cd 2x, https://si.imgix.net/df59cb7d/uploads/origins/c323bcef-bf49-4508-a6ef-c0ec3610e2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&d