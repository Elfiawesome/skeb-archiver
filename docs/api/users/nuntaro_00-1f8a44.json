ドの精液を朝食にしようと強制射精させてカップに注がせているシチュ。\n全裸で後ろ手に縛られたアルフレッドが、アナルに差し込まれたバイブの刺激でメスイキして勃起無しでカップに垂らして入れてるペニスからトプトプ吐精しているイメージですが、その辺りは先生のお好みでOKです。\nなお、レネ将軍は作画負担軽減の為に描写無しか、裸で構いません。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@nuntaro_00/works/19", "thumbnail_src": "https://si.imgix.net/a941d781/uploads/origins/f54b5466-31c8-4b4f-b873-a1798cb5c349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d49714b82e98a61c24aa8474ea44f28", "thumbnail_srcset": "https://si.imgix.net/a941d781/uploads/origins/f54b5466-31c8-4b4f-b873-a1798cb5c349?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d49714b82e98a61c24aa8474ea44f28, https://si.imgix.net/a941d781/uploads/origins/f54b5466-31c8-4b4f-b873-a1798cb5c349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11b4d21859392499558ad0005e511d21 2x, https://si.imgix.net/a941d781/uploads/origins/f54b5466-31c8-4b4f-b873-a1798cb5c349?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=877a2d01b2710c3581e9fe363cae420f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nuntaro_00/works/18", "thumbnail_src": "https://si.imgix.net/6df2383f/uploads/origins/11997668-5e97-4656-87d2-a2f64ac236f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6151821fb22aef34de3adff94871928", "thumbnail_srcset": "https://si.imgix.net/6df2383f/uploads/origins/11997668-5e97-4656-87d2-a2f64ac236f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6151821fb22aef34de3adff94871928, https://si.imgi