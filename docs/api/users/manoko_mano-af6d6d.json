=be7e41fad95f73d8d3031af1ac08aba5 2x, https://si.imgix.net/4259ccad/uploads/origins/c1a38160-be73-4998-8564-32632007f9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=869e0e0e637428d59759880b49763f79 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/34", "thumbnail_src": "https://si.imgix.net/39c6c5aa/uploads/origins/5babc5a4-0e2c-4f00-82d2-2dfdb835fdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58fb8b60983b842f97338f89ef53d3c5", "thumbnail_srcset": "https://si.imgix.net/39c6c5aa/uploads/origins/5babc5a4-0e2c-4f00-82d2-2dfdb835fdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58fb8b60983b842f97338f89ef53d3c5, https://si.imgix.net/39c6c5aa/uploads/origins/5babc5a4-0e2c-4f00-82d2-2dfdb835fdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79805e7af40f2407d10f37520382e591 2x, https://si.imgix.net/39c6c5aa/uploads/origins/5babc5a4-0e2c-4f00-82d2-2dfdb835fdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7f7c82115820752f5edbb562edf901a 3x", "genre": "art", "nsfw": false, "body": "狛乃様、お世話になっております🌸✨ウルラパ・ｩ・ぱあちです🐰🛌\n この度は、私自身のイラストを依頼したいです🙇🏻‍♀️\n  使用用途：YouTube（サムネ、プロフィール、動画や配信内での使用）、X（アイコンやヘッダー、投稿での使用）で使用させていただく予定です。 本人資料：（https://x.com/suya_zzz_pachi/status/1872584862210859492） \n今回は狛乃様の思うがままに私のことを描いていただきたいです！衣装もお任せいたします🐰🌸サイズは16:9の横型でお願いいたします🙇🏻‍♀️ \n耳がぱつんと切れないようにしていただきたいです！ 背景と人物で分けれるようにしていただけますと幸いです🙇🏻‍♀️ ご検討の方をよろしくお願いします🙌🏻✨\n\nhttps://x.com/suya_zzz_pachi/status/1872584862210859492", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/33", "thumbnail_src": "https://si.imgix.net/7ba5a0f2/uploads/origins/d8181217-545b-42d2-b254-19b748237485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235e6f5f74a068053545a8d9fb67ca2b", "thumbnail_srcset": "https://si.imgix.net/7ba5a0f2/uploads/origins/d8181217-545b-42d2-b254-19b748237485?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235e6f5f74a068053545a8d9fb67ca2b, https://si.imgix.net/7ba5a0f2/uploads/origins/d8181217-545b-42d2-b254-19b748237485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=849aaba306fc6a3a958394dceee31d6d 2x, https://si.imgix.net/7ba5a0f2/uploads/origins/d8181217-545b-42d2-b254-19b748237485?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fa8807035f8382fd1eb56b35d349d27 3x", "genre": "art", "nsfw": false, "body": "hello, i really loved all the works you've done for me before !! i was hoping you could draw a reference sheet of my oc. here is the outfit! please include both hair styles as before. do not include the pet.  please include her eyepatch! thank you!!\n\nref: https://drive.google.com/drive/folders/1uF9YfhVF8dtcNKyOYIoXnpvJbjAT6z8I?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/32", "thumbnail_src": "https://si.imgix.net/de4c1225/uploads/origins/453b69f1-8f0e-4b63-b289-844d518ddf14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe590125409405633e25c2e96aba6bfa", "thumbnail_srcset": "https://si.imgix.net/de4c1225/uploads/origins/453b69f1-8f0e-4b63-b289-844d518ddf14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe590125409405633e25c2e96aba6bfa, https://si.imgix.net/de4c1225/uploads/origins/453b69f1-8f0e-4b63-b289-844d518ddf14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86e2fb0765a1ab53ab0dbfb5386d4e9b 2x, https://si.imgix.net/de4c1225/uploads/origins/453b69f1-8f0e-4b63-b289-844d518ddf14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=946e5440aa2da3634fc61a60130bcbdf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/31", "thumbnail_src": "https://si.imgix.net/d1c24966/uploads/origins/1d294dc1-0698-4672-8584-f32c83f71dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48215b090d2b099d1aa7b228e99f0e98", "thumbnail_srcset": "https://si.imgix.net/d1c24966/uploads/origins/1d294dc1-0698-4672-8584-f32c83f71dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48215b090d2b099d1aa7b228e99f0e98, https://si.imgix.net/d1c24966/uploads/origins/1d294dc1-0698-4672-8584-f32c83f71dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c15a67680e86b649b6ef8d7dd8b17c6 2x, https://si.imgix.net/d1c24966/uploads/origins/1d294dc1-0698-4672-8584-f32c83f71dfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5806efb2a068eef81fc3d43f6262aa57 3x", "genre": "art", "nsfw": false, "body": "とても素敵なイラストと衣装デザインで、いつか絶対に依頼したいと思っていました!!\n今回はプリパラというアイドルアニメの私のocの衣装デザインをして頂きたいです!\n\nリンク先にざっとしたコテキャの見た目はまとめてあります߹-߹💖\n衣装デザインにテーマにして欲しいのがあります!\n青のクリームソーダ×海をモチーフとしたかわいい衣装にして頂きたいです!! (クリームソーダがメインで，海要素は少なくても大丈夫です!)プラスで衣装のどこかにワンポイントで(･∞･)↩︎こんな感じの顔したアザラシのマスコットのようなものも取り入れて頂きたいです!\n\nそしてこれはもし出来たらで良いのですが、この世界のアイドル達はマイクにその子モチーフのマイクがあります！なので良ければocモチーフのマイクも考えて頂きたいです…!!(他キャラ達のマイクはリンク先の資料に載せてあります！)\n\n長くなり申し訳ありません!߹-߹ご検討よろしくお願い致します🌟\nhttps://drive.google.com/drive/folders/10h3KaQWw6c3zEos97fbgDyVMyYmkO03T\n\nhttps://drive.google.com/drive/folders/10h3KaQWw6c3zEos97fbgDyVMyYmkO03T", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/30", "thumbnail_src": "https://si.imgix.net/5a3dec19/uploads/origins/f9564434-d60a-4b0a-8bf3-6f9e3bc2f17b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=229622b68fb9b3354a2d5f53c0abbca7", "thumbnail_srcset": "https://si.imgix.net/5a3dec19/uploads/origins/f9564434-d60a-4b0a-8bf3-6f9e3bc2f17b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=229622b68fb9b3354a2d5f53c0abbca7, https://si.imgix.net/5a3dec19/uploads/origins/f9564434-d60a-4b0a-8bf3-6f9e3bc2f17b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f9580a5209cf447e0e0f0fcbf3edb36 2x, https://si.imgix.net/5a3dec19/uploads/origins/f9564434-d60a-4b0a-8bf3-6f9e3bc2f17b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6a5ddbcaf65aff7aa632e1d10d070fa 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして！私のリクエストは、私のキャラクターのリデザインを手伝ってほしいです。\n\nhttps://sta.sh/01oztcx84xu0\n彼女の目を赤から黄色に変えてください。\n\n服装も一新したいです。(ファンタジーやリーガルにインスパイアされた何か？)または私はこだわらない！信頼しています！\n\nhttps://sta.sh/027kxeeqa5jp。\n(参考にカラーパレットもつけました。\n\n髪の色を少し変える。\n\n私は青が好きだが、彼女の新しい衣装／外見全体に、黒や濃い色合いの青、あるいはロイヤルブルーのバリエーションも加えてほしい。でも、全体的には青が彼女のデザインの主要な部分であってほしい)\n\n 彼女が持っている蝶のモチーフが好きなので、それは残してほしい。脚の蝶とか。あれはクールだと思う！\n\n彼女の衣装だけなんだ。彼女のために何か新しいものを作ってあげたい！\n\n検討してくれてありがとう！曖昧すぎたらごめんなさい！😭", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/29", "thumbnail_src": "https://si.imgix.net/613026d9/uploads/origins/e67691ff-98fd-4167-861e-786f082ff7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6f0c889aee79a766dc1ad324faa74e2", "thumbnail_srcset": "https://si.imgix.net/613026d9/uploads/origins/e67691ff-98fd-4167-861e-786f082ff7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6f0c889aee79a766dc1ad324faa74e2, https://si.imgix.net/613026d9/uploads/origins/e67691ff-98fd-4167-861e-786f082ff7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35da0c07d94d046ea6aceb5996e7ea6f 2x, https://si.imgix.net/613026d9/uploads/origins/e67691ff-98fd-4167-861e-786f082ff7c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70bb073d8fc89fad08e25b2dd2b6fb64 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/28", "thumbnail_src": "https://si.imgix.net/ee94f519/uploads/origins/5f3da648-89f1-436e-81fe-e5ad3b35e4cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fbf7921dcd60b6f2edc24d26e90dfbf", "thumbnail_srcset": "https://si.imgix.net/ee94f519/uploads/origins/5f3da648-89f1-436e-81fe-e5ad3b35e4cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fbf7921dcd60b6f2edc24d26e90dfbf, https://si.imgix.net/ee94f519/uploads/origins/5f3da648-89f1-436e-81fe-e5ad3b35e4cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b916ea0d5be433deb252cc74b8b4ca9b 2x, https://si.imgix.net/ee94f519/uploads/origins/5f3da648-89f1-436e-81fe-e5ad3b35e4cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a68de4ea2e50d39485095ddd6b869084 3x", "genre": "art", "nsfw": false, "body": "Hello! I think your art is very cute, so I would like to commission you!\n\nCould you please draw a simple, symmetrical, front-facing full-body drawing of my raccoon character, Clio, except to draw her at 13 years old? \nhttps://toyhou.se/28354417.clio/gallery\n\nThe outfit can be very simple, cute and childish! It doesn't have to be overly complicated. \n\nIf the money is not enough, please change the amount and resend!\n\nthank you very much!", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/27", "thumbnail_src": "https://si.imgix.net/ab4d203d/uploads/origins/6c382b3f-f806-4980-b2fe-ca49d9c4b551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbad7bc79776d52eecff3b23909a7c3", "thumbnail_srcset": "https://si.imgix.net/ab4d203d/uploads/origins/6c382b3f-f806-4980-b2fe-ca49d9c4b551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbad7bc79776d52eecff3b23909a7c3, https://si.imgix.net/ab4d203d/uploads/origins/6c382b3f-f806-4980-b2fe-ca49d9c4b551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38ce0deb71fa533c88b6e821408ca26c 2x, https://si.imgix.net/ab4d203d/uploads/origins/6c382b3f-f806-4980-b2fe-ca49d9c4b551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc15224ce45b247b1e659f2c2089aef5 3x", "genre": "art", "nsfw": false, "body": "hello komono san, i really loved your design, so i was hoping you could draw a reference sheet for my oc!\n\nhere is the reference sheet. \n\nhttps://drive.google.com/drive/folders/1DTttVTl8pbj12YXEs5Hyvg6gJJGm5WOo\n\ni would like it if you could include all the accessories , front and back as well! she is a young adult/ late teen, so please draw her a bit taller! please note that her umbrella is clear/transparent. also, if possible, could you add one version of a clear/transparent rain coat over her original outfit?  thank you!", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/26", "thumbnail_src": "https://si.imgix.net/2350305e/uploads/origins/c74d88b5-0eb6-444d-bd1a-a65b2c8e4e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06c019a1bcceebb7c2a8ddecf9625d69", "thumbnail_srcset": "https://si.imgix.net/2350305e/uploads/origins/c74d88b5-0eb6-444d-bd1a-a65b2c8e4e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06c019a1bcceebb7c2a8ddecf9625d69, https://si.imgix.net/2350305e/uploads/origins/c74d88b5-0eb6-444d-bd1a-a65b2c8e4e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a826abfffacb95ca33e301a1417d4aff 2x, https://si.imgix.net/2350305e/uploads/origins/c74d88b5-0eb6-444d-bd1a-a65b2c8e4e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1952c4fc61714bb7e4992772407f3eb8 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n狛乃先生のデザインはとっても好きです！私のOCの新しい衣装をデザインしていただきたいです。\nこの子は、猫じゃらしを食べ過ぎて女の子に変身してしまった三毛の野良猫です。\n性格:慎重、好奇心、無邪気です\n\n希望您能够以“流浪三花猫的幽灵或者灵魂”为主题设计一套可爱的服装，希望能有手持道具和头部配件。\n如果这个主题无法设计，您也可以自由发挥其他主题进行设计，能够是可爱服装我会很高兴。\n\n保持する必要がある特徴に注意していただきたい点は以下になります：\n1.猫じゃらしの形をした尻尾\n\nキャラクターの資料はURLにあります。\nもし狛乃先生にこの絵を描いていただけるととても嬉しいので、何卒ご検討のほど、宜しくお願い致します！！\n\nhttps://drive.google.com/drive/folders/1-8haD7suv-ToZXIhvDceIsUGVt1Kw55H", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/25", "thumbnail_src": "https://si.imgix.net/06bed179/uploads/origins/440b6da3-ffc2-42b5-a255-da6968826466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c70d9894e09df2e935d8744957eca5", "thumbnail_srcset": "https://si.imgix.net/06bed179/uploads/origins/440b6da3-ffc2-42b5-a255-da6968826466?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c70d9894e09df2e935d8744957eca5, https://si.imgix.net/06bed179/uploads/origins/440b6da3-ffc2-42b5-a255-da6968826466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a686b627772d6a6f555e5ad2f206066 2x, https://si.imgix.net/06bed179/uploads/origins/440b6da3-ffc2-42b5-a255-da6968826466?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9e09dba6d319c016e3967c70c28c40a 3x", "genre": "art", "nsfw": false, "body": "hi! i really loved your illustration and costume designs!\n\ni really love my oc, but i was hoping if she could get a costume/outfit that suits her soft and cuteness a bit more. i was hoping for a lolita-style dress, with bunny, carrot, or other rain season themes (teru bozu, hydrangeas, etc)  that could be included somewhere in the design. i was hoping the dress can be mid-length, around the knee.\n\nshe has an eyepatch/bandages. and a cat ear toggle. if possible, i would like it if some head accessory could be similar to bunny ears. additionally, please include some sort of umbrella or parasol. please feel free to give her a new hair style as you see fit. i really like your designs, so please feel free to make your own choices! i would love to see what you come up with.\n\nplease feel free to request a higher amount! thank you so much for your consideration.\n\noc ref: https://drive.google.com/drive/folders/1xgGC-DVJOo565WomrPbxXZalDZXNowvR", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/24", "thumbnail_src": "https://si.imgix.net/999c41b8/uploads/origins/4b79fcc1-195b-402d-aba2-36135e319ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdcdeaf46623eb70962efbc088a98f30", "thumbnail_srcset": "https://si.imgix.net/999c41b8/uploads/origins/4b79fcc1-195b-402d-aba2-36135e319ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdcdeaf46623eb70962efbc088a98f30, https://si.imgix.net/999c41b8/uploads/origins/4b79fcc1-195b-402d-aba2-36135e319ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32ea3223ff1ae6f19c0a1581335e421c 2x, https://si.imgix.net/999c41b8/uploads/origins/4b79fcc1-195b-402d-aba2-36135e319ab0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0378a2d7ed028cfe4ad00b87c73e89c3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/23", "thumbnail_src": "https://si.imgix.net/b8a805e5/uploads/origins/c271d09d-69b4-4461-ab22-9b9ff9ac426d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2d22a98351fc89e10475d1e3164a52b", "thumbnail_srcset": "https://si.imgix.net/b8a805e5/uploads/origins/c271d09d-69b4-4461-ab22-9b9ff9ac426d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2d22a98351fc89e10475d1e3164a52b, https://si.imgix.net/b8a805e5/uploads/origins/c271d09d-69b4-4461-ab22-9b9ff9ac426d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ddd392e9875dbf559a99f5a8f47463c 2x, https://si.imgix.net/b8a805e5/uploads/origins/c271d09d-69b4-4461-ab22-9b9ff9ac426d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f11418d1688fd0519e63bb2d93bbd9c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/22", "thumbnail_src": "https://si.imgix.net/d4d8b5ad/uploads/origins/36935d4e-5db7-4c6e-b362-b86ce90e07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fff12df4855fc105584520fc0341fa3", "thumbnail_srcset": "https://si.imgix.net/d4d8b5ad/uploads/origins/36935d4e-5db7-4c6e-b362-b86ce90e07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fff12df4855fc105584520fc0341fa3, https://si.imgix.net/d4d8b5ad/uploads/origins/36935d4e-5db7-4c6e-b362-b86ce90e07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3aded2c61efa875d610596bc682902f 2x, https://si.imgix.net/d4d8b5ad/uploads/origins/36935d4e-5db7-4c6e-b362-b86ce90e07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fabe9e1039df2aa1ecd3333ef2444dbc 3x", "genre": "art", "nsfw": false, "body": "この度は機会をくださりありがとうございます。依頼する側は初めてなのでドキドキです。\n今回ご依頼したいのは私のオリキャラ「リッカ」の衣装デザインです。\nとても気に入っているキャラですが衣装があまりしっくりこず、いつも飛び切りの可愛いを生み出す狛乃さんのデザインした衣装を見てみたい！と常々思っておりました。デザインはミニキャラでも通常サイズのどちらでも大丈夫です。資料は以下をご覧ください。ミニキャライラストがスタンプしかなくて申し訳ありません。\n\n白髪のうさ耳の女の子で、枝の髪飾りと大きなリボンのツインテールをしている子です。キャラシートが字が小さくて読みにくいので概要を説明します。\n氷の雪に覆われたモノクロな世界で育った女の子。天真爛漫で笑顔の絶えない子で星うさぎの世話をしている。ある日郵便屋さんの星クジラが届けてくれた差出人不明の手紙に、色鮮やかな花びらをみつけた。初めて見た「色」というものと「花」というものに興味を持ち、自分の知る世界以外の世界を見たいと旅に出た。という子です。名前のリッカは雪の結晶の六華から来ています。親友は金髪の狐の女の子ポラリスです。\nご縁がありましたらどうぞよろしくお願いします♪\n星海 くろえ\n\nhttps://hoshiumichroekirak.wixsite.com/my-s/portfolio-collections/my-portfolio/project-title-3", "created_at": "", "completed_at": ""}, {"path": "/@manoko_mano/works/21", "thumbnail_src": "https://si.imgix.net/7c887ca8/uploads/origins/088dee39-4379-49eb-b5c2-f9f848b37c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7ceeef52617b70fd4b267ffd000f65a", "thumbnail_srcset": "https://si.imgix.net/7c887ca8/uploads/origins/088dee39-4379-49eb-b5c2-f9f848b37c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7ceeef52617b70fd4b267ffd000f65a, https://si.imgix.net/7c887ca8/uploads/origins/088dee39-4379-49eb-b5c2-f9f848b37c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4109aa1b34e3a3d092d396aedc632a0 2x, https://si.imgix.net/7c887ca8/uploads/origins/088dee39-4379-49eb-b5c2-f9f848b37c8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d16937292c525