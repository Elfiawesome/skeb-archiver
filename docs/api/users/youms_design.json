31c0ac37cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c4d5b473e115a09b815f9de30af71d8, https://si.imgix.net/78523baf/uploads/origins/d67ca298-dcf0-46eb-8506-531c0ac37cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38683f1ae47063f92423eab2eeb00886 2x, https://si.imgix.net/78523baf/uploads/origins/d67ca298-dcf0-46eb-8506-531c0ac37cc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=988c27077caf7777105ca03c1f78c13b 3x", "genre": "art", "nsfw": false, "body": "ゆーむずさん、こんにちは。\n可愛らしいケモノイラストをお見掛けしました。\n私のOCであるステラを描いていただきたくリクエスト差し上げます。\n\n星の海で生まれた彼は宇宙空間でも活動できる小竜の様な生命体です。\nまだ幼いため、色んなものに興味を持ちます。\n\nアクセサリー類が多いので、省略や簡略化はご自由になさってください。\n納品はpsd形式、宛名などは別レイヤーにしていただけると幸いです。\n\nhttps://drive.google.com/drive/u/0/folders/1PuHVbgWtyF5PViTGrnUIMA5Qq-9BGgfh", "created_at": "", "completed_at": ""}, {"path": "/@youms_design/works/6", "thumbnail_src": "https://si.imgix.net/56a531b2/uploads/origins/6eaae2b9-2e73-4c75-a46e-66fed7c980ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=395b47e2ae0f20cd8cb634d52fa3b26d", "thumbnail_srcset": "https://si.imgix.net/56a531b2/uploads/origins/6eaae2b9-2e73-4c75-a46e-66fed7c980ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=395b47e2ae0f20cd8cb634d52fa3b26d, https://si.imgix.net/56a531b2/uploads/origins/6eaae2b9-2e73-4c75-a46e-66fed7c980ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97df3f4e41d9c590e9426dc7ddb16e80 2x, https://si.imgix.net/56a531b2/uploads/origins/6eaae2b9-2e73-4c75-a46e-66fed7c980ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc395a9370c35dc20054bf6c9b69f1a4 3x", "genre": "art", "nsfw": false, "body": "こんばんは、 ソラさん 初めまして。\nツイッターでソラさんの絵を見てからぜひリクエストしたいと思て来ました。　\nテーマとか内容はすべておまかせでお願いしたいです。\nよろしくお願いします。\n\n\n指は4本、足の指は3本でお願いします。\nうちの子かかけている手錠とか首輪は描かなくてもいいです。\n(状況によって自由に描いてください。構図やスタイルによっては翼を簡単に描いても大丈夫です。)\n\nhttps://drive.google.