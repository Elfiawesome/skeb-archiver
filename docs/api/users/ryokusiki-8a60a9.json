n服装は原作5巻で登場した博麗霊夢の服を着た通称「巫女華扇」でお願いします。\n巨乳キャラとして扱われることが多いので胸は大きめでお願いします。\n\nその他細かい部分はお任せします。\nそれでは、ご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ryokusiki/works/26", "thumbnail_src": "https://si.imgix.net/c76ebcf5/uploads/origins/2956c64b-903e-40de-bdd0-c128c0eebf8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d276f97afaefb93de7cf12d1f9697e75", "thumbnail_srcset": "https://si.imgix.net/c76ebcf5/uploads/origins/2956c64b-903e-40de-bdd0-c128c0eebf8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d276f97afaefb93de7cf12d1f9697e75, https://si.imgix.net/c76ebcf5/uploads/origins/2956c64b-903e-40de-bdd0-c128c0eebf8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb13fb8b9eba2eedbdcc490100412486 2x, https://si.imgix.net/c76ebcf5/uploads/origins/2956c64b-903e-40de-bdd0-c128c0eebf8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23f115f30e66727b27796e27bb8a4b5c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ryokusiki/works/25", "thumbnail_src": "https://si.imgix.net/55a172f8/uploads/origins/a24fa514-4694-4760-8efd-706dadbf9adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9970909921faa425890fd7d2d4fa741", "thumbnail_srcset": "https://si.imgix.net/55a172f8/uploads/origins/a24fa514-4694-4760-8efd-706dadbf9adb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtsha