1-496f-b1cc-9b1d1d0eb69b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcc0b13c04164c01fba4fb3b620300b1 2x, https://si.imgix.net/e9f62b24/uploads/origins/27f8048c-19d1-496f-b1cc-9b1d1d0eb69b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa1523f6f6e1f37211b5b1a1512f3fda 3x", "genre": "art", "nsfw": false, "body": "帽子世界のヨウコが外部出演時に使用する必殺技という設定で「六道輪廻」の強化版をお願いします。\n大まかなモーションは原作通りですが管理人達の力を借りて強化しているという設定なので方陣のエフェクトの文字は「玩」「時」「法」「戦」「命」「夢」の漢字に変更して色合いもそれぞれのイメージカラーを混ぜたカラフルなものにしていただきたいです。\n武器は金属バットですが管理人達から引き継いだ力でチェーンソー型の宝石の刃を生やしているデザインでお願いします(魔界塔士サガのオマージュです)。\n背景はヨウコ編ラスボス戦、喰らっている相手は可能であれば「AmongUs」の赤クルーメイトでお願いします。\nカメラワークなどはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@akaiao0/works/8", "thumbnail_src": "https://si.imgix.net/2b581b92/uploads/origins/e3ebc926-8ac3-44d4-a76a-181f7392dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81377ad8d88e6f7c5b0e6bfa405aeafd", "thumbnail_srcset": "https://si.imgix.net/2b581b92/uploads/origins/e3ebc926-8ac3-44d4-a76a-181f7392dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81377ad8d88e6f7c5b0e6bfa405aeafd, https://si.imgix.net/2b581b92/uploads/origins/e3ebc926-8ac3-44d4-a76a-181f7392dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e7eac856714a672a4a7a8f75f0c6caf 2x, https://si.imgix.net/2b581b92/uploads/origins/e3ebc926-8ac3-44d4-a76a-181f7392dec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6549854143128318a4bd9bf3418598b 3x", "genre": "art", "nsfw": false, "body": "私自身、つまりJKリエルの絵をお願いしたいです。\n服装に関してはお任せします、指定があった方が描きやすいのでしたら\n巫女服、和服の2点からで絞らせてもらえればと思います\n\nhttps://x.com/erinbaseed/status/1546689826807640066?s=20", "created_at": "", "completed_at": ""}, {"path": "/@akaiao0/works/7", "thumbnail_src": "https://si.imgix.net/6912cd8a/uploads/origins/ea3ae72b-2056-494f-920d-8d86d9ec4ad7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to