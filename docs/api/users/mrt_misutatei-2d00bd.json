=200&h=200&s=a4f3b9ee4e44cbd813ae98342821bb35, https://si.imgix.net/1d2d3bb3/uploads/origins/e32d3424-0415-48b8-a9eb-6e73b36ce9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cad09d8274c759610a6e4a51e8dc2061 2x, https://si.imgix.net/1d2d3bb3/uploads/origins/e32d3424-0415-48b8-a9eb-6e73b36ce9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da747ef9fedaa1d6dfa3cb44540cc864 3x", "genre": "art", "nsfw": false, "body": "またリクエストです。京急600形keikyu Blue sky Trainと後藤ひとりちゃんをお願いします。行先は快特品川でお願いします。朝いつもと違うのが来て驚いてる感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/99", "thumbnail_src": "https://si.imgix.net/7e3b4d20/uploads/origins/1d032d67-b5e2-4b0c-831d-8e8b4daa169d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43685cd5d9662e0d7b95ec6978cb9602", "thumbnail_srcset": "https://si.imgix.net/7e3b4d20/uploads/origins/1d032d67-b5e2-4b0c-831d-8e8b4daa169d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43685cd5d9662e0d7b95ec6978cb9602, https://si.imgix.net/7e3b4d20/uploads/origins/1d032d67-b5e2-4b0c-831d-8e8b4daa169d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97d822e94dad63797cd3fc02c9c25369 2x, https://si.imgix.net/7e3b4d20/uploads/origins/1d032d67-b5e2-4b0c-831d-8e8b4daa169d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bfe31e6ad128ff8ddf71a2d15b65907 3x", "genre": "art", "nsfw": true, "body": "NSFWを有効にされているので問題ないかと思いますが、ヤンレチちゃんの成人向けイラストを依頼します。\n抱き枕イラストのように、全身絵をキャンバスの左には前向きで、右には後ろ向きで、極小の金色マイクロビキニを纏った姿を曲線美を強調したポーズで。\n差分で全裸バージョンもお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/98", "thumbnail_src": "https://si.imgix.net/90684e00/uploads/origins/90f7c874-05da-4426-827e-ee635d29a686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bf95e594c6cb08db7612056d22ad6ac", "thumbnail_srcset": "https://si.imgix.net/90684e00/uploads/origins/90f7c874-05da-4426-827e-ee635d29a686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bf95e594c6cb08db7612056d22ad6ac, https://si.imgix.net/90684e00/uploads/origins/90f7c874-05da-4426-827e-ee635d29a686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec06a093b1dd09f32a7a77ff4b86f4ca 2x, https://si.imgix.net/90684e00/uploads/origins/90f7c874-05da-4426-827e-ee635d29a686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8f76ba6f45fdd8b57a856d3d0fa2638 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nクラメルカガリのファンアートを描かれていたので塚原作品の依頼可能と見込んでお願いですが\nクラユカバから、タンネと装甲列車のイラストをお願い致します。\nシチュエーション等々は・・・、お任せ致します。\n\nお忙しいとは思いますが宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/97", "thumbnail_src": "https://si.imgix.net/258a9887/uploads/origins/ed1b92ae-259c-4760-885a-5e9b5f61eea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77697863fa59dc572e6d6671a9a0c9ea", "thumbnail_srcset": "https://si.imgix.net/258a9887/uploads/origins/ed1b92ae-259c-4760-885a-5e9b5f61eea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77697863fa59dc572e6d6671a9a0c9ea, https://si.imgix.net/258a9887/uploads/origins/ed1b92ae-259c-4760-885a-5e9b5f61eea8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7c59a39309eb4eea82d2f15b1421fc9 2x, https://si.imgix.net/258a9887/uploads/origins/ed1b92ae-259c-4760-885a-5e9b5f61eea8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f0b71d4cb48db79b68b11678271d0bd 3x", "genre": "art", "nsfw": false, "body": "今回は南海2300系と、先日実装されたばかりのウマ娘「サウンズオブアース」風の女性駅員をリクエストいたします。\n（2300系の編成愛称「はなみずき」が、サウンズオブアース最後の勝ちレース名と同じ）\n先頭車両「さくら」にちなみ、桜並木の中を進む列車と、ヴァイオリンを弾いて客をもてなす駅員のイメージを、目を開けているver＆目を閉じているverの差分でお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/96", "thumbnail_src": "https://si.imgix.net/23bf9613/uploads/origins/10ecdae6-110f-4ade-b260-7d75bd77ee82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70274dd9818da4a166d5d2675d233882", "thumbnail_srcset": "https://si.imgix.net/23bf9613/uploads/origins/10ecdae6-110f-4ade-b260-7d75bd77ee82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70274dd9818da4a166d5d2675d233882, https://si.imgix.net/23bf9613/uploads/origins/10ecdae6-110f-4ade-b260-7d75bd77ee82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e2276c209bcca7798a679204266f433 2x, https://si.imgix.net/23bf9613/uploads/origins/10ecdae6-110f-4ade-b260-7d75bd77ee82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b57bee3677029580ebde30f579e222b 3x", "genre": "art", "nsfw": false, "body": "こんにちは。あなたの作品がとても好きで、画像を依頼したいです。私は複数のモデルを持っているVtuberです。そのうちの2人を作品に登場させたいです。赤をアクセントにした205系0番台の電車の前でポーズをとってもらいたいです。\n\n一人は電車の制服を着た筋肉質な猫男https://swolekat.info/images/avatars-small/conductor.gif。\n\nもう一人は同じく制服を着た巨乳の猫娘：https://swolekat.info/images/avatars-small/trainbae.gif\n\nお好みで制服を変えてください。\n\nキャラクターと電車以外にはポーズは考えていません。\n\nこのアートは、電車でGOや他の日本の鉄道シミュレーターを紹介するyoutubeビデオのエンド画面として使いたいと思っています。できればアスペクト比16:9でお願いします。\n\n私の依頼を読んでいただきありがとうございます。ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/95", "thumbnail_src": "https://si.imgix.net/fde84e02/uploads/origins/6a2132be-5479-4581-a78c-86fd5cee3ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bb5e94268c85667b5164031dcae8dd8", "thumbnail_srcset": "https://si.imgix.net/fde84e02/uploads/origins/6a2132be-5479-4581-a78c-86fd5cee3ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bb5e94268c85667b5164031dcae8dd8, https://si.imgix.net/fde84e02/uploads/origins/6a2132be-5479-4581-a78c-86fd5cee3ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a2e764c5c4e359ca7f0875c14959cc4 2x, https://si.imgix.net/fde84e02/uploads/origins/6a2132be-5479-4581-a78c-86fd5cee3ed9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7df05a5580d06a8fa02597e4e778c4cb 3x", "genre": "art", "nsfw": false, "body": "こんばんは。\n昨年は素敵なイラストを描いてくださりありがとうございました。\n漫画「銀彩の川」より〝東凪鉄道5000系電車と白川助役〟のイラストを描いて頂けないでしょうか。\n\n●5000系\n・外観や諸々の設定は、添付のURLをご参照ください。\n・種別･行き先は「快速急行(Rapid Express)」「セントラル東京(Central Tokyo)」。ローマ字の併記があるように描いて頂けると幸いです(ローマ字が読み取れなくても構いません)。\n・種別の表示方は、ベースは橙地に白抜き文字、そのうち〝快速〟の部分のみ水色で囲んだようなデザインです。塗り分けとしては、かつての西武線で見られた快急幕のようなものをイメージして頂ければと思います。\n・5551号車(３連・セントラル東京方制御車)を先頭に、前３連＋後７連の10両編成がこちらに向かって走ってきているような構図を所望します。あくまで設定ですので、無理に10両全ての車両を画面に映したり、併結部を描いたりして頂かなくても構いません。\n・急行灯(前照灯の下･色合いはオレンジ)は、左右共に点灯でお願いします。\n・なお、今回リクエストしている5000系の３連は、本編で直接描かれたことのない編成です。仕上がりにつきましては、あくまで作者様の解釈そのままの姿で構いません。\n\n●白川助役\n・容姿や服装につきましては、添付のURL(似たような画像ばかりで恐縮ですが……)をご参照ください。\n・東凪鉄道の制服姿(冬服･ジャケットとベスト着用･白手袋･制帽は非着用)での立ち絵を所望します。\n・元々糸目がちなキャラクターですので、開眼状態か否かはどちらでも構いません。\n・ポーズはお任せします。\n\n以上です。指定のない点や不明な点は、すべて作者様の裁量にお任せします。\n前述の通り、車両の外観や設定、キャラクターの容姿や服装につきましては、資料URLをご参照ください。また、pixivやYouTubeで「銀彩の川」と検索して頂くと、本作の作画担当の方や連載元公式が投稿した作品をご覧になれますので、併せてご参考頂ければと思います。\n大変わがままなリクエストで恐縮ですが、何卒ご検討頂けますと幸いです。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/18BWoQfftV9esIJ2SosP0mXIc_WpFFSqK", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/94", "thumbnail_src": "https://si.imgix.net/74a21c42/uploads/origins/f577c2d9-7f01-44f9-94c5-a606e49a3f02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ded2d4560e1fb009c1ef3f72e5089d9", "thumbnail_srcset": "https://si.imgix.net/74a21c42/uploads/origins/f577c2d9-7f01-44f9-94c5-a606e49a3f02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ded2d4560e1fb009c1ef3f72e5089d9, https://si.imgix.net/74a21c42/uploads/origins/f577c2d9-7f01-44f9-94c5-a606e49a3f02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6900e8fdb4e946c64b986a99ceaab536 2x, https://si.imgix.net/74a21c42/uploads/origins/f577c2d9-7f01-44f9-94c5-a606e49a3f02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f52943674ab85f82662b0cfe4ea139c 3x", "genre": "art", "nsfw": false, "body": "先日はリクエストお答えいただきありがとうございました。\n\n今回はブルーアーカイブの一之瀬アスナと、アメリカのインターアーバン、キーシステムのブリッジ・ユニットを描いて頂けないでしょうか。\nアスナは夏制服でギャルピースしている感じ。\nブリッジユニットの方は白銀とオレンジの初期塗装状態で、薄型冷房装置の搭載改造・前面幕のフルカラーLED化などミレニアムサイエンススクール内で更新改造を受けている様子でお願いします。\n背景はどこかの高架駅のような感じで頼めますでしょうか。\n\n宜しくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/93", "thumbnail_src": "https://si.imgix.net/951192a6/uploads/origins/1d043ceb-ad3f-4742-a353-ef4c7ff2cc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2feb1cc12e44a003fca41a9ef7ace24", "thumbnail_srcset": "https://si.imgix.net/951192a6/uploads/origins/1d043ceb-ad3f-4742-a353-ef4c7ff2cc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2feb1cc12e44a003fca41a9ef7ace24, https://si.imgix.net/951192a6/uploads/origins/1d043ceb-ad3f-4742-a353-ef4c7ff2cc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ad63d4232f325a37390089284686c4a 2x, https://si.imgix.net/951192a6/uploads/origins/1d043ceb-ad3f-4742-a353-ef4c7ff2cc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecb59a0c767fa48a3982453355f6415b 3x", "genre": "art", "nsfw": false, "body": "初めまして！新潟のかぼちゃ電車のクリアファイルを買ったので今回依頼させていただきます。\n\nキャラクター：うちの子（リンク参照）素材がこれだけなのですが、上は紫の半そで上着に白のインナー下はホットパンツに黒のサイハイソックスでお願いいたします。\nhttps://www.pixiv.net/artworks/100517827\n\n鉄道と背景：115系新潟色（キムワイプ色）と新潟駅８・９番線（新井快速イメージ）でお願いいたします。\n分かりずらいかもしれませんが、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/92", "thumbnail_src": "https://si.imgix.net/4e46a36a/uploads/origins/4dd91e70-f18c-4d3a-8ceb-09b5e3a17839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b03e25f7e2a9f1d546bb80dd8462a22b", "thumbnail_srcset": "https://si.imgix.net/4e46a36a/uploads/origins/4dd91e70-f18c-4d3a-8ceb-09b5e3a17839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b03e25f7e2a9f1d546bb80dd8462a22b, https://si.imgix.net/4e46a36a/uploads/origins/4dd91e70-f18c-4d3a-8ceb-09b5e3a17839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ee28140c99fe7d9eb048b6e294c66f2 2x, https://si.imgix.net/4e46a36a/uploads/origins/4dd91e70-f18c-4d3a-8ceb-09b5e3a17839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed132b1019305060b793a41d927d9e4c 3x", "genre": "art", "nsfw": false, "body": "Hello! My name is Mikan and I love your artwork! My home country does not have high speed rail, so Japanese trains are very exciting and fun for me! \n\nI am a fan of the \"Chiikawa\" series. As a result, It would be my dream to visit the official Chiikawa Hankyu Railway trains! You can learn more about the trains here: https://www.hankyu.co.jp/area_info/chiikawa_hankyu2023/index.html\n\nPlease draw me in casual clothing of your choice (and maybe with a conductor chiikawa plush if you'd like) by a Chiikawa train! Thank you!!!\n\nhttps://x.com/NonomiyaMikan/status/1759967532654448772?s=20", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/91", "thumbnail_src": "https://si.imgix.net/2518e20a/uploads/origins/63f7fa63-cd1e-4505-ac70-46c93018104e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7ed4833885a0f0ff273531f571742fd", "thumbnail_srcset": "https://si.imgix.net/2518e20a/uploads/origins/63f7fa63-cd1e-4505-ac70-46c93018104e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7ed4833885a0f0ff273531f571742fd, https://si.imgix.net/2518e20a/uploads/origins/63f7fa63-cd1e-4505-ac70-46c93018104e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93be6809313612fc972b8f19180ab42d 2x, https://si.imgix.net/2518e20a/uploads/origins/63f7fa63-cd1e-4505-ac70-46c93018104e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51f50759231bab787d15f6a8bdd4f617 3x", "genre": "art", "nsfw": false, "body": "前回はありがとうございました。今回はN700系山陽九州新幹線仕様とウマ娘のサクラバクシンオーが一緒に「バクシーン！」って言いながら走っている所をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/90", "thumbnail_src": "https://si.imgix.net/e1edf76a/uploads/origins/25a49e65-5aad-4cbe-97d5-d9bcee92e88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08548ea507a080e3140f759dfba65eb2", "thumbnail_srcset": "https://si.imgix.net/e1edf76a/uploads/origins/25a49e65-5aad-4cbe-97d5-d9bcee92e88a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08548ea507a080e3140f759dfba65eb2, https://si.imgix.net/e1edf76a/uploads/origins/25a49e65-5aad-4cbe-97d5-d9bcee92e88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=521245b386c3bf73bfdfebcf046d054a 2x, https://si.imgix.net/e1edf76a/uploads/origins/25a49e65-5aad-4cbe-97d5-d9bcee92e88a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=856b282576ef053e8bdacb63cf53b44c 3x", "genre": "art", "nsfw": false, "body": "先日は素敵にうちの子と妙高号を描いていただきありがとうございました。\n今回も依頼させてください。\n\nお願いしたいキャラは自分のサイトのマスコットキャラの子で、緑のジャージに体操服、ブルマーというキャラになります。\nhttps://twitter.com/Funakiya/status/1742012997437206533\n\nシチュエーションはうちの子が国鉄419系電車（食パン）と並んでいるところをお願いします。\nTOWNトレインのヘッドマーク付きでお願いします。\nhttps://ja.wikipedia.org/wiki/%E5%9B%BD%E9%89%84419%E7%B3%BB%E3%83%BB715%E7%B3%BB%E9%9B%BB%E8%BB%8A#/media/%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB:1992-8-kuha418-5b.JPG\n\n\nMisskeyなどSNSの紹介およびtwitter凍結回避のため自分のサイトでの紹介の範囲で利用させていただければと思います。\n宜しくお願いします。\n\nhttps://twitter.com/Funakiya/status/1742012997437206533", "created_at": "", "completed_at": ""}, {"path": "/@mrt_misutatei/works/89", "thumbnail_src": "https://si.imgix.net/975e6138/uploads/origins/e45f9416-25b5-481b-81da-80f9554eadfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d951410c12ec44ac0c60a740832f68", "thumbnail_srcset": "https://si.imgix.net/975e6138/uploads/origins/e45f9416-25b5-481b-81da-80f9554eadfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d951410c12ec44ac0c60a740832f68, https://si.imgix.net/975e6138/uploads/origins/e45f9416-25b5-481b-81da-80f9554eadfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d54950c111a516695de8c000a80c2d2 2x, https://si.imgix.net/975e6138/uploads/origins/e45f9416-25b5-481b-81da-80f9554eadfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba57fc8152b19b8000bded2af2d70ea9 3x", "genre": "art", "nsfw": false, "body": "みすた亭さんの描いたD52形式蒸気機関車D5270号が見たいと思ったので依頼します\n\nD5270保存会特別会員としては一度は見たいと思ってきました", "created_at": "", "completed_at": ""}]}