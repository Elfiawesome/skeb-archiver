抱きつくと、色情魔が女子高生の魂の背中から沈み込んで、トコロテンが押し出されるみたいに女子高生の胸が巨乳になり、体型もムチっとしたモノへと変わる感じでお願いします。\n\n肉体に魂が戻った後については、魂が色情魔と融合してしまったので、髪は色情魔の髪型になり肉体は大人のものに成長、資料のように成長して制服のサイズが合わないため、上はお腹や谷間を露出し、下は尻が大きいためスカートで隠しきれなくなっている状態にしていただきたいです。\n\n要望が多くてすいませんが、ご一考お願いします。\n\nhttps://drive.google.com/drive/folders/114-N-4OirhOneHrcDFJuIz1_17l_TqUS", "created_at": "", "completed_at": ""}, {"path": "/@neko_kaminari80/works/23", "thumbnail_src": "https://si.imgix.net/efecac68/uploads/origins/62d78f12-a9ab-415f-831d-3012bf1cbc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1b592ed3a0133bba1af53798c351be8", "thumbnail_srcset": "https://si.imgix.net/efecac68/uploads/origins/62d78f12-a9ab-415f-831d-3012bf1cbc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1b592ed3a0133bba1af53798c351be8, https://si.imgix.net/efecac68/uploads/origins/62d78f12-a9ab-415f-831d-3012bf1cbc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e50452bdc486f0e484f82c95dc16a14 2x, https://si.imgix.net/efecac68/uploads/origins/62d78f12-a9ab-415f-831d-3012bf1cbc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7defcca8280ce76838a9c5deea342f7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@neko_kaminari80/works/22", "thumbnail_src": "https://si.imgix.net/a8ce62b1/uploads/origins/9114380b-7d36-4cfd-a236-de888269c703?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27b313ab56eac2cb4105733abdcf22de", "thumbnail_srcset": "https://si.imgix.net/a8ce62b1/uploads/origins/9114380b-7d3