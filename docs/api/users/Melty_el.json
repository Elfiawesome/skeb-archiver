68f-4ba0-8dad-c9b222f1f1a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b92fd160f3ce5599e8e1a3c16732852d 3x", "genre": "art", "nsfw": false, "body": "メルティ・エルの水着イラストお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@Melty_el/works/5", "thumbnail_src": "https://si.imgix.net/cb5129ad/uploads/origins/8f18b12a-60e5-4858-acc4-c9136e93c89f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad4040096e2f58b82c4208c8f672c127", "thumbnail_srcset": "https://si.imgix.net/cb5129ad/uploads/origins/8f18b12a-60e5-4858-acc4-c9136e93c89f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad4040096e2f58b82c4208c8f672c127, https://si.imgix.net/cb5129ad/uploads/origins/8f18b12a-60e5-4858-acc4-c9136e93c89f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70cb54a688364708d4fd549559c909a5 2x, https://si.imgix.net/cb5129ad/uploads/origins/8f18b12a-60e5-4858-acc4-c9136e93c89f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41454a7c6cea39296c696bb215060e72 3x", "genre": "art", "nsfw": false, "body": "アイコン用のイラストをお願いしたいです🙏\n\nめるちのイメージの中の私でいいので雰囲気や構図は全てお任せします(難しくてごめんなさい🥺)\n\nデフォルメでもリアルでも大丈夫です！\n\n用途としてはXやdiscordなどのアイコンとして使いたいと思ってます🙇‍", "created_at": "", "completed_at": ""}, {"path": "/@Melty_el/works/4", "thumbnail_src": "https://si.imgix.net/13afe01d/uploads/origins/543fcba1-3e9b-4bed-bc3f-57b42c794caf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cbe9760a7a3d92e58c3e5179bb12aea", "thumbnail_srcset": "https://si.imgix.net/13afe01d/uploads/origins/543fcba1-3e9b-4bed-bc3f-57b42c794caf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cbe9760a7a3d92e58c3e5179bb12aea, https://si.imgix.net/13afe01d/uploads/origins/543fcba1-3e9b-4bed-bc3f-57b42c794caf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73300a12f06febf4a52540af743fa059 2x, https://si.imgix.net/13afe01d/uploads/origins/543fcba1-3e9b-4bed-bc3f-57b42c794caf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46f7178ff3964726f816bd509e168c3e 3x", "genre": "art", "nsfw": false, "body": "前回のイラストが素晴らしかったのでまたリクエストさせていただきます\n\n「頑張れっ頑張れっ」ってメルティさんが応援している構図でお願いします\n(センシティブな意味ではなく純粋に頑張っている人を応援する感じです)\n\n背景は明るめで髪型や服装、比率はお任せします\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Melty_el/works/3", "thumbnail_src": "https://si.imgix.net/11ac8c61/uploads/origins/f3c2a05a-c6e8-4a81-acf1-6d96783dc67e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cc56431ec4d76be991b0e3ac69e19df", "thumbnail_srcset": "https://si.imgix.net/11ac8c61/uploads/origins/f3c2a05a-c6e8-4a81-acf1-6d96783dc67e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cc56431ec4d76be991b0e3ac69e19df, https://si.imgix.net/11ac8c61/uploads/origins/f3c2a05a-c6e8-4a81-acf1-6d96783dc67e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85578ff41d2459c200174546a05d1336 2x, https://si.imgix.net/11ac8c61/uploads/origins/f3c2a05a-c6e8-4a81-acf1-6d96783dc67e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1cb441fff191c107de81468844e0716 3x", "genre": "art", "nsfw": false, "body": "今まであまりSNS活用するタイプではなかったので、\nちょっとよくわかってないので間違っていた場合すいません。\n\n今回の依頼は2枚のイラスト\n\n\nヘッダーやアイコンに使うイラストをお願いしたいです。\n\n【要望　2点】\n\n１・狐の仮面を被って口元だけ見える可愛い素朴な男の子が理想です。見えている部分の髪色は黒をベースに暗い紫などをどこかに入れてほしいです。\n\n２・派手すぎない感じの雰囲気でお願いしたいです。\n\n補足（メルティさんのヘッダー用の　画角とかの雰囲気好きなので、参考にして頂ければありがたいです。）\n後は　そちらのセンスでお任せでお願いします。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Melty_el/works/2", "thumbnail_src": "https://si.imgix.net/b0a59506/uploads/origins/512eb8a9-74ac-4f7d-a179-f2c0bb563507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05faa51251f1b6f7cba7b9f188a42c4d", "thumbnail_srcset": "https://si.imgix.net/b0a59506/uploads/origins/512eb8a9-74ac-4f7d-a179-f2c0bb563507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05faa51251f1b6f7cba7b9f188a42c4d, https://si.imgix.net/b0a59506/uploads/origins/512eb8a9-74ac-4f7d-a179-f2c0bb563507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29febbd95e2ccaa81c0a7770dbfefb79 2x, https://si.imgix.net/b0a59506/uploads/origins/512eb8a9-74ac-4f7d-a179-f2c0bb563507?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d4b9a58d84d1648a97ea52dd921c036 3x", "genre": "art", "nsfw": false, "body": "めるちのスマホ用待受が欲しいので依頼させてもらいます\nクール成分マシマシだと嬉しいです\n縦長であれば比率や構図お任せします\n\nスケブのリクエスト初なので不備があれば申し訳ありません", "created_at": "", "completed_at": ""}, {"path": "/@Melty_el/works/1", "thumbnail_src": "https://si.imgix.net/94699673/uploads/origins/9e1f4662-e286-4772-9d00-edbc7e97f476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b0e6392ffae99bea6c19966114b16a", "thumbnail_srcset": "https://si.imgix.net/94699673/uploads/origins/9e1f4662-e286-4772-9d00-edbc7e97f476?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b0e6392ffae99bea6c19966114b16a, https://si.imgix.net/94699673/uploads/origins/9e1f4662-e286-4772-9d00-edbc7e97f476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da9d73917b4bd3e3d71a7d3fc7cb2bd6 2x, https://si.imgix.net/94699673/uploads/origins/9e1f4662-e286-4772-9d00-edbc7e97f476?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=526eff78ec0214cec30e59bbadb693f9 3x", "genre": "art", "nsfw": false, "body": "メルティの待ち受け用のイラストをお願いします🙏\n\n縦長であれば比率と構図はお任せします！", "created_at": "", "completed_at": ""}]}