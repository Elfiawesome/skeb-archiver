8e6aa3f1c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85a83d4f0e7ce344363eb22c31e703f3, https://si.imgix.net/2dbb2245/uploads/origins/c6a5491b-2fa6-4d63-b869-38e6aa3f1c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1438b0cbac4d773c63d0b7a722ad2249 2x, https://si.imgix.net/2dbb2245/uploads/origins/c6a5491b-2fa6-4d63-b869-38e6aa3f1c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d16eed94ecd519d6b91934b70402e9a 3x", "genre": "art", "nsfw": false, "body": "はじめまして、イラストのリクエスト失礼します。\n\n◇キャラクター\nオンゲキの高瀬梨緒\n服装…ゲヘナ学園制服\n\n◇内容\nもし高瀬梨緒がゲヘナ学園の生徒だったら…みたいなイラストをお願いします\nゲヘナモブ(一般生徒)の服をベースにしてください。シャツをスカートにしまわずに出した状態にしていただけると助かります。\nあと、表情はジュンコやチアキの基本立ち絵のようなドヤ顔っぽい感じでお願いします\n\n備考(あってもなくてもどちらでもいいです)\n・もしヘイローを作る場合、紫色の⊿型を入れていただけると嬉しいです\n・上記以外のもの(服の細かいデザインや小物等)は自由にアレンジ入れてもらって大丈夫です\n\n資料\n・高瀬梨緒(公式キャラページ)\nhttps://ongeki.sega.jp/character/1040/\n・wiki\nhttps://wikiwiki.jp/gameongeki/%E9%AB%98%E7%80%AC%20%E6%A2%A8%E7%B7%92\n・その他\nhttps://x.com/in_spica/status/1933701757814837279\n\nよろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@toki_oekaki/works/3", "thumbnail_src": "https://si.imgix.net/0d3dbf0e/uploads/origins/a3fe7687-3822-43c5-a3fb-ed952b730f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8949d7f19dd2413f89079b927e600614", "thumbnail_srcset": "https://si.imgix.net/0d3dbf0e/uploads/origins/a3fe7687-3822-43c5-a3fb-ed952b730f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8949d7f19dd2413f89079b927e600614, https://si.imgix.net/0d3dbf0e/uploads/origins/a3fe7687-3822-43c5-a3fb-ed952b730f0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize