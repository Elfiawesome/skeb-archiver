00&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e51f74c0f235add738efd325fc7521f 2x, https://si.imgix.net/4e8df6d1/uploads/origins/cdad482b-d6b1-4260-888d-0ab74f52886c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c06f97763e09ad4f639e26b19f3c1e3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/31", "thumbnail_src": "https://si.imgix.net/9a8951d2/uploads/origins/5d258541-6bfd-4ed0-8f30-9b4f4d2ea026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874103b253cc367ef865d8a410bbb48b", "thumbnail_srcset": "https://si.imgix.net/9a8951d2/uploads/origins/5d258541-6bfd-4ed0-8f30-9b4f4d2ea026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=874103b253cc367ef865d8a410bbb48b, https://si.imgix.net/9a8951d2/uploads/origins/5d258541-6bfd-4ed0-8f30-9b4f4d2ea026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4928cfc0760414b9991d5ef812cdabf0 2x, https://si.imgix.net/9a8951d2/uploads/origins/5d258541-6bfd-4ed0-8f30-9b4f4d2ea026?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac9a489cd6ec7754e32641d3d1287ada 3x", "genre": "art", "nsfw": false, "body": "こんにちは！はじめまして！\n\nアズールレーンのジェンキンスのイラストをお願いしたいです！(URL参照)\n\nこのような黒いドレス（参考：https://skeb.jp/@akina873/works/18）を着てほしいです。ジェンキンスは私の名前が書かれたバレンタイン・チョコレートを持っています。\n\nあとはすべて、あなたの心にお任せします！\n\nご検討ありがとうございました！\n\nhttps://x.com/azurlane_staff/status/930342386315665408", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/30", "thumbnail_src": "https://si.imgix.net/29bda9be/uploads/origins/c5e0416d-1838-466c-b316-8503af715fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=961b4253a1b7d87275e6d0f0e9c3ea05", "thumbnail_srcset": "https://si.imgix.net/29bda9be/uploads/origins/c5e0416d-1838-466c-b316-8503af715fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=961b4253a1b7d87275e6d0f0e9c3ea05, https://si.imgix.net/29bda9be/uploads/origins/c5e0416d-1838-466c-b316-8503af715fec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0c7850e3a576e3f3e6f059bc9dd24b4 2x, https://si.imgix.net/29bda9be/uploads/origins/c5e0416d-1838-466c-b316-8503af715fec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b78351f8582704ccc8109437e122e353 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/29", "thumbnail_src": "https://si.imgix.net/0e32de92/uploads/origins/0ff57b49-4370-458f-a182-68fc7c59b6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b203ece134b3911508c518348f7080", "thumbnail_srcset": "https://si.imgix.net/0e32de92/uploads/origins/0ff57b49-4370-458f-a182-68fc7c59b6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75b203ece134b3911508c518348f7080, https://si.imgix.net/0e32de92/uploads/origins/0ff57b49-4370-458f-a182-68fc7c59b6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=552aa7b4ffc07e7f226ed913dc36252e 2x, https://si.imgix.net/0e32de92/uploads/origins/0ff57b49-4370-458f-a182-68fc7c59b6ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b2354bced374a3fc57a1dea8dfd6175 3x", "genre": "art", "nsfw": true, "body": "こんにちは。あゆんだりすのデッサンをお願いしたいのですが。\n\nりすは白いワンピースを着て、ピンクのベレー帽をかぶり、靴下をはいています。\nhttps://imgchest.com/p/6eyr2njbl7p\n\nりすは缶入りのお茶とドーナツを持ってソファに座っている。一見、普通の写真に見える。しかし、よく見ると、りすはセックスしたばかりであることが暗示されている。\n\nポーズ：\nhttps://imgchest.com/p/qe4gedaxq7j\n\nりすの服は乱れている：片方の靴下は一部脱げ、ドレスの片方の紐は肩から外れている。片足にはピンクのパンティが絡まっている。しかし、パンティがねじれているため、目立たない布切れのように見える。\nりすの髪は乱れ、顔を赤らめ、汗をかいている。りすはドレスの下で乳首を勃起させている。りすの瞳孔はハート型。りすは見る人を見つめ、微笑み、唇を舐めている。\nりすはドーナツをお腹の前に持っている。ドーナツはチョコレートでコーティングされ、白いスプリンクルで覆われている。\nドーナツは子宮の断面のように見える。ドーナツの穴は卵、ふりかけは精子。\n\nありがとう。", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/28", "thumbnail_src": "https://si.imgix.net/b87bd645/uploads/origins/3e778eef-4d61-4099-b896-0abb8104d1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06a847195eea45075d87921569088340", "thumbnail_srcset": "https://si.imgix.net/b87bd645/uploads/origins/3e778eef-4d61-4099-b896-0abb8104d1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06a847195eea45075d87921569088340, https://si.imgix.net/b87bd645/uploads/origins/3e778eef-4d61-4099-b896-0abb8104d1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31bd68231d8f869ce53e1e54a49e7ca3 2x, https://si.imgix.net/b87bd645/uploads/origins/3e778eef-4d61-4099-b896-0abb8104d1ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85e76f9fd56faed507f156abd7eaa3ee 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nskebを見ていたところ素敵なイラストが目に留まり、ぜひ私のオリジナルキャラクターを描いていただきたいと思い依頼いたしました！\n\n\n⚫︎イラスト内容\n萌え袖のセーターを着ているイラスト\n参考資料の中にあるイラストのように袖を顔の近くに持ってきている構図で描いていただきたいです。\nセーターのデザインや背景等はお任せいたします！\n\n⚫︎使用用途\nXやInstagram等での投稿、アイコンなど。\nまた個人や限定的な公開範囲での利用(壁紙や収益の発生しないネップリ印刷等)\n活動者ではありませんが今後配信活動をする際に使用させていただく可能性があります(収益化やグッズ化の予定はありません)\n\n⚫︎納品について\n単色背景ありと背景なし(背景透過)を分けてPNGで納品していただけると嬉しいです！\n\n以上となります。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/10bdLyUD2bsdLTNGzBN_OzUe402tRZRfd", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/27", "thumbnail_src": "https://si.imgix.net/2caed2f9/uploads/origins/12ad04f3-6f9a-42e7-94d9-cfa1ac5c326e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c2ffc2d86497fa4772f94fa2abbf91b", "thumbnail_srcset": "https://si.imgix.net/2caed2f9/uploads/origins/12ad04f3-6f9a-42e7-94d9-cfa1ac5c326e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c2ffc2d86497fa4772f94fa2abbf91b, https://si.imgix.net/2caed2f9/uploads/origins/12ad04f3-6f9a-42e7-94d9-cfa1ac5c326e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdac5690557f7047603bb07fb935e591 2x, https://si.imgix.net/2caed2f9/uploads/origins/12ad04f3-6f9a-42e7-94d9-cfa1ac5c326e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6b07ab05e4a93d5f24cb45aa2e96b35 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは、タズルン！\n\n以前描いていただいたイラストがとても気に入ったので、もしよろしければまたお願いしたいです！二人のキャラクターのイラストをお願いしたいです！私のVTuber(Zoiteki)と友人のOC(@foung_shui)を一緒に描いてください。\n\nゾイテキは日焼けした肌のオニで、白い髪と赤い角、尖った耳が特徴です！普段はストイックで無表情ですが、ドジで照れ屋で、笑顔が素敵です！\nhttps://imgur.com/a/4KKhtHI\n\n日焼けした肌のキツネの女の子で、頭と尻尾にスライムを持っている。このスライムは魔法の力を持ち、様々な物や形を作り出すことができる。普段はクールに描かれているが、照れ屋な一面も。\nhttps://drive.google.com/drive/folders/1eTG5UOn0QEcpLyvgbHj3isFf8OXzyA-B\n\n好きな服装で描いても、普段の服装で描いても構いません！ポーズや表情はお任せします！\n\nまたよろしくお願いします！\n\nhttps://imgur.com/a/4KKhtHI", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/26", "thumbnail_src": "https://si.imgix.net/1b27e452/uploads/origins/5514a1c1-7622-44cd-8c5a-a38cc598cbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4701aaae80e8ca49ab8640be3c3b0a86", "thumbnail_srcset": "https://si.imgix.net/1b27e452/uploads/origins/5514a1c1-7622-44cd-8c5a-a38cc598cbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4701aaae80e8ca49ab8640be3c3b0a86, https://si.imgix.net/1b27e452/uploads/origins/5514a1c1-7622-44cd-8c5a-a38cc598cbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a08e3191c6ae6adf6d4f38050e0c16f6 2x, https://si.imgix.net/1b27e452/uploads/origins/5514a1c1-7622-44cd-8c5a-a38cc598cbbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=030f9dd2af7c444a22ddd9da62eaf6a5 3x", "genre": "art", "nsfw": true, "body": "キャラ:アイドルマスターシンデレラガールズ\n城ヶ崎美嘉\nにて描いていただけますと幸いです。\nvの絵の胸とかがちらりしてる感じがすてきなので同じような雰囲気で\n衣装はtシャツとホットパンツぐらいのトレーニングウェアで\nトレーニング頑張ろうねって感じに一緒に柔軟してるときに胸とかパンツ見えちゃってる感じだとうれしいです\n\nご検討よろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/25", "thumbnail_src": "https://si.imgix.net/af990ffb/uploads/origins/a556fd77-dbec-4447-83eb-3078bc90d793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccb12134a3cd37eb890e1c6bc5662e3a", "thumbnail_srcset": "https://si.imgix.net/af990ffb/uploads/origins/a556fd77-dbec-4447-83eb-3078bc90d793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccb12134a3cd37eb890e1c6bc5662e3a, https://si.imgix.net/af990ffb/uploads/origins/a556fd77-dbec-4447-83eb-3078bc90d793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bfb9b8b6934362897567cac6eb6e2b19 2x, https://si.imgix.net/af990ffb/uploads/origins/a556fd77-dbec-4447-83eb-3078bc90d793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0fff5d1cc0c29bc1bcef9b4bf01c642 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tazrn1/works/24", "thumbnail_src": "https://si.imgix.net/2bc28dbd/uploads/origins/558e3512-17b5-46e2-9947-32d6b42ea12c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c87d18305dea2429d96ac762668145", "thumbnail_srcset": "https://si.imgix.net/2bc28dbd/uploads/origins/558e3512-17b5-46e