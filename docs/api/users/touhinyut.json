fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8569b8311cdc6b3d32b7e3628b4eb00 3x", "genre": "art", "nsfw": false, "body": "touyinhutさん、こんにちは！あなたのアピールを受け取りました！カリスタをぜひ描いてください！\n\n例として、あなたの絵の中で私のお気に入りのものをいくつか紹介します！\nhttps://skeb.jp/@touhinyut/works/22\nhttps://skeb.jp/@touhinyut/works/18\n\n私のギャラリーです：\nhttps://kallista.carrd.co/#sfw-reference", "created_at": "", "completed_at": ""}, {"path": "/@touhinyut/works/30", "thumbnail_src": "https://si.imgix.net/e157468f/uploads/origins/a9e76871-ceb9-4d9a-913b-6d436975ad30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d525bbde4e347f3502eab90187c23b3", "thumbnail_srcset": "https://si.imgix.net/e157468f/uploads/origins/a9e76871-ceb9-4d9a-913b-6d436975ad30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d525bbde4e347f3502eab90187c23b3, https://si.imgix.net/e157468f/uploads/origins/a9e76871-ceb9-4d9a-913b-6d436975ad30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55bac6b3b34d1bf33504ec8731829e04 2x, https://si.imgix.net/e157468f/uploads/origins/a9e76871-ceb9-4d9a-913b-6d436975ad30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0e679f84baabc3714f208bbeda35864 3x", "genre": "art", "nsfw": false, "body": "こんばんは！アピールありがとうございます！\nちむ仔。さんのコミカルながらもちょっとダークで含みのあるイラストが面白かったので、あらためてリクエストさせていただきます。\n\n・渡邉あなおを描いていただきたいです。\n・ホラーゲームをプレイ、もしくは現場にいるかのような雰囲気があると嬉しいです。\n・私自身、ホラーはものすごく苦手で、自分でプレイすると夜にトイレへ行けなくなります。\n\n・渡邉あなおの容姿、三面図は資料URLの先にご用意しております。右目下のほくろ、⭐︎の髪留めがあれば大体私です。\n・衣服の雰囲気、配色はお任せします。\n\nSNS活動にてご活用させていただきたく、透過できる形式だと嬉しいです。\n\n以上となります、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/14KBnOUOco6PJhfbD3ivZg5eEPSWuU2zs?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@touhinyut/works/29", "thumbnail_src": "https://si.imgix.net/8ffe329d/uploads/origins/26a96d68-aa26-4c1d-b865-1d861a3c8d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=def7cc677f2ecdb2a6964a1