3-553899a2fa68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c8f5f310057de0b4055b246000a4570, https://si.imgix.net/42f23cee/uploads/origins/ddc6ce2c-1d9d-40de-8a03-553899a2fa68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f4a601999ade0246045d133047f9b1d 2x, https://si.imgix.net/42f23cee/uploads/origins/ddc6ce2c-1d9d-40de-8a03-553899a2fa68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c5e55db3ea35c16c08691bd1da236bb 3x", "genre": "comic", "nsfw": false, "body": "おはようございます！\n2025年は三杯酢さんの料理人とパトロンのコミックが\nとっても楽しく、ご飯食べるのも楽しく過ごせました。\nありがとうございました！\n\nお題はガレット・デ・ロワまたはペリメニ（ロシアの水餃子）です、\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@sanbaizoo333/works/173", "thumbnail_src": "https://si.imgix.net/7273c59e/uploads/origins/fb7bdbe8-09c9-441e-9bfe-8ea9c1453d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4654fd4edbff3f4a778964b6caab5d89", "thumbnail_srcset": "https://si.imgix.net/7273c59e/uploads/origins/fb7bdbe8-09c9-441e-9bfe-8ea9c1453d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4654fd4edbff3f4a778964b6caab5d89, https://si.imgix.net/7273c59e/uploads/origins/fb7bdbe8-09c9-441e-9bfe-8ea9c1453d72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=861245ad74adad683e80ffe7c117166f 2x, https://si.imgix.net/7273c59e/uploads/origins/fb7bdbe8-09c9-441e-9bfe-8ea9c1453d72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f92c6e183f040524ff3f7663b310773d 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nSNSで拝見したときに貴方の描く糸目キャラに心惹かれ、三杯酢様に依頼をさせていただきたくリクエストさせて頂きました。\n\n今回リクエストしたいのはCoC『その真紅に愛を見る』HO召使役の全身立ち絵をお願いします。\n\n使用用途：TRPGの立ち絵\n商用利用：無\n\n▼キャラクターの詳細\n性別：男性　中性的\n年齢：30歳\n顔パーツ：\n少し目の開いた糸目　タレ目気味　黒目\n口角上げた閉じた口　小さめ\nまつ毛は下方向に長めの西洋ドールのようなものだと嬉しいです\n身長：165～170\n体型：細身\n髪型：片目隠れセンターパート（ヤングレオ？）うなじ辺り結んだ長めのポニーテール\n髪色：ミルクティー色～白よりの金色　毛先に赤のグラデーション\n服装：蝶ネクタイタイプの黒のタキシード　黒手袋　オーバーサイズ気味だと嬉しいです\nポーズ：手を水平にしている偉そうな拍手\n背景色：透過\n\nよろしければ何卒よろしくおねがいいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sanbaizoo333/works/172", "thumbnail_src": "https://si.imgix.net/09cc4bdb/uploads/origins/43319261-72af-4bb6-a001-76fcf2f8fc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2097e9c9ad761ea0b476b2d55295afd", "thumbnail_srcset": "https://si.imgix.net/09cc4bdb/uploads/origins/43319261-72af-4bb6-a001-76fcf2f8fc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2097e9c9ad761ea0b476b2d55295afd, https://si.imgix.net/09cc4bdb/uploads/origins/43319261-72af-4bb6-a001-76fcf2f8fc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5eb9169a5e9e5306d57341effc53c14b 2x, https://si.imgix.net/09cc4bdb/uploads/origins/43319261-72af-4bb6-a001-76fcf2f8fc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca8dba9d7c97976aeb8306195f3c0148 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n今回はTRPGでの自キャラの差分を描いていただきたく依頼させていただきました。今回書いていただきたい差分と致しましては白無垢を描いて頂きたいと考えています。\n◾️キャラプロフ 性別:女 身長:171cm 体重が68kg \n設定、及び性格面\n寒い時期なのに風邪をひいた事がないという理由で色々な所が出ている服装をしている女。元々こう言う趣味だったとかそういう感じではなく元々は少し根暗な絵を描くことが大好きな少女だった。身体の色素が生まれつき薄く目が金色であった為に学校では虐められており、その噂が広がったのか外でも絡まれ虐められるようになった。その後少しの間虐められ続けていたがある時に学校の外で調子に乗った男にそういう事をされそうになるがたまたま近くを通りがかったバイクに乗った女性に助けられかっこいい女性に憧れるようになる。その日から眼鏡を外しコンタクトに変え、隠すようにしていた歯を見せつけるように笑うようになりその人から貰った帽子を着けるようになった。\n私が思う強い私になるべく毎日頑張っているが絵は嫌いになった訳ではないので毎日描き続けている。たまにペンキが髪についたまま出ていくがイメチェンの可能性があるとして友達から指摘されたことは無い。バイクには乗りたいが親から止められたのでしゅんとしながら諦めている。\n星座はおとめ座\n誕生花はヒペリカム 花言葉は秘密、きらめき\n好きな食べ物はパンケーキで飲み物はホットミルク、砂糖は入れる派\n見せないようにしているが可愛いもの趣味なのでぬいぐるみや可愛いアニメを見る時は目が輝いている。\n◾️できればで構わないのですが、1枚か2枚ほど表情差分をいただけると大変助かります。 ◾️その他 立ち絵、また元となる白無垢の方はGoogleドライブの方にアップロードしておきましたのでご確認ください。綿帽子の方を無くし、紫色の蝶の髪飾りを付けて頂けるととても嬉しいです。一応NFSWの方をつけさせていただきます。不明な点は三杯酢さんにお任せします。 以上、リクエストよろしければ承認お願いします！\n\nhttps://drive.google.com/drive/folders/1x9Ex5Bn4TUMK8OBAeCaJqtaV-pG9vwC_", "created_at": "", "completed_at": ""}, {"path": "/@sanbaizoo333/works/171", "thumbnail_src": "https://si.imgix.net/84a809ad/uploads/origins/85ced897-b062-44eb-a639-7f8742cb1e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4123a23220dc2d55f2cf4dbe7d196df5", "thumbnail_srcset": "https://si.imgix.net/84a809ad/uploads/origins/85ced897-b062-44eb-a639-7f8742cb1e16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4123a23220dc2d55f2cf4dbe7d196df5, https://si.imgix.net/84a809ad/uploads/origins/85ced897-b062-44eb-a639-7f8742cb1e16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6913c4036fd9bcd2a2fe301302d69796 2x, https://si.imgix.net/84a809ad/uploads/origins/85ced897-b062-44eb-a639-7f8742cb1e16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4892ac45d056b47cb755e0cf3751c32d 3x", "genre": "art", "nsfw": false, "body": "初めまして、TLでイラストを拝見し、赤基調のイラストがとても素敵で、PCのイラストをご依頼したく、連絡させていただきました。\n\n以下、依頼するPCの資料などとなります。\n\n一二三（うたかね）\n男/200cm\n『ようこそ！迷冥市役所都市伝説課へ！』HO1:都市伝説課の担当者\nモチーフ：ベキリーブルーガーネット\n明るい紫色のインナーカラーが入った紺色の髪と、同じく明るい紫色と紺色のオッドアイをしている。\n右目の下に2つ、左目の斜め下に1つほくろがある。\n瞳孔だけ赤いのがトレードマーク。\n真っ白の服を着て、いつもうっすら笑みを浮かべている、飄々としたぬいぐるみ作りが好きなお兄さん。\n仕込み杖を武器として持っている。\n\n立ち絵をまとめたファイル\nhttps://drive.google.com/drive/folders/11cG6i9MBLiMiIka0Cpj_vmAg2j2QUxcA\n\n・構図について\nこちらに向かって笑っている赤基調のイラストをお願いします。\n細かい構図や服装に関してはお任せしたいと考えております。\n\n・使用用途について\n個人観賞用に印刷、個人的な利用（スマホのホーム画面の壁紙に設定するなど）、ID記載のうえSNSでの利用（アイコンにするなど）、自陣への共有をさせていただきたいです。\n\n不備などがありましたら申し訳ございません。\nお手数ですが、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@sanbaizoo333/works/170", "thumbnail_src": "https://si.imgix.net/345c79e7/uploads/origins/b6c3b57c-afcf-4043-8155-c341a4fb80fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7cd129ee120b6e946d98846f108e460d", "thumbnail_srcset": "https://si.imgix.net/345c79e7/uploads/origins/b6c3b57c-afcf-4043