/origins/428ffda9-1abf-42a0-984d-4dfbc47107d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c6c4f82ef6a678aa98dc4a431247415", "thumbnail_srcset": "https://si.imgix.net/11c6b8da/uploads/origins/428ffda9-1abf-42a0-984d-4dfbc47107d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c6c4f82ef6a678aa98dc4a431247415, https://si.imgix.net/11c6b8da/uploads/origins/428ffda9-1abf-42a0-984d-4dfbc47107d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31a5ebcbaca82b6fdaa8d14c09dd6328 2x, https://si.imgix.net/11c6b8da/uploads/origins/428ffda9-1abf-42a0-984d-4dfbc47107d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98987fc46eee0b3969f2e8266ab2c183 3x", "genre": "art", "nsfw": true, "body": "私のオリジナルキャラクター、シャーロットを描いてください\n\n構図などは自由ですので、ご自由に描いてください\n\nありがとうございました！\n\nhttps://twitter.com/ac8231/status/1599269635974914048", "created_at": "", "completed_at": ""}, {"path": "/@perori/works/56", "thumbnail_src": "https://si.imgix.net/16a72b32/uploads/origins/cf5db1c8-2c3f-4b0d-ba15-f6522fff2630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3032ff4d150b7614f033c1197fa8f8ac", "thumbnail_srcset": "https://si.imgix.net/16a72b32/uploads/origins/cf5db1c8-2c3f-4b0d-ba15-f6522fff2630?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3032ff4d150b7614f033c1197fa8f8ac, https://si.imgix.net/16a72b32/uploads/origins/cf5db1c8-2c3f-4b0d-ba15-f6522fff2630?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff0791835866edeeacf03dcbb979edd7 2x, https://si.imgix.net/16a72b32/uploads/origins/cf5db1c8-2c3f-4b0d-ba15-f6522fff2630?bg=%23fff&auto=f