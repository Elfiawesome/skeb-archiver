00&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9476a47d2c2c69eaba42d78a3ac3fda7 2x, https://si.imgix.net/b9b6bedb/uploads/origins/27aa2996-81fa-4a9b-80d3-c930089f56d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64206efb9cbcba4167532155208a9b9e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@t_mizushiro/works/8", "thumbnail_src": "https://si.imgix.net/dc41ffcb/uploads/origins/cd5b9dbd-1569-4090-92bd-4d9aaffc6763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09171a37769e438374b971eecad5537e", "thumbnail_srcset": "https://si.imgix.net/dc41ffcb/uploads/origins/cd5b9dbd-1569-4090-92bd-4d9aaffc6763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09171a37769e438374b971eecad5537e, https://si.imgix.net/dc41ffcb/uploads/origins/cd5b9dbd-1569-4090-92bd-4d9aaffc6763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd2e90b91dfc9f3a054dbda49084279e 2x, https://si.imgix.net/dc41ffcb/uploads/origins/cd5b9dbd-1569-4090-92bd-4d9aaffc6763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2e5109b29223151f5f3aaff6ede9f76 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n『ロックマン』シリーズから『ロールちゃん』のイラストをお願いします。\n\n細かなシチュとしましては、\n資料のような一人称視点での顔面騎乗で相手の顔に股間を押し付けているような感じで描いてくださればと思います。\n表情はどうしてもとお願いされて赤面しながらはにかみ笑顔の様な感じで。\n衣装は以前描かれていたロールちゃんの\nhttps://www.pixiv.net/artworks/108832239\nの衣装とイチゴパンツとよろしければ\nhttps://img.atwiki.jp/niconicomugen/attach/1024/19183/TvCRoll.jpg\nの赤ワンピ、白パンツの2パターンお願いします。\n（金額不足の場合はお手数ではございますが再送お願いします。）\n\n以上になります。\nよろしければご検討のほどよろしくお願いします。\n\nhttps://skeb.jp/@jingai_club/works/54", "created_at": "", "completed_at": ""}, {"path": "/@t_mizushiro/works/7", "thumbnail_src": "https://si.imgix.net/88acdc1f/uploads/origins/a779f063-47cc-4dd0-8c16-f