8a7a-24aeacfd213c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e71307050853c1efcd5e1fcca404d430 2x, https://si.imgix.net/2d052236/uploads/origins/107da985-8ec1-4e1c-8a7a-24aeacfd213c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef63f97e9fc7144547fe5f6b156dc092 3x", "genre": "art", "nsfw": false, "body": "はじめまして、今回は私の創作カプを描いていただきたくリクエストを送らせていただいております。 URL先にわかりにくくはありますが容姿などまとめております。ご確認ください。\n自創作カプはヤンデレ陰キャ×ネガティブ陰キャの百合です。 ふたりは同棲しています。氷室落が青羽るりに｢同棲しないと殺す｣と脅しをかけたことから同棲がスタートしました。 青羽るりはその同棲を心底恐ろしがっており、日々ビクビクしながら過ごしています。氷室落はその反対で毎日一緒に居られることが心底嬉しく、絶対に離してやらないとも思っています。\n\n服装\nおまかせでお願いしたいのですが\n青羽るり｢ボーイッシュ スキニー｣\n氷室落｢サブカル 地雷｣\nと検索すると出てくるような服装が希望です。\nまた、氷室落の服装が半袖の場合、見える左腕には\"手首から肩までのアムカ跡\"の描写をお願いしたいです。\n\n描写範囲\n描写範囲はおまかせするのですが、できる限り見切れがないとうれしいです。\n\n雰囲気\n暗い雰囲気\n\nふたりのモチーフ\n氷室落\nカミソリ、美少女アニメのグッズ、小説\n青羽るり\nノートPC、青いバラ\n\n構図や細かいものは全ておまかせで、上記から想起される氷室落と青羽るりのイラストを描いていただきたいです。氷室落が青羽るりを愛しすぎて愛おしすぎて、偏愛、不穏、不穏、とにかく不穏であると嬉しいです。流血、暴力、ヒステリック、嫌な空気が漂っていると嬉しいです。\n\n長々と失礼しました、ご検討の程よろしくお願いします。\n\nhttps://imgur.com/a/AmzeBl8", "created_at": "", "completed_at": ""}, {"path": "/@10ma_t/works/4", "thumbnail_src": "https://si.imgix.net/182c390f/uploads/origins/e4d06185-9b3f-4012-be16-14e19ecfb8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef7dda2b02a5017ae6f5a07559e7a37", "thumbnail_srcset": "https://si.imgix.net/182c390f/uploads/origins/e4d06185-9b3f-4012-be16-14e19ecfb8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eef7dda2b02a5017ae6f5a07559e7a37, https://si.imgix.net/182c390f/uploads/origins/e4d06185-9b3f-4012-be16-14e19ecfb8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5737a4dc873943537c554fbec6421c0 2x, https://si.imgix.net/182c390f/uploads/origins/e4d06185-9b3f-4012-be16-14e19ecfb8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=827b07fc6da1ec6af2d7b2b26ef6b67f 3x", "genre": "art", "nsfw": false, "body": "