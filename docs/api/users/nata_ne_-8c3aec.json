format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd58bd8c9b028097c81c12562a45910e 2x, https://si.imgix.net/d5d188f3/uploads/origins/6c41e31f-d047-4d89-b8b4-dc1e8f62e1b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a8502f1c7eb40e39d246ddbcc9c50c4 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\n僕のヴァンパイア・ザ・マスカレードのオリジナルキャラクター、アンドレアを描いてほしいんだ。\n\n壁に向かって首を押されている彼を描いてくれませんか？\nあるいは、どんな風に描いても構いません！\n\nありがとうございました：\n\nhttps://drive.google.com/drive/folders/1osCsq156sfG6cQjXJgrrml9NW_vPHuuQ?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nata_ne_/works/18", "thumbnail_src": "https://si.imgix.net/9c43380d/uploads/origins/99bd4fdf-104b-4f88-9d56-92febf380743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efa3f6dcf0d03ead8889aa6cdf848710", "thumbnail_srcset": "https://si.imgix.net/9c43380d/uploads/origins/99bd4fdf-104b-4f88-9d56-92febf380743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=efa3f6dcf0d03ead8889aa6cdf848710, https://si.imgix.net/9c43380d/uploads/origins/99bd4fdf-104b-4f88-9d56-92febf380743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ea3e55150e5036648dc4ba6b1e83e1a 2x, https://si.imgix.net/9c43380d/uploads/origins/99bd4fdf-104b-4f88-9d56-92febf380743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebf49b0ec50b4ffd686b635a15815a23 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nata_ne_/works/17", "thumbnail_src": "https://si.imgix.net/c11963e9/uploads/origins/32eca4d3-cecf-44cb-9805-181f1fab994d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f47a7c04a71198a65d5d6d4c9e0fbe63", "thumbnail_srcset": "https://si.imgix.net/c11963e9/uploads/origins/32eca4d3-cecf-44cb-9805-181f1fab994d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f47a7c04a71198a65d5d6d4c9e0fbe63, https://si.imgix.net/c11963e9/uploads/origins/32eca4d3-cecf-44cb-9805-181f1fab994d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=492f2488e0c43be96e657035cbbbff9f 2x, https://si.imgix.net/c11963e9/uploads/origins/32eca4d3-cecf-44cb-9805-181f1fab994d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c4617b5328d09c34973c7c75eaed1cf 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nata_ne_/works/16", "thumbnail_src": "https://si.imgix.net/861e56b9/uploads/origins/2c968969-9347-492a-8728-fa99f5c71eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73ebe410c6246fcbf77e921a425f642f", "thumbnail_srcset": "https://si.imgix.net/861e56b9/uploads/origins/2c968969-9347-492a-8728-fa99f5c71eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73ebe410c6246fcbf77e921a425f642f, https://si.imgix.net/861e56b9/uploads/origins/2c968969-9347-492a-8728-fa99f5c71eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1aef31fb6ce22fad8ab66bd3e5fbad5e 2x, https://si.imgix.net/861e56b9/uploads/origins/2c968969-9347-492a-8728-fa99f5c71eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5ba4de06bf9da5e2746a8074388cd8d 3x", "genre": "art", "nsfw": false, "body": "Hello! I love your art!\n\nI'd be so happy if you could draw my \"すばらしき世界\" couple, ショウ and ウクワ! \nIf you can't draw copyright characters, please draw ウクワ on his own!\n\nウクワ is a horologist. He makes clocks. He is also a grim reaper with a hydrangea motif. He's very grumpy and he rushes around a lot. He's very concerned about time.\n\nショウ is also a grim reaper and he is very strong. He's loud, smug and he loves mathematics. He makes towers of trash and calls it art.\n\nショウ and ウクワ are on and off exes. ウクワ broke up with ショウ, but they keep coming back together. They are very into each other. ショウ knows that ウクワ likes him but ウクワ is in denial. \n\nPose, expression and composition are up to you!\n\nウクワ (He has two different eye colours):\nhttps://toyhou.se/22501620.ukuwa-toshi/gallery\n\nショウ https://drive.google.com/drive/folders/1YTkC5rV1Xj_w3ckNpijC3KXhPZOV0bbi?usp=sharing\n\nhttps://drive.google.com/drive/folders/1Z4rtJdNhuvR66Ro_N14segIjAY3qO0_6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nata_ne_/works/15", "thumbnail_src": "https://si.imgix.net/ed82033d/uploads/origins/22778a20-f17e-4ef9-99a0-2166b84fe7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8c8d29e8facc6b10cce233d1904c27", "thumbnail_srcset": "https://si.imgix.net/ed82033d/uploads/origins/22778a20-f17e-4ef9-99a0-2166b84fe7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8c8d29e8facc6b10cce233d1904c27, https://si.imgix.net/ed82033d/uploads/origins/22778a20-f17e-4ef9-99a0-2166b84fe7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9c16dc137971ba4d350de48cd10441e 2x, https://si.imgix.net/ed82033d/uploads/origins/22778a20-f17e-4ef9-99a0-2166b84fe7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c28b7c08ba512d3b8a8e60943731b671 3x", "genre": "art", "nsfw": false, "body": "リクエストを受けてくださってありがとうございます。私のオリジナルキャラクターを描いていただけませんか？画風はお任せします。キャラクターのやりとりを描いたイラストページが好きです。設定の変更もOKです。\n\nガエルダンピール（半吸血鬼）になったウッドエルフの長身痩躯の男性司祭。髪型はボブで、今は少し乱れている。エルフのような顔立ちで、吸血鬼ゆえに威圧的なこともある。親切で優しく、浮気性で愛情深い。料理好き。服や首に鳩のシンボルのお守りがあり、ペットを飼っている。\n\nモミ中背のウッドエルフ・ハンター（性別は不問）。美しく、無謀で、強く、弓術と木と探検を愛する。長い黒髪。モミは内気で飄々としており、他の人に対しては無礼だが、ガエルの前では自信家で茶目っ気がある。\n\n2人は恋人同士であり、幼なじみでもある。一緒にいるとロマンチックに顔を赤らめることが多く、またお互いをからかって楽しんでいる。私のSkebのユーザーページにも参考文献があります。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1g_wy_HQZacCw5C2TRPysGiJnhq0brUfH", "created_at": "", "completed_at": ""}, {"path": "/@nata_ne_/works/14", "thumbnail_src": "https://si.imgix.net/19371b06/uploads/origins/e500a18a-dcb0-4d41-a0ad-6bfb62e48425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20f9c1ce509c1a375649bf191e2b7071", "thumbnail_srcset": "https://si.imgix.net/19371b06/uploads/origins/e500a18a-dcb0-4d41-a0ad-6bfb62e48425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20f9c1ce509c1a375649bf191e2b7071, https://si.imgix.net/19371b06/uploads/origins/e500a18a-dcb0-4d41-a0ad-6bfb62e48425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76330652b34861d1e599781f584800be 2x, https://si.imgix.net/19371b06/uploads/origins/e500a18a-dcb0-4d41-a0ad-6bfb62e48425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c9071d5ebfa3fd2699cfb62a1f251fd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私はあなたの線画のような色彩豊かなスタイルが大好きです！\n\n私の女性オリジナルキャラクターと、彼女の片思いの男性のかわいいポーズの全身アートを、あなたのスタイルで描いていただけませんか？彼がキスをしようとしている間、彼女は恥ずかしがっています。彼は彼女を強く抱きしめ、身長差のために彼女を地面から少し持ち上げています。  ありがとうございました！\n\nポーズサンプル：https://rust-scabiosa-2b2.notion.site/Pose-331eb52816814b5fa7e446f0b4ca8fff?pvs=4\n\nキャラクター1：アイール（160cm）・・・明るい性格の緑髪のバニーガール。\n参考：https://rust-scabiosa-2b2.notion.site/Aeir-cb3de896687f4d48ba27ab41c94bc22b?pvs=4\n\nキャラクター2：クラッシュ雄（177cm）・・・黒髪の優しい性格の羊の男の子。\n参考：https://rust-scabiosa-2b2.notion.site/Ramm-4c494feda3b34908a1bebcd3a55f454e?pvs=4\n\nhttps://rust-scabiosa-2b2.notion.site/Full-4d6e8f70ae724c02a547e0b94958dcf4?pvs=4", "created_at": "", "completed_at": ""}, {"path": "/@nata_ne_/works/13", "thumbnail_src": "https://si.imgix.net/0f008127/uploads/origins/f2943567-5347-4567-bbf5-3cda484d6f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b1be4efb07b6d12b55c61cb09c84dbd", "thumbnail_srcset": "https://si.imgix.net/0f008127/uploads/origins/f2943567-5347-4567-bbf5-3cda484d6f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b1be4efb07b6d12b55c61cb09c84dbd, https://si.imgix.net/0f008127/uploads/origins/f2943567-5347-4567-bbf5-3cda484d6f96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9d88b75e2653c2e9534d1d82d5a8922 2x, https://si.imgix.net/0f008127/uploads/origins/f2943567-5347-4567-bbf5-3cda484d6f96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24b37901770da404abce93b7ff257787 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたのアートワークが大好きで、僕と友達のDamienDreadVTのアートワークを作ってもらえないかなと思っていたんだ。僕たちはカップルなんだ。\nポーズはあなた次第だけど、キュートでちょっとロマンチックなものを希望してるの。\n私たちは二人ともvTuberで、彼の方が背が高いんです。私は身長160cm、彼は175cmです。\n二人ともイタズラ好きで、ふざけるのが大好きです！\n\nこれは彼の参考資料です：\nhttps://drive.google.com/file/d/1L4KH0RxQVBqH3eO8NLWeHqJqNfXhpylM/view?usp=sharing\nhttps://drive.google.com/file/d/1DupbXdlYTWPMARD1FxtvfYOUgnaJiMmV/view?usp=sharing\n\nそしてこれが私のものです：\nhttps://drive.google.com/file/d/1dYhiGmSeB5vQvhmdVXi8PaseLvsQbJef/view?usp=drive_link\nhttps://drive.google.com/file/d/1gZruZ6L8Y_i9mzmm8eMACl9HW9-SnPKN/view?usp=drive_link\nhttps://drive.google.com/file/d/1NvEKA_MmsEiv-5uMEA2vdtVPqwvPfnPp/view?usp=drive_link\n\n本当にお疲れ様でした！", "created_at": "", "completed_at": ""}, {"path": "/@nata_ne_/works/12", "thumbnail_src": "https://si.imgix.net/af7bfaf3/uploads/origins/958d5c86-e7ff-4292-93bd-07ce30b69924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&