orded_at": "2026-02-19T02:10:07.753763+00:00"}]}, "current_prices": {"art": 15000, "correction": 2000}, "price_range": {"art": {"min": 8000, "max": 19000}, "correction": {"min": 2000, "max": 2000}}, "links": [{"label": "Twitter", "url": "https://x.com/he_be_r", "name": "he_be_r"}, {"label": "Misskey_io", "url": "https://misskey.io/@he_be_r", "name": "he_be_r"}, {"label": "Website", "url": "https://mml95q2p.fanbox.cc", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/6645", "name": "6645"}], "flags": {}, "works": [{"path": "/@he_be_r/works/148", "thumbnail_src": "https://si.imgix.net/78abe258/uploads/origins/16fe02ca-4f4a-42d4-abe2-c0743d1761c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38a46d80550d02eeb2fc5d395b04269c", "thumbnail_srcset": "https://si.imgix.net/78abe258/uploads/origins/16fe02ca-4f4a-42d4-abe2-c0743d1761c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38a46d80550d02eeb2fc5d395b04269c, https://si.imgix.net/78abe258/uploads/origins/16fe02ca-4f4a-42d4-abe2-c0743d1761c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d49d12d63d241bab54b324d6393b4cc0 2x, https://si.imgix.net/78abe258/uploads/origins/16fe02ca-4f4a-42d4-abe2-c0743d1761c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2e02f14c7ce6c3e171cda20be212adc 3x", "genre": "art", "nsfw": true, "body": "ブルーアーカイブの美甘ネルをお願いします。\nシチュは任務失敗からの敗北レイプ。\n服は戦闘でボロボロになった上に乱暴に破られ剥かれた半裸、お手間でしたら全裸でも。\n仰向けに押さえつけられての正常位で、容赦なく中出しされている。\n表情は悔しそうにこちらを睨みつけるいわゆるニラマレ。\n（表情イメージ：https://www.pixiv.net/artworks/136500695）\nもしよろしければ、画面端に受精のカットインをお願いします。\n\n以上、ご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/147", "thumbnail_src": "https://si.imgix.net/0d71f730/uploads/origins/4a69b5a4-0152-4785-b7af-98ced3241a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a157fd0b00f281d7a5dcf3ff06f322a", "thumbnail_srcset": "https://si.imgix.net/0d71f730/uploads/origins/4a69b5a4-0152-4785-b7af-98ced3241a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a157fd0b00f281d7a5dcf3ff06f322a, https://si.imgix.net/0d71f730/uploads/origins/4a69b5a4-0152-4785-b7af-98ced3241a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e5919b792242f32b9de5d45f8c276cd 2x, https://si.imgix.net/0d71f730/uploads/origins/4a69b5a4-0152-4785-b7af-98ced3241a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=173dfcad98f45e2814db5a6a1deb4f26 3x", "genre": "art", "nsfw": true, "body": "「ネガティヴハッピィ」のマナカ（友永愛佳）をお願いします。\n\n・おっぱいパブで男にまたがって接客。マナカの斜め前からのアングル\n・本人はあくまで「普通のバイト」として笑顔で真面目に臨み、抵抗や羞恥、興奮や戸惑い等はない\n・ベビードールの首の後ろの結び目をほどいて胸を露わにし、客が胸を揉む\n（画像b01のようなデザインで、b02のように首の後ろで結ぶタイプでお願いします。）\n・客の腰にまたがり、背中を反らし気味で股間を客の腰に押し付けながら体を揺すっている\n・薄暗い店内で大音響の音楽が鳴り、音楽に合わせて激しく動いているので汗だく\n\n本番はせず客は着衣のままで、あくまで客にまたがっているだけに留めるようお願いします。\n可能でしたら、モブとして周囲にも接客中の店員＋客がいるようにしていただきたいです。\nキャラデザは画像04～10、16～21のデフォルメ調のデザイン準拠で、髪は練習着（04～10）の時の外ハネ状態でお願いします。\n店の雰囲気は画像a01～07のような感じで、a05～07のような薄暗さだとありがたいです。\nお引き受けいただけるようでしたら、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1-Ia07yHJiR4D_niFlWJenoLRRXLJgY7C/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/146", "thumbnail_src": "https://si.imgix.net/dfad9da5/uploads/origins/f67d1eab-0134-4c34-808b-7cdeb0af2622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea77b9b254151ad33bcca41f879077f", "thumbnail_srcset": "https://si.imgix.net/dfad9da5/uploads/origins/f67d1eab-0134-4c34-808b-7cdeb0af2622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea77b9b254151ad33bcca41f879077f, https://si.imgix.net/dfad9da5/uploads/origins/f67d1eab-0134-4c34-808b-7cdeb0af2622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ade9d875f51004840d75911a490a763 2x, https://si.imgix.net/dfad9da5/uploads/origins/f67d1eab-0134-4c34-808b-7cdeb0af2622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63bc254b5ae901e2612fb93ed18ac860 3x", "genre": "art", "nsfw": false, "body": "お世話になっています。\n\nVOICEROIDの結月ゆかりさんと弦巻マキさんのイチャイチャラブラブちゅっちゅな雰囲気の百合イラストを描いていただきたいです。\nゆかりさんはノーマル衣装（パーカー無し）、マキさんはjamバンド衣装でお願いします。\n構図やポーズやシチュエーションはお任せしますので、とにかく幸せでラブラブな二人を描いていただければと。\n\nPC用の壁紙としたいので、4K(3840x2160)またはフルHD(1920×1080)などの16:9比率としていただけると助かります。\n\nそれではご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/145", "thumbnail_src": "https://si.imgix.net/495b1c4e/uploads/origins/55b97716-181a-43bf-b3bf-766f544f96a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5d1ae3f0e0a44723f7bc587562a3e3", "thumbnail_srcset": "https://si.imgix.net/495b1c4e/uploads/origins/55b97716-181a-43bf-b3bf-766f544f96a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5d1ae3f0e0a44723f7bc587562a3e3, https://si.imgix.net/495b1c4e/uploads/origins/55b97716-181a-43bf-b3bf-766f544f96a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa313788b17beb87cd504d4591eddccf 2x, https://si.imgix.net/495b1c4e/uploads/origins/55b97716-181a-43bf-b3bf-766f544f96a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0540c6f8e6ae9ea904c1c10ae8bdf568 3x", "genre": "art", "nsfw": true, "body": "へーべーさん　お久しぶりです\n前回の絵がとてもよかったので　よかったらまたグラブルのジータちゃんがフェリちゃんの膝の上でお尻出されてペンペンされる絵をカラーでお願いしたいです\n今回は二人が水着でお願いしたいです　可能なら場所もビーチかプールとかにしてもらいたいです\n水着のボトムが脱ぎ辛いなら真ん中に寄せでお尻肌面積を多くしてお願いします\n\nもし可能なら下書き入のPSDが欲しいですが　なくでも大丈夫です\n\nご検討のほどよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/144", "thumbnail_src": "https://si.imgix.net/53b76a42/uploads/origins/a1140be1-c487-4ae2-9bbf-fb4d1826b1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b54d073aaac29ecf388ec303f3fdd53", "thumbnail_srcset": "https://si.imgix.net/53b76a42/uploads/origins/a1140be1-c487-4ae2-9bbf-fb4d1826b1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b54d073aaac29ecf388ec303f3fdd53, https://si.imgix.net/53b76a42/uploads/origins/a1140be1-c487-4ae2-9bbf-fb4d1826b1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2311ae782bdc8243ecc1d681a1d390f5 2x, https://si.imgix.net/53b76a42/uploads/origins/a1140be1-c487-4ae2-9bbf-fb4d1826b1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4aff4a843ff41d03f3c1cff017bc3e3 3x", "genre": "art", "nsfw": true, "body": "射精する魔理沙（ふたなり）をお願いします。　\n\n◆魔理沙が太もものタイツ内で射精。　\nその部分に穿いているソックス（手で扱いた跡あり）から\nダラダラと精液が溢れ出ている。　\n◆脚をセクシーに強調した構図。　\nソックスのリブ溝は凹凸感が出ていると嬉しいです。　\n※できればスカートも脱がさないでください。　\n◆溜まっていたので嬉しそうな表情。　\n魔理沙１人か、相手がいるかはお任せします。　\n\n宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17lqs7cxtm1W96jM-mxLsS9oWju4Wh_F6?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/143", "thumbnail_src": "https://si.imgix.net/df000b8f/uploads/origins/da1a75d7-86d3-472c-a868-bd694ce7f0df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac11fb46f00db8355bd413938b37d93f", "thumbnail_srcset": "https://si.imgix.net/df000b8f/uploads/origins/da1a75d7-86d3-472c-a868-bd694ce7f0df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac11fb46f00db8355bd413938b37d93f, https://si.imgix.net/df000b8f/uploads/origins/da1a75d7-86d3-472c-a868-bd694ce7f0df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85056f72ade02de6dc35883582507b50 2x, https://si.imgix.net/df000b8f/uploads/origins/da1a75d7-86d3-472c-a868-bd694ce7f0df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76ec2dbaa14fcc567c37f2c00a76a388 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\nΖΖのエルピー・プルとプルツーの百合を描いてください。二人が仲良くしてるのを見たい。\n指マンも貝合わせでもいいよ。\nプルの服は何でもいいですが、プルツーはノーマルスーツを着てほしいです。破いても大丈夫です！\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/142", "thumbnail_src": "https://si.imgix.net/b6089b4f/uploads/origins/2f51707d-2d65-4fb2-9c27-4570d00f7d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34836dc0be735f28d7619effac04db02", "thumbnail_srcset": "https://si.imgix.net/b6089b4f/uploads/origins/2f51707d-2d65-4fb2-9c27-4570d00f7d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34836dc0be735f28d7619effac04db02, https://si.imgix.net/b6089b4f/uploads/origins/2f51707d-2d65-4fb2-9c27-4570d00f7d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47b5fe4426c90e83f49ca14f99b9e242 2x, https://si.imgix.net/b6089b4f/uploads/origins/2f51707d-2d65-4fb2-9c27-4570d00f7d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85f6a30a90dd82dcdb10469bb0a81c03 3x", "genre": "art", "nsfw": true, "body": "先日はモノクロ垢でマリアを描いて頂きありがとうございました。\n今回はこちらでリクエストさせて頂きます。\n\n可能でしたら、以前描いて頂いたこちら（https://skeb.jp/@he_be_r/works/132）のフーガウロのイラストの差分をお願いしたいです。\n\n\n・両方の穴に射精される差分\n・レイプ目で放心状態＋ボテ腹差分\n金額、作業時間的に可能でしたら\n・快感を感じてしまっている表情差分\n\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/141", "thumbnail_src": "https://si.imgix.net/e4b5082c/uploads/origins/eabfc4c2-e96b-478b-9d5d-ff484d4dcc12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a3a6ab940a5e15e8e937b1ad3120287", "thumbnail_srcset": "https://si.imgix.net/e4b5082c/uploads/origins/eabfc4c2-e96b-478b-9d5d-ff484d4dcc12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a3a6ab940a5e15e8e937b1ad3120287, https://si.imgix.net/e4b5082c/uploads/origins/eabfc4c2-e96b-478b-9d5d-ff484d4dcc12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=352efc8732636d222240cdc4d27ed02f 2x, https://si.imgix.net/e4b5082c/uploads/origins/eabfc4c2-e96b-478b-9d5d-ff484d4dcc12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a096c6afb2aa0742ff83f7ae948202c3 3x", "genre": "art", "nsfw": true, "body": "へーべーさん　すみません　モノクロ垢に投げたリクは元々こっちに送る予定でしたから　せっかくだしこっちも投げてみます　同じくお任せ大半の特殊リク内容ですが　もし良ければこっちで別案をカーラーで描いてもらえると嬉しいです\n\n以下はモノクロ垢に送ったリク内容です\n\nもしよかったら グラブルのジータちゃんが女団員さんの膝の上でお尻ペンペンされる絵をお願いしたいです\n具体どの女団員はおまかせで　二人の衣装もお任せで　防具や手袋靴などは履いてない状態でお願いします\nシチュはお仕置きもプレイも　もしくはシャミももなようなお仕置きなってないのも大丈夫です\n\n可能なら下書き入のPSDが欲しいですが　なくでも大丈夫です\n\nご検討のほどよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/140", "thumbnail_src": "https://si.imgix.net/421248ee/uploads/origins/8c299340-f512-4ed3-a9d5-298f8ab2ffec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e505de5d663bf678a05cf3f85657857", "thumbnail_srcset": "https://si.imgix.net/421248ee/uploads/origins/8c299340-f512-4ed3-a9d5-298f8ab2ffec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e505de5d663bf678a05cf3f85657857, https://si.imgix.net/421248ee/uploads/origins/8c299340-f512-4ed3-a9d5-298f8ab2ffec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a3d8ab716fb3dde6ddb7d21c9cba3a5 2x, https://si.imgix.net/421248ee/uploads/origins/8c299340-f512-4ed3-a9d5-298f8ab2ffec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c00a071d037a858adad5de96acef8f3 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております。\nまた依頼させていただきます。\n\n<キャラクター>\n秘密法人デスメイカーよりケルベガスをお願いします。\nhttps://youngchampion.jp/episodes/303d8f2e4b1ba/\nhttps://i.imgur.com/nHzeV9A.jpeg\nhttps://i.imgur.com/WkltNCp.png\n\n<シチュ・構図>\nホームレス達に輪姦陵辱されるシチュエーションでお願いします。\n構図に関してはお任せします。\n服装をどのくらい剥くかはお任せしますが、胸は露出した状態でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/139", "thumbnail_src": "https://si.imgix.net/6d3beadd/uploads/origins/c3af7d2a-2bbf-4a34-9a3e-bc9903ffabb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c270bd6059f6a370c1dd2ba2332617", "thumbnail_srcset": "https://si.imgix.net/6d3beadd/uploads/origins/c3af7d2a-2bbf-4a34-9a3e-bc9903ffabb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c270bd6059f6a370c1dd2ba2332617, https://si.imgix.net/6d3beadd/uploads/origins/c3af7d2a-2bbf-4a34-9a3e-bc9903ffabb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b247ae3f360382e3fff3079a049e6e17 2x, https://si.imgix.net/6d3beadd/uploads/origins/c3af7d2a-2bbf-4a34-9a3e-bc9903ffabb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b593be2a94314167974b0ede29d7698b 3x", "genre": "art", "nsfw": true, "body": "うちの子の糸目デカ角っ子のイラストを描いて頂きたく依頼しました。\n\n[内容]\n\n自分の尻尾で資料の様なピストンをして激しいアナニーしているうちの子をお願いします。\n\n衣装の状況BH001かBH003かBH009でお任せします。\n\n[設定・資料]\n\nおっとり天然素直な性格。身体より精神年齢結構低め。\n無知無知なのでコウノトリが運んでくる派。\n\n※描写によって目を開いた方がいい場合以外はできれば糸目でお願いします。\n※左口元に艶黒子があります。\n\nよろしくお願いします。\n\n構図\nhttps://www.dropbox.com/scl/fo/880sza44svfwv5aam0nmq/AOWYHADzdedmqmNuhKDarMg?rlkey=xr5t5ggr6xcutecl3rdchsi59&dl=0\nキャラ\nhttps://www.dropbox.com/sh/y87hpqil248dgib/AAAj3xPcmApQvqcYk0Kd9YXOa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@he_be_r/works/138", "thumbnail_src": "https://si.imgix.net/945576f2/uploads/origins/9d0e589a-eb7d-4a42-8e83-f35992082ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc4b6dfa09101b8c0ebf015c8e36399e", "thumbnail_srcset": "https://si.imgix.net/945576f2/uploads/origins/9d0e589a-eb7d-4a42-8e83-f35992082ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc4b6dfa09101b8c0ebf015c8e36399e, https://si.imgix.net/945576f2/uploads/origins/9d0e589a-eb7d-4a42-8e83-f35992082ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=727197712c3c5a556199386f96dd87bc 2x, https://si.imgix.net/945576f2/uploads/origins/9d0e589a-eb7d-4a42-8e83-f35992082ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d14fa1a4bea1588d26999918e7fe9b8 3x", "genre": "art", "nsfw": false, "body": "ヘーベーさま、始めまして！\nプリンセス・プリンシパルのアンジェをスパイ衣装で描いていただけないでしょうか？\n主な装飾品はシルクハットとマントのみで、構図とポーズは効率性よりも見栄えを重視したような、中二的なカッコよさもあるといいですね。\nそれ以外の概要は過去の依頼で描いてくれた通りにしてくれれば問題ないかと。\nあとはおまかせします。ご検討の方をよろしくお願