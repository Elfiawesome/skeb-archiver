2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b233f9b9178f70f85fc9da06ed52cc6b", "thumbnail_srcset": "https://si.imgix.net/0778b5fa/uploads/origins/9a4be4d4-e27c-48a6-b6d9-efe8ec42da68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b233f9b9178f70f85fc9da06ed52cc6b, https://si.imgix.net/0778b5fa/uploads/origins/9a4be4d4-e27c-48a6-b6d9-efe8ec42da68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83ed3e6d62ec54506dbe6b54e8c3a315 2x, https://si.imgix.net/0778b5fa/uploads/origins/9a4be4d4-e27c-48a6-b6d9-efe8ec42da68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e8d7a638303e8598dc3ef15d3cccf71 3x", "genre": "art", "nsfw": false, "body": "初めまして、平賀まつり様の可愛らしいイラストが大好きで是非お願いさせて頂きたいと思いました。\n私の推しでVtuberとして活動されている早乙女乙葉さん(@SaotomeOtoha)のイラストをリクエスト致します。\n\n・ビーチで水着姿の早乙女乙葉ちゃんを描いて欲しいです。可能であればパーカーをゆるく羽織っている感じだと嬉しいです。\n・トレードマークの猫耳と尻尾は必ずつけて欲しいです。\n・構図、表情などはお任せ致します。\n・収益化済みYouTubeやXなどのプロモーションに使用する可能性がございます\n・サムネイルに使用しやすいよう、顔周りを見切れないように描いていただけると助かります。\n・人物はレイヤーを分けて、PSDデータでいただけますとありがたいです。\n\nhttps://x.com/SaotomeOtoha/status/1640981560185995264?s=20", "created_at": "", "completed_at": ""}, {"path": "/@hiraga_matsuri/works/230", "thumbnail_src": "https://si.imgix.net/d41fce7b/uploads/origins/0fdc89fb-8125-47ba-b18c-ea9c1dbb0b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8ff01f27ade39b20758367963cf798a", "thumbnail_srcset": "https://si.imgix.net/d41fce7b/uploads/origins/0fdc89fb-8125-47ba-b18c-ea9c1dbb0b30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8ff01f27ade39b20758367963cf798a, https://si.imgix.net/d41fce7b/uploads/origins/0fdc89fb-8125-47ba-b18c-ea9c1dbb0b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5225fcdf6bcff8c56daec58e7811bad 2x, https://si.imgix.net/d41fce7b/uploads/origins/0fdc89fb-8125-47ba-b18c-ea9c1dbb0b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77bc9e9a6becb76e31dfbb90fc7a274b 3x", "genre": "art", "nsfw": false, "body": "平賀まつり様、初めまして！個人でVtuber活動をしている甘須もあと言います。\n\nXのTLに凄く素敵なskebイラストが流れてきて、ぜひ一枚お願いしたいなと思いリクエスト致します！\n\n◆キャラクター属性\nぐーたら・お茶目・お調子者・メスガキ等\n\n◆イラスト内容\nうさぎのポーズのような感じで、ちょっとアホっぽいけど可愛いみたいな一枚をお願いしたいと思います。\n衣装に関してはフード被りはどちらでも構いません。多少服装アレンジが入っても大丈夫です！\n\n\n◆人物資料\nhttps://drive.google.com/file/d/1Rizi8gqY-icIcTM-njhjKslgsykWz5fe/view?usp=drive_link\nhttps://drive.google.com/file/d/1Y5j687qI7N_DyP4ZchrW-Psn-lEH1x4X/view?usp=drive_link\n\n◆ポーズ参考用\nhttps://drive.google.com/file/d/1LeW3QGXY2D73WJVgGVg05MgIBY_J4BGw/view?usp=sharing\nhttps://drive.google.com/file/d/17h12RmlrtDpXiGod7IzQ6LYsLVDybLuL/view?usp=sharing\n\n◆使用用途\nSNS広報やYoutubeサムネイル等に使用させて頂きたいと思っています。\n\n背景等が入る場合、人物単体のレイヤーがあると助かります。\nよろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@hiraga_matsuri/works/229", "thumbnail_src": "https://si.imgix.net/8fd7815f/uploads/origins/6e2f38a4-43a4-49b8-905d-ad7e4c4a7b90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c503cb06e5703011b17a05d8157c85c9", "thumbnail_srcset": "https://si.imgix.net/8fd7815f/uploads/origins/6e2f38a4-43a4-49b8-905d-ad7e4c4a7b90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c503cb06e5703011b17a05d8157c85c9, https://si.imgix.net/8fd7815f/uploads/origins/6e2f38a4-43a4-49b8-905d-ad7e4c4a7b90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3e9ae28deb0103be86d9e1f1e61ddb5 2x, https://si.imgix.net/8fd7815f/uploads/origins/6e2f38a4-43a4-49b8-905d-ad7e4c4a7b90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f66a93d56d636c9d5dc8c80715655424 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nVtuberの犬山たまきと申します。\n\n前回は素敵なイラストをご納品ありがとうございました！\n仕上がりが大変素晴らしく、再度ご依頼させて頂きたくご連絡をいたしました。\n\n■イラスト内容\nVtuber「犬山たまき」のイラストを描いて頂きたいです。\n衣装が多数ございますが、先生が気に入られたお衣装で作画頂けますと大変嬉しいです。\n※前回作画頂いた以外のお衣装だと有難いです…！\n\n性別は男性で「男の娘」キャラクターとなりますので、胸の描写だけお気をつけいただけますと幸いです。\n見た目が女性寄りなので、無理に男性らしく描写する必要はございません…！\n\n公式HP キャラクター紹介\nhttps://noripro.jp/talent-inuyama/\n\n■希望納品形式\nキャラクターのみ、レイヤー分けされているpsdデータで頂戴出来ますと嬉しいです。\n\n■用途\nYouTubeのサムネイルへの使用、Twitterで活動の際に使用させて頂きたいです。\n使用の際は、先生のTwitterアカウントをYouTubeの概要欄、もしくはTwitterのツイート文にクレジットさせて頂きます。\n\n■構図や要望など\nYouTubeのサムネイルに使用する為、お顔が良く見える構図だと嬉しいです。\n頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。\n\n何卒、よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@hiraga_matsuri/works/228", "thumbnail_src": "https://si.imgix.net/18434417/uploads/origins/3d20d6aa-a5de-4558-ad9f-df2506fb50be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd9da21317ec194bf268134ea130c863", "thumbnail_srcset": "https://si.imgix.net/18434417/uploads/origins/3d20d6aa-a5de-4558-ad9f-df2506fb50be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd9da21317ec194bf268134ea130c863, https://si.imgix.net/18434417/uploads/origins/3d20d6aa-a5de-4558-ad9f-df2506fb50be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9e82a336e6edc997de5712143e1d3bf 2x, https://si.imgix.net/18434417/uploads/origins/3d20d6aa-a5de-4558-ad9f-df2506fb50be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31a5b624b9ad50fcd0507b317ec17d69 3x", "genre": "art", "nsfw": false, "body": "私は個人V活動をしている刹那めぐりと言います。\nとても良い肌の質感とボディーらインでイラストを描いているのを見て、\n私も同じようにイラストを描いてもらいと思いました。\n今回初めて依頼しますが、先生のイラストで私を描いて頂きたいと思います。\nスク水で構図はお任せします。\n用途は配信活動で使用したいと思っています。人物等は切れない様イラスト枠内でお願いしたいと思います。表情など差分にも余裕があればお願いします。\n背景の有無や小物などPSD形式で納品して頂けると頂けるとありがたいです。着せてみたい衣装があれば、自由に露出など含めてお願いしたいと思います。\n※#アートめぐりで検索\nプロポーション★身長 149cm　★バストE～F(美乳巨乳)　★年齢 永遠の15歳(JK)　★異世界からの転生者で、16歳の誕生日になると15歳にリセットされる呪いがかけられている(記憶以外がリセット) ※中二病ではない", "created_at": "", "completed_at": ""}, {"path": "/@hiraga_matsuri/works/227", "thumbnail_src": "https://si.imgix.net/d2487b38/uploads/origins/6ed86b17-4fcc-4296-8de9-45481c54e43f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cde4ada397282a15477b01cccfd0f35", "thumbnail_srcset": "htt