88d3bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a02ecb3025228a4bb39ffe653b9de856 2x, https://si.imgix.net/10f26357/uploads/origins/51a0041c-bb41-4623-9b81-0c836d88d3bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d871b02ce90353624da30353d936bab 3x", "genre": "art", "nsfw": false, "body": "奈つくも様初めまして。\n新着作品から素敵なイラストを拝見し、ぜひ私のコテキャを描いていただきたくリクエストさせていただきます!\n\nキャラ詳細￤https://x.com/skeboz_/status/1992562450659738047?s=46\n\n細かい設定やNG特にないので完全自由で好きなように描いていただけると嬉しいです!\n\nご検討よろしくお願いいたします🙇🏻‍♀️", "created_at": "", "completed_at": ""}, {"path": "/@natsu_kumo88/works/2", "thumbnail_src": "https://si.imgix.net/3ed4d799/uploads/origins/829c7304-6ab9-45ea-973d-892801f17d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddfc39aec68dc835122c4a412a7e91b9", "thumbnail_srcset": "https://si.imgix.net/3ed4d799/uploads/origins/829c7304-6ab9-45ea-973d-892801f17d72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddfc39aec68dc835122c4a412a7e91b9, https://si.imgix.net/3ed4d799/uploads/origins/829c7304-6ab9-45ea-973d-892801f17d72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3229878624de180591b3104c2b38de36 2x, https://si.imgix.net/3ed4d799/uploads/origins/829c7304-6ab9-45ea-973d-892801f17d72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f24c6aca86b24eadfb658a896f723e08 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！あなたの作品が大好きです。私のオリジナルキャラクター、あかりを描いていただけませんか？彼女は思いやりがあって内気な性格です。バレンタインデーのシチュエーションで描いてほしいです。髪型や服装は自由に決めてください。ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/u/0/folders/1carjHHMZLaeOsUNhlmk4JgBHN6rgnDg3", "created_at": "", "completed_at": ""}, {"path": "/@natsu_kumo88/works/1", "thumbnail_src": "https://si.imgix.net/98f1e2d0/uploads/origins/250d86d5-e907-4ddd-9ed0-136f978ff405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=282cad50d3126e139df957ae2a080146", "thumbnai