002e02db/uploads/origins/5a79ce1e-4a69-493d-8f68-9baeb847a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2aaaae78656067c22388712fbbb3896c", "thumbnail_srcset": "https://si.imgix.net/002e02db/uploads/origins/5a79ce1e-4a69-493d-8f68-9baeb847a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2aaaae78656067c22388712fbbb3896c, https://si.imgix.net/002e02db/uploads/origins/5a79ce1e-4a69-493d-8f68-9baeb847a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39b0a0048991605d850b0211c333e253 2x, https://si.imgix.net/002e02db/uploads/origins/5a79ce1e-4a69-493d-8f68-9baeb847a0b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=550d703c3d5e0038808610a96f947dd5 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のキャラクター、カリオペを描いてくれないかな！\n\n彼女が事務服を着ているところとか、事務服をデザインしてほしいです！例えば、彼女が着ている黒と青のワンピースのようなもの。でも、お任せします。面倒だったら、好きなように描いてほしいです。ありがとうございました！\n\n死後の世界（イセカイ）に転生した、ちょっとメンヘラな女の子。以前は大富豪の跡取り娘で、触ったものを溶かしてしまう能力を持っていたため、手袋をしていた。夢見がちなところがある。\n\nhttps://drive.google.com/drive/folders/1Qll478kPYFcc5pcsmbHk_rXshYsV7joG", "created_at": "", "completed_at": ""}, {"path": "/@Baku_Roma_/works/10", "thumbnail_src": "https://si.imgix.net/0ce9f26d/uploads/origins/67133d21-dbd9-41f7-99f5-a0774ec0c9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c71ba887317ca048cec9508f668f0cf2", "thumbnail_srcset": "https://si.imgix.net/0ce9f26d/uploads/origins/67133d21-dbd9-41f7-99f5-a0774ec0c9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c71ba887317ca048cec9508f668f0cf2, https://si.imgix.net/0ce9f26d/uploads/origins/67133d21-dbd9-41f7-99f5-a0774ec0c9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f972d02e68b7b8d633bb061036c80dc 2x, https://si.imgix.net/0ce9f26d/uploads/origins/67133d21-dbd9-41f7-99f5-a0774ec0c9d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7253f88822453d687