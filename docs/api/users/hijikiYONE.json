スを見ながら、シルバーグランツはオナニーする。\n最後はサンダーイグニスを正気に戻させて、二人を正面向かって立ち合わせる。\n驚愕するしかない二人であったが、お互いの顔は真っ赤に染まって・・・", "created_at": "", "completed_at": ""}, {"path": "/@hijikiYONE/works/5", "thumbnail_src": "https://si.imgix.net/96ded96f/uploads/origins/3b089fbe-6ae3-4239-aa35-51d66bf52cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b8805ee8ec343d1db00d273de63adc2", "thumbnail_srcset": "https://si.imgix.net/96ded96f/uploads/origins/3b089fbe-6ae3-4239-aa35-51d66bf52cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b8805ee8ec343d1db00d273de63adc2, https://si.imgix.net/96ded96f/uploads/origins/3b089fbe-6ae3-4239-aa35-51d66bf52cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57f24d5d2cabf3e132f87f40f6d05f3f 2x, https://si.imgix.net/96ded96f/uploads/origins/3b089fbe-6ae3-4239-aa35-51d66bf52cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fbf3e6824bc9a5ed865213de5461528 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hijikiYONE/works/4", "thumbnail_src": "https://si.imgix.net/b3f832ba/uploads/origins/b8bab467-95a7-44a7-a566-215e23c328dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37e93b86e0922583267c4dc24ae392f3", "thumbnail_srcset": "https://si.imgix.net/b3f832ba/uploads/origins/b8bab467-95a7-44a7-a566-215e23c328dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&t