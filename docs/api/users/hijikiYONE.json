交じり合うほどの、淫らなヒーローがベッドに二つ存在していた。\n（受けがどちらになるのか、お任せします）\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@hijikiYONE/works/8", "thumbnail_src": "https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1eee75bcfdd436d5ae16fc4d1b8eb844", "thumbnail_srcset": "https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1eee75bcfdd436d5ae16fc4d1b8eb844, https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9de50a0f7ca625cd208d9de2d4db537 2x, https://si.imgix.net/9011be07/uploads/origins/236541a7-9644-4c1f-98a0-4e1ba6ca43f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c68bf47e26c9d36fa06418fc90783426 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@hijikiYONE/works/7", "thumbnail_src": "https://si.imgix.net/eba08b99/uploads/origins/97990938-a906-495b-bf22-85f9b6346bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11df0c8c3345f09296c644f4f9b0e6c7", "thumbnail_srcset": "https://si.imgix.net/eba08b99/uploads/origins/97990938-a906-495b-bf22-85f9b6346bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txt