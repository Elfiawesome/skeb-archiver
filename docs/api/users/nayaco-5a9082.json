91a5-84d66cd6c453?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc5539e98106824ca9578b3bb8385333 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nayaco/works/16", "thumbnail_src": "https://si.imgix.net/88980c8d/uploads/origins/b9690249-7fdc-4749-80db-b8da074b2a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1204ea49179432de876d64c6b7bb77d", "thumbnail_srcset": "https://si.imgix.net/88980c8d/uploads/origins/b9690249-7fdc-4749-80db-b8da074b2a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1204ea49179432de876d64c6b7bb77d, https://si.imgix.net/88980c8d/uploads/origins/b9690249-7fdc-4749-80db-b8da074b2a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94b7e68fa9feb4c11784b7fd0db3ae00 2x, https://si.imgix.net/88980c8d/uploads/origins/b9690249-7fdc-4749-80db-b8da074b2a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6606cf8c512af0b4e5d717ac95745c5 3x", "genre": "comic", "nsfw": false, "body": "はじめまして。\n突然のメッセージ失礼いたします。\n\nいつも素敵なFAに命を救われており、この度、是非とも先生の素敵な絵で私と友人の探索者を描いていただきたくリクエストを送らせていただきました。\n\n通ったシナリオは、\n①\tエモクロアTRPG「変葬」（PC②がDLPC）\n②\tエモクロアTRPG「ゆめわたり」（PC①がDLPC）\nになります。\n\n以下、ネタバレなしの紹介になります。\n\n2人の関係性：高校～大学まで一緒だった同級生。社会人になった今でもたまにご飯に行く仲。なんやかんやあり今は一緒にPC①の家に住んでいる。\n\nPC①\n名前：小灰　秀（しじみ しゅう）\n年齢：27歳\n身長：168㎝\n髪色：灰色\n瞳の色：灰色\nモチーフ：シジミチョウ\n一人称：俺\n二人称：玖賀、おまえ\n恋愛対象が男性。ただし絶対に自分からは言わない。聞かれたら話す。最近同棲してた彼氏に出て行かれた。不器用で体力がなくて丈夫でもない。常に無表情で笑わず、淡々と抑揚なく話す。察しが悪くて相手の表情や感情を組み取れない。玖賀は唯一の友人であり、自分の事情を知ってなお友人でいてくれる彼を大切に思っている。\n\nPC②\n名前：玖賀　幸来（くが　こうき）\n年齢：27歳\n身長：秀と同じくらい\n髪色：焦げ茶色\n瞳の色：紫\nモチーフ：蛾\n一人称：俺\n二人称：秀、おまえ\n常にへらへらと笑っており、いつも周りに人がいる明るい性格の人気者。遊び人であり会うたびに恋人が違うが、本当は秀に好意を寄せている。ただし徹底的に隠しているため気付かれていない。鈍感で不器用な秀を気にかけて、よくご飯に誘ったり話を聞いたりしている。\n\nイラストイメージ：一緒にご飯を食べに行っている2人をお願いしたいです。雨がモチーフのシナリオを通ったので、雨が降っていて、尚且つ夜の時間帯だと嬉しいです。最近一緒の家に住み始めたので、ちょっとだけそれに対してそわそわしてる2人（特に玖賀）がいたらめちゃくちゃ嬉しいです。\n\n使用用途：個人鑑賞\n\n参考までに、立ち絵と相方ＰＬ様に描いていただいた絵を共有させていただきます。\n\n色々と細かく書いておりますが、全て先生のお好きなように描いていただければと思います。\nまた、コミックのリクエストが初めてとなりますためなにか問題等ありましたら申し訳ございません。\n\n何卒ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Vv4eZKz0Yh7bHgZQH_EErVb_SsFfj-A-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@nayaco/works/15", "thumbnail_src": "https://si.imgix.net/4743fd9b/uploads/origins/7f5d505c-537a-4cad-bdd1-fa0a02ea2217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c008341b7e5b7c08cd1bbf36ff3a4bff", "thumbnail_srcset": "https://si.imgix.net/4743fd9b/uploads/origins/7f5d505c-537a-4cad-bdd1-fa0a02ea2217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c008341b7e5b7c08cd1bbf36ff3a4bff, https://si.imgix.net/4743fd9b/uploads/origins/7f5d505c-537a-4cad-bdd1-fa0a02ea2217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0506f66ffa2702c57bc7503a8e9ba479 2x, https://si.imgix.net/4743fd9b/uploads/origins/7f5d505c-537a-4cad-bdd1-fa0a02ea2217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b657f6fd21e5c0ea5c65197cb45fdc52 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nayaco/works/14", "thumbnail_src": "https://si.imgix.net/90502c62/uploads/origins/183f0cec-3efd-40be-a2a9-28a94e52498b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc4c48296ccd5a8d97f156858f40