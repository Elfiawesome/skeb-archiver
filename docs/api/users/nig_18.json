uploads/origins/0a9f6b8e-48cd-4568-8539-d2c33f8eb88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d151f0d62feb9da2ddb7124abecc4cd", "thumbnail_srcset": "https://si.imgix.net/fc67fc18/uploads/origins/0a9f6b8e-48cd-4568-8539-d2c33f8eb88d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d151f0d62feb9da2ddb7124abecc4cd, https://si.imgix.net/fc67fc18/uploads/origins/0a9f6b8e-48cd-4568-8539-d2c33f8eb88d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c1f177fadaa466b20a986185cb3add9 2x, https://si.imgix.net/fc67fc18/uploads/origins/0a9f6b8e-48cd-4568-8539-d2c33f8eb88d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1595f448968d297a6c930d6863b96e8 3x", "genre": "art", "nsfw": false, "body": "いちは先生こんばんは!\n\nMIUと申します。\n先生の絵がとても気に入りました！ふわふわした雰囲気が大好きです！！だから可能であればリクエストさせていだきますにょ＞＜///\n\nフレンドのVRCキャラをお願いしたいです！\n内容は全て先生にお任せします ！\n\nキャラ名：シキ\n大人しそうに見えて実は心は活発で、たまにこっそりいたずらの小悪魔のような子。\n普段はとても優しい方ですが、実はこっそりいじめたりするのが好きな時もあります。\nちなみに、恥ずかしがり屋だが、実は欲望にまみれている。\nピンクメッシュにあるのツインテールが特徴的で、頭には「四季」のへ アアクセサリーが付いています。\n資料の「0_髪色.png」を参考お願いします。\nサイズ E cup\n\n八重歯にあるの猫のように顔を描いて頂けましたら嬉しいです！\n\n料金が足りない場合お手数おかけいたしますが、再送をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JO6mh-Yu3FWZ4SsTx5pU4SxzyijG4AY2", "created_at": "", "completed_at": ""}, {"path": "/@nig_18/works/22", "thumbnail_src": "https://si.imgix.net/62e51efd/uploads/origins/983f0ce6-1618-4443-ae3c-27784ef64dca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2406e4247b3406b665ec65593e6310", "thumbnail_srcset": "https://si.imgix.net/62e51efd/uploads/origins/983f0ce6-1618-4443-ae3c-27784ef64dca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2406e4247b3406b665ec65593e6310, https://si.imgix.net/62e51efd/uploads/origins/983f0ce6-1618-4443-ae3c-27784ef64dca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f56c941317d2a4d0a2e3578bd2e9f11a 2x, https://si.im