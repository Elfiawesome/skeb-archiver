: 70000}, "video": {"min": 28000, "max": 75000}, "correction": {"min": 4000, "max": 7000}}, "links": [{"label": "Twitter", "url": "https://x.com/tirofinire", "name": "tirofinire"}, {"label": "Misskey_io", "url": "https://misskey.io/@tirofinire", "name": "tirofinire"}, {"label": "Website", "url": "https://celerism.booth.pm", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/11832215", "name": "11832215"}, {"label": "Fanbox", "url": "https://www.fanbox.cc", "name": "www"}], "flags": {"from_archive": true}, "works": [{"path": "/@tirofinire/works/279", "thumbnail_src": "https://si.imgix.net/2367689e/uploads/origins/5e9fff63-fcae-4a96-8156-34d6c685604f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cef0987ba21c67fa65cc6fd6d6720d8", "thumbnail_srcset": "https://si.imgix.net/2367689e/uploads/origins/5e9fff63-fcae-4a96-8156-34d6c685604f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cef0987ba21c67fa65cc6fd6d6720d8, https://si.imgix.net/2367689e/uploads/origins/5e9fff63-fcae-4a96-8156-34d6c685604f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbac4b07830d2f4d659f9671e5c11af8 2x, https://si.imgix.net/2367689e/uploads/origins/5e9fff63-fcae-4a96-8156-34d6c685604f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4defbf260d445211ff016e01360af4d4 3x", "genre": "art", "nsfw": true, "body": "重複依頼となってしまいますが、もし余裕が\nセロリーさんこんばんは。\nありましたら受けていただけたら幸いです。\n\nキャラはミッドフォームの沢泉ちゆ(フォンテーヌ)でシチュエーションは拘束ローター責めです。⤵︎と同じ。\nhttps://skeb.jp/@tirofinire/works/265\n\n流れは\n①拘束されてるちゆ、不安そうな顔をする。\nちゆ「は、恥ずかしすがる……」\nのどか「でしょ？でもすぐ気持ち良くなるからね♪」\n②ローターが作動し驚くちゆ。\nちゆ「きゃっ！あ、あそこが……あっ♡」\nのどか「感じてるちゆちゃんもかわいいなぁ〜♪」\n③徐々に追い詰められるちゆ。\nちゆ「もうダメ…イっちゃう……♡♡」\nのどか「ちゆちゃんのヒーリングストリーム、楽しみ♪」\n④耐えきれず絶頂を迎えるちゆ。\nちゆ「のどかぁ！！♡イくっ！！♡♡」\nのどか「きゃっ！ふわ〜すごい♡」\n⑤余韻に震えるちゆ\nちゆ「…悔しいけど気持ちよかったわ♡」\nのどか「よかった〜これからもやろうね♡」\n\nこのような感じでお願いします。\n\nご多忙の中申し訳ありませんが、\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/278", "thumbnail_src": "https://si.imgix.net/6b80e4c8/uploads/origins/c407f3d5-7f65-459f-8c72-a63145b9ad70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fad660f0a045e4767c304e125e68fa25", "thumbnail_srcset": "https://si.imgix.net/6b80e4c8/uploads/origins/c407f3d5-7f65-459f-8c72-a63145b9ad70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fad660f0a045e4767c304e125e68fa25, https://si.imgix.net/6b80e4c8/uploads/origins/c407f3d5-7f65-459f-8c72-a63145b9ad70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=543fc008dd9c5f07394d63ed6ecb46e7 2x, https://si.imgix.net/6b80e4c8/uploads/origins/c407f3d5-7f65-459f-8c72-a63145b9ad70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a01e4b29481f525dd61dbb337d21cbee 3x", "genre": "art", "nsfw": true, "body": "こんばんは〜\nうたちゃんとななちゃんの水晶化イラスト\nありがとうございました〜\nこの2人でまた別のシチュエーションが見たくて\nまた依頼しちゃいます。\n\nキャラはうたちゃんとななちゃんでミッドフォーム状態。\nシチュエーションはライブ会場でローターでイってしまう羞恥プレイです。\n2人は恥ずかしがってる状態でステージに立っており、\nローターの電源を入れられて沢山感じた末に同時に絶頂してしまうという感じでお願いしたいです！\n\nよろしくお願いします〜！", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/277", "thumbnail_src": "https://si.imgix.net/100d26c7/uploads/origins/3a83212e-af01-4dae-8ca5-f504296b9fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21c823cbf1924e9d8b1cdf4ad1b18981", "thumbnail_srcset": "https://si.imgix.net/100d26c7/uploads/origins/3a83212e-af01-4dae-8ca5-f504296b9fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21c823cbf1924e9d8b1cdf4ad1b18981, https://si.imgix.net/100d26c7/uploads/origins/3a83212e-af01-4dae-8ca5-f504296b9fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a3f742d958aad20e4db169e79cc3c02 2x, https://si.imgix.net/100d26c7/uploads/origins/3a83212e-af01-4dae-8ca5-f504296b9fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed5ffea7b183372e9a390d7ff0a43847 3x", "genre": "art", "nsfw": true, "body": "以前はありがとうございました。リクエスト募集を再開されたとのことなので、よろしければ以下の内容をお願いします。  \n\n・キャラクターは、ハートキャッチプリキュア！の花咲つぼみ\n ・シチュエーションは、斜め前を向いて、自らスカートをたくし上げてパンツ全体を隠さず見せてもキョトンとしている、という感じにして頂きたいです。  \n・構図は頭部から膝上のあたりで描いていただきたいです。  \n・衣装は明堂学園の制服でパンツは白色にピンクのリボンが付いたジュニアショーツにしていただきたいです。  \n\nご検討頂けましたら幸いです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/276", "thumbnail_src": "https://si.imgix.net/9120bec8/uploads/origins/046c783a-13b5-47df-a9ef-40248727ccf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22223c23f00904d9544c222066e17d48", "thumbnail_srcset": "https://si.imgix.net/9120bec8/uploads/origins/046c783a-13b5-47df-a9ef-40248727ccf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22223c23f00904d9544c222066e17d48, https://si.imgix.net/9120bec8/uploads/origins/046c783a-13b5-47df-a9ef-40248727ccf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f51f389baba2e18102bd2f65190a986 2x, https://si.imgix.net/9120bec8/uploads/origins/046c783a-13b5-47df-a9ef-40248727ccf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab7de861cff7512cb561c78d99f3301a 3x", "genre": "art", "nsfw": true, "body": "こんばんは\n以前の咲舞に引き続き今回もローター対決のイラストをお願いしたいです。\nキャラはのぞみとうらら(オトナプリキュア)で\n衣装はミッドフォーム。\nこれまでのイラストと同じように\n2人それぞれが絶頂するものと\n同時に絶頂するものの差分を\nお願いしたいです。\n絶頂の際は「イく！♡」の台詞で\nお願いします。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/275", "thumbnail_src": "https://si.imgix.net/6fc49366/uploads/origins/2b5c08c5-e080-4096-ba69-5983ab6ebd29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f718cfbc9ebc2c178c62982fa77ca49b", "thumbnail_srcset": "https://si.imgix.net/6fc49366/uploads/origins/2b5c08c5-e080-4096-ba69-5983ab6ebd29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f718cfbc9ebc2c178c62982fa77ca49b, https://si.imgix.net/6fc49366/uploads/origins/2b5c08c5-e080-4096-ba69-5983ab6ebd29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3988776978b34328a494e76ff9d131ab 2x, https://si.imgix.net/6fc49366/uploads/origins/2b5c08c5-e080-4096-ba69-5983ab6ebd29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b994d5e15aba36f0b31bd447197929c 3x", "genre": "art", "nsfw": true, "body": "はじめまして!!T.JPと申します!!作品見させて頂いています!!今回はセロリーさんがリクエスト募集始めたとのことでリクエストさせていただきたいと思います！\nリクエスト内容ですが、アイカツのスターライト学園に転校したキュアハート、ダイヤモンド、ロゼッタ、ソードの4人がスターライト学園の制服を着たイラストを描いていただきたいです!!\nあと、こちらは金額的に可能であればでよろしいので、亜久里ちゃんとレジーナがドリームアカデミーの制服を着たイラストもできればお願いしたいです!!\nぜひご検討よろしくお願いします!!", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/274", "thumbnail_src": "https://si.imgix.net/ebeddaf8/uploads/origins/64338772-43d9-42d6-b6eb-c19c28fb72ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c2492cbc326eca21aca19fc2c07ef0", "thumbnail_srcset": "https://si.imgix.net/ebeddaf8/uploads/origins/64338772-43d9-42d6-b6eb-c19c28fb72ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1c2492cbc326eca21aca19fc2c07ef0, https://si.imgix.net/ebeddaf8/uploads/origins/64338772-43d9-42d6-b6eb-c19c28fb72ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93d4ef9441da6fde24913c63a5727ee3 2x, https://si.imgix.net/ebeddaf8/uploads/origins/64338772-43d9-42d6-b6eb-c19c28fb72ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40b2263b1333accd54207e661ffb1726 3x", "genre": "art", "nsfw": true, "body": "こんばんは。重複大丈夫との事でしたので\nご依頼させていただきます。\n\nキャラはゴープリのみなみときららで\nミッドフォームローター責めです(いつもの)\n流れも基本同じで、\nローター責めされる前にドキドキしてる2人。\n(みなみはかなり慌てていて、きららは表面上平常心を保ってる感じ)\nローター責めが始まる。\nみなみがイく。\nきららがイく。\n同時にイく。\n事後\nでお願いします。\n台詞は基本お任せですが\n絶頂の際は「イく！」と言わせて下さい。\n(アレンジしてもらっても構いません)\nローター責めしてる人間ははるかで\nお願いします。\nもし余裕があればはるかのセリフも\nお願いしたいです。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/273", "thumbnail_src": "https://si.imgix.net/e756802f/uploads/origins/4386a10f-f906-4178-8fff-5a40f5d76816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c31cba34469c94e697af10bcd8d6b9ad", "thumbnail_srcset": "https://si.imgix.net/e756802f/uploads/origins/4386a10f-f906-4178-8fff-5a40f5d76816?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c31cba34469c94e697af10bcd8d6b9ad, https://si.imgix.net/e756802f/uploads/origins/4386a10f-f906-4178-8fff-5a40f5d76816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16483e8e51b9abc8bd142c14136b876e 2x, https://si.imgix.net/e756802f/uploads/origins/4386a10f-f906-4178-8fff-5a40f5d76816?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d7f5664cfed29e000fb77e192db0cad 3x", "genre": "art", "nsfw": true, "body": "例によって久方振りの依頼となります。\n\n今回は『わんだふるぷりきゅあ』のキュアリリアンがネックハンギング（＝首絞め）で苦しむ場面をお願いしたく思います。\n↓が参考画像です。\n\n①https://www.pixiv.net/artworks/127602375（2枚目～5枚目）\n②https://www.pixiv.net/artworks/128762504（3枚目）\n\n巨漢な相手、アングルは左斜め前、両手絞め、壁に追い込まれている、というのが大まかな共通要素です。\n後は細かな調整諸々になりますが･･･\n\n苦悶するリリアンは、表情は①（片目閉じ片目開け、口開け涎なし）をベースに、眉毛は②のような八の字、絞められている震え線に『か･･･は･･･』『･･･ぁ･･･』という喘ぎ声、以前のビューティやハッピーの時のような汗二つを付けて欲しく思います。\n\n一方の相手側は、濃紺の体色に頭が狼のような獣人風（所謂狼男）のシルエットですが、丸々全て映っている必要はなく、②のような1/3（或いは1/2）程度で問題ありませんが、絞めている両手はやはり大きめ（注：顎などが隠れるのはNG）でお願いします。\n\n差分として、①の流れのように抵抗していたリリアンの両手がダランと垂れ、力尽きている様を希望したいですが、無理ならばなくても構いません。\n\n纏めると、リリアンの苦しみ喘ぐ表情、力尽きをはじめとした大部分は①のような感じですが、イラストの全体像（上半身に対して下半身はそれほど映ってない）や抵抗するリリアンの手の形状に角度や位置は②のようにといった具合です。\n\n最後になりますが、リリアンは後ろで束ねた長髪が大きく左側に流れているようなデザインですので、その髪で相手の手が塞がって見えなくなるといったことは、くれぐれも避けて頂けますでしょうか･･･\n背景はセロリーさんがよく使う、暗めの路地裏な雰囲気で問題ありません。\n\nまたまた凝った依頼文なことは承知ですが、何卒ご一考願います。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/272", "thumbnail_src": "https://si.imgix.net/c4599bf0/uploads/origins/6b1d5872-ab8c-4931-91ed-0fa3cdf2382d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e94b7dcfa2fdf629a29b14a047a0443", "thumbnail_srcset": "https://si.imgix.net/c4599bf0/uploads/origins/6b1d5872-ab8c-4931-91ed-0fa3cdf2382d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e94b7dcfa2fdf629a29b14a047a0443, https://si.imgix.net/c4599bf0/uploads/origins/6b1d5872-ab8c-4931-91ed-0fa3cdf2382d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a223ed221f558cba52c3cd17708dc8d 2x, https://si.imgix.net/c4599bf0/uploads/origins/6b1d5872-ab8c-4931-91ed-0fa3cdf2382d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf309c234dbb49e75327174192ae75dd 3x", "genre": "art", "nsfw": true, "body": "こんばんは。まだ募集されてるようですので\nもしよろしければご依頼を受けていただければ\n幸いです。\n\nキャラはキミプリの咲良うたと蒼風ななで、\nミッドフォームの水晶化イラストを\nお願いしたいです。\n水晶化する際の2人は以下の資料のように\nそれぞれ固まる感じでお願いしたいです。\nhttps://www.fanbox.cc/@tirofinire/posts/7052326\n\n台詞はお任せしますが、水晶化の流れは\n差分が許す限り少しずつ固まっていく感じを\n出して欲しいです。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/271", "thumbnail_src": "https://si.imgix.net/6d241b6a/uploads/origins/df176578-486b-4eb9-aef5-32d5adea4add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27799412bc953f51c2c9bb82ab00eb11", "thumbnail_srcset": "https://si.imgix.net/6d241b6a/uploads/origins/df176578-486b-4eb9-aef5-32d5adea4add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27799412bc953f51c2c9bb82ab00eb11, https://si.imgix.net/6d241b6a/uploads/origins/df176578-486b-4eb9-aef5-32d5adea4add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ab22955631abed26a201ae0932ddd5d 2x, https://si.imgix.net/6d241b6a/uploads/origins/df176578-486b-4eb9-aef5-32d5adea4add?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff6a368ce29e63d0c281a9433317eb0d 3x", "genre": "art", "nsfw": true, "body": "セロリーさん、こんばんは。\nいつも素敵なイラストありがとうございます。\nキュアズキューンの衣装デザインが好きなので、今回はズキューンのイラストでリクエストさせてください。\n\nキミプリのキュアズキューンが、椅子に座って顔の前か頭の上で靴を合わせたポーズを取っているイラストをお願いします。\n他の方に依頼したNSFWイラストですが、 https://skeb.jp/@coverpa13a/works/63 のようなポーズで描いていただきたいです。\n元イラストのR18要素は無くて構いませんので、ポーズを寄せた感じのR15くらいのイラストをお願いします。\n\n・スカートの下をグレーのスパッツ(公式)、ピンクのパンツ(髪のメッシュのイメージ)、薄緑のパンツ(衣装アクセントカラーのイメージ)の3バージョン描いていただきたいです\n・ズキューンは股間部分が見えても気にしておらず、笑顔(無知シチュ)\n・元イラストのようにヒールの間から目がのぞく形でなくても構いません\n・ブーツはつま先部分が触れていればヒール部分がぴったり合っていなくても構いません\n\n細かい注文が多くて恐縮ですが、ご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/270", "thumbnail_src": "https://si.imgix.net/ca5bf307/uploads/origins/65b39574-9af4-4ebf-b731-8d0f03effc63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a93fc26cbf72340cea6b82f51b79f1ed", "thumbnail_srcset": "https://si.imgix.net/ca5bf307/uploads/origins/65b39574-9af4-4ebf-b731-8d0f03effc63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a93fc26cbf72340cea6b82f51b79f1ed, https://si.imgix.net/ca5bf307/uploads/origins/65b39574-9af4-4ebf-b731-8d0f03effc63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=442157124d3bc3210c6599dac60adc99 2x, https://si.imgix.net/ca5bf307/uploads/origins/65b39574-9af4-4ebf-b731-8d0f03effc63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a7ff60193b529e72fc8ea3e239d8e2a 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。Skeb再開お待ちしておりました。また、リクエストさせて頂きます。\nオトナプリキュアの春日野うららが、恋人になったシロップの人間態と野外セックスするイラストをお願いします。\nシチュエーションは、\n・日頃の仕事でストレスや性欲が溜まっていたうららは、休暇にシロップをデートに誘って楽しんだ後、自分の部屋やラブホテルまで我慢できなくなり、野外セックスする…という設定です\n・昼間の海を背景に、砂浜の上で、左斜め前のアングルで向かい合って立った状態で抱き合いながらセックスしている\n・うららとシロップは、二人とも全裸\n・二人とも頭からつま先まで見えている\n・近くに、うららとシロップの服や下着が脱ぎ捨てられている\n・うららの表情は、セックスの快感や大好きなシロップと愛し合っている幸せ、昼間の砂浜で全裸でセックスしている背徳感、「誰かに見られたらどうしよう」等の感情が表れている\n・差分で、膣内射精で同時に絶頂、膣外射精で全身精液まみれ、うららの快感で蕩けた顔\nです。\n要望がかなり多くなり、とても難しいと思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/269", "thumbnail_src": "https://si.imgix.net/a9a3e7a8/uploads/origins/c13a4305-e92d-4f97-b7c0-3ddc3083a621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec55d71d564e5e32b7a77933b213de81", "thumbnail_srcset": "https://si.imgix.net/a9a3e7a8/uploads/origins/c13a4305-e92d-4f97-b7c0-3ddc3083a621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec55d71d564e5e32b7a77933b213de81, https://si.imgix.net/a9a3e7a8/uploads/origins/c13a4305-e92d-4f97-b7c0-3ddc3083a621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7da12f2e53da6f9441cea0de6658a03b 2x, https://si.imgix.net/a9a3e7a8/uploads/origins/c13a4305-e92d-4f97-b7c0-3ddc3083a621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27cce04c6be316934bf43e3951cdd68a 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。\n早速ですがリクエストさせていただきます。\n\nキャラは、デリシャスパーティプリキュアの華満らん。\n\n服装は私立しんせん中学校の制服姿（冬服）。\n\nシチュエーションは突風でスカートがめくれてパンモロしている。\n\n表情はびっくりして驚いてる。\n\n構図は斜め前を向き、頭部から膝上のあたりまで。\n\nパンツは白色で面積の大きめな女児ショーツにしていただきたいです。 \n\nその他細かい所はお任せします。\n\nそれではよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/268", "thumbnail_src": "https://si.imgix.net/2adb517e/uploads/origins/f921873e-b12c-4649-b00f-f23efccaf93b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e8e89b003547d9f66b4b8cd9db6194f", "thumbnail_srcset": "https://si.imgix.net/2adb517e/uploads/origins/f921873e-b12c-4649-b00f-f23efccaf93b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e8e89b003547d9f66b4b8cd9db6194f, https://si.imgix.net/2adb517e/uploads/origins/f921873e-b12c-4649-b00f-f23efccaf93b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c60540f0c9586255d7770fbcf883679 2x, https://si.imgix.net/2adb517e/uploads/origins/f921873e-b12c-4649-b00f-f23efccaf93b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22bb30fbb88d754b8333446f2425c58f 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n募集再開されたとの事で\nまたご依頼させていただきます。\n\nキャラはわんぷりのユキとまゆ\nミッドフォームでのローター対決です。\n⤵︎資料\nhttps://www.fanbox.cc/@tirofinire/posts/9594152\n同じように\nローター責めされてる2人。\nユキがイく\nまゆがイく\n同時イき\n事後\nという感じでお願いします。\n台詞は基本お任せしますが少しだけ\nご要望させてください。\n①絶頂の際は「イく！」という台詞(2人とも)\n②ユキはまゆのお願いで嫌々やってる感じで\n　まゆは少し乗り気な感じ。\n③「ニャッ」などの猫語は無しで。\n④ローターのリモコンを持ってるのは\n　いろはで。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/267", "thumbnail_src": "https://si.imgix.net/7b639b7f/uploads/origins/3efd5586-f74b-4765-bfea-00dd27c486d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d904365968d5e3bf066caa94af1bbd1a", "thumbnail_srcset": "https://si.imgix.net/7b639b7f/uploads/origins/3efd5586-f74b-4765-bfea-00dd27c486d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d904365968d5e3bf066caa94af1bbd1a, https://si.imgix.net/7b639b7f/uploads/origins/3efd5586-f74b-4765-bfea-00dd27c486d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37e716df50a9f7504f0548f4b2d842ce 2x, https://si.imgix.net/7b639b7f/uploads/origins/3efd5586-f74b-4765-bfea-00dd27c486d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e162fe956016d09bd80275db5987e1c2 3x", "genre": "art", "nsfw": true, "body": "リクエストです。\n「まほプリ」よりリズ先生が「Fata/kaleid liner プリズマ☆イリヤ」より美遊・エーデルフェルト（背景も設定も性格も色々と重い小五女子）の魔法少女衣装のコスプレをさせられているところをお願いいたします。\nシチュエーションとしては、何の前触れもなく突如として件の衣装になってしまい赤面、というものです。なお、衣装はリズ先生の体格に合わせてリサイズされた形を想定していますが、リズ先生のSTYLEに関してはセロリーさんの良心に委ねます。\nまた、もし余裕があれば左下にワイプで、あるいはセリフのみで「まほプリ」メンバーの反応も描いて下さると幸いです。\n自分で思い浮かぶ限りではありますが・・・\n\n・みらい「リズ先生、ワクワクもんだぁ！！（＞ ▽ ＜）」とかなりウェルカム。\n・リコ「お、おね・・・お姉ちゃん！？！？（   ゜▯    ゜ ）」と赤面しつつ大混乱。\n・色々考えましたが、残り二人に関しては見て見ぬ振りを決め込んで自分たちからフェードアウト。そのやり取りは以下の形のどちらか。\n→パターン１：はーちゃん「モフルン、いこ（一 ▽ 一）」\nモフルン「モフ（一 ω 一）」\n→パターン２：モフルン「はーちゃん、いくモフ（一 ω 一）」\nはーちゃん「はー（一 ▽ 一）」\n\nQ：何でコスプレとは言え、馴染みなさそうな作品から取り上げたの？\nA：CV.名塚佳織さんキャラにその衣装を着せたかったからです。つまりは、中の人繋がり。\n\nそんな次第ではございますが、どうぞよろしくお願いいたします。\n\nhttps://demonition.com/wp/wp-content/uploads/2019/01/dcf6af90c29089309a071651fda3f39d.jpg", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/266", "thumbnail_src": "https://si.imgix.net/e67d3a51/uploads/origins/0722c956-10e1-4015-9f5d-61001ef8741d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d85eb41bbdd2bc09535d64c3141ca00d", "thumbnail_srcset": "https://si.imgix.net/e67d3a51/uploads/origins/0722c956-10e1-4015-9f5d-61001ef8741d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d85eb41bbdd2bc09535d64c3141ca00d, https://si.imgix.net/e67d3a51/uploads/origins/0722c956-10e1-4015-9f5d-61001ef8741d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ce8b2445dd1ffe44d963218af33f877 2x, https://si.imgix.net/e67d3a51/uploads/origins/0722c956-10e1-4015-9f5d-61001ef8741d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d40921888a93a5dfbafa6359460a23e 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n今回もローター対決のイラストをお願いしたいです。\nキャラは咲と舞(オトナプリキュア)で\n衣装はミッドフォーム。\nこれまでのイラストと同じように\n2人それぞれが絶頂するものと\n同時に絶頂するものの差分を\nお願いしたいです。\n絶頂の際は「イく！♡」の台詞で\nお願いします。\nまた、舞の髪型は束ねて無い\nロングヘアでお願いします。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/265", "thumbnail_src": "https://si.imgix.net/92bf05f3/uploads/origins/bb0a8ff9-2287-4f12-872d-79c662c0cad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4ae237168f33839e5d349504a1ed3f", "thumbnail_srcset": "https://si.imgix.net/92bf05f3/uploads/origins/bb0a8ff9-2287-4f12-872d-79c662c0cad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4ae237168f33839e5d349504a1ed3f, https://si.imgix.net/92bf05f3/uploads/origins/bb0a8ff9-2287-4f12-872d-79c662c0cad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3029ec756931a3b788e5f0b169ece625 2x, https://si.imgix.net/92bf05f3/uploads/origins/bb0a8ff9-2287-4f12-872d-79c662c0cad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=060d8637205aca4e6f638fd27ae3f697 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n今回もご依頼させていただきます。\nキャラは拘束ミッドフォームのどかちゃんで\nシチュエーションはかなり前の作品の\n差分でお願いします。⤵︎\nhttps://www.fanbox.cc/@tirofinire/posts/7587429\n流れは\n①拘束された状態でローターを付けられているのどか。少し不安そうな表情。\nセリフ\nのどか「ち、ちゆちゃん…こんなの恥ずかしいよ…」\nちゆ(セリフのみ)「そんなのどかもかわいいわ。スイッチを入れるわね。」\n②ローターの電源が入り喘ぐのどか。\nセリフ\nのどか「ひゃあ！お、お股が…♡」\nちゆ「感じるのどかもかわいいわ。」\n③刺激に耐えられなくなってくるのどか。\nセリフ\nのどか「ちゆちゃん…イっちゃうよぉ…♡」\nちゆ「え、もう！？そんなに感じるなんて…♡」\n④絶頂してしまうのどか。あそこから汁が垂れてしまう。\nのどか「ああ！！イくぅぅぅ！！♡♡♡」\nちゆ「きゃっ！ああ…素敵…♡」\n⑤余韻に震えるのどか\nのどか「はぁ…はぁ…気持ちよかった…♡」\nちゆ「のどかはやっぱりかわいい♡」\n\n以上でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/264", "thumbnail_src": "https://si.imgix.net/c128bfec/uploads/origins/6d43c86b-8d27-4f85-a3a7-f7bfeec8afa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f70e6b104754f544e5852697c0da15", "thumbnail_srcset": "https://si.imgix.net/c128bfec/uploads/origins/6d43c86b-8d27-4f85-a3a7-f7bfeec8afa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46f70e6b104754f544e5852697c0da15, https://si.imgix.net/c128bfec/uploads/origins/6d43c86b-8d27-4f85-a3a7-f7bfeec8afa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4a329dacbd0b3609790fbde22e85df6 2x, https://si.imgix.net/c128bfec/uploads/origins/6d43c86b-8d27-4f85-a3a7-f7bfeec8afa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfeb7bec0a4ff3074383fa555adaaf95 3x", "genre": "art", "nsfw": true, "body": "セロリーさん、お久しぶりです。久しぶりにリクエストさせていただきます。前回予告したとおり、風のいたずらシリーズのめぐひめver(ぴかりが丘中学制服冬服姿)をリクエストさせていただきます。今回の背景については、ぴかりが丘中学の正門でお願いいたします。あとはいつもと同じです(もちろん黒目線verも)。\n今回もよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/263", "thumbnail_src": "https://si.imgix.net/36ede47b/uploads/origins/3939d363-cdc3-4681-86e5-4b0721b83c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2797947c7aeb1e641429fa3d7ecbfffd", "thumbnail_srcset": "https://si.imgix.net/36ede47b/uploads/origins/3939d363-cdc3-4681-86e5-4b0721b83c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2797947c7aeb1e641429fa3d7ecbfffd, https://si.imgix.net/36ede47b/uploads/origins/3939d363-cdc3-4681-86e5-4b0721b83c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49dff3abe2bbf445d7a59b36eee6bbc3 2x, https://si.imgix.net/36ede47b/uploads/origins/3939d363-cdc3-4681-86e5-4b0721b83c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37566b44385980f83b7cdb07bd551d13 3x", "genre": "art", "nsfw": true, "body": "前回はありがとうございました。また、リクエストさせて頂きます。\nオトナプリキュアの美翔舞が竿役の恋人とセックスするイラストをお願いします。\nシチュエーションは、\n・ラブホテルのベッドの上で、背面座位の体勢で、舞は恋人から胸を揉まれながらセックスしている\n・舞と恋人は二人とも全裸\n・舞の髪型は、作中で見せたポニーテール\n・オトナプリキュア原作での舞は、彼氏が居たみたいですが直接は登場せず、作中でメールで舞に別れを告げていたので、今回の恋人の容姿は作者さんにお任せします\n・上記の理由で、今回のイラストにおける舞の恋人は、その後新しく付き合う事になった人という設定です。\n・舞の表情は、新しい恋人と相思相愛になれて時には甘えたり頼ったりできる様になったので、幸せや恋人への愛情、セックスでの快感を一緒に感じている\n・差分で、舞と恋人が同時に絶頂して膣内射精、膣外射精で全身精液まみれ、事後に笑顔で「一緒に幸せになろう」みたいな事を伝え合う\nです。\nお忙しい中、要望がかなり多く、難しいと思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/262", "thumbnail_src": "https://si.imgix.net/6519706f/uploads/origins/73e4e36e-8408-4f88-b0c1-58bbfad5550f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d7b3980892df2c0e5df2228c067ecc", "thumbnail_srcset": "https://si.imgix.net/6519706f/uploads/origins/73e4e36e-8408-4f88-b0c1-58bbfad5550f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d7b3980892df2c0e5df2228c067ecc, https://si.imgix.net/6519706f/uploads/origins/73e4e36e-8408-4f88-b0c1-58bbfad5550f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfce814e317d0cf54882d8d64955490b 2x, https://si.imgix.net/6519706f/uploads/origins/73e4e36e-8408-4f88-b0c1-58bbfad5550f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c3ff4295e94d7819cbbd9710d41fb30 3x", "genre": "art", "nsfw": true, "body": "ローター対決のイラストをお願いしたいです。\nキャラはまほプリのみらいとリコで\nミッドフォーム(ダイヤ)でお願いします。\nこれまでのイラストと同じように\n2人それぞれが絶頂するものと\n同時に絶頂するものの差分を\nお願いしたいです。\n絶頂の際は「イく！♡」の台詞で\nお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/261", "thumbnail_src": "https://si.imgix.net/d72bbea4/uploads/origins/7679dbfe-6084-42aa-859b-0c43693f3672?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb644e2e5925f1d16f5c663c2bb2ca1c", "thumbnail_srcset": "https://si.imgix.net/d72bbea4/uploads/origins/7679dbfe-6084-42aa-859b-0c43693f3672?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb644e2e5925f1d16f5c663c2bb2ca1c, https://si.imgix.net/d72bbea4/uploads/origins/7679dbfe-6084-42aa-859b-0c43693f3672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc3bf0c35d20b981f88ce7f09ce0483a 2x, https://si.imgix.net/d72bbea4/uploads/origins/7679dbfe-6084-42aa-859b-0c43693f3672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe3f1f16ea3f26f5b87dfa42dcb85ebb 3x", "genre": "art", "nsfw": true, "body": "こんにちは。今回もご依頼いたします。\n\nキャラはヒープリののどかとちゆ(ミッドフォーム)でシチュエーションは首輪リョナです。\n以前のイラストと同じイメージです⤵︎\nhttps://www.fanbox.cc/@tirofinire/posts/8490968\nただ、アングルは正面でお願いしたいです。\n流れは\n①首輪をつけられ怯えるのどかと気丈に振る舞うちゆ。\n②首輪が絞まり苦しむ2人。\n③さらに絞まり弱音を吐くのどかと必死に耐えるちゆ。\n④限界まで絞まり涙を流すのどか。ちゆに関しては涙の有無はお任せします。\n⑤首輪は緩むがレイプ目で弱った表情をする2人。\n\nこのような感じでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/260", "thumbnail_src": "https://si.imgix.net/d6afb8f0/uploads/origins/6bf857ae-3f0b-4422-bdd7-e767e5bd4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8e7bfe6f3ac7b5ecb0c14a939d0ebd9", "thumbnail_srcset": "https://si.imgix.net/d6afb8f0/uploads/origins/6bf857ae-3f0b-4422-bdd7-e767e5bd4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8e7bfe6f3ac7b5ecb0c14a939d0ebd9, https://si.imgix.net/d6afb8f0/uploads/origins/6bf857ae-3f0b-4422-bdd7-e767e5bd4094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e743f510b793a143ce747fd9c051dc8 2x, https://si.imgix.net/d6afb8f0/uploads/origins/6bf857ae-3f0b-4422-bdd7-e767e5bd4094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22f060768810cdfa6f27ea3d6712b2f4 3x", "genre": "art", "nsfw": true, "body": "ミッドフォームのマナりつで以下のイラストをお願いしたいです。\nhttps://skeb.jp/@tirofinire/works/250\n固まる時はできるだけ段階を踏む感じで\n徐々に固まっていく感じを出して欲しいです。\n固まり切る直前の叫び声はお互いの名前を\n読んで欲しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/259", "thumbnail_src": "https://si.imgix.net/1cd33fc6/uploads/origins/7f31c242-c1fe-457b-b30f-3da5a276ddbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72bad0210b2c46bae346a0d4052e286a", "thumbnail_srcset": "https://si.imgix.net/1cd33fc6/uploads/origins/7f31c242-c1fe-457b-b30f-3da5a276ddbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72bad0210b2c46bae346a0d4052e286a, https://si.imgix.net/1cd33fc6/uploads/origins/7f31c242-c1fe-457b-b30f-3da5a276ddbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7cabe75573fa0fc6f902921bfabb36de 2x, https://si.imgix.net/1cd33fc6/uploads/origins/7f31c242-c1fe-457b-b30f-3da5a276ddbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a547ed096c3ac3bb49685db7593aa5e2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/258", "thumbnail_src": "https://si.imgix.net/55b98149/uploads/origins/52387b73-1e2f-49c8-85e5-40fc1df58f85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a215468a4d61fe9503f6126247984860", "thumbnail_srcset": "https://si.imgix.net/55b98149/uploads/origins/52387b73-1e2f-49c8-85e5-40fc1df58f85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a215468a4d61fe9503f6126247984860, https://si.imgix.net/55b98149/uploads/origins/52387b73-1e2f-49c8-85e5-40fc1df58f85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=949bac8ca69ca215516c5678b836a4ca 2x, https://si.imgix.net/55b98149/uploads/origins/52387b73-1e2f-49c8-85e5-40fc1df58f85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0d695c1d1f956b0f043a27cfbdb95ce 3x", "genre": "art", "nsfw": true, "body": "キミとアイドルプリキュア♪の咲良うた、紫雨こころ、蒼風なな、三人の拘束連行シーンお願いします！\n\n衣装：\nミッドフォーム、既にダメージを受けていて、少しボロボロな状態。\n\nシチュエーション：\n戦に敗れ捕虜として連行されているシーン。\n手錠で後ろ手を拘束されている状態、連行のために縄を引っ張られるのですが、縄で首縄を付けられ、それを引っ張られる形でお願いします。\n参考URL：https://ibb.co/nQVjTMB\n顔は恐怖と屈辱で少し涙を浮かべています、これから身に起こるであろう事柄に、焦燥の相を露わにしていた。\n○ビットギャグ猿轡、黒い布で目隠しの差分お願いします！\n○可能でしたら、連行を見る民衆も入れて頂けたら嬉しいです。\n\n\n以上！\n直接的なR18表現はありませんが。\n他の詳細はお任せします、自由に調整してください。\n金額が足りない場合、条件付き再送要請をお送りいただけますと幸いです。\nご検討のほどよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/257", "thumbnail_src": "https://si.imgix.net/181b4ba6/uploads/origins/a3af42b2-be39-4333-8871-c17d09a79268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f55b9d33c0d02b2c2ebc81bb11c9a76", "thumbnail_srcset": "https://si.imgix.net/181b4ba6/uploads/origins/a3af42b2-be39-4333-8871-c17d09a79268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f55b9d33c0d02b2c2ebc81bb11c9a76, https://si.imgix.net/181b4ba6/uploads/origins/a3af42b2-be39-4333-8871-c17d09a79268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=282be11df0676247886614b64d354d55 2x, https://si.imgix.net/181b4ba6/uploads/origins/a3af42b2-be39-4333-8871-c17d09a79268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5ac84ed1131cf44f5b40c1162fdaaf0 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。\nリクエスト募集を再開されたとのことなので、よろしければ以下の内容をお願いします。\n\nキャラクターは、わんだふるぷりきゅあ！のキュアフレンディ\n\nシチュエーションは、風のいたずらでスカートがめくれてパンモロしてしまっているところで、強風に吹かれ、スカートが大きくめくれあがって、パンツが全開に見えてしまっている状態になり、 恥ずかしそうに赤面しながら悲鳴をあげている、というものにして頂きたいです。  \n\nまた、ポーズは、 正面から両手を頬に当てている、 といった仕草の恥ずかしがり方をして、構図は頭部から膝上のあたりで描いていただきたいです。\n\n衣装はキュアフレンディの通常コスチュームでパンツは白色のジュニアショーツにしていただきたいです。\n\nご検討頂けましたら幸いです。よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/256", "thumbnail_src": "https://si.imgix.net/dfc749a8/uploads/origins/f2ec8cfc-a392-4cc2-899c-3c78e66d014a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16203cb6c47851694cc2e1f466139e6d", "thumbnail_srcset": "https://si.imgix.net/dfc749a8/uploads/origins/f2ec8cfc-a392-4cc2-899c-3c78e66d014a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16203cb6c47851694cc2e1f466139e6d, https://si.imgix.net/dfc749a8/uploads/origins/f2ec8cfc-a392-4cc2-899c-3c78e66d014a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=675abee7c1e9f33c0b1f70b32d2d9b99 2x, https://si.imgix.net/dfc749a8/uploads/origins/f2ec8cfc-a392-4cc2-899c-3c78e66d014a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=789cb74f7503ffca0770017b29b540ae 3x", "genre": "art", "nsfw": true, "body": "こんばんは。久しぶりにご依頼させていただきます。\n\nキャラクターはここねちゃん。\n以前の依頼の続きです。⤵︎\nhttps://www.fanbox.cc/@tirofinire/posts/8490968\n\n流れ\n1 少し反抗的な目でこちらを見るここね。\n2 首輪が締まり苦しみ始める\n3 更に締まり悲鳴を上げ始める。\n4 更に締まり涙を流す。\n5 首輪が緩みレイプ目でこちらを見つめるここね。\nこのような感じでお願いします。\n今回衣装はミッドフォームのみで、\nアングルは真正面からでお願いしたいです。\n台詞はお任せでお願いします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/255", "thumbnail_src": "https://si.imgix.net/30fee2fc/uploads/origins/8e892e5e-ac3f-4f49-a487-22494386deda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec05ec975f3c4ac4ef3520d41379178e", "thumbnail_srcset": "https://si.imgix.net/30fee2fc/uploads/origins/8e892e5e-ac3f-4f49-a487-22494386deda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec05ec975f3c4ac4ef3520d41379178e, https://si.imgix.net/30fee2fc/uploads/origins/8e892e5e-ac3f-4f49-a487-22494386deda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0b1610e85fbff06bed4661ec49a74f0 2x, https://si.imgix.net/30fee2fc/uploads/origins/8e892e5e-ac3f-4f49-a487-22494386deda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f65c11fdf1b86cc74fc4c4373b4a06db 3x", "genre": "comic", "nsfw": true, "body": "下記過去期限切れ内容、再トライです。\n\nキュアムーンライトがダークプリキュアに敗北する1話冒頭が、私の妄想通りに完敗するifの世界だったら…を叶えていただけますか？\n\n・1話冒頭のifなので、ダークプリキュアはオッドアイで\n・キュアムーンライトは巨乳が希望(爆乳不要)\n・1話冒頭はフォルティシモの正面衝突で抜けた後、変身解除でしたが、本ifでは、両者空中衝突後、ダークプリキュアのパワーに押されて(開眼の衝撃波を付けるとなお良い)、爆破後に着地なしで、そのままキュアムーンライトが上空に吹き飛ばされる\n・その後、上空から落下するキュアムーンライトを地上で待ち構えたダークプリキュアに見事に蹴り飛ばされ、地面に2,3回叩きつけられながらようやく仰向け姿で停止。蹴られる感じは本編34話でキュアムーンライトがダークプリキュアの光弾を反射利用して墜落させたときに強烈に蹴り飛ばしたアレです。仰向け姿は、コスチュームのスカートの切れ目がめちゃめちゃギリギリ大事なところが見えないくらいまで深く開いた感じでお願いします。\n・仰向け姿のまま立ち上がれないキュアムーンライトの至近距離にダークプリキュアが立ち、両胸の真ん中くらいをターゲットにして、超至近距離でダークフォルテウェイブ(赤黒い蕾の形をしたエネルギー弾をぶっ放す方)を撃ち込まれたキュアムーンライトはそのままもう一度全身が見えなくなる爆破後気絶敗北。気絶敗北した全身の麗しい姿を見せてください。(しっかり息はさせてあげてください、あくまでヒロピンの範疇)\n・その後変身解除してネグリジェ姿の全身を、イラストの差分のように同じ構図で見せてください。1話仕様で、髪の毛はキュアムーンライトのまま。こころの種を真っ二つではなく、粉々に撒いてください。\n・細かいセリフはお任せしますが、二人ともめっちゃかっこいいのでそのイメージは崩さず。ダークフォルテウェイブを撃ち込む前に「私の眼には、必殺技二つとも打ち勝たねば月は一つにならないことが映像のように流れてくる…ここで手加減をしてはいけない」と、本編のメタ発言をするダークプリキュアのセリフをいれてください。\n\nだいぶ激しい攻撃が多いですが、キュアムーンライトは今でも単独最強の頂点と個人的には思い続けているので、そんな彼女が完敗する…のにどうしても妄想上は必要でした。\n\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/254", "thumbnail_src": "https://si.imgix.net/11ceaa48/uploads/origins/51fc5aad-dd52-4441-b2fc-2013a4d2cae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0453d5abd6b536ffb1ab3de07546824", "thumbnail_srcset": "https://si.imgix.net/11ceaa48/uploads/origins/51fc5aad-dd52-4441-b2fc-2013a4d2cae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0453d5abd6b536ffb1ab3de07546824, https://si.imgix.net/11ceaa48/uploads/origins/51fc5aad-dd52-4441-b2fc-2013a4d2cae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9542ded9aed43c5204832b2b42037201 2x, https://si.imgix.net/11ceaa48/uploads/origins/51fc5aad-dd52-4441-b2fc-2013a4d2cae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=661c7b4f6efae0828c8e92013de10f49 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。良い機会ですので、久しぶりにリクエストさせて頂きます。\nヒーリングっど♥プリキュアの花寺のどかが、竿役の恋人とセックスするイラストをお願いします。\nシチュエーションは、\n・恋人の部屋のベッドの上で、右斜め前のアングルで、対面座位の体勢でだいしゅきホールド\n・のどかと恋人は、二人とも全裸\n・恋人の身体が透けて、のどかの身体が見える\n・恋人は行為の最中に、のどかの頭や髪の毛、背中を優しく撫でたりさすったりしている\n・のどかの表情は、恋人とのセックスで快感や幸せ、口癖の「生きてるって感じ」が現れている\n・差分で、膣内射精で同時に絶頂\nです。\n要望が多く、色々とお忙しいとは思いますが、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/253", "thumbnail_src": "https://si.imgix.net/57636fed/uploads/origins/fce2ed9b-052e-422a-8a5d-95b53578b72d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1e1474f1e0af6142bff2cbec6fb3c57", "thumbnail_srcset": "https://si.imgix.net/57636fed/uploads/origins/fce2ed9b-052e-422a-8a5d-95b53578b72d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1e1474f1e0af6142bff2cbec6fb3c57, https://si.imgix.net/57636fed/uploads/origins/fce2ed9b-052e-422a-8a5d-95b53578b72d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5267735cb578694690bccd06170e886 2x, https://si.imgix.net/57636fed/uploads/origins/fce2ed9b-052e-422a-8a5d-95b53578b72d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b30258e622dd16d64b8381877ea2be18 3x", "genre": "art", "nsfw": false, "body": "セロリーさん、こんにちは。\nいつも素敵なイラストありがとうございます。\n今回は、ぱろっと先生の読み切り「迷子のお星さま」のイラストを描いていただきたいです。\n\n「迷子のお星さま」のセリカちゃんとせいらちゃんの、以下のようなシチュエーションのイラストをお願いします。\n\nセリカちゃん、せいらちゃんがキミプリのライブシーン配信(プリルンが勝手にアップしたもの)を見ている\nせいらちゃんがセリカちゃんのインカムを指しながら宇宙人仲間？と聞いている\n\nインカム繋がりのキミプリパロであれば、上記と違う流れでも構いません。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/252", "thumbnail_src": "https://si.imgix.net/87e5fa20/uploads/origins/a890b193-8812-47a6-b579-c31b331f819d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06448c45a369157b81aa83df7eda95ed", "thumbnail_srcset": "https://si.imgix.net/87e5fa20/uploads/origins/a890b193-8812-47a6-b579-c31b331f819d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06448c45a369157b81aa83df7eda95ed, https://si.imgix.net/87e5fa20/uploads/origins/a890b193-8812-47a6-b579-c31b331f819d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c6d8ff550ab67fc6f377cc91ecde76c 2x, https://si.imgix.net/87e5fa20/uploads/origins/a890b193-8812-47a6-b579-c31b331f819d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc4712492f163821490b19cf67b9a52a 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n募集再開されたとの事で\nまたご依頼させていただきます。\n\nキャラはなおちゃんとれいかさん\nミッドフォームでのローター対決です。\n⤵︎資料\nhttps://www.fanbox.cc/@tirofinire/posts/9594152\n同じように\nローター責めされてる2人。\nなおがイく\nれいかがイく\n同時イき\n事後\nという感じでお願いします。\n台詞は基本お任せしますがイくときは\nなお「イく！」\nれいか「イきます！」\nでお願いします。\n\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/251", "thumbnail_src": "https://si.imgix.net/844d4a83/uploads/origins/252f9196-cadd-42b3-b60a-b37b1ba09e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bce2a956c4269d367ed23eaadc27209d", "thumbnail_srcset": "https://si.imgix.net/844d4a83/uploads/origins/252f9196-cadd-42b3-b60a-b37b1ba09e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bce2a956c4269d367ed23eaadc27209d, https://si.imgix.net/844d4a83/uploads/origins/252f9196-cadd-42b3-b60a-b37b1ba09e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fa1877a536844ceff8bd71211081bf0 2x, https://si.imgix.net/844d4a83/uploads/origins/252f9196-cadd-42b3-b60a-b37b1ba09e9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=944067a11b14fab9d617ba29740c5295 3x", "genre": "art", "nsfw": true, "body": "セロリーさん、お久しぶりです。プリキュア5gogoの風のいたずらパンチラ以来のリクエストをさせていただきます。今回も風のいたずらですが、別のプリキュアシリーズのキャラクターです。\n①キャラクター：ハピネスチャージプリキュアより大森ゆうこと氷川いおな、どちらもぴかりが丘中学校制服冬服姿で正面向き(めぐみとひめは過去に描いていらっしゃったようなので、今回はこの2人としました)\n②イラストの詳細：5gogoの時と同じく、2人並んで登校中、突風でパンチラしてしまい、驚きの表情を浮かべるという内容です。街中の歩道での出来事という設定でお願いします。建物についてはセロリーさんにお任せします。\n③差分について：今回は黒目線差分のみで結構です。理由はお分かりだと思います。\n\n以上になります。今回もよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tirofinire/works/250", "thumbnail_src": "https://si.imgix.net/4bd577a0/uploads/origins/416f8107-fdf2-45b0-96dd-a720d4e92f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b645ec39b13412db66d3532ce892983", "thumbnail_srcset": "https://si.imgix.net/4bd577a0/uploads/origins/416f8107-fdf2-45b0-96dd-a720d4e92f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b645ec39b13412db66d3532ce892983, https://si.imgix.net/4bd577a0/uploads/origins/416f8107-fdf2-45b0-96dd-a720d4e92f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fedc701fd1709ebc474b93ef27136114 2x, https://si.imgix.net/4bd577a0/uploads/origins/416f8107-fdf2-45b0-96dd-a720d4e92f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20d2584047d8c97342fbdaf8f2ce75f8 3x", "genre": "art", "nsfw": true, "body": "まほプリのみらリコのミッドフォームリョナを\nお願いしたいです。\n2人はミライデイズの大人バージョンで\n衣装はピンクダイヤ\n恋人繋ぎをしながら結晶化\nしてしまうイラストをお願いします。\n徐々に固まっていく感じで、\n台詞もありでお願いしたいです。\n(こんな感じで)⤵︎\nhttps://www.fanbox.cc/@tirofinire/posts/7830471\n\n初めての依頼なので拙いですが\n受けていただけたら嬉しいです。", "created_at": "", "completed_at": ""}]}