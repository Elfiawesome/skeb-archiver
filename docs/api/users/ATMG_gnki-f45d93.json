4ebb-87a2-ba666c4d0954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4234e9022797b0ed96fb50be2180a6ee", "thumbnail_srcset": "https://si.imgix.net/380dcd05/uploads/origins/7d6b6dab-dcbd-4ebb-87a2-ba666c4d0954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4234e9022797b0ed96fb50be2180a6ee, https://si.imgix.net/380dcd05/uploads/origins/7d6b6dab-dcbd-4ebb-87a2-ba666c4d0954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23c7f917752aee11e0ff57d1dc4b6316 2x, https://si.imgix.net/380dcd05/uploads/origins/7d6b6dab-dcbd-4ebb-87a2-ba666c4d0954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd965d7ae2038c2de3d377894dbc4165 3x", "genre": "art", "nsfw": false, "body": "Hello. I just saw your art work and would love to commission a drawing for my Vtuber! \n\nShe is a sakura dog diety trapped in a human girl's body. She loves cherry blossoms, strawberries, and causing mischief. blossomShe has peachy pink hair and tail with a white gradient at the bottom. She also has Shiba inu puppy friends!\n\nI will leave the expression, pose, and outfit up to you! Please make it cute and fun! \n\nhttps://twitter.com/itsvareena/status/1520147742554615808\nhttps://twitter.com/itsvareena/status/1500622792181444609\n\nhttps://twitter.com/icedcreamie/status/1565785170229317633/photo/1", "created_at": "", "completed_at": ""}, {"path": "/@ATMG_gnki/works/5", "thumbnail_src": "https://si.imgix.net/6c5f0725/uploads/origins/237c9923-2661-42d0-8b13-ef162505c481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f72319b5e9998759ef8b232073e2fc39", "thumbnail_srcset": "https://si.imgix.net/6c5f0725/uploads/origins/237c9923-2661-42d0-8b13-ef162505c481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f72319b5e9998759ef8b232073e2fc39, https://si.imgix.net/6c5f0725/uploads/origins/237c9923-2661-42d0-8b13-ef162505c481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6e4bb34552ebb85d9fc3d4de0678d43 2x, https://si.imgix.net/6c5f0725/uploads/origins/237c9923-2661-42d0-8b13-ef162505c481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79a91d09faa62e51d6d249cac9dc4207 3x", "genre": "art", "nsfw": false, "body": "初めまして。個人Vtuberとして活動しているかおたんといいます。\nこの度、お米たいた🍚様の素敵なイラストの数々を拝見し、ご依頼させて頂きました。\nリクエストしたいキャラクターは、私ことかおたんをお願いしたいと思っています。\n\n資料は下記を参考にお願い致します。\n\nhttps://twitter.com/kaota_n52\n\n・ポージング・服装・ヘアスタイル等のアレンジなどは自由にして頂いて大丈夫です。\n・ファイル形式はpsdでお願いします。\n・キャラクターイラストのみを使用させていただく場合がございますので、お手間でなければサインや背景等はレイヤー別だと大変助かります。\n・今回のイラストは、主にTwitterのアイコンやツイートに使用。YouTube動画OPEDやサムネイルにも使用させて頂きたいと考えております。\n\n改めて、よろしくお願いいたします。\n\nhttps://twitter.com/kaota_n52", "created_at": "", "completed_at": ""}, {"path": "/@ATMG_gnki/works/4", "thumbnail_src": "https://si.imgix.net/45173b37/uploads/origins/570dc2f4-cce1-45f5-b98b-221c5188a685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f6f7b81154438d0cd0df175d0635548", "thumbnail_srcset": "https://si.imgix.net/45173b37/uploads/origins/570dc2f4-cce1-45f5-b98b-221c5188a685?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f6f7b81154438d0cd0df175d0635548, https://si.imgix.net/45173b37/uploads/origins/570dc2f4-cce1-45f5-b98b-221c5188a685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eecb3f442320d31d6fcaf8ea17bd60bb 2x, https://si.imgix.net/45173b37/uploads/origins/570dc2f4-cce1-45f5-b98b-221c5188a685?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a7aa4f21e7d0b983a9eb3c07eba744b 3x", "genre": "art", "nsfw": false, "body": "こんにちは。今までの作品の色使いがとても好きです。\n\nひだまりスケッチの夏目さんの絵をお願いしたいのですが、添付のアルバムにある服装のどれでもいいです。絵の中の衣装はどれでも構いません。ポーズや構図はお任せします!\n\nhttps://imgur.com/a/qbcmCCu", "created_at": "", "completed_at": ""}, {"path": "/@ATMG_gnki/works/3", "thumbnail_src": "https://si.imgix.net/f17677d9/uploads/origins/34f22f47-6d58-4cf8-9505-82c73ffecfe7?bg=%2