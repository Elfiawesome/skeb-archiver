45a2e74aa7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6669a0e6ff0f3c2a96bdf16df9cb2f24, https://si.imgix.net/86ac51f6/uploads/origins/4a35c436-987f-4df9-b3fc-45a2e74aa7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b44eb6bbb939b5fead42349355f85043 2x, https://si.imgix.net/86ac51f6/uploads/origins/4a35c436-987f-4df9-b3fc-45a2e74aa7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76b5288da7f5db2d82ce4e0b59ad3372 3x", "genre": "art", "nsfw": false, "body": "VtuberのElfinpsyopを球体で描いてください。\n\n幸せそうな表情で描いてください。\n\nhttps://files.catbox.moe/3924zo.png\n\nhttps://files.catbox.moe/3924zo.png", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/96", "thumbnail_src": "https://si.imgix.net/7149e199/uploads/origins/d43bcb04-1ea2-4599-ab08-20fc32948df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de65ff53038e7fee2156c66337626c62", "thumbnail_srcset": "https://si.imgix.net/7149e199/uploads/origins/d43bcb04-1ea2-4599-ab08-20fc32948df8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de65ff53038e7fee2156c66337626c62, https://si.imgix.net/7149e199/uploads/origins/d43bcb04-1ea2-4599-ab08-20fc32948df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=187ff0ba55dd16fbea1168991eaf012c 2x, https://si.imgix.net/7149e199/uploads/origins/d43bcb04-1ea2-4599-ab08-20fc32948df8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0261f3378382a787fb240eed39df41f0 3x", "genre": "art", "nsfw": false, "body": "初依頼です。\n海/凪/小/春（きらら/ファンタジア水着衣装）の戦/国/コレクション8話風の膨体化をお願いします。\n\nシチュエーションとしては、海で泳いでいるとハリセンボン型の魔物に刺され、体から膨らんでいき、最終的にまん丸に膨らんだ戦/国/コレクション8話風の膨体化した状態で、海の上でぷかぷか浮かんでいるという構図でお願いします。\n\n刺されて膨らんだ直後は驚いていて、海の上で浮かんでいる際は顔を赤らめて涙目の表情でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/95", "thumbnail_src": "https://si.imgix.net/09711d96/uploads/origins/2d621d53-db6f-4b76-bbf2-0d763fd6d22e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=321087cd0463786efbc38964ba2bf821", "thumbnail_srcset": "https://si.imgix.net/09711d96/uploads/origins/2d621d53-db6f-4b76-bbf2-0d763fd6d22e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=321087cd0463786efbc38964ba2bf821, https://si.imgix.net/09711d96/uploads/origins/2d621d53-db6f-4b76-bbf2-0d763fd6d22e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0d770d15f0ad587950d0c317d34d065 2x, https://si.imgix.net/09711d96/uploads/origins/2d621d53-db6f-4b76-bbf2-0d763fd6d22e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0901eb9d3a77027a175881e60548c2a3 3x", "genre": "art", "nsfw": false, "body": "先日は依頼に答えていただきありがとうございました。\n\n今回は、橘ありすちゃんの膨体絵をお願いします。\n\n以前のちひろさんのように手足は体に埋もれさせず歩ける程度に膨らませ、背中側も膨らませたタルのような体型にしてください。服は破れないでボタンも飛ばずに耐えていて、身体にぴっちりしている状態でお願いします。\nムッと怒っている表情でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/94", "thumbnail_src": "https://si.imgix.net/747857a7/uploads/origins/70f5748e-b169-48b5-ab66-0deea6ecaa73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1e1a4ca32fa210c6d7e87943b759f58", "thumbnail_srcset": "https://si.imgix.net/747857a7/uploads/origins/70f5748e-b169-48b5-ab66-0deea6ecaa73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1e1a4ca32fa210c6d7e87943b759f58, https://si.imgix.net/747857a7/uploads/origins/70f5748e-b169-48b5-ab66-0deea6ecaa73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=503850bbe3703040ecb1d93956ae5aa4 2x, https://si.imgix.net/747857a7/uploads/origins/70f5748e-b169-48b5-ab66-0deea6ecaa73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8e6e8d2ac2034ad0bfc82476bfca950 3x", "genre": "art", "nsfw": true, "body": "いつも投稿作品を楽しみにしています。\nうちの子の平面化イラストをお願いします。\nうちの子の参照画像はこちら（背後のサーヴァントは描かなくても大丈夫です）→ https://cdn.tw6.jp/i/tw6/combined_origin/1660/1227693_f16609_totalbody.jpg\n\nシチュエーションは後ろ手で縛られたうえで天井から吊された状態から潰されるイメージです。潰れ方はこちらを参照にしてください→\nhttps://pbs.twimg.com/media/F2j3_4jXAAAcyjX?format=jpg&name=large\n潰される前の吊された姿と潰れた後の表裏のイラストをお願いします。\n\n表情は涙目で恥ずかしがっている顔でお願いします。\n\n※アレンジOK、値上げ交渉による再送可\n\n差し支えなければ、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/93", "thumbnail_src": "https://si.imgix.net/9e1b3659/uploads/origins/fb52d5fe-2d11-469a-9e5f-751c34001276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=406669d5eb452c23724c64fd8aff131f", "thumbnail_srcset": "https://si.imgix.net/9e1b3659/uploads/origins/fb52d5fe-2d11-469a-9e5f-751c34001276?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=406669d5eb452c23724c64fd8aff131f, https://si.imgix.net/9e1b3659/uploads/origins/fb52d5fe-2d11-469a-9e5f-751c34001276?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91b657c94df1f0b9cc88bbb96a3c991b 2x, https://si.imgix.net/9e1b3659/uploads/origins/fb52d5fe-2d11-469a-9e5f-751c34001276?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9592ee1a0c34958f49491d23875b12c 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。1月に送ったリクエストの再送になります。\nけものフレンズのリョコウバト（リデザイン版）の膨体化をお願いします。\nシチュエーションとしては自分のキャリーバッグを持ち運びながら空を飛んでる姿をお願いします。青空や夜空といった時間帯はおまかせします。\n体型は前に送ったリクエスト（https://skeb.jp/@kitmotkat/works/66）と同じように、手足も動かせて胸も大きくなってる感じで、もし可能であればお腹周りのサイズを前よりも少し大きく描いていただけると嬉しいです。\n服は破れないでボタンも飛ばずに耐えていて、身体にぴっちりしている状態でお願いします。服からおへそや下着が見えちゃっても大丈夫です。\nよろしくお願いします。\n\nhttps://1drv.ms/f/s!AsNKZhdhLmrU5ESu1Y3MavDNdo5M?e=MY8OFA", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/92", "thumbnail_src": "https://si.imgix.net/f6a99104/uploads/origins/a93ae0b5-6090-4bb4-85e0-e9fdb7018552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f04914f617115d8e4f1469025c0d7e4", "thumbnail_srcset": "https://si.imgix.net/f6a99104/uploads/origins/a93ae0b5-6090-4bb4-85e0-e9fdb7018552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f04914f617115d8e4f1469025c0d7e4, https://si.imgix.net/f6a99104/uploads/origins/a93ae0b5-6090-4bb4-85e0-e9fdb7018552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b11ab0f3ee92d6e15f6f041dde8ea684 2x, https://si.imgix.net/f6a99104/uploads/origins/a93ae0b5-6090-4bb4-85e0-e9fdb7018552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca9778e61ce30e96acca847a77c31177 3x", "genre": "art", "nsfw": false, "body": "以前はありがとうございました。とても良かったです。\n今回は早瀬ユウカ(ブルーアーカイブ)のソフトな箱化をお願いします。\n\n・調理用の秤（カービィのグルメフェスで出てきた感じの）に載せられてる感じでお願いします。\n\n・ユウカの体重が重すぎて、秤が壊れ、針が飛び出してる感じでお願いします。\n\n・表情は恥ずかしがりながら、怒ってる感じでお願いします。\n\nソフトな箱化参考↓\nhttps://x.com/se7cond/status/1315628211510730758?s=20\n\nhttps://x.com/se7cond/status/1316514120988938243?s=20", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/91", "thumbnail_src": "https://si.imgix.net/05d6e105/uploads/origins/bd7ed8da-cc6f-435f-8c39-59bc019f4540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f436532567d9838b5c6e4a5b41db96fe", "thumbnail_srcset": "https://si.imgix.net/05d6e105/uploads/origins/bd7ed8da-cc6f-435f-8c39-59bc019f4540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f436532567d9838b5c6e4a5b41db96fe, https://si.imgix.net/05d6e105/uploads/origins/bd7ed8da-cc6f-435f-8c39-59bc019f4540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c50661eb6a29e40d6bb233154346b994 2x, https://si.imgix.net/05d6e105/uploads/origins/bd7ed8da-cc6f-435f-8c39-59bc019f4540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c469ec9f19c0bac2e2320bfd1267d387 3x", "genre": "art", "nsfw": false, "body": "X/Twitterでお初にお目にかかります！\nよろしければ、私のOC「23(ツグミ)」の球体化イラストをお願いしたいです！\n\n【OC「23(ツグミ)」の設定資料】\n- https://www.dropbox.com/scl/fi/88gyqyxuwhni02o6igykc/23.png?rlkey=vd0exjvotetm18me2pxicn69t&dl=0\n- https://www.dropbox.com/scl/fi/56xoz03ixhnnu7zffpqmf/.png?rlkey=nfcl0bgbfuth8p7mn1dnr3xzs&dl=0\n- http://www.numbertales-radiann.com/characters/character23.html\n\n【球体化イメージについて】\n以下のリンクにある通り、四肢無し衣装付きで真球に近い形状の球体化をお願いします。\n- https://skeb.jp/@kitmotkat/works/40\n- https://skeb.jp/@kitmotkat/works/43\n- https://skeb.jp/@kitmotkat/works/63\n- https://skeb.jp/@kitmotkat/works/83\n表情や動作は、まんざらでもなくむしろ楽しんでいるように描いていただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/90", "thumbnail_src": "https://si.imgix.net/ce326106/uploads/origins/a696d6e0-4254-46ba-98b0-f30f63f19801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5264e8ac5494a1eb0378143167974d9a", "thumbnail_srcset": "https://si.imgix.net/ce326106/uploads/origins/a696d6e0-4254-46ba-98b0-f30f63f19801?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5264e8ac5494a1eb0378143167974d9a, https://si.imgix.net/ce326106/uploads/origins/a696d6e0-4254-46ba-98b0-f30f63f19801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0643f61b65e18a7dcf269859794dddd5 2x, https://si.imgix.net/ce326106/uploads/origins/a696d6e0-4254-46ba-98b0-f30f63f19801?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8de593d5ae43f3bf4be5ad279fadef78 3x", "genre": "art", "nsfw": false, "body": "再送要請ありがとうございますm(_ _)m\n再送しようと思ったが、何故か再送出来なかったので\n再送の代わりとして、先程と全く同じ内容で新しくリクを送らさせていただきますm(_ _)m\n\n『スクールガールストライカーズ』の『湊 小春』の膨体をお願いします！\\(˙꒳˙ )/\n\n〜構図〜\n身体がまん丸に膨らんでしまい、風船のようにふわふわ〜ってなってるような感じでお願いします！\n\n膨れた身体の大きさですが、この前描いてくれた悠水の膨体絵(https://skeb.jp/@kitmotkat/works/76)が好みの大きさでしたので\nそれぐらい大きいと嬉しいです！\n\n胸が結構デカい子なので、胸も大きいとなお嬉しいです！\n\n〜表情〜\n困惑な表情で\n\n〜服装・髪型〜\n『ヴァルキリー』コスで！\n\nhttps://dengekionline.com/articles/53361/images/4/", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/89", "thumbnail_src": "https://si.imgix.net/d4b970b9/uploads/origins/8d7ba1eb-8004-4127-aead-57f1a4b3ac28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13f8b9db55ec7f49fd81b00ff91bdb30", "thumbnail_srcset": "https://si.imgix.net/d4b970b9/uploads/origins/8d7ba1eb-8004-4127-aead-57f1a4b3ac28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13f8b9db55ec7f49fd81b00ff91bdb30, https://si.imgix.net/d4b970b9/uploads/origins/8d7ba1eb-8004-4127-aead-57f1a4b3ac28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e0d3f6c6c2fee834f6be7dedcfd4fc6 2x, https://si.imgix.net/d4b970b9/uploads/origins/8d7ba1eb-8004-4127-aead-57f1a4b3ac28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f6ff2e34cf896421de286cd304dd732 3x", "genre": "art", "nsfw": true, "body": "KATくんちゃんさんお久しぶりです。もしよろしければ、DDRシリーズのユニ・バースお嬢様で\n\n〇半潰れ\n〇顔が見えない縦平面化　表＆裏\n(〇立ち絵)\n\n……計3～4種のイラストをお願いできないでしょうか？\n・資料URL\nhttps://twitter.com/shi_gang/status/1565580317980651520\n\n\n半潰れ・縦平面化は以前描いていただいた↓こちらと同じ感じで\nhttps://skeb.jp/@kitmotkat/works/11\n「胸を強調気味」、半潰れ時顔を見せる場合「ジト目or無表情で怒り気味」な感じで……\n※正面向きなど描きやすいアングルに変更OK\n\n衣装はリンク先の4th衣装(黒セーラー服)で、スカートが非常に短いため\n「半潰れ時点・縦平面化表からでもパンツがはみ出て見える」ように描いていただけるとありがたいです。\n※(下着の色はセーラー服と全く同じ黒色)、ただしお腹を強調して描かれる場合は下着が隠れてもOK\n\n\n……可能であればさらに立ち絵もお願いしたく、資料URL1枚目(黄緑背景)のポーズをそのまま描いていただければ(頭身は描きやすいように調節可)と思いますが、多すぎると判断された場合は省略で大丈夫です。\n\n好きなキャラのかわいらしい潰れ姿をKATくんちゃんさんの絵柄で是非ともお目にかかりたく、ご一考頂ければ幸いですm(_ _)m", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/88", "thumbnail_src": "https://si.imgix.net/410928b0/uploads/origins/260cd86f-e016-4cbf-a268-fccb087ff302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e79b4144cc2ed36d02aaee7745b10e", "thumbnail_srcset": "https://si.imgix.net/410928b0/uploads/origins/260cd86f-e016-4cbf-a268-fccb087ff302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e79b4144cc2ed36d02aaee7745b10e, https://si.imgix.net/410928b0/uploads/origins/260cd86f-e016-4cbf-a268-fccb087ff302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ec275453940e77f7fe1bad572c68428 2x, https://si.imgix.net/410928b0/uploads/origins/260cd86f-e016-4cbf-a268-fccb087ff302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c7b0dace51ee086442256c4089537a0 3x", "genre": "art", "nsfw": false, "body": "以前はありがとうございました。ホントに良かったです。\n白坂小梅のキャンドル化をお願いします\n\n・表情はお任せします。\n\nキャラ参考↓\nhttps://imas.gamedbs.jp/cg/image_sp/card/l/5fe1faaee0a52e41f24eea585a682df5.jpg\nキャンドル化参考↓\nhttps://x.com/se7cond/status/1364125222853513219?s=20\n\nhttps://www.pixiv.net/artworks/97985625", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/87", "thumbnail_src": "https://si.imgix.net/ca1a2eee/uploads/origins/40681e99-5fba-44c0-a505-15575459dac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2527b3d564c18beb6d4f5f9209cbc40f", "thumbnail_srcset": "https://si.imgix.net/ca1a2eee/uploads/origins/40681e99-5fba-44c0-a505-15575459dac8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2527b3d564c18beb6d4f5f9209cbc40f, https://si.imgix.net/ca1a2eee/uploads/origins/40681e99-5fba-44c0-a505-15575459dac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a93faf73df314cafb7946bb8e90eec09 2x, https://si.imgix.net/ca1a2eee/uploads/origins/40681e99-5fba-44c0-a505-15575459dac8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61cb4c432c82679dd3afe7e44b8b174a 3x", "genre": "art", "nsfw": false, "body": "こんにちは\n\nダンスレッスン姿のときのそらさんを球体にしてください。\n\n- https://www.youtube.com/watch?v=EEc6ERUv3jQ\n- https://twitter.com/amanoern/status/1724039995953193184\n\nウインクと笑顔のあるハッピーな表情が好ましい\n\nありがとうございます", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/86", "thumbnail_src": "https://si.imgix.net/96a2da9f/uploads/origins/d34cfc39-c562-41ea-8419-e05cf9568f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0718dcabedea06ffc87ebcee0887658b", "thumbnail_srcset": "https://si.imgix.net/96a2da9f/uploads/origins/d34cfc39-c562-41ea-8419-e05cf9568f01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0718dcabedea06ffc87ebcee0887658b, https://si.imgix.net/96a2da9f/uploads/origins/d34cfc39-c562-41ea-8419-e05cf9568f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a9d04b133c747da31202e5cdec0b424 2x, https://si.imgix.net/96a2da9f/uploads/origins/d34cfc39-c562-41ea-8419-e05cf9568f01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32f1db0e9ff9be73b1713b9e9ce2120a 3x", "genre": "art", "nsfw": false, "body": "ニャハロ\n私のOCをオーブ/ボールにしてくれない？https://skeb.jp/@kitmotkat/works/60\n\nOC 参照： https://drive.google.com/file/d/1NEPHfrXApsV2MnnSWN6kfg4IGK9ggK8H/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/85", "thumbnail_src": "https://si.imgix.net/1b8f99a6/uploads/origins/bce96de3-bc04-429a-9228-de1fcef4acc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f74211061f43d07f196f4dd1697d47cc", "thumbnail_srcset": "https://si.imgix.net/1b8f99a6/uploads/origins/bce96de3-bc04-429a-9228-de1fcef4acc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f74211061f43d07f196f4dd1697d47cc, https://si.imgix.net/1b8f99a6/uploads/origins/bce96de3-bc04-429a-9228-de1fcef4acc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b82452813fb26f8b61485c221cac6e72 2x, https://si.imgix.net/1b8f99a6/uploads/origins/bce96de3-bc04-429a-9228-de1fcef4acc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=076911ecce7fe9215d758b8ea128ed7c 3x", "genre": "art", "nsfw": false, "body": "どうもこんばんは！以前リナというオリキャラを描いてもらった者ですが、その子の膨体化を描いていただきたいです！\n\nまた、以前の時と容姿が異なっているので下記のURLを参照していただきたいです。\n\n構図等は自由ですが、膨体のサイズは出来る限り大きく、胸は盛っていただき水風船の類いにしていただけるとありがたいです！\n\nご検討よろしくお願いいたします！\n\nhttps://imgur.com/a/rhyT3hC", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/84", "thumbnail_src": "https://si.imgix.net/89627868/uploads/origins/67b78cf2-3a2c-4d52-af0b-fc1c90ad8975?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7055c0bc5721fd2c186bef7ea00deb2", "thumbnail_srcset": "https://si.imgix.net/89627868/uploads/origins/67b78cf2-3a2c-4d52-af0b-fc1c90ad8975?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7055c0bc5721fd2c186bef7ea00deb2, https://si.imgix.net/89627868/uploads/origins/67b78cf2-3a2c-4d52-af0b-fc1c90ad8975?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8285c180bdf337d64ca33fb749ac01b 2x, https://si.imgix.net/89627868/uploads/origins/67b78cf2-3a2c-4d52-af0b-fc1c90ad8975?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=036a7383ccb41cfe66c1d7202a31b2b4 3x", "genre": "art", "nsfw": false, "body": "初めて依頼させていただきます。\n\n千川ちひろさんの膨体絵をお願いします。\n\n手足は体に埋もれさせず歩ける程度に膨らませ、背中側も膨らませたタルのような体型にしてください。\nhttps://www.pixiv.net/artworks/77281976\nこの中のみりあちゃんぐらいの体型でお願いします。\n服装は事務員の制服、髪型はいつもの三つ編みで、焦って照れている表情でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/83", "thumbnail_src": "https://si.imgix.net/dde50fa1/uploads/origins/d842e374-1eca-43e7-94d0-bd1a01fb17b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3cb4c02c6f2da63ebe525c9af580765", "thumbnail_srcset": "https://si.imgix.net/dde50fa1/uploads/origins/d842e374-1eca-43e7-94d0-bd1a01fb17b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3cb4c02c6f2da63ebe525c9af580765, https://si.imgix.net/dde50fa1/uploads/origins/d842e374-1eca-43e7-94d0-bd1a01fb17b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1d4bf760af04cf9b0231a08d63f0702 2x, https://si.imgix.net/dde50fa1/uploads/origins/d842e374-1eca-43e7-94d0-bd1a01fb17b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca9d07bb58cdef6e8c9cd7e2d100bf15 3x", "genre": "art", "nsfw": false, "body": "こんにちは！https://twitter.com/kitmotkat/status/1570737643394334721、Δ.を球形にしてください。\n\nΔ.: https://twitter.com/mgmgoi4/status/1708471935653629966\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/82", "thumbnail_src": "https://si.imgix.net/014acbed/uploads/origins/6b833ef3-94fa-47d8-b6c6-65747a016283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06af571fa57439b0418377ef589f67e1", "thumbnail_srcset": "https://si.imgix.net/014acbed/uploads/origins/6b833ef3-94fa-47d8-b6c6-65747a016283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06af571fa57439b0418377ef589f67e1, https://si.imgix.net/014acbed/uploads/origins/6b833ef3-94fa-47d8-b6c6-65747a016283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=493b734f206832ac9c38acd357c59e7f 2x, https://si.imgix.net/014acbed/uploads/origins/6b833ef3-94fa-47d8-b6c6-65747a016283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d74a757bb74e31dfa6ecf5ed5f30e83d 3x", "genre": "art", "nsfw": false, "body": "以前はありがとうございました。可愛かったです。\n今回も変化絵をお願いできますか。\n\nはたらく細胞BLACKの白血球（1196）さんの球体化（手足付き）をお願いします。\n\n・以前描いていただいた手足付き球体化とは若干違う感じで、\n脚はピッピ（ポケモン）みたいな感じで短く太い感じで、手も同じように太く短い感じでデフォルメチックな感じでお願いします。\n\n・右手に持った太刀を、片手で一生懸命に振り回して戦っている感じでお願いします。\n\n・丸い姿になっても胸の盛り上がりはそのままでお願いします。\n\n球体化参考↓\nhttps://www.pixiv.net/artworks/96556587\n\nhttps://www.pixiv.net/artworks/96723988\n\nhttps://www.pixiv.net/artworks/96729560", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/81", "thumbnail_src": "https://si.imgix.net/eabab9e3/uploads/origins/b85d407d-9b34-443f-a294-7720d7072cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afba6fe88cfa4ddff0528dc200a31f6", "thumbnail_srcset": "https://si.imgix.net/eabab9e3/uploads/origins/b85d407d-9b34-443f-a294-7720d7072cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afba6fe88cfa4ddff0528dc200a31f6, https://si.imgix.net/eabab9e3/uploads/origins/b85d407d-9b34-443f-a294-7720d7072cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af09ff07a6d3f7892ad9c34e2ca99e31 2x, https://si.imgix.net/eabab9e3/uploads/origins/b85d407d-9b34-443f-a294-7720d7072cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77dc9a43e163002c900f5dfc0bc00ee2 3x", "genre": "art", "nsfw": false, "body": "ホロライブの湊あくあで膨体をお願いしたいです。\n\n表情は困った感じで、胸は大きめに描いていただきたいです。\n\n服装は資料URLの水着でお願いします。\n\nhttps://www.pixiv.net/artworks/76532696", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/80", "thumbnail_src": "https://si.imgix.net/94eb42a1/uploads/origins/3cd66a7a-6c22-4438-89c3-addb051ae0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d6bbdc247419d05b9fc4e270fa3c07e", "thumbnail_srcset": "https://si.imgix.net/94eb42a1/uploads/origins/3cd66a7a-6c22-4438-89c3-addb051ae0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d6bbdc247419d05b9fc4e270fa3c07e, https://si.imgix.net/94eb42a1/uploads/origins/3cd66a7a-6c22-4438-89c3-addb051ae0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca4d24a090c2678a5c5d1d210fd697dc 2x, https://si.imgix.net/94eb42a1/uploads/origins/3cd66a7a-6c22-4438-89c3-addb051ae0f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec32ba8199e94f1db2804486c17fa67b 3x", "genre": "art", "nsfw": false, "body": "ファイアーエムブレムエンゲージよりセリーヌの膨体をお願い出来ますでしょうか？\nドレス衣装が難しい場合は私服衣装でも大丈夫です。\n膨らむ体格、ポーズ、傾きは(https://twitter.com/kitmotkat/status/1207748987291234304?s=46&t=OVcwasUcrDaeRVXlddKgWw)こちらのイラストの右側の子のような形にしてくれると嬉しいです。\nよろしければ是非よろしくお願いしたいです。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/79", "thumbnail_src": "https://si.imgix.net/9749079e/uploads/origins/7e531bba-c0b9-4b7e-89c0-a88ae39fb1a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0426d24424465155eefc9367f05b0b6a", "thumbnail_srcset": "https://si.imgix.net/9749079e/uploads/origins/7e531bba-c0b9-4b7e-89c0-a88ae39fb1a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0426d24424465155eefc9367f05b0b6a, https://si.imgix.net/9749079e/uploads/origins/7e531bba-c0b9-4b7e-89c0-a88ae39fb1a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b29b68d9a7247a5abb88d305adf1abcc 2x, https://si.imgix.net/9749079e/uploads/origins/7e531bba-c0b9-4b7e-89c0-a88ae39fb1a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16d9ebe88ca6bd8e6f97fb0ae91fc829 3x", "genre": "art", "nsfw": true, "body": "ゲゲゲの鬼太郎、六期のねこ娘での反物化をお願いします。\n\n\n「Wringer Box Illusion」という手品で使われてるような上と横にローラーの付いた箱を使って、先ず胸から下までローラーに巻き込まれ、下半身が長く引き伸ばされてから排出されていく。最終的に一枚の反物として仕上がり、…と、二枚分になります。（巻き込まれ部分と全身反物化で２枚）\n\n反物の差分として柄物（アニメ五期63話に出てくるネコ柄）や肌色無地（顔パーツはそのまま）とハイライトオフも筆が乗ったのであれば是非。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/78", "thumbnail_src": "https://si.imgix.net/28713793/uploads/origins/09976fd7-45fb-460c-b037-cf769148ff87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=709744aad53ea6d8d3dbaafc2844938b", "thumbnail_srcset": "https://si.imgix.net/28713793/uploads/origins/09976fd7-45fb-460c-b037-cf769148ff87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=709744aad53ea6d8d3dbaafc2844938b, https://si.imgix.net/28713793/uploads/origins/09976fd7-45fb-460c-b037-cf769148ff87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b215b6a18b1a791ab6c3c1c26492af15 2x, https://si.imgix.net/28713793/uploads/origins/09976fd7-45fb-460c-b037-cf769148ff87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=028a1e885fb061fbe6299bb3b73d6075 3x", "genre": "art", "nsfw": true, "body": "こんにちは。リクエスト失礼します。\nにゃんこ大戦争より召し豚のカイの半潰れ平面化をお願いします。\n急いでる様子で走っているカイが上からタライが降ってきて半潰れになりながらもてこてこと半泣き表情で歩いているシチュをお願いします。\n半潰れはこんな感じ\nhttps://twitter.com/kitmotkat/status/1577856176984756224?s=46&t=6cOBHr-pnjfzPkgpCYsIbQ\n服装は第3形態姿でお願い致します。\nhttps://battlecats-kouryaku.com/2017/02/21/post-11965/\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/77", "thumbnail_src": "https://si.imgix.net/97becc9d/uploads/origins/bbc6f737-f2a1-4a77-85c9-69bbeed1d154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef92c8d4231a554db8d451fa1f2ff80", "thumbnail_srcset": "https://si.imgix.net/97becc9d/uploads/origins/bbc6f737-f2a1-4a77-85c9-69bbeed1d154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ef92c8d4231a554db8d451fa1f2ff80, https://si.imgix.net/97becc9d/uploads/origins/bbc6f737-f2a1-4a77-85c9-69bbeed1d154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82607c1eb23d1b810ecd143eb4d6f0c1 2x, https://si.imgix.net/97becc9d/uploads/origins/bbc6f737-f2a1-4a77-85c9-69bbeed1d154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c98a67fd69256402225c4f46671a287b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！今週末、新しい女の子がデビューします！\n\nhttps://hololive.hololivepro.com/special/9028/\n\nこの2人のどちらかを選んでください\n\n- https://hololive.hololivepro.com/wp-content/uploads/2023/07/Shiori-Novella_pr-img_01.png\n- https://hololive.hololivepro.com/wp-content/uploads/2023/07/Koseki-Bijou_pr-img_01.png\n\n球体にしてください。\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@kitmotkat/works/76", "thumbnail_src": "https://si.imgix.net/dd639333/uploads/origins/48e8b3fd-3b55-4af2-b063-3bad6e75a68e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b07dd5ebe027d11449fdd3f766e619", "thumbnail_srcset": "https://si.imgix.net/dd639333/uploads/origins/48e8b3fd-3b55-4af2-b063-3bad6e75a68e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b07dd5ebe027d11449fdd3f766e619, https://si.imgix.net/dd639333/uploads/origins/48e8b3fd-3b55-4af2-b063-3bad6e75a68e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=256cdc637f857a56d96ebfb60ce49cfd 2x, https://si.imgix.net/dd639333/uploads/origins/48e8b3fd-