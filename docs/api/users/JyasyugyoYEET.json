c-c868-4ca9-9ca2-26e352ae7b26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60e29538168c8d19853618d53f0fbca8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/38", "thumbnail_src": "https://si.imgix.net/a1027566/uploads/origins/f6b1347d-aee5-4700-88ce-1c7ad3e4c442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c65e9dc4daebf431e540ae280e20e679", "thumbnail_srcset": "https://si.imgix.net/a1027566/uploads/origins/f6b1347d-aee5-4700-88ce-1c7ad3e4c442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c65e9dc4daebf431e540ae280e20e679, https://si.imgix.net/a1027566/uploads/origins/f6b1347d-aee5-4700-88ce-1c7ad3e4c442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b535187dffa795083017bc398b13e63 2x, https://si.imgix.net/a1027566/uploads/origins/f6b1347d-aee5-4700-88ce-1c7ad3e4c442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b7a17fe9256c87df2bd6f9cb56271b5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/37", "thumbnail_src": "https://si.imgix.net/509f32a5/uploads/origins/ffd5d990-f80f-4602-a332-6e1e39f566e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4391857cfd9d5ceb1d1fba03ef5ecfe2", "thumbnail_srcset": "https://si.imgix.net/509f32a5/uploads/origins/ffd5d990-f80f-4602-a332-6e1e39f566e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4391857cfd9d5ceb1d1fba03ef5ecfe2, https://si.imgix.net/509f32a5/uploads/origins/ffd5d990-f80f-4602-a332-6e1e39f566e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc271e576a8d1ffccff7b2afe8c7083d 2x, https://si.imgix.net/509f32a5/uploads/origins/ffd5d990-f80f-4602-a332-6e1e39f566e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da488a375019b3e641beb60ab9cadce0 3x", "genre": "art", "nsfw": true, "body": "遊戯王のRAI-MEIとトリックスター・ノーブルエンジェルのフタナリレズセックスをリクエストさせて頂きます\n\n受け:RAI-MEI。生えてない。全身むちむちの頭身高めで乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳。ツインテールは腰に届く位の長さ。\n\n竿役:ノーブルエンジェル。RAI-MEIと同様の体型かつ腹ボコ出来そうなサイズの巨根付。\n\n服装は2人とも元のカードのイラストで着ている物で、RAI-MEIは股間が♡型の穴空きで露出勃起した乳首と盛り上がった乳輪が布越しにくっきり浮かび上がっており、ノーブルエンジェルは陰茎がスカートを持ち上げて露出した状態です。体位はRAI-MEIの正面が良く見えるアングルでの正常位で、ノーブルエンジェルの様子はバストアップのワイプをRAI-MEIの横に別枠で写すようお願いします。\n\n挿入前。ノーブルエンジェルが挿入を焦らし、RAI-MEIがそれに対し完全に堕ちきった様子で媚びながら挿入を懇願する。\n↓\n挿入時。ノーブルエンジェルがSッ気のある表情で一気に挿入し、RAI-MEIはその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら二人とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n膣内射精&絶頂。二人とも汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\n…という流れで、それぞれに二人のセリフを付けて頂きたいです。キャラの性格や口調はRAI-MEIがくっ殺の似合う隠れマゾなお姉さん系、ノーブルエンジェルはドSでオラつきながらも言葉遣いが上品で、バブみを感じさせるお姉さんといったイメージです。\n\n細かく指定してしまいましたが何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/36", "thumbnail_src": "https://si.imgix.net/f0a36747/uploads/origins/3af884e4-4926-4fc9-a320-49fd61b31ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d87487399dad1d021db1f4cda37a304", "thumbnail_srcset": "https://si.imgix.net/f0a36747/uploads/origins/3af884e4-4926-4fc9-a320-49fd61b31ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d87487399dad1d021db1f4cda37a304, https://si.imgix.net/f0a36747/uploads/origins/3af884e4-4926-4fc9-a320-49fd61b31ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b35e3af818d27762123117039152240b 2x, https://si.imgix.net/f0a36747/uploads/origins/3af884e4-4926-4fc9-a320-49fd61b31ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=62f6c78b19fb40e3831c63eadf4d8888 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/35", "thumbnail_src": "https://si.imgix.net/6ceaf25c/uploads/origins/08c830ee-a44a-41c3-880f-747766017ae0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1dd2c2a10300720f67f7aa7e068419", "thumbnail_srcset": "https://si.imgix.net/6ceaf25c/uploads/origins/08c830ee-a44a-41c3-880f-747766017ae0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf1dd2c2a10300720f67f7aa7e068419, https://si.imgix.net/6ceaf25c/uploads/origins/08c830ee-a44a-41c3-880f-747766017ae0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d965e09340795aec28c5f29c77dbaac 2x, https://si.imgix.net/6ceaf25c/uploads/origins/08c830ee-a44a-41c3-880f-747766017ae0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e23ccdc397017ac2107fdc49c3d35f86 3x", "genre": "art", "nsfw": true, "body": "東北イタコさんの肉体寝取られ心は純愛R-18絵をお願いいたします。\n\nタトゥー刻まれ乳肉も膨らされ完全なQOSクソビッチにされはしたものの何故かマスター大好きなままのイタコさんが、BBC相手に本気のパイズリをして乳内射精&ぶっかけ、その後谷間のザーメンを下品に啜り上げごっくん。そして全身使用済みの抜け陰毛とザーメンまみれな姿でマスターへ愛情たっぷりにベロチューしたりザーメンゲップを嗅がせてあげながら托卵受精アクメするかんじのものをいただけると大変嬉しいです。\n可能でしたら淫語で、今日も明日もこれ以降もずっとBBCと交尾しまくる宣言と、それと同時にマスターのことは大好きだから絶対離れない倒錯した純愛宣言みたいなのを書いていただけると非常に捗ります。\n\nややこしいリクエストとは思うのですが、お手掛けいただけましたら幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/34", "thumbnail_src": "https://si.imgix.net/956e7a64/uploads/origins/e2b499c0-0900-4cc5-898e-38ef02939dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=519fc0113f4e88cf6dd9ffeb539dc6d9", "thumbnail_srcset": "https://si.imgix.net/956e7a64/uploads/origins/e2b499c0-0900-4cc5-898e-38ef02939dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=519fc0113f4e88cf6dd9ffeb539dc6d9, https://si.imgix.net/956e7a64/uploads/origins/e2b499c0-0900-4cc5-898e-38ef02939dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e76ba944b603493f55d63a5b8b359c6 2x, https://si.imgix.net/956e7a64/uploads/origins/e2b499c0-0900-4cc5-898e-38ef02939dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51714f7292f4997adbf5f20482e087e3 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回もけものフレンズのアフリカタテガミヤマアラシちゃんを描いてほしいです\n\n・おっぱいは盛れるだけ盛ってほしいです\n・服装はは何も着ていない全裸の状態\n・腰から生えている針の有無はお任せします\n\nシチュエーションは「大量搾乳」で\n・全裸で後ろからおっぱいを掴まれてる状態\n・ヤマアラシちゃんの正面に大きなガラス張りの水槽が置かれている\nこれを以下の差分でほしいです\n①目の前の水槽を見てこれいっぱいは無理と拒否している\n②否応なしにおっぱいを搾られ母乳がふきでる\n③水槽が溜まっていく\n④水槽が満たされそうになり、イキかける\n⑤絶頂して母乳が一気に噴きだして水槽が満杯になる\n⑥こんなにいっぱい…と絶頂の余韻が残りながらも驚く\n\n以上でお願いします。\n上記にないものはお任せします。\n是非ともご検討宜しくお願い致します。\n\nhttps://japari-library.com/wiki/Crested_Porcupine", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/33", "thumbnail_src": "https://si.imgix.net/23260531/uploads/origins/26c569d9-dffc-4fbc-abb8-2519a0c5b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e2464c12de0454a793f7783971a393c", "thumbnail_srcset": "https://si.imgix.net/23260531/uploads/origins/26c569d9-dffc-4fbc-abb8-2519a0c5b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e2464c12de0454a793f7783971a393c, https://si.imgix.net/23260531/uploads/origins/26c569d9-dffc-4fbc-abb8-2519a0c5b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d94c353274d4ef03eb6d8394f3fb9fee 2x, https://si.imgix.net/23260531/uploads/origins/26c569d9-dffc-4fbc-abb8-2519a0c5b0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=275438aff2d1bf0f2e3d7d2855ee7b9c 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回もまたまたまたけものフレンズのアフリカタテガミヤマアラシちゃんを描いてほしいです\n\n・おっぱいは盛れるだけ盛ってほしいです\n・服は何も着ていない全裸の状態\n\nシチュエーションは「四つ穴凌辱」で\n・ベットに寝ていて、それを上から見下ろしている構図\n・使用済みコンドームが転がっている\n・口、おまんこ、両乳首にコンドームを付けたおちんぽが入っている\n・体に落書きされている(内容はお任せします)\n・両胸から母乳を滴らせてほしい\n\nもし可能なら\n①四つの穴を犯されている\n②射精され絶頂する\n③よっつ全部のおちんぽが抜け、精子入りコンドームが中に残る\n④精子入りコンドームを引き抜かれる\n⑤引き抜かれてアへ顔になる\nの差分でほしいです。無理なら無理で大丈夫です\nまた、可能なら体の落書きがない差分も欲しいです\n\n上記にないものはお任せします。\n是非ともご検討宜しくお願い致します。\n\nhttps://japari-library.com/wiki/Crested_Porcupine", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/32", "thumbnail_src": "https://si.imgix.net/361eb880/uploads/origins/05164290-52b5-433a-a19b-5484682621c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8cf43efea52212d25621a7d59701228", "thumbnail_srcset": "https://si.imgix.net/361eb880/uploads/origins/05164290-52b5-433a-a19b-5484682621c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8cf43efea52212d25621a7d59701228, https://si.imgix.net/361eb880/uploads/origins/05164290-52b5-433a-a19b-5484682621c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f307899da6acb015df00f4ce37d5ad0 2x, https://si.imgix.net/361eb880/uploads/origins/05164290-52b5-433a-a19b-5484682621c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbd6b378fa8972499024a145b577b9c2 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n今回もけものフレンズのアフリカタテガミヤマアラシちゃんを描いてほしいです\n\n・おっぱいは盛れるだけ盛ってほしいです\n・服装は牛柄ビキニと牛柄のタイツ、長手袋、首にカウベル付の首輪をつけて欲しい\n・腰から生えている針の有無はお任せします\n\nシチュエーションは「搾乳機でがっつり搾乳」で\n・体をイスに固定されて動けない状態\n・両胸に搾乳機が付けられている\n・後ろにヤマアラシちゃんよりも大きい、ガラス張りのタンクが二つおいてある\n・搾乳機は後ろのタンクに繋がっている\n・搾乳機が動く前から母乳を滴らせてほしい\nもし可能なら\n①搾乳機が稼働する前\n②搾乳機が稼働し、母乳が噴き出す\n③搾乳され、母乳が後ろのタンクにどぷどぷ溜まっていく\n④タンクが8割程溜まり、イキそうになる\n⑤絶頂し母乳を大量に噴く、タンクが満タンになり搾乳機が母乳の勢いで外れる\n⑥アへ顔で母乳を垂らす\nの差分でほしいです。無理なら無理で大丈夫です\n\n上記にないものはお任せします。\n是非ともご検討宜しくお願い致します。\n\nhttps://japari-library.com/wiki/Crested_Porcupine", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/31", "thumbnail_src": "https://si.imgix.net/1a326ceb/uploads/origins/d22f6274-cf6a-4ee9-b74e-7a4950e0d985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c601c74d159e65440fb3dbe016586c", "thumbnail_srcset": "https://si.imgix.net/1a326ceb/uploads/origins/d22f6274-cf6a-4ee9-b74e-7a4950e0d985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c601c74d159e65440fb3dbe016586c, https://si.imgix.net/1a326ceb/uploads/origins/d22f6274-cf6a-4ee9-b74e-7a4950e0d985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa8ec11b4bb6863e92e75ba8a376f8fa 2x, https://si.imgix.net/1a326ceb/uploads/origins/d22f6274-cf6a-4ee9-b74e-7a4950e0d985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6400d8dce3845c52116234dada1c677 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです(本当)\n今回もけものフレンズのアフリカタテガミヤマアラシちゃんを描いてほしいです\n\n・おっぱいは盛れるだけ盛ってほしいです\n・服装は何も着ていない全裸の状態\n・腰から生えている針の有無はお任せします\n\nシチュエーションは「おちんぽとディルドでニプルファック」で\n・体は正面を向いていて、腕を頭の後ろに回して固定されている\n・体に落書きされている（落書きの内容はお任せします）\n・片方の胸にはおちんぽを入れられニプルファックされている\n・もう片方の胸はディルドを入れられ、第三者によってディルドを掴まれ、おっぱいをかき混ぜられている\n・両胸から母乳が滴ってほしい\nもし可能なら\n①両胸をいじられる\n②射精され絶頂、ディルドが抜ける\n③射精が終わってちんちんを抜かれた状態、ディルドが抜けて母乳がごぽごぽと溢れている\nの差分でほしいです。無理なら無理で大丈夫です\n\n上記にないものはお任せします。\n是非ともご検討宜しくお願い致します。\n\nhttps://japari-library.com/wiki/Crested_Porcupine", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/30", "thumbnail_src": "https://si.imgix.net/41512a5d/uploads/origins/0692ef96-0cbb-4837-bc48-7ffbfbbb7495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd4e3922254a1c15ec93148e89854ccf", "thumbnail_srcset": "https://si.imgix.net/41512a5d/uploads/origins/0692ef96-0cbb-4837-bc48-7ffbfbbb7495?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd4e3922254a1c15ec93148e89854ccf, https://si.imgix.net/41512a5d/uploads/origins/0692ef96-0cbb-4837-bc48-7ffbfbbb7495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6194f37a2fc7e13e4e645d684615c9d5 2x, https://si.imgix.net/41512a5d/uploads/origins/0692ef96-0cbb-4837-bc48-7ffbfbbb7495?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5344e09aa5ad6e5ba889cf986803f5ce 3x", "genre": "art", "nsfw": true, "body": "こんにちは.\nhttps://skeb.jp/@JyasyugyoYEET/works/13\n\nこちらのエロガキにやられる絵が良かったので、よかったら似たようなものをお願いしたいです.\n\nキャラクター: ベル(ポケットモンスター BW2, 眼鏡をかけた姿)\nポケモン博士の助手として働いているという背景があるキャラーです。\n\nポケモン研究所の現場学習のために2人の男の子がある程度研究所で過ごすことになったが、博士が忙しくて助手のベルが代わりに子供たちの世話をすることになる。\n\n1人は優しくて頭脳明晰な子で、ベルを見て初恋をしている。\nもう一人は エロガキだ. 毎回ベルにいやらしいイタズラをする\n\nシチュ：\n1. エロガキがベルの胸やお尻を触りながらイタズラする, ベルは慣れたように頭を軽く叩きながら叱り\n\"エロガキ君もOO君のように優しい子だったら良かったのにね~\" のように比較している.\n少年は憧れのベルにイタズラするガキに嫉妬しながらも、ベルは自分のことをもっと好きだから大丈夫だと思っている。\n\n2. 数日後\n同じくエロガキがベルにいやらしいイタズラをして少年は今回も鉄拳制裁されるだろうと思ったが、なぜかベルの姿がおかしい。 顔は熱くて, 声が妙だ。 二人はそのまま言い訳をして別の部屋に消える。\n\n3.そしてもちろんエロガキは激しくベルと交尾している。\nある夜、エロガキが研究所で保管していた催眠ポケモスリーパーを勝手に使って ベルに催眠をかけて無理やりにレOプし、映像を撮って脅迫した後、毎日好きなようにしていたのだ。\n\nベルは何とか辞めさせようとするが，すでに上下関係は逆転しており，勝手なエロガキが言うことを聞き入れることはない。\n続いて\"他のチビより私の方が好きだと言えば中に出すのはやめるよw\" と聞いて 結局ベルは「OO君よりエロガキ君の方が好き！」「初めて会った時からエロガキに惚れたよ！」…みたいなみっともないことを言ってしまうが、もちろんわがままなガキは約束を守らずに何度も好きなように出す。\n\n妄想が長くなりましたが簡単に描いてくださっても良いです。\n1-2-3で描いた方が楽ではないでしょうか(1-2はセリフと表情だけ変えればいいと思うので)\nよかったらベルちゃん, デカパイで描いてください...!\nご検討お願いします.", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/29", "thumbnail_src": "https://si.imgix.net/cc773054/uploads/origins/c95107f7-253e-46e8-b016-fc869374c04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0986bd7b710befa60e84cb66f3c9675d", "thumbnail_srcset": "https://si.imgix.net/cc773054/uploads/origins/c95107f7-253e-46e8-b016-fc869374c04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0986bd7b710befa60e84cb66f3c9675d, https://si.imgix.net/cc773054/uploads/origins/c95107f7-253e-46e8-b016-fc869374c04e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a52d6016a1b4e1e5771305b8f3683ee7 2x, https://si.imgix.net/cc773054/uploads/origins/c95107f7-253e-46e8-b016-fc869374c04e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79d5c699cbb0c1762e0037e79d867b38 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n作者様の描かれる作品が素晴らしかったので、リクエストをさせて頂きたいと思います。\n\n｢ポップンミュージック｣という作品の｢フォトン｣というキャラをお願いできますでしょうか。\n参考資料:https://popnmusic.fandom.com/wiki/Photon\nカラーは1Pカラーでお願いします。(資料ページ遷移時の表示はSP(2P)カラーになっていると思います)\n元デザインはシンプルな画風ですが、作者様の絵柄で描いて頂ければと思います。\nまた元デザインでは目が髪で隠れており、肌も白肌となっておりますが、\n描いて頂く際は目を見えるように描いて頂き、肌の色も白ではなく普通の肌色で描いて頂きたいです。\nその他にも色々と設定があるキャラクターですが、普通の女性として描いて頂ければと思います。\n\nお願いしたい内容ですが、\n作者様が描かれたこちらの作品がよかったので同じようなシチュエーションをお願いできますでしょうか。\nhttps://www.pixiv.net/artworks/115936759\n\n構図は作者様にお任せいたします。\nフォトンの容姿ですが、全裸に両手両足にカラーグローブとカラーソックスを履かせてください。\nまた身体のいたるところに汚っさんの好みで入れられた卑猥な落書きを入れてもらえますでしょうか。\n可能であれば顔にも入れてください。\n陰毛も濃い目にして頂けると幸いです。\n\n以上になります、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/28", "thumbnail_src": "https://si.imgix.net/2dbb77fb/uploads/origins/d5534d2a-8440-4540-a1e4-083c8ae02383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c349d4ff52e787b7f4b4ddf7dd0d32f6", "thumbnail_srcset": "https://si.imgix.net/2dbb77fb/uploads/origins/d5534d2a-8440-4540-a1e4-083c8ae02383?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c349d4ff52e787b7f4b4ddf7dd0d32f6, https://si.imgix.net/2dbb77fb/uploads/origins/d5534d2a-8440-4540-a1e4-083c8ae02383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b62067c617364bb0f103b4f8815628a5 2x, https://si.imgix.net/2dbb77fb/uploads/origins/d5534d2a-8440-4540-a1e4-083c8ae02383?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01b1cebd088205e6fe0db13506a1b356 3x", "genre": "art", "nsfw": true, "body": "自分の持ち主であるマスターの見抜き用オナペットになっていたら魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で爆乳化アへ顔アクメをキメる遊戯王OCGのRAI-MEIをリクエスト致します。\n\n・キャラクターの頭から膝上まで真正面から写して下さい\n・ほぼ白目を剥いた状態のアへ顔で潮吹き絶頂している\n・ウエストと同じくらいの太さの太もも\n・バストサイズは頭より大きく、へそが隠れて下腹部がギリギリ見えるくらい(大きければ大きいほど良いです)\n・コスチュームは元のカードのイラストと同じ物で、布越しに乳首と乳輪(どちらも大きめ)がくっきりと浮き出ている\n\nといった要素を指定致します。\n\n加えて、以下のシチュに沿った台詞のテキストを付けて頂きたいです。\n\n・目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され訳も分からぬまま間抜けな叫び声を上げて絶頂する。\n・微かに残った意識で止めさせようとするも快楽に負け更に汚い淫語を満載したアへオホ声で絶叫しながらイキっぱなしになる。\n\n…といった内容で、キャラクターの性格や口調はお好きなイメージで構いませんので、とにかく下品で無様なワードで画面を埋め尽くして欲しいです。\n\nまた、絶頂する直前の表情とセリフを一枚目として付けて頂きたいです。こちらはニヤニヤした顔で自分の事をエッチな目で見てくるマスターを小馬鹿にするような態度(好感度は高め)でお願いします。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/27", "thumbnail_src": "https://si.imgix.net/c513dac0/uploads/origins/3b582fb0-9114-4f25-bddf-cca7497b6979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e35075e7abd19bb95ff23cddf5ed9668", "thumbnail_srcset": "https://si.imgix.net/c513dac0/uploads/origins/3b582fb0-9114-4f25-bddf-cca7497b6979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e35075e7abd19bb95ff23cddf5ed9668, https://si.imgix.net/c513dac0/uploads/origins/3b582fb0-9114-4f25-bddf-cca7497b6979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2139ce8db110c71f988edf1470af15af 2x, https://si.imgix.net/c513dac0/uploads/origins/3b582fb0-9114-4f25-bddf-cca7497b6979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200