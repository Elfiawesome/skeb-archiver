si.imgix.net/3bae425e/uploads/origins/4ee1e0de-331e-4d4d-9239-00a6e79be6b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9b561b2d288c3da96979c3c393e5e68 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/41", "thumbnail_src": "https://si.imgix.net/14b35319/uploads/origins/e9b88477-cdd7-4327-b3c4-b649c3b60a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d59f85b94615e7e461005b14f242f6", "thumbnail_srcset": "https://si.imgix.net/14b35319/uploads/origins/e9b88477-cdd7-4327-b3c4-b649c3b60a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d59f85b94615e7e461005b14f242f6, https://si.imgix.net/14b35319/uploads/origins/e9b88477-cdd7-4327-b3c4-b649c3b60a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf90fca0fbd96531551306c067674a1b 2x, https://si.imgix.net/14b35319/uploads/origins/e9b88477-cdd7-4327-b3c4-b649c3b60a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b5dfcac602202f4c79416f852ce4e48 3x", "genre": "art", "nsfw": true, "body": "遊戯王から見抜きさせてくれるRAI-MEIとトリックスター・ノーブルエンジェルのコンビをリクエストします。\n\n体型は二人とも頭身高めの全身むちむちでへそを越え股間が隠れない程度の超乳(大きければ大きい程良いです)、服装はカードと同じ物です。\n\n二人の乳肉同士が密着する位の近さの横並びで太ももまでを写したバストアップを、以下のようなセリフのテキスト付き差分を用意して欲しいです。\n\nニヤけた表情でこちらを煽りオナニーを催促してくる\n↓\n大袈裟に白目を剥いたアへ顔と媚びるような喘ぎ声を見せて射精を催促してくる。\n↓\n演技だけのつもりが二人ともそのまま本当に絶頂してしまい、本気の顔面崩壊寸前のようなアへ顔と汚いアクメ声を晒してしまう。それと同時に竿役も射精。\n↓\n射精後。優しい態度で褒めてくれる。\n\nあくまでも竿役の主観での構図をイメージしているので、男性の身体や性器は一切写さず、キャラ2人のみを描いて頂ければ結構です。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "created_at": "", "completed_at": ""}, {"path": "/@JyasyugyoYEET/works/40", "thumbnail_src": "https://si.imgix.net/4330394e/uploads/origins/d4de6ab6-8372-440f-8fdb-37e90ee59e6b?bg=%23fff&auto=format%2Ccompress&fm=webp&