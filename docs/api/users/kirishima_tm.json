g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=546f91b63a01ba3ec2a1013ddddc6735", "thumbnail_srcset": "https://si.imgix.net/860c6903/uploads/origins/1eb057a2-1036-4443-9d12-09fd785300ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=546f91b63a01ba3ec2a1013ddddc6735, https://si.imgix.net/860c6903/uploads/origins/1eb057a2-1036-4443-9d12-09fd785300ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8309dce7167e02f064fbe42a8b71cd5 2x, https://si.imgix.net/860c6903/uploads/origins/1eb057a2-1036-4443-9d12-09fd785300ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bcbef9d603510e1204f97a6e42b9523 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kirishima_tm/works/13", "thumbnail_src": "https://si.imgix.net/8d6ed185/uploads/origins/bd991c55-f30e-4d28-ab8f-618adbdb84ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9b8240656fb9b2703dcfdf2a8e37efa", "thumbnail_srcset": "https://si.imgix.net/8d6ed185/uploads/origins/bd991c55-f30e-4d28-ab8f-618adbdb84ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9b8240656fb9b2703dcfdf2a8e37efa, https://si.imgix.net/8d6ed185/uploads/origins/bd991c55-f30e-4d28-ab8f-618adbdb84ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5baf4f492d2fa6a0cfa9af264b99ff6e 2x, https://si.imgix.net/8d6ed185/uploads/origins/bd991c55-f30e-4d28-ab8f-618adbdb84ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feada2881466e8c999ccb51568867f66 3x", "genre": "art", "nsfw": false, "body": "前回は素敵なイラストありがとうございました！\n今回もkirishima先生にイラストをお願いしたく、ご依頼させていただきました。\nよろしくお願いいたします。\n\n\n(以下依頼内容)\n\n見た目・装備品は以下のURLに添付されてる画像を確認していただけると幸いです。\n今回は等身イラストではなく、\"ミニキャラ\"でお願いいたします。\n\n【キャラクターについて】\n(ミニキャラなので不要かと思いますので参考程度にお願いします。)\n漆溪 聖征の身長が178cm\n茶山 明日花(幼少期)の身長が103cm\n\n【シチュエーションについて】\n2人で仲良くシロツメクサの花冠を作って遊ぶ様子を描いてくださると幸いです。\n\n \n【依頼した画像について】\n 自分で楽しむ様にスマホのホーム画面、Twitterのアイコン、アクリルスタンドなどのグッズ作成で使用させていただきます。\n\n長々と失礼いたしました。\nよろしくお願いいたします。\n\nhttps://twitter.com/3_sister____/status/1521097201744629760?s=21&t=rnmTrv9PE1XU-WNY21IQZw", "created_at": "", "completed_at": ""}, {"path": "/@kirishima_tm/works/12", "thumbnail_src": "https://si.imgix.net/9aa21e37/uploads/origins/075fb416-3a40-493f-a6cd-bafd212b9ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d18aa27cabaad387d692ce5153f7301", "thumbnail_srcset": "https://si.imgix.net/9aa21e37/uploads/origins/075fb416-3a40-493f-a6cd-bafd212b9ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d18aa27cabaad387d692ce5153f7301, https://si.imgix.net/9aa21e37/uploads/origins/075fb416-3a40-493f-a6cd-bafd212b9ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02b513f8bc07afe6bd4bc3ef1057306b 2x, https://si.imgix.net/9aa21e37/uploads/origins/075fb416-3a40-493f-a6cd-bafd212b9ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47e3244938755a016bfdbfc8a9b90fc7 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nkirishima先生のイラストが好きで、Skeb依頼させていただきました。不慣れで申し訳ないですがよろしくお願いいたします。\n\n(以下依頼内容)\n\nTRPGで使用しているオリジナルキャラクターの等身イラストを依頼させていただきたいです。\n\n見た目・装備品は以下のURLに添付されてる画像を確認していただけると幸いです。\n\n【キャラクターについて】\n主人の身長が178cm\nメイドの身長が147cmと身長差がある2人です。\n\n【イラストについて】\n主人がメイドの手の甲にキスを落とすシチュエーションでお願いいたします。\n(メイドの手袋は着けたままでお願いいたします)\n \n【依頼した画像について】\n 自分で楽しむ様にスマホのホーム画面、Twitterのアイコン、アクリルブロックで使用したいと思いますので正方形の形にしていだけると幸いです。\n\n長々と失礼いたしました。\nよろしくお願いいたします。\n\nhttps://twitter.com/3_sister____/status/1473126345832300545?s=21", "created_at": "", "completed_at": ""}, {"path": "/@kirishima_tm/works/11", "thumbnail_src": "https://si.imgix.net/bf7f95e3/uploads/origins/249ff4e7-1621-4085-b499-ce812cc1afea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c7d952f49bc9c49c3995a22ff2ba99", "thumbnail_srcset": "https://si.imgix.net/bf7f95e3/uploads/origins/249ff4e7-1621-4085-b499-ce812cc1afea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c7d952f49bc9c49c3995a22ff2ba99, https://si.imgix.net/bf7f95e3/uploads/origins/249ff4e7-1621-4085-b499-ce812cc1afea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8986e0049cefb881037eeb0cfd1cd131 2x, https://si.imgix.net/bf7f95e3/uploads/origins/249ff4e7-1621-4085-b499-ce812cc1afea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6604c4429292c9fdcad4d5640d449f7a 3x", "genre": "art", "nsfw": false, "body": "寅年生まれで、来年寅年なのでそれにちなんだマスコットSD的なものが希望です\n人型でもトラのちびキャラ的な感じでもよいですがお花ORスイーツに絡むような……可愛い普段使いマスコットみたいなのがいいなと\n基本的には可愛くてトラならお任せします\n気に入ったらTwitterのHOMEかアイコン、何かグッズにして個人の範囲で持ち歩きたいなーと思っていますが、問題あれば弾いてください\n以前、白紫陽花ちゃんお願いした者です！", "created_at": "", "completed_at": ""}, {"path": "/@kirishima_tm/works/10", "thumbnail_src": "https://si.imgix.net/c9dd8807/uploads/origins/1465bc79-8a12-4b7f-bc4e-f73a17b95b69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63a44b257a2a04aa41914ecc2f07f541", "thumbnail_srcset": "https://si.imgix.net/c9dd8807/uploads/origins/1465bc79-8a12-4b7f-bc4e-f73a17b95b69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63a44b257a2a04aa41914ecc2f07f541, https://si.imgix.net/c9dd8807/uploads/origins/1465bc79-8a12-4b7f-bc4e-f73a17b95b69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f593931955a28614d3137e42cd0c4c2 2x, https://si.imgix.net/c9dd8807/uploads/origins/1465bc79-8a12-4b7f-bc4e-f73a17b95b69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=