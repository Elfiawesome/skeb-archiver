cee6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72070d0c9550e5c3ab6e4d8518d2d11e", "thumbnail_srcset": "https://si.imgix.net/3d3f364d/uploads/origins/7d76a134-0378-45ad-8a3d-bb41a9cee6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72070d0c9550e5c3ab6e4d8518d2d11e, https://si.imgix.net/3d3f364d/uploads/origins/7d76a134-0378-45ad-8a3d-bb41a9cee6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=849aca273348c721d368bb96b01dad8c 2x, https://si.imgix.net/3d3f364d/uploads/origins/7d76a134-0378-45ad-8a3d-bb41a9cee6dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb88338e528a49364b3de52cf05abfbf 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ナルトとヒナタのデートをお願いしたいです。\n\nナルトは「おいろけの術」で女体化します。\n\nナルトはエレガントで女性らしい服装でお願いします。\n\nヒナタは男装してデートに行く。\n\nそのシチュエーションは楽しくてかわいいと思います。\n\nリクエストに応えていただき、ありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@tomura2maru/works/13", "thumbnail_src": "https://si.imgix.net/7d470f0a/uploads/origins/2b7a620f-f4f6-4526-8b41-3002a631f59d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e122783f9f612cf6cd467c67bc0ccc33", "thumbnail_srcset": "https://si.imgix.net/7d470f0a/uploads/origins/2b7a620f-f4f6-4526-8b41-3002a631f59d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e122783f9f612cf6cd467c67bc0ccc33, https://si.imgix.net/7d470f0a/uploads/origins/2b7a620f-f4f6-4526-8b41-3002a631f59d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a1adf182e303cbf37ca8cb4c88f7baa 2x, https://si.imgix.net/7d470f0a/uploads/origins/2b7a620f-f4f6-4526-8b41-3002a631f59d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f178260889d41f0743739f9db987ac45 3x", "genre": "art", "nsfw": true, "body": "ご依頼させて頂きます。\n\n描いて欲しいイラストは、\n大学生か20代前半ぐらいの年上彼女さんと\nホテルに入って、夜景が見える部屋で\n少し照れた感じで服を脱いで\n下着姿を見せてくれるイラストになります。\n下着姿は、\nブラジャー、パンティ、ガーターベルト、ニーソを\n付けた格好になります。\n\n指定としましては、以下になります。\n下着：\n刺繍やフリルが付いた大人っぽいデザインのもの\n\n年上彼女：\n大学生か20代前半ぐらいの優しげなな女性\nウェーブがかかったロングヘアでハーフアップ\nスタイルの良くて、おっぱいが巨乳、\n服を脱いだ状態で\nブラジャー、パンティ、ガーターベルト、ニーソを付けている、\nそれ以外の指定はありませんので、兎村まる様のご自由に作成頂いて\n構いません。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tomura2maru/works/12", "thumbnail_src": "https://si.imgix.net/34cbb346/uploads/origins/bdcc79a9-d246-48c4-bd5a-b4dec3e9990a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7882192fadb127526f563ecd4581e235", "thumbnail_srcset": "https://si.imgix.net/34cbb346/uploads/origins/bdcc79a9-d246-48c4-bd5a-b4dec3e9990a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7882192fadb127526f563ecd4581e235, https://si.imgix.net/34cbb346/uploads/origins/bdcc79a9-d246-48c4-bd5a-b4dec3e9990a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46e41c261c62aabf54dbd1a387bf3e1d 2x, https://si.imgix.net/34cbb346/uploads/origins/bdcc79a9-d246-48c4-bd5a-b4dec3e9990a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2968c9ee76978975205ac8a46ba0b2fa 3x", "genre": "art", "nsfw": false, "body": "初めてご依頼させてもらいます。スケブでの依頼以前に、イラストを頼むのが初めてなので少々抜けてるところもあるかもしれませんがご了承ください。\n\n考えてるオリキャラをお願いしようかと考えてた中で、先日投稿された穂波がほんとに好みでぜひ別のシチュエーションでもみたいと思ったのでこの形になりました。いわゆる差分のような形になりますがよければお願いします。\n\nシチュエーションに関しては、バスケ部ということもあったので2人での居残り練習という形でお願いしたいです(こちら側の人物は入れなくてもらっても大丈夫です)。\n居残り練習とは言っても…シュート練習とかドリブル練習とかも候補としてもありましたが、そうなると複数枚でみたい印象がありました。今回はちょっと初めてで勝手を知りたいこともあり1枚だけの依頼となるとでそこはまた別の機会にあればお願いしたいです。\n\n少し前座が長くなりましたが、本題としては居残り練習の休憩中という形でお願いしたいです。体育館でバスケットゴールが背後にある中で、バスケボールもちょっと転がってるようなところで、2人で座ってる話してるような感じでお願いしたいです。\n\n衣装に関しては、投稿されたのと同じように体育着で下もブルマで良かったらお願いします。投稿されたのはシャツを咥えてスポブラとへそ出し(とてもエッチでした)けど、それは下ろして貰えると嬉しいです。とは言っても、胸が成長期でシャツが短そうなのでおへそ見えそうな気もします。どんな体操着だよ！って感じですが、シャツが短い設定で、へそは続けて見える形でお願いします。あとはほなちゃんのキャラじゃないかもしれませんが、袖とかも捲って腋なんかも見せてくれると嬉しいです(腋フェチ)。\nそのような衣装とシチュエーションの中で、タオルで汗などを拭いてるシーンの1枚をお願いしたいです。または絶対下ろして欲しい！という訳でもないので、シャツで拭いて、片方のスポブラだけ見えるとかもちょっと良いなと思いましたので例としてあげさせてもらいます。決めきれずに申し訳ないですが、その時の兎村様の気分や描きやすさでお願いしたいです！\n\n\n以上になります。最初にも言ったようにこのような形で依頼するのは初めてなので、文章の乱れありましたら申し訳ないです。\nその他の理解しづらいところの付け足しや引いたりなどは問題ないのでアレンジしてもらって大丈夫です。\n\n改めてよければよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tomura2maru/works/11", "thumbnail_src": "https://si.imgix.net/8daa28e0/uploads/origins/9224db4b-6d1b-43ed-9471-32507edc4e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb86b7cd67fc88de609ec5fb7467e7bf", "thumbnail_srcset": "https://si.imgix.net/8daa28e0/uploads/origins/9224db4b-6d1b-43ed-9471-32507edc4e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb86b7cd67fc88de609ec5fb7467e7bf, https://si.imgix.net/8daa28e0/uploads/origins/9224db4b-6d1b-43ed-9471-32507edc4e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7b68eb331485d351ab2611a883e6280 2x, https://si.imgix.net/8daa28e0/uploads/origins/9224db4b-6d1b-43ed-9471-32507edc4e0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f44b3edc9cc4ba631cb8c48399e39c4e 3x", "genre": "art", "nsfw": true, "body": "ご依頼させて頂きます。\n\n描いて欲しいイラストは、\n昨年のTwitterで掲載されていたドレス姿の女性が素敵でしたので、\nその女性(または同じような女性)で\nウェディングベールとウェディングドレスを着てイチャイチャや\nエッチとしているイラストをお願い致します。\n\nイラストは、以下の2枚になります。\n①ウェディングベールを付けて、\n　ウェディングドレスを着た女性とイチャイチャしているイラスト\n　※正面からの構図で女性だけのイラストでお願いします。\n\n②ウェディングベールを付けて、\n    ウェディングドレスをはだけて、\n　おっぱいとアソコが見えている状態で\n　正常位でイチャイチャの中出しエッチしているイラスト\n　⇒エッチしている横に脱いだブラジャーとパンティも描いてください。\n\n指定としましては、以下になります。\n全ておっぱいが見える構図でお願い致します。\nどこかでキスシーンとか入れて頂けるとありがたいです。\n\n衣装(ウェディングドレス)：\nウェディングベールを付けて、\nロングスカートタイプもものでお願い致します。\n\n下着：\n赤系の色で、フリルや刺繍の入った大人っぽいデザインで\nお願いします。\n\n年上女性：\n昨年のTwitterで掲載されていたドレス姿の女性(優しい感じの美人な年上女性)\nウェデングベールを付けている\nロングヘア、\nスタイルの良い巨乳、\nメガネはなし、\n結婚指輪あり、\nヘアスタイルは、\nお団子などにはまとめずに、自然に垂らした感じのロングヘアでお願い致します。\nロングヘアのヘアスタイルはまとめてなければ、どんなものでも構いません。\n\nそれ以外の指定はありませんので、兎村まる様のご自由に作成頂いて\n構いません。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tomura2maru/works/10", "thumbnail_src": "https://si.imgix.net/7a15129c/uploads/origins/98883ada-8f28-414d-85ad-bc5c5089409d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa265d50438c2272effcd9daf9a40047", "thumbnail_srcset": "https://si.imgix.net/7a15129c/uploads/origins/98883ada-8f28-414d-85ad-bc5c5089409d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa265d50438c2272effcd9daf9a40047, https://si.imgix.net/7a15129c/uploads/origins/98883ada-8f28-414d-85ad-bc5c5089409d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55dc5a6e8efbc580d8d96b4fa8dbfd1f 2x, https://si.imgix.net/7a15129c/uploads/origins/98883ada-8f28-414d-85ad-bc5c5089409d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e7f704ad04faf760d37e7f938f8350b 3x", "genre": "art", "nsfw": true, "body": "また、ご依頼をさせて頂きました。\nご検討ください。\n\n描いて欲しいイラストは、\n前に描いて頂いたレオタードの女の子で、\n私服デートした後にレオタードを着て貰ってラブラブなエッチする\n内容になります。\n\nイラストは、以下の4枚になります。\n①私服でデートしているイラスト\n　※出来れば靴まで見える女の子の全体が見える構図\n\n②ホテルか彼女の部屋で、\n　私服をはだけて、ブラジャーやパンティを付けている(見えている)状態で\n　恥ずかしがりながらレオタードに着替えている時のイラスト\n\n③レオタードの胸元やアソコがはだけて見える状態で、\n　バックの体位でラブラブなエッチをしているイラスト\n　※レオタードを後ろから見て、背中やお尻のラインが見える構図\n\n④レオタードの胸元やアソコがはだけて見える状態で、\n　騎乗位でイチャイチャで激しくラブラブな中出しエッチしているイラスト\n\n\n指定としましては、以下になります。\n女の子：\nレオタードの年上女の子と同じ女の子\n※ロングヘア、スタイルの良くて巨乳、優しげな年上の女の子、メガネなし\n\nレオタード：\n前回と同じデザイン\n\n私服：\nロングスカートで清楚な年上女性が着るような服装\n\nその他\nいずれかのイラストでキスシーンかキスのカットインを入れて頂きたいです。\n\nそれ以外の指定はありませんので、兎村まる様のご自由に\n作成頂いて構いません。\nよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@tomura2maru/works/9", "thumbnail_src": "https://si.imgix.net/ff2125a7/uploads/origins/a8b1997b-f108-4d76-bca3-d7c85fc1723e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa96b70a6c553c0b11ae106e7c9a7c1d", "thumbnail_srcset": "https://si.imgix.net/ff2125a7/uploads/origins/a8b1997b-f108-4d76-bca3-d7c85fc1723e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa96b70a6c553c0b11ae106e7c9a7c1d, https://si