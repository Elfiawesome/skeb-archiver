t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f9be842315678f76db5851e1017deee 2x, https://si.imgix.net/8c1717b0/uploads/origins/7f06ff26-c2b4-4473-ad22-d6b6e25f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11e3ba8c02a789ea334ce4f5645e96cf 3x", "genre": "art", "nsfw": false, "body": "ハロー、アゲイン\n\n私たちは、あなたが前回描いてくれた絵をとても気に入っています！自由に描いてください。\n\nhttps://drive.google.com/drive/u/0/folders/1qcIvXMxPhDI8eci0wz-EVPQi1F992OB1", "created_at": "", "completed_at": ""}, {"path": "/@crp_3clmb/works/8", "thumbnail_src": "https://si.imgix.net/200d1907/uploads/origins/ce1ec35e-1826-406b-bc8c-e118e4eb6efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=992d2c7d9bf61ead177d3d63a1bf6450", "thumbnail_srcset": "https://si.imgix.net/200d1907/uploads/origins/ce1ec35e-1826-406b-bc8c-e118e4eb6efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=992d2c7d9bf61ead177d3d63a1bf6450, https://si.imgix.net/200d1907/uploads/origins/ce1ec35e-1826-406b-bc8c-e118e4eb6efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9398f0a0d6fe03570ed6c10d754d17fe 2x, https://si.imgix.net/200d1907/uploads/origins/ce1ec35e-1826-406b-bc8c-e118e4eb6efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0ff5df7d8b23293c7d7f4e3130696ef 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Skebを検索していてあなたの絵をいくつか見ましたが、あなたのスタイルが好きです！\n\nVTuberの千秋勝己を描いてほしい。彼女はゲームが得意なコンピューターハッカーです：\nhttps://x.com/ChiakiKatsumi/status/1675748859643850752\n\nこのような巡礼服を着ている彼女を描いてください：\nhttps://imgur.com/a/Ehullwm\n\nその他の詳細はすべてお任せします。私の依頼を楽しんでくれることを願っています！\n\nSNS(Twitter、YouTube)にクレジット付きで掲載させていただき、千秋がTwitterのスケジュールや動画のサムネイルに使用させていただきます。\n\nこの度はありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@crp_3clmb/works/7", "thumbnail_src": "https://si.imgix.net/2285d5e6/uploads/origins/47e747de-845f-4060-9be7-fdf62cf42136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5b42a678e51594a259335c8468063c", "thumbnail_srcset": "https://si.imgix.net/2285d5e6/uploads/origins/47e747de-845f-4060-9be7-fdf62cf42136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd5b42a678e51594a259335c8468063c, https://si.imgix.net/2285d5e6/uploads/origins/47e747de-845f-4060-9be7-fdf62cf42136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68ccfbae3e6dfdb35093833a986c29a7 2x, https://si.imgix.net/2285d5e6/uploads/origins/47e747de-845f-4060-9be7-fdf62cf42136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f0090a028091e347c40fc541b81756d 3x", "genre": "art", "nsfw": false, "body": "はじめまして！Skebで描かれた作品の可愛さに惹かれ、ダメ元でリクエストをお送りさせて頂きました。\nもしケモノキャラのリクエストが可能でしたら、以下の私のキャラクターを描いて頂く事は可能でしょうか？\n\n資料は以下となります↓\nhttps://www.dropbox.com/s/jozot3nnzr8jmrk/%E3%81%93%E3%82%93%E5%90%89%E4%BD%9C%E7%94%BB%E5%8F%82%E8%80%83small.jpg?dl=0\n\n↓隠れている所が分かる参考画\nhttps://www.dropbox.com/s/8yxui4j0nes5mqf/%E3%81%93%E3%82%93%E5%90%89%E4%BD%9C%E7%94%BB%E5%8F%82%E8%80%832small.jpg?dl=0\n\nキャラクター以外の内容指定は特にありません。デザイン省略など、描きやすい形でお願いできればと思います。ご無理のない範囲で描いて頂ければ結構です！", "created_at": "", "completed_at": ""}, {"path": "/@crp_3clmb/works/6", "thumbnail_src": "https://si.imgix.net/a1e016ea/uploads/origins/2b814f51-c2d2-48af-b724-838e8dbb3dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aeec939f33066220278dc63fc9e4bd7", "thumbnail_srcset": "https://si.imgix.net/a1e016ea/uploads/origins/2b814f51-c2d2-48af-b724-838e8dbb3dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aeec939f33066220278dc63fc9e4bd7, https://si.imgix.net/a1e016ea/uploads/origins/2b814f51-c2d2-48af-b724-838e8dbb3dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c783c364293c79c2d8ee65bd1a74295 2x, https://si.imgix.net/a1e016ea/uploads/origins/2b814f51-c2d2-48af-b724-838e8dbb3dc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ffd676455c91840eb0a1b49f671e013 3x", "genre": "art", "nsfw": false, "body": "再びこんにちは！前回もありがとうございました。ミュンスターという私のねずみOCの描き方がとてもかわいいです！またの依頼を考えていただけませんか？今回は私の友人のトリスタというネコミミの女の子を描きたいと思います。\n\n猫娘トリスタ：https://drive.google.com/file/d/1wBaTd0_QaF38Mr3z1ep410VcGZoN5JCv/view?usp=sharing\n\nミュンスター: https://drive.google.com/drive/folders/13EE4uG2XwZd6eY0Hj0KUCJjE_7wt96Wz?usp=sharing\n\nトリスタとミュンスターは付き合っている。トリスタは普通の人の大きさで、ミュンスターは彼女の手に収まる。トリスタはミュンスターをいじめる。時には、彼を食べ物に入れたり、調味料につけたりしていじめる。トリスタがミュンスターを蜂蜜の瓶につけるところを逆さまに描いてください。彼女がミュンスターの顔についた蜂蜜を舐めるショットを追加してください。", "created_at": "", "completed_at": ""}, {"path": "/@crp_3clmb/works/5", "thumbnail_src": "https://si.imgix.net/03d0eb8f/uploads/origins/bb6b9c30-4a2c-4158-8a3b-b1b52c215817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=016aef973b0f0cee01881a2acc36ff94", "thumbnail_srcset": "https://si.imgix.net/03d0eb8f/uploads/origins/bb6b9c30-4a2c-4158-8a3b-b1b52c215817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=016aef973b0f0cee01881a2acc36ff94, https://si.imgix.net/03d0eb8f/uploads/origins/bb6b9c30-4a2c-4158-8a3b-b1b52c215817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e63e33c04d23e9706441340bd8e0d91 2x, https://si.imgix.net/03d0eb8f/uploads/origins/bb6b9c30-4a2c-4158-8a3b-b1b52c215817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d44a92638eebb3518f97b69348f7bb43 3x", "genre": "art", "nsfw": false, "body": "こんにちは、\nアミヤを描いてほしい！\n彼女は優しくて、時々いたずら好きな蜘蛛の女の子です！\nキャラクターリファレンスはこちらです：\nhttps://twitter.com/amiyaaranha/status/1716507535857922077\n\nギャル服を着せてください。服装と髪型の参考はこちら：\nhttps://i.pinimg.com/736x/02/44/bb/0244bb5ef863d54c578cd7260d702a48.jpg\nhttps://i.pinimg.com/564x/c6/28/1d/c6281dae68d3a59ab0e061174bffa443.jpg\nhttps://i.pinimg.com/564x/eb/9b/d9/eb9bd9c9df741ea2b634e2104101baef.jpg\nhttps://i.pinimg.com/474x/d7/cb/76/d7cb760b7241c3fc96541193c39ea371.jpg\nhttps://i.pinimg.com/474x/2c/e8/59/2ce8592874411ea3e5536003e9d243cc.jpg\n\