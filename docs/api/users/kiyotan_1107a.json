61-43a8-b96f-de78f19428ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66c40431e87895b214924649ec04bab", "thumbnail_srcset": "https://si.imgix.net/e27b044b/uploads/origins/bd47ea8d-2861-43a8-b96f-de78f19428ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c66c40431e87895b214924649ec04bab, https://si.imgix.net/e27b044b/uploads/origins/bd47ea8d-2861-43a8-b96f-de78f19428ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2e06965ad4892be950e866706a2c7fc 2x, https://si.imgix.net/e27b044b/uploads/origins/bd47ea8d-2861-43a8-b96f-de78f19428ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1089299591f3e598e344f666696df0ca 3x", "genre": "art", "nsfw": false, "body": "きよ蔵様\nお世話になっております。前回は素晴らしいイラストをありがとうございました。\nまたイラストを描いて頂きたいと思い、リクエストさせていただきました。\n\n内容は、私　黒白ライカの抱き枕カバー風イラストをお願いしたいです。\nhttps://twitter.com/Laika_kokuhaku/status/1626580536008523779\nこちらの1枚目の衣装で、恥ずかしそうな表情でパーカーの前を外してはだけさせて頂きたいです。\n\nきよ蔵様の描かれた抱き枕カバーのイラストを拝見して、是非自分も描いて頂きたいと思いました。\nお忙しいとは思いますが、ご検討頂けると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@kiyotan_1107a/works/7", "thumbnail_src": "https://si.imgix.net/4e1ddf14/uploads/origins/94bebdb3-7ab1-4411-a826-2f66f005a7e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665c2a31290dbfe4611a5888adce1133", "thumbnail_srcset": "https://si.imgix.net/4e1ddf14/uploads/origins/94bebdb3-7ab1-4411-a826-2f66f005a7e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665c2a31290dbfe4611a5888adce1133, https://si.imgix.net/4e1ddf14/uploads/origins/94bebdb3-7ab1-4411-a826-2f66f005a7e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5040e965a652e38f1a7420fd10f59f0e 2x, https://si.imgix.net/4e1ddf14/uploads/origins/94bebdb3-7ab1-4411-a826-2f66f005a7e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a612b229e73974fff5eccc606b724ca 3x", "genre": "art", "nsfw": false, "body": "いつもかわいいイラスト拝見しております。\nきよ蔵先生に是非描いて頂きたいと思いご連絡している次第です。\nこの度はVTuberのさざなみゆんちゃん(@saza_kami  )のイラストをリクエストさせて頂きます。\n\n3/15に活動開始2周年を迎えるため、その記念とお祝いに贈りたいと考えております。\n\n資料urlは立ち絵並びに三面図等です。\n\n明るく元気いっぱいな笑顔で、背景・ポーズはおまかせでお願いします。\n\nキャラと背景で分けてPSDデータで頂けますと嬉しいです。透過差分などありますととても助かります。\n\nまた、イラストについてさざなみゆんちゃんご本人が Twitterにてアイコンやツイート、配信内、サムネイル等で使用する許可を頂けますと幸いです。\nご検討の程お願いいたします。\n\nhttps://twitter.com/saza_kami/status/1530172068775735297?s=46&t=ZoPEEgeohF5JeMGHt2Agig", "created_at": "", "completed_at": ""}, {"path": "/@kiyotan_1107a/works/6", "thumbnail_src": "https://si.imgix.net/662f4337/uploads/origins/41d976ef-1c48-4803-80ef-831f7cd295f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876316c3ea86143718fd473c11f169e9", "thumbnail_srcset": "https://si.imgix.net/662f4337/uploads/origins/41d976ef-1c48-4803-80ef-831f7cd295f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876316c3ea86143718fd473c11f169e9, https://si.imgix.net/662f4337/uploads/origins/41d976ef-1c48-4803-80ef-831f7cd295f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e90747c235479bea2edd0e2396edd68a 2x, https://si.imgix.net/662f4337/uploads/origins/41d976ef-1c48-4803-80ef-831f7cd295f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12cad1eb2abfb109ebf16e58ae768136 3x", "genre": "art", "nsfw": false, "body": "きよ蔵先生こんにちは、博多弁で喋ってくれる可愛い女の子が耳かきしているシーンを描いてほしいです、背景は畳部屋したら嬉しいです！", "created_at": "", "completed_at": ""}, {"path": "/@kiyotan_1107a/works/5", "thumbnail_src": "https://si.imgix.net/f1cbfe46/uploads/origins/4cc51e67-90ad-4412-83ed-3fdfe342ae28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a38cff29dc11e77f238a5bb6493e1316", "thumbnail_srcset": "https://si.imgix.net/f1cbfe46/uploads/origins/4cc51e67-90ad-4412-83ed-3fdfe342ae28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a38cff29dc11e77f238a5bb6493e1316, https://si.imgix.net/f1cbfe46/uploads/origins/4cc51e67-90ad-4412-83ed-3fdfe342ae28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8618b848fe40cc8f4e10b9f36a574bb9 2x, https://si.imgix.net/f1cbfe46/uploads/origins/4cc51e67-90ad-4412-83ed-3fdfe342ae28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc9ee30002943d38e7450136a4d610d8 3x", "genre": "art", "nsfw": false, "body": "きよ蔵先生　明けましておめでとうございます！こんにちは！\n前回も素敵なイラストありがとうございました！\n今回の依頼なのですが、VTuberのフェリシエ・プリエールさんのファンアートを描いて頂きたいです。\nご本人からもファンアート依頼の許可はいただいております。\n\nTwitter\nhttps://twitter.com/felicie_priere\nYoutube\nhttps://www.youtube.com/@felicie-priere\n\n【構図】\nにっこり笑顔で自分のほっぺたを軽く引っ張ってる姿をお願いします。\nその他背景などはおまかせになりますがよろしくお願いします。\n\n【使用用途】\nフェリシエさん本人が「YouTubeなどのライブ配信内、動画内での使用。またはサムネイル」「TwitterやSNS上での投稿」にて使用させていただく可能性があります。\n\n【その他】\n人物・背景等がレイヤー分け出来るPSDデータで頂けると有難いです。\n\n資料URLにはご本人のTwitterから画像をのせてあります。よろしくお願いします！\n\nhttps://twitter.com/felicie_priere/status/1561181481644355585", "created_at": "", "completed_at": ""}, {"path": "/@kiyotan_1107a/works/4", "thumbnail_src": "https://si.imgix.net/eb4d3cb0/uploads/origins/f6c4d65a-0775-43fc-a4a2-6456dc63c138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6021e1f8bf44fd49f13c510db348ce27", "thumbnail_srcset": "https://si.imgix.net/eb4d3cb0/uploads/origins/f6c4d65a-0775-43fc-a4a2-6456dc63c138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6021e1f8bf44fd49f13c510db348ce27, https://si.imgix.net/eb4d3cb0/uploads/origins/f6c4d65a-0775-43fc-a4a2-6456dc63c138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53c1bf9a162d1fac2d2fced77ac6b825 2x, https://si.imgix.net/eb4d3cb0/uploads/origins/f6c4d65a-0775-43fc-a4a2-6456dc63c138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7f379a524b333e3dd5b7f77e38a7d48 3x", "genre": "art", "nsfw": false, "body": "きよ蔵様 、はじめまして。\nVtuberとして活動をしている氷雪あいねと申します。\n\n今回、私、氷雪あいねのVRChatでのモデルのイラストをお願いしたくご連絡いたしました。\nどうか、フィギュア棚の費用にお使いください(*ᐢ˘x˘ᐢ)\n\n\n詳細についてまとめましたので、ご参考いただけると助かります\n◼︎希望サイズ\n2560*1440以上\n\n◼︎資料等について\nhttps://1drv.ms/u/s!AppR_PQI7YEUrOVI_-Tk_APBmGim9A?e=vevJMh\nURLごご参考下さい。\n\n\n◼︎データについて\nPSDデータで、背景などの透過差分があると助かります。\n\n◼︎使用範囲について\n配信サイトのヘッダー等、配信活動に使用します。\nまた各種グッズなどに用いる可能性もあります。\n\n\nご検討のほどをよろしくお願い致します。\n\nhttps://twitter.com/hiyukiaine/status/1581492301586497537", "created_at": "", "completed_at": ""}, {"path": "/@kiyotan_1107a/works/3", "thumbnail_src": "https://si.imgix.net/b60e503e/uploads/origins/583b00e5-c635-4659-8c08-ca4a7765628f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45b5d318b034ae808e0e7746b5a39663", "thumbnail_srcset": "https://si.imgix.net/b60e503e/uploads/origins/583b00e5-c635-4659-8c08-ca4a7765628f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45b5d318b034ae808e0e7746b5a39663, https://si.imgix.net/b60e503e/uploads/origins/583b00e5-c635-4659-8c08-ca4a7765628f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6ef0cd57c400395b6713edfc0d52c292 2x, https://si.imgix.net/b60e503e/uploads/origins/583b00e5-c635-4659-8c08-ca4a7765628f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c9edebc11a4c7bda59592b5d8afd430 3x", "genre": "art", "nsfw": false, "body": "きよ蔵先生こんにちは！\n前回依頼させていただいたこのみちゃんのイラストもとてもかわいく素晴らしかったです！\nリクエスト募集とのことで再度依頼させていただきました！受けていただけるとうれしいです。\n\n依頼なのですが、VTuberの泉谷このみさんのファンアートを描いて頂きたいです。\n\nTwitter\nhttps://twitter.com/izumiyakonomi/\nYoutube\nhttps://www.youtube.com/c/%E6%B3%89%E8%B0%B7%E3%81%93%E3%81%AE%E3%81%BFIzumiyakonomi\n\n【構図】\n笑顔でダブルピースをしている姿をお願いします！\n背景等はおまかせします。\n可能なら表情の差分があるとうれしいです！\n\n【使用用途】\n泉谷このみさん本人に限り使用許可を頂きたいです。※Twitter、配信サムネイル等に使用\n\n【その他】\n人物・背景等がレイヤー分け出来るPSDデータで頂けると有難いです。\n\n資料URLにはご本人のTwitterから画像をのせてあります。よろしくお願いします！\n\nhttps://twitter.com/izumiyakonomi/status/1490792986820681740", "created_at": "", "completed_at": ""}, {"path": "/@kiyotan_1107a/works/2", "thumbnail_src": "https://si.imgix.net/53dfeb3a/uploads/origins/b998