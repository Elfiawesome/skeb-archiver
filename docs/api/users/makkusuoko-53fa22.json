pleted_at": ""}, {"path": "/@makkusuoko/works/146", "thumbnail_src": "https://si.imgix.net/40fad23d/uploads/origins/dcb19159-64e0-4e49-84cc-85a6259ada63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=083025974d56ab1261ec77a4e2f3e408", "thumbnail_srcset": "https://si.imgix.net/40fad23d/uploads/origins/dcb19159-64e0-4e49-84cc-85a6259ada63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=083025974d56ab1261ec77a4e2f3e408, https://si.imgix.net/40fad23d/uploads/origins/dcb19159-64e0-4e49-84cc-85a6259ada63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90cec32098ba3db873234af83cf13f15 2x, https://si.imgix.net/40fad23d/uploads/origins/dcb19159-64e0-4e49-84cc-85a6259ada63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29c270093a2795469c003d133eb5ac85 3x", "genre": "art", "nsfw": false, "body": "私のOC「リミナリティ」をあなたのスタイルで見てみたい。大きな柔らかいコートに包まれた眠そうなキャラクターです。銃は入れないでください。ポーズなどはあなたのお好みで。リファレンスシートと過去に描いた絵のフォルダを添付します。ありがとうございました！\n\nhttps://www.dropbox.com/scl/fo/l6sm4j8wzt9iyodhipa76/AHyFBt34JV0dJGGqyiy4QEY?rlkey=yvj98hgn91bs8f2t9mi8o1uyv&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@makkusuoko/works/145", "thumbnail_src": "https://si.imgix.net/06cadba3/uploads/origins/d204858e-f754-4428-94bc-519aac49fc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65e47da43b67a0cf95ebc4b61d9808dc", "thumbnail_srcset": "https://si.imgix.net/06cadba3/uploads/origins/d204858e-f754-4428-94bc-519aac49fc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65e47da43b67a0cf95ebc4b61d9808dc, https://si.imgix.net/06cadba3/uploads/origins/d204858e-f754-4428-94bc-519aac49fc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89802031c039acc92f75f483fea77dfe 2x, https://si.imgix.net/06cadba3/uploads/origins/d204858e-f754-4428-94bc-519aac49fc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=20