umbnail_src": "https://si.imgix.net/b2d34ce2/uploads/origins/1626604d-9e64-4fa0-b6de-0306d0219132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3e25294ea4f1650b1a5640a6ed2c9cc", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/91", "thumbnail_src": "https://si.imgix.net/76dfb37d/uploads/origins/fa6e2b31-8be8-4e9a-ba91-6f1ecf3b2a7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30e71ffad2418a4772aa487ee4fd5f93", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/90", "thumbnail_src": "https://si.imgix.net/1411b17e/uploads/origins/a6636827-4073-4a28-8db9-52eeeab85889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ade7d0e06655e4ae83145f09212fb9e9", "thumbnail_srcset": "", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/89", "thumbnail_src": "https://si.imgix.net/0aeba397/uploads/origins/8c93e52f-562c-4396-9ea2-d282f7523bc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdc94fe7105a941d812c8bc390b378d7", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/88", "thumbnail_src": "https://si.imgix.net/48ba5b5e/uploads/origins/0e76ce2f-fd5c-4f3a-a2fd-5ec89cc229d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b84f709089a162a9c8dfa97a557478b", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "シチサブロー様、はじめまして。\nジョニー一等陸佐と申します。\nリクエストを再送させていただきます。\n今回、大東亜戦争の沖縄戦を舞台にしたコミックをリクエストさせていただきます。\n内容は第32軍の司令部壕の出入り口で高級参謀の八原博通大佐が偶然出会った日本兵の少女の二人組を見送るというものです。\n梱包爆薬や対戦車地雷を持って前線に向かおうとする少女達に彼女達の運命を察した八原大佐。そんな彼に少女達は自分達は消耗品ですから、と諦観した笑顔で言って立ち去り、八原大佐はなんとも言えない表情で彼女達を見送るというものです。\nご検討のほど宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/87", "thumbnail_src": "https://si.imgix.net/896b85e8/uploads/origins/e3b2c5a7-01dc-4ee0-a25d-4dd5f6e47792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bda0cb238af96efefcf6aaf789d5360", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/86", "thumbnail_src": "https://si.imgix.net/09997d98/uploads/origins/1340ed04-83e8-4830-be2d-f2392362972b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2e271f955533698e0160566679ccf82", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/85", "thumbnail_src": "https://si.imgix.net/f8ec171a/uploads/origins/7380bf26-0f59-47b9-9123-197f90d04f9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=542ed3822406bf2b52863be15054d3cd", "thumbnail_srcset": "", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@736kita/works/84", "thumbnail_src": "https://si.imgix.net/3f0c082a/uploads/origins/532578e9-ad21-498b-8fab-d440e0fcfb40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1043c4c9c2eadf8df20d7c0