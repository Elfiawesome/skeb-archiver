4-7fa0c5f8996e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8d231c0b00d312fbcd3c8a4fafc4df3, https://si.imgix.net/388e2330/uploads/origins/64197ef8-34e8-43bd-9b84-7fa0c5f8996e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a228830aaa7b2af9b23f33fd3d399011 2x, https://si.imgix.net/388e2330/uploads/origins/64197ef8-34e8-43bd-9b84-7fa0c5f8996e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b79b38285d4e2e8430944b94921f29cf 3x", "genre": "art", "nsfw": true, "body": "こんにちは。VTuber Dooby3dをお願いしたいです。\n\nDooby3dはかわいいビキニの水着を着ています。Dooby3dは立位宣教師位でセックスしています。\n\n絶頂の時、Dooby3dの頭の機関車ホーンが蒸気を吹きます。断面図と受精の表示が欲しい。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1sWxtSplUvfuV3kBO3okvUUt1ewiT8his?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@244__/works/128", "thumbnail_src": "https://si.imgix.net/3e3fa974/uploads/origins/bab2ce8b-9bc9-4a73-8ab8-6de86a2741c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f225cbab35a5b4b44f17a2f8c2d62091", "thumbnail_srcset": "https://si.imgix.net/3e3fa974/uploads/origins/bab2ce8b-9bc9-4a73-8ab8-6de86a2741c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f225cbab35a5b4b44f17a2f8c2d62091, https://si.imgix.net/3e3fa974/uploads/origins/bab2ce8b-9bc9-4a73-8ab8-6de86a2741c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80c7ed225e7055b54065d6976596a4df 2x, https://si.imgix.net/3e3fa974/uploads/origins/bab2ce8b-9bc9-4a73-8ab8-6de86a2741c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e52ebbabb52db5747b04fea925a5b985 3x", "genre": "art", "nsfw": true, "body": "ン○が座った巨根男の膝上に座って、先生とン○が会話を交わしています。\n先生「あら、ンゴちゃんその子の膝の上好きなの？」\nンゴ「うん！あったかくて好き！」\n男は自分のチンポを入れている間、女性の身体を乗っ取ることが出来ます。\nン○の中に巨根が入っており、ン○の言葉は男が喋らせています。\nン○の胸の辺りが巨根で浮き上がっています。\n外から気づかれないよう隠姦を楽しむシチュになります。\n巨根(学生):https://x.com/244__/status/1794754457479324005\n新衣装:https://x.com/Suo_Sango/status/1845028045679362218", "created_at": "", "completed_at": ""}, {"path": "/@244__/works/127", "thumbnail_src": "https://si.imgix.net/6741e8f1/uploads/origins/4c901a9f-761e-4a46-9184-9ef709c4af18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10ab4730843849f1767a904f296c304b", "thumbnail_srcset": "https://si.imgix.net/6741e8f1/uploads/origins/4c901a9f-761e-4a46-9184-9ef709c4af18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10ab4730843849f1767a904f296c304b, https://si.imgix.net/6741e8f1/uploads/origins/4c901a9f-761e-4a46-9184-9ef709c4af18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5993eb0a711d54c8ddb662337aacede1 2x, https://si.imgix.net/6741e8f1/uploads/origins/4c901a9f-761e-4a46-9184-9ef709c4af18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86b7540374161a7eb0e9e1c46115cfbe 3x", "genre": "comic", "nsfw": true, "body": "お世話になっております。依頼の内容ですが\n\nキャラクター:葉加瀬冬雪\n服装:艦これの島風コス\nシチュエーション:島風コスの葉加瀬がフタナリ化薬を飲んでフタナリ化してセンズリオナニーで射精する漫画をお願いします。\n台詞や擬音はおまかせします。\n\n以上の内容で問題なければお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@244__/works/126", "thumbnail_src": "https://si.imgix.net/ccc37c23/uploads/origins/c2496e7f-2105-4205-8b2f-e5f5f591032c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1e548e459869df8ee3dbb62e99a8ed2", "thumbnail_srcset": "https://si.imgix.net/ccc37c23/uploads/origins/c2496e7f-2105-4205-8b2f-e5f5f591032c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1e548e459869df8ee3dbb62e99a8ed2, https://si.imgix.net/ccc37c23/uploads/origins/c2496e7f-2105-4205-8b2f-e5f5f591032c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fcd8a5866707fa56df2933788a65f7c 2x, https://si.imgix.net/ccc37c23/uploads/origins/c2496e7f-2105-4205-8b2f-e5f5f591032c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da209fb85b79c5d66fc4e3f504ed4dc0 