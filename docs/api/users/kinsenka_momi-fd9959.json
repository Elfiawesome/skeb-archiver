e/u/0/folders/1d1xSvViBULpCPR9c8AswW1rO8DnIuPDJ", "created_at": "", "completed_at": ""}, {"path": "/@kinsenka_momi/works/58", "thumbnail_src": "https://si.imgix.net/8f577305/uploads/origins/6dad7a12-66dd-4e0b-93b7-991c51be0bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277e6bd8ca7d3b0fd83aea9358721fe2", "thumbnail_srcset": "https://si.imgix.net/8f577305/uploads/origins/6dad7a12-66dd-4e0b-93b7-991c51be0bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277e6bd8ca7d3b0fd83aea9358721fe2, https://si.imgix.net/8f577305/uploads/origins/6dad7a12-66dd-4e0b-93b7-991c51be0bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d235e68029cd8e476a19836cccd896e 2x, https://si.imgix.net/8f577305/uploads/origins/6dad7a12-66dd-4e0b-93b7-991c51be0bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c06443ff7898ead6521e4fbfaab2f30d 3x", "genre": "art", "nsfw": false, "body": "白神ふぶきを描いてください。彼女は机の上でコントローラーを使ってライブ配信をしています。机の上には黒神のぬいぐるみが置いてあります。その他の内容はお任せします、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@kinsenka_momi/works/57", "thumbnail_src": "https://si.imgix.net/a32b2fb5/uploads/origins/56423a74-f4e7-4a04-b3d8-81f3e8189873?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68dbe47ff4ac0688c8c3064bb1dc8654", "thumbnail_srcset": "https://si.imgix.net/a32b2fb5/uploads/origins/56423a74-f4e7-4a04-b3d8-81f3e8189873?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68dbe47ff4ac0688c8c3064bb1dc8654, https://si.imgix.net/a32b2fb5/uploads/origins/56423a74-f4e7-4a04-b3d8-81f3e8189873?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=229ab4ebc8ed738aa2a4bc393e785998 2x, https://si.imgix.net/a32b2fb5/uploads/origins/56423a74-f4e7-4a04-b3d8-81f3e8189873?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b592dc9b38cb41de8bce793220a5d38 3x", "genre": "art", "nsfw": fa