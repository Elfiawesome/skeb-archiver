5f-9635-7f91eea36b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59d41bae930ff01310541a21d1092a4e", "thumbnail_srcset": "https://si.imgix.net/8662abb0/uploads/origins/3f3e0bea-3c29-485f-9635-7f91eea36b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59d41bae930ff01310541a21d1092a4e, https://si.imgix.net/8662abb0/uploads/origins/3f3e0bea-3c29-485f-9635-7f91eea36b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da6d327c389bf3df1dcbabd2c6416d5e 2x, https://si.imgix.net/8662abb0/uploads/origins/3f3e0bea-3c29-485f-9635-7f91eea36b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a005241c217254274659a62ec3aec6b3 3x", "genre": "art", "nsfw": false, "body": "初めまして。ぽぺっっっっっと申します。\nTwitterでイラスト依頼を調べていたところ作品をお見かけしまして、素敵なイラストだと思い依頼させて頂きます。\n今回はイラスト1枚をお願いしたくご連絡致しました。\n\n・要望\nvtuberの咲夜あずさちゃんを描いて頂きたいです。笑っていて涙が溢れている顔を描いて頂けると嬉しいです。全体像ではなく上半身より上を描いて頂けると幸いです。リゼロのレムのセリフ「鬼ががってますね」の時みたいな感じで捉えて頂けると嬉しいです。\n\n本人参考資料\nTwitter: @sakuya_azusa\nYouTube:sakuya azusaCh.咲夜あずさ/プロプロ\n\n頂いたイラストはSNSのアイコンや本人のサムネ等にご使用させて頂けたらと思います。\n\nお忙しいところ恐縮ですが、よろしくお願い致します。\n\n\n参考資料\nhttps://www.google.com/imgres?imgurl=https%3A%2F%2Fsteamuserimages-a.akamaihd.net%2Fugc%2F1617176672224904715%2F4FA9DDFC65484FACD3971DBCDAF870FD48A10C7C%2F%3Fimw%3D5000%26imh%3D5000%26ima%3Dfit%26impolicy%3DLetterbox%26imcolor%3D%2523000000%26letterbox%3Dfalse&imgrefurl=https%3A%2F%2Fsteamcommunity.com%2Fsharedfiles%2Ffiledetails%2F%3Fid%3D744484687&tbnid=UUVlX3MwCPJO2M&vet=1&docid=gb_q1jSvLgRwwM&w=540&h=304&hl=ja&source=sh%2Fx%2Fim\n\nhttps://www.propro-production.com/", "created_at": "", "completed_at": ""}, {"path": "/@Babinch_/works/2", "thumbnail_src": "https://si.imgix.net/110e4c28/uploads/origins/f0e3e465-4230-4210-bbc3-91fd8366a435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7dc23c3e54a94546ced3e7211a1e36", "thumbnail_srcset": "https://si.imgix.net/110e4c28/uploads/origins/f0e3e465-