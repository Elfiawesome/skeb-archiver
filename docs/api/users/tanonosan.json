d2/uploads/origins/c4cf1cb2-6a79-4af2-9e67-1f629116f64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a20ee414a9f144ffe730f8e29094f7a3, https://si.imgix.net/2b96dad2/uploads/origins/c4cf1cb2-6a79-4af2-9e67-1f629116f64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d7ffd2873c4e781f86c4eed10ed52fb 2x, https://si.imgix.net/2b96dad2/uploads/origins/c4cf1cb2-6a79-4af2-9e67-1f629116f64d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fedfa60142d41a1fdfd87421365958b 3x", "genre": "art", "nsfw": true, "body": "こんにちは、いつもお世話になっております。\n\n今回はうちの子のここはさんを描いて頂けないかと思いリクエストしました。\n\nすべてたののさんにお任せでよろしくお願いします。\n\nhttps://x.com/KokohaKoha/status/1472402768866713604", "created_at": "", "completed_at": ""}, {"path": "/@tanonosan/works/188", "thumbnail_src": "https://si.imgix.net/00035986/uploads/origins/82749e1b-6778-403a-86bd-44d889039285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c521787ad620513d3e64f726de248fd7", "thumbnail_srcset": "https://si.imgix.net/00035986/uploads/origins/82749e1b-6778-403a-86bd-44d889039285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c521787ad620513d3e64f726de248fd7, https://si.imgix.net/00035986/uploads/origins/82749e1b-6778-403a-86bd-44d889039285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd7fd2c7a5186b708877ebc84c0e8efb 2x, https://si.imgix.net/00035986/uploads/origins/82749e1b-6778-403a-86bd-44d889039285?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=119dd3bc564d3ad67d9f410c3debe5d2 3x", "genre": "art", "nsfw": true, "body": "またお世話になります。\n今回は以前依頼した淫乱魔王系アイドル(https://skeb.jp/@tanonosan/works/153)がショタを囲んで乱交配信をしているイラストをお願いします。\n\n■シチュエーション背景\n表向きでは子供向けのアイドルである彼女による、子供達のためであると同時に己の欲望を満たすために開かれる乱交配信。年端のいかない少年に囲まれて、欲望のまま犯し犯されて乱れる己を晒して子供達を愉しませ、そして己の虜にしている。\nこの乱交は有料配信しておりスパチャによる収入も得ているが、子供達にはゲリラ的に無料でこの乱交配信を子供の端末に送りつけている。そしてそこで興味を惹かれた子供達を己の淫らな宴に招待している。\n\n■シチュエーション\nショタチンポに囲まれながら愉しく激しく乱れています。\n・衣装は淫乱アイドル衣装のものとなります。ちくばん部分は剥がれたり剥がれて無かったりお任せで\n・兎に角囲まれて穴という穴を沢山犯されています。二穴プレイもお手の物。\n・激しいプレイでも彼女自身は嬌声を上げながらも、配信のカメラ目線を気にする程度には余裕がある感じ\n・余裕があれば、配信画面風の差分もお願いします\n\nその他不明な点はおまかせします\n\n以上、宜しければ承諾の程お願いいたします。\n\nhttps://skeb.jp/@tanonosan/works/153", "created_at": "", "completed_at": ""}, {"path": "/@tanonosan/works/187", "thumbnail_src": "https://si.imgix.net/816f5148/uploads/origins/835ebdce-5b94-4a3d-9595-454a2803c2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5247c5b99dd1ff0409c0e1fc24cac4f3", "thumbnail_srcset": "https://si.imgix.net/816f5148/uploads/origins/835ebdce-5b94-4a3d-9595-454a2803c2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5247c5b99dd1ff0409c0e1fc24cac4f3, https://si.imgix.net/816f5148/uploads/origins/835ebdce-5b94-4a3d-9595-454a2803c2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=011d38623d2b25a1515bf12d9bed7734 2x, https://si.imgix.net/816f5148/uploads/origins/835ebdce-5b94-4a3d-9595-454a2803c2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef9456b4c4d3bffb15a324f11e7a8c7c 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nオリジナルキャラクターのデザインをお願いしたくリクエストさせていただきました。\n\n以下、キャラクターイメージになります。\n\n性別：男性\n身長：170センチ弱\n年齢：16歳（高校2年生）\n服装：学生服（やや着崩し気味）\n外見：茶髪、黒縁眼鏡\n設定：大学生の姉がいる。\n仲はいいけど反抗期を引きずっていて、接するときはややツンデレ気味。\n姉のことを人前では「姉貴」、家族の前では「おねえ」と呼ぶ。\n音楽が好き。聞くのも演奏するのも好き。\n学校ではバンドとか組んでる。\n\n以前別の方がたのの様にリクエストされたキャラクターの弟です。\n資料URLに姉であるキャラクターのリクエストのURLを貼っておきます。\n\nディテールやアレンジ、ポーズなどはたのの様にお任せいたします。\n\nhttps://skeb.jp/@tanonosan/works/173", "created_at": "", "completed_at": ""}, {"path": "/@tanonosan/works/186", "thumbnail_src": "https://si.imgix.net/79271e04/uploads/origins/0d63f542-358f-4af1-a13f-c21c4201892b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aad7727d862b5db05e1076ae2ed4a331", "thumbnail_srcset": "https://si.imgix.net/79271e04/uploads/origins/0d63f542-358f-4af1-a13f-c21c42