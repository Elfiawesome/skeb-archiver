com/pomi_ecec", "name": "pomi_ecec"}, {"label": "Website", "url": "https://lit.link/pomino", "name": ""}, {"label": "Pixiv", "url": "https://www.pixiv.net/users/41748704", "name": "41748704"}, {"label": "Fantia", "url": "https://fantia.jp/fanclubs/501342", "name": "501342"}, {"label": "FANZA", "url": "https://www.dmm.co.jp/dc/doujin/-/detail/=/keyword=219804", "name": "219804"}], "flags": {}, "works": [{"path": "/@pomi_ecec/works/72", "thumbnail_src": "https://si.imgix.net/db1ed9a2/uploads/origins/adf63415-7ec8-4662-a19b-ad9b7a06bbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a06b35bee740c12238279e711aec1dbe", "thumbnail_srcset": "https://si.imgix.net/db1ed9a2/uploads/origins/adf63415-7ec8-4662-a19b-ad9b7a06bbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a06b35bee740c12238279e711aec1dbe, https://si.imgix.net/db1ed9a2/uploads/origins/adf63415-7ec8-4662-a19b-ad9b7a06bbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a18746220dd7675fc13b1071f3152137 2x, https://si.imgix.net/db1ed9a2/uploads/origins/adf63415-7ec8-4662-a19b-ad9b7a06bbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f4d9a53de67a6c655d0d511341539ec 3x", "genre": "art", "nsfw": true, "body": "アークナイツの神官を女体化。https://drive.google.com/file/d/1U2xcSyzck8aKE-nJqAAmIdFBpQCffu32/view?usp=drivesdk：(゜Д゜)・゜・。そして、後ろから犯され、クチュクチュと音を立てる。", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/71", "thumbnail_src": "https://si.imgix.net/d09de35e/uploads/origins/771f231d-a18e-459b-9a17-d1290f6a0336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bac48428a6f9384d96c596dea3a54be", "thumbnail_srcset": "https://si.imgix.net/d09de35e/uploads/origins/771f231d-a18e-459b-9a17-d1290f6a0336?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bac48428a6f9384d96c596dea3a54be, https://si.imgix.net/d09de35e/uploads/origins/771f231d-a18e-459b-9a17-d1290f6a0336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=564265a39cc3d1fc3b30118ce9e7ceb1 2x, https://si.imgix.net/d09de35e/uploads/origins/771f231d-a18e-459b-9a17-d1290f6a0336?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b676bd335c5b5e36df158cc8855dd7bb 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n以前に匿名で「セクサロイドのメガネっ娘お姉さん」をリクエストした者です。\n\n過去編としてセクサロイドの体になった陰キャ女子高生が、内面もセクサロイドに変わっていく話をリクエストさせてください。\n今回のリクエストは長編になるため、2～3回に分けて依頼する予定です。\n\n【キャラ設定】\n早川綾香ちゃん（過去のお姉さん）\n「基本設定」\n・脳が再生不可のダメージを受けた影響で自分からセクサロイドになった高校生の女の子。\n・元の年齢は16才くらい\n・陰キャ\n・美術部員\n・女友達は少数いる（全員経験済み）\n・女性器ユニットは未使用（処女）保護シールが貼ってある。\n\n「元人間セクサロイドの設定」（前回と基本同じです）\n・部品換装可能\n・口から飲み込んだ精子はタンクを保存されバッテリー充電に使用される\n・妊娠機能あり（少子化のため妊娠機能は標準装備）\n・体液はおへそから補充します（多分使わない設定）\n\n「性格」\n・普段は大人しいが、得意な話題だけ早口になるタイプ\n・若干マゾ\n・早く処女を卒業したい\n・セクサロイド化により性欲が増した結果ムッツリスケベになる。\n\n「容姿」\n・顔は美人になったがみんなにバレてない\n・セクサロイドの中では珍しいスレンダーでおとなしい体系。\n　（生身の人間基準だとスタイルは良いほう）\n・身長も普通\n・茶髪ロングでボサボサ\n・人間より遠くが見えるが、伊達メガネをつけている\n（ないと落ち着かないらしい）\n・服装はブレザータイプの制服に地味なカーディガン\n・下はタイツかニーハイかおまかせします。\n\n竿役（仮）\n・美術部員の男の子\n・綾香ちゃんとは違うクラス\n・部活動では良く話す\n\n【シチュエーション】\n4～5程度のシチュエーションをお願いします。\n\n1.セクサロイドの体になった事でモテモテの1軍女子になれるかと思っていたが、そんなことなく、いつも通り美術室で絵を書いてる。（省略可）\n\n2.みんな帰ってしまったので、竿役が部室の鍵を渡そうすると、顔がキス寸前まで近づいてしまうとアクシデントで発生。\n綾香ちゃんが美人だと気が付くと勃起してしまう。\n\n3.勃起で膨らんだズボンを見て頭がちんこでいっぱいになってしまった綾香ちゃんは自分のせいで勃起してしまった事を詫びてからフェラチオを開始する。\n\n4.夢中になってちんこをしゃぶっていると竿役が射精し、精子はタンクに格納される。そしてちんこと遺伝子のデータが記録される。\n\n5.フェラチオ後も固いちんこを見て、さらに興奮してしまった綾香ちゃん。スカートをたくし上げてセックスのお願いをする。\n\nボリュームがデカい依頼ですが、ご検討をお願いします。\n\nhttps://skeb.jp/@pomi_ecec/works/65", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/70", "thumbnail_src": "https://si.imgix.net/bdb83c3d/uploads/origins/107bef52-7cf6-451a-9991-6fa9be22ab1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc1967401f2ad515dbf930f53c73cd87", "thumbnail_srcset": "https://si.imgix.net/bdb83c3d/uploads/origins/107bef52-7cf6-451a-9991-6fa9be22ab1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc1967401f2ad515dbf930f53c73cd87, https://si.imgix.net/bdb83c3d/uploads/origins/107bef52-7cf6-451a-9991-6fa9be22ab1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42e7cb1b370a4a4ec967c40ed1f929d7 2x, https://si.imgix.net/bdb83c3d/uploads/origins/107bef52-7cf6-451a-9991-6fa9be22ab1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f28d718130c0ad98f78ce7e79e7ad05 3x", "genre": "art", "nsfw": true, "body": "はじめまして、貴方が描いた、男とホモセする巨根シーメール達が大好きです。\n「爆乳シーメール♂専用アパートのアナニーディルドになった僕」「陰キャシーメール爆乳幽霊さんと暮らす話」「性悪爆乳神父さま♂のショタ淫魔射精教育」といった過去作の中から、シーメール側が作中の男を逆アナルするリバなシチュイラストを依頼してもよろしいでしょうか。可能なら2組以上のキャラでそれぞれ1枚ずつ描いてくれると嬉しいです。\nセックスの姿勢は基本自由ですが2組以上の場合はそれぞれ異なる姿勢で、バックから突く場合は男のチンポを背後から手コキしてほしいです。\nイラストの隅にシーメールの巨根が暴れてる様子を描いた男の腸内断面図を描いたコマが欲しいです。\nどうかご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/69", "thumbnail_src": "https://si.imgix.net/cbcf77b4/uploads/origins/93433cd8-b64c-41fe-83f2-a134d7ed1f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c9096da582084576b2afa9485198580", "thumbnail_srcset": "https://si.imgix.net/cbcf77b4/uploads/origins/93433cd8-b64c-41fe-83f2-a134d7ed1f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c9096da582084576b2afa9485198580, https://si.imgix.net/cbcf77b4/uploads/origins/93433cd8-b64c-41fe-83f2-a134d7ed1f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d967637d07d7490e5f3b77bf5fd5359 2x, https://si.imgix.net/cbcf77b4/uploads/origins/93433cd8-b64c-41fe-83f2-a134d7ed1f5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1970194282999645df597c6ca072b24f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/68", "thumbnail_src": "https://si.imgix.net/abd2d4ea/uploads/origins/cdc32ea9-26ff-4983-83d0-2af3976c50a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe834fad63b6ef2357857b115ba3b9e6", "thumbnail_srcset": "https://si.imgix.net/abd2d4ea/uploads/origins/cdc32ea9-26ff-4983-83d0-2af3976c50a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe834fad63b6ef2357857b115ba3b9e6, https://si.imgix.net/abd2d4ea/uploads/origins/cdc32ea9-26ff-4983-83d0-2af3976c50a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba3af7eeccb838164ead386d19eabeb7 2x, https://si.imgix.net/abd2d4ea/uploads/origins/cdc32ea9-26ff-4983-83d0-2af3976c50a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee752006b5303c3cdcf15bc4fff31ec9 3x", "genre": "art", "nsfw": true, "body": "ストーリーあるサラリーマン（既婚、子持ち）が、家族を救うために自分の体をセックスロボットに捧げなければならなくなった。彼は強制的にシーメールのオモチャにされ、身体はよりフェミニンで若くなる（しかしミルフの魅力はある）。セックスシーンは、主にメイド服（メガネをかけた）を着た彼が、好奇心旺盛な若いご主人様（ショタ）にオーラル、そしてアナルサービスをするものだ。\n\n登場人物の名前や具体的なディテールは、あなたが自由に決めることができる。", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/67", "thumbnail_src": "https://si.imgix.net/0c898331/uploads/origins/ed4a94b1-e5b7-43ef-b1e0-7c1be2c550d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c38e2064479352ac57589a04c0a81d43", "thumbnail_srcset": "https://si.imgix.net/0c898331/uploads/origins/ed4a94b1-e5b7-43ef-b1e0-7c1be2c550d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c38e2064479352ac57589a04c0a81d43, https://si.imgix.net/0c898331/uploads/origins/ed4a94b1-e5b7-43ef-b1e0-7c1be2c550d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fa9102fcc1efac4d55f8ee065f62319 2x, https://si.imgix.net/0c898331/uploads/origins/ed4a94b1-e5b7-43ef-b1e0-7c1be2c550d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f8858252be8dd89cd27f0d0ac6f6782 3x", "genre": "art", "nsfw": true, "body": "七瀬ぽみの様\n前回(https://www.pixiv.net/artworks/123180309)は素晴らしい作品をありがとうございました。また依頼したいことができたので送信させていただきます。\n〜以下依頼内容〜\n・キャラクター\n資料URLリンク先、固定されている投稿のキャラクター③\nキャラクターの名前は「西橋　怜」(にしはし　れい)\n・シチュエーション\n学生証と一緒に全裸・正常位でダブルピースしながらハメ撮り\n以下にほぼ同様のシチュエーションの作品のリンクを示しています。\nhttps://www.pixiv.net/artworks/86112226\nなお、学生証のデザインは以下のリンク先にある作品の学生証に準じて下さい。(同じ依頼者による作品です)\nhttps://skeb.jp/@micaiah_mrmm/works/101\n\n☆その他細かい指定、キャラクターの設定\n　・胸の大きさはDカップくらい。\n　・陰毛は髪と同色でうっすら生やしている感じ。\n　・表情は軽めのアヘ顔。\n　・学生証は身体に被さらない位置に配置してください。\n　・セリフ等はお任せします。無しでも問題ありません。入れる場合は、彼女が風紀委員長である事を意識していただけると大変助かります。\n\n以上になります。ご検討いただければ幸いです。\n\nhttps://www.tumblr.com/skebrequestboard", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/66", "thumbnail_src": "https://si.imgix.net/44a23176/uploads/origins/285e43e6-2514-48b1-b180-f0f0b579f33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87221ba83fdc3fc9932eab87723e183f", "thumbnail_srcset": "https://si.imgix.net/44a23176/uploads/origins/285e43e6-2514-48b1-b180-f0f0b579f33a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87221ba83fdc3fc9932eab87723e183f, https://si.imgix.net/44a23176/uploads/origins/285e43e6-2514-48b1-b180-f0f0b579f33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ac291de7db350920f6f2596fa923cb1 2x, https://si.imgix.net/44a23176/uploads/origins/285e43e6-2514-48b1-b180-f0f0b579f33a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b99b76a2ab0be212ca05734a12c6c1a 3x", "genre": "art", "nsfw": true, "body": "スパロボのカリ・ユガをふたなりエロメスガキロリ達に集団レイプされるのをお願いします。\n「秘密基地に着いてきて」と無邪気に言われ、ホイホイ着いて行ったら集団で組み倒される。\n女神としての威厳を持って強気で注意しようとするも、聞く耳を持たないままデカチンで貫かれる。\n小馬鹿にされながらデカパイを吸われての母乳噴出や手コキとパイズリ強要、強制種付けをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/65", "thumbnail_src": "https://si.imgix.net/6eca53c1/uploads/origins/7f31cd6e-841c-4210-96ab-73ad44055314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586d24687b91a4b10b8260b5751e8507", "thumbnail_srcset": "https://si.imgix.net/6eca53c1/uploads/origins/7f31cd6e-841c-4210-96ab-73ad44055314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586d24687b91a4b10b8260b5751e8507, https://si.imgix.net/6eca53c1/uploads/origins/7f31cd6e-841c-4210-96ab-73ad44055314?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=979060fcbcfefd20d8ba87f8d0c0f7a0 2x, https://si.imgix.net/6eca53c1/uploads/origins/7f31cd6e-841c-4210-96ab-73ad44055314?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=286a04a21dd34b34ca759c447a66ed3c 3x", "genre": "art", "nsfw": true, "body": "初めまして。\nセクサロイド作品を拝見しまして、個人的に好みでしたのでご連絡させていただきました。\n\n長身ムチムチメガネっ娘お姉さん＋顔メカバレ（骸骨描写）＋セクサロイドという欲張りテーマで依頼させてください。\n\n【キャラ設定】\n・自分の意志でセクサロイドになった変態お姉さん\n・長身\n・ムチムチ\n・普段は会社員をやっているが、たまに男性の精子を搾り取って仕事のストレスを発散している。\n・顔や髪のパーツを変えることで変装が可\n・バッテリーもしくは精子で稼働（使わない設定かもしれません）\n・妊娠機能搭載（これも使わない設定かもしれません）\n\n【シチュエーション】\n以下の3パターンでお願いします。\n\n・パターン1（長身ムチムチメガネっ娘）\n眼鏡をかけている会社員のお姉さん\n髪型や髪色はおまかせします。\n\n・パターン2（顔メカバレ）\n顔パーツを取り外しているお姉さん\n取り外したところから骨格が見えるような形でお願いします。\n（某映画のロボットをイメージしていただければ。）\n\n・パターン3（セクサロイド）\n顔パーツと髪パーツを交換し、男性から精子を搾り取るお姉さん\n髪型や髪色はおまかせします。\nメガネは外してください。\n竿役の描写を省略しても構いません。\n\n予算不足の場合も再送依頼お願いします。\n依頼内容の不明点などがありましたら再送要請いただけますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@pomi_ecec/works/64", "thumbnail_src": "https://si.imgix.net/c643356b/uploads/origins/d78b0777-3b48-4836-8fed-43f3b2614fc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=503039434b26e680bb36da7d0f1055f1", "thumbnail_srcset": "https://si.imgix.net/c643356b/uploads/origins/d78b0777-3b48-4836-8fed-43f