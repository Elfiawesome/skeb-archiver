.net/dd01d1d3/uploads/origins/98170929-b15e-4fc1-868e-a3f379c98917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2688f9044602282e974e19af0ad0f1ec 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/8", "thumbnail_src": "https://si.imgix.net/59f9b456/uploads/origins/fe5ad9ed-30df-4b08-bf00-b1c5e5d44c82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d48774386f73150937849271ace55e", "thumbnail_srcset": "https://si.imgix.net/59f9b456/uploads/origins/fe5ad9ed-30df-4b08-bf00-b1c5e5d44c82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d48774386f73150937849271ace55e, https://si.imgix.net/59f9b456/uploads/origins/fe5ad9ed-30df-4b08-bf00-b1c5e5d44c82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ecaa17c964b7826f6f492a6a9ca68d6 2x, https://si.imgix.net/59f9b456/uploads/origins/fe5ad9ed-30df-4b08-bf00-b1c5e5d44c82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c0a54b811bb91e6cb92a1ec207ab498 3x", "genre": "art", "nsfw": false, "body": "現在承認頂いているのとは別に新規のご依頼をさせていただきたく存じます。\n\n■キャラクタ\n・うちの子（https://skeb.jp/@k_ayamo/works/9）とよその子（https://twitter.com/k_ayamo/status/1685156596039446528?s=46&t=xdvHsybs3X7I3v8dopNt5w\n）\n　＊先方からはこの依頼に限り、キャラクタの使用許可を頂いてます\n■シチュエーション\n・戦友対戦の様な合同演習にて、ステージ衣装に身を包み歌って踊って両軍を鼓舞しているシチュエーション。\n　2人は歌って踊れるペアアイドルめいたイメージでお願いします。\n・背景は舞の計略で出てくるようなステージ上という事が分かれば特に指定しません、クリエイター様の描き良い様に簡略化して頂いて結構です。\n・ステージ衣装はうちの子はER静御前、よその子はER紫式部に模した服装にマイクの代わりにインカムを着けた姿を希望します。\n　あと可能であればステージ衣装に合うように二人の髪飾りやヘアスタイルも遊んで頂けると嬉しいです。\n■etc\n・パソコン用の壁紙にしたいのでアスペクト比16:9でお願いします。\n・衣装のデザイン・構図の細部に関しては全てクリエイター様にお任せ致します\n・宛名のサインはレイヤーで分けていただけると嬉しいです。\n\n 以上、ご都合が宜しければ検討頂けると幸いです", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/7", "thumbnail_src": "https://si.imgix.net/6175f2b8/uploads/origins/d5977ecb-6449-4396-9842-87741ceee6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d970ea20c2675abc6961de9af256f9", "thumbnail_srcset": "https://si.imgix.net/6175f2b8/uploads/origins/d5977ecb-6449-4396-9842-87741ceee6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d970ea20c2675abc6961de9af256f9, https://si.imgix.net/6175f2b8/uploads/origins/d5977ecb-6449-4396-9842-87741ceee6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=489331220761ec6070bb5b8e64dae701 2x, https://si.imgix.net/6175f2b8/uploads/origins/d5977ecb-6449-4396-9842-87741ceee6fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e3085f28eaab89c5c115b75e1ed35de 3x", "genre": "art", "nsfw": false, "body": "初めまして、依頼させていただきます\n\n三国志大戦のEXSR樊氏（玉鳳天舞）をお願いします\nポーズや構図はクリエイター様のpixivに上げられてます楢崎龍(https://www.pixiv.net/artworks/99888896)の様な\n私と一緒に行こう？と笑顔で誘ってくれているような表情でお願いします。\n\niPadminiの壁紙にしたいのでアスペクト比3:4（1536×2048以上）でお願いします\n\nhttps://www.youtube.com/watch?v=tAhmIW4NHdo", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/6", "thumbnail_src": "https://si.imgix.net/f723234d/uploads/origins/9cac83ef-4506-4ecd-8c58-94f23bd32cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b757cc838d9e3f6de953e893d4235c1", "thumbnail_srcset": "https://si.imgix.net/f723234d/uploads/origins/9cac83ef-4506-4ecd-8c58-94f23bd32cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b757cc838d9e3f6de953e893d4235c1, https://si.imgix.net/f723234d/uploads/origins/9cac83ef-4506-4ecd-8c58-94f23bd32cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c32673c129481b12286ab1f2ed26ab7a 2x, https://si.imgix.net/f723234d/uploads/origins/9cac83ef-4506-4ecd-8c58-94f23bd32cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=118e6d368f82a54c8db07036b454743e 3x", "genre": "art", "nsfw": false, "body": "初めまして。\nXで英傑大戦の可愛らしいイラストを楽しませてもらっています。\nアイコンに使いたくて依頼させていただきました。\n\n英傑大戦の武市富子のイラストをリクエストします。", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/5", "thumbnail_src": "https://si.imgix.net/a6973cce/uploads/origins/a2849428-939d-4d45-a953-68b7a9a591c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9e26c12314e1f53053fe0e73ca08b0", "thumbnail_srcset": "https://si.imgix.net/a6973cce/uploads/origins/a2849428-939d-4d45-a953-68b7a9a591c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9e26c12314e1f53053fe0e73ca08b0, https://si.imgix.net/a6973cce/uploads/origins/a2849428-939d-4d45-a953-68b7a9a591c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17a43905946166461ca63d92df01a2b5 2x, https://si.imgix.net/a6973cce/uploads/origins/a2849428-939d-4d45-a953-68b7a9a591c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa8a7f785f963a623c229449fb8e96ca 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nXに投稿されているぷちきゃら風の千代女イラスト、毎回楽しく拝見させて頂いてます。\n\n今回配信用のサムネ画像を作成頂きたく、リクエストさせて頂きました。\n\nリクエスト内容は\n①友人とコンビで配信する用のサムネ\n②ソロ配信用のサムネ\n上記2種のサムネ画像を作成頂きたく存じます。\n\n思いつく限りの希望内容は以下1.と2.に記載させて頂いた通りとなります。\n(当方こういった依頼が初めてのため、過度な依頼だった場合は申し訳ございません。)\n\n1.描いて頂きたいキャラ\n①コンビ配信用のサムネ\n　私の最推しキャラ：千代女\n　相方の推しキャラ：琥軍秀吉\n　上記により、それぞれをXに投稿されているぷちきゃら風に描いて頂きたいです。\n\n②ソロ配信用のサムネ\n　千代女と恭雲院を①同様ぷちきゃら風に描いて頂きたいです。\n\n2.タイトルについて\n①コンビ配信用のサムネ\n　配信タイトル：金銀コンビの英傑配信\n\n②ソロ配信用のサムネ\n　配信タイトル：千代女とがんばる英傑配信\n\n上記タイトルで投稿しているため、サムネ内に記載頂けると幸いです。\n\n上記以外に希望が思い浮かばなかったので、構図や文字フォント(？)等の細部はMANAさんの裁量におまかせしたく存じます。(細かすぎる装飾は簡易化して頂いて構いません。琥軍秀吉の装飾とか・・・)\n\n上記の通り初依頼のため、至らぬ点がありましたらお詫び申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/4", "thumbnail_src": "https://si.imgix.net/210ace52/uploads/origins/b473d7d5-4987-4665-92ea-e1ebdd368e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a81f1a26ccba36fb27c9ecbcd09651d", "thumbnail_srcset": "https://si.imgix.net/210ace52/uploads/origins/b473d7d5-4987-4665-92ea-e1ebdd368e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a81f1a26ccba36fb27c9ecbcd09651d, https://si.imgix.net/210ace52/uploads/origins/b473d7d5-4987-4665-92ea-e1ebdd368e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afd85fa1600d30bcece0a43ff1a2ab85 2x, https://si.imgix.net/210ace52/uploads/origins/b473d7d5-4987-4665-92ea-e1ebdd368e80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=827894d45116ab54ccb4399f6e583ce8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私の名前は羽鳥かりん、香港のVtuberです。あなたの作品はとてもプロフェッショナルですね！2024年1月16日にデビュー2周年を迎えるので、自分のイラストをお願いしたいです。\n\nキャラクターの情報身長162cmの22歳の女の子。よく笑い、新しいものに興味津々。でも、時々忘れっぽく、不器用。\n\nアバター：https://drive.google.com/drive/folders/1Htzgt2dYIju04PbK1ibkKODHjjEhbrlD?usp=sharing\n\nポーズ案：カージナルがたくさんいる写真集をめくるキャラクター（ファン画像、google driveのリンクに含まれる）\n\nフォーマット16:9、できれば2550 * 1440、可能であれば、キャラクターと背景を分離し、透明レイヤーを持つキャラクターを持ってください。\n\n可能な用途Youtubeサムネイル、ソーシャルメディアアイコン、バナー、商用利用・印刷物、会員専用壁紙\n\nありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/3", "thumbnail_src": "https://si.imgix.net/d55c2984/uploads/origins/16ab3b05-f87c-475d-9bb8-6fdc38fa508a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31a6145f9bf91afa20440e32fc0613bd", "thumbnail_srcset": "https://si.imgix.net/d55c2984/uploads/origins/16ab3b05-f87c-475d-9bb8-6fdc38fa508a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31a6145f9bf91afa20440e32fc0613bd, https://si.imgix.net/d55c2984/uploads/origins/16ab3b05-f87c-475d-9bb8-6fdc38fa508a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8ba37ef3f07bd1aeebbfbe57ee85187 2x, https://si.imgix.net/d55c2984/uploads/origins/16ab3b05-f87c-475d-9bb8-6fdc38fa508a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5106fcf772e0df7df4033a27be11349 3x", "genre": "art", "nsfw": false, "body": "初めまして英傑のMANAさんがツイッター(X)で描かれる千代女のゆるい感じが好きで依頼させていただきました\nこちら三国風アレンジして描いていただいたうちの子男の子をMANAさんの千代女みたいな頭身表情で描いていただきたいです\nhttps://skeb.jp/@muttumutu/works/1\n複雑なところは簡略化していただいて大丈夫です\n表情ポーズ可愛くお願いします", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/2", "thumbnail_src": "https://si.imgix.net/3521517a/uploads/origins/336d8c4a-4cd8-421a-b1ec-6b568a2d32ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53a98cdf5049aab99f8013d122a6c28d", "thumbnail_srcset": "https://si.imgix.net/3521517a/uploads/origins/336d8c4a-4cd8-421a-b1ec-6b568a2d32ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53a98cdf5049aab99f8013d122a6c28d, https://si.imgix.net/3521517a/uploads/origins/336d8c4a-4cd8-421a-b1ec-6b568a2d32ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7b10372e0ca07b4f1833dd912b74e53 2x, https://si.imgix.net/3521517a/uploads/origins/336d8c4a-4cd8-421a-b1ec-6b568a2d32ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cacc43c2db2e4104baa6eb61cdb1acc2 3x", "genre": "art", "nsfw": false, "body": "Xでのイラストいつも楽しく見てます\nskebを始められたということで依頼させていただきました\n\n三国志大戦から　攻練の旋律狼姑(https://www.pixiv.net/artworks/77302308)のイラストお願いします\n構図としてはpixivにも上げられてました甲斐姫(https://www.pixiv.net/artworks/97519665)みたいな感じで\nﾊﾞｽﾄｱｯﾌﾟ\n満面の笑み\n\nどこまで指定して良いのかわかりませんがご検討をお願いします", "created_at": "", "completed_at": ""}, {"path": "/@MANA12B/works/1", "thumbnail_src": "https://si.imgix.net/37aee227/uploads/origins/9be54816-b490-457c-b6dd-b1b58440b548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d33bcc647dda38730ef3cf84b197dcc", "thumbnail_srcset": "https://si.imgix.net/37aee227/uploads/origins/9be54816-b490-457c-b6dd-b1b58440b548?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d33bcc647dda38730ef3cf84b197dcc, https://si.imgix.net/37aee227/uploads/origins/9be54816-b490-457c-b6dd-b1b58440b548?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=564f5c2911ddcf059d