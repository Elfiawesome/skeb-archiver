576/uploads/origins/36d7d187-fee6-42e1-b983-7ff879b25c83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb5b83b4804eda5831db05c6229553ac, https://si.imgix.net/3a0e9576/uploads/origins/36d7d187-fee6-42e1-b983-7ff879b25c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cad5abfc8bfc55f0c8d1f5764a33be5 2x, https://si.imgix.net/3a0e9576/uploads/origins/36d7d187-fee6-42e1-b983-7ff879b25c83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78b3e9064297c825a75dd81d3ed9fb03 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@amakara000/works/21", "thumbnail_src": "https://si.imgix.net/1a5a1066/uploads/origins/93660e34-4cf5-4954-8756-fa79aebf350f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd8ad4e2b0e709a3bc36c11799a20502", "thumbnail_srcset": "https://si.imgix.net/1a5a1066/uploads/origins/93660e34-4cf5-4954-8756-fa79aebf350f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd8ad4e2b0e709a3bc36c11799a20502, https://si.imgix.net/1a5a1066/uploads/origins/93660e34-4cf5-4954-8756-fa79aebf350f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6dfcf8916956310c4401c65c88e66c06 2x, https://si.imgix.net/1a5a1066/uploads/origins/93660e34-4cf5-4954-8756-fa79aebf350f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eeef6ceb9f65a920dd96f29ba725810e 3x", "genre": "art", "nsfw": true, "body": "畳の上に敷かれた布団の上で、色白肌＆金髪碧眼の可愛らしいショタが、\nぷりんとした桃尻をこちらに向けて、尻たぶを両手で開いて、アナルと子供ちんちんを恥ずかしそうに見せているシチュをお願いしたいです\n\nアナルは、初物の美しいor 使い込まれた縦割れ、どちらでも大丈夫です\n子供ちんちんは玉も竿もツルツルで包茎で、先っちょからカウパーが垂れている感じで", "created_at": "", "completed_at": ""}, {"path": "/@amakara000/works/20", "thumbnail_src": "https://si.imgix.net/8969a8e0/uploads/origins/7036366e-3f7d-4e15-9b68-9f6ff68979b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a035126014c9d20d5c2f1e5abc50b2b", "thumbnail_srcset": "https://si.imgix.net/8969a8e0/uploads/origins/7036366e-3f7d-4e15-9b68-9f6ff68979b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a035126014c9d20d5c2f1e5abc50b2b, https://si.imgix.net/8969a8e0/uploads/origins/7036366e-3f7d-4e15-9b68-9f6ff68979b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bc95c4d3a7c45da41c1b043ef1315df 2x, https://si.imgix.net/8969a8e0/uploads/origins/7036366e-3f7d-4e15-9b68-9f6ff68979b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2756080d5c2151d65cf0ea1c505a2f9c 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n褐色肌のケモミミショタが、吸血鬼といった感じの色白ショタに襲われているイラストをお願いできないでしょうか。\n\n背面座位のような体勢で、後ろから抱きつき噛みつかれた状態で、その上弄ばれています。\n血を吸われながら、体中を愛撫されたり、下も扱かれて搾り取られたりしています。\n褐色ショタは脱力感と気持ち良さで、恍惚・朦朧としてしまっている様子です。\n体から力が抜けていて、色白ショタにぐったりと預けてしまっています。\n色白ショタも愛おし気な顔で、興奮、夢中といった感じです。\n\n二人とも裸で、熱気のある感じでお願いします。\n\n渋滞するくらいに好みを詰め込んでしまい、お恥ずかしいというか、すみません。\nもしよかったら、ぜひよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@amakara000/works/19", "thumbnail_src": "https://si.imgix.net/2f031ce4/uploads/origins/2a43f91e-349f-4767-ba77-4adc146fdf40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53935861efd395abcbd3e53aa1ca6060", "thumbnail_srcset": "https://si.imgix.net/2f031ce4/uploads/origins/2a43f91e-349f-4767-ba77-4adc146fdf40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53935861efd395abcbd3e53aa1ca6060, https://si.imgix.net/2f031ce4/uploads/origins/2a43f91e-349f-4767-ba77-4adc146fdf40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c7683a405f0ddc579f587cc45610adc 2x, https://si.imgix.net/2f031ce4/uploads/o