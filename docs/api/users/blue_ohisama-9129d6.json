トが受けられない場合はキャンセルして頂いて差し支えありません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1gU7c-OFPnrg-tM6W_O_mLExGdC3z8glc?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@blue_ohisama/works/4", "thumbnail_src": "https://si.imgix.net/20841a4c/uploads/origins/68e02b6a-b41a-420d-96f0-ca1976cae5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9286b28052e32209328fd140bde75349", "thumbnail_srcset": "https://si.imgix.net/20841a4c/uploads/origins/68e02b6a-b41a-420d-96f0-ca1976cae5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9286b28052e32209328fd140bde75349, https://si.imgix.net/20841a4c/uploads/origins/68e02b6a-b41a-420d-96f0-ca1976cae5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=334befda73bfee19d1e96be6933b1c25 2x, https://si.imgix.net/20841a4c/uploads/origins/68e02b6a-b41a-420d-96f0-ca1976cae5e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a7c56462ff613fb01b5a604b6b83db5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@blue_ohisama/works/3", "thumbnail_src": "https://si.imgix.net/5dc5b531/uploads/origins/b6fb1c71-3f2b-45ee-a6ad-d1c47634e09a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a36d93f46a36827f0f4b3e2120921f9", "thumbnail_srcset": "https://si.imgix.net/5dc5b531/uploads/origins/b6fb1c71-3f2b-45ee-a6ad-d1c47634e09a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a36d93f46a36827f0f4b3e2120921f9, https://si.imgix.net/5dc5b531/uploads/origins/b6fb1c71-3f2b