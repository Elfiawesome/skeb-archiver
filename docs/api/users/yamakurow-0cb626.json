e7a6f 2x, https://si.imgix.net/eed5c04f/uploads/origins/2b15304a-b8d0-45c5-91f7-a549d0f40f57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=50833c98a548c345bc038c38622695c3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/13", "thumbnail_src": "https://si.imgix.net/f2f90607/uploads/origins/9f5ecc2d-efbc-43f6-ab7e-41fef7f7bd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f23bb06674ecee5aa191483fbdd6be6", "thumbnail_srcset": "https://si.imgix.net/f2f90607/uploads/origins/9f5ecc2d-efbc-43f6-ab7e-41fef7f7bd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f23bb06674ecee5aa191483fbdd6be6, https://si.imgix.net/f2f90607/uploads/origins/9f5ecc2d-efbc-43f6-ab7e-41fef7f7bd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d610efd074a91de0c1559cb38a8bb9a 2x, https://si.imgix.net/f2f90607/uploads/origins/9f5ecc2d-efbc-43f6-ab7e-41fef7f7bd1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e266da28d3da9ad2346022fc84e837f3 3x", "genre": "art", "nsfw": false, "body": "ヤマクロー先生はじめまして！\n\nにじっこどうぶつをいつも楽しく拝見しています。\n推しであるオオハシ力ちゃんを始め、はかちぇペンギンやシスターアザラシ等、先生のキャラクターデザインが大好きです。\n先生にぜひ、私のソーシャルゲームのキャラクターをどうぶつモチーフにしていただきたく依頼します。\n\nーー下記、設定などーー\n■容姿\n　緑目・金髪ロングの20代前半\n　軍服モチーフのワンピース着用\n\n■設定\n・舞台は中世ファンタジー世界\n・好奇心旺盛だが、落ち着いた雰囲気のため知的&年上に見られることが多い\n・真顔でボケるタイプ\n・本が好きで、街の図書館の司書をしている\n・お洒落好きでクラシカルな服を好む\n\n■要望\n先生のイメージのまま自由に作っていただけると幸いです。\n（強いて挙げるのであれば、ノルウェージャンフォレストキャットのような長毛種の猫や、垂れ耳うさぎが好きなので、そんな感じの生き物だと嬉しいです）\n\n■資料\nhttps://drive.google.com/drive/folders/1XnpQSFJMMCvJESaU6hieMdtAtLqGsfuf", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/12", "thumbnail_src": "https://si.imgix.net/687863c4/uploads/origins/61113e77-571a-4df9-9462-6d3ac3a0d733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3fd0b686ced83b8ffc760d42b38af4c", "thumbnail_srcset": "https://si.imgix.net/687863c4/uploads/origins/61113e77-571a-4df9-9462-6d3ac3a0d733?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3fd0b686ced83b8ffc760d42b38af4c, https://si.imgix.net/687863c4/uploads/origins/61113e77-571a-4df9-9462-6d3ac3a0d733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86919d5ea70ce69fa75a0a2535750147 2x, https://si.imgix.net/687863c4/uploads/origins/61113e77-571a-4df9-9462-6d3ac3a0d733?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6211737e91b5ca0ce1815e2b2ba3c310 3x", "genre": "art", "nsfw": false, "body": "にじっこどうぶつでの配信の再現が面白くて楽しみにしています。\n今回、にじっこどうぶつではないのですが、舞元力一配信内での一口嘘ニュースというコーナーで紹介された\n「黒井しば、ローリング丸太で脱落」\nというネタを再現してもらいたいです。\n\n実際にやっているわけではないのですが、以前から好きなネタだったので、是非お願いしたいです。\n\nhttps://www.youtube.com/live/lzrFjDaPiJM?feature=share&t=7388", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/11", "thumbnail_src": "https://si.imgix.net/19f3393f/uploads/origins/88158bf6-dd4c-418d-82c0-bfa37c0d618c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=275bd91c99f18012d586772c2e16a5fb", "thumbnail_srcset": "https://si.imgix.net/19f3393f/uploads/origins/88158bf6-dd4c-418d-82c0-bfa37c0d618c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=275bd91c99f18012d586772c2e16a5fb, https://si.imgix.net/19f3393f/uploads/origins/88158bf6-dd4c-418d-82c0-bfa37c0d618c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f547a574b66e0ccce359ef1917a7b2cd 2x, https://si.imgix.net/19f3393f/uploads/origins/88158bf6-dd4c-418d-82c0-bfa37c0d618c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51b4291fe19d1852e333f370919c7026 3x", "genre": "art", "nsfw": false, "body": "いつもにじっこどうぶつ楽しみに見させていただいております！\nそれで今回お願いなのですが\nまだにじっこどうぶつで動物化していない、にじさんじの「来栖夏芽」さんの動物化イラストをお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/10", "thumbnail_src": "https://si.imgix.net/b6812c08/uploads/origins/fedfb474-624a-4d0c-a68d-d2cf32a982d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae70f878ed5cceba2e05edf266888420", "thumbnail_srcset": "https://si.imgix.net/b6812c08/uploads/origins/fedfb474-624a-4d0c-a68d-d2cf32a982d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae70f878ed5cceba2e05edf266888420, https://si.imgix.net/b6812c08/uploads/origins/fedfb474-624a-4d0c-a68d-d2cf32a982d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1612b32a26520012141c4f5d1e8951d9 2x, https://si.imgix.net/b6812c08/uploads/origins/fedfb474-624a-4d0c-a68d-d2cf32a982d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3333a30c6c973278b849a2573ff3d1c0 3x", "genre": "art", "nsfw": false, "body": "にじっこどうぶつをいつも楽しみに見てます！skebがあると聞き、ヤマクローさんに依頼させていただきました！\nリクエストは「雪山人狼の葛葉とまゆゆの二匹に似たにじっこどうぶつ」を描いていただきたいです。推しがにじっこどうぶつになるのを待ち、まゆゆに似たカメレオンのデザインに惚れました！その中でも自分が推しやにじさんじにハマるきっかけである雪山人狼の回を選びました！\nヤマクローさんのペースで大丈夫です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/9", "thumbnail_src": "https://si.imgix.net/d5f40561/uploads/origins/91f1f6c4-be65-4def-803b-bc94a59b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3076995ae7465d2d1b21b9685f8fcd", "thumbnail_srcset": "https://si.imgix.net/d5f40561/uploads/origins/91f1f6c4-be65-4def-803b-bc94a59b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e3076995ae7465d2d1b21b9685f8fcd, https://si.imgix.net/d5f40561/uploads/origins/91f1f6c4-be65-4def-803b-bc94a59b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ad2047e02d89d9d8121679bbf9ba7f5 2x, https://si.imgix.net/d5f40561/uploads/origins/91f1f6c4-be65-4def-803b-bc94a59b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1e42e3376c2ef58ef55f1b7b0d31be7 3x", "genre": "art", "nsfw": false, "body": "いつもかわいいイラストを楽しみにしています。\n前回に引き続きまだにじっこどうぶつ化されていない方で申し訳ないのですが、エデン組のGang Beastをモチーフににじっこどうぶつを描いていただきたいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/8", "thumbnail_src": "https://si.imgix.net/116a9908/uploads/origins/8b588d50-4543-4d95-8eed-280f23a22155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=427d758e546d7cdaaa70dc74efe4ddbb", "thumbnail_srcset": "https://si.imgix.net/116a9908/uploads/origins/8b588d50-4543-4d95-8eed-280f23a22155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=427d758e546d7cdaaa70dc74efe4ddbb, https://si.imgix.net/116a9908/uploads/origins/8b588d50-4543-4d95-8eed-280f23a22155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e106d885658629df2576f8bc48a6aa6 2x, https://si.imgix.net/116a9908/uploads/origins/8b588d50-4543-4d95-8eed-280f23a22155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=988c872830d1560a5bb825076fceb601 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/7", "thumbnail_src": "https://si.imgix.net/9c7267fd/uploads/origins/38277f49-1357-47dd-ae9b-7433dd4ed67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4470a4f60316614cc49097c63e7a4f30", "thumbnail_srcset": "https://si.imgix.net/9c7267fd/uploads/origins/38277f49-1357-47dd-ae9b-7433dd4ed67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4470a4f60316614cc49097c63e7a4f30, https://si.imgix.net/9c7267fd/uploads/origins/38277f49-1357-47dd-ae9b-7433dd4ed67c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2486d7bb3dc0dbacd0ccd140a57969a8 2x, https://si.imgix.net/9c7267fd/uploads/origins/38277f49-1357-47dd-ae9b-7433dd4ed67c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b57c502ca902ab8ef7b9c42325f77fa 3x", "genre": "art", "nsfw": false, "body": "ヤマクローさま初めまして！\nいつも素敵なイラスト拝見させていただいております。\nSkebをやっていらっしゃることを知り、\nぜひお願いしたい！と思いましたため、ご連絡させていただきました。\n\n「Chèrie.」というVユニットで活動しているのですが、そちらの動物化を描いていただきたいです。\n（背景有り無しはどちらでも大丈夫です。）\n（可能であれば活動内でサムネや待機画面等で使用させていただけますとなお嬉しく思います。難しければ大丈夫です！）\n\n◇キャラデザ\n★うりん\nカラー：勿忘草色 #89c3ed\nモチーフ : 星と海\n香り：バニラ\nミルクティ色のゆるふカラーわショートボブ\n勿忘草色より少し深いブルーのとろんとしたたれめ\nたれ眉\n左目の下に泣きボクロ\n\n☀️ぜろ\nカラー：蜜柑色 #f08300\nモチーフ : 太陽とひまわり\n香り:シトラス\nぱっつん前髪\n腰までのさらさらストレート黒髪\nオレンジ強めのサーモンピンクのつり目\nちょっとたれ気味の平行眉\n\n◇参考\nhttps://twitter.com/Cherie_0x0/status/1360617208582344710\n\nうりんはふわふわの白猫、ぜろはすらっとした黒猫のイメージです。\nそれ以外の要素はぜひヤマクローさまにお任せできたら嬉しいです。\n\nSkeb経由で依頼させていただくことが初めてのため、\n失礼がございましたら申し訳ございません💦\nもしよろしければご検討のほどお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/6", "thumbnail_src": "https://si.imgix.net/eb1fe081/uploads/origins/1592e0a3-d27d-4850-94e0-03a5797b3b55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c498eb603335ed6473d4d2a83f4e03c2", "thumbnail_srcset": "https://si.imgix.net/eb1fe081/uploads/origins/1592e0a3-d27d-4850-94e0-03a5797b3b55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c498eb603335ed6473d4d2a83f4e03c2, https://si.imgix.net/eb1fe081/uploads/origins/1592e0a3-d27d-4850-94e0-03a5797b3b55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dbf618388cc0cf189dbe9ae9589bce42 2x, https://si.imgix.net/eb1fe081/uploads/origins/1592e0a3-d27d-4850-94e0-03a5797b3b55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fcb9e0823013f07d0b7273251c757d9 3x", "genre": "art", "nsfw": false, "body": "初めまして、いつもTwitter素敵なイラスト拝見しております！\n初期衣装の人間のぷてち（帽子なしでよろしくお願いします）がにじっこどうぶつのほんひまを抱き抱えてらイラストをお願いしたいです！\nそのほかの条件は先生に一任したいと思っています。よろしくお願いします。\n\n完成した作品はTwitterやDiscordのアイコンで使わせていただきたいなと考えていま", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/5", "thumbnail_src": "https://si.imgix.net/5b579a2d/uploads/origins/33b6e2a6-9749-41d5-bc42-91349fc9785b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f286fb07ea5d810143d095a702a0b51", "thumbnail_srcset": "https://si.imgix.net/5b579a2d/uploads/origins/33b6e2a6-9749-41d5-bc42-91349fc9785b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f286fb07ea5d810143d095a702a0b51, https://si.imgix.net/5b579a2d/uploads/origins/33b6e2a6-9749-41d5-bc42-91349fc9785b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e94d0d68f076a911f2e0108e0654a8c8 2x, https://si.imgix.net/5b579a2d/uploads/origins/33b6e2a6-9749-41d5-bc42-91349fc9785b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55715e4f17a3e70d0aa65d261ecf9856 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/4", "thumbnail_src": "https://si.imgix.net/8a9801b3/requests/275568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8a6a6c215c924793dab20199b48b5b", "thumbnail_srcset": "https://si.imgix.net/8a9801b3/requests/275568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d8a6a6c215c924793dab20199b48b5b, https://si.imgix.net/8a9801b3/requests/275568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fce9394506125b4a0da85613a5d796e 2x, https://si.imgix.net/8a9801b3/requests/275568_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0269e9b791f056e46c73877a92cf581 3x", "genre": "art", "nsfw": false, "body": "ヤマクローさんこんばんはです。\nにじっこどうぶつじゃないですが依頼いいでしょうか？\nにじさんじの夕陽リリさんを描いていただきたいです。\n衣装は通常服の制服で、リリさんの部屋に飾られているシロクマとサメのぬいぐるみ(3Dお披露目にいたやつ)と一緒にいるところを描いてほしいです。\n表情とかポーズ、配置や場所の指定はとくにないですが、もし背景が無地単体なら水色系でおねがいします(リリさんのイメージカラーが水色なので)。\nリクエスト自体はじめてなので至らない点あるかと思いますが、都合よろしければよろしくおねがいします。", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/3", "thumbnail_src": "https://si.imgix.net/69363bbc/requests/268327_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b066b76df67635bcb2936b1e183fd3c2", "thumbnail_srcset": "https://si.imgix.net/69363bbc/requests/268327_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b066b76df67635bcb2936b1e183fd3c2, https://si.imgix.net/69363bbc/requests/268327_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5023b516e4f5ef30045c0851aacf8b27 2x, https://si.imgix.net/69363bbc/requests/268327_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3dd0469b39c3fde8f4946832df5fb5b 3x", "genre": "art", "nsfw": false, "body": "いつも可愛らしいイラストに癒されてます！なにかに似ているいきものが凄く好きなので、🔫🎲の似たいきものをお願いしたいです。よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@yamakurow/works/2", "thumbnail_src": "https://si.imgix.net/7cf321b1/requests/248002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba604e456a367030920f6400751fccb", "thumbnail_srcset": "https://si.imgix.net/7cf321b1/requests/248002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba604e456a367030920f6400751fccb, https://si.imgix.net/7cf321b1/requests/248002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d680cf20cad5aa5cb1f47c231815