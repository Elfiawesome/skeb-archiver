1db-cd4991155b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad32977a69d5c69c82a60dbd1202d08f", "thumbnail_srcset": "https://si.imgix.net/d2ad5f3c/uploads/origins/fb63b804-60b5-4156-91db-cd4991155b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad32977a69d5c69c82a60dbd1202d08f, https://si.imgix.net/d2ad5f3c/uploads/origins/fb63b804-60b5-4156-91db-cd4991155b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2832e64564ad6a7c05d83c9cb4023ff5 2x, https://si.imgix.net/d2ad5f3c/uploads/origins/fb63b804-60b5-4156-91db-cd4991155b9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5190db4f3bbbeaf3957b007af2aa3979 3x", "genre": "art", "nsfw": false, "body": "矢森のをさんこんにちは！あなたの可愛いくてかっこいいですし美しいイラストが大好きです。\n私のオリジナルキャラクターを描いてほしいです。\n\n彼女は吸血鬼で、吸血鬼女子校に通っている。\n\n特徴：太い眉、タレ目、尖った耳、尖った歯、長すぎるぱっつん前髪。\n\nhttps://weibo.com/6466138134/4948208171352551\nこのレインコートのデザインを描いてほしいのですが。\nレインコートの参考は4枚目の画像（一番右の身なり） 、これは狩猟用の服です、長靴をはいています。\n彼女狩りをした後、斧を抱えて自撮りしている姿を描いてほしいです。かわいい表情をしています。血表現があるとありがたいです。\n\nこの中他の衣装の構図アイデアがあるなら、別の衣装を選んで絵を描くことも可能です。\nそれとも、彼女に新しい服をデザインすることもできます。\n\n制服デザインの参考は主に1枚目の画像を参照。左胸は心臓の形をしたアイボリーのペンダントで。異なる学年の生徒と交換し、姉妹（シュヴェスター）になるために使。\n3番目の画像は看護婦のデザインです、看護婦にちなんだ道具or輸血パックを描いていただけるとありがたいです！\n\n5枚目はパジャマのデザインです、オタク関連のアイテムを描いていただけるとありがたいです\n\n構図に応じて、キャラクターのデザインの一部を変更しも歓迎です。\n\n先生のかっこいい線が好きなので、できれば白黒の落書きをサブファイルにしたいな、ここ1枚目の画像のような感じです\nhttps://skeb.jp/@yamori_no_o/works/2\n金額が足りなければ増額します。\n\n具体的な構図は先生が決めてほしい、読んでくれてありがとうございます\n\nhttps://weibo.com/6466138134/4948208171352551https://weibo.com/6466138134/4964863692767624", "created_at": "", "completed_at": ""}, {"path": "/@yamori_no_o/works/19", "thumbnail_src": "https://si.imgix.net/535aa918/uploads/origins/cbf066d3-5e7a-451d-9ed0-b89211351d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c065030732c43aef99e43ae5dd550b1", "thumbnail_srcset": "https://si.imgix.net/535aa918/uploads/origins/cbf066d3-5e7a-451d-9ed0-b89211351d54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c065030732c43aef99e43ae5dd550b1, https://si.imgix.net/535aa918/uploads/origins/cbf066d3-5e7a-451d-9ed0-b89211351d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c29c64066a55d19464439c95e4dbaff 2x, https://si.imgix.net/535aa918/uploads/origins/cbf066d3-5e7a-451d-9ed0-b89211351d54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=362610fe7ea682ba8cc934019ef87c07 3x", "genre": "art", "nsfw": false, "body": "矢森のを先生はじめまして！素敵なイラストに惹かれて依頼をさせていただきました。先生のアークナイツファンアートが大好きです！\nこの度は私のオリジナルキャラクターを描いていただきたくリクエストをお送りさせていただきました。\n\n構図やポーズ等はお任せ致します。ちょっとのキャラ紹介はリンクに書いておきました。\n服もご自由にアレンジしても大丈夫です!\n\nご検討よろしくお願いいたします。\n\nhttps://sta.sh/2142qav0h384", "created_at": "", "completed_at": ""}, {"path": "/@yamori_no_o/works/18", "thumbnail_src": "https://si.imgix.net/c8f8e582/uploads/origins/45dffffa-619a-40d9-a2af-f5e47a24061a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b30f185a392cf9ada174d583d9153dc", "thumbnail_srcset": "https://si.imgix.net/c8f8e582/uploads/origins/45dffffa-619a-40d9-a2af-f5e47a24061a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b30f185a392cf9ada174d583d9153dc, https://si.imgix.net/c8f8e582/uploads/origins/45dffffa-619a-40d9-a2af-f5e47a24061a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6060d2d09e8615090aae37d3abfdbba3 2x, https://si.imgix.net/c8f8e582/uploads/origins/45dffffa-619a-40d9-a2af-f5e47a24061a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afe7d04cad4aada8beffac2e5eaf2854 3x", "genre": "art", "nsfw": false, "body": "yamoriさん、こんにちは。\n私のOCであるメイプル【https://drive.google.com/file/d/1wX2H3qChhLr5jpyKtQlGm_LnZ4UFVCQU/view?usp=drivesdk】を描いて頂きたいのですが、右目が義眼なので、瞳孔がスコープや十字架のようになっているのはご了承ください。ポーズは好きなように、コスチュームはもっと好きなように変更可能です。\n\nhttps://drive.google.com/file/d/1wX2H3qChhLr5jpyKtQlGm_LnZ4UFVCQU/view?