59-acd7-7c49c6a23074?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85a8a0cec2284bf6add906b05fef641, https://si.imgix.net/ef647c59/uploads/origins/37c10401-f0f3-4159-acd7-7c49c6a23074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a1328c5ba91cdf2cb3b321c23fa4e27 2x, https://si.imgix.net/ef647c59/uploads/origins/37c10401-f0f3-4159-acd7-7c49c6a23074?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71c16a3e8a768661bd40154c3dbdfbc0 3x", "genre": "art", "nsfw": true, "body": "下着姿で長縄跳びをしている女の子と男の子(姉弟)のイラストをお願いしたいと思います。\n女の子は眼鏡をかけていて白いブラとパンツとソックスとシューズの格好で\nシューズには「6-4」とクラス番号が書いてあります。\n男の子も眼鏡をかけていてゴム部分にラインの入った白のブリーフとソックスとシューズの格好でシューズには「4-2」と書いてあります。\n(ブリーフはこのようなものを考えています　https://fashion.aucfan.com/yahoo/l1052578813/ )\n2人とも汗をかきながらジャンプしていて女の子は笑顔で「もう少しで校内新記録だよ！ゆうとくんがんばろ♡」と声をかけていて\n男の子は疲れた顔で「まだ跳ぶの〜？暑いよ姉ちゃん」と言っている様子を考えています。", "created_at": "", "completed_at": ""}, {"path": "/@penpeneroe/works/72", "thumbnail_src": "https://si.imgix.net/6340bf11/uploads/origins/ea39b085-3e3c-471d-9d73-9bf78d3a5da5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72063f719d062e863335aa2b558d84d", "thumbnail_srcset": "https://si.imgix.net/6340bf11/uploads/origins/ea39b085-3e3c-471d-9d73-9bf78d3a5da5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72063f719d062e863335aa2b558d84d, https://si.imgix.net/6340bf11/uploads/origins/ea39b085-3e3c-471d-9d73-9bf78d3a5da5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19be6866f12aaf2e766b68574b585d97 2x, https://si.imgix.net/6340bf11/uploads/origins/ea39b085-3e3c-471d-9d73-9bf78d3a5da5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f6a423b8b1cdcff4bd099d65b7e2584 3x", "genre": "comic", "nsfw": true, "body": "またリクエストさせて頂きます\n\nキャラ：十時愛梨\n衣装：ビーチガール\nhttps://imas.gamedbs.jp/cg/idol/detail/170?h=342e254d0cc96070e10c97f6cb744832\n\nhttps://x.com/penpeneroe/status/1793186284631986538の続きです\n\n既に催眠人形状態の愛梨を催眠で深く眠らせてエッチします。\n\n愛梨は既に催眠状態で無表情\n男は愛梨のおっぱいを揉みつつキスしている\n男「美しいよ愛梨、でも眠っている方がもっと美しいよ」\n愛梨「・・・・」\n男と愛梨は目を合わせる\n男「さあ\"深く眠り、永遠の眠り姫となれ\"」\n愛梨「・・・は・・・・ぃ・・・・」\n目が徐々に閉じていき身体から力が抜ける\n\n目を閉じて、深く眠った愛梨\n男は愛梨の水着をずらしおっぱいに吸い付く\n愛梨からは母乳が出ている\n男「愛梨、これで君は永遠の美しい俺だけの眠り姫だ」\n愛梨「・・・・・・」\n\n愛梨は深く眠ったままエッチ中でも反応がない、安らかな寝顔です。\n男は愛梨におっぱいを揉みつつ遠慮なく中出しエッチします。\n男「何も知らない寝顔のまま俺に激しく犯される・・最高の眠り姫だ愛梨！」\n愛梨「・・・・・・・」\n男「もう自分の意志では目を覚まさない完璧な眠り姫、永遠に俺のものだ！」\n愛梨「・・・・・・・」\n\nエッチ後、眠り姫愛梨おっぱいにしゃぶりつく\n愛梨は寝顔のまましゃぶりつかれたことで母乳が噴き出す\n\n細かいセリフ等はおまかせします\nご検討お願いします。", "created_at": "", "completed_at": ""}]}