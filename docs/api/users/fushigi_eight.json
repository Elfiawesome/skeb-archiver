a6a-95b0-40161d3ee7de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cecfba9e5adadfb6935209092cb9fec", "thumbnail_srcset": "https://si.imgix.net/8b0ffe9e/uploads/origins/82fb6b28-3e65-4a6a-95b0-40161d3ee7de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cecfba9e5adadfb6935209092cb9fec, https://si.imgix.net/8b0ffe9e/uploads/origins/82fb6b28-3e65-4a6a-95b0-40161d3ee7de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef99a2e415ef93174090f1f63900e5f0 2x, https://si.imgix.net/8b0ffe9e/uploads/origins/82fb6b28-3e65-4a6a-95b0-40161d3ee7de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=910f5641b13311b091c95e919f99ff5a 3x", "genre": "art", "nsfw": true, "body": "はじめまして、いつも先生の素敵な作品を拝見しております！先生の描かれるかわいくてえっちなライバーのイラストがとても好きなのでリクエストをお願いしたいです！\n\nにじさんじより、天宮こころさんのNSFWイラストをお願いします。新デフォルト衣装で、こちら( https://x.com/fushigi_eight/status/1802375011078148389 )のイラストのように片手で胸を見せ、もう片手でスカートをつまんでパンツを見せてこちらを煽っているところを描いていただきたいです。また、先生のこのイラスト( https://x.com/fushigi_eight/status/1914803781457600955 )のボールで胸が少し潰れるところが本当に好きなので、可能であれば指先で胸が押されてふにゅんと変形している描写を入れていただきたいです。構図等の問題で全ての要素を入れるのが難しければ、先生の描きやすいように諸々変更していただけると幸いです。こちらを煽るえっちなあみゃをどうかよろしくお願いします……！", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/43", "thumbnail_src": "https://si.imgix.net/14415e01/uploads/origins/4668f726-8634-43cd-ac6e-16d0fac78abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8677c449bba9067f5e80591dc4c3dedf", "thumbnail_srcset": "https://si.imgix.net/14415e01/uploads/origins/4668f726-8634-43cd-ac6e-16d0fac78abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8677c449bba9067f5e80591dc4c3dedf, https://si.imgix.net/14415e01/uploads/origins/4668f726-8634-43cd-ac6e-16d0fac78abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=249e50551c615055b405ee711f78cce6 2x, https://si.imgix.net/14415e01/uploads/origins/4668f726-8634-43cd-ac6e-16d0fac78abb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22fd5a0b6bcac49bdf8e882c4c51f2bf 3x", "genre": "art", "nsfw": true, "body": "「リバース：1999」のマチルダ・ブアニッシュが、ベッドの上で陰部を指で開いて見せつけている絵をお願いいたします\n\n参考資料類\nhttps://drive.google.com/drive/folders/1JggESuOQl6NV6yGXKPN-s607s-G1EiZc?usp=sharing\nhttps://skeb.jp/@pilayamato/works/171\n\n要望類（差し支えの無い物だけで大丈夫です）\n・構図に関しては先日依頼いたしましたエメラルダくぱぁ絵と同じ感じで、片胸を露出した半裸かつスカートをたくし上げて陰部がよく見えるような状態で、愛液で濡れそぼった陰部を指で開いて見せつける。といった感じでお願いいたします。\n\n・胸部に関しては先日依頼いたしましたエメラルダくぱぁ絵と同様に若干盛っていただきたいです。\n\n・よろしければ透明な竿を挿入した差分や中出し差分、事後差分がありますと幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/42", "thumbnail_src": "https://si.imgix.net/385ffb2b/uploads/origins/a05aadee-fd9d-4b05-bfcc-91868757dc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e59ad982b3fa25782f3638eddcc40d7", "thumbnail_srcset": "https://si.imgix.net/385ffb2b/uploads/origins/a05aadee-fd9d-4b05-bfcc-91868757dc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e59ad982b3fa25782f3638eddcc40d7, https://si.imgix.net/385ffb2b/uploads/origins/a05aadee-fd9d-4b05-bfcc-91868757dc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f60dbfefea3464320dba99f8b390605 2x, https://si.imgix.net/385ffb2b/uploads/origins/a05aadee-fd9d-4b05-bfcc-91868757dc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7451d3eea59bc4fcd77d8288c1867a2f 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\nいつも楽しく拝見させていただいています。\n以下依頼内容です。\n\nキャラクター:椎名唯華\n衣装:添付のチアリーダー衣装でお願いします。\nシチュエーション:野球の試合で活躍した部員に、ご褒美でエッチなお誘いをする椎名監督をお願いします。\n上半身は服がめくれ上がりおっぱい丸見え、スカートはたくし上げて股間が丸見え、パンツは太ももあたりまで下げられてる感じにして下さい。\nまた、余裕がありましたらおっぱいにザーメンをぶっかけられているシーンも入れていただきたいです。\n台詞に関してはお任せしますが、「今日頑張ってたから監督でエッチなことしてもええで〜♥」的な感じにして下さい。\n\n以上、注文が多く申し訳ありませんが、ご検討よろしくお願いします。\n\n※チアリーダー衣装\nhttps://x.com/youcapriccio/status/1691403231489122305?t=kFgicRDsNASC54XQnHZ_lA&s=19", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/41", "thumbnail_src": "https://si.imgix.net/262c0eda/uploads/origins/cf96a46c-1d72-4531-a4b9-295f0d77c0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0531a2b33b5b7abcb35e8d50bba5a559", "thumbnail_srcset": "https://si.imgix.net/262c0eda/uploads/origins/cf96a46c-1d72-4531-a4b9-295f0d77c0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0531a2b33b5b7abcb35e8d50bba5a559, https://si.imgix.net/262c0eda/uploads/origins/cf96a46c-1d72-4531-a4b9-295f0d77c0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61b066c90511e6b05b996ced249a392c 2x, https://si.imgix.net/262c0eda/uploads/origins/cf96a46c-1d72-4531-a4b9-295f0d77c0fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=def3d2a018671570349e511ada0575cf 3x", "genre": "art", "nsfw": true, "body": "初めて依頼させていただきます\nにじさんじのフレン･E･ルスタリオがマッサージ店で女性スタッフに性感マッサージで責められちゃう作品をお願いしたいです\n(イメージ的には先日Xに投稿されていた椎名唯華マッサージに近い感じです)\n\n構図はベッドに横たわるフレンを正面やや上から映していて、ベッド両脇から女性スタッフがおっぱいやおまんこを揉み揉みくりくりくちゅくちゅしてる感じでお願いします(女性スタッフは腕だけの描写で構いません)\n服装は目隠し用タオルと際どい施術着だけで施術着はマッサージしやすいようにずらして下さい\nまたもし可能であればマッサージ中や絶頂時、事後等の差分をお願いしたいです(目隠しは事後のみ取られてアヘり気味の表情が見える形でお願いします)\n台詞に関しては上述した椎名唯華マッサージみたいな感じのおまかせで、可能であれば事後に『スタッフに次の予約を入れるか聞かれて力無く答えるフレン』な台詞をお願いしたいです\nまたフレンと言えばとにかくあのおっぱいですのでおっぱいはお好きなだけ盛り盛りでお願いします\n\nよろしければお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/40", "thumbnail_src": "https://si.imgix.net/7f7b828c/uploads/origins/e3470852-3604-488d-9536-27baf16cfb49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c662c628a1247a66a5ba1ed20fa538a", "thumbnail_srcset": "https://si.imgix.net/7f7b828c/uploads/origins/e3470852-3604-488d-9536-27baf16cfb49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c662c628a1247a66a5ba1ed20fa538a, https://si.imgix.net/7f7b828c/uploads/origins/e3470852-3604-488d-9536-27baf16cfb49?bg=%23fff&auto=format%2Ccom