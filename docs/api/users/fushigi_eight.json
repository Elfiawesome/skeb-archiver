%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4dac907dcac69e3797005a86105b498", "thumbnail_srcset": "https://si.imgix.net/61be34df/uploads/origins/d68042c9-7031-4a9f-a716-f7553c979492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4dac907dcac69e3797005a86105b498, https://si.imgix.net/61be34df/uploads/origins/d68042c9-7031-4a9f-a716-f7553c979492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b68b5c57fd2c5ad6529e11eae979a00 2x, https://si.imgix.net/61be34df/uploads/origins/d68042c9-7031-4a9f-a716-f7553c979492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a67e026f37f02f59c5bb4b295eea731 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nキャラ：夢限(WIXOSS) グロウ前\nhttps://www.takaratomy.co.jp/products/wixoss/card_list.php?card=card_detail&card_no=WXK03-019\n\n\n主観視点で好きな相手と騎乗位生えっちをしているイラストをお願いします！！\n\nhttps://skeb.jp/@fushigi_eight/works/9\n↑のような衣装のイメージでお願いします。股間は半分剥がして挿入している感じです。\nニップレスとヘソさえ描いていただければ衣装は全く同じでなくても構いません。\n\n・おっぱいはかなり大きめ(少なくともhttps://skeb.jp/@fushigi_eight/works/9くらい、https://skeb.jp/@fushigi_eight/works/34まで盛ってもOK)、乳輪も大きいのではみ出ている\n・陰毛有り無し、おっぱいのニップレス有り無しの差分\n・(耳が見えるなら)ピアス\n・可能なら軽く台詞など。短めの台詞で、ですます口調でなければそれっぽいかと思います。\n\n\n依頼金に見合わない分は適宜削ってください。よろしくお願いいたします。\n\nhttps://www.takaratomy.co.jp/products/wixoss/card/card_list.php?keyword=%E5%A4%A2%E9%99%90&color=%E7%84%A1&level=0&keyword_target=%E3%82%AB%E3%83%BC%E3%83%89%E5%90%8D", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/37", "thumbnail_src": "https://si.imgix.net/a857a132/uploads/origins/accdf634-2f0f-494b-8231-f854c5d9d77e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca593656c384cb1622691fc6841398d1", "thumbnail_srcset": "https://si.imgix.net/a857a132/uploads/origins/accdf634-2f0f-494b-8231-f854c5d9d77e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca593656c384cb1622691fc6841398d1, https://si.imgix.net/a857a132/uploads/origins/accdf634-2f0f-494b-8231-f854c5d9d77e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15208086bc9eee705e476ad07f7e15c0 2x, https://si.imgix.net/a857a132/uploads/origins/accdf634-2f0f-494b-8231-f854c5d9d77e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f1aed64d6aba96d43b72b2c8a70f6fe 3x", "genre": "art", "nsfw": true, "body": "もし可能であれば下記内容でリクエストさせていただきます…！\n\n・キャラクター\nステーションメモリーズ！(駅メモ！)　七耀みつる\n\n・衣服など\n服は参考URL先で真っ先に出ている衣服でお願います。\n胸の部分や局部付近は脱がすか、あるいはずらしてください。\n胸と脚は、ある程度盛ってください。\nご面倒でございましたら、全裸でも構いません。\nただし、少なくとも手袋とブーツは装着したままでお願いいたします。\n\n・シチュエーションにつきまして\n手、またはアダルトグッズ、あるいはその両方を用いての自慰行為。\n\n余力がございましたら、絶頂直前、中、後の差分を頂けると嬉しいです。\n\n\nその他、体勢等など、記載無き事項はお任せいたします。\nご検討のほど、何卒よろしくお願いいたします。\n\n【参考URL】\n・キャラ、衣服参照(PC版のほうが見やすいかと思います。)\nhttps://ek1mem0.wiki.fc2.com/wiki/%E4%B8%83%E8%80%80%E3%81%BF%E3%81%A4%E3%82%8B\n\n・二次創作ガイドライン\nhttps://ekimemo.com/guideline", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/36", "thumbnail_src": "https://si.imgix.net/ce38f44c/uploads/origins/c8035a6b-7174-41fa-862b-594ba335538c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56f26d0a880600db0d37c62cb4d0d4e9", "thumbnail_srcset": "https://si.imgix.net/ce38f44c/uploads/origins/c8035a6b-7174-41fa-862b-594ba335538c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56f26d0a880600db0d37c62cb4d0d4e9, https://si.imgix.net/ce38f44c/uploads/origins/c8035a6b-7174-41fa-862b-594ba335538c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49892268c0ecf945cc881926a529d673 2x, https://si.imgix.net/ce38f44c/uploads/origins/c8035a6b-7174-41fa-862b-594ba335538c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=615be0e222e51d33f3a77a3147b52fd5 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nえいとさんのおまんこの描き方も好きです。\n\nもしよろしければ、うちの子のくぱぁを描いてください。私のTRPGキャラです。中二病の催眠魔術師です。\n恥ずかしそうな表情にしてください。白いパンツをずらして、できるだけ大きく広げてください。できれば、子宮口が見たいです。\n修正は黒海苔でお願いします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1PMxgOjct_VIj-H65p4NZkvuju2gA_p4v?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/35", "thumbnail_src": "https://si.imgix.net/ca475409/uploads/origins/cfdc39e7-5e3e-4912-8336-ece67e290342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1150f11fbcbde6ea1dae457395099c74", "thumbnail_srcset": "https://si.imgix.net/ca475409/uploads/origins/cfdc39e7-5e3e-4912-8336-ece67e290342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1150f11fbcbde6ea1dae457395099c74, https://si.imgix.net/ca475409/uploads/origins/cfdc39e7-5e3e-4912-8336-ece67e290342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfae96b6201d42951bad0cb78d4eadb6 2x, https://si.imgix.net/ca475409/uploads/origins/cfdc39e7-5e3e-4912-8336-ece67e290342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90ca489d41ae88b7bf0c2d25032dba57 3x", "genre": "art", "nsfw": true, "body": "始めてご依頼させていただきます\nキャラクター：Vtuber 皇ロゼ（ @Rose_Sumeragi ）\nシチュ：依然描かれていた\nhttps://skeb.jp/@fushigi_eight/works/30\nや\nhttps://skeb.jp/@fushigi_eight/works/26\nのような\nベッドでくぱぁして全裸でおねだりをお願いいたします\n陰毛はなしでお願いします", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/34", "thumbnail_src": "https://si.imgix.net/5095ae36/uploads/origins/92a175a5-666d-4a4c-8842-2c9c35dd4da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dc4ce9f22fb60fe93115f0681f36eb0", "thumbnail_srcset": "https://si.imgix.net/5095ae36/uploads/origins/92a175a5-666d-4a4c-8842-2c9c35dd4da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dc4ce9f22fb60fe93115f0681f36eb0, https://si.imgix.net/5095ae36/uploads/origins/92a175a5-666d-4a4c-8842-2c9c35dd4da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=612e177bc44651de190644c979ec6d05 2x, https://si.imgix.net/5095ae36/uploads/origins/92a175a5-666d-4a4c-8842-2c9c35dd4da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e93b80eaabea2fec1ebbf02f67a8f2f 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラストをありがとうございます。\n今回は「ファイアーエムブレム覚醒」のチキを下記URLの服装と見た目を元に依頼させてください。\nhttps://guide.fire-emblem-heroes.com/10009001000841-2/\n\nシチュは神竜の巫女として長く生きる中でムラムラしたり人肌恋しくなり、当時身近にいて親しかった若い男性(神殿でお手伝いしてくれていた神官や兵士等)を誘ってしまう…の様なイメージで、足を大きく開いて男性に跨る騎乗位の体位で、ちょっと照れつつも興奮しながら挿入前に既に濡れてる女性器を片手で開いて見せつけてる様子からお願いします。セリフの口調は資料URLなどご参考下さい。\n構図は女性器周辺が良く見える下の方からのアングルで描いてください。体勢はシチュに合うものをお任せします。直近で描かれていた愛宕のイラストの様に男性の姿や男性器は描かず透明で描いてください。\n服装は側面にある紐をゆるめるかほどくかして足を開ける様にして、男性に女性器周辺を見せての誘惑と挿入の様子が見える様にしてください。\n上も紐を同様にゆるめてずらす等して彼女の大きな胸を露出させて頂ければと思います。胸元の竜石は付けたままにしてください。\n差分として、挿入して腰を振り久々のセックス楽しんでる様子と絶頂しながら中出しされる様子、性欲満たされて満足そうにいっぱい出したわね等と言ってそうな事後の様子をお願いします。\nその他はセリフ含め全てお任せします。アレンジして頂いても構いません。\n以上、よろしければお願いします。\n\nhttps://www.pegasusknight.com/wiki/feh/%E4%BB%B2%E9%96%93/%E3%83%81%E3%82%AD%EF%BC%88%E8%A6%9A%E9%86%92%EF%BC%89#q1724e8a", "created_at": "", "completed_at": ""}, {"path": "/@fushigi_eight/works/33", "thumbnail_src": "https://si.imgix.net/ecb646ef/uploads/origins/7d7ed0e5-4571-4369-b36b-26caca6c7c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28af756bc0efeb818826c64eee6ff012", "thumbnail_srcset": "https://si.imgix.net/ecb646ef/uploads/origins/7d7ed0e5-4571-4369-b36b-26caca6c7c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28af756bc0efeb818826c64eee6ff012, https://si.imgix.net/ecb646ef/uploads/origins/7d7ed0e5-4571-4369-b36b-26caca6c7c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78b812ac73c13d0cbcd080e389ff2414 2x, https://si.imgix.net/ecb646ef/