2Ccenter&txtsize=30&txt=PRIVATE&s=965189dabd81ac02997be2d6dabc814c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inui_j_isohata/works/70", "thumbnail_src": "https://si.imgix.net/0652b040/uploads/origins/e20c2d66-908e-4717-8554-5a59b2450fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4993a86cccee8ae82fd9d15607c5313", "thumbnail_srcset": "https://si.imgix.net/0652b040/uploads/origins/e20c2d66-908e-4717-8554-5a59b2450fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4993a86cccee8ae82fd9d15607c5313, https://si.imgix.net/0652b040/uploads/origins/e20c2d66-908e-4717-8554-5a59b2450fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d25d86bbb67ecece1c5c02c825b947c 2x, https://si.imgix.net/0652b040/uploads/origins/e20c2d66-908e-4717-8554-5a59b2450fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7998ad6c9e2f3a42049bf4d110aac876 3x", "genre": "art", "nsfw": true, "body": "こんにちは。もし仮面ライダー鎧武に出たビャッコインベスとセイリュウインベスをご存知ですか？ この二人のキャラクターが壁尻に翻弄される作品を申し込みたいです。\n2人とも並んで壁に打ち込まれていますが、1人はうつぶせの姿勢で、もう1人はお腹を出した姿勢でいてほしいです。 壁の向こうが半透けて見える様子やリンクの絵のように(https://x.com/SSu_open/status/1771615480731635904)、壁の上にスクリーンをつけて、二人の戸惑いと恥ずかしがり屋の顔も見せてもらえますか?\nクリーンバージョンとクリームパイバージョンの両方があればいいですし(代わりに体に落書きはありません)、もしビャッコインベスが難しければデザインが似ているヘキジャインベスに変えて描いていただいてもいいです。 ありがとうございます。\n\nセイリュウインベス: https://drive.google.com/drive/folders/136z4W-dW28KqvYqUddvOjuv_PDG0ws7a?usp=drive_link\nビャッコインベス: https://drive.google.com/drive/folders/13Kp-pCEu0_wsjJCMLEK5QXiygapW-5ad?usp=sharing\nヘキジャインベス: https://drive.google.com/drive/folders/13LD6_1bg7Clq1OlKeVzwN6kTa_-Ri05Q?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@inui_j_isohata/works/69", "thumbnail_src": "https://si.imgix.net/1f9d2774/uploads/origins/b0da854f-01a3-43f2-a113-1116ff641dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=938258fcfca150597f61490ec5243007", "thumbnail_srcset": "https://si.imgix.net/1f9d2774/uploads/origins/b0da854f-01a3-43f2-a113-1116ff641dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=938258fcfca150597f61490ec5243007, https://si.imgix.net/1f9d2774/uploads/origins/b0da854f-01a3-43f2-a113-1116ff641dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94d6d669242993e5fffaf51da00bd7ab 2x, https://si.imgix.net/1f9d2774/uploads/origins/b0da854f-01a3-43f2-a113-1116ff641dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf68a1ea22a26942640754c76658f111 3x", "genre": "art", "nsfw": true, "body": "こんにちは、お世話になっております。\nもしよろしければ今回もまたお願いいたします。\n\n■お題\n・ジャローダに丸呑みにされた天城大地。\n\n■詳細\n・ジャローダは高い木の枝や幹に絡み付いている状態。\n・丸呑みにした天城をハンモックのような形でぶら下げている。\n（どのような状態か詳しくは資料画像を例としてご参照ください）\n・体内保管に留まり、消化や排泄の描写なし。\n・透過されて体内の天城が見えている（透過されていない差分をお願いします）\n\n※https://skeb.jp/@oh_hisashino/works/64\n上記の作品のような『天城の体が埋もれてしまって、ほとんど見えない状態にはならない』ようにお願いいたします。\n\n■天城\n・衣類、シューズが消化されて裸（ゴーグル有り）\n・窮屈な体内で身動きが取れない状態。\n・体液に塗れている。\n\n■ジャローダ\n・標準サイズ（3.3m/63.0kg）よりも太く長い。\n（大きさのイメージとして資料画像をご参照ください、体長はどれだけ長くても大丈夫です）\n・丸呑みにして大きく膨らんだ部分（天城）に顔を寄せてニヤニヤとしている。\n\n以上がリクエスト内容になります、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1XFkUpsSlBdjXqetzJw2P8fAYy90pDDaR", "created_at": "", "completed_at": ""}, {"path": "/@inui_j_isohata/works/68", "thumbnail_src": "https://si.imgix.net/81a10b91/uploads/origins/40d52d8e-b04a-4a22-9ae2-755b11c2fa5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6abdaad9b0b73379f8027395131dc22", "thumbnail_srcset": "https://si.imgix.net/81a10b91/uploads/origins/40d52d8e-b04a-4a22-9ae2-755b11c2fa5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6abdaad9b0b73379f8027395131dc22, https://si.imgix.net/81a10b91/uploads/origins/40d52d8e-b04a-4a22-9ae2-755b11c2fa5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f186d96af404db30f495ef621e01c25 2x, https://si.imgix.net/81a10b91/uploads/origins/40d52d8e-b04a-4a22-9ae2-755b11c2fa5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=018580f9be1ee264253de714a4474124 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\nあなたが描いた、ゴブリンに倒された狼男の王の古い絵がとても好きです。https://x.com/inui_j_isohata/status/1394020525240852481\n\n人狼王がゴブリンのペットになっているこの絵の続編をお願いしたいです。ゴブリンは足を支えていて、足の裏は土にまみれている。人狼王は手と膝をついて、ゴブリンの汚れた足を舐めてきれいにしている。オオカミ王は犬の首輪をつけ、ゴブリンはオオカミ王に鎖をつけているのかもしれない。ゴブリンは狼王の妻をレイプしているかもしれないし、ゴブリンが狼王を見下したりするような、古い写真のような台詞を与えることもできる。\n\n極端すぎたら申し訳ないのですが、ゴブリンが人狼王を支配し、人狼王に自分の汚れた足を完全にきれいになるまで舐めさせるところをぜひ見てみたいです。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@inui_j_isohata/works/67", "thumbnail_src": "https://si.imgix.net/7bc0ea79/uploads/origins/85864f43-072c-4af5-ba7b-ffe97509d752?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d28edf71df5b55946efa92a96077962", "thumbnail_srcset": "https://si.imgix.net/7bc0ea79/uploads/origins/85864f43-072c-4af5-ba7b-ffe97509d752?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d28edf71df5b55946efa92a96077962, https://si.imgix.net/7bc0ea79/uploads/origins/85864f43-072c-4af5-ba7b-ffe97509d752?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b1f892ba530aa382aa75b13663958c15 2x, https://si.imgix.net/7bc0ea79/uploads/origins/85864f43-072c-4af5-ba7b-ffe97509d752?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=453b492a409c861095d1769a11f9ce37 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@inui_j_isohata/works/6