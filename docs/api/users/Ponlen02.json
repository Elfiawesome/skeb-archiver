ads/origins/8b62eb34-1b18-432d-b722-0ae1914c7866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c407b84b828978808c66b1b14a0ff0d", "thumbnail_srcset": "https://si.imgix.net/1b9565f7/uploads/origins/8b62eb34-1b18-432d-b722-0ae1914c7866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c407b84b828978808c66b1b14a0ff0d, https://si.imgix.net/1b9565f7/uploads/origins/8b62eb34-1b18-432d-b722-0ae1914c7866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71e582c354da183c7e521477e484d4e9 2x, https://si.imgix.net/1b9565f7/uploads/origins/8b62eb34-1b18-432d-b722-0ae1914c7866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46a6eb45893e855e38a1a6324dc9e0d2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ponlen02/works/114", "thumbnail_src": "https://si.imgix.net/adbaf64b/uploads/origins/0034ef74-a082-46a3-97b5-935f59d6272a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7186db17fbba4ddcba8e65effcd439ab", "thumbnail_srcset": "https://si.imgix.net/adbaf64b/uploads/origins/0034ef74-a082-46a3-97b5-935f59d6272a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7186db17fbba4ddcba8e65effcd439ab, https://si.imgix.net/adbaf64b/uploads/origins/0034ef74-a082-46a3-97b5-935f59d6272a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38c1d1041dfc18c9f8c3f34343870421 2x, https://si.imgix.net/adbaf64b/uploads/origins/0034ef74-a082-46a3-97b5-935f59d6272a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5637d1bef009d31f6c97892dec73b3b8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！\n近咲さんのイラストが可愛くてとても好きです！もしよければわたしのオリジナルキャラ二人をお願いしたいです...！\n小さいデフォルメの羽を足して、天使と悪魔パロの感じでお願いしたいです\n小毬（天使）→性格ふわふわしてて体が弱い女の子\n都竹（悪魔）→表情はふわふわはしてますが、少しいたずら好きな子\n\n二人は別々にパートナーがいるので、カップリング的な関係ではないです～！ポーズはお任せします...！\n一枚絵にするのも、二枚に分けるのもどっちでも構いません。\n衣装は先生の描きやすい方を選んでください、もし衣装などにわからない所ありましたらお好きに変えても大丈夫です！\n\nもし金額が足りない場合再送信お願いします、\nご検討いただけますと幸いです！\n\nhttps://drive.google.com/drive/folders/1-240WDyUAJOfzqFtJfSHRP34GLZTnncn", "created_at": "", "completed_at": ""}, {"path": "/@Ponlen02/works/113", "thumbnail_src": "https://si.imgix.net/a0a556b6/uploads/origins/bb35bda4-7a94-40f9-a355-3269277fea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5770eb76b021320402472c36a35f2fca", "thumbnail_srcset": "https://si.imgix.net/a0a556b6/uploads/origins/bb35bda4-7a94-40f9-a355-3269277fea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5770eb76b021320402472c36a35f2fca, https://si.imgix.net/a0a556b6/uploads/origins/bb35bda4-7a94-40f9-a355-3269277fea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9897c15dc9673c68a4fd402b295dabb0 2x, https://si.imgix.net/a0a556b6/uploads/origins/bb35bda4-7a94-40f9-a355-3269277fea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de09bbf17ac081549babf0bd42bfc2ae 3x", "genre": "art", "nsfw": false, "body": "はじめまして！Vtuber準備中の咏羽もると申します。\nSkebにて近咲335先生の素敵なイラストを拝見させて頂き、ぜひご依頼したいと思い、今回ご連絡させていただきました。\n\n【サイズ】\nお任せ致します。\n\n【ポーズ、表情】\nお任せ致します。かわいらしい雰囲気が好みです！\n差分等ありましたら、大変嬉しいです！\n\n【キャラクターデザイン、モチーフ、服装】\nモチーフ┊︎モルモット、リボン、キラキラマーク✧\n服装┊︎キャラクターデザインを参考にしていただければお好きなもデザインを選んでいただいて大丈夫です◎\nキャラクターデザインの参考資料を下記に添付させて頂きましたので、ご確認の程よろしくお願い致します。\n\n【使用用途】\nSNS(X、Youtube、Twitch等の収益化済コンテンツ)での配信等のVtuber活動での使用。\n\n【ファイル形式】\n背景がある場合は、人物を背景を分けたPSD形式だと大変助かります。\n\n御検討の程よろしくお願い致します。\n\n金額が見合わない場合はお手数ですが再送をしていただけますと幸いです。\n\nhttps://drive.google.com/file/d/1PEXKHJZMbr