=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=410d6f9ae7972063df3ac731ec749878 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@png_601/works/48", "thumbnail_src": "https://si.imgix.net/d1c6d33a/uploads/origins/b0691e99-57c5-4795-9400-49f7d7bcc639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca6cd9cef54e46fbc0722a7975d96483", "thumbnail_srcset": "https://si.imgix.net/d1c6d33a/uploads/origins/b0691e99-57c5-4795-9400-49f7d7bcc639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca6cd9cef54e46fbc0722a7975d96483, https://si.imgix.net/d1c6d33a/uploads/origins/b0691e99-57c5-4795-9400-49f7d7bcc639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8abb381d04e5079dd0c0cf0a94f9bb5 2x, https://si.imgix.net/d1c6d33a/uploads/origins/b0691e99-57c5-4795-9400-49f7d7bcc639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b809a1cb87f348a6a3507400239db254 3x", "genre": "comic", "nsfw": false, "body": "Hello, I really love your art! Can I have a comic commission of my two characters?\n\nCharacter 1/With the short orange hair is a princess who died and becomes a ghost. They likes to bother character 2, they are cheerful and lively despite being a ghost!\n\nCharacter 2/190cm with the long white hair is an exorcist that chases down ghosts, they're quiet and cold. They really care about their work and have a hard time getting along with other people, they carry bibles and crosses but don't actually believe in god.\n\nI'll love to see a comic where they interact,  Character 1 likes to be clingy and bother Character 2. But Character 2 is cold to them because she wants them to move on to the afterlife. \n\nThank you for your consideration! \n\nhttps://drive.google.com/drive/u/0/folders/1P_BpcTacXdz5ceozSSEylbjDqVnD8MjN\n\nhttps://drive.google.com/drive/u/0/fo