f00cb50984f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d4ab04c1a48e0932f689d25f2ef534", "thumbnail_srcset": "https://si.imgix.net/2c6e18ef/uploads/origins/6aa2624a-7bf6-403c-ad18-7f00cb50984f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d4ab04c1a48e0932f689d25f2ef534, https://si.imgix.net/2c6e18ef/uploads/origins/6aa2624a-7bf6-403c-ad18-7f00cb50984f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b47f33c891d118d9209f3b306c9feb4b 2x, https://si.imgix.net/2c6e18ef/uploads/origins/6aa2624a-7bf6-403c-ad18-7f00cb50984f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c97d620c1dd432ea051938b50a61092 3x", "genre": "art", "nsfw": false, "body": "はじめまして\nすぺしゃりて2期生「終末むくろ」さんの\n綺麗でカッコいいファンアートを描いていただきたいです。\n\n◆依頼詳細\n・エルデンリングナイトレインの復讐者の暗黒衣装のコスプレ\n・屍山血河を装備、振るか構えるかはお任せ\n・薄紫色の蝶の装飾をアレンジで追加（レイヤー分け）\n・ヴェールが風になびいている表現\n\n◆使用用途\n・FAタグをつけてXに投稿\n・終末むくろさんのYouTubeの配信やサムネイル、\n　週間スケジュール、SNSでの使用\n\n◆納品形式\n・人物と背景等がレイヤー分け出来るPSDファイル\n\n◆参考\n三面図\nhttps://x.com/MukuroOwarino/status/1807126500233421242/photo/1\n3D\nhttps://www.youtube.com/watch?v=OwQq0FNvcDo&t=5724s\n復讐者暗黒衣装\nhttps://cdn.gamerch.com/contents/wiki/5408/entry/8l5mKrTG.png\n屍山血河\nhttps://gamewith.jp/eldenring/500478\n\n以上、ご検討のほどよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/272", "thumbnail_src": "https://si.imgix.net/639440eb/uploads/origins/28fd7529-d17f-42e6-9d76-e8c284009eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6045408f358e3b063650bac78339490a", "thumbnail_srcset": "https://si.imgix.net/639440eb/uploads/origins/28fd7529-d17f-42e6-9d76-e8c284009eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6045408f358e3b063650bac78339490a, https://si.imgix.net/639440eb/uploads/origins/28fd7529-d17f-42e6-9d76-e8c284009eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35f9984843c3925dc4cfbe8171a2a197 2x, https://si.imgix.net/639440eb/uploads/origins/28fd7529-d17f-42e6-9d76-e8c284009eae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bda51d7b8efa14a03c6a4ed13fe1492e 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！\n今回もFF14のOCをモチーフにした作品をお願いしたいです。\n\n女性のエレゼン（エルフ）です。彼女は大人です：\nhttps://drive.google.com/drive/folders/1jdwN9RYFTSXo9FnJsVst_eKX4Jx67poI?usp=sharing\n背が高くてスレンダー、バストサイズはCカップ。目の色はピンク。髪の色は深い黒。メイクは口紅とアイシャドウ。\n\n服装は自由ですが、スカートにガーターベルト付きのストッキング、参考資料のネックレスとチョーカー（クリスタルは彼女の瞳と同じ色）で、彼女の美しい胸と肌を少し見せてほしいです。彼女の足を見せるなら、参考資料のハイヒールを選んでください。  \n\nポーズはお任せしますが、ストッキングとガーターベルトで太ももを見せてください。\nまた、背景付きでお願いします。\nそしてポートレートで描いてください。\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/271", "thumbnail_src": "https://si.imgix.net/70fd7583/uploads/origins/a37a94b9-8cb4-43e4-8b4b-c6a3ba58a6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=477cceddfc4b5d66b99854f80d6d3f44", "thumbnail_srcset": "https://si.imgix.net/70fd7583/uploads/origins/a37a94b9-8cb4-43e4-8b4b-c6a3ba58a6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=477cceddfc4b5d66b99854f80d6d3f44, https://si.imgix.net/70fd7583/uploads/origins/a37a94b9-8cb4-43e4-8b4b-c6a3ba58a6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f599f2de0a1d5d3a30ca74eb2c2b606a 2x, https://si.imgix.net/70fd7583/uploads/origins/a37a94b9-8cb4-43e4-8b4b-c6a3ba58a6a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6667b674c34e834120e5b86b85ab5b4e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\n\nあなたの画風はとても魅力的で、もっと見たいと思いました！ということで、またまたリクエストです！あなたの描くキャラクターは可愛すぎます！\n\nスターレールのホタルちゃんを題材にした作品を作っていただけませんか？\n\n今回はすべてお任せします！\n\nありがとうございました\nhzcafe", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/270", "thumbnail_src": "https://si.imgix.net/4c3c38ca/uploads/origins/ef00a84e-389a-4838-8be0-c386b5aa5735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=090201aaa1934024656642967e941f47", "thumbnail_srcset": "https://si.imgix.net/4c3c38ca/uploads/origins/ef00a84e-389a-4838-8be0-c386b5aa5735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=090201aaa1934024656642967e941f47, https://si.imgix.net/4c3c38ca/uploads/origins/ef00a84e-389a-4838-8be0-c386b5aa5735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0c7e95ce726197b4724775c5864e09 2x, https://si.imgix.net/4c3c38ca/uploads/origins/ef00a84e-389a-4838-8be0-c386b5aa5735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5cc5a0645c9d17c23d3ad1a3e8817c4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/269", "thumbnail_src": "https://si.imgix.net/f952bbf9/uploads/origins/fb5ae87d-ce22-45b4-beed-f030867dbf60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f663455c59363c4411bdfc5409d6e07a", "thumbnail_srcset": "https://si.imgix.net/f952bbf9/uploads/origins/fb5ae87d-ce22-45b4-beed-f030867dbf60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f663455c59363c4411bdfc5409d6e07a, https://si.imgix.net/f952bbf9/uploads/origins/fb5ae87d-ce22-45b4-beed-f030867dbf60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb7c44f801384d7f6b94eb9a89f89000 2x, https://si.imgix.net/f952bbf9/uploads/origins/fb5ae87d-ce22-45b4-beed-f030867dbf60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00e2ecf2c4789385c1dee9f6fc6d1d51 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵がとても好きです。私のOCを描いてほしいです。グレーの髪にピンクの瞳の女の子です。参考の布は自由に選んでください。構図や姿勢も自由に描いてください！協力できる機会があればとても嬉しいです！ https://drive.google.com/drive/folders/1AIRfVkicJokybmEfIRwf_JV_REY1FroW", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/268", "thumbnail_src": "https://si.imgix.net/66590250/uploads/origins/fa76d7a3-e1c0-4925-946c-b1de5e342606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96734db24ec22c270ceba75d0cfc145", "thumbnail_srcset": "https://si.imgix.net/66590250/uploads/origins/fa76d7a3-e1c0-4925-946c-b1de5e342606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96734db24ec22c270ceba75d0cfc145, https://si.imgix.net/66590250/uploads/origins/fa76d7a3-e1c0-4925-946c-b1de5e342606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0f89331deeacb864ac4119a650c7263 2x, https://si.imgix.net/66590250/uploads/origins/fa76d7a3-e1c0-4925-946c-b1de5e342606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45c7f953567b8b577cf899f0912cca74 3x", "genre": "art", "nsfw": false, "body": "シキナさま、はじめまして！月來と申します。\nいつも素敵なイラストを楽しく拝見しております…！\n\nもしよろしければ、私のOC「バルバラ」のイラストをお願いしたいです。\n穏やかさと物騒さを併せ持つ、魔法剣士の女性です。\n資料：https://7aconit.notion.site/193565fcc5b980f799d5e528963e8b74?source=copy_link\n\n構図等はお任せできればと思います。自由に描いてください！\nご検討いただけますと幸いです、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/267", "thumbnail_src": "https://si.imgix.net/69d50aef/uploads/origins/a41b3de9-4aae-43a2-91e1-d8589b04f411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdbf89ed945e8b13c0e0634b082ed823", "thumbnail_srcset": "https://si.imgix.net/69d50aef/uploads/origins/a41b3de9-4aae-43a2-91e1-d8589b04f411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdbf89ed945e8b13c0e0634b082ed823, https://si.imgix.net/69d50aef/uploads/origins/a41b3de9-4aae-43a2-91e1-d8589b04f411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4949623ccac40bc7f3db2c1c5640572f 2x, https://si.imgix.net/69d50aef/uploads/origins/a41b3de9-4aae-43a2-91e1-d8589b04f411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67368705eda098adaccb765774a24d40 3x", "genre": "art", "nsfw": false, "body": "初めまして！\nイラストを拝見して、とても素敵だなと思ったのでリクエストさせていただきました。シキナさんの描くうちの子が見てみたいです。\nボロボロのセーラー服を着せていただき、髪型は肩くらいの長さでお願いできれば嬉しいです。あとはすべてお任せします。\nデスクトップの壁紙として使用し、アニメーションにするかもしれません（いずれも個人利用です）。\nよろしくお願いいたします！\nhttps://imgur.com/a/O7KHzjP", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/266", "thumbnail_src": "https://si.imgix.net/3db5dedd/uploads/origins/1d24c18e-4de4-442a-b696-748399c95cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78920a9ee4d3de96c3bfc3e1169b3f47", "thumbnail_srcset": "https://si.imgix.net/3db5dedd/uploads/origins/1d24c18e-4de4-442a-b696-748399c95cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78920a9ee4d3de96c3bfc3e1169b3f47, https://si.imgix.net/3db5dedd/uploads/origins/1d24c18e-4de4-442a-b696-748399c95cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2921712dada49e04ccd11941d4a38c29 2x, https://si.imgix.net/3db5dedd/uploads/origins/1d24c18e-4de4-442a-b696-748399c95cc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b52d98dd77b505d6356bd7df8a6c323b 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nバーチャルの姿で歌ってみたやゲーム配信の\n活動を行っておりますsh1an（しあん）と申します。\n\nシキナ様のイラストをskebでおみかけして\nイラストの雰囲気がすごく好みでぜひご依頼したいと思いました！\n\n構図やポーズなどは全てお任せでお願いします！\n\nシキナ様のイラストで好きなものを挙げさせていただきます！\nhttps://skeb.jp/@mochigushi_/works/228\nhttps://skeb.jp/@mochigushi_/works/226\n\n【データ】\n背景がある場合は人物と分けて頂きPSDかPNGの透過データで頂ければ幸いです。\n人物単体でもサムネに使わせて頂ければ嬉しいので髪の毛や頭は\n画角からはみ出る場合は画角外の描画頂けますと幸いです。\n\n【使用用途】※可能性のあるものはすべて書かせていただきます。\n①YouTubeやTwitchなどのOP,ED,配信待機画面,サムネイル,動画内での使用\n②SNS等のアイコン,ヘッダー等やポスト\n③サブスクなどで観られるコンテンツや同人規模でのグッズ販売\n④歌ってみた動画などのイラスト\n\n【キャラクター】\n三面図をご参考にお願いいたします。\n黒髪ポニーテールの青い瞳のデザインでお願いいたします。\nマントありでマスコットも一緒に描いて頂けると嬉しいです。\n\nhttps://drive.google.com/file/d/1cZrJh5XVAZf2h2wvSUT2emNFPT5gta_B/view?usp=drive_link\n\n以上となります。\n\n暑い日が続きますので、どうぞご体調にはお気を付けくださいませ。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/265", "thumbnail_src": "https://si.imgix.net/c15e783b/uploads/origins/77e1538e-9bd5-474d-881e-38036ed14a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faaec3e2b342743d40eace9d0061fe59", "thumbnail_srcset": "https://si.imgix.net/c15e783b/uploads/origins/77e1538e-9bd5-474d-881e-38036ed14a24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faaec3e2b342743d40eace9d0061fe59, https://si.imgix.net/c15e783b/uploads/origins/77e1538e-9bd5-474d-881e-38036ed14a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=baa2ba9bfd3b0d5240a9502db5be8edb 2x, https://si.imgix.net/c15e783b/uploads/origins/77e1538e-9bd5-474d-881e-38036ed14a24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2541765fdedd5a3dedf92333fef81f91 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mochigushi_/works/264", "thumbnail_src": "https://si.imgix.net/f6f678c4/uploads/origins/b4d72a7e-88c0-4afe-8a57-6ab85825270e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ed1761191e158d0104b4fe17b769fc", "thumbnail_srcset": "https://si.imgix.net/f6f678c4/uploads/origins/b4d72a7e-88c0-4afe-8a57-6ab85825270e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71ed1761191e158d0104b4fe17b769fc, https://si.imgix.net/f6f678c4/uploads/origins/b4d72a7e-88c0-4afe-8a57-6ab85825270e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4468a7aec2209efbb71623526f5eab2e 2x, https://si.imgix.net/f6f678c4/uploads/origins/b4d72a7e-88c0-4afe-8a57-6ab85825270e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72d3adc4a370333b380e5ad8d6cafed4 3x", "genre": "art", "nsfw": true, "body": "シキナ先生、こんにちは！シドロップと申します。またお邪魔して申し訳ないのですが、先生の作品のデザインや雰囲気が本当に大好きです！\n今回は、二人の竜の女の子を一緒に描いてほしいです。白いツインポニーテールの白龍娘は、激しい性格。長い黒髪の黒竜少女は温和な性格で、とても魅力的です。武器を持っているところも描いてほしいです。服装や躍動感のあるポーズも自由に選んでください。\nhttps://drive.google.com/drive/folders/10BjLoKcFxv9yEjPTnGKXnEdyjVAq0o9T\nhttps://skeb.jp/@mochigushi_/works/214この作品の横長のレイアウトと半透明の明るい照明がとても好きです。\n今回の依頼も同じような雰囲気でお願いしたいです。\n前回の依頼がとても気に入ったのと、今回の依頼の方がより細かく描けるかもしれないので、金額を上げました。それでも足りないようでしたら再依頼させていただきます。ご検討よろしくお願いします！♡\n\nhttps://drive.google.com/drive/folders/1kUO2dpdlJHrsS8CFjvly2xro_JC4FgCb", "created_at": "", "completed_at": ""}]}