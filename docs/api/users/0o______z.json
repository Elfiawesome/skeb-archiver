=30&txt=PRIVATE&s=22034a843a2949f4e073e5b8974cb289 2x, https://si.imgix.net/925f07af/uploads/origins/b81dba53-0b72-4318-883c-243251a26524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecf310f99a6e0625dfa40b6e84d221dc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@0o______z/works/13", "thumbnail_src": "https://si.imgix.net/39816961/uploads/origins/63082047-8acd-4ffe-8a3d-3d9e8fdebc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0a0a7d8fc4c4c0bc5fa9e99a8ff5ba7", "thumbnail_srcset": "https://si.imgix.net/39816961/uploads/origins/63082047-8acd-4ffe-8a3d-3d9e8fdebc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0a0a7d8fc4c4c0bc5fa9e99a8ff5ba7, https://si.imgix.net/39816961/uploads/origins/63082047-8acd-4ffe-8a3d-3d9e8fdebc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7d9d8f59c2a0b01b1406c66a74d123a 2x, https://si.imgix.net/39816961/uploads/origins/63082047-8acd-4ffe-8a3d-3d9e8fdebc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f95072f77105ab1e2eb3dbcad5f9c7eb 3x", "genre": "art", "nsfw": false, "body": "ペットのハムスターの擬人化イラストお願いします。全身とミニキャラ風お願いしたいのですが、金額に見合わないようでしたら再送要請して頂きたいです。\n\n\n以下詳細です。\n名前：ミサイル (♂)\nかなり人懐っこいし、かなり横着な性格です。\n知らないところでも、どこでも寝ようとします。\n︎︎ ♀として販売されていましたが、半年後病院に検査に行ったところ♂と発覚しました。\n\n資料の欄に写真ツイートのURL貼ってあります。\n\nいつもイラスト楽しみに見てます！よろしくお願いします！\n\nhttps://x.com/lu_lal_/status/1843445882618007683?s=46&t=0cU4H62YPRUwES3zsdb6VQ", "created_at": "", "completed_at": ""}, {"path": "/@0o______z/works/12", "thumbnail_src": "https://si.imgix.net/3918185d/uploads/origins/ad230beb-3b72-44be-9934-fbea6b75caea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3567aaa7bf18a37abd03b70245440942", "thumbnail_srcset": "https://si.imgix.net/3918185d/uploads/origins