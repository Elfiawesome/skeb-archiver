_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/39", "thumbnail_src": "https://si.imgix.net/883da69f/uploads/origins/5d03868e-fb5d-4f85-9e75-e243989226bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdef03b618a23e772565b52ff133fb73", "thumbnail_srcset": "https://si.imgix.net/883da69f/uploads/origins/5d03868e-fb5d-4f85-9e75-e243989226bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdef03b618a23e772565b52ff133fb73, https://si.imgix.net/883da69f/uploads/origins/5d03868e-fb5d-4f85-9e75-e243989226bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f871f896af30d5710e09cd4b7680b4f0 2x, https://si.imgix.net/883da69f/uploads/origins/5d03868e-fb5d-4f85-9e75-e243989226bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6128d3bc260f949c037721bfc50dbfba 3x", "genre": "art", "nsfw": false, "body": "箱部なる(チュウニズム/イロドリミドリ)が体操服ブルマ姿で\nベースを弾いているイラストをお願いします。\n体操服の襟・袖とブルマの色は紺でお願いします。\n\nhttps://chunithm.sega.jp/irodorimidori/character/%E7%AE%B1%E9%83%A8%E3%81%AA%E3%82%8B/", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/38", "thumbnail_src": "https://si.imgix.net/f6f166b8/uploads/origins/214594c8-4cb0-4a93-8fc4-228ae6b2c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8edc2620a865aece4d2726f339ce5ede", "thumbnail_srcset": "https://si.imgix.net/f6f166b8/uploads/origins/214594c8-4cb0-4a93-8fc4-228ae6b2c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8edc2620a865aece4d2726f339ce5ede, https://si.imgix.net/f6f166b8/uploads/origins/214594c8-4cb0-4a93-8fc4-228ae6b2c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1963ca471fc6976e86d3eba6fee93d0b 2x, https://si.imgix.net/f6f166b8/uploads/origins/214594c8-4cb0-4a93-8fc4-228ae6b2c06b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c0cc2f47e3beb1a89ec2d4cda2dfba8 3x", "genre": "art", "nsfw": true, "body": "矢継ぎ早のリクエストで申し訳ありません、前回お受け頂いたこちら\nhttps://skeb.jp/@jinnnouti_akira/works/37\nの文ちゃんのハーフパンツを\n・前とじのボタンがおへその位置のハイウエストで裾はロールアップなしのハイレグ\nにして頂けませんでしょうか？\n\nご検討の程宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/37", "thumbnail_src": "https://si.imgix.net/42abd9a3/uploads/origins/91b290c9-813e-4881-8d73-8149b5772880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2963b02eaa05184e3ad98e33d29f3ee", "thumbnail_srcset": "https://si.imgix.net/42abd9a3/uploads/origins/91b290c9-813e-4881-8d73-8149b5772880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2963b02eaa05184e3ad98e33d29f3ee, https://si.imgix.net/42abd9a3/uploads/origins/91b290c9-813e-4881-8d73-8149b5772880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0576d909a2cdc42857a04080e36c068e 2x, https://si.imgix.net/42abd9a3/uploads/origins/91b290c9-813e-4881-8d73-8149b5772880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=821c9ed3e7460a3066892d20fc8177c0 3x", "genre": "art", "nsfw": true, "body": "はじめまして、\n キャラクター・東方Projectの射命丸文 服装は社会派ルポライター姿で\n ・正面向き立ち姿で膝から上 \n・短パンはハイウエストで裾はロールアップなしのハイレグ\n・ジャケットは未着用 \n・Yシャツは汗だくで下着を着けずに小さいサイズを無理に着ていてパツパツかつ肌に張り付いていて裾はシャツインしているも袖がつんつるてんな状態(手首から上が拳一つ分くらい短い)、更に勃起乳首が透けてくっきり浮きでいる\n・恥じらっている表情 \n\n要望が多く申し訳ありませんが\nご検討の程宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/36", "thumbnail_src": "https://si.imgix.net/2ae8626c/uploads/origins/3f48c23a-4e74-48b0-b7f9-05945c79c0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90780c04e5949d550d01cdea66e5807f", "thumbnail_srcset": "https://si.imgix.net/2ae8626c/uploads/origins/3f48c23a-4e74-48b0-b7f9-05945c79c0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90780c04e5949d550d01cdea66e5807f, https://si.imgix.net/2ae8626c/uploads/origins/3f48c23a-4e74-48b0-b7f9-05945c79c0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad6bb0ce1353194b9aafb57a4bad5dab 2x, https://si.imgix.net/2ae8626c/uploads/origins/3f48c23a-4e74-48b0-b7f9-05945c79c0a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=621cb0449a298235168f9db6ed4b6e18 3x", "genre": "art", "nsfw": true, "body": "はじめまして\ntwitter上でのイラストが好みでしたのでリクエストさせて頂きました\n主な内容はVOCALOIDの鳴花ヒメちゃんのスカートたくし上げをお願いしたいです\n\n●キャラクター\nVOCALOIDの鳴花ヒメ\n\nhttps://dic.pixiv.net/a/%E9%B3%B4%E8%8A%B1%E3%83%92%E3%83%A1%E3%83%BB%E3%83%9F%E3%82%B3%E3%83%88\n\n●服装\nスカートであれば描きやすいものでおまかせ\n\n●ポーズ\n足を閉じた状態での直立\nオヘソが見える位置までスカートを持ち上げている\n真正面からのアングル\n\n●下着\nスジが浮き出ないお子様パンツ\n・赤いリボンが付いた白パンツ\n・フロントプリントの女児ぱんつ(デザインおまかせ)\n\n●表情\n明るい笑顔\nジト目で不機嫌そうな顔\nドヤ顔\nキョトン顔\n\n以上です!\n可能な範囲で構いません\nどうかよろしくお願いいたします!", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/35", "thumbnail_src": "https://si.imgix.net/2a918112/uploads/origins/eed702d1-963c-4705-8507-66d224a44044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6821b2b3d52e975ca47bdae263b9e0ce", "thumbnail_srcset": "https://si.imgix.net/2a918112/uploads/origins/eed702d1-963c-4705-8507-66d224a44044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6821b2b3d52e975ca47bdae263b9e0ce, https://si.imgix.net/2a918112/uploads/origins/eed702d1-963c-4705-8507-66d224a44044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40b422b55fd1091ace911c4ba490f228 2x, https://si.imgix.net/2a918112/uploads/origins/eed702d1-963c-4705-8507-66d224a44044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=074995c51caa5c441032433fbfd3c9ee 3x", "genre": "art", "nsfw": false, "body": "「ちおちゃんの通学路」の「三谷裳ちお」が体操服ブルマ姿で走っているイラストをお願いします。\n体操服の襟・袖とブルマの色は紺を考えています。\n\nhttps://www.animatetimes.com/tag/details.php?id=6762", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/34", "thumbnail_src": "https://si.imgix.net/2bdd82e8/uploads/origins/9aa2ae9b-578a-4560-b53f-319d7e884e18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f73c8d2f43a59a32f2f043797919002", "thumbnail_srcset": "https://si.imgix.net/2bdd82e8/uploads/origins/9aa2ae9b-578a-4560-b53f-319d7e884e18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f73c8d2f43a59a32f2f043797919002, https://si.imgix.net/2bdd82e8/uploads/origins/9aa2ae9b-578a-4560-b53f-319d7e884e18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0eb6faccddedca61411e69ea5be5b01 2x, https://si.imgix.net/2bdd82e8/uploads/origins/9aa2ae9b-578a-4560-b53f-319d7e884e18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=808cb017fc8742167a0fa302d4bd71d4 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nお腹にたっぷりお肉がついてしまった\nやすなのイラストを描いていただけないでしょうか。\n\n上半身はブラだけの\n着替えの最中のようなイメージで\n制服スカートのウエストゴムの上に\n乗ってしまった腹肉を掴んでおり\n口元は笑っているが焦っている表情で\nお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/33", "thumbnail_src": "https://si.imgix.net/69d7e1ce/uploads/origins/2593f6bf-4399-4759-a9ee-80048033a161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227965a13397f19fede03fe0dea259d3", "thumbnail_srcset": "https://si.imgix.net/69d7e1ce/uploads/origins/2593f6bf-4399-4759-a9ee-80048033a161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=227965a13397f19fede03fe0dea259d3, https://si.imgix.net/69d7e1ce/uploads/origins/2593f6bf-4399-4759-a9ee-80048033a161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af60722b0ee24e53f3d97f2d446bdba7 2x, https://si.imgix.net/69d7e1ce/uploads/origins/2593f6bf-4399-4759-a9ee-80048033a161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57d033ca1e501d104eeccb23f339778f 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\nやすなのヒップアタックの絵をお願いします！\n\nプリケツミサイルをお見舞いされる主観で、スカートの上に形が浮き出るほどのデカ尻にフォーカスしたイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/32", "thumbnail_src": "https://si.imgix.net/11e08cef/uploads/origins/6efbfd8c-3b77-46be-b207-2132af8cc9f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=412dcdc532bc993cd96258ccbf68e53a", "thumbnail_srcset": "https://si.imgix.net/11e08cef/uploads/origins/6efbfd8c-3b77-46be-b207-2132af8cc9f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=412dcdc532bc993cd96258ccbf68e53a, https://si.imgix.net/11e08cef/uploads/origins/6efbfd8c-3b77-46be-b207-2132af8cc9f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d72d5694870ecfc4db6da9e033059d09 2x, https://si.imgix.net/11e08cef/uploads/origins/6efbfd8c-3b77-46be-b207-2132af8cc9f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8805cd21e1a65cc3a91d36c39e7c9696 3x", "genre": "art", "nsfw": false, "body": "ややデフォルメ気味の鍵山雛ちゃんが、モップリンを笑顔で抱き抱えているイラストをお願いします。\n身体は向きは斜めで、顔はこちら側を向いている構図でお願いします。\n\n追伸：資料のURLが複数添付できるか分からなかったので、こちらの枠でも貼らせていただきます。\n\n\nデフォルメの程度は2023/7/10に投稿された、あぎりさんのイラストと同じくらいでお願いします\nhttps://x.com/jinnnouti_akira/status/1678393929069387776?s=46\n\n資料URLの欄に貼っているリンク先の動画では、モップリンが橙色になっておりますが、下記のwikiで使われている画像のように黄色で描いて頂けると嬉しいです。\n\nhttps://wikiwiki.jp/splatoon3mix/%E3%83%96%E3%82%AD/%E3%83%A2%E3%83%83%E3%83%97%E3%83%AA%E3%83%B3\n\nhttps://x.com/ucl265/status/1744403726855737667?s=46", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/31", "thumbnail_src": "https://si.imgix.net/ab08b445/uploads/origins/b2f1d354-8fb2-4b3c-836b-09e00944a506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=214e18e91ca02b5838122cf7203c4be8", "thumbnail_srcset": "https://si.imgix.net/ab08b445/uploads/origins/b2f1d354-8fb2-4b3c-836b-09e00944a506?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=214e18e91ca02b5838122cf7203c4be8, https://si.imgix.net/ab08b445/uploads/origins/b2f1d354-8fb2-4b3c-836b-09e00944a506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e2b2542c494f9c490cbf4ed9d7a4cd3 2x, https://si.imgix.net/ab08b445/uploads/origins/b2f1d354-8fb2-4b3c-836b-09e00944a506?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1931d9b0718696fca427e8b2e81bd35e 3x", "genre": "art", "nsfw": false, "body": "「競女!!!!!!!!」の「神無のぞみ」の体操服ブルマ姿をお願いします。\n体操服の襟・袖とブルマの色は紺を考えています。\n\nhttp://keijollllllll.com/chara/nozomi.html", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/30", "thumbnail_src": "https://si.imgix.net/3f611f4c/uploads/origins/ce753b89-5164-4945-b35c-566e6cd1e291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9327482c7cbd9f9bc5df0084b0f851d9", "thumbnail_srcset": "https://si.imgix.net/3f611f4c/uploads/origins/ce753b89-5164-4945-b35c-566e6cd1e291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9327482c7cbd9f9bc5df0084b0f851d9, https://si.imgix.net/3f611f4c/uploads/origins/ce753b89-5164-4945-b35c-566e6cd1e291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a33dac77d6ea6e8ae609f04ae85d84b 2x, https://si.imgix.net/3f611f4c/uploads/origins/ce753b89-5164-4945-b35c-566e6cd1e291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed10533434ac50666fda5a7e87d1874c 3x", "genre": "art", "nsfw": false, "body": "はじめまして、\n\nリクエストは\nキャラクターうちの子・陽夜子(資料参考)で、シチュエーションはオープンカフェでメロンクリームソーダのアイスクリームをスプーンですくって口に入れる瞬間、アイスクリームがスプーンから滑りテーブルに落ちてしまう\n\n表情、背景、構図、ポーズ、すべてお任せします。\n\n以上、宜しくお願いします\n\nhttps://twitter.com/barrel_sake2020/status/1527238709690503170", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/29", "thumbnail_src": "https://si.imgix.net/e02e4dfa/uploads/origins/edf4d6c0-32b7-4732-89dc-2e4a81fc32ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce350e7757eb2fcf313fbfbb3b3f559", "thumbnail_srcset": "https://si.imgix.net/e02e4dfa/uploads/origins/edf4d6c0-32b7-4732-89dc-2e4a81fc32ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce350e7757eb2fcf313fbfbb3b3f559, https://si.imgix.net/e02e4dfa/uploads/origins/edf4d6c0-32b7-4732-89dc-2e4a81fc32ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22e79c3e4ac77f3da020d0e9f328c0bb 2x, https://si.imgix.net/e02e4dfa/uploads/origins/edf4d6c0-32b7-4732-89dc-2e4a81fc32ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d75106ac6eafa3bc9150ec364717ffa2 3x", "genre": "art", "nsfw": true, "body": "訳が悪かったらごめんなさい\n\n私はあなたの作品が大好きで、素晴らしいスタイルだと思います。\n\n漫画に出てくる人魚のやすなをお願いしたいです。とてもかわいくて、触手にいじめられるところを見てみたいです。\n\nhttps://files.catbox.moe/9talwf.png", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/28", "thumbnail_src": "https://si.imgix.net/77662055/uploads/origins/90593366-6d04-4332-a044-a7e1bfd233cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9d720504cc7959fd53aeb392d45e35b", "thumbnail_srcset": "https://si.imgix.net/77662055/uploads/origins/90593366-6d04-4332-a044-a7e1bfd233cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9d720504cc7959fd53aeb392d45e35b, https://si.imgix.net/77662055/uploads/origins/90593366-6d04-4332-a044-a7e1bfd233cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a523c3924b4f7b7515ab84a0d53d7ed 2x, https://si.imgix.net/77662055/uploads/origins/90593366-6d04-4332-a044-a7e1bfd233cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bee426209589aa2c9ca9eefa3b9c233 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。\n大科学少女という作品の根古守というキャラクターのイラストをお願いします。\n\n制服の上にジャージを羽織っている\nおでこと太眉が特徴的な娘です。\n構図はお任せします。元気っ娘！という感じでお願いします。\n\n小柄だけど下半身の肉付きが良い\nお尻周りの大きい体型で描いていただけると\n嬉しいです！\n\nhttps://bookwalker.jp/de989be783-8c2c-4eb1-a176-2ae24bc2f46f/?adpcnt=7qM_SasK", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/27", "thumbnail_src": "https://si.imgix.net/3fd87d52/uploads/origins/1e6ac968-9337-4e95-b499-ee431691fc85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f332138661ba310cbcdde1611335d432", "thumbnail_srcset": "https://si.imgix.net/3fd87d52/uploads/origins/1e6ac968-9337-4e95-b499-ee431691fc85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f332138661ba310cbcdde1611335d432, https://si.imgix.net/3fd87d52/uploads/origins/1e6ac968-9337-4e95-b499-ee431691fc85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62a016d745d3205e47b40b440f4f2900 2x, https://si.imgix.net/3fd87d52/uploads/origins/1e6ac968-9337-4e95-b499-ee431691fc85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dae7bbb36631814af35b53171038553 3x", "genre": "art", "nsfw": false, "body": "『キルミーベイベー』と『ぼっち・ざ・ろっく！』のクロスオーバー的なイラストをお願いします。\n\n【人物】\nソーニャと虹夏\n\n【イラスト概要】\nお互いの衣服を交換して着ているソーニャと虹夏の姿\n\n2人のポーズや表情など、指定していないところは自由に描いていただいて構いません。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/26", "thumbnail_src": "https://si.imgix.net/a9dee681/uploads/origins/5f9899ce-b13f-4d15-b0cd-6c75dbcffd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce46ff1e95f6dce2a7f44a6fd6deda28", "thumbnail_srcset": "https://si.imgix.net/a9dee681/uploads/origins/5f9899ce-b13f-4d15-b0cd-6c75dbcffd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce46ff1e95f6dce2a7f44a6fd6deda28, https://si.imgix.net/a9dee681/uploads/origins/5f9899ce-b13f-4d15-b0cd-6c75dbcffd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb9dc44590a664e1d34aa154f2404558 2x, https://si.imgix.net/a9dee681/uploads/origins/5f9899ce-b13f-4d15-b0cd-6c75dbcffd0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b75a4e85a9da5cf8d6bda165676145c7 3x", "genre": "art", "nsfw": false, "body": "「GJ部」の「天使真央」の体操服ブルマ姿をお願いしたいと思います。\n体操服の襟と袖およびブルマの色は紺を考えています。\n\nhttps://livedoor.blogimg.jp/unlimitedblbewarks/imgs/b/e/be37cf83.jpg", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/25", "thumbnail_src": "https://si.imgix.net/360db470/uploads/origins/1d816856-c153-4d31-98fd-ab314bd004a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5236127583ed1167f002671ad613726", "thumbnail_srcset": "https://si.imgix.net/360db470/uploads/origins/1d816856-c153-4d31-98fd-ab314bd004a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5236127583ed1167f002671ad613726, https://si.imgix.net/360db470/uploads/origins/1d816856-c153-4d31-98fd-ab314bd004a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c222f2cdbfe4567a64166916eaf95fe7 2x, https://si.imgix.net/360db470/uploads/origins/1d816856-c153-4d31-98fd-ab314bd004a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49c33b0cbf3e8261df5003426088815a 3x", "genre": "art", "nsfw": false, "body": "2人のキャラクターで百合っぽいリクエストになるのですが\n「アクションヒロインチアフルーツ」の「城ヶ根御前」と「桃井はつり」のイラストをお願いしたいと思います。\n2人とも体操服ブルマ姿(作中の回想に出てくる中学校時代の体操服で襟と袖とブルマは黒。MADになりますが資料の2:53-2:57あたりに出てきます)で\n爆発とともにはつりが御前に向かって抱き着こうと飛びかかっているシチュエーションを考えています。\n\nhttps://www.nicovideo.jp/watch/sm32181790", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/24", "thumbnail_src": "https://si.imgix.net/fd039a6d/uploads/origins/886d8bd9-d149-4498-a1f5-fdbcb2bda12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e8980db695e27ddd3ff69dc03714fb", "thumbnail_srcset": "https://si.imgix.net/fd039a6d/uploads/origins/886d8bd9-d149-4498-a1f5-fdbcb2bda12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e8980db695e27ddd3ff69dc03714fb, https://si.imgix.net/fd039a6d/uploads/origins/886d8bd9-d149-4498-a1f5-fdbcb2bda12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f95eb18167d321d88a7d24fdad3e500f 2x, https://si.imgix.net/fd039a6d/uploads/origins/886d8bd9-d149-4498-a1f5-fdbcb2bda12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14735241c5e2fb1caab05afe5e83afe6 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nTwitterを拝見して仕事人シリーズが好きなようなので、１番気に入っている仕置シチュエーションをお願いします！\nキャラは仕事人以外でもかまいません。相手の有無は問いませんのでよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/23", "thumbnail_src": "https://si.imgix.net/b50df5ff/uploads/origins/16d3426f-91fa-46cd-8b88-de94224204ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4959840ca2137bc819014d5d44f2f3e", "thumbnail_srcset": "https://si.imgix.net/b50df5ff/uploads/origins/16d3426f-91fa-46cd-8b88-de94224204ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4959840ca2137bc819014d5d44f2f3e, https://si.imgix.net/b50df5ff/uploads/origins/16d3426f-91fa-46cd-8b88-de94224204ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc907f18685cbebf2c422a295f5db150 2x, https://si.imgix.net/b50df5ff/uploads/origins/16d3426f-91fa-46cd-8b88-de94224204ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=045f37e86b12de3134400e08c34400b2 3x", "genre": "art", "nsfw": false, "body": "「ゆゆ式」の「櫟井唯」ちゃんが体操服ブルマ姿でジャンプしてスパイクを打っているイラストをお願いしたいと思います。\n体操服の襟と袖およびブルマは紺色でジャンプしている唯ちゃんの真下に影を描いていただけると幸いです。\n\nhttps://lead-va.com/wp-content/uploads/2018/10/AdobeStock_119687044.jpeg", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/22", "thumbnail_src": "https://si.imgix.net/be59bfa9/uploads/origins/dab18a66-6c29-4b20-a554-e4b9a4a0cc63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01ec0d19e2ff087cc16fa86ea3ab8696", "thumbnail_srcset": "https://si.imgix.net/be59bfa9/uploads/origins/dab18a66-6c29-4b20-a554-e4b9a4a0cc63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01ec0d19e2ff087cc16fa86ea3ab8696, https://si.imgix.net/be59bfa9/uploads/origins/dab18a66-6c29-4b20-a554-e4b9a4a0cc63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ad6cc7ac2a6eba2379dc49a345ee8a6 2x, https://si.imgix.net/be59bfa9/uploads/origins/dab18a66-6c29-4b20-a554-e4b9a4a0cc63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f3a949fb314373b28ba75bcd5eafe8c 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/21", "thumbnail_src": "https://si.imgix.net/94cce95d/uploads/origins/8e11a4b6-d909-449f-8427-17d4275fa17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8813944fe34f6de8f52c740a8bd0a698", "thumbnail_srcset": "https://si.imgix.net/94cce95d/uploads/origins/8e11a4b6-d909-449f-8427-17d4275fa17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8813944fe34f6de8f52c740a8bd0a698, https://si.imgix.net/94cce95d/uploads/origins/8e11a4b6-d909-449f-8427-17d4275fa17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99551f7534b9bf21ed0f0da64e29040d 2x, https://si.imgix.net/94cce95d/uploads/origins/8e11a4b6-d909-449f-8427-17d4275fa17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3220dd788fc4d201e9aae45bcc4f57b8 3x", "genre": "art", "nsfw": true, "body": "Twitterのあぎやす絵が良くてリクエストさせていただきました。\n\n温泉旅館でやすなに夜這いをしかけるあぎりさんをお願いします。\nシチュエーションは\n普通に就寝についた二人\n目が覚めたあぎりが浴衣をはだけたやすなを目にする\nやすなは誘うためわざと下着をつけず寝たふりをしてる\nムラムラしたあぎりも浴衣をはだけ行為に及ぶ\n\n可能なら上記のストーリー風イラストまたは漫画\n時間がかかりそうならシチュエーションを考慮した貝合わせ同時絶頂をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/20", "thumbnail_src": "https://si.imgix.net/c671daa0/uploads/origins/47c19b93-d600-4c18-8cd9-2e1712d1c7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0627cb0ee83ac45a984c0b05aadb346b", "thumbnail_srcset": "https://si.imgix.net/c671daa0/uploads/origins/47c19b93-d600-4c18-8cd9-2e1712d1c7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0627cb0ee83ac45a984c0b05aadb346b, https://si.imgix.net/c671daa0/uploads/origins/47c19b93-d600-4c18-8cd9-2e1712d1c7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a26774e99031f10fe0c022286a1645db 2x, https://si.imgix.net/c671daa0/uploads/origins/47c19b93-d600-4c18-8cd9-2e1712d1c7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3577149fd18d9cd0db512f869db67508 3x", "genre": "art", "nsfw": true, "body": "初めまして！\n\nスクール水着姿で、トイレで座らされて気絶している河城にとりちゃんをリクエストさせて頂きます！\n\n突然気絶させられトイレに連れ込まれ、イタズラされる直前、みたいなイメージです。\n\nスク水は肩紐が白いタイプで、寝顔はギャグ調ではなく目を閉じて冷や汗や涙は無しで。\n帽子は無しでお願い致します。\n\n参考\n地味眼鏡ちゃんJS時代 | かずや@2日目東H-14a #pixiv https://www.pixiv.net/artworks/97870225\n\n承認いただける場合pngでの納品を希望致します。\n\nご検討いただければ幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/19", "thumbnail_src": "https://si.imgix.net/bab268d6/uploads/origins/099e0a6a-9adc-4eaf-baae-e4fc07148855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f8c8a0159e0f6bbe13e43295fc9a03", "thumbnail_srcset": "https://si.imgix.net/bab268d6/uploads/origins/099e0a6a-9adc-4eaf-baae-e4fc07148855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8f8c8a0159e0f6bbe13e43295fc9a03, https://si.imgix.net/bab268d6/uploads/origins/099e0a6a-9adc-4eaf-baae-e4fc07148855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e0bf668d6f3904f3ca3eeab8cd7db53 2x, https://si.imgix.net/bab268d6/uploads/origins/099e0a6a-9adc-4eaf-baae-e4fc07148855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9002ce8f26f59f85b840a9cb9c0a3c60 3x", "genre": "art", "nsfw": false, "body": "ぼざろの喜多ちゃんのイラストをお願いします。\n服装は以前に描かれたこちらのやすな（https://twitter.com/jinnnouti_akira/status/1659905424890675200）のような感じの体操着ブルマ姿でお願いしたいです。\nシチュや表情などはお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/18", "thumbnail_src": "https://si.imgix.net/af5ff50f/uploads/origins/7268680d-04e3-4be5-be9e-e22d29686835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ecc174f343187a5c2643cbcca79692", "thumbnail_srcset": "https://si.imgix.net/af5ff50f/uploads/origins/7268680d-04e3-4be5-be9e-e22d29686835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23ecc174f343187a5c2643cbcca79692, https://si.imgix.net/af5ff50f/uploads/origins/7268680d-04e3-4be5-be9e-e22d29686835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45eceb4e975c05fc13e2a4a5ba1f8752 2x, https://si.imgix.net/af5ff50f/uploads/origins/7268680d-04e3-4be5-be9e-e22d29686835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24ae3266d9b23ec3fd57367e09f7c887 3x", "genre": "art", "nsfw": false, "body": "「ぼっち・ざ・ろっく！」の喜多ちゃんがメイド服を着ているイラストをお願いします。\n掃除や料理や給仕などのメイドっぽい作業（内容はお任せします）をしているシチュエーションで描いていただけると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/17", "thumbnail_src": "https://si.imgix.net/23d1df73/uploads/origins/3649800b-78ce-462e-8c2d-269991bfe5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59f96ea330db66015ff6d21aa688b602", "thumbnail_srcset": "https://si.imgix.net/23d1df73/uploads/origins/3649800b-78ce-462e-8c2d-269991bfe5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59f96ea330db66015ff6d21aa688b602, https://si.imgix.net/23d1df73/uploads/origins/3649800b-78ce-462e-8c2d-269991bfe5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8a28a9eb0c9b55b9b72fad60218bddd 2x, https://si.imgix.net/23d1df73/uploads/origins/3649800b-78ce-462e-8c2d-269991bfe5fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f895b1dfbb725b4c3dc3c309e18e7e83 3x", "genre": "art", "nsfw": true, "body": "キルミーベイベーのソーニャちゃんをお願いします。\nあぐら縛りで拘束されている状態で、恥ずかしさと悔しさでにらみつけている感じの表情でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/16", "thumbnail_src": "https://si.imgix.net/ba66d386/uploads/origins/b72673d4-3b59-401c-a8ae-41ae0bad1ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e910c4880816c5e2f4d37d6850e69bfb", "thumbnail_srcset": "https://si.imgix.net/ba66d386/uploads/origins/b72673d4-3b59-401c-a8ae-41ae0bad1ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e910c4880816c5e2f4d37d6850e69bfb, https://si.imgix.net/ba66d386/uploads/origins/b72673d4-3b59-401c-a8ae-41ae0bad1ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d7d53b6b6db9d393d2535a5231c7461 2x, https://si.imgix.net/ba66d386/uploads/origins/b72673d4-3b59-401c-a8ae-41ae0bad1ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9ece908f06466ca9093fe980298ef22 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@jinnnouti_akira/works/15", "thumbnail_src": "https://si.imgix.net/2f50d6c8/uploads/origins/15c6fbb4-a5de-451f-9951-529380468f18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8f30a8a628805a0bb266a9bda0ca26a", "thumbnail_srcset": "https://s