df4313f3-17b6-48f2-9c85-06b118358292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dd04d46c14d3fe9830cac75a78fbf6e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@1341milky/works/89", "thumbnail_src": "https://si.imgix.net/02ebbb11/uploads/origins/a9d22fcc-f25f-430d-aef0-25b3d7ca7459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f2567e67bf765cf75f405f4b75d85f2", "thumbnail_srcset": "https://si.imgix.net/02ebbb11/uploads/origins/a9d22fcc-f25f-430d-aef0-25b3d7ca7459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f2567e67bf765cf75f405f4b75d85f2, https://si.imgix.net/02ebbb11/uploads/origins/a9d22fcc-f25f-430d-aef0-25b3d7ca7459?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd6fe6deb9e2950ffdcb315cbe386f58 2x, https://si.imgix.net/02ebbb11/uploads/origins/a9d22fcc-f25f-430d-aef0-25b3d7ca7459?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b334290afa76470cdeed32990c8c212 3x", "genre": "art", "nsfw": true, "body": "初リクエスト失礼致します\nシャニマスの樋口円香ちゃんの黒焦げアフロ化をお願いしてもよろしいでしょうか\n出来ればで大丈夫ですが元の髪型での黒焦げ差分もよろしくお願いします\n服装は以下のURLを参考にしていただければ幸いです\nhttps://imassc.gamedbs.jp/chara/show/21/prp261#google_vignette\n\nhttps://imassc.gamedbs.jp/chara/show/21/prp261#google_vignette", "created_at": "", "completed_at": ""}, {"path": "/@1341milky/works/88", "thumbnail_src": "https://si.imgix.net/c1d8ca98/uploads/origins/813a3a27-b5d5-4fc8-869b-df86b562172a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38baabd76c293636606d6ea4f62e0bed", "thumbnail_srcset": "https://si.imgix.net/c1d8ca98/uploads/origins/813a3a27-b5d5-4fc8-869b-df86b562172a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38baabd76c293636606d6ea4f62e0bed, https://si.imgix.net/c1d8ca98/uploads/origins/813a3a27-b5d5-4fc8-869b-df86b562172a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dbf8e8b07135b765b1f3e73c7d8980d 2x, https://si.imgix.net/c1d8ca98/uploads/origins/813a3a27-b5d5-4fc8-869b-df86b562172a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaa21826bab8c756a4f20d575674d42f 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n島村卯月のアフロ化をお願いします。\nシンデレラガールにも選ばれて、アイドルから次のステージとしてバラドルの道へ進むというイメージでお願いします。\n・衣装はエアロビ衣装で白タイツをお願いします。\n・お尻の大きさをより強調させてほしいです。\n・彼女の髪の長さでアフロ化すると、かなりのボリュームになると思うので、アフロもアレンジしてほしいです。\n・羞恥顔とやけくそな笑顔の差分をいただけると嬉しいです。\nご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@1341milky/works/87", "thumbnail_src": "https://si.imgix.net/ef0dd862/uploads/origins/c54da018-6631-43ab-ac05-e8840f130a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3578370e206b946e3993c91294d2eb21", "thumbnail_srcset": "https://si.imgix.net/ef0dd862/uploads/origins/c54da018-6631-43ab-ac05-e8840f130a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3578370e206b946e3993c91294d2eb21, https://si.imgix.net/ef0dd862/uploads/origins/c54da018-6631-43ab-ac05-e8840f130a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcbf4d6ca26098d2dec03ac083340f0a 2x, https://si.imgix.net/ef0dd862/uploads/origins/c54da018-6631-43ab-ac05-e8840f130a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e199853b8fd8e5bbfefd2c68f6779e24 3x", "genre": "art", "nsfw": true, "body": "ブルーアーカイブより氷室セナのアフロ化及び黒焦げ手前やられをお願いします。\n\nシチュエーション\n悪の組織を制圧するため敵のアジトに侵入した風紀委員会を援護するために後を追って侵入したセナがアジトの侵入者迎撃用トラップ(地雷)を踏んで大爆発に巻き込まれ、吹っ飛び、そのままアフロ化してガラスに張り付いて黒焦げ手前やられというシチュエーションでお願します\nこの描写は極力省いて頂いても構いません\n\nイラストの詳細なオーダー\n\n・ぶちゃいく顔\n・服は全て弾け飛び裸\n・陰毛が爆発でもさもさでまんまるのアフロの球体のようにになっている(イメージとしてはこのイラストの股間についているものhttps://x.com/1341milky/status/1932362607853555750?s=46&t=W9MVgi0cBosDbbVQNkI21g)\n・むぐぅ...といううめき声\n・可能ならこのイラスト(https://www.pixiv.net/artworks/96043810)のように目の差分をお願いします\nどちらか一つだけにするなら1枚目の目でお願いします\n・焦げなし差分はなくても構いません\n\nもし余裕があるならお願いしたいオーダー\n・侵入者迎撃用トラップがステージ2に移行し、壁に張りついているセナに向かって大量の粘着質の膜(イメージとしてはこのイラストのカミチヂレタケの胞子https://www.pixiv.net/artworks/112310661)が発射され、セナはそのままの姿勢で全身を包み込まれて拘束される\n・膜はガラスに張り付きセナは上記のイラストの3枚目のように締め付けながら拘束される(顔も上記のイラストのような締め付けられたようなぶちゃいく顔でお願いします)\n・セナはむご...！むぐぐ...！とうめき声を発しながらもがいている\n\n後半のシチュエーションはもしミるきーさんに余裕があれば描いて頂きたいです。\n初めての依頼なので内容に金額に見合った金額でなかったり伝わりにくい内容になっているかもしれませんが、どうかお願いします", "created_at": "", "completed_at": ""}, {"path": "/@1341milky/works/86", "thumbnail_src": "https://si.imgix.net/89789662/uploads/origins/5c7125ce-4557-4bbe-85e1-3725617dd57f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf3d4eb5fd90cb57f3a860f4b1a3007", "thumbnail_srcset": "https://si.imgix.net/89789662/uploads/origins/5c7125ce-4557-4bbe-85e1-3725617dd57f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9cf3d4eb5fd90cb57f3a860f4b1a3007, https://si.imgix.net/89789662/uploads/origins/5c7125ce-4557-4bbe-85e1-3725617dd57f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1476826937d885ab153afbc19e2f394 2x, https://si.imgix.net/89789662/uploads/origins/5c7125ce-4557-4bbe-85e1-3725617dd57f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce873abadde6424ee4d8603256ac2892 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@1341milky/works/85", "thumbnail_src": "https://si.imgix.net/51290486/uploads/origins/6d5b871d-e901-4ddf-b06a-bd7e78844d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20889f22a8cabc4079caa47dfe4b5757", "thumbnail_srcset": "https://si.imgix.net/51290486/uploads/origins/6d5b871d-e901-4ddf-b06a-bd7e78844d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20889f22a8cabc4079caa47dfe4b5757, https://si.imgix.net/51290486/uploads/origins/6d5b871d-e901-4ddf-b06a-bd7e78844d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30b05f132f9134e3f3aba38cd69a7ca5 2x, https://si.imgix.net/51290486/uploads/origins/6d5b871d-e901-4ddf-b06a-bd7e78844d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e4ae6e99baa115621ba7359d5ce0ec5 3x", "genre": "art", "nsfw": false, "body": "前回の続きでめぐみん達四人が再度アフロ光線をあびダソヌマリの弟子にされるリクエストをお願いします\n\n目の前にダソヌマリ(声だけ)がいて元に戻させるため攻撃するが\n即堕ち二コマの如くやられ弟子にされ、\n服装はお揃いのダソヌマリ衣装カラーゴーグル透けで装飾品も白とピンクカラーな色合い、髪色は元のままのと黒髪にされた差分をお願いします\nまた、二回撃たれたので前回よりも胸と身長を増してお願いします\n\nポーズ:https://jp.123rf.com/photo_67192879_%E9%99%8D%E9%9B%AA%E3%81%AE%E8%83%8C%E6%99%AF%E3%81%AB-4-%E4%BA%BA%E3%81%AE%E3%82%BB%E3%82%AF%E3%82%B7%E3%83%BC%E3%81%AA%E3%83%9D%E3%83%BC%E3%82%BA%E3%82%92%E3%81%A8%E3%82%8B%E5%A5%B3%E3%81%AE%E5%AD%90%E3%81%AE%E3%82%B7%E3%83%AB%E3%82%A8%E3%83%83%E3%83%88.html\n\n上記のポーズに中心前にめぐみんとゆんゆん、左右後ろにアクアダクネス\nアクアダクネスは多少見切れてよいのでキャラをつめて大きく書いて下さい\n\nサンプル\nア「元に戻せ！ゴッドブ」\nめ「ライトオブ」\nゆ「エクスプ」\nダ「ぶっ殺」\n\nめゆアダ「「「「ぶっちゃ毛！返り討ちに遭いマリ様の弟子された私達DESU!!」」」」\nダ「四人共これで完璧なぶっちゃ毛師だワ！」", "created_at": "", "completed_at": ""}, {"path": "/@1341milky/works/84", "thumbnail_src": "https://si.imgix.net/8c986974/uploads/origins/0b49e42c-83f0-4b01-9848-969461c9fa14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d20026da0efa7ca8c07f5b3735e421f1", "thumbnail_srcset": "https://si.imgix.net/8c986974/uploads/origins/0b49e42c-83f0-4b01-9848-969461c9fa14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d20026da0efa7ca8c07f5b3735e421f1, https://si.imgix.net/8c986974/uploads/origins/0b49e42c-83f0-4b01-9848-969461c9fa14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=047ffe8c48b07adecf32b01bf4576271 2x, https://si.imgix.net/8c986974/uploads/origins/0b49e42c-83f0-4b01-9848-969461c9fa14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=182cc167f81fa6389d35aeb125432062 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nブルアカの桐藤ナギサのアフロピエロ化をお願いします。\nボランティア活動の一環として、サーカスの興行のためにピエロに扮することになったナギサ。\n「少し恥ずかしいですが、トリニティの代表の一人として全うしてみせます。」\nピエロの恰好に恥ずかしさを感じながらも、なんとか活動を終わらせる。\n「最後にピエロ芸？そんなこと聞かされていませんが・・・っ！？」\n汗だくになって、長い髪を無理やり帽子に押し込んでいたため、\n帽子を脱いだ瞬間に髪の毛が爆発したかのように膨張して、アフロヘアーと化してしまう。\nあまりに突然の出来事と恥ずかしさに動転して、「最後に一言」と言われて突拍子もないことを口走ってしまう。\n「アフロピエロ☆ナギサでーす！って何言わせるんですか！？」\n・ピエロの衣装は、こちらの作者様のイラスト１枚目の右側のような、髪も全て包むようなデザインをお願いします。正式な名称が分からずすみません。（https://www.pixiv.net/artworks/56027833）\n・アフロ化前のピエロの姿とアフロ化したピエロの姿をご用意していただけると嬉しいです。\n長くなってしまい申し訳ないですが、ご検討をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@1341milky/works/83", "thumbnail_src": "https://si.imgix.net/a30395a9/uploads/origins/9b401dfe-7cd7-4636-818d-81f1d1b51e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8241aff144460108f6e0b01779eee98", "thumbnail_srcset": "https://si.imgix.net/a30395a9/uploads/origins/9b401dfe-7cd7-4636-818d-81f1d1b51e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8241aff144460108f6e0b01779eee98, https://si.imgix.net/a30395a9/uploads/origins/9b401dfe-7cd7-4636-818d-81f1d1b51e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07d6b87333afa8eecc147a250c07caa1 2x, https://si.imgix.net/a30395a9/uploads/origins/9b401dfe-7cd7-4636-818d-81f1d1b51e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=20