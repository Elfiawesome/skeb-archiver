8-86c4-4e52-8904-7b64b0587f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb85998a4907d4d92835c832b3eb93a2 2x, https://si.imgix.net/ad4a229f/uploads/origins/f7fa9898-86c4-4e52-8904-7b64b0587f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44fc460459ccd80fe6c6c4f277ae346d 3x", "genre": "art", "nsfw": true, "body": "やそきち様初めまして　この度はskeb依頼の件でご連絡に上がりました\n殿方の水着ライダーさんを拝見しましてskeb依頼させていただきます\n全裸のライダーさんをお願い致します\n下記リンクを参考にFate/hollow ataraxiaの水着ライダーのフィギュアと同じポージングでお願い致します　頭から足の爪先までの描写をお願い致します\nhttps://www.pixiv.net/artworks/87988676\nパイパンでお願い致します　可能であれば水着差分もお願い致します\n背景は無しで構いません\nご検討のほどよろしくお願い致します", "created_at": "", "completed_at": ""}, {"path": "/@80_KC_/works/4", "thumbnail_src": "https://si.imgix.net/1ff042ee/uploads/origins/f4b25a31-58f8-422d-8911-4ffe7e519dd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c39d8c5f0e4fcd59bb1869e1c80308aa", "thumbnail_srcset": "https://si.imgix.net/1ff042ee/uploads/origins/f4b25a31-58f8-422d-8911-4ffe7e519dd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c39d8c5f0e4fcd59bb1869e1c80308aa, https://si.imgix.net/1ff042ee/uploads/origins/f4b25a31-58f8-422d-8911-4ffe7e519dd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6fce79973c3506d8a76ff46c5547dd1 2x, https://si.imgix.net/1ff042ee/uploads/origins/f4b25a31-58f8-422d-8911-4ffe7e519dd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa4c0914545257804decae3d5f712eee 3x", "genre": "art", "nsfw": true, "body": "やそきちさんはじめまして、こんにちは！！\n\nうちのこ、杏ちゃんのイラストをおねがいいたします！！\n資料\n→https://twitter.com/emyayuzu225/status/1571134517737562113\n\n服装や服装ポーズ構図はすべておまかせでおねがいいたします！\n\n以上になります！！よろしくおねがいします！！！！！！", "created_at": "", "completed_at": ""}, {"path": "/@80_KC_/works/3", "thumbnail_src": "https://si.imgix.net/19244ac8/uploads/origins/154645e6-c1e6-4618-ac5b-2212fe4b4580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44291d5f0c76b4e51e1031dabe8a3827", "thumbnail_srcset": "https://si.imgix.net/19244ac8/uploads/origins/154645e6-c1e6-4618-ac5b-2212fe4b4580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44291d5f0c76b4e51e1031dabe8a3827, https://si.imgix.net/19244ac8/uploads/origins/154645e6-c1e6-4618-ac5b-2212fe4b4580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14c4bf3a69d95c1cfb4fed045c6b4dc5 2x, https://si.imgix.net/19244ac8/uploads/origins/154645e6-c1e6-4618-ac5b-2212fe4b4580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=474e66520481916bfa021f7b17307dae 3x", "genre": "art", "nsfw": true, "body": "ブルーアーカイブの十六夜ノノミのNSFWイラストをリクエストさせてください。\n\n希望のシチュエーションは、制服姿で、\n先に発表されているFGOカレン（https://www.pixiv.net/artworks/89908050）のように\nベッドに横臥しておしりをこちらに向けていて、\nスカートは履いたまま捲り上げられてパンツを下ろされ、\nパートナーの先生から手マンされて膣内のGスポットを弄られてイかされています。\n（Gスポットを弄っていると分かる手つきの描写をお願いします）\n\nノノミはカメラ目線ではなく、感じ過ぎてシーツや枕に突っ伏しているか仰け反っている表現を希望です。\nまた、股間部分のシーツが潮吹きや愛液で濡れて染みになっていると嬉しいです。\n先生の描写は手指のみで構いません。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@80_KC_/works/2", "thumbnail_src": "https://si.imgix.net/c6231ea0/uploads/origins/52b20ae9-1724-48bb-853e-62ad377676c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c13065f5c9242576bec9bc1bb13b4dba", "thumbnail_srcset": "https://si.imgix.net/c6231ea0/uploads/origins/52b20ae9-1724-48bb-853e-62ad377676c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c13065f5c9242576bec9bc1bb13b4dba, https://si.imgix.net/c6231ea0/uploads/origins/52b20ae9-1724-48bb-853e-62ad377676c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52eec0c0f7a1e7416fac3f9f0b4caf22 2x, https://si.imgix.net/c6231ea0/uploads/origins/52b20ae9-1724-48bb-853e-62ad377676c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8b05321d563d406d6f63a91f9c31d87 3x", "genre": "art", "nsfw": false, "body": "