になっております。\n\n今回、人外女攻め×男受けの成人向けイラストを描いていただきたく、リクエストをさせていただきました。\n\n構図やシチュエーションはすべてお任せしたいと考えております。\n\n資料内の女性（アイカ）をななっとぅー様の裁量で人外化してください。\nななっとぅー様が手掛けている「クトゥルフ神話生物素材集01」の、「シャッガイからの昆虫」のような要素が含まれているとうれしいです。\n彼女の水色の目も、このような鮮やかな青に変更していただいて構いません。\n\n料金の不足や資料に問題がありましたら、お手数ですが再送要請を送っていただけると助かります\n\nhttps://drive.google.com/drive/folders/1DtWA_bXOJdm9dugqnm0HH0EYuiWBiH1d?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@suzunana0730/works/41", "thumbnail_src": "https://si.imgix.net/5f6a9582/uploads/origins/09fefa68-851d-4166-a480-1aea52a6ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a47e58d4139232ac0546a2966f4d901d", "thumbnail_srcset": "https://si.imgix.net/5f6a9582/uploads/origins/09fefa68-851d-4166-a480-1aea52a6ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a47e58d4139232ac0546a2966f4d901d, https://si.imgix.net/5f6a9582/uploads/origins/09fefa68-851d-4166-a480-1aea52a6ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fff7008f97b28bc43f078dee96cef4c4 2x, https://si.imgix.net/5f6a9582/uploads/origins/09fefa68-851d-4166-a480-1aea52a6ec4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6875f59dad77b335071de8347bfe7745 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@suzunana0730/works/40", "thumbnail_src": "https://si.imgix.net/100d9fcd/uploads/origins/d3249558-0092-4d6b-80e1-785392ffae54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=482f1421c41f55da91d7f678e5dc5f09", "thumbnail_srcset": "https://si