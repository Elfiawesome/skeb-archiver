-60c9-4e44-acfd-5775c2889405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e85046e303cd2b78b178feae0b83e5c5", "thumbnail_srcset": "https://si.imgix.net/edfb8087/uploads/origins/22954c28-60c9-4e44-acfd-5775c2889405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e85046e303cd2b78b178feae0b83e5c5, https://si.imgix.net/edfb8087/uploads/origins/22954c28-60c9-4e44-acfd-5775c2889405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bd0ccb8625aa0f0c3c2ba551934c408 2x, https://si.imgix.net/edfb8087/uploads/origins/22954c28-60c9-4e44-acfd-5775c2889405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=002ad4444533d635a8c8cd036e39958a 3x", "genre": "art", "nsfw": true, "body": "こんにちは！ 以下のことをお願いしたいのですが\n\n師匠と見習い！ マーベルヒロイン2人がヌードに！\n\nキャロル・ダンバースとカマラ・カーンは裸で並んで立っています。カマラ・カーンは新人なので、小柄な身長、小さな膨らんだ胸と茶色の乳輪、そして初期の陰毛を持っています。\n一方、キャロル・ダンバース は背が高く、ピンク色の乳首が目立つ大きな胸と平均的な陰毛を持っています。\n(この高さのコントラストにより、カマラ・カーン の顔が キャロル・ダンバース の乳首に接触しそうになります!)\nキャロル・ダンバース は自信に満ちた笑顔、カマラ・カーン は緊張した笑顔を浮かべています。\n\n参考資料\nhttps://imgur.com/a/hDpipSz\n\n参考ポーズ\nhttps://imgur.com/N13lgSJ", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/41", "thumbnail_src": "https://si.imgix.net/3ba9654c/uploads/origins/fe70b2e0-932a-411c-aa1b-3169ca195de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cffc09384ad80099f3628609f83f5b85", "thumbnail_srcset": "https://si.imgix.net/3ba9654c/uploads/origins/fe70b2e0-932a-411c-aa1b-3169ca195de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cffc09384ad80099f3628609f83f5b85, https://si.imgix.net/3ba9654c/uploads/origins/fe70b2e0-932a-411c-aa1b-3169ca195de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5298b66258797f0ebfbc64772f166829 2x, https://si.imgix.net/3ba9654c/uploads/origins/fe70b2e0-932a-411c-aa1b-3169ca195de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd5d4ee123e1f084174c4655f49b51ff 3x", "genre": "art", "nsfw": true, "body": "やまG🔞様\nはじめまして。\n匿名にて失礼します。\n以下のリクエスト内容で二枚お願い致します。\n\nキャラ\nジャバ・ザ・ハット\nうる星やつら・ラム\n\n①ジャバ・ザ・ハットにバックから犯されるラム。\n全裸で四つん這い、首輪と鎖。\n\n②ジャバ・ザ・ハットの前で寝そべるラム。\nレイア姫の衣装(ブラのみ)\n臨月、ラムは不貞腐れた表情。\n\nその他細部はお任せします。\n何卒宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/40", "thumbnail_src": "https://si.imgix.net/4c869622/uploads/origins/6ff40d37-3601-48d8-9dc1-d1becb40d265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ee2dd27ebf75ce04756e5a2dd710cb9", "thumbnail_srcset": "https://si.imgix.net/4c869622/uploads/origins/6ff40d37-3601-48d8-9dc1-d1becb40d265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ee2dd27ebf75ce04756e5a2dd710cb9, https://si.imgix.net/4c869622/uploads/origins/6ff40d37-3601-48d8-9dc1-d1becb40d265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ed5a048c30566a18ed1a2399198ea4c 2x, https://si.imgix.net/4c869622/uploads/origins/6ff40d37-3601-48d8-9dc1-d1becb40d265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e40ed70a99591586920a12014767fbf9 3x", "genre": "art", "nsfw": true, "body": "異種姦即落ち2コマ風イラストをお願いしたいと思いました。\n(参考URL https://skeb.jp/@infinityspoon/works/38)\n詳細は以下の通りです。\n\n◇キャラクター\n①オリジナルキャラ、村の妻達2名\n(人間、色白、巨乳、髪の長さ胸元までのロング、髪型ポニーテールやハーフアップ 、髪色は何でもOK、着物)\n妻参考\nhttps://www.pixiv.net/artworks/97951240\n先生の描きたいキャラを描いてください。\n\n②大猿\n参考イメージ\nhttps://skeb.jp/@infinityspoon/works/38\n\n◇シチュエーション\nシーン1\n朝、村の近くに現れた大猿の群れを退治するために出撃する村の青年団を、\n心配そうに見送る妻達\n※青年と妻の会話お願いします\n   例)妻「無事に帰ってきてね・・・」青年「あぁ、もちろんさ」\n※青年のイラストは不要です\n※背景は青空など、簡単なものでOKです\n\nシーン2\n夜、村の集会所で繰り広げられる\n妻達と大猿達との全裸汗だく交尾(妻:猿=1:1の比率)\n\n大猿の群れに敗れ、瀕死の状態で村に辿り着いた青年団\n彼らが最後に見たのは、妻達と大猿が夢中で交尾している光景だった・・・\n\n・シーン2イメージ\n①体位参考、フェラチオされている竿役がおらず、大猿達が青年団に見せつけているイメージ\nhttps://skeb.jp/@sirano65494554/works/60\n②大猿は下卑た表情で交尾を堪能中\n③何度も交尾した後、精液まみれ、股の間から精液が零れ落ちている\n④妻は正気ではない目(ハイライト無し、又は目の色が変わるなど)\n⑤妻は完全に快楽堕ち、恍惚とした表情\n⑥大猿は下種な感じで描いて下さい\n⑦周囲は交尾の熱気でムワッとしている\n⑧夜中の室内、薄暗い\n⑨大猿の全身や顔が必ずしも映る必要はありません、シチュエーション重視です\n    毛むくじゃらの胴体と腕だけ、でもOKです。\n⑩大猿は2匹\n\n・シーン2衣装\n全裸、汗だく、結われていた髪が全てほどかれている状態\n\n・その他\n①まだ妊娠していない状態、非ボテ腹\n③シーン2の妻の目は正気じゃない目(ハイライト無しや、瞳の色が変わるなど)\n\n以上、詳細です。\n\n価格設定について問題ありましたら、条件付きの再送依頼頂けると助かります。", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/39", "thumbnail_src": "https://si.imgix.net/649ed6b0/uploads/origins/306be97b-0751-42d8-97ec-2360e652e480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=900f63acb5f3137184e365b924177395", "thumbnail_srcset": "https://si.imgix.net/649ed6b0/uploads/origins/306be97b-0751-42d8-97ec-2360e652e480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=900f63acb5f3137184e365b924177395, https://si.imgix.net/649ed6b0/uploads/origins/306be97b-0751-42d8-97ec-2360e652e480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ef52e0bd1e87e14559e62775098f293 2x, https://si.imgix.net/649ed6b0/uploads/origins/306be97b-0751-42d8-97ec-2360e652e480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8933eddbdfbb00be6d1b301d44c85f63 3x", "genre": "art", "nsfw": true, "body": "こんにちは、僕のオリジナルキャラクターを描いてほしいんだ。ビジュアルの参考リンクはこちらです。\nhttps://www.notion.so/tacocatpatron/Autumn-ee9b273eea5d459ebaf3ccc2949f6010\nこれらの絵と同じようなシチュエーションとポーズで。\nhttps://skeb.jp/@yamajee_illust/works/33\nhttps://skeb.jp/@yamajee_illust/works/20", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/38", "thumbnail_src": "https://si.imgix.net/8e4d354b/uploads/origins/4f90b87d-606d-4f7f-8b9b-966607721dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93a18fa9f38bf7c915619bf9a07c2341", "thumbnail_srcset": "https://si.imgix.net/8e4d354b/uploads/origins/4f90b87d-606d-4f7f-8b9b-966607721dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93a18fa9f38bf7c915619bf9a07c2341, https://si.imgix.net/8e4d354b/uploads/origins/4f90b87d-606d-4f7f-8b9b-966607721dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2bdeef5b63c99bb977e7f2d45c6ad230 2x, https://si.imgix.net/8e4d354b/uploads/origins/4f90b87d-606d-4f7f-8b9b-966607721dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca79bd84dca61a97b7e05ca02469a9b9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/37", "thumbnail_src": "https://si.imgix.net/da96f3ef/uploads/origins/dfba4cf7-8871-44bd-91ac-deeb45cfc186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22242ab78495f9a0421eef26d95c3d93", "thumbnail_srcset": "https://si.imgix.net/da96f3ef/uploads/origins/dfba4cf7-8871-44bd-91ac-deeb45cfc186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22242ab78495f9a0421eef26d95c3d93, https://si.imgix.net/da96f3ef/uploads/origins/dfba4cf7-8871-44bd-91ac-deeb45cfc186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4342dab9bc13012bcc02f1ba95acef3d 2x, https://si.imgix.net/da96f3ef/uploads/origins/dfba4cf7-8871-44bd-91ac-deeb45cfc186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25347507dfec0afc5c22c9d8bb763ccd 3x", "genre": "art", "nsfw": true, "body": "こんにちは。お願いをしたいと思います。頭からつま先まで全身イラストを描いてください。\n\n彼女の裸を描いてください:\nhttps://gamepress.gg/grandorder/sites/grandorder/files/2018-04/1811.jpg\n\nこのポーズで横たわっている彼女を描いてもらいます:\nhttps://imgur.com/a/LqxCkv1\n彼女の顔が見えるはずです。\n\n彼女の目は半分開いていますが空っぽで、口はわずかに開いています。頭から足まで全身にザーメンをかけられます。彼女の膣からは精液が漏れ出し、彼女の下に小さな水たまりが形成されています。口からも精液が垂れてきます。\n\n彼女はベッドの中央に横たわっています。\n\nお時間をいただきありがとうございます。", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/36", "thumbnail_src": "https://si.imgix.net/71cbfc69/uploads/origins/aca489ec-a28f-4fac-8398-0c0d7e01c57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef55b535c183edd0c23d9f970e3df19", "thumbnail_srcset": "https://si.imgix.net/71cbfc69/uploads/origins/aca489ec-a28f-4fac-8398-0c0d7e01c57d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef55b535c183edd0c23d9f970e3df19, https://si.imgix.net/71cbfc69/uploads/origins/aca489ec-a28f-4fac-8398-0c0d7e01c57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=114e0bedc653b763012f138a3a318f9f 2x, https://si.imgix.net/71cbfc69/uploads/origins/aca489ec-a28f-4fac-8398-0c0d7e01c57d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=464bc8b3150c46902390aa05acbd5ad6 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n\nイラストの依頼をさせて頂きたいのですが如何でしょうか？\n\nclosersという作品（ゲーム）の、\nバイオレット（見習隊員衣装）というキャラクターをお願いしたいです。\n\n脇と横乳が特徴的で高飛車なキャラクターです。\n戦闘による衣服破損で胸元を片腕で隠しているようなポーズでお願い致します。\n\n資料はこちらになります。\n\nhttps://www.google.com/search?q=closers+%E3%83%90%E3%82%A4%E3%82%AA%E3%83%AC%E3%83%83%E3%83%88&tbm=isch&ved=2ahUKEwiQ1KHs2YaAAxWssVYBHbduA-4Q2-cCegQIABAA&oq=closers+%E3%83%90%E3%82%A4%E3%82%AA%E3%83%AC%E3%83%83%E3%83%88&gs_lcp=CgNpbWcQAzIECCMQJzIECCMQJzoFC", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/35", "thumbnail_src": "https://si.imgix.net/10857fb9/uploads/origins/1df29e29-bf44-47b0-96ce-af7b4ba90eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=382a49852f59bb6eebf2e49c453902f0", "thumbnail_srcset": "https://si.imgix.net/10857fb9/uploads/origins/1df29e29-bf44-47b0-96ce-af7b4ba90eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=382a49852f59bb6eebf2e49c453902f0, https://si.imgix.net/10857fb9/uploads/origins/1df29e29-bf44-47b0-96ce-af7b4ba90eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90ece4518e448ae40d1333141871ee08 2x, https://si.imgix.net/10857fb9/uploads/origins/1df29e29-bf44-47b0-96ce-af7b4ba90eb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adba9bbf2f19134d70c820ce74f44629 3x", "genre": "art", "nsfw": true, "body": "はじめまして\n\n映画『スターウォーズジェダイの帰還』で、ジャバ・ザ・ハットに囚われ踊り子衣装を着せられたレイア姫のエロ絵をお願いします。\n\n・レイア姫の体型はスレンダーな感じで、程よく美乳なおっぱいでお願いします。(映画と同じような体型)\n・へそやウエストのラインなどお腹が良く見えるアングルでお願いします。\n・やまＧ様が多く描かれてるように、へそは丸くて中身が見えるようなデザインお願いします。へそのしわもあると嬉しいです。\n・腹ボコはしないでください\n・場所はジャバのアジト。簡単に雰囲気が分かれば大丈夫です。\n・鎖で金属の首輪に繋がれてジャバとセックスをさせられています\n・玉座でジャバの上に乗せられて、ジャバの体内からでたペニスを挿入されています。\n・ジャバが鎖を短く握っています\n・ジャバは部分的に描かれていればOKです\n・ブラが上にずれて乳首が見えています(最低片方でOKです。ブラの素材が金属であることも意識してください\n・目は開けた状態で嫌悪感をあらわにしています。首輪が苦しそうですが、顔は赤くしないようにしてください。\n・口紅はなしでお願いします。薄い色の唇はOKです\n・前垂れを生かして脚を強調できると良いです(難しそうなのでお任せします)\n・鼠蹊部が見えるように\n・全裸で中出しされ泣いている差分(両目空いてます)もお願いします。陰毛あり。\n・漫画絵の参考も用意しましたが、やまＧ様絵柄で可愛く描いていただければと思います。\n\nご検討よろしくお願いします。\n\n漫画絵参考\n\nhttps://www.budsartbooks.com/product/star-wars-the-legends-of-luke-skywalker-the-manga/\n\nhttps://www.starwars.com/news/leia-princess-of-alderaan-manga-exclusive-preview\n\n体位参考\n\nhttps://otakusexart.com/2021/04/08/8-4-2021-princess-leia-loves-jabba/\n\nhttps://twitter.com/meemobonete/status/1624114216293527552?s=12&t=9o0_ke27\n\nhttps://jabbaleia.webs.com/apps/photos/album?albumid=15543486", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/34", "thumbnail_src": "https://si.imgix.net/774c608e/uploads/origins/6823278b-59aa-4390-835e-a835efdb3c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84bb92dbab7cb94ef896859ec8f58395", "thumbnail_srcset": "https://si.imgix.net/774c608e/uploads/origins/6823278b-59aa-4390-835e-a835efdb3c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84bb92dbab7cb94ef896859ec8f58395, https://si.imgix.net/774c608e/uploads/origins/6823278b-59aa-4390-835e-a835efdb3c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9abc4792e72a813bf24cbaa985872b3f 2x, https://si.imgix.net/774c608e/uploads/origins/6823278b-59aa-4390-835e-a835efdb3c3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2607d393261c04cbfdd9205e79d7a91 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼致します。\n\nFGOから宇津見エリセでイラストをお願いします。\n\n服装は水着の第一再臨で、エリセは、上に着ているラッシュガード的なシャツを自分の口で咥えながらたくしあげて、胴体を全開にしており、ドキドキした表情で誘っている感じでお願いします。\n\nブラは着けておらず、おっぱいを曝け出している。下に履いているホットパンツはずり下げて、股を露わにしており、陰毛が見えてる感じでお願いします。\n\nそして、両手はお腹に当てていて、おへそを中心としたハートの形を作っている描写をお願いします。\n\n大体こんな感じのイラストを差し支えなければお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/33", "thumbnail_src": "https://si.imgix.net/1b985bff/uploads/origins/51b8f088-e058-4906-b539-d05505d15286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb214915eaa974f7580723e12cc28d8", "thumbnail_srcset": "https://si.imgix.net/1b985bff/uploads/origins/51b8f088-e058-4906-b539-d05505d15286?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb214915eaa974f7580723e12cc28d8, https://si.imgix.net/1b985bff/uploads/origins/51b8f088-e058-4906-b539-d05505d15286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=149cd0d605471a345f582335b572748e 2x, https://si.imgix.net/1b985bff/uploads/origins/51b8f088-e058-4906-b539-d05505d15286?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=206d897e54893a92b609400e02272f26 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております\nこの度はイラストのリクエストをさせていただきたく...\nキャラクターはうちの子クレールで\nシチュエーションとしては正常位で中出しされた後の事後シチュで、出された精液が大量にゴボリと溢れ出るシーンをお願いしたいです\n\n服装は全裸、陰毛多めでお願いしたく\n表情は激しくイカされたあとの放心しているようなイメージでお願いしたく\n\nご検討のほどお願いいたします。\n\nhttps://www.pixiv.net/artworks/86057203", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/32", "thumbnail_src": "https://si.imgix.net/7433f2da/uploads/origins/879a93b3-6094-40aa-bea6-6b7cfde68649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207907fa9be8162e15d61aef5360dd06", "thumbnail_srcset": "https://si.imgix.net/7433f2da/uploads/origins/879a93b3-6094-40aa-bea6-6b7cfde68649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207907fa9be8162e15d61aef5360dd06, https://si.imgix.net/7433f2da/uploads/origins/879a93b3-6094-40aa-bea6-6b7cfde68649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87cbafc212d25830f827237a66cffbc8 2x, https://si.imgix.net/7433f2da/uploads/origins/879a93b3-6094-40aa-bea6-6b7cfde68649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=520fbe549eebe6ea122aa0c2a7d79820 3x", "genre": "art", "nsfw": true, "body": "初めまして、素敵な絵柄だったので依頼を出させていただきました。\n「アークナイツ」のロサのエッチなイラストを描いていただきたいです。\nロサ：https://imgur.com/a/Ox9M5OQ\n\n騎乗位で逆レイプをしているようなイラストをお願いしたいです。\nハメ撮り視点で、覆いかぶさって逃さないようにしている感じで\n表情は病んだ笑みを浮かべています。\n服装は裸で陰毛有り、汗だくで蒸気が出ており蒸れ蒸れな感じで\n体型は描かれているfgoのバーゲストのような感じでお願いしたいです。\n可能であれば中出し差分もお願いしたいです。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/31", "thumbnail_src": "https://si.imgix.net/9f12f78f/uploads/origins/52e747e8-aa2d-4712-93ca-455ebe20d3be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87315b12800689ca47dd654d8e977685", "thumbnail_srcset": "https://si.imgix.net/9f12f78f/uploads/origins/52e747e8-aa2d-4712-93ca-455ebe20d3be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87315b12800689ca47dd654d8e977685, https://si.imgix.net/9f12f78f/uploads/origins/52e747e8-aa2d-4712-93ca-455ebe20d3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d975eea17567d859da12ce5da17ffcd1 2x, https://si.imgix.net/9f12f78f/uploads/origins/52e747e8-aa2d-4712-93ca-455ebe20d3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b5002c8ffe993d389f9f24efdcc5ca4 3x", "genre": "art", "nsfw": true, "body": "御城プロジェクトRE\n．首里城と玉城城の二人がレイプされる\n．オームでベロチュしたりたちバックしておっぱいを揉まれる\n．全身ぶっかけ表現アリ\n．二人の下着が落ちていて全裸でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/30", "thumbnail_src": "https://si.imgix.net/5f333a2a/uploads/origins/8c7fd1b9-de1d-4dba-a861-9452df96db51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f9f87edf6959fefb7e80047eb5a039", "thumbnail_srcset": "https://si.imgix.net/5f333a2a/uploads/origins/8c7fd1b9-de1d-4dba-a861-9452df96db51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f9f87edf6959fefb7e80047eb5a039, https://si.imgix.net/5f333a2a/uploads/origins/8c7fd1b9-de1d-4dba-a861-9452df96db51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d56d7577dfe497164af5046b6ccd6fb 2x, https://si.imgix.net/5f333a2a/uploads/origins/8c7fd1b9-de1d-4dba-a861-9452df96db51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd4d5898b4969e05eba87c30997f2311 3x", "genre": "art", "nsfw": true, "body": "こんにちは、私のリクエストを読んでいただきありがとうございます。\n\n私が選んだキャラクターは、ゲーム「アークナイツ」の「寧慈秋」です。参考文献はこちらです。\nhttps://drive.google.com/file/d/15sjFpwnQuwzqYHnkoL5-bPAwpT9BzzEU/view?usp=share_link\n\n- そのリンクの中にポーズが添付されています。写真は男目線です。\n- 彼女の服装はかなり複雑です。小物以外、全裸にすることもできます。必要であれば、彼女の服は近くに捨ててもらっても構いません。\n- 乳首とアソコは丸見えでなければなりません。服やキャラクターの手足で遮ることはできません。\n- 乳房は平均的か小さいようです。\n- 乳首は大きめで、くっきりしたものを希望します。また、クリトリスのフードも非常に大きいものを希望します。どちらも参考資料があります。\n- 性的な雰囲気は、愛情深く、情熱的であるべきです。ただし、目に見える息づかいは入れないでください。汗は最小限にとどめてください。\n- 陰毛は入れないでください。\n- 寧は小さくても情熱的な微笑みを浮かべてください。彼女は見る人の目を見ているはずです。\n\nありがとうございました。私のリクエストを受け入れてくれることを願っています。", "created_at": "", "completed_at": ""}, {"path": "/@yamajee_illust/works/29", "thumbnail_src": "https://si.imgix.net/71e923fa/uploads/origins/91312d3e-eaf7-466e-9cf3-f08583d10505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63dd9fd2e8e8a4f7a1ff20280da5a672", "thumbnail_srcset": "https://si.imgix.net/71e923fa/uploads/origins/91312d3e-eaf