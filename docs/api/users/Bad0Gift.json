3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa1d6216d5e6e51a99e7d4721760b609, https://si.imgix.net/7f499be0/uploads/origins/2aaa98a6-7a31-42c3-af08-20c9a4145e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f68647df3dc1e36f1f0c8c5ac8b84f01 2x, https://si.imgix.net/7f499be0/uploads/origins/2aaa98a6-7a31-42c3-af08-20c9a4145e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf1b10bb2fb6ca87ebcddfb8767753b7 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します\n\nキャラ\nケロロ軍曹より日向夏美(パワード夏美)\n\nシチュエーション\nコズミックマリオネーションに掛けられて、激痛で苦悶と絶望の表情\n\nコズミックマリオネーションがどういう技かは\nhttps://dic.pixiv.net/a/%E3%83%9F%E3%83%BC%E3%83%8E%E3%82%B9\n(イラストの描写として骨折している表現は不要です)\n\nコズミックマリオネーションの描写は下記URLの27:38からを参考にして下さい\nhttps://m.youtube.com/watch?v=5w9E-fht0RA&pp=ygUh44K944Or44K444Oj44O844K644K944Km44Or44CAYmJh\n\n表情はお任せしますが、目の描写は\nhttps://drive.google.com/drive/folders/1DNlQ2NLQphM_1-3oCUSJsoF30hSfWY5p\nのような感じでお願いします\n\n構図やアングル、それっぽい台詞を入れる等はお任せ致します\n\nリクエスト可能であればよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@Bad0Gift/works/212", "thumbnail_src": "https://si.imgix.net/078ad5f2/uploads/origins/74d5ca7e-b32c-4774-9116-67632c4ccfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e4bfb4a173d939132d3811c82f05a7", "thumbnail_srcset": "https://si.imgix.net/078ad5f2/uploads/origins/74d5ca7e-b32c-4774-9116-67632c4ccfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55e4bfb4a173d939132d3811c82f05a7, https://si.imgix.net/078ad5f2/uploads/origins/74d5ca7e-b32c-4774-9116-67632c4ccfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10af72f419723379f174d942eba90ca2 2x, https://si.imgix.net/078ad5f2/uploads/origins/74d5ca7e-b32c-4774-9116-67632c4ccfe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=beaecad9de4fda3ee8d0650d7646148b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！突然フォロー失礼します。ゼルダの伝説の、ボスの水のモルファが、好きな女性キャラを掴んでくるくる回るスケッチを一色で描いてくれませんか？", "created_at": "", "completed_at": ""}, {"path": "/@Bad0Gift/works/211", "thumbnail_src": "https://si.imgix.net/8c2365c9/uploads/origins/1eaa53d4-f0f3-43fb-8d5d-046ba546fc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554d82d218ec712d34f26452e6028ab2", "thumbnail_srcset": "https://si.imgix.net/8c2365c9/uploads/origins/1eaa53d4-f0f3-43fb-8d5d-046ba546fc55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554d82d218ec712d34f26452e6028ab2, https://si.imgix.net/8c2365c9/uploads/origins/1eaa53d4-f0f3-43fb-8d5d-046ba546fc55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdb664a356a55edee39ed67d98777684 2x, https://si.imgix.net/8c2365c9/uploads/origins/1eaa53d4-f0f3-43fb-8d5d-046ba546fc55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b9ff794ddcd1d8030a28208d889324b 3x", "genre": "art", "nsfw": true, "body": "お忙しい中、すみません。次のリクエストお願いします。以前お願いした、アニメのラブリっちをお願いします。\nラブリっちが、人食い花の触手に捕まって顔を赤らめて口を開けてピンチになっている姿をお願いできないでしょうか？", "created_at": "", "completed_at": ""}, {"path": "/@Bad0Gift/works/210", "thumbnail_src": "https://si.imgix.net/03aac832/uploads/origins/aeee8115-fbd6-474d-84ef-945cc3386be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aadf1380c1f136700e77ffba934c2294", "thumbnail_srcset": "https://si.imgix.net/03aac832/uploads/origins/aeee8115-fbd6-474d-84ef-945cc3386be6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aadf1380c1f136700e77ffba934c2294, https://si.imgix.net/03aac832/uploads/origins/aeee8115-fbd6-474d-84ef-945cc3386be6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9601094bdf7bc7eb2533a9d455f8471d 2x, https://si.imgix.net/03aac832/uploads/origins/aeee8115-fbd6-474d-84ef-945cc3386be6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b2cc49492c9077acc590ea447b95f20 3x", "genre": "art", "nsfw": true, "body": "初めまして、リクエスト失礼いたします。\n\nアキバズトリップの万世架まとめが、鼻上被せ猿轡を着けさせられ拘束されているシチュエーションをお願いしたいです。\n\n格好は普段着のジャージで、可能であれば胸のラインを強調し表現して頂けたらと思います。\n\n何卒よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@Bad0Gift/works/209", "thumbnail_src": "https://si.imgix.net/ce38a0b5/uploads/origins/1611552b-323b-4230-aa42-f734b7a410eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=654135de4997392fb33477e9010a27d7", "thumbnail_srcset": "https://si.imgix.net/ce38a0b5/uploads/origins/1611552b-323b-4230-aa42-f734b7a410eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=654135de4997392fb33477e9010a27d7, https://si.imgix.net/ce38a0b5/uploads/origins/1611552b-323b-4230-aa42-f734b7a410eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fe60bfccdac84710424849b3053e991 2x, https://si.imgix.net/ce38a0b5/uploads/origins/1611552b-323b-4230-aa42-f734b7a410eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1aaa1250e17e302fbc186130508f1022 3x", "genre": "art", "nsfw": true, "body": "キュアホイップ\nキュアカスタード\nキュアジェラートをスマイルプリキュア4話ハッピーのように拘束して欲しいです。\n\n参考URL\nhttps://livedoor.blogimg.jp/anime_damsl/imgs/a/c/ac2c6145.png\n引用元:アニメ拘束研究部様\n\n画像のように一人ずつボール状に拘束され、頭部しか出ていないようにしてほしいです。\n\nホイップ「動けない…」\nカスタード「苦しい…」\nジェラート「うぅ…」\n\nというセリフもあると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@Bad0Gift/works/208", "thumbnail_src": "https://si.imgix.net/c9e28d57/uploads/origins/d9b416bb-0d53-4315-b07b-f3b56b20c04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a51aa92ec44b1305c73b6fcf083c0ca", "thumbnail_srcset": "https://si.imgix.net/c9e28d57/uploads/origins/d9b416bb-0d53-4315-b07b-f3b56b20c04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a51aa92