ix.net/64068030/uploads/origins/29c03e4a-1230-45b9-b1c4-033d81d0b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b84d2686e6f804beca681b73355bec6, https://si.imgix.net/64068030/uploads/origins/29c03e4a-1230-45b9-b1c4-033d81d0b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37ce85aedf62d7d1b322ee2222163da1 2x, https://si.imgix.net/64068030/uploads/origins/29c03e4a-1230-45b9-b1c4-033d81d0b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f46110ac7e7c047a527316dacb4e32b 3x", "genre": "art", "nsfw": true, "body": "ubanis\n\n初めまして。\n下記の通り依頼させて頂きます。\n\nubanisさんが過去出していた「ふたサキュ」のサキュバスの２人による添い寝誘いシチュのイラストをお願いします。\n彼女らはベッドで向かい合うように寝転がっています。そして２人で掛布団を捲り、真ん中の空いたスペースに入る様こちらを誘っています。\nまた、その真ん中のスペースについては、既に彼女らが何回か射精したのか、精液でグチョグチョになってしまっています。\nもしよろしければ、彼女らの射精差分もお願いしたいです。\n\n以上、ご検討頂けると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@ubanis1/works/29", "thumbnail_src": "https://si.imgix.net/fbc33072/uploads/origins/f8c07fec-eea1-4356-8adb-50edba62d670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42b8e64b50b58516044f134dd67d601c", "thumbnail_srcset": "https://si.imgix.net/fbc33072/uploads/origins/f8c07fec-eea1-4356-8adb-50edba62d670?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42b8e64b50b58516044f134dd67d601c, https://si.imgix.net/fbc33072/uploads/origins/f8c07fec-eea1-4356-8adb-50edba62d670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff63c104d8b9b034c74d50fc0c05635d 2x, https://si.imgix.net/fbc33072/uploads/origins/f8c07fec-eea1-4356-8adb-50edba62d670?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c6e2a5229a2ae17a13c99dda6af92df 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n受付嬢サキュバス（フタナリ）×ダークネスのシーンをまたお願いしたいです！\n\nサキュバスはこのように彼女を拘束し、何度も繁殖させます：\nhttps://www.pixiv.net/en/artworks/90170985\nhttps://www.pixiv.net/en/artworks/78361317\n\nサキュバスはヤンデレ顔で口を大きく開けて狂気の笑みを浮かべているはずだ。\nダークネスは、こんな風に心が折れたようなアヘ顔をしてほしい。https://www.pixiv.net/en/artworks/102089522\nダークネスのお腹を妊娠させてください。\n\nありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@ubanis1/works/28", "thumbnail_src": "https://si.imgix.net/b95c581f/uploads/origins/2f6c721c-3f87-4ff5-8e77-4355118fcbde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa3fd69c863d925e655a408ecafa798b", "thumbnail_srcset": "https://si.imgix.net/b95c581f/uploads/origins/2f6c721c-3f87-4ff5-8e77-4355118fcbde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa3fd69c863d925e655a408ecafa798b, https://si.imgix.net/b95c581f/uploads/origins/2f6c721c-3f87-4ff5-8e77-4355118fcbde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bae879e5fb51dda9961c6dfe59adbef7 2x, https://si.imgix.net/b95c581f/uploads/origins/2f6c721c-3f87-4ff5-8e77-4355118fcbde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0e1917df1120b35f33690664748156b 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です、スケブでは初依頼となります、しーあーると申します。\n\nこの度、是非一度うちの子をubanisさんに描いて頂けたらと思い、ご依頼させて頂きます。\n\n■シチュエーション\n・ふたなりで気持ちよさそうにセンズリオ◯ニーしてる\n・全身像\n・エロ蹲踞的なポーズがいいです、構図はおまかせしますが、ふたなりが強調されるやや下からの煽り構図だと嬉しいです。\n・背景はおまかせします。（背景ありの場合は、キャラのみの透過PNGファイルまたはレイヤー分けしたファイル等あればありがたいです、ご面倒な場合は統合したままでも問題ありません）\n\nこんな感じで描いていただく感じでお願いできたらと思います。\n\n\n★差分として、\n・ふたなりの大きさ差分（ubanisさんの描かれる大きくてたくましいモノがどれも本当に好きなので、大きさ別で2～3種類程度あると嬉しいので…\n・射精差分（ふたなり大きさ差分がある場合、ご面倒な場合はどれかひとつに描いてもらえれば大丈夫です、おまかせします）\n・「ふたなりで気持ちよくなっちゃダメという恥じらい表情」と「射精による恍惚顔」\nも描いていただけるとありがたいです。\n（※それぞれの差分数は、描いてる工程内でご面倒に感じない範囲でおまかせします）\n\n\n資料は資料用URL内の画像や特徴のメモをご参照ください。\n（設定上はやや低身長気味なのですが、胸の大きさなど含め体型は描きやすいよう調整してもらっても大丈夫です）\n\n\n\n以上、乱筆・長文にて失礼しました。どうぞご検討よろしくお願いします。\n\nhttps://drive.google.com/file/d/1lFSEWZdm6iXhjxC86qdjL-DoSVg7ra6s/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ubanis1/works/27", "thumbnail_src": "https://si.imgix.net/d1af0996/uploads/origins/9f495e78-2b5d-4242-9306-efd38f8ba008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9301e7248d8d27716300311ad8fb6dd6", "thumbnail_srcset": "https://si.imgix.net/d1af0996/uploads/origins/9f495e78-2b5d-4242-9306-efd38f8ba008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9301e7248d8d27716300311ad8fb6dd6, https://si.imgix.net/d1af0996/uploads/origins/9f495e78-2b5d-4242-9306-efd38f8ba008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1370f66d09080a5232659649c029c5d8 2x, https://si.imgix.net/d1af0996/uploads/origins/9f495e78-2b5d-4242-9306-efd38f8ba008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57f35b3164ed74e7bcb9b79a9ae37608 3x", "genre": "art", "nsfw": true, "body": "ubanisさんの描く女の子と女の子のおちんぽが好きです。  \nというわけでubanisさんの過去作『ANIMAL-SWEETS』に登場した『館の牛娘さん』をもう一度描いていただけないでしょうか？ \n作品（DLsite)　https://dlsharing.com/maniax/work/=/product_id/RJ077914.html \nシチュエーションとしては『ANIMAL-SWEETS』作品内と同様に。 館の自分のお部屋で『お客さん』を迎えた牛娘さんが、両脚をぱかっと開いて、自分の大きな勃起おちんぽを見せつけている……という感じでお願いします。 勃起しても亀頭の半分ほど皮をかむったままで、『お客さん』の手で剝いてくれることを期待している（あるいは再び『お客さん』と会えたことを喜んでいる）かもしれません。 作品内では『玉』のありなしを選べる方式でしたが、今回は玉ありを希望します。ふたなりぷりぷりきんたま。  普段はおすまししていて口数も少ないけど、おっぱいもおちんぽも大きくてえっちな牛娘さんでよろしくお願いします。\n\nhttps://dlsharing.com/maniax/work/=/product_id/RJ077914.html", "created_at": "", "completed_at": ""}, {"path": "/@ubanis1/works/26", "thumbnail_src": "https://si.imgix.net/5e192c09/uploads/origins/37e070c7-e3ca-4edc-9ac5-6959c56ad839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7edb294442a95243c8be07566850a8da", "thumbnail_srcset": "https://si.imgix.net/5e192c09/uploads/origins/37e070c7-e3ca-4edc-9ac5-6959c56ad839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7edb294442a95243c8be07566850a8da, https://si.imgix.net/5e192c09/uploads/origins/37e070c7-e3ca-4edc-9ac5-6959c56ad839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b33a413fa8100f2d2c8bfb1370e2b98 2x, https://si.imgix.net/5e192c09/uploads/origins/37e070c7-e3ca-4edc-9ac5-6959c56ad839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ad9e455192ef1a96cc10c5f847adc2b 3x", "genre": "art", "nsfw": true, "body": "こんにちは、貴方のふたなり娘がカラフルなチンポで少年を逆アナルする作品が大好きです。\n\nURL過去作の雪女さんシリーズのデザインが気に入っているので、彼女がいつも一緒にいる少年を自分の青いチンポで逆アナルするイラストをお願いしてもよろしいでしょうか。\n2人の姿勢は立ちバックで、雪女さんは自分の裸の胸を少年の背中に押し付けながら、彼の小さなチンポを背後から手コキし彼だけところてん射精させて、青紫色の舌で彼の首筋または頬あたりをぺろぺろ舐めながら犯すシチュエーションを希望します。\n雪女さんの自身の紫の亀頭及び水色の巨根を､少年の腸壁に殴りつけてる様子を描いた彼の腸内断面図のコマも加えて下さると嬉しいです。\nどうかご検討お願い致します\n\nhttps://drive.google.com/file/d/1RkQbDd3Vns3neH82AzrUDvVP3Z0K9jd0/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@ubanis1/works/25", "thumbnail_src": "https://si.imgix.net/f87f6e5b/uploads/origins/8deff242-83a2-4fcf-a33f-1d205597a0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dcfbfd94a522dbd06de425541128f66", "thumbnail_srcset": "https://si.imgix.net/f87f6e5b/uploads/origins/8deff242-83a2-4fcf-a33f-1d205597a0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1dcfbfd94a522dbd06de425541128f66, https://si.imgix.net/f87f6e5b/uploads/origins/8deff242-83a2-4fcf-a33f-1d205597a0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a46d864af61287073cf2d08865828b0e 2x, https://si.imgix.net/f87f6e5b/uploads/origins/8deff242-83a2-4fcf-a33f-1d205597a0ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06aeb32de1f0c36a63e7982949669173 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ubanis1/w