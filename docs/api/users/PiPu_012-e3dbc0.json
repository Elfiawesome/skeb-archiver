bd-c6955c500c44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2620d3a0b1776e1486fea1720abf878d", "thumbnail_srcset": "https://si.imgix.net/af770b20/uploads/origins/826cdce4-e0a7-46bb-89bd-c6955c500c44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2620d3a0b1776e1486fea1720abf878d, https://si.imgix.net/af770b20/uploads/origins/826cdce4-e0a7-46bb-89bd-c6955c500c44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21bf41860c35bd607874ab2deed5bb98 2x, https://si.imgix.net/af770b20/uploads/origins/826cdce4-e0a7-46bb-89bd-c6955c500c44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=493cb9dfdf7f32ed67d1e14bd02e7a79 3x", "genre": "art", "nsfw": false, "body": "初めまして、ぷにぷるんと申します。あなた様のイラスト、色使いがとても素敵だったので、イラスト作成の依頼をしたくリクエストをお送りいたします。\n私も機界騎士が本当に好きで、現在マスターデュエルではすべてのシーズンを様々な型の機界騎士で戦っています。特に紫宵と紺碧がほんとにかっこいい・・・\nリクエストを決めた直接的なイラストは、P.U.N.K.と機界騎士の混合イラストです。初見時にはカテゴリの違うモンスターたちが一斉に目標に向かっている構図や、セアミンが紫宵につかまっている様子などのかわいらしさ、そして何より紫宵のイケメンが過ぎるなと感動いたしました。\n今回依頼したい内容も、このP.U.N.K.機界騎士と近しい部分があります。\n\n私は現在、マスターデュエルのランクマッチをトリックスター機界騎士で戦っております。打点に難がありキャンディナに召喚権を割きたいトリックスターと、打点がありメインデッキだけでも戦える機界騎士との相性は最高で、協力なメタカードである御前試合を採用しながら少しずつランクを上げています。\n\nHL様に依頼したいのは、何を隠そうこのトリックスターとジャックナイツの混合イラストです。\nともに信頼しあいながら並び立つようなイメージのカッコいいイラストを希望しますが、トリックスターのライブ会場で応援している機界騎士、みたいな構図も面白くていいですね。内容に関してはHL様にお任せします。\n金額に関してはトリックスターと機界騎士で最低2体以上のモンスターを描いていただくことになることと、構図の複雑さなどを鑑みてこちらの金額でご依頼いたします。\nぶしつけな内容だとしたら申し訳ありません。不快に感じられましたら無視していただいて結構です。\n寒暖差激しく体調の崩しやすい季節ですが、お体ご自愛下さい。", "created_at": "", "completed_at": ""}, {"path": "/@PiPu_012/works/7", "thumbnail_src": "https://si.imgix.net/07f44a2b/uploads/origins/4ed5dca6-8d89-4ce4-8898-87fc032a9013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9312a81707de0c1b721e02efdfea090d", "thumbnail_srcset": "https://si.imgix.net/07f44a2b/uploads/origins/4ed5dca6-8d89-4ce4-8898-87fc032a9013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200