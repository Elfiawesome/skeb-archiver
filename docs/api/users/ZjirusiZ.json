7ec69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61d90801eb9604f080b5d7eb63591abc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/263", "thumbnail_src": "https://si.imgix.net/535e5a10/uploads/origins/840e725f-79c1-4057-8bfd-b903c417ee7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb51db871af9ce2a42fe820301e0ddb", "thumbnail_srcset": "https://si.imgix.net/535e5a10/uploads/origins/840e725f-79c1-4057-8bfd-b903c417ee7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb51db871af9ce2a42fe820301e0ddb, https://si.imgix.net/535e5a10/uploads/origins/840e725f-79c1-4057-8bfd-b903c417ee7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=763b8e885d5e6d5eeaa7600fbfa2d122 2x, https://si.imgix.net/535e5a10/uploads/origins/840e725f-79c1-4057-8bfd-b903c417ee7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac236f5128a9199c05d45a8d070a2138 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレムエンゲージからユナカをリクエストします。\nFEヒーローズで披露した忍者衣装でお願いします。\nhttps://guide.fire-emblem-heroes.com/14006003001309-2/\n女の子座りの騎乗位で、背後から男に両胸を揉まれながら両手に別々の男の竿を扱きつつ片方の竿を咥えてる構図にしてください。\n胸元を破かれ元絵からふた回り大きい立派な爆乳を晒してください。(前回描いて頂いたサクラちゃん以上)\n装束・腕の装備・脚のタイツ・首周りのマフラーで別々のレイヤーに分けてください。\n\nキャプションのあらすじの内容はお任せします。\n\nhttps://pbs.twimg.com/media/G4-Dn7TbQAAj5Nq?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/262", "thumbnail_src": "https://si.imgix.net/68bc9575/uploads/origins/ff7364e5-2075-4eee-9f89-c3c1d44fed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c94d124cd131e923aadde20953e8429", "thumbnail_srcset": "https://si.imgix.net/68bc9575/uploads/origins/ff7364e5-2075-4eee-9f89-c3c1d44fed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c94d124cd131e923aadde20953e8429, https://si.imgix.net/68bc9575/uploads/origins/ff7364e5-2075-4eee-9f89-c3c1d44fed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eca461fc70e019984bc0d583f4b29e43 2x, https://si.imgix.net/68bc9575/uploads/origins/ff7364e5-2075-4eee-9f89-c3c1d44fed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea0075486cefced4dfa5a0d68029ce23 3x", "genre": "art", "nsfw": true, "body": "過去にも依頼しておりましたが、今回もスクールガールストライカーズの千年夕依をリクエストさせて頂きます。前回と同じく通常髪型、艶コスでの犯されてるシーン。\n\n過去依頼\nhttps://skeb.jp/@ZjirusiZ/works/114\n\n構図はお任せ致しますが、1点お願い出来るならば股間部の前垂れ的な布地について、犯されてる結合部が前垂れで隠れてて見えないものと、それが捲られてるもしくは破かれてる等で丸見えの差分をお願い出来ますでしょうか。\n\n嫌がって泣いてるか、あるいはもうその気力も無くなってるような表情。\n中も外も出されまくってるシチュでお願いします。\n\nお受け頂けますならどうか宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/261", "thumbnail_src": "https://si.imgix.net/cdaaeb98/uploads/origins/eb6c840e-0dc0-4d9e-a493-9d0edad41382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1397846c4d0a8cb46234e2879d831df", "thumbnail_srcset": "https://si.imgix.net/cdaaeb98/uploads/origins/eb6c840e-0dc0-4d9e-a493-9d0edad41382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1397846c4d0a8cb46234e2879d831df, https://si.imgix.net/cdaaeb98/uploads/origins/eb6c840e-0dc0-4d9e-a493-9d0edad41382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddba9ac45f564b43d0998fb255ed1ae6 2x, https://si.imgix.net/cdaaeb98/uploads/origins/eb6c840e-0dc0-4d9e-a493-9d0edad41382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4068e932abb24c00f4b6360ad7c56a35 3x", "genre": "art", "nsfw": true, "body": "次のLoadAgainリクエストです。\n\nキャラクター\nアルマ\nアイリーン\n\n前回のLoadAgainリクエストの続編\nhttps://skeb.jp/@ZjirusiZ/works/252\n\n 前回の出来事から数年が経った。アルマはすっかりアイリーンに忠実で、アルマは愛妻家になっている。アルマの髪はほどけ、アルマは結婚指輪をはめている。\n\n台詞のリクエスト\n\n1\nアルマはアイリーンのドレスを着ている。アルマはセクシーなポーズをとっている。アイリーンは、アルマが過去にもかかわらずどれだけ自分に忠実になっているかをコメントする。アルマはアイリーンを完全に尊敬しており、アルマはアイリーンを優れた魔道士として見ている。アイリーンは、アルマが負け犬であることが自分に合っているとコメントする。\n\n2\n同じドレスを着たアルマが、夫に愛おしそうにキスをしている。アルマは盗賊の頭領を完全に愛しており、恥ずかしげもなく彼といちゃいちゃして、愛をアピールしている。\n\n3\n裸のアルマは、騎乗位で夫とセックスしている。かつての高慢な魔道士とはまったく違う、淫らな女であることを楽しんでいるアルマ。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/260", "thumbnail_src": "https://si.imgix.net/2a544fce/uploads/origins/1a6ac39c-78e2-45dc-b72b-7d5a62912207?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b71d35f52103e950fa2d0312b55fa30e", "thumbnail_srcset": "https://si.imgix.net/2a544fce/uploads/origins/1a6ac39c-78e2-45dc-b72b-7d5a62912207?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b71d35f52103e950fa2d0312b55fa30e, https://si.imgix.net/2a544fce/uploads/origins/1a6ac39c-78e2-45dc-b72b-7d5a62912207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34c5726cfab441a464d9ef8ea00767b8 2x, https://si.imgix.net/2a544fce/uploads/origins/1a6ac39c-78e2-45dc-b72b-7d5a62912207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91da6d522f7c9d77c85178148271706a 3x", "genre": "art", "nsfw": true, "body": "それは続編でも新たなシナリオでも構いません、お任せします。\n\n具体的な状況は公開処刑です。\n\nしかし彼女の治癒能力と珍しい容姿ゆえ、切り刻むのは勿体ないと判断されました。\n\nそして彼女は自ら快楽によって死を迎えることになるのです。\n\n公衆の面前で裸に縛り上げられ、媚薬を飲まされる。\n\nその後、巨大な偽物のディルド、あるいは人間や動物が近づくが、彼女は自ら進んで快楽に身を委ね、上下に数百回も動き、愛液と汗を噴き出す。\n\n息絶えるまで続けられ、見せしめとして晒される。\n\nhttps://drive.google.com/file/d/1mNRTzw-zlcRIruIDH1WmglXR_xCLdowb/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/259", "thumbnail_src": "https://si.imgix.net/2ba1632e/uploads/origins/d4560cd8-669b-4f9a-b9a4-6aad6ed88a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed0ef66ee407941736ca1a5dc26bc0a", "thumbnail_srcset": "https://si.imgix.net/2ba1632e/uploads/origins/d4560cd8-669b-4f9a-b9a4-6aad6ed88a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ed0ef66ee407941736ca1a5dc26bc0a, https://si.imgix.net/2ba1632e/uploads/origins/d4560cd8-669b-4f9a-b9a4-6aad6ed88a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87fbf619b07fb620dad6d62cd20abd7a 2x, https://si.imgix.net/2ba1632e/uploads/origins/d4560cd8-669b-4f9a-b9a4-6aad6ed88a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=531743afe3f3eeb6c0856cc095c68985 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\nまた依頼させていただきます。\n\n<キャラクター>\nSpiral Legend Ⅳという同人ゲームのコゼットとアーシェをお願いします。\nhttps://www.dlsite.com/maniax/work/=/product_id/RJ158467.html\nイラストが存在せず(顔グラ等はフリー素材の改変)資料らしいものはほとんど存在しませんが、他のクリエイター様に描いて頂いたイラストもあるのでそれも参考にお願いします\n\n・コゼット\n原作顔グラ＆歩行グラ\nhttps://i.imgur.com/75tqlM8.png\nhttps://i.imgur.com/XIsb5Gr.png\n\n他の方に描いて頂いたイラスト一部\nhttps://skeb.jp/@he_be_/works/42\nhttps://skeb.jp/@he_be_/works/117\n\n・アーシェ\n原作顔グラ＆歩行グラ\nhttps://i.imgur.com/5zVNeC5.png\n髪色、服色改変前の全身像\nhttps://i.imgur.com/xQIPqY3.png\n他の方に描いて頂いたイラスト一部\nhttps://skeb.jp/@hardcrom/works/169\nhttps://skeb.jp/@hardcrom/works/235\n二人の水着イラスト\nhttps://skeb.jp/@he_be_/works/133\nhttps://skeb.jp/@he_be_/works/128\n設定もコゼットは美乳ながらも貧乳寄り、アーシェは巨、爆乳といった感じで、上記水着イラストがかなり理想に近いのでそれ準拠でお願いします。(アーシェはもう少し盛っても大丈夫です)\n\n<シチュ・構図等>\n下記3Dモデルのように正常位で犯されながら片手にはペニスをもう片手は手を握り合う形での輪姦陵辱でお願いします。\nhttps://i.imgur.com/asesBr0.png", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/258", "thumbnail_src": "https://si.imgix.net/1e632131/uploads/origins/6eccaedf-3a2d-48ff-a6ad-1659bf59c754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c900ace86d67efe40c924e3342ee928", "thumbnail_srcset": "https://si.imgix.net/1e632131/uploads/origins/6eccaedf-3a2d-48ff-a6ad-1659bf59c754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c900ace86d67efe40c924e3342ee928, https://si.imgix.net/1e632131/uploads/origins/6eccaedf-3a2d-48ff-a6ad-1659bf59c754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40480aadec911737593bcae2fc1779f0 2x, https://si.imgix.net/1e632131/uploads/origins/6eccaedf-3a2d-48ff-a6ad-1659bf59c754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f6a42749af608ad641966168a6bad1d 3x", "genre": "art", "nsfw": true, "body": "#1\n私のキャラクターはあっさりと敗北し、その裸体は誰の目にも晒され、半人間であり獣以下であると宣言された。そして彼らはそれを証明すると言う。\n#2\n彼女は簡単に絶頂を迎え、淫らな表情を見せ、動物と交尾させられ、それを楽しんでいる描写がある。\n#3\n獣と交尾する彼女の裸体は、通りや町を引き回され、人間以下の姿をさらすが、それでも彼女はそれを楽しんでいるようだ。\n#4\n彼女は動物園の展示品のように展示され、さまざまな動物との交尾を見せられる。人々は彼女と交尾するために自分の動物を連れてくる。\n彼女はもはやヒロインとも、人間とも見られていない。\nしかし、彼女はこの人生を謳歌し、完全に快楽に溺れ、動物よりも悪い振る舞いをする。\n展示品として人間以下とみなされた彼女は、人間のふりをしながら、野良犬や最弱の怪物をも凌ぐ弱さを露呈する。彼女の唯一の救いは、飽くなき性欲とスタミナ、そして常に最高のコンディションを保つ治癒能力である。\n英語の台詞を使う必要はない。\n\nhttps://drive.google.com/file/d/1mhyGxp_o5I1CtPtGO5v6HCiKWvWUd4RV/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/257", "thumbnail_src": "https://si.imgix.net/51d35be5/uploads/origins/ed5402af-543c-4722-ba6c-c8aac096e927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3bd8b9bc5639798eb93a660c7c81efd", "thumbnail_srcset": "https://si.imgix.net/51d35be5/uploads/origins/ed5402af-543c-4722-ba6c-c8aac096e927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3bd8b9bc5639798eb93a660c7c81efd, https://si.imgix.net/51d35be5/uploads/origins/ed5402af-543c-4722-ba6c-c8aac096e927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5322142c51b0f881be8710eae487dfa 2x, https://si.imgix.net/51d35be5/uploads/origins/ed5402af-543c-4722-ba6c-c8aac096e927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dece869407f0e00c3bf27cd45e414458 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレムifからサクラをリクエストします。\nFEヒーローズで披露したハロウィン衣装でお願いします。\nhttps://guide.fire-emblem-heroes.com/11002012000186-2/\n\n背面座位で男に突かれつつ両胸を揉まれながら両手に別々の男の竿を握り片方の竿を咥えてる構図にしてください。\n参考構図(https://skeb.jp/@ZjirusiZ/works/232)\n胸は前回(https://skeb.jp/@ZjirusiZ/works/246)から引き続き乳牛のように爆乳化・母乳体質の状態です。\n脚のニーソと猫耳はそのままに長手袋と衣服を別々のレイヤーに分けてください。\n\nシチュエーションは前回からの更に続きでキャプションのあらすじには\n・乳牛王女としての恥辱を植え付けるため占領した白夜王国領各地で群衆の前で執り行う\n・収穫祭が毎年行われていた村でサクラが着ていた収穫祭の猫又衣装を着せて思い出とともに汚す　\nという旨の内容でお願いします。\n\nhttps://static.wikia.nocookie.net/feheroes_gamepedia_en/images/9/94/Sakura_Gentle_Nekomata_Face.webp/revision/latest?cb=20190920211900", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/256", "thumbnail_src": "https://si.imgix.net/6f19aad2/uploads/origins/8b9eda27-969c-4ab0-bf7f-31ece0f81240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=073fb0f8ffede694c47618b8836b0521", "thumbnail_srcset": "https://si.imgix.net/6f19aad2/uploads/origins/8b9eda27-969c-4ab0-bf7f-31ece0f81240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=073fb0f8ffede694c47618b8836b0521, https://si.imgix.net/6f19aad2/uploads/origins/8b9eda27-969c-4ab0-bf7f-31ece0f81240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=681dd4041c0f177ec1317266a04dc3c9 2x, https://si.imgix.net/6f19aad2/uploads/origins/8b9eda27-969c-4ab0-bf7f-31ece0f81240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84f5cbf9744eb52b651e89fa1bd7d3ee 3x", "genre": "art", "nsfw": true, "body": "はじめまして。先生のならず者シリーズにはいつもお世話になっております。\n\n今回リクエストさせていただくのは「暗殺教室」の「神崎 有希子」「茅野 カエデ」の輪姦シチュです。作中の修学旅行に行った際に不良高校生達から拉致されるものの仲間の助けが間に合い性犯罪未遂に終わるシーンのもし助けに来なかった展開です。茅野は強力な防衛手段を本来持っているのですがそこは見なかったことにしていただければ⋯\n\n体位はお任せします。荒々しい竿！液！な先生のテイストをもしお時間あればよろしくお願いします。キャラも難儀でしたらどちらか片方でも構いません。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/255", "thumbnail_src": "https://si.imgix.net/64c25c2a/uploads/origins/cfd53155-1efa-4419-80c1-7dd80373c43f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c71a24f903fdfd6adfa29bf8f9c312a", "thumbnail_srcset": "https://si.imgix.net/64c25c2a/uploads/origins/cfd53155-1efa-4419-80c1-7dd80373c43f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c71a24f903fdfd6adfa29bf8f9c312a, https://si.imgix.net/64c25c2a/uploads/origins/cfd53155-1efa-4419-80c1-7dd80373c43f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6cf68576230fd6c5068e1a463ae41817 2x, https://si.imgix.net/64c25c2a/uploads/origins/cfd53155-1efa-4419-80c1-7dd80373c43f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a8aaf7100bd05f13e8af62ab7f5dd36 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/254", "thumbnail_src": "https://si.imgix.net/6032475f/uploads/origins/3e203e27-f733-4972-815b-88e09ce67133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e4eca38cc3c136ea54baafc0bb1834d", "thumbnail_srcset": "https://si.imgix.net/6032475f/uploads/origins/3e203e27-f733-4972-815b-88e09ce67133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e4eca38cc3c136ea54baafc0bb1834d, https://si.imgix.net/6032475f/uploads/origins/3e203e27-f733-4972-815b-88e09ce67133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e325a302d56c8e3d79fc1f579ccb440 2x, https://si.imgix.net/6032475f/uploads/origins/3e203e27-f733-4972-815b-88e09ce67133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e00da50a058b04c2810864d2df44c0bd 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレム風花雪月からイングリットをリクエストします。\nFEヒーローズで披露したお茶会衣装でお願いします。\nhttps://static.wikia.nocookie.net/feheroes_gamepedia_en/images/2/2c/Ingrid_Cordial_Teatime_BtlFace_D.webp\nhttps://guide.fire-emblem-heroes.com/12003008001272-2/\n女の子座りの騎乗位で、背後から男に両胸を揉まれながら両手に別々の男の竿を扱きつつ片方の竿を咥えてる構図にしてください。\n胸元を破かれ元絵からふた回り大きい立派な巨乳を晒してください。\n脚のニーソはそのまま残し給仕服をスカート部分とスカートから上の服でレイヤーを分けられるようにしていただけたら嬉しいです。\n相方のナンナも同様に奉仕を強要されている姿を背景に小さく描写してください。\n\nキャプションのあらすじとして\n・アスク王国での男子禁制のお茶会に乱入したならず者に制圧される\n・紋章持ちの貴族として箔の高いイングリットを特に大きな戦果としてならず者専属メイドとして調教する\nという旨の内容でお願いします。\n\nhttps://pbs.twimg.com/media/GxqHvZ-bsAAYq5y?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/253", "thumbnail_src": "https://si.imgix.net/8efb0af7/uploads/origins/242d4007-898f-4ce7-a452-717da66b846e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33bb9609adba27d35ba8c8b56296879b", "thumbnail_srcset": "https://si.imgix.net/8efb0af7/uploads/origins/242d4007-898f-4ce7-a452-717da66b846e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33bb9609adba27d35ba8c8b56296879b, https://si.imgix.net/8efb0af7/uploads/origins/242d4007-898f-4ce7-a452-717da66b846e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=650dfaaf5efb0693ce1cbe5b6752b9be 2x, https://si.imgix.net/8efb0af7/uploads/origins/242d4007-898f-4ce7-a452-717da66b846e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e6907dc8e279b60ef9810e82e69def4a 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/252", "thumbnail_src": "https://si.imgix.net/8d34cf63/uploads/origins/5da06c04-d291-4c55-ac84-7b9404786301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8158c94e0a0b029a791a994dd039a6ce", "thumbnail_srcset": "https://si.imgix.net/8d34cf63/uploads/origins/5da06c04-d291-4c55-ac84-7b9404786301?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8158c94e0a0b029a791a994dd039a6ce, https://si.imgix.net/8d34cf63/uploads/origins/5da06c04-d291-4c55-ac84-7b9404786301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f95a71b6d52cf8d2acb441cfce40d9e3 2x, https://si.imgix.net/8d34cf63/uploads/origins/5da06c04-d291-4c55-ac84-7b9404786301?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c5ed4de35091d360100ea2f84770ffc 3x", "genre": "art", "nsfw": true, "body": "キャラクター\nアルマ\nアイリーン\n\nこのLoadAgainリクエストの続編\nhttps://skeb.jp/@ZjirusiZ/works/250\n\nキャラクターの台詞依頼\n\n1\nアルマは裸だ。夫と抱き合い、キスをしている。周りの生徒たちは、アルマが自分を辱めているのを見てショックを受け、失望する。アイリーンは笑ってアルマをからかう。  \n\nアルマの髪は下ろされる。\n\nポーズ参考\nhttps://drive.google.com/file/d/1rjJZjUbpO4slTK71jupkMS6Eqbg4V8DD/view?usp=sharing\n\n2\nしばらくして、アルマがアイリーンの前にひざまずく。アイリーンはアルマを見下ろしている。アルマは最大の敵に頭を下げた屈辱を感じる。アイリーンはアルマの悪口を言い続ける。アルマは反撃することもできず、アイリーンの従順な下僕となることを受け入れる。\n\nアルマの衣装\nhttps://drive.google.com/file/d/11EdINP5QEl8VSRYLoNlEymYe5RdV3310/view?usp=sharing\n\n3\nアイリーンはアルマにセクシーなドレスとハイヒールを着せる。鏡の前に立ったアイリーンは、アルマがアイリーンの所有物であることを思い出す。\n\nポーズ\nhttps://drive.google.com/file/d/1dZ5FsaKUq-LUp_f9pywqLOSh4g81YdK0/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/251", "thumbnail_src": "https://si.imgix.net/700131c2/uploads/origins/5250a7bc-dfb4-4ddc-af01-39a557c2ce27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e592d26caf603cb33e5a81bec18d7cd", "thumbnail_srcset": "https://si.imgix.net/700131c2/uploads/origins/5250a7bc-dfb4-4ddc-af01-39a557c2ce27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e592d26caf603cb33e5a81bec18d7cd, https://si.imgix.net/700131c2/uploads/origins/5250a7bc-dfb4-4ddc-af01-39a557c2ce27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce4d6680106cf3266fe5aba9efdcec4d 2x, https://si.imgix.net/700131c2/uploads/origins/5250a7bc-dfb4-4ddc-af01-39a557c2ce27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1ef0ee4ce734b23ff34e75c8430fe85 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@ZjirusiZ/works/238\nこちらの水着ラピスちゃんで差分の追加をリクエストします。\n・行為中の男達と必死に腰を振るラピスちゃん\n・ストロークの激化とそれに圧倒されるラピスちゃん\n・中出しと握ってる竿から一斉射精を受け絶頂を迎えるラピスちゃん\n・弱々しくシトリニカやスタルークに助けを求めようとするラピスちゃんの事後\nの4場面の会話並びに表情と射精差分の追加をお願いします。\nまたラピスちゃんの胸を更に大きく盛ってください(これまで描いて頂いた大人ベルちゃん並み)。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/250", "thumbnail_src": "https://si.imgix.net/23af5a48/uploads/origins/f66daa9b-9d70-49ef-80b6-7cfe3fb0e317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=857baafc8a45ee410e350e99f6d63fe3", "thumbnail_srcset": "https://si.imgix.net/23af5a48/uploads/origins/f66daa9b-9d70-49ef-80b6-7cfe3fb0e317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=857baafc8a45ee410e350e99f6d63fe3, https://si.imgix.net/23af5a48/uploads/origins/f66daa9b-9d70-49ef-80b6-7cfe3fb0e317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2362a488ec3362f0839d3921b2a1d0fc 2x, https://si.imgix.net/23af5a48/uploads/origins/f66daa9b-9d70-49ef-80b6-7cfe3fb0e317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cd4711fe0a2f32c6c8d96f2295e0ecc 3x", "genre": "art", "nsfw": true, "body": "キャラクター\nアルマ\nアイリーン\n\n前回のLoadAgainリクエストの続編\nhttps://skeb.jp/@ZjirusiZ/works/247\n\nアイリーンリファレンス\nhttps://drive.google.com/drive/folders/1mOcd1lL0QxU8sGhOKYyLgT-Tm1qC_1u4?usp=sharing\n\nあらすじ\nアルマのみだらな格好を見たアイリーンは、悪意を持ってアルマを辱め、アルマの評判をさらに落とそうとする。魔法を使って、アイリーンはアルマの結婚式のキス、誓い、処女喪失のビデオを手に入れる。\n\n台詞を要求する。\n\n1\nこれは、前回のリクエストにあった、恥も外聞もない淫らな格好をしたアルマが屈辱を感じているのを、アイリーンがニヤニヤしながら楽しんでいるCGになります。\n\n2\nアルマの夫がアルマと後背位でセックスする。アイリーンはセックスを録画しながら、苦しむアルマを見て楽しむ。射精のとき、アルマは淫らな顔を見せ、アイリーンはそれを録画する。\n\n3\nアイリーンはアルマをかつてのアカデミーの生徒たちに見せつける。アルマはアイリーンが選んだ淫らな魔道士の衣装を着て、髪を下ろして立っている。アイリーンはアルマに「アルマは男を誘惑するために魔導士になった」と嘘をつかせる。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/249", "thumbnail_src": "https://si.imgix.net/2628f833/uploads/origins/c176d98c-42d4-4414-9f19-f90114791aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2aef0598cf5aca5b41cbfbff98f775a", "thumbnail_srcset": "https://si.imgix.net/2628f833/uploads/origins/c176d98c-42d4-4414-9f19-f90114791aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2aef0598cf5aca5b41cbfbff98f775a, https://si.imgix.net/2628f833/uploads/origins/c176d98c-42d4-4414-9f19-f90114791aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=366acd66981e6d411921d7e05b2af5a1 2x, https://si.imgix.net/2628f833/uploads/origins/c176d98c-42d4-4414-9f19-f90114791aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35232c5b0cf3f694e7c399f47cf487e1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/248", "thumbnail_src": "https://si.imgix.net/bc5c158b/uploads/origins/d95a2ae3-98b7-42db-9b3d-03b3626a7bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c77105cdadf04291d8f4c068c4de92", "thumbnail_srcset": "https://si.imgix.net/bc5c158b/uploads/origins/d95a2ae3-98b7-42db-9b3d-03b3626a7bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c77105cdadf04291d8f4c068c4de92, https://si.imgix.net/bc5c158b/uploads/origins/d95a2ae3-98b7-42db-9b3d-03b3626a7bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a6b70b794ca6e137bdcbe28c9aa2290 2x, https://si.imgix.net/bc5c158b/uploads/origins/d95a2ae3-98b7-42db-9b3d-03b3626a7bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d39195466ff5d4362a9331b8673eb3c8 3x", "genre": "art", "nsfw": true, "body": "またリクエストを送らせていただきます。\n\nドラゴンクエスト 蒼天のソウラのアズリアで、作中のあぶない水着＆ゴーグル姿で\nシチュ：第27話以降でゾンビ系の海賊に囚われ、血の力で生きていた頃の姿に戻ろうとする展開があるのですが、そのIFとして血の代わりに愛液を浴びると生きていた頃の姿に戻れるとして、拘束されたまま\n1.『がいこつ』の様な骨の魔物達には手マンで何度も潮を吹かされる。\n2.『くさった死体』の様な魔物達には挿入され何度も潮を吹かされる。\nの2シーンをお願いします。\n希望差分として、\n衣装\n1.トップをずらして乳首を露出\n2.トップを脱がされ胸を露出\n3.ボトムをずらして割れ目を露出\n4.ボトムを脱がされ股を露出\n表情\n1.困惑\n2.羞恥\n3.涙目\n4.快感を堪えている\n5.快感が堪えなくなり始めている\n6.絶頂を迎え絶叫\n7.息を荒げている\n8.目を見開いて喘いでいる\n9.感じすぎてトロ顔\n液描写\n1.濡れ描写無し\n2.濡れ始める\n3.愛液が飛び散っている\n4.潮が勢いよく吹いている\n5.潮が繰り返し吹いている\n6.中出しされた精液が接続部の隙間から溢れている\n7.男性器が引き抜かれ精液が溢れている\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/247", "thumbnail_src": "https://si.imgix.net/ddc5ab9b/uploads/origins/1ed04ccb-5585-4987-bcf3-b4f0c4c2c71a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53804bba764fc740b530943917406421", "thumbnail_srcset": "https://si.imgix.net/ddc5ab9b/uploads/origins/1ed04ccb-5585-4987-bcf3-b4f0c4c2c71a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53804bba764fc740b530943917406421, https://si.imgix.net/ddc5ab9b/uploads/origins/1ed04ccb-5585-4987-bcf3-b4f0c4c2c71a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47d5558bedbe59c18aadcfa4945bafc4 2x, https://si.imgix.net/ddc5ab9b/uploads/origins/1ed04ccb-5585-4987-bcf3-b4f0c4c2c71a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f9cbc1962b8c3911e67f0ed67fb183f 3x", "genre": "art", "nsfw": true, "body": "キャラクター\nアルマ\n\n前回のLoadAgainリクエストの続編\nhttps://skeb.jp/@ZjirusiZ/works/245\n\n全シナリオの対話を要求する。\n\nシナリオ1\n盗賊の首領がアルマの処女を奪う。アルマは下っ端の悪党に処女を奪われて絶望している。彼女は盗賊のリーダーに、中で射精しないでくれと懇願するが、彼は聞き入れず、アルマの懇願と絶望を楽しんでいる。\n\nセックスの体位はお任せします。\n\nアルマの髪がほどける。\n\nシナリオ2\nセックスの後、裸のアルマと盗賊のリーダーがベッドに横になっている。アルマはすべてを失ったことを認め、壊れている。山賊のリーダーは彼女を見下すように話し続け、従順な妻としての役割を思い出させる。\n\nアルマの髪がほどかれる。\n\nシナリオ3\n山賊のリーダーがアルマを公共の町に連れてくる。アルマはみだらな服を着て、ハイヒールを履き、みだらな化粧をしている。アルマは屈辱と恥ずかしさを感じ、山賊のリーダーがアルマと彼女の今の姿を見せびらかし、彼女の評判を落とす。\n\n服のデザインはあなたにお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/246", "thumbnail_src": "https://si.imgix.net/1fb2b743/uploads/origins/9c4dfe14-f9d4-4d58-8b13-4150e8100a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff56729e6af6e1d8d6898cad79d39ba", "thumbnail_srcset": "https://si.imgix.net/1fb2b743/uploads/origins/9c4dfe14-f9d4-4d58-8b13-4150e8100a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fff56729e6af6e1d8d6898cad79d39ba, https://si.imgix.net/1fb2b743/uploads/origins/9c4dfe14-f9d4-4d58-8b13-4150e8100a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f937a6a6f0a4a34167bfc05c45d677c 2x, https://si.imgix.net/1fb2b743/uploads/origins/9c4dfe14-f9d4-4d58-8b13-4150e8100a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb854b37601a01005bd28aec2cbcf5f1 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレムifからサクラを上級職の戦巫女の衣装でリクエストします。\nhttps://guide.fire-emblem-heroes.com/11002012001213-2/\nhttps://static.wikia.nocookie.net/feheroes_gamepedia_en/images/f/f2/Sakura_In_Full_Bloom_BtlFace_D.webp\nシチュエーションは前回からの続きで、暗夜王国に囚われたサクラちゃんをさらなる恥辱に貶めるため乳牛のように爆乳化・母乳体質に変化する魔法の実験を行うという内容です。\n\n立ちバックで両腕を天井の鎖に拘束され、背後から男に両胸を揉まれている構図にして下さい。\n(https://skeb.jp/@ZjirusiZ/works/236)こちらの構図のように前からのアングルでお願いします。\n胸元を破いて前回同様の立派な胸、並びに魔法で更に二回り成長させられた爆乳を晒して下さい。\n巫女服・長手袋・マントを別々のレイヤーに分けて、行為中・爆乳化・中出し＆母乳噴出・事後と段階を入れて下さい。\nキャプションのあらすじも上記の旨の内容で入れて下さい。\n\nhttps://pbs.twimg.com/media/GkxO7smbgAAAkai?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/245", "thumbnail_src": "https://si.imgix.net/4bf8688d/uploads/origins/7fb7e3f9-2daf-4b17-aa75-9ad508a58762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1315d2dc247017289000175ce668317f", "thumbnail_srcset": "https://si.imgix.net/4bf8688d/uploads/origins/7fb7e3f9-2daf-4b17-aa75-9ad508a58762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1315d2dc247017289000175ce668317f, https://si.imgix.net/4bf8688d/uploads/origins/7fb7e3f9-2daf-4b17-aa75-9ad508a58762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de9f9a0960b94d8a063ffb9ed5433898 2x, https://si.imgix.net/4bf8688d/uploads/origins/7fb7e3f9-2daf-4b17-aa75-9ad508a58762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=deb8a4bc37e5d07b66d499456e9e0127 3x", "genre": "art", "nsfw": true, "body": "これがロードアゲインのリクエストだ。\n\nキャラクター\nアルマ\n\nアルマはチンピラたちに負ける。チンピラのリーダーに屈辱的な形で紹介される。アルマのプライドは打ち砕かれる。\n\nシナリオ1\nアルマがチンピラのリーダーに頭を下げる。彼女はウェディングランジェリーを身につけ、ハイヒールを履いている。冒険者の服は、脇にきちんとたたまれている。照れくさそうなアルマは、しぶしぶチンピラリーダーの女になることを誓い、プライドも家族も魔法も捨てる。\n\nポーズ参照：\nhttps://drive.google.com/file/d/190CJZ3-tpNUSVQxlg6wRqDl8ry2nIk04/view?usp=sharing\n\nシナリオ2\nアルマと盗賊のリーダーが抱き合ってキスをしている。アルマは、自分が下衆なチンピラにキスをしていることに屈辱を感じている。\n\nキスはこれに似ている：\nhttps://ci-en.dlsite.com/creator/3139/article/419742\n\n台詞をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/244", "thumbnail_src": "https://si.imgix.net/1ac53146/uploads/origins/6708b8c6-7efb-4041-989f-f63688b6054f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4bde2088dbb3756e3b20ac3dcfd298c", "thumbnail_srcset": "https://si.imgix.net/1ac53146/uploads/origins/6708b8c6-7efb-4041-989f-f63688b6054f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4bde2088dbb3756e3b20ac3dcfd298c, https://si.imgix.net/1ac53146/uploads/origins/6708b8c6-7efb-4041-989f-f63688b6054f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7681f36d70f495b1d075eba03fe8b23e 2x, https://si.imgix.net/1ac53146/uploads/origins/6708b8c6-7efb-4041-989f-f63688b6054f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9fa1c640250daee2db6995a0d62c1d7 3x", "genre": "art", "nsfw": true, "body": "[キャラ]\n私のPSO2キャラクター\nシチュ] 人間ペット\n[コスチューム] 全裸\n[内容]\n自信満々で敵のアジトに侵入したら、そのまま監禁されて、悪魔崇拝の儀式で魔法などで犯されたりとか\n\n私のキャラクターはカルト教団を攻撃するが、彼らに簡単に倒され、召喚獣とともに彼らにレイプされる。\n\n全裸で顔を上げ、完全に敗北した彼女が横たわっている間、彼らは彼女をどうするか決める。\n\nいくつかの結末が考えられる。\n\n1. 教団の新メンバーになり、服を着ることを許されず、性奴隷になる。\n2.悪魔召喚の生贄として、すべての悪魔がセックスする性奴隷になる。\n3.カルト信者より悪い扱いを受け、性奴隷かもっと悪い動物奴隷として他の生贄に捧げられる。\n4. ガラクタ扱い\n5.私のチャラは完全に敗北し、教団は彼女を家畜として飼うことに決めた。\nでも、彼女は乳も出ないし、労働もできないし、肉もあまりないので、最後は売られてしまう。\n6.楽しそうだ。\n\n\nいくつかの結末の可能性がある。\n\nあるいは、バッド・エンドの面白いアイデアがあれば、歓迎します。\n\nhttps://drive.google.com/file/d/1nOLYx5S_luK0Gt4ItyPUyAAncVsniagd/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/243", "thumbnail_src": "https://si.imgix.net/4eda0cd3/uploads/origins/5344cdff-20ce-4975-8c1a-24f565fc0378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37a319ad1815431dcd738f491bf69641", "thumbnail_srcset": "https://si.imgix.net/4eda0cd3/uploads/origins/5344cdff-20ce-4975-8c1a-24f565fc0378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37a319ad1815431dcd738f491bf69641, https://si.imgix.net/4eda0cd3/uploads/origins/5344cdff-20ce-4975-8c1a-24f565fc0378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c23c314e3f472c01de30b1496f89b53 2x, https://si.imgix.net/4eda0cd3/uploads/origins/5344cdff-20ce-4975-8c1a-24f565fc0378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c96ec0b05d296a2cff4dd0981f99aef4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/242", "thumbnail_src": "https://si.imgix.net/f1f144b1/uploads/origins/be83004d-82ba-4337-b458-b266c074ad7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c74b2f351ba9576ffd092508958a60", "thumbnail_srcset": "https://si.imgix.net/f1f144b1/uploads/origins/be83004d-82ba-4337-b458-b266c074ad7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9c74b2f351ba9576ffd092508958a60, https://si.imgix.net/f1f144b1/uploads/origins/be83004d-82ba-4337-b458-b266c074ad7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3b2b0566b97e59aaba00b31b636ce17 2x, https://si.imgix.net/f1f144b1/uploads/origins/be83004d-82ba-4337-b458-b266c074ad7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e66d4fff6ba0c81a32bafeed3a4fd9d4 3x", "genre": "art", "nsfw": true, "body": "キャラ]\n私のキャラクター\n[シチュ]    知性の吸収と売却\n[コスチューム] 全裸\n[内容]\n私のチャラは、彼女が守るべき皆の前で戦い、敗れている。\n裸の姿を見せられ、敵に知性を吸収され、性本能だけで、人間ではないものになっていく彼女を、人々は見ている。\n\n敵はそれが終わると、彼女の裸体を捨て、必要なものを手に入れたとして、彼女の歯車を持って去っていく。\n\nその後、彼女はペットや性奴隷として連れ去られるか、知能もなく発情期の雌の獣に過ぎない現在の彼女より高値で売られる。\n\nhttps://drive.google.com/file/d/1MNI91yFd-ANf7TaM5YsNb2I_56Y3kr3y/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/241", "thumbnail_src": "https://si.imgix.net/e809d9ff/uploads/origins/139397b2-8a9b-46e6-8fdb-3cc2fb7cba46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2370107da637a6d14d146dd9175a1120", "thumbnail_srcset": "https://si.imgix.net/e809d9ff/uploads/origins/139397b2-8a9b-46e6-8fdb-3cc2fb7cba46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2370107da637a6d14d146dd9175a1120, https://si.imgix.net/e809d9ff/uploads/origins/139397b2-8a9b-46e6-8fdb-3cc2fb7cba46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4ecc07bd4afba8de23c3bc74057144f 2x, https://si.imgix.net/e809d9ff/uploads/origins/139397b2-8a9b-46e6-8fdb-3cc2fb7cba46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f8a556d0c9d60c4f0830a8d1ad63417 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレム烈火の剣からニノをリクエストします。\nFEヒーローズで披露した水着姿でお願いします。\nhttps://guide.fire-emblem-heroes.com/06029009001254-2/\n女の子座りの騎乗位で、背後から男に両胸を揉まれながら両手に別々の男の竿を扱きつつ片方の竿を咥えてる構図にしてください。\n胸元を露出し、以前描いて頂いた時(https://skeb.jp/@ZjirusiZ/works/140)と同じかなり大きめの巨乳を晒して下さい。\nワンピース型の水着と上から羽織ってるシースルーの布地を別々のレイヤーで分けて、\n行為中・中出し＆射精・事後でそれぞれ男達とニノちゃんのセリフを付けて下さい。\nキャプションのあらすじは「アスク王国の海で仲間たちと遊んでいるところにニノちゃんに狙いを定めたならず者たちに一人になった隙に攫われて…」という旨の内容でお願いします。\n\nhttps://pbs.twimg.com/media/Gtix67hbgAAlmE6?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/240", "thumbnail_src": "https://si.imgix.net/31d477cc/uploads/origins/980ab2e8-545c-4c0d-8ecd-cb4dabb9cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97d59cdb7931f6012ccc21c99e24fda7", "thumbnail_srcset": "https://si.imgix.net/31d477cc/uploads/origins/980ab2e8-545c-4c0d-8ecd-cb4dabb9cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97d59cdb7931f6012ccc21c99e24fda7, https://si.imgix.net/31d477cc/uploads/origins/980ab2e8-545c-4c0d-8ecd-cb4dabb9cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fe0020c1f9c1239e7a9a26f9eea28b8 2x, https://si.imgix.net/31d477cc/uploads/origins/980ab2e8-545c-4c0d-8ecd-cb4dabb9cc2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b23be3f8a2c2553cd52cc5f581d991d 3x", "genre": "art", "nsfw": true, "body": "[キャラ]\n私のPSO2キャラクター\nシチュ] 人間ペット\n[コスチューム] 全裸\n[内容]\n私のチャラは完全に敗北し、人間のペットと化して皆に見せびらかした。\n\n新しい飼い主は、お金を稼ぐために彼女を遊ばせ、他の動物とも交尾させる。\n\nそして、彼女が倒れたときの人々の反応を見て、行方不明になったヒロインに似ていると気づく人もいる。\n\nhttps://drive.google.com/file/d/1v_hueWIX_GwD5S7E0h9td9xfMpzgRiJ5/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/239", "thumbnail_src": "https://si.imgix.net/4359b935/uploads/origins/fc27bad0-05de-4c88-bda5-44b7bb223f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b92c8552f3be952f8137e8ed4133fc", "thumbnail_srcset": "https://si.imgix.net/4359b935/uploads/origins/fc27bad0-05de-4c88-bda5-44b7bb223f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b92c8552f3be952f8137e8ed4133fc, https://si.imgix.net/4359b935/uploads/origins/fc27bad0-05de-4c88-bda5-44b7bb223f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d5a7bdbccc3bb7c41cc16305d11203b 2x, https://si.imgix.net/4359b935/uploads/origins/fc27bad0-05de-4c88-bda5-44b7bb223f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0959ff7876008d5dcfb9287fd9dbca60 3x", "genre": "art", "nsfw": true, "body": "私のキャラクターは敵と戦うが、敗れて文字通り肉の盾にされてしまう。\n彼女の体を見せ、触手を通してエネルギーを排出し、盾の持ち主に与える魔法の盾で、受けたダメージは快楽に変わる。\n\n主な内容は、彼女の裸体が丸見えになり、触手に犯され、顔が露わになり、淫らな表情を見せるというものだ。\nそして、髪が伸びてゆるくなり、精神的に完全に敗北した状態で時間が経過することもある。\n\nhttps://drive.google.com/file/d/1Gl6gp77Mp-UegVBpylmjhJriqjl6MuxG/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/238", "thumbnail_src": "https://si.imgix.net/d2b5e59d/uploads/origins/0dd50ada-6170-40a9-94d8-22f645680a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d945e8c2c1f7c74f598fc5691bfadda", "thumbnail_srcset": "https://si.imgix.net/d2b5e59d/uploads/origins/0dd50ada-6170-40a9-94d8-22f645680a83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d945e8c2c1f7c74f598fc5691bfadda, https://si.imgix.net/d2b5e59d/uploads/origins/0dd50ada-6170-40a9-94d8-22f645680a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc12e7514dad1f15e7db27d78407eee9 2x, https://si.imgix.net/d2b5e59d/uploads/origins/0dd50ada-6170-40a9-94d8-22f645680a83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=987cce5988ec73e6faec0666a13c8bcb 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレムエンゲージからラピスをリクエストします。\nFEヒーローズで披露した水着姿でお願いします。\nhttps://guide.fire-emblem-heroes.com/14003006001256-2/\n女の子座りの騎乗位で、背後から男に両胸を揉まれながら両手に別々の男の竿を扱きつつ片方の竿を咥えてる構図にして、前方向からのアングルにしてください。\n胸元をずらし元絵よりふた回り大きい立派な胸を晒してください。\n水着の上下・シースルーの上着・太ももの飾り・帽子を別々のレイヤーで分けていただけると嬉しいです。\n\nキャプションのあらすじは「アスク王国の海で大切な人や仲間のために魚捕りに来た所を襲われ・・・」という内容でお願いします。\n\nhttps://pbs.twimg.com/media/Gtix6QfaoAAyDsQ?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/237", "thumbnail_src": "https://si.imgix.net/f8f209e7/uploads/origins/2949f260-e071-4307-9519-8f5d53679b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20544a63e03f17dc055c35116eb7c896", "thumbnail_srcset": "https://si.imgix.net/f8f209e7/uploads/origins/2949f260-e071-4307-9519-8f5d53679b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20544a63e03f17dc055c35116eb7c896, https://si.imgix.net/f8f209e7/uploads/origins/2949f260-e071-4307-9519-8f5d53679b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23b24623af37a9900d555983183b80c1 2x, https://si.imgix.net/f8f209e7/uploads/origins/2949f260-e071-4307-9519-8f5d53679b81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2511422a2783a3643a49ff8c8ffafacf 3x", "genre": "art", "nsfw": true, "body": "[キャラ]\n私のPSO2キャラクター\nシチュ] 人間失格-家畜化\n[コスチューム] 全裸\n[内容]\n私のキャラクターは、田舎の村を敵から守るために戦うが、敗れて去り、村は彼女が実際に冒険者を雇うよりも、野良犬と交尾する方が村を守るのに適していることに気づく。\n敵やその他はあなたが決めてください。\n\n#1 - 私のキャラクターは村人の前で敵から村を守るために準備しています。彼女は自信に満ち、得意げで生意気な態度です。\n\n#2 - 彼女は自分のスキルでミスを犯すか、敵が呪文を使い、すぐに彼女の武器を奪い、服を脱がせて裸にし、簡単に倒されてしまいます。\n\n#3 - その後、彼女は敵に犯され、彼らは彼女の持ち物を奪い、村の中で仰向けの裸の姿で放置します。村人たちは怒って彼女をそのままにしておきます。彼女は肉体的にも精神的にも完全に打ち負かされ、今では発情中の雌獣のようになっています。\n\n#4 - 野良犬や他の獣が来て彼女を犯し、彼女は快楽に溺れます。それが村人たちの怒りを買います。\n\n#5 - 彼女の裸体は引きずり回され、愛液の跡を残していきます。村人たちは今や彼女を野良動物のように扱います。\n\n#6 - 子供たちは彼女を動物のように扱い、彼女に乗ったり、大きな犬に繋いだりして遊びます。彼女がそこに留まり、より強い獣を誘って犯させるため、その獣たちもまた自分の縄張りを守っています。\n\n#7 - 使われていない時、彼女は公共の場で繋がれ、自分自身や獣と戯れています。別のグループの人々が通りかかり、彼女が行方不明のヒロインに似ていることに気づきますが、それを否定します。\n\nhttps://drive.google.com/file/d/1VHBPYqOdd2TqJpIfAl4_wQ8kqDF1duJM/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/236", "thumbnail_src": "https://si.imgix.net/02100de7/uploads/origins/209a9f20-33f4-4d85-9eb8-cea88c3e665c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f86fc1ae18574506daf99c931ae089d", "thumbnail_srcset": "https://si.imgix.net/02100de7/uploads/origins/209a9f20-33f4-4d85-9eb8-cea88c3e665c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f86fc1ae18574506daf99c931ae089d, https://si.imgix.net/02100de7/uploads/origins/209a9f20-33f4-4d85-9eb8-cea88c3e665c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ecd3195a9305e43c9bdfb9715f0aa18 2x, https://si.imgix.net/02100de7/uploads/origins/209a9f20-33f4-4d85-9eb8-cea88c3e665c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62bfa9f7dcf6c6772eab2a285deeee3f 3x", "genre": "art", "nsfw": true, "body": "お久しぶりです。またZ印さんに描いて欲しいVtuberさんを見つけたので、宜しければお願いしたくリクエストを送らせてもらいます。\n\nそちまる一期生、「矢筒あぽろ」さんをお願いします。\nhttps://x.com/Y_Apollo_oo/status/1613479425609437184\nURLに三面図がありますので参考にしてください。\n\n冒険者の方ですので、ならず者に敗北して凌辱されるシチュでお願いします。\n\nその他の差分などは今回Z印さんに全てお任せ致します。自由に描いて頂ければ幸いです。\nご検討のほどを宜しくお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@ZjirusiZ/works/235", "thumbnail_src": "https://si.imgix.net/68628ca3/uploads/origins/7e3872ce-3945-4b3f-9e37-29f15b65ab8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8800eea981285cd07ed84abc09994842", "thumbnail_srcset": "https://si.imgix.net/68628ca3/uploads/origins/7e3872ce-3945-4b3f-9e37-29f15b65ab8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8800eea981285cd07ed84abc09994842, https://si.imgix.net/68628ca3/uploads/origins/7e3872ce-3945-4b3f-9e37-29f15b65ab8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f8d697db3482bf42d47593a0e131fc9 2x, https://si.imgix.net/68628ca3/uploads/origins/7e3872ce-3945-4b3f-9e37-29f15b65ab8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=822ce8d346981a0d0c31cbbf0d2c0b26 3x", "genre": "art", "nsfw": true, "body": "ファイアーエムブレムエンゲージからゴルドマリーをリクエストします。\nFEヒーローズで披露した水着姿でお願いします。\nhttps://guide.fire-emblem-heroes.com/14004007001113-2/\nhttps://static.wikia.nocookie.net/feheroes_gamepedia_en/images/0/08/Goldmary_Coy_Beach_Divas_BtlFace.webp/revision/latest?cb=20240704074800\n女の子座りの騎乗位で、背後から男に両胸を揉まれながら両手に別々の男の竿を扱きつつ片方の竿を咥えてる構図にしてください。\nまた背景に小さく映る形で相方のベルちゃんを他の男達が相手しているようにしてください。\n前回(https://skeb.jp/@ZjirusiZ/works/180)のようにベルちゃんは立派な巨乳ですがゴルドマリーはそんなベルちゃんをゆうに超える立派な爆乳に盛ってください。また、全身の精液の量も前回のベルちゃんよりもたくさんぶっかけられてるようにして下さい。\n帽子と水着の上下、パレオを別レイヤーに分けていただくとありがたいです。\nキャプションのあらすじは前回のゴルドマリー側という形の内容で改めてお願いします。\n\n\nhttps://pbs.twimg.com/media/GRockdibMAIrGPb?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}]}