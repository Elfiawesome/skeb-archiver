56447488%2F_AEoTdQr.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04112975a52a7f938fb20f790b0e4308, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1603036084656447488%2F_AEoTdQr.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ab97c8100c8db245ce7919ed216730a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1603036084656447488%2F_AEoTdQr.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57bb8521fad5f60dedb2e07d892e1c03 3x", "genre": "music", "nsfw": false, "body": "こんにちは！\nあなたの音楽が大好きで、私のストリームのために音楽を作ってもらえないかお願いしたいのです！\nストリームのオープニングやエンディングに使いたいと思います。2～3分くらいで。\n\n音楽がフィットするリファレンスはこちらです：\nhttps://skeb.jp/@shieriru_55/works/182\n\n場面は、多くの冒険者が探検に行く魔法の森。そこで私のキャラクターである夜桜が彷徨っている。彼はかつて人間だったが、この森を守る魔法のフクロウの加護を受けた。\n\n私のキャラクターは穏やかで親切な性格で、物語を語りたい人にいつも耳を傾けてくれる。\n私のストリームは、落ち着いた環境で3Dアートを作ったり、リズムゲームをプレイすることが中心です。\n\nリファレンスシートはこちら：\nhttps://drive.google.com/drive/folders/1yz8L7Hw0uDzX0vK2rJ-XmQ2ZyLyD-kpc?usp=drive_link\n\n音楽スタイルは自由ですが、ジャズや雰囲気のある音楽が好きです。ただ、ループができれば最高です。また、曲の中盤にかけて盛り上がっていくのも嫌いではありません。だから、曲全体を通してスローである必要はない。", "created_at": "", "completed_at": ""}, {"path": "/@You_uta1/works/166", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1603036084656447488%2F_AEoTdQr.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23b49f02f62b4020bf5ff69afc1bb4bb", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1603036084656447488%2F_AEoTdQr.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23b49f02f62b4020bf5ff69afc1bb4bb, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F16030