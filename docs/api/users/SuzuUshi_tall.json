faab039bd49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe54d79b6b8b8630484ac4978b49894d 2x, https://si.imgix.net/ceb74d10/uploads/origins/bb867aab-d05a-4663-af65-4faab039bd49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5b101440c8425cb479dce6b2fc294b20 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@SuzuUshi_tall/works/20", "thumbnail_src": "https://si.imgix.net/0abc2ea8/uploads/origins/cb8306b4-9ec7-4f99-87d8-f4a429826187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0be2fd9bf246cd717bf646a76d382795", "thumbnail_srcset": "https://si.imgix.net/0abc2ea8/uploads/origins/cb8306b4-9ec7-4f99-87d8-f4a429826187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0be2fd9bf246cd717bf646a76d382795, https://si.imgix.net/0abc2ea8/uploads/origins/cb8306b4-9ec7-4f99-87d8-f4a429826187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9549bb60975fcb6477397fe65e7ecb4d 2x, https://si.imgix.net/0abc2ea8/uploads/origins/cb8306b4-9ec7-4f99-87d8-f4a429826187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4b7b8a9c38ed27019a8a02813b5a914 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたのアートが大好きなので、また戻ってきました！\n\nVtuberのポコらくん(1)を描いてください！ドヤ顔でお絵かきタブレットでお絵かきしているタヌキ泥棒です！服装、お絵かきタブレット、メガネ、ブランケット、お絵かきペンはこんな感じ(2)。彼女の周りには、彼女が描いているものを見ているファンたちがいる(3)。できれば、彼女が描いているものが魔法であるかのように、タブレットから視覚効果を出してほしい！\n\n作品の解像度は16:9でお願いします！\n\n参考文献\n\nhttps://drive.google.com/drive/folders/1ngDzL2AMnZCp47bWlRoRnzg-lvOBy5DG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@SuzuUshi_tall/works/19", "thumbnail_src": "https://si.imgix.net/a9345e91/uploads/origins/424ee466-3944-4c7d-bdc5-abdcbcacc711