)\n\nhttps://lit.link/Kazumin", "created_at": "", "completed_at": ""}, {"path": "/@Gramgarage9/works/15", "thumbnail_src": "https://si.imgix.net/4915e529/uploads/origins/241cfd8b-c751-44a9-93ff-82d5950cf381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcddab761106ddc96212760b07d79409", "thumbnail_srcset": "https://si.imgix.net/4915e529/uploads/origins/241cfd8b-c751-44a9-93ff-82d5950cf381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcddab761106ddc96212760b07d79409, https://si.imgix.net/4915e529/uploads/origins/241cfd8b-c751-44a9-93ff-82d5950cf381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8e9d95431d6987cc191626287595d1b 2x, https://si.imgix.net/4915e529/uploads/origins/241cfd8b-c751-44a9-93ff-82d5950cf381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6d20958002bcc9437373b6e2a8d3356 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Gramgarage9/works/14", "thumbnail_src": "https://si.imgix.net/536c27fe/uploads/origins/889c8917-c73e-4f92-9c37-81f6830f74f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fa3c94258fcc3bc75b5c1ce310daa52", "thumbnail_srcset": "https://si.imgix.net/536c27fe/uploads/origins/889c8917-c73e-4f92-9c37-81f6830f74f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fa3c94258fcc3bc75b5c1ce310daa52, https://si.imgix.net/536c27fe/uploads/origins/889c8917-c73e-4f92-9c37-81f6830f74f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ccb