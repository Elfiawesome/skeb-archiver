d_at": "", "completed_at": ""}, {"path": "/@sinkaikiiro/works/43", "thumbnail_src": "https://si.imgix.net/9ce8c128/uploads/origins/712b8b62-ded8-4a20-833d-db08033669c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e47d4b088ac215be8c8954aec648dbd", "thumbnail_srcset": "https://si.imgix.net/9ce8c128/uploads/origins/712b8b62-ded8-4a20-833d-db08033669c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e47d4b088ac215be8c8954aec648dbd, https://si.imgix.net/9ce8c128/uploads/origins/712b8b62-ded8-4a20-833d-db08033669c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ee59d8c14b6edadb6bc41911c3607d1 2x, https://si.imgix.net/9ce8c128/uploads/origins/712b8b62-ded8-4a20-833d-db08033669c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b91feb86ec01ba5e12ff292e086db5d 3x", "genre": "art", "nsfw": true, "body": "はじめまして、イラストの雰囲気が好みだったので依頼させていただきました。  今回お願いしたいのはゲームで使用しているアバターのイラストです。 構図はベッドのヘリにネクタイで両手を重ねて縛られた状態でチェーンで繋いだ乳首ピアスを引っ張られながら犯されているイラストをお願いしたいです。 正の字や隠語等の落書きされている差分があると嬉しいです。 表情や髪型、アクセサリ等はアレンジして構いません。 資料はリンクのツイートのリプ欄になります。   よろしくお願いします！\n\nhttps://twitter.com/no_oyatsu/status/1584513421768204288?s=46&t=Ek", "created_at": "", "completed_at": ""}]}