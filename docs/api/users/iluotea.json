します。\n\n構図\n海岸沿いを右側から左方向へと進むような形。\nキャップのツバ裏が見える程度のアオリ構図で、バイト代金で買った中古のウォークマンを聞きながら少し朗らかに歩いています。\nやがて日の射す朝早い時間帯、陽光の日の下へ自ら歩いていく様なサオリの、温かな未来を暗示させるような、そんなイラストをお願いします。\n\nhttps://x.com/takepresident/status/1749025334845194246?t=xueo2NxwBvbjS-UOQQ_D8A&s=19", "created_at": "", "completed_at": ""}, {"path": "/@iluotea/works/6", "thumbnail_src": "https://si.imgix.net/54ffca9e/uploads/origins/95e9e4de-8b33-44e4-9a59-ede4be38cdb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01c726d867a7f3dd03868a7edbc73adc", "thumbnail_srcset": "https://si.imgix.net/54ffca9e/uploads/origins/95e9e4de-8b33-44e4-9a59-ede4be38cdb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01c726d867a7f3dd03868a7edbc73adc, https://si.imgix.net/54ffca9e/uploads/origins/95e9e4de-8b33-44e4-9a59-ede4be38cdb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=591156abc7f8d5e648648f8669d245ca 2x, https://si.imgix.net/54ffca9e/uploads/origins/95e9e4de-8b33-44e4-9a59-ede4be38cdb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b9e36e6030e929b15429ada81f83e32 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@iluotea/works/5", "thumbnail_src": "https://si.imgix.net/4562453d/uploads/origins/4aa223d5-9025-4aea-87e0-f3eb6786155e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff4fe53f225bd38e72177886b99215e7", "thumbnail_srcset": "https://si.imgix.net/4562453d/uploads/origins/4aa223d