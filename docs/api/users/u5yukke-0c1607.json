23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d59cd808c0a7964b01d5f3fde0ab4bc6, https://si.imgix.net/002a788e/uploads/origins/555b3436-bc35-4951-a7b8-c7cdcdf92903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39f7948cdee4cbac471f49596f2572ad 2x, https://si.imgix.net/002a788e/uploads/origins/555b3436-bc35-4951-a7b8-c7cdcdf92903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b185975fc6a03e03f8128e08e63efae8 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のVtuberを以下の表現で背景を透明にして描いていただけませんか？\n\n(1) 拒否\n(2) 頭をなでる\n(3) リンゴを食べる\n(4) 怒っている\n(5) 悲しい\n(6) こわい\n\n使用目的：twitch & discord emote\nそれが許容される場合のみ承認してください。\n\nhttps://drive.google.com/drive/folders/1Xpkbffb3nfUbcQQzucmLpMMQR3ZnPWcy?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@u5yukke/works/40", "thumbnail_src": "https://si.imgix.net/15d0000d/uploads/origins/ee516013-89b5-4c04-a43c-fe893a461bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf21e8adc846937e26e5eefecfe18fe1", "thumbnail_srcset": "https://si.imgix.net/15d0000d/uploads/origins/ee516013-89b5-4c04-a43c-fe893a461bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf21e8adc846937e26e5eefecfe18fe1, https://si.imgix.net/15d0000d/uploads/origins/ee516013-89b5-4c04-a43c-fe893a461bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb719ba4a9adf07360fa77629edaadab 2x, https://si.imgix.net/15d0000d/uploads/origins/ee516013-89b5-4c04-a43c-fe893a461bc2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b5f01c2d377d01d2ab760bdc21f6948 3x", "genre": "art", "nsfw": false, "body": "こんにちは。^^\n\n私のVtuberのモデルのチビを6人お願いしたいです。彼女は猫娘の太陽神で、両手のクレイモアを操る。ポーズはこんな感じでお願いします。\n\n- 楽しそうに手を振る\n- マッド\n- 眠っている\n- 汗をかく、緊張する\n- ハートを持つ\n- 両手で武器を持ち、微笑む\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1k0mB7uzftMNsIHGuo_FlZHPY0wWdjV_-?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@u5yukke/works/39", "thumbnail_src": "https://si.imgix.net/10f2fbff/uploads/origins/57b3bff0-ca05-475d-893d-02f4edc26522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41f9954ecaa884df3413ff422f032ff0", "thumbnail_srcset": "https://si.imgix.net/10f2fbff/uploads/origins/57b3bff0-ca05-475d-893d-02f4edc26522?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41f9954ecaa884df3413ff422f032ff0, https://si.imgix.net/10f2fbff/uploads/origins/57b3bff0-ca05-475d-893d-02f4edc26522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ebe6d731d3d43cd7f9892cbab327b08 2x, https://si.imgix.net/10f2fbff/uploads/origins/57b3bff0-ca05-475d-893d-02f4edc26522?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5dff7790d027f076533fda2c1a1a635 3x", "genre": "art", "nsfw": false, "body": "初めまして！ よろしければ、\n私のFFXIVのキャラクターのミニキャラを描いていただけないでしょうか。\n\n【キャラクター資料】 https://drive.google.com/drive/folders/1sreajRWcAyHgARAjBEyByGA5gmPJ8EHY?usp=sharing\n\nhttps://drive.google.com/drive/folders/1sreajRWcAyHgARAjBEyByGA5gmPJ8EHY?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@u5yukke/works/38", "thumbnail_src": "https://si.imgix.net/5d1a2ae2/uploads/origins/faed467e-d615-4fcc-93d9-3f7e61ccf472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93813176aed9837ca2adaac687cf3ed9", "thumbnail_srcset": "https://si.imgix.net/5d1a2ae2/uploads/origins/faed467e-d615-4fcc-93d9-3f7e61ccf472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93813176aed9837ca2adaac687cf3ed9, https://si.imgix.net/5d1a2ae2/uploads/origins/faed467e-d615-4fcc-93d9-3f7e61ccf472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bb7a653a977c935aa04f1738070ab34 2x, https://si.imgix.net/5d1a2ae2/uploads/origins/faed467e-d615-4fcc-93d9-3f7e61ccf472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b