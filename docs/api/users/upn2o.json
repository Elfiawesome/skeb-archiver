ders/1lMPGrsFL3s1Ld-tdcZi6HlM9VRF-yPLE", "created_at": "", "completed_at": ""}, {"path": "/@upn2o/works/9", "thumbnail_src": "https://si.imgix.net/3886c5a3/uploads/origins/bbdb8968-087b-40cf-bc57-a63ef834f35d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34855de0ff5b7e69d531fd4df884137c", "thumbnail_srcset": "https://si.imgix.net/3886c5a3/uploads/origins/bbdb8968-087b-40cf-bc57-a63ef834f35d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34855de0ff5b7e69d531fd4df884137c, https://si.imgix.net/3886c5a3/uploads/origins/bbdb8968-087b-40cf-bc57-a63ef834f35d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4942b09e778b3478d8ba5dd1b44cf5e5 2x, https://si.imgix.net/3886c5a3/uploads/origins/bbdb8968-087b-40cf-bc57-a63ef834f35d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6f116629981a3c1e61ab2967a7580a9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！私のキャラクターの絵を注文したいです！\nhttps://drive.google.com/file/d/1iexZ8TT4QpSVCsVYEQWlsymZEo7GsIlo/view?usp=drivesdk\n\n\nこんなポーズで描いてもらえますか？ https://drive.google.com/file/d/1lYpX2ipteGVKkbVT9s3i_By6MUdOPPgj/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@upn2o/works/8", "thumbnail_src": "https://si.imgix.net/b37df29f/uploads/origins/87be1fc7-e256-4943-b471-d494fc1200bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f75dbb5fcdad16ee8fe61ac06d973b54", "thumbnail_srcset": "https://si.imgix.net/b37df29f/uploads/origins/87be1fc7-e256-4943-b471-d494fc1200bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f75dbb5fcdad16ee8fe61ac06d973b54, https://si.imgix.net/b37df29f/uploads/origins/87be1fc7-e256-4943-b471-d494fc1200bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c936e7c546a2643dde0cad880440465c 2x, https://si.imgix.net/b37df29f/uploads/origins/87be1fc7-e256-4943-b471-d494fc1200bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc72c5da425ff75bdb1940486a1a9740 3x", "genre": "art", "nsfw": false, "body": "今年はとても素敵なイラスト、誠にありがとうございました！\nもし宜しければ、いねかりたんぼを描いていただけると嬉しいです🥹\n髪型▶︎手癖で短さ長さアレンジ等可能です🙆‍♀️\n商用込み(キラキラプロダクション公式グッズ用)がもし可能なようでしたら、お受け頂けますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1zgFcaKQ-HJHxnp_ZhUThrPcxg6_gfv0c/view?usp=drivesdk", "created_at": "", "completed_at": ""}, {"path": "/@upn2o/works/7", "thumbnail_src": "https://si.imgix.net/305ddafb/uploads/origins/e7c0c68a-5756-4df5-b0b3-4507f8c1b45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5b75f8e6cca0c251bfa07da60ddfa0f", "thumbnail_srcset": "https://si.imgix.net/305ddafb/uploads/origins/e7c0c68a-5756-4df5-b0b3-4507f8c1b45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5b75f8e6cca0c251bfa07da60ddfa0f, https://si.imgix.net/305ddafb/uploads/origins/e7c0c68a-5756-4df5-b0b3-4507f8c1b45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8be72f8814c0472ede54c0f84bd9a9b8 2x, https://si.imgix.net/305ddafb/uploads/origins/e7c0c68a-5756-4df5-b0b3-4507f8c1b45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b14b4a4f3e1b37321e332d4163d19132 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@upn2o/works/6", "thumbnail_src": "https://si.imgix.net/1ac85414/uploads/origins/6cd20e8b-5c5a-4e62-9314-498342faded7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16f767c0b0779824b83a33213120dcc2", "thumbnail_srcset": "https://si.imgix.net/1ac85414/uploads/origins/6cd20e8b-5c5a-4e62-9314-498342faded7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16f767c0b0779824b83a33213120dcc2, https://si.imgix.net/1ac85414/uploads/origins/6cd20e8b-5c5a-4e62-9314-498342faded7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7df6391ba92083c55ecc89368b6c7651 2x, https://si.imgix.net/1ac85414/uploads/origins/6cd20e8b-5c5a-4e62-9314-498342faded7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e6775cfe9948639d6bd1a9134899a9c 3x", "genre": "art", "nsfw": false, "body": "初めまして、うみゃちゃと申します。 \nXで拝見した作品がとても可愛かったため、リクエストさせていただきます。  \n\n・要望\nOC2名の全体衣装デザイン\nとにかく装飾モリモリでお願いしたいです。\n拝見したイラストの太ももの感じがとても素敵だったので見れると嬉しいです\nポーズや構図、ヘアアレンジ等はお任せします。\n\n 背景透過or psdもお願いしたいです。  \n\n・参考資料 https://drive.google.com/drive/folders/1-EEDT9i8A5djBv4VgRf7cPAkNK43XqOg  \n\n・詳細文\n OC ① ソル\n・髪 \nふわふわもこもこの赤髪  \n前髪はセンター分け風 \n・目\n切れ長のネコ目(ハイライトは十字のキラキラ) \n薄い水色 \n・口元にほくろ \n・モノクルかけてる  \n\n常に笑顔で優しくリーダーシップのある子 \n得意武器はライフル銃(長い銃)\n\nOC② カロン\n・髪 \nストレートロング (腰より下) \n濃いめの水色(少しくすんでいる) \n前髪は流している サイドは姫カット\n\n ・目 \nタレ目 ぱっちり 灰色  \n\n正義感はあるが口下手で表情がぎこちない\n (①の前ではコロコロ変わる) \n得意武器はショットガン(短い銃)\n\n ・使用用途 　\n頂いたイラストはSNSアイコンや参考資料への追加pc背景に使用したいと思っています。  \n\nもし難しいようでしたら断っていただいて大丈夫です。\nとっても好きな絵柄なのでどうぞご縁がありましたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@upn2o/works/5", "thumbnail_src": "https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b066cd736f3210939e598ae97471c9db", "thumbnail_srcset": "https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b066cd736f3210939e598ae97471c9db, https://si.imgix.net/4aea687c/uploads/origins/234155cf-2e03-49a2-a7b8-7fe6b337d330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8410b510c3394dc5eca114f2cb9b5423 2x, https://si.imgix.net/4aea6