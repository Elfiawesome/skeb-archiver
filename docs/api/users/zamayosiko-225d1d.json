=200&s=9eff5c282e857217b0cf0c9ab6a0aaa9, https://si.imgix.net/e878c01d/uploads/origins/fe5ca988-9410-40d7-af6c-95682bfd41f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59f0059b271d256788a6698549b7f1dc 2x, https://si.imgix.net/e878c01d/uploads/origins/fe5ca988-9410-40d7-af6c-95682bfd41f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d8e91faba64dd0731c9782a2d97d9e6 3x", "genre": "art", "nsfw": false, "body": "霧島竜胆描いてください…私服がいい\n \n\nhttps://drive.google.com/drive/folders/1t9W6xJ-akeyamawrIfNa5B8RIzYSi80D?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@zamayosiko/works/4", "thumbnail_src": "https://si.imgix.net/fd17da65/uploads/origins/281581ce-7d71-4356-92a8-fadef75b06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29be1b8ff740007713a966d7ff6d27f3", "thumbnail_srcset": "https://si.imgix.net/fd17da65/uploads/origins/281581ce-7d71-4356-92a8-fadef75b06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29be1b8ff740007713a966d7ff6d27f3, https://si.imgix.net/fd17da65/uploads/origins/281581ce-7d71-4356-92a8-fadef75b06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8417a03296e4dfd400ad34dc3d56a8a3 2x, https://si.imgix.net/fd17da65/uploads/origins/281581ce-7d71-4356-92a8-fadef75b06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90e941f7ac0f5ac04396ae7c5f8ae34f 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n新着作品にてイラストをお見かけし、とても素敵な絵柄と感じたため、もしご都合がよろしければ私の創作キャラクターを描いて頂きたいと思いリクエストお送りします。\n\nキャラクターについて：\n双子の兄弟。外見や詳細な性格は下記資料の画像を参考にしてください。白髪が兄、黒髪が弟です。\n兄は明るく温和で弟の事を愛している、弟はそんな兄のことを少し面倒に思っているといった設定で、ブロマンスに近い雰囲気です。\n\n構図、シチュエーション等について：\n指定は特にありませんので、資料内の画像を参考にして頂いたり、お好きに描いて頂ければと思います。\n宛名のレイヤーを別にしたpsd形式の納品でお願いいたします！\n\n個人観賞以外の使用用途：\nSkeb依頼の際の資料、SNSアイコン\n\nhttps://drive.google.com/drive/folders/1oxXEr5gXMzo_X-AZBp36fYoUSQMJ9h_S?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@zamayosiko/works/3", "thumbnail_src": "https://si.imgix.net/20785769/uploads/origins/6a58337a-e3f1-450f-86b1-85a8817c2d56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e3207845eb7fa8b4b384f3eadd6fd9", "thumbnail_srcset": "https://si.imgix.net/20785769/uploads/origins/6a58337a-e3f1-450f-86b1-85a8817c2d56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e3207845eb7fa8b4b384f3eadd6fd9, https://si.imgix.net/20785769/uploads/origins/6a58337a-e3f1-450f-86b1-85a8817c2d56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7424f821cd652e4c9eea9d901627b2a 2x, https://si.imgix.net/20785769/uploads/origins/6a58337a-e3f1-450f-86b1-85a8817c2d56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29975627587d25b141cfed49a6477017 3x", "genre": "art", "nsfw": false, "body": "1Rくん描いてもらえますか？\nゲームしてるとこがいいです！\n\n全員じゃなくていいし諸々好きにしてもらって大丈夫です、よろしくお願いします。\n\nhttps://twitter.com/yu_tuki_3/status/1607393216818712579?t=luy6Cm4i-lvnipQ-_cFtzw&s=19", "created_at": "", "completed_at": ""}, {"path": "/@zamayosiko/works/2", "thumbnail_src": "https://si.imgix.net/8b480655/uploads/origins/88a4ae36-0780-41be-87e8-b91c74345ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11700dd8f4b9a2b3801fcc38933377df", "thumbnail_srcset": "https://si.imgix.net/8b480655/uploads/origins/88a4ae36-0780-41be-87e8-b91c74345ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11700dd8f4b9a2b3801fcc38933377df, https://si.imgix.net/8b480655/uploads/origins/88a4ae36-0780-41be-87e8-b91c74345ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=115c742a621a1f5468d49eb53b60149e 2x, https://si.imgix.net/8b480655/uploads/origins/88a4ae36-0780-41be-87e8-b91c74345ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d10bb1777e4ce5edfbcde15247d552d6 3x", "genre": "art", "nsfw": false, "body": "こんにちは。先日オリジナルの探索者のイラストを依頼させて頂いた者です。とても素敵な作品を本当にありがとうございました！今回もぜひまたざま様に依頼させて頂きたく、ご連絡した次第です。\n\n依頼内容ですが、前回と同様、オリジナルの探索者を二人描いて頂きたいです。構図や衣装などは指定いたしませんので好きに描いて頂けますと幸いです。設定をまとめたツイートを添付いたしますので別途ご確認頂けたらと存じます。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/intro___don/status/1587756164712116224?s=46&t=WjsQnIfDikslVHMqlsUuJQ", "created_at": "", "completed_at": ""}, {"path": "/@zamayosiko/works/1", "thumbnail_src": "https://si.imgix.net/1822ea04/uploads/origins/e993cf98-5616-48a8-9e1e-030ef993f30d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f8b643a503ee77fd95bf4705c5b0441", "thumbnail_srcset": "https://si.imgix.net/1822ea04/uploads/origins/e993cf98-5616-48a8-9e1e-030ef993f30d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f8b643a503ee77fd95bf4705c5b0441, https://si.imgix.net/1822ea04/uploads/origins/e993cf98-5616-48a8-9e1e-030ef993f30d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88ca6902c96689679b238a1ad9bf5f4f 2x, https://si.imgix.net/1822ea04/uploads/origins/e993cf98-5616-48a8-9e1e-030ef993f30d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=546dc7166c6635e339dd83dc5e722f39 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}