7176a74e6dea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb141a4081148954da2b42985457d12c, https://si.imgix.net/9fe82b2e/uploads/origins/ad71b5e3-76fa-46e2-abe5-7176a74e6dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e6e2095431646fe5738aa84a1af383e 2x, https://si.imgix.net/9fe82b2e/uploads/origins/ad71b5e3-76fa-46e2-abe5-7176a74e6dea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce03260261ae0f3ac7a7f1e61faf9dbb 3x", "genre": "art", "nsfw": true, "body": "パメラ・アンダーソンさん主演の映画でお馴染みの「バーブ・ワイヤー」の\nバーブ・ワイヤーのおねショタをお願いします。未精通の少年をホテルに連れこんで\nベッドで精通させて少年の童貞を奪う逆レイプ騎乗位をお願いします。バーブ・ワイヤーは両方、乳首が丸見えの半裸でお願いします。台詞と喘ぎ声もお任せします。\n差分の二枚目も可能であれば\n一時間後の中出し三発目五秒前と言うシチュエーションとして\n全裸で。こちらも二枚目に相応しい台詞と喘ぎ声はお任せします。\nこちらの作品の二枚目の騎乗位イラストみたいにお願いします。\nhttps://www.pixiv.net/artworks/80335484\nバーブワイヤーの衣装の参考画像置いておきます。絵柄はリアルじゃなくて大丈夫ですよ。\nhttps://ibb.co/v38YPwK", "created_at": "", "completed_at": ""}, {"path": "/@0_hologram_0/works/2", "thumbnail_src": "https://si.imgix.net/d76f0626/uploads/origins/b045f4cf-e822-4ffe-8227-a9df05cd687d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ed2485f6f2d67b875da15706e74261", "thumbnail_srcset": "https://si.imgix.net/d76f0626/uploads/origins/b045f4cf-e822-4ffe-8227-a9df05cd687d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00ed2485f6f2d67b875da15706e74261, https://si.imgix.net/d76f0626/uploads/origins/b045f4cf-e822-4ffe-8227-a9df05cd687d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a035e3dfe08f6108da171b0bd0aedc04 2x, https://si.imgix.net/d76f0626/uploads/origins/b045f4cf-e822-4ffe-8227-a9df05cd687d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a68710d8e4adb29ef1187ecbe76cc3e6 3x", "genre": "art", "nsfw": true, "body": "どうもこんにちわ。\nベリーダンス衣装を着て汗かきながら楽しそうに踊っている女性のイラストをお願いしたいです。\n\n○キャラクター\n栗色ヘアで、髪型はロングの一本に纏めた三つ編み\n年齢はアラフォーくらい\n胸が大きい(Hカップくらい)\nダンスで鍛えているので年齢の割に身体が引き締まっているが、太ももは鍛え過ぎたのか太め\nツリ目で細目、片方の目の下に泣きぼくろがある\n\n○衣装\n以下の参考画像のようなベリーダンス衣装\nhttp://www.bellydance1001nights.com/?pid=140103703\n色は緑色で、細かい模様などは大変だと思うので省略して描いて頂いて構いません\n\n○シチュエーション・構図\n体形維持のためベリーダンス教室に通い始めたが、リズムに乗って身体を動かす楽しさから本格的に踊りにハマった\nダンスイベントに向けての踊りの練習中で、ステージ上で汗をかきながら笑顔で決めポーズをしているところ\n下から踊っている女性を見上げるようなアングルでお願いします\n\n以上です。\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@0_hologram_0/works/1", "thumbnail_src": "https://si.imgix.net/10800764/uploads/origins/553275a3-fa34-42da-9f26-641cb6d1762e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f19ede398e3b841d763f12b263eb646b", "thumbnail_srcset": "https://si.imgix.net/10800764/uploads/origins/553275a3-fa34-42da-9f26-641cb6d1762e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f19ede398e3b841d763f12b263eb646b, https://si.imgix.net/10800764/uploads/origins/553275a3-fa34-42da-9f26-641cb6d1762e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae735e0b981eba647e9e0c311af8a11e 2x, https://si.imgix.net/10800764/uploads/origins/553275a3-fa34-42da-9f26-641cb6d1762e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d07b0a0c43f29ef9455f60df7473048 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}