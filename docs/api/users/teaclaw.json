395-8259-4a62-b553-6238e16fc5c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72352681059c1ef35704741e3a56a9ad 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/13", "thumbnail_src": "https://si.imgix.net/e7e64970/uploads/origins/f70ddad3-6a0d-47a9-9877-e0ae51a8c264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e67a36cc3d1fa29d2ef0e54f7dc0f99", "thumbnail_srcset": "https://si.imgix.net/e7e64970/uploads/origins/f70ddad3-6a0d-47a9-9877-e0ae51a8c264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e67a36cc3d1fa29d2ef0e54f7dc0f99, https://si.imgix.net/e7e64970/uploads/origins/f70ddad3-6a0d-47a9-9877-e0ae51a8c264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df047d8e21818a4c97386834e8ecc083 2x, https://si.imgix.net/e7e64970/uploads/origins/f70ddad3-6a0d-47a9-9877-e0ae51a8c264?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f86badb5fe89c5114713269cfd4a6321 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/12", "thumbnail_src": "https://si.imgix.net/5ed8e111/uploads/origins/6936b81e-30d0-4d28-972d-b929845b4907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f72227245bdfa710b88041e460f5e65", "thumbnail_srcset": "https://si.imgix.net/5ed8e111/uploads/origins/6936b81e-30d0-4d28-972d-b929845b4907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f72227245bdfa710b88041e460f5e65, https://si.imgix.net/5ed8e111/uploads/origins/6936b81e-30d0-4d28-972d-b929845b4907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d32a78803a942e51f0747b2f98ffcf4 2x, https://si.imgix.net/5ed8e111/uploads/origins/6936b81e-30d0-4d28-972d-b929845b4907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b23446baadfca851b3a410df4b87541c 3x", "genre": "art", "nsfw": false, "body": "はじめまして　絵を拝見しウマ娘のヴィルシーナをお描きしてもらいたいと思いご依頼させていただきました。\n用途として完全個人用の抱き枕カバー用のイラストをお描きしてもらいたいと思っており、服装は艦これの島風の服で。体勢は仰向けで背景はベッド、顔の上に手が来ないようにお願いします。表情違いのpsdが欲しいです。\n解像度はpixivfactory想定の5,217 x 16,044でお願いします。\nこちらがテンプレートになります。\nhttps://factory.pixiv.net/design_templates/factory_body_pillow_tpl.png\n\n\nご検討いただけますと幸いです。\n\nhttps://umamusume.jp/character/verxina", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/11", "thumbnail_src": "https://si.imgix.net/75e07dbd/uploads/origins/63ac16b5-c3b7-4c25-8ae1-7856eee41cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0002f622f172eb598b44efaaa255c82", "thumbnail_srcset": "https://si.imgix.net/75e07dbd/uploads/origins/63ac16b5-c3b7-4c25-8ae1-7856eee41cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0002f622f172eb598b44efaaa255c82, https://si.imgix.net/75e07dbd/uploads/origins/63ac16b5-c3b7-4c25-8ae1-7856eee41cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=222a8ee8497f2b84649af915c44df97f 2x, https://si.imgix.net/75e07dbd/uploads/origins/63ac16b5-c3b7-4c25-8ae1-7856eee41cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ab4b48e3614add66ee5bf73871c56d7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/10", "thumbnail_src": "https://si.imgix.net/b553b3cb/uploads/origins/301bd55e-7150-4a22-af93-0cc556b74a42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84240df9e27f185d016051eee849539f", "thumbnail_srcset": "https://si.imgix.net/b553b3cb/uploads/origins/301bd55e-7150-4a22-af93-0cc556b74a42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84240df9e27f185d016051eee849539f, https://si.imgix.net/b553b3cb/uploads/origins/301bd55e-7150-4a22-af93-0cc556b74a42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1eeed19fb7a9d14330036c6fbfaa2c92 2x, https://si.imgix.net/b553b3cb/uploads/origins/301bd55e-7150-4a22-af93-0cc556b74a42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8856dba2a5dacf4e6d27ee59a5e56039 3x", "genre": "art", "nsfw": false, "body": "できることなら、ドルフィンのパンツを履いたセイウンスカイが見たい。具体的なシナリオはお任せしますが、ダラダラした彼女というキャラクター設定がとても好きです！\n清雲さんの脚の描き方がとても好きなので、私の好きなショートパンツを履いた清雲スカイの脚を勝手にリクエストします", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/9", "thumbnail_src": "https://si.imgix.net/0afdaec7/uploads/origins/e66de30a-589a-4305-999a-6abe02f9dddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c01058c9a4107c20138e17419592ca", "thumbnail_srcset": "https://si.imgix.net/0afdaec7/uploads/origins/e66de30a-589a-4305-999a-6abe02f9dddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c01058c9a4107c20138e17419592ca, https://si.imgix.net/0afdaec7/uploads/origins/e66de30a-589a-4305-999a-6abe02f9dddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1ae483b71a616bdf3aee89c97d0f5af 2x, https://si.imgix.net/0afdaec7/uploads/origins/e66de30a-589a-4305-999a-6abe02f9dddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7793e6d7fca161fc917b074caf2eed03 3x", "genre": "art", "nsfw": false, "body": "Twitterでライトオのイラストを拝見して惹かれたので依頼させていただきます\n\n海岸に居る水色ビキニ姿のデアリングタクトをお願いします\nイメージとしてはトレーナーと2人で海へ遊びに来て、タクトが着替えてビキニ姿を見せに来たのをトレーナー目線で見ているようなシチュです\nポーズ、背景、ビキニのデザインなどはお任せしますが照れて恥ずかしそうな顔、トレーナーの体などは入れずタクトがビキニ姿と分かる構図でお願いします\n\n可能でしたら白ワンピースを上に着てビキニが透けている差分もお願いします", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/8", "thumbnail_src": "https://si.imgix.net/e9290b51/uploads/origins/8bd1ab88-6843-41c1-97d6-6a1611451a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586da9f74f483a609bc5ee5284651126", "thumbnail_srcset": "https://si.imgix.net/e9290b51/uploads/origins/8bd1ab88-6843-41c1-97d6-6a1611451a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=586da9f74f483a609bc5ee5284651126, https://si.imgix.net/e9290b51/uploads/origins/8bd1ab88-6843-41c1-97d6-6a1611451a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c45cff0ea945394ee7ddacda079469e7 2x, https://si.imgix.net/e9290b51/uploads/origins/8bd1ab88-6843-41c1-97d6-6a1611451a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ba2c3af7b23e20e7c3c818ac8b60921 3x", "genre": "art", "nsfw": false, "body": "こんにちは。この度はリクエストさせていただきます。\nキャラは泡瀬満里南。パワプロ体型ではなくskeb,pixivにあるイラストのようにリアル頭身でお願いします。\n衣装はシンプルなスク水。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/7", "thumbnail_src": "https://si.imgix.net/6b075d72/uploads/origins/71c6f686-22c5-4e08-ac7c-4429dc8a36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cecb65af3f26fd2dbcfba4c8e199ad25", "thumbnail_srcset": "https://si.imgix.net/6b075d72/uploads/origins/71c6f686-22c5-4e08-ac7c-4429dc8a36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cecb65af3f26fd2dbcfba4c8e199ad25, https://si.imgix.net/6b075d72/uploads/origins/71c6f686-22c5-4e08-ac7c-4429dc8a36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd7730e5e672712779b4d01901a00f7a 2x, https://si.imgix.net/6b075d72/uploads/origins/71c6f686-22c5-4e08-ac7c-4429dc8a36bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e6818b93973fadc96e2d46162b0e362 3x", "genre": "art", "nsfw": false, "body": "いつもイラストを楽しく拝見しています。\nテアクロウさんへウマ娘のキャラクターのリクエストをお願いしたいのですがよろしいでしょうか。\nタンクトップ姿のアイネスフウジンのイラストをお願いします。\nトレーニング中で汗をかいており、胸はタンクトップを着ていてもわかるほどボインボインでお願いします。\nタンクトップのデザインはお任せしますが、参考資料を載せておきます。\nよろしくお願いします。\n\n・参考資料\nhttps://www.pixiv.net/artworks/99321745\nhttps://www.pixiv.net/artworks/106088035", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/6", "thumbnail_src": "https://si.imgix.net/9f4f800f/uploads/origins/a5088431-4a97-4039-b4fd-4bbb0188aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23b65e8c6fd3d899df24e430a3cab39b", "thumbnail_srcset": "https://si.imgix.net/9f4f800f/uploads/origins/a5088431-4a97-4039-b4fd-4bbb0188aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23b65e8c6fd3d899df24e430a3cab39b, https://si.imgix.net/9f4f800f/uploads/origins/a5088431-4a97-4039-b4fd-4bbb0188aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5ad9d81367c7a2dc87bb68d4817267a 2x, https://si.imgix.net/9f4f800f/uploads/origins/a5088431-4a97-4039-b4fd-4bbb0188aad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a93a9529c8e6cb6b0853476b05a0e684 3x", "genre": "art", "nsfw": false, "body": "ウマ娘からの依頼となります、マチカネタンホイザちゃんがツインターボちゃんの着てるような黒のスポーツインナーを着用しているイラストを今回希望します。\nインナーのイメージとしては下記の参考資料を参照いただけたら有りがたいです。\n\nhttps://www.pixiv.net/artworks/100378967", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/5", "thumbnail_src": "https://si.imgix.net/56f7ecfe/uploads/origins/600f5dc8-f447-40bc-b6fa-f0607b402bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3ab2ce6c114f7ee491806910234c136", "thumbnail_srcset": "https://si.imgix.net/56f7ecfe/uploads/origins/600f5dc8-f447-40bc-b6fa-f0607b402bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3ab2ce6c114f7ee491806910234c136, https://si.imgix.net/56f7ecfe/uploads/origins/600f5dc8-f447-40bc-b6fa-f0607b402bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8df59b39ad030c3262e6dc0da10190db 2x, https://si.imgix.net/56f7ecfe/uploads/origins/600f5dc8-f447-40bc-b6fa-f0607b402bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bb6366020aa4e6700279cfd227c2857 3x", "genre": "art", "nsfw": false, "body": "もし可能であれば、ウマ娘のタマモ・クロスとオグリキャップの絵をお願いしたいのですが、詳細はお任せしますが、シナリオはこんな感じです：\nオグリキャップがタマモクロスに寄り添っている、まるでオグリのぬいぐるみのような状態\nタマモ・クロスがどう反応するかは、あなたにお任せします。\n私の要望を考慮していただき、ありがとうございました！", "created_at": "", "completed_at": ""}, {"path": "/@teaclaw/works/4", "thumbnail_src": "https://si.imgix.net/dbb22c5e/uploads/origins/68293b24-3aa1-4c09-9b4b-d0174e9712ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6dd163e71cc21e30eb77c7e3b8ee59d", "thumbnail_srcset": "https://si.imgix.net/dbb22c5e/uploads/origins/68293b24-3aa1-4c09-9b4b-d0174e9712ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6dd163e71cc21e30eb77c7e3b8ee59d, https://si.imgix.net/dbb22c5e/uploads/origins/68293b24-3aa1-4c09-9b4b-d0174e9712ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64a14aa6e199cf7ebb75ece1aae2fc4a 2x, https://si.imgix.net/dbb22c5e/uploads/origins/68293b24-3aa1-4c09-9b4b-d0174e9712ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf0e109425eb5940df53da00785c04f3 3x", "genre": "art", "nsfw": false, "body": "キャンセルと再送の件、大変申し訳ございませんでした。\nvtuber二人のsns、youtube、twitchのサムネイル許可をお願いするのを忘れていました。\nまた、可能であれば各女の子に別々のレイヤーを。\n\n以前、ダークストーカーズのリリスとモリガンのコスプレをしたキャラの作品を拝見しました。\nとてもよくできていてかわいかったです。\nhttps://skeb.jp/@teaclaw/works/1\