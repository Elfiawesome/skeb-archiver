gix.net/1e868263/uploads/origins/eae99597-1d2d-436d-839a-1f53d24abeec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14111ea3d51a78a96589b150a71f2051 3x", "genre": "art", "nsfw": true, "body": "再び他人の身体に寄生して操るタイプの佐久間まゆのリクエストをしたいと思います！\n\n\n\n島村卯月が雨でびしょ濡れになって戻って来たPに「大丈夫ですか！？このタオルを使ってください！」みたいな感じでタオルを差し出し\n\n『ありがとう、助かるよ』と言う感じのそれに対するPのモノローグが入る\n\n\n\nその後、卯月の肩～首元辺りから寄生してる佐久間まゆの頭が出てきて虚ろな瞳で口から涎の垂らした卯月の体を操ってPから回収したタオルをこっそり嗅いで「プロデューサーさんの匂い…♡」みたいな感じでPの匂いを堪能するまゆ\n\nすると操られている卯月のマンコもジュンと反応してジワリと濡れるスカートの一部…\n\n「うふふ…卯月ちゃんのおマンコも濡れちゃいましたね…♪」みたいな感じで笑みを見せるまゆ…と言う感じでお願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@spon_/works/8", "thumbnail_src": "https://si.imgix.net/eabfd504/uploads/origins/4c532593-1ace-4431-a1e9-ee761d85a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dda46668b34eb32573676908b9c033a2", "thumbnail_srcset": "https://si.imgix.net/eabfd504/uploads/origins/4c532593-1ace-4431-a1e9-ee761d85a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dda46668b34eb32573676908b9c033a2, https://si.imgix.net/eabfd504/uploads/origins/4c532593-1ace-4431-a1e9-ee761d85a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dc2d47896f86eb1d8120a2dbf644c1c 2x, https://si.imgix.net/eabfd504/uploads/origins/4c532593-1ace-4431-a1e9-ee761d85a41e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e7881fd219ddb946589c25714537114 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@spon_/works/7", "thumbnail_src": "https://si.imgix.ne