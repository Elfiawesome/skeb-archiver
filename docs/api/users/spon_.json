origins/0dd4fc71-2f0a-4892-97ce-87538cccbc3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7fe9a0e6324982baf4e6dcf13acc112, https://si.imgix.net/d2acc59a/uploads/origins/0dd4fc71-2f0a-4892-97ce-87538cccbc3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b34c90a18ab9ad899696af971a752e1 2x, https://si.imgix.net/d2acc59a/uploads/origins/0dd4fc71-2f0a-4892-97ce-87538cccbc3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d52ec5191de4974cc68cba4067c488f6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@spon_/works/14", "thumbnail_src": "https://si.imgix.net/55096e81/uploads/origins/d57c6d51-ea37-48d1-a048-22ef4c2626c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0e99708899529a148fba420ecde35c7", "thumbnail_srcset": "https://si.imgix.net/55096e81/uploads/origins/d57c6d51-ea37-48d1-a048-22ef4c2626c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0e99708899529a148fba420ecde35c7, https://si.imgix.net/55096e81/uploads/origins/d57c6d51-ea37-48d1-a048-22ef4c2626c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5650dbb9e45897ded2a1436603289f27 2x, https://si.imgix.net/55096e81/uploads/origins/d57c6d51-ea37-48d1-a048-22ef4c2626c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f803bd263ac581d294019b02d8ddff2 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼いたします。\n\nいつも拝見しております。\n今回Skebリクエスト再開されたとのことで\nリクエストさせていただけませんでしょうか。\n以前四条貴音さんでやっていた遊星からの物体Xファーストコンタクトのジュリエッタのシーン\nhttps://www.pixiv.net/artworks/42442487\n\nを私が好きなアイドルの大西由里子さんで見てみたいのです。\n（スポンさんの長舌ユリユリとかふたなりユリユリとかでお世話になっております）\n服装と背景はお任せ致します。\n\n表情としては\n「あれ、アタシは何を？プロデューサーさん？　どうして身体が？」\nみたいな身体が勝手に動いていてプロデューサーの触手コキをしている自分に戸惑っている\n（四条貴音と同じ感じの表情）\nもしくは\n「比奈センセ、どしたの？こっちはプロデューサーさんといい感じになってるじぇ～」\nみたいにとろんとした意味深な笑顔でプロデューサーを押し倒していて\n扉を開けた比奈センセ（センセも物体に変化済）に目線で訴えかけている\nもしくは\n表情が完全に無表情になっているみたい\nなのでお願いいたします。\n（できれば差分ありでお願いしたいですが、金額的に差分無理でしたら一番上だけでもお願いいたします）\n\nよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/42442487", "created_at": "", "completed_at": ""}, {"path": "/@spon_/works/13", "thumbnail_src": "https://si.imgix.net/2a7efc2c/uploads/origins/56b35325-3f15-412e-90ff-395971c6184c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6653c65ce87ad9c4b1bacd8dbc764cd", "thumbnail_srcset": "https://si.imgix.net/2a7efc2c/uploads/origins/56b35325-3f15-412e-90ff-395971c6184c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6653c65ce87ad9c4b1bacd8dbc764cd, https://si.imgix.net/2a7efc2c/uploads/origins/56b35325-3f15-412e-90ff-395971c6184c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35d37b9ae5595fad39dddd6f145e36bc 2x, https://si.imgix.net/2a7efc2c/uploads/origins/56b35325-3f15-412e-90ff-395971c6184c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a58cce5edf262998c1d80dd4987b1fd4 3x", "genre": "art", "nsfw": true, "body": "ヒドゥンみたいな寄生生物の肉体乗り換えシチュの漫画をリクエストしたいです\n\n\n\nアイドルマスターシンデレラガールズの城ヶ崎美嘉が城ヶ崎莉嘉に押し倒されていて\n\n美嘉は困惑気味に「り、莉嘉？どうしたのよ急に…」みたいに言うが、一方の莉嘉は「…」とずっと無言の無表情で様子がおかしく\n\n\nそんな莉嘉がカパァッと口を開けると口の中に一つ目の目玉が見えて、虚ろな目になり喉を膨らませた莉嘉の口から出た…目玉の付いたヒドゥンっぽい寄生生物が美嘉の口へと侵入し、白目を向きかけながら痙攣して寄生される美嘉\n\nそして目をパチッと開き目覚めた美嘉が口を開くとその口の中には目玉が見えて…と言う感じでお願いしたいです", "created_at": "", "completed_at": ""}, {"path": "/@spon_/works/12", "thumbnail_src": "https://si.imgix.net/8a84d877/uploads/origins/bc05f86d-f686-4f25-9963-7b93297fdc8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62a68ef946e68dcf7be4fa015e66a83e", "thumbnail_srcset": "https://si.imgix.net/8a84d877/uploads/origin