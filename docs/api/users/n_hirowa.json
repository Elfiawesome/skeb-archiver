fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e4ff63b4f5afe88ccf21815ec1f2d1f, https://si.imgix.net/0f5960a9/uploads/origins/5c810519-ab00-4251-98b7-1e6b33353a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10f752e17a1a88954ef083199d75a502 2x, https://si.imgix.net/0f5960a9/uploads/origins/5c810519-ab00-4251-98b7-1e6b33353a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1b8c64e79fe96a30ad6048346916c5b 3x", "genre": "art", "nsfw": true, "body": "※もし金額不足でしたら再送願います\n艦これの神威をお願いします\n構図はリンク画像のように膝上パイズリを斜め横から見るアングル\n服装は牛柄ビキニ、牛柄長手袋、首輪にカウベル、角と牛耳コスに公式のバンダナ\n表情は甘やかす感じの笑顔\nおっぱいや乳輪はリンクの先生の作品くらい大きく\n竿は完全におっぱいに隠れて見えない大きさ\nズリ中(左右のおっぱいを上下互い違いに動かしている)→射精(片目閉じて驚く)→射精後(水着をおっぱいの上にずらして谷間を開き、乳首が見えている。谷間にザーメンブリッジがかかり、萎びた竿が倒れている)の差分と、それぞれ水着なし差分、水着なし差分は母乳を噴出している差分もお願いします\n\nhttps://twitter.com/zukebuyou2021/status/1741687157906170308", "created_at": "", "completed_at": ""}, {"path": "/@n_hirowa/works/35", "thumbnail_src": "https://si.imgix.net/a7a0f3c7/uploads/origins/3c981bad-cf75-4b3d-920c-17e64a425e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1d766dd050cb5ed0f16edd692c9020a", "thumbnail_srcset": "https://si.imgix.net/a7a0f3c7/uploads/origins/3c981bad-cf75-4b3d-920c-17e64a425e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1d766dd050cb5ed0f16edd692c9020a, https://si.imgix.net/a7a0f3c7/uploads/origins/3c981bad-cf75-4b3d-920c-17e64a425e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5404c007dd604b63e19ef55efe0abd75 2x, https://si.imgix.net/a7a0f3c7/uploads/origins/3c981bad-cf75-4b3d-920c-17e64a425e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd4469abbb6135d79e65870d1683b938 3x", "genre": "art", "nsfw": false, "body": "リクエストもちろん再送させていただきます！\n\n久しぶりです！月陽まにです！前回は素敵なイラストありがとうございます！\n大好きな広輪凪先生の画風で描かれた私に感無量でございました。\n\nそして、早速ではございますが再度依頼させていただきます。\n今度は正面向きの立ちポーズでお願いします。\n前かがみになって胸の谷間が見えやすくなってる上にわざわざ指でニットを下に下げてモロ見えにし、さらに挑発する月陽まにを描いていただきたいです。\nまた、可能であれば前回同様表情差分物凄く恥ずかしがってるとして頂けると嬉しいです。\n広輪凪先生の素敵イラスト楽しみにさせていただきます!✨😆", "created_at": "", "completed_at": ""}, {"path": "/@n_hirowa/works/34", "thumbnail_src": "https://si.imgix.net/f0bbd561/uploads/origins/2b9eef69-733b-4bb6-8ecf-e69ac865f48a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d15d68ab4443df7a42a7b33935ed3d2d", "thumbnail_srcset": "https://si.imgix.net/f0bbd561/uploads/origins/2b9eef69-733b-4bb6-8ecf-e69ac865f48a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d15d68ab4443df7a42a7b33935ed3d2d, https://si.imgix.net/f0bbd561/uploads/origins/2b9eef69-733b-4bb6-8ecf-e69ac865f48a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff3ba1a330322911510bc2397c4c699c 2x, https://si.imgix.net/f0bbd561/uploads/origins/2b9eef69-733b-4bb6-8ecf-e69ac865f48a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22562d237a1d7e873e20bbd00b5cd6ad 3x", "genre": "art", "nsfw": true, "body": "始めまして。\nいつも素敵なイラスト拝見しています。\nふだん描かれていないジャンルで恐縮ですが依頼させていただきます。\n\nキャラ:「マギアレコード」の「七海やちよ」の「水着姿」(下記資料のキャラクターです)\n資料\nhttps://twitter.com/kanpyoex/status/1708428703058051582\n内容:広輪凪先生がよく描かれている巨乳ナコルルくらいに巨乳化させて、\n乳首ポロリしているイラストをお願いします。（ポーズはお任せします）\n原作の絵柄に寄せなくても良いので、広輪凪先生の画風で描いていただきたいです。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@n_hirowa/works/33", "thumbnail_src": "https://si.imgix.net/79437b22/uploads/origins/348a6478-63dd-40b6-a296-9fdb90bf8d60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2cd94819a120b3b9950df48d1b48c71", "thumbnail_srcset": "https://si.imgix.net/79437b22/uploads/origins/348a6478-63dd-40b6-a296-9fdb90bf8d60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PR