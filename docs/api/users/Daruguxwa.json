2-560310605c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56cfc890a4ebe9a19aa11861c30bede6, https://si.imgix.net/fb4ae9d8/uploads/origins/2639d6ec-5b61-447c-89e2-560310605c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=545db0c774753af73786a7840b24352e 2x, https://si.imgix.net/fb4ae9d8/uploads/origins/2639d6ec-5b61-447c-89e2-560310605c99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c893acb2d5b932dcc29f7ad3eab04447 3x", "genre": "art", "nsfw": true, "body": "最初のイラストの女性と全く同じポーズでレイナを描いていただけますか？https://www.pixiv.net/en/artworks/129022996", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/71", "thumbnail_src": "https://si.imgix.net/5972ae4f/uploads/origins/ea59f805-aa2e-4a5e-92d6-2e55d6e4f171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04f4ab5b67f09da9f39f63ae0c3a9443", "thumbnail_srcset": "https://si.imgix.net/5972ae4f/uploads/origins/ea59f805-aa2e-4a5e-92d6-2e55d6e4f171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04f4ab5b67f09da9f39f63ae0c3a9443, https://si.imgix.net/5972ae4f/uploads/origins/ea59f805-aa2e-4a5e-92d6-2e55d6e4f171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d42a8cb7ccd107a8986ccfaf848ad3c6 2x, https://si.imgix.net/5972ae4f/uploads/origins/ea59f805-aa2e-4a5e-92d6-2e55d6e4f171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da818b4ea162f1d53b2382a86186f555 3x", "genre": "art", "nsfw": true, "body": "https://www.pixiv.net/en/artworks/129022996この女性が着ている衣装がずっと気に入っています。レイナに全く同じ衣装を着せてほしいです。レイナの体格はリンク先のイラストの女性より大きめですが、身長はかなり低めです。\nレイナは巨乳で巨尻、太ももが太く骨盤が広い体型です。後ろ姿も描いてほしいです。レイナの巨大な尻を強調した構図でお願いします。バニー服の時と同じくらい大きなお尻にしてください。https://skeb.jp/@Daruguxwa/works/52", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/70", "thumbnail_src": "https://si.imgix.net/406a0086/uploads/origins/ce172f21-57d2-4ce1-8c67-61211d9cc255?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8246eff8bcfea4145b85d7e24d01807f", "thumbnail_srcset": "https://si.imgix.net/406a0086/uploads/origins/ce172f21-57d2-4ce1-8c67-61211d9cc255?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8246eff8bcfea4145b85d7e24d01807f, https://si.imgix.net/406a0086/uploads/origins/ce172f21-57d2-4ce1-8c67-61211d9cc255?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed7b57ea0bee6b14d71f050c2c821fbd 2x, https://si.imgix.net/406a0086/uploads/origins/ce172f21-57d2-4ce1-8c67-61211d9cc255?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4986a0abaf133e06e160559f430c57a0 3x", "genre": "art", "nsfw": true, "body": "年賀状のイラストをお願いしたいのですが。\n\n玲奈が襟元にファーのついた振袖を着ているイラストを希望します。\n着物の原色はピンクです。桃色\n玲奈は髪を結んでいて、花の髪飾りをつけています。\n\nシンプルなお正月の背景。\n文字ありバージョンと文字なしバージョン。\n\n全身を映してください。ポーズはお任せします。\n\n例\nhttps://www.pixiv.net/en/artworks/139398720\nhttps://www.pixiv.net/en/artworks/139347739", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/69", "thumbnail_src": "https://si.imgix.net/44e4ee83/uploads/origins/6377678d-3841-4003-b44b-d81992c017c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7c15d2809e2bf09d184ebca2e63f3e4", "thumbnail_srcset": "https://si.imgix.net/44e4ee83/uploads/origins/6377678d-3841-4003-b44b-d81992c017c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7c15d2809e2bf09d184ebca2e63f3e4, https://si.imgix.net/44e4ee83/uploads/origins/6377678d-3841-4003-b44b-d81992c017c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05c44aaf92050a8c14ef90e577074350 2x, https://si.imgix.net/44e4ee83/uploads/origins/6377678d-3841-4003-b44b-d81992c017c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be53adaea97fdeaadf10afe54c28670c 3x", "genre": "art", "nsfw": true, "body": "玲奈の横顔を描いてください。\n例：https://www.pixiv.net/en/artworks/137142863\n全身\n左側と右側\n両手を広げて立っている\nニュートラルな表情\nお尻を丸くカーブさせる。\n\nヌードでも服を着ていてもいい。\nそれはあなたにお任せします。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/68", "thumbnail_src": "https://si.imgix.net/cb450c89/uploads/origins/87c79cdb-11bf-467f-b3f7-2bcf1b0d3529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87044b7e68e5e0ff35b005999440d5f1", "thumbnail_srcset": "https://si.imgix.net/cb450c89/uploads/origins/87c79cdb-11bf-467f-b3f7-2bcf1b0d3529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87044b7e68e5e0ff35b005999440d5f1, https://si.imgix.net/cb450c89/uploads/origins/87c79cdb-11bf-467f-b3f7-2bcf1b0d3529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e5eae1c99a8d98e04371e755471a015 2x, https://si.imgix.net/cb450c89/uploads/origins/87c79cdb-11bf-467f-b3f7-2bcf1b0d3529?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b1bec87028edbb3ec3276238a12106d 3x", "genre": "art", "nsfw": true, "body": "マイクの顔の上に座る玲奈のサイドビュー。\n例：https://www.pixiv.net/en/artworks/127399130\n玲奈の太ももとお尻を例のイラストのように大きくする。\nオールヌード\n玲奈の表情は照れている\n\nマイクが玲奈のアソコを舐めていることを暗示する別バージョンを用意する。\n玲奈の頭を後ろに傾ける。舌を出して興奮した顔をしている。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/67", "thumbnail_src": "https://si.imgix.net/16f27eeb/uploads/origins/29aba389-7aa7-4fd3-8a36-d52cb1bfcdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3352edc49e7d2accb443edea871d27e4", "thumbnail_srcset": "https://si.imgix.net/16f27eeb/uploads/origins/29aba389-7aa7-4fd3-8a36-d52cb1bfcdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3352edc49e7d2accb443edea871d27e4, https://si.imgix.net/16f27eeb/uploads/origins/29aba389-7aa7-4fd3-8a36-d52cb1bfcdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2192d003c78f58cd8c67cd3e8d102c61 2x, https://si.imgix.net/16f27eeb/uploads/origins/29aba389-7aa7-4fd3-8a36-d52cb1bfcdb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e7411d13146b234db19c2f333eba114 3x", "genre": "art", "nsfw": true, "body": "このコマのリメイクイラストをお願いします。\nマイクがペニスを玲奈の胸の間に押し込むところ。\nhttps://drive.google.com/file/d/1HqTb0F7RtH0raIxbmxZkepwvwIvMfhWz/view?usp=sharing\n\n玲奈の頭頂部と胸全体が見えるように。\n玲奈の胸は原作のように押し上げられるように。\n玲奈の胸は私のいつものリクエストのように巨大であるべきです。乳首は大きく膨らませて。\n原作の玲奈の表情が好きなので、そのままでお願いします。\n\n背景はなし。動線なし。\n\n胸の間にペニスがないバージョンも作ってください。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/66", "thumbnail_src": "https://si.imgix.net/e7674a37/uploads/origins/bafe6886-091b-4de5-afa5-be4eecc3f582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=913b40d84b7f436208164761331096af", "thumbnail_srcset": "https://si.imgix.net/e7674a37/uploads/origins/bafe6886-091b-4de5-afa5-be4eecc3f582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=913b40d84b7f436208164761331096af, https://si.imgix.net/e7674a37/uploads/origins/bafe6886-091b-4de5-afa5-be4eecc3f582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=761184139cb427f0a2c3a8f94e31e5a0 2x, https://si.imgix.net/e7674a37/uploads/origins/bafe6886-091b-4de5-afa5-be4eecc3f582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb940c6f02add12f8ff27988a8ba766a 3x", "genre": "art", "nsfw": true, "body": "原作漫画のこのページを参照\nhttps://drive.google.com/file/d/1vJURY-qfN9YMqou8Os5jaezOiuDkdU6C/view?usp=sharing\n\n玲奈と彼氏のヒデが一緒に下校しているイラストが見たい。笑顔で。\n\nヒデの髪型を、別作品の彼氏に似せたデザインにしてほしいです。\nhttps://drive.google.com/file/d/1s4gxRo7beyFpga0Ul9Z_YvhzvhNVkSgt/view?usp=sharing\nヒデの髪型も両目を隠してほしいです。\n\n玲奈のプロポーションは、最近の私のリクエストのように巨大であるべきです。巨乳、巨尻、巨尻、巨腿。\n\n全身がわかるイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/65", "thumbnail_src": "https://si.imgix.net/9f8f6618/uploads/origins/acd5a733-0021-4a9e-8792-0116a21944ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a27e6a0ce80c82fb7639460bf8d9031", "thumbnail_srcset": "https://si.imgix.net/9f8f6618/uploads/origins/acd5a733-0021-4a9e-8792-0116a21944ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a27e6a0ce80c82fb7639460bf8d9031, https://si.imgix.net/9f8f6618/uploads/origins/acd5a733-0021-4a9e-8792-0116a21944ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68b0690e999e00d562a723ea70f264aa 2x, https://si.imgix.net/9f8f6618/uploads/origins/acd5a733-0021-4a9e-8792-0116a21944ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e170d862230a6a3b7990ae241939fd2 3x", "genre": "art", "nsfw": true, "body": "原作漫画のこのコマをリメイクしてほしい。\nhttps://drive.google.com/file/d/1oWUgDC5MbasngnvoD6fSL9p_fREkFqjU/view?usp=sharing\n\nアクションや動きのセリフは入れないでください。\nそのかわり、2つの異なるバージョンのイラストを見てみたい。\n胸が跳ね上がっているところと、跳ね上がっていないところ。\n\n玲奈の胸を原作よりもっと大きくしてください。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/64", "thumbnail_src": "https://si.imgix.net/1be358a5/uploads/origins/f7a4149b-fa6d-47ed-85a3-e0199f51c2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb1ee2cb3b9fb87ef45f1d60026835be", "thumbnail_srcset": "https://si.imgix.net/1be358a5/uploads/origins/f7a4149b-fa6d-47ed-85a3-e0199f51c2be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb1ee2cb3b9fb87ef45f1d60026835be, https://si.imgix.net/1be358a5/uploads/origins/f7a4149b-fa6d-47ed-85a3-e0199f51c2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c6728e648601401ac77de7bdd59b449 2x, https://si.imgix.net/1be358a5/uploads/origins/f7a4149b-fa6d-47ed-85a3-e0199f51c2be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6ca74558e93f147bbf7cfcfd9eb8433 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/63", "thumbnail_src": "https://si.imgix.net/66d236dc/uploads/origins/0b7811b8-4224-4bd1-ab5f-80e5b88ea232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e8a7b0eb653dac148c88239b65bb16", "thumbnail_srcset": "https://si.imgix.net/66d236dc/uploads/origins/0b7811b8-4224-4bd1-ab5f-80e5b88ea232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e8a7b0eb653dac148c88239b65bb16, https://si.imgix.net/66d236dc/uploads/origins/0b7811b8-4224-4bd1-ab5f-80e5b88ea232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf2295bb3b55ead4907b3db4993e4477 2x, https://si.imgix.net/66d236dc/uploads/origins/0b7811b8-4224-4bd1-ab5f-80e5b88ea232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96936738c2334d198393b7e975c3eeac 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@Daruguxwa/works/62。\n\n玲奈のバストとヒップをスーパーサイズにしてくれてありがとう！\n\nこのイラストの後ろ姿をお願いしたいです。\n超巨乳に合わせてお尻も超巨大にしてほしいです。\n\nこのビキニとヌードを着た玲奈のお尻を後ろから見たイラストをお願いします！\nまた、ヒップ、太もも、ふくらはぎのサイズアップもお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/62", "thumbnail_src": "https://si.imgix.net/80e62533/uploads/origins/42839e9b-fc1f-4fc6-b64d-f97670de7629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d64991f0429658b1558750508a2428e", "thumbnail_srcset": "https://si.imgix.net/80e62533/uploads/origins/42839e9b-fc1f-4fc6-b64d-f97670de7629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d64991f0429658b1558750508a2428e, https://si.imgix.net/80e62533/uploads/origins/42839e9b-fc1f-4fc6-b64d-f97670de7629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd7ed2a6accb79c67191db612fa18919 2x, https://si.imgix.net/80e62533/uploads/origins/42839e9b-fc1f-4fc6-b64d-f97670de7629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce2bb2b92cc192910de975fcb2a6dc1f 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@Daruguxwa/works/61。\n\nこのイラストがとても好きなので、玲奈の全身を描いていただけませんか？\n足とかも描いてほしいです。\n\n腕と手の位置を変えて、この例の画像と同じようなポーズになるようにしてください：\nhttps://www.pixiv.net/en/artworks/135512451", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/61", "thumbnail_src": "https://si.imgix.net/0636ed47/uploads/origins/e802d2e4-51d7-47cf-bb36-738549556a43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ad3f206b9383b998a37d84286246a5", "thumbnail_srcset": "https://si.imgix.net/0636ed47/uploads/origins/e802d2e4-51d7-47cf-bb36-738549556a43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25ad3f206b9383b998a37d84286246a5, https://si.imgix.net/0636ed47/uploads/origins/e802d2e4-51d7-47cf-bb36-738549556a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1569837fb03e92fbb350aa7a1e5f9126 2x, https://si.imgix.net/0636ed47/uploads/origins/e802d2e4-51d7-47cf-bb36-738549556a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b81a2d776f34b833215f3bb9a0a7788 3x", "genre": "art", "nsfw": true, "body": "超巨乳の玲奈が見たい。本当に誇張して。\n\nこんなに大きな胸の彼女が見たい：\nhttps://www.pixiv.net/en/artworks/135512451\nヒップも胸と同じくらい広い。\n乳房の大きさに合わせて乳首も大きい。\n\n視点は例の画像のように正面から。\n\n彼女はピンクのビキニを着ているが、巨大な胸によって本当に引き伸ばされている。\n\nヌードバージョンもお願いします。\n\n玲奈の腕と手は背中に回して見えないようにしている。\n\n笑っている。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/60", "thumbnail_src": "https://si.imgix.net/00d9489b/uploads/origins/d2445253-d26d-4bea-9dc4-b9aa8e764623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7628c64d7128334e7e500f9c63c79bfe", "thumbnail_srcset": "https://si.imgix.net/00d9489b/uploads/origins/d2445253-d26d-4bea-9dc4-b9aa8e764623?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7628c64d7128334e7e500f9c63c79bfe, https://si.imgix.net/00d9489b/uploads/origins/d2445253-d26d-4bea-9dc4-b9aa8e764623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=951c9db9b6326c71c945e59a8d2deffd 2x, https://si.imgix.net/00d9489b/uploads/origins/d2445253-d26d-4bea-9dc4-b9aa8e764623?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7222d9012990f4fa30ffb3f2ba1e781 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@Daruguxwa/works/59。\n\n完成させてくれてありがとう！すごく好きです。玲奈の胸が大きくて柔らかい！\n\n男の子がいないバージョンと、胸の間にペニスがないバージョンもお願いできますか？\n\nまた、暗い照明なしのイラストも見てみたいです。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/59", "thumbnail_src": "https://si.imgix.net/5a1132f3/uploads/origins/b28d2bed-2189-47ac-9c67-3fb2cacee8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a18911cba2b110487d2713c6f8c5db2", "thumbnail_srcset": "https://si.imgix.net/5a1132f3/uploads/origins/b28d2bed-2189-47ac-9c67-3fb2cacee8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a18911cba2b110487d2713c6f8c5db2, https://si.imgix.net/5a1132f3/uploads/origins/b28d2bed-2189-47ac-9c67-3fb2cacee8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e5872057378158d0280534f7c4bab73 2x, https://si.imgix.net/5a1132f3/uploads/origins/b28d2bed-2189-47ac-9c67-3fb2cacee8e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9880cf3b4514e7d21e6e7630485559e 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@ダルグクスワ/works/54\nこのイラストの少年は、寝ている玲奈の巨乳を犯している。\n\n例\nhttps://x.com/p_y_o_n_p_y_o_n/status/1977267997900472698?t=g-pLozl47EYROJGMwTqIkg&s=19\n\n玲奈のおっぱいを巨大化してください。\nこれよりもっと大きくしてください🙏。\n\nhttps://skeb.jp/@Daruguxwa/works/32\n\nこの子のチンコでかい。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/58", "thumbnail_src": "https://si.imgix.net/d867c397/uploads/origins/fa06c8ba-8050-48db-96fd-79