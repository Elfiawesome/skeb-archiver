12312308eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=854a58f7fd0428d6067b36e1c3b51e4b 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@Daruguxwa/works/46。\n\n若い玲奈の全身を後ろから見たイラストをお願いします。\n\n大きなお尻と広いヒップをお願いします。\n\n彼女が履いているショーツは、彼女のお尻のほっぺたを見せるべきだ。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/48", "thumbnail_src": "https://si.imgix.net/1ac598b0/uploads/origins/ef3a4e6c-347f-4bce-8091-6f402ce713d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07c7fc37b3d87951fe00f684038c70a3", "thumbnail_srcset": "https://si.imgix.net/1ac598b0/uploads/origins/ef3a4e6c-347f-4bce-8091-6f402ce713d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07c7fc37b3d87951fe00f684038c70a3, https://si.imgix.net/1ac598b0/uploads/origins/ef3a4e6c-347f-4bce-8091-6f402ce713d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb7e5bd709e3b463e3aa3e612c0e1ddf 2x, https://si.imgix.net/1ac598b0/uploads/origins/ef3a4e6c-347f-4bce-8091-6f402ce713d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92b775bfa94433ecf8291546af79f959 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/47", "thumbnail_src": "https://si.imgix.net/afb13aad/uploads/origins/c45db75a-fe83-44d5-abd4-0d42bab0a80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092ad5b39b54752640d2a45006239810", "thumbnail_srcset": "https://si.imgix.net/afb13aad/uploads/origins/c45db75a-fe83-44d5-abd4-0d42bab0a80c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092ad5b39b54752640d2a45006239810, https://si.imgix.net/afb13aad/uploads/origins/c45db75a-fe83-44d5-abd4-0d42bab0a80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=539202b59648d9b45bcebf95c48e274a 2x, https://si.imgix.net/afb13aad/uploads/origins/c45db75a-fe83-44d5-abd4-0d42bab0a80c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73e43544756a53591cdcba4e2243044f 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@Daruguxwa/works/40。\n\n玲奈に、ピンクの下着と黒のTバックの下着を、このマンガで蒔絵が着ているような下着に追加してもらえないでしょうか？\n\nhttps://www.pixiv.net/en/artworks/84562748\n\nそして、玲奈の表情をもっと緊張した感じに変えてください。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/46", "thumbnail_src": "https://si.imgix.net/c1601536/uploads/origins/350d05ac-7bb8-4bcc-aa35-95f602fac0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ba9ab0ca7bbb24f43bddbb34bb3d8d", "thumbnail_srcset": "https://si.imgix.net/c1601536/uploads/origins/350d05ac-7bb8-4bcc-aa35-95f602fac0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ba9ab0ca7bbb24f43bddbb34bb3d8d, https://si.imgix.net/c1601536/uploads/origins/350d05ac-7bb8-4bcc-aa35-95f602fac0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=692df16314863dabeda88ab7089352aa 2x, https://si.imgix.net/c1601536/uploads/origins/350d05ac-7bb8-4bcc-aa35-95f602fac0c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce3e8d583bd84ad3ce703fac3b0b33a3 3x", "genre": "art", "nsfw": true, "body": "若い玲奈をリクエストしたい。\n彼女はサキュバスの息子と友達なんだ。\n今回、二人は同い年くらいです。身長も同じくらいです。\n\n若くても玲奈はふくよかな体をしている。巨乳と巨尻、広いヒップと太い太ももをよろしくお願いします。\n例\nhttps://www.pixiv.net/en/artworks/92747229\n\n玲奈の髪をツインテールにしてほしい。ピンクのタンクトップに水色のショートパンツ。\n\nサキュバスの男の子はこのイラストで着ているものを着ている：\nhttps://www.pixiv.net/en/artworks/86477450\n\n二人が隣り合って立っているところを描いてください。\n\nヌードのバリエーションも作ってください。\nサキュバスの少年は巨大なペニスを持っています。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/45", "thumbnail_src": "https://si.imgix.net/58f884f9/uploads/origins/8132b7a4-5394-4192-809c-69e2cc6729b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2563e6ae9e69bec88ff0da3be7edabe4", "thumbnail_srcset": "https://si.imgix.net/58f884f9/uploads/origins/8132b7a4-5394-4192-809c-69e2cc6729b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2563e6ae9e69bec88ff0da3be7edabe4, https://si.imgix.net/58f884f9/uploads/origins/8132b7a4-5394-4192-809c-69e2cc6729b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6766416bbaf1e936100457473e238e3a 2x, https://si.imgix.net/58f884f9/uploads/origins/8132b7a4-5394-4192-809c-69e2cc6729b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=264f137fe7911be078beebd0e38d2343 3x", "genre": "art", "nsfw": true, "body": "https://skeb.jp/@Daruguxwa/works/42。\n\n背景も水もない、玲奈だけのバージョンをお願いできますか？\n\nできれば彼女の体ももっと見たいです。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/44", "thumbnail_src": "https://si.imgix.net/7431ae1f/uploads/origins/ee95774a-f948-4195-a63f-eca465b6ddd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b082e0d16ea0ffc50cedbcb782369f0d", "thumbnail_srcset": "https://si.imgix.net/7431ae1f/uploads/origins/ee95774a-f948-4195-a63f-eca465b6ddd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b082e0d16ea0ffc50cedbcb782369f0d, https://si.imgix.net/7431ae1f/uploads/origins/ee95774a-f948-4195-a63f-eca465b6ddd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50cd3ef729308b9caf611e4b9aee9637 2x, https://si.imgix.net/7431ae1f/uploads/origins/ee95774a-f948-4195-a63f-eca465b6ddd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d98e6faaa77fa6bca585eaa4b27f025c 3x", "genre": "art", "nsfw": false, "body": "全身イラスト\n\nキャラクタージェシカ・アルバート（ドラゴンクエストVIII）\n\nポーズ\n公式と似ている：\nhttps://static.wikia.nocookie.net/dragonquest/images/e/ef/DQVIII_-_Jessica_Albert.png/revision/latest?cb=20191010074450&path-prefix=ja\n\nオフィシャルより胸とお尻にボリュームを持たせる。", "created_at": "", "completed_at": ""}]}