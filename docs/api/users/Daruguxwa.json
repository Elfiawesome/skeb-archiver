x.net/648db07c/uploads/origins/8a88c8f0-c269-4913-bb4d-1e1f1d7deea2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4296e684e48cfeadddf5ab126f0df8db", "thumbnail_srcset": "https://si.imgix.net/648db07c/uploads/origins/8a88c8f0-c269-4913-bb4d-1e1f1d7deea2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4296e684e48cfeadddf5ab126f0df8db, https://si.imgix.net/648db07c/uploads/origins/8a88c8f0-c269-4913-bb4d-1e1f1d7deea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49d32b4b56c5c153cc8695ead0dcbc0c 2x, https://si.imgix.net/648db07c/uploads/origins/8a88c8f0-c269-4913-bb4d-1e1f1d7deea2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16aa515f7b3acf11fbdae2c2da4e1d42 3x", "genre": "art", "nsfw": true, "body": "今、またドラゴンクエストXI Sをプレイしている。\n\nマルティナ描いてくれませんか？全身立ち絵でお願いします。\n\nhttps://www.dq11.jp/s/pf/characters/martina.html\n\n彼女はデフォルトの服を着ています。プロポーションをもっと豊満にしてください。\n胸とお尻をもっと大きく。彼女は格闘家なので、太ももはとても太くすべきだと思う。\nどんなポーズがいいかよくわからない。片手を腰に当てて、こんな感じかな。\nhttps://ge-soku.com/wp-content/uploads/2019/07/%E3%83%9E%E3%83%AB%E3%83%86%E3%82%A3%E3%83%8A%EF%BD%93.jpg\nポーズはあなたに決めてもらいます。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/52", "thumbnail_src": "https://si.imgix.net/31504b00/uploads/origins/7c805e38-c6ed-457f-8d21-1ced584f18ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08c49376a7df87ec020c24065af3df4", "thumbnail_srcset": "https://si.imgix.net/31504b00/uploads/origins/7c805e38-c6ed-457f-8d21-1ced584f18ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08c49376a7df87ec020c24065af3df4, https://si.imgix.net/31504b00/uploads/origins/7c805e38-c6ed-457f-8d21-1ced584f18ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36eeca401f4186dd521eeff545292db2 2x, https://si.imgix.net/31504b00/uploads/origins/7c805e38-c6ed-457f-8d21-1ced584f18ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b08f5561804697a9d40b84f2410a35c3 3x", "genre": "art", "nsfw": true, "body": "最近、バニーガールのイラストをよく見かける。\n\nこんな感じのバニーガール姿の玲奈ちゃんのイラストをお願いします。\nhttps://www.pixiv.net/en/artworks/134156897\nhttps://www.pixiv.net/en/artworks/134155468\n\n立ち姿の全身正面と後ろ姿でお願いします。\n後ろ姿は顔も出してほしいです。\n\n片方の手は腰に当て、もう片方の手はトレイを持ってください。\n例：https://www.pixiv.net/en/artworks/134146552\n少し前かがみになっている\nhttps://x.com/kyugata5385Up/status/1958473320329871399\n\n彼女は歓迎の笑みを浮かべている。\n\n相変わらず、大きな胸、大きなお尻、広いヒップ、太い太もも。\n\n巨大な胸は、こんな風に少し垂れ下がっている：\nhttps://skeb.jp/@Daruguxwa/works/32。\n\nこれよりでかい尻：\nhttps://skeb.jp/@Daruguxwa/works/30\n\nストッキングありバージョンとストッキングなしバージョンがある。", "created_at": "", "completed_at": ""}, {"path": "/@Daruguxwa/works/51", "thumbnail_src": "https://si.imgix.net/e8b76467/uploads/origins/0f95096a-5fa3-4530-bea0-1568ab3b62b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c953f3be284fe5c154a64380178d67f", "thumbnail_srcset": "https://si.imgix.net/e8b76467/uploads/origins/0f95096a-5fa3-4530-bea0-1568ab3b62b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c953f3be284fe5c154a64380178d67f, https://si.imgix.net/e8b76467/uploads/origins/0f95096a-5fa3-4530-bea0-1568ab3b62b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23da12f2f1da59f6b42e4052dd043db0 2x, https://si.imgix.net/e8b76467/uploads/origins/0f95096a-5fa3-4530-bea0-1568ab3b62b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7459676d599923944c55c4c10a7415ff 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}