あなたの美しいブルーの作品が大好きです。\nよろしくお願いします！\n\nリファレンスシート: https://drive.google.com/drive/folders/1HO9WxerdYPMnG4FtWwcu36Hu-9ZkQK9d?usp=sharing\nその他のアート: https://drive.google.com/drive/folders/1qQgawUMSv3IYx-btfHdcW2llddgP0B3e?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Rainshower0705/works/1", "thumbnail_src": "https://si.imgix.net/8d7042ad/uploads/origins/e2e18225-d383-48ee-a16c-ad5765e84577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33085e724397f8e29f0633b30dd31ad9", "thumbnail_srcset": "https://si.imgix.net/8d7042ad/uploads/origins/e2e18225-d383-48ee-a16c-ad5765e84577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33085e724397f8e29f0633b30dd31ad9, https://si.imgix.net/8d7042ad/uploads/origins/e2e18225-d383-48ee-a16c-ad5765e84577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fa26657ae904bd4d08db4b9b880f7e2 2x, https://si.imgix.net/8d7042ad/uploads/origins/e2e18225-d383-48ee-a16c-ad5765e84577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51644fadd762a8e94c5b711b11b79671 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}]}