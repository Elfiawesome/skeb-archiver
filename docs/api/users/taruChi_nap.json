887-3ef648ce63db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8dae1805a01ee2f83f49660b7c223226 2x, https://si.imgix.net/ed71d855/uploads/origins/9097018e-9ae8-455f-8887-3ef648ce63db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a25ee540a157bf2e540a50f6a14893a 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\nたるちゃん様の描かれるデフォルメイラストがとても素敵だったので、是非うちの子を描いていただきたいです！\n\n【リクエスト内容】\nこちらの子のイラストをお願いします。\n吸血鬼の少女です。\nhttps://drive.google.com/drive/folders/1jfbpg0SEl8FliQ1uwftVW-t2j0oq_xF_?usp=sharing\n小物等のチョイスはたるちゃん様にお任せしたいです…！\n\n【使用用途】\n個人鑑賞\n\nどうぞ宜しくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@taruChi_nap/works/56", "thumbnail_src": "https://si.imgix.net/40178e88/uploads/origins/42e22724-d9aa-422a-8e40-e1c7258c101c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ccc970e6f4ee11546e18bb121b2e021", "thumbnail_srcset": "https://si.imgix.net/40178e88/uploads/origins/42e22724-d9aa-422a-8e40-e1c7258c101c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ccc970e6f4ee11546e18bb121b2e021, https://si.imgix.net/40178e88/uploads/origins/42e22724-d9aa-422a-8e40-e1c7258c101c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af1b145e62facc4e4a2d43c57fedabe9 2x, https://si.imgix.net/40178e88/uploads/origins/42e22724-d9aa-422a-8e40-e1c7258c101c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c92ca53db72f72d826ca469d6f576b6 3x", "genre": "art", "nsfw": false, "body": "たるちゃん様\n初めまして、個人でVtuber活動をしているおとがうにと申します。リクエストの再開お待ちしておりました…✨️\nぜひとも自分のイラストを描いていただきたいと思いリクエストをお送りいたしました！！\n\n・構図や表情、ポーズなどは全てお任せ致します。\n・おとまる（ペット）を入れて頂けると嬉しいです！\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル\n・SNSのアイコン、ヘッダー、投稿等\n・グッズ制作\n\n【データ形式】\nキャラクターと小物等をわけたレイヤーでいただけますと幸いです。psd,pngどちらでも問題ございません！\n\n何卒、ご検討のほど宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1pxJ4XzTMXBXPS2s0zfz65YHusHjUdC-G?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@taruChi_nap/works/55", "thumbnail_src": "https://si.imgix.net/251147ed/uploads/origins/4fe3c44c-d231-421d-98f0-1a95fe6d2e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=537b59bd69764b649e898fc7a265bab0", "thumbnail_srcset": "https://si.imgix.net/251147ed/uploads/origins/4fe3c44c-d231-421d-98f0-1a95fe6d2e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=537b59bd69764b649e898fc7a265bab0, https://si.imgix.net/251147ed/uploads/origins/4fe3c44c-d231-421d-98f0-1a95fe6d2e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cfcb39cb825e41543e42f9913a016d7 2x, https://si.imgix.net/251147ed/uploads/origins/4fe3c44c-d231-421d-98f0-1a95fe6d2e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd85c26d6b51574ed2a1a96f0cedd37b 3x", "genre": "art", "nsfw": false, "body": "たるちゃん様\n初めまして、個人でVtuber活動をしている絢月あやねと申します。\nツイッターで素敵なイラスト拝見しております。\nぜひ自分のイラストを描いていただきたいと思いリクエストをお送りいたしました！\n\n【参考資料】\nhttps://drive.google.com/drive/folders/11kVLB4e8UbuLBA7fd-x6PwH99dTIbPPi?usp=sharing\n\n・構図や表情、ポーズなどは全てお任せ致します。\n・petフォルダーの白いポメラニアンを複数入れて頂けると嬉しいです！\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル\n・SNSのアイコン、ヘッダー、投稿等\n・グッズ制作\n\n何卒、ご検討のほど宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/11kVLB4e8UbuLBA7fd-x6PwH99dTIbPPi?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@taruChi_nap/works/54", "thumbnail_src": "https://si.imgix.net/e7725c29/uploads/origins/7998c2ba-99c5-41f7-a9c1-83401dae216b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=990b318648e395bd8aa9a9a57120034f", "thumbnail_srcset": "https://si.imgix.net/e7725c29/uploads/origins/7998c2ba-99c5-41f7-a9c1-83401dae216b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=990b318648e395bd8aa9a9a57120034f, https://si.imgix.net/e7725c29/uploads/origins/7998c2ba-99c5-41f7-a9c1-83401dae216b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c3583e8ba6996b7c571d5164276a29c 2x, https://si.imgix.net/e7725c29/uploads/origins/7998c2ba-99c5-41f7-a9c1-83401dae216b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd0dcb8509730834f6473a7c5e69667e 3x", "genre": "art", "nsfw": false, "body": "たるちゃん様、初めまして。ぎらちゃんと申します。\n　Ｘでたるちゃん様が製作されていたSDイラストを拝見し、大変かわいいイラストを描いていらっしゃるな、と思い、私の推しのVtuberさんのSDイラストを依頼したく、リクエストさせていただきました。\n\n　リクエストの内容なのですが、私の推しであるVASE所属のVtuber「鬼月夜々」さんのイラストをお願いしたいです。\n　３面図等はリンク先のＸにて公開しております。\n　https://x.com/kiduki_yoyo/status/1813401128627011790\n\n　構図、衣装等はお任せいたします。。\n　参考としての人物像としては、\n　鬼月夜々は不憫な目に遭ってもめげずに誠実に頑張っているような娘で、いつもちょっと抜けている部分もあります。お酒とゲームが大好きです。　\n　　　　　　　　　　　　　　　　　　\n　最後になりますが、描いていただいたSDイラストについて、鬼月夜々本人のみ、配信サムネイル等、活動への使用をお許しいただければと思います。併せて、可能であれば透過差分をいただけますと幸いです。\n　また、よろしければ、Xでの投稿用にサイン等を書いたものもいただけると大変助かります。\n\n　リクエストについては、以上になります。\n　現在、多数の依頼を請けられているとのことで、今回のリクエストについては、気長にお待ちしたいと考えておりますので、どうか、よろしくご検討いただければと思います。", "created_at": "", "completed_at": ""}, {"path": "/@taruChi_nap/works/53", "thumbnail_src": "https://si.imgix.net/79c4cefb/uploads/origins/65cfc996-2104-4524-a18f-dc221375d2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=717589751347b8321e6470ed01fc3053", "thumbnail_srcset": "https://si.imgix.net/79c4cefb/uploads/origins/65cfc996-2104-4524-a18f-dc221375d2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=717589751347b8321e6470ed01fc3053, https://si.imgix.net/79c4cefb/uploads/origins/65cfc996-2104-4524-a18f-dc221375d2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=decabb3b16d8b40e19e3151215f722cc 2x, https://si.imgix.net/79c4cefb/uploads/origins/65cfc996-2104-4524-a18f-dc221375d2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b3d13c7992a9f336cb35bfcbf9cbd52 3x", "genre": "art", "nsfw": false, "body": "たるちゃん先生、はじめまして。\n\n Twitchで配信活動をしているVstreamerの兎月めると申します。  \n\nたるちゃん先生のイラストを以前からXで拝見しており、とっても好みでぜひ自分のモデルを描いていただきたいと思いリクエストを送ら