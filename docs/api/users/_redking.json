98d5d465eaa370c5cc44a8", "thumbnail_srcset": "https://si.imgix.net/72d4b4e2/uploads/origins/48220bd4-8fd2-4832-8a86-558de591bea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d62dda721498d5d465eaa370c5cc44a8, https://si.imgix.net/72d4b4e2/uploads/origins/48220bd4-8fd2-4832-8a86-558de591bea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=918b05bf5b2011da819a881ef86d44e1 2x, https://si.imgix.net/72d4b4e2/uploads/origins/48220bd4-8fd2-4832-8a86-558de591bea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d50bcd96c2a5ccc49ed544c8862162c1 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/21", "thumbnail_src": "https://si.imgix.net/af4afafd/uploads/outputs/f5d79e09-8f83-49b0-a5c9-b5156470c04d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7bf51de464e059b8556b8eb494957bfa", "thumbnail_srcset": "https://si.imgix.net/af4afafd/uploads/outputs/f5d79e09-8f83-49b0-a5c9-b5156470c04d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7bf51de464e059b8556b8eb494957bfa, https://si.imgix.net/af4afafd/uploads/outputs/f5d79e09-8f83-49b0-a5c9-b5156470c04d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=444158aa04e783efa4c8d35e4260c661 2x, https://si.imgix.net/af4afafd/uploads/outputs/f5d79e09-8f83-49b0-a5c9-b5156470c04d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=96a0c8d8c862197bc186e922761618d6 3x", "genre": "video", "nsfw": true, "body": "いつもお世話になっております。\nこの度はまた貴方様の描くエヴァンジェリンが見たいと思ったので\n依頼させていただきました。\nシチュエーションの希望としては\nエヴァンジェリンの体格の3倍以上の巨漢にエヴァの太もも並の太さ、\n腹部中間以上の長さの肉棒を見せ槍から突き込まれ腹ボコし、\n肉棒を抜き出す、最終的には膣中射精の結果、腹部が妊娠状態並みに\n精液で膨らんでいる精液ボテになっている絵が見たいです。\n可能であれば、その際の表情が怯え→苦痛→慣れ→アヘ顔である事と\n台詞吹き出しを付けていただけると嬉しいです。\n\n確定で欲しい要素としては巨漢、巨根に犯される、精液ボテ、アヘ顔で\nその部分以外では体位や構図など好きにしていただいて構いません、\nまたもし付け足していただけるのであれば嬉しい要素を以下に記載しておきます\n・竿役は魔法or魔法薬ででっかくなった赤玉屋ミュージアムの竿役と\n　同一人物として扱われていれば嬉しいです。\n\n非常に長々と書いてしまい申し訳ありません、依頼としては以上になります。\n依頼に気が向きましたら何卒お願い申し致します。以上", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/20", "thumbnail_src": "https://si.imgix.net/d4df0da0/uploads/origins/330c6984-2445-4323-9f4f-7683937c9fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4536a40fd2eadcd4805d296cf98e1668", "thumbnail_srcset": "https://si.imgix.net/d4df0da0/uploads/origins/330c6984-2445-4323-9f4f-7683937c9fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4536a40fd2eadcd4805d296cf98e1668, https://si.imgix.net/d4df0da0/uploads/origins/330c6984-2445-4323-9f4f-7683937c9fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0523b3df24defe9556254289bdf8748 2x, https://si.imgix.net/d4df0da0/uploads/origins/330c6984-2445-4323-9f4f-7683937c9fd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4bd79f7054e2914890c99fcae1a0812 3x", "genre": "art", "nsfw": true, "body": "初めまして！FE聖魔の光石のルーテというキャラクターをリクエストさせて頂きます。\nクールな雰囲気をしたマイペース・不思議系の魔導士の少女です。 \n衣装は資料URLの画像１番目～3番目の原作版で、体形はスレンダー・貧乳に描いて頂けると嬉しいです。\n\n昔赤王様がHPで作られたエヴァンジェリンのブロック崩しをプレイしてとても楽しませて頂いたので、自分の好きなキャラクターで同様の脱衣シチュをリクエストさせて頂きます。\n\n【シチュエーション】\n満月の夜に敵と相対するルーテ。魔法をかき消され、衣服を剥ぎ取られといった順に追い詰められていき、最終的に生まれたままの姿にされてしまう。\n\n【希望差分】\n①\tまだ服を着た状態。片手に持った魔導書で魔法を発動し、周囲に炎が舞っている。\n感情を表に出さず口も閉じており、クールな表情。\n②\t魔法がかき消され、炎が消失した状態。\n冷静なままだが、むっとした感じで更に強い魔法を放とうとしており、口を開けている。\n③\tマントが肩部分以外全て破かれた状態。\n汗を流し、片目を閉じて怯んでいるが、表情は①から崩れてはいない。\n④\t上下の下着とネックレス以外の全ての衣装が剥ぎ取られた状態。\n冷静さを保ってはいるが、汗を流し敵を静かに睨んでいる感じの表情\n⑤\t下着もネックレスも剥ぎ取られ、生まれたままの姿。\n流石の事態に頬を赤らめて驚愕する表情。\n⑥\t敗北ルート。魔導書も奪われ、裸体を好き放題に弄ばれた状態。\n股間からは愛液が垂れ、目を細めて快感を感じてしまっている。\n⑦\t勝利ルート。生まれたままの姿で勝ち、周囲に炎が舞っている。\n両目を閉じ、「私は優秀ですから裸でも勝って当然です」と言わんばかりにすました顔をしているが、\n頬は赤らんだまま。\n\n差分毎のポーズ変更は不要です。\n\nもし可能でしたら、全身が見える構図をお願いします。\nまた、衣装・表情・赤面差分はPSDのレイヤーでの切り替えが可能にして頂けると嬉しいです。\nご対応可能な際はどうぞよろしくお願いします！\n\nhttps://imgur.com/a/RSNGpHf", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/19", "thumbnail_src": "https://si.imgix.net/3dc5ac28/uploads/outputs/7d5ad1c8-4431-4a08-9ec2-da57422d75cf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44e3eb4b820453988d64838dd20de7c5", "thumbnail_srcset": "https://si.imgix.net/3dc5ac28/uploads/outputs/7d5ad1c8-4431-4a08-9ec2-da57422d75cf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44e3eb4b820453988d64838dd20de7c5, https://si.imgix.net/3dc5ac28/uploads/outputs/7d5ad1c8-4431-4a08-9ec2-da57422d75cf?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32541e030c0cf38f4c129ca00d40798f 2x, https://si.imgix.net/3dc5ac28/uploads/outputs/7d5ad1c8-4431-4a08-9ec2-da57422d75cf?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c93a0ca11aee7282de34621839c9393 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/18", "thumbnail_src": "https://si.imgix.net/c20ffee1/uploads/origins/caebeb80-63a8-4a82-9791-bd0fe54698a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13160c9d21bc719e4e78856445981904", "thumbnail_srcset": "https://si.imgix.net/c20ffee1/uploads/origins/caebeb80-63a8-4a82-9791-bd0fe54698a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13160c9d21bc719e4e78856445981904, https://si.imgix.net/c20ffee1/uploads/origins/caebeb80-63a8-4a82-9791-bd0fe54698a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c993438f7ebf0fafd2c5cc5d60b9010b 2x, https://si.imgix.net/c20ffee1/uploads/origins/caebeb80-63a8-4a82-9791-bd0fe54698a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94c1c296956fa7598ffad3082383719c 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラスト拝見しております。\n\n赤王さんの描かれたエヴァンジェリンが好きすぎて、\n是非ともと思ってこの度リクエストを送らせていただきました。\n\nご一考頂ければ幸いです。\n\n【キャラ】\n・エヴァンジェリン・A・K・マクダウェル（魔法先生ネギま！原作3巻の幻術で大人になった姿）\n\n【シチュエーション・ポーズ】\n・正常位（過去の脱衣ブロック崩しクリアシーンの構図）\n・敗北して幻術の姿のまま犯されている。（過去の脱衣ブロック崩しクリアシーンの内容のイメージ）\n\n【以下できればの希望内容】\n・脱衣ブロック崩しクリア後の展開のような差分があるととても嬉しいです…。\n・元は脱衣ブロック崩しのクリアシーンのおまけでしたが、服は着たままで、下着をずらされて挿入されていたら嬉しいです。（マントは地面に敷くような形だと嬉しいです。）\n・もしよろしければ、射精が長く続いて、精液を注がれ続けている描写を入れていただけると嬉しいです。\n\n出来ればの希望内容が多くなって申し訳ございません。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/17", "thumbnail_src": "https://si.imgix.net/9d8562f0/uploads/origins/89f45da3-78f5-48ce-ad5e-b388b4990692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d1747b4635a9d62422d1ab6fdca60cb", "thumbnail_srcset": "https://si.imgix.net/9d8562f0/uploads/origins/89f45da3-78f5-48ce-ad5e-b388b4990692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d1747b4635a9d62422d1ab6fdca60cb, https://si.imgix.net/9d8562f0/uploads/origins/89f45da3-78f5-48ce-ad5e-b388b4990692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d778f8ff57c665b7d0411ced116ef248 2x, https://si.imgix.net/9d8562f0/uploads/origins/89f45da3-78f5-48ce-ad5e-b388b4990692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a91832b6ac9a0e178ee0fc222adb246 3x", "genre": "art", "nsfw": true, "body": "こんにちは。リクエストをお願いしたいのでよろしくお願いします\n描いて頂きたいのはたくあんとバツの日常閻魔帳の妭ちゃんで\n内容としては以前赤王様が描かれていました作品https://www.pixiv.net/artworks/57316153\nの続きのようなものをお願いしたいです\n構図などは赤王様にお任せしたいのですが希望としては\n資料URLにある１枚のページに複数の構図が入っているような感じで\nキスシーンや妭ちゃんのお尻が強調されているような構図を\n入れて欲しいです。\n仕上げに関しては以前描かれていました作品のような仕上げでも\nカラーでもどちらでも構いません。\n受けて頂けると大変嬉しいです。よろしくお願いします\n\nhttps://skeb.jp/@Circle_November/works/169", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/16", "thumbnail_src": "https://si.imgix.net/336e5495/uploads/outputs/165a5317-5b10-410c-9400-0536493527e6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b9508f1aa01b85030536181fd6e18fa", "thumbnail_srcset": "https://si.imgix.net/336e5495/uploads/outputs/165a5317-5b10-410c-9400-0536493527e6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b9508f1aa01b85030536181fd6e18fa, https://si.imgix.net/336e5495/uploads/outputs/165a5317-5b10-410c-9400-0536493527e6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67d86647b826950c533405d836f6c8c9 2x, https://si.imgix.net/336e5495/uploads/outputs/165a5317-5b10-410c-9400-0536493527e6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce7f11525d54210671a29be7afd172b4 3x", "genre": "video", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/15", "thumbnail_src": "https://si.imgix.net/2470ea38/uploads/outputs/8ba0c8c8-ea90-4c03-b7dd-6e4fdd43f51c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e3cccff98fc14f58eaac2b5b40217cb4", "thumbnail_srcset": "https://si.imgix.net/2470ea38/uploads/outputs/8ba0c8c8-ea90-4c03-b7dd-6e4fdd43f51c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e3cccff98fc14f58eaac2b5b40217cb4, https://si.imgix.net/2470ea38/uploads/outputs/8ba0c8c8-ea90-4c03-b7dd-6e4fdd43f51c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=90f328d8046266fe7a31b547dff377ad 2x, https://si.imgix.net/2470ea38/uploads/outputs/8ba0c8c8-ea90-4c03-b7dd-6e4fdd43f51c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e78df3237150d4aa74a35be2d02b252 3x", "genre": "video", "nsfw": true, "body": "https://skeb.jp/@_redking/works/13\n以前の作品ドラコケンタウロスのムービーが素晴らしかったので、\nそのアレンジでリクエストいたします。\n\n■キャラ\nhttps://www.pixiv.net/artworks/98735022\nhttps://www.pixiv.net/artworks/91360864\n魔物ハンター妖子の真野妖子\n参考のようにテカりが出ていると嬉しいです。\n\n■内容\n流れはドラコケンタウロス同様、\n最初に触手の乳殴打？触手に粘液つきで撫でられてからの挿入がリクエストとなります。\n（触手は以前のものと同様でも、妖魔（バケモノっぽいの）が触手っぽく責める感じでもどちらでもいいです）\n\n希望点としては、\nチャイナドレスが溶かされる（破られる？）のは胸元のみで。\nhttps://www.pixiv.net/artworks/68510518\n上参考絵の背景絵のように胸元部分の露出。\n\n挿入はチャイナドレスのスリットの隙間に侵入して挿入。\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/14", "thumbnail_src": "https://si.imgix.net/bb6dcaae/uploads/origins/da9a454c-acd6-45a2-a7b2-dc18f600e081?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a606050a9a9b67abe9c6e70d1a51c8b5", "thumbnail_srcset": "https://si.imgix.net/bb6dcaae/uploads/origins/da9a454c-acd6-45a2-a7b2-dc18f600e081?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a606050a9a9b67abe9c6e70d1a51c8b5, https://si.imgix.net/bb6dcaae/uploads/origins/da9a454c-acd6-45a2-a7b2-dc18f600e081?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=1249f7abe1a3e063676e83eb7f48a9bf 2x, https://si.imgix.net/bb6dcaae/uploads/origins/da9a454c-acd6-45a2-a7b2-dc18f600e081?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f9bcc04f268522869b8cd2854666a7c 3x", "genre": "art", "nsfw": true, "body": "先日は素敵な妖精ピアレスちゃんをありがとうございました！\n\n妖精ピアちゃんの貧乳差分も見てみたく依頼させてもらいます。動いてもほんの少し揺れるか揺れないかくらいの慎ましやかなものをお願いします。\nまた、可能でしたら静止状態の画像、psdファイルの納品お願いしたいです。\n\n何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/13", "thumbnail_src": "https://si.imgix.net/b0cadc07/uploads/outputs/1ab71876-e2cb-4b71-8b33-0dfa6bf9e577?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=58bd9b4e0352370fada6340c2fe2272c", "thumbnail_srcset": "https://si.imgix.net/b0cadc07/uploads/outputs/1ab71876-e2cb-4b71-8b33-0dfa6bf9e577?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=58bd9b4e0352370fada6340c2fe2272c, https://si.imgix.net/b0cadc07/uploads/outputs/1ab71876-e2cb-4b71-8b33-0dfa6bf9e577?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc81e47e7d35dae33b1c083171ec037a 2x, https://si.imgix.net/b0cadc07/uploads/outputs/1ab71876-e2cb-4b71-8b33-0dfa6bf9e577?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc12376b120f329b60305db85b760df1 3x", "genre": "video", "nsfw": true, "body": "ぷよぷよのドラコケンタウロスのアニメーションをお願いしたいです。キャラデザインはセガ時代のもので、胸は大きめでお願いしたいです。アニメーションについては、エロフラのレナのアニメーションのような感じでお願い致します。後半からアヘりつつ両手を触手に拘束されているような感じだと嬉しいです。注文が多くなってしまい申し訳ありませんが、可能な範囲でよろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/12", "thumbnail_src": "https://si.imgix.net/1233f989/uploads/outputs/d2d52dfd-c5da-425f-bd88-f3966ae90341?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d5c4a205783892b5f6ace5e146e9faee", "thumbnail_srcset": "https://si.imgix.net/1233f989/uploads/outputs/d2d52dfd-c5da-425f-bd88-f3966ae90341?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=d5c4a205783892b5f6ace5e146e9faee, https://si.imgix.net/1233f989/uploads/outputs/d2d52dfd-c5da-425f-bd88-f3966ae90341?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc6d0b7d9c8c63bd3e79119841cad96b 2x, https://si.imgix.net/1233f989/uploads/outputs/d2d52dfd-c5da-425f-bd88-f3966ae90341?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=12bc8a0a802c0403786a838862e46994 3x", "genre": "video", "nsfw": true, "body": "赤王先生の描かれる素敵で可愛いイラストおよびアニメに惹かれ依頼を送らせてもらいます。 \nエヴァ様をはじめとした素敵なフラッシュの数々、クリアするまで時間を忘れ何度も何度もプレイしました。 \n\n赤王先生の素敵な作品を見たく依頼させてもらいます。 \n  うちの子妖精ピアレスちゃんのムービーをよろしくお願いします。 体型は先日制作された磯風ちゃんのイラストと同じくらい、胸は気持ちもう少しだけ大きめ。 服装は全裸にグレーのフルジップパーカーを胸が見えるよう前開きではだけさせ羽織り、足には黒ニーソ着用。もしくは全裸でお願いします。 \nシチュエーションは恋人とのいちゃらぶ騎乗位、視点は恋人主観で恋人の男性は中肉中背の１６０～１７０センチくらいのイメージでお願いします。 可能であれば中出し描写よろしくお願いします。 \n\n 先生のイラスト、エロフラが本当に好きですのでご検討いただければ幸いです。 何卒よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/11", "thumbnail_src": "https://si.imgix.net/c4771292/uploads/origins/7f550d20-c03d-45c0-a4c4-372f7b36d5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cad70a0b2f1c997f0a4a23b38732ad7", "thumbnail_srcset": "https://si.imgix.net/c4771292/uploads/origins/7f550d20-c03d-45c0-a4c4-372f7b36d5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cad70a0b2f1c997f0a4a23b38732ad7, https://si.imgix.net/c4771292/uploads/origins/7f550d20-c03d-45c0-a4c4-372f7b36d5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c831cf7361989d7532a86564758fd01 2x, https://si.imgix.net/c4771292/uploads/origins/7f550d20-c03d-45c0-a4c4-372f7b36d5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ff210773356bec2e0ac8d1bdcfd0f04 3x", "genre": "art", "nsfw": true, "body": "かなり特殊なリクエストになります。無理な場合はキャンセルを、非表示をご希望の場合は再送要請ををお願いします。\n\n艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\n\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。\n全身巻き付かれている事を強調する為、時津風の全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n時津風の表情ですが、大丈夫でしたら複数（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/10", "thumbnail_src": "https://si.imgix.net/69d1e9af/uploads/origins/358c91c2-75dd-4444-97aa-d61428e5546d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4c98a1c7f653647f59b9856a6b0a7eb4", "thumbnail_srcset": "https://si.imgix.net/69d1e9af/uploads/origins/358c91c2-75dd-4444-97aa-d61428e5546d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4c98a1c7f653647f59b9856a6b0a7eb4, https://si.imgix.net/69d1e9af/uploads/origins/358c91c2-75dd-4444-97aa-d61428e5546d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=59ba408217711e3688bd3cf5cb577048 2x, https://si.imgix.net/69d1e9af/uploads/origins/358c91c2-75dd-4444-97aa-d61428e5546d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3f119b995683fdb51caf67790173d31 3x", "genre": "art", "nsfw": true, "body": "とてもかわいい磯風ちゃんのイラストをありがとうございました\nぜひアニメ化をお願いしたいです\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/9", "thumbnail_src": "https://si.imgix.net/a385ef31/uploads/origins/a63631bd-8209-407b-9f57-41a7f4ae2aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d4d8e253199566598bb1d651798181", "thumbnail_srcset": "https://si.imgix.net/a385ef31/uploads/origins/a63631bd-8209-407b-9f57-41a7f4ae2aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d4d8e253199566598bb1d651798181, https://si.imgix.net/a385ef31/uploads/origins/a63631bd-8209-407b-9f57-41a7f4ae2aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7121232db12b72f675a7b7efec56c3f 2x, https://si.imgix.net/a385ef31/uploads/origins/a63631bd-8209-407b-9f57-41a7f4ae2aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1a4856d70c0b662ef582d70c52b9e77 3x", "genre": "art", "nsfw": true, "body": "アズールレーンの磯風ちゃんでごぢゃ動にあったような男性主観の騎乗位をお願いします\n全裸か羽織のみでシチュとしてはいちゃラブ、男性は普通の成人男性\n流れはお任せできる範囲でグラインドやピストンから射精シーンを入れて欲しいです", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/8", "thumbnail_src": "https://si.imgix.net/e04da413/uploads/origins/655d3101-291a-4f3c-abb0-ebbec2e2f6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e70b0346df308f862258018a7dcf4325", "thumbnail_srcset": "https://si.imgix.net/e04da413/uploads/origins/655d3101-291a-4f3c-abb0-ebbec2e2f6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e70b0346df308f862258018a7dcf4325, https://si.imgix.net/e04da413/uploads/origins/655d3101-291a-4f3c-abb0-ebbec2e2f6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bdda4090c967e4f2dc34d930f8a5963 2x, https://si.imgix.net/e04da413/uploads/origins/655d3101-291a-4f3c-abb0-ebbec2e2f6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91d59fae12ef513d1bdec7d5aee99731 3x", "genre": "art", "nsfw": true, "body": "シャドウ[情欲の蛇]にマリンカリン漬けにされる桐条美鶴の18禁イラストの作成をお願いします。\n\n内容は以前ホームページにアップされた「桐条美鶴(ペルソナ3)」とほぼ同じで\n画面を手前に引いてなるべく彼女の全身が写るように作成をお願いしたく\n7枚目の後に触手ちんぽをオネダリする描写と、再び挿入されながら触手ちんぽを生涯愛すると誓う描写をお願いします。\n\nキャラ名\n：桐条美鶴(ペルソナ3)\n\n衣装\n：ホームページにアップされた画像の衣装は胸部分が開けた服でしたが\n全裸と体にぴっちり張り付く戦隊スーツ(ヘルメット付き)でお願いします。\n※戦隊スーツの細かい内容はお任せでお願いします。\n※戦隊スーツ着用時の挿入はぬのごしに挿入される感じでお願いします。\n\n又、納品データはPSDファイルでモザイク以外の箇所を線、色、影や光沢の効果等でレイヤーを分けてレイヤー未統合状態でお願いしたいです。\n\n以上リクエスト内容となります、ご確認の程宜しくお願いたします。\n\nhttp://akadamaya2.sblo.jp/article/188360830.html", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/7", "thumbnail_src": "https://si.imgix.net/ec0b1758/uploads/origins/73ea3433-b65c-48d1-aa23-2877584f77fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c57ab0ed97de40285dbb3853f91a2b", "thumbnail_srcset": "https://si.imgix.net/ec0b1758/uploads/origins/73ea3433-b65c-48d1-aa23-2877584f77fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c57ab0ed97de40285dbb3853f91a2b, https://si.imgix.net/ec0b1758/uploads/origins/73ea3433-b65c-48d1-aa23-2877584f77fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccb89b85479469052c8fdeaec1d5b4f3 2x, https://si.imgix.net/ec0b1758/uploads/origins/73ea3433-b65c-48d1-aa23-2877584f77fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1ff86fc6fe1a377a4fca35f725024ef 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n\nキャラクター\n幼児レパード（夜のヤッターマン）\n\n身体はペド化（２～3歳程度）に\n髪の長さは身体に対して長く、\n服や仮面は全てひん剥かれていて全裸\n\nシチュエーションなど\nホームレスの男に誘拐され、汚いブルーシートの上で窒息レイプされる。\n\n・レイプのされ方は参考画像のような感じで\n・レパードちゃんは「あがっ…！」「かひゅー…」「かひゅー…」と苦しそうにしていて\n「ママ…」「ママ…」「助けて…」と心の中で泣いている\n\nhttps://pawoo.net/@3per/106247216726366121", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/6", "thumbnail_src": "https://si.imgix.net/73adb202/uploads/origins/e7224b3f-ae52-4a52-ac94-8f5b6d6eb0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d670296956df6554b6f96822b1b8ee2a", "thumbnail_srcset": "https://si.imgix.net/73adb202/uploads/origins/e7224b3f-ae52-4a52-ac94-8f5b6d6eb0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d670296956df6554b6f96822b1b8ee2a, https://si.imgix.net/73adb202/uploads/origins/e7224b3f-ae52-4a52-ac94-8f5b6d6eb0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ff233b30ea03b702a8b5e9e706d13cf 2x, https://si.imgix.net/73adb202/uploads/origins/e7224b3f-ae52-4a52-ac94-8f5b6d6eb0ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f54ffd14f58fa61cda7d98fa74a420e5 3x", "genre": "art", "nsfw": true, "body": "分娩台的なモノに拘束されて乳首やクリトリスを電動ブラシ等で磨かれてビクンビクンしてるエルピー=プルをお願いします。ボテ腹差分あれば有難いです", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/5", "thumbnail_src": "https://si.imgix.net/78aa4c68/uploads/origins/82e1274b-09b2-4f56-ba74-44ea7a45d9ba?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1f9bb349026511c7e0dd2e1cf9f9adf8", "thumbnail_srcset": "https://si.imgix.net/78aa4c68/uploads/origins/82e1274b-09b2-4f56-ba74-44ea7a45d9ba?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1f9bb349026511c7e0dd2e1cf9f9adf8, https://si.imgix.net/78aa4c68/uploads/origins/82e1274b-09b2-4f56-ba74-44ea7a45d9ba?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3763751cb163e7b7f30768114e36e57 2x, https://si.imgix.net/78aa4c68/uploads/origins/82e1274b-09b2-4f56-ba74-44ea7a45d9ba?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b11926168e0cc9a16491c6bc685a108 3x", "genre": "art", "nsfw": true, "body": "初めまして\nアンドロイド娘のひょっとこフェラでアニメーションの作成をお願い出来ないでしょうか\nループするアニメで背景、射精表現は無しでも大丈夫です\n\nキャラクター\n参考資料①のアンドロイド娘（以下Ritsu）\nある程度のデフォルメ、デザインの簡素化も大丈夫です\n髪の毛の動きは最小限で髪の長さが短めでも大丈夫です\n\nポーズ\n・69体制\n・腕立てひょっとこフェラ：参考資料①\n参考資料①よりじっくりとした表現で先端から根本の往復表現をお願いしたいです\n特に根本部分ではしっかり押さえ付けるような表現だと嬉しいです\n・ひょっとこ率は高め：参考資料②\nひょっとこ状態を出来るだけ解除しないような形がよいですが\nアニメーションの自然さの問題やこだわりがある場合はお任せします\n・後述のシチュエーションでも触れますが、がに股だとなお良いです\n\nシチュエーション（背景は無しでも大丈夫です）\n・ロッカーのような場所\n・男性の表示は足ぐらいだと思いますが局部とキャラクターの比率は参考資料①と同程度でお願いします\n・男性はよくある青いベンチで足を開いて跨った状態で倒れています（69体制なので足を画面側に向けています）\n・Ritsuはベンチに倒れている男性に対してさらに跨った状態で、足をがに股かつ＜＞の形で69を行います\n参考資料①は床で、こちらはベンチですがそこまで高くない設定でお願いします\n・Ritsuの表情は無感情（目のハイライト無し）で機械的な動作で命令に従っています\n・Ritsuの表情で差分をお願い出来る場合は瞳孔が開いた状態で上に寄る無表情アヘ顔版もあるととても嬉しいです\n参考資料内の無感情垂直フェラ　＞　アヘ顔版　＞　捻りフェラの順の優先度指定になります\n\n参考資料①\nアングル、ポーズ、キャラクターの参考資料です\nhttps://fantia.jp/posts/62617\n無料プランでダウンロードできるファイル内Ritsu3.mp4\nお手数おかけしてすみませんが、現在はここでしか参考になる動画を指定できず。。。\n一応元モデル名はkuroyu ritsu edit by thisisnommyになります\n\n参考資料②\nひょっとこ率の参考資料\nhttps://twitter.com/Flim_13/status/638371090763350016?s=20", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/4", "thumbnail_src": "https://si.imgix.net/530f42b3/requests/237239_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0529a778493f4a249e0cb06c370f42a5", "thumbnail_srcset": "https://si.imgix.net/530f42b3/requests/237239_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0529a778493f4a249e0cb06c370f42a5, https://si.imgix.net/530f42b3/requests/237239_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3deb2ebf7ad8686e95e9de3e3717352 2x, https://si.imgix.net/530f42b3/requests/237239_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=680c788022e411b1e50eae691c1e807c 3x", "genre": "art", "nsfw": true, "body": "デビルチルドレン ライト&ダークのレナ アニメーションでお願いします シーン纏めた物と１シーンループを出来ましたらお願いします。 基本シチュエーションはFLASH作品と同じで 大まかな流れ スカート押さえ →スカートを持ち上げパンツ露出 →触手がパンツの上から愛撫 →他の触手がパンツに絡まりパンツ降ろす(股間は濡れている) →触手で足を開かせる(大股ではなく、小股くらいに) →他の触手使い性器を開く(出来ましたらここから膣口のワイプを) →触手挿入待機(触手先端から男性器が剥ける様に出る) →触手挿入(破瓜の血が流れる) →ピストン１ →ピストン２ →ピストン３(フィニッシュ前) →触手射精 →触手抜く →性器から血と精液流れる(性器の下に抜いた男性器触手) →放心状態(ハイライト無し、ワイプ終わり) →ブラックアウト ここからは出来ましたらでお願いします。 →ブラックアウトの画面に　その後… →洗脳後の触手挿入待機 →触手挿入 →ピストン１(ここからアへ顔で) →ピストン２ →ピストン３(フィニッシュ前) →触手射精 →射精後そのまま高速ピストン →ブラックアウト 指定がないシーンの表情はお任せします。 アニメーションの依頼は初めてで、料金が釣り合っているかわかりませんが、足りなければシーンを削っていって下さい。 よろしくお願いいたします", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/3", "thumbnail_src": "https://si.imgix.net/614eaaef/requests/184836_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0175910e209718b10fbece27aa3109", "thumbnail_srcset": "https://si.imgix.net/614eaaef/requests/184836_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0175910e209718b10fbece27aa3109, https://si.imgix.net/614eaaef/requests/184836_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb0c2688055b8d76b565e98090d85531 2x, https://si.imgix.net/614eaaef/requests/184836_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7644d67c7afae7583d5822bb5f7e96bc 3x", "genre": "art", "nsfw": true, "body": "初めまして。\n宜しければ、このすばからアイリスをお願いできますでしょうか？\n\nある魔道具により強制レベル1化、全スキル封印、感度10倍の呪いを受けた状態で王宮からエロトラップダンジョンの最下層へ転送されてしまう。\n出口を必死に目指していたが、感度が上がった状態で注意が散漫としていたところに衣服解除＋触手拘束トラップの餌食に。\n\n前置きが長くなってしまいましたが、ローター型の触手で未成熟の胸を、回転型ブラシ触手でつるまんとクリを執拗に責めたてられ、何度もイキ続けてしまうシチュエーションをお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/2", "thumbnail_src": "https://si.imgix.net/3816b012/requests/207913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b9d123ca99bc4dc6283c7a369f2c8ad", "thumbnail_srcset": "https://si.imgix.net/3816b012/requests/207913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b9d123ca99bc4dc6283c7a369f2c8ad, https://si.imgix.net/3816b012/requests/207913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eda271aec6ba2c0eb7e154ad5062a706 2x, https://si.imgix.net/3816b012/requests/207913_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1de2c40b736fd400c022113cbd23489b 3x", "genre": "art", "nsfw": true, "body": "キャラ：\nスーパーロボット大戦Fのミーナ・ライクリング\nシチュ：\n敵に捕まったとかそんなイメージでpixivにある\nモルジアナ（マギ）　LayerPaint練習\nhttps://www.pixiv.net/artworks/29878432\nのように裸に首輪をつけられ股をおっぴろげて拘束されている状態をお願いします。\nウィズ　[このすばマイクロビキニ部]\nhttps://www.pixiv.net/artworks/55594125\nのようにちょろっと陰毛も描いてほしいです。\n表情は\n[C81]カードファイト!!ヴァンガード　CG+動画集\nhttps://www.pixiv.net/artworks/23996736\nのように悔しそうな感じがいいですね。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_redking/works/1", "thumbnail_src": "https://si.imgix.net/4cb83211/requests/183617_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fd4f6493577e959d3272cd5e4d05e7", "thumbnail_srcset": "https://si.imgix.net/4cb83211/requests/183617_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fd4f6493577e959d3272cd5e4d05e7, https://si.imgix.net/4cb83211/requests/183617_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da72f82db18171c9e6d85eba5adc446c 2x, https://si.imgix.net/4cb83211/requests/183617_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d39e4e86fffa605528d4b793880b7e6 3x", "genre": "art", "nsfw": true, "body": "お試しでリクエストさせていただきます。\nメイドラゴンより 才川リコで\nトイレのカメラ盗撮動画イラストをお願いします。\n和式トイレの中から見上げる構図、目隠し線をお願いします。\n\n追加出来ましたら\n目隠し線無し、排泄小or大をお願いいたします。", "created_at": "", "completed_at": ""}]}