0f-417d-9fdd-c40badfa5307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d354dda176d25644c422537e712eb49c", "thumbnail_srcset": "https://si.imgix.net/195a737b/uploads/origins/da354159-5e0f-417d-9fdd-c40badfa5307?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d354dda176d25644c422537e712eb49c, https://si.imgix.net/195a737b/uploads/origins/da354159-5e0f-417d-9fdd-c40badfa5307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9a42cf5be254aa6db44a27397574ade 2x, https://si.imgix.net/195a737b/uploads/origins/da354159-5e0f-417d-9fdd-c40badfa5307?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e736e5e4df82ff6aa07f03679664f878 3x", "genre": "comic", "nsfw": true, "body": "こんにちは\n以前、副部長トリオのイラストをリクエストさせていただいたものです。\n\n下記の内容で漫画のリクエストを送らせていただきます。  \n\nキャラ　中川 夏紀×塚本 秀一\n \nシチュエーション　久美子と本番に備えて、夏紀から秀一を誘って練習H\n\nプレイ内容、表情や台詞などはおまかせいたしますので、自由に描いてください！\n\n 内容が合わなければキャンセルしていただいて大丈夫です。\nご検討をよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/70", "thumbnail_src": "https://si.imgix.net/4e936e85/uploads/origins/502d8763-1b40-475c-b81d-2d89b8188314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a5e8a3e2d0235272f699e5da9b4b28a", "thumbnail_srcset": "https://si.imgix.net/4e936e85/uploads/origins/502d8763-1b40-475c-b81d-2d89b8188314?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a5e8a3e2d0235272f699e5da9b4b28a, https://si.imgix.net/4e936e85/uploads/origins/502d8763-1b40-475c-b81d-2d89b8188314?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15026c1e6e4ce082faf9581facd9a1e3 2x, https://si.imgix.net/4e936e85/uploads/origins/502d8763-1b40-475c-b81d-2d89b8188314?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a81422190a9ab31a960cb14e33d7d420 3x", "genre": "art", "nsfw": false, "body": "初めまして麦畑さん、アピールありがとうございます！\nアルダンさんにてお誘を掛けてくださり、大変ありがたい次第！\n……ですがご覧頂いた通り、今自分がアルダンさんでハマってる内容は大変クセが強く、ハッキリ言って麦畑さんとはジャンル違いも甚だしく……。\nそれでも……それでもよろしいのでしたら、「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」をさせたイラストなどお願いできるでしょうか！？\n\n・参考：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯は、ゲーム内のイベントでアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。また彼女の勝負服が黒ベースにグリーンをあしらう、丑御前（＝源頼光）を彷彿するカラーリングや、身を削る必殺技同士……などなど、こじつけるに足る理由に個人的に盛り上がってしまったためです。\n今アルダンさんに対する願望として自分が求めるのはこの有様で……ですので、難しいとかイメージを損ないたくないなど思う所がありましたら、お題を変えて再送依頼やお断り等して頂いて結構です、そのくらいの無茶は承知の上です。\nただ、麦畑さんのほんわか柔らかな可愛い絵柄で、あの厳つい武装を着こなすアルダンさんという、大変レアなギャップを味わえるというのでしたら、是非ともお願いしたいです！！\n\n表情や構図・ポーズついては、麦畑さんが思うアルダンさんのイメージのまま描いて頂ければOKです。あくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（元ネタになりきられると暗く病んじゃう感じになり、それは本意ではないのでｗ）\nお茶目だったりお淑やかだったり、時々カッコつけたがったり等、麦畑さん解釈のアルダンさんで「らしい」振る舞いとリアクションで描いて頂ければOKです！\n一応コスプレ（衣装）がメインなので、できる範囲で、衣装姿を拝める構図で着こなしを堪能させて頂ければ幸いです！\n\nあれこれ書いてしまいましたが、要は「アルダンさんに丑御前服を着せて」を最低限に、あとは麦畑さんにお任せです！\nクセ強な超難易度ですが、それでもよろしければ何卒お願いします……！\n\nhttps://www.pixiv.net/artworks/115999216", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/69", "thumbnail_src": "https://si.imgix.net/08c2e50a/uploads/origins/67364d04-e37e-45d5-9461-371cd79d42f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61fdc7029336362c989641252670135b", "thumbnail_srcset": "https://si.imgix.net/08c2e50a/uploads/origins/67364d04-e37e-45d5-9461-371cd79d42f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61fdc7029336362c989641252670135b, https://si.imgix.net/08c2e50a/uploads/origins/67364d04-e37e-45d5-9461-371cd79d42f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc27f3f489f4b7d653b28ef290fcbe61 2x, https://si.imgix.net/08c2e50a/uploads/origins/67364d04-e37e-45d5-9461-371cd79d42f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de2c18c07a082a55cbf9f68a41c8f05b 3x", "genre": "art", "nsfw": true, "body": "以前は七耀みつるのイラストをありがとうございます…！\nもし可能でしたら、以下のシチュエーションでイラストをお願いいたします。\n\n・キャラクター\nステーションメモリーズ！(駅メモ！)\n新百合ほこね\n\n・シチュエーション\n自慰行為をお願いいたします。\n（可能であれば、下記資料のおもちゃを用いての異物挿入自慰。無理であれば一般的な自慰で大丈夫です。）\n構図はお任せいたします。\n\n余力がございましたら絶頂中や、その後余韻の差分がいただけたら嬉しいです。\n\n・容姿につきまして\n胸や脚はある程度盛って頂けますと嬉しいです。\n\n・衣服につきまして\n下記参考資料の衣装でお願いいたします。必要箇所を脱がす、あるいは破く感じでお願いいたします。\n背中の黒い物体は省略していただいて構いません。\nご面倒であれば全部脱がしても構いませんが、手袋は脱がさないでください。\n\n記載無き事項はお任せいたします。\nご検討のほどよろしくお願いいたします。\n\n【各種資料】\n\n1.おもちゃの資料\nhttps://amzn.asia/d/dfWBmoc\n\n2.二次創作ガイドライン\nhttps://ekimemo.com/guideline\n\n3.キャラクター資料\nhttps://ek1mem0.wiki.fc2.com/wiki/%E6%96%B0%E7%99%BE%E5%90%88%E3%81%BB%E3%81%93%E3%81%AD", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/68", "thumbnail_src": "https://si.imgix.net/78ba2e1f/uploads/origins/72df9681-85e4-4da2-a196-1ad42e7cc68d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7ea9ecb4bec5b62391abf2eff4f459", "thumbnail_srcset": "https://si.imgix.net/78ba2e1f/uploads/origins/72df9681-85e4-4da2-a196-1ad42e7cc68d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef7ea9ecb4bec5b62391abf2eff4f459, https://si.imgix.net/78ba2e1f/uploads/origins/72df9681-85e4-4da2-a196-1ad42e7cc68d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ee408e77d37be22a2853be8c4e1b30d 2x, https://si.imgix.net/78ba2e1f/uploads/origins/72df9681-85e4-4da2-a196-1ad42e7cc68d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=994e566c2dbcf8aa184e93b88842add9 3x", "genre": "art", "nsfw": false, "body": "麦畑さん、こんにちは！\n\nルカを描いていただけませんか？ポーズや服装は問いません。個人的な意見ですが、ルカの服装はカジュアルかかわいい系が合うと思うので、その系統でお願いします。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/67", "thumbnail_src": "https://si.imgix.net/0ec08aa1/uploads/origins/ae0b94f6-cbdb-427f-9642-df906e94c049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ad55aa982885e33c59ff6f22cf23218", "thumbnail_srcset": "https://si.imgix.net/0ec08aa1/uploads/origins/ae0b94f6-cbdb-427f-9642-df906e94c049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ad55aa982885e33c59ff6f22cf23218, https://si.imgix.net/0ec08aa1/uploads/origins/ae0b94f6-cbdb-427f-9642-df906e94c049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1a54976da6d36e79eb6cba5af1b1061 2x, https://si.imgix.net/0ec08aa1/uploads/origins/ae0b94f6-cbdb-427f-9642-df906e94c049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22e1f40862bace8ee4042a17a3e3769e 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n「異世界居酒屋のぶ」の千家しのぶ、エーファ、ヘルミーナを真上からの主観ハメ撮り視点でハメてる中出しバックセックスおなしゃっす！！！\n\n絵柄はアニメ版寄りでお願いします！\n\nお尻並べてハメてる感じ、竿は体の一部が見えてる程度で\n\n背景は居酒屋のカウンターに手をついている感じで！\n服装は通常の衣装で（細部はだいたいで構いません）！\n\n表情は全員照れて恥ずかしがっている感じで\nセックスしつつこっち振り向いている感じですかね\n\n服をきたままで、しのぶはズボンをおろして、エーファとヘルミーナはスカートを捲り上げてお尻が見えてる感じで！\n\nおぱんつはカウンターの上に添えて、\nしのぶ→黄緑の下着\nエーファ→白のコットンおぱんつ\nヘルミーナ→ピンクの下着\nでお願いします！\n↑おぱんつ超大事！\n\n画像サイズは縦3000ピクセル以上の大きな画像で、pngかpsdでお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/66", "thumbnail_src": "https://si.imgix.net/28e452cc/uploads/origins/4b436698-5117-48b3-a98e-7298e5d152a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5e23ec394364d28ace1f695727ef6d", "thumbnail_srcset": "https://si.imgix.net/28e452cc/uploads/origins/4b436698-5117-48b3-a98e-7298e5d152a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5e23ec394364d28ace1f695727ef6d, https://si.imgix.net/28e452cc/uploads/origins/4b436698-5117-48b3-a98e-7298e5d152a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92864fd06a472de26c855b37adbf0d9e 2x, https://si.imgix.net/28e452cc/uploads/origins/4b436698-5117-48b3-a98e-7298e5d152a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de3ebcd3926983f7618380df03c075b1 3x", "genre": "art", "nsfw": true, "body": "瀧川ちかお×黄前久美子のエロ絵をお願いします。\n「大学うわきえっちCHIKAKUMI」\n\n●久美子は「久美子と秀一のおうちデートな1日」(以下　夏新刊)の久美子と同じ高校卒業後の久美子で、夏新刊の服のシャツと靴下のみ着用。髪型はポニテ。陰毛は髪の色と同色にする\n●久美子は大学の教室の床又は机の上でこの1枚目の晴香https://mugibatake.fanbox.cc/posts/5374876のように足を揃えて上げているポーズ(膝の裏で腕を組んで足を抱え込んでいるイメージ)をしている\n●ちかおがGスポットバイブhttps://www.pixiv.net/artworks/97162179を持って久美子のGスポットをピンポント責めしている。ちかおはバイブを持っている腕だけでOK\n●久美子は「おほっ」系の下品な喘ぎ声を出して喘いでいる\n●設定→夏新刊と「うわきえっちKitauji」(以下　うわき本)がミックスした世界観。久美子とちかおは高校(うわき本)時代から肉体関係あり。久美子と秀一は夏新刊同様の同じ大学の別学部で、久美子とちかおは同じ大学の同じ学部。久美子はエッチの時の幸福度は秀一との方が高いが、肉体的快楽はちかおとの方が強い(うわき本と同様に久美子と秀一のチンコは相性が良くない)。ちかおは彼女のちえりが音大で忙しくてなかなか会えない寂しさから、久美子はちかおとのエッチの快楽(ちかおによる乳首責めやGスポット責めは思い出すだけで濡れるレベル)が忘れられず、大学の空き教室などで頻繁にうわきえっちをしている。\n\n\n夏コミお疲れ様でした。夏新刊を拝読し、奥付の真由を見て「秀一…あれだけ久美子が心配だと言っておきながら浮気かよ！」というツッコミ感想が出て(もちろん本文と奥付が繋がったストーリーでないのはわかっています…繋がってませんよね？)思い浮かんだネタのリクエストです。ご検討をお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/65", "thumbnail_src": "https://si.imgix.net/b48e9ce3/uploads/origins/3a280c3d-7514-4798-a159-abfbe749f244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4909d459170ff045649f59a95244257f", "thumbnail_srcset": "https://si.imgix.net/b48e9ce3/uploads/origins/3a280c3d-7514-4798-a159-abfbe749f244?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4909d459170ff045649f59a95244257f, https://si.imgix.net/b48e9ce3/uploads/origins/3a280c3d-7514-4798-a159-abfbe749f244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98e5874e728ec2e077a9064e7557a8f4 2x, https://si.imgix.net/b48e9ce3/uploads/origins/3a280c3d-7514-4798-a159-abfbe749f244?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcb69313631e1bf85174dbab35f32739 3x", "genre": "art", "nsfw": true, "body": "こんにちは！私のVtuberをこのようなポーズで描いて欲しいのですが、その代わりに正面を向き、視聴者を見て潮を吹いています（https://skeb.jp/@mugi_t/works/62）。ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1LidL7hlFLn1rEoTM-KZJ5QEfue8pRm2E?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/64", "thumbnail_src": "https://si.imgix.net/8950dadf/uploads/origins/e76d9a09-8e27-4998-b2ee-2a0ce28682d1?bg=%2