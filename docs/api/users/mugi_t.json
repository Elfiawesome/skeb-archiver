e=30&txt=PRIVATE&s=a59637b423a4623cd35c0fc57f172c1f 2x, https://si.imgix.net/23b9cc80/uploads/origins/336cea55-7e83-40be-b3a6-c4908cc208a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac0d04dd595d51225edd8e76ddcac577 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/89", "thumbnail_src": "https://si.imgix.net/46a72c53/uploads/origins/5f75a495-5505-4677-9770-94fa65a5fab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a3442ea67c7c1b5db5b1c6cf3a9b11b", "thumbnail_srcset": "https://si.imgix.net/46a72c53/uploads/origins/5f75a495-5505-4677-9770-94fa65a5fab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a3442ea67c7c1b5db5b1c6cf3a9b11b, https://si.imgix.net/46a72c53/uploads/origins/5f75a495-5505-4677-9770-94fa65a5fab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a56d5cbb1082179fbfb6ed2a65e0b17 2x, https://si.imgix.net/46a72c53/uploads/origins/5f75a495-5505-4677-9770-94fa65a5fab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a2984611d62e41c16cc10a7abd8f5ca 3x", "genre": "comic", "nsfw": true, "body": "青ブタのエロコミックをお願いします。前回リクhttps://skeb.jp/@mugi_t/works/87までと同じ世界線です。\n\n◇登場人物\n●双葉理央、梓川咲太の2人でロジカルウィッチ編時の設定。理央は眼鏡ポニテ(左前髪の内側にはねてるパーツは必ず描く)版で夏制服(資料)を着用\n●理央は陰毛無しでアナルはこのしのぶhttps://skeb.jp/@mugi_t/works/67同様に肉厚な感じで人一倍敏感な最大の弱点という設定\n\n◇場所\n物理準備室https://x.com/eduosu00/status/2007244860630466683\n\n◇話の流れ\n●シーン①　\n咲太「色々あったけど双葉がひとりに戻ってよかったよ」\n理央「梓川には迷惑かけたね」\n咲太「それは別にいいんだけどさ、もう僕以外のサル同然の男に目を付けられるような真似はするなよ」\n理央「そうだね。次は他人を巻き込まないことにするよ」\n咲太「…自傷行為は続けるのかよ」\n理央「自分のことなんて嫌いでいいって言ったのは梓川でしょ。それに習慣は簡単に変えられないよ」\n咲太「じゃあさ双葉…」\n\n●シーン②\n双葉は白衣とスカートとパンツを脱いで咲太に抱きかかえられた状態(https://skeb.jp/@hub_dump/works/211で男の手が女の会陰の左右を掴むイメージ)で机の流しにお尻を向けさせられている。机の流しの蛇口の根本に理央のスマホが置かれている(撮影状態)。理央は恥ずかしすぎると訴えるも、これは双葉の恥ずかしい姿を僕に撮影させる自傷行為なんだから諦めて早くおしっこを出せと咲太は取り合わない\n\n●シーン③\n咲太は理央を抱きかかえたまま片方の手の指2本を理央のアナルに抜き差し、もう片方の手で理央のクリトリスを弄る。理央は快楽に悶えてやがて絶頂し同時にイキションを机の流しに放尿する\n\n◇備考\n●ロジカルウィッチ編で花火大会後～夏休み終了の期間に咲太が理央の部活に顔を出した際の出来事。恥ずかしい姿を咲太に撮影させる自傷行為を提案された理央は快楽責めの末に放尿姿を撮影される\n●シーン①の部分はふきだしと台詞だけでOK。話の流れは大まかなイメージなのでコマ割り等はおまかせで。指定したセリフは大枠を外れなければ改変・追加OK\n●消しは前回同様に線消しで上記の内容に合う擬音と喘ぎ声・台詞を付ける\n\nhttps://x.com/aobuta_anime/status/1716072968185696264", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/88", "thumbnail_src": "https://si.imgix.net/edac3b92/uploads/origins/221bc154-4bdd-47cc-80c3-02643e423ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=088a31a39dadc4f96810b742f6fad29d", "thumbnail_srcset": "https://si.imgix.net/edac3b92/uploads/origins/221bc154-4bdd-47cc-80c3-02643e423ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=088a31a39dadc4f96810b742f6fad29d, https://si.imgix.net/edac3b92/uploads/origins/221bc154-4bdd-47cc-80c3-02643e423ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=024d18fad8cb7ff802e95b7e2918c55e 2x, https://si.imgix.net/edac3b92/uploads/origins/221bc154-4bdd-47cc-80c3-02643e423ecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19be91d338c807a9ab280d16f2fba4ec 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/87", "thumbnail_src": "https://si.imgix.net/4b9ec35e/uploads/origins/b5f016ff-1a63-4480-8d8d-882c731300ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b26215765f0a3680864b0b33d09255b", "thumbnail_srcset": "https://si.imgix.net/4b9ec35e/uploads/origins/b5f016ff-1a63-4480-8d8d-882c731300ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b26215765f0a3680864b0b33d09255b, https://si.imgix.net/4b9ec35e/uploads/origins/b5f016ff-1a63-4480-8d8d-882c731300ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7a2cbe652c91a2900dcaca4536e84c9 2x, https://si.imgix.net/4b9ec35e/uploads/origins/b5f016ff-1a63-4480-8d8d-882c731300ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4c4be27c3541ab407708979e7eec5de 3x", "genre": "comic", "nsfw": true, "body": "青ブタのエロコミックをお願いします(内容を再構成して再チャレンジ)。前回リクhttps://skeb.jp/@mugi_t/works/84と同じ世界線です。\n\n◇登場人物\n●双葉理央、梓川咲太の2人でロジカルウィッチ編時の設定。理央は梓川家に泊まってる方の眼鏡有り髪おろし理央(左前髪にある内側にはねてるパーツは必ず描く)\n●理央は陰毛無しでアナルはこのしのぶhttps://skeb.jp/@mugi_t/works/67同様に肉厚な感じで人一倍敏感な最大の弱点という設定で、アニメで梓川家に泊まってる時の私服を着用\n\n◇場所\n咲太の部屋(資料)\n\n◇話の流れ　\n●シーン①　「」は肉声、（）は内心の声\n咲太「んじゃ、僕は学校に行ってくるからな。…そうだ双葉。留守番中に僕のマッサージ器を使ってていいぞ」\n理央「…おい、なんだこれはブタ野郎」\n咲太「なんだって…普通の家電屋で売ってるただのマッサージ器だろ。それとも物知りな双葉はそれ以外の用途を知ってるのか？」\n理央(コイツ、真顔でいけしゃあしゃあと💢)\n咲太「遠慮はいらないぞ。僕と双葉は尻穴を舐めあった仲じゃないか」\n理央「私は舐めてないだろさっさと行けクソブタ野郎！」\n\n●シーン②　暗転コマ(咲太外出の書き文字)\n\n●シーン③　大き目の1コマ絵\n理央はズボンとパンツを脱いで喘ぎ声を漏らさないようにシャツをまくり上げて口に咥えておっぱいを露出させた状態で、咲太の部屋の壁又はベッドに背を預けてM字開脚して床に座り、片手に持った激しく振動する電マを自分のクリトリスに当てて刺激しながらもう片方の手の指2本を自分のアナルに抜き差しするオナニーをして絶頂する。床には愛液が大量に垂れている\n\n◇備考\n●ロジカルウィッチ編で麻衣が梓川家から引き上げた後の8月6日～8月11日の出来事。咲太が悪戯心で用意した電マに腹を立てつつも、不安定な状況のストレスやしばらく自慰ができずに欲求不満が溜まっていた事、知識として知っていた電マ刺激への興味から、電マ刺激快楽を貪りつつ開花させられた尻穴快楽に耽る理央というシチュ\n●シーン①の指定したセリフは大枠を外れなければ改変・追加OK\n●シーン①は簡略作画やふきだしと台詞だけの部分があってもOK\n●シーン③の内容に合う擬音と喘ぎ声・セリフを付ける\n●消しは前回同様に線消しで\n\n以上、ご検討願いします。\n\nhttps://cdn-ak.f.st-hatena.com/images/fotolife/g/gunber/20200614/20200614212400.jpg", "created_at": "", "completed_at": ""}, {"path": "/@mugi_t/works/86", "thumbnail_src": "https://si.imgix.net/703b3fb5/uploads/origins/76c1741b-7bcb-45cf-9e55-a0f6ef7a6aef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20