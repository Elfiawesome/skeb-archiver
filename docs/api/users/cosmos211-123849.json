方が押せ押せで兄は押され気味ながらもかわいいやつだな…と甘やかしているイメージです。\n\n▽使用用途\n個人鑑賞用です。\n\n内容が合わなければキャンセルして頂いて大丈夫です。\nお時間、金額の都合が合いましたらご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tUFwYVB1qmh2L9kL4bQvPiLI6KY_qa7o?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@cosmos211/works/38", "thumbnail_src": "https://si.imgix.net/7fe14923/uploads/origins/22a5c0ee-1baf-44c3-bbfb-ca956ba68f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e859a6920d2779b24db46ab0a0a4fa3a", "thumbnail_srcset": "https://si.imgix.net/7fe14923/uploads/origins/22a5c0ee-1baf-44c3-bbfb-ca956ba68f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e859a6920d2779b24db46ab0a0a4fa3a, https://si.imgix.net/7fe14923/uploads/origins/22a5c0ee-1baf-44c3-bbfb-ca956ba68f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb73c17b4f290bdcc1bd5423f6093d42 2x, https://si.imgix.net/7fe14923/uploads/origins/22a5c0ee-1baf-44c3-bbfb-ca956ba68f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee3202d725334916a4d98f99f8c73db8 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@cosmos211/works/37", "thumbnail_src": "https://si.imgix.net/3e25567e/uploads/origins/1ec4b013-5dc5-4994-9a3c-4036260c9297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b08b6d9f1e59fb7278bec598470ed07", "thumbnail_srcset": "https://si.imgix.net/3e25567e/uploads/origins/1ec4b013-5dc5-4994-9a3c-4036260c9297?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b08b6d9f1e59fb727