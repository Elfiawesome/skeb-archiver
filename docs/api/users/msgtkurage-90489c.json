dhptkf0ufiw6n1/ANAgSuZL_SMiWcb1wKa7Cz4?rlkey=c2rf5nr5u8ysignp468r9xszc&st=rpm2v5zj&dl=0\n\nこんにちは！カールスラントのウィッチOC、ヨハンナ・シュタインホフをお願いしたいです。彼女はヨハネス・シュタインホフがモデルで、ストライカーユニットはMe262です。", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/23", "thumbnail_src": "https://si.imgix.net/7c618e38/uploads/origins/a80673c0-6540-476c-8566-00523f5dc3a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7533507cbdc93874711a937abfe3138e", "thumbnail_srcset": "https://si.imgix.net/7c618e38/uploads/origins/a80673c0-6540-476c-8566-00523f5dc3a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7533507cbdc93874711a937abfe3138e, https://si.imgix.net/7c618e38/uploads/origins/a80673c0-6540-476c-8566-00523f5dc3a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=975f0c898982ae76506300336b774a19 2x, https://si.imgix.net/7c618e38/uploads/origins/a80673c0-6540-476c-8566-00523f5dc3a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b82b600a4710bdb48da142ab8f18369 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたからの素晴らしい作品をお願いします。\n特集をお願いします：三隅美弥＆迫水遥（from ブレイブ／ストライクウィッチーズ）。\n3つの作品を見てみたいです：\n1：美弥ちゃんが働いているところ；\n- 洗濯や料理など、何か作業をしている美也をお願いします、\n- ミヤはやや横向きに立ち、目の前には作業台がある、\n- ショー：正面から、膝から上、\n- 後ろから春香の「影」が近づいてくる。\n2: 春香が宮を驚かせる；\n- 春香は片手で宮の胸を（服の上から）触る、\n- 春香のもう片方の手は宮の腹の上に滑り込み、宮の服を少し持ち上げる、\n- 宮は唖然とする。\n3: 春香は立ち去る；\n- 春香は笑顔で、頭にこぶを作る、\n- 小さくなった）美哉は後ろで激怒している。\n遥はウィングコマンダーとして白いユニフォームを着てください。\n宮もいつもの青い服装でお願いします。\n背景やその他のポーズ、詳細はお任せします。(テキストはありません)\nありがとうございました！💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/22", "thumbnail_src": "https://si.imgix.net/ce57a612/uploads/origins/e1debe4a-a8c0-4ef8-ac2f-d1daead06615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5aee01f96b5d57a86bb043a01c7e1a", "thumbnail_srcset": "https://si.imgix.net/ce57a612/uploads/origins/e1debe4a-a8c0-4ef8-ac2f-d1daead06615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea5aee01f96b5d57a86bb043a01c7e1a, https://si.imgix.net/ce57a612/uploads/origins/e1debe4a-a8c0-4ef8-ac2f-d1daead06615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a5c2bd7e563ddaf82ce0f029b4234e2 2x, https://si.imgix.net/ce57a612/uploads/origins/e1debe4a-a8c0-4ef8-ac2f-d1daead06615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c34b0e5c6e4377a03724fa5a398e200 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは。あなたからの素晴らしい作品をぜひお願いします。\n特集をお願いします：刈淵ひかり（ブレイブウィッチーズ）です。\nクリスマスをテーマに、ちょっとセクシーな衣装を着て楽しそうにしているひかりが見たいです。\nポーズ、シチュエーション、アングル、背景、その他はお任せします。(テキストなし）。\n\n- もっとセクシーで露出度の高いバージョンもお願いします。\nありがとうございました！💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/21", "thumbnail_src": "https://si.imgix.net/610f2381/uploads/origins/e78af06a-8d8b-4d1b-a73f-2d36d6711e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93a59c34d3ec5ea942c954cb6ce07271", "thumbnail_srcset": "https://si.imgix.net/610f2381/uploads/origins/e78af06a-8d8b-4d1b-a73f-2d36d6711e20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93a59c34d3ec5ea942c954cb6ce07271, https://si.imgix.net/610f2381/uploads/origins/e78af06a-8d8b-4d1b-a73f-2d36d6711e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=371069406fd2c2d0429d651feeb765ab 2x, https://si.imgix.net/610f2381/uploads/origins/e78af06a-8d8b-4d1b-a73f-2d36d6711e20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ae2b169c76475819359f5fa5a3863c8 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは、素晴らしい作品をお願いします。\n特集をお願いします：刈淵孝美（ブレイブウィッチーズより）。\n熱を出して汗だくになりながら、ベッドで横になっている高見さんを見たいです。\nポーズ、アングル、服装、背景、その他はお任せします。(テキストなし）。\n(もしnsfwバージョンもやりたければ、デリケートな部分は見せずに、検閲の必要がないようにお願いします。)\nありがとうございました！💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/20", "thumbnail_src": "https://si.imgix.net/76b86e7f/uploads/origins/f5dfcb23-9993-45b4-9c8b-60abffaf6b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1557a37ecaea12101b32f6347e703a02", "thumbnail_srcset": "https://si.imgix.net/76b86e7f/uploads/origins/f5dfcb23-9993-45b4-9c8b-60abffaf6b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1557a37ecaea12101b32f6347e703a02, https://si.imgix.net/76b86e7f/uploads/origins/f5dfcb23-9993-45b4-9c8b-60abffaf6b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93475fedaae8bed426313af2758f4602 2x, https://si.imgix.net/76b86e7f/uploads/origins/f5dfcb23-9993-45b4-9c8b-60abffaf6b9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fc14170887bf15344d1d52038a96cc5 3x", "genre": "art", "nsfw": true, "body": "ブレイブウィッチーズの苅淵ひかりを主人公にした素敵な作品をお願いします。\nベッドシーツに包まれたひかりが、ベッドの横の床で困惑し、窮地に陥っているところを見たいと思います。\nポーズ、アングル、服装は自由です。\n(&Nsfwオン - もしあなたがもう少し'露出'したバージョンもやりたいなら？)\n本当にありがとうございました！💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/19", "thumbnail_src": "https://si.imgix.net/e0d3efb2/uploads/origins/87a24efc-4433-4bc3-8396-46f65c098f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47e1e08e292b74f7a02065c6ee5ffdd", "thumbnail_srcset": "https://si.imgix.net/e0d3efb2/uploads/origins/87a24efc-4433-4bc3-8396-46f65c098f22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47e1e08e292b74f7a02065c6ee5ffdd, https://si.imgix.net/e0d3efb2/uploads/origins/87a24efc-4433-4bc3-8396-46f65c098f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d04f923dc64a5c47d3e5bbb749f112f 2x, https://si.imgix.net/e0d3efb2/uploads/origins/87a24efc-4433-4bc3-8396-46f65c098f22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19864bb99c1e4a817de6839bddec0dbb 3x", "genre": "art", "nsfw": true, "body": "ニッカ・カタヤイネン（ブレイブウィッチーズ）を主人公にした素敵な作品をぜひお願いします。\nニッカには銭湯の浴衣を着てもらいたいのですが、小さすぎて胸の谷間が丸見えで（でも敏感な部分は見えない）、ニッカのパンティ（水色）を隠すには十分な長さと幅がないんです。\nニッカはちょっと恥ずかしいだろう。ポーズ、アングル、背景はあなたの裁量に任せる。\n(背景には菅野直枝が同じものを着ていて、しっくりくるかもしれません）。\n本当にありがとうございました！💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/18", "thumbnail_src": "https://si.imgix.net/e69f50c2/uploads/origins/50f7bbc9-ef45-4dd6-aafa-f2925a60bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ffe5f6daf81d10ec037599f51d0fab", "thumbnail_srcset": "https://si.imgix.net/e69f50c2/uploads/origins/50f7bbc9-ef45-4dd6-aafa-f2925a60bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ffe5f6daf81d10ec037599f51d0fab, https://si.imgix.net/e69f50c2/uploads/origins/50f7bbc9-ef45-4dd6-aafa-f2925a60bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b280ce99db61ff2bc2330e9d07f9518 2x, https://si.imgix.net/e69f50c2/uploads/origins/50f7bbc9-ef45-4dd6-aafa-f2925a60bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=511dd5b0202591d449d1f4c0a928fcb9 3x", "genre": "art", "nsfw": true, "body": "ブレイブウィッチーズのジョーゼット・ルマーレのアートワークが欲しいです。\nジョーゼットが前かがみになって、レストランの料理のガラス・ディスプレイに手と顔を押し付けて（ガラスは曇っていて、おそらく少しヨダレがついている）、耳と尻尾を出して、尻尾を振って興奮しているようなイメージでお願いします。\nジョーゼットの後ろから、白いパンティが丸見えになっているように見えるといいのですが。\nその他の詳細や背景については、あなたの判断にお任せします（テキストはありません）。\n本当にありがとうございました。💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/17", "thumbnail_src": "https://si.imgix.net/dca3ce8e/uploads/origins/008ddc59-ef4f-4c63-97e6-2d72db214aef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5f7df8078a7283145ea7371e911b14f", "thumbnail_srcset": "https://si.imgix.net/dca3ce8e/uploads/origins/008ddc59-ef4f-4c63-97e6-2d72db214aef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5f7df8078a7283145ea7371e911b14f, https://si.imgix.net/dca3ce8e/uploads/origins/008ddc59-ef4f-4c63-97e6-2d72db214aef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef7a6c262e7e38d4648c6467df541f9d 2x, https://si.imgix.net/dca3ce8e/uploads/origins/008ddc59-ef4f-4c63-97e6-2d72db214aef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fd880a157aad2f8a69379f78de4ea50 3x", "genre": "art", "nsfw": false, "body": "ブレイブウィッチーズ」の三澄美也をモチーフにした素敵な作品をお願いします。\n青いバニースーツのコスチュームを着て、腰に手を当て、困ったような顔をしている美弥ちゃんを希望します。\nどのようなアングル、ビュー、背景であっても、あなたの裁量にお任せします（テキストなし）。\n本当にありがとうございました。  💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/16", "thumbnail_src": "https://si.imgix.net/ffa6bc44/uploads/origins/ebc3fd6e-39e7-4d85-83da-d0ce6773188b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b770135c88698eb6a4cbc3cc569fa68d", "thumbnail_srcset": "https://si.imgix.net/ffa6bc44/uploads/origins/ebc3fd6e-39e7-4d85-83da-d0ce6773188b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b770135c88698eb6a4cbc3cc569fa68d, https://si.imgix.net/ffa6bc44/uploads/origins/ebc3fd6e-39e7-4d85-83da-d0ce6773188b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a73df256e499b97755e3f011a163d6be 2x, https://si.imgix.net/ffa6bc44/uploads/origins/ebc3fd6e-39e7-4d85-83da-d0ce6773188b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cf96f60ab2c3cebe905dc2a052acdbc 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは。穴吹智子と菅野直枝（ストライク～ブレイブウィッチーズ～）のアートワークが欲しいです。\nスカーフを交換したり、直江がちょっとスターになったりして、いつもの格好の智子と直江が見られるといいなと思います。\nどんなシチュエーション、ポーズ、背景でも、あなたの裁量にお任せします。\nありがとうございました。💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/15", "thumbnail_src": "https://si.imgix.net/b1fb17fc/uploads/origins/8d9c3bc8-f5c5-4e92-97c2-c10f281c1743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7454520410110dfea1f36333c273494", "thumbnail_srcset": "https://si.imgix.net/b1fb17fc/uploads/origins/8d9c3bc8-f5c5-4e92-97c2-c10f281c1743?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7454520410110dfea1f36333c273494, https://si.imgix.net/b1fb17fc/uploads/origins/8d9c3bc8-f5c5-4e92-97c2-c10f281c1743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=952b88bfa8619c17ff788b4ed8321c70 2x, https://si.imgix.net/b1fb17fc/uploads/origins/8d9c3bc8-f5c5-4e92-97c2-c10f281c1743?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=421f2eae03a8248f0aa9fc56483c2d55 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ペリーヌ・クロステルマンが救命胴衣を着て水に浮いているところを見たいです。その他はお任せします。ありがとうございました。\n\nhttps://skeb.jp/@msgtkurage/works/14", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/14", "thumbnail_src": "https://si.imgix.net/d54e5f3f/uploads/origins/93cc7c4b-bea5-46eb-8dac-1c4002d20851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bacf519f7b8e4d78d3749847aac20e1", "thumbnail_srcset": "https://si.imgix.net/d54e5f3f/uploads/origins/93cc7c4b-bea5-46eb-8dac-1c4002d20851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bacf519f7b8e4d78d3749847aac20e1, https://si.imgix.net/d54e5f3f/uploads/origins/93cc7c4b-bea5-46eb-8dac-1c4002d20851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=758c29831e826d41ace06a2353f6217b 2x, https://si.imgix.net/d54e5f3f/uploads/origins/93cc7c4b-bea5-46eb-8dac-1c4002d20851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c8d3210b2a7cac0aae6fac55d98bc5a 3x", "genre": "art", "nsfw": false, "body": "こんにちは。ペリーヌ・クロステルマンが水着を着て、参考写真のような膨張式ライフジャケットを着ているところを見たいです。ライフジャケットはきちんと留めてください。ポーズや表情はお任せします。ありがとうございました。\n\nhttps://imgur.com/a/JWRSEPl", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/13", "thumbnail_src": "https://si.imgix.net/ef522ae8/uploads/origins/37802a09-27db-4744-bf5a-dfb96c21412b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07edc1f26ceba95c5e9743c8eb601cb1", "thumbnail_srcset": "https://si.imgix.net/ef522ae8/uploads/origins/37802a09-27db-4744-bf5a-dfb96c21412b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07edc1f26ceba95c5e9743c8eb601cb1, https://si.imgix.net/ef522ae8/uploads/origins/37802a09-27db-4744-bf5a-dfb96c21412b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cf63bfc843489af5079923ee3ee478f 2x, https://si.imgix.net/ef522ae8/uploads/origins/37802a09-27db-4744-bf5a-dfb96c21412b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2292d35d7aad1cbe6ef74020c1688d30 3x", "genre": "art", "nsfw": false, "body": "オーロラ・ユーティライネン＆ザ・ブレイカーズを主人公にした素晴らしい作品を作っていただけないでしょうか。ニッカ・カタヤイネン、菅野直枝、ヴァルトルート・クルピンスキー、苅渕ひかり（以上、ブレイブウィッチーズ）です。\n雪原をとぼとぼ歩くオーロラをぜひご覧ください。\n- ニッカを肩に担いで。\n- もう片方の腕に直江を抱いて。\n- オーロラの腰にロープを巻いて、ヴァルトルートの入った小ぶりの箱に縛り付ける。\n- ひかりが座っている平らな木（箱の後ろに結ばれている）を牽引している。\nオーロラ：決意、ニッカ：悩む、直枝：イライラ、ワルトルート：眠る（意識不明）、ひかり：微笑む（なんとなく楽しんでいる）、みたいな感じでお願いしたいです。\n(横長の絵で、文字も無しで)お願いします。\nあまり複雑でないことを願っています。\n本当に本当にありがとうございました💕", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/12", "thumbnail_src": "https://si.imgix.net/e2b60969/uploads/origins/8c57f676-2b1f-4f3f-8911-17f265f8c9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=293bfb96350cbcc2614f71c8d50a6bec", "thumbnail_srcset": "https://si.imgix.net/e2b60969/uploads/origins/8c57f676-2b1f-4f3f-8911-17f265f8c9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=293bfb96350cbcc2614f71c8d50a6bec, https://si.imgix.net/e2b60969/uploads/origins/8c57f676-2b1f-4f3f-8911-17f265f8c9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04bf607025063a84b84fe97a8af05b31 2x, https://si.imgix.net/e2b60969/uploads/origins/8c57f676-2b1f-4f3f-8911-17f265f8c9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eb9a0cb259558912fd4c0b5d9713f72 3x", "genre": "art", "nsfw": true, "body": "前回は素敵な8月18日トリオありがとうございました。\n今回はうちの子ツカサちゃん（https://skeb.jp/@iemichi/works/7）をオリ魔女化したものと『ワールドウィッチーズ』の石田大尉のペア絵をお願いします。\nをお願いします。\nツカサちゃんの装備は他の方に描いていただいた（https://skeb.jp/@kurokamireito/works/1）・（資料「ayaka」参照）を元にしたストライカーユニットでお願いします。もしツカサちゃんに銃を持たせる場合はMG42をお願いします。\n石田大尉の装備や武装については全てお任せします。\n構図等も石田大尉を前にしたものであること以外はお任せします。作画の幅取りの為NSFWにしています。\n何卒ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/sh/z0630zir88ftc7a/AAC_DKTtT52GERIzFZW6Vvhxa?dl=0", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/11", "thumbnail_src": "https://si.imgix.net/9292c96f/uploads/origins/c0f4c969-2d6e-44ae-ac92-7234a958b16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=674c7e32036f15441f670fad349216ce", "thumbnail_srcset": "https://si.imgix.net/9292c96f/uploads/origins/c0f4c969-2d6e-44ae-ac92-7234a958b16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=674c7e32036f15441f670fad349216ce, https://si.imgix.net/9292c96f/uploads/origins/c0f4c969-2d6e-44ae-ac92-7234a958b16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e03417d29b8e0abff22428f7562252c 2x, https://si.imgix.net/9292c96f/uploads/origins/c0f4c969-2d6e-44ae-ac92-7234a958b16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a38723d7982f0fa1d483af4f99d3ceba 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@msgtkurage/works/10", "thumbnail_src": "https://si.imgix.net/25998fb8/uploads/origins/871d5fab-a143-4c6a-aa74-7152e07f30e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0391a8b99f4d0b27c62b39a4d412450", "thumbnail_srcset": "https://si.imgix.net/25998fb8/u