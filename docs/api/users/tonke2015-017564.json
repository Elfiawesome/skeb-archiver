71ce6e035ad 2x, https://si.imgix.net/d60d1877/uploads/origins/04d2a2a5-ef0b-45c3-a031-f8d1fdbc7a72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ab084ee4f5ed7ff73938456f1a64792 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tonke2015/works/12", "thumbnail_src": "https://si.imgix.net/44158c69/uploads/origins/b427770e-36a9-40f4-9316-2e2d8a90670d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d7577c56b7538ad84054839efbcbb10", "thumbnail_srcset": "https://si.imgix.net/44158c69/uploads/origins/b427770e-36a9-40f4-9316-2e2d8a90670d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d7577c56b7538ad84054839efbcbb10, https://si.imgix.net/44158c69/uploads/origins/b427770e-36a9-40f4-9316-2e2d8a90670d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f51a00272abb41152463a7d71b84d73d 2x, https://si.imgix.net/44158c69/uploads/origins/b427770e-36a9-40f4-9316-2e2d8a90670d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c1f4fe896fb809376c165cc441fb3ce 3x", "genre": "art", "nsfw": true, "body": "こんにちは！\n\n「異世界美少女受肉おじさんと」のルシウス（女性です）を真上からの主観視点で挿入してハメてる中出しバックセックスおなしゃっす！！！\n\nアニメ4・5話が確認しやすいと思います。\n\n先生に以前描いていただいた八十科むじなと全く同じ構図です。\n\n背景はシンプルにベッドの上で。\n\n服装は通常衣装でお願いいたします(細部は大体で構いません)\n差分で帽子の有り無しもお願いします！\n\n表情は恥ずかがりつつも満更でない感じで！セックスしつつこっち振り向いている感じです。\n\n服はきたまま、ズボンを下ろしてシていてる感じ。\n太ももに赤紫のカルバンクラインおぱんつを添えて下さい！！！！（pccsのb24のイメージです）\n\nおっぱいとお尻の肉感を強調して下さい！！\n\n画像サイズは縦3000ピクセル以上の大きな画像で、psd形式でお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@tonke2015/works/11", "thumbnail_src": "https://si.imgix.net/45d49d5e/uploads/origins/d6b38f89-2544-4a87-a44d-e1d02facc539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55bfca071174f24166dcaaed7a288e91", "thumbnail_srcset": "https://si.imgix.net/45d49d5e/uploads/origins/d6b38f89-2544-4a87-a44d-e1d02facc539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55bfca071174f24166dcaaed7a288e91, https://si.imgix.net/45d49d5e/uploads/origins/d6b38f89-2544-4a87-a44d-e1d02facc539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9a4d236e4c3a80c108070ee2190459e 2x, https://si.imgix.net/45d49d5e/uploads/origins/d6b38f89-2544-4a87-a44d-e1d02facc539?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93dcb2a61f6e94e4b1e00fc0666cbb77 3x", "genre": "art", "nsfw": true, "body": "いつも素敵なイラスト有難う御座います。\n\nからくりサーカスのファティマのイラストをリクエストさせて下さい。\n\n服装は、下記の左側の列のような、戦いの中の、上半身裸でターバンのみに指に懸糸傀儡操作の指輪装着が希望です。\nhttps://x.com/mokkoritintin/status/1515639329196240896\n\n他のご参考URLです。\nhttps://mac-design.work/comic/karakuri-ep11.html\n\nポーズは身体の前で胸を隠すように腕を交差させて戦ってるとか、或いはその状態を背中から見た感じとか希望です。\n上半身裸だけど乳首は見えない少年誌的な微エロさでお願いします。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@tonke2015/works/10", "thumbnail_src": "https://si.imgix.net/f575592e/uploads/origins/ca1e8962-d916-4b99-ac17-edcf78c4fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e792a39c75be0c1e089dbcaa8af927bf", "thumbnail_srcset": "https://si.imgix.net/f575592e/uploads/origins/ca1e8962-d916-4b99-ac17-edcf78c4fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e792a39c75be0c1e089dbcaa8af927bf, https://si.imgix.net/f575592e/uploads/origins/ca1e8962-d916-4b99-ac17-edcf78c4fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ee1e5955c9328f23b2d6afb0503deef 2x, https://si.imgix.net/f575592e/uploads/origins/ca1e8962-d916-4b99-ac17-edcf78c4fd41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8aed2a72b0b2caf1a243fc50c8839aef 3x", "genre": "art", "nsfw": false, "body": "初めてリクエストさせて頂きます。\n\n【キャラクター】\nあおぎり高校の春雨麗女、月赴ゐぶき\n\n【シチュエーション】\n夜の喫煙所で二人が並んで煙草を吸っているイメージ\n\n【構図】\nアニメ「ブラックラグーン」第7話のシガーキスのような構図にして頂けるとありがたいです。\n\nその他の設定等についてはお任せ致します。\n\n何卒、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@tonke2015/works/9", "thumbnail_src": "https://si.imgix.net/5693a123/uploads/origins/d1dd3e4f-fab8-495c-92a3-180dfca5633a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2021d8b9cfc320900ba7fd5dc9191130", "thumbnail_srcset": "https://si.imgix.net/5693a123/uploads/origins/d1dd3e4f-fab8-495c-92a3-180dfca5633a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2021d8b9cfc320900ba7fd5dc9191130, https://si.imgix.net/5693a123/uploads/origins/d1dd3e4f-fab8-495c-92a3-180dfca5633a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd26b0af5f5582e2522f6cfb72ec7804 2x, https://si.imgix.net/5693a123/uploads/origins/d1dd3e4f-fab8-495c-92a3-180dfca5633a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ad1be9eeb7cd5724e61a1c0e0f1884f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@tonke2015/works/8", "thumbnail_src": "https://si.imgix.net/2fb00443/uploads/origins/6f93d8db-d42a-466a-95d1-2b814f16c5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68c6cf28c8122c5f4e7e607d16958ebb", "thumbnail_srcset": "https://si.imgix.net/2fb00443/uploads/origins/6f93d8db-d42a-466a-95d1-2b814f16c5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68c6cf28c8122c5f4e7e607d16958ebb, https://si.imgix.net/2fb00443/uploads/origins/6f93d8db-d42a-466a-95d1-2b814f16c5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr