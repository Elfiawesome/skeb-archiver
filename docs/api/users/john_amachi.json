ar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab72aa853825d44ec3f45094c5ad9e09", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab72aa853825d44ec3f45094c5ad9e09, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=139431f11978a4c055f59235ccace8e6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44bcbeb42157a5fb8732c89bba3bc493 3x", "genre": "voice", "nsfw": false, "body": "麻雀ワールドに使うボイスサンプルとして、「ポン」「チー」「カン」「ツモ」「ロン」をとびっきり可愛く朗読してほしいです！できれば数パターンぐらいあると助かります\n\nワールドに使う以上、今後どこかの収益化された配信などに映りこむ可能性がありますのであしからず。もちろんワールドにボイス提供クレジットを書く予定です。", "created_at": "", "completed_at": ""}, {"path": "/@john_amachi/works/5", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab72aa853825d44ec3f45094c5ad9e09", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab72aa853825d44ec3f45094c5ad9e09, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=139431f11978a4c055f59235ccace8e6 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1529695702569611264%2FSqucMC54.jpg?bg=%23f