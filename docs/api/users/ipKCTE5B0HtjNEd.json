leted_at": ""}, {"path": "/@ipKCTE5B0HtjNEd/works/1", "thumbnail_src": "https://si.imgix.net/64dd819c/uploads/origins/215a2626-8871-40bf-abc3-754d606d5d63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2fd71a63e75f0138dfe7ec521f50efd", "thumbnail_srcset": "", "genre": "art", "nsfw": true, "body": "おまかせします", "created_at": "", "completed_at": ""}]}