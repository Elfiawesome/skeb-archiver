8-9419-83ab6a21782d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=105e8b953e927921299f6cddedfed2f1", "thumbnail_srcset": "https://si.imgix.net/2e089e39/uploads/origins/e77e16e4-3e75-4758-9419-83ab6a21782d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=105e8b953e927921299f6cddedfed2f1, https://si.imgix.net/2e089e39/uploads/origins/e77e16e4-3e75-4758-9419-83ab6a21782d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=276b32a11f1bfda9cc5dce1b3f3d32e5 2x, https://si.imgix.net/2e089e39/uploads/origins/e77e16e4-3e75-4758-9419-83ab6a21782d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a137033b0ff4f339cc5c1be42c2d516 3x", "genre": "comic", "nsfw": true, "body": "前回は素敵なイラストありがとうございました。\n今回もFate/Grand Orderのキャラで嘔吐しているイラストをお願いします。\nキャラクターはマシュとリリスの2人でお願いします。\nシュチュエーションはマスターに令呪などを使われて無理矢理マシュとリリスでディープキスさせられて、令呪などの強制的な力が無くなって2人がお互いに突き放すように離れる。その時にお互いの口から唾液が糸引くようになる。リリスは嫌悪感から汚い声だしながら盛大に嘔吐して床に大量の吐瀉物を撒き散らかす。マシュは口元を手でおさえながら嘔吐する。以上です。嘔吐しているところを一番大きくお願いします。その他細かいところはお任せします。どうかよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@L_S_D_/works/313", "thumbnail_src": "https://si.imgix.net/e7ea85eb/uploads/origins/cfea617b-a210-4c93-a8fa-919194cfcd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4986ec7e1045a008f83f41652c87e7ce", "thumbnail_srcset": "https://si.imgix.net/e7ea85eb/uploads/origins/cfea617b-a210-4c93-a8fa-919194cfcd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4986ec7e1045a008f83f41652c87e7ce, https://si.imgix.net/e7ea85eb/uploads/origins/cfea617b-a210-4c93-a8fa-919194cfcd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6c7408d9cef9b098f0b59f6a892bd66 2x, https://si.imgix.net/e7ea85eb/uploads/origins/cfea617b-a210-4c93-a8fa-919194cfcd4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b94b880cf8b73bc9ce85f5137cac056a 3x", "genre": "comic", "nsfw": true, "body": "竜胆尊の無様エロを描いて頂けないでしょうか\n\n以下はこういうのが好きという参考程度で大丈夫です\n\nお金に困って立ちんぼやデリヘル的な性商売やっててほしいです\n買ってもらうために必死で下品な誘い方や何人でもどんなプレイでもアリで客集めをしてほしいです\n「ちゃんとやんないと金払わねえぞ」的な事言われて要求された事はなんでも必死にひょっとこフェラしたりアナル舐めなどしてほしいです\n\n\n体はだらしない感じで胸はかなり巨乳や長乳　陰毛や腋毛はジョリジョリかボサボサだと嬉しいですがどちらでも大丈夫です\nエロ蹲踞、体に落書きされる、髪の毛がっつり引っ張られる、ヘッドロック首絞め、イラマチオ、ブスや豚、オナホ等の暴言、腹ボコや喉ボコ、殴打、チンカス掃除、タバコの灰皿にされる、開口機や全頭マスク鼻フック、子宮潰れるぅ的な描写等の尊厳破壊するような無様なことされるのが好きです\nエグいアへ顔、白目向きそうなイキ顔、食いしばって痛がる、ブサイク必死なフェラ顔、無様オホ声等の表情が崩れるのも大好きです\n\nNGないので無様でハードな内容だと嬉しいです\n\n欲望を書きなぐってしまいすみません\n上記は本当に参考程度なので無視でも問題ないです\n気に入らない場合全く関係なくても大丈夫ですのでおまかせで自由に描いて頂けるとありがたいです\nもし金額的に大丈夫なら数ページの漫画のような形で描いて頂けないでしょうか", "created_at": "", "completed_at": ""}, {"path": "/@L_S_D_/works/312", "thumbnail_src": "https://si.imgix.net/03b7a6f9/uploads/origins/a2f29848-263f-497d-9896-c87e4b553fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ef734571c54f65d954c6b3affe58ab", "thumbnail_srcset": "https://si.imgix.net/03b7a6f9/uploads/origins/a2f29848-263f-497d-9896-c87e4b553fea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68ef734571c54f65d954c6b3affe58ab, https://si.imgix.net/03b7a6f9/uploads/origins/a2f29848-263f-497d-9896-c87e4b553fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f66f3c19b44cf3f7430f5f0f0a322217 2x, https://si.imgix.net/03b7a6f9/uploads/origins/a2f29848-263f-497d-9896-c87e4b553fea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f56ad3a74b0d2966bc117b2da68febff 3x", "genre": "art", "nsfw": true, "body": "またまたこんにちは！以前、ティファと凛をお願いして大満足だったので、またお邪魔しました。このまま常連客になりそうです！\n\nティファ・ロックハートのR-18Gをお願いします。前回のリクエスト(https://skeb.jp/@L_S_D_/works/297)の続きです。\n\n彼女の死を見せしめにするために、彼女の死体は屈辱的な方法で公に展示されている。彼女の遺体は逆さまに吊るされ、足首はロープで縛られている。足首に巻かれたロープだけが彼女を支えている。まるで動物の死体のように吊るされている。非常に残酷で屈辱的な仕打ちだ。衣服と身体の状態は前作とほぼ同じ。彼女の腕、髪、露わになった乳房はすべて重力のために下方に垂れ下がっている。彼女の顔は恐怖と苦悩に満ちている。首の傷から血がゆっくりと顔を伝って垂れている。彼女の目は死んでいる。彼女の陰毛と乳房の周りに精液を追加して、前の絵の後にさらにレイプがあったことを暗示してください。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@L_S_D_/works/311", "thumbnail_src": "https://si.imgix.net/84901b7e/uploads/origins/1f8d7fc5-2d47-4161-930c-7a156496a694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a79f38bc3fdd3955329a018a1e5c8571", "thumbnail_srcset": "https://si.imgix.net/84901b7e/uploads/origins/1f8d7fc5-2d47-4161-930c-7a156496a694?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a79f38bc3fdd3955329a018a1e5c8571, https://si.imgix.net/84901b7e/uploads/origins/1f8d7fc5-2d47-4161-930c-7a156496a694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4307be48c36b238ed89aa082525540dd 2x, https://si.imgix.net/84901b7e/uploads/origins/1f8d7fc5-2d47-4161-930c-7a156496a694?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dae366955723a722eb2fccac1ed683c 3x", "genre": "comic", "nsfw": true, "body": "こんにちは！先生、あなたの描く女体、マジで最高すぎます！私のOCをぜひ描いてもらえませんか？\n\n彼女は貴族の家のお嬢様なんだけど、趣味で冒険者やってて、運動部みたいな健康的なムチムチボディ。頭はまぁまぁだけど、めっちゃ無鉄砲で自信過剰な性格で、しょっちゅうトラブル起こすタイプ。\nある日、異国の神秘宗教の禁域に勝手に踏み込んじゃって、捕まっちゃうの。最初は「私は悪くない！」とか強がって、「うち金持ちだから、解放してくれれば金ならいくらでも出すよ！」なんて言い訳しまくる。でも、現地の祭司が武器を彼女の腹（子宮）に突きつけて、「皮を剥がれて剥製にされるのと、孕袋になるのと、どっちかを選べよ。」って脅したら、速攻でビビって失禁しながら「足舐める！チンポ舐める！ケツの穴だって舐めるから、命だけは助けて！」って泣き叫ぶの。\nそしたら祭司が「じゃあ、お前がちゃんと振る舞えるかどうかだな、愚かな外国の雌豚。」とか言って、彼女は犯されて、ガンガン突かれてアヘ顔でイキまくる。\nしばらく経つと、彼女の体にはエロい痕がいっぱいついてる——例えば：ケツの平手打ちの赤い跡、下品な落書き、ドラッグや媚薬の注射針穴、そんな感じで、先生の好みでドスケベなディテール勝手に追加してくれてOK！\n彼女は何日も侵犯された後、意識が朦朧としてアヘ顔で涙を流しながらこう言った：「どう？ この鍛え上げられた肉体と、貴族出身の肉穴、めっちゃ気持ちいいよね！」 だが、部族の者たちは新しい女を捕まえ、彼女に「もうお前には飽きた」と言い放った。そして、「脳みそをかき混ぜる魔法」を使い、彼女の脳を壊した。彼女は白目を剥き、支離滅裂な言葉を口走り、人間が耐えられない脳内絶頂に達して狂ったように痙攣し、潮を吹き、表情は下品にアクメしている感じで、そして死んだ。最後は壁に埋め込まれ、魔法で鮮度を保たれ、部族が飼う家畜のための永遠の肉便器として利用された。\nこんな感じで、直球でドスケベな描写お願いします！好きなだけ激しくしてください！\n足先の反応が好きなので、兩足裏が見えていて、足の指が大きく反応していると助かります。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1KUD2iiM_uzxM_DekZuAHMKdqn9CphAsL?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@L_S_D_/works/310", "thumbnail_src": "https://si.imgix.net/8b1178c8/uploads/origins/fd80bd83-5daf-4ede-bd51-cf1e30cb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4eabf8d06bddac004cff789f0cc588", "thumbnail_srcset": "https://si.imgix.net/8b1178c8/uploads/origins/fd80bd83-5daf-4ede-bd51-cf1e30cb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b4eabf8d06bddac004cff789f0cc588, https://si.imgix.net/8b1178c8/uploads/origins/fd80bd83-5daf-4ede-bd51-cf1e30cb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=743cc994c8a9df718ba0c23a61fd9efb 2x, https://si.imgix.net/8b1178c8/uploads/origins/fd80bd83-5daf-4ede-bd51-cf1e30cb0a1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49b94a15ce1699b9b28418609aade5c7 3x", "genre": "comic", "nsfw": true, "body": "再びこんにちは。この漫画の続きです：\n\nhttps://skeb.jp/@L_S_D_/works/259\n\n船の上にいるナミとロビンの2ページ漫画。船の甲板で同じ体勢でくつろぎながら足を組む二人。ロビンは書斎に行くために立ち上がろうとするが、ナミはまだ横になっていたい。二人は互いに引っ張り合い、胴体と体をねじり、ねじり合う。", "created_at": "", "completed_at": ""}, {"path": "/@L_S_D_/works/309", "thumbnail_src": "https://si.imgix.net/16792208/uploads/origins/6964f931-2702-4579-add1-aa8b3a203bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fa2e4f49a07c7bc8003b717ae943d28", "thumbnail_srcset": "https://si.imgix.net/16792208/uploads/origins/6964f931-2702-4579-add1-aa8b3a203bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fa2e4f49a07c7bc8003b717ae943d28, https://si.imgix.net/16792208/uploads/origins/6964f931-2702-4579-add1-aa8b3a203bd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0219f038a0eca424621594d