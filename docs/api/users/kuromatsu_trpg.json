FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=15deab7581e4a399b3600260eaf8a8e7 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromatsu_trpg/works/165", "thumbnail_src": "https://si.imgix.net/8e9fef62/uploads/origins/97b9aca8-6456-40e7-8a1c-89c707d27697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebf24a5ad1d2c3ee2b2ad2ae86b2118e", "thumbnail_srcset": "https://si.imgix.net/8e9fef62/uploads/origins/97b9aca8-6456-40e7-8a1c-89c707d27697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebf24a5ad1d2c3ee2b2ad2ae86b2118e, https://si.imgix.net/8e9fef62/uploads/origins/97b9aca8-6456-40e7-8a1c-89c707d27697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a4d3627293e88610fc2229d32f252da 2x, https://si.imgix.net/8e9fef62/uploads/origins/97b9aca8-6456-40e7-8a1c-89c707d27697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95951c655ebc5f9cfc40cd939cc6a99d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kuromatsu_trpg/works/164", "thumbnail_src": "https://si.imgix.net/1177e5c0/uploads/origins/dc9cc098-a6ff-4aa3-aa2b-48d69898e6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f1ef285305665d25c48fdf5f58d9d05", "thumbnail_srcset": "https://si.imgix.net/1177e5c0/uploads/origins/dc9cc098-a6ff-4aa3-aa2b-48d69898e6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f1ef285305665d25c48fdf5f58d9d05, https://si.imgix.net/1177e5c0/uploads/origins/dc9cc098-a6ff-4aa3-aa2b-48d69898e6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf68f3ca4fb521d045e77b1d1d5e731d 2x, https://si.imgix.net/1177e5c0/uploads/origins/dc9cc098-a6ff-4aa3-aa2b-48d69898e6a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3f4436f2e5914bec74f62ebe42bdd2e 3x", "genre": "art", "nsfw": false, "body": "しろは様、はじめまして…！\n\n「四季送り」、たいへん楽しませていただいております。とても素敵なシナリオとキャラクター達を生み出してくださってありがとうございます！！本当に本当に大好きです…！！！\n\n今回は《四季送り》の《自PCのHO秋と、化野祝さん》の2人をぜひ描いていただきたいなと思い、リクエストさせていただきました。\n\n\n以下、自PCの簡単なご紹介となります。\n\n⸻\n\n◆ 秋羅（しゅうら）\n・26歳／男性／174cm\n明るくフレンドリーで、人当たりの良い青年です。\n接客時の愛嬌には定評がありますが、本人はややサボり癖のある不真面目気質。\nただし、化野祝に注意されると渋々ながらも素直に仕事に戻るような、根は従順で素直な性格をしています。\n誰とでも打ち解ける雰囲気を持ちながら、実際には他人と深く関わることを避けており、唯一心を許しているのが祝ただ一人です。\n秋羅にとって祝は依存の対象であり、何よりも大切な存在です。\n\n◆ 詳細\n資料リンクの方に、秋羅本人や化野祝さんとの関係性の設定をまとめた資料をご用意しております。イラストのご参考になりましたら幸いです。\n▶︎ https://drive.google.com/drive/folders/14mE6jWKicUIbimXrwaxRXIGnb-baaCbo\n\n⸻\n\n穏やかな日常のひとコマでも、少し感情がにじむような表情でも、しろは様の描く空気感に包まれた秋羅と祝をぜひ拝見してみたく、僭越ながら今回リクエストさせていただきました。\nお忙しいところ恐縮ですが、ご検討いただけましたら幸いです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14mE6jWKicUIbimXrwaxRXIGnb-baaCbo", "created_at": "", "completed_at": ""}, {"path": "/@kuromatsu_trpg/works/163", "thumbnail_src": "https://si.imgix.net/26d7ea9a/uploads/origins/f96d098f-fb0a-4903-b7f3-fd5ab0394ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f5981271f3476d78f607ea98829f54", "thumbnail_srcset": "https://si.imgix.net/26d7ea9a/uploads/origins/f96d098f-fb0a-4903-b7f3-fd5ab0394ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0f5981271f3476d78f607ea98829f54, https://si.imgix.net/26d7ea9a/uploads/origins/f96d098f-fb0a-4903-b7f3-fd5ab0394ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00f40bcc9504fda0ab14a36d97a79bbb 2x, https://si.imgix.net/26d7ea9a/uploads/origins/f96d098f-fb0a-4903-b7f3-fd5ab0394ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35421152712076d32a295fbab07cac14 3x", "genre": "art", "nsfw": false, "body": "しろは様\n\nはじめまして、\n数ヶ月前に「四季送り」でHO夏として遊ばせていただきました！\nとても楽しく本当に素敵な思い出になり、四季送りの事が大好きになりました。\nコラボのグッズも購入させて頂き、届くのがとても楽しみです！\n\n\n今回お願いしたいのは、四季送りNPCの神凪蠱毒と自探索者の夏の1枚絵です。\nずっとしろは様にskebをお願いしたく思っていたのと、この度ありがたいことに四季送りのKPをさせて頂けることになりまして、記念としてご依頼をさせて頂きたく存じます…!!\n\n構図は基本的にお任せしたいと思います。\nもし指定があった方が描きやすい場合、以下内容を参考にしていただければと思います。\n・部屋着姿の二人(黒スウェットの蠱毒)(花火もスウェット等ラフな格好)\n・ひまわり畑にいる2人\n・かき氷食べてる2人\n等…(本当に2人が並んでいれば何でも喜びます！！！)\n\n◾︎使用用途は鑑賞用です。(完全自分個人用)\n\n---\n○HO夏について\n「巨大花火」(どでかはなび)　/　24歳　男\nThe 苦労人  という感じ  自陣四季送りの中では最年長\n基本静かで明るくは無いが、なんだかんだ面倒をみてくれるお人好し 。\nあびの人たちに振り回されていそう\n自分から気楽に話しかけたりはしないけど、話しかけられれば気さくに会話してくれる。\n\n○関係性\n蠱毒にからかわれたり、いつも調子を狂わされてる。\n友人でありながら少し年の離れたお兄さんの様にも感じている。\n\nキャラシ等の資料をURLにて添付させて頂きます。\nお忙しいところ大変恐れ入りますが、ご検討頂けますと幸いです！\nよろしくお願いいたします。\n\nhttps://iachara.com/view/11074329\nhttps://drive.google.com/drive/folders/1pyjRBzW0saEHA0Usa_Fa_oRmHegxTNOO?usp=share_link\n\nhttps://iachara.com/view/11074329", "created_at": "", "completed_at": ""}, {"path": "/@kuromatsu_trpg/works/162", "thumbnail_src": "https://si.imgix.net/a1c9b608/uploads/origins/27bde7f6-df18-4938-87f2-5aca30764e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ca48da61fa5d70a76508bf9cc03c2ca", "thumbnail_srcset": "https://si.imgix.net/a1c9b608/uploads/origins/27bde7f6-df18-4938-87f2-5aca30764e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ca48da61fa5d70a76508bf9cc03c2ca, https://si.imgix.net/a1c9b608/uploads/origins/27bde7f6-df18-4938-87f2-5aca30764e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6009adc3c781a93664dae07b07b3e90 2x, https://si.imgix.net/a1c9b608/uploads/origins/27bde7f6-df18-4938-87f2-5aca30764e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9150774b01ca053904ccab7e2218e44f 3x", "genre": "art", "nsfw": false, "body": "はじめまして、みつをと申します。\n「四季送り」「遺香廻り」「人間失覚殺人癖」などたくさんシナリオを通過させていただき、いつも本当に心動かされる体験をさせていただいております。作者のしろは様にリクエストさせていただける機会ということで、メッセージを送らせていただきました。\n\nリクエスト内容についてですが、最近通過させていただいた「遺香廻り」NPCの伊澄なとりと、HO4の自探索者のイラストをお願いしたく思います。\n卓を通過している間、ジェットコースターのような息をつかせぬ展開を楽しませていただきつつ、とても心に残る体験をさせていただきました。\nなとりについて、HO4が立ち止まるような場面においても、とても助けられました。\n\n本編中は、自探索者のHO4となとりはよき友人で、遺香にぎりなどを差し入れしてもらいました。\nHO3のために、なとりに料理を教わりたいなと思っていたので、自探索者のHO4がなとりと料理を作っている場面など描いていただけましたら、とても嬉しいです…！\n\nとても素敵なシナリオを通らせていただきました…ありがとうございます！\n\n使用用途としては、個人観賞や、SNSでの投稿(作者様記載の上)予定です。\nまた、資料として、CSと立ち絵を添付させていただきます。\n\nhttps://x.com/mitsunanakatrpg/status/1942184727374594076?t=SajZ9kv84wCFWGkCwexSaw&s=19\n\nhttps://iachara.com/view/11974823\n\n\n不備がありましたら申し訳ございません。\nご検討いただけると幸いです…！\nこれからも、しろは様のシナリオを楽しみにしております。", "created_at": "", "completed_at": ""}, {"path": "/@kuromatsu_trpg/works/161", "thumbnail_src": "https://si.imgix.net/a78fc0f9/uploads/origins/f5ea84a5-2c85-4206-8ceb-da0a242d4e60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4df8c34979973c1889395279ad1df855", "thumbnail_srcset": "https://si.imgix.net/a78fc0f9/uploads/origins/f5ea84a5-2c85-4206-8ceb-da0a242d4e60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4df8c34979973c1889395279ad1df855, https://si.imgix.net/a78fc0f9/uploads/origins/f5ea84a5-2c85-4206-8ceb-da0a242d4e60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a79a0fc78b3b35ba1d22b7075d852555 2x, https://si.imgix.net/a78fc0f9/uploads/origins/f5ea84a5-2c85-4206-8ceb-da0a242d4e60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2241c167d878f28a7c93db5f6c7b9f2e 3x", "genre": "art", "