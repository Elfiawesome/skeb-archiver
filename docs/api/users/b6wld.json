します！！\n\nタイトルは適当に考えたので全然変えても問題ないですがエロガキと🌈ライバーたちみたいな感じで1.2枚目〇〇、3.4枚目□□···みたいな感じで1人だけではなく複数人お願いしたいです！！！\n\n他のライバー達も描くときに変えないでほしいのがお題箱にあるおっぱいが垂れたり黒くなっているところや贅肉がついてボテッとしてきているところ、グロマン、剛毛です！\n\n一気に複数人ではなく一人ずつでお願いします！複数人が同時だともったいなく感じてしまうので一人ずつでお願いします！！！\n\n自分が特にみたいライバーはドーラ様、ニュイなのでその2名は必ず描いて欲しいのですが他の人は大人,お姉さんライバーでお願いします！！\n\n沢山のライバーをお願いします！！！！\n\nhttps://www.pixiv.net/artworks/123610066#manga", "created_at": "", "completed_at": ""}, {"path": "/@b6wld/works/11", "thumbnail_src": "https://si.imgix.net/5e5d8b55/uploads/origins/418e00f7-60cb-464b-b631-e274af4e0405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=365129307b9ff7ac41c6045568766bd5", "thumbnail_srcset": "https://si.imgix.net/5e5d8b55/uploads/origins/418e00f7-60cb-464b-b631-e274af4e0405?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=365129307b9ff7ac41c6045568766bd5, https://si.imgix.net/5e5d8b55/uploads/origins/418e00f7-60cb-464b-b631-e274af4e0405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=419359a3ccfd743619cd1d0283b466aa 2x, https://si.imgix.net/5e5d8b55/uploads/origins/418e00f7-60cb-464b-b631-e274af4e0405?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19857e623ace20ad823171170033206f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@b6wld/works/10", "thumbnail_src": "https://si.imgix.net/eb2a6529/uploads/origins/2ffc76cf-557a-427f-9e26-dd8dab8acb64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a9a60581ad470a157558d58f86022e6", "thumbnail_srcset": "https://si