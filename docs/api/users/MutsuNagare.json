ることに戸惑っている感じの言葉にして、中出し直前か中出しの差分でガイトに中出しをせがむ言葉を吐かせ、最後にガイトに愛され続ける以外の選択肢がなくなったことを嘆く心の声で締めくくる感じにしてください。\n（ガイトのセックス自体は受け入れるほどに弱っている所に自分からうっかり言ってしまった言葉でとどめを刺され敗北を受け入れる感じの流れです）\nいろいろ考えたのですが、ここで貴方に頼もうと思った内容なのでぜひご検討ください。\n難しいようでしたら容赦なく断って戴いても結構です。", "created_at": "", "completed_at": ""}, {"path": "/@MutsuNagare/works/65", "thumbnail_src": "https://si.imgix.net/1ec4d260/uploads/origins/7cc96fcc-9c67-460c-b3bb-d12832690020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=187d8f452dc7ba28a0f8ccd8dd7dcdb0", "thumbnail_srcset": "https://si.imgix.net/1ec4d260/uploads/origins/7cc96fcc-9c67-460c-b3bb-d12832690020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=187d8f452dc7ba28a0f8ccd8dd7dcdb0, https://si.imgix.net/1ec4d260/uploads/origins/7cc96fcc-9c67-460c-b3bb-d12832690020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=075dbb2d760432c360316c838e41e5fa 2x, https://si.imgix.net/1ec4d260/uploads/origins/7cc96fcc-9c67-460c-b3bb-d12832690020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c07d175583ff0c706d7bf91b1586560 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@MutsuNagare/works/64", "thumbnail_src": "https://si.imgix.net/f007d4d2/uploads/origins/8e11738e-925f-44f8-a8e7-7985efe38098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7745ea925df26489e2d4e720f47a56f7", "thumbnail_srcset": "https://si.imgix.net/f007d4d2/uploads/origins/8e11738e