, https://si.imgix.net/947390fd/uploads/origins/5d4dd4c3-518b-475c-b4aa-d4f8da91d4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9f1dd99201696884e2f9c296ea4ef19 2x, https://si.imgix.net/947390fd/uploads/origins/5d4dd4c3-518b-475c-b4aa-d4f8da91d4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=837f21e25c9826c010f66be200d28c47 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@nagatsukitei/works/10", "thumbnail_src": "https://si.imgix.net/b61e0c5a/uploads/origins/24aca3d1-396b-494a-8ee6-beef35dd9de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77793f6b01a0ba82d382138765465ef0", "thumbnail_srcset": "https://si.imgix.net/b61e0c5a/uploads/origins/24aca3d1-396b-494a-8ee6-beef35dd9de7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77793f6b01a0ba82d382138765465ef0, https://si.imgix.net/b61e0c5a/uploads/origins/24aca3d1-396b-494a-8ee6-beef35dd9de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=872efd6d00c0380caae8628c6a8fc4c1 2x, https://si.imgix.net/b61e0c5a/uploads/origins/24aca3d1-396b-494a-8ee6-beef35dd9de7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23adf77ed86af01464c56f790b4433ef 3x", "genre": "art", "nsfw": true, "body": "お誕生日おめでとうございます。長月さんの好みのオリジナルな女の子を描いてください！", "created_at": "", "completed_at": ""}, {"path": "/@nagatsukitei/works/9", "thumbnail_src": "https://si.imgix.net/426b29c1/uploads/origins/c545e58b-7e02-4b33-a41e-d4ca2c156eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6593b50cb1de1aa969b464572bf930fa", "thumbnail_srcset": "https://si.imgix.net/426b29c1/uploads/origins/c545e58b-7e02-4b33-a41e-d4ca2c156eb8?bg=%23