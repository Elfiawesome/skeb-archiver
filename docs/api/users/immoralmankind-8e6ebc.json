-92f2-bf7bc3bebd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4093778568e4f58456d5907ef87e092 2x, https://si.imgix.net/59df6baa/uploads/origins/05bc1830-9d96-461f-92f2-bf7bc3bebd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46802ea513ed4afe1835665e8379e989 3x", "genre": "art", "nsfw": true, "body": "最近のアニシャドから、ヒナとアンドレアに敗北して犯されるレンとツバサをお願いします。\n\n・ヒナがレン、アンドレアがツバサを責める。\n・感じながらも説得、説得する余裕もない、イク  といった感じのセリフ\n・レンとツバサを見上げるような構図で責める\n・レンとツバサは服が破損して胸が見えており、スカートをたくし上げさせられ、レンはスパッツとパンツが膝下まで下げられており、ツバサは片脚パンツの状態\n・ヒナは水音が激しくなるような責め、アンドレアはねっとりと犯す\n\nよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/45", "thumbnail_src": "https://si.imgix.net/924dbb31/uploads/origins/d01942c7-c6c1-4155-a872-c58f8f5771bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fa6de0d46d401f8efb58662febee593", "thumbnail_srcset": "https://si.imgix.net/924dbb31/uploads/origins/d01942c7-c6c1-4155-a872-c58f8f5771bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fa6de0d46d401f8efb58662febee593, https://si.imgix.net/924dbb31/uploads/origins/d01942c7-c6c1-4155-a872-c58f8f5771bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2145896401973747a8356b6051680317 2x, https://si.imgix.net/924dbb31/uploads/origins/d01942c7-c6c1-4155-a872-c58f8f5771bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1638947cd356d76d1193ffb30351645a 3x", "genre": "art", "nsfw": true, "body": "ゴルギアス様いつも素敵な絵をありがとうございます。リクエストですが粛清の英雄・メイシアのエッチなイラストをお願いします。FANBOXにあった潮流の砲手フェラ絵がエロ過ぎたのでメイシアでのイラストが欲しいです。（パイズリは無しでノーハンドでも可）フェラですがバキュームでも歯磨きでも大丈夫です。服は着たままで（脱がしてもOK)進化前の眼鏡を付けている状態での姿でお願いします。ご検討のほどよろしくお願いします。\n\nhttps://svgdb.me/leaders/3908\n\nhttps://shadowverse-portal.com/card/111831030?lang=ja\n\nhttps://t.co/ZP8SkBJvu3", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/44", "thumbnail_src": "https://si.imgix.net/1df95bc0/uploads/origins/c5163786-57a0-478e-8851-2b5029fab43f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62c1492a4d05d81f7818f5983f6978b7", "thumbnail_srcset": "https://si.imgix.net/1df95bc0/uploads/origins/c5163786-57a0-478e-8851-2b5029fab43f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62c1492a4d05d81f7818f5983f6978b7, https://si.imgix.net/1df95bc0/uploads/origins/c5163786-57a0-478e-8851-2b5029fab43f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72e40dab9c8ccdb6524ff7d16811b9d9 2x, https://si.imgix.net/1df95bc0/uploads/origins/c5163786-57a0-478e-8851-2b5029fab43f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=874542f175f47ef9c310f4ab8d733c3b 3x", "genre": "art", "nsfw": true, "body": "グランブルーファンタジーのメーテラとコルワが、水着半脱ぎで、はだけて露出した生乳を揉みしだきながら貝合わせで責め合うレズバトル。\n相手を先にイかせようと勝負をしているように、汗だくになって必死な表情で睨み合い、泣きながら潮吹き同時絶頂する表情差分をお願いします。\n\nキャラ・衣装参考（二人とも素足・羽織っているケープは無し、ややこしい装飾は省略して構いません）\nhttps://gbf-wiki.com/attach2/696D67_333034303334373030305F30315F66756C6C2E706E67.png\nhttps://www.pixiv.net/artworks/91856315\nhttps://www.pixiv.net/artworks/98225460\nhttps://gbf-wiki.com/index.php?%A5%E1%A1%BC%A5%C6%A5%E9%20%28SSR%29%BF%E5%C3%E5%A5%D0%A1%BC%A5%B8%A5%E7%A5%F3\n\nhttps://gbf-wiki.com/attach2/696D67_333034303132373030305F30315F66756C6C2E706E67.png\nhttps://www.pixiv.net/artworks/83574036\nhttps://gbf-wiki.com/index.php?%A5%B3%A5%EB%A5%EF%20%28SSR%29%BF%E5%C3%E5%A5%D0%A1%BC%A5%B8%A5%E7%A5%F3\n\n体位参考\nhttps://www.pixiv.net/artworks/74692986", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/43", "thumbnail_src": "https://si.imgix.net/e960e1c8/uploads/origins/4c005ea2-f60c-47b7-96ee-05baa23da67f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e629310f17aab2340749abcc3722a84a", "thumbnail_srcset": "https://si.imgix.net/e960e1c8/uploads/origins/4c005ea2-f60c-47b7-96ee-05baa23da67f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e629310f17aab2340749abcc3722a84a, https://si.imgix.net/e960e1c8/uploads/origins/4c005ea2-f60c-47b7-96ee-05baa23da67f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf4bb0c2db25a373fded0e3514204d68 2x, https://si.imgix.net/e960e1c8/uploads/origins/4c005ea2-f60c-47b7-96ee-05baa23da67f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa0e0735d49731dce74662e34d02ab08 3x", "genre": "comic", "nsfw": true, "body": "こんにちは、前回の依頼から続けての依頼です。\nhttps://skeb.jp/@immoralmankind/works/27\n\nシナリオ\n雷鳥の世界ランキングは最下位に沈んでおり、7位以内からも遠ざかっていた。\n\nヴァネッサとビビアンは、事態を悪化させてしまったことをマルグリットに謝る。\n\nマルグリットは、雷斗に7位以内に入ってもらいたいと、レオンの後を継いでジェネシス社のCEOになったときに見つけた「シャドウバースF（uck）」という秘密のアプリを雷斗に渡す。\n\nこのアプリを使えば、ユーザーは猫目シティの誰とでもセックスすることができ、通常よりも多くのワールドランキングポイントを獲得することができる。\n\n仕方なく、雷斗はジュベールの姉とコンビを組み、ポイントを得るためにセックスを探すミッションを開始する！\n\nセリフは日本語でOK。\n\n価格変更歓迎。\n\nご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/42", "thumbnail_src": "https://si.imgix.net/94008c3b/uploads/origins/8d5efcf7-289e-41f7-b0b0-69a2b7f10cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d585961fe3267cf74c9726d66d1cbfa5", "thumbnail_srcset": "https://si.imgix.net/94008c3b/uploads/origins/8d5efcf7-289e-41f7-b0b0-69a2b7f10cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d585961fe3267cf74c9726d66d1cbfa5, https://si.imgix.net/94008c3b/uploads/origins/8d5efcf7-289e-41f7-b0b0-69a2b7f10cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e19ab795b27c1b18f723c0818fc4d1a 2x, https://si.imgix.net/94008c3b/uploads/origins/8d5efcf7-289e-41f7-b0b0-69a2b7f10cb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de1a2a3d0e7dbbc0b64c750aa8d9fcb4 3x", "genre": "art", "nsfw": true, "body": "初めまして。新着を眺めていたら好みのシチュエーションで描かれている漫画を見たので、リクエストしに来ました。\nオリジナルが可能であれば、TRPGで使っていたキャラのイラストをお願いします。\n下記のような感じでお願いします。\n\n【シチュエーション】\nhttps://skeb.jp/@immoralmankind/works/33\nhttps://skeb.jp/@immoralmankind/works/23\nこちらのような過去のリクエストで描かれている全裸徘徊物と同じ様なものをお願いします。\n冒険者であるうちのキャラが男に敗北して捕まり、調教されている感じで。\n\n【容姿など補足】\n・名前はセネカ･アエテルニタス。19歳の白髪赤眼の獣人（猫族）の冒険者です。左のサイドテールです。\n・一人称は「わたくし」。ですがお嬢様言葉ではなく敬語で喋るな清楚なキャラです。\n・尻尾はありません。アナル尻尾とかを付けるのが好きなので…\n・ファンタジー世界観です。\n\n【キャライメージ/喋りそうなセリフ一例】\n・非エロ\n「わたくしはセネカ・アエテルニタスと申します。以後お見知りおきを」\n「わたくしが前に出ます。援護を！」\n「ふふっ。ありがとうございます。嬉しいです」\n・エロ\n「お願いです…もうやめて下さい…」\n「い、いやですっ…おちんぽを押し付けないで下さい…っ」\n\n\n\nお手数ですが、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1xByZi4IcWGuvka0Hd63uCwgt-_QRDeg7?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/41", "thumbnail_src": "https://si.imgix.net/90359292/uploads/origins/bf14068c-ada1-463f-8596-ebd990d0d006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed8cf1be470ec9c51a6d9f2d5caf58c0", "thumbnail_srcset": "https://si.imgix.net/90359292/uploads/origins/bf14068c-ada1-463f-8596-ebd990d0d006?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed8cf1be470ec9c51a6d9f2d5caf58c0, https://si.imgix.net/90359292/uploads/origins/bf14068c-ada1-463f-8596-ebd990d0d006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8141a061441a2663cb5bd04795d9f389 2x, https://si.imgix.net/90359292/uploads/origins/bf14068c-ada1-463f-8596-ebd990d0d006?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d8ed3969b5c3e66c438ce1c576a742d 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/40", "thumbnail_src": "https://si.imgix.net/5122a13b/uploads/origins/8244fa90-7908-4ebf-a9c3-10395497dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da1d45e8c6be9089bacec11a5680779d", "thumbnail_srcset": "https://si.imgix.net/5122a13b/uploads/origins/8244fa90-7908-4ebf-a9c3-10395497dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da1d45e8c6be9089bacec11a5680779d, https://si.imgix.net/5122a13b/uploads/origins/8244fa90-7908-4ebf-a9c3-10395497dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5fc2bcee502a5c244774018d06507106 2x, https://si.imgix.net/5122a13b/uploads/origins/8244fa90-7908-4ebf-a9c3-10395497dd3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1531d6fc71e57d9f3234b21b5c94a85 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/39", "thumbnail_src": "https://si.imgix.net/9d53011d/uploads/origins/c5475d53-fc65-4e3d-a9ba-6adfb7dd4f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a509db7e332adc93122b808d8d52be6", "thumbnail_srcset": "https://si.imgix.net/9d53011d/uploads/origins/c5475d53-fc65-4e3d-a9ba-6adfb7dd4f20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a509db7e332adc93122b808d8d52be6, https://si.imgix.net/9d53011d/uploads/origins/c5475d53-fc65-4e3d-a9ba-6adfb7dd4f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9f2902935525842446277f4986722a1 2x, https://si.imgix.net/9d53011d/uploads/origins/c5475d53-fc65-4e3d-a9ba-6adfb7dd4f20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d104e48df25551ed09e11f9b39de4a17 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/38", "thumbnail_src": "https://si.imgix.net/1491a24b/uploads/origins/7935a38d-f112-49a5-aa85-5199aec86a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e774ffd0f48e93a672d4e7e549fe00", "thumbnail_srcset": "https://si.imgix.net/1491a24b/uploads/origins/7935a38d-f112-49a5-aa85-5199aec86a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e774ffd0f48e93a672d4e7e549fe00, https://si.imgix.net/1491a24b/uploads/origins/7935a38d-f112-49a5-aa85-5199aec86a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=292cd6a81d83de875fb0cac8c8197d18 2x, https://si.imgix.net/1491a24b/uploads/origins/7935a38d-f112-49a5-aa85-5199aec86a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7ecdfc8940f7869b791351b2cd14a99 3x", "genre": "art", "nsfw": true, "body": "ケリドウェンのイラストをリクエストさせていただきます。\nhttps://twitter.com/shadowverse_jp/status/1706264784839029162\n\n・シチュエーション：実験に用いる精液の採取→セックス\n・シーン、セリフ等：自由\n\n可能であれば未統合のPSDをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/37", "thumbnail_src": "https://si.imgix.net/3ab37b65/uploads/origins/34911594-e61e-41f1-ab51-516c1b5f616d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7986498d6ab49ffb7b73c42ee07790f", "thumbnail_srcset": "https://si.imgix.net/3ab37b65/uploads/origins/34911594-e61e-41f1-ab51-516c1b5f616d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7986498d6ab49ffb7b73c42ee07790f, https://si.imgix.net/3ab37b65/uploads/origins/34911594-e61e-41f1-ab51-516c1b5f616d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b173f885bde61b8983cc1004bded6b50 2x, https://si.imgix.net/3ab37b65/uploads/origins/34911594-e61e-41f1-ab51-516c1b5f616d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e542b101deae5d6951ebadb18954c93c 3x", "genre": "art", "nsfw": true, "body": "初めまして、いつもお世話になっております\nさて自分事ではありますが、最近アンリミランクマで狂乱ヴァンパイアをよく使用するのですがその時かなりの頻度で煉獄のダークナイトを素引して爆散する試合が多く、彼女に色々募らせているんです。\nですのでどうか煉獄のダークナイトさんを描いて頂けないでしょうか。\n形式等全てお任せしますが「お前何回手札に来るんだ」みたいな節のセリフ入れてくるととても助かります\n是非、お願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/36", "thumbnail_src": "https://si.imgix.net/5124f0ff/uploads/origins/703f476c-0930-4dc7-876e-fba5dbcf07a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9060e050ce793449f23ab579eaf59e54", "thumbnail_srcset": "https://si.imgix.net/5124f0ff/uploads/origins/703f476c-0930-4dc7-876e-fba5dbcf07a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9060e050ce793449f23ab579eaf59e54, https://si.imgix.net/5124f0ff/uploads/origins/703f476c-0930-4dc7-876e-fba5dbcf07a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf2f981743e90bf7a9409eff812fcb1d 2x, https://si.imgix.net/5124f0ff/uploads/origins/703f476c-0930-4dc7-876e-fba5dbcf07a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c58d00d9c2e8581d7a821d1d445cbd4 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/35", "thumbnail_src": "https://si.imgix.net/f2d79f40/uploads/origins/47f6ad7d-0ae9-47ef-bc4a-f81a6373359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4803bd7ee6aae130458f158d53d7644", "thumbnail_srcset": "https://si.imgix.net/f2d79f40/uploads/origins/47f6ad7d-0ae9-47ef-bc4a-f81a6373359d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4803bd7ee6aae130458f158d53d7644, https://si.imgix.net/f2d79f40/uploads/origins/47f6ad7d-0ae9-47ef-bc4a-f81a6373359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fff2f7624cec32d7c13e7bcdeffc46e 2x, https://si.imgix.net/f2d79f40/uploads/origins/47f6ad7d-0ae9-47ef-bc4a-f81a6373359d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e28a6a371128e34324174d1c03e2d96 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nいつも素敵な作品を拝見させていただいております。\nキャラはシャドウバースより「ホーリープリースト・ロレーナ」を希望します。\n以前投稿されているhttps://skeb.jp/@immoralmankind/works/25のような漫画形式でのシュチエーションが希望です。\nプレイ内容等はお任せします。\n以上検討の程、よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/34", "thumbnail_src": "https://si.imgix.net/39fd6a4c/uploads/origins/df4f12da-8fb7-412f-9550-33276ec8cd80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=661e27808149c2af22fe4d33b8547e06", "thumbnail_srcset": "https://si.imgix.net/39fd6a4c/uploads/origins/df4f12da-8fb7-412f-9550-33276ec8cd80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=661e27808149c2af22fe4d33b8547e06, https://si.imgix.net/39fd6a4c/uploads/origins/df4f12da-8fb7-412f-9550-33276ec8cd80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0313b1ee5ee5119efa6d3586fd41083 2x, https://si.imgix.net/39fd6a4c/uploads/origins/df4f12da-8fb7-412f-9550-33276ec8cd80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12842be666a0857bb4269a80f67ac94a 3x", "genre": "art", "nsfw": true, "body": "前回ララミアとリーシェナのイラストありがとうございました。\n今回なのですが、ララミアと同じように、ガルミーユに敗北して犯されるフィルレイン というシチュです。（目の前でララミアがイカされた後）\nガルミーユにクンニされ、抵抗▶困惑▶我慢▶絶頂▶余韻の流れでお願いします。場面ごとにセリフもお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/33", "thumbnail_src": "https://si.imgix.net/bb30af39/uploads/origins/3080edbc-ffbf-471e-ab95-15f1041e89ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=772403d18cd3248d08e85813f44a89e5", "thumbnail_srcset": "https://si.imgix.net/bb30af39/uploads/origins/3080edbc-ffbf-471e-ab95-15f1041e89ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=772403d18cd3248d08e85813f44a89e5, https://si.imgix.net/bb30af39/uploads/origins/3080edbc-ffbf-471e-ab95-15f1041e89ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79e02e0b31d8c7d760d46b13956f5a5a 2x, https://si.imgix.net/bb30af39/uploads/origins/3080edbc-ffbf-471e-ab95-15f1041e89ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12033087618c8f8f7feb6803357b0ce1 3x", "genre": "art", "nsfw": true, "body": "初めまして、よろしければナハト・ナハトの漫画をお願いできますか？\n以前描かれていた『ナハトナハト変態マゾ調教』が印象に残り、後日談のようなものを見たいと思いました。\nシチュエーションと流れは以下の通りです。\n\n・シチュエーション\n日中はタイタンとして威厳を示す彼女。一方で夜はマゾ雌犬になり、竿役と共に全裸でレヴィールの街を散歩する\n\n・流れ\n１：犬のように全裸・首輪付き・四つん這いで街中を散歩\n２：散歩をするうちに発情。ちんちんのポーズ(犬)で交尾のおねだり\n３：竿役のいたずらでアナルに挿入。不意打ちを食らったナハトは軽く絶頂\n４：気を取り直して普通の交尾、膣内射精。夜が明け始め、余韻に浸る間もなく拠点に戻る\n\n交尾の体位など、細部はお任せします。\nお忙しいかと思いますが、ご検討いただけると幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/32", "thumbnail_src": "https://si.imgix.net/d6858c5c/uploads/origins/293bc8a1-7781-4bdf-9804-c3df19bde6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b10621cf2b04bae7b5ed10480bc90be1", "thumbnail_srcset": "https://si.imgix.net/d6858c5c/uploads/origins/293bc8a1-7781-4bdf-9804-c3df19bde6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b10621cf2b04bae7b5ed10480bc90be1, https://si.imgix.net/d6858c5c/uploads/origins/293bc8a1-7781-4bdf-9804-c3df19bde6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=316c971cc9c3c44606b0dd512804b22b 2x, https://si.imgix.net/d6858c5c/uploads/origins/293bc8a1-7781-4bdf-9804-c3df19bde6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b70cb7e393ce6ec0c8911e23c809b49b 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっています。早速ですがモノクロ漫画でフローゼスでフォロワーとえっちなことができるようになったシリーズをおねがいします。雰囲気はケルベロスやローラちゃんのような感じで大丈夫です。細かい点はお任せしますが下着姿のコマを1、2コマ入れて下さい。それと年齢いじり等は絶対に入れないで下さい。よろしければご検討よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@immoralmankind/works/31", "thumbnail_src": "https://si.imgix.net/5087cf1e/uploads/origins/c601063b-6b55-4715-993d-19516717eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a56fedac0da1ccd79caff9d114a07f6", "thumbnail_srcset": "https://si.imgix.net/5087cf1e/uploads/origins/c601063b-6b55-4715-993d-19516717eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a56fedac0da1ccd79caff9d114a07f6, https://si.imgix.net/5087cf1e/uploads/origins/c601063b-6b55-4715-993d-19516717eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58ac52dd10304edf0ac39e539ff89d77 2x, https://si.imgix.net/5087cf1e/uploads/origins/c601063b-6b55-4715-993d-19516717eeba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c68d1f643f99996e610dff97d79ee92 3x", "genre": "art", "nsfw": false, "body":