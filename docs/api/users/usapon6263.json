-a8b6-6dcbdae7cda7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77b43ab82376406d5b1f70896c6599ea 2x, https://si.imgix.net/9b1822ea/uploads/origins/d1edc544-d357-4a86-a8b6-6dcbdae7cda7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d6ff903fca30b4b6b2686275bea51e53 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/28", "thumbnail_src": "https://si.imgix.net/ef19191b/uploads/origins/8906ad65-f309-42fe-bfd8-53061fef1e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75df1abeda34c57d428dbd42d2fde5d7", "thumbnail_srcset": "https://si.imgix.net/ef19191b/uploads/origins/8906ad65-f309-42fe-bfd8-53061fef1e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75df1abeda34c57d428dbd42d2fde5d7, https://si.imgix.net/ef19191b/uploads/origins/8906ad65-f309-42fe-bfd8-53061fef1e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6856fcfef11fc2f4032690081c56d822 2x, https://si.imgix.net/ef19191b/uploads/origins/8906ad65-f309-42fe-bfd8-53061fef1e5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c2bf128106f2294a9c937d18d0b3c64 3x", "genre": "comic", "nsfw": true, "body": "キャラクター　鏡音リン　鏡音レン\nで年齢変化もの（年齢ドレインとでも言うのでしょうか）をおねがいします\n二人の年齢は１４歳の同い年からスタート。\n（公式のリンちゃんは貧乳ですが胸だけはいわゆるロリ巨乳な感じで、他は公式通りでおねがいします）\nリンちゃんがパイズリで射精させ\nリン１４歳ーレン１４歳→リン１６歳－レン１２歳→リン１８歳ーレン１０歳→リン２０歳－レン８歳くらいでストップ\n体格差は最後のパイズリの体格差的に二倍程度になるかんじ。リンちゃんのおっぱいは成長とともに徐々に大きく。レン君のちんちんはそこそこの大きさのまま\n\nセリフ（わかりやすいように年齢わけておきます）\nリン１４歳－レン１４歳\n「おっぱいでレンを気持ちよくしてあげるね」\nと無理矢理パイズリで射精させる\n射精後、リンちゃんのおっぱいが大きくなりリンちゃんが大きく、自分が小さくなっていることに気づく\nレン「リンが大きくなってる？」\nリン「違うよ、両方！レンが射精したぶんだけちっさくなってその分あたしが大きくなってるの」みたいなセリフ\n\nリン１６歳－レン１２歳　リン１８歳－レン１０歳\nこの時点でリンちゃんは爆乳。\n二人の全身が見える感じの膝上パイズリで１６歳－１２歳時にはパイズリで亀頭が見えている状態の大量射精。顔にかかる。\n同じ体勢のままで１８歳ー１０歳時にはおっぱいに完全にちんちんが埋もれている。しかし勢いはそのままに谷間から噴き出す射精で顔射。リン「こんな深い谷間から顔にかけられるんだね」みたいなセリフ\n\nリン２０－レン８（ここで年齢ドレインはストップ）\nhttps://skeb.jp/@akaneyasun/works/31\nの最後のページのような体勢でパイズリキス。\n体はちっちゃくなったのにちんちんは大きいままみたいなセリフ\nレン君が我慢できず大量射精\n\nといったかんじでリンレン共に指定のセリフを良い感じに変えて、それ以外にも軽くセリフつきでおねがいします。\n\n射精のあとに幼くなっていく感じで\n最終的な体格差が前回のおねショタリンレンくらいになる感じです、がレン君は最終的にはもっと幼い感じでおねがいします\n\nよろしくおねがいします", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/27", "thumbnail_src": "https://si.imgix.net/bc0069d5/uploads/origins/29fd2bd9-33cb-4301-90b4-18be2e7f5921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3a6639fde17a32c4814e9796dd974d5", "thumbnail_srcset": "https://si.imgix.net/bc0069d5/uploads/origins/29fd2bd9-33cb-4301-90b4-18be2e7f5921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3a6639fde17a32c4814e9796dd974d5, https://si.imgix.net/bc0069d5/uploads/origins/29fd2bd9-33cb-4301-90b4-18be2e7f5921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=649c5e9e330e384d4ed4845f8f08600e 2x, https://si.imgix.net/bc0069d5/uploads/origins/29fd2bd9-33cb-4301-90b4-18be2e7f5921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=644b8523a727a94171f172cd5361c98f 3x", "genre": "art", "nsfw": false, "body": "私はクリネックスです〜 任せたい内容は私のオリジナルキャラクターです アクションや背景の指定はありません 自由に遊んでいただけます！", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/26", "thumbnail_src": "https://si.imgix.net/982d50e9/uploads/origins/b20b12f6-c7d7-4f4b-a8c5-b6f1bc751d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef80bd41fd492a9b2a01e6aaa2d086d1", "thumbnail_srcset": "https://si.imgix.net/982d50e9/uploads/origins/b20b12f6-c7d7-4f4b-a8c5-b6f1bc751d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef80bd41fd492a9b2a01e6aaa2d086d1, https://si.imgix.net/982d50e9/uploads/origins/b20b12f6-c7d7-4f4b-a8c5-b6f1bc751d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9863ae9cf4a8899d1c8f6fa75e6311bd 2x, https://si.imgix.net/982d50e9/uploads/origins/b20b12f6-c7d7-4f4b-a8c5-b6f1bc751d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85aa6daccf65eede9de4d889e6ae9717 3x", "genre": "art", "nsfw": false, "body": "いつもお世話になっております。\nせっかくですので私も夏らしく金屋あざみさんの水着姿をリクエストさせてもよろしいでしょうか？\n水着とかポーズは先生のお好きなやつでOKです！\n何卒、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/25", "thumbnail_src": "https://si.imgix.net/fc783532/uploads/origins/b5d07768-4607-41d7-a36d-d2840d5d2116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854f29f15cea51f9de7da8866b058109", "thumbnail_srcset": "https://si.imgix.net/fc783532/uploads/origins/b5d07768-4607-41d7-a36d-d2840d5d2116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=854f29f15cea51f9de7da8866b058109, https://si.imgix.net/fc783532/uploads/origins/b5d07768-4607-41d7-a36d-d2840d5d2116?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91e0266a7f2a7e4bc08f512299d9c528 2x, https://si.imgix.net/fc783532/uploads/origins/b5d07768-4607-41d7-a36d-d2840d5d2116?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72b1085db41eadffeaead0dbc7b2a259 3x", "genre": "art", "nsfw": true, "body": "はじめまして、リクエストよろしいでしょうか？\n昔（概ね1980～2000年代あたりの）のバスケユニフォーム姿の\n（丈がふともも付け根あたりまでの際どい短パン）\n短パンスポーツ少女をお願いします\n見た目は十代半ばくらいのJK、黒目、髪型は黒髪ツーサイドアップ\n胸のサイズは普通よりやや大きめで美乳な一方\n尻からふとももにかけては健康的ながらも肉感的でむっちむちの太めで\nバスケユニフォームは以下の画像を参考にしてください\n上（タンクトップ）\nhttps://jp.mercari.com/item/m39831153953\n下（短パン）\nhttps://aucview.com/yahoo/t1064410796\nhttps://aucfree.com/items/o146722875\n画像のユニフォームは上下とも紺が基調で\n太い赤のラインと細い白のラインによる配色パターンとなってますが\n紺と赤のところを逆転させ（白いラインのところはそのままで）\n赤を基調とし、太い紺のラインと細い白のラインに変更してください\n下の短パンも同様にお願いします\nタンクトップは襟ぐりと袖まわりがゆったりとして\n腋からちょっと見えそうなほどのゆるゆるな隙間だらけでお願いします\nまた画像から背番号やチーム名等を消去し\n何もプリントされてないシンプルなデザインに変更してください\n短パンについては画像を御覧の通り\n丈がふともも付け根あたりまでの丈が際どい短さのショートパンツです\n短パンのアディダスのロゴは\n（色を赤から紺に変換させる以外）別に残しておいても構いません\n短パンの中にタンクトップの裾をしっかりと入れてる状態でお願いします\n着装参考例\nhttps://aucfree.com/items/e310120754\n着用時ちょうどタンクトップと短パンのサイドラインが繋がるイメージで\nまたブルマではなく\nあくまでも短パンなので裾まわりに余裕がある感じでお願いします\n※イメージ画像\nhttps://skeb.jp/@avasakaru_party/works/101\nhttps://skeb.jp/@KVoHMZ8Zs972itj/works/20\n腋のところが大きく空いてゆるゆるなタンクトップや\n短パンの丈の際どいところを意識しつつ\n腋とふとももを強調するよう肉感的な感じのスポーティながらセクシーで\nいろいろ見えそうで見えない感じの立ち絵でお願いします", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/24", "thumbnail_src": "https://si.imgix.net/d6d37240/uploads/origins/37b02ddf-f831-44d2-9ff6-d66e95569078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49f62519eb2cafdd232a48a0b0517252", "thumbnail_srcset": "https://si.imgix.net/d6d37240/uploads/origins/37b02ddf-f831-44d2-9ff6-d66e95569078?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49f62519eb2cafdd232a48a0b0517252, https://si.imgix.net/d6d37240/uploads/origins/37b02ddf-f831-44d2-9ff6-d66e95569078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c27b4fa5c960213ec864f6cd4f2a30e7 2x, https://si.imgix.net/d6d37240/uploads/origins/37b02ddf-f831-44d2-9ff6-d66e95569078?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=118725c0d5374732cc7c6f2cb9e9b010 3x", "genre": "art", "nsfw": true, "body": "こんにちは、うさぽんちゃん。お元気ですか？私のOCのひとみちゃんをまた描いてほしいです。今回のリクエストは、牛ずきん姿で、下は何もつけず、お酒を飲みながらゲームをしているところです。\n\n方向性は自由なので、好きな方向でお願いします！\n\nhttps://drive.google.com/drive/u/3/folders/1qVlKU58mFzsm4mWk8H20W1scD4SXbxkW", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/23", "thumbnail_src": "https://si.imgix.net/afc523e0/uploads/origins/217502af-87ea-48a9-b218-fde2c3da231c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4468469dbf776a9012c8619c494351dc", "thumbnail_srcset": "https://si.imgix.net/afc523e0/uploads/origins/217502af-87ea-48a9-b218-fde2c3da231c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4468469dbf776a9012c8619c494351dc, https://si.imgix.net/afc523e0/uploads/origins/217502af-87ea-48a9-b218-fde2c3da231c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd5891b6e0a70ff00c85d2de6d8a53db 2x, https://si.imgix.net/afc523e0/uploads/origins/217502af-87ea-48a9-b218-fde2c3da231c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2de5f396c7802139382ad26e686e4f7 3x", "genre": "art", "nsfw": true, "body": "こんにちは、うさぽんちゃん！お元気でお過ごしでしょうか！この度、私のOCであるひとみちゃんのドローイングをお願いしたいと思います。仰向けのポーズで、見る人の方を向いて、むっちりした太ももを広げてアソコを広げている官能的なポーズをお願いしたいです。乳房から母乳が分泌され、滴り落ちながら、恥ずかしそうに微笑んでいる。\n\n乳首はさらに勃起し、恥ずかしそうに目を閉じた表情で激しく母乳を射精しながら潮吹き射精をしている。\n\nひとみの詳細\nショートカット姫\n右下唇にビューティーマーク\n\nその他の詳細服装のオプション（スクールガール、メイドフリルビキニ、ガーターベルト付きウエディングドレスなど）があります。\n\n参考ポーズ: https://drive.google.com/drive/folders/19uMOKrzM97Jbgl6M4WstQUj43ZIEgBiS?usp=sharing\n\nhttps://drive.google.com/drive/u/3/folders/14I2OLZg8X_AM09_00oMRLjwMoyGldVtm", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/22", "thumbnail_src": "https://si.imgix.net/764f9a93/uploads/origins/449ec9b8-c7cf-4ccc-b08f-198e005ffb20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bc2a7906ee2b8a9454a4f1d09d498a1", "thumbnail_srcset": "https://si.imgix.net/764f9a93/uploads/origins/449ec9b8-c7cf-4ccc-b08f-198e005ffb20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bc2a7906ee2b8a9454a4f1d09d498a1, https://si.imgix.net/764f9a93/uploads/origins/449ec9b8-c7cf-4ccc-b08f-198e005ffb20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4925c2dbf7eebe62d518e27f482a215 2x, https://si.imgix.net/764f9a93/uploads/origins/449ec9b8-c7cf-4ccc-b08f-198e005ffb20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c083f5ca759954f4d5f639a378100b3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/21", "thumbnail_src": "https://si.imgix.net/79872f9e/uploads/origins/3b68f393-6493-45e2-a32e-eb23a0c6247b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=347fc3c3da6a7e6db8f30525f9a8a0d4", "thumbnail_srcset": "https://si.imgix.net/79872f9e/uploads/origins/3b68f393-6493-45e2-a32e-eb23a0c6247b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=347fc3c3da6a7e6db8f30525f9a8a0d4, https://si.imgix.net/79872f9e/uploads/origins/3b68f393-6493-45e2-a32e-eb23a0c6247b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abf3bc3028ca35c5d43ea157b63ab90f 2x, https://si.imgix.net/79872f9e/uploads/origins/3b68f393-6493-45e2-a32e-eb23a0c6247b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34bd6ec3eafd25b2cbd2c09800b5f74d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@usapon6263/works/20", "thumbnail_src": "https://si.imgix.net/01d64e96/uploads/origins/7db9ef25-55d4-46e8-9ca7-f89e5a885861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11486d77c511610d3d877e6948dd8083", "thumbnail_srcset": "https://si.imgix.net/01d64e96/uploads/origins/7d