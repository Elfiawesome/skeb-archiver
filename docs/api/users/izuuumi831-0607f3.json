0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2acdd176b1922aa576145136a74f4980 2x, https://si.imgix.net/8df5ec8c/uploads/origins/85ba7c3f-2bf1-4722-b708-0eee5d0c9da0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80d49011aa581d78bd2af2060a397065 3x", "genre": "art", "nsfw": false, "body": "Hello, I've always loved your adorable drawings of Bae. I would like to commission you to draw Bae playing Nintendo Switch with IRyS, with Bae sitting in IRyS' lap. Thank you.\n\nこんにちは、いつもいずみさんが描くBaeの可愛いイラストが大好きです。BaeとIRyS一緒にSWITCHを遊んでいる様子を描いていただきたいです。BaeはIRySの膝の上に座っている姿でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@izuuumi831/works/30", "thumbnail_src": "https://si.imgix.net/c487c00a/uploads/origins/bc724500-c147-4f33-b0ff-2a7e8eb75f82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13eb7e9377559f11d0c03f99f5564864", "thumbnail_srcset": "https://si.imgix.net/c487c00a/uploads/origins/bc724500-c147-4f33-b0ff-2a7e8eb75f82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13eb7e9377559f11d0c03f99f5564864, https://si.imgix.net/c487c00a/uploads/origins/bc724500-c147-4f33-b0ff-2a7e8eb75f82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be7dfb4a5531c496b85c5976fec0914e 2x, https://si.imgix.net/c487c00a/uploads/origins/bc724500-c147-4f33-b0ff-2a7e8eb75f82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e35d33cb23a4d483bf4059d44dfdebcc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@izuuumi831/works/29", "thumbnail_src": "https://si.imgix.net/7e5e1a3e/uploads/origins/f0efcc08-b857-4b71-8dcd-59174660ee45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c284ddc4f8416c4a57eebbf20ebc8ad", "thumbnail_srcset": "https://si.imgix.net/7e5e1a3e/uploads/origins/f0efcc08-b857-4b71-8dcd-59174660ee45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c284ddc4f8416c4a57eebbf20ebc8ad, https://si.imgix.net/7e5e1a3e/uploads/origins/f0efcc08-b857-4b71-8dcd-59174660ee45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f6a20c137c37a8df8c04b3bd4db1424 2x, https://si.imgix.net/7e5e1a3e/uploads/origins/f0efcc08-b857-4b71-8dcd-59174660ee45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcf528b4bc7c3218cbdf09d4d16cde3a 3x", "genre": "art", "nsfw": false, "body": "あなたのスタイルと色使いが好きです。友人の誕生日プレゼントに、キャラクターを描いていただきたいと思います。\n最初のキャラクターはエコー自身、もう一人は彼女のオリジナルキャラクターであるソーダです。\nエコーは膝の上で寝ているソーダと一緒に座り、ソーダの頭を撫でているようなイメージでお願いします。エコーは普段着でも私服でもOK、ソーダも同様です。背景はもっとシンプルでもいいのですが、日没の時間帯ということで違和感のないものにします。\n\nエコー参考資料： https://echogummi.carrd.co/#sectionref\nソーダ 参考：https://twitter.com/EchoGummi/status/1652159750719565825\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@izuuumi831/works/28", "thumbnail_src": "https://si.imgix.net/03d97ded/uploads/origins/74697141-3805-4309-9882-59312bd8ad13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ab44235cc12bd1cb0ab9dc66a1ad607", "thumbnail_srcset": "https://si.imgix.net/03d97ded/uploads/origins/74697141-3805-4309-9882-59312bd8ad13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ab44235cc12bd1cb0ab9dc66a1ad607, https://si.imgix.net/03d97ded/uploads/origins/74697141-3805-4309-9882-59312bd8ad13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e33f1860a11d9992dd74d58c359635b 2x, https://si.imgix.net/03d97ded/uploads/origins/74697141-3805-4309-9882-59312bd8ad13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49723421300859222e0f9cc20dc5981d 3x", "genre": "art", "nsfw": false, "body": "最近、あなたのアートを見つけ、とても気に入りました\n\n私のVtuberのモデルを描いていただけたら嬉しいです!眠たそうで魅力的なキツネ神です。参考資料のように腹ばいになってほしいです。雲の中にいるようなイメージで、背景は夢幻的な感じだと完璧です。また、参考資料にもある小さなキツネを飼っています。その小さなキツネも近くで寝ていてほしいです。\n\n16:9の比率でお願いします。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1Sno_txEc7I29IfgCQBMH4BEJMdoRspln?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@izuuumi831/works/27", "thumbnail_src": "https://si.imgix.net/8d6b7c03/uploads/origins/6682ecc4-0626-4543-8003-01ca5c22fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05a2289c8b5c5f4479b74053ac0b636", "thumbnail_srcset": "https://si.imgix.net/8d6b7c03/uploads/origins/6682ecc4-0626-4543-8003-01ca5c22fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05a2289c8b5c5f4479b74053ac0b636, https://si.imgix.net/8d6b7c03/uploads/origins/6682ecc4-0626-4543-8003-01ca5c22fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d734cbcdbb451856ff5e55a3174ba1a8 2x, https://si.imgix.net/8d6b7c03/uploads/origins/6682ecc4-0626-4543-8003-01ca5c22fd20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=776599d9494706ec977e9f65f1879f1e 3x", "genre": "art", "nsfw": false, "body": "かわいい2ピースのアウトドアカフェの雰囲気いつものサイズ、私の友人はまだ服のデザインを持っていないので、あなたがそれでオキなら私たちのためにかわいいドレスを作る<3>。\n\nhttps://cdn.discordapp.com/attachments/1057160790546853918/1069156835334041720/image.png これは彼女です <3\n\nセットアップはこのような感じです。\n\nhttps://www.pixiv.net/en/artworks/98602845\nhttps://cdn.discordapp.com/attachments/1057160790546853918/1069140701318746162/F260A4E4-955C-42AB-B9BD-B1A58F55EED6.jpg", "created_at": "", "completed_at": ""}, {"path": "/@izuuumi831/works/26", "thumbnail_src": "https://si.imgix.net/b7f8f9fc/uploads/origins/63ec1018-0b5f-4435-a1a1-4096ab8450cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=