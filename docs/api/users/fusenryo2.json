」と一緒にポーズをとっている姿を描いてください。\nお好きなように描いていただいて構いませんが、ポケモンバトル中はコートを身に着けていません。自由に動けるよう、コートを脱ぎ捨てている状態でお願いします。ご検討いただきありがとうございます！\n\nhttps://drive.google.com/file/d/1cbT8Zi0WhLQMvRj17MhaO7DULYUzznRn/view?usp=sharinghttps://archives.bulbagarden.net/media/upload/4/44/0398Staraptor-Mega.png", "created_at": "", "completed_at": ""}, {"path": "/@fusenryo2/works/1352", "thumbnail_src": "https://si.imgix.net/0339b43c/uploads/origins/dfc5669b-bc7c-43cc-80cc-aae22a0bda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01f7ffe07fc6fca3dfd8c5875e1a36a", "thumbnail_srcset": "https://si.imgix.net/0339b43c/uploads/origins/dfc5669b-bc7c-43cc-80cc-aae22a0bda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f01f7ffe07fc6fca3dfd8c5875e1a36a, https://si.imgix.net/0339b43c/uploads/origins/dfc5669b-bc7c-43cc-80cc-aae22a0bda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcb7115a2e2505beba0156cdb04dbc26 2x, https://si.imgix.net/0339b43c/uploads/origins/dfc5669b-bc7c-43cc-80cc-aae22a0bda0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73d11cc28cda916625e129b2f36656ef 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fusenryo2/works/1351", "thumbnail_src": "https://si.imgix.net/01ddaa0c/uploads/origins/dd959777-6eef-45e6-a070-34e01f49e071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd854b9cbbea2ccd012953ceba5f34b2", "thumbnail_srcset": "https://si.img