d12-9f3c-16b63ce9edd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4268cf5e965b954cdc83e65cd21c4ed5, https://si.imgix.net/8b915ca1/uploads/origins/86f6eb24-9740-4d12-9f3c-16b63ce9edd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bb59b14445503feb923118b005ca409 2x, https://si.imgix.net/8b915ca1/uploads/origins/86f6eb24-9740-4d12-9f3c-16b63ce9edd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62e4b7bc21fb8bfd5d4d0389a0449813 3x", "genre": "art", "nsfw": false, "body": "こんにちは、ふせんりょ様！ずっと前から依頼したかったで、ついに何をリクエストするか決めました！ポケモンよりセキさんと自分のOCの夢絵をお願いしたいです。\n\n✦キャラ✦\nOCは明るく、元気いっぱいで、いたずら好きで、無謀でよく微笑む若い女性です。\nOCの身長は160cm、セキさんは約175cmです。\nお互いを深く信頼し、尊敬し合う献身的な恋人です。\n\nhttps://drive.google.com/drive/folders/1gjsMS9nWFQicfA0qV0DJZJKCDBW_xgu3\n\n✦内容✦\n「ポケモンマスターズEX」でのバレンタインデーデートがテーマです。バレンタインデーを一緒に過ごした後、二人はキスをする。OCはセキさんから贈られた花束を腕に抱かれたままです。夢心地でロマンチックな雰囲気でお願いします。\n\n可能なら、トレーナー達の幸せを喜んでいるニンフィア達も見えると嬉しいです！\n\n✦注意して欲しい詳細✦\n-OCの耳飾り、傷跡、ほくろ。\n- セキさんの耳飾り、目尻の化粧\n\n✦背景について✦\n背景はパシオの街です、夜が落ちる頃、星空の下で（「背景/background」というフォルダを参照）。背景が焦点である必要はなく、詳細である必要もありません。ただただ場所が認識できれば幸いです！\n\n価格が足りない場合は、お気軽にリクエストを再送信してくださいね。\nお忙しい中、ご検討いただきありがとうございます！そして、ハッピーバレンタインデー！", "created_at": "", "completed_at": ""}, {"path": "/@fusenryo2/works/1343", "thumbnail_src": "https://si.imgix.net/4432bee6/uploads/origins/0bf915f1-77a0-4a9d-926a-b8b6aa07f7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6619fc2452f6821bcba3c6bdcdf0ea47", "thumbnail_srcset": "https://si.imgix.net/4432bee6/uploads/origins/0bf915f1-77a0-4a9d-926a-b8b6aa07f7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6619fc2452f6821bcba3c6bdcdf0ea47, https://si.imgix.net/4432bee6/uploads/origins/0bf915f1-77a0-4a9d-926a-b8b6aa07f7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0da12fac6b72908a442dcd9acfc960f5 2x, https://si.imgix.net/4432bee6/uploads/origins/0bf915f1-77a0-4a9d-926a-b8b6aa07f7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bfb095e65616e62db5f508da43857e4 3x", "genre": "art", "nsfw": false, "body": "またまたこんにちは！お元気でいらっしゃいますか？こんなに早くまたお邪魔してご迷惑でなければ幸いです。あなたの作品、本当に素晴らしいです！私のオリジナルキャラ「タッド」と『ポケモン』の「アカギ」のイラストをもう一枚お願いしたいです。この二人は強いプラトニックな絆で結ばれています。\n\nアカギの身長は190cm、タッドは165cmです。シーンとしては、タッドとサイラスがハクタイシティのポケモン像を訪れている場面を希望します。二人が像を一緒に眺めている中、アカギがタッドをほほえみながら見つめる様子を描いてください。太陽が明るく輝き、アカギとタッドを照らし出しています。ご検討いただき、誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/15HVQU9q6OFNZ6q1S0FczmkDWVJOsN8zH", "created_at": "", "completed_at": ""}, {"path": "/@fusenryo2/works/1342", "thumbnail_src": "https://si.imgix.net/be9ce6b9/uploads/origins/90af9b95-9cd4-402e-ae34-595315e23e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45dd88b54c7c267d3f87876c6225225e", "thumbnail_srcset": "https://si.imgix.net/be9ce6b9/uploads/origins/90af9b95-9cd4-402e-ae34-595315e23e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45dd88b54c7c267d3f87876c6225225e, https://si.imgix.net/be9ce6b9/uploads/origins/90af9b95-9cd4-402e-ae34-595315e23e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d30e0cb2ed7c77b5c3628e6f5891cd5 2x, https://si.imgix.net/be9ce6b9/uploads/origins/90af9b95-9cd4-402e-ae34-595315e23e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eaa61cb529b0cf2531bb21f23b8ef92 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@fusenryo2/works/1341", "thumbnail_src": "https://si.imgix.net/ef31e258/uploads/origins/53bc0fb4-4