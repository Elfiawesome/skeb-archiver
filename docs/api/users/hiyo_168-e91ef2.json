af-36a30eb00a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db242170055e10423e08d25b963896bd", "thumbnail_srcset": "https://si.imgix.net/ec19904c/uploads/origins/9bfd7b5b-d9b1-4861-82af-36a30eb00a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db242170055e10423e08d25b963896bd, https://si.imgix.net/ec19904c/uploads/origins/9bfd7b5b-d9b1-4861-82af-36a30eb00a88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ead26af3b0b72a2def0202e4816f5377 2x, https://si.imgix.net/ec19904c/uploads/origins/9bfd7b5b-d9b1-4861-82af-36a30eb00a88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a86b86544cb2cc17a634de68f4fe16ca 3x", "genre": "art", "nsfw": false, "body": "私はあなたの作品がとても好きです！\n\n私のVtuberのキャラクターの絵をお願いしたいです。彼女は絵を描くのが好きなスタンダードプードルをベースにしています。\n\nもうすぐ誕生日（7/7）なので、できれば誕生日をテーマにした絵をお願いしたいです。キャラクターがわかるものであれば、服装・髪型は自由にアレンジしてください。\n\nまた、動画のサムネイルとして使用するため、背景が透明なものがあれば嬉しいです（クレジットを入れてください）。\n\nこの度はご依頼をご検討いただき、誠にありがとうございました！\n\nhttps://twitter.com/lizdrawsen/status/1630485371556380677?s=61&t=e-0MfscEPajQjJf3CHHxrw", "created_at": "", "completed_at": ""}, {"path": "/@hiyo_168/works/20", "thumbnail_src": "https://si.imgix.net/531ee9c6/uploads/origins/f4e99326-68c6-4e97-8c7b-f4ea786496af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3ca6c8d5f5ef7e2bfed2f2bc4fa6bb0", "thumbnail_srcset": "https://si.imgix.net/531ee9c6/uploads/origins/f4e99326-68c6-4e97-8c7b-f4ea786496af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3ca6c8d5f5ef7e2bfed2f2bc4fa6bb0, https://si.imgix.net/531ee9c6/uploads/origins/f4e99326-68c6-4e97-8c7b-f4ea786496af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d8b86edcc16c79000bd85f67b79198f 2x, https://si.imgix.net/531ee9c6/uploads/origins/f4e99326-68c6-4e97-8c7b-f4ea786496af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd0d1d739c83e4c3910672bfd