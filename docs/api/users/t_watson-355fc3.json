76d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "はじめましてこんにちは！\nmusmusさんのbgmが好きで配信や動画等で使わせていただいてもらっています。\nいつもお世話になっております！\n\n私のVtuberキャラのテーマを作っていただきたくメッセージを送りました。\n\nモンスターハンターXXの世界観のベースのキャラクターで\n集会酒場という酒場がテーマの集会所に通っているハンターです。\n\nキャラのデザインです\nhttps://photos.google.com/share/AF1QipOPnDWImQpkqGUQ-6YrQf83nJbcf-rxy0yQDiB85DalGe2Tk6OXFzJue414ZMBxxA?key=R0tQV1Z3V0QtOF9UZ1VmZFZEWkVSUE9nS1AwYTl3\n\nキャラの性格や世界観の設定の動画です\nhttps://youtu.be/LQm7kAcuTdY\n\n音楽のことはよくわからないので、設定から音楽を作っていただくことは可能でしょうか？\n配信のバックで流したいと思っています！\n\nよろしくお願いいたします。\nメッセージ失礼しました。", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/19", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "私の友人のキャラクター、ローデスのBGMを作曲してください！よろしくお願いします。\n\nローデスは、魅力的な弁護士でありながら、多くの秘密を隠し持っている。\n\nと思っていたのですが、これと同じようなものが手に入るんですね！？\nhttps://skeb.jp/@t_watson/works/10\nhttps://skeb.jp/@t_watson/works/8\nhttps://www.youtube.com/watch?v=kXEeyajJvwY\nできればミステリアスな雰囲気の構成にしたいです。また、音楽はバーにいるようなメロウでゆったりとしたものにしたいです。自由に作曲してください！キャラクターの雰囲気をつかむためのビジュアルリファレンスも添付しています～～。\n\n金額が不足していたり、要求が不適切な場合は、拒否してください。\n\nhttps://sta.sh/09gbaf0kxw0/", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/18", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "こんにちは。つい最近、あなたの作品を発見し、とても気に入っています。お願いがありまして、失礼します。\nVTuberのキャラクターのBGMをお願いしたいです。ストリームのBGMになるので、繊細で聴き心地の良い曲で、語尾が綺麗でループバージョンもお願いしたいです。\nキャラクターは、怠け者でお調子者の植物の女の子です。かつて彼女の頭に魂を持った魔導虫が降り立ち、彼女を憑依させた。過去には、身体の支配権をめぐって争ったこともある。現在は統合され、ひとつの身体で共存している。\nBGMは、静かな森の中のような、柔らかく響くピアノと木管楽器、そしてできれば私の好きな楽器であるマリンバでお願いしたいです。テンポはゆっくりで、時折、過去の葛藤を思わせるようなスピードアップがありますが、必ずゆっくりしたテンポに戻されます。\nこの曲は、ただ自分のペースで人生を歩み、リラックスを求めている2人の魂を描いています。\nありがとうございました。", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/17", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "MusMusさん、またまたお久しぶりです。\n\n今回は前回と同じライトモチーフ（https://skeb.jp/@t_watson/works/10）で、私が作る予定のアニメーションに合わせたスローテンポのピアノ曲をお願いします。このプロジェクトは完全に個人的なものであり、このプロジェクトに携わった全員がSNS上でクレジットを表示します。\n\nこのシナリオでは、私のマスコットは本当の自分（鏡の中の自分）を受け入れることを学び、現実の世界に戻るために「自分」と無意識の夢の世界に別れを告げようとしています。感動的なクライマックスのサビで、心の琴線に触れるようなスローな曲を希望します。\n\n「この出会いは最後かもしれない」\n「これはさよならだな。でも、さよならじゃないわ。君の魂の中に、私はいつもここにいるからさ」\n\nループ可能な1分バージョンも欲しいですが、フルバージョンのみでもOKです! 一緒に仕事するのが大好きです! 読んでくれてありがとうございます!\n\nhttps://imgur.com/a/voREZI3", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/16", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "MusMus様、初めまして。リクエスト失礼いたします。\n高クオリティな曲の数々をフリーBGM素材としてシェアしてくださり誠にありがとうございます。\n\n自分は趣味でフリーゲームを作っている者なのですが、このたびMusMus様が公開されている楽曲を使用させていただき短編ゲームを作成しました。ゲームの作成に関しては曲の影響がとても大きく、自分でもお気に入りの一作になりました。\nゲーム内の使用楽曲が24曲中22曲がMusMus様が手掛けられた曲ということもあり、せっかくならご本人様に作品をイメージしたオリジナル曲を作っていただきたい…！と思いリクエストをさせていただいた次第です。\n\n\n●依頼内容\n　ゲームをイメージした楽曲\n\n　資料URLのイラストが紹介される際、MusMus様が『こういうBGMが似合いそうだ』と思ったものをご自由にお願い致します。\n\n\n●ゲームについて（参考程度に）\nゲーム紹介ページ\nhttps://ci-en.dlsite.com/creator/1483/article/640944\n\n・シミュレーションSRPG（SFC時代をイメ－ジして画像などはちょっとレトロ感があります）\n・超能力者がクリーチャーだらけの施設から脱出を目指すサバイバルホラー\n・B級ホラー映画っぽいシナリオ（仲間を疑ったり裏切りなどがあり、ハッピーエンドにはならない感じ）\n・使用楽曲はかっこいい感じのサイバー・テクノ系や不気味なホラー系が多いです\n・戦闘BGMとして使用させていただいている『Phycho Chemical』が現在自分の中の作品イメージ曲です\n\n\n●その他\n・ゲーム内での楽曲使用許可をお願いできますと幸いです\n　（組み込む際はデータ容量の関係で1：30～2：00あたりでループ処理をこちらでさせて頂く形になるかと思います）\n\n以上となります。（Skebの利用は初めてなので何か失礼な点や不備がございましたら大変申し訳ありません）\n難しい場合はご遠慮なくキャンセルしていただければ幸いです。\n楽曲の使用報告を兼ね恐縮ですが、この度は素敵な曲の数々のご提供、本当にありがとうございました！\n\nhttp://muyuu.sakura.ne.jp/2nd.jpg", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/15", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "Watsonさん! またお会いできてうれしいです。今までの作品、ありがとうございました。\n\n今回はお絵描きしながら聴けるループ可能なBGMをお願いしたいです。ボサノバがいいと思う!\n\nライトモチーフ：この過去の作品のライトモチーフを入れることができます。https://skeb.jp/@t_watson/works/10\n\nありがとうございました。\n\nhttps://imgur.com/a/Mj4pHCq", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/14", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "初めまして\n「いりす症候群!」でwatson先生の作品を知り、\n今でも作品内のBGMを鑑賞させて頂いております。\nご都合よろしければリクエストをお願い出来ますでしょうか？\n\n作品の用途は個人で鑑賞させて頂きます。\n\n製作していただきたい楽曲ですが\n「いりす症候群！滅」の「USAGI Note」のようなイメージの\nダウナーな楽曲をお願いします。\n具体的な内容はおまかせでお願い出来ますでしょうか？\n\n以上になります。\n漠然としたリクエストとなり、先生におまかせする部分が多く申し訳ございません。\n解釈に困る、割に合わない等ありましたら\n遠慮なくキャンセルしていただいて大丈夫ですので\nご一考いただければ幸いです。", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/13", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99441fd5a02239269c20e8052242f8e3", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99441fd5a02239269c20e8052242f8e3, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a403c0b96f222e8aab4114c6ec493498 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad05196cb6d6dcb4db14f87ce9e4ffa3 3x", "genre": "correction", "nsfw": false, "body": "watsonさん、よろしくお願いします。\n今回は、拙いですが自分の曲にアドバイスをいただきたく投稿しました。\n1分しかなく短いのですが、よろしくお願いします！\nhttps://drive.google.com/file/d/1VkZUHtZA3-3zJoznl5EMzj1WrxwL7ZuR/view?usp=sharing\n\n・打ち込み方等で足りない、意識した方が良いと感じた所とかありますか？\nピアノトリオ＋エレピ(Keyscape、MODOBASS、GGD)で、\n生楽器のかっこよさを前面に出したいです！（全て打ち込みですが笑）\n\n・音選び、MIXについては、もう・・・わかりません。笑\n一応自分なりに色々頑張ってはいるのですが、youtube等で比較すると自分の曲は音が小さいです。\n初めは音圧を。次にEQでいらない部分を削って。等色々調べたのですが、（周囲に聞く人もおらず）\nそもそもの楽器数が少ない＆ギターがいない等であまり良い解決策がありませんでした。\n\n以上です。ぜひよろしくお願いします。\n\n（依頼とは無関係ですが、当時偶然見つけたMILDESCAPE経由で知って以来ずっと聞いています。\n今回に近いのはoldgoldとか11th fingerとかですかね？大好きです。）", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/12", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "ワトソンさん、こんにちは！あなたの音楽が本当に大好きです。\n\n私の好きなvtuberの音楽をリクエストしたいと思います!\n\n-自信家で楽天的、そして天真爛漫な女の子。幼い頃からバレエを習い、バレエダンサーになることを夢見ていたが、危篤状態に陥り挫折。幼い頃からバレエを習い、バレエダンサーになることを夢見ていたが、病気で挫折。強い女の子だが、雄弁さに欠けるなどの弱点もあり、言うよりもまずやってみることが多い。\n\n以下は彼女の写真とGIFの一部です： https://imgur.com/a/HObI9VL\n\n-彼女のために作ったアートワークに合うようなジャズ音楽が欲しいです。https://imgur.com/EXg1LGi\n悲しみや孤独から始まって、最終的には魅力的で楽観的になることを願っています。\nあなたのジャズが大好きです。\n\n-彼女の好きな曲は、蜜月アン・ドゥ・トロワ（私もこの曲が大好きです）と終わらない詩ですが、全く違う曲ですが、何かインスピレーションを与えられるといいですね。\n\nいずれにしても、あなたの好きなように自由にやってくださいね。", "created_at": "", "completed_at": ""}, {"path": "/@t_watson/works/11", "thumbnail_src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e", "thumbnail_srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061f80c6de2178901695c5df75b7ea1e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03f50af0d56360900e966cbd77f989f4 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F3710273976%2F590cf2a2123ac56481088f3476d63d7d.gif?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ff09142097834977ab392e9da68b3a7 3x", "genre": "music", "nsfw": false, "body": "こんにちは、あなたの音楽が大好きです!Vtuber用のオリジナル曲を探しています!許可を得て、TwitchでのVtuberに使用したいと思います!\n\n私のVtuberは、ワインを飲んだり、街の明かりや星空を見るのが好きな大人の女性です。\nキャラクターリファレンス - https://twitter.com/Naz_Nhaliz/status/1417461467238920194\n\n都会のナイトライフを感じさせるスロージャズの曲を探しています。\n音楽例 : ( このリンクが機能しない場