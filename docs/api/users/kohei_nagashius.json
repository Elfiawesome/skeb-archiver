%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7448001043d981d51caf12cd9d16ebe 2x, https://si.imgix.net/6d47876b/uploads/origins/5ba73779-1602-41af-ab06-4e0637072dd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b6a91ef2cdee03cebe0dcf6169197fa 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kohei_nagashius/works/40", "thumbnail_src": "https://si.imgix.net/f3521208/uploads/origins/240b9550-4423-425f-b02b-18805a4ac7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5fcf5a790131213b12528a5b60cdf3", "thumbnail_srcset": "https://si.imgix.net/f3521208/uploads/origins/240b9550-4423-425f-b02b-18805a4ac7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af5fcf5a790131213b12528a5b60cdf3, https://si.imgix.net/f3521208/uploads/origins/240b9550-4423-425f-b02b-18805a4ac7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=659ede798b888d9ca80a5d1f8f4ada30 2x, https://si.imgix.net/f3521208/uploads/origins/240b9550-4423-425f-b02b-18805a4ac7b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f4f5d3a42bcc7dd6c0e413622ce4b6b 3x", "genre": "art", "nsfw": true, "body": "お世話になります。\nこのたび、リクエストをお送りさせていただきます。\n\n「スケキャン」の千嵐まひながコスプレイベントに参加し、カメラマンたちからさまざまなポーズを求められるうちに、衣装が少しずつズレていき、本人が気づかないままポロリが起きてしまう――\nそして、その様子をカメコ達に撮影されてしまう、という流れの漫画をお願いできればと考えております。\n\n周囲の視線や空気の変化に違和感を覚えつつも、\nポロリしている状況を把握できないまま、カメコ達に撮られ続けてしまい、胸を強調するポーズを取らされてしまうような展開が好みです。\n\n漫画はモノクロで問題ありません。\nこちらについてTKB描写ありでお願いしたいです。\nTKB表現については、チラ見えではなく、はっきりと分かる描写だと嬉しく思います。\n\n難しいリクエストかとは存じますが、\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@kohei_nagashius/works/39", "thumbnail_src": "https://si.imgix.net/f84efbb0/uploads/origins/6f94a5ac-80ce-4bd2-97e6-5437aa50abb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71729c1dbc402acdcee50b8ed12f8fd7", "thumbnail_srcset": "https://si.imgix.net/f84efbb0/uploads/origins/6f94a5ac-80ce-4bd2-97e6-5437aa50abb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71729c1dbc402acdcee50b8ed12f8fd7, https://si.imgix.net/f84efbb0/uploads/origins/6f94a5ac-80ce-4bd2-97e6-5437aa50abb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dddf7d047e15fc2db9f9292b476f07fc 2x, https://si.imgix.net/f84efbb0/uploads/origins/6f94a5ac-80ce-4bd2-97e6-5437aa50abb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00857375f815d9165e99540512fce47e 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n\n2025年10月12日に、千嵐まひなさんの恐怖失禁（資料URL）をリクエストした者です。\n素晴らしいイラストをありがとうございました。しっかりと濡れたスカートや下着、何より新たなまひなさんを拝見できて、本当に嬉しいです。\n\n恐れ入りますが、再度カラーイラストをリクエストさせて下さい。\n昨年11月末にキャンセルとなった内容のため申し訳ありませんが、何卒ご検討のほどお願いいたします。\n\n●キャラクター\n千嵐まひな(スケアリー・キャンパス・カレッジ・ユニバーシティ)\n\nぴったりとした長袖シャツ（カラーはお任せします）、グレーのドルフィンパンツ、白ショーツを履かせて下さい。\n\n●シチュエーション\n肝試しでのトラウマが原因で、おねしょをしてしまった姿。前回の恐怖失禁（資料URL）は実は夢オチであり、翌朝目が覚めた後おねしょに気づく…というイメージです。\n\n●キャラクター描写\n・上半身を起こし、シーツの上にぺたん座りしつつ、濡れたドルフィンパンツやシーツを見つめている姿。\nドルフィンパンツを恐る恐る指でつまんで、濡れているか確かめている様子です。\n摘まれたドルフィンパンツの隙間から、ぐっしょりと濡れた白ショーツが見えるようお描き下さい。\n\n・まひなさんは顔や耳を真っ赤させ、声を殺しながらぐすぐすと泣いている表情です。\n濡れた感触で否応無しに現実（おねしょ）を突きつけられ、恥ずかしさや肝試しの後悔で、涙をポタポタと滴り落としている状態です。\n\n・ドルフィンパンツと白ショーツに、おしっこの染みがぐっしょりと広がっている様子。\nパンツを摘む彼女の指から、無情にも滴り落ちるおしっこの雫、シーツに大きく広がった染みもお描き下さい。\n可能であれば、長袖シャツは寝汗でしっとりと透けているようお描き下さい（難しければ、ご描写不要です）。\n\n・背景はお任せします(彼女の寝室もしくはホテル等でお描き下さい)。\n\n●ファイル\nPSDデータにてお願いします。\n\n難しい内容でありましたらキャンセル、もしくはお手数ですが再送依頼頂ければ幸いです。\n\nhttps://skeb.jp/@kohei_nagashius/works/13", "created_at": "", "completed_at": ""}, {"path": "/@kohei_nagashius/works/38", "thumbnail_src": "https://si.imgix.net/c6f2fd27/uploads/origins/dbd1dc89-9dd7-425a-bc94-c4f65511e1ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=