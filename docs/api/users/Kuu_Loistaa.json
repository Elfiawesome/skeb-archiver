ddle%2Ccenter&txtsize=30&txt=PRIVATE&s=623b90d9d786e9161fec06e7d253ab06, https://si.imgix.net/60ac2a48/uploads/origins/80858bec-0d22-417a-8c19-255757ee1b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a366024011e0d94062804adec2afc4ba 2x, https://si.imgix.net/60ac2a48/uploads/origins/80858bec-0d22-417a-8c19-255757ee1b53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc5461b2c38ad07a886ba48292fc5673 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kuu_Loistaa/works/24", "thumbnail_src": "https://si.imgix.net/f45ad33f/uploads/origins/6e900960-506d-4e01-b63b-f4012dcc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd801e68a14ff1dbc49401f66cdaca67", "thumbnail_srcset": "https://si.imgix.net/f45ad33f/uploads/origins/6e900960-506d-4e01-b63b-f4012dcc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd801e68a14ff1dbc49401f66cdaca67, https://si.imgix.net/f45ad33f/uploads/origins/6e900960-506d-4e01-b63b-f4012dcc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9bf917bb7a6f881dcaf09f6db5012d0 2x, https://si.imgix.net/f45ad33f/uploads/origins/6e900960-506d-4e01-b63b-f4012dcc4a1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b5ff35314d5f8e4a41ab21baf6dc87b 3x", "genre": "art", "nsfw": false, "body": "けものフレンズのプロングホーンちゃんとニホンツキノワグマちゃんがそれぞれ、ラテックスボールに入って転がって競争している様子をお願いします。\nラテックスボールの大きさは大きめでお願いします。\nラテックスボールはプロングホーンちゃんとニホンツキノワグマちゃんがいつも着ている首の部分のマフラーなどを含めた服や鎧の柄(腕や手の部分は除く)でお願いいたします。また、ラテックスボール特有の光沢感もお願いします。ほかの指定といたしましては1枚の絵に2人が丁度入るくらいでお願いいたします。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Kuu_Loistaa/works/23", "thumbnail_src": "https://si.imgix.net/30146931/uploads/origins/0af80d51-2dbc-484d-97c1-a7893b567310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5863f0b56af247afc696c71b5549f930", "thumbnail_srcset": "https://si.imgix.net/30146931/uploads/origins/0af80d51-2dbc-484d-97c1-a7893b567310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5863f0b56af247afc696c71b5549f930, https://si.imgix.net/30146931/uploads/origins/0af80d51-2dbc-484d-97c1-a7893b567310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b80054103a8a259388e55315be9cf265 2x, https://si.imgix.net/30146931/uploads/origins/0af80d51-2dbc-484d-97c1-a7893b567310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f355cc9f3c95bd9de82768691617ca8 3x", "genre": "art", "nsfw": true, "body": "以前「フレンズのヌード」でリクエストを募集していらっしゃいましたが、それを私のオリジナルキャラクター版でお願いできないでしょうか?\n私のTwitterのアイコンのキャラクターで、垂れ耳の犬がフレンズ化したイメージです。\nご検討のほどお願いいたします。\n\nhttps://twitter.com/Tossy99077342", "created_at": "", "completed_at": ""}, {"path": "/@Kuu_Loistaa/works/22", "thumbnail_src": "https://si.imgix.net/6d057499/uploads/origins/7380be37-fb2c-4c13-a0f5-0fd8ec4faf83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd00599e5f11696581cdb0c1b8e8b334", "thumbnail_srcset": "https://si.imgix.net/6d057499/uploads/origins/7380be37-fb2c-4c13-a0f5-0fd8ec4faf83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd00599e5f11696581cdb0c1b8e8b334, https://si.imgix.net/6d057499/uploads/origins/7380be37-fb2c-4c13-a0f5-0fd8ec4faf83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8005ad2b2d28bb8d95b9fdd60a228ba4 2x, https://si.imgix.net/6d057499/uploads/origins/7380be37-fb2c-4c13-a0f5-0fd8ec4faf83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b6e3602471ad7822993bc3af1b9f892 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\nオリジナルキャラクターOKでしたら、うちの子（参考URLの青い子）の放尿姿を描いてほしいです。\n立ったままパンツを下ろして、スカートをたくしあげておしっこしている様子です。\n背景はなくてもよいですが、野外のイメージです。\nもし可能であれば全裸バージョンも見てみたいです。\n下の毛はなしです。\nよろしくお願いします。\nhttps://twitter.com/NagatabiP/status/1508037058677587969?t=P37rfxbIlvVlMKG7TrUD5g&s=19", "created_at": "", "completed_at": ""}, {"path": "/@Kuu_Loistaa/works/21", "thumbnail_src": "https://si.imgix.net/e0cd548c/uploads/origins/9d1cee0f-fe6e-4ac3-8b99-653eb42f4e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68b89a20a22d18bd95e97485891703dd", "thumbnail_srcset": "https://si.imgix.net/e0cd548c/uploads/origins/9d1cee0f-fe6e-4ac3-8b99-653eb42f4e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68b89a20a22d18bd95e97485891703dd, https://si.imgix.net/e0cd548c/uploads/origins/9d1cee0f-fe6e-4ac3-8b99-653eb42f4e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e20cf2970268165d6392ea63ed6d48e 2x, https://si.imgix.net/e0cd548c/uploads/origins/9d1cee0f-fe6e-4ac3-8b99-653eb42f4e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91e649f841268e283eb3d31a683ca38c 3x", "genre": "art", "nsfw": false, "body": "映画スマイルプリキュアに登場するシンデレラをお願いします！\n大きさは100万倍〜1000万倍のデカさで、ピンク・黒ドレスの差分をお願いします。\nできる限り健全でお願いします。\nシチュはズシンズシンと大陸を歩きながら手を振る感じです。\nカラー版が見てみたいのでお願いします！\n\nモーションはこれ↓\nhttps://sta.sh/0mrwq8gkjie\n\nピンクドレスのシンデレラ\nhttp://blog-imgs-98.fc2.com/g/e/n/genga10/DSC0266512771.jpg\n\n黒ドレスのシンデレラ\nhttp://blog-imgs-98.fc2.com/g/e/n/genga10/20161205220347280.jpg", "created_at": "", "completed_at": ""}, {"path": "/@Kuu_Loistaa/works/20", "thumbnail_src": "https://si.imgix.net/26e3b9d1/uploads/origins/f3b409c9-1bf8-4672-9b76-8cf1b312585a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=925ec1ff107a502b769a5279a3f57805", "thumbnail_srcset": "https://si.imgix.net/26e3b9d1/uploads/origins/f3b409c9-1bf8-4672-9b76-8cf1b312585a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=925ec1ff107a502b769a5279a3f57805, https://si.imgix.net/26e3b9d1/uploads/origins/f3b409c9-1bf8-4672-9b76-8cf1b312585a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69b60f890a014f648f53f23495197b65 2x, https://si.imgix.net/26e3b9d1/uploads/origins/f3b409c9-1bf8-4672-9b76-8cf1b312585a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7334f1e4a32ce66909b3878dcfe367fb 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Kuu_Loistaa/works/19", "thumbnail_src": "https://si.imgix.net/7a1193bb/uploads/origins/2f207812-b503-4b43-9109-d84c06193b45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39075f5d771052db2f54b928e8b037c7", "thumbnail_srcset": "https://si.imgix.net/7a1193bb/uploads/origins/2f207812-b503-4b43-9109-d84c06193b45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39075f5d771052db2f54b928e8b037c7, https://si.imgix.net/7a1193bb/uploads/origins/2f207812-b503-4b43-9109-d84c06193b45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0db52bffdebf0ff36f42fa74838a4410 2x, https://si.imgix.net/7a1193bb/uploads/origins/2f207812-b503-4b43-9109-d84c06193b45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2ab0bd1a202767876263aa89b5a90e8 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n以前描かれたフェネック作品（https://mobile.twitter.com/Annoying_Dorff/status/1600332664753782785）が素晴らしかったので似たような作品を描いて頂ければと思います\n\n以下概要\n・対象キャラはフェネック\n・スカートだけ身につけておらずパンティ丸出し、後は前回同様の状態の服装のものをお願い致します。\n・パンティは婦人服売場で如何にも売っていそうな、レース等の模様が適度に入った白色のパンティをお願いします。（参考資料①あくまでイメージです）\n・表情は赤面しながらも誘惑しているようなものが希望です。\n・状況としては立ったままパンティを見せつけて煽り、誘惑しているイメージです。煽るような台詞として「今日の柄のパンティはどうかな？」「無事固くなってる…こうゆうのも好きなんだね」「脱ぎたて持って帰っていいんだよ？スケベ君♪」といったものをお願い致します。\n\n条件的に差分が可能でしたら、\n・下着の色がピンク色のバージョン\n・ノーパンで無毛局部が見えてしまっているバージョン\nをお願い致します。\n\n要望が多くお手数おかけしますが、何卒ご検討をお願い致します。\n\n資料①https://www.nissen.co.jp/img/item/BND01/BND0122B0006/BND0122B0006_l_c102.jpg", "created_at": "", "completed_at": ""}]}