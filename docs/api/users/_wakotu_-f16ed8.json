b9f5ffb21f17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1015937e90a81520232a281b5075bb3d 3x", "genre": "art", "nsfw": false, "body": "はじめまして\n\nちゃそさんの描く生意気そうな表情をするキャラがとても刺さり、依頼させていただきました。\n\n個人Vtuberの雛森ひまめさんを、クソガキ感たっぷりに描いていただけますでしょうか。それ以外の構図はすべて好きに描いていただければ幸いです\n\nでは、ご検討のほどよろしくお願いいたします。\n\nhttps://x.com/hina_mamee/status/1755595568305545251", "created_at": "", "completed_at": ""}, {"path": "/@_wakotu_/works/36", "thumbnail_src": "https://si.imgix.net/36a3fac6/uploads/origins/93efd7f8-cb51-4ad3-aa14-b41e511a76d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e71d7452c2c309aefceb1d93c966f6", "thumbnail_srcset": "https://si.imgix.net/36a3fac6/uploads/origins/93efd7f8-cb51-4ad3-aa14-b41e511a76d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88e71d7452c2c309aefceb1d93c966f6, https://si.imgix.net/36a3fac6/uploads/origins/93efd7f8-cb51-4ad3-aa14-b41e511a76d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b512f2783220d5ccfb9b69a905440af0 2x, https://si.imgix.net/36a3fac6/uploads/origins/93efd7f8-cb51-4ad3-aa14-b41e511a76d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=735e60f55fdcec131bf1274905913e11 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生。先生の絵とデザインが大好きです。\nすみません、私は英語しか話せません、翻訳が正しいことを願っています。\n私のOCのアートワークを依頼したいのですが、下のXのリンクに参考資料があります。\n\n重要なポイントは、ハンマー、モンスターエナジードリンク、そしてモンスターのロゴの傷跡、右目の近く。\nそして、おてんばでクールなキャラクターです。\nその他、ポーズや背景はあなたの自由です。好きなように描いてください！\n\nキャラクターデザインのXリンク、キャラクターの近くにつけたカラーマークは無視してください。\n\nhttps://x.com/Kiso_the_CLT/status/1919698695290830883", "created_at": "", "completed_at": ""}, {"path": "/@_wakotu_/works/35", "thumbnail_src": "https://si.imgix.net/c4d51c72/uploads/origins/f13d8ed2-37ea-4c6d-b136-e563bd271e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207f5108fa0b5e1b052cc9b787b114b3", "thumbnail_srcset": "https://si.imgix.net/c4d51c72/uploads/origins/f13d8ed2-37ea-4c6d-b136-e563bd271e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207f5108fa0b5e1b052cc9b787b114b3, https://si.imgix.net/c4d51c72/uploads/origins/f13d8ed2-37ea-4c6d-b136-e563bd271e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba88687bb57127dbb9a4a621ed572f10 2x, https://si.imgix.net/c4d51c72/uploads/origins/f13d8ed2-37ea-4c6d-b136-e563bd271e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ce5a99dff8ecd2485e26832c63c27aa 3x", "genre": "art", "nsfw": false, "body": "ちゃそ様の配信いつも楽しく拝見させていただいています。リスナーのマイアです。\n今回自身が個人的に応援しているVtuberである堂々御前やよい様（チャンネルURL　　https://www.youtube.com/@DodomaeYayoi）のFAを依頼させてください。\n\nVtuberご本人さまにはFAの依頼をしても良いと直接許可を頂いております。\n併せてちゃそ様の配信で今回FAの執筆中画面の公開や、ちゃそ様の配信内で堂々御前やよい様のyoutubeチャンネルやXアカウント等を映しても良いことの許可を頂いております。\n\n■描いていただきたい内容 \n表情や構図などおまかせいたしますので、自由に描いていただければと思います\n\n■使用用途\nFAとして堂々御前やよい様にプレゼントします。\n本人が気に入った場合、サムネイルや動画内での使用、SNSでのプロモーションに使用させていただくかもしれません。\nその際トリミングや文字入れ、色味調整などの加工を伴う可能性があります。\n上記可能でしたなら、背景透過したPNG画像もしくはPSDファイルもあると助かります。\n\n内容が合わなければキャンセルしていただいて大丈夫です。\n私がイラストのことについて全くの無知、またこのようなFA依頼リクエスト文の作成が初のため到らない依頼文で申し訳ございません。\nお忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://x.com/dodomae_yayoi/status/1887079907940790707", "created_at": "", "completed_at": ""}, {"path": "/@_wakotu_/works/34", "thumbnail_src": "https://si.imgix.net/e6b45707/uploads/origins/657bc760-d86a-42fd-8c50-5c89c9357b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5697442bd62629d538e1fc21b4ef728f", "thumbnail_srcset": "https://si.imgix.net/e6b45707/uploads/origins/657bc760-d86a-42fd-8c50-5c89c9357b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5697442bd62629d538e1fc21b4ef728f, https://si.imgix.net/e6b45707/uploads/origins/657bc760-d86a-42fd-8c50-5c89c9357b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21e3347733133e76c5e7b8549e01ff17 2x, https://si.imgix.net/e6b45707/uploads/origins/657bc760-d86a-42fd-8c50-5c89c9357b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67f6758b01fb6745161bf9ae82124979 3x", "genre": "art", "nsfw": false, "body": "ちゃそ様\n\nはじめまして！\nIRIAMで活動しています白羽こもりと申します。クリエーター新着で見つけ、ちゃそ様の描く女の子が可愛いくて、凄く好みだった為、ぜひ私のオリキャラをリクエストをしたいと思いメッセージ失礼致します。\n\n\n《依頼内容》\n私のocで1枚絵を描いて頂きたいです。\n\n普段の姿に猫の耳や尻尾を付けたイラストをお願いしたいです！服のデザインや他の構図などは、ちゃそ様にお任せ致します。お好きなように描いてください！\n\n\n髪色・・・青みがかった銀髪\n目・・・・形は少しタレ目で、色は水色(まつ毛黒)、青と紫のグラデーションです(まつ毛白\n)\n\n【使用用途】\n・サムネイル等で使用 \n・各種SNSでの使用 \n・IRIAMでの返礼品\n・グッズ等への利用 \n\nNGな事がありましたらお手数お掛け致しますが、他レイヤーにて教えて頂けると嬉しいです。\n\n可能であれば背景等をレイヤー分けして納品いただけると嬉しいです。\n\nご検討頂けますと幸いです。よろしくお願い致します🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1sAGPFmOWebeO8EpMrfpTgfZXDS51iLnk", "created_at": "", "completed_at": ""}, {"path": "/@_wakotu_/works/33", "thumbnail_src": "https://si.imgix.net/d4da978d/uploads/origins/9b3d3a8f-5297-4397-ab35-0f64cdbeabd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e89ce1a47d0d9bfb9d265a0e0b3df6", "thumbnail_srcset": "https://si.imgix.net/d4da978d/uploads/origins/9b3d3a8f-5297-4397-ab35-0f64cdbeabd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16e89ce1a47d0d9bfb9d265a0e0b3df6, https://si.imgix.net/d4da978d/uploads/origins/9b3d3a8f-5297-4397-ab35-0f64cdbeabd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04416b51f144a7a4da3108ea694df7a5 2x, https://si.imgix.net/d4da978d/uploads/origins/9b3d3a8f-5297-4397-ab35-0f64cdbeabd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=736844e6015fd67c479b79c4bdf5e231 3x", "genre": "art", "nsfw": false, "body": "ちゃそ様\n\nこんばんわ月見月と申します。\nちゃそ様のイラストをまた見たく2度目の依頼となりますがモデルが新しくなりましてリクエストさせていただきます。条件問題ありませんでしたらぜひよろしくお願いいたします。\n\n【依頼内容】\nキャラクター：月見月・レオ＝ウルフェカのイラスト（参考画像は資料ＵＲＬにて）\n性別：男性（ショタ？女の子？）\n服装：浴衣\n表情：小ばかにした感じの表情（可能であればもう１つ何か表情をください！）\n背景：山奥の旅館で遭遇した的な…感じです！\n\nその他細かいポーズはちゃそ様にお任せするのでお好きなようにお願いします！\n\n【使用用途】\n・SNS(X)やYoutubeのサムネイルや動画内での使用\n・動画内や記念等で画像を一部の視聴者配布（する可能性