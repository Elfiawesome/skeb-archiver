ix.net/03dd0424/uploads/origins/7850cda8-d6f0-46e9-9dfd-6a5dc9e43181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b3f7340be6be2ab548e09091a70abf7, https://si.imgix.net/03dd0424/uploads/origins/7850cda8-d6f0-46e9-9dfd-6a5dc9e43181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c764673d45e30f657ea4dd64d7943d0f 2x, https://si.imgix.net/03dd0424/uploads/origins/7850cda8-d6f0-46e9-9dfd-6a5dc9e43181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fadb52a51f1e46bc01f51dd610386d58 3x", "genre": "art", "nsfw": false, "body": "はじめまして。リクエストさせて頂きます。\nアニメ版Anotherの赤沢さん(165cm)と恒一(168cm)をカップルらしく描いてください。\n詳細はお任せします。資料を参考にご自由にお描きください。\nなお作品の舞台は98年の北陸の田舎町(モデルは富山県)です。\n絵柄はなるべく公式に寄せてください。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "created_at": "", "completed_at": ""}, {"path": "/@naminori3220/works/3", "thumbnail_src": "https://si.imgix.net/bfb04dfc/uploads/origins/093a6b73-2943-48f3-8bc3-5b6766ceff45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0177f554e2d0f70642ac20759d77ef5", "thumbnail_srcset": "https://si.imgix.net/bfb04dfc/uploads/origins/093a6b73-2943-48f3-8bc3-5b6766ceff45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0177f554e2d0f70642ac20759d77ef5, https://si.imgix.net/bfb04dfc/uploads/origins/093a6b73-2943-48f3-8bc3-5b6766ceff45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a7e37b23d5e9a53a937ab8dd21d5611 2x, https://si.imgix.net/bfb04dfc/uploads/origins/093a6b73-2943-48f3-8bc3-5b6766ceff45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d20d328169c0c52d1fcb6223c0a54b5a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！skebへようこそ！偶然あなたのページを見つけて、あなたのスタイルが大好きになりました。2人のOC、ChervilとMintを描いてくれることを期待しています。ミントは癒しの薬を専門とする遊牧民の錬金術師です。彼女の翼と「月の薬」が大きな特徴です。  Chervilも錬金術師だが、傭兵とともに旅をし、毒を専門としている。彼女の傷跡も非常に重要な特徴です。あなたのポートフォリオには、人々が背中合わせに立っているとてもクールなイメージがあります。彼らはいつも仲が良い