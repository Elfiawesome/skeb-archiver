008d6023e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47e17f4629facf8b93167646950128b7, https://si.imgix.net/c2cf04f4/uploads/origins/b1d4db84-1570-4ffe-89f5-842008d6023e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=649de5c3c268aa5113a67faf10069ab4 2x, https://si.imgix.net/c2cf04f4/uploads/origins/b1d4db84-1570-4ffe-89f5-842008d6023e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87113f3e07a330b3cdf345464b2b93ea 3x", "genre": "art", "nsfw": false, "body": "いつも大変お世話になっております。\nいつもの幽霊のデザインでイラスト作成をお願い致します。\n\n〝誕生日おめでとう〟〝フォロワー〇〇人おめでとう〟という際に用いる\nおめでとう(〃'▽'〃)ﾉ∠※PAN!　の様なイラストをお願い致します。\nこれに拘らず、構図はお好きな様に変更して頂いて結構でございます。\n\nまたお手数ではございますが、イラストにはテルミナーさんの可愛いサインを\n入れて頂けるとありがたいです。　私の名前は不要でございます。\n\n以上の仕様にてお願い致したく存じます。\nお手隙の際にご対応頂ければ幸甚でございます。\n\n　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　ごはん拝", "created_at": "", "completed_at": ""}, {"path": "/@naaterumi/works/8", "thumbnail_src": "https://si.imgix.net/7600f634/uploads/origins/5d542be7-e384-4042-814b-3ad03f58debb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b09668dc27907568f59fc0a4d27f6b2", "thumbnail_srcset": "https://si.imgix.net/7600f634/uploads/origins/5d542be7-e384-4042-814b-3ad03f58debb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b09668dc27907568f59fc0a4d27f6b2, https://si.imgix.net/7600f634/uploads/origins/5d542be7-e384-4042-814b-3ad03f58debb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=958f9a10ca995f3a9ee6eb54db706b0c 2x, https://si.imgix.net/7600f634/uploads/origins/5d542be7-e384-4042-814b-3ad03f58debb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2de40092a46a071e313236b264ca0083 3x", "genre": "art", "nsfw": false, "body": "2回目のリクエストです。\n働くお姉さんシリーズ、オカメインコちゃんとうさぎさんのコラボです。\n以前描いて頂いた、白菜を段ボールに詰め、1箱6玉入　15kg になります。\n\n捧げられていない食材を、無駄なく出荷する、お二人でした。\n\nフォークリフトに『オカメインコちゃん』が乗り、積み込み作業。\n\nトラックの運転手が『うさぎさん』でイラストを描いて欲しいです。\n\n行き先は、市場なります。\n\n足りない要素は、お任せします。\nよろしくお願いします。\n\n参考URL 『https://www.ibaraki-shokusai.net/seisan/?id=1383』\nトラックに積み込みしている様子がわかります。", "created_at": "", "completed_at": ""}, {"path": "/@naaterumi/works/7", "thumbnail_src": "https://si.imgix.net/2d10f895/uploads/origins/742b726d-490c-4924-90ec-5f14592cd665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c59d80df5bd417e9b819921cf2e4fea1", "thumbnail_srcset": "https://si.imgix.net/2d10f895/uploads/origins/742b726d-490c-4924-90ec-5f14592cd665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c59d80df5bd417e9b819921cf2e4fea1, https://si.imgix.net/2d10f895/uploads/origins/742b726d-490c-4924-90ec-5f14592cd665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3652b1134c1bf4c0175d2f71846a944c 2x, https://si.imgix.net/2d10f895/uploads/origins/742b726d-490c-4924-90ec-5f14592cd665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71c49e57dd0d16e6a1209ff8b6093b5e 3x", "genre": "art", "nsfw": false, "body": "初めまして、おやさい愛好家と申します。\nいつもTwitterで拝見させて頂いています。\nオカメインコちゃん可愛いですね♪\nその中の人と野菜の着ぐるみでコラボしたら、どのようなイラストになるのだろうか？と思い、依頼を出そうと思いました。\n\nお題は、『白菜』でお願いします。\n\n風景は白菜畑。\n農家のおばちゃんの隣で、楽しそうな感じで描いてくれたら嬉しいです♪\n検討宜しくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@naaterumi/works/6", "thumbnail_src": "https://si.imgix.net/e58873eb/uploads/origins/fd85205e-bd9f-4926-90fe-f383bbda3224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ecd0d121800222bce6fca8f0500578a", "thumbnail_srcset": "https://si.imgix.net/e58873eb/uploads/origins/fd85205e-bd9f-4926-90fe-f383bbda3224?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ecd0d121800222bce6fca8f0500578a, https://si.imgix.net/e58873eb/uploads/origins/fd85205e-bd9f-4926-90fe-f383bbda3224?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc361cc5195c5ca4595eef6779827d0d 2x, https://si.imgix.net/e58873eb/uploads/origins/fd85205e