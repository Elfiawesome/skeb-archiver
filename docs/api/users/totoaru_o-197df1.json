4afa2?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=828c1d2e2a9514f0f798bee92afab4d8 2x, https://si.imgix.net/8445fde3/uploads/outputs/e6b39978-244f-47f5-bbbc-1109d2b4afa2?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f3657a63c118998673ceafd7fc11993 3x", "genre": "video", "nsfw": false, "body": "こんにちは！私の名前はPruitiiです。あなたの絵とこのかわいいチビ動画が大好きです！https://skeb.jp/@totoaru_o/works/16\n同じようなことをお願いしたいのですが、私のVtuberをチビにした動画です。このイラストをTwitterやYoutubeで使いたいです！\n\n私のVTuberは母性的で気立てがよく、誰にでもとても優しい人です。みんなを笑顔にしたくて、たとえ自分がバカに見えても。\n\n彼女が泡の上に座って水を飲んでいるループビデオをお願いしたいです。グリーンスクリーンのバージョンもお願いします。\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/file/d/1bMtQa2UWBOJN42BbYRFg3a6TUmt2xsrj/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@totoaru_o/works/18", "thumbnail_src": "https://si.imgix.net/eb7fcf47/uploads/outputs/2e4add87-ea5a-4189-a727-670b04f9ed43?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1cd9c675e2d4a485904b7f6665f94929", "thumbnail_srcset": "https://si.imgix.net/eb7fcf47/uploads/outputs/2e4add87-ea5a-4189-a727-670b04f9ed43?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=1cd9c675e2d4a485904b7f6665f94929, https://si.imgix.net/eb7fcf47/uploads/outputs/2e4add87-ea5a-4189-a727-670b04f9ed43?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7f8f45a2ee8741411b60e8664164240 2x, https://si.imgix.net/eb7fcf47/uploads/outputs/2e4add87-ea5a-4189-a727-670b04f9ed43?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=af67cc755a3b55122d5a80742fbaa4ad 3x", "genre": "video", "nsfw": false, "body": "はじめまして！\n\nこの二人のキャラクターでアニメを描いていただけませんか？\n二人は一緒に魔女と魔法使いのための魔法学校に通っています。学校は中世のお城風です。\nファンタジーがテーマです（しゃべる植物、空飛ぶ本、空飛ぶほうき、動く絵、ファンタジークリーチャー、動く羽ペン、呪文書、フクロウ、猫、コウモリ、カボチャなど）。\n\nアロイス金髪の少年。トラブルメーカー。いたずら好きで気が強い。趣味：スケッチ、ロック音楽。\nゲイブ。茶髪。自信家で人懐っこく、アロイスをからかうのが好き。宇宙船と科学が好き。いつか宇宙船を設計したいらしい。\n\n2人の関係は、ゲイブが人気者で、アロイスと仲良くなろうとして彼を驚かせるというものだ。\n\n次のようなアニメーションを作っていただけますか？\nゲイブは杖を使って、小さな宇宙船を魔法のように2人の頭の周りを飛び回らせています。\nアロイスは畏敬と驚きをもって見ている。\n二人は一緒に笑っている。\n\nいずれにせよ、私のリクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1aijBfN9Jila_sth9TnmhdCSuzLHHwOaj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@totoaru_o/works/17", "thumbnail_src": "https://si.imgix.net/d224bd33/uploads/origins/2f711d18-5984-4779-b162-869add0391b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2224032061434e824fc75ceb5c587077", "thumbnail_srcset": "https://si.imgix.net/d224bd33/uploads/origins/2f711d18-5984-4779-b162-869add0391b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2224032061434e824fc75ceb5c587077, https://si.imgix.net/d224bd33/uploads/origins/2f711d18-5984-4779-b162-869add0391b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebb6432f7c40cbf1fd91056c2f6d72e6 2x, https://si.imgix.net/d224bd33/uploads/origins/2f711d18-5984-4779-b162-869add0391b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=427d95ea4215666bbf399fffc01c3a4e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵はとても美しいです！私のオリジナルキャラクターのイラストをお願いしたいです！\n\nhttps://sta.sh/2s37m9f71tk\n\n私のキャラクターは眼帯をしています！\n彼は大都会に住んでいます。悲しいときは街を散歩する。https://skeb.jp/@totoaru_o/works/12 & https://skeb.jp/@totoaru_o/works/7 のような感じにしたいです！\n\n街並みや暗い雰囲気にしたいです。でも、好きなように描いてください\n\nありがとうございました！ヾ(*'▽'*)\n\nhttps://sta.sh/0l1cv46iyg9", "created_at": "", "completed_at": ""}, {"path": "/@totoaru_o/works/16", "thumbnail_src": "https://si.imgix.net/040b7d47/uploads/outputs/35b2c42c-97f6-418f-8b08-b3dff758aeae?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=37b2c1a1950d0a12f1d619c4c6abf730", "thumbnail_srcset": "https://si.imgix.net/040b7d47/uploads/outputs/35b2c42c-97f6-418f-8b08-b3dff758aeae?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=37b2c1a1950d0a12f1d619c4c6abf730, https://si.imgix.net/040b7d47/uploads/outputs/35b2c42c-97f6-418f-8b08-b3dff758aeae?bg=%23fff&fm=webp&auto=