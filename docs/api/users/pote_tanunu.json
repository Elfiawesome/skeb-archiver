、青い服を着ているのが私です。1枚目のポーズと感情・表情が気に入っているのですが、2枚目と3枚目もかわいいので、参考までに全部載せたいと思いました。\n\nhttps://drive.google.com/drive/folders/1_bGJix09Nl9fFZPK-dyo-qBIWyTCgQvU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@pote_tanunu/works/24", "thumbnail_src": "https://si.imgix.net/07e21c23/uploads/origins/0b6a4075-8318-49a8-a2ae-d5aa4931cb83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a04063f22af2cac2899cc96c94bea4e4", "thumbnail_srcset": "https://si.imgix.net/07e21c23/uploads/origins/0b6a4075-8318-49a8-a2ae-d5aa4931cb83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a04063f22af2cac2899cc96c94bea4e4, https://si.imgix.net/07e21c23/uploads/origins/0b6a4075-8318-49a8-a2ae-d5aa4931cb83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d17dbd99e739a26cc456c47e119e6852 2x, https://si.imgix.net/07e21c23/uploads/origins/0b6a4075-8318-49a8-a2ae-d5aa4931cb83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51a0f82b119bac37e8d14a04e6287226 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@pote_tanunu/works/23", "thumbnail_src": "https://si.imgix.net/68666860/uploads/origins/cc9dea18-cd50-436c-b8c3-a9180e76f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dff5355cfdbf10fb13e492ec402d1e88", "thumbnail_srcset": "https://si.imgix.net/68666860/uploads/origins/cc9dea18-cd50-436c-b8c3-a9180e76f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dff5355cfdbf10fb13e492ec402d1e88, https://si.imgix.net/68666860/upl