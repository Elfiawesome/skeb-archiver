=200&h=200&s=a6c6092ad13e610e6fc885b2bd2873d7 2x, https://si.imgix.net/ec916a75/uploads/origins/f18d6f7a-88bb-4bc2-a59e-02499bf5e512?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e58b3377fa86441d2a8a14f86567483 3x", "genre": "art", "nsfw": false, "body": "こんにちは！お薦めであなたのアカウントを見つけました。添付の参考資料にある、里親になったキャラクターのいずれかのイラストを依頼したいです！選択肢はたくさんありますが、気に入ったキャラクターが見つかるといいなと思います。ポーズは自由に決めていただいて結構です。ご検討いただき、誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1usay9a3kE6eHRTFNJfQBbZHg0k0FlMyU", "created_at": "", "completed_at": ""}, {"path": "/@shiori_komugiko/works/18", "thumbnail_src": "https://si.imgix.net/158bd1ad/uploads/origins/e6d8d5df-56c7-4444-8810-bb4713416474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b267aef4f7fd3fe7a533b5947ae77386", "thumbnail_srcset": "https://si.imgix.net/158bd1ad/uploads/origins/e6d8d5df-56c7-4444-8810-bb4713416474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b267aef4f7fd3fe7a533b5947ae77386, https://si.imgix.net/158bd1ad/uploads/origins/e6d8d5df-56c7-4444-8810-bb4713416474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa0e4b9e62d0d5130d0e01fa2edd6ec9 2x, https://si.imgix.net/158bd1ad/uploads/origins/e6d8d5df-56c7-4444-8810-bb4713416474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b757985fecfd6c35f1225819843d3c2 3x", "genre": "art", "nsfw": false, "body": "私のオリジナルキャラクター「カゼ」の肖像画を依頼します。重要な特徴は以下の通りです。- 中央に一本の緑の角を持つ鬼娘- 短いストレートヘア- 日本風不良スタイル- おてんば性格- 胸に巻いた白い布の上にバーシティジャケットを着用- 肌はやや日焼け気味\n-怒っているかイライラした表情https://drive.google.com/drive/folders/1GKkRATJax170lJlwiy9UJAEfT8T1H5na?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@shiori_komugiko/works/17", "thumbnail_src": "https://si.imgix.net/31d0882c/uploads/origins/ba2956a5-07d1-40f8-9482-dcb7433597ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee305ff57f44c5dc76c6916a5e466049", "thumbnail_srcset": "https:/