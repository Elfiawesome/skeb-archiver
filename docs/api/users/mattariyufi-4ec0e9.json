tsize=30&txt=PRIVATE&s=5c1a7b2bed06b95106015ee513dbdfcf 2x, https://si.imgix.net/70f9a165/uploads/origins/094b8ab5-3b70-43d4-9341-181df618803d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7af264ce394f38d5bd1534f8e84b8a2b 3x", "genre": "comic", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mattariyufi/works/18", "thumbnail_src": "https://si.imgix.net/6f7cc7f7/uploads/origins/9427573e-cafd-4d61-b3b4-44bd7ce023e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae7fca2e7535e4ee0aeeaff8cd6ea17", "thumbnail_srcset": "https://si.imgix.net/6f7cc7f7/uploads/origins/9427573e-cafd-4d61-b3b4-44bd7ce023e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae7fca2e7535e4ee0aeeaff8cd6ea17, https://si.imgix.net/6f7cc7f7/uploads/origins/9427573e-cafd-4d61-b3b4-44bd7ce023e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c5522f18df09927f391f8455d6be4c6 2x, https://si.imgix.net/6f7cc7f7/uploads/origins/9427573e-cafd-4d61-b3b4-44bd7ce023e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96a8c0421c2d863c6c47f3837c14d5e1 3x", "genre": "comic", "nsfw": true, "body": "美しいセキレイの作品をありがとう。今回もぜひお願いしたい作品があります！今回は、からすば（主な敵役！😲😲）が登場します！シナリオは、本編終了後から始まります。ムスビとの戦いの後、ようやく昏睡状態から目覚めたカラスバ。彼女は愛とは何かを学びたいが、学ぶことができない！そんな彼女に愛を教えてくれるのは、みんなが大好きな主人公ミナトしかいない！烏羽はサディスティックで冷たい殺人鬼のように見えるかもしれないが、湊はゆっくりと、しかし確実に、ゆっくりと滑らかなセックスでその面影を消し去っていく！湊は、増え続けるハーレムの大多数の賛同を得て、また新たなセキレイを手に入れる。同じセキレイファンとして、この言葉がうまく伝わるといいのだが。烏羽は人生に対して非常に冷めた世界観を持っている。湊との \"交流 \"を通して、彼女は愛とは何かを理解し始める。しかし、彼女は主人公の放蕩の夜を支配している。彼女の疲れ切った冷たい目と小悪魔的な微笑みを強調してほしい。この仮定のシナリオを楽しんでください!!!!", "created_at": "", "completed_at": ""}, {"path": "/@mattariyufi/works/17", "thumbnail_src": "https://si.imgix.net/80eeb24c/uploads/origins/6c3bd039-2f23-4361-a4dd-8ce7dd27a2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fi