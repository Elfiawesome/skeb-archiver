FFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e64eb3ecef51887b6eff969ee71c9ed 2x, https://si.imgix.net/faff3fec/uploads/origins/d7b4e0fd-b4aa-4d15-950a-52f0730751e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9feba3d4e2895b1ef830bd38078168d5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/36", "thumbnail_src": "https://si.imgix.net/810c73da/uploads/origins/e334ee95-1e43-4f13-ad1e-d8e2867558e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd033e3b18b4367eb782336bc3f5f111", "thumbnail_srcset": "https://si.imgix.net/810c73da/uploads/origins/e334ee95-1e43-4f13-ad1e-d8e2867558e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd033e3b18b4367eb782336bc3f5f111, https://si.imgix.net/810c73da/uploads/origins/e334ee95-1e43-4f13-ad1e-d8e2867558e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d226c9784da669c40b07dc4f9acd81a7 2x, https://si.imgix.net/810c73da/uploads/origins/e334ee95-1e43-4f13-ad1e-d8e2867558e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=690ab2143c4098b26492d92eb159cfdd 3x", "genre": "art", "nsfw": false, "body": "Hello! I love how you draw male characters! I was hoping to request this character with a glass of whiskey.\n\nhttps://drive.google.com/drive/folders/1vRjnSEAS_edQLxEF0hwUR9II6_NOz09O", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/35", "thumbnail_src": "https://si.imgix.net/ea7398e4/uploads/origins/6e44f9b2-62ce-456a-a80d-289ca887e766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e4f94b01f28f52f8559060dfb757d51", "thumbnail_srcset": "https://si.imgix.net/ea7398e4/uploads/origins/6e44f9b2-62ce-456a-a80d-289ca887e766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e4f94b01f28f52f8559060dfb757d51, https://si.imgix.net/ea7398e4/uploads/origins/6e44f9b2-62ce-456a-a80d-289ca887e766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=55f26cbca6899b5bb1a711a4b4c9ccb1 2x, https://si.imgix.net/ea7398e4/uploads/origins/6e44f9b2-62ce-456a-a80d-289ca887e766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb4cbfcf351f4b2e79d54976090bba16 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/34", "thumbnail_src": "https://si.imgix.net/d305b7e4/uploads/origins/e0ff3316-0691-4b2b-ad15-4c95668d1389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53eaf04bd6a048f651d9ff00966f1b52", "thumbnail_srcset": "https://si.imgix.net/d305b7e4/uploads/origins/e0ff3316-0691-4b2b-ad15-4c95668d1389?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53eaf04bd6a048f651d9ff00966f1b52, https://si.imgix.net/d305b7e4/uploads/origins/e0ff3316-0691-4b2b-ad15-4c95668d1389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=87581854f2027b9c519cdce2f7d0076c 2x, https://si.imgix.net/d305b7e4/uploads/origins/e0ff3316-0691-4b2b-ad15-4c95668d1389?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=646974d72dc65136e155b0d7bd425875 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵は美しいですね！できれば、私のOCのイラストをお願いしたいのですが。\n\n彼はあらゆる生き物の骨と骸骨に執着しています。彼の趣味の一つは、動物の骨格を組み立てて展示する剥製の一種である骨格標本です。また、タトゥーやタトゥーのさまざまなプロセスにも大きな関心を持ち、自らタトゥーを入れることも楽しんでいる。社交性に乏しいため、その外見や趣味も相まって、周囲からは奇妙で不快な存在と思われている。\n\n身体的特徴としては、190センチで筋肉質の大きな体をしている。手にはタトゥーがあるが、簡略化するのはご自由に！\n\n好きなように描いてください！\n\n参考：https://drive.google.com/drive/folders/1OFs1kYpE5kHkbbwBFAwvKbAw1oX4KKqI?usp=drive_link\n\n依頼を検討していただきありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/33", "thumbnail_src": "https://si.imgix.net/fd4dcffb/uploads/origins/30acb6b7-648e-41a5-adee-958bfa19c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5291dc4cefeab9d30b2d6aaada7741", "thumbnail_srcset": "https://si.imgix.net/fd4dcffb/uploads/origins/30acb6b7-648e-41a5-adee-958bfa19c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5291dc4cefeab9d30b2d6aaada7741, https://si.imgix.net/fd4dcffb/uploads/origins/30acb6b7-648e-41a5-adee-958bfa19c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c606039e66301204544afd3ebd454af 2x, https://si.imgix.net/fd4dcffb/uploads/origins/30acb6b7-648e-41a5-adee-958bfa19c18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=323fbd894c18792b508ff72f292919de 3x", "genre": "art", "nsfw": false, "body": "こんにちは！僕のOCを描いてくれたら嬉しいな。\n\nHUNTER - 陸軍の従順な兵士で、強い軍人の家系に生まれた。勇敢で規律正しく任務をこなすが、士気を高めるためや愛する人といるときはおバカな一面も見せる。  愛に突き動かされ、すべての行動に誠意と献身を注ぐ。暗闇や恐怖に苛まれる時期であっても、常に明るさと希望を見いだし、他者と分かち合おうとする。\n\n テーマ／シンボル：アスターフラワー、ドッグタグ、傷跡、献身、忘却への微笑み、チェロ、家族、ゴールデンレトリバー、オオカミ、寒い夜の火\n \nhttps://drive.google.com/drive/folders/1lMFaFMAN4O0jApCxnJD6_nBaMqsNfxBq", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/32", "thumbnail_src": "https://si.imgix.net/23aedbe8/uploads/origins/b1324e22-ab02-4d22-9559-a344f610d315?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1720f35f97e6ddb09f3d6a845ae40e98", "thumbnail_srcset": "https://si.imgix.net/23aedbe8/uploads/origins/b1324e22-ab02-4d22-9559-a344f610d315?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1720f35f97e6ddb09f3d6a845ae40e98, https://si.imgix.net/23aedbe8/uploads/origins/b1324e22-ab02-4d22-9559-a344f610d315?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07b56cebbcccde8e6c23176bb66e5e90 2x, https://si.imgix.net/23aedbe8/uploads/origins/b1324e22-ab02-4d22-9559-a344f610d315?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7afa28ee280486df9a78de452826ede 3x", "genre": "art", "nsfw": false, "body": "こんにちは！特にhttps://skeb.jp/@Richt_richter/works/6。\n私のキャラクター、シリルのアートワークをリクエストしてもいいですか？\n\nシリルは34歳。セレブなシェフです。クールでチャーミングで遊び心がある。彼の一番の魅力は明るい琥珀色の瞳。\n人といちゃつくのが好き。社交的で、バーやクラブでたむろするのが好き。好きな飲み物は昔ながらのカクテル。\n\nhttps://sta.sh/2kjw2d7fzf1?edit=1", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/31", "thumbnail_src": "https://si.imgix.net/b057e121/uploads/origins/e4b64406-6fea-4eb4-9571-0d8bebd22f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=773a0b9fa0f015443cfb635edb81d883", "thumbnail_srcset": "https://si.imgix.net/b057e121/uploads/origins/e4b64406-6fea-4eb4-9571-0d8bebd22f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=773a0b9fa0f015443cfb635edb81d883, https://si.imgix.net/b057e121/uploads/origins/e4b64406-6fea-4eb4-9571-0d8bebd22f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89bd4af8785d11a7d30c036d09f1e532 2x, https://si.imgix.net/b057e121/uploads/origins/e4b64406-6fea-4eb4-9571-0d8bebd22f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea6067d303f57498c898cccf7dd9994e 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作品はとても美しいです。\n私のVtuberモデルのイラストをお願いしたいです！\n私はDevildom Army(魔王軍)です。モチーフは黒い蝶と白いバラです。\n\nクールで控えめな性格でお願いします。\n自由に描いていただきたいです。\n\nSNS、壁紙、動画、サムネイル、商用利用、印刷物に使用させていただきます。\nその際はクレジットをお渡しします。\n\n可能であれば、納品ファイルでキャラクターと背景レイヤーを分けてください。\n\nありがとうございました！\n\n内容\n男女二人\n\n人物設定\nhttps://drive.google.com/drive/folders/1_6Qi3WASYgT5Y17sKZ9UHfKeQvuXpCyU?usp=sharing\n\nhttps://drive.google.com/drive/folders/1_6Qi3WASYgT5Y17sKZ9UHfKeQvuXpCyU?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/30", "thumbnail_src": "https://si.imgix.net/ef261a2d/uploads/origins/d2cf79c7-6d55-46e5-b233-26d6a112cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=312bbcb423cec92be6e6c12b29ad3b4d", "thumbnail_srcset": "https://si.imgix.net/ef261a2d/uploads/origins/d2cf79c7-6d55-46e5-b233-26d6a112cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=312bbcb423cec92be6e6c12b29ad3b4d, https://si.imgix.net/ef261a2d/uploads/origins/d2cf79c7-6d55-46e5-b233-26d6a112cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0785fcd72c574e66eaf484229c7de221 2x, https://si.imgix.net/ef261a2d/uploads/origins/d2cf79c7-6d55-46e5-b233-26d6a112cebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c57d05c0905304f5be43c2b8d2dceba 3x", "genre": "art", "nsfw": false, "body": "また相談にのってください！\n\n今回も\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍するキャラです。\n衣装はそのまま系でも別衣装でも良いです。\n武具は無くても良いです。\nタトゥーみたいなものは\n能力発現で浮かびあがるものなので無くても良いです。\n\n使用したい範囲は\n自前の紹介サイトや、ＳＮＳでの掲載となります。\n※トリミング使用も想定しています。\n\n御面倒かけますが\nよろしく御検討ください！\n\nhttps://twitter.com/oniyatsuhashi/status/1706695590233710996?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/29", "thumbnail_src": "https://si.imgix.net/ca0408f0/uploads/origins/8b59cba4-33bc-417d-83d4-05df5a7b581b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17b43c405ac2c67dfec0fee8131cd303", "thumbnail_srcset": "https://si.imgix.net/ca0408f0/uploads/origins/8b59cba4-33bc-417d-83d4-05df5a7b581b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17b43c405ac2c67dfec0fee8131cd303, https://si.imgix.net/ca0408f0/uploads/origins/8b59cba4-33bc-417d-83d4-05df5a7b581b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86abd5a4104d9efa2911389d21217ed9 2x, https://si.imgix.net/ca0408f0/uploads/origins/8b59cba4-33bc-417d-83d4-05df5a7b581b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92fc678b9ea28c26b9f1061ac9e2e24a 3x", "genre": "art", "nsfw": false, "body": "Hello! I really love your art and I would love to see my character Keisuke in your style!\n\nKeisuke is a japanese police officer of a haunted town in the 1990's. As an original resident, he is trying to uncover the secrets of the town and find out what really happened when he was a child. He is usually expressionless with his dead fish eyes, however he’s actually a warm and gentle person. He loves to eat delicious food, play with stray cats, or relax. \n\nYou can draw him in any clothing or scenario, please draw freely\n\nCharm Points: his beauty marks, black eyes, scruff, eyebrows, and tanned skin!\n\nhttps://toyhou.se/14112032.keisuke/gallery\nhttps://www.pinterest.com/yanmoriii/keisuke/\n\nThank you for your consideration!", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/28", "thumbnail_src": "https://si.imgix.net/2c2587ef/uploads/origins/725265a7-19c1-4f45-9ce7-3894ca86acde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a28162cd4cab832db95dbb9f2c57617", "thumbnail_srcset": "https://si.imgix.net/2c2587ef/uploads/origins/725265a7-19c1-4f45-9ce7-3894ca86acde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a28162cd4cab832db95dbb9f2c57617, https://si.imgix.net/2c2587ef/uploads/origins/725265a7-19c1-4f45-9ce7-3894ca86acde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c440ed15fe60655c4334c09e23b3069 2x, https://si.imgix.net/2c2587ef/uploads/origins/725265a7-19c1-4f45-9ce7-3894ca86acde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37096e8a03fcaef018cd2f595885a9bd 3x", "genre": "art", "nsfw": false, "body": "藤堂閣下、こんにちは！\n\n前回のリクエストがとても気に入ったので、今回もお願いしたいと思います。\n私のOCであるハムザのアートをお願いしたいのですが、今のところ彼のビジュアルリファレンスが不足しています。彼のアイデアに最も影響を与えたのはFFXIIのガブランスで、それが彼の顔を入れた理由です。ただ、重要な違いは、左のこめかみに傷跡があることと、髪があまり後ろに流れていないことだ。茶髪の筋もある。  \n\n彼が着ている鎧は『エルデン・リング』のブレイドの鎧に似ているが、このデザインは自由だ。毛皮の面は残してほしい！\n\nもしこのリクエストに抵抗があれば、遠慮なく断ってください。いずれにせよ、藤堂閣下さんの作品を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1G0hmKYZHxRfR7_vnPqvucGqG7B0j-Zo3?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/27", "thumbnail_src": "https://si.imgix.net/8d8854e1/uploads/origins/62ea37f6-d8cd-4884-bbe7-4096600c6531?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe6de7bebfe0357c1db9177c6c911f1", "thumbnail_srcset": "https://si.imgix.net/8d8854e1/uploads/origins/62ea37f6-d8cd-4884-bbe7-4096600c6531?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe6de7bebfe0357c1db9177c6c911f1, https://si.imgix.net/8d8854e1/uploads/origins/62ea37f6-d8cd-4884-bbe7-4096600c6531?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4eb5e440077ea89b56f7043afbc9e156 2x, https://si.imgix.net/8d8854e1/uploads/origins/62ea37f6-d8cd-4884-bbe7-4096600c6531?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a7729eb66da0becf8fd0ea9170e9eae 3x", "genre": "art", "nsfw": false, "body": "こんにちは、はじめまして！私のオリジナルキャラクター、ミンウのイラストをお願いしてもよろしいでしょうか？人前ではいい人を装って正体を隠している現代の吸血鬼です。実際は共感というものを理解しない、とても悪意のある人間です。彼にはいろいろな衣装があるので、もしどれも興味をそそらないようなら、新しい衣装で自由に描いてください :]。\n僕のリクエストを読んでくれてありがとう！\n\n参考文献\nhttps://sta.sh/21y7ffd9b0c3", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/26", "thumbnail_src": "https://si.imgix.net/a94c17d1/uploads/origins/5fd7d94a-7cfc-4495-9fb3-33bb8f5c738b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fea63f182a355428a4b4f3ab26493a02", "thumbnail_srcset": "https://si.imgix.net/a94c17d1/uploads/origins/5fd7d94a-7cfc-4495-9fb3-33bb8f5c738b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fea63f182a355428a4b4f3ab26493a02, https://si.imgix.net/a94c17d1/uploads/origins/5fd7d94a-7cfc-4495-9fb3-33bb8f5c738b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23b521958c2a4968ec57e983a4ee44bb 2x, https://si.imgix.net/a94c17d1/uploads/origins/5fd7d94a-7cfc-4495-9fb3-33bb8f5c738b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7a1e32889c39e753c3617a5a60e3450 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/25", "thumbnail_src": "https://si.imgix.net/69c4b8a1/uploads/origins/dac00722-7423-4899-abb7-130a0307c922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=235c604ab53e9f68d998d6928bdf46c5", "thumbnail_srcset": "https://si.imgix.net/69c4b8a1/uploads/origins/dac00722-7423-4899-abb7-130a0307c922?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=235c604ab53e9f68d998d6928bdf46c5, https://si.imgix.net/69c4b8a1/uploads/origins/dac00722-7423-4899-abb7-130a0307c922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=faaad53458daca37cfc7693f724695bb 2x, https://si.imgix.net/69c4b8a1/uploads/origins/dac00722-7423-4899-abb7-130a0307c922?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3bdc2186efe58f652a21bef33c39e93e 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/24", "thumbnail_src": "https://si.imgix.net/57c1396e/uploads/origins/0b6ebf30-787a-4b5e-a31b-9fdfb545573a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90e0e38db4b90707f3fa6ae10e969ebc", "thumbnail_srcset": "https://si.imgix.net/57c1396e/uploads/origins/0b6ebf30-787a-4b5e-a31b-9fdfb545573a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90e0e38db4b90707f3fa6ae10e969ebc, https://si.imgix.net/57c1396e/uploads/origins/0b6ebf30-787a-4b5e-a31b-9fdfb545573a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3455bde4f52ef8d31c6d3e4767e74c3 2x, https://si.imgix.net/57c1396e/uploads/origins/0b6ebf30-787a-4b5e-a31b-9fdfb545573a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=169f5c065d4b85828fc0d9971fdf92db 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/23", "thumbnail_src": "https://si.imgix.net/4de64aba/uploads/origins/13049fc1-50f5-4da9-8131-05429723907a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eafc3400987986c2efa03773b7611d3a", "thumbnail_srcset": "https://si.imgix.net/4de64aba/uploads/origins/13049fc1-50f5-4da9-8131-05429723907a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eafc3400987986c2efa03773b7611d3a, https://si.imgix.net/4de64aba/uploads/origins/13049fc1-50f5-4da9-8131-05429723907a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42ed0bfd8e7fe2e1fdcdcaa4d14ad453 2x, https://si.imgix.net/4de64aba/uploads/origins/13049fc1-50f5-4da9-8131-05429723907a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff40451278e17a427c538b71a433193d 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作風が好きなので、もし可能なら私のocを描いてほしいです。\nニコは23歳。黒髪で、上向きの細い緑色の目、目の下にはクマがあり、肌の色は暖かいベージュ。\n彼は決して教育的ではなく、無謀で、とても直感的で、粘着質で、攻撃的で、まるで野生の動物のようです。いい子でいることが大好きだが、いつも短気を抑えることができない。\n趣味はアンティークのおもちゃ、ファーストフード、インディーズ映画、タバコ。\n亡くなったと思われる兄を捜すため、自分の行く手を阻む者は誰であろうと排除しようとする。\nモチーフ／雰囲気の提案廃墟、燃える、雪、落書き、孤独、ストリートカルチャー、ヴィンテージノスタルジー、孤独、コラージュ、カエル\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1la5J4VPJpBxU5aAYlBIXVVhpgzmDSThG?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/22", "thumbnail_src": "https://si.imgix.net/d7d414de/uploads/origins/ff1d1a0c-b571-4e08-835b-942106e5a720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=443d050f8ae1610065c88feaae8c7132", "thumbnail_srcset": "https://si.imgix.net/d7d414de/uploads/origins/ff1d1a0c-b571-4e08-835b-942106e5a720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=443d050f8ae1610065c88feaae8c7132, https://si.imgix.net/d7d414de/uploads/origins/ff1d1a0c-b571-4e08-835b-942106e5a720?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b73840225fc21eada71a69e9b55159f 2x, https://si.imgix.net/d7d414de/uploads/origins/ff1d1a0c-b571-4e08-835b-942106e5a720?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bc686940fa4c1e3e4620b552ab5b92e 3x", "genre": "art", "nsfw": false, "body": "こんにちは、あなたの絵とみんなのキャラクターを伝える方法が本当に大好きです。私のキャラクターをリクエストさせてください。\n彼はアメリカの1920/30年代の時代のアンデッドです。彼は派手で、軽薄で、魅力的で、サディズムのニュアンスがあります。他のアンデッドと戦うこともある。\n\n見た目は32歳で筋肉質。頭は化粧で覆われている。残りの皮膚は腐敗しており、医療用の包帯が巻かれている。主要な関節は露出している傾向がある。喉から胸にかけて縫い目があり、常に縫い直す必要がある。最初の画像を主な参考資料とし、他の画像は補助的な参考資料とし、必要であれば自由に細部を調整してください。\n\n彼がいた時代に関連したテーマで、上品で、不気味で、セクシーな作品を希望します。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1D0WZtHbH4Px358vk2M_Rve_8iRItsDHy?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/21", "thumbnail_src": "https://si.imgix.net/23a23385/uploads/origins/e16e23c7-79c3-4eb2-b448-30cdaa75a7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3daeeba9d688bf3731d120402b0a083b", "thumbnail_srcset": "https://si.imgix.net/23a23385/uploads/origins/e16e23c7-79c3-4eb2-b448-30cdaa75a7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3daeeba9d688bf3731d120402b0a083b, https://si.imgix.net/23a23385/uploads/origins/e16e23c7-79c3-4eb2-b448-30cdaa75a7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05bad4abde7e8285f10bebed70945d02 2x, https://si.imgix.net/23a23385/uploads/origins/e16e23c7-79c3-4eb2-b448-30cdaa75a7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a493e547a010955a2d4724d3dcc92ae7 3x", "genre": "art", "nsfw": false, "body": "藤堂先生、こんにちは！あなたの絵がとても好きなので、ぜひ依頼したいです！\n\nこれは1999年のCOC TRPGに登場する私のキャラクターで、名前はプルート、スコットランド人です。\n\n年齢は43歳。メロンジュースが好きで、目はいつも寝不足のように見え、金持ちを騙す詐欺師だ。好きな色は緑。\n\nhttps://drive.google.com/file/d/1McpDbuPCA1zMXQVuwpt9AqXXq-Z40jUA/view?usp=sharing\n\nありがとう！", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/20", "thumbnail_src": "https://si.imgix.net/98ce1965/uploads/origins/75f300a0-0fd7-4844-b3c9-c3716d60cbba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6273ab0809e468a6cf52c34aaed5599", "thumbnail_srcset": "https://si.imgix.net/98ce1965/uploads/origins/75f300a0-0fd7-4844-b3c9-c3716d60cbba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c6273ab0809e468a6cf52c34aaed5599, https://si.imgix.net/98ce1965/uploads/origins/75f300a0-0fd7-4844-b3c9-c3716d60cbba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=045068fdb4373f5421d6e6eb9d5e2d22 2x, https://si.imgix.net/98ce1965/uploads/origins/75f300a0-0fd7-4844-b3c9-c3716d60cbba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e3342e2131550a5a88808d47cda7394 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/19", "thumbnail_src": "https://si.imgix.net/b5abbdbb/uploads/origins/6082e5ea-e8aa-4e8e-bf18-209fd0da43b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afb1f3ec90adbdc5bc6d953c5a8b0af5", "thumbnail_srcset": "https://si.imgix.net/b5abbdbb/uploads/origins/6082e5ea-e8aa-4e8e-bf18-209fd0da43b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afb1f3ec90adbdc5bc6d953c5a8b0af5, https://si.imgix.net/b5abbdbb/uploads/origins/6082e5ea-e8aa-4e8e-bf18-209fd0da43b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d25a82ee54659a655bb64acfdfb97d72 2x, https://si.imgix.net/b5abbdbb/uploads/origins/6082e5ea-e8aa-4e8e-bf18-209fd0da43b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3729d2b9e4803059293741155d28a29b 3x", "genre": "art", "nsfw": false, "body": "こんにちは、こんばんは！あなたは素晴らしい雰囲気のアートスタイルを持っています。友人に勧められて、オリジナルキャラクターをお願いすることにしました！\n\n名前はヴァイスです。性格は冷静沈着であまり表情を変えない。電気やテクノロジーを魔法として使うことができる魔道士で、必要に応じて槍を武器として使ったり、これを伝導させたりすることができる。サイバーパンクな未来版ロンドンに住んでいる。趣味は小説、ビリヤード、ナイトウォーク。\n \n詳細はあなたにお任せします！ご検討ありがとうございます。^_^\n\nhttps://drive.google.com/drive/folders/1wyBbULTkYBE2wZUn09S5H0SRyTlccsGi?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/18", "thumbnail_src": "https://si.imgix.net/6697334e/uploads/origins/f1fbb784-54fd-42df-ab5b-611f2aa316d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e65e726db48f7868976f1637b86a41b", "thumbnail_srcset": "https://si.imgix.net/6697334e/uploads/origins/f1fbb784-54fd-42df-ab5b-611f2aa316d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e65e726db48f7868976f1637b86a41b, https://si.imgix.net/6697334e/uploads/origins/f1fbb784-54fd-42df-ab5b-611f2aa316d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f8ebacef480a845bc5a4e5cdc99515a 2x, https://si.imgix.net/6697334e/uploads/origins/f1fbb784-54fd-42df-ab5b-611f2aa316d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84ada207a552c1849fa0354fc8c1ee77 3x", "genre": "art", "nsfw": false, "body": "三回目の相談となります！\n\n前回と同じく\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍する忍者系キャラです。\n衣装はそのまま系でも別衣装でも問題ないです。\n\n使用範囲は\n自前の紹介サイトや、ＳＮＳでの掲載となります。\n※トリミング使用も想定しています。\n\n御面倒かけますが\nよろしく御検討ください！\n\nhttps://x.com/oniyatsuhashi/status/1705167911659409427?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/17", "thumbnail_src": "https://si.imgix.net/118a32b2/uploads/origins/71a595ae-105e-4aaa-9285-f12b37406032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70904749e9d04008558d002ff5f2606", "thumbnail_srcset": "https://si.imgix.net/118a32b2/uploads/origins/71a595ae-105e-4aaa-9285-f12b37406032?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70904749e9d04008558d002ff5f2606, https://si.imgix.net/118a32b2/uploads/origins/71a595ae-105e-4aaa-9285-f12b37406032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1c9666529b03ee66a03adc53d05ea0c 2x, https://si.imgix.net/118a32b2/uploads/origins/71a595ae-105e-4aaa-9285-f12b37406032?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd8742a19558abdbc448fd4ed0963950 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの画風が大好きなので、ぜひ私のオリジナルキャラクターを描いてほしいです。彼女はアンドロジナス/マスキュリンなルックスの騎士で、剣を持って戦います。もっとカジュアルな服装で、キャンプやトレーニングでくつろいでいるような姿を描いていただけたらと思います。彼女の服装のスタイルは参考にしたけれど、ディテールやポーズなどはすべてあなた次第！\n\n参考画像：https://imgur.com/a/BnWEFLB\nインスピレーションボード：https://www.pinterest.com/splatboards/tarien/\n\n依頼を検討していただき、ありがとうございました。\n\nhttps://imgur.com/a/BnWEFLB", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/16", "thumbnail_src": "https://si.imgix.net/14467db5/uploads/origins/7a0ceec7-2ced-425f-898d-b0389318e41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08a000e46fbecba928519bb3205148d", "thumbnail_srcset": "https://si.imgix.net/14467db5/uploads/origins/7a0ceec7-2ced-425f-898d-b0389318e41a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08a000e46fbecba928519bb3205148d, https://si.imgix.net/14467db5/uploads/origins/7a0ceec7-2ced-425f-898d-b0389318e41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92d4198bee32dad4a9a02924cb90fea0 2x, https://si.imgix.net/14467db5/uploads/origins/7a0ceec7-2ced-425f-898d-b0389318e41a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=065c14c0ceb9001ac82ae621a7ad2918 3x", "genre": "art", "nsfw": false, "body": "先生、僕のこのオリジナルキャラクターを描いてください。\n\n縦構図が可能で、できるだけ人物の全身が見えるようにしたい。\n\nキャラクターの名前はアルゴス・アリトロス。元パラディンの団長で、現在はエンジェル・ハンターだ。黒い瞳に、長いまつげ。顔に傷や涙の跡、目の周りにクマがあることもご了承ください。 肌は明るく、髪は真っ黒ではなく、濃い灰色だ。首のネックレスは妻の指輪。物静かな若い娘がいた。彼はその娘をとても愛していた。しかし、子供たちにはとても優しい。\n\n笑顔はあまりない。\n\n詳しいキャラクター説明はフォルダに添付してあります。\n\nもし武器を描けるとしたら、これを描きたい：\n\nhttps://drive.google.com/file/d/1lU21z9bI1RfQfDrj-HqF1d0f6Cr-BggQ/view?usp=drivesdk\n\n服装、顔、髪型はできるだけこの写真を参考にしてください：\n\nhttps://drive.google.com/file/d/1PIcdr4_ASInE0ipInjpuRTX1C2jxMA_s/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/17H5Qk_2kmQwgTUgJwweM7jfAzNBP5e2d/view?usp=drivesdk\n\nより多くの参考資料が必要であれば、この中の何かがあなたの役に立つことを願っている。（多分、更新すると思う。）：\n\nhttps://drive.google.com/drive/folders/15w9L_Wsu36S3ZpVXQLHlhkpGrhVhyjh3\n\nお読みいただきありがとうございます。\n私の依頼を引き受けていただけるとうれしいです。", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/15", "thumbnail_src": "https://si.imgix.net/35e2fca1/uploads/origins/d0a8705c-8efc-4250-b3a1-956bf69f6bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6853961942bd3fdf12133c67e5c54c9", "thumbnail_srcset": "https://si.imgix.net/35e2fca1/uploads/origins/d0a8705c-8efc-4250-b3a1-956bf69f6bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6853961942bd3fdf12133c67e5c54c9, https://si.imgix.net/35e2fca1/uploads/origins/d0a8705c-8efc-4250-b3a1-956bf69f6bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2781f55b06b29090a1f24976dfdd7889 2x, https://si.imgix.net/35e2fca1/uploads/origins/d0a8705c-8efc-4250-b3a1-956bf69f6bbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2adc869b5e92df0572c564e054ef59bd 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの作風がとても好きです！私のキャラクターを描いてもらえるととても嬉しいです。\n\nダレン (185cm)\n元図書館司書で、現在は超常現象を扱う探偵事務所で働いている。一見フレンドリーだが、ずるい性格。人にちょっかいを出して反応を伺うのが好き。\nインスピレーションボード：https://www.pinterest.at/pepperonisss/darren/\nファッションの参考：https://www.pinterest.at/pepperonisss/darren/fashion/\n\nポーズと構図はお任せします。リファレンスフォルダにある服装で自由に描いてください。\n\n依頼内容に問題があれば、遠慮なく却下してください。よろしくお願いします！\n\nhttps://sta.sh/222ee614rvee", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/14", "thumbnail_src": "https://si.imgix.net/317968c3/uploads/origins/5d134f4c-d305-4ec8-b533-c09cf87e7b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d21ba13d0f6da0b687c47b6679fedbf", "thumbnail_srcset": "https://si.imgix.net/317968c3/uploads/origins/5d134f4c-d305-4ec8-b533-c09cf87e7b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d21ba13d0f6da0b687c47b6679fedbf, https://si.imgix.net/317968c3/uploads/origins/5d134f4c-d305-4ec8-b533-c09cf87e7b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960ef1b7fde3d0b73f13907dc66f1caa 2x, https://si.imgix.net/317968c3/uploads/origins/5d134f4c-d305-4ec8-b533-c09cf87e7b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82148d82b6f0fe1127c970dd46d63961 3x", "genre": "art", "nsfw": false, "body": "美しくてとにかくカッコイイ男性のイラストに惹かれました！\n良ければ資料URLのウチの子を、先生のスタイルで描いて頂けたら幸いです。\n\nhttps://x.com/er114_k/status/1708015421524504628?s=46&t=XZhK0QAD7iWUFRfjngt36w", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/13", "thumbnail_src": "https://si.imgix.net/01685029/uploads/origins/2e7d3b2e-6660-4523-a204-ed01c397fc6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c62136a94e43d6bb17f4ed141971da60", "thumbnail_srcset": "https://si.imgix.net/01685029/uploads/origins/2e7d3b2e-6660-4523-a204-ed01c397fc6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c62136a94e43d6bb17f4ed141971da60, https://si.imgix.net/01685029/uploads/origins/2e7d3b2e-6660-4523-a204-ed01c397fc6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2024269975aa2a0b33d1ded93d76892 2x, https://si.imgix.net/01685029/uploads/origins/2e7d3b2e-6660-4523-a204-ed01c397fc6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=084f3d7c1d759b33e55e2ab62bf53502 3x", "genre": "art", "nsfw": false, "body": "はじめまして！\n\n僕のオリジナルキャラクターを描いてもらえませんか？\n名前はアロイス。侵略してくるエイリアンと戦う秘密組織の一員です。\nとてもエネルギッシュで、いたずら好きで、おちゃめな性格。\n趣味はロック、お菓子作り、スケッチ。\nスナイパーでもある。\n普段の表情はいたずらっぽい大きな笑み。\n体型は痩せ型。\nどんな服を着せてもいいし、新しい服をデザインしてもいい。\n\nクールでエッジの効いたポーズをお願いします。\n\nポーズや構図はお任せします！\n\nいずれにせよ、リクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1YQ4Iw4idpFiQBivhMkWU8m5lAriDDkQD?usp=share_link", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/12", "thumbnail_src": "https://si.imgix.net/9e9522bf/uploads/origins/6eeafef9-c197-495a-a1f2-c872763675f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b855295d51ec8c9dfe9af3417785ca", "thumbnail_srcset": "https://si.imgix.net/9e9522bf/uploads/origins/6eeafef9-c197-495a-a1f2-c872763675f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90b855295d51ec8c9dfe9af3417785ca, https://si.imgix.net/9e9522bf/uploads/origins/6eeafef9-c197-495a-a1f2-c872763675f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=611ee748b2fa095c966754bb582b0cfa 2x, https://si.imgix.net/9e9522bf/uploads/origins/6eeafef9-c197-495a-a1f2-c872763675f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a09be005d8e57f7ceae13ed0d819cbc 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私のオリジナルキャラクター2人を描いていただけませんか？全員男性です。\nラスデスは白銀の長髪で、肌の色は黒く、赤い目をしている。白いシャツに黒いネクタイのスーツを着ています。パンツは普通の黒いスーツのズボンで、黒い革靴を履いている。\nイロモは金髪で赤い瞳をしている。肌の色は白く、髪は黒い蝶結びである。ラスデスとは友人であり同僚でもある。彼のマスクは描かなくてもいい。イロモの場合は、ダークグレーのシャツに黒のスーツのジャケット、グレーのスーツのベストを着ている。パンツは普通の黒のスーツのズボンに黒の革靴。\n好きなように描いていいよ、君の画風は本当に好きだから。読んでくれてありがとう。あなたがこの依頼を楽しんでくれることを祈っています。\n\n参考になりました：\n\nhttps://drive.google.com/drive/folders/1TdnGGXnRKsWoNEy9cKw6FL6yERPBw7ZW\n\nラスデス\n\nhttps://drive.google.com/drive/folders/108Vtwabx1FL84xrNU-_CkniVyjj2Fr9C\n\nイロモ\n\nhttps://drive.google.com/drive/folders/13OSCos2dNukESoLOhnN81BrxHeUoXpfm", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/11", "thumbnail_src": "https://si.imgix.net/076ebc88/uploads/origins/c76fcc29-143c-479e-b540-edf83df81928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=667a40a33515cfac56056c9666ad39c4", "thumbnail_srcset": "https://si.imgix.net/076ebc88/uploads/origins/c76fcc29-143c-479e-b540-edf83df81928?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=667a40a33515cfac56056c9666ad39c4, https://si.imgix.net/076ebc88/uploads/origins/c76fcc29-143c-479e-b540-edf83df81928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14f3754e1b16aff19c4d8ff1d65e750c 2x, https://si.imgix.net/076ebc88/uploads/origins/c76fcc29-143c-479e-b540-edf83df81928?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2ee455d80dcb3846a77c3f93e86648b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの美しいアートワークと雰囲気のあるスタイルが大好きです。私のキャラクター、ガブリエルのイラストをお願いしたいのですが、https://toyhou.se/20959662.gabriel-gonzalez。\n\n彼は未来的/サイバーパンクなニューヨークの救急隊員です。仕事をしている最中の彼を描いていただけると嬉しいです！シナリオはあなた次第です。\n\n金額が足りない場合はアピールしてください。ご検討のほど、よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/10", "thumbnail_src": "https://si.imgix.net/504716df/uploads/origins/827d3bec-5006-46a6-90c0-a4faf5ad0c5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d3f35012422ac672b7d4680d18686a0", "thumbnail_srcset": "https://si.imgix.net/504716df/uploads/origins/827d3bec-5006-46a6-90c0-a4faf5ad0c5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d3f35012422ac672b7d4680d18686a0, https://si.imgix.net/504716df/uploads/origins/827d3bec-5006-46a6-90c0-a4faf5ad0c5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d186bbd71ab7c19fcad85515725cb553 2x, https://si.imgix.net/504716df/uploads/origins/827d3bec-5006-46a6-90c0-a4faf5ad0c5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=044e9bee34a82d900858ab780436deed 3x", "genre": "art", "nsfw": false, "body": "前回に御願いしたイラストがとても良かったので、\n矢継ぎ早で恐縮ですが、また御願いします！\n\n前回と同じく\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍する剣士系キャラです。\n（前回のイラストでおまけで描いていただいたキャラです！）\n性格は優しく生真面目で優等生ですが、戦う姿勢は苛烈です。\n\n使用範囲は\n自前の紹介サイトや、ＳＮＳでの掲載となります。\n※トリミング使用も想定しています。\n\n↓はアレンジ画です\nhttps://x.com/oniyatsuhashi/status/1506971014101897221?s=20\n\n御面倒かけますが\nよろしく御検討ください！\n\nhttps://x.com/oniyatsuhashi/status/1469160637939208192?s=20", "created_at": "", "completed_at": ""}, {"path": "/@Richt_richter/works/9", "thumbnail_src": "https://si.imgix.net/927c71a7/uploads/origins/2e4d927b-4408-45c5-aa0e-a588099fe7b8?bg=%23fff&auto=forma