ce2-23fd63ccdefb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ff0322808676eef4a411414187eb356 2x, https://si.imgix.net/48dfaf78/uploads/origins/fc5ed5df-d60d-44e8-8ce2-23fd63ccdefb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6681d0a790755bd2ca69b95ea839f012 3x", "genre": "art", "nsfw": true, "body": "こんばんは、はじめまして。\nひつか様の描かれるかわいいショタがとても好きです！！\n\nもしよろしければ、URL先に資料を貼らせていただいたオリジナルキャラクターの男の子がレイプされる様子を再度依頼させていただきたいです。\n\nそれ以外は全てお任せとさせていただきますが、もし可能でしたら、「催眠」や「乳首責め」の要素を入れていただければ幸いです。\n③、④の子がレイプされる、という感じにしていただければと思います。①、②枚目の子についてはは設定上関係が深いので載せておりますが、必ず見て頂かなくても大丈夫です。 \n\nまた、5枚目に等身大の顔立ちや体格資料の方も添付させていただきます(どちらかと言えばこのビジュアルに寄せて描いていただければ嬉しいです)。尚、この5枚目のイラストで横髪につけている銀のヘアピンは現在つけていないため、外していただければと思います。\n口調は6枚目です。セリフは有った方がありがたいですが、無しで納品していただいても大丈夫です。\n\n以上になります。長々と失礼致しました。 URLが開けない、額が見合わないなどありましたら、このリクエストはキャンセルしていただければと思います。 よろしければ、ご検討よろしくお願いいたします。\n\nhttps://1drv.ms/f/s!AlCTaMFSX4I7gWwzfbaErAeqaCML", "created_at": "", "completed_at": ""}, {"path": "/@hituka/works/13", "thumbnail_src": "https://si.imgix.net/6b248f5e/uploads/origins/9ec593d4-7281-4994-a9ef-3ab74b33a3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b531bde5fca517e51acab0a437e0874e", "thumbnail_srcset": "https://si.imgix.net/6b248f5e/uploads/origins/9ec593d4-7281-4994-a9ef-3ab74b33a3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b531bde5fca517e51acab0a437e0874e, https://si.imgix.net/6b248f5e/uploads/origins/9ec593d4-7281-4994-a9ef-3ab74b33a3a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e231825758a2677564d98c52a94c3f2 2x, https://si.imgix.net/6b248f5e/uploads/origins/9ec593d4-7281-4994-a9ef-3