ff-e4e2-417d-801b-f60c27841ac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=265ffb7e387635858542b54631317c5f 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/25", "thumbnail_src": "https://si.imgix.net/5d6ea589/uploads/origins/cfa99a38-0b07-4ae0-b130-a019a0160afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d103b4fba38ad478a1a0545375ed91", "thumbnail_srcset": "https://si.imgix.net/5d6ea589/uploads/origins/cfa99a38-0b07-4ae0-b130-a019a0160afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8d103b4fba38ad478a1a0545375ed91, https://si.imgix.net/5d6ea589/uploads/origins/cfa99a38-0b07-4ae0-b130-a019a0160afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf275f14c8877ee1f0af0e2fd3da416f 2x, https://si.imgix.net/5d6ea589/uploads/origins/cfa99a38-0b07-4ae0-b130-a019a0160afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9fd94ed160cc014415c3f5ee3f56c3c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！いつも可愛いイラスト達を楽しく見ております！\n\n人物ー英雄伝説 界の軌跡 フィー・クラウゼル ( https://imgur.com/a/hMjK6vG )\n             英雄伝説 界の軌跡 フェリ・アルファイド ( https://imgur.com/a/ja4KoSo )\n\nシチュエーション\n一緒に武器の整備をしながら雑談を楽しんでいる姿\n詳しい構図などはお任せでお願いします。\n\n読んで頂きありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/24", "thumbnail_src": "https://si.imgix.net/44ddb027/uploads/origins/85094269-7a20-4518-8bea-d33965d5f45b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff0b95d502953e7cb57c34817757e8e", "thumbnail_srcset": "https://si.imgix.net/44ddb027/uploads/origins/85094269-7a20-4518-8bea-d33965d5f45b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff0b95d502953e7cb57c34817757e8e, https://si.imgix.net/44ddb027/uploads/origins/85094269-7a20-4518-8bea-d33965d5f45b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=193346e133495090e31f8283ae04632f 2x, https://si.imgix.net/44ddb027/uploads/origins/85094269-7a20-4518-8bea-d33965d5f45b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be5472d427499cdf7d26d1c95dbd70f2 3x", "genre": "art", "nsfw": false, "body": "GEORGEさんこんばんは！前回のラーグさんとても可愛くてまだきました><！\n今回は、イース９のアドルとジュールが（アルタゴ公国での）冒険についての本の会話をしているシーンをお願いします。具体的な服飾やポーズや表情はお任せ致します。\n（風竜ム＝アンティさまに飲み込まれたアドルたちの話とかw）\n\n\n以下は参考のリンクです。\nhttps://drive.google.com/drive/folders/1reZRSWNjYToj94JypyJzcv14fmEMvg38?usp=sharing\n\n依頼を検討していただければ幸いです。ありがとうございました。\n前回と同じく、もし何か問題があれば遠慮なくキャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1reZRSWNjYToj94JypyJzcv14fmEMvg38?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/23", "thumbnail_src": "https://si.imgix.net/a95cec71/uploads/origins/3d41dc8a-f054-4e96-a5f7-f8f8725fc262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665855503448935fbad3b763587793f1", "thumbnail_srcset": "https://si.imgix.net/a95cec71/uploads/origins/3d41dc8a-f054-4e96-a5f7-f8f8725fc262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=665855503448935fbad3b763587793f1, https://si.imgix.net/a95cec71/uploads/origins/3d41dc8a-f054-4e96-a5f7-f8f8725fc262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e7228f241dc21f70a7b21dc8f7d6490 2x, https://si.imgix.net/a95cec71/uploads/origins/3d41dc8a-f054-4e96-a5f7-f8f8725fc262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b6c5e23b080eed3b3cd34d699c0b647 3x", "genre": "art", "nsfw": false, "body": "GEORGE様はじめまして！いつも先生が描いたイースと軌跡のイラストを見るたびに「なんと素敵な絵…」と思って感動しました！もしよかったら、イースXのラーグの立ち絵を描いていただけないでしょうか？\n\n\n\n→衣装の参考はこちらのリンクに。\nhttps://drive.google.com/drive/folders/1fgKo8_3QUZ8-LqD7Y9c-7mjFBemt3HLg?usp=sharing\n*このリンクにのるイースX本来の衣装とオリジナル衣装、どちらもオーケーなのです。\n\n→ポーズと表情：\n一部のポーズ参考はリンクにある。具体的なポーズや表情は、自由に描いていただけたら幸いです。\n\n→簡単な背景について：青い花 or 雲 or カラスとか\n\n\n\n→使用について\n＞　個人観賞とSNSでのアイコンなど、使用許可いただけると嬉しいです。\n＞　グッズ販売と販売ことはしない。\n\n\n依頼を検討していただければ幸いです。よろしくお願いします！\nもし何か問題があれば、遠慮なくキャンセルしてもいいのです。\n\nhttps://drive.google.com/drive/folders/1fgKo8_3QUZ8-LqD7Y9c-7mjFBemt3HLg?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/22", "thumbnail_src": "https://si.imgix.net/83266c25/uploads/origins/f68b85a5-5db8-4e80-9777-e777269aff02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c9aa77319d492090b385e0141a5b10", "thumbnail_srcset": "https://si.imgix.net/83266c25/uploads/origins/f68b85a5-5db8-4e80-9777-e777269aff02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73c9aa77319d492090b385e0141a5b10, https://si.imgix.net/83266c25/uploads/origins/f68b85a5-5db8-4e80-9777-e777269aff02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab9462d48c801bb281540125478337d3 2x, https://si.imgix.net/83266c25/uploads/origins/f68b85a5-5db8-4e80-9777-e777269aff02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=846f00a8cf8ebf2304bd329ab04be208 3x", "genre": "art", "nsfw": false, "body": "こんにちは！簡単なリクエストなのですが、『うたわれるもの』のハクはいかがでしょう？https://static.wikianocookie.net/utawareru/images/0/0f/Utawarerumono-Haku-Version-01.jpg/revision/latest/scale-to-width-down/284?cb=20160716232444 \n\nただし、衣装は『真・女神転生IV』のフリンのものにしてください：https://megatenwiki.com/images/d/d8/SMT4_Flynn_Artwork.pngただし、剣ではなく戦扇を持っている姿で描いてください。もし剣を持っている場合は、鞘に収めた状態で描いてください。", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/21", "thumbnail_src": "https://si.imgix.net/36b45886/uploads/origins/73dcd8bf-9634-47f7-af89-5de3b6b4be70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16fdea4a1acc5e3859b612c3340ac850", "thumbnail_srcset": "https://si.imgix.net/36b45886/uploads/origins/73dcd8bf-9634-47f7-af89-5de3b6b4be70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16fdea4a1acc5e3859b612c3340ac850, https://si.imgix.net/36b45886/uploads/origins/73dcd8bf-9634-47f7-af89-5de3b6b4be70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc2d8942290091baa3f554bc3b617870 2x, https://si.imgix.net/36b45886/uploads/origins/73dcd8bf-9634-47f7-af89-5de3b6b4be70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f83e798073db1f0a204015487431944b 3x", "genre": "art", "nsfw": false, "body": "こんにちは！\nあなたの作品はとても素敵です。\n『ハリー・ポッター』のカップリング、ルシウス・マルフォイとハーマイオニー・グレンジャーのファンアートを委託したいです。（J.K.ローリングは二次創作を認めています）\n\nルシウス・マルフォイ\n身長: 183cm\n髪の色: プラチナブロンド (薄金色)\n瞳の色: グレー\n性格: 狡猾で傲慢、そして偏屈な性格。洗練された裕福な純血の魔法使いとして振る舞うが、その本性は残忍で二枚舌、権力欲に駆られたものであることが露呈する。\n\nハーマイオニー・グレンジャー\n身長: 165cm\n髪の色: ボサボサの茶髪（豊かでモジャモジャ）\n瞳の色: 茶色\n性格: 類まれな知性、揺るぎない忠誠心、そして強い正義感\n\n関係性:\nストックホルム症候群、愛憎関係、監禁状態\n\nキャラ設定はURLを参照してください\n雰囲気や構図等はお任せ致します\n服装等、細かいデザインは描きやすいように一部変更して頂いても大丈夫です\nもし金額が足りないのであれば、適当な金額でのアピールをお願いします。\n\nhttps://drive.google.com/drive/folders/1TZ1kQIzMLNaUUMgGq1M26splwqIR0maM?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/20", "thumbnail_src": "https://si.imgix.net/598ab4dd/uploads/origins/6445225a-80e3-426b-98f2-5817b1a81dfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a228ad4755dfb39fec2d936b7c79657b", "thumbnail_srcset": "https://si.imgix.net/598ab4dd/uploads/origins/6445225a-80e3-426b-98f2-5817b1a81dfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a228ad4755dfb39fec2d936b7c79657b, https://si.imgix.net/598ab4dd/uploads/origins/6445225a-80e3-426b-98f2-5817b1a81dfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16c77e1d20696da0aa3d21212ee5883f 2x, https://si.imgix.net/598ab4dd/uploads/origins/6445225a-80e3-426b-98f2-5817b1a81dfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef3f3994e3faa150c15b673ea38bccd9 3x", "genre": "art", "nsfw": false, "body": "こんにちは！今回は、玉瀬美紀とアリサ・ラインフォードがアーチェリーで競い合い、タケルとリーンが二人を応援するというものです。\n\n玉瀬：https://static.wikia.nocookie.net/muvluv/images/3/3e/Miki_School.png/revision/latest?cb=20210913224329\n玉瀬アーチェリー衣装：https://imgur.com/a/qSVQRi0\n\nタケル：https://static.wikia.nocookie.net/muvluv/images/5/53/Takeru_AF_Casual.png/revision/latest?cb=20150707234844\n\nアリサ......もしよかったら、アーチェリー衣装のバージョンとお揃いにしてもいいですか？", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/19", "thumbnail_src": "https://si.imgix.net/792bc31d/uploads/origins/ed88c855-800b-46cb-92f5-e3e9de139374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0886e4218b89fdf4794a3cf74622bd9f", "thumbnail_srcset": "https://si.imgix.net/792bc31d/uploads/origins/ed88c855-800b-46cb-92f5-e3e9de139374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0886e4218b89fdf4794a3cf74622bd9f, https://si.imgix.net/792bc31d/uploads/origins/ed88c855-800b-46cb-92f5-e3e9de139374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebc0d6b17b30149c87ce6959656d9c29 2x, https://si.imgix.net/792bc31d/uploads/origins/ed88c855-800b-46cb-92f5-e3e9de139374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cceba79428cd4d03cbc3eb14472efa28 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの絵が大好きで、しばらくあなたをフォローしていました。\n\n私と友人の結婚しているFF14キャラクターの絵をお願いしたいです。 (https://imgur.com/a/sora-shizuna-YrLCnqn)\n\n花火の前で楽しそうにピースサインをしている参考のポーズをアレンジしたいです。\n\nよろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/18", "thumbnail_src": "https://si.imgix.net/4eda9270/uploads/origins/5a289d47-f0ac-4ff6-ba7c-38c561a97954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17e50ddb792831a0745a13e4f1c24971", "thumbnail_srcset": "https://si.imgix.net/4eda9270/uploads/origins/5a289d47-f0ac-4ff6-ba7c-38c561a97954?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17e50ddb792831a0745a13e4f1c24971, https://si.imgix.net/4eda9270/uploads/origins/5a289d47-f0ac-4ff6-ba7c-38c561a97954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da6e01f8971481b2223e0c21f55f36b9 2x, https://si.imgix.net/4eda9270/uploads/origins/5a289d47-f0ac-4ff6-ba7c-38c561a97954?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cb1571652f48acad4398cb855115f08 3x", "genre": "art", "nsfw": false, "body": "こんにちは、私はあなたの絵がとても好きです！\nマブラヴオルタネイティヴの加賀見澄香役の東海帝王（ウマ娘）の絵をお願いしたいです。\n衣装は澄香のUNドレスでお願いします。(参考画像）\n表情は、首を傾げ、自信に満ちた暖かい笑顔のようなもの。\nその他はお任せします。\nまた、もしよろしければ追加でお願いがあります。ポニーテールではなく、帝王の髪を下ろして、澄香のように大きな黄色いリボンで後ろで結ぶというバリエーションも追加でお願いしたいです。(参考画像も一緒に）。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1ijdmwAcaZWtieiTF3vsAJg038fZm-Z-4?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/17", "thumbnail_src": "https://si.imgix.net/0a1eb0c6/uploads/origins/dde0d6f9-cc7e-47ba-a65f-b70e7bcef8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c82e070e75a61640be165b21c76f54", "thumbnail_srcset": "https://si.imgix.net/0a1eb0c6/uploads/origins/dde0d6f9-cc7e-47ba-a65f-b70e7bcef8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77c82e070e75a61640be165b21c76f54, https://si.imgix.net/0a1eb0c6/uploads/origins/dde0d6f9-cc7e-47ba-a65f-b70e7bcef8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=459426db3291fffd8694fa1f3af46dc2 2x, https://si.imgix.net/0a1eb0c6/uploads/origins/dde0d6f9-cc7e-47ba-a65f-b70e7bcef8b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b312eeea71f390ec8c08faaf28d011e5 3x", "genre": "art", "nsfw": false, "body": "可能であれば、またリクエストを出したいと思っています。\n\n添付資料のような服装でクルトとジュナを描いていただけないでしょうか？\n\nhttps://drive.google.com/file/d/1TnxyO0EfPtGHRo1zXWPuEJQDJIvXw5dI/view?usp=sharing\n\n必要であれば、妥当と思われる価格設定に調整をお願いします。\n\n私の要望を考慮していただき、ありがとうございました。\n\nhttps://drive.google.com/file/d/1TnxyO0EfPtGHRo1zXWPuEJQDJIvXw5dI/view?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/16", "thumbnail_src": "https://si.imgix.net/21f024fb/uploads/origins/44f41911-b341-4794-8916-1b4ea8ae7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b55efd863697ee76274f084ad66773d9", "thumbnail_srcset": "https://si.imgix.net/21f024fb/uploads/origins/44f41911-b341-4794-8916-1b4ea8ae7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b55efd863697ee76274f084ad66773d9, https://si.imgix.net/21f024fb/uploads/origins/44f41911-b341-4794-8916-1b4ea8ae7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96af66cf5581af4ce2f0aa5cb5fb062e 2x, https://si.imgix.net/21f024fb/uploads/origins/44f41911-b341-4794-8916-1b4ea8ae7d3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f8f6028c731b904ed3da1036f0cb9a7 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたにアート作品を依頼したいのですが。\nヴァン・アクライドとエレーヌ・オークレアが一緒に立って、微笑んで笑っていて、エレーヌが彼の腕をこんな風に掴んでいるところを見たいんです：\nhttps://www.shutterstock.com/shutterstock/photos/2190897327/display_1500/stock-photo-affectionate-girlfriend-holding-hand-and-resting-head-on-boyfriend-s-shoulder-while-walking-on-2190897327.jpg\n\nエレーヌは緑のドレスを着ている。緑色はここでの彼女の衣装と同じです： https://static.wikia.nocookie.net/kiseki/images/a/a7/Elaine_Auclair_%28Kuro%29.png。\n\nドレスはこれと同じようなスタイルのものであるべきだ。https://i.ebayimg.com/images/g/WNYAAOSwRT5lK1Tb/s-l1200.jpg。\n\nヴァンはこの画像のようなフォーマルなスーツとネクタイを着用している: https://pbs.twimg.com/media/FplCwPmXwAE6G4m.jpg\n\n背景は、あなたの他の作品（https://skeb.jp/@63adol/works/13）と多少似ていて、星空のある夜空であること。", "created_at": "", "completed_at": ""}, {"path": "/@63adol/works/15", "thumbnail_src": "https://si.imgix.net/21dafb80/uploads/origins/3d810c26-a0b3-444d-9c28-210e0dd4f31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2145b472686a56b665822b6199eef6c2", "thumbnail_srcset": "https://si.imgix.net/21dafb80/uploads/origins/3d810c26-a0b3-444d-9c28-210e0dd4f31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=