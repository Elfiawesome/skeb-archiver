-26fc-4b1e-82cb-2d247437a0db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c16efe0e9e850ba98f1c700953784e, https://si.imgix.net/060c07d7/uploads/origins/52f51916-26fc-4b1e-82cb-2d247437a0db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3782274b0eece627e467cf19b3cd927 2x, https://si.imgix.net/060c07d7/uploads/origins/52f51916-26fc-4b1e-82cb-2d247437a0db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9adcc03da79c228d7a113792868db753 3x", "genre": "art", "nsfw": false, "body": "◆全体\n資料URLのキャラ（ウェブゲームのマイキャラ）、猫夜敷・千舞輝を描いて頂きたいです\n\n◆キャラ設定\nだらだらするのが好き\nゲームする・コスプレするのが趣味\n猫っぽいけど人間\n\n◆描写内容\n外見は外見資料を参照で、\n服装は服装資料のもの、またはアレンジ衣装で、\nシチュエーション・雰囲気等はお任せでお願いします\n\nよろしくお願いします！\n\n外見資料\nhttp://cdn.tw5.jp/i/tw5/origin/2586/730525_e25868_model_sheet_f.jpg\n服装資料\nhttps://cdn.tw5.jp/i/tw5/origin/2586/996807_e25868_totalbody.png", "created_at": "", "completed_at": ""}, {"path": "/@dadadanodadada/works/213", "thumbnail_src": "https://si.imgix.net/3620302d/uploads/origins/9d0b694e-c309-4733-80f1-6c7c9a83bb07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6cdca9b3b8fc13d5138909c71856db0", "thumbnail_srcset": "https://si.imgix.net/3620302d/uploads/origins/9d0b694e-c309-4733-80f1-6c7c9a83bb07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6cdca9b3b8fc13d5138909c71856db0, https://si.imgix.net/3620302d/uploads/origins/9d0b694e-c309-4733-80f1-6c7c9a83bb07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=970d116d13611e1b00457cb707a29b52 2x, https://si.imgix.net/3620302d/uploads/origins/9d0b694e-c309-4733-80f1-6c7c9a83bb07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4354d2cd5e17f7f1e9d5768f6078e99b 3x", "genre": "art", "nsfw": true, "body": "お疲れ様です！今回はうちの子の桃香ちゃんの水着姿を描いて頂きたくリクエストさせて頂きます！\nキャラクター\n妖瀬桃香\n人とサキュバスのハーフ普段は真面目だが先輩に対しては少々生意気\n水着\nビキニ姿でサキュバスっぽいデザインが付いていると嬉しいです\nおっぱいはビキニの下の部分も分かるようにアストルフォ桃香ちゃんの時のようなサイズにして下さい(本当はもっと欲しいですが…)\nどうかよろしくお願いします！\n\nhttps://www.dropbox.com/scl/fo/g801045z75uiel0zj139x/AFSmwDCbH8Jwt8RBR2YT_9I?rlkey=0qjcjekyf2h5hr3hyv4yqln99&st=0f9blf4l&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@dadadanodadada/works/212", "thumbnail_src": "https://si.imgix.net/810ba257/uploads/origins/95432015-6456-427f-a804-9dde5eb1f6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03024fae4ddb13e9fbe5b4c99c6e73c7", "thumbnail_srcset": "https://si.imgix.net/810ba257/uploads/origins/95432015-6456-427f-a804-9dde5eb1f6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03024fae4ddb13e9fbe5b4c99c6e73c7, https://si.imgix.net/810ba257/uploads/origins/95432015-6456-427f-a804-9dde5eb1f6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9cdefa0bee109c494a8367b3a0c29de 2x, https://si.imgix.net/810ba257/uploads/origins/95432015-6456-427f-a804-9dde5eb1f6f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=259b63cabf65aed41edc93cb36836469 3x", "genre": "art", "nsfw": true, "body": "お世話になっております。\n東方Projectの聖白蓮の膨乳イラストをお願いしたいです。\n膨乳後の乳房の大きさはこのくらい（https://skeb.jp/@dadadanodadada/works/201）でよろしくお願いいたします。\nまた、可能であれば衣装の胸元の黒紐が食い込んだ差分と、乳房が露出した差分があると嬉しいです。\nご検討よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@dadadanodadada/works/211", "thumbnail_src": "https://si.imgix.net/3ac656fd/uploads/origins/f4a16d63-9913-427b-a1d8-a596300ee967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd92759d1b4b3b166d64bb50423ce38", "thumbnail_srcset": "https://si.imgix.net/3ac656fd/uploads/origins/f4a16d63-9913-427b-a1d8-a596300ee967?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bdd92759d1b4b3b166d64bb50423ce38, https://si.imgix.net/3ac656fd/uploads/origins/f4a16d63-9913-427b-a1d8-a596300ee967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=683fd5d366228f661284ee7badc02019 2x, https://si.imgix.net/3ac656fd/uploads/origins/f4a16d63-9913-427b-a1d8-a596300ee967?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd5a00a26368264cc28a6c6bcd7589bb 3x", "genre": "art", "nsfw": true, "body": "こんにちは\n\nグレンラガンの若いヨーコ（タイムスキップ前）のイラストをお願いできますか？ 巨乳で描いてください！ ポーズはお任せします\n胸のサイズ:https://skeb.jp/@dadadanodadada/works/198\n\nありがとうございます!\n\nhttps://gurrenlagann.fandom.com/wiki/Yoko_Littner/Gallery", "created_at": "", "completed_at": ""}, {"path": "/@dadadanodadada/works/210", "thumbnail_src": "https://si.imgix.net/2cab7c6e/uploads/origins/40661f03-65fd-4067-a5d2-7bd64b786a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fea12e8600ab5994ef95f51f2d34aafe", "thumbnail_srcset": "https://si.imgix.net/2cab7c6e/uploads/origins/40661f03-65fd-4067-a5d2-7bd64b786a48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fea12e8600ab5994ef95f51f2d34aafe, https://si.imgix.net/2cab7c6e/uploads/origins/40661f03-65fd-4067-a5d2-7bd64b786a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8765d6d430000acee47c8e00ee441f0c 2x, https://si.imgix.net/2cab7c6e/uploads/origins/40661f03-65fd-4067-a5d2-7bd64b786a48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bd46fca285b859ff094abb8a7b06e7a 3x", "genre": "art", "nsfw": true, "body": "初めまして。いにゃばと申します。\nうちの子の依頼をさせていただきたいと思います。\nもしご都合が合いましたらよろしくお願いいたします。\n\n【作品】オリジナル\n【キャラクター】モカ・ルミリア(モカちゃん)\n【資料】https://www.pixiv.net/artworks/126751380\n\n【特徴】\n・性格はのんき\n・カフェを経営している\n・胸元は露出多めで割と無防備\n\n胸のサイズはこれくらいあると嬉しいです(さらに盛っていただいても大丈夫です)https://skeb.jp/@dadadanodadada/works/191\n\nその他細かい部分や背景、構図などはお任せします。\nご検討のほど、よろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@dadadanodadada/works/209", "thumbnail_src": "https://si.imgix.net/bae28fa7/uploads/origins/cf073846-0638-4088-b05b-0f5ca64c2839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50f94a51cdc4bd3364041d07cfa5c95f", "t