u9w0q_fMrYrvEFQBV0?usp=sharing\n\nhttps://drive.google.com/drive/folders/1WZum8vhQBVyvPGu9w0q_fMrYrvEFQBV0?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@ura_green_san/works/30", "thumbnail_src": "https://si.imgix.net/251b852a/uploads/origins/be867f95-041b-42eb-bc42-d01562d86968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a5da30dd1163d64287df4f6b5ca55c8", "thumbnail_srcset": "https://si.imgix.net/251b852a/uploads/origins/be867f95-041b-42eb-bc42-d01562d86968?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a5da30dd1163d64287df4f6b5ca55c8, https://si.imgix.net/251b852a/uploads/origins/be867f95-041b-42eb-bc42-d01562d86968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a7f56493f827fbfa3694f9d4398b53a 2x, https://si.imgix.net/251b852a/uploads/origins/be867f95-041b-42eb-bc42-d01562d86968?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abb21be859f62a2faece4fb9ba7625cc 3x", "genre": "art", "nsfw": false, "body": "こんにちは ! I love your artstyle and I would like to support you by ordering a commission !\n\nI would love you to draw my character/persona. Yukito is an alien catboy (he loves anything related to space and note that he always has soft expressions, see reference)\n\nI would like Glavolia to be part of it (they are very good friends). It's her birthday please can you make a heartwarming scenery ? for september 17th 2022\n\nHere are their designs (please use Yukito's 2021 PNG as reference for his design) :\n\nYukito : https://drive.google.com/drive/folders/1W1F8EXF2jMeSrgLcp6ZQRGYp-nnsJ3qd?usp=sharing\nGlavolia and POSE + render inspirations : https://drive.google.com/drive/folders/1y5-XnxgaMMtf_zCe-ZKQN9T-os5jsEt9?usp=sharing\n\nCould you add a background with bokeh lights ? similar to the POSE INSPIRATION scenery ? at night!\n\nThank you if you end up taking my order !", "created_at": "", "completed_at": ""}, {"path": "/@ura_green_san/works/29", "thumbnail_src": "https://si.imgix.net/ccd7165b/uploads/origins/2d22c76b-e278-44a3-b0da-7a55f3c9075d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8bae6356f4a723daef9280a05afd329", "thumbnail_srcset": "https://si.imgix.net/ccd7165b/uploads/origins/2d22c76b-e278-44a3-b0da-7a55f3c9075d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8bae6356f4a723daef9280a05afd329, https://si.imgix.net/ccd7165b/uploads/origins/2d22c76b-e278-44a3-b0da-7a55f3c9075d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65df641e9fbf3a97d49fa79265e094a9 2x, https://si.imgix.net/ccd7165b/uploads/origins/2d22c76b-e278-44a3-b0da-7a55f3c9075d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6156fc29a075a494960967b48f704d0 3x", "genre": "art", "nsfw": false, "body": "あなたのアートは素晴らしいです。私のキャラクターAceのアートをお願いしたいのですが、彼はインクに支配されたタトゥーアーティストです。\n自由に創造して、好きなように描いてください。ありがとうございます。\nhttps://prnt.sc/HsQrRllnu4AC", "created_at": "", "completed_at": ""}, {"path": "/@ura_green_san/works/28", "thumbnail_src": "https://si.imgix.net/9ecb6a44/uploads/origins/7e43451d-86e9-4e8a-adc6-59e771ccd750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3c7a29e02d5cc8fdac0264e9cdc65dc", "thumbnail_srcset": "https://si.imgix.net/9ecb6a44/uploads/origins/7e43451d-86e9-4e8a-adc6-59e771ccd750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3c7a29e02d5cc8fdac0264e9cdc65dc, https://si.imgix.net/9ecb6a44/uploads/origins/7e43451d-86e9-4e8a-adc6-59e771ccd750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce5ff84f8086ef10d6a6b9732be98c12 2x, https://si.imgix.ne