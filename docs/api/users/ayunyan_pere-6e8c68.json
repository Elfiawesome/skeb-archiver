%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a9d536524e32ad425eab1cf9f6c5bc", "thumbnail_srcset": "https://si.imgix.net/6981f573/uploads/origins/7abc5a05-1036-4ca0-a862-0424383937aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a9d536524e32ad425eab1cf9f6c5bc, https://si.imgix.net/6981f573/uploads/origins/7abc5a05-1036-4ca0-a862-0424383937aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32ef5f871b4c9f102a334df8a30961d7 2x, https://si.imgix.net/6981f573/uploads/origins/7abc5a05-1036-4ca0-a862-0424383937aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e72f5125260f422598c29cd8399269f 3x", "genre": "art", "nsfw": false, "body": "アニメ「キラッとプリ☆チャン」の白鳥アンジュさんと七星あいらさんのイラストをお願いします。\n夏の日のデートというイメージでご自由にお描きいただきたく存じます。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/63", "thumbnail_src": "https://si.imgix.net/b1daa605/uploads/origins/fbbebc71-4db9-43c2-a88a-f870b0b4f200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7b448ef4cf7c8fea01d0f4d8232fa7", "thumbnail_srcset": "https://si.imgix.net/b1daa605/uploads/origins/fbbebc71-4db9-43c2-a88a-f870b0b4f200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f7b448ef4cf7c8fea01d0f4d8232fa7, https://si.imgix.net/b1daa605/uploads/origins/fbbebc71-4db9-43c2-a88a-f870b0b4f200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8bc42d4fd317aa66b62d2ecef17bf07 2x, https://si.imgix.net/b1daa605/uploads/origins/fbbebc71-4db9-43c2-a88a-f870b0b4f200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfeef6aee3c14021d7e7093b513e5619 3x", "genre": "art", "nsfw": false, "body": "ちとせちゃんとクラリスさんのラブラブな百合をお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/62", "thumbnail_src": "https://si.imgix.net/33a62824/uploads/origins/7d80c572-22ee-467e-9e00-a6618a21e552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1f08ef12e2e7ac29ef96e81ffa32fab", "thumbnail_srcset": "https://si.imgix.net/33a62824/uploads/origins/7d80c572-22ee-467e-9e00-a6618a21e552?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1f08ef12e2e7ac29ef96e81ffa32fab, https://si.imgix.net/33a62824/uploads/origins/7d80c572-22ee-467e-9e00-a6618a21e552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96ecdb2d8cbecd960feac38e6011ab00 2x, https://si.imgix.net/33a62824/uploads/origins/7d80c572-22ee-467e-9e00-a6618a21e552?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ac9e8e9a46f8db321a05e252e95d727 3x", "genre": "art", "nsfw": false, "body": "キャラ:アイドルマスターシンデレラガールズ\n城ヶ崎美嘉\nにて描いていただけますと幸いです。\n制服でギャルっぽい立ち絵だと嬉しいです", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/61", "thumbnail_src": "https://si.imgix.net/e17297f8/uploads/origins/0cf72dd8-61d2-4171-b711-0c92c824b497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e34689dd14ae8feab591797388d504bc", "thumbnail_srcset": "https://si.imgix.net/e17297f8/uploads/origins/0cf72dd8-61d2-4171-b711-0c92c824b497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e34689dd14ae8feab591797388d504bc, https://si.imgix.net/e17297f8/uploads/origins/0cf72dd8-61d2-4171-b711-0c92c824b497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17830481932eccf6b2dd9c30de6fd5e4 2x, https://si.imgix.net/e17297f8/uploads/origins/0cf72dd8-61d2-4171-b711-0c92c824b497?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d74cb033478d5c750a652c31d6366164 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！コミックの依頼になります！\n【キャラ】\n黒埼ちとせ、クラリス\n【内容】\nちとせちゃんとクラリスさんが2人だけで結婚式を挙げるお話をお願いします。\n式場で結婚式を挙げているところに通りかかった買い物中の2人、しばらく見惚れている。\nちとせ「私たちも結婚式しちゃおうか、クラリスさんの通ってる教会でできない？」\nクラリス「小さな教会ですので…」\nちとせ「2人きりなら大丈夫じゃない」\n教会に許可をとり皆が寝静まった夜に2人だけの結婚式を挙げる。お互いにウェディングドレスに身を包み、しばらく見惚れあった後「そろそろはじめようか」と神父さんの服を着せたしゃべるぴにゃ人形をテーブルに置き録音した誓いの言葉を流し始める。\n過去、いつかの前世では異端の同性愛と迫害や拷問をされ来世での邂逅を誓い教会のこの場所で毒を飲んで眠る2人の記憶がフラッシュバックするクラリスさん、しばらくして心配そうにこちらを見つめるちとせに気がつき既に録音した誓いの言葉が流れ終わってることに気がつく。ハッとしちとせの手をつかむクラリスさん「わ、私はっ…！健やかなるときも、病めるときも…どんな事があろうとちとせさんを愛することを誓います！」ちとせはしばらくキョトンと驚いた顔をした後笑顔で「では誓いのキスを…」2人は誓いのキスを交わす。\n以上の内容となります。\n最近は他の活動も積極的になされており忙しいと思われますがご検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/60", "thumbnail_src": "https://si.imgix.net/7bb61a3a/uploads/origins/1fe0edcc-952d-4b11-8215-874cb4906080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2bbfe819dca80436fd33a96ce39328", "thumbnail_srcset": "https://si.imgix.net/7bb61a3a/uploads/origins/1fe0edcc-952d-4b11-8215-874cb4906080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2bbfe819dca80436fd33a96ce39328, https://si.imgix.net/7bb61a3a/uploads/origins/1fe0edcc-952d-4b11-8215-874cb4906080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=027f2e7b8107aebb5698797d98651b09 2x, https://si.imgix.net/7bb61a3a/uploads/origins/1fe0edcc-952d-4b11-8215-874cb4906080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=877ebed1435389662881f832c63410f1 3x", "genre": "art", "nsfw": false, "body": "リクエスト失礼します。\nアイドルマスターシンデレラガールズの星輝子と北条加蓮をお願いします。\n\nキャラ : 星輝子、北条加蓮\n\n輝子の衣装  :  白いタートルネックセーター\n加蓮の衣装  :  黒いタートルネックセーター\n\n二人共ポーズは片手で指ハートをしている姿でお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/59", "thumbnail_src": "https://si.imgix.net/a0bdc9db/uploads/origins/4acf2976-0f0c-492c-8d9d-be496601d520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec99e4e7798e48692707b75d4fded150", "thumbnail_srcset": "https://si.imgix.net/a0bdc9db/uploads/origins/4acf2976-0f0c-492c-8d9d-be496601d520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec99e4e7798e48692707b75d4fded150, https://si.imgix.net/a0bdc9db/uploads/origins/4acf2976-0f0c-492c-8d9d-be496601d520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9acb91f1c860bfb41f06915492a552ac 2x, https://si.imgix.net/a0bdc9db/uploads/origins/4acf2976-0f0c-492c-8d9d-be496601d520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8d68edfc3780c7c20efb1589c3b1528 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/58", "thumbnail_src": "https://si.imgix.net/95d1833d/uploads/origins/9689809c-2118-41d5-87cc-f37e7ff09335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d851030b74cfe11ca5824d5c1df2e71c", "thumbnail_srcset": "https://si.imgix.net/95d1833d/uploads/origins/9689809c-2118-41d5-87cc-f37e7ff09335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d851030b74cfe11ca5824d5c1df2e71c, https://si.imgix.net/95d1833d/uploads/origins/9689809c-2118-41d5-87cc-f37e7ff09335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=322ddea45cd2bddc3290a58b2541553c 2x, https://si.imgix.net/95d1833d/uploads/origins/9689809c-2118-41d5-87cc-f37e7ff09335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f24329c793c37e9d546fb971455845d2 3x", "genre": "comic", "nsfw": false, "body": "こんにちは！コミックの依頼になります！\n【キャラ】\n黒埼ちとせ、クラリス、その他\n【内容】\n一人で晩酌するクラリスさん、ちとせの特集が載ってる雑誌をめくりながら加蓮ちゃんと手を繋いだり(ローゼンティアーズ)蘭子ちゃんに抱きかかえられたり(フォルトゥナレジーナ)してる姿を見て仕事とわかってても悶々としてるクラリスさん。スマホの通知には「もうすぐ帰ります」というメッセージと「今日は志希ちゃんと水着の撮影！」とオフショットが添えられていて更に悶々としている。遅く帰宅したちとせに「何時だと思っているのです、あなたはまだ学生なんですから」と酔って説教臭くなるクラリスさんに「ごめんなさーい」とトホホな感じで謝るちとせの首元に赤い跡を見つけて襟を肩まで下げて「これはなんですか」と詰め寄るクラリスさん。「志希ちゃんに吸血したら仕返しの吸血されちゃって～」と冗談交じりにいうちとせに悶々ポイントが突破したクラリスさん。ちとせを寝室まで連れていきベッドに投げ飛ばし唖然としているちとせに「あなたが誰のものなのか教育が必要みたいですね」と襲いかかるクラリスさん。\n翌日ベッドで爆睡するちとせと酔いが冷めて体中キスマークと噛み跡、引っかき傷だらけの自分の体を見て「やってしまった」と青ざめるクラリスさん。\n\n以上の内容で可能でしたらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/57", "thumbnail_src": "https://si.imgix.net/8bec8afe/uploads/origins/04a8b613-948d-463e-81a6-924269a77eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c3b6bee420b3c9038da87980114c92b", "thumbnail_srcset": "https://si.imgix.net/8bec8afe/uploads/origins/04a8b613-948d-463e-81a6-924269a77eea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c3b6bee420b3c9038da87980114c92b, https://si.imgix.net/8bec8afe/uploads/origins/04a8b613-948d-463e-81a6-924269a77eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a05e53bcea7af77d7bfa3141c6ef33b 2x, https://si.imgix.net/8bec8afe/uploads/origins/04a8b613-948d-463e-81a6-924269a77eea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ac440844b7aaeec734e2065d499d11c 3x", "genre": "art", "nsfw": false, "body": "こんにちは！イラストの依頼です。\n【キャラ】\n黒埼ちとせ\n【内容】\nもうすぐバレンタインなので二宮飛鳥ちゃんの衣装(パレスオブファンタジア)を着たちとせちゃんをお願いします！\n後ろにちとせちゃんの衣装借りたけど胸がブカブカでなんとも言えない顔をしてるミニ飛鳥ちゃんがいると嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/56", "thumbnail_src": "https://si.imgix.net/19d3107a/uploads/origins/3c042843-d96b-42c5-87a0-d683a98a7191?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc47abe5c667d1963b36aedf366ac1f9", "thumbnail_srcset": "https://si.imgix.net/19d3107a/uploads/origins/3c042843-d96b-42c5-87a0-d683a98a7191?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc47abe5c667d1963b36aedf366ac1f9, https://si.imgix.net/19d3107a/uploads/origins/3c042843-d96b-42c5-87a0-d683a98a7191?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbf0758e1fdf0b78f559907664df7de8 2x, https://si.imgix.net/19d3107a/uploads/origins/3c042843-d96b-42c5-87a0-d683a98a7191?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d5a693dae148a405a42ebc6f37b8ef9 3x", "genre": "art", "nsfw": false, "body": "前回ジャージ姿トワイデを依頼させていただいた者です\nその節は誠にありがとうございました！\n\n今回はメイド服のトワイライト//イデアのイラストをお願いいたします！\n服装と構図は下記の感じです\n\n〇二宮飛鳥\n　コスプレ感のあるゴスロリ系ミニスカメイド服\n〇南条光\n　クラシカルな感じのロングスカートメイド服\n〇構図\n　いわゆる片思いハートで！\n　南条光が全力の👍サイン\n　二宮飛鳥はクールにピースハート決めてる感じで\n　どっちもキメ顔なのにズレてる感が出てるとうれしいです！\n\nご確認のほど何卒お願いします！\n\nhttps://x.com/iamrosema/status/886650823677140992?s=20", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/55", "thumbnail_src": "https://si.imgix.net/487c5af1/uploads/origins/23c102bb-e7ce-40c5-a5e0-823ea8ef33ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eb234257aaf5007362a0dd77e755535", "thumbnail_srcset": "https://si.imgix.net/487c5af1/uploads/origins/23c102bb-e7ce-40c5-a5e0-823ea8ef33ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eb234257aaf5007362a0dd77e755535, https://si.imgix.net/487c5af1/uploads/origins/23c102bb-e7ce-40c5-a5e0-823ea8ef33ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf71a31458d5bb43672f8e45d6da78fb 2x, https://si.imgix.net/487c5af1/uploads/origins/23c102bb-e7ce-40c5-a5e0-823ea8ef33ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aa3f8430491e611a3654cbf796fea4a 3x", "genre": "art", "nsfw": false, "body": "こんにちは！イラストの依頼になります\n【キャラ】\n黒埼ちとせ、クラリス\n【内容】\n来月が誕生日なので2人が祝ってくれるイラストをお願いしたいです！\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/54", "thumbnail_src": "https://si.imgix.net/b99fd91b/uploads/origins/d4c2c80b-790d-4612-8d03-4768dc9696da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=298042478683dc995119affb9b04def6", "thumbnail_srcset": "https://si.imgix.net/b99fd91b/uploads/origins/d4c2c80b-790d-4612-8d03-4768dc9696da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=298042478683dc995119affb9b04def6, https://si.imgix.net/b99fd91b/uploads/origins/d4c2c80b-790d-4612-8d03-4768dc9696da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95692486c4488d9b50cd410e7ac30e6e 2x, https://si.imgix.net/b99fd91b/uploads/origins/d4c2c80b-790d-4612-8d03-4768dc9696da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e787bc542771fd16bd65e1a790b50c2 3x", "genre": "art", "nsfw": false, "body": "依頼させていただきます\n\nリク100で描かれていた南条光と結城晴のイラストがとても良かったので、\nホスト風に男装した2人のイラストをお願いしたいです\n\nよろしくお願いします", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/53", "thumbnail_src": "https://si.imgix.net/65f2f179/uploads/origins/a67c5c1d-773c-4bab-a1bf-9bf7b60ceef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7594da50e85c43e77621029cbd7094da", "thumbnail_srcset": "https://si.imgix.net/65f2f179/uploads/origins/a67c5c1d-773c-4bab-a1bf-9bf7b60ceef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7594da50e85c43e77621029cbd7094da, https://si.imgix.net/65f2f179/uploads/origins/a67c5c1d-773c-4bab-a1bf-9bf7b60ceef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68a1e7e249158f7740ed7492fc973644 2x, https://si.imgix.net/65f2f179/uploads/origins/a67c5c1d-773c-4bab-a1bf-9bf7b60ceef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d69898968489c993349f39204dfa4b04 3x", "genre": "art", "nsfw": false, "body": "こんにちは！イラストの依頼になります。\n【キャラ】\n黒埼ちとせ、クラリス\n【内容】\n別の世界でも愛し合ってた2人、幸せな時間は長くなく化け物と異端者として扱われて自らの手でちとせを葬り自身も処刑されてしまう。という悲しい夢を見て飛び起きるクラリスさん。隣に寝ているはずのちとせがいなくて探すとベランダで月を見ているちとせを見つける。涙が浮かんでるクラリスを見て怖い夢でも見た？と抱き寄せるちとせ。クラリスももう離さなすまいと抱き返す。\nしばらくして落ち着いてベッドに戻る2人、抱きしめられて熱っちゃったというちとせに理性の糸が切れてしまったクラリスが押し倒して唇、体とキスをしていく。\n翌日、水着の撮影があるのに全身キスマークだらけで隠すのに絆創膏だらけで怒られるちとせと隣で恥ずかしさと申し訳なさで顔を真っ赤にしてるクラリス。\n\n長くなりましたがご検討お願いします！", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/52", "thumbnail_src": "https://si.imgix.net/f0a73893/uploads/origins/ab1fc793-8b93-460c-a904-1020191c5cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da2a7aa0a8aaa778b6a713af810c2220", "thumbnail_srcset": "https://si.imgix.net/f0a73893/uploads/origins/ab1fc793-8b93-460c-a904-1020191c5cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da2a7aa0a8aaa778b6a713af810c2220, https://si.imgix.net/f0a73893/uploads/origins/ab1fc793-8b93-460c-a904-1020191c5cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2b6caf78f77162bce5ee948f17f053a 2x, https://si.imgix.net/f0a73893/uploads/origins/ab1fc793-8b93-460c-a904-1020191c5cc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5469e1fc28c738a8916c805668e1ff2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！イラスト(漫画)の依頼になります\n【キャラ】\n黒埼ちとせ・クラリス\n【内容】\n夜の夏祭りデート中、会場から少し離れた池の畔でホタルを見つけた二人。輝きに見とれながらも一生の中で成虫になった僅かな時間だけと自分に残された時間と重ね合わせてさみしげな表情をするちとせ、心配そうにみつめるクラリスさんに気づいて笑顔で誤魔化しながら「お祭りに戻ろう」と立ち上がるがバランスを崩して池の方へ倒れる、クラリスさんはちとせの名前を叫んで手をつかむが一緒に池に落ちてしまう。\n倒れたところは膝下くらいの浅いところで、クラリスさんがちとせを押し倒すような形になっている。\nお互いに浴衣が乱れて、ちとせが謝ろうとしたところをクラリスさんから唇を重ねてきて遮られる。\n花火が上がる中、唇が離れたあとクラリスさんから「たとえ一瞬の輝きでも私はその輝きを一生忘れません」とちとせに伝える。\n\n最後に落書きくらいでいいので濡れたあと二人でいちゃついてたから風邪引いてくしゃみしてる2人をお願いします。\n\n長くなってしまいましたが検討お願いします。", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/51", "thumbnail_src": "https://si.imgix.net/6d1e005a/uploads/origins/2f151350-a0a8-4b35-ace9-22bd2b613f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cceaf6da7acc6d85d8e59cc6250cdb16", "thumbnail_srcset": "https://si.imgix.net/6d1e005a/uploads/origins/2f151350-a0a8-4b35-ace9-22bd2b613f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cceaf6da7acc6d85d8e59cc6250cdb16, https://si.imgix.net/6d1e005a/uploads/origins/2f151350-a0a8-4b35-ace9-22bd2b613f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a152d4236b0ebcf8a629bc2115c7affa 2x, https://si.imgix.net/6d1e005a/uploads/origins/2f151350-a0a8-4b35-ace9-22bd2b613f0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2daba4c4f9d21b1752474443b888330 3x", "genre": "art", "nsfw": false, "body": "夏が暑過ぎて終わってるので\n日焼け対策の長袖長ズボンの芋ジャージで\n汗びしゃびしゃになりながらラジオ体操してるトワイライト//イデアがみたいです\n\n二宮飛鳥は緑色でちょっと着崩して\n南条光はあずき色で首元までぴっちりジッパー上げてる感じだと嬉しいです\n\nご確認お願いいたします！\n\nhttps://www.yamauchiya.info/products/detail1291.html", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/50", "thumbnail_src": "https://si.imgix.net/0bb8b885/uploads/origins/8a8d9a25-a491-4451-8f94-4162dc66b361?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a410db081b706cf367435b78364ffe7f", "thumbnail_srcset": "https://si.imgix.net/0bb8b885/uploads/origins/8a8d9a25-a491-4451-8f94-4162dc66b361?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a410db081b706cf367435b78364ffe7f, https://si.imgix.net/0bb8b885/uploads/origins/8a8d9a25-a491-4451-8f94-4162dc66b361?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fddca2599f6837b9b6789fd8f3d3006 2x, https://si.imgix.net/0bb8b885/uploads/origins/8a8d9a25-a491-4451-8f94-4162dc66b361?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5baf9c462e96216caacb29a1cef32a08 3x", "genre": "art", "nsfw": false, "body": "こんにちは、以前のリクエストに応えてくれてありがとう！\n\n私のオリジナルキャラクター \"志久千尋 \"の絵をお願いしたいです。  楽しいことが大好きで、口下手な女の子。趣味はローラーブレード、ファッション、手芸。  \n\n服装、ポーズ、構図は自由です。  \n\nありがとうございました！\n\nhttps://www.dropbox.com/scl/fo/4nn11vq3l7ja9aokon7aa/h?rlkey=bm0rqo2mvf6m772jlo6lx8699&dl=0", "created_at": "", "completed_at": ""}, {"path": "/@ayunyan_pere/works/49", "thumbnail_src": "https://si.imgix.net/17433305/uploads/origins/d8c440c7-907e-4566-946a-3bc4634bc740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d93a14a4c