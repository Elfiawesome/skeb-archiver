x.net/e543cd8e/uploads/origins/f569e7e7-83fb-4181-b136-d92537861034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46868cffb1b678de81cfdbdbcd4ebc1c, https://si.imgix.net/e543cd8e/uploads/origins/f569e7e7-83fb-4181-b136-d92537861034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6296faf7008f9704e87520e27f2a7792 2x, https://si.imgix.net/e543cd8e/uploads/origins/f569e7e7-83fb-4181-b136-d92537861034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c33f7f827ad84fd1eba309e170cae648 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Ikanikannika09/works/73", "thumbnail_src": "https://si.imgix.net/9f67b36b/uploads/origins/76eb7601-01fe-43e5-9079-7a2b372b86c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d8ca46f5fe33b501a7d9e541bdfdc7d", "thumbnail_srcset": "https://si.imgix.net/9f67b36b/uploads/origins/76eb7601-01fe-43e5-9079-7a2b372b86c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d8ca46f5fe33b501a7d9e541bdfdc7d, https://si.imgix.net/9f67b36b/uploads/origins/76eb7601-01fe-43e5-9079-7a2b372b86c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41e5e6276f5fa150f1bf4c4058f71171 2x, https://si.imgix.net/9f67b36b/uploads/origins/76eb7601-01fe-43e5-9079-7a2b372b86c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcd1940bd1b174a33fb527dfc94a3468 3x", "genre": "art", "nsfw": false, "body": "都にか様。\nこんばんは、初めまして。\nXで素敵なイラストをお見かけ致しましたので\n是非リクエストしたいと思いました。\n\nリクエスト内容としましては、自分のオリジナルキャラの朱鷺桜優理ちゃんをお願いしたいと思います。 \n\n髪：赤髪の長髪で髪の先端は白でアホ毛が1本あります。（左上にリボンが付いています。） \n胸：Cくらい