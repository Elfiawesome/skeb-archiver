92/uploads/origins/9f668ae8-ec7e-4b18-b331-0e73bf2fd31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70565c5663bf3111bb020ab17e841b06 2x, https://si.imgix.net/67eabf92/uploads/origins/9f668ae8-ec7e-4b18-b331-0e73bf2fd31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba32463b460a595dd99b35606a82cb23 3x", "genre": "art", "nsfw": false, "body": "はじめまして。\nYouTubeでVTuberとして活動している宇佐咲めると申します。\n\n春野にじ様の素敵なイラストを拝見し、ぜひ春野様の作風の宇佐咲めるを見たいと思い、リクエストさせていただきました。\n\n●使用用途\n・YouTube(収益化済み)のサムネイル\n・X(旧Twitter)での投稿\n・FANBOXでの投稿\n・ネットプリントでの使用\n\n●要望\n・資料URLをご参照いただき、ご自由にお描きくださればと思います。\n・頭頂部や手先などが見切れないようにしていただけるとありがたいです。\n・もし可能であれば、人物のみの背景透過PNGファイルもご納品いただけますと大変ありがたいです。\n\n●参考(キャラクター性格等)\n・大学生、宇宙人\n・天然でポンコツ\n・読書や宇宙が好き\n・かわいいものに目がない\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ihJhV_ges1jftLzawvq4cyZ2v3ntfOFH", "created_at": "", "completed_at": ""}, {"path": "/@hrno_nz/works/45", "thumbnail_src": "https://si.imgix.net/58ad1a50/uploads/origins/d7dce596-8fcb-4b95-aba7-1da1bff49e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c097e022b5b86b6e90c9b8f8ff7a6d12", "thumbnail_srcset": "https://si.imgix.net/58ad1a50/uploads/origins/d7dce596-8fcb-4b95-aba7-1da1bff49e44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c097e022b5b86b6e90c9b8f8ff7a6d12, https://si.imgix.net/58ad1a50/uploads/origins/d7dce596-8fcb-4b95-aba7-1da1bff49e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd650cd757beff440e671d7e2c0343e5 2x, https://si.imgix.net/58ad1a50/uploads/origins/d7dce596-8fcb-4b95-aba7-1da1bff49e44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38ee68c470671c28d42227228f14bda2 3x", "genre": "art", "nsfw": false, "body": "こんにちは！あなたの絵の夢のような雰囲気が本当に好きです。\n\n私のオリジナルキャラクターをリクエストしたいのですが：https://drive.google.com/drive/u/4/folders/1uokYMrVOJjQyoy7NVLoHyAeJij1E4PcN\n\nその人物は眠そうで無表情なキャラクターです。リファレンスシートの左側の衣装を使用してください。可能であれば、顔にほくろが2つあるバージョンとないバージョンの両方を提供してください。\n\nご検討いただきありがとうございます！", "created_at": "", "completed_at": ""}, {"path": "/@hrno_nz/works/44", "thumbnail_src": "https://si.imgix.net/4ffb7784/uploads/origins/a5892f04-076c-4721-bfad-57267ea4eb42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb2dd8e1bf9676c31b1f3b8467b82960", "thumbnail_srcset": "https://si.imgix.net/4ffb7784/uploads/origins/a5892f04-076c-4721-bfad-57267ea4eb42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb2dd8e1bf9676c31b1f3b8467b82960, https://si.imgix.net/4ffb7784/uploads/origins/a5892f04-076c-4721-bfad-57267ea4eb42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43b22883781c21d40b1b42c352e47062 2x, https://si.imgix.net/4ffb7784/uploads/origins/a5892f04-076c-4721-bfad-57267ea4eb42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50773d33dcd3baee60469efb520f5b0f 3x", "genre": "art", "nsfw": false, "body": "春野にじ先生\nはじめまして。32°と申します。\n先生の描かれる冬から春になる雪解けのような温かくも眩しい絵がとても素敵だと思い、今回は私のオリジナルキャラクター(OC)を描いていただきたくリクエストを送りします。\n\n┈┈┈┈┈┈┈┈┈┈\n\n「キャラクターについて」\n◾︎性別￤無性別\n◾︎年齢￤？\n◾︎特徴￤少年とも少女とも言える容姿、黒や白など様々な明るさの色素を持つ瞳(無彩色であれば何色でも大丈夫です)、黒い柔らかな髪\n◾︎モチーフ￤夜、夢、星、桜\n◾︎性格\n無邪気で繊細。幻のように掴みどころがない夢想家。\n\nhttps://drive.google.com/drive/folders/1KodDDDJfYVedttlHkRFIgqnySHfo9lKw\n\n「シチュエーションや構図など」\nもし可能であればイラストは星、夜空または桜などをモチーフにしたものだと嬉しいです！が、基本的には先生の方にお任せします。服装や表情も描きやすいように描いて頂ければと思います。\n\n┈┈┈┈┈┈┈┈┈┈\n\n何卒、よろしくお願い致します！", "created_at": "", "completed_at": ""}, {"path": "/@hrno_nz/works/43", "thumbnail_src": "https://si.imgix.net/aba77f77/uploads/origins/9830201b-6d29-4f99-9193-f3bda23269e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e8fd046e10015fb39b2b6b842b137d0", "thumbnail_srcset": "https://si.imgix.net/aba77f77/uploads/origins/9830201b-6d29-4f99-9193-f3bda23269e2?bg=%23fff&auto=format%2Ccompress&fm=webp&f