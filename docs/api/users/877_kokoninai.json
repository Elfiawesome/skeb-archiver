9e2b-0f919a9dc36e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea068a89f12e7ecb39f69c732c03dac7, https://si.imgix.net/c6b1e240/uploads/origins/a5e0d95b-5da3-4828-9e2b-0f919a9dc36e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c925d788155185d779e3aefa31fc6a61 2x, https://si.imgix.net/c6b1e240/uploads/origins/a5e0d95b-5da3-4828-9e2b-0f919a9dc36e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbc56e6fadc235f238706ceb19778cfb 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。茶々まっちゃです。\n今回は私の立ち絵でSDの作成をお願いしたいです。\n\n前回作っていただいたものより顔が大きめのコロンとしたものにしていただきたいです。\nお手上げのようなポーズがいいんですが、SDらしい短い腕を全力で上げているポーズでお願いします。(参考画像あります)\n参考画像より短い腕にしたいです。\nみんなの話についていけなくて目を回してる表情にしたいです。(参考画像あります)\nその他についてはすべておまかせでお願いいたします。\n\nいつも素敵な絵をありがとうございます。\n今回もよろしくお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@877_kokoninai/works/12", "thumbnail_src": "https://si.imgix.net/92eddabf/uploads/origins/20c18fd3-f376-45d3-b560-d5ec9f51aaf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d39fd338e125de9704e80b2045d79dd8", "thumbnail_srcset": "https://si.imgix.net/92eddabf/uploads/origins/20c18fd3-f376-45d3-b560-d5ec9f51aaf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d39fd338e125de9704e80b2045d79dd8, https://si.imgix.net/92eddabf/uploads/origins/20c18fd3-f376-45d3-b560-d5ec9f51aaf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21241ad83bf1341c298c9f2a58641e05 2x, https://si.imgix.net/92eddabf/uploads/origins/20c18fd3-f376-45d3-b560-d5ec9f51aaf4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=632c6afaab8880f395b93b344d008bc6 3x", "genre": "art", "nsfw": false, "body": "こんにちはヒヤシンスです。\n■依頼内容\nSDイラストの作成お願いします。\n■モデル\n(例)添付先のURLから立ち絵をご確認いただければと思います。\n\n■構図、表情\nどうぶつの森のベル袋のような物に平仮名で｢おちんぎん｣と書いた物を抱えてちょっと恥ずかしそうな表情のイラストをお願いします。\n\n■使用用途\nX等SNSにて使用\nIRIAM配信・活動にて使用\nネットプリント・グッズ作成に使用\n\n商用利用させて頂きたいです。\n( 缶バッチやキーホルダー等グッズ作成)\n\n■納品形式\n形式・縦横比サイズはお任せいたします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/15xhSf6oVTKh6MwZ8fgZWhl8xlw28rRZw", "created_at": "", "completed_at": ""}, {"path": "/@877_kokoninai/works/11", "thumbnail_src": "https://si.imgix.net/252b2f7b/uploads/origins/433696b9-9c00-4b94-a534-3d99ad455a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ae3568b99f2e72ab6593a762fec793", "thumbnail_srcset": "https://si.imgix.net/252b2f7b/uploads/origins/433696b9-9c00-4b94-a534-3d99ad455a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ae3568b99f2e72ab6593a762fec793, https://si.imgix.net/252b2f7b/uploads/origins/433696b9-9c00-4b94-a534-3d99ad455a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fb982e26ab6c83dd43ecfb422b46810 2x, https://si.imgix.net/252b2f7b/uploads/origins/433696b9-9c00-4b94-a534-3d99ad455a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8101ce36272f4c277118e667c477918 3x", "genre": "art", "nsfw": false, "body": "こんにちはヒヤシンスと申します。\n\n■依頼内容\n1枚絵を依頼させて頂きたいです。\n\n■モデル\n(例)添付先のURLから立ち絵をご確認いただければと思います。\n\n■構図、表情\n朝ごはんマーチ(曲)モチーフで\n構図表情等はお任せでお願いします。\n頭部・髪の毛などに見切れがないようにお願いいたします。\n\n■使用用途\nX等SNSにて使用\nIRIAM配信・活動にて使用\nネットプリント・グッズ作成に使用\n\n商用利用させて頂きたいです。\n( 缶バッチやキーホルダー等グッズ作成)\n\n■納品形式\n1枚データにプラス\n人物/背景を分けたもの頂けますと助かります。\n形式・縦横比サイズはお任せいたします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/15xhSf6oVTKh6MwZ8fgZWhl8xlw28rRZw", "created_at": "", "completed_at": ""}, {"path": "/@877_kokoninai/works/10", "thumbnail_src": "https://si.imgix.net/9cf052f1/uploads/origins/7cf8f810-bc25-471e-bb69-54894cb8cfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afd824d3f9bef85bd2420f080a1f647", "thumbnail_srcset": "https://si.imgix.net/9cf052f1/uploads/origins/7cf8f810-bc25-471e-bb69-54894cb8cfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3afd824d3f9bef85bd2420f080a1f647, https://si.imgix.net/9cf052f1/uploads/origins/7cf8f810-bc25-471e-bb69-54894cb8cfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16df7387446adfec5c9b20d9cbbd9592 2x, https://si.imgix.net/9cf052f1/uploads/origins/7cf8f810-bc25-471e-bb69-54894cb8cfe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0ea86c890681b362fe0ee60b4d669f3 3x", "genre": "art", "nsfw": false, "body": "こんにちは！！ぜひリクエストさせてほしいです🥺\nぴぐたんのXアカウントを作りたいので、アイコン用のSDキャラを描いてほしいです！\nただまだいろいろと準備中なので、パソコンとかでがんばって準備しているようなイメージのぴぐたんを希望しています🐷💗\n\nばないさんの、いろんなVさんを描いている絵がほんとうにかわいくて大好きです！\n楽しみにしていますので、よろしくお願いいたします！\n最近暑い日が続いたり、雨だったりで嫌な天気が続きますよね……体には気を付けて、休めるときにゆっくり休んでくださいね😌", "created_at": "", "completed_at": ""}, {"path": "/@877_kokoninai/works/9", "thumbnail_src": "https://si.imgix.net/6b16361e/uploads/origins/329b1ba8-5e23-4c45-afc7-b1886a34c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74df0535951472aeec4762dd1f9dfdc2", "thumbnail_srcset": "https://si.imgix.net/6b16361e/uploads/origins/329b1ba8-5e23-4c45-afc7-b1886a34c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74df0535951472aeec4762dd1f9dfdc2, https://si.imgix.net/6b16361e/uploads/origins/329b1ba8-5e23-4c45-afc7-b1886a34c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8dc7c06f1fdf2d230dd629ec7bfa1cd 2x, https://si.imgix.net/6b16361e/uploads/origins/329b1ba8-5e23-4c45-afc7-b1886a34c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06475c874611977ac259de2cf1f59e7c 3x", "genre": "art", "nsfw": false, "body": "茶々まっちゃさんの配信でリスナーしてますげんきと申します。\n先日ポストされていたこめこめット☄パンチ👊のミニキャラを製作依頼お願いできますでしょうか。\nナスのミニキャラの時と同条件でお願い致します(茶々さんが依頼されているため、商用利用可、透過ありなどで金額の増額あれば追加でお支払い致します)\nご確認の程、宜しくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@877_kokoninai/works/8", "thumbnail_src": "https://si.imgix.net/037235e9/uploads/origins/52dad906-79d5-4d67-a64e-f162b335881b?bg=%23fff&auto=format%2Ccompre