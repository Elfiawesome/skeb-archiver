%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247791e0aa91e02cea42f1a1f8fa936b", "thumbnail_srcset": "https://si.imgix.net/162921e4/uploads/origins/6c3b084b-c31f-4583-8509-f6f8e4a12cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247791e0aa91e02cea42f1a1f8fa936b, https://si.imgix.net/162921e4/uploads/origins/6c3b084b-c31f-4583-8509-f6f8e4a12cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21a9ef4a77c9449d2cdc9a63de3095fa 2x, https://si.imgix.net/162921e4/uploads/origins/6c3b084b-c31f-4583-8509-f6f8e4a12cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c811a425a4e138e8b8f580568f73906 3x", "genre": "art", "nsfw": true, "body": "シャドウバースFの乙坂紫苑を描いてほしい。\n\n構図や表情はお任せします。\n\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@9rimson/works/77", "thumbnail_src": "https://si.imgix.net/d4bf9607/uploads/origins/a3f4d4bd-602d-4522-9144-77839bf5cf03?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=624cfc10659568ec6204e4c1cbd1cf9d", "thumbnail_srcset": "https://si.imgix.net/d4bf9607/uploads/origins/a3f4d4bd-602d-4522-9144-77839bf5cf03?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=624cfc10659568ec6204e4c1cbd1cf9d, https://si.imgix.net/d4bf9607/uploads/origins/a3f4d4bd-602d-4522-9144-77839bf5cf03?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=58e09e1199a03ff562472a3ad3811fd0 2x, https://si.imgix.net/d4bf9607/uploads/origins/a3f4d4bd-602d-4522-9144-77839bf5cf03?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e23ddf46a25da9f03ff4224246447dcd 3x", "genre": "art", "nsfw": true, "body": "こんにちは、\n\nロックマンZXのパンドラのアニメーションをリクエストしたい。\n\nパンドラが若い男のペニスを手でコキコキしている。視点は上からの眺めだろう。彼女は前のイラストのように鎧を着ている:   https://skeb.jp/@9rimson/works/61\n\nパンドラのシャツが引き上げられる。黒いボディスーツを着ているため、胸の曲線が丸見えだ。\n\n胸には濃厚でベトベトした精液がたくさんついていて、黒いボディスーツとのコントラストが素晴らしい。パンドラのヘルメットや髪にも精液がついている。\n\n\n\n手コキのいくつかの動きの後、ペニスはいくつかの精液を射精し、パンドラの舌と胸に落ちる（彼女の服にはすでに精液が付着しているので、それが落ちて混ざり合う）。\n\nパンドラは手コキをしながら少し恥ずかしそうにし、ペニスが射精するときには目を閉じて口を開ける。\n\nそのため、アニメーションは手コキ、パンドラの顔、パンドラのオッパイの動き、射精に焦点が当てられている。\n\n\n私はあなたの作品がとても好きなので、このリクエストがあなたのお気に召すことを願っています。\n需要に対して価格が十分でなければ、遠慮なく再送してほしい。", "created_at": "", "completed_at": ""}, {"path": "/@9rimson/works/76", "thumbnail_src": "https://si.imgix.net/71640d94/uploads/origins/eac01b45-b60f-481a-aa60-773afced1b1e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5cb32c3e1df5d220207e9f7ae16ab69e", "thumbnail_srcset": "https://si.imgix.net/71640d94/uploads/origins/eac01b45-b60f-481a-aa60-773afced1b1e?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5cb32c3e1df5d220207e9f7ae16ab69e, https://si.imgix.net/71640d94/uploads/origins/eac01b45-b60f-481a-aa60-773afced1b1e?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b0c825ea9029ccba9c2aee04ee4a312 2x, https://si.imgix.net/71640d94/uploads/origins/eac01b45-b60f-481a-aa60-773afced1b1e?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=e070a89bc500eaabaa299b6b110a7f21 3x", "genre": "art", "nsfw": true, "body": "こんにちはキュウリムゾンさん。\n\ngifやアニメーションができるのかどうか、気になります。\n\nけものフレンズのハシビロコウさんのエロアニメが欲しいです。\n\nハシビロコウの大きな胸が服の外に露出している。\n\n男からの両手が、ハシビロコウの胸に触れている。\n\n片方の手で片方の乳房をつかみ、マッサージする。乳房を押さえながら指は乳房の奥まで入っていく. \n\nもう片方の手はハシビロコウの乳首に触れ、乳房の中に押し込むと. 乳首を押しながら、その手で乳房を少し持ち上げ、それを止めると乳房が少し跳ねて最初のポーズに戻ります。\n\nハシビロコウの乳房はマシュマロのようにやわらかい。\n\nこのとき、ハシビロコウは、とても恥ずかしがり屋で照れ屋なため、驚きました。前腕を胸の両脇に上げる。ハシビロコウは手元を見て、ずいぶん赤面している。口が開いている。\n\nこの作品のような画角で: (https://twitter.com/9rimson/status/1633373642108334081  https://twitter.com/9rimson/status/1655540775747461126).\n\n私はあなたの作品が大好きなので、このリクエストを気に入ってもらえると嬉しいです。\n\nhttps://www.pixiv.net/en/artworks/99211881", "created_at": "", "completed_at": ""}, {"path": "/@9rimson/works/75", "thumbnail_src": "https://si.imgix.net/55548e33/uploads/origins/45eca4ed-cf9d-45a7-b3ba-b3ac80f6a158?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b85009aa09519d83ff32d63336312fb", "t