.com/drive/folders/1UN5AYacpah8S_zF9-fm2bDGrzA69ZaIn", "created_at": "", "completed_at": ""}, {"path": "/@kakuteki11029/works/38", "thumbnail_src": "https://si.imgix.net/275e9ee9/uploads/origins/a0d01dd9-a697-4e0c-a6c0-2dc843542782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af59cc04f367ddf91cd4e050bcb42753", "thumbnail_srcset": "https://si.imgix.net/275e9ee9/uploads/origins/a0d01dd9-a697-4e0c-a6c0-2dc843542782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af59cc04f367ddf91cd4e050bcb42753, https://si.imgix.net/275e9ee9/uploads/origins/a0d01dd9-a697-4e0c-a6c0-2dc843542782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed9a1ed01637a1dac0291b41cb67dd2b 2x, https://si.imgix.net/275e9ee9/uploads/origins/a0d01dd9-a697-4e0c-a6c0-2dc843542782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=26ef99f660dc9fac45d683babc4185c9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@kakuteki11029/works/37", "thumbnail_src": "https://si.imgix.net/625ff342/uploads/origins/6cfb1634-c746-42d6-a542-133240722acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c303d934c67c735dd98a3000adfc715", "thumbnail_srcset": "https://si.imgix.net/625ff342/uploads/origins/6cfb1634-c746-42d6-a542-133240722acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c303d934c67c735dd98a3000adfc715, https://si.imgix.net/625ff342/uploads/origins/6cfb1634-c746-42d6-a542-133240722acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&