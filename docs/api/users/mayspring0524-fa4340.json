51ae84a16206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92ece922f1b4ee626f009b9810f5a3c3, https://si.imgix.net/d87a9a1a/uploads/origins/944b9d3b-19d6-4d2c-a074-51ae84a16206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b714de3cbdd6305071017a51e2f1e16 2x, https://si.imgix.net/d87a9a1a/uploads/origins/944b9d3b-19d6-4d2c-a074-51ae84a16206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a5e386ecf9ea3a5bd0aa45ddd551667 3x", "genre": "art", "nsfw": false, "body": "「かぐや様は告らせたい」の四宮かぐやちゃんの全身立ち絵をお願いします！\n服装と髪型は3期7話の弓道着でお願いします！\n下記のURLを参照お願いします。\n\nhttps://livedoor.blogimg.jp/anico_bin/imgs/d/d/dd50711e.jpg\n\nhttps://livedoor.blogimg.jp/anico_bin/imgs/3/a/3a951da0.jpg\n\nhttps://livedoor.blogimg.jp/anico_bin/imgs/6/8/68e01c29.jpg\n\nhttps://pin.it/7IQdJsS\n\n足は白足袋で\n差分として裸足の差分をお願いします。(裸足の差分時は近くに足袋を置いていただきたいです)\nポーズはお任せしますが、全身が入っている立ち絵でお願いします。\nまた、肌がかなり白いキャラなので白めに描いて貰えると嬉しいです。\nよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/171", "thumbnail_src": "https://si.imgix.net/e712fccd/uploads/origins/5753b529-c37f-44d3-af7a-d51635bfa7be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e75d0149a88dff8fad4777072c1b87d", "thumbnail_srcset": "https://si.imgix.net/e712fccd/uploads/origins/5753b529-c37f-44d3-af7a-d51635bfa7be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e75d0149a88dff8fad4777072c1b87d, https://si.imgix.net/e712fccd/uploads/origins/5753b529-c37f-44d3-af7a-d51635bfa7be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4505c58d1692e126bc219a8ed23b35d0 2x, https://si.imgix.net/e712fccd/uploads/origins/5753b529-c37f-44d3-af7a-d51635bfa7be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5474f1d8c2d93937a56e848736aeb96c 3x", "genre": "art", "nsfw": true, "body": "リクエスト失礼します。\n\nスーパーキノコで大きくなった7Pカラーのゼロスーツサムスがピットにおへそをチンコでピストンされるのをお願いします。\n\n詳細\n☆縦へそ\n☆大きさによってはお腹を舐めを希望\n☆ピットいない差分もほしい", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/170", "thumbnail_src": "https://si.imgix.net/37ca1865/uploads/origins/893fc796-8f13-42bd-80f7-b3bd7544c255?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb8e1ff66d4ab49f35ebebb659e57901", "thumbnail_srcset": "https://si.imgix.net/37ca1865/uploads/origins/893fc796-8f13-42bd-80f7-b3bd7544c255?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb8e1ff66d4ab49f35ebebb659e57901, https://si.imgix.net/37ca1865/uploads/origins/893fc796-8f13-42bd-80f7-b3bd7544c255?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b02dd76ed029546b7e26fcbf6e7ab447 2x, https://si.imgix.net/37ca1865/uploads/origins/893fc796-8f13-42bd-80f7-b3bd7544c255?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab03e26b525922128d7ce77653b8a589 3x", "genre": "art", "nsfw": false, "body": "FGOの玉藻の前(ランサー、第三再臨)をお願いしたいです。\n\n構図としては、上半身アップで少し前かがみになりながら露骨に胸を強調した構図です。\n表情は、「あら、私の胸がそんなに気になりますか？」と言わんばかりの下がり眉ニヤニヤ顔でこちらを小馬鹿にするような表情をお願いします。\nポーズは、組んだ両腕で胸を寄せあげて欲しいです。(胸がかなり大きめだとより嬉しいです！)\n\nご承認いただければ幸いです。よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/169", "thumbnail_src": "https://si.imgix.net/01ab65dd/uploads/origins/0e6728b6-4cb8-4813-99e3-f012ba870654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=215283c04ecde0d50fae269a77ed3c12", "thumbnail_srcset": "https://si.imgix.net/01ab65dd/uploads/origins/0e6728b6-4cb8-4813-99e3-f012ba870654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=215283c04ecde0d50fae269a77ed3c12, https://si.imgix.net/01ab65dd/uploads/origins/0e6728b6-4cb8-4813-99e3-f012ba870654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f2a98c330c06b12bca584b97568cc91 2x, https://si.imgix.net/01ab65dd/uploads/origins/0e6728b6-4cb8-4813-99e3-f012ba870654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19d55eb15c3a6645e441f810a1d03be5 3x", "genre": "art", "nsfw": false, "body": "ご無沙汰しております、前に2度ほど水着ソーンさんのリクエストを送った者です。いくらか余裕ができたのと手数料の無料期間が終わりそうだったので、滑り込みになりますがまたリクエストを送ります。\nもし引き受けてくだされば幸いです(今回は健全絵のリクエストです)。\n\n・キャラクターと服装\n3度目になりますがグランブルーファンタジーの水着ソーン、服装も前と同じ布地小さめ・おっぱいも大きく盛った水着姿でお願いします。\n\n・ポーズやシチュ等\nポーズは照れながらこちらを見ている表情、また胸を強調したポーズでお願いします。\nシチュはソーンさんがこちらに強い好意を抱いてて、きわどい水着と豊満なおっぱいで誘惑するようなイメージです(かなり妄想強めで気持ち悪い内容です、すみません…)。\n\n私の中で絵柄も表情も、すべてが理想的な皐月ハルさんの描かれるソーンさんを健全絵でも見たいと思い、何度目になるか分かりませんがこうして送らせていただきました。妄想強めな内容になりましたがどうぞよろしくお願いいします。\n(またこちらでの場になりますが、長らく界隈での活動お疲れ様でした。同時に一般絵などを描ける状態にまで心身の調子も戻って本当に安心しました、原神のイラストなども楽しみにしています)", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/168", "thumbnail_src": "https://si.imgix.net/ae737f2b/uploads/origins/2425aee6-4f1b-4640-9cbd-ab768406b333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa4f66c99e9b6876d50b7a5561bf5b8f", "thumbnail_srcset": "https://si.imgix.net/ae737f2b/uploads/origins/2425aee6-4f1b-4640-9cbd-ab768406b333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa4f66c99e9b6876d50b7a5561bf5b8f, https://si.imgix.net/ae737f2b/uploads/origins/2425aee6-4f1b-4640-9cbd-ab768406b333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcf79b52b3a934b23f7adadec4553dd7 2x, https://si.imgix.net/ae737f2b/uploads/origins/2425aee6-4f1b-4640-9cbd-ab768406b333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd3354a8021ef475d0902f0d9a77b49f 3x", "genre": "art", "nsfw": true, "body": "作品：原神\nキャラクター：ジン\n\nお世話になります！いつも作品楽しみにさせていただいております！\nビキニを着た後ろ姿のジンが恥ずかしげに水着の食い込みを直しているイラストをお願いしたいです！\nお尻を強調するようにドアップだとド性癖でド嬉しいです！\nカラー・モノクロ問いません！\nご一考いただければ幸いです！", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/167", "thumbnail_src": "https://si.imgix.net/c3901a8c/uploads/origins/cc4af3dc-558d-4928-8acd-b900ba2ba524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b98eecb0e6ccb9632a46409f1bf517b3", "thumbnail_srcset": "https://si.imgix.net/c3901a8c/uploads/origins/cc4af3dc-558d-4928-8acd-b900ba2ba524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b98eecb0e6ccb9632a46409f1bf517b3, https://si.imgix.net/c3901a8c/uploads/origins/cc4af3dc-558d-4928-8acd-b900ba2ba524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46b24924995eabc89d9cf7edf87f8715 2x, https://si.imgix.net/c3901a8c/uploads/origins/cc4af3dc-558d-4928-8acd-b900ba2ba524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0274e62e25a05fd350d9ebcf3418ac7 3x", "genre": "art", "nsfw": true, "body": "①キャラクター\nメルヘヴンのスノウとドロシー\n\n②シチュエーション\nパンイチのバンザイ状態で拘束されて、壁から生えてきた無数のマジックハンドにより、全身を蹂躙される(エロトラップ的な...)\n\n悶え苦しんでいる姿をどうかお願い申し上げます。", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/166", "thumbnail_src": "https://si.imgix.net/11825abc/uploads/origins/ea830aa2-323f-4a44-adbd-7b16aabf92c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee1733f49aa9486887f9a99e920051cd", "thumbnail_srcset": "https://si.imgix.net/11825abc/uploads/origins/ea830aa2-323f-4a44-adbd-7b16aabf92c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee1733f49aa9486887f9a99e920051cd, https://si.imgix.net/11825abc/uploads/origins/ea830aa2-323f-4a44-adbd-7b16aabf92c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b25528c406937843225a557629f9c026 2x, https://si.imgix.net/11825abc/uploads/origins/ea830aa2-323f-4a44-adbd-7b16aabf92c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df361f35039e6409a6a31e7ad90efa66 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/165", "thumbnail_src": "https://si.imgix.net/e06a547f/uploads/origins/5f26d896-6240-40de-99b8-007ab2eafd79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65bc76acfae1f218488620bd85df155b", "thumbnail_srcset": "https://si.imgix.net/e06a547f/uploads/origins/5f26d896-6240-40de-99b8-007ab2eafd79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65bc76acfae1f218488620bd85df155b, https://si.imgix.net/e06a547f/uploads/origins/5f26d896-6240-40de-99b8-007ab2eafd79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0575d2ff13918114ea014d6b9017f70d 2x, https://si.imgix.net/e06a547f/uploads/origins/5f26d896-6240-40de-99b8-007ab2eafd79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62792e5b7a07e73368cec02f668c8d0a 3x", "genre": "art", "nsfw": true, "body": "いつもお世話になっております、みぐぞうと申します。\n\n最初に案件を御説明しておきますと\nB5、モノクロ、600dpiで、締め切りは8月末。\n題材は「今では発売出来ない、ゲームセンターや喫茶店で\n稼働していたドエロな脱衣麻雀、花札ゲーム」のギャルを題材に\n描いて頂ければと思います。", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/164", "thumbnail_src": "https://si.imgix.net/c233ce88/uploads/origins/748b11dd-8c1c-4c78-aa9f-b74e75098fa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66eea5a5acbdebb37b1186f9f65747a6", "thumbnail_srcset": "https://si.imgix.net/c233ce88/uploads/origins/748b11dd-8c1c-4c78-aa9f-b74e75098fa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66eea5a5acbdebb37b1186f9f65747a6, https://si.imgix.net/c233ce88/uploads/origins/748b11dd-8c1c-4c78-aa9f-b74e75098fa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72cf6a4137a803b333d2218e42514087 2x, https://si.imgix.net/c233ce88/uploads/origins/748b11dd-8c1c-4c78-aa9f-b74e75098fa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4f28a511fb4c4fbf8866bec423723c4 3x", "genre": "art", "nsfw": true, "body": "【版権】\n艦隊これくしょん\n\n【キャラ】\n衣笠改二\n\n【場所】\n保健室 呪われたベッドの上　\n\n【シチュ】\n体調が優れず、保健室で休憩を取る事にした衣笠。\n保健室に入ると、そこには衣笠と同じように体調を崩した男女が何人もそこにいた。\nそして運よく、衣笠は保健室最後のベッドに寝る事ができた。\nパーテーション（カーテンみたいなアレ）に区切られている事もあり、熟睡ができた。\nしかし、目が覚めると布団は床に落ちており、彼女はXの文字で動けなくなっていた。\n金縛りかと困惑している中、目の前に謎の手（幽霊の手）が出現する。\nそしてその手は彼女をいきなりくすぐり出す。\n体は動けず、保健室で大声も出せない中、彼女は必死にくすぐりを我慢する。\nそれに声を出すと状況確認ということで今のこのあられもない姿を見られるのは避けたかったのである。\n\nこの呪われたベッドに住み着く霊は彼女の体で弄ぶのであった。\n我慢しきれず笑うのか、助けを呼んでしまって今の恥ずかしい姿を誰かに見せるのか、\nそれとも、全力でくすぐりを我慢してこの時間を耐え忍ぶのか、\nそれを幽霊たちが遊んでいるのである。\n\n【衣笠改二の状況】\n【拘束の状況】\nベッドの上でXの文字で幽霊の手に拘束されています。\n腋の下のくすぐりから逃げようと体を左右に動かしている感じです。\n\n【衣服】\n幽霊たちによって衣服が乱れされています。\nスカートを上げられて下着が見えるようにお願いします。\n\n【表情】\n必死に笑い声が漏れないように目を開けて我慢している表情でお願いします。\nでも声がちょっと漏れている感じです。\n\n【くすぐり 責め】\nくすぐりの幽霊の手のくすぐり責めの感じは体を弄んでいる感じです。\n衣笠にいたずらで笑いと我慢ができるギリギリの点で遊んでいるって感じですね……。\n\n【腋】\n両腋を人差し指でなぞる感じでお願いします。\n右に逃げても指に追跡されてくすぐられ、左に逃げてもまた同じようにくすぐられている感じです。\n\n【胸】\n左胸を突ついて遊んでいます。\n右胸を優しく掴んで揉んでいます。\n\n【脇腹】\n両脇腹を優しく掴んで揉んでいます。\n\n【鼠径部】\n鼠径部の箇所を人差し指でなぞられています。\n\n長くなりましたが、よろしくお願いします。\n\nhttps://pbs.twimg.com/media/EuQ5b07U4AMeSbL?format=jpg&name=4096x4096", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/163", "thumbnail_src": "https://si.imgix.net/4b36a822/uploads/origins/7e58f994-0977-4c6a-8f46-9dcf27ec15b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d80bf55790584e89c8ebf0e2ba481cfa", "thumbnail_srcset": "https://si.imgix.net/4b36a822/uploads/origins/7e58f994-0977-4c6a-8f46-9dcf27ec15b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d80bf55790584e89c8ebf0e2ba481cfa, https://si.imgix.net/4b36a822/uploads/origins/7e58f994-0977-4c6a-8f46-9dcf27ec15b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e98e18d23ad93e19463d3ea152f533e0 2x, https://si.imgix.net/4b36a822/uploads/origins/7e58f994-0977-4c6a-8f46-9dcf27ec15b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8ccfa1cb010b9f5dfaf66dcde3c1c32 3x", "genre": "art", "nsfw": true, "body": "初めまして。いつも素敵なイラストを描いてくださりありがとうございます。\n宝石姫 JEWEL PRINCESSより、自分が大好きなキャラ「ローゾフィア」が救星主(本ゲームの男主人公)をくすぐるイラストを漫画形式で、計３ページお願いします。\n以下にページ毎のシチュエーションを書きます。ローゾフィアの格好は下記リンクの進化前がベースで、一人称は「ワタシ」救星主への呼び方は「救星主(マスター)くん」です。救星主の外見や背景、細かい台詞や効果音やコマ割りは自由です。\n\n１ページ目：\n執務室の机で仕事(机に向かって羽根ペンで書き物をしている描写)をしている救星主に休憩することを提案するローゾフィア。救星主が手を止める様子がないのを見ると椅子の後ろに回り込み脇腹をくすぐる。くすぐられた救星主は思わず笑いだす。\n\n２ページ目：\nローゾフィアが救星主の股間を見ると勃起している事に気づく。くすぐられて興奮したと察したローゾフィアは仕事を放ってエッチしようと誘惑する。くすぐり方も性感を煽るものになっていき、脇腹をくすぐっていた右手は救星主の右手に艶めかしく這わせながら羽根ペンを奪い救星主の右耳を羽根部分でさわさわとくすぐる。左手は勃起したペニスを服の上から爪先でくすぐって焦らしている。\nページの左下部分に暗転の描写をいれて時間経過を表す。\n使用してほしい台詞…「救星主(マスター)くんったらくすぐられるのが好きなんだ？」「ねえ…救星主(マスター)くんの心からの声、聞かせて？」\n\n３ページ目：\n執務室の椅子の上でローゾフィアと救星主がくすぐり対面座位をしている一枚絵。\n救星主は裸で椅子に座っており手を椅子の後ろで拘束されている。\nローゾフィアはスカートを脱いでパンツをずらしており、おっぱい暖簾の部分ははだけて乳首が救星主の乳首と擦りあっている。ペニスの刺激に感じながらも両手は救星主の脇を巧みにくすぐっている。\n使用してほしい台詞…「あははっ♡　快楽に溺れる救星主(マスター)くんの姿、素敵よ♡」「もっとさらけ出して…！　もっとワタシに委ねて…！」\n\n大変長くなりましたが、御一考の程どうぞよろしくお願い致します。\n\nローゾフィア：https://jewel.wikiru.jp/index.php?%A5%ED%A1%BC%A5%BE%A5%D5%A5%A3%A5%A2", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/162", "thumbnail_src": "https://si.imgix.net/617c7790/uploads/origins/d90d30ff-fd78-4aea-829e-6b107fe019b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a9e67c3814f38f30b46d72a77742058", "thumbnail_srcset": "https://si.imgix.net/617c7790/uploads/origins/d90d30ff-fd78-4aea-829e-6b107fe019b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a9e67c3814f38f30b46d72a77742058, https://si.imgix.net/617c7790/uploads/origins/d90d30ff-fd78-4aea-829e-6b107fe019b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf9c03c14701f5ad8eb53f7a3ca0dede 2x, https://si.imgix.net/617c7790/uploads/origins/d90d30ff-fd78-4aea-829e-6b107fe019b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4fb2026d2c6f186c2930ad565f61d47 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/161", "thumbnail_src": "https://si.imgix.net/84e52cfd/uploads/origins/30056b58-e447-4787-a593-d60986142f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d25db967077737be5f10331db09960", "thumbnail_srcset": "https://si.imgix.net/84e52cfd/uploads/origins/30056b58-e447-4787-a593-d60986142f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83d25db967077737be5f10331db09960, https://si.imgix.net/84e52cfd/uploads/origins/30056b58-e447-4787-a593-d60986142f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aaed28041506371d3d964c221e9f392b 2x, https://si.imgix.net/84e52cfd/uploads/origins/30056b58-e447-4787-a593-d60986142f2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7a6561dc0eeaddfec297f0f2afa115a 3x", "genre": "art", "nsfw": true, "body": "妖精騎士トリスタンがラバー拘束+モルガンのような姿勢でくすぐられるとうものをくすぐられる前に怒鳴り散らす+頭ものっぺらぼうになるように覆われてしまうというものをお願いします！\n願わくば以前の妖精騎士ランスロットが頭ものっぺらぼうになるようにラバーで覆われてしまう差分もお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/160", "thumbnail_src": "https://si.imgix.net/720f29b5/uploads/origins/968906c3-2139-4581-9ba2-533cab15e4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c271d1e7c04a9d65faae5f1b9c5867b", "thumbnail_srcset": "https://si.imgix.net/720f29b5/uploads/origins/968906c3-2139-4581-9ba2-533cab15e4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c271d1e7c04a9d65faae5f1b9c5867b, https://si.imgix.net/720f29b5/uploads/origins/968906c3-2139-4581-9ba2-533cab15e4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ab862c767164a5316fe69418e9690992 2x, https://si.imgix.net/720f29b5/uploads/origins/968906c3-2139-4581-9ba2-533cab15e4e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2164e096636055a492c1932e0438c4a9 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/159", "thumbnail_src": "https://si.imgix.net/96a59e2b/uploads/origins/d4625451-2509-436d-8360-35eed3b2d721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=630a25426d60e78f2fcdda86b0692da0", "thumbnail_srcset": "https://si.imgix.net/96a59e2b/uploads/origins/d4625451-2509-436d-8360-35eed3b2d721?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=630a25426d60e78f2fcdda86b0692da0, https://si.imgix.net/96a59e2b/uploads/origins/d4625451-2509-436d-8360-35eed3b2d721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a688498d41752a5f52d8895e0e5ce9b3 2x, https://si.imgix.net/96a59e2b/uploads/origins/d4625451-2509-436d-8360-35eed3b2d721?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b7794ad795090ae5ff5dafa938cbc80 3x", "genre": "art", "nsfw": true, "body": "皐月さんが描かれたみなもちゃんのレズくすぐりのイラストを拝見して素晴らしいと思ったのでリクエストします！\n皐月さんのオリキャラの藤根未子が潜入に失敗して敵に捕まり全裸にされて2人の女性尋問官にくすぐられるイラストをお願いします。\n\n1\nとある研究施設に潜入するも突如警報がなり敵に囲まれてあっさり捕まってしまう藤根未子。\n\n2\n裸に剥かれ拘束されてしまい大ピンチの彼女だが、情報を吐くように促す尋問官前に不敵の笑みを浮かべて余裕を見せる(ようにしているが冷や汗をかいている。)\n\n3\nその後尋問官に洗い責めされたり足裏、脇をくすぐられて大きな胸を揺らし、さらに涙を流して笑い悶えてしまう。2人の女性尋問官も裸になって身体を密着させたりくすぐりながら藤根未子の秘部や胸を愛撫している。\n\n4\n最後はくすぐりに屈服し身体を痙攣させながら「もっと…くすぐって…」と口元が笑ったまま懇願してしまう…と言った内容でお願いします。\n\n細かいセリフや擬音も付けて欲しいです。何卒よろしくお願いいたします！", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/158", "thumbnail_src": "https://si.imgix.net/204b2b9c/uploads/origins/e117af71-c334-4145-a609-f10fbd7507ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43bbc3c650d0b93813c9b2ef718a082d", "thumbnail_srcset": "https://si.imgix.net/204b2b9c/uploads/origins/e117af71-c334-4145-a609-f10fbd7507ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43bbc3c650d0b93813c9b2ef718a082d, https://si.imgix.net/204b2b9c/uploads/origins/e117af71-c334-4145-a609-f10fbd7507ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4af9c0dfcb5eb23c0acc9dd9292be51 2x, https://si.imgix.net/204b2b9c/uploads/origins/e117af71-c334-4145-a609-f10fbd7507ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2efe55f4212a9a64f5576e45a051b447 3x", "genre": "art", "nsfw": true, "body": "いつものようにみなもちゃんのイラストを依頼させていただきます！！\n\n藤原みなもが自身の通う大学に侵入した藤根　未子を偶然にも発見してしまい、発覚された事で依頼失敗後のお仕置きを恐れた藤根　未子に拘束されてここで自分の事を見たと誰にもしゃべらないように、とくすぐりられながら約束させられているイラストをお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@mayspring0524/works/157", "thumbnail_src": "https://si.imgix.net/9035f861/uploads/origins/2bc41e73-1df2-481d-8e8c-0ad0f6233219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=392f093ba092edb3259dcf905003a12a", "thumbnail_srcset": "https://si.imgix.net/9035f861/uploads/origins/2bc41e73-1df2-481d-8e8c-0ad0f6233219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtali