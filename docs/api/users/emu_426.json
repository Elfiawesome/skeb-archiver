op&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7be834dbcd90fa18abaaa007ca62a1da", "thumbnail_srcset": "https://si.imgix.net/98d1d5c0/uploads/origins/4d07d763-d6dc-4c5c-8507-a3d230e05f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7be834dbcd90fa18abaaa007ca62a1da, https://si.imgix.net/98d1d5c0/uploads/origins/4d07d763-d6dc-4c5c-8507-a3d230e05f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1010743807425cac7413a0514afb21d2 2x, https://si.imgix.net/98d1d5c0/uploads/origins/4d07d763-d6dc-4c5c-8507-a3d230e05f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db7fc0a17d16b601517ae41e2e491fcc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@emu_426/works/15", "thumbnail_src": "https://si.imgix.net/3e410931/uploads/origins/6c2e40f2-e1e6-4c74-804a-e78c72e49d07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=552ddb82550720d0ef3e17a6b9fa9473", "thumbnail_srcset": "https://si.imgix.net/3e410931/uploads/origins/6c2e40f2-e1e6-4c74-804a-e78c72e49d07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=552ddb82550720d0ef3e17a6b9fa9473, https://si.imgix.net/3e410931/uploads/origins/6c2e40f2-e1e6-4c74-804a-e78c72e49d07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c69cc196f312c29ba36ba47f1d4f7cc 2x, https://si.imgix.net/3e410931/uploads/origins/6c2e40f2-e1e6-4c74-804a-e78c72e49d07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=268e08096aa8ccf9c91ede2e34098a14 3x", "genre": "art", "nsfw": false, "body": "えむふさん、こんにちは！\n\n前回はとても素敵なイラストをありがとうございました！\n今回もイラストをお願いしたく、えむふさんにリクエストさせていただきました…！\n\nお願いしたい方は鍛冶之熊ゴロッペさんというVtuberさんになります！🔨🐻\nイラスト内容としては、今の時期に合わせてサンタコスチュームでお願いできればと思います…！\n\n参考URL：https://x.com/goroppe/status/1862472239985434856", "created_at": "", "completed_at": ""}, {"path": "/@emu_426/works/14", "thumbnail_src": "https://si.imgix.net/0bf3c6b1/uploads/origins/66e1d378-59e8-4d69-8d21-25e2190dd833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2894d57dd019d5217f3974eff5b8e677", "thumbnail_srcset": "https://si.imgix.net/0bf3c6b1/uploads/origins/66e1d378-59e8-4d69-8d21-25e2190dd833?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2894d57dd019d5217f3974eff5b8e677, https://si.imgix.net/0bf3c6b1/uploads/origins/66e1d378-59e8-4d69-8d21-25e2190dd833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f11ada7fd1197f2df8938442d66a1665 2x, https://si.imgix.net/0bf3c6b1/uploads/origins/66e1d378-59e8-4d69-8d21-25e2190dd833?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b0b5ac413c166a6f60bd4a3f644a31f 3x", "genre": "art", "nsfw": false, "body": "こんにちは、Skebにてイラストのリクエストを送らせていただきました。\n\n以前、お絵描き投稿サイトに投稿されていたオリジナルキャラ(OC)の4コマ漫画に登場する野球部の狸獣人さんのイラストを描いていただくことはできませんでしょうか。(約12年前のイラストから、現在の等身を多少あげたお姿を拝見してみたいです。)\n\n構図は、A4の縦長サイズで、股下(膝の高さより上の腿) 辺りまでの上半身。\n\n服装について、キャッチャーミットや捕手の各防具を装着した状態。(漫画のキャップと同様に、捕手用のヘルメットから耳が出ている構造、防具などのデザインはおまかせします) 上着は、紺色で半袖のアンダーシャツ(丸首 フィットタイプ)、下着は、無難な野球の練習着の着用でお願いします。\n防具越しに腹部などががっしりとした体格のイメージです。\n\nまた、もしもできましたら各防具を着脱した状態でのイラスト差分をいただけたら幸いです。(お顔や腹部が少々隠れるため)\n\nイラストの構図、ポージングは下記URLのリンク先のフリー素材を元に描写していただきたくお願いします。\n\n納品についてですが、原寸のファイルサイズで受け取りたいため、可能でしたらpsd形式での納品を希望します。\n\nお忙しいところお手数をお掛けしますが、何卒宜しくお願いいたします。\n\n・資料掲載元のフリー素材サイト\nhttps://mirais.misuzu-eco.com/?page_id=52#baseball\n\n・ポージング資料(投球フォーム、盗塁防止の送球動作)\nhttps://mirais.misuzu-eco.com/wp-content/themes/yyy_mirais/free/184.png\n\n・構図資料(上記のポーズ資料は、真横から見た姿のため、体の向き・角度について、若干斜め向きのような感じで、参考程度にお願いします。)\nhttps://mirais.misuzu-eco.com/wp-content/themes/yyy_mirais/free/183.png", "created_at": "", "completed_at": ""}, {"path": "/@emu_426/works/13", "thumbnail_src": "https://si.imgix.net/660ae6f6/uploads/origins/46ab3184-5ea3-402f-a6ad-a6c2a4b9598d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37421db37cbd6952cdacc3f3528fbf3d", "thumbnail_srcset": "https://si.imgix.net/660ae6f6/uploads/origins/46ab3184-5ea3-402f-a6ad-a6c2a4b9598d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37421db37cbd6952cdacc3f3528fbf3d, https://si.imgix.net/660ae6f6/uploads/origins/46ab3184-5ea3-402f-a6ad-a6c2a4b9598d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08b2f9777109dc0430cfc3d644ed98d2 2x, https://si.imgix.net/660ae6f6/uploads/origins/46ab3184-5ea3-402f-a6ad-a6c2a4b9598d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6daf32dd8346f555d4d3dc2e05a59d6 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@emu_426/works/12", "thumbnail_src": "https://si.imgix.net/4d95eb11/uploads/origins/a3dc7fd5-ba70-400d-8aeb-10c738d22efc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59650ea6c7df666327c39d4a7e16642", "thumbnail_srcset": "https://si.imgix.net/4d95eb11/uploads/origins/a3dc7fd5-ba70-400d-8aeb-10c738d22efc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e59650ea6c7df666327c39d4a7e16642, https://si.imgix.net/4d95eb11/uploads/origins/a3dc7fd5-ba70-400d-8aeb-10c738d22efc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr