fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=173291bc31b5f49315571554fd3e1d5c, https://si.imgix.net/37c6a08f/uploads/origins/e958e06b-0cc6-488d-84bc-5bd3b82cf828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a90a1f4181a7189299c50ef15853b423 2x, https://si.imgix.net/37c6a08f/uploads/origins/e958e06b-0cc6-488d-84bc-5bd3b82cf828?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60983b78bff21921725c63763c6d167e 3x", "genre": "art", "nsfw": false, "body": "ワ〜！先生、こんにちは！\n前回描いていただいた納品にとても感動しました！！\nもし可能であれば、今回も私のオリジナルキャラクターを描いていただけないでしょうか？\n\n参考用の資料は下記のURLに添付しておりますので、ご自由な絵をお願いします。金額や条件等が合わない場合は、再送請求・キャンセルをしていただけると幸いです。\nご検討よろしくお願いいたします！> <\n\nhttps://drive.google.com/drive/folders/1uzzM7g_uolqJeDaHOSJlcYK9ZmTj4GkR", "created_at": "", "completed_at": ""}, {"path": "/@ku82448/works/317", "thumbnail_src": "https://si.imgix.net/3e235bc2/uploads/origins/e66559c7-ac96-4800-8c7d-82970ca509df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4267ed56178294257a652c2247d1e1e7", "thumbnail_srcset": "https://si.imgix.net/3e235bc2/uploads/origins/e66559c7-ac96-4800-8c7d-82970ca509df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4267ed56178294257a652c2247d1e1e7, https://si.imgix.net/3e235bc2/uploads/origins/e66559c7-ac96-4800-8c7d-82970ca509df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3f88ee26bc7bf3a8fc8aeb9c14a89d9 2x, https://si.imgix.net/3e235bc2/uploads/origins/e66559c7-ac96-4800-8c7d-82970ca509df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cabca31e13a6bc979ec5bdf6459c69c0 3x", "genre": "art", "nsfw": false, "body": "こんにちは！またお邪魔します！私はあなたの絵が本当に大好きです!私の日本语はとても上手ではありません、もし间违っているところがあるならば、多く理解して下さい。\nイラストはgoogle driveにある2人のOCです。\nhttps://lemon-beauty-455.notion.site/1e943213d26180fe8c32f7012cb6f505", "created_at": "", "completed_at": ""}, {"path": "/@ku82448/works/316", "thumbnail_src