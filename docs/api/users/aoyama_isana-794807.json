e1/uploads/origins/7cc690e7-f200-4135-a7c1-f54c7243dd3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39d5e8f3714d87b643d36fc7925c2d95 2x, https://si.imgix.net/d3d340e1/uploads/origins/7cc690e7-f200-4135-a7c1-f54c7243dd3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96e534aaa1c3e47aca457a3a20b84605 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/11", "thumbnail_src": "https://si.imgix.net/5573ac76/uploads/origins/15b3b747-74da-4b2c-a7c4-b23fd361a087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1952f835df6c3f5f5961e8fe26c6202d", "thumbnail_srcset": "https://si.imgix.net/5573ac76/uploads/origins/15b3b747-74da-4b2c-a7c4-b23fd361a087?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1952f835df6c3f5f5961e8fe26c6202d, https://si.imgix.net/5573ac76/uploads/origins/15b3b747-74da-4b2c-a7c4-b23fd361a087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a717750d9d00f06efe072611d3c95015 2x, https://si.imgix.net/5573ac76/uploads/origins/15b3b747-74da-4b2c-a7c4-b23fd361a087?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3552afa988ba0765c158afba4da6e429 3x", "genre": "art", "nsfw": false, "body": "青山鯨様、こんばんは！\n以前、野球部の青年をお願いした者です！イラストがとても好みでまたお願いしたく送らせて頂きました！\n差支えなければ、CoCのキャラクター全身立ち絵をお願いできないでしょうか？  \n\n［依頼内容］ \n◆使用用途 \n・利益の発生しない完全個人利用 \n・TRPG CoCでのキャラクターとして利用 \n\n ◆依頼内容 - 概要 \n・キャラクターのスーツ姿を描いていただきたい \n・差分として、段ボール（柄はおまかせ）を頭に被っている姿も描いていただきたい  (顔のみ見えない状態)\n・片手に手斧(持ち手長めでイメージ120〜130cmほど)を持たせていただきたい\n\n◆キャラクター詳細  \n【基本情報】 \n名前：未定 \n年齢：20代前半 \n性別：男性 \n身長：170cm \n職業：刑事   \n\n【容姿】 \n髪：ややグレー寄りの白 \n目：薄縹色 \n表情：やや不機嫌顔（生意気寄り） \n服装：スーツに参考画像のようなコートジャケット（紺色）。\nあとは自由にお任せします。 \n\n雰囲気：生意気でいつも不機嫌そう。中身は頭が弱く、抜けている。\n装飾：右耳にターコイズブルーのピアス。差分で段ボールで顔を隠す（段ボールの柄については本当に自由におまかせです！）   \n\n依頼内容は以上となります。 もし金額が不適切であれば、再送して頂ければと思います！また、難しいと思われましたら、遠慮なくお断りください！  \n素敵な作品を世に生み出してくださり有難う御座います。 \n今後の創作活動を心より応援しております！  どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1eul4ES00Ndzf-zlJYJyGfihrcQEM7200", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/10", "thumbnail_src": "https://si.imgix.net/25b40d10/uploads/origins/54b9f215-45c5-4b0a-a550-69cd7f13cc3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=873d26651906f348ec6f4f2b11b139d1", "thumbnail_srcset": "https://si.imgix.net/25b40d10/uploads/origins/54b9f215-45c5-4b0a-a550-69cd7f13cc3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=873d26651906f348ec6f4f2b11b139d1, https://si.imgix.net/25b40d10/uploads/origins/54b9f215-45c5-4b0a-a550-69cd7f13cc3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f93a274b601ce0f60b7795e2690cc28 2x, https://si.imgix.net/25b40d10/uploads/origins/54b9f215-45c5-4b0a-a550-69cd7f13cc3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4ba535a03d9ebdc5ec056aa9817921a 3x", "genre": "art", "nsfw": false, "body": "青山鯨様\n初めまして。TRPGの探索者の立ち絵をお願いいたしたくリクエスト失礼いたします。\n参考画像が肩上のみの結構な自由形のリクエストになってしまいますので、ご意向にそぐわない場合はキャンセルして頂いて構いませんし、金額不足であれば再送していただけると幸いです。\n\n◇探索者　※ネタバレなどはございません\n出身シナリオ：SEVEN STARS＆PEACE - HO SEVEN STARS\n性別：男\n身長：183cm\n髪：ブロンドのショートヘア、後ろは刈上げ\n眼：青と紫の中間色。切れ長のたれ目。二重がはっきりしている。\n容姿：つり眉、目元に黒子が一つ。口はルージュを塗っている。両耳に同じようにピアスが三つずつ付いている。\n装飾品：目の色と近い同色の丸い色眼鏡\n服装：首元を広く開けている赤いシャツにヒョウ柄のファーが付いている白いジャケットを羽織っている。ズボンは白い細身のもので、靴は黒い革靴。（参考画像で不透明な部分は全体の兼ね合いを見て変えて頂いて大丈夫です。）基本的にだらしのない着方をしているが、色男（APP17）なのでさほど違和感はない。\n性格：ロスでダンサーをしている軟派な男。男女問わず距離が近く、平気で腰を抱き、ハグをし、場合によってはキスもする。\n自分よりも3㎝高い身長の女性が苦手な相棒が居り、そんな男と共に旅をすることに人生をベットしている。そんな人生をさぞ楽しく生きていくという確信を持っている。顔とスタイルの良さに相応の自信がある自信家。酒と踊ることが大好き。相棒も大好き。\n\n◇希望\n透過のものもいただきたいです。\n\n◇使用用途\n立ち絵としての使用、SNSのアイコン、同卓者への共有、個人的な非営利グッズの作成\n\n文章でのご依頼になってしまうのですが、デカい男を好きなように描いていただけると嬉しいです！\nご縁がありましたらご一考頂けると幸いです🌸\n\nhttps://drive.google.com/file/d/1P92TQjVClme9nm9w0vnAE_CinOD1GEAf/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/9", "thumbnail_src": "https://si.imgix.net/a5ebacf7/uploads/origins/31e77874-3e79-47e1-90fa-50c358be9303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61cd8b08092f0a91aa213eab1b31ec69", "thumbnail_srcset": "https://si.imgix.net/a5ebacf7/uploads/origins/31e77874-3e79-47e1-90fa-50c358be9303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61cd8b08092f0a91aa213eab1b31ec69, https://si.imgix.net/a5ebacf7/uploads/origins/31e77874-3e79-47e1-90fa-50c358be9303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=283687d2a5f2885501d10e4d16b25b94 2x, https://si.imgix.net/a5ebacf7/uploads/origins/31e77874-3e79-47e1-90fa-50c358be9303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43a492efdaf561535c9b63a6902a7091 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/8", "thumbnail_src": "https://si.imgix.net/f9b70e57/uploads/origins/09431563-f603-4c1b-a577-c8c35ea17979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c38a63966a629a564d6b38970740fd9", "thumbnail_srcset": "https://si.imgix.net/f9b70e57/uploads/origins/09431563-f603-4c1b-a577-c8c35ea17979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c38a63966a629a564d6b38970740fd9, https://si.imgix.net/f9b70e57/uploads/origins/09431563-f603-4c1b-a577-c8c35ea17979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8ab7073fdf65c42766ac3563eeef942 2x, https://si.imgix.net/f9b70e57/uploads/origins/09431563-f603-4c1b-a577-c8c35ea17979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec91b40355c7a36251a4b29d2554a74f 3x", "genre": "art", "nsfw": false, "body": "いつも素敵な絵をタイムラインで拝見しております。\n今回、自身のTRPGキャラクターのイラストを描いていただきたく思い、青山鯨様にご依頼をさせていただきました。\n\n具体的な依頼内容といたしまして、冬の寒空の下、マグカップで温かな珈琲を飲んでいる下記のキャラクターのイラストを描いていただきたいです。寒い温度下にいるためか鼻や耳の先が少し紅くなっていると可愛くて嬉しいかなと思います。\n構図などは青山様が描いていて楽しんでいただける構図で、ご自由にお任せいたします。\n資料として、既存の立ち絵などを同封したURLを共有させていただきます。\nまた、もしよろしければサインは.psdファイル内の別のレイヤーに作っていただけると嬉しいです。\nお忙しいところ恐縮ですが、お引き受けいただけましたら幸いです。\n\nご検討のほど何卒よろしくお願いします…！\n\n＝＝＝＝＝\n絵の詳細を纏めて以下に記載させていただきます。\n\n【描いていただきたい絵のシチュエーション】\n冬の夜のイメージのイラスト。落ち着いたトーンの、しかしどこかほっこりとした雰囲気でお願いしたいです。\nキャラクターが、どこかのビルの屋上で夜空を見上げてコーヒーを飲んでいるシーン。\n構図については先生が描いていて楽しい、ご自由な構図でお任せいたします。\n＝＝＝＝＝＝＝\n\n【キャラクター設定】\n刑事部捜査一課に所属している警部補。33歳。\nパーマがかかった跳ねた黒髪、スリーピーススーツ、金属フレームの眼鏡が特徴。\n自分の能力をひけらかすような高慢な動きがよく見られる。言ってしまえば噛ませ犬な男。\n陸上インターハイで高い成績を残したことがあり、自らの脚力に対して大きな自信を持っている。\nしかし『それだけしか取り柄がない』とどこか薄っすら思っているフシがあり、一見すると高飛車な気性に反して自己肯定感の低さが見え隠れする。\n（作者としては、なんとなく不憫な悪役令嬢のような印象を個人的にこのキャラクターに感じています）\n\n（ビジュアル情報）\n【身長・体格】\n176cm　62kg\nかなり細身ですらりとした印象。\n\n【配色】\n参考資料参照。\n髪→黒。\n瞳→トーンの落ち着いた青。\n肌→かなり明るめの色。色白。\n服→黒のシャツ+白のネクタイ+群青のスリーピーススーツ+コート\nまた、都合上資料には書かれていないが白の手袋を着用。\nアクセサリーとしてシルバーのピアスをいくつかと、神父のストラのようなものを付けている。\n（お手数ですがニ枚の資料でデザインの齟齬が発生した場合、全身立ち絵の方のデザインを優先していただけると幸いです）\n\n【雰囲気】\n背筋がぴんとした厳しげで神経質そうな男。しかしどこかに憎みきれないような甘さもある。\n\n【服装】\n跳ねた髪。\n\n【イメージカラー】\n9BB4ED（勿忘草色）\n\nhttps://drive.google.com/drive/folders/1rjqeHb1KbW8gFapuN1ZXSQNZY6GntU4x?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/7", "thumbnail_src": "https://si.imgix.net/8bce3749/uploads/origins/5697b4e4-0fd1-4bf3-b853-29815f9bf81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=046cf08a105ddd4b4369bb6e6aa72238", "thumbnail_srcset": "https://si.imgix.net/8bce3749/uploads/origins/5697b4e4-0fd1-4bf3-b853-29815f9bf81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=046cf08a105ddd4b4369bb6e6aa72238, https://si.imgix.net/8bce3749/uploads/origins/5697b4e4-0fd1-4bf3-b853-29815f9bf81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=543c58a253cc6200bcdfe544a0f5f322 2x, https://si.imgix.net/8bce3749/uploads/origins/5697b4e4-0fd1-4bf3-b853-29815f9bf81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f097c1fbbe1406fffcdfec2ce666db16 3x", "genre": "art", "nsfw": false, "body": "https://iachara.com/view/8735222\n\n自分のTRPGのキャラの私服立ち絵の依頼をしたいです。\n新たに得た知識経験はネタバレになってしまうので、開かないでください。\n体育座りの子で、体制は立っていればおまかせします。\n服はジャージや現在のもの以外であればお任せします。普通の服を着せてほしいです\n表情は微笑む程度の笑顔でお願いします。\n\nskeb依頼をしたことが少ないので、注文が拙くて申し訳ありません。", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/6", "thumbnail_src": "https://si.imgix.net/9304359a/uploads/origins/df0348ed-865d-4c82-a579-1c0e0692f8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2a05e2949749f054e0deaa9705e1595", "thumbnail_srcset": "https://si.imgix.net/9304359a/uploads/origins/df0348ed-865d-4c82-a579-1c0e0692f8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2a05e2949749f054e0deaa9705e1595, https://si.imgix.net/9304359a/uploads/origins/df0348ed-865d-4c82-a579-1c0e0692f8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0ea51e9e485561c1cc0dfc0c898f2f2 2x, https://si.imgix.net/9304359a/uploads/origins/df0348ed-865d-4c82-a579-1c0e0692f8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=035c1384815c304d97a59773c6e3793d 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。ざっとうくじらと申します。\nいつも素敵な絵を拝見せていただいています。\n\n\n・要望\n希望するのは武器を持った人物絵 、もしくは顔を隠した容姿の人物絵で描かれたキャラの三面図をお願いしたいです。金額から三面図以外で描けるもの（表情や装飾など）もありましたらお願いしたいです。\n\n\n\nこの度もよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/5", "thumbnail_src": "https://si.imgix.net/bcf8684a/uploads/origins/c9f6d389-ef00-4dd4-a086-b963d50349da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63183f99e355a9e5ba529aa8821e3a36", "thumbnail_srcset": "https://si.imgix.net/bcf8684a/uploads/origins/c9f6d389-ef00-4dd4-a086-b963d50349da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63183f99e355a9e5ba529aa8821e3a36, https://si.imgix.net/bcf8684a/uploads/origins/c9f6d389-ef00-4dd4-a086-b963d50349da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0b3a1000c57f37dd4587f53e1f6f3d7 2x, https://si.imgix.net/bcf8684a/uploads/origins/c9f6d389-ef00-4dd4-a086-b963d50349da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcc9ef221b728d4172621d49cc586c9c 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。ざっとうくじらと申します。\n\n\n\n・要望\n希望するのは武器を持った人物絵です。\n武器の種類など描きやすいもので問題ないです。\n風景など、その他細かな設定もお任せします。\n\n\nこの度もよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@aoyama_isana/works/4", "thumbnail_src": "https://si.imgix.net/03781adc/uploads/origins/dcb096f1-8ea7-46a8-8d7d-0570fbb697d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e86a61a17002c0af8c039e25e61139e", "thumbnail_srcset": "https://si.imgix.net/03781adc/uploads/origins/dcb096f1-8ea7-46a8-8d7d-0570fbb697d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e86a61a17002c0af8c039e25e61139e, https://si.imgix.net/03781adc/uploads/origins/dcb096f1-8ea7-46a8-8d7d-0570fbb697d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d939b1ca212c5304a5d4ab8be1fdc53d 2x, https://si.imgix.net/03781adc/uploads/origins/dcb096f1-8ea7-46a8-8d7d-0570fbb697d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10d1b72d80db8397eba7a39410505dcf 3x", "genre": "art", "nsfw": false, "body": "お世話になっております。ざっとう