dae-a0e8-1ad09d80a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5efd6fe92a644f9ca7899b5725f23c03", "thumbnail_srcset": "https://si.imgix.net/f92c325e/uploads/origins/f3dbab97-da42-4dae-a0e8-1ad09d80a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5efd6fe92a644f9ca7899b5725f23c03, https://si.imgix.net/f92c325e/uploads/origins/f3dbab97-da42-4dae-a0e8-1ad09d80a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05f19d3dbfa7afc1bf4ae23e58053838 2x, https://si.imgix.net/f92c325e/uploads/origins/f3dbab97-da42-4dae-a0e8-1ad09d80a7c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4be793a38424c1e390b3fdfeb3b433d3 3x", "genre": "art", "nsfw": false, "body": "うちのこの曙くんを描いてほしいです！\n\nもし余裕がございましたら、むゆくんテイストの可愛いミニキャラのうちの子も描いてほしいです…！\n着彩はなくていいです。いつもの猫月さんの白黒絵が好きなので！！！！！！構図もお任せします。\n絵柄も寄せなくていいです。猫月さんの思うように描いてほしいです。もう何でもありです。\n\n我 コレ 本気 好　「https://twitter.com/Neko_unkumai/status/1539441489444761600?s=20」\n\nhttps://twitter.com/otenkiyasan_/status/1518528031811600384\n↑この投稿の右の青メッシュの男の子です\n\n何卒…！何卒…！", "created_at": "", "completed_at": ""}]}