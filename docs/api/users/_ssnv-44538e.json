b7/uploads/origins/4f3f6b13-544a-4bbc-a191-e98a71557f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12b6627b4d4a126aad4e1ae778eaaf5", "thumbnail_srcset": "https://si.imgix.net/f1b638b7/uploads/origins/4f3f6b13-544a-4bbc-a191-e98a71557f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12b6627b4d4a126aad4e1ae778eaaf5, https://si.imgix.net/f1b638b7/uploads/origins/4f3f6b13-544a-4bbc-a191-e98a71557f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1386c431dbd33a9440b9f99a8d14cf6 2x, https://si.imgix.net/f1b638b7/uploads/origins/4f3f6b13-544a-4bbc-a191-e98a71557f7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2117841388d47f45547957bda292b1b5 3x", "genre": "art", "nsfw": false, "body": "師匠の闇マキナ＆レイナ見たいです(エッチなやつー)\n具体的なシチュとかは全ておまかせでお願いします…美雲さんじゃなくてゴメンなさい", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/32", "thumbnail_src": "https://si.imgix.net/526e2fe6/uploads/origins/74ea6a92-d40b-436e-b96e-757a7a264494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=849fce15ae7b8bbe98b3296780168165", "thumbnail_srcset": "https://si.imgix.net/526e2fe6/uploads/origins/74ea6a92-d40b-436e-b96e-757a7a264494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=849fce15ae7b8bbe98b3296780168165, https://si.imgix.net/526e2fe6/uploads/origins/74ea6a92-d40b-436e-b96e-757a7a264494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=334062ab5259a92a7d42c76bc040c7db 2x, https://si.imgix.net/526e2fe6/uploads/origins/74ea6a92-d40b-436e-b96e-757a7a264494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b99c887cdce06cf14434bd910d31fe5f 3x", "genre": "art", "nsfw": true, "body": "ささのねこさんの首チンコ絵に多大な衝撃を受けたので自分も依頼させてください。\n即席オリジナルキャラ四人の首チンコすげ替え祭りをお願いします。\n\nＡ：黄色寄りの肌で濃い茶髪、胸は小さめで小柄な少女\nＢ：ピンク寄りの濃い目の肌で薄い茶髪、年齢や体格はＡと同じぐらい\nＣ：色白の肌で金髪、そこそこ巨乳（手の平サイズ）でＡＢよりも年上のお姉さん\nＤ：濃い褐色肌で黒髪、ダントツで一番爆乳（頭ぐらいデカい）で最年長\n\n首と身体がゴチャゴチャ入り乱れているのを絵的にわかりやすくするために肌の色の差はしっかり強調してください。\nこれ以上の細かい顔つきや髪型や性格などは好みにお任せします。全員全裸で首チンコ化してます。\n\nＡの身体はＢの首チンコを持ち、座っているＣの首マンコに、根本まで竿を挿入している。\nＢの身体はＡの首チンコを持ち、座っているＤの首マンコに、亀頭をあてがっている。\nＣの身体はぺたん座りをして、Ｄの首チンコをふとももに優しく置くように抱え、上からＢの首チンコを挿入されている。\nＤの身体はあぐらをかいて、Ｃの首チンコを左手で持ちつつ右手で亀頭をいじり、上からＡの首チンコを入れられようとしている。\n\nかなりややこしいですが、大まかな位置取りは\n身体が　Ａは左奥、Ｂは右奥、Ｃは左手前、Ｄは右手前\n首チンコが　Ａは右上、Ｂは左上、Ｃは右下、Ｄは左下\nとなります。\n\n状況設定としては、ＣＤの身体を使ってＡＢが相手の首チンコをイかせる早さを競っているという感じです。\nみんな仲良くワイワイキャッキャと楽しんでいる様子が良いです。\nこれが終わった後も四人がそれぞれ位置を交代したりして遊びが続いていくという雰囲気にしてください。\nささのねこさんの絵は台詞付きが多いですが、キャラの名前が必要だったら適当に決めちゃってください。\n名前が出ない台詞選びでも構いません。\n\n以上です。よろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/31", "thumbnail_src": "https://si.imgix.net/7fc8f845/uploads/origins/c8588c66-0def-417c-8d53-847da2d82085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19402200991e00a4a8abb8d7a7e87ec0", "thumbnail_srcset": "https://si.imgix.net/7fc8f845/uploads/origins/c8588c66-0def-417c-8d53-847da2d82085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19402200991e00a4a8abb8d7a7e87ec0, https://si.imgix.net/7fc8f845/uploads/origins/c8588c66-0def-417c-8d53-847da2d82085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a30484ec0e0db0bfeb1b14fdafa6d569 2x, https://si.imgix.net/7fc8f845/uploads/origins/c8588c66-0def-417c-8d53-847da2d82085?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00856d10620a2fa03408ec7a4147522b 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/30", "thumbnail_src": "https://si.imgix.net/186b6d30/uploads/origins/ccc7e272-4fb7-4e63-a2cf-c1e01d1c77d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f418d0dde304767212b4a5babfea9a17", "thumbnail_srcset": "https://si.imgix.net/186b6d30/uploads/origins/ccc7e272-4fb7-4e63-a2cf-c1e01d1c77d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f418d0dde304767212b4a5babfea9a17, https://si.imgix.net/186b6d30/uploads/origins/ccc7e272-4fb7-4e63-a2cf-c1e01d1c77d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa2a112648cf42b7adf4f98d2167ba1e 2x, https://si.imgix.net/186b6d30/uploads/origins/ccc7e272-4fb7-4e63-a2cf-c1e01d1c77d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24833c6dc681ebd156fc309c55e6ba03 3x", "genre": "art", "nsfw": true, "body": "「首チンコ改修を経てすっかりチンコにハマってしまったオイゲンちゃん、自分から望んで身体部分も乳首チンコ＋ふたなりモデルに改修してもらい、その感謝を込めて提督の前でお披露目オナニー」という特殊極まりないシチュエーションですがリクエストお願いします。\n（提督視点で、提督は映さなくて大丈夫です）\n\nボディ部分は資料URLの八尺様並のおっぱい＆ふたなりに両乳首にチンポを生やしたもので、エロ蹲踞orガニ股立ちのポーズでセルフパイズリしながら両手で両乳首を扱き、気持ちよく射精＆潮吹きさせてください。\n\nすっかり乳首チンコオナニーに夢中になっており、表情は気持ちよさそう＆嬉しそうで、提督に「改修してくれてありがとうございます♡」とか「おちんぽ射精見てください♡」などといったスケベな状況説明をしなながらオナニーに興じるオイゲンをお願いします。\n\nhttps://www.pixiv.net/artworks/92679486", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/29", "thumbnail_src": "https://si.imgix.net/a9f375e9/uploads/origins/550db99d-e039-4086-bbc2-245c4943f329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac7a8ceea1df276c232c09be91372538", "thumbnail_srcset": "https://si.imgix.net/a9f375e9/uploads/origins/550db99d-e039-4086-bbc2-245c4943f329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac7a8ceea1df276c232c09be91372538, https://si.imgix.net/a9f375e9/uploads/origins/550db99d-e039-4086-bbc2-245c4943f329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3c6fa426856f928dd2f22167983b56d 2x, https://si.imgix.net/a9f375e9/uploads/origins/550db99d-e039-4086-bbc2-245c4943f329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=febf266c2ebedc218cc0d8c5ca159d0e 3x", "genre": "art", "nsfw": true, "body": "こんにちは。\n前回描いて頂いた斉藤洋子さんと若林智香ちゃんの絵が大変良かったので、同じ2人で描いて頂きたいです。\n内容としては、二人で抱き合って舌を絡ませてキスしながらのふたなり百合えっちで、\n射精しそうになった智香ちゃんが抜こうとするのを洋子さんが足で抱え込んで優しく中で受け止めてあげる、といったシチュエーションをお願いします。\n中に出した精液が溢れ出てくる所など描いて頂けると嬉しいです。", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/28", "thumbnail_src": "https://si.imgix.net/d27f6ccd/uploads/origins/3e6b6d2f-2d76-4578-bcec-da424ff8299c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4de606111280fba8d441baedacae8a78", "thumbnail_srcset": "https://si.imgix.net/d27f6ccd/uploads/origins/3e6b6d2f-2d76-4578-bcec-da424ff8299c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4de606111280fba8d441baedacae8a78, https://si.imgix.net/d27f6ccd/uploads/origins/3e6b6d2f-2d76-4578-bcec-da424ff8299c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb122795670ea39dfd69912b77ce8100 2x, https://si.imgix.net/d27f6ccd/uploads/origins/3e6b6d2f-2d76-4578-bcec-da424ff8299c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b72fe7ca047e43b3640ced506c7f21cc 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/27", "thumbnail_src": "https://si.imgix.net/5ab88d38/uploads/origins/0a353f39-9b7d-44c4-add7-f41354cb43d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f77999c20ea4b0ac39ab9ed5736751f2", "thumbnail_srcset": "https://si.imgix.net/5ab88d38/uploads/origins/0a353f39-9b7d-44c4-add7-f41354cb43d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f77999c20ea4b0ac39ab9ed5736751f2, https://si.imgix.net/5ab88d38/uploads/origins/0a353f39-9b7d-44c4-add7-f41354cb43d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa7e8bcdf84c636bda154f7e334756f3 2x, https://si.imgix.net/5ab88d38/uploads/origins/0a353f39-9b7d-44c4-add7-f41354cb43d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d955853f3bac270fbbac23ec78ab8f7f 3x", "genre": "art", "nsfw": true, "body": "ご無沙汰しております…久々にリクエストできると聞いて、また艦これドイツ艦娘の首チンコをお願いします。\nグラーフ・ツェッペリン( https://kancolle.fandom.com/wiki/Graf_Zeppelin/Gallery )と、呂500( https://kancolle.fandom.com/wiki/U-511/Gallery )の2人のカラミです。\n\n——————————\n\nグラーフの首が巨根すぎて(オイゲン<グラーフ≦ビスマルクくらい)、ろーちゃんのボディに入りきらず、2人がかりでグラーフのツインテ&もみあげをハンドルみたいに掴んでグイグイ押し込もうとしている状態(痛がってない)\nろーちゃんの首チンコは抜けていて、日焼け跡がクッキリ見えている感じで、処遇はお任せします。\n\n入りきらないまま絶頂を迎えて、ろーちゃんボディが膨れるほど射精して、下のマンコからもビュービュー漏れてる場面も描いていただきたいです。\nその際、グラーフの直穿き黒タイツにも精液飛ばしてください。\n\n——————————\n\nあと、追加で可能であればなんですが、艦これには「空母は卵生」というネタがありまして…\nグラ子の上下のマンコから、絶頂と同時に産卵する描写を盛り込んでいただけないかと思います。\nhttps://www.pixiv.net/artworks/81141883\nhttps://www.pixiv.net/artworks/80565449\nhttps://www.pixiv.net/artworks/79203983\nhttps://www.pixiv.net/artworks/66818476\nhttps://www.pixiv.net/artworks/93016513\nこのあたりが参考になれば幸いです。\n\nついでにグラーフのもみあげ&ツインテハンドルも4本のちんぽになってたりすると嬉しいです。\nhttps://www.pixiv.net/artworks/93498177\n\n——————————\n\nとりあえず絶対見たいポイントは、ろーちゃんの首チンコ日焼け跡ですので、描きづらい点があればシチュなど適宜変えていただいて構いません。グラーフの産卵と髪チンポもついでのお願いですので、絵的にちょっと…という場合はどちらかとか、両方無視していただいても全く構いません。\n長々と申し訳ありませんが、ご検討よろしくお願いします！", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/26", "thumbnail_src": "https://si.imgix.net/9acc01da/uploads/origins/5fe01405-7495-4833-ab15-0df53fb3dc23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489bc0d1bc3b3968e9c51e0f9a626377", "thumbnail_srcset": "https://si.imgix.net/9acc01da/uploads/origins/5fe01405-7495-4833-ab15-0df53fb3dc23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=489bc0d1bc3b3968e9c51e0f9a626377, https://si.imgix.net/9acc01da/uploads/origins/5fe01405-7495-4833-ab15-0df53fb3dc23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e9066505f950a856d28dff2cf521a5d 2x, https://si.imgix.net/9acc01da/uploads/origins/5fe01405-7495-4833-ab15-0df53fb3dc23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3563acdda195a4607a4dc07910e91c6f 3x", "genre": "art", "nsfw": true, "body": "いつもイラスト楽しませて頂いています。\nよかったらリクエストお願いできませんか。\n＜キャラクター＞MEIKO、巡音ルカ、初音ミク\n＜シチュエーション＞3人でレズセックスしてるところをお願いします。誰に付いてる付いてないはお任せします。全員ふたなりでも全員付いてなくても何でもいいです。\n＜その他＞3人とも気持ちよさそうなのが希望です。その他詳細は全てお任せします。\nご検討の程よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/25", "thumbnail_src": "https://si.imgix.net/62c39365/uploads/origins/8ccee41b-b8f1-4cfc-801d-c23f742a60ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=516e6a1845e7081403a073a38e830a7f", "thumbnail_srcset": "https://si.imgix.net/62c39365/uploads/origins/8ccee41b-b8f1-4cfc-801d-c23f742a60ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=516e6a1845e7081403a073a38e830a7f, https://si.imgix.net/62c39365/uploads/origins/8ccee41b-b8f1-4cfc-801d-c23f742a60ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c0cb3a6e29082fdb3d06e1d5655d2f6 2x, https://si.imgix.net/62c39365/uploads/origins/8ccee41b-b8f1-4cfc-801d-c23f742a60ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7dc4735daf7ee65698db674cc2263e3 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/24", "thumbnail_src": "https://si.imgix.net/cfa7cbbf/uploads/origins/80c25244-202f-41a1-9708-edbc4801d731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903c8b3828f99f8266f85c0edc8569d9", "thumbnail_srcset": "https://si.imgix.net/cfa7cbbf/uploads/origins/80c25244-202f-41a1-9708-edbc4801d731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=903c8b3828f99f8266f85c0edc8569d9, https://si.imgix.net/cfa7cbbf/uploads/origins/80c25244-202f-41a1-9708-edbc4801d731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56d5763d517cf62ba5c05f3610a87715 2x, https://si.imgix.net/cfa7cbbf/uploads/origins/80c25244-202f-41a1-9708-edbc4801d731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=505d1f1ae94e990cf664404ce21ae2f2 3x", "genre": "art", "nsfw": true, "body": "毎度どうもお世話になっております…\nしつこいようで恐縮ですが、艦これドイツ艦娘の首チンコ、またお願いしたくリクエスト出させてください。\n\n相手の首を下のまんこに挿入して、上のまんこまで精液どっぴゅん貫通させちゃう、プリンツオイゲン×ビスマルクの首チンコ交換プレイをお願いします。\n公式でもオイゲン→ビスマルクは「ビスマルク姉様❤️」とかなりお熱く慕ってるので(ビスプリってカプタグもあるくらい)、特にナメクジのように濃厚でレズレズしい絡みを描いていただきたいです。\n\n実際の軍艦でもシルエットを似せて設計されたそうなんですが、「大砲」の大きさが違うので、ビスマルク姉様のちんぽは特にでっっかくしていただけると嬉しいです。いっそ亀頭が上からコンニチハしててもいいかも…？(ご判断にお任せします)\nご検討よろしくお願いします。\n\nhttps://kancolle.fandom.com/wiki/Bismarck/Gallery", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/23", "thumbnail_src": "https://si.imgix.net/8240ea86/uploads/origins/ad65f39c-1e93-4698-ab5e-27a8920845d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4ad8aaa7cb07db04e6f4cf722e20d0d", "thumbnail_srcset": "https://si.imgix.net/8240ea86/uploads/origins/ad65f39c-1e93-4698-ab5e-27a8920845d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4ad8aaa7cb07db04e6f4cf722e20d0d, https://si.imgix.net/8240ea86/uploads/origins/ad65f39c-1e93-4698-ab5e-27a8920845d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3485e6e555446cca9b17e2af6d5faa5b 2x, https://si.imgix.net/8240ea86/uploads/origins/ad65f39c-1e93-4698-ab5e-27a8920845d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8c17a08be0cf5e49ee8049facb201f3 3x", "genre": "art", "nsfw": true, "body": "オイゲンの首チンコが性癖だったので、首チンコイラストお願いいたします。\n\nキャラ：プリンツ・オイゲン＆呂500（資料URL参照、褐色肌のほうです）\n\nシチュエーション：\nプリンツ・オイゲン・・・\n自分の首チンコ＆頭部を赤ちゃんのようにだっこしているが、その両手は自分の首チンコを撫でるように弄りまわしていて、首チンコは射精を繰り返している\n頭部は、射精快楽に溺れながら、自分のおっぱいにむしゃぶりついている\n\n呂500・・・\nオイゲンの後ろから、自分の首チンコをオイゲンの首マンコに挿入して、やはり快楽に溺れきった表情\n\nふたりとも首チンコ射精快楽の虜になっていて、改造してもらって嬉しそうな感じで\n\nhttps://kancolle.fandom.com/wiki/U-511#Second_Upgrade", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/22", "thumbnail_src": "https://si.imgix.net/76c8d588/uploads/origins/74a3ead5-18d8-47fd-864d-f10c17d65851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e56b2e3e5bed16e30aea564afe3b3a2", "thumbnail_srcset": "https://si.imgix.net/76c8d588/uploads/origins/74a3ead5-18d8-47fd-864d-f10c17d65851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e56b2e3e5bed16e30aea564afe3b3a2, https://si.imgix.net/76c8d588/uploads/origins/74a3ead5-18d8-47fd-864d-f10c17d65851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8203b764f96f85aed4e88a7195707c77 2x, https://si.imgix.net/76c8d588/uploads/origins/74a3ead5-18d8-47fd-864d-f10c17d65851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6c3822041165bf2a9e2ddd1d2019087 3x", "genre": "art", "nsfw": true, "body": "超時空要塞マクロス愛おぼえていますか\nのリン・ミンメイが、最終決戦時の衣装\nを着たまま、ぺたん座りの姿でふたなり\nおちんちんをシコシコとしごいて、自慰\nに耽った挙句に、射精してしまう様子を\n描いていただきたいのですが、よろしく\nお願いいたします。", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/21", "thumbnail_src": "https://si.imgix.net/5f87dabb/uploads/origins/5e1f4ec3-4abc-40a3-927e-3a2990e68a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee525a006adf00ee0a1a55e69292b07", "thumbnail_srcset": "https://si.imgix.net/5f87dabb/uploads/origins/5e1f4ec3-4abc-40a3-927e-3a2990e68a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ee525a006adf00ee0a1a55e69292b07, https://si.imgix.net/5f87dabb/uploads/origins/5e1f4ec3-4abc-40a3-927e-3a2990e68a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99b6be4dae63e10413ae660197a67f4b 2x, https://si.imgix.net/5f87dabb/uploads/origins/5e1f4ec3-4abc-40a3-927e-3a2990e68a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c45ca74bc51ac4b78e26a97bfd76ac7 3x", "genre": "art", "nsfw": true, "body": "はじめまして。\n22/7から、滝川みうと丸山あかねのフタナリH絵をお願いします。\n\n・2人ともふたなりで全裸\n・騎乗位であかねがみうに挿入、みうはべちょべちょのザーメンティッシュを嗅いでいる\n・2人同時に絶頂、すごい勢いで射精しているところ\n\nというシチュエーションでお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/20", "thumbnail_src": "https://si.imgix.net/756cb090/uploads/origins/d3a8eb2e-3a12-4b07-9801-20dc1a96ce31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235f9f5ef43a94fcaeff53ad05a91927", "thumbnail_srcset": "https://si.imgix.net/756cb090/uploads/origins/d3a8eb2e-3a12-4b07-9801-20dc1a96ce31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=235f9f5ef43a94fcaeff53ad05a91927, https://si.imgix.net/756cb090/uploads/origins/d3a8eb2e-3a12-4b07-9801-20dc1a96ce31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44febae1a94bc9b39c23d8ecd149863e 2x, https://si.imgix.net/756cb090/uploads/origins/d3a8eb2e-3a12-4b07-9801-20dc1a96ce31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5aff16968e00757e200ad0469282bc9b 3x", "genre": "art", "nsfw": true, "body": "基本的には闇雲のエッチなものが見たいです！\nもちろんマクロスから~\nポーズは考えていませんが、彼女が自慰行為をしているのを見たいと思います", "created_at": "", "completed_at": ""}, {"path": "/@_ssnv/works/19", "thumbnai