きった様子（全身が変色で覆われ、敵にぐったり体を預けてしまっている）までいたければ嬉しいです。\nもちろん無視いただいても構いません。\n\nよかったらよろしくお願いします。", "created_at": "", "completed_at": ""}, {"path": "/@Cho2Ipl/works/12", "thumbnail_src": "https://si.imgix.net/aafbdb48/uploads/origins/23f6001b-5aff-4772-9661-8ba889fdd0d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d016b212f0cbd2ff789296d45ae1ab1", "thumbnail_srcset": "https://si.imgix.net/aafbdb48/uploads/origins/23f6001b-5aff-4772-9661-8ba889fdd0d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d016b212f0cbd2ff789296d45ae1ab1, https://si.imgix.net/aafbdb48/uploads/origins/23f6001b-5aff-4772-9661-8ba889fdd0d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51677ca399762ec80c7cb0357d998ea2 2x, https://si.imgix.net/aafbdb48/uploads/origins/23f6001b-5aff-4772-9661-8ba889fdd0d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ac0d216a1c29bf879691b0845660b82 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@Cho2Ipl/works/11", "thumbnail_src": "https://si.imgix.net/e523a9fb/uploads/origins/83e00633-1bd8-4e04-880e-27b1ff39724f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c64631ac6b4b373e4abc12594dc589b1", "thumbnail_srcset": "https://si.imgix.net/e523a9fb/uploads/origins/83e00633-1bd8-4e04-880e-27b1ff39724f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middl