3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f1c45057e590935c0af544aaeb82b1d", "thumbnail_srcset": "https://si.imgix.net/c2ee1c72/requests/235720_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f1c45057e590935c0af544aaeb82b1d, https://si.imgix.net/c2ee1c72/requests/235720_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2abf1b12a90e7b6fd0923c9141202478 2x, https://si.imgix.net/c2ee1c72/requests/235720_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33ddfef567e2fd9c0dee02d0720be966 3x", "genre": "art", "nsfw": false, "body": "初めまして、TwitterでフォローさせていただいておりますThoma（@fujisan_alter）と申します。\n\nシャニマスのイラストをお願いできればと思います。\n「霧子がお花に水をあげてるのを円香が隣で見てる｣と言うシチュエーションでよろしくお願いします。\n\nまた、作者明記の上、Twitterのアイコンとして使用させていただければと思います。\nご検討よろしくお願い致します。", "created_at": "", "completed_at": ""}, {"path": "/@ikapeace04/works/5", "thumbnail_src": "https://si.imgix.net/27ca5c09/requests/180949_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b74589f8eda4c131e4f9c09b4fbfa038", "thumbnail_srcset": "https://si.imgix.net/27ca5c09/requests/180949_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b74589f8eda4c131e4f9c09b4fbfa038, https://si.imgix.net/27ca5c09/requests/180949_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba0355fa770691698d2948b1a294816e 2x, https://si.imgix.net/27ca5c09/requests/180949_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1efa30c5978f76030edd53ce65e723df 3x", "genre": "art", "nsfw": false, "body": "初めまして、いつもシャニの可愛らしい絵を楽しませていただいてます。\n越境地雷じゃなければ、シャニの甘奈ちゃんと『Tokyo 7th シスターズ』（ナナシス）の臼田スミレちゃんとのツーショットをお願いしたいです。SNS用に自撮りをしてるか、楽屋でお喋りしてるかのどちらかのシチュで。", "created_at": "", "completed_at": ""}, {"path": "/@ikapeace04/works/4", "thumbnail_src": "https://si.imgix.net/f68ec70b/requests/135250_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db86bc