c8-d8ccbaffa289?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30a919d25db8ecb55172f7e0b90bed52", "thumbnail_srcset": "https://si.imgix.net/7b38e934/uploads/origins/203cbac4-0983-4ae6-b2c8-d8ccbaffa289?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30a919d25db8ecb55172f7e0b90bed52, https://si.imgix.net/7b38e934/uploads/origins/203cbac4-0983-4ae6-b2c8-d8ccbaffa289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0540cbe00559ce4764fdb44abd6b8f07 2x, https://si.imgix.net/7b38e934/uploads/origins/203cbac4-0983-4ae6-b2c8-d8ccbaffa289?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18efdf9378239a5d83c425324cb5f7c2 3x", "genre": "art", "nsfw": false, "body": "831さん、再びこんにちは！今回もイラストの依頼をしてしまい申し訳ありません。今回も同じ2キャラでお願いしたいと思います！\nhttps://skeb.jp/@831too/works/147\nhttps://skeb.jp/@831too/works/169\n\n王は憂いを帯びた表情をしてほしい。彼は自分がこの世界の救世主になる運命の持ち主でないことを知りながら、とにかくその重荷を背負うことを選んだ。ウリエルのこの世界での存在がすでに出来事の流れを変えてしまったため、彼女は告白し、彼の犠牲が何度も繰り返されるだけだというこの世界の真実を彼に伝えるが、王は自分が知っていることを認める。彼は失敗したサイクルをすべて覚えており、その記憶をすべて保持している。彼は、数え切れないほどの失敗の末に、自分が民の友人や仲間をより良い明日へと導く価値があるのかどうか、自問し、自問を表明し始める。私は、ウリエルが彼の唇にキスを押し当てて黙らせるのを見たい。構図はご自由に弄ってください！いつも応援とご配慮をありがとうございます！\n\nhttps://drive.google.com/drive/folders/1i8vUX4Zbe-q0MgdVwSpvxws5ObL1WI36?usp=sharing\nhttps://drive.google.com/drive/folders/1OUEPhK2WJ-urei8j2xCywzD1131XlgUk?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@831too/works/186", "thumbnail_src": "https://si.imgix.net/4f3b5342/uploads/origins/82457547-9679-4601-b8fc-d9a53f384091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=253622e0be06e948db5added9628e8c9", "thumbnail_srcset": "https://si.imgix.net/4f3b5342/uploads/origins/82457547-9679-4601-b8fc-d9a53f384091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=253622e0be06e948db5added9628e8c9, https://si.imgix.net/4f3b5342/uploads/origins/82457547-9679-4601-b8fc-d9a53f384091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bc84dd891a72ba6b3e5278d044c603a 2x, https://si.imgix.net/4f3b5342/uploads/origins/82457547-9679-4601-b8fc-d9a53f384091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdba14fe87039eacbd8fee52f6c62c6e 3x", "genre": "art", "nsfw": false, "body": "初めまして。先生の作品から感じられる独特の映画的な雰囲気と、美しい画風にすっかり惹きつけられました。ぜひ一度、私のオリジナルキャラクターを描いていただきたく、リクエストをお送りいたしました。\n\nキャラクターの詳細はリンク先に記載しております。服装やポーズ、全体の雰囲気などは、先生のご自由な発想にお任せできれば幸いです。\n\nご検討のほど、何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1QKthozfxdVVhqHOS-VuL9QuSmpOqp8nF?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@831too/works/185", "thumbnail_src": "https://si.imgix.net/a9836939/uploads/origins/cab8cf6b-e313-4e92-8d4b-30d161f6fc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f3f7612a85e0d9c833b3d8b49c14cbc", "thumbnail_srcset": "https://si.imgix.net/a9836939/uploads/origins/cab8cf6b-e313-4e92-8d4b-30d161f6fc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f3f7612a85e0d9c833b3d8b49c14cbc, https://si.imgix.net/a9836939/uploads/origins/cab8cf6b-e313-4e92-8d4b-30d161f6fc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=006ce6aff506f2a414eb8dd1068225b1 2x, https://si.imgix.net/a9836939/uploads/origins/cab8cf6b-e313-4e92-8d4b-30d161f6fc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e760a9085d521d4d56b13968bef6fc5 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@831too/works/184", "th