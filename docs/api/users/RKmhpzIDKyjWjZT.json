52/uploads/origins/a5d11ba3-8c2e-4be7-a4d7-a6c148244e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d17612cb851dfdffef99596d8037f3cc", "thumbnail_srcset": "https://si.imgix.net/1df97352/uploads/origins/a5d11ba3-8c2e-4be7-a4d7-a6c148244e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d17612cb851dfdffef99596d8037f3cc, https://si.imgix.net/1df97352/uploads/origins/a5d11ba3-8c2e-4be7-a4d7-a6c148244e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09058b48ebf27f1ce2ca76a8afa1cbf7 2x, https://si.imgix.net/1df97352/uploads/origins/a5d11ba3-8c2e-4be7-a4d7-a6c148244e12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bae44b42779c90fca02d4a44a457e3e2 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RKmhpzIDKyjWjZT/works/23", "thumbnail_src": "https://si.imgix.net/f165cb60/uploads/origins/d3e3fd04-6036-4e41-8724-290f190a394d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58e1928ccb7aa09629f559b404a8285d", "thumbnail_srcset": "https://si.imgix.net/f165cb60/uploads/origins/d3e3fd04-6036-4e41-8724-290f190a394d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58e1928ccb7aa09629f559b404a8285d, https://si.imgix.net/f165cb60/uploads/origins/d3e3fd04-6036-4e41-8724-290f190a394d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=592111adb15a1c77ed0eee7d00749c90 2x, https://si.imgix.net/f165cb60/uploads/origins/d3e3fd04-6036-4e41-8724-290f190a394d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=744f6f46f0f16e7ceedb72319ab1c3ad 3x", "genre": "art", "nsfw": true, "body": "今回は珍しく漫画をお願いします！\n以下依頼内容\n\n慧音先生の寺子屋にて体育の時間\nヘソ出しミニ体操服とTバックブルマ、のーぶらのーぱん姿で\n「寺子屋体操第一」を新入生達に披露する大ちゃんとチルノちゃん\nラジオ体操みたいな音楽とアナウンスに合わせて仲良く体操を始めるが\n実はこれ慧音先生が楽しむために作ったえっちな内容のモノであった\n\nちなみに大ちゃんは意味を理解してるので、ウィンクしてハート飛ばしたり\n上目遣いで見つめたりと非常にあざとく\nチルノちゃんは何もわかってないので無邪気で大胆に動きます\n\n一応感じを掴んでもらうためにアナウンス書いてみましたが\nアレンジなりカットなり削除なり、そこいらは自由にして下さい\nあと体操全部は大変なのでダイジェストで４つをお願いします\n\nアナウンス\n「まずはお口の運動から\n透明なアイスを～やさしく握り、舐めてっしゃぶってっ吸い付きましょう」\n\n「次は胸の運動～\n左右から両手で挟んで～、寄せてっあげてっ離してっ寄せるっ」\n\n「お尻の運動～\nお尻を突き出し見せ付ける様に、みぎにっひだりにっ振りましょう」\n\n「アソコの運動\n座って股を開きアソコを～、ひらいて～とじてっひらいてっとじて～」\n\nそして最後のコマで慧音先生が\n「さぁ覚えたな？！次はお前たち新入生の番だ！（ハァハァ・・・！」\nと小傘ちゃんとぬえちゃんに、ゆっくりとにじり寄っていく\n\n内容は以上です\n\n２シーンを１枚にまとめる感じで\n全３ページくらいでどうにかと考えておりますが\nページが増えたならそこはキッチリ対応します\nあと全裸差分も是非欲しいです！", "created_at": "", "completed_at": ""}, {"path": "/@RKmhpzIDKyjWjZT/works/22", "thumbnail_src": "https://si.imgix.net/5dd91b07/uploads/origins/0cd82ead-0575-42a3-ac71-a3d1abf56a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8e3e1f29aec91293f2bd05825885923", "thumbnail_srcset": "https://si.imgix.net/5dd91b07/uploads/origins/0cd82ead-0575-42a3-ac71-a3d1abf56a79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8e3e1f29aec91293f2bd05825885923, https://si.imgix.net/5dd91b07/uploads/origins/0cd82ead-0575-42a3-ac71-a3d1abf56a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2062f9d2fed28f7900c2d8a1f9ec444f 2x, https://si.imgix.net/5dd91b07/uploads/origins/0cd82ead-0575-42a3-ac71-a3d1abf56a79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1706da2ac1d8565b3fdf5946d3b28747 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RKmhpzIDKyjWjZT/works/21", "thumbnail_src": "https://si.imgix.net/7a813b67/uploads/origins/5a765b70-d603-4f7b-b30d-e92009a60b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb0c224218d4d946138eb60304dd5eb0", "thumbnail_srcset": "https://si.imgix.net/7a813b67/uploads/origins/5a765b70-d603-4f7b-b30d-e92009a60b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb0c224218d4d946138eb60304dd5eb0, https://si.imgix.net/7a813b67/uploads/origins/5a765b70-d603-4f7b-b30d-e92009a60b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70650f9d4750e34ac0781f8b2c3b21dc 2x, https://si.imgix.net/7a813b67/uploads/origins/5a765b70-d603-4f7b-b30d-e92009a60b1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be8ea1a1919f5b1c18692306dddb1b48 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@RKmhpzIDKyjWjZT/works/20", "thumbnail_src": "https://si.imgix.net/8babdb76/uploads/origins/7e417a50-fa28-48bb-a3ab-48c76455811b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10bd2105a0006e9e6e986c83e38b76df", "thumbnail_srcset": "https://si.imgix.net/8babdb76/uploads/origins/7e417a50-fa28-48bb-a3ab-48c76455811b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10bd2105a0006e9e6e986c83e38b76df, https://si.imgix.net/8babdb76/uploads/origins/7e417a50-fa28-48bb-a3ab-48c76455811b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e50aa57bf9c45cced8a83bb8941d430 2x, https://si.imgix.net/8babdb76/uploads/origins/7e417a50-fa28-48bb-a3ab-48c76455811b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b30991232f01ed9401739086666c3d4 3x", "genre": "art", "nsfw": true, "body": "マリー様で即落ち２コマをお願いします！\n以下依頼内容\n\n一枚目は求人のチラシをみたマリー様が\n「なに？！寝そべってじっとしてるだけの簡単なお仕事じゃと！？」\nとめっちゃ食いついてる場面\n\n二枚目が大胆に股を広げて寝そべる全裸のマリー様\n後ろには「女体盛りデザートの部」と垂れ幕があり\n乳首にはチェリーが乗っけられて、その周りはホイップクリームでデコレート\nおへその周りにはスライスしたキウイフルーツを並べて\nアソコにはバナナをぶっさしてくださいｗ\n「だまされたのじゃぁ・・・あっ、あんっ・・・ばなな・・・ぉっきぃ」\nみたいなセリフもお願いします\n\n二枚目には出来ればでいいのですが差分も欲しいです\nバナナを激しく出し入れされて\n「うごかすなぁあ？！あっ、あっ、あっ！」\nみたいなのと\n\n「だめだめイッちゃうーーーーーっ！！！」\nと塩を吹きまくるの\n\nあとフルーツ取っ払った差分もあると\n非常に捗って嬉しいですｗ。", "created_at": "", "completed_at": ""}, {"path": "/@RKmhpzIDKyjWjZT/works/19", "thumbnail_src": "https://si.imgix.net/8fc0dd6a/uploads/origins/94d2c958-c4b2-48e3-8f72-72d65ac88b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b1f572c8947d58f752f5294348ca29", "thumbnail_srcset": "https://si.imgix.net/8fc0dd6a/uploads/origins/94d2c958-c4b2-48e3-8f72-72d65ac88b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22b1f572c8947d58f752f5294348ca29, https://si.imgix.net/8fc0dd6a/uploads/origins/94d2c958-c4b2-48e3-8f72-72d65ac88b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e684dfa77d5e2dfdbf13483f65568e8 2x, https://si.imgix.net/8fc0dd6a/uploads/origins/94d2c958-c4b2-48e3-8f72-72d65ac88b7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71f5764179fc09e2fea3d37cc5e475e3 3x", "genre": "art", "nsfw": true, "body": "以前お願いした大ちゃんが非常に気に入ってしまいました\nなのでどうしても立ち絵も欲しくてたまらないのです！\n以下依頼内容\n\n大ちゃんの立ち絵を普段着姿でお願いします\nあと全裸差分を熱望します！！", "created_at": "", "completed_at": ""}, {"path": "/@RKmhpzIDKyjWjZT/works/18", "thumbnail_src": "https://si.imgix.net/9cf42