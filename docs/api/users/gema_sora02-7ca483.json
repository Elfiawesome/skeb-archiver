4b25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a077f2f96efacb2099ddedb067776aa5, https://si.imgix.net/ea64618e/uploads/origins/37a08fc1-9e23-4fc8-a134-0982dc4b25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7037689a193d519f7507dad45b148e9 2x, https://si.imgix.net/ea64618e/uploads/origins/37a08fc1-9e23-4fc8-a134-0982dc4b25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85845e3f5bdd67c5b1bd211bf6f5caa4 3x", "genre": "art", "nsfw": true, "body": "めちゃくちゃ良かったので早速ですがまたお願いいたします...！\n\n【キャラクター】\n資料URLのうちの子「リュコス（3枚目）」\n\n【シチュエーション等】\n結果を残した新入生がご褒美としてリュコスを使っている、というシチュエーションでお願いいたします。\n\n・場所は部室のロッカールームといった雰囲気の場所\n・服装は前回同様逆競泳水着\n・体位は膝立ち後背位で胸を揉みながら挿入している状態で、服装が見えるような構図にしていただけると嬉しいです。\n・男はここで童貞を捨てられるという興奮で、ひたすら腰を打ち付けている感じ\n・リュコスは嫌々ながらも感じている表情・喘ぎ声\n・リーダーの男の煽るような台詞（「童貞卒業おめでと～笑」や「タイム良くなったし備品大活躍だな笑」のような感じ）を入れていただけると幸いです。\n\n今回も難しい部分などは適宜改変していただければと思います。\n是非ご検討いただけると幸いです。\n\nhttps://twitter.com/terrorzero02/status/1706345154171580841", "created_at": "", "completed_at": ""}, {"path": "/@gema_sora02/works/39", "thumbnail_src": "https://si.imgix.net/4c884f66/uploads/origins/e37baa13-4821-4fcf-8d7c-ac05562adf2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e0ec10842f3578a355b1969db818d6", "thumbnail_srcset": "https://si.imgix.net/4c884f66/uploads/origins/e37baa13-4821-4fcf-8d7c-ac05562adf2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e0ec10842f3578a355b1969db818d6, https://si.imgix.net/4c884f66/uploads/origins/e37baa13-4821-4fcf-8d7c-ac05562adf2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9780fcb160620d69c3a61016d4df372 2x, https://si.imgix.net/4c884f66/uploads/origins/e37baa13-4821-4fcf-8d7c-ac05562adf2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f20f29ff83194bc68ff9a3b9c690318 3x", "genre": "art", "nsfw": true, "body": "初めまして。へまそらダークネス様のイラストを拝見し、ぜひウチの子でリクエストをさせていただきたいと思いました。\n\nキャラクターについては、添付資料のオリキャラでお願いします。\nファンタジー世界の気が強いお嬢様魔法使いといった感じです。\n\n\n■シチュエーション\nhttps://skeb.jp/@gema_sora02/works/26\n上記の作品のような感じで、敗北からの輪姦のシチュでお願いします。\n竿役の詳細な描写は必要ございませんが、冒険者のキャラのため、肥満のおっさんというよりは、筋肉質なあらくれのイメージです。\nヒロインは上半身裸で、乳首にコンドームを結ばれ、下は際どいマイクロビキニのようなパンツをはかされ、そこにカラフルなコンドームを挟まれている、いわゆる「コンドーム腰蓑」状態。\nパンツはずれて性器が見えており、そこから精液が溢れている状態でお願いします。\nまた、髪や胸を含む全身に精液をかけられた状態でお願いします。\n表情は疲れ切った感じのレイプ目の絶望顔でお願いします。\nなお、ヒロインの性器は無毛でお願いします。\nもしよろしければ、コンドームやぶっかけ精液がなく、気の強そうな顔で男たちを睨んでいるような事前の差分もいただければ幸いです。\n\nよろしければどうぞ、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1wgpbr44B5dYN3dOSTYt3QX0AzPXU8_jt/view?usp=drive_link", "created_at": "", "completed_at": ""}, {"path": "/@gema_sora02/works/38", "thumbnail_src": "https://si.imgix.net/579f9ef4/uploads/origins/0e8fb22c-50bb-4d75-b2a4-66ad5bfa52f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac867d1160d3b6339a08f386136f4b3c", "thumbnail_srcset": "https://si.imgix.net/579f9ef4/uploads/origins/0e8fb22c-50bb-4d75-b2a4-66ad5bfa52f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac867d1160d3b6339a08f386136f4b3c, https://si.imgix.net/579f9ef4/uploads/origins/0e8fb22c-50bb-4d75-b2a4-66ad5bfa52f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8890271a263a1a06afd5972baed1e358 2x, https://si.imgix.net/579f9ef4/uploads/origins/0e8fb22c-50bb-4d75-b2a4-66ad5bfa52f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a282e879fa39c6afc1336d0f79444c5d 3x", "genre": "art", "nsfw": false, "body": "", "created_at": "", "completed_at": ""}, {"path": "/@gema_sora0