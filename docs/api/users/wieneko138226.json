b9c-4570-8482-ea850bb43be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bb0c55d6d394c3f809a1f9ae96511ec", "thumbnail_srcset": "https://si.imgix.net/c7daa53c/uploads/origins/c602e1dd-2b9c-4570-8482-ea850bb43be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bb0c55d6d394c3f809a1f9ae96511ec, https://si.imgix.net/c7daa53c/uploads/origins/c602e1dd-2b9c-4570-8482-ea850bb43be2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8624878cac06061efc54533fb946d7ac 2x, https://si.imgix.net/c7daa53c/uploads/origins/c602e1dd-2b9c-4570-8482-ea850bb43be2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b01dae16f28c24830f5dde51001e9d1 3x", "genre": "art", "nsfw": false, "body": "こんにちは、先生。\n先生の絵は素敵で大好きです。\nだから、デッサンのお手伝いをお願いしたかったんです。\nかわいい男の子で、絵の中で笑顔を絶やさないところが大好きです！\n\nhttps://drive.google.com/drive/folders/1pDwQE_Oyoxx3NG6Z3P6b-6KC7xzCt2dj?usp=sharing", "created_at": "", "completed_at": ""}, {"path": "/@wieneko138226/works/83", "thumbnail_src": "https://si.imgix.net/a5823fd2/uploads/origins/69f9d28a-9ae9-439c-b54c-c77d9d82071e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d40a96b3557e43eeb2b352df12555793", "thumbnail_srcset": "https://si.imgix.net/a5823fd2/uploads/origins/69f9d28a-9ae9-439c-b54c-c77d9d82071e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d40a96b3557e43eeb2b352df12555793, https://si.imgix.net/a5823fd2/uploads/origins/69f9d28a-9ae9-439c-b54c-c77d9d82071e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96ee68b1ca9a590da7c6a68b6d143c26 2x, https://si.imgix.net/a5823fd2/uploads/origins/69f9d28a-9ae9-439c-b54c-c77d9d82071e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f852de21c9bf5e0862381b82bdc9b24 3x", "genre": "art", "nsfw": false, "body": "Wienekoさん、はじめまして！あなたの絵がとても好きで、2人のキャラクターを使ったイラストを依頼したいと思っています。\n\n最初のキャラクターはこちらです。L'Monadeというキツネです：\nhtt