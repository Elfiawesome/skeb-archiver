/2e3e22a1-5ef6-4122-b6ce-70af3cf720ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=798c9849b9cfb044827e6bd11ee1eed4, https://si.imgix.net/e2503e10/uploads/origins/2e3e22a1-5ef6-4122-b6ce-70af3cf720ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17d98b9636ec932176640d1a771c0ee9 2x, https://si.imgix.net/e2503e10/uploads/origins/2e3e22a1-5ef6-4122-b6ce-70af3cf720ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=967c123e7bc3bda1817689f8dc1da5a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2503e10/uploads/origins/2e3e22a1-5ef6-4122-b6ce-70af3cf720ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43875f85061cb4817fbecd966edc23ba", "srcset": "https://si.imgix.net/e2503e10/uploads/origins/2e3e22a1-5ef6-4122-b6ce-70af3cf720ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43875f85061cb4817fbecd966edc23ba, https://si.imgix.net/e2503e10/uploads/origins/2e3e22a1-5ef6-4122-b6ce-70af3cf720ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7010c88407d67b75ba7dd28711c353ce 2x, https://si.imgix.net/e2503e10/uploads/origins/2e3e22a1-5ef6-4122-b6ce-70af3cf720ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76a2ee0268059cb7ac4bbe16fba63a50 3x"}, "body": "はじめまして、kaichi様\nみっくすたーと申します。\n\nkaichi様の描かれる繊細なタッチのキャラクターに惹かれて、依頼させていただきました。\n\n私のオリジナルキャラクターの「キーラ」と「プシュケ」を描いていただければと思います。\nキーラは元気で笑顔が絶えない17歳(身長は159cm、プシュケのことは\"ちゃん\"づけで妹のようにかわいがっている)で、プシュケは無口でクールな15歳(身長は150cm、キーラのことは\"さん\"づけで大切な仲間として大好きである)です。\n２人が初夏の新緑の下、楽しく過ごしている雰囲気を描いていただければと思います。散歩だったり、ピクニックだったりするとよいかもしれません(ちなみにキーラの方が料理が得意で、手作り料理を持参するならキーラが作ってくると思います)。上記は例として示しましたが、他にkaichi様がピンと来たシチュエーションがありましたらそちらでも構いません。\n\n構図としては太ももが見えるようなイラストにしていただけたらと思います。もちろん、バストアップの方がイラスト的に映える、値段相応ではないなどありましたら、変更していただいても構いません。\n加えて木漏れ日を表現してくださると大変うれしいです。\n\n資料も添付しておきますので、ご確認よろしくお願いします。\n\nhttps://www.dropbox.com/sh/2hmz7j6c75q49on/AABxDJmrOrycH0vcEdwidQOma?dl=0\n\nもしご都合が合いましたら受諾していただけると幸いです。\n宜しくお願いします。\n\nhttps://www.dropbox.com/sh/2hmz7j6c75q49on/AABxDJmrOrycH0vcEdwidQOma?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onionkoth_la/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1955969, "client_id": 1354188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc9b81151ac374ccf965242fd7202585", "srcset": "https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc9b81151ac374ccf965242fd7202585, https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=374e50f4eb474d1625653fc317289d8b 2x, https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=983ae118b5beb81b017039d3d51c3de1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=310bb1efda9d9ddd0eb3ab823d3ec77c", "srcset": "https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=310bb1efda9d9ddd0eb3ab823d3ec77c, https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=218665276e7abd381c0188feb8a061bc 2x, https://si.imgix.net/6ea2cc8b/uploads/origins/77f19bd7-2952-44e7-91e4-6d1dd0cf6126?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4b75eeef6e5f4167a60426181ef66ab 3x"}, "body": "kaichi様\n\n　なしと申します。kaichi様が描かれる優しく柔らかい絵柄と、淡く綺麗な水彩タッチの塗りが本当に大好きです。また一度描いて頂いた秋人と美桜のイラストを大変気に入っておりまして、この度Skebを始められたということでリクエストを送らせて頂きました。恥ずかしながら創作キャラのカップリング(以下CP)絵をお願いすることは可能でしょうか。以下詳細となります。\n\n創作名：桜夏秋冬\nキャラクター：\n・夏野葵(41歳/178cm)モチーフは夏の海と太陽。葵のネックレスは父からの贈り物。\n・冬馬雪彦(41歳/173cm)モチーフは冬の雪。ネクタイは夏野から、ブレスレットは姉からの贈り物。\n\n※詳細は資料URLを参照して頂きたいです。量が多いので流し見程度で構いません。\n\n要望：\n・可能であれば前に描いて頂いた秋人と美桜の様にシチュエーションのあるカップリング(＝ＢＬ要素のある)イラストを描いて頂けると嬉しいです。といっても性的な表現等ではなく、kaichi様が描きたいと思うものを描いて頂ければそれで問題ないです。\n\n・個人的な嗜好で可能であれば夏野と冬馬2人共、デフォルトで少し頬を染めて頂きたいです。\n・キャラと分かれば服装、キャラ色、髪形のアレンジ等全てお任せ致します。kaichi様の柔らかく素敵な描写力を存分に活かして、楽しく自由に取り組んで頂けたらと思います。\n・またkaichi様が考えられる金額相応の構図・クオリティで問題ありません。\n\nその他：お手間でなければ、差分で以下の記載をお願いしたいです。\n・宛名\n・kaichi様が描いて感じた夏野と冬馬2人に対する印象+2人が言いそうな台詞。\n　(一言で構いません。創作物として感想が聞きたいという理由です。)\n\n作品用途：自己観賞。また創作で描いて頂いた設定等に触れることがあるかもしれません。\n\n　kaichi様が普段描かれているものとかけ離れた依頼となってしまい申し訳ありません。飲めない要望は無視して下さって結構です。また依頼自体もご負担になるようであれば蹴って頂いて構いません。ご検討頂けますと幸いです。\nなし\n\nhttps://www.dropbox.com/sh/dig5ru5h90fosoe/AADmGjENcqtCXrdxYLEFk3xXa?dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@nenako_illust/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3256540, "client_id": 1955969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f79d7fad/uploads/origins/37944dbf-1cdf-4bf9-863e-f2a9b511b876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03b13c360c3bc801b4aaaed8f8eb3a30", "srcset": "https://si.imgix.net/f79d7fad/uploads/origins/37944dbf-1cdf-4bf9-863e-f2a9b511b876?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03b13c360c3bc801b4aaaed8f8eb3a30