7f1-506a231f5d0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be136d45be6e90bc6dcbb91efd22c067", "srcset": "https://si.imgix.net/1a3966ca/uploads/origins/e622aa7f-0d1d-4575-97f1-506a231f5d0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be136d45be6e90bc6dcbb91efd22c067, https://si.imgix.net/1a3966ca/uploads/origins/e622aa7f-0d1d-4575-97f1-506a231f5d0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7535d18caa150115384d22f6be456b9e 2x, https://si.imgix.net/1a3966ca/uploads/origins/e622aa7f-0d1d-4575-97f1-506a231f5d0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b9c594a7206263a4a2136011bf827af 3x"}, "body": "こんにちは！あけましておめでとうございます！\n今回はまみどりさんの描く、こういうキャラクターを見てみたい！！！が溜まりすぎて爆発しそうだったのでご依頼させていただきます。もしまみどりさんの世界観でやるならどうなってしまうのかと気になっていましたので、よろしくお願いします……！\n\n－内容－\n以下の要素を含んだオリキャラ制作をお願いします！！設定画的な感じだと嬉しいです。\n①女の子であること（超大前提）\n②おヘソに口、おマンコに口があること。※1\n③お腹を露出した衣装であること。\n\n※1 おヘソに口は「腹口」、おマンコに口は「ヴァギナ・デンタータ」と調べれば出てきます。参考程度に資料もお貼りしておきます。お口の形などの参考にどうぞ。\nhttps://www.pixiv.net/artworks/64917936\n\nhttps://www.pixiv.net/artworks/55346325\n\n－おまけ－\n①おっぱい口（乳首の部分が口に変化している）などはお好みでどうぞ。\n②もし可能であれば、設定画とは別にこの子によるえっち絵などあれば嬉しすぎて拝みまくると思うので、よければ……！！\n③もし大変でしたら落書き感覚でやってしまっても大丈夫です。\n\n以上です、よろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mamidoridori/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d3dfad0e/uploads/origins/1c19a161-79fe-4209-a317-e14a62657d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d27f8df18792806f1000406fe07a5f4", "srcset": "https://si.imgix.net/d3dfad0e/uploads/origins/1c19a161-79fe-4209-a317-e14a62657d9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&