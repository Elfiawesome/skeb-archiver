メしたマスコット風ではなくリアルタッチや楓パパを描く時のような八頭身で。\nコスチュームは学ランを思わせる黒い軍服で、軍刀を下げている。\n階級は中尉で両袖の袖章として刺繍されている。デザインは、横線１本に花弁が六枚ある桜星が二つ。\n\nポーズはお任せします。\n\nhttps://note.com/shikoku_bungeibu/n/nb3c26d6610da", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ta12412/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3626327, "client_id": 3306146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f13758eb/uploads/origins/7e4f1f2c-290e-4c78-a57a-2f47d25241a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca1d1a789fed97b19a80772b54b379d", "srcset": "https://si.imgix.net/f13758eb/uploads/origins/7e4f1f2c-290e-4c78-a57a-2f47d25241a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca1d1a789fed97b19a80772b54b379d, https://si.imgix.net/f13758eb/uploads/origins/7e4f1f2c-290e-4c78-a57a-2f47d25241a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e299d02f85e0b687c9bfa898e335fba9 2x, https://si.imgix.net/f13758eb/uploads/origins/7e4f1f2c-290e-4c78-a57a-2f47d25241a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92d5a5aa1eb48d135a1e88a53a58840b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f13758eb/uploads/origins/7e4f1f2c-290e-4c78-a57a-2f47d25241a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a583ea3fdf060eaf0e017f05a1476ac5", "srcset": "https://si.imgix.net/f13758eb/uploads/origins/7e4f1f2c-290e-4c78-a57a-2f47d25241a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a583ea3fdf060eaf0e017f05a1476ac5, https://si.imgix.net/f13758eb/uploads/origins/7e4f1f2c-290e-4c78-a57a-2f47d25241a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07c8c86116d7070278db58a399324c2a 2x, https