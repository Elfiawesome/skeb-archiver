た上でイラストを達成スクショと一緒にツイートするのと、こちらは未定ですが個人的なグッズ作成にも使わせて欲しいです。\n\n色々言ってしまいましたが、上記の内容でも大丈夫でしたら是非お願いします(´・∀・｀)", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Masushi_Masashi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3892983, "client_id": 299965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae50587665a532ce95c70951c375b19e", "srcset": "https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae50587665a532ce95c70951c375b19e, https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36c6af84520f9ab9153d951cd9ffbb3f 2x, https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02d784e24bfa73ac5c064c718ce35a89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7b637440d69379cf308076a1db25422", "srcset": "https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7b637440d69379cf308076a1db25422, https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c4d3ba44d12b32fbd4974ac6bf2419a 2x, https://si.imgix.net/48edae7d/uploads/origins/61ea5e53-599e-4239-8738-c3f079e0d6