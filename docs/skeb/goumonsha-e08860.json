3/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1428a8b9718368e2f173ab0de0222742 2x, https://si.imgix.net/eb0b6563/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35e54d1851b5cc3705455aeabd7b6c05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb0b6563/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e89940eea9e37336407389fc7dd9412f", "srcset": "https://si.imgix.net/eb0b6563/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e89940eea9e37336407389fc7dd9412f, https://si.imgix.net/eb0b6563/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd12cfb592f869a6358d3b8809f58d02 2x, https://si.imgix.net/eb0b6563/uploads/origins/f7d085d3-5f64-4f16-95cf-106561031b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc303ea565a0610f27dd8c9429820529 3x"}, "body": "飛来ボデー先生、初めまして！\n今回、LINEオープンチャット用にイラストを制作していただきたく、リクエストいたしました。\n内容としては、結束バンドメンバー全員が集結している立ち絵です。\n詳細としては、これでもかというほど満面の笑みを浮かべた結束バンドの皆が、仲睦まじく肩を寄せ合っている様子を描いて欲しいです。\nメンバーの並び順は、左から 虹夏→ぼっち→喜多→リョウでお願いしたいです。\n服装に関してですが、メンバー全員(いつも着こなしている)制服でお願いいたします。\nまた背景の有無についてですが、可能であれば四季問わず一年中使用出来るような風景でお願いしたいです。\n何卒、宜しくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goumonsha/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4475, "client_id": 2852091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25742090/uploads/origins/ca991df8-a465-4342-817a-20481ad69849?bg