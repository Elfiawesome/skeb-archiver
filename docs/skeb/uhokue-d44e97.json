&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52cfa43c0eec6b4fe0be376fef09e32b, https://si.imgix.net/fb6ececb/uploads/origins/239dc7c0-3e65-465e-b446-4213f227a12c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfa3fc99349c7e7884e7d988cae7c127 2x, https://si.imgix.net/fb6ececb/uploads/origins/239dc7c0-3e65-465e-b446-4213f227a12c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86eb55a82b8b7a60a290ab93114d5297 3x"}, "body": "こんばんは、もしよろしければ、少年ヤンガスよりヤンパーさんをお願いします\n\n・猿轡を噛まされ、全身をぎっちりと縛り上げられ、更にはアナルやチンポ、乳首などにも様々な玩具を付けられた状態で、全身にも卑猥な落書き、その上で特殊なレムオル（他の人からは見えないし、聞こえない状態）をかけられた状態でパルミドの町中に放置されている状態\n・差分として、「放置直後の朝方、羞恥に悶えながら怒りを見せている状態」と、「放置開始から半日ほどの夕方、誰でもいいから触ってくれ、イかせてくれと涙目な状態」の2パターンをお願いします！\n\n詳細な描写や、ヤンパーのポーズ、台詞などはお任せします！！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uhokue/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 73159, "client_id": 19349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa057cf7a929b2bbee5d5fcb0195148", "srcset": "https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa057cf7a929b2bbee5d5fcb0195148, https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a2a8ec7c13b68e51f500de2925bc269 2x, https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b89c9e79fd53b15dab0b45da3f222bd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=febb1d3a16a803163ce1c7b9941d3af5", "srcset": "https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=febb1d3a16a803163ce1c7b9941d3af5, https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4681f11441c3d4a3cc53625c66cb49ff 2x, https://si.imgix.net/0fb72f45/uploads/origins/1e94f5c6-9d2c-4c9c-8b42-4a35e8c99f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1457490539190da5d6e5bbb3d579d00c 3x"}, "body": "こんばんは！もしよろしければ、DQ8に登場するヤンガスと、少年ヤンガスに登場するヤンパーの双頭ディルドキス的なものをお願いします\n\n全裸に剥かれた二人が双頭ディルドを無理矢理くわえさせられ、喉奥を犯されながら、何者か（デブあらくれでも、オークでも　手だけでもOKです）に頭を押さえられる姿をぜひお願いします。\n完全にくっついた状態よりも、二人の口をつなぐディルドが見えている状態だと嬉しいです！\n\n可能であれば、二人とも後ろ手に縛り上げられていたり、瞼を固定されて互いの顔を強制的に見せられるような感じでお願いします。\n細かい部分は太井様にお任せします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uhokue/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 73159, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef3f01d7be317a91a7c3504f6bb5b577", "srcset": "https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef3f01d7be317a91a7c3504f6bb5b577, https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30d284c309af4e4730396eff3b733d60 2x, https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ad6b486d88ac88392ac62675a206b0b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e12e9c5b5a0fc149df668c6e8739b1d5", "srcset": "https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e12e9c5b5a0fc149df668c6e8739b1d5, https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30585d31dd50a5db17496e6862f882ed 2x, https://si.imgix.net/829ec166/uploads/origins/5d942307-2e77-498e-b082-2fbd5c5c640e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11b9e01f69375bf6f76ad8a10d0da8a2 3x"}, "body": "ご依頼失礼します。もしよろしければ、かなりマイナーかもしれませんがゲームエンジン\"MUGEN\"に登場する太ったおじさんヒーロー「ジャスティス」を希望します。太井さんの絵が好きなので、ぜひお願いしたいです。\nヒーロースーツは極力維持しながらも色々と拘束具や淫具を取り付けられて監禁され、射精を制限され肉便器にされている状況をお願いします。背景やポーズなどに関してはお任せしますが、台詞（心の声的なもの）があると嬉しいですし、周りの悪役たちの野次も描写していただけるとなお嬉しいです！（無理のない程度で結構ですが…（汗））\n資料も少なくマイナーかもしれませんが、参考までに画像検索のアドレスを貼っておきます。\n\nhttps://www.google.com/search?q=mugen+%E5%A4%AA%E3%81%84+%E3%82%B8%E3%83%A3%E3%82%B9%E3%83%86%E3%82%A3%E3%82%B9&rls=com.microsoft:ja:&ie=UTF-8&oe=UTF-8&sourceid=ie7", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uhokue/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 73159, "client_id": 19349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f95a4dca/uploads/origins/619115d8-e6c0-4a03-9661-ae5e12016c6e?