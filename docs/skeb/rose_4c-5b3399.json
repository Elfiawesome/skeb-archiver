TRPG フタリソウサ (Role&Roll Books)の掲載URLを載せておきます。\n以上、よろしくお願いいたします！\n\nhttps://www.kinokuniya.co.jp/f/dsg-01-9784775317013", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rose_4c/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3838816, "client_id": 3483168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-06e81cd75cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d37f06f2eb27d318cfef905adb9e0c", "srcset": "https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-06e81cd75cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d37f06f2eb27d318cfef905adb9e0c, https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-06e81cd75cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cb64040de9efc1c52e53eb1b906610f 2x, https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-06e81cd75cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0d245e522314fe658ca1264395817ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-06e81cd75cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8879bd041f53a517c8a3d919a55cc2", "srcset": "https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-06e81cd75cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8879bd041f53a517c8a3d919a55cc2, https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-06e81cd75cbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1682a21ca8e5781ee68fbf176336469f 2x, https://si.imgix.net/5244fac2/uploads/origins/5a22a26f-0996-4cd8-8057-0