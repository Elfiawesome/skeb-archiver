アイドルを恋人として扱い接しており、お互いかなり素直。  \n\n可能であれば個人利用の範囲で印刷などに使用したいので、透過したものも頂けますと嬉しいです！  \n\n資料の不備や金額不足などありましたら対応しますので、ご検討いただけますと幸いです。  \nお忙しいところ大変恐縮ですが、何卒よろしくお願いします…！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@r_tsjn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3628258, "client_id": 1485439, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47918ef8/uploads/origins/a6b1f971-4755-4850-b212-1a79c0876234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17abaf1d6f98383a296a1e548661bfe2", "srcset": "https://si.imgix.net/47918ef8/uploads/origins/a6b1f971-4755-4850-b212-1a79c0876234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17abaf1d6f98383a296a1e548661bfe2, https://si.imgix.net/47918ef8/uploads/origins/a6b1f971-4755-4850-b212-1a79c0876234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c22877964bec946c48be9af6318c486a 2x, https://si.imgix.net/47918ef8/uploads/origins/a6b1f971-4755-4850-b212-1a79c0876234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19d420e977918706a5d7a0a0fd9afbdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47918ef8/uploads/origins/a6b1f971-4755-4850-b212-1a79c0876234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=449f6413c3d6bedbc0a9b28f9feb108b", "srcset": "https://si.imgix.net/47918ef8/uploads/origins/a6b1f971-4755-4850-b212-1a79c0876234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=449f6413c3d6bedbc0a9b28f9feb108b, https://si.imgix.net/47918ef8/uploads/origins/a6b1f971-4755-4850-b212-1a79c0876234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f61285bd30ec14189b2ce6bfc456d447 2x, https://si.imgix.net/47918ef8/u