works/138\nが蜂女戦闘員に改造されたイラストを描いていただけませんでしょうか？\n優しいお姉さんキャラです。\n\n1枚目\n「お姉ちゃん買い物に行くからお留守番お願いね」と言い買い物に出かけるシーン\n\n2枚目\n組織に誘拐され、蜂女戦闘員（腰がベルトタイプ）に洗脳・改造されショッカーに忠誠を誓うシーン\n\n以上でお願いします。\n\n用途はSNSのアイコンや個人鑑賞等です。\nご検討していただけたら幸いです。よろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Moks33/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 71788, "client_id": 1557856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0558d23/uploads/origins/7e7570de-0e75-4b57-a5d3-93db56535f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21112c84354a423972972b05ae584a3", "srcset": "https://si.imgix.net/f0558d23/uploads/origins/7e7570de-0e75-4b57-a5d3-93db56535f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e21112c84354a423972972b05ae584a3, https://si.imgix.net/f0558d23/uploads/origins/7e7570de-0e75-4b57-a5d3-93db56535f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1db88288eb389b6d5ea47cf62d330542 2x, https://si.imgix.net/f0558d23/uploads/origins/7e7570de-0e75-4b57-a5d3-93db56535f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f3873df3e598ac739c6e97a0b29c0d0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0558d23/uploads/origins/7e7570de-0e75-4b57-a5d3-93db56535f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b70b936b2535869e94af1ef51301425d", "srcset": "https://si.imgix.net/f0558d23/uploads/origins/7e7570de-0e75-4b57-a5d3-93db56535f67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b70b936b2535869e94af1ef51301425d, https://si.imgix.net/f0558d23/uploads/origins/7e7570de-0e75-4b57-a5d3-93db56535f67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d96b