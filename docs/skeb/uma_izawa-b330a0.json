尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma_izawa/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2001746, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88aea474c48c8ef941c083672bfa88b1", "srcset": "https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88aea474c48c8ef941c083672bfa88b1, https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=170a56642c31fdb421a399dfed2c8d7e 2x, https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f89a2d4c4a7bd567d52c9ee2dc74b15 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23d311a4eb2bf5efa4c32f5645b95ca4", "srcset": "https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23d311a4eb2bf5efa4c32f5645b95ca4, https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9daec9827d8dd564350b8f76faf334e 2x, https://si.imgix.net/ec0a6d55/uploads/origins/803d2f73-1157-4299-a844-b13b23b30267?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=