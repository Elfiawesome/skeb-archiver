6-4120-a6b7-dddf534c7cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=090892de7b32de6ec72da4e2d5070374", "srcset": "https://si.imgix.net/b6b4a3b4/uploads/origins/4169b146-5a66-4120-a6b7-dddf534c7cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=090892de7b32de6ec72da4e2d5070374, https://si.imgix.net/b6b4a3b4/uploads/origins/4169b146-5a66-4120-a6b7-dddf534c7cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0198ae7223e3bf036b1bf0245f9eb5e5 2x, https://si.imgix.net/b6b4a3b4/uploads/origins/4169b146-5a66-4120-a6b7-dddf534c7cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04fd89580ba5ff127f6b0095b5cd4c8b 3x"}, "body": "アーボック時津風をお願いします。\n\n寒くて運動不足を感じた時津風が、アーボックにポケモンバトルみたいに勝負してほしいとお願いし勝負を始めたが、アーボックのほうが素早さが高く、まきつく攻撃を受けたという設定でお願いします。\n\nシーンや表情ですが\n①「巻き付かれちゃった・・・でもこっちも攻撃を・・・」と時津風は苦しみながらも反撃しようとする。\n②しかし攻撃ができず「あれ？攻撃できない・・・？」と時津風は混乱している。\n③「もしかして・・・初代のまきつく攻撃・・・！？」と時津風は気が付き、逃げようと抵抗するがアーボックの攻撃は続いている。\n④アーボックの攻撃が終わり、締め付けがなくなり（身体は拘束されている）「やっと終わった・・・今度はこっちが・・・！」と時津風は苦しみながら攻撃しようとする。\n⑤再度アーボックのまきつく攻撃が始まり、時津風は勝てない事を察し「ごめん！私も負けでいいから許して！」と攻撃をやめるようにお願いする。\n⑥しかしアーボックの攻撃をやめず、何回もまきつく攻撃を繰り返し、時津風は体力がつきる寸前で弱い呼吸ながらも必死に息をしている。\n\n今回⑥のみ目を閉じ、それ以外は開いて下さい。\n\n構図はバトルという事で巻き付き具合や構図は先生が好きなようにお願いします。悩んだ場合は今までのように3～4巻でお願いします。\n又、今回差分が大丈夫でしたら先生が好きな構図でしたら巻きつかれている箇所の追加を、今までと同じ構図でしたら尻尾差分をお願いします。\nその他、できればアーボックの色違いもお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma_izawa/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2001746, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f066f74ab5c3ebb0d3ada4b194fba2", "srcset": "https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f066f74ab5c3ebb0d3ada4b194fba2, https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90cf295563f1ebaf570131de54d9c2be 2x, https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6922d30660b0e2d76224d70a86e1f0d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8164de67cbef53c2855aa60fd8e01031", "srcset": "https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8164de67cbef53c2855aa60fd8e01031, https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86be8c05c5eb5b6dea2a4d6665606812 2x, https://si.imgix.net/80e0d50a/uploads/origins/2eca0d81-9f31-4245-9a95-038bf53f62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b63532dc51c9d129ea5526730190da4e 3x"}, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n一枚（又は複数枚）でまとめて頂くか、一枚づつかはご負担が少ない方で(同じなら一枚づつ)お願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma_izawa/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2001746, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c986d8de03f9e4fcb58744a8fee891cf", "srcset": "https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c986d8de03f9e4fcb58744a8fee891cf, https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4ffd827b7aaa50faef875feaf412f8f 2x, https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2805f909e33f82c2406b5d4daa3b5c46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce5aa89b91652bed4ca627d944b8537", "srcset": "https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce5aa89b91652bed4ca627d944b8537, https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa9716bf565ab7e938f42be7321e9fb7 2x, https://si.imgix.net/afbeb870/uploads/origins/4eabd74e-47ae-4f6d-a071-0710546c7eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c7b6834d49dcebae3c2ffa1fe5735c2 3x"}, "body": "かなり特殊なリクエストになります。無理な場合はキャンセルを、非表示をご希望の場合は再送要請ををお願いします。\n\n艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\n\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。アーボックの口は閉じてください。\n全身巻き付かれている事を強調する為、時津風の全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n時津風の表情ですが、大丈夫でしたら以下の通り（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma_izawa/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/44fd67e2/uploads/origins/f1e3af84-56e0-4edc-b858-020474227dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed103d74269e5cb2b4ec9caee6c8c3de", "srcset": "https://si.imgix.net/44fd67e2/uploads/origins/f1e3af84-56e0-4edc-b858-020474227dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed103d74269e5cb2b4ec9caee6c8c3de, https://si.imgix.net/44fd67e2/uploads/origins/f1e3af84-56e0-4edc-b858-020474227dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=29215258faf6e5dc35f14a7395342015 2x, https://si.imgix.net/44fd67e2/uploads/origins/f1e3af84-56e0-4edc-b858-020474227dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9e241d83ead1af1604ef006b5fd0324 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2001746, "nc": 16}, {"path": "/@uma_izawa/works/8", "private_thumbnail_image_urls": {"src": "https://s