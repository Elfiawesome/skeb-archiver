5f6-413c-aa21-45c8b6201588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3345ab7e7f3be36b8e92b49175741bcd, https://si.imgix.net/194df885/uploads/origins/8ee2829e-55f6-413c-aa21-45c8b6201588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a07ecf576b80db1f9d1d527642b0581 2x, https://si.imgix.net/194df885/uploads/origins/8ee2829e-55f6-413c-aa21-45c8b6201588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=113edb83af0a2c6de646d078d21e02ca 3x"}, "body": "テンドウカオル様。\n突然失礼致します。\n私が応援している、VTuber無糖しおちゃんのイラストをお願いしたく、リクエストをお送りしました。\n\nしおちゃんはイラストから歌、mix、動画制作にLive2Dモデリングまでなんでもできるマルチな才能を持っています。\nそんなしおちゃんが好きなアニメが、魔法少女まどか☆マギカです。\n\nそこで依頼したいのが、魔法少女風なしおちゃんのイラストです。\n衣装は現在しおちゃんが着用しているアイドル衣装をモチーフにアレンジしてください。(衣装詳細は資料URLへ)\n個人的にテンドウカオル様のSFアレンジが大好きなので、その要素を入れていただきたいです。イメージ的には魔法のような高度な科学を扱う感じ…と言ったら伝わるでしょうか。\n先述した通り、マルチな才能を持っているので、能力(才能)を入れ替えて戦うような戦闘スタイル(システム)もあれば嬉しいです。(差分などではなく○○モードみたいなものを選択しているイメージです)\n\nファイルはPSDでお願いしたいです。\n複雑なリクエストとなりますが、ご検討よろしくお願いします。\n\nhttps://sugarfreesaltv.wixsite.com/mutoushio/about", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sinoekaki/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 447921, "client_id": 1519547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/047d3ca1/uploads/origins/eb3011fa-c4a7-4eeb-8694-c9f183403302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02b72d5b8e03bf2507301c462b099246", "srcset": "https://si.imgix.net/047d3ca1/uploads/origins/eb3011fa-c4a7-4eeb-8694-c9f183403302?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02b72d5b8e03bf2507301c462b099246, https://si.imgix.net/047d3ca1/uploads/origins/eb3011fa-c4a7-4eeb-8694-c9f183403302?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5ad76ebec633a95d7364abcd