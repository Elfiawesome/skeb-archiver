60-859c-4de8340873fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a190080f3620d7769d5669177941a82e, https://si.imgix.net/71521ef2/uploads/origins/1ec4e13e-0cf0-4e60-859c-4de8340873fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=266f89e48dc410716426f031ba672a73 2x, https://si.imgix.net/71521ef2/uploads/origins/1ec4e13e-0cf0-4e60-859c-4de8340873fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=144429531bedfa6ec7c9422e38fc1a6d 3x"}, "body": "紙原ゆけたさんはじめまして、キューテラと申します。\n\nフォロワーさんのリポストで紙原さんのイラストを拝見しクオリティの高さとキャラ解釈の深さ、印象的な構図に一目惚れしました。\n\nXfolioにアップされていたイラストもかっこよさと美しさが共存していて素敵です！\n（特に、朝の支度とハンバーガーの絵が好きです……！）\n\n今回は私のオリジナルキャラクターのイラストをリクエストさせていただきます。\n\n《キャラ概要》…外見等詳しくは資料URLをご覧ください\n・人外を退治する組織にいるハンターの男性（ほぼ週7で幽霊や怪物を退治している）\n・真面目、仏頂面、頑固、融通が効かない。よく言えば委員長タイプ。よく食べよく寝てるはずなのに目付きと機嫌がだいたい悪い（過労）\n・討伐対象である吸血鬼の女の子に一目惚れし、自宅で匿っている（組織としては大問題）\n・愛が非常に重く、好きな子の監禁や浮気相手（と疑わしき者）の排除も厭わない。\n・束縛や自分へ依存させようとするような行為も多々見られる。本人は一生懸命なだけで好きな子を悲しませるつもりはないと泣きながら主張している。\n・趣味の一つにメイクがある。\n美しくしたいというよりは、顔の雰囲気などが元の自分と変わるのがちょっと楽しいかららしい。\nクールで強そうなメイクが基本で、たまに大粒ラメや偏光ラメ等も取り入れている。\nリップよりアイメイク重視。\n・細身だが筋肉はあり、男性らしい体つき。一重三白眼（黒目が小さめ）。\n\n《構図など》\n・構図、服装など全てお任せいたします。\n（闇を感じさせるような構図・表情だと特に喜びます）\n\n《用途》\n・観賞用や個人のみの利用としてグッズなどに印刷、デジタルデバイスの壁紙として使用（自分が楽しむためにのみ使います）\n\n《その他》\n・表現の幅を狭めないためNSFW設定にさせていただいていますが、健全なイラストもとても嬉しいです。紙原さんの自由な解釈・発想にお任せします！\n・金額不足・資料不足などありましたら差し戻しお願いします。\n\n\n長文乱文失礼しました、何卒よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-kYUEQWAJPoN92qJotZOeE4UTSyZqYYg", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K_Yuketaru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2345981, "client_id": 2616600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=937d2863ecb74752240a25201dede012", "srcset": "https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=937d2863ecb74752240a25201dede012, https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d13344879ece5db4521b9811afaf573 2x, https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcc5a96b6f3a479e3659fab84f66b657 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3be491050d7406789109ca8a349dd21", "srcset": "https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3be491050d7406789109ca8a349dd21, https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e32fb5b65e7c50716e24ea493095a9f1 2x, https://si.imgix.net/f03f38a5/uploads/origins/79473a94-3717-4267-8d36-99a2f6a30db7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea418b8cf9f580619383058725b8041d 3x"}, "body": "紙原ゆけた様。はじめまして、この度はアピールありがとうございます。私の創作キャラに興味を持ってくださり嬉しいです。Xfolioの作品を拝見しまして、実在感のある人物の描き方に魅力を感じたのでリクエストさせていただきました。\n\n資料の二人は私が制作中のホラーゲームに登場するキャラです。男性はゲームの舞台である洋館の主で、侵入者を人形に変えてしまいます。彼は狂気的で常に不気味な笑みを浮かべています。少女は彼によって人形にされてしまった被害者の一人です。元は心優しい子でしたが冷酷な性格に変えられてしまい、男性の命令で侵入者に敵対してきます。\n\n二人は絶対的な主従関係にあり、お互いに強い執着を持っている共依存関係です。男性は少女のことを可愛がっていますが、それは独りよがりの愛情で、彼女を自分の所有物として扱っています。少女は男性に憎しみや畏怖の感情を抱いていますが、同時に愛おしく離れがたいと思っており、ストックホルム症候群に近い心境です。\n\nイラストの内容としては、（飾ってある人形を整えるように）少女の身繕いをしてやる男性を描いていただきたいです。男性は目を細めた怪しい笑み、少女は心が無いような虚ろな表情で願いします。構図等はお任せいたします。\n\nお忙しいところ失礼いたしますが、ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/109Ama3hSRW7vMOEBp2ra-_asiH7lJBd0?usp=drive_link", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@goodruck_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 16309, "client_id": 2345981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efc3f2dcb913d27874b14896a8b39328", "srcset": "https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efc3f2dcb913d27874b14896a8b39328, https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c46d7e642ceea746af9fc35455f2149 2x, https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f928e9b6d1bf2fec042f508e83fe8ea2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79dbc29b6dc41987503ae8d169cc29a6", "srcset": "https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79dbc29b6dc41987503ae8d169cc29a6, https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62ba844c79fe0a49669a3c3e1cc99f8b 2x, https://si.imgix.net/5e9427d2/uploads/origins/49a9b708-cb49-4c62-b911-94803315b15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c3509bb7a0c6691cd8d68e1a88c4ab5 3x"}, "body": "こんにちは、紙原です。\nラク兄のお宅のドグマさんをお願いできますでしょうか！\n角の内側に星空があるようなデザインや多眼から発せられる優しげな視線やつんとした袖のシルエットや数層に分かれている髪の感じなど、言い出すとキリが無いのでつまりとても好きです。\n\nドグマさんに統制される下下の気持ちを味わいたいので、もし人の前に現れることのある方なら降り立ってどのように語り掛けてくださるのか見てみたいです。\n人間の前になぞ現れてくれないドグマさんの可能性にも笑顔になる下下ですから、その場合は普段どのような生活を送ってらっしゃるのか教えていただけると…！\nいつもありがとうございます、応援してます！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 701896, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ウデゲゴリラ", "screen_name": "tabereru_unko", "avatar_url": "https://pbs.twimg.com/profile_images/1670062092702089216/QztTaLqQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3804305653/1676976584/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 153}, {"id": 819415, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちむ仔。", "screen_name": "touhinyut", "avatar_url": "https://pbs.twimg.com/profile_images/1823258606562873344/sFBv7gU7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2208639000/1727711299/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1073960, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "襟本やヱ/にじそ11 西4ホール タ-67(4月19日)", "screen_name": "ya_ermt", "avatar_url"