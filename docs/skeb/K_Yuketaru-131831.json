していただいても問題ありません。\n◯構図や設定などもし可能であれば、メイクをしている提案も素敵でしたので是非見てみたいです。\n-----\n■資料\n【三面図・表情差分】\nhttps://drive.google.com/drive/folders/1pjAzxQZ77v1-ImF09Qebj5Qz6K3LYJVM?usp=drive_link\n-----", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K_Yuketaru/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2345981, "client_id": 1295922, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2222bda4/uploads/origins/0e9b99b8-ec9b-43be-af0c-c379c3d4419a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2964b475a20267e98ef7cf660eff3b1", "srcset": "https://si.imgix.net/2222bda4/uploads/origins/0e9b99b8-ec9b-43be-af0c-c379c3d4419a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2964b475a20267e98ef7cf660eff3b1, https://si.imgix.net/2222bda4/uploads/origins/0e9b99b8-ec9b-43be-af0c-c379c3d4419a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=498045ff887080af7a25bb542d6a367d 2x, https://si.imgix.net/2222bda4/uploads/origins/0e9b99b8-ec9b-43be-af0c-c379c3d4419a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35b87516ef7e706aad168a3f5f266e49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2222bda4/uploads/origins/0e9b99b8-ec9b-43be-af0c-c379c3d4419a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e581010735c6dfe5ac5adcb67014c2ff", "srcset": "https://si.imgix.net/2222bda4/uploads/origins/0e9b99b8-ec9b-43be-af0c-c379c3d4419a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e581010735c6dfe5ac5adcb67014c2ff, https://si.imgix.net/2222bda4/uploads/origins/0e9b99b8-ec9b-43be-af0c-c379c3d4419a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f84ae8c174ed08f63d3b418b59e8afd7 2x, htt