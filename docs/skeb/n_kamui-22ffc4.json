-4984-97a7-39c2b0c850f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=773d84a39f3793fa9cf3d7bf1bd732e1", "srcset": "https://si.imgix.net/71eeec65/uploads/origins/56298d95-85dc-4984-97a7-39c2b0c850f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=773d84a39f3793fa9cf3d7bf1bd732e1, https://si.imgix.net/71eeec65/uploads/origins/56298d95-85dc-4984-97a7-39c2b0c850f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd331c08425dafab07ec665f1ff0c951 2x, https://si.imgix.net/71eeec65/uploads/origins/56298d95-85dc-4984-97a7-39c2b0c850f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ef4bcc49528e6b3a3b7dceee91ff65b 3x"}, "body": "はじめまして。神威なつき様\n\n眞白かのんさん（@mashiro_kqnon）とれれのれのさん（@reno_rereno）のファンアートをお願いできないでしょうか？\n\n二人は中国では臥竜鳳雛と呼ばれています\n・眞白かのんさんは鳳の雛\nかつてエルフ奴隷として囚われていた過去を持つので、「鳥かごに囚われそれでも希望を失わず大空へはばたく自由へのあこがれに目を輝かせているような姿」\n・れれのれのさんは臥せる龍\n夜空をまとった星のお化け、活動を始めたばかりですが、悠久の時を生きているれのさんは「眠れる龍の目覚めを思わせるような悠然とした姿」\n\n衣装はそれぞれ臥竜と鳳雛に合わせたアレンジがあると嬉しいです\n\n・絵巻のように歴史や神秘を感じる作品であると喜ばしいです\n\n用途\n・個人観賞\n・お二人へのプレゼント\n可能であれば、お二人の活動での使用許可をいただきたいです（動画、配信、SNSでの使用を想定）\nまた、こちらは勝手なお願いで申し訳ないですが、活動で使用しやすいような配慮をしていただけると嬉しいです\n（16:9での制作や背景の透過など）\n後者は作品へ影響を与えるようであれば、ない方がいいです\n\n推敲を重ねましたが、表現が拙く分かりづらいところもあると思います。\nどうかよろしくお願いします\n資料\n\nhttps://drive.google.com/drive/folders/1x3tMufL3jDHG5C2B95Q58u8OkOVNgwJG?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@n_kamui/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1227826, "client_id": 884561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44932d81/uploads/origins/7f10d580-24b4-4dc7-a4c2-ca23dd30d705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55d5f9fbebf00d2f3c91795899294a85", "srcset": "https://si.imgix.net/44932d81/uploads/origins/7f10