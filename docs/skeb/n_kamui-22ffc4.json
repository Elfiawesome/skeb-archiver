ん～\nでも先生が大丈夫だと思ったら、是非お願いします。\nもし先生が金額が足りないと感じたら、先生はもっと適切な金額を提出することができて、私は依頼を再開します。\n\nhttps://blog.wtf.day/?page_id=678\nhttps://blog.wtf.day/?page_id=881\nhttps://blog.wtf.day/?page_id=976", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@n_kamui/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1227826, "client_id": 2113587, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65ae939a/uploads/origins/e5e61b62-4192-4cae-8800-09716c3e6823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14d83763896b252371e94054ab3a6924", "srcset": "https://si.imgix.net/65ae939a/uploads/origins/e5e61b62-4192-4cae-8800-09716c3e6823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14d83763896b252371e94054ab3a6924, https://si.imgix.net/65ae939a/uploads/origins/e5e61b62-4192-4cae-8800-09716c3e6823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4876f01b915e06911d064784bd71f5f0 2x, https://si.imgix.net/65ae939a/uploads/origins/e5e61b62-4192-4cae-8800-09716c3e6823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e22aca243d310f836605f0a00e69c48 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65ae939a/uploads/origins/e5e61b62-4192-4cae-8800-09716c3e6823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d17603a0153838ae8956a6a1dba2356a", "srcset": "https://si.imgix.net/65ae939a/uploads/origins/e5e61b62-4192-4cae-8800-09716c3e6823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d17603a0153838ae8956a6a1dba2356a, https://si.imgix.net/65ae939a/uploads/origins/e5e61b62-4192-4cae-8800-09716c3e6823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e468ff8d33bafad37d40b284812979ee 2x