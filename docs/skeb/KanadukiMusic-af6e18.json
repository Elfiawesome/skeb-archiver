n\nご配慮いただき、本当にありがとうございました！\n\nhttps://drive.google.com/file/d/1oXDgGPL4rSyfkeMbPP4CTtu2ADu9Ow_P/view", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@KanadukiMusic/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 1679653, "client_id": 1774207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b720f92997c0342dc38caa47326eeacc", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b720f92997c0342dc38caa47326eeacc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa58884df4ac482cab833ee80e0f745f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1718084171573370880%2Fs2qCglie.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dcaa2081d937b56e516767cac7d2247 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/0df6f556-ec25-4c20-81e3-19b69b1c260c?response-content-disposition=inline&Expires=1774659048&Signature=MWF2GTKdZZ75MO-OkvhA5pOL6JqwQwFipPfC9fYMW9zucuVClfeddqkpyAayBZKw9AqdgnQ9daZyXZl-Ua1-UHN8ZZ4ZM96XD3K8MbXWhCecwXB59P~OHKuwaVZ7gME-GxgUnniGn9EqZhkkQc5ugEfNaWG~AxoQrCnFu1uGmSeWGEo~94y-DhlM~ZlwLCeRKjef~L4w8jOg9xRtr3TfdDzTwiOyqcOcnW~4Y059KEYmu~VAGtAOBCxguGFQfB072Q~ovwraDvlzat0SAVHjmGAz6j1xnM7b-aM1Spyplag3uBFuJXNWONCB9j1BGKJ2r1qSKPETnjAJqySQLxveMg__&Key-Pair-Id=K1GS3H53SEO647", "duration": 223, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.c