8\u9014\u3011(\u500b\u4eba\u5229\u7528\u76ee\u7684\u306b\u306a\u308a\u307e\u3059\u3002\u7b2c\u4e09\u8005\u3078\u306e\u8b72\u6e21\u7b49\u306f\u4e00\u5207\u3044\u305f\u3057\u307e\u305b\u3093)\n\u30fb\u539f\u6848\u76f8\u624b\u69d8\u3078\u306e\u30d5\u30a1\u30a4\u30eb\u5171\u6709\n\u30fbX\u306a\u3069SNS\u306b\u3066\u30af\u30ec\u30b8\u30c3\u30c8\u660e\u8a18\u3057\u3066\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3001\u30a2\u30a4\u30b3\u30f3\u3084\u30d8\u30c3\u30c0\u30fc\u3078\u4f7f\u7528(\u539f\u6848\u76f8\u624b\u69d8\u542b\u3080)\n\u30fb\u30b9\u30de\u30db\u3084PC\u306e\u5f85\u53d7\u8a2d\u5b9a\n\u30fb\u500b\u4eba\u5229\u7528\u306e\u7bc4\u56f2\u3067\u306e\u30b0\u30c3\u30ba\u4f5c\u6210\n\n\u3010\u6982\u8981\u3011\n\u25c6\u30ad\u30e3\u30e9\u30af\u30bf\u30fcA\n\u540d\u524d\uff1a\u693f\u539f \u6faa(\u3064\u3070\u304d\u306f\u3089 \u307f\u304a)\n\u8077\u696d\uff1a\u5211\u4e8b(\u30ad\u30e3\u30e9\u30af\u30bf\u30fcB\u306e\u90e8\u4e0b)\n\u5e74\u9f62\uff1a25\n\u6027\u5225\uff1a\u7537\n\u8eab\u9577\uff1a175cm\n\u6027\u683c\u7b49\uff1a\u5b8c\u74a7\u4e3b\u7fa9\u3067\u771f\u9762\u76ee\u306a\u6027\u683c\u3002\u8da3\u5473\u306f\u8aad\u66f8\u3002\u30c4\u30f3\u30c7\u30ec\u6c17\u5473\u3002\u666e\u6bb5\u306e\u8a00\u52d5\u306f\u5927\u4eba\u3073\u3066\u3044\u308b\u304c\u3001\u305f\u307e\u306b\u5e74\u76f8\u5fdc\u306a\u7d14\u7c8b\u306a\u4e00\u9762\u3082\u3042\u308b\u3002\u9154\u3046\u3068\u300c\u307e\u3060\u5927\u4e08\u592b\u3067\u3059\u300d\u3068\u9154\u3044\u306a\u304c\u3089\u8a00\u3046\u30bf\u30a4\u30d7\u3002\n\n\u25c6\u30ad\u30e3\u30e9\u30af\u30bf\u30fcB\n\u540d\u524d\uff1a\u9cf3 \u83ca\u30ce\u4e1e(\u304a\u304a\u3068\u308a \u304d\u304f\u306e\u3058\u3087\u3046)\n\u8077\u696d\uff1a\u5211\u4e8b(\u73ed\u9577)\n\u5e74\u9f62\uff1a37\n\u6027\u5225\uff1a\u7537\n\u8eab\u9577\uff1a187cm\n\u6027\u683c\u7b49\uff1a\u7a4f\u3084\u304b\u306a\u6027\u683c\u3002\u5143\u65e2\u5a5a\u8005\u3001\u611b\u7159\u5bb6\u3001\u9152\u597d\u304d\u3002\u8cac\u4efb\u611f\u3068\u611f\u53d7\u6027\u304c\u9ad8\u304f\u8ab0\u306b\u3067\u30