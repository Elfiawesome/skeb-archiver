folders/1qgVX7zt_vqXdvJKZTnoe_gznYA8lbbXp\n\n—\n\nご検討いただけますと幸いです。\n何卒よろしくお願いいたします。\n\nこれからもこのたろう様を応援しております。\nいつも素敵なイラストを見させていただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1qgVX7zt_vqXdvJKZTnoe_gznYA8lbbXp", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 326059, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "安眠", "screen_name": "panko_me", "avatar_url": "https://pbs.twimg.com/profile_images/1505120782166343680/gesOrfAG.png", "header_url": "https://pbs.twimg.com/profile_banners/1190146507158081541/1583277529/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1144989, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ド長男", "screen_name": "meso_meso_boy", "avatar_url": "https://pbs.twimg.com/profile_images/1885022952720392194/BbCiN9WA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/932216366001635328/1565732751/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 1588210, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "☁Soft fluffy☁", "screen_name": "Alstro02", "avatar_url": "https://pbs.twimg.com/profile_images/1675373195061506048/q7nZlT9a.png", "header_url": "https://pbs.twimg.com/profile_banners/1719019370/1723169082/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comp