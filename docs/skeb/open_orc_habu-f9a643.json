itterにてUPされていた貸し出し妻満里奈のムービーがとてもすばらしかったので是非オーク先生に満里奈さんのNTRを作っていただきたくリクエストしました！！\n\n超デカチンの黒人に容赦なくバゴンバゴンと子宮を激しく万力鬼ピストンされまくって最終的に大量のザーメンを中出しされまくって下品にアヘまくっている満里奈さんをお願いしたいです！！\n浮気を全力で楽しんでる表情で、出来ればチンポがデカすぎて突かれるたびにお腹がボコンボコンと盛り上げっていると個人的に嬉しいです…！\n満里奈さんは原作で寝取らせプレイにハマっても最終的には旦那の元に絶対に戻って来るという安心感がありますが、本気で堕とされそうな激しい交尾をお願いします！\n\n満里奈さんが大好きなのですが、描かれている方がとても少ない中であんな上質なムービーを作っているオーク八生さんに脱帽いたしました…\nリクエスト、どうかご検討くだされば幸いです…！", "nc": 49, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@open_orc_habu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 2668344, "client_id": 123163, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=452803d7ba25008d48f1da8f4c1f9d98", "srcset": "https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=452803d7ba25008d48f1da8f4c1f9d98, https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=42bcd518e7096c41b16e22adf28ff770 2x, https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4d3a0ab57565877c5c7ebdb37465f02 3x"}, "duration": 166, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=23b6f40722c49ccfe3ab33c7d379766f", "srcset": "https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=23b6f40722c49ccfe3ab33c7d379766f, https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5335f5ad4891171b6bde590bbe7d3af4 2x, https://si.imgix.net/c26c400f/uploads/outputs/9683de78-336a-4779-b6de-4bf84f8c3c97?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3feecc23955802cf52b0eb4b4ed81147 3x"}, "body": "お世話になります。\npkmn　ゼイユのリクエストです。\n\n内容:亀頭舐めからのイラマ\n主観視点で、こちらに目を合わせて口をアピールしつつ、舌を長く伸ばして左右に揺らすとか、焦らすように尿道や亀頭を舐めている→焦らしフェラにイラついた男が髪や頭を掴んでイラマ・射精、みたいな感じで…。\n焦らし中は挑発的な表情で、自分の指で口の片端を引っ張って舌や歯、喉奥をアピールし、唾液を垂らした舌を長く伸ばしている、イラマ開始後はアヘ顔で白目を剥いて涙を流し、大量射精で鼻からも精液が噴き出す、射精終わってもそのままイラマ継続や連続射精で鼻や口の端から精液が漏れ飛ぶ…というようなイメージです。\n構図は顔アップやバストアップの想定ですが、できれば着衣で胸元を開いて胸を露出（もしくは裸）、下半身は蹲踞しているイメージです。唾液多めで舌長めに描いて頂けると助かります…。\n以上が希望ですが、舌出し・フェラにフォーカスしていれば、服装や描写、構図など、ご解釈やご嗜好にあわせてお好きなように描いて頂ければと思います。\nもしご興味がおありでしたら、是非ご一考の程、よろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@open_orc_habu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2668344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96db5a56/uploads/outputs/ac48d56d-0994-4917-913e-def631803ba9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9b004aa11d9c8c653bae87410da05c8b", "srcset": "https://si.imgix.net/96db5a56/uploads/outputs/ac48d56d-0994-4917-913e-def631803ba9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9b004aa11d9c8c653bae87410da05c8b, https://si.imgix.net/96db5a56/uploads/outputs/ac48d56d-0994-4917-913e-def631803ba9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d2384d3ad24b597ab07ebd012271c50 2x, https://si.imgix.net/96db5a56/uploads/outputs/ac48d56d-0994-4917-913e-def631803ba9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b54758ad1312b6dace0c948587c1c3e 3x"}, "duration": 33, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"sr