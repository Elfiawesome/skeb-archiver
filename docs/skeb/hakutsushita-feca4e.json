来ればよろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 441705, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Dandy", "screen_name": "Superdive43", "avatar_url": "https://pbs.twimg.com/profile_images/1905382184921563138/kjD_sYyh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1671744205/1738859826/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 1238137, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "くーばーど🔞Skeb依頼くれないかッ？！", "screen_name": "coobard", "avatar_url": "https://pbs.twimg.com/profile_images/1816170356119629824/qmFqiDRZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/28596583/1674133282/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "nc": 184}, {"id": 1298068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "CBM | 丹羽", "screen_name": "CBM_Mazodragon", "avatar_url": "https://pbs.twimg.com/profile_images/2015073221951762432/gPDWkb0u.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1309674569821687809/1769494202/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 1561282, "creator": true, "nsfw_acceptable": true, "acce