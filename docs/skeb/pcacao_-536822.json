04f/uploads/origins/96d0a6d1-f0ea-4fd4-94cd-e9b4b9aabc13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4aa70df4b0687907213fc5591fde6bde, https://si.imgix.net/2b52304f/uploads/origins/96d0a6d1-f0ea-4fd4-94cd-e9b4b9aabc13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d21e880f4f68801a6e7bcd4444fa49bb 2x, https://si.imgix.net/2b52304f/uploads/origins/96d0a6d1-f0ea-4fd4-94cd-e9b4b9aabc13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a340d7a82b3036ff7f2ef1a336f9d12d 3x"}, "body": "はじめまして、心臓焼きさん！\nクッキーランのキャラクターをもとに描かれた、心臓焼きさんの美しく力強い作品の数々にとても感動しました。そのコンセプトを素晴らしく広げて表現されていて、本当に魅了されました！\n\n実は、以前自分のキャラクターの「クッキー版」を作っていただいたことがありまして、もしご興味があれば、そのクッキーと設定をもとに、心臓焼きさんの印象で一枚描いていただけたらとても嬉しいです！^^\n\n彼は私立探偵で、時には身体的な性質の変わった仕事を引き受けることもあるため、実はかなり筋肉質な体格をしています。また、彼は本や遺跡の探索が好きで、隠された遺物を探すのが好きな読書家です。性格や態度においては、優しく、落ち着いていて、洗練された人物です。戦闘時には「HAKASE's REFERENCE」にある本を媒体にして魔法を使います。、特に集中しているときには青い瞳が暗闇で輝きます。\n\nポーズや絵の詳細について、シチュエーションの詳細はお任せします！衣装については、以下のフォルダーにある1番から5番の絵を参考にしてください。追加の詳細は添付されたキャラクターシートに記載されています。「クッキー姿」は「Cookie ver.」というフォルダに入っておりますので、ぜひご参照ください。どのように彼を描いていただけるのか楽しみにしています！\n\nリクエストを検討していただき、ありがとうございます！\n\nhttps://www.dropbox.com/scl/fo/nozp2l3n3jz125y449hp1/AL75qxRn05tDcz7lorOKY3Q?rlkey=jpg8p9hrgdgwy9pqbo1p6hs6n&st=ok48e2lr&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pcacao_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3304333, "client_id": 593591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58f82aedff7e3c603116fbcd756b26a4", "srcset": "https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58f82aedff7e3c603116fbcd756b26a4, https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21b7b1a62cc4c23fdb529ae3ffaa5f48 2x, https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b2bdba0bd4967e315347c35c780ac56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f717185e036b768fd921d57d639db37", "srcset": "https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f717185e036b768fd921d57d639db37, https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bde95824387a376902e7b06d63e168d9 2x, https://si.imgix.net/e4e90307/uploads/origins/e50c8bfe-207d-4aca-838c-6ec77ebec9d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b942006660059fd44e4bd4755681097b 3x"}, "body": "こんにちは！私のOC \"ソラレアリス \"です。彼は感覚を与えられた星で、死すべき生涯を何度も生きることによって、死を経験する機会を与えられています。\n\n参考文献では、彼の猫の特徴は無視してください。\n\n私のリクエストは、彼をブラックホールとして描いてほしいということだ。ブラックホールは超新星（大質量星の残骸または死）によって形成されるからだ。\n\n彼の長い金色の毛が、ブラックホールの周りを回っている「金色の後光」のように、彼の周りを渦巻いているのを想像しています。新しい銀河や星を形成する恒星の涙を流しながら、体を丸めて自分を抱きしめている姿を想像している。そのために彼は何も身に着けていないが、露骨にするつもりはなく、ただブラックホールの義人化のように描かれることを意図している。\n\n彼は輝いており、その身体は宇宙と星々によって散らばっている。彼は光り輝く、破滅的な天文学的異常である。\n\nもちろん、他のポーズや描写も見てみたい！余分なもの、あなた自身のアイデア、何でも見てみたい！感謝您\n\nhttps://drive.google.com/drive/folders/1oJcyqP8cJM2h6aikuew8vGq7XXyr1sHK?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre"