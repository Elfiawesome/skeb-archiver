は賢そうに見える（と思っている）だけで時々アクセサリーとしてかけている伊達。視力は非常によい。\n\n描写範囲やポーズなどは、kakuri様のインスピレーションでおまかせで描いていただければ幸いです。\n用途は観賞用、SNSアイコンへの使用などです。\n\nご検討どうぞよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kakuri00000/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2914872, "client_id": 3739490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b9b0b8d38f2f3b7f0876378c19898c10", "srcset": "https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b9b0b8d38f2f3b7f0876378c19898c10, https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff979a5e8fd3f30416399ad245617692 2x, https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfe1d5eeb764a42d3d17771964483daa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=4f47fa0409930a70d1633ee96f5f0b68", "srcset": "https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=4f47fa0409930a70d1633ee96f5f0b68, https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecffd142b5234751bed69d78bf11ab97 2x, https://si.imgix.net/9453dddf/uploads/origins/b89a8b47-2d7c-4a06-b861-9b1b515e135d?bg=%23fff&fm=webp&au