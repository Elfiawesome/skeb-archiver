\n\nもう一人はヴァンパイア（https://photos.app.goo.gl/FfmEpSDYWAkMwTUQ6）。一種冷徹で残酷なタイプだが、モンスターハンターに深い興味を抱いている。彼女は驚異的な再生能力を持ち、殺すことは不可能であるため、自由時間のほとんどすべてをモンスターハンターをもてあそび、いかにして彼女の神経を逆なでできるかに費やしている。\n\n私が考えていたのは、ハンターが受けた戦いの傷を、ヴァンパイアが戯れに抱きしめたり舐めたりするシーンだ。天敵であることを禁じられた二人の奇妙な、敵対的な、時には愛情深い関係を示すような何か。服装やシーンの改変はご自由にどうぞ。どんなものが出来上がるか、ぜひ見てみたいです\n\nありがとうございました！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1650340, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヨジマエ", "screen_name": "0359_am", "avatar_url": "https://pbs.twimg.com/profile_images/1403141495528431616/iUxJ_AD6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1403131816530178050/1652538601/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 89, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1844279, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "平安. ᵗ ᵒ ᵐ ᵃ ᵗ ᵒ", "screen_name": "heiantomato", "avatar_url": "https://pbs.twimg.com/profile_images/1851114963341017088/uAgC75Lz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252937639352610816/1727544542/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2174817, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ﾊﾟﾅﾃｨ💤", "screen_name": "Panatisia", "avatar_url": "https://pbs.twimg.com/profile_images/1954787027838492672/1OgMSPAT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1185558168358670336/1715183236/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request