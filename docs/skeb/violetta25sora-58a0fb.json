ルブルン（ https://x.com/merovingensokyo/status/1963366321103806573/ ）を描いていただけたら嬉しいです。 小さなロココ調の宮殿（https://moselle.moe/minecraft/weiselbrunn.html）に住むビークイーンのプリンセスで、領地の統治、舞踏会の主催、室内楽や舞踊、甘いペイストリーを楽しむ日々を送っています。ドレスの色や生地はご自由に調整ください。\n\n構図やシチュエーションなどはご自由に。あなたのセンスを存分に活かして、インスピレーションのままにメリッサを描いてください。ご検討いただき誠にありがとうございます。敬具 P.P.A. https://x.com/merovingensokyo/status/1963366321103806573/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@violetta25sora/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2261514, "client_id": 2397390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b47db27b/uploads/origins/d91fd95f-a1c0-42ce-8767-6ed2507a3575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8848611ecf3729cfbf152860d48aa8ae", "srcset": "https://si.imgix.net/b47db27b/uploads/origins/d91fd95f-a1c0-42ce-8767-6ed2507a3575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8848611ecf3729cfbf152860d48aa8ae, https://si.imgix.net/b47db27b/uploads/origins/d91fd95f-a1c0-42ce-8767-6ed2507a3575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5782e9842ae926c75ca55570d92d9d4b 2x, https://si.imgix.net/b47db27b/uploads/origins/d91fd95f-a1c0-42ce-8767-6ed2507a3575?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee15a9c042c97f62147cabf0a4ea81e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b47db27b/uploads/origins/d91fd95f-a1c0-42ce-8767-6ed2507a3575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=778da6830d5d772915aa0a06f2605250", "srcset": "https://si.imgix.net/b47db27b/uploads/origins/d91fd95f-a1c0-42ce-8767-6ed2507a3575?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=778da6830d5d772915aa0a06f2605250, https://si.imgix.