%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1797110734876450816%2F31q4JFtF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6871a1675b5073b82f8565a6f5a60f0, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1797110734876450816%2F31q4JFtF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34ec70bd4fc4a63a4ffca52e1bf19f2a 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1797110734876450816%2F31q4JFtF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=585fefdab8d61b247ee415e11d270aba 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/e763f222-a758-46e1-9b7b-5a4a03fffc02?response-content-disposition=inline&Expires=1779200698&Signature=nZ3tvxxUcbdlHsFXvg1CbDMEnZ0RSmYV6fgt0ala39pnQcNGgNyYuYubsebTd7B2hYQ5M6mv5z8zW1w5HSxAU0D5AurmSsMuVFaInuWXYD1D9KNCvfmcPBUqSGCN12h9dnxqKNGIg5kJcone~etf70PPEPMPT66PuwekUnbwWj0Sj882A4yYdDXs7yBOYUabDxjsWAAd5sLKky09NiwT7sa6F8-Kz-EjCMUNlDaFJDFdOUP2LTTHCyXtLCbHX4EL18WdxSBw7cqrNB8MIJS-4xw1abTmUYVpAxGeHeCDh9W407HGhK~fI6~u59vKOqgvkPVvROSjzQgzmbUuZk-g4Q__&Key-Pair-Id=K1GS3H53SEO647", "duration": 244, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1797110734876450816%2F31q4JFtF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4fc56d6e48df0e57111f6239e0f370f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1797110734876450816%2F31q4JFtF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4fc56d6e48df0e57111f6239e0f370f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1797110734876450816%2F31q4JFtF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e84b9c3e45d65a2648a97f301a59cff 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1797110734876450816%2F31q4JFtF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2076dfce7fdd653fb04089d07f2d6de7 3x"}, "body": "「君が」黙って委員会の仕事を手伝ってくれた。\nだけど、君との関係はそれっきりで声をかけることもできない…\n君も、私に近寄ることすらない…結局は他の人と一緒だったんだ。\nあの時、私は、本当に嬉しかった…\n\n…さあ、これで仕事は終わった。\n今日手伝ったのは私の気まぐれ…居残りなんてしたくないからね。次は、簡単に他人の仕事を背負うのはやめることだ。\n\n…なにか言いたいことでもあるのかい？あまり引き留められると、見回りに来た教師に見つかってしまうぞ？\n「友達になってほしい」って…？ふふっ、今更遅いぞ。\n私がその言葉をどれだけ待っていたと思っている？\n\n私は…私はっ、この半年の間…あの日からずっと、君と仲良くなりたいって…そう思いながら過ごしてきたんだ。\nだけど、半年も想い続けたせいで私は…\n友達としてじゃなくて、「恋人として」君と一緒にいたいと気づいてしまった。\n\n…やっぱり、君の驚いた顔って、本当に面白い…\n君が今どう思っているか、当ててあげるよ。「同性が好きなんてありえない」って…そう思ってるんだろ？\nわかったら、もう金輪際私に話しかけてこないでほしい。…君の顔を見るだけでも、辛いんだ。\n\nそれとも、私の気持ちに応えてくれるのかい？…いや、今のは忘れてほしい。\nそれじゃあ、さようなら。もう話すこともないだろう。\n\n…なに？まだ、何か言いたいのかい？\n「最初はお友達から始めよう」って…君、それがどういう意味か分かって言っているのか？！\n心の底では私のことを馬鹿にして、後で裏切るつもりじゃないのか！？…それとも…\n…本当に私の気持ちを、受け入れてくれるのかい？\n\n\n女の子が好きでもいいの？こんな、素直じゃない子でも本当にいいの？\nだめ、信じられない。\n本当に私の気持ちを受け入れてくれるっていうなら…君が他の人とは違うっていうのなら…\n好き…って、言ってほしい…ちゃんと目を見て、君の言葉で…\nお願い、はずかしがらないで…？私だって、ほら…恥ずかしくてたまらないの…手が震えているの。\nねえ、本当に私のことを思うなら…言って。\n本当は、私のこと…好きなんでしょう？\n\n…うふふ。その言葉を待っていたの。君と出会ったあの日からきっと…\nねえお願い、約束して。私がどんなに君に冷たくしてしまっても、不器用でも…\n私から離れていかないで…？", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Ritsu___YURIJO/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 1314147, "client_id": 65838, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/9a050992-75a4-4002-84c3-366a5ca135be?response-content-disposition=inline&Expires=1779200698&Signature=hvFvhgYQmBVtXiX-ugWbjcwvgUrum1HxtM9Dl61XBHwSypWLX4Pi-jPXYINqQ53vUGGPDIH3Z3FkymcAtZHjKKZxAN0qTRGlKk7RlPIdfH1TcsTGzjnWia5Rj4n285CVp7qCFJZ8bJix8r56q9M5Gy4Oq0u4kE30QNVFZCMvSrOMHj7dh7~SethWU1RM9GFtYJk2~HVOJPG~gT6F0I-zwDSt2nMjWfi9ilUGTlN~GzZdwfCt5bOtcJllXWcV9ltGbyJnHxNZC3syW5jvCQZOnjkTosrVSOhiF7CrRASr0HWZHFco1Cg5Kh7NxSxXX7oYQV9ixX~UADQL58Hz6TEbvw__&Key-Pair