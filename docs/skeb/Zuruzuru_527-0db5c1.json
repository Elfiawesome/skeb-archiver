4fe1\u5185\u3084\u914d\u4fe1\u30b5\u30e0\u30cd\u30a4\u30eb\u3067\u306e\u4f7f\u7528(\u53ce\u76ca\u5316\u6e08)\n\u30fbSNS\u7b49\u3067\u306e\u30a2\u30a4\u30b3\u30f3\u3084\u30d8\u30c3\u30c0\u30fc\u306a\u3069\n\u30fb\u30a4\u30e9\u30b9\u30c8\u306e\u4e0a\u306b\u30a6\u30a9\u30fc\u30bf\u30fc\u30de\u30fc\u30af\u3084\u30b5\u30a4\u30f3\u3092\u3064\u3051\u308b\n\u30fb\u5225\u7d20\u6750\u3068\u7d44\u307f\u5408\u308f\u305b\u3066\u306e\u4f7f\u7528\n\u30fb\u305d\u306e\u4ed6\u914d\u4fe1\u6d3b\u52d5\u3068\u3057\u3066\u306e\u4f7f\u7528\n\n\u3010\u8a73\u7d30\u3011\n\u69cb\u56f3\u7b49\u306f\u5b8c\u5168\u304a\u307e\u304b\u305b\n\u30d0\u30b9\u30c8\u30a2\u30c3\u30d7\u4ee5\u4e0a\u306e\u30a4\u30e9\u30b9\u30c8\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u51fa\u6765\u308c\u3070\u8170\u4e0a\u3001\u819d\u4e0a\u304f\u3089\u3044\u306e\u30a4\u30e9\u30b9\u30c8\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u8cc7\u6599\u306f\u6dfb\u4ed8URL\u3092\u53c2\u7167\u9858\u3044\u307e\u3059\uff01(\u8863\u88c5\u3084\u9aea\u578b\u7b49\u81ea\u7531\u306b\u5909\u66f4\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u3082\u5927\u4e08\u592b\u3067\u3059)\n\u7d30\u304b\u3044\u90e8\u5206\u3068\u3057\u3066\u76ee\u306e\u30cf\u30a4\u30e9\u30a4\u30c8\u306f\u30cf\u30fc\u30c8\u3001\u4eba\u9593\u306e\u8033\u3042\u308a\u3001\u5de6\u53f3\u306b\u30ad\u30d0\u3042\u308a\u3067\u3059\u3002\n\u732b\u8033\u3001\u9aea\u306e\u6bdb\u3001\u9854\u3001\u624b\u3001\u5c3b\u5c3e\u306f\u898b\u5207\u308c\u306a\u3044\u3088\u3046\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\u898b\u5207\u308c\u308b\u5834\u5408\u3001\u5225\u30c7\u30fc\u30bf\u3067\u898b\u5207\u308c\u3066\u3044\u306a\u3044\u30c7\u30fc\u30bf\u3092\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u601d\u3044\u307e\u3059\u3002\n\n\u3010\u7d0d\u54c1\u5f62\u5f0f\u3011\nPSD\u5f62\u5f0f\u3067\u304a\u9858\u3044\u3057\u307e\u3059\uff01\n\u80cc\u666f\u304c\u3042\u308b\u5834\u5408\u306f\u4eba\u7269\u900f\u904e\u30c7\u30fc\u30bf\u3068\u80cc\u666f\u5225\u3005\u3067\u7d0d\