が着用されています。ワンピースのウエストには、シルバーの細いベルトが巻かれています。足元には、黒いロングブーツが合わせられます。\n\n幽谷霊華の髪は、グレーのロングコートに合わせて、シルバーグレーの色合いの髪飾りが使われています。髪は、ウェーブをかけたセミロングで、顔周りには、襟元の装飾と同じ白いレースがあしらわれています。\n\n━━━\n\nもちろんデザインに関しては完全にこの通りである必要はありません、あなたのお好きなように描くことができます\nご検討のほどよろしくお願いいたします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V3jGw/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2646376, "client_id": 941212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80733d02/uploads/origins/d68e80ab-012a-4c9b-ac94-b98679124ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d5168a5115382e751a8592231e92a5", "srcset": "https://si.imgix.net/80733d02/uploads/origins/d68e80ab-012a-4c9b-ac94-b98679124ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00d5168a5115382e751a8592231e92a5, https://si.imgix.net/80733d02/uploads/origins/d68e80ab-012a-4c9b-ac94-b98679124ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adec88a83ccf7de9d8d1dbb7af0abc94 2x, https://si.imgix.net/80733d02/uploads/origins/d68e80ab-012a-4c9b-ac94-b98679124ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a79324a00bde201dc88bad4108383291 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80733d02/uploads/origins/d68e80ab-012a-4c9b-ac94-b98679124ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc8be33f20078599e3d90125bc88cc14", "srcset": "https://si.imgix.net/80733d02/uploads/origins/d68e80ab-012a-4c9b-ac94-b98679124ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc8be33f20078599e3d90125bc88cc14, https://si.imgix.net/80733d02/uploads/origins/d68e80ab-012a-4c9b-ac94-b98679124ffd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&