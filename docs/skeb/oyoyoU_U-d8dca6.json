8a\u305f\u304c\u3089\u305a\u3001\u5b8c\u5168\u306b\u304a\u8377\u7269\u3002\u3044\u3064\u3082\u30a6\u30b6\u3063\u305f\u3089\u3057\u304f\u30da\u30e9\u30da\u30e9\u304a\u3057\u3083\u3079\u308a\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u305f\u307e\u305f\u307e\u6a5f\u5acc\u60aa\u304f\u30d6\u30c1\u5207\u308c\u305f\u56e3\u9577\u306b\u7247\u65b9\u306e\u30c4\u30a4\u30f3\u30c6\u30fc\u30eb\u3092\u5f15\u304d\u3061\u304e\u3089\u308c\u3066\u3044\u308b\u3002\u81ea\u5206\u306e\u3053\u3068\u3092\u5584\u826f\u3067\u304b\u5f31\u3044\u53ef\u611b\u3044\u5973\u306e\u5b50\u3060\u3068\u601d\u3063\u3066\u304a\u308a\u3001\u4ed6\u8cac\u601d\u8003\u3001\u88ab\u5bb3\u8005\u30c5\u30e9\u306e\u30d7\u30ed\u3002\u30d0\u30c8\u30ed\u30ef\u3067\u3082\u305d\u306e\u6027\u683c\u3092\u6d3b\u304b\u3057\u3001\u5168\u304f\u7cbe\u795e\u3092\u75c5\u3080\u3053\u3068\u304c\u306a\u3044\u3002\u3044\u3064\u3067\u3082\u30d4\u30fc\u30d4\u30fc\u5f31\u97f3\u3092\u5410\u304d\u3001\u5468\u308a\u3092\u75b2\u5f0a\u3055\u305b\u3066\u3044\u308b\u3002\n\u305d\u306e\u92fc\u306e\u7cbe\u795e\u3092\u8cb7\u308f\u308c\u3066\u304b\u3001\u4e3b\u50ac\u306b\u30d0\u30c8\u30ed\u30ef\u306e\u30e9\u30b8\u30aa\u30b3\u30fc\u30ca\u30fc\u3092\u4efb\u3055\u308c\u3066\u3044\u308b\u3002\n\n\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fc\u5ddd\u5d0e: \u4e8c\u8db3\u6b69\u884c170cm\u306e\u3001\u5168\u8eab\u304c\u30bd\u30d5\u30c8\u30dc\u30a2\u751f\u5730\u306e\u3088\u3046\u306a\u808c\u89e6\u308a\u306e\u72ac\u3002\u8db3\u9996\u3084\u8098\u306a\u3069\u95a2\u7bc0\u3042\u305f\u308a\u306f\u30b7\u30ef\u304c\u3067\u304d\u3066\u3044\u308b\u3057\u5168\u4f53\u7684\u306b\u30c0\u30dc\u30c3\u3068\u3057\u3066\u751f\u5730\u304c\u4f59\u3063\u3066\u3044\u308b\u305f\u3081\u3001\u4f1a\u3063\u305f\u4eba\u306b\u3088\u304f\u7740\u3050\u308b\u307f\uff1f\u3068\u805e\u304b\u308c\u308b\u3002\u3057\u304b\u3057\u305d\u306e\u8cea\u554f\u306b\u98fd\u304d\u3066\u3044\u308b\u305f\u3081\u30cc\u30f3\u30c1\u30e3\u30af\u3092\u632f\u308a\u56de\u3057\u8972\u3044\u304b\u304b\u3063\u3066\u304f\u308b\u3002\u72ac\u7a2e\u3092\u805e\u304f\u3068\u30b9\u30d4\u30c3\u30c4\u3060\u3068\u7b54\u3048\u308b\u304c\u3001\u602a\u3057\u3044\u3002\u5df1\u3092\u72ac\u3060\u3068\u8a00\u3044\u5f35\u308b\u304c\u4eba\u6a29\u3092\u4e3b\u5f35\u3057\u305f\u308a\u3001\u4eba\u9593\u3089\u3057\u3044\u6587\u5316\u7684\u306a\u751f\u6d3b\u3092\u597d\u307f\u72ac\u6271\u3044\u3055\u308c\u308b\u3068\u30cc\u30f3\u30c1\u30e3\u30af\u3092\u53d6\u308a\u51fa\u3059\u3002\u3057\u304b\u3057\u3001\u66b4\u529b\u3092\u632f\u308b\u308f\u308c\u305d\u3046\u306b\u306a\u308b\u3068\u72ac\u306b\u9177\u3044\u3053\u3068\u3059\u308b\u3093\u3067\u3059\u304b\uff1f\u3068\u72ac\u306e\u90e8\u5206\u3092\u4e3b\u5f35\u3057\u3066\u304f\u308b\u3002\u307e\u305f\u3001\u90fd\u5408\u304c\u60aa\u304f\u306a\u308b\u3068\u4e0a\u76ee\u9063\u3044\u3067\u30af\u30fc\u30f3\u2026\u3068\u9cf4\u3044\u305f\u308a\u3001\u53ef\u611b\u3044\u72ac\u3076\u308d\u3046\u3068\u3059\u308b\u3002\u58f0\u306f\u88cf\u58f0\u306e\u3088\u3046\u306b\u9ad8\u304f\u3001\u7537\u3068\u3082\u5973\u3068\u3082\u5224\u5225\u304c\u3064\u304b\u306a\u3044\u3002\u6b63\u9762\u9854\u304c\u7121\u8868\u60c5\u3067\u6016\u3044\u3068\u3088\u304f\u8a00\u308f\u308c\u308b\u3002\u53e3\u304c\u60aa\u304f\u3066\u30ad\u30ec\u3084\u3059\u304f\u3001\u3059\u3050\u624b\u3084\u8db3\u304c\u51fa\u308b\u3002\u672c\u4eba\u306f\u81ea\u5206\u306e\u3053\u3068\u3092\u967d\u6c17\u3067\u4eba\u306b\u597d\u304b\u308c\u3084\u3059\u3044\u5b58\u5728\u3060\u3068\u601d\u3063\u3066\u3044\u308b\u3002\n\u30c9\u30fc\u30ca\u30c4\u5c4b\u3067\u751f\u8a08\u3092\u7acb\u3066\u3066\u3044\u308b\u304c\u3001\u63a5\u5ba2\u5bfe\u5fdc\u304c\u6700\u60aa\u306e\u305f\u3081\u8a55\u5224\u3082\u6700\u60aa\u3067\u3042\u308b\u3002\u5473\u306f\u666e\u901a\u3002\u5e97\u5185\u3067\u98df\u3079\u306a\u304c\u3089\u3044\u3064\u307e\u3067\u3082\u8a71\u3057\u3066\u3044\u308b\u5ba2\u3092\u5acc\u3044\u3001\u30ab\u30a6\u30f3\u30bf\u30fc\u306e\u4e2d\u304b\u3089\u300c\u3055\u3063\u3055\u3068\u5e30\u308c\u30ef\u30f3\uff01\u304a\u3081\u30fc\u3089\u306e\u305b\u3044\u3067\u58f2\u4e0a\u6e1b\u3063\u3066\u8ff7\u60d1\u3057\u3066\u308b\u30ef\u30f3\u3088\u3053\u3063\u3061\u306f\uff01\u300d\u3068\u53eb\u3093\u3067\u304f\u308b\u3002\u6bce\u591c\u5e97\u306e\u30ec\u30d3\u30e5\u30fc\u6b04\u3067\u30ec\u30b9\u30d0\u3092\u7e70\u308a\u5e83\u3052\u3066\u3044\u308b\u3002\n\u30d0\u30c8\u30ed\u30ef\u3067\u306f\u72ac\u3092\u6bba\u305d\u3046\u3068\u3059\u308b\u30c9\u755c\u751f\u306f\u3055\u3059\u304c\u306b\u5c45\u306a\u3044\u3060\u308d\u3046\u3068\u9ad8\u3092\u304f\u304f\u3063\u3066\u3044\u305f\u77e2\u5148\u30ab\u30c1\u30e7\u30da\u306b\u80cc\u5f8c\u304b\u3089\u8972\u308f\u308c\u3001\u3059\u3093\u3067\u306e\u3068\u3053\u308d\u3067\u907f\u3051\u305f\u3002\u305d\u308c\u4ee5\u6765\u30ab\u30c1\u30e7\u30da\u306e\u3053\u3068\u306f\u898b\u4e0b\u3057\u3001\u5acc\u60aa\u3057\u3001\u540c\u6642\u306b\u30b3\u30a4\u30c4\u306f\u72ac\u3082\u6bba\u305b\u308b\u3093\u3060\u3068\u6050\u6016\u3057\u3066\u3044\u308b\u3002\n\n\u3010\u4e8c\u4eba\u306e\u95a2\u4fc2\u3011\n\u30fb\u30ab\u30c1\u30e7\u30a8\u307a\u307a\u306f\u30b9\u30d4\u30fc\u30c9\u30b9\u30bf\u30fc\u5ddd\u5d0e\u306e\u4e2d\u8eab\u304c\u6c17\u306b\u306a\u308a\u521d\u5bfe\u9762\u3067\u80cc\u5f8c\u304b\u3089\u6bba\u305d\u3046\u3068\u3057\u305f\u3053\u3068\u304c\u3042\u308b\u304c\u3001\u5931\u6557\u306b\u7d42\u308f\u3063\u3066\u3044\u308b \u305d\u306e\u5f8c\u3082\u5168\u304f\u60aa\u3073\u308c\u305a\u30b1\u30ed\u30c3\u3068\u3057\u3066\u3044\u308b\n\u30fb\u304a\u4e92\u3044\u300c\u3053\u3044\u3064\u30a6\u30b6\u30c3\uff01\u300d\u300c\u307f\u3093\u306a\u3053\u3044\u3064\u304b\u3089\u6bba\u3057\u3066\u304f\u308c\uff01\u300d\u3068\u601d\u3063\u3066\u3044\u308b\u304c\u985e\u306f\u53cb\u3092\u547c\u3076\u306e\u304b\u3001\u306a\u305c\u304b\u4e00\u7dd2\u306b\u884c\u52d5\u3057\u3066\u3044\u308b\u59ff\u3092\u898b\u304b\u3051\u308b\n\u30fb\u304a\u4e92\u3044\u3092\u898b\u4e0b\u3057\u3066\u304a\u308a\u3001\u81ea\u5206\u306e\u65b9\u304c\u4e0a\u3067\u304a\u524d\u304c\u4e0b\u3060\uff01\u3068\u3053\u3068\u3042\u308b\u3054