auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b52f6b113337982db71aad8841b61b9, https://si.imgix.net/e251e080/uploads/origins/0c98ded9-2d44-4ebd-9ffd-7d71634b87b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a50d80451d718308a23055d2030c002a 2x, https://si.imgix.net/e251e080/uploads/origins/0c98ded9-2d44-4ebd-9ffd-7d71634b87b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1bc4c36f406997464a3039bc19afbf04 3x"}, "body": "Hello! Your art is so lovely. Would you draw my characters smiling together for me? \n\nThey are mother and son.\n\n☀️ ELIZA | 29 YEARS OLD | 164 CM\n\n› Darker skin.\n› Brown hair that fades into a light pink at the tips. It's very long and usually tied into a very loose ponytail.\n› Bright blue eyes. They are very gentle and soft.\n› Two beauty marks: one above her left eye, one under her right eye.\n› Extremely kind and gentle-hearted. She is a warm, extroverted person who is very sure of herself. She loves humanity, loves being alive, and has an unfailing optimism for the future. \n\n🦋 ELIO | 4 YEARS OLD | 105 CM\n› Darker skin.\n› Black hair.\n› Bright blue eyes that look like they're sparkling.\n› One beauty mark on the bridge of his nose.\n› He can be very shy, but is a sweet little boy who loves his mother and father very much. He warms up to strangers very quickly. Very curious. Very sensitive — he laughs and smiles easily, but also cries easily. \n\nThank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1NnGlPZ4ZD7QIDVXnwUn4ryw1qc2D4RP5?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2540362, "client_id": 2255263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771f610e45e362080140d6715660e077", "srcset": "https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=771f610e45e362080140d6715660e077, https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e60a6cd9f2b7022282f19a0166bdd73 2x, https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fb6fad5a2be7c85b5e0d0fa21780354 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efd7da1edff4b418e46b70b2779adf53", "srcset": "https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efd7da1edff4b418e46b70b2779adf53, https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fee7da220717fd29faa384468f72d967 2x, https://si.imgix.net/97c33b87/uploads/origins/b42207f8-bb4f-41de-bad4-dedc60d80f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e141da432e2671b1a1c7dde7625d1fb3 3x"}, "body": "こんにちは！あなたの作風はとてもクールだから、もし私のオチを描いてもらえたら嬉しいわ：\n\nANAIS (https://drive.google.com/drive/folders/1jizcJQIFrorTMzlmxXEJ2vqyQmTquOWi?usp=sharing)\n\n> 1940年代の超常現象調査官。彼女はまた、プロパガンダを作成する。\n> アナイスは表向きは親切で寛大で、いつも笑顔で礼儀正しい。その内面には大きな闇が隠れており、それは衝動性やほとんどの恐怖に対する無感覚に表れている。他人と深く結びつくことができず、人間関係を壊してしまう。いつも退屈しており、パーティー、ドラッグ、暴力、操り、親切、趣味、買い物、仕事など、退屈を和らげる方法を探している。\n> アナイスはファッションが大好きで、身だしなみに気を使う。スキンケアも計画的に行っている。好きな色はピンク。\n\nテーマ：鏡、仮面舞踏会、秘密、目の錯覚、仮面、危険を隠す美、変身、獲物が捕食者になる、霞んだ部屋、遮られた顔、影、嘘の中の真実／真実の中の嘘", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2540362, "client_id": 1111477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c74a9a925c46e28b12f642ad6c9fd87", "srcset": "https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c74a9a925c46e28b12f642ad6c9fd87, https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88bc65c0455ba0e3fa701c8074616998 2x, https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2b72f2091bd431b655c720113fe6b90 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e8ce276e9d8177e827bb8a7a8ab00e0", "srcset": "https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e8ce276e9d8177e827bb8a7a8ab00e0, https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5809fd41310d27db103885f3ab15e84c 2x, https://si.imgix.net/2fcd0ed5/uploads/origins/0dc8ef21-c083-4a44-8b12-99d0a2f4e409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1caca84562a6928e9b6e74b6a3b3ac6 3x"}, "body": "あなたの作曲が大好きです！私のキャラクター「キーパー」をリクエストしたいです。\n\n彼女は卵になり、死ぬとまた孵化する不死身です。彼女はカルト教団のような町に育てられ、一線を越えると殺されるが、そうでなければリーダーとして扱われる。彼女は砂漠に住んでいる。それが彼女の役割であり、人間の名前がないため、彼女は「キーパー」と呼ばれている。\n\n彼女は自分を神と人間の中間の存在とみなしており、決して馴染むことはない。孤独だが、人間を愛しているため、人間のために正しいことをしたいと思っている。\n\nモチーフは、月と星、古代遺跡、カササギ、動物の生け贄、砂漠、中間、車輪／円／サイクルなど。\n\n服装は何でもOK。彼女はいつもベールをかぶっている。彼女のタトゥーは簡略化されていても、描きやすければ描かなくてもいい！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1i85XRB0syTqQuigpfTgFZVijhXo7aPXj?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2540362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f2b1f20692a61a6dff0e0ce9cb74bf8", "srcset": "https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f2b1f20692a61a6dff0e0ce9cb74bf8, https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f5b96f65d063578b8faa9511f5a8710 2x, https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0225eeb7f2de092194792f03d6754e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b5b773da298ea026e54628f38cb779c", "srcset": "https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b5b773da298ea026e54628f38cb779c, https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90e9f50f368130897537d79efbc4c1cd 2x, https://si.imgix.net/7dce68f6/uploads/origins/9197a6f8-4e96-4530-bb5e-c4ed0a6f610a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04495a220991d5b143aa167099de64ef 3x"}, "body": "はじめまして！kaさんの素敵なイラストや漫画が本当に大好きです！！！\n\nもしよろしければ、ダモンくんとクピドさんを描いていただきたいです…！\nできればふたりが好きな食べ物を食べていたらよりうれしいです！\n\n構図やサイズなどはお任せいたします。金額等が不足しておりましたら、お手数ですが再送をお願いいたします。\n\nご縁がありましたらお引き受けいただけるととてもうれしいです！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2540362, "client_id": 2300019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a380b916aceba1325cc1ad8dfc659a32", "srcset": "https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a380b916aceba1325cc1ad8dfc659a32, https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3ce4679c5f8165c2fca2ea6495ed439 2x, https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05a8c651e47fe6bb6d15ad279916b57f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83bea6865469f718591d8288100e0d29", "srcset": "https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83bea6865469f718591d8288100e0d29, https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d09dee6bc73538cf3920a69cf64f19e 2x, https://si.imgix.net/59253156/uploads/origins/e0eb5641-cbd7-4226-9969-774c95d5d12a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecef00f8783eb3f891af18f231686da4 3x"}, "body": "こんにちは！2人のキャラクターのイラストをお願いします。\n\nマギー（166cm）。\n裕福な家庭に生まれ、物腰が柔らかく礼儀正しい社交家。従順に育てられる。優しく、不器用。チャーリーに出会うまでは、常に他人のために犠牲を払い、自分の欲望をあきらめていた。普段はおとなしい表情だが、見かけによらず賢い。\nテーマ：真珠、人形、リボンと金の鎖、血と涙、獲物\n\nチャーリー（170cm）\n利己的で計算高い性格。とても温厚に振る舞うが、冷淡になりがち。恋するふりをしているうちに、うっかり恋に落ちてしまう。非常に優しくもあり、非常に残酷でもある。目には光がない。\nテーマ：羊の皮をかぶった狼、蛇、飢えと歯\n\nマギーとチャーリーの関係は完璧に見えるが、押し引きのゲームである。チャーリーはパワーを得るためにマギーを操り、マギーはチャーリーの弱みを暴くために甘く従う。それでも二人はこの愛に溺れていく。自由に描いてください！\n\nありがとうございました！\n\nhttps://www.deviantart.com/stash/21szt06pipjb", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2540362, "client_id": 3015400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be4914ea8ee54b9bcb20ea2619fa866d", "srcset": "https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be4914ea8ee54b9bcb20ea2619fa866d, https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff677de7a94fdb5836a2998f5ed1cf19 2x, https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e4628e7f459862cd2440d753a4cff6e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=621771015294039e96f5c2018cf9ab30", "srcset": "https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=621771015294039e96f5c2018cf9ab30, https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4da9a5395c043ff3956cb24dbbf34724 2x, https://si.imgix.net/bac47561/uploads/origins/f7a018cf-57cb-40f0-b203-c29c2d133ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9e47147ed9c540563bec5e6b4249a8f 3x"}, "body": "Hello! My friend and I would like to request an illustration of our characters.\n\nIDONY (175CM):\nA gentle girl who gets distracted easily. She is physically affectionate. She loves easily, but she does not give all of her heart. She is a romantic sculptor.\n\nJAY (187CM):\nA free spirit who dreams of traveling the world. Most of the time, he's very charismatic, but he quickly gets flustered when teased. He is very expressive.\n\nThey dream of a fairytale love with each other. JAY wants to show IDONY the world, but he is also afraid of being hurt by her. IDONY likes to sculpt JAY to remember him as her precious artwork, but she holds him at a distance. Despite their fears and mistakes, they learn to be honest with their feelings, and to treasure each other dearly.\n\nMotifs: statues, apples, birds, spring season\n\nWe'd like a warm scene with plants if possible. Please pick cozy date outfits for them! Thank you!\n\nhttps://drive.google.com/drive/folders/14zh3VByAt3IcI_AZTu81f1xEe7ANyL2K?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2540362, "client_id": 3558168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd27357c2b7063e6f692a81453c19338", "srcset": "https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd27357c2b7063e6f692a81453c19338, https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=472fd22dea608bac77707f18c8a9dd47 2x, https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a6ddef6fb3c7fbfd7880d98115e471a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=438fd257c11b9e7eb29099c2d65a6180", "srcset": "https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=438fd257c11b9e7eb29099c2d65a6180, https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eac8924d3dff8663e6fe64d04dfc21e0 2x, https://si.imgix.net/fff7beae/uploads/origins/5115af4b-8432-49d5-be32-e9c25870c7af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71b11785314c4739409b8cb629dfb106 3x"}, "body": "あなたの作品の構図は本当に美しい！ ; - ; 私のリクエストを考慮していただけると嬉しいです！\n\n もし難しくなければ、私のキャラクター「やっち」のイラストをお願いしたいです。\n\n彼女は裏表のある性格の女の子で、星に願いをかけたのに、心から望んでいないことに無駄遣いをしてしまいました。イメージはウサギで、優しくて頼りになるお姉さんという感じですが、本性はずる賢いキツネです。彼女の世界は、小さな魔法のヒントを含んだ現代的なものだ。映画サークルでカメラ監督を務める大学生。\n\nシナリオは特に考えていませんので、この依頼を楽しんでいただければ幸いです！花びらを失う花、反射、写真、星を連想させるキャラクターです。スタイリング、構図は全てお任せします。\n\n面白くなさそうであれば、遠慮なくキャンセルしてください！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jWdNdXhcONLZIv5zy3aDynSnvGtpbnsh\n\nhttps://drive.google.com/drive/folders/1jWdNdXhcONLZIv5zy3aDynSnvGtpbnsh", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2540362, "client_id": 2793950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=958d07c1496b05fce515239045942563", "srcset": "https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=958d07c1496b05fce515239045942563, https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cb063c3dc78f634de32efb4b02e441d 2x, https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c99b62df085654cd8bdbe071da2adcd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c464434a159225d896ca1e7e94410efc", "srcset": "https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c464434a159225d896ca1e7e94410efc, https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54d8e20baa7c8c3d8c265a7f81495bef 2x, https://si.imgix.net/7244bffe/uploads/origins/6aae8a45-c29e-4bd7-b90b-34df98ba1fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3810c4e0b845294bff030d1602b0cad8 3x"}, "body": "こんにちは！あなたの絵はゴージャスだと思います。もしよければ、僕のOCをリクエストしたいんだけど！\n\n\"ゆうき\" ᑒ｜23｜https://drive.google.com/drive/folders/1CPkIM-IGXKVjb0O18pH0OmxTefywlnJd?usp=sharing\n可愛い顔と優しい声の女の子。しかし、怒りを溜め込んでいる。心の闇を抱えている。\nテーマ：額縁、カラス、夜、人形。\n\n\"のえ\"🎀｜23｜https://drive.google.com/drive/folders/1vIJFmT1Nje9Qx91VR13NF0UUTAVseDdI?usp=sharing\n子供のような喜びを持つかわいい女の子。幼い頃、母親に外に出ることを許されなかったため、人と仲良くなる方法をまだ学んでいる。\nテーマ：かごの中の鳥、鳩、狭い空間、かわいいもの、届かない空。\n\n2人の関係：\n- 複雑だ。\n- ノエはとても粘着質で、純粋に友達になりたいと思っている。\n- 幼い頃、乃絵は母親のお気に入りだったため、優希は嫉妬や妬みの問題を抱えるようになった。\n- 乃絵は優希を信頼しているが、優希は彼女を信頼していない。\n\n自由に描いてください！\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kalinearc/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2540362, "client_id": 1996827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19a74c2f/uploads/origins/85811f6e-8b6d-4188-9964-fff510b2f2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2