n・ベーキングトレイの上にクッキーが乗っている\n　・鈴イメージのネコ\n　・小毬ちゃんイメージのペンギン（？）\n　・静久イメージのウシ\n　・紬イメージのクマ\n　・羽依里イメージのトリ\nこの５つのクッキーは描いて頂きたいです。\nあとは可能な範囲で他にリトバスやサマポケのメンバーモチーフのクッキーをお願いします（無くても問題ありません）\n\n・背景はかぎなど学園の家庭科室を想定していますが\n　料金の範囲で難しければ\n　背景は簡素でも構いません。\n\n以上です。よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@prasma_prasma/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1676342, "client_id": 876910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69350088/uploads/origins/fc900f92-0fad-4353-bf10-96ea934eff26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52fdac27cebec5638b86b04513ca5eb8", "srcset": "https://si.imgix.net/69350088/uploads/origins/fc900f92-0fad-4353-bf10-96ea934eff26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52fdac27cebec5638b86b04513ca5eb8, https://si.imgix.net/69350088/uploads/origins/fc900f92-0fad-4353-bf10-96ea934eff26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c55cd3eaf793ec9a412c52d74bc3916 2x, https://si.imgix.net/69350088/uploads/origins/fc900f92-0fad-4353-bf10-96ea934eff26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2736b5bede06a84925201f515af5f197 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69350088/uploads/origins/fc900f92-0fad-4353-bf10-96ea934eff26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac529b45e34e64db6902a4c37f8b219f", "srcset": "https://si.imgix.net/69350088/uploads/origins/fc900f92-0fad-4353-bf10-96ea934eff26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac529b45e34e64db6902a4c37f8b219f, https://si.imgix.net/69350088/uploads/origins/fc900f92-0fad-4353-bf10-96ea934eff26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr