さんの性遍歴やまさるさんの性器描写を是非拝見したく、セリフ有り＋別カット有りと作画カロリーが高い依頼となりますが、ご検討のほどよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 36173, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "黒悪13", "screen_name": "Kloah13th", "avatar_url": "https://pbs.twimg.com/profile_images/1027213683485593600/ECCGYXFq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/738948195300954112/1465014358/1500x500", "appeal_receivable": false, "popular_creator_rank": 11, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 57095, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🔞hogey🔞", "screen_name": "NK2000MAN", "avatar_url": "https://pbs.twimg.com/profile_images/1368953160111255555/BqlR7GWr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1368938861255008261/1615221609/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 299686, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "stem(すてむ)＠", "screen_name": "stem_720", "avatar_url": "https://pbs.twimg.com/profile_images/1904516422400876544/pLh8d3en.jpg", "header_url": "https://pbs.twimg.com/profile_banners/77726205/1640515815/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 428348, "creator": true, "nsfw_accepta