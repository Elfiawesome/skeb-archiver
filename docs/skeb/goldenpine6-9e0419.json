d_thumbnail_image_urls": {"src": "https://si.imgix.net/c5cad4d6/uploads/origins/68ed2a70-d8c0-4cef-885d-f57840405f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e432c201fefb9380d7a79f87016ba246", "srcset": "https://si.imgix.net/c5cad4d6/uploads/origins/68ed2a70-d8c0-4cef-885d-f57840405f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e432c201fefb9380d7a79f87016ba246, https://si.imgix.net/c5cad4d6/uploads/origins/68ed2a70-d8c0-4cef-885d-f57840405f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c0f97349e7d3de186ddc5e72eb1207aa 2x, https://si.imgix.net/c5cad4d6/uploads/origins/68ed2a70-d8c0-4cef-885d-f57840405f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb3e45b7d455810ebe70334b421a6eb 3x"}, "body": "こんにちは。私のキャラクター「ジェマ」をリクエストしてもいいですか？彼女は親切で、忠実で、エレガントで、優雅な人です。髪の色はブルーで、毛先にグリーンのハイライトが入っています。頬にはそばかすがあり、目は水色で、肌は青白い。背景を参考に、宇宙の果てにあるお花畑に座っているようなイメージでお願いします。周りの空は紫やピンクの色合いでとても幻想的で、たくさんの星がキラキラと輝いています。彼女はたくさんの花を腕に抱えていることもできます。彼女の表情は、とても満足げでリラックスしており、柔らかい微笑みを浮かべていることができます。ご検討ありがとうございました。\n\nhttps://imgur.com/a/6Ji9xuV", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goldenpine6/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1837741, "client_id": 1627489, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beef3b64/uploads/origins/93e1bea1-b137-4508-ad33-93120aedb455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d9886b34a0ede5990683462c4fb6a5", "srcset": "https://si.imgix.net/beef3b64/uploads/origins/93e1bea1-b137-4508-ad33-93120aedb455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d9886b34a0ede5990683462c4fb6a5, https://si.imgix.net/beef3b64/uploads/origins/93e1bea1-b137-4508-ad33-93120aedb455?bg=%23fff&auto=format%2Ccompress&f