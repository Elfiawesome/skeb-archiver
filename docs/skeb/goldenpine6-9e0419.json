tic. \n\nYou can decide the pose, expression, and background. Please draw whatever inspires you from her description! Thank you for considering my request!\n\nhttps://drive.google.com/drive/folders/1LnzUe-8A8cSI1OcUIQuVi_Vz63ZYpSc5?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@goldenpine6/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1837741, "client_id": 1491412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7150a6ae/uploads/origins/e9008890-7b16-40b0-af83-9d4f4dd348a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02829e835ee0f36b69bd1daa45b4a1b", "srcset": "https://si.imgix.net/7150a6ae/uploads/origins/e9008890-7b16-40b0-af83-9d4f4dd348a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e02829e835ee0f36b69bd1daa45b4a1b, https://si.imgix.net/7150a6ae/uploads/origins/e9008890-7b16-40b0-af83-9d4f4dd348a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2711f2700433096ff1d7b7c8ca1c988 2x, https://si.imgix.net/7150a6ae/uploads/origins/e9008890-7b16-40b0-af83-9d4f4dd348a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b30b5e169adab287541f346de675287 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7150a6ae/uploads/origins/e9008890-7b16-40b0-af83-9d4f4dd348a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dc16a1209afec1e1e537d4be91e914d", "srcset": "https://si.imgix.net/7150a6ae/uploads/origins/e9008890-7b16-40b0-af83-9d4f4dd348a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dc16a1209afec1e1e537d4be91e914d, https://si.imgix.net/7150a6ae/uploads/origins/e9008890-7b16-40b0-af83-9d4f4dd348a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w