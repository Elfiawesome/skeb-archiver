込まれるのを見るのが本当に楽しみなんです！\n\nこんにちは！リムバス・カンパニーのあなたの作品を見て、その画風にすっかり魅了されてしまいました！！！私のキャラクター「ルーセント」を描いたあなたの作品を見てみたいです。\n\n参考用のリンクはこちらです\nhttps://drive.google.com/drive/folders/1estR08wbm9BMWThW5GnjBKrVX8-PtDxI\n\nhttps://drive.google.com/drive/folders/1estR08wbm9BMWThW5GnjBKrVX8-PtDxI", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@myomyomyo114/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3505908, "client_id": 564268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a534c649/uploads/origins/5cc21d27-e579-49dc-a4e3-9cac20b1943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8bc50013c9eac6d29e12bc6f0215c15", "srcset": "https://si.imgix.net/a534c649/uploads/origins/5cc21d27-e579-49dc-a4e3-9cac20b1943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8bc50013c9eac6d29e12bc6f0215c15, https://si.imgix.net/a534c649/uploads/origins/5cc21d27-e579-49dc-a4e3-9cac20b1943c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e60efc860d94d2e6a47e160cd74409ef 2x, https://si.imgix.net/a534c649/uploads/origins/5cc21d27-e579-49dc-a4e3-9cac20b1943c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93db5282b6ab4eb8dd45f3902c535b74 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a534c649/uploads/origins/5cc21d27-e579-49dc-a4e3-9cac20b1943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=961ec3e0e837b1ca520e4c1c04847eb0", "srcset": "https://si.imgix.net/a534c649/uploads/origins/5cc21d27-e579-49dc-a4e3-9cac20b1943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=961ec3e0e837b1ca520e4c1c04847eb0, https://si.imgix.net/a534c649/uploads/origins/5cc21d27-e579-49dc-a4e3-9cac20b1943c?bg=%23fff&auto=format%2Ccompress