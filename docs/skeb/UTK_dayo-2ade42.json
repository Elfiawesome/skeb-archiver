on": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed6ad9bf/uploads/origins/9e694337-5061-4e2d-9cd3-18cd52311bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3554822096337417b3c6ced25e27740c", "srcset": "https://si.imgix.net/ed6ad9bf/uploads/origins/9e694337-5061-4e2d-9cd3-18cd52311bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3554822096337417b3c6ced25e27740c, https://si.imgix.net/ed6ad9bf/uploads/origins/9e694337-5061-4e2d-9cd3-18cd52311bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c7a81b8486a257716cbe0e9dea74698 2x, https://si.imgix.net/ed6ad9bf/uploads/origins/9e694337-5061-4e2d-9cd3-18cd52311bb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0af7c314051597e3435af3da7eb31b11 3x"}, "body": "はじめまして。\nゆてぃっけ様のイラストが魅力的なため、ご依頼させていただきます。\n\n【依頼内容】\nオリジナルキャラクターのメイドくんを描いていただきたいです。下記リンクに簡単な資料がありますので、ご確認いただけますと幸いです。\n・オリジナルキャラクターの容姿\n男子中学生。少し大人びて見える。\n黒髪。眉毛より短い前髪で、おでこがかなり見える。\n黒目。伏目がちで若干吊り目。\n頭にホワイトブリムをつけ、ロング丈のクラシカルメイドの服を着ている。（女装）\nスカートの裾から赤黒い触手が見えている。\n・ポーズ及び構図\nご依頼に際して、ゆてぃっけ様のイラストを拝見し、線の繊細さや、どこか物憂げにこちらを見据える表情に胸を掴まれました。ぜひ、ゆてぃっけ様の持ち味を生かした表情をしたメイドくんをお願いいたします。その他詳細なポーズ等はお任せいたしますが、ゆてぃっけ様が楽しく描けるような構図で描いていただけるのが1番嬉しいです。\n・その他\nメイドくんが着ているメイド服やホワイトブリムなどはあくまで1例であるため、ゆてぃっけ様のお好みでメイド服だとわかる範囲であればアレンジしていただいて差し支えありません。\nメイドくんのみの依頼ですが、下記リンクの同じフォルダにまとめている金髪のオリジナルキャラクターを加えて描いていただくことも差し支えありません。\n\n【使用用途】\n個人の鑑賞\n今後同キャラクターを依頼する際の参考資料として使用させていただく場合もございます。\n\n【参考資料】\n\nhttps://drive.google.com/drive/folders/1G7Pw_KPI2SikH-x_v6GxlajxZAihGY7X\n\nここまでお読みいただきありがとうございます。\n何卒ご検討のほどよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UTK_dayo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3205656, "client_id": 2805487, "vtt_url": null, "thumbnail_image_urls"