uploads/origins/056b64e4-0991-4eb8-b1b5-2429f3753c60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d4c3a1d50691ee3fc35358531dba3ea, https://si.imgix.net/cb72b13e/uploads/origins/056b64e4-0991-4eb8-b1b5-2429f3753c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b43bded34b848924927c641c2da3751 2x, https://si.imgix.net/cb72b13e/uploads/origins/056b64e4-0991-4eb8-b1b5-2429f3753c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c11f321c2ebfe1be0fffc927127cd606 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb72b13e/uploads/origins/056b64e4-0991-4eb8-b1b5-2429f3753c60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf72806c2f9d4a6f05564197e97a0ec5", "srcset": "https://si.imgix.net/cb72b13e/uploads/origins/056b64e4-0991-4eb8-b1b5-2429f3753c60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf72806c2f9d4a6f05564197e97a0ec5, https://si.imgix.net/cb72b13e/uploads/origins/056b64e4-0991-4eb8-b1b5-2429f3753c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7acad8e4c39c6fa933164d2dd2c98df5 2x, https://si.imgix.net/cb72b13e/uploads/origins/056b64e4-0991-4eb8-b1b5-2429f3753c60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16edf790346ca369a654123adc3fde35 3x"}, "body": "Dear Nekoemonn-san,\n\nI've been deeply captivated by your dark fantasy art. The raw emotion and unholy atmosphere you create with your brushwork are incredibly immersive, and it's not something commonly seen!\n\nI would like to request an artwork from you; if you were to take it, hope you would have fun drawing it!\n\nThe scene sets within a hideout known only to the black dragon. This black dragon slices open and comes out (or crawls out?) from from a cocoon-like structure made from flesh. The dragon is covered with viscous liquid from the cocoon, and he uses the cocoon to rest and heal.  The environment feels unholy and is crawled with unknown meaty things and wet, almost like inside of some creature. \n\nReference\nhttps://drive.google.com/drive/folders/1c0IheGIWbUiR-08oiXfG-jXPZvv3tS6j?usp=drive_link\n\nFeel free to draw him with or without wings.\n\nThanks!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoemonn/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 154820, "client_id": 79155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc6ce354/uploads/origins/412ef98d-1d5e-48d3-8f01-3bfda3ba3bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450858e9447f7001befb4445cf9fb3ae", "srcset": "https://si.imgix.net/dc6ce354/uploads/origins/412ef98d-1d5e-48d3-8f01-3bfda3ba3bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450858e9447f7001befb4445cf9fb3ae, https://si.imgix.net/dc6ce354/uploads/origins/412ef98d-1d5e-48d3-8f01-3bfda3ba3bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e81386345893bcd89d3a42845725f4b 2x, https://si.imgix.net/dc6ce354/uploads/origins/412ef98d-1d5e-48d3-8f01-3bfda3ba3bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d52feaab348bf69785ea51d282b42a6a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc6ce354/uploads/origins/412ef98d-1d5e-48d3-8f01-3bfda3ba3bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f73362b6672f141802a4c00a05d1aa5", "srcset": "https://si.imgix.net/dc6ce354/uploads/origins/412ef98d-1d5e-48d3-8f01-3bfda3ba3bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f73362b6672f141802a4c00a05d1aa5, https://si.imgix.net/dc6ce354/up