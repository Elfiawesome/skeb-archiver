s/origins/703775f7-fbff-438c-a6a2-25c22afa7ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d414ece287695adfbca1900b9f604555, https://si.imgix.net/9fb16041/uploads/origins/703775f7-fbff-438c-a6a2-25c22afa7ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e0da57f11b2da6c439203b828591e28 2x, https://si.imgix.net/9fb16041/uploads/origins/703775f7-fbff-438c-a6a2-25c22afa7ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5239741548b5e2cb1a53deece2f9671 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fb16041/uploads/origins/703775f7-fbff-438c-a6a2-25c22afa7ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aed66a45f94a02b3b6733aaf1c03946d", "srcset": "https://si.imgix.net/9fb16041/uploads/origins/703775f7-fbff-438c-a6a2-25c22afa7ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aed66a45f94a02b3b6733aaf1c03946d, https://si.imgix.net/9fb16041/uploads/origins/703775f7-fbff-438c-a6a2-25c22afa7ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9523d7b5975cefe37c1012743519a51c 2x, https://si.imgix.net/9fb16041/uploads/origins/703775f7-fbff-438c-a6a2-25c22afa7ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8ab8bdf91a8439ec8cef503a45faf77 3x"}, "body": "シルバーリーフ（モクビャッコウ等）をモチーフに取り込んだ白色めの要素を含んだ植物の女の子が後ろから女の子に抱きついて取り込んでいる奴をお願いします。\n取り込まれている部分は分泌される粘液によって融解し、融解部からは注入された部分の植物化を進行させる液が注入され、この現象には性的な快感が発生しているものとし、その際に融解部からは液が漏れ出ている描写が欲しいです。\n液の注入は注入を行う器官があるというよりは融解し柔らかくなった身体に自身の体を入れて皮膚（或いはそれに相当する物、部位）からじわじわと分泌されているのでドバっと出てるよりはとろとろ出てる感じで\n\n植物度合いはお任せします。あんまり無くてもガチガチでもおっけーです。服に植物が付いてる程度のモノから植物の頂上部に女の子が付いてる奴まで女の子と分かればお好みの配分でお願いします。\n\n抱きつきに関しては字面通り両腕でぎゅーっとしてるのもよいですが、太ももをさすっていたり頭を撫でていたりほっぺをさすってたり片腕で女の子をぎゅっとしていれば想像の広がる限りお好きにお願いします。\n\n\nところでくっついた後の女の子達はどうなるんでしょうか……ぺりぺり剥がすと別個体になったりほっとくとまたくっついたりするんでしょうかね。無節操にくっつき続けて巨大化したり自壊しても良い……妄想が止まらない……同化シチュは良い……自分も溶かされて同化しｔ", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@verochi5/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 451446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc7860d7fcf79a0f369686ba03214eac", "srcset": "https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc7860d7fcf79a0f369686ba03214eac, https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d206b86c6b3eba414b4fb74546ab8f9 2x, https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=529b662d04db2e59462d9f86132dd67f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1437e7422be004931badfaded28cd363", "srcset": "https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1437e7422be004931badfaded28cd363, https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b824133cd92b66e4a85ea261a79e189 2x, https://si.imgix.net/cc308567/uploads/origins/20e9b4af-e137-40f2-8198-4c27ecebcbe8?bg=%23fff&auto=format%2Ccompress&fm=webp&