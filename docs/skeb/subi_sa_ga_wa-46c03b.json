子供たちです。\n\n茶髪の少年シェイは物静かで、普段は無表情か、小さく謎めいた笑みを浮かべている。アロイスをとてもかわいがっている。\n金髪の少年アロイスは大胆でおしゃべり。彼の表情はいつも満面の笑みだ。\n\n以下のようなシーンが考えられます（描きたくなければ描かなくてもかまいません）：\n- ロウソク、ナイフ、血を使った怖いカルトの儀式をしている。\n- お化けが出る教会を探検している\n- 怖いモンスターから隠れている\n\n使用目的SNS、OC活動、印刷など個人的な閲覧のみ\n\nいずれにせよ、お読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@subi_sa_ga_wa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2936064, "client_id": 125676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4cdbf94/uploads/origins/b9cbce6d-1bfb-4101-93eb-1535df502e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3747d85462ff141bd657b1931795e48", "srcset": "https://si.imgix.net/c4cdbf94/uploads/origins/b9cbce6d-1bfb-4101-93eb-1535df502e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3747d85462ff141bd657b1931795e48, https://si.imgix.net/c4cdbf94/uploads/origins/b9cbce6d-1bfb-4101-93eb-1535df502e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3a56ebc788a9ba19fd2d2dbde2c706e 2x, https://si.imgix.net/c4cdbf94/uploads/origins/b9cbce6d-1bfb-4101-93eb-1535df502e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1936f29dfbb1c53930d8f1beeaf246b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4cdbf94/uploads/origins/b9cbce6d-1bfb-4101-93eb-1535df502e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e93113526250d28e34998ed84b8fc77e", "srcset": "https://si.imgix.net/c4cdbf94/uploads/origins/b9cbce6d-1bfb-4101-93eb-1535df502e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e93113526250d28e34998ed84b8fc77e, https://si.imgix.net/c4cdbf94