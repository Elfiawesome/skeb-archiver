8225?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66830f5f7b805461f1847751b7ca3222 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/445ffc47/uploads/origins/8916a52b-3264-4862-bf49-d9f369068225?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81780e64a50ed64ab7b7eb642c2d3176", "srcset": "https://si.imgix.net/445ffc47/uploads/origins/8916a52b-3264-4862-bf49-d9f369068225?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81780e64a50ed64ab7b7eb642c2d3176, https://si.imgix.net/445ffc47/uploads/origins/8916a52b-3264-4862-bf49-d9f369068225?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2a8376f1c6b1ae0c4519064bf4ab9f7 2x, https://si.imgix.net/445ffc47/uploads/origins/8916a52b-3264-4862-bf49-d9f369068225?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58c9fc1be1ee943af9b1d5fd20dbb8b6 3x"}, "body": "はじめまして。\n司ノ先生の美しいイラストを拝見し、一目惚れしました。\nぜひオリキャラを描いていただきたく、リクエストいたします。\n\n■キャラクター\nリュオス・マーロ・デルマーレ（Ryos Maro DelMare）\n年齢：25歳（人間）\n性別：男性\n身長：179cm／細身で引き締まった体格\n髪色：長めの前髪で右目を隠すような片目隠れスタイル。\n瞳：琥珀色の中に、深海のような青が滲んでいる。\n◆性格と雰囲気\n寡黙で理性的。感情はほとんど表に出さず、淡々と忠義を尽くす執事。\nただ、その沈黙の奥には深く静かな情熱と禁忌的な想いが秘められており、“触れてはならない主への祈り”を胸に、ひとり苦悩と陶酔の狭間を生きている。普段は微笑まず、口角さえほとんど動かさないが、主（現代から召喚された年上の青年）を見ている時だけ、僅かな熱を瞳に宿す。\n\n■希望のイラスト\n構図：おまかせ。(立ち絵だと嬉しいです。)\n服装：資料を参照いただければ幸いです。\n※燕尾服は人魚イメージで、下のフリルは透けています。\n\n\n■使用用途\n鑑賞\n\n■サイズ\nおまかせ\n\nお忙しいところ恐縮ですがよろしくお願いいたします。\n\n■参照資料\nhttps://drive.google.com/drive/folders/1zkmukU0NhzXd-k69zo0ytJ1Pcc_9h9hl\n\nhttps://drive.google.com/drive/folders/1zkmukU0NhzXd-k69zo0ytJ1Pcc_9h9hl", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haraherishino/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3493199, "client_id": 1765754, "