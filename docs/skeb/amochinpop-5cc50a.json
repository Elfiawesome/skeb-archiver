4bf4c2f2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a42f17e9aff5cf5293ab192bf847d2, https://si.imgix.net/faf3ce13/uploads/origins/6e3b6469-832f-4b5f-ab46-664bf4c2f2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8df3a12da27d61c699bbe78e4eeec078 2x, https://si.imgix.net/faf3ce13/uploads/origins/6e3b6469-832f-4b5f-ab46-664bf4c2f2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b08a57b84e29e2939a0f5bee52520367 3x"}, "body": "あもちん様、こんにちは！\n\n今年の夏コミの『八宮めぐる写真集』が名作！グラビア写真集に忠実でありながら、めぐるの美しさを表現している。\n\n僕のお願いしたい依頼は『俺の妹がこんなに可愛いわけがない』から｢高坂桐乃｣の全身グラビアイラストを描いて頂けないでしょうか。\n\n『俺妹』15周年記念ということで、水着グラビアの桐乃イラストはお祝いにぴったりですね。\n\n僕の希望(取り入れてくださると嬉しいです！)\n〇雰囲気：2010年代前半ばグラビアと同じで写真集のイメージになった桐乃ちゃん\n〇衣装：黄色紐ビキニ。\nhttps://i.imgur.com/INHmVJF.jpg\n紫の紐は黄色の生地によく似合うでしょ？\n桐乃ちゃんの軟乳がビキニの横から少しはみ出ているようにするには、ビキニ生地を小さくする必要があります。また、胸の間に小さなリボンがあってもいいと思う。でも、ビキニには必要だと思うディテールを加えてください。\n〇口角をちょっとだけあげる控え目な笑顔がいい。https://i.imgur.com/dIsN9sh.jpg\n〇左腕の青いスクランチをお忘れなく！ https://i.imgur.com/Pef8iJz.mp4\n〇桐乃ちゃんの紫マニキュアが見えるようにしてほしい。\n〇セッティングとポーズはお任せします。僕は以下のようなもの、もしくはあもちん様が良いと思うものであれば満足だ：\n- ビーチに立ってグラビア撮影のポーズをとる桐乃ちゃん\n- ベッドの上で仰向けになるグラビア撮影のポーズ桐乃ちゃん\n- この名作のように風呂の中のグラビア撮影ポーズ桐乃ちゃん　https://pbs.twimg.com/media/F2ql1aEaoAAD7lO?format=jpg&name=large\n\n眩しいで魅了する桐乃ちゃんがキュートな水着姿を見るのが楽しみです！\n\nリクエストを読んでくれてありがとう。\n\nhttps://imgur.com/a/7iDHx9W", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amochinpop/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1095539, "client_id": 1376802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c11d5259/uploads/origins/87e312de-5f75-4c30-9226-324157349cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=802f609b196b1f9146df87291d3f440d", "srcset": "https://si.imgix.net/c11d5259/uploads/origins/87e312de-5f75-4c30-9226-3