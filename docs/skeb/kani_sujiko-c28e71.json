alse, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44de48ff/uploads/origins/d015c2ff-c3d1-4175-bfb7-7f9796b8e9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b50472d789c954d56f9fd744c42df7b8", "srcset": "https://si.imgix.net/44de48ff/uploads/origins/d015c2ff-c3d1-4175-bfb7-7f9796b8e9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b50472d789c954d56f9fd744c42df7b8, https://si.imgix.net/44de48ff/uploads/origins/d015c2ff-c3d1-4175-bfb7-7f9796b8e9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f99d1e7cef2996fd8690502ac506eb3 2x, https://si.imgix.net/44de48ff/uploads/origins/d015c2ff-c3d1-4175-bfb7-7f9796b8e9c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f96b00e56cf8ad8dd8ff23753b4e0a3 3x"}, "body": "高田にゃち 様へ\n\nSkebでイラストを拝見して、アニメのワンシーンのようなイラストたちに心惹かれました。季節を感じられるほわほわしたイラストが大好きです。\n\n費用や内容が見合わなければキャンセルいただいて構いませんので、よければご検討いただければ幸いです！\n\n―――――――――\n\n【リクエスト内容】\n・添付画像のキャラクターイラスト\n・スマートフォン用オリジナルカレンダーのイラストで使用させて頂きたいので、描いている時の季節感に合ったものでよろしくお願いします！\n・表情、構図など全てお任せいたします\n・衣装等もお好きなように描いて頂けると嬉しいです(その時の季節感やイベントに合ったものでお願いしたいです！)\n・相棒の猫がいるので、何処かに猫要素を入れて頂きたいです\n\n・サイズの指定はありませんが、縦イラストだとカレンダーにしやすいので嬉しいです\n・サムネイル等でも使用しやすいように、人物のみの画像、頭や髪先が画面内に入っていると嬉しいです\n・もし可能であれば、表情差分があると嬉しいです\n\n【使用用途】\n・スマートフォン用オリジナルカレンダーのイラスト\n・グッズでの利用(商用利用)\n・SNSでの掲載\n（アイコンやヘッダー等に使用させて頂きたいです）\n・動画のサムネイルでの使用　など\n\n最後まで読んでいただき、ありがとうございます。ご検討よろしくお願い致します！\n\n資料\nhttps://drive.google.com/drive/folders/108eosf2FjGpCUGMd_nFvXx6mKipEjvUF?usp=drive_link\n\nhttps://drive.google.com/drive/folders/108eosf2FjGpCUGMd_nFvXx6mKipEjvUF?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1791479, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "立　雪譚（絵垢）", "screen_name": "tatenosettan", "avatar_url": "https://pbs.twimg.com/profile_image