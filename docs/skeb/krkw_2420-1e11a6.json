\n\n依頼内容:上記の作品の13ページ目からのIFルートで、ノアから逃げ出した淫魔(リルカ憑依状態)が道中で魔王に遭遇し、淫魔が勇者の幼馴染を確保しているという状況に利を見出し、淫魔をリルカに受肉させるため、淫魔と魔王がセッ◯スして、魔王の力で最終的に淫魔とリルカが融合して悪堕ちした姿をデザインして頂きたいです。\n\n・悪堕ち後のデザインは、元の憑依状態のデザインから変化していれば大丈夫で、衣装や体型、髪型等はきれかわ先生にお任せします。\n\nご一考お願いします。\n\nhttps://drive.google.com/drive/folders/1z0mxyq3JhWbaJCMD-IViqecoL03bPwCn", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@krkw_2420/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 767090, "client_id": 80865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba1d055d/uploads/origins/44ac6faf-157f-4f82-a662-9a0f11ec2a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9d184dc6c3c696be114ff69d5fa62e0", "srcset": "https://si.imgix.net/ba1d055d/uploads/origins/44ac6faf-157f-4f82-a662-9a0f11ec2a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9d184dc6c3c696be114ff69d5fa62e0, https://si.imgix.net/ba1d055d/uploads/origins/44ac6faf-157f-4f82-a662-9a0f11ec2a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58acce3039d2d8c211f6023fb143a93d 2x, https://si.imgix.net/ba1d055d/uploads/origins/44ac6faf-157f-4f82-a662-9a0f11ec2a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72e180b5e4a29fcbd6513111f177d14f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba1d055d/uploads/origins/44ac6faf-157f-4f82-a662-9a0f11ec2a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15ded29ff1d4e1d06941845f25c361f9", "srcset": "https://si.imgix.net/ba1d055d/uploads/origins/44ac6faf-157f-4f82-a662-9a0f11ec2a0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15ded29ff1d4e1d06941845f25c361f9, https://si.imgix.net/ba1d055d/uploads/origins/44ac6faf-157f-4f82-a662-9a0f11ec2a0d?bg