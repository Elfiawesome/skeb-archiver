た。そのため、彼女には悪い噂が絶えない。\nとても上品で狡猾。彼女は悪い噂に影響されず、それを面白いと思っている。本や手紙を書くこと、ゴシップ、ロマンスが大好き。\nテーマ：花、美、死、メメント・モリ\n衣装：デフォルトの衣装があるが、自由にデザインしてほしい！\n\nhttps://drive.google.com/drive/folders/1v4r3qNWnzy5DBiOlcaup4P8R73cT52_d?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ar_l_333/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2994874, "client_id": 53759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84178f8b/uploads/origins/a43801f8-ea9c-4a9a-81ea-050f73c8b3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d48477f3045b16f18519a8ec48d62df", "srcset": "https://si.imgix.net/84178f8b/uploads/origins/a43801f8-ea9c-4a9a-81ea-050f73c8b3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d48477f3045b16f18519a8ec48d62df, https://si.imgix.net/84178f8b/uploads/origins/a43801f8-ea9c-4a9a-81ea-050f73c8b3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9692c73595e909af9c5a5ed0be62918 2x, https://si.imgix.net/84178f8b/uploads/origins/a43801f8-ea9c-4a9a-81ea-050f73c8b3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c2f322f9660daa5dff3200c2aad6159 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84178f8b/uploads/origins/a43801f8-ea9c-4a9a-81ea-050f73c8b3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5644be4c58b1d4222ce6ebf063e73858", "srcset": "https://si.imgix.net/84178f8b/uploads/origins/a43801f8-ea9c-4a9a-81ea-050f73c8b3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5644be4c58b1d4222ce6ebf063e73858, https://si.imgix.net/84178f8b/uploads/origins/a43801f8-ea9c-4a9a-81ea-050f73c8b3fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f91d3e17