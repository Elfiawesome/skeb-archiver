24207948018047?s=20\n\nこのライトで同じようなものが欲しいです。\n\n彼女についてのメモです：\n彼女は小さい頃から宇宙が大好きだった。宇宙に関する本を読みながら、星に到達することを夢見て家の中に閉じこもる日々を送っていた。残された日々は限られており、話し相手も少なく、親友は歩くよりも遠くまで飛ぶことができる鳥だけである。\n\n16:9でお願いします。デビュー動画か、私のツイッターのアートとして、クレジット付きのスケジュールで使いたいです。\n\nhttps://drive.google.com/drive/folders/1XFLy18hWjt_u0ibsTLaKYL7o6nrPcKCO?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ar_l_333/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2994874, "client_id": 1837563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e2aebbf/uploads/origins/032fc42d-f3cb-483e-aee4-63b009603a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a78ad1d3a1817cd82e6c8beaed45605", "srcset": "https://si.imgix.net/4e2aebbf/uploads/origins/032fc42d-f3cb-483e-aee4-63b009603a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a78ad1d3a1817cd82e6c8beaed45605, https://si.imgix.net/4e2aebbf/uploads/origins/032fc42d-f3cb-483e-aee4-63b009603a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b16fe2e7988bafe6060a32436db302b 2x, https://si.imgix.net/4e2aebbf/uploads/origins/032fc42d-f3cb-483e-aee4-63b009603a40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67f427febb755d3eca673b9c2945f51e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e2aebbf/uploads/origins/032fc42d-f3cb-483e-aee4-63b009603a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16476e3d635bad8e0adb099dba132883", "srcset": "https://si.imgix.net/4e2aebbf/uploads/origins/032fc42d-f3cb-483e-aee4-63b009603a40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16476e3d635bad8e0adb099dba132883, https://si.imgix.net/4e2aebbf/uploads/origins/032fc42d-f3cb-483e-aee4-6