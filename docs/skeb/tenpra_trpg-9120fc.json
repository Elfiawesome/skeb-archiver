497fec-6b5d-4225-aee1-3348fab0e3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e953a8cf54af172bd1f1703e4054cf8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d05848f0/uploads/origins/7e497fec-6b5d-4225-aee1-3348fab0e3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c92e28190185f8684113bce47f18b730", "srcset": "https://si.imgix.net/d05848f0/uploads/origins/7e497fec-6b5d-4225-aee1-3348fab0e3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c92e28190185f8684113bce47f18b730, https://si.imgix.net/d05848f0/uploads/origins/7e497fec-6b5d-4225-aee1-3348fab0e3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b4330a80f6b662e1778772b286f32f6 2x, https://si.imgix.net/d05848f0/uploads/origins/7e497fec-6b5d-4225-aee1-3348fab0e3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=635483be268a7d1ae9fc5744b713378a 3x"}, "body": "アーティストさん、またお会いできて嬉しいです！以前の作品、本当にありがとうございました。友人がとても気に入ってくれました！作品から溢れ出る可愛らしさには驚かされました。また私のキャラクターを描いていただけないでしょうか？ホラーシナリオに登場する女性と男性のキャラクターです。\n\n女性キャラクターは、自分が嫌っている退屈な仕事である研究施設で働いています。彼女は劣等感に苛まれており、頻繁に自分自身を疑っています。 そのため、仕事でもプライベートでもとても内気な印象を与えています。彼女は、精神的に弱い人間を餌食にする施設内のモンスターにとって、まさに格好の獲物です。そのモンスターは、人間が最も美しく、安心できると感じる顔に姿を変えます。往々にして、それは昔忘れ去られた友人や家族です。二人の関係は、執着心が強い、あるいはヤンデレ的な要素があると言えるでしょう。\n\nアーティストさんには、ご自身の判断でデザインを自由に変更していただいて構いません。モンスターの人間形態だけでもOKです！二人を一緒に描いても、別々に描いても構いません。ご検討いただきありがとうございます。応募お待ちしています！\n\nhttps://drive.google.com/drive/folders/1BeJd70gt9atzJAUx1DwDpro5svEoEr20?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tenpra_trpg/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3978233, "client_id": 3877516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.n