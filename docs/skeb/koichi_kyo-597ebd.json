30af\u9aea\u306e\u5b50 HO2 - \u4fe1\u8005\n\u67ca\u679c\u6843\u793c20\u6b73/\u5973/147cm\n\u62dd\u638c\u6559\u306e\u4fe1\u8005\u3002\u898b\u305f\u76ee\u306f\u5e7c\u3044\u304c\u6210\u4eba\u6e08\u3002\u3061\u307e\u3061\u307e\u307b\u308f\u307b\u308f\u3068\u3057\u3066\u3044\u308b\u3002\u8da3\u5473\u306f\u88c1\u7e2b\u3067\u30d5\u30ea\u30eb\u3084\u30ea\u30dc\u30f3\u3092\u3064\u3051\u3066\u53ef\u611b\u304f\u30a2\u30ec\u30f3\u30b8\u3057\u305f\u6559\u56e3\u670d\u3092\u7740\u3066\u3044\u308b\u3002\n\n\u25cf\u8cc7\u6599(\u30cd\u30bf\u30d0\u30ec\u7121)\n\u203b\u521d\u56de\u30ea\u30af\u30a8\u30b9\u30c8\u6642\u304b\u3089\u6570\u679a\u5897\u3048\u3066\u3044\u307e\u3059\nhttps://drive.google.com/drive/folders/1GlGfDWNi8_8Ap4KaekADSppBO3m6yWhh\n\n\u25cf\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\n\u4e8c\u4eba\u304c\u4ef2\u826f\u304f\u7f8e\u5473\u3057\u3044\u30b9\u30a4\u30fc\u30c4\u3092\u98df\u3079\u3066\u3044\u308b\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\uff01\u7b49\u8eab\u7d75\u3067\u3082SD\u7d75\u3067\u3082\u69cb\u3044\u307e\u305b\u3093\u3002\n\u96e3\u3057\u3051\u308c\u3070\u4e0a\u8a18\u306f\u7121\u8996\u3057\u3066\u81ea\u7531\u306b\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\uff01\n\n\u25cf\u95a2\u4fc2\u6027\n\u30fb\u4e8c\u4eba\u306f\u5b64\u5150\u9662\u80b2\u3061\u306e\u5e7c\u99b4\u67d3\u3067\u4e92\u3044\u306e\u3053\u3068\u3092\u5bb6\u65cf\u306e\u3088\u3046\u306b\u5927\u5207\u306b\u601d\u3044\u5408\u3063\u3066\u304a\u308a\u3001\u3044\u3064\u3082\u4e00\u7dd2\u306b\u884c\u52d5\u3057\u3066\u3044\u3066\u8ddd\u96e2\u611f\u3082\u8fd1\u3044\u3067\u3059\n\u30fbHO1\u306fHO2\u306e\u3053\u3068\u3092\u59b9\u306e\u3088\u3046\u306b\u53ef\u611b\u304c\u3063\u3066\u3044\u307e\u3059\n\u30fb\u4e8c\u4eba\u306f\u3068\u3066\u3082\u4ef2\u304c\u826f\u304f\u6bce\u671dHO1\u304cHO2\u306e\u982c\u3092\u30e2\u30c1\u30e2\u30c1\u3057\u305f\u308a\u3001\u3054\u98ef\u3092\u30b7\u30a7\u30a2(\u98df\u3079\u3055\u305b\u3042\u3044\u3063\u3053)\u3057\u3066\u98df\u3079\u305f\u308a\u3057\u3066\u307e\u3059\n\n\u25cf\u670d\u88c5\u306b\u3064\u3044\u3066\n\u8cc7\u6599\u306e\u901a\u308a\u3067\u3082\u3001\u30aa\u30ea\u30b8\u30ca\u30eb\u3067\u81ea\u7531\u306b\u63cf\u3044\u3066\u9802\u3044\u3066\u3082\u69cb\u3044\u307e\u305b\u3093\uff01(\u30d8\u30a2\u30a2\u30ec\u30f3\u30b8\u3082\u53ef)\n\u8cc7\u6599\u901a\u308a\u306e\u5834\u5408\u30013\u7a2e\u985e\u307b\u3069\u8863\u88c5\u304c\u3042\u308b\u306e\u3067\u3059\u304c\u304a\u597d\u304d\u306a\u3082\u306e\u3067\u63cf\u3044\u3066\u9802\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\uff01\n\n\u25cf\u7528\u9014\nSNS\u3067\u306e\u30d8\u30c3\u30c0\u30fc\u3084\u30a2\u30a4\u30b3\u30f3\u3078\u306e\u4f7f\u7528\u3002(\u53cb\u4eba\u306b\u3082\u540c\u69d8\u306e\u6a29\u5229\u3092\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059)\n\u307e\u305f\u73fe\u6642\u70b9\u3067\u306f\u672a\u5b9a\u3067\u3059\u304c\u3001\u500b\u4eba\u5229\u7528\u306e\u7bc4\u56f2\u3067\u30b0\u30c3\u30ba\u4f5c\u6210\u306b\u4f7f\u7528\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002(\u305d\u306e\u5834\u5408\u3001\u53cb\u4eba\u5206\u3082\u4f5c\u6210\u3057\u307e\u3059\u304c\u91d1\u92ad\u306e\u3084\u308a\u53d6\u308a\u306f\u767a\u751f\u3057\u307e\u305b\u3093)\n\u4e0d\u53ef\u306e\u5834\u5408\u306f\u5fa1\u624b\u6570\u3067\u3059\u304c\u5225\u30ec\u30a4\u30e4\u30fc\u306b\u8a18\u8f09\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\n\u91d1\u984d\u304c\u7406\u7531\u3067\u627f\u8a8d\u304c\u96e3\u3057\u3044\u5834\u5408\u306f\u518d\u9001\u8981\u8acb\u3092\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u3054\u7e01\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\u3002", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@koichi_kyo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4300, "client_id": 861680, "vtt_url": null, "thumbnail_image_urls": {"src":