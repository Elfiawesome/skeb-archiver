8868\u60c5\n\u72ac\u6b6f\u304c\u898b\u3048\u308b\u611f\u3058\u3067\u30cb\u30e4\u30c3\u3068\u60aa\u3044\u611f\u3058\u306e\u8868\u60c5\u3092\u3055\u305b\u3066\u307b\u3057\u3044\u3067\u3059\n(\u3082\u3057\u53ef\u80fd\u3067\u3057\u305f\u3089\u2026\u300c\u30b0\u30a8\u30fc\uff57\u300d\u306e\u3088\u3046\u306a\u30d9\u30ed\u51fa\u3057\u5dee\u5206\u3092\u3044\u305f\u3060\u3051\u306a\u3044\u3067\u3057\u3087\u3046\u304b\u2026\n\u539a\u304b\u307e\u3057\u304f\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u2026)\n\n\u670d\u88c5\n\u300cbutterfly\u300d\u306e\u3088\u3046\u306a\u30ef\u30f3\u30d4\u30fc\u30b9\u30b9\u30ab\u30fc\u30c8\u7cfb\u2026\uff1f\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u7d30\u304b\u3044\u30c7\u30b6\u30a4\u30f3\u306f\u5148\u751f\u306e\u30bb\u30f3\u30b9\u306b\u304a\u4efb\u305b\u3068\u3055\u305b\u3066\u3044\u305f\u3060\u3051\u306a\u3044\u3067\u3057\u3087\u3046\u304b\uff1f\n(\u3042\u307e\u308a\u826f\u3044\u30c7\u30b6\u30a4\u30f3\u3092\u601d\u3044\u3064\u3051\u306a\u3044\u305f\u3081\u2026)\n\u53ef\u80fd\u3067\u3057\u305f\u3089\u900f\u3051\u8981\u7d20\u3092\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u2026\n\n\u4e0a\u8a18\u306e\u30ad\u30e3\u30e9\u7279\u5fb4\u306b\u8a18\u8f09\u3057\u3066\u3044\u306a\u3044\u30a2\u30af\u30bb\u7b49\n\u3053\u3061\u3089\u3082\u3082\u3057\u53ef\u80fd\u3067\u3057\u305f\u3089\u30a2\u30e1\u30b8\u30b9\u30c8\u306e\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u3092\u63cf\u3044\u3066\u307b\u3057\u304f\u2026\n\u4e3b\u5f35\u3057\u3059\u304e\u306a\u3044\u5927\u304d\u3055\u306e\u4e09\u89d2\u7cfb\u3001\u6b63\u65b9\u5f62\u7cfb\u3001\u9577\u65b9\u5f62\u7cfb\u3001\u3069\u308c\u304b\u306e\u30ab\u30c3\u30c8\u3092\u3057\u305f\u5b9d\u77f3\u304c\u3064\u3044\u3066\u3044\u308b\n\u30d6\u30ed\u30fc\u30c1\u307e\u305f\u306f\u6307\u8f2a\u3092\u63cf\u3044\u3066\u307b\u3057\u3044\u3067\u3059\u3002\u63cf\u304d\u3084\u3059\u3044\u3082\u306e\u3067\u5927\u4e08\u592b\u3067\u3059\u3002\n\u203b\u5b9d\u77f3\u306e\u53cd\u5c04\u7b49\u3001\u4f5c\u753b\u30b3\u3