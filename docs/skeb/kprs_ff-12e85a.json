ached URL.\nCharacteristic:\nwhite skin: 攻め, taciturn, black mage\nblack skin: 受け, frank and talkative, white mage\nThe element I want to add is kiss, ユリ and 赤い曼珠沙華\nThat’s everything and thank you for your kind support!\n\nhttps://drive.google.com/drive/folders/1Bm7FPxzBrLDLAV-nTeQOTHkVP7MoEMkr?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kprs_ff/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3393286, "client_id": 1042883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9975a5bb/uploads/origins/f42a04c9-bb03-4a85-90dd-4bbbcc197442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c2608563dad3ea833373e62f845b35", "srcset": "https://si.imgix.net/9975a5bb/uploads/origins/f42a04c9-bb03-4a85-90dd-4bbbcc197442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54c2608563dad3ea833373e62f845b35, https://si.imgix.net/9975a5bb/uploads/origins/f42a04c9-bb03-4a85-90dd-4bbbcc197442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62c33c4eff4be74fd573d73653f7df31 2x, https://si.imgix.net/9975a5bb/uploads/origins/f42a04c9-bb03-4a85-90dd-4bbbcc197442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5795372d46ee79643590a9e4693633 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9975a5bb/uploads/origins/f42a04c9-bb03-4a85-90dd-4bbbcc197442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2146895ad7d335c08dc9039ff1ec9126", "srcset": "https://si.imgix.net/9975a5bb/uploads/origins/f42a04c9-bb03-4a85-90dd-4bbbcc197442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2146895ad7d335c08dc9039ff1ec9126, https://si.imgix.net/9975a5bb/uploads/origins/f42a04c9-bb03-4a85-90dd-4bbbcc197442?bg=