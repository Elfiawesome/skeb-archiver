u!\n\nI would really like a summer picture of Haru at the beach in a bikini enjoying the sunshine with a excited or happy expression. \n\nHere is Haru's reference and their favorite color is purple! :https://drive.google.com/drive/folders/1bP44bHgGN7-vrvMSui1jyStJDaO1LWmu?usp=drive_link\n\nIf this project is not to your liking please feel free to reject it. Thank you very much.", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hachibun/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1295120, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6eaf1066/uploads/origins/96a2008b-151d-419f-a195-b8892811fa50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5858c020c424a28b0aa518aa0d7893d0", "srcset": "https://si.imgix.net/6eaf1066/uploads/origins/96a2008b-151d-419f-a195-b8892811fa50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5858c020c424a28b0aa518aa0d7893d0, https://si.imgix.net/6eaf1066/uploads/origins/96a2008b-151d-419f-a195-b8892811fa50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0af2d512a9d616961d6af0b30cb4a101 2x, https://si.imgix.net/6eaf1066/uploads/origins/96a2008b-151d-419f-a195-b8892811fa50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3509d0f79f99ddc864552e4682ed2545 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6eaf1066/uploads/origins/96a2008b-151d-419f-a195-b8892811fa50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd7bcf4aa27977ffc6879a44d3013b41", "srcset": "https://si.imgix.net/6eaf1066/uploads/origins/96a2008b-151d-419f-a195-b8892811fa50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd7bcf4aa27977ffc6879a44d3013b41, https://si.imgix