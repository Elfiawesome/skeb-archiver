メージがなければ、鳥(文鳥など)と戯れている姿とかどうでしょうか\n※ぷちむーさんが描きたいと思うものを一番見たいので、その場合は無視してください。また動物の追加で料金等が変わってくるようでしたら、仰ってください。\n\n※サムネイルに用いたいと考えているので、 簡易背景などがある場合はキャラのみのデータもいただけると幸いです。\n\nそれでは、お忙しい中恐れ入りますが、何卒よろしくお願いいたします。\n\nhttps://twitter.com/toy987654321/status/1523090305116884992", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@puchi_mu__/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 606615, "client_id": 164829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/073da886/uploads/origins/00b0ff9d-65e5-450f-8c29-0add6bb1c460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c138d0c3b216e1ad075b01b6a6aaf61e", "srcset": "https://si.imgix.net/073da886/uploads/origins/00b0ff9d-65e5-450f-8c29-0add6bb1c460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c138d0c3b216e1ad075b01b6a6aaf61e, https://si.imgix.net/073da886/uploads/origins/00b0ff9d-65e5-450f-8c29-0add6bb1c460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e67770db8828f719a9f3abd6ccb2e3f7 2x, https://si.imgix.net/073da886/uploads/origins/00b0ff9d-65e5-450f-8c29-0add6bb1c460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=070cee33a71ff580707b69d5ef196daf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/073da886/uploads/origins/00b0ff9d-65e5-450f-8c29-0add6bb1c460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0820f94baff368d387f1b835b3447830", "srcset": "https://si.imgix.net/073da886/uploads/origins/00b0ff9d-65e5-450f-8c29-0add6bb1c460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0820f94baff368d387f1b835b3447830, https://si.imgix.net/073da886/uploads/origins/00b0ff9d-65e5-450f-8c29-0add6bb1c460?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi