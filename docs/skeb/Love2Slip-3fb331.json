くて恐縮ですがテレキャスター系でお願いします\n背景もつけていただけると嬉しいです\n\n◎その他\nアクセサリー（カチューシャ、髪飾り、チョーカー）や顔の星型ペイントは「有」でお願いします\nまた、背景部分はレイヤー分けでon/off可能な状態にしていただけると嬉しいです\n\n◎補足\nイラストの使用目的は個人観賞用および私のSNS上でも公開する予定です\nまた、沙汰ナキアさんが活動の中で使用する可能性がありますので、その点を了承いただけますと幸いです\n納品につきましては背景ON/OFFできるようPSD形式でいただければと思います\n\n金額的に不足がありましたら再送いただけると助かります\n\nhttps://drive.google.com/drive/folders/1ClHsJHvwZ4jomvIkKrE2EGrrkEw4QwW3", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Love2Slip/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3194792, "client_id": 3642826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/102a1963/uploads/origins/78f3d4a4-7c54-4974-849e-7f70b440a464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47bb8a6aee2f5b9b1096c1c779fc0648", "srcset": "https://si.imgix.net/102a1963/uploads/origins/78f3d4a4-7c54-4974-849e-7f70b440a464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47bb8a6aee2f5b9b1096c1c779fc0648, https://si.imgix.net/102a1963/uploads/origins/78f3d4a4-7c54-4974-849e-7f70b440a464?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1145b10a55a42cfecec2bbde41992f85 2x, https://si.imgix.net/102a1963/uploads/origins/78f3d4a4-7c54-4974-849e-7f70b440a464?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08e530a6b75a61b8c7ddc5adab007cb4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/102a1963/uploads/origins/78f3d4a4-7c54-4974-849e-7f70b440a464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8915e93688f5473bafd39d7e0fad30d", "srcset": "https://si.imgix.net/102a1963/uploads/origins/78f3d4a4-7c54-4974-849e-7f70b440a464?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8915e93688f5473bafd39d7e0fad30d, https://si.imgix.