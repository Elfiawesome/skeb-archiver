consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64da51c0/uploads/origins/c2f52b01-d02e-47af-99c8-37b118575717?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebbbdd7ce9568f9385eecbbebc3f189a", "srcset": "https://si.imgix.net/64da51c0/uploads/origins/c2f52b01-d02e-47af-99c8-37b118575717?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebbbdd7ce9568f9385eecbbebc3f189a, https://si.imgix.net/64da51c0/uploads/origins/c2f52b01-d02e-47af-99c8-37b118575717?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4c27e570d408d2ccead545b01c87bc6 2x, https://si.imgix.net/64da51c0/uploads/origins/c2f52b01-d02e-47af-99c8-37b118575717?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6e25d25a66c1a3febec22cffe65b9fe 3x"}, "body": "DAUCHIさん、こんばんは。\nいつも素敵な同人誌やイラストを拝見しています！（春例の同人誌、とても最高でした）\n\n今回は、ヤマパルを描いていただきたく、ご依頼させていただきました。\n\n登場キャラ：黒谷ヤマメ、水橋パルスィ（東方Project）\n\nシチュエーション：\nヤマメとパルスィが地上に出て、どこかで何かをしているという場面を描いていただきたいです。\n場所や内容については、DAUCHIさんのご解釈にお任せしたいと思っています。\n（例：人里に紛れて買い物をする、妖怪の山で釣りを楽しむ、など　DAUCHIさんが「今いちばん描きたい」と感じる情景をぜひ描いてください）\n※ただし、人間や他の種族に直接的な危害を加えるような描写はNGでお願いいたします。\n\n今回の依頼で一番表現していただきたいのは、ヤマメとパルスィの日常、そしてその空間の空気感です。二人の関係性や、何気ないやりとりを通して感じられる雰囲気を、絵から直に伝えていただけたら嬉しいです。\n\n非常に難しいご依頼かもしれませんが、何卒よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DAUCHIMK_1/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 404692, "client_id": 1199011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df0867fc/uploads/origins/cf45fcab-a722-4e0d-b04d-3cda83a99be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e75816a1ae73675ad289584300de4eae", "srcset": "https://si.imgix.net/df0867fc/uploads/origins/cf45fcab-a722-4e0d-b04d-3cda83a99be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&