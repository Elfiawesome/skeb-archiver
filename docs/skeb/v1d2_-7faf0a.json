、鬱気味、常にネットに張り付いている。\n- 二人は幼なじみで、ユキは嫉妬からヒリョをいじめるため、その結果ヒリョは社会から引きこもるようになった。\n\nテーマ：日常、ホラー、恋愛、学校、境界領域など。\n参考となる背景のアイデア（必ずしも従う必要はありません）：写真ブース、ガチャポン、お弁当、教室、自動販売機。\n\nhttps://drive.google.com/drive/folders/1K-eeQxXqieNktYhszTE3PGaismSgpDCy", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@v1d2_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3945226, "client_id": 1950340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e004cffc/uploads/origins/437fea10-7547-42a1-bdcd-a08fe5e38c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c043e967256221820514847c8520a37", "srcset": "https://si.imgix.net/e004cffc/uploads/origins/437fea10-7547-42a1-bdcd-a08fe5e38c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c043e967256221820514847c8520a37, https://si.imgix.net/e004cffc/uploads/origins/437fea10-7547-42a1-bdcd-a08fe5e38c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=812b994e658a6cdffa2c73f49ef7a5b9 2x, https://si.imgix.net/e004cffc/uploads/origins/437fea10-7547-42a1-bdcd-a08fe5e38c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=762fc9665c743158f83ab635f18f4336 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e004cffc/uploads/origins/437fea10-7547-42a1-bdcd-a08fe5e38c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f4903148aa825960ac1ddf8450c51c", "srcset": "https://si.imgix.net/e004cffc/uploads/origins/437fea10-7547-42a1-bdcd-a08fe5e38c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f4903148aa825960ac1ddf8450c51c, https://si.imgix.net/e004cffc/uploads/origins/437fea10-7547-42a1-bdcd-a08fe5e38c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur