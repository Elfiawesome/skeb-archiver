200&blur=200&s=4fc7c4feae14c11e56f728e1654f0ac8, https://si.imgix.net/a583df6d/uploads/origins/6c79bf9c-a21a-4721-bab7-8913213dbe01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94df49b5b29e6a0a141abeb787b963c3 2x, https://si.imgix.net/a583df6d/uploads/origins/6c79bf9c-a21a-4721-bab7-8913213dbe01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3dbadc7d8bc3057703f02f4e2e63dc8c 3x"}, "body": "こんにちは、あいろ先生！\n\n前回も素敵な作品をしていただきもう一度ありがとうございました〜✨\n\nまた超かわいいVTuberを描いてみませんか？ぷえ隊長のおかげで、熊蜂えまちゃんに出会えました。えまちゃんは見せてくれる美味しいジャンクフードと同じくらい癖になるいつも楽しさがあり、喉の痛みには蜂蜜のように癒やしてくれます。えまちゃんの食いしん坊な可愛さと蜂蜜のような甘さは先生にもお似合いだと思います。ミツバチが蜜を集めるためのたくさんの花々や、楽しむためのたくさんの甘いお菓子など、そういった素敵なことをまた先生に任せられたら嬉しいです。\n\n前回同様、えまちゃんの透過画像もお願いしたいので、この作品はSNSや非商用利用での活動に使用される。\n\n私のリクエストを考慮していただきありがとうございます。海外からもずっと応援してるよ！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@airo_128/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3533218, "client_id": 1726466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1595b0fae5c4449965e1618d39e87e1a", "srcset": "https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1595b0fae5c4449965e1618d39e87e1a, https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=839a3ac4474c2c3ec29079cf98be405d 2x, https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5791fb9fd0a5997977c8d3afa785d310 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b23c48bfb6aab754fead0c1d32ac073b", "srcset": "https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b23c48bfb6aab754fead0c1d32ac073b, https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e466a43c3bec07774b8c286935128b7 2x, https://si.imgix.net/6a9f86db/uploads/origins/7ff257a9-7d00-4c2b-b761-05e6082794a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=290736f47ef9fd15c18a3b6f08377163 3x"}, "body": "こんにちは、あいろ先生！はじめまして。\n\nルルちゃんのリクエストであなたは見つけて、それ以来ずっと魅了されてきました。あいろ先生の作品はとってもかわいいだけでなく、とても細かいので、まるで不思議の国のアリスになったような気分です！私の目がどこへ行っても、見る素敵のある美しいものや、鑑賞すべき素晴らしい細部が見つかります。まるでパレードのようです！\n\nそういえば、私のリクエスト！もしよろしければ「ぴぴぴはっぴーぱれーどの隊長」玉町ぷえちゃんを描いて頂けると嬉しいです。隊長はあいろ先生のアートスタイルとあなたのキュートなディテールを見る目にぴったりだと思う。隊長もルルちゃんと同じ新VTuber（\"ママ\"が同じ！）なのでこの作品はSNSや非商用利用での活動に使用される。\n\nぴったん（ひよこ）とぺったん（ぺんぎん）含めることができれば完璧です。それ以外にも、ぷえ隊長の魅力だと感じるところを描いてお願いいたします。紋様の提案としては、あいろ先生が好きな動物ならどれでもかわいいと思いますし！ぷえ隊はアルパカからカバまで何でも好きです。そうでなければ、先生の前の 2つのskebのような花やお茶会もぴったりです。私がぷえ隊長に初めて会ったのは「flos」を歌っていた時で、ぷえ隊たちは毎日お菓子について話しています。\n\nいずれにせよ、読んでいただき本当にありがとうございました！あいろ先生の作品をこの目でますますパレードするのが楽しみです。\n\nhttps://lit.link/en/puetama", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@airo_128/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3533218, "client_id": 8407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=324c0a6ff5068d29a497883267d1d87c", "srcset": "https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=324c0a6ff5068d29a497883267d1d87c, https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4911d4194c38949112c8b4cb4f21d929 2x, https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c396da970f2cb14e8313cb027587a02d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84fc67baae71eb080d69e012427884e1", "srcset": "https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84fc67baae71eb080d69e012427884e1, https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=002ffed56abf5557776c31c4591105ec 2x, https://si.imgix.net/5dfcd6df/uploads/origins/0e0fd255-7995-4e10-bfa8-bb2e503e1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=969309921fa8e9d23567ef4e8ad2920c 3x"}, "body": "はじめまして！あいろ先生のSkebやXのイラストを拝見し、色合いや雰囲気の美しさに見惚れてしまいました。個人的に下記の2つのイラストはとてもお気に入りです。\n\nhttps://x.com/airo_128/status/1929853763596202084\nhttps://x.com/airo_128/status/1889986862284214595\n\nぜひリクエストさせてください。\n\nVTuberのたここさん（@takoko_942）のイラストをお願いしたいです。\n\nあいろ先生の世界観の中で存在するたここさんをぜひ見たいです。\n\nあいろ先生の中で描きたいイメージが浮かびましたら、そちらを優先していただきたいのですが、もしテーマがあったほうが描きやすいようでしたら「自然の中での和やかなティーパーティー」のイメージでお願いします。\n\n服装は、参考画像にある洋装または和装のいずれかでお願いできればと思います。\n目線・表情・ポーズ・構図などもすべて、あいろ先生のお好きなように自由に表現していただけますと嬉しいです。\n\n可能であれば、人物のみの透過画像もお願いしたいです。（PSDファイルでの受け取りも可能ですのでレイヤー分けされた状態でも大丈夫です）\n\nまた、たここさんご本人による使用許可もいただけますと幸いです。\n\n▼洋装参考\n全身（新衣装配信）：https://www.youtube.com/watch?v=XOD0a3CKxZ0&t=1162s\n上半身、髪型複数：https://x.com/takoko_942/status/1848345120980258881\n全体（動画）：https://x.com/nuit_rr/status/1848333541463224357\n\n▼和装参考\nキービジュアル：https://x.com/takoko_942/status/1708631879073808547\n三面図：https://x.com/takoko_942/status/1625774470265995264\n猫耳、表情（動画）：https://x.com/takoko_942/status/1858486160693268693\n\n#たこちゃあーと", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@airo_128/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3533218, "client_id": 2467814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/869592ce/uploads/origins/c33cebb0-012f-4560-aec9-b72c709c4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e07f554305608e0710839bdbf1e8ac43", "srcset": "https://si.imgix.net/869592ce/uploads/origins/c33cebb0-012f-4560-aec9-b72c709c4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e07f554305608e0710839bdbf1e8ac43, https://si.imgix.net/869592ce/uploads/origins/c33cebb0-012f-4560-aec9-b72c709c4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef6850811451e02b9edb82c587149c5a 2x, https://si.imgix.net/869592ce/uploads/origins/c33cebb0-012f-4560-aec9-b72c709c4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8aab083096456e3b4aafc2ad19ac142 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/869592ce/uploads/origins/c33cebb0-012f-4560-aec9-b72c709c4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72de7ae17898064accc0d7ce39ab1235", "srcset": "https://si.imgix.net/869592ce/uploads/origins/c33c