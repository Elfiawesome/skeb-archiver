ix.net/a77961e5/uploads/origins/67a089e0-bf9d-4222-9901-28f8f1bee5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd625f730b437550e41c228cdceb8411 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a77961e5/uploads/origins/67a089e0-bf9d-4222-9901-28f8f1bee5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57c7e5b5060c20cd649256554f486721", "srcset": "https://si.imgix.net/a77961e5/uploads/origins/67a089e0-bf9d-4222-9901-28f8f1bee5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57c7e5b5060c20cd649256554f486721, https://si.imgix.net/a77961e5/uploads/origins/67a089e0-bf9d-4222-9901-28f8f1bee5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdb3953cf099ece744bf0abdc93cccee 2x, https://si.imgix.net/a77961e5/uploads/origins/67a089e0-bf9d-4222-9901-28f8f1bee5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7c4f0aae1c6c41da9521434d42e94ad 3x"}, "body": "初めまして、朱宮と申します。\nお見かけした先生の素晴らしい作品に惹かれて私のOCを描いて頂きたくリクエスト致しました。\n下記が主な特徴です。\nOCのイメージは資料をご参照頂けますと幸いです。\n\n\n【顔】(資料1枚目のイメージ)\n① 赤い瞳\n② 右目の目元にホクロ\n③ 赤髪\n④ 長髪で束ねず下ろした状態\n\n\n【衣装等】\n① 資料2枚目のような黒メイド服＋黒ビキニ\n② 黒手袋\n③ 胸の大きさは資料4枚目のようにビキニから大きくはみ出すほど盛り目の爆乳\n\n\n【構図】\n① 資料2枚目のようにメイド服の胸元を開いてビキニを見せている状態\n② 下記資料のように腕で胸を持ち上げて強調しているポーズを正面から見た構図(資料では座り姿ですが腰上までの立ち姿のイメージ\nhttps://www.pixiv.net/artworks/82234570\n③ 先生の過去作のような余裕のある表情\nhttps://mobile.twitter.com/2E317NlmZSYAuAH/status/1611717484469686278\n\n\nアレンジを含めて詳細はお任せ致します。\nここまでご覧頂きありがとうございました。\nご検討のほど宜しくお願い致します。\n\nhttps://mobile.twitter.com/fukukitaru1997/status/1611252565244809216", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2E317NlmZSYAuAH/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2359644, "vtt_url": null, "t