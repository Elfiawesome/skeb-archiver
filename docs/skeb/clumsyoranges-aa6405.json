art", "tipped": false, "creator_id": 3576878, "client_id": 1369356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c88c68bf665ae4505cae5f4e1a4982", "srcset": "https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c88c68bf665ae4505cae5f4e1a4982, https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c23252ec4a9c9b78039f49313d57ea00 2x, https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28cce09813113477acea7cba71e34a85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1a9762cc536044527ee7e347f3f71f", "srcset": "https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1a9762cc536044527ee7e347f3f71f, https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fab58e91953d87cdfcd41f19ffdfb34f 2x, https://si.imgix.net/2eb36c50/uploads/origins/6a8e84b4-78b8-40ae-b8f5-f6cc14118c85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56031360338975816913bc779a84e248 3x"}, "body": "\ud161 TENG\ub2d8 \uc7ac\uc804\uc1a1\uc73c\ub85c \uc2e4\ub840\ud588\uc2b5\ub2c8\ub2e4. skeb\uc5d0\uc11c \ubaa8\uc9d1, \uc815\ub9d0 \uac10\uc0ac\ud569\ub2c8\ub2e4! x\uc5d0\uc11c\uc758 \ud3ec\uc2a4\ud2b8\ub97c \ubcf4\uc558\uc744 \ub54c \uae30\uc058\uace0 \ubaa9\uc18c\ub9ac\uac00 \ub098\uc654\uc2b5\ub2c8\ub2e4!!!! \uaf2d, OC\ub97c \ubd80\ud0c1\ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4! \ud83d\udd39OC\uc790\ub8cc D-\uae08\ubc1c\uc758 \uc544\uc774 183cm \ub208\uc758 \uc0c9\uc740 \ubcf4\ub77c\uc0c9, \ubcf4\ud1b5 \ub0a8\uc790\ubcf4\ub2e4 \uc18d\ub208\uc379\uc774 \uae38\ub2e4. \ud788\ud0a4\ucf54\ubaa8\ub9ac \ud574\ucee4. \uc5bc\uad74\uc774 \uc88b\uc9c0\ub9cc \uc131\uaca9\uc740 \uc5b4\uca0c\ub4e0 \ubb34\uc560\uc0c1\uc778 \ub290\ub08c\uc774\uc9c0\ub9cc, \uc2e4\uc740 \uc790\ub77c\ub294 \uac83\uc774 \uc88b\ub2e4. \ubc88\uac70\ub85c\uc6c0\uc774 \uc88b\uace0, \uc694\ub9ac \ub9db\uc788\ub294 \uc0ac\ub78c\uc785\ub2c8\ub2e4. \ub3d9\ubb3c \uc774\ubbf8\uc9c0\ub294 : \ube0c\ub9ac\ud2f0\uc2dc \uc1fc\ud2b8 \ud5e4\uc5b4 '\uace8\ub4e0' \ubcf5\uc7a5\uc740 \ud751\ubc31\uc73c\ub85c \uc154\uce20\uc640 \ud130\ud2c0\ub125\uc774 \ub9ce\ub2e4. \uc720\ub2c8\ud3fc\uc758 \uacbd\uc6b0, \ub125\ud0c0\uc774\ub294\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. K-\ud751\ubc1c\uc758 \uc544\uc774 176cm \ub208\uc758 \uc0c9\uc740 \ud68c\uc0c9, \uc5bc\uad74\uc5d0 \ud608\uc0c9\uc774 \uc5c6\uace0, \uc5b4\ub461\uc2b5\ub2c8\ub2e4. \uccb4\ub825 \uc77c\uc744 \ud558\uace0 \uc788\ub294, \uba4d\ud558\ub2c8 \uc788\ub294 \uac83\uc774 \ub9ce\uc740 \ubb34\uad6c\ud55c \uc544\uc774. \uba39\ub294 \uac83\uc744 \uc544\uc8fc \uc88b\uc544\ud558\uace0, \uc57d\uac04\uc758 \ub9db\uc788\ub294 \uac83\uc5d0 \uc7a1\ud78c\ub2e4. \ub3d9\ubb3c \uc774\ubbf8\uc9c0\ub294 : \ucf54\ucfe0 \ub9c8\ub8e8 \uce74\ub77c\uc2a4 \ubcf5\uc7a5\uc740 \uc2a4\ud3ec\ud2f0 \ud55c \uac83\uc774 \ub9ce\uc2b5\ub2c8\ub2e4. \uc720\ub2c8\ud3fc\uc758 \uacbd\uc6b0 \uc7ac\ud0b7\uc774 \uc544\ub2cc \ube68\uac04 \uae4c\ub9c8\uadc0\ub97c \uc785\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ud83d\udd39\uc2dc\ucd94\uc5d0\uc774\uc158 \ud6c4\ubcf4 \uc790\ub8cc\uc5d0 \uc788\ub294 \uce90\ub9ad\ud130\uc758 \ud5e4\uc5b4\uc2a4\ud0c0\uc77c\uc774\ub098 \uc758\uc0c1\uc744 \uac1c\ubcc0\ud574\ub3c4 \uc804\ud600 \ubb38\uc81c \uc5c6\uc2b5\ub2c8\ub2e4, \uc120\uc0dd\ub2d8\uc774 \uadf8\ub824\uc9c0\ub294 \uc790\uc2e0\uc758 OC\ub97c \ubcfc \uc218 \uc788\ub294 \uac83\ub9cc\uc73c\ub85c \ud589\ubcf5\ud558\uae30 \ub54c\ubb38\uc5d0, \uc2dc\uce04\uc5d0\uc774\uc158\uc774\ub098 \uad6c\ub3c4\ub294 \uc790\uc720\ub86d\uac8c \uadf8\ub824 \uc8fc\uc154\uc11c \uad1c\ucc2e\uc2b5\ub2c8\ub2e4! \ub9cc\uc57d \ud6c4\ubcf4\uac00 \ud544\uc694\ud55c \uacbd\uc6b0 1. \ub458\uc774 \ud568\uaed8 \ub208 \uc18d\uc73c\ub85c \ub3cc\uc544\uac04\ub2e4 \uc77c\ub7ec\uc2a4\ud2b8\ub294 PC \ubcbd\uc9c0 \ub4f1 \uac1c\uc778 \uc774\uc6a9 \ubc94\uc704 \ub0b4\uc5d0\uc11c \uad00\uc0c1\uc6a9\uc73c\ub85c \uc0ac\uc6a9\ud569\ub2c8\ub2e4. \ubc14\uc05c \ub3d9\uc548 \uc8c4\uc1a1\ud558\uc9c0\ub9cc, \uac80\ud1a0\ud574 \uc8fc\uc2dc\uba74 \uac10\uc0ac\ud558\uaca0\uc2b5\ub2c8\ub2e4.\n\nhttps://drive.google.com/drive/folders/122d3aBCA-Jp4aeK18hz1ZIagYZ9HosXU?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 115915, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "\u552f\u30ce\u30a4\u30ed", "screen_name": "_nnwnoiros", "avatar_url": "https://pbs.twimg.com/profile_images/1821085221355450368/dCavEu4L.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2594782885/1654934758/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 992395, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "\uff8b\uff7a\uff89\uff7d\uff79@\u540d\u53e4\u5c4b\u30b3\u30df\u30c6\u30a3\u30a23/22\u30fb\u30b2\u30e0\u30de\u66255/24\u51fa\u308b\uff01\uff01", "screen_name": "hikonosuke62", "avatar_url": "https://pbs.twimg.com/profile_imag