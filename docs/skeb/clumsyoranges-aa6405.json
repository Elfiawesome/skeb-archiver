&h=200&blur=200&s=d3bc739d6cc3697ef35d500caebb4d9b 3x"}, "body": "\uc548\ub155\ud558\uc138\uc694 \ud161 \ub2d8\u2026\u2026\u3160\u3160\u3160\u3160\u3160!\n\uba87 \ub144 \uc804 \uc5b4\ub9b0 \uc2dc\uc808\ubd80\ud130 \ud161 \ub2d8\uc758 \uc791\ud488\ub4e4\uc744 \uc815\ub9d0 \uc5f4\uc2ec\ud788, \uc0ac\ub791\ud558\ub294 \ub9c8\uc74c\uc73c\ub85c \ubcf4\uace0 \uc788\uc5c8\uc2b5\ub2c8\ub2e4\u00b7\u00b7\u00b7 \ucee4\ubbf8\uc158\uc774 \uc5f4\ub838\ub2e4\ub294 \uc18c\uc2dd \ub4e3\uace0 \uc9c4\uc9dc \ub208\ubb3c\uc774 \ub0a0 \ubed4\ud588\uc5b4\uc694 \u3160\u3160\u2026\u2026\u2026\u2026\n\uc2e0\uccad\ub4dc\ub9ac\uace0 \uc2f6\uc740 \uce90\ub9ad\ud130\ub294 \ubb34\uae30\ub97c \uc4f0\ub294 \ube14\ub8e8\uc544\uce74\uc774\ube0c \uae30\ubc18 \uc790\uce90\uc774\uba70, \ubb34\uae30\ub97c \uc0ac\uc6a9\ud558\ub294 \ubaa8\uc2b5\uc73c\ub85c \ubd80\ud0c1\ub4dc\ub9ac\uace0 \uc2f6\uc2b5\ub2c8\ub2e4!\n\uc678\uad00 \ucc38\uace0\ub97c \uc704\ud574 \uad6c\uae00 \ub4dc\ub77c\uc774\ube0c \ub9c1\ud06c \ud568\uaed8 \ucca8\ubd80\ub4dc\ub9b4\uac8c\uc694.\n\ub0a8\uc740 \uc5f0\ud734 \ud589\ubcf5\ud558\uac8c \ubcf4\ub0b4\uc2dc\uace0, \ud56d\uc0c1 \ucd5c\uc120\uc744 \ub2e4\ud574\uc8fc\uc2dc\ub294 \ud161 \ub2d8\uc744 \uc9c4\uc2ec\uc73c\ub85c \uc0ac\ub791\ud569\ub2c8\ub2e4\u2026\u2026 \ud83e\udd7a\ud83d\udc99\n\nhttps://drive.google.com/drive/folders/1CdYAB5UE5fyOCHKEEXH03ilkPqFK9aL5\n\nhttps://drive.google.com/drive/folders/1CdYAB5UE5fyOCHKEEXH03ilkPqFK9aL5", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@clumsyoranges/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3576878, "client_id": 1567125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007690c5f8f57bece820fc8366a137f8", "srcset": "https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007690c5f8f57bece820fc8366a137f8, https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80c614b5ff29e30375425f1c7f4437f7 2x, https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80ff6a7f439aa69bd12b67e3c9f18c77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c9934878d2e3b3e2a6efc9e7497157", "srcset": "https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9c9934878d2e3b3e2a6efc9e7497157, https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a95b04228b17c7fa98f4418969f97f35 2x, https://si.imgix.net/ba65b4cb/uploads/origins/47bc9a92-eba3-4b25-a49e-577301914b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b4c421da0afe5d9e0126b8a5e7d941a 3x"}, "body": "\uc548\ub155\ud558\uc138\uc694, \ud161\ub2d8. \ucc98\uc74c \ubd59\uaca0\uc2b5\ub2c8\ub2e4.\n\ud3c9\uc18c \ud161\ub2d8\uc758 \uc77c\ub7ec\uc2a4\ud2b8\ub97c \uc88b\uc544\ud558\uc5ec, \uad1c\ucc2e\uc73c\uc2dc\ub2e4\uba74 \uc81c OC 2\uc778\uc758 \uc77c\ub7ec\uc2a4\ud2b8\ub97c \uadf8\ub824\uc8fc\uc168\uc73c\uba74 \uc88b\uaca0\uc2b5\ub2c8\ub2e4.\n\n[\uce58\uc0ac\uce74 \ucf00\uc774 (\uc2e0\uc7a5 : 180cm)] \uc5b4\ub450\uc6b4 \ub179\uc0c9\uba38\ub9ac / \uce58\ucf1c \uc62c\ub77c\uac04 \ud68c\uc0c9 \ub208\n\ud53c\ubd80\uac00 \ud558\uc597\uace0 \ub9c8\ub978 \uccb4\ud615\uc5d0 \uc798 \uc6c3\uc9c0\uc54a\uc544 \ubc1d\uc740 \uc778\uc0c1\uc740 \uc544\ub2d9\ub2c8\ub2e4. \ub208 \ubc11\uc774 \uc0b4\uc9dd \uc5b4\ub461\uace0, \uc591\ucabd \uadc0\uc5d0\ub294 \ud53c\uc5b4\uc2f1\uc744 \ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uace0\ub4f1\ud559\uad50 \uc5f0\uadf9\ubd80 \ucd9c\uc2e0, \ubca0\uc774\uc2a4 \uae30\ud0c0\ub97c \ub2e4\ub8e8\uba70 \uc74c\uc545\uc744 \uc804\uacf5\ud569\ub2c8\ub2e4.\n\n[\uc544\ub9c8\ub204\ub9c8 \uce74\uc624\ub9ac (\uc2e0\uc7a5 : 162cm)] \ub808\uc774\uc5b4\ub4dc \ucef7 \ub2e8\ubc1c\uc758 \ubc00\uc0c9 \uba38\ub9ac / \uace0\uc591\uc774 \ub3d9\uacf5\uc758 \uce58\ucf1c\uc62c\ub77c\uac04 \ubd84\ud64d\uc0c9 \ub208\n\ub9c8\ub978 \uccb4\ud615\uc5d0 \ub6b1\ud55c \uc778\uc0c1, \uc0ac\ub78c\uc5d0 \ub530\ub77c \uc21c\ud558\uae30\ubcf4\ub2e4\ub294 \uc0ac\ub098\uc6cc\ubcf4\uc774\ub294 \ub208\ub9e4\uc785\ub2c8\ub2e4. \uc591\ucabd \uadc0\uc5d0 \uac04\ub2e8\ud55c \uadc0\uac78\uc774\ub97c \ud569\ub2c8\ub2e4. \uace0\ub4f1\ud559\uad50 \uc5f0\uadf9\ubd80 \ucd9c\uc2e0, \ubc30\uc6b0\uc774\uae30\ub3c4 \ud588\uace0 \uc5f0\ucd9c\uc744 \uc815\uacf5\ud569\ub2c8\ub2e4.\n\n\ub450\uc0ac\ub78c\uc740 \uce5c\uad6c \uad00\uacc4\uc785\ub2c8\ub2e4. \uc720\ud589\uc5d0 \ubbfc\uac10\ud55c MZ \uccad\uc18c\ub144\uc73c\ub85c, \uc1fc\uc15c \ubbf8\ub514\uc5b4\uc640 \ud328\uc158\uc5d0 \uc2e0\uacbd\uc744 \ub9ce\uc774 \uc501\ub2c8\ub2e4. \uc678\ubaa8\uac00 \uace0\uc591\uc774\uc0c1\uc5d0 \ucfe8\uc5d0 \uac00\uae4c\uc6cc K\ud328\uc158\uc774 \uc798 \uc5b4\uc6b8\ub9ac\ub294 \ud3b8\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4. \ubaa8\ucabc\ub85d, \uce90\ub9ad\ud130\uc5d0 \ub300\ud55c \uc0c1\uc138 \uc774\ubbf8\uc9c0 \uc790\ub8cc\ub294 \ucca8\ubd80 \ub9c1\ud06c\ub97c \ucc38\uace0\ud574\uc8fc\uc2dc\uba74 \uac10\uc0ac\ud569\ub2c8\ub2e4.\n\n\uc77c\ub7ec\uc2a4\ud2b8 \uc0ac\uc6a9 \uc6a9\ub3c4\ub294 \uac1c\uc778 \uc18c\uc7a5 \ubc0f \uac1c\uc778 SNS \uc5c5\ub85c\ub4dc\uc785\ub2c8\ub2e4. \uac00\ub2a5\ud558\ub2e4\uba74 \ub0a9\ud488 \uc2dc \ubc30\uacbd \ud22c\uba85\ud654 \ud30c\uc77c\uc774 \ud568\uaed8\uc774\uba74 \uc88b\uc2b5\ub2c8\ub2e4. \uc5b4\ub835\ub2e4\uba74 \uac70\uc808\ud574\uc8fc\uc154\ub3c4 \ub429\ub2c8\ub2e4.\n\n\uad6c\ub3c4\ub098 \ud3ec\uc988, \uba38\ub9ac\uc2a4\ud0c0\uc77c \ubc0f \ubcf5\uc7a5\uc758 \uc77c\ubd80\ub97c \ubcc0\uacbd\ud558\ub294 \uac83 \ub4f1 \ubaa8\ub450 \uc790\uc720\ub86d\uac8c \ud574\uc8fc\uc138\uc694. \uc791\uac00\ub2d8\uc758 \uc790\uc720\ub85c\uc6b4 \uad6c\uc0c1\uc744 \ubcf4\ub294 \uac83\uc73c\ub85c \ucda9\ubd84\ud569\ub2c8\ub2e4.\n\ub9ac\ud018\uc2a4\ud2b8 \uae08\uc561\uc758 \uacbd\uc6b0 \uc0dd\uac01\ud558\uc2e0 \uc77c\ub7ec\uc2a4\ud2b8 \uad6c\uc0c1 \ub300\ube44 \ubd80\uc871\ud560 \uc2dc \uc7ac\ubc1c\uc1a1 \uc694\uccad \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.\n\n\uc88b\uc544\ud558\ub294 \ubd84\uaed8 \uc758\ub8b0\ub97c \uc694\uccad\ud560 \uc218 \uc788\uc5b4 \uae30\uc069\ub2c8\ub2e4. \ubd80\ub514 \uae0d\uc815\uc801 \uac80\ud1a0 \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4. \uac10\uc0ac\ud569\ub2c8\ub2e4.\n\nhttps://drive.google.com/drive/folders/1Rq-q-v0xaXaieF--X5NpvXnbQAPv1rx_?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@clumsyoranges/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3576878, "client_id": 2141446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6920a48a/uploads/origins/756e645d-5c2a-4e93-a2b8-aaf4c2e59e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc3e49dfff2c5e3a9b1cbe5ff036cd2d", "srcset": "https://si.imgix.net/6920a48a/uploads/origins/756e645d-5c2a-4e93-a2b8-aaf4c2e59e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc3e49dfff2c5e3a9b1cbe5ff036cd2d, https://si.imgix.net/6920a48a/uploads/origins/756e645d-5c2a-4e93-a2b8-aaf4c2e59e73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e356b939ae61de813a73a07780f56e3 2x, https://si.imgix.net/6920