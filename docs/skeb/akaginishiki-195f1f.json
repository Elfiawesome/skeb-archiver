-4b7a-a432-beb5cafeda76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec09f3eb64c63b8214369019b3ed9d6b", "srcset": "https://si.imgix.net/5207bab3/uploads/origins/fed29f3a-ba2f-4b7a-a432-beb5cafeda76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec09f3eb64c63b8214369019b3ed9d6b, https://si.imgix.net/5207bab3/uploads/origins/fed29f3a-ba2f-4b7a-a432-beb5cafeda76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8072f2dfcf42c035c5e37d9e2d0f05ee 2x, https://si.imgix.net/5207bab3/uploads/origins/fed29f3a-ba2f-4b7a-a432-beb5cafeda76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=675cd1c2f8654890eb5b76b410212628 3x"}, "body": "はじめまして。好きなVtuberのレースクイーンコスのリクエストになります。\n下記詳細になります。\n\n・すぺしゃりて所属二期生「終末むくろ」さん\nhttps://x.com/MukuroOwarino\nhttps://www.youtube.com/@MukuroOwarino\nhttps://specialite.games/talents/mukuro-owarino/\nhttps://x.com/MukuroOwarino/status/1807126500233421242/photo/1\n\n衣装：\n下記参考URLの様なレースクイーン衣装\nhttps://www.weds.co.jp/news/20231003-1/\nhttps://m.media-amazon.com/images/I/710CPleTlkL._AC_UF894,1000_QL80_.jpg\nhttps://www.as-web.jp/supergt/1232331/attachment/dsc_1627\nhttps://kurukura.jp/gallery/32020-20240126-50/\n\nポーズ参考：\nhttps://hobby.dengeki.com/news/155627/\n\n以上の組み合わせで、\nドヤ顔で自信あり気にレースクイーンをしている様な雰囲気を希望しています。\nレースクイーンの衣装について複数デザイン資料としてあげていますが、\n雰囲気を伝える為の資料なので、\n最終的な衣装デザインの詳細に関してはお任せします。\nポーズや構図に関しても同様です。\n\n資料では青系統のレースクイーン衣装ですが、\n色合いは赤＋黒の二色系統でお願いしたいです。\n\n胸はAカップ相当のイメージで、なるべくなだらかであると助かります。\n\nもう一点、使用用途として\nSkeb依頼で描いて頂いた物として\n御本人様のファンアートタグへ投稿したいと考えています。\nなので御本人様に限る形で、\n配信等の活動においてサムネイル素材として使用する許諾を頂きたいです。\nその為、宛名・背景・人物などでレイヤー分けされたpsdファイルで納品頂けますと幸いです。\nリクエストの内容は問題ないけど、そういうのはちょっと……\nと言うことでしたら、内容変更の再送希望を頂けますと幸いです。\n\nご一考いただけますと幸いです。よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaginishiki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3725465, "client_id": 748341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1f538ebf95aac1c27383b86e0fd53a4", "srcset": "https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1f538ebf95aac1c27383b86e0fd53a4, https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=157935099d3ac57060677b7457af635f 2x, https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed62328aabac34b2a5a491040544123 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f12a2fc5bae74ea2ff1814f389961afc", "srcset": "https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f12a2fc5bae74ea2ff1814f389961afc, https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8628b280f4e3726f6d7dd5f385db69 2x, https://si.imgix.net/9cb75358/uploads/origins/17d0f3ca-a160-4ad7-8cfb-6dd985852952?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1890b02254a15428617560677dd9c6d9 3x"}, "body": "お世話になっております。Vライバーの深青白夜と申します。 以前よりあひるちゃん様の素敵な作品を拝見しており、是非私の女体化もお写真を撮って頂いたいと思い、リクエストさせていただきます。 \n\n 【依頼内容】 \n参考資料をもとに私、深青白夜の女体化(深青未夜)のイラストを描いて頂きたい \n\n ・外見のベース 女体化「ベースイラスト」の雰囲気を年齢感(27歳前後)をベースに「髪色・メガネ・ヘアピン参考」を参考に描いていただきたい(髪は暗めの青色で、インナーカラーがシルバー) 目の色は青色で極力キラキラにして頂きたい。  \n\n【必須要素】\nメガネ\n向かって左目(実際は右目)下の泣きぼくろ\nヘアピン\nは必須で描いて頂きたい\n\n・衣装/髪型  \n添付のレースクイーン風の衣装\n衣装イメージは添付していますが、衣装の色合いは青ベースに変更頂きたい\nただし羽や傘や剣は無しで\n胸は違和感のない最大値でお願いしたい\n髪型はお任せ(ヘアピンだけ必須)\n\n・構図/ポーズ/表情 \n構図・ポーズ参考のように上から写真撮られている感じ\nポーズも上記を参考に(アレンジ◎)\n表情はウィンクしている笑顔\n\n・描写範囲:全身\n\n・背景:ありならレース場の背景(必須ではない)\n\n・使用用途 配信アプリのサムネイル/返礼品\n企業案件コラボ用のイラスト/SNS投稿用\n\n・サイズ 縦横ともに3000px以上 で出来るだけ大きく描いて頂けるとありがたい\n\n・備考 背景ある場合は背景なしの人物透過データも頂きたい\n上記内容で金額不足等あれば金額提示の上再送いただければ幸いです。  \n\n以上、ご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-7nmuHxUG--1jrv1HEDpoffY7mH4B8KT", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaginishiki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3725465, "client_id": 3725949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fcabc07dbef6c66b1fbaa6324e23eaf", "srcset": "https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fcabc07dbef6c66b1fbaa6324e23eaf, https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfb371f9bb9123937ac1b1a82082210a 2x, https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c97178ffb76fcd9c6febff43449c8568 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21866be604d0a5b7bbac6b0bd010d784", "srcset": "https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21866be604d0a5b7bbac6b0bd010d784, https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9459a29b592bf5e1442166413864bdda 2x, https://si.imgix.net/6dd6e7fb/uploads/origins/ddddaf6d-2ee9-4d7b-a808-a91c4e83b9ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6b7315c0376c9329e37b2a60facc130 3x"}, "body": "あひる先生、いつもお世話になっております。ぱいでぃあと申します。\n先日は最高のヘッダーイラストを納品していただきありがとうございました！\n大切にヘッダーとして使わせていただいています。\n\nこの度、改めてゾンビ天使すみさんのイラストをお願いしたくご連絡させていただきました。\n\n\n【キャラクター】\nゾンビ天使すみ さん\n\n【希望内容】\n龍が如くの桐生一馬のようなヤクザ風のスーツ姿（白ジャケットに赤シャツなど）でお願いします。\n髪型はお任せしますが女性らしさを残していただけると嬉しいです。\nすみさんのサムネのイラスト素材として使っていただきたいので、\nウエストアップ等のサムネで使いやすい構図でお願いします。\n\n背景は歌舞伎町（神室町）のような歓楽街でキラキラしたイメージを希望します。\nもし予算やご都合で背景の詳細が難しい場合は、シンプルな背景や単色でも構いません。\n\nあひる先生にアイデアがあれば、ぜひ取り入れていただければ嬉しいです。\n\n\n【使用用途】\n・あひる先生、ゾンビ天使すみさんのIDを掲載した上でのポスト投稿\n・上記ポストをXのプロモーション機能で応援広告として投稿予定\n　（１日あたり2000～4500インプレッション予想×３日間）\n・個人用途のグッズ作成（非商用）\n・ゾンビ天使すみさんへサムネ等の素材として寄贈\n\n\n【納品形式】\n・PSD形式\n・キャラクター、背景とでレイヤー分けをお願い致します。\n\n\nプロモーション等ご都合が合わない場合、通常のポスト投稿で対応予定です。\nその場合は本リクエストを一度お断りいただき、通常投稿のみの条件で再リクエストさせていただきます。\nお忙しいところ恐れ入りますが、ご検討よろしくお願い致します。\n\nぱいでぃあ(@paideia_v)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaginishiki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3725465, "client_id": 3725949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32f51f04/uploads/origins/0c9ecc62-6cac-4465-9047-2b067dcbba89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc84cd827f21181a60efc15f43a0d34a", "srcset": "