は小暮が突出することが多く、度が過ぎた時は逢真が容赦なく首根っこを掴み上げて制止する、という様子がよくみられる。仲が良いわけではないが、食事の好みが近かったり(激辛料理が好き)、妙に嚙み合った行動をとるので、人間版トムとジェリーだ、などと言われることもある。\n\n構図は自由に書いていただいてかまいません。\n容姿の詳細は資料URLに立ち絵がありますのでご確認ください。\nどうぞよろしくお願いいたします。\n\nhttps://ccfolia.com/rooms/6V0QqYzjj", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@budoutoriba/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2739592, "client_id": 1287253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/233cbf58/uploads/origins/2ee2ae87-f6a8-4370-9aa8-4b5f23a4c409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f86e52c78a4199afa621984e57d8cba7", "srcset": "https://si.imgix.net/233cbf58/uploads/origins/2ee2ae87-f6a8-4370-9aa8-4b5f23a4c409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f86e52c78a4199afa621984e57d8cba7, https://si.imgix.net/233cbf58/uploads/origins/2ee2ae87-f6a8-4370-9aa8-4b5f23a4c409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f4fe364790b51532d64904416aaab51 2x, https://si.imgix.net/233cbf58/uploads/origins/2ee2ae87-f6a8-4370-9aa8-4b5f23a4c409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92fabe02d881ca78813ac2f9e79a8f30 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/233cbf58/uploads/origins/2ee2ae87-f6a8-4370-9aa8-4b5f23a4c409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7644452324837393f77b1e8872d5bdaf", "srcset": "https://si.imgix.net/233cbf58/uploads/origins/2ee2ae87-f6a8-4370-9aa8-4b5f23a4c409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7644452324837393f77b1e8872d5bdaf, https://si.imgix.net/233cbf58/uploads/origins/2ee2ae87-f6a8-4370-9aa8-4b5f23a4c409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=