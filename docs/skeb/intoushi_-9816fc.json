.jpg?rlkey=3j1g5ql9vltpofc39pyy4qn79&dl=0\n\n資料(るいん)\nhttps://www.dropbox.com/scl/fi/pbrki39onm7nzqh6pl3t6/2.png?rlkey=qsm3a1he5ogs4zlzch8j42juz&st=q1z1v9mb&dl=0", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@intoushi_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 77540, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fcd0536/uploads/origins/bf050e69-4db9-42fd-9918-708e64f9fb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c439a98391dd0d654ebb63218c352cf1", "srcset": "https://si.imgix.net/2fcd0536/uploads/origins/bf050e69-4db9-42fd-9918-708e64f9fb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c439a98391dd0d654ebb63218c352cf1, https://si.imgix.net/2fcd0536/uploads/origins/bf050e69-4db9-42fd-9918-708e64f9fb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76e0b894f113537c8da87244184fb240 2x, https://si.imgix.net/2fcd0536/uploads/origins/bf050e69-4db9-42fd-9918-708e64f9fb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89ad819190b9e1221e70ee8e9256e2fd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2fcd0536/uploads/origins/bf050e69-4db9-42fd-9918-708e64f9fb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e812d2453141e56e8ba81214a2a6eff9", "srcset": "https://si.imgix.net/2fcd0536/uploads/origins/bf050e69-4db9-42fd-9918-708e64f9fb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e812d2453141e56e8ba81214a2a6eff9, https://si.imgix.net/2fcd0536/uploads/origins/bf050e69-4db9-42fd-9918-708e64f9fb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6728ade0a4926c41e26dc594e9011832 2x, https://si.imgix.net/2fcd0536/uploads/origins/bf050e