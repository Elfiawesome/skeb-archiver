塚本さんにお任せできればと存じますので、自由に制作いただけましたら幸いです。\n塚本さんの作品の世界観、色彩、心を掴まれるような人物たちの表情が\n大好きなので、是非このリクエストにてまた新たな作品が見られたらと存じます！\n\n長文にて失礼いたしました。何卒よろしくお願いいたします。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 110, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2652724, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "omiso", "screen_name": "omiso", "avatar_url": "https://pbs.twimg.com/profile_images/2029513713661947904/0mCp79we.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1910320806703599616/1744291679/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 32}, {"id": 3041401, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "仮名", "screen_name": "KARINAillust", "avatar_url": "https://pbs.twimg.com/profile_images/1813454900396998656/fI3IXA88.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1581622563989438464/1777026565/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 