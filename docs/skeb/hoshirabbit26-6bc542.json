02\u98f4\u8272\u3042\u3081\u3046\u3067\u3059\u3002\n\u4ee5\u524d\u306f\u53ef\u611b\u3044OP\u3068ED\u3092\u4f5c\u3063\u3066\u3044\u305f\u3060\u304d\u8aa0\u306b\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\u3002\nOP\u304c\u6d41\u308c\u308b\u5ea6\u306b\u3001\u30ea\u30b9\u30ca\u30fc\u306e\u7686\u69d8\u304c\u300c\u795eOP\uff01\u300d\u3068\u559c\u3093\u3067\u3044\u308b\u306e\u3067\u3001\u79c1\u3082\u3068\u3063\u3066\u3082\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u4eca\u56de\u3001YouTube\u306e\u30c1\u30e3\u30f3\u30cd\u30eb\u767b\u9332\u8005\u69d8\u304c1000\u4eba\u3044\u3063\u305f\u969b\u306e\u304a\u795d\u3044\u30a4\u30e9\u30b9\u30c8\u3092\u3001\u662f\u975eOP\u3068ED\u3092\u624b\u639b\u3051\u305fusaplanet\u5148\u751f\u306b\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n(\u73fe\u5728\u306f\u5168\u71361000\u4eba\u306b\u306f\u5c4a\u3044\u3066\u3044\u306a\u3044\u306e\u3067\u3059\u3057\u3001\u3044\u30641000\u4eba\u306b\u3044\u304f\u304b\u4e0d\u660e\u3067\u3059\u304c\u3001\u4f59\u88d5\u3092\u3082\u3063\u3066\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f)\n\n\u25bc\u983c\u307f\u305f\u3044\u30a4\u30e9\u30b9\u30c8\n\u98f4\u8272\u3042\u3081\u3046\u306e\u30a4\u30e9\u30b9\u30c8\n\u30dd\u30fc\u30ba\u30fb\u9aea\u578b\u30fb\u8863\u88c5\u6539\u5909\u306a\u3069\u3001\u5168\u3066\u5148\u751f\u306e\u81ea\u7531\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\u3002\n\u305f\u3060\u3001\u300c\u524d\u9aea\u306e\u9752\u8272\u3068\u9ec4\u8272\u306e\u9aea\u98fe\u308a\u300d\u3060\u3051\u306f\u5fc5\u305a\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002\n\u307e\u305f\u3001\u304a\u795d\u3044\u306e\u30a4\u30e9\u30b9\u30c8\u306a\u306e\u3067\u3001\u8868\u60c5\u306f\u6674\u308c\u3084\u304b\u306a\u65b9\u304c\u671b\u307e\u3057\u3044\u3067\u3059\u3002\n\n\u25bc\u7d0d\u54c1\u5f62\u5f0f\nPNG\u30fbJPEG\u30fbPSD\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\n\u30ad\u30e3\u30e9\u5358\u4f53\u306e\u900f\u904e\u3082\u3042\u