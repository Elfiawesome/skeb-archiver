_genre": false}, {"path": "/@sinzinsitappa/works/74", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 797543, "client_id": 3675666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7fece49070145f0809ac767135cdd7", "srcset": "https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7fece49070145f0809ac767135cdd7, https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22d85cad69b222178c985705523d7526 2x, https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d35b31f1c34f615a5dd6ba80e746dd9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e5d76b5a31c4db5081443971669c70d", "srcset": "https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e5d76b5a31c4db5081443971669c70d, https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7ccbd196c8fe0dd1b5ccf6755de16e 2x, https://si.imgix.net/d9026236/uploads/origins/2b6c836d-1fd3-4c30-99e8-6ce9a8d1a088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8243892e8bb9946b91085f104fbfc03 3x"}, "body": "実際送った依頼文\n\n自キャラの白原　幽（しらはら　かすむ）という三十路サラリーマン男性が、同僚の畝井（うねい）君に怯えた目をして殴る蹴る、首を絞める等又は、性的暴行を受けているなぁというのが分かる絵を描いて頂きたく思います。\n　上記のは嫌です、無理ですという場合は御気分を悪くさせてしまいすみません。その場合は、出来る範囲のそれを匂わす絵、又は全く違う案ですと、白原単体のきゅるきゅるきゃわわ💖💖💖（白原は女性アイドルみたいなポーズをします）な何かか、第三案は白原は首吊りが成功して地縛霊に成るのですが、（死後は赤い首吊り縄をしています）可能でしたら零冥君との謎クロスオーバー。お任せします。\n\n　出来れば第一案が良いのですが、第一案で大丈夫な場合は、畝井が無表情かやや怖い顔をしていて、白原は怯えた表情で腕で顔や頭を庇って体をこわばらせていれば最高です。　\n　白原が怯えていれば違うポーズでも大変嬉しいです！服装や白原等の特徴はこだわりたいですが、構図等お任せします！何卒宜しくお願い致します。\n\n白原の特徴\n　黒髪、ピアス無し。薄灰色の目に（逆バニーガールの絵が唯一目に色を塗ってます。）瞳孔は黒色のぐちゃぐちゃの星みたいな形。垂れ目垂れ眉。骨が浮くほどの痩せ型身長185cm。（身長はありますが、添付した僕の自撮り位の体型で大丈夫です。）三十路男性にしてはベリベリキュート過ぎる若々しい顔。首に首吊り跡がドス黒いカラフルな痣有り。頭とおしりがちいちゃい。おしりが意味ない位にちいちゃい。\n　服装は白ワイシャツに黒のスラックスで、白原は薄っすら模様が入った黒のネクタイをきっちり上までぼたんを閉めてきつく結んで、黒靴下に黒のローファーでお願いします。\n\n畝井の特徴\n　ピアス無し。黄色の混じった不思議な色合いの焦茶（後ろと、耳の前の髪を刈り上げている。刈り上げた部分はより濃い茶色。）の癖っ毛で、強い黄色の目に爬虫類みたいな瞳孔、吊り目吊り眉、涙袋有り。大きめの筋肉がついている感じの体格。（白原より頭一個分身長が高く、体格差もでかい。）三十路顔\n　服装は白ワイシャツ、黒スラックス、靴下は黒系か白原イメージの水色か深い色合いのスーツに似合う寒色のもの4ホールの焦茶色の革靴でお願いします。（指示が細かいと思いますので、畝井はある程度アレンジして大丈夫です！）", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 875913, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "MD", "screen_name": "kyu_sai74", "avatar_url": "https://pbs.twimg.com/profile_images/2010350994400620544/xsz-c6WQ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1933200, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "といとい", "screen_name": "toitoitoi23", "avatar_url": "https://pbs.twimg.com/profile_images/2022301641958113280/F9li6YZ4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1450694813540487169/1770592426/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_