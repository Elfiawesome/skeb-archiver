d/1dNHp7SRYZLqX_ZKPtD_RbN3XK-w17_MP/view\n\n・目と眉が近め、ピアスは左側のみです。瞳は分かりにくいですが薄く黄色がかっています(羊イメージ)\n・ベルトの模様は羊たちの沈黙の蛾のようになっています。\n・モチーフは黒い羊で髪の形状にすこし遊戯王のような固定の癖があり、外はねの髪が未耳のようになっていたり、描きづらいですすみません。\n・表情変化は少なめで第一印象はクールな人間ですが、スキンシップが好きで好色な面もある人物です。何を考えているか分かりづらいです。\n・黒系、少し紫をテーマカラーにしています。\n・ポーズ、構図などはおまかせしますが、描きづらければ服装も変えていただいて構いません！肌の露出が少なく黒を好みます。\n\n\n都合上パロディ絵のつもりで描いているものもあるのですが、るうさんの絵柄で拝見させていただけたら嬉しく思います。\n\n御目通しのお時間を頂きありがとうございます🙇‍♀️ご検討よろしくおねがいいたします！\n\nhttps://drive.google.com/file/d/1dNHp7SRYZLqX_ZKPtD_RbN3XK-w17_MP/view", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ru_u_01/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3569588, "client_id": 3521962, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1306790/uploads/origins/639e0f81-a34f-49d2-a4fe-619e8039f341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01213f67a63e09706293df926c7f145", "srcset": "https://si.imgix.net/c1306790/uploads/origins/639e0f81-a34f-49d2-a4fe-619e8039f341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01213f67a63e09706293df926c7f145, https://si.imgix.net/c1306790/uploads/origins/639e0f81-a34f-49d2-a4fe-619e8039f341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a150c74288031fda9deecf2535fbfa3 2x, https://si.imgix.net/c1306790/uploads/origins/639e0f81-a34f-49d2-a4fe-619e8039f341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5246880089211724c5ec7bb905dad435 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1306790/uploads/origins/639e0f81-a34f-49d2-a4fe-619e8039f341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=769a9092649607de16ac94dc76b432d2", "srcset": "https://si.imgix.net/c1306790/uploads/origins/639e0f81-a34f-49d2-a4fe-619e8039