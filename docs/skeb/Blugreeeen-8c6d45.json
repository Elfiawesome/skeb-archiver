f6/uploads/origins/794ee307-52b7-466d-a737-5e4a1160e9a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1137f83764e8bc20750ddb188da5597d, https://si.imgix.net/d80428f6/uploads/origins/794ee307-52b7-466d-a737-5e4a1160e9a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13e0eead94ee17db922420068c925516 2x, https://si.imgix.net/d80428f6/uploads/origins/794ee307-52b7-466d-a737-5e4a1160e9a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86c4c76a7aac7c56a5d3eed43f27e444 3x"}, "body": "はじめまして。いつもTwitterやpixivで拝見しております。星苔様の描くおじさまと少女の組み合わせが大好きです！この度は自作ゲームのキャラクターを描いていただきたく依頼いたしました。\n\n資料の二人は洋館から脱出するホラーゲームに登場するキャラクターです。男は洋館に住む人形作家で、このゲームの悪役です。少女は男に監禁されている被害者ですが、闇落ちしてしまっているサブヒロインです。\n\nイラストの内容は、ダークで怪しい雰囲気の二人が絡み合っているのをうっかり見てしまった……みたいな、ゾクッとするような感じでお願いします。\n（大まかな指示ですみません。構図やポーズはお任せいたします。）\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/109Ama3hSRW7vMOEBp2ra-_asiH7lJBd0?usp=sharing", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Blugreeeen/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1630816, "client_id": 22789, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=017dfc756027f1c1157c5a25fc28e4c9", "srcset": "https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=017dfc756027f1c1157c5a25fc28e4c9, https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9f74ab89e471777b62a7606bccfbaad 2x, https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbbf86b96f3ab35e4068fdefa928caea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1c70c6e4e687fed5252cdf170551da", "srcset": "https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1c70c6e4e687fed5252cdf170551da, https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfd55c0f127ec1073b9e69d5f1363554 2x, https://si.imgix.net/d0b56575/uploads/origins/dab00d07-3115-4eee-9259-0062d54e18af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8fe074bc33ccf934e0f86e59aeba4d9 3x"}, "body": "ファンです！！！！！！！！！！！いつも見てます！！！！！！！\n今回オリキャラたちを描いていただきたくてリクエストさせていただきました！\nオリキャラのバーキーとメァレンがふたりで仲良くしてるところをお願いしたいです！\nふたりはとっても仲良しで、大親友や兄妹のような関係です！\nできれば日常のワンシーンのような感じだとめちゃハッピーです…！！でも、描きやすい、思いついたシチュエーションで大丈夫です！\n\n背景はあっても無くても大丈夫です！\nキャラの服飾デザインは簡略化していただいて大丈夫です！\n資料の二枚目にマントの中身をメモしてあるので、必要であればマントを取っていただいても大丈夫です\n資料にない部分のデザインはご自由に補完してください…！！\nご検討よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1ELYXNowEIGbN5tStSlccPdabKSFFsERJ?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Blugreeeen/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1630816, "client_id": 2849059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/454d6ed9/uploads/origins/6d73f265-b1d1-45e0-af54-ca3d1528b0c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aea750cd1448ae6e7437c62b767d84e", "srcset": "https://si.