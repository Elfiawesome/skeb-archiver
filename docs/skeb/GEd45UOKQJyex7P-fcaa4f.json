だけるとありがたいです。\n\n【注意事項】\nXの\"AIモデル学習利用\"の明文化により学習に利用される等の話題がありますが、依頼するFAもXなどのSNSでVTuber様の活動に利用させていただきます。\nそのため、AIモデル学習利用についてご懸念があるようであれば、依頼をキャンセルをしていただいて問題ありません。\n\nご検討の程よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GEd45UOKQJyex7P/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2554973, "client_id": 3059214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/465900d8/uploads/origins/e2ec4ffa-6d3d-4a2d-8329-7384b477fdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70fbffd363ccec8dfe27c8628c4b1e73", "srcset": "https://si.imgix.net/465900d8/uploads/origins/e2ec4ffa-6d3d-4a2d-8329-7384b477fdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70fbffd363ccec8dfe27c8628c4b1e73, https://si.imgix.net/465900d8/uploads/origins/e2ec4ffa-6d3d-4a2d-8329-7384b477fdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a073857aaa5c9214499f4094a4d40c0 2x, https://si.imgix.net/465900d8/uploads/origins/e2ec4ffa-6d3d-4a2d-8329-7384b477fdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b194c5b3df7754d928fde468e2acb88e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/465900d8/uploads/origins/e2ec4ffa-6d3d-4a2d-8329-7384b477fdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77c47ea42ed431b815dfee533dfedc06", "srcset": "https://si.imgix.net/465900d8/uploads/origins/e2ec4ffa-6d3d-4a2d-8329-7384b477fdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77c47ea42ed431b815dfee533dfedc06, https://si.imgix.net/465900d8/uploads/origins/e2ec4ffa-6d3d-4a2d-8329-7384b477fdaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45e4bff18d9d9a0f07df249bb8af154e 2x,