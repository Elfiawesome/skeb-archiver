e-a0b92f255217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e16cca429d2d1dc8ab36c5e19a49fbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/567fa48b/uploads/origins/7f856d3c-b674-45c4-a26e-a0b92f255217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aeeca4771912e4db4c5752c33d2a8670", "srcset": "https://si.imgix.net/567fa48b/uploads/origins/7f856d3c-b674-45c4-a26e-a0b92f255217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aeeca4771912e4db4c5752c33d2a8670, https://si.imgix.net/567fa48b/uploads/origins/7f856d3c-b674-45c4-a26e-a0b92f255217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba98d37f5a4fbae98e2d9dd22c7bdebd 2x, https://si.imgix.net/567fa48b/uploads/origins/7f856d3c-b674-45c4-a26e-a0b92f255217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c4ff7b70a3867b91c63c5bf19ac899c 3x"}, "body": "初めまして、声の活動をしている大山チロルと申します。\n可愛いイラストに惹かれまして今回リクエストをお送りさせていただきます。\n\n活動の体の、うさぎクラゲというキャラクターのイラストをお願いします。\n動きやポーズが付けにくいキャラクターと思いますので\n自由に描きやすいようにお願いしたいです。\nXには色々写真上げてますので資料アドレスのもので足りなければご確認ください。\n（※隠してはいますが仕事柄アダルト投稿や出演作画像があります、ご注意ください）\n\nskebリクエストにあった絵画風がとっても素敵なので\nかのであればそのようなイメージで\n難しければ通常イラストで問題ございません。\n\n\n【使用用途】 \nSNS、イラスト依頼資料やグッズ制作などです。\n\n【サイズ】\n2000以上の正方形\n\nご検討よろしくお願いします。\n\nhttps://x.com/mirai_chiroru/status/2019549468249747847?s=61&t=fcrkNp2K2OVuSEBZSqJbVQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suyasuya_osushi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3701616, "client_id": 3232973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca8beaf9d974e13d6c2d5c16fe5f23bb", "srcset": "https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca8beaf9d974e13d6c2d5c16fe5f23bb, https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27bde3b0c65f815e68ac3adfea50659f 2x, https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e923183ddc82d62061a74b68cbf5672a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9511b2b5de08469fd35cc2db4e0277fd", "srcset": "https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9511b2b5de08469fd35cc2db4e0277fd, https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d814c0ceb581dd004f6292fe77a95058 2x, https://si.imgix.net/181b0abd/uploads/origins/48e10593-9453-4f67-9d71-391bdc322475?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f20096653d7e955a084bdc0cdfed0045 3x"}, "body": "うちゃた様\nはじめまして、はとりと申します。\n\nうちゃた様の描かれるハムスターのもちゅ……としたフォルムがとてもかわいらしく、 優しい色使いも大好きです。\nぜひイラストをお願いできたらと思い、リクエストさせていただきました。\n\n【お願いしたいイラスト】\n・私の飼っているハムスターのイラスト(可能であれば、私との2ショットにしていただけると嬉しいです！)\n\n【ハムスターについて】\n・種類：ジャンガリアンハムスター（イエローライン）女の子\n・背中にくすんだ黄色っぽいラインがうっすらとあります\n・好きなもの：あわ玉、豆腐\n・巣材は綿が好きで、くわえて持って帰ります\n・キャベツはあまり食いつきが良くないです（食べはします)\n\nハムスター＆はとり写真資料\nhttps://drive.google.com/drive/folders/17ncPBz9F2Qcp0wV2McyAE4jsXOTOB-jI?usp=sharing\n\n【私(はとり)について】\n・元気いっぱい、新しいことを知ったり、人と話すことが大好きな性格\n・かわいい鳥や、ハムスター等の小動物、夜の月や星等が好きです。\n・ホラージャンルで活動しています。\n\n【使用用途】\n・各種SNSでの使用\n・YouTubeのサムネイルおよび動画内での使用\n・名刺やポスター等への使用\n・印刷して配布物への使用\n・グッズ制作（※自分用のみで、頒布はいたしません）\n※イラスト使用時に、雰囲気を損なわない範囲で文字入れ等の加工を行う可能性がございます\n\nお忙しいところ恐縮ですが、  ご検討いただけましたら幸いです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17ncPBz9F2Qcp0wV2McyAE4jsXOTOB-jI?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suyasuya_osushi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3701616, "client_id": 3831147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1583247f/uploads/origins/cb6fdb62-7a14-4fee-ace1-9229da605f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d17e68a12c65d4b810248f1eaeb221c7", "srcset": "https://si.imgix.net/1583247f/uploads/origins/cb6fdb62-7a14-4fee-ace1-9229da605f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d17e68a12c65d4b810248f1eaeb221c7, https://si.imgix.net/1583247f/uploads/origins/cb6fdb62-7a14-4fee-ace1-9229da605f39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9749ca31eee3c973dcc31104206d7a2 2x, https://si.imgix.net/1583247f/uploads/origins/cb6fdb62-7a14-4fee-ace1-9229da605f39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=539de99104c5813efb8cd97fac7f8366 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1583247f/uploads/origins/cb6fdb62-7a14-4fee-ace1-9229da605f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4344b759e26cd3909dd31f5946d595d", "srcset": "https://si.imgix.net/1583247f/uploads/origins/cb6fdb62-7a14-4fee-ace1-9229da605f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4344b759e26cd3909dd31f5946d595d, h