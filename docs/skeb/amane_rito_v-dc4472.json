r=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fbf074cefb7cb4134acfd6ee91a5bfd 3x"}, "body": "はじめまして。\n天音りと様の作風が大好きです！\n\n描いていただきたいのは、うちの自創作BLCPです。\nNGはありませんので、自由に描いていただきたいです！\nシチュエーションはえっちなものだと嬉しいです。\nご検討宜しくお願い致します。\n\n\n○セロ：\n謎の多い死霊術師、正体は元創造主。\n機械や魔導具に詳しい男。情報通であり、金次第で売っていたりする。いつもヘラヘラとしており胡散臭い。なんだかんだでお人好し。自分が遡行を繰り返しているのは秘密にしている。\n致命的な料理下手、ヤンデレ属性。少しSっ気あり。\n\n○アサド：\n気づいたら半端な吸血鬼になっていた狐族の男(2つ耳)。\nかなりドライな性格で、そして鈍感。恋愛を理解できていない。目立つのが嫌いで仲間以外の前ではフードを被っている。魔術だけでなく錬金術にも詳しく、暇な時は読書か実験。\n料理上手、ツンデレ属性。獣なので発情期も訪れる。\n\n○関係性：\nセロ(攻め)がアサド(受け)に片想い中。距離感は近い。\n2人とも素直になれない捻くれた性格故に、言い合いや喧嘩はそれなりに多い。半端な吸血鬼であるアサドに血を与えているのはセロ。\nお互いになくてはならない存在。\n\nhttps://drive.google.com/drive/u/0/folders/1Y5ZhYJlZpA891JBEXNgxaRNkPO91IlEM", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amane_rito_v/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2885249, "client_id": 2760195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b2025b5/uploads/origins/08e00fa0-4ece-45c0-82d4-8e932ed1d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de1376188a1f8d3745a6b762e94f50e5", "srcset": "https://si.imgix.net/1b2025b5/uploads/origins/08e00fa0-4ece-45c0-82d4-8e932ed1d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de1376188a1f8d3745a6b762e94f50e5, https://si.imgix.net/1b2025b5/uploads/origins/08e00fa0-4ece-45c0-82d4-8e932ed1d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c364c00ca7a522d5357ba283800a88e5 2x, https://si.imgix.net/1b2025b5/uploads/origins/08e00fa0-4ece-45c0-82d4-8e932ed1d9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79f80a81286eacb31ce285354d6b15d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b2025b5/uploads/origins/08e00fa0-4ece-45c0-82d4-8e932ed1d9d3?bg=%23fff&auto=for