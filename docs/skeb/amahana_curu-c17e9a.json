78ba\u8a8d\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\nhttps://drive.google.com/drive/folders/1oVDWYpYG2LtGrVQKt2qjV1qd0ApJ2WCv\n\n\u3053\u3061\u3089\u306e\u4e2d\u306e\u3001\u30d4\u30f3\u30af\u9aea\u306e\u4e2d\u3067\u3044\u305a\u308c\u304b\u306e\u304a\u597d\u304d\u306a\u59ff\u3092\u66f8\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\uff01\n\n\u7279\u5fb4\u3068\u3057\u3066\n\u30fb\u307e\u3064\u3052\u304c\u304f\u307e\u306e\u5f62\u3092\u3057\u3066\u3044\u307e\u3059\u3002\n\u30fb\u77b3\u5b54\u304c\u30af\u30de\u306e\u5f62\u3067\u3059\u3002\n\u30fb\u6a2a\u9aea\u304c\u30a2\u30b7\u30e1\u3001\u30a4\u30f3\u30ca\u30fc\u30ab\u30e9\u30fc\u304c\u305d\u308c\u305e\u308c\u3042\u308a\u307e\u3059\u3002(\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306f\u30a2\u30b7\u30e1\u306a\u3057)\n\u30fb\u4eba\u9593\u306e\u8033\u306f\u306a\u304f\u3001\u304f\u307e\u307f\u307f\u306e\u307f\u3067\u3059\u3002\n\u30fb\u9aea\u8272\u306b\u3088\u3063\u3066\u8033\u306e\u8272\u30682\u3064\u7d50\u3073\u306e\u30ea\u30dc\u30f3\u306e\u8272\u304c\u9055\u3044\u307e\u3059\u3002\n\u30fb\u307c\u3046\u3057\u3092\u304b\u3076\u3063\u3066\u3044\u307e\u3059(\u767d\u8272\u3001\u3075\u3061\u90e8\u5206\u9ec4\u8272)\n\u30fb\u767d\u306e\u624b\u888b\u3092\u3064\u3051\u3066\u3044\u307e\u3059\u3002\n\n\u500b\u4eba\u306e\u7279\u5fb4\u3068\u3057\u3066\u306f\u3088\u304f\u7b11\u3046\u3001\u7d20\u76f4\u306a\u6027\u683c\u3092\u3057\u3066\u3044\u307e\u3059\u3002\n\u30dd\u30fc\u30ba\u306f\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\u304c\u3001\u982d(\u9aea\u306e\u6bdb)\u306e\u5de6\u53f3\u4e0a\u4e0b\u3067\u898b\u5207\u308c\u3066\u3044\u306a\u3044\u69cb\u56f3\u3067\u3059\u3068\u52a9\u304b\u308a\u307e\u3059\u3002\n\u3082\u3057\u30de\u30a4\u30af\u3092\u6301\u3063\u3066\u3044\u308b\u69cb\u56f3\u306e\u5834\u5408\u306f\u3001\u30de\u30a4\u30af\u6709\u308a\u7121\u3057\u306e\u5dee\u5206\u3092\u3044\u305f\u3060\u3051\u308b\u3068\u52a9\u304b\u308a\u307e\u3059\u3002\n\u96e3\u3057\u3051\u308c\u3070\u30de\u3