SDデータでいただけますと幸いです。\n\n◆キャラクター資料\nhttps://drive.google.com/file/d/1CaOkvuGZu3lLxtDwh_EgyfcxMYezjXy8/view?usp=drive_link\n\n◆使用用途\nYoutubeでのサムネイルやSNSでの宣伝活動に使用予定です。\nアイコンやヘッダーなど活動全般に使用させていただく可能性もございます。\n※Youtubeの収益化後も使用させていただきたく思っております。\n\n上記の内容で問題なければお引け受け頂けますと幸いです。\nお忙しいところ恐れ入りますが、ご検討のほどよろしくお願い申し上げます。\n\nhttps://drive.google.com/file/d/1CaOkvuGZu3lLxtDwh_EgyfcxMYezjXy8/view?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ioTa_af1600/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3861779, "client_id": 3056067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86fe83f2/uploads/origins/c6617270-5c56-40e7-b999-9d315f191162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebcda26d2d79ae0de42aab68254067e", "srcset": "https://si.imgix.net/86fe83f2/uploads/origins/c6617270-5c56-40e7-b999-9d315f191162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ebcda26d2d79ae0de42aab68254067e, https://si.imgix.net/86fe83f2/uploads/origins/c6617270-5c56-40e7-b999-9d315f191162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8fb33b554ab2e8efdac2d5d4c2efa1f 2x, https://si.imgix.net/86fe83f2/uploads/origins/c6617270-5c56-40e7-b999-9d315f191162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d593f5f108078c184e827e490b7bea7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86fe83f2/uploads/origins/c6617270-5c56-40e7-b999-9d315f191162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb0b95fe0fc3ba19d3add7f8cb331e51", "srcset": "https://si.imgix.net/86fe83f2/uploads/origins/c6617270-5c56-40e7-b999-9d315f191162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb0b95fe0fc3ba19d3add7f8cb331e51, h