ient_id": 3050847, "nc": 145}, {"path": "/@megmilch/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3225272, "client_id": 1840874, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b5db50ee3706a342b66ff67c615ea9d4", "srcset": "https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=b5db50ee3706a342b66ff67c615ea9d4, https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2bfb093e4fb0aee090ee82c459c0dc2 2x, https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e4e7dcc17c1a7e88e0a55d608274e52 3x"}, "duration": 16, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c6dae1d6cacfa7ce8c7d41f91c201026", "srcset": "https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c6dae1d6cacfa7ce8c7d41f91c201026, https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74c344b100d6ace0661ef5cd993a0117 2x, https://si.imgix.net/ee97d809/uploads/outputs/cef6f0a9-3cf4-4ffd-a7ac-175a72946c94?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c98c77ae9233734b2416e8538353654 3x"}, "body": "初めまして。\nXでお見かけしたメグミルヒさんのドット絵アニメーションがとても素敵で一目惚れしました。\n全体の雰囲気や色合い、光の表現もとても綺麗で、キャラクターの魅力がぎゅっと詰め込まれた作品がとても好きです。\nドット絵が大好きなので、ぜひ依頼させていただきたいと思いリクエストを送らせていただきました。\n\nこの度ご依頼したいのは私と友人がTRPGを遊ぶために作成した創作キャラクターになります。\n「プルガトリウムの夜」というシナリオで、刑事をしている2人です。\n（資料内にシナリオ内容のネタバレ等はございません。）\n\n✦キャラクター\n①白黒の方\n男 / 172cm / 26歳\n髪色：白・黒 / 瞳の色：赤\nマイペース、楽観的で寂しがり。自己肯定感とコミュ力まあまあ高め。\n中性的な見た目で、外見も中身も自分の可愛さに自信を持ってる。\n班長として部下をまとめる立場にいる。フレンドリーなので友人が多く、班員にも好かれている。\n\n②白赤の方\n男 / 180cm / 24歳\n髪色：白・赤 / 瞳の色：赤・灰色\nヘビースモーカー。世話焼きお人好しで、自分より他人を優先しがち。責任感も正義感も強い。\n無愛想で口数も少なめだが親しい人物からは優しくて面倒見のいい人だと思われている。\n誰に対しても物怖じせず、上司の①に対してもタメ口。\n\n✦関係性等\n警視庁刑事部捜査第一課に所属する刑事で、上司と部下であり相棒。\nお互いを信頼しており唯一無二の大切な存在です。\n\n✦依頼内容\nもし可能であれば、夜・赤色の要素を入れていただけたら嬉しいです。\nメグミルヒさんの世界観がとても好きなため、構図等は全てお任せしたいです。\n服装に関しては二人共資料の立ち絵(通常)と書かれている方でお願いいたします。\n細かい装飾や不明瞭な部分等すべてメグミルヒさんの描きやすいようにしていただけますと幸いです。\n\n✦使用用途\n個人観賞やSNSのヘッダー、もしくはアイコンに使用する場合がございます。\nその際はクレジットを併せて記載させていただきます。\n\n\n金額等不足ありましたら再送要請をお願いいたします。\nご検討いただけますと幸いです。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1jbG0XJ7kFvWvag6CTWseCoHeJiKl2_X_?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@megmilch/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 3225272, "client_id": 3314137, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a17c402/uploads/outputs/b00c817b-8d57-4151-9946-b22660a87819?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=212f64055fb22e8aa75634126ce80092", "srcset": "https://si.imgix.net/2a17c402/uploads/outputs/b00c817b-8d57-4151-9946-b22660a87819?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=212f64055fb22e8aa75634126ce80092, https://si.imgix.net/2a17c402/uploads/outputs/b00c817b-8d57-4151-9946-b22660a87819?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ad1f80352d9aa03af9457f8710deb30 2x, https://si.imgix.net/2a17c402/uploads/outputs/b00c817b-8d57-4151-9946-b22660a87819?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8a876dceb8e60867a85b1ff5de4