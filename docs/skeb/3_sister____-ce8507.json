3d1-4bed-94e4-8cbb2f5356e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f8c10a24ed331a23778196ba55e29a3, https://si.imgix.net/3590df1b/uploads/origins/952386c7-33d1-4bed-94e4-8cbb2f5356e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07dd2112aec9cc17154d65e081c73a6a 2x, https://si.imgix.net/3590df1b/uploads/origins/952386c7-33d1-4bed-94e4-8cbb2f5356e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd6b6321a89e3f1a05e4b7cfcc181f29 3x"}, "body": "黒電話様、はじめまして。\n普段描かれている素敵なイラストに惹かれSkeb依頼させていただきました。不慣れで申し訳ありませんが、何卒よろしくお願いします。\n\n【依頼内容】\nTRPGで使用しているオリジナルキャラクターの二人。主従関係の二人で男女となっています。\n今回は等身イラストでお願いしたいです。\n\n【キャラクター特徴】\n男性（主人）……黒髪ストレート（長さは襟足くらいまでのショート）、ハイライトの無い黒目\n女性（従者）……ウェーブがかった黒髪のショートボブ。丸眼鏡を掛けており、メイド服。ピンクベースの濃い青。首にピンクのリボンを付けている。\n\n【構図】\n従者が主人の首に自分のリボンを付けている様子をイラストにしていただけたらと思います。その際、ほの暗い雰囲気であると嬉しいです！他はお任せしたいと思います。\n\n【画像サイズについて】\n個人で鑑賞するためなのでファイルサイズやキャンパスサイズはお任せします！\n\n長々と失礼しました。何卒、よろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@NasuShinozaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1846103, "client_id": 843972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8527518/uploads/origins/dc75affe-9b3c-4da0-96e1-0110cc41eb2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a17b1bceeefcdaca0f8a85582fbdd510", "srcset": "https://si.imgix.net/a8527518/uploads/origins/dc75affe-9b3c-4da0-96e1-0110cc41eb2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a17b1bceeefcdaca0f8a85582fbdd510, https://si.imgix.net/a8527518/uploads/origins/dc75affe-9b3c-4da0-96e1-0110cc41eb2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5dc0531245b63b7b52c93e56dffd744 2x, https://si.imgix.net/a8527518/uploads/origins/dc75affe-9b3c-