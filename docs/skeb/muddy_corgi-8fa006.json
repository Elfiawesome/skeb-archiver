mgix.net/9a58927f/uploads/origins/65266eca-d4d4-4d12-a706-0ca751425ae2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a6d5f68e87cfc5fbc90ba51ee6dd2f7 3x"}, "body": "こんにちは、リクエストをお願いします。\nスライムが全裸のおっぱいの大きなお姉さんに変身するシークエンスのようなイラストをお願いしたいです\nスライムの塊→変形を始めたスライム→人型のスライム→全裸のお姉さんが微笑んでいる(が、体の末端がスライム状になっている部分がある)、のような変身過程です。\nお姉さんの容姿はお好みでお願いします。また背景なども省略していただいて構いません。\nご一考いただけると助かります。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muddy_corgi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399445, "client_id": 873953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8795c4e16389e70e986221fd48a2de", "srcset": "https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8795c4e16389e70e986221fd48a2de, https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1196e9ecd20c6573efd96dc5f98dbf8f 2x, https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e228732506c8469b0d3ea192ba1d240 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6af42965ea0e18341fb4f29a88893342", "srcset": "https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6af42965ea0e18341fb4f29a88893342, https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=726b403842a555c458ec98b296762795 2x, https://si.imgix.net/5d7928b7/uploads/origins/418f867f-95a1-41a4-90f6-b480f7f015cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9004b958c5f604119dd912e88cd2865e 3x"}, "body": "メトロイドのサムス・アランに変身するメタモンをお願いしたいです。ストーリーの文脈として、サムスは開くと彼女に変身するメタモンが入ったモンスターボールを見つけます。複数のメタモンが融合して新しい形態を作成したかのように、複数のメタモンの顔が彼女の体に表示されると幸いです。メタモンはサムスの通常の青色ではなく、紫のゼロスーツを着ることができます。体、髪、服、肌の色はスライムのように陰影をつけることができます。サムスはメタモンに恥ずかしがり、サムス姿のメタモンはエッチな表情を浮かべている。\n参考資料のリンク:\nhttps://www.pixiv.net/en/artworks/67341295\nhttps://www.pixiv.net/en/artworks/91559306\nhttps://www.pixiv.net/en/artworks/100349354\nhttps://www.pixiv.net/en/artworks/101195603", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muddy_corgi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399445, "client_id": 3058585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1a50700b7c6d1b83d9a4a708e094ebf", "srcset": "https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1a50700b7c6d1b83d9a4a708e094ebf, https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2201cd8823db0864888a022ce7b267b6 2x, https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4165242e8014a46ac5886643a74d0e83 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db00b9834e1c2a83c94bdcc87a84364f", "srcset": "https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db00b9834e1c2a83c94bdcc87a84364f, https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a422d97a32a5ff46035dfbd7670fe43 2x, https://si.imgix.net/55040781/uploads/origins/d37bfb67-67f5-4984-be8f-15ed81f5fdfb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24adb4b7235e8fe350752064bd6a67ed 3x"}, "body": "こんにちは！\n\nミヤマオーがモネに、自分には真似できないと思っていると言うシチュエーションをリクエストしたいです（エデンの『リッター・グレンツェ』より）。\n\nモネはその挑戦を受け、変身を始める。\n彼女の体の一部が不揃いに成長し、変化し、不自然に新しい形になる。\nこの間、ミヤマオは少し驚いた表情を浮かべる。\n\nモネの変身が終わると、外見も性格もまるで同じミヤマオが二人いるようだ。\n本物のミヤマオは歌姫のように部分的に負けを認めるが、引き下がらない。もう一人のミヤマオ（モネ）は、「なんで私が本物じゃないと思うのよ」的なリアクションをする。\nまた、モネの胸が大きくなったため、片方の胸が押し合う。\n\nだから、事実上3段階になる。全身で見られるといいですね。\n\nミヤマオのバージョンはこちら（タンクなし）でお願いします。\nhttps://edensgrenze.wikiru.jp/?ドン・ミャマーオ\nhttps://edensgrenze.wikiru.jp/?モネ\n\nありがとうございました！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muddy_corgi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399445, "client_id": 410142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b24879101aeb6849b13e2f65a724192d", "srcset": "https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b24879101aeb6849b13e2f65a724192d, https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fc2e46cfc3da80304cdd2748f85df4b 2x, https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef20edd1aed1f4a373cb9684930c710a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b62c1ab27e2bb7ddaf3bcc628f1030a", "srcset": "https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b62c1ab27e2bb7ddaf3bcc628f1030a, https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e5b54c0bd5fa36f7b449519d0ad4b9d 2x, https://si.imgix.net/197843bc/uploads/origins/b568d111-f693-4b4d-80f6-f4149e4c6445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9e62013c81adfcfc7a85a8e4cdc7d5f 3x"}, "body": "初めまして、メタモンに関する内容をリクエストしたいです。\n人物はメタモンが変身したカミツレおよび本人のフウロです。コスチュームはBW2ではなくBWのコスチュームです。\nメタモンが変身したカミツレは背後からフウロに襲撃した。耳両端の電線はロープのようにフウロに縛り付けて、電線の端の部分は手に成りすまして、片手にフウロのおっぱいを揉め、片手はフウロの口を封じる。カミツレの変身はまだ未完成のところがあるけど（粘液部分あり）、おっぱいはフウロの巨乳みたいに大きくなった。\n少し複雑ですけど、よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muddy_corgi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3399445, "client_id": 208287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.ne