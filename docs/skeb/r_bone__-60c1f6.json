4eca\u5f8ccolorsing\u3067\u6d3b\u52d5\u4e88\u5b9a\u3042\u308a)\u3092\u3057\u3066\u3044\u308b\u82b1\u691b\u97f3\u307f\u3044\u308b\u3068\u7533\u3057\u307e\u3059\u3002\nX\u3067\u9ed2\u90fd\u3092\u3053\u3081\u69d8\u306e\u30a4\u30e9\u30b9\u30c8\u306b\u4e00\u76ee\u60da\u308c\u3057\u3066\u3054\u9023\u7d61\u3055\u305b\u3066\u9802\u304d\u307e\u3057\u305f\u3002\n\n\u300a\u4f7f\u7528\u7528\u9014\u300b\n\u30fbSNS\u30a2\u30a4\u30b3\u30f3(X,colorsing,YouTube)\n\u30fbcolorsing\u306e\u914d\u4fe1\u753b\u9762\n\u30fb\u8fd4\u793c\u54c1(\u753b\u50cf,\u30b0\u30c3\u30ba)\u203b\u975e\u5546\u7528\n\u4ee5\u4e0b\u3001\u73fe\u6642\u70b9\u3067\u78ba\u5b9a\u3057\u3066\u307e\u305b\u3093\u304c\u3001\u4eca\u5f8c\u4f7f\u7528\u3059\u308b\u53ef\u80fd\u6027\u3042\u308a\n\u30fb\u30b0\u30c3\u30ba\u8ca9\u58f2\uff08\u5546\u7528\u5229\u7528\uff09\n\n\u300a\u753b\u50cf\u30b5\u30a4\u30ba\u300b\n\u30fb\u643a\u5e2f\u306e\u58c1\u7d19\u30b5\u30a4\u30ba\n   19.5\u00d79(1179\u00d72556px)\n\n\u300a\u69cb\u56f3\uff65\u30dd\u30fc\u30ba \u300b\n\u30fb\u30dd\u30fc\u30ba\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\n\u30fb\u4eba\u7269\u306f\u4e2d\u592e\u306b\u304a\u9858\u3044\u3057\u307e\u3059\n\u30fb\u305d\u306e\u4ed6\u69cb\u56f3\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\u304c\u3001\u82b1\u691b\u97f3\u307f\u3044\u308b\u306e\u30e2\u30c1\u30fc\u30d5\u3084\u597d\u304d\u306a\u7269\u304c\u305f\u304f\u3055\u3093\u8a70\u3081\u8fbc\u307e\u308c\u305f\u753b\u50cf\u306b\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\n\n\u300a\u4eba\u7269\u300b\n\u30fb\u8868\u60c5 : \u304a\u4efb\u305b\u3057\u307e\u3059\n\u30fb\u9aea\u578b : \u7de9\u3044\u30d1\u30fc\u30de\u306e\u304b\u304b\u3063\u305f\u30ed\u30f3\u30b0\u30d8\u30a2(\u9aea\u306f\u7e1b\u3063\u3066\u306a\u3044)\n\u30fb\u9aea\u8272 : \u8584\u3044\u304f\u3059\u3093\u3060\u30d4\u30f3\u30af \u3068 \u8584\u3044\u30aa\u30ec\u30f3\u30b8 (\u8272\u306e\u914d\u7f6e\u306f\u304a\u4efb\u305b\u3057\u307e\u3059)\n\u30fb\u76ee\u306e\u8272 : \u5de6\u76ee \u8d64\u301c\u30aa\u30ec\u30f3\u30b8\u3001\u53f3\u76ee \u7d2b\n\u30fb\u53e3\u306e\u8272 : \u7d2b\n\u30fb\u670d\u88c5 : \u666e\u6bb5\u4f7f\u7528\u3057\u3066\u3044\u308b\u30a2\u30d0\u30bf\u30fc\u753b\u50cf\u304c\u8cc7\u6599URL\u306b\u3042\u308a\u307e\u3059(\u8d64\u3044\u7fbd\u7e54\u3001\u30aa\u30ec\u30f3\u30b8\u306e\u30b9\u30ab\u30fc\u30c8\u3001\u767d\u306e\u30a8\u30d7\u30ed\u30f3\u3001\u8336\u8272\u306e\u30ea\u30dc\u30f3\u3001\u304a\u82b1\u30e2\u30c1\u30fc\u30d5\u306e\u5c0f\u7269)\u3002\u305d\u3061\u3089\u3092\u53c2\u7167\u3057\u3066\u3044\u305f\u3060\u304d\u3064\u3064\u3001\u3092\u3053\u3081\u69d8\u306e\u4e16\u754c\u89b3\u3092\u51fa\u3057\u3066\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u601d\u3044\u307e\u3059\u3002\n\u30fb\u305d\u306e\u4ed6 : \u982d\u4e0a\u306b\u5927\u304d\u3044\u30ea\u30dc\u30f3(\u30aa\u30ec\u30f3\u30b8\u8272)\n\n\u300a\u82b1\u691b\u97f3 \u307f\u3044\u308b \u306b\u3064\u3044\u3066\u300b\n\u30fb\u540d\u524d\u306f\u304a\u82b1\u306e\u30ab\u30e2\u30df\u30fc\u30eb\u3068\u691b(\u3082\u307f\u3058)\u304c\u7531\u6765\n\u30fb\u30a4\u30e1\u30fc\u30b8\u30ab\u30e9\u30fc : \u30aa\u30ec\u30f3\u30b8(#FF9321)\n\u30fb\u4e3b\u306b\u6b4c\u914d\u4fe1\n\n\u300a\u597d\u304d\u306a\u7269(\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3082\u306e)\u300b\n\u30fb\u30ab\u30e2\u30df\u30fc\u30eb\n\u30fb\u691b(\u3082\u307f\u3058)\n\u30fb\u304a\u82b1\n\u30fb\u597d\u304d\u306a\u8272 : \u8336\u8272\u3001\u30aa\u30ec\u30f3\u30b8\n\u30fb\u97f3\u697d(\u6b4c\u3001\u6f14\u594f\u3067\u304d\u308b\u697d\u5668\u2192\u30d4\u30a2\u30ce\u3001\u30d5\u30eb\u30fc\u30c8\u3001\u30ae\u30bf\u30fc\u3001\u30ab\u30ea\u30f3\u30d0)\n\u30fb\u732b\n\u30fb\u672c\n\u30fb\u7de8\u307f\u7269(\u6bdb\u7cf8)\u3001\u30ec\u30fc\u30b9\n\u203b\u4e0a\u304b\u3089\u512a\u5148\u9806\u4f4d\u304c\u9ad8\u3044\u3082\u306e\u3067\u3059\u3002\u7121\u7406\u306e\u306a\u3044\u7bc4\u56f2\u3067\u63cf\u3051\u308b\u3082\u306e\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\u30ab\u30e2\u30df\u30fc\u30eb\u3068\u691b\u306f\u30de\u30b9\u30c8\u3067\u63cf