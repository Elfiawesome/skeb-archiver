料不足や、金額や内容に見合わないところがあれば再送請求、キャンセルをしていただければと思います。\n\nhttps://drive.google.com/drive/folders/1-AylJc_3SBBKP4gcluQOnwn5Zjg_QhRB", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kisetsuiro387/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1975013, "client_id": 2307799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a3-431d-a539-90533f027199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=478442f8b4cab2e0bf3b22ff515e4a72", "srcset": "https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a3-431d-a539-90533f027199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=478442f8b4cab2e0bf3b22ff515e4a72, https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a3-431d-a539-90533f027199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d1282974a35d5e0f676bb89da0ba1bf 2x, https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a3-431d-a539-90533f027199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ca0e974824b9305333f2afe4f0adc8d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a3-431d-a539-90533f027199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=642724de616b1e1cd1b0d38dddd16ee4", "srcset": "https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a3-431d-a539-90533f027199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=642724de616b1e1cd1b0d38dddd16ee4, https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a3-431d-a539-90533f027199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=989e6045cc5edc8d20be37fe794f351a 2x, https://si.imgix.net/4d341651/uploads/origins/8e018be7-88a