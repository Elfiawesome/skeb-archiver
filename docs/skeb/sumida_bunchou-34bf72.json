cce/uploads/origins/e86645ad-9245-46a1-99b1-137e49b87f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3382a1b20d1c07374021ffd6a8d3e776 3x"}, "body": "こんにちは！\n前回は素晴らしい深沙希さんをありがとうございました。\nまた依頼したいと思っていた所、募集再開されたとの事でまたリクエストさせて頂きました。\n\n前回とても良かったため、今回描いて頂きたいキャラもアリスギアアイギスの籠目深沙希となります。\n今回の服装は資料URLを参照してください。\nシチュエーションとしては、運動後のたくし上げブラ露出をお願いします。\n以前描かれていた↓のシチュエーションのイメージです。\nhttps://www.pixiv.net/artworks/126846115\n大変お手数ですがブラ無し差分も付けて頂けると嬉しいです。\n\nお忙しいとは思いますがもし大丈夫でしたらよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1kg-tEES6a9VUhZix6-qQjEMxQqJclh12", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumida_bunchou/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3453311, "client_id": 2091964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50518074724b7202fb55402023ddc952", "srcset": "https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50518074724b7202fb55402023ddc952, https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5c2125234edcebbe6c7cd509a599a68 2x, https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ce97e99a76334c84f9804a26bd224ef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=203f804965d5dc4107b59f946ae7cd17", "srcset": "https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=203f804965d5dc4107b59f946ae7cd17, https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3ea845cfc8843fac32b2f5522c1fec3 2x, https://si.imgix.net/d3e528ad/uploads/origins/ecccc266-103a-4e74-8c2b-beae170b2604?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dae13595903743b9ef32ef760c7d37e7 3x"}, "body": "こんにちは。\nいつも素敵なイラストありがとうございます。\n\nアッシュアームズのme262シュヴァルベをお願いできますでしょうか？\nhttps://wiki.biligame.com/hjzx/Me262A-1a_%E9%9B%A8%E7%87%95\n\n衣装はこちらでお願いします。細部や装飾は省略いただいて大丈夫です。\nhttps://wiki.biligame.com/hjzx/Me262A-1a_%E9%9B%A8%E7%87%95#/media/%E6%96%87%E4%BB%B6:ARM20750101_Normal.png\n\nシチュは前を開けてブラ露出→ブラをたくし上げて胸がブルンと露出するといった感じです。\nまた、胸と乳輪は大きめでお願いします。以前に先生が描かれた臨戦リオぐらいのイメージです。\n\n以上、ご検討のほどよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumida_bunchou/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3453311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf9fa4c9bb1132903ca2fe2d6162d3d4", "srcset": "https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf9fa4c9bb1132903ca2fe2d6162d3d4, https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3a0119715571dcdaeec01ed8b920886 2x, https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=610c6ab03c7f07ecedb9608ca9bb1ae4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62e4fc250ecd5b9220109d6c8498777e", "srcset": "https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62e4fc250ecd5b9220109d6c8498777e, https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f922541d241ead5ee732ed645b10666 2x, https://si.imgix.net/9880592f/uploads/origins/d4fc3c2f-a1ac-4fdc-afa1-1f00fd1f3bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72fe9312c44d34e9acd2cd918a8b69c2 3x"}, "body": "すみだ様。\nいつもお世話になっております。\n先程はキャンセル失礼致しました。再び依頼をさせて頂きます。\n\n御城プロジェクトのアーケシュフース城をお願い致します。\n\n衣装は公式のものでも、それ以外のものでも差し支えありません。\n総レースのデカブラがまろび出る構図をお願い致します。\n爆乳ムチムチに仕立てて頂ければ幸甚に存じます。\n\nご検討宜しくお願い致します。\n\nhttps://imgur.com/a/Cwhbvor", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumida_bunchou/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3453311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44deda94/uploads/origins/bd80edb2-2c72-4e29-b13a-d90310ae68a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=551c20309a11809f607b6be2fde50861", "srcset": "https://si.imgix.net/44deda94/uploads/origins/bd80edb2-2c72-4e29-b13a-d90310ae68a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=551c20309a11809f607b6be2fde50861, https://si.imgix.net/44deda94/uploads/origins/bd80edb2-2c72