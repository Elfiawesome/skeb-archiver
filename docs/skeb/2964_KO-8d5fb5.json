x.net/4c27a241/uploads/origins/4d704535-e807-4bbf-b1b9-83d98bcb6e96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=803541f450cd641a6aaededa72c8725b", "srcset": "https://si.imgix.net/4c27a241/uploads/origins/4d704535-e807-4bbf-b1b9-83d98bcb6e96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=803541f450cd641a6aaededa72c8725b, https://si.imgix.net/4c27a241/uploads/origins/4d704535-e807-4bbf-b1b9-83d98bcb6e96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19710c8e9951db6367431e98ed5efecf 2x, https://si.imgix.net/4c27a241/uploads/origins/4d704535-e807-4bbf-b1b9-83d98bcb6e96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7715b2fbe2bf30227e355d96efb31709 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1801440, "client_id": 2081297, "nc": 129}, {"path": "/@2964_KO/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1801440, "client_id": 3173372, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c6beeefdef590faa69d92150e70e90e", "srcset": "https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c6beeefdef590faa69d92150e70e90e, https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2d7a86ab371a6d69b162251f9106b25 2x, https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb5b348844f14e401265f357d698b86f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19a40caa3b0b613df24a523e73cafff6", "srcset": "https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19a40caa3b0b613df24a523e73cafff6, https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ed8d7556f612a6fe5e4e51f85e601e4 2x, https://si.imgix.net/6369b4c8/uploads/origins/e23d01bf-7c13-43f7-b951-20d6421f64da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b57a1a1ce8610041f244bce89467300f 3x"}, "body": "初めまして、読点と申します。\n4,5年前にTwitterでおくさんの創作をお見かけし、そこからおくさんの絵柄や作品に惹かれました。今回初めてskeb依頼をさせていただきます。\n\n・要望\n自創作の「飛梅(とびうめ)」というキャラクターを描いていただきたいです。\nポーズや構図はお任せします。\n\n・世界観\n人間と人ならざる八十神族（やそがみぞく）が共存する江戸時代の地方のとある田舎が舞台。\n人間と八十神族は、過去に幾度か土地争いで戦をし、多大なる被害を受け死傷者を出した。人々の間にアニミズムは当たり前にある。八十神族の発端は誰も知らないが、八十神族の草花木統括最高上位者の「道桜（どうおう）」と、道桜に直属で仕える「四君子（しくんし）」と呼ばれる四柱のみ知っている。\n⚪︎八十神族について\n草花木統括部、百獣統括部、大地統括部の三つに分類される。死ぬことはあるが、大地統括部の特権により、各部の特性に適合した期間を経て同位体で輪廻する。飛梅は草花木統括部にいる。\n\n⚪︎飛梅の詳細\n性別:男\n身長:167cm\n見た目年齢26歳くらい\n先代「四君子」梅の 梅魁(ばいかい)の死後、生まれてきた後継者。本来、八十神族は死後輪廻する際に記憶や能力や性格など全て引き継がれるのに対し、飛梅は能力のみ引き継ぎ輪廻し生まれてきた。\n不安定な存在ゆえに、同じ「四君子」の薫竹の臣下に置かれ監視されていた。監視目的だったとはいえ、薫竹と飛梅は非常に良い主従関係を築いた。\nしかし、停戦状態だった人間との争いが始まり、薫竹は戦死してしまう。「このままでは薫竹の首を取られかねない」と判断した飛梅は薫竹を抱え雨上がりでぬかるんだ山を駆け降り小さな洞穴に2日ほど身を潜めた。2日間飲まず食わずで、目の前で主人が朽ちていく様子を目にし精神的にもダメージを負った。という過去があります。\n芋焼酎が好きで、肉が嫌い。\n\n・使用用途\n頂いたイラストは鑑賞、もしくはiPadやスマートフォンの壁紙に使用したいと思っています。\n\n内容が合わなければキャンセルしていただいて大丈夫です。\nskebでの依頼はこれが初めてなので不備や不適切な点がありましたら申し訳ないです。\nお忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://x.com/hpp0f/status/1766133016953573573?s=46&t=91uW2hx6l2kiTUNFg27TYA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2964_KO/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1801440, "client_id": 1421963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c278b5fc/uploads/origins/403930b7-eeb3-465e-b919-c40596e3fcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05b2997a7ec3f4b2c81757a8569dd956", "srcset": "https://si.imgix.net/c278b5fc/uploads/origins/403930b7-eeb3-465e-b919-c40596e3fcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05b2997a7ec3f4b2c81757a8569dd956, https://si.imgix.net/c278b5fc/uploads/origins/403930b7-eeb3-465e-b919-c40596e3fcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=242bf89956f8c620332fc5da60ec80c5 2x, https://si.imgix.net/c278b5fc/uploads/origins/403930b7-eeb3-465e-b919-c40596e3fcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5405aaa78177d65f0b7b2e04bc359e78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c278b5fc/uploads/origins/403930b7-eeb3-465e-b919-c40596e3fcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=179c0650b0d2b56647ca7f6d4a630dac", "srcset": "https://si.imgix.net/c278b5fc/uploads/origins/403930b7-eeb3-465e-b919-c40596e3fcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=179c0650b0d2b56647ca7f6d4a630dac, https://si.imgix.net/c278b5fc/uploads/origins/403930b7-eeb3-465e-b919-c40596e3fcb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w