b49/uploads/origins/8eb3f68c-e38b-4c58-923f-730e766533ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7262c952ef7bd14fd7818e397d56cde7", "srcset": "https://si.imgix.net/9c005b49/uploads/origins/8eb3f68c-e38b-4c58-923f-730e766533ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7262c952ef7bd14fd7818e397d56cde7, https://si.imgix.net/9c005b49/uploads/origins/8eb3f68c-e38b-4c58-923f-730e766533ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=145cf49d42ff11f601ed1fad7db3d900 2x, https://si.imgix.net/9c005b49/uploads/origins/8eb3f68c-e38b-4c58-923f-730e766533ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5abb78df99d3100f6e6cca425347c962 3x"}, "body": "こんにちは、ネネと申します。\n初めて拝見した時からおくさんのイラストが非常に魅力的で\nこの度skeb依頼をさせて頂きました。\n\n・描いて欲しいもの:（ocキャラ）\n 滅びた地球に残った遺跡や文明を観光気分で渡り歩く二人の宇宙人\n\n・設定: ある日地球に何百と落ちた隕石から宇宙人が数多出現した。彼らは同じ親から生まれた兄弟であったが、最後の二人になるまで地球を巻き込んだ苛烈な兄弟殺しを始める。兄弟 文明 生命全てを破壊尽くし最後の二人になった宇宙人は互いをパートナー（二人に雄雌はない）として新たな命を次なる星に、何百という流星にして流した。地球に残った二人の余命はあと7日、後は死を待つのみという片割れに対し もう片方は言った\n「観光しようよ！！」\n設定2:  宇宙人は兄弟ですが全員外見が違う設定で どれも戦闘特化の見た目をしています。観光したいと言い出した方は元気な性格で背がひょろ高い男性型（身長2m） メカっぽい外見。子供の声で話す。地球の物に詳しい（つもり）\nもう片方→性格は人の心が分からないメカのような感じ、体には蜂の羽が生えており体型は女性のように見えるが 男性の低い声で話す（身長182cm）低い声で これはなんだ なぜだ なぜそう思う  と背の高い方と問答している時もある。\nはっきりした彼らの容姿は決めておりませんでしたので後はおくさんのお好きな様にして頂いてもよろしいでしょうか…\n・使用用途\n頂いたイラストはスマホの壁紙や 個人で鑑賞する為に使用したいと思っています。以上、ご都合宜しければお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2964_KO/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1801440, "client_id": 3307198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/283daa28/uploads/origins/d38c9ebe-e693-497a-be6f-db729262847a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f87a6f8705367863c88fa33c5f275f2", "srcset"