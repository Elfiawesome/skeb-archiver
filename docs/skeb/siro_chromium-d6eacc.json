なので、同じ構図でタイツ部分のみ無しか、タイツ部分と服装部分が無しで肌が見える差分（PSD形式でON・OFFできる）を描いていただけるととても嬉しいです。肌が見える差分でも性器は極小下着やマイクロビキニなどで隠してもらえるとありがたいです。お尻の穴はそのままでもOKです。\n\n[その他]\n・キャラの頭身や体型は、白黒だるまさんが描きやすい頭身や体型に変更していただいて構いません。\n・3D人形のポーズをベースにしてポーズの細部（手や脚の位置、持ち物の有無など）はお好みで変更していただいて構いません。\n・どちらのポーズもタイツ上に性器のすじが描写されていると嬉しいです。\n\n興味が湧きましたら描いていただけると幸いです。\n\nhttps://1drv.ms/f/s!Au6znWZjfIOKg_suargVYE0yvkdspg?e=XGwThs", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@siro_chromium/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3581018, "client_id": 3350034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e9a839e/uploads/origins/0c0b5262-2c13-4602-a309-c355d48bac26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a064fe4048decf946ee7af699af6916", "srcset": "https://si.imgix.net/7e9a839e/uploads/origins/0c0b5262-2c13-4602-a309-c355d48bac26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a064fe4048decf946ee7af699af6916, https://si.imgix.net/7e9a839e/uploads/origins/0c0b5262-2c13-4602-a309-c355d48bac26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21b9620cf2f7b0385732ac47c2049c13 2x, https://si.imgix.net/7e9a839e/uploads/origins/0c0b5262-2c13-4602-a309-c355d48bac26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c785a21b1e088852b9542693bf32923f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e9a839e/uploads/origins/0c0b5262-2c13-4602-a309-c355d48bac26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c643a333fc768bc42f3a050463516bf7", "srcset": "https://si.imgix.net/7e9a839e/uploads/origins/0c0b5262-2c13-4602-a309-c355d48bac26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c643a333fc768bc42f3a050463516bf7, https://si.