した。\nうちの子をモチーフにした「作業配信」という字のロゴを作って頂きたいです。\n\n使用範囲：\nTwitchで作業配信をします、そのときの開始のおしらせツイートに使うことがあります。\n横長のサムネイルとして、イラストと合成して使用したいです。\n\n色合いのイメージ：\nピンクやオレンジなど、キャラに似合った雰囲気のもの？おまかせします。\n肉球や、尻尾の要素が似合いそうであれば、入れて頂けると嬉しいです。\n\nhttps://drive.google.com/file/d/1CmqqcLAePgr0cNGRVetBiqsHUmW85mTD/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kana_vdesigner/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758392, "client_id": 3609700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ed099db/uploads/origins/c055db5a-aa57-44c6-8320-da2e1f874a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e051ee6905a1ff53963c4cfac3f9d9cb", "srcset": "https://si.imgix.net/9ed099db/uploads/origins/c055db5a-aa57-44c6-8320-da2e1f874a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e051ee6905a1ff53963c4cfac3f9d9cb, https://si.imgix.net/9ed099db/uploads/origins/c055db5a-aa57-44c6-8320-da2e1f874a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9a228daa852557be280a2e60e602755 2x, https://si.imgix.net/9ed099db/uploads/origins/c055db5a-aa57-44c6-8320-da2e1f874a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da7115d6c5b4c220c3a16337bff364aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ed099db/uploads/origins/c055db5a-aa57-44c6-8320-da2e1f874a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d9f01f320bcd89a2f617624ffbf912", "srcset": "https://si.imgix.net/9ed099db/uploads/origins/c055db5a-aa57-44c6-8320-da2e1f874a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d9f01f320bcd89a2f617624ffbf912, https://si.imgix.net/9ed099db/uploads/origins/c055db5a-aa57-44c6-8320-da2e1f874a18?bg=%23fff&a