b\u3001\n\u3068\u3044\u3046\u8a2d\u5b9a\u306e\u9b54\u6cd5\u5c11\u5973\u3054\u3063\u3053\u3002\n\n\u3010\u8a73\u7d30\u3011\n\u53ef\u80fd\u306a\u7bc4\u56f2\u3067\u3001\u4e0b\u8a18\u306e\u3088\u3046\u306a\u5c55\u958b\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n(\u9069\u5b9c\u6539\u5909\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059)\n\n\u30fb\u30ea\u30dc\u30f3\u7b49\u3067\u8efd\u304f\u62d8\u675f\u3055\u308c\u3066\u3044\u308b\u30d2\u30ca\u30bf\u3061\u3083\u3093\u3002\n\u30fb\u300c\u79c1\u306e\u30da\u30c3\u30c8\u306b\u306a\u308a\u306a\u3055\u3044\u2661\u300d\u3068\u8a98\u3046\u5973\u5e79\u90e8(\u304a\u59c9\u3055\u3093)\u3068\u3001\n\u3000\u300c\u9b54\u6cd5\u5c11\u5973\u306f\u60aa\u306b\u5c48\u3057\u307e\u305b\u3093\uff01\u300d\u3068\u62d2\u5426\u3059\u308b\u9b54\u6cd5\u5c11\u5973(\u30d2\u30ca\u30bf\u3061\u3083\u3093)\u3002\n\u30fb\"\u670d\u5f93\u306e\u5100\u5f0f\"\u3067\u9b54\u6cd5\u5c11\u5973\u3092\u5815\u3068\u3057\u306b\u304b\u304b\u308b\u5973\u5e79\u90e8\u3002\n\u3000\u30c1\u30e7\u30b3\u30da\u30f3\u3067\u30d2\u30ca\u30bf\u3061\u3083\u3093\u306e\u4e0b\u8179\u90e8\u306b\u30cf\u30fc\u30c8\u306e\u7d0b\u7ae0(\u6deb\u7d0b\u307d\u3044\u7d0b\u7ae0)\u3092\u63cf\u304d\u3001\n\u3000\u30d5\u30eb\u30fc\u30c4\u7b49\u3067\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u3059\u308b\u3002\n\u3000\u300c\u3044\u305f\u3060\u304d\u307e\u3059\u2661\u300d\n\u3000\u8eab\u4f53\u3092\u8caa\u3089\u308c\u305f\u9b54\u6cd5\u5c11\u5973\u306f\u3001\u3042\u3063\u3051\u306a\u304f\u9665\u843d\u3059\u308b\u3002\n\u30fb\u88f8\u306b\u9996\u8f2a\u3068\u732b\u8033\u3092\u7740\u3051\u3089\u308c\u3001\u30da\u30c3\u30c8\u306b\u5815\u3061\u305f\u9b54\u6cd5\u5c11\u5973(\u30d2\u30ca\u30bf\u3061\u3083\u3093)\u3002\n\u3000\u5973\u5e79\u90e8(\u304a\u59c9\u3055\u3093)\u306f\u3001\u81ea\u8eab\u306e\u8eab\u4f53\u306b\u5782\u3089\u3057\u305f\u8702\u871c(or\u30af\u30ea\u30fc\u30e0)\u3092\u30da\u30c3\u30c8\u306b\u8210\u3081\u3068\u3089\u305b\u308b\u3002\n\u30fb\u300c\u3044\u3044\u5b50\u3001\u3044\