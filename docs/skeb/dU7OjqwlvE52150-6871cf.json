": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dU7OjqwlvE52150/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3931502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=736302ba28465866c804c130a5fd441f", "srcset": "https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=736302ba28465866c804c130a5fd441f, https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43183652e2cf7f4c14115b4f604e72b5 2x, https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c551aa3e6b9dc7f0b8286ae7bb2be3ad 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90408214307aba1f98f5201cf54bb823", "srcset": "https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90408214307aba1f98f5201cf54bb823, https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0cab3665162387203cf399bea70bbff 2x, https://si.imgix.net/945c69d5/uploads/origins/8732743d-5a94-4225-8d41-03256c4ee05e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30c14c85bd6f8b30810d585c3143cd94 3x"}, "body": "あき先生、こんにちは！また失礼します！\n前回に続いてすぐのリクエストになってしまい、すみません…\n\n先日描いていただいたうちの子が本当に可愛くて、毎日見返すたびにどんどん好きになっています…！もしよろしければ、わがままで恐縮ですが、今回もリクエストさせていただけますと幸いです…！\n\n今回は前回の続きで、例のビキニ姿でカメラの前でポーズをとっているシーンをお願いできたら嬉しいです\n雰囲気は、明るい撮影会風でも、少し落ち着いた室内での動画撮影（監督やパ◯活のお客さんからのリクエスト、というイメージ）でも、先生のお好きな雰囲気でお任せできればと思います！\n\nポーズや構図も先生にお任せできればと思います\nエ◯かわいい雰囲気で、肌の露出やおへそが見える感じ、ビキニが少しきつめで体のラインが強調されている表現、下のラインがうっすら分かるような感じもあると嬉しいです。\nもし可能でしたら、前回同様にランドセルも併せて描いていただけると嬉しいです。ベレー帽は今回はなくても大丈夫です\n\nまた、監督やパパさんからポーズの指示をされて、それに対して「うん」などと答えているようなやり取りも添えていただけると嬉しいです！先生のセリフが最高なので、内容はお任せでも大丈夫です！少し不安そうな表情ながらも、嫌な顔を見せないようにこらえている感じだとありがたいです。\n\nうちの子https://www.deviantart.com/stash/0hk7acmi57a\nhttps://skeb.jp/@dU7OjqwlvE52150/works/2\n\n短い間に続けてのお願いになってしまい恐縮ですが、ご検討いただけますと幸いです\nまたよろしくお願いいたします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dU7OjqwlvE52150/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c5e3ca05/uploads/origins/6917a485-e856-4c46-a353-aabc1946e9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8eb0c4c27b6b12bf20db16a870aa29ac", "srcset": "https://si.imgix.net/c5e3ca05/uploads/origins/6917a485-e856-4c46-a353-aabc1946e9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8eb0c4c27b6b12bf20db16a870aa29ac, https://si.imgix.net/c5e3ca05/uploads/origins/6917a485-e856-4c46-a353-aabc1946e9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20bc0b2c80b0fe641d66777d611b1bde 2x, https://si.imgix.net/c5e3ca05/uploads/origins/6917a485-e856-4c46-a353-aabc1946e9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txta