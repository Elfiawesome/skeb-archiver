。元の衣装に沿った物でも全く違う物でも、どちらでも構いません。\n\nhttps://www.dropbox.com/sh/ufh70pns4d1gk5x/AAAGsbrKt--kFAGoAUD3AUSRa?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jan_husaren/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1342059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b9ac87a77e03b4782eafe3a02075ebf", "srcset": "https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b9ac87a77e03b4782eafe3a02075ebf, https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bbffab8356c2ea86e97279bfc4d788e 2x, https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c4f4e169582be8897fc9b16a62a088c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdb271ee29fdaed9687746825a680e01", "srcset": "https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdb271ee29fdaed9687746825a680e01, https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15ac75af18733c5eeab8fc7c5072a3bb 2x, https://si.imgix.net/b645109f/uploads/origins/b1336873-ceeb-47c9-bd73-513abe2c423e?bg=%23fff&auto=fo