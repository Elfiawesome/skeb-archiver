u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059...\uff01\uff01\n\n\u25a0\u30ad\u30e3\u30e9\u30af\u30bf\u30fc:\u8cc7\u6599\u2460,\u2461\u306b\u3042\u308a\u307e\u3059\u30aa\u30ea\u30b8\u30ca\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\n\u25a0\u670d\u88c5:\u8cc7\u6599\u2462,\u2463\u306b\u3042\u308a\u307e\u3059\u3001\u300c\u305a\u3093\u3060\u3082\u3093\u300d\u306e\u670d\u88c5\u3092\u7740\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059!\n\u305f\u3060\u3001\u8db3\u306f\u9732\u51fa\u3092\u63a7\u3048\u305f\u3044\u305f\u3081\u3001\u2460,\u2461\u8cc7\u6599\u306e\u3088\u3046\u306a\u767d\u30bf\u30a4\u30c4\u3092\u5c65\u304b\u305b\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3067\u3057\u3087\u3046\u304b\uff1f\n\u307e\u305f\u89d2\u306e\u90e8\u5206\u306f\u30ab\u30c1\u30e5\u30fc\u30b7\u30e3\u3092\u4ed8\u3051\u3066\u751f\u3084\u3057\u3066\u3044\u308b\u8868\u73fe\u3067\u3001\n\u5f8c\u308d\u9aea(\u30c6\u30fc\u30eb\u90e8\u5206)\u306e\u63cf\u5199\u306f\u7121\u3057\u3067\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059...!\n\u25a0\u4f7f\u7528\u7528\u9014:\u5404\u7a2eSNS\u306e\u6295\u7a3f\u7528\u306e\u7d20\u6750\u7b49\u3078\u306e\u4f7f\u7528\u3092\u8003\u3048\u3066\u304a\u308a\u307e\u3059\u3002\n\u25a0\u30b7\u30c1\u30e5:\u5143\u6c17\u3067\u5065\u5eb7\u7684\u306a\u30dd\u30fc\u30ba\u3092\u3068\u3063\u3066\u3044\u308b\u3088\u3046\u306a\u30a4\u30e1\u30fc\u30b8\u3067\u9678-riku-\u69d8\u306b\u304a\u4efb\u305b\u3068\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059!\n\u8896\u304c\u77ed\u3044\u306e\u3067\u96e3\u3057\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u8107\u306f\u898b\u3048\u306a\u3044\u3088\u3046\u306b\u304a\u9858\u3044\u3057\u307e\u3059..!\n\n\u307e\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u59ff(\u96e3\u3057\u3044\u3088\u3046\u3067\u3042\u308c\u3070\u4e0a\u3068\u5de6\u53f3\u90e8\u5206)\u304c\u898b\u5207\u308c\u306a\u3044\u3088\u3046\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u304f\u3053\u3068\u306f\u53ef\u8