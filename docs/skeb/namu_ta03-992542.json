a-4a67-ba86-7c1c037dc619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68c660f0698b509f14c88798d260aa8a, https://si.imgix.net/31989899/uploads/origins/a2e92f4c-ed7a-4a67-ba86-7c1c037dc619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c763bf032badc70e2aa1ed060e0ce250 2x, https://si.imgix.net/31989899/uploads/origins/a2e92f4c-ed7a-4a67-ba86-7c1c037dc619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ac566a6642cc8d87e4bb1449e231ffd 3x"}, "body": "ぺんてはる先生\n\nはじめまして、コノハと申します。\n\n先生のイラストをいつも楽しみにしております！\nskeb募集が再開されていることをお見かけしたため、\nぺんてはる先生の絵柄でオリジナルキャラクター、紗砂を描いていただきたいと思い、今回リクエストを送らせていただきました。\n\n◆用途\n・個人観賞用\n・SNSでのアイコンに使用\n・同キャラクターを依頼する際の参照用\nを主に考えています。\n\n◆キャラクター\n外見等は資料URLをご参照ください。\n\n衣装、髪型は資料URLと同じものでも、自由にデザインしていただいても構いません。\n\n狐系のケモミミと尻尾。\n髪は腰くらいまでの銀髪ロング。\n瞳の色は明るい黄色。\nぱっと見穏やか、柔らかそうな雰囲気をしています。\n\n人の会話を眺めるのが好き。\n街や自然の景色の写真を撮ることも好き。\n知識探究に情熱を向けている。\n寂しがり屋な部分もあるが一人でお店にいけるタイプです。\n\n◆構図\n構図や表情の指定はありません。\nこのキャラを見てふと思い浮かんだシーンや、していそうだと思った事がありましたら、それを描いて頂きたいです。\n\n◆その他\n諸々不明点や、アレンジされたい箇所などあれば全てお任せします。\n条件が合いましたら、どうぞよろしくお願い致します。\n\nhttps://photos.app.goo.gl/1EuRxLTEtDxFi6v87", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@namu_ta03/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3081345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13c80f50/uploads/origins/6c3e1194-bdf6-4965-9f03-475cebee24a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70c613d1cb7f1d36ffe1aad6bbe6a7f4", "srcset": "https://si.imgix.net/13c80f50/uploads/origins/6c3e1194-bdf6-4965-9f03-475cebee24a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70c613d1cb7f1d36ffe1aad6bbe6a7f4, https://si.imgix.net/13c80f50/uploads/origins/6c3e1194-bdf6-4965-9f03-475cebee24a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=