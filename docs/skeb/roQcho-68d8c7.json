e65cff/uploads/origins/69f1950d-5edd-4ff0-83fd-cfe0996dbd99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42d17d27d71cc95c7951f75e5ffa95dc, https://si.imgix.net/f0e65cff/uploads/origins/69f1950d-5edd-4ff0-83fd-cfe0996dbd99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f37b840fb29f6cc5c22c129d0b88b40 2x, https://si.imgix.net/f0e65cff/uploads/origins/69f1950d-5edd-4ff0-83fd-cfe0996dbd99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d09b6cfd4ef0221faf88cd30da53d86e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0e65cff/uploads/origins/69f1950d-5edd-4ff0-83fd-cfe0996dbd99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d920d0869804a595d52a024872874bc", "srcset": "https://si.imgix.net/f0e65cff/uploads/origins/69f1950d-5edd-4ff0-83fd-cfe0996dbd99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d920d0869804a595d52a024872874bc, https://si.imgix.net/f0e65cff/uploads/origins/69f1950d-5edd-4ff0-83fd-cfe0996dbd99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e27a6f759c91be1d4539365747d91a49 2x, https://si.imgix.net/f0e65cff/uploads/origins/69f1950d-5edd-4ff0-83fd-cfe0996dbd99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=782abe699e9a823d23a4397be22558a3 3x"}, "body": "Thank you for the appeal! Your artwork is very beautiful. I would appreciate it if you can draw my character.\n\nThe pose and details I leave up to you! You may decide whether you want to draw the jacket and glasses.\n\n16:9 canvas size (PC wallpaper) is preferred. If it is not possible due to the pose that is okay! Please draw her so that the top of her head and the sides of her body are not cut off. It does not have to be a full body image. Please send a file where the character layer is on a separate layer from the background layer.\n\nI intend to use the artwork for VTubing activities like video thumbnails and sharing on SNS. I request permission to use the art for merchandise of my VTuber such as on a postcard or other types of merchandise to be sold. I am not sure if I will make merchandise but I want to disclose potential usage just in case. Thank you!\n\nhttps://imgur.com/a/s0vzehv", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@roQcho/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1957335, "client_id": 13725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3491383/uploads/origins/6cc0b04d-e770-4767-bcb5-59184235d1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afaab30cee041e0da86fe1013c1c9323", "srcset": "https://si.imgix.net/e3491383/uploads/origins/6cc0b04d-e770-4767-bcb5-59184235d1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afaab30cee041e0da86fe1013c1c9323, https://si.imgix.net/e3491383/uploads/origins/6cc0b04d-e770-4767-bcb5-59184235d1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df5c3c5543e2308143179161aa882811 2x, https://si.imgix.net/e3491383/uploads/origins/6cc0b04d-e770-4767-bcb5-59184235d1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20d5868a0cb5a1bee3814ee944479a36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3491383/uploads/origins/6cc0b04d-e770-4767-bcb5-59184235d1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9be4028589f8537d2291ba57e00fbdb", "srcset": "https://si.imgix.net/e3491383/uploads/origins/6cc0b04d-e770-4767-bcb5-59184235d1ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9be4028589f8537d2291ba57e00fbdb, h