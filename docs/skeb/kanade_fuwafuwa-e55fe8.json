=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d1b762141e064fd58e7ef2581f1b2eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e45d2d1/uploads/origins/3c5d6059-0262-422c-8657-09b6a10ec156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33f68705d72bc9d74faa9b00c3a6336", "srcset": "https://si.imgix.net/2e45d2d1/uploads/origins/3c5d6059-0262-422c-8657-09b6a10ec156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33f68705d72bc9d74faa9b00c3a6336, https://si.imgix.net/2e45d2d1/uploads/origins/3c5d6059-0262-422c-8657-09b6a10ec156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4f84e08113d893fdaaadf28e59be769 2x, https://si.imgix.net/2e45d2d1/uploads/origins/3c5d6059-0262-422c-8657-09b6a10ec156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07d955f9fa1c1710c80579e3b0f87499 3x"}, "body": "こんにちは！あなたが描く虹ヶ崎の女の子たちが本当に大好きです。最近、誰かのためにオリジナルキャラクターをデザインされたのを見かけたので、私のキャラクターも描いていただけないでしょうか？デザインも工夫していただけると嬉しいです。彼女はオレンジ色の髪とオレンジ色の目をしており、目を部分的に覆うような渦巻き模様のメガネをかけています。また、全身にそばかすがあります。\n\n服装については、普段は大きなジャケットにショートパンツを合わせています。ジャケットは開けていて、胸元が見えていることが多いです。参考までに、簡単なイメージ画像があります：https://files.catbox.moe/1yy2ct.png （キャラクターメーカーを使いました。申し訳ありません。）\n\n胸をもっと大きく描いていただけると嬉しいです。バストサイズやその他のデザインについては、すべてお任せします！ぜひご検討いただければ幸いです🙇‍♀️ 本当にありがとうございます～！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanade_fuwafuwa/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3410922, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=422c0df0a3fd7ad72011424e599404b7", "srcset": "https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=422c0df0a3fd7ad72011424e599404b7, https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31d3a864b4ef7effbf57379b0212e6a2 2x, https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afe98b252535d59763fd9b960c4283e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=581f3af2912864ef887db7b737f86604", "srcset": "https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=581f3af2912864ef887db7b737f86604, https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f926b5958b4636f2b096be2a964322ba 2x, https://si.imgix.net/dae88910/uploads/origins/597e5209-1c7f-4236-b21b-b28dfa736a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea6dd2e810cac2dd379fc892b3254c83 3x"}, "body": "こんにちは、再度お願いいたします。前回の依頼から間もないこと、申し訳ありません。お気持ちに合わない場合は、遠慮なくお断りください。このイラストに急ぎはありません。お時間をかけて、ご自身の健康を最優先にお願いします。今回は二部構成のイラストをお願いしたいです：両部ともミアは裸の胸で描いてください。トップスは着用していません。 下半身はご自由に描いていただいて結構です。パート１：ミア・テイラー（13歳）が両手で胸を隠している。胸はほぼ完全に平らなので、両手で簡単に完全に覆える。視聴者に向かって叱責している様子：「ふん、私の胸が見たいの？まだ13歳よ！変態！」\n\n第二部：ミア・テイラー（14歳）は過去1年で異常な胸の成長を遂げた。胸は今や巨大で、エマ・ヴェルデ級。以前と同じポーズで胸を両手で隠し、視聴者を叱ろうとする：「え？私の胸？まだ14歳よ！変態！」しかし今回はその努力が無駄だと悟る。「…ああ、くそっ」胸を両手で隠すのもやっとで、明らかに恥ずかしそうだ。14歳にしてこの巨乳！可能なら、二つの年齢における成長の差を強調していただけるとありがたいです。実際の年齢を書くことに抵抗がある場合は、数字を消して構いません（例：最初のミアはX3歳、二番目のミアはX4歳と記述）。\n\n繰り返しになりますが、ご自身の許容範囲外の場合は遠慮なくお断りください。全く気にしません！今後も引き続きお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanade_fuwafuwa/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3410922, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a873c332f0c4d846d6d1ec455e723595", "srcset": "https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a873c332f0c4d846d6d1ec455e723595, https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62daf01d08435431924516c69fdc168f 2x, https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1040d9200653b388ecf27d5b57bb88c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5c4e9a360981764f8f7798ee45dc8e4", "srcset": "https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5c4e9a360981764f8f7798ee45dc8e4, https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47714e48ec721f1715a27d92d634352d 2x, https://si.imgix.net/cc78ed67/uploads/origins/f719fa11-c889-451e-a14e-775180d7c29b?bg=%23fff&auto=format%2Ccom