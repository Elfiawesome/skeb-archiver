g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6aa3bf72f4869aefef827e2506619c6, https://si.imgix.net/05e4f6d9/uploads/origins/42b2dffb-1ec5-4e65-90e5-8ac59f2eecad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eadfc9a2dddf4ff50a3bcbf2762e1c90 2x, https://si.imgix.net/05e4f6d9/uploads/origins/42b2dffb-1ec5-4e65-90e5-8ac59f2eecad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=142e14c3fffc612f05dea8cbe3664a12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05e4f6d9/uploads/origins/42b2dffb-1ec5-4e65-90e5-8ac59f2eecad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=353eb879f43b85bae951886a5a312838", "srcset": "https://si.imgix.net/05e4f6d9/uploads/origins/42b2dffb-1ec5-4e65-90e5-8ac59f2eecad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=353eb879f43b85bae951886a5a312838, https://si.imgix.net/05e4f6d9/uploads/origins/42b2dffb-1ec5-4e65-90e5-8ac59f2eecad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acf94888b3fbcf6f17e3fbc3d201ce20 2x, https://si.imgix.net/05e4f6d9/uploads/origins/42b2dffb-1ec5-4e65-90e5-8ac59f2eecad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7fb5fa14d501e46879b4aa900559d8c8 3x"}, "body": "リクエストを送らせていただきます、ランスと申します。\n依頼文(サイズについて)に訂正がございますので送り直させていただきます🙇‍\n\n創作企画「ハッピー！ゲーム・ブレインズ」のランス宅オリジナルキャラクター「成田寧々」のイラストをリクエストさせていただきたいです…！\n\n以下が詳細になります。\n\n創作企画「ハッピー！ゲーム・ブレインズ」（略称：はぴぶれ）\nTwitter公式アカウント　＠hpbr_k\n「リアル体験型脱出ゲーム×ゲーム脳」をテーマとした人数固定のストーリー進行型一次創作企画。大人気MMORPG「ハチミツストーリー」とコラボした、「何々有遊園地」のリアル体験型脱出ゲームに一行は参加し、そこで奇妙な事件に巻き込まれるが、「ゲーム脳」の参加者たちはこの事件が現実であると気づかない。\n\nなお、キャラクターの著作権はランスに帰するものであり、主催の酸素様（＠O2_kikak）より、所属するキャラクターイラストの外部依頼、および後述いたします使用用途については事前に了承を得ています。\n\n成田寧々\n「ハチミツストーリー」を布教する猫系配信者「にゃる田ねんね」として活動をしている女子高校生。\n詳細はキャラクターシート(資料URL)をご参照ください。\n\n使用用途といたしましては、配信者である「成田寧々」の概念グッズを作成する予定でございます。他の方に販売などをするものでなく、自分の部屋に飾る用として使いたいと考えています。\n作製グッズは現時点では未定ですが、ポスター、タペストリーを考えております。サテラ様が描かれたサイズに応じて変更する予定でございます…！\nそのため、明確なサイズ指定はないのですが、以下の目安をご参考にこの金額で描けるイラストをお願いいたします。\nA4→2893×4092\nA3→4093×5087\nB3→5016×7096\n\nイラストの内容としましては、明るくかわいい、猫が大好きな成田寧々をサテラ様の絵柄で自由に表現していただきたいです…！ 描かれる範囲や背景はご自由にお願いいたします。\n小物として、猫ちゃんを数匹配置していただけますと嬉しいです…！（リアル調ではなく、デフォルメされた猫ちゃんで大丈夫です！）\n\n金額不足や、使用用途に問題がありましたらキャンセルください。\n長文、お読みいただきありがとうございました…！\nよろしくお願いいたします！\n\nランス\n\nhttps://twitter.com/hpbr_k/status/1495002748827635719?s=21", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 963648, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "HITSUJI", "screen_name": "pokky502", "avatar_url": "https://pbs.twimg.com/profile_images/2051882455343501312/y6hPfn9J.jpg", "header_url": "https://pbs.twimg.com/profile_banners/569115879/1625312386/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1615222, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "超新星鯖発", "screen_name": "Z7vJb", "avatar_url": "https://pbs.twimg.com/profile_images/2028119118919217152/m_acW16k.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1211284605568815105/1677411231/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 3285250, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ざべろん2号", "screen_name": "zaberoso", "avatar_url": "https://pbs.twimg.com/profile_images/1440266583956361225/GZNo_My7.jpg", "header