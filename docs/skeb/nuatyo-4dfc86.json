ix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b76d9e2d4421b3bbaf9033b815d9aca5", "srcset": "https://si.imgix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b76d9e2d4421b3bbaf9033b815d9aca5, https://si.imgix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e188189ec0902887dd8ae8bda47fd992 2x, https://si.imgix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95312f90bf71b9dee256582b04ea91d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f9d1e816a0358b16bf912b37846642b", "srcset": "https://si.imgix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f9d1e816a0358b16bf912b37846642b, https://si.imgix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a479ab2cb7e190e1d8ad998affdce43c 2x, https://si.imgix.net/392441ac/uploads/origins/3f1b5cb5-2646-4288-8d11-f8c14cbd890f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d4ecfab1f9d29c3f12b084f22ea2f55 3x"}, "body": "はじめまして、ぬあんちょさん。\n\n今回ぬあんちょさんに依頼したいのは「ひぐらしのなく頃に令」よりの前原圭太郎くんと竜宮希比呂くんです。\n年齢は小6から中二でも構いません。はしゃいで遊び疲れて一緒に寝ていた大親友の二人の一枚をぬあんちょさんに頼みたいです。肌色多めでしたら喜びます。\nもしよろしければよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nuatyo/works/3", "pr