s/fcb08e34-a1cd-4e3c-b138-0a724fc125b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dccd698533e9aafd71ee4e8a2d87c5f, https://si.imgix.net/912adc0f/uploads/origins/fcb08e34-a1cd-4e3c-b138-0a724fc125b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63211667f2a542841d44afc90eb47a9b 2x, https://si.imgix.net/912adc0f/uploads/origins/fcb08e34-a1cd-4e3c-b138-0a724fc125b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e5753b01c5835284a42ea00c9ffff41 3x"}, "body": "ひぐらしにハマった頃からぬあんちょさんの素敵な悟史くんや圭一くんの絵を見させて頂いております、ぱんけえきと申します。今回スケブを始めて下さったとのことで、依頼させて頂きました！\nもし版権的に可能でしたら、仲良くハグしたままベッド(難しかったら背景は無くても構いません)に横になって幸せそうに笑い合う悟史くん圭一くんを描いて頂けないでしょうか…？(二人は恋愛感情は無いですが、互いに一緒にいると安心するくらいの関係性です)\n二人の服装は公式が出しているマリンverの衣装で(悟史くんは圭一くんと同じ衣装でお願いします)、帽子は無くて大丈夫です。あと二人の周りにイルカや星のぬいぐるみを置いて、可能であれば海イメージで青を基調とした色合いで描いて頂けると嬉しいです。\n上記以外の構図等はお好きなように描いて頂いて構いません。\n利用目的としては、スマホの壁紙に使わせて頂きたいと思っております。お忙しいかと思いますので、どうかごゆっくり描いて頂ければと思います…！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1575851, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ひびき澪@君それ⑦巻発売中", "screen_name": "info_hibikimio", "avatar_url": "https://pbs.twimg.com/profile_images/1079732557791387649/A1LKEw9P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/889833875261620224/1612472722/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "comic"}, {"genre": "art"}], "nc": 48}, {"id": 2375974, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "苺穂はなお🌷", "screen_name": "Hanao000_md", "avatar_url": "https://pbs.twimg.com/profile_images/1746867194863214592/zkgM-wXw.jpg", "header_url": "https://pbs.twim