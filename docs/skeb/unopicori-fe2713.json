300c\u30af\u30fc\u30eb\u306a\u304a\u59c9\u3055\u3093\u300d\u3063\u307d\u3044\u306e\u3093\u3073\u308a\u5973\u306e\u5b50\u3002\u5e38\u6642\u306f\u751f\u610f\u6c17\u3060\u3051\u3069\u3001\u3044\u3056\u3063\u3066\u6642\u306b\u983c\u3082\u3057\u3044\u30d7\u30ed\u306b\u306a\u308c\u308b\u3002\u5f7c\u5973\u306f\u610f\u8b58\u7684\u3001\u884c\u52d5\u524d\u306b\u5fb9\u5e95\u7684\u306a\u8a08\u753b\u3092\u7acb\u3066\u308b\u306e\u304c\u597d\u304d\u3060\u3002\u6020\u60f0\u306a\u81ea\u7136\u306b\u3088\u308b\u3068\u5927\u4f53\u706b\u5668\u3067\u6226\u3063\u3066\u3001\u975e\u5e38\u3057\u304b\u306a\u3044\u3067\u5909\u8eab\u80fd\u529b\u3092\u4f7f\u3046\u3002\u8da3\u5473\u306f\u63a2\u5075\u5c0f\u8aac\u3068\u30d5\u30a3\u30eb\u30e0\u30fb\u30ce\u30ef\u30fc\u30eb\u3060\u3002\u5f7c\u5973\u306f\u7518\u3044\u30da\u30b9\u30c8\u30ea\u30fc\u3068\u30d6\u30e9\u30c3\u30af\u30b3\u30fc\u30d2\u30fc\u304c\u597d\u304d\u3060\u3002\u3075\u3063\u304f\u3089\u3068\u3057\u305f\u5927\u304d\u306a\u80f8\u3068\u67d4\u3089\u304b\u305d\u3046\u306a\u4f53\u3002\n\nMelody\u306f\u3061\u3087\u3063\u3068\u304a\u3066\u3093\u3070\u5a18\u3002\u3068\u3066\u3082\u81ea\u4fe1\u5bb6\u3067\u3001\u3069\u3093\u306a\u72b6\u6cc1\u306b\u3082\u3059\u3050\u306b\u9069\u5fdc\u3067\u304d\u308b\u3002\u3068\u3066\u3082\u983c\u308a\u306b\u306a\u308b\u304c\u3001\u6c17\u304c\u77ed\u3044\u3002\u5916\u5411\u7684\u3067\u3001\u4eba\u52a9\u3051\u304c\u597d\u304d\u306a\u5973\u306e\u5b50\u3060\u3002Melody\u304c\u4f7f\u3046\u306e\u306f\u3001\u5927\u304d\u306a\u30ec\u30f3\u30c1\u3068\u5263\u3001\u305d\u3057\u3066\u4f53\u529b\u3060\u3002\u5f7c\u5973\u306f\u4ed6\u306e\u9053\u5177\u3084\u5373\u5e2d\u306e\u6b66\u5668\u3082\u9069\u5f53\u306b\u4f7f\u3046\u3002\u8da3\u5473\u306f\u7279\u64ae\u756a\u7d44\u3068\u6f2b\u753b\u3002\u8f9b\u3044\u98df\u3079\u7269\u3068\u7518\u3044\u30b3\u30fc\u30d2\u30fc\u304c\u597d\u304d\u3060\u3002Melody\u306f\u63a7\u3048\u3081\u306a\u80f8\u3068\u3080\u3063\u3061\u308a\u3068\u3057\u305f\u592a\u3082\u3082\u3001\u305d\u3057\u3066\u30ad\u30e5\u30fc\u30c8\u306a\u304a\u5c3b\u3092\u6301\u3063\u3066\u3044\u308b\u3002\u5f15\u304d\u7de0\u307e\u3063\u305f\u4f53\u3064\u304d\u3092\u3057\u3066\u3044\u308b\u3002\u808c\u306f\u5c11\u3057\u65e5\u713c\u3051\u3057\u3066\u3044\u308b\u3002\n\nMe encanta esta idea:\nEn Jap\u00f3n, es com\u00fan disfrazarse de Santa Claus, as\u00ed que esta vez me gustar\u00eda dibujar a DIA y Melody con trajes navide\u00f1os. \ud83c\udf85\ud83c\udf81\nImagino un vestido elegante y femenino, lleno de esp\u00edritu navide\u00f1o. \ud83c\udf1f\n\n\u3054\u81ea\u7531\u306b\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u5148\u751f\u306b\u3068\u3063\u3066\u304b\u3063\u3053\u3044\u3044\u30b7\u30fc\u30f3\u3067\u3042\u308c\u3070\u3046\u308c\u3057\u3044\u3067\u3059\u3002\n\n\u3054\u691c\u8a0e\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1471514, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "k u r a \u2671", "screen_name": "nnakiits", "avatar_url": "https://pbs.twimg.com/profile_images/1861280066812157954/PdfwuRUO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1705855014730919936/1775663029/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2057371, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "yonaka\uff5c\u30a4\u30e9\u30b9\u30c8\u30ec\u30fc\u30bf\u30fc", "screen_name": "atelieryonaka", "avatar_url": "https://pbs.twimg.com/profile_images/1734075589039095808/l0--m8iR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1513737928970682372/1746195388/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_ran