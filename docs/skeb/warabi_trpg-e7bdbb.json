/origins/b56b1b41-3e8e-4b23-b2fc-6d8b93d9355b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05e5ae8fe3814afa8a03be3b8ebef918 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36043078/uploads/origins/b56b1b41-3e8e-4b23-b2fc-6d8b93d9355b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7163e0c09076d776c5cbdc7251808b31", "srcset": "https://si.imgix.net/36043078/uploads/origins/b56b1b41-3e8e-4b23-b2fc-6d8b93d9355b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7163e0c09076d776c5cbdc7251808b31, https://si.imgix.net/36043078/uploads/origins/b56b1b41-3e8e-4b23-b2fc-6d8b93d9355b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=931dcdc30ba24b015c3d31b5ae2ce655 2x, https://si.imgix.net/36043078/uploads/origins/b56b1b41-3e8e-4b23-b2fc-6d8b93d9355b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=800ddbfb772ff9e7a26b36826ceb3492 3x"}, "body": "はじめまして、わらびと申します。\nさとるさんの素晴らしいイラストをいつも見させていただいております。\n\n今回は自探索者をさとるさんの絵柄で拝見したく思い依頼させていただきました。\n依頼をさせていただきたいのは一枚絵です。（もし、さとるさんの余力がございましたら、ミニキャラも依頼させていただきたいです。本当に余力のある際、依頼金が足りている場合で大丈夫ですので、無理だと思いましたらスルーしてくださって結構です。）\n\n\n・リクエスト内容\n自探索者、ヤゼル天才\n\n・使用用途\n主に観賞用。個人的にグッズにさせていただくかもしれません。\nまたリクエスト作品であることを明記し、Twitterアイコン、ヘッダーでの使用をさせていただきたいです。\n\n・構図\nさとるさんの描きやすい構図で描いていただきたいと思います。\n後述しているように俳優なのでタイアップ時の花束もらった様子や、演じている様子でもいいかなと思います！\n\n・自探索者について\n名前：五十嵐渡\n性別：男\n身長：182cm\n職業：俳優\n年齢：25\n\n・雰囲気\n明るく、元気でどんな人物にも対等に接する人物です。秀才にも同じように接していました。\n\n・資料\nhttps://iachara.com/view/9476206\nhttps://drive.google.com/drive/folders/1GIdobwLUZOIrQwva2L74i3SAScOFtlN6\n\nお時間など余裕がありましたら、検討してくださると幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamagoDX1414/works/199", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 583942, "client_id": 2897795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d0aca6a28f8158e69334b90cf84419", "srcset": "https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d0aca6a28f8158e69334b90cf84419, https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76571a899c45731f4ad8239f03380eb2 2x, https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b19e75f80b0e125ab4295a352243742 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=904d58f2d20a63c321e916e30dd4b974", "srcset": "https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=904d58f2d20a63c321e916e30dd4b974, https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ab3a7ca57673f74de4783b1cd2131b4 2x, https://si.imgix.net/bc8ff351/uploads/origins/d70b0fbf-47f1-4d30-b689-ac92cda6e9fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=976c5ec6f14d03e352f87c1074b89067 3x"}, "body": "はじめまして。わらびと申します。\nいつもあんどうさんの素敵なシナリオを楽しませて頂いております！\nサイレン清掃会社の洒掃讙に見事に狂わされ、事あるごとにシナリオを思いふける日々を過ごさせて頂いております！\nそこでなのですが、今回あんどうさんに弊サイレンHo1とサイレンのNPCの洒掃讙の1枚絵を依頼させて頂きたいと思います。\n\n（もし、しろはさんの余力がございましたら合わせて、洒掃讙か弊サイレンHo1、あるいは片方のミニキャラも依頼させていただきたいです。本当に余力のある際、依頼金が足りている場合で大丈夫ですので、無理だと思いましたらスルーしてくださって結構です。）\n\n・使用用途\n主に観賞用。個人的にグッズにさせていただくかもしれません。\nまたリクエスト作品であることを明記し、Twitterアイコン、ヘッダーでの使用をさせていただきたいです。\n\n・構図\nあんどうさんが描きたい、描きやすい構図で描いていただきたいです。\n\nあんどうさんが悩んだ際のため、いくつか案を書き出しておきますが、使うか使わないかはあんどうさんにお任せしたいです！\n\n案１：リーダーと弊Ho1が執事服を着ていて、リーダーが座るイスの後ろから弊Ho1がイスのてっぺんに腕を組んで笑っている構図（かっこいい風…？）\n案2：リーダーが貴族みたいな服で、弊Ho1が執事している構図\n案3：弊Ho1がリーダーの仕事を手伝っている構図\n案4：リーダーと弊Ho1が私服でお出かけをしている構図\n\n・探索者について\n名前：春夏冬芥\n性別：男\n身長：178cm\n年齢：36歳（見た目は歳よりも若く見えます）\n趣味：昼寝・タバコ\n\n・自陣の制服\nメイド服あるいは執事服です。\n自陣はHo1が執事服でそれ以外は全員メイド服でした。\n\n見た目：茶髪糸目・糸目は開眼しやすく、オレンジ色のツリ目・髪の毛は癖っ毛・仕事中は右目の下にオレンジ色の▲が2つ重なっています・左耳に謎のピアスがついてます・アホ毛・仕事着は執事服、私服はダボッとした服\n雰囲気：語尾に〜がつくような話し方をしていて、へらへらしてるが、仕事はやるときはやる男。\n\nシナリオ内でのリーダーとの関係：自陣はリーダーのことをすごく頼りにしていて、信頼関係があったかなと思います。弊探索者はリーダーを誰よりも信頼していて、大好きだったので、内緒ごとをされていたことに滅茶苦茶キレていて、シナリオが終わったときに静かに詰めよって怒りました。今は内緒ごとをせずに頼ってねということで落ち着きました。\n\n今のリーダーとの関係：シナリオ後に弊Ho1と自陣のHo4がうちよそ関係になり、双方こじらせカップルをしているので、その板挟みを食らっているかなと思います。\n\n\nシナリオ執筆など、忙しい中だとは思いますが検討してくださると幸いです。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1njKKG_OFPuiTrnm8Mdtgt6GLc2y_3gsr", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1156322, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヘルプマン", "screen_name": "helpen_hhh", "avatar_url": "https://pbs.twimg.com/profile_images/1709960853137879040/OnXwAjNe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1328729254209540096/1771903800/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1320566, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "百頭ピン", "screen_name": "hyakutoupin", "avatar_url": "https://pbs.twimg.com/profile_images/1190557985384349697/ZYzhwL