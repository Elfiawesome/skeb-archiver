w=200&h=200&blur=200&s=c38f45943cc5b988d066185ece1fcaed, https://si.imgix.net/fad999be/uploads/origins/799e98e1-80d0-45b5-ac54-fe3e4f8fab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87dac037b5b7367c8a5bbd0b7223553d 2x, https://si.imgix.net/fad999be/uploads/origins/799e98e1-80d0-45b5-ac54-fe3e4f8fab9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0851402e3d67889aa5e8fc3b5675a257 3x"}, "body": "初めまして。ナカタさんの描かれる人物の美しさと澄んだ空気感に一目惚れして今回リクエストを送らさせて頂きました。\n\n◆キャラクター\ncocシナリオ「鰯と柊」通過の自PC/相方PCをお願いしたいです。\n添付ファイルに容姿等まとめております。どんな風に描いていただいても嬉しいです。\n\n◆用途\n個人観賞用として相方さんやSNSへの共有になります。並びにアイコン使用等、相方さんとの個人的な非営利のグッズ製作などにも使用させていただくかもしれません。\n\n金額が厳しければ再送要請をぜひお願いしたいです。その他不都合がございましたらキャンセルしてください。\nお忙しい中申し訳ございませんが、ご検討のほど宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Uk83KMT1bdduk6BXb8nvGW2b2dXmtSmw?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rab_piChr/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3633882, "client_id": 2255263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/250fa2dd/uploads/origins/ec7acfc3-33d7-4d80-bc2d-5c2482dbd103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a91bb01acd30fee99e379a32aaa90cb", "srcset": "https://si.imgix.net/250fa2dd/uploads/origins/ec7acfc3-33d7-4d80-bc2d-5c2482dbd103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a91bb01acd30fee99e379a32aaa90cb, https://si.imgix.net/250fa2dd/uploads/origins/ec7acfc3-33d7-4d80-bc2d-5c2482dbd103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dffde1456d7ca52ae683ca1d8ceccd05 2x, https://si.imgix.net/250fa2dd/uploads/origins/ec7acfc3-33d7-4d80-bc2d-5c2482dbd103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76f635de143f99821d982716d28f69ed 3x"}, "duratio