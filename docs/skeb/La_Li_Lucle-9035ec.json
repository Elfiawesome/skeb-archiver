64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d2265e077f7a63cb86cda817f824001 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1684683789380046848%2Flv2jip9F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10b8e6f116c8be8ac09a42c60fc4b0a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1684683789380046848%2Flv2jip9F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8228dbab8adab8f546c06fc3380abfad", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1684683789380046848%2Flv2jip9F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8228dbab8adab8f546c06fc3380abfad, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1684683789380046848%2Flv2jip9F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f024f47b7084f4aabe676aa0bd8372b2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1684683789380046848%2Flv2jip9F.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94fd36a3683ae72983c9ce95c48ca7ee 3x"}, "body": "ルクル先生、いつも素敵な作品をありがとうございます。今回、skebリクエストを受け付けてくださるということで、大好きな水葬銀貨のイストリアより茅ヶ崎夕桜ちゃんの一幕をリクエストさせてください。\n\n些細な日常といったシチュエーションになってしまうのですが、花占いをする夕桜ちゃんが見てみたいです。結果がなんであっても、結局花占いはしないでも、題材についてはどのように扱っていただいても構いません。また、他の登場人物の有無については特に指定はいたしません。夕桜ちゃんの独白のようなものでも大歓迎です。\n\n以下は個人的に好みなだけの要素なので、扱いが難しければご放念していただいて構いません。ひとつめは、名前に入っているのに花占いに全く関係ない〝桜〟について盛り込まれていると楽しいかと思います。欧州には「私を忘れないで」という日本とは別の花言葉もあるそうです。ふたつめは、雰囲気としては明るい場面というより、悩んでいたり悶々としている様子が描かれていると嬉しいです。可能な限り詳細にとありましたが、あまり狭め過ぎて先生の世界観が見られなくなるのも悲しいので、あくまで参考程度にお願いいたします。\n\n茅ヶ崎夕桜ちゃん、二次創作等でもあまり見かける機会が無く、ルクル先生ご本人から夕桜ちゃんの一幕を見せていただけるのでしたら本当に何でも嬉しいのですが……。少しでも琴線に触れる要素があれば、是非、宜しくお願いいたします。執筆の相場についてあまり理解できておらず、内容と値段がマッチしていないといった失礼がございましたら、大変申し訳ございません。\n\n最後になりますが、いつも素敵な作品を届けていただきありがとうございます！プトリカ含め、これからのご活躍も楽しみにしております。", "nc": 128, "word_count": 3970, "transcoder": "text", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 236967, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "はこつき", "screen_name": "re_hako_moon", "avatar_url": "https://pbs.twimg.com/profile_images/1418496904631963648/UYABA_LB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1135213666645659648/1559751227/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "music"}], "nc": 1}, {"id": 622444, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "東条サダヲ（StudioComodo)", "screen_name": "sadawotouzyou", "avatar_url": "https://pbs.twimg.com/profile_images/1093118148444708864/H2Wr7tPF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1456978514/1754051365/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "firs