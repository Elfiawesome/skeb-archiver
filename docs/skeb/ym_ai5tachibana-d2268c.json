薙刀\n･髪:ショート、金髪で緑のメッシュ\n･装飾:黒の手袋、赤のピアス(見えなくてもいい)、マクラメ編みした2連編み紐\n･服の模様、もしくは装飾のどこかに蓮の花があると嬉しいです\n\n【カラーコード】\n髪:#f7f2a7\nタートルネック、手袋、ブーツ:#333333\n髪の一部、ブーツの紐:#006e54\n瞳、薙刀の柄、パンツ、ピアス:#ff6f5c\n\nあくまで目安なので、あいさんがよいと考える形、色味に変えても構いません。\n以下は参考資料です。ご確認下さい。\n\nhttps://drive.google.com/drive/folders/1-EsSWnl7EFypXxm4pelsuTY18wp0BKia", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ym_ai5tachibana/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3298183, "client_id": 3526111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4aa18787/uploads/origins/11c3c7c7-70b2-41b4-9c15-21b11d5e6500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95ac7af7ee4b5830caa5f177f81ee00a", "srcset": "https://si.imgix.net/4aa18787/uploads/origins/11c3c7c7-70b2-41b4-9c15-21b11d5e6500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95ac7af7ee4b5830caa5f177f81ee00a, https://si.imgix.net/4aa18787/uploads/origins/11c3c7c7-70b2-41b4-9c15-21b11d5e6500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=401ecb2807e6dfc5e695a48089398843 2x, https://si.imgix.net/4aa18787/uploads/origins/11c3c7c7-70b2-41b4-9c15-21b11d5e6500?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=363560cae60c4d6dfb1a131e2db91840 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4aa18787/uploads/origins/11c3c7c7-70b2-41b4-9c15-21b11d5e6500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c813fa2bafe9ffcfc95fa4e767f2d75", "srcset": "https://si.imgix.net/4aa18787/uploads/origins/11c3c7c7-70b2-41b4-9c15-21b11d5e6500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c813fa2bafe9ffcfc95fa4e767f2d75, https://si.imgix.net/4aa18787/uploads/origins/11c3c7c7-70b2-41b4-9c15-21