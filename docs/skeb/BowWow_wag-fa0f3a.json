ac-illust.com/86/86d6ae5098ea60bc325908a362a37846_t.jpeg\n参考（pixtaより）：https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS4Mkn8dRkrr0PSfiLSCC2hSAGNkw6YvZbdw1GwdsK0gw&s\n参考にあるように手を口や顎に当てているようなポーズでお願いします。\nどや顔していても、考え込んだ顔していても大丈夫です。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BowWow_wag/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3080827, "client_id": 2141718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e28b3ac5/uploads/origins/598ea512-4361-4540-bcbc-1e384903b2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb9bbeb3520daaea8548034bf2577a91", "srcset": "https://si.imgix.net/e28b3ac5/uploads/origins/598ea512-4361-4540-bcbc-1e384903b2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb9bbeb3520daaea8548034bf2577a91, https://si.imgix.net/e28b3ac5/uploads/origins/598ea512-4361-4540-bcbc-1e384903b2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d7b2e2a2e861e0f7afcd3f98f10b253 2x, https://si.imgix.net/e28b3ac5/uploads/origins/598ea512-4361-4540-bcbc-1e384903b2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=592a007a20e816cbc3be75aefcfe40d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e28b3ac5/uploads/origins/598ea512-4361-4540-bcbc-1e384903b2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85360cc3c3245196e4babd1f8c22ad86", "srcset": "https://si.imgix.net/e28b3ac5/uploads/origins/598ea512-4361-4540-bcbc-1e384903b2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85360cc3c3245196e4babd1f8c22ad86, https://si.imgix.net/e28b3ac5/uploads/origins/598ea512-4361-4540-bcbc-1e384903b2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&b