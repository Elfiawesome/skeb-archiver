は相当おしゃべりで、最近は歌枠などの新しいチャレンジもしています。\n絵本の１ページのような、どんな鳥宗さんを描いていただけるか楽しみです。\nポーズ、髪型、服装、背景などのアレンジは全ておまかせいたします。\n\n使用用途はファンアートとしてのプレゼントですが、\n彼女の収益化された配信やSNS、グッズ販売などで使用してもらいたいと考えています。\nキャラクターのみのPSDデータ、もしくは透過PNGデータというものも併せて頂けますと幸いです。\n\nご検討よろしくお願いいたします。\n\nhttp://lit.link/torimunemomo", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Moyo_illust/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3728313, "client_id": 3541354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc46c3c0/uploads/origins/aefcea78-ece5-4f32-b991-f4e3c24173c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e8753c2bd45266fa00982bc1011a1e3", "srcset": "https://si.imgix.net/dc46c3c0/uploads/origins/aefcea78-ece5-4f32-b991-f4e3c24173c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e8753c2bd45266fa00982bc1011a1e3, https://si.imgix.net/dc46c3c0/uploads/origins/aefcea78-ece5-4f32-b991-f4e3c24173c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31d6700242cab4449b8c6cb04492b42e 2x, https://si.imgix.net/dc46c3c0/uploads/origins/aefcea78-ece5-4f32-b991-f4e3c24173c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65e0c8a1c2eab6ece8078db924fec16a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc46c3c0/uploads/origins/aefcea78-ece5-4f32-b991-f4e3c24173c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415c34fa9dd2f7d84be4d603b0a70732", "srcset": "https://si.imgix.net/dc46c3c0/uploads/origins/aefcea78-ece5-4f32-b991-f4e3c24173c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415c34fa9dd2f7d84be4d603b0a70732, https://si.imgix.net/dc46c3c0/uploads/origins/aefcea78-ece5-4f32-b991-f4e3c24173c8?bg=%23fff&auto=format%2Ccompress&fm