女装をさせられ、お姫様のようにさせられる。少年はお姫様に肛門を犯される。巨大なペニスでお腹が膨らむ。肛門前立腺のオーガズムで精液を吐き出す。キスの痕だらけの少年。\n\nこの女性はサディスティックで、非常にムラムラしている。しかし、この女性は愛情深く、とても感謝している。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 232, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クェッツァー＠イラリク募集中", "screen_name": "j1S0dbMKRA", "avatar_url": "https://pbs.twimg.com/profile_images/1369900710079336449/NEmQBhRP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/120912695/1614392762/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 160}, {"id": 121818, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ホクロ流星群(ミスキー)", "screen_name": "hokuroryuseigun", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd5f78587-bcbf-4c4d-9076-eb1242506011.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/5b06989f-8593-49c8-98dd-6afebdf5d66f.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 182747, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "多分とまとじごく", "screen_name": "tomatojigoku2", "avatar_url": "https://pbs.twimg.com/profile_images/1732772313496690688/2CIgh7M4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1732701928789024768/1701960344/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null,