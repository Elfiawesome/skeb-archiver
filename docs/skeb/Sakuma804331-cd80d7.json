す。\n\nhttps://drive.google.com/drive/folders/13T_TMWrQUiG9t6Xdqi1Z3U-xVNMCM9jn?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sakuma804331/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3762435, "client_id": 3097944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fc5c4452a91154c371edecaacbdd7c", "srcset": "https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5fc5c4452a91154c371edecaacbdd7c, https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=923e91efbf7f1be1dd7268447fbb0552 2x, https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4956b580b1bc32a29e45615dcad572e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dd894b8518dd1caf2d0a058a4d46d0a", "srcset": "https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dd894b8518dd1caf2d0a058a4d46d0a, https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44e07a22bab01d9a62440bf9789a4c1b 2x, https://si.imgix.net/4321b1de/uploads/origins/d5a6733f-ede1-45a6-82c9-d7352bfa2815?bg=%23ff