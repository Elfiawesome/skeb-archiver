情でお願いします。\n\n・備考\nファイル形式はPNGで、背景は透過してください。\n\n・用途\nSNSでの宣伝や告知\nYoutubeのサムネイルや動画内での使用\n\n以上になります。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1wHhZ1aS1dhkEsBIb30CwXb8GmGKSI-GK?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AS_buppa/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3143895, "client_id": 3343394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeb46a3a/uploads/origins/cd8ef98c-1834-4e12-8c4b-a11126c1bdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58c73084cc0826ceab60217524c30e3", "srcset": "https://si.imgix.net/eeb46a3a/uploads/origins/cd8ef98c-1834-4e12-8c4b-a11126c1bdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58c73084cc0826ceab60217524c30e3, https://si.imgix.net/eeb46a3a/uploads/origins/cd8ef98c-1834-4e12-8c4b-a11126c1bdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d7a6b9be0737201cf5e7a6c9a9a68ed 2x, https://si.imgix.net/eeb46a3a/uploads/origins/cd8ef98c-1834-4e12-8c4b-a11126c1bdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2773dcf3873e1bbbb62418d7dfa6e1d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeb46a3a/uploads/origins/cd8ef98c-1834-4e12-8c4b-a11126c1bdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76ac2494dfce2ae408c986246f8798bd", "srcset": "https://si.imgix.net/eeb46a3a/uploads/origins/cd8ef98c-1834-4e12-8c4b-a11126c1bdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76ac2494dfce2ae408c986246f8798bd, https://si.imgix.net/eeb46a3a/uploads/origins/cd8ef98c-1834-4e12-8c4b-a11126c1bdb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fce4f9288ad61369da57878476210