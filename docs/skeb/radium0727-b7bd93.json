見し、以前デレマスの緒方智絵里ちゃんをよく描かれていたので、もしよかったら現在のさえむら先生のタッチで智絵里ちゃんを見てみたいと思い、リクさせていただきました。\n\n前置きが長くなりましたがリク内容に移ります。\nキャラ・緒方智絵里\n衣装・クリスタルナイトパーティ\nアングル指定・ニーソ好きなのでニーズが入るようなアングルであればそれ以外はお任せします。\nその他・psd形式での納品を希望します（当方クリスタ所有）。その際キャラ本体と背景、宛名等をレイヤーでオンオフできるようにしてください。\n\nでは、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@radium0727/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 946842, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0398f3dcf98907453da31bc0792be3de", "srcset": "https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0398f3dcf98907453da31bc0792be3de, https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=731a02de3964744548b2f0b77c38ee85 2x, https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=947f053d29e46bd2708829eed7a5920e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0ed9cb03637e2044e01956888bf04e9", "srcset": "https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0ed9cb03637e2044e01956888bf04e9, https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60e97fc1d46935bf49197f941664061b 2x, https://si.imgix.net/0daf0e99/uploads/origins/b4704e42-ee3c-4e5e-beb1-e4ddd9c93a2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b1f0dd1d66ed3080f4b8799eab6c9a 3x"}, "body": "過去に描かれていたカレンのイラストなど拝見して惹かれたので依頼を送らせていただきます\n\n海岸に居る水色ビキニ姿のデアリングタクトをお願いします\n\nイメージとしてはトレーナーと2人で海へ遊びに来て、タクトが着替えてビキニ姿を見せに来たのをトレーナー目線で見ているようなシチュです\nスリーサイズなどが明らかになっていないので個人的なイメージにはなりますが、美乳美尻と表現できるくらいの大きさでスラっとした体つきで描いていただきたいです\nポーズ、背景、ビキニのデザインなどはお任せしますが照れて恥ずかしそうな顔、トレーナーの体などは入れずタクトがビキニ姿と分かる構図でお願いします\n\n可能でしたら白ワンピースを上に着てビキニが透けている差分もお願いします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@radium0727/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 946842, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41c97fd032f5509d0d0b4f32c3fbbb36", "srcset": "https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41c97fd032f5509d0d0b4f32c3fbbb36, https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6112f449707d665a3c84efba8b792731 2x, https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f27409ea27fba645b66b5772509899c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47432d63d813e76eaf00ac1a63f12f2b", "srcset": "https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47432d63d813e76eaf00ac1a63f12f2b, https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcbb8b6e2663a001606d3822ae6e2c82 2x, https://si.imgix.net/5d0097e0/uploads/origins/05c485dc-d572-4f6d-98f4-338176f37efd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b199854c0595866b3c0efa5ac3fa43a 3x"}, "body": "さえむら様リクエストをさせて頂きます。キャラはカレンチャンで服装はgaze on me衣装に裸足でお願いします。内容は\n◎トレーナー室のベッドにて布団からはみ出ている誰のかわからない両足足裏（布団の中でカレンチャンは仰向けに寝ていて爆睡しています。かなり深く布団に潜っている為完全に誰かわかりません。布団からはみ出ているのは両足足裏のみとなってます。）をトレーナーがめちゃくちゃくすぐりますがカレンチャンは布団から出ずに布団の中で必死に耐えているとこを描いて頂きたいです。\n※セリフや擬音は任せます。\n※くすぐられている足裏はドアップでお願いしたいです。くすぐられている足裏はめちゃくちゃくすぐったいんだろなぁ、これくすぐったくてたまらないだろうなぁとこちらにも伝わる感じにしてください。例えますと足指がめちゃくちゃ動いてたり開いてたり的なです（大袈裟目な表現でも構いません）。\n※私のイメージですが2コマで上が布団の中でのカレンチャンの反応、表情で下がくすぐられているカレンチャンの足裏のドアップをイメージしてます。最終的な判断は任せます。このリクエスト内容ならこうした方が良い等ありましたら是非してください\n※可能でしたら差分の方をいくつかお願いします\n※布団の外から見たトレーナー視点つまり中が透けて見えてないバージョンもお願いしたいです。\n※くすぐられる前の穏やかな寝顔とくすぐられる前の足そしてくすぐられている最中の我慢できずに笑ってしまったやくすぐりに耐えて涙目なってる、爆睡してはいるが足裏をくすぐられている事により足裏からの違和感を感じている、他にもさえむら様が思いつく限りの色んな表情と足の動きをお願いしたいです。反応、表情はさえむら様のキャラに対する解釈に任せます\n※図々しいですがもし可能でしたらカレンチャンの立ち絵（ポーズは任せます）、くすぐりに耐えきれず飛び起きたカレンをお願いします。\n※デフォルメ描写は無しでお願いします。\nぜひご検討の程お願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@radium0727/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 946842, "client_id": 1032160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0119101/uploads/origins/bf989827-5d1d-4d70-9ec6-eb5985ccaf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=115c5b3d5a9d5113ec73c80135c5cb20", "srcset": "https://s