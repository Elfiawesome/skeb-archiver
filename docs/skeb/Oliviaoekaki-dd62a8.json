み込み（左耳の上）\n・羽\n\n\n◌その他希望内容\n・人物のみの透過画像もいただけると大変ありがたいのですが、ご検討よろしくお願いします。\n　（羽まで描画いただける場合は羽有verと無verの二種のご納品いただいてもよろしいでしょうか…ご無理のない範囲でご検討ください…！）\n・頭部や髪の毛が見切れないように描画いただけますと幸いです。\n\n◌使用用途\n描いていただいたイラストは、以下の内容で使用予定になりますが、使用可能でしょうか。\n・YouTube・tiktok・Twitch等での動画サイトでの使用\n・X（Twitter）ファンボックス等SNS活動（商用含む）に使用\n・グッズやネップリで使用\n・画像の上にテキストやロゴ、告知画像などを重ねての使用\n\n以上について大変お手数をおかけいたしますが、\nご確認・ご検討のほどよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Oliviaoekaki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2653090, "client_id": 3233444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d81a9421/uploads/origins/c900ca23-2aa3-43c3-a8af-8f0523109158?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27e5986e2a0060e5e2b372d70614a1bd", "srcset": "https://si.imgix.net/d81a9421/uploads/origins/c900ca23-2aa3-43c3-a8af-8f0523109158?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27e5986e2a0060e5e2b372d70614a1bd, https://si.imgix.net/d81a9421/uploads/origins/c900ca23-2aa3-43c3-a8af-8f0523109158?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c9261e276835429e25c70b3ed17aee8 2x, https://si.imgix.net/d81a9421/uploads/origins/c900ca23-2aa3-43c3-a8af-8f0523109158?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4512e3dae62c7ff4ca06d1f921a4891d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d81a9421/uploads/origins/c900ca23-2aa3-43c3-a8af-8f0523109158?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1410a201a0e5bf5c07e018ffcfde1842", "srcset": "https://si.imgix.net/d81a9421/uploads/origins/c900ca23-2aa3-43c3-a8af-8f0523109158?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1410a201a0e5bf5c07e018ffcfde1842, https