si.imgix.net/2eb9152a/uploads/origins/692d8a1c-4aaf-4b3d-bbd2-34f757aa84d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34f1f5b5358aa94b4654e3d110949310, https://si.imgix.net/2eb9152a/uploads/origins/692d8a1c-4aaf-4b3d-bbd2-34f757aa84d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd3f33a6a52d16896da263a3fb950169 2x, https://si.imgix.net/2eb9152a/uploads/origins/692d8a1c-4aaf-4b3d-bbd2-34f757aa84d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42f6462278c8717617b44ece19a8068d 3x"}, "body": "こんにちは・・・！あなたの男性の描き方がとても好きです。僕のOCを描いてほしいんだ。彼はチャラい性格の傭兵なんだ。\n\n彼が服を脱ぎ始めるところを見てみたい。彼のシャツは歯で引き上げられ、ズボンを下ろし始めている。シャツとパンツの下には黒のマイクロビキニを着ている。ビキニのトップは少し透けていて、膨らんだ乳首が突き出ている。\n\n少しふくよかな体型で、豊かな胸は筋肉質だが丸みを帯びている。ペニスはそこそこ大きいが、ビキニで隠されている。\n\n彼の様々な衣装の中で取り入れたい個々の要素があれば、どうぞご自由に。\n\nご検討いただければ幸いです！ありがとうございました。\n\nhttps://www.dropbox.com/scl/fo/6nhmscga17643f2cf2dr5/AO2AeAU03m3OF3d44qRldqI?rlkey=tycyj6z49bppk6ughzxytbwbg&st=eugjuywi&dl=0", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaiwa/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 69308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=882a80363e3b199f8fe8e24267821210", "srcset": "https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=882a80363e3b199f8fe8e24267821210, https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7752248e5973a57826bdfc0f4f13cb4 2x, https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72896c8c970494bcc1ad97432cc54807 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56707e37dc3c54c00c9e4f02d7a72085", "srcset": "https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56707e37dc3c54c00c9e4f02d7a72085, https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94b4d9f19896c67a07ea8874a936f80d 2x, https://si.imgix.net/27781021/uploads/origins/e3d15f03-7558-489c-a291-8bea8c7af28b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f9866a3a4e843be06c5decb6454af56 3x"}, "body": "はじめて依頼をお送りさせていただきます。\n筋肉の描き方がすごく素敵だったので、ぜひ依頼させていただきたいです。\nもし可能ならスーパーロボット大戦シリーズから主人公の一人リュウセイ・ダテをお願いできないでしょうか。\n衣裳はパイロットスーツ姿で、戦闘後でヘルメットを脱がせて、汗ばんだイメージにしてほしいです。\n筋肉のボリューム感はいつも描かれているくらい(ルークくんや直近のskeb作品など)くらい盛っていただいても全然大丈夫です！\n念のためNSFWを入れていますが、ぴっちりしたパイロットスーツ越しに筋肉質な身体つきや股間のボリュームがわかるようにしていただきたく、スーツの素材感もラテックスやレザーのようにえっちな光沢を表現してほしいです。\nポーズは立ちポーズでも座りポーズでもお任せしますが、なるべくひざ上以上は収まるようにして、太もものラインや股間がはっきり入るポーズやアングルにしていただけると嬉しいです。\nヘルメットは脱いだ状態であれば持たせても持たせなくても大丈夫です。\nアオリや俯瞰などパースの有無や画角も自由にしていただいて大丈夫です。\nなお、ポーズや表情は主人公らしく・男らしくかっこいい感じや凛々しい雰囲気を出していただきたいです。\nもし可能でしたらぜひお願いいたします！\n\n全身\nパイロットスーツ姿\nhttp://www.gearsonline.net/series/superrobotwars/characters/images/ryusei-3.jpg\n\n\nバストアップ、表情など\nhttps://i.imgur.com/xMTjMbl.jpeg\nhttps://i.imgur.com/PekYbQV.jpeg\nhttps://i.imgur.com/SSWjcxE.jpeg\nhttp://www.gearsonline.net/series/superrobotwars/characters/images/ryusei-4.jpg\n\n\n（参考）軍服姿\nhttps://sjc1.vultrobjects.com/cucdn/gallery-10/art/srtog-ryusei-date.jpg", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaiwa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 69308, "client_id": 644350, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae421885d337f9105f68e652f0d3a58b", "srcset": "https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae421885d337f9105f68e652f0d3a58b, https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76e2cf32bb22356e087fd820de7ae053 2x, https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e21b6531b8f6ca222698d460f4b612f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d96c2fd1e86bbc5ba095d3d62072f8b", "srcset": "https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d96c2fd1e86bbc5ba095d3d62072f8b, https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4877a5c1cdf2665061b66d571c34462a 2x, https://si.imgix.net/6bc33ff6/uploads/origins/a8dedc90-3a5c-470c-8df0-18f4666f9726?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7715e38181f5a19ef2c5ae76e1a8aefc 3x"}, "body": "こんにちは！あなたの絵が大好きです！\n特にルークの描き方が好きです！\n私のオリジナルキャラクターをリクエストしたいです。\n\n私のキャラクターは武道家です。\n強くて筋肉質な体。\n日焼けした肌、明るいブロンドの髪、マゼンタの目（赤ではない）。\n明るく元気。\n戦うときはもっと真剣。\n\n性格も体格もルークに似ている。\n\n胸と左腕に茶色のタトゥーがある。\n参考文献にタトゥーの透過写真を掲載した。\n\nポーズは自由に選べる。\nこの画像ではシャツを脱いでほしい。\n彼の筋肉、特に胸、腹筋、腕がきれいに見えるようにしてほしい。\n自信に満ちた笑顔でいてほしい。\n\n可能であれば、彼の体がキャンバスの上側、左側、右側でトリミングされないようにしてほしい。\n可能であれば、背景が透明なバージョンも希望します。\n\nありがとうございました！\n\nhttps://www.deviantart.com/stash/21mmhlv5rwqk", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akaiwa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 69308, "client_id": 1066156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ceb5607/uploads/origins/662657b8-bae8-48a6-8b7e-39bc0b48d34e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f73726fc8f11f14f0bc2e87c8d04bf9", "srcset": "https://si.imgix.net/1ceb5607/uploads/origins/662657b8-bae8-48a6-8b7e-39bc0b48d34e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f73726fc8f11f14f0bc2e87c8d04bf9, https://si.imgix.net/1ceb5607/uploads/origins/662657b8-bae8-48a6-8b7e-39bc0b48d34e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21c592eb68da7b929559366352c93f85 2x, https://si.imgix.net/1ceb5607/uploads/origins/662657b8-bae8-48a6-8b7e-39bc0b48d34e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d342d7f14718b393810e56a72d25ff6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ceb5607/uploads/origins/662657b8-bae8-48a6-8b7e-39bc0b48d34e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37053b77bbeb3a11db0b0e02133741a6", "srcset": "https://si.imgix.net/1ceb5607/uploads/origins/662657b8-bae8-48a6-8b7e-39bc0b48d34e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&