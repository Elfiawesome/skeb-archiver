姿の立ち絵で描いていただければなと思っております。\n\n金髪で金眼、褐色肌のちょっと悪そうな顔で、ポーズや表情・衣装はテオ様の自由に描いていただければなと思っております。\n\n\n資料画像にツイッター等のURLを載せておりますので、ご参考にしていただければと思います。\nご検討の程よろしくお願い致します。\n\n参考画像１\nhttps://twitter.com/ThinA_Btora/status/1523256904205860865?s=20&t=2cMo_g-cNHXUwugKf_o7Pg\n\n参考画像２\nhttps://twitter.com/ThinA_Btora/status/1354379022956978179?s=20&t=2cMo_g-cNHXUwugKf_o7Pg\n\nhttps://twitter.com/ThinA_Btora", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Theodore_kr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2462539, "client_id": 1114737, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/706df92a/uploads/origins/8f7b28d4-ebaa-471a-8425-45e959df8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58469a2963c743ca76f948f8ea65320f", "srcset": "https://si.imgix.net/706df92a/uploads/origins/8f7b28d4-ebaa-471a-8425-45e959df8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58469a2963c743ca76f948f8ea65320f, https://si.imgix.net/706df92a/uploads/origins/8f7b28d4-ebaa-471a-8425-45e959df8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11707ec34a31a4cf7a8f25f1ac9db60a 2x, https://si.imgix.net/706df92a/uploads/origins/8f7b28d4-ebaa-471a-8425-45e959df8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb093170f0b25a801c22e8f58bcf472c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/706df92a/uploads/origins/8f7b28d4-ebaa-471a-8425-45e959df8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aff22b89e47899efe9e1b9f540249f49", "srcset": "https://si.imgix.net/706df92a/uploads/origins/8f7b28d4-ebaa-471a-8425-45e959df8be5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aff22b89e47899efe9e1b9f540249f49, http