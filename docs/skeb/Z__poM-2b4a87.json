スの眼鏡をかけています。口を開けると、異常に鋭い前歯が見えます。\n\n髪型はこのような感じです：\n\nhttps://www.deviantart.com/stash/0g3cm19j3jh\n\nタマモ・アリアは、低い位置でツインテールに結んだ長いピンク色の髪をしています。垂れ目をしていて、安心感を与えるような笑顔をしています。繊細な容姿と少し軽薄な言動で知られています。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 472572, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "隼人(hayato)", "screen_name": "hayato_il", "avatar_url": "https://pbs.twimg.com/profile_images/1854436829770190849/Ni1TlpR7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/964172138465783808/1751095512/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 599422, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "96sabi", "screen_name": "kinakoyamamori", "avatar_url": "https://pbs.twimg.com/profile_images/1797979523801358336/qSFHZGtB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3420893277/1769493024/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 48}, {"id": 2084615, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "朝霧怜", "screen_name": "asagiri_rey", "avatar_url": "https://pbs.twimg.com/profile_images/1970260385925341184/do65_PCn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1223931433179209729/1729940241/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 6