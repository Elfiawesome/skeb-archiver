4f2-8229-23036998c9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20d623d0889c4a1b02e00faeb8e2ea38 2x, https://si.imgix.net/50de2ac1/uploads/origins/8728ede1-3eb4-44f2-8229-23036998c9ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=214b2d46037d3f45852ce7dae0bfe547 3x"}, "body": "はじめまして。\nVtuber準備中の煎妻あんこと申します。\nSDイラストのツイートを見て、リクエストをいたしました。\n\n縁側でのんびりお茶をしているような、穏やかなキャラクターです。\n\n各種SNS(twitterなど)や配信サイト(Youtubeなど)で、アイコンやサムネイル、イラスト紹介などで使わせていただきたいです。\nVtuber素材(おはVやフレーム)、スタンプや文字を重ねることがあります。\n使用内容としてNGでしたらお断りください。\n\n立ち絵はラフの状態なのですが、\nhttps://twitter.com/ZenzaiAnko/status/1601200977251799040\nにてご確認いただけます。\n\n座っているので服が分かりにくいと思いますので補足します。\n着物ではなく、胸元が和服っぽいデザインのロングスカートワンピースに、割烹着を着ています。\n足元は決まっていません。\nサンダル(ぞうり)、素足、靴下など、なままぐろ先生の感性で仕上げていただけたらと思います。\n猫ちゃんは付属物ではなくペット？なので、いてもいなくてもかまいません。\n暴力と喫煙の表現は避けてくださいますようお願いいたします。\n\nその他、全身・上半身・背景のありなし・ポーズなどの指定はありません。自由に楽しく描いていただけたら嬉しいです。\n逆に指定がないのは描きにくい…ということがありましたら、申し訳ありません。\n\n文字や背景がある場合は、人物のみのイラストも納品いただけるとありがたいです。\n\nどのタイプのテイストも可愛くて、描いていただけるのを楽しみにしています。\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rare_magur0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1809519, "client_id": 895711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/504926f0/uploads/origins/0a5a1468-03fa-4f1a-86c4-6173f78321a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6acda5c0b1c9ff0d414a9685abd8c7de", "srcset": "https://si.imgix.net/504926f0/uploads/origins/0a5a1468-03fa-4f1a-86c4-6173f78321a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6acda5c0b1c9ff0d414a9685abd8c7de, https://si.imgix.net/504926f0/uploads/origins/0a5a1468-03fa-4f1a-86c4-6173f78321a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bce9e1974e4d732072177e2590be49d 2x, https://