3-4ee6-9b19-a1cdd4f7a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=617d64c06f170e269987135e94aa480a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f8a5c53/uploads/origins/24e64662-2423-4ee6-9b19-a1cdd4f7a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ec9ec97be99555c0261308c662dbd6", "srcset": "https://si.imgix.net/0f8a5c53/uploads/origins/24e64662-2423-4ee6-9b19-a1cdd4f7a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ec9ec97be99555c0261308c662dbd6, https://si.imgix.net/0f8a5c53/uploads/origins/24e64662-2423-4ee6-9b19-a1cdd4f7a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c0350960c75b7a9985c08acd584d07d2 2x, https://si.imgix.net/0f8a5c53/uploads/origins/24e64662-2423-4ee6-9b19-a1cdd4f7a0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b7c9f7edf06222baf812d94e45609a6 3x"}, "body": "なままぐろさん、こちらでは はじめまして！\nいつも凄く可愛くて素敵なFAや、サングラスの素材などお世話になっております。\n\nいつか依頼したいなと思い続けていたのですが、\n今回ツイートを拝見し、ぜひ私のSDイラストを描いて頂きたい…！とリクエストした次第です。\nキャンペーンギリギリの滑りこみになってしまい申し訳ありません。\n\n以下概要です。ご検討よろしくお願いいたします。\n\n【キャラ詳細】\n・次期公爵でお嬢様\n・アンティークな物とコスプレが好き\n・明るくて清楚だが、好きなものの話になると暴走しがち\n・人を喜ばせるのが好き。たまにリスナーさんに圧を掛けたりいたずらをすることもある\n・前髪がハートマークに見えるところと、おでこがチャームポイント\n・顔の良さに自信がある\n\n【使用用途】\nYouTubeのサムネイルや配信、Twitter等のSNSの活動におけるプロモーションなど\n\n【希望デザイン】\n・ポーズ、表情\nなままぐろさんのいきいきした動きのある可愛いポーズや構図のイラストが大好きなので、お好きに描いて頂けると嬉しいです…！！\n以前書いて頂いたFAも含め、こちらのイラストが特に表情＋ポーズなど好きです。\nhttps://skeb.jp/@rare_magur0/works/3\nhttps://twitter.com/rare_magur0/status/1597198632083771392?s=20&t=eSvQeiSJlszJSCQsHuSaXQ\nhttps://twitter.com/rare_magur0/status/1502287552044146689?s=20&t=eSvQeiSJlszJSCQsHuSaXQ\n\n【衣装】\nもし可能でしたら、礼服でのイラストをお願いしたく思います。\n衣装が複雑なので、描きにくければ普段着でも全く問題ありません。\nなままぐろさんのイラストが好きなので、どちらになっても嬉しいです。\n\n礼服・普段着共に下記資料URLを参照していただけると幸いです。\n\n【要望】\nサムネイルに使用したいため、髪の毛など左右が見切れていない状態で描いていただきたいです。\n人物と背景・宛名などのレイヤーを分けられるよう、出来たらPSDデータの納品をお願いしたいです。\n\n長くなりましたが、ぜひご検討の程宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1t0eDJRESSNoqNa6Xo45abKYUOCrv1g11?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rare_magur0/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1809519, "client_id": 1185944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c947ae01/uploads/origins/176a5b8c-c93a-47d3-a436-a81a345e6e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83a60e0084e3ab666cc49e705d3e504f", "srcset": "https://si.imgix.net/c947ae01/uploads/origins/176a5b8c-c93a-47d3-a436-a81a345e6e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83a60e0084e3ab666cc49e705d3e504f, https://si.imgix.net/c947ae01/uploads/origins/176a5b8c-c93a-47d3-a436-a81a345e6e69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=792fa53663d7915fe5b8e16d14ab6fb6 2x, https://si.imgix.net/c947ae01/uploads/origins/176a5b8c-c93a-47d3-a436-a81a345e6e69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48d54385b88783d00244974e26f82420 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c947ae01/uploads/origins/176a5b8c-c93a-47d3-a436-a81a345e6e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=016c6c562e75befcfe1c4a7a146c2b7f", "srcset": "https://si.imgix.net/c947ae01/uploads/origins/176a5b8c-c93a-47d3-a436-a81a345e6e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=016c6c562e75befcfe1c4a7a146c2b7f, https://si.imgix.net/c947ae01/uploads/origins/176a5b8c-c93a-47d3-a436-a81a345e6e69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=480b5ab062119ef743476f41fd612363 2