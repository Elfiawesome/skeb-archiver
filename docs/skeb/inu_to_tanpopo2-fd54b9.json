ピンク味がかったオレンジ\n目の形：ぱっちり\n頭部装飾：アンテナ、イナズマの耳飾り\n衣装：デフォルト衣装\nーーーーーーーーーーーーーーーーーーーーーーーーーーー\n\n金額や内容に不足がございましたら、\n再送もしくはキャンセルでお願いいたします。\n制作についてご一考いただけますと幸いでございます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inu_to_tanpopo2/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3967998, "client_id": 3978572, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62a9e4ef/uploads/origins/3642e893-d63d-4c48-bcea-1035652add1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7dfa1dcf627ef5affe0368883ba439", "srcset": "https://si.imgix.net/62a9e4ef/uploads/origins/3642e893-d63d-4c48-bcea-1035652add1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a7dfa1dcf627ef5affe0368883ba439, https://si.imgix.net/62a9e4ef/uploads/origins/3642e893-d63d-4c48-bcea-1035652add1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f97443bab59fa5b3d1df4168b1719651 2x, https://si.imgix.net/62a9e4ef/uploads/origins/3642e893-d63d-4c48-bcea-1035652add1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65f4d4e214d4b00cdc3a199d6ed3761f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62a9e4ef/uploads/origins/3642e893-d63d-4c48-bcea-1035652add1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f0d418f0a9bdba69e6f9b74b4152da1", "srcset": "https://si.imgix.net/62a9e4ef/uploads/origins/3642e893-d63d-4c48-bcea-1035652add1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f0d418f0a9bdba69e6f9b74b4152da1, https://si.imgix.net/62a9e4ef/uploads/origins/3642e893-d63d-4c48-bcea-1035652add1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40f164b0ae9ef12a7490178e81bb02f9 2x, https://si.imgix.net/62a9