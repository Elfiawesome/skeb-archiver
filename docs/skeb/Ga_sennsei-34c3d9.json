b4dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=594216a73280c4e065d9cd88ccfd9f7c, https://si.imgix.net/79332e1b/uploads/origins/88b103e1-4c83-4331-9581-36dff1dcb4dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62b9efdd099a2afacccbf0be9aca4d48 2x, https://si.imgix.net/79332e1b/uploads/origins/88b103e1-4c83-4331-9581-36dff1dcb4dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b2a4732c3ecc65236222fcc85827b1e 3x"}, "body": "こんにちは。\nもし良ければ芋虫自陣を描いてくれませんか。\n危篤なんです。\nよろしくお願いします。\n\n\n\n\n\n\n以下、ネタバレ含む依頼文。\n⋆┈┈┈┈┈┈┈┈┈┈┈┈┈┈⋆\n\n◾︎用途\n・鑑賞/個人利用\n・SNSのアイコンやヘッダーに使用\n・グッズ作成(非営利用)\n・同卓者へ共有\n\n\n\n◾︎依頼内容\n・芋虫自陣がお風呂に入っているイラスト(単色カラーの落書き可)\n↳構図：伊織さんに寄りかかりながら湯船に浮かぶアヒルを見てるシズクと、その様子を愛おしそうに眺めてる伊織さん\n\n⬆️が難しいのであればSDイラスト(構図などはなんでも🙆‍♀️)を描いてほしいです！\n\n\n\n◾︎キャラクター詳細\n【KPC】\n名前：長篠 伊織（ながしの いおり）\n由来……調和・優しさ・気品を意味し、周囲と協力して物事を成し遂げる、思慮深く穏やかな人になってほしいという願い（表面上は）\n\n42歳\nSIZ 12／178cm 71kg（運動不足によるお腹の中性脂肪）\nイメージカラー　#1B335E\n職業　大学教授\n\n一人称 僕、君、〜くん\n【口調】\n「〜だ。」「〜だね」「〜だけど…」\n「〜かい？」\nPCの呼び方「シズクくん」\n\n【容姿】\n青髪の癖っ毛が特徴的な目元が隠れた男性。\n日々の忙しさから気づかないうちに髪と無精髭を蓄えていたタイプ。遺伝で恐らくハゲることはない\n小さい頃からおじさんファッションがデフォルトだったせいで、歳を経ても昔と変わらない服装をしている。\n\n【性格】\n比較的温厚で来る者拒まず去るもの追わずな器の広い人物。\n思慮深く物事を研究者目線で見るきらいがあるせいで、純粋な視点から見ることが出来なくなってしまった。\n\n人と話すことでその人がどのようなものの見方をするのか、どのような感性をしているのか分析することが癖。\n\n・好きな物\n文学、没頭できるもの、人と話すこと\n\n・嫌いな物\nものを粗末にする人\n\nNG行動\n芋虫KPCなので特にないです。\n\n\n\n⋆┈┈┈┈┈┈┈┈┈┈┈┈┈┈⋆\n\n\n【PC】\n名前：今井 シズク（いまい しずく）\n年齢：26歳\n身長：170cm\n職業：ジャーナリスト\n▷▶▷両腕ロスト(肩より先が無い)\n↳現在は義手をつけて生活している)(お風呂中は外している)\n一人称「俺」\nKPCの呼び方「伊織のおっさん」\n\n◤￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣￣\n❏【基本情報】\n　誕生日:6月17日　星座:双子座\n　誕生花:リアトリス、シロツメグサ\n　誕生石:パール\n　血液型:AB型\n　利き手:右\n　カラーコード:#FFD463\n＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿◢\n\n❏【設定】\n▌イメージ / モチーフ\nばなな、ひよこ\n\n▌設定\n明るくて元気！これに限ると思います！\nお仕事が好きで日々が充実している。\n静かな時は静かだけど基本騒いでいる。\n\n好きな食べ物：なんでも好き！\n嫌いな食べ物：ない！でもパクチーはちょっと苦手\n\n\n「今井シズクです！歳は今年で26歳、ジャーナリストやってます」\n「うおっ…！？び、びっくりした…驚かさないでくれよ～…」\n「俺はこの職に誇りを持ってます。」\n\n「なぁなぁ伊織のおっさん！またハンバーグ作ってくれよ」\n「俺、伊織のおっさんと一緒に居れて幸せだ」\n「えへへ、俺は幸せ者だ」\n\n\n▷芋虫通過後\nKPCを探し続け、やっと見つけた際に、笑顔で涙を流しながら「友達になってください」とお願いを申し出た。そこから同居スタート。\n自分が気付いてやれなかったからKPCは犯罪に手を染めてしまったという罪悪感や申し訳なさがあるため、KPCを責め立てる事はない。\nその後色々な事があり、KPCが自分にとってかけがえのない存在だと気付き、告白＆プロポーズ。\n幸せにお世話されている。\n\n▶︎NG行動\nKPCの傍から絶対に離れないし、常にキラキラな笑顔(善意100%)を向けているので、蔑んだりは絶対にしない。\n\n\n\n依頼文に何かしら問題があればキャンセルなりなんなりして頂けたら幸いです🙏\nよろしくお願いします！！！！！\n\n\n資料\n\nhttps://drive.google.com/drive/folders/1ykrk5EXLJw6ZP3vyDqQdHhqsLkTTxYsX", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ga_sennsei/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3326277, "client_id": 3015798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d11b2f1/uploads/origins/d5cbc3cb-6736-4253-91e1-95a41b6e0538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=750550e9d313a88858fd4f3b7be3508b", "srcset": "https://si.imgix.net/9d11b2f1/uploads/origins/d5cbc3cb-6736-4253-91e1-95a41b6e0538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=750550e9d313a88858fd4f3b7be3508b, https://si.imgix.net/9d11b2f1/uploads/origins/d5cbc3cb-6736-4253-91e1-95a41b6e0538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf61e5ee96a5d1d879f95e7954097451 2x, https://si.imgix.net/9d11b2f1/uploads/origins/d5cbc3cb-6736-4253-91e1-95a41b6e0538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=774e434ecb66c2fc1d30d5349345b678 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d11b2f1/uploads/origins/d5cbc3cb-6736-4253-91e1-95a41b6e0538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54d85ce1b6439bbb709133f5b12b3cf0", "srcset": "https://si.imgix.net/9d11b2f1/uploads/origins/d5cbc3cb-6736-4253-91e1-95a41b6e0538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&