duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23f78d57/uploads/origins/db7496ae-bfc3-4d6a-af28-c82325fc2b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e88bb7ee62997d1277db4ab02e0e41b1", "srcset": "https://si.imgix.net/23f78d57/uploads/origins/db7496ae-bfc3-4d6a-af28-c82325fc2b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e88bb7ee62997d1277db4ab02e0e41b1, https://si.imgix.net/23f78d57/uploads/origins/db7496ae-bfc3-4d6a-af28-c82325fc2b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c6b300975b9845d5aedf2e7b156c9ce 2x, https://si.imgix.net/23f78d57/uploads/origins/db7496ae-bfc3-4d6a-af28-c82325fc2b2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6792433b8e8c19cc658875bb1e639b29 3x"}, "body": "書くかも程度ですがドM小説の挿絵に使いたいです\nキャラ/テレスティア、 レイネ、 シルク(https://imgur.com/a/W1jyNLU)\nシチュ：\n着衣超乳&着衣ボテ腹姿の三人にゴミを見る冷めた目(顔の上部や目元まで影がかかり、瞳のハイライトなし希望)で嫌悪・侮蔑されながら、肉塊卵オナホで大量搾精されるドMホイホイシチュ\n押し倒された男性主観視点で一人にオナホコキ、残りの二人に手や触手化指等で左右から乳首責めや性感帯を責められている構図希望です\n\n三人とも片乳だけで胴体以上のサイズかつ服越しの勃起乳首(シルクはピンク色透け乳首描写希望)の着衣超乳&超乳と同サイズの特大着衣ボテ腹が衣装の中に\n押し込まれ強調されている完全着衣状態で、テレスティアの特大妊婦腹で胸～腹部コルセットの×の紐部分が衣装に食い込むぐらいギチギチに引き伸ばされている描写と\n超乳やボテ腹内部に粘液まみれの触手を孕み、大量の触手で蠢き外から見ても歪に変形している描写を希望します\n\n肉塊卵オナホは男性のペニスや玉袋など股間を卵の役割を果たす肉塊がモザイク不要レベルで完全に覆って内部でペニスを嫐っており、\n強烈な刺激で肉塊の先端にコンドームのように特大精液水風船ができるほどの大量射精の様子とオナホコキしている手が肉塊卵の中に埋もれたり肉塊卵が変形する程度に強く握られており、苦痛を感じない程度の握力内部のペニスを圧迫する様子を希望します\n\n背景は触手肉壁もしくは禍々しい感じで、psd形式希望で粘液まみれの肉塊卵が蠢く水音(効果音)の有り/無し、キャラの瞳のハイライト有り/無し差分希望です\n\n可能ならば男性を捕縛して苗床にしているのは自身の身体の一部で男性の理想の女性型疑似餌を作って捕らえる巨大な肉塊の怪物で、\nあくまで彼女たちは男性の好みを模して造られた意思なき肉人形に過ぎず、足や下半身等が肉壁や肉床などと融合している設定希望です\n\nさらに優先度低で、psd形式でON/OFFできる感じで口調やキャラ付けはお任せしますので、\n人間ですらない肉塊に興奮して勃起・射精して受精させる変態マゾ男への嫌悪感MAXの罵倒・侮蔑台詞ができれば希望します\n\n触手化指参考：https://imgur.com/a/GjSqHnJ\n疑似餌参考：https://i.imgur.com/NOfWoqC.png\n肉塊卵参考：\n\nhttps://imgur.com/a/2XRmeKC", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Clo53837533/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f379929a/uploads/origins/1c0d2ccd-7e35-4be4-890f-e3af22fa98cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b22c936956bbb78b22184c3d0689dec", "srcset": "https://si.imgix.net/f379929a/uploads/origins/1c0d2ccd-7e35-4be4-890f-e3af22fa98cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b22c936956bbb78b22184c3d0689dec, https://si.imgix.net/f379929a/uploads/origins/1c0d2ccd-7e35-4be4-890f-e3af22fa98cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bddc90a1fca00816929cb38d110e4cc6 2x, https://si.imgix.net/f379929a/uploads/origins/1c0d2ccd-7e35-4be4-890f-e3af22fa98cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ddc8e835660839c9236c6d04ff7f848 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 384084, "client_id": 2575161, "nc": 48}, {"path": "/@Clo53837533/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 384084, "client_id": 42956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8644f700/uploads/origins/d5576612-007b-4416-b3ee-6f7ddd611448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3b1db353a1146e84fe801bbb6741384", "srcset": "https://si.imgix.net/8644f700/uploads/origins/d5576612-007b-4416-b3ee-6f7ddd611448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3b1db35