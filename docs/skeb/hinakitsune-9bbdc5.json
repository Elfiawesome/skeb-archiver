rd_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rando0501mark2/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1011686, "client_id": 37181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96d198e0bb145c633a73ca5b1f7ca97", "srcset": "https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d96d198e0bb145c633a73ca5b1f7ca97, https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e8e491d01d17bb3abcfed0e45e0a3fc 2x, https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=30e9eeaf5d193c3ce304fbd2cd8b5f42 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21ebfd82fca634686ba6dea6805a2f43", "srcset": "https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21ebfd82fca634686ba6dea6805a2f43, https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=088df931e1a500017e16daadacd6275b 2x, https://si.imgix.net/381e5f32/uploads/origins/05128e56-a645-4e90-b39f-5db25d9405b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=215e580a59d8fba30c7822815cfbb673 3x"}, "body": "初めまして、先生の濃厚なえっちイラストに大変お世話になっております……！\n以下のような内容でイラストをリクエストしたく、よろしくお願いします！   \n\n◯キャラクターとシチュエーション  \nサキュバスプリズンのネメア(人間形態およびサキュバス形態)が、竿役のモブ少年を騎乗位＋エナジードレインで搾り殺しているイラスト\n\n◯詳細（予算の許す範囲でお願いします）\n・構図のイメージは、ラミア(https://www.pixiv.net/artworks/137451348)の後半のような主観騎乗位でお願いします。\n\n・ネメアの服装は、人間形態(白ニット)およびサキュバス形態の両方について、原作通りでお願いします。\n\n・可能であれば、以下のようなストーリー(概要)でセリフ差分を作成いただけますと非常に嬉しいです。なお、シチュエーションや台詞回しについては、先生の書きやすいような内容にしていただければ幸いです。\n\n前半…ネメアが街中でたまたま見つけた、美味しそうな少年を魅了し、家に連れ込んで交わる寸前で魅了を解く。そうして動揺している少年のペニスと秘部で淫らにキスして、ゆっくり挿入。じっくり焦らしてから射精させる。\n\n後半…美味しそうだと感じた第一印象に反して、精液の味はあまり美味しくなかった様子。普段なら甘やかして美味しくしてから優しく搾精するが、今日は少しだけイラっとしておりそんな気分ではなく。味変がてら、過剰過ぎる快感に壊れながら射精する精液を味わおうと、サキュバス形態に変身して容赦ないエナジードレイン+騎乗位ピストンを行う。もはや慈愛に満ちたお姉さんの優しさは無く、無表情or不機嫌そうな表情で搾り尽くされる。\n※どちらかと言うと、後半のシチュの方がメインです。普段は甘々搾精死なネメアによる容赦ない搾精が見たい、という依頼になります。\n\n・竿役はルカや原作主人公ではない、貧相なモブ少年(ショタ寄り)のイメージであることが分かれば、詳細な描写は必要ありません。\n\nご多忙の中で細かい希望が多く恐縮ですが、可能な範囲で何卒ご一考いただけますと幸いです。 よろしくお願いいたします……！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tank1000ml/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3198919, "client_id": 37181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70402d1845db3413da4bdecfc937a3d8", "srcset": "https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70402d1845db3413da4bdecfc937a3d8, https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4d87dd50a8dda1741c70b0e73ee7473 2x, https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37081668c112e2bdfd85b6a09dc1775d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b78efae4f02fd79b646974325fa7050", "srcset": "https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b78efae4f02fd79b646974325fa7050, https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6affd49962a745a4caafcd763c2938d7 2x, https://si.imgix.net/74a35769/uploads/origins/417bf257-f996-4358-a751-6bb97b2fb27e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3076750b8ec06002ac3c23f25c09b427 3x"}, "body": "はじめまして、作酸アメさんの濃厚なえっちイラストに大変お世話になっております……！ \n以下のような内容でイラストをリクエストしたく、よろしくお願いします！  \n\n◯キャラクターとシチュエーション \nもんむすくえすとのマキュバスが、 竿役のモブ少年に覆い被さり、濃厚なディープキスでエナジードレイン＋搾精しているイラスト\n\n◯詳細（予算の許す範囲でお願いします）\n・構図のイメージは、空崎ヒナのキスドレインの1枚目右のような横からの構図でお願いします。\n　（こちらではヒナの方が低身長だったので下からのキスになっていますが、今回はマキュバスの方を高身長にして上からのキスにしてください。）\nhttps://skeb.jp/@tank1000ml/works/9\n\n・イラスト全体の雰囲気は、エヴァのように暗めの感じでお願いします。\nhttps://skeb.jp/@tank1000ml/works/3\n\n・マキュバスは全身が大量の精液まみれでドロドロになっていて欲しいです。可能であればディープキス中の口内も、他の男から搾り取った精液でいっぱいだと嬉しいです。また、胸は原作より大きめでお願いします。\n\n・竿役はルカではない貧相なモブ少年(ショタ寄り)のイメージであることが分かれば、詳細な描写は必要ありません。\n\nご多忙の中で細かい希望が多く恐縮ですが、可能な範囲で何卒ご一考いただけますと幸いです。 よろしくお願いいたします……！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nichibako/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290275, "client_id": 37181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36c5e9a8d842d1c9cf762d6fde3d4689", "srcset": "https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36c5e9a8d842d1c9cf762d6fde3d4689, https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18f941f606dd0763495b55630737ea19 2x, https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8871de62caf49e99a37992fdd70012c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d1f185ac149627a9059b286763c62cb", "srcset": "https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d1f185ac149627a9059b286763c62cb, https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb4ceb95d7c45e3c34fdd64af4061d5b 2x, https://si.imgix.net/951d04bf/uploads/origins/92d8b887-24ba-4bec-86ea-6a8032885e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d40d738e864c014398d9f57c70606cc0 3x"}, "body": "こんにちは、先日は地雷系処刑おまんこ怪人のイラストをありがとうございました…！\n\n今回は新鮮様の小説「財宝収奪ゲーム　マクガフィン」からスルジャンカ様のカラーイラストをご依頼したく、よろしくお願いします。\nhttps://www.pixiv.net/artworks/108957928\n\nシチュエーションとしては、一般ショタプレイヤーが収奪で敗北した後、メイド服を着たままのスルジャンカ様に『射精誘導動作：最強＆魔力：最強の騎乗位：最強腰振り』や『エナジードレイン』で容赦なく搾り殺されるような流れでお願いします。今回もセリフマシマシだと嬉しいです。\n\nまた、以前の地雷系処刑おまんこちゃん依頼時の1枚目ラフ画像（メインシチュエーションの前の導入）が素晴らしかったので、予算が許す範囲であればこちらもご依頼したいです…！\nその際には、収奪に敗北して土下座するショタプレイヤーの頭を踏み躙るスルジャンカ様、という導入をお願いします。\n\n予算面や権利面の許す範囲でご検討いただけますと幸いです、何卒よろしくお願いいたします…！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nichibako/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290275, "client_id": 37181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ba4598c6e4216c240f27bd93c01bdad", "srcset": "https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ba4598c6e4216c240f27bd93c01bdad, https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72ca30cc7eda919028daa6f29c45a391 2x, https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae1d9ba01ea90afeda0c3d9d3d4a71d4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81507789a08a50ecf206ee78cdfffe2b", "srcset": "https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81507789a08a50ecf206ee78cdfffe2b, https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7aea8e3e2f2788be7f65ddaf481062c 2x, https://si.imgix.net/2e46a862/uploads/origins/7cf2683f-caf3-4563-a13e-d409b084bf0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44a48c1815bf59650bc5141cb0b64d92 3x"}, "body": "はじめまして、nichibakoさんの邪悪な魅力があるドスケベイラストにいつもお世話になっております…！\n\nこの度、以前描かれていらっしゃいました「地雷系処刑おまんこ」ちゃんのカラーイラストをご依頼したく、よろしくお願いします。\nhttps://www.pixiv.net/artworks/112451588\n\n構図としては、ワルダモンのように竿役（ショタ）の顔が見えない騎乗位逆レイプをお願いしたいです。\nhttps://www.pixiv.net/artworks/99079021\n\nシチュエーションとしては、何の罪もない一般ショタが怪人に逆レイプされて、死ぬまで精液を搾り尽くされるような流れでお願いします。\n豹変した際の罵倒や侮蔑混じりの淫語がとても大好きだったので、セリフもマシマシにしていただけたら嬉しいです……！\n\n予算の許す範囲でご検討いただけますと幸いです、何卒よろしくお願いいたします！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@to_kage_p/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2238393, "client_id": 37181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9040ee7e1c0caa038b75b75732a3a1e7", "srcset": "https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9040ee7e1c0caa038b75b75732a3a1e7, https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50a448e8e9ecc65ccde30cf924f8aaf1 2x, https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=655b358219090438c4e8ccc6b4fee5ba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bdb15e884298f759fa088749473ab1a", "srcset": "https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bdb15e884298f759fa088749473ab1a, https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5939667f5fc1e6ce4f3e80887bc6f7a 2x, https://si.imgix.net/8cb9bd67/uploads/origins/d061e8ca-19c4-40f0-a0a3-a3b102df1af2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b627cbe9caa26e76588672afc1a9d880 3x"}, "body": "はじめまして、等影Pさんのえっちなイラストに大変お世話になっております……！\n以下のような内容でイラストをリクエストしたく、よろしくお願いします！\n\n◯キャラクターとシチュエーション\nもんむすくえすとのサキュバス（村長）で、\n竿役が映っていない、主観状態の騎乗位イラスト\n（構図のイメージ：等影Pさんのソニアマンユの騎乗位）\nhttps://www.pixiv.net/artworks/115172276\n\n◯詳細（予算の許す範囲でお願いします）\n・イラストの雰囲気は、禍々しい感じでお願いします。\n\n・表情は、原作のように影が掛かった、邪悪で淫らな顔でお願いします。（搾り殺す気満々の表情でお願いします）\nhttps://mon110.sakura.ne.jp/mong/c024.html\n\n・イラスト差分として、①射精前、②射精後、③エナジードレイン差分があると嬉しいです。\n（エナジードレインのイメージ：等影Pさんのリリス）\nhttps://www.pixiv.net/artworks/114974657\n\n・もし可能であれば、以下のようなイメージの台詞差分があると嬉しいです。\n※より筆が進むような台詞案があれば、以下の案よりも優先してください。\n①射精前　　：「サキュバスの膣内に挿入った時点で、貴方は絶対に助からないわ」\n②射精後　　：「それなりの味。飼い続けることも考えたけど、死ぬまで搾ることにするわね」\n③エナドレ中：「一滴残らず射精するまで終わらないわ。最高の快楽の中で息絶えなさい」\nまた、エナドレ差分のどこかにエヴァのような「赤色＋禍々しいフォント」があると嬉しいです。\nhttps://www.pixiv.net/artworks/114122444\n\nご多忙の中で細かい希望が多く恐縮ですが、可能な範囲で何卒ご一考いただけますと幸いです。\nよろしくお願いいたします……！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@DaisakuKimutaku/works/118", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 26499, "client_id": 37181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e753385/uploads/origins/ce424e8b-b737-467a-be24-f40611b89a5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=842081ea67780f3638a3aa54a2de4ddc", "srcset": "https://si.imgix.net/3e753385/uploads/origins/ce424e8b-b737-467a-be24-f