ねっとり熱っぽく少年に囁きかけるシーン\n・お漏らし吐精しているチ◯ポのアップ\n\n　ご多忙の中恐縮ですが、ご検討いただけますと幸いです。よろしくお願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kzkm_skeb/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 296370, "client_id": 37181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01156e399402bebc7f01bcb05fb4bccf", "srcset": "https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01156e399402bebc7f01bcb05fb4bccf, https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ab137978b9eccfc6a37318ff587db18 2x, https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb871efc92b548345b7eab14ad04d2fe 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76fa7cb5ddb84c439744f37f2a3b16a6", "srcset": "https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76fa7cb5ddb84c439744f37f2a3b16a6, https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd6881a57c92d16253da7029500f50bf 2x, https://si.imgix.net/dadbd29b/uploads/origins/c7dcb53c-b28c-4b3a-bbab-94a05f9f14c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15fd0ad6937b13d14b7fd50e2fbbb370 3x"}, "body": "こんにちは、いつもドMホイホイなイラストにお世話になっています……！その中でも特にフウカのイラスト・シチュ(https://skeb.jp/@kazakami_Illust/works/14)が好みだったのでリクエストさせていただきたく存じます……！\n\nシチュエーション:\n顔以外をボコボコに殴られた状態のモブショタにキスしているフウカ。そんなショタのペニスはギンギンに勃起して、糸を引くように我慢汁を垂れ流している……といったシチュをお願いします！\n\n以下、細かい希望です。リクエスト料の許す範囲でお願いします……！\n\n・ショタの殴打痕は、先日のリゼちゃん(https://skeb.jp/@kazakami_Illust/works/12)より遥かに多い感じで\n・キスしている口元あたりで、唾液を啜り取るような凶悪な音が聞こえる\n・2人のポーズは、フウカが両手をショタの顔に添えて、やや斜め上〜真上を向かせながらキスするような姿勢で\n・フウカの表情は、目のハイライトが薄いもしくは消えていて、楽しみと怒りが混じり合ったような笑顔\n・セリフのシチュエーション(要約)は以下のような感じでお願いします(数字は便宜上の時系列です、順番や使う量などはお任せします)\n\n1. ただの雑魚であるショタに髪を傷付けられ(※)、優しく逝かせてあげようと思っていたが気が変わった\n2. チャクラを吸えば簡単に絶命するが、それではつまらないのでボコボコに殴る\n3. 同時に、呼吸を塞ぐ目的+いつチャクラを吸われるか分からない恐怖を与えるために、ずっとキス状態で口内を弄ぶ\n4. 気持ち良く射精すら出来ない状態で、いつ殺されるか分からない恐怖に怯え続けなさい\n\n(※)原作にて、髪の先端を数本、数センチほど切られただけで「髪は女の命……それを傷つけた責任は取って貰うわよ～！」と言いながら豹変し主人公を金縛りにするシーンがあるほど\n\nご多忙の中で細かい希望が多く恐縮ですが、何卒ご一考いただけますと幸いです。よろしくお願いいたします……！", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 37615, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "o-fan🔞C104新刊委託", "screen_name": "_o_fan_", "avatar_url": "https://pbs.twimg.com/profile_images/1817786041446895616/G2ipe36l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/826928420/1722228907/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}], "nc": 49}, {"id": 265995, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ご都合主義者🔞＠ノクターンにて官能小説連載中", "screen_name": "gotsugou_nokuta", "avatar_url": "https://pbs.twimg.com/profile_images/1459330000604131329/-xntlhQv.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master