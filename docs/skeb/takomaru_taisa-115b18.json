top&w=200&h=200&s=dc852e5a3658f88fbcee38677bdd19aa, https://si.imgix.net/7ef74c58/uploads/origins/fc63bdcb-7c76-4a34-9566-001b370c4d99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dbc3bc27b60e1e3a36a15ef425be706 2x, https://si.imgix.net/7ef74c58/uploads/origins/fc63bdcb-7c76-4a34-9566-001b370c4d99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fcb22474bbdafdded3d9ea9386845d4f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ef74c58/uploads/origins/fc63bdcb-7c76-4a34-9566-001b370c4d99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de3e371cedc9e40982b5ddc03d1c82bd", "srcset": "https://si.imgix.net/7ef74c58/uploads/origins/fc63bdcb-7c76-4a34-9566-001b370c4d99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de3e371cedc9e40982b5ddc03d1c82bd, https://si.imgix.net/7ef74c58/uploads/origins/fc63bdcb-7c76-4a34-9566-001b370c4d99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2de491d4c1301294aea97fb3db6aa8ed 2x, https://si.imgix.net/7ef74c58/uploads/origins/fc63bdcb-7c76-4a34-9566-001b370c4d99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c4d970377f8a085707eeb1515a5118d 3x"}, "body": "はじめまして\nryoryo.さんのとても魅力的で素晴らしいキャラクターデザインを拝見してリクエストさせて頂きました。\n私の二つの姿を持つオリジナルキャラクターのキャラクターデザインをして頂けないでしょうか？\n両方の姿を多面図でお願いしたいです。\n\nキャラ設定\n海を司る神や真なる竜の残滓を取り込んだ妖精から産まれた半妖精─ 人類の胎内で胎児と妖精が混ざることで産まれたモノ ─にして、海上都市国家群にて守り神である真なる竜に捧げられる音楽祭を取り仕切る巫女。\n普段は無口な様子やクールな外見に反して、魔導撥弦楽器─エレキギターの魔法版の様なモノ─を携え音楽を邪魔するモノは人類であれ竜種であれ、果てには主である筈の真なる竜であっても正面から貼り倒すロックンローラー。\n外見特徴(ヒト寄りの姿)\n・身長180cm\n・頭から生える竜の様な角\n・横長な瞳孔の眼\n・ギザ歯\n・手足に水掻き\n・腰から生える蛸の様な触手\n・身体のところどころに生える魚の様な鱗\n・ギリシャ風の民族衣装の様な服装\n外見特徴(概念態)\nヒト寄りの姿をベースに\n・頭が三つある多頭(断面が真っ黒になっている首の少し上に生首状態の頭が三つ浮いてるイメージ)\n・下半身が12本の足を持った蛸の様な姿\n・異色肌\n\nそれ以外の要素はお任せします。貴方のデザインがとても好きです。\n\n使用用途は個人鑑賞と他の方に依頼するときの資料、自創作の登場人物としての使用です。\nご検討よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takomaru_taisa/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3460949, "client_id": 237315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93b3dd3b789c5478acb4c5bddd213531", "srcset": "https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93b3dd3b789c5478acb4c5bddd213531, https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c435621805af3b589fb4a4abd8053784 2x, https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19a9bbc221f577ca22d86572e45622ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6de46b8ffa6bdef35e1e7e975d03c47", "srcset": "https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6de46b8ffa6bdef35e1e7e975d03c47, https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9df8074e41e6a69a7f7b1dba112af1f 2x, https://si.imgix.net/81f84bd2/uploads/origins/8c1d7d06-e788-46b4-8c56-df32488c909d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&