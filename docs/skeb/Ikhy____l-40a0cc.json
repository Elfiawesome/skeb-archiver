of Eternal Night and now living in the forest.\n\nPlease draw however you like, and it will be great if you can keep some details in my eyes!\n\nBesides posting on SNS and using it as stream assets, I would also like to use your art on free printable promotional items like postcards. Please have the character and background layer separated in the delivery file if possible.\n\nThank you so much 💙\n\nhttps://drive.google.com/drive/folders/1xrDYP7Vmnx4qIlDMyYdQC8r3M7ktSpua?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ikhy____l/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1970241, "client_id": 2344722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/302b84d0/uploads/origins/6bb869d3-922a-4e16-b8b7-4ec74903db71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c51f6c14d284bb43a4264b19ace8fe", "srcset": "https://si.imgix.net/302b84d0/uploads/origins/6bb869d3-922a-4e16-b8b7-4ec74903db71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c51f6c14d284bb43a4264b19ace8fe, https://si.imgix.net/302b84d0/uploads/origins/6bb869d3-922a-4e16-b8b7-4ec74903db71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2729e15b0da0108a4a7576ad776e723e 2x, https://si.imgix.net/302b84d0/uploads/origins/6bb869d3-922a-4e16-b8b7-4ec74903db71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d9f84c17bb8f21f8bbe5364adf7d52a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/302b84d0/uploads/origins/6bb869d3-922a-4e16-b8b7-4ec74903db71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60a726e7a84e4e72aa48c543f3e9c970", "srcset": "https://si.imgix.net/302b84d0/uploads/origins/6bb869d3-922a-4e16-b8b7-4ec74903db71?bg=%23fff&auto=format