g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c93d504011a81d10734f701cf9669c8e 3x"}, "body": "Hello! I absolutely adore your art style and was hoping to have my vtuber drawn><\n\nHis name is Fanta Reads, and he is a magical librarian vtuber who runs a hidden book cafe. He helps people by using his time and dream magic. He's a bit shy/reserved but has a warm demeanor. He also loves all things BL/yaoi ahahaha＞＜\n\nI was hoping for a picture of him using his magic to make a rainbow appear. This will be used on my Twitter account to celebrate Pride Month; to celebrate the LGBTQ community.\n\nThank you so much for your consideration!\n\nhttps://imgur.com/a/uqN6nQh", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ikhy____l/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1970241, "client_id": 1107772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d01c834e/uploads/origins/4231c0a3-a4aa-46b9-b298-387cdbec70b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2447d647bdf3a753751a2cf0ae39e59", "srcset": "https://si.imgix.net/d01c834e/uploads/origins/4231c0a3-a4aa-46b9-b298-387cdbec70b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2447d647bdf3a753751a2cf0ae39e59, https://si.imgix.net/d01c834e/uploads/origins/4231c0a3-a4aa-46b9-b298-387cdbec70b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=956d3940d245ee027992d5f1e8227d4a 2x, https://si.imgix.net/d01c834e/uploads/origins/4231c0a3-a4aa-46b9-b298-387cdbec70b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fa6e2c77f41814adaa2fe7ee4e3e535 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d01c834e/uploads/origins/4231c0a3-a4aa-46b9-b298-387cdbec70b1?bg=%23fff&aut