ns/13c22e99-5d12-43ba-990d-4a9220da45e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=006fa7824835f012038ee14028de0a65, https://si.imgix.net/6cc22d96/uploads/origins/13c22e99-5d12-43ba-990d-4a9220da45e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64618dc7db0158865bec370e7214908c 2x, https://si.imgix.net/6cc22d96/uploads/origins/13c22e99-5d12-43ba-990d-4a9220da45e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69ce80a6245616b9dd4c0ed746508bfe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cc22d96/uploads/origins/13c22e99-5d12-43ba-990d-4a9220da45e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e77cb2897f38669067e4864db2506372", "srcset": "https://si.imgix.net/6cc22d96/uploads/origins/13c22e99-5d12-43ba-990d-4a9220da45e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e77cb2897f38669067e4864db2506372, https://si.imgix.net/6cc22d96/uploads/origins/13c22e99-5d12-43ba-990d-4a9220da45e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e11922e23d958eb22e29a44dc9c66531 2x, https://si.imgix.net/6cc22d96/uploads/origins/13c22e99-5d12-43ba-990d-4a9220da45e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a75948219dd58f0f7f84833a1cf242f 3x"}, "body": "薄衣さん、こんにちは！\nこの度アピールを頂いた禾ズ真です。\n\nうちの人外娘たちを気に入っていただきありがとうございます！\nアピールから薄衣さんのイラストを拝見して、擬人化ウミウシの女の子たちの絵がとても魅力的に感じました。\n人外感あふれる不思議な雰囲気のある異色肌を描かれる薄衣さんに、ぜひうちの子を依頼したく思います…！\n\n今回はヒロインのリナリーをお願いします。\n資料はこちらになります。\n\n現行衣装\nhttps://www.pixiv.net/artworks/104565548\n\n設定など\nhttps://x.com/psyan75_17_ra/status/1608929243974729732?t=4Qwnid2ODkQTS_FvwXgyDQ&s=19\n\n彼女はこの世界観において元となった花による個体差の激しさから種族と認められず魔物とされるアルラウネであり、その中でも作中において前例のない、自然には咲かないはずの青い薔薇から生まれた謎の多い少女です。\nエルフの薬師にして義理の姉であるルーチェの助手としてヒーラーを務めています。\n\n生まれの記憶を持っておらず正体不明の魔物に等しい立場であることに悩みを抱きつつも、自身を拾った義姉や想い人である主人公のフレスに支えられて自分ならではの生き方を見つけ、それらを克服していく、という設定です。\n\n青薔薇の花言葉や逸話にまつわる「夢を叶える」「奇跡を起こす」才能を秘めています。\n主人公から自身の花言葉を教わったことで、アルラウネの新たな可能性としてその身に宿る言霊を開花させていきます。\n\nかつて生まれ咲いた場所に根差し離れられない身でしたが、義姉が彼女のために代償を支払いとある魔女と「人魚姫の契約」を交わすことで歩ける脚を得ました。\nそのため会いたい人に自分の脚で会いに行ける尊さを噛み締めており、恥ずかしがり屋ながらも積極的に主人公に会いに行き、また義姉の献身を無駄にしないため毎日歩く練習をしています。\n\n外見は三つ編み先端が魔力で変化し咲いた青薔薇や、薔薇のトゲのように髪が硬化したツノ毛、青い爪がアイデンティティです。\n\n以上を踏まえてぜひ薄衣さんの描きたい構図でリナリーを描いていただけると嬉しいです！\n\nリクエスト内容に差し支えなければ、よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@14Qlosilk/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/195e2371/uploads/origins/9b16a406-2e5c-44cc-97b6-8daf3db6d04f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c3c534d3ed73fe5c2f1ea2ef83bcb3a", "srcset": "https://si.imgix.net/195e2371/uploads/origins/9b16a406-2e5c-44cc-97b6-8daf3db6d04f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c3c534d3ed73fe5c2f1ea2ef83bcb3a, https://si.imgix.net/195e2371/uploads/origins/9b16a406-2e5c-44cc-97b6-8daf3db6d04f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3edaa0f9d57e92033e5211bbfbf9ec81 2x, https://si.imgix.net/195e2371/uploads/origins/9b16a406-2e5c-44cc-97b6-8daf3db6d04f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d902b8ba70357d7bdc56f83f64c234f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3389492, "client_id": 2474386, "nc": 33}, {"path": "/@14Qlosilk/works/4", "private_thumbnail_image_urls": null, "private": f