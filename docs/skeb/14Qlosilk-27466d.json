3082\u3042\u3063\u305f\u308a\u3067\u3068\u306b\u304b\u304f\u53ef\u611b\u304f\u3066\u5927\u597d\u304d\u306a\u3093\u3067\u3059\uff01\uff01\n\u304d\u306e\u3053\u306b\u5927\u5909\u9020\u8a63\u304c\u6df1\u3044\u306e\u3067\u3059\u306d\u2026\uff01\u79c1\u3082\u304d\u306e\u3053\u597d\u304d\u3067\u3059\uff01\u7f8e\u5473\u3057\u3044\u3067\u3059\u3088\u306d\u3001\u307e\u3041\u5927\u534a\u304c\u6bd2\u3067\u98df\u7528\u5c11\u306a\u3044\u3093\u3067\u3059\u3051\u3069(\u82e6\u7b11)\u305c\u3072\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u30cd\u30bf\u304c\u3042\u308b\u306e\u3067\u3053\u3061\u3089\u5dee\u3057\u4e0a\u3052\u307e\u3059\uff01\u304a\u4ed8\u304d\u5408\u3044\u9802\u3051\u308c\u3070\u5e78\u3044\u3067\u3059\uff01\n\n\u6226\u56fd\u4e59\u5973\u30b7\u30ea\u30fc\u30ba\u3088\u308a\u3001\u304d\u306e\u3053\u72e9\u308a\u3092\u3059\u308b\u300c\u30d2\u30c7\u30a2\u30ad\u3061\u3083\u3093&\u30ab\u30f3\u30b9\u30b1\u3061\u3083\u3093\u300d\u3092\u304a\u9858\u3044\u3057\u307e\u3059\uff01\n\n\u30fb\u5168\u8eab\u3067\u306a\u304f\u3066OK\n\n\u30fb\u30d2\u30c7\u30a2\u30ad\u3061\u3083\u3093\u3068\u304d\u306e\u3053\u597d\u304d\u30ab\u30f3\u30b9\u30b1\u3061\u3083\u3093\u304c\u304a\u934b\u306e\u6750\u6599\u306b\u3059\u308b\u304d\u306e\u3053\u3092\u8abf\u9054\u3059\u308b\u70ba\u306b\u4e00\u7dd2\u306b\u5c71\u767b\u308a\u3001\u30ad\u30e3\u30f3\u30d7\u3057\u306b\u3044\u304f\u6240\u3092\u898b\u305f\u3044\u2026\u4eca\u5e74\u7206\u8a95\u3057\u305f\u30d2\u30c7\u30ab\u30f3\u59c9\u59b9\u30ab\u30d7\u3082\u3063\u3068\u6d41\u884c\u308c\uff01\uff01\u3068\u3044\u3046\u5984\u60f3\u3067\u3059\u3002\u516c\u5f0f\u52d5\u753b\u300e\u5929\u306b\u821e\u3046\u82b1\u306e\u5982\u304f(Remix)\u300f\u30b5\u30e0\u30cd\u304b\u3089\u7740\u60f3\u3092\u5f97\u3066\u3044\u3066\u3001\u5b9f\u308a\u306e\u79cb\u306a\u3089\u306c\u5b9f\u308a\u306e\u30d2\u30c7\"\u30a2\u30ad\"\u3082\u610f\u8b58\u3057\u3066\u3044\u307e\u3059\u3002(\u30c0\u30b8\u30e3\u30ec\u3067\u3059\u3045\u301c?!)\n\n\u30fb\u69cb\u56f3(\u30b7\u30c1\u30e5)\u3000\u5c71\u306e\u4e2d