bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76a9c514ef1e2d11246fc6d539d3a315 2x, https://si.imgix.net/7778e537/uploads/origins/69e7fab2-8216-467f-b4ed-a4797359603f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fc973001efdc211f7223b042dc08ba6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7778e537/uploads/origins/69e7fab2-8216-467f-b4ed-a4797359603f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a990c3d1c178ec59b4dd9d86486a0ac1", "srcset": "https://si.imgix.net/7778e537/uploads/origins/69e7fab2-8216-467f-b4ed-a4797359603f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a990c3d1c178ec59b4dd9d86486a0ac1, https://si.imgix.net/7778e537/uploads/origins/69e7fab2-8216-467f-b4ed-a4797359603f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f18a1b55647a910875b83c0c5efc226e 2x, https://si.imgix.net/7778e537/uploads/origins/69e7fab2-8216-467f-b4ed-a4797359603f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad34b4f0fea2a02ff78c1ef07bf02602 3x"}, "body": "よもぎ様、はじめまして。\n\n以前からよもぎ様の繊細な色使いや質感がとても素敵で陰ながら拝見させていただいております。\n\n今回は私と友人のOCを描いていただきたくご依頼文を送らせていただきました。(友人の許可は得ています)\n↓以下紹介\n\n篁 大智(たかむら だいち)\n18歳/男/180.4cm/目の色:黒/髪の色:黒\n\n明るく元気な男。くだらない事で笑うことが好き。友人も大切に思っていてみんな好き。\nしかし自己肯定感がかなり低い。自らの存在意義が分からず他者の認識が曖昧。\n人との関わりで自身の虚無を満たそうとするが他者の認識が曖昧なせいでヒビの入ったグラスに水を注ぐように零れていく。愛の境界線もわからない。そのため誰だって好きになれるし、依存できる。\n他者の感情に敏感。\n\n\n㕦皐 朔弥(あまさわ さくや)\n18歳/男/169.7cm/目の色:黒/髪の色:黒\n\n物静かで感情の表出が乏しい男。友人のことは大切に思っている。\n自己形成が曖昧なため自分の存在自体よくわかっていない。\n子供の頃はよく笑う子だったが、大人との歪んだ関係性によりどんどん塞ぎ込んでいった。\nそんな中、篁大地に恋をした。きっかけは不明だが、おそらく大地の無邪気でありながらどこか満たされない笑顔に惹かれたのだと思う。\n朔弥は友人に抱いてはいけない感情だと思い、隠している。\n\n2人の関係値は友人(幼なじみ)。あと3人幼なじみがいて仲良し5人組と呼ばれている。\nおそらく大地は朔弥の恋心に気付いているが自分からは言わない。がこの曖昧な関係に大地は依存しているのかもしれない。朔弥が想い続けることは大地のヒビの入ったグラスに水を注ぎ続けることになるからである。\n\n\n以上が簡単なOCの概要です。\n構図はおまかせします。キャラの色味も見本にこだわらず、よもぎ様のお好きに描いていただいて大丈夫です。\n\nまた描いていただいたイラストは常識の範囲内で個人利用させていただく場合があります。\n\n以上、長くなりましたがよもぎ様のご都合が合いましたらぜひお願いいたします。\n\nhttps://drive.google.com/drive/folders/16sP6bA_z41aiArtfpVEzA22lMeY6Rxqy?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@passion_zassou/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/437cb513/uploads/origins/2b771604-82c9-4df1-b9db-0e23d6fc174e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6f9bc9ee86c7e440ac7cddb5bd617e7", "srcset": "https://si.imgix.net/437cb513/uploads/origins/2b771604-82c9-4df1-b9db-0e23d6fc174e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6f9bc9ee86c7e440ac7cddb5bd617e7, https://si.imgix.net/437cb513/uploads/origins/2b771604-82c9-4df1-b9db-0e23d6fc174e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4a32b03e98907273d0d3658622e77f4 2x, https://si.imgix.net/437cb513/uploads/origins/2b771604-82c9-4df1-b9db-0e23d6fc174e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=630aacca7938eb19d88030d986061eaf 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3700054, "nc": 129}, {"path": "/@passion_zassou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3700054, "client_id": 3373527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a052f7ee/uploads/origins/6b765df6-3c7c-47ae-b9e4-8ccc607ffc7c?bg=%23fff&auto=format%2Ccompress&fm=webp