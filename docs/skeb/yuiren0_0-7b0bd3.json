/uploads/origins/790df518-9333-45d9-a2ce-ab9ef2f61751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b11f3a4c5682a4508fa7129b89250cde, https://si.imgix.net/cc5fe925/uploads/origins/790df518-9333-45d9-a2ce-ab9ef2f61751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0b80268e397b7504d39f0eb2d8dd208 2x, https://si.imgix.net/cc5fe925/uploads/origins/790df518-9333-45d9-a2ce-ab9ef2f61751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=11201d633c09ccda184652b815056331 3x"}, "body": "\uc548\ub155\ud558\uc138\uc694!\n\u3080\u3050\u716e\ub2d8\uc758 \ubd84\uc704\uae30 \uc788\ub294 \uc791\ud488\uc744 \uc88b\uc544\ud569\ub2c8\ub2e4.\n\n\uc774\ubc88\uc5d0\ub294 oc 2\uc778\uc73c\ub85c \uc2e0\uccad\ub4dc\ub9ac\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.\n\ub450 \uc0ac\ub78c\uc740 \ucee4\ud50c\uc774\uba70, \uc5ec\ub984 \ubd84\uc704\uae30\uac00 \ub0ac\uc73c\uba74 \uc88b\uaca0\uc2b5\ub2c8\ub2e4.\n\ucca8\ubd80\ud55c \ub9c1\ud06c \uc18d\uc5d0 \uc678\uad00 \uc790\ub8cc\uc640 \ubd84\uc704\uae30(\uc758\uc0c1, \ud3ec\uc988) \uc790\ub8cc\uac00 \ub4e4\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.\n\uc22b\uc790 \ud30c\uc77c\uc740 \ub2e4\ub978 \ubd84\uaed8 \ubc1b\uc740 \uc774\ubbf8\uc9c0\uc785\ub2c8\ub2e4\ub9cc, \ucc38\uace0\uc5d0 \ub3c4\uc6c0\uc774 \ub418\uc2e4\uae4c \ud558\uc5ec \uac19\uc774 \ub123\uc5b4\ub450\uc5c8\uc2b5\ub2c8\ub2e4!\n\n\ub123\uc5b4\ub454 \uc0ac\uc9c4\uc5d0\uc11c \ud3ec\uc988\ub098 \uc758\uc0c1, \ubc30\uacbd \ub4f1\uc744 \ud3b8\ud558\uac8c \ubc14\uafd4\uc8fc\uc154\ub3c4 \uad1c\ucc2e\uc2b5\ub2c8\ub2e4.\n\ud639\uc2dc \uae08\uc561 \ucd94\uac00\uac00 \ud544\uc694\ud558\ub2e4\uba74 \ucde8\uc18c \ud6c4 \ub2e4\uc2dc \uc694\uccad\ud574\uc8fc\uc138\uc694.\n\n\uac10\uc0ac\ud569\ub2c8\ub2e4!\n\nhttps://drive.google.com/drive/folders/1CEOdFq7pzHvPCkq6GU6aupEGn1piW7LT?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuiren0_0/works/