om at the ryokan (you can change it if you want).", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Halcyon_utaitai/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 854536, "client_id": 950458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=438087a118e8aeeda22ffd693acbf31f", "srcset": "https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=438087a118e8aeeda22ffd693acbf31f, https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38ecc9a1440d4253f7b473a13a9c0647 2x, https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8331405c47d4671f35fc6bed1ba7e179 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=015bbd4fbe105f32b19102f78f2d69d6", "srcset": "https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=015bbd4fbe105f32b19102f78f2d69d6, https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00ea3cb1bb65d75b0cae0dea278a76d3 2x, https://si.imgix.net/7af8dc81/uploads/origins/b87c0adc-e01f-443f-9999-ca56574709d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=c