、ご本人に贈ることがあるかもしれないです。\n\nご検討よろしくお願いします。\n\nYouTuber 皇きんぐちゃん\nhttps://x.com/king_chan_me/status/1975925055285551214?t=40C3T6M28UXsKF4X8UHb3Q&s=19\n\nIRIAMライバー 皇きんぐちゃん\nhttps://x.com/king_chan_me/status/1912090677456093522?t=nQG2AAE88oa2BjAU8b7BBw&s=19\n\nマジック・ザ・ギャザリング（カード裏面）\nhttps://x.com/cropse230526/status/1976970490280575320?t=BxNkBmMFEs2VRsxNgZpFjQ&s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mumei_08/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3704891, "client_id": 408908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e8b3f69/uploads/origins/1bed19fb-32ad-4415-991e-e912231c34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=538fb89998c3e366bde466f0f4417a33", "srcset": "https://si.imgix.net/2e8b3f69/uploads/origins/1bed19fb-32ad-4415-991e-e912231c34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=538fb89998c3e366bde466f0f4417a33, https://si.imgix.net/2e8b3f69/uploads/origins/1bed19fb-32ad-4415-991e-e912231c34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7abd2d85e7a5fa09ee3a4a24dae0c2b7 2x, https://si.imgix.net/2e8b3f69/uploads/origins/1bed19fb-32ad-4415-991e-e912231c34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43011dd232ed278770757b9bb01d74a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e8b3f69/uploads/origins/1bed19fb-32ad-4415-991e-e912231c34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10e0131b0903f1f3a126977543f638db", "srcset": "https://si.imgix.net/2e8b3f69/uploads/origins/1bed19fb-32ad-4415-991e-e912231c34b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10e0131b0903f1f3a126977543f638db, https://si.imgix.net/2e8b3f69/uploads/o