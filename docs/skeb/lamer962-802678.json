igins/94c57420-eddf-4568-8fff-b591b878f415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00bf7d8cae98aed2be3707dc0b3d9261, https://si.imgix.net/6aaf7254/uploads/origins/94c57420-eddf-4568-8fff-b591b878f415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2001d33c30015387390438726d8c9c88 2x, https://si.imgix.net/6aaf7254/uploads/origins/94c57420-eddf-4568-8fff-b591b878f415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fa9d6d80d9f2662df97abd65a36f031 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6aaf7254/uploads/origins/94c57420-eddf-4568-8fff-b591b878f415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37cde7ba98a73649d79a97ce369ebb67", "srcset": "https://si.imgix.net/6aaf7254/uploads/origins/94c57420-eddf-4568-8fff-b591b878f415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37cde7ba98a73649d79a97ce369ebb67, https://si.imgix.net/6aaf7254/uploads/origins/94c57420-eddf-4568-8fff-b591b878f415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c15a89b98f76b016deb85c1905de98a 2x, https://si.imgix.net/6aaf7254/uploads/origins/94c57420-eddf-4568-8fff-b591b878f415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a852ab953e9e997dd00948a6d21f1770 3x"}, "body": "はじめまして！あなたのアートは美しい！\n\nこの二人のオリジナルキャラクターのシーンを描いていただけませんか？ヴィクトリア朝時代（1890年代）のTRPG「コール・オブ・クトゥルフ（CoC）」の舞台の親友です。\n\nしかし、この2人を「不思議の国のアリス」の設定で、以下のキャラクターとして描いてほしい。\nテーマに合わせて、キャラクターの新しい衣装をデザインしてください。\n\nシェイ茶髪の少年。\n物静かで、普段は不思議な笑みを浮かべている。\nアロイスをとてもかわいがっている。\nチェシャ猫のように描いてください。\n\nアロイス金髪の少年。\n大胆でおしゃべり。表情はいつも満面の笑み。\nシェイのことが大好きで、彼のためなら何でもする。\nアリスとして描いてください。\n\nテーマに合った新しい衣装をデザインしてあげてください。\nティーパーティーやバラ園など、不思議の国のアリスをテーマにした絵が見たいです。\nポーズや構図はお任せします！\n\nいずれにせよ、読んでくださって本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uV4Utcsimu