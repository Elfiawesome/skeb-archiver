d-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50cdb444547b14643c15c1bc695308c1", "srcset": "https://si.imgix.net/7aacf3f4/uploads/origins/70cdd7b2-91bd-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50cdb444547b14643c15c1bc695308c1, https://si.imgix.net/7aacf3f4/uploads/origins/70cdd7b2-91bd-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5865bdd0d5c8977726f4605b5dc167fc 2x, https://si.imgix.net/7aacf3f4/uploads/origins/70cdd7b2-91bd-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05306b65f46af7eb1ce57ea66ccff34b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7aacf3f4/uploads/origins/70cdd7b2-91bd-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c50ef769a10a3958efc431899bb9b90a", "srcset": "https://si.imgix.net/7aacf3f4/uploads/origins/70cdd7b2-91bd-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c50ef769a10a3958efc431899bb9b90a, https://si.imgix.net/7aacf3f4/uploads/origins/70cdd7b2-91bd-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2df71890e46f2f12c9ea3c47d919272 2x, https://si.imgix.net/7aacf3f4/uploads/origins/70cdd7b2-91bd-47b9-ad27-a6450b6c3d32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b8ec5f3f3a4227d081d56d7c9f658b56 3x"}, "body": "桜ノ夜様\nこんばんは。初めまして。付箋と申します。\nskeb内で桜ノ夜様のイラストを拝見し、華やかで可愛いイラストに心惹かれました。\n\nぜひ桜ノ夜様に私のOCの一枚絵を描いていただきたいと思い、リクエストさせていただきました。\n\n◆リクエスト内容◆\nポーズや構図など全て桜ノ夜様にお任せします。\n\n可能でしたら、服装は資料の『【衣装】基本1』の服装でお願いします。\n\n資料⇩\nhttps://drive.google.com/drive/folders/1rWJ3axP1dvJt_RKTKaY6usIfZ9S8HDl2\n\n◆人物◆\n【性格】\n姉御肌で頼れるお姉さんタイプ\n好物の大福に目がなく、無邪気な笑顔を見せる\n基本的にガサツだが、髪につけている鈴は贈り物で大切にしている。\n\n◆キャラクターの特徴\n【種族】\n・鬼の人外\n【瞳の色】\n向かって左が灰色、右が明るめな桃色\n【髪色】\n・桃色の長髪\n・毛先が明るい水色になっている。\n【眉・耳の形】\n・まろ眉\n・横に長く大きめのエルフ耳\n【体型・衣装】\n・身長2mほど\n・インナーに太ももまで丈のあるボディスーツを着ている\n・ボディースーツの上から裾の短い着物を着ている。\n・向かって右側の髪と、後ろの髪を大きめの鈴のついた髪ゴムで結ってある。(資料の『表情』にあります)\n\n◆その他◆\nキャラクターのデザイン上、資料になく不明な点は桜ノ夜様の解釈にお任せします。\n\n◆使用用途\n・個人観賞用\n・SNSアイコン等\n\n◆納品形式\n可能であれば宛名やキャラクター等がレイヤー分けされているpsdファイルで納品していただけると嬉しいです。\n画像の縦横比率やサイズはお任せします！\n\n忙しいところ大変恐縮ですが、ぜひ桜ノ夜様にイラストを描いていただきたいです。何卒よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ikura_Mogumogu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3032657, "client_id": 3545770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e56923e3c33d8fcda147617a9d19f716", "srcset": "https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e56923e3c33d8fcda147617a9d19f716, https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bc4862d7b045c93070b2c079bb6f0e0 2x, https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea0caeb0062bab21e44d23c4d880962c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e0b24ccda28e83d84f19d5c5f3d59f8", "srcset": "https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e0b24ccda28e83d84f19d5c5f3d59f8, https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b37ffb06bb122b7efc5d27d9ba63db5a 2x, https://si.imgix.net/c719c13d/uploads/origins/23579056-6797-4679-866f-847430dec537?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5ab998ea14bcb672cfd99c42a5d1e45 3x"}, "body": "こんばんは！いつもイラストやツイート楽しく拝見しています！\n\n伊倉はるさんの描かれるストーリーのあるイラストが大好きです！\n『リクエスト募集中』を見て、ご縁があればぜひ描いていただきたいと思い、リクエスト送らせていただきました。\n\n◆描いていただきたいキャラクター\n付箋のOC 【三葉 如月】\n\n◆イラストの内容\n・『恋人とのデートの待ち合わせ』をテーマにイラストを描いていただきたいです！\n・季節や服装、髪型　など自由です。\n　伊倉さんにお任せします！\n\n◆キャラクターの特徴\n・黒髪〜暗めの青、暗めの紫\n・基本は長髪でふくらはぎまで長いです。\n　(短髪やヘアアレンジもありです○)\n・瞳の色はオッドアイ(向かって左が黄色、右が緑)、吊り目に細めな下がり眉\n・身長195cm\n・体型 長身で細身。\n\n◆性別\n・男性\n\n◆服装について\n基本、白シャツにネクタイ、黒〜紺に近い色のスーツジャケットを着ていますが、服装の指定ありません。\nぜひお好きな服を着させていただきたいです。\n\n◆好きなもの/こと\n・恋人(リナリア・ルーサー)が大好き\n・見た目の可愛い/きれいな食べ物が好き\n・人並みにかっこいいもの(車や腕時計、ロボットなど)が好き\n・プラモデルの組み立てが好き\n\n◆性格\n・恋に落ちやすいが、好きになったらどこまでも一途。\n・かなりロマンチスト\n・誰にでも同じように優しく接するが、恋人には特に甘い\n・他人とどこか一線引いている一面もある\n・コレクター癖があり、一度集め始めたシリーズ物の雑誌をいつまでも集めている。\n\n◆使用用途\n・個人観賞用\n・SNSアイコン等\n\n◆納品形式\n可能であれば宛名やキャラクター等がレイヤー分けされているpsdファイルで納品していただけると嬉しいです。\n画像の縦横比率やサイズはお任せします！\n\nまだリクエストに慣れておらず、不備等がありましたら、お手数おかけしますが、再送をお願いします。\n\n以下資料です⇩\nhttps://drive.google.com/drive/folders/1_8vhiayC8yCWej1sF8sbsbVPb49EDc_d\n\nご縁ありましたら、ぜひ！\nよろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@qsefthukaxdvgnj/works/363", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1506724, "client_id": 3545770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb694b8edfef324500b4549741ca9d36", "srcset": "https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb694b8edfef324500b4549741ca9d36, https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3f1dfeb84455efcd51af5e5011740c2 2x, https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4af0bec465dc7e6698cf2b17952609c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92d7bac19aa5db21495444f4f3997588", "srcset": "https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92d7bac19aa5db21495444f4f3997588, https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d6ba7083ad1d9953e73a5e1964bebf2 2x, https://si.imgix.net/1a65cb89/uploads/origins/ee9fb267-79bb-4419-89b8-a603b4794063?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f44b6ba0342aee48e7d29620fa2112a 3x"}, "body": "うぇ様\nこんばんは。付箋と申します。\nskebの新着イラストでうぇ様のイラストを拝見し、映画のワンシーンを切り取ったような美しいイラストに心惹かれました。\n\nうぇ様の描かれた過去のskebイラストを拝見させていただき、二人組の素敵な日常風景のイラストもあり、うぇ様に私のOCを描いていただきたいと思い、リクエストいたしました。\n\n◆リクエスト内容◆\n二人の日常風景イラスト\n(公園で散歩、カフェでデート、一緒に食事をしているなど、穏やかな日常の一コマを切り取ったようなイラストをリクエストしたいです。)\n\n資料⇩\nhttps://drive.google.com/drive/folders/1eO2p8ZStNfdYwltehF03cPgq0JlT1dJW\n\n◆人物◆\n・黒髪で長髪の男\n性格:優しい。\n(なんでもない日に花束とか送るような)ロマンチスト。紫髪の子が大好きでとにかく一途。\n\n・紫髪の子(無性別ですが男性寄りな見た目)\n性格:自信家。無表情で大人しく見えるが、実はとてもおしゃべり。\n\n◆キャラクターの特徴\n【黒髪で長髪の男】\n・黒髪で長髪(ふくらはぎまで長い。)\n・瞳の色はオッドアイ(向かって左が黄色、右が緑)、吊り目に細めな下がり眉\n・身長195cm\n・体型 長身で細身。\n\n【紫髪の子】\n・瞳の色は明るめな緑の瞳、中心に白く丸い瞳孔、短めで太めの眉毛、3本の下まつ毛\n・前髪が七三分け\n・身長170cm\n・体型:お腹周りと太ももは肉付きが良くやや太め、着痩せする印象\n\n◆二人の関係◆\n他人から見ると黒髪の男が紫髪の子にぞっこんに見える。事実ぞっこんである。\nが、実際は紫髪の子も黒髪の男のことがちゃんと好き。相思相愛。(紫髪本人は『そこそこ』と答える。)\n\n◆その他◆\n服装はどんな衣装でも構いません。うぇ様にお任せします。資料通りでも、日常的に着る服(スウェットやパジャマ、Tシャツ、シンプルな服装、凝った衣装など)でも構いません。シチュエーションに合わせてうぇ様のお好きな服を選んでいただきたいです。\n\n◆使用用途\n・個人観賞用\n・SNSアイコン等\n\n◆納品形式\n可能であれば宛名やキャラクター等がレイヤー分けされているpsdファイルで納品していただけると嬉しいです。\n画像の縦横比率やサイズはお任せします！\n\nリクエスト金額が不足している場合は再申請いたします。\nお忙しいところ大変恐縮ですが、ぜひ、うぇ様にイラストを描いていただきたいです。何卒よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@entertain_y/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3876996, "client_id": 3545770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/658681a9/uploads/origins/c13e41c5-185e-446e-91d9-ac1a3bab19ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=770238c3fb26fc83e9ecbcb7d3b12a64", "srcset": "https://si.imgix.net/658681a9/uploads/origins/c13e41c5-185e-446e-91d9-ac1a3bab19ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=770238c3fb26fc83e9ecbcb7d3b12a64, https://si.imgix.net/658681a9/uploads/origins/c13e41c5-185e-446e-91d9-ac1a3bab19ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd0bd8777b35c594466818406dbc2c08 2x, https://si.imgix.net/658681a9/uploads/origins/c13e41c5-185e-446e-91d9-ac1a3bab19ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=027316da706465c88acd0213c30efb6a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/658681a9/uploads/origins/c13e41c5-185e-446e-91d9-ac1a3bab19ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=