ix.net/4af2950d/uploads/origins/0099d17a-02d1-4d82-a208-b4358ca0289a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41438220a434879d519a13ee8f1930ef 2x, https://si.imgix.net/4af2950d/uploads/origins/0099d17a-02d1-4d82-a208-b4358ca0289a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba0956fcaaf21e84e12b28830a90b0c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4af2950d/uploads/origins/0099d17a-02d1-4d82-a208-b4358ca0289a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8880a070470e41b3d4e4e55f8c12f2a8", "srcset": "https://si.imgix.net/4af2950d/uploads/origins/0099d17a-02d1-4d82-a208-b4358ca0289a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8880a070470e41b3d4e4e55f8c12f2a8, https://si.imgix.net/4af2950d/uploads/origins/0099d17a-02d1-4d82-a208-b4358ca0289a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb6d832bfa1e106a99357fa632338d00 2x, https://si.imgix.net/4af2950d/uploads/origins/0099d17a-02d1-4d82-a208-b4358ca0289a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f6c8b4ef4632566f33a64b2ec446a90 3x"}, "body": "よる様 \n\nよる様が描いたプリコネのシェフィを見て、お願いしたくなりました。\n大変手間のかかる依頼で誠に恐縮ですが、ご検討の程よろしくお願いします。\n\n【概要】\nシェフィから足の裏をくすぐられるイラストを以下のとおり、お願いします。参考の構図では、羽川翼１人がモブ（足のみ見える）をくすぐっていますが、羽川翼をシェフィに差し替えて頂きたいです。\n\nそして、大変手間のかかる内容ですが、以下のとおり【表情差分６種類】と【指と擬音の差分２種類】を掛け合わせた計１２枚をお願いしたいです。\n\n\n【表情差分６種類】\nシェフィの表情差分で「１：優しく微笑む」「２：満面の笑顔」「３：意地悪そうに微笑む」「４：少し怒った表情」「５：かなり怒っているの表情（怒鳴りつけるような表情）」「６：ジト目で軽蔑している表情」の６種類 \n\n【指と擬音の差分２種類】\nくすぐる指の差分で「A：指にくすぐるような残像及び「こちょこちょ」の擬音付き」と「B：指に残像なし、擬音もなし」の２種類\n\n以上により、表情差分６種類×くすぐる指の差分２種類で計１２枚お願いさせていただきます。\n\nまた、以下のとおり細かい希望を書かせていただきます（可能な範囲で問題ありません）。\n\n【シェフィについて】\n・シェフィは通常の衣装。\n・シェフィのグローブは外してほしい（素手でくすぐってほしい）。\n・シェフィの胸を少し大きめにしてほしい。\n・シェフィが少し前かがみで、胸のふくらみを強調してほしい。\n・シェフィのくすぐる指を（男性の）足の裏の真ん中あたりにしてほしい。\n\n【モブ男性の足の裏】\n・羽川翼の参考構図のように足の裏及び足首だけで問題ありません。\n・シェフィのくすぐる指が見えるようモブの足裏は「かなり薄い半透明」を希望。\n・可能であればモブの足の首辺りに枷を付けてほしいです。\n\n【背景】\n・簡素な安宿のベッドを希望です（適当で問題ありません）。\n\n【その他】\n・横長の形状でお願いします（サイズ指定なし）。\n・可能ならpsdファイルも頂きたいです。\n・依頼する絵を私の個人ブログである「マゾ男くん、エッチな女の子にマゾ負けブログ」（https://mazoblog.com/）で自作ブラウザゲーム、動画、小説の挿絵、宣伝等に使用したいです。販売等は致しません。\n\nhttps://www.pixiv.net/artworks/97999029", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IFCtV4pimfZoovU/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1232046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/def63ad5/uploads/origins/a8f325c8-67d9-4aed-9014-8d4f6d027a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f953dd6628715a13042eb9cc9f28c0e", "srcset": "https://si.imgix.net/def63ad5/uploads/origins/a8f325c8-67d9-4aed-9014-8d4f6d027a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f953dd6628715a13042eb9cc9f28c0e, https://si.imgix.net/def63ad5/uploads/origins/a8f325c8-67d9-4aed-9014-8d4f6d027a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a5e38cc1ed6dd2bdb958baa852a5d7b 2x, https://si.imgix.net/def63ad5/uploads/origins/a8f325c8-67d9-4aed-9014-8d4f6d027a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a457cbacd33ca50334bfdb32b61550a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/def63ad5/uploads/origins/a8f325c8-67d9-4aed-9014-8d4f6d027a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5415a0a4ca8baaaba75d34176ec7940b", "srcset": "https://si.imgix.net/def63ad5/uploads/origins/a8f325c8-67d9-4aed-9014-8d4f6d027a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5415a0a4ca8baaaba75d34176ec7940b, https://si.imgix.net/def63ad5/uploads/origins/a8