8eab\u306e\u8a71\u306f\u3042\u307e\u308a\u3057\u306a\u3044\u3002\n\n\u300c\u304a\u30fc\uff01\u4e45\u3057\u3076\u308a\u3060\u306a\uff01\u5143\u6c17\u3057\u3066\u308b\u304b\uff1f\u306a\u3042\u306a\u3042\u3001\u3069\u3063\u304b\u98f2\u307f\u884c\u3053\u3046\u305c\u300d\n\n\u300c\u3059\u307e\u3093\u3001\u305d\u306e\u65e5\u306f\u98f2\u307f\u304c.....\u3042\u30fc\u30fc\u3054\u3081\u3093\u306a\u3001\u3053\u306e\u65e5\u306f\u30b5\u30fc\u30af\u30eb\u3067......\u306f\u306f\u3001\u60aa\u304b\u3063\u305f\u3001\u60aa\u304b\u3063\u305f\u3063\u3066\u7b11\n\u3061\u3083\u3093\u3068\u9023\u7d61\u3088\u3053\u3059\u304b\u3089\u3055\u3001\u306a\uff1f\u30a2\u30f3\u30bf\u3068\u306f\u3055\u3001\u30b5\u30b7\u3067\u98f2\u307f\u305f\u3044\u3057\u3001\u307e\u305f\u805e\u304b\u305b\u3066\u304f\u308c\u3088\u2026\u30a2\u30f3\u30bf\u306e\u3053\u3068\u300d\n\n\u300c\u597d\u304d\u3060\u300d\n\n\u2015\u2015\u2015\n\n\ud83c\udf59\u9bad\u5ddd \u3044\u304f\u3089(\u3055\u3051\u304b\u308f \u3044\u304f\u3089)\n\u7537\u30fb22\u6b73(\u5e74\u9f62\u8981\u76f8\u8ac7\u306a\u305f\u3081\u4eee)\u30fb161\u30fb\u53f3\u5229\u304d\n\u25cf\u30e2\u30c1\u30fc\u30d5\uff1a\u3044\u304f\u3089\n\u25cf\u898b\u305f\u76ee\u306e\u7279\u5fb4\n\u76ee\u2026\u5c11\u3057\u30b8\u30c8\u76ee\u307f\u305f\u3044\u306a\u30aa\u30ec\u30f3\u30b8\u8272\u306e\u3064\u308a\u76ee\n\u9aea\u2026\u3046\u3057\u308d\u3061\u3087\u3044\u7d50\u3073\u306e\u8336\u9aea(\u4e0b\u308d\u3057\u305f\u3089\u30dc\u30d6)\n\u4f53\u683c\u2026\u75e9\u305b\u578b\n\u25cf\u4e00\u4eba\u79f0/\u4e8c\u4eba\u79f0\uff1a\u50d5/\u541b\u30fb\u304a\u524d\n\u25cf\u307f\u3093\u306a\u306e\u547c\u3073\u65b9\uff1a\u65e5\u5411/\u52dd\u5229/\u304a\u524d\u3089\n\u25cf\u8da3\u5473\uff1a\u5bdd\u308b\u3053\u3068\u30fb\u7121\u99c4\u3092\u6e1b\u3089\u3059\u3053\u3068\u30fb\u7bc0\u7d04\n\u25cf\u597d\u304d\uff1a\u767d\u7c73\u30fb\u304a\u306b\u304e\u308a\u30fb\u548c\u98df\u30fb\u7761\u7720\n\u25cf\u5acc\u3044\uff1a\u7121\u99c4\u30fb\u5e38\u8b58\u306e\u306a\u3044\u4eba\u30fb\u9b3c\u3054\u3063\u3053\u30fb\u866b\u30fb\u6c5a\u3044\u7269\n\n\u3081\u3093\u3069\u304f\u3055\u304c\u308a\u5c4b\u3060\u3051\u3069\u5b8c\u74a7\u4e3b\u7fa9\u3067\u6f54\u7656\u75c7\u3002\u9762\u5012\u4e8b\u306b\u5dfb\u304d\u8fbc\u307e\u308c\u308b\u306e\u304c\u5acc\u3067\u4f55\u3088\u308a\u3082\u81ea\u5206\u304c\u6700\u512a\u5148\u306a\u4e00\u5339\u72fc\u3002\u52aa\u529b\u306b\u88cf\u5207\u3089\u308c\u305f\u5c11\u5e74\u306e\u5fa9\u8b90\u3002\n\n\u604b\u611b\u306e\u8208\u5473\u306f\u306a\u3057\u3001\u604b\u4eba\u306f\u548c\u98df\u3068\u7761\u7720\u3002\u30c9\u304c\u4ed8\u304f\u307b\u3069\u306e\u767d\u7c73\u30aa\u30bf\u30af\u3002\n\u6c5a\u3044\u3082\u306e\u306f\u7121\u7406\u3002\u89e6\u308a\u305f\u304f\u306a\u3044\u3057\u8a71\u3057\u305f\u304f\u3082\u306a\u3044\u3002\u866b\u3082\u540c\u69d8\u3002\u98df\u4e8b\u306e\u6700\u4e2d\u306b\u6c5a\u3044\u7269\u3084\u866b\u306e\u8a71\u3092\u3055\u308c\u308b\u306e\u304c\u4f55\u3088\u308a\u3082\u7121\u7406\u3002\n\n\u7269\u306b\u5bfe\u3057\u3066\u300c\u5acc\u3044\u300d\u3068\u306f\u8a00\u3046\u304c\u3001\u4eba\u306b\u5bfe\u3057\u3066\u300c\u5acc\u3044\u300d\u3068\u3044\u3046\u3053\u3068\u306f\u7121\u3044\u3002\u305f\u3060\u3001\u614b\u5ea6\u306b\u306f\u51fa\u308b\u3002\n\n\u300c\u3046\u308b\u3055\u2026\u7761\u7720\u306e\u90aa\u9b54\u306a\u3093\u3060\u3051\u3069\u3001\u9ed9\u3063\u3066\u3082\u3089\u3063\u3066\u3044\u3044\uff1f\u300d\n\n\u300c\u307b\u3072\u3072\u3072\u306f\u307b\u307b\u306f\u306f\u307b\u3072\u307b\u306f\u3072\u3072\u306f\u3093\u307b\u3072\u3072\u3072\u307b\u3072\u3063\u3078\u3075\uff1f(\u304a\u306b\u304e\u308a\u306f\u305d\u306e\u307e\u307e\u304c\u4e00\u756a\u304a\u3044\u3057\u3044\u306e\u77e5\u3063\u3066\u308b\uff1f)\u300d\n\n\u300c\u30a2\u30a4\u30de\u30b9\u30af\u3068\u8033\u6813\uff1f\u3001\u304a\u524d\u3089\u304c\u3046\u308b\u3055\u3044\u304b\u3089\u305d\u308c\u3092\u30b7\u30e3\u30c3\u30c8\u30c0\u30a6\u30f3\u3059\u308b\u305f\u3081\u306b\u3042\u308b\u3082\u3093\u3060\u3051\u3069\u3002\u300d\n\n\u300c\u30e4\u30c0\u3002\u884c\u304b\u306a\u3044\u3002\u305d\u3093\u306a\u3068\u3053\u884c\u304f\u6687\u3042\u308b\u306a\u3089\u4ed6\u306e\u4e8b\u3057\u3066\u305f\u65b9\u304c\u201d\u30de\u30b7\u201d\u3002\u300d\n\n\u30fc\u30fc\u30fc\n\n\ud83d\udc3c \u5f92\u82b1 \u52dd\u5229\uff08\u304b\u3061\u304b\u3057\u3087\u3046\u308a\uff09\n\u7537\u30fb22\u6b73\uff08\u4eee\uff09\u30fb178cm\u30fb\u53f3\u5229\u304d\n\u25cf\u30e2\u30c1\u30fc\u30d5\uff1a\u30d1\u30f3\u30c0\u3001\u7b39\n\u25cf\u898b\u305f\u76ee\u306e\u7279\u5fb4\n\u76ee\u2026\u30b0\u30ec\u30fc\u76ee\n\u9aea\u2026\u9ed2\u9aea\u3001\u895f\u8db3\u30a4\u30f3\u30ca\u30fc\u306b\u7dd1\n\u4f53\u683c\u2026\u3046\u3063\u3059\u3089\u3068\u7b4b\u8089\u306e\u3042\u308b\u5065\u5eb7\u4f53\u3002\u30b8\u30e0\u3084\u904b\u52d5\u3068\u3044\u3046\u3088\u308a\u306f\u5b50\u4f9b\u306e\u9803\u304b\u3089\u306e\u30d0\u30a4\u30c8\u4e09\u6627\u306e\u751f\u6d3b\u306e\u4e0a\u3067\u3064\u3044\u305f\u7b4b\u8089\n\u25cf\u4e00\u4eba\u79f0/\u4e8c\u4eba\u79f0\uff1a\u4ffa\u3061\u3083\u3093/\u304a\u524d\n\u25cf\u4e09\u4eba\u79f0\uff1a(\u540d\u524d)\u3061\u3083\u3093\u3001(\u540d\u524d)\u30bb\u30f3\u30d1\u30a4/\u30d1\u30a4\u30bb\u30f3\u3001(\u540d\u524d)\u3055\u3093\n\u25cf\u307f\u3093\u306a\u306e\u547c\u3073\u65b9\n\ud83d\udc41\u3072\u3085\u30fc\u304c\u3061\u3083\u3093\n\ud83c\udf59\u3044\u304f\u3089\u3061\u3083\u3093\n\u25cf\u53e3\u7656/\u8a9e\u5c3e(\u3042\u308c\u3070)\uff1a\u3061\u3063\u3061\u3083\u3044\u30ab\u30bf\u30ab\u30ca\u304c\u5165\u308a\u304c\u3061\n\u25cf\u8da3\u5473\uff1a\u304a\u91d1\u7a3c\u304e\u3068\u9152\u30bf\u30d0\u30b3\u30fb\uff08\u3061\u3087\u3063\u3068\u3057\u305f\uff09\u30ae\u30e3\u30f3\u30d6\u30eb\n\u25cf\u597d\u304d\uff1a\u91d1\u3001\u4e2d\u83ef\u6599\u7406\u3001\u53cb\u60c5\u30fb\u52aa\u529b\u30fb\u52dd\u5229\n\u25cf\u5acc\u3044\uff1a\u304a\u91d1\u304c\u7121\u304f\u306a\u308b\u3053\u3068\u3001\u898b\u653e\u3055\u308c\u308b\u3053\u3068\n\n\u4e2d\u83ef\u8857\u3067\u30d0\u30a4\u30c8\u3092\u3059\u308b\u4e16\u6e21\u308a\u4e0a\u624b\u306a\u5927\u5b66\u751f\u3002\n\u660e\u308b\u304f\u3078\