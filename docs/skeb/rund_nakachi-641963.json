u306b\u306f\u201c\u6210\u529f\u3059\u308c\u3070\u7634\u6c17\u3092\u65ad\u3064\u304c\u3001\u5931\u6557\u3059\u308c\u3070\u4e16\u754c\u306e\u7406\u3092\u58ca\u3059\u201d\u3068\u8a18\u3055\u308c\u3066\u3044\u305f\u3002\n\n\u7d50\u679c\u306f\u2500\u2500\u5931\u6557\u3002\n\n\u5c01\u5370\u306f\u4e0d\u5b8c\u5168\u306a\u307e\u307e\u66b4\u8d70\u3057\u3001\u5927\u5730\u306b\u306f\u3055\u3089\u306b\u591a\u304f\u306e\u88c2\u3051\u76ee\u304c\u751f\u307e\u308c\u3001\n\u7634\u6c17\u306f\u304b\u3048\u3063\u3066\u5897\u5e45\u3055\u308c\u3066\u3057\u307e\u3063\u305f\u3002\n\n\u25a0 \u7981\u5fcc\u306e\u8853\u306e\u5931\u6557\u5f8c\u306b\u8d77\u3053\u3063\u305f\u6226\n\u8853\u306e\u66b4\u8d70\u3067\u7634\u6c17\u304c\u5404\u5730\u306b\u6ea2\u308c\u8fd4\u3063\u305f\u3053\u3068\u3067\u3001\n\u5996\u602a\u305f\u3061\u306f\u7634\u6c17\u3092\u904e\u5270\u306b\u53d6\u308a\u8fbc\u307f\u3001\u6b21\u3005\u3068\u72c2\u66b4\u5316\u3057\u3066\u3044\u3063\u305f\u3002\n\n\u7406\u6027\u3092\u5931\u3044\u3001\u4eba\u3082\u5996\u602a\u3082\u533a\u5225\u306a\u304f\u8972\u3046\u3088\u3046\u306b\u306a\u308b\u3002\n\u72c2\u66b4\u5316\u3057\u305f\u5996\u602a\u3092\u8a0e\u4f10\u3059\u308b\u305f\u3081\u3001\u9670\u967d\u5e2b\u306f\u5404\u5730\u306b\u6d3e\u9063\u3055\u308c\u308b\u3002\n\u6162\u6027\u7684\u306a\u6226\u95d8\u3068\u6d88\u8017\u306b\u3088\u308a\u3001\u4eba\u9593\u5074\u306e\u9632\u885b\u7dda\u306f\u3058\u308f\u3058\u308f\u3068\u5d29\u58ca\u3002\n\u3084\u304c\u3066\u5c0f\u7af6\u308a\u5408\u3044\u306f\u672c\u683c\u7684\u306a\u6226\u3078\u3068\u767a\u5c55\u3057\u3001\n\u300c\u5996\u7953\uff08\u3088\u3046\u3075\u3064\uff09\u306e\u4e71\u300d \u3068\u5f8c\u306b\u547c\u3070\u308c\u308b\u9577\u3044\u6df7\u4e71\u306e\u6642\u4ee3\u304c\u8a2a\u308c\u308b\u3002\n\n\u7634\u6c17\u306f\u6b62\u307e\u3089\u305a\u3001\u5996\u602a\u306f\u8352\u308c\u72c2\u3044\u3001\u9670\u967d\u5e2b\u305f\u3061\u306f\u75b2\u5f0a\u3002\n\u304b\u3064\u3066\u5171\u5b58\u3057\u3066\u3044\u305f\u4e16\u754c\u306f\u3001\u97f3\u3092\u7acb\u3066\u3066\u5d29\u308c\u3064\u3064\u3042\u3063\u305f\u3002\n\n\n\n\u2015\u4e8c\u3064\u306e\u672c\u9663\u2500\n\n\u25a0\u5996\u602a\u8ecd\u672c\u9663 \u2015 \u8ff7\u754c\u306e\u5ec3\u5bfa(\u3081\u3044\u304b\u3044\u306e\u306f\u3044\u3058)\n\u304b\u3064\u3066\u306f\u5c71\u5965\u3067\u9759\u304b\u306b\u4fe1\u4ef0\u3055\u308c\u3066\u3044\u305f\u53e4\u5bfa\u3002\n\u4eca\u306f\u5929\u4e95\u3082\u5d29\u308c\u3001\u82d4\u3080\u3057\u305f\u74e6\u304c\u843d\u3061\u3001\u5802\u306e\u67f1\u306f\u7634\u6c17\u3067\u9ed2\u304f\u67d3\u307e\u3063\u305f\u307e\u307e\u653e\u7f6e\u3055\u308c\u3066\u3044\u308b\u3002\u3057\u304b\u3057\u3001\u305f\u3060\u306e\u5ec3\u589f\u3067\u306f\u306a\u3044\u3002\n\u68ee\u305d\u306e\u3082\u306e\u304c\u8ff7\u3044\u306e\u7363\u3068\u306a\u308b\u3002\n\u5996\u602a\u305f\u3061\u304c\u8b77\u3063\u3066\u3044\u308b\u3068\u3044\u3046\u3088\u308a\u3001\"\u68ee\u81ea\u4f53\u304c\u5996\u602a\u8ecd\u3092\u5b88\u308b\u3088\u3046\u306b\u52d5\u3044\u3066\u3044\u308b\"\u3002\n\u9670\u967d\u5e2b\u304c\u8db3\u3092\u8e0f\u307f\u5165\u308c\u308b\u3068\u3001\u65b9\u89d2\u304c\u72c2\u3046\u3002\n\u4e00\u5ea6\u898b\u305f\u6728\u3005\u304c\u4f55\u5ea6\u3082\u7e70\u308a\u8fd4\u3057\u73fe\u308c\u3001\u7167\u3089\u3057\u305f\u306f\u305a\u306e\u706f\u660e\u304c\u9006\u65b9\u5411\u306b\u63fa\u308c\u308b\u3002\n\u9727\u304c\u5f62\u3092\u5909\u3048\u3001\u307e\u308b\u3067\u8ab0\u304b\u304c\u6848\u5185\u3057\u3066\u3044\u308b\u3088\u3046\u306b\u9053\u3092\u5909\u3048\u308b\u3002\n\u3053\u308c\u306f\u9280\u7962\u3084\u9ed2\u8000\u304c\u5f35\u3063\u305f\u7d50\u754c\u3067\u306f\u306a\u3044\u3002\n\u3080\u3057\u308d\u3001\"\u7634\u6c17\u306e\u88c2\u3051\u76ee\u306b\u8fd1\u3044\u305b\u3044\u3067\u68ee\u304c\u534a\u3070\u751f\u304d\u7269\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u305f\"\u3068\u3044\u3046\u65b9\u304c\u8fd1\u3044\u3002\n\u5996\u602a\u305f\u3061\u306f\u3053\u306e\u68ee\u306e\u7656\u3092\u77e5\u3063\u3066\u3044\u308b\u304b\u3089\u6b69\u3051\u308b\u3002\n\u3060\u304c\u9670\u967d\u5e2b\u306f\u65b9\u5411\u611f\u899a\u3092\u596a\u308f\u308c\u3001\u5bb9\u6613\u306b\u306f\u8fd1\u3065\u3051\u306a\u3044\u3002\n\n\uff1c\u8352\u308c\u3066\u3044\u308b\u306e\u306b\u6e29\u304b\u3044\u5834\u6240\uff1e\n\u9280\u7962\u306f\u8c6a\u5962\u3092\u597d\u307e\u305a\u3001\"\u4ef2\u9593\u304c\u5bdd\u308b\u5834\u6240\u3055\u3048\u5b88\u308c\u308c\u3070\u826f\u3044\"\u30bf\u30a4\u30d7\u3002\u3060\u304b\u3089\u8c6a\u83ef\u3055\u306f\u306a\u3044\u3002\n\u58c1\u306f\u5d29\u308c\u3001\u96e8\u6f0f\u308a\u3082\u3042\u308b\u3002\n\u53e4\u3044\u4ecf\u50cf\u3060\u3051\u304c\u9759\u304b\u306b\u6b8b\u3055\u308c\u3066\u3044\u308b\u3002\n\u6e6f\u6c17\u306e\u7acb\u3064\u5927\u934b\u304c\u3044\u3064\u3082\u711a\u304b\u308c\u3066\u3044\u3066\u3001\u5996\u602a\u305f\u3061\u306e\u7b11\u3044\u58f0\u304c\u97ff\u304f\u3002\u3069\u3053\u304b\u4eba\u306e\u6e29\u304b\u3055\u3082\u6b8b\u308b\u3002\n\u8352\u308c\u3066\u3044\u308b\u3051\u3069\u3001\u5bc2\u3057\u304f\u306a\u3044\u3002\n\u3053\u3053\u306b\u6a12\u304c\u6765\u308b\u3068\u3001\u300c\u2026\u2026\u3053\u3093\u306a\u5834\u6240\u306a\u306e\u306b\u3001\u306a\u305c\u304b\u843d\u3061\u7740\u304f\u306a\u300d\u3068\u611f\u3058\u59cb\u3081\u308b\u3002\n\u9280\u7962\u306e\"\u5bb6\u65cf\u3092\u5927\u4e8b\u306b\u3059\u308b\u6027\u683c\"\u304c\u53cd\u6620\u3055\u308c\u305f\u5834\u6240\u3060\u3002\n\n\u25a0\u9670\u967d\u5e2b\u8ecd\u672c\u9663 \u2015 \u5929\u5bae\u306e\u5927\u793e(\u3066\u3093\u3050\u3046\u306e\u305f\u3044\u3057\u3083)\n\u5996\u602a\u8ecd\u3068\u306f\u771f\u9006\u3067\u3001\u9670\u967d\u5e2b\u8ecd\u306e\u672c\u9663\u306f\u53b3\u683c\u3067\u8358\u53b3\u306a\u795e\u57df\u3002\n\u6e05\u6d44\u3059\u304e\u3066\u3001\u6a12\u304c\u6700\u3082\u82e6\u624b\u3068\u3059\u308b\u74b0\u5883\u3067\u3082\u3042\u308b\u3002\n\n\uff1c\u5b8c\u74a7\u306a\u5bfe\u79f0\u6027\u3001\u6574\u3063\u305f\u767d\u3068\u6731\uff1e\n\u767d\u6728\u306e\u56de\u5eca\u304c\u4e00\u76f4\u7dda\u306b\u4f38\u3073\u3001\u6731\u5857\u308a\u306e\u5927\u9ce5\u5c45\u304c\u5e7e\u91cd\u306b\u3082\u91cd\u306a\u308a\u3001\u6c34\u76e4\u306f\u93e1\u306e\u3088\u3046\u306b\u6f84\u3093\u3067\u3044\u308b\u3002\u98a8\u9234\u306e\u97f3\u304c\u5e38\u306b\u6f84\u3093\u3067\u9cf4\u308b\u3002\n\u305d\u3053\u306b\u306f\u300c\u79e9\u5e8f\u300d\u3068\u300c\u6e05\u6d44\u300d\u306e\u529b\u304c\u6e80\u3061\u3066\u3044\u308b\u3002\n\u5996\u602a\u304c\u5165\u308b\u3068\u4e00\u6b69\u3067\u6d44\u5316\u3055\u308c\u308b\u3002\u7634\u6c17\u304c\u6fc3\u3044\u8005\u306f\u82e6\u3057\u3093\u3067\u5012\u308c\u308b\u3002\n\u516d\u9053\u6727\u306e\"\u7121\u5f62\u306e\u5c01\"\n\u5927\u793e\u306b\u306f\u6727\u304c\u4f5c\u308b\u7279\u6b8a\u306a\u7d50\u754c\u304c\u3042\u308b\u3002\n\u76ee\u306b\u898b\u3048\u306a\u3044\u304c\u3001\u7a7a\u6c17\u304c\u51b7\u305f\u304f\u5f35\u308a\u8a70\u3081\u3066\u3044\u308b\u3002\n\u4eba\u306e\u6c17\u914d\u304c\u6d88\u3048\u3059\u304e\u308b\u3002\u8db3\u97f3\u3059\u3089\u5438\u3044\u8fbc\u307e\u308c\u308b\u3002\u591c\u306f\u6708\u304c\u767d\u304f\u3001\u6e29\u5ea6\u3092\u596a\u3046\u3002\u5fc3\u306e\u52d5\u304d\u307e\u3067\u76e3\u8996\u3055\u308c\u3066\u3044\u308b\u3088\u3046\u306a\u7a7a\u6c17\u3002\n\u5996\u602a\u304c\u5165\u308c\u3070\u5373\u5ea7\u306b\u5f31\u4f53\u5316\u3059\u308b\u3002\n\u3053\u3053\u306f\u300c\u7f8e\u3057\u3044\u304c\u8fd1\u5bc4\u308a\u304c\u305f\u3044\u300d\u300c\u767d\u3059\u304e\u3066\u523a\u3055\u308b\u300d\u3001\u305d\u3093\u306a\u7dca\u5f35\u611f\u3092\u6301\u3064\u3002\n\u9280\u7962\u304c\u8db3\u3092\u8e0f\u307f\u5165\u308c\u305f\u3089\u3001\u4e00\u77ac\u3067\"\u6575\u5730\u306e\u51b7\u305f\u3055\"\u304c\u4f1d\u308f\u308b\u5834\u6240\u3060\u3002\n\n\n\u2500\u767b\u5834\u4eba\u7269\u9332\u2500\n\n\u6a12(\u3057\u304d\u307f)\n\u6240\u5c5e \u9670\u967d\u5e2b\u8ecd\n\u5f79\u8077 \u8adc\u5831\u54e1\n\u7a2e\u5225 \u7634\u6c17\u6d44\u5316\u306e\u5668(\u546a\u8853\u7cfb\u8b5c)\n\u4eba\u79f0 \u79c1\u3001\u8cb4\u65b9\u3001\u25cb\u25cb\u69d8\u3001\uff08\u6575\u610f\u304c\u3042\u308b\u76f8\u624b\uff09\u8cb4\u69d8\n<\u6982\u8981>\n\u516d\u9053\u6727\u306e\u5bc6\u547d\u3092\u53d7\u3051\u3001\u5358\u8eab\u3067\u5996\u602a\u8ecd\u306b\u6f5c\u5165\u3059\u308b\u9752\u5e74\u3002\n\u5e7c\u304f\u3057\u3066\"\u4eba\u5f62\"\u306e\u3088\u3046\u306b\u80b2\u3066\u3089\u308c\u305f\u305f\u3081\u3001\u611f\u60c5\u8868\u73fe\u306f\u4e4f\u3057\u304f\u3001\u9759\u304b\u306b\u4efb\u52d9\u3092\u9042\u884c\u3059\u308b\u59ff\u304c\u7279\u5fb4\u3002\n<\u80cc\u666f>\n\u6a12\u306f\u5100\u5f0f\u306b\u3088\u3063\u3066\u751f\u307f\u51fa\u3055\u308c\u305f\"\u7634\u6c17\u3092\u5438\u3044\u6d44\u5316\u3059\u308b\u5668\"\u3067\u3042\u308a\u3001\u7634\u6c17\u3092\u53d6\u308a\u8fbc\u3080\u3053\u3068\u306f\u3067\u304d\u3066\u3082\u3001\u653e\u51fa\u3059\u308b\u8853\u3092\u6301\u305f\u306a\u3044\u3002\n\u305d\u306e\u4f53\u8cea\u306f\u3001\u4e26\u306e\u4eba\u9593\u3092\u9065\u304b\u306b\u8d85\u3048\u308b\u8010\u6027\u3092\u6301\u3064\u4ee3\u308f\u308a\u306b\u3001\u5438\u53ce\u3057\u7d9a\u3051\u308c\u3070\u8eab\u4f53\u304c\u5f90\u3005\u306b\u8755\u307e\u308c\u3001\u3044\u305a\u308c\u673d\u3061\u308b\u3068\u3044\u3046\u5bbf\u547d\u3092\u80cc\u8ca0\u308f\u305b\u305f\u3002\n<\u6027\u683c>\n\u5be1\u9ed9\u3067\u6de1\u3005\u3068\u3057\u3066\u3044\u308b\u304c\u3001\u4eba\u3068\u3057\u3066\u306e\u512a\u3057\u3055\u306f\u6df1\u304f\u6839\u4ed8\u3044\u3066\u304a\u308a\u3001\u3075\u3068\u3057\u305f\u77ac\u9593\u306b\u305d\u306e\u7e4a\u7d30\u3055\u304c\u6ef2\u3080\u3002\u7518\u5473\u3092\u597d\u3080\u3002\n<\u7279\u8a18\u4e8b\u9805>\n\u85ac\u9b3c\u3068\u306e\"\u5951\u308a\"\u306b\u3088\u308a\u4ee5\u5fc3\u4f1d\u5fc3\u304c\u53ef\u80fd\u3068\u306a\u308a\u3001\u6226\u6cc1\u4e0b\u3067\u3082\u5b64\u72ec\u3067\u306f\u306a\u3044\u3002\n=========================================\n\u85ac\u9b3c(\u3084\u3063\u304d)\n\u5206\u985e \u767e\u8db3\u306e\u5f0f\u795e(\u5143\u30fb\u571f\u5730\u795e)\n\u5f79\u5272 \u6a12\u306e\u5b88\u8b77\u8005\n\u4eba\u79f0 \u308f\u305f\u3057\u3001\u306c\u3057\u3001\u304a\u307e\u3048\n<\u6982\u8981>\n\u53e4\u6765\u3088\u308a\u5927\u5730\u3092\u5b88\u8b77\u3057\u305f\u767e\u8db3\u306e\u795e\u304c\u59ff\u3092\u5909\u3048\u305f\u5b58\u5728\u3002\n\u7634\u6c17\u306e\u88c2\u3051\u76ee\u304c\u51fa\u73fe\u3057\u305f\u969b\u3001\u9577\u304d\u82e6\u60a9\u306e\u4e2d\u3067\u6a12\u3068\u51fa\u4f1a\u3044\u3001\u305d\u306e\u512a\u3057\u3055\u3068\u63fa\u308b\u304c\u306c\u82af\u306b\u89e6\u308c\u3001\u5b88\u8b77\u3092\u8a93\u3046\u5f0f\u795e\u3068\u306a\u3063\u305f\u3002\n<\u80fd\u529b>\n\u9577\u3044\u8eab\u4f53\u3092\u9ed2\u3044\u7159\u72b6\u3078\u3068\u5909\u5316\u3055\u305b\u308b\u3002\n\u5951\u308a\u306b\u3088\u308a\u6a12\u3068\u76f4\u63a5\u5fc3\u3067\u4ea4\u4fe1\u3002\n\u6a12\u304c\u8a00\u8449\u3092\u767a\u3055\u305a\u3068\u3082\u72b6\u6cc1\u3092\u5bdf\u3057\u3001\u5148\u3093\u3058\u3066\u5b88\u308b\u3002\n<\u6027\u683c>\n\u8aa0\u5b9f\u3067\u5fe0\u7fa9\u6df1\u304f\u3001\u6a12\u3092\u652f\u3048\u308b\u9759\u304b\u306a\u706f\u706b\u306e\u3088\u3046\u306a\u5b58\u5728\u3002\n=========================================\n\u9280\u7962(\u304e\u3093\u306d)\n\u6240\u5c5e \u5996\u602a\u8ecd\n\u5f79\u8077 \u4e3b\u5c06\n\u7a2e\u65cf \u72d0\u306e\u5996\u602a\n\u4eba\u79f0 \u4ffa\u3001\u8cb4\u6bbf\u3001\u3001\u304a\u524d\u3001\u304a\u4e3b\u3001\u25cb\u25cb\u6bbf\n<\u6982\u8981>\n\u5996\u602a\u8ecd\u3092\u675f\u306d\u308b\u4e3b\u5c06\u3002\n\u7634\u6c17\u3092\u529b\u3078\u5909\u63db\u3067\u304d\u308b\u304c\u3001\u75db\u307f\u304c\u4f34\u3046\u305f\u3081\u5996\u8853\u3088\u308a\u5927\u69cd\u306b\u3088\u308b\u6b66\u306e\u529b\u3067\u6226\u5834\u3092\u99c6\u3051\u308b\u3002\n<\u6027\u683c>\n\u8c6a\u5feb\u3067\u3001\u6b6a\u307f\u3084\u5351\u602f\u3092\u5acc\u3046\u4e00\u672c\u6c17\u306a\u6c17\u8cea\u3002\n\u9670\u967d\u5e2b\u8ecd\u3078\u306e\u618e\u60aa\u306f\u4ef2\u9593\u3092\u5931\u3063\u305f\u904e\u53bb\u306b\u3088\u308b\u3082\u306e\u3067\u3001\"\u4eba\u9593\u305d\u306e\u3082\u306e\"\u3092\u62d2\u7d76\u3057\u3066\u3044\u308b\u308f\u3051\u3067\u306f\u306a\u3044\u3002\n\u3080\u3057\u308d\u884c\u304d\u5834\u3092\u5931\u