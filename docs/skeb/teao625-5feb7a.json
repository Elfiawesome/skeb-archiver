につけている。ピンクが多いのもそういう理由。\n・性格は気さくで明るく表情が豊か。会話が得意なため友達が多い。\n・たくさん笑うしたくさん泣く。\n\n\n【その他】\n・ポーズや表情はお任せいたしますが、かわいくポーズを取るアニメーションにしていただきたいです。\n・細かい色味やデザインは変えていただいて構いません。(パーカーのピンクが垂れる位置やピンクメッシュの位置を変える等)\n・とにかくTEAO様なりの\"かわいい\"をたくさん詰め込んで欲しいです。\n\n使用用途は個人鑑賞です。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hmK60a5oQrySC0vdSpSjqMmB5ftyRzlv", "nc": 0, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@teao625/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 1464118, "client_id": 2945628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4fa0dfb/uploads/outputs/9300e28f-c8bf-4639-82ce-98692ee2e3e9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=29b38caa3abf0d62eeb181067d89a67c", "srcset": "https://si.imgix.net/d4fa0dfb/uploads/outputs/9300e28f-c8bf-4639-82ce-98692ee2e3e9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=29b38caa3abf0d62eeb181067d89a67c, https://si.imgix.net/d4fa0dfb/uploads/outputs/9300e28f-c8bf-4639-82ce-98692ee2e3e9?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=79197cb176f404fed59137747a93217e 2x, https://si.imgix.net/d4fa0dfb/uploads/outputs/9300e28f-c8bf-4639-82ce-98692ee2e3e9?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=aeca3df9842f59e075d1fd111f083730 3x"}, "duration": 2, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4fa0dfb/uploads/outputs/9300e28f-c8bf-4639-82ce-98692ee2e3e9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=62fe5e9c4a110ef800f3e364e2011e53", "srcset": "https://si.imgix.net/d4fa0dfb/uploads/outputs/9300e28f-c8bf-4639-82ce-98692ee2e3e9?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=62fe5e9c4a110ef800f3e364e2011e53, https://si.imgix.net/d4fa0dfb/uploads/outputs/9300e28f-c8bf-4639-82ce-98692ee2e3e9?bg=%23fff&fm=webp&auto=com