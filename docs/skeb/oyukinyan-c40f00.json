o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e111ecc39d466ff700e0c96da650832d", "srcset": "https://si.imgix.net/3e317d20/uploads/origins/ff30b0a4-21ab-4e7e-afb8-fedb198e7111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e111ecc39d466ff700e0c96da650832d, https://si.imgix.net/3e317d20/uploads/origins/ff30b0a4-21ab-4e7e-afb8-fedb198e7111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=106d2fbf898b5547bae17c0f4740792f 2x, https://si.imgix.net/3e317d20/uploads/origins/ff30b0a4-21ab-4e7e-afb8-fedb198e7111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=271608b94059eef2a7dd96db37ddf285 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e317d20/uploads/origins/ff30b0a4-21ab-4e7e-afb8-fedb198e7111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be2a4b2a65ac7c2123b7862decbb313c", "srcset": "https://si.imgix.net/3e317d20/uploads/origins/ff30b0a4-21ab-4e7e-afb8-fedb198e7111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be2a4b2a65ac7c2123b7862decbb313c, https://si.imgix.net/3e317d20/uploads/origins/ff30b0a4-21ab-4e7e-afb8-fedb198e7111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f325212f7e97fd6a4845dca283f517a2 2x, https://si.imgix.net/3e317d20/uploads/origins/ff30b0a4-21ab-4e7e-afb8-fedb198e7111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aed58f45628e419db99b817bd79161cd 3x"}, "body": "ジャスティサリーありがとうございました！\n勝ち気そうな表情にビシッと指をさした決めポーズが生意気そうでいい感じです。\nこんな調子に乗ってるスーパーヒロインが、後にあんな無様な敗北姿を晒すのかと思うとその落差にゾクゾクします。おかげさまでいい感じにビフォーアフターを楽しめそうです。\nそれと、名義の件は失礼しました。リクエストを受け付けておられるのがこちらのお名前でしたので、ついそのまま書いてしまいました。申し訳ありません。\n\nさて、そのジャスティサリーがいい感じに生意気そうでしたので、ここから無様にやられちゃう姿も見たくなってしまいました。\n続けてリクエストさせていただいてもよろしいでしょうか？\n敵の新装置で力を発揮できなくなってしまい、ボコボコにやられて犯されてしまったジャスティサリー。という感じでお願いします。\nコスチュームは乳首や股間部分など適度に破って、エロ痛々しい姿に。出血はなしで。\nレイプ目で失神。股間からは失禁混じりの白濁液がゴボゴボ。\n陰毛はなし。\nブーツの足元まで汁まみれで、全身画面に入るようにしてください。\n背景はなくても大丈夫です。\n\n以上、ご検討いただけると幸いです。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oyukinyan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 9394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2ef72d45218b4dbc53bab6054f4ae9f", "srcset": "https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2ef72d45218b4dbc53bab6054f4ae9f, https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=045fa15cbcb8eb5e64c8d6a407f5377d 2x, https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67b35ab507bcea41fd003b523557aa9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=592b461128173988048f723d8732f3ea", "srcset": "https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=592b461128173988048f723d8732f3ea, https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c79754f4b882cbbc76626126ff0745bf 2x, https://si.imgix.net/7fde6cfe/uploads/origins/76936854-9352-4d47-95e3-7825e2495cca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71ae2c3fefd6bfb57b08baaeb6861466 3x"}, "body": "おゆき様はじめまして。\n以前、カオティックブリード様で描かれていたジャスティサリーをお願いしたいのですがよろしいでしょうか？\n敵の前に颯爽と現れ、自信満々にポーズを決めている全身立ち絵でお願いします。\n変身コスチューム、特に手袋とブーツにフェチさを感じているので、ブーツの足元まで画面に入るようにしてください。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oyukinyan/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/048c1d90/uploads/origins/34fd7085-8d8c-4d6f-a92d-c33c9927e2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9160ca371e8b63d8b68b88d3e57a304f", "srcset": "https://si.imgix.net/048c1d90/uploads/origins/34fd7085-8d8c-4d6f-a92d-c33c9927e2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9160ca371e8b63d8b68b88d3e57a304f, https://si.imgix.net/048c1d90/uploads/origins/34fd7085-8d8c-4d6f-a92d-c33c9927e2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba8659894d084b2cc3ea8e50a778a970 2x, https://si.imgix.net/048c1d90/uploads/origins/34fd7085-8d8c-4d6f-a92d-c33c9927e2c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6b5698f83c99d1cbf55bd2de4a2317c6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 9394, "nc": 145}], "sent_works": [], "similar_creators": [{"id": 209241, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "真綿＠skeb再開", "screen_name": "vorpal_cotton", "avatar_url": "https://pbs.twimg.com/profile_images/1667923259969650692/CK_pMx34.jpg", "header_url": "https:/