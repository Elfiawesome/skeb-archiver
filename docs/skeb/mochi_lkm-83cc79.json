を一本つけてください。\n\n江刺の服を着て、長袖で、烏帽子をかぶっています。\nまた、胸が見えているバージョンで、ここで描いたように、彼の膨らみをおふだで覆ってください : https://x.com/mochi_lkm/status/1912444092551958766 。もし差し支えなければ、おふだの下で勃起しているバージョンもあるとうれしいです。\n\nポーズや構図はお任せします！\nSNSで使わせていただきます。\n透過PNGでお願いします。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1oQ7ZmoqZQq2lL0nRIGY-pO1apht4VQGK", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mochi_lkm/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3213039, "client_id": 954252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6cb425f/uploads/origins/7445c1b5-56aa-40bb-a96e-25030e6de39e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ca0a84a520c201396c8507a68239ae2", "srcset": "https://si.imgix.net/c6cb425f/uploads/origins/7445c1b5-56aa-40bb-a96e-25030e6de39e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ca0a84a520c201396c8507a68239ae2, https://si.imgix.net/c6cb425f/uploads/origins/7445c1b5-56aa-40bb-a96e-25030e6de39e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97f1d5cbb1a19862a55275b725237fa4 2x, https://si.imgix.net/c6cb425f/uploads/origins/7445c1b5-56aa-40bb-a96e-25030e6de39e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87b46f86b95bb96241960ed3bbf131a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6cb425f/uploads/origins/7445c1b5-56aa-40bb-a96e-25030e6de39e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86920abbb27f79212076b6d39ec11bb6", "srcset": "https://si.imgix.net/c6cb425f/uploads/origins/7445c1b5-56aa-40bb-a96e-25030e6de39e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86920abbb27f79212076b6d39ec11bb6, https://si.imgix.net/c6cb425f/uploads/origins/7445c1b5-56aa-40bb-a96e-25030e