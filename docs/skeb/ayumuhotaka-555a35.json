66\nVtuber\u6d3b\u52d5\u3092\u3057\u3066\u3044\u308b\u795e\u90a3\u30ec\u30a4\u30a2\u3068\u7533\u3057\u307e\u3059\u3002\n\nX\u306e\u6295\u7a3f\u3092\u62dd\u898b\u3057\u3001\u7a42\u9ad8 \u6b69\u69d8\u306e\u7d20\u6575\u306a\u30e2\u30ce\u30af\u30ed\u30a4\u30e9\u30b9\u30c8\u306b\u8a00\u8449\u3092\u5931\u3046\u304f\u3089\u3044\u611f\u52d5\u3057\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u3002\n\u3082\u3057\u6761\u4ef6\u304c\u5408\u3044\u307e\u3057\u305f\u3089\u662f\u975e\u3068\u3082\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u306a\u3044\u304b\u3068\u601d\u3044\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3089\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\n\n\u3010\u4f9d\u983c\u5185\u5bb9\u3011\n\u30aa\u30ea\u30b8\u30ca\u30eb\u8863\u88c5(\u30a8\u30af\u30bd\u30b7\u30b9\u30c8)\u306e\u8863\u88c5\u3067\u30e2\u30ce\u30af\u30ed\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3067\u304d\u307e\u3059\u3067\u3057\u3087\u3046\u304b\uff1f\n\u69cb\u56f3\u7684\u306b\u306f\u7a42\u9ad8 \u6b69\u69d8\u306e\u30de\u30c1\u30a8\u30fc\u30eb\u3055\u3093\u3084\u30ab\u30e9\u30b9\u30d0\u3055\u3093\u306e\u4f5c\u54c1\u306e\u3088\u3046\u306a\u659c\u3081\u304b\u3089\u306e\u30a2\u30f3\u30b0\u30eb\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\u9aea\u578b\u3084\u8868\u60c5\u3001\u30dd\u30fc\u30ba\u306a\u3069\u306f\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30a4\u30e1\u30fc\u30b8\u3011\n\u81ea\u79f0\u201c\u3048\u308a\u30fc\u3068\u201d\u30a8\u30af\u30bd\u30b7\u30b9\u30c8\u3068\u3057\u3066\u591c\u306f\u60aa\u9b54\u9000\u6cbb\u3002\n\u8db3\u6280\u3092\u5f97\u610f\u3068\u3057\u3066\u304a\u308a\u3001\u76f8\u68d2\u3067\u30d0\u30af\u306e\u7cbe\u970a\u304c\u3044\u308b\uff08\u9b54\u6cd5\u62c5\u5f53\uff09\n\u663c\u306f\u6559\u4f1a\u3067\u30b7\u30b9\u30bf\u30fc\u898b\u7fd2\u3044\u3068\u3057\u3066\u30dc\u30e9\u30f3\u30c6\u30a3\u30a2\n\u30aa\u30c3\u30c9\u30a2\u30a4(\u53f3\u76ee:\u7d2b/\u5de6\u76ee:\u30d4\u30f3\u30af\u3002\u308f\u304b\u308a\u3084\u3059\u304f\u305