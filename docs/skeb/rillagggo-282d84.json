などのチャンネルページ、ツイートなどSNSに投稿する際に添付)\n※使用する際にトリミングする場合がございます。\n主な使用SNS（Youtube/Twitch/TikTok/Instagram/Twitterなど）\nyoutubeやTwitch等で収益化後も大切にイラストを使いたいです。\n\n以上です。\n最後まで読んでいただきありがとうございました。\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1eEP97oiHMZaR_qVhgkmKk75767Vni440/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rillagggo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3288966, "client_id": 2901468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0df6ef7/uploads/origins/c968dc6a-18cb-4f5a-a325-a25ccda28674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e301d061ae7b5fbdf8c0ada32d493d83", "srcset": "https://si.imgix.net/d0df6ef7/uploads/origins/c968dc6a-18cb-4f5a-a325-a25ccda28674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e301d061ae7b5fbdf8c0ada32d493d83, https://si.imgix.net/d0df6ef7/uploads/origins/c968dc6a-18cb-4f5a-a325-a25ccda28674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=891eaf476037ec029737f71add6c36b1 2x, https://si.imgix.net/d0df6ef7/uploads/origins/c968dc6a-18cb-4f5a-a325-a25ccda28674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2079683498aa5210a8a5a8d7216a819 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0df6ef7/uploads/origins/c968dc6a-18cb-4f5a-a325-a25ccda28674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f591471a51bab3834ff423c7804a1634", "srcset": "https://si.imgix.net/d0df6ef7/uploads/origins/c968dc6a-18cb-4f5a-a325-a25ccda28674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f591471a51bab3834ff423c7804a1634, https://si.imgix.net/d0df6ef7/uploads/origins/c968dc6a-18cb-4f5a-a325-a25ccda28674?bg=%23fff&auto=format%2Ccom