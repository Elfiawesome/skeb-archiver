ix.net/2b2cd403/uploads/origins/7f34a028-72ea-472c-ac38-32a578535c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d83b01d0ccffe5ba637b12456398a929 2x, https://si.imgix.net/2b2cd403/uploads/origins/7f34a028-72ea-472c-ac38-32a578535c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1447fdefe9cbdf1c931ebb9b148edc1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b2cd403/uploads/origins/7f34a028-72ea-472c-ac38-32a578535c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ee27914a9e8e09c365d6122ab1382e9", "srcset": "https://si.imgix.net/2b2cd403/uploads/origins/7f34a028-72ea-472c-ac38-32a578535c95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ee27914a9e8e09c365d6122ab1382e9, https://si.imgix.net/2b2cd403/uploads/origins/7f34a028-72ea-472c-ac38-32a578535c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb67b4c25ca5aa6f2e748ef8ccc8977a 2x, https://si.imgix.net/2b2cd403/uploads/origins/7f34a028-72ea-472c-ac38-32a578535c95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54e73e385935ae25ab7f53e793f3dd72 3x"}, "body": "つちのこ様初めまして、合図と申します。\nTLでつちのこ様の鮮やかで素敵なイラストを見かけ、skebも受け付けておられるとのことで、この度リクエストを送信させていただきます。\n\nTRPGで使用したキャラクターで、探偵事務所を営んでいる35歳の男性と、その助手をしている20歳の女性です。\n\n・男性\n十六夜 輝（いざよい ひかる）\n穏やかながら計算高い性格。しかし助手には気を許しており、幼児が母にするように甘えることもある。\n怠惰で構われたがりであり、助手に身の回りの世話をさせている。\n\n・女性\n右京 薫（うきょう くゆる）\n冷静でしっかり者。正義感が強く、世話好きでもあるため十六夜には甘い。年若く、相応に繊細な一面も持つ。\n肉付きはあまりよくない。\n\n構図や雰囲気などはつちのこ様の描きやすいように描いていただければと思いますが、私事ながらどちらのキャラクターもキャラロストしているため、幸せな雰囲気で描いていただけますと嬉しいです。\n\nそれでは、ご検討いただけますと幸いです。\n\nhttps://www.dropbox.com/sh/tvcxrjlew5cfrdm/AACGPMQZrmlBGGPabNz8IOuxa?dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssr_Tutinoko/works/2", "private_thumbnail_i