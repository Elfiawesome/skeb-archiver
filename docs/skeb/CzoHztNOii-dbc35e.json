ります。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1P1IfsBSiGw61dE820fC-RgYVjYgNHqDP/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1530615, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "比良坂 比呂@イラストレーター", "screen_name": "hirasakahiro", "avatar_url": "https://pbs.twimg.com/profile_images/1674285788526444545/gSQ0uV1F.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1388042195454685191/1758175704/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 128}, {"id": 2301138, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "三桐しきな", "screen_name": "coc_shikina", "avatar_url": "https://pbs.twimg.com/profile_images/1488739460129116160/ah9d_8eZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1488739281502097408/1701877728/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 17}, {"id": 2545158, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "可燃餅", "screen_name": "91__PPP", "avatar_url": "https://pbs.twimg.com/profile_images/1868657382110486528/bCwpDOnB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1227621552801210368/1771216609/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_d