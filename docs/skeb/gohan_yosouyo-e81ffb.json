は、適正金額での再送、またはキャンセルいただいて問題ございません。\n無理のない範囲でご検討いただけましたら幸いです\n\nhttps://drive.google.com/drive/folders/1HWoVbnXtFy1F2NAogyRlndaQpfgKhI8d", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gohan_yosouyo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3521845, "client_id": 3874754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bad4d98/uploads/origins/8cf85621-b9ec-4541-856e-398931166c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de98bcd2290f84382f722a1df95e2a47", "srcset": "https://si.imgix.net/9bad4d98/uploads/origins/8cf85621-b9ec-4541-856e-398931166c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de98bcd2290f84382f722a1df95e2a47, https://si.imgix.net/9bad4d98/uploads/origins/8cf85621-b9ec-4541-856e-398931166c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05174696db23cddb9b08312eaddb4b40 2x, https://si.imgix.net/9bad4d98/uploads/origins/8cf85621-b9ec-4541-856e-398931166c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed966d21d8a88b45a49e901cc4a9b1ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bad4d98/uploads/origins/8cf85621-b9ec-4541-856e-398931166c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1677bb319d9961f9246f2cd27b5a98dd", "srcset": "https://si.imgix.net/9bad4d98/uploads/origins/8cf85621-b9ec-4541-856e-398931166c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1677bb319d9961f9246f2cd27b5a98dd, https://si.imgix.net/9bad4d98/uploads/origins/8cf85621-b9ec-4541-856e-398931166c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1054baccec413b33d7e69aa57732f7a0 2x, https://si.imgix.net/9bad4d98/uploads/origins/8cf