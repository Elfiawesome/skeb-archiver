11b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c22335365a1e86d1ef56718a4061428, https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8b21a8f57761b7749427f3b88aaa3d9 2x, https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ff1f8680fff8b4433806710d56eabdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdd8065d21a747f01896afaa16f1ee6d", "srcset": "https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdd8065d21a747f01896afaa16f1ee6d, https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f9ca28da9682de0a0775e2f195feea9 2x, https://si.imgix.net/4e729ffc/uploads/origins/7ca1e59a-f103-4cfb-afd2-a07411b9ddf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=619ccd073add00459fa1f1430f5f0b08 3x"}, "body": "こんにちは。\nヲッくんちゃんさんの美麗なイラストいつも拝見しています。\n\nリクエスト失礼いたします。\n創作キャラの竹彦を描いていただきたいです。\n\n剣道部なんですが、制服姿で竹刀を肩に乗せてすました表情をしている感じでお願いできないでしょうか。\n\nまた、イラストを自サイトに飾らせていただくことは可能でしょうか。\n難しい場合はお断りいただいて大丈夫です。\n\nよろしくお願いいたします。\n\nhttps://pribo.web.fc2.com/charatakehiko.html", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@redshowcomic99/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2677475, "client_id": 2262996, "vtt_url": null, "thumbnail_image_urls