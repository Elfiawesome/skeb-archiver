s/8da5c8dc-8245-4b1a-94d7-ef11c2c210b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12a7d1022c798536c89026ff37e4a7f1, https://si.imgix.net/f750496f/uploads/origins/8da5c8dc-8245-4b1a-94d7-ef11c2c210b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d9d4dced2c36bf438fa747f7bf61241 2x, https://si.imgix.net/f750496f/uploads/origins/8da5c8dc-8245-4b1a-94d7-ef11c2c210b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8ed7feec30208ddf51b56d8706650d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f750496f/uploads/origins/8da5c8dc-8245-4b1a-94d7-ef11c2c210b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e17f7b2df4e9531efda9f6e84fe9aa", "srcset": "https://si.imgix.net/f750496f/uploads/origins/8da5c8dc-8245-4b1a-94d7-ef11c2c210b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5e17f7b2df4e9531efda9f6e84fe9aa, https://si.imgix.net/f750496f/uploads/origins/8da5c8dc-8245-4b1a-94d7-ef11c2c210b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7fd1e5fae32a7496bcf33faac25ea54a 2x, https://si.imgix.net/f750496f/uploads/origins/8da5c8dc-8245-4b1a-94d7-ef11c2c210b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3c1270ae5699fa9b51cdbf272542b97 3x"}, "body": "お題「雪歌ユフを描いてください」\n\nこんにちは、趣味で作曲をしている落合マズメ (収益化は一切しません) です。\nなれれさんの柔らかい色使いや、優しい表情の描き方が大好きです！\n活動応援しております。\n\n今回リクエストするにあたって、お願いが2つあります。\n\n(1) 今回の依頼で描いていただいたイラストを私のMVで使用させてください\n来年2月以降に雪歌ユフ (ボーカルシンセサイザー音源の一種) を使用した曲を、\nYoutubeとニコニコ動画に投稿する予定です。\nそこで、MVにイラストを使用する許可をいただきたく思います。\n\n(2) MVを作成するにあたって作品のごく一部を改変させていただく可能性があります\nYoutubeの画面比とイラストのサイズが合わない場合、作品のサイズを変更するなど、\nごく一部を改変して使用する可能性があります。\n\n以上2点をご理解のもと、承認いただければと思います。\nクレジットの記載など、慎重に行う所存ですので、ご一考いただければ幸いです。\n\n\n以下、イラストの希望です。\n基本的に全てなれれさんにおまかせいたしますので、\n参考程度に受け取っていただければと思います。\n\n・画風\nなれれさんの創作イラスト『マジシャン』のような画風でお願いします。\n\n・キャラクター\n雪歌ユフ (UTAU)\n公式設定: http://sekkayufu.web.fc2.com/character.html\nUTAU (ボーカルシンセサイザーの一種) のキャラクター設定は正確に定まっていないので、\n姿や衣装は公式設定に忠実でなくてもかまいません。\n自由な感じでお願いします。\n\n・構図・表情\nおまかせします。\n楽しげな印象を受けるイラストだと嬉しいです。\n\n・背景・小物\nおまかせします。\nいずれもなしでもかまいません。\n\n・サイズ\n16:9 1280×720 or 1920×1080\n\n以上です、描いていただければ飛んで喜びます。\n今後の活動も応援しております。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@irstkrag/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2931720, "client_id": 2222649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce151b4b/uploads/origins/830e07d0-4942-4f91-b100-504aa04f41fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c74ead6f1c9a81c57139d8abeee6a152", "srcset": "https://si.imgix.net/ce151b4b/uploads/origins/830e07d0-4942-4f91-b100-504aa04f41fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c74ead6f1c9a81c57139d8abeee6a152, https://si.imgix.net/ce151b4b/uploads/origins/830e07d0-4942-4f91-b100-504aa04f41fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b461dabb527a5b5a2470a3ed831aaf51 2x, https://si.imgix.net/ce151b4b/uploads/origins/830e07d0-4942-4f91-b100-504aa04f41fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66378cf8e648f98a0d29702a88efe554 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce151b4b/uploads/origins/830e07d0-4942-4f91-b100-504aa04f41fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f5076974210a9b316a162dd9b19ac16", "srcset": "https://si.imgix.net/ce151b4b/uploads/origins/830e07d0-4942-4f91-b100-504aa04f41fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f5076974210a9b316a162dd9b19ac16, https://si.imgix.net/ce151b4b/