44c907a5ac6529e 2x, https://si.imgix.net/a6f2a32c/uploads/origins/c9fffa1a-c8a3-496a-9f11-bd2b00c971a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0320770e2f123e1d92ab9886057fb84a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6f2a32c/uploads/origins/c9fffa1a-c8a3-496a-9f11-bd2b00c971a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5ca3ac7faad835d1546597562906377", "srcset": "https://si.imgix.net/a6f2a32c/uploads/origins/c9fffa1a-c8a3-496a-9f11-bd2b00c971a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5ca3ac7faad835d1546597562906377, https://si.imgix.net/a6f2a32c/uploads/origins/c9fffa1a-c8a3-496a-9f11-bd2b00c971a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94576f6be67fc0a9688127d62c3f66d6 2x, https://si.imgix.net/a6f2a32c/uploads/origins/c9fffa1a-c8a3-496a-9f11-bd2b00c971a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2abf53c3424837c942691fa847fb8ba6 3x"}, "body": "はじめまして。いつもFEの素敵なイラストをありがとうございます。\nフェリさんにご依頼するのは初めてですが、よろしくお願いします。\n\n【作品】\nファイアーエムブレム 烈火の剣(ファイアーエムブレムヒーローズ)\n【キャラクター名】\nヘクトル\n(参考URL：https://guide.fire-emblem-heroes.com/hector_marquess_of_ostia/)\n【シチュエーション】\n・ペレジアの術師に捕まったヘクトルが、過去の作品を引用させて頂き申し訳ないのですが(参考URL：https://www.pixiv.net/artworks/87548901)このケセルダのように腋見せガニ股のポーズでバックを犯されつつ、胸を揉まれ性器を扱かれてモブから強姦されている絵でお願いします。\n\n・ヘクトルの衣装はFEヒーローズの超英雄ペレジア版クリス(参考URL：https://guide.fire-emblem-heroes.com/01001002000618-2/)のような薄い茶色の全身タイツで、強姦するのに邪魔な部位(性器やアナル)や太股の部分等がペレジア版のラファエルの被弾時(参考URL：https://guide.fire-emblem-heroes.com/12004003000619-2/)のように少し破けているような姿で。特徴的なペレジアの眼の形の刻印(淫紋)が股間部にされており、肉体を操られている感じでお願いします。ペレジア特有の他の装飾品はお任せします(ペレジア衣装っぽく見えれば最小限で構いません)\n\n・モブの容姿はシチュエーション的にペレジアの術師をイメージしていますが、引用させて頂いたケセルダの絵のようなモブ男でも構いません。ただモブも同様にガチムチな肉体に、それでいて操られているヘクトルを嘲笑うような表情だと嬉しいです。\n\n・ヘクトルは肉体を操られ「な、ぁ…ッ！？ か、身体が…勝手に、ぃ…ッ！？」と頬紅潮させ、驚いたように目を見開いている表情でお願いします。また同じポーズのまま額にペレジアの眼の刻印が浮かび「お\"ッ♡！？ ぢ、ちくしょ…ぉッ♡」と、悔しそうに眉間に皺を寄せ歯を食い縛った顔のまま完全に肉体を支配され精液をお漏らししている差分があると嬉しいです。\n\n・ヘクトルは肌の色が公式で割と変わりやすいのですが、今回はヒーローズの恒常版や伝承版のような白い感じで茶色いタイツとの差が映えていると嬉しいです。\n\n・性器、胸、太股の大きさはお任せしたいのですが、詳細に…との事なので、引用させて頂いたケセルダと同じくらいの大きさの性器、ムッチリ感はそのままでケセルダよりほんの少しだけ筋肉質になった胸、そしてケセルダよりほんの少しだけ盛られたくらいの太股と、ケセルダ基準で申し訳ないのですが、もし詳細が必要でしたらこんな感じでお願いします。毛の指定はありませんが、全体的に臭そうな絵になっていると嬉しいです。\n\n・ペレジアの術師に捕まったシチュエーションなので石壁の暗い場所をイメージしていましたが、背景の指定等はありません。茶色い全身タイツの腋見せガニ股のヘクトルがしっかり映えるのに薄暗い背景が邪魔だと感じたら、お好みで変えてしまって構いません。メインはヘクトルでお願いします。\n\n・上記のようなヘクトルの台詞や、堪え、堕ちるヘクトルを嘲笑うモブの台詞、また台詞無しの差分があると嬉しいです。擬音等に拘りは無いのでお任せします。\n\n可能な限り詳細に…という事だったので、できる範囲で詳細に書かせて頂いたが、些か我儘なリクエストになってしまってすみません。\nこんな長文のリクエストですが、もしお時間がありましたらご一考をお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@felice_sideb/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5d803ef4/uploads/origins/5f465b61-74a0-4833-a7ea-5d321fff9df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be4544c598a00126b6bc24603d9d9ffb", "srcset": "https://si.imgix.net/5d803ef4/uploads/origins/5f465b61-74a0-4833-a7ea-5d321fff9df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=be4544c598a00126b6bc24603d9d9ffb, https://si.imgix.net/5d803ef4/uploads/origins/5f465b61-74a0-4833-a7ea-5d321fff9df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f40da1738a25629e9bfc1bd415ae4f5c 2x, https://si.imgix.net/5d803ef4/uploads/origins/5f465b61-74a0-4833-a7ea-5d321fff9df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txt