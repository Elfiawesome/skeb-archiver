n学校にはまだ通えていませんが知り合いのツテでメイド喫茶でバイトしながら社会復帰を目指しています。\nお願いしたいのはそんな彼女が打ち解けたバイト仲間達と海水浴に出かけた際のワンショットです。\n\n水着のデザインは参考URLのレイヤードビキニを希望しています。\n\n想定しているシチュエーションや水着のデザイン等、\nこれらの希望としてあげた要素はクリエイター様の判断で自由にアレンジしていただいて構いません。\n究極的には海水浴場でなくてもプールでも風呂でも屋内でも構いませんし、\n水着のデザインもお任せします。\nあくまでオリキャラの水着イラストをお願いしたい、というのが第一義です。\n元ネタがオリキャラの為、クリエイター様のイマジネーションに委ねてしまう部分が多く恐縮ですが、\nご一考いただければ幸いです。\nよろしくお願いします。\n\nhttps://twitter.com/RIMdabe/status/1289965704096047104\nhttps://twitter.com/RIMdabe/status/1743578150293082237\nhttps://skeb.jp/@gyouza_anime/works/8\nhttps://skeb.jp/@Fujimiz_511/works/2\nhttps://skeb.jp/@infinity_tino/works/4\nhttps://skeb.jp/@fusuke_neko/works/18", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yoji_iShiMoto/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1763637, "client_id": 15482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27e3b96122105583808005368216fc45", "srcset": "https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27e3b96122105583808005368216fc45, https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0974d838b85f3d7a72f5fc09a69ebc1 2x, https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ecadc71898b5dc42e3bc8208fa1c9f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed7a07eef70bd1e8774fc16d6757960", "srcset": "https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed7a07eef70bd1e8774fc16d6757960, https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ee8f0603057a9082605ac9efe173896 2x, https://si.imgix.net/395752c8/uploads/origins/d482b17d-dd07-4a8b-9ba6-3a8a1030ac97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91651e5b48a2a22ebe2de17b782743f7 3x"}, "body": "しもさんこんにちは\nよければ私の創作キャラクターのクアラ氏を描いて欲しいです\n\nビキニを着て赤面しているところか、縦セタを着て意地悪な笑顔をしているところ\n描きやすい方を描いていただければと思います。\n\n全身でなく、バストアップなど金額内で描ける範囲で大丈夫です。\n\n髪の長さや服装・頭身などその時の気分で描いているので、忠実にせず描きやすいように描いていただけたらと思います。\nでも胸はデッッカいととても嬉しいです。\n\nご都合よろしければお願いします。\n\nhttps://drive.google.com/drive/folders/1-9V3xzwE83XgT7bpAdVYaYWqSV-O_VAE", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 30183, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "久世", "screen_name": "clavis_kz", "avatar_url": "https://pbs.twimg.com/profile_images/1855845438806712320/jYojIaK5.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 145}, {"id": 315269, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぴえとろ", "screen_name": "PietroAtri", "avatar_url": "https://pbs.twimg.com/profile_images/1909841000320962560/CwDiDITj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1149270220319543296/1685204555/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_ra