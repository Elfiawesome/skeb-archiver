Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90a21802565e31ce60adb4816c12fb8b 2x, https://si.imgix.net/896969a2/uploads/origins/6a08dcfe-f85f-4e1b-b3b1-fee5845a6516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=defb68fb14c04172becb1199116d7dff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/896969a2/uploads/origins/6a08dcfe-f85f-4e1b-b3b1-fee5845a6516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=459e03b4bb0d1c0694c952572f9c3b6b", "srcset": "https://si.imgix.net/896969a2/uploads/origins/6a08dcfe-f85f-4e1b-b3b1-fee5845a6516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=459e03b4bb0d1c0694c952572f9c3b6b, https://si.imgix.net/896969a2/uploads/origins/6a08dcfe-f85f-4e1b-b3b1-fee5845a6516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50372d55ac815ce55722a9965852c2b8 2x, https://si.imgix.net/896969a2/uploads/origins/6a08dcfe-f85f-4e1b-b3b1-fee5845a6516?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa014ac9a6b3eed599533f601ac9b20d 3x"}, "body": "霞三月先生、前回先生に仕上げられた素晴らしい作品に感激し、今回もお願いいたします！【衣装デザイン】今回は和風スタイルで、日常着のイラストを描いていただきたいです。テーマは「温泉で酒を酌み交わす」🍶。取り入れられる要素として桃🍑や植物・花があります。衣装にグラデーションや透明感のあるデザイン、湖の水面や波紋のような模様を組み込めれば最高です！\n配色はリンク先のカラーカード（青とピンク）を参考に。キャラクターは男性的な印象を希望します。ポーズや構図は先生のご自由にお任せします。イラストの使用用途はSNSのアイコン、PC壁紙、個人鑑賞用グッズ制作などに限定し、商業利用は一切いたしません。お忙しい中お手数をおかけし、誠に申し訳ございません。ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/15dhOXPL_RHdtFOLMTuVHHbP4VmwDWuWz", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyumi_kamizuki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3825168, "client_id": 2005344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59915934ea6e0418ef3b8e2084dcb1c2", "srcset": "https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59915934ea6e0418ef3b8e2084dcb1c2, https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c005f3a48da9ce92572d91d9c9d6c3c8 2x, https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b51c9abd7be9ba3c6de0fd056a21380c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b521558c734452b497a90532704edb64", "srcset": "https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b521558c734452b497a90532704edb64, https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd54c5c700582115b6c0e2c5021e8bf 2x, https://si.imgix.net/fab8d261/uploads/origins/302600e2-273f-4969-a9aa-7b585339714d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5edbe15bbf2f8a404f5a1815a9e1372 3x"}, "body": "はじめまして！あなたのアートとデザインはとても素敵ですね。銀髪のキャラクターを描くのがお得意だと気づきました。私の天使キャラクターの新しいデザインを考えていただけないでしょうか。若い頃に作ったキャラクターなのですが、新しいデザインに値すると思うのです。 \n彼は私の物語に登場する天使で、人間界に降りて人々を守る使命を帯びています。守護天使の概念に基づいています（参考までに、彼を遣わした神様の情報はこちらです：https://www.deviantart.com/stash/016vs7ue1wl3）。羽根を結晶化させて人々を盾で守る能力を持っています。\n\n髪型を変更したり、金色のハイライトを加えて個性を出すなど、自由にアレンジしてください。このデザインは天使としての本来の姿として考えています。同時に、彼のための光輪のデザインも考案していただけますか？ https://www.deviantart.com/stash/022m22hq2i7d\nhttps://www.deviantart.com/stash/2102ign9qe4u目的：将来的には物語内で彼のメインデザインとして使用する可能性があります。ただし、主に個人利用となる見込みです。曖昧な依頼で申し訳ありませんが、創造的な自由度を存分にお持ちいただければ幸いです。ご検討いただきありがとうございます！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyumi_kamizuki/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/acf8c352/uploads/origins/3ad2acbf-240d-4109-95c9-14638e0b84b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b617234111c613a3d968f20ffa66b909", "srcset": "https://si.imgix.net/acf8c352/uploads/origins/3ad2acbf-240d-4109-95c9-14638e0b84b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b617234111c613a3d968f20ffa66b909, https://si.imgix.net/acf8c352/uploads/origins/3ad2acbf-240d-4109-95c9-14638e0b84b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ced96577dc20d08c609ea49ac0f58ae9 2x, https://si.imgix.net/acf8c352/uploads/origins/3ad2acbf-240d-4109-95c9-14638e0b84b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82adf7b618e25a71c73d1a32b39d0fab 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3825168, "client_id": 3888214, "nc": 16}, {"path": "/@yuyumi_kamizuki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3825168, "client_id": 2010254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6444f3327f47b46ae4f1bf2254a5061b", "srcset": "https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6444f3327f47b46ae4f1bf2254a5061b, https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e52827f73dfb26d36967d57ac2d5da0 2x, https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dbb9080c3c4cb289fc553d5ce3fee79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=368f92eef7b32f568888cd5c7b7e4e6d", "srcset": "https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=368f92eef7b32f568888cd5c7b7e4e6d, https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=11009cb5d2db07f4dc6c2fa17df6bc79 2x, https://si.imgix.net/3d765db1/uploads/origins/a94a07f8-2877-4507-9074-ecfbbc1618a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18462a58911d00981c249b551d046bf7 3x"}, "body": "はじめまして！(｀・ω・´)ゞ\n先日Xで霞三月様のデザインを拝見し、素晴らしいと思いました！私のオリジナルキャラ「なの」と「ナノ」の衣装をデザインしていただけると嬉しいです。二人は鏡によって分かれた同一の存在で、一方は善を、もう一方は悪を象徴しています。 \n\n髪型やアクセサリーはお好みで変更していただいて構いませんが、武器と鏡は必ず含めてください。衣装の裏側と関連アイテムも併せてご提示いただければ幸いです。どんな作品ができるか楽しみにしています！ \n\n「七詩夏々乃」通称「なの」\n髪：クリーム灰色。ふくらはぎまでの長さ\n目：黄色\n身長：162cm\n特徴：感情によって形が変わるハート形のアホ毛。魔法を使うと黄色い光輪が現れる \n武器：糸と縫い針。縫い針型の杖 \n\nなのは元気いっぱいの天使のような少女で、偉大な魔女になるために一生懸命勉強した。杖を使って縫い糸と針を武器化する。魔法は黄色い輝きを放つ。ひまわり、プリン、絵を描くこと、そして親友のために新しい服を作るために服を縫うことが好きです。鏡は彼女を不安にさせるが、その理由は（まだ）はっきりわからない。鏡に映ったなのの像は本体とは独立して動き、表情を作ることができる。見た目は全く同じだが、鏡のナノは赤い目をしていて、不気味な表情を浮かべている。 \n\n「ナノ」\n髪：クリームと灰色。ふくらはぎまでの長さ\n目：灰色。中心部は淡いオレンジ色。左目には十字の印がある。鏡の近くにいるときは赤く光る\n身長：162cm\n特徴：左側に黒い翼が二枚。ハート形のアホ毛。魔法を使うと淡いオレンジい光輪が現れる \n武器：はさみの刃 \n\nナノは鏡の世界から来た邪悪で虚無的な存在で、無垢な天使を装っている。混乱を求め、感情を弄ぶことに喜びを見出す。彼女の感情はすべて、結晶化した心の中に閉じ込められている。戦闘ではさみの刃を使って物を断ち切り、魔法は不気味な赤と黒の輝きを放つ。鏡の近くにいるときはいつでも目は赤く光る。ロングドレス、豪華な絵画、そして鳥かごが好きです。鏡に映ったナノの像は本体とは独立して動き、表情を作ることができる。見た目は全く同じだが、現実のなのは黄色い瞳で、顔つきがより柔らかい。 \n\nリクエストは少し複雑なので、金額が少なすぎる場合は、アピールを送ってください。\nよろしくお願いします！m(__)m\n\nhttps://drive.google.com/drive/folders/1G2h9xG1uzktJ-KnMZsfIyUB8Ts26PlEA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuyumi_kamizuki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3825168, "client_id": 1389755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03710bfa/uploads/origins/5c5adfa6-e5b6-43f1-b5a5-fa62f68c92f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4515b52140ef0aaf1bddb03f159a75d", "srcset": "https://si.imgix.net/03710bfa/uploads/origins/5c5adfa6-e5b6-43f1-b5a5-fa62f68c92f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4515b52140ef0aaf1bddb03f159a75d, https://si.imgix.net/03710bfa/uploads/origins/5c5adfa6-e5b6-43f1-b5a5-fa62f68c92f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04418f51cb7c86faa71ec678e803dbe5 2x, https://si.imgix.net/03710bfa/uploads/origins/5c5adfa6-e5b6-43f1-b5a5-fa62f68c92f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfd5f31b4e7e40f82ca076fc7cc4a4fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03710bfa/uploads/origins/5c5adfa6-e5b6-43f1