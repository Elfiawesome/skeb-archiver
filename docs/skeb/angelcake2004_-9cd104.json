, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@angelcake2004_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3430786, "client_id": 2784322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b9db90c39d15d1c3b253d7a015a52e1", "srcset": "https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b9db90c39d15d1c3b253d7a015a52e1, https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=612933e5482778994c30c36067710eda 2x, https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b077f5acf0b8e50966b0e867c9fdacf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b3048e77538814ec759eb1128a9d7c5", "srcset": "https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b3048e77538814ec759eb1128a9d7c5, https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe8e6ea553b9a23f6d2315ff1c254268 2x, https://si.imgix.net/ef9392e1/uploads/origins/359ffc6c-1e14-4645-aba9-970f67b1ca6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=854fdd685d0f37a3d87ec99ec9ad77ed 3x"}, "body": "はじめまして。\nカノン様のイラストを拝見し、とても素敵だと思いリクエスト送信させていただきました。\nよろしければ、背景ありのオリジナルキャラクターを描いていただきたいと思います。\n金額等に不備があれば、お手数ですが再送申請をしていただけると幸いです。\nご検討のほどよろしくお願いいたします。\n\n【キャラクター】\n男／15歳／159cm／貴族\n・自分が貴族であることを嫌だと思っている\n・紅茶と甘いものが好き\n\n【イメージ】\n・世界観は中世ヨーロッパ風\n・大きい館に住んでいる\n・全体的に薄暗い雰囲気\n\n【参考資料】\nhttps://www.dropbox.com/scl/fo/ovwisbvvojg9rfimdkkxe/AE2HuFufojyoUBt2_jC-VS4?rlkey=frbnzj3qr2tr52xazz1f4xe8o&st=va0bbi6t&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@angelcake2004_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3430786, "client_id": 352151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd61e6f69d48652465683d199341e260", "srcset": "https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd61e6f69d48652465683d199341e260, https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=626ef3a60572b8076dd4b756d6b8ee4d 2x, https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0083e3d363f1e533891b401604402c58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7294acdd2ef42c479335e7c86ff5cbb", "srcset": "https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7294acdd2ef42c479335e7c86ff5cbb, https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7d5ba15fd855b5248c8e8d8e20f728 2x, https://si.imgix.net/535f1675/uploads/origins/4ad992f9-a2b1-46da-b84e-a0aba9ae4fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f5cd2a799a4041ffdd0805d2422d5c5 3x"}, "body": "カノンさん、こんにちは。あなたの絵が好きなので、私のocを描いてほしいとお願いします。詳細な関係設定は画像に書いてありますので、ご希望でしたらお読みください！自由に描いていただければ幸いです。ありがとうございます。\n\n金額が足りなければ再送ってください。絵のインスピレーションがなければ、勝手にキャンセルしてください。ありがとうございます！\n\nhttps://drive.google.com/drive/folders/10NfcRPEuxaqm7gSQbYtd5GlRjJQyfR80", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@angelcake2004_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3430786, "client_id": 3753065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2786f3ebec8056f0668be37edf99ac68", "srcset": "https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2786f3ebec8056f0668be37edf99ac68, https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dae2dec4dcd7df3b8d20fb3a0ee2b3ff 2x, https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d50a144e08c2564efd838f1b9e40e32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=224f63c2a0171aa7999b6f79202379ab", "srcset": "https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=224f63c2a0171aa7999b6f79202379ab, https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3674930fc8b7c4994cde6bdf8f4c0de4 2x, https://si.imgix.net/2b17d128/uploads/origins/c45a628a-479f-4571-91cc-78e46fbb8b49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa52f3aec56122f47808239691c2f51b 3x"}, "body": "カノン先生、こんにちは。\n作品に描かれる物語性にいつも心惹かれています。\n\n記念日用のイラストをお願いしたく、ご連絡させていただきました。\n\nテーマは「ある映画にインスパイアされた、水と静けさのあるシーン」です。\n\n内容：\n・ウェディングドレスを着た女の子が浴室にいるシーン\n・恋人は「彼女のエコーのような存在」で、姿は見えません\n・水面の波紋や花びらの動きなど、見えない存在を仄めかすような表現をお願いできれば嬉しいです\n・猫が2匹（資料あり）\n・カレンダーに「1月3日」の日付が見えるように\n\nご検討いただけますと幸いです。どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/108f22BmDYfnKzS4QLbavnjD5yOi2_7-t", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@angelcake2004_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3430786, "client_id": 293143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a945c174fd6ac130a46bacfdbc23533b", "srcset": "https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a945c174fd6ac130a46bacfdbc23533b, https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c70124b01adb25196f289088078e1902 2x, https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86846be731d7ce42fe320ca5c5b98cbf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c43e5395ca2821a62ffd412d87e90d8", "srcset": "https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c43e5395ca2821a62ffd412d87e90d8, https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a6720216a2806edf52405a5b7ee4e49 2x, https://si.imgix.net/52ffd838/uploads/origins/69135a3a-5410-45fd-ad1d-66da5eb9eca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=414e441c8d5ca54f0c747407e00cc871 3x"}, "body": "カノン先生初めまして。先生のイラストのファンシーでクラシカルなテイストがとても好きです！\n\nリクエストなのですが、よろしければ自創作の魔界っぽい世界観の姉弟をお願いしたいです。姉の名前はエヴァ、無邪気で傲慢なお姫様キャラ、弟はムロ、天然わんこ系です。2人とも同性のパートナーがいるのですが、カプ相手に対しては2人とも懐っこいあどけなさと魔性じみた貪欲さが両方ある感じです。姉弟間の関係は極めて良好で、超がつくブラコンとシスコンで、恋愛感情はありませんがいつも仲良しです。\n\n資料にカプ相手含めて4人の情報があるのですが、エヴァムロの2人が一緒にいるのが見たいです、、、！アレンジ、シチュエーション、衣装、絡み具合、デフォルメ具合、コンセプトなど、カノン先生のセンスでご自由になさってください。 描いて頂いたイラストは自分用に最小ロットにてグッズに使用する場合があります。販売など、商業利用はしません。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1-J8L_bxJswG-xHZyVxbeLsr9zOO5GG1H?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@angelcake2004_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3430786, "client_id": 1656598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b