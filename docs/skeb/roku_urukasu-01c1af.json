rs/1JwzZ912QmC6A86-y51N4uTLtsDbxIEGf\n女の子が犬になりきり気持ちよく喘がされているイメージ\n\n・希望する流れ（可能な範囲で拾ってもらえると嬉しいです）\n既に出来上がった状態で、赤面し犬になりきりながら誘惑orおねだり\n後背位でわんわん鳴かされながら絶頂\n尻尾を引き抜かれてアナルセックス、アナルで絶頂\n事後、満足げに「…わんっ♡」と鳴いてEND\n\nご検討をお願い致します\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@roku_urukasu/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dcca5e6a/uploads/origins/d3df56ff-a1f6-4088-9a4d-8dfbb9375f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f2264e1e3586426be20a10e9ace7039", "srcset": "https://si.imgix.net/dcca5e6a/uploads/origins/d3df56ff-a1f6-4088-9a4d-8dfbb9375f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f2264e1e3586426be20a10e9ace7039, https://si.imgix.net/dcca5e6a/uploads/origins/d3df56ff-a1f6-4088-9a4d-8dfbb9375f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbfe149ad9f28dfaa6af714618033ebd 2x, https://si.imgix.net/dcca5e6a/uploads/origins/d3df56ff-a1f6-4088-9a4d-8dfbb9375f2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24b317a534f7566e10c738f8af80b2db 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3639066, "nc": 34}, {"path": "/@roku_urukasu/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c13b8aa3/uploads/origins/eb34e006-62f8-4fef-ac85-f7fa810e399f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2C