%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66762e3b6472802db38c9d70dad63f53 3x"}, "body": "Hello, nice to meet you! I really like your style and would like to request an illustration. I'm a fan of Vtuber Kanna Yanagi. She's a kind and intelligent duck detective! She's bright, energetic, and very hardworking. She loves video games, trading card games, and singing. Any pose, hairstyle, or composition is fine!\n\n[Use]\n⦁ Social media icons, YouTube thumbnails, schedule illustrations\n\n[Details]\n⦁ Please send the separate layers if possible\n⦁ Please include at least one fan mascot, kamogumi\n\nReference sheet for Kanna:  https://drive.google.com/drive/folders/1gF4s2gtaM2WHHyQS0fobsHRsF31gczGt\n\nThank you for your consideration!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8_dlz/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3608837, "client_id": 3527891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31feea37bb4887d8f3d9c81db3c1b8a7", "srcset": "https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31feea37bb4887d8f3d9c81db3c1b8a7, https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=423e47ff0b4597e714ce797399144208 2x, https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8df8a8ac03d74bf36c257c937439cdc9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=956fcff250e4923d2ace89564290f3d4", "srcset": "https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=956fcff250e4923d2ace89564290f3d4, https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70d6cd54d30a87d34eeb5de0702e0ee0 2x, https://si.imgix.net/e45b2844/uploads/origins/87933044-b371-4956-9212-f952c21c33b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe448df9bffc4878d2754090f71cb3c5 3x"}, "body": "きみのとなり‼️先生！初めまして！\n先生の作品は見てすぐに気に入りました！！私のocのイラストをお願いしに来ました。\n\n簡単な自己紹介：\n朝霧悠奈：24歳、167cm。彼女はゲーム『絶区零（ZZZ）』の世界観に基づいたOCです。髪の色は普通の金髪ではなく、少し白っぽいプラチナブロンドです。髪質は少しゆるく巻いています。日常の服装をしている姿を描いてください。\n\n構図、状況、表情はあなたの判断次第です！服装は自由に変えていただいて大丈夫です！髪型も自由に変更できます。\n\nこの作品はSNS使用のみとなります。\n\n料金が足りない場合やURLが機能しない場合は、再送させていただきます。ご都合が悪ければ、キャンセルしてください。\nよろしくお願いします！良い一日をお過ごしください！\n\nhttps://drive.google.com/drive/u/0/folders/1UTbouZl4HiAfob0kZAbjQ2FlrWfbBFE6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8_dlz/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3608837, "client_id": 3449232, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4873fe74/uploads/origins/96d365a7-b513-44a1-8b73-f09fa98e5d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=068eaf40b354e2da41f6e3aae6d03b0f", "srcset": "https://si.imgix.net/4873fe74/uploads/origins/96d365a7-b513-44a1-8b73-f09fa98e5d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=068eaf40b354e2da41f6e3aae6d03b0f, https://si.imgix.net/4873fe74/uploads/origins/96d365a7-b513-44a1-8b73-f09fa98e5d5