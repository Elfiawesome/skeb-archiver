\nこちらが指定した部分は変更、アレンジしていただいて大丈夫です。\n先生の筆の進むままにお願い致します。\n\n以上になります。\n前回の内容と類似するリクエストとなり申し訳ございません。\n無理のある内容でしたら、遠慮なくキャンセルしていただいて大丈夫ですので\nご検討いただければ幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@souren_hiiragi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2972687, "client_id": 290930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeaf0e05/uploads/origins/febb1cb4-5fcb-44a4-9a81-e92e990bb8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b216b4bcfba7236d6b012004140dd07", "srcset": "https://si.imgix.net/eeaf0e05/uploads/origins/febb1cb4-5fcb-44a4-9a81-e92e990bb8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b216b4bcfba7236d6b012004140dd07, https://si.imgix.net/eeaf0e05/uploads/origins/febb1cb4-5fcb-44a4-9a81-e92e990bb8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0047df1e81394df8ba9d5128536d6d66 2x, https://si.imgix.net/eeaf0e05/uploads/origins/febb1cb4-5fcb-44a4-9a81-e92e990bb8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2d3631ca86f29bff5f87539f23c9395 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeaf0e05/uploads/origins/febb1cb4-5fcb-44a4-9a81-e92e990bb8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da3f96f75f247c8c2f740962a1ff4074", "srcset": "https://si.imgix.net/eeaf0e05/uploads/origins/febb1cb4-5fcb-44a4-9a81-e92e990bb8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da3f96f75f247c8c2f740962a1ff4074, https://si.imgix.net/eeaf0e05/uploads/origins/febb1cb4-5fcb-44a4-9a81-e92e990bb8ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=265b507751689506a1ca3f059f39756d 2x, https://si.imgix.net/eeaf0e05/uploa