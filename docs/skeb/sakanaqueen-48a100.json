089\u308c\u308b\u30a4\u30e9\u30b9\u30c8\u306e\u6570\u3005\u306b\u9b45\u4e86\u3055\u308c\u305f\u8005\u3067\u3059\u3002\n\n\u4eca\u56de\u3001\u30af\u30c8\u30a5\u30eb\u30d5\u795e\u8a71TRPG\u300eVOID\u300f\u306e\u81ea\u9663+\u03b1\u3092\u63cf\u3044\u3066\u9802\u304d\u305f\u304f\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3089\u305b\u3066\u9802\u304d\u307e\u3059\u3002\u30b7\u30ca\u30ea\u30aa\u3092\u697d\u3057\u3093\u3060\u5353\u30e1\u30f3\u30d0\u30fc\u5168\u54e1\u306b\u3068\u3063\u3066\u306e\u601d\u3044\u51fa\u3068\u306a\u308b\u300e\u901a\u904e\u8a18\u5ff5\u7d75\u300f\u3092\u63cf\u3044\u3066\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\u307e\u305f\u3001\u304a\u3055\u304b\u306aSpecial\u69d8\u304c\u624b\u61f8\u3051\u305f\u4f5c\u54c1\u3092\u5353\u30e1\u30f3\u30d0\u30fc(\u79c1\u3092\u542b\u3081\u305f7\u540d)\u5185\u3067\u5171\u6709\u3055\u305b\u3066\u9802\u304f\u3053\u3068\u3092\u3054\u4e86\u627f\u4e0b\u3055\u3044\u307e\u3059\u3088\u3046\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\u5c1a\u3001\u300eVOID\u300f\u30b7\u30ca\u30ea\u30aa\u898f\u7d04\uff62skeb\u306a\u3069\u306e\u4f9d\u983c\u30b5\u30fc\u30d3\u30b9\u306b\u3064\u3044\u3066\uff63\u306f\u78ba\u8a8d\u6e08\u307f\u3067\u3059\u3002\n\nURL\u306b\u306f\u3001\u4ee5\u4e0b\u306e\u5185\u5bb9\u306e\u753b\u50cf\u3092\u6dfb\u4ed8\u3044\u305f\u3057\u307e\u3059\u3002\u5f8c\u8ff0\u3059\u308b\u3010\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\u3011\u3068\u4f75\u305b\u3066\u3054\u78ba\u8a8d\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\u30fb\u767b\u5834\u4eba\u72695\u540d\u306e\u5bb9\u59ff\n\u30fb\u6b66\u5668(\u65e5\u672c\u5200\uff62\u9ed2\u55b0\uff63)\u30c7\u30b6\u30a4\u30f3\n\u30fb\u300eVOID\u300f\u516c\u5f0f\u306e\u30b8\u30e3\u30b1\u30c3\u30c8\u30c7\u30b6\u30a4\u30f3\n\u30fb\u767b\u5834\u4eba\u7269(\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9)\u306b\u63cf\u304b\u308c\u305f\u30ed\u30b4\u30de\u30fc\u30af\n\n\ud83c\udf1f\ud83c\udf1f\ud83c\udf1f\n\u3010\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\u3011\n\u2460\u767b\u5834\u4eba\u7269\u53ca\u3073\u8863\u88c5\n\u4ee5\u4e0b\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u767b\u5834\u3059\u308b\u4f5c\u54c1\u3092\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\u30fb\u300eVOID\u300f\u306e\u81ea\u96634\u540d\n\u30fb\u9b5a\u304c\u30e2\u30c1\u30fc\u30d5\u306e\u30ed\u30dc\u30c3\u30c8(\u304a\u3055\u304b\u306aSpecial\u69d8\u306e\u30aa\u30ea\u30b8\u30ca\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc)\n\n\u203b \uff62\u9b5a\u304c\u30e2\u30c1\u30fc\u30d5\u306e\u30ed\u30dc\u30c3\u30c8\uff63\u306f\u3001\u4f5c\u54c1\u5185\u306e\u96a0\u3057\u8981\u7d20\u3001\u898b\u3064\u3051\u305f\u3089\u30e9\u30c3\u30ad\u30fc\u306a\u30ec\u30a2\u30ad\u30e3\u30e9\u611f\u3092\u51fa\u3057\u3066\u9802\u304d\u305f\u3044\u306e\u3067\u3001\u25cbNEPIECE\u306e\u30d1\u30f3\u30c0\u30de\u30f3\u3084\u96a0\u308c\u30df\u30c3\u25cb\u30fc\u306e\u3088\u3046\u306a\u30a4\u30e1\u30fc\u30b8\u3067\u63cf\u3044\u3066\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\ud83c\udf1f\ud83c\udf1f\ud83c\udf1f\n\u30fc\u767b\u5834\u4eba\u7269(\u81ea\u96634\u540d)\u306e\u8a73\u7d30\u30fc\nHO1\uff1a\u9ed2\u7530 \u4f50\u591c(\u304f\u308d\u3060 \u3055\u3084)\n\u65b0\u7c73\u5211\u4e8b(\u4eba\u9593)/22\u6b73\u5973\u6027/\u8eab\u9577159cm/\u4f7f\u7528\u6b66\u5668\u306f\u65e5\u672c\u5200/\u4eca\u5e74\u5211\u4e8b\u306b\u306a\u3063\u305f\u3070\u304b\u308a\u306e\u65b0\u4eba\u3060\u3002 \n\u7d05\u4e00\u70b9\u3002\u611f\u60c5\u8c4a\u304b\u306a\u98df\u3044\u3057\u3093\u574a\u3002\u9ed2\u55b0(\u3053\u304f\u3070\u307f)\u3068\u3044\u3046\u65e5\u672c\u5200\u3092\u611b\u7528\u3057\u3066\u304a\u308a\u3001\u5263\u8853\u306f\u304b\u306a\u308a\u306e\u8155\u524d\u3060\u3002\u3057\u304b\u3057\u3001\u6a5f\u68b0\u3078\u306e\u77e5\u8b58\u306f\u4e4f\u3057\u3044\u69d8\u5b50\u3002\u8150\u3063\u305f\u30c1\u30fc\u30ba\u30d0\u30fc\u30ac\u30fc\u3092\u7247\u624b\u306b\u4e00\u8a00\u3002\uff62\u5927\u4e08\u592b\u3001\u53e9\u3051\u3070\u76f4\u308a\u307e\u3059\u3002\uff63\n\nHO2\uff1a\u6c34\u57ce \u8f1d(\u307f\u305a\u304d \u3072\u304b\u308b)\n\u65b0\u578b\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9/21\u6b73\u7537\u6027/\u8eab\u9577170cm/\u4f7f\u7528\u6b66\u5668\u306f\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3/HO1\u306e\u30d1\u30fc\u30c8\u30ca\u30fc\u30ed\u30dc\u30c3\u30c8\u3060\u3002 \u6700\u65b0\u578b\u306e\u6a5f\u80fd\u304c\u63c3\u3048\u3089\u308c\u3066\u3044\u308b\u3002 \n\u660e\u308b\u304f\u3066\u7d14\u7c8b\u7121\u57a2\u3067\u597d\u5947\u5fc3\u65fa\u76db\u3060\u304c\u3001\u898b\u305f\u76ee\u306b\u5bc4\u3089\u305a\u304b\u306a\u308a\u597d\u6226\u7684\u306a\u6027\u683c\u3092\u3057\u3066\u3044\u308b\u3002\u6575\u3092\u524d\u306b\u3057\u305f\u3089\u8ab0\u304c\u76f8\u624b\u3060\u308d\u3046\u3068\u30ce\u30fc\u30bf\u30a4\u30e0\u30b7\u30e7\u30c3\u30c8\u30ac\u30f3\uff01\u3060\u304c\u3001\u5473\u65b9\u306e\u624b\u5f53\u3082\u5fd8\u308c\u306a\u3044\u3002\n\nHO3\uff1a\u67d8\u690d \u7554(\u3064\u3052 \u307b\u3068\u308a)\n\u5211\u4e8b(\u4eba\u9593)/33\u6b73\u7537\u6027/\u8eab\u9577174cm/\u4f7f\u7528\u6b66\u5668\u306f\u30b5\u30d6\u30de\u30b7\u30f3\u30ac\u30f3/\u4ed6\u306e\u8ab2\u304b\u3089\u79fb\u52d5\u3057\u3066\u304d\u305f\u5211\u4e8b\u3060\u3002 \u4eca\u307e\u3067\u3042\u3089\u3086\u308b\u4e8b\u4ef6\u3092\u89e3\u6c7a\u3057\u3066\u304d\u305f\u3053\u3068\u3060\u308d\u3046\u3002\n\u5e74\u76f8\u5fdc\u306b\u591a\u304f\u306e\u60a9\u307f\u3092\u62b1\u3048\u305f\u30d9\u30c6\u30e9\u30f3\u5211\u4e8b\u3002\u771f\u9762\u76ee\u306b\u635c\u67fb\u3059\u308b\u6642\u304c\u3042\u308c\u3070\u3001\u5929\u7136\u767a\u8a00\u3092\u3059\u308b\u6642\u3082\uff01\u30b5\u30d6\u30de\u30b7\u30f3\u30ac\u30f3\u306e\u547d\u4e2d\u7387\u306b\u5b9a\u8a55\u304c\u3042\u308a\u3001\u30d9\u30c6\u30e9\u30f3\u306e\u8155\u524d\u306f\u4f0a\u9054\u3058\u3083\u306a\u3044\u3002\u5451\u307f\u306f\u62d2\u5426\u3001\u5f7c\u306f\u3044\u3064\u3067\u3082\u70cf\u9f8d\u8336\uff01\n\nHO4\uff1a\u7070\u8449 \u5e78\u4eba(\u306f\u3044\u3070 \u3086\u304d\u3072\u3068)\n\u65e7\u578b\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9/20\u4ee3\u7537\u6027/\u8eab\u9577179cm/\u4f7f\u7528\u6b66\u5668\u306f\u4e8c\u4e01\u62f3\u9283/HO3\u306e\u30d1\u30fc\u30c8\u30ca\u30fc\u30ed\u30dc\u30c3\u30c8\u3060\u3002HO3\u3092\u4fe1\u983c\u3057\u3066\u3044\u308b\u3001\u3068\u3066\u3082\u5fe0\u5b9f\u306a\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9\u3067\u3042\u308b\u3002\n\u552f\u4e00\u306e\u771f\u9762\u76ee\u67a0\u3002\u6575\u306f\u5012\u3059\u3088\u308a\u6355\u3089\u3048\u3066\u4e8b\u60c5\u8074\u53d6\u6d3e\u3002\u719f\u8003\u3057\u304c\u3061\u3067\u3001\u8a33\u30a2\u30ea\u306a\u5b50\u4f9b\u3078\u306e\u5bfe\u5fdc\u306b\u56f0\u308a\u304c\u3061\u3002\u4f1a\u8a71\u3082DEX\u3082\u30b9\u30ed\u30fc\u30b9\u30bf\u30fc\u30bf\u30fc\u3002\n\n\ud83c\udf1f\ud83c\udf1f\ud83c\udf1f\n\u30fc\u767b\u5834\u4eba\u7269(\u81ea\u96634\u540d)\u306e\u670d\u88c5\u30fc\n\u300eVOID\u300f\u516c\u5f0f\u3088\u308a\u4f7f\u7528\u304c\u8a31\u53ef\u3055\u308c\u3066\u3044\u308b\u30b8\u30e3\u30b1\u30c3\u30c8\u30c7\u30b6\u30a4\u30f3\u304c\u3042\u308a\u307e\u3059\u306e\u3067\u3001\u81ea\u96634\u540d\u306e\u670d\u88c5\u306b\u3064\u304d\u307e\u3057\u3066\u306f\u3001\u65e2\u5b58\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u306e\u670d\u88c5(\u4e00\u90e8\u5909\u66f4)\u306e\u4e0a\u304b\u3089\u3001\u3053\u3061\u3089\u306e\u30b8\u30e3\u30b1\u30c3\u30c8\u3092\u7740\u7528\u3057\u3066\u3044\u308b\u5f62\u3067\u63cf\u3044\u3066\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\u670d\u88c5\u3084\u6b66\u5668\u306a\u3069\u3001\u753b\u50cf\u306b\u306a\u3044\u90e8\u5206\u306e\u30c7\u30b6\u30a4\u30f3\u306b\u3064\u304d\u307e\u3057\u3066\u306f\u3001\u3054\u60f3\u50cf\u306b\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\u3002\n\u307e\u305f\u30b8\u30e3\u30b1\u30c3\u30c8\u306e\u7740\u3053\u306a\u3057\u65b9\u306b\u3064\u3044\u3066\u3082\u3001\u4eba\u7269\u3054\u3068\u306b\u7279\u5fb4\u304c\u3042\u308b\u305f\u3081\u3001\u78ba\u8a8d\u3092\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\nHO1\uff1a\u9ed2\u7530 \u4f50\u591c\n\u30fb\u30b8\u30e3\u30b1\u30c3\u30c8\u306e\u30e2\u30b3\u30e2\u30b3\u4e0d\u8981\n\nHO2\uff1a\u6c34\u57ce \u8f1d\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u306e\u30b9\u30fc\u30c4\u30b8\u30e3\u30b1\u30c3\u30c8\u4e0d\u8981\n\u30fb\u30b8\u30e3\u30b1\u30c3\u30c8\u306e\u30e2\u30b3\u30e2\u30b3\u4e0d\u8981\n\u30fb\u30b8\u30e3\u30b1\u30c3\u30c8\u306f\u5168\u3066\u9589\u3081\u308b\u304c\u3001\u9996\u5143\u306e\u30dc\u30bf\u30f3\u306f\u9589\u3081\u306a\u3044\u3053\u3068\n(\u53c2\u8003\uff1a\u30b8\u30e3\u30b1\u30c3\u30c8\u30c7\u30b6\u30a4\u30f3\u753b\u50cf\u306e\uff62POLICE\uff63\u306e\u6587\u5b57\u306e\u5de6\u5074\u306e\u7d75)\n\nHO3\uff1a\u67d8\u690d \u7554\n\u203b\u6307\u5b9a\u7121\u3057\n\nHO4\uff1a\u7070\u8449 \u5e78\u4eba\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u306e\u30b9\u30fc\u30c4\u30b8\u30e3\u30b1\u30c3\u30c8\u4e0d\u8981\n\u30fb\u30b8\u30e3\u30b1\u30c3\u30c8\u306e\u30e2\u30b3\u30e2\u30b3\u4e0d\u8981\n\u30fb\u30b8\u30e3\u30b1\u30c3\u30c8\u306f\u9589\u3081\u306a\u3044\u3053\u3068\n\n\ud83c\udf1f\ud83c\udf1f\ud83c\udf1f\n\u2461\u4f5c\u54c1\u306e\u96f0\u56f2\u6c17\u7b49\u306e\u6307\u5b9a\n\u96f0\u56f2\u6c17\uff1a\u300eVOID\u300f\u306e\u4e16\u754c\u89b3\u3089\u3057\u3044\u201c\u30ab\u30c3\u30b3\u826f\u3055\u201d\u3068\u5353\u306e\u96f0\u56f2\u6c17\u3092\u601d\u3044\u51fa\u305b\u308b\u201c\u697d\u3057\u3055(\u6109\u5feb\u3055)\u201d\u3092\u517c\u306d\u5099\u3048\u305f\u3082\u306e\u3002\n\u69cb\u56f3\uff1a\u6307\u5b9a\u7121\u3057\u3002\n\u30b7\u30ca\u30ea\u30aa\u306e\u30cd\u30bf\u30d0\u30ec\u306b\u306a\u308b\u8981\u7d20\u306f\u4e00\u5207\u7121\u3057\u3067\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\u30cd\u30bf\u30d0\u30ec\u306e\u306a\u3044\u7bc4\u56f2\u3067\u3001\u201c\u3053\u306e\u5353\u3060\u304b\u3089\u751f\u307e\u308c\u305f\u8981\u7d20\u201d\u3092\u53cd\u6620\u3057\u3066\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n(\u4f8b\uff1aHO1\u304c\u30cf\u30f3\u30d0\u30fc\u30ac\u30fc\u3092\u6301\u3063\u3066\u3044\u308b\u7b49)\n\n\ud83c\udf1f\ud83c\udf1f\ud83c