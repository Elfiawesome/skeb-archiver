g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c0fc2cbfe0f84bec330f765064e736a, https://si.imgix.net/deeafb20/uploads/origins/ca30f468-1cb9-4c05-9101-c29c298a5b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53cc8849a4a89f2af42cee889373581b 2x, https://si.imgix.net/deeafb20/uploads/origins/ca30f468-1cb9-4c05-9101-c29c298a5b30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44e871218c11eb2011487bd8d98ea863 3x"}, "body": "はじめまして！\n以前、丙介💎さんのイラストを見かけ、ぜひ自分のオリジナルキャラクターを描いていただきたいと思い、ご依頼をさせていただきました。\n描いていただきたいのが、TRPGのオリジナルキャラクターです。\n\n------\n\nKarel Lischka(カーレル・リシュカ)\n年齢：23歳\n性別：男性\n身長：175cm\n髪の色：サハラ(オレンジ色)　瞳の色：コチニールレッド(赤色)\nイメージカラー：サハラ\nモチーフ：狐、砂漠\n\nオレンジの髪に少し褪せた赤色の瞳をした青年。アラビア系の血が入っている。気配を消すのが得意で、ふらっと音もなく現れる。\n\n戦闘ではクロスボウを扱う。不安定な足場での射撃も得意としている。馬やラクダなどの動物に乗りながらも可。指笛が吹ける。\n\n------\n\n記載URLにキャラクターデザインや詳細資料を貼っております。\nほか構図や表情、服装(軍服私服どちらでもOKです)などに関しては丙介💎さんのお好きに描いていただいて構いません！\n\n難しかったり情報、金額が足りなければ、遠慮なくキャンセル、再送依頼してください。\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1dWvBQ-1F5iNQOwcj9sWmjKDv6Mm7rweO?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpgh1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1274981, "client_id": 2845547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=604afe4832df00b9a35c2fc94fb24589", "srcset": "https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=604afe4832df00b9a35c2fc94fb24589, https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de41777ec208fa1e3b311dbe22c58b36 2x, https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17f06c585b229101d544ca577208b9be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc3516a7548cf6714ce17864596ba6d", "srcset": "https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc3516a7548cf6714ce17864596ba6d, https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5acd4d5be46a7241c4399f82d1842c45 2x, https://si.imgix.net/aff55f8b/uploads/origins/35fde51f-ac43-4130-b068-4941a3f1c2c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a8bfbc9a8ebcd7f9cc941325ce56a75 3x"}, "body": "はじめまして、Xにて丙介さまのイラストを拝見して一目惚れし、ぜひ自キャラを描いていただきたくリクエストをいたしました！\n金額が相応しくない場合、お手数ですが再送依頼をお願いいたします。\n\nさて、お願いしたいキャラクターは、クトゥルフ神話TRPGのオリジナルキャラクターです。\n\n▼キャラ1：魚河岸秀星\n警視庁捜査第一課所属。26歳、男\n172cm\n短い茶髪に、暗い灰目。\n\n冗談や軽口が多く、誰に対してもあまり壁を作らない一方で、冷笑的な一面を見せることもある。\n愛煙家で、どこでもよく喫煙している。\n妹を事件で亡くしたことを機に警察を目指した経緯があり、新しく自分のバディとなった後輩、蓮青もまた妹と同種の事件に巻き込まれ精神病を抱えていることを知ってからは彼に対する庇護欲を抱くようになった。\nが、愛情の裏返しか蓮青本人に対しては周りに比べ少々風当たりが厳しめだったりする。\n\n▼キャラB：蓮青裕海\n警視庁捜査一課所属の新人捜査官。25歳　男\n192cm\n髪色：頭頂は黒、先端に降りるにつれ黒板色に薄まっている\n瞳：暗い茶色\n\n捜査一課に配属されたばかりで、魚河岸とバディを組むことになった新人捜査官。\n仕事に対しては真面目で熱心だが、反面なにかと些細なドジが多く、「あ」が口癖。\n誰に対しても人懐っこい性格で、いわゆる大型犬系後輩タイプ。基本的に明るく振舞うが、幼少期誘拐の被害にあったことからトラウマが多く精神がもろくなっている。\n魚河岸から特別厳しく指導される日々ゆえしょげることが多いが、めげずに懐きまくっている。\n\n▼関係性\n職業上バディを組んでおり、年齢が近くはありますが蓮青から魚河岸に対しては敬語で接するなど、「上司と部下」の距離感を保っている間柄です。\n一方で、多少の馴れ馴れしさを気にしない気風ということもあり、『飼い主にやたら懐きまくっている大型犬と、それをやや邪険にしつつも満更ではない飼い主』といった関係性に近しい一面も。\n\n▼リクエストについて\n構図などお好きなように描いてくださいませ。その際、仲の良い関係性がわかるような雰囲気を出してくださると幸いです。\n\nなお、いただいた作品は個人観賞や、物理グッズの制作を主な利用目的としております。\n\n以上、ご検討いただけますと幸いです。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-dA_95ucafxOqAcpMwYjzbSr28NDOM0m", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpgh1/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1274981, "client_id": 69030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9981dcd8/uploads/origins/09183c4e-9c80-42d6-9fae-ef796ef3bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57bdaf0ab371b4e8d5ce107558553cc6", "srcset": "https://si.imgix.net/9981dcd8/uploads/origins/09183c4e-9c80-42d6-9fae-ef796ef3bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57bdaf0ab371b4e8d5ce107558553cc6, https://si.imgix.net/9981dcd8/uploads/origins/09183c4e-9c80-42d6-9fae-ef796ef3bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a13a7a893205a05d3c044e2e6a2d343e 2x, https://si.imgix.net/9981dcd8/uploads/origins/09183c4e-9c80-42d6-9fae-ef796ef3bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef53505fa3cc38a17d030d6396467cde 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9981dcd8/uploads/origins/09183c4e-9c80-42d6-9fae-ef796ef3bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=726172863e2648ee5c97e6c55a417e15", "srcset": "https://si.imgix.net/9981dcd8/uploads/origins/09183c4e-9c80-42d6-9fae-ef796ef3bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=726172863e2648ee5c97e6c55a417e15, https://si.imgix.net/9981dcd8/uploads/origins/09183c4e-9c80-42d6-9fae-ef796ef3bffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop