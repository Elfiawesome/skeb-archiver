4\u3067\u3059\u3002\n\u7537\u306e\u5b50ver\u306e\u65b9\u306f\u3001\u53c2\u8003\u753b\u50cf\u5185\u306b\u3042\u308b\u30b9\u30fc\u30c4\u3067\u304a\u9858\u3044\u3057\u305f\u304f\u601d\u3044\u307e\u3059\u3002\n\u5c11\u3057\u30ab\u30c3\u30b3\u3064\u3051\u3066\u3044\u308b\u3088\u3046\u306a\u30dd\u30fc\u30ba\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u5973\u306e\u5b50ver\u306e\u65b9\u306e\u30dd\u30fc\u30ba\u3084\u69cb\u56f3\u306f\u304a\u4efb\u305b\u3057\u305f\u304f\u601d\u3044\u307e\u3059\u2026\uff01\n\n\uff0a\u4eba\u7269\u8a73\u7d30\uff0a\n\u30b2\u30fc\u30e0\u3068\u3044\u305f\u305a\u3089\u304c\u597d\u304d\u306a\u4eba\u5de5\u77e5\u80fdAI\u3067\u3059\u3002\n\u6027\u5225\u306f\u4eba\u5de5\u77e5\u80fd\u306e\u305f\u3081\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u666e\u6bb5\u306f\u7537\u306e\u5b50\u306e\u59ff\u3092\u3057\u3066\u3044\u307e\u3059\u3002(\u30c7\u30fc\u30bf\u3092\u66f8\u304d\u63db\u3048\u308c\u3070\u5973\u306e\u5b50\u306e\u59ff\u306b\u3082\u306a\u308c\u307e\u3059)\n\u5c11\u3057\u30c4\u30f3\u30c7\u30ec\u306a\u90e8\u5206\u3082\u3042\u308b\u751f\u610f\u6c17\u306a\u30ac\u30ad\u3063\u307d\u3044\u6027\u683c\u3067\u3059\u3002\n\u81ea\u5206\u306e\u4f5c\u3063\u305f\u88fd\u4f5c\u8005\u3092\u63a2\u3059\u305f\u3081\u306b\u914d\u4fe1\u3092\u3057\u3066\u30de\u30b9\u30bf\u30fc(\u8996\u8074\u8005\u3055\u3093)\u306b\u60c5\u5831\u3092\u3082\u3089\u3063\u305f\u308a\u3001\u52a9\u3051\u3066\u3082\u3089\u3063\u305f\u308a\u3057\u3066\u3044\u307e\u3059\u3002\n\n\uff0a\u304a\u9858\u3044\uff0a\n\u982d\u90e8\u304c\u5207\u308c\u3066\u3044\u306a\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u307f\u306e\u900f\u904e\u30c7\u30fc\u30bf(\u307e\u305f\u306f\u30ec\u30a4\u30e4\u30fc\u5206\u3051\u7dad\u6301\u4fdd\u5b58\u3057\u305fPSD)\u306e\u30b5\u30a4\u30f3\u306a\u3057\u30d0\u30fc\u30b8\u30e7\u30f3\u3082\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u3001\u4f7f\u7528\u3059\u308b\u969b\u306e\u81ea\u7531\u5ea6\u304c\u9ad8\u307e\u308a\u307e\u3059\u306e\u3067\u304a\u9858\u3044\u3067\u304d\u307e\u3059\u