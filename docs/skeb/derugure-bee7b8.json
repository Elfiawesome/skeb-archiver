/AffIatus_Misery/status/1452562067513298945 (for stone reference!)\n\nIf the strange eyes are too much, One green eye and an eyepatch, or a simple blindfold will also be good!\n\nI leave all the style options to your discretion, thank you for your time!  ( 9 w 9 )/\n\nhttps://imgur.com/a/YmHcMxv", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@derugure/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1708206, "client_id": 94928, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc9250c3/uploads/origins/315886eb-c689-43fe-90cc-9a87ac82e855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a0fd6d86d4353a7027aaf3ef6c1a2df", "srcset": "https://si.imgix.net/cc9250c3/uploads/origins/315886eb-c689-43fe-90cc-9a87ac82e855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a0fd6d86d4353a7027aaf3ef6c1a2df, https://si.imgix.net/cc9250c3/uploads/origins/315886eb-c689-43fe-90cc-9a87ac82e855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75aa5686ecf19316e8061da9e96965e4 2x, https://si.imgix.net/cc9250c3/uploads/origins/315886eb-c689-43fe-90cc-9a87ac82e855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7282f564c0a043831deab74f0b7f9dfd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc9250c3/uploads/origins/315886eb-c689-43fe-90cc-9a87ac82e855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f68f096352d6c16d4a58b9bd5d88c5d4", "srcset": "https://si.imgix.net/cc9250c3/uploads/origins/315886eb-c689-43fe-90cc-9a87ac82e855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f68f096352d6c16d4a58b9bd5d88c5d4, https://si.imgix.net/cc9250c3/uploads/origins/315886eb-c689-43fe-90cc-9a87ac82e855?bg=%23fff&auto=format