\n■その他■\n人物のみの透過PNGデータを希望します(PSDでも可能です\n\n何卒宜しくお願いいたします\n\n\n【参考画像】\nhttps://x.com/rka7se/status/1951662830455021702\n\nhttps://x.com/rka7se/status/1951662830455021702", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amari_maw/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3843354, "client_id": 3335996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6506a852/uploads/origins/d4f76eef-c6ff-4e6c-b4c2-6ed0515b9cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=699821dff032e2fe4d2b1ed1ad41ad1c", "srcset": "https://si.imgix.net/6506a852/uploads/origins/d4f76eef-c6ff-4e6c-b4c2-6ed0515b9cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=699821dff032e2fe4d2b1ed1ad41ad1c, https://si.imgix.net/6506a852/uploads/origins/d4f76eef-c6ff-4e6c-b4c2-6ed0515b9cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f033e1507878252d983e5c436197604 2x, https://si.imgix.net/6506a852/uploads/origins/d4f76eef-c6ff-4e6c-b4c2-6ed0515b9cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba2fe4d5f65b14b8199652d3644bbc26 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6506a852/uploads/origins/d4f76eef-c6ff-4e6c-b4c2-6ed0515b9cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=888a7a46536c9061d96b87438907c974", "srcset": "https://si.imgix.net/6506a852/uploads/origins/d4f76eef-c6ff-4e6c-b4c2-6ed0515b9cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=888a7a46536c9061d96b87438907c974, https://si.imgix.net/6506a852/uploads/origins/d4f76eef-c6ff-4e6c-b4c2-6ed0515b9cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d82f0f2a019000bc91e6da18088ffd51 2x, https://si.imgix.ne