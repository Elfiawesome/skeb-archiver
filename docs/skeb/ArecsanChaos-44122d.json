itter.com/MGmasimasi792/status/1674478815463227392?s=20", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ArecsanChaos/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 299248, "client_id": 455002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc7cea26ca6e49250b579fd97322ea4", "srcset": "https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc7cea26ca6e49250b579fd97322ea4, https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2d15e773721d3678022e86eda376c35 2x, https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09fc5921c17aa74212d3d99277e88fe5 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=915d5872dcb59dcd67e9b80623242ad5", "srcset": "https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=915d5872dcb59dcd67e9b80623242ad5, https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab37b90fd9f39b149854effca16f87fc 2x, https://si.imgix.net/e8107c99/uploads/origins/47e366c5-0e7e-4937-acae-7d48c26830a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8cfe7d07032f9e9ef44cbe863087b58 3x"}, "body": "Dear Mitchel Alephrase, It is nice to meet you.\nI always look forward to your illustrations.\nI would like to request an illustration that is a prelude to the wonderful illustrations in your [Record of the Education in the Womb].\nIf it is not to your taste, please feel free to cancel the request.\n\nSubjects\nSHRIFT\n\nCharacter\nYumi\nKazuya\n\nContents\nThe scene in which Lady Geki is skull-fucking Kazuya-kun.\nThe scene is that Lady Gyoki is about to swallow Kazuya's whole body from her vagina in order to give him an in-utero education.\n\nComposition.\nIn this composition, the whole face of Kazuya is swallowed by the vagina. Please make it look as if the swallowed face is stuck and floating in the vagina.\nPlease give us the feeling that she is lovingly caressing Kazuya's face swallowed into her vagina with both hands, while her expression is benevolent or wicked motherly full-blown smiling.\n\nHere's a skullfuck scene of another character, if it helps.\n(https://skeb.jp/@blackse/works/94)\n(https://skeb.jp/@monster_fruit/works/31)\n\nThat's all I have to say.\nI know it's a maniacal scene, but if you like it, I'd appreciate your consideration.\n\nhttps://twitter.com/ArecsanChaos/status/1603781767970029570", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ArecsanChaos/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 299248, "client_id": 101574, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b2f3770/uploads/origins/7ea5643e-0d7e-4cf3-9d5b-3a0e2fc73ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e64d01a7652c59ee26de1e8dc74c2aef", "srcset": "https://si.imgix.net/8b2f3770/uploads/origins/7ea5643e-0d7e-4cf3-9d5b-3a0e2fc73ccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e64d01a7652c5