cc57bfb1ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4ddeb4a3fb1f3ecfb2fa736c62ee769 2x, https://si.imgix.net/a88d5be0/uploads/origins/8986c45e-bc4e-434b-b339-3cc57bfb1ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e02ed7f88ab9c746802e88c92620bfde 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3853607, "nc": 161}, {"path": "/@_hamunohito_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3853607, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a906390bc0a36eca5f4f60e11caf88", "srcset": "https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a906390bc0a36eca5f4f60e11caf88, https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92e7c231d038dd86109a579c57a37a87 2x, https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b0f416d6827a024b8f12185ee3bb532 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b870938f80f6d3cfc973991bff58798d", "srcset": "https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b870938f80f6d3cfc973991bff58798d, https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=293bb3d60126a658f5aec55f172ab482 2x, https://si.imgix.net/5f5c8ea5/uploads/origins/fd2510b9-70f6-4aa6-906c-49f42eb53821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f031e649914402999d15cd2ce2c77a6e 3x"}, "body": "触手とロリが最高だったのでお願いします！\n書くかも程度ですがドM小説の挿絵に使いたいです\n\n希望キャラ：\n岩倉玲音/白ワンピ衣装希望(登場作品/serial experiments lain/版権キャラが難しければ普通服バネッサ希望です：https://www.pixiv.net/artworks/136973492)\nバネッサ(サンタ衣装:https://www.pixiv.net/artworks/139056859)\nまた二人ともオリジナルとは無関係にマゾ男から効率よく精子を搾り取る為に、マゾ男の好みに合わせて触手が生み出した少女型疑似餌という設定でお願いします\n\nシチュ：\n着衣ボテ腹姿の岩倉玲音&サンタコスバネッサにゴミを見るような冷めた目で嫌悪・侮蔑されながら、添い寝されている男が両サイドから二人の触手満載の咥内で乳首を嫐られ、えぐい構造の粘液たっぷりの触手オナホコキで大量搾精させられるMシチュ\n二人ともゴミを見る冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし)で、変態マゾへの嫌悪を一切隠すことない侮蔑の表情を希望します\n\n触手咥内は花のように開くブラシ状触手、吸盤触手に加えて咥内壁や本来の舌自体も粘液まみれの襞や繊毛などが密集した触手地獄で、乳首を引っ張ったり吸引したり、乳腺をイジメる構造の触手を希望します\n\n二人とも全身粘度の高い粘液まみれで全身がどろどろ&べとべとで胸やボテ腹に服がべっとりと張り付き、\n服越しでも勃起乳首がわかる着衣おっぱいと、粘液まみれの大量の触手を孕んでいる特大着衣ボテ腹(妊娠淫紋付き)が衣装の中にギチギチに押し込まれ強調され、\n優先度低でボテ腹内部に孕んだ触手の蠢きが、外から見てもわかるようにボテ腹が歪に変形している描写希望です\n\nペニスは肉々しいえぐい構造の触手オナホに外から一切見えないレベルで完全に呑み込まれており結合部から粘液と共に内部のブラシ触手や精子が溢れている描写をお願いします\nまた可能でしたら背景に同様の構造の粘液まみれの触手オナホが口を開いて中を見せつけている様子もお願いします\n\n触手肉壁やダーク系の背景で、可能でしたらpsd形式で射精差分、粘液まみれの触手が蠢く水音やM男の情けなさすぎる懇願や喘ぎ声等の効果音の有無、二人の顔上部の影と瞳のハイライトの有無をON/OFF切替表示希望です\n優先度最低でボテ腹ロリに性欲を懐くだけでなく、異形の触手に悦んで射精する変態マゾへの罵倒・侮蔑台詞有無(台詞や口調はお任せ致します)と\n更に低で、老いも死も赦されず、触手で尿道まで開発して直接精巣で触手を孕む苗床ザーメンタンクに改造してあげる、的な台詞の有無希望です\n\nシチュ参考：\nhttps://drive.google.com/drive/folders/11dqU7KZkq7ilGJdrVFXEl3PyIuckk8EB?usp=sharing\n岩倉玲音参考：\n\nhttps://drive.google.com/drive/folders/1EVomr5Cldbf5Lb5zO5ptEC11Swn2EWpt?usp=sharing", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hamunohito_/w