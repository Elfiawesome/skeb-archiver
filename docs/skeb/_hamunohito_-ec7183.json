b7 2x, https://si.imgix.net/95c665a4/uploads/origins/b982b50f-124d-4efc-9171-d963d8fb0446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d4a804436c5c2d2eaa389e7d5a904e0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95c665a4/uploads/origins/b982b50f-124d-4efc-9171-d963d8fb0446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d0b579f919894f82723fa7ccec66fb0", "srcset": "https://si.imgix.net/95c665a4/uploads/origins/b982b50f-124d-4efc-9171-d963d8fb0446?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d0b579f919894f82723fa7ccec66fb0, https://si.imgix.net/95c665a4/uploads/origins/b982b50f-124d-4efc-9171-d963d8fb0446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b89a90df6237486785020033e0f82f76 2x, https://si.imgix.net/95c665a4/uploads/origins/b982b50f-124d-4efc-9171-d963d8fb0446?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26f56d05d56f32849cda805ce6f0b730 3x"}, "body": "リクエスト失礼します、作者様の作品である「てんたくるテイマー」からバネッサさんのイラストを差分6枚でリクエストしたいです。\n\n以下がイラスト内容です。\n\n差分1\nバネッサさんは便意が限界となり、屋外で大勢の人々が見てる前で簡易トイレに排便しており、\n出始めているくらいの状態です。構図は斜めくらいからで、バネッサさんの表情、お尻が見えるようお願いします（大勢の人々の描写はある程度で大丈夫です）。\n\n差分2\nバネッサさんの肛門から、本格的に太いモザイクなしの固めの大便が出ています。\n\n差分3\n大便は出し終え、おしっこが出ています。\n\n差分4\n見ていた男性の１人が、紙でバネッサさんのお尻を拭いています。バネッサさんは恥ずかしそうな表情です。\n\n差分5\nべつの男性悪戯でバネッサさんの肛門にカンチョーします。バネッサさんは悶絶しています。\n\n差分6\nそのままバネッサさんは肛門を弄られてしまいます。バネッサさんのリアクションはお任せします。\n\n以上がリクエスト内容です。可能ならバネッサさんや観衆、男性達の台詞も簡単でもあれば嬉しいです。\n描いていただけたら幸せです。どうかよろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hamunohito_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3853607, "client_id": 3848434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dd0d1293f494ea096a913db1fd40bcb", "srcset": "https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dd0d1293f494ea096a913db1fd40bcb, https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=494530b1dbcf73ba7f226136859232bf 2x, https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1c8595fee77dc3cca0e35fd72ccdcdb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9f125b5fcd6b09be50c7548be664f66", "srcset": "https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9f125b5fcd6b09be50c7548be664f66, https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0ce56e44cf596ee0448fc2d785e3fcb 2x, https://si.imgix.net/0d031822/uploads/origins/645a56a9-1075-460f-8b21-f66f85ba47d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d9bdb4422960a69235bd9799ce1f9f 3x"}, "body": "ハムの人さん\nお世話になっております。\nリクエストをお願いします。\n\n前回と同一キャラでお願いします！\n\n【シチュエーション】\n口元を指で摘んだギフトボックスで隠した構図でお願いします。ギフトボックスはラッピング済み。服装はお任せです。\n「（中身は）なんだと思う？」的なイタズラっぽい表情でお願いします。\n\n【差分のお願い】\n着衣、勝負下着、全裸の差分をお願いします。\nギフトボックスの差分もお願いします。\n・ゴ〇ィバ的な高級チョコ\n・チ〇ルチョコなどの駄菓子系チョコ\n・マカロン\n・クッキー\n・マシュマロ\n・福豆、塩こんぶ、スルメなどのネタ系\n・コンドーム\n中身は上記のどれか4つをお願いします。\n\n【キャラの特徴】\n・20歳前後の童顔のお姉さん\n・ショートカットのメガネっ娘\n・等身高めのスレンダー体型\n・微乳、パフィーニップル\n・陰毛あり\n\nご検討いただけると幸いです。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hamunohito_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3853607, "client_id": 3865832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c5beedae294e9d417e179b46c7999f2", "srcset": "https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c5beedae294e9d417e179b46c7999f2, https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24ad861acf42c4874d85707fd8af86a9 2x, https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cda4c82f5004e772f365fca1872312e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2047a056c8bfddd76f136eaf9b312b0b", "srcset": "https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2047a056c8bfddd76f136eaf9b312b0b, https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b4415abc4d903d85312ba53c13afb2 2x, https://si.imgix.net/69708aa0/uploads/origins/e148f1dd-60b1-495a-870d-6558d875555e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92c55ba2b857a8e3bf284e008f9fb87f 3x"}, "body": "触手使いのヴァネッサ、排便を強いられる\n\n前回の作品がとても気に入ったので、今回もヴァネッサの排便をテーマにしたいです。シチュエーションは『触手訓練師』第 9 話で、彼女とハクが椅子に縛り付けられて清掃用品のテストを受けている時のポーズ（全身裸で両足が椅子の上方に縛られ、秘部と後ろの穴が露出している状態）を使用してください。\n\nヴァネッサはテストへの参加を承諾した際、内容に排便が含まれていることを知りませんでした。彼女が9 話の時のように快感を楽しんでいる最中、突然エネマ（灌腸）を施されます。人前で排泄して恥をかきたくないと必死に抵抗しますが、数日間トイレに行っていなかったため溜まったものを抑えきれず、最後には耐えられなくなってしまいます。羞恥心に苛まれながらも、彼女は垂れ流し状態で失禁しながら絶頂に達してしまいます。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hamunohito_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f336c4ce/uploads/origins/7c64cec3-5f1e-4d4f-a3f5-357b3a4c0ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13f0bd7a2509cff86d0fc5240214662a", "srcset": "https://si.imgix.net/f336c4ce/uploads/origins/7c64cec3-5f1e-4d4f-a3f5-357b3a4c0ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13f0bd7a2509cff86d0fc5240214662a, https://si.imgix.net/f336c4ce/uploads/origins/7c64cec3-5f1e-4d4f-a3f5-357b3a4c0ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=579c4ef65ad2bf338a031c1a2ba68f82 2x, https://si.imgix.net/f336c4ce/uploads/origins/7c64cec3-5f1e-4d4f-a3f5-357b3a4c0ee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c984d27099747fdfd002d3a6965c1b2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3853607, "nc": 50}, {"path": "/@_hamunohito_/works/4", "private_thumbnail_image_urls": {"sr