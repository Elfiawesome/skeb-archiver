93\uff0f\u8a71\u3059\u6642\u306f\u59cb\u3081\u306b\u300c\u3042\u30fc\u2026\u300d\u300c\u3093\uff5e\u2026\u300d\u3068\u58f0\u3092\u51fa\u3059\u7656\u304c\u3042\u308b\uff0f\u5bfe\u6226\u683c\u95d8\u30b2\u30fc\u30e0\u7684\u306a\u4e16\u754c\u306e\u4f4f\u4eba\u3067\u3001\u8d85\u4eba\u7684\u306a\u8eab\u4f53\u80fd\u529b\u304b\u3089\u7e70\u308a\u51fa\u3059\u67d4\u9053\u6280\u306e\u6570\u3005\u306b\u52a0\u3048\u3066\u300c\u4f55\u3082\u7121\u3044\u6240\u304b\u3089\u7573\u3092\u53ec\u559a\u3057\u3001\u58c1\u3084\u8db3\u5834\u3084\u6b66\u5668\u306b\u3059\u308b\u300d\u7570\u80fd\u306e\u6301\u3061\u4e3b\u3067\u3082\u3042\u308b\u3002\n\n\uff0a\u5916\u898b\n\u8eab\u9577\uff1a183cm(\u5927\u67c4\u3067\u30ac\u30c3\u30c1\u30ea\u3057\u305f\u3001\u3044\u304b\u306b\u3082\u529b\u6301\u3061\u305d\u3046\u306a\u4f53\u683c)\n\u30d0\u30b9\u30c8\uff1aB\uff5eC\u30ab\u30c3\u30d7(\u80f8\u677f\u306e\u308f\u308a\u306b\u81a8\u3089\u307f\u306f\u63a7\u3048\u3081)\n\u9aea\u8272\uff1a\u30a8\u30e1\u30e9\u30eb\u30c9\u30b0\u30ea\u30fc\u30f3\n\u9aea\u578b\uff1a\u524d\u9aea\u306f\u5207\u308a\u63c3\u3048\u305a\u81ea\u7136\u306b\u5782\u3089\u3057\u3066\u304a\u308a\u3001\u6bdb\u5148\u306e\u4f4d\u7f6e\u306f\u7709\u304c\u898b\u3048\u308b\u7a0b\u5ea6\u306e\u9ad8\u3055\uff0f\u9577\u3044\u5f8c\u308d\u9aea\u306f\u3046\u306a\u3058\u306e\u8fba\u308a\u3092\u30d8\u30a2\u30b4\u30e0\u3067\u300c\u4e00\u3064\u7d50\u3073\u300d\u306b\u675f\u306d\u3066\u3044\u308b(\u6bdb\u5148\u306e\u4f4d\u7f6e\u306f\u80cc\u4e2d\uff5e\u8170\u306e\u7bc4\u56f2\u3067\u304a\u4efb\u305b\u3057\u307e\u3059)\u3002\n\u77b3\u306e\u8272\uff1a\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\n\u9854\u7acb\u3061\uff1a\u6bd4\u8f03\u7684\u4e38\u9854(\u80a5\u6e80\u3067\u306f\u3042\u308a\u307e\u305b\u3093)\uff0f\u7720\u305f\u3052\u306a\u76ee\u3064\u304d\uff0f\u4f55\u51e6\u304b\u30cc\u30dc\u30fc\u30c3\u3068\u3057\u305f\u3001\u920d\u91cd\u305d\u3046\u306a\u96f0\u56f2\u6c17(\u5b9f\u306f\u982d\u306e\u56de\u8ee2\u304c\u65e9\u304f\u3001\u5bfe\u4eba\u9762\u3067\u306f\u7a7a\u6c