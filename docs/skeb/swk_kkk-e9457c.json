73beee58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=825277fbb1fd312c6334d37c429c73aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5d29527/uploads/origins/a09e87f2-1ab7-4f42-ba03-5fc973beee58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a579744b35e5666a94df1db834ed90c4", "srcset": "https://si.imgix.net/f5d29527/uploads/origins/a09e87f2-1ab7-4f42-ba03-5fc973beee58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a579744b35e5666a94df1db834ed90c4, https://si.imgix.net/f5d29527/uploads/origins/a09e87f2-1ab7-4f42-ba03-5fc973beee58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f29de7c92f17f610d0982a1e0c1f7e 2x, https://si.imgix.net/f5d29527/uploads/origins/a09e87f2-1ab7-4f42-ba03-5fc973beee58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bda0d598305b7c42d781a1fb242a4d85 3x"}, "body": "すわさん初めまして。\nFGOでご依頼できそうな方を探したところ見つけさせて頂きました。\n過去作を拝見させて頂いた所、FGOキャラのディティールの多さに挑める画力と胆力を見込み、またアンドロメダちゃんを素敵に描いていたこともありまして、よろしければ「FGOのアンドロメダちゃんに源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」したイラストをお願いできるでしょうか。\n\n・衣装参考：https://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\nこんなお題になった経緯は完全にうちのカルデア事情で……丑御前がライダーで実装したらメインライダー（現冠位）にしようと思った枠を、後発のアンドロメダちゃんが担ったり。\nそんな気持ちのまま丑御前ガチャで引けずに撤退し、直後の石もカツカツ諦め半分な財状から、見事にドロメダちゃんガチャでお迎えという嬉しい揺り戻しも2度あり。\nそんな個人的因縁が「それは“私が代わりに丑御前（ライダー）になる”アピール？」（←？？？）という、ものすごく個人的な妄想として爆発したためですｗ（たまに見かける、すり抜けた子にPU側の服を着せる神々の遊びに類似した発想？）\n\nなんだかんだ理由付けはしてますが、それを口実に第一再臨の丑ちゃんスーツのコスプレ姿を拝みたいという単純な欲求に過ぎないため、シチュエーションについてはご自由に、イメージされるドロメダちゃんらしくして頂ければＯＫです！\n丑御前の代理とばかりににノリノリに着こなすでも、逆に理不尽な理由で着る事になって困惑するでも、「らしい」リアクションで描いて頂ければＯＫです！　あくまで「着せ替えした様子」を拝みたいので、丑御前になりきるまではしなくてOKです。（……というかなりきられて暗く病んじゃうドロメダちゃんは本意ではないのです……ｗ）\nあとアンドロメダちゃんの髪型については、縛ってる方が好みなので、第1か第2再臨のものであると嬉しいですｗ\nまた、一応コスプレ（衣装）がメインなので、なるべくの範囲で程度で十分ですが、衣装が収まる構図で衣装姿を堪能させて頂ければ特に嬉しく思います……！\n\n本当に個人的な都合発のとんでもクセ強なお題とは承知しますが、それでも引き受けて頂けるのでしたら、何卒よろしくお願いします！！\n\nhttps://skeb.jp/@zasyuu_11/works/1", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@swk_kkk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3218941, "client_id": 2568661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=415e8542594ea39445d76735f8a8f7dd", "srcset": "https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=415e8542594ea39445d76735f8a8f7dd, https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=220c33ff9a1411d70e27334f2872584a 2x, https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9dfe90ccf30455ce0c2b58072f58626 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a99bd4a1edbcd6162ba5118125a429", "srcset": "https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8a99bd4a1edbcd6162ba5118125a429, https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=450a5f68a7d0f61d8aefc1c32cce4355 2x, https://si.imgix.net/7d389969/uploads/origins/025ed73c-c701-417a-a205-b10d180491f3?bg=%2