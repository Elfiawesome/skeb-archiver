ebp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a96abb428968f8c3baf4818c190cc186 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/728ae842/uploads/origins/fcae76f6-f87c-41c1-8367-7f58ce614a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=083fcbc2bf41bbdd09edf03a77807211", "srcset": "https://si.imgix.net/728ae842/uploads/origins/fcae76f6-f87c-41c1-8367-7f58ce614a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=083fcbc2bf41bbdd09edf03a77807211, https://si.imgix.net/728ae842/uploads/origins/fcae76f6-f87c-41c1-8367-7f58ce614a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b37ce27a76beb5921ee1af9dbfc77f0 2x, https://si.imgix.net/728ae842/uploads/origins/fcae76f6-f87c-41c1-8367-7f58ce614a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9390f077439eeb39e27c7d05cec8c1b6 3x"}, "body": "はじめまして。\n\nアズールレーンのフィリックス・シュルツにZ11の衣装を着せたイラストをリクエストしに参りました。\n\nZ11について→https://azurlane.wikiru.jp/?Z11\n\n\n詳細\n\n・衣装の着方がZ11本人と違い、ネクタイを身に着けず、スカートもお尻がギリギリ見えそうで見えない位置まで短くしている\n・目にハートマーク浮かべてる状態で指揮官の方を見ながら、指輪がついた左手でピースを作ってギャルっぽく見せてる構図\n・舌ピアスと鉄血マークのへそピアス、耳に鉄血マークのピアスをつけている\n\n\n長文失礼致しました。\nよろしくお願い致します。\n\nhttps://azurlane.wikiru.jp/?%E3%83%95%E3%82%A3%E3%83%AA%E3%83%83%E3%82%AF%E3%82%B9%E3%83%BB%E3%82%B7%E3%83%A5%E3%83%AB%E3%83%84", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Jean_P_Drum/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 656517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=047d6e351e8c824388c7b648f53a1b04", "srcset": "https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=047d6e351e8c824388c7b648f53a1b04, https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efc87075a036220352ede43250f52352 2x, https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e33e30de1943e436daea3aeae37ba633 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee3481d6c7daf2d32e47d647cea2d03e", "srcset": "https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee3481d6c7daf2d32e47d647cea2d03e, https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a53c767adddc73ea2f25843df2c246b 2x, https://si.imgix.net/54713d39/uploads/origins/2f64e2e9-3513-47f5-8ccd-45e2d1e7fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1d72557ccd8541a5b3ff547ce65769 3x"}, "body": "Drum様の描かれた以下の作品の能代が可愛らしく\nhttps://www.pixiv.net/artworks/125506815\n様々な能代を見てみたくリクエストさせていただきます。\n\nアズールレーンの「能代」を描いてほしいです。\n\n能代に「ブラックエース」という衣装を着せたイラストを描いて欲しいです。\nブラックエース参考\nhttps://x.com/azurlane_staff/status/1242703987637248000\n\n\n詳細を以下に書きます\n\n※ブラックエースにある黒の上着はなし\n\n能代は正面を向き\n疲れた表情で息も洗く\nそして全身に汗をかいている。\n\n大量の汗がスポブラにびっしょりついていて\n能代はスポブラを右手でつまんで、空気を通そうとしている。\n左手で秘伝冷却水をもっている。\n※秘伝冷却水はアズレンのゲーム内にて実装されているものでお願いします。\n\n首には鎖付きのチョーカーが巻かれている。\n（ベルファストがつけているようなヤツ）\n\n※腹、胸と腕にあるタトゥーを忘れずに描いてください。\n　腹と腕のタトゥーを（能代からみて）右側にも描いてほしいです。タトゥーは左右対称です。\n\n重桜のエンブレムのタトゥーがあり\nそれらはおへそとスポブラの間（おへその真上）の位置と\n（能代からみて）右側の太ももにある。\n（能代からみて）左側の太ももには「能代」と漢字のタトゥーがある。\n\nそんな彼女を真正面から見た構図で\n太ももの位置まで描いて欲しいです。\n\n色々と細かい注文が多いですが、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 35144, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "emyu", "screen_name": "emyuko", "avatar_url": "https://pbs.twimg.com/profile_images/1961487126459224064/4wJsz4xM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/104812924/1756490302/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1093490, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": ".", "screen_name": "kazami_38b48b", "avatar_url": "https://pbs.twimg.com/profile_images/1370290853764165633/euYJS3kW.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2859714, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Fuyu🐏🥽", "screen_name": "rakugakifuyu", "avatar_url": "https://pbs.twimg.com/profile_images/1895815514879897600/txv_zUSS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316236535730069504/1727763349/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 144}, {"id": 3005908, "creator": true, "nsfw_acceptable":