-b296-74ae6a7d429e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5072a7512be5638ebab0910a8d3a356a, https://si.imgix.net/6aa6dca0/uploads/origins/00a88341-734b-410c-b296-74ae6a7d429e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=496dd7dc18062d46cfe6271ecb58bc8b 2x, https://si.imgix.net/6aa6dca0/uploads/origins/00a88341-734b-410c-b296-74ae6a7d429e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29458c0a5cb9476981bd7211a847dce9 3x"}, "body": "先生、こんにちは！先生の画風が大好きです！私のオリジナルキャラクター、ノヴァを描いていただけませんか？\n\nノヴァ | 199cm\n\nノヴァは、戦乱の地で貪欲な人々を罰するために女神が作り出した「影の国」に悩まされているファンタジー世界出身です。かつては非常に美しく、遊び心にあふれた両性具有の人物でしたが、戦争が勃発してからは、かつての面影をほとんど失ってしまいました。\n裕福な貴族の家に養子として迎えられましたが、その家が腐敗していたこと、そして女神や、自分たちが「価値がない」とみなした人々に対して残酷な振る舞いをする者たちへの憎しみから、その家を去りました。去った後、彼女は戦火から農民たちを守るため、嵐が吹き荒れ、暗く影に満ち、モンスターがはびこる田舎へと向かいました。雷の魔法を使いすぎたため、肌には稲妻のような傷跡が残りました。孤独な日々を送り、孤立しています。 神々のいない、より良い世界を願っている。\n\nテーマ：稲妻、月、影、サルビアの花\n\n顔には稲妻のような傷跡があるが、描かなくても構わない。どんな表現でも大歓迎だ！ありがとう！\n\nhttps://drive.google.com/drive/folders/1yzilWQGsPAG02rbWxZpwgDkFiUt_hTd6?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naya_sono/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3848838, "client_id": 2495946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fce26de3/uploads/origins/d1f7ab56-5f20-4b13-a985-7ab7c0e41eac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9bcce548a60f5e5589fb04e907b1d5", "srcset": "https://si.imgix.net/fce26de3/uploads/origins/d1f7ab56-5f20-4b13-a985-7ab7c0e41eac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9bcce548a60f5e5589fb04e907b1d5, https://si.imgix.net/fce26de3/uploads/origins/d1f7ab56-5f20-4b13-a985-7ab7c0e41eac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adc