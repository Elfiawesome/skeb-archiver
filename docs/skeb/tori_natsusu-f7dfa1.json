to=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=248f32d5a72a55923ad82b20152821cf 2x, https://si.imgix.net/2a322943/uploads/origins/e4946a8c-e92e-4106-8973-88eb47f87dff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0796e14dd72c230435d86da39234255 3x"}, "body": "はじめまして。アピールいただきありがとうございます。\nCoCTRPGシナリオ「VOID」の探索者二名（HO1/HO2）を描いて頂きたいです。\n片方は私の探索者ではありませんが、リクエストへの使用許可を頂いています。\n\n構図などすべておまかせします。\n衣装は二人とも　制服　でお願いします。\nシナリオ規約の関係上、ネタバレを含まない内容でお願いします。\n\n＊須炭大和（すた やまと）\n職業：刑事\n年齢/性別：22歳/男性\n身長/体重：176cm/70kg\n\n真面目で真っ直ぐ、ドが付くほどの負けず嫌いの新人刑事。\n溌剌としている。短気で時々頑固。\n\n発想は大変柔軟だがそれゆえに飛び出しがち。\n対岸に怪しい人影がいたら川に飛び込むとか。\n証拠が揃っていないのに犯人を尾行するとか。\n\n＊蒼月（そうげつ）\n職業：刑事\n年齢/性別：外見20代前半/男性型\n身長/体重：175cm/85kg\n\n落ち着いていて穏やか、誰にでも丁寧な態度で接する新型アンドロイド。\n人とほとんど変わらない見た目で、飲食や呼吸などを擬似的に行う事も出来る。\n\n周囲が引くほどのチョコミント好きで、\nその狂信具合は共に行動しているバディに限らず、\n先輩や先輩アンドロイドすらも恐怖させた。\n\n外見などは資料URLを参照ください。\n問題があれば再送/キャンセル下さって構いません。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1oT0yhmP1GJtzOHxkbMjPqNjx3EVc-Cua?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tori_natsusu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1667642, "client_id": 2053776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7067ce19f0025e87f89802ad1524dfc4", "srcset": "https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7067ce19f0025e87f89802ad1524dfc4, https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c83ed3a5b02424e9d2ee50a8946e2ace 2x, https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8473b74357fb894984bccf15d86d7f4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28267691aefce23deddb8c8518e24e7e", "srcset": "https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28267691aefce23deddb8c8518e24e7e, https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e5c1f9f86585ed57dad67b79b08f7f5 2x, https://si.imgix.net/d929f467/uploads/origins/12426d72-ce59-46ed-ab90-462b547bad13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4dcc0a6d72eb3b12e4dd885f8b44e113 3x"}, "body": "鳥 夏栖様\n\n初めまして。アピールありがとうございます。お返事が遅くなり申し訳ございません。アピール文で指名して頂いたうちの子久賀先生をぜひ描いて頂きたいと思いリクエストを送らせていただきました。よろしければリクエストを受けて頂けると幸いです。\n\n以下はキャラクターの設定です。\n年齢は20代前半、男性　くせっ毛　黒縁メガネを掛けている　身長高め\nとある学校で理科を教える新人教師。実験は失敗してばかりで虫が苦手。しかし生徒たちと真剣に向き合ってくれるので、生徒からの人気は高い。\n彼が顧問を務めるオーケストラ部では、指揮を振っている。指揮棒を握るといつものぎこちない雰囲気とは打って変わって、優雅な動きで指揮棒を振るう。\n趣味はバイオリンの演奏。本当はプロのバイオリニストになりたかったが、金銭的な事情で諦めている。\n\n構図ですが、指揮しているポーズかバイオリンを弾いている様子でお願いします。\n\n不明な点はご自由に描いて頂いて大丈夫です。ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1y4f629ooTabI86lbzpEd84IiW_CBohKm?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tori_natsusu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1667642, "client_id": 2106766, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be140c94/uploads/origins/064c50fe-6f55-46de-b3cf-96f2