at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=936dbba2616bfd78d5f48cf8f06e22d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e57931c1/uploads/origins/590c2de9-d534-431c-864e-38057340674a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72518e0dd49659ab6a3cf5a96b788c35", "srcset": "https://si.imgix.net/e57931c1/uploads/origins/590c2de9-d534-431c-864e-38057340674a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72518e0dd49659ab6a3cf5a96b788c35, https://si.imgix.net/e57931c1/uploads/origins/590c2de9-d534-431c-864e-38057340674a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a8b34271fca899ff95d2cbbb3fd2fa0 2x, https://si.imgix.net/e57931c1/uploads/origins/590c2de9-d534-431c-864e-38057340674a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58911f80feddc15d7d664fa6717b971f 3x"}, "body": "はじめまして、Moouと申します。\n最近描かれていた桔梗の作品を拝見し、とても素敵で印象に残り、ぜひ同じような雰囲気で私のキャラクターも描いていただけたら嬉しいと思いリクエストさせていただきました。\n\n今回お願いしたいのは、私がVRChatで使用しているLapwingというアバターです。\nLapwingのベースモデルを改変したアバターで、以下のリンクにデザインや衣装の参考をまとめています。服装や細かいアレンジについては、ふわふわまんじゅう様のお好きなものを選んでいただいて大丈夫です。\n\nまた、もし可能でしたら、参考リンク内にあるGondolaという小さなキャラクターも一緒に描いていただけると嬉しいです。\n\n全体の構図や背景、表情なども含めて、内容はすべてお任せいたします。\n桔梗の作品のような雰囲気で描いていただけたらとても嬉しいです。\n\n参考リンク：\nhttps://drive.google.com/drive/folders/1jo-fwzd6vppoxrh_WbWZW1JJg1ycDB1b?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niramanju_09/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3508602, "client_id": 322585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97a352e0e99566a97cd54504c1fcd42", "srcset": "https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b97a352e0e99566a97cd54504c1fcd42, https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd1a3fda9a2d7726960c9c32e4ca6a46 2x, https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d4d5ce4c9a54abaab5257a2b70efc9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0f12564ccd328e8833a750fd1e20aa", "srcset": "https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0f12564ccd328e8833a750fd1e20aa, https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f604b203d165f0b247a3e58f286b9f9 2x, https://si.imgix.net/46fa6e17/uploads/origins/a99c48ff-75ad-4bd4-ba3d-ab10030f4f3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bdabd85461483d973f93216e9e660f3 3x"}, "body": "ふわふわまんじゅう様\n\nリクエスト失礼いたします。\n個人VTuberとして活動中の猫谷花火（ねこたに　はなび）と申します。\nふわふわとした雰囲気の可愛い女の子や生きているかのような表情や雰囲気のイラストが素敵だなと思い、ご連絡しました。\n\n■希望サイズ︰縦長\n\n■ファイル形式：PNG\n　　　　　　　　PSD（人物、小物、背景を別レイヤー）\n\n■イラスト内容\n・等身イラスト\n・キービジュアルやサムネイルなどで使用するため、髪や頭、手など切れていないカメラ目線の全身を希望。\n・可能であれば表情差分あると嬉しいです（微笑んでいる顔、恥ずかしがっている顔、慌てている顔、ウィンク、にっこり顔などお任せします）\n・服は資料フォルダ内の「通常服(オレンジスカート)」「白ワンピース」「ユニット衣装(青、アイドル風衣装)」のうち、どれでもお好きなもので描いていただいて大丈夫です。\n\n■希望イラストイメージ\n①https://x.com/niramanju_09/status/1970