5a-4658-80bf-8547bc40e004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc2d17fa49eb274a4de9a03e206e7ce1, https://si.imgix.net/f256a36c/uploads/origins/f86d99f9-765a-4658-80bf-8547bc40e004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9be767f438e62da551c89a10b71e5acc 2x, https://si.imgix.net/f256a36c/uploads/origins/f86d99f9-765a-4658-80bf-8547bc40e004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3abd5d6ee6d19bb169fbf5b5ea99b6ce 3x"}, "body": "一夜人見様、はじめまして。一夜人見様のイラストがとても大好きです！\nTRPGのOCを描いていただきたいです。\n\n時代背景：1990年代 HONGKONG、警察とマフィアが激しく対立していた。\n\n3人の人物、全員30↑\n（A）メガネ男：地元最大のマフィアの息子、次期リーダー。知的な悪党風に見える。\n（B）警察男：典型的な正義感が強いタイプの警官。仕事中は厳しいが、実際は優しく良い上司。\n（C）警察女：Bの部下/弟子。聡明で気さく、優しい目をしているが口元はいつも少し引き締まっている。冗談を好きな人。\n\n衣装、ポーズ、構図は自由に調整してください！個人使用のみとさせていただきます。\n価格や依頼内容に問題がある場合は、遠慮なくキャンセルまたは再送してください。\n文法が不自然な部分はご容赦ください。ご清聴ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1TBr1xYVSNcpmOBxaqZ-jbrlHcCTJN511?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1413hitomi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3102208, "client_id": 2190184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea3adb40efcc95d9e0b07a0f533e3c1b", "srcset": "https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea3adb40efcc95d9e0b07a0f533e3c1b, https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5cb17fcb8f865481a238356287855e87 2x, https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92b00180fd788b23db0bbb0198991665 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb41defa1e13defd5879478cdb0401a4", "srcset": "https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb41defa1e13defd5879478cdb0401a4, https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06941a892125ae5c49b653ac136d09b0 2x, https://si.imgix.net/a5c48c43/uploads/origins/9b47caeb-92e1-4f32-bccf-7555ce117fe8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d47e8aef63e3c245cbac9fb3642edd21 3x"}, "body": "こんにちは！前回いただいた作品、とても気に入りました！キャラクターの描き方がとても洗練されていますね！またオリジナルキャラクターをお願いすることは可能でしょうか？事情があって兄のふりをしている王子です。一見穏やかで人懐っこいのですが、結構熱血漢です。笑顔で感情を隠そうとするが、深く反省している。内面は、自分で羽を切った壊れた鳥のよう。魔法と戦闘を得意とし、人生について考えるために長い散歩を楽しむ。\n自由に描いてください。無理そうなら遠慮なく断ってください。リクエストを見てくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1PK7ufDLl1XqbmPnUIRt3uvFc80RcCT4t?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1413hitomi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3102208, "client_id": 2190184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=143279bf3ff004aaa4aeb6419d397925", "srcset": "https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=143279bf3ff004aaa4aeb6419d397925, https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e58ca7052c2a73b0902f0ee082dd145d 2x, https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5912251468091b89c38706f6a5fb92d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66b582442c9bd3fea6bfd8078c808b84", "srcset": "https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66b582442c9bd3fea6bfd8078c808b84, https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d91dde69ddd113752aa50116260a86be 2x, https://si.imgix.net/54ddfa41/uploads/origins/d8e2ff59-2a49-4e49-a6d3-1fac82a39e92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=904ffa9ac0acc97204fc98526d87a295 3x"}, "body": "こんにちは！あなたのスケブを見つけました。あなたの作品がとても好きです！私のオリジナルキャラクターをリクエストすることは可能でしょうか？彼は祖父のノートに隠された暗い秘密を知らずに、その意味を求めて世界中を旅している青年です。彼には2つのモードがあり、イヤリングが太陽や月の光に当たるかどうかで切り替えることができます。彼の外見は、どちらのモードにあるかを反映している。黒髪で描かれる彼の主な性格は、穏やかで一見ナイーブだが、かなり鋭い。モードが切り替わると正反対の行動をとり、通常は悪役を演じる。どちらの人格も相手を高く評価しているが、根は同じ人間だ。普段は傘を差して日差しを遮っている。何でも嬉しいです。無理そうなら遠慮なく断ってください。私のリクエストを見ていただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1SgevO79SAWSi1XTvkjORj5xhaIe4Jti-?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_crea