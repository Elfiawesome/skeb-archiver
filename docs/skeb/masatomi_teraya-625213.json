dk\n\n▼その他詳細資料\nhttps://drive.google.com/drive/folders/1lhF8aBIC2h1uedtThI4eVt115unWDd5d\n※資料はあくまでも参考であり、服装や髪型の形態などは適宜簡略化やアレンジ等して頂いて構いません。\n該当のワンシーンにつきましても、「酔っ払った受けが攻めを蓮見に誘い、記憶が途切れて終わる」部分のみの描写でも問題ございません。\n\n金額感やスケジュール他、当リクエストが気乗りされないようであれば、ご遠慮なくキャンセルされてくださいませ……！\nもしお引き受けいただける場合は、描写等寺谷さんのご負担にならない範囲でご調整頂けますと幸いです。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1lhF8aBIC2h1uedtThI4eVt115unWDd5d", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masatomi_teraya/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1426480, "client_id": 3154710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d4d6baa/uploads/origins/8c569e0e-57a5-4218-a1c9-102cb77cf62d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e56f1ff35cbbf759276d8660adbffe", "srcset": "https://si.imgix.net/9d4d6baa/uploads/origins/8c569e0e-57a5-4218-a1c9-102cb77cf62d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e56f1ff35cbbf759276d8660adbffe, https://si.imgix.net/9d4d6baa/uploads/origins/8c569e0e-57a5-4218-a1c9-102cb77cf62d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f32f773ca87c3a5499049c8ad61a890d 2x, https://si.imgix.net/9d4d6baa/uploads/origins/8c569e0e-57a5-4218-a1c9-102cb77cf62d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2b2efa3eeb08874e156b4f6ca57189c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d4d6baa/uploads/origins/8c569e0e-57a5-4218-a1c9-102cb77cf62d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de11160cf6fae74dec87eee2fb3cc94f", "srcset": "https://si.imgix.net/9d4d6baa/uploads/origins/8c569e0e-57a5-4218-a1c9-102cb77cf62d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de11160cf6fae74de