b-a1c7-bd8a87a5ce8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc1a2492d7189a0db0727cc9f16377aa 3x"}, "body": "体調はいかがでしょうか?\n最近暑いのでお体にお気をつけください!!\n縁側でゆっくりお茶を飲んでいる博麗霊夢と霧雨魔理沙をお願いします🙇\n縁側でゆっくりとお茶を飲んで顔が穏やかな博麗霊夢と、緑色の葉っぱをつけた木が風でサーッという音を立てて、鳥がチュンチュンと鳴いている平和な博麗神社。\nそんな平和な一面をお願いします🙇\n構図・ポーズは下記の通りです✨\n・画角は真横又は外から縁側を見て斜め右上\n・縁側には、箒🧹と小さいお皿の上に乗ったお饅頭が数個\n・霊夢のポーズは縁側に正座又は椅子に座るように足を下に出す座り方、湯呑みを両手で持っている\n・魔理沙のポーズは縁側で足をぶらぶらしながら霊夢と談笑、笑っている表情をお願いします\n・緑葉をつけた木が風でサーッと流れている様子を画角の右上又は左下にお願いします。\n\n以上になります!\nこれ以外の部分につきましては自由で大丈夫です!\n要望がかなり多くなってしまいましたが、よろしくお願いします🙇\n\nこれからの活動応援しております🙇\n例大祭でまた会える日を心よりお待ちしております!!!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sumishiro_8070/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1638873, "client_id": 2875232, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e17b228/uploads/origins/9f34a168-a69a-4425-bae7-3d0c7d95951d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcfb8af84d30bc732f4214b6378054c2", "srcset": "https://si.imgix.net/3e17b228/uploads/origins/9f34a168-a69a-4425-bae7-3d0c7d95951d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcfb8af84d30bc732f4214b6378054c2, https://si.imgix.net/3e17b228/uploads/origins/9f34a168-a69a-4425-bae7-3d0c7d95951d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e4609b82b7737ed409c7363dad1508a 2x, https://si.imgix.net/3e17b228/uploads/origins/9f34a168-a69a-4425-bae7-3d0c7d95951d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c62e2e46c42c31c4c34b286c69aa995 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e17b228/uploads/origins/9f34a168-a69a-4425-bae7-3d0c7d95951d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200