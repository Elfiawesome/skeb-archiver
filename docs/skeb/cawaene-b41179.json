3002\u6c34\u7a7a\u3067\u3059\u3002\n\u3084\u307e\u3060\u3055\u3093\u306e\u30dd\u30c3\u30d7\u3067\u4e01\u5be7\u306a\u30a4\u30e9\u30b9\u30c8\u304c\u672c\u5f53\u306b\u672c\u5f53\u306b\u5927\u597d\u304d\u3067\u3001\u4eca\u56de\u3082\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u304a\u9001\u308a\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\n\u81ea\u5275\u4f5c\u306b\u767b\u5834\u3059\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u300c\u30e9\u30cb\u30fb\u30d5\u30a9\u30fc\u30b2\u30eb\u300d\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u3092\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u4ee5\u4e0b\u8a72\u5f53\u30ad\u30e3\u30e9\u306e\u8a73\u7d30\u306b\u306a\u308a\u307e\u3059\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u60c5\u5831\u3011\n\u540d\u524d\uff1a\u30e9\u30cb\u30fb\u30d5\u30a9\u30fc\u30b2\u30eb\uff08Rani Vogel\uff09\n\u5e74\u9f62\uff1a18\u6b73\uff0f\u8eab\u9577\uff1a178cm\uff0f\u6027\u5225\uff1a\u7537\u6027\n\u9aea\uff1a\u30aa\u30ec\u30f3\u30b8\uff5e\u8336\u8272\u306e\u660e\u308b\u3044\u9aea\u8272\u3002\u9996\u306e\u3042\u305f\u308a\u307e\u3067\u306e\u9577\u3055\u3067\u3001\u5c11\u3057\u3075\u308f\u3063\u3068\u3057\u305f\u67d4\u3089\u304b\u3044\u8cea\u611f\u3002\u30b9\u30c8\u30ec\u30fc\u30c8\u3067\u306f\u306a\u304f\u3001\u8efd\u304f\u30af\u30bb\u306e\u3042\u308b\u81ea\u7136\u306a\u30ab\u30fc\u30eb\u304c\u7279\u5fb4\u3067\u3059\u3002\u5f8c\u308d\u3067\u3086\u308b\u304f\u675f\u306d\u3066\u3044\u307e\u3059\u3002\n\u77b3\uff1a\u30a8\u30e1\u30e9\u30eb\u30c9\u30b0\u30ea\u30fc\u30f3\n\u58f0\u306e\u30a4\u30e1\u30fc\u30b8\uff1a\u843d\u3061\u7740\u3044\u305f\u4e2d\uff5e\u4f4e\u97f3\u3002\u666e\u6bb5\u306f\u656c\u8a9e\uff0b\u7d20\u3063\u6c17\u306a\u3044\u304c\u3001\u512a\u3057\u3055\u304c\u6ef2\u3080\u8a71\u3057\u65b9\n\u4e00\u4eba\u79f0\uff1a\u300c\u50d5\u300d\n\u4eba\u7269\u50cf\uff1a\u843d\u3061\u7740\u3044\u305f\u96f0\u56f2\u6c17\u306e\u9752\u5e74\u3067\u3001\u30b5\u30fc\u30ab\u30b9\u56e3\u306b\u6240\u5c5e\u3059\u308b\u541f\u904a\u8a69\u4eba\u3002\n\n\u3010\u670d\u88c5\uff08\u666e\u6bb5\u7740\uff09\u3011\n\uff65\u30b7\u30f3\u30d7\u30eb\u304b\u3064\u843d\u3061\u7740\u3044\u305f\u30c7\u30b6\u30a4\u30f3\u306e\u9752\u5e74\u98a8\u8863\u88c5\uff08\u65c5\u4eba\u3089\u3057\u3044\u96f0\u56f2\u6c17\uff09\n\uff65\u6df1\u3044\u7dd1\u306e\u30de\u30f3\u30c8\u3092\u7740\u7528\n\uff65\u30d5\u30a9\u30fc\u30b2\u30eb\u4e00\u65cf\u306b\u4f1d\u308f\u308b\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u3092\u3069\u3053\u304b\u306b\u7740\u3051\u3066\u3044\u307e\u3059\uff08\u30da\u30f3\u30c0\u30f3\u30c8\u3001\u6307\u8f2a\u3001\u30d6\u30ed\u30fc\u30c1\u7b49\u3001\u81ea\u7531\u306b\u89e3\u91c8\u3057\u3066\u304f\u3060\u3055\u3063\u3066\u5927\u4e08\u592b\u3067\u3059\uff09\n\n\u3010\u96f0\u56f2\u6c17\u30fb\u6027\u683c\u3011\n\uff65\u57fa\u672c\u306f\u6de1\u3005\u3068\u3057\u305f\u65c5\u4eba\u6c17\u8cea\n\uff65\u97f3\u697d\u306b\u306f\u3068\u3066\u3082\u60c5\u71b1\u7684\u3067\u3001\u983c\u307e\u308c\u308c\u3070\u516c\u6f14\u5916\u3067\u3082\u6f14\u594f\u3092\u3059\u308b\uff08\u305f\u3060\u3057\u5b89\u58f2\u308a\u306f\u3057\u306a\u3044\uff09\n\n\u3010\u9b54\u6cd5\u3011\n\uff65\u4e0a\u7d1a\u9b54\u6cd5\u304c\u4f7f\u3048\u308b\u541f\u904a\u8a69\u4eba\n\uff65\u97f3\u3092\u5a92\u4ecb\u306b\u3057\u305f\u9b54\u6cd5\u3092\u6271\u3046\uff08\u97f3\u306b\u547d\u3092\u5bbf\u3059\u3001\u97f3\u3092\u901a\u3057\u3066\u7269\u3092\u52d5\u304b\u3059\u306a\u3069\u30a4\u30e1\u30fc\u30b8\uff09\n\u203b\u9b54\u6cd5\u63cf\u5199\u306b\u95a2\u3057\u3066\u306f\u7d75\u306b\u53cd\u6620\u3044\u305f\u3060\u304b\u306a\u304f\u3066\u5927\u4e08\u592b\u3067\u3059\u304c\u3001\u30ad\u30e3\u30e9\u306e\u4e16\u754c\u89b3\u306e\u53c2\u8003\u3068\u3057\u3066\u304a\u4f1d\u3048\u3057\u307e\u3059\n\n\u3010\u30e2\u30c1\u30fc\u30d5\u3011\n\u7fbd\u6839\uff08\u65c5\u3084\u4e00\u65cf\u306e\u8c61\u5fb4\uff09\u3068\u97f3\uff08\u5f7c\u306e\u9b54\u6cd5\u3068\u751f\u304d\u65b9\u306e\u8ef8\uff09\u3