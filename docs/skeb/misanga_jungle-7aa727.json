3de36b3-be33-49b3-852f-7db3b472eaee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f33cfc56b545784d31b11818918c1f23", "srcset": "https://si.imgix.net/8e379eb4/uploads/origins/63de36b3-be33-49b3-852f-7db3b472eaee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f33cfc56b545784d31b11818918c1f23, https://si.imgix.net/8e379eb4/uploads/origins/63de36b3-be33-49b3-852f-7db3b472eaee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ea38975238946d9cf3697116faf9897 2x, https://si.imgix.net/8e379eb4/uploads/origins/63de36b3-be33-49b3-852f-7db3b472eaee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bba3ae49696f394f174e2e63bbe0a071 3x"}, "body": "こんばんは。\nR-18　イラストをお願い致します。\n\n■キャラ\n悩んで決めきれませんでした。この中から貴方様に一人選んで頂けますと幸いです。\n①ローン（アズールレーン）\n②クルスク（アズールレーン）\n③蒼森ミネ（ブルーアーカイブ）\n④聖園ミカ（ブルーアーカイブ）\n\n■シチュエーション\n拘束状態での小型でキモい生物によるパイズリ。\n可能でしたら、パイズリ役以外にも胸にヒルのように吸い付く個体や身体にまとわりつく個体が複数いると嬉しいです。\n\nお忙しいところ大変恐縮ですが、何卒よろしくお願い致します。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misanga_jungle/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1461457, "client_id": 1579960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5997d645d906ae59947e6178d0fb0724", "srcset": "https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5997d645d906ae59947e6178d0fb0724, https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=156a94448e220584492f5f9b08c3dba8 2x, https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3040d6ea8bed96eebeb6252bc044b83c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21cd3d93202b139a313dbddc37cd4283", "srcset": "https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21cd3d93202b139a313dbddc37cd4283, https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9eec83a25221f0711e07d8e7d3e72da3 2x, https://si.imgix.net/80218865/uploads/origins/fda99bd0-53ac-4acc-bbe1-8e7c5f6f6371?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b700429360c423b32c517bc3f5800ae 3x"}, "body": "はじめまして\nかねてよりトガリ二等兵様の描かれる異形生物による乳辱イラストを大変好ましく拝見させて頂いており\n特にその肉感的な体つきの描写、苦悶と共に快楽に堕ちる表情、乳肉に対する徹底的な責め苦の数々に強い魅力を感じ、依頼させていただきました\n\n自分のオリジナルキャラクターを、トガリ二等兵様の作風で、徹底的に胸を陵辱されているようなイラストに描いて頂けませんでしょうか\n\n≪イラストの内容≫\n人並より巨大で敏感な両胸を異形生物に一方的に無慈悲に弄ばれ陵辱され、襲い来る快楽で延々と絶頂させられ続ける一部始終\n\nトガリ二等兵様が掛かれていた「美味しいミルク」シリーズのように、異形の生物に両胸を弄ばれて、羞恥と嫌悪に表情を歪め行為を否定し忌避しながらも、想像を越える快楽に抗えず無理やり絶頂に導かれてしまうような、そんな表情を描いて欲しいです\n\nその他細かい要素は全てお任せします\n\nエロければ乳腺を犯されようが胸を膨乳されようがどんな過激な事をして頂いても構いません、体に不可逆な変化を与えられるシチュエーションも大好物なのでどうぞ遠慮なくドエロく描いて欲しいです。\n\n≪備考≫\n・顔立ちは特徴さえ合っていれば似ている程度で構いませんので、トガリ二等兵の作風で描いて頂けると嬉しいです\n・胸のビキニは胸の描写に邪魔だったら半脱ぎにするか脱がしてしまってください\n\nもし募集の意図にそぐわない･条件的に厳しい･趣味が合わないなど\n何か問題があるようでしたら遠慮なくキャンセルして頂いて構いません\n\n何卒よろしくお願い致します。\n\n-----　-----　-----　-----　-----　\n\n■キャラクター設定■\n：名前：\n　エメリア・翡翠・グリーンウッド\n\n：外見：\n　・根本が深緑で毛先が若草色の後ろ纏め緑髪\n　・ビキニ状の日焼け跡のある褐色肌\n　・薄い水色の竜目\n　・片方が折られた白い角と尖り耳\n\n：胸の特徴：\n　・顔より二回り以上巨大で静脈が浮いた胸\n　・巨大でふっくらと隆起した巨乳輪\n　・乳頭が肉に埋もれた陥没乳首（勃起すると平たく広がる巨乳首）\n　・カウベルの乳首ピアス\n\n：衣装：\n　・牛柄の卑猥なコスチューム\n　・バーコードのタトゥー\n\n■キャラクター設定２■\n：性格：\n　・一人称オレを使用する男勝りでやや粗暴な性格\n　・無知からくる蛮勇と無鉄砲な言動が目立つ\n　・刀を乱暴に振り回す若い鬼人族の娘\n\n：過去の経験：\n　・悪漢に敗北して捕まり、角を1本へし折られ体を性的に改造された経験がある\n\n：胸の異常：\n　・元々標準サイズだった両胸が規格外に大きく肥大化しており、乳輪が隆起して乳首が陥没してしまった\n　・陥没乳首から常に母乳が滴り湿っており、内部が膣のヒダのように歪に絡んでいる\n　・胸に静脈が浮き出ており、乳輪の皮膚に指が触れただけで強烈な快楽に襲われ母乳が滴り落ちる\n\n：境遇：\n　・人ではなくまるで家畜のように扱われ、馬などの家畜との種付けや性処理の道具として扱われるなど、過酷な陵辱を受け続けている\n\nhttps://drive.google.com/drive/folders/1-_IPJrFtlkZcynZ0nymQKZBPyxEX8eR4?usp=sharing", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misanga_jungle/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1461457, "client_id": 1803855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05ca33e00be5981c0c3294d9ba23f84", "srcset": "https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f05ca33e00be5981c0c3294d9ba23f84, https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74633b5a01a9c9771aff07be7694a612 2x, https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93048a1aa96653f4cee8798cca41f978 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f3755ea0c55b949d3f7724945e9f94f", "srcset": "https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f3755ea0c55b949d3f7724945e9f94f, https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b53266ababd58ee3fd1383512b0da633 2x, https://si.imgix.net/51e0d95e/uploads/origins/aa00647e-e4bf-45b4-a161-8911549c1fda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0bfb08fc84eb9fbddbba9f9a357dbb3 3x"}, "body": "井川さくら https://www.pixiv.net/en/artworks/114004304 、巨乳（オッパイ）でお願いします https://x.com/XxSuzakux7xX/status/1301993335884779525\n\n小さな怪獣にパイズリを与える。モンスターのデザインはお任せします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misanga_jungle/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1461457, "client_id": 2755298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a445ae6611acc2b59928e77175cd918", "srcset": "https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a445ae6611acc2b59928e77175cd918, https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f6c47bab7b72b819bd9719987a26e35 2x, https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a46b2a799c41d82e522c92f4cac8917e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c6cfca5e94f64e741b93920b461113f", "srcset": "https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c6cfca5e94f64e741b93920b461113f, https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f43ff8c5813686d8447bba82c6a0174 2x, https://si.imgix.net/eeb43b79/uploads/origins/78a192f8-1572-4db0-83e4-bcb74351b400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fda00f236f4535bfee3e3bccd57fad6c 3x"}, "body": "こんにちは。\n\nアズールレーンのキャラクターなのですが、キアサージのイラストをお願いします。\n\nキアサージは、ニュージャージーのイラストのように全体像が見えるアングルだと嬉しいです。\n\nシチュエーションとしては、身動きが取れないキアサージに小さい生物（ナメクジ・幼虫と人間が一緒になったような感じで）に蹂躙される内容だと嬉しいです。片方の乳首にニプルファック、もう片方の乳首を吸い付きを小さい生き物がしていると興奮します。\n\nもし可能でしたら、キアサージの頭部だけオールナイト・チャージのバニー差分があると嬉しいです。\n\n要望が多くて申し訳ございませんが、何卒よろしくお願い致します。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misanga_jungle/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1461457, "client_id": 2755298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2560090a498aafb47656bfaac37095d", "srcset": "https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2560090a498aafb47656bfaac37095d, https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b4965390801a734e2b2318e14dc3c05 2x, https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=161287ef68d6e938495e03b83b0e8426 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b84b54e28bdea5ef002b24c4bf14151f", "srcset": "https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b84b54e28bdea5ef002b24c4bf14151f, https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b152a77ea56cacf50f375015b9efff73 2x, https://si.imgix.net/8791ac21/uploads/origins/96e213f7-7d4d-4d7d-b7a6-f7460b550291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f40209ddb8198c10f54e2948831340 3x"}, "body": "こんにちは。\n\nこの前はニュージャージーの素晴らしいイラストをありがとうございました。\n\nまたアズールレーンのキャラクターなのですが、インプラカブルのイラストをお願いします。\n\nインプラカブルは、拘束されて無理やりダブルピースをしている状態でお願いします。ムチムチで爆乳、乳首と乳輪はかなりでっかくしてください。\n\nシチュエーションとしては、身動きが取れないインプラカブルに小男が群がり両方の乳首でニプルファックを行う内容を希望します。群がる小男は、以前にフリードリヒを書いて戴いたときの醜悪な小男を更に小さくした体型だと嬉しいです。\n乳輪の大きさ>小男くらいだと圧倒的な上位的存在を犯している優越感があり興奮できます。\n\nもし可能でしたら、まだ群がられていないインプラカブル、乳首をちゅうちゅうと吸われるインプラカブル、爆乳に蟻のようにたくさん小男が群がっているインプラカブルの差分があると嬉しいです。\n\n欲望丸出しで申し訳ございませんが、何卒よろしくお願い申し上げます。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misanga_jungle/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1461457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7be785cd/uploads/origins/12fdcc54-7d05-41bd-8135-90d37e438489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aec3a71e360151fa54f4263f3