002/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2502005, "client_id": 494190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2358328778342f12e5f1e71fbad5aea1", "srcset": "https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2358328778342f12e5f1e71fbad5aea1, https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9eedb20e23bd71de1c55a3d333f00a60 2x, https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78d25ff90a9891bcd2f721c84f96b232 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b733ff272990fec6ec997a1ff5d4208", "srcset": "https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b733ff272990fec6ec997a1ff5d4208, https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa0b03879848a9bd4201c817dba24116 2x, https://si.imgix.net/cdfc1c91/uploads/origins/394b2d50-3a87-4269-a8b1-baf55de6c883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b7ef83fd9c2e9b45353a460965a2244 3x"}, "body": "サクラノ詩/サクラノ刻の夏目藍ちゃんをお願いします。 シチュエーションは直哉の自室にて、直哉が母乳が出るようになった藍ちゃんの母乳を絞ったり吸ったりするシチュエーションでお願いします。 具体的な詳細ですが、藍ちゃんがペタン座りで、直哉が足を伸ばして後ろから抱きつくような形でお願いします。 ブラをズラして片手で母乳を絞たり吸ったりして、もう片手でクリトリスを愛撫し、絶頂し愛液と母乳が噴き出て、その際ハート目になるという差分構成でお願いしたいです。 藍ちゃんの服装に関してはサクラノ刻verの抱き枕カバーの衣装で上半身がはだけ、ブラがおっぱいの下にズレた状態でお願いします。 直哉の衣装に関しては上半身だけ裸の半裸状態で、ズボンはスーツのズボンを履いている状態でお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoyaki032002/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/91c8b751/uploads/origins/579309e4-0236-4998-a9e3-31bbe656e659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69bcbaabeadccea506c17a2aa828ab05", "srcset": "https://si.imgix.net/91c8b751/uploads/origins/579309e4-0236-4998-a9e3-31bbe656e659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69bcbaabeadccea506c17a2aa828ab05, https://si.imgix.net/91c8b751/uploads/origins/579309e4-0236-4998-a9e3-31bbe656e659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cba44b2cc0cf333bd66f38531f55310f 2x, https://si.imgix.net/91c8b751/uploads/origins/579309e4-0236-4998-a9e3-31bbe656e659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2e70b820e86b529097a29bc454e7ce0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2502005, "nc": 161}, {"path": "/@takoyaki032002/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2502005, "client_id": 2081762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbfb20ea91b6b3ad8c3229f7fcbe168", "srcset": "https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adbfb20ea91b6b3ad8c3229f7fcbe168, https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3976cc8584d02dd7c87bcf9ba4d259f5 2x, https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76bdfbc80d86fcadae865be9f9764611 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8966c8dd8956d2f89114eba2778c2df1", "srcset": "https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8966c8dd8956d2f89114eba2778c2df1, https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a6c1157e42325ff9405dd3ae57baf32 2x, https://si.imgix.net/7c184bca/uploads/origins/e3c62b96-57ff-4c87-97a2-2e0065278425?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2fae9491c97000e4c997438efa57a751 3x"}, "body": "mimizu様\nいつも素晴らしいイラストを拝見しております。\n依頼内容ですが凌辱系でよろしければお願いします。\n＊キャラクター\n・九條都\n＊服装\n・コスプレの衣装で下記のために胸元、お腹、おまんこ周辺は破れて剥き出し\n・身体中に淫紋\n・舌、乳首、クリトリス、ヘソに派手なピアス。\n・動物用の首輪\n＊構図\n・服従のポーズ(おまんこ、尻穴が見えるくらい)。\n＊シチュエーション\n・敵(能力者、または触手)に敗北してしまい、淫紋および呪いのピアスをつけられてます。呪いによって本人の意思とは無関係におねだりするようなポーズをとらされています。(意識自体は最初は正気を保ってる。)。\n人間相手なら廃墟や治安が悪いところ、触手なら肉壁で体を舐めまわされてる。\n以下差分が可能でしたら。\n①最初はまだ折れずに敵を睨みつける形で。(表情は反抗的な感じ、または諦めない感じ)\n②淫紋から性感帯を高められ、限界に達しイキションを激しくする。(気持ち良くて蕩けた表情)\n③凌辱されて精液を浴びながら、子宮に限界まで注がれる。(泣きそう、または拒絶している表情)\n④呪いが完全に解呪できなくなり、無限に卵、または触手を産卵し続けてしまう。産み落としても何もしてないのに淫紋のせいで子宮内に敷き詰められる(産む度に下品で人目を気にしない感じの表情)\n\nある程度は描きやすいように改変、解釈していただいて大丈夫です。また、差分に関しては多い分には構いませんが厳しければ大丈夫です。\n以上長くなりましたが可能でしたらよろしくお願いします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoyaki032002/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2502005, "client_id": 93806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d876e79796699c5627dcda21322665", "srcset": "https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5d876e79796699c5627dcda21322665, https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc71456f703f20c30530932528e3e6bd 2x, https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6b0a3834b397d63843c70d78678a6ba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d3eb07d8594c0128eb0bef67321dd35", "srcset": "https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d3eb07d8594c0128eb0bef67321dd35, https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9728d63edd1a7f4e6741ec4c5d05e83f 2x, https://si.imgix.net/349226ae/uploads/origins/26b8bad8-f4db-4c0e-abc7-444ad9a21bd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc396ec38bfb98aeba051963b2e12410 3x"}, "body": "mimizu先生\nお世話になっております\n\n『サクラノ刻』の『本間心鈴』のイラストをお願いします\n\n■内容\n母乳が出る体質になった心鈴ちゃんは、男性に母乳を吸われまくる\n※以前心鈴ちゃんの母乳イラスト描かれていたので私も母乳イラスト依頼したいと思い、この内容にさせていただきました\n\n■構図\n斜め45度の角度で心鈴ちゃんの両手はおっぱいの上に乗せている状態でお願いします\n\n■シチュの流れ\n①ブラ越しから母乳が溢れている\n②男性にブラをずらされ、心鈴ちゃんから見て左のおっぱいを吸われ、もう片方は手で揉まれ感じる心鈴ちゃん\n③おっぱいをいじられ絶頂し、母乳も噴射\n④蕩け顔を晒し先程以上に母乳が垂れている\n※絶頂後は心鈴ちゃんの周りにハートが浮かんでいる感じでお願いします\n※可能であれば、パンツも見えている状態でパンツ越しから愛液が垂れ、絶頂時は潮吹きしていただけるとありがたいです\n\n■服装\n聖ルーアンの制服姿で以下のURLのようにはだけている状態でお願いします\nhttps://livedoor.blogimg.jp/oshoeroge/imgs/1/7/177027d5.jpg\n※下着のデザインはお任せ致します\n\n■表情\n吸われる前は緊張しつつ、吸われている最中は感じまくっている表情でお願いします\n※ハート目差分もあると嬉しいです\n\nお忙しいところ恐縮ですが、宜しくお願い致します\n\nhttps://www.makura-soft.com/sakuranotoki/", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoyaki032002/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2502005, "client_id": 2460336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03359a31/uploads/origins/5013a8e9-4aa4-40e1-834a-08b5bd5b5b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe1742f3872470cd378714ca2d06173e", "srcset": "https://si.imgix.net/03359a31/uploads/origins/5013a8e9-4aa4-40e1-834a-08b5bd5b5b74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe1742f3872470cd378714ca2d06173e, https://si.imgix.net/03359a31/uploads/origins/5013a8e9-4aa4-40e1-834a-08b5bd5b5b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce2be68730614f4483277a4dc101b6ea 2x, https://si.imgix.net/03359a31/uploads/origins/5013a8e9-4aa4-40e1-834a-08b5bd5b5b74?bg=%23fff&au