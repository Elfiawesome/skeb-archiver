夏目藍」または「九條都」\n・プレイ内容\n擬似ボテ腹産卵プレイ\n・以下内容\nまんぐり返し、または分娩台のようなもので、股を大きく開いて卵的な物を排泄しながら仰け反り絶頂しているキャラをお願いします。\nお腹はパンパンに卵を詰め込まれてそれを排泄するとともに絶頂する感じです。\n身体に淫紋みたいな落書きが可能でしたらお願いします。\n異種姦に抵抗がなければ、分娩台ではなく触手苗床みたいな場所にして、プレイではなく実際に触手に卵を孕まされている、淫紋も落書きじゃなく実際に付与されている物をお願いします。\n\n以上長くなりましたが抵抗がなければよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoyaki032002/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fcd9f037/uploads/origins/1c302165-5a23-410d-bc0e-7136f485e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07f63ac0cc26dee9e1963845fc3391e3", "srcset": "https://si.imgix.net/fcd9f037/uploads/origins/1c302165-5a23-410d-bc0e-7136f485e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07f63ac0cc26dee9e1963845fc3391e3, https://si.imgix.net/fcd9f037/uploads/origins/1c302165-5a23-410d-bc0e-7136f485e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=895e0423e3486e00fe378a9c743db1fe 2x, https://si.imgix.net/fcd9f037/uploads/origins/1c302165-5a23-410d-bc0e-7136f485e5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=78da519d4fec9d6e8a761a94467b1c44 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2502005, "nc": 49}, {"path": "/@takoyaki032002/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2502005, "client_id": 492916, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdb83560/uploads/origins/a327797c-00d4-49f1-b4bf-2ff7