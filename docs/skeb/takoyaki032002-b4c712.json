d1f362ebc57", "srcset": "https://si.imgix.net/b676be1d/uploads/origins/23c7bddc-81ae-47ac-b395-454ca5a3da99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfd16b5cd832c91f21655d1f362ebc57, https://si.imgix.net/b676be1d/uploads/origins/23c7bddc-81ae-47ac-b395-454ca5a3da99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93f0c4c87bf4d1bb7dc0870b670c02f4 2x, https://si.imgix.net/b676be1d/uploads/origins/23c7bddc-81ae-47ac-b395-454ca5a3da99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84ec2386262345822559096812c87443 3x"}, "body": "「サクラノ刻」より「本間心鈴」をお願いします。\n\n構図のように斜めから見ている感じで、ロングコートの前を開けて露出させている。もう少し下から見上げる視点で、心鈴の視線は自分の身体を見下ろしてるように。\n衣装は乳首やマンコが見えているような局部露出しているランジェリーをお願いします。気持ち普段描かれるのより乳首と乳輪を大きくしてほしいです。\n汗をかかせてあげてください、蒸れ蒸れな感じ。\n\n表情はドキドキして荒い息を吐いているものと、興奮して笑っているものが欲しいです。\n\n\n\n納品はPSDデータで、名前ありなしの2つ(レイヤー分け可)欲しいです、よろしくお願いします。\n\n公式\nhttps://www.makura-soft.com/sakuranotoki/\n\nhttps://drive.google.com/drive/folders/1MXbNq9L8S5xtH8RqaGFMssNB8R_AqSxl", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoyaki032002/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2502005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f5242a1c21e8c5a43e7173feca00de", "srcset": "https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f5242a1c21e8c5a43e7173feca00de, https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c829d661412fc6642e3b7cc515ba3c08 2x, https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7b2c03d3f4b8bf479b5e504cfa0b914 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1352aa5f21e61d38caa272d92e800d85", "srcset": "https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1352aa5f21e61d38caa272d92e800d85, https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49506ad1670e288a8e5d076a5185a497 2x, https://si.imgix.net/f002f593/uploads/origins/cba44a6a-5af4-445a-a0a1-ee03a32387ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7234c0a9286a635b820c0d632a025e32 3x"}, "body": "初めまして。いつもお世話になっております。\nある日mimizu先生のイラストを拝見し、真琴さんが母乳を出していましたので、なら心鈴ちゃんも母乳が出るんじゃないか？　という考えに達しました。\n清楚系ロリ巨乳の心鈴ちゃんが母乳出してるところを見たいという欲が出てきてしまいましたので、そこで今回はサクラノ刻の本間心鈴ちゃんが母乳を出しているイラストをお願いしたいと思います。\n\n細かい部分や構図はお任せしたいと思います。\nただ欲を言えば、原作にも出てきた寝巻姿で、はだけて胸を露出しているものだと嬉しいです。（参考画像1）\nもう少し欲を言えば、騎乗位でイチャラブエッチしてるのがいいです。おっぱいを強調するように、セルフ授乳しているとなおいいです。（参考画像2枚目）\n（男性側の描写に特に指定はありません。適当でも透明人間でも大丈夫です）\n更に欲を言えば、絶頂差分と絶頂直後差分、全裸差分も欲しいです。\n\nちょっと欲望が出過ぎてしまった気がしますが、何卒ご検討頂ければ幸いです。\nよろしくお願い申し上げます。\n\n（参考画像）\n\nhttps://x.com/takoyaki032002/status/1660273201073750018/photo/1\nhttps://ul.h3z.jp/QcNiIN3G.jpeg", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoyaki032002/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2502005, "client_id": 417644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62b0007af7cff6a298645bafc766e7d", "srcset": "https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62b0007af7cff6a298645bafc766e7d, https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d65426d22cbffaff00c6e3e274e138ce 2x, https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f81f0617d9e12246a7c251e1f8f3e85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61c8bf94505bacebc129388534613d94", "srcset": "https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61c8bf94505bacebc129388534613d94, https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=247798c92c52f76346f6487285a65e84 2x, https://si.imgix.net/aff88421/uploads/origins/e92c8a20-0bb1-4275-8518-b113d01d2ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21ca18ad92cf639da4a5ac51754b5497 3x"}, "body": "お初にかかります\n〝蒼の彼方のフォーリズム 〟より、〝鳶沢みさき〟と〝乾沙希〟のツーショットイラストをお願いします\n衣装\n胸元が強調された水着姿\nみさきが露出度高めのセクシー路線、沙希がフリル等がついたキュート路線\n表情\nみさきは見せつけるような得意げな表情\n沙希は不思議そうなきょとんとした表情\nその他\nみさきと沙希の胸は凄いたわわな巨乳サイズで若干みさきの方が大きくなるよう差異を設けていただきたいです", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, 