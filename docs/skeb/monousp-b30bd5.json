f37-9ae6-152e58416eed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6128f21d6fb6a99cd12192121bc0b567, https://si.imgix.net/04d8f637/uploads/origins/b28f3920-8a8e-4f37-9ae6-152e58416eed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b1b74bb6b2a1f78aff0cd3ecdfe56b6 2x, https://si.imgix.net/04d8f637/uploads/origins/b28f3920-8a8e-4f37-9ae6-152e58416eed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1d7aefc115a5794d4d86c40955676bd 3x"}, "body": "メギド72のユフィール先生をお願いします！\n\n■形式\nカラー2P～を希望ですが、\n金額や工数が難しければ再提示やキャンセルなどお願いします！\n文字表現は漫画(台詞は吹き出し)でも、イラストに文字を載せるでもおまかせします。\n\n■キャラ\nユフィール\n・見た目は☆3くらいのイメージ。胸はどたぷんとデカい。\n　裸描写ありの場合は乳輪大きめ、陰毛を書かれる場合は髪と同じ色で自然に生えた感じ。\nおじさん\n・中年ヴィータ。モブおじさん感が出ていれば見ためは変えていただいても構いません。\n　中年体型でチンチンも陰毛も生えていてズル剥けor包茎気味とオス感が強い。\n　性格はおまかせですが、野蛮系ではなく真面目寄りのイメージです。\n　https://hitobito72.vercel.app/characters/xy6xqp9l\n\n■内容\n下記のシチュからお好きなものでお願いできればと思います。\nまた、内容の変更や雰囲気同じであれば違う内容にしていただいても構いません。\n\n①入院患者とのエッチ\n手を怪我してるとか何かしの理由で自慰ができず溜まりに溜まって、\n毎晩夢精を繰り返すストロングな患者に対して、流石に手を打たねばと就寝前に抜いてあげるシチュ。\nビッチではなく、かつ完全な笑顔でもなく、\nう～ん、本当はダメなんですけど・・皆さんには内緒ですよ(汗)みたいな、\n仕方なしで困ったような笑顔でスタートするものの、\n嫌がる訳でもなく母性を感じるような優しく射精を促してくれるイメージになります。\n\n②診療所でのエッチ\nチンチンの悩み(早漏とか包茎とかサイズ)で診察を訪れたおじさん。\n少し触診しますねと軽く触られただけでイッてしまい、\n観察のために顔を近づけていたユフィールにモロに顏射してしまう。\nあはは・・と困り笑顔の後、まだバキバキな男性のチンチンを見て、\nこのままじゃ診察できないんで全部出しちゃいましょうかとエッチスタート。\n雰囲気は割と①と似た感じになります。\n\n■その他\n・服装は初めは着ていて、その後はおまかせします。\n　早々に脱いでもいいですし、最後まで脱ぎはせず胸も局部も映らないもOKです。\n　(シチュにあったエロい感じで)\n・エッチの内容もおまかせします。\n　ものうさんのイメージで、どこまでさせてくれるんだろうで書いてください。\n　結果、本番なしでもエロければOKです！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monousp/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/acb9f508/uploads/origins/897a0e88-3a04-41e1-a795-2fb29c8441a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsiz