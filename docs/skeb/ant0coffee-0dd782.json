-4878-b976-5dded92d1bab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2469401b07871f0492cb3955fb2f41c", "srcset": "https://si.imgix.net/f6ae8fed/uploads/origins/f89906e1-7385-4878-b976-5dded92d1bab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2469401b07871f0492cb3955fb2f41c, https://si.imgix.net/f6ae8fed/uploads/origins/f89906e1-7385-4878-b976-5dded92d1bab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d04d1fd5a0b0fdb2123946a7e8377d90 2x, https://si.imgix.net/f6ae8fed/uploads/origins/f89906e1-7385-4878-b976-5dded92d1bab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92b235efff193a02caa4ef5c7093873e 3x"}, "body": "nあくた　様\n\nはじめまして\nVtuberの猫ヶ谷なすびと申します\nFGOの氏真様とおみぃさんが大好きです🙏💕\n是非お時間がありましたらリクエストよろしくお願いいたします\n\n私、猫ヶ谷なすびのイラストお願いしたいです\nTwitter(X)での投稿やYoutubeの配信のサムネイルに使用したいと思っています\n頭周り等切れないように描いて頂きたいです\n表情やポーズはお任せいたします\n\n背景を描いて頂ける場合は人物を透過したPSDデータも頂きたいです\n可能であれば表情差分も一緒にお願いできますと幸いです\n色々な配信のサムネイルに使用したいと考えているので表情豊かな差分をつけて頂けましたら嬉しいです\n\nデザインにつきましては下記をご参考ください(お好きなデザインで大丈夫です)\n▼通常衣装\nhttps://lit.link/nekogayanasubi\n\n▼新衣装も出しました\nhttps://x.com/i/status/1992241164561658089\n\n猫耳は取り外し可能ですが、配信の時は9割つけていますのでイラストでもつけて頂きたいです\n髪の紫と同じ色のネイルをしております\n口を開けると小さく牙が有ります\n瞳の色はグレーです\n猫耳にピアスあり\n描かれる際はご参考くださいませ\n\nどうぞよろしくお願いいたします!!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ant0coffee/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 14880, "client_id": 372110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23f6111a/uploads/origins/3644599f-65cc-418b-82ed-8e68ff2f1974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb1d326bf09e7861058f020df472bd41", "srcset": "https://si.imgix.net/23f6111a/uploads/origins/3644599f-65cc-418b-82ed-8e68ff2f1974?bg=%23fff&auto=format%2Ccompress&f