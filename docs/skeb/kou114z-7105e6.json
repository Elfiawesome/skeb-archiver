305d\u3057\u3066. \u8907\u6570\u679a\u5dee\u5206\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u3001\u305d\u308c\u305e\u308c\u306e\u5e0c\u671b\u5dee\u5206\u3092\u66f8\u304b\u305b\u3066\u9802\u304d\u307e\u3059\u3002\n\n1. \u304a\u8336\u3092\u305f\u304f\u3055\u3093\u98f2\u3093\u3060\u306e\u3067\u3061\u3087\u3063\u3068\u3057\u305f\u5c3f\u610f\u3092\u611f\u3058\u59cb\u3081\u305f\u5922\u5b50,  \u307e\u3060\u6211\u6162\u3067\u304d\u308b\u306e\u304b\u3001\u3082\u3058\u3082\u3058\u3057\u3066\u3044\u307e\u3059\n2. \u5c3f\u610f\u304c\u9650\u754c\u9593\u8fd1\u306b\u8feb\u308a\u3001\u5927\u4e8b\u306a\u3068\u3053\u308d\u3092\u304e\u3085\u3063\u3068\u62bc\u3055\u3048\u606f\u3092\u8352\u304f\u3057\u306a\u304c\u3089\u3001\u304c\u304f\u304c\u304f\u3068\u8eab\u4f53\u3092\u9707\u308f\u305b\u306a\u304c\u3089\u5fc5\u6b7b\u306b\u6211\u6162\u3057\u3066\u3044\u307e\u3059\u3002\n3. \u3064\u3044\u306b\u6211\u6162\u3057\u304d\u308c\u306a\u304f\u306a\u3063\u305f\u304a\u3057\u3063\u3053\u304c\u3001\u30b7\u30e7\u30fc\u30c4\u306b\u5c11\u3057\u305a\u3064\u6ef2\u3093\u3067\u3044\u304d\u307e\u3059\u3002(\u670d\u306e\u8868\u9762\u306b\u307e\u3067\u306f\u307e\u3060\u6fe1\u308c\u3066\u306a\u3044\u611f\u3058\uff09\n4. \u3082\u3046\u5c11\u3057\u3084\u3089\u304b\u3057\u3066\u3057\u307e\u3044\u3001\u4eca\u5ea6\u306f\u30b9\u30ab\u30fc\u30c8\u307e\u3067\u6fe1\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002\n5. \u3064\u3044\u306b\u6c17\u529b\u304c\u5c3d\u304d\u3066\u3057\u307e\u3044\u3001\u304a\u3082\u3089\u3057\u3092\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\n\u4e0b\u7740\u3084\u670d\u306e\u80a1\u306e\u4e2d\u5fc3\u90e8\u5206\u3092\u6fe1\u3089\u3057\u306a\u304c\u3089\u3001\u6211\u6162\u3057\u304d\u308c\u306a\u304b\u3063\u305f\u304a\u3057\u3063\u3053\u304c\u3042\u3075\u308c\u51fa\u3066\u3044\u307e\u3059\u3002\n\n\u52a0\u3048\u3066\u3001\u3061\u3087\u3063\u3068\u3057\u305f\u30bb\u30ea\u30d5\u3082\u3042\u3063\u305f\u3089\u3044\u3044\u306a\u3068\u601d\u3044\u307e\u3059\u3002 \u3069\u3093\u306a\u30bb\u30ea\u30d5