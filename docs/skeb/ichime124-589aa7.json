うございました！\n\n参考資料 👇 ←クリック\n\nhttps://www.dropbox.com/sh/o7n3argdhnqgfsd/AACl23fcZ7V3nB1qFPH8Wz53a?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichime124/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3277247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cce498b0a7303da904971a06f7a571f3", "srcset": "https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cce498b0a7303da904971a06f7a571f3, https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5c9b1732fa4aa57c8b26762a9a0c281 2x, https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13ded3f5972430918c0b3069cc45e57b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d26c8d7398f5696eb4a3007d0802b6e", "srcset": "https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d26c8d7398f5696eb4a3007d0802b6e, https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca314e08423fb60e83efcae4e60e16db 2x, https://si.imgix.net/70ad5f71/uploads/origins/2c0b0a67-117e-4c72-8e45-2da9dc07a7ba?bg=%23fff&auto=format%2Cc