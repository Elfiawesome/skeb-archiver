u5e78\u3044\u3067\u3059\u2026\u2026\uff01\n\u7528\u9014\u306f\u500b\u4eba\u9451\u8cde\u306e\u307b\u304b\u3001\u30a4\u30e9\u30b9\u30c8\u767a\u6ce8\u6642\u306e\u53c2\u7167\u8cc7\u6599\u3068\u3057\u3066\u306e\u5229\u7528\u306a\u3069\u3092\u60f3\u5b9a\u3057\u3066\u304a\u308a\u307e\u3059\u3002\n\u3069\u3046\u305e\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u3010\u30a4\u30e9\u30b9\u30c8\u6982\u8981\u3011\n\u30fb\u6614\u308f\u308b\u3044\u9b54\u5973\u3092\u3084\u3063\u3066\u3044\u305f\u9803\u306e\u59ff\u3001\u3068\u3044\u3046\u30b3\u30f3\u30bb\u30d7\u30c8\n\u30fb\u3068\u3093\u304c\u308a\u5e3d\u5b50\u306b\u30ed\u30fc\u30d6\u3001\u9ed2\u30e1\u30a4\u30f3\u306e\u30aa\u30fc\u30eb\u30c9\u30b9\u30bf\u30a4\u30eb\u306a\u9b54\u5973\u8863\u88c5\n\u30fb\u68d8(\u7720\u308a\u306e\u68ee\u306e\u7f8e\u5973\u7531\u6765)\u3001\u88c1\u7e2b\u304c\u30ad\u30e3\u30e9\u306e\u30e1\u30a4\u30f3\u30e2\u30c1\u30fc\u30d5\u306a\u306e\u3067\u3001\u53ef\u80fd\u306a\u3089\u7279\u306b\u524d\u8005\u306e\u8981\u7d20\u3092\u5f37\u3081\u306b\n\u30fb\u76ee\u3064\u304d\u60aa\u3081\u3001\u8868\u60c5\u4e0d\u6a5f\u5acc\u3081\n\n\u4e0a\u8a18\u8981\u7d20\u3092\u8e0f\u307e\u3048\u305f\u3046\u3048\u3067\u3001\u8a73\u7d30\u306f\u304a\u4efb\u305b\u3057\u305f\u3044\u3067\u3059\u3002\n\u30a2\u30ec\u30f3\u30b8\u3001\u72ec\u81ea\u89e3\u91c8\u3001\u306a\u3093\u3067\u3082\u5927\u6b53\u8fce\u3067\u3059\uff01\n\n\u3010\u30ad\u30e3\u30e9\u8a2d\u5b9a\u306a\u3069\u3011\n\u540d\u524d\uff1a\u30d0\u30fc\u30d0\u30e9\n\u5e74\u9f62\uff1a\u4e0d\u660e\n\u8eab\u9577\uff1a170cm\u7a0b\u5ea6\n\u5916\u898b\u5e74\u9f62\uff1a18~20\u6b73\u7a0b\u5ea6\n\n\u8328\u3084\u91dd\u3092\u64cd\u308b\u529b\u3092\u6301\u3064\u9b54\u5973\u3002\n\u4ed6\u306e\u9b54\u5973\u305f\u3061\u306e\u670d\u3092\u4f5c\u308a\u306a\u304c\u3089\u66ae\u3089\u3057\u3066\u3044\u308b\u3002\n\u5916\u898b\u3084\u666e\u6bb5\u306e\u88c5\u3044\u306b\u53cd\u3057\u3001\u7a4f\u3084\u304b\u3067\u793c\u5100\u6b63\u3057\u304f\u3001\u306e\u3093\u3073\u308a\u3