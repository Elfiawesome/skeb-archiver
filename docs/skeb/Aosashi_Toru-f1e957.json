2F2018325390738231296%2FCgd9hPDU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39943fe16278102fa8a9c4a79b9a044b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2018325390738231296%2FCgd9hPDU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbacbf0eef0125cd83f5407868983ea8 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/65b28fa4-6e14-4b2f-9adf-5d37032a5d3e?response-content-disposition=inline&Expires=1771842887&Signature=gwTDr1zPbKh3UNwXjGSRE2Ks~8jHpRR-Xfe1Y5JlCb2f3LYv-NyQv822J1S-bUF2Entg-16FYGZRNMSMJN2XWuaNSMTkJZAPS87e71JtSiJg0SE~Pv1pWeXaMm-5i8KvK9iuxTzbg7br7yg~0lJ-Bi7MtmhryRLtCxcdHsXUQUd3JZ1sb5a9X6CZPZFipphm1EMnMrZe6~VE-Al4Fw-FfCcG0lWSw3oX2yPJxqVjCZUJnYDvXLoc6XWN943y8t8VHlhHj4XzZOGON1f-kGaGbriWgp4mXAFlCCAjTSkClDCk4zpZWppDLSSU2~liJEznQFOsQQlQeSQT6ihWRz4Abg__&Key-Pair-Id=K1GS3H53SEO647", "duration": 358, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2018325390738231296%2FCgd9hPDU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6e9b1fa70a44f8188ab15aa145aff43", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2018325390738231296%2FCgd9hPDU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6e9b1fa70a44f8188ab15aa145aff43, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2018325390738231296%2FCgd9hPDU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2e32ec6b58736431135e8eee571a4ee 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2018325390738231296%2FCgd9hPDU.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b62e210dbb8533925c7f283e12ff340 3x"}, "body": "街を歩く…今は夜の8時…今日は小ぶりの雨だった…傘を忘れてしまい雨宿りのために偶然見つけて入ったお店で奇妙な出会いをするというのがこの台本のおおまかな流れです。基本的に主人公は声を聞く人…つまり夜渡りですね。そしてそんな夜渡りに語り掛ける謎の女性とは？というのがこちらの台本となっております。とおるさんにはなんとなく儚（はかな）げでそして愉快に笑うお姉さんを演じていただきます。（台本で指示を出してしまってもいいのだろうかと疑問には思いますが…（）の中にある指示をなるべく意識してほしいです。）\nそれでは本編の始まりです。\n\nカランカラン♪\nお姉さん（これ以降はとおるさん）「おや？マスター！お客さんだよ～？」\n（ここはちょっと嬉しそうに）\n\nとおるさん「君…びしょぬれだね～マスタータオル持ってきてあげて？」\n（ちょっとだけ心配する感じで）\n\nとおるさん「うんうん…大体タオルで拭けたかな？まぁとりあえず座りなよ…ここは落ち着いていい場所だよ？」\n（お店がホントに大好きなんだって感じで…難しいとは思いますがよろしくお願いします。）\n\nとおるさん「それで？あなたは何を頼むの？まず何か頼んで私と話そうよ♪」\n（すごく陽気な感じで話しかけてほしいです）\n\nとおるさん「え？おすすめ？う～～ん…まぁ私がよく頼むのはブレンドコーヒーかなぁ？しっかりとした味わいにほのかな酸味があってなにより香りがいいんだ…うん？それにする？…フフッ嬉しいよ」\n（楽しそうにそして嬉しそうにお願いします）\n\nとおるさん「フフッ…必死にフーフーしてる。可愛いね？君は猫舌なのかい？」\n（お姉さん味たっぷりでよろしくお願いします。）\n\nとおるさん「君分かりやすいね。フフッ…そんなに美味しそうに飲んでるとなぜだか私もうれしくなってしまう…え？俺より喜ぶなって？マスターは口下手だから私が代わりにたくさん喜んでもいいと思うんだけど…君はそうは思わないかい？」\n（楽しそうになおかつ最後の疑問文はすこしだけ距離近めでお願いします。）\n\nとおるさん「フフッごめんごめん。急に近づいてしまって申し訳ない…え？気にしてない？ならよかった。それで？何かあったの？君…来店するとき顔曇（くも）ってたから…多分何かあるんでしょ？君素直だからね～…あって間もないけどわかる…君は優しすぎて抱え込むタイプでしょ？違う…？」\n（最初のほうは単純に陽気な感じで「それで？」のところからはすこし声のトーンを落としてもらって…真剣な雰囲気でお願いします。）\n\nとおるさん「へぇ…仕事でうまく行かなくて…抱え込んでるんだ…周りは気にしないで？と言ってくれてるけど罪悪感があってなかなか頼れない…と…なるほどねぇ～…君は他人には優しくできるけど自分には優しくできない人間か…私とは真逆だな！」\n（ちゃんと聞いたうえで最後のところはすこしだけトーンをあげてほしいです。）\n\nとおるさん「私はね…楽観主義なんだ…どうにかなれ～の精神で生きてる…まぁだからいいアドバイスとか多分できないけど…これだけは言っておくね？自分に優しくできなかったらいつか人間ってのは崩れてしまう…だから自分自身の心とちゃんと向き合うことだ…そうしないとつらく感じしてしまうからな…いやだろう？せっかく夢がかなってそこで働いているのに…好きなはずなのにつらく感じてしまうなんて…」\n（ここはひたすら優しく…お姉さん味全開で！）\n\nとおるさん「ふむ…私はもう出ようかな？ごちそうさまマスター…君もまたあったらここに来ると言い…だいたい夕方から私はここにいるから…ばいばい…うん？なんだ？私の手をつかんで…もしかして君…寂しいのか？寂しくて私を引き留めたのか？どうなんだい？（ﾆﾔﾆﾔ）」\n（ここでからかいモードを発動してください！）\n\nとおるさん「え？その通りだって？…き、君はやはり素直すぎるな/// ほんの冗談のつもりだったのに…それで？なんだい？ケーキ奢るからもう少しいてほしい？ふ～～ん…じゃぁもう少しいようかな？」\n（最初は照れている感じを全開で！そしてケーキ奢るのくだりはルンルンな感じで！）\n\nとおるさん「う～～ん♡やっぱり甘いものっていいねぇ～…君もそう思わないかい？ってもう食べ終わってしまっているのか…まぁそれだけマスターのケーキが気に入ったってことだろうね…フフッ可愛いよ君…」\n（めっちゃ優しめな感じで…主人公をからかってあげてください）\n\nとおるさん「私たちがイチャイチャしすぎ？迷惑だからケーキ食ったらさっさと帰れ？何を言っているんだ？マスターは…君も否定を…ってなんで君は顔真っ赤なんだい！？…まったく…フフッこのお店は退屈しないな…」\n（本当に楽しそうにお願いします）\n\nとおるさん「また会いに来てね？待ってるよ？フフッ♡」\n（まじで柔らかく…そし