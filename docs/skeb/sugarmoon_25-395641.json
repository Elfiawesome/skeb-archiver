677, "client_id": 1205721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83c745ba0160f096b39eb9c91332352", "srcset": "https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d83c745ba0160f096b39eb9c91332352, https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a3a0da6028bb1845fe5d2feadb7b454 2x, https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75abd3e2a93e0e3fe23d1e3f66c15b67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e7836775e87e11e94fcd87b4305208c", "srcset": "https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e7836775e87e11e94fcd87b4305208c, https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42cc9b31eaaea47733f6b7fbceb19249 2x, https://si.imgix.net/d210107f/uploads/origins/0faff400-a907-416f-bd2c-b48d578e70d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5d0dd4c1196f67d85df0d2d1cacaaed 3x"}, "body": "こんにちは。いつも応援しております。\n\nご依頼の内容ですが、よろしければ私のオリキャラを描いていただきたいです。\n外見は青みがかった黒髪、目の上ぱっつんのボブ、両サイドに垂れた犬耳のようなはね毛、青目、下まつげです。性格は無感情で従順です。服装はスーツとメイド服がありますが、素直様の描きやすい方でお願いしたいです。\n\n資料URLは自作のイラストと以前クリエイター様に描いていただいたもので