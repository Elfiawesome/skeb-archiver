6\u3044\u308b\n\u30fb\u4f4e\u8eab\u9577\uff08153cm\u7a0b\u5ea6\uff09\n\u30fb\u5168\u4f53\u7684\u306b\u30b9\u30bf\u30a4\u30eb\u304c\u826f\u3044\n\u30fb\u9854\u7acb\u3061\u306f\u3084\u3084\u5e7c\u3044\n\u30fb\u76ee\u3064\u304d\u306f\u3084\u3084\u60aa\u3044\u3001\u30c4\u30ea\u76ee\n\u30fb\u72ac\u8033\u3001\u72ac\u5c3b\u5c3e\u3064\u304d(\u3082\u3075\u3082\u3075\u3057\u3066\u308b)\n\n\u3010\u9aea\u578b\u3011\n\u30fb\u9aea\u578b\u306f\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306b\u3057\u3066\u304f\u3060\u3055\u3044\n\uff08\u4eba\u9593\u306e\u8033\u306f\u306a\u3057\u306e\u305f\u3081\u3001\u3042\u307e\u308a\u8033\u5143\u304c\u76ee\u7acb\u305f\u306a\u3044\u30c7\u30b6\u30a4\u30f3\u306b\u3057\u3066\u304f\u3060\u3055\u3044\uff09\n\u30fb\u9aea\u306e\u8272\u306f\u9280\u9aea\u3068\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u3010\u76ee\u306e\u8272\u3011\n\u30fb\u76ee\u306e\u8272\u306f\u9752\u8272\u3068\u3057\u3066\u304f\u3060\u3055\u3044\n\u30fb\u30a6\u30de\u5a18\u306e\u30c0\u30a4\u30ef\u30b9\u30ab\u30fc\u30ec\u30c3\u30c8\u306e\u3088\u3046\u306b\u3001\u77b3\u5b54\u304c\u92ed\u3044\n\n\u3010\u670d\u88c5\u3011\n\u30fb\u670d\u88c5\u306f\u30bb\u30fc\u30e9\u30fc\u670d\u3067\u6d77\u5175\u3092\u610f\u8b58\u3057\u3066\u30c7\u30b6\u30a4\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u30fb\u30df\u30cb\u30b9\u30ab\u30fc\u30c8\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u30fb\u30bb\u30fc\u30e9\u30fc\u670d\u306e\u4e08\u306f\u77ed\u3081\u3068\u3057\u3001\u5c11\u3057\u3078\u305d\u304c\u898b\u3048\u308b\u304f\u3089\u3044\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u30fb\u9774\u306f\uff08\u30b3\u30f3\u30d0\u30c3\u30c8\uff1f\uff09\u30d6\u30fc\u30c4\u306b\u3059\u308b\u306a\u3069\u3001\u30df\u30ea\u30bf\u30ea\u30fc\u7684\u306a\u8981\u7d20\u3092\u3044\u308c\u3066\u304f\u3060\u3055\u3044\u3002\n\u30fb\u9ed2\u624b\u888b\u3092\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u3002\n\u30fb\u30b5\u30a4\u30cf\u30a4\u30bd\u30c3\u30af\u30b9\uff08\u592a\u3082\u3082\u3042\u305f\u308a\u307e\u3067\u30