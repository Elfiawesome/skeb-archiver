n同居人の少女に振り回されつつも楽しい日々を過ごしている。\n\n✤髪の毛について\nボブではなく後ろでお団子にしています。\n\n✤衣装について\n複数種類がありますのでお好みのものをお選びください。\n『デザイン画』の場合はラフなイラストとなりますので、不明瞭な点はご自由に補完ください。\n\n✤耳・尻尾について\n耳は馬耳のみで、人耳はありません⚠️\n服に隠れていますが髪色と同じ、馬のしっぽが生えています。\n\n\nキャラクターシートもドライブに同梱しておりますので、こちらもご参考下さい。\n\n金額はアピールを頂いた際の金額に設定しておりますが、不足がある場合は再送して頂けますと幸いです。\n今回もよろしくお願い致します🍒\n\nhttps://drive.google.com/drive/folders/1-saGtfks_Hs1FRebk6ahN1gtQyDtBeat", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1228629, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メ・バヂス・バ名言bot", "screen_name": "GRONGIKBTIT", "avatar_url": "https://pbs.twimg.com/profile_images/1779803760140955648/6JwJposC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1736000677133119488/1732719093/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2825679, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "絵が好き", "screen_name": "noname__da", "avatar_url": "https://pbs.twimg.com/profile_images/1992984809367564288/jda4CUZZ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 3243349, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Alpha", "screen_name": "gopokenohito", "avatar_url": "https://pbs.twimg.com/profile_images/2021849947130540037/9rUB2FDY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1419300249764450315/1732164586/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_ran