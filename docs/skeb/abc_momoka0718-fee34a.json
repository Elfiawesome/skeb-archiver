になるので確認してほしい：\n士郎と衛宮の眉尻の稲妻を描いてほしい。\nubwルートは殺し合いの気持ちで描きたいのですが、cpの感覚で描きたいのに雰囲気が甘くなりすぎないようにしてほしいです。\n無料のポストカードを印刷して自分で配りたいので、絵の縮尺は正方形かL判がベストです。\n初めてSKEBを使う外国人で、日本語も勉強中なので、変な文法や単語を使っていたらごめんなさい。私の要望を受け入れてくれることを楽しみにしています！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@abc_momoka0718/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 336247, "client_id": 24, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bf71ab1/uploads/origins/9677380f-643c-4808-b76f-57e7c1af3a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33acbb7d7dd9d84679ac65b1defa453c", "srcset": "https://si.imgix.net/1bf71ab1/uploads/origins/9677380f-643c-4808-b76f-57e7c1af3a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33acbb7d7dd9d84679ac65b1defa453c, https://si.imgix.net/1bf71ab1/uploads/origins/9677380f-643c-4808-b76f-57e7c1af3a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c68351dd0317d2d1632d4cbb33be55ff 2x, https://si.imgix.net/1bf71ab1/uploads/origins/9677380f-643c-4808-b76f-57e7c1af3a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6dcadc9a8c944778d9ea3a5d7b53569 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bf71ab1/uploads/origins/9677380f-643c-4808-b76f-57e7c1af3a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa5f62085c78b054049dd763fabfa901", "srcset": "https://si.imgix.net/1bf71ab1/uploads/origins/9677380f-643c-4808-b76f-57e7c1af3a44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa5f62085c78b054049dd763fabfa901, https://si.imgix.net/1bf71ab1/uploads/origins/9677380f-643c-4808-b76f-57e7c1af3a44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3ab0210