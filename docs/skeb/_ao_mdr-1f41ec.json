7fe0\u9ce5\u69d8\u306e\u7d20\u6575\u306a\u30a4\u30e9\u30b9\u30c8\u3092\u62dd\u898b\u3057\u307e\u3057\u3066\u3001\u900f\u660e\u611f\u3084\u53ef\u611b\u3055\u304c\u672c\u5f53\u306b\u597d\u307f\u306e\u7d75\u67c4\u3067\u2026\u3001\u78a7\u7fe0\u9ce5\u69d8\u306e\u63cf\u304f\u767d\u6885\u30eb\u30a4\u3092\u898b\u3066\u307f\u305f\u304f\u3066\u4f9d\u983c\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3089\u305b\u3066\u9802\u304d\u307e\u3057\u305f\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u7279\u5fb4\u3011\n\u6b63\u9762\u3067\u898b\u3066\u3001\u5de6\u5074\u306e\u30a4\u30f3\u30c6\u30fc\u30af\u3001\u524d\u9aea\u306e\u5de6\u5074\u3068\u53f3\u76ee\u306e\u4e0a\u306e\u6bdb\u5148\u306b\u767d\u30e1\u30c3\u30b7\u30e5\u304c\u3042\u308a\u307e\u3059\u3002\n\u77b3\u306e\u77b3\u5b54\u306f\u82b1\u306e\u5f62\u3067\u3059\u3002\n\u30d1\u30c3\u30c4\u30f3\u524d\u9aea\u3067\u306f\u306a\u304f\u30a2\u30fc\u30c1\u72b6\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002\n\u4eca\u56de2\u679a\u898b\u305f\u76ee\u306e\u53c2\u8003\u753b\u50cf\u3092\u6dfb\u4ed8\u3055\u305b\u3066\u9802\u304d\u307e\u3057\u305f\u304c\u3001\u3069\u3061\u3089\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\u3002\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\nX\uff08\u65e7Twitter\uff09\u3084YouTube(\u5c06\u6765\u7684\u306b\u53ce\u76ca\u5316\u306e\u53ef\u80fd\u6027\u6709\u308a)\n\u5404\u7a2eSNS\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u30a2\u30a4\u30b3\u30f3\u3001\u30d8\u30c3\u30c0\u30fc\u7b49\n\u203b\u4f7f\u7528\u4f8b\u3068\u3057\u3066\u3001#\u304a\u306f\u3088\u3046Vtuber\u7b49\u3067\u3001\u30a4\u30e1\u30fc\u30b8\u3092\u640d\u306a\u308f\u306a\u3044\u7bc4\u56f2\u3067\u8efd\u5fae\u52a0\u5de5\u3092\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002\n\n\u69cb\u56f3\u7b49\u304a\u4efb\u305b\u3057\u307e\u3059\u304c\u3001\u304b\u308f\u3044\u3044pop\u8abf\u306b\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u3067\u3059\u3002\u9854\u5468\u308a\u306b\u624b\u304c\u3042\u308b\u307b\u3046\u304c\u53ef\u611b\u304f\u3066\u597d\u304d\u306a\u306e\