re": true}, {"path": "/@ooo_z30/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3045250, "client_id": 2666902, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e949cde5be3c86ed9637273d3dcc0209", "srcset": "https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e949cde5be3c86ed9637273d3dcc0209, https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8a6eba81f8e56b64258704364fe5abf 2x, https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c8a962977bc337c8d3f98aabc0a8582 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=296fdb59d4455b4368aefe9828ae67c1", "srcset": "https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=296fdb59d4455b4368aefe9828ae67c1, https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b750a79a85d6f784742c20ef6d936e7 2x, https://si.imgix.net/98a8469f/uploads/origins/90c9ce6c-5e07-488e-8722-879ef3d8527a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6dd80d2f36b414df5a0403745d6c3ce 3x"}, "body": "お疲れ様です！いつも素敵な作品拝見させていただいております。オ〜オさんの艶のある色塗りや鮮やかな色遣いが大好きです。\n\n今回ご依頼したいのは『Kの独白』というシナリオを通過した探索者2人です。\n\n▼設定\nKPC：青髪\n174cm/21歳/男\n黒髪を慕っている\n優しく大人っぽいが感情表現が豊かでふとした瞬間幼さが垣間見える子\n\nPC：黒髪\n173cm/26歳/男/花屋\n青髪の事を歳上として可愛がっている優しい子\n花粉症で年中マスクをつけている\n立ち絵ごとにブレがあるのですが目の下と口下に黒子があります\n\n現在同居しています。\n2人とも料理が出来、基本穏やかな空気感です。\n\n▼リクエスト内容\n雰囲気や構図はオ〜オさんの描きやすい様に描いていただいても構いませんが可能であれば、2人の食事風景、もしくは料理風景(チキン南蛮)をお願いしたいです。\n\n使用用途は個人利用程度にSNSのアイコンやヘッダー、スマホの待ち受け、グッズ制作などに使わせていただければと思います。\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/12arhjUNBDu2GisT7rbLTdMOuulMWi6aN", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ooo_z30/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3045250, "client_id": 1842844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34a15b5624d6b24a8c6868a424d98b7f", "srcset": "https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34a15b5624d6b24a8c6868a424d98b7f, https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02cd80be79971d3997aaaf3ad7627d42 2x, https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84d79f6fb48708f006da018c9e203692 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2d2d70731a275f1add1da6208928359", "srcset": "https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2d2d70731a275f1add1da6208928359, https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82d9646405e4d8e8467126b75fac295e 2x, https://si.imgix.net/9945595d/uploads/origins/0c38fd7d-a77f-4b20-ae24-96ed852bd404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01bbf5ca79e1620ea935c780814df517 3x"}, "body": "オ~オ様\n\n\nいつも素敵な作品を拝見しております。\nあなたの描かれるイラストの、細部までの丁寧な書き込みや、ハイセンスな色遣いなどが好きです。一目見ただけで惹き込まれるような魅力溢れるあなたの絵を尊敬しています。\n\n今回お願いしたいのは、「冥析夢」NPCの臼井千聖さんと、シナリオへ行かせていただいた探索者の二人です。\n昨年遊ばせていただいたのですが、とてつもなく自分の心に残るセッションとなりました。遊ぶことが出来て心から良かったと感じていて、大好きなシナリオの一つです。また、NPCである臼井千聖さんも魅力的で、思い入れの深いキャラクターになりました。素敵なシナリオをありがとうございます。\n\nぜひ、ほかでもないシナリオ作者であるオ~オ様に、臼井千聖さんと探索者を描いていただきたく依頼させて頂きました。\n\n\nキャラクターデザインの詳細は添付したURLにありますので、お手数ですがご覧いただけると幸いです。\n\n\n\n以下キャラクター詳細になります。\n\n▼探索者\n身長168cm。15歳。\n何もしていないと基本的には無表情だが、喋ると途端に表情がよく動くようになる。口角が上がっている事が多い。明るく元気で、自信に満ちた性格。年上に対しても敬語を使わず、パーソナルスペースがすこし狭め。\nスイーツ作りを趣味にしているが手先が不器用。傍目からしたら失敗作の自作スイーツを常に持ち歩いていて、友人などに得意げに渡すことが多々ある。\n\n\n\n二人は、休日やイベントごとがある日などに臼井千聖さんの自宅に押し掛けたり、学校終わりに勤務先の病院へと遊びに行ったり、かなり頻繁に会うような仲です。しかし、仲が良いといったようなことではなく、探索者から臼井千聖さんへの距離感が一方的に近いような具合です。探索者本人の自覚は薄いのですが、しつこいくらいに彼に構いにいくような世話焼きです。\n\n臼井千聖さんの自宅にいる二人の絵だと嬉しいですが、もちろん全く違っていても構いません。雰囲気、構図等はお任せ致しますので、好きに描いていただけたらと思います。\n\n\n\n\n最後までお読み下さりありがとうございます。ご検討いただけますと幸いです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-29kXKTOYPgzwbDo7QBwgT3hjWBgyUz7", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ooo_z30/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3045250, "client_id": 2501311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83fbcb74/uploads/origins/5a3e9a6e-61ef-4a2e-9592-24dafa6a8c40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to