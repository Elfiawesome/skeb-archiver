の作品が大好きです！私のキャラクター、ベロダッチを描いてほしいです。彼はバルダーズゲート3に登場する「暗い衝動」のキャラクターです。好きな位置や服装で描くことができますが、彼はたいてい中立的な表情をしています。額と目のマークはタトゥーなので、忘れずに入れてください。彼が黒人であることを念頭に置いて、彼の特徴を適切に描いてください。ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1h10ARsoY3aa3Bf9X7Sqgk1hhuuGUQVc-?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nuts_pud/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3705485, "client_id": 3534263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/979ddcb2/uploads/origins/25dc87a9-667c-41ab-bde6-47f0e7a9c108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fdc390be88b1adb11391894d0b618a7", "srcset": "https://si.imgix.net/979ddcb2/uploads/origins/25dc87a9-667c-41ab-bde6-47f0e7a9c108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fdc390be88b1adb11391894d0b618a7, https://si.imgix.net/979ddcb2/uploads/origins/25dc87a9-667c-41ab-bde6-47f0e7a9c108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7bd250ad29156aea6d84f94bd65c590 2x, https://si.imgix.net/979ddcb2/uploads/origins/25dc87a9-667c-41ab-bde6-47f0e7a9c108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f4ee8f6559fb538052d277b7cc2e5d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/979ddcb2/uploads/origins/25dc87a9-667c-41ab-bde6-47f0e7a9c108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec5387dc762de055dfc5429dff0ebaf6", "srcset": "https://si.imgix.net/979ddcb2/uploads/origins/25dc87a9-667c-41ab-bde6-47f0e7a9c108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec5387dc762de055dfc5429dff0ebaf6, https://si.imgix.net/979ddcb2/uploads/origins/25dc87a9-667c-41ab-bde6-47f0e7a9c108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&