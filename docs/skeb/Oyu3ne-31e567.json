op=top&w=200&h=200&blur=200&s=8cc03c1a5c84c7aea33f4e8d4b0033b1, https://si.imgix.net/7b4eac1c/uploads/origins/25911a7f-7e28-4455-b4cb-0fae0d1e8a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac3cb137422a56a8fd1c1ca8e6b71972 2x, https://si.imgix.net/7b4eac1c/uploads/origins/25911a7f-7e28-4455-b4cb-0fae0d1e8a0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84e0208fb0d060da84d6eb6138187dfc 3x"}, "body": "Nₑₘₒ様、初めまして!\nあなたの作品はとても美しく、物語性があって、一目で恋をしてしまいました。リクエスト失礼いたします…！\nこれは私のオリジナルキャラクター「离帆」です\n資料 URL に画像を添付したので参考にして下さい。\n年齢・身長：19～21歳、171cm\n· 基本設定： 非常に聡明で、華奢かつ病弱な青年。心臓病を患っている、病院で常時療養生活中。\n· 身分・特技： ゲーム実況者。学業成績もゲームの腕前も超一流ですが、ゲームスタイルは「千を討ち、八百を失う」ような、自らにもリスクを厭わない攻撃型です。\n· 外見：\n  · 黒褐色の肩まで届く長さの髪で、かろうじて結べる程度。結ぶ（ポニーテールなど）か、そのままのロングヘアかは、様のご判断にお任せします。\n  · 血のように赤い瞳\n  ·  特徴： 左目に涙ぼくろがあり、鋭い美貌で、少し女性的な印象を受ける\n· 性格：表面上は優しい隣のお兄さん風だが、実際は腹黒く毒舌な「笑面虎」。非常に神秘的な雰囲気を持ち、まるで風が吹けば消えてしまいそうな儚さがあります。\n· 服装： グレーの半袖シャツに、青と白のパッチワークジャケットをだらりと羽織り、片方の肩が常に露わになっているスタイル。\n靴は少しヒールのある、赤いソールのモンクストラップシューズです。\n· 嗜好・習慣：\n· 暑さに弱い。\n·  甘い物と激辛料理が大好き（医師の指示には全く従わない）\n· 公園でジグソーパズルをするのが好き。\n象徴アイテム：\n· 紙の舟\n· ルビー\n· 縷紅草\n· 薬剤（錠剤・カプセル）と点滴チューブなどの医療器具\n· チェスの駒（特に「クイーン」か「ナイト」）\nその他：\n· 少年時代に交通事故で亡くした男性の恋人（幼馴染）がいる。\n· その恋人との関係では、受け側であり、相手の前では意外にも柔らかく、わがままになり、甘えん坊になる一面があった。\n可能であればすべてお任せでお願いしたく思います。\n長文をここまで読んで頂き、ありがとうございました。\n何卒ご検討いただければと思います!\n\nhttps://drive.google.com/drive/folders/1ZTolazmdWUv63FndOr1XcBPxMvImTsif?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Oyu3ne/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8ff1aa0e/uploads/origins/0c71c090-af2d-4292-a69f-05bdc6ace05c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa5e633aa1f6e6c3fd10e1fd373fd541", "srcset": "https://si.imgix.net/8ff1aa0e/uploads/origins/0c71c090-af2d-4292-a69f-05bdc6ace05c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa5e633aa1f6e6c3fd10e1fd373fd541, https://si.imgix.net/8ff1aa0e/uploads/origins/0c71c090-af2d-4292-a69f-05bdc6ace05c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72ecb6f45a8976e47f90f7c8401af544 2x, https://si.imgix.net/8ff1aa0e/uploads/origins/0c71c090-af2d-4292-a69f-05bdc6ace05c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=552c6780c37151ef221963d329398bb3 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3718301, "client_id": 3676706, "nc": 0}, {"path": "/@Oyu3ne/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3718301, "client_id": 2500434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d85fd44ee6359ef78125bed200550261", "srcset": "https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d85fd44ee6359ef78125bed200550261, https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c5e95bea53c5c13124283e8fe554f87 2x, https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d98f9942c788d7deaf17069eb2d0f3f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a1b35d1ade17e36d73b9348f630cef", "srcset": "https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7a1b35d1ade17e36d73b9348f630cef, https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2103756dc43616d1e5cc45d533b8c3e6 2x, https://si.imgix.net/d88c4c0e/uploads/origins/803476d3-cd7a-4613-9b24-1f118ae136cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0f7488274ec394402d88bd2bc7ef75 3x"}, "body": "Nemo様 、初めまして。\n個人Vtuberの十月ルーマと申します。  \n以前Nemo様のイラストをお見かけした際、宝石のようにキラキラとして鮮やかで透明感のある素敵な絵柄にとても惹かれ、募集を開始された際には是非リクエストを送らせていただきたいと思っておりました。\n\n早速イラスト内容についてなのですが、 \n使用用途：YouTubeのサムネイルや動画(配信)内での使用・SNSの投稿画像・ネットプリント・グッズ販売(現在は未定ですが、本当に素敵なイラストなので もし可能でしたらいつか何か形として残させていただきたいと思いまして……失礼なことを申しておりましたら申し訳ございません……。) \n使用させていただく際は 概要欄などにNemo様のお名前やIDを記載し、Xでの画像投稿の際にはウォーターマークやノイズを加える等の対策をさせていただく予定です。  \n\nサムネイルなどに使用させて頂きたいので、 髪や腕・衣装などの描画部分が見切れないキャンバスサイズで、 背景を透過した人物のみの画像もいただけますと幸いです。  \nポーズや構図についてはお任せいたしますが、 特にこちらのポストにてまとめられているイラストの雰囲気や色使いがとても好きなので、もしよければ近い雰囲気で描いていただけますと とても嬉しいです。 \nhttps://x.com/oyu3ne/status/1963207725523120292?s=61&t=Poj-bubdQKqNptfRNB7UUw\n\n〈見た目の特徴について〉\n性別不詳・中性的 (外見としては“中性”のつもりで描いていただきたいです)\n髪：黒髪に近い濃い灰色で、反射で紫の光が入る(カラスの羽のようなイメージ)\n目：薄い灰色でフチが紫、影の部分は緑がかって見える\n下がり眉・泣きぼくろ・黒ネイル・逆ハートのピアス・ネックレス\nモチーフ：逆さまの紫ハート・愛・毒\nイメージカラー：毒々しい紫\n\n以下は自己紹介になりますが、ポーズや構図などの参考になりましたら幸いです。\n\n\n妄想が趣味の一般人Vtuberです。\n薄暗い部屋に引き篭もりがちで、心の中の大切な誰か(“同居人くん”)と一緒に暮らす妄想に浸りながら生活しています。(ユニコーンのような生物も妄想上の存在です)\nあまり自信が無く、緊張したり照れたりすることが多めです。\n普段は抑え気味に 穏やかな言動を心がけていますが、多少のヤンデレ要素を含んでいます。\n\nお忙しい中恐れ入りますが、ご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1T_e-qVb92WBrVjDzcXst0zSZs8jV3J9G", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Oyu3ne/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3718301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9697983f228fcd812184249b25cef0fd", "srcset": "https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9697983f228fcd812184249b25cef0fd, https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05f22055ec82b739f194db814a56f9ce 2x, https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ad3ab60d28ecdd3a9d809791d0b605e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c37cf45df5065725c9dedc78233d4bd9", "srcset": "https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c37cf45df5065725c9dedc78233d4bd9, https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=621db14cccd3b45a011fb6d30559e66e 2x, https://si.imgix.net/2d710816/uploads/origins/3e1286f4-244c-45f3-babf-236115fbe9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2234decb755c929e6a28afb908e8c27 3