rigins/4532a8a7-d91e-4e5a-96d0-3a87d1c5f7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b817d362bac2e3ae161f71d41aacd883 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8f5018e/uploads/origins/4532a8a7-d91e-4e5a-96d0-3a87d1c5f7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09959f16428e5a028e6b5427a2203b15", "srcset": "https://si.imgix.net/c8f5018e/uploads/origins/4532a8a7-d91e-4e5a-96d0-3a87d1c5f7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09959f16428e5a028e6b5427a2203b15, https://si.imgix.net/c8f5018e/uploads/origins/4532a8a7-d91e-4e5a-96d0-3a87d1c5f7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b97d053d6f2adbb329294252cab7c6f 2x, https://si.imgix.net/c8f5018e/uploads/origins/4532a8a7-d91e-4e5a-96d0-3a87d1c5f7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38fe9331f4b2d18c2291dfa649130b3f 3x"}, "body": "邪魔してしまい申し訳ございませんが、先生のスタイルはとても気に入りますので、私のオリジナルキャラクターをリクエストしたい。\n\n三つ編みのオリキャラを描いてください。\n\n最近ラサに旅行に行ったそうです。 40人で「人狼」のゲームがあった。 善人も悪人もみんな逃げてほしいって。 この間、彼は策士として行動し、多くの友人を作り、人間の本質を学んだ。\n彼自身、パートナーをグレーゾーンの第三者へと導いた。 彼はパートナーに他人を殺すよう指示した。 殺すことをやめるために殺す。 すべてのプレーヤーは彼の手先であり、彼は平和を達成するために力を使う。 しかし、彼の心が正しい位置にないために誤算を犯し、自分が殺されてしまうこともある。 操り手であり駒になりうる連中は文字通り「悪人」であり、操り手である彼ら自身はその命を無に等しく扱い、自らの目的のために利用することさえできる。 結局、彼は全員を脱出させることに成功した。\n\nリクエストを読む ありがとうございました！\n\n【キャラクター設定画】\ndrive.google.com/drive/folders/1-q1WxHOzQHGu50W2DiaK6uFHVXtHlEcw?usp=sharing", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haru_80110/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3467802, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=058e72612dfeb60c81e5272e7e2d8522", "srcset": "https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=058e72612dfeb60c81e5272e7e2d8522, https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3b4e2b3a4f9ad86afdb6b4e49cd0458 2x, https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3ba286912f6355655cc105ac51eae49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cfcd2d7c8b6ffccd0081c042f2e5d78", "srcset": "https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cfcd2d7c8b6ffccd0081c042f2e5d78, https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d32498398325b4b6c9ef5b317ac3d968 2x, https://si.imgix.net/98cfcf94/uploads/origins/cf471cce-f3da-436c-bf39-7400c482b2ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab5b0389158000ff1a04c6618f383f3f 3x"}, "body": "はじめまして。\nこの二人のオリジナルキャラクターの漫画を描いていただけませんか？\nセリフは全部日本語でも構いません。\n\nお城やドラゴンなどが出てくる中世ヨーロッパのファンタジーホラーの世界です。OCは対立する2つの国の出身。嫌々ながらも協力せざるを得ない。彼らは邪悪なモンスターを召喚するカルト教団を倒すために長い旅をしている。\n\nルフィナ\n魔道士で昆虫学者。最強の魔術師として名高い貴族。性格はぶっきらぼう、真面目、高慢、いじわる、傲慢。人と接するよりも家で虫の研究をしていたい、変わり者のオタクおてんば娘。ルフィーナはロハナのことが好きだが、ツンデレタイプの侮辱で気持ちを隠している。\n相手の呼び方「ローハナ\n\nローハナ\n砂漠の国の伝説の戦士。ストイックな戦士のような外見とは裏腹に、礼儀正しく、エレガントで、内気で、威厳があり、責任感が強く、優しい。祖国を侵略から守るストレスから、髪の色が変色している。密かにレズビアンであり、ルフィーナに恋心を抱いている。\n相手の呼び方「お嬢様\n\nシナリオ\nルフィーナはモンスターとの戦いで足首を負傷した。ロハナはルフィーナを担ごうとするが、ルフィーナはプライドから断る。ルフィーナは自力で歩こうとするが、花嫁のようにロハナに抱き上げられ運ばれる。\nルフィーナは、ロハナは女性というより王子様のようだと言い、ロハナは結婚していないのだから、夫ではなく妻を探すべきだと提案する。\nロハナは内心、恥ずかしさと悲しさを感じる。しかしロハナは、それならルフィーナと結婚すればいいと冗談を言う。ルフィーナはその失礼な性格では夫を見つけるのは難しいだろうから。\n\n使用用途：SNS、OC活動、個人的な閲覧のみを目的とした画像の印刷の可能性。\nもし間違っているところがあれば、遠慮なく再アピールしてください。\nいずれにせよ、このリクエストをお読みいただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1rj2oV_oAy5QUnQwTa3a31umlOiZBbTEu?usp=drive_link", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haru_80110/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3467802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee07b99e43c2d0645e658abf39bd837", "srcset": "https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ee07b99e43c2d0645e658abf39bd837, https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6dd9e281d64236b927f7d98e3280af8 2x, https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58de8cbe5799df90d76170b27fbafbc6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cbd7cbf5c921c7f9d5058aec7056659", "srcset": "https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cbd7cbf5c921c7f9d5058aec7056659, https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1eea9cbf142c68485ee27d56957d4c0 2x, https://si.imgix.net/5a74db75/uploads/origins/16aabb11-2765-4a0b-893e-9620ee14e555?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44e5d5087302bd17ef002ca6f0b78248 3x"}, "body": "Nice to meet you 壱青ハルヒト-san, I like your art so much that I would like to submit a personal request to you for my original character.  \nあなたが描いたキャラクターはとても生命力があって好きです！\nもしセリフがある場合は日/本/語でお願いします。\n\nLink: https://sta.sh/212egacz4b2j \nあなたに彼らの【HPパロ】を描いてほしい。\n大体のストーリー：\nいつまでも歳をとらない少女と、時間とともに成長していく少年がテーマです。(「不老の魔女とその養子」みたいな感じです)\n参考のあらすじ：紫苑が成長するにつれて、身長は南を超えていき、彼も南を囲む言い訳をすることが少なくなり、彼の周りには友人が増え、忙しくなることも増えてきたが、南は終始そのさまよう夜の幽霊で、離れなくても行く場所がなかった。ついにある日、紫苑は自分を探しに来なくなり、南も廊下の端にある油絵に戻った。\n紫苑は卒業後、魔法部の仕事と生活の間で忙しく、学生時代のようにやりたい放題ではいられないほど疲れていた。ある日母校に招待されて同窓会に参加したが、意気地なしに一人でパーティーから抜け出し、いつしか南の油絵の前に出てきた。彼は相手を呼んだが、返事がなかった。しばらく彼は南がいなくなったと思って少し慌てていた。しかししばらくすると、背後から名前を呼ばれ、慌てた様子をからかった人がいた。紫苑は振り返って、南を見て、まだ変わらない姿で、彼は昔に戻ったようだった。\n\n（参考はあくまで参考です、あなたのキャラクターを自分なりに解釈すればいいのです!）\n服装、髪型などはご自由に。\nどうぞご自由にお願いします。💗  \n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。 \n私の依頼を考慮していただき、ありがとうございました！ \nHave a nice day!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haru_80110/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3467802, "client_id": 2023509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e86e5859d4b8e385c12fafe4241df40", "srcset": "https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e86e5859d4b8e385c12fafe4241df40, https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9a01c5402e4682883e5f3be9862f50d 2x, https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f74a626821ebdbfefb2de997bf45342 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ecc446e5242c02fb8d35284f100eb8", "srcset": "https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ecc446e5242c02fb8d35284f100eb8, https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=983ac9c2ca17d00724297223cbc872ad 2x, https://si.imgix.net/2e2f214d/uploads/origins/79e76361-8a79-4f2e-a4dc-01a9f4e42bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e72753e8aea6cceb808ac9accba773fd 3x"}, "body": "こんにちは、初めまして！\n\nお邪魔してすみませんが、あなたが描いた作品がとても好きです。\n\nよろしければ、私のキャラクターに漫画を描いていただきたいです！人物設定の写真：\n\nHttps://drive.google.com/drive/folders/13v4Cn3kAkguLBquyNn8cK78tQqkXPMD4\n\n彼らの女性版を描いてください！私はあなたが描いた女性が大好きです...💕\n\n茶色の髪の男は【浅井 歩】で、身長は192cmで、職業は刑事隊長で、体に筋肉が多く、胸も大きいです。彼は嫌がらせを受けた側です。\n\n白い髪のキャラクターは【北古賀 氷原】で、彼の身分は八尺様で、超自然的な奇妙な感じがあり、男女の区別がつきません。顔の形は青年/少女で描くことができます。体型は骨格が女性ほど小さくないように見えますが、胸があり、相手を弄ぶことにとても興味があります。\n\n設定に関しては、最初は、茶色の髪の男が突然自分が尾行されているような気がして、とても不安で、その後、路地で八尺に襲われた。彼は八尺の存在を怖がっている。なぜなら、普段、八尺も彼について移動するからだ（そして他の人は八尺に気づかない）\n\n時々、八尺は恐ろしい表情で彼を見つめる（監視）が、多くの場合、八尺は優しい笑顔の表情で、これは茶色の髪の男を困惑させ、八尺様は実際に彼を傷つけていないからだ\n\n八尺の感情は純粋で重いです。単純に相手に興味を持ったり、相手に執着したり、ただ相手をおもちゃのように扱ったりしても問題ありません！\n\nだから、どんよりでも（？）のスタイル、あるいは日常の少しのスタイルは問題ない！\n\n彼らの関係を自由に説明して描いてください。他に考えがあれば、自由に描いても構いません（*^3^）\n\n金額が足りない場合は、適切に再送信してください。問題ありません。ご検討ください。受け入れていただければ、とても嬉しいです！！よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 534452, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ITARU@原稿中", "screen_name": "kidomh63", "avatar_url": "https://pbs.twimg.com/profile_images/1917088373124304897/XUltXpeV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1045257874358685697/1768205245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 17, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 32}, {"id": 924112, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めらとん", "screen_name": "melaton_tw", "avatar_url": "https://pbs.twimg.com/profile_images/1348912104602959874/Mu5reue5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1093100414025687041/1603272154/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 32}, {"id": 2693265, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "nzzzn/いまは不在！", "screen_name": "zunzunMozun", "avatar_url": "https://pbs.twimg.com/profile_images/1880335089802088448/5JeR4ZGr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1611180608570658817/1726593574/1500x500", "appeal_receivable": fa