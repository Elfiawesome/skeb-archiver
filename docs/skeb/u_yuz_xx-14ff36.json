ss&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2c391c2447553eb4262eda2a06e1b48, https://si.imgix.net/9cfff08e/uploads/origins/40a15105-c813-488b-9cbc-af09c95d1c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fade7cefe35f886bf60aa57d5ac7a70 2x, https://si.imgix.net/9cfff08e/uploads/origins/40a15105-c813-488b-9cbc-af09c95d1c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7892056fee4771f5db2d1014f20239f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9cfff08e/uploads/origins/40a15105-c813-488b-9cbc-af09c95d1c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf1c76a02ecbafd0b26fb05e5cc21f9", "srcset": "https://si.imgix.net/9cfff08e/uploads/origins/40a15105-c813-488b-9cbc-af09c95d1c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf1c76a02ecbafd0b26fb05e5cc21f9, https://si.imgix.net/9cfff08e/uploads/origins/40a15105-c813-488b-9cbc-af09c95d1c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=947955639b121ac59f0d55b76b477aba 2x, https://si.imgix.net/9cfff08e/uploads/origins/40a15105-c813-488b-9cbc-af09c95d1c6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7588420a03511d0e216e09b45cd41b73 3x"}, "body": "はじめまして。 \nあまり様のイラストの絵柄がとても好きです。\nよろしければうちの子のイラストを描いて頂けると嬉しいです！\n\n◆使用用途\ntwitter等SNSでの使用\n\n◆三面図・キャラ参考資料\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20  \n\n ◆構図・シチュエーション等\nこちらのイラストの絵柄や雰囲気、姿勢などがとても好きです。\nhttps://skeb.jp/@u_yuz_xx/works/8\nこんな構図、雰囲気で、ソファに座るうちの子を描いて頂けると嬉しいです。\n\n◆ソファ\nこんなデザインの大きめなソファが希望です。\nhttps://kamada-japan.com/wegner-beachair/\n（あくまでイメージですので、デザインはアレンジ頂いて構いません）\n\n ◆服装 \n制服で、夏らしくシャツは半袖、足は素足でお願いします。\n手や足の描写が好きなので、手や足がよく見えるようなポージングですと嬉しいです。\nまた、足の指先（特に足爪）の描写が好きなので、両足のほぼ全ての足爪が見えるように描いて頂きたいです（爪は自然な色味で）。\n\n ◆納品\n PSDとPNG形式でお願いします。\n\n上記はあくまでもイメージですので、ご自由にアレンジ頂いて大丈夫です。\nよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_yuz_xx/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3016, "client_id": 2136478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6adc87a39fba91924078b3ff321f817", "srcset": "https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6adc87a39fba91924078b3ff321f817, https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c019353fd45426c0066586c00ee011eb 2x, https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fea6605bef374c8956c7fff2e68c222 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d93e0fc62ad7b42671528014310caa5b", "srcset": "https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d93e0fc62ad7b42671528014310caa5b, https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ece1b62bae6be389594f72b48b1368f 2x, https://si.imgix.net/6165cccb/uploads/origins/52812279-e366-4589-8242-d08583d05c7c?bg=%23fff&auto=