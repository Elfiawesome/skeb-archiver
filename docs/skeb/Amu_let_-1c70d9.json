e_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 851255, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4eeb6121b2e52eb7374450675a20666", "srcset": "https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4eeb6121b2e52eb7374450675a20666, https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36017412b7eff996cd006389b9f3b28d 2x, https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef30908f3fc7a4fc66acfbf0a642f0eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e69bfb2df5ed76b83bd334a8116aef", "srcset": "https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e69bfb2df5ed76b83bd334a8116aef, https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=820fa2590288c970a70fb74b2e5272e9 2x, https://si.imgix.net/dd286467/uploads/origins/52b3fe20-1e51-41d3-985d-7f0845d4df21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=87d1828d7b3592f7e8071535ba83ee16 3x"}, "body": "你好，我非常喜欢你的艺术风格!我想请你为我的两个原创人物画一幅插图。\n\n🌿 [A] 韩沐阳\n身高181厘米，站立。棕色头发，从前面看是短发，在后面扎成一个齐腰的马尾辫。右眼为紫色，左眼为虹彩蓝色。有像蛇一样的狭长瞳孔和锋利的犬齿。性格开朗，和蔼可亲。是一位植物研究者。他的下半身是蛇的。右耳上有白色的羽毛耳环。\n\n🔥 [B] 莫子煜\n身高186厘米。比A小2岁。白色长发。火焰色的眼睛。一个安静但紧张的人。美丽而英俊。一个中国戏曲表演者。肌肉匀称。有像秘书鸟的翅膀。他对A有保护性的感情。红眼和唇妆，左耳有黑色流苏耳环。\n\nA和B是童年的朋友和恋人。他们一起在一个古老的中国幻境中旅行。\n\n谢谢你如果要求不合适，请随时拒绝。\n\nhttps://drive.google.com/drive/folders/13oER8K621h27id0z6EH24UJLttvkPe4w", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Amu_let_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 851255, "client_id": 2156678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ab38326/uploads/origins/cb431ab3-f835-4308-9bbd-99a50e7ab99f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31f867d1a04a134e6734ec159eb992c5", "srcset": "https://si.imgix.net/4ab38326/uploads/origins/cb431ab3-f835-4308-9bbd-99a50e7ab99f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31f867d1a04a134e6734ec159eb992c5, https://si.imgix.net/4ab38326/uploads/origins/cb431ab3-f835-4308-9bbd-99a50e7ab99f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a17d8d2809a7c56e4d218f8d45ef4a63 2x, https://si.imgix.net/4ab38326/uploads/origins/cb431ab3-f835-4308-9bbd-99a50e7ab99f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56eed474984452e0c0b5c071e58172b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ab38326/uploads/origins/cb431ab3-f835-4308-9bbd-99a50e7ab99f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2d03527c507378b1f941b7cb6280ae", "srcset": "https://si.imgix.net/4ab38326/uploads/origins/cb431ab3-f835-4308-9bbd-99a50e7ab99f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2d03527c507378b1f941b7cb6280ae, https://si.imgix.net/4ab38326/uploads/origins/cb431ab3-f835-4308-9bbd-99a50e7ab99f?bg=%23fff&auto=fo