4eb2-8c7c-c7e32ecfa08c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53975a458e0981d7b2cad5af6b467330 2x, https://si.imgix.net/066d8fc6/uploads/origins/fffcad1c-57f4-4eb2-8c7c-c7e32ecfa08c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dbef0d12b6dbc0198b46c4003eaefc1 3x"}, "body": "您能为我画两个忍者男孩角色--雾和乌鸦吗？参考资料附在下面。\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link\n橙色的那个叫 \"雾\"（17 岁），性格相对沉稳，少言寡语；而蓝色的那个叫 \"乌鸦\"（16 岁），性格外向，有点淘气。它们从小就是战斗伙伴。\n您可以随意画出他们之间的任何姿势和互动！一切完全由您决定。您可以画他们的战斗姿势，也可以画他们在某个舒适的地方休息和拥抱。我希望看到你笔下的男孩们！\n请慢慢享受，非常感谢你的考虑！\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Amu_let_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 851255, "client_id": 2328269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bc58b70/uploads/origins/843c0933-c0cf-4b99-9b7a-84dd928cfe57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70e32732df865168cc52bc0aa07a3be9", "srcset": "https://si.imgix.net/9bc58b70/uploads/origins/843c0933-c0cf-4b99-9b7a-84dd928cfe57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70e32732df865168cc52bc0aa07a3be9, https://si.imgix.net/9bc58b70/uploads/origins/843c0933-c0cf-4b99-9b7a-84dd928cfe57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=097d87ac3f3f65d5686cefdfc4c1b226 2x, https://si.imgix.net/9bc58b70/uploads/origins/843c0933-c0cf-4b99-9b7a-84dd928cfe57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2064ec5e5ea5978402aa763ed58dc2e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bc58b70/uploads/origins/843c0933-c0cf-4b9