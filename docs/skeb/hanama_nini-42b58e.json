imemo/status/1726919262747660562?t=UKQDPQRNhXhgZVfhpBFakg&s=19\n\nゲームの性質上タイヤがついていますがそれも描かないで頂きたいです。\n\n衣装はウェディングドレスで、背景はオーシャンビューのチャペルでお願い致します。手にはブーケを持ってこちらを至福の笑み(あるいは嬉し泣きのような)で見ている感じで。\n\n背景イメージ\nhttps://www.e-bridal.tv/special/diamond_ocean_kuchikomi\n\n背景は大まかに、人物フォーカスでお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hanama_nini/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3207602, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd44441e/uploads/origins/2ed9ad8e-41bb-43c2-bb94-f4384acb7102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0731a023e3f06c01abaa8b220647d8d", "srcset": "https://si.imgix.net/cd44441e/uploads/origins/2ed9ad8e-41bb-43c2-bb94-f4384acb7102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0731a023e3f06c01abaa8b220647d8d, https://si.imgix.net/cd44441e/uploads/origins/2ed9ad8e-41bb-43c2-bb94-f4384acb7102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0796bb77ab061f22229c41217b1b2f5d 2x, https://si.imgix.net/cd44441e/uploads/origins/2ed9ad8e-41bb-43c2-bb94-f4384acb7102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79760416a5a5a99ce28826b2ac3da0c0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd44441e/uploads/origins/2ed9ad8e-41bb-43c2-bb94-f4384acb7102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5f94ba7d7cfcd4fc22e79ebe7a4ef7", "srcset": "https://si.imgix.net/cd44441e/uploads/origins/2ed9ad8e-41bb-43c2-bb94-f4384acb7102?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5f94ba7d7cfcd4fc22e79ebe7a4ef7, https://si.imgix.net/cd44441e/uploads/origins/2ed9ad8e-41bb-43c2-bb94-f4384acb7102?bg=%23fff&auto=format%2Ccompress