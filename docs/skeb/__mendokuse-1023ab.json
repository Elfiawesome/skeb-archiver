分がまだたくさんあるということが彼女を慰めてくれるからだ。\n\nもし望むなら、代わりに他の方法でクロイガーを描いてもいい！\n私は何でも嬉しいです！\n\nクロイガー少佐の主なデザイン参考資料や素材は、こちらのリンクからご覧いただけます：\nhttps://imgur.com/a/major-kreuger-WABrD0N\nまた、これ以外の参考資料や正確な納品物は、同梱のGoogle Driveにあります。\n\nご検討ありがとうございました！\n楽しんでいただければ幸いです！\n\nhttps://drive.google.com/drive/folders/1yAuzr6o83kWYBVqLW7Yfs8gSHX2xWa6H?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__mendokuse/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2736963, "client_id": 3113895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66db8b39/uploads/origins/3af33e57-0dc3-4bb8-a10f-98bb7ead5713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a5f3de65f4f03c690efe3731b2cda2d", "srcset": "https://si.imgix.net/66db8b39/uploads/origins/3af33e57-0dc3-4bb8-a10f-98bb7ead5713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a5f3de65f4f03c690efe3731b2cda2d, https://si.imgix.net/66db8b39/uploads/origins/3af33e57-0dc3-4bb8-a10f-98bb7ead5713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b47d7075eb1173477015f5bbe1f0b5b5 2x, https://si.imgix.net/66db8b39/uploads/origins/3af33e57-0dc3-4bb8-a10f-98bb7ead5713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00d0aa33b2a4eadfc5cb6f4869a4a354 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66db8b39/uploads/origins/3af33e57-0dc3-4bb8-a10f-98bb7ead5713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116f012b1fc8cad010cf8f57be5a3ab7", "srcset": "https://si.imgix.net/66db8b39/uploads/origins/3af33e57-0dc3-4bb8-a10f-98bb7ead5713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116f012b1fc8cad010cf8f57be5a3ab7, https://si.imgix.net/66db8b39/uploads/origins/3af33e57-0dc3-4bb