9e6a438565292635bfdb04d24bbf 2x, https://si.imgix.net/f15e8692/uploads/origins/0107b5cc-d1e9-4044-8633-dd3f3ef46b3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ef3cac9f576e919d9f2a36119d93e339 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 272015, "client_id": 784322, "nc": 161}, {"path": "/@pok2015/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 272015, "client_id": 784322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd0e70c1025719fb8bb41e3cd2f3a5fc", "srcset": "https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd0e70c1025719fb8bb41e3cd2f3a5fc, https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6492adea759894be762cacb1595938a 2x, https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ad87f0b1dcc785fd2fa3a240604be72 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=912887342a8867f11f39e14b79df8b55", "srcset": "https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=912887342a8867f11f39e14b79df8b55, https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68b0649f4c99633c19163ef9bcb34508 2x, https://si.imgix.net/d0993ddc/uploads/origins/43f9a010-4122-4df7-981d-560491f6c442?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=365ce8489ab12904a3aa0be367af721b 3x"}, "body": "前回は、うちの子のＪＳ時代を可愛く描いていただきありがとうございました。納品していただいた作品を拝見しまして、うちの子の色んな年代をポッコレ様の絵柄で見てみたい！という気持ちが高まりまして、立て続けのリクエストとなってしまいますが、もしよろしければご検討いただけますと幸いです。\n\n【人物】\n前回と同じうちの子で年齢は少し成長してＪＳ高学年。衣装は旧型スクール水着。水泳キャップは外して肩紐に挟んでいているため、髪が以前より少し伸びていることが分かる。\n乳房が膨らみ始め、初潮を迎えたのと、性教育の授業で性的な知識を得たことで以前とは違い羞恥心が芽生えている。しかしそれはおっぱいやお股は男の人に見せてはいけないもの、見られたらなんとなく恥ずかしい～といった漠然としたもので、性行為、子供がどうやったらできるかを知ってはいても、それは大人になってからの話であり、また、世の中には本来の子作りを目的としない性行為や性癖が存在していること、まして自分の年代が性的な目で見られることがあるなど想像もしたことがない。\n\n【シチュ】\n学校のプールで体育の授業中、プールは盗撮ビデオ業者に盗撮されているが、女の子達はそんなことは露知らず無邪気に水泳の授業を楽しんでいる。\nそんな中、股間が痒くなったうちの子は周りに気が付かれないように水着の上から痒い所を掻こうとするが、旧型スクール水着の生地の厚さと伸縮性の無さから痒みは治まらず、やむを得ず片方の手で股布をつまんで持ち上げ、生地と肌の間に空間を作ってもう片方の手の指で痒い所を搔いているシーンをばっちり盗撮されてしまう。\n後に、盗撮動画は怪しい雑誌の通販ページまたは通販サイト等で発売されるが、商品説明には「Ｓ学生プール授業〇〇Ｓ学校■年▲組編」の目玉シーンとして、うちの子がそのビデオのクライマックス、象徴的なシーンとして紹介されていて、「ちょっとブサイクな女の子が自ら秘所を露わに…」といった説明が添えられている…といった構図のイラストを金額の許す範囲でお願いしたく思います。\n\nポッコレ様にうちの子をブサ可愛く描いていただけるだけで嬉しい限りですので、ポーズや構図、キャプションなど、指定にない所はお任せします。また、翻案や改変は大歓迎ですので、是非ともご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/19GdiNgiAUAsI5pGXR6eS1i-nM4hyimqz?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pok2015/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 272015, "client_id": 784322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=238b42354b4108754dca58ff10eda0a1", "srcset": "https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=238b42354b4108754dca58ff10eda0a1, https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63a7d76a6567c87db7c1fa36a5ae8061 2x, https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90ed40c1a0deee41c97c842a0ba34340 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=172ee49ca8307a00294da9f540843de9", "srcset": "https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=172ee49ca8307a00294da9f540843de9, https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a774a688ccc49bd14823ddafd25829d 2x, https://si.imgix.net/1c6eb677/uploads/origins/b8a6f596-af0e-4fcc-8022-2b6bc18d9eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16715153fd4b1fa325c14a4f746657b9 3x"}, "body": "いつもお世話になっております。\n先日は夏海のイラストを立て続けにお描きいただいてありがとうございました。キャラクターの解釈が実にしっくりとくる素晴らしい作品で納品していただいた後何度も見返しております。\n二次創作のみならずポッコレ様の描かれるオリジナルキャラクターの女の子達のちょっと芋い感じが非常にツボにはまりまして、とてもいいものだと感じております。イラストの他にも同人誌のストーリーやシチュエーション、エッチなんだけどエッチなだけでない内面の心の動きまで感じさせる展開が非常に性癖に突き刺さります。\n\nそんなわけで、今回は参考画像をもとにうちの子を描いていただけないでしょうか。参考画像はうちの子のJK時代設定のものなのですが、これを元にうちの子のJS時代を想像してお描きいただければと思います。\nJSといっても年代は幅広いですが、後に無意味に巨乳に育つちょいブサなうちの子でもまだまだぺったんこで、第二次性徴直前～タナー段階Ⅰ～Ⅱくらいの発育がこれからといった状態をお願いできればと思います。後年、自分のちょいブサの容姿を自覚して自信がないばかりに恋愛関係では奥手の引っ込み思案になりますがそれはまだ未来の話、精神的にはまだまだ子供で胸やパンツは異性に見られたら恥ずかしいものという漠然とした意識があるくらいで、それが異性の性欲や劣情を催すといったところまではまだ考えが至らない程度の性知識。\n外見は黒子と雀斑が多め、デコルテや肩回りにまで雀斑あり。運動神経はそれなりで、絵画教室に通っていて身体を動かすよりは絵を描くのが好き。\n\n衣装や下着は昭和を感じさせるような、現代の目で見たら洗練されていない芋い感じのものを着せていただけると嬉しいです。\nポーズや、NSFW、非NSFWの程度は特に指定はなく、今回の依頼がポッコレ様の描かれるJSうちの子を見たいという趣旨のものなので指定にない所はお任せします。ぜひうちの子をブサ可愛くお描きいただければと思います。\n\nお手数をおかけしますがご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1vy7bvSuzkD1rE8fJW3lxw2xeCrb4MPE_?usp=sharing", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pok2015/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cf2a3bf8/uploads/origins/64fcb1a6-5207-4660-abad-a820e0bfc615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebebd91f9ba9a57992652ff694380ce8", "srcset": "https://si.imgix.net/cf2a3bf8/uploads/origins/64fcb1a6-5207-4660-abad-a820e0bfc615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ebebd91f9ba9a57992652ff694380ce8, https://si.imgix.net/cf2a3bf8/uploads/origins/64fcb1a6-5207-4660-abad-a820e0bfc615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3183beac91e0c05eb0f3a9321d44e6e9 2x, https://si.imgix.net/cf2a3bf8/uploads/origins/64fcb1a6-5207-4660-abad-a820e0bfc615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21d28dbf1c5035903d8622c5fe27b12d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 272015, "client_id": 784322, "nc": 161}, {"path": "/@pok2015/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd8dbee3/uploads/origins/89abca26-4d87-4bac-9183-e2