=200&s=0fd6f5d7b84cea2bc21d31ffd43b1bd6 2x, https://si.imgix.net/80c9db4b/uploads/origins/d75c91b4-4631-41c3-b1ec-333ad1cec280?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71f7c06400ac869eb9ec7c7a5477c01b 3x"}, "body": "はじめまして！いつもhale先生のとても素敵で幻想的なイラストを拝見しております。\nこの度はうちの子を描いて頂きたくリクエストをお送りします。\n\nKampanella (カンパネラくん）\n- 魔法の図書館の世界で文学作品を「守る」魔法使いの弟子\n- モチーフ：「銀河鉄道の夜」から　カムパネルラ、車掌\n- 10代後半男子\n- 性格：優しい、少し天然、頑張り屋さん\n- 好きなもの：黄金のりんご、本\n- 杖をイラストのどこかに取り入れてください（片手で持つ、背景の一部など）\n- 衣装のデザインを少し変えても構いません\n\n金色のリンゴを持っている姿を描いて頂ければ嬉しいです！構図や表情などはお任せします。\n\n宛名は可能であれば別レイヤーでお願いします。また、お値段的に厳しいようでしたら拒否していただいても構いませんので、気軽にキャンセルしてください。\n\nご検討頂きありがとうございます！\n\nhttps://drive.google.com/drive/folders/1lYsKdcgCERN3IcFQpwQeNrloCzMQVAX_?usp=sharing\n\nhttps://drive.google.com/drive/folders/1lYsKdcgCERN3IcFQpwQeNrloCzMQVAX_?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tenkiame_hale/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": true, "creator_id": 973529, "client_id": 1150445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecd5bc12da978791961f11b526d65b5", "srcset": "https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecd5bc12da978791961f11b526d65b5, https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cd65ab40a4e5e5a8c24ee1bfa85791b 2x, https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42fa73a4fd6cdaf605393cfa05790816 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5044b1654d1a3fe3432b22cf32c7b029", "srcset": "https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5044b1654d1a3fe3432b22cf32c7b029, https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4d0b6dbad2d337e09d855629d63c4f8 2x, https://si.imgix.net/1fca773f/uploads/origins/cab77fab-a62c-45a7-896f-31e522fbd631?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6cba368e85e32e091949fd9b297faca 3x"}, "body": "先ほどは大変失礼しました🙇‍♀️\nよろしくお願いいたします！🙇‍♀️\n\n（↓念のため先ほどのリクエスト文章再掲します）\n\nはれさん\n\n初めまして。いつも素敵なイラスト拝見しています。\n\nSNSにイラストを投稿しても全く伸びず、活躍されているイラストレーターさん達のイラストと比べて魅力に欠けて目を引かないような気はしているのですが、具体的にどうしたら良いのか全く分からず、客観的なご意見を頂ければと思い今回リクエストさせて頂きました。\n\n自分で気になっている短所は人物が硬い点と、\n絵の構成にひねりがなく、ただ人物を配置しているだけになっている点かなと思っています。\n\n目指している方向性は美容やファッション系の案件で雑誌のカットや広告に起用されたいと思っています。\n\n率直な意見をお伺い出来れば嬉しいです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1TMoXBbdJp1sV7Kdl85dEvKefSoUevZJ-/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tenkiame_hale/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1ac4103e/uploads/origins/cded2b28-1ed1-48e9-b21b-8856fd932e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cfd94bc3c99de23b9b1ea942ea4e170c", "srcset": "https://si.imgix.net/1ac4103e/uploads/origins/cded2b28-1ed1-48e9-b21b-8856fd932e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold