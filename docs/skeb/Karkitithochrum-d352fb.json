06b\u6307\u5b9a\u306f\u3054\u3056\u3044\u307e\u305b\u3093\u3002\u304b\u306b\u304b\u306b\u3055\u3093\u306e\u7d75\u67c4\u3067\u81ea\u7531\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n-------------------\n\u540d\u524d\uff1a\u30a6\u30b5\u30ae\u72e9\n\n\u30a6\u30b5\u30ae\u306e\u5f62\u3092\u3057\u305f\u6bba\u4eba\u4eba\u5f62\u3002\u96c7\u308f\u308c\u6bba\u3057\u5c4b\u3002\n\u300c\u30a6\u30b5\u30ae\u72e9\u300d\u306f\u30b3\u30fc\u30c9\u30cd\u30fc\u30e0\u3002\n\n\u6c34\u8272\u306e\u90e8\u5206\u306f\u30b7\u30ea\u30b3\u30f3\u306e\u3088\u3046\u306a\u8cea\u611f\u3001\u305d\u306e\u4e0b\u306f\u6728\u88fd\u306e\u5080\u5121\u3067\u3001\n\u5168\u8eab\u306b\u6b66\u5668\u304c\u4ed5\u8fbc\u307e\u308c\u3066\u3044\u308b\u3089\u3057\u3044\u3002\n\u8868\u60c5\u306f\u52d5\u304b\u305a\u5168\u304f\u77ac\u304d\u3092\u3057\u306a\u3044\u3002\n\u30c9\u30fc\u30eb\u30a2\u30a4\u3067\u3001\u5e38\u306b\u76ee\u306f\u30ac\u30f3\u958b\u304d\u3002\u9ed2\u76ee\u306f\u52d5\u304f\u3089\u3057\u3044\u3002\n\n\u53ef\u611b\u3089\u3057\u3044\u3046\u3055\u304e\u306e\u898b\u305f\u76ee\u3092\u3057\u3066\u3044\u308b\u3002(by\u96c7\u3044\u4e3b\u306e\u793e\u9577\u30b3\u30fc\u30c7)\n\u672c\u4eba\u306f\u898b\u305f\u76ee\u306b\u95a2\u3057\u3066\u4f55\u3082\u611f\u3058\u3066\u3044\u306a\u3044\u304c\n\u76f8\u624b\u306e\u6cb9\u65ad\u3092\u8a98\u3048\u308b\u4e0a\u306b\u3001\u305d\u308c\u306a\u308a\u306b\u52d5\u304d\u3084\u3059\u3044\u306e\u3067\u4f7f\u3044\u7d9a\u3051\u3066\u3044\u308b\u3002\n\n\u8033\u306f\u6700\u9ad8\u306b\u3075\u306b\u3075\u306b\u3067\u3084\u308f\u3089\u304b\u3044\u305f\u3081\u89e6\u308a\u305f\u304f\u306a\u308b\u304c\u3001\n\u4f53\u3092\u89e6\u3063\u3066\u304f\u308b\u8005\u306e\u6307\u306b\u5bfe\u3057\u3066\u3082\u308c\u306a\u304f\u5203\u7269\u3092\u5207\u308a\u3064\u3051\u3066\u304f\u308b\u306e\u3067\u8981\u6ce8\u610f\u3002\n\n\u4e3b\u306a\u5f97\u7269\u306f\u4e07\u529b\u9396\u306e\u5148