4d\u307e\u3059.\n\n\u30ea\u30af\u30a8\u30b9\u30c8\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u4f5c\u54c1\u306f,\u524d\u56de\u306b\u7d9a\u304d,\n\u6d5c\u677e\u5148\u751f\u306e\u5fa1\u8457\u4f5c\u300c\u30e9\u30b9\u30c8\u30aa\u30fc\u30c0\u30fc \u3072\u3068\u308a\u307c\u3063\u3061\u306e\u767e\u5e74\u6226\u4e89\u300d\u306eSS\u3067\u3059.\n\u524d\u4f5c\u3067\u5927\u304d\u306a\u611f\u52d5\u3092\u3044\u305f\u3060\u304d,\u518d\u3073\u540c\u4f5c\u306e\u77e5\u3089\u308c\u3056\u308b\u4e16\u754c\u306b\u89e6\u308c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3063\u3066\u304a\u308a\u307e\u3059.\n\n\u5177\u4f53\u7684\u306a\u5185\u5bb9\u306f,\n\u540c\u4f5c\u306b\u767b\u5834\u3059\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u300c\u30b7\u30aa\u30f3\u300d\u3092\u4e2d\u5fc3\u306b\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059.\n\u300c\u30e9\u30b9\u30c8\u30aa\u30fc\u30c0\u30fc\u300d\u306e\u4e16\u754c\u3092\u511a\u304f\u3082\u7f8e\u3057\u304f\u3082\u5f69\u308b\u30d2\u30e5\u30fc\u30de\u30ed\u30a4\u30c9\u306e\u30e1\u30a4\u30c9\u3055\u3093,\u904e\u9177\u306a\u6226\u5834\u3067\u3082\u732e\u8eab\u7684\u3067\u611b\u60c5\u6df1\u3044\u5f7c\u5973\u306e\u77e5\u3089\u308c\u3056\u308b\u4e00\u5e55\u3092\u6d5c\u677e\u5148\u751f\u306e\u3054\u57f7\u7b46\u3067\u518d\u3073\u62dd\u898b\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059.\n\n\u304a\u624b\u6570\u3092\u304a\u304b\u3051\u3057\u307e\u3059\u304c,\u3069\u3046\u304b\u3054\u691c\u8a0e\u306e\u7a0b\u5b9c\u3057\u304f\u304a\u9858\u3044\u81f4\u3057\u307e\u3059.", "nc": 145, "word_count": 12662, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@hamamatsukasuga/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 2421538, "client_id": 2826623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bde6813e/uploads/origins/f5dd6eb4-83d4-4158-94dd-5451221d25cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro