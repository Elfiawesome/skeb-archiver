聞いたというのが設定です\n成り行きは聞いているものの、びしょぬれユリア（の胸元）をチラチラと見ていた指揮官にムムっとしたアニス\n後日指揮官の部屋にユリアの恰好を真似た状態で訪れ、ベッドでスマートデバイスをいじっていた指揮官の胸元に潜り込み「指揮官？こういう格好が好みだったのかしら？」と言わんばかりに誘惑的な仕草でイタズラをする・・・という場面です！\n（胸元のはだけ具合はユリア程度、乗られている指揮官も描写される場合は普通に服着せてもらえればと思います。でもアニスのワイシャツが不思議パワーでちょっと肌色透けててほしい…）\n～～↑↑ココまで長い設定↑↑～～\n\n要約すると、\n・仰向けの指揮官の胸～腹部あたりに乗っかっている\n・ユリアっぽい服装をしている\n・指揮官の気を引くために誘惑するような仕草や表情をしているアニス\nです\n\n指揮官の頭部やそのほか部位について重要ではないのでどういう描写でも構いません\nウルトラ適当に描いたイメージイラストがありますが実際の構図なども全部おまかせします\n\nよろしくお願いします\n\nhttps://gyazo.com/abb90f0f91590f50246884c9529681dc", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 65102, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "さこ", "screen_name": "sak_orz", "avatar_url": "https://pbs.twimg.com/profile_images/1563859995346837504/-hP-0w5W.jpg", "header_url": "https://pbs.twimg.com/profile_banners/786028672620691456/1775398906/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 176}, {"id": 853932, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しちがつ", "screen_name": "sitigatu0984", "avatar_url": "https://pbs.twimg.com/profile_images/1482669903630929924/aKquSAzM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/833203785509920768/1490535895/1500x500", "appeal_receivable": false, "popular_creator_rank": 95, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://pbs.twimg.com/profile_images/184481268322661990