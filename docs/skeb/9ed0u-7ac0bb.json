剣でお願いします。\n\n可能であればダメージ差分verもお願いしたく、通常の状態と、前回描いていただいた時と同じくらい鎧や服を破損させた差分を用意してほしいです。\n\nどうぞよろしくお願いいたします。\n\n精霊石の剣(メテオザッパーモード)\nhttps://i.imgur.com/S7zbuh7.jpg\nhttps://i.imgur.com/mbxkIBL.jpg\nhttps://i.imgur.com/dLBDplf.jpg\nhttps://i.imgur.com/0sAhduA.jpg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9ed0u/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 400843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c19dd8a/uploads/origins/f86e7ede-cf94-43d7-a302-f74978ddaa68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de4602c2c9b5b3df79e529803c94f7c5", "srcset": "https://si.imgix.net/3c19dd8a/uploads/origins/f86e7ede-cf94-43d7-a302-f74978ddaa68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de4602c2c9b5b3df79e529803c94f7c5, https://si.imgix.net/3c19dd8a/uploads/origins/f86e7ede-cf94-43d7-a302-f74978ddaa68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcf55a9811423ae932e1fb81a857313e 2x, https://si.imgix.net/3c19dd8a/uploads/origins/f86e7ede-cf94-43d7-a302-f74978ddaa68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3121a64ee2fa557f2e0c4c31c8d29359 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c19dd8a/uploads/origins/f86e7ede-cf94-43d7-a302-f74978ddaa68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7260307f6b85bd541885902618812082", "srcset": "https://si.imgix.net/3c19dd8a/uploads/origins/f86e7ede-cf94-43d7-a302-f74978ddaa68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7260307f6b85bd541885902618812082, https://si.imgix.net/3c19dd8a/uploads/origins/f86e7ede-cf94-43d7-a302-f74978ddaa68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200