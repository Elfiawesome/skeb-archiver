557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49de9b75de163f9b26330529c7bca959, https://si.imgix.net/e7e43498/uploads/origins/56700d60-e636-4fc3-9bde-f1b76d75f557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0926ea320b579113f9be8891f01826b7 2x, https://si.imgix.net/e7e43498/uploads/origins/56700d60-e636-4fc3-9bde-f1b76d75f557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dac7e6e5fd3315f5eb8006f97c12886 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7e43498/uploads/origins/56700d60-e636-4fc3-9bde-f1b76d75f557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5193c16e21686f0827d12dfeb387f68e", "srcset": "https://si.imgix.net/e7e43498/uploads/origins/56700d60-e636-4fc3-9bde-f1b76d75f557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5193c16e21686f0827d12dfeb387f68e, https://si.imgix.net/e7e43498/uploads/origins/56700d60-e636-4fc3-9bde-f1b76d75f557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc1ebe5ff24d05007547e22ff4885310 2x, https://si.imgix.net/e7e43498/uploads/origins/56700d60-e636-4fc3-9bde-f1b76d75f557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3f922d7d26b48bdc9447e09e7d25e09 3x"}, "body": "こんにちは！以前あなたが描いた絵が大好きでした。\n\n私のOCライラックを描いてもらえませんか？彼女はドラゴンの女性です。彼女には耳がありません。彼女の鱗と角は宝石のように輝いている。温厚だが、ちょっと頑固。肌の色に注目してください。\n\n好きな服を選んでください。花と一緒に描いてほしいです！\n\nhttps://drive.google.com/drive/folders/1m77id7uHKNAa4NAm9CQgnP152S778tOd?usp=sharing\n\nhttps://drive.google.com/drive/folders/1m77id7uHKNAa4NAm9CQgnP152S778tOd?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Kyuujitsu_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2109