ェラで串刺しにされたり、二穴されたり、自分からゴブリンに跨りM字開脚でゴブリンちんぽをエロまんこで咥えて両手チンポのトロ顔ご奉仕したりと完全に肉便器堕ち\n最後はボスの巨大オークの極太巨根にフルネルソンで犯され、子宮口をこじ開けられて大量の特濃ザーメンを直接腟内射精されアヘ顔受精アクメ\n種づけ完了で極太巨根を抜くと、ゴブリンにまんぐり返しにされたエルメダのまんこはオークの巨の形のまま開きっぱなしで子宮口まで丸見え、ザーメンを大量逆流させながらハイライト消えた目でアヘトロ笑顔するエルメダで暗転\n\n事後、エルメダはボロ服でボテ腹、太股には何人も産まされた印が\n自分の産んだゴブリンに嬲られおっぱいを吸われながらまんことアナルを犯されるも孕み袋として幸せそうにアヘトロ顔でアクメきめながらEND\n\n修正は黒線or白線、psdグレスケ納品、値段再送許可でお願いします\n\nhttps://arcanadea-official.com/character/ermeda/", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hage28hagewo/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7cd68ca4/uploads/origins/6786e4d2-3469-4d99-b5d5-1829e79281e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=013aeac3c8e8bfa4bfdee43a2e77a9c7", "srcset": "https://si.imgix.net/7cd68ca4/uploads/origins/6786e4d2-3469-4d99-b5d5-1829e79281e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=013aeac3c8e8bfa4bfdee43a2e77a9c7, https://si.imgix.net/7cd68ca4/uploads/origins/6786e4d2-3469-4d99-b5d5-1829e79281e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=804e152e7c1485e5ef6927cf48d66d30 2x, https://si.imgix.net/7cd68ca4/uploads/origins/6786e4d2-3469-4d99-b5d5-1829e79281e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84b911dbfd71e9414b2a040aed129203 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 995842, "client_id": 4440, "nc": 176}, {"path": "/@hage28hagewo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "