66\u3084\u308b\u304b\u304f\u3089\u3044\u306e\u30ce\u30ea\u3067\u52dd\u624b\u306b\u6c7a\u3081\u305f\u3002\u6614\u306f\u30b9\u30fc\u30d1\u30fc\u653b\u3081\u69d8\u00d7\u30cf\u30a4\u30d1\u30fc\u53d7\u3051\u69d8\u3060\u3063\u305f\u304c\u4eca\u306f\u30b9\u30fc\u30d1\u30fc\u653b\u3081\u69d8\u00d7\u7121\u77e5\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u3066\u3044\u308b\u3002\u544a\u767d\u306f\u653b\u3081\u304b\u3089\u3002\n\n\n\u3010\u73fe\u30d1\u30ed\u306b\u3064\u3044\u3066\u3011\n(\u7248\u6a29\u306a\u3089\u4e8c\u6b21\u5275\u4f5c\u3067\u73fe\u30d1\u30ed\u3042\u308a\u305d\u3046\u3060\u3088\u306d\u301c\u30ad\u30e3\u30c3\u30ad\u30e3\uff01\u306e\u30ce\u30ea\u3067\u6c7a\u3081\u307e\u3057\u305f\u3002\u73fe\u30d1\u30ed\u306e\u5834\u5408\u306f\u4e16\u754c\u89b3\u306b\u3064\u3044\u3066\u306e\u6ce8\u610f\u70b9\u306f\u7279\u306b\u4e0d\u8981\u3067\u3059\u3002\u666e\u901a\u306b\u30d9\u30c3\u30c9\u3067\u5bdd\u308b\u3057\u6d0b\u670d\u3082\u7740\u307e\u3059)\n\u73fe\u30d1\u30ed\u3060\u30682\u6b73\u5dee\u3002\u304a\u4e92\u3044\u4e2d\u5b66\u751f(\u653b\u308113\u6b73\u3001\u53d7\u305115\u6b73)\u306e\u6642\u306b\u51fa\u4f1a\u3063\u3066\u610f\u6c17\u6295\u5408\u3057\u3001\u5171\u901a\u306e\u53cb\u4eba(\u672c\u7de8\uff1f\u306e\u540c\u9663\u55b6\u306e\u4ef2\u9593\u305f\u3061\u73fe\u30d1\u30ed\u306e\u3059\u304c\u305f)\u3068\u4e00\u7dd2\u306b\u4e2d\u5b66\u2192\u9ad8\u6821\u2192\u5927\u5b66\u3068\u540c\u3058\u9032\u8def\u306b\u9032\u3080\u3002\u653b\u3081\u306e\u89aa\u304c\u3060\u3044\u3076\u4e00\u65cf\u7dcf\u51fa\u3067\u6bd2\u89aa\u5bb6\u7cfb\u306a\u306e\u3067\u4e2d\u5b66\u6642\u70b9\u3067\u53d7\u3051\u306e\u5bb6\u3067\u5bdd\u6cca\u307e\u308a\u3059\u308b\u30d7\u30c1\u5bb6\u51fa\u304c\u591a\u304b\u3063\u305f\u305f\u3081\u3001\u53d7\u3051\u306f\u544a\u767d\u3055\u308c\u308b\u307e\u3067\u306f\u653b\u3081\u306e\u3053\u3068\u3092\u53ef\u611b\u3044\u5f1f\u307f\u305f\u3044\u306a\u3082\u306e\u3060\u3068\u601d\u3063\u3066\u3044\u305f\u3002\n\u672c\u7de8\u306e\u8a18\u61b6\u55aa\u5931\u306b\u306a\u308b\u539f\u56e0\u306e\u7d06\u4f59\u66f2\u6298\u90e8\u5206\u306f\u3001\u653b\u308122\u6b73\u00d7\u53d7\u305124\u6b73(\u307e\u3060\u304f\u3063\u3064\u3044\u3066\u306a\u3044)\u306e\u6642\u306b\u53d7\u3051\u304c\u901a\u308a\u9b54\u306b\u523a\u3055\u308c\u3066\u3076\u3063\u5012\u308c\u30662\u5e74\u9593\u690d\u7269\u72b6\u614b\u306b\u306a\u308b\u2192\u5947\u8de1\u306e\u5fa9\u6d3b\u3092\u9042\u3052\u308b\u304c\u8a18\u61b6\u55aa\u5931\u3000\u3068\u3044\u3063\u305f\u6d41\u308c\u3002\u672c\u7de8\u3068\u9055\u3063\u3066\u306a\u3093\u3084\u304b\u3093\u3084\u3042\u3063\u3066\u8a18\u61b6\u623b\u3063\u3066\u3001\u623b\u3063\u3066\u304b\u3089\u304f\u3063\u3064\u304f\u3002\u73fe\u30d1\u30ed\u306e\u5de6\u53f3\u306f\u53d7\u3051\u304c2\u5e74\u9593\u5fc3\u914d\u304b\u3051\u305f\u3057\u8cac\u4efb\u53d6\u3063\u3066\u3084\u308b\u304b\u2026\u2026\u306e\u30ce\u30ea\u3067\u52dd\u624b\u306b\u6c7a\u3081\u305f\u3002\n\n\n\u3010\u653b\u3081\u3011\n\u540d\u524d:\u6709\u6816\u5ddd\u3000\u90a3\u7947(\u90a3\u7947)/\u9d50(\u3057\u3068\u3069)\n\u4e00\u4eba\u79f0:\u4ffa\n\u53d7\u3051\u3078\u306e\u4e8c\u4eba\u79f0:\u304a\u524d\n\u53e3\u8abf:\u67d0\u65e5\u672c\u5200\u304c\u4e71\u821e\u3059\u308b\u3084\u3064\u306e\u30ad\u30e3\u30f3\u30c9\u30eb\u30ab\u30c3\u30bf\u30fc\u3055\u3093\u3092\u5c11\u3057\u304a\u5805\u304f\u3057\u305f\u611f\u3058(\u300c\u301c\u3060\u3088\u300d\u300c\u301c\u3060\u308d\u300d\u306a\u3069)\n\u53d7\u3051\u3092\u93ba(\u8a18\u61b6\u55aa\u5931\u524d)\u2192\u6727(\u8a18\u61b6\u55aa\u5931\u5f8c)\u3068\u547c\u3076\u3002\u57fa\u672c\u7684\u306b\u306f\u5225\u4eba\u3068\u3057\u3066\u6271\u3046\u304c\u3001\u540c\u4e00\u4eba\u7269\u3068\u3057\u3066\u8a8d\u8b58\u3057\u3066\u3044\u308b\u3002\n\u8eab\u9577185cm\u7a0b\u5ea6(\u672c\u7de8\uff1f\u306e\u307f\u4e0b\u99c4\u8fbc\u307f\u3067190cm\u3092\u8d85\u3048\u308b)\u3002\u4f53\u578b\u306f\u3084\u3084\u7b4b\u8089\u8cea\u3002\u67d0\u5b87\u5b99\u958b\u62d3\u5217\u8eca\u306e\u51b7\u5fb9\u306a\u84bc\u9f8d(\u9f8d\u5c0a\u306e\u3059\u304c\u305f)\u304f\u3089\u3044\u3002\n\u3061\u306a\u307f\u306b\u30e2\u30c1\u30fc\u30d5\u306f\u30ab\u30e9\u30b9\u3002\n\n\u30fb\u72ec\u5360\u6b32\u3068\u751f\u7269\u7684\u672c\u80fd\u304b\u3089\u304f\u308b\u565b\u307f\u7656\u3042\u308a\u3002\u9996\u3084\u80a9\u53e3\u3092\u91cd\u70b9\u7684\u306b\u565b\u3080(\u93ba\u304c\u77ef\u6b63\u3057\u306a\u304b\u3063\u305f\u305f\u3081\u3000\u7d50\u679c\u672a\u6765\u306e\u81ea\u5206\u304c\u88ab\u5bb3\u3092\u53d7\u3051\u3066\u3044\u308b)\n\u30fb\u6027\u6b32\u306f\u7121\u3044\u65b9\u306e\u90e8\u985e\u3060\u304c\u706b\u304c\u3064\u304f\u3068\u5927\u5909\u306a\u30bf\u30a4\u30d7\n\u30fb\u30ad\u30b9\u30cf\u30e1\u3057\u304c\u3061\u3002\u6700\u4e2d\u306b\u53e3\u79fb\u3057\u3067\u6c34\u5206\u88dc\u7d66\u3055\u305b\u305f\u308a\u3059\u308b\u3002\u9577\u5f15\u304d\u305d\u3046\u306a\u6642\u306f\u6c34\u5206\u88dc\u7d66\u3067\u304d\u305d\u3046\u306a\u3082\u306e\u3092\u6301\u53c2\u3059\u308b\u306e\u3067\u53d7\u3051\u304c\u8272\u3005\u3068\u899a\u609f\u3059\u308b\n\u30fb\u795e\u57df(\u5c71\uff1f)\u6301\u3061\u306a\u306e\u3067\u91ce\u5916\u3048\u3063\u3061\u5bfe\u5fdc\u53ef\n\u30fb\u5bdd\u30d0\u30c3\u30af\u304c\u597d\u304d(\u565b\u307f\u3084\u3059\u3044\u3001\u81ea\u50b7\u30fb\u9003\u3052\u3092\u6b62\u3081\u3084\u3059\u3044\u3001\u53d7\u3051\u304c\u4e00\u756a\u611f\u3058\u3066\u308b\u6c17\u304c\u3059\u308b)\n\n\n\u3010\u53d7\u3051\u3011(\u8a18\u61b6\u55aa\u5931\u524d\u2192\u5f8c)\n\u540d\u524d:\u93ba(\u306f\u3070\u304d)\u2192\u516d\u9053\u3000\u6727\n\u4e00\u4eba\u79f0:\u30aa\u30ec\u2192\u79c1\n\u653b\u3081\u3078\u306e\u4e8c\u4eba\u79f0:\u304a\u307e\u3048\u2192\u304a\u524d\n\u53e3\u8abf:\u67d0\u5b87\u5b99\u958b\u62d3\u5217\u8eca\u306e\ud83d\udd1b\u30d1\u30ed\u30b9\u3000\u7d1b\u4e89\u306e\u534a\u795e\u3092\u3084\u3084\u53e4\u98a8\u306b\u3057\u305f\u611f\u3058\u3002\u8a18\u61b6\u55aa\u5931\u5f8c\u306f\u558b\u308a\u306a\u304c\u3089\u8003\u3048\u8fbc\u3080\u306e\u3067\u300c\u2026\u2026\u300d\u304c\u591a\u3044\u3002\n\u653b\u3081\u306f\u9d50\u547c\u3073\u2192\u8a18\u61b6\u55aa\u5931\u5f8c\u306f\u90a3\u7947\u547c\u3073\u3002\n\u8eab\u9577\u306f187cm\u304f\u3089\u3044(\u653b\u3081\u3088\u308a\u3061\u3087\u3063\u3068\u5927\u304d\u3044)\u3002\u4f53\u578b\u306f\u9577\u8eab\u7d30\u8eab\u3002\u672c\u7de8\uff1f\u306f\u30ac\u30c1\u4eba\u5916\u306a\u306e\u3067\u4f55\u3084\u3063\u3066\u3082\u4f53\u578b\u306f\u5909\u308f\u3089\u306a\u3044\u304c\u3001\u73fe\u30d1\u30ed\u306f\u8102\u80aa\u3082\u7b4b\u8089\u3082\u3064\u304d\u306b\u304f\u3044\u4f53\u8cea\u3002\u4f53\u3092\u52d5\u304b\u305b\u3070\u52d5\u304b\u3059\u307b\u3069\u5f15\u304d\u7de0\u307e\u3063\u3066\u3044\u304f\u30bf\u30a4\u30d7\u3002\n\u307e\u305f\u3001\u672c\u7de8\uff1f\u306f\u96e2\u53cd\u3068\u8a18\u61b6\u55aa\u5931\u306e\u7d06\u4f59\u66f2\u6298\u306b\u95a2\u4fc2\u3059\u308b\u53e4\u50b7\u3042\u308a(\u8cc7\u6599\u53c2\u8003\u3002\u4e00\u56de\u771f\u3063\u4e8c\u3064\u306b\u306a\u3063\u305f\u306e\u304c\u8d85\u5e38\u7684\u306a\u529b\u3067\u3072\u3063\u3064\u3044\u3066\u3044\u308b)\u3002\u8a18\u61b6\u55aa\u5931\u524d\u306f\u304a\u8179\u306e\u50b7\u3060\u3051\u3067\u3001\u8a18\u61b6\u55aa\u5931\u5f8c\u306b\u9996\u306e\u50b7\u304c\u5897\u3048\u308b\u3002\u96e8\u306e\u65e5\u306b\u7121\u8336\u82e6\u8336\u75db\u3080\u3002\u666e\u6bb5\u306f\u89e6\u3089\u308c\u308b\u3068\u304f\u3059\u3050\u3063\u305f\u3044\u3002\n\u73fe\u30d1\u30ed\u306e\u53e4\u50b7\u306f\u5de6\u80f8\u306e\u523a\u3057\u50b7\u306e\u307f(\u73fe\u30d1\u30ed\u306e\u3053\u3044\u3064\u306f\u5168\u3066\u306e\u5185\u81d3\u306e\u4f4d\u7f6e\u304c\u5de6\u53f3\u53cd\u8ee2\u3057\u3066\u3044\u308b\u306e\u3067\u81f4\u547d\u50b7\u3067\u6e08\u3093\u3060)\u3060\u304c\u3001\u80ba\u3068\u30c7\u30ab\u3081\u306e\u8840\u7ba1\u3092\u8ca0\u50b7\u3057\u3066\u3044\u308b\u306e\u3067\u5f8c\u5929\u6027\u306e\u547c\u5438\u75be\u60a3\u304c\u3042\u308b\u3002\n\u3061\u306a\u307f\u306b\u30e2\u30c1\u30fc\u30d5\u306f\u4e0d\u6b7b\u9ce5\u3002\n\n(\u8a18\u61b6\u55aa\u5931\u524d)\n\u30fb\u57fa\u672c\u7cbe\u795e\u7684\u512a\u4f4d\u306b\u7acb\u3061\u304c\u3061\n\u30fb\u6700\u4e2d\u6b63\u6c17\u3092\u4fdd\u3064\u305f\u3081\u306b\u81ea\u50b7\u306b\u8d70\u308a\u304c\u3061(\u50b7\u3092\u53d7\u3051\u305f\u305d\u3070\u304b\u3089\u6cbb\u308b\u3068\u3093\u3067\u3082\u4f53\u8cea\u306e\u305f\u3081)\u3002\u6b62\u3081\u3089\u308c\u308b\u3068\u6012\u308b\n\u30fb\u30a4\u304f\u3068\u304d\u306e\u3051\u305e\u308b\n\u30fb\u30d7\u30e9\u30a4\u30c9\u9ad8\u3044\n\u30fb\u304a\u53e3\u304c\u5c0f\u3055\u3044\n\u30fb\u7761\u7720\u4e0d\u8981\u3000\u5bdd\u3066\u308b\u653b\u3081\u306b\u3061\u3087\u3063\u304b\u3044\u304b\u3051\u308b\n\n(\u8a18\u61b6\u55aa\u5931\u5f8c\u3000\u5909\u66f4\u70b9\u306e\u307f\u8a18\u8f09)\n\u30fb\u81ea\u5206\u306e\u540d\u524d\u3082\u7a2e\u65cf\u3082\u7d4c\u6b74\u3082\u4e00\u822c\u5e38\u8b58\u8fbc\u307f\u3067\u5168\u90e8\u5fd8\u308c\u3066\u3044\u308b(\u3042\u308b\u7a0b\u5ea6\u899a\u3048\u76f4\u3057\u305f)\u3002\u3048\u3063\u3061\u306a\u3053\u3068\u3082\u6559\u3048\u3089\u308c\u306a\u3044\u9650\u308a\u4f55\u3082\u77e5\u3089\u306a\u3044\u3000\u7121\u77e5\u30b7\u30c1\u30e5\u9069\u6b63\u25ce\n\u30fb\u76ee\u304b\u3089\u30cf\u30a4\u30e9\u30a4\u30c8\u304c\u6d88\u3048\u308b\u3002\u8868\u60c5\u7b4b\u304c\u4ed5\u4e8b\u3092\u653e\u68c4\u3059\u308b(\u57fa\u672c\u7684\u306b\u4f55\u3092\u8003\u3048\u3066\u3044\u308b\u304b\u308f\u304b\u3089\u306a\u304f\u306a\u308b)\n\u30fb\u4eba\u5916\u81ea\u899a\u306a\u3057\n\u30fb\u81ea\u50b7\u7656\u306a\u3044\u306a\u3063\u305f\n\u30fb\u653b\u3081\u306e\u80cc\u4e2d\u306b\u722a\u7acb\u3066\u304c\u3061\n\u30fb\u30d0\u30c3\u30af\u6016\u3044(\u6c17\u6301\u3061\u826f\u3059\u304e\u3066\u6016\u3044\u3001\u7e0b\u308b\u5148\u304c\u7121\u304f\u3066\u6016\u3044)\n\u30fb\u5bdd\u308b\u3088\u3046\u306b\u306a\u308b(\u4eba\u5916\u81ea\u8a8d\u306a\u304f\u306a\u3063\u305f\u306e\u3067\u7121\u81ea\u899a\u306e\u307e\u307e\u4eba\u9593\u306e\u771f\u4f3c\u4e8b\u3092\u3057\u3066\u3044\u308b)\u3002\u4e00\u5fdc\u75b2\u308c\u305f\u308a\u3057\u305f\u3089\u7720\u305f\u304f\u306a\u308b\n\n\n\u3010\u305d\u306e\u4ed6\u3011\n\u30aa\u30e1\u30ac\u30d0\u3060\u3068\u03b1\u00d7\u03b1\u2192\u30d3\u30c3\u30c1\u30f3\u30b0\u3067\u03b1\u00d7\u5f8c\u5929\u6027\u03a9\u306b\u306a\u308b\u3002\u3042\u304f\u307e\u3067\u5f8c\u5929\u6027\u306a\u306e\u3067\u30d2\u30fc\u30c8\u306f\u4e0d\u5b9a\u671f\u3001\u304b\u3064\u5de3\u4f5c\u308a\u304c\u3081\u3063\u3061\u3083\u4e0b\u624b\u3002\u3042\u3068\u672c\u7de8\u3082\u73fe\u30d1\u30ed\u3082\u4f53\u306e\u69cb\u9020\u304c\u30d0\u30b0\u308a\u6563\u3089\u304b\u3057\u3066\u3044\u308b\u306e\u3067\u6291\u5236\u5264\u306e\u52b9\u304d\u306f\u3044\u307e\u3044\u3061\u3002\n\n\u30fb\u672c\u7de8\uff1f\u3060\u3068\u8a18\u61b6\u55aa\u5931\u6642\u70b9\u3067\u65e2\u306b\u03a9\u306b\u306a\u3063\u3066\u3044\u3066\u3001\u8a18\u61b6\u3042\u308b\u6642\u306f\u7e41\u6b96\u4e0d\u8981\u306e\u81ea\u899a\u304c\u3042\u308b\u306e\u3067\u767a\u60c5\u671f\u306a\u304b\u3063\u305f\u2192\u4eba\u5916\u81ea\u8a8d\u304c\u306a\u3044\u306a\u3063\u305f\u306e\u3067\u30d2\u30fc\u30c8\u304c\u6765\u308b\u3088\u3046\u306b\u306a\u3063\u305f\u3002\n\u30fb\u73fe\u30d1\u30ed\u306f\u3072\u3063\u3064\u3044\u305f\u6642\u70b9\u3067\u306f\u03b1\u540c\u58eb\u3060\u3063\u305f\u304c\u3001\u53d7\u3051\u304c\u5de6\u53f3\u3092\u52dd\u624b\u306b\u6c7a\u3081\u305f\u6642\u306b\u3044\u3064\u304b\u307d\u308d\u3063\u3068\u3053\u3044\u3064\u306e\u904b\u547d\u51fa\u3066\u304d\u305f\u3089\u56f0\u308b\u3001\u30aa\u30ec\u304c\u8cb0\u3063\u3066\u3084\u308b\u304b\u3089\u30aa\u30ec\u3068\u756a\u3048\u3063\u3066\u30ce\u30ea\u3067\u52dd\u624b\u306b\u753b\u7b56\u3057\u3066\u52dd\u624b\u306b\u5b8c\u9042\u3057\u305f\u3002\n\nhttps://drive.google.com/drive/folders/1es2NnV8GklZ4nJGmFHdQyQ3L9eHAL1bq?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ki_lly/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 243837, "client_id": 3509301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d5e4a13/uploads/origins/082dd9b0-772e-43e8-8eef-94225bd5498