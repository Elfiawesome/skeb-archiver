0&s=ec4605a0d366f1ced7515274935da4f0 3x"}, "body": "こんにちは！\nあなたの絵が大好きです！:D\n\n僕のOCを描いてくれないかな？\n\nいくつか参考になる点があります：\n-コートの毛とショーツの毛はとても大きくて、たくさん膨らんでいます！\n-毛皮といえば、フードを頭より大きくすることで、より多くの角度からふわふわの毛皮を見せることができます。\n-尻尾を見せようと思ったら、尻尾は体とほぼ同じ大きさ。\n-普段はおとなしいが、仲良くなればいい子。\n-指がほとんど見えないほど、フードの毛皮の中に手を深く沈め、フードの方に身を乗り出して、ふかふかの毛皮に頬を寄せる姿がよく見られる。\n\nこの度は本当にありがとうございました。\n素晴らしい一日をお過ごしください。\n\nまた、1円のおまけもよろしくお願いします～(^w^)\n\nhttps://drive.google.com/drive/folders/1tX9kbhHtKVVJCQkhhvGimDyC6bdU-VDa?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syamecha_404/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2690688, "client_id": 1798313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dbdacac/uploads/origins/97772b82-1a23-4cff-a91b-d47f4de894e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffd847d9252e59338a446f30b4470a49", "srcset": "https://si.imgix.net/3dbdacac/uploads/origins/97772b82-1a23-4cff-a91b-d47f4de894e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffd847d9252e59338a446f30b4470a49, https://si.imgix.net/3dbdacac/uploads/origins/97772b82-1a23-4cff-a91b-d47f4de894e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ab0209726460169aa76f32979cf6def 2x, https://si.imgix.net/3dbdacac/uploads/origins/97772b82-1a23-4cff-a91b-d47f4de894e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cb9c88a5bff31b813ef8f53c6c5eec0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dbdacac/uploads/origins/97772b82-1a23-4cff-a91b-d47f4de894e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0196d48b5689efaa1e9e292f8377fe50", "srcset": "https://si.imgix.net/3dbdacac/uploads/origins/97772b82-1a23-4cff-a91b-d47f4de894e4?bg=%23fff&auto=format%2C