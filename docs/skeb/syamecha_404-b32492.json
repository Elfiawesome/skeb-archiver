で「翼」を背中に欲しいです。(2対だと嬉しいです)。翼のデザインや色はお任せします。\n雰囲気⋯お任せします。暗い、かわいい、綺麗、etc...しゃめ茶様の描きたいテーマでよろしくお願いします。\n\n\n頂いたイラストは私的利用の範囲にとどめ、鑑賞したり印刷して飾ったりする予定です。\n\n\n以上、要望が長々と多くなってしまいすみません。\nしゃめ茶様の私生活を1番に、気張らず描いていただけますようよろしくお願いします。\n完成を気長に待っています🖌\n\nhttps://x.com/syamecha_404/status/1766470619011641651?t=B1A-fMtonDmRjG8nJOfWew&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@syamecha_404/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2690688, "client_id": 2338153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/350671c1/uploads/origins/24b4ab60-61a5-44bc-b759-f265c05bfba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c30373ee46921c90a92a3cccdec60f1b", "srcset": "https://si.imgix.net/350671c1/uploads/origins/24b4ab60-61a5-44bc-b759-f265c05bfba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c30373ee46921c90a92a3cccdec60f1b, https://si.imgix.net/350671c1/uploads/origins/24b4ab60-61a5-44bc-b759-f265c05bfba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=365c8f8adfd72a19a3fa60a53137ec94 2x, https://si.imgix.net/350671c1/uploads/origins/24b4ab60-61a5-44bc-b759-f265c05bfba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3aada84ca44f7aa334a780fd6422dfa6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/350671c1/uploads/origins/24b4ab60-61a5-44bc-b759-f265c05bfba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd932fdd188881f8b4c15f5965c3e1e5", "srcset": "https://si.imgix.net/350671c1/uploads/origins/24b4ab60-61a5-44bc-b759-f265c05bfba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd932fdd188881f8b4c15f5965c3e1e5, https://si.imgix.net/350671c1/uploads/origins/24b4ab60-61a5-44bc-b759-f265c