\u53ef\u80fd\u3067\u3042\u308c\u3070\u30e9\u30ba\u3068\u3044\u3046\u6050\u7adc(\u9f8d)\u306e\u7363\u4eba\u306e\u5973\u306e\u5b50\u3082\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\u30d5\u30a1\u30fc\u30b8\u30eb\u306e\u5a18(\u8840\u306e\u7e4b\u304c\u308a\u306f\u7121\u3057)\n\u5e74\u9f6216\u6b73\u306e\u9ad8\u6821\u751f\u3002\u30d0\u30f3\u30c9\u6240\u5c5e\u3067\u30ae\u30bf\u30fc\u3068\u30e1\u30a4\u30f3\u30dc\u30fc\u30ab\u30eb\u62c5\u5f53\u3002\u7121\u53e3\u3067\u30af\u30fc\u30eb\u3002\u8eab\u9577170cm\u3002\u80f8\u306fE\u30ab\u30c3\u30d7\u3002\u9f8d\u306e\u3057\u3063\u307d\u304c\u8170\u304b\u3089\u751f\u3048\u3066\u3044\u307e\u3059\u3002\n\u9aea\u306e\u6bdb\u306f\u53f3\u5074\u304c\u9ed2\u8272\u3067\u5de6\u5074\u304c\u7dd1\u8272\u3002\n\u76ee\u306e\u8272\u306f\u53f3\u5074\u304c\u8d64\u8272\u3067\u5de6\u5074\u304c\u7dd1\u8272\u3002\n\u53f3\u5074\u306f\u30d5\u30a1\u30fc\u30b8\u30eb\u306e\u3088\u3046\u306a\u898b\u305f\u76ee\u306b\u306a\u308a\u305f\u304f\u3066\u81ea\u5206\u3067\u5909\u3048\u3066\u3044\u307e\u3059\u3002\n\u80fd\u529b\u306f\u5909\u8eab\u80fd\u529b(\u624b\u8db3\u3092\u6050\u7adc\u306b\u5909\u5316\u3055\u305b\u3066\u6226\u3046)\n\n\u30e9\u30ba\u306f\u30d5\u30a1\u30fc\u30b8\u30eb\u306b6\u6b73\u306e\u9803\u306b\u62fe\u308f\u308c\u3001\u305d\u308c\u304b\u3089\u30d5\u30a1\u30fc\u30b8\u30eb\u30d1\u30d1\u304c\u5927\u597d\u304d\u306a\u8a2d\u5b9a\u3067\u3059\u3002\n2\u4eba\u306f\u4ef2\u306e\u3044\u3044\u89aa\u5b50\u3067\u3001\u304a\u4e92\u3044\u306b\u304a\u4e92\u3044\u304c\u4f55\u3088\u308a\u5927\u5207\u306a\u5b58\u5728\u3067\u8ddd\u96e2\u611f\u8fd1\u3081\u3067\u3059\u3002\n\n\u3082\u3057\u6599\u91d1\u7684\u306b\u96e3\u3057\u3051\u308c\u3070\u30d5\u30a1\u30fc\u30b8\u30eb\u306e\u307f\u3067\u304b\u307e\u3044\u307e\u305b\u3093\uff01\n\u8863\u88c5\u3084\u9aea\u578b\u306a\u3069\u3082\u81ea\u7531\u306b\u5909\u3048\u3066\u9802\u3044\u3066\u304b\u307e\u3044\u307e\u305b\u3093\ud83d\ude47\u200d\u2642\ufe0f\n\u69cb\u56f3\u3084\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u