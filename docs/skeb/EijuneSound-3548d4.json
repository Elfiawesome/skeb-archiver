op=top&w=200&h=200&blur=200&s=feadca0cc8ce7d037bea7b45d8aebb47 3x"}, "body": "もずくにん先生こんにちは。以下のオリジナル怪談を読み上げていただきたいと思いご依頼いたしました。適宜アレンジしていただいても結構です。ぜひよろしくお願いします。\n\n--本文--\n\nこれは昨日空を飛んでいたおっぱいの話なんですが、真夜中、西から東に向けておっぱいがヒューンって飛んでたんです。なので「珍しいなぁ」と思いデジカメを向けたところ、「プレイエリアの外です」と表示されるだけで撮影ができない。不思議に思い振り返ると、おっぱいがズシンズシンと音を立てて歩いていたんです。さすがの私も驚きました。おっぱいが歩くだけならともかく、ズシンズシンと音を立てるほどの大きさのおっぱいが歩いていたんですから。するとね、向こうもこちらの存在に気づいて歩みを止めたんです。対峙するとその大きさが際立つ。体長4〜5メートルほどでしたね。そして、おっぱいが「クーン、クーン」と鳴き始めたんです。驚きました。おそらく、そのおっぱいは親おっぱいとはぐれた子おっぱいで、親おっぱいを探していたんです。とりあえず私はおっぱいを落ち着かせるために、ゆっくり近づいて、手持ちのミルクを上げました。おっぱいは、それはもう美味しそうにミルクを飲み干すと、私に「おねえちゃん、ありがとう！」と可愛らしい声で言い残して、夜闇に帰っていきました。\n未知との遭遇に驚くばかりでしたが、今思えばおっぱいが空を飛んでいるところから全部幻覚ということに気づきました。それに気付き、いまとても怖いです。\nおわり", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 15463, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蒼巳生姜⚓深谷市イラストレーター📚依頼受付中", "screen_name": "syo_u_ron", "avatar_url": "https://pbs.twimg.com/profile_images/1906846970565767168/dXMHtAtK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/916998834252767232/1742821338/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 176}, {"id": 439313, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あさひな依", "screen_name": "yorincoro", "avatar_url": "https://pbs.twimg.com/profile_images/1822141543005802496/PG5qF1Jf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/94818565/1632188297/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 33}