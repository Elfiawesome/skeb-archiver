は、どの生においても互いを見出す恋人同士なのです。\n\nあなたの画風は本当に素敵で、ノワール調の雰囲気が大好きです！ミステリアスで物憂げな絵を描いていただけたら嬉しいです～もしこの金額では足りない場合は、再度リクエストしてください。追加でお送りします！ありがとうございます！\nhttps://drive.google.com/drive/folders/1Gj11qyktlUT10jn7lIs5rOXCd7d_m66P?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fwpla/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926618, "client_id": 3396404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b8dba74/uploads/origins/a2a7c407-e7e6-4f18-b15e-719708bb398d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1a2737c2c0566d6bde8fc81c0bc064", "srcset": "https://si.imgix.net/1b8dba74/uploads/origins/a2a7c407-e7e6-4f18-b15e-719708bb398d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1a2737c2c0566d6bde8fc81c0bc064, https://si.imgix.net/1b8dba74/uploads/origins/a2a7c407-e7e6-4f18-b15e-719708bb398d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcb488e65b97d5989833d062998e3073 2x, https://si.imgix.net/1b8dba74/uploads/origins/a2a7c407-e7e6-4f18-b15e-719708bb398d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20f39562b94ea344a399467d00249c5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b8dba74/uploads/origins/a2a7c407-e7e6-4f18-b15e-719708bb398d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5143f3e62d8ba0a6f88a62c9fea1ff9", "srcset": "https://si.imgix.net/1b8dba74/uploads/origins/a2a7c407-e7e6-4f18-b15e-719708bb398d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5143f3e62d8ba0a6f88a62c9fea1ff9, https://si.imgix.net/1b8dba74/uploads/origins/a2a7c407-e7e6-4f18-b15e-719708bb398d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a