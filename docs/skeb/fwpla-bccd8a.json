ebp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb1e59eeb9720d5fc4ef3a4e0e67632f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6da64856/uploads/origins/669935a9-dbd5-4257-b0c1-2a2d57abc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=675c719824395ca3f596ed64949b74c5", "srcset": "https://si.imgix.net/6da64856/uploads/origins/669935a9-dbd5-4257-b0c1-2a2d57abc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=675c719824395ca3f596ed64949b74c5, https://si.imgix.net/6da64856/uploads/origins/669935a9-dbd5-4257-b0c1-2a2d57abc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bbc63af146811a257e45d3e30ae329a 2x, https://si.imgix.net/6da64856/uploads/origins/669935a9-dbd5-4257-b0c1-2a2d57abc9b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5288c6f3875479aae7128f39a3c9a037 3x"}, "body": "Hello! Your artstyle is super cool, so I wanted to make a request similar to your last work! I would love if you could draw my OC! She is a sorceress with the ability to control space and use black holes in combat. Often times she is depicted as a cool princely type. A pose with her tipping her hat down would look super cool! I'll leave the details up to you, but I would love if it gave her a very cool vibe! Thank you for considering my request!\n\nThank you so much for considering my request!\nOC: https://drive.google.com/drive/folders/1YoH5U2kxpd7JflrYunwTFpcZ6cjD9-_8?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fwpla/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926618, "client_id": 2991126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d46d7189/uploads/origins/71c7131b-be52-49ed-83a3-f7b377ea1043?bg=%23fff&a