8S9rWmAAmaaEP7vUjvqPDAhvFsH2\n\n\n・服装は制服でお願いします。（まつはご様が描かれた立ち絵の服が、てとら君の制服です）\n・もし可能であれば、てとら君の周辺にメンダコも漂っていると嬉しいです。\n・構図やポーズの希望はありません。\n\n---------------\n\n\nもし難しい場合はキャンセルしていただければと思います。\nご検討のほどよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mahi0wl/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2772687, "client_id": 1366182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fea1015/uploads/origins/8f7a50e6-931a-4c71-9561-8f09d95ce590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d28e0d9d185d06e7760532fb6199705", "srcset": "https://si.imgix.net/1fea1015/uploads/origins/8f7a50e6-931a-4c71-9561-8f09d95ce590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d28e0d9d185d06e7760532fb6199705, https://si.imgix.net/1fea1015/uploads/origins/8f7a50e6-931a-4c71-9561-8f09d95ce590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73b2eac27215850b4e85ca4a5a3f9984 2x, https://si.imgix.net/1fea1015/uploads/origins/8f7a50e6-931a-4c71-9561-8f09d95ce590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ea0c122f17275a1e3ac4bf6e42b251a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fea1015/uploads/origins/8f7a50e6-931a-4c71-9561-8f09d95ce590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47476bffff31f3f4e3fe103077c5176c", "srcset": "https://si.imgix.net/1fea1015/uploads/origins/8f7a50e6-931a-4c71-9561-8f09d95ce590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47476bffff31f3f4e3fe103077c5176c, https://si.imgix.net/1fea1015/uploads/origins/8f7a50e6-931a-4c71-9561-8f09d95ce590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3939d2cf7e784609164f