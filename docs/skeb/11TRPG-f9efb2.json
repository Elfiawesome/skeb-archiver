top&w=200&h=200&s=86aac86a4d80c60e10a4cb29ef8c5d5b, https://si.imgix.net/d61c9bb6/uploads/origins/b7831447-e7e9-4841-8b97-eb928fe3dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e818f5fe5e9da30533299559c3d09b66 2x, https://si.imgix.net/d61c9bb6/uploads/origins/b7831447-e7e9-4841-8b97-eb928fe3dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d25128d09ee1fc214030bc60c3daafe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d61c9bb6/uploads/origins/b7831447-e7e9-4841-8b97-eb928fe3dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0285336d9955709f1b5db94bd70bc1", "srcset": "https://si.imgix.net/d61c9bb6/uploads/origins/b7831447-e7e9-4841-8b97-eb928fe3dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0285336d9955709f1b5db94bd70bc1, https://si.imgix.net/d61c9bb6/uploads/origins/b7831447-e7e9-4841-8b97-eb928fe3dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afcd3579097634de0ae0148e0a32aa09 2x, https://si.imgix.net/d61c9bb6/uploads/origins/b7831447-e7e9-4841-8b97-eb928fe3dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8a650a311570e3d1ce4757f18a75e32 3x"}, "body": "こんばんは！\nWANWANさんの細部の書き込みとこだわりが本当に素晴らしくて、いつも見とれています…！\nTwitterの高速で過ぎ去るタイムラインの中、WANWANさんのイラストを見かけると遡って探し出して楽しませていただいておりました！\n\n今回は、CoCシナリオ『同居人』に連れていったPCの1枚絵を依頼させていただければと思います。\n以下、詳細になります(ネタバレなし)\n\n\n【人物】\n\n名前:鳴無蛍(なきなし ほたる)\n年齢:20代前半\n\n波打(なみうち)探偵事務所の助手を務めていた。\n波打沈(なみうち しずむ)探偵のことを「先生」と呼び慕っており、事務所に住み込みで働きつつ世話を焼いていた。\n『同居人』通過後、波打探偵事務所を残していくべく、探偵となって1人で切り盛りしている。\n\n鳴無蛍の名前の由来は都々逸の「恋に焦がれて鳴く蝉よりも 鳴かぬ蛍が身を焦がす」から来ており、波打探偵に秘めた恋心を抱いていた。\n波打探偵亡き後も、その思いはゆらがない。\n\n\n【シチュエーション】\n\n･波打ち際を歩く、もしくは佇む様子が見てみたいです。(時間帯はおまかせいたします)\n\n･彼女は紆余曲折あって前を向いて生きているので、「思い詰めている」というよりは「大切な人に思いを馳せる」ような、「思い出を噛み締める」ような雰囲気があると嬉しいです。\n\n･波打探偵が喫煙者であったため、煙草を持っているとなお嬉しいです。\n\nそれ以外の構図や服装もろもろは、おまかせいたします。\n服は立ち絵と同じでも違ってもどちらでも良いです。\n\n\nちょっと昔の資料でお恥ずかしい限りなのですが、思い出深くてとても大切な子です。\nどうぞよろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1VnWKlLJI96ZJ-LjRzxBjms40W144JdUq", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@11TRPG/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2563551, "client_id": 3236640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e47b79b/uploads/origins/3eac7930-97af-4736-abf4-fb2d0d96c570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f96d9076fb2d38bcb4d06187fd5fb99", "srcset": "https://si.imgix.net/6e47b79b/uploads/origins/3eac7930-97af-4736-abf4-fb2d0d96c570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f96d9076fb2d38bcb4d06187fd5fb99, https://si.imgix.net/6e47b79b/uploads/origins/3eac7930-97af-4736-abf4-fb2d0d96c570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c654e3a95e2f0f3ad66f867357b5326 2x, https://si.imgix.net/6e47b79b/uploads/origins/3eac7930-97af-4736-abf4-fb2d0d96c570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0cf83e2a931bff56029309d30a0395fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e47b79b/uploads/origins/3eac7930-97af-4736-abf4-fb2d0d96c570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d26b9ee8b21f19a567a54dcf5e3d2f8", "srcset": "https://si.imgix.net/6e47b79b/uploads/origins/3eac7930-97af-4736-abf4-fb2d0d96c570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d26b9ee8b21f19a567a54dcf5e3d2f8, https://si.imgix.net/6e47b79b/uploads/origins/3eac7930-97af-4736-abf4-fb2d0d96c570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7736474f18efdb5b