。\n極道者にちょっかい出して日頃のストレスを発散してる。\n受け攻めで表現するとすれば落語家攻めです。\n立ち絵↓\nhttps://drive.google.com/file/d/1gj5oUOC0ZIb2-u9Du4nE7NCugRB2hm-p/view?usp=drivesdk\n\n参考になれば幸いです…！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 1781818, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひとえ}👻", "screen_name": "Cl0hFm", "avatar_url": "https://pbs.twimg.com/profile_images/1981761011142029312/cYjtk3zV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1084117331930796032/1758281442/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1830071, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "inuを", "screen_name": "inuo_x", "avatar_url": "https://pbs.twimg.com/profile_images/1516451886001360901/AoZWSGKC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1410252927902437379/1758369358/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 25, "skills": [{"genre": "art"}], "n