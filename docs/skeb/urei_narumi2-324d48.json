r0Y?si=_C4_XaMg446hMqyM\n\n■描画範囲\n全身イラスト＋背景\n\n■表情差分\n通常（目開き）、目閉じ\n\n■参考動画\nこれが背景構図ともにかなりイメージ近いです。\n蜜月アン・ドゥ・トロワ (Honeymoon Un Deux Trois)／Luca Kaneshiro Cover\nhttps://youtu.be/mlPFSe-VabI?si=7LhIV5XvL-LISUfJ\n\n■構図・衣装補足\n衣装は裾持ってるものがイメージ近いです！\n片手は参考動画のように手を差し伸べてもいいかなとおもいつつも、\nもう片方の手はドレスの裾を持っているものやドレスは異素材になっているのもかわいいよなとか思ったり…足元や小物含めておまかせします！\n\nhttps://drive.google.com/drive/folders/1FrGINiVRVu_PzNt2bzYdAKgBrN3BaVSl?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@urei_narumi2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1061520, "client_id": 676770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0c5ae87/uploads/origins/94de6b9b-93a2-434b-9d52-6b8587ce3b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e6960985f566660a1eec1266df7e91", "srcset": "https://si.imgix.net/b0c5ae87/uploads/origins/94de6b9b-93a2-434b-9d52-6b8587ce3b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e6960985f566660a1eec1266df7e91, https://si.imgix.net/b0c5ae87/uploads/origins/94de6b9b-93a2-434b-9d52-6b8587ce3b26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45b5adcfbd813c6998d21b790472da62 2x, https://si.imgix.net/b0c5ae87/uploads/origins/94de6b9b-93a2-434b-9d52-6b8587ce3b26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb91543f783b9caf11ab905edf7c2b49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0c5ae87/uploads/origins/94de6b9b-93a2-434b-9d52-6b8587ce3b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af5991b262873dc2555dc2fbaea642ec", "srcset": "https://si.imgix.net/b0c5ae87/uploads/origins/94de6b9b-93a2-434b-9d52-6b8587ce3b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=20