使用させて頂きたいです。\n\n 【内容】 \n構図・ポーズ・表情などはお任せさせていただけますと幸いです。 \nサムネに使いやすいように髪の毛などが見切れてないと嬉しいです。\n帽子をなしの場合、アホ毛を忘れないようにお願いしたいです。\n\n【データ形式】 データはお手数ですが、人物・背景・宛名などレイヤー分けしていただけますと嬉しいです。 \n\nhttps://drive.google.com/drive/folders/1uEqDNLHDUXqUfydbx37c1p-PxZAnFXfn\nご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1uEqDNLHDUXqUfydbx37c1p-PxZAnFXfn", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mimi3sakura/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/20840e66/uploads/origins/4b42f0cb-8503-4164-8f22-3b9bbd3f21c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84c0444c0dae1bb814ef9f47df1c44ef", "srcset": "https://si.imgix.net/20840e66/uploads/origins/4b42f0cb-8503-4164-8f22-3b9bbd3f21c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=84c0444c0dae1bb814ef9f47df1c44ef, https://si.imgix.net/20840e66/uploads/origins/4b42f0cb-8503-4164-8f22-3b9bbd3f21c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07645142d95e20c36beb10faeece91d7 2x, https://si.imgix.net/20840e66/uploads/origins/4b42f0cb-8503-4164-8f22-3b9bbd3f21c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=766ba94b85a138be7f584dfbf72c1fdf 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3757988, "client_id": 3096403, "nc": 1}, {"path": "/@mimi3sakura/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3757988, "client_id": 3096403, "vtt_url": null, "thumbnail_image_urls": {"src": "