、和風~洋風・時代も問わず、何でも大歓迎です!!\n足りなければもう一度送らせて頂きます。\nどうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 177}, {"id": 1575993, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ししゃも", "screen_name": "shishamosama", "avatar_url": "https://pbs.twimg.com/profile_images/2006170482224369664/V8Whlh9d.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1451171188248481794/1767143290/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "nc": 32}, {"id": 1830752, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ْ", "screen_name": "99sakyu", "avatar_url": "https://pbs.twimg.com/profile_images/1726563651551895552/eGHHE150.jpg", "header_url": "https://pbs.twimg.com/profile_banners/994414848321634305/1701363735/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 2177354, "creator": true, "nsfw_acceptable": false, "accept