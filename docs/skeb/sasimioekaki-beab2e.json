93\u3067\u3057\u307e\u3063\u305f\u30a8\u30a2\u30b7\u30e3\u30ab\u30fc\u30eb\u306e\u6f2b\u753b\u3092\u304a\u9858\u3044\u3057\u307e\u3059\uff01\n\n1.\u30bf\u30ad\u30aa\u30f3\u306b\u300c\u85ac\u3092\u98f2\u3093\u3067\u304f\u308c\u306a\u3044\u304b\u300d\u3068\u983c\u307e\u308c\u308b\u304c\u3001\u30b7\u30e3\u30ab\u30fc\u30eb\u306f\u65ad\u308b\u3002\n2.\u3059\u308b\u3068\u30bf\u30ad\u30aa\u30f3\u306f\u7121\u7406\u77e2\u7406\u30b7\u30e3\u30ab\u30fc\u30eb\u306b\u85ac\u3092\u98f2\u307e\u305b\u308b\u3002\n3.\u30b7\u30e3\u30ab\u30fc\u30eb\u306f\u54b3\u8fbc\u307f\u3059\u308b\u304c\u3001\u305d\u306e\u6642\u4f53\u306b\u7570\u5909\u304c\u8a2a\u308c\u308b\u3002\n4.\u4f53\u304c\u3069\u3093\u3069\u3093\u7e2e\u3093\u3067\u3044\u304d\u30012\u982d\u8eab\u306b\u306a\u308b\u3002\n5.\u30bf\u30ad\u30aa\u30f3\u306f\u9762\u767d\u304c\u3063\u3066\u3044\u308b\u304c\u3001\u30b7\u30e3\u30ab\u30fc\u30eb\u306f\u6012\u3063\u3066\u30bf\u30ad\u30aa\u30f3\u306e\u8db3\u3092\u8e74\u308b\u3002\n6.\u30bf\u30ad\u30aa\u30f3\u306f\u30cb\u30e4\u30ea\u3068\u5fae\u7b11\u307f\u3001\u30b7\u30e3\u30ab\u30fc\u30eb\u3092\u62b1\u3063\u3053\u3057\u3066\u3001\u6b8b\u308a\u306e\u85ac\u3092\u5168\u3066\u98f2\u307e\u305b\u308b\u3002\n7.\u30b7\u30e3\u30ab\u30fc\u30eb\u306f1.5\u982d\u8eab\u306b\u7e2e\u3093\u3067\u3057\u307e\u3044\u3001\u8eab\u52d5\u304d\u304c\u53d6\u308c\u306a\u304f\u306a\u308b\u3002\u30bf\u30ad\u30aa\u30f3\u306f\u30b7\u30e3\u30ab\u30fc\u30eb\u3092\u624b\u306e\u3072\u3089\u306b\u4e57\u305b\u3001\u7b11\u3063\u3066\u3044\u308b\u3002\n\n\u5099\u8003\n\u30fb2\u4eba\u306e\u8863\u88c5\u306f\u4efb\u305b\u307e\u3059\u3002\n\u30fb\u80cc\u666f\u306b\u6307\u5b9a\u306f\u306a\u3044\u306e\u3067\u3001\u7121\u3057\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\n\u30fb\u30da\u30fc\u30b8\u6570\u306e\u6307\u5b9a\u3082\u3042\u308a\u307e\u305b\u3093\u3002\n\u30fb\u8272\u306e\u5e0c\u671b\u306f\u30ab\u30e9\u30fc\u3067\u3059\u304c\u3001\u3069\u3046\u3057\u3066\u3082\u306e\u5834\u5408\u306f\u767d\u9ed2\u3067\u69cb\u3044\u307e\u305b\u3093\