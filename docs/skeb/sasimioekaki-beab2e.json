c\u3092\u6012\u308b\u3002\n6.\u30de\u30ad\u30de\u306f\u5e30\u9084\u3092\u547d\u4ee4\u3059\u308b\u304c\u3001\u30d1\u30ef\u30fc\u306f1\u4eba\u3067\u60aa\u9b54\u3092\u5012\u305d\u3046\u3068\u3059\u308b\u3002\n7.\u30d1\u30ef\u30fc\u306f\u30cf\u30f3\u30de\u30fc\u3092\u632f\u308a\u4e0b\u308d\u3057\u3001\u60aa\u9b54\u306b\u30af\u30ea\u30c6\u30a3\u30ab\u30eb\u30d2\u30c3\u30c8\u3057\u3001\u60aa\u9b54\u306f\u3084\u3089\u308c\u308b\u304c\u3001\u305d\u306e\u969b\u306b\u5927\u91cf\u306e\u7c98\u6db2\u3092\u5674\u51fa\u3059\u308b\u3002\n8.\u30d1\u30ef\u30fc\u306f\u907f\u3051\u308c\u305a\u6d74\u3073\u3066\u3057\u307e\u3044\u3001\u30de\u30ad\u30de\u306f\u3066\u3061\u3066\u3061\u9003\u3052\u3088\u3046\u3068\u3059\u308b\u304c\u3001\u8db3\u304c\u77ed\u304f\u3066\u7c98\u6db2\u306b\u8ffd\u3044\u3064\u304b\u308c\u308b\u3002\n9.2\u4eba\u306e\u4f53\u304c\u7e2e\u3093\u3067\u3057\u307e\u3044\u30012\u4eba\u3068\u30821.5\u982d\u8eab\u306b\u3002\n\u304c\u3063\u304b\u308a\u3059\u308b\u30d1\u30ef\u30fc\u3068\u3001\u66f4\u306b\u5c0f\u3055\u304f\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u3053\u3068\u306b\u7d76\u671b\u3059\u308b\u30de\u30ad\u30de\u3002\n\n\u5099\u8003\n\u30fb2\u4eba\u306e\u8863\u88c5\u306f\u4efb\u305b\u307e\u3059\u3002\n\u30fb\u80cc\u666f\u306f\u8857\u4e2d\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u30fb\u30da\u30fc\u30b8\u6570\u306e\u6307\u5b9a\u3082\u3042\u308a\u307e\u305b\u3093\u3002\n\u30fb\u8272\u306e\u5e0c\u671b\u306f\u30ab\u30e9\u30fc\u3067\u3059\u304c\u3001\u3069\u3046\u3057\u3066\u3082\u306e\u5834\u5408\u306f\u767d\u9ed2\u3067\u69cb\u3044\u307e\u305b\u3093\u3002\n\n2\u982d\u8eab\u306b\u306a\u3063\u305f\u6642\n\u30fb\u820c\u8db3\u3089\u305a\u306b\u306a\u308a\u307e\u3059\n\u30fb\u982d\u304c\u307e\u3093\u4e38\u3067\u3001\u5927\u304d\u3044\u3067\u3059\u3002\n\u30fb\u624b\u8db3\u306f\u3068\u3066\u3082\u77ed\u304f\u592a\u304f\u3001\u3082\u3061\u3082\u3061\u3057\u3066\u307e\u3059\u3002\n\u30fb\u9854\u306f\u5909\u308f\u308a\u307e\u305b\u3093\u304c\u3001\u9f3b\u306f\u7121\u304