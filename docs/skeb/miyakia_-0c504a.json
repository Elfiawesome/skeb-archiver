イル\nまたは背景が透過されたPNG形式を希望します\n\n◆資料\nhttps://drive.google.com/drive/folders/1lHD_tMeymIpNBmwRVPlzgh5veMvJypxq?usp=drive_link　\n\n沢山リクエストしてしまい申し訳ありません！\nお忙しいかと存じますが何卒よろしくお願いいたします！\n\n狼月蒼\n\nhttps://drive.google.com/drive/folders/1lHD_tMeymIpNBmwRVPlzgh5veMvJypxq?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyakia_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2780787, "client_id": 3762214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87587e0d/uploads/origins/d5d24a64-9c2d-434d-bbd0-9bcfb9c7e0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ca6f25baf590e6cf7e6dd21f30e084e", "srcset": "https://si.imgix.net/87587e0d/uploads/origins/d5d24a64-9c2d-434d-bbd0-9bcfb9c7e0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ca6f25baf590e6cf7e6dd21f30e084e, https://si.imgix.net/87587e0d/uploads/origins/d5d24a64-9c2d-434d-bbd0-9bcfb9c7e0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca9353a181ad4b8f717b4174317cf67f 2x, https://si.imgix.net/87587e0d/uploads/origins/d5d24a64-9c2d-434d-bbd0-9bcfb9c7e0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca5c6728f0a0c36b7e4927aa2f2f86d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87587e0d/uploads/origins/d5d24a64-9c2d-434d-bbd0-9bcfb9c7e0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d14ec41ba59373cfcf4821b6dabaf5a", "srcset": "https://si.imgix.net/87587e0d/uploads/origins/d5d24a64-9c2d-434d-bbd0-9bcfb9c7e0a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d14ec41ba59373cfcf4821b6dabaf5a, https://si.imgix.net/87587e0d/uploads/origins/d5d24a64-9c2d-434d-bbd0-9bcfb9c7e0a9?bg=%23fff&auto=format%2Ccompress&fm=we