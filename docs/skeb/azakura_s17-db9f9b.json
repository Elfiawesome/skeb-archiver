\n身長　160cm\nバスト　D\n髪の色　#FF9700\n目の色　#7159A6\nhttps://hub.vroid.com/characters/4921369108043309203/models/7567822644843755198\n\n二人は仲良しのクラスメート（付き合ってはいないが…？）の関係\n見た目とのギャップがあり、真面目そうなのにえ〇ちなことに興味津々なおちゃ子と、ギャルなのに初心なげんまいちゃん\n\n制服の中には下着の代わりに（インナーとして）スク水を着ているのが特徴です\nスク水は一般的な紺色のワンピースタイプ(旧スクor競スク肩紐白)、脚刳りのラインはノーマルorローレグです\n※スク水はセパレート型やスパッツ型、ハイレグ化、魔改造はNGでお願いします\n\n\nうちの子のどちらか興味を持たれた方のスク水姿のイラストをお願いしたいです\n水着なので一応NSFWをONにしています\n・制服のリボンタイは付けたまま\n・ブラウスのボタン全開で二の腕～肘のあたりまでずらしはだけさせるorブラウスは脱いだ状態（周囲に脱ぎっぱなしになっていると◎）\n・ニーソックス着用\n・片手でスカートをたくし上げてスク水越しの透けへそを見せる\n・おちゃ子の場合は羞恥心一切なし、げんまいちゃんの場合は恥ずかしさ全開な表情\n\n自撮りシチュでもいいですし、誰かに直接見せつけているシチュでも、その他細かいところはお任せします\nもし可能であれば制服を完全キャストオフしたリボンタイ＋スク水＋ニーソだけの姿もお願いできればと思います\n\n\nご検討いただけますと幸いです\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1WXtAronudqbRJ-GBEbeIB7f9OtVBWU9G?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@azakura_s17/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3303387, "client_id": 2053984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92d032ac/uploads/origins/cbfbc1f5-9ad0-4858-a4a3-8e86ce5d639a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=825faad7b0b7741b3d9f2f3991c01900", "srcset": "https://si.imgix.net/92d032ac/uploads/origins/cbfbc1f5-9ad0-4858-a4a3-8e86ce5d639a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=825faad7b0b7741b3d9f2f3991c01900, https://si.imgix.net/92d032ac/uploads/origins/cbfbc1f5-9ad0-4858-a4a3-8e86ce5d639a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10668dc8fb95ead2c73015fa3031aa70 2x, https://si.imgix.net/92d032ac/uploads/origins/cbfbc1f5-9ad0-4858-a4a3-8e86ce5d639a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c00949c0ef898a16c8da954d42a7495 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "