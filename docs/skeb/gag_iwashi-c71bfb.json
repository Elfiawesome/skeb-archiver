on.net/Gazimonガジモンもラスティーと同様に目標を持っている。種族が持つ悪評から逃れたいという願いだ。彼はラスティーのようにタフで、ラスティーが絆を築いた唯一の存在である。より陽気で、ラスティーの目標達成を心から応援している。歯を見せてニヤリと笑うのが好きだ！\n\nこの関係性を表現したイラストをお願いします。両キャラクターが視聴者の方を向いている構図でお願いします。お時間をいただきありがとうございます、がぐさん！ https://drive.google.com/drive/folders/1RZlYZEVFjN1Y2Sh0kCeMNCniJ25my93H", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gag_iwashi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3542019, "client_id": 3870444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9c89189/uploads/origins/0989a530-64e2-4049-819e-6bc86182a655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24daed9f604b6dd606b109ae232cdf4c", "srcset": "https://si.imgix.net/d9c89189/uploads/origins/0989a530-64e2-4049-819e-6bc86182a655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24daed9f604b6dd606b109ae232cdf4c, https://si.imgix.net/d9c89189/uploads/origins/0989a530-64e2-4049-819e-6bc86182a655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4e9c0039550ab27cf1c9dcdbe0d6efa 2x, https://si.imgix.net/d9c89189/uploads/origins/0989a530-64e2-4049-819e-6bc86182a655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=673cf731232bd72829bef2fa852b1bd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9c89189/uploads/origins/0989a530-64e2-4049-819e-6bc86182a655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8f8362e3b87c57d2565493b776e9033", "srcset": "https://si.imgix.net/d9c89189/uploads/origins/0989a530-64e2-4049-819e-6bc86182a655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8f8362e3b87c57d2565493b776e9033, https://si.imgix.net/d9c89189/uploads/origins/0989a530-64e2-4049-819e-6bc86182a655?bg=%23fff&auto=format%