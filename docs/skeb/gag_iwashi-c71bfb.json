ttps://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8493ded3c70b2af52831d06d5d2b7c2", "srcset": "https://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8493ded3c70b2af52831d06d5d2b7c2, https://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bee0020949882ac3649adc2a56ed93a6 2x, https://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=956baa65788bb8a73965c9d3d4a01116 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cde30ca1516430802d8dacd50d5c9f9", "srcset": "https://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cde30ca1516430802d8dacd50d5c9f9, https://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6b1ee0273ae1fac3113ae57ad0810f2 2x, https://si.imgix.net/666f2436/uploads/origins/ee75bb1d-f5e3-4d78-8ef9-70e530282a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0746dc8e9c6122127dcb86cd3adc213b 3x"}, "body": "こちらでは初めまして、藤和です。\nいつもお世話になっております。\nたびたびお話ししておりますが、デジモンリコレクション、デジモンブルームが大好きです。\nよろしくお願いします。\n\n本題ですが、今回は自創作キャラの市来 悠歌（いちらい はるか）とガジモンのイラストをリクエストしたいです。\n悠歌は145cmの26歳、身長は低いですが内面的にはお姉ちゃんタイプの明るくてしっかり者、\n世話焼きで友達から「ママ」とか「おかん」とか呼ばれて怒るような感じのキャラです。\n胸は巨乳ではないもののそれなりにあります。\nガジモンはガブモンのような二足でしっかり立つ生き物ではなく、四足タイプか、二足でもドルモンのような前傾姿勢を取る、より動物的な生き物のイメージで描いてほしいです。\n\nイラストの構図自体はおまかせで、悠歌とガジモンがなかよくじゃれあっている（または一方が一方にじゃれついている）ようなイメージでお願いします。\n例としては、悠歌の後ろからガジモンが肩に足を掛けて肩車のような形で頭に寄りかかっている、悠歌がガジモンを胸にだっこしている、悠歌が座っている横からガジモンがちょっかいを掛けている、ごろんとしているガジモンを悠歌がもふっている、などのイメージです。\n服装についても自由にアレンジして問題ありません。\n\n以上です。描いていただけるとうれしいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1CTSpgATEX2E6660KdU_IVU_80ESSoiwj?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gag_iwashi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3542019, "client_id": 2585969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21c590f5/uploads/origins/b8d99ddd-6488-4305-b003-813bcb6b23a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=944df152d50e07cf8c8ff8702d406cb0", "srcset": "https://si.imgix.net/21c590f5/uploads/origins/b8d99ddd-6488-4305-b003-813bcb6b23a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=944df152d50e07cf8c8ff8702d406cb0, https://si.imgix.net/21c590f5/uploads/origins/b8d99ddd-6488-4305-b003-813bcb6b23a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afec667c0516a05427561d997fce25d6 2x, https://si.imgix.net/21c590f5/uploads/origins/b8d99ddd-6488-4305-b003-813bcb6b23a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c71b9e8d3cb5672413c9ce71a52304b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21c590f5/uploads/origins/b8d99ddd-6488-4305-b003-813bcb6b23a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28ddd9c15843039652802a0485a5dfc5", "srcset": "https://si.imgix.net/21c590f5/uploads/origins/b8d99ddd-6488-4305-b003-813bcb6b23a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28ddd9c15