おたえちゃんに好意を向けられたいので、パートナーの一人称視点にしてほしいのですが、パートナー自身の性別や体格などには拘りがないので描きやすい内容で大丈夫です。\n\n・花園たえの服装\n襟を引っ張るようにして胸を見せてほしいので、襟元が開く服装で、\nアプリ版カードの【上手にできるかな？】【学園祭のお味は？】【うさぎに見えるもの】のような私服をイメージしています。\n\n以上で、仮に工数が多くなりそうでしたら金額の変更をお願いします。\n長文でまとまらない内容になってしまい、申し訳ありません。\nご検討をよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@26_t_s_26/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1293548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bb2c365/uploads/origins/1b2194f9-f4e7-47dc-ae9f-96926bffb715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b588c1105a98c957a51ac1e495edf5", "srcset": "https://si.imgix.net/7bb2c365/uploads/origins/1b2194f9-f4e7-47dc-ae9f-96926bffb715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b588c1105a98c957a51ac1e495edf5, https://si.imgix.net/7bb2c365/uploads/origins/1b2194f9-f4e7-47dc-ae9f-96926bffb715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0da348084e80be664a36dd054dbe69c4 2x, https://si.imgix.net/7bb2c365/uploads/origins/1b2194f9-f4e7-47dc-ae9f-96926bffb715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9de4d8bc629e3d12f28b0ecea536ced6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bb2c365/uploads/origins/1b2194f9-f4e7-47dc-ae9f-96926bffb715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1cdc95358524a1a86bac3b5715c4e69", "srcset": "https://si.imgix.net/7bb2c365/uploads/origins/1b2194f9-f4e7-47dc-ae9f-96926bffb715?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1cdc95358524a1a86bac3b5715c4e69, https://si.imgix.net/7bb2c365/uploads/origins/1b2194f9-f4e7-47dc-ae9f-96926bffb715?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=2