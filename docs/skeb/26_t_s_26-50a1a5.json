0-b1bb91e2b891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05ea45ae1fdd3f4cdcab801dbfc34153 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc333ef1/uploads/origins/b0674f01-d7c1-4116-b8f0-b1bb91e2b891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40474ca2d55046ae9d3c06b914321ccc", "srcset": "https://si.imgix.net/dc333ef1/uploads/origins/b0674f01-d7c1-4116-b8f0-b1bb91e2b891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40474ca2d55046ae9d3c06b914321ccc, https://si.imgix.net/dc333ef1/uploads/origins/b0674f01-d7c1-4116-b8f0-b1bb91e2b891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=177211aba0a061e4336df4f2cff62eee 2x, https://si.imgix.net/dc333ef1/uploads/origins/b0674f01-d7c1-4116-b8f0-b1bb91e2b891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8de6f0eac7c68cdcf4f28b56be865d62 3x"}, "body": "Extreme Heartsの\n小日向理瀬ちゃんと小鷹咲希ちゃんの漫画をお願いします。\n\n三部くらいの構成です。\nページ数お任せします。\n工数多いと思うのでラフで大丈夫です。\n\n【1】駅のホームで待ち合わせして出会う二人\n初夏（半袖で過ごせるくらい）で、試験があって学校が早く終わる時期。\n勉強もあるので、芸能事務所のお仕事はお休みで、\n試験の最終日に、二人は待ち合わせをして、一緒に遊ぶ。\n自販機でジュースを買って飲みながら、試験どうだった？とか\n先輩たちどうしてるかな？とか話しながら、\nせっかくの休み、思い切り遊ぶぞ！と二人は意気込む。\n\n【2】カラオケやゲームセンターで遊ぶ\nスポーツもあるけど、本気になっちゃうからダメ！と笑う二人。\nカラオケでは、個室で二人きりだとちょっとドキドキするね、とか\n理瀬が言うので、やめてよ～！と咲希。\nもじもじしながらデュエットする二人、結局慣れてきて思い切り楽しむ二人。\nゲームセンターのほうでは、\n音ゲーしたり麻雀したりプライズをとったり\nちょっと外に出てカップアイスをシェアしたり。\n\n【3】帰りの道中で食べ物を買って、座って休みながらゆっくり話す二人\n歩きながら食べるのも行儀悪いので公演のベンチとかに座ってる感じで。\n理瀬がおずおずと咲希に揃いのものをプレゼントをして\n大切にしてね、と理瀬。\nちょっと重いよ～！となる咲希。\n\nという感じで、ひとときの記念品ができたりして。\nやっぱり重いよってからかわれたりして。\n【了】\n\nぶろ先生が書いている漫画と解釈が異なるようだったら\n先生自身や過去作のほうの解釈に合わせてもらって大丈夫です。\n\nおよそ\n「咲希と理瀬が休みの日にゲーセン行って遊ぶ」内容であればいいので……。\nむしろ二人きりじゃなくて、他キャラも出していただいてもう全然大丈夫です。\nいっぱいキャラがいるとうれしいので。\nみんなで今年の夏もがんばるぞＥＮＤもいいよね……。悩む～。\n【3】のオチもパッと考えたものなので、変えていただいて大丈夫です。\n\n検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@26_t_s_26/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1293548, "client_id": 259704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2aed276cbd8b01c9728419072fde522", "srcset": "https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2aed276cbd8b01c9728419072fde522, https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e39c4a5e413216531eaa81df31de4803 2x, https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53575f5a5fba6f813313a5c156fd63bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7d6ae49a3dd8305b54a5a4b6724ca2c", "srcset": "https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7d6ae49a3dd8305b54a5a4b6724ca2c, https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59754e5ec4e169017f454e7b5e9e1ffa 2x, https://si.imgix.net/97a780d9/uploads/origins/dd518b46-4ec7-4484-bded-30bb814242c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2cd300b2850779bba1b8977a0e911ac 3x"}, "body": "Lostorage incited WIXOSSの、穂村すず子ちゃんのイラストをお願いします！！\n\nぶろさんのサインが入ってるとうれしいので、差し支えなければ書いていただけるとうれしいです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@26_t_s_26/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1293548, "client_id": 259704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8940dbbc0270be8b762c9a2aa7accfe", "srcset": "https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8940dbbc0270be8b762c9a2aa7accfe, https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e8ad1b6fd01b9734ff64ae3284021c4 2x, https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae724d93ea2b54e5e09bf620aa5bbc9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f5584fdf5f090637e3afa560175db2", "srcset": "https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03f5584fdf5f090637e3afa560175db2, https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0558284d58fb5f2ae1022df19b21f380 2x, https://si.imgix.net/a4ba2576/uploads/origins/9c8aaf6c-15c7-45ef-ac2f-d3e08d11b677?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97ac1e491174727de681c866e32fbfdb 3x"}, "body": "【前文】\nはじめまして。\nナース服でうどんをこねる咲希ちゃんのイラストを見て\nあなたの絵柄に一目惚れしてから、\nXやpixivに投稿されるイラストを\nずっと楽しませていただいています。\n\n絵柄は、目を引くパッチリお目目と\n主線の強弱で出る陰影感が好きです。\n\nナースうどん以外だと、\nスク水とかスク水とかお弁当箱のイラストも好きです。\nあとskebのスタビの漫画よかったです。ありがとう……。\n\n【リクエストの内容】\nX（SNS用）のアイコンをお願いしたいです。\n自分のXアカウントで使うためのもので、\n予定としては、24年4月中のアイコンにしたいです。\n\n作品：アブソリュート・デュオ\nキャラクター：ユリエ・シグトゥーナ\nでお願いします。\n\n以下、構図・シチュエーションです。\n\n・裸+長袖Yシャツ（第一、第二ボタンまで開けて、そこから下は留める）の姿で、\n　はだけすぎないように、鎖骨が出るくらいの露出でお願いします\n　（構図の都合で、鎖骨が見えない場合でも大丈夫です。）\n\n・床に座って、両腕で枕を抱いている\n　（カバーの柄は無地+基本色は青系統でお願いします）\n　（下半身･脚は画角に入っていなくても大丈夫です）\n　（身体の向きの指定はありません。描きやすいものでお願いします）\n\n・ハーフアップツインの髪型が好きなので、\n　ユリエの制服時のような、リボンで結った髪型でお願いします\n\n・表情は「羨ましい・嫉妬している・拗ねている」あたりの表情で、カメラに目線をお願いします\n・全体の印象として、できるだけ攻撃的にならない表情でお願いします。漫符のような記号を使ってもいいです\n・顔の向きや、アオリ俯瞰等のアングルの指定はありません\n\n・背景は、普段使われている、ポップなパターン柄やグラデーションのようなシンプルなものでお願いします\n\n・もし、可能であれば、\n　目を閉じた表情の差分（すやすやと眠っているような）があると嬉しいです。\n\n以上です。\n長くなりましたが、ご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@26_t_s_26/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1293548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53206d2b/uploads/origins/e5b8ff29-e629-4101-aa95-01dabd6da513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7e09562257dce141c1fdebb1f64f071", "srcset": "https://si.imgix.net/53206d2b/uploads/origins/e5b8ff29-e629-4101-aa95-01dabd6da513?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7e09562257dce141c1fdebb1f64f071, https://si.imgix.net/53206d2b/uploads/origins/e5b8ff29-e629-4101-aa95-01dabd6da513?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1418b986ebe01ddba710f8f724ce0b3c 2x, https://si.imgix.net/53206d2b/uploads/origins/e5b8ff29-e629-4101-aa95-01dabd6da513?bg=%