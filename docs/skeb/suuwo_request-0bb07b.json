しい雰囲気だと嬉しいです。\nまた、活動での使用を考えていますので、見切れないようにお願いいたします。\n\n【納品形式について】\n人物と背景がレイヤー分けされているpsdファイルか、人物のみの透過ファイルを納品していただけると嬉しいです。\nまた、金額内で可能であれば表情差分をいただけますと幸いです。\n\nお忙しい中恐縮ですが、ご検討のほどよろしくお願いいたします。\n\nしきぴす\n\nhttps://drive.google.com/drive/folders/1tfLOwHj_4EDyXp2z_abQhJ_HOdGxiphB?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suuwo_request/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7da753f2/uploads/origins/335ea1bd-6184-455c-92a4-6c5f79ae4079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52e42fa40e3ce44f8d124cb4bb4d53b3", "srcset": "https://si.imgix.net/7da753f2/uploads/origins/335ea1bd-6184-455c-92a4-6c5f79ae4079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52e42fa40e3ce44f8d124cb4bb4d53b3, https://si.imgix.net/7da753f2/uploads/origins/335ea1bd-6184-455c-92a4-6c5f79ae4079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39f221618c5c4952b34a1ce016a2e47f 2x, https://si.imgix.net/7da753f2/uploads/origins/335ea1bd-6184-455c-92a4-6c5f79ae4079?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0e3777454fd01eb166e0cd29c18cd81 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3861660, "nc": 128}, {"path": "/@suuwo_request/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3861660, "client_id": 2560972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea96391b/uploads/origins/2fe1ba6f-1b86-40b1-8b5e-d941b