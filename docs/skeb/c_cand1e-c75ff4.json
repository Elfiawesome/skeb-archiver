せん！\n御検討よろしくお願い致します。\n\nhttps://twitter.com/totomori_haco/status/1419980858635685891?s=21", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 749808, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いろせ氏@春例 の14a", "screen_name": "rrr97_", "avatar_url": "https://pbs.twimg.com/profile_images/2029274296259100675/hM404AhE.png", "header_url": "https://pbs.twimg.com/profile_banners/3003310171/1737316322/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 17}, {"id": 861621, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ハローチキン", "screen_name": "198_298_398", "avatar_url": "https://pbs.twimg.com/profile_images/1642157805078728708/6wgAeOx7.png", "header_url": "https://pbs.twimg.com/profile_banners/1302583169980399616/1737522207/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1232126, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "のろヰ", "screen_name": "rnatataki", "avatar_url": "https://pbs.twimg.com/profile_images/1137491982404603906/iRcXCVNY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/842278046748966912/1747861467/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id": 1251276, "creator": true, "nsfw_acceptable": false, "ac