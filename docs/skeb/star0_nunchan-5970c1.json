ix.net/089fa71f/uploads/origins/e5da6222-a3d5-4d1c-9129-4203baa35a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15e1165c44fe1429b3606f140293263a, https://si.imgix.net/089fa71f/uploads/origins/e5da6222-a3d5-4d1c-9129-4203baa35a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d68a0e580a026c34af11acb68663cd5 2x, https://si.imgix.net/089fa71f/uploads/origins/e5da6222-a3d5-4d1c-9129-4203baa35a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd00836821f10d08fc92694120d0a42c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/089fa71f/uploads/origins/e5da6222-a3d5-4d1c-9129-4203baa35a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a9e2c7526731b822d97a5e0c88377e", "srcset": "https://si.imgix.net/089fa71f/uploads/origins/e5da6222-a3d5-4d1c-9129-4203baa35a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a9e2c7526731b822d97a5e0c88377e, https://si.imgix.net/089fa71f/uploads/origins/e5da6222-a3d5-4d1c-9129-4203baa35a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b5ec3ab3b80fa6bab19e530417bfcd 2x, https://si.imgix.net/089fa71f/uploads/origins/e5da6222-a3d5-4d1c-9129-4203baa35a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8edc0c768f293e2cc138635b1d1d3386 3x"}, "body": "はじめまして！個人vtuberのしだはらしょうこと申します\nTwitterにて星丸様のイラストを拝見して、是非依頼したく連絡差し上げました\n\n描いてほしいのは私自身です\nコーヒー系vtuberとして活動しており\nそれに絡めたイラストを描いていただきたいです\n\nカフェのカウンター内で、\n制服でコーヒーを作っている姿を\n真面目な表情でコーヒーに向き合っている様子でお願いしたいです\n構図等はお任せいたします\n\nまた、イラストの使用に関して\n個人での鑑賞の他、動画のサムネイルや素材にも使用させていただきたく、\n背景を透過したものか、段階に分かれたPSDがいただけると幸いです\n\nもしそういった二次使用が厳しいようならキャンセルしてください\n\n是非、ご検討よろしくお願いいたします\n\nhttps://twitter.com/shidahara_shoko/status/1542057123923668992?s=46&t=-MW4cIsiElQRfJRxfTj0tA", "nc": 1, "word_count": 0, "transcoder"