ー！」と構えており、\n　ミミッキュも一緒に並んで驚かそうとしているイメージ。\n・背景などについてはお任せでお願いできたらと思います！\n・レイヤー分けなどについては特に指定はありません。\n・サイズについては可能であれば横長(1600:900)だと嬉しいです！\n\n\n(オリジナルキャラ「しろ」のデザインはこちらを参考にしていただければと思います！)\nhttps://skeb.jp/@kou_hiyoyo/works/612\nhttps://skeb.jp/@tsuknak1/works/22\n\n【使用用途】\n動画のサムネイルや、動画内のシーンチェンジで使用したいと思います。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@merugamu_melgum/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1635843, "client_id": 1725769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d76a3340/uploads/origins/fd7cea76-6067-4064-95e0-743982a7ac19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b9b3fd95811f6a5a0d3d1c5628fa422", "srcset": "https://si.imgix.net/d76a3340/uploads/origins/fd7cea76-6067-4064-95e0-743982a7ac19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b9b3fd95811f6a5a0d3d1c5628fa422, https://si.imgix.net/d76a3340/uploads/origins/fd7cea76-6067-4064-95e0-743982a7ac19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40fe26fc1ae7c84829b9cd9aa2d2e167 2x, https://si.imgix.net/d76a3340/uploads/origins/fd7cea76-6067-4064-95e0-743982a7ac19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fba771b8d8d7f0ae71a811363e5ef2c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d76a3340/uploads/origins/fd7cea76-6067-4064-95e0-743982a7ac19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4db14d18bf362682497a9ca1ef3dba60", "srcset": "https://si.imgix.net/d76a3340/uploads/origins/fd7cea76-6067-4064-95e0-743982a7ac19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4db14d18bf362682497a9ca1ef3dba60, https://si.imgix.net/d76a3340/uploads/origins/fd7cea76-6067-4064-95e0-743982a7ac19?bg=%23f