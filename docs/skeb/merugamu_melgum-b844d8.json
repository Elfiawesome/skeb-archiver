g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c197ac26cbe5277b24c9f7befaa9d5c8", "srcset": "https://si.imgix.net/a8e90371/uploads/origins/b161ced4-3bea-4dae-bc43-e8a1c0b2ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c197ac26cbe5277b24c9f7befaa9d5c8, https://si.imgix.net/a8e90371/uploads/origins/b161ced4-3bea-4dae-bc43-e8a1c0b2ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0fd93ad9b612acf1106b2b8af3dc7a4 2x, https://si.imgix.net/a8e90371/uploads/origins/b161ced4-3bea-4dae-bc43-e8a1c0b2ee4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d30d397ff5fce541baf7f92de1269dc 3x"}, "body": "はじめまして！個人VTuberをしているみさき千夏と申します。\n初めてですがリクエストお願いします！\n\n【依頼内容】\n麻雀配信のサムネで使用できるイラストをお願いします。\n服装は資料の２（チャイナ服）に合わせてポーズは先生のお好きに描いていただいて大丈夫です。\n\n先生の過去のご依頼の\nhttps://skeb.jp/@merugamu_melgum/works/11\nこちらの雰囲気に似てる感じだとありがたいです。\n\nご縁があれば嬉しいです。\n\n主にサムネで使用したいので頭や髪の先が切れていない透過版も頂けますと助かります！\n（サムネの構図的には切れていても大丈夫です）\n16:9の比率でキャラクターと背景はレイヤーをわけてください。\n\n何卒よろしくお願いいたします。\n\n【使用用途】\n・YouTube/X/Twitchなど各種SNSでの利用。（メン限含む）\n・グッズ使用(可能なら)\n\n【キャラクター資料】（２.チャイナをご参照ください）\nhttps://drive.google.com/drive/folders/1KLAQpv_vUtlvLJhnOxMDm04IEvqvfvhE?usp=sharing\n\n資料URLのみさき千夏Twitterの固定ツイートにもイラストがあります。\n\n何卒宜しくお願い致します。\n\nhttps://x.com/ChinatsuMisaki/status/1852333639243366711", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@merugamu_melgum/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1635843, "client_id": 386703, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f6eba648ec5ac7e878e948ea75b2f54", "srcset": "https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f6eba648ec5ac7e878e948ea75b2f54, https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ecbc3e142f7b9cadb3cdcd3f3940cc7 2x, https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8ed374a3dd7b4c2e448af0f8e43d120 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8bc84f5dc729bf2b909299a9b647105", "srcset": "https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8bc84f5dc729bf2b909299a9b647105, https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b2953c1cf312e8a97e0717e414bfb54 2x, https://si.imgix.net/c1cbe3a5/uploads/origins/f283acf9-5bf0-4045-be38-4033d293947b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84a6009b22e16193153090b93eda9e08 3x"}, "body": "はじめまして、有朱夷（ありすい）リリエルと申します！\nYouTubeでVTuber活動をさせていただいており、\n主にポケモン関係のゲームの配信や動画作成をしております。\nサムネイル画像や待機画面等に使用するイラストが欲しいと思い\nご依頼させていただきました。\n\n▼私がメルガムさんを知ったきっかけ\nトップの新着に表示され、アニメ調で少しデフォルメちっくなかわいいイラストで、とっても目を惹かれました！\nそこから他の作品も拝見しまして、ぜひ自分の姿も描いてもらいたい‼︎と思いました。\n\n▼有朱夷リリエルについて\n「こんりりん～悪魔でウサギのリリエルです」\n人間界で信徒を作るため活動している悪魔。正体はリリス。\nリスナーはみなリリン(我が子)として、優しくも厳しく接し見守っている。\nリリエルという名前は、元は楽園に居たことの示唆。\n苗字は日本で活動するために作った。好きな色と画数(666)を意識している。\n\n参考資料: https://x.com/liliel_ovo/status/1742231750053634135?s=46&t=HLppYdwom-j8eXt4l9KYlg\nまた、今までにリクエストしたイラストもご参考になさってください。\nhttps://skeb.jp/@liliel_OvO\n\n▼リクエスト内容\nポケモンユナイトというゲームをプレイしていて、私は主にグレイシアとミュウを選びます。\n私とこの2匹が映ったイラストをお願いしたいです。\n可能であれば、下記イメージのような『戦おう！』『行くぞ！』みたいな感じの構図をお願いしたいです。\n複数体でのリクエストのためもし金額が不足に感じられたり、\n構図が難しいなどありましたら、再送要請をお願いいたします！\nお手数ですがよろしくお願いいたします。\n\nイメージ: https://drive.google.com/drive/folders/17R-FCCEMiDW9GUltyJYNezmxGyMwnQc9?usp=sharing\n\n▼使用用途\nサムネイル、立ち絵等\n(可能であれば、上・左右（うさ耳、悪魔の羽、ポケモンたちの体など）は見切れないようにしていただけると嬉しいです)  \n\n▼納品形式\n可能なら全体のイラストとともにPSDか透過PNGもいただきたいです。\nサムネイルに使用する際、背景透過のpngや、各キャラ別で使うことがあります。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@merugamu_melgum/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1635843, "client_id": 1190699, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03814f8f/uploads/origins/cb737f62-c5ac-4960-a74d-3a2d40cce998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75bee6010dad643a081597e070bf06fd", "srcset": "https://si.imgix.net/03814f8f/uploads/origins/cb737f62-c5ac-4960-a74d-3a2d40cce998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75bee6010dad643a081597e070bf06fd, https://si.imgix.net/03814f8f/uploads/origins/cb737f62-c5ac-4960-a74d-3a2d40cce998?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f75e72d8ae15e58d13dbc86dd88f0cc0 2x, https://si.imgix.net/03814f8f/uploads/origins/cb737f62-c5ac-4960-a74d-3a2d40cce998?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89601dbf82c84859c42358529365e51e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03814f8f/uploads/origins/cb737f62-c5ac-4960-a74d-3a2d40cce998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd9807ca23fbc35fe921b1bebb8e4f4", "srcset": "https://si.imgix.net/03814f8f/uploads/origins/cb737f62-c5ac-4960-a74d-3a2d40cce998?bg=%23fff&auto=for