です。\n\nなお描いて頂きましたイラストは、YouTubeのサムネイルやTwitter等で使用させて頂きたいと思っております。\nその為、髪の毛や頭の先が切れていないように描いて頂けますと幸いです。\nまたできればキャラクターのみの透過でも使用できるように、PSDデータでキャラクターのレイヤーが分かれた状態で頂けますと、本当にありがたいです…！\n\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@merugamu_melgum/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1635843, "client_id": 1045250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da8d83af/uploads/origins/29e48ae9-c41a-441e-a402-7f65f0fb7a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6edd37591de314ccc4f299670e2b07", "srcset": "https://si.imgix.net/da8d83af/uploads/origins/29e48ae9-c41a-441e-a402-7f65f0fb7a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6edd37591de314ccc4f299670e2b07, https://si.imgix.net/da8d83af/uploads/origins/29e48ae9-c41a-441e-a402-7f65f0fb7a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3045f3c59cbeb4326ff97968dc28a5da 2x, https://si.imgix.net/da8d83af/uploads/origins/29e48ae9-c41a-441e-a402-7f65f0fb7a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d11de0f8ad3fe980a38069f23bb8ef05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da8d83af/uploads/origins/29e48ae9-c41a-441e-a402-7f65f0fb7a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88f713f1c5cf3e84259fe2e4130f71c1", "srcset": "https://si.imgix.net/da8d83af/uploads/origins/29e48ae9-c41a-441e-a402-7f65f0fb7a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88f713f1c5cf3e84259fe2e4130f71c1, https://si.imgix.net/da8d83af/uploads/origins/29e48ae9-c41a-441e-a402-7f65f0fb7a8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=270ad7d04c6e72a9f1609b1