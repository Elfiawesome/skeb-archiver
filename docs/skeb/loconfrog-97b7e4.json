t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45980b2cfa667b15606152ff8499550e 3x"}, "body": "はじめまして！\n私の自創作「AFPW〜美少年凌辱プロレス〜」の仁科優というキャラクターのイラストを依頼させていただきたいです！\nキャラクターのデザインはこちらを参考にされてください。\nhttps://twitter.com/afpw_jobberera/status/1412569012244942851?s=21\n\nシチュエーションとしては、プロレスの試合絵で\n相手レスラーにコブラツイストをかけられながら、パンツの中に手を入れられ股間を揉みしだかれ、優が半目を開けながら快感に悶え喘ぐシチュエーションのイラストを描いていただきたいです！\n優のコスチュームは資料リンクの通り\n首に黒のチョーカー、上半身は裸、下半身は純白でローライズのビキニパンツ、片方の太ももに赤のガーターリング、足は白のニーパッドとレガースで描いていただきたいです。\nなにとぞ、よろしくお願いいたします。\n\nhttps://twitter.com/afpw_jobberera/status/1412569012244942851?s=21", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@loconfrog/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 11824, "client_id": 1638592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7318b615c75990f8699794c34dce20f", "srcset": "https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7318b615c75990f8699794c34dce20f, https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e68e827b49fa90774247df800d86078 2x, https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64dc2cb4af7ecd0e610bbc32a0b0a91c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de7109ae0826c60232a3f8ff0cba7944", "srcset": "https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de7109ae0826c60232a3f8ff0cba7944, https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fac25d03f133946ddd952a4c77557d1 2x, https://si.imgix.net/2894caac/uploads/origins/484243d7-5ded-4dcd-8991-ad469202854b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4bc11de5011ab0d8c5d513ef380a1066 3x"}, "body": "ヘイ、ロコン。\n私はただ、あなたのアートは素晴らしいと言いたかったのです。そして、これからもずっと制作を続けて欲しいと思います。\nこれからもずっと作り続けて欲しいです。私はあなたのキャラクターのいくつかを楽しんでいますが、今回の依頼では\nかなめくんのシーンに興味がありました。\n\nKaname-kun。\n\t私が好きな要くんの姿のひとつにメイド服があるので、それにちなんだものにしたいと思いました。\n\tそのようなものに興味がありました。\n\t\n\t乳首もペニスも肛門もすべて露出しています。\n\t\n\t慌てて脱いだような、でも脱がされていないような、パンティが足から垂れているような感じがいいですね。\n\t完全には脱がされていない。\n\t\n\tクライマックスの直後のシーンで、要くんが視聴者に向かってM字開脚か\n\t視聴者の方を向いてM字になっているとか。\n\t\n\t要くんが衣装や自分に射精している。\n\t\n\tかなめくんは吸血されていて、お尻の穴がまだ少し広がっている状態で、それが流れ出ています。\n\t\n\t満足げな表情の要くん。\n\t\n\t私はモザイクよりもライン検閲を希望します。それよりも、服のエッジや\n\t衣服の縁などを使って、検閲の必要性を減らすのがとても上手ですね。\n\t検閲の必要性を減らすために、服などのエッジの使い方がとても上手ですね。もし、ペニスの部分だけを服の一部で覆うようなことができれば\n\t衣装の一部でペニスを覆うようなことができれば最高だと思いますが、できなくても問題ありません。\n\n鹿目くんの周りのシーン。\n\t金目くんは、枕か何かに支えられて、もたれかかっているのではないかと思いました。\n\t枕にもたれかかっているのでは？ベッドでも、湯上り処にあるような家具でも。\n\t紫は私の好きな色ですが、背景はどんな色でも構いませんし、なくても構いません。\n\t背景は何でもいいです。\n\t\n\t叶目くんの最近の恋人は出てこないで、叶目くんだけが出てきます。でも、このシーンは\n\t終わった直後のシーンです。\n\t\n\tクランピーと、たぶん要くん自身の射精液が、要くんが乗っている家具に漏れています。\n\t\nそして何よりも、どんな細かいことでも、あなたが一番似合うと思うものがあれば嬉しいです。本当にありがとうございました。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@loconfrog/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 11824, "client_id": 442604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4b4055d32e80a6e18b49b5fdf8ff7d8", "srcset": "https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4b4055d32e80a6e18b49b5fdf8ff7d8, https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29b61d785f8f08d283fe63e0b5b93ad3 2x, https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=519a7d8785c0910bcb8a508b821dae60 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ece84d9467141b8fd7e6a06d220651d", "srcset": "https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ece84d9467141b8fd7e6a06d220651d, https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=720bee4d002e2f1c6318e97ef5ce5ce9 2x, https://si.imgix.net/57d2b881/uploads/origins/82c2c9be-f32d-486b-9b7f-7ce59b66c178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7024f2e1fd54075d3d045a4af950cd7b 3x"}, "body": "こんにちわ！！！！！！！！！！！！！！（笑私のリクエストを検討してくれてありがとうございます！大ファンなんですよ！（笑\n\n自分のキャラクターであるトバコウのピンナップに興味を持ちました。彼は二本の尾のキツネのキャラクターです。  彼の性格は、貴族のような一種の、非常に傲慢で独りよがりなところがあります。彼はまた、ギャンブルや麻雀のようなゲームをプレイするのが大好きです。\n\nスレンダーで無駄のない体型で、控えめに恵まれた完璧な美少年です。自分の美しさにも誇りを持っている。\n\nシーンにはあまりこだわらないので、脱衣した状態でのんびりしたり、女性らしいファッションで景色を魅せたりするのも素敵だと思います。\n\n最終的には詳細はお任せします、ありがとうございました!