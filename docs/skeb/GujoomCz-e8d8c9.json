意識が残っている侑々溜の身体をしばらく弄んだあと、強烈なパンチを頬に喰らわせる。侑々溜は凄まじい勢いでリングに叩きつけられ、尻を突き上げた土下座のような大股開きで2人の足元に転がる格好に。拳の跡が頬にくっきり残る無惨な姿を嘲られながら完全に意識を失う。", "nc": 169, "word_count": 7768, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 24437, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぐすけじ2号", "screen_name": "mogskg", "avatar_url": "https://pbs.twimg.com/profile_images/1625116781668089857/tKH2bak4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1625116344181198849/1676293858/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 177}, {"id": 548006, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "shino︎︎", "screen_name": "shi_no1028", "avatar_url": "https://pbs.twimg.com/profile_images/1692057568703840256/qt5dfgFg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1276539939799265281/1716706699/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 899247, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "hide channel", "screen_name": "hide12862152", "avatar_url": "https://pbs.twimg.com/profile_images/1792375773443313664/5tgtnGUc.png", "header_url": "https://pbs.twimg.com/profile_banners/1339776780324913152/1716170305/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genr