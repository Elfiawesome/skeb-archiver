b31e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ec2f69b/uploads/origins/b4ff9d4f-add9-45c3-9e29-34a05588f175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a15da091de449927053f0ce2e699687", "srcset": "https://si.imgix.net/9ec2f69b/uploads/origins/b4ff9d4f-add9-45c3-9e29-34a05588f175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a15da091de449927053f0ce2e699687, https://si.imgix.net/9ec2f69b/uploads/origins/b4ff9d4f-add9-45c3-9e29-34a05588f175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4afd3ddee75aaea0e9db333dafe195 2x, https://si.imgix.net/9ec2f69b/uploads/origins/b4ff9d4f-add9-45c3-9e29-34a05588f175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a94f9f35ade433d62cb74259f74e7949 3x"}, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n一枚（又は複数枚）でまとめて頂くか、一枚づつかはご負担が少ない方で(同じなら一枚づつ)お願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komainu_611/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3264272, "client_id": 626297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5693b4ca5ef04dc55b6664d2a2b564fd", "srcset": "https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5693b4ca5ef04dc55b6664d2a2b564fd, https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc5a12ac0edf678ca8b1606cc6a04e56 2x, https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e81962360ec6656f0a56dd8e82d09061 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ddd19722023fac3adfb7c807c050b06", "srcset": "https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ddd19722023fac3adfb7c807c050b06, https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd95c622d3643a0a6acdea822cbd4e0 2x, https://si.imgix.net/3863b7b2/uploads/origins/8b685fb3-96b4-474a-8745-eb7b9b0bcd50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=432d25e032bc5f157f90a503f9a3024c 3x"}, "body": "狛狗様\n\nはじめまして、ありのみと申します\n先生に東方projectのチルノさんと大妖精さんを\n水着姿でリクエストしてもよろしいでしょうか？\n\n依頼用に２人の資料画像を用意しておりますので、もしよろしければ下記URLをご参照下さい。\nhttps://x.com/ARINOMI7/status/1911428499891532196\nあくまで個人的なイメージではありますが\n　チルノさんはツリ目系で、積極的に行動する活発で勝気な性格。\n　大妖精さんはタレ目系ジト目系で、口数少なめで消極的な性格。\n　体格に大きな差はなく２人ともお胸はぺたんこ無乳系\n　身長も同じ位で並んで立って目線が合う感じ\n（強いて差をつけるならチルノさんの方が大きめ）\n　よく一緒にいる仲良しコンビの印象を持っています。\n\n2人が水着を着ているイラストをお願い致します。\n水着の方向性は可愛い系でもセクシー系でも先生にお任せいたします。\nスク水や競泳水着、金ビキニのようなお約束系でもそうでなくても自由にお願いいたします。\n\nもしよろしければご検討下さいますよう、何卒お願い申し上げます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komainu_611/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3264272, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22ac60f3acd658670a6ba975c4c39f01", "srcset": "https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22ac60f3acd658670a6ba975c4c39f01, https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6336c956809b7629a23643952511a3cb 2x, https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c045cbcc4474c1a2cd0256d8e5969fa4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24038feb531fc09f461ea48cdd7c6606", "srcset": "https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24038feb531fc09f461ea48cdd7c6606, https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d48b568eee4380fb4e70bfa98e9d2b5 2x, https://si.imgix.net/2101f384/uploads/origins/4e638fd6-96d9-4fa2-8759-edfde7628df3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5569d400992b53e8b6d74d84749f3857 3x"}, "body": "かなり特殊なリクエストになります。無理な場合はキャンセルを、非表示をご希望の場合は再送要請ををお願いします\n艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします\nアーボックは時津風の首から下を４巻程で隙間なく巻き付け、時津風の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。アーボックの口は閉じてください\n全身巻き付かれている事を強調する為、時津風の全身を描いて頂けるとうれしいです\nできればアーボックは通常色と色違いをお願いします\nさらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします\n時津風の表情ですが、（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komainu_611/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3264272, "client_id": 670645, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11287164/uploads/origins/7036dbb2-ee01-4fa6-8bcb-a610a2c37799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcc0ae5f118cbbb36f1971d2471579e1", "srcset": "https://si.imgix.net/11287164/uploads/origins/7036dbb2-ee01-4fa6-8bcb-a610a2c37799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcc0ae5f118cbbb36f1971d2471579e1, https://si.imgix.net/11287164/uploads/origins/7036dbb2-ee01-4fa6-8bcb-a610a2c37799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5cc77074079df57ddcb54988f187f87 2x, https://si.imgix.net/11287164/uploads/origins/7036dbb2-ee01-4fa6-8bcb-a610a2c37799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba5e3cf82014021cdc59f10eb61f0186 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11287164/uploads/origins/7036dbb2-ee01-4fa6-8bcb-a610a2c37799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c02a92de656a0b71c90eeebfc0def076", "srcset": "https://si.imgix.net/11287164/uploads/origins/7036dbb2-ee01-4fa6-8bcb-a610a2c37799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c02a92de6