れて生活する軍の暗殺部隊\n・普段は愛想も人当たりもよく、ほわほわした印象だが、戦闘モードになると雰囲気が一転、敵には容赦なく攻撃をする無慈悲な魔術師(本来の性格はこちら)\n・眷属は全部で十体、お気に入りは化け狐\n・民族観のある服を好む\n・寒がりなので冬は特にもこもこの帽子や外套を着用(大量の隠しナイフ)\n\n\n使用目的として、SNSアイコン、印刷して個人鑑賞等を予定しています。\nご検討よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_zunko_42/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1977677, "client_id": 3543145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e446730/uploads/origins/2ef9de70-576e-482a-9020-d5417f08c966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a04d42e3c72468a56ded4148069c3696", "srcset": "https://si.imgix.net/9e446730/uploads/origins/2ef9de70-576e-482a-9020-d5417f08c966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a04d42e3c72468a56ded4148069c3696, https://si.imgix.net/9e446730/uploads/origins/2ef9de70-576e-482a-9020-d5417f08c966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=969267754de8fdee7b392ccdbb473cfa 2x, https://si.imgix.net/9e446730/uploads/origins/2ef9de70-576e-482a-9020-d5417f08c966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38ef45f6ed64d821ead3ee84709bdc3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e446730/uploads/origins/2ef9de70-576e-482a-9020-d5417f08c966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=387b30873a42fea02e58f9b52b2e2fb8", "srcset": "https://si.imgix.net/9e446730/uploads/origins/2ef9de70-576e-482a-9020-d5417f08c966?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=387b30873a42fea02e58f9b52b2e2fb8, https://si.imgix.net/9e446730/uploads/origins/2ef9de70-576e-482a-9020-d5417f08c966?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f5df4bb1e8e3