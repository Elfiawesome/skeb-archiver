4b\u3089\u3082\u753b\u50cf\u4f7f\u7528\u8a31\u53ef\u6e08\uff09\n2\u4eba\u3068\u3082\u8fb2\u696d\u5927\u5b66\u306b\u901a\u3063\u3066\u304a\u308a\u3001\u5e7c\u99b4\u67d3\u3067\u3059\u3002\n\n\n\u3010\u4e94\u5341\u5d50\u3000\u6d69\u4eba\u3011\n20\u6b73\uff0f175cm\uff0f\u2642\uff0f\u4e00\u4eba\u79f0\uff1a\u4ffa\n\u611b\u79f0\u306f\u30d2\u30ed\u3002\n\u5b9f\u5bb6\u306f\u5c0f\u9ea6\u8fb2\u5bb6\u3002\u4e0b\u8a18\u306e\u30ca\u30aa\u3068\u306f\u5bb6\u65cf\u7d61\u307f\u3067\u4ef2\u304c\u826f\u3044\u3002\u73fe\u5728\u9032\u5b66\u306b\u4f34\u3044\u4e00\u4eba\u66ae\u3089\u3057\u306a\u306e\u3067\u30ec\u30b9\u30c8\u30e9\u30f3\u3067\u30d0\u30a4\u30c8\u4e2d\u3002\u672c\u4eba\u66f0\u304f\u53e3\u304c\u3042\u307e\u308a\u4e0a\u624b\u304f\u306a\u3044\u70ba\u8ab0\u3068\u3067\u3082\u4ef2\u826f\u304f\u8a71\u3057\u3066\u3044\u308b\u30ca\u30aa\u306b\u61a7\u308c\u3066\u3044\u308b\u3002\u30ca\u30aa\u306b\u306f\u559c\u6012\u54c0\u697d\u3084\u5e74\u76f8\u5fdc\u3082\u3057\u304f\u306f\u305d\u308c\u3088\u308a\u3082\u5e7c\u3044\u8868\u60c5\u3092\u898b\u305b\u308b\u3002\n\n\n\u3010\u9808\u85e4\u3000\u76f4\u5e79\u3011\n20\u6b73\uff0f172\u339d\uff0f\u2642\uff0f\u4e00\u4eba\u79f0\uff1a\u4ffa\n\u611b\u79f0\u306f\u30ca\u30aa\u3002\n\u5b9f\u5bb6\u306f\u755c\u7523\u3084\u8fb2\u696d\u306e\u30d5\u30a1\u30fc\u30e0\u7d4c\u55b6\u3002\u4e0a\u8a18\u306e\u30d2\u30ed\u3068\u306f\u5bb6\u65cf\u7d61\u307f\u3067\u4ef2\u304c\u826f\u3044\u3002\n\u611b\u5b0c\u304c\u826f\u304f\u660e\u308b\u3044\u6027\u683c\u3002\u6642\u9593\u304c\u3042\u308b\u6642\u306f\u30d0\u30a4\u30af\u3067\u5b9f\u5bb6\u307e\u3067\u5e30\u308a\u5bb6\u696d\u3092\u624b\u4f1d\u3063\u3066\u3044\u308b\u3002\n\u30d2\u30ed\u306e\u3053\u3068\u306f\u89aa\u53cb\u3060\u3068\u601d\u3063\u3066\u304a\u308a\u6c17\u697d\u306b\u8a71\u3092\u3057\u306b\u884c\u304f\u3057\u5f7c\u306e\u524d\u3067\u306f\u306e\u3093\u3073\u308a\u3068\u904e\u3054\u3057\u3066\u3044\u308b\u3002\n\n\n\uff3f\uff3f\uff3f\uff3f\uff3f\n\n\n\u4e00\u7dd2\u306b\u30c6\u30b9\u30c8\u52c9\u5f37\u3092\u3057\u305