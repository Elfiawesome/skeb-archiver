しましてはTwitterで紹介させて頂く他、SNS・掲示板等への掲載される可能性があります。\n\n彼女の名前はニーナと言い、好奇心旺盛な9歳の女の子です。\n何処へでも言ってしまうほど行動力に溢れており、冒険が大好きです。\n保護者であり親代わりの人間によく懐いており、いつも一緒に行動しています。\n構図等は全てお任せしますが、天真爛漫だと分かる雰囲気だととても嬉しいです。\n\n条件が良ければ、よろしくお願いします！\n\n参考ツイート\n\nhttps://twitter.com/hakuto_iwashi/status/1289010332157976576", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 65646, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "四季野ゆき", "screen_name": "sikinoyuki", "avatar_url": "https://pbs.twimg.com/profile_images/1683762443909210113/yJtCbVYw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/715506673100558337/1690677309/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 259535, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "日暮 七十七", "screen_name": "nazuna_higurasi", "avatar_url": "https://pbs.twimg.com/profile_images/1906163935029714946/C2JaIFO8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1212026318310633473/1717135086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "nc": 176}, {"id": 1067148, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ほがら", "screen_name": "hogara_18", "avatar_url": "https://pbs.twimg.com/profile_images/1186568091590742016/7Pcf8xdI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1186550989291057158/1726721421/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester