かリンクが貼れなかったのでお手数ですが確認していただければと思います…すみません…。)\n https://nico.ms/sm43272093\n\nこれを元に「黒い天使の輪、終の逆さ文字、404の文字をどこかに加えること」は変えず、服装を青黒メインで紫は使用せずにダウナーで異世界な感じにしていただくことは可能でしょうか…？(衣装に詳しくないため大雑把な説明で申し訳ありません…)\n\nいつも素敵なイラストを拝見しておりました。\n依頼が初めての為、もし不手際があれば申し訳ありません…。ご検討していただけると嬉しいです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sannota272/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 735058, "client_id": 328673, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f450da48/uploads/origins/4ce74009-0192-420f-8491-c52a260466fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f2270c8fcbba050912f0c071e3ca5b", "srcset": "https://si.imgix.net/f450da48/uploads/origins/4ce74009-0192-420f-8491-c52a260466fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3f2270c8fcbba050912f0c071e3ca5b, https://si.imgix.net/f450da48/uploads/origins/4ce74009-0192-420f-8491-c52a260466fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85c55ed376fbae47c85b2085985bea2b 2x, https://si.imgix.net/f450da48/uploads/origins/4ce74009-0192-420f-8491-c52a260466fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50ae7e270c40bbe95d56a76108924dd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f450da48/uploads/origins/4ce74009-0192-420f-8491-c52a260466fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02bc1d958389c7e69de49b377663526b", "srcset": "https://si.imgix.net/f450da48/uploads/origins/4ce74009-0192-420f-8491-c52a260466fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02bc1d958389c7e69de49b377663526b, https://si.imgix.net/f450da48/uploads/origins/4ce74009-0192-420f-8491-c52a260466fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2