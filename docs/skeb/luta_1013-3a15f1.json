3061\u306f\uff01\n\u5927\u597d\u304d\u306a\u308b\u305f\u3055\u3093\u306bX\u306a\u3069\u3067\u4f7f\u7528\u3059\u308b\u30a2\u30a4\u30b3\u30f3\u3092\u4f9d\u983c\u3057\u305f\u304f\u3001\u9023\u7d61\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\u30a2\u30a4\u30b3\u30f3\u306a\u3069\u3068\u3044\u3044\u307e\u3057\u305f\u304c\u3001\u4e00\u679a\u7d75(\u7acb\u3061\u7d75\u3067)\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\n\u30b3\u30fc\u30b9\u2462(\u80cc\u666f\u3042\u308a\u3001\u306a\u3057\u4e21\u65b9\u6b32\u3057\u3044\u3067\u3059)+\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3+\u8868\u60c5\u5dee\u5206\n\n\u306f\u3058\u3081\u3066skeb\u3067\u306e\u4f9d\u983c\u3092\u3059\u308b\u305f\u3081\u3001\u306a\u306b\u304b\u4e0d\u624b\u969b\u306a\u3069\u3042\u308a\u307e\u3057\u305f\u3089\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u3002\n\u4ee5\u4e0b\u4f9d\u983c\u306e\u5185\u5bb9\u3067\u3059\u3002\n\n\u30aa\u30ea\u30b8\u30ca\u30eb\u4ee3\u7406\u3061\u3083\u3093\u306e\u4f9d\u983c\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\u9aea\u8272:\u8584\u3044\u6c34\u8272(\u30a4\u30e1\u30fc\u30b8\u3068\u3057\u3066\u306f\u96ea\u30df\u30af\u306e\u9aea\u8272\u3088\u308a\u3082\u5c11\u3057\u8584\u3081\u306a\u611f\u3058)\n\u9aea\u578b:\u77ed\u3081(\u80a9\u304f\u3089\u3044\u306e\u30dc\u30d6\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u30d5\u30a1\u30eb\u30b6\u30f3\u5148\u8f29\u304b\u3089\u30c4\u30a4\u30f3\u30c6\u30fc\u30eb\u53d6\u3063\u3066\u5c11\u3057\u9577\u304f\u3057\u305f\u611f\u3058\uff1f)\u3002\u30d8\u30a2\u30d4\u30f3\u306a\u3069\u306e\u9aea\u98fe\u308a\u3084\u5e3d\u5b50\u306a\u3069\u30ef\u30f3\u30dd\u30a4\u30f3\u30c8\u3092\u3044\u308c\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u773c\u306e\u8272:\u9ed2\u304b\u9752\u3092\u8003\u3048\u3066\u3044\u307e\u3057\u305f\u304c\u3001\u308b\u305f\u3055\u3093\u306e\u30bb\u30f3\u30b9\u306b\u4efb\u305b\u305f\u3044\u3067\u3059\u3002\n\u670d\u88c5:\u96ea\u30df\u30af2021\u306