ix.net/4a8bcbcd/uploads/origins/45786087-458c-4af4-8ed6-c49a1ef26cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb043d1e61726b882438400aedffd780 2x, https://si.imgix.net/4a8bcbcd/uploads/origins/45786087-458c-4af4-8ed6-c49a1ef26cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=659b1023c9a3d8d6a8b4c29dce7014ae 3x"}, "body": "君の作品はいつも本当にエロいと思うから、1点リクエストするよ。ポケモンからローザとヒルダの3P（このコンビはマジでエロい）で、3部構成だ。パート1はヒルダとローザの自慢シーン。ローザがシャツを上げて胸を見せびらかし、ヒルダはパンツを下ろして尻を揺らしながら舌を出す。  \n\n第二部：ローザが騎乗位で男根に腰を振る間、ヒルダが彼女の乳房の一つを舐める第三部：ヒルダが逆騎乗位で男根に腰を振る間、ローザが舌を出しながら彼女の尻を掴む第二部と第三部では、ヒルダとローザはシャツを上げており、それ以外は全裸です台詞や射精のバリエーションがあると嬉しいですが、必須ではありません\n  第1部は省略可。お時間のある時に。このセットを楽しみにしています。非常に熱い内容になるでしょう。ライン検閲推奨。台詞（英語、コピペ可）：https://rentry.org/qxor9enx参照：https://rentry.org/tb3282a9", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@activ/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3409731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a846dae1b68cee8e434b9921a9aaf0", "srcset": "https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47a846dae1b68cee8e434b9921a9aaf0, https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0366cd53c102b8767600a6f9656af8c0 2x, https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91b3e8118b692ece846bba93153c01e2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcc9bc01461374050e9f5f79543c1929", "srcset": "https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcc9bc01461374050e9f5f79543c1929, https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b4967a27a945675f4548f4fdd902592 2x, https://si.imgix.net/120e5dbe/uploads/origins/aeff8d60-407f-443b-90e1-8cb73da99358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=992d130d23fa093755fa3403f8f0c74a 3x"}, "body": "失礼いたします。先日依頼させていただいたものの再依頼をさせていただきたいです。\nキャラは、アニメ「アオのハコ」の蝶野雛ちゃんというキャラです。\nhttps://aonohako-anime.com/\n\n服装は下記画像の新体操レオタードでお願いします。\nhttps://jumpcs.shueisha.co.jp/img/goods/L/4530430320301.jpg\n\nレオタードは薄い生地の素肌着用でピッチリした感じに、特に股間については下記の競泳水着のイラストぐらいに、お股の形をクッキリさせてほしいです。\nhttps://www.pixiv.net/artworks/99510098\n\nシチュは、以前の依頼のめぐるちゃんのように、雛ちゃんのレオタード姿に我慢できなくなった教師に襲われている形です。\n場所は体育用具室のマットの上です。\n下記の3Dのように、めぐるちゃんの時よりも、一層のしかかるように、雛ちゃんのレオタードのマンスジと自分の下腹部でチンポをサンドイッチするように押し付け、激しく擦りつけさせてください。\nhttps://drive.google.com/file/d/1dnzmp4KfnqWBgX_WEWtiJo-nwrsFNtju/view?usp=drivesdk\n\n押し倒した横に、下記雛ちゃんのイラストが着ている上着を乱雑に投げ捨ててあると嬉しいです。\nhttps://img.amiami.jp/images/product/main/253/GOODS-04650194.jpg\n\n教師は、小太りなオタクっぽい教師、Tシャツ着用でお願いします。\n\n雛ちゃんの様子は、抵抗しつつも、敏感な場所に薄いレオタード1枚で硬く勃起したチンポを強く擦りつけられ、感じてしまって抵抗しきれていない感じでお願いします。\nまた、感じてしまい硬くなった両乳首を浮き乳首(乳首テントのような感じ)させる形でお願いします。\n差分については、射精前と射精時の差分をお願いします。\n\nあと、これは可能ならで結構なのですが、レオタードと体の間に挿入及び射精している差分も描いていただけると嬉しいです。\n\n今回も、出来るだけ雛ちゃんは見切れ無しでお願いしたいです。\n\n資料URLに、資料を集めております。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1TXXGywLPVdzD_jVRB87JoyN6gS61j7gF", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@activ/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3409731, "client_id": 1433971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dee2e9aea844ca57543199fbced88f3", "srcset": "https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dee2e9aea844ca57543199fbced88f3, https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a06bedcf5bb2445bfc65b11e0fffd5c 2x, https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dae7f8c952844d941427138b7aff495d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c6c5a391af53c7af44942771184df0a", "srcset": "https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c6c5a391af53c7af44942771184df0a, https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b89550607eec29a552f81fff87bc7f8 2x, https://si.imgix.net/38956f5d/uploads/origins/777769ab-7f3b-424e-9506-915732e6ecd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d31ba0b223acd31d791856a077e2a426 3x"}, "body": "初めまして\n依頼させてください\n\n創の軌跡のエリィ・マクダエルをお願いします\nhttps://www.falcom.co.jp/hajimari/story/crossbell.htmlの002のエリィの項目\n\n衣装\n資料の透けチャイナ服(下着などは無し。色はお任せします)\n\nシチュエーション\n弱みを握られ逆らえない状況\n資料の衣装を着て、金持ち連中のパーティで給仕をさせられている\nお盆を片手で持ち、飲み物等を運んでいる\n服が透けているのでほぼ裸が見えるが、手で体を隠さないように言われている\n顔を赤くして少し涙目\n\nよろしくお願いします\n\nhttps://drive.google.com/file/d/1KzSMT5lpxCpxodeDhkSGFyunzfjL-K31/view?usp=drive_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@activ/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3409731, "client_id": 1561892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe4de426/uploads/origins/64b1d89c-cf18-4e17-bd1b-d58430723fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5783fca979f89935863c51f94fd267d", "srcset": "https://si.imgix.net/fe4de426/uploads/origins/64b1d89c-cf18-4e17-bd1b-d58430723fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5783fca979f89935863c51f94fd267d, https://si.imgix.net/fe4de426/uploads/origins/64b1d89c-cf18-4e17-bd1b-d58430723fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=776061f87aebe80f69a4fed91dd44531 2x, https://si.imgix.net/fe4de426/uploads/origins/64b1d89c-cf18-4e17-bd1b-d58430723fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7b486fb432756ed17b702ace6d2e9ea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe4de426/uploads/origins/64b1d89c-cf18-4e17-bd1b-d58430723fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4234cd8c46ddc3ef776c14571bf5e44c", "srcset": "https://si.imgix.net/fe4de426/uploads/origins/64b1d89c-cf18-4e17-bd1b-d58430723fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4234cd8c46ddc3ef776c14571bf5e44c, https://si.imgix.net/fe4de426/uploads/origins/64b1d89c-cf18-4e17-bd1b-d58430723fa7?bg=