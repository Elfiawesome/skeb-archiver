u80fd\u306apsd\u65b9\u5f0f\u3067\n\u65ad\u9762\u56f3\u306a\u3057\u5dee\u5206&\u6975\u592a\u30da\u30cb\u30b9\u306e\u5c3f\u9053\u90e8\u304c\u5973\u4f53\u4e00\u4eba\u901a\u308b\u30b5\u30a4\u30ba\u3067\u5927\u304d\u304f\u81a8\u3089\u307f\u3001\u5927\u91cf\u5c04\u7cbe\u3068\u5171\u306b\u9234\u53e3\u304b\u3089\u30ec\u30a4\u30b9\u306e\u7247\u8155\u304c\u51fa\u308b\u51fa\u7523\u9014\u4e2d\u30b7\u30fc\u30f3\u5e0c\u671b(\u305d\u308c\u305e\u308c\u72ec\u7acb\u5dee\u5206\u5e0c\u671b)\n\u53ef\u80fd\u306a\u3089\u3048\u3050\u3044\u8089\u7624\u304c\u5c71\u307b\u3069\u3064\u3044\u305f\u5c3f\u9053\u8cac\u3081\u7528\u6975\u592a\u89e6\u624b(\u53ef\u80fd\u306a\u3089\u8089\u584a\u5375\u6e80\u8f09\u306e\u7523\u5375\u6a5f\u80fd\u4ed8\u304d)\u3092\u5c3f\u9053\u306b\u633f\u5165\u3055\u308c\u8a31\u53ef\u304c\u3042\u308b\u307e\u3067\u5c04\u7cbe&\u51fa\u7523\u5c01\u5370\u4e2d\u306e\u51fa\u7523\u524d\u30b7\u30fc\u30f3\u5e0c\u671b\nM\u7537\u306b\u4e00\u5207\u306e\u640d\u50b7\u3084\u82e6\u75db\u306f\u306a\u304f\u3001\u7d14\u7c8b\u306a\u5feb\u697d\u306b\u3088\u308a\u60c5\u3051\u306a\u304f\u5598\u3044\u3067\u30de\u30be\u7d76\u9802\u3059\u308b\u69d8\u5b50\u5e0c\u671b\n\n\u80cc\u666f\u306f\u89e6\u624b\u8089\u58c1\u304b\u30c0\u30fc\u30af\u7cfb\u5e0c\u671b\n\u30ec\u30a4\u30e4\u30fc\u5207\u66ff\u53ef\u80fd\u8a2d\u5b9a\u3067\u5404\u30ad\u30e3\u30e9\u306e\u77b3\u306e\u30cf\u30a4\u30e9\u30a4\u30c8\u3001\u9854\u4e0a\u90e8\u306e\u5f71\u306e\u6709\u7121\u306e\u5207\u66ff\u5dee\u5206\u3001\u5c3f\u9053\u304b\u3089\u5973\u4f53\u304c\u305a\u308b\u3063\u3068\u9019\u3044\u51fa\u3059\u52b9\u679c\u97f3\u7b49\u5dee\u5206\u3084\u7c98\u6db2\u307e\u307f\u308c\u306e\u89e6\u624b\u304c\u8822\u304f\u52b9\u679c\u97f3\u7b49\u3084\u5c3f\u9053\u51fa\u7523\u306e\u7518\u3044\u5feb\u611f\u306b\u60b6\u3048\u308b\u7537\u306e\u53f0\u8a5e\u3068\u53e3\u8abf\u7b49\u304a\u4efb\u305b\u3067\n\u8001\u3044\u3082\u6b7b\u3082\u8d66\u3055\u308c\u305a\u5927\u597d\u304d\u306a\u8d85\u4e73&\u30dc\u30c6\u8179\u7f8e\u5c11\u5973\u3070\u304b\u308a\u30de\u30be\u5c04\u7cbe\u51fa\u7523\u3059\u308bM\u7537\u306e\u59ff\u3092\u4fae\u8511\u3059\u308b\u5f7c\u5973\u9054\u306e\u53f0\u8a5e\u3068\u3057\u3066\u3001\u300c\u6700\u4f4e\u300d\u300c\u5909\u614b\u300d\u300c\u30de\u30be\u300d\u300c\u7537\u306e\u7656\u306b\u30da\u30cb\u30b9\u304b\u3089\u51fa\u7523\u3059\u308b\u306a\u3093\u3066\u6c17\u6301\u3061\u60aa\u3044\u300d\u300c\u7f70\u3068\u3057\u3066\u6c38\u9060\u306b\u5c3f\u9053\u51fa\u7523\u3055\u305b\u308b\u308f\u300d\u7b49\u306e\u53f0\u8a5e\u6709\u7121\u5dee\u5206\u5e0c\u671b(\u3042\u304f\u307e\u3067\u53c2\u8003\u3067\u3082\u3046\u5c11\u3057\u9577\u3081\u306b\u3057\u3066\u9802\u3051\u308c\u3070\u5e78\u3044\u3067\u3059)\n\u66f4\u306b\u512a\u5148\u5ea6\u6700\u4f4e\u3067M\u7537\u306e\u30da\u30cb\u30b9\u3092\u5ad0\u308b\u79c1\u670d\u30e9\u30f4\u30a3\u30fc\u30cd\u306e\u69d8\u5b50\u3084\u8822\u304f\u5927\u7389\u888b\u304c\u3001\u5f7c\u81ea\u8eab\u306e\u7740\u8863\u3067\u96a0\u308c\u3066\u304a\u308a\u3001\u5916\u304b\u3089\u4f55\u304c\u884c\u308f\u308c\u3066\u3044\u308b\u304b\u308f\u304b\u3089\u306a\u3044\u304c\u3001\u80a1\u9593\u90e8\u5206\u306e\u670d\u306e\u4e0b\u3067\u4f55\u304b\u304c\u8822\u3044\u3066\u3044\u308b\u69d8\u5b50\u304c\u308f\u304b\u308b\u5dee\u5206\u5e0c\u671b\n\nhttps://drive.google.com/drive/folders/1AEbaHAfTef7qfIBO5IDMY-M0eC3xD-Fs?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomo4ho/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3202640, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f42079c4a3ba619b75fedb0b634acb5", "srcset": "https://si.imgix.net/e114c1db/uploads/origins/346ff42d-483d-4f75-8bb3-3521135723b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f42079c4a3ba619b75fe