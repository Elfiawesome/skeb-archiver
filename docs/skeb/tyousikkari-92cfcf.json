参考資料\n・資料URL参照をお願いいたします。\n・髪型は自由にアレンジしていただいて大丈夫です。\n\n\n🦋構図\n構図に関してはお任せでお願いしたいと思います。\n\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ezl87VdYWbtdLqyQEWUQ-ONpAxnU2NIF?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tyousikkari/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3134063, "client_id": 3829617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f00c5ea/uploads/origins/a336a23e-f7c6-433f-9f29-988b807ee193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f772fc7625d40d8f4710e18b28c0207e", "srcset": "https://si.imgix.net/1f00c5ea/uploads/origins/a336a23e-f7c6-433f-9f29-988b807ee193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f772fc7625d40d8f4710e18b28c0207e, https://si.imgix.net/1f00c5ea/uploads/origins/a336a23e-f7c6-433f-9f29-988b807ee193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6757dd3b0cbf0600b2ff25cf86f7b84 2x, https://si.imgix.net/1f00c5ea/uploads/origins/a336a23e-f7c6-433f-9f29-988b807ee193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=469040440e415b408bd96fc455ad038d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f00c5ea/uploads/origins/a336a23e-f7c6-433f-9f29-988b807ee193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a086967da4ad1606295564a23d8f8275", "srcset": "https://si.imgix.net/1f00c5ea/uploads/origins/a336a23e-f7c6-433f-9f29-988b807ee193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a086967da4ad1606295564a23d8f8275, https://si.imgix.net/1f00c5ea/uploads/origins/a336a23e-f7c6-433f-9f29-988b807ee193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60b189449e5622a47367b5