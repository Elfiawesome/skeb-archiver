=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c629a2bde2fdfde31cf532b72a4901f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25e9406c5403684b7a96e21af1cca158", "srcset": "https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25e9406c5403684b7a96e21af1cca158, https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93613c5c235564926bde5b31b7aba54c 2x, https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f77b4b8d3c3db6d3706727530fa60e8 3x"}, "body": "I had a chance to see Ameki Mashira's work on SNS, and I felt the originality of his analog drawings, which are not influenced by the AI that is so popular these days.\n\nIf you would like, we would like a digital illustration of a beautiful boy chomping on an apple to be used as a thumbnail.\n\nUpper body only\n\nPurple hair, red eyes, clear white skin\n\nA bewitchingly beautiful boy like the fallen saint from the legend of the Holy Sword\nhttps://images.app.goo.gl/j8JkR83RYuB6jhir9\n\nLaurel crown on his head instead of a circlet.\nhttps://images.app.goo.gl/Q7CcUUzdg28rwmV97\n\nBiting down on an apple as if inviting you to look at the camera.\nhttps://images.app.goo.gl/ZoVKTStCTpSQZaJZ9\n\nClothing that exposes one shoulder like an ancient Greek toga\nhttps://images.app.goo.gl/CvNAhftqTEAYomZK6\n\nBackground is all flower green and blue\nhttps://images.app.goo.gl/nKXAtCofAMSeiGWKA\n\nThank you for reading this far.\n\nI would be happy if you could do a painting of a beautiful boy bewitchingly chomping on an apple in the image of a homosexual in a Caravaggio painting.\n\nThank you very much for your consideration.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@KAGUSA_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3163072, "client_id": 2079835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb720e046e83920fe31b6cc48c77e95", "srcset": "https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb720e046e83920fe31b6cc48c77e95, https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfa6fac1ea5ea8df689b6ca0d67d8750 2x, https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aac171a416c525bc6997e7f5935409f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da55bea4f971cbe05b1bdce757498aff", "srcset": "https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da55bea4f971cbe05b1bdce757498aff, https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=667a8d2e45e05106f1c750018d5f9fed 