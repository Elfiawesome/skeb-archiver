%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89b8c07b0978a4d895c7d37c51dc93ef, https://si.imgix.net/ef346789/uploads/origins/b23c256b-528a-4a33-8066-39618212f2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5635e880cd40f5af82c378c8f7768b39 2x, https://si.imgix.net/ef346789/uploads/origins/b23c256b-528a-4a33-8066-39618212f2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38b7e414958fc96b9b7a06ce2327960a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef346789/uploads/origins/b23c256b-528a-4a33-8066-39618212f2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5887958ef8fe279aa0f992875d3a3be1", "srcset": "https://si.imgix.net/ef346789/uploads/origins/b23c256b-528a-4a33-8066-39618212f2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5887958ef8fe279aa0f992875d3a3be1, https://si.imgix.net/ef346789/uploads/origins/b23c256b-528a-4a33-8066-39618212f2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a94615bfb3e83693796f21f42e102b9 2x, https://si.imgix.net/ef346789/uploads/origins/b23c256b-528a-4a33-8066-39618212f2dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fc3dbaaae5fdd9801294a6aa14195db 3x"}, "body": "こんにちは！元気でいることを願っている。前のスケブもありがとう! もしよろしければ、自分のキャラクターの絵をまたお願いしたいです ☺️\n\n🎀🐇🧶 ダーリーン Darlene\n礼儀正しく心優しい女の子。高校時代、彼女はその美しさでかなり人気がありました。しかし、彼女は内心とても心配性で、いつも他人のことを考えています。大人になると、彼女は寛大な女性になり、溺愛する母親になる。仕立てと編み物が得意。自分の子供やペットの服を縫ったり、彼女の夫の壊れた服を直したりするのが好きだ。彼女の目の色は水色です。彼女の髪はウェーブしていて、赤ワイン色です。\n\nいつも美少女を描かれるみやほしみなみさんの絵が大好きです。💖 私のキャラクターであるダーリーンが描かれるのが楽しみです。\n\n▼ いくつかアイデアがあるので、それを描くか無視するかは自由にしてください。他のアイデアがあれば、それを描くこともできます~\n※ デザインは大人「ADULT」と高校生「HIGH SCHOOL」の2種類あります。高校生バージョンを描いてもらおうかとも思っていましたが、お好きな方を描いていただいて構いません ♪\n\n※ 高校時代のダーリーンのデザインは制服姿でのみ登場します。学校以外ではカジュアルな服を着ている彼女を見るのもいいかもしれませんので、お望みであれば自由に着せ替えてください。雰囲気は80〜90年代風です。\n\n※ 参考資料では、眼鏡をかけた少年、ジョージ (George) がいます。高校の先輩で、後に彼女の夫になります。描きたくなったら、ぜひ彼も描いてください。（ほんの少しでも）ジョージはイケメンタイプではないですが、どちらかというと不器用で変わり者です。でもとても優しくて、動物の世話が大好きです。\n高校生の時、子猫を助けた後、ジョージは木から落ちて腕を骨折しました。ダーリーンは彼を保健室に連れて行き、回復するまで見守りました。二人はやがて恋に落ちました。ジョージは恋愛に関してはとても恥ずかしがり屋なので、代わりに彼にラブレターを書きました。ジョージは自分で手紙を届けるのが恥ずかしかったので、ミッキーという猫にダーリーンに手紙を届けるように頼みました。 🩹🐱💌\n\n※ ...あるいは何でも！\nこのリクエストを検討してくれて、ありがとうございます💓\n\nhttps://toyhou.se/22914107.darlene-george/gallery?key=nH0gweZkEi3BGaS", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@8miya37/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2584215, "client_id": 2774767, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ef7334e/uploads/origins/7d3ebdf5-10fe-48f3-8a23-3e8dc1bc1bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=656815823107c2a578e7034afa997dd8", "srcset": "https://si.imgix.net/8ef7334e/uploads/origins/7d3ebdf5-10fe-48f3-8a23-3e8dc1bc1bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=656815823107c2a578e7034afa997dd8, https://si.imgix.net/8ef7334e/uploads/origins/7d3ebdf5-10fe-48f3-8a23-3e8dc1bc1bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68274ef00de2b57a91fc5859f814b1a0 2x, https://si.imgix.net/8ef7334e/uploads/origins/7d3ebdf5-10fe-48f3-8a23-3e8dc1bc1bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=decd62eed97eca6874aeccda9f643ab8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ef7334e/uploads/origins/7d3ebdf5-10fe-48f3-8a23-3e8dc1bc1bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c347559d050ad068f30c4e478ef834d", "srcset": "https://si.imgix.net/8ef7334e/uploads/origins/7d3ebdf5-10fe-48f3-8a23-3e8dc1bc1bcf?bg=%23fff&auto=format%2Ccompress&fm=