79d1\u5b66\u8005\u5a18\u3002\u5929\u624d\u7684\u982d\u8133\u3067\u69d8\u3005\u306a\u7737\u5c5e(\u30e1\u30ab\u3084\u602a\u7269)\u3092\u5275\u308a\u51fa\u3059\u4ed6\u3001\u672c\u4eba\u3082\u6b66\u8853\uff1d\u87f7\u8782\u62f3\u306e\u4f7f\u3044\u624b\u3068\u3057\u3066\u524d\u7dda\u306b\u8d74\u304f\u3002\n\n\uff0a\u5916\u898b\n\u304a\u624b\u6570\u3092\u304a\u639b\u3051\u3057\u307e\u3059\u304c\u3001\u8cc7\u6599URL\u5148\u306e\u5404\u753b\u50cf\u3082\u3054\u53c2\u7167\u304f\u3060\u3055\u3044\u3002\n\u273d\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30b7\u30fc\u30c8(\u7d39\u4ecb\u7d75)\u7684\u306b\u304a\u63cf\u304d\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\u273d\u753b\u9762\u306e\u65b9\u3092\u5411\u3044\u305f\u7acb\u3061\u7d75\u3002\u89d2\u5ea6\u306f\u771f\u6b63\u9762\u3067\u7121\u304f\u3068\u3082OK\u3001\u659c\u3081\u6b53\u8fce\u3067\u3059\u3002\n\u273d\u7a7a\u9593\u306e\u660e\u308b\u3055\u306f\u3001\u5f7c\u5973\u306e\u5bb9\u59ff\u304c\u30cf\u30c3\u30ad\u30ea\u5224\u308b\u3088\u3046\u306b\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u273d\u63cf\u5199\u7bc4\u56f2\u306f\u982d\u9802\u90e8\uff5e\u819d\u4e0a\u8fba\u308a\u3002\n\uff5e\uff5e\uff5e\n\u203b\u9aea\u8272\u30fb\u9aea\u578b\u30fb\u9854\u7acb\u3061\u30fb\u4f53\u683c\u30fb\u30bb\u30fc\u30e9\u30fc\u670d\u306f\u8cc7\u6599\u753b\u50cf\u2460\u306b\u6e96\u62e0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u203b\u5168\u4f53\u7684\u306b\u30a4\u30ab\u308c\u305f\u96f0\u56f2\u6c17\u3002\n\u273d\u9aea\n- \u5bdd\u7656\u3060\u3089\u3051\u3067\u30dc\u30b5\u30dc\u30b5\u306e\u3001\u3084\u3084\u7d2b\u304c\u304b\u3063\u305f\u9ed2\u3044\u30b7\u30e7\u30fc\u30c8\u30d8\u30a2\u3002\u305d\u3093\u306a\u306b\u30dc\u30ea\u30e5\u30fc\u30e0\u306f\u3042\u308a\u307e\u305b\u3093\u3002\n\u273d\u9854\n- \u672c\u4eba\u304b\u3089\u898b\u3066\u5de6\u76ee\u306e\u4e0a\u306b\u3001\u767d\u3044\u5305\u5e2f\u3092\u30b0\u30eb\u30b0\u30eb\u3068\u5dfb\u3044\u3066\u3044\u307e\u3059\u3002\n- \u672c\u4eba\u304b\u3089\u898b\u3066\u53f3\u76ee\u306e\u77b3(\u7d2b\u8272)\u306f\u3001\u4e2d\u592e\u304c\u300c\u3050\u308b\u3050\u308b\u76ee(\u6e26\u5dfb)\u300d\u72b6\u614b\u3002\u307e\u305f\u53f3\u76ee\u306e\u5f62\u81ea\u4f53\u306f\u3001\u3084\u3084\u5c0f\u3055\u3044\u30b8\u30c8\u76ee\u3002\n- \u53e3\u306f\u8584\u6c17\u5473\u60aa\u304f\u30cb\u30e4\u30cb\u30e4\u7b11\u3044\u3002\u4e0a\u306e\u72ac\u6b6f\u304c\u5de6\u53f3\u3068\u3082\u3001\u5438\u8840\u9b3c\u306e\u7259\u306e\u3088\u3046\u306b\u4f38\u3073\u3066\u3044\u307e\u3059\u3002\n\u273d\u4f53\n- \u4e21\u624b\u306e\u6307\u5168\u3066\u306b\u3001\u7570\u69d8\u306b\u9577\u304f\u4f38\u3073\u305f\u8d64\u3044\u722a(\u751f\u4f53\u6539\u9020\u306e\u7523\u7269)\u3002\n- \u4e0d\u5065\u5eb7\u306a\u84bc\u767d\u3044\u808c\u30fb\u5c0f\u67c4\u306a\u30ac\u30ea\u30ac\u30ea\u4f53\u8eaf\u30fb\u5e73\u5766\u306a\u80f8\u3002\n\u273d\u670d\u88c5\n- \u4e0a\u534a\u8eab\u306f\u3001\u7d3a\u8272\u30bb\u30fc\u30e9\u30fc\u670d\u306e\u4e0a\u306b\u767d\u8863\u3092\u7740\u7528\u3002\u80f8\u306e\u30b9\u30ab\u30fc\u30d5\u306f\u8d64\u3001\u30e9\u30a4\u30f3\u306f\u767d(\u895f2\u672c\u3001\u80f8\u51431\u672c)\u3002\u672c\u4eba\u304b\u3089\u898b\u3066\u53f3\u80f8\uff5e\u8179\u306b\u3001\u202a\u202a\u2715\u5f62\u306b\u3057\u305f\u202c\u767d\u3044\u30c6\u30fc\u30d7(\u5927\u5c0f2\u7b87\u6240)\u3067\u7834\u308c\u3092\u88dc\u4fee\u3057\u3066\u3042\u308a\u307e\u3059\u3002\n- \u767d\u8863\u306f\u30dc\u30ed\u30dc\u30ed\u306e\u8584\u6c5a\u308c\u305f\u7269\u3002\u8896\u53e3\u3084\u88fe\u3082\u713c\u3051\u7126\u3052\u3066\u7a74\u3060\u3089\u3051\u3002\u8896\u306f\u30d6\u30ab\u30d6\u30ab\u306b\u5e83\u304f(\u6372\u3089\u305a)\u3001\u88fe\u3082\u30b3\u30fc\u30c8\u306e\u3088\u3046\u306b\u9577\u3081\u3002\u307e\u305f\u4eca\u56de\u306f\u300c\u4e21\u80a9\u3092\u7740\u5d29\u3055\u305a(\u8cc7\u6599\u753b\u50cf\u2460\u306e\u3088\u3046\u306b\u534a\u8131\u304e\u306b\u305b\u305a)\u306b\u3001\u2461\u2462\u306e\u3088\u3046\u306b\u304d\u3061\u3093\u3068\u7fbd\u7e54\u3063\u3066\u3044\u307e\u3059\u300d\u3002\n- \u4e0b\u534a\u8eab\u306f