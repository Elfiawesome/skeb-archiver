イパー（参考資料※1）」さんのイラストです。\n\n■リクエスト内容\n背景：朝焼けの見える水辺。参考資料※2のようなイメージを想定しています。\n詳細な構図はお任せいたします。\n\nまた可能であれば、\n・本人の立ち絵のみの透過差分\nもいただけますとありがたいです\n\n■使用用途\n・ご本人へのプレゼント\n・Twitter等のSNSへの掲載\n・TwitchやYoutubeの配信画面やサムネイル（ご本人の利用、トリミング等編集がなされる可能性があります）\n・Twitchやyoutubeの配信サブスクの特典（トリミング等編集がなされる可能性があります）\n\n\n色々とご無理を申しまして恐れ入りますが、お引き受けいただけますと幸いです\nどうぞよろしくお願いいたします\n\n---以下、参考資料---\n※1立ち絵・キービジュアル\nhttps://lit.link/hyperzio\n・配信での公開情報で、身長は164cmぐらいとのことでした\n\n※2 soramick様2022年9月12日投稿\nhttps://x.com/soramick_/status/1569090912684314624", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@soramick_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 818761, "client_id": 3321010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53eb7045/uploads/origins/438eb6ca-5591-4407-8c80-a014108bf413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b9c35b83a1103c5679e967be5bc4509", "srcset": "https://si.imgix.net/53eb7045/uploads/origins/438eb6ca-5591-4407-8c80-a014108bf413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b9c35b83a1103c5679e967be5bc4509, https://si.imgix.net/53eb7045/uploads/origins/438eb6ca-5591-4407-8c80-a014108bf413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbcc7118a349da17185105984dc3e573 2x, https://si.imgix.net/53eb7045/uploads/origins/438eb6ca-5591-4407-8c80-a014108bf413?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cf242ec9cd353f94dbf108a3009c101 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53eb7045/uploads/origins/438eb6ca-5591-4407-8c80-a014108bf413?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb4cfa2724c9b20815be48ec19ce6130", "srcset": "https://si.imgix.net/53eb7045/uploads/origins/438eb6ca-5591-4407-8c80-a014108bf41