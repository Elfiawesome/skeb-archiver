9e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=165136bb0d76122e9ad878d44942bc30", "srcset": "https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=165136bb0d76122e9ad878d44942bc30, https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8080d411df5d0c8c5670c3dd3bf9b160 2x, https://si.imgix.net/c266393e/uploads/origins/eecd659e-f1d5-45d0-99ce-1f321ae8e2c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7776fe8245e9c0083e4e8ad35eea4013 3x"}, "body": "はじめまして。なゃんと申します。\n　鮫福様のイラストをTwitterで拝見してとても惹かれまして、自分のうちの子もぜひ描いていただきたい！と思い、依頼させていただきます。\n依頼の内容については以下の通りとなります。\n\n【描いていただきたいもの】\n　以下の２人のうち、鮫福様がいいなと思ったキャラクターをどちらか選んで描いていただきたいです。\n　notionのURLを添付いたしますので、長文で恐縮ですがご確認いただけますと幸いです。\n\n＜シチュエーション＞\n　希望のシチュエーションはどちらの子を選んでも以下の通りでお願いします。\n・普段は絶対に着ないような衣装を身にまとっている一幕。\n・具体的な服装・髪型については鮫福叶夢様がいちばん彼女たちに似合いそうなものにしていただけると嬉しいです。カジュアル・フォーマルは問わず、コスプレみたいのでもとても嬉しいです。\n\n＜希望のキャラクター（どちらか）＞\n　お願いしたいキャラクターは以下のふたりのどちらかでお願いします。\n　どちらの子も同じくらい思い入れが強い子なので、お好きな方を描いていただければと思います。\n\n①越智　雪海（https://scarce-scorpio-86c.notion.site/Skeb-TRPG-2bad16e4ed5380a0b767ff646a2c7687）\n　「仲の良い人間が死んでしまう」という呪いにも似た運命を背負い、人との関わりを絶っていた女性です。\n　感情表現に乏しくはありますが、思いやりに溢れ、少し世話焼きな一面も持ち合わせています。\n\n②浜綿　夕梨花（はまわた　ゆりか）（https://scarce-scorpio-86c.notion.site/Skeb-TRPG-15ed16e4ed5380ea815fee639f340fe7）\n　弱気な自分を卓越した演技力で隠しながら、演劇の舞台で活躍する女性です。\n　弱いところはありますが、意志はとても強く、誰かの幸せのために奔走できる子です。\n\n　おまかせしてしまう部分が多く、お手数をお掛けして申し訳ございません。\n　難しいようでしたら、リクエストを蹴って頂いても構いません。\n　お忙しいところたいへん申し訳ございませんが、ご検討いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samefuku_kn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3648