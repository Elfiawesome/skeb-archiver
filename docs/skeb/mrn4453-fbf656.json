3590-a383-442a-a33d-3d696a1a4ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2df120b3efa63ed350b4638c73f0ce5b, https://si.imgix.net/5abeb2d9/uploads/origins/66ac3590-a383-442a-a33d-3d696a1a4ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd1592c5556b4d7c69c3d3e4617fdff6 2x, https://si.imgix.net/5abeb2d9/uploads/origins/66ac3590-a383-442a-a33d-3d696a1a4ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ac5852220d240e964731abd4c736b3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5abeb2d9/uploads/origins/66ac3590-a383-442a-a33d-3d696a1a4ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea613b5e182db689d40040507e4dcc0c", "srcset": "https://si.imgix.net/5abeb2d9/uploads/origins/66ac3590-a383-442a-a33d-3d696a1a4ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea613b5e182db689d40040507e4dcc0c, https://si.imgix.net/5abeb2d9/uploads/origins/66ac3590-a383-442a-a33d-3d696a1a4ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee222cd94efc0ae49b57c8ea11f031bb 2x, https://si.imgix.net/5abeb2d9/uploads/origins/66ac3590-a383-442a-a33d-3d696a1a4ba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b9693aa99f63130d8a071b406eecea6 3x"}, "body": "初めまして、れーはと申します！\nはまやらわ様のイラストがとても素敵だと思い、依頼をさせていただきたいと考えています！\n\n①キャラクター\n「maimaiでらっくす」の7sRefちほー4に登場する「W?K?Y?」というキャラクターをお願いします。7sRefちほー2の方のW?K?Y?さんではないのでよろしくお願いします！\n\n②用途\nTwitterやDiscordなどのアイコンに使用させていただきたいと考えています！\n\n③構図・表情\n同じく7sRefちほー4に出てくる楽曲「World's end BLACKBOX」の1:20秒あたりでW?K?Y?さんがブラックホールを操作するような描写があるので、このポーズをとっているW?K?Y?さんをお願いします(こちらはリンク付きで資料を添付させておきます)。ブラックホールや背景なども一緒に描いていただけるととても嬉しいです。\n表情についてなのですが、ペストマスクが左目の部分だけ露出しているので、そこから不敵な笑みや何かを企んでいるような、怪しげな表情をお願いします。\n\n④資料リンク\nW?K?Y?さんを描かれたご本人様のツイート\nhttps://x.com/haetataki_848