\u89b3\u3067\u3059\u3002 (\u305f\u3060\u3057\u3001\u53c2\u8003\u6587\u732e\u3064\u306a\u304c\u308a\u3067\u73fe\u4ee3\u30d1\u30ed\u306e\u8bbe\u5b9a\u3082\u6df7\u3056\u3063\u3066\u3044\u307e\u3059\u304c)\n\n\u8d64\u9aea=F\u3001\u91d1\u9aea=L\n\nF\uff1a187cm, \u4eba\u9593\u738b\u56fd\u306e\u738b\u3001\u6c11\u8846\u304b\u3089\u611b\u3055\u308c\u308b\u5584\u826f\u306a\u6307\u5c0e\u8005\u3002\u5e38\u306b\u81ea\u5206\u306e\u8cac\u4efb\u3068\u56fd\u5bb6\u306e\u554f\u984c\u3092\u6700\u512a\u5148\u3059\u308b\u3002\u6700\u7d42\u306b\u56fd\u3092\u5b88\u308b\u305f\u3081\u306b\u81ea\u5206\u3092\u72a0\u7272\u306b\u3059\u308b\u3002\nL\uff1a175cm, \u738b\u306e\u5074\u8fd1\u3068\u3057\u3066\u6700\u5f37\u306e\u88dc\u4f50\u5f79\u3060\u3063\u305f\u3002 \u5f8c\u306b\u738b\u3092\u88cf\u5207\u308a\u3001\u6575\u306e\u5074\u306b\u3064\u304f\u3053\u3068\u3092\u9078\u629e\u3057\u305f\u3002\n\n\u4e8c\u4eba\u306e\u95a2\u4fc2\uff1a\u4e8c\u4eba\u306f\u4e00\u7dd2\u306b\u80b2\u3063\u305f\u5144\u5f1f\u3067\u3042\u308b\u3002\uff08\u8840\u306e\u3064\u306a\u304c\u308a\u306f\u306a\u3044\u3002\uff09 \u5e38\u306b\u304a\u4e92\u3044\u3092\u6700\u3082\u4fe1\u983c\u3057\u5408\u3044\u3001\u6700\u9ad8\u3067\u7279\u5225\u306a\u89aa\u53cb\u3067\u3042\u3063\u305f\u3002\nF to L\uff1a\u4e16\u754c\u3067\u4e00\u756a\u7279\u5225\u79c1\u306e\u5f1f\u3002 \u56fd\u306e\u884c\u4e8b\u4ee5\u5916\u306e\u3053\u3068\u306b\u6700\u3082\u95a2\u5fc3\u3002F\u306f\u306a\u305cL\u304c\u81ea\u5206\u3092\u88cf\u5207\u3063\u305f\u306e\u304b\u308f\u304b\u3089\u306a\u3044\u3002 F\u306f\u60b2\u3057\u307f\u3068\u6012\u308a\u3092\u611f\u3058\u306a\u304c\u3089\u3082\u3001L\u306e\u9078\u629e\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3092\u9078\u3076\u3002\nL to F\uff1a \u5f7c\u306e\u305f\u3081\u306b\u5168\u3066\u3092\u6367\u3052\u305f\u3044\u3068\u601d\u3046\u307b\u3069\u611b\u3057\u3066\u3044\u307e\u3057\u305f\u3002 \u3057\u304b\u3057\u3001\u305d\u3093\u306a\u6c17\u6301\u3061\u3092\u8868\u73fe\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u306a\u3044\u3002 \u56fd\u3092\u5b88\u308b\u7fa9\u52d9\u306e\u305f\u3081\u306b\u3001\u9045\u304b\u308c\u65e9\u304b\u308cF\u304c\u6b7b\u3093\u3067\u3057\u307e\u3046\u3053\u3068\u3092\u6050\u308c\u3066\u3001L\u306f\u53bb\u308b\u3053\u3068\u3092\u9078\u3093\u3060\u306e\u3060\u3002L\u306fF\u306b\u5bfe\u3057\u3066\u308f\u3056\u3068\u6575\u5bfe\u3067\u98c4\u3005\u3068\u3057\u305f\u614b\u5ea6\u3092\u3068\u308b\u304c\u3001\u5b9f\u969b\u306f\u8ab0\u3088\u308a\u3082F\u3092\u5927\u5207\u306b\u601d\u3063\u3066\u3044\u308b\u3002\n\n\u304b\u3064\u3066L\u306fF\u3092\u3068\u3066\u3082\u8a87\u308a\u306b\u601d\u3044\u3001\u5f7c\u306e\u5922\u306e\u5b9f\u73fe\u306b\u5354\u529b\u3057\u3088\u3046\u3068\u601d\u3063\u3066\u3044\u305f\u3002 \u3057\u304b\u3057\u3001F\u304c\u9078\u3093\u3060\u9053\u306f\u3001\u6c7a\u3057\u3066\u826f\u3044\u7d50\u679c\u3092\u3082\u305f\u3089\u3059\u3082\u306e\u3067\u306f\u306a\u3044\u3053\u3068\u306b\u3001\u6b21\u7b2c\u306b\u6c17\u3065\u3044\u3066\u3044\u3063\u305f\u306e\u3067\u3059\u3002 \u5f7c\u306f\u82e6\u60a9\u3057\u3001F\u304c\u8cac\u4efb\u306e\u6e26\u306b\u98f2\u307f\u8fbc\u307e\u308c\u308b\u306e\u3092\u98df\u3044\u6b62\u3081\u308b\u5225\u306e\u65b9\u6cd5\u3092\u6a21\u7d22\u3059\u308b\u3002L\u306fF\u306e\u7121\u79c1\u306e\u7cbe\u795e\u3068\u5bdb\u5927\u3055\u3092\u618e\u307f\u59cb\u3081\u308b\u3068\u540c\u6642\u306b\u3001\u81ea\u5206\u304c\u4e00\u756a\u597d\u304d\u306a\u306e\u306f\u3001\u3084\u306f\u308aF\u306e\u512a\u3057\u3055\u3068\u6c7a\u65ad\u529b\u3067\u3042\u308b\u3053\u3068\u306b\u6c17\u3065\u304f\u3002\nF\u306b\u3068\u3063\u3066\u306f\u3001L\u304c\u81ea\u5206\u306b\u5bfe\u3057\u3066\u611f\u3058\u3066\u3044\u308b\u611f\u60c5\u306b\u6c17\u3065\u304f\u3053\u3068\u306f\u306a\u304b\u3063\u305f\u3002 L\u306e\u88cf\u5207\u308a\u3092\u5bb9\u8a8d\u3057\u3001\u76f8\u5909\u308f\u3089\u305a\u306e\u5fc3\u914d\u308a\u3092\u3059\u308b\u3002 \u3057\u304b\u3057\u3001\u3082\u3057\u81ea\u5206\u306e\u56fd\u3068L\u306e\u3069\u3061\u3089\u304b\u3092\u9078\u3079\u3068\u8a00\u308f\u308c\u305f\u3089\u3001\u5f7c\u306f\u65ad\u56fa\u3068\u3057\u3066\u81ea\u5206\u306e\u56fd\u3092\u9078\u3076\u3060\u308d\u3046\u3002 (\u540c\u6642\u306b\u3001L\u306f\u8ff7\u308f\u305aF\u3092\u9078\u3076\u3060\u308d\u3046\uff09\u3002\n\n\u3064\u307e\u308a\u3001\u304a\u4e92\u3044\u3092\u6df1\u304f\u601d\u3044\u306a\u304c\u3089\u3082\u3001\u5225\u3005\u306e\u9053\u3092\u6b69\u3093\u3067\u3044\u304f\u4e8c\u4eba\u306e\u7269\u8a9e\u3002\n\uff08L\u306e\u7247\u601d\u3044....\uff08\uff1f\uff09\uff09\n\u4f53\u578b\u5dee\u304c\u3042\u308b\uff01\uff08\u72d7\u732b...\uff09\n\n\u25bc\u5185\u5bb9\u306a\u3069\uff1a\n\u5148\u751f\u306e\u63cf\u304f\u30e2\u30ce\u30af\u30ed\u4f5c\u54c1\u304c\u672c\u5f53\u306b\u5927\u597d\u304d\u3067\u3059\u3002\u4eca\u56de\u6f2b\u753b\u306e\u30b8\u30e3\u30f3\u30eb\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u305c\u3072\u30e2\u30ce\u30af\u30ed\u306e\u3089\u304f\u304c\u304d\u8a70\u3081\u8fbc\u307f\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059...\uff01\n\n\u79c1\u306f\u81ea\u7531\u306b\u63cf\u304f\u306e\u304c\u597d\u304d\u3067\u3059\uff01\u4e8c\u4eba\u306e\u3084\u308a\u53d6\u308a\u3092\u63cf\u304b\u305a\u306b\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u843d\u66f8\u304d\u3084\u8868\u60c5\u7df4\u7fd2\u3060\u3051\u3092\u5358\u7d14\u306b\u63cf\u304f\u306e\u3082\u3044\u3044\u3067\u3059\u3088\u3002\n\u30c6\u30fc\u30de\u3092\u6c7a\u3081\u308b\u306a\u3089\u3001\u3010\u5927\u4eba\u306b\u306a\u3063\u305fX\u304c\u5e7c\u3044Y\u306b\u51fa\u4f1a\u3046\u3011\u3068\u3044\u3046\u30c6\u30fc\u30de\u3067\u63cf\u3051\u307e\u3059\u3002\n\u3082\u3057\u6210\u9577\u3057\u305fF\u304c\u5e7c\u3044L\u306b\u51fa\u4f1a\u3063\u305f\u3089\u3002L\u306f\u304d\u3063\u3068\u9a5a\u304f\u3060\u308d\u3046\u3051\u3069\u3001\u3059\u3050\u306b\u3068\u3066\u3082\u5b09\u3057\u304f\u306a\u308b\u306f\u305a\u3002\u82e5\u3044\u9803\u306e\u5f7c\u306e\u3088\u3046\u306b\u3001F\u304c\u81ea\u5206\u306e\u5922\u3092\u53f6\u3048\u305f\u3053\u3068\u3092\u5fc3\u304b\u3089\u559c\u3076\u3093\u3060\u3002\u305d\u308c\u306b\u52a0\u3048\u3066\u3001\u5c11\u3057\u7167\u308c\u306a\u304c\u3089\u300c\u6210\u9577\u3057\u305f\u50d5\u306f\u307e\u3060\u541b\u306e\u305d\u3070\u306b\u3044\u308b\uff1f\u300d\u3068\u5c0b\u306d\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3002\u3059\u308b\u3068F\u306f\u7b11\u3044\u306a\u304c\u3089\u300c\u4e18\u3061\u3083\u3093\u306f\u305a\u3063\u3068\u4ffa\u306e\u305d\u3070\u3067\u4e00\u756a\u5927\u5207\u306a\u4eba\u3060\u3088\u300d\u3068\u4f1d\u3048\u308b\u3060\u308d\u3046\u3002\uff08\u3053\u306e\u6642\u3059\u3067\u306b\u88cf\u5207\u3089\u308c\u3066\u3044\u308b\u306e\u306b\u306d\uff09\n\u3082\u3057\u5927\u4eba\u306b\u306a\u3063\u305fL\uff08\u30b7\u30e7\u30fc\u30c8\u30d8\u30a2\u30d0\u30fc\u30b8\u30e7\u30f3\uff09\u304c\u5e7c\u3044F\u306b\u51fa\u4f1a\u3063\u305f\u3089\u3001\u898b\u305f\u76ee\u306f\u5927\u304d\u304f\u5909\u308f\u3063\u3066\u3044\u3066\u3082\u3001F\u306f\u304d\u3063\u3068\u4e00\u76ee\u3067\u8ab0\u3060\u304b\u5206\u304b\u308b\u306f\u305a\uff01\u305d\u3093\u306aL\u306f\u304d\u3063\u3068F\u306e\u71b1\u5fc3\u3067\u597d\u5947\u5fc3\u3044\u3063\u3071\u3044\u306e\u8996\u7dda\u3092\u907f\u3051\u3001F\u306f\u300c\u3059\u3054\u304f\u5f37\u305d\u3046\u3060\u3051\u3069\u3001\u75b2\u308c\u3066\u308b\u306d\u3002\u8ab0\u304b\u306b\u3044\u3058\u3081\u3089\u308c\u3066\u308b\u306e\uff1f\u300d\u3068\u8a00\u3046\u3067\u3057\u3087\u3046\u3002\u300c\u4e18\u3061\u3083\u3093\u3092\u3044\u3058\u3081\u308b\u5974\u306f\u7d76\u5bfe\u306b\u8a31\u3055\u306a\u3044\u3001\u305d\u306e\u76f8\u624b\u304c\u4ffa\u3060\u3063\u305f\u3089\u306a\uff01\u6559\u3048\u3066\u3088\u3001\u7d76\u5bfe\u306b\u305d\u3093\u306a\u4eba\u9593\u306b\u306f\u306a\u3089\u306a\u3044\u304b\u3089\u2026\u300dL\u306f\u305f\u3060\u5446\u7136\u3068\u5f7c\u3092\u898b\u3064\u3081\u308b\u3060\u3051\u3067\u3001\u4f55\u3082\u8a00\u308f\u306a\u304b\u3063\u305f\u3002\u3082\u3057\u904e\u53bb\u306b\u623b\u308c\u305f\u3089\u3001\u5f7c\u306fF\u304c\u618e\u3080\u4eba\u738b\u306e\u9053\u3092\u6b69\u3080\u