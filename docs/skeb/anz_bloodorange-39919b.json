る場合は省略してもOKです。\n\n全身は描かなくても良いのですが、毛皮のビキニ＋パレオ姿が見えると嬉しいので膝ぐらいから上を描いて頂ければと思います。\n\nご検討、よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anz_bloodorange/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 156183, "client_id": 341794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e32f46bbf5fd7d9e42ba8b17bacb37cd", "srcset": "https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e32f46bbf5fd7d9e42ba8b17bacb37cd, https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0343284a760e19d4106c28784e1a8dc 2x, https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8aa042f9ca65cc18fcee8af09593db62 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4690b443e666bc8e3b89ac889a9603bd", "srcset": "https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4690b443e666bc8e3b89ac889a9603bd, https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a2bcf89840178d293534b39a503f321 2x, https://si.imgix.net/d8e2c0a7/uploads/origins/0aec16e3-9d62-44ec-9369-155ac50aa642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75c7e739e1953887ee50b0aa56ca9405 3x"}, "body": "東方Projectの八雲紫が騎乗位で致しているイラストをお願いします。\n\n　いわゆる主観視点で、正面からローアングル気味で腕を後ろに置いてのけ反っている形で、表情は庵ズさんの描かれるイメージの強い「キリっとした眉＋少し開いた口元＋セクシーな唇＋赤面」でお願いします。\n　衣装は妖々夢の紫色のドレスを着ていますが、胸の部分は下にズレて巨乳があらわになっており、スカートも捲れて結合部が見えているので服の細かい描写は無くて大丈夫ですが、特徴であるリボンが付いたドアノブカバーのような帽子は被せて頂きたいです。\nちなみに全身を描く必要はなく、下半身は開脚した状態の太ももまで見える位で十分で、背景も無くてOKです。\n\nまた、腰を落としての挿入中なのですが、いわゆるズラシ挿入をお願いしたく、下着の色は黒系でセクシーなイメージだと嬉しいです。\n\nご検討をよろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anz_bloodorange/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 156183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b82626ac/uploads/origins/98de6bde-1da5-4be2-bf6d-2d8ee61753ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b2099faf8de9ba3c15a156b97c4db1", "srcset": "https://si.imgix.net/b82626ac/uploads/origins/98de6bde-1da5-4be2-bf6d-2d8ee61753ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b2099faf8de9ba3c15a156b97c4db1, https://si.imgix.net/b82626ac/uploads/origins/98de6bde-1da5-4be2-bf6d-2d8ee61753ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bad3cd18ccbefb2491bd9d3b583dfc9 2x, https://si.imgix.net/b82626ac/uploads/origins/98de6bde-1da5-4be2-bf6d-2d8ee61753ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a6aed55b2b8da0fadf7a8bf13c73570 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b82626ac/uploads/origins/98de6bde-1da5-4be2-bf6d-2d8ee61753ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a77a18808ac0a31801b5429aa5d40821", "srcset": "https://si.imgix.net/b82626ac/uploads/origins/98de6bde-1da5-4be2-bf6d-2d8ee61753ff?bg=%