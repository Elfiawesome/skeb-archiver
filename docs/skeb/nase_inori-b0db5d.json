は資料URLにこんな感じというイメージ画像を入れています。\n・マスコットはピエロ顔のプロレスラー、ドナドナミートマン(日本ではドナ肉マン、ドナミトさん呼びで親しまれる)\n・商品名は基本○○マッスルバーガー\n・ユウヤたちが食べたのはモノノフマッソー(サ○ライマック)\n\n\nユウヤにJapanのburgerの味に参ったぜしてもらおうと閃いたのが今回の依頼のきっかけでした。\n\n\n要望は以上です。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jYXFa5axmDXm_POBCCULKT_xpb75ksCh", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nase_inori/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3230263, "client_id": 181347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3be898a/uploads/origins/b02c43f3-1394-4f30-896c-49dfd07bc1aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75efd63399bd981ac935ab43790e89b", "srcset": "https://si.imgix.net/a3be898a/uploads/origins/b02c43f3-1394-4f30-896c-49dfd07bc1aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d75efd63399bd981ac935ab43790e89b, https://si.imgix.net/a3be898a/uploads/origins/b02c43f3-1394-4f30-896c-49dfd07bc1aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29d006c542c9eb187c6934c0094bf3e5 2x, https://si.imgix.net/a3be898a/uploads/origins/b02c43f3-1394-4f30-896c-49dfd07bc1aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91d4987a46567ca8120384d3154dda7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3be898a/uploads/origins/b02c43f3-1394-4f30-896c-49dfd07bc1aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6709d0ac9699c97dbfb9c1d14ce6b522", "srcset": "https://si.imgix.net/a3be898a/uploads/origins/b02c43f3-1394-4f30-896c-49dfd07bc1aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6709d0ac9699c97dbfb9c1d14ce6b522, https://si.imgix.net/a3be898a/uploads/origins/b02c43f3-1394-4f30-896c-49dfd07bc1aa?bg=%23fff&auto=