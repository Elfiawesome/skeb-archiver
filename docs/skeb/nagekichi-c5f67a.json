fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca71423ba8a725f76802401f61f560b, https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95427d78bb907713ec0eb6a5d87dd900 2x, https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c955ce2d7f4fb452406c3cb18b96663d 3x"}, "body": "こんにちは！\nあなたのアートスタイルの大ファンで、私のオリジナルキャラクター（OC）のイラストを依頼できればと思っています！\n彼はかなりエッジの効いたウォーロックキャラクターです！もしよろしければ、少しアクションシーンの構図にしていただきたいです！血やそれに類する描写も全く問題ありません！\n\nまた、彼はモンスターに変身する能力も持っているので、その要素を取り入れていただけると嬉しいですが、もちろん必須ではありません！ \n\nこちらに、彼の参考画像がすべて入ったフォルダのリンクがあります：\nhttps://drive.google.com/drive/folders/1XJ5-PWAdArj3nVnl8xnu9_xEZlXxhbh2?usp=sharing\n\nご検討いただき、誠にありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagekichi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3615980, "client_id": 2488431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c9d878395e9aa36fe85bad0eddcc4b0", "srcset": "https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c9d878395e9aa36fe85bad0eddcc4b0, https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1928469ba7ce8f86b9013b68a4334d6b 2x, https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b854e144110dfaf1ebd66b6a57aaaf7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba3448ef65d281c94548163b2f08e68", "srcset": "https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba3448ef65d281c94548163b2f08e68, https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94f89b0f763c3b8f996b488e4086eea2 2x, https://si.imgix.net/da9eefee/uploads/origins/7cee428a-68a4-43e4-a097-bdc06975f310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6df097ba2a002fc21a07c88c61d1deb 3x"}, "body": "なげキチ様  \nはじめまして、突然のメッセージ失礼いたします。 血璃と申します。  なげキチ様が出品されている作品を見て、ぜひ制作をお願いさせていただきたく、 メッセージさせていただきました。 以下に依頼したい内容を記載させていただきます。\n --------------- \n\n戦闘中のダイナミックなアクションポーズを希望します。\n武器は西洋剣（レイピア系）で、鋭く素早い突きや斬撃の動きが感じられる構図にしていただけると嬉しいです。\n\n背景はBloodborneに登場する「禁忌の森」のような、不気味で湿った空気感のある森をイメージしています。\n霧が立ち込め、ねじれた木々や不穏な雰囲気が漂う、ダークで退廃的な世界観だと理想的です。\n\n全体として、緊張感と危険性が伝わる演出をお願いしたいです。\n\n\n --------------- \n\n\nキャラクター名：血璃\n外見年齢：27\n瞳の色：深紅\n肌：白\n希望する雰囲気：陰鬱/陰気/無口/ダーク\n個性：物静かで寡黙\n表情：無表情\n\nイラストの使用用途：自用\n\nhttps://drive.google.com/drive/folders/1c3jYiYIeINhyK04gMqwmuvsbatJHlwVt", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagekichi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3615980, "client_id": 1494963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e9b6b9d4f2b430388500838b2fb5bdb", "srcset": "https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e9b6b9d4f2b430388500838b2fb5bdb, https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed340e3ebc61ba929c50e9b236244be4 2x, https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8575fb65e5458b7b7f4fc598ed26526 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55f9e9768a82f4ea2256f9148e8997e8", "srcset": "https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55f9e9768a82f4ea2256f9148e8997e8, https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2e13e0b4e895ae03e5980c2b37e711d 2x, https://si.imgix.net/7b6937e9/uploads/origins/140311e8-7b7b-4684-99fd-06cbc99536d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96eeda7ff0a808558cd99ec7b82d3e49 3x"}, "body": "こんにちは、なげキチ先生。\n\nオリキャラ「ヘル」のイラストを依頼させていただきたいです。\nヘルは、古代から存在する深淵の生体鎧。\n無口で冷徹、強い殺気を纏った存在です。\n身長は約2メートルほどで、両手剣を片手で扱う戦闘スタイル。\n首を斬り落とすことを得意とするイメージがあります。\nまた深淵の存在であるため、剣を振るうと墨のような軌跡が残ります。\n背景は『Bloodborne』のような雰囲気を参考にしていただけると嬉しいです。\nポーズや構図はおまかせで、危険さや圧倒的な強さが伝わる表現だとありがたいです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1EXPkljD_OGTNK-JJP1YrTHBMWp2idtij/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "sim