ます。\nマントのありなしはお任せします！\n可能であればマスコットも描いて頂ければ嬉しいです！\n\nhttps://drive.google.com/drive/folders/1yCjFtVoy6KoYL76XygXi2wGfkiOLvDya?usp=sharing\n\n以上となります。\n\n不安定な天気が続いておりますので、どうぞご体調にはお気を付けくださいませ。\nご検討のほど、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurumi1202kuru/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3647018, "client_id": 2439551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5dc96a0/uploads/origins/ade0338c-dfe3-427d-902d-6971fb5ae5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea2e71a5b37128d72bff1a6d8ef9978d", "srcset": "https://si.imgix.net/d5dc96a0/uploads/origins/ade0338c-dfe3-427d-902d-6971fb5ae5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea2e71a5b37128d72bff1a6d8ef9978d, https://si.imgix.net/d5dc96a0/uploads/origins/ade0338c-dfe3-427d-902d-6971fb5ae5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1831ab0c37d74f179cdb935565c7108 2x, https://si.imgix.net/d5dc96a0/uploads/origins/ade0338c-dfe3-427d-902d-6971fb5ae5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f605a4c93b8e5107e0f776b9b9a70aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5dc96a0/uploads/origins/ade0338c-dfe3-427d-902d-6971fb5ae5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dffb3e49cbd1b7a24eeeb72d3a1f5315", "srcset": "https://si.imgix.net/d5dc96a0/uploads/origins/ade0338c-dfe3-427d-902d-6971fb5ae5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dffb3e49cbd1b7a24eeeb72d3a1f5315, https://si.imgix.net/d5dc96a0/uploads/origins/ade0338c-dfe3-427d-902d-6971fb5ae5b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8a0b98