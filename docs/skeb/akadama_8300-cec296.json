お任せします。時期は冬で雪が降っている場所で服は冬服でお願いしたいです。服はお好きにアレンジしていただいて構いません。描きやすいように描いていただけましたら幸いです。\nイラストは横向きでお願いします。\n\n使用用途につきましては、壁紙等の個人的な使用、Twitterのヘッダー、個人的なグッズの作成などに使わせていただきたいと思っております。ヘッダーとしての使用の際にはあかだまさんのお名前とID記載させていただきます。\nまたうちよそのお相手とのイラストの共有を可能でしたらさせていただきたいと思っております。\n\nよろしければ、お受けしていただけると大変嬉しいです！\nご検討のほどどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jV563Udy7hdi8CeS73Qfd8jAwjRFFq_a", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akadama_8300/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 970360, "client_id": 2176059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a758641d48f121bc3b04298a75409a0c", "srcset": "https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a758641d48f121bc3b04298a75409a0c, https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=479d1ff615334e85f81f07ac4c07f357 2x, https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7663b4fd15c1b4e98b44ebd334e34e4e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e71c1a2a68d7b938b504f8eb4e99356", "srcset": "https://si.imgix.net/3e834fb9/uploads/origins/c37be117-624d-4327-9da8-43ae558b915d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e71c1a2a68d7b938b504f8eb4e99356, https:/