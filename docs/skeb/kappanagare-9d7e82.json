w=200&h=200&blur=200&s=1cf889d920a35603318d924756df3ea7", "srcset": "https://si.imgix.net/f3bcc688/uploads/origins/4d3e4e4c-9264-4068-98ea-81ad99359e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cf889d920a35603318d924756df3ea7, https://si.imgix.net/f3bcc688/uploads/origins/4d3e4e4c-9264-4068-98ea-81ad99359e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f85cbb751e987536b79c05babc670e0f 2x, https://si.imgix.net/f3bcc688/uploads/origins/4d3e4e4c-9264-4068-98ea-81ad99359e3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa10c169953919aa4bcf55d3c2821d55 3x"}, "body": "作品：ブルーアーカイブ\nキャラ：桜井ミヨ、仲正イチカ(水着)\n\n内容：ミヨと水着イチカに挟まれ、両方からハロウィンボイスを囁かれる先生の絵(漫画)\n・ミヨは先生に飴を食べさせながらハロウィンボイス\n・イチカは先生の手を両手で握って、先生の持ってる棒付き飴を食べながらハロウィンボイス\n・先生は両側から攻められて、デス１３に悪夢を見せられた花京院みたいに「うわああああ！！」と叫んでいる(ここは省いてもいいです)\n\nミヨと水着イチカのハロウィンボイスに脳がやられてしまった為依頼させていただきました\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kappanagare/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 277173, "client_id": 2306257, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42d24c486df1983490febf65aa54d89f", "srcset": "https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42d24c486df1983490febf65aa54d89f, https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d52cad3ec3fb39d6c3c36747e1c7ea16 2x, https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddd37dd9cf8942b3aa60c0dbe9640b56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c5aa5a4036463948cc60046657907b9", "srcset": "https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c5aa5a4036463948cc60046657907b9, https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aac8c3e4f71e67a4208d51d45fa63410 2x, https://si.imgix.net/4531a2c7/uploads/origins/3ae7c580-39ba-4be7-bfb5-bc0407b6a3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec673a3f5b17db0e8b3b6a96b8ed0e51 3x"}, "body": "河流れ先生\nいつもお世話になっております。\n\n●依頼内容\n【ブルーアーカイブ】の『早瀬ユウカ』を描いて頂きたいです。\n自分用に「ユウカ」のカレンダーを作成をしております。\n河流れ先生には10月をイメージしたカレンダー用のフルカラーイラストを描いて頂きたいです。\n\n●用途\nパソコン、スマホの待ち受け画面（自分用）\n\n●詳細\n・ブルーアーカイブの早瀬ユウカをお願いします。\n・10月のイメージでユウカを描いて欲しいです。\n・その月のイメージは、河流れ先生のイメージにお任せします。\n・ユウカをメインにして下されば後はお任せします。\n※他のブルアカの生徒やユウカの服装、背景有無等\n・文字等入れても入れなくても問題ないです。\n・サインをつけれるのであればつけてほしいです。\n・ファイルのサイズはA4サイズ横(幅4,093px、高さ2,894px)の解像度350dpiでお願い致します。\n\n●依頼価格\n以上の内容でおまかせ金額+での依頼とさせていただきましたがご納得いただけない場合は断って頂いて大丈夫です。\n\n●最後に\n依頼内容が不明瞭な場合、上記の内容が難しい場合も断って頂ければと思います。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kappanagare/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 277173, "client_id": 335424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e33e7d35/uploads/origins/db5070dd-511a-47c0-b74d-206a8021a2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e825c5c5d4a92ad85c