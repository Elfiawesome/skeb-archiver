ur=200&s=ca780cd22e863f0e9bf53bd654e3e947, https://si.imgix.net/9e41f96f/uploads/origins/f2975321-ed95-47ab-b29f-0c235a3814c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27ad8f78b7d4d6d1c8bee118cf4766c6 2x, https://si.imgix.net/9e41f96f/uploads/origins/f2975321-ed95-47ab-b29f-0c235a3814c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=180a0a0de14d04340e4aab91344ce9a0 3x"}, "body": "こんにちは。五つ子のニノとミクが風太郎を騙すために同じ格好をしている作品をお願いしたいです。二人の髪型をハーフ＆ハーフにして、半分を四葉カラー、半分をニノカラーにして、アクセサリーもそれぞれのハーフにつけて、さらに風太郎をだます。二人は横乳を押し付け合って横抱きになり、「私はニノなのか、ヨツバなのか、それとも両方なのか」と風太郎を見ている。\n\n二人はお揃いの体を包み込むオープンストラップのドレスを着ている。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiyokusan001/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1843825, "client_id": 2042838, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490abfb57dd87788d4cd839ee4375ed5", "srcset": "https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490abfb57dd87788d4cd839ee4375ed5, https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4201b478a4be37a691282d1943aba8c 2x, https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f1aedff63560886a17a761b0738d35f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b86dbaba95332df8248b651770b54b86", "srcset": "https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b86dbaba95332df8248b651770b54b86, https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a43cb67eece7f769fb5e0aa5e260e15 2x, https://si.imgix.net/aa282b00/uploads/origins/79ce7b16-6fe4-4dee-8902-0c0aece68ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a6a90407f000c0a45193e311ce495b2 3x"}, "body": "こんにちは、\n\nキャラクター\n雪ノ下陽乃 from やはり俺の青春ラブコメはまちがっている。\n\n毛先の紫色のグラデーションに注目。\n\n濃い紫色のパジャマ上下を着ている。\nブラトップなし。または、ブラの有無のバリエーション。\nしかし、必要であればバリエーションを省略すればよい。\n\nボタンがゆるく、ボタンの間から肌が見えるようにする。\n\nhttps://www.pixiv.net/en/artworks/106703040 など、過去の絵のように胸が大きい。\n\n顔の表情\n1) いたずら好き・誘惑好き\n2)普通/微笑み\n3)ウィンク(やり過ぎない程度に)\n\nあなたのプロセスで顔のバリエーションがどれくらい難しいかわからないので、バリエーションが難しければ1つ省略することも可能ですが、可能であればありがたいですね。\n\nポーズについては、胸と腰の曲線が見えるようなもの。\nだから、少し低い位置で、少し横からのアングルとか？\nでも、ポーズは自分次第なので、自分が一番いいと思うアングルに編集してください。\n\nできれば、膝から上、もしくは全身のほとんどが見えるものが望ましいです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1OhUEB_9wnRLdWB6hhvlO8Q3PAtTr_5Rx?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hiyokusan001/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1843825, "client_id": 977462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7da2182d/uploads/origins/2878fea0-88a4-4fed-bf07-bb0276450f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7029cc65c5cb5979036a5bac75bb40a6", "srcset": "https://si.imgix.net/7da2182d/uploads/origins/2878fea0-88a4-4fed-bf07-bb0276450f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&