肌が見えるようにしてもらえないでしょうか。\n\n台詞は、彼女が世界を征服するのがどんなに楽しいか、そしてみんなが彼女の奴隷になるのがどんなに楽しいかという邪悪なことを言わせてください。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hakobune4545/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3836aac9f8035a362af844682cbe297b", "srcset": "https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3836aac9f8035a362af844682cbe297b, https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9564b7deb1c4169193ff6beca4c2a65e 2x, https://si.imgix.net/84ff34ec/uploads/origins/092173b9-6722-44db-ad7c-d1227fd5b94c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7e83264bcb3d2171400f7ccdbed85f60 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3551046, "nc": 51}], "sent_works": [], "similar_creators": [{"id": 7156, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "hari◢◤くぉ", "screen_name": "hari_quartzshow", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F2f42011e-9de4-4544-99b8-590f090e5443.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fa74edef-8136-40f1-b19f-503b2b1333eb.png", "appeal_receivable": false, "popular_creator_rank": n