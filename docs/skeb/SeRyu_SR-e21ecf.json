on-MJ-and-Diane-1036509598）を希望します。この時うららちゃんは魔女を相手にしているので変身した状態にすることと、くっついたネバネバの色は前回と同様のピンク色としつつ、足のネバネバをくるぶしの位置あたりまで覆うことが条件です。魔女はイラストになくても構いませんし、背景も簡単なものでいいです。\n以上よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SeRyu_SR/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2915193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32e86676/uploads/origins/4be65d17-00e3-4140-84ac-07ba88c447bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2354eb6dfb998ebc532e5e9bd50d0ddd", "srcset": "https://si.imgix.net/32e86676/uploads/origins/4be65d17-00e3-4140-84ac-07ba88c447bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2354eb6dfb998ebc532e5e9bd50d0ddd, https://si.imgix.net/32e86676/uploads/origins/4be65d17-00e3-4140-84ac-07ba88c447bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4ca8006d907cf914e000790da66896f 2x, https://si.imgix.net/32e86676/uploads/origins/4be65d17-00e3-4140-84ac-07ba88c447bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f30a517da60451f2fb63b0d2ddb9482 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32e86676/uploads/origins/4be65d17-00e3-4140-84ac-07ba88c447bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=434a821b9c23d2b705b9bb50b4575746", "srcset": "https://si.imgix.net/32e86676/uploads/origins/4be65d17-00e3-4140-84ac-07ba88c447bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=434a821b9c23d2b705b9bb50b4575746, https://si.imgix.net/32e86676/uploads/origins/4be65d17-00e3-4140-84ac-07ba88c447bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=674f752ce2d9388da163edcf0d37c52e 2x, https://si.imgix.net/32e86676/uploads/