re": "art", "tipped": false, "creator_id": 5525, "client_id": 1319247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1ce5857ceef49ba7b2268dbe2005c6d", "srcset": "https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1ce5857ceef49ba7b2268dbe2005c6d, https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10ae394ed4bf890aa6e9143b231aeb64 2x, https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=720a65a1bd057204eb4799e3f31f5b79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f78a5537f90bb2e2b5b8e74b132ec2", "srcset": "https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f78a5537f90bb2e2b5b8e74b132ec2, https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05afa47b0c9d78d918c6d3ae035f7435 2x, https://si.imgix.net/c71d1746/uploads/origins/dedba8fb-5bb2-4ea5-aadd-1db042085c62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6151890220aebfaaae8cb21f8414ade5 3x"}, "body": "こんにちは！\n誕生日なのでD&DのPCであるリアンドラを描いてくれませんか？\n服装はメイド服だと嬉しいです！癖なので！\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1KGrPU2D96KWcjfsmHTYLaatIBLQ6jRI3", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukihaaya/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5525, "client_id": 3026694, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5abf42ea47cce03c80bc825859332234", "srcset": "https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5abf42ea47cce03c80bc825859332234, https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1842c67526f71543899bb326c57ebe4 2x, https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a401e80e9aa35ed99494c7acfab29fc2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=062a6154f7b01f374dce1721782fdf0d", "srcset": "https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=062a6154f7b01f374dce1721782fdf0d, https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0de308b9f8c287e13883ca85417cb53e 2x, https://si.imgix.net/8248c99a/uploads/origins/bb23a3e8-53d4-41a9-98c8-84e9374b450f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04451ff93e2a06f18518f6b012638ff5 3x"}, "body": "L_PLSです。パーナストの冒険者達のイラストをお願いしたいと思います。アルトン、ロスト、マラサイ、ベルダム、リアンドラですね。\n\nイラストのイメージとしては、激戦！パーナストの戦いの後、傷だらけにになりながらも勝利を祝い笑う合う、みたいな感じです。\nある程度、イメージがあるので一応お伝えします。背景は、がれきが転がっているパーナスト旧市街(すごい細かく描かなくてよくて、なんとなくそんな場所だということが分かれば)。基本的には5人とも全身絵でアルトンが中心にいます。そのアルトンにじゃれている獣に変身したロストがいます(狼か黒豹でしょうか)。獣はロストだと分かるようにしてくれると嬉しい。頭の上にぼんじりが乗っかっているとか。\nそれを取り囲むようにマラサイ、リアンドラ、ベルダムがいます。マラサイの魔法の武器(斧)であるリトーターは描いてくれると嬉しい。地面に刃側を置いて、柄にもたれかかっている、みたいなイメージでしょうか(構図が複雑であれば自由に決めてくださって問題ないです)。この魔法の斧の柄頭にはアクアマリンが嵌ってます。\n５人の全身絵で背景も多少ある……難しいようであれば、要素を削ってくださいませ(例えば全身絵でなくすとか、背景をなくすとか、ロストは人間形態であるとか)。\n\nあくまでリクエストなので、基本的にはパーナストの冒険者達５人の集合絵であれば、雨野さんが楽しめるように描いてくださって構いません。よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukihaaya/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5525, "client_id": 2546030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a046e085/uploads/origins/0adab886-f35f-4652-b812-f9c80745216e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70989b75078d608ffd6ea225a5c8b3d1", "srcset": "https://si.imgix.net/a046e085/uploads/origins/0adab886-f35f-4652-b812-f9c80745216e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70989b75078d608ffd6ea225a5c8b3d1, https://si.imgix.net/a046e085/uploads/origins/0adab886-f35f-4652-b812-f9c80745216e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc1bc51bcbdc13c0062e89901604d436 2x, https://si.imgix.net/a046e085/uploads/origins/0adab886-f35f-4652-b812-f9c80745216e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cad037e1c1319b31848e9cec0753ad73 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a046e085/uploads/origins/0adab886-f35f-4652-b812-f9c80745216e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&b