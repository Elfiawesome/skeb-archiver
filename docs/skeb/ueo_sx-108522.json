c0-fa85-446e-8caf-af2ae1e9dfbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ab13f03516a7929ea7452f2cc50a56 2x, https://si.imgix.net/b1e14548/uploads/origins/7ac0ecc0-fa85-446e-8caf-af2ae1e9dfbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6345856288045874f60f0d258fa6d8b7 3x"}, "body": "前回は大魔王バロウ・グリムドラ様をキャラデザインして下さりありがとうございました！\n同じキャラでリピートリクエストさせて頂きます！\n\n今回描いて頂きたい内容は、｢バロウ・グリムドラ様が力の封印を解かれて、封印前の姿にＴＦ(変身)していくシチュエーション｣のイラストです。\nイラストは３枚です。\n後述するイラスト内容が細かいですので、もしリクエスト内容を変更して欲しい場合は再送要求をお願いします。\nどうか最後までお読み頂ければ幸いです。\n\n[イラスト内容]\nイラスト①：幼竜から成竜へと、マズルが徐々に伸びて顔が変化していくイラスト。\n真横向きの構図で、口を大きく開けたままマズルがグググッと伸びていく顔のイラストを、１ページ内に４段階（幼竜→[中間１]→[中間２]→成竜）に分けて描いて下さい。\n\nイラスト②：身体が大きくなり、成竜の姿に戻っていくイラスト。\n背中側を映した、長いシッポが映えるような構図。\n\nイラスト③：変身が完了し、怪獣や魔獣のごとく雄叫びを上げているイラスト。\n封印前の姿の、全身あるいは顔のアップを映した構図。\n\n難しいことと思いますが、ご検討の程、何卒よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ueo_sx/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3687157, "client_id": 2376529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a738692/uploads/origins/b950b4a1-b350-4add-bd03-13dd20d28e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d34602a89ddc1e934ef5346f4d095b1f", "srcset": "https://si.imgix.net/4a738692/uploads/origins/b950b4a1-b350-4add-bd03-13dd20d28e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d34602a89ddc1e934ef5346f4d095b1f, https://si.imgix.net/4a738692/uploads/origins/b950b4a1-b350-4add-bd03-13dd20d28e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9538a72844658f86a8ec01a367152c64 2x, https://si.imgix.net/4a738692/uploads/origins/b950b4a1-b350-4add-bd03-13dd20d28e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a8d78aca842f3a4d0841dc76c6d44c2 3x"}, "duration