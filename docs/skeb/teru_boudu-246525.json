首大きめを希望\n・モンスターはエルダーグール(https://fategrandorder.fandom.com/wiki/Elder_Ghoul)を希望しますが、描くのが大変であれば外見はおまかせします(原作にいない外見でもOK)。見切れた部分的で簡素な描写で構いません\n\n◯差分の希望(可能であれば)\n・精神的に壊れて、無反応ではなく犯されて悦ぶようになってしまって、涙を流しながらも瞳の中にハートが浮かべ喘いでいる様子の表情差分\n・妊娠ボテ腹差分", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@teru_boudu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 66074, "client_id": 335896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1506ec92/uploads/origins/9af983ee-7cea-441c-ac41-7947a21bf143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d614d2d6633c355f9d6d3ae071778520", "srcset": "https://si.imgix.net/1506ec92/uploads/origins/9af983ee-7cea-441c-ac41-7947a21bf143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d614d2d6633c355f9d6d3ae071778520, https://si.imgix.net/1506ec92/uploads/origins/9af983ee-7cea-441c-ac41-7947a21bf143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bc46183f364eea66a7e25f63560593d 2x, https://si.imgix.net/1506ec92/uploads/origins/9af983ee-7cea-441c-ac41-7947a21bf143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1bc415b2e40bb7db532e3802030aa664 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1506ec92/uploads/origins/9af983ee-7cea-441c-ac41-7947a21bf143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbbaa9bf12ad5fed20264e896dad00dd", "srcset": "https://si.imgix.net/1506ec92/uploads/origins/9af983ee-7cea-441c-ac41-7947a21bf143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbbaa9bf12ad5fed20264e896dad00dd, https://si.imgix.net/1506ec92/uploads/origins/9af983ee-7cea-441c-ac41-7947a21bf143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=20