pr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7088829e8ea348792b7796a94a9849b6 3x"}, "body": "◯キャラクター\n虞美人（Fate/Grand Order）\nhttps://drive.google.com/drive/folders/1E2p1p-JjLY5w1BCOKd6TzfQSREVadkAW?usp=sharing\n\n◯シチュエーション\n敗北後に大柄な人型モンスターに繁殖目的で犯されているNTR・BADEND的なシチュエーションをお願いします。\n・巨根で乱暴に犯されている\n・過酷な仕打ちで心が折れ、半分白目を剥いてされるがままの様子\n・休みなく犯されており、身体は反応して上気し汗だく\n・・髪型は初期状態の三つ編み髪型で服装はおまかせ、肌露出多めを希望(全裸でもOK)。眼鏡の有無もおまかせ\n・おっぱい、乳輪、乳首大きめを希望、陥没乳首NG\n・モンスターはエルダーグール(https://fategrandorder.fandom.com/wiki/Elder_Ghoul)を希望しますが、描くのが大変であれば外見はおまかせします(原作にいない外見でもOK)。見切れた部分的で簡素な描写で構いません\n\n◯差分の希望(可能であれば)\n・精神的に壊れて、無反応ではなく犯されて悦ぶようになってしまって、涙を流しながらも瞳の中にハートを浮かべ喘いでいる様子の表情差分\n・妊娠ボテ腹差分", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@teru_boudu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 66074, "client_id": 2910672, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62d1670b/uploads/origins/ad57da32-d646-40b0-9d6e-e6f576a6f288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f5a1fee7f56dd2fb4e54653e33e01c4", "srcset": "https://si.imgix.net/62d1670b/uploads/origins/ad57da32-d646-40b0-9d6e-e6f576a6f288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f5a1fee7f56dd2fb4e54653e33e01c4, https://si.imgix.net/62d1670b/uploads/origins/ad57da32-d646-40b0-9d6e-e6f576a6f288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a2dfc0465b2ad1eeae9d9d4c3e7a191 2x, https://si.imgix.net/62d1670b/uploads/origins/ad57da32-d646-40b0-9d6e-e6f576a6f288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed72f6c7974ff3c1331cc3369bf64a2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62d1670b/uploads/origins/ad57da32-d646-40b0-9d6e-e6f576a6f288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h