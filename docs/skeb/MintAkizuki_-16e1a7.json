ンまで開けているとか、腹チラしているとか…\n※こちらも資料の露出の程度を参考にお願いします\n\n・可能であればメガネ差分と煙の上っているタバコ差分をいただけると幸いです！\nポーズや構図を変える必要はなく、\n①メガネタバコ無し\n②メガネ有タバコ無し\n③メガネ無しタバコ有り\n④メガネタバコ有り\nがあると嬉しいです\n不可であれば①のみでお願いします\n\nまた、ご予算が許す限り以下の表情差分もいただきたいです\n上から優先度順です\n①メガネタバコ無しの得意げな表情\n②メガネタバコ無しのやっちゃった…という失敗した表情\n③メガネ有りタバコ無しの得意げな表情\n④メガネ有りタバコ無しのやっちゃった…という失敗した表情\nこちらも不可であれば差分無しで大丈夫です\n\nhttps://drive.google.com/file/d/1P6hWgjAFlPkTkmDjvAo7OXpZrXhDLDcq/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MintAkizuki_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2584667, "client_id": 81118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b8d4ea6/uploads/origins/b69bafb9-89f0-4d51-8f36-caeb21676165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311a9161b1df7be4dbb52017838781ff", "srcset": "https://si.imgix.net/7b8d4ea6/uploads/origins/b69bafb9-89f0-4d51-8f36-caeb21676165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311a9161b1df7be4dbb52017838781ff, https://si.imgix.net/7b8d4ea6/uploads/origins/b69bafb9-89f0-4d51-8f36-caeb21676165?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3833b0c1d7135c5b090518661837314 2x, https://si.imgix.net/7b8d4ea6/uploads/origins/b69bafb9-89f0-4d51-8f36-caeb21676165?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e73cdbf4277eeff31e92a585a8953609 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b8d4ea6/uploads/origins/b69bafb9-89f0-4d51-8f36-caeb21676165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a8b21d3b2590cc2b6e61c75beabee40", "srcset": "https://si.imgix.net/7b8d4ea6/uploads/origins/b69bafb9-89f0-4d51-8f36-caeb21676165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2