1b95a9/uploads/origins/78b66f0e-259f-4760-b126-2e1a4ad20b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24c35d7808fb8e02b88363e384aa9966 2x, https://si.imgix.net/b31b95a9/uploads/origins/78b66f0e-259f-4760-b126-2e1a4ad20b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b101691f2d3b83c0b5673cf4548abc32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b31b95a9/uploads/origins/78b66f0e-259f-4760-b126-2e1a4ad20b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0f33398fed155c39c6f514dbba5b63", "srcset": "https://si.imgix.net/b31b95a9/uploads/origins/78b66f0e-259f-4760-b126-2e1a4ad20b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc0f33398fed155c39c6f514dbba5b63, https://si.imgix.net/b31b95a9/uploads/origins/78b66f0e-259f-4760-b126-2e1a4ad20b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56bad0fc2ab38c014a920e64325d0727 2x, https://si.imgix.net/b31b95a9/uploads/origins/78b66f0e-259f-4760-b126-2e1a4ad20b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a5a92ccecf79c1985c4972e48231890 3x"}, "body": "とろみ様、はじめまして！\nSkeb新着欄から、とろみ様のイラストのおしゃれな色味と可愛らしいタッチに惹かれ、\nTRPGで遊んでいるうちよそのOCを、ぜひとろみ様に描いていただきたくリクエストさせていただきます。\n\n▽関係\n自由奔放な探偵と苦労人の助手/両片想いの幼馴染\n\n▽キャラクター\n【玉木 奈胡/たまき なこ】\n・探偵\n・161cm、29歳\n・ローテンションでマイペースだが、粘り強くタフな性格\n・感性が独特で、趣味は石碑的なオブジェやゆるキャラなどの置物収集\n・事務所の経費で趣味のものを買うので鏡に叱られている（が、なんだかんだ許されている）\n・幼少期の鏡を探偵助手ごっこに巻き込んだ延長線で鏡を頼った\n・中高時代には鏡を異性として意識していた時期もあったが、関係性を壊したくなくて適度な距離感を保っている\n・鏡と恋仲になったら、関係が終わったとき幼馴染にも戻れないのではと思い恋愛に前向きでない\n・鏡にももっと自分のことを頼ってほしい\n\n【鏡 遙真/かがみ とうま】\n・助手\n・174cm、30歳\n・兼業助手。本業は弁護士\n・主に経理や契約関係を請け負っているはずが、調査にも駆り出されている\n・外面は穏やかだが、気を許している玉木相手には自然体で軽口が多い\n・自分がエリートであることを自覚していて尊大\n・他人に弱みを見せたくない。玉木には猶更\n・幼少期に家族を亡くしており、玉木家にサポートしてもらったため一家に感謝している\n・玉木が恋愛関係を望んでいなさそうであるため、自分が恋情を抱いていることに罪悪感がある\n\n▽その他\n・付き合いが長くお互い無意識的に距離が近い\n\nファッションはデフォルトのものでも、自由にしていただいても問題ございません。\nいただいたイラストは個人利用のほか、友人間でのデータ共有、\nまた一部をトリミングしてオンラインでTRPGにて遊ぶ際に、装飾として利用させていただくことがございます。\nもし可能でしたら、人物ファイルを別に納品いただけると嬉しいです！\n金額に不足がありましたら再送依頼をお送りください。\nご縁がありましたらとても嬉しいです、どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1bfHRC5K-o5pwUh5HkGeSYxEwEcBPqJwr?usp=sharing", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Trm_gNo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3313343, "client_id": 2690158, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b51c56088ff888fb658ee626627c0cbf", "srcset": "https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b51c56088ff888fb658ee626627c0cbf, https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ba1a3f88a84ceaeaa07b0d9780300dc 2x, https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4879bd83efe0dff32d36d8ddfa17b55b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3230e4f994d936d32e3487a942951e69", "srcset": "https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3230e4f994d936d32e3487a942951e69, https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=968b4ad7ee9121eb9ec3b19a4ecc52c5 2x, https://si.imgix.net/e9ed7f0d/uploads/origins/1690a6be-9dfd-41e8-a388-43986fb760a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0cc291c37d0f2c3cf85a5fa993a4118d 3x"}, "body": "とろみさん、はじめまして！とろみさんのイラストを拝見させていただきましたら大変可愛らしい絵柄と衣装デザインに惹かれました。よければうちの創作キャラたちもリクエストさせていただきたいです！\n\n女性の方はベアトリス、神秘的な雰囲気を纏い隙を見せない余裕で上品な佇まいをしています。髪は黒がベースで光を当てると金色に変わる部分があります。衣装ですが、資料に載ったデザインと違い、相方を護る「騎士」をイメージしたアレンジをお願いしたいと思います。\n\n男性の方はシエロ、アキクサインコ(ルビノー)がモチーフの子です。ピンクと金色のグラデーションの髪と、瞳に星型の金色の輝きが宿っているのが特徴です。穏やかな性格に知識と好奇心の持ち主でもあります。見た目もやや中性寄りなので、衣装はふんわりでドリーミーなものが良いと思います。\n\n二人はカップルなので、デザインにちょっとした小ネタや繋がりがあると嬉しいです。\n\nご検討よろしくお願いいたします！\n\nhttps://imgur.com/a/LalI6hs", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Trm_gNo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3313343, "client_id": 3721969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6a943d8/uploads/origins/1fae7b31-068c-4ca1-a6a7-9b935e5482df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c6bab2bf5ee21ad62d47de3b8c2e1a", "srcset": "https://si.imgix.net/b6a943d8/uploads/origins/1fae7b31-068c-4ca1-a6a7-9b935e5482df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c6bab2bf5ee21ad62d47de3b8c2e1a, https://si.imgix.net/b6a943d8/uploads/origins/1fae7b31-068c-4ca1-a6a7-9b935e5482df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf0a2ed3ca8b9424b67d76a8dbf580fa 2x, https://si.imgix.net/b6a943d8/uploads/origins/1fae7b31-068c-4ca1-a6a7-9b935e5482df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d714029a1ed1974dcfe67ed49e1a0ed8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumb