\u30fb\u660e\u308b\u3044\u6642\u9593\u5e2f\u306e\u6559\u5ba4\u3068\u3001\u5915\u66ae\u308c\u306e\u6642\u9593\u5e2f\u306e\u6559\u5ba4\u30672\u30d1\u30bf\u30fc\u30f3\n\u30fb\u5177\u4f53\u7684\u306a\u69cb\u56f3\u3001\u30a2\u30f3\u30b0\u30eb\u306b\u3064\u3044\u3066\u306f\u8cc7\u6599URL\u3092\u3054\u53c2\u7167\u304f\u3060\u3055\u3044\u3002\n\n[\u4eba\u7269]\u3000\u203b\u8272\u306f\u8fd1\u3044\u8272\u3067OK\u3067\u3059\u3002\n\u7537\u5b50\u751f\u5f92\uff1a\u5fa1\u5263\u30ab\u30ac\u30ea (\u307f\u3064\u308b\u304e-)\n\u30fb\u4f53\u578b\uff1a\u9577\u8eab(180cm)\u3001\u30b9\u30ea\u30e0\u3001\u30c4\u30ea\u76ee\u6c17\u5473\n\u30fb\u9aea\u578b\uff1a\u8170\u307e\u3067\u306e\u30ed\u30f3\u30b0\u30fb\u7d10\u3067\u7e8f\u3081\u3066\u524d\u306b\u5782\u3089\u3057\u3066\u3044\u308b\n\u30fb\u9aea\u8272\uff1a\u7d3a\u6854\u6897\n\u30fb\u76ee\u306e\u8272\uff1a\u8584\u8336\u8272\n\u30fb\u670d\u88c5\uff1a\u5b66\u751f\u670d\u30fb\u590f\u670d\uff08\u30ef\u30a4\u30b7\u30e3\u30c4\u30fb\u534a\u8896\uff09\n\u30fb\u30dd\u30fc\u30ba\uff1a\u6a2a\u5411\u304d\u306b\u5ea7\u3063\u3066\u811a\u3092\u7d44\u3093\u3067\u3044\u308b\u3002\u5de6\u8098\u3092\u673a\u306b\u982c\u6756\u3092\u3064\u3044\u3066\u3044\u308b\u304c\u3001\n\u3000\u672c\u5f53\u306f\u6a2a\u76ee\u3067\u5f8c\u308d\u306e\u5e2d\u306e\u5973\u5b50\u3092\u898b\u3066\u3044\u308b\u3002\n\n\u5973\u5b50\u751f\u5f92\uff1a\u6708\u7d2b\u3061\u3087\u3073 (\u3064\u304f\u3057-)\n\u30fb\u4f53\u578b\uff1a\u6a19\u6e96\u3001\u3061\u3087\u3044\u75e9\u305b\u5bc4\u308a\n\u30fb\u9aea\u578b\uff1a\u30df\u30c7\u30a3\u30a2\u30e0\u30fb\u5916\u30cf\u30cd\n\u30fb\u9aea\u8272\uff1a\u30b0\u30ec\u30fc\u306e\u88fe\u7d2b\n\u30fb\u76ee\u306e\u8272\uff1a\u9752\n\u30fb\u670d\u88c5\uff1a\u5b66\u751f\u670d\u30fb\u590f\u670d\uff08\u30ef\u30a4\u30b7\u30e3\u30c4\u30fb\u534a\u8896\uff09\n\u30fb\u30dd\u30fc\u30ba\uff1a\u6b63\u9762\u5411\u3044\u3066\u7247\u624b\u306f\u982c\u305a\u3048\u3064\u3044\u3066\u3044\u308b\n\u30fb\u305d\u306e\u4ed6\uff1a\u5c11\u3057\u7740\u5d29\u3057\u3066\u308b\n\n\