3-9582-4561-9b70-24812eeb2009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bfe5792656027e7fd613508b823fdf8", "srcset": "https://si.imgix.net/e9128fb7/uploads/origins/86853633-9582-4561-9b70-24812eeb2009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bfe5792656027e7fd613508b823fdf8, https://si.imgix.net/e9128fb7/uploads/origins/86853633-9582-4561-9b70-24812eeb2009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=969e9e3156c18e9b02525d49cfb359e0 2x, https://si.imgix.net/e9128fb7/uploads/origins/86853633-9582-4561-9b70-24812eeb2009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f97637e24bec93322184735b6365b561 3x"}, "body": "こんにちは、私はあなたの芸術にとても感心しています。\n\nこのクラシックなポーズをとりながら、現在のリメイクデザインのアルクェイド・ブルーネストゥードを描いていただけないかと思いました。\nhttps://imgur.com/a/C8ZyAJH\n\nカーヴィーに描くのも自由だし、体型にこだわりはない。\n\nありがとうございます！（笑", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ri_o_ne_su/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1570380, "client_id": 564815, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc83b679d7178a5922f5395626319612", "srcset": "https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc83b679d7178a5922f5395626319612, https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c1ee01338a985ffbab1aad4ec438cfc 2x, https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3da5276e6a9e118ee53a1f107028dec1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4491f59ad029a3d19ae6046c6efbc44", "srcset": "https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4491f59ad029a3d19ae6046c6efbc44, https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab98b8f6db0e08b2188d57eaec63d3ec 2x, https://si.imgix.net/ddfc1125/uploads/origins/68c50d4e-29f2-493e-9b7b-bbb0a0e3b023?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4833b5cf951d0583c8a31a66d056280 3x"}, "body": "はじめまして。マシュ・キリエライトとバーゲスト(共にFate/Grand Order)のイラストを依頼させていただきます。\n構図はバーゲストが右側、マシュが左側に隣り合って並んでる状態からそれぞれバーゲストは左足を、マシュは右足を軸にもう片足が奥に行くように30度ほど回転してバーゲストは左半身を、マシュは右半身を少し前に出している状態(ハの字を上から見たような形です)で立っているのを斜め上から俯瞰する形でお願いします。\nポーズは2人とも凛々しい表情でこちらを向いて足を肩幅に開いた上で、バーゲストは体の正面で自身の剣を床に突き立てて柄の上に両手を重ねて置いているポーズ、マシュは左足の前の地面に垂直に立てた盾を左手で持ち右手はまっすぐ下に(ただし体に密着しないように)下げているポーズでお願いします。\n衣装はバーゲストは霊基第一段階、マシュは霊基第三段階でお願いします。また、設定上両者には30cm近い身長差がありますが厳密に考慮していただく必要はなく見栄え優先で身長差を調整していただいて大丈夫です。\n以下に非常に簡素なものではありますが資料を添付させていただきます。\nバーゲスト:https://www.dropbox.com/s/fteou2tqi13ttzm/6FC8F515-3CC9-48DC-95D9-8F4EE7C6D745.jpeg?dl=0\nマシュ:https://www.dropbox.com/s/ifbntuvzpnytvpr/F044FCEA-E094-4D58-AC72-9759F19DAA00.jpeg?dl=0\n大分指定の多い依頼となりますが何卒よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ri_o_ne_su/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1570380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.img