ur=200&s=5a1a0c8921de68c7f90263f1ec213639, https://si.imgix.net/78127718/uploads/origins/58733896-8d9f-40de-9e7e-7e6a5cf1a6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6af5cb4d9a6c1267362b8405aabbbad 2x, https://si.imgix.net/78127718/uploads/origins/58733896-8d9f-40de-9e7e-7e6a5cf1a6e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc52be5b14249318dc6c5566a4d189d 3x"}, "body": "巨乳粗チンシーメール化のイラストの続編をお願いします！\nhttps://skeb.jp/@kyarbona/works/3\n\nその後、拉致前に通っていた学校に女子として通わされるシーンをお願いします。\n周りからの奇異の視線や陰口、変わり果てた身体に羞恥しているところをお願いします。\n服装は女子の制服、体型は腰回りが男っぽい感じでお願いします！\n\nこれはできればですが、モザイクではなく黒線だとありがたいです！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyarbona/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3852691, "client_id": 1082723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e6db013ba167aaac6b27b85c3b6db7", "srcset": "https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34e6db013ba167aaac6b27b85c3b6db7, https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11b35ff10e28e5c40f7d21d1c380fdf9 2x, https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c790cb3c1cdae1960ca8253a1a63bb7 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab0ffeb5f56f0771f2c0bfb73e7b192", "srcset": "https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab0ffeb5f56f0771f2c0bfb73e7b192, https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=345256048a3cf5d87c233101106df4e0 2x, https://si.imgix.net/95cf4469/uploads/origins/5eccb8ea-c6a3-4cc9-abea-a8947160432c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c891acba092d230b01c9c5f7c6eebb37 3x"}, "body": "はじめまして。学校で人気者の陸上部のあの娘（シーメール）が良かったのでリクエストさせてください。\n\n以下の設定のセリフ付イラストをお願い致します。\n学校で人気者の陸上部のあの娘（シーメール）で、援助交際で男の娘でも孕ませられる能力を持つおじさんに返り討ちになってお持ち帰りされたその後で、\n\n学校で人気者の陸上部のあの娘（シーメール）が、https://www.pixiv.net/artworks/142046959\nの陸上着の服装で乳輪部分が破られて乳首丸出しになり、おじさんの3人目の子を妊娠してボテ腹になり黒くなった巨乳輪（貧乳のまま）から母乳を出しながら、正面を向いて、騎乗位で中出しされているシーンや\n\n学校で人気者の陸上部のあの娘（シーメール）がおじさんの６人目の子を妊娠してボテ腹になり黒くなった巨乳輪（巨乳化）から母乳を出しながら、\nhttps://www.pixiv.net/artworks/90195439のような構図と白下着で、おじさんに中出しされているイラスト。\n\n学校で人気者の陸上部のあの娘（シーメール）はおじさんとラブラブになって妻となっており、子作りに励んで子は１０人以上作る予定なこと等報告している。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyarbona/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3852691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40a6b2a9e10076ab9f09a822a9af9117", "srcset": "https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40a6b2a9e10076ab9f09a822a9af9117, https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b16df9e18a3ba6efc2dacb1d5fcac424 2x, https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=043cd54ef1b99f1d4371441b81387482 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3a362a9fed2571bef776019baa7752", "srcset": "https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3a362a9fed2571bef776019baa7752, https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b66b075f5f4bbd82befb89dcea23a14 2x, https://si.imgix.net/ca581441/uploads/origins/0c640620-a575-482a-945d-f8d7ca5a7d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6c1942b9719b6c049b4ab0ad3bc8cc6 3x"}, "body": "強制的に豊胸・去勢された男の子のイラストをお願いします。\n患者取り違えで手術されたシチュです。\n\n1枚目：\n手術から目が覚めたところ。胸に包帯が巻かれていて病院の館内着を着ている。\n上半身をはだけて、包帯が巻かれた胸を見て驚いている。\n\n2枚目：\n手術後、初めて包帯を外された自分の姿をみて涙しているところ。\nおっぱいは巨乳だけど、ただシリコン入れられただけなので乳首は小さい。\nおちんちんは大きさが変わらないが、玉が無くなっている。\n絶望で涙を流している。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyarbona/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3852691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9856ed1/uploads/origins/ce2008a7-6efc-4a92-99ae-8292472413c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e28b0aacaf12dfc925b4d2fb50f9cbd", "srcset": "https://si.imgix.net/e98