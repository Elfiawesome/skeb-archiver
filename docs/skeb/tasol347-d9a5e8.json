ます。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1o-j3DMjz2ulUptIOAXAuNupdEDInn1xI?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tasol347/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2058967, "client_id": 990181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aea807c18ef74556e6ff86c035ce5df", "srcset": "https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aea807c18ef74556e6ff86c035ce5df, https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebb652b577833189f1694cec11f4c389 2x, https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5f30074208edb7ff3fb90e0ee19c40a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803b50be71be7bc123905f62d929a70e", "srcset": "https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803b50be71be7bc123905f62d929a70e, https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b8108a294bf43d1d8fb2290dbd0ab94 2x, https://si.imgix.net/81f8839b/uploads/origins/46b2481d-849f-4a96-8975-d75347414e0e?