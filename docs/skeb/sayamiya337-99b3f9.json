&fit=crop&crop=top&w=200&h=200&s=afb064cd76082ed23180d84686abba0f 2x, https://si.imgix.net/24d91c64/uploads/origins/f669b385-8193-4db0-a1a9-fcdaecb371da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35c2dadfb841fbf41e6c97bb86c3797e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24d91c64/uploads/origins/f669b385-8193-4db0-a1a9-fcdaecb371da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7db06f3c297d54b2a4f40968e230381c", "srcset": "https://si.imgix.net/24d91c64/uploads/origins/f669b385-8193-4db0-a1a9-fcdaecb371da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7db06f3c297d54b2a4f40968e230381c, https://si.imgix.net/24d91c64/uploads/origins/f669b385-8193-4db0-a1a9-fcdaecb371da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25dd902ce307f2bcd0a2a545408904a8 2x, https://si.imgix.net/24d91c64/uploads/origins/f669b385-8193-4db0-a1a9-fcdaecb371da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4729f2972197b8b207ff3c5fbcdcca58 3x"}, "body": "初めまして\n【学園アイドルマスター】で『アニメショップで葛城リーリヤが白いパンツを逆さ撮り盗撮されてる』カラーイラストをリクします\n作品イメージ↓\nhttps://drive.google.com/file/d/1WpdHO8JW3F8oNr9xuMM3jXyRfb2K_0e6/view?usp=drivesdk\n\n・セリフは無しでも構いません\n・イメージなのでポーズ等細部は変えても構いません\n・姿と白パンツが一枚に入る構図\n・カメラは背後の人物のカバン又はスマホです\n・撮影デバイスのカバン又はスマホは画面内に描いていただき『撮ってる感』を出して欲しいです。\n・パンツはシンプルな無地の白\n\n◯リーリヤ\n衣装:制服(資料URL内参照)\nパンツ:シンプルな『純白』です\n\n宜しければご検討よろしくお願い致します\n\nhttps://drive.google.com/drive/folders/1WqlDi-N0143v9Kvwe2OjuHSkFkcHnc5J", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sayamiya337/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 140261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cee196d1b601787c514ec66097f75f9", "srcset": "https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cee196d1b601787c514ec66097f75f9, https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ead09f849b7380e4b55a47e1214b7da4 2x, https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b493de9320c63f05f40046a0e291ef9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=241315f25334df07abc3e1f5cc22de58", "srcset": "https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=241315f25334df07abc3e1f5cc22de58, https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7f6b6f93c8e022c33c6a58b1f2bb8f8 2x, https://si.imgix.net/ddc48bb5/uploads/origins/0fefd375-0995-47e1-8f1e-93396bae4e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a39c9d4a4727cdea57c383e1f7cdedf 3x"}, "body": "匿名でリクエストさせていただきます。\nローゼンメイデンのキャラクター、柏葉巴が放尿しているイラストをお願いします。\n\n・場所と時間帯は放課後の学校の女子トイレ\n・和式便器の古びた個室\n・巴は旧アニメ版に近い感じ\n・仕切りの後ろから覗き見る構図\n・互いの心情を台詞かモノローグで表示\n・覗いている変態は原作主人公の桜田ジュン。\n　原作のような引きこもりになるような事はなく、薔薇乙女の事件もないため、普通の中学生になっている。巴が好き。\n　この世界線では変態性癖持ちで周囲には隠しているが、巴にはとっくにバレている。\n　今回の覗きは巴の行動を見て先回りしてトイレに入って待ち伏せしていたが、巴に行動を読まれており、むしろ放尿を見せつけられる。\n・巴もジュンに覗かれているのは気付いていてこっそり後ろを見ている\n・ジュンは思春期特有の暴走する性欲と「俺何やってんだろうな」と思う理性で板挟みになっている\n・巴は自分の恥ずかしい所を意中の人物に覗かれている事に興奮している。ある意味ジュンより危うい。\n\n検討をお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sayamiya337/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/25bec06f/uploads/origins/26c56523-c4ad-4873-a8fb-16f824f43254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa0c5caa127f7fc4800d8dba33af2523", "srcset": "https://si.imgix.net/25bec06f/uploads/origins/26c56523-c4ad-4873-a8fb-16f824f43254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa0c5caa127f7fc4800d8dba33af2523, https://si.imgix.net/25bec06f/uploads/origins/26c56523-c4ad-4873-a8fb-16f824f43254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=134b46c5d61836686d34ae7e56a9d2d0 2x, https://si.imgix.net/25bec06f/uploads/origins/26c56523-c4ad-4873-a8fb-16f824f43254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1fcd996a30c4f73b7676ced0d5cf8b1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 140261, "nc": 176}, {"path": "/@sayamiya337/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 140261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597c924da1a716fd077b6954cd3a4b87", "srcset": "https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=597c924da1a716fd077b6954cd3a4b87, https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=381eb84f4d5236dc1e7d2d171e600a65 2x, https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=312792baef515d261a1318d8d8230add 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61b94cae44ac65f8f88db4e2367a5ef3", "srcset": "https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61b94cae44ac65f8f88db4e2367a5ef3, https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc55af9544cbdf47fa0a6d78075cd521 2x, https://si.imgix.net/a7633f25/uploads/origins/68200a28-6cd3-42ab-81fb-1d3c99cc44e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04e9fcd3e2d36967ba45b09460388e5b 3x"}, "body": "『水泳袋に大量放尿』\n\n学級一の美貌でありつつ勉強と体育の成績が優秀で、発育活発な身体で巨乳巨尻かつ長身豊満で大人びた体型（もう大人そのもの⁉）のスタイリッシュな女の子が、水泳の授業があるため下着代わりに水着で登校したものの、水泳後に替えの下着を忘れてしまい、ノーブラノーパン姿のまま帰宅することになり、その下校中の電車内で、突然の尿意により催してしまうが、どうしても我慢できなくなり、仕方なく連結部まで車内を移動して、そこで立った状態で水泳袋にまたがって、両手で取っ手を前後に持って袋を広げたら、そのまま力を入れ息んで、水泳袋が一気にあふれかえるほど、勢いよく大量放尿してしまう場面が見たいです。\n\n本当に我慢の限界の頂点という状態だったためか、おしっこの勢いはものすごく凄まじい爆尿状態で、まるでウォーターカッターのように極限まで勢い良くて、おしっこの出口から縦に広がりまくる極太噴射状態で、もう水泳袋の中で跳ね返りまくるほどのえぐれる勢いの圧力で、ほんの一瞬にして水泳袋を一気にタプタプの水浸しにするくらいに、たくさん溜め込んでいた感じを描いて欲しいです。\n\n正面向きのアングル視点描写で、水泳袋は防水タイプで中身が透明処理で見えるように、透明描写しつつ、 立ちポーズは水泳袋の取っ手を前後むきに持ってから跨いで、前から見える肛門を描写して、割れ目の先端から下向きに一気に出てくる感じです。\n\n下校時の服装は白いワンピースのみで、ノーブラノーパン状態のため、表から見れば乳首が薄っすらと見えて、衣服の内側から乳首が立っていることが分かるくらい、薄っすらと見えてしまう事に本人は最後まで気づかないというオチで〆る展開でお願いしたいです。\nおしっこしている時には、快感で乳首が飛び出たり性的快感を得る表情になるのが理想であったりします。\n基本的に表情の絵柄は『歯』を描かないような口の描き方が好みです。\n\n以下セリフ案です。\n「うぅ…どうしよう…急におしっこしたくなってきちゃった…」\n「こんな時に…おしっこしたくなるなんて…」\n「もうらめぇ～‼…我慢の限界～‼…」\n「あっ❤あん❤あぁん❤あ～っん❤」\n「あっは～ん❤おしっこ気持ちぃぃ～❤」\n「ノーブラノーパンもたまにいいことあるじゃん(^^♪～」\nご好意で可能でしたら任意でセリフを増やしても良いです。\n\nもしよろしければご検討をお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sayamiya337/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 140261, "client_id": 125499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed4ab8df/uploads/origins/642be52c-6eea-4d1d-9e78-181b69112bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54a067b0a36b016bbe0be392060b5ff3", "srcset": "https://si.imgix.net/ed4ab8df/uploads/origins/642be52c-6eea-4d1d-9e78-181b69112bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54a067b0a36b016bbe0be392060b5ff3, https://si.imgix.net/ed4ab8df/uploads/origins/642be52c-6eea-4d1d-9e78-181b69112bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ecd562a0c2b4ed08f50c1a56f8e3692 2x, https://si.imgix.net/ed4ab8df/uploads/origins/642be52c-6eea-4d1d-9e78-181b69112bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83bc522a068ec629683f9bab1cb99d88 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed4ab8df/uploads/origins/642be52c-6eea-4d1d-9e78-181b69112bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857efa22f743ce2969800b6611b81941", "srcset": "https://si.imgix.net/ed4ab8df/uploads/origins/642be52c-6eea-4d1d-9e78-181b69112bea?bg=%23fff&auto