ているだけで心が和むような、あの可愛すぎる姿を、あぶらさんの絵柄で拝見できたらどれだけ嬉しいだろう...と想像したらいてもたってもいられなくなりました！\n\n・背景透過\n・png形式\n・画像サイズは3000×3000px程度\n・イラストのどこかにあぶらさんのサインも入ってたら嬉しいです\n・ご納品して頂いたイラストをこちらでアクキーにしたいと考えています。あくまで僕が大切に持っていたいだけの個人利用を目的としたものなので、当然のことではありますが、譲渡や販売は行いません。\n\nただ、たとえ個人利用でもグッズ化は抵抗がある...というお気持ちがありましたら、その際はどうかご無理なさらず、ぜったいにお断りくださいね...！何より、あぶらさんのお気持ちを大切にしたいと思っています。\n\nだれかにイラストをお願いするのは今回が初めてなので、いろいろとマナーや常識に反しているところがあるかもしれません。もしも失礼にあたる依頼内容になってしまっていたら、ほんとうにごめんなさい...！\nご検討いただけたら、とても嬉しいです。どうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 853925, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ムツキ🍧", "screen_name": "AtoZsanINDEX", "avatar_url": "https://pbs.twimg.com/profile_images/1605011745906442240/xLiTuJVY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3913515673/1760546744/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 32}, {"id": 2039058, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はるさめ", "screen_name": "Xi7O2", "avatar_url": "https://pbs.twimg.com/profile_images/1905542846406705152/Q_hV8obO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3168732396/1749210912/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 15, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2355206, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "やちし", "screen_name": "yachishi_orca", "avatar_url": "https://pbs.twimg.com/profile_images/1554025246587748352/H3x5ncIR.jpg", "header_url": "https://pbs.twimg.com/profi