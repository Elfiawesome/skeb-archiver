6b73\u5973\u6027\u3000\u300e\u732b\u8033\u300f\u3068\u300e\u30d5\u30b5\u30d5\u30b5\u5c3b\u5c3e\u300f\u3042\u308a\n\u30fb(\u732b\u8033\u306e\u307f\u3067\u4eba\u9593\u306e\u8033\u306f\u7121\u3057\u3067\u3059)\n\u30fb(\u30d5\u30b5\u30d5\u30b5\u5c3b\u5c3e\u306f\u9aea\u8272\u3068\u540c\u3058\u8272\u3067\u3059)\n\n\u30af\u30fc\u30eb\u3067\u30ab\u30c3\u30b3\u3044\u3044\u7aef\u6b63\u306a\u9854\u7acb\u3061\u3067\n\u7dba\u9e97\u306a\u30d6\u30eb\u30fc\u306e\u77b3\u3068\u8d64\u3044\u30a2\u30a4\u30e9\u30a4\u30f3\n\u91d1\u9aea\u306b\u767d\u3044\u30e1\u30c3\u30b7\u30e5\n158cm\n\u30b9\u30bf\u30a4\u30eb\u304c\u826f\u304f\u3066\u30bb\u30af\u30b7\u30fc\u80f8C\u30ab\u30c3\u30d7 (\u3042\u307e\u308a\u5927\u304d\u904e\u304e\u305a\u306b\u307b\u3069\u307b\u3069\u30b5\u30a4\u30ba)\n(\u753b\u50cf\u2460\u30d0\u30b9\u30c8size)\n\n\u4e16\u754c\u3092\u65c5\u3059\u308b\u5192\u967a\u5bb6\n\u8863\u88c5\u3000\u6d77\u8cca\u670d\u30e2\u30c1\u30fc\u30d5(\u753b\u50cf\u2460\u8863\u88c5)\n\u753b\u50cf\u3067\u898b\u3048\u306a\u3044\u90e8\u5206\u306f\u30aa\u30aa\u30e0\u30e9\u3055\u3093\u306e\u30a4\u30e1\u30fc\u30b8\u3067\u30a2\u30ec\u30f3\u30b8\u3057\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\n(\u30ab\u30c3\u30b3\u3044\u3044+\u30bb\u30af\u30b7\u30fc\u3000\u80f8\u5143\u30fb\u592a\u3082\u3082\u30fb\u3078\u305d\u51fa\u3057)\n\u77ed\u9283\u3068\u5263\u3092\u4f7f\u3044\u3053\u306a\u3059\n(\u53c2\u7167\u753b\u50cf\u306b\uff83\uff9e\uff7b\uff9e\uff72\uff9d\u3042\u308a)\n\u30b7\u30eb\u30d0\u30fc\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u597d\u304d\n\u9ed2\u30ec\u30fc\u30b9\u30e9\u30f3\u30b8\u30a7\u30ea\u30fc\u7740\u7528\n\u80f8\u5143\u30bb\u30af\u30b7\u30fc\u30c1\u30e9\u30ea\u3068\u9ed2\u4e0b\u7740\u8997\u304b\u305b\u3066\u3044\u308b\n\u304a\u9152\u597d\u304d\n\u7f8e\u4eba\u30af\u30fc\u30eb\u3067\u30ab\u30c3\u30b3\u3044\u3044\n\u4ef2\u9593\u60f3\u3044\u3067\u307f\u3093\u306a\u304b\u3089\u597d\u304b\u308c\u308b\n(\u9aea\u578bA.B\uff8a\uff9f\uff80\uff70\uff9d\u3042\u308a\u3000\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306b\u5408\u3046\u307b\u3046\u3067)\n\n\u2606\u65c5\u306e\u9014\u4e2d\u3001\u4ef2\u9593\u3068\u51fa\u4f1a\u3044\u5171\u306b\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u306e\u4e16\u754c\u3092\u5192\u967a\u4e2d\u2606\n\u305d\u306e\u5192\u967a\u306e\u30ef\u30f3\u30b7\u30fc\u30f3\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n(\u753b\u50cf\u2462\u306e\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u4ee5\u5916\u306e\u5192\u967a\u306e\u30b7\u30fc\u30f3\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002)\n\n\u5192\u967a\u306e\u4ef2\u9593\u306f\u2462\u2467\u306e\u30ad\u30e3\u30e9(\u753b\u50cf\u898b\u3048\u306a\u3044\u90e8\u5206\uff83\uff9e\uff7b\uff9e\uff72\uff9d\u306f\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044)\u3067\u3082\u826f\u3044\u3067\u3059\u3057\u3001\u3082\u3061\u308d\u3093\u30aa\u30aa\u30e0\u30e9\u3055\u3093\u30c7\u30b6\u30a4\u30f3\u306e\u30aa\u30ea\u30b8\u30ca\u30eb\u30ad\u30e3\u30e9\u3092\u65b0\u305f\u306b\u767b\u5834\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\u3002\n(\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u4e16\u754c\u89b3\u306b\u5408\u3046\u4e9c\u4eba\u7a2e(\u30b1\u30e2\u8033)\u30fb\u30a8\u30eb\u30d5\u30fb\u30c9\u30ef\u30fc\u30d5\u30fb\u30d2\u30e5\u30fc\u30de\u30f3\u306a\u3093\u3067\u3082\u5927\u4e08\u592b\u3067\u3059)\n\u4eba\u6570\u3001\u4eba\u9078\u3001\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\n\n\n\u30b5\u30a4\u30f3\u6709\u308a\u7121\u3057\u30d0\u30fc\u30b8\u30e7\u30f3\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n(\u30aa\u30aa\u30e0\u30e9\u3055\u3093\u30c7\u30b6\u30a4\u30f3\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u767b\u5834\u306e\u5834\u5408\u3001\u305d\u306e\u30ad\u30e3\u30e9\u306e\u540d\u524d\u8a18\u8f09\u6709\u308a\u3068\u7121\u3057\u30d0\u30fc\u30b8\u30e7\u30f3)\n\n\u3054\u691c\u8a0e\u306e\u307b\u3069\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\nhttps://drive.google.com/drive/folders/1LRD5LNtx-IhmQ1CIpx8_jvnPKgV