0&h=200&blur=200&s=02ed4dac017c20be04a98966d320295d 2x, https://si.imgix.net/9765113a/uploads/origins/77af9bfa-b0c7-4a8b-810a-8625629d4a4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57f8ce74ca1263c63152cf5b5c24fe6b 3x"}, "body": "初めまして。\nいつも楽しくイラストやツイート拝見しております。特に以前投稿されていた結婚フラッシュや温泉宿関連のウマ娘イラストが好きです。表現が正しいかわかりませんが、生活の中や旅行中のワンシーンを切り取ったようなイラストが特に好きです。胸元がちょっと開いたイラストも大好きです。\n私事ですが秋田県北部に住んでおりますので、先日ウグイス宿さんが秋田岩手のお話をされていてとても嬉しかったです。\nいつかイラストを依頼したいと思っていましたので、これはチャンスだと思いました。可能であればよろしくお願いします。\n\n○イラストの依頼内容\n・キャラクター：キングヘイロー\n・衣装：私服でも可ですがシチュエーションに合わせた服\n・シチュエーション：生活の中、もしくは旅行中のワンシーン\n・表情：シチュエーションに合わせ、喜怒哀楽で言うところの喜か楽。怒や哀の表情にはならないようにお願いします。\n・背景：シチュエーションに合わせてお願いします。\n・イラストのサイズ：指定なし。縦長、横長どちらでも可。\n・イラストの使用用途：PC壁紙やスマホ壁紙など個人利用の範囲で使用予定\n\n以上です。可能であればよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ashinowoto/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2570958, "client_id": 69902, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74b8756c/uploads/origins/e189c457-3374-4a5e-a0a6-30658788ce76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfa0764c1180482af52e1b3f5034937b", "srcset": "https://si.imgix.net/74b8756c/uploads/origins/e189c457-3374-4a5e-a0a6-30658788ce76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfa0764c1180482af52e1b3f5034937b, https://si.imgix.net/74b8756c/uploads/origins/e189c457-3374-4a5e-a0a6-30658788ce76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b48b0f3345b8f5b645b9e80dad47ee35 2x, https://si.imgix.net/74b8756c/uploads/origins/e189c457-3374-4a5e-a0a6-30658788ce76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67e87007c9f7f64f0407586c3b939d14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.i