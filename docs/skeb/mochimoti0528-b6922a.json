稿\n・配信や動画のサムネイル\n・アイコン、壁紙など個人使用\n\n【納品形式】\n可能であればPSD形式、難しい場合は背景あり・背景なしのPNGを書き出していただけますと幸いです。\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1mbX1nUfAejA6khHPhaHtOvyR682N3m1n?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mochimoti0528/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2165856, "client_id": 2011139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/284367f0/uploads/origins/e8a73e40-4158-495e-a02e-a293280d8713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc2537ec51adecffd224680da60f710", "srcset": "https://si.imgix.net/284367f0/uploads/origins/e8a73e40-4158-495e-a02e-a293280d8713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc2537ec51adecffd224680da60f710, https://si.imgix.net/284367f0/uploads/origins/e8a73e40-4158-495e-a02e-a293280d8713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67a9f2d7a4640b1642ab98a32c43d32a 2x, https://si.imgix.net/284367f0/uploads/origins/e8a73e40-4158-495e-a02e-a293280d8713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=773b4b585466661f6748ad3f1476dd79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/284367f0/uploads/origins/e8a73e40-4158-495e-a02e-a293280d8713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=161a2c205ac5fe7a34522386f8196386", "srcset": "https://si.imgix.net/284367f0/uploads/origins/e8a73e40-4158-495e-a02e-a293280d8713?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=161a2c205ac5fe7a34522386f8196386, https://si.imgix.net/284367f0/uploads/origins/e8a73e40-4158-495e-a02e-a293280d8713?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8efae0d09dc802c03cafd