ttps://si.imgix.net/bc302f28/uploads/origins/ffc104dc-47ce-4085-b0ac-6fd9b49ca808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fc9d1da771fb0a3c483248f0819bd43", "srcset": "https://si.imgix.net/bc302f28/uploads/origins/ffc104dc-47ce-4085-b0ac-6fd9b49ca808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fc9d1da771fb0a3c483248f0819bd43, https://si.imgix.net/bc302f28/uploads/origins/ffc104dc-47ce-4085-b0ac-6fd9b49ca808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=395326b4137b65d8f89fa5b274cc79a5 2x, https://si.imgix.net/bc302f28/uploads/origins/ffc104dc-47ce-4085-b0ac-6fd9b49ca808?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f5d436b9baffb3ffd2045d2fd14e1d8 3x"}, "body": "初めまして！\nハナミノさんが描くロッシちゃんがとても可愛くて素敵だったのでリクエストさせて頂きました……！\n\nシチュエーションとしては管理人に頼まれてナイフを持ち、脚を開いて上機嫌でかっこよく戦闘ポーズを取ったロッシに対して今度は同じポーズで1枚ずつ服を脱ぐように管理人に命じられ、スカート無し→上下下着→下下着のみ→裸フード→全裸のようにどんどん脱がされ、管理人の頼みとはいえ、どんどん恥ずかしくなっていくロッシちゃんをお願いします！\n脱がされる度にロッシちゃん心情のセリフや管理人のセリフを変化させるようにお願いします。\n\n陰毛ありで、下着姿と裸状態でのおしっこ差分もお願いします……！\n\n構図は脱いだ状態で胸や股間が見える正面寄りのもの\n\n長くなりましたがよろしければお願いします……！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@offtoon_orimi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3861162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0a84bc4/uploads/origins/6bc779a1-9974-41a4-a6f7-43b7ecf6dd7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0efd9ec92b4f354b7ccf16bdf2368df1", "srcset": "https://si.imgix.net/f0a84bc4/uploads/origins/6bc779a1-9974-41a4-a6f7-43b7ecf6dd7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0efd9ec92b4f354b7ccf16bdf2368df1, https://si.imgix.net/f0a84bc4/uploads/origins/6bc779a1-9974-41a4-a6f7-43b7ecf6dd7b?bg=%23fff&auto=format%2Ccompress&fm=webp&d