&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecad862192409417582f0b00ce5ed024 3x"}, "body": "初めまして。\n\nいつも飯井先生のイラストや漫画を拝見させて頂いている者です。\n素敵なイラストや漫画を世に出して下さってありがとうございます。毎日飯井先生の作品が生き甲斐になっております。\n今年のご活躍もとても楽しみにしております。\n\n今回skebを開設されたとお聞きしまして、私のオリジナルヒーロー小説作品である「Cn:Rageig」の「神奈木礼司」くんを描いて頂きたくリクエストさせて頂きました。\n\n下記は参考資料のURLです。(左側の変身状態はお気になさらず！)\nhttps://drive.google.com/drive/folders/1uY-h7xD7DG4GKhcULZjMHeBL9WrXxZZH?usp=drive_link\n\nサイズやポーズなどに指定はないのですが、「俺様キャラ感」が出ているイラストだと大変嬉しいです。\nご一考のほど、どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1uY-h7xD7DG4GKhcULZjMHeBL9WrXxZZH?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kirakiralond/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37423, "client_id": 3603003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c7f023edba70dbf861566180203e4c6", "srcset": "https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c7f023edba70dbf861566180203e4c6, https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce1ca2e96b3d1a1f525a1349f8d628d9 2x, https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eaf659b28ccc405dbc95e71f8ca2f40 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7f7edddc3b25dabd5b571591cc58e38", "srcset": "https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7f7edddc3b25dabd5b571591cc58e38, https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98dfc8863a986023673242b15eb2bafc 2x, https://si.imgix.net/e093db39/uploads/origins/eebbf1a2-b036-4584-8109-239c01f24a6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16152d61c1b9e6bd4cf24ba72936fa3f 3x"}, "body": "こんにちは。\nいつも、Kiaさんの素敵なイラストを楽しみにしている者です。\n\n本日は、私のオリジナルキャラクターである少年(17歳)を描いて頂きたくご依頼させて頂きました。\n\nイメージといたしましては、先日KiaさんがSNSにアップされていらっしゃった「あのコの心臓」のような神秘的で「聖なる空気」を纏ったイラストをお願いできればと思います(あの絵は、とても衝撃的に美しかったです！)。\n簡単に言ってしまうと、神話絵画のようなものに近いと思います(よく壁画などであるもの)。出来れば祈っているような仕草もあると嬉しい所存です。\n服装は自由に変えていただいて構いません。Kiaさんが美しいと思う服を着せてあげていただけますと幸いです。背景など細かな装飾もお任せいたします！\n\n写真として家で飾りたいので、イラストのサイズは2L版サイズでお願いできればと思います。\n\nイラストの資料は下記になります。\n\nhttps://drive.google.com/drive/folders/1UJj71I-LRrKadhCHw7LGtw19PvcUKfJa?usp=drive_link\n\n依頼内容が複雑で大変申し訳ないのですが、ご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1UJj71I-LRrKadhCHw7LGtw19PvcUKfJa", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirakiralond/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37423, "client_id": 3603003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a35a8ca47d5ae28a16d57f2f3a3cb245", "srcset": "https://si.imgix.net/5f613ebd/uploads/origins/b778b557-5fcb-4c13-a693-b0109c1d1a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a35a8ca47d5ae28a16d57f2f3a3cb245, https://si.imgix.net/5f613ebd