XkFgb5ROe8REFN3Y6XcttaYSrc8?usp=drive_link\n\n○希望ポーズ\n口元の横に両手でエールを送っているような言葉をかけている雰囲気のイラストがうれしいです…！\n\n○イラスト比率\n16:9、サイズはお任せしますが、動画編集でアップしたりなどは行うため、1980×1080の2倍以上はあると大変ありがたいです。\n拙者範囲はバストアップで大丈夫です。\n正面棒立ちではなく、人体を斜めにして構いませんので、キツネ耳がしっかり入る画角でおねがい出来ますと、うれしいです…！\n\n○服装…参考資料の通りのお洋服でお願いいたします。\n\n\n○表情\n左目開けて、右目ウインク。\n気持ちが高ぶって、少しほほが紅潮している様子だとうれしいです。\n\n○口元\n本人から見て左側に八重歯があるので、そこだけ忘れずに記載いただけるとありがたいです！\n\n背景をもし描いてくださる場合は、恐れ入りますが人物と背景は分けていただけると幸いです。\n可能であれば、表情の差分をお願いしたいです。\nノーマル表情は上記内容、＋でとじ目（伏せ目）、両目笑顔があると大変ありがたいです…！どちらかのみの場合は両目笑顔も頂けると嬉しいです。\n楽曲は明るく楽しい自己紹介のような楽曲です。\n\nとても素敵なイラストを描かれている星月冴様にぜひお願いできますと幸いです。\nお忙しい中恐れ入りますが、ご検討のほどよろしくお願いいたします…！\n\n\n白餅だんご", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_tsucasa/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2620942, "client_id": 2836401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db52414d/uploads/origins/ad2e8aba-a725-46f2-a0ea-95df6729960c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fbcc464c7f5513220b2a74fd53bd8f4", "srcset": "https://si.imgix.net/db52414d/uploads/origins/ad2e8aba-a725-46f2-a0ea-95df6729960c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fbcc464c7f5513220b2a74fd53bd8f4, https://si.imgix.net/db52414d/uploads/origins/ad2e8aba-a725-46f2-a0ea-95df6729960c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c47d140be6b8d8f8136d83745f851da4 2x, https://si.imgix.net/db52414d/uploads/origins/ad2e8aba-a725-46f2-a0ea-95df6729960c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c096b83d18da372e6bc82af68a28dab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db52414d/uploads/origins/ad2e8aba-a725-46f2-a0ea-95df6729960c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2