n\n・体育の授業で競泳水着を着て一緒に写ってる感じのイラストです\n・水着のデザインは学校で使われてる一般的な競泳水着でお願いします\n・自由時間にプールサイドで二人で座ってる感じです\n・髪型は蓮ちゃんがお団子で椿姫ちゃんがポニテです\n・背景にモブ生徒を何人か入れてください。そのうちの一人はもっさり黒髪眼鏡に目の下にクマのある股の毛の濃そうな巨乳の子にしてください\n・それ以外のモブ生徒のデザインは先生の好みを詰め込んで構いません", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ayumi05888572/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3508076, "client_id": 217715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b62f646d/uploads/origins/0b677fd2-f632-47fd-8d5e-a3021676f7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03fcaf8481265170d4ba61541928f187", "srcset": "https://si.imgix.net/b62f646d/uploads/origins/0b677fd2-f632-47fd-8d5e-a3021676f7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03fcaf8481265170d4ba61541928f187, https://si.imgix.net/b62f646d/uploads/origins/0b677fd2-f632-47fd-8d5e-a3021676f7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd5e5c737af809c892aea9d7bc8e21ef 2x, https://si.imgix.net/b62f646d/uploads/origins/0b677fd2-f632-47fd-8d5e-a3021676f7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddb70c372aad2a6f22104e571c140db1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b62f646d/uploads/origins/0b677fd2-f632-47fd-8d5e-a3021676f7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d66932de52b96738ff43882e6a2b5b", "srcset": "https://si.imgix.net/b62f646d/uploads/origins/0b677fd2-f632-47fd-8d5e-a3021676f7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d66932de52b96738ff43882e6a2b5b, https://si.imgix.net/b62f646d/uploads/origins/0b677fd2-f632-47fd-8d5e-a3021676f7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0