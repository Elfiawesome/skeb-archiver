2-78161a425559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc5ceadda22c226c09ff98d66bf1874c 2x, https://si.imgix.net/5d20f5e2/uploads/origins/a23ad9b0-7705-46e2-a352-78161a425559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b355cf31cedca4d9c174743a573a178b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d20f5e2/uploads/origins/a23ad9b0-7705-46e2-a352-78161a425559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0af2f20d0033ef38498132172bc82140", "srcset": "https://si.imgix.net/5d20f5e2/uploads/origins/a23ad9b0-7705-46e2-a352-78161a425559?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0af2f20d0033ef38498132172bc82140, https://si.imgix.net/5d20f5e2/uploads/origins/a23ad9b0-7705-46e2-a352-78161a425559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b62b098370e121568c2ec9876247958 2x, https://si.imgix.net/5d20f5e2/uploads/origins/a23ad9b0-7705-46e2-a352-78161a425559?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd9bc3a89c7eca4937b123685064f62 3x"}, "body": "お世話になります！\n下記のリクエストのご検討のほどよろしくお願いいたします。\n\n題材:ナヴィアに後ろからお腹のお肉を摘まれる、クロリンデ。\n\n内容:毎晩行われる、ナヴィアのマカロンパーティーのせいでお腹にお肉がついてしまったクロリンデ。\n\n二人の格好は、シーナ先生のオリジナルで\nパジャマの格好で描いていただきたいです。\n\n状況:クロリンデは、少し恥ずかしいそうな顔をしている。\nクロリンデは、シャツの袖を胸の下くらいまであげている。※胸は見えないように！\nお腹だけ出している！\nお腹は、シーナ先生が以前描いていらっしゃったフリーナのぽっこりお腹くらいでお願いいたします。\nセリフはお任せで！\n\nナヴィアは、後ろから両手でクロリンデのお腹を摘んでいる状態。\n顔はすごく嬉しそうな顔で。\nセリフはお任せします！\n\n近くにはマカロンと紅茶が置いてあればありがたいです。\n\n以前シーナ先生が描いていたナヴィアとクロリンデでマカロン後日談的な感じで描いていただければと思います。\n\n以上になります。\n色々細かく描いてしまいましたが、ご検討のほどよろしくお願いいたします。", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tablesando_kwsk/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0e786c39/uploads/origins/78bd5275-4017-43ec-a6e8-9637270b18d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bba31bf0f362c80899db3f7a60a06d84", "srcset": "https://si.imgix.net/0e786c39/uploads/origins/78bd5275-4017-43ec-a6e8-9637270b18d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bba31bf0f362c80899db3f7a60a06d84, https://si.imgix.net/0e786c39/uploads/origins/78bd5275-4017-43ec-a6e8-9637270b18d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=109347a43b88d0af2943da741e7ee1b5 2x, https://si.imgix.net/0e786c39/uploads/origins/78bd5275-4017-43ec-a6e8-9637270b18d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a10978cb822996b2fedca5b8e4964b5 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2607607, "client_id": 3412039, "nc": 160}, {"path": "/@tablesando_kwsk/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2607607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b4f346446534f8fbb07297511ac0b61", "srcset": "https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b4f346446534f8fbb07297511ac0b61, https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=295239adcbc6aa0e126ad994257d6279 2x, https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e47c54c446d9a353fe95fae82abbacdd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27f0c1a1dfd44fe2a5d2eeac6361e4a3", "srcset": "https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27f0c1a1dfd44fe2a5d2eeac6361e4a3, https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e39c6b713e4a98ee8f3ed31cc1736c9 2x, https://si.imgix.net/ed14ebf0/uploads/origins/7baa9d9b-0699-4007-a583-9b978de4dcc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80c7a22772d6401e2ce808e73056c751 3x"}, "body": "初めまして！フォリオのこちらの作品群（https://www.foriio.com/works/824282）に惹かれてリクエストさせていただきました。\nクラゲ型モンスターに捕まってしまううちの子（以下『リタ』表記）を描いていただきたいです。\n\n【シチュエーション】\n深夜パトロール兼調査中のリタ。夜道を一人歩いていると、後頭部に何かふわりとした物が触れた気がした。リタは足を止めて振り返るがそこには何もいない。「虫でも飛んできたかな？」と周囲を軽くキョロキョロするリタ。その背後からは幽霊のようにふわふわと宙を舞う大きなクラゲ型のモンスターが触手を広げてこちらに迫っていた。\nリタの身体に触手を絡め付けるクラゲ型モンスターに、全く気配を感じていなかったリタはびっくり。\n抜け出そうにも腕ごと縛り付けられ武器を振ることができない。とにかく腕に力を入れて触手を緩ませようとするが思いの外強い触手の力にはびくともせず、触手はむしろリタの身体を覆っていくかのようにどんどんと絡みついていく…\n\nクラゲ型モンスターに絡みつかれて数分が経過したころ。リタは頭がボーっとしてきていること、いつの間にか武器を落としてしまっていること、そして自分の足が宙に浮き始めていることに気が付く。\nここでリタはようやく理解する。\n「触手の力が強いんじゃない。私の力が吸われているんだ…！」\n気付いたときには時すでに遅し。意識が遠のいていくリタを、クラゲ型モンスターはその大きなかさの中にリタを収めようと少しずつ丸呑みしていくのだった…\n\n上記のようなシチュエーションでお願いします。拙い文章すみません。\nシーンの省略や改変、具体的な構図等はお任せします。\nなおリタは喋らない設定（詳しくは後述の資料）なので、上記のセリフのような箇所は心の声と想定していただければ幸いです。ダメージボイス的なのは大丈夫です。\n※そもそもセリフ無しのサイレント漫画でもOKです。\n\n・デザイン\nうちの子のデザインはこんな感じです。\nhttps://i.imgur.com/CQ0FOSS.jpg\n色々載っていますが必要そうな情報だけ拾っていただければ大丈夫です。\n分かりにくい部分等ありましたら省略・簡略化しても大丈夫です。\n\nクラゲ型モンスターのデザインはお任せします。\n\n・その他\nカラー、無色問いません。\n背景もお任せします。単色等でも大丈夫です。\n\n分かりにくい点がありましたら申し訳ございません。\nよろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tablesando_kwsk/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6a27165d/uploads/origins/277698d3-b910-4e5d-a295-114f067cfd14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf62a19d1b28032e4335495b6bfaf5e7", "srcset": "https://si.imgix.net/6a27165d/uploads/origins/277698d3-b910-4e5d-a295-114f067cfd14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf62a19d1b28032e4335495b6bfaf5e7, https://si.imgix.net/6a27165d/uploads/origins/277698d3-b910-4e5d-a295-114f067cfd14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86c0077d056492b9bead263cd5815b97 2x, https://si.imgix.net/6a27165d/uploads/origins/277698d3-b910-4e5d-a295-114f067cfd14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10652640d8a824f4971647036d255b6d 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 2607607, "nc": 33}, {"path": "/@tablesando_kwsk/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2bf7fe72/uploads/origins/cc65f29a-b317-4d50-a048-74f8560c75d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f677ba00993b34b97981f88836126867", "