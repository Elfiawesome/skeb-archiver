ん。）\n\n【要望】\n・シチュエーション、構図、ポージング等はお任せいたします。\n・PSDデータで納品いただけると幸いです。\n　また背景がある場合は、別レイヤーにしていただけますと大変嬉しいです。\n\n【キャラクター】\n正面のイラストしか無いため、文面での詳細をご了承ください\n多少アレンジを加えていただいても問題ありません。\n描きやすいように描いていただければ嬉しいです。\n\n・上着の内側の服の袖は二の腕までの長さ\n・ヘッドホンの着脱は可能なので有り無しはおまかせします\n・上着の背面は無地で、特に模様などはありません\n・見た目が女性ぽいですが、男性であることを念頭に置いてくださると幸いです\n\n何卒よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/KnbKHGomPsDZpaoB7", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tablesando_kwsk/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dee16eaf/uploads/origins/32d0460c-fccd-4408-8601-780e9b07feae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=917279ff5d4eba92baad12bf1f575a6a", "srcset": "https://si.imgix.net/dee16eaf/uploads/origins/32d0460c-fccd-4408-8601-780e9b07feae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=917279ff5d4eba92baad12bf1f575a6a, https://si.imgix.net/dee16eaf/uploads/origins/32d0460c-fccd-4408-8601-780e9b07feae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3c3552f80a90c1b3f602d24da5276c7 2x, https://si.imgix.net/dee16eaf/uploads/origins/32d0460c-fccd-4408-8601-780e9b07feae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c7c76aeb13066ad1c6a04a92b9293b3 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2607607, "nc": 162}, {"path": "/@tablesando_kwsk/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2607607, "client_id": 2820476, "vtt_url": null, "thumbnail_ima