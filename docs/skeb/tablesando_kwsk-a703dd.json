8d22-9d2c3d69aedc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=484e22554c2a9fd3fb26a6828b0a24d4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/315369ad/uploads/origins/594e4779-4f0c-4b97-8d22-9d2c3d69aedc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06ad690d51d282ae6e5e79545ec93e70", "srcset": "https://si.imgix.net/315369ad/uploads/origins/594e4779-4f0c-4b97-8d22-9d2c3d69aedc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06ad690d51d282ae6e5e79545ec93e70, https://si.imgix.net/315369ad/uploads/origins/594e4779-4f0c-4b97-8d22-9d2c3d69aedc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb52f82e5706b536d7c4973f7fe1af9 2x, https://si.imgix.net/315369ad/uploads/origins/594e4779-4f0c-4b97-8d22-9d2c3d69aedc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d3106aad6ca0da7e948439dfb9ec8d9 3x"}, "body": "こんにちは、今回初めてのリクエストをお願いしたいと思います、よろしくお願いします！\n綺良々と千織のお話を漫画で描いていただきたいです。\n以下詳細になります。\n\n「はらぺこきらら」\n①綺良々は千織の店を訪れて服の修繕を頼む\n千織は「太ったの？」と揶揄い、「悪いヤツに傷付けられたの！」と怒る綺良々\n②数分後、修繕も終わりごきげんで配達の仕事に戻るが、仕事が早く終わったのでフォンテーヌで食べ歩きをする綺良々\n③沢山食べ満足そうにしていると限定ケーキの広告を見かけ残り一つというアナウンスを聴き食べようとする綺良々だが、そのケーキはとんでもなく巨大なもので、既に沢山食べたお腹がどんどん膨れていく\n(ここのシーンでは途中目がぐるぐるになっていると嬉しいです)\n④その後お腹がパンパンになり服が破けてしまったので再度千織の店を訪れる綺良々\n「...太ったの？」と千織に聞かれてゲップをしながら「食べ過ぎて服が破けちゃったの！」と正直に答える綺良々なのであった\n\n以上です。\n綺良々が食いしん坊な感じになってしまいましたが、色々な物を食べたり押しに弱かったり嘘が下手な可愛い綺良々を表現出来たかなと思います...！\n是非ご検討よろしくお願いします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tablesando_kwsk/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2607607, "client_id": 61899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e367c0a0/uploads/origins/57ec5d85-6e2f-4782-b072-c52953972d3c?bg