op&w=200&h=200&blur=200&s=26f407cc271af11f76562bb67f8ef9ce 3x"}, "body": "biboさん、アピールありがとうございます。私はあなたが私のVTuberを気に入ってくれて嬉しいです。\n\n最近はかわいいイラストしか手に入りません。でも、私はあなたのダークなスタイルが好きです。私は自分の二重性を見せたいので、あなたが私を助けてくれることを願っています！特にお願いすることはありません。暗い面を見せてくれるなら、それが私の望むところです！\n\nよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1I5r3tHN-3YOAj7ckF8eIGnroAz-m0DwR/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@biborinus/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3288695, "client_id": 2011777, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24a3ef5e/uploads/origins/f4df78c6-dd19-4d73-a62a-729a5c23b296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=613676b28c3f7258572acdea01f44293", "srcset": "https://si.imgix.net/24a3ef5e/uploads/origins/f4df78c6-dd19-4d73-a62a-729a5c23b296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=613676b28c3f7258572acdea01f44293, https://si.imgix.net/24a3ef5e/uploads/origins/f4df78c6-dd19-4d73-a62a-729a5c23b296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9a4a2531f2b18df3e671c059d668853 2x, https://si.imgix.net/24a3ef5e/uploads/origins/f4df78c6-dd19-4d73-a62a-729a5c23b296?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b04609a2ce135a2f7667f73efb1ec4a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24a3ef5e/uploads/origins/f4df78c6-dd19-4d73-a62a-729a5c23b296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58c51b326c28b3483a5c9281d70f2af8", "srcset": "https://si.imgix.net/24a3ef5e/uploads/origins/f4df78c6-dd19-4d73-a62a-729a5c23b296?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58c51b326c28b3483a5c9281d70f2af8, https://si.imgix.net/24a3ef5e/upload