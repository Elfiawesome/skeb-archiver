q8jtm9gi2x7823gxsw/AD0UWN229kpuA9MElYqpucA?rlkey=439dt1mvcste3mcz35230zx6p&st=nwjbpom7&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@john_works/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926703, "client_id": 3927454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd892d1e4ddbcad4912786cabbb5f83a", "srcset": "https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd892d1e4ddbcad4912786cabbb5f83a, https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6300bc611c23e1691c3aba1f809c5fcc 2x, https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce8f54b5ced3e19ea7ed7228172b7963 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd18aadde13eeb66854de86aeaf8453f", "srcset": "https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd18aadde13eeb66854de86aeaf8453f, https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50a6edba0a8654a44e46b155a0068b72 2x, https://si.imgix.net/e1cf85c8/uploads/origins/1a86a77f-af56-43b3-baff-93ccacc722c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c64c29e81eafbc91afff697f9e2e566 3x"}, "body": "Johnさん！skeb開設ありがとうございます！！早速ですがOCをお願いしたく思います…！！\n\n用途は個人鑑賞、スマホのホーム画面への使用、SNSへの掲載です。\n\nクトゥルフ神話TRPG「JOKER≒JOKER」というシナリオの参謀として参加したキャラクターですが、シナリオ概要をご存知なくても大丈夫です…！怪盗をやっている頭脳担当のツンギレ(ツンデレ)女です！いろいろ衣装差分など好き勝手に描いてますが、かわいいものが好きなのでかわいければなんでもいいですおまかせ可能であればご検討ください…！\n\n\n【設定】\n名前：Celeste･Moon（セレスト・ムーン）\n職業：怪盗(兼ホワイトハッカー)\n身長：163㎝\n性格：ツンギレ(たまにツンデレ)\n一人称：私\n二人称：あんた\n好き：効率的\n嫌い：茶番、見下されること\n趣味：睡眠の質を上げること、メイク\n\n本名は金剛 燈芽（こんごう ひめ）\n\n口下手でツンとした態度が基本。頭の回転が早く、怪盗団(S4)の参謀を担っている。ハッキングが得意。普段はホワイトハッカーやデイトレーダーをしている。人が嫌いなわけではないが人見知りで、怪盗であることを知られるのも避けたいために交友関係は狭い。本当はもう少し友だちが欲しい。怪盗の顔と区別するため、外出のときは帽子や伊達メガネ(黒縁スクエア)をしたり、髪型やメイクを変えたりしている。\n\nちょっと際どめのコスをアップする裏アカがある(顔は隠してる)。それなりにフォロワーが増えた時点で現在は鍵アカとなっている。\n\n【サンプルセリフ】\n「Celeste･Moon（セレスト・ムーン）。…御託はいい。もらうだけだから」\n「遊びに来たんじゃないんだけど……」\n「……ばか」\n\nhttps://drive.google.com/drive/folders/1DkepNz9G0h39dUV1-4vgBC4JCbQ-TVLv", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 379603, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "浅井うみ", "screen_name": "asaiumi", "avatar_url": "https://pbs.twimg.com/profile_images/1245595127906615298/5IIateMQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1245594494822535173/1613843278/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 0}, {"id": 850706, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふうま ちい✨Comms Open✨", "screen_name": "huumachii", "avatar_url": "https://pbs.twimg.com/profile_images/2025157240450359296/0OHs9tTQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/151036821/1727383911/1500x500", "appeal_receivable": false, "po