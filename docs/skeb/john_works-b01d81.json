n【サンプルセリフ】\n「Celeste･Moon（セレスト・ムーン）。…御託はいい。もらうだけだから」\n「遊びに来たんじゃないんだけど……」\n「……ばか」\n\nhttps://drive.google.com/drive/folders/1DkepNz9G0h39dUV1-4vgBC4JCbQ-TVLv", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1306214, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七θ", "screen_name": "tknanasitan", "avatar_url": "https://pbs.twimg.com/profile_images/1253908104997036033/zrq0n7LR.png", "header_url": "https://pbs.twimg.com/profile_banners/2979693529/1587789964/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1834430, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "テラサワマスミ", "screen_name": "TerasawaMasumi", "avatar_url": "https://pbs.twimg.com/profile_images/1641832024653848581/lyw2CarV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1175192541139849216/1680278244/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1891283, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "れぴす", "screen_name": "lepis_ff14", "avatar_url": "https://pbs.twimg.com/profile_images/1640362638868901889/j1zOZ9rz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/917370099283091456/1710845794/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"ge