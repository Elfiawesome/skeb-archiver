VHFk9RzZBp3?usp=drive_link\nhttps://www.pixiv.net/artworks/108159815\n資料は量があるため、不要なものは読み飛ばしていただいて大丈夫です。口調等の不明点も適当に解釈していただいて構いません。\n\nリクエスト内容は以上になります。諸々難しい場合は遠慮なくキャンセル等していただいて構いません。書けそうな要素がありましたら、ご検討いただけると幸いです。", "nc": 17, "word_count": 3992, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@giallo_7/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6460d40e/uploads/origins/59bb5921-c1e8-4ed5-af76-3d7fbccaf01e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8d342f4dbd8eafd208faafddf358c2c", "srcset": "https://si.imgix.net/6460d40e/uploads/origins/59bb5921-c1e8-4ed5-af76-3d7fbccaf01e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8d342f4dbd8eafd208faafddf358c2c, https://si.imgix.net/6460d40e/uploads/origins/59bb5921-c1e8-4ed5-af76-3d7fbccaf01e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ca3780d00cbc8e64f002c7107d775c3d 2x, https://si.imgix.net/6460d40e/uploads/origins/59bb5921-c1e8-4ed5-af76-3d7fbccaf01e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b0e2b688d0ad6ed0e81d52afcbfff03 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 1224140, "nc": 129}, {"path": "/@giallo_7/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1224140, "client_id": 2997980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6410571c/uploads/origins/a9283ee9-da66-46d3-9cbe-93310d5a023c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=