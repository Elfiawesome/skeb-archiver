4ed0-b57b-b02d50cc8310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ef47bad288d225ce47fef132b0bc4d9 2x, https://si.imgix.net/9e0f0549/uploads/origins/31d77432-bf74-4ed0-b57b-b02d50cc8310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e805231d9305d0e97b15a44e547ccef7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e0f0549/uploads/origins/31d77432-bf74-4ed0-b57b-b02d50cc8310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d1ac6c8999bb87e15f1406e7267f906", "srcset": "https://si.imgix.net/9e0f0549/uploads/origins/31d77432-bf74-4ed0-b57b-b02d50cc8310?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d1ac6c8999bb87e15f1406e7267f906, https://si.imgix.net/9e0f0549/uploads/origins/31d77432-bf74-4ed0-b57b-b02d50cc8310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60d2f7487ff742443cc25ab399706e9c 2x, https://si.imgix.net/9e0f0549/uploads/origins/31d77432-bf74-4ed0-b57b-b02d50cc8310?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=426f3b7a48e6b0b5ad49c056fb15cab6 3x"}, "body": "なて様、はじめまして！\nなて様の描かれる男性キャラのお顔が好き過ぎて、いつか依頼できたらと思っておりました。よろしければ拙宅のマイキャラを描いていただけたらと、リクエスト致します。\n\n\n描いていただきたいのは、PSO2で使用しているマイキャラです。\n(それぞれ数百種類以上ある髪型や瞳、眉毛、睫毛、メイクパターン、アクセサリーなどを使用し、顔パーツや輪郭、体格バランスなどを細かく調整して作成したOC)\n\nキャラクター詳細につきましては資料URLをご覧下さいませ。\nもしゲーム内キャラクタークリエイトでの作成キャラは不可な場合は、髪型や服装、アクセサリーなど、すべて”イメージとしての資料”として捉えていただき、描いていただけたら幸いです。\n\n【使用用途】個人鑑賞他、SNSアイコン、ヘッダーとして\n【名前】千早\n【性別】男性\n【年齢】26\n【身長】188cm\n【髪色】少し赤みがかった暗めのミルクティーブラウン\n【瞳の色】金色(ほんの少しだけ緑がかっている)\n【衣装】キャラクター詳細の衣装（スーツジャケット姿）\n【その他特徴】\n1.左目の下に泣きぼくろ\n2.目尻に赤いメイク\n3.身体にタトゥー有り\n4.サソリのペンダント\n【キャラクター性】\n常に軽く微笑んでいて立ち居振る舞いもスマート。甘やかな顔立ちだが、基本的に人を信用しておらず言葉巧みに本心を隠す。自分や他人に厳しいが、本当に気を許した相手には厳しいながらも甘い一面を見せる。\n【希望イラスト】\n可能でしたらこのようなイメージで、片手でスーツジャケットを肩にかけている格好いいイラストを描いていただけませんか？↓\nhttps://twitter.com/RAMUNENAPOLITAN/status/1087100831856353280?t=zohJN87F12gm4cAgcSYTeQ&s=19\n\n表情や背景、ポーズ、衣装やアクセサリーのアレンジ等、全てなて様にお任せ致します。縦横比率もお任せしますので、なて様の好きをたっぷり詰め込んで、なによりも楽しく描いていただけましたら嬉しく思います。\n\n納品希望につきましてはpsdで、メッセージ等は不要です(skebの印刷サービスで印刷注文する際、レイヤー選択は不可能な為)\n\n\n以上です。長文申し訳ありません💦\nもし引き受けて下さった際には、よろしくお願い致します…！\n\nhttps://drive.google.com/folderview?id=1svZXm1TlPmn2SWdz4DvT2P_dfBA0DMR-", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1009Nanamu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2486597, "client_id": 1674549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7fe9820/uploads/origins/2fc8efb9-7777-4814-89a4-db521ebe4f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2898ca1edff3503f4f325b4fd4af4726", "srcset": "https://si.imgix.net/e7fe9820/uploads/origins/2fc8efb9-7777-4814-89a4-db521ebe4f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2898ca1edff3503f4f325b4fd4af4726, https://si.imgix.net/e7fe9820/uploads/origins/2fc8efb9-7777-4814-89a4-db521ebe4f96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6e3aa7f94052225a3d463f8fce46234 2x, https://si.imgix.net/e7fe9820/uploads/origins/2fc8efb9-7777-4814-89a4-db521ebe4f96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33c2ce649507857ec0830dd11afb7286 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7fe9820/uploads/origins/2fc8efb9-7777-4814-89a4-db521ebe4f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb67ef05acbc5a8a965ff66356c478e4", "srcset": "https://si.imgix.net/e7fe9820/uploads/origins/2fc8efb9-7777-4814-89a4-db521ebe4f96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb67ef05acbc5a8a965ff66356c478e4, https://si.imgix.net/