にかけて自然な癖がついている。\n目の色　　　　　：左目が緑、右目が青の虹彩異色症。色の違いはほとんどわからない程度でいい(なおこれは趣味100%です)。\n服装　　　　　　：ブリティッシュ・スタイルのスーツ。といってもそれほど詳しく分からないので、固そうな布地で、きっちりかっちりした印象があれば十分すぎるほどうれしい。生地はダークグレーのシャドウストライプ(=控えめなストライプ柄。体型を下品に目立たせないためのチョイス)。シャツは白。首元にはシンプルなアクセサリーを付けている。\nポーズ　　　　　：駒置き場が正面を向いた椅子なので、堂々と優雅に座りたい…！\nイメージカラー　：青\nその他こだわり　：色々書いたけど、なてさんが「こうしたほうがイイかも！/描きやすいかも！」と思うものがあれば、全て無視してもらって大丈夫です(服装がスーツで、胸が…大きいというところだけは残していただけると幸いです)。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1009Nanamu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2486597, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ff3b28f/uploads/origins/b92e21d5-70f2-4194-9775-a3c539fe7342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=550cb883f6d4e12484b96a22dee7da87", "srcset": "https://si.imgix.net/8ff3b28f/uploads/origins/b92e21d5-70f2-4194-9775-a3c539fe7342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=550cb883f6d4e12484b96a22dee7da87, https://si.imgix.net/8ff3b28f/uploads/origins/b92e21d5-70f2-4194-9775-a3c539fe7342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be0c8212a797bb9fafe259f4a2248d65 2x, https://si.imgix.net/8ff3b28f/uploads/origins/b92e21d5-70f2-4194-9775-a3c539fe7342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77d1a64df3b28bdee87f9762d0b98195 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ff3b28f/uploads/origins/b92e21d5-70f2-4194-9775-a3c539fe7342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a6d7aa5624d68c054c212d574274f8c", "srcset": "https://si.imgix.net/8ff3b28f/uploads/origins/b92e21d5-70f2-4194-9775-a3c539fe7342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a6d7aa5624d68c054c212d574274f8c, https://si