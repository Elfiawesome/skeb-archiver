s/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9361213eb5473f20c0387e2c777dd302", "srcset": "https://si.imgix.net/5e17521b/uploads/origins/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9361213eb5473f20c0387e2c777dd302, https://si.imgix.net/5e17521b/uploads/origins/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd10db602d3ec8ceadacf921d5149507 2x, https://si.imgix.net/5e17521b/uploads/origins/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b01dda7f343a2d2faa7dd475ea0c75d8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e17521b/uploads/origins/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecdde788cc916a29aa9ff73809325e94", "srcset": "https://si.imgix.net/5e17521b/uploads/origins/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecdde788cc916a29aa9ff73809325e94, https://si.imgix.net/5e17521b/uploads/origins/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ca9b8a4dbc0c720fbc2b6396df382bf 2x, https://si.imgix.net/5e17521b/uploads/origins/6d25e2a0-b551-4a3b-b562-e92098b913bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=696e9af65155497dc5f039b22e560faa 3x"}, "body": "初めまして\n\nオリジナルキャラで、昔の農家の20代前半、\n純朴そうな黒髪女性の緊縛イラストをリクエストしたいです。\n髪型、顔だち、体型はお任せします。\n\n恰好\n野良着、もんぺ、足袋履きで、\n胸をだしてM字開脚縛りされています。\n表情は縛られて、泣いている感じにしてほしいです。\n頭から爪先まで全身を描いてほしいです。\n\n服装\n野良着の色は紺、模様は適当に、\nもんぺはへその下辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n足袋はくるぶしまでの長さ、色は赤、足袋底は白にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n\nまた、\n股間部分を破られて、陰部に極太の張型が挿入され\n表情も痛さで苦しそうに涙を流して絶叫している状態もお願いします。\n\nつたない説明で恐縮ですが説明不足な点、ポーズ、構図など自由に\n変更、アレンジしていただいて構いませんが、\n必ずもんぺが破れていない状態と破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/s/shhirdcz5xps18w/sm01.png?dl=0", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hr_works/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 970898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d09c2ce/uploads/origins/073f5649-a401-46d7-9776-01150296e138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c57d458998ec4b011da608f7bd038fa", "srcset": "https://si.imgix.net/6d09c2ce/uploads/origins/073f5649-a401-46d7-9776-01150296e138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c57d458998ec4b011da608f7bd038fa, https://si.imgix.net/6d09c2ce/uploads/origins/073f5649-a401-46d7-9776-01150296e138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5dcceef9e35b9b4b094a9f24ea787119 2x, https://si.imgix.net/6d09c2ce/uploads/origins/073f5649-a401-46d7-9776-01150296e138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0101d4ac90bbaeef05b42a53bfec127b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d09c2ce/uploads/origins/073f5649-a401-46d7-9776-01150296e138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05ae246c73d357c1eff61f0a17e3e664", "srcset": "https://si.imgix.net/6d09c2ce/uploads/origins/073f5649-a401-46d7-9776-01150296e138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05ae246c73d357c1eff61f0a17e3e664, https://si.imgix.net/6d09c2ce/uploads/origins/073f5649-a401-46d7-9776-01150296e138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&