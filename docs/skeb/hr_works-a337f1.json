b1e37aa8 2x, https://si.imgix.net/1a0f9b7f/uploads/origins/9fa916a9-cc65-4d89-a627-7449fb00c980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=322c87fced520b96db7401167f066b9f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a0f9b7f/uploads/origins/9fa916a9-cc65-4d89-a627-7449fb00c980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c70ad251b989e5424da56db1205f040", "srcset": "https://si.imgix.net/1a0f9b7f/uploads/origins/9fa916a9-cc65-4d89-a627-7449fb00c980?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c70ad251b989e5424da56db1205f040, https://si.imgix.net/1a0f9b7f/uploads/origins/9fa916a9-cc65-4d89-a627-7449fb00c980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d112fbcab683d7517a21d2e48ddfc3fd 2x, https://si.imgix.net/1a0f9b7f/uploads/origins/9fa916a9-cc65-4d89-a627-7449fb00c980?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f07e92adb1d25c493736afbb28148475 3x"}, "body": "キャラクター アイドルマスターシャイニーカラーズ　　　八宮めぐる　https://shinycolors.idolmaster.jp/idol/illuminationstars/meguru.html\n\n状況　　輪姦\n\n服装は艦隊これくしょんの島風 靴部分はいりません \n\n髪型は服装に合わせず元のキャラクターのもの\n\n上着がはだけての胸の露出と局部への下着ずらし挿入\n\n挿入は膣 膣と肛門のいずれかであり、他の男性器は手に握らせられていたり顔や体の周りにあったりをお願いします（他の男性器は～の部分は構図的に難しいようならかまいません）\n\n表情は輪姦を前提としたもので大きな涙を流しながら泣き叫んでおり、差分として各レイヤー別で睨み顔、レイプ目で涙を流している無表情顔、無理やりイカされてしまった最中の顔、口内に男性器を挿入されて苦しんでいるような絵をお願いします\n\n強姦される際に殴られた赤い痣を口元に付けてください(痣の大きさははあまり大きくはないですがハッキリ分かるくらいに）\n\n片方の胸には力任せに揉みしだかれて全体的に赤くなった跡を\n\n揉みしだかれた側の胸は強く噛まれて真っ赤に（噛み跡はいりません）\n\n差分として各レイヤー別で全ての竿、竿役が消えた状態と、顔や胸の痣、胸の変色がない差分、パンツを履いている状態(挿入されておらず正しく着用している状態です）の差分が欲しいです\n\n構図的に無理なく入りそうなら右手薬指に指輪を嵌めてください　無理そうなら嵌めなくても大丈夫です　　嵌める場合右手の衣装は要りません\n\n構図の邪魔になり体が隠れるようなら竿役は半透明\n\n陰毛はなし\n\n構図、体位はどのような形であれ顔と胸と挿入部が良く見えるように　　 構図、体位的に難しければ別カット　断面図などをお願いします\n　\n局部修正は必ずhttps://skeb.jp/@enozuderuさんくらいで\n\n画面サイズ3840×2160の16：9かそれに近いサイズの横長\n\nPSDでの納品\n\n金額面,非表示,修正などでの不都合があれば再送", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hr_works/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 970898, "client_id": 456509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a398430622aa81f41269dab459251b7", "srcset": "https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a398430622aa81f41269dab459251b7, https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960e2065fc97c5cba12092986a80fcf0 2x, https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad870095900921cf03d3779f5b63bef4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2422bd919d5775ddff0ffee4ec2bb7b0", "srcset": "https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2422bd919d5775ddff0ffee4ec2bb7b0, https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79e992cacc0212b9045bfdcd4eeb2b6f 2x, https://si.imgix.net/1e9e3e20/uploads/origins/a8151ba5-c0f8-48bc-875d-cae8cfbc4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t