u306a\u5185\u5bb9\u3067\u3059\u304c\u300c\u81ed\u3044\u8cac\u3081\u5bf8\u6b62\u3081\u304f\u3059\u3050\u308a\u8abf\u6559\u300d\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u9b54\u6cd5\u5c11\u5973\u306f\u30b5\u30ad\u30e5\u30d0\u30b9\u3068\u8272\u3005\u3042\u3063\u3066\u6557\u5317\u3057\u3001\u5730\u4e0b\u65bd\u8a2d\u3067\u8abf\u6559\u3055\u308c\u3066\u3044\u307e\u3059\u3002\n\u30b5\u30ad\u30e5\u30d0\u30b9\u306f3\u4eba(\u4ee5\u4e0a)\u3044\u3066\u3001\u4eca\u56de\u306e\u8abf\u6559\u306e\u5185\u5bb9\u306f\u4ee5\u4e0b\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002\n\u30fb\u9b54\u6cd5\u5c11\u5973\u306f\u7bb1\u72b6\u306e\u8abf\u6559\u5668\u5177\u306e\u4e2d\u306b\u5165\u3063\u3066\u62d8\u675f\u3055\u308c\u3066\u304a\u308a\u3001\u7bb1\u306e\u4e0a\u90e8\u304b\u3089\u982d\u304c\u3001\u7bb1\u306e\u524d\u9762\u90e8\u5206\u304b\u3089\u8170\u304b\u3089\u592a\u3082\u3082\u307e\u3067\u306e\u304a\u5c3b\u306e\u90e8\u5206\u3068\u8db3\u9996\u304b\u3089\u8db3\u88cf\u307e\u3067\u306e\u90e8\u5206\u304c\u9732\u51fa\u3057\u3066\u3044\u307e\u3059\n\u30fb\u30b5\u30ad\u30e5\u30d0\u30b9\u306f\u4ee5\u4e0b\u306e\u6d41\u308c\u3067\u8abf\u6559\u3092\u884c\u3044\u307e\u3059\n1. \u9b54\u6cd5\u5c11\u5973\u306e\u9854\u306b\u30b5\u30ad\u30e5\u30d0\u30b9\u306e\u9774\u3092\u55c5\u304c\u305b\u308b\u5f62\u3067\u56fa\u5b9a\u3057\u307e\u3059\u3002\u30d0\u30a4\u30d6\u3092\u81a3\u306b\u5165\u308c\u3066\u8d77\u52d5\u3057\u3001\u7d76\u9802\u5bf8\u524d\u307e\u3067\u9774\u306e\u81ed\u3044\u3092\u899a\u3048\u3055\u305b\u307e\u3059\n2. \u30a4\u30ad\u305d\u3046\u306b\u306a\u3063\u305f\u3089\u30d0\u30a4\u30d6\u3092\u6b62\u3081\u3066\u5bf8\u6b62\u3081\u3057\u307e\u3059\u3002\u5168\u54e1\u306e\u30b5\u30ad\u30e5\u30d0\u30b9\u304c\u5b9f\u884c\u3057\u7d42\u308f\u308b\u307e\u30671\uff5e2\u306e\u4f5c\u696d\u3092\u884c\u3044\u307e\u3059\n3. \u8ab0\u306e\u9774\u304b\u308f\u304b\u3089\u306a\u3044\u3088\u3046\u306b\u3057\u3001\u9b54\u6cd5\u5c11\u5973\u306b\u9774\u306b\u81ed\u3044\u3092\u55c5\u304c\u305b\u8ab0\u306e\u9774\u306e\u3082\u306e\u304b\u7b54\u3048\u3055\u305b\u307e\u3059\n4. \u5408\u3063\u3066\u3044\u305f\u3089\u5168\u54e1\u5206\u306e\u7b54\u3048\u304c\u5408\u3046\u307e\u30673. \u3092\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002\u9593\u9055\u3048\u305f\u5834\u5408\u3001\u304a\u4ed5\u7f6e\u304d\u3068\u3057\u3066\u5668\u5177\u304b\u3089\u51fa\u73fe\u3057\u305f\u56de\u8ee2\u30d6\u30e9\u30b7\u304c\u8db3\u88cf\u309210\u5206\u9593\u304f\u3059\u3050\u308a\u7d9a\u3051\u307e\u3059(\u7bb1\u306e\u5916\u304b\u3089\u306f\u898b\u3048\u306a\u3044\u3067\u3059\u304c\u3001\u5185\u90e8\u3067\u306f\u814b\u306e\u90e8\u5206\u3082\u56de\u8ee2\u30d6\u30e9\u30b7\u3067\u304f\u3059\u3050\u3089\u308c\u307e\u3059)\u3002\u305d\u3057\u3066\u30011. \u304b\u3089\u3084\u308a\u76f4\u3057\u306b\u306a\u308a\u307e\u3059\n\n\u8abf\u6559\u304c\u7d42\u308f\u308b\u3068\u89e3\u653e\u3055\u308c\u308b\u306e\u3067\u3001\u9b54\u6cd5\u5c11\u5973\u3061\u3083\u3093\u306f\u5fc5\u6b7b\u306b\u9811\u5f35\u308a\u307e\u3059\u304c\u3001\u30b5\u30ad\u30e5\u30d0\u30b9\u306e\u9774\u306e\u84b8\u308c\u3066\u3044\u3066\u304f\u3063\u3055\u3044\u81ed\u3044\u3068\u50ac\u6deb\u52b9\u679c\u3001\u5ea6\u91cd\u306a\u308b\u5bf8\u6b62\u3081\u3068\u304f\u3059\u3050\u308a\u3067\u5168\u304f\u7b54\u3048\u304c\u5408\u308f\u305a\u30ae\u30d6\u30a2\u30c3\u30d7\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\n\u30ae\u30d6\u30a2\u30c3\u30d7\u3057\u305f\u7f70\u3068\u3057\u3066\u3001\u30b5\u30ad\u30e5\u30d0\u30b9\u306e\u4e0b\u7740\u3092\u53e3\u306e\u4e2d\u306b\u5165\u308c\u305f\u4e0a\u3067\u30b5\u30ad\u30e5\u30d0\u30b9\u306e\u8db3\u88cf\u3092\u76f4\u63a5\u55c5\u304c\u305b\u3001\u56de\u8ee2\u30d6\u30e9\u30b7\u3092\u8d77\u52d5\u3059\u308b\u3068\u3044\u3046\u904e\u9177\u306a\u81ed\u3044\u8cac\u3081\u304c\u5f85\u3063\u3066\u3044\u308b\u306e\u3067\u3057\u305f\u3002", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akmymz/works/1", "private_thumbnail_image_urls": {"src": "https://si.im