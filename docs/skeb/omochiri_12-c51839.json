d997cb1126 2x, https://si.imgix.net/d13f8008/uploads/origins/b4a95f34-8e61-4519-b916-5876fc934594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa4cca8029ee86b8af4ddc7a97cfc751 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d13f8008/uploads/origins/b4a95f34-8e61-4519-b916-5876fc934594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86182f325f2950589e14adc29e5468e2", "srcset": "https://si.imgix.net/d13f8008/uploads/origins/b4a95f34-8e61-4519-b916-5876fc934594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86182f325f2950589e14adc29e5468e2, https://si.imgix.net/d13f8008/uploads/origins/b4a95f34-8e61-4519-b916-5876fc934594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5651a6c5b12f5c7ba450934713b7d70 2x, https://si.imgix.net/d13f8008/uploads/origins/b4a95f34-8e61-4519-b916-5876fc934594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d24ff7e061de825e371b70db67e65e 3x"}, "body": "アピールありがとうございます！\n初めまして。配信アプリ「IRIAM」にて活動させて頂いております、堂々廻サラウと申します。\n𝙕𝙐𝙆𝙄𝙈様の暖かみのある素敵な厚塗りイラストに惹かれ、リクエストを送らせて頂きます。\n\nイラストの構図はおまかせで、𝙕𝙐𝙆𝙄𝙈様の世界観で描いて頂ければと思います。\n\n■詳細\n・SNSでの使用\n・配信アプリ「IRIAM」や「YouTube」等配信媒体でのサムネイル利用\n・ネットプリントや壁紙への使用・配布\n\n▼堂々廻サラウ（黒髪黒目・当方）\n裏社会―アンダーグラウンド―を生きる、性別年齢その他詳細不明の謎多き人物。\n中性的な見た目、ニヤつき顔がデフォルト。\nアホ毛・ギザ歯・口元のほくろ・舌ピアス・スプリットタンは忘れないようにお願いします。\n服装は通常衣装など様々ありますが、好きなものを選んで頂いて構いません。オリジナル改変も大歓迎です。\n\n金額に不備があれば変更致します。\nお忙しいなか恐縮ですが、お引き受け頂けますと幸いです。何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1njB2foFH2KdsXUMYjcY0KkB8pngolWm4", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omochiri_12/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3502815, "client_id": 3607348, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a4602159a6ce37bca95456a4c57cd4", "srcset": "https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45a4602159a6ce37bca95456a4c57cd4, https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d75ac0f2ec509ec9addea60012b54f55 2x, https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad431e11416485c96bb9efdcb84f2b5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=046bcec3cbe653996926831d0c884191", "srcset": "https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=046bcec3cbe653996926831d0c884191, https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf1d77272e0d8f7479e368dbf863a13a 2x, https://si.imgix.net/fa78ec07/uploads/origins/75c8af19-f90d-4b86-9e2e-d8e038cb375a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=817c88913cf39d4b1d110e693b9a9b0b 3x"}, "body": "ヅキモ様初めまして！\nアピール送っていただきありがとうございます！\n\n◆依頼内容◆\n私のocのアルシェを是非ヅキモ様に描いていただきたいです！\n\n◆使用用途◆\n・SNSアイコン、ヘッダー\n・スマートフォンやPCの壁紙\n・納品していただいた絵を資料として他の方への依頼に添付使用\n\n◆納品形式◆\n・PSD\nキャラと背景と宛名を分けれるようにしたデータ。\nまた、もしよろしければ描く際に線画や塗りでレイヤーを分けていたら結合せずフォルダ等でまとめて残しておいてくださると嬉しいです！こちらに関しては難しければ大丈夫です！\n\n・PNG　1枚\n宛名とヅキモ様のサインとヅキモ様が一番良いと思う表示の仕方で書き出した1枚をお願いします！\n\n◆イラストイメージ◆\n･傷を負いながらも強い相手と巡り会えて笑っているイラストをお願いしたいです！少し狂気を感じるガン開きの目だと嬉しいです…！\n･イラストは等身で、ヅキモ様の素敵な厚塗りが見れるといいなと思います！\n･少し血飛沫が顔にかかっていると嬉しいです。後述にある魔禍の血の色に決まりは無いので青色でも普通の赤色でも何色でも大丈夫です。\n･赤色が鮮やかに見えるシチュエーションやライティングでお願い致します！\n･衣装は基本資料通りでお願い致します。細かい箇所や、資料少なく分からない部分は改変していただいて構いません💓\nマントは着脱ご自由にしてください。\n\n◆世界観◆\n旋律者(メロディア)と呼ばれる信託を受けた者のみつかえる浄化の力がある。\n\n普通の魔物とは別に魔禍(マガ)と呼ばれる普通の力では倒せない魔物が存在する。\nメロディアに力を分け与えられたものしか倒すことはできない。\n魔禍はメロディアに力を与えられた者が常通り戦い、結晶を破壊した後、メロディアと共に葬送の音を奏でることで完全に浄化することができる。\n魔禍の登場頻度は一国に一体現れている間は他には現れないといった程度だが、ごく稀に二国同時に現れることもある。\n\n―メロディアに力を与えられし者―\n各国の騎士の中から数名選ばれる\n選ばれた者は体のいずれかの場所にメロディアに与えられた力の証が浮かび上がる(例:アルシェの目の下のト音記号🎼。カイルの項の♭フラット)\n\n◆OC詳細◆\n名前 アルシェ\n年齢 19歳\n所属国 ❤赤の国(情熱と愛の国)\n楽器 ギター\n武器 長剣\n\n元傭兵の騎士団の特攻役\n強い相手を求めて日々戦いに身を置いていたが、メロディアに力を与えられる前に魔禍と戦い敗れ、目に傷を負った。\nその戦いの中、窮地を救ってくれた赤の騎士団に能力を買われ一員となった。\n魔禍との戦いを常に望んでいる。強者の言うことは聞く。\n野良犬のように日々を過ごしている。\n普段は騎士団のメンバーと手合わせをして過ごすか、街の酒場で傭兵時代の仲間と酒を飲みかわしている。\n葬送の音を奏でる為に渋々ギターを習い始めたが意外と楽しくセンスもあった為戦闘以外の趣味が増えた。\n戦いが関わらなければ基本面倒見の良い兄ちゃん。\n\nご検討のほどどうぞよろしくお願い致します！！\n\nhttps://drive.google.com/drive/folders/16zKot2VjDgs6aip5VoeGKiBrqr0HtOiy", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omochiri_12/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c3796035/uploads/origins/e3e0767f-8593-47b7-94cf-79451853c8eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ceb03bea8ea31605a8613b2df655561b", "srcset": "https://si.imgix.net/c3796035/uploads/origins/e3e0767f-8593-47b7-94cf-79451853c8eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ceb03bea8ea31605a8613b2df655561b, https://si.imgix.net/c3796035/uploads/origins/e3e0767f-8593-47b7-94cf-79451853c8eb?bg=%23fff&auto=format%2Ccompress&fm=we