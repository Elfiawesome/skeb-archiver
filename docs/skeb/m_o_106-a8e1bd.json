3f222c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dba7aa7e26b5514c1f058331bb521696, https://si.imgix.net/f4080859/uploads/origins/f5698273-30b7-43f3-9f20-f12c13f222c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1750b50c9bdf34b49e59581f2be92a8b 2x, https://si.imgix.net/f4080859/uploads/origins/f5698273-30b7-43f3-9f20-f12c13f222c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9e1bd72b577b2b31cbf2112cb82ce97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4080859/uploads/origins/f5698273-30b7-43f3-9f20-f12c13f222c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7082fea340cef28dc40ad466179d7623", "srcset": "https://si.imgix.net/f4080859/uploads/origins/f5698273-30b7-43f3-9f20-f12c13f222c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7082fea340cef28dc40ad466179d7623, https://si.imgix.net/f4080859/uploads/origins/f5698273-30b7-43f3-9f20-f12c13f222c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a68777d6b2625ffd5c043175049ec7ce 2x, https://si.imgix.net/f4080859/uploads/origins/f5698273-30b7-43f3-9f20-f12c13f222c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea36541b4769f0230338d15466b27026 3x"}, "body": "はじめまして！\nあなたのアートは美しい！\n\n私の2人のOC、クライジとカリカの絵をお願いしたいです。どんなシチュエーションでもいいので描いてください。激しい戦いの最中でも、ロマンチックなデートの最中でも、ただ静かな時間を楽しんでいる二人でも構いません。\n\nクライジは180cm、カリカは170cmです。\n\nクライジは愛する人に激しく忠実で、守ってくれる。無口でシャイな印象を与えることもあるが、信頼する相手にはすぐに打ち解ける。エメラルド色の瞳を持ち、戦いで限界に達すると真紅に染まる。  とても思いやりがあり、カリカを深く愛している。  彼女と2人きりになったときだけ、より傷つきやすい一面を見せる。\n\nカリカは非常に自信家で恐れを知らない。他人を信頼するのが遅く、クライジとリラックスして過ごしているとき以外は、感情的な面を見せることはほとんどない。カリカは体格がよく、バストサイズも大きいので、体のラインを引き立てる服が一番似合う。  カリカはクライジと同じくらい剣の腕が立つので、もし戦場に駆り出されたとしても、お互いを信頼し、頼りにしている。\n\nもしこのシーンでカリカの体に鱗が見えたら、注意してください。   尻尾のポーズは自由です。  \n\nもっとカジュアルなシーンやロ