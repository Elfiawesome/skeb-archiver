ス\n年齢︰12歳\n性別︰女\n性格︰優しくおとなしい\n備考︰黒髪おかっぱ頭の魔女。\n服装は黒い普段着、白い夏服の2種類があり、黒服の方はわかりにくいですがベルトをしています。\n\n\n黒髪少女をうまく描かれているところが良いと思いましたので、「うちの子」も笑顔でかわいく描いて頂けたなら幸甚です。\nよければリクエストを受けて下さる形で結構ですので、宜しくお願い致します。\n\n※私の「うちの子」の資料は、URLの方を参照して下さい。\n\nhttps://auto.hanabie.com/sictes-kettei.html", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamapple0506/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3492556, "client_id": 2767686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64e82ee4/uploads/origins/69d8e7e3-a199-4ba9-b890-e7ed6f21fc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f0933a57050f19e3fc6ab4ebbfe5c66", "srcset": "https://si.imgix.net/64e82ee4/uploads/origins/69d8e7e3-a199-4ba9-b890-e7ed6f21fc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f0933a57050f19e3fc6ab4ebbfe5c66, https://si.imgix.net/64e82ee4/uploads/origins/69d8e7e3-a199-4ba9-b890-e7ed6f21fc04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76a57b16cb5400731146d0eea020c55f 2x, https://si.imgix.net/64e82ee4/uploads/origins/69d8e7e3-a199-4ba9-b890-e7ed6f21fc04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86979b144de17ddde9561a9aaf5ed337 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64e82ee4/uploads/origins/69d8e7e3-a199-4ba9-b890-e7ed6f21fc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14339cbc1e4a1b06a7966e7e1aed706e", "srcset": "https://si.imgix.net/64e82ee4/uploads/origins/69d8e7e3-a199-4ba9-b890-e7ed6f21fc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14339cbc1e4a1b06a7966e7e1aed706e, https://si.imgix.net/64e82ee4/uploads/origins/69d8e7e3-a199-4ba9-b890-e7ed6f21fc04?bg=%23fff&auto=format%2Ccompress&fm=web