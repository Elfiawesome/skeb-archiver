全員に囲まれて駐車場に連行されるボダフル\n③「このゲート開けて〜」とエイサップが指示\n「えっ？えっ？」と困惑するボダフル、指示通りにゲートを開ける\n④ゲートが開き「さぁ、行くんだ！」「達者でな〜」「もう悪い事するなよ〜」と手を振って見送る看守一同\nボダフル脱獄\n優しい世界！ハッピーエンド\n\n個人的に面白かった出来事だったので漫画化して頂けたら嬉しいです(*´ω`*)\n\n・ちなみに看守は全員生き残ってましたが人数多いので居た人全員描かなくていいです（全員描くと情報量凄いことになりそう）\n・起承転結に分けておいた方がいいかな？と思って番号割り振りましたが無視して描きやすい構成で問題ありません\n・登場アバターの指定も特にありません描きやすいアバターで大丈夫です\n\n初めて依頼するので説明不足があれば申し訳ないです\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@hibiki_11111/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1743251, "client_id": 1538730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/276100a4/uploads/origins/186f42b4-2ced-4fd7-a4ef-1b3c21172983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f11561a148eb5e529bf4880cfb4da9e", "srcset": "https://si.imgix.net/276100a4/uploads/origins/186f42b4-2ced-4fd7-a4ef-1b3c21172983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f11561a148eb5e529bf4880cfb4da9e, https://si.imgix.net/276100a4/uploads/origins/186f42b4-2ced-4fd7-a4ef-1b3c21172983?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad47998cf92ce1b6de2805e23a305757 2x, https://si.imgix.net/276100a4/uploads/origins/186f42b4-2ced-4fd7-a4ef-1b3c21172983?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04bfb44a75e60d4717f6fdbd0ac620f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/276100a4/uploads/origins/186f42b4-2ced-4fd7-a4ef-1b3c21172983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8801e777045498a178f3c7905f9d8fe8", "srcset": "https://si.imgix.net/276100a4/uploads/origins/186f42b4-2ced-4fd7-a4ef-1b3c21172983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8801e777045498a178f3c7905f