ション・内容\nリタとグレアは互いに依存症レベルの恋人関係\n恋人関係になってもまだ近い距離感に慣れないグレア。リタはそんなことを気にせずグレアに横から飛びつくように抱き着く。\nリタは狙ってやってるのか、顔がむにゅーっとグレアの横胸に当たって感触を堪能しながら楽しそうに抱き着いている\nグレアは照れながらも、まんざらではない様子\n\n〇その他\n不明点やほかの背景はお任せいたします。アレンジや追加なども大歓迎です！\n描いていただいたイラストは、自創作小説（https://www.pixiv.net/novel/series/7713141）の挿絵にさせていただく場合がございます\nどうぞよろしくおねがいします！\n\nhttps://drive.google.com/drive/folders/1_PCqO3gSsO6S3mu25v6MiS_Ep7QA0yQO?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kimitonoawai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1985614, "client_id": 923885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a340b50/uploads/origins/09b8043d-8e6e-4445-8e2e-c670f4f3bb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4637c2666f6403d20e7df61753f4ce9", "srcset": "https://si.imgix.net/8a340b50/uploads/origins/09b8043d-8e6e-4445-8e2e-c670f4f3bb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4637c2666f6403d20e7df61753f4ce9, https://si.imgix.net/8a340b50/uploads/origins/09b8043d-8e6e-4445-8e2e-c670f4f3bb02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81173d5345ab73614463a8aab9406069 2x, https://si.imgix.net/8a340b50/uploads/origins/09b8043d-8e6e-4445-8e2e-c670f4f3bb02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ddaed643e74a9bc02c72f34279d2cea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a340b50/uploads/origins/09b8043d-8e6e-4445-8e2e-c670f4f3bb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e691792bfcb46a86517111750d45560", "srcset": "https://si.imgix.net/8a340b50/uploads/origins/09b8043d-8e6e-4445-8e2e-c670f4f3bb02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e691792bfcb46a865171117