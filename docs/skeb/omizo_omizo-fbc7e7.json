ns/e87027f3-50e2-4012-b839-a5e8a27fbabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f496f49720f88d8739935a8fed155641, https://si.imgix.net/398dc446/uploads/origins/e87027f3-50e2-4012-b839-a5e8a27fbabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c6ac37aaca55ae61329828f7704abf8 2x, https://si.imgix.net/398dc446/uploads/origins/e87027f3-50e2-4012-b839-a5e8a27fbabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b75efe41a2cc79a847608ec8682e3621 3x"}, "body": "前のルルがとても良かったので、またお願いしたいです!\n\nバレンタインデーに、ルルからハート型のチョコレートの箱をプレゼントしてほしいです。両手を前に突き出し、目をギュッと閉じて嬉しそうに顔を赤らめている表情で、ワクワクしながら渡しています。\n\n衣装は、以前描いていただいたメイドルルのコンセプト（https://twitter.com/omizo_omizo/status/1567914657658339328）がとても気に入りました。バレンタインデーにちなんで、何かアレンジがあればお願いします。それ以外は普通のメイド服で大丈夫です。\n\nありがとうございました。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omizo_omizo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 354967, "client_id": 856159, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b00ee2d6e3e96dfa0cdd25b059eddfd", "srcset": "https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b00ee2d6e3e96dfa0cdd25b059eddfd, https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b96f04ee257cc5c1ce3e1df3e7f8b214 2x, https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45fdb2f1d25201778679ad50ad050993 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f6c71667588c7517a32f6c8d115b25", "srcset": "https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62f6c71667588c7517a32f6c8d115b25, https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c014598c246afd82953e647b0c18eea 2x, https://si.imgix.net/74600189/uploads/origins/0cf7df1d-2e6d-43d6-9336-9aa139d0a4c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79a8894ef08e0af6ebecbbc7d900e1f1 3x"}, "body": "こんにちは。ツイッターでかわいいヨードルアートを見つけて、そのアートスタイルがたまりません。是非ともリクエストさせてください。\n\nルルの \"ウィキッド \"スキンのアートをお願いします。いつものようにサポートするのではなく、まるで射撃手のような立ち振る舞い。杖をライフルのように腰の横で構え、見る人と向き合っています。ルルの表情は、興奮と決意が入り混じったものです。ルルとピクスは大量の魔法を高速で放ち、ルルはワイルドグロースでバフをかける。ワイルド・グロースによって、彼女の真下に吹く風の影響を受けたかのようにローブが持ち上がる（このために彼女のレッグウェアが見えるくらいである）。\n\n添付のimgurアルバムでは、二人の攻撃のビジュアルと、Wild Growthのビジュアルを見ることができます。\n\n背景などその他の要素については、自由に決めていただいて結構です。\n\n可能であれば、納品時にルル本人とは別レイヤーでWild GrowthとPix（サインも）をお願いします。\n\n私の要望がわかりやすく伝われば幸いです！ありがとうございました。\n\nhttps://imgur.com/a/qIVIvMk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omizo_omizo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 354967, "client_id": 135562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a409fb7f/uploads/origins/bb306abb-546c-46b7-b57c-011d6c4ab42c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b01feebf8f9922feecb951282bc5cc0c", "srcset": "https://si.imgix.net/a409fb7f/uploads/origins/bb306abb-546c-46b7-b57c