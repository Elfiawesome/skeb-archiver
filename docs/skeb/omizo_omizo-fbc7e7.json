いです\n\nよろしくおねがいします。\n\n以下参考資料\nスクリーンショット格納Googleドライブ\nhttps://drive.google.com/file/d/1WUCtYQYAWzo-7X_lTBXsN7IruRVRokHX/view?usp=drive_link\n\nAmserdさんのアバター素体\nhttps://wakonoatorie.booth.pm/items/4897562\n\nぽぴこのアバター素体\nhttps://booth.pm/ja/items/4910503", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omizo_omizo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 354967, "client_id": 342966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37aa72ac/uploads/origins/c1665e52-8c3c-488e-8ec1-f1d334bbb89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ba7e2a91dfd8c9578a408b823b51e7", "srcset": "https://si.imgix.net/37aa72ac/uploads/origins/c1665e52-8c3c-488e-8ec1-f1d334bbb89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ba7e2a91dfd8c9578a408b823b51e7, https://si.imgix.net/37aa72ac/uploads/origins/c1665e52-8c3c-488e-8ec1-f1d334bbb89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69df7bdda7671b16d8bedade337a1bae 2x, https://si.imgix.net/37aa72ac/uploads/origins/c1665e52-8c3c-488e-8ec1-f1d334bbb89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5de014da12370187883638c076432556 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37aa72ac/uploads/origins/c1665e52-8c3c-488e-8ec1-f1d334bbb89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59a6cd094c3faa72bdf97f5b28bf05cf", "srcset": "https://si.imgix.net/37aa72ac/uploads/origins/c1665e52-8c3c-488e-8ec1-f1d334bbb89a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59a6cd094c3faa72bdf97f5b28bf05cf, https://si.imgix.net/37aa72ac/uploads/origins/c1665e52-8c3c-488e-8ec1-f1d334bbb89a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro