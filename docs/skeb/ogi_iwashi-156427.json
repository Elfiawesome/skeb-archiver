️リクエスト\nこのようなキャラクター画の描き方が大好きです：\nhttps://x.com/i/status/1989678535448092687\nhttps://x.com/i/status/1997251046926864686\n\n私のキャラクターも同様のスタイルで描いていただけませんか。\n\n✨️参考画像\nhttps://www.deviantart.com/stash/099kwngwilf\nhttps://www.deviantart.com/stash/01xgeur9z51w\n\nご検討いただきありがとうございます！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@sanzyuunido/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2644033, "client_id": 3867707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37bebc56/uploads/origins/b2ad26b4-b9b1-4bee-b5c7-a86406dc7dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20046067cb41c20a96e8440ad26bb72c", "srcset": "https://si.imgix.net/37bebc56/uploads/origins/b2ad26b4-b9b1-4bee-b5c7-a86406dc7dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20046067cb41c20a96e8440ad26bb72c, https://si.imgix.net/37bebc56/uploads/origins/b2ad26b4-b9b1-4bee-b5c7-a86406dc7dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e4fff04312a1b548cbb9d48b1e4e829 2x, https://si.imgix.net/37bebc56/uploads/origins/b2ad26b4-b9b1-4bee-b5c7-a86406dc7dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d46766195e50abc99941afe43304654 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37bebc56/uploads/origins/b2ad26b4-b9b1-4bee-b5c7-a86406dc7dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c908cdd51c4187a7ba41e372bc4b6029", "srcset": "https://si.imgix.net/37bebc56/uploads/origins/b2ad26b4-b9b1-4bee-b5c7-a86406dc7dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c908cdd51c4187a7ba41e372bc4b6029, https://si.imgix.net/37bebc56/uploads/origins/b2ad26b4-b9b1-4bee-b5c7-a86406dc7dd6?bg=%23fff&auto