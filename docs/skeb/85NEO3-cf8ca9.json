: モデル特にオオカミに関するものに惹かれる。\n\n その他リクエスト\n衣装のスタイル、構図、ポーズはお任せします。  \nできればキャラクターと背景は別レイヤーでお願いします。\n個人利用（個人サイトへの掲載/非商用印刷...など）に限り、IDをクレジットさせていただきます！  \n必要であれば金額を調整させていただきます。よろしくお願いいたします！  \n\nhttps://drive.google.com/drive/folders/1-EquxbGZoDBVTp39kvkgP6ldFKRZRiFW\n\nhttps://drive.google.com/drive/folders/1-EquxbGZoDBVTp39kvkgP6ldFKRZRiFW", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@85NEO3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3388004, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37bdc883/uploads/origins/b0c599aa-4222-4ed7-8a1c-847993e575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4007e967fa026a353918c25e39f94fd4", "srcset": "https://si.imgix.net/37bdc883/uploads/origins/b0c599aa-4222-4ed7-8a1c-847993e575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4007e967fa026a353918c25e39f94fd4, https://si.imgix.net/37bdc883/uploads/origins/b0c599aa-4222-4ed7-8a1c-847993e575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85b01408a3dd98fca1e8b9636093bdcc 2x, https://si.imgix.net/37bdc883/uploads/origins/b0c599aa-4222-4ed7-8a1c-847993e575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=107fdbd8efebc2bc9a424dd4b8fb2172 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37bdc883/uploads/origins/b0c599aa-4222-4ed7-8a1c-847993e575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65e36aab3e7b0dfba78357ebf53d48ed", "srcset": "https://si.imgix.net/37bdc883/uploads/origins/b0c599aa-4222-4ed7-8a1c-847993e575d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65e36aab3e7b0dfba78357ebf53d48ed, https://si.imgix.net/37bdc883/uploads/origins/b0c599aa-4222-4ed7-8a1c-847993e575d4?bg=