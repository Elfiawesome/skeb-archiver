の赤ちゃんのイラストの予約をしたいと思います！内容は以下の通りです：\n\n琴音ちゃんが触手に巻かれ、M字開脚の体勢で抱かれて犯されるのですが、できれば恥ずかしそうな表情や困ったような表情をした琴音ちゃんの正面顔と、絶頂を迎えたときの琴音ちゃんの拙い点数が見たいです。\n\n以下、キャラクターリンク：\nhttps://drive.google.com/drive/folders/1jMELpW9mFVxlaAqXTGRpPETcBSXqZENS", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatori___haruo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3100445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42625351/uploads/outputs/7eabb763-8c35-4679-abc8-7334181ca240?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fbe3776bc236ad363cb34226ee5ff165", "srcset": "https://si.imgix.net/42625351/uploads/outputs/7eabb763-8c35-4679-abc8-7334181ca240?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fbe3776bc236ad363cb34226ee5ff165, https://si.imgix.net/42625351/uploads/outputs/7eabb763-8c35-4679-abc8-7334181ca240?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4d275446036bf90de5017af0623df64 2x, https://si.imgix.net/42625351/uploads/outputs/7eabb763-8c35-4679-abc8-7334181ca240?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=1df83c3d7249f52afb2eff97ff1e3ea4 3x"}, "duration": 1, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42625351/uploads/outputs/7eabb763-8c35-4679-abc8-7334181ca240?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=47e62b93115fbe3151735a8297928f92", "srcset": "https://si.imgix.net/42625351/uploads/outputs/7eabb763-8c35-4679-abc8-7334181ca240?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=47e62b93115fbe3151735a8297928f92, https://si.imgix.net/42625351/uploads/outputs/7eabb763-8c35-4679-abc8-7334181ca240?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9530b82b8bbcb309b5f119a9b628614c 2x, https://si.imgix.net/42625351/uploads/output