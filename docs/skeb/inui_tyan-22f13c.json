2a0-c68b276b1168?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8182f7c3de8dadf760647b9f9c0837d6 3x"}, "body": "はじめまして。\n乾さんの描かれるイラストをイラスト一覧にて拝見しまして、ぜひ友人とのオリジナルキャラクターである二人を描いていただきたいと思い、ご依頼させていただきました。\n\nTRPG用に作成したキャラクターです。\n男性：仏頂面の硬派な刑事。正義感が強く頑固。自分に好意を伝えてくる女性のことを物好きだと思っている。女性自身のことは好ましく感じているが、立場故に応えられないと断っている。モチーフは狼など\n女性：にこにことした元刑事のアウトロー。刑事である男性の芯の強さに惹かれ、一方的な片想いをしている。自分の立ち位置に後ろめたさがあるが、それ以上に男性へ好意を伝えたい気持ちが強い。モチーフは桜など\n\n\n構図など、可能であればお任せさせて頂きたいです。\nキャラクターの外見等の画像資料はgoogleドライブにまとめております。\n乾さんの解釈で自由に描いていただけると幸いです。どうぞよろしくお願いいたします。\n\nご検討いただける場合で、金額等不備がありましたら再送申請をしていただけますと幸いです。\nここまでお目通し頂き、ありがとうございました。何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1jNblQutfaFAuJGM1KiX_HzXTLXk2kG4J?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inui_tyan/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3808330, "client_id": 3266939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaae11ee74b962da2593086ae3b01fea", "srcset": "https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aaae11ee74b962da2593086ae3b01fea, https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db6ac55bc34b613e9bc40952fe351ed6 2x, https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6f35cb7caf22e4ee3d574d7538bbbb5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62c98e9b66bc47fdcb6ac4b4086d509d", "srcset": "https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62c98e9b66bc47fdcb6ac4b4086d509d, https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a34a2ac4b9377721f5ebb983e36caab 2x, https://si.imgix.net/22bc0a2e/uploads/origins/9403aad0-0413-45c4-97fb-13fce5e141a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f568667961681d7897b656fc3eaf5b8 3x"}, "body": "乾さん、こんにちは！あなたの素晴らしい作品にすっかり魅了されてしまいました……そこで、私のオリジナルキャラクター「アリス」を描いていただけないでしょうか！\n\nアリス(Alice)/149cm\n\nアリスは、揚げ物やアイスクリームが好きな、甘えん坊でいたずら好きな女の子です。物忘れが激しく、真面目なことになると、ついのんびりとした性格が出てしまいます。彼女のモチーフは、花、天使の羽、そしてチェリーです！ （でも、頭の上の植物はサクランボではありません！）\n\nキャラクターの重要なポイント：\n- アリスの頭の上には、サクランボのような植物が2つあります！これらはサクランボではないので、参考画像通りに描いてください！\n\n- 彼女は猫のような顔立ちをしています！牙と丸い眉毛があります！可能であれば、これらも描いてください！\n\n構図としては両目を開けた姿が理想ですが、お任せします…！どんな作品でも大歓迎です！ご協力ありがとうございます！\n\nアリス https://drive.google.com/drive/folders/1pIztLZjK2mUDKXsJOA9V9m2oj0GKKkp1", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inui_tyan/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3808330, "client_id": 2986492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9d11f2e/uploads/origins/3d5fa400-4f3e-49d3-9994-e9f5c5144fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9896a6c20e8668a7bbd14ff91ce58f8e", "srcset": "https://si.imgix.net/f9d11f2e/uploads/origins/3d5fa400-4f3e-49d3-9994-e9f5c5144fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9896a6c20e8668a7bbd14ff91ce58f8e, https://s