チキとかありますがぶっちゃけ違いがわかりません。包装紙変えたら間違える自信があります。\nギャリック砲とかめはめ波に色以外の違いがあるのかわからないのと同じです。魔貫光殺砲は辛うじてわかります。\n\nそこで各コンビニの利点を比較してどのコンビニがおすすめかアドバイスをいただきたく思います。できればナナチキ、ファミチキ、Lチキの違いについても教えていただけたらと思います。\n\nよろしくお願いします。", "nc": 145, "word_count": 2141, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@VR_humihami/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 277882, "client_id": 80610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e8d560b75f54ea8ef67b6b53eca521", "srcset": "https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e8d560b75f54ea8ef67b6b53eca521, https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da483f144b18c0e8d01263336030fa3e 2x, https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5060a517bcfd820cfd9735489652a31e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=571c7040fb10981415571b46e16470f5", "srcset": "https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=571c7040fb10981415571b46e16470f5, https://si.imgix.net/7090c9fe/uploads/origins/a4f60dd9-b85a-4e36-9300-fd2cfad37a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8098b92d63f9206b845