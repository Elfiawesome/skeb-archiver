rry came up with an idea: they bought a large capacitor from the electronics store and connected it to the utility power. When Caramel Fox switched on the power, the capacitor overloaded and exploded from the top, colorful papers shooting out just like fireworks. Snowberry stands aside, covering her ears.\n\nhttps://drive.google.com/drive/folders/17dSNxPu1LK1A6LkuuE8J3sUCLMwMuNKx?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@catfox22/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1966092, "client_id": 272744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08f17eec/uploads/origins/89eb3caa-3e0c-4fe7-b3fb-7ac8b845ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93c63786db8657a8d41c0170ee7a1762", "srcset": "https://si.imgix.net/08f17eec/uploads/origins/89eb3caa-3e0c-4fe7-b3fb-7ac8b845ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=93c63786db8657a8d41c0170ee7a1762, https://si.imgix.net/08f17eec/uploads/origins/89eb3caa-3e0c-4fe7-b3fb-7ac8b845ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6e159abe014af39f4e0117004dbdb4d 2x, https://si.imgix.net/08f17eec/uploads/origins/89eb3caa-3e0c-4fe7-b3fb-7ac8b845ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbf8634a75b46d50e76b25631e98fd4f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08f17eec/uploads/origins/89eb3caa-3e0c-4fe7-b3fb-7ac8b845ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3938678b42158e089a27972babb3dd9f", "srcset": "https://si.imgix.net/08f17eec/uploads/origins/89eb3caa-3e0c-4fe7-b3fb-7ac8b845ed14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3938678b42158e089a27972babb3dd9f, ht