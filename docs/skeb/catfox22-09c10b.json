fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebce5450785df98af76359c056e7d26b 2x, https://si.imgix.net/27709b74/uploads/origins/38f2bee9-14d8-4463-a722-1782850371c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36e555c8fbda6f559b30e0d65f12d656 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27709b74/uploads/origins/38f2bee9-14d8-4463-a722-1782850371c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0f6962076e987e562063e584fb1a232", "srcset": "https://si.imgix.net/27709b74/uploads/origins/38f2bee9-14d8-4463-a722-1782850371c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0f6962076e987e562063e584fb1a232, https://si.imgix.net/27709b74/uploads/origins/38f2bee9-14d8-4463-a722-1782850371c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f75c36598b1d838fafff67bb8d56c917 2x, https://si.imgix.net/27709b74/uploads/origins/38f2bee9-14d8-4463-a722-1782850371c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d3dab91003e2a3ab58bb1325fdf3d1a 3x"}, "body": "私のツイッターアイコン(https://pbs.twimg.com/profile_images/1073575089671593985/QWzE7sh_.jpg)のキャラが、一口サイズくらいにされて、猫さんに丸呑みにされてしまい、生きたままお尻から出されてしまう作品をお願いします\n丸呑みは、翼を咥えられて持ち上げられている様子\n口に入れてしまいもぐもぐな様子\n飲み込まれてしまう様子\nお腹に入れられてしまった様子をお腹の中の様子を吹き出しで…といった形でお願いしたいと思います\nお尻から出すところは猫さんが踏ん張って排泄している様子\n排泄を終えてすっきりな猫さんと排泄されてぐったりなルークという感じでお願いしたいです\nお尻から出されるまでにたっぷり時間を掛けたような描写があると嬉しいです(数日後…と書く等)\n全体的に猫さんにルークを軽くバカにするようなセリフがあると嬉しいです\nまた、セリフありなし差分をお願いしたいです\n\nツイートによる紹介を許可頂きたく思います\nよろしくお願いします", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@catfox22/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1966092, "client_id": 3120220, "vtt_url": null, "thumbnail_image_urls":