くお願いします。\n\nオリキャラの資料は以下の通りで、穏やかな性格の鹿の子です。\n詳細やセリフなどは自由にして頂いて構いません。\n\nhttps://drive.google.com/drive/folders/103Ye7YvStPorrF68T2fh--t9n5ZL5D-3", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@catfox22/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1966092, "client_id": 808925, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ef550c5/uploads/origins/b8c85804-a313-44de-a5a2-dd956db86309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd1dcd0c39db60def9d5fbc9bf86cf2", "srcset": "https://si.imgix.net/3ef550c5/uploads/origins/b8c85804-a313-44de-a5a2-dd956db86309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cd1dcd0c39db60def9d5fbc9bf86cf2, https://si.imgix.net/3ef550c5/uploads/origins/b8c85804-a313-44de-a5a2-dd956db86309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9b7f6590d147f87f05a7abe4c6eacf7 2x, https://si.imgix.net/3ef550c5/uploads/origins/b8c85804-a313-44de-a5a2-dd956db86309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bef203c50c81510106631ecfd6f2e2b5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ef550c5/uploads/origins/b8c85804-a313-44de-a5a2-dd956db86309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48a755e1e4d6683126a2e7f5e167d6c0", "srcset": "https://si.imgix.net/3ef550c5/uploads/origins/b8c85804-a313-44de-a5a2-dd956db86309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48a755e1e4d6683126a2e7f5e167d6c0, https://si.imgix.net/3ef550c5/uploads/origins/b8c85804-a313-44de-a5a2-dd956db86309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1473b011d7cca16ad936bf93d286208 2x, https://si.imgix.net/3ef550c5/uploads/origins/b