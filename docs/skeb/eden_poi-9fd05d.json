/uploads/origins/bedf8f95-452f-42fc-8149-65b6b0382d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d15e4667afe241c0b1f4e9f0d3643b82 2x, https://si.imgix.net/00f37a60/uploads/origins/bedf8f95-452f-42fc-8149-65b6b0382d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8065e878a5f68de997b14e3d00e49d50 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 6250, "client_id": 1908898, "nc": 0}, {"path": "/@eden_poi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5ef115e1fe4b293484cfb34866c0283", "srcset": "https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5ef115e1fe4b293484cfb34866c0283, https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a64869b32a18598f681759e779292b5 2x, https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2539311259dd60d62a8569fa5b2ad0c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b32e723a91f4985305280ffd266b0e5", "srcset": "https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b32e723a91f4985305280ffd266b0e5, https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5702b98fff6d7d9d5bcf701d8a269b4e 2x, https://si.imgix.net/d95ee661/uploads/origins/c6cd684f-b88d-4002-9470-eecf658941cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa039c687ebde09b612c11e9a6ef31cd 3x"}, "body": "はじめまして。私、個人Vtuberとして活動をしております「ざっくぅ。」と申します。\n長野アキラ様 の素敵なイラストを拝見しまして、\n是非お願いしたいと思いリクエストさせていただきました。\n\n差し支えなければ、私と友人のイラストを描いていただけますでしょうか。\n\n【Twitter】\nhttps://twitter.com/zaqrodayo\nhttps://twitter.com/Dai_Pukuu\n\n【資料】\nざっくぅ。（イメージカラー紫）\nhttps://drive.google.com/file/d/1r2eNQG0WDKLum2A25c_n52OxW9OqHIvw/view?usp=sharing\n\n友人　（イメージカラー緑）\nhttps://drive.google.com/file/d/1W1xuIgjqLgTzcWZ5Dr-Bii0AGdQ9LkT2/view?usp=sharing\n\n二人で仲よくゲームをしている姿を描いていただきたいです…！\n\n使用用途は、よくふたりで飲酒しながらゲーム配信をやっております。\nその際のサムネイルに使用したいと思っておりますので、サイズは16:9の横長にしていただけると嬉しいです。\n\nそれともし可能でしたらPSDデータで、一人ずつ別々に、背景なども透過で使用できるようにしていただけますと助かります。\nお忙しいとは思いますが何卒、ご検討いただけたら幸いです。\n\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eden_poi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6250, "client_id": 1127271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b5cae252e014ca46cab6acdf3fe054", "srcset": "https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b5cae252e014ca46cab6acdf3fe054, https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8546edeced5db70712f8c7687f1251d9 2x, https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c8b1dbfa8cf6da3ed4c1aeb0ff4b9f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0f4ad2f919dbce2ffec893b4d62fcb0", "srcset": "https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0f4ad2f919dbce2ffec893b4d62fcb0, https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffd60f32d3853f77c0c550f41f9c954d 2x, https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19f18236593fa1a37cb5caf074404c04 3x"}, "body": "Hello! Your art is so pretty and I would like for you to draw my VTuber! It would be great if the image was in 16:9 ratio (horizontal), it will be used on Youtube! I would like my VTuber folding her hands in front of her chest with a kind smile. I would like stained glass in the background with light rain. Thank you for considering! \nVTuber Reference: https://imgur.com/a/QdBzHOt\nPose Reference: https://imgur.com/a/Ny5X9SO", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eden_poi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 6250, "client_id": 3017308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.