bp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7e9d6d878fd589a31bd8a26fbe82a12 2x, https://si.imgix.net/a6891219/uploads/origins/b5d78ed7-fceb-40ab-89b2-2e181787ae4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=810a17a33bb6d1db588eab815fb3604b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6891219/uploads/origins/b5d78ed7-fceb-40ab-89b2-2e181787ae4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbaef4749472964741a9f4addf9b9ceb", "srcset": "https://si.imgix.net/a6891219/uploads/origins/b5d78ed7-fceb-40ab-89b2-2e181787ae4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbaef4749472964741a9f4addf9b9ceb, https://si.imgix.net/a6891219/uploads/origins/b5d78ed7-fceb-40ab-89b2-2e181787ae4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f76c9fb2d4585f482d1a07ccbfb3882 2x, https://si.imgix.net/a6891219/uploads/origins/b5d78ed7-fceb-40ab-89b2-2e181787ae4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a853c3bfe442e8a7f2548dbb67fa1271 3x"}, "body": "こんにちは、グループカバーソングのアートワークを依頼したいです！私のVTuberデザインと、他の二人のVTuber友達のデザインを、KPop Demon Huntersの参照ポーズで描いてください。 ウグーベアは中央に配置しルミの衣装を、ユチは左側に配置しゾーイの衣装を、スカーレットは右側に配置しミラの衣装を着せてください。髪型は映画キャラクターに合わせて変更せず、元のVTuberデザインのままでお願いします。 完成した画像アートの縦横比は16:9、または最低でも1920x1080ピクセルであることが重要です。ご配慮いただき誠にありがとうございます！https://drive.google.com/drive/folders/1oBc2HrXMNVA6_tYPkF99_Al5t-6R_-xw\n\nhttps://drive.google.com/drive/folders/1oBc2HrXMNVA6_tYPkF99_Al5t-6R_-xw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eden_poi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6250, "client_id": 1127271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98cda32a/uploads/origins/a1e7ee80-95