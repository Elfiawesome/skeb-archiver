u7528\u7528\u9014\u306f\u3001\u3088\u304f\u3075\u305f\u308a\u3067\u98f2\u9152\u3057\u306a\u304c\u3089\u30b2\u30fc\u30e0\u914d\u4fe1\u3092\u3084\u3063\u3066\u304a\u308a\u307e\u3059\u3002\n\u305d\u306e\u969b\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u306b\u4f7f\u7528\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u304a\u308a\u307e\u3059\u306e\u3067\u3001\u30b5\u30a4\u30ba\u306f16:9\u306e\u6a2a\u9577\u306b\u3057\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u305d\u308c\u3068\u3082\u3057\u53ef\u80fd\u3067\u3057\u305f\u3089PSD\u30c7\u30fc\u30bf\u3067\u3001\u4e00\u4eba\u305a\u3064\u5225\u3005\u306b\u3001\u80cc\u666f\u306a\u3069\u3082\u900f\u904e\u3067\u4f7f\u7528\u3067\u304d\u308b\u3088\u3046\u306b\u3057\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u52a9\u304b\u308a\u307e\u3059\u3002\n\u304a\u5fd9\u3057\u3044\u3068\u306f\u601d\u3044\u307e\u3059\u304c\u4f55\u5352\u3001\u3054\u691c\u8a0e\u3044\u305f\u3060\u3051\u305f\u3089\u5e78\u3044\u3067\u3059\u3002\n\n\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eden_poi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6250, "client_id": 1127271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b5cae252e014ca46cab6acdf3fe054", "srcset": "https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21b5cae252e014ca46cab6acdf3fe054, https://si.imgix.net/d76c456f/uploads/origins/9e265de9-0f98-4279-8a50-b9f135125108?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8546edeced5db70712f8c7687f1251d9 2x, https://si.imgix.net/d76c456f/upload