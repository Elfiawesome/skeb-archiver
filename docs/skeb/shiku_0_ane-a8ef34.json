2箱お疲れ様でした！めちゃすごいです👏💭\nイラスト楽しみにしてます🎄ﾓｲｯ!\nよろしくお願い致します(* .ˬ.)\n\nhttps://lit.link/jura11", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiku_0_ane/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2891356, "client_id": 2328190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2157953dbef903c23aebf8661c76669", "srcset": "https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2157953dbef903c23aebf8661c76669, https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=546b10af313b0fe4196579b47d81fec5 2x, https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db73c91345b166eff838ba9f8f732b17 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9eba53e8302da5eb100878130305f7f", "srcset": "https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9eba53e8302da5eb100878130305f7f, https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6b497dba95f6278f5f4be8431706efe 2x, https://si.imgix.net/20cea138/uploads/origins/0d37abab-8f9c-4e54-a646-526101a7252b?bg=%23fff&auto=f