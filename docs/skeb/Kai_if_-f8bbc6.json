ss&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06aa486725541c5aa978146a3ca8dec5 3x"}, "body": "こんにちは！私と友達が隣り合って座り、話しながら笑っている様子のコミッションを依頼したいです。服装や具体的なポーズはご自由に決めてください。よろしくお願いします！\n\n参考画像：https://drive.google.com/drive/folders/1NPyffh9SeLKj3Ir4m8d-ZkYWJpCM7sPC?usp=drive_link https://drive.google.com/drive/folders/1NPyffh9SeLKj3Ir4m8d-ZkYWJpCM7sPC?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kai_if_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3548302, "client_id": 776168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a7eeab5c25cce4cf32a286384390d74", "srcset": "https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a7eeab5c25cce4cf32a286384390d74, https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c1831909a94991ef89cc97938921949 2x, https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63dc4c63894ea3022485803ca87f8901 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a150997c2fb91523b5ef91ecdedfc4a5", "srcset": "https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a150997c2fb91523b5ef91ecdedfc4a5, https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d50c0afca462617d8472cb824abcd5e3 2x, https://si.imgix.net/52de5dcc/uploads/origins/c6be7000-691d-4add-aecb-4b0d6d8fd9e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=177dae3e65c82d63ab95b52f980922a6 3x"}, "body": "夏魁さんこんにちは！Replikagamiと申します！\nうちの子、Kagami(カガミ)の\n新たなサムネ用イラストを依頼したいです！\nカガミ(狐、細長い中性系♂)：\nhttps://drive.google.com/file/d/14qAg3bGiMYczPihTGx2TlZCiK1IQlaKq/view?usp=drive_link`\n\n＊水色の毛と頭の模様はちょっと発光します。普段は水色けど、心境・気分による色も変わります！\nhttps://drive.google.com/file/d/19g2-egZrA6CmmONZMVRLKNJPekJ36Sj4/view?usp=drive_link\n(水色＝平常心、緑＝超嬉し、黄色＝狡猾・複雑、赤＝怒り、ピンク＝えちち)\n\n希望内容：\nーわたしのチャンネルにありましたの「同人誌カタログ記録配信」という手持ちの本をデータ入力記録するの配信に使用するのカガミイラストを依頼したいです！\nーちょっと図書館管理人みたいな感じで、本の山持っているのカガミ。\n\nー背景は　蠟燭使ってるちょっと暗めな古風書斎、ファンタジー系の魔法図書館、それでも現代・近未来風明るい図書館な感じその中の１つでどちらでもOK。細かいな背景しなくでもOkです、その感じの雰囲気が出るの簡単化・シンプルなデザインで十分です！\nーライティングも本のデザイン（シンプルな感じでOK）も背景に合わせ出来るなら助かります！\n\nー選んだの時代・背景に応じて、メガネ、アクセサリー、服のデザインは夏魁さんにお任せしたいです！！\nー健全だけと、表情の方はちょいニヤリやお色気な感じがあるなら嬉しいです！薄いの本を整理するなので！\n\nー配信用サムネの素材として使用したいので、構図的に、キャンバス内に収めて、部位を切り抜けないのように欲しいです！(例：腕、手、耳、髪の毛、尻尾なと)\n\n用途:\nー配信用サムネとエンドカード素材として使用したいです！(絵師名標柱します)\nもしできれば、PSD系のレイヤー化ファイルが欲しいです！\n特にキャラクターと背景を別レイヤにして欲しいです！\n\nよろしくお願いします!\n\nhttps://drive.google.com/drive/folders/1X9EWFH-bshLH9kYgwxtCKQBFeSuXhPVW?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kai_if_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3548302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10ad9ae0/uploads/origins/91bf5924-93d3-4fa1-8a5b-dd8ee6a78abd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63be6d2c78cf23a5dfd89985bf87e5d1", "srcset": "https://si.imgix.net/10ad9ae0/uploads/origins/91bf5924-93d3-4fa1-8a5b-dd8ee6a78abd?bg=%