ploads/origins/af0f10a7-593e-4c2c-8f9f-d9094d7f8c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b084e48af47c19e1d181b4d8b2d38dcb, https://si.imgix.net/f7e97019/uploads/origins/af0f10a7-593e-4c2c-8f9f-d9094d7f8c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6628bdf531aeb41e90dd304a108fcb9 2x, https://si.imgix.net/f7e97019/uploads/origins/af0f10a7-593e-4c2c-8f9f-d9094d7f8c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6f5c9fa85a11bf222bec65c5c883981 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7e97019/uploads/origins/af0f10a7-593e-4c2c-8f9f-d9094d7f8c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=099145d817171dd75ef73a5300d57b2c", "srcset": "https://si.imgix.net/f7e97019/uploads/origins/af0f10a7-593e-4c2c-8f9f-d9094d7f8c10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=099145d817171dd75ef73a5300d57b2c, https://si.imgix.net/f7e97019/uploads/origins/af0f10a7-593e-4c2c-8f9f-d9094d7f8c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17a5655f9e8387233964967cb122369e 2x, https://si.imgix.net/f7e97019/uploads/origins/af0f10a7-593e-4c2c-8f9f-d9094d7f8c10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=932622c279221a2c0a557a4edc2e9340 3x"}, "body": "いつもお世話になっております。シジミさんの描くキャラやキャラの表情、動きのある絵が大好きです。なので今回依頼させていただきたくご連絡いたします。\n\n◆依頼内容\nしじみさんの描く笑顔が好きなので弥田くんで見たい！どんな構図でもいいので笑顔でマスクを下げている絵が見たいです！！雰囲気スモーキーな感じだとなお嬉しいです…！！\n\n● 弥田　侑士（ヤタ　ユウジ） \n10/16生　37歳　163cm 黒髪赤目 天秤座　o型 バイク、寝ることが好き  元警視庁交通機動隊/現フリーター（コンビニ店員）\n\nキャラクターシート\nhttps://iachara.com/view/5101907\n\nhttps://www.dropbox.com/scl/fo/6tni5mcywewb0s52iwpri/h?rlkey=a50jpv8fh5661bc5zkl98d1ys&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HELL_BANGx2/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 427836, "client_id": 2764967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d0be2e847fb8be4a77944c62826d1a", "srcset": "https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19d0be2e847fb8be4a77944c62826d1a, https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5c360d9e7eff0ca3c0cd212a2760a98 2x, https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90c24358dfc07e416534df48df48fb4a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b79e8bd3451734e47cdc50fd72c5bd5e", "srcset": "https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b79e8bd3451734e47cdc50fd72c5bd5e, https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1784f989ed92c8573268e45042ec6073 2x, https://si.imgix.net/18a666a9/uploads/origins/1507b0e3-21b1-44cc-b749-71da97bfbc4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2aa57c726bc21b819df8c1b7ee437f0e 3x"}, "body": "初めまして。オボロゲ寧と申します。サランヘヨ鬼桐さんの絵柄が大好きで今回ご依頼させていただいております。\nサランヘヨ鬼桐さんの描く線画や表情、また関節とくびれがめちゃくちゃ好きなので、リクエスト受理していただけると嬉しいです。\n\n【内容】\n自PCのサーカス探索者を描いていただきたいです。欲を言えば二人描いていただきたいですが、難しければナジュム（ぱっつんの方）を描いていただきたいです！！\nキャラクターシートの見えるところにネタバレ記載はありません。通過したシナリオ名の伏せているところに記載あるのでお気をつけください。\n\n◆ナジュム（https://iachara.com/view/4725456）\nイメージ：お花、星\n「レディースアンドジェントルメン！」\n「ボクはみんなのこと大好きだよ」\n\n団長でみんなのことが大好き。\n性格は嫉妬しいだけど隠してる。\n\n性自認が女の子。みんなに嫌われたくないので誰にも言ってない。ただ、たまにいってないことに対しても罪悪感を感じる。\n無意識的に女性とのスキンシップが多くなり、男性とのスキンシップを避けてる。\nリボンとかレースが好き。かわいいものも好き。見つけたらじっとみちゃうかも。\nこの事実は墓まで持っていくつもりである。\n自分の大きな体とまつ毛の短い顔があまり好きじゃない。\nなので、舞台ではナイフ投げを行う時以外極力姿を見せずにあの姿でいる。\n\n声がしゃがれているのは、声が低くなる過程で無理やり高い声のまま話していたからである。\n\n◆クルスーム（https://iachara.com/view/5779057）\nイメージ：象、大人な子供\n「オレのゆうこと聞いて〜」\n「楽しくやればいいんじゃない？」\n\nヘラヘラしてるけどサーカスのこととなると真面目にやる。\n負けず嫌い。\n\n大人っぽく振る舞おうとしてる中身が子供ひと。\nみんなのこと大事に思っているが、それよりも自分の感情を優先してしまい、周りのことが考えられなくなる悪い子。\n将来黄金の象さんを飼いたい。\n\n◆見た目（ドロップボックス）\nhttps://www.dropbox.com/scl/fo/z9681xb47smdak5z79r6j/h?rlkey=q2g6fls64mab7qom7rvy0cnsy&dl=0\n\n◆構図等も全てお任せいたします！！サランヘヨ鬼桐さん色が強いと嬉しいです！！\nまた、描きやすいように衣装等も変えていただいても構いません。よろしくお願いいたします。\n\n【使用用途】\n・PCやスマホの背景\n・友人への自慢\n・ポスターなど", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 69850, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "鼠畜生(そちくしょう)", "screen_name": "Hagfish21", "avatar_url": "https://pbs.twimg.com/profile_images/1614588944922050561/U8rjlCF_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4445243543/1665336321/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 177}, {"id": 79606, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しこしこぷりぷり虫🔞", "screen_name": "skskprprms", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2Fwebpublic-243765bd-7d