\u308f\u3063\u3068\u53ef\u611b\u3044\u30a4\u30e9\u30b9\u30c8\u304c\u3068\u3066\u3082\u53ef\u611b\u304f\u3066\u305c\u3072\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u601d\u3044\u9001\u3089\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\u25cf\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\n\u30fb\u5185\u5bb9 : \u4e00\u679a\u7d75\u3084\u5168\u8eab\u7acb\u3061\u7d75\u306a\u3069\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc : \u7720\u97f3\u3080\u306b\n\u30fb\u30a4\u30e9\u30b9\u30c8 : \u69cb\u56f3\u3001\u670d\u88c5\u3001\u9aea\u578b\u306a\u3069\u8475\u6f84\u3057\u304d\u69d8\u306e\u7d20\u6575\u3059\u304e\u308b\u30bb\u30f3\u30b9\u306b\u304a\u4efb\u305b\u3067\u304d\u305f\u3089\u5b09\u3057\u3044\u3067\u3059\u3002\n\u8863\u88c5\u4ee5\u5916\u306e\u666e\u6bb5\u898b\u3089\u308c\u306a\u3044\u59ff\u3082\u5927\u6b53\u8fce\u3067\u3059\u306e\u3067\u3001\u5168\u3066\u304a\u597d\u307f\u3067\u5236\u4f5c\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u25cf\u4f7f\u7528\u7528\u9014\n\u30fbVTuber\u6d3b\u52d5\u5168\u822c(\u914d\u4fe1\u30fb\u52d5\u753b\u30fb\u30b5\u30e0\u30cd\u30a4\u30eb)\n\u30fb\u53ce\u76ca\u5316\u6e08\u307f\u306e\u914d\u4fe1\u30b5\u30a4\u30c8\u3001\u5404\u7a2eSNS\u3067\u306e\u4f7f\u7528\n\u30fbFANBOX\u3084\u30e1\u30f3\u30d0\u30fc\u30b7\u30c3\u30d7\u306a\u3069\u3067\u7279\u5178\u3001\u58c1\u7d19\u3068\u3057\u3066\u914d\u5e03\u3001\u30cd\u30c3\u30c8\u30d7\u30ea\u30f3\u30c8\u7b49\u3067\u306e\u914d\u5e03\n\u30fb\u30b0\u30c3\u30ba\u8ca9\u58f2\u306a\u3069\u306e\u5546\u7528\u5229\u7528\n\n\u25cf\u304a\u9858\u3044\u3057\u305f\u3044\u3053\u3068\n\u30fb\u30b5\u30a4\u30ba : \u30a2\u30c3\u30d7\u3067\u4f7f\u7528\u3059\u308b\u3053\u3068\u3082\u591a\u3044\u305f\u3081\u5927\u304d\u76ee\n\u30fb\u7d0d\u54c1\u5f62\u5f0f : PSD\u5f62\u5f0f(\u80cc\u666f\u3001\u4eba\u7269\u3001\u30b5\u30a4\u30f3\u306a\u3069\u306e\u30ec\u30a4\u30e4\u30fc\u5206\u3051)\n\u30fb\u305d\u306e\u4ed6 : \u30b5\u30e0\u30cd\u30a4\u30eb\u3067\u3082\u4f7f