66\u5b88\u3063\u3066\u3044\u308b\u304c\u3001\u81ea\u5206\u306e\u3053\u3068\u306f\u4f55\u3082\u6b8b\u3055\u306a\u3044\u3002\u5b50\u4f9b\u306e\u9803\u306b\u306f\u7d14\u7c8b\u3060\u3063\u305f\u3002\u3067\u3082\u3001\u6771\u4eac\u3067\u306e\u4f1a\u793e\u54e1\u751f\u6d3b\u304b\u3089\u623b\u3063\u305f\u3001\u7a7a\u865a\u3067\u75b2\u308c\u5207\u3063\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u308b\u3002\u80cc\u304c\u9ad8\u304f\u3001\u8272\u767d\u3067\u3001\u30a4\u30b1\u3066\u308b\u3002\u3061\u3087\u3063\u3068\u3060\u3051\u306e\u53ef\u611b\u3044\u6065\u305a\u304b\u3057\u304c\u308a\u5c4b\u3055\u3093\u3067\u3059\u3002\u51ac\u525e\u3088\u308a\u3082\u80cc\u304c\u9ad8\u304f\u3001\u7b4b\u8089\u8cea\u3060\u3002(\u88ab\u5bb3\u8005)\n--------------------\n\u6de1\u5bae\u51ac\u525e \u201c\u3042\u308f\u307f\u3084 \u3075\u3086\u304d\u201d\n25\u6b73\uff08\u7d2b\u9aea\uff09\n176cm / 57kg\n\u751f\u5e74\u6708\u65e5: 1974\u5e74 02\u6708 09\u65e5\n\n\u9ad8\u6821\u751f\u306e\u3068\u304d\u3001\u5f7c\u306e \"\u5927\u4e8b\u306a\u3086\u305a \"\u306b\u604b\u3092\u3057\u305f\u3002\u5bb6\u696d\u306f\u53e4\u3044\u846c\u5100\u4f1a\u9928\u3067\u3059\u3002\u8b72\u304c\u6559\u3048\u3066\u304f\u308c\u305f\u6e29\u304b\u3055\u306b\u5831\u3044\u308b\u305f\u3081\u306a\u3089\u3001\u4f55\u3067\u3082\u3059\u308b\u3002\u8b72\u306b\u3088\u304f\u7518\u3084\u304b\u3055\u308c\u3066\u3001\u732b\u3063\u307d\u3044\u4eba\u3002\u5f7c\u306e\u79d8\u5bc6\u306f\u5e7d\u970a\u304c\u898b\u3048\u308b\u3053\u3068\u3067\u3059\u3002\u8b72\u3092\u56f0\u3089\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u552f\u4e00\u306e\u4eba\u7269\u3002\u7dba\u9e97\u3067\u3001\u602a\u3057\u3052\u3067\u3001\u30a4\u30e4\u30ea\u30f3\u30b0\u3092\u3057\u3066\u3044\u308b\u3002(\u30a2\u30bf\u30c3\u30af)\n--------------------\n\u540c\u3058\u7530\u820e\u753a\u3067\u80b2\u3063\u305f\u5e7c\u306a\u3058\u307f\u3060\u3002\u5352\u696d\u5f8c\u3001\u758e\u9060\u306b\u306a\u3063\u305f\u4e8c\u4eba\u306e\u89aa\u53cb\u3002\u4e92\u3044\u3092\u6df1\u304f\u601d\u3044