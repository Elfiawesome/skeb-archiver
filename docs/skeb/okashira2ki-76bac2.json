=crop&crop=top&w=200&h=200&s=2e1797b1d32a33ebed31b7b6603f254d, https://si.imgix.net/0823ee2b/uploads/origins/5ff86a35-b262-4adb-8521-89809ecc7d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9bf5a33d7fe8e5dcc405b4867785f62 2x, https://si.imgix.net/0823ee2b/uploads/origins/5ff86a35-b262-4adb-8521-89809ecc7d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86a90c77fb3d3f123b05600d60948097 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0823ee2b/uploads/origins/5ff86a35-b262-4adb-8521-89809ecc7d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=964a4810bd491366ba43b69734ebec1e", "srcset": "https://si.imgix.net/0823ee2b/uploads/origins/5ff86a35-b262-4adb-8521-89809ecc7d02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=964a4810bd491366ba43b69734ebec1e, https://si.imgix.net/0823ee2b/uploads/origins/5ff86a35-b262-4adb-8521-89809ecc7d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ce6f6ae79c6ee932e2e17c392267aa 2x, https://si.imgix.net/0823ee2b/uploads/origins/5ff86a35-b262-4adb-8521-89809ecc7d02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d451481f2eba7afc96932bf0ce7df250 3x"}, "body": "\u3053\u3093\u306b\u3061\u306f \u5148\u751f\u3002\n\u524d\u306e\u4f5c\u54c1\u304c\u672c\u5f53\u306b\u7d20\u6674\u3089\u3057\u304f\u3066\nskeb\u3092\u958b\u3044\u3066\u304f\u3060\u3055\u3063\u305f\u3053\u3068\u3092\u78ba\u8a8d\u3057\n\u307e\u305f\u9023\u7d61\u3092\u5dee\u3057\u4e0a\u3052\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\n\n\u4eca\u56de\u306b\u306f\u3001\u4ed6\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc2\u4eba\u306e\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u3088\u308d\u3057\u3051\u308c\u3070\u3001\u6b21\u306f\u30ea\u30af\u30a8\u30b9\u30c8\u306e\u8a73\u7d30\u3067\u3059\u3002\n\n1. \u4eba\u7269\n\u30c9\u30fc\u30eb\u30ba\u30d5\u30ed\u30f3\u30c8\u30e9\u30a4\u30f3\u306eMk48\u3068\u30a2\u30eb\u30b1\u30df\u30b9\u30c8\u3067\u3059\u3002\n\n\u4eca\u56de\u306e\u30ea\u30af\u30a8\u30b9\u30c8\u3067\u306f\n\u6e29\u6cc9\u3092\u80cc\u666f\u3068\u3057\u3066\n\u3042\u306e\u4e8c\u4eba\u306e\u6d74\u8863\u59ff\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n(\u5929\u6c17\u304c\u307e\u3059\u307e\u3059\u5bd2\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u306d\u3002)\n\n\u4eba\u7269\u3068\u670d\u88c5\u306f\u4e0b\u8a18\u306e\u30ea\u30f3\u30af\u3092\u3054\u53c2\u7167\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u25cb Mk48\n(https://iopwiki.com/wiki/Mk48)\n- \u672c\u6765\u306e\u9aea\u3092\u7d50\u3093\u3067\u3044\u307e\u3059\u304c\u3001\u4eca\u56de\u306f\u307b\u3069\u3044\u3066\u3044\u308b\u72b6\u614b\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n- \u8eab\u9577\u306f175cm\u304f\u3089\u3044\u306e\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u25cb \u30a2\u30eb\u30b1\u30df\u30b9\u30c8\n(https://iopwiki.com/wiki/Alchemist/Assimilated#/media/File:Alchemist.png)\n- \u304a\u98a8\u5442\u7528\u5177\u304c\u5165\u3063\u305f\u5c0f\u3055\u306a\u30d0\u30b9\u30b1\u30c3\u30c8\u3092\u5de6\u8155\u306e\u4e0a\u306b\u6301\u3063\u3066\u3044\u307e\u3059\u3002\n- \u53f3\u76ee\u306b\u9ed2\u3044\u773c\u5e2f\n- \u30d8\u30a2\u30b9\u30bf\u30a4\u30eb\u306f\u30dd\u30cb\u30fc\u30c6\u30fc\u30eb\u3067\u304a\u9858\u3044\u3057\u307e\u3059 (\u203b)\u3002\n- \u8eab\u9577\u306f185cm\u304f\u3089\u3044\u306e\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u203b \u4e8c\u4eba\u3068\u3082\u9577\u8eab\u3067\u30b0\u30e9\u30de\u30fc\u306a\u4f53\u578b\u3067\u3059\u3002\n\u203b \u4e8c\u4eba\u306e\u819d\u3042\u305f\u308a\u4e0a\u306e\u5168\u8eab\u7d75\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u8863\u88c5\u306f\u4e0b\u3092\u53c2\u7167\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n(https://files.catbox.moe/9os0lm.jpg)\n\n\u203b \u4eca\u56de\u3082\u3001\u9283\u5668\u306f\u63cf\u304b\u306a\u3044\u3067\u304f\u3060\u3055\u3044\n\n2. \u72b6\u6cc1\u53ca\u3073\u69cb\u56f3\n\u305d\u308c\u306f\u4e0b\u306e\u8cc7\u6599\u3092\u53c2\u8003\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n(https://files.catbox.moe/jhx3ug.jpg)\n\n3. \u80cc\u666f\n\u6e29\u6cc9\u3078\u306e\u5165\u308a\u53e3\u304c\u898b\u3048\u308b\u5ba4\u5185\u3067\u3059\u3002\n\u5ba4\u5185\u306e\u58c1\u9762\u306f\u6728\u6750\u306e\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u4ee5\u4e0a\u3067\u3059\u3002\n\u305d\u306e\u4ed6\u306e\u4e8b\u9805\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\n\u3067\u306f\u3001\u3054\u691c\u8a0e \u5b9c\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\nP.S \u5148\u751f\u306e\u5b9b\u540d\u304c\u3042\u308b\u4f5c\u54c1\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u305f\u3060\u3057\u3001PSD\u30d5\u30a1\u30a4\u30eb\u3067\n\u305d\u308c\u304cON/OFF\u3067\u304d\u308b\u3088\u3046\u306b\u3001\n\u5225\u306e\u30ec\u30a4\u30e4\u30fc\u306b\u4f5c\u696d\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01\n\ntag\n\u30c9\u30fc\u30eb\u30ba\u30d5\u30ed\u30f3\u30c8\u30e9\u30a4\u30f3\n\u5c11\u5973\u524d\u7dda\nMk48(\u30c9\u30fc\u30eb\u30ba\u30d5\u30ed\u30f3\u30c8\u30e9\u30a4\u30f3)\n\u30a2\u30eb\u30b1\u30df\u30b9\u30c8(\u30c9\u30fc\u30eb\u30ba\u30d5\u30ed\u30f3\u30c8\u30e9\u30a4\u30f3)", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@okashira2ki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3153915, "client_id": 1382744, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84a5afdd/uploads/origins/18128c19-fc10-43cf-84b6-ae2d797c02d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0718b9cc1f38d47587b417a40e4c2f31", "srcset": "https://si.imgix.net/84a5afdd/uploads/origins/1