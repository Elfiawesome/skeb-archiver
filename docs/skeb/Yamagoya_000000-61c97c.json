フォルメ具合\nキャラは2〜2.5頭身くらいだと嬉しいですが描きやすい形で大丈夫です。\n栗花落はセッション素材と同じデフォルメ具合〜もう少しデフォルメしたくらいのイメージです。\n\n・納品形式\nグッズ制作やココフォリア部屋の装飾として使用させていただきたいため、一人一人レイヤーわけされたpsdデータを納品いただけると嬉しいです。\n\n\n金額が見合わない場合は再送申請いただけますと幸いです。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/10DTsrnsIrQFBFh5eMcJ5gusFpdnSPuXO?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yamagoya_000000/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2749213, "client_id": 1230820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77d66b51/uploads/origins/0b1033d2-004c-48c0-8078-f79e9d99ae0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4d07b51036c41b855735c4c590d2ad7", "srcset": "https://si.imgix.net/77d66b51/uploads/origins/0b1033d2-004c-48c0-8078-f79e9d99ae0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4d07b51036c41b855735c4c590d2ad7, https://si.imgix.net/77d66b51/uploads/origins/0b1033d2-004c-48c0-8078-f79e9d99ae0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a68ef94c428518a0b7a95e9822980097 2x, https://si.imgix.net/77d66b51/uploads/origins/0b1033d2-004c-48c0-8078-f79e9d99ae0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5684fc0c1782e6db01189bb531dd5063 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77d66b51/uploads/origins/0b1033d2-004c-48c0-8078-f79e9d99ae0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75ce52dd3f3ef5b8d4b12fa67955b931", "srcset": "https://si.imgix.net/77d66b51/uploads/origins/0b1033d2-004c-48c0-8078-f79e9d99ae0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75ce52dd3f3ef5b8d4b12fa67955b931, https://si.imgix.net/77d66b51/uploads/origins/0b1033d2-004c-48c0-8078-f79e9d99ae0c?bg=%