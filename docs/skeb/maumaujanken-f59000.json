遇したりと、いろいろな解釈ができます。そのような「冒険の瞬間」を自由に描いてほしい。\n\nなお、キャラクターデザインの通り、腕の片側に赤茶色の模様があります。服装は以下を参考にしてほしい。https://drive.google.com/drive/folders/1gFwUUZro6Unewt9U414hikRVfaHqFLX1?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maumaujanken/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b8af4709/uploads/origins/05e4dcc0-d39e-4794-9944-c0a013a4f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=776c58908a2ea645c1edcc10f2114e0a", "srcset": "https://si.imgix.net/b8af4709/uploads/origins/05e4dcc0-d39e-4794-9944-c0a013a4f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=776c58908a2ea645c1edcc10f2114e0a, https://si.imgix.net/b8af4709/uploads/origins/05e4dcc0-d39e-4794-9944-c0a013a4f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b94432e6b6d942bac9b85543d3590261 2x, https://si.imgix.net/b8af4709/uploads/origins/05e4dcc0-d39e-4794-9944-c0a013a4f3ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=06495dd8e3752fefacdf10440e1671e4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2491475, "client_id": 1541062, "nc": 1}, {"path": "/@maumaujanken/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8874a388/uploads/origins/ad9aa4ec-b7cd-4c5e-9142-886121b8fba0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03d8de00362ceb19950f00976ed4a1dc", "srcset": "https://si.im