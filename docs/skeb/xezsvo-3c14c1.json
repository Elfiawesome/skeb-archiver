223c21876, https://si.imgix.net/7ee2ee57/uploads/origins/c3ffe946-897a-4a5d-9e89-f6a3278d7329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6392aa3e2f7fdbf8d8afc641d692143 2x, https://si.imgix.net/7ee2ee57/uploads/origins/c3ffe946-897a-4a5d-9e89-f6a3278d7329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93349f07df5c70341f7edfd6e8968ba1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ee2ee57/uploads/origins/c3ffe946-897a-4a5d-9e89-f6a3278d7329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d25651844ecd1f3d29b666407907371f", "srcset": "https://si.imgix.net/7ee2ee57/uploads/origins/c3ffe946-897a-4a5d-9e89-f6a3278d7329?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d25651844ecd1f3d29b666407907371f, https://si.imgix.net/7ee2ee57/uploads/origins/c3ffe946-897a-4a5d-9e89-f6a3278d7329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=146245b139e1b1ae9ff366e4deb53c9d 2x, https://si.imgix.net/7ee2ee57/uploads/origins/c3ffe946-897a-4a5d-9e89-f6a3278d7329?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aac9837c76953133048f4a1fbe82b9fd 3x"}, "body": "*Hello, I am an overseas client and I am using a translation tool for assistance. I apologise in advance if any part of my message is unclear or if my wording comes across as impolite.\n\nはじめまして。\n先生が描かれる凛々しい青年キャラクターに強く惹かれ、このたびご依頼をお送りさせていただきました。\n\n私のオリジナルキャラクター二名について、\n現代世界観（現代パロディ）での立ち絵を、それぞれ一枚ずつご制作いただけましたら幸いです。\n用途はTRPG用の立ち絵を想定しております。\n\n衣装・雰囲気について\n白衣を着用した研究者風（研究室での実験服）\nもしくは、長めで細身のシルエットのコート（トレンチコート等）\nといった装いをイメージしております。\nどちらの場合も、現代的で落ち着いた雰囲気の立ち絵を拝見できましたら嬉しいです。\n\n髪型につきましては、先生のご判断でアレンジしていただいて構いません。\n髪色と瞳の色のみ設定通りであれば問題ございません。\nなお、髪型につきましては先生のセンスにお任せいたしますが、\nセンター分けのみ避けていただけましたら幸いです。\n\nキャラクターについて\n\n・猫耳の男性キャラクター\n（※人間の耳はありません）\n身長176cm。\n表情は控えめで、落ち着きがあり淡々とした印象の人物です。\n一見すると穏やかで信頼感がありますが、内面には腹黒さを秘めたタイプです。\n\n・黒髪の男性キャラクター\n身長178cm。\n常に皮肉めいた、どこか飄々とした笑みを浮かべる享楽主義的な性格です。\n\n現代パロディ設定では、二人とも研究室に所属する研究者という立場になります。\n\n体型は二人とも、背が高く細身で中性的な、美青年寄りのシルエットを想定しております。\n体格差はなく、先生が最も描きやすいバランスでお任せできましたら嬉しいです。\n\n必要でしたら再送をご利用ください。\n難しい場合は、キャンセルしていただいて問題ございません。\n\nhttps://drive.google.com/drive/folders/1wK6deGcQM9BBCtdYvv9-qZCL_SjL7Kzg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@xezsvo/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e1117c90/uploads/origins/5a4c081f-49e5-436c-b4e7-2734e8bf8d50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1456c1e8c25faa007f892a47ac91fef2", "srcset": "https://si.imgix.net/e1117c90/uploads/origins/5a4c081f-49e5-436c-b4e7-2734e8bf8d50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1456c1e8c25faa007f892a47ac91fef2, https://si.imgix.net/e1117c90/uploads/origins/5a4c081f-49e5-436c-b4e7-2734e8bf8d50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01249a8eb6c67492b9a0b89126ac5165 2x, https://si.imgix.net/e1117c90/uploads/origins/5a4c081f-49e5-436c-b4e7-2734e8bf8d50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6767fa4bc5dffcbffa0ba252cc4ea441 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3206116, "client_id": 3267859, "nc": 1}, {"path": "/@xezsvo/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/818824a4/uploads/origins/e59c4407-0c9d-49af-916a-038249bb9c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit