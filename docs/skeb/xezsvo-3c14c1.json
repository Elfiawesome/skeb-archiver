わしていて電波っぽい。全ての発言が平仮名に聞こえるほど緩いが、好きなものごとについての話になるとつい熱がこもり、話が長くなる。自覚はないがかなりオタク気質。重度のガンマニア。甘兎宙をとても大事に思っており、従者のようにそばにいる。甘兎宙を生かすことだけが今の自分の生きがい。\n\n【共通】\n2人とも普通の幸せが分からない。誕生日にプレゼントを貰うとか、朝昼晩温かいご飯が出るとか。今は二人で、普通の幸せを模倣して、【幸せな生活】の真似事をして生きている。お互いにお互いがいなければとっくに死んでいる。\n\n【使用用途】 \n個人の鑑賞\n創作仲間への共有\nアイコン 壁紙等の使用。  \n\n何か不備等ありましたらすみません。 金額が合わない場合は遠慮なく再送、キャンセルしていただければ幸いです。 ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-G9Acz2VVSMSBYZCcVSH8kR731BHOpES", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@xezsvo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3206116, "client_id": 1135893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef162512/uploads/origins/2c4a7f69-eb32-461f-9962-b6e201a479bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a89074328fbfaa17d070d31a1509502", "srcset": "https://si.imgix.net/ef162512/uploads/origins/2c4a7f69-eb32-461f-9962-b6e201a479bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a89074328fbfaa17d070d31a1509502, https://si.imgix.net/ef162512/uploads/origins/2c4a7f69-eb32-461f-9962-b6e201a479bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cb1edb57b278feaf4d6da09a348bb60 2x, https://si.imgix.net/ef162512/uploads/origins/2c4a7f69-eb32-461f-9962-b6e201a479bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57327e1666b617064a111a40c5b8a9b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef162512/uploads/origins/2c4a7f69-eb32-461f-9962-b6e201a479bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d83a75a19948992b5dc9861280135d4", "srcset": "https://si.imgix.net/ef162512/uploads/origins/2c4a7f69-eb32-461f-9962-b6e201a479bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20