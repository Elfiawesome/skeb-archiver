83-9a89-fa1f5e1c12fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82b353998e5e69ee61e49e21dd7cbdbb 2x, https://si.imgix.net/c9d65e03/uploads/origins/c625d4d3-79e7-4283-9a89-fa1f5e1c12fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3283bfcc9df470625382fbb072f10d5 3x"}, "body": "月宮サラママへ\n今回も打ち合わせなしで大丈夫なので、こちらより依頼させて頂きました！﻿\n\n【イラスト内容】\n－14の新年イラストをお願い致します！\n\n﻿【構図】\nサラママにお任せ致します。\n来年がうさぎ年のため、私のテーマであるうさぎ要素、お酒(日本酒)が好きなので、マスに入ったお酒などを入れて頂けたら嬉しいです！\n\n【服装や髪型】\n服装は、振袖でお願いします。デザインはお任せ致します。首元にファーがあると嬉しいです。\n髪型やその他装飾品は、雰囲気に合うように変更して頂けると幸いです。\n\n【描画について】\n背景透過のイラストをサムネイルに使わせて頂くと思いますので、頭のてっぺんと横が切れないように描画頂けましたら幸いです。\n\n【差分について】\n予算内で可能でしたら、通常とお酒に酔って頬を赤らめて瞳がトロンとしているものと2パターン頂けると幸いです。(表情差分)\n難しい場合は大丈夫です。\n\n【使用用途】\nTwitterでの宣伝活動、動画のサムネイル、一部配信内で使わせて頂けたらと思います！\n表情差分がある場合は、差分の方はdiscord会員限定で無料で見れる形にしたいと思っております！\n\n【納品形態】\n背景がある場合は、\n背景あり、なし(透過)、サインあり、サインなしのそれぞれのPNG\n(差分がある場合は差分(背景あり)差分(背景透過)も頂けると幸いです。)\n\nもしくは、背景あり、なし(透過)、差分(背景あり)、差分(背景透過)、サインのオンオフの切り替えができるレイヤー分けをされたPSDデータ\n\nのどちらかで納品頂ければと思います。\n\n【最後に】\nママの可愛くセクシーなイラスト、楽しみにしてます！\n\nhttps://mobile.twitter.com/minus14iyon/status/1554008417903480832/photo/1", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukimiya_sara/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 726607, "client_id": 2113141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/127778bf/uploads/origins/ca9483cb-96be-4dd7-8d87-b03e459e615f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb81a5810a73838dd5d66b55011bb9c", "srcset": "https://si.imgix.net/127778bf/uploads/origins/ca9483cb-96be-4dd7-8d87-b03e459e615f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb81a5810a73838dd5d66b55011bb9c, https://si.imgix.net/127778bf/uploads/origins/ca9483cb-96be-4dd7-8d87-b03e459e615f?bg=%23fff&auto=format%2Ccom