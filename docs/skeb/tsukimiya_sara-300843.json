テでもお任せしたいと思います。\nその他、先生のいい所が出せる様おまかせでお願いしたいです。\n\n用途は配信用のサムネや待機画面で使用したいと思っています。背景有無のレイヤーを分けて納品して頂けると頂けるとありがたいです。\n\n私の参考画像としては「#アートめぐり」で検索していただければと思ってます。\n自己紹介です★身長 149cm　★バスト E~F　★年齢 永遠の15歳(JK)　★異世界からの転生者で、16歳の誕生日になると15歳にリセットされる呪いがかけられている(記憶以外がリセット) ※中二病ではない", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukimiya_sara/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 726607, "client_id": 1334830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90578af8/uploads/origins/ed149750-c8b7-4499-b467-4d85e3cd2658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a13251c75d2948917121d64e935ecba", "srcset": "https://si.imgix.net/90578af8/uploads/origins/ed149750-c8b7-4499-b467-4d85e3cd2658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a13251c75d2948917121d64e935ecba, https://si.imgix.net/90578af8/uploads/origins/ed149750-c8b7-4499-b467-4d85e3cd2658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be00c3c679ebaeb7cfbdde9b3963c8db 2x, https://si.imgix.net/90578af8/uploads/origins/ed149750-c8b7-4499-b467-4d85e3cd2658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bddd813f0d2a057414d82d80a406454b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90578af8/uploads/origins/ed149750-c8b7-4499-b467-4d85e3cd2658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=609d1415262b16706a545c85e3b9af7f", "srcset": "https://si.imgix.net/90578af8/uploads/origins/ed149750-c8b7-4499-b467-4d85e3cd2658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=609d1415262b16706a545c85e3b9af7f, https://si.imgix.net/90578af8/uploads/origins/ed149750-c8b7-4499-b467-4d85e3cd2658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=