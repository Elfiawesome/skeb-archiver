e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=862d4b3bedc52ecac05ab989ba4839a3", "srcset": "https://si.imgix.net/ea48dbda/uploads/origins/7103f96b-143e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=862d4b3bedc52ecac05ab989ba4839a3, https://si.imgix.net/ea48dbda/uploads/origins/7103f96b-143e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d1ae0543abaf074744ae1962e93804c 2x, https://si.imgix.net/ea48dbda/uploads/origins/7103f96b-143e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a44e365737f789c465e79890831fe3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea48dbda/uploads/origins/7103f96b-143e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc1d0a6ba688fd5e4bf69609beedd191", "srcset": "https://si.imgix.net/ea48dbda/uploads/origins/7103f96b-143e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc1d0a6ba688fd5e4bf69609beedd191, https://si.imgix.net/ea48dbda/uploads/origins/7103f96b-143e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79d32b324e1f9ec829b20999b300161a 2x, https://si.imgix.net/ea48dbda/uploads/origins/7103f96b-143e-4d39-a6aa-c96633d35e3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b33d5fe8990ef23863e7c2bbc55e6a2 3x"}, "body": "初めまして。個人Vtuberとして活動しているせな姫ちゃんと申します。\nずっと前から月宮サラ先生の描くイラストがとても丁寧で可愛く\nいつかリクエストしたいとずっと待ち望んでいました。\n　\n今回リクエストさせていただきたいのが、個人Vtuberとして活動中の『香華うとな』さんに贈るFAになります。\nイメージなのですが、月宮サラ先生のskebの過去の作品にあるような感じの歌を歌っているようなイラストに近い感じでお願いしたいと思っています。\n　\nお願いしたいポイントは\nうとなさんが目に付けているお花を付けて欲しいのと\nうとなさんを象徴する持ち物が包丁なので、どこかしらにその要素を入れていただきたいのと\n衣装等はうとなさんの通常の衣装（着物）でももちろん良いのですが\n月宮サラ先生の中で、この衣装が合いそう！と思うものがあればそちらでお願いします。\nその際、花柄を入れていただけると大変嬉しく思います。\n \nYouTubeの配信サムネイルや、X（旧Twitter）等での基本的なVtuber活動に使用される可能性が想定できるので\n人物、小物、背景が分かれたものをPSDで納品していただけたら幸いです。\n　\n私の伝え方の足りなさやイメージの不足さ故に伝えきれていない部分もあるとは思うのですが.....\n月宮サラ先生の描くうとなさんは絶対可愛いだろうなぁ....と思いながらずっと楽しみにしていたので...\n何卒よろしくお願いいたします。\n　\n参考画像として、うとなさんの全身がわかるツイートと、表情のバリエーション、目のお花の有無がわかる物を添付いたします。\n　\nhttps://x.com/kahanautona/status/1667324736760872966\n　\nhttps://x.com/kahanautona/status/1591312392696496129", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukimiya_sara/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 726607, "client_id": 1787198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbd2ff66/uploads/origins/a4166506-a37d-480d-9556-b2913298b628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bca779a1ee1e814a9056287222c051b9", "srcset": "https://si.imgix.net/cbd2ff66/uploads/origins/a4166506-a37d-480d-9556-b2913298b628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bca779a1ee1e814a9056287222c051b9, https://si.imgix.net/cbd2ff66/uploads/origins/a4166506-a37d-480d-9556-b2913298b628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cb728151a6b38b57873b7348fe1fcab 2x, https://si.imgix.net/cbd2ff66/uploads/origins/a4166506-a37d-480d-9556-b2913298b628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=369fb9fc703d53c87aa7c1683eb96ef6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbd2ff66/uploads/origins/a4166506-a37d-480d-9556-b2913298b628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93d670d9432c4d19f53a80f405a4f572", "srcset": "https://si.imgix.net/cbd2ff66/uploads/origins/a4166506-a37d-480d-9556-b2913298b628?bg=%23fff&auto=format%2Ccompr