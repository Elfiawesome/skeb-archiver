は風がなくとも一斉に飛んでいく不思議なタンポポが一面に咲いており、そこに普通の人には見えない隠れ家の屋敷を持っています。\n\n絵の構図はお任せしますが、クモイヒメの山を愛し愛される人柄、鬼を討った伝説にふさわしい威厳、そして伝説の三振りの刀を強調してください。\n\n絵全体の成立ももちろんの事ながら、TRPGでの使用も考えているため、キャラクター単体での透過画像も含めてくださるとありがたいです。\n\nhttps://imgur.com/a/project-nilarth-6RJm8J0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@k_hinata_illust/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3620699, "client_id": 3109475, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27750cad/uploads/origins/6ad6b1aa-0899-48ef-854c-97486a18881c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab7cab64e6890fa5dc631729567fa8ef", "srcset": "https://si.imgix.net/27750cad/uploads/origins/6ad6b1aa-0899-48ef-854c-97486a18881c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab7cab64e6890fa5dc631729567fa8ef, https://si.imgix.net/27750cad/uploads/origins/6ad6b1aa-0899-48ef-854c-97486a18881c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de647ac3d4ecda71a6ac7e5a5700ce53 2x, https://si.imgix.net/27750cad/uploads/origins/6ad6b1aa-0899-48ef-854c-97486a18881c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c29e3aafa05e3b09ab043ca4da49d77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27750cad/uploads/origins/6ad6b1aa-0899-48ef-854c-97486a18881c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3ae7a52c42bed5a3b4d40549f029cb", "srcset": "https://si.imgix.net/27750cad/uploads/origins/6ad6b1aa-0899-48ef-854c-97486a18881c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad3ae7a52c42bed5a3b4d40549f029cb, https://si.imgix.net/27750cad/uploads/origins/6ad6b1aa-0899-48ef-854c-97486a18881c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop