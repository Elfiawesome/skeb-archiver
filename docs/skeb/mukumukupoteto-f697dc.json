aXplPTgwJnR4dHNoYWQ9MTAmZm09cG5nJnc9MTIwMA&marky=415&txt64=44KA44GP44KA44GP44G944Gm44Go8J-Ung&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=534ccfeee4ae4730a3c6b5e0e5fdaa95", "skills": [{"genre": "art", "default_amount": 9000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mukumukupoteto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3604995, "client_id": 2546040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a7e3bd2c814fd8408128da4678af403", "srcset": "https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a7e3bd2c814fd8408128da4678af403, https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbc9f984d470049da52570d66c446a84 2x, https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39a22e8349ec8d6dd2d8c5aee7e18d25 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc94a999cdfa462405243a36e805b51", "srcset": "https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc94a999cdfa462405243a36e805b51, https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b78ff593bb5d4b28f156988c2da0edd 2x, https://si.imgix.net/97ef9342/uploads/origins/de00ba62-e0b2-43d1-8200-4dd956ed7921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81f5868d0bb3d60eeea155d5b375cce1 3x"}, "body": "初めまして、リクエストさせて頂きます。\nアイドルマスターミリオンライブの木下ひなたを依頼します。\n\nシチュエーション\nひなたとプロデューサーのイチャラブ衣装エッチシチュ。\nひなたの衣装はミリシタ8周年記念のチアガール風衣装のアナザーカラー「クリエイト∞フェスティバル＋」。\n構図については下記URLのイラストを参考に、ベッドの上でやや斜めのアングルから正常位の体位でエッチする形で、ひなたは上記の衣装に加えて両手にチア用の黄色いポンポンを持ち、ベッドに仰向けで寝転んだ状態。\nhttps://skeb.jp/@weiceng45344792/works/29\nひなたの衣装の状態について、上半身は衣装の胸の部分がはだけておっぱいを露出させており、下半身はスカートが捲れてショーツが丸見えになっている様な形。\n(ショーツのデザインは黄緑色を基調としたフリフリの可愛い系でお願いします。また、足の部分についてイラストで描写される場合は靴を脱いで靴下だけの状態にして下さい)\n\n以上を基に以下の様な感じでイラストと差分をお願いします\n(途中のひなたの台詞等についてはそちらがしっくりくる様に改変や追加等したりして頂いて構いません)\n\n1.挿入前。プロデューサーの興奮して勃起したペニスがひなたのショーツを擦っている状態。\nひなたは勃起したペニスを見つめながら嬉しそうに微笑み、自分達の為に働いてくれているプロデューサーへ感謝の念を述べてエッチを始める。\n「いつもみんなの為に頑張ってくれてありがとねぇ、プロデューサー♡」\n「お礼に、今日はあたしがエッチでプロデューサーのおちんちんを応援して元気にするべさ♡」\n\n2.プロデューサーがひなたのショーツをずらしておまんこにペニスを挿入(所謂ずらし挿入)し抽送。\nひなたは膣内で抽送されて気持ちよさそうにしながらペニスを応援する。\n「んっ♡プロデューサーのおちんちんっ♡なまらあったかくて気持ちいいよぉっ♡」\n「フレーッ♡フレーッ♡おちんちんけっぱれーっ♡」\n\n3.ひなたのエッチしながらペニスを応援する姿に益々興奮したプロデューサーが抽送を激しくし、ひなたも激しく動かれて快感を強く覚えて喘ぎ声を上げながら両者共絶頂に近づいていく。\n「あっ♡やあっ♡激しいよぉっ♡プロデューサー♡」\n「おまんこの奥にびゅっびゅって射精するまであたしっ♡いっぱい応援するからねぇっ♡」\n「おちんちんっ♡フレー♡フレー♡」\n\n4.プロデューサーが絶頂に達して射精。ひなたも膣内射精されて快感が一気に押し寄せ、困り眉で目を閉じて涙目になり、口を開けて大きな嬌声を上げながら絶頂する。\n　(可能であれば、中出し射精時の断面図描写をお願いしたいです)\n\n5.射精後。ペニスはおまんこに挿入されたまま結合部からは膣内に収まりきらなかった精液が溢れている状態で、ひなたは涙目のまま目を開けて膣内に出された幸福感から笑顔を見せ、\n　射精してもまだ自分の膣内でペニスを勃起させたままのプロデューサーにエッチの2回戦へ誘う。　\n「プロデューサーの精液、膣内(なか)にたくさん出てるべさ…♡」\n「あたしの応援でおちんちん、頑張って元気になってくれたみたいだねぇ♡」\n「もっとエッチして元気になって欲しいなぁ、えへへ…♡」\n\n\n以上になります。色々と注文が多いですが、ご検討宜しくお願い致します。\n(金額等が合わなければ再送要請をして頂けると幸いです)\n\n参考資料　衣装\nhttps://drive.google.com/file/d/1j9QqLDhEVhELUqzERmsxZIpkT0KojqAj/view?usp=drive_link\nhttps://drive.google.com/file/d/1oeUKi79FfuINTVYQ91QzB-NGe9bX30A6/view?usp=drive_link\nhttps://drive.google.com/file/d/1EGE1dvQdWtS_U9I8VMW5KnpSbWF85Qp4/view?usp=drive_link\nhttps://drive.google.com/file/d/1-zojGlLItjNHegFq1-Ui1yz1B6ELLTwU/view?usp=drive_link\nhttps://drive.google.com/file/d/1Rh1e22opUPQn1-pCwdKIuuaxKeEUwKzK/view?usp=drive_link\nhttps://drive.google.com/file/d/109tIZBKddBblD2qpAITf-I7LHVir_fxo/view?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mukumukupoteto/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3604995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f98d787c421b513a5ac671b12906e9", "srcset": "https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f98d787c421b513a5ac671b12906e9, https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=629e972bbcf5fee51dd5c276cd3ab8a9 2x, https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a06e92555f5f1b7fca26350ad4286ef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=004e49601818fece526eef4681f08ed4", "srcset": "https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=004e49601818fece526eef4681f08ed4, https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2369f59d09e91afeb35dc0c7460c6d0a 2x, https://si.imgix.net/8647c4c5/uploads/origins/925e726a-2dbe-4b12-a91e-1b4d2cd4a82d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9594bf171df3ad374929a9054fb792f 3x"}, "body": "以下再送いたします、完成をお待ちしております！\n\nミリオンライブより、野々原茜ちゃんとのらぶらぶえっち絵をお願いします。\n\n①:茜ちゃんは通常髪型・服装は裸、茜ちゃんが「プロちゃんってば仕方ないなぁ〜」と煽り気味な形でPとえっち。\n\n②:最初は百合子ちゃんと同様、茜ちゃんが優位に立ちつつおまんこに挿入。途中からP側へ主導権が逆転し、茜ちゃんはPに甘え気味になりつつ奥を攻められる。\n\n③:茜ちゃん・P共に絶頂&中出し。事後、茜ちゃんが息を切らしつつ、2回戦をおねだりする。射精時のシーンでは断面図描写を入れて頂きたいです。\n\n①から③の細かい点については、必要に応じて変更いただいて問題ありません。全体的に、明るくイチャイチャめの強いイメージで描いて頂けると嬉しいです。\n\n以上、ご検討のほどよろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mukumukupoteto/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3604995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfcf082930643fbf4bf4326d113eb1d4", "srcset": "https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfcf082930643fbf4bf4326d113eb1d4, https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10c04d4a83489b43aa070fb21dd25dfc 2x, https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e056569dc16ef1cbe97c24f1129c3242 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd43f83802d2baf62bdec994bcb2500", "srcset": "https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd43f83802d2baf62bdec994bcb2500, https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a4d6484c316ee00cb3124dfbce999d0 2x, https://si.imgix.net/bf2cbfc7/uploads/origins/b0353d8f-d484-448f-8c1b-e8d25240e1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d943149737628954e1540398445b8857 3x"}, "body": "素晴らしいイラストに心惹かれました！\n\nhttps://www.pixiv.net/artworks/129807249\n\nこちらの作品の時系列の後という設定で「パイズリ尋問する天空橋朋花(巨乳)」のイラストをリクエストさせてください\n\n構図としてはなんとなく下の作品のようなものをイメージしていただければ\n\nhttps://www.pixiv.net/artworks/107624990\n\n目を覚ますと全裸の天空橋朋花にパイズリされているP\n\n以下2人のセリフのイメージ\n「朋花！？一体何を！！？」「おや目覚めましたか？聞きましたよ〜。どうやらアイドルに手を出したそうですね〜？」「ご、誤解だ！あれは向こうから…」「言い訳をするつもりですか？いいでしょう。ならば私のパイズリに耐えて射精を我慢できたら信じてあげましょう。アイドルに邪な気持ちを抱かないなら当然我慢できますよな〜？」「そ、それは…」(なんやかんやあって射精してしまうP)(勢い余って朋花の顔を汚してしまう)\n「…聖母の顔を汚すとは…これはキツいお仕置きが必要なようですね…」\n\n↑勢いのまま書いていますので先生のセンスで改変や修正していただけると幸いです\n\nまた朋花の髪型は通常(お団子)で表情は威圧感のある感じの笑顔でお願いしたいです\n\nご検討をよろしくお願いします\n\nhttps://www.pixiv.net/artworks/107624990", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 43569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りよ☕️", "screen_name": "Liyocafe", "avatar_url": "https://pbs.twimg.com/profile_images/1910203683641647105/rB76lrWj.jpg", "header_url": "https://pbs.twim