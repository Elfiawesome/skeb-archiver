記は「灰咲しの」を大きく、読みとして「Haizaki Shino」を名前の下に、名前文字より小さめに入れてください。\n・モチーフとして立ち絵にあるような花、リボン、可能であれば小さく宝石チックなモチーフがあれば嬉しいです。\n・カラーリングはグレー、薄紫、黒系希望で、それぞれの配色については先生にお任せ致します。\n\n【使用目的】\n・各種SNSでの宣伝活動\n・収益化予定の配信媒体でサムネイルや待機画面、配信画面等に組み合わせての使用\n\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://x.com/shino_promisu/status/1785841894515482736?s=46&t=otwk7L35lNUuA3pKQMSirA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakaki_nei_d/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3121694, "client_id": 1979355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8e3f1ad/uploads/origins/66c85986-6b5e-4070-b8a6-1dc6f09afa98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84eb3afdb7d18391ebe351d668861abd", "srcset": "https://si.imgix.net/a8e3f1ad/uploads/origins/66c85986-6b5e-4070-b8a6-1dc6f09afa98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84eb3afdb7d18391ebe351d668861abd, https://si.imgix.net/a8e3f1ad/uploads/origins/66c85986-6b5e-4070-b8a6-1dc6f09afa98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26ac60945f137106b369d93ae64f6bf3 2x, https://si.imgix.net/a8e3f1ad/uploads/origins/66c85986-6b5e-4070-b8a6-1dc6f09afa98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e158e936c0e0f5324d060027f4c8a6f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8e3f1ad/uploads/origins/66c85986-6b5e-4070-b8a6-1dc6f09afa98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6912a6bb8204e2f14a9dda25e2e25659", "srcset": "https://si.imgix.net/a8e3f1ad/uploads/origins/66c85986-6b5e-4070-b8a6-1dc6f09afa98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6912a6bb8204e2f14a9dda25e2e25659, https://si.imgix.net/a8e3f1ad/uploads/