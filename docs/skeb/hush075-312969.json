7de0\u3081\u306f\u30de\u30b9\u30af\u30c9\u30d9\u30a2\u30fc\u3001\u30de\u30b9\u30af\u30c9\u30bf\u30a4\u30ac\u30fc\u3092\u5e0c\u671b\u3057\u307e\u3059\u3002\n\n\n\n\u3010\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u6848\u3011\n1.\u56de\u5fa9\u7528\u30dd\u30c3\u30c9\u4f7f\u7528\u6642\u306e\u670d\u88c5\u3068\u3057\u3066\u30de\u30f3\u30ad\u30cb\u304c\u52b9\u679c\u7684\u3068\u534a\u3070\u5f37\u5236\u3055\u305b\u3001\u6db2\u4f53\u306e\u4e2d\u3067\u4f11\u606f\u3059\u308b\u30de\u30f3\u30ad\u30cb\u59ff\u306e\u30d2\u30fc\u30ed\u30fc\u305f\u3061\u3067\u773c\u798f\u3059\u308b\u3002\n\n2.\u30dd\u30c3\u30c9\u306e\u5237\u308a\u8fbc\u307f\u52b9\u679c\n2-1.\u300c\u30dd\u30c3\u30c9\u3092\u4f7f\u7528\u3059\u308b\u305f\u3081\u306e\u670d\u88c5\u3060\u304b\u3089\u3001\u30d2\u30fc\u30ed\u30fc\u672c\u90e8\u5185\u3067\u30de\u30f3\u30ad\u30cb\u3092\u7740\u3066\u3044\u308b\u3053\u3068\u306f\u81ea\u7136\u300d\n \u30de\u30f3\u30ad\u30cb\u59ff\u3001\u30de\u30f3\u30ad\u30cb\u306e\u4e0a\u306b\u767d\u8863\u3001\u30d2\u30fc\u30ed\u30fc\u30b9\u30fc\u30c4\u306e\u4e0b\u306b\u30de\u30f3\u30ad\u30cb\u306a\u3069\u3001\u30de\u30f3\u30ad\u30cb\u3092\u7740\u3066\u3044\u308b\u3053\u3068\u304c\u5f53\u305f\u308a\u524d\u306b\u306a\u3063\u305f\u30d2\u30fc\u30ed\u30fc\u672c\u90e8\n2-2.\u300c\u30de\u30f3\u30ad\u30cb\u304c\u4f3c\u5408\u3046\u4f53\u578b\u306f\u30ac\u30c1\u30e0\u30c1\u30ac\u30c1\u30c7\u30d6\u306e\u8089\u4f53\u300d\n \u935b\u3048\u308b\u8077\u54e1\u3084\u8102\u80aa\u7b4b\u8089\u3067\u30d0\u30eb\u30af\u30a2\u30c3\u30d7\u3092\u76ee\u6307\u3059\u30d2\u30fc\u30ed\u30fc\u304c\u5897\u3048\u308b\u3002\u3000\u30ac\u30c1\u30e0\u30c1\u30ac\u30c1\u30c7\u30d6\u5316\u3092\u4fc3\u9032\u3059\u308b\u7279\u5225\u88fd\u306e\u30de\u30f3\u30ad\u30cb\u3092\u30ed\u30c3\u30ab\u30fc\u306b\u4ed5\u8fbc\u3080\u3002\n2-3.\u300c\u30de\u30f3\u30ad\u30cb\u3067\u5f37\u8abf\u3055\u308c\u308b\u30ac\u30c1\u30e0\u30c1\u30ac\u30c1\u30c7\u30d6\u306f\u3068\u3066\u3082\u30a8\u30ed\u3044\u3002\u305d\u306e\u59ff\u3092\u898b\u3066\u8208\u596e\u3059\u308b\u3001\u52c3\u8d77\u3059\u308b\u3053\u3068\u306f\u81ea\u7136\u306a\u3053\u3068\u300d\n2-4.\u300c\u30de\u30f3\u30ad\u30cb\u306f\u8089\u4f53\u306e\u4e00\u90e8\u3002\u8131\u304c\u306a\u3044\u3067\u4f53\u81ed\u304c\u67d3\u307f\u3064\u304f\u3050\u3089\u3044\u304c\u96c4\u3089\u3057\u3044\u300d\n2-5.\u300c\u30de\u30f3\u30ad\u30cb\u3092\u7740\u3066\u3044\u308b\u3068\u304d\u306e\u6328\u62f6\u306f\u30de\u30f3\u30ad\u30cb\u30dd\u30fc\u30ba\u3002\u89aa\u3057\u3044\u4ef2\u306a\u3089\u80a1\u9593\u90e8\u5206\u3092\u5bc6\u7740\u3055\u305b\u3066\u6328\u62f6\u3059\u308b\u300d\n\n\n3.\u56de\u5fa9\u7528\u30dd\u30c3\u30c9\u306b\u7cbe\u529b\u5897\u5f37\u306e\u52b9\u679c\u3092\u4ed5\u8fbc\u3080\uff08\u5143\u6c17\u3059\u304e\u308b\u30d2\u30fc\u30ed\u30fc\u305f\u3061\u306e\u30c1\u30f3\u30dd\u3001\u30c7\u30ab\u30c1\u30f3\u30c7\u30ab\u30bf\u30de\u5316\uff09\n\n4.\u30de\u30f3\u30ad\u30cb\u59ff\u306e\u30d2\u30fc\u30ed\u30fc\u305f\u3061\u306b\u30bb\u30af\u30cf\u30e9\u30b9\u30ad\u30f3\u30b7\u30c3\u30d7\u3059\u308b\u30de\u30f3\u30ad\u30cb\u5927\u9b54\u738b\u3002\n\u30de\u30f3\u30ad\u30cb\u30e9\u30a4\u30f3\u3092\u306a\u305e\u3063\u305f\u308a\u3001\u98df\u3044\u3053\u307f\u5f37\u8abf\u3057\u305f\u308a\u3001\u80a9\u639b\u3051\u90e8\u5206\u3092\u727d\u5f15\u624b\u653e\u3057\u3067\u30ac\u30c1\u30e0\u30c1\u30ac\u30c1\u30c7\u30d6\u30dc\u30c7\u30a3\u3092\u306f\u3058\u3044\u305f\u308a\u3001\u4e73\u9996\u3044\u3058\u308a\u3067\u30de\u30f3\u30ad\u30cb\u304c\u5f15\u3063\u304b\u304b\u308b\u3050\u3089\u3044\u80b2\u3066\u305f\u308a\u3002\n\n5.\u30de\u30f3\u30ad\u30cb\u304c\u3059\u3063\u304b\u308a\u306a\u3058\u3093\u3060\u30d2\u30fc\u30ed\u30fc\u672c\u90e8\u306e\u69d8\u5b50\n  \u30ac\u30c1\u30e0\u30c1\u30ac\u30c1\u30c7\u30d6\u30dc\u30c7\u30a3\u306e\u30de\u30f3\u30ad\u30cb\u59ff\u3070\u304b\u308a\u306e\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u5ba4\u3001\n  \u30de\u30f3\u30ad\u30cb\u7740\u7528\u306e\u307e\u307e\u3067\u5229\u7528\u3055\u308c\u308b\u30b7\u30e3\u30ef\u30fc\u5ba4\u3084\u98a8\u5442\u306e\u6e29\u6d74\u65bd\u8a2d\n  \u66f4\u8863\u5ba4\u306b\u306f\u597d\u304d\u306a\u30de\u30f3\u30ad\u30cb\u3092\u9078\u3079\u308b\u3088\u3046\u306b\u6e96\u5099\u3055\u308c\u3066\u3044\u308b\u3002\u7cbe\u529b\u5897\u5f37\u3084\u30ac\u30c1\u30e0\u30c1\u30ac\u30c1\u30c7\u30d6\u5316\u4fc3\u9032\u3001\u30a2\u30ca\u30eb\u3084\u4e73\u9996\u306e\u958b\u767a\u3092\u4fc3\u3059\u7279\u5225\u88fd\u306e\u30de\u30f3\u30ad\u30cb\u3092\u3053\u3063\u305d\u308a\u6df7\u305c\u8fbc\u3080\u3002\n  \u66f4\u306a\u308b\u30d0\u30eb\u30af\u30a2\u30c3\u30d7\u3092\u76ee\u6307\u3057\u5927\u76db\u306e\u98df\u4e8b\u3092\u3068\u308b\u30de\u30f3\u30ad\u30cb\u59ff\u3070\u304b\u308a\u306e\u98df\u5802\n\n6.\u8e0f\u307f\u51fa\u305b\u306a\u3044\u30aa\u30b9\u30b1\u30e2\u306e\u305f\u3081\u306b\u958b\u767a\u3057\u305f\u3001\u4e00\u5ea6\u304d\u308a\u306e\u8eab\u4f53\u5f37\u5236\u64cd\u4f5c\u6a5f\u80fd\u4ed8\u306e\u7279\u5225\u88fd\u30de\u30f3\u30ad\u30cb\u3067\u5f37\u5236\u30de\u30f3\u30ad\u30cb\u30dd\u30fc\u30ba\u3002\u96c4\u3063\u3071\u3044\u30e0\u30c1\u8179\u30c7\u30ab\u8179\u30de\u30f3\u30ad\u30cb\u30c1\u30f3\u30dd\u3092\u3059\u308a\u5408\u308f\u305b\u305f\u5bc6\u7740\u30de\u30f3\u30ad\u30cb\u30dd\u30fc\u30ba\u3092\u3068\u3089\u3055\u308c\u308b\u3002\u300c\u6e80\u8db3\u3059\u308b\u307e\u3067\u300d\u3068\u3044\u3046\u7d42\u4e86\u6761\u4ef6\u3067\u304a\u4e92\u3044\u306b\u7cbe\u6db2\u6fe1\u308c\u306b\u306a\u308b\u307e\u3067\u3076\u3063\u304b\u3051\u3042\u3044\u3001\u843d\u3061\u7740\u3044\u3066\u3082\u8569\u3051\u305f\u8868\u60c5\u3092\u307f\u3066\u601d\u308f\u305a\u30ad\u30b9\u3057\u3066\u3057\u307e\u3044\u518d\u71c3\u3057\u3066\u3057\u307e\u3046\n\n7.\u89aa\u3057\u3044\u4ef2\u3067\u306e\u30de\u30f3\u30ad\u30cb\u4ea4\u63db\u3001\u4f53\u578b\u304c\u5897\u3057\u305f\u3053\u3068\u306b\u3088\u308b\u30de\u30f3\u30ad\u30cb\u5f15\u7d99\u304c\u6d41\u884c\u3059\u308b\u3002\n\n8.\u300c\u30de\u30f3\u30ad\u30cb\u59ff\u306f\u5909\u614b\u300d\u3068\u3044\u3046\u4e00\u822c\u4eba\u306e\u8a55\u4fa1\u3092\u805e\u304d\u81ea\u5206\u305f\u3061\u306e\u59ff\u3092\u9451\u307f\u3066\u56de\u5fa9\u306e\u305f\u3081\u4ed5\u65b9\u304c\u306a\u3044\u3068\u3057\u3064\u3064\u306a\u305c\u304b\u8208\u596e\u3057\u3066\u3057\u307e\u3046\u30d2\u30fc\u30ed\u30fc\u305f\u3061\u3002\n\n9.\u30d2\u30fc\u30ed\u30fc\u306e\u5b9a\u671f\u96c6\u4f1a\u3002\n\u30ac\u30c1\u30e0\u30c1\u30ac\u30c1\u30c7\u30d6\u4ee5\u4e0a\u30d2\u30fc\u30ed\u30fc\u305f\u3061\u3070\u304b\u308a\u306e\u30d1\u30c4\u30d1\u30c4\u30d2\u30fc\u30ed\u30fc\u30b9\u30fc\u30c4\u306b\u6d6e\u304b\u3076\u30de\u30f3\u30ad\u30cb\u30e9\u30a4\u30f3\u3002\n\u89e3\u6563\u6642\u306b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306b\u5411\u304b\u3046\u3082\u306e\u696d\u52d9\u306b\u623b\u308b\u3082\u306e\u69d8\u3005\u306a\u304c\u3089\u3001\u4e00\u6589\u306b\u7aae\u5c48\u3060\u3068\u3070\u304b\u308a\u306b\u30d2\u30fc\u30ed\u30fc\u30b9\u30fc\u30c4\u3092\u8131\u304e\u81ea\u7136\u3068\u30de\u30f3\u30ad\u30cb\u59ff\u3068\u306a\u308b\u30d2\u30fc\u30ed\u30fc\u305f\u3061\u3002\n\n10.\u30de\u30b9\u30af\u30c9\u30d9\u30a2\u30fc\u3068\u30de\u30f3\u30ad\u30cb\u5927\u9b54\u738b\u306e\u30de\u30f3\u30ad\u30cb\u751f\u6d3b\n\u30bb\u30af\u30cf\u30e9\u4ea4\u3048\u306a\u304c\u3089\u3082\u8eab\u306e\u56de\u308a\u306e\u4e16\u8a71\u3092\u7387\u5148\u3057\u30de\u30b9\u30af\u30c9\u30d9\u30a2\u30fc\u306e\u30d2\u30fc\u30ed\u30fc\u6d3b\u52d5\u3092\u652f\u3048\u308b\u30de\u30f3\u30ad\u30cb\u5927\u9b54\u738b\u306b\u3001\u30de\u30b9\u30af\u30c9\u30d9\u30a2\u30fc\u3082\u53d7\u3051\u5165\u308c\u3066\u3044\u304f\u3002\u5bb6\u3067\u3082\u81ea\u7136\u3068\u30de\u30f3\u30ad\u30cb\u59ff\u306b\u306a\u308b\u30de\u30b9\u30af\u30c9\u30d9\u30a2\u30fc\u3002\n\u3044\u3044\u96f0\u56f2\u6c17\u306b\u306a\u3063\u305f\u3068\u3053\u308d\u4e8c\u4eba\u306e\u751f\u6d3b\u3092\u59a8\u5bb3\u306b\u304d\u305f\u30de\u30b9\u30af\u30c9\u30bf\u30a4\u30ac\u30fc\u304c\u8a2a\u554f\u3057\u3066\u304f\u308b\u3002\n3\u4eba\u306a\u3089\u305d\u308c\u306f\u305d\u308c\u3067\u3068\u53d7\u3051\u5165\u308c\u308b\u30de\u30f3\u30ad\u30cb\u5927\u9b54\u738b\u3002\u