161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6b333f4e0b1e28d8001e8658c41c99e", "srcset": "https://si.imgix.net/87b4e2b9/uploads/origins/c56d3161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6b333f4e0b1e28d8001e8658c41c99e, https://si.imgix.net/87b4e2b9/uploads/origins/c56d3161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ca77702ffe2b529fb37c035a7d78afc 2x, https://si.imgix.net/87b4e2b9/uploads/origins/c56d3161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5ad354f081ed08618bda30b0e471c71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87b4e2b9/uploads/origins/c56d3161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b6a21bb7671dde884753fdc9a25ac31", "srcset": "https://si.imgix.net/87b4e2b9/uploads/origins/c56d3161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b6a21bb7671dde884753fdc9a25ac31, https://si.imgix.net/87b4e2b9/uploads/origins/c56d3161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=044e906d5cb40b1146a2edad45701c16 2x, https://si.imgix.net/87b4e2b9/uploads/origins/c56d3161-ef66-4f66-9827-8f23f4ab24e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=577ff156ea6380302919400ae2125ee7 3x"}, "body": "可燃様\n\nはじめまして。\n新着イラストにて可燃様のイラストを拝見し、私のキャラも是非描いていたただきたくリクエストさせていただきます！\n\n\n〖キャラクター詳細〗\nキャラクターや世界観のモチーフや引退競走馬と馬術競技です。\n\nキャラ①\n身長：168cm\nイメージカラー：黄色・青\n\n優しくてマイペースなふんわりとした性格。\n多くの名声と共にこの世を去った親の背中を追い続けてきたが、父と同じ景色を見ることなくレースを引退。\nその後は自分が自分らしくあれる場所を見つけ、仲間と新たな夢に向かって走り続けている。\nキャラ②に振り回されつつも楽しい日々を過ごしている。\n\n\nキャラ②\n身長：156cm\nイメージカラー：赤・ピンク\n\n好奇心旺盛でいつも元気なおてんば娘。お嬢様気質なところもある。\n3年間レースで走り続けた後に引退、キャラ①と共にある日を境に暮らし始めた。\n引退後もなお、憧れの父に追いつくという夢を叶えるために新たな舞台でも毎日ひたむきに努力している。\n\n✤頭頂部のボリュームがある所の内側部分のみ毛が白いです。 \n\n✤耳飾りについて \n立ち絵では右についていますが、衣装三面図の通り全ての衣装で『耳飾りは左』でイラスト制作をお願い致します。 \n\n\n〖2人の衣装について〗\n服装が『三面図』と『デザイン画』の2種類がありますので可燃様のお好きな方をお選びいただけますと幸いです。\nデザイン画をお描き頂ける場合はラフなものになっておりますので、不明な点などは可燃様の方で補完ください！\n\n\n〖使用用途〗\n個人鑑賞・SNSアイコン、ヘッダー等\n\n\n〖構図〗\nキャラの性格や衣装をみて自由にお描きいただけますと幸いです。\n\n\nお受け頂けますと幸いです。\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/102eUHjQl_w9j_S3yteK9FptjS4TBYsp3", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5385_gedo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1051284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d4dce8b/uploads/origins/11826afe-989e-4922-8300-f4e535a3aea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f31c44cab37d69958320e53e9e1de9bf", "srcset": "https://si.imgix.net/2d4dce8b/uploads/origins/11826afe-989e-4922-8300-f4e535a3aea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f31c44cab37d69958320e53e9e1de9bf, https://si.imgix.net/2d4dce8b/uploads/origins/11826afe-989e-4922-8300-f4e535a3aea8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7223dc9f780d7d8189de5b947ca06c8 2x, https://si.imgix.net/2d4dce8b/uploads/origins/11826afe-989e-4922-8300-f4e535a3aea8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=983470e2f443087057ceea916b63df0a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d4dce8b/uploads/origins/11826afe-989e-4922-8300-f4e535a3aea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2565f6962f647fb34cdf8f2c4536880", "srcset": "https://si.imgix.net/2d4dce8b/uploads/origins/11826afe-989e-4922-8300-f4e535a3a