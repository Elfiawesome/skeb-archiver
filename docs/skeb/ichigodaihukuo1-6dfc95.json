！\n\n長文失礼しました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichigodaihukuo1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3485136, "client_id": 1461403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d91011ff5c5d542fa7460074b25d2445", "srcset": "https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d91011ff5c5d542fa7460074b25d2445, https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=119e6386113c65ed2c4ed30eb2199ba7 2x, https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b88d99c671b2ead54da6e79f17d35061 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88c9dbc72980349c4de45ef117934244", "srcset": "https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88c9dbc72980349c4de45ef117934244, https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cccf6a532bed8f2aee742941f5daae1 2x, https://si.imgix.net/f432b5d3/uploads/origins/07c22e62-8100-45d8-92aa-68f5eff5e6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200