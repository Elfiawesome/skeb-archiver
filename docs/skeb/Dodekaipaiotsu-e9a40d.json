t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa56c936c8d02920f4db13faaca27bfa, https://si.imgix.net/0c6a841a/uploads/origins/7139aaae-794f-412a-9c7d-01bcaad5cacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=001438930c699ca6f5949233dd3803f9 2x, https://si.imgix.net/0c6a841a/uploads/origins/7139aaae-794f-412a-9c7d-01bcaad5cacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7e0f3d841537ad280507f6f76ba5d37 3x"}, "body": "お久しぶりです\n依頼させてください\n\nキャラ\n江口若葉\n今まで何度か描いていただいた江口ふたばの妹（資料URL参照。他の依頼の資料に使う事は描かれたクリエイターさんの許可を頂いています）\n運動不足で少しムッチリ体型、眼鏡着用で片目隠れ、少し目つき悪い、ソバカス有り\n\nシチュエーション\n資料のコンビニ制服でノーブラの状態\nコンビニ常連のおじさんたちと乳首当てゲームをしている\n当てた人が最初にセックスをするというルール\n後ろから胸を触られていて、ばっちり乳首に当たっているが、もっと触ってほしいので我慢している\nおじさんたちもわかっていて、実際は感じさせて我慢できなくさせたらという感じになっている\n表情は感じているのを我慢している\n手は体の横\n\nよろしくお願いします\n\nhttps://drive.google.com/file/d/1kr9otirdX68oZiCQYutBIJx5qOd7C2Y2/view?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dodekaipaiotsu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2679750, "client_id": 1433971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f2913bb8142252dfd930e06211cccb2", "srcset": "https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f2913bb8142252dfd930e06211cccb2, https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13f72ef5199b9995f98b5f578234cb5d 2x, https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c27dcd5823de502f4962f787d2130a1f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c11a28caa452ef211567f615ff0fdc1d", "srcset": "https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c11a28caa452ef211567f615ff0fdc1d, https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20f7b3b5e023e6366b7baf9591ffc968 2x, https://si.imgix.net/c411b9ee/uploads/origins/0410fb14-a325-4ced-95b6-3c79c8470544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc6cdab91afc538b2d0de05e4a09031f 3x"}, "body": "前回は素晴らしい作品ありがとうございました\n\n今回もうちの子の江口ふたばをお願いします\n(資料参照)\n\n衣装　旅館の浴衣\n\nシチュエーション\nセクハラ接待\n取引先相手を温泉旅館で接待している\n浴衣の下はノーブラ\n取引先に抱き寄せられた状態で、お酌をしている\n取引先は抱き寄せた方の手で、浴衣の上から胸を揉み、そのまま乳首も愛撫している\n浴衣の上から揉まれているので、浴衣の胸元は大きくはだけている\nふたばは愛撫されて感じているが、我慢してお酌している\n\nよろしくお願いします\n\nhttps://drive.google.com/file/d/1-pi03WKetbNJ9oy79QPWtcoZ4l1htkT3/view?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dodekaipaiotsu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2679750, "client_id": 1433971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72da1e86bef2dae1565e92143ecf3fd", "srcset": "https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b72da1e86bef2dae1565e92143ecf3fd, https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea0d7aaa09eccd3687c50dcea030ca6b 2x, https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc4e5898652db1767edabb7a79e121b6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edc540c5e3acb25e6e3c4c306a169487", "srcset": "https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edc540c5e3acb25e6e3c4c306a169487, https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ab32fbbb13cd3618731ec7429a718b1 2x, https://si.imgix.net/96644221/uploads/origins/6b3a6c48-d4b6-4d03-964c-802fe2d78060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2d8bb5433f2b573afbdda2d3acfae0 3x"}, "body": "前回は素晴らしい作品ありがとうございました\n今回もうちの子でお願いします\n\nうちの子\n江口ふたば(資料URL参照。他の依頼の資料に使う事は描かれたクリエイターさんたちの許可を頂いています。)\n\nシチュエーション\nAVなどによくあるシチュエーション\n出張先で後輩(男)と飲んでいたら、後輩の童貞が発覚\nなんやかやあって筆おろしの相手をすることになり、油断してたらかなりの絶倫で、何度もされたという感じ\n\n何時間もセックスして、汗だくでぐったりとした状態\nベッドの上に仰向けで足は大きく開いている\n体の周りには複数の使用済みのコンドーム\nさらに足りなかったのか中にも出されて、性器からあふれている\nふたばは少し上体を起こし、何度もされた自分の周りの様子を見て、よくこんなにやったなと呆れて疲れた表情\n髪は乱れ、眼鏡が少しずれているが気づいていない\nベッドの端辺りに脱いだ服が乱雑に置かれている\n\nよろしくお願いします\n\nhttps://drive.google.com/file/d/1eO7IyiEqzOqvBaFX1NJ_ADgomqMfDJr4/view?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@D