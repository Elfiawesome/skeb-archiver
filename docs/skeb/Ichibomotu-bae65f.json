23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab41caec33547d25cb0ad2985da6b3a4 3x"}, "body": "壱圃モツ様初めまして！この度はアピールありがとうございます！\n\n絵柄が好みでしたので是非Vtuberのアバターを描いていただきたい！と思いリクエストを送らせていただきました。\n\n希望\n• ヤンデレっぽい雰囲気\n• もし何か持たせるとしたら、のこぎりを持たせていただきたいです。\n• 可能であれば配信等のサムネイルに使用したいため、透過ファイルも納品いただけると嬉しいです。\n\nその他は自由に描いていただいて構いません！何卒よろしくお願い申し上げます⭕️\n\nhttps://x.com/7093_com?s=21", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ichibomotu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2937099, "client_id": 2847389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8c116ed7da83589022004df12517cfe", "srcset": "https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8c116ed7da83589022004df12517cfe, https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7977cb56e51696616062eca041b9f70c 2x, https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=685e438f934a36eaf9e7fb3eba32fe85 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48a7c0f394f6ffad9a14fe94dfd231f5", "srcset": "https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48a7c0f394f6ffad9a14fe94dfd231f5, https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65c3367c7d1f42dc945642e5b8f3b955 2x, https://si.imgix.net/c1fa7ef6/uploads/origins/3f76404f-b4de-47c5-989b-366b08152277?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57a7ed9720b4bda5c4980a604eacc03f 3x"}, "body": "初めまして！\nTiktokにてVライバーとして活動しております、アリソン・ヴィルミナンテと申します。\n\n壱圃モツ様のskeb募集ポストを拝見し、ぜひ描いていただきたいと思いリクエストさせていただきました！\n\n以下詳細です。\n\n┈┈┈┈┈┈┈┈┈┈\n\n【依頼内容】\nSDイラスト\n\nskeb募集ポストの右側の等身(2頭身)と、左下の等身(ミニ)どちらも描いていただきたいです。\n金額が足りなければ再送申請していただければと思います。\n\n【使用用途】\n・X、Tiktok等のSNS活動\n・Tiktok動画での使用\n・Tiktokのファンクラブステッカー\n\n【構図】\nおまかせいたします。\n\n【衣装】\nおまかせいたします。\n立ち絵の衣装でも、変更していただいても構いません！\n\n【データ形式】\n背景と人物がレイヤー分けされたPSDデータ\n\n【キャラクターについて】\n\n＜設定＞\n\n過疎の危機にある暗黒界の人口を増やすために人間界にやってきた魔王。\nキリッとした魔王というよりは、側近のほうがしっかりしていてどこか抜けている子供っぽい魔王。\n自称天才。実際スペックは高いが自分から褒められに行くので逆に褒められない。\n\n＜性別＞\n\n女\n\n＜年齢＞\n\n見た目は16歳くらい(実際は2872歳）\n\n＜性格＞\n\n寂しがり屋で褒められるのが大好き。人懐っこい。\n人を煽るのが好きだが、言い返されるとすぐ謝る小心者。ゲームが好き。\n\n＜イメージカラー＞\n\n赤、黒、金\n\n＜立ち絵＞\nhttps://drive.google.com/file/d/14-hl-VABeL79gNxqYLhmowzqZJuSvSXX/view?usp=drivesdk\n\n┈┈┈┈┈┈┈┈┈┈\n\nお忙しいところ恐れ入りますが、ご検討の程よろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ichibomotu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2937099, "client_id": 3645895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cab1ff7/uploads/origins/00e3aef6-f929-45fd-87a2-47da2034ae4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=349666496017a3552496b35122494b0f", "srcset": "https://si.imgix.net/6cab1ff7/uploads/origins/00e3aef6-f929-45fd-87a2-47da2034ae4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=349666496017a3552496b35122494b0f, https://si.imgix.net/6cab1ff7/uploads/origins