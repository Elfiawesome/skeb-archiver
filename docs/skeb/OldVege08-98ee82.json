=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=202f55f0a5b12077f8fc9bcb3d36b41a, https://si.imgix.net/9b9cc8d9/uploads/origins/f3503595-22c0-44dc-9301-f66db57ad4db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5166f47c34b1fb91d2054d3200a0973 2x, https://si.imgix.net/9b9cc8d9/uploads/origins/f3503595-22c0-44dc-9301-f66db57ad4db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=233683676eb0090fe5fc797b80e1325a 3x"}, "body": "こんにちは！あなたの作風、すごく素敵ですね。私のVTuberの夏をテーマにしたイラストを依頼したいです！\n\n参考画像はこちらです：https://drive.google.com/drive/folders/1Cw_do1X3QNqxSNciWRl3bEX76A-YvziD\n彼女はアライグマの女の子で、ちょっと不器用でドジなところがありますが、いつも明るく幸せそうな表情をしています\n\nこちらのイラストを参考に使っていただけますか？ https://hidamarirhodonite.kirara.ca/spread/101295.png\n\nあと、背景を透明にしたバージョンも送っていただけますか？ よろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OldVege08/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3546898, "client_id": 3235791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf3d62ed50ba1f1c7321fc759b0aa904", "srcset": "https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf3d62ed50ba1f1c7321fc759b0aa904, https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a20627190950891141c6f18b57468a7 2x, https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b096771a8f5d2490763a8fd3d46dd157 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=282d431c5576cd20e2446d87be1c9572", "srcset": "https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=282d431c5576cd20e2446d87be1c9572, https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5402dfb937f3a74c4f63b20369f5a77 2x, https://si.imgix.net/311134e7/uploads/origins/2108e01c-9b33-4e56-a77a-7e0889e97525?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8af0e452e62505e3e2b87cdfd0166044 3x"}, "body": "はじめまして、Xにて素敵なイラストに惹かれてリクエストを送らせていただきました。 \n今回はオリジナルキャラクターのvtuber熱斗矢メロ（ネットヤメロ）を描いていただきたいと存じております。\n特にすみすみ様のサイバーチックなイラストやハイライトの使い方が大好きです！！\n\n ◆リクエスト \n・添付資料に詳細を送らせていただきます。電脳少年とパソコンのウイルスがモチーフです。\n・男の子で16歳程度の身なり。\n ・pngファイルで、背景透過イラストと背景をそれぞれいただきたいと存じています。 \n・ 構図はサイバーパンクな摩天楼をバックに、ぷかぷか浮きながらスマホをいじっているイメージでお願いいたします。\n\n ※pngファイルで、背景透過イラストと背景、その他差分をそれぞれ頂きたく存じます。\n　無理な場合はリクエストを取り下げていただいて差し支えございませんので、勝手な要望ながら何卒宜しく\n　お願いいたします。\n\n◆苦手\nムチムチな脚・ネイル・女の子のようなポーズ（内股等）\n\n◆用途\n 配信活動、動画投稿、SNS活動、\nショート動画などで背景や素材として利用。 こちらの内容で ご検討の程よろしくお願いいたします 。\n\n◆資料\nhttps://drive.google.com/file/d/1VgPuo0y3QdYXp9Un_-RtI3eoqVLIjA-Q/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OldVege08/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6340dc67/uploads/origins/c5acc9d8-90cb-41be-b606-a73f417af0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=918aaef599ea99267e1fd07a2b537260", "srcset": "https://si.imgix.net/634