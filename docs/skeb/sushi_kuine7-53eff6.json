8ae1/uploads/origins/bea1d52b-0c1b-494d-bc1c-903fde410328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a552092f581af930433ee2fab4e09559 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/508f8ae1/uploads/origins/bea1d52b-0c1b-494d-bc1c-903fde410328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=098f9e7d4bb8b7297a3217a642159e7c", "srcset": "https://si.imgix.net/508f8ae1/uploads/origins/bea1d52b-0c1b-494d-bc1c-903fde410328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=098f9e7d4bb8b7297a3217a642159e7c, https://si.imgix.net/508f8ae1/uploads/origins/bea1d52b-0c1b-494d-bc1c-903fde410328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c88c4474f0beaf004ecf5e1fb5880748 2x, https://si.imgix.net/508f8ae1/uploads/origins/bea1d52b-0c1b-494d-bc1c-903fde410328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf82ad94f51b36029e4a2e121a68e8b9 3x"}, "body": "こんにちは。\n以前やっていただいたこのグループ作品（https://skeb.jp/@sushi_kuine7/works/1）がとても気に入り、友人と私のために作品をお願いしたいと思っていました。\n\n4人のVTuberが一緒にゲームをしているようなイメージです。舞台は居心地の良い室内で、服装は自由に変えてもらって構いませんが、カジュアルな服装が理想的だと思います。まず、狼のvtuberであるドシさんです。とても気さくで楽しい方で、対戦型のゲームをするのが大好きです。エヴァ（私）の隣に座って、一緒にコントローラーでゲームをしてほしいです。アバも負けず嫌いで、特にゲームではベストを尽くすのが好きなんだ。できれば、アバの私服は参考文献にある黒い服なので、それを着て描いてください。そして、フクロウのVtuberで自信家の夜。ミアと一緒にいるところを描いてほしいです。ミアは宵をよくからかう先生で、宵と道志には母親的な存在です。\n\nこの通りでなくとも、自由に創作してください。\nYoutube/Twitch/Twitterに使用したいです。\nご考慮いただき、本当にありがとうございました\n\nhttps://drive.google.com/drive/folders/1L413Ig-o2_TSMrLZXM7UMItZs9QesuKq?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sushi_kuine7/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.im