配信中に使用するイラストとして利用させていただきたいと考えております。\n\nもし可能でしたら、人物と背景が分かれたPSDファイル、または人物のみの透過PNGファイルをご提供いただけますと大変ありがたいです。\n\nお忙しいところ恐れ入りますが、ご確認のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/file/d/1-tntsABIx-WprdLtxONG-Z8lFnID4MKo/view?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siro_konnyaku/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3448357, "client_id": 2774668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fa066f5/uploads/origins/36efabd7-97cf-421d-a7b3-ea1cdf61e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0569883292a6bf371f33f59878b33e86", "srcset": "https://si.imgix.net/0fa066f5/uploads/origins/36efabd7-97cf-421d-a7b3-ea1cdf61e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0569883292a6bf371f33f59878b33e86, https://si.imgix.net/0fa066f5/uploads/origins/36efabd7-97cf-421d-a7b3-ea1cdf61e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d18ab4ab661bdf73015b4392930e0157 2x, https://si.imgix.net/0fa066f5/uploads/origins/36efabd7-97cf-421d-a7b3-ea1cdf61e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97dfe2a00b5e2907fb3225ee9dabdbbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0fa066f5/uploads/origins/36efabd7-97cf-421d-a7b3-ea1cdf61e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d09d8c441981e482c359d2b07be5c71", "srcset": "https://si.imgix.net/0fa066f5/uploads/origins/36efabd7-97cf-421d-a7b3-ea1cdf61e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d09d8c441981e482c359d2b07be5c71, https://si.imgix.net/0fa066f5/uploads/origins/36efabd7-97cf-421d-a7b3-ea1cdf61e25f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=