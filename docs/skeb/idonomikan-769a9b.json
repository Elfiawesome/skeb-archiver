んはかっこ良く描いていただきありがとうございました！\n\nさて、12/26にGMひらさんで「名もなきモノに決着を」を遊ばせてもらうことになりまして。しかもPC1。\n雪小織くんが素敵すぎたので、今回も是非イラストをお願いしたいのですが、TLを拝見するにかなり忙しそう。\nもしお時間が空いて、かつ気が向けばで良いので、またイラストにしていただけると嬉しいなと思い、リクエストさせていただきます。\nちなみに、もし描いて頂けるならですが、納品についてセッションの前後は拘りません。お好きな時にお好きなように描いて頂ければ幸いです。\n\nキャラシは作成中の状態ですが、添付いたしますのでご参考にしていただければ。\n\nhttps://yutorize.2-d.jp/ytsheet/dx3rd/?id=skvPjH\n\nよろしくお願いいたします。\n\nhttps://yutorize.2-d.jp/ytsheet/dx3rd/?id=skvPjH", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@idonomikan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 278586, "client_id": 1236082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43cac357/uploads/origins/1f655a95-6829-4dff-899e-d813a7551f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56f840863a11645e8f0c22bc650fe4ba", "srcset": "https://si.imgix.net/43cac357/uploads/origins/1f655a95-6829-4dff-899e-d813a7551f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56f840863a11645e8f0c22bc650fe4ba, https://si.imgix.net/43cac357/uploads/origins/1f655a95-6829-4dff-899e-d813a7551f77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2577321122a1d868a487cfe4f7a008e 2x, https://si.imgix.net/43cac357/uploads/origins/1f655a95-6829-4dff-899e-d813a7551f77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bc8ca67f1d9a3f6995a68211ae7bead 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43cac357/uploads/origins/1f655a95-6829-4dff-899e-d813a7551f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66d250409f10a1fa4ae90d96152c31db", "srcset": "https://si.imgix.net/43cac357/uploads/origins/1f655a95-6829-4dff-899e-d813a7551f77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6