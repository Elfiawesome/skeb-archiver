: true}], "sent_works": [{"path": "/@_inu_ha/works/137", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1434335, "client_id": 3656324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96a337e06a617ab7b97a1739a463c9a3", "srcset": "https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96a337e06a617ab7b97a1739a463c9a3, https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35e8b8e72232e7fd868a69cc76d9474c 2x, https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=602b17fc576a8d625404838514f74e4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25520d93c578a1b8e76690854dafe5b5", "srcset": "https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25520d93c578a1b8e76690854dafe5b5, https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=594df542a309a1ad5d209b946a7e9317 2x, https://si.imgix.net/2c4f89f0/uploads/origins/3a02a607-6710-4e18-9e99-821dd70bf2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ceace80252de00ed833baba038ccea3c 3x"}, "body": "初めまして。ぞーらと申します。\n犬餌様の絵柄がとても素敵だと思い、リクエストさせていただきます…！\n\n今回リクエストさせていただきたいのは、CoCシナリオ、「四季送り」のPCとNPCのイラストです。\nシナリオ作者様からの許可は頂いております！\n\nシナリオURL▼\nhttps://shirohappa.booth.pm/items/4929538\n\nPCの設定について▼\n・荼(にがな)/28歳/男/身長176cm\n・HO弍夏　貴方は熱さに関する殺し方を好む\n・性格:控えめ/ドジっ子/メンヘラ\n・神凪蠱毒との関係性:同居人/セフレ→恋人\n\nあびの皆の前では優しいお兄さん属性をしているが、蠱毒と2人きりになった時にメンヘラ化する。\n控えめなのも素。ドジっ子なのも素。\n（普段は髪を縛っていて、素の時は髪を下ろしている事が多いです）\n\nNPCの設定について▼\n・神凪蠱毒(かんなぎこどく)\n自分のことをおじさんと名乗るおちゃらけた男性。面白いものがとにかく好きで、下世話な話には特に敏感。人をいじり倒すことが好きだが、満足すればどこかに行く飄々とした人物だ。\n「あび」では経理担当であり、主に交渉と情報収集担当である。仕事は大抵彼が持ってくる。\n（公式様の文章より引用）\n\n2人について▼\n\n荼が蠱毒に好きと言えずにズルズルと身体の関係だけを数年間続けていましたが、シナリオ本編中に告白し、お付き合いしています。\n荼がとても重いメンヘラなので、雰囲気としては仄暗かったりドロドロしたような感じです。\n2人きりのときは基本的に蠱毒におんぶに抱っこで甘えたがりです。\n\n\nキャラデザ、会話例等の資料等も添付させていただきます。\nhttps://drive.google.com/drive/folders/1r8Fe7M4rN2lhwf5bYY6m25peqP3_rn-k\n\n構図は2人で家でゆったりしているような構図で、距離が近めだと大変喜びます。(家は和室です。)雰囲気としては仄暗い雰囲気だと嬉しいです。細かい部分はお任せいたします。\n\n▼使用用途\n・個人観賞\n・同卓との共有\n・アイコン等、SNSでの公開(必ず犬餌様の名前もご一緒に載せさせていただきます。)\n・個人利用目的でのグッズ作成(販売等の目的は一切ございません。)\n\n金額や構図等問題ございましたら再送いたします🙇💦\nご検討よろしくお願いします🙌✨\n\nhttps://drive.google.com/drive/folders/1r8Fe7M4rN2lhwf5bYY6m25peqP3_rn-k", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Secret_ssm3/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3349138, "client_id": 3656324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f39d950/uploads/origins/216d9c14-0ff4-48c4-b647-4b24f7e0f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a5d4d06a7c7bfff51fbe746b68fce2b", "srcset": "https://si.imgix.net/4f39d950/uploads/origins/216d9c14-0ff4-48c4-b647-4b24f7e0f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a5d4d06a7c7bfff51fbe746b68fce2b, https://si.imgix.net/4f39d950/uploads/origins/216d9c14-0ff4-48c4-b647-4b24f7e0f1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99ca14cc1d4751b40e4ab6e8704b923d 2x, https:/