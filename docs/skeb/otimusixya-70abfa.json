に向けている。\n・「左後方かがみながら振り返りポーズ」での視線→スヴァルトリリヤから見て左後方の人物へ視線を向けている。\n\n[イラストの背景について]\n不要ですので基本的には真っ白で構いません。お好みで簡単な背景色などを設定していただいても構いません。\n\n[その他]\n・キャラの頭身や体型は、龍トウさんが描きやすい頭身や体型に変更していただいて構いません。\n・3D人形のポーズをベースにして、ポーズの細部（手や脚の位置、持ち物の有無など）やパースはお好みで変更していただいて構いません。\n\n興味が湧きましたら描いていただけると幸いです。\n\nhttps://1drv.ms/f/s!Au6znWZjfIOKg_suargVYE0yvkdspg?e=XGwThs", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otimusixya/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b745b484/uploads/origins/e3281901-499d-4bf9-ad17-c6f4ba025d23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37a4df18b7a7ea02f0210409b53a75b7", "srcset": "https://si.imgix.net/b745b484/uploads/origins/e3281901-499d-4bf9-ad17-c6f4ba025d23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37a4df18b7a7ea02f0210409b53a75b7, https://si.imgix.net/b745b484/uploads/origins/e3281901-499d-4bf9-ad17-c6f4ba025d23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9595ab1af802cb0ac984dc33c33ed4d9 2x, https://si.imgix.net/b745b484/uploads/origins/e3281901-499d-4bf9-ad17-c6f4ba025d23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03c706909dd55fbda634f2ebd4d0cdee 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 66077, "client_id": 1649501, "nc": 1}, {"path": "/@otimusixya/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 66077, "client_id": 304504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.im