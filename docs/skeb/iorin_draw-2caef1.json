0&h=200&s=8a423a30ad18a195ea2c0812034c0d93", "srcset": "https://si.imgix.net/b9c72a3b/uploads/origins/40256c76-e9c9-4616-b488-279134f0adef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a423a30ad18a195ea2c0812034c0d93, https://si.imgix.net/b9c72a3b/uploads/origins/40256c76-e9c9-4616-b488-279134f0adef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=982864b1756b71077422cfcdc235559a 2x, https://si.imgix.net/b9c72a3b/uploads/origins/40256c76-e9c9-4616-b488-279134f0adef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff3d12b6fe7cc0514c91f6fe037ca0f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9c72a3b/uploads/origins/40256c76-e9c9-4616-b488-279134f0adef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e557c7536150936749035f88962465c", "srcset": "https://si.imgix.net/b9c72a3b/uploads/origins/40256c76-e9c9-4616-b488-279134f0adef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e557c7536150936749035f88962465c, https://si.imgix.net/b9c72a3b/uploads/origins/40256c76-e9c9-4616-b488-279134f0adef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa122c84f8eabe5747dd160ffb20e28e 2x, https://si.imgix.net/b9c72a3b/uploads/origins/40256c76-e9c9-4616-b488-279134f0adef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38dad930059b6028357ce0e06c9ffeb1 3x"}, "body": "またまたリクエストを出す機会をいただき、ありがとうございます。今回もオリジナルキャラクターです。彼女の名前は福沢あゆ。好奇心旺盛で、冒険が大好きな女の子で、目が見えないことをものともしない。チムーというペットのウサギが彼女の主な案内役となっている。長年孤児として暮らしていたが、やがて大家族の養女となり、とても可愛がられている。\n\nリクエストには、白いワンピース水着を着てビーチにいる10代／高校生のデザインで、チムを胸に抱きながらタオルの上に膝立ちで座り、カメラ／視聴者の方を見て、これから写真を撮られると聞いて、満面の笑みを浮かべる。\n\n参考フォルダには、彼女と親友のさまざまな年齢の画像が収められている。TeenAyuModels.pngは彼女の水着姿も収録されているので、参考にするのに最適なファイルだ。\n\nまたよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/12Eg7Orr5K3zRnm05BJeof36Hp74PG6Sk", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iorin_draw/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2675100, "client_id": 851537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0d275294bb9c5bac6456ce5f3254058", "srcset": "https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0d275294bb9c5bac6456ce5f3254058, https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e62d74f93e9b0faf2eb1c62861d272a4 2x, https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7541ed4b8d1b9b6d2e1082c9888c35b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d80a82958d3f4628c215a86484e0b23", "srcset": "https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d80a82958d3f4628c215a86484e0b23, https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e5736d2d4d6b7b1ff4c6b8ade61ba88 2x, https://si.imgix.net/e6d652f0/uploads/origins/20098065-1706-476d-b876-a0fb5b8fc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ebec1a86e3312fdec0d53ff48b41de2 3x"}, "body": "はじめまして、イオリ先生！\n先生の絵はとても明るくて元気ですね。\n\n未来ちゃんとセレナちゃんをポニーテールにして、ビキニと濡れたシースルーTシャツで描いていただけませんか？\n\n参考までに：\n未来さん: mega.nz/folder/sSEjkSgb#X89zcbsKSb0m6G6Mg9sPDA\nセレナさん: mega.nz/folder/MHMHTapT#307Ucz2dcFTUyI8qlngMuA\n\nニトリのこのポーズ、結構好きです：\nhttps://www.pixiv.net/artworks/129873375\nでも、どんなシチュエーションでも自由に描いてください。\n\nできればシャツを着ているバージョンと着ていないバージョンもあると嬉しいです。\n\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iorin_draw/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2675100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc5ce9b4/uploads/origins/251268c0-4be9-4171-b547-6f74e9a17d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aecbf3b8ae31718ea5436019490108a0", "srcset": "https://si.imgix.net/fc5ce9b4/uploads/origins/251268c0-4be9-4171-b547-6f74e9a17d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aecbf3b8ae31718ea5436019490108a0, https://si.imgix.net/fc5ce9b4/uploads/origins/251268c0-4be9-4171-b547-6f74e9a17d86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99f64e82f890823b0be26f2f74977ac5 2x, https://si.imgix.net/fc5ce9b4/uploads/origins/251268c0-4be9-4171-b547-6f74e9a17d86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54eefbd902beac4f607e1d3832712533 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc5ce9b4/uploads/origins/251268c0-4be9-4171-b547-6f74e9a17d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb6547b23da9c5c0ded50859ac0f3f6", "srcset": "https://si.imgix.net/fc5ce9b4/uploads/origins/251268c0-4be9-4171-b547-6f74e9a17d86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb6547b23da9c5c0ded50859ac0f3f6,