g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69e6dc2a5588b3c944a9f759d1b8651a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed83d4cb/uploads/origins/cca8afed-960b-4fbd-80f0-8f9453f63a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35fb7674678b7cada73c4102086f9f98", "srcset": "https://si.imgix.net/ed83d4cb/uploads/origins/cca8afed-960b-4fbd-80f0-8f9453f63a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35fb7674678b7cada73c4102086f9f98, https://si.imgix.net/ed83d4cb/uploads/origins/cca8afed-960b-4fbd-80f0-8f9453f63a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a369519d52623db6602f0a0dd1373509 2x, https://si.imgix.net/ed83d4cb/uploads/origins/cca8afed-960b-4fbd-80f0-8f9453f63a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16c5889d9ed05fa4b4cde870f2f18282 3x"}, "body": "お忙しいところ失礼致します。\n今回アピールを送って下さり、誠にありがとうございます。\nとても可愛らしい絵柄でリクエストしたいと思い\nぜひ下記条件のイラスト製作をお願いしたく、\nご依頼の方をさせて頂きます。(一部定型文にて失礼します)\n\n【要望】\n・猫耳の女の子のOCをお願いします\n・目はジト目のオッドアイ\n・衣装はフリル多めの夏服にて帽子を被らせてください\n　(夏らしく涼しげな印象にて)\n・その他表情・ポーズ等はすべてお任せします\n\n【構図等】\n・お好きな構図にてお願いします\n・可能でしたら背景(サイン等)無しでのデータも納品頂きたいです\n\n【使用用途等】\n・納品されたイラストは個人利用(SNSのアイコン等)の範囲外では\n　一切使用致しません\n・Skeb上にて他クリエイター様からのアピール等の参考資料として\n　イラストを引用する場合があります\n\nお手数をお掛けしますが何卒よろしくお願い致します。\nまた、羊熊猫先生のますますのご活躍をお祈り申し上げます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HitsujiPanda/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3667719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f3a1f417ce9cd842db4e8fe39035e11", "srcset": "https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f3a1f417ce9cd842db4e8fe39035e11, https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7fe1b05e9f3f7464fa665a9fb3fecb0f 2x, https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ade7d606376b45346e88412611ea2c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b720f52d9a09cd9f5f37e739aefdd96", "srcset": "https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b720f52d9a09cd9f5f37e739aefdd96, https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26d22525d58771e971b331b6f87d4c1b 2x, https://si.imgix.net/9ad93048/uploads/origins/cddbd916-97a3-49c7-895f-d3cdd8d6a7e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=541588443827879df7875cc39403a371 3x"}, "body": "アピールありがとうございます。\nキャラクターに興味をもっていただきありがとうございます。\n\nアピール元と同様の女の子のイラストをお願いできればと思います。\nこちらは参考画像ですが、セーラー服のデザイン・表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\nご提案いただいた、\n「軽く握った左手を頭に当てて膝の絆創膏が見えるぐらい片足を上げて「いっけなーい⭐💦」と言っているようなおちゃめなポーズと表情」\nというシーンのイラストをお願いできればと思います。\n可愛い姿が想像できて楽しみにしております。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1122989, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あおひと", "screen_name": "a_o_hi_to", "avatar_url": "https://pbs.twimg.com/profile_images/1835838387208790016/A7Kf4VLt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/879977449798287360/1743255276/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 21, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 48}, {"id": 1238012, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KCC🍭SDSkeb", "screen_name": "KCC_014", "avatar_url": "https://pbs.twimg.com/profile_images/1883826696467746816/psBH9OK3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1275415982819864578/1665908823/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1706029, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Suzu 7.29", "screen_name": "Suzu245612", "avatar_url": "https://pbs.twimg.com/profile_images/1992125417084588032/shegsI9j.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1133350039890173952/1763551841/1500x500", "appeal_receivable": false, "popular_creator_rank": nul