ec9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d95b754c7ec0938eaba0dce3630bed92, https://si.imgix.net/faf9a47a/uploads/origins/7570af38-ca4c-46d9-b40f-d9ad92a4ec9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c55de048d1f49055dd0d5e182590b33b 2x, https://si.imgix.net/faf9a47a/uploads/origins/7570af38-ca4c-46d9-b40f-d9ad92a4ec9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=896b42396f7c9a895ed5a7fe77d12329 3x"}, "body": "こんにちは。またアイドルマスターの水着ビーチ写真をお願いできますか？\n\nキャラクターは馬場このみ、小宮果穂\n\nフリフリの水着がとってもキュートなこのみちゃん。ピンクと白の配色。とってもガーリー\n\nKahoはとてもセクシーでスリムなビキニを着ている。真っ赤な配色。\n\n身長差があるため、スタッフは夏帆にセクシーな水着を、このみにはキュートなガーリーな水着をプレゼントした。\n\nこのみは腕を組んで怒っている。彼女はセクシーな水着が欲しかったのだ。\n\n露出度の高い水着を着るのはとても恥ずかしいようだが、一生懸命セクシーなポーズをとっている。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kenyama0730/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 359418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c4ebf44/uploads/origins/844431bf-ef9b-4c9b-b949-4ec8092c31a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12e5c7453ca55c3157c88c58abf64c61", "srcset": "https://si.imgix.net/7c4ebf44/uploads/origins/844431bf-ef9b-4c9b-b949-4ec8092c31a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12e5c7453ca55c3157c88c58abf64c61, https://si.imgix.net/7c4ebf44/uploads/origins/844431bf-ef9b-4c9b-b949-4ec8092c31a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3fcaf2cd3425bf6daabae99aa040d69 2x, https://si.imgix.net/7c4ebf44/uploads/origins/844431bf-ef9b-4c9b-b949-4ec8092c31a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7794ee5e9fe9d0bb2e42e224baae9c69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src":