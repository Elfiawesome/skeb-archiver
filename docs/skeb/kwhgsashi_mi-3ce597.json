デザインは決まっていないので、ぜひともsashi.miさんのお好きなように描いていただきたいです……！！！人の形をしていても良いし、化け物のような姿をしていても構いません！)\n\n■葵と未由→→キャラクターの詳細や資料等は、簡単にではありますが下記サイトにまとめておきました(お見せできるものが少なく；；申し訳ありません💦)。\n\n【用途】\nクレジット記載の上で個人サイト(今後制作予定)等に載せて自慢したり、自分用に印刷して眺めたりさせていただきたく思っております。他にも、個人で楽しむ範囲でグッズを作るかもしれません…！🙏✨️\n\nもし金額や情報が不足している場合は、お手数ですが再送要請をしていただけると大変嬉しいです。\nご検討のほどよろしくお願いいたします🙇🏻‍♀️\n\nhttps://drive.google.com/drive/folders/1h5tHn6vaXQTsO-uV_1X9M27kNduwIHf_?usp=drive_link", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://pbs.twimg.com/profile_images/1844812683226619904/4AKjeuiK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2552540090/1728678149/1500x500", "appeal_receivable": true, "popular_creator_rank": 17, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1514572, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しろがね", "screen_name": "shirogane_gin_", "avatar_url": "https://pbs.twimg.com/profile_images/1966891317918920710/QJv1e1j6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1430381603327418376/1775645080/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 128}, {"id": 2877064, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "チカフジアヤカ🍋illustrator", "screen_name": "A_Chikafuji", "avatar_url": "https://pbs.twimg.com/profile_images/1953670665514647552/9KqZLmkO.jpg", "header_url": "htt