fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=154150ef18c3db04710974a9b2160f27 3x"}, "body": "こんにちは。いつもお世話になっております。ごずです🙇\n\n今回、埜世さんにうちのナイトメアの衣装をデザインして頂けたらなと思いリクエストを送らせて頂きました。\n個人鑑賞させて頂けたらなと思います。\nまた、可能であれば一枚絵も描いて頂きたく思っております。(金額に見合わないようであればデザインのみで大丈夫です…！)\n\n資料↓\nhttps://twitter.com/gozu_sousaku/status/1643233235034603520?t=1s80f10BXZXY8faxTHHNbg&s=19\n\nとある森の奥深くにある、古びた屋敷に住んでいる怪物です。\n背や手は少し大きくて怖られがちですが、動物や植物がとても好きで、温厚な性格をしています。\n表情やポーズ、構図などはお任せします。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@11Clivia/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1232035, "client_id": 789312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63b0737d/uploads/origins/03ffef56-c916-4a57-a88c-e651b58e05df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc8384ec4a3a0ae4d5d02892f245581", "srcset": "https://si.imgix.net/63b0737d/uploads/origins/03ffef56-c916-4a57-a88c-e651b58e05df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc8384ec4a3a0ae4d5d02892f245581, https://si.imgix.net/63b0737d/uploads/origins/03ffef56-c916-4a57-a88c-e651b58e05df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b690902ed817d17ae50a84866e779846 2x, https://si.imgix.net/63b0737d/uploads/origins/03ffef56-c916-4a57-a88c-e651b58e05df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b09d46820435d133532f4f17bef95ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63b0737d/uploads/origins/03ffef56-c916-4a57-a88c-e651b58e05df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=216f2a9e60f38a9e0225c162feace012", "srcset": "https://si.imgix.net/63b0737d/uploads/origins/03ffef56-c916-4a57-a88c-e651b58e05df?bg=%23fff&auto=format%2Ccompress&fm=webp