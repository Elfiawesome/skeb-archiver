e/uploads/origins/5854f769-8f24-4653-a95f-22599f2ac961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92620124b74f50debcb716a7a60e65bb, https://si.imgix.net/70fc9a0e/uploads/origins/5854f769-8f24-4653-a95f-22599f2ac961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02772eaa7c3a79da858370ee256b027c 2x, https://si.imgix.net/70fc9a0e/uploads/origins/5854f769-8f24-4653-a95f-22599f2ac961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=476e89431505d3aec3d06e221e8374d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70fc9a0e/uploads/origins/5854f769-8f24-4653-a95f-22599f2ac961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2088a754981e776a94753ded6794088c", "srcset": "https://si.imgix.net/70fc9a0e/uploads/origins/5854f769-8f24-4653-a95f-22599f2ac961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2088a754981e776a94753ded6794088c, https://si.imgix.net/70fc9a0e/uploads/origins/5854f769-8f24-4653-a95f-22599f2ac961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8dee6a3001f51ac214a65bba01c6e60c 2x, https://si.imgix.net/70fc9a0e/uploads/origins/5854f769-8f24-4653-a95f-22599f2ac961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=328907eb7bffa6fd2af94407b7526796 3x"}, "body": "こんにちは、\n私はあなたのスタイルが大好きです。私のトラのキャラクターを、ちょっとトロピカルで夏の休日の雰囲気（花柄のシャツ、サングラス）で、太陽を楽しんでいるように描いてほしい。\n彼女が何をしていても構いません。私のキャラクターは不機嫌な年老いたトラで、運動神経がよく、ちょっと古い武道家です。あなたのスタイルに合わせて自由にキャラクターを変えてください。\n\nhttps://x.com/cherryjellymm/status/1706507681689899195/photo/1\n\nhttps://drive.google.com/drive/folders/1ogRh6c06U8q68ZOF4ZAB96j-0tk2r_qT?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagao_sub/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3391260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ecbe7423070556f1a54eca8c444963", "srcset": "https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4ecbe7423070556f1a54eca8c444963, https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f46901313fa5195e2d13413e779fd0f 2x, https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc10b593db3d57bb8074e7cc5610250d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e2cc3e094adba4279a25894bb8f3035", "srcset": "https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e2cc3e094adba4279a25894bb8f3035, https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d575c92a7d592b276a2fae3462d67c5d 2x, https://si.imgix.net/2b63c9ec/uploads/origins/2dad1f97-7ede-449e-997e-dbef314ca7dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93d9594eddfa623cf6c76f845c666e49 3x"}, "body": "お世話になっております、ヒラガナと申します！いつも素敵なイラスト等々拝見させて頂いております。\n\n前回リクエストを頂きましたので、こちらもぜひ描いて頂きたいキャラを……と思いこの度ご依頼させて頂きました。\n\n以下、依頼内容となります。\n\nキャラクターについて：\nアメリカ生まれ、裕福な芸術家一家に生まれた映画監督。作品はやや抽象的でアートフィルム的な作風。\n創作にのめり込んだ末に不摂生が祟って悪夢を見るようになり、存在しないものに惹かれ、自身もフィクションの存在として消費されることを望んでいる。\n人が好きな変人。エンターテイナー気質で一人が苦手な甘ったれお坊ちゃん。アイリスアウトが似合うタイプの愉快な性格。\n\nイラスト内容：雷帝さんの描く生き物が好きなので、獣化の要素を入れて頂けたらと思います。四つ足の動物系だとなお嬉しいです。\n気軽に描ける方のSkebとのことなので、気軽に自由に描いていただければと！\n\n備考：\nキャラクターはリミナルスペース、悪夢、クリーピーパスタをモチーフ要素としています。参考程度に記載しているだけなので、こちらは取り入れて頂いても頂かなくても大丈夫です。\nサングラスの有無はどちらでも構いません！特にこちらが正規の姿、という設定はないです。\n\n個人的な鑑賞のために使用いたしますので、構図、縦横比、キャンバスサイズなど自由です。\nまた、頂いたイラストをSNSへ掲載させて頂く可能性がございます。\nサインやウォーターマーク入りのものを添付して頂いた場合はそちらを優先して掲載させて頂きます。\n\n以上、ご検討頂けますと幸いです。よろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/zxib1bdtibw06zya0dj4r/AFVKS1YAG6cyBDGCM_E555Y?rlkey=o2atrku4473m9kdh7ts4hui9q&e=1&st=grz3d3wb&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 334245, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "qk", "screen_name": "qk00001", "avatar_url": "https://pbs.twimg.com/profile_images/1474901062851399680/cvCQnwcg.png", "header_url": "https://pbs.twimg.com/profile_banners/2711751211/1472369006/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 1}, {"id": 786584, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "カミカミ/Kamikami", "screen_name": "kmwolfkm", "avatar_url": "https://pbs.twimg.com/profile_images/1791694258833096705/yNiA6tHS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4788245072/1675836956/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 144}, {"id": 11437