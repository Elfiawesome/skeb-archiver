3&fit=crop&crop=top&w=200&h=200&s=eb33e9873a7ce939f3f939cf5c0698d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78902067/uploads/origins/069c100d-99d4-4f9d-b6b8-72883531c541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b728c0a77b565d150c56421944d40a1", "srcset": "https://si.imgix.net/78902067/uploads/origins/069c100d-99d4-4f9d-b6b8-72883531c541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b728c0a77b565d150c56421944d40a1, https://si.imgix.net/78902067/uploads/origins/069c100d-99d4-4f9d-b6b8-72883531c541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1085ce2b8134e5559e5dc58ac4add9e 2x, https://si.imgix.net/78902067/uploads/origins/069c100d-99d4-4f9d-b6b8-72883531c541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17cbe53371563297b8e279527af44ea8 3x"}, "body": "こんにちは！あなたの絵が大好きです！もし可能であれば、キャラクターデザインをお願いしたいです。私のアンソロキャラクターはイラワジイルカなのですが、全身をはっきりと描いて欲しいのです。また、私のキャラクターの頭の角度と表情を何枚か描いていただけると、それも素晴らしいのですが、必須ではありません。\n\n彼の名前はイクシ。身長は152cm。少しオタクだが、とても親切で無欲な男で、みんなの良いところを見ている。知り合いは多いが、孤独を感じることも多い。\n\n彼はデジタルアーティスト、ゲームデザイナーとして働いており、彼のポケモン愛をデザインに反映させたいと思っている。好きなポケモンはトゲデマル、ジラーチ、サンフローラ。好きな色は黄色、オレンジ、青。\n\n体型は丸く、目の色はダークブラウン。参考URLには、イラワジイルカがどんな姿をしているのか、そしてファーソナがどんな姿にしたいのかの例がいくつか載っている。理想的な服装もそこにあるが、追加することもできる。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uXk1kA8JBc0UatSCJfgq8FUzl_GPegOO?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagao_sub/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3391260, "client_id": 3689115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e6c2381/uploads/origins/d00da124-c885-4038-b320-e17785918026?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=