00&blur=200&s=0c28f02fc3d5bd47c8b8ea045f8cfc49 2x, https://si.imgix.net/97a5e8d5/uploads/origins/1f45a717-f06e-45c0-adf9-5dfc7c479e54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f38b1e429183893fdd3b14d26f47151f 3x"}, "body": "sanさんおはようございます。\n私のはんもん傭兵ガイラ（https://www.pixiv.net/artworks/60046339）の絵をお願い出来ますでしょうか？\nシチュエーションは戦闘中にダメージを受けて、コルセットと腰巻きが緩くなったと同時に背中に押し込んでいた尻尾がポロリと出ちゃうシーンをお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0310shunsan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 825224, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b1bc252e6414819aabe2298db73aa54", "srcset": "https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b1bc252e6414819aabe2298db73aa54, https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fdad16ca17628fdc6a8691762a45b3b 2x, https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=955322e43fa4f93fce9d2eb99f469c5c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20e41c75ec459945452ca9774d5d8368", "srcset": "https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20e41c75ec459945452ca9774d5d8368, https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f73dc3b0ab1f96cfb42caf8bb2c3c25 2x, https://si.imgix.net/e344ba30/uploads/origins/58e21589-b61e-43b4-86de-4c11f3a00549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01b151a54da89c5436c0beaa64ac95b1 3x"}, "body": "初依頼失礼します...！san様のムチムチおっきいケモ達に釣られて依頼させて頂きたいです...！\n\n依頼内容は段階的な巨乳化を描いて頂きたいです...！\n\nシチュエーションの内容は\nとある狼娘ちゃんががダンジョンに突入する際...ふと胸が大きくなるガスを喰らってしまい\n巨乳を堪えるがダンジョンアームでふわふわ尻尾をギュッとされると力が抜けてしまい...胸が大きくなってしまう...みたいな内容がいいです。\n\n巨乳にでは小・中・大みたいな差分を頂けたり表情差分で我慢する顔と蕩けたりする表情があると助かります...！\n\nキャラクターの参考画像が無いので申し訳ないですが\n瞳はタレ目の紫色、髪はロングヘア。髪色と尻尾は茶色をベースにお願いします...！\n(でもエッチな下着を付けてそれが巨乳になるにつれはみ出しちゃうシチュはいいですよね)\n\nファイルはpsdで頂けると助かりますがpngでも大丈夫です...！(色んな表情や差分を見たいので...)\n\n内容が濃い内容かもしれませんが是非受けて頂けると幸いです...！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0310shunsan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 825224, "client_id": 3233370, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adc6d550/uploads/origins/b5a0ce2e-02dd-47d3-82d9-7b7e48d9f022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=333538fd3c57282a04fb5c5453d57dd7", "srcset": "https://si.imgix.net/adc6d550/uploads/origins/b5a0ce2e-02dd-47d3-82d9-7b7e48d9f022?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=333538fd3c57282a04fb5c5453d57dd7, https://si.imgix.net/adc6d550/uploads/origins/b5a0ce2e-02dd-47d3-82d9-7b7e48d9f022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a4f23cb120acc1306c3ac0c3bf3fe55 2x, https://si.imgix.net/adc6d550/uploads/origins/b5a0ce2e-02dd-47d3-82d9-7b7e48d9f022?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e256cfaf1a7057853ff35691