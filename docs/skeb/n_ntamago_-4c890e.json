き！お絵描き、ショッピング、食べ歩き、プリクラ\n\n  2人目 \n◎性別は男の子\n ◎青髪の外ハネショートの分け目七三の前髪アシメぱっつん\n ◎目の色は青と紫グラデーション\n ◎お顔のマークは描いても描かなくてもどちらでも大丈夫です🙆‍♀️\n ◎好きな物・こと：甘いお菓子やスイーツ、ゲーム、星や夜空、寝ること\n ◎性格：意外とノリはいい、最初は乗り気じゃなくても意外と後から楽しめるタイプ 表情はあまり変わらないけど、美味しいものや好きな物を目にすると目がキラキラするので仲良くなると意外とわかりやすい\n\n  構図、背景はお任せします！(背景はありでお願いします！ ) \n服装はキャラクター設定やキャラデザを見て、ン🍳さんがこれ似合いそう！と思う服をガンガン着せてやってください…！\n\n 使用用途：spoonの配信背景、SNSのアイコン、ヘッダーです！\n\n  ご検討よろしくお願いします( . .)\"\n\nhttps://x.com/yb4ec4lq5y13855/status/1963476116548595946?s=46", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n_ntamago_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3646221, "client_id": 3308609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c898baca/uploads/origins/794bf0ff-ed92-47cf-8312-46d682f3f152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3fc76a6fab5c06da7bf47b56098cf93", "srcset": "https://si.imgix.net/c898baca/uploads/origins/794bf0ff-ed92-47cf-8312-46d682f3f152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3fc76a6fab5c06da7bf47b56098cf93, https://si.imgix.net/c898baca/uploads/origins/794bf0ff-ed92-47cf-8312-46d682f3f152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42467ef1ec094a4bf36277eca45b17ab 2x, https://si.imgix.net/c898baca/uploads/origins/794bf0ff-ed92-47cf-8312-46d682f3f152?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=990dc440d2ffc37dc82cb49785dac657 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c898baca/uploads/origins/794bf0ff-ed92-47cf-8312-46d682f3f152?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6258b3cafe140be572771fb88e4348c", "srcset": "https://si.imgix.net/c898baca/uploads/origins/794bf0ff-ed92-47cf-8312-46d682f3f152?bg=%23fff&auto=format%2Ccompre