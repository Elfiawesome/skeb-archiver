感じ↓で胸の谷間を強調した「しゃがみポーズ」\nhttps://x.com/shimiru_works/status/19099099\n背景：お任せしますが、単色（白以外）でも構いません\n\n画像のサイズ：解像度350以上　\n2Lフォト印画紙（1750×2450）を少し上回るの大きさでお願い致します。\n可能であれば印刷時にA4（2894×4093）で出力できるくらいでお願いしております。\n納品の際、可能であれば統合前のPSDファイルも一緒にお願い致します。\n\n以上に関しまして、どうぞ宜しくお願い致します。\n\nhttps://asami-dou.jugem.jp/?eid=3209", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1091998, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "厚みサンセンチ", "screen_name": "_KuneKune_ne", "avatar_url": "https://pbs.twimg.com/profile_images/1814964058099154944/S1Q2XOcf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1325061888242188288/1721556286/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 16}, {"id": 1250438, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もちたろ。", "screen_name": "mothitarOO", "avatar_url": "https://pbs.twimg.com/profile_images/1926649534056124416/PPsrMsEm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1356374408852500480/1762900062/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 1411984, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "日向はび（ひなたはび）＠イラストレーター", "screen_name": "hinata_habi_ss", "avatar_url": "https://pbs.twimg.com/profile_images/1928420657915895808/KY_xZJkj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1321695808358555651/1775374449/1500x500", "appeal_receivable": false, "pop