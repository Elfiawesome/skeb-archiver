があるので、自由に描いてください。武器も一式持っているので、自由に使ってください。\n\nアートピースについては、自分のミスで多くの敗北を喫したあとの、戦闘後の姿を中心に描いてほしいというのが唯一のリクエストだ。どんな内容でも結構です！可能であれば、SNS用に背景を透過したバージョンもお願いしたいです。\n\nよろしくお願いします！\n\n参考ファイル\nhttps://drive.google.com/drive/folders/1YmopT_1VhR433cRg5CyuS8XdAq2Uz5oG?usp=sharing\n\nhttps://drive.google.com/drive/folders/1YmopT_1VhR433cRg5CyuS8XdAq2Uz5oG?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natwo_sb428/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3816774, "client_id": 661010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9962c7d0/uploads/origins/adf2063a-c4a7-419e-a648-8ebfe7b4711e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adae0c5402eb4c63e386d39025df77c7", "srcset": "https://si.imgix.net/9962c7d0/uploads/origins/adf2063a-c4a7-419e-a648-8ebfe7b4711e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adae0c5402eb4c63e386d39025df77c7, https://si.imgix.net/9962c7d0/uploads/origins/adf2063a-c4a7-419e-a648-8ebfe7b4711e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5d0fde9ceec7272945a71f1e63669f2 2x, https://si.imgix.net/9962c7d0/uploads/origins/adf2063a-c4a7-419e-a648-8ebfe7b4711e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b87befd4c7f0e8cf84606a637df8148 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9962c7d0/uploads/origins/adf2063a-c4a7-419e-a648-8ebfe7b4711e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c352f68090e609f16a0510d3f6d42016", "srcset": "https://si.imgix.net/9962c7d0/uploads/origins/adf2063a-c4a7-419e-a648-8ebfe7b4711e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c352f68090e609f16a0510d3f6d42016, https://si.imgix.net/9962c7d0/uploads/orig