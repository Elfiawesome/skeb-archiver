bp&fit=crop&crop=top&w=200&h=200&s=a7e650e79e8b8050650bb6ae5ef499b3", "srcset": "https://si.imgix.net/8d394511/uploads/origins/5f135ab9-4ec1-41d5-b95f-d89afe0c162e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7e650e79e8b8050650bb6ae5ef499b3, https://si.imgix.net/8d394511/uploads/origins/5f135ab9-4ec1-41d5-b95f-d89afe0c162e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f2cd63959571db99268693b98c33e95 2x, https://si.imgix.net/8d394511/uploads/origins/5f135ab9-4ec1-41d5-b95f-d89afe0c162e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86c0402383e9d906e323964e95724bd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d394511/uploads/origins/5f135ab9-4ec1-41d5-b95f-d89afe0c162e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87501c14e6efbc5581443c8aae1c4606", "srcset": "https://si.imgix.net/8d394511/uploads/origins/5f135ab9-4ec1-41d5-b95f-d89afe0c162e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87501c14e6efbc5581443c8aae1c4606, https://si.imgix.net/8d394511/uploads/origins/5f135ab9-4ec1-41d5-b95f-d89afe0c162e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4599670e896b7a0bb981ed0b63973ca0 2x, https://si.imgix.net/8d394511/uploads/origins/5f135ab9-4ec1-41d5-b95f-d89afe0c162e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60c2613af6aafb99ef8e0f296fa1942b 3x"}, "body": "お初にお目にかかります個人Vtuberのシアカマコトと申します。\n\n知り合いのRTからおさしみさんのカッコいいイラストに一目ぼれしてこの度、\nおさしみさんに自分の資料を基に、私自身を人外化した「ペルソナ風のキャラクター」をデザインして頂けないでしょうか？💦\n\nおじさんですみませんが、私、シアカマコトは「あなたのお隣に住んでいる隣人」という設定です。\n※特に特徴が少なくてすみませんが「扉、鍵🔑」がイメージアイコンとなっております\n\n※ペルソナデザイン、ポーズなど指定は特にありませんのでおまかせ致します。\n\nもし宜しければイラストは活動上(Twitter、Youtube、Twitchなど)で使用させていただきたく、人物とその他をレイヤー分けされた状態の物か、単体のデータを頂けますと嬉しいです。\n\n注文が多くて申し訳ありません🙇‍♂️\nよろしければぜひご検討いただけ