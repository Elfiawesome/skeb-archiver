.imgix.net/aa2d0ef5/requests/139002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b9072594b926642d5f846fbeeb36672 2x, https://si.imgix.net/aa2d0ef5/requests/139002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=345a0548ad5bd6f1a1fca667ec091e99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa2d0ef5/requests/139002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0d5613315d2ff5af3138ce794de051", "srcset": "https://si.imgix.net/aa2d0ef5/requests/139002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0d5613315d2ff5af3138ce794de051, https://si.imgix.net/aa2d0ef5/requests/139002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15d040d36db039dc83306df324e63618 2x, https://si.imgix.net/aa2d0ef5/requests/139002_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c537273bae6f59e5c3b4cba80f07bf67 3x"}, "body": "ファンタジックな背景を描いてほしいです。\n地球には存在しないような背景で、ゲームの世界に出てくるようなイメージです。\n\n特にこれを描いてほしい！というのはありませんが、イメージとして上げるのでしたら\n\n・真っ青な空の異世界みたいな町並み\n・誰も踏み入れたことがない森と湖\n・空の上に巨大な惑星が存在する場所\n・近未来的な風景\n\nみたいな感じです。どういう内容かはお任せいたします。\n資料URLはとあるまとめサイトになりますが、雰囲気的には資料のようなイメージです。\n\nイラストは背景のみでお願いしたいです。\n\nPCのデスクトップ壁紙にしたいので、アスペクト比は16:9でお願いいたします。\n\nhttp://blog.livedoor.jp/nwknews/archives/4695286.html", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@KRR_4649/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2696299, "client_id": 53002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4938d846/uploads/outputs/34ab1423-fb0a-4a7d-97ca-7ff25e2b653f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a4c3a96bd56a7718da5bfccb30c1375d", "srcset": "htt