ブの黒髪\n・眼鏡をかけていますが外してもOKです\n・落ち着いた女性\n・口元にほくろ\n\n【私の立ち絵資料】\nhttps://x.com/makotobg066/status/1806971231293288703\n\n【使用用途】\nTwitch配信のED\nSNS等\n\nご検討のほど、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@hana__222/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2721007, "client_id": 53002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=efc45288da14d3df17b70210d3300ae3", "srcset": "https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=efc45288da14d3df17b70210d3300ae3, https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=4058c2cafc013759889dfa7c26e406af 2x, https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f677352c82ea5546bcd2a04955e77c5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c374d170003a9f324809c16a5485dfd1", "srcset": "https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c374d170003a9f324809c16a5485dfd1, https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1bcaf1ee94f7d8ba05161eeaba1538 2x, https://si.imgix.net/e3b1b3f8/uploads/origins/0cbc5088-4fc5-473a-a16f-53c70c6ba850?bg=%