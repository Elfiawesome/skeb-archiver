-dfed-41c3-a84a-67611adc0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1067098c0ded0b2475be34f98bb2b2f, https://si.imgix.net/43625427/uploads/origins/9c2ca3de-dfed-41c3-a84a-67611adc0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c64ec84ed3f14b3b0005cf7b1bb5786 2x, https://si.imgix.net/43625427/uploads/origins/9c2ca3de-dfed-41c3-a84a-67611adc0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4585d1f8ee81b54d60005f6fa116f53b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43625427/uploads/origins/9c2ca3de-dfed-41c3-a84a-67611adc0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=156ff1fdf6c52b54b41f139b367c9c5f", "srcset": "https://si.imgix.net/43625427/uploads/origins/9c2ca3de-dfed-41c3-a84a-67611adc0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=156ff1fdf6c52b54b41f139b367c9c5f, https://si.imgix.net/43625427/uploads/origins/9c2ca3de-dfed-41c3-a84a-67611adc0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ec531a399457b5f53f1fac6dfae58c6 2x, https://si.imgix.net/43625427/uploads/origins/9c2ca3de-dfed-41c3-a84a-67611adc0e04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=842e0b8fd91f36564010282202c5b219 3x"}, "body": "はじめまして。クリエイター検索からお名前を拝見して、スグリ君アイコンやXのイラストを見て絵柄が凄く好きだったのでリクエストを送らせていただきました。\n\n前編スグリ君と野生ラルトスのほのぼの一幕を描いていただきたいです。\n\nキタカミの里の木陰で木にもたれて座ったまま眠ってるスグリ君に、野生ラルトスが「なんか人間の子が寝てる～」みたいな感じでそーっと寄って見てるというイラストです。\nラルトスは2~3体位寄ってきており、スグ君はリラックス状態で足も伸ばしていて、一緒にカジッチュorオオタチも寝ている様子でお願いしたいです。\n\nもし可能なら起きてラルトスが近くにいてちょっとびっくりしたけど、「わや～」ってスグ君もラルトスもほっこりしてる差分も描いていただけると嬉しいです。\n\nラルトスの個体数やスグ君のポケモン有無、その他細かな部分のアレンジはお好みでお任せします。\n\nご検討よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_cre