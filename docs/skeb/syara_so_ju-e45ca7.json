67\u3059\u3002\n\n\u7528\u9014\u2026\u75db\u8eca\u3068\u3057\u3066\n\u30e2\u30fc\u30bf\u30fc\u30b9\u30dd\u30fc\u30c4(\u8efd\u81ea\u52d5\u8eca\u306e\u8010\u4e45\u30ec\u30fc\u30b9\u3084\u30b8\u30e0\u30ab\u30fc\u30ca\u3068\u3044\u3046\u7af6\u6280)\u3067\u8d70\u3063\u305f\u308a\u3057\u307e\u3059\n\n\u8eca\u306f\u30db\u30f3\u30c0S660\u3068\u3044\u3046\u8eca\u4e21\u3067\u3001\n\u4e00\u679a\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u8eca\u306e\u524d\u7a93\u306e\u4e0a\u90e8(\u30cf\u30c1\u30de\u30ad)\u3068\u5f8c\u308d\u306e\u30a8\u30f3\u30b8\u30f3\u30d5\u30fc\u30c9\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002\n\u203b\u30ea\u30a2\u30d5\u30fc\u30c9\u8cc7\u6599\u3068\u30d5\u30ed\u30f3\u30c8\u8cc7\u6599\u3092\u53c2\u8003\u306b\u3057\u3066\u304f\u3060\u3055\u3044\n\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc...\u4e0d\u77e5\u706b\u30d5\u30ec\u30a2\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u5358\u4f53\u3082\u80cc\u666f\u7121\u3057\u30d5\u30eb\u30ab\u30e9\u30fc\n \u982d\u304b\u3089\u819d\u5c11\u3057\u5c11\u3057\u307f\u3048\u308b\u7a0b\u5ea6\u306e\u7bc4\u56f2\n\n\u8863\u88c5...\u30e1\u30a4\u30f3\u8863\u88c5(\u30ea\u30cb\u30e5\u30fc\u30a2\u30eb\u5f8c)\n\u203b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8cc7\u6599\u3092\u53c2\u8003\n\u516c\u5f0f\u8a2d\u5b9a\u8cc7\u6599\u3088\u308a\u660e\u308b\u3081\u3067\n\u30d5\u30ec\u30a2\u306e\u660e\u308b\u304f\u53ef\u611b\u3044\u611f\u3058\u304c\u51fa\u308b\u3088\u3046\u306a\u611f\u3058\n\n\u69cb\u56f3...\u30a4\u30e9\u30b9\u30c8\u5168\u4f53\u306f\u69cb\u56f3\u8cc7\u6599\u306e\u3088\u3046\u306a\u5c11\u3057\u6a2a\u5411\u3044\u3066\u3044\u308b\u3088\u3046\u306a\u611f\u3058\u3067\n\u624b\u3084\u8155\u306f\u80f8\u3084\u9854\u306e\u8fd1\u304f\u306b\n(\u4f8b...\u9aea\u3092\u89e6\u3063\u3066\u3044\u308b\u3084\u80f8\u5143\u306b\u624b\u3092\u304a\u3044\u3066\u308b\u7b49)\n\u69cb\u56f3\u53c2\u8003\u8cc7\u6599\u3067\u306f\u30a8\u30eb\u30d5\u30ec\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u304c\n\u30a8\u30eb\u30d5\u30ec\u306f\u7121\u3057\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u30b7\