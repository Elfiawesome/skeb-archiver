せん。\n　料金に不備があった場合は金額の修正を、あるいは依頼を受けられないと判断した場合はどうぞお気軽にキャンセルしてください。よろしくお願いします。\n\n錬宮", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 275636, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "屋頼/yarai", "screen_name": "k0xyu", "avatar_url": "https://pbs.twimg.com/profile_images/1968529949968711680/UnJopT9v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/909415746387587075/1743886074/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 534308, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "osiri", "screen_name": "osiri60812441", "avatar_url": "https://pbs.twimg.com/profile_images/1550915161296617472/WWA0IJYZ.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 16}, {"id": 1059614, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ぽふも", "screen_name": "pofu31", "avatar_url": "https://pbs.twimg.com/profile_images/1617144987573178368/yOfH7FM2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1084942488069009408/1593620365/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2742776, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "椅子井@多忙", "screen_name": "ISUI_130", "avatar_url