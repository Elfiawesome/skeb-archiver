をして欲しい\n④アニメ塗りでお願いします\n\n以上です。\nポーズや背景などはおまかせ致します。\nおみやさんの描く柚子花ちゃんを楽しみにしています！\n何卒よろしくお願いします。\n\n\n※柚子花ちゃんは二次創作公認プログラムに登録していますので今後おみやさんの作品が動画等で使われる可能性があると思われます。\n上のリンクにてクリエイター向けのお願いも書いてありますので1度読んでいただけると助かります。\n\nhttps://yuzuha.fanbox.cc/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omy_0x/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 695929, "client_id": 426825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afd7624a/uploads/origins/f1b3d975-6ff9-4665-b09e-b04b7b40cb27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbcba1a1f6ac1cd6a24c00b3c074c0c", "srcset": "https://si.imgix.net/afd7624a/uploads/origins/f1b3d975-6ff9-4665-b09e-b04b7b40cb27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbcba1a1f6ac1cd6a24c00b3c074c0c, https://si.imgix.net/afd7624a/uploads/origins/f1b3d975-6ff9-4665-b09e-b04b7b40cb27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af2757cec4c4efb0255f248fb8b9c58a 2x, https://si.imgix.net/afd7624a/uploads/origins/f1b3d975-6ff9-4665-b09e-b04b7b40cb27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79d8dcba9927d415a6ef34969650456e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afd7624a/uploads/origins/f1b3d975-6ff9-4665-b09e-b04b7b40cb27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46dd7743bd27a27feb08ca43b4963021", "srcset": "https://si.imgix.net/afd7624a/uploads/origins/f1b3d975-6ff9-4665-b09e-b04b7b40cb27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46dd7743bd27a27feb08ca43b4963021, https://si.imgix.net/afd7624a/uploads/origins/f1b3d975-6ff9-4665-b09e-b04b7b40cb27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl