いて\n・いわゆる『ママ属性』が感じられるような表情でお願いします。音は精神的には大人の男性なので、内面の大人らしさが滲み出るような慈愛の表情をさせて欲しいです\n\nセリフ\n「今日も一日、お疲れ様。よく頑張ったね」\n\nhttps://drive.google.com/drive/folders/1DtzcUHMjiFV3yv5-bJwdm974n11tFbEZ?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_Napier__/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2981262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/725ad6a6/uploads/origins/40fbe090-820d-4243-a66b-297ea2e9faed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7099a96c0a831057fbb0a209ae2201", "srcset": "https://si.imgix.net/725ad6a6/uploads/origins/40fbe090-820d-4243-a66b-297ea2e9faed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd7099a96c0a831057fbb0a209ae2201, https://si.imgix.net/725ad6a6/uploads/origins/40fbe090-820d-4243-a66b-297ea2e9faed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e0f161d8d7e0ae84d01d1be9d66a199 2x, https://si.imgix.net/725ad6a6/uploads/origins/40fbe090-820d-4243-a66b-297ea2e9faed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc9c359a04103a112952c4858bc364ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/725ad6a6/uploads/origins/40fbe090-820d-4243-a66b-297ea2e9faed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce675902d4c5ba0b79117331a57ec45f", "srcset": "https://si.imgix.net/725ad6a6/uploads/origins/40fbe090-820d-4243-a66b-297ea2e9faed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce675902d4c5ba0b79117331a57ec45f, https://si.imgix.net/725ad6a6/uploads/origins/40fbe090-820d-4243-a66b-297ea2e9faed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52d3d34d400e2a96f3002d8551ee1bf0 2x, https://si.im