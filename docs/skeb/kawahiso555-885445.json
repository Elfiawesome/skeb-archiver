jLUrKZ3ijKi-ncxD6c6GKd", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kawahiso555/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2589677, "client_id": 169953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a9fced9ae3ab0527c8023da21b60d8", "srcset": "https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a9fced9ae3ab0527c8023da21b60d8, https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=867f18ce56a746ae24f780793bee09af 2x, https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1795773e3f4e7bf2fa7711e3ae5add1e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a0c0ae664ebd7b1852b2536f93ee5a9", "srcset": "https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a0c0ae664ebd7b1852b2536f93ee5a9, https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc4a8c8c7b5baaede3aac760087c8f1 2x, https://si.imgix.net/74829c44/uploads/origins/05522905-76e8-41d6-8ac2-87807db3601d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef84056a635be5227b1879f7116af548 3x"}, "body": "こんばんは！\nかわひそさんの描くイラストの塗りや雰囲気、女の子たちの表情がめっちゃ好きです！\n\n是非うちの子のイラストお願いさせてください\n\n＜ドゥーちゃん設定等＞\nhttps://note.com/poisongiant/n/n22eb18add6e4\nhttps://note.com/poisongiant/n/n12fc4ec79d24\n私のtwitterのメディア欄には、他の方に描いていただいたイラストも掲載してますので参考にしてください\n\n\n突然ですが少しエッチめなイラストでお願いできればと…\nドゥーちゃんの設定を少し読んでいただければと思いますが、彼女の服は服屋に騙されて着ています\nある時、その服の宣伝のために撮影モデル（嘘）になって欲しいと言われ、最初は断ったものの押し切られて―――\n\n「すいません、恥ずかしいんですけど、ここまで見せなきゃダメなんでしょうか」\n「他の人たちはみんな出したよ！（嘘）」\n\nみたいな感じで恥ずかしい写真を撮られているドゥーちゃんを一つお願いさせてください\n（なお、ここで撮られた写真は裏で高値で売買されているという…）\n\n何卒、御検討ください！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kawahiso555/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2589677, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfbd5ed8/uploads/origins/fa6bd597-3d7d-4083-8a68-88f92df31365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ade6ddd20e3a56c3c9d327f94f648d6", "srcset": "https://si.imgix.net/bfbd5ed8/uploads/origins/fa6bd597-3d7d-4083-8a68-88f92df31365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ade6ddd20e3a56c3c9d327f94f648d6, https://si.imgix.net/bfbd5ed8/uploads/origins/fa6bd597-3d7d-4083-8a68-88f92df31365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bb8677ebcfe54252d07e1442fcb8f17 2x, https://si.imgix.net/bfbd5ed8/uploads/origins/fa6bd597-3d7d-4083-8a68-88f92df31365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c2b5afe13727304c257901fb5db7485 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfbd5ed8/uploads/origins/fa6bd597-3d7d-4083-8a68-88f92df31365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ae03f57b8fddf118a3f85c1fe0197f", "srcset": "https://si.imgix.net/