こと、姉さまを見るなって感じのきりたん\n\n以上です。あと、完成と見比べるのが好きなのでラフやデータがあればお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@extreme_nattou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2067214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f3f37a40b76d4ed8eb5def785311b9", "srcset": "https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39f3f37a40b76d4ed8eb5def785311b9, https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f718f9fa31f089064eb1d1b85edc880 2x, https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=845ad7edd96433127fda56add3f1944e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01394e065af0785e36d3a11bf3587e33", "srcset": "https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01394e065af0785e36d3a11bf3587e33, https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93e42e6a12937d18926efc0a1ac5c8f9 2x, https://si.imgix.net/dc5f0cfa/uploads/origins/a30668b0-6cb8-4d2c-a941-82e62a620761?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro