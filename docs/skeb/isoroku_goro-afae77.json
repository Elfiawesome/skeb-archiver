d8006ea-6f1d-44c4-919c-6607a8c48577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e36d57a207f453ee6027c2565b2d3c79, https://si.imgix.net/88925e99/uploads/origins/0d8006ea-6f1d-44c4-919c-6607a8c48577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e27e43ee7b0c28b21a58007f449a654 2x, https://si.imgix.net/88925e99/uploads/origins/0d8006ea-6f1d-44c4-919c-6607a8c48577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6422751006943bf634a4b04bbb70fd4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88925e99/uploads/origins/0d8006ea-6f1d-44c4-919c-6607a8c48577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94c9a6e2c9df6ba3a9764b8e3487d863", "srcset": "https://si.imgix.net/88925e99/uploads/origins/0d8006ea-6f1d-44c4-919c-6607a8c48577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94c9a6e2c9df6ba3a9764b8e3487d863, https://si.imgix.net/88925e99/uploads/origins/0d8006ea-6f1d-44c4-919c-6607a8c48577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d26f413a4744a9d5653aca2077928ba 2x, https://si.imgix.net/88925e99/uploads/origins/0d8006ea-6f1d-44c4-919c-6607a8c48577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce58622ee449a5c0622ac1d1bb9bab55 3x"}, "body": "56原様\n\nはじめまして、ありのみと申します。\n先生に東方projectのチルノさんと大妖精さんを\n半透明バニー姿でお願いしてもよろしいでしょうか？\n\n念のため2人の資料画像を用意しましたので、もしよろしければ下記URLをご参照下さい。\nhttps://twitter.com/ARINOMI7/status/1509895347220652039\n羽のデザインはその時々で変わりますので可変(自由)だと思っておりますが\n可能であれば大妖精さんの羽根はドットで見られるようなフワっとした雰囲気があると嬉しいです。\n(先生の好みを優先して頂いて問題ありません)\n\nあくまで個人的な印象ではありますが\n　２人とも胸はぺたんこ無乳系で、身長等も同じ位（チルノさん≧大妖精さん）\n　チルノさんはツリ目系で、活発的で積極的に行動する勝気な性格。\n　大妖精さんはタレ目系で、口数が少なく消極的な受け身な性格。\n　大妖精さんの方が多少幼い雰囲気で、チルノさんの妹的存在。\n　といったイメージを持っています。\n\n前述の通り半透明バニー姿の二人をリクエストしたく存じます。\n細かなデザインは先生にお任せでお願いいたします。\nまた、