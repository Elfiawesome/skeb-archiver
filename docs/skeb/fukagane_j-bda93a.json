ついている。決してサボりではない。\n・面倒なことは苦手だが、つい首をつっこんでしまい面倒事に巻き込まれるがち。\n\nキャラクター資料はURL先にございます。\n\n何か不備がありましたらお手数ですが再送いただけますと幸いです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11mbY-3uoY1Pr6vpx6E5k2n1CljvzT0lJ?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Andou_Honpo/works/89", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2875278, "client_id": 2426497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bcf5874a/uploads/origins/cb888164-a9f1-41f7-af73-6d702d41f83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e0614307e783231b12c5908bb249c0", "srcset": "https://si.imgix.net/bcf5874a/uploads/origins/cb888164-a9f1-41f7-af73-6d702d41f83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06e0614307e783231b12c5908bb249c0, https://si.imgix.net/bcf5874a/uploads/origins/cb888164-a9f1-41f7-af73-6d702d41f83c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=577fbde3c7faf2728288c33977fe4958 2x, https://si.imgix.net/bcf5874a/uploads/origins/cb888164-a9f1-41f7-af73-6d702d41f83c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c57f0dc3dd040b7332c839e8dfecffb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bcf5874a/uploads/origins/cb888164-a9f1-41f7-af73-6d702d41f83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f38efb4d7afda65eb5ad3b73d66b7c63", "srcset": "https://si.imgix.net/bcf5874a/uploads/origins/cb888164-a9f1-41f7-af73-6d702d41f83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f38efb4d7afda65eb5ad3b73d66b7c63, https://si.imgix.net/bcf5874a/uploads/origins/cb888164-a9f1-41f7-af73-6d702d41f83c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&