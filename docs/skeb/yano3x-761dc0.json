、SNSのアイコン、ヘッダーや壁紙に使用する予定です。\n\n何か不都合があったり、金額不足でしたら遠慮なく再送していただければ対応させたいただきたいと思っております。お忙しいところ恐縮ですが、よければご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1DVSIx05eDQc9d_SexFOI8FXhEaZifmOR?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yano3x/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3398599, "client_id": 2752312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f82b6785738a5d08eba7d31c7262b6eb", "srcset": "https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f82b6785738a5d08eba7d31c7262b6eb, https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab21eb70fb32b3d8014fde136d56cc35 2x, https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a32251e3584774d33704dc64255d612 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a61939c72dff5145d099155d4f53712", "srcset": "https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a61939c72dff5145d099155d4f53712, https://si.imgix.net/b5897846/uploads/origins/37b0d90c-6a63-4538-88ec-0d1869b25700?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=024c79fc96c1604dcba817