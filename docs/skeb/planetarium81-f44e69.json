ix.net/f0f863e3/uploads/origins/7f1c2753-0c0f-4485-86a7-1d486c778169?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b87131bb29ed75146690a71eb8ea70d, https://si.imgix.net/f0f863e3/uploads/origins/7f1c2753-0c0f-4485-86a7-1d486c778169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0048f8a0da5de0e2fe796d9fdfe1b6d3 2x, https://si.imgix.net/f0f863e3/uploads/origins/7f1c2753-0c0f-4485-86a7-1d486c778169?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9e43bd98a7721c8ce32beee413e9289 3x"}, "body": "作者様のマッドラヴのくすぐり絵が本当に好きでまた見たくなりましたので、同じシチュで申し訳ないのですがリクエストを送らせて頂きたいです。\n\n\nくすぐられるキャラ\n魔法使いと黒猫のウィズに登場するヤチヨ・カスガ\n\n衣装（ヤチヨ）\nピンク色の下着。柄やデザインはお任せします。\n\nくすぐるキャラ\n遊戯王に登場するVS Dr.マッドラヴ\n\n\n内容\n前回のマッドラヴによるアレイシアのくすぐり絵のように、ヤチヨがマジックハンドに手首と足首を拘束されて、マッドラヴ本人とマジックハンドにくすぐられる絵をお願いしたいです。\n\n差分はくすぐられる前の段階と、くすぐられて両目を閉じて大笑いする差分をお願いしたいです。\n\n可能であれば、くすぐられる前の段階についてですが、周囲のマジックハンドにヤチヨの衣服を持たせて、下着姿にひん剥いたのがわかるように描いて頂けると嬉しいです。\nマジックハンドに持たせる衣服はスカートや靴等一部の衣服で大丈夫です。あるいはヤチヨの衣服を引きちぎって脱がせた想定で、ヤチヨの衣服の布の一部を持っているだけでも大丈夫です。\n\n拘束は以前と同様にマッドラヴのマジックハンドによって手首と足首を掴む形で、体勢はお任せします。\nくすぐる部位も前回と同様に腋の下や脇腹、足の裏を中心にお願いしたいです。\n\n背景や擬音、台詞等はお任せします。特に台詞はマッドラヴの部分が難しいと思われるので省いて頂いて大丈夫です…！\n\nまた、不明瞭な点や描きにくい点がございましたら描きやすいように随時変更して頂けますと幸いです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KQGLmfcucKPthAq91IybKmCBzQN6dXNw", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@planetarium81/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3351996, "client_id": 272827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62554f1fc6e73ac84fbf25ec31c539f0", "srcset": "https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62554f1fc6e73ac84fbf25ec31c539f0, https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dd0c460d1e70c9834240e3bc100cdc0 2x, https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cae151fed997c07023fd30ef96faf22 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3ca7cebc6b485991bb9296df8264800", "srcset": "https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3ca7cebc6b485991bb9296df8264800, https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97dbf8968429baf7779d62822b1a050f 2x, https://si.imgix.net/e14b0b62/uploads/origins/2abab982-43df-4814-8c3d-47a767c48217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61723af6943c6044d0d847d830f28fe8 3x"}, "body": "以前は素晴らしい絵を描いて頂きありがとうございました。良ければまたくすぐり絵のリクエストを送らせて頂きたいです…！\n\nキャラ\nソーシャルゲーム、魔法使いと黒猫のウィズに登場するエウブレナ（ハデスIV）\n\n衣装\nアプリで出た最初の衣装の、白と黒のタンクトップと黒のショートパンツ（スパッツ？）を着たもの。くすぐりやすいように、靴や袖（肘に着用してるウォーマー）は外してください！\nまた、細かな装飾や描きにくい点がございましたら変更して頂きたいです。\n\n内容\nヘルメス神との戦いに負けてしまい、洗脳された子どもたちにくすぐられる姿を配信される、みたいなシチュでお願いします。\n\n拘束はあぐら縛りのような形で足首を足枷であぐらを組むような姿勢で拘束して、手首は手枷で万歳の形になるように拘束してください。\n\nくすぐりについては腋の下、脇腹、へそといった上半身と、足裏を中心に子どもの手や羽などでくすぐってください。\nまた、配信、撮影中というのがわかるように、画面の端に●RECやLIVEというものをどこかに入れて頂きたいです。\n\n表情差分は、以前アレイシアを描いて頂いた際のくすぐり前と両目を瞑って大笑いしている表情があると嬉しいです。また、他の表情差分でこれがいい、というのがありましたらそちらもお願いしたいです。\n\n台詞や擬音、背景等はお任せします。\n\n参考資料\nhttps://youtu.be/XXEs71UI5d0?si=2x1-Z2aXPbLhniKz\n（HAL HALさんの動画より。動画時間7:40〜にテキストとボイスのみですが、エウブレナのくすぐりシーン）\n\nその他不明点や描きにくい点等ございましたら、随時作者様が描きやすいように変更して頂けると幸いです。\n\n要望が多くて恐縮ですが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/173xwne8qHeB_6uTRfAi5qp-IX2vD-Vsv", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@planetarium81/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3351996, "client_id": 272827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7318aea7e1b2e5b4bb5c9e8c8aa736", "srcset": "https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7318aea7e1b2e5b4bb5c9e8c8aa736, https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bac2bd583e3c68c672fa63c4d7c4cfa 2x, https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e665454db4aadf5f946eacb98385940 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56ce95c46aff4df84f7f67d5cc019b2e", "srcset": "https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56ce95c46aff4df84f7f67d5cc019b2e, https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=144d230d0e53f43597cb31e8580d0a37 2x, https://si.imgix.net/6313257f/uploads/origins/a180e5c7-32bc-4e4c-8a1e-b43ced3a90e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cfdf8bc8170797c35fd7a9f4321023b 3x"}, "body": "初めまして！作者様のくすぐり絵が好みで是非リクエストを送らせて頂ければ、と思いました…！！！\n\nキャラ\nソーシャルゲーム、魔法使いと黒猫のウィズに登場するアレイシア。\n\n衣装\nアプリで登場した衣装。くすぐりやすいようにする為、上着のパーカーと靴及び脚部の装備を外して裸足にして頂けると嬉しいです。（装飾が多いため、一部変更したり省略したりして頂いて大丈夫です！）\n\n内容\n作者様のマッドラヴのイビルツインのくすぐり絵がとても好みだったので、同じシチュで恐縮ですが、アレイシアがマッドラヴのマジックハンドにくすぐられる絵をお願いしたいです。\n\n拘束はリィラの時のようにマジックハンドで手首と足首を掴んで空中で拘束して頂きたいです。正面寄りのアングルだと尚嬉しいです。\n\nくすぐる部位については腋と脇腹、足の裏あたりを中心にくすぐってもらいたいです。可能であればキスキルの時のようにマッドラヴ本人がくすぐる描写も入れて頂きたいですが、構図的に難しい等ございましたら無しで大丈夫です。\n\n表情は両目を瞑って大笑いする差分を入れて頂けると嬉しいです。\nまた、台詞や擬音、背景については省略して頂いて大丈夫です。\n\nその他不明瞭な点等ございましたら、描きやすいように随時変更して頂ければ幸いです。\n要望が多くて恐縮ですが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/187I1bvCYpv40YvYL064AKsSJjjWG4QjG", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 55585, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "e10", "screen_name": "e10unko", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2Fe41c6dde-9502-4341-a3b5-90bc4945a11a.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/dfed73df-6e70-4097-a9cc-6359b5ee906e.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 32}, {"id": 913615, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あまえびい＠skebとpixivリクエスト→募集中", "screen_name": "amaebii_93", "avatar_url": "https://pbs.twimg.com/profile_images/1108174619658248194/fN8hUiQt.pn