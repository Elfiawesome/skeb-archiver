ありますので、併せてご確認いただけますと幸いです。\n\nポケモンの世界観における大まかな設定は以下の通りです：\n赤髪のキャラは幼い頃から伝説のポケモンに挑戦することを志すトレーナーで、\n黒髪のキャラは神話に関わる「神の代弁者」として、神獣を導く／従える謎めいた存在です。\n\n画像は個人使用のみを目的としています。自由に描いていただければ嬉しいです！\nご検討のほどよろしくお願いいたします！\nもし金額が希望に添えない場合調整していただけたら幸いです。よろしくお願いします\nURL にはさらに多くの設定があります。\n\n参考URL\nhttps://drive.google.com/drive/folders/1el1jVVTM704y9605naigdqWldX3SNtKl?usp=sharing\n\nhttps://drive.google.com/drive/folders/1el1jVVTM704y9605naigdqWldX3SNtKl?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@950magi618/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3584333, "client_id": 2757115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb3fd2a4/uploads/origins/5ca65549-9002-4a82-bbef-5fb5fe281f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e87bc3aef3c727f80b5aafb9150f36ef", "srcset": "https://si.imgix.net/cb3fd2a4/uploads/origins/5ca65549-9002-4a82-bbef-5fb5fe281f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e87bc3aef3c727f80b5aafb9150f36ef, https://si.imgix.net/cb3fd2a4/uploads/origins/5ca65549-9002-4a82-bbef-5fb5fe281f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eb68f130f37314bbb07b059130f073b 2x, https://si.imgix.net/cb3fd2a4/uploads/origins/5ca65549-9002-4a82-bbef-5fb5fe281f84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0b8720f75f939d5f0e0fa423197c2dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb3fd2a4/uploads/origins/5ca65549-9002-4a82-bbef-5fb5fe281f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e403184f836d3f2dcc82deb9e4439c4", "srcset": "https://si.imgix.net/cb3fd2a4/uploads/origins/5ca65549-9002-4a82-bbef-5fb5fe281f84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20