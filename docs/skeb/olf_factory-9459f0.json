フの部分は、以下のいずれかから1つをお願い致します。\n●聖光の夢魔鏡を連想した手鏡\n(夢幻の夢魔鏡に出てくる鏡になります)\n●上記に加えて追加差分として、聖光の夢魔鏡の代わりに、白銀の城の狂時計のコウモリの部分のみのぬいぐるみに変更かつ、目は×マークまたはグルグルマーク\n\n以上、お手数をお掛けすることになると思われますが、よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@olf_factory/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1054947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbc0f119/uploads/origins/598391c4-4c23-420d-ac19-492e55307c91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6c02276ef7c6f2f024a10043cbeae47", "srcset": "https://si.imgix.net/dbc0f119/uploads/origins/598391c4-4c23-420d-ac19-492e55307c91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6c02276ef7c6f2f024a10043cbeae47, https://si.imgix.net/dbc0f119/uploads/origins/598391c4-4c23-420d-ac19-492e55307c91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=018fdbd7fbbb7ad9c53e69b536b9c350 2x, https://si.imgix.net/dbc0f119/uploads/origins/598391c4-4c23-420d-ac19-492e55307c91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bafb63d1d31dac97c1fdce78ed797590 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbc0f119/uploads/origins/598391c4-4c23-420d-ac19-492e55307c91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4fe3e21f2f2db7e7317ac3a56328098", "srcset": "https://si.imgix.net/dbc0f119/uploads/origins/598391c4-4c23-420d-ac19-492e55307c91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4fe3e21f2f2db7e7317ac3a56328098, https://si.imgix.net/dbc0f119/uploads/origins/598391c4-4c23-420d-ac19-492e55307c91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=202cf1d3264fcd3d91c231bf21396f69 2x, https://si.imgix.net/dbc0f119