97783c6-c0f4-437f-a417-0a8cb94f3d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd7d61f4dd9688892e59490729220207, https://si.imgix.net/f51ed150/uploads/origins/097783c6-c0f4-437f-a417-0a8cb94f3d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f9fd01e29f249c50c03f1d409e39277 2x, https://si.imgix.net/f51ed150/uploads/origins/097783c6-c0f4-437f-a417-0a8cb94f3d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c961b445128b29403812c5b4cb33e2ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f51ed150/uploads/origins/097783c6-c0f4-437f-a417-0a8cb94f3d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4625755796451915363009d5e4a2867", "srcset": "https://si.imgix.net/f51ed150/uploads/origins/097783c6-c0f4-437f-a417-0a8cb94f3d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4625755796451915363009d5e4a2867, https://si.imgix.net/f51ed150/uploads/origins/097783c6-c0f4-437f-a417-0a8cb94f3d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8c4e74cf50faaa04cbbd04bf3c37724 2x, https://si.imgix.net/f51ed150/uploads/origins/097783c6-c0f4-437f-a417-0a8cb94f3d7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4270774b6d3b4e58699aafd17b6d435f 3x"}, "body": "いつもお世話になっております。\nこの度、リクエストをさせていただきます。\n\n速攻魔法「凍てつく呪いの神碑」をお願い致します。\n\n登場人物は以下の4体を想定しております。\n●弓を引いてるプレイヤー\n●「神碑の翼フギン」\n●「神碑の翼ムニン」\n●ぬいぐるみっぽくかわいらしくデフォルメされた「スクラップ・フローズン・ドラゴン」\n※空想上のカードになります。詳細は下記の内容をご確認いただけるとありがたいです。\n\n(デフォルメ度合いは以前作製してくださった「クロシープ」の「夢魔鏡の天魔ネイロス」あたりを想定しております)\n\nシチュエーションと致しましては、\n●凍てつく呪いを帯びた矢によって「スクラップ・ドラゴン」が呪われ、巨大な竜がみるみる小さくなって退治できたと思いきや、すんでのところで凍りの呪いを一部取り込んで襲いかかってくる「スクラップ・フローズン・ドラゴン」\n(愛くるしいけど暴れん坊になってちょっと手が付けられなくなってしまっている状態であるととてもありがたいです)\n●『聞いてた話と違うよぉ〜』と涙して飛ぶ「神碑の翼ムニン」\n(本家の凍てつく呪いの神碑に従った形を想定しております)\n●『悔しいけど、ここは一度撤退しますわよ！』と言ってそうな「神碑の翼フギン」\n(本家の凍てつく呪いの神碑に従った形を想定しております)\n●予想外の展開にちょっと焦っている弓持つプレイヤーの手\n\n背景はお任せ致します。\nまた、呪いの影響を受けながらも凍りの力を取り込んだ「スクラップ・フローズン・ドラゴン」は、主張しすぎない範囲で体に一部尖った氷柱が出ており、目が上記の「夢魔鏡の天魔ネイロス」の半月状の目であり、若干アホっぽくて子どもっぽく、キャッキャ的な要素がありますととてもありがたいです。\n\n以上、お手数をおかけしますが、御検討のほど、お願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@olf_factory/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b966d5f8/uploads/origins/b5705222-eff6-4752-a90f-bb6ebfa7b681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14c4c071ccbe824c6df7389c239e93ec", "srcset": "https://si.imgix.net/b966d5f8/uploads/origins/b5705222-eff6-4752-a90f-bb6ebfa7b681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=14c4c071ccbe824c6df7389c239e93ec, https://si.imgix.net/b966d5f8/uploads/origins/b5705222-eff6-4752-a90f-bb6ebfa7b681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=550760486d60e09a05df74f693e79523 2x, https://si.imgix.net/b966d5f8/uploads/origins/b5705222-eff6-4752-a90f-bb6ebfa7b681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=081c6878228742e8c3f52cab269e6433 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1054947, "client_id": 388044, "nc": 48}, {"path": "/@olf_factory/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1054947, "client_id": 2089126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff1a4231e96585b91ecf6166acab52a", "srcset": "https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff1a4231e96585b91ecf6166acab52a, https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d36775070608d41119c6b97aadce307 2x, https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d2b0f369d8eab09a16dbaa40dd1e59b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cca8d5ed84fb2ba35eed17b158c482c2", "srcset": "https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cca8d5ed84fb2ba35eed17b158c482c2, https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92104f83a15835ad89d65e0edf32c65b 2x, https://si.imgix.net/3d86d175/uploads/origins/55d5296f-07ea-4f0d-813a-982fbad050b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb766d050332efa338e57b697e54d54 3x"}, "body": "いつもお世話になっております。\nこの度、リクエストをさせていただきます。\n\n※おそらくR-18指定になります\n\n以下の要件を織り込んだ、「原罪のディアベルゼ」版の「禁じられた聖槍」をお願い致します。\n\n・「失落の聖女」を「原罪のディアベルゼ」(大人ver.)に変更\n・槍はシリコン製の林檎(直径2〜5cm)が5〜6個ほど連なったアナルビーズに変更(奥に行くほど大きくなる設定であるとありがたいです)\n・林檎の芯や葉は裂傷の危険性がありますので、あくまでも果実の球体部分のみの再現でお願い致します。\n・本家「禁じられた聖槍」とほぼ同様のポーズ(槍という名のアナルビーズは両手で持っている設定でお願い致します)\n・使ったらダメなのは分かっているのに使ってみたさや好奇心が主張してドキドキしている「原罪のディアベルゼ」(これ使ったらどうなっちゃうんだろう…？感が出ているとありがたいです)\n・槍はまだ使われていない状態(従って、NSFWで設定してますが、手に持っている槍以外の部分は全年齢対象向けになっているとありがたいです)\n\n以上、センシティブな内容で申し訳ございませんが、ご検討のほどよろしくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@olf_factory/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3f6589a8/uploads/origins/e3668655-143f-445e-8c1a-af881b52b29f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a423044946c9057ea777497d1d47769", "srcset": "https://si.imgix.net/3f6589a8/uploads/origins/e3668655-143f-445e-8c1a-af881b52b29f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a423044946c9057ea777497d1d47769, https://si.imgix.net/3f6589a8/uploads/origins/e3668655-143f-445e-8c1a-af881b52b29f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8950fc51297f58f31c88ac6a64d0e34a 2x, https://si.imgix.net/3f6589a8/uploads/origins/e3668655-143f-445e-8c1a-af881b52b29f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69813ce582af16456032ad146ef80f5a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1054947, "client_id": 501375, "nc": 176}, {"path": "/@olf_factory/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1054947, "client_id": 2089126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ea3e5981dd517d3147b47911182b8e", "srcset": "https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75ea3e5981dd517d3147b47911182b8e, https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ded689d14938c0668553d758f48cb8f4 2x, https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d551843576bf74fb75eb872cd545fbe3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1410051c343cc804cda9bfdd6c16b68", "srcset": "https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1410051c343cc804cda9bfdd6c16b68, https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80407d54e13f8133cf2145951a9993fe 2x, https://si.imgix.net/bb1c2d9a/uploads/origins/e1dc5717-a2e4-4804-b16d-697265653c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56f7b3b14c06db17020353c481a7e6f2 3x"}, "body": "いつもお世話になっております。\nこの度、新たに依頼させていただきます。\n\n「夢魔鏡の天魔ネイロス」の幻影の方を向いて、目を開けた状態で大粒の涙をぼろぼろ流しながら慌てて手持ちのマッチを全て燃やしている「夢魔鏡の使徒ネイロイ」をお願いできますでしょうか？\n※モチーフはマッチ売りの少女のワンシーンを想定しております。\n\n登場人物は以下の3体を想定しております。\n・「夢魔鏡の使徒ネイロイ」\n・優しそうな表情をした「夢魔鏡の天魔ネイロス」の幻影\n・「共命の翼ガルーラ」のシルエット\n\nイメージといたしましては、モチーフとなるマッチ売りの少女にある程度従う形であるとありがたいです。\n\n極限の状態を連想させるちょっと暗めな背景と、唯一の頼りのネイロス様が、このマッチの灯とともに消えてしまうなんて、イヤ、だから、消えないで…！！という感じの悲痛が伝わるような感じのシーンを想定しております。\n\nまた、モチーフ通りに行きますと、そのまま死魂(ネクロ)になることから、ネイロスの幻影の後ろ側に、「夢魔鏡の使徒ネイロイ」と「夢魔鏡の天魔ネイロス」で死魂融合できる「共命の翼ガルーラ」が主張し過ぎない範囲で背後にシルエットで映っているとありがたいです。\n\n各キャラクターの装飾や配置は上記の条件をある程度満たしていれば自由にお任せしたいと思っております。\n\n以上、センシティブな内容になってしまい、大変申し訳ございませんが、ご検討の程、よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@olf_factory/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1054947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceaf9a7e/uploads/origins/cb54a1e9-cd10-4915-a4fe-4dafc9659926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a7030cf9080151c83e4043d21b0a950", "srcset": "https://si.imgix.net/ceaf9a7e/uploads/origins/cb54a1e9-cd10-4915-a4fe-4dafc9659926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a7030cf9080151c83e4043d21b0a950, https://si.imgix.net/ceaf9a7e/uploads/origins/cb54a1e9-cd10-4915-a4fe-4dafc9659926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5966f883e01c33b1ab01543ae0601301 2x, https://si.imgix.net/ceaf9a7e/uploads/origins/cb54a1e9-cd10-4915-a4fe-4dafc9659926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf3cb9e54a882491ff8fc197523d8e7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceaf9a7e/uploads/origins/cb54a1e9-cd10-4915-a4fe-4dafc9659926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aec4d31b0480ac270625b077051ef263", "srcset": "https://si.imgix.net/ceaf9a7e/uploads/origins/cb54a1e9-cd10-4915-a4fe-4dafc9659926?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aec4d31b0480ac270625b077051ef263, https://si.imgix.net/ceaf9a7e/uploads/origins/cb54a1e9-cd10-4915-a4fe-4dafc9659926?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18c4e12cdcc615eec01d4ca8df2386db 2x, https://si.im