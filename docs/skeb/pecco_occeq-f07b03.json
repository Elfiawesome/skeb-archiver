\u3001\u5185\u5074\u304c\u30d4\u30f3\u30af\u8272\u3092\u3057\u305f\u4eba\u9593\u578b\u306e\u81a3\u3068\u3001\u80a1\u9593\u306b\u4f4d\u7f6e\u3059\u308b\u3001\u6bdb\u306b\u8986\u308f\u308c\u305f\u4eba\u9593\u306e\u3088\u3046\u306a\u4e73\u623f\uff08\u30d4\u30f3\u30af\u8272\u306e\u4e73\u9996\u4ed8\u304d\uff09\u3092\u6301\u305f\u305b\u3066\u304f\u3060\u3055\u3044\u3002\u307e\u305f\u3001\u767d\u76ee\u304c\u767d\u304f\u77b3\u304c\u8336\u8272\u3044\u4eba\u9593\u98a8\u306e\u76ee\u3068\u3001\u982d\u306e\u4e0a\u306b\u9ec4\u8272\u3044\u30ec\u30f3\u30ba\u306e\u30b5\u30f3\u30b0\u30e9\u30b9\u3092\u8eab\u306b\u3064\u3051\u3066\u3044\u308b\u69d8\u5b50\u3092\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\uff08#9 + #10\uff09\u3002\n\n\u5404\u30d0\u30fc\u30b8\u30e7\u30f3\u306e\u8a73\u7d30\uff1a\n\n1. \u30b8\u30e3\u30ad\u304c\u4ef0\u5411\u3051\u306b\u306a\u308a\u3001\u6065\u305a\u304b\u3057\u3055\u3068\u843d\u80c6\u306e\u5165\u308a\u6df7\u3058\u3063\u305f\u8868\u60c5\u3092\u6d6e\u304b\u3079\u3066\u3044\u307e\u3059\u3002\u9996\u306b\u306f2\u4f4d\u306e\u8cde\u30ea\u30dc\u30f3\u304c\u639b\u3051\u3089\u308c\u3066\u304a\u308a\u3001\u4e00\u4eba\u79f0\u8996\u70b9\uff08\u753b\u9762\u624b\u524d\u5074\uff09\u304b\u3089\u4f38\u3073\u308b\u5439\u304d\u51fa\u3057\u306e\u4e2d\u306b\u300c(#11)\u300d\u3068\u3044\u3046\u30c6\u30ad\u30b9\u30c8\u304c\u5165\u308a\u307e\u3059\u3002\n\n2. \u5de8\u5927\u306a\u99ac\u306e\u30da\u30cb\u30b9\u304c\u5f7c\u5973\u306b\u8feb\u308a\u6765\u308b\u4e2d\u3001\u30b8\u30e3\u30ad\u306f\u6065\u3058\u3089\u3044\u3068\u56f0\u60d1\u306e\u8868\u60c5\u3092\u6d6e\u304b\u3079\u3066\u3044\u307e\u3059\u3002\n\n3. \u30b8\u30e3\u30ad\u306e\u8179\u90e8\u306f\u7cbe\u6db2\u3067\u5927\u304d\u304f\u81a8\u308c\u4e0a\u304c\u308a\u3001\u99ac\u306e\u30da\u30cb\u30b9\u306b\u5185\u5074\u3092\u6fc0\u3057\u304f\u5e83\u3052\u3089\u308c\u306a\u304c\u3089\u3001\u6065\u8fb1\u3068\u6297\u3044\u304c\u305f\u3044\u5feb\u611f\u306b\u5598\u3044\u3067\u3044\u307e\u3059\u3002\n\n4. \u30b8\u30e3\u30ad\u306e\u80a1\u9593\u306e\u4e73\u623f\u306f\u3055\u3089\u306b\u80a5\u5927\u5316\u3057\u3066\u304a\u308a\u3001\u5f7c\u5973\u306f\u75b2\u308c\u3068\u6065\u305a\u304b\u3057\u3055\u306b\u6e80\u3061\u305f\u8868\u60c5\u3067\u3001\u3042\u306e\u99ac\u306e\u30da\u30cb\u30b9\u3088\u308a\u3082\u3055\u3089\u306b\u5de8\u5927\u306a\u300c\u30dd\u30b1\u30e2\u30f3\u306e\u30bf\u30de\u30b4\u300d\u3092\u7523\u307f\u843d\u3068\u3057\u3066\u3044\u307e\u3059\u3002\u753b\u9762\u624b\u524d\u306b\u306f\u3001\u4eba\u9593\u306e\u624b\u304c\u6301\u3063\u305f\u7279\u6b8a\u306a\u30e2\u30f3\u30b9\u30bf\u30fc\u30dc\u30fc\u30eb\u304c\u63cf\u304b\u308c\u3066\u3044\u307e\u3059\u3002(\uff0312)\n\n5. \u30b8\u30e3\u30ad\u306e\u982d\u4e0a\u3067\u30e2\u30f3\u30b9\u30bf\u30fc\u30dc\u30fc\u30eb\u304c\u958b\u304d\u3001\u5f7c\u5973\u3092\u8d64\u3044\u5149\u304c\u5305\u307f\u8fbc\u307f\u307e\u3059\u3002\u30b8\u30e3\u30ad\u306f\u75b2\u308c\u679c\u3066\u3001\u7d76\u671b\u3057\u305f\u3088\u3046\u306a\u8868\u60c5\u3067\u305d\u306e\u30dc\u30fc\u30eb\u3092\u898b\u4e0a\u3052\u3066\u3044\u307e\u3059\u3002\u5f7c\u5973\u306e\u5468\u56f2\u306e\u5730\u9762\u306b\u306f\u3001\u8907\u6570\u306e\u30bf\u30de\u30b4\u304c\u8ee2\u304c\u3063\u3066\u3044\u307e\u3059\u3002\n\n6. \u5730\u9762\u306b\u7f6e\u304b\u308c\u305f\u30e2\u30f3\u30b9\u30bf\u30fc\u30dc\u30fc\u30eb\u304b\u3089\u661f\u5c51\u304c\u3053\u307c\u308c\u51fa\u3057\u3001\u62e1\u5927\u63cf\u5199\u306e\u5439\u304d\u51fa\u3057\u306e\u4e2d\u306b\u3001\u30dc\u30fc\u30eb\u5185\u90e8\u306b\u53ce\u5bb9\u3055\u308c\u305f\u30b8\u30e3\u30ad\u306e\u59ff\u304c\u6620\u3057\u51fa\u3055\u308c\u307e\u3059\u3002\u5f7c\u5973\u306e\u53e3\u5143\u304b\u3089\u306f\u71b1\u3044\u5410\u606f\u304c\u6f0f\u308c\u3001\u30dc\u30fc\u30eb\u306e\u4f5c\u7528\u306b\u3088\u3063\u3066\u5f37\u5236\u7684\u306b\u767a\u60c5\u72b6\u614b\u3078\u3068\u6df1\u304f\u8ffd\u3044\u8fbc\u307e\u308c\u3066\u3044\u308b\u3053\u3068\u306b\u5bfe\u3057\u3001\u6065\u8fb1\u306b\u6b6a\u3093\u3060\u8868\u60c5\u3092\u6d6e\u304b\u3079\u3066\u3044\u307e