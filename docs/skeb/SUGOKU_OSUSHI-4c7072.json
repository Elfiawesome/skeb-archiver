0-4238-8e22-ffb0152f12f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c17b77116e9ac86f821b891b2fd471", "srcset": "https://si.imgix.net/45c4f415/uploads/origins/a5f2249a-2d00-4238-8e22-ffb0152f12f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83c17b77116e9ac86f821b891b2fd471, https://si.imgix.net/45c4f415/uploads/origins/a5f2249a-2d00-4238-8e22-ffb0152f12f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1b46b212aab690e7beb81bb1c3f87b4 2x, https://si.imgix.net/45c4f415/uploads/origins/a5f2249a-2d00-4238-8e22-ffb0152f12f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d32b4e83d9174dd5b13cc02e745a291d 3x"}, "body": "いつもお世話になっております。今回は先日はまちさんにKPをしていただいたCoC『片鱗』で作成したキャラクターのイラストをお願いしたく、リクエストさせていただきます。\n私が作成したHO殺人鬼と同卓PLさんが作成してくださったHO高校生の二人のデフォルメイラストで、セッションを通じて親密になっていったあとの二人の距離感で寄り添っているようなものだと嬉しいです。\nはまちさんの描かれるキュートでころんとしたデフォルメイラストがかわいらしくて大好きなので、本編の最後には別れることになってしまった二人のifとして明るく楽しい雰囲気の二人が見られたら幸いです。\nイラストの資料については、元々の立ち絵が私の描いたものではないため、セッション時に提出したものを参考にしていただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@wanwanwan_trpg/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2347440, "client_id": 2976959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9861680474edf0fe9716d9fdaca5819b", "srcset": "https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9861680474edf0fe9716d9fdaca5819b, https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89090427168f2080b12f2fb5fba456fb 2x, https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7562231eaa9449eab3eaa80687868c0f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b31ebbbb90b5554deaac6abf027fdef", "srcset": "https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b31ebbbb90b5554deaac6abf027fdef, https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=138a52908a5917eca0d93ddcd3216fa5 2x, https://si.imgix.net/9777a923/uploads/origins/06c330e0-6668-4c40-ab18-06466ece14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75679a81be9c04f11d462fccec656b87 3x"}, "body": "お世話になっております！\n鮮やかで美しいわんさんのイラストが大好きです……！\n\n今回は、ロトあだ自陣(樫屋依澄、天久匠清)のイラスト「2枚」を依頼させていただきたく、リクエストをさせていただいております！\n主な使用用途は、個人鑑賞、SNS上での使用の予定です。\n\n\n【1枚目】\n・服装指定：\nスーツと和服(資料1)\n\n・テーマ、雰囲気：\nロトあだ当時の空気感(犬猿、喧嘩腰)\nKPしていただいたわんさんから見た、セッション当時の2人のイメージ\n→難しければ印象に残ったやりとりやシーンの抜粋等でも……！\n\n\n【2枚目】\n・服装指定：\n私服(資料2)\n指輪、ピアス、ネックレス着用(資料3)\n※依澄の眉ピアス(ゴールド)は常に着用しています。1枚目でも着けていただきたいです。\n\n・テーマ、雰囲気：\nロトあだ通過後交際しているふたりの空気感。\n依澄：悔しげ・絆され/匠清：からかい・嬉しげ(表情：資料4)\n→からかったり甘えたり、猫のように気ままに振る舞う匠清と、それに振り回されて悔しがりながら嬉しい、愛おしいと思う依澄…というのが最近のいつもの空気です！\n\n\n2枚で距離感の変化がわかる構図だと嬉しいですが、細かい指定はございません！わんさんの描かれるイラストの雰囲気が好きなので、基本的にはお任せしたいです……！\n\n金額が足りない場合や、内容が難しい場合には、お気兼ねなく再送もしくはキャンセル等していただきたく思います！\n\n見守っていただいたロトあだから始まり、楽しく継続で遊ぶことが出来ています！\nわんさんのイラストで自陣を見られたらとっても嬉しいです！ご検討よろしくお願いいたします……！\n\nhttps://drive.google.com/drive/folders/1txCNkP51phbzB7QqJYbXGyThPQ3DCfTL?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2474, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "少年Ｆ", "screen_name": "r_hagyo", "avatar_url": "https://pbs.twimg.com/profile_images/688428607987777536/IFyrHEJe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3319996117/1686133067/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 8}, {"id": 2669453, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "もず", "screen_name": "0141831mz", "avatar_url": "https://pbs.twimg.com/profile_images/1810622986984333312/NCg273Xk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1566039448587931648/1743678779/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 3373752, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "𝙋𝙚𝙮𝙪", "screen_name": "Peyu_1f", "avatar_url": "https://pbs.twimg.com/profile_images/1961427133764702208/0jRELc2M.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1750721227432550400/1764560304/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 3700332, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ナノダワ低浮上", "screen_name": "nanodawa_", "avatar_url": "htt