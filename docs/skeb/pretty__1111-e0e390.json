loads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=955e858ffb7c2d88c557a29347cb3c32", "srcset": "https://si.imgix.net/1e1e6acc/uploads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=955e858ffb7c2d88c557a29347cb3c32, https://si.imgix.net/1e1e6acc/uploads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a338e15ac60977079befbb909f9cbc45 2x, https://si.imgix.net/1e1e6acc/uploads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54e05e80f39c7494e598a0867375cc71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e1e6acc/uploads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd91fb45966d1d37e614c938f8382fbe", "srcset": "https://si.imgix.net/1e1e6acc/uploads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd91fb45966d1d37e614c938f8382fbe, https://si.imgix.net/1e1e6acc/uploads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf9459a3c415ef61432098610fba7da0 2x, https://si.imgix.net/1e1e6acc/uploads/origins/67dc7c8f-006c-45d2-81ce-b71efc26434e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e30056c4c2e11196cd4743f56657c4f8 3x"}, "body": "It is nice to meet you. I saw your illustration on X and heard that you were accepting requests here, so I decided to contact you.\n  My character's birthday is coming up, so I would appreciate it if you could draw an illustration of my character for her birthday celebration.\nI plan to use it to make an acrylic stand.\n\n  Beauty (face type), fluffy twintails, princess cut (bangs), hoso mesh (mesh type) black cat (hair color), berry berry pink (mesh), A (skin color), dark red lips, Koisuru chocolat (eye color), apple jam ( eyeshadow), Akarame Apple (blush), Dark Bright Ring (earrings), Flare Nails for Little Devil Gal\u21fdPrimajig used in this character.\n\n This is my character used in Type G, semi-long, midnight black (hair color), light beige (skin color), strong-minded cool girl with sexy lip and eternal rouge (eye color) \u21fdPurichang.\n\n I would like these two to look like they are attached to each other in a friendly way, please. (It's like the girl from Primaji loves the girl from Pritchan, so I'd be happy if you could take a little of that as well)\n\nThe girl in Primaji is 165cm and the girl in Pritchan is 157cm, so it would be great if you could give us a little height difference between the two.\n\n  The girl in the Pre-Christmas dress is in Pure Nest Wedding Black, and the girl in the Pre-Maj dress is in Black Diamond. I would like the Primagi girl to wear the Black Diamond Prince Cordage.\n\n\u2193\u2193\u2193 I hope this helps. https://x.com/yungi_mazi/status/1670380268530843648?s=46&t=sZTnKtnXu7avy5HIDObxDg https://x.com/jyhrjtg7/status/1453658560500408322 ?s=46&t=sZTnKtnXu7avy5HIDObxDg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pretty__1111/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1757863, "client_id": 1686009, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92473631/uploads/origins/ca96561e-ae79-4118-9bdf-a3eea1b55e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=128dbcc320998bb5e8f5433b71e1e8f2", "srcset": "https://si.imgix.net/92473631/uploads/origins/ca96561e-ae79-4118-9bdf-a3eea1b55e80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=128dbc