そうな様子を見ていると逆らえない\nくちべた\nデレる時はストレートに愛の言葉をぶつけたりするタイプ(ズルい:彼女さん談)\n自分の呼び方は「俺」・彼女の呼び方は「〇〇さん」「あなた」・彼女には敬語\n\n以下は他の方に描いていただいたものですが、\n二人の見た目・関係性の参考までにどうぞ\n\nhttps://skeb.jp/@heiantomato/works/12\nhttps://skeb.jp/@heiantomato/works/50\nhttps://skeb.jp/@heiantomato/works/100\nhttps://skeb.jp/@heiantomato/works/130\nhttps://skeb.jp/@ororooooooops/works/74\nhttps://skeb.jp/@ororooooooops/works/87\nhttps://skeb.jp/@ororooooooops/works/105", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 65646, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "四季野ゆき", "screen_name": "sikinoyuki", "avatar_url": "https://pbs.twimg.com/profile_images/1683762443909210113/yJtCbVYw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/715506673100558337/1690677309/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 115135, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "B@ΦWEBｵﾝﾘｰ→@PHI_VERSE", "screen_name": "bbnb330", "avatar_url": "https://pbs.twimg.com/profile_images/1628436844244516864/R7gvPqMd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2418583596/1741894739/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 33}, {"id": 159273, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "イチノセ奏", "screen_name": "kanade_cocotte", "avatar_url": "https://pbs.twimg.com/profile_images/1225470417063645184/P8_SiB0V.jpg", "header_url": "https://pbs.twimg.com/profile_banners/71243217/1647958329/