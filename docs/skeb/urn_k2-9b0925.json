ix.net/0a41b59e/uploads/origins/0a08cd71-b475-4b28-a820-8c74013e07a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff8eaf90477d4af661f49e0c37361d2d", "srcset": "https://si.imgix.net/0a41b59e/uploads/origins/0a08cd71-b475-4b28-a820-8c74013e07a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff8eaf90477d4af661f49e0c37361d2d, https://si.imgix.net/0a41b59e/uploads/origins/0a08cd71-b475-4b28-a820-8c74013e07a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a16dba1901ada26fd98ac92d328e8444 2x, https://si.imgix.net/0a41b59e/uploads/origins/0a08cd71-b475-4b28-a820-8c74013e07a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea4d374829fc59f216db3f0c3acf5a9c 3x"}, "body": "こんにちは！あなたの画風にすっかり魅了されてしまいました。ぜひまた、私のオリジナルキャラクターであるKILLとWillを描いていただけないでしょうか！\n\nKILL：80年代のアーケードゲームの最終ボスで、自己意識を獲得し、現実世界へ飛び出したいと切望している\n重要な特徴：頭上に赤いオーラをまとった王冠 / 目の下に回路のような模様 / グリッチ効果に包まれることがある\n\nWill：天才だがオタク気質のプログラマー。生まれつき感情に欠けています。彼は誤ってアーケードゲームからKILLを目覚めさせ、彼と「取引」をしました。\n\n詳細はすべてお任せしますので、自由に描いてください。ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1wIgshpt3GjCbI-YPqh3XurqfHM1QaxP6?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@urn_k2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3926499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a2c7027/uploads/origins/e160a070-09de-403f-b53f-338fc862aafb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38f6ef2b085a359b119b9feb88397ee1", "srcset": "https://si.imgix.net/0a2c7027/uploads/origins/e160a070-09de-403f-b53f-338fc862aafb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38f6ef2b085a359b119b9feb88397ee1, https://si.imgix.net/0a2c7027/uploads/origins/e160a070-09de-403f-b53f-338fc862aafb?bg=%23fff&auto=