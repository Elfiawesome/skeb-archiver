04a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\u305f\u3060\u3057\u3001\u30a2\u30ed\u30fc\u306f\u8fd1\u304f\u306b\u7f6e\u3044\u3066\u3044\u308b\u304b\u4f55\u51e6\u304b\u306b\u4ed5\u821e\u3063\u3066\u3044\u308b\u304b\u3067\u3001\u624b\u306b\u6240\u6301\u306f\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u307e\u305f\u3001\u8349\u5c65\u3082\u8131\u3044\u3067\u8db3\u888b\u306e\u307f\u306e\u72b6\u614b\u3067\u3059\u3002\n\n\u307e\u305f\u305a\u3093\u5b50\u5b22\u306e\u4ed6\u306b\u3001\u30e2\u30d6\u3068\u3057\u3066\uff12\u301c\uff13\u6b73\u304f\u3089\u3044\u306e\u5c0f\u3055\u306a\u5e7c\u5150\u3092\u7537\u5973\uff11\u4eba\u305a\u3064(\u8a08\uff12\u4eba)\u767b\u5834\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u5b58\u3058\u307e\u3059\u3002\n\n\u3010\u72b6\u6cc1\u3011\n\u753b\u9762\u304b\u3089\u898b\u3066\u3001\u305a\u3093\u5b50\u5b22\u9054\u306e\u524d\u9762(\u591a\u5c11\u659c\u3081\u306fOK)\u304c\u5206\u304b\u308b\u69cb\u56f3\u3002\n\u4f55\u304b\u306e\u4e8b\u60c5\u3067\u3001\u5e7c\u5150\u9054\u3092\u3057\u3070\u3089\u304f\u9810\u304b\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u305a\u3093\u5b50\u5b22\u3002\n\u5834\u6240\u306f\u4f55\u51e6\u304b\u306e\u5ba4\u5185\u3001\u548c\u6d0b\u306f\u554f\u3044\u307e\u305b\u3093\u3002\n\u305a\u3093\u5b50\u5b22\u306f\u3044\u308f\u3086\u308b\u300c\u307a\u305f\u3093\u5ea7\u308a\u300d\u3092\u3057\u3066\u3001\u5b50\u3089\u306e\u76f8\u624b\u3092\u3057\u3066\u3044\u307e\u3059\u3002\u5f7c\u5973\u306e\u8868\u60c5\u306f\u6148\u611b\u306b\u6e80\u3061\u3066\u7a4f\u3084\u304b(\u4e21\u76ee\u306f\u5fc3\u6301\u3061\u7d30\u3081\u3001\u53e3\u306f\u9589\u3058\u3066\u3044\u308b\u304b\u534a\u958b\u304d\u3067\u5fae\u7b11\u307f)\u3002\n\u5e7c\u5150\u306e\u3046\u3061\u3001\u5973\u306e\u5b50\u306f\u305a\u3093\u5b50\u5b22\u306e\u819d(\u3075\u3068\u3082\u3082)\u306e\u4e0a\u306b\u5ea7\u308a\u3001\u305a\u3093\u5b50\u5b22\u306b\u5411\u304b\u3044\u5408\u3063\u3066\u30ae\u30e5\u30c3\u3068(\u80f8\u304b\u3089\u304a\u8179\u306b\u304b\u3051\u3066)\u62b1\u304d\u3064\u304