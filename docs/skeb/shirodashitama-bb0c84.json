ery much!\n\nhttps://drive.google.com/drive/folders/1csSIQGAfJxnbTNpZr-ZlXhr6iwy4Z5Df\n\nhttps://drive.google.com/drive/folders/1csSIQGAfJxnbTNpZr-ZlXhr6iwy4Z5Df", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shirodashitama/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3426651, "client_id": 3480188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b474ebdd/uploads/origins/6c64052d-214d-4db9-94a5-a98038e638b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061b9d969b0bca2dc0e02e9c08947956", "srcset": "https://si.imgix.net/b474ebdd/uploads/origins/6c64052d-214d-4db9-94a5-a98038e638b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=061b9d969b0bca2dc0e02e9c08947956, https://si.imgix.net/b474ebdd/uploads/origins/6c64052d-214d-4db9-94a5-a98038e638b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=201f1b7d3eee8c09e999dbf0d7eac1b1 2x, https://si.imgix.net/b474ebdd/uploads/origins/6c64052d-214d-4db9-94a5-a98038e638b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac59172f768c3462adfbf4ebbf5519f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b474ebdd/uploads/origins/6c64052d-214d-4db9-94a5-a98038e638b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21793bedc39d8104ea1f18b4a4c76cde", "srcset": "https://si.imgix.net/b474ebdd/uploads/origins/6c64052d-214d-4db9-94a5-a98038e638b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21793bedc39d8104ea1f18b4a4c76cde, https://si.imgix.net/b474ebdd/uploads/origins/6c64052d-214d-4db9-94a5-a98038e638b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c576a7693e0196ace597e3120c019354 2x, https://si.imgix.net/b4