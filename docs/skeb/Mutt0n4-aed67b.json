24b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31f5cfd6ae90f27fa3dbb3ad4097906e, https://si.imgix.net/9e4f118d/uploads/origins/9fda8e1c-d686-42b2-819e-bf47b84524b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79d3a1fec8f44f37ba49f5746df9d310 2x, https://si.imgix.net/9e4f118d/uploads/origins/9fda8e1c-d686-42b2-819e-bf47b84524b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9520ef00090483551b25988c4292b784 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e4f118d/uploads/origins/9fda8e1c-d686-42b2-819e-bf47b84524b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a11721b0015402df7e49be87b672ea7f", "srcset": "https://si.imgix.net/9e4f118d/uploads/origins/9fda8e1c-d686-42b2-819e-bf47b84524b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a11721b0015402df7e49be87b672ea7f, https://si.imgix.net/9e4f118d/uploads/origins/9fda8e1c-d686-42b2-819e-bf47b84524b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3129e85cf078c9dbc8c4d2aec928d41 2x, https://si.imgix.net/9e4f118d/uploads/origins/9fda8e1c-d686-42b2-819e-bf47b84524b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b0275602a69a4d0e5cd26e76fe2e0d4 3x"}, "body": "マトンカレー様、はじめまして！\nTwitterでマトンカレー様のイラストを拝見し、この度はTRPGで遊んでいるうちよそのOCを、\nぜひマトンカレー様の世界観で描いていただきたくリクエストさせていただきます。\n\n▽関係\n自由奔放な探偵と苦労人の助手/両片想いの幼馴染\n\n▽キャラクター\n【玉木 奈胡/たまき なこ】\n・探偵\n・161cm、29歳\n・ローテンションでマイペースだが、粘り強くタフな性格\n・感性が独特で、趣味は石碑的なオブジェやゆるキャラなどの置物収集\n・事務所の経費で趣味のものを買うので鏡に叱られている（が、なんだかんだ許されている）\n・幼少期の鏡を探偵助手ごっこに巻き込んだ延長線で鏡を頼った\n・中高時代には鏡を異性として意識していた時期もあったが、関係性を壊したくなくて適度な距離感を保っている\n・鏡と恋仲になったら、関係が終わったとき幼馴染にも戻れないのではと思い恋愛に前向きでない\n・鏡にももっと自分のことを頼ってほしい\n\n【鏡 遙真/かがみ とうま】\n・助手\n・174cm、30歳\n・兼業助手。本業は弁護士\n・主に経理や契約関係を請け負っているはずが、調査にも駆り出されている\n・外面は穏やかだが、気を許している玉木相手には自然体で軽口が多い\n・自分がエリートであることを自覚していて尊大\n・他人に弱みを見せたくない。玉木には猶更\n・幼少期に家族を亡くしており、玉木家にサポートしてもらったため一家に感謝している\n・玉木が恋愛関係を望んでいなさそうであるため、自分が恋情を抱いていることに罪悪感がある\n\n▽その他\n・付き合いが長くお互い無意識的に距離が近い\n\nファッションはデフォルトのものでも自由に描いてくださっても構いません。\nいただいたイラストは個人利用のほか、友人間でのデータ共有、\nまた一部をトリミングしてオンラインでTRPGにて遊ぶ際に、装飾として利用させていただくことがございます。\nもし可能でしたら、人物ファイルを別に納品いただけますと幸いです。\n（psdファイルの納品でも問題ございません。）\n金額に不足がありましたら再送依頼をお送りください。\nご縁がありましたらとても嬉しいです、どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/18cNX2jB5OmP6t4tfug0D37SE8Do95oWh", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Mutt0n4/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/322ad950/uploads/origins/e78d27d1-e5a9-4908-8d14-c8d5787558f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56cea2a5a7fbcb97a453602c99ab3dcd", "srcset": "https://si.imgix.net/322ad950/uploads/origins/e78d27d1-e5a9-4908-8d14-c8d5787558f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56cea2a5a7fbcb97a453602c99ab3dcd, https://si.imgix.net/322ad950/uploads/origins/e78d27d1-e5a9-4908-8d14-c8d5787558f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dee5e6d0f38f32fb683016fd75396a23 2x, https://si.imgix.net/322ad950/uploads/origins/e78d27d1-e5a9-4908-8d14-c8d5787558f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=243c278f64445b0c54e5626ae4480e6f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3676643, "client_id": 2844109, "nc": 177}, {"path": "/@Mutt0n4/works/58", "private_thumbnail_image_urls": {"src": "http