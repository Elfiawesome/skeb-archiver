】\nお顔アップ～バストアップ\n\n【構図】\n口元に手を当てて(片手)、息をふぅ～っと吹いている様子をお願いしたいです。\n(もし可能でしたら、手差分として耳かき棒を持っている手もあるととても嬉しいです…!)\n\n【服装】\n共有したドライブ内にあるルームウエアでお願いいたします。\n\n【髪型】\n3種ありますがどれでもお好きなものを描いて頂けますと幸いです。\n\n【表情差分】\n・微笑み（開口）\n・ぺろっと舌を出していたずらな笑みを浮かべている\nの【2種】を可能でしたらお願いしたいです。\n\n【背景】\nこちらはお任せいたします。\n━━━━━━━━━━━━━━━━━\n\n最後まで読んでいただきありがとうございました...!\n以上、長くなりましたが詳細になります。\n\nお忙しい中恐縮ですが、ご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gbJ7ut5QmKqYNevFg2nG39qnVkSUErPr?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8043, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "まゆり会長", "screen_name": "mayurikaichou", "avatar_url": "https://pbs.twimg.com/profile_images/1678397717104435203/jo-yD9MW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3036853365/1775882377/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 1314842, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ʚ ソフィ ɞ", "screen_name": "soppppphie_", "avatar_url": "https://pbs.twimg.com/profile_images/1990389561453957120/txI2z1sp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1171704500/1638932890/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1825019, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とのじ", "screen_name": "TOTOTOTO_TK", "avatar_url": "https://pbs.twimg.com/profile_images/2035836851207163904/ujGU9y_F.png", "header