眉 口が小さめ \n指先に薄いピンクのネイル 髪の毛は毛先がグラデーション\n衣装などはデフォルトでも描きやすいようにオリジナルなものでも大丈夫です！\n\n\n\nお忙しいとは存じておりますが、是非描いていただけたらとってもとっても嬉しいです…！\nまた金額が足りない場合は遠慮なく再送リクエストを送っていただければと思います。\n\nご検討よろしくお願いいたします💜⋆͛\n\nhttps://drive.google.com/drive/folders/18Yq9DquKWQdw4WvmoLN4rbGhISEb64oA?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abs5287/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 686926, "client_id": 2915958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0d62c73/uploads/origins/e8056c73-21dd-4eb7-8a7b-b79e59673971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df1c7e57a4079ca0bef5da87dcef031e", "srcset": "https://si.imgix.net/b0d62c73/uploads/origins/e8056c73-21dd-4eb7-8a7b-b79e59673971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df1c7e57a4079ca0bef5da87dcef031e, https://si.imgix.net/b0d62c73/uploads/origins/e8056c73-21dd-4eb7-8a7b-b79e59673971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57d6afaf825b6391ea3beb64f075e227 2x, https://si.imgix.net/b0d62c73/uploads/origins/e8056c73-21dd-4eb7-8a7b-b79e59673971?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b388108cd1492759d5a15aed62b568d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0d62c73/uploads/origins/e8056c73-21dd-4eb7-8a7b-b79e59673971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccfaa286a436cb04335f122121109ffc", "srcset": "https://si.imgix.net/b0d62c73/uploads/origins/e8056c73-21dd-4eb7-8a7b-b79e59673971?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccfaa286a436cb04335f122121109ffc, https://si.imgix.net/b0d62c73/uploads/origins/e8056c73-21dd-4eb7-8a7b-b79e59673971?bg=%23fff&auto=format%2Ccompress&fm=web