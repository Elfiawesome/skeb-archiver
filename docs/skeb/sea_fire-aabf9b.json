044\u3064\u3082\u304a\u4e16\u8a71\u306b\u306a\u3063\u3066\u304a\u308a\u307e\u3059\u3002\u3042\u308b\u3081\u3067\u3059\u3002\n\u7528\u767d\u3055\u3093\u306e\u7dda\u904b\u3073\u3084\u8272\u5f69\u304c\u3068\u3063\u3066\u3082\u597d\u304d\u3067\u3001\u3044\u3064\u3082\u697d\u3057\u304f\u30a4\u30e9\u30b9\u30c8\u62dd\u898b\u3055\u305b\u3066\u3044\u305f\u3060\u3044\u3066\u304a\u308a\u307e\u3059\uff01\u4eca\u56de\u306f\u305d\u3093\u306a\u7528\u767d\u3055\u3093\u306e\u7d75\u67c4\u3067\u662f\u975e\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u601d\u3044\u5165\u308c\u306e\u3042\u308b\u3046\u3061\u3088\u305d\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u601d\u3044\u307e\u3059\u3002\n\n\u8cc7\u6599\u306fGoogle\u30c9\u30e9\u30a4\u30d6\u306e\u65b9\u306b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u500b\u4eba\u306e\u30c7\u30b6\u30a4\u30f3\u3092\u5165\u308c\u3001URL\u6dfb\u4ed8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\u30a4\u30e9\u30b9\u30c8\u304b\u3089\u306f\u308f\u304b\u3089\u306a\u3044\u8a73\u7d30\u306a\u8a2d\u5b9a\u306f\u4ee5\u4e0b\u3067\u3059(\u3054\u53c2\u8003\u307e\u3067\u306b\uff01)\n\u30ab\u30c3\u30d7\u30ea\u30f3\u30b0\u3068\u3057\u3066\u306f\u300c\u9152\u3005\u4e95\u5dba\u00d7\u9727\u751f\u9759\u82b1\u300d\u3002\u8868\u73fe\u3068\u3057\u3066\u306f\u300c\u9152\u82b1\u300d\u3002\n\u30fb\u9152\u3005\u4e95\u5dba\n\u2514\u5211\u4e8b\u3002\u9759\u82b1\u306e\u4e3b\u4eba\u517c\u604b\u4eba\u3002\u60c5\u306b\u539a\u304f\u5bb6\u65cf\u3084\u53cb\u9054\u306a\u3069\u5468\u308a\u306e\u4eba\u9593\u3092\u5927\u4e8b\u306b\u3057\u3066\u3044\u308b\u3002\u8eab\u9577180cm\u3002\n\u30fb\u9727\u751f\u9759\u82b1\n\u2514\u5143\u61b2\u5175\u3002\u9152\u3005\u4e95\u306e\u5f93\u8005\u517c\u604b\u4eba\u3002\u57fa\u672c\u7684\u306b\u30c9\u30e9\u30a4\u3060\u304c\u60c5\u3082\u3042\u308b\u3002\u8eab\u9577202cm\u3002\n\n\n\u30ea\u30af\u30a8\u30b9\u30c8\u3059\u308b\u306b\u3042\u305f\u3063\u3066\u306e\u69cb\u56f3\u306e\u5e0c\u