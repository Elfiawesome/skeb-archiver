ルにしてもらえると嬉しいです。\n\nたくさん書いて、たくさんリクエストしてごめんなさい。実はSkebの依頼をするのは初めてなので、値段など間違っていたら申し訳ありません。\n\nご検討のほど、よろしくお願いいたします。\n\nAStraightUpG\n\n\"海はエロい！\"", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kuhuku006/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/77a08fcd/uploads/origins/78ee9422-93ff-43ee-9dc9-a11bf3488e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e46d6099ecdbe2730567abf0fc5700c", "srcset": "https://si.imgix.net/77a08fcd/uploads/origins/78ee9422-93ff-43ee-9dc9-a11bf3488e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e46d6099ecdbe2730567abf0fc5700c, https://si.imgix.net/77a08fcd/uploads/origins/78ee9422-93ff-43ee-9dc9-a11bf3488e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0dc4dac4b4b5b777bee1068f7ceb94b2 2x, https://si.imgix.net/77a08fcd/uploads/origins/78ee9422-93ff-43ee-9dc9-a11bf3488e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7077b2d1d84e1526c9649bd372bdd88d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 420073, "nc": 176}, {"path": "/@kuhuku006/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 420073, "client_id": 257349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92cd6cd5/uploads/origins/927e70cc-3c58-4074-afca-c473b53610e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c73d5faf17b81af10b76f8410258951", "srcset": "https://si.imgix.net/92cd6cd5