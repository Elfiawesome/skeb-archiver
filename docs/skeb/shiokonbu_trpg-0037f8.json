味の道具を兼ねた鉄製のダーツ矢も時々使います。\n\nキャラクターモチーフ:尻尾の長い黒猫、短毛種、耳はしっかりとした立ち耳で\nその他:人耳はなるべく見えない様にお願いしたいです。私が四つ耳あまり好きじゃないので.....\n\nhttps://docs.google.com/spreadsheets/d/19SzsY1v5Tsd_rZzWPvGsaymEkYIUYaysn-3KoH4Zxtc/edit?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 124348, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "津久田くるみ", "screen_name": "nyarunyorunyeru", "avatar_url": "https://pbs.twimg.com/profile_images/2025964338331484160/ol7cugzW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2864659689/1653794713/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 21, "skills": [{"genre": "art"}], "nc": 161}, {"id": 241240, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Azusa🎨Mangakaki", "screen_name": "uo_out", "avatar_url": "https://pbs.twimg.com/profile_images/1804901058717880320/rYwQORbq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/436171733/1710354153/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 1154158, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆのり(むしむし)", "screen_name": "Mo_518_mO", "avatar_url": "https://pbs.twimg.com/profile_images/1994165821476896768/li1ulPsb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/898426277446549505/1765828903/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expir