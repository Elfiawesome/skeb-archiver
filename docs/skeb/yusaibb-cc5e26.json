42ce-9bc2-63a271684a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49d2119371a2aee930aeb3c66c25234c 2x, https://si.imgix.net/7d5dbed6/uploads/origins/0e6fcdda-02dc-42ce-9bc2-63a271684a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=344448bfc4f855b201cb0d9727d14527 3x"}, "body": "遊彩様\n\nMisskeyからきました！しゃちと申します。\nskebでの依頼が初めてのため、拙い部分があるかと思いますが、ご容赦ください。\n\nさて、本題ですが、私の忘れがちな「休息」の文字を書いていただきたいです。\nskebの「印刷してお届け」機能でタペストリーにして飾ろうと思っております。\nどのようなサイズでも引き延ばして印刷できるようなので、サイズの希望はありませんが、縦書きでお願いしたいです。\n\nニュアンスなど、その他はお任せ致します。\n\n上記、ご検討いただけますと幸いです。よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yusaibb/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 91201, "client_id": 897326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a44b09e/uploads/origins/4d8d905a-e3e4-42ac-995f-64a055484659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=860737d511743ad163cec760911004dc", "srcset": "https://si.imgix.net/7a44b09e/uploads/origins/4d8d905a-e3e4-42ac-995f-64a055484659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=860737d511743ad163cec760911004dc, https://si.imgix.net/7a44b09e/uploads/origins/4d8d905a-e3e4-42ac-995f-64a055484659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99dceaff1fee31255dd952a23738ec6f 2x, https://si.imgix.net/7a44b09e/uploads/origins/4d8d905a-e3e4-42ac-995f-64a055484659?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28cc5a9004db2abba78f7512164daa33 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a44b09e/uploads/origins/4d8d905a-e3e4-42ac-995f-64a055484659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42fac79e2505