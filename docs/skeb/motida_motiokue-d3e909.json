065\u305a\u304b\u3057\u304c\u308a\u5c4b\u3002\u884c\u52d5\u529b\u306f\u3042\u308b\u30021\u5ea6\u6c7a\u3081\u305f\u3089\u6700\u5f8c\u307e\u3067\u3084\u308a\u304d\u308b\u3002\n\nHOMoon\uff1aNo.0708(\u30b7\u30ca\u30ea\u30aa\u4e0a\u3053\u306e\u3088\u3046\u306b\u660e\u8a18\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059)\n\u3010\u898b\u305f\u76ee\u3011\u7d3a\u8272\u306e\u9577\u9aea\u3002\u7247\u76ee\u96a0\u308c\u3002APP17\u300118\u8fba\u308a\u306e\u9854\u306f\u3057\u3066\u3044\u308b\u304c\u96f0\u56f2\u6c17\u304c\u602a\u3057\u3044\u306e\u3067APP13\u3002\u8eab\u9577\u306f183cm+\u30d2\u30fc\u30eb\u3002\n\u3010\u6027\u683c\u3011\u4e16\u754c\u3092\u5ba2\u89b3\u8996\u3057\u3066\u3044\u308b\u3002\u300c\u4e16\u754c\u3063\u3066\u304a\u3082\u3057\u308c\u301c\u300d\u3068\u5f8c\u65b9\u8155\u7d44\u3057\u3066\u3044\u308b\u30bf\u30a4\u30d7\u3002\u7269\u8170\u306f\u67d4\u3089\u304b\u304f\u512a\u3057\u3044\u3002\u305f\u3060\u96f0\u56f2\u6c17\u304c\u602a\u3057\u3044\u3002\u63a2\u7a76\u5fc3\u304c\u5f37\u304f\u3001\u8208\u5473\u304c\u3042\u308b\u3053\u3068\u306b\u306f\u3068\u3053\u3068\u3093\u8abf\u3079\u308b\u3002\n\n\u300c\u69cb\u56f3\u300d\n\u304a\u4efb\u305b\u3057\u307e\u3059\uff01\u304a\u597d\u304d\u306a\u3088\u3046\u306b\u63cf\u3044\u3066\u9802\u3051\u308c\u3070....\uff01\uff01\u7279\u306bStar\u306e\u670d\u304c\u88c5\u98fe\u307e\u307f\u308c\u306a\u306e\u3067\u9762\u5012\u3067\u3042\u308c\u3070\u597d\u304d\u306a\u3088\u3046\u306b\u5f04\u3063\u3066\u9802\u3044\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\n\n\u300c\u5e0c\u671b\u3001\u8981\u671betc\u300d\n\u3053\u306e2\u4eba\u306f\u5b9f\u306f\u4ed8\u304d\u5408\u3063\u3066\u3044\u308b\u306e\u3067(\uff01\uff1f)\u604b\u4eba\u611f\u3092\u611f\u3058\u3089\u308c\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002HOMoon\u306e\u65b9\u304c\u6709\u5229\u3067\u3059\u3002\u62b1\u3063\u3053\u3057\u305f\u308a\u30cf\u30b0\u3057\u305f\u308a\u3057\u3066\u307e\u3059\u3002\u81ea\u5206\u3067\u3082\u4f55\u3092\u66f8\u3044\u3066\u3044\u308b\u306e\u304b\u308f\u3