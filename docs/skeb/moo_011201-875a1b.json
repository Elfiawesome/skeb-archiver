%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1f2139c1c54d8867ef02f5b89dee37", "srcset": "https://si.imgix.net/3883b9fe/uploads/origins/78ebb49d-b9bd-41d0-8604-bf77662a0b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e1f2139c1c54d8867ef02f5b89dee37, https://si.imgix.net/3883b9fe/uploads/origins/78ebb49d-b9bd-41d0-8604-bf77662a0b60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd5cebaad7d2ae4cd20927dad30bd72c 2x, https://si.imgix.net/3883b9fe/uploads/origins/78ebb49d-b9bd-41d0-8604-bf77662a0b60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28237a695b0a96b6e61dc9c6a4449825 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3883b9fe/uploads/origins/78ebb49d-b9bd-41d0-8604-bf77662a0b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ca0b1a249867698c9c37169949f83af", "srcset": "https://si.imgix.net/3883b9fe/uploads/origins/78ebb49d-b9bd-41d0-8604-bf77662a0b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ca0b1a249867698c9c37169949f83af, https://si.imgix.net/3883b9fe/uploads/origins/78ebb49d-b9bd-41d0-8604-bf77662a0b60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=110dd64777bb61341c4fd1b1f1e84c85 2x, https://si.imgix.net/3883b9fe/uploads/origins/78ebb49d-b9bd-41d0-8604-bf77662a0b60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abb1ecde190f07a4097ec36145f3b851 3x"}, "body": "最中様\n\n女OCお願いできますか。\n\n髪型はインテークありのレイヤーいっぱいロングウルフです\nヘアアレンジ等おまかせ\n\n髪色は青と紫の横の割れツートンカラーで\n上：青、下：紫です。紫は渋めの色でお願いします\n紫はピンク味にしないでください。青と紫は色の違いがわかるようにしてもらいたいです\n\n瞳は垂れ目、紫です\n\n服装、髪型等お任せします\n\n構図は3パターン想定しています\n\n①本を読んでいる/勉強している様子、\n②料理を作っている様子\n③朝の支度を眠そうにしている様子\n\nどれかでお願いいたします\n\n\nOCの表情はあまり動きません\nほわほわしているけど綺麗で品のある近寄りがたい美人です\n可愛らしさと品がある感じが全体の雰囲気です\n\n身長は175cm +ヒールです\n\nすごくマイペースで動物が好き\n寝ることも食べることも好きです\n大きい怒鳴り声や物音、大きい扉の音などが苦手です\n\n誰にでも基本敬語で、表情が動かないので高嶺の花とかそういう雰囲気ですが、内面はあまり何も考えてないタイプです\n\n金額足りなければ、再送を\n難しければキャンセルしてください\n\nよろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1-Jnv8Dh6o8pRodaf4bb7AklJTjJKSUCL", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 333796, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "祝日", "screen_name": "shuqku", "avatar_url": "https://pbs.twimg.com/profile_images/1711263961025495040/teG07pXF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1130423797071224832/1699545075/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1337808, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "スガタ", "screen_name": "sugata_dski", "avatar_url": "https://pbs.twimg.com/profile_images/1771594766976987136/ie7_DhJI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1377663578489036801/1772035525/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 15, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2583181, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "knD", "screen_name": "kkk_KND", "avatar_url": "https://pbs.twimg.com/profile_images/1923405438571401216/HC0jCGZ-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1592467940020191232/1724857985/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expira