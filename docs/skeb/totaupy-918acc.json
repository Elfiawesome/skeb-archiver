37c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c39f71aa3fc364bfe30546996e0c1b9", "srcset": "https://si.imgix.net/bee10d53/uploads/origins/bb5be994-737c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c39f71aa3fc364bfe30546996e0c1b9, https://si.imgix.net/bee10d53/uploads/origins/bb5be994-737c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69c345ffba92768e848993f6565d1633 2x, https://si.imgix.net/bee10d53/uploads/origins/bb5be994-737c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05cf081be659c9d6951ab56770f18703 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bee10d53/uploads/origins/bb5be994-737c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ec168054a4e48ce48007df39e85aa20", "srcset": "https://si.imgix.net/bee10d53/uploads/origins/bb5be994-737c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ec168054a4e48ce48007df39e85aa20, https://si.imgix.net/bee10d53/uploads/origins/bb5be994-737c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6732659dc538abf8479ff0e3681baf2 2x, https://si.imgix.net/bee10d53/uploads/origins/bb5be994-737c-4652-87ca-5d9357007920?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ec0aa6ccb133c1378c44adf6f94bd98 3x"}, "body": "不思議な壁にハマった琴葉葵ちゃんが男達に見つかり、もみもみぷにぷに辱められちゃうシチュをお願いします。構図はモリマンのぷにぷにが捗る角度でお願いします(ちょっぴりローアングルがオススメかも？)\n\n腰を突き出され、モリマンのぷにぷにが目立ってる状態でお願いします\n\nこの葵ちゃんの体型はとたうぴさんの葵ちゃん系統が希望ですが、彼女とは別次元の葵ちゃんの設定で、裸を男に見られたら赤面する羞恥心があり、モリマンがコンプレックスな感じでお願いします。おっぱいモリマンを恥ずかしく弄られる度にどんどん弱気になったり、羞恥に耐えられずに赤面涙目でいやぁぁぁぁと言ったりすると捗るかもしれない\n\n欲しい差分は\n\n① 壁にハマって抜け出そうとする葵ちゃん\n\n② 男達に見つかり、裸を見られて赤面\n\n③ おっぱいをもみもみされる\n\n④ 左右別々の乳揺れを晒される\n\n⑤ モリマンをむにゅっと摘まれる\n(ここからモリマンコンプレックスなせいで羞恥心が刺激されていく)\n\n⑥ そのままぷにぷに揉まれちゃう\n(凄く恥ずかしそうな表情で、モリマンの形は思いつかなければ⑤のままでも良し)\n\n⑦ モリマンを摘まれ、ぐぃぃぃぃと下に伸ばされちゃう\n\n⑧ ぱっと手を離されてモリマンがぷるんってなる\n\n⑨ 指でビンタされる感じでモリマンをぷるんっ♡ぷるんっ♡と震えが晒されちゃう\n\n⑩ 男達にモリマンをつんつんされちゃう\n\n⑪ おっぱいとモリマンをぷにぷに同時攻め\n\n⑫ 葵ちゃんが羞恥と快楽に耐えられずにイってしまう\n\n⑬ イったのにお構いなしに男達が葵ちゃんを揉みぷにするところで暗転\n\n差分は金額や難易度の関係で削っても構いません\n\nhttps://drive.google.com/drive/folders/13r_yHNbfGwkkSJdG-q7ijCKSK6UiCAwZ", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@totaupy/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2550651, "client_id": 726181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c542f17079b78eeb2248b6ce66b003d", "srcset": "https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c542f17079b78eeb2248b6ce66b003d, https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2a67f5b60b9c57b96a8d430ed36f310 2x, https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3b0dec59ae95476706dc15bb6547cc6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8571c21906b5dc9fea67fcc2952429f3", "srcset": "https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8571c21906b5dc9fea67fcc2952429f3, https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e97f39a27549c05e29bec570997ad3ae 2x, https://si.imgix.net/320b7e47/uploads/origins/4622027f-0f07-4027-a12b-55e72c55dce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f625caa15527005a45b2144a7a9071d0 3x"}, "body": "とたうぴ様\n初めまして。\n\nとたうぴ様の葵ちゃんがとても魅力的に感じた為、少しエッチなイラストを依頼させて頂きます。\n葵ちゃんが普段の服装で袖に付けている飾りを取った状態で、バンザイの状態で拘束されて\n無防備な脇の下を、脇の下のくぼみを中心にひっかくようにくすぐり回して欲しいです。\nまた、正面からスカートをめくり上げて下着が見えるようにして欲しいです。\n\n葵ちゃんの反応はたまらないくすぐったさで、涙と汗を流しながら、大爆笑していて閉じれない口からヨダレがたれている状態だと嬉しいです。\nこちょこちょといったオノトマペや葵ちゃんの笑い声等もあると嬉しいです。\n\n以上、よろしくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@totaupy/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2550651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a49e745/uploads/origins/44279081-1807-434a-8498-8b93a00c88a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f847fb8c58aff8ab2929e46ce61c1f4", "srcset": "https://si.imgix.net/8a49e745/uploads/origins/44279081-1807-434a-8498-8b93a00c88a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f847fb8c58aff8ab2929e46ce61c1f4, https://si.imgix.net/8a49e745/uploads/origins/44279081-1807-434a-8498-8b93a00c88a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0b1b7bde45e9e785232d78a58a30b1c 2x, https://si.imgix.net/8a49e745/uploads/origins/44279081-1807-434a-8498-8b93a00c88a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8840d23157fb67c3ce1a3ad0150335b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.i