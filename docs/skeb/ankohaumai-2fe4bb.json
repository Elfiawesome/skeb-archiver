n\nmisskey.io\u3067\u304a\u4e16\u8a71\u306b\u306a\u3063\u3066\u304a\u308a\u307e\u3059\u3001\u934b\u3068\u7533\u3057\u307e\u3059\u3002\n\n\u3055\u3066\u3001\u30a4\u30e9\u30b9\u30c8\u3092\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u3001\u3054\u9023\u7d61\u81f4\u3057\u307e\u3057\u305f\u3002\n\u8a73\u7d30\u306b\u3064\u304d\u307e\u3057\u3066\u306f\u3001\u4ee5\u4e0b\u306b\u8a18\u8f09\u81f4\u3057\u307e\u3059\u3002\n\n# \u4f9d\u983c\u5185\u5bb9\n\n\u79c1\u306e\u4ee3\u7406\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u5168\u8eab\u7acb\u3061\u7d75\u3092\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\u3002\n\n# \u5229\u7528\u76ee\u7684\n\n- \u500b\u4eba\u9451\u8cde\n- SNS\u306e\u30d8\u30c3\u30c0\u30fc\u3084\u30a2\u30a4\u30b3\u30f3\u3067\u306e\u5229\u7528\uff08\u30c8\u30ea\u30df\u30f3\u30b0\u3084\u30b5\u30a4\u30ba\u8abf\u6574\u306a\u3069\u3001\u5143\u753b\u50cf\u306e\u6539\u5909\u3092\u4f34\u308f\u306a\u3044\u52a0\u5de5\u3092\u3059\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\uff09\n- \u500b\u4eba\u5229\u7528\u3067\u306e\u5370\u5237\u30fb\u5199\u771f\u5408\u6210\u30fb\u30b0\u30c3\u30ba\u4f5c\u6210\n- \u6709\u511f\u4f9d\u983c\u6642\u306b\u304a\u3051\u308b\u53c2\u8003\u8cc7\u6599\u3068\u3057\u3066\u306e\u63d0\u793a\n\n\u3044\u305a\u308c\u306e\u5834\u5408\u306b\u3064\u304d\u307e\u3057\u3066\u3082\u3001\u4f7f\u7528\u306e\u969b\u306f\u304a\u540d\u524d\u7b49\u3092\u8a18\u8f09\u81f4\u3057\u307e\u3059\u3002\n\n# \u7d0d\u54c1\u5f62\u614b\n\n\u4e0a\u8a18\u306e\u5229\u7528\u76ee\u7684\u306e\u305f\u3081\u3001\u5b9b\u540d\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30fb\u80cc\u666f\u306a\u3069\u3067\u30ec\u30a4\u30e4\u30fc\u5206\u3051\u3055\u308c\u305fPSD\u5f62\u5f0f\u3067\u7d0d\u54c1\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5927\u5909\u52a9\u304b\u308a\u307e\u3059\u3002\n\n# \u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\n\n- \u6027\u5225: \u5973\u6027\n- \u5e74\u9f62: 20\u4ee3\u5f8c\u534a\n- \u8eab\u9577: 160 cm\u4ee3\u5f8c\u534a\n- \u4f53\u578b: \u30b9\u30ec\u30f3\u30c0\u30fc\u3