。二人はキーボードの練習をしていて、七菜が彼女の後ろに立って手を誘導しているところでしょう。有咲がようやく自分の気持ちを受け入れて、キスをしようと歩み寄る瞬間を描いてほしい。七菜は喜んでその愛情を受け止める。\n\n有咲: https://bestdori.com/assets/en/characters/resourceset/res005028_rip/card_normal.png\n七菜は私服で描くこともできる。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://pbs.twimg.com/media/E6XfViHVoAA2D1s?format=png&name=orig", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@reibyoh_kobeya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 925048, "client_id": 391731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147eebbbedae7a023a82340368e71c55", "srcset": "https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=147eebbbedae7a023a82340368e71c55, https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61a7c49ad7b085d153d434f269a6b084 2x, https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94ff7b84eb3ead0b31af308c435e21b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39ae3e7bc89cd785cf3695c0baea2af8", "srcset": "https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39ae3e7bc89cd785cf3695c0baea2af8, https://si.imgix.net/054e9e79/uploads/origins/e5f93064-fec2-43b6-8574-10c7d47d898a?bg=%23