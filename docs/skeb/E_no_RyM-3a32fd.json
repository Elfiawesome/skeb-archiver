s/80274eb2-5f11-4d8e-959f-bc9d669e7047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c328dc2b9c1c6298939a06e6aac3a8a3 3x"}, "body": "神前りん様\n\nはじめまして！\n個人でVTuber活動をしております、森永ここあ と申します。\n神前りん様のかわいくてあたたかみのあるイラストを拝見して、ぜひ私のイラストも描いていただきたいと思い依頼させていただきました！\n\n【依頼内容】\n・森永ここあ（私）のイラストをお願いいたします。\n・「明るい」「かわいい」「たのしい」というようなイメージのイラストにしていただけると うれしいです！\n・サムネイル等にも使用させていただきたいので人物の上部と左右が見切れないもの、また可能でしたら背景と人物を分けたデータをいただけると幸いです。\n\n\n【自己紹介】\n名前：森永ここあ🦊🍫\nイチゴとココアが好きな銀色の妖狐。しっぽの数は2本。\n九尾の狐になるために人間界で修行中。\n本体は銀色の狐だが、人型に化けるときは人間界に馴染むように髪の毛をココア色にしている。\n好きな色は赤と緑。\n\n以下に参考資料を添付させていただきます。\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing\n\n紛らわしいポイントをピックアップさせていただきました。紛らわしくて申し訳ありません！\n・髪の毛はオレンジ味のかかった茶色\n・八重歯と髪飾りは左のみ\n・人耳はなく狐耳のみ\n・しっぽは二本(もっふもふにしていただきたいです)\n・しっぽと狐耳は銀色\n\n服装や髪形、装飾品などは変更いただいてかまいません！\n\n\n【使用用途】\nXをはじめとするSNSへの投稿、サムネイルなどのYouTubeでの使用、ネットプリントやグッズに使用させていただく可能性があります。\n使用不可のものがございましたら、お手数ですがイラストデータにご記載いただければと思います。\n\n\n大変余談なのですが、私も「とりまトッポブで」のイベントすごく好きでした！！それまでローアインたちはあまり好きとは言えなかったのですが、あのストーリーで一気に好きになってしまいました。\n私は完全エンジョイ勢のベリアル推し騎空士ですが、お互い良いグラブルライフを送りましょう！\n依頼とは関係のないお話を失礼いたしました。\n\n\nまだSkebでの依頼が不慣れなため、不備がございましたら申し訳ありません！\nお忙しいと思いますが、ご検討いただけると幸いです。\nどうぞ、よろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 16528, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "怜ン", "screen_name": "akr_tmr", "avatar_url": "https://pbs.twimg.com/profile_images/1755416094423322624/wb8XzazY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3018022116/1687262720/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "