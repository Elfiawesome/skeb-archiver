99b5/uploads/origins/cb681aa7-cbea-44ae-a43b-53a59970d380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1cf82a57f069679fa6846125dfa6aef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca1c99b5/uploads/origins/cb681aa7-cbea-44ae-a43b-53a59970d380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6544067fe36083c7bf7d1d3741825122", "srcset": "https://si.imgix.net/ca1c99b5/uploads/origins/cb681aa7-cbea-44ae-a43b-53a59970d380?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6544067fe36083c7bf7d1d3741825122, https://si.imgix.net/ca1c99b5/uploads/origins/cb681aa7-cbea-44ae-a43b-53a59970d380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eabfd1a825c6675c9f0486ad25f60f8b 2x, https://si.imgix.net/ca1c99b5/uploads/origins/cb681aa7-cbea-44ae-a43b-53a59970d380?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa111a1012e1f35977f7bbd566d27da9 3x"}, "body": "はじめまして。\n先日はアピールのほうありがとうございました。\n淡い水彩風の色合い大好きです。\n是非依頼の方させていただきたく思います。\n\n黒坂ヨミについて\n●性別なし中性悪魔\n●身長が140cm\n●赤い目の中に十字架のハイライト入り\nそのため、まつ毛、胸ともになしでショタっぽいいたずらっ子な感じに描いてくださると幸いです。\n\n立ち絵等資料\nhttps://x.com/yomiyomi_ku/status/1930844600991899988\n新髪型もお披露目しているので参考までに。\nhttps://www.youtube.com/shorts/plIqNXJd36o\n\n\n今回の依頼\n\n冬の時期に使えるイラストをお願いしたく考えております。\n服を通常⇒ボーイッシュまたはユニセックスな冬服(もこもこ系だと嬉しいです)に変えてもらうことは可能ですか？色合いは黒や紺、水色辺でまとめていただきたいです。\nポーズはお任せいたします。\n髪色、目の色、つの(帽子等がある場合は隠れても問題ありません)、はね、尻尾さえあれば髪型等のアレンジは可能です！\n\n用途としては、配信時のサムネ、おはV等のSNSでの使用を考えております。\nどうぞよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neige_design/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1955589, "client_id": 3434968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb73883a1fe4e3af6a23e65dd85cd155", "srcset": "https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb73883a1fe4e3af6a23e65dd85cd155, https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3515e49a6b70eca3e1afe339a9a0a8b4 2x, https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64eaac03e6323b4a3933884d164cb8e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc430fe5b060bd0ce24eac4b7b29551", "srcset": "https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc430fe5b060bd0ce24eac4b7b29551, https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19d11578ba0ea7850bff1177b1e82b64 2x, https://si.imgix.net/ce145cbe/uploads/origins/a5d35779-0049-441d-b663-f7af7a242682?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8ab6f71fe03acf7172609aff3dd9f1 3x"}, "body": "はじめまして。梅花（メイフォア）と申します。\nVTuberとして活動をしております。\n\nアピールありがとうございます！\n水彩風ミニキャラがとてもかわいいです。\nぜひうちの子を描いていただきたく、リクエストさせていただきます。\n\n明るい雰囲気で、梅花と小李の仲のよいところを描いていただきたいです。\n細かい構図などはお任せいたします。\n\nYoutubeのサムネイル、各種SNSで使用させていただきます。\n可能でしたら、グッズ化などの商用利用のご許可もお願いしたいです。\n頭の先が見切れないように描いていただけますとありがたいです。\n\nキャラクターイメージ\n・のんびり、やわらかい