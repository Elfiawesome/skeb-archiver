 a good logo........\n\nIf it looks too difficult, you can let the request go!\n\nMaron Fujisaki", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 138817, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "\u58fd@skeb\u52df\u96c6\u4e2d", "screen_name": "bukitikikaku", "avatar_url": "https://pbs.twimg.com/profile_images/1377123448569307146/iebZ7W4B.jpg", "header_url": "https://pbs.twimg.com/profile_banners/938843350160982016/1677470029/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 25, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 33}, {"id": 1144048, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "\u82b1\u898b\u306f\u308b", "screen_name": "Hanami_haru330", "avatar_url": "https://pbs.twimg.com/profile_images/1741550532672774144/otOkbSWT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1385224816160952327/1675353527/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "nc": 48}, {"id": 1300235, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "\u7dbe\u753a", "screen_name": "ayamachi3284", "avatar_url": "https://pbs.twimg.com/profile_images/1477827371009216512/RR2daybY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1374744599965573120/1621079807/1500x500", "appeal_receivable": false, "popular_creator_rank": 26, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_