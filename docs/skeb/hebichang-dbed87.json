0&s=6dc88764f42a78c5ad9e2864df36384b 3x"}, "body": "Skeb再開お待ちしておりました！\nうちの子『永瀬豊美』ちゃんのイラストをまたお願いします。\n\n細かなシチュ、おおまかな流れとしましては、お兄ちゃん（竿役）をオッパイマゾ奴隷化調教の一環としてやっている感じで。\nを背後からのパフパフ責め（乳首弄り＋よだれを谷間投入）\n豊美ちゃんは眼鏡とヘアピン着用で（着衣、全裸かはおまかせします）\n１，パフパフ責め\n２．オナニー誘導\n３，乳首orよだれ責め追加\n４，射精\nといった感じでお願いします。（途中言葉責めもよろしければお願いします）\n他、不明瞭な点はお任せいたします。\n金額不測の場合はお手数ですが再送お願いします。\n\n以上になります。\nよろしければご検討のほどよろしくお願いします。\n\nhttps://skeb.jp/@hebichang/works/4", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hebichang/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 454119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19a90f4acc6de9b63c31d788f4c0cb59", "srcset": "https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19a90f4acc6de9b63c31d788f4c0cb59, https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac4583cecd9dc93256f47c62c8d229b2 2x, https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ba42cfe5366f775e5835783c36ff1f7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb4b84b7eaa9a24c13bc21559b80f9d2", "srcset": "https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb4b84b7eaa9a24c13bc21559b80f9d2, https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ece9a90a2582a83915bd7a656cbee124 2x, https://si.imgix.net/ef2cdf2b/requests/244498_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=526f560dd00cf544ec9f91f7b5ec3945 3x"}, "body": "もんむす・くえすと！のパイズリ人形に全身パイズリで搾精されちゃうイラストをお願いします。\n\nシチュエーション：ウィッチサキュバスに敗北したルカくんがミニマムファンタズムで小さくされてしまい「精奴隷は欲しいけど搾精は面倒だから」という理由でパイズリ人形のおっぱいに閉じ込められてしまう。体格差のせいでおっぱいから抜け出すことができず、延々と全身パイズリで責められ続けてしまう。こうしてルカくんは便利な精液サーバーとしてパイズリ人形の胸の中で飼われてしまうのだった・・・\n\nというイメージでお願いします。\nウィッチサキュバスはセリフのみ、もしくは腕など体の一部だけの描写で結構です。\nルカくんはおっぱいに完全に埋もれてしまって外からは見えず、ふきだし等で乳内描写があるとうれしいです。\n\n少々特殊なシチュかもしれませんが何卒よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hebichang/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 454119, "client_id": 455002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=468c0416cef0a7e4fbd1b1085ed91e43", "srcset": "https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=468c0416cef0a7e4fbd1b1085ed91e43, https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9723be7000a29fe0fb24cb07b6a8ff07 2x, https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4a57452b902d260481598a1e2548610 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4651d6fb5afd37ad78a5495e051b2aab", "srcset": "https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4651d6fb5afd37ad78a5495e051b2aab, https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8740b0bd28f09d05d508b6ce8a209f9 2x, https://si.imgix.net/ce9bd1f4/requests/238659_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=577cc5a30305e5eddf4990d42aac606e 3x"}, "body": "お世話になっております。\n今回も自作もんむす・くえすと！SS（https://www.pixiv.net/novel/show.php?id=14298285#2）でのシチュエーションでイリアス様のロリヴァージョン（以後ロリアス様）の爆乳化してルカ君に授乳足コキしているシーンをお願いします。\n\n細かいシチュとして、ルカ君が床に座らせている所にロリアス様が授乳させながら足コキをしている感じでお願いします。ロリアス様の表情は小馬鹿にしている感じで。オッパイのサイズはへびちゃん様のラミちゃんサイズ並みで。\n衣装はロリアス様が上半身だけをはだけている感じで、ルカ君はズボンだけを下ろされている様に。\n\nイラストはpixiv小説内での挿絵の使用の許可もよろしければお願いします。\nマニアックなシチュかもしれませんが、ご検討宜しくお願い致します。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hebichang/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 454119, "client_id": 455002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d230f7415ee03ce334f7f41a7e306d1", "srcset": "https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d230f7415ee03ce334f7f41a7e306d1, https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fa3dbcd06ce31cec724bb278e7eed08 2x, https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e7888fc8d971f523d8a93ea0131c540 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de29a5a24c19c405c7709c6a7fae8d16", "srcset": "https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de29a5a24c19c405c7709c6a7fae8d16, https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed88dd0797279e9f63d006fd642cb393 2x, https://si.imgix.net/12b9033f/requests/181455_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8474cd8a283bf410df77a729ea4c4159 3x"}, "body": "お世話になっております。\n今回も自作もんむす・くえすと！SS（https://www.pixiv.net/novel/show.php?id=14133636）でのシチュエーションでヴァンパイアガールのヴァニラちゃんとプチラミアのプチちゃんが爆乳化して少年の顔におっぱいを押し付けているシーンをよろしくお願いします。\n\n細かいシチュとして\n少年は全裸で椅子に座らされていて手を縛られて拘束されている状態。\n勃起したペニスから射精している。\n\nヴァニラとプチは左右からおっぱいで少年の顔を挟み込んで、二人で手を繋いでいる。\n二人とも表情は馬鹿にした感じで、舌を出して涎を胸の谷間に流し込んでいる感じで。\n衣装はヴァニラは通常の裸マント、プチは胸の布を外している状態で。\n爆乳のサイズは、へびちゃんさんのラミちゃんサイズ並みで。\n\nイラストはpixiv小説内での挿絵の使用の許可もよろしければお願いします。\nご検討宜しくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hebichang/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 454119, "client_id": 455002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70308a5aee66e9b412b521443df65f8a", "srcset": "https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70308a5aee66e9b412b521443df65f8a, https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f6ed20bfcedd01ba21e3d63b7477968 2x, https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f085402e44bf7d5faec1767bd367c67 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4941a3e5973ac97547719c6ceac788", "srcset": "https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4941a3e5973ac97547719c6ceac788, https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c5ade5c8df13c4601cd470b4fe83c24 2x, https://si.imgix.net/73ea125c/requests/165882_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64af21fcac62b636e9a17e795d7316b6 3x"}, "body": "お世話になっております。\n今回は自作もんむす・くえすと！SS内でのシチュエーションで、爆乳化したクロムちゃんがルカ君をパイズリしているシーンをよろしくお願いします。\n\n内容としては、クロムがラミちゃんの遺伝子を利用して、爆乳化してルカ君をパイズリで籠絡している感じです。\n\nルカ君の状態は全裸では座り込んでいて、爆乳化したクロムが着用していた白色のブラジャーで顔を覆われている状態で。\n\nクロムちゃんは、頭にナース帽着用、上半身は裸、下半身は白パンツ（ピンクリボン付き）とニーゾ着用で、表情は「あの乳インプよりも良いだろう」という感じのドヤ顔で。\n爆乳のサイズは、へびちゃんさんのラミちゃんサイズ並みで。\nパイズリはクロムが両胸を揉みこんで寄せていて、ルカ君のペニスが埋もれて隠れてしまっている状態で。\n\n注文が多くなりましたが、よろしければご検討のほどよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hebichang/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 454119, "client_id": 455002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11450b6d/requests/155969_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33a2ce01f09af008263be81ed2606553", "srcset": "https://si.imgix.net/11450b6d/requests/155969_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33a2ce01f09af008263be81ed2606553, https://si.imgix.net/11450b6d/requests/155969_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d35eef8065b5f9fcce58948e406257e 2x, https://si.imgix.net/11450b6d/requests/155969_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b142249590ad10dca7eec0d1e7e8e2e3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_