刀流可。全然戦ってくれるし協力はしてくれる。マーシャルキック持ち。\n\n◆妹(元GODARCA HO死神)ついて\n笑顔を絶やさないが、人一倍警戒心が高い。猫ちゃん。基本的彼女から近寄ることはなく、仕事中は一人で行動しがち。集団で行動するのには慣れているが、基本的一人になる。\n蓋を開ければ純粋無垢の可愛らしい女の子。仲良くなると距離感は近くなる。ヴァイオリニスト。こっちはまともな方。未婚者\n姉のことは【お姉ちゃん】と呼んでいる。姉に対しては距離が近く、よく抱きついたりしている。\n戦う時は日本刀使用。二刀流は出来るが、基本的一本で戦う。好戦的ではない。前世のこともあり拳銃も使えなくは無い。\n\n────────────\n\n寒波で体調を崩しやすい気温となっているので、お身体にはお気をつけてください！\nご検討頂けると幸いです…！\n\nhttps://drive.google.com/drive/folders/16KVHerf5iwARcNjhcOxJagRUT7tb_zGW", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mukuroji_KA/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3654052, "client_id": 3484149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97d41e1c/uploads/origins/9cf18e76-7582-4d7c-b467-d9d3dc7ef1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970303d1ffd4cc12ca607ea5de795374", "srcset": "https://si.imgix.net/97d41e1c/uploads/origins/9cf18e76-7582-4d7c-b467-d9d3dc7ef1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970303d1ffd4cc12ca607ea5de795374, https://si.imgix.net/97d41e1c/uploads/origins/9cf18e76-7582-4d7c-b467-d9d3dc7ef1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7da485a36380367c41082a00515e740c 2x, https://si.imgix.net/97d41e1c/uploads/origins/9cf18e76-7582-4d7c-b467-d9d3dc7ef1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0df61e5059b11bf43ad0951877ede065 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97d41e1c/uploads/origins/9cf18e76-7582-4d7c-b467-d9d3dc7ef1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2ac6c79ab1bde8a5a3bab172f3877c3", "srcset": "https://si.imgix.net/97d41e1c/uploads/origins/9cf18e76-7582-4d7c-b467-d9d3dc7ef1e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to