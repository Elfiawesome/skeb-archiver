66ec6a6c7bb52", "srcset": "https://si.imgix.net/9ab1c1ee/uploads/origins/9ab1b0e0-b508-4db5-b9ef-0e3854d0ab53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207932d8d9604a1d88066ec6a6c7bb52, https://si.imgix.net/9ab1c1ee/uploads/origins/9ab1b0e0-b508-4db5-b9ef-0e3854d0ab53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9515f0e77fddb1430094f42b0e5e74a 2x, https://si.imgix.net/9ab1c1ee/uploads/origins/9ab1b0e0-b508-4db5-b9ef-0e3854d0ab53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5950355eb97578195e02c8c29cc8c8ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ab1c1ee/uploads/origins/9ab1b0e0-b508-4db5-b9ef-0e3854d0ab53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eccd8fcf30cdcb7a06345b58a2c930ed", "srcset": "https://si.imgix.net/9ab1c1ee/uploads/origins/9ab1b0e0-b508-4db5-b9ef-0e3854d0ab53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eccd8fcf30cdcb7a06345b58a2c930ed, https://si.imgix.net/9ab1c1ee/uploads/origins/9ab1b0e0-b508-4db5-b9ef-0e3854d0ab53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60e2e07133c4243b2e24495c4eaa4c00 2x, https://si.imgix.net/9ab1c1ee/uploads/origins/9ab1b0e0-b508-4db5-b9ef-0e3854d0ab53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d3ac39e359f6d900c4fc337ba744b6b 3x"}, "body": "こんにちは！\nあなたの画風がとても気に入っています。\n\n「HempieVT」というVTuberのイラストをお願いしたいです。\n彼女は普段から眠そうで、少しぼんやりとした雰囲気をしており、目の下にクマがあります。\nまた、髪に赤いストライプがあり、瞳の中にはX（エックス）型の模様があります。\n添付の参考画像のどの衣装を使っていただいても大丈夫です。\n\nHempieは、上官の命令に逆らったためにチェルノブイリの立入禁止区域に追放されたスリーパーエージェントです。放射線の影響で彼女自身も放射性を帯びており、孤独の中で廃墟の建築や放棄された軍用車両、武器（SVD、DP-27など）を研究しながら静かに暮らしています。彼女のそばには、放射能の影響で変異したマスコットの「Pyp（ピップ）」がいます。Pypは小さな粘性のある生物で、手足がなく、頭上に光る輪（ハロー）が浮かんでおり、いつもHempieの頭の上や近くにいます。\n\nシーンや構図、ポーズなどはすべておまかせします。\nただし、参考画像にあるビールまたはサントリー -196 の缶をシーンの中に入れてください（両方とも参考画像にあります）。Hempieがそれを持っている、飲んでいる、またはほろ酔い状態など、どのような形でも構いません。\n\n全体の雰囲気は退廃的でグランジな世界観でお願いします。\n（もし背景やシーンを描いていただける場合は、東ヨーロッパの廃墟都市、チェルノブイリのような雰囲気をイメージしていただけると嬉しいです。）\n『serial experiments lain』や『Texhnolyze』のような静けさと不安定さ、そして虚無感を感じるトーンで表現していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HKpUvqulI6HbCdDdFmdSel-kAK-mqZ6k?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@N_akk_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1011569, "client_id": 3387017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35843167/uploads/origins/b6745efb-71bb-4e21-8683-76a2fbe80fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4bbb610d70f4a505bdec862d5b8dec", "srcset": "https://si.imgix.net/35843167/uploads/origins/b6745efb-71bb-4e21-8683-76a2fbe80fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4bbb610d70f4a505bdec862d5b8dec, https://si.imgix.net/35843167/uploads/origins/b6745efb-71bb-4e21-8683-76a2fbe80fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73fc0d178881482b9f84f273b65f9af0 2x, https://si.imgix.net/35843167/uploads/origins/b6745efb-71bb-4e21-8683-76a2fbe80fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8c9efd844c05c5f27c4df9d334d5fc2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35843167/uploads/origins/b6745efb-71bb-4e21-8683-76a2fbe80fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f8fd7a205fb46ff51a92c4e4e52bc1d", "srcset": "https://si.imgix.net/35843167/uploads/origins/b6745efb-71bb-4e21-8683-76a2fbe80fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f8fd7a205fb46ff51a92c4e4e52bc1d, h