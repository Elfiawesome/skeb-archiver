1-9d92-e9656c985a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=710c15e8afd5d0360e396c5ca0e61813 2x, https://si.imgix.net/e10bc761/uploads/origins/8d984cb7-14c6-45d1-9d92-e9656c985a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34cce45e21ec058baa21a43dc59ce202 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e10bc761/uploads/origins/8d984cb7-14c6-45d1-9d92-e9656c985a43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccb825f71244a52a5fe89ba1c34e1c5a", "srcset": "https://si.imgix.net/e10bc761/uploads/origins/8d984cb7-14c6-45d1-9d92-e9656c985a43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccb825f71244a52a5fe89ba1c34e1c5a, https://si.imgix.net/e10bc761/uploads/origins/8d984cb7-14c6-45d1-9d92-e9656c985a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3091b635347112f301658fd279b93a9f 2x, https://si.imgix.net/e10bc761/uploads/origins/8d984cb7-14c6-45d1-9d92-e9656c985a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bdf405d5abbefaf611d5b8524605e010 3x"}, "body": "はじめまして。でかいクマの顔の上でうんこ座りして脱糞するマッドラットをリクエストしたいです。\n新しい方のレンタくんのイラストと同じポーズとアングルで、マッドラットは口を開け、舌を出しながら悪い顔でクマを馬鹿にして笑っています。また、マッドラットの体はレンタくんよりも小さいですが、かなり太いうんこをすでに数本出しています。クマはそれらを顔に乗せられて白目を剥いて気絶しているでしょう。クマの開いた口から舌が垂れているととても良いですね。\n\n表情のパターンは作らなくて問題ありませんが、クマの顔と頭をほとんど生き埋めにするほどの量を出し切り、大きく濃厚なおならをしている差分も欲しいです。\n\nマッドラットは「クマのくせに大したことねえな！そんじゃ トドメをお見舞いしてやるぜ！」と言っています。\n\nリクエストさせてくれてありがとう！よい日を過ごしてください。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inkeishabukonbu/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e43ac3b6/uploads/origins/cbc14fb5-b22a-41ce-905d-c162ed941e19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&t