et/c15038b2/uploads/origins/6341b31c-9aba-43d3-b59a-c57dd6eae9a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3d9df6ba21a1d2746bc79f2cb84ed12 3x"}, "body": "またまたこんにちは!私のために作ってくれた作品は本当にゴージャスです!!!また作品をお願いしてもいいでしょうか💛？\n\nカナリアさんは暗殺者です！彼は強くて無口なタイプで、仕事をこなしながらできるだけ感情を表に出さないようにしています。普段は平然としているが、逃げたり反撃したりせず、物乞いやひざまずきに頼る者には特に軽蔑の念を抱く。「せめてやってみろ！子供はもっとうまくやれる！\"\n\nターゲットがよく見える場所に止まり、数日間観察してから行動を起こすことを好む。時々、人混みの中でターゲットを尾行する必要がある場合は、ゆったりとした黒いシャツとフード付きのマントを着て紛れ込む。与えられたものは何でも食べるが、甘いものを密かに好む。また、カナリアにちなんで名づけられたため、カナリア好きでもある！\n\nhttps://drive.google.com/drive/folders/10B8ezel7KThczKVp6AYzu5aWyAFQn1tM", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@c0ri_n/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3358173, "client_id": 2650886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12847dc3/uploads/origins/121c95f5-8180-49f2-9e3f-61bed46c1a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecfa4ed92a02d2fb2524d7933a41f46", "srcset": "https://si.imgix.net/12847dc3/uploads/origins/121c95f5-8180-49f2-9e3f-61bed46c1a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecfa4ed92a02d2fb2524d7933a41f46, https://si.imgix.net/12847dc3/uploads/origins/121c95f5-8180-49f2-9e3f-61bed46c1a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4cc0bf93ff5f59f8bfdc98b90141344 2x, https://si.imgix.net/12847dc3/uploads/origins/121c95f5-8180-49f2-9e3f-61bed46c1a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dadac2eb7c507f55c2f3373155813871 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12847dc3/uploads/origins/121c95f5-8180-49f2-9e3f-61bed46c1a1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a84e64f6be1d