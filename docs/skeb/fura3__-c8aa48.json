0c736-1d1d-4181-b92e-1cb59583440c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6a8ae751c8ec150444d0a0acc61cfd5", "srcset": "https://si.imgix.net/cc97acd3/uploads/origins/46c0c736-1d1d-4181-b92e-1cb59583440c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6a8ae751c8ec150444d0a0acc61cfd5, https://si.imgix.net/cc97acd3/uploads/origins/46c0c736-1d1d-4181-b92e-1cb59583440c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3f70097d91b5cc18fbbea979ac7c899 2x, https://si.imgix.net/cc97acd3/uploads/origins/46c0c736-1d1d-4181-b92e-1cb59583440c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8af9a5b5025f7fa57ca6b3c0851b3e72 3x"}, "body": "こんにちは、あなたの作風は本当に素晴らしいですね！！\n大切な人からの依頼で、このオリジナルキャラクター（OC）のイラストをお願いしたいです。このキャラクターの名前は「イービー」または「ズーミー」で、性格はいたずら好きで可愛らしく、ちょっと悪戯っ子なところがあり、時にはとてもミステリアスな一面も持っています。しかし、心の奥底では、状況によってはパートナーに対して甘えん坊だったり、色気を出したり、わがままを言ったりすることもあります。\n\n参考画像の最初にある服装（スカートを履いているもの）を、ぜひ描いていただきたいです！描くスタイルは自由です。他にも2つの服装のイメージを載せていますが、これらはあくまで参考なので、キャラクターのイメージを膨らませるために自由に参考にしてください！\n\nこの依頼を検討していただければ、本当に嬉しいです！もし引き受けてくださるなら、きっと素晴らしい作品を作ってくれると信じています！\n\nhttps://www.dropbox.com/scl/fo/hsys0n82onxf3d2fg0qlo/AEj5FW_A70vqVitd0KPIdsI?rlkey=sjzquf0lfxlrhojl9ir1vo7dr&st=h943y81t&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fura3__/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3563597, "client_id": 1541284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f9ce039/uploads/origins/918144b8-0ab2-4f50-b234-bdeb1128ecd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ce58da655c666021d9d563d46571f6d", "srcset": "https://si.imgix.net/7f9ce039/uploads/origins/918144b8-0ab2-4f50-b234-bdeb1128ecd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ce58d