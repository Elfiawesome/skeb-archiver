n\n【使用用途】\n・収益化済みYoutubeでの使用\n・各種SNSでの使用\n・ファンクラブの返礼品（限定コンテンツ）での使用\n・グッズ販売(商用利用/企業案件など)\n上記の用途で不可のものがあればお断り頂くか、不足分の金額を足した条件付き再送頂ければと思います。\n\n【イラストの詳細】\n衣装などは資料内のどれでも\n全てゆきだるま様におまかせしたいです。\n差分として髪型ロングも描いていただけるととても嬉しいです。\n\n・サムネイルやおはV等で使用するため、犬耳や頭、顔周り、左右が見切れないようにしていただきたいです。\n・1920×1080のキャンバスでバストアップ表示しても荒くないサイズで作成して頂けると幸いです。\n・可能な範囲で表情差分いただけると嬉しいです。\n\n【キャラクター詳細】\nアイスクリームと双子の妹ちゃん(ミニチュアダックス)が大好きな20代女性\n資料URLにて魔法少女衣装三面図でキャラクター資料がございます。\n外さないでいただきたい要素としては、犬耳、髪の毛のグラデーション、アホ毛、瞳の中のピンクのライン、ピン留めデザイン\n妹ちゃんたちの鼻の色の違いは見落としやすい要素になります。\n\n【希望納品形式】\n人物、背景、妹ちゃんたち、宛名等がレイヤー分けされた\nPSDデータを希望いたします。\n\nお忙しいところ恐れ入りますが\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1oMfJJ5v91cFDYhza1h-4BsT_UVwCB2aT", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiyu5733/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3912270, "client_id": 3009268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96a37f02/uploads/origins/1fbe24fb-9438-4ea3-9753-393bf64911ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb760da06dde2a5c7ce8c71545d6ae50", "srcset": "https://si.imgix.net/96a37f02/uploads/origins/1fbe24fb-9438-4ea3-9753-393bf64911ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb760da06dde2a5c7ce8c71545d6ae50, https://si.imgix.net/96a37f02/uploads/origins/1fbe24fb-9438-4ea3-9753-393bf64911ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b41cab3b76886fccaf6d725666b1f58b 2x, https://si.imgix.net/96a37f02/uploads/origins/1fbe24fb-9438-4ea3-9753-393bf64911ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21a81e8b6a25f1193d727fae2e60dca2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96a37f02/uploads/origins/1fbe24fb-9438-4ea3-9753-393bf64911ac?bg=%23fff&auto=format%2Ccompress&f