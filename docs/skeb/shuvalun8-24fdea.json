3-689a-47c4-a0ee-9bf5a6afd9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4248022f60ca5ee0113d8cd05a24f28d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99fbf9cc/uploads/origins/d088abd3-689a-47c4-a0ee-9bf5a6afd9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c630ac97f385f1b3e0fbe78361b4bd1c", "srcset": "https://si.imgix.net/99fbf9cc/uploads/origins/d088abd3-689a-47c4-a0ee-9bf5a6afd9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c630ac97f385f1b3e0fbe78361b4bd1c, https://si.imgix.net/99fbf9cc/uploads/origins/d088abd3-689a-47c4-a0ee-9bf5a6afd9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=421bcf3d7171fee272f68f8bd33e58eb 2x, https://si.imgix.net/99fbf9cc/uploads/origins/d088abd3-689a-47c4-a0ee-9bf5a6afd9d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b5a8870c787c6e3ed197b5ecd47b3d 3x"}, "body": "Hello,\n\nI would like to redesign an original character. She is a kunoichi based on the Naruto series. Her personality is of a lovable trickster.\n\nCharacter: https://i.imgur.com/ATuTymm.jpg\n\nChanges: \n\n1) Her chest should be smaller.\n2) I'd like to change her white belt. Instead, it will have the design of a \"fractal\". Image: https://i.imgur.com/2v1F9Av.jpg\n3) For the Kunai strapped behind her back, I would like to add a ^_^ design to it (https://i.imgur.com/UwIjwUd.png). It can be on the handle, the wraps, or the metal - whatever is visible.\n4) I want to add a bracelet of a water-type Eastern dragon (https://i.imgur.com/evxzkLz.jpg) on her forearm or wrist somewhere. The details for the bracelet design are up to you.\n5) Change the Mist forehead protector symbol to the Konoha version (https://i.imgur.com/z8SnsCZ.jpg)\nOtherwise, her outfit can be similar to the previous picture. \n\nPlease change any details as you like. Her pose can be whatever looks cool.\n\nThanks for your time!", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shuvalun8/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2619160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39eef022fe310a6c47d34e517f8b0838", "srcset": "https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39eef022fe310a6c47d34e517f8b0838, https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b148cef22e7a3628fb1dbc6f07124332 2x, https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad145ea8ee09112ccad44986aecb1f5e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ef5102e0e8b0e403a8640f0a5fa1416", "srcset": "https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ef5102e0e8b0e403a8640f0a5fa1416, https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3d074b854aaec0a496a2c04e578dbc 2x, https://si.imgix.net/fc6818bd/uploads/origins/8f5d9e07-edc3-482c-98bc-e16398305388?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bcd2f9674ed765dc8db1eea106a3874 3x"}, "body": "こんにちは\n\nココミの服を着たルミネを描いていただけませんか？ポーズは座っているもので、Google Driveのリンクにいくつか例があります。全体的に、ストッキングとサンダルが描かれていると嬉しいです。\n\nまた、ヘアアクセサリーとして、花の代わりに、ここみが使っているものを。\n\nリクエストを読んでくれてありがとう\n\nhttps://drive.google.com/drive/folders/10NrLs6iBjSJ-dIfgGL6Gix0pnYpvCZ7m", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shuvalun8/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2619160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8fcd6432096aa4a52c51c1e4755ced3", "srcset": "https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8fcd6432096aa4a52c51c1e4755ced3, https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41b61f86c569125c9ddb753630ed6281 2x, https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d98a8ba4cb887c9d3d4c2015e8aa7c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d5f062e37ca8452724861f41c1da20", "srcset": "https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d5f062e37ca8452724861f41c1da20, https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b97ba220b23c07cf9aeb0f55f7e7ea7c 2x, https://si.imgix.net/48ebd162/uploads/origins/cfe8ecd6-951d-43d5-a27d-8ff992b72025?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8d9b77434aa86ba9068b40ce548ceb8 3x"}, "body": "ファイアーエムブレムのルキナをリクエストします。ルキナはいつもの衣装ではなく、ブルーアーカイブの城前沙織の衣装を着ています。\n\nルキナの左目には特別なマークがある。\n\nサオリの後頭部には十字の光輪がある。十字の後光の代わりに、ルキナに特別なマークの形の後光をお願いします。参考画像を載せておきます。\n\nフェイスマスクありバージョンとフェイスマスクなしバージョンをお願いします。白衣もお願いします。その他、細かい部分はお任せします。\n\n参考画像：https://imgur.com/a/nnE2WdP\n\nhttps://imgur.com/a/nnE2WdP", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shuvalun8/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2619160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5765a473/uploads/origins/70579a79-a459-4f13-9ab7-c735f0760a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a2ee7b1d5ede2ea1cb34a58da2d2724", "srcset": "https://si.imgix.net/5765a473/uploads/origins/70579a79-a459-4f13-9ab7-c735f0760a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a2ee7b1d5ede2ea1cb34a58da2d2724, https://si.imgix.net/5765a473/uploads/origins/70579a79-a459-4f13-9ab7-c735f0760a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9789dd63ba8d9aea8501870ff3a0bb92 2x, https://si.imgix.net/5765a473/uploads/origins/70579a79-a459-4f13-9ab7-c735f0760a18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40b62c070ad6a18cb6566592b42a8407 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5765a473/uploads/origins/70579a79-a459-4f13-9ab7-c735f0760a18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9770548f01ebe7d4ab586af1e