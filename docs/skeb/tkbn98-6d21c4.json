&w=200&h=200&s=560b87ac48f9297eb593ef83793dd89b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d00124cf/uploads/origins/73c87b39-aee0-4242-88aa-36dc1282d04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa779ff50b24d99865df77beb57b54c8", "srcset": "https://si.imgix.net/d00124cf/uploads/origins/73c87b39-aee0-4242-88aa-36dc1282d04c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa779ff50b24d99865df77beb57b54c8, https://si.imgix.net/d00124cf/uploads/origins/73c87b39-aee0-4242-88aa-36dc1282d04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89381884ac60fa57a2d7dc11107acac9 2x, https://si.imgix.net/d00124cf/uploads/origins/73c87b39-aee0-4242-88aa-36dc1282d04c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ced5e8ae54bf59c4c4e67f88a8825740 3x"}, "body": "こんにちは、かばね98さん！かばね98さんのモノクロイラスト、本当に素敵ですね。できれば、私のオリジナルキャラクター、ユージンとキムのモノクロイラストを描いていただけませんか？\n二人は仕事では強いパートナーシップを保ち、日常生活では家族や友人として深い絆で結ばれています。一緒に戦略を練ったり、チームとしてフォーマルな宴会に出席したりするところを描いていただけたらうれしいです。具体的な色、ポーズ、構図はお任せします。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-ZxTPixrEYfFj4SgwIjkIdBKzHx43Xp9", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tkbn98/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3258636, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f59f5e25/uploads/origins/946be995-8d31-4bc9-be89-9ae027f3b1cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fddb8b5899c348c48b29899ad03730b", "srcset": "https://si.imgix.net/f59f5e25/uploads/origins/946be995-8d31-4bc9-be89-9ae027f3b1cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fddb8b5899c348c48b29899ad03730b, https://si.imgi