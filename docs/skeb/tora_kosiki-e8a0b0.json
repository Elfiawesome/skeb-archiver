returned to once more ask you to create soemthing for me.\n\nI would like you to commission you to make a gift for a friend of mine, Tetra, of her VTuber character. \n\nSomething where she's looking down, a little yandere. Pose and outfit of your choice, you did very nicely last time!\n\nI look forward to seeing what you come up with.\n\nThank you for your time and consideration.\n\nhttps://drive.google.com/drive/folders/1FHDuXQS2ctgUedCmTYcLYEmmNZ8fpgir?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tora_kosiki/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 240058, "client_id": 2128404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcca6dfd/uploads/origins/b9525db6-737b-4592-95dc-06b629ca071d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb693208efdf8aae37253525029fbdb", "srcset": "https://si.imgix.net/dcca6dfd/uploads/origins/b9525db6-737b-4592-95dc-06b629ca071d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb693208efdf8aae37253525029fbdb, https://si.imgix.net/dcca6dfd/uploads/origins/b9525db6-737b-4592-95dc-06b629ca071d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=454ff46da9c975a90b1d36a386e89e5c 2x, https://si.imgix.net/dcca6dfd/uploads/origins/b9525db6-737b-4592-95dc-06b629ca071d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03abce9297e09aabdf3d2ae6a652d942 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcca6dfd/uploads/origins/b9525db6-737b-4592-95dc-06b629ca071d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a3a0f9c9e42998fdbea285ca37ec7f9", "srcset": "https://si.imgix.net/dcca6dfd/uploads/origins/b9525db6-737b-4592-95dc-06b629ca071d?bg=%23fff&auto=format%2Ccompress&fm=web