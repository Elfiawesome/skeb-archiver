9f-1248b54ad918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9846174904ed2a70b391983887a2e939 2x, https://si.imgix.net/1bf09153/uploads/origins/feeaa124-21b0-4096-9b9f-1248b54ad918?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d98cd7b967e78f583b685fb58890dee 3x"}, "body": "こんにちは\nポケモンシリーズのカンナとポケモンDP物語のミツミがハレタ(主人公)にパイズリ奉仕するイラストをお願いします\n\n・コスチュームは\n　カンナ：FRLG(GBA)の頃のコスチューム\n　ミツミ：ギンガ団コスチューム\nhttps://drive.google.com/drive/folders/13Mq125DtNK2I7oyJ5CuBlihX9l2aDpp6\n\n・おっぱいは爆乳盛りでお尻も大きく盛ったラスオリ体型な感じ\n\n・二人ともハレタの所有物のイメージ\n\n・二人の装飾として\n　髪飾り(ハレタにプレゼントされたイメージ)\n　薬指に指輪\n　乳首ピアス\n　肩にバーコードと番号の刻印\nをお願いします。\n\n・構図はhttps://drive.google.com/file/d/1yP_TET5NkjAObUqRa-aC86pY1FqpPuQR/view?usp=drivesdkをベースに\nカンナ：おっぱいを出した状態でおっぱいにエグめの刺青が刻まれている(所有物としての服従の証)\nミツミ：着衣状態\nでラブホ的な場所でハレタ(主人公)の逸物におねショタパイズリ奉仕している感じで\n差分で\n①パイズリ前\n②パイズリ中\n③射精\n④射精後の余韻\n⑤チンポにキス\nをお願いします\n\n・ハレタの逸物は\n　・馬並みで極太、カリ太\n　・逸物全体に傷跡とピアスが散りばめられている\n　・キスマークとフェラ跡付き(淡いピンクと赤色の二人に付けられた感じの物)\nの絶倫で凶悪な禍々しい感じのエグめのやつ\n\n・差分で\n　・眼鏡有り無し\n　・リード付き首輪\n　・スリーサイズ及びカップ数表記\nをお願いします", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 114947, "client_id": 1806115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6e07e9f76769f059ceae22ffbe823dd", "srcset": "https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6e07e9f76769f059ceae22ffbe823dd, https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c69f6acf4340677570c071c3680a622a 2x, https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b67f2b7c2b7395c26d79ad84c90cd5bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1588f1fa4b096ef64d18cac437e4cd94", "srcset": "https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1588f1fa4b096ef64d18cac437e4cd94, https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4428bbc4762a5d453c3d28647163b82 2x, https://si.imgix.net/7ab49161/uploads/origins/1f13ed2f-e766-42b1-b7b1-5d57791be051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03f94fac912d6493e9785ee2e35a3365 3x"}, "body": "姫川ハユル (魔装学園H×H)\n\nあなたの魔装学園H×H同人誌がとても気に入りました。\n\n可能であれば、姫川が傷無とアナルセックスする漫画をお願いします。できればカラーですがモノクロでもOKです。必要に応じて量を増やしてください。\n\nシナリオはイラスト「 https://x.com/Kuji_Masamune/status/1153209445570060288 」の続きです。\nアナル尻尾は、アニメOVA第3作「にゃんにゃん♪ハユルん日記」のようにビーズ付きにしてください。\n\n姫川が前かがみになり、傷無がアナル尻尾を引っ張ります。\nアナルビーズがアナルから抜けると、姫川は絶頂を迎えます。\n\n傷無は後ろからアナルファックを始め、姫川は快感で呻きます。\nそして、姫川が再び絶頂を迎える中、傷無は彼女のアナルに射精します。\nセリフや詳細はお任せします。\n\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 114947, "client_id": 118415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31fd333a928e0477dfe7ac801779c142", "srcset": "https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31fd333a928e0477dfe7ac801779c142, https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb6767c9bf6157b8ade990aa40cd0cb2 2x, https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b99624036d0dfe838cffc0690913218f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa0ec2343cfd1cedeb573d9b1c6a7863", "srcset": "https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa0ec2343cfd1cedeb573d9b1c6a7863, https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=028bbf1cfe9704cfb3adced4257db13c 2x, https://si.imgix.net/be33bfde/uploads/origins/23247690-46fc-4093-8c61-8984e5c4b00f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd26c11c241538c4a6785750682976d5 3x"}, "body": "こんにちは\nガンダムOOのルイスの着衣パイズリ奉仕イラストをお願いします\n\n・おっぱいは爆乳盛りでお尻も大きく盛ってください\n\n・髪型はショートカットで髪飾り(劇場版のやつ)をお願いします\n\n・左手薬指に指輪とアクセサリーでドックタグ\n\n・おっぱいにバーコードと番号と乳首ピアス(コスチューム越しにシルエットが浮き上がる感じの表現で)と刺青(エグめのやつ)をお願いします(ご主人様(沙慈)の所有物な感じ)\n\n・コスチュームは前回描いていただいたhttps://skeb.jp/@izta_/works/2の改造CB制服でお尻の刺青など細かい所も同じ感じでお願いします\n\n・構図はhttps://drive.google.com/file/d/1NTDAFGznR-zefwRavJvJDUs_OfhzRtts/view?usp=drivesdkをベースにラブホ的な場所で両穴を極太バイブで責められている状態で子宮を疼かせイラつかせながらご主人様(沙慈)にパイズリ奉仕している感じで\n差分で\n　・パイズリ前\n　・パイズリ中\n　・射精\n　・射精後の余韻\n　・頭撫で\n　・チンポにキス(ツンデレっぽい雰囲気)\nをお願いします\n\n・ご主人様(沙慈)の逸物は馬並みで極太、カリ太の雄臭く凶悪な感じで逸物全体にピアスと傷痕とキスマーク(淡いピンク色でルイスが付けた感じ)をお願いします\n\n・差分で眼鏡、イノベイターモードの金色の瞳差分をお願いします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 114947, "client_id": 118415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b45135a2d76dbd22c13ed6304ca6f5f8", "srcset": "https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b45135a2d76dbd22c13ed6304ca6f5f8, https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=179794422e80989d81229c123c5517ef 2x, https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89d19f78fe2a5ea6236f509701acb806 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b23ece46351dbb4adbb52cc98020c76f", "srcset": "https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b23ece46351dbb4adbb52cc98020c76f, https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0815b7893e16a35684d46ff00e887cd9 2x, https://si.imgix.net/1a9581bc/uploads/origins/057e0864-f7b6-42e0-bb29-1bb11b28baf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2460db6eb9fceaf74cca996fdc6abd2f 3x"}, "body": "こんにちは\nハンドレッドのヴィタリーさんの着衣パイズリ奉仕をお願いします。\n\n・おっぱいは爆乳盛りでお尻も大きくお願いします。\n\n・コスチュームや細かい小物や設定は前回描いて頂いたhttps://skeb.jp/@izta_/works/4と同じ\n\n・雰囲気は社長室の机に潜り込んでデスクワーク中の旦那さんに着衣パイズリ奉仕する感じで旦那さんにブチ犯され孕まされるのを想像し、股を疼かせながら奉仕している様子\n\n・旦那さんの逸物は馬並み(40〜50cm位)で極太、カリ太で絶倫な凶悪なやつで基本スペックはhttps://drive.google.com/file/d/1_0-4PsvsJcCtQMedgvnAufpx3IlOFBmB/view?usp=drivesdkをベースに強化した感じのやつで描写可能ならキスマークとフェラ後をお願いします。\n\n・差分で射精、射精後の余韻、頭ナデナデ、眼鏡、リード付き首輪をお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 114947, "client_id": 118415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f593ad10a00b32182e6ac9d885972071", "srcset": "https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f593ad10a00b32182e6ac9d885972071, https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cab39e88bfe53fc04e3d85d051880c87 2x, https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67a213a4e98a4eb1f584d6df11c46fd5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90803c98d71f75c598d8f2c4b610a5ea", "srcset": "https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90803c98d71f75c598d8f2c4b610a5ea, https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6a9e5a829ea4be7788229e9686c7e57 2x, https://si.imgix.net/834b1261/uploads/origins/4ac928a5-b449-4d91-981f-404856f29d09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5f828019a4028d89c344a82b0160727 3x"}, "body": "こんにちは\nハンドレッドのヴィタリーさんのイラストを御願いします。\n\n・おっぱいは爆乳盛りでお尻も大きく盛ってください。\n\n・おっぱいにバーコードと番号を御願いします。（所有物な感じ）\n\n・左手薬指に指輪を御願いします。\n\n・描写可能なら乳首にピアスを御願いします。\n\n・煙草を御願いします。\n\n・構図は立ち絵で御願いします。\n\n・旦那さん（大企業の若社長）お抱えの技術者兼所有物（おんな）なイメージ\n\n・可能なら眼鏡、リード付き首輪差分を御願いします。\n\n・キャラクター資料\nhttps://drive.google.com/drive/folders/1aLR5CN2pIW6ISArK6oIObUG1hTlvhw1K", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/42313efa/uploads/origins/ea35178b-7147-4b04-8d3c-c020ac573234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee165e8b4f5434a079b90f7095e8ed10", "srcset": "https://si.imgix.net/42313efa/uploads/origins/ea35178b-7147-4b04-8d3c-c020ac573234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee165e8b4f5434a079b90f7095e8ed10, https://si.imgix.net/42313efa/uploads/origins/ea35178b-7147-4b04-8d3c-c020ac573234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b028ab8c689110eefc9a50a6d78b1da7 2x, https://si.imgix.net/42313efa/uploads/origins/ea35178b-7147-4b04-8d3c-c020ac573234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eff5ce94173da8e1f090bc9fa78c5ad 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 114947, "client_id": 201574, "nc": 32}, {"path": "/@izta_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 114947, "client_id": 118415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9950991033442964a9689f3438b72e7", "srcset": "https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9950991033442964a9689f3438b72e7, https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=111470101caeeb20ee51a0f1e279869f 2x, https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d850df0c4551c224f6549afdd7204e7d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9a7422da87857910165488b00bb1b94", "srcset": "https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9a7422da87857910165488b00bb1b94, https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa95997915d80528c77986538c4fc2c3 2x, https://si.imgix.net/0c8f9f6f/uploads/origins/494cf3c3-919d-42df-8efd-edbc19fc4452?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d166e3e3880233c0ee316bdac8445f69 3x"}, "body": "こんにちは\nガンダム00のルイスのイラストを御願いします。\n\n・おっぱいは爆乳盛りでお尻も大きく盛ってフィジカルデカつよ（身長180cm位で軍人として鍛えてある感じ）な感じで御願いします。\n\n・髪型は二期の頃のショートカットに髪飾り（劇場版のやつ）\n\n・左手薬指に指輪（資料https://drive.google.com/drive/folders/10ZvQtCR6Ggbgmac8xMtdv0M6wDMGfhTh）とアクセサリーでドックタグ（アロウズのマークが彫られている）\n\n・リード付き首輪と手錠と足枷（鎖の長さは両腕と両足を自由に動かせる位余裕を持った長さ）を御願いします。\n\n・コスチュームは二期のCB制服（レグナントをイメージしたカラー）を改造する感じで\n　・へそだしルック\n\n　・肩はガンダム種運命のステラみたいに露出させる感じ\n\n　・胸部分にパイズリ穴をつけて谷間を露出させる\n\n　・ズボンはチャップス風でパンツは黒色で食い込みがエグい感じ\n\n　・両足をチェーンかワイヤーで繋いで、二の腕と太ももにベルト（鎖付き）を巻いて全体的に拘束具とか虜囚服みたいなイメージで着用者を辱しめる感じ\n資料\nhttps://drive.google.com/drive/folders/1tUXWRyxqeRSQGUrLDLO3IoRvkZHur5_g\n\n・レグナント資料\nhttps://drive.google.com/drive/folders/1fIdBs3aQFLeU0xncMRHzG4yyhOyCtGh9\n\n・おっぱいにバーコードと番号、肩に黒字でアロウズのマークの刻印、子宮辺りの位置に刻印（レグナントをイメージしたデザインでイノベイドの改造で刻まれた感じ）を御願いします。\n\n・カットイン表現でお尻の描写を御願いします。その際お尻に黒字でCBのマークを逆さにした刻印を御願いします。\n\n・内太ももに二匹の蝶の彫り物（刺青）（レグナントをイメージしたカラーの蝶とオーライザーをイメージしたカラーの蝶で沙慈とルイスをイメージした感じ）\n\n雰囲気はCBの捕虜として捕らえられ、沙慈に首輪のリードを握られている様子で御願いします。\n\n・可能なら差分でイノベイターモードの金色の瞳を御願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 114947, "client_id": 670108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76e85a56/uploads/origins/8ed621b1-282c-4cfd-a75b-0e292b9189c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d1d6d027ed9f8dc4ff8505749e4e9c6", "srcset": "https://si.imgix.net/76e85a56/uploads/origins/8ed621b1-282c-4cfd-a75b-0e292b9189c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t