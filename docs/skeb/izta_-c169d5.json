fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89fadf110067d6e56dd40ce47e35702d", "srcset": "https://si.imgix.net/df7e60ee/uploads/origins/8f643ec0-f7a6-4cae-bc60-c02d4553fd9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89fadf110067d6e56dd40ce47e35702d, https://si.imgix.net/df7e60ee/uploads/origins/8f643ec0-f7a6-4cae-bc60-c02d4553fd9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81d4995b8ea7a16f51be602ee3d38094 2x, https://si.imgix.net/df7e60ee/uploads/origins/8f643ec0-f7a6-4cae-bc60-c02d4553fd9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc24e62c2bc9a04bd9429f80b4afb246 3x"}, "body": "こんにちは\nリリカルなのはシリーズのヴィヴィオ(大人モード)のイラストをお願いします\n\n・おっぱいは爆乳盛りでお尻も大きく盛ったラスオリ体型な感じ\n\n・左手薬指に指輪\n\n・コスチュームはバリアジャケット(聖王モードの黒色のやつ)\nhttps://drive.google.com/drive/folders/1UcuUGuJmEZNTHWIkKzcViO603BMHPZlC\n\n・乳首ピアス(ストレートバーベルタイプでコスチューム越しにシルエットがわかる感じ)をお願いします\n\n・構図はhttps://drive.google.com/file/d/1LleZj5_vmDYtTE3J5kJ66rTa1QCaNpMd/view?usp=drivesdkをベースに立ち絵風と着衣パイズリをお願いします\n(ボーイフレンドにパイズリ奉仕しているイメージ)\n可能なら差分で\n①射精\n②射精後の余韻\nをお願いします\n\n・竿役(ボーイフレンド)の逸物は馬並で極太、カリ太の凶悪な感じで逸物全体にキスマークとフェラ跡(ピンク、赤、紫、緑色の複数人のものでヴィヴィオ以外の娘も抱いているイメージ)\n\n・差分で\n　・眼鏡\n　・リード付き首輪\n　・スリーサイズ及びカップ数表記\n　・ほっぺたにバーコードと番号\nをお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 114947, "client_id": 118415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68d6e4ec773383182bcec1ff3208f197", "srcset": "https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68d6e4ec773383182bcec1ff3208f197, https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef5ba12eb609555f228c60b63a16be80 2x, https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1de27d3c3a007a26b365efd91cff4c5f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6923558af2b83f15e00daa8306d8139", "srcset": "https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6923558af2b83f15e00daa8306d8139, https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c705d6b68f1309b60cc9924d2beafcdb 2x, https://si.imgix.net/0f39a424/uploads/origins/5fcf9978-21f6-41e7-be9b-f9ce86775d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e3aab4dbcaec419699dedac8df8cacc 3x"}, "body": "こんにちは\n前回もとても良いイラストを描いていただきありがとうございます\n今回はリリカルなのはシリーズのギンガの着衣パイズリをお願いします\n\n・おっぱいは爆乳盛りでお尻も大きく盛ったラスオリ体型な感じ\n\n・乳首ピアス(ストレートバーベルタイプhttps://www.roque.jp/blog/body-piercing-shape/#toc2でコスチューム越しにシルエットが分かる感じ)\n\n・ほっぺたにバーコードと番号(所有物として人権剥奪されてる感じ)\n\n・コスチュームはナンバーズスーツhttps://drive.google.com/drive/folders/1VPnWasOPwqxJaXHshpoVyIXAyXIJsq51\nで瞳は戦闘機人モードの金色の瞳でお願いします\n\n・ギンガの雰囲気は無表情で機械的な感じ\n\n・構図はhttps://drive.google.com/file/d/1m1ywL-hRa-xV8uiki860M2Wr586nyrY4/view?usp=drivesdkをベースにラブホで両穴を極太バイブ攻めされている状態でパイズリ奉仕している感じで\n差分で\n①パイズリ始め\n②パイズリ中\n③射精\n④射精後の余韻\n⑤バイブ振動最大で両穴絶頂\nをお願いします\n\n・竿役の逸物は馬並みで極太、カリ太の凶悪な感じで逸物全体にキスマークとフェラ跡付き\n\n・差分で\n　眼鏡\n　リード付き首輪\n　スリーサイズ及びカップ数\nをお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 114947, "client_id": 118415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63dab012338b9e43568ba22b568376e3", "srcset": "https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63dab012338b9e43568ba22b568376e3, https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca1e1700d1c459fc526520a42727a225 2x, https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0e962fdf6cc9be2ff16c48b351d8172 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97413a1b4596bb21f9a62e79058ae530", "srcset": "https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97413a1b4596bb21f9a62e79058ae530, https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afc2276760d889098b99e23d8d2b6de8 2x, https://si.imgix.net/4c986778/uploads/origins/2bb10b29-757e-4c89-a22f-c85d8428660c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=575e5380705bfb8b8bc17b3fa64288c4 3x"}, "body": "こんにちは\n境界線上のホライゾンの葵・喜美の着衣パイズリ奉仕をお願いします\n\n・キャラ資料\nhttps://drive.google.com/drive/folders/1xlsPH5xSXk0p4hSboijnA6k2qXQSS4y3\n\n・おっぱいは爆乳盛りでお尻も大きく盛ったラスオリ体型な感じ\n\n・アクセサリーで\n　・ドックタグ(バーコードと番号付き)\n　・描写可能なら乳首ピアス\n　・左手薬指に指輪をお願いします\n\n・コスチュームはコードギアスR2の黒の騎士団パイロットスーツhttps://drive.google.com/drive/folders/1eVqHIApuHfwFs9XV3AhYq56w-mN8OmiKで\nカラーリングはhttps://drive.google.com/drive/folders/1i_7jiMcMUl_EaG4hLl6m3G4oHZB3olKcのような感じ(ガンダムOOのレグナントイメージカラー)で\n肩の隊章はアリアダスト教導院の校章https://drive.google.com/drive/folders/1fh0WVcg5rhHQ-2WWZBgvp8WivNViN1CTをお願いします\n\n・構図はhttps://drive.google.com/file/d/1m1ywL-hRa-xV8uiki860M2Wr586nyrY4/view?usp=drivesdkをベースにラブホ的な所(資料のような後ろに鏡がある部屋)で両穴を極太バイブで攻められている状態でトーリ(主人公)に着衣パイズリ奉仕している感じで\n差分で\n①パイズリ前\n②パイズリ中\n③射精\n④射精後の余韻\n⑤逸物にキス\nをお願いします\n\nトーリの逸物は\n 　・馬並みで極太、カリ太 　\n　・逸物全体にピアスが散りばめられている \n　・キスマークとフェラ跡付き(赤色) の\n絶倫で凶悪な禍々しい感じの女哭かせのエグめのやつ \n\n・喜美に挿入されているバイブは太さはトーリの逸物と同じでイボイボが付いているタイプ\n(パイズリ後両穴ともすぐに使えるように準備しているイメージ)\n\n・差分で 　\n　・眼鏡\n　・リード付き首輪 　\n　・スリーサイズ及びカップ数表記 をお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@izta_/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d5b8088/uploads/origins/7b757966-d879-49cf-9785-3fe2b16ebca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57a1f94c72c47158a076d18f5855cfef", "srcset": "https://si.imgix.net/9d5b8088/uploads/origins/7b757966-d879-49cf-9785-3fe2b16ebca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57a1f94c72c47158a076d18f5855cfef, https://si.imgix.net/9d5b8088/uploads/origins/7b757966-d879-49cf-9785-3fe2b16ebca8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&