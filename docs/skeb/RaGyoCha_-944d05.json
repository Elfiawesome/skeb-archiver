少し隠して、少し顔を赤らめながら恥ずかしそうにしているかもしれません。\nその他、可能であれば作品の詳細はお任せしたいです。\nこの度はありがとうございました。\n\nhttps://drive.google.com/drive/folders/1f8-G7XGpkwVEYTOY74B5vz77AzYqN9XH?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RaGyoCha_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3772129, "client_id": 2008635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35d810e8/uploads/origins/097143a5-dfb2-455f-a736-6f459d88f262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bb652beb28c96a5fdea6ae156c00a54", "srcset": "https://si.imgix.net/35d810e8/uploads/origins/097143a5-dfb2-455f-a736-6f459d88f262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bb652beb28c96a5fdea6ae156c00a54, https://si.imgix.net/35d810e8/uploads/origins/097143a5-dfb2-455f-a736-6f459d88f262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e52637f219b3fc0f591ca2a8ccf411b 2x, https://si.imgix.net/35d810e8/uploads/origins/097143a5-dfb2-455f-a736-6f459d88f262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1b811574012e9f8b8e09c4ece161d3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35d810e8/uploads/origins/097143a5-dfb2-455f-a736-6f459d88f262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc3f17ff564ed14ba1b96d199e90f901", "srcset": "https://si.imgix.net/35d810e8/uploads/origins/097143a5-dfb2-455f-a736-6f459d88f262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc3f17ff564ed14ba1b96d199e90f901, https://si.imgix.net/35d810e8/uploads/origins/097143a5-dfb2-455f-a736-6f459d88f262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02a1d669bc991658d77685eb73001a4c 2x, https://si.imgix.ne