Vtuberとして活動している私のイラストを描いて頂きたいです。\n表情や服装やシチュエーション等全てお任せします！\n\n主に配信内や動画・配信サムネイルに使用させて頂きたいので、衣服の端や髪など、途切れないように描写していただけたら、とてもありがたいです。\n\nまた、キャラクターの透過をPSDで頂けたらとても嬉しいです・・・！\n\n【使用用途】\nYoutubeの配信関係・動画サムネやX(Twitter)など各種SNSで使用させて頂きたいです。\n不可な使い道のものがございましたらPSDデータ内でお伝えいただけますと幸いです。\n\nVTuber（OC） へのイラストや使用用途がジャンル外、モデルが気に入らない等で却下して頂いても問題ございません。\n条件等合いましたら何卒ご検討の程宜しくお願いします。\n\nhttps://drive.google.com/file/d/1Nj_Froa7lo1gMbQDfdPr1s2vJX9m7eAn/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leuca_wald/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3110553, "client_id": 3327416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeeee8f2/uploads/origins/614d2620-de38-4659-922c-b9dbba954943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a5c6a647f746e3b2cdc64939a1026f", "srcset": "https://si.imgix.net/eeeee8f2/uploads/origins/614d2620-de38-4659-922c-b9dbba954943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a5c6a647f746e3b2cdc64939a1026f, https://si.imgix.net/eeeee8f2/uploads/origins/614d2620-de38-4659-922c-b9dbba954943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f62123fdca59c48f65371578e26d8222 2x, https://si.imgix.net/eeeee8f2/uploads/origins/614d2620-de38-4659-922c-b9dbba954943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b074ec9fe233f112ae71bd349a3ae11c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeeee8f2/uploads/origins/614d2620-de38-4659-922c-b9dbba954943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cc2a2923cb1d8208cb8d05443ab0bf7", "srcset": "https://si.imgix.net/eeeee8f2/uploads/origins/614d2620-de38-4659-922c-b9dbba954943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2