4a\u4e16\u8a71\u306b\u306a\u3063\u3066\u304a\u308a\u307e\u3059\u3001\u306c\u304f\u30d7\u301c\u3068\u7533\u3057\u307e\u3059\u3002\n\u524d\u56de\u7d20\u6575\u306a\u7acb\u3061\u7d75\u3068\u4e00\u679a\u7d75\u3092\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01\u5948\u843d\u69d8\u306e\u63cf\u304b\u308c\u308b\u7d75\u7f8e\u3057\u3044\u306a\u2026\u2026\u3068\u6bce\u65e5\u306e\u3088\u3046\u306b\u62dd\u3093\u3067\u307e\u3059\u2026\u2026\ud83e\udd72\ud83d\udc97\n\u3082\u3057\u3088\u308d\u3057\u3051\u308c\u3070\u307e\u305fTRPG\u7acb\u3061\u7d75\u3092\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u3054\u9023\u7d61\u3057\u307e\u3057\u305f\uff01\u3054\u691c\u8a0e\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\ud83d\ude47\u200d\u2640\ufe0f\n\n\u4f9d\u983c\u3057\u305f\u3044\u306e\u306f\u30bd\u30fc\u30d7\u30b9\u30af\u30fc\u30eb\u3068\u3044\u3046\u30b7\u30ca\u30ea\u30aa\u306e\u4e2d\u5b66\u6559\u8aed(\u4f53\u80b2\u6559\u5e2b)\u306b\u306a\u308a\u307e\u3059\u3002\u203b\u3053\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u306b\u30cd\u30bf\u30d0\u30ec\u306f\u3054\u3056\u3044\u307e\u305b\u3093\u2026\u2026\uff01\n\u4ee5\u4e0b\u306b\u30ad\u30e3\u30e9\u306e\u60c5\u5831\u3092\u8a18\u8f09\u3044\u305f\u3057\u307e\u3059\u3002\u5c11\u3057\u9577\u304f\u306a\u308b\u306e\u3067\u3059\u304c\u3001\u3054\u78ba\u8a8d\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u751a\u3067\u3059\uff01\n\u30fb22\u6b73 \u7537\u6027\n\u30fb193cm 88kg \u5e7c\u5c11\u671f\u304b\u3089\u683c\u95d8\u6280\u3092\u3084\u3063\u3066\u3044\u305f\u306e\u3067\u30ac\u30bf\u30a4\u304c\u3044\u3044\u3067\u3059(\u30e0\u30ad\u30e0\u30ad\uff01\u3068\u3044\u3046\u3088\u308a\u66b4\u529b\u304c\u4f3c\u5408\u3046\u5927\u304d\u3044\u7537\u306e\u30a4\u30e1\u30fc\u30b8\u3067\u3059)\n\u30fb\u808c\u306e\u8272\u306f\u767d\u3081\u3067\u3059\u3002\n\u30fb\u9aea\u2192\u8840\u307f\u305f\u3044\u306a\u8d64\u8272\u306e\u9577\u3081\u30a6\u30eb\u30d5 \u524d\u9aea\u304c\u3046\u3056\u3081\u3067\u9854\u5468\