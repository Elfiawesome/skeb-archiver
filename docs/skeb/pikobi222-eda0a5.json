ins/3c6f2608-31b3-4bcf-a88c-0424cfd0fb12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d7ae18e1d381440393b9ce86ae5cafe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/921eb9a8/uploads/origins/3c6f2608-31b3-4bcf-a88c-0424cfd0fb12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38d00c1217855b7279bf0b213bac0009", "srcset": "https://si.imgix.net/921eb9a8/uploads/origins/3c6f2608-31b3-4bcf-a88c-0424cfd0fb12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38d00c1217855b7279bf0b213bac0009, https://si.imgix.net/921eb9a8/uploads/origins/3c6f2608-31b3-4bcf-a88c-0424cfd0fb12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=973e02cff97b35a991c059396be312d1 2x, https://si.imgix.net/921eb9a8/uploads/origins/3c6f2608-31b3-4bcf-a88c-0424cfd0fb12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=246d03c4e5be2c23ac443d81c9e75edc 3x"}, "body": "ご依頼失礼します。\n下記資料のかたつむりな感じの衣装を着た女の子を描いてみて頂けますか？\n指定は着せる衣装のみですので、中の女の子のデザインや触角や殻などの色といった細部はそちらにお任せします。\n\n衣装についてはアレンジや要素の付け足し等も歓迎ですのでお好きなようにやって頂けると幸いですが、\n手は先端まで完全に覆われ、足も長い裾で完全に隠れるローブや着ぐるみっぽい服ですので、手先や足先まで露出させないようにお願いします。\n\nそれから、衣装の手先部分のデザインに関してなのですが 先細りの先端が完全に閉じた形状と、ローブのようにたるみのある感じを両立した感じに描いて貰いたいです。\n衣装自体の資料とは別で下記に作例をご用意しましたので 可能であればこちらを参考に描いてみて頂きたいです。\n\nまた、頭の触覚の部分の解釈も自由ですので、そのまま触覚付きのカチューシャのように描いても、カチューシャ部分を省いて頭から直接触覚が生えてる感じに解釈してもどちらでも良いものとします。\n\n構図やポーズ等はそちらにお任せします。\n\n参考資料(衣装本体資料)↓\nhttps://imgur.com/a/qmGUT0v\n\n参考資料↓(衣装の手先部分資料)\nhttps://imgur.com/a/pgwjiMN", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pikobi222/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 456445, "client_id": 3341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efe602d5/uploads/or