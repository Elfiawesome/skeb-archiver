3f-bd3f-277c08733392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce07dbe0ece88fe247f42ca36838ffc9", "srcset": "https://si.imgix.net/34fa6403/uploads/origins/503df1c9-ca7f-4f3f-bd3f-277c08733392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce07dbe0ece88fe247f42ca36838ffc9, https://si.imgix.net/34fa6403/uploads/origins/503df1c9-ca7f-4f3f-bd3f-277c08733392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60d2bc5aa3cf172309272359bde78212 2x, https://si.imgix.net/34fa6403/uploads/origins/503df1c9-ca7f-4f3f-bd3f-277c08733392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b95e9e9f21f86e3d70b1af644c4a1c2e 3x"}, "body": "こんにちは、初めまして🙇\nXの方でいちすけさんの過去のツインビー(パステルとウインビー)のイラストを拝見しまして、私の不純な欲望を形にしていただけないかと思い、今回初めてリクエストを送信いたします。\nリクエスト内容は、全裸の人間の逸物を、\nウインビー(機体の方)が白い手袋の柔らかそうな大きなマジックハンドの手ですっぽり握って優しく扱いているようなイメージのイラストをお願いしたいです。\n参考イメージとして資料イラスト添付します。\n可能であれば、上半身をツインビー、グインビーがくすぐりや愛撫で弄んでいるようにもお願いしたいです。\n機体は公式設定だと、自由なサイズに大きくなったり小さくなったりできるようなので、機体のサイズはお任せします。\n当方手袋フェチも拗らせてまして、特に最近はカートゥーンキャラやソニックシリーズのキャラクターの白い手袋の大きな手にハマっておりまして、\nそのため、ウインビー達のマジックハンドの手は、人間の成人よりもひとまわり大きく描いてもらえると嬉しいです。\n(逸物もほぼ隠れるくらいのイメージで)\n人間は男性でもふたなりの女性でも大丈夫です。\nウインビーのマジックハンドはローションのような潤滑剤、性液などで濡れているように描いてくださると嬉しいです。\n構図はいちすけさんの描きやすい構図で構いません。\n\n希望は以上になります。\n大変特殊でニッチな内容かと思いますので、受諾が難しい場合は遠慮なくキャンセルしてくださって大丈夫です。\nよろしくお願いいたします。\n\nhttps://photos.app.goo.gl/pW6TtAquUkvHb5dE8", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichisuke150/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ef864de3/uploads/origins/af2ad878-0447-4fe9-ae3f-32d2ba127391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3847321a39ad4f70da32e06ef298277", "srcset": "https://si.imgix.net/ef864de3/uploads/origins/af2ad878