_same_genre": true}, {"path": "/@muguet_Succubus/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2727049, "client_id": 3556261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec00abb7bdb1de8f2ed33aed0e0de062", "srcset": "https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec00abb7bdb1de8f2ed33aed0e0de062, https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f980e42dc3e7becf3ae5f85f10782beb 2x, https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c10c92c977f8426c220dcac8d0c1757f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1644f0d98071f1df774452b43c802fea", "srcset": "https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1644f0d98071f1df774452b43c802fea, https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a745a03b462a1b07c3197781c8890dd 2x, https://si.imgix.net/38a3129a/uploads/origins/5c89b92c-104d-4111-9c2f-e5707f8e17cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f568da68f5df0a5c99900911277acbb6 3x"}, "body": "お疲れ様です。ツギハギです。先日は素敵なイラストを描いてくださりありがとうございます。連続での依頼となってしまい申し訳ないのですが今回もイラストをお願いしたく連絡させていただきました。\n\n依頼内容：前回書いていただいたキャラクターのデュエリスト風イラスト\n要望\n・前回と同じで構図等についてはベルムさんの書きやすいものを書いていただいて大丈夫です\n\n・可能であればデュエルディスクやカード等のイラストに盛り込んでいただき、一目でデュエリストとわかるものにしていただけるとありがたいです。\n\n・デュエルディスク、カードのデザイン、カードのイラスト等についてもベルムさんの書きやすいもの、イメージしやすいもので大丈夫です。\n\n・デュエリスト風のイラストにはモンスターが一緒に描かれていることが多いと思います。しかしこちらに関しては作画への労力が大きいと思われますのでこちらからは特に指定しませんので、書く書かない含めてベルムさんの裁量で判断していただいて大丈夫です。\n\nベルムさんも依頼が立て込んでいると思います。今回もベルムさんにイラストの内容を任せている部分が多く、時間がかかると思います。私のより先に依頼されていた方はもちろんのですが、後から依頼された方を優先してくださっても全然大丈夫です。余裕がある時に手を付けていただく程度で構いませんのでぜひイラストの方よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muguet_Succubus/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2727049, "client_id": 3556379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6dd1123/uploads/origins/fe1f6192-13dc-467d-b32a-9978dbe6826d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26df9b928278181cea3eba7b33f42a31", "srcset": "https://si.imgix.net/d6dd1123/uploads/origins/fe1f6192-13dc-467d-b32a-9978dbe6826d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26df9b928278181cea3eba7b33f42a31, https://si.imgix.net/d6dd1123/uploads/origins/fe1f6192-13dc-467d-b32a-9978dbe6826d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bd65ef70d78324ef86ab85177de0581 2x, https://si.imgix.net/d6dd1123/uploads/origins/fe1f6192-13dc-467d-b32a-9978dbe6826d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=887bdcc66d283cfcb5e26c892e974244 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6dd1123/uploads/origins/fe1f6192-13dc-467d-b32a-9978dbe6826d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29f76c139d0969d2cdc3b9e9dfd68b39", "srcset": "https://si.imgix.n