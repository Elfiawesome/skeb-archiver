origins/65182af4-2c29-4d6a-b4c2-fe8cc311b31d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a11c62ea1834e880308d6ec29971bffb 3x"}, "body": "お世話になっております。\nNovelLive13期研修生の烏野はるねと申します。\n\nHoka様のイラストを拝見し、ぜひご依頼申し上げたいと思いました。\n\nカラスの元使い魔である烏野はるねがカードを操り、優しく導きを示し出すようなイメージのイラストをお願いしたいです。\n容姿は立ち絵と同じく黒髪に緑の目、青いワンピースを希望しておりますが、ポーズや背景はHoka様にお任せしたいです。\n\nイラストはX、IRIAM配信にて、パネル開け画像、返礼品、サムネイルに使用予定です。\n※リアルグッズへの使用はありません。\n可能であれば、背景ありverと背景透過verをいただけますと幸いです。\n\n資料URLは参考になればと思い添付しましたが、Hoka様のお力に委ねたい所存です。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/170pqUbs-dRSGxW15gxZOoevICrLiiRE6", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hokka_tm/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1563928, "client_id": 3472273, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05c0a539/uploads/origins/4a8002a5-6c46-469e-85d6-4f4e08f5fe57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34acf4e8ff9ac87da444795383332f5b", "srcset": "https://si.imgix.net/05c0a539/uploads/origins/4a8002a5-6c46-469e-85d6-4f4e08f5fe57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34acf4e8ff9ac87da444795383332f5b, https://si.imgix.net/05c0a539/uploads/origins/4a8002a5-6c46-469e-85d6-4f4e08f5fe57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab1479ef186f01d3b755a307633095b8 2x, https://si.imgix.net/05c0a539/uploads/origins/4a8002a5-6c46-469e-85d6-4f4e08f5fe57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e5dd57a79a235475d36f96bb77e2cf9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05c0a539/uploads/origins/4a8002a5-6c46-469e-85d6-4f4e08f5fe57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2f53be19f1b46cc4ca9