びているが、その実頭にお花が咲いているようと言われるくらい、マイペースでふんわりとした優しい性格。\nしかしいざ本番となると雰囲気が一変、真剣な表情‎へと変わる。\n\n多くの名声と共にこの世を去った父の背中を追い続けてきたが、父と同じ景色を見ることなくレースを引退。\nその後は自分が自分らしくあれる場所を見つけ、仲間と新たな夢に向かって走り続けている。\n同居人のおてんば娘に振り回されつつも楽しい日々を過ごしている。\n\n\n〖構図・雰囲気等〗\nキャラクターの凛とした部分を生かし、儚い雰囲気で、細かい部分はお任せさせていただきます。\n\n〖使用用途〗\n個人鑑賞・SNSアイコン、ヘッダー\n\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/mobile/folders/1-saGtfks_Hs1FRebk6ahN1gtQyDtBeat", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utatane_neothi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1219648, "client_id": 1866639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f6198d5/uploads/origins/72cfe6ba-cab7-472b-adb8-daf38a71751a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c472556b9411553097d14263aaef0bb8", "srcset": "https://si.imgix.net/2f6198d5/uploads/origins/72cfe6ba-cab7-472b-adb8-daf38a71751a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c472556b9411553097d14263aaef0bb8, https://si.imgix.net/2f6198d5/uploads/origins/72cfe6ba-cab7-472b-adb8-daf38a71751a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a256ed093d54429dad413d5e5da719b5 2x, https://si.imgix.net/2f6198d5/uploads/origins/72cfe6ba-cab7-472b-adb8-daf38a71751a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a579ee5ef7fe4c547d40c0ff91fbdac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f6198d5/uploads/origins/72cfe6ba-cab7-472b-adb8-daf38a71751a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbae4231667dc8142b6c090ac27a3c39", "srcset": "https://si.imgix.net/2f6198d5/uploads/origins/72cfe6ba-cab7-472b-adb8-daf38a71751a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbae4231667dc8142b6c0