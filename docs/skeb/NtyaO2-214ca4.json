ploads/origins/2791fcc3-d09e-48c0-9dce-77620b6883a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4427ac540e540632069b9a93840a6a80 3x"}, "body": "初めまして、Xで募集を拝見しまして、skebの作品を見たところ、とても可愛かったのでリクエストさせていただきます！\n\n描いて欲しいのは、柏壬（はくみ）というOCで、この子に自由にコスプレをさせて欲しいなと思っています。出来ればえっち系だと嬉しいですが、ntya様が可愛い、綺麗などと思う衣装でも大丈夫です！\n資料にいろいろ詰め込んであるので、その衣装でもいいですし、全く関係ないものでも大丈夫です！\n構図などもお任せ致します。\n\n柏壬（はくみ）\n22歳、薄緑のロングヘアーに薄緑の瞳、170cmで高身長のコスプレ趣味のお姉さん。胸はHカップでボンキュッボンなタイプです。妹と一緒にコスプレをするのが趣味。髪を伸ばしてるのはいろいろアレンジできるから。腰下までの長さです。\n\nご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1jqMr3hmcZtI4Pbkjvhu2E8_xiN3yJni5\nhttps://drive.google.com/drive/folders/1rMpeaTqE_NIfZI4au9Uve-y6UVHkmi2g", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NtyaO2/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3924447, "client_id": 2004066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea7bd348/uploads/origins/602a54fc-a70c-4dbb-b722-429909766c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c599d46b58d2638766b357544cae19f3", "srcset": "https://si.imgix.net/ea7bd348/uploads/origins/602a54fc-a70c-4dbb-b722-429909766c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c599d46b58d2638766b357544cae19f3, https://si.imgix.net/ea7bd348/uploads/origins/602a54fc-a70c-4dbb-b722-429909766c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e40223b02beac94fb42a1133d7a0a85 2x, https://si.imgix.net/ea7bd348/uploads/origins/602a54fc-a70c-4dbb-b722-429909766c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b944bb05f2f60d194846bdaac5fcd57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea7bd348/uploads/origins/602a54fc-a70c-4dbb-b722-429909766c0e?bg=%23fff&auto=format%