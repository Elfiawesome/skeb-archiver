になっている) \n⚫希望の流れ \n1夫婦の自己紹介と先生夫妻、サークルの紹介\n2～4(可能なら2〜5)サークルでの活動(衆人環視での先生と妻のセックス実演、奥さんと夫の練習等※夫婦同士での行為は無しで)\nラスト 夫と妻の営み(いちゃラブ)", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_pace_penis/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/853b46e7/requests/130813_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c13eb3997fb48a6ebae033dc077dcbc", "srcset": "https://si.imgix.net/853b46e7/requests/130813_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c13eb3997fb48a6ebae033dc077dcbc, https://si.imgix.net/853b46e7/requests/130813_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8abfccc4d95d98f241352297e961521f 2x, https://si.imgix.net/853b46e7/requests/130813_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af05b3af7c91b9d38d3be8eceeaa6f2c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 533343, "client_id": 53567, "nc": 32}, {"path": "/@s_pace_penis/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c888751f/requests/96369_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36618d4ff07d6c9bc3f33cd52a37575f", "srcset": "https://si.imgix.net/c888751f/requests/96369_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36618d4ff07d6c9bc3f33cd52a37575f,