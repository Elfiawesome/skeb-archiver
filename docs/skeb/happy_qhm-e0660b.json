blur=200&s=fc4545b0d36d83297824703fcfd64029 3x"}, "body": "以前からhappy_funさんのNTRシチュやBBC堕ちのこよちゃんの絵を見てファンになったので、\n今回Skebを開けてくれたのでリクエストしたいと思います！\n\n【キャラ名】\n博衣こより\n\n【シチュエーション】\n助手くんの性癖に付き合うためにデカチンの黒人に抱かれた結果、BBC堕ちしまったこよちゃんをお願いします\n\n・体位はベッドの上で正常位のPOVや片足上げ後側位\n・何度も犯されて使ったゴムがベッドの周り散らばっていたり、こよちゃんの体や服(ベルト)に付けている状況です\n・助手くんを裏切って黒人様の専用肉便器になる事を宣言しながら、生で中出しをねだる完全に堕ちたこよちゃんに黒人が生で中出しします\n\n【その他】\n・BBC堕ちして体にQOSのタトゥーや色んならくがきがされた差分・ビッチ化差分もお願いします\n・シチュエーションに合う他の体位やセリフに変えても大丈夫です！\n\n値段や内容に問題あれば再送やキャンセルをお願いします！\nP.S.リクエスト内容を修正したので、難しいならキャンセルしても大丈夫です！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@happy_qhm/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ca0f5962/uploads/origins/2187f931-f06a-4b44-b8b9-7c3ee46e973a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dabfe4f8208646e1ced83433c702d87f", "srcset": "https://si.imgix.net/ca0f5962/uploads/origins/2187f931-f06a-4b44-b8b9-7c3ee46e973a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dabfe4f8208646e1ced83433c702d87f, https://si.imgix.net/ca0f5962/uploads/origins/2187f931-f06a-4b44-b8b9-7c3ee46e973a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e251632c61479a666e5df30fd322c498 2x, https://si.imgix.net/ca0f5962/uploads/origins/2187f931-f06a-4b44-b8b9-7c3ee46e973a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1798f858b5e26d3bdaf3a01c2a6f12c1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1455021, "client_id": 666492, "nc": 176}, {"path": "/@happy_qhm/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1455021, "client_id": 617656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5977d258c59b98c8bc25e2bed01b41b0", "srcset": "https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5977d258c59b98c8bc25e2bed01b41b0, https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e5d9eda065bb76051239265fd8421f6 2x, https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08f9f9d97f0d966a4274577d57b6fbe0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3735e4f7ffcec8fff9f0739b0d361fd", "srcset": "https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3735e4f7ffcec8fff9f0739b0d361fd, https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=998a546dcb9368dbfcf356cd7aa27992 2x, https://si.imgix.net/ad3434c1/uploads/origins/bd82a98b-aa5a-4312-87c7-461f2a54328a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca678c0f50428854634d923c4bc7c562 3x"}, "body": "こんにちは、初めて依頼させて頂きます！\n\n博衣こよりの過去絵が凄く好みで(下記リンク)、似たような見せ方のフルネルソンをお願いしたいと思います。\nhttps://www.pixiv.net/artworks/101366635\n\nフルネルソンで筋肉質な男に黒光り巨根でたっぷり種付けされ、粘り気高めな精液が大量に股間から滴り落ちる博衣こより\n巨根は種付けが終わって勃ってない状態\nこよりはアヘ顔に近いトロ顔でチン負けしてる表情\nフルネルソンで種付け後のこよりを見せ付ける構図\n生配信みたいな感じのイメージ\n台詞は出来ればつけて貰えると嬉しいです(無くても大丈夫です)\n\nご検討宜しくお願いします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@happy_qhm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1455021, "client_id": 2292675, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820c1e8ff9cb89c905c6835471254bae", "srcset": "https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=820c1e8ff9cb89c905c6835471254bae, https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57b9234f722137f14879418357420c16 2x, https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41a194814e490170dc1bfdf5b222ed2d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de4947163c4e4b0317e1200e78706cf0", "srcset": "https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de4947163c4e4b0317e1200e78706cf0, https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99229aa2b821402e9f5c824c26cc79b5 2x, https://si.imgix.net/c4e48547/uploads/origins/96c0d616-f37b-4a93-9a64-e3de6442d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50df85d54c52e428b6e7cad49c5fb8d5 3x"}, "body": "お世話になっております。また依頼しにきました\n今回の依頼内容はこちらです\n\nー－－\n■キャラ\nホロライブの「不知火フレア」\n衣装はこちらのメイン衣装でお願いします\n(https://pbs.twimg.com/media/FMCpRM6VIAItG4r?format=jpg&name=4096x4096)\n\n■シチュ\n街中でチャラ男二人にナンパされて、押しに弱くて断りきれず、そのままラブホに連れてかれてハメられたフレアちゃん\n\n■流れ\n①ナンパシーン\nフレアはチャラ男二人に囲まれて、表情はちょっと困ってる感じでお願いします\n台詞は先生にお任せします。\n\n②ラブホでいっぱい犯された後フレアちゃん\n体位はこちらの2枚目のあくたんみたいな感じの、「仰向けに倒れてる」感じで、ベッドの上やフレアの体の上に使用済みのコンドームがばら撒いてる感じでお願いします\nhttps://www.pixiv.net/artworks/105678385\n\nフレアは失神してる感じで、チャラ男の一人は倒れてるフレアにちんぽをしゃぶらせて、「こちらも掃除頼むねｗ」みたいな感じでお願いします\n他の台詞は先生にお任せします\n\n③後日談シーン\nもし金額的に大丈夫でしたら、先生のこちらのトワ様みたいなイラスト一枚をお願いしたいです\nhttps://twitter.com/happy_qhm/status/1621161279892357125\n\nフレアはスカートをたくし上げて、その下に落書きと使用済みのコンドームがある感じでお願いします\n台詞は先生にお任せします\n\n---\n依頼内容は以上です。\n二枚目のラブホシーンについて、この体位は難しかったら、先生が描きやすいように体位変更してもOKです（トワ様ナンパNTRのあの後背位も結構好きです）\nご検討のほどよろしくお願いします\n\nhttps://pbs.twimg.com/media/FMCpRM6VIAItG4r?format=jpg&name=4096x4096", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@happy_qhm/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e78f13ff/uploads/origins/6c5fb592-2653-4634-a5b3-5010a148524a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b13b88241f1d414c328d77ff8efd77a", "srcset": "https://si.imgix.net/e78f13ff/uploads/origins/6c5fb592-2653-4634-a5b3-5010a148524a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1b13b88241f1d414c328d77ff8efd77a, https://si.imgix.net/e78f13ff/uploads/origins/6c5fb592-2653-4634-a5b3-5010a148524a?bg=%23fff&auto=format%2Ccompress&fm=we