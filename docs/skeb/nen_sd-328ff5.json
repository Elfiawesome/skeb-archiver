\n\n金額や依頼内容的に不足があれば再送依頼や、難しければキャンセルして頂いて構いません。お忙しい中恐れ入りますがご検討いただけますと幸いです。よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1TtWZugWhUDFDpDDdU_xJ6OYyn6-ekC3e?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nen_sd/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/05ec30fa/uploads/origins/4d5b1b39-9380-4b8f-831f-faa86739dcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5def9b75667761cd080cfe8938f5d3c7", "srcset": "https://si.imgix.net/05ec30fa/uploads/origins/4d5b1b39-9380-4b8f-831f-faa86739dcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5def9b75667761cd080cfe8938f5d3c7, https://si.imgix.net/05ec30fa/uploads/origins/4d5b1b39-9380-4b8f-831f-faa86739dcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f5ba32e638a3aa18123d9ef6805556a0 2x, https://si.imgix.net/05ec30fa/uploads/origins/4d5b1b39-9380-4b8f-831f-faa86739dcbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74124bfd1940b4b0725f3856d924af57 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3829293, "client_id": 3782672, "nc": 144}, {"path": "/@nen_sd/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3829293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7a8f847/uploads/origins/1d252271-6450-4d94-b226-0319ff15d12c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b1334a855d84134685df7d7cfe850bb", "srcset