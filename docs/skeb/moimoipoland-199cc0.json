ormat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7600c7c0001f600af822699762af0be2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9769a99a/uploads/origins/04aa1ea2-78bf-48bb-9c75-de3f7fa5e193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=843d582b933708c1d3288d7c845d866f", "srcset": "https://si.imgix.net/9769a99a/uploads/origins/04aa1ea2-78bf-48bb-9c75-de3f7fa5e193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=843d582b933708c1d3288d7c845d866f, https://si.imgix.net/9769a99a/uploads/origins/04aa1ea2-78bf-48bb-9c75-de3f7fa5e193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e561a0c75cf177822b221aea681111fc 2x, https://si.imgix.net/9769a99a/uploads/origins/04aa1ea2-78bf-48bb-9c75-de3f7fa5e193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e72f90e6a04c7e6ec8655125d5063743 3x"}, "body": "\u3044\u3064\u3082\u304a\u4e16\u8a71\u306b\u306a\u3063\u3066\u3044\u307e\u3059\uff01\n\u30b9\u30b1\u30d6\u4f9d\u983c\u521d\u5fc3\u8005\u3067\u3059\u304c\u662f\u975e\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\n\u3010\u304a\u9858\u3044\u3057\u305f\u3044\u30c6\u30fc\u30de\u3011\n\u8907\u6570\u306eblobcat(\u306b\u3083\u3093\u3077\u3063\u3077\u30fc)\u304c\u8272\u3093\u306a\u8868\u60c5\u3067\u30b9\u30ad\u30e5\u30fc\u30d0\u30c0\u30a4\u30d3\u30f3\u30b0\u3057\u3066\u3044\u308b\u69d8\u5b50\n\n\u3010\u30a4\u30e9\u30b9\u30c8\u306e\u76ee\u7684\u3011\nMisskey.io\u306e\u30d7\u30ed\u30d5\u30da\u30fc\u30b8\u306e\u30d8\u30c3\u30c0\u30fc\u306b\u4f7f\u7528\u3057\u305f\u3044\u3067\u3059\u3002\n(\u53ef\u80fd\u3067\u3057\u305f\u3089\u6a2a\u5411\u304d3.2:1\u306e\u30a4\u30e9\u30b9\u30c8\u6bd4\u7387\u306b\u3057\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5927\u5909\u5b09\u3057\u3044\u3067\u3059)\n\n\u3010\u7d30\u304b\u3044\u8981\u671b\u3011\n\u30fb\u5834\u9762\u306f\u6c34\u4e2d(\u80cc\u666f\u306f\u30b7\u30f3\u30d7\u30eb\u306b\u6c34\u4e2d\u3063\u307d\u3044\u6c34\u8272\u306e\u82e5\u5e72\u30b0\u30e9\u30fc\u30c7\u30fc\u30b7\u30e7\u30f3\u3001\u53c2\u8003\u306b\u5b9f\u969b\u306e\u6c34\u4e2d\u5199\u771f\u3092\u304a\u9001\u308a\u3057\u307e\u3059)\n\u30fb\u30c0\u30a4\u30d3\u30f3\u30b0\u306e\u6a5f\u6750(\u80cc\u4e2d\u306e\u30bf\u30f3\u30af(\u30dc\u30f3\u30d9)\u30fb\u547c\u5438\u5668(\u30ec\u30ae\u30e5\u30ec\u30fc\u30bf\u30fc)\u30fb\u30de\u30b9\u30af(\u96e3\u3057\u3044\u5834\u5408\u306f\u7701\u7565\u3067OK\u3067\u3059))\u3092\u6c34\u4e2d\u88c5\u5099\u306e\u72b6\u614b(\u30ad\u30e3\u30e9\u306e\u914d\u7f6e\u3084\u30dd\u30fc\u30ba\u3067\u898b\u3048\u306a\u3044\u90e8\u5206\u306f\u63cf\u304b\u306a\u304f\u3066\u5927\u4e08\u592b\u3067\u3059)\n\u30fb\u5404\u7a2e\u88c5\u5099\u306e\u30c7\u30b6\u30a4\u30f3\u3084\u8868\u60c5\u3001\u30dd\u30fc\u30ba\u7b49\u306f\u5148\u751f\u306e\u304a\u597d\u307f\u3067\u304a\u307e\u304b\u305b\u3057\u307e\u3059\u3002\n\u30fb\u5143\u304c\u30c7\u30d5\u30a9\u30eb\u30e1\u30ad\u30e3\u30e9\u306a\u306e\u3067\u3001\u5148\u751f\u306e\u4f5c\u98a8\u306b\u5408\u308f\u305b\u3066\u304b\u306a\u308a\u30c7\u30d5\u30a9\u30eb\u30e1\u3092\u5165\u308c\u3066\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\u3002\n\n\u3010\u5099\u8003\u3011\n\u30fb\u5927\u5909\u624b\u9593\u306e\u304b\u304b\u308b\u4f9d\u983c\u306a\u3053\u3068\u306f\u8a8d\u8b58\u3057\u3066\u307e\u3059\u306e\u3067\u3001\u96e3\u3057\u3044\u5834\u5408\u306f\u9060\u616e\u306a\u304f\u30ad\u30e3\u30f3\u30bb\u30eb\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\u3002\n\u30fb\u5f53\u65b9\u30b9\u30b1\u30d6\u4f9d\u983c\u306f\u6163\u308c\u3066\u3044\u306a\u3044\u306e\u3067\u3001\u4e0d\u5099\u7b49\u3042\u3063\u305f\u969b\u3082\u30ad\u30e3\u30f3\u30bb\u30eb\u9802\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\u3002\n\u30fb\u6700\u8fd1PC\u306e\u8abf\u5b50\u306f\u3044\u304b\u304c\u3067\u3057\u3087\u3046\u304b\uff1f\u6025\u304e\u306e\u5185\u5bb9\u3067\u3082\u306a\u3044\u306e\