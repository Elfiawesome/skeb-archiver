も気に入っております\nもしよろしければ、また違う衣装で同じキャラクターを依頼させてください\n\n・希望する内容を箇条書きで\n「依頼衣装（夏服）」というファイルの衣装を着せてあげてください\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n過去依頼作品と同じように、えっちなイメージで自由に描いていただければ\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装は着衣～半脱ぎくらいでお願いします\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@comiTI7_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3407111, "client_id": 2994739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04e783fc/uploads/origins/5b51f0dd-4f69-4d00-85fc-042fffa9bcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce1aeb91a01dca993705846fe1755be7", "srcset": "https://si.imgix.net/04e783fc/uploads/origins/5b51f0dd-4f69-4d00-85fc-042fffa9bcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce1aeb91a01dca993705846fe1755be7, https://si.imgix.net/04e783fc/uploads/origins/5b51f0dd-4f69-4d00-85fc-042fffa9bcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3fc447d0d0de8e8abd89786b8e968ec 2x, https://si.imgix.net/04e783fc/uploads/origins/5b51f0dd-4f69-4d00-85fc-042fffa9bcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef4a7d7407eac32cc51f86dd9fbb4bc6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04e783fc/uploads/origins/5b51f0dd-4f69-4d00-85fc-042fffa9bcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31c60206afe0d62d9d0ae0437e1c37e1", "srcset": "https://si.imgix.net/04e783fc/uploads/origins/5b51f0dd-4f69-4d00-85fc-042fffa9bcb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31c60206afe0d62d9d0ae0437e1c37e1, https://si.imgix.net/04e783fc/