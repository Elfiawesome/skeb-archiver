 学院長は可哀想なニンゲンを地下の檻で保護してくださるヤバ・・・心優しいバーチャルペットブリーダーなのでファンをペットとしてキャラクター化しています。  ↓（ファン）ペットの資料です。基本2等身？ですが4足歩行になったり手足の有無、色、大きさもアバウトです。   https://twitter.com/reky3980/status/1347166791374499843 https://twitter.com/doukaiteiou/status/1670016634222956546  学院長1人だと寂しい時など背景・小物・脇役として一緒に描いていただいても良いですし、学院長お一人だけを集中して描いていただいても勿論OKです。 全てお任せします。  イラストは学院長が商用含めてサムネやグッズなどに使用させていただくかもしれません（学院長次第なので使用されない可能性もあります） 御検討お願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tokumaro/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 73660, "client_id": 3135174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae1d1009/uploads/origins/05f51440-e45f-4af4-97d1-abacba8968a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b473ee1b47f93714cb5d46e76410606a", "srcset": "https://si.imgix.net/ae1d1009/uploads/origins/05f51440-e45f-4af4-97d1-abacba8968a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b473ee1b47f93714cb5d46e76410606a, https://si.imgix.net/ae1d1009/uploads/origins/05f51440-e45f-4af4-97d1-abacba8968a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be6386056ceabef9bff676dfb269d5c6 2x, https://si.imgix.net/ae1d1009/uploads/origins/05f51440-e45f-4af4-97d1-abacba8968a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c605f27e61892e8d0cf119faaaa274e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae1d1009/uploads/origins/05f51440-e45f-4af4-97d1-abacba8968a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=152745cddb01955ef6c94e4064c9c237", "srcset": "https://si.imgix.net/ae1d1009/uploads/origins/05f51440-e45f-4af4-97d1-abacba8968a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=152745cddb01955ef6c94e4