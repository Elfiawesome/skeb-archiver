op=top&w=200&h=200&blur=200&s=a5caa80c34c04ba66697288c6daaf36f", "srcset": "https://si.imgix.net/7c34274c/uploads/origins/81c28d22-682b-43fe-acdb-d4fd025d817e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5caa80c34c04ba66697288c6daaf36f, https://si.imgix.net/7c34274c/uploads/origins/81c28d22-682b-43fe-acdb-d4fd025d817e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=92d4c9fe84ff834520f742390347d986 2x, https://si.imgix.net/7c34274c/uploads/origins/81c28d22-682b-43fe-acdb-d4fd025d817e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a038368aa73706f17504e50c5ddceee1 3x"}, "body": "蛇足さん、こんにちは！　あひるです。\n\n私のオリジナルキャラクター「烏(からす)」を書いていただきたいです！\n\n資料は一番下のリンクにあります。\n\n観賞用で紙に印刷、スマホやiPad、PCの壁紙、その他第三者に公開しない範囲での利用を想定しています。\nグッズ化・SNSアイコン等への使用は予定していませんが、したいときはまた相談いたします。\n\n依頼内容の詳細ですが、イラストの内容や要素に迷った際の参考にしていただけますと幸いです。\n基本的には蛇足さんのお好きなように描いていただければと思います。\n\n・形式、サイズ\npsd(skeb推奨)、png、jpeg形式だと助かります。\nサイズは何でも大丈夫です。\n\n・シチュエーションなど\n魔物姿のほうでお願いします。\n服装はスーツ、もしくは仕事着\n仕事着の資料が少ないので、現実の警察官っぽい格好でもOKです。\nできれば全身\n翼か手、足は一部でも入れていただけると嬉しいです。\n仕事中の烏、とりあえず警察官の烏が見たいです。\n公式だと人間+魔物という見た目ですが、蛇足さんの好みに合わせてケモ度上げていただいても大丈夫です！\n背景は街の中、もしくは空や森、草原など自然物\n世界観的には現代(昭和〜平成)\n風景のファンタジー要素もしくはSF要素は少なめ\n\n・表情\n真顔、おすまし、悪い笑顔、皮肉っぽい表情などが似合う男です。\n\n以上、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-DEuhH1NahepbOFQHQK3EKgKSqc8D8hX", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Uzuya_syu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2594572, "client_id": 1688789, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bba581efb600aa294a2b0613578d09ec", "srcset": "https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bba581efb600aa294a2b0613578d09ec, https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc4cd1796f4638a5543059c477da6661 2x, https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a01687eed53c6f57e8cbde4eb2fa3e5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bb09392982979cf45af3a96abf12e6c", "srcset": "https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bb09392982979cf45af3a96abf12e6c, https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbb8c4e646d9bbe38bad9ec7479d9079 2x, https://si.imgix.net/8d7e5077/uploads/origins/2b324ae8-f9f6-4b2e-928c-ed876f4cfe92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=228058f39c3b183ddcf2eeb2d85e9f44 3x"}, "body": "渦屋さん、こんにちは！　あひるです。\n\n早速ですが、私のオリジナルキャラクター「烏(からす)」を書いていただきたいです！\n\n資料は以下のリンクにあります。\nhttps://drive.google.com/drive/folders/1-DEuhH1NahepbOFQHQK3EKgKSqc8D8hX?usp=sharing\n\n観賞用で紙に印刷、スマホやiPadの壁紙、その他第三者に公開しない範囲での利用を想定しています。\nグッズ化・SNSアイコン等への使用は今のところ予定していませんが、したいときはまた相談いたします。\n\n\n\nここから依頼内容の詳細ですが、全ての項目はイラストの内容・要素に迷った際の参考にしていただけますと幸いです。\n基本的には渦屋さんのお好きなように描いていただければと思います。\n\n・サイズ、形式\npsd(skeb推奨)、png、jpeg形式だと助かります。\niPadの画面サイズが横768px、縦1024pxで、これに合わせていただけると印刷等もしやすそうです。\nちなみに縦長でも横長でも大丈夫です。\n9:12のサイズもスマホ壁紙に使えるので嬉しいです。\n\n・背景\nあっても無くても大丈夫です。\n特に思いつかないのでお任せいたします。\n強いて言うなら暗めだとホーム画面が見やすいです。\n\n・ポーズなど\n魔物姿のほうでお願いします。\n全身、難しければバストアップ(顔)\n翼か手、足は一部でも入れていただけると嬉しいです。（個人的な好きポイントなので……！）\nちなみに翼はON・OFF切り替えできますので、無くても設定上の問題はありません。\n\n・表情\n真顔、おすまし、悪い笑顔など\nひねくれた男なのでそういう表情が似合います。\n真顔は三白眼のせいで怒っているように見えるかも……くらいの感じだとかわいいです。\n\n・服装\n以下のどれかでお願いします。\nスーツ\n戦闘服(魔物の姿の資料にあるような感じ、腕章は無くしてください)\nパーカー(色は黒、グレーなど彩度低めかつ地味で)\n\n・その他\n昨今の状況を鑑み、SNSに載せる際はサイン・ウォーターマークなどをお願いいたします。\nskeb上では渦屋さんの判断で構いません。\n\nhttps://drive.google.com/drive/folders/1-DEuhH1NahepbOFQHQK3EKgKSqc8D8hX?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@96haiki/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2142282, "client_id": 1688789, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e8b4c42/uploads/origins/faedffa7-8cb1-4e5d-af10-3314db402af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=631d3c157411201da259a98736e8eb38", "srcset": "https://si.imgix.net/9e8b4c42/uploads/origins/faedffa7-8cb1-4e5d-af10-3314db402af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=631d3c157411201da259a98736e8eb38, https://si.imgix.net/9e8b4c42/uploads/origins/faedffa7-8cb1-4e5d-af10-3314db402af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68ac1950e4ecfcd48c0e4ab7990a87d2 2x, https://si.imgix.net/9e8b4c42/uploads/origins/faedffa7-8cb1-4e5d-af10-3314db402af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17ded2ee0b2175592d4e6b43ef89a320 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e8b4c42/uploads/origins/faedffa7-8cb1-4e5d-af10-3314db402af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d4468d711000476c63d104f56d28c5b", "srcset": "https://si.imgix.net/9e8b4c42/uploads/origins/faedffa7-8cb1-4e5d-af10-3314db402af7?bg=%23fff&auto=for