c7a2/uploads/origins/c83de8ec-7edc-4ca8-b2c4-3b9f7daf1e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c84db2ed14569bf5155d35dfb03bfa0, https://si.imgix.net/2ce5c7a2/uploads/origins/c83de8ec-7edc-4ca8-b2c4-3b9f7daf1e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=816bd403d139bf91fae415902a5b9878 2x, https://si.imgix.net/2ce5c7a2/uploads/origins/c83de8ec-7edc-4ca8-b2c4-3b9f7daf1e51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c27f0c1dde8d10a18766aeb90f08d122 3x"}, "body": "以前拝見したござぽこのイラストがとても可愛らしかったのでリクエストさせていただきます。\n\n描いていただきたいのは、自分のSNS、Youtubeアカウント（視聴用）のアイコン用イラストになります。\n\n【描いていただきたいイメージ】\n・個人Vtuberのアンバー・シャルロットさん（資料参照）の頭の上にうにが乗っているイメージ（なのでトゲはソフトな感じでお願いします）\n・アンバーさんの衣装は資料のバリエーションで赤枠が付いているものでお願いいたします。（簡略化等もOKです）\n・配信部屋参考画像は前髪がぱっつんですが、今回は他参考画像のように前髪アリでお願いいたします。\n・アンバーさんの表情・帽子の有無等はお任せいたします。\n\n【使用用途】\n描いていただいたイラストは自身のSNS（Xが主）、Youtubeの視聴アカウントアイコンにさせていただきたいと思っております。\n\nまた可能であれば、うにが乗っていないアンバーさん単体での状態もいただけるとありがたいです。\nその際はご本人にプレゼントさせていただきたいため、今後の配信（収益化済み）でのサムネイル（トリミング・色味調整含む）やX等の活動で使用する許可をいただきたいです。\n\n上記問題なければお引き受けいただけると嬉しいです。\n\n以下、アンバー・シャルロットさんの詳細になります。\n▼X（固定に通常衣装の三面図があります）\nhttps://x.com/Ambre0Charlotte\n▼Youtube\nhttps://www.youtube.com/@Ambre_Charlotte\n▼人物詳細\n・スチームパンクな地下街の洋服店に住み込みで働くデザイナー見習い\n・お絵描きとごはん＆スイーツが好き\n・もふもふな黒猫を飼っている\n・清楚な癒しボイス\n\nご検討の程、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15qCSaDfQ62zfQWJwMyONOUgLkDHbzYWj?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzunoki_t/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2141491, "client_id": 1747277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3328102b/uploads/origins/fded6f2d-0f8e-486f-90ea-7985499d995a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80ba73268bd024cec667c2bcfac4f9d0", "srcset":