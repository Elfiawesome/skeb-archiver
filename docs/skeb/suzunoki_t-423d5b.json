透過済のPNGデータでお願いしたいです。\n\n何卒ご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suzunoki_t/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2141491, "client_id": 1526681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34cf081822aa7515cab443229a1f1a53", "srcset": "https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34cf081822aa7515cab443229a1f1a53, https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d12a9f6620859726ffb3f97bcd2d759 2x, https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7aa0ff837b4068e5bfb8e26d7278fff0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9358e3bf8386d99df3900a23dbc15e38", "srcset": "https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9358e3bf8386d99df3900a23dbc15e38, https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=787d64c61b7cfb07fe92ec9b7a825b11 2x, https://si.imgix.net/85eac4e2/uploads/origins/ff343f6c-9da8-478a-aef8-1bb8a077b22d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=to