で、ニヒルな笑みを浮かべている\nカザナの表情：「えっ！？」みたいな感じで驚いて顔を赤くしている\n\nカザナの服装についてなのですが、ワンピースの世界観に沿ったイメージで、少しボーイッシュ寄り(ボーイッシュ過ぎない感じ)でお願いしたいです！\n\nカザナの容姿は16歳の時の方でお願いします！\n\n金額が合えば背景の方もお願いしたく思っております！\n\n【キャラ詳細や身長差･ストーリーを纏めているGoogleフォトURL】\nhttps://photos.app.goo.gl/LafBURoLmhdGT3NR9\n\n【イメージソング】\nhttps://music.apple.com/jp/playlist/%E3%82%A8%E3%83%BC%E3%82%AB%E3%82%B6%E3%82%A4%E3%83%A1%E3%82%BD%E3%83%B3/pl.u-ZmblxW1FVLED9Bq\n\nお忙しい中誠に恐れ入りますが、何卒ご検討の程宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@S2zkS2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1925705, "client_id": 1713096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d043cdf/uploads/origins/7ce23fdc-e735-4a18-a465-f46274eaace1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf67e1cd3af90b65fd8147c170627897", "srcset": "https://si.imgix.net/5d043cdf/uploads/origins/7ce23fdc-e735-4a18-a465-f46274eaace1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf67e1cd3af90b65fd8147c170627897, https://si.imgix.net/5d043cdf/uploads/origins/7ce23fdc-e735-4a18-a465-f46274eaace1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f38c18042d42c6779b8e4194abc2cb0 2x, https://si.imgix.net/5d043cdf/uploads/origins/7ce23fdc-e735-4a18-a465-f46274eaace1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13609830c89eeea1f7007d28a8442ba3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d043cdf/uploads/origins/7ce23fdc-e735-4a18-a465-f46274eaace1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cdd2ed9f563dd724329a27ab624342c", "srcset": "https://si.imgix.net/5d043cdf/uploads/origins/7ce23fdc-e735-4a18-a465-f46274eaace1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&b