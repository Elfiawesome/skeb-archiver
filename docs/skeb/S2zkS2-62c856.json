sp=sharing\n外見や簡易プロフィールなどはGoogleDriveよりご確認願います。\n\n◆絵柄に関して\n今回はZKei様のtwitterアイコンやヘッダーのワンピイラストのような【全体的にピンク色っぽく、塗り込み控えめな画風】でお願いしたいです。\n背景も風景ではなく【パターン・柄物】を希望します。\n(ルハンのイラストめちゃくちゃ好きなので…！似たテイストのものをお願いしたいです)\n\n◆構図に関して\n【おまかせ】でお願いしたく思います。\n衣装も資料の中から選んでいただいても、全く別のものを着せて頂いても構いません。\n\n◆NSFWに関して\n念のため入れているという感覚なので、NSFW設定にこだわらずZKei様のお好きなように描いて頂けましたら幸いです。\n\n◆用途\n・SNSプロフィール画像での使用\n・他のコミッション依頼時の参考資料として使用\n・個人観賞用の印刷\n上記３点許可頂けましたら幸いです。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iGM9xhI8AWKu_oWoV7fx80d_FFo42zcy?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@S2zkS2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1925705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49fffc05/uploads/origins/9db09c4d-60c1-4b08-bf8c-7f822d9b61d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=858f1ec4b6857b7cf7ccea62182d9580", "srcset": "https://si.imgix.net/49fffc05/uploads/origins/9db09c4d-60c1-4b08-bf8c-7f822d9b61d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=858f1ec4b6857b7cf7ccea62182d9580, https://si.imgix.net/49fffc05/uploads/origins/9db09c4d-60c1-4b08-bf8c-7f822d9b61d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26952a23ebbc43510810886e28713174 2x, https://si.imgix.net/49fffc05/uploads/origins/9db09c4d-60c1-4b08-bf8c-7f822d9b61d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff84ec9c3080f6c1228509957e549c18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49fffc05/uploads/origins/9db09c4d-60c1-4b08-bf8c-7f822d9b61d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=883ac5ba121cfb0817734b56e2076ccf", "srcset": "https://si.imgix.net/49fffc05/uploads/origins/9db09c4d-60c1-4b08-bf8c-7f822d9b61d2?bg