 shorts in the outfit could you give her a long draping cloth like her original outfit, coming down from under her breasts. I will provide an image of what I mean as the last photo.  I look forwards to working with you again!\n\nhttps://imgur.com/a/fQsY7b5", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vlm_chan/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 104297, "client_id": 51161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba668593/uploads/origins/4c4c7536-a5e2-42dc-8a25-5ddbbb865825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac973e52e55ee1886defa801c5f7d0a7", "srcset": "https://si.imgix.net/ba668593/uploads/origins/4c4c7536-a5e2-42dc-8a25-5ddbbb865825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac973e52e55ee1886defa801c5f7d0a7, https://si.imgix.net/ba668593/uploads/origins/4c4c7536-a5e2-42dc-8a25-5ddbbb865825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d53b059eb32197016d039c4292739a7 2x, https://si.imgix.net/ba668593/uploads/origins/4c4c7536-a5e2-42dc-8a25-5ddbbb865825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6a6513d172b23d02afba20175fba4c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba668593/uploads/origins/4c4c7536-a5e2-42dc-8a25-5ddbbb865825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ebbb927d0eb2cec923f6b32d01b0001", "srcset": "https://si.imgix.net/ba668593/uploads/origins/4c4c7536-a5e2-42dc-8a25-5ddbbb865825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ebbb927d0eb2cec923f6b32d01b0001, https://si.imgix.net/ba668593/uploads/origins/4c4c7536-a5e2-42dc-8a25-5ddbbb865825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=