\n\nゲイブが危険なエイリアンの怪物であるにもかかわらず、アロイスは彼をとても愛している。\n\n戦闘後のシーンを描いたイラストをお願いします。二人とも怪我をしている。ゲイブの服は戦闘で破れた。\nアロイスはゲイブを守り、独占するように抱きしめている。\nゲイブはエイリアンの爪（ファイル \"05 Alien \"にある）でアロイスを愛おしそうに抱きしめている。\n\n使用目的SNS、OC活動、個人的な閲覧のための印刷のみ\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1atjIzPqghGCslfuaHI8uE5rk5gzVuPSz?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHI_baF1/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3639993, "client_id": 2544199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad201efe/uploads/origins/1435f356-3ad4-4288-bd23-8d1918689fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=029e86619ae243e0108aa66b53639275", "srcset": "https://si.imgix.net/ad201efe/uploads/origins/1435f356-3ad4-4288-bd23-8d1918689fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=029e86619ae243e0108aa66b53639275, https://si.imgix.net/ad201efe/uploads/origins/1435f356-3ad4-4288-bd23-8d1918689fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94828ef73f4dd39fc4a1174af147ebe3 2x, https://si.imgix.net/ad201efe/uploads/origins/1435f356-3ad4-4288-bd23-8d1918689fab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=badc48807e00417d0b322672c32543ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad201efe/uploads/origins/1435f356-3ad4-4288-bd23-8d1918689fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cec3f468f0fae4b7899267cf70e7e2f", "srcset": "https://si.imgix.net/ad201efe/uploads/origins/1435f356-3ad4-4288-bd23-8d1918689fab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cec3f468f0fae4b7899267cf70e7e2f, https://si.imgix.net/ad201efe/uploads/origins/1435f356-3ad4-4288-bd23-8d19186