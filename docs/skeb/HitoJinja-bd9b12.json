mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c71c16fe4ae83fcbbfc20a5e6c3dc3, https://si.imgix.net/0041066a/uploads/origins/3c523142-58fb-4c15-830b-b1740f158e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a371b4e698796b2e0ee28a95a5ddefe9 2x, https://si.imgix.net/0041066a/uploads/origins/3c523142-58fb-4c15-830b-b1740f158e0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e094dfb93845d8a06e992fdcce09282 3x"}, "body": "匿名で失礼致します。あゔぇぬいさま、はじめまして！\nSkebで新着作品を眺めていたところ、あゔぇぬいさまのイラストが目に止まり\nとってもかわいくて好みの雰囲気の絵でしたので、手数量無料キャンペーンに合わせて\n思い切ってリクエストさせていただきました。\n\n◆リクエストしたいイラストの内容\nOCの女の子ふたりを描いていただきたいです！\nセーラー服を着た中学生の女の子になります。\n一人はおっとりした性格で髪はセミロング、少し照れ屋な子です。\nもう一人は強気な性格で髪はおかっぱボブ、ちょっぴり短気で思い立ったらすぐに行動に移さなければ気が済まない子です。\n具体的なシチュエーションや構図は全てあゔぇぬいさまにおまかせしたいです。\n言葉だけだと伝わりづらいかと思われますので、拙い絵ですが自分で描いたものを資料としてご用意しました。\nhttps://drive.google.com/drive/folders/1WcKp2O0FLNwA2SURneqXxGh6zF6r7C2i\n資料の中には男の子もいますが、今回は女の子だけでOKです！\n髪型や制服の細かいデザインはアレンジいただいても大丈夫です！\n\n◆使用用途\n個人鑑賞のみを予定しておりますが、PCの壁紙かスマホの待ち受けに使用させていただきたいので、縦長か16:10ぐらいの横長のイラストだととっても助かります！…が、難しそうな場合はあゔぇぬいさまの描きやすいように描いていただいて大丈夫です！\n\n以上、長文を読んでいただきありがとうございまいした。\nご検討いただけると幸いです…！\n\nhttps://drive.google.com/drive/folders/1WcKp2O0FLNwA2SURneqXxGh6zF6r7C2i", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HitoJinja/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3050844, "client_id": 2096100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3134b1d7a9c0d8a9b80acc0cc99da7a7", "srcset": "https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3134b1d7a9c0d8a9b80acc0cc99da7a7, https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca5f78913f8abe381d13b7636b75cf95 2x, https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24c18c7cabf6a980308b0f30d24c63d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b230c6b4539cf73371f080111d3b0cd9", "srcset": "https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b230c6b4539cf73371f080111d3b0cd9, https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77c3056155d6341309b55afc58c08f1b 2x, https://si.imgix.net/0f27720b/uploads/origins/fa49b7e6-8c82-4d8f-9626-c6e2d42be63e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6894d63460bcfb96d9222e6599ccc9c 3x"}, "body": "はじめまして\n自分は個人勢のVtuberをしている鈴川はなと申します。\n\nskebの新着の中か、twitterのオススメか、どちらかで先生の絵をみつける機会があり、その時からまるっとかわいい絵だなと思っていて、今回リクエストさせていただきました。\n\n描いて欲しいのは私、鈴川の絵をお願いします。\n範囲としてはだいたい帯から上くらいの半身。\nかわいい系ですが、釣り目の身長低めの男の子なので、少し中性系で描いていただけると嬉しいです。\n性格は1人でいる自由人ですが、人がいるといたずらしたり甘えたりします。\n好みは日本酒や麻雀、マイクラ、花、料理などです。\nとっ散らかった情報ですが、このあたりから自由に描いていただきたいです。\n\nもし描いていただけた場合の用途としては、\n配信サムネ（収益化済み）やSNS上での利用、ポストカードへの印刷と、\n検討中ですがboothで販売するグッズなど、ごく少数の生産ですが商用利用もあり得るのでその許可も予めお願いしたいです。\n\n納品物は縦横やサイズ、解像度などはお任せします。\n形式としてはpsdでレイヤー分けして、背景無しでも使える状態で頂けると大変助かります。\n\nもし商用利用込みだと金額が合わないようであれば、そのようにご指摘ください。\nご検討をよろしくお願いいたします。\n\nこちらは参考画像になります。\n全身像\nhttps://drive.google.com/file/d/1StK_E-Iogho-Dh0DXF6Fuqumu73psg09/view?usp=sharing\n\n顔アップ\nhttps://drive.google.com/file/d/1LPiSLNoclTiCG03XchicLzVRVihsKN5r/view?usp=sharing\n顔アップ_猫目とちょっと八重歯の差分\nhttps://drive.google.com/file/d/1UWfJohnr8OVqXq-yypvFweQjw1HhWTai/view?usp=sharing\n別表情_右は母が同じ人\nhttps://drive.google.com/file/d/1wyO4GNkSS8FPPkwnbPNmM-e3D1mON_MU/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HitoJinja/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3050844, "client_id": 233614, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc4675bd/uploads/origins/eeed8b2e-aa37-4979-8719-bf825fb71eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876963af8f914a1cb5a832ac528dd3a1", "srcset": "https://si.imgix.net/bc4675bd/uploads/origins/eeed8b2e-aa37-4979-8719-bf825fb71eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876963af8f914a1cb5a832ac528dd3a1, https://si.imgix.net/bc4675bd/uploads/origins/eeed8b2e-aa37-4979-8719-bf825fb71eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4c736678f390f76e03bfe3324633df2f 2x, https://si.imgix.net/bc4675bd/uploads/origins/eeed8b2e-aa37-4979-8719-bf825fb71eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2450501f627caa8c4996a4a862e96ae7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc4675bd/uploads/origins/eeed8b2e-aa37-4979-8719-bf825fb71eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d74a49393e254179bb3c581102e80f", "srcset": "https://si.imgix.net/bc4675bd/uploads/origins/eeed8b2e-aa37-4979-8719-bf825fb71eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d74a49393e254179bb3c581102e80f, https://si.imgix.net/bc4675bd/uploads/origins/eeed8b2e-aa37-4979-8719-bf825fb71eaf?bg=%23fff&aut