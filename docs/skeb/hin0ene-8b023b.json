s/05c50a91-6e14-4e23-bc9a-1c4f19ea2f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9f6a60b7bf262be54db7453c8aadc7e 2x, https://si.imgix.net/c96e2c1d/uploads/origins/05c50a91-6e14-4e23-bc9a-1c4f19ea2f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a222815c09e99932526f1abc84a5506c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c96e2c1d/uploads/origins/05c50a91-6e14-4e23-bc9a-1c4f19ea2f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a830dfb8697fb27e378157f873787de7", "srcset": "https://si.imgix.net/c96e2c1d/uploads/origins/05c50a91-6e14-4e23-bc9a-1c4f19ea2f69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a830dfb8697fb27e378157f873787de7, https://si.imgix.net/c96e2c1d/uploads/origins/05c50a91-6e14-4e23-bc9a-1c4f19ea2f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a9797a413536c28d0f4192815e3485a 2x, https://si.imgix.net/c96e2c1d/uploads/origins/05c50a91-6e14-4e23-bc9a-1c4f19ea2f69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=942ac31cd76983cf48e84df32696d11f 3x"}, "body": "初めまして、フィロリーザと申します。\nTwitterにてお見掛けした、ひのえね先生の描かれるぷっくりアナルがとても印象的だったため、この度ご依頼させていただきました！\n私がVRSNS（VRChat）で使用しているアバターのイラストを描いてだきたく存じます。\n\n◆キャラクターの設定\n・名前：フィロリーザ\n・種族：クラゲドラゴン娘\n・特徴：クラゲの特徴とドラゴンの特徴を持っています。また、血の色がきれいな青色で、口中や舌が青色で、青色粘膜になっています。(URL内の画像参照)\n・普段は海辺や深海に住んでいます。\n\n◆シチュエーション\n・ひのえね先生の描かれた、アナルの前でピースしている伊吹童子のイラストが、とても癖に刺さるシチュエーションだったので、同じようなシチュエーションをお願いしたいです！\n（参考：https://x.com/proceed7211/status/1681150094975049728）\n・表情は笑顔で、かわいいアナルを見せつけるようにピースしている。\n・細かい構図やポーズ等はすべて先生にお任せします！\n\n◆要望（希望）\n・可能であれば差分で、アナルの青色粘膜と普通の色を描いて頂きたいです。\n\n手足の✖模様や、腰部から生えている尻尾や触手等は複雑なので、もし難しそうであれば、形状など資料と同じでなくても構いません。\n作成していただいたイラストの使用用途として、当ＳＮＳのアイコン及びヘッダーへの使用や、掲載をさせていただきたく存じます。\nまた、自身のVRChatワールドへの掲載(非営利)を許可いただければ幸いです。\n※その際は、どちらもクレジットを明記いたします。\n\n細かい注文となってしまい大変申し訳ありませんが、楽しく自由に描いていただければ幸いです。\n\nお手数ですが、ご検討のほどよろしくお願いいたします。\n※参考画像、及び資料につきましては、下記URLよりご確認をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rIqjI5iEOuaJ-3yapJJMZmYQJbJq6h8P", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hin0ene/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 172790, "client_id": 2724764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d0608bf/uploads/origins/2dc39b00-b6e0-4dec-aef2-464e5f78543f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4324fcc8d657668e2b31a98a635b22e", "srcset": "https://si.imgix.net/1d0608bf/uploads/origins/2dc39b00-b6e0-4dec-aef2-464e5f78543f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4324fcc8d657668e2b31a98a635b22e, https://si.imgix.net/1d0608bf/uploads/origins/2dc39b00-b6e0-4dec-aef2-464e5f78543f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7db738f9f18c7d87eb7863efd7f97807 2x, https://si.imgix.net/1d0608bf/uploads/origins/2dc39b00-b6e0-4dec-aef2-464e5f78543f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a1d20a56ba191a6935d09cd6960d763 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d0608bf/uploads/origins/2dc39b00-b6e0-4dec-aef2-464e5f78543f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86f04fabfa16471d0a99056bd0009dd4", "srcset": "https://si.imgix.net/1d0608bf/uploads/origins/2dc39b00-b6e0-4dec-aef2-464e5f78543f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86f04fabfa16471d0a99056bd0009dd4, https://si.imgix.net/1d0608bf/uploads/origins/2dc39b00-b6e0-4dec-aef2-464e5f78543f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0dca13d7191a61dd928d