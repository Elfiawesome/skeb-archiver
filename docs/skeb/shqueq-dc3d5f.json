egains her energy by touching Rita.\nRita is holding Anne in her arms, giving her the tender look that she gives her beloved lover.\n\nThe background is left to us, and they both look happy.\n\nPlease take a look.\n\nhttps://drive.google.com/drive/folders/1wBqeLWOzHKT8WDqxWSOfmGoPrxC5eNW_?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shqueq/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2048180, "client_id": 43626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f6266b3/uploads/origins/17c471d5-9c96-4da2-8cbc-fb912beae4ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41437be204e54b8ff794fda06847d631", "srcset": "https://si.imgix.net/4f6266b3/uploads/origins/17c471d5-9c96-4da2-8cbc-fb912beae4ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41437be204e54b8ff794fda06847d631, https://si.imgix.net/4f6266b3/uploads/origins/17c471d5-9c96-4da2-8cbc-fb912beae4ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39ce19ec6a6380b4b9732a84e255368f 2x, https://si.imgix.net/4f6266b3/uploads/origins/17c471d5-9c96-4da2-8cbc-fb912beae4ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b49115c78614ff5b2cc92032379ae0d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f6266b3/uploads/origins/17c471d5-9c96-4da2-8cbc-fb912beae4ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a4b4bc240963aa37f79136e71836dd7", "srcset": "https://si.imgix.net/4f6266b3/uploads/origins/17c471d5-9c96-4da2-8cbc-fb912beae4ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a4b4bc240963aa37f79136e71836dd7, https://si.imgix.net/4f6266b3/uploads/origins/17c471d5-9c96-4da2-8cbc-fb912beae4ad?bg=%23fff&auto=f