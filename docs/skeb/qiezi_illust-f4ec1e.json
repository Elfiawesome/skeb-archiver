容でよろしければ、\nお受け頂ければと思います。\nモノクロ希望です。\n\n【キャラクター】\n・オリジナル\n爆乳高校生ギャル（※他デザインなどはお任せ）\n\n【シチュエーション】\nhttps://www.pixiv.net/artworks/105731610\n・↑と同じく複数に肉棒に囲まれている感じ。男側は全身描く必要なし。隠れて撮影もされている。\n・遊ぶ資金稼ぎに家族/親族内援交を行う。父/祖父/叔父等複数が相手。\n・最終的にはぶっかけ\n・以下を参考にセリフを付けていただければ\n　・ギャル側\n　　・自分から持ち掛けた話だが、娘/孫に嬉々として肉棒を突き立てることに内心引いている。\n　　・これっきりにしようと思っている。\n　・男側\n　　・近親相姦という行為に大興奮している。\n　　・今まで可愛がって育てた娘/孫を汚す背徳感を感じている。\n　　・乗り気でなさそうな娘を今後も犯すために盗撮もしている。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@qiezi_illust/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1869440, "client_id": 2319801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88a12a79/uploads/origins/52394d28-7a90-4622-b017-8ed1f903dc38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad21a1497d24a31437ff22c0287cfe49", "srcset": "https://si.imgix.net/88a12a79/uploads/origins/52394d28-7a90-4622-b017-8ed1f903dc38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad21a1497d24a31437ff22c0287cfe49, https://si.imgix.net/88a12a79/uploads/origins/52394d28-7a90-4622-b017-8ed1f903dc38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edfaf839ee32f45e784bbeccba47e8d9 2x, https://si.imgix.net/88a12a79/uploads/origins/52394d28-7a90-4622-b017-8ed1f903dc38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d78cce692a64cb7442aefab426584576 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88a12a79/uploads/origins/52394d28-7a90-4622-b017-8ed1f903dc38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24b7e3da3ccb8556ea56dc855b37f3a7", "srcset": "https://si.imgix.net/88a12a79/uploads/origins/52394d28-7a90-4622-b017-8ed1f903dc38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24b7e3d