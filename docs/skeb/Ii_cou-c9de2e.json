=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d023dcca297f7123101b534a212bdaaa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b15380e2/uploads/origins/6b8a3e77-fe6a-48ab-b39c-5d2b7d1b884d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07d3adc4e3f3d5a9c5d987a0448cfc22", "srcset": "https://si.imgix.net/b15380e2/uploads/origins/6b8a3e77-fe6a-48ab-b39c-5d2b7d1b884d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07d3adc4e3f3d5a9c5d987a0448cfc22, https://si.imgix.net/b15380e2/uploads/origins/6b8a3e77-fe6a-48ab-b39c-5d2b7d1b884d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6533124acd45b7e6a0e147ec12bc6a7 2x, https://si.imgix.net/b15380e2/uploads/origins/6b8a3e77-fe6a-48ab-b39c-5d2b7d1b884d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5131172f78e1f16be575f1c93d425bb 3x"}, "body": "ナナさん、こんにちは！\n\nナナさんの描かれる女の子はとてもかっこいいくて美しいと感じており、もしよろしければ、私のオリジナルキャラクターのイラストをお願いできませんでしょうか？\n\nこのキャラクターは成人女性です。外見の特徴は、赤い髪のポニーテール、黒灰色の瞳、そして右目の下にある泣きぼくろです。性格は非常に明るく社交的ですが、行動には謎めいたところがあり、少し掴みどころのない、魔性の女性です。\n\n複数の衣装デザインをご用意しておりますので、ナナさんが一番好きなものをお選びいただき、自由に創作していただいて構いません。金額が不足している場合は、お気軽に再送をお願い致します。\n\n最後までお読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-8PyJdVmk1TvAehY17J3RVjiZl2ilfCp", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ii_cou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3728712, "client_id": 3479038, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d717f1c40043686bfc8e30ff65bba2c0", "srcset": "https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d717f1c40043686bfc8e30ff65bba2c0, https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe41fb7e910e42773998efb68066a84f 2x, https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95522bc06d4a9710299a1c42cf2078cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baba767978365c407782ab2ddc7fdebf", "srcset": "https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baba767978365c407782ab2ddc7fdebf, https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6166d0a6d042ac418a2c1b442e7f3f87 2x, https://si.imgix.net/51125584/uploads/origins/67af9d23-6cdf-42e7-a4be-4851e3f3bbf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5be8d24e8cd9205d35ed15e4e92a0c0 3x"}, "body": "ナナ様\n\n初めまして、βαliμγnαと申します。\nskebの新着から拝見し、私のOCを描いていただきたいと思い、リクエストさせていただきます。\n\n▶︎参考資料\nhttps://drive.google.com/drive/folders/1rgYSATJw8mpebrRGlsFzXCUWoEWs_x0a\n\n▶︎外見特徴\n・オッドアイ\n・髪に✧の模様\n・雲・雷・雨モチーフの飾り\n\n▶︎構図\n特に指定等ありませんので、ナナ様のご自由にお描きいただければと思います。\n固定衣装も存在しませんので、お好きに描いていただけますと幸いです。\n\n▶︎使用用途\n・SNSのアイコンやヘッダー、PC・スマホの壁紙としての個人利用\n・アクリルキーホルダーや本など、個人鑑賞目的でのグッズ作成\n・今後skeb等依頼する際の参考資料としての活用\n\n▶︎その他\nキャラクターと背景等を分けたPSD形式のイラストだと嬉しいです。\nまた、ラフ段階のイラストや没になったもの等がありましたら、残していただけると嬉しいです。\n\nご依頼内容や金銭面で不明点や問題がある場合は、遠慮なく再送・キャンセルしてくださいませ。\nご多忙のところ恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rgYSATJw8mpebrRGlsFzXCUWoEWs_x0a", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ii_cou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3728712, "client_id": 3905862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70bf77288c0bf5adf5628d9a9a493f8", "srcset": "https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70bf77288c0bf5adf5628d9a9a493f8, https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acd07b448e1068e4d195af2e72a8b7ec 2x, https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c4b1cd1a853765a57276a17ae495c55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6a8d4b618a6adf0239e040b1395ab19", "srcset": "https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6a8d4b618a6adf0239e040b1395ab19, https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ceaa6825cc77ac8023b5c175f2c7fe2 2x, https://si.imgix.net/cbf36547/uploads/origins/44e19e7d-4441-4bac-912b-2f9d4bff48a