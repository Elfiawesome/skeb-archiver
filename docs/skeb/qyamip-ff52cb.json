=200&blur=200&s=008fa3041a856da538dd903b97cb44d4 2x, https://si.imgix.net/b73e8ca3/uploads/origins/778d751f-841d-4ff7-9a70-6939343d9656?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64066b987bcaa35d3cc87809def47c65 3x"}, "body": "先月はアメリアちゃんの素敵なイラストをありがとうございました。\n\nさて、この度二回目のリクエストになりますが、八月のシンデレラナインの草刈レナさん（高校生）のイラストをお願いいたします。\n\n以下の設定のイラストをお願いいたします。\n\n場所：海水浴場の砂浜\n服装：黒色のビキニ\n動作：ヘッドスライディングをして、お○ぱいがムニュッとなっている\n\nビキニのパンツが砂と擦れている様子も描いていただけると嬉しいです。\n\nご検討のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@qyamip/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 154682, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971da5f2a28d8861c74d9e7d0845bd32", "srcset": "https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=971da5f2a28d8861c74d9e7d0845bd32, https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8242c4ec19e17d15f96f50bb726dfae2 2x, https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4b95a61868f470499f5d44bb30fbae1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=426f78048357e2e9446fae38a95c2748", "srcset": "https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=426f78048357e2e9446fae38a95c2748, https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d53b4490f463b92723dc8eceabc05fdd 2x, https://si.imgix.net/4e82b639/uploads/origins/a55ba382-b354-408d-9aaa-7bbf146e30e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95f4d9f7e5572dfd7e2d51d8036f318a 3x"}, "body": "先日は素晴らしいイラストをありがとうございました。\n以下の内容でリクエストさせてください。\n\nキャラ:東雲龍（ハチナイ）\n服装:バニーコス（黒色）\n髪型:ポニーテール\n表情:赤面し、納得のいかなそうな顔でこちらを睨みつけている\nシチュエーション\n両手を腰にあてて前屈みになっており、乳首が見えてしまっている（本人は気づいていない）\n\n可能であれば何か一言セリフを喋らせてください。\n背景などの細かい部分はお任せします。\nご検討よろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@qyamip/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 154682, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4269c75/uploads/origins/7ccd234e-aeaf-47b7-89a7-1c48fba84ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91dcd9d1c113a2b15cae814898bcc47c", "srcset": "https://si.imgix.net/c4269c75/uploads/origins/7ccd234e-aeaf-47b7-89a7-1c48fba84ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91dcd9d1c113a2b15cae814898bcc47c, https://si.imgix.net/c4269c75/uploads/origins/7ccd234e-aeaf-47b7-89a7-1c48fba84ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a351fc586c1062e52136f037a791fd3 2x, https://si.imgix.net/c4269c75/uploads/origins/7ccd234e-aeaf-47b7-89a7-1c48fba84ff7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9971a8997a9feb2391cabe595c6adb6d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4269c75/uploads/origins/7ccd234e-aeaf-47b7-89a7-1c48fba84f