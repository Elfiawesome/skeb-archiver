ご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1154158, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆのり(むしむし)", "screen_name": "Mo_518_mO", "avatar_url": "https://pbs.twimg.com/profile_images/1994165821476896768/li1ulPsb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/898426277446549505/1765828903/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 35, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 32}, {"id": 2492747, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "だいこんの群れ", "screen_name": "mure_daikon", "avatar_url": "https://pbs.twimg.com/profile_images/1478916030152187910/IKKsLwJf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1478915763511885827/1695115466/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 145}, {"id": 3070592, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねるねる_🤍🌙", "screen_name": "nellnell", "avatar_url": "https://pbs.twimg.com/profile_images/2022360227505672196/t58Q7p_M.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1255137474629623808/1771408752/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 14, "skills": [{"genre": "art"}, {"genre": "voic