7df/uploads/origins/f7c7fc86-2dae-4069-8fd6-77b9bf12335b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35f1a0547f575a7db81d27cb7ca3aff6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9d6c7df/uploads/origins/f7c7fc86-2dae-4069-8fd6-77b9bf12335b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acdf06782a55d687392758e5a1c42469", "srcset": "https://si.imgix.net/b9d6c7df/uploads/origins/f7c7fc86-2dae-4069-8fd6-77b9bf12335b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acdf06782a55d687392758e5a1c42469, https://si.imgix.net/b9d6c7df/uploads/origins/f7c7fc86-2dae-4069-8fd6-77b9bf12335b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1f7081498096bf072829118dea7f742 2x, https://si.imgix.net/b9d6c7df/uploads/origins/f7c7fc86-2dae-4069-8fd6-77b9bf12335b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bea7e06da84d83a018afa4f1f49015f3 3x"}, "body": "ごきげんよう。初めまして、配信などをしているレックナート・マキャフリーと申します。\n\nドット絵のイラストを描いて頂ける方を探して居たところ狐瓜様に辿り着きました。\nもし、お都合が宜しければ私のイラストも書いて頂きたいと思い依頼をさせて頂きました。\nFF１～６時代のドット絵が好きなので、今後プレイさせて頂く際に使わせて頂きたいと思っております。\n占い師(主にタロットカード)なので、そちらの要素を加えて頂けると嬉しいです。\n\n背景を書いていただける場合キャラのみの透過でも利用できるように、PSDデータで背景と人物のレイヤーを分けて頂けると嬉しいです。\n\n【参考資料】\nhttps://twitter.com/leknaat_mk2/status/1622199371432607744\n\n【使用用途】\n・配信や各種SNSでの使用\n\n宜しければ宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WAKA_KOURI64/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2579192, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eccd5a9e/uploads/origins/0405ad6a-fcc1-46a0-b0ad-7e91c21c1633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=214296553ea851b3cef331557f4ffa