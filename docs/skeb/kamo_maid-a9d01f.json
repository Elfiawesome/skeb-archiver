\u767a\u3082\u306e\u3067\u3082\u7d50\u69cb\u3067\u3059\u3002\n(\u203b\u5f8c\u8ff0\u306e\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u304b\u3089\u3001\u3082\u3057\u30aa\u30eb\u30c9\u30e9\u30f3\u9b54\u6cd5\u5b66\u5712\u306e\u5834\u5408\u306f\u524d\u56de\u306e3\u4eba\u5a18\u306e\u4f55\u4eba\u304b(\u7279\u306b\u30b8\u30eb)\u304c\u3069\u3053\u304b\u3067\u5dfb\u304d\u8fbc\u307e\u308c\u308b\u3088\u3046\u306a\u63cf\u5199\u304c\u3042\u308b\u3068\u5b09\u3057\u3044\u3067\u3059)\u3002\n\u524d\u56de\u540c\u69d8\u3001\u30a8\u30c3\u30c1\u306a\u9b54\u6cd5\u304c\u597d\u304d\u306a\u9b54\u5973\u3082\u30a8\u30ea\u30e4\u3084\u30df\u30c4\u30ad/\u30a2\u30ea\u30b5\u3092\u30b9\u30bf\u30fc\u30b7\u30b9\u30c6\u30e0\u7684\u306b\u7d9a\u6295\u3067\u3082\u3001\u65b0\u898f\u306e\u5b50\u3067\u3082\u7d50\u69cb\u3067\u3059(\u30b7\u30c1\u30e5\u7684\u306b\u30a8\u30ea\u30e4\u306e\u5f53\u521d\u6848\u3060\u3063\u305f\u30e1\u30b9\u30ac\u30ad\u304c\u6848\u5916\u5408\u3046\u304b\u3082\uff1f)\u3002\n\n\u5927\u7b4b\uff1a\u30a8\u30c3\u30c1\u306a\u9b54\u6cd5\u3092\u597d\u3080\u9b54\u5973\u306b\u3088\u308a\u5f90\u3005\u306b\u30a8\u30b9\u30ab\u30ec\u30fc\u30c8\u3059\u308b\u60aa\u622f\uff08\u7f9e\u6065\u30e1\u30a4\u30f3\uff09\u306f\u5909\u308f\u3089\u306a\u3044\u306e\u3067\u3059\u304c\u3001\u54c1\u3092\u5909\u3048\u308b\u3001\u3068\u3044\u3046\u3053\u3068\u30672\u3064\u306e\u8981\u7d20\u3092\u8ef8\u306b\u66f8\u3044\u3066\u307f\u3066\u9802\u304d\u305f\u304f\n\u3000\u3000\u3000\u4eca\u5ea6\u306f\u524d\u56de\u4f9d\u983c\u306e\u30d7\u30ed\u30c3\u30c8\u2460\n\u3000\u3000\u3000\uff1e\u88ab\u5bb3\u8005\u306b\u300e\u5973\u5b50\u9ad8\u751f\u9b54\u5973\uff5e\u300f\u306e\u3088\u3046\u306a\u5f7c\u6c0f\u3084\u3001\u53cb\u9054\u4ee5\u4e0a\u604b\u4eba\u672a\u6e80\u306e\u7537\u5b50\u304c\u3044\u308b\u30e1\u30a4\u30f33\u4eba\u8ef8\n\u3000\u3000\u3000\u7537\u5b50\u306e\u5b58\u5728\u3082\u7f9e\u6065\u8cac\u3081\u306b\u5229\u7528\u3057\u305f\u308a\u3001NTR\u6c17\u5473\u306b\u3061\u3087\u3063\u304b\u3044\u51fa\u3057\u305f\u308a\u3001\u7537\u5b50\u306f\u7d04\u5f97\u3068\u5dfb\u304d\u8fbc\u307e\u308cM\u88ab\u5bb3\u304c\u534a\u3005\u306a\u611f\u3058\n\u3000\u3000\u3000\u3053\u308c\u306e\u7537\u5b50\u30dd\u30b8\u30b7\u30e7\u30f3\u306e\u76ee\u7dda\u3067\u3001\u3053\u3061\u3089\u3082\u9d28\u3055\u3093\u304a\u5f97\u610f\u306e\u7537\u6027\u53d7\u3051M\u30b7\u30c1\u30e5\u3067\u8a98\u60d1\u3001\u52c3\u8d77\u3001\u5c04\u7cbe\u3092\u4fc3\u3055\u308c\u3066\uff5e\u307f\u305f\u3044\u306a\u611f\u3058\u3067\u3002\n\u3000\u3000\u3000\uff08\u53cb\u9054\u4ee5\u4e0a\u604b\u4eba\u672a\u6e80\uff5e\u5f7c\u5973\u30dd\u30b8\u30b7\u30e7\u30f3\u306e\u672c\u547d\u30d2\u30ed\u30a4\u30f3\u304c\u3044\u308b\u304b\u3069\u3046\u304b\u3001\u300c\u9b54\u5973\u300d\u304c\u767e\u5408\u3063\u6c17\u304c\u3042\u308b\u304b\u3069\u3046\u304b\u306f\u63cf\u304d\u3084\u3059\u3044\u5869\u6885\u306b\u304a\u307e\u304b\u305b\u3057\u307e\u3059\u304c\u3001\u672c\u547d\u304c\u3044\u308b\u5834\u5408\u306f\u9b54\u5973\u304c\u81ea\u5206\u3067\u306e\u8a98\u60d1\u3084\u305d\u306e\u5b50\uff08\u3068\u30e2\u30d6\u5973\u5b50\uff09\u306e\u75f4\u614b\u3082\u5229\u7528\u3057\u3066\u6709\u76ca\u306a\u7d20\u6750\u3068\u3057\u3066\u306e\u7cbe\u6db2\u3092\u643e\u308a\u53d6\u3089\u308c\u305f\u308a\u3001\u5974\u96b7\u306b\u843d\u3068\u3059\u30c0\u30b7\u306b\u5229\u7528\u3055\u308c\u308b\u3001\u7684\u306a\u611f\u3058\uff09\n\u3000\u3000\u3000\u3000\u203b\u5f8c\u8ff0\u306e\u30b7\u30c1\u30e5\u6848\u306e\u63a1\u7528\u7d50\u679c\u6b21\u7b2c\u3067\u306f\u3001\u4e00\u6642\u7684\u306b\u30e2\u30d6\u5973\u5b50\u3084\u7537\u5b50\u8996\u70b9\u3067\u6065\u305a\u304b\u3057\u3044\u76ee\u306b\u906d\u3046\u30b7\u30fc\u30f3\u3092\u633f\u5165\u3057\u3066\u3082\u3089\u3046\u306e\u3082\u3044\u3044\u3068\u601d\u3044\u307e\u3059\n\n\n\u30002\u3064\u76ee\u306e\u8981\u7d20\u306f\u3001\u69cb\u6210\u304c\u96e3\u3057\u305d\u3046\u306a\u3089\u6700\u60aa\u30b9\u30eb\u30fc\u3067\u3088\u3044\u3067\u3059\u304c\u3001\u540c\u3058\u304f\u524d\u56de\u30b7\u30c1\u30e5\u6848\u306e\n\u3000\uff1e\u2605\u7b92\u3067\u98db\u884c\u4e2d\u306e\u60aa\u622f\uff08\u6388\u696d\u3084\u767b\u4e0b\u6821\u3001\u9577\u5c3a\u66f8\u3051\u305d\u3046\u306a\u3089\u7b92\u30ec\u30fc\u30b9\u3067\u4ed6\u30b7\u30c1\u30e5\u3068\u5408\u308f\u305b\u308b\u3068\u304b\uff09\n\n\u3000\u3053\u3061\u3089\u304b\u3089\u3001\u30b8\u30eb\u304c\u30a8\u30ea\u30e4\u306b\u632f\u308a\u56de\u3055\u308c\u305f\u7b92\u98db\u884c\u4e2d\u306e\u8fb1\u3081\u30d7\u30ec\u30a4\u3092\u30d9\u30fc\u30b9\u306b\u3001\n\u3000\u7af6\u6280\u3068\u3057\u3066\u306e\u7b92\u30ec\u30fc\u30b9\u3084\u5927\u4f1a\u306b\u7d61\u3081\u3066\uff08\u30eb\u30fc\u30eb\u306e\u7bc4\u56f2\u5185\u3067\u9b54\u6cd5\u3067\u306e\u59a8\u5bb3\u3042\u308a\u3060\u304c\u3001\u4f8b\u3048\u3070\u9b54\u5973\u306e\u5f71\u97ff\u3068\u304b\u3067\u3001\u9b54\u5973\u4ee5\u5916\u306e\u9b54\u6cd5\u3082\u66b4\u8d70\u3057\u305f\u308a\u3044\u3064\u3082\u3068\u9055\u3046\u30a8\u30c3\u30c1\u306a\u52b9\u679c\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u308a\u3001\u3068\u304b\uff09\n\u3000\u5c0e\u5165\u306e\u7b92\u306b\u4e57\u3063\u3066\u306a\u3044\u65e5\u5e38\u3001\u7df4\u7fd2\u3001\u672c\u756a\u3068\u4f55\u304b\u306b\u3064\u3051\u3066\u7b92\u98db\u884c\u30b7\u30c1\u30e5\u306b\u5408\u308f\u305b\u305f\u30a8\u30c3\u30c1\u306a\u3053\u3068\u3092\u3055\u308c\u3061\u3083\u3046\u611f\u3058\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\n\u3000\u4ee5\u524d\u30d7\u30ed\u30c3\u30c8\u306b\u7d04\u5f97\u3068\u5dfb\u304d\u8fbc\u307e\u308cM\u88ab\u5bb3\u304c\u534a\u3005\u3068\u66f8\u3044\u305f\u3088\u3046\u306b\u3001\u300e\u5973\u5b50\u9ad8\u751f\u9b54\u5973\uff5e\u300f\u3084\u30e1\u30a4\u30c9\u3055\u3093\u30b7\u30ea\u30fc\u30ba\u306e\u3088\u3046\u306a\u5f37\u5236\u52c3\u8d77\u306a\u3093\u304b\u3082\u3042\u3063\u3066\u3044\u3044\u3067\u3059\u304c\u3001\n\u3000\u5468\u56f2\u306e\u30e2\u30d6\u5973\u5b50\u751f\u5f92\u3082\u5229\u7528\u3057\u3066\u30cf\u30d7\u30cb\u30f3\u30b0\u3084\u30e9\u30c3\u30ad\u30fc\u30b9\u30b1\u30d9\u7684\u306a\u8981\u7d20\u3082\u8fbc\u307f\u3067\u8208\u596e\u3092\u717d\u3089\u308c\u308b\u5b09\u3057\u6065\u305a\u304b\u3057\u306a\u3053\u3068\u306b\u3055\u308c\u3061\u3083\u3046\u611f\u3058\u3060\u3068\u5c1a\u826f\u3044\u3067\u3059\u3002\n\u3000\uff08\u7af6\u6280\u3068\u3057\u3066\u306e\u7b92\u98db\u884c\u306b\u5165\u308c\u8fbc\u3093\u3067\u3044\u308b\u7537\u5b50\u3092\"\u843d\u3068\u3059\"\u70ba\u306b\u72b6\u6cc1\u3092\u5229\u7528\u3059\u308b\u30fb\u30fb\u30fb\u7684\u306a\uff09\n\u3000\n\u3000\u7b92\u3067\u306e\u98db\u884c\u4e2d\u3060\u3068\u63cf\u5199\u304c\u9650\u5b9a\u3055\u308c\u3057\u307e\u3046\u3053\u3068\u3082\u3042\u308b\u3068\u601d\u3044\u307e\u3059\u304c\u3001\u4e00\u65b9\u3067\u3053\u306e\u8a2d\u5b9a\u306a\u3089\u3067\u306f\u306e\u4f7f\u3044\u65b9\u3082\u3067\u304d\u306a\u3044\u304b\u306a\u30fc\u3068\u8003\u3048\u3001\n\u3000\u524d\u56de\u30b8\u30eb\u306e\u30b7\u30fc\u30f3\u3092\u4e0a\u624b\u304f\u66f8\u3044\u3066\u304f\u3060\u3055\u3063\u305f\u9d28\u3055\u3093\u306a\u3089\u3044\u3051\u305d\u3046\u304b\u3082\u3001\u3068\u6b32\u5f35\u3063\u3066\u63d0\u6848\u3055\u305b\u3066\u9802\u304d\u307e\u3057\u305f\u3002\n\n\n\u25a0\u30b7\u30c1\u30e5\u6848\n\u524d\u56de\u540c\u69d8\u3001\u53d6\u6368\u9078\u629e\u3084\u30a2\u30ec\u30f3\u30b8\u3001\u7d44\u307f\u5408\u308f\u305b\u3092\u304a\u307e\u304b\u305b\u3057\u3064\u3064\u3001\u2605\u306f\u63a1\u7528\u3092\u512a\u5148\u3057\u305f\u308a\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u591a\u3081\u3060\u3063\u305f\u308a\u3001\u63cf\u5199\u6fc3\u3044\u3081\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\n\u3069\u3061\u3089\u304b\u3068\u3044\u3046\u3068\u30e2\u30d6\u88ab\u5bb3\u5411\u3051\u3063\u307d\u3044\u306e\u306f\uff08\u30e2\u30d6\uff09\u3068\u3057\u3066\u3044\u307e\u3059\n\u9d28\u3055\u3093\u304c\u5f97\u610f\u3060\u3063\u305f\u308a\u5165\u308c\u305f\u3044\u3001\u72b6\u6cc1\u7684\u306b\u3084\u308a\u3084\u3059\u3044\u30d7\u30ec\u30a4\u304c\u3042\u308c\u3070\u305d\u308c\u3082\u304a\u307e\u304b\u305b\u3057\u307e\u3059\n\n\u2605\u30d1\u30f3\u30c4\u3001\u80a1\u9593\u6652\u3057\n\u30d1\u30f3\u30c1\u30e9\u30d1\u30f3\u30e2\u30ed\uff5e\u5f37\u5236\u30ce\u30fc\u30d1\u30f3\u3067\u30a2\u30bd\u30b3\u304b\u3089\u304a\u5c3b\u306e\u7a74\u307e\u3067\n\u524d\u56de\u306e3\u4eba\u7d44\u306f\u30ce\u30fc\u30ac\u30fc\u30c9\u3067\u3057\u305f\u306e\u3067\u8a2d\u5b9a\u6b21\u7b2c\u3067\u3059\u304c\u3001\u666e\u6bb5\u4e0b\u7a7f\u304d\u3067\u30ac\u30fc\u30c9\u3057\u3066\u308b\u5b50\u304c\u9b54\u6cd5\u3084\u6697\u793a\u3067\u305d\u308c\u3092\u7a7f\u304d\u5fd8\u308c\u305f\u308a\u596a\u308f\u308c\u305f\u308a\u3057\u3066\u7537\u5b50\u306e\u524d\u3067\u523a\u6fc0\u7684\u306a\u5149\u666f\u304c\u5e83\u304c\u308b\u3068\u304b\n\u30bb\u30af\u30b7\u30fc\u3001\u6d3e\u624b\u3081\u306e\u4e0b\u7740\u3092\u597d\u3080\u5b50\u306e\u7d10\u30d1\u30f3\u304c\u60aa\u622f\u3067\u98db\u3070\u3055\u308c\u3066\u7537\u5b50\u306b\u88ab\u305b\u3066\u8d70\u884c\u59a8\u5bb3\u2192\u4f7f\u7528\u6e08\u30b7\u30df\u4ed8\u304d\u306e\u30af\u30ed\u30c3\u30c1\u6652\u3057\uff08\u306b\u304a\u3044\u7b49\u306e\u30d5\u30a7\u30c1\u8981\u7d20\uff09\u3084\u3001\u305d\u3053\u304b\u3089\u30b9\u30ab\u30fc\u30c8\u5185\u3092\"\u5168\u90e8\"\u898b\u3066\u3057\u307e\u3044\u305d\u308c\u304c\u30c8\u30c9\u30e1\u306b\u306a\u308b\u3001\u7b49\n\u5916\u91ce\u3067\u89b3\u6226\u3057\u3066\u3044\u308b\u5973\u5b50\u306e\u30b9\u30ab\u30fc\u30c8\u3092\u6372\u308b\u3001\u64cd\u3063\u3066\u81ea\u3089\u30b9\u30ab\u30fc\u30c8\u3092\u6372\u308a\u3042\u3052\u3055\u305b\u308b\u3001\u7b49\u3082\u3042\u3063\u3066\u3082\u3044\u3044\u304b\u3082\u3067\u3059\n\n\u2605\u304a\u3057\u304c\u307e/\u304a\u3082\u3089\u3057\uff08\u30e2\u30d6\uff09\n\u3000\u98db\u884c\u4e2d\u306b\u5c3f\u610f\u5897\u5e45\u3092\u53d7\u3051\u3066\u3082\u3058\u3082\u3058\u3068\u7126\u308a\u3060\u3057\u3001\u30b3\u30fc\u30b9\u5916\u306e\u30c8\u30a4\u30ec\u306b\u614c\u3066\u3066\u80a1\u9593\u3092\u6291\u3048\u306a\u304c\u3089\u99c6\u3051\u8fbc\u3080\u6065\u305a\u304b\u3057\u3044\u59ff\u3092\u6652\u3057\u305f\u308a\u3001\n\u3000\u96e2\u8131\u3057\u3088\u3046\u3068\u3057\u305f\u30bf\u30a4\u30d