=2&fit=crop&crop=top&w=200&h=200&s=4bb803cb2817e3514e6f054a0157294c 2x, https://si.imgix.net/07a4d493/uploads/origins/1457e186-93a4-4861-86cf-62a145672853?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09a9c65ceebeefd59980211de53e3679 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07a4d493/uploads/origins/1457e186-93a4-4861-86cf-62a145672853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1769a103e7d24e0817bd7e801abd9f3c", "srcset": "https://si.imgix.net/07a4d493/uploads/origins/1457e186-93a4-4861-86cf-62a145672853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1769a103e7d24e0817bd7e801abd9f3c, https://si.imgix.net/07a4d493/uploads/origins/1457e186-93a4-4861-86cf-62a145672853?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f674bc6fd1986a4cfe955dd5da623b9 2x, https://si.imgix.net/07a4d493/uploads/origins/1457e186-93a4-4861-86cf-62a145672853?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58218da94498dfa12a6c6c8b03e79721 3x"}, "body": "𝘀𝗺𝘁.先生はじめまして、お忙しいところ、突然メッセージをして失礼いたしました。先生の漫画が大好きで、この2人のキャラクターについての漫画を依頼したいと思っています!\n\n●Tschalski/チチャルスキー（茶髪)： \n184cm 一人称は「私/自分」、二人称「キミ/シュイスト」 \n教会に勤めている司祭は、落ち着いていて冷静で、豊かな経験を持っており、礼儀正しく、聖職者でありながら、信仰や概念のために生きているのではなく、むしろ世俗的な喜びを楽しむ傾向があります,信者の悩みに対しては適切なアドバイスをするが、それはほとんどが無関心からであり、冷静な分析によって解決策を導き出すものであって、真の共感や包容力によるものではない。\n\n●Shuist/シュイスト(浅黄髪)：\n 177cm 一人称は「僕」、二人称「キミ/神父様/バート」 \n死にきれない悪魔で、外見的にはかなりの魅力を持ち、突飛なモラルのレベルは悪魔の中ではずっと高く、一般的な意味での善良さではないにしても、少なくとも一応無害と呼ぶことができる。どちらかというと中途半端な感じの男，気楽で、たいていのことには寛大で、好奇心が旺盛で、結果についてはほとんど考えなかった。多少狡猾こうかつな小市民的な性格をもってはいたが、行動も多少軽薄であった,しかし、感情的にはとても初々しくて稚拙。 \n\n詳しい性格や関係はフォルダに書いてあります!具体的なストーリーはキャラクターに合わせて自由に描いてくださいね!\n\n閲覧お疲れ様でした！私は日本语があまり得意ではない…以上の文章は流暢ではないかもしれません、ご容赦ください…！依頼を引き受けていただけると嬉しいです。ありがとうございます ！\n\nhttps://drive.google.com/drive/folders/10L6Nvh5EjRw0DhFaivmh4LLPnMQkrbg2", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s58_crab/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3105066, "client_id": 701653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b86287c054f7f3716c3579bf5a33ac", "srcset": "https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b86287c054f7f3716c3579bf5a33ac, https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e1b8af93a504e3b256c732482fd3452 2x, https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f07a2cdef73c4dd9b10507a564275a51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c39c50ae76c6c1c2eefa95a5a6396c96", "srcset": "https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c39c50ae76c6c1c2eefa95a5a6396c96, https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4318975132fc4ff62e0f07b2a72ad96f 2x, https://si.imgix.net/85ed54db/uploads/origins/91c393ec-beda-4e00-a8db-8ca61f8e9d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f480ee11e1728c386d905b64674293f 3x"}, "body": "初めてリクエストさせていただきます。\nTRPGを遊ばれているアカウントを拝見し、キュートな絵柄に心惹かれました。\n今回はTRPGに使用する全身立ち絵の作成をお願いしたくリクエストいたしました。\n資料として、非商用利用を許可しているPicrewで作成した画像をGoogleドライブで共有いたします。\n\n■用途\n・TRPGセッションにおける全身立ち絵として、それに伴うSNSでの使用（スクリーンショット掲載、トリミングしてのアイコン使用、イメージを損なわない程度の加工を施して制作したディスプレイ画像掲載など）\n・Skeb含むコミッションサイトにイラストを依頼する際のキャラクターデザイン資料としての使用\n\n■キャラクター設定\n記載のない部分はすべてご自由にデザインしていただければ幸いです。\n性別：男性\n年齢：20代半ば\n職業：自称パチプロのその日暮らし。怪しげなバイトもよくやる。\n性格：ノリが軽く、常にへらへらしている刹那的快楽主義者\n髪：基本的に資料画像通り。色は赤紫（#652E41）。全体的にぼさぼさしており、背面の後ろ髪を胸の高さまで伸ばしている。前髪が一房、左目側から右目側にかけて斜めに大きくはねている。\n瞳：色は青緑（#3B7F81）。たれ目。\nそれ以外の顔特徴： 眉はつり目気味のまろ眉。口はωの形のいわゆる猫口。下リム（細い銀縁）の眼鏡をかけている。\n表情：へらっと微笑んでいる。\n服装：smt.様のデザインセンスが好きなため、可能であればおまかせでお願いできれば幸いです。全身丸ごとデザインいただくのでも、上半身は資料画像通りで下半身のみデザインいただくのでもどちらでもかまいません。\nポーズ：おまかせでお願いできれば幸いです。\n\n用途に許可できない項目が含まれている、服装やポーズの指定が不足している、金額が不足している等条件に問題がある場合はお気軽に再送要請またはキャンセルしていただければ幸いです。\nデザインをお任せしてしまう部分が多く申し訳ございません。\n金額相応に描いていただければ幸いです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1e4Zq3EImbAeLUJ4YG4VvP4L4JUbil4Ee?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s58_crab/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3105066, "client_id": 3278084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35152ac3/uploads/origins/dfe50ff9-c281-47dd-ab07-d977bdd5e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79c2572bd1e2d395cde5f93bcefb1a1e", "srcset": "https://si.imgix.net/35152ac3/uploads/origins/dfe50ff9-c281-47dd-ab07-d977bdd5e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=79c2572bd1e2d395cde5f93bcefb1a1e, https://si.imgix.net/35152ac3/uploads/origins/dfe50ff9-c281-47dd-ab07-d977bdd5e8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bec8790d039dccb838420f880d31598 2x, https://si.imgix.net/35152ac3/uploads/origins/dfe50ff9-c281-47d