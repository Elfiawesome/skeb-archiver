3df90206bc32a6 2x, https://si.imgix.net/9d36ae03/uploads/origins/30123aaf-4edd-4963-811b-1f4ac6d9381d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8e335bf61b83d06174e79c56200f98a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d36ae03/uploads/origins/30123aaf-4edd-4963-811b-1f4ac6d9381d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea7109e3d24c9a9e6fe24a6edea3410", "srcset": "https://si.imgix.net/9d36ae03/uploads/origins/30123aaf-4edd-4963-811b-1f4ac6d9381d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea7109e3d24c9a9e6fe24a6edea3410, https://si.imgix.net/9d36ae03/uploads/origins/30123aaf-4edd-4963-811b-1f4ac6d9381d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61c2490bdd1298a62042d8426b1115d2 2x, https://si.imgix.net/9d36ae03/uploads/origins/30123aaf-4edd-4963-811b-1f4ac6d9381d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecbebfb148e234860f902ccf042cda25 3x"}, "body": "はじめまして。普段、白湯さんのシナリオで遊ばせていただいているものです。これまでBOOTHに出されたものは全て読ませていただいております。小説や短歌含め、貴方の綴る言葉が大好きです。いつもありがとうございます。\n今回、あるうちよそのssをお願い出来たらうれしいなと思い、ご連絡させていただきました。\n\n●うちよそについて\n\n・婚約・同棲中の男女(月城夫婦)\n・赤霧市(架空の地方都市)アパート在住\n・5W1H→あなたさえいればいい(相方のオリシ)→やさしい朝をくださいね(両ロス)\n・1卓目の最後で男性PCから女性PCの方へプロポーズ→2卓目でデートし式場を決める→式をあげる前にロスト\n\n●自探索者について\n\n・ https://iachara.com/view/3196527\n・「私」「~だね！｣「秀さん」\n・明るい光属性。少々わがままだ ったり、試すような素振りを見せることもあるが善良。\n・朝と向日葵が似合う・固めのプリンが好き\n・いつも先に発狂する\n\n●よその子について\n・月城秀(26) 医者\n・「俺」「~だね」 「才葉」\n・やさしく聡明。才葉には甘 く、ふわりと笑う。\n・才葉より一回り身長が高い\n・月が似合う・ストロベリージャム・カルボナーラが好き・ホラー映画は苦手\n・既に遺書を用意している\n・平行世界の秀さんは事故に遭って死ぬ\n\n●書いていただきたい内容\n・なんでもない一日、あるいは日常の一場面を切り取ってほしい\n・3/1に式場を決めたため、それからやさ朝に行くまでの式直前の生活を書いてほしい(それがわかる描写をいれる必要は無いです)\n・幸せな日常を送っていた2人\n・その日の終わりは2人で幸せにベッドに潜ってるんだろうな、と思える終わり方がいい\n\n●他\n・幸せなお話が見れたらうれしい\n・同じベットで寝ている。家事の分担については特に決めていないが、女側が行うことが多かったかもしれない。(休みの日などは秀さんもやってくれます)\n・朝は洋食派。シナリオ中はトーストとコーヒーを朝食として食べていました\n・やさ朝通過時のロストの経緯について。シナリオのネタバレを含みます\n　https://fse.tw/UQEq8Pw1#all\n\nあくまで二次創作として受け取るため、解釈違いを過度に気にして頂く必要はありません。私は白湯さんの文章が読みたいです。良い夜をお過ごしください。\n\nhttps://photos.app.goo.gl/YidEFZh92itGXi8W8", "nc": 129, "word_count": 3057, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yakando/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 947058, "client_id": 2910073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adc35d1aa0288dc4f2e1b9eb114db8a1", "srcset": "https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adc35d1aa0288dc4f2e1b9eb114db8a1, https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd0b0d417a516f2eb34ecf99caa68e50 2x, https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52ac241bd1eb837110d50629d872c69b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=063db6fe6d569e353198ceb40f4d53a5", "srcset": "https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=063db6fe6d569e353198ceb40f4d53a5, https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a69fda4ac1eed7e91f8b23dc7aaeff0 2x, https://si.imgix.net/ca60b0ac/uploads/origins/b55fb522-6479-4dc8-bd79-8e14e23120ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d8cac5d714ce484662fae66cb75de6 3x"}, "body": "朝起きて白湯 様\n\nいつもお世話になっております。\nConoha(コノハ)と申します。\n\n白湯様のシナリオ、文章の表現が本当に好きでいつも楽しく読ませていただいております。\nこの度以下のテーマでテキストの作成をお願いしたいと思いご連絡いたしました。\n\n－－－－－－－－－－－－－－－－－－－－－\n\n【依頼内容】\n\n◆テーマ:「音楽を聴く」\n\nサブスクで聴く音楽。CDショップで試聴する音楽。ライブハウスで聴く音楽。\n同じ曲でも、聴く場所や季節によって何も感じない時もあれば、胸がめちゃめちゃ苦しくなる時もあるし。\nアーティストが作った1曲を、それを聴く人の数だけ好きとか嫌いとか無関心だとか、曲を聴いた時に抱く様々な感情や想い出など思い浮かぶ情景があるのがとてもエモくていいなと思いました。\n\n誰かの人生を音楽がどう影響してきたのか、アーティスト目線ではなく、曲を聴く側の視点で描いた文章を読んでみたいです。\n\n－－－－－－－－－－－－－－－－－－－－－\n\n私は音楽が大好きなのですが、同じ曲を聴いていても皆それぞれ違った感想があって面白いなと思ったので、音楽と人の物語を白湯さんはどんな言葉で表現するのか見てみたいなと思いこのテーマにしました。\n\n白湯さん自身の目線でも、創作キャラ目線のストーリーでも大丈夫です。\n文章は詩、短歌、SS、お好きなもので執筆いただきたいです。\n文字数が長くなるようでしたら依頼料増額いただいて構いませんので、白湯さんが書いていて楽しいと思える文章を読めたら嬉しいなと思います。\n\nご多忙のところ恐れ入りますが、何卒ご検討下さいませ。", "nc": 128, "word_count": 337, "transcoder": "text", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@tottamatrpg/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 895524, "client_id": 947058, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aac99a37d6bac8b50075b1b99430807", "srcset": "https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3aac99a37d6bac8b50075b1b99430807, https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d9b9e23927072a082f5fd69a883e85c 2x, https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36cd4e2f7113aaf87a4502160c7db3b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e11fe1f516a35cb10ec542400941cc8", "srcset": "https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e11fe1f516a35cb10ec542400941cc8, https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4551d85ea773a8d6d7e285709a9bbc5b 2x, https://si.imgix.net/dfb4f2df/uploads/origins/3cf0a84f-81bc-428e-a666-c31553f54997?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b5661a9e9f727056413a8ad8631cce2 3x"}, "body": "あきまろさん、こんばんは！：）\n\nあきまろさんのイラストが大好きなので、あきまろさんの描くコミックが見たいよ〜と思いお願いに参りました！お願いしたいのは下記の探索者の作品です（シナリオのネタバレはありません）。\n\n///\n\n◆ 弌津 イヅ（いつづ いづ）／片目の隠れた女（165cm 31歳）\n一人称：私\n二人称：あなた・芥部\n\n理系の研究者。笑うときは静かに柔らかく笑うような、落ち着いた女。\n「一人でも生きていけそう」と言われるタイプ。料理はやや苦手。\n芥部のことが恋愛的に好きなこともあり、芥部の前ではよく笑い、軽い冗談や暴言を言うこともある。\n一度なにも言われずに1年ほど置いていかれたことがあり、無言で去られることにややトラウマがある。\n※ 恋愛的な\"好き\"はあるけど、芥部か世界かどちらかを選ぶなら世界を選ぶタイプ\n\n「直近の資料は全部ファイリングしてまとめてあるわ。必要ならいつでも言って」\n「芥部、そこ、寝癖ついてるわよ。……嘘。引っかかった？」\n「もう、置いていかないでね　きっと、約束してくれる？」\n\n・・・\n\n◆ 芥部 隆一（あくたべ りゅういち）／メガネをかけた男（182cm 31歳）\n一人称：私（職場や他人に）・俺（弌津と二人の時）\n二人称：君・お前・弌津\n\n女の元同僚。あまり表情は変わらず、落ち着いたクールなTHE・研究者といった性格。\n家では二匹の猫を飼っている。白猫のオディ、黒猫のキース。\n鈍感で弌津の感情に気づいていないが、大切にしたい人だとは遠回しに弌津に告げている。\n※ 恋愛的な\"好き\"の自覚はないが、弌津か世界かどちらかを選ぶなら弌津を選ぶかも。\n\n「珈琲をいれるが、弌津も飲むか」\n「これからまた忙しくなる。帰れる時に帰っておけ。……おい、寝袋を広げようとするな、それは俺の私物だ」\n「今までは目まぐるしく時間が流れていて息をつく暇も無かったが、時間を持て余すのも、それはそれで考えものだな。……いや、これもまた、悪くはないか……」\n\n///\n\n[ 資料URL ]\nhttps://drive.google.com/drive/folders/12SsEw0z8TXg7RAG5VRLZSg