さい\n\n・全然急ぎませんので、気軽に受けていただけましたら幸いですヾ(*´∀｀*)ﾉ\n\nhttps://twitter.com/kotohakabeuchi/status/1761642021226508703/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 62525, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひらい祐夢", "screen_name": "hirai_yumu", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F80a0cf70-5529-4373-9f44-6e041ab67caa.webp&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/ad1c8fca-0145-48b6-adee-cd98e08191fc.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 144}, {"id": 579479, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "たまねぎ", "screen_name": "tmngmzi", "avatar_url": "https://pbs.twimg.com/profile_images/1095295012529557506/XkpV2cUL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3146088980/1677503118/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1262521, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いそぎんちゃく２号🎨イラスト依頼募集中", "screen_name": "isoginchaku2go", "avatar_url": "https://pbs.twimg.com/profile_images/1731593633546338304/F6o9WNg3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1323454044195577859/1728273317/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "a