u3067\uff08\u3084\u3093\u3061\u3083\u305d\u3046\u306a\u76ee\u3064\u304d\u3002\u5927\u304d\u3081\u3002\u732b\u76ee\u3002\u3067\u30cf\u30a4\u30e9\u30a4\u30c8\u7121\u3057\u304b\u3001\u3050\u308b\u3050\u308b\u3057\u305f\u3088\u3046\u306a\u76ee\u304b\u3001\u30ae\u30e9\u30ae\u30e9\u3057\u305f\u76ee\u3001\u6b7b\u3093\u3060\u69d8\u306a\u76ee\u3001\u75c5\u3093\u3060\u69d8\u306a\u76ee\u3001\u2727\u304c\u771f\u3093\u4e2d\u306b\u3042\u308b\u69d8\u306a\u76ee\u3001\u30cf\u30fc\u30c8\u304c\u771f\u3093\u4e2d\u306b\u3042\u308b\u76ee\uff09(\u5168\u4f53\u306b\u5408\u3046\u611f\u3058\u306e\u3069\u308c\u304b\u3001\u304b\u3001\u4f5c\u8005\u69d8\u306e\u3082\u3063\u3068\u826f\u3044\u6848\u25ce)\n\n\u524d\u9aea\u306e\u307f\u30d1\u30c3\u30c4\u30f3\u3002\u9854\u5468\u308a\u3084\u307b\u304b\u306f\n\u8170\u307e\u3067\u3042\u308b\u30ed\u30f3\u30b0\u306e\u30b9\u30c8\u30ec\u30fc\u30c8\u3002(\u771f\u3063\u9ed2\u304b\u7d2b)\n\uff08\u8033\u304c\u51fa\u308b\u5834\u5408\u306f00G\u306e\u8d64\u306eCBR\u3092\u304a\u304a\u304d\u3081\u306b\u3064\u3051\u3066\u307b\u3057\u3044\u3067\u3059\u3002\uff09\n\u4e0b\u5507\u3060\u3051\u771f\u3093\u4e2d1.\u5de6\u53f3\u306b\u30b3\u30fc\u30f3\u306e\u53e3\u30d4\u30a2\u30b9\u3092\u3064\u3051\u3066\u307b\u3057\u3044\u3067\u3059\u3002\n\u53e3\u306f\u5c0f\u3055\u3081\u3067\u3059\u3002\n\u808c\u306f\u75c5\u7684\u306b\u767d\u304f\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u5de6\u8155\u306b\u4e8c\u306e\u8155\u307e\u3067\u30d3\u30c3\u30b7\u30ea\u5185\u5074\u5916\u5074\u3082\u81ea\u50b7\u306e\u75d5\u306a\u3069\u8d64\u304f\u6d3e\u624b\u306b\u5927\u8888\u88df\u306b\u518d\u73fe\u3057\u3066\u6b32\u3057\u3044\u3067\u3059\u3002(\u53ef\u80fd\u306a\u5834\u5408\u306e\u307f\u3067\u25ce)\n\u53f3\u8155\u306e\u624b\u9996\u304b\u3089\u8098\u306e\u771f\u3093\u4e2d\u5916\u5074\u306b\u5927\u304d\u304f\u8718\u86db\ud83d\udd77\u3092\u81ea\u5206\u3067\u5207\u3063\u3066\u63cf\u3044\u3066\u308b\u306e\u3067\u5207\u308a\u50b7\u3067\u8718\u86db\u3092\u66f8\u3044\u3066\u6b32\u3057\u3044\u3067\u3059\u300