uff01\n\u3068\u3063\u3066\u3082\u7d20\u6575\u3067\u53ef\u611b\u3044\u30a4\u30e9\u30b9\u30c8\u3092\u63cf\u304b\u308c\u3066\u308b\u306e\u3092\u62dd\u898b\u3057\u307e\u3057\u3066\u3001\u662f\u975e\u30a4\u30e9\u30b9\u30c8\u3092\u5236\u4f5c\u3057\u3066\u9802\u3051\u305f\u3089\u3068\u601d\u3044\u3054\u9023\u7d61\u3055\u305b\u3066\u9802\u304d\u307e\u3057\u305f\u3002\n\n\u25c6\u5185\u5bb9\u3068\u8981\u671b\n\u30fb\u69cb\u56f3\u3084\u30dd\u30fc\u30ba\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\uff01\u51fa\u6765\u308c\u3070\u590f\u3063\u307d\u3044\u3068\u5b09\u3057\u3044\u3067\u3059\uff01\n(\u670d\u88c5\u7b49\u306f\u63cf\u304d\u3084\u3059\u3044\u7269\u3078\u5909\u66f4\u3057\u3066\u9802\u3044\u3066\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002\n\u5909\u3048\u3066\u9802\u3051\u308b\u5834\u5408\u306f\u53ef\u611b\u3044\u96f0\u56f2\u6c17\u3067\u597d\u304d\u306b\u63cf\u3044\u3066\u9802\u3051\u305f\u3089\u5b09\u3057\u3044\u3067\u3059\u3002)\n\u30fb\u8cc7\u6599\u306b\u3042\u308b\u732b\u8033\u306e\u304a\u9b5a\u3055\u3093\u306f\u30d5\u30a3\u30c4\u30ca\u30fc\u3067\u30ea\u30b9\u30ca\u30fc\u3055\u3093\u306e\u4e8b\u3067\u3059\u3002\n\u3082\u3057\u4e00\u7dd2\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u3068\u3063\u3066\u3082\u5b09\u3057\u3044\u3067\u3059\u3002\n\u30fb\u53ef\u80fd\u3067\u3042\u308c\u3070\u80cc\u666f\u3001\u30b5\u30a4\u30f3\u306f\u8868\u793a\u30fb\u975e\u8868\u793a\u30fbPSD\u30c7\u30fc\u30bf\u3067\u9802\u3051\u308b\u3068\u52a9\u304b\u308a\u307e\u3059\u3002\n\n\u25c6\u4f7f\u7528\u7528\u9014\nVtuber\u6d3b\u52d5\u3067\u4f7f\u7528(\u30b5\u30e0\u30cd\u30a4\u30eb\u30fb\u52d5\u753b\u30fb\u30c4\u30a4\u30fc\u30c8\u7b49)\n\n\u25a0\u30d5\u30a3\u30eb\u30f3\u30fb\u30b7\u30a3\u8a73\u7d30\u7b49\n\u30fb\u7a2e\u65cf\u306f\u732b\u306e\u5996\u7cbe\u30b1\u30c3\u30c8\u30b7\u30fc\u3067\u3059\u3002\n\u30fb\u540d\u524d\u306e\u30d5\u30a3\u30eb\u30f3\u306f\u4e07\u5e74\u96ea\u3067\u3001\u30b7\u30a3\u306f\u5996\u7cbe\u3092\u610f\u5473\u3057\u307e\u3059\u3002\n\u30fbPON\u306a\u6240\