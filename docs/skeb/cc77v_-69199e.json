e00\u90e8\u679d\u306e\u3088\u3046\u306b\u306a\u3063\u3066\u3044\u308b\u3002\n\n\u3068\u3042\u308b\u5cf6\u304b\u3089\u751f\u8d04\u3068\u3057\u3066\u6f02\u6d41\u3057\u3066\u304d\u305f\u7537\u306e\u5a18\u3002\n\u6d77\u4e0a\u3067\u30c8\u30a5\u30fc\u30ab\u306b\u547d\u3092\u6551\u308f\u308c\u3001\u52e2\u3044\u3067\u5f7c\u5973\u306b\u5f1f\u5b50\u5165\u308a\u3057\u305f(\u3064\u3082\u308a)\u3002\n\u306a\u3093\u306e\u5f1f\u5b50\u304b\u306f\u672c\u4eba\u3082\u308f\u304b\u3063\u3066\u306a\u3044\u3002\n\u4e00\u4eba\u79f0\u306f\u79c1\u3002\u4e01\u5be7\u3067\u512a\u3057\u3044\u6027\u683c\u3002\u6027\u81ea\u8a8d\u306f\u7537\u3002\n\n\u30c8\u30a5\u30fc\u30ab\u306e\u3053\u3068\u306f\u5f37\u304f\u3066\u304b\u3063\u3053\u3088\u304f\u3066\u7dba\u9e97\u306a\u5e2b\u5320\u3068\u6155\u3046\u3002\n\u5f1f\u5b50\u306e\u3064\u3082\u308a\u306a\u306e\u3067\u3001\u5f7c\u5973\u304b\u3089\u306e\u611b\u60c5\u8868\u73fe\u3082\u4fee\u884c\u306e\u4e00\u90e8\u3060\u3068\u601d\u3063\u3066\u3044\u308b\u3002\n\u4e00\u65b9\u3001\u7570\u6027\u3068\u3057\u3066\u3082\u610f\u8b58\u3057\u3066\u308b\u306e\u3067\u3001\u65e5\u3005\u30c9\u30ae\u30de\u30ae\u3002\n\n\u25cf\uff08\u3082\u3057\u5fc5\u8981\u306a\u3089\uff09\u2193\u30c8\u30a5\u30fc\u30ab\n\u540d\u524d\uff1a\u30c8\u30a5\u30fc\u30ab\n\u6027\u5225\uff1a\u5973\n\u5916\u898b\u5e74\u9f62\uff1a10\u4ee3\u5f8c\u534a\u3050\u3089\u3044\n\u8eab\u9577\uff1a165cm\n\u5099\u8003\uff1a\u30aa\u30aa\u30cf\u30b7\u304c\u30e2\u30c1\u30fc\u30d5\u3002\u3044\u308f\u3086\u308b\u4eba\u9593\u8033\u306f\u7121\u3057\u3002\u8033\u306b\u3042\u305f\u308b\u90e8\u5206\u306f\u5b8c\u5168\u306b\u9aea\u306b\u96a0\u308c\u3066\u307e\u3059\u3002\n\n\u5357\u56fd\u306e\u738b\u5bae\u306b\u4ed5\u3048\u308b\u3001\u6709\u7ffc\u65cf\u306e\u6226\u58eb\u3002\n\u8003\u3048\u306e\u8aad\u307f\u3065\u3089\u3044\u7121\u53e3\u306a\u306e\u3093\u3073\u308a\u5c4b\u3002\u6020\u3051\u8005\u3092\u81ea\u8ca0\u3057\u3001\u304a\u663c\u5bdd\u5927\u597d\u304d\u3002\n\u305f\u3060\u3057\u5e73\u548c\u306b\u306e\u3093\u3073\u30