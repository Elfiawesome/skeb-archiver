-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c7e4bc3e4625e9956b4cacfeb769e51", "srcset": "https://si.imgix.net/ab871ee6/uploads/origins/ce6d3c31-10ba-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c7e4bc3e4625e9956b4cacfeb769e51, https://si.imgix.net/ab871ee6/uploads/origins/ce6d3c31-10ba-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e9d908cfced0ada5d1c6ba7056a702a 2x, https://si.imgix.net/ab871ee6/uploads/origins/ce6d3c31-10ba-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2475e0c60a4eb99fe7493c125763238f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab871ee6/uploads/origins/ce6d3c31-10ba-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65e24dc0b06949ffd382c4f5e74254b8", "srcset": "https://si.imgix.net/ab871ee6/uploads/origins/ce6d3c31-10ba-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65e24dc0b06949ffd382c4f5e74254b8, https://si.imgix.net/ab871ee6/uploads/origins/ce6d3c31-10ba-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9de7ba34dc8df2243f59b9fc161a429e 2x, https://si.imgix.net/ab871ee6/uploads/origins/ce6d3c31-10ba-42c9-8986-a42e0e02b3f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d158a09de1cfd89f92323409125637e 3x"}, "body": "初めまして🎶 \nはちさんの描かれる、動きのあるイラストや素敵な絵柄にに惹かれました…💘\nはちさんに是非、TRPG(CoC)のVOIDという\nシナリオで使用した自陣探索者の1枚絵を描いていただきたいと思いリクエスト失礼します🙇🏻‍♀️💫  人数が多いため金額に不足だなと感じましたらキャンセルして大丈夫です…😭🙏🏻 \n\n- - - - - - - - - - - - - - - - -  \n\n【 シナリオ名 CoC -\" VOID \" 】 \n✧あらすじ 西暦2030年、リボット社は史上初のチューリング・テストをパスしたアンドロイドを 開発し、VOID(ボイド)と名付け世界に発表した。 \nVOIDは瞬く間に世界に広まり、今やアンドロイドがいる生活は人々にとって当たり前となったのだ。\nそれから20年後の2050年 2つの事件が世間を騒がしていた。\nアンドロイドによる連続殺人事件。アンドロイドの連続破壊事件。警視庁はこの2つの事件を終息させる為新たに公安局刑事課アンドロイド事件捜査係を設立したのだった。 \n\n- - - - - - - - - - - - - - - - - \n\n 【 キャラクター概要 】 \n各キャラの見た目、詳しい性格等はすべて下記の リンクにそれぞれ記載しております⭐️\n(秘匿という枠はシナリオの重大なネタバレに 繋がりますのでもし閲覧する際は自己責任で お願いします🙏🏻💧) \n\n✧HO1：女性、新人刑事、武器 日本刀 今年刑事になったばかりの新人。 この若さでの抜擢は異例である。\nhttps://iachara.com/view/10575987 \n\n✧HO2：女性、新型アンドロイド刑事、\n武器 ショットガン HO1のパートナーロボット。 最新型の機能が揃えられている。\nhttps://iachara.com/view/10782885 \n\n✧HO3：男性、刑事、武器 サブマシンガン\n他の課から移動してきた刑事。今まであらゆる事件を解決してきたことだろう。\nhttps://iachara.com/view/10786471 \n\n✧HO4：男性、旧アンドロイド刑事、\n武器 拳銃 HO3のパートナーロボット。\nHO3を信頼しており、とても忠実なアンドロイド。 \nhttps://iachara.com/view/9653048\n\n✧共通ジャケット衣装の詳細、各関係性\nキャラクターシート\nhttps://drive.google.com/drive/folders/1wJaqxO4gDwreaMXTZUgu_2CosRm9czME\n\n- - - - - - - - - - - - - - - - - \n\n【 構図 】 \n武器を使うので戦闘シーンをお願いしたいです🙇🏻‍♀️🙏🏻\nそれぞれ武器を構えてる様子、戦っている様子…な感じでお願いします💫\n構図上、なるべくで大丈夫ですが、みんなのお顔が見えるような感じでお願いしたいです…🙏🏻💧 (無理そうでしたら大丈夫です👌🏻) \n\n- - - - - - - - - - - - - - - - - \n\n【 使用用途 】 \nXのヘッダー、個人観賞用、アイコンの使用\n自陣さんたちへのプレゼント です❤️‍🔥", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7su/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3440510, "client_id": 2892521, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d3f0e5126af56369ec20b8e26854dc3", "srcset": "https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d3f0e5126af56369ec20b8e26854dc3, https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1df6e18a54da8eb93b8b5d7f6a520e50 2x, https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bf79c6be23863dd789dc20523465f9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96452f6dd9017253193a8dfb27962e0c", "srcset": "https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96452f6dd9017253193a8dfb27962e0c, https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ce3573ce74d6ad2fee39046bcbde7a5 2x, https://si.imgix.net/dfd170c8/uploads/origins/fb600d85-5f4e-4db8-91e4-630600d3794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5efebeef159939a08b36e3e55b56fb0c 3x"}, "body": "はちさん、こんにちは。\nおすすめに流れてきたあなたの版権イラストの、大人数にも関わらず戦っている躍動感を前面に出したダイナミックな構図、武器などの小道具や木々や空間を美しく描写した緻密な描き込み表現を見てとても感銘を受け、ぜひ依頼させて頂きたいと思い、今回skebを送らせていただきます。\n\n今回は『VOID』というTRPGシナリオで作ったオリジナルキャラクターたちを描いて頂きたいです。以下、それぞれのキャラクターの設定を記載します。描く時の参考にしていただければ幸いです。\n\n\n【共通項目・設定】\n・2050年、アンドロイドや機械が日常的に普及した近未来の日本が舞台\n・キャラクターたちは全員刑事で、アンドロイドに関する事件を追う課に所属している\n・刑事はバディとしてアンドロイドを付属させることが義務となっている\n・一之瀬翔真と帆坂芭炉、銀城ヤマトとこたろうはそれぞれバディであり、お互いを大切に思いあっている\n・関係性は同課に所属しており、仲の良い先輩(銀城&こたろう)と後輩(一之瀬&帆坂)である\n\n\n❖一之瀬 翔真\n年齢：22歳\n使用武器：日本刀(電子刀)\n・爽やか好青年な新人刑事\n・素直で熱血で少し喧嘩っ早い男子高校生のような性格\n\n❖帆坂 芭炉\n年齢：不詳\n使用武器：ショットガン\n・危なっかしい翔真を支えるために付き従うアンドロイド\n・淡々とした態度でアンドロイドらしくあまり表情が動かない、基本真顔\n\n❖銀城ヤマト\n年齢：35歳\n使用武器：サブマシンガン\n・誠実で真面目な正義感に溢れた先輩刑事\n・仕事場では冷静で落ち着いた性格だが、プライベートは感情が豊か\n\n❖こたろう\n年齢：不詳\n使用武器：二丁拳銃\n・真面目な銀城を慕って付き従うアンドロイド\n・素直でまっすぐな性格で、人間らしい豊かな表情をする\n\n\n構図、背景等全てお任せします！資料等足りない部分ありましたら、御手数ですが再送依頼して頂けると幸いです。\n何卒よろしくお願いします🙇🏻‍♀️\n\nhttps://drive.google.com/drive/