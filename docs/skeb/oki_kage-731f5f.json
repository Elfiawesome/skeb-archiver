mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47b2efcd1b783f6db1d5a54a772d0db8, https://si.imgix.net/982547a6/uploads/origins/b1467d27-e3a3-4819-a0a3-88dc5c54a494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=464f1a42ee6ce01d871b48ca892afeb0 2x, https://si.imgix.net/982547a6/uploads/origins/b1467d27-e3a3-4819-a0a3-88dc5c54a494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27a2543c43c7ca442c63fb4d568a44f1 3x"}, "body": "沖影様\n\nこの前は素敵なイラストをお描き頂きありがとうございました！先生の作品がとても好きので、今回もご依頼させていただきました。\n\nキャラクターについて:\n\n「陳無一」\n180cm 修行者\n\n表面的にはあまり頼りない性格で、とても修行者には見えず、むしろ俗っぽい雰囲気に満ちている。非常に悪賢いで、悪徳商人のようであり。軽い口調で相当恐ろしいことを言い出すこともあるが、本質的には非常に重い感情を抱えている。ただこれまではそれをうまく隠してきただけだ。\n\nポーズ・表情・構図全てはお任せします、衣装など自由にアレンジしていただいて大丈夫です！\n使用用途：個人観賞、SNSのアイコン等\n\nご検討いただけると嬉しいです！ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Q7q2r-wpsWdNjCqaiREnChTur_E8dAwj?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oki_kage/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3010529, "client_id": 3371668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e84c052d0f05d328a9f3e5ad88383f8", "srcset": "https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e84c052d0f05d328a9f3e5ad88383f8, https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=893b798970cdd2ba3f7b8170a6f80cee 2x, https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5de738ff5a4e71ef8cc5196cec834a69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54519c024735003e9ff51807b298815c", "srcset": "https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54519c024735003e9ff51807b298815c, https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0063e4afcb77ad808050fc95c1816cf0 2x, https://si.imgix.net/30c6205b/uploads/origins/c046022b-ce85-40c7-ba74-9660ec16ac10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7136aade24920c210d5c8b124ce6576e 3x"}, "body": "沖影様\n\n初めまして。\n\n先生の素敵なイラスト拝見させて頂いて一目惚れしました。この度リクエストをお送りいたしました。\n\nキャラクターについて:\n\n「Chernot Collins」\n182cm 枢機卿\n\n中央の枢機卿です。自分の野心や攻撃性をうまく隠し、甘言で人の心を惑わす、本人は巧みに言葉で要点をぼかすのが得意ですが、実際に嘘をついたことは一度もありません。\n野心や欲望を持っている反面、心の弱い部分を捨てられず、自分の生徒に対して曖昧な感情を持っていて、その偽りのない「愛」に彼自身も気づいていませんでした。\n\n「Emerold Linton」\n168cm 神父/元貴族\n\n内気で温和な青年で、見た目はとても伝統的で優しい神父ですが、実はかなり反抗的で不作法なこともしますし、顔が単純なので誰も疑いません。\n自分の先生(Chernot Collins)に密かな恋心を抱いており、それをうまく取り繕ったつもりでも、相手には完全に見抜かれていました。先生に対して盲信的な態度で、自分が間違っていることはわかっていてもコントロールできません。\n\n二人の関係:\n\n元は先生と生徒の関係です。「Chernot」は「Emerold」の家族を利用するために「Emerold」の家庭教師になりました。\n「Emerold」は家族が滅びた後、何も知らずに神父になりました。\n\nポーズ・表情・構図全てはお任せします、衣装など自由にアレンジしていただいて大丈夫です。\n使用用途：個人観賞、SNSのアイコン等\n\nご検討いただけると嬉しいです。ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1SwX-F3X-MT-tGMlBR0FCWblO18YerXhh?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oki_kage/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3010529, "client_id": 1174606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b3b29f51f7c2f7bb971bdab7eb3b9db", "srcset": "https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b3b29f51f7c2f7bb971bdab7eb3b9db, https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69187bff24d1bb3ee2fcbe35def8b118 2x, https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dc2ff4ec0b3514d5311e98d65158a3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94cd17df5bfea0dfef9d4465eadeafc2", "srcset": "https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94cd17df5bfea0dfef9d4465eadeafc2, https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32e71efbfb620e81980f2769c4753df5 2x, https://si.imgix.net/a619fbd5/uploads/origins/611231a6-0e3e-457a-8d61-6451d2bd332d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=143cf716847f96f0a6211bb0220b2e10 3x"}, "body": "こんにちは、あなたの作品は本当に美しいです！私のオリジナルキャラクター、レインの「アルター」形態を描いていただけませんか？衣装はいくつかあるので、お好きなものを選んでください。\n\nこの姿は自制心を失った時のみ現れ、非常に苦痛を伴う体験です。表情は狂気じみたものや、血に飢えたような野性的な笑みを浮かべていることもあれば、内面で自制を取り戻そうともがいているため涙を浮かべていることもあります。シーン設定は自由ですので、お好きなように描いてください。 :)\n\nhttps://drive.google.com/drive/folders/1cnYKBGZ-z5fDSSrLzgdJS4aGMSWf-sEP?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oki_kage/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3010529, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c11a430391a4b3d4e35e92d3e99e5994", "srcset": "https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c11a430391a4b3d4e35e92d3e99e5994, https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30089d299c52d4d26e50d6bf0aeca384 2x, https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9ab078c3fb7c8f0ab45a9d9e4467baf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=988ad7047871deea4feec2c67ace3d03", "srcset": "https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=988ad7047871deea4feec2c67ace3d03, https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2602025cf70129a091e503662205a5e7 2x, https://si.imgix.net/b0e42c09/uploads/origins/9af7e8b3-0c16-4193-a941-e3f331d908d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6524a27472b43d1090c8e4210744d3f 3x"}, "body": "はじめまして、先生。\n先生のイラストの作風がとても好きで、特に線の美しさと分かりやすさに強く惹かれました。\nTwitterで拝見した、モノクロで描かれるキャラクター表現が特に素晴らしく、ぜひ同じモノクロ（白黒）スタイルで、私のOC Nightshade のイラストをご依頼できないかと思い?\n\n\n物語の舞台はファンタジー世界です。\n\nNightshade:\n17歳の少年。黒髪で猫のような目をしており、全身黒い服を身にまとっています。身長は176cmです。ワンドや長い杖を用いて幻術魔法を操る若き魔術師で、幻術は不安定な魔法と見なされがちですが、Nightshadeはその精密な制御を得意としています。\n幼少期の良くない経験から他人を信用せず、計算高く皮肉屋な性格です。他人との身体的接触を嫌い、冷淡な態度で自分を守る壁を築いています。幻術魔法使いに共通して、完璧な嘘と隙のない仮面を使いこなす達人でもあります。鋭い舌で他人をからかうことも多く、基本的には利己的な人物ですが、不思議なことに動物に対してはとても優しく、動物たちも本能的に彼に懐きます。\n（無垢な存在に対しては、無意識のうちに本当の愛情や庇護欲を向けてしまいますが、本人はまだそれに気づいていません。）\n\nNightshadeの使い魔は、Aequinox という名の、淡い金色のユニコーンで、角が折れています。\n二人は性格もよく似ており、Aequinoxも強気で意志が強く、気性は激しいですが、一度信頼した相手とは地獄の果てまで共に行くような存在です。\n\n*Nightshadeの爪は黒く塗られています。猫のような目をしており、下まぶたの部分が金色です（顔の資料はURL内にございます）。\n*雰囲気としては、Fate/Grand Orderのジャンヌ・ダルク（オルタ）やオベロンに近い印象かと思います…!\n* 楽曲「BLACK DIAMOND」（ほしな歌唄／水樹奈々）も、Nightshadeの性格をとてもよく表していると感じています。\n\n\nNightshadeの衣装案を複数URL内に掲載しておりますので、どれを描いていただいても構いません。\n構図につきましても、すべて先生にお任せいたします。どうかご自由にお描きください。\nご検討いただけましたら幸いです。\n何卒よろしくお願いいたします。＞＜💙🪞\n\nhttps://drive.google.com/drive/folders/1fFk4alXOR8c7iDHW5SxVVO1aQTlU92Nm", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oki_kage/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3010529, "client_id": 3006679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2880433/uploads/origins/973c04b7-d68b-4184-b336-96d1416b222f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=018172b68a8f3fad6c34127bdbb1daa1", "srcset": "https://si.imgix.net/a2880433/uploads/origins/973c04b7-d68b-4184-b336-96d1416b222f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=018172b68a8f3fad6c34127bdbb1daa1, https://si.imgix.net/a2880433/uploads/origins/973c04b7-d68b-4184-b336-