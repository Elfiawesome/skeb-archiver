22b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3adb29f023f2fa254c5221e868e21d1", "srcset": "https://si.imgix.net/9817b1bf/uploads/origins/88b51773-c1bd-4f58-bf50-4aa969822b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3adb29f023f2fa254c5221e868e21d1, https://si.imgix.net/9817b1bf/uploads/origins/88b51773-c1bd-4f58-bf50-4aa969822b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29c22fd028fbc9219409e629d40ef5af 2x, https://si.imgix.net/9817b1bf/uploads/origins/88b51773-c1bd-4f58-bf50-4aa969822b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d48601a347fac5be6491e5c429fcb4e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9817b1bf/uploads/origins/88b51773-c1bd-4f58-bf50-4aa969822b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b46f1daefe8c782274b334991ef8f33a", "srcset": "https://si.imgix.net/9817b1bf/uploads/origins/88b51773-c1bd-4f58-bf50-4aa969822b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b46f1daefe8c782274b334991ef8f33a, https://si.imgix.net/9817b1bf/uploads/origins/88b51773-c1bd-4f58-bf50-4aa969822b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f9e10401cb53e2c14317a81df8529db 2x, https://si.imgix.net/9817b1bf/uploads/origins/88b51773-c1bd-4f58-bf50-4aa969822b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e135dd1d020b67640ff568e50db9b632 3x"}, "body": "こんにちは！今回は @_mpmbl さんのウェブ小説 \"Nothing Short of a Miracle Quest\" から \"Stella\" を描いていただきたいと思います。\nhttps://drive.google.com/drive/folders/1IqEZ0o22MY6I2uLtjw4fOolNjd9NhWty?usp=sharing\n魔女が作った念力でカードを操るカードゲームに興じるステラを描いてほしい。カードが飛び交い、空中でカード同士がぶつかり合う中、冷静に集中するステラを見てみたい。細かい設定はお任せしたい。対戦相手も描かなくていいです！ありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_____hokanko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747021, "client_id": 3635005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b684dca90a88605dd29925c3be659a9", "srcset": "https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b684dca90a88605dd29925c3be659a9, https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77681f7524d7c7e79e17f6b17e9742d6 2x, https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=811c2df46214b843c7b3d91c1b8860f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae65a7a3a5e10883aa8b6e8daa4013fb", "srcset": "https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae65a7a3a5e10883aa8b6e8daa4013fb, https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc0fc06ebc8dc59739ee6568bd7094db 2x, https://si.imgix.net/c002fd7e/uploads/origins/0fa4a186-410e-44f0-86f1-083a390ac16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=931ed109802d10229da4f9c1377ef28a 3x"}, "body": "柘榴酒先生\n\n初めまして。このskeb(https://skeb.jp/@_____hokanko/works/1）には本当に感銘を受けました。背景と作品の雰囲気が非常に魅力的です\n\n可能であれば、私のOCを依頼したいです\n\n【設定】\n彼女の世界で最も名門の一家の娘。母親によって完璧な従順な娘として育てられたため、自己意識に欠け、心や願いがあることすら知らない操り人形のような存在である\n\n彼女は主にメイドスタッフに育てられたが、そのスタッフは頻繁に入れ替わった。短期間で彼らと絆を深められなかった結果、彼女は彼らやその生活について観察し質問することを趣味とした。そして出会った一人ひとりにページを割き、集めた情報を全てノートに書き留めた。25歳になるまでに、百冊を超えるノートを収集した。各ノートには、彼女が出会った人々ごとに複数のセクションが設けられている\n\n母親が有名人であるため、彼女は頻繁にカメラの前に姿を現す。そんな時、彼女は親しみやすい笑顔を浮かべ、母親が期待していると思われる言葉を口にする。他人と交流する際には、収集したノートを参考に、相手が自分から何を求めているかを推測し、それに応じて話し方を調整する。ある時、彼女は自分の有名な身元を隠すために変装することさえ決めた。そうすれば、相手を怖がらせずにできるだけ多くの人と話せるからだ\n\nしかし彼女は依然として自分のノートとその意味を正しく理解するのに苦労することが多く、その結果、非常に率直に行動したり話したりすることがある。そのため、彼女を知るようになったほとんどの人は、彼女が何か言って自分を暴露したり境界線を越えたりすることを恐れ、交流を避けるようになった\n\n彼女の母親は、やがて娘の趣味を厄介なものと感じ、やめさせるために彼女の目の前でノートを全て燃やすことにした。少女はノートが燃え尽きるまで見守り、この出来事の後、まるで空っぽの殻のようだった。しかし、自分にも願いがあるという真実に直面するまでは。それ以来彼女は自分の感情をもっと認めようと努め、周囲の人々にそれを伝えようとしている\n\n【リクエスト】\n構図の選択はお任せしたいと思います。彼女のキャラクターテーマには、操り人形に加え、鏡、探偵、そして開放された檻に住む鳥が含まれる\n\n依頼金額が不足している場合は再送してください\n\nご検討いただきありがとうございます\n\nhttps://drive.google.com/drive/folders/1oaVRkLDmMlyLe_G5eLln8HK_trFG45er?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_____hokanko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3747021, "client_id": 3393163, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff11cc14/uploads/origins/863fffa9-7ada-4483-9976-c3290f6b738a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c34a4f9b98e342f22cb1085f91a059", "srcset": "https://si.imgix.net/ff11cc14/uploads/origins/863fffa9-7ada-4483-9976-c3290f6b738a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c34a4f9b98e342f22cb1085f91a059, https://si.imgix.net/ff11cc14/uploads/origins/863fffa9-7ada-4483-9976-c3290f6b738a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fddc191e3f4cc908387730d00b53b05 2x, https:/