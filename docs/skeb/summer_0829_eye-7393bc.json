2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=184839e4ec25904cb009d5926cf08c50 3x"}, "body": "夏蟻様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nかわいらしいイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n当方、みゅー・あうろーらのイラストを依頼させていただければと思います。\n\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。ゲームのキャラ風でも何かのボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n夏蟻様の趣味やフェチ、性癖などを全開で盛り込んでいただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@summer_0829_eye/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3734310, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b95707c/uploads/origins/d7ee95a0-da0d-4e44-b2fa-7fa21fc4fb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb695727c465c2c7b6de8057ab63056", "srcset": "https://si.imgix.net/5b95707c/uploads/origins/d7ee95a0-da0d-4e44-b2fa-7fa21fc4fb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb695727c465c2c7b6de8057ab63056, https://si.imgix.net/5b95707c/uploads/origins/d7ee95a0-da0d-4e44-b2fa-7fa21fc4fb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cb4acf3bdaaf163916cbe5331a98661 2x, https://si.imgix.net/5b95707c/uploads/origins/d7ee95a0-da0d-4e44-b2fa-7fa21fc4fb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=200fce5d4d9cd1276486ea6967ec25b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.i