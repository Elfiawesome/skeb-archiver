gins/bfc47021-1747-45e9-927a-93dfc95f4bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d3b0a25f69e3e66fc00949003b64a00 3x"}, "body": "Good evening!\nI have always thought that you are a very nice painter.\nI am happy to be able to commission you in this way.\n\nAs for your request\nI, Pagu the Third (either 2D or 3D), would like you to draw me.\nThere are no specifications regarding composition, clothing, etc.\nI would be happy to have you draw me in any way you like.\n\nIf you would like to give us a description of your character as a reference, we would like to know\nHe is a mild-mannered, drunken, random guy who likes bio and DBD.\nThank you for your consideration.\nhttps://twitter.com/1221pagu/status/1586854142026604547?s=46&t=eaRn0TlPOcSujpDzGwSsYQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Vhimcaminomushi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2255472, "client_id": 2489506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db8959eb2ef4768d3907a54bd695c0f", "srcset": "https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db8959eb2ef4768d3907a54bd695c0f, https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1201d3d54846ee4e30cd298914af099a 2x, https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4a90e688886d6d3793b204202c8e722 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": 