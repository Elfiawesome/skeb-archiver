s/bfc47021-1747-45e9-927a-93dfc95f4bc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d3b0a25f69e3e66fc00949003b64a00 3x"}, "body": "Good evening!\nI have always thought that you are a very nice painter.\nI am happy to be able to commission you in this way.\n\nAs for your request\nI, Pagu the Third (either 2D or 3D), would like you to draw me.\nThere are no specifications regarding composition, clothing, etc.\nI would be happy to have you draw me in any way you like.\n\nIf you would like to give us a description of your character as a reference, we would like to know\nHe is a mild-mannered, drunken, random guy who likes bio and DBD.\nThank you for your consideration.\nhttps://twitter.com/1221pagu/status/1586854142026604547?s=46&t=eaRn0TlPOcSujpDzGwSsYQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Vhimcaminomushi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2255472, "client_id": 2489506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db8959eb2ef4768d3907a54bd695c0f", "srcset": "https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4db8959eb2ef4768d3907a54bd695c0f, https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1201d3d54846ee4e30cd298914af099a 2x, https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4a90e688886d6d3793b204202c8e722 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d8807967c20534f1fd927af34d67e32", "srcset": "https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d8807967c20534f1fd927af34d67e32, https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80b6eba0cebf9a712d04a4e6c8fe6a71 2x, https://si.imgix.net/36f8e532/uploads/origins/7f8af596-f74e-49f3-80e4-4470691043ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10c97d458dd0c03588c9ed73a177c79e 3x"}, "body": "This is my first Skeb request!\n\nI would like to have a portrait of myself, Chiyoko Mutsuki, in a suit, and I will leave the composition, etc. to you.\nIf possible, I would like to use it as an icon or a thumbnail for distribution, so I would appreciate it if you could give me a transparent version as well.\n\nThank you very much!\n\nhttps://twitter.com/ohuton0125/status/1572987709391777793", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Vhimcaminomushi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2255472, "client_id": 2142550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b67628d3207a57028f56fc56fa1973c0", "srcset": "https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b67628d3207a57028f56fc56fa1973c0, https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4c9dde64d9385cf60d99d48b59507b6 2x, https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45ee56cc53cbf522810fbc2b82510569 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2127fca88c61186dfbaf9615573e8dcc", "srcset": "https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2127fca88c61186dfbaf9615573e8dcc, https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=349f62fca49e123a8b77f33cdbf8b79f 2x, https://si.imgix.net/a2be7df4/uploads/origins/28808174-c06a-44ce-a8f3-ec67255d30ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=87357ba0c83ac7ac53eb39a5d458e346 3x"}, "body": "Thank you very much for your help, my name is Hitoshi Itsumian, I am a Vtuber. I always enjoy watching your videos and illustrations.\nI would like to make a request for you to draw an illustration of Himuka and myself, Hitoshi Itsumian.\n\nI would like to have a scene where Himuka and I are in a smoking room, and I am borrowing Himuka's lighter.\n\nI think there is probably a difference in physique between Himuka and me, so I would like to see Himuka lighting the lighter and me bending down to borrow it.\n\nI would like to see Himuka-san's costume either as usual or arranged.\nI would like to see her in a scajan if possible, but the earlier costumes are perfectly acceptable.\n(I am sorry, but I do not have a three-sided drawing of Himuka.)\n\nI know you are busy, but I would appreciate your consideration.\n\nhttps://twitter.com/AnjiItsumi", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Vhimcaminomushi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2255472, "client_id": 2420311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee13381772fc8c359e575ba464ccbdff", "srcset": "https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee13381772fc8c359e575ba464ccbdff, https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ad56f1c6ff49e85a1703e4567c52ecd 2x, https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f43e3559acec05cb74b9914e596baccf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=466fb7fa2b741c959f58afb35a499d02", "srcset": "https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=466fb7fa2b741c959f58afb35a499d02, https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65ec80398a1eb7ff898b4cd3dc60e181 2x, https://si.imgix.net/1d9ae23e/uploads/origins/c348fef8-8212-4f83-9c9d-eebc4079635e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad7f37f85693f766e5c63c7ebb2d4125 3x"}, "body": "Hello! I was drawn to your style and your self-incarnation! I'm hoping you can help illustrate my own OC/upcoming Vtuber, a lazy, overworked devil boy who works for his company's R&D department. He used to be happier and hard-working, but became disillusioned and overall exhausted at how he was treated, due to long overtime hours and unfair abuse from his bosses. As a result, the only thing he cares about is sleeping, and even wears his pajamas under his lab coat and carries an emergency pillow in case of exhaustion and napping.\n\nHis appearance is slightly feminine and androgynous, due to his long, messy hair. He also has jagged teeth and tired eyes. He usually has a tired expression, but can be excitable depending on the situation, and his hair has as \"ahoge\" that changes depending on his mood.\n\nPlease draw him in whatever pose or expression you see fit; I only ask that you keep in mind his jagged teeth, tired eyes and lab coat.\n\nI'd like to use the illustration for SNS. Thank you!\n\nhttps://drive.google.com/drive/u/1/folders/1izwuwpKT-mNWOCTAqINqWd_1i62E9k_z", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Vhimcaminomushi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2255472, "client_id": 108153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e62643eaef9cf528b4d85054d3f8f2", "srcset": "https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e62643eaef9cf528b4d85054d3f8f2, https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adc444d20744c3b7eeb991c1dec28d2e 2x, https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c468495ce2a32ae5d0ef7051acaf376 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=732984a607805cb08c88eab2f1ffa52f", "srcset": "https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=732984a607805cb08c88eab2f1ffa52f, https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0afde6ed7a05aeabdcdd8e64362b2d88 2x, https://si.imgix.net/5d6efad7/uploads/origins/19a1c5bf-b81f-4cd1-b6a1-0a705948413e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0dcd2f808c1a80d51fd32528ccb119df 3x"}, "body": "Thank you for your help!\nI would like to request an illustration.\n\n■Illustration of your request\nCan you please do a fan art of my favorite Vtuber, Mizukage Nagi Luca...?\nShe is an ASMR lady who loves tea of an ordinary office worker.\nIn the following outfit, she is stretching her hands upward and making a face like \"ku~! I'd like to see her face with her arms outstretched upwards in the following outfit.\n(Please make her armpits visible.)\n\nCostume: ASMR Costume (without cardigan, camisole only)\nhttps://meish.s3-ap-northeast-1.amazonaws.com/i/Ruka_Mikanagi/Ruka_Mikanagi_tachie_1633015307129.png?1633015308688\n\nhttps://twitter.com/Ruka_Mikanagi/status/1445010977536180239?s=20&t=6y4yjmrNtZ1y68c-4jxOXA\n\nFixed tweets on Twitter\nhttps://twitter.com/Ruka_Mikanagi/status/1443615269058867204?s=20&t=SY2D6r0ZqBOBL6YPj9n6hQ\n\nShe is a beautiful and leggy Vtuber with bangs that sparkle like the surface of the water.\n\n  Usage\nDesktop background use\nFan art on Twitter\nThumbnails on Youtube and Twitter\n\n ■Size\nThere is no size specification.\n\n  ■Others\nWe would appreciate it if you could deliver the image in PSD format.\n\nWe hope to have a chance to work with you! Best regards!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 157911, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "羽野ほっぱ🌻🍼お絵かき怪人Vtuber", "screen_name": "uno_hoppa92", "avatar_url": "https://pbs.twimg.com/profile_images/1996248163678879744/vDww91KD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1090805750727753730/1750467369/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "voice"}], "nc": 33}, {"id": 344372, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ヒレカク@skeb受付中", "screen_name": "hirekaku", "avatar_url": "https://pbs.twimg.com/profile_images/1853074498716864512/ChWTCvG0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/832948353247830021/1731249053/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1030628, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kittanke＠skeb募集中", "screen_name": "kittanke_illust", "avatar_url": "https://pbs.twimg.com/profile_imag