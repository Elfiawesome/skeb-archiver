力は圧倒的であり、私のオリジナルキャラクターは、その力を抑えることができる数少ない人物の一人であるがゆえに騙されたのだ。（後に彼女は救われるが。）", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usaebibi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3805326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1995dbd71926569830c0bc4e64e1ca3c", "srcset": "https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1995dbd71926569830c0bc4e64e1ca3c, https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9b24cda6bbe991947b9f68cf1596e58 2x, https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75996bfa93d686ada47a3cd0bd70491c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cf23641d784432b75e1818f57cee8d2", "srcset": "https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2cf23641d784432b75e1818f57cee8d2, https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28a7c711418de1585ee83dca4cda5c19 2x, https://si.imgix.net/be01e0ac/uploads/origins/1dc0dae6-0b07-4796-9825-c04f6565f588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cr