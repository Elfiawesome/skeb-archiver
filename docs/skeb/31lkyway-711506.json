n【依頼内容】\n野外で水浴びをしている主人公キャラクター。\n探しにきた仲間(ヒロイン？)にその場面を見つかって、驚いたり照れた表情をして慌てているような物語の一場面。仲間は画面内に映っていなくて大丈夫です。\n念のためNSFW設定にさせていただいていますが、肌の露出度はお任せします。\n局部描写も必須ではないため、その辺は全てカルシュさんのお好みに合わせて描いて頂ければと思います。\n\nシチュエーションやキャラが好みでなかったり、金額が見合っていなければお気軽にキャンセルor再送要請をお送りください。\nいつも応援しています。ここまで読んで頂きありがとうございました！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@31lkyway/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 36035, "client_id": 2455817, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/441f56b0/uploads/origins/4d1a83d3-a65d-4bd4-89f3-7041aadcbd16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0731d6e13f0a8b4e2504ae178ffa26b5", "srcset": "https://si.imgix.net/441f56b0/uploads/origins/4d1a83d3-a65d-4bd4-89f3-7041aadcbd16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0731d6e13f0a8b4e2504ae178ffa26b5, https://si.imgix.net/441f56b0/uploads/origins/4d1a83d3-a65d-4bd4-89f3-7041aadcbd16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96f00e392dd9a94f2b6fa5335f906f6f 2x, https://si.imgix.net/441f56b0/uploads/origins/4d1a83d3-a65d-4bd4-89f3-7041aadcbd16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb8d1854df43c71733f67c9700587cd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/441f56b0/uploads/origins/4d1a83d3-a65d-4bd4-89f3-7041aadcbd16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a64638cd83563ed31205d4d46279184", "srcset": "https://si.imgix.net/441f56b0/uploads/origins/4d1a83d3-a65d-4bd4-89f3-7041aadcbd16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a64638cd83563ed31205d4d46279184, https://si.imgix.net/441f56b0/uploads/origins/4d1a83d3-a65d-4bd4-89f3-7041aadcbd16?bg=%23fff&auto=format%2