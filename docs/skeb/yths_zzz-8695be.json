スタンド用のイラスト\n\nまたは\n\n②iPadの壁紙用(2048×2732px)のイラスト\n\nのいずれかお好きな方で描いていただけると幸いです！が！気にせず描いていただいても大丈夫です！！\n\n・構図や服装、シチュエーションなど全てお任せします！\n・BL要素大歓迎です！(なくても大丈夫です！)\n・psdデータだと助かります！\n\n▼使用用途▼\n・個人的な鑑賞\n\n▼資料▼\nhttps://drive.google.com/drive/folders/1Ki2StPb0Lops5dSspj7PPpRRCpYKnAHS\n\n至らぬ点などございましたら遠慮なく蹴っていただいて構いません！ご検討いただけますと幸いです！よろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1Ki2StPb0Lops5dSspj7PPpRRCpYKnAHS", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yths_zzz/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f55e8b24/uploads/origins/1de799a5-1656-4346-a4c0-6fc3e915838c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec7225cd4cbd7cac28b1cf2da7738621", "srcset": "https://si.imgix.net/f55e8b24/uploads/origins/1de799a5-1656-4346-a4c0-6fc3e915838c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec7225cd4cbd7cac28b1cf2da7738621, https://si.imgix.net/f55e8b24/uploads/origins/1de799a5-1656-4346-a4c0-6fc3e915838c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a837147981e3bc505102c23e81b4296b 2x, https://si.imgix.net/f55e8b24/uploads/origins/1de799a5-1656-4346-a4c0-6fc3e915838c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4b3d2bc1f3a5785cd238085935a1f34 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1135731, "client_id": 102567, "nc": 16}, {"path": "/@yths_zzz/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1135731, "client_