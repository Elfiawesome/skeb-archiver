神父と外科医をやっている。身長195cm、黒い瞳にアイボリーの肌色、そしてシワがある。人当たりがよさそうだが、道徳心はまったくない。\n 超常現象を扱うエクソシストであり、ビジネスパートナーでもある。父親と娘のような関係。憎まれ口を叩きながらも、いざというときは協力し合う仲らしい。\n服装や装飾、ポーズなどは自由に決めていただいて結構です。あなたの解釈でこのキャラクターを描いてみてください。ご検討のほど、よろしくお願いします。\n以下は参考資料です。\nhttps://drive.google.com/drive/folders/1U7uD9l4i3K2XXExYsZpChwFGQBo9tFei?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yths_zzz/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/20944be0/uploads/origins/e5639223-19d4-41ef-91bd-412cecd29c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a50a39e74965d160f243412ce5ecf2c", "srcset": "https://si.imgix.net/20944be0/uploads/origins/e5639223-19d4-41ef-91bd-412cecd29c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a50a39e74965d160f243412ce5ecf2c, https://si.imgix.net/20944be0/uploads/origins/e5639223-19d4-41ef-91bd-412cecd29c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc425ece08fc3b5609c26e3b47fa3757 2x, https://si.imgix.net/20944be0/uploads/origins/e5639223-19d4-41ef-91bd-412cecd29c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5339d6c0e4e493ac384355757f2a6a5 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1135731, "client_id": 2141446, "nc": 17}, {"path": "/@yths_zzz/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1135731, "client_id": 563014, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9ed5cc2/uplo