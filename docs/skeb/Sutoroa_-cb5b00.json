5a74618fcaa3cd91b", "srcset": "https://si.imgix.net/9b4b45a0/uploads/origins/2238f0d6-d919-49a7-a6bd-f54d0f0901ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0034e5c95e61425a74618fcaa3cd91b, https://si.imgix.net/9b4b45a0/uploads/origins/2238f0d6-d919-49a7-a6bd-f54d0f0901ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc4ad8b8590faafc73ee264aa212994 2x, https://si.imgix.net/9b4b45a0/uploads/origins/2238f0d6-d919-49a7-a6bd-f54d0f0901ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc239b0bb066d2382d87d7e792eed870 3x"}, "body": "\uc791\uac00\ub2d8, \ub2a6\uc5b4\uc11c \uc8c4\uc1a1\ud569\ub2c8\ub2e4 .\u3160\u3160. \uc57d\uc18d\ud574\uc8fc\uc2e0 \ub300\ub85c \ucee4\ubbf8\uc158 \uc2e0\uccad\ud569\ub2c8\ub2e4. \uc774\ubc88\uc5d0\ub294 \uc2e0\ub370\ub9c8\uc2a4 \uc6e8\ub529 \ube44\ud0a4\ub2c8 \ud558\uc57c\ud14c\uc640 \uc81c \ucd5c\uc560\uce90\uc774\uc790 \ud504\ub85c\ud544 \uce90\uc778 \uc774\ub204\uc57c\uc0e4\uc758 \ud0a4\ub77c\ub77c(\ube68\uac04 \uc2a4\uce74\ud504 \ubc84\uc804)\uc758 \ucee4\ud50c \uc6d0 \uc0f7\uc744 \uc2e0\uccad\ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.\n\n\ubc11\uc758 \ub9c1\ud06c\ub294 \uc8fc\uc18c\uc785\ub2c8\ub2e4.\n\n\ud558\uc57c\ud14c \uc608\uc2dc \uc774\ubbf8\uc9c0\ub294 01-22, \ud0a4\ub77c\ub77c \uc608\uc2dc \uc774\ubbf8\uc9c0\ub294 44-52\uc785\ub2c8\ub2e4.\n\n\uc774\ubc88 \ucf54\uc2a4\ud2ac\uc740 \uc6e8\ub529 \ube44\ud0a4\ub2c8(22-43) \uc785\ub2c8\ub2e4. \uae30\ubcf8\uc801\uc73c\ub85c \ub514\uc790\uc778\uc740 \uc790\uc720\uc785\ub2c8\ub2e4. \uc0c9\uc0c1\ub3c4 \uae30\ubcf8 \ud770\uc0c9\uc774\uc9c0\ub9cc \ub9cc\uc57d \ubcf4\uc870\uc0c9\uc774\ub098 \uc545\uc138\uc0ac\ub9ac\ub4e4\uc740 \ud30c\ub780\uc0c9\uc774\ub098 \ud639\uc740 \ud770\uc0c9\uacfc \uc5b4\uc6b8\ub9ac\ub294 \ub2e4\ub978 \uc0c9 \ub123\uace0 \uc2f6\uc73c\uc2dc\uba74 \ub429\ub2c8\ub2e4. \uc5b4\ub514\uae4c\uc9c0\ub098 \uc791\uac00\ub2d8 \uc5ec\uc720\uac00 \uc788\uc744 \ub54c \ud574\uc8fc\uc2dc\uba74 \ub418\uc694.\n\ub300\uc2e0 \uc758\uc0c1 \ub808\uc774\uc5b4\ub294 \uac19\uc740 \uc774\ubbf8\uc9c0\uc5d0 \uc5ec\ub7ec\uac1c \ubd80\ud0c1\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.\n\n\uc608\uc2dc\ub85c \ube0c\ub77c\uc640 \uc18d\uc637 \uc785\uc5b4 \ub204\ub4dc \uc5c6\ub294 sfw(31, 36)\n\ube0c\ub77c\uc640 \ud32c\ud2f0 \uc5c6\uc774 \ub9d8\ub9c8\ud1b5\uc774\ub791 \uc18c\uc911\uc774 \ub2e4 \ubcf4\uc774\ub294 nsfw(32, 33, 37, 38)\n\uadf8 \uc678\uc5d0 \uc791\uac00\ub2d8\uc774 \uc6d0\ud558\uc2dc\uba74 \ud3b8\ud55c \ub808\uc774\uc5b4 \ub354 \ub123\uc73c\uc154\ub3c4 \ub429\ub2c8\ub2e4.\n\n\ud0a4\ub77c\ub77c \uc758\uc0c1\uc740  \ube68\uac04 \uc2a4\uce74\ud504 \ub9e4\uace0 \uc788\ub294 \uac78\ub85c \ud574\uc8fc\uc138\uc694(44, 45, 50-52)\n\n\uc77c\ub2e8 \ud0a4\ub77c\ub77c\uc640 \ud558\uc57c\ud14c\uc758 \ucee4\ud50c \uc6d0\uc0f7\uc774\ub2c8(53-62)\ucc98\ub7fc \ud55c \uc774\ubbf8\uc9c0\uc5d0 \uc11c\ub85c \uc0ac\ub791\ud558\ub294 \ub290\ub08c\uc744 \ubd80\ud0c1\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.\n\n\ubc30\uacbd\uc740 \uc6e8\ub529 \ube44\ud0a4\ub2c8\uc640 \uacb0\ud63c \ub290\ub08c \ub098\ub294 \ubc1d\uc740 \uacf5\uac04\uc758 \uce68\ub300(31, 36, 58) \ub290\ub08c\uc73c\ub85c \ud574\uc8fc\uc138\uc694. \uc8fc\ubcc0\uc5d0 \uc7a5\ubbf8 \uac19\uc740 \uaf43\uc78e\ub4e4\uc774 \ubfcc\ub824\uc838 \uc788\uac70\ub098 \ub2e4\ub978 \uc545\uc138\uc0ac\ub9ac \ucd94\uac00 \ud574\ub3c4 \ub429\ub2c8\ub2e4.\n\n\uce74\uba54\ub77c\uc640 \uce90\ub9ad\ud130 \ud3ec\uc988 \uc608\uc2dc \uc774\ubbf8\uc9c0\ub294  31-33, 36-38, 58-62 \ucc98\ub7fc \uc815\uba74(\ud558\uc57c\ud14c \uac00\uc2b4\uacfc \uc18c\uc911\uc774 \ub2e4 \ubcf4\uc774\uae30 \uc704\ud574)\uc73c\ub85c \ud558\uc774 \uc575\uae00 \ud639\uc740  \uc544\uc774 \ub808\ubca8 \uc575\uae00 \uac19\uc740 \ub290\ub08c\uc73c\ub85c \uce68\ub300\uc5d0 \uc11c\ub85c \ud589\ubcf5\ud558\uac8c \ub204\uc6cc \uc788\ub294 \ub290\ub08c \ubd80\ud0c1\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.\n\n\uc774\ubbf8\uc9c0\ub294 \uac00\ub85c \uc774\ubbf8\uc9c0 \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4. \uc77c\ub2e8 \uad6c\ub3c4\ub098 \ud3ec\uc988 \uce74\uba54\ub77c\ub098 \ub2e4\ub978 \uac83\ub4e4 \uc911 \uc880 \ub354 \uc88b\uc740 \uc544\uc774\ub514\uc5b4 \uc788\uc73c\uc2dc\uba74 \ud76c\ub9dd \uc0ac\ud56d \ub0a8\uaca8\uc8fc\uc138\uc694.\n\n\uac10\uc0ac\ud569\ub2c8\ub2e4.", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sutoroa_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3212368, "client_id": 2068846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=949851d4b67b870f5f22c97c3007e5a7", "srcset": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=949851d4b67b870f5f22c97c3007e5a7, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8a545cc151e39a9d0c78bcb2c27cc63 2x, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3076120e5d3fda4f62e997fcff656ecd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6daebb5a2a08cbe9c096a767ba05b41", "srcset": "https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6daebb5a2a08cbe9c096a767ba05b41, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82129fba979e8a591556102766877a9b 2x, https://si.imgix.net/e07320f8/uploads/origins/a1d739b7-f010-4850-936d-ca11cd5309a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9080e7cd5d619dc070c9a36fe7fc6eb0 3x"}, "body": "\ub124, \uc774\ubc88\uc5d0\ub294 \uc2e0\ub370\ub9c8\uc2a4\uc758 \ud558\uc57c\ud14c\ub97c \uc2e0\uccad\ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4. \ubc11\uc5d0\ub294 \ub9c1\ud06c\uc785\ub2c8\ub2e4.\n(https://drive.google.com/drive/folders/1_hO1EAQDSDvYXPMvNOHCs4cetvh3slP7?usp=sharing)\n\n\ud558\uc57c\ud14c \uba38\ub9ac \uc2a4\ud0c0\uc77c\uacfc \uc758\uc0c1 \ub514\uc790\uc778\uc740 02-05\ubc88\uc758 \ubc14\ub2c8\uac78\uc785\ub2c8\ub2e4. \ud0c0\uc791\uac00\ub2d8\ub4e4\uaed8 \uc2e0\uccad\ud588\uc5c8\ub358 \uc758\uc0c1\uc785\ub2c8\ub2e4. \uc0ac\ud0c0\uad6c\ub2c8 \ubd80\uac01\ud558\ub294 \ub178\ucd9c \uac15\ud55c \ud558\ub298\uc0c9\uacfc \uc740\uc0c9 \uc11e\uc778 \ubc14\ub2c8\uac78 \uc758\uc0c1\uc785\ub2c8\ub2e4. \uba38\ub9ac\ub294 \uae30\uc874 \uc0dd\uba38\ub9ac\uc774\uace0\uc694.\n\uadf8\ub9ac\uace0 \ubc14\ub2c8\uac78 \uc758\uc0c1\uc740 4 \ub808\uc774\uc5b4 \ubc84\uc804\uc73c\ub85c \ubc1b\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.\n\ud558\ub098\ub294 \uae30\uc874 \uc608\uc2dc \uc774\ubbf8\uc9c0\uc758 \ubc84\uc804\uc774\uace0, \ub450\ubc88\uc9f8\ub294 \uadf8\ub0e5 \uae30\uc874\uc5d0\uc11c \ubcf4\uc774\ub294 \uce58\ub9c8\uac00 \uc5c6\uc5b4\uc11c \uc0ac\ud0c0\uad6c\ub2c8\ub791 \uc606\ud2b8\uc784 \ub178\ucd9c \ub192\uc778 \ubc84\uc804\uc73c\ub85c \ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4.\n\ub098\uba38\uc9c0 \ub450 \uac1c\ub294 \uac04\ub2e8\ud558\uac8c \uc704\uc758 \ub808\uc774\uc5b4\ubc84\uc804\uc5d0\uc11c \ud558\uccb4\ubd80\ubd84\uc5d0 \ub3c4\ub07c \uc790\uad6d \ucd94\uac00\ud55c \uac04\ub2e8\ud55c \uc218\uc815 \ubc84\uc804\ub9cc \ud558\uc2dc\uba74 \ub429\ub2c8\ub2e4.\n\n\uce74\uba54\ub77c \uc635\uc158\uacfc \uac70\ub9ac, \uce90\ub9ad\ud130 \ud3ec\uc988\ub294 \uc14b \uc911 \ud558\ub098 \uace0\ub974\uc2dc\uba74 \ub429\ub2c8\ub2e4. \uc0ac\ud0c0\uad6c\ub2c8 \ubd80\uac01\uc774\ub77c \uc800\ubc88 \ubbf8\uce74 \ucee4\ubbf8\uc158\uc774\ub791 \ub2ec\ub9ac \ud558\uccb4\ub3c4 \ub2e4 \ubcf4\uc774\ub294 \uc774\ubbf8\uc9c0\ub97c \uc6d0\ud569\ub2c8\ub2e4.\n\n01: \uc815\uba74\uc0f7, \uadf8\ub9ac\uace0 \uc544\uc774(eye) \ub808\ubca8 \uac01\ub3c4\uc758 \ubbf8\ub514\uc5c4 \ub871 \uc0f7 \uc774\ubbf8\uc9c0. \ud3ec\uc988\ub294 \uc790\uc720.(01, 06)\n02: \uc544\uc8fc \uc57d\uac04\uc758 \ud558\uc774, \uadf8\ub9ac\uace0 \uc0ac\uc774\ub4dc \uc575\uae00\uc758 \ubbf8\ub514\uc5c4 \ub871 \uc0f7. \ud3ec\uc988\ub294 \uae30\ubcf8\uc801\uc73c\ub85c \uc800\ub807\uac8c \uc549\uc544 \uc788\uae30.(07)\n03: \uae30\ubcf8 \uc870\uac74(\ud558\uc57c\ud14c \uc804\uc2e0 \ub2e4 \ub098\uc624\ub294 \uac70)\ub9cc \uac16\ucd98 \ucc44 \uc791\uac00\ub2d8\uc774 \ub354 \uc88b\uc740 \uad6c\ub3c4\ub791 \ud3ec\uc988\uac00 \uc788\uc73c\uba74 \uadf8\uac78\ub85c \ud558\uc154\ub3c4 \ub429\ub2c8\ub2e4. \ub300\uc2e0 \uce74\uba54\ub77c \uac70\ub9ac\ub294 \uae30\uc874\ub300\ub85c \ubbf8\ub514\uc5c4 \ub871 \uc0f7 \uc815\ub3c4.\n\n\uac10\uc0ac\ud569\ub2c8\ub2e4.\n\nhttps://drive.google.com/drive/folders/1_hO1EAQDSDvYXPMvNOHCs4cetvh3slP7?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sutoroa_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3212368, "client_id": 2068846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e726b1cdd3bdc0ab648be31beacacc", "srcset": "https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-00b6-4674-a00f-95a23fe6abfb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53e726b1cdd3bdc0ab648be31beacacc, https://si.imgix.net/e0e9b931/uploads/origins/7edab53a-0