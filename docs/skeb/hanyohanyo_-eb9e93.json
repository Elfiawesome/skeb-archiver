ad4085-5028-4449-9e47-31a7d31cadcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2ac917bdf433df3dcc3600b6beb5ff5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cc1cd0f/uploads/origins/f6ad4085-5028-4449-9e47-31a7d31cadcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd55fe0ba8ed8050933a9ac62fbb199", "srcset": "https://si.imgix.net/6cc1cd0f/uploads/origins/f6ad4085-5028-4449-9e47-31a7d31cadcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd55fe0ba8ed8050933a9ac62fbb199, https://si.imgix.net/6cc1cd0f/uploads/origins/f6ad4085-5028-4449-9e47-31a7d31cadcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55dcabd1f1c2c297fe81070883f27200 2x, https://si.imgix.net/6cc1cd0f/uploads/origins/f6ad4085-5028-4449-9e47-31a7d31cadcb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ab8324f9d8014d8335fad664d8d1550 3x"}, "body": "こんにちは！あなたのアートが本当に大好きで、私のVtuberモデルのアートワークを依頼したいと思っています。\nもしよろしければ、作品をソーシャルメディアやビデオに投稿します！\n\n彼女がアイスキャンディーの棒を口にくわえて微笑んでいて、目の前の人にアイスキャンディーを差し出しているような絵が希望です。チョンユン（幻神インパクトのキャラクター）の衣装を着せて、髪の色、目の色、肌の色、髪型はそのままでお願いします。髪型は参考に入れたハーフアップです。\n\n笑顔は、あなたのこの作品のようなものを希望します。https://twitter.com/hanyohanyo_/status/1705192599299166379/photo/1\n\n背景は特に気にしませんが、もう少し濃い青か薄い青がいいかもしれません。\n\n可能であれば、キャラクターと背景を分けて、png（背景透過）でファイルを送ってください！ありがとうございます\n\nhttps://docs.google.com/drawings/d/1DxoY22pmiBjje0O_7l4R0F4lQRnUFc49OhTT2BosEmc/edit?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 394581, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ユタリビャク🌱", "screen_name": "byaku_yutari", "avatar_url": "https://pbs.twimg.com/profile_images/1352468317638823938/tbO0sm_8.jpg", "header_url": "https://pbs.twimg.com/profile_ba