ps://skeb.jp/@woodbbMod_0/works/6\n＜バーテンダー＞\nhttps://skeb.jp/@nyanyanyamituki/works/1\n＜別作品の衣装＞\nhttps://skeb.jp/@senri03151221/works/14\nhttps://skeb.jp/@namae11x/works/8\n\n構図などは特に指定ありません(全身が写っていると嬉しいです) \nTkuganeさんの描くジト目・テレ顔が好きなんですが、\n他にも似合いそうと思ったポーズや表情などありましたらTkuganeさんアイデアで具現化お願いします！\npsdでいただけますと幸いです。よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tkugane353/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1664141, "client_id": 50565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba14ffbdae7903bc5f274f6c09447a3", "srcset": "https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba14ffbdae7903bc5f274f6c09447a3, https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32441a601705cd3b1b3f45eeedc870cf 2x, https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=926342b70e08bd7a62911bec7999452c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b86b08f15a71f7979328a09a73ee5794", "srcset": "https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b86b08f15a71f7979328a09a73ee5794, https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b34eeac09b3d0633dc159bdcb58d1f24 2x, https://si.imgix.net/669077bb/uploads/origins/2ddb2574-ad9e-43cb-9cbe-5b7a676b18fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=efa188ba648845c1111f1c9520576672 3x"}, "body": "初めまして、ドルフロやアークナイツイラスト拝見して楽しませて貰っていました。\n特に描かれる目に魅かれまして、その目で描いてもらいたいキャラをリクエストさせて頂きますのでよろしければ以下ご検討のほどよろしくお願いします。\n\n\n【作品】\nアークナイツ\n【キャラクター】\nポンシラス\n【区分】\n全年齢\n【衣装】\n通常ver\n【シチュエーション】\n指定はなくお任せします。\n可能なら表情にジト目になるものを含めて2つ頂ければと思います。\n\n【その他】\n宛名有り無しはpsdのレイヤー分けでも画像分けでも構いません。\n背景ある場合はキャラとレイヤー分けして頂けると幸いです。（背景白地でも問題ありません）\n上記指定以外、他不明点はお任せします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tkugane353/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1664141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af78f20e/uploads/origins/7a0d9abd-9dbd-4566-8dba-7d2b516d25b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=239f2a868126b097ae880692d9fd39d7", "srcset": "https://si.imgix.net/af78f20e/uploads/origins/7a0d9abd-9dbd-4566-8dba-7d2b516d25b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=239f2a868126b097ae880692d9fd39d7, https://si.imgix.net/af78f20e/uploads/origins/7a0d9abd-9dbd-4566-8dba-7d2b516d25b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ac5f1fcc90f137fbaaa8e7033075e07 2x, https://si.imgix.net/af78f20e/uploads/origins/7a0d9abd-9dbd-4566-8dba-7d2b516d25b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ec0eda316fef92e7ec8b75237d35428 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af78f20e/uploads/origins/7a0d9abd-9dbd-4566-8dba-7d2b516d25b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&