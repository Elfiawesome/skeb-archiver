45a8-9663-62f5bc9196a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c052f45a3dd34f606a6cb480f13b4f9 3x"}, "body": "ギャル合同に寄稿されたジャガー姉妹の下着と水着姿とヌードも全身をリクエストします。\n下着と水着のデザインとカラーは資料先の5点。\n女児下着を着用している時、ジャガーは「えっ？こんなの着せるの？小さくてピチピチじゃん！」と驚いて困惑している感じで、ブラックジャガーは「セクシーな下着よりこっちのほうが恥ずかしい…」と、顔と耳まで真っ赤になって目をぎゅっと閉じている様子。\n\n宜しければご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1GwXB-Ij0XrqNObC9dl8_61FdSvFqbEi7?usp=drive_link", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nishikura_kon/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2587850, "client_id": 752093, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20e6a1cad0650ea53db1a4c2ec295975", "srcset": "https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20e6a1cad0650ea53db1a4c2ec295975, https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08d7bfc9b677232413ca4b1000e827e0 2x, https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c8f53a92ea48a7aea646772662f45c0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb3d8569dee50e36ee218d98e2ffb5d", "srcset": "https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb3d8569dee50e36ee218d98e2ffb5d, https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=464c87917d1526fdc034008f89a79ec3 2x, https://si.imgix.net/939b1c7d/uploads/origins/ef30aede-4917-4ee6-8e88-a5f51bf26161?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28a003de5624a3af327cb19a0d362820 3x"}, "body": "こんにちは、前回描いてもらったホシノルリ（10歳バージョン）の続き的な内容をリクエスト送らせていただきます。\n\n暫くホシノルリが家に泊まりに来て2人きりな状態が続き、オナニー出来ずにムラムラしているのを見透かされて「オナニー何日も我慢している○○さんにご褒美で私のオナニーしている姿を見せてあげます」と言って、下着姿（資料先メインの）になりベットの上に足を広げて座って100均で売っている電動歯ブラシを下着の上から乳首やアソコに当ててオナニーをし始める。\nさらにぷっちょグミの空き容器（資料先の）を咥えたり先っちょを舌先で舐めてフェラチオもしだす。\nパンツに染みが出来て下着を脱ぎ全裸になって、電動歯ブラシをクリトリスに直に当てると刺激が強すぎてオシッコをピュッピュッと飛ばすお漏らしを２回ぐらいしてしまう。（お尻の下にお漏らししてもいい様にバスタオルを敷いている）\n刺激に慣れ振動を強くした電動歯ブラシをクリトリスに当てて、ぷっちょグミの空き容器を激しくフェラチオするように咥えオナニーを再開する。\nイキそうになり、小さな声で「イクッ、イクッ」と呟いた直後に体を震わせながら潮を吹いてイッてしまう。\nイッて舌を出し口が半開きの恍惚状態になっているところに、ペニスを口元に近づけて口と顔にザーメンを飛ばしこちらもイッてしまう。\n「これでお互いに恥ずかしい姿を見せたのですから、オナニー我慢しないでいいですよ。私がオカズになってあげますから」と、イタズラっぽく笑って見せる。\n可能でしたら差分で資料先の他の下着やスクール水着姿も。\n前回より内容がハードですが、宜しければご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1aaFXY0jyeWOkKXhfk-zdjzqgKgjsS9R7?usp=drive_link", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nishikura_kon/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2587850, "client_id": 752093, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beafa0ec/uploads/origins/807cd550-2db3-4731-ae4d-968f411a7ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc160cddcebfb960ca155bc11078447e", "srcset": "https://si.imgix.net/beafa0ec/uploads/origins/807cd550-2db3-4731-ae4d-968f411a7ab5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc160cddcebfb960ca155bc11078447e, ht