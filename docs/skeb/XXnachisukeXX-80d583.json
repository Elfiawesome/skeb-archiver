750-ab64-240df758468a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0ef2afeb041c07abd15bd0b6f37c96c 3x"}, "body": "また会ったね！\n\n前回のリクエストありがとうございました！素晴らしい仕上がりでした！\n\n今回もナルマヤのアートをお願いしたいと思います。今回はフェイトのネロの水着を着て、浜辺に寝そべっていて、海水が彼女の上に立ち上っているポーズでお願いします。水着とポーズの参考資料はリンク先にあります。できれば全身アートにしてほしい。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1WYST2LHjwN79Rr7Yue514MNwET-mSQW8?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@XXnachisukeXX/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 278527, "client_id": 3246459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/054d3dbb/uploads/origins/c3e18566-03f7-465d-825f-c31a2e9216ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55aad66a498ce459d35c4211df7654b3", "srcset": "https://si.imgix.net/054d3dbb/uploads/origins/c3e18566-03f7-465d-825f-c31a2e9216ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55aad66a498ce459d35c4211df7654b3, https://si.imgix.net/054d3dbb/uploads/origins/c3e18566-03f7-465d-825f-c31a2e9216ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=751fbfa57db44e6522eae2f2e60123cb 2x, https://si.imgix.net/054d3dbb/uploads/origins/c3e18566-03f7-465d-825f-c31a2e9216ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4346abc56aa87466b97de0ee6a6e0e72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/054d3dbb/uploads/origins/c3e18566-03f7-465d-825f-c31a2e9216ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cae5adfd4b91465b5b345c8389fb111", "srcset": "https://si.imgix.net/054d3dbb/uploads/origins/c3e18566-03f7-465d-825f-c31a2e9216ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=