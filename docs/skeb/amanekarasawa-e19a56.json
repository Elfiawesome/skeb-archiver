nt": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amanekarasawa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3767617, "client_id": 3768336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7606cb1dfa66f3c35c6bd3841580dc72", "srcset": "https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7606cb1dfa66f3c35c6bd3841580dc72, https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c52c0e70e9b873db436e7f627160e63 2x, https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7bd6c075edd1811cfeafcf9a22521ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c323049d5cfde7a6e1a1d62b5e2702ad", "srcset": "https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c323049d5cfde7a6e1a1d62b5e2702ad, https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee223c07eb769e782fed2821cac103f7 2x, https://si.imgix.net/42e849f6/uploads/origins/a46eb4d0-30e9-460c-bf86-71e498d7de43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf210e83a98c4a67112f52876bdf41c1 3x"}, "body": "お世話になっております。\n作曲活動をしているみおと申します。\n自作曲MV用のイラスト制作をお願いしたくご連絡いたしました。\n\n以下が依頼したいイラストの詳細になります。\n\n【用途】\n現在、クロカル杯と本当のルーキー祭り2025という投稿祭に投稿する楽曲の制作を行っております。本大会は一枚絵という規定があるため、仮絵で楽曲を投稿しようと考えています。大会終了後、後日にMVを作成しなおし、私のSNSアカウントで再度、楽曲を投稿しようと考えております。その、投稿しなおす際のMV用イラストの製作をお願いしたいです。投稿先は、X、YouTube、ニコニコ動画、TikTokです。\n\n【イラスト内容】\n背景：夕日をセンターに、その夕日と空の景色が湖に映っているような背景\n人物：夕日に向かって叫んでいる女の子（顔は見えても背を向けていてもどちらでも可）\nポーズ：女の子は全身見切れなくお願いします。\n\n【画像サイズ】背景：比率:横16の縦9、解像度は最低でも1920x1080ピクセルでお願いします　　　　　　\n　　　　　　　人物：見切れなければ特に指定なし\n\n【納品形式】PNGファイルで、背景と人物は別ファイルでお願いします。\n　　　　　　可能であれば人物は背景透過していただけると助かります。\n\n【歌詞】楽曲イメージをお伝えするため以下にイメージと歌詞を記載します。\n「空にある夕日と湖に映る夕日の二つを手に入れようとする（2つの夢を追いかける）そんなイメージの楽曲です。曲調は割と明るめでテンポ早めです。BPM=160」\n\n「僕だけの地平線」\n\n1Aメロ\n陽がほどく　ふたつの声\nどちらも僕を　呼んでいる\n選ばずに進む　その足音は\nふたつの夢を　抱く決意\n\n1Bメロ\n誰かの地図じゃ　辿り着けない\n夕日に染まる　地平線\n\n1サビ\n片手じゃ足りない　この願いは\n握りしめたまま　離さないから\n遠くに見えた　ふたつの光\n重なる場所まで　走り続ける\n\n2Aメロ\n日が沈んだ　分かれ道で\n片方を捨てる　勇気より\n両方を信じる　覚悟を選んだ\n不器用でも　僕は僕でいたい\n\n2Bメロ\n沈んだ光が　地平線の向こう\nまた昇ることを　信じてる\n\n2サビ\n片手じゃ足りない　この願いは\n握りしめたまま　離さないから\n滲んでいた　ふたつの光が\n重なりながら　僕を照らしてる\n\nCメロ\n誰にも見えない　その地平線で\n僕は何度も　立ち止まりそうになった\nでも　この手の熱が教えてくれた\nふたつの願いは　まだ生きてる\n\nラスサビ\n片手じゃ足りない　この願いを\n握りしめたまま　走り抜けたら\n遠くに見えた　ふたつの光が\n重なる瞬間　息が止まった\n\nその瞬間が　今も僕を走らせる\n\nよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amanekarasawa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3767617, "client_id": 3768336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/979e4a39/uploads/origins/bd217e0b-c0fc-4eb2-8363-39a950019f86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65ed912f0a2306dc126fb5448367f7d", "srcset": "https://si.imgix.net/979e4a39/uploads/origins/bd217e0b-c0fc-4eb2-8363-39a950019f86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d65ed912f0a2306dc126fb5448367f7d, https://si.imgix.net/979e4a39/uploads/origins/bd217e0b-c0fc-4eb2-8363-