o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40b2bc44c559ca8cc4e87bdba52f5888, https://si.imgix.net/64a130e9/uploads/origins/11449ebc-b821-4d90-a949-c9f3b54a60b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47ba23238332fb7048dda49217edcfdf 2x, https://si.imgix.net/64a130e9/uploads/origins/11449ebc-b821-4d90-a949-c9f3b54a60b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab675d093ee1f4b4031a332afdab90e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64a130e9/uploads/origins/11449ebc-b821-4d90-a949-c9f3b54a60b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68fdd2aef797f6b357ddff9d91c68182", "srcset": "https://si.imgix.net/64a130e9/uploads/origins/11449ebc-b821-4d90-a949-c9f3b54a60b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68fdd2aef797f6b357ddff9d91c68182, https://si.imgix.net/64a130e9/uploads/origins/11449ebc-b821-4d90-a949-c9f3b54a60b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d003eec1d771123d995800d7f7b87c2c 2x, https://si.imgix.net/64a130e9/uploads/origins/11449ebc-b821-4d90-a949-c9f3b54a60b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f513a66b86e811fb9d284720d134a873 3x"}, "body": "Hello, apologies for the odd request, but I recently went to a website that would have AI create images from prompts you entered into it. I received a rather haunting image from the prompt of \u201cNanoha and Madoka\u201d, and I wished for you to draw something inspired by it. I also included some of the other drawings it produced, but the very first one was the one I most wished to see you replicate.\n\nI think it would be called the \u201cWitch of Friendship\u201d. Its appearance causes others to cower before it in terror. It extends its arm out to these people, wishing to be friends with them, but without any hands, it cannot support or comfort them. This causes the Witch to feel depressed, but still, it continues to reach its arm out, hoping endlessly that one day it will be able to grab hold of someone and become their friend.\n\nhttps://imgur.com/a/vtnpnpU", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 59379, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "\u30de\u30fc\u30e9\u30fc", "screen_name": "MarllerTheDevil", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 723720, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "\u3053\u305f\u732b", "screen_name": "381sinano1", "avatar_url": "https://pbs.twimg.com/profile_images/1899806078541475840/8XuGLWvR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3034614074/1741784042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 177}, {"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "\u3086\u308c", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_e