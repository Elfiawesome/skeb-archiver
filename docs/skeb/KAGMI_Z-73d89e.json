晶と雫の深ダビ‼️🌊晶と雫の深ダビ‼️🌊と、にーおじさん🐙👾は常に全神経👁️👃👄🌝🦠🫁🧠🫀を集中させているヨ！\n​ただ二人が「深ダビ」してくれれば、おじさんのドロドロで汚れきったアホゴミボケカス野蛮野郎の脳細胞🧠は一瞬で浄化されちゃうんだ（笑）‼️✨🙏\n早く僕に「晶と雫の深ダビ」という名の酸素🫁を注入してネ‼️‼️\n👁️💦ド鬱😢💦でも☆彡♥HAPPY♥☆彡でもつくろう🕯️ﾁｬﾝの好きなように書いてネ🫁🧠🫀♥\n\nつくろうさん。貴方が生き、呼吸をし、目を開けるたびに私の世界には空が広がり、たくましい大地が生まれ、たくさんの木々や花々、そして尊みのある生き物たちが生まれました。見てください、この世界はあなたが生んだんですよ。\n\nhttps://drive.google.com/drive/folders/19s2__54yjSW8QV5lXjGNvuddjKao-Bmw", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@___p___o___/works/410", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3128982, "client_id": 3677159, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c796cdf0/uploads/origins/4a916983-5051-4a4a-ac36-6a866bb4e3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83ccdb09f8973d52f38441d490f69ad0", "srcset": "https://si.imgix.net/c796cdf0/uploads/origins/4a916983-5051-4a4a-ac36-6a866bb4e3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83ccdb09f8973d52f38441d490f69ad0, https://si.imgix.net/c796cdf0/uploads/origins/4a916983-5051-4a4a-ac36-6a866bb4e3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8da27ed8ae388dacd98c40f3da7036a9 2x, https://si.imgix.net/c796cdf0/uploads/origins/4a916983-5051-4a4a-ac36-6a866bb4e3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da704b30292e537f92305f4351e24f3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c796cdf0/uploads/origins/4a916983-5051-4a4a-ac36-6a866bb4e3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffde93e742df379ba8f2556bee70f1b2", "srcset": "https://si.imgix.net/c796cdf0/uploads/origins/4a916983-5051-4a4a-ac36-6a866bb4e3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffde93e742df379ba8f2556bee70f1b2