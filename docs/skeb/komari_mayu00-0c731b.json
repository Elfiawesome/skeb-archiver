Dデータを頂けますと幸いです！\n\n※SNSでの使用やサムネでの使用また、グッズなどの商用利用を含む場合があります。\n\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ucQlsrJtnNn3eAmDmr0RrGQFZ6EiiZho?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Immortal_Juno/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2758002, "client_id": 2272779, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bf0dfb2/uploads/origins/8fd6e970-8219-40fe-8d98-83d17b33694c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d463635a4b576cd6921800d9afe34028", "srcset": "https://si.imgix.net/7bf0dfb2/uploads/origins/8fd6e970-8219-40fe-8d98-83d17b33694c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d463635a4b576cd6921800d9afe34028, https://si.imgix.net/7bf0dfb2/uploads/origins/8fd6e970-8219-40fe-8d98-83d17b33694c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63f7e973bb654f6c9d662e28003bd559 2x, https://si.imgix.net/7bf0dfb2/uploads/origins/8fd6e970-8219-40fe-8d98-83d17b33694c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b6d6fbc573804b04f531446b76663cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bf0dfb2/uploads/origins/8fd6e970-8219-40fe-8d98-83d17b33694c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c8a3d299304cdfb23641a6cf5c994b", "srcset": "https://si.imgix.net/7bf0dfb2/uploads/origins/8fd6e970-8219-40fe-8d98-83d17b33694c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c8a3d299304cdfb23641a6cf5c994b, https://si.imgix.net/7bf0dfb2/uploads/origins/8fd6e970-8219-40fe-8d98-83d17b33694c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14b3a2b4bf12c4e13b1266633453d55d 2x, https://si.imgix