\n\n彼は「猫雷神」で、背中の輪の中に浮いた太鼓があり、それをカナボで叩きます。彼は2本のカナボを持って太鼓を叩き、稲妻と雷を生み出します。\n肩にある仮面も、周囲を見回すことができます。\n\n真剣になったり怒ったりすると、仮面を具現化させることができます。その際、目は黒くなり、雲は暗くなり、遠くの村からも聞こえるほどの嵐や雷を引き起こします。\n彼の怒りは洪水を引き起こすこともあると言われています。\n\nこの情報をぜひインスピレーションとしてご活用ください。\n\n先生、私のリクエストをご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1vPBUzHnp6CvKomP81pnI0XwkjKzOh8i6?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@error36_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3970994, "client_id": 1872748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daee2c33/uploads/origins/64e81a04-7808-40da-a24f-e1a111d39f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68fdc4fbc2bc65b140e7e6fdd328a58", "srcset": "https://si.imgix.net/daee2c33/uploads/origins/64e81a04-7808-40da-a24f-e1a111d39f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c68fdc4fbc2bc65b140e7e6fdd328a58, https://si.imgix.net/daee2c33/uploads/origins/64e81a04-7808-40da-a24f-e1a111d39f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df3580ffb62b316fe998cbc0ff315c2d 2x, https://si.imgix.net/daee2c33/uploads/origins/64e81a04-7808-40da-a24f-e1a111d39f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c48fc75ed11ca192ba01fd62948bb1a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daee2c33/uploads/origins/64e81a04-7808-40da-a24f-e1a111d39f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=782bcd091b87447aebb39ccbca2e6a2f", "srcset": "https://si.imgix.net/daee2c33/uploads/origins/64e81a04-7808-40da-a24f-e1a111d39f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=782bcd091b87447aebb39ccbca2e6a2f, https://si.imgix.net/daee2c33/uploads/ori