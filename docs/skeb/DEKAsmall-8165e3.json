れば、お手数ですが再送申請をお願いします。\nまだまだ不安定な寒い日々が続いていますので、体調に気を付けてお過ごしください。\nこれからも活動を応援しています。\nありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1587022, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "リエ馨＠skebOPEN🎨", "screen_name": "BNdarkestdays", "avatar_url": "https://pbs.twimg.com/profile_images/1414168432069681164/HVy5jdh1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1340069965966151680/1706701771/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2689956, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "垰埜", "screen_name": "l3dpi", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fa2e897d7-8d7a-4850-a906-b46de3e35c4a.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/32c45992-8af2-4103-af4c-b5ea249485fc.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 1}, {"id": 3191177, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ライラ🐈Skeb¥750で募集中", "screen_name": "raira01raira", "avatar_url": "https://pbs.twimg.com/profile_images/1775765606631084032/ZQR-O7XO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1775765390137982976/1712210644/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 