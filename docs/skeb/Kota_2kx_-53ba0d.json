055-b08e-5c17ac22ccd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abce64d4d16613cde94a16cd29530b7e 3x"}, "body": "こんにちは、あなたの作品をとても気に入っています！できれば2人のキャラクターを使った作品が欲しいです。僕と僕の親友はファイヤーフォースとソウルイーターのOCを持っていて、2人が一緒にいる作品が欲しいのですが、スラッシュかクラックで区切って欲しいです。ファイヤーフォースのOCは、黒と赤のパーカーを着てジョギングをしている若い黒人男性です。彼は顔の下にオニのマスクをつけていて、熱く燃えすぎると体に紫色に光るマーク（デザインはお任せしたいそうです）がつきます。手で標準的な赤い炎の刃を作っている。\n \nソウルイーターOCの場合、彼女はロケットランチャー風の悪魔の武器だ（ブリーチのソイフォンのバンカイに似た何か）。彼女は金髪で、ショートカットで目を隠している（『ニーア』の2Bの髪型に近い）。半袖のバーシティジャケットを羽織り、その下にクロップトップスを着て、ゆったりとしたパンツを腰に巻いて、スニーカーを履いている。腕はロケットランチャーの銃身に変形している。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1185449, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "骨ニギー", "screen_name": "bone_Nigi", "avatar_url": "https://pbs.twimg.com/profile_images/2037534272530305024/31_ej1jF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1238836529352433664/1768347789/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 177}, {"id": 1281167, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "砂兎 妹子", "screen_name": "swepot3", "avatar_url": "https://pbs.twimg.com/profile_images/1351085562715918341/z_0qwB87.jpg", "header_url": "https://pbs.twimg.com/profile_banners/786903033313583105/1626611366/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"id": 2731167, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "