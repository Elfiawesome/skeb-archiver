o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e30d2d0d24f886f64d8fca532ac44c96 2x, https://si.imgix.net/38f968ce/uploads/origins/826d8a1a-a456-4dde-a3bf-aefb985d7ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e57b5e662bc14a4c4b105171a16b5b3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38f968ce/uploads/origins/826d8a1a-a456-4dde-a3bf-aefb985d7ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba8d8a1ea7e0c340c1a35a99b50903ca", "srcset": "https://si.imgix.net/38f968ce/uploads/origins/826d8a1a-a456-4dde-a3bf-aefb985d7ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba8d8a1ea7e0c340c1a35a99b50903ca, https://si.imgix.net/38f968ce/uploads/origins/826d8a1a-a456-4dde-a3bf-aefb985d7ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e969a3c09864f41c1d3571741ba55f37 2x, https://si.imgix.net/38f968ce/uploads/origins/826d8a1a-a456-4dde-a3bf-aefb985d7ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a266e2039b4d6f51cbec2315cdfc95 3x"}, "body": "はじめまして。\nさとりぬ様の描く柔らかいイラストに惹かれてリクエストさせていただきました。\n是非さとりぬ様には私と相方のうちよそ探索者(計5組10人)のクロスオーバーを描いてほしいです！\n\n▶簡単なパーソナルデータ\n1組目 : 夫婦\n夏子(カコ)▶︎女性/お淑やか/表情が乏しい/天然\n一樹(カズキ)▶︎男性/穏やか/愛情深い/真面目\n\n2組目 : 刑事バディ＆友人関係\n音羽(オトハ)▶︎女性/女班長/身長が低い/童顔/芯がある/滅多に笑顔を見せない\n幸(ユキ)▶︎男性/身長が高い/フランク/何を考えてるのかわからない\n\n3組目：探偵助手\nほのか▶︎女性/しっかり者/頭の回転が早い/料理が好き\n風(カゼ)▶︎男性/運が良い/助手でありながら小説家\n\n4組目：親友\n桜桃(チエリ)▶︎女性/無自覚王子様/躊躇いなく何事もハッキリ言う\nまさき▶︎女性/大人しい/引っ込み思案/優しい\n\n5組目：パン屋の常連客と店主\n結乃(ゆの)▶︎女性/ド天然/ふわふわしてる/ダレンに片想い中\nダレン▶︎男性/イギリス人/明るい/時計が好き/結乃の片想いに気づいてない\n\n▶用途（いずれも個人利用の範囲内におさめます）\n・対象キャラクターを登場させるTRPGセッションでの活用\n・カレンダーなどグッズ制作用データとしての活用\n・SNSへの納品報告およびアイコンやヘッダーへの活用\n※上記用途については、相方にも同様の許可を頂ければと思います。\n\n▶資料\nhttps://drive.google.com/drive/folders/13Oyk1Kkih97H5XH2MCIUl3uAvsHX9-aO\n▶︎イメージしてる過去のskeb\nhttps://skeb.jp/@satori_nunu/works/6\n\n10人でお茶会をしている様子を希望します。\n服装・髪型はお任せで描いていただきたいです。\n季節などもいつでも構いません。\nSNSへの納品報告時にAI学習防止のため他サイトを経由して掲載予定ですので、16:9の横長で描いていただきたいです。\n是非さとりぬ様の思い描くイラストを描いていただければと思っています。\nまた、金額が合わない場合は再送をお願いします。\nお忙しいとは思いますが、ご縁がありますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@satori_nunu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2198384, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18cc9c2f7c5747e30d59b3960ae2fddb", "srcset": "https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18cc9c2f7c5747e30d59b3960ae2fddb, https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fff45beaef76ed9844d3f4caf5e1829e 2x, https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9a1487935a3c46045797e5e5bd24f83 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e08c86b462847cfd18d9c1fd384338", "srcset": "https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e08c86b462847cfd18d9c1fd384338, https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99c66322552894cace613d960f2e248a 2x, https://si.imgix.net/caac6014/uploads/origins/a5282402-4a46-4032-a2b9-cb38b33c6df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a08b6a585bca1fa298a91cf491637b31 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！先生の描く魅力的な雰囲気、人間関係の魅力、キャラクターの感情がとても好きです！私のtrpgのOCも一緒に描いていただけませんか？\n\nヴィンテージの部屋で机の横に座って(描くのが面倒なら必要ないんですが、部屋を飾っている感じにしてもらえると超嬉しいです！)、ボードゲームをしているところを描いてもらえると嬉しいです。Aはチェス、Bは積み木。二人とも余裕の笑みを浮かべて、楽しそうにやっている。そして、まるで友達に呼び止められたかのように、2人で画面を見つめているシーンも描けます。ふたりとも人気者だが、長く接していると、ちょっと秘密と狡猾さに満ちているような......（Aはどちらかというと銀狐、Bは狼のようだ）。\n\nAの代表はダークホース（騎士）、Bの代表は高層ビルや街を模した積み木。\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。\n私の依頼を読んでいただきありがとうございました！もしお気に召さなければ、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1iBt9Vrb9uwqNcerk8Agnc3HsfcX0AHr8?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@satori_nunu/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6d68a1f8/uploads/origins/08d0bc4c-b04a-4052-8a44-8ee9846d4e01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2444ec1e06a229747c397b0d348debe7", "srcset": "https://si.imgix.net/6d68a1f8/uploads/origins/08d0bc4c-b04a-4052-8a44-8ee9846d4e01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2444ec1e06a229747c397b0d348debe7, https://si.imgix.net/6d68a1f8/uploads/origins/08d0bc4c-b04a-4052-8a44-8ee9846d4e01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=905a3f52cda4002fe7b3f032e7efe695 2x, https://si.imgix.net/6d68a1f8/uploads/origins/08d0bc4c-b04a-4052-8a44-8ee9846d4e01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=