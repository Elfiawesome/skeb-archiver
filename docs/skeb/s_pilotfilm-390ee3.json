ng/takito.png\n\n以上の内容で、ご検討いただけますでしょうか。\n何となく探偵物語の松田優作っぽくなる気もします。\nお忙しいところ恐れ入りますが、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_pilotfilm/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2751021, "client_id": 2776038, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7533a8bca4d059acaa4cba80602004a", "srcset": "https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7533a8bca4d059acaa4cba80602004a, https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84c062c5d7fe6cef5ac19a39f8d5c2e3 2x, https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c527638999b06090f676d4342963079 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e2c3d9e3113fb168da4d81953b85f8a", "srcset": "https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e2c3d9e3113fb168da4d81953b85f8a, https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9276f2f158d5371e51b75ed5b6a1ce7 2x, https://si.imgix.net/5b274215/uploads/origins/838a916b-fd21-4e99-a4c7-0d75f66f09ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f48b75722e927076a2af070c9e1909b 3x"}, "body": "初めまして、いつもTwitterなどで生活様の素晴らしいイラストを拝見しております。\n当方クリエイターをやっていまして、昔インディーズでバンドマンをやっていました。\n\nこの度クリエイター活動のため、下記の内容で作成依頼をさせて頂きたいです。\nご多忙かと思いますが、お力添えのほどよろしくお願い致します。\n\n↓↓↓\n\n◆依頼内容\nギターを持った女性の画像×1\n※あくまで可能であれば、ギターありなし2パターン（女性のデザイン変更不要）\n\n◆使用用途\n各種SNSのアイコン、ヘッダー、背景などで使用予定\n\n◆モチーフ（資料URLをご覧ください）\nモデル：20代前半くらいの女性（ポーズと髪型は画像に近い形で、他おまかせします）\nギター：PRS SILVER SKY Midnight Rose Rosewood\n色：背景→#C1DDF1、服→#DCDBA7辺りをベースに、他おまかせします\n\n※当方SNS\nInstagram：https://www.instagram.com/ig.design___11/\nTwitter：https://twitter.com/HirooIga\n\nhttps://drive.google.com/drive/u/2/folders/1nJ7p90ymjjvAvKjLZuu6L_iPLWgVlh9o", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_pilotfilm/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2751021, "client_id": 2769949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f860e1a7/uploads/origins/feca0f66-e374-496c-ab7e-f1d9b8d094df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ad83b6cf2387cf069e6fb0a72af2c6", "srcset": "https://si.imgix.net/f860e1a7/uploads/origins/feca0f66-e374-496c-ab7e-f1d9b8d094df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ad83b6cf2387cf069e6fb0a72af2c6, https://si.imgix.net/f860e1a7/uploads/origins/feca0f66-e374-496c-ab7e-f1d9b8d094df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d8e88c1454aa46ca50af3ad85de56e7 2x, https://si.imgix.net/f860e1a7/uploads/origins/feca0f66-e374-496c-ab7e-f1d9b8d094df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e85989b46e26284ec7ebf4ffd70ec19 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f860e1a7/uploads/origins/feca0f66-e374-496c-ab7e-f1d9b8d094df