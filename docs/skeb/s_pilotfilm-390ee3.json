/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c8bd187f0f7ddc38a3b79c27b09d1f", "srcset": "https://si.imgix.net/93792998/uploads/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c8bd187f0f7ddc38a3b79c27b09d1f, https://si.imgix.net/93792998/uploads/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3a803dbe28fa6f2bc86f0c0e44f1e2c 2x, https://si.imgix.net/93792998/uploads/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2432cf178062746034b49e982428a06f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93792998/uploads/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c89783378755d3af35a2463e0f784ed8", "srcset": "https://si.imgix.net/93792998/uploads/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c89783378755d3af35a2463e0f784ed8, https://si.imgix.net/93792998/uploads/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d9fc134bbe54053b5963a6d550bc4bb 2x, https://si.imgix.net/93792998/uploads/origins/64785eab-cdf6-4c41-92d3-70dc66915eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=583f4c06194e620f96f0c72bb9adabd1 3x"}, "body": "はじめまして。たじすけと申します。\n生活さんの描かれる○○ガールが大好きでいつか自分愛用のギターをモチーフにしたイラストを依頼できればと思っていました。\nプロの方に限らずイラストを依頼するのは初めてですので失礼がありましたら申し訳ございません。\n\n・要望\n　参考資料にあるギターをモチーフにアイコンイラストを描いていただきたいです。\n　どこまでリクエストしてよいのかわかりませんので可能な範囲で以下の要望を採用していただけると嬉しいです。\n\n　顔：これまで描かれてきたような黒髪の乙女（bass master girlやtron girlのようなイメージ）を希望します。泣きぼくろがあるとなお嬉しいです。\n　服装：黒系のズボンに水色or白系のオーバーサイズシャツ、裸足姿を希望します。少し腕まくりがあるとなお嬉しいです。（VIVA LA ROCK 2022に出演していたBase Ball Bearの小出祐介さんをイメージしました。）\n　ポーズ：おまかせします！\n　その他：ギターストラップのカラーもおまかせします！\n\n・参考資料\n　https://drive.google.com/drive/folders/1De3Jbw6vWednlaiDturtxF6gL6xCZGam?usp=sharing\n\n・用途\n　スマホの待ち受けおよびTwitterやLINEのアイコンで使用したいと思っています。\n\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1De3Jbw6vWednlaiDturtxF6gL6xCZGam?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 25000, "recorded_at": 1774015140.671621}]}}