ed": true, "creator_id": 861616, "client_id": 124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc2d347ef84c3c131182ae364349594", "srcset": "https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cc2d347ef84c3c131182ae364349594, https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf54897235e91ffa895a74644ea5d607 2x, https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4d9f0ed8126c43c8504fff62df11825 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3cdfdd7f903c986ba4b1bdc9d430b11", "srcset": "https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3cdfdd7f903c986ba4b1bdc9d430b11, https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66f332a24da9cf3959a6c7bd69766fb2 2x, https://si.imgix.net/7faec132/uploads/origins/04f5a31d-3384-4296-a481-3a2bd762d009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3f8ddd5b9fa07243f98ee63f94a00cd 3x"}, "body": "いつもかわいいイラストをありがとうございます\nさっそくですが、ブルアカより丹下イブキをお願いできませんでしょうか\n後術しますが厨級さんのロリ絵、特に見降ろしてもらう絵と色々な表情が大好きなので\nあおり構図で、表情差分多めだと嬉しいです\nクリスタ所有しておりますので、各差分画像はこちらで出力させていただきます\n\n【シチュ】\nサキュバスイブキの魅了の魔眼により精神がワンちゃんになった先生が、首輪をつけてもらって\nリードをもったイブキ様に服従のポーズをして足コキしてもらう\n表情は「素養」の2枚目のような舌ペロでお願いします\n関係的には「ご主人様（イブキ）」と「かわいいペットのワンちゃん（先生）」です\n【構図】\n先生の主観視点、「性癖解放決戦ぷゃ」のような見下ろされる構図でお願いします\n全く同じ構図でなくて、描きやすいようにして頂いて大丈夫ですが見下ろらせる感強めでお願いしたいです\n先生はほぼ見えない（見えても竿だけ）、もしくは全くみえないようお願いしたいです\n竿がみえる場合は、サイズは小さめ（イブキの足よりちょっと小さい）くらいでお願いしたいです\n【差分】要望度高い順　\n・魅了の魔眼（イブキの眼がハート目でぼんやりと光るやつ）　\n背景が魅了されてるようなエフェクト(ピンクのもやのようなグラデーションがかかってたり、ハートエフェクトがあったり)があると嬉しいです　\n・表情差分を何枚か(「性癖解放決戦ぷゃ」の2枚目のようなちょっと呆れてるっぽい顔、ロリっぽい純粋な笑みが要望度高いですが何か厨級さんが「これ描きたい！」ってのあればそれにして頂いて大丈夫です)\n・足接写差分　先生主観のため、お顔を足でなでなでしてくれるイメージです\n・足に精液\n・素足\n・イブキの手に首輪\n・ノーパン（パンツがみえる構図の場合）\n\n【台詞有無】\n無くても大丈夫ですので、お任せいたします\n描いて頂ける場合の台詞内容も基本お好きにして頂いて大丈夫ですが、\n魅了後のイブキ→先生の呼び名は「ワンちゃん」でお願いします\n「待て♡」「よし♡」等、イブキは先生としてではなくワンちゃんへの台詞\n先生も精神がワンちゃんなので「わん♡」や「くぅん♡」みたいなワンちゃん台詞だと嬉しいです\n\n【その他】\nレイヤ分けが描いて頂いた際のままだと嬉しいです\n\n要望が多く、申し訳ございません\nご検討の方、よろしくお願いいたします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Yu_C_Blossom/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 861616, "client_id": 1062591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc146722/uploads/origins/0dd85bc1-a8ab-4473-9413-a590dfe9a2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0665b4b010f68de223852c3b8b25855", "srcset": "https://si.imgix.net/cc146722/uploads/origins/0dd85bc1-a8ab-4473-9413-a590dfe9a2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0665b4b010f68de223852c3b8b25855, https://si.imgix.net/cc146722/uploads/origins/0dd85bc1-a8ab-4473-9413-a590dfe9a2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c74eb7a6c2b1cb9650e5cee0c7564ccd 2x, https://si.imgix.net/cc146722/uploads/origins/0dd85bc1-a8ab-4473-9413-a590dfe9a2fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79307b6d4c73e055abdd7e75e283d23e 3x"}, "duration": null, "nsfw": true, "ha