eHkSJtvo/view?usp=drivesdk\n\n\n【今回のイラストのご依頼内容】\n・構図や内容はお任せしますが、横長キャンバスで、夢のような雰囲気にしていただけますと嬉しいです。\n\n【使用用途】\n・SNS（Xなど）への投稿\n・配信や動画のサムネイル\n・アイコン、壁紙など個人使用\n\n【納品形式】\n可能であればPSD形式、難しい場合は背景あり・背景なしのPNGを書き出していただけますと幸いです。\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Xs72BeIJFeBVPZptl3pVIkB2C6JvTbky", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uruha0118/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3923809, "client_id": 3731158, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28b0a721/uploads/origins/1148ab5b-3a75-4ff5-b70b-8ed1ea5f44cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56769cf83f4c96af901e22c899f5be69", "srcset": "https://si.imgix.net/28b0a721/uploads/origins/1148ab5b-3a75-4ff5-b70b-8ed1ea5f44cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56769cf83f4c96af901e22c899f5be69, https://si.imgix.net/28b0a721/uploads/origins/1148ab5b-3a75-4ff5-b70b-8ed1ea5f44cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2089c93330deb5071f91e449583513a7 2x, https://si.imgix.net/28b0a721/uploads/origins/1148ab5b-3a75-4ff5-b70b-8ed1ea5f44cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbabb42b45403a2b882b0dee5befcc01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28b0a721/uploads/origins/1148ab5b-3a75-4ff5-b70b-8ed1ea5f44cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68fc2e1884b87a74b403669de088c38a", "srcset": "https://si.imgix.net/28b0a721/uploads/origins/1148ab5b-3a75-4ff5-b70b-8ed1ea5f44cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68fc2e1884b87a74b403669de088c38a, https://si.imgix.net/28b0a721/uploads/origins/1148ab5b-3a75-4ff5-b70b-8ed1ea5f44cf?bg=