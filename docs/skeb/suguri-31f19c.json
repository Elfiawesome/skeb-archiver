クアマリンカラーのようなグラデーションイメージになります\n・キャラクターはMiuをベースにすぐりさまアレンジしてくださいますと大変嬉しいです！\n・スミレの砂糖漬けやブルーベリーを使ったお菓子が背景にあると大変嬉しいです♡\n\n資料URLは、2枚目のバタフライピーお写真を参考にしてくださいますと幸いです！\nよろしくお願いいたします！\n\nhttps://www.instagram.com/p/C8NIjvHPVzu/?igsh=eHlrNzcwcGppeWFu", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suguri/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2985757, "client_id": 2038290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f1a4c05/uploads/origins/cec2c508-5dc4-44b9-bb5f-9834a3535190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f92b35050c75e3ce59db79d514f7004e", "srcset": "https://si.imgix.net/0f1a4c05/uploads/origins/cec2c508-5dc4-44b9-bb5f-9834a3535190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f92b35050c75e3ce59db79d514f7004e, https://si.imgix.net/0f1a4c05/uploads/origins/cec2c508-5dc4-44b9-bb5f-9834a3535190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b72f5dc7f88b23f6a2d6042da76969a 2x, https://si.imgix.net/0f1a4c05/uploads/origins/cec2c508-5dc4-44b9-bb5f-9834a3535190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93d48708578e1868b81a5fc2e49e8782 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f1a4c05/uploads/origins/cec2c508-5dc4-44b9-bb5f-9834a3535190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf689caed69a1ce47be6e27f1fa47c68", "srcset": "https://si.imgix.net/0f1a4c05/uploads/origins/cec2c508-5dc4-44b9-bb5f-9834a3535190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf689caed69a1ce47be6e27f1fa47c68, https://si.imgix.net/0f1a4c05/uploads/origins/cec2c508-5dc4-44b9-bb5f-9834a3535190?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl