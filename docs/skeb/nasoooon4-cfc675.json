op&w=200&h=200&blur=200&s=e212a35a92fc203786e20c9eefaf8501 3x"}, "body": "はじめまして。\nあなたの絵が大好きです。\n\nところで民族衣装って素敵ですよね。\nそんなイラストを描いて見せていただけないでしょうか。\n\n・柄がたくさんの服\n・カラフル\n・露出少なめ、布多め\n・黒髪\n\n取り入れてほしい要素を優先度順に上から並べました。性別問いません。荒野を行く民族とかのイメージです。雲一つないカラッとした青空の下をカラフルな服着て歩いてる様子とかだとえへへイイ…ってなります。装飾もたくさんジャラってるとうっひょー！ってなります。動物とか謎の生物もいたりしてぇ！？…この辺は取り入れていただかなくても結構です。リクエストを受けていただけるだけで毎日がピザパーティーのようなものですので。ピザパーティーと言えばダイエットコーラと言う声をよく耳にしますが、私はジンジャエール派です。\n\n以上、ご検討のほど何卒宜しくお願い申し上げます。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_328_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3260436, "client_id": 3254325, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4385fc12/uploads/origins/8864305d-8ba0-4b13-995a-f9377094945e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=136e2a2249ae420fdfb873faf949668c", "srcset": "https://si.imgix.net/4385fc12/uploads/origins/8864305d-8ba0-4b13-995a-f9377094945e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=136e2a2249ae420fdfb873faf949668c, https://si.imgix.net/4385fc12/uploads/origins/8864305d-8ba0-4b13-995a-f9377094945e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7a8ec5455a310beee43d1c6f138b521 2x, https://si.imgix.net/4385fc12/uploads/origins/8864305d-8ba0-4b13-995a-f9377094945e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01a9736b1be3376ea7a01cc21fae1629 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4385fc12/uploads/origins/8864305d-8ba0-4b13-995a-f9377094945e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60fe19ec885d1281befd05adfededb44", "srcset": "https://si.imgix.net/4385fc12/uploads/origins/8864305d-8ba0-4b13-995a-f9377094945e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop