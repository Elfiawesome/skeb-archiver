: true}, {"path": "/@hachike2/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 751298, "client_id": 2076707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3796dec019ab30c8d996a3e4664bd026", "srcset": "https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3796dec019ab30c8d996a3e4664bd026, https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=589747dd736e3735b428ce90cd930107 2x, https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8acbecddb87e4a9ec7bab47255a94f88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=995b65f51ff7876a5ba26bb0e830088c", "srcset": "https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=995b65f51ff7876a5ba26bb0e830088c, https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07a0a4a8247abca02c2873a50a91e2dc 2x, https://si.imgix.net/137342b5/uploads/origins/6b0867dc-e091-4a94-9a1c-201e80d2b4cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95646d894450d48d7804d0d8c3be183a 3x"}, "body": "蜂さま\n\nお世話になっております、海底Scope'sのキザシです。\n\n前回リクエストさせていただいたイラスト、最高に格好良くてずっとお気に入りです！大切にしております…！！☺️🙏🏻✨\nいつかまた絶対ご依頼させていただきたい…！と考えていたのですが、先日新衣装をお披露目したのでそちらを描いていただきたく、リピート失礼いたします。\n\n前回同様、蜂さまのお好きに描いて頂ければ幸いです！\n\n【リクエスト内容】\n民族衣装のキザシを描いていただきたいです。\n可能でしたら画面内に尻尾が入っていると嬉しいです。\n\n【キャラクターデザイン】\nグーグルドライブにて共有させていただきます。\n\n【使用用途】\nYouTubeでの動画サムネイル・SNSにて宣伝に活用\n※使用の際にはX(旧Twitter)のアカウント名を記載させていただきます。\n\n【そのほか】\nシャロンの資料も同封しておりますが、描くか否かはおまかせいたします。\n必要に応じて衣装の簡略等、ご自由に行って頂いて問題ございません。\n背景がありましたら、背景と人物のレイヤーを分けていただけますと幸いです。\n念のため、資料用に通常衣装の三面図も同封しております。\n\n不備等ありましたら再送要請をお願いいたします。\n\n以上、ご確認いただきありがとうございました。\nご検討のほどどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1tGRYebNU5o6nZihfiAJiNnk5ZAoV5xJa?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hachike2/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 751298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e915a9a/uploads/origins/45d0422e-2016-4e51-ad63-9063b463f6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d185099afcef35ced988c2629a4878f8", "srcset": "https://si.imgix.net/4e915a9a/uploads/origins/45d0422e-2016-4e51-ad63-9063b463f6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d185099afcef35ced988c2629a4878f8, https://si.imgix.net/4e915a9a/uploads/origins/45d0422e-2016-4e51-ad63-9063b463f6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a4fbb5eadedc1d2344bb63500241f27 2x, https://si.imgix.net/4e915a9a/uploads/origins/45d0422e-2016-4e51-ad63-9063b463f6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3184238b6142fb931a9bcaf7c5518974 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e915a9a/uploads/origins/45d0422e-2016-4e51-ad63-9063b463f6c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1617f214f6d12fb55f6b25e6