94d-471e-9cf7-a0cac86d6f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=280e4c775128a77656d37a724439956b, https://si.imgix.net/6de547d3/uploads/origins/870b2c99-c94d-471e-9cf7-a0cac86d6f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=371e317fdd76e5b700f66f1a96ca8c9f 2x, https://si.imgix.net/6de547d3/uploads/origins/870b2c99-c94d-471e-9cf7-a0cac86d6f6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a85e671b58d7d42ce36e553ff8909b0 3x"}, "body": "初めまして。初めてリクエストをお書きしております。失敗をいたしたら、申し訳ありません。  \n\nMITUKI様のイラストが去年Ｘでお見掛けしました。イラストは美しいのでリクエストを書きたいんございました。  \n\nリクエストの内容が下にお書きしました 。 \n・イラストの人が元気で陽気な女の人です。  \n・一つ花を被っています。  \n・髪は長くて紫です。\n・虹彩は花みたいな模様があります。  \n・服について特定の依頼はございません。  \n\n何卒よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chocolateXV/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 18997, "client_id": 3316253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2be4295dd410042a2b49d9c06b17acb4", "srcset": "https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2be4295dd410042a2b49d9c06b17acb4, https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce71fb139c7e0ac88064480a67c6e249 2x, https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56faf32d0c08afe6fd650a59add2d32f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55a910fb416e13828de80ca0758f5fe7", "srcset": "https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55a910fb416e13828de80ca0758f5fe7, https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d84d5aeb9fb8cd950dac937131a67057 2x, https://si.imgix.net/374d4d0e/uploads/origins/bc188232-d17b-4f4e-b87a-448f59f38eed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99465f1b73a7c3278d80011e0ab9c7dd 3x"}, "body": "初めまして、Vtuberの犬山たまきと申します。\n素敵なイラストを拝見しまして、是非ご依頼させて頂きたくご連絡をいたしました。\n\n■イラスト内容\nVtuber「犬山たまき」のイラストを描いて頂きたいです。\n衣装が多数ございますが、先生が気に入られたお衣装で作画頂けますと大変嬉しいです。\n性別は男性で「男の娘」キャラクターとなりますので、胸の描写だけお気をつけいただけますと幸いです…！\n(見た目が女性寄りなので、無理に男性らしく描写する必要はございません…！)\n\n公式HP キャラクター紹介\nhttps://noripro.jp/talent-inuyama/\n\n■希望納品形式\nキャラクターと背景がレイヤー分けされているpsdデータで頂戴出来ますと嬉しいです。\n\n■用途\nYouTubeのサムネイルへの使用、Twitterで活動の際に使用させて頂きたいです。\n使用の際は、先生のTwitterアカウントをYouTubeの概要欄、もしくはTwitterのツイート文にクレジットさせて頂きます。\n\n■構図や要望など\nYouTubeのサムネイルに使用する為、お顔が良く見える構図だと嬉しいです。\n頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。\n\n何卒、よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chocolateXV/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 18997, "client_id": 3777224, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a76282db8e4c018a4525682f7f7a1f9", "srcset": "https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a76282db8e4c018a4525682f7f7a1f9, https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82e5c8fac2d83725a98635f435f2960a 2x, https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42e117c75e18ef945ce494dae2ae46d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c13424bc690a1b46968228fff08e8499", "srcset": "https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c13424bc690a1b46968228fff08e8499, https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b9b5896069bf857ba32522d3e2c08e4 2x, https://si.imgix.net/80e98ead/uploads/origins/21de7c0c-b6de-42d2-9555-3669e13f5357?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b180b4449638ef6035cbcba5a0e0034 3x"}, "body": "初めまして！\n以前光の差す方へをXでお見掛けし、とても大好きになりました。\nリクエスト失礼いたします。\n\nリクエスト内容ですが\n大きいボンネット、白髪ロング、ドールで是非お願いいたします。\n\n使用用途といたしましては、スマホの壁紙、Xのアイコンにしたいと思っております。\n\nお時間ございましたらどうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chocolateXV/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 18997, "client_id": 68057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45e363a2/uploads/origins/03536609-84e2-4b4f-a09