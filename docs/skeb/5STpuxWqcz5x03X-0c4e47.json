press&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f157daa6e20df87e2c6610bd226e293 2x, https://si.imgix.net/46a7fab4/uploads/origins/edae48af-0a39-4754-89aa-9a0945013ace?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5f6cd8fd612ab2fcee990215f579f6a 3x"}, "body": "しずくちゃんのカラオケ企画のリクエストをさせていただいたものです。今回は素敵なイラストをありがとうございました。最高という言葉でも言い表せないほど素敵で、3枚目は司会者が言う通り「おいしい」シーンでとても良かったです。\n実はリクエストの際注文のし忘れがあり、急遽追加でリクエストを送りました。以下言い忘れてた内容↓\n3枚目は手足の濡れ感控えめになってましたが、下記のイラストのように濡れ間強め(水滴多め)でお願いしたいです。\nhttps://www.pixiv.net/artworks/85918957\n\nこれだけの為にまた送るのは申し訳ないので、良ければ続きのシーンが見たいと思い、1枚分の金額追加でリクエストします。\nシーン4…挑戦終了後、まだ全身びしょ濡れの体で下着姿になり、タオルで髪を拭いてるしずくちゃんのイラスト(体の濡れ感は3枚目と一緒で水滴やや多め)\n\n完了直後に申し訳ないです。\n大変じゃなければ是非受けていただきたいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5STpuxWqcz5x03X/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269540, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72203e55fec5bf1849439cb313be30d5", "srcset": "https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72203e55fec5bf1849439cb313be30d5, https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0596406a10695bbd67ac20bbaf34c0a6 2x, https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0c50474d6fe772a968ba052f9968c1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daf4a9640e79bef5d3b21f4998e51883", "srcset": "https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daf4a9640e79bef5d3b21f4998e51883, https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a96fcada427def489717477f74bde694 2x, https://si.imgix.net/a61f7207/uploads/origins/181b50e3-6eec-4380-9f1e-d5dd9f17da9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d49af7cad620cdfa7959fdead9f7f76 3x"}, "body": "こんばんは。\n桜坂しずくちゃんのお風呂の日イラストやギャル風イラストを見て素敵だなと思い、今回大変な内容になりますかリクエストさせて頂きました。\n複数シーンになるのですが、内容は、「スクールアイドル歌唱力テスト」というバラエティ企画に挑戦して、点数が届かず罰ゲームを受ける(頭上から大量の水が降ってきて全身びしょ濡れになる)様子を書いてほしいです。\n(枚数は目安)\n1枚目…カラオケ採点に挑戦(合格ボーダーは95点)\n2枚目…惜しくも失敗。頭上から大量の水が降って来る。\n3…全身びしょ濡れ(バラエティ番組のように何かコメント等あると良いです。)\n\n衣装は夏の制服でお願いします。もしくは下記の衣装で↓\nhttps://images.app.goo.gl/UhkUfkuk7XHU4vAY7\n\nフルカラーでお願いします。\n\n負担が大きいと感じたら遠慮なくキャンセルしてください(笑)\n\nhttps://youtu.be/HRkrrKQn5ME", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@5STpuxWqcz5x03X/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269540, "client_id": 976728, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32bf01be/uploads/origins/f3c821ef-aaf5-4d80-b670-5bda31b44da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe8c5de1bdacf5bbc6149da6c7295d6", "srcset": "https://si.imgix.net/32bf01be/uploads/origins/f3c821ef-aaf5-4d80-b670-5bda31b44da4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe8c5de1bdacf5bbc6149da6c7295d6, https://si.imgix.net/32bf01be/uploads/origins/f3c821ef-aaf5-4d80-b670-5bda31b44da4?bg=%23ff