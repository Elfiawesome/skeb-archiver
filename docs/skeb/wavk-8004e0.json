%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb27482eb120e238c581ccc3f376b853", "srcset": "https://si.imgix.net/e419d369/uploads/origins/66027cbc-c41f-4008-b3ec-a504c6c49146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb27482eb120e238c581ccc3f376b853, https://si.imgix.net/e419d369/uploads/origins/66027cbc-c41f-4008-b3ec-a504c6c49146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe2cea2fcf9dd9c16436f15d4fa58def 2x, https://si.imgix.net/e419d369/uploads/origins/66027cbc-c41f-4008-b3ec-a504c6c49146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ae0c3e1e7c7b3a1ece1a0d0f3f223b9 3x"}, "body": "わぶけーせぶん様\nアピールありがとうございます。\nあおと申します。\n\nぜひ蒼を描いていただきたく、リクエストをお送りいたします。\n\n【キャラクター】\nうちの子、暁月蒼\n\n【内容・シチュエーションなど】\nお任せいたします。\n服装や髪型の変更なども大丈夫です！\n\n【用途】\n個人での鑑賞に留めます。\n\n下記は参考URLです。\nhttps://misskey.io/@aosaya2/pages/1734664984202\nhttps://misskey.io/clips/a2sufamv5d9y06cm\nhttps://misskey.io/clips/a54cpqdk8vm402zr\n\nご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wavk/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3185693, "client_id": 2784612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5480f7d7e7476fc8d6aac89d29ec4949", "srcset": "https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5480f7d7e7476fc8d6aac89d29ec4949, https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f58c9d9c24fdc88e13d2f4ce49af199a 2x, https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70bc25961ab6f7a5f971935f918260d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48ed71ee7d4845da4252a96417fb5fdf", "srcset": "https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48ed71ee7d4845da4252a96417fb5fdf, https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7760e7cca955a85a28a357f2bb2f2200 2x, https://si.imgix.net/cbb13775/uploads/origins/66f0a433-6702-4b13-b61f-469050e03327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcf118ac1d2d9757a44fa97699edd2d2 3x"}, "body": "初めまして。\nアピール送っていただきありがとうございます。\n\nよろしければうちの子のみさらちゃんを描いていただくことはできますか。\n資料はURLと私のユーザーページの作品も参考にしてください。基本部分さえ抑えてあれば衣装アレンジや簡易化も自由です。\nあなたの思い描くみさらちゃんを描いてあげてください。\n\n今年から本格的にうちの子で創作活動をしようと考えているのでキャラ紹介のサムネイルに使用できる形だとありがたいです。\n\n【現在考えている創作活動】\n\n・noteを主体とした創作小説と創作世界の設定・キャラ解説の展開\n・一次創作としての同人活動\n\n【キャラ設定の補足】\n\n資料リンクに設定画像もありますがそれ以外の補足として記載します。\n\n・コーヒーとチョコレートは仕事のお供にするくらい好き\n・趣味で歴史が絡むファンタジー小説を書いていている。一度恋愛小説を書こうとして経験がない事から諦めた事がある。\n・料理を苦手とするため、食事はほぼ外食に頼り切っている。お酒は積極的に飲まないがそれなりに強い。主に野菜やキノコなどを使った料理の方を好む。肉料理は基本頼まない。\n・想像力が高いからかホラー系の小説は苦手としており自分で読みにいくことは基本ないが、好奇心に負けて時々読んでしまい後になって後悔することがある。\n\nご検討頂けますと幸いです。\n\nhttps://misskey.favskey.online/notes/ad735jkv3ye90s7e", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wavk/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3185693, "client_id": 2129333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3883089dfce0620afc9b70476aa4193", "srcset": "https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3883089dfce0620afc9b70476aa4193, https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=788dee32c489fad684ccda8144443d7c 2x, https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=449214a2782b1a2f00b9f3b65c31aec1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=763a44a3e0b15f82387f0bbf8ae20650", "srcset": "https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=763a44a3e0b15f82387f0bbf8ae20650, https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69e31c2948855d6354f75e923fc6f79f 2x, https://si.imgix.net/daac8e4a/uploads/origins/86832dd6-51ff-410d-a1d2-f1854dcdd8dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=401b0f1844d0a416421719788c158d7e 3x"}, "body": "waveknife7さん、大変お待たせいたしました。是非私のミスキーでの代理キャラを描いてください！\n\n私の代理キャラは御剣中身ちゃん。キャラクターの設定は私のミスキーのページのヘッダーから、私のミスキーОＣプロフィールのリンクを参照してください。設定は１枚しかありませんが、リンクの一番下にノートされている子です。他の方に描いていただいたイラストのリンクもありますので、参考にしてくださると嬉しいです。\n\n構図やポー