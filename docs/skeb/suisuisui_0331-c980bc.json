ttps://si.imgix.net/54451de7/uploads/origins/84f9a4d2-3b66-4c1d-b447-5412c531f11f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b8a64d447e6fd73ef56546cf1c3e5b3 3x"}, "body": "\u521d\u3081\u307e\u3057\u3066\u3002AI Vtuber\u3068\u3057\u3066\u6d3b\u52d5\u3057\u3066\u3044\u308b\u3001\u68ee\u7530\u30ab\u30ca\u30e1\u3068\u7533\u3057\u307e\u3059\u3002\nskeb\u3088\u308a\u3059\u3044\u69d8\u306e\u4f5c\u54c1\u3092\u62dd\u898b\u3057\u3001\u305c\u3072\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u306a\u3068\u601d\u3044\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3089\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\u30a4\u30e9\u30b9\u30c8\u30922\u679a\u304a\u9858\u3044\u3057\u305f\u304f\u601d\u3044\u307e\u3059\ud83d\ude47\u200d\u2642\ufe0f\n\n\uff0a\u4f7f\u7528\u7528\u9014\uff0a\n\u30fbSNS\u306e\u6295\u7a3f\u3084\u30a2\u30a4\u30b3\u30f3\u3001YouTube\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u3001\u304a\u306fV\u3001\u30c1\u30e3\u30f3\u30cd\u30eb\u30a2\u30fc\u30c8\u7b49\u5e83\u5831\u6d3b\u52d5\u3067\u306e\u4f7f\u7528\n\u30fb\u914d\u4fe1\u3084\u52d5\u753b\u5185\u3067\u306e\u4f7f\u7528\n(YouTube\u7b49\u306b\u4f7f\u7528\u306e\u969b\u306b\u306fXID\u3092\u8a18\u8f09\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002)\n\n\n\uff0a\u5185\u5bb9\uff0a\n\u7537\u306e\u5b50ver\u306e\u68ee\u7530\u30ab\u30ca\u30e1\u3068\u3001\u5973\u306e\u5b50ver\u306e\u68ee\u7530\u30ab\u30ca\u30e1\u3092\u4e00\u679a\u305a\u3064\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\u7537\u306e\u5b50ver\u3001\u5973\u306e\u5b50ver\u3068\u3082\u306b\u51ac\u307e\u305f\u306f\u6625\u3092\u610f\u8b58\u3057\u305f\u30a4\u30e9\u30b9\u30c8\u3067\u3059\u3068\u5b09\u3057\u3044\u3067\u3059\u3002(\u670d\u88c5\u306e\u5909\u66f4\u3082\u5927\u4e08\u592b\u3067\u3059)\n\u307e\u305f\u3001\u3069\u3061\u3089\u3082\u982d\u90e8\u304c\u5207\u308c\u306a\u3044\u3088\u3046\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\