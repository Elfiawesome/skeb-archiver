。\n金額の不足、リクエストの不備等がございましたら、お気軽に再送申請をしていただければと思います。\n\nご縁がございましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ptgJB-tJYaTWZNP0NlAot6hQBQV1OMPQ?usp=sharing\n\nhttps://drive.google.com/drive/folders/1ptgJB-tJYaTWZNP0NlAot6hQBQV1OMPQ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Roy_Stringer_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1937889, "client_id": 3411718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e8e3f26/uploads/origins/bda48e86-50af-4345-a64a-4f1941267d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e160460919ac8168816c6152f5e85b", "srcset": "https://si.imgix.net/1e8e3f26/uploads/origins/bda48e86-50af-4345-a64a-4f1941267d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e160460919ac8168816c6152f5e85b, https://si.imgix.net/1e8e3f26/uploads/origins/bda48e86-50af-4345-a64a-4f1941267d90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b880d864629092625088db35a9680a41 2x, https://si.imgix.net/1e8e3f26/uploads/origins/bda48e86-50af-4345-a64a-4f1941267d90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64c82211b4d0ec58ac95e1c270bbf27a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e8e3f26/uploads/origins/bda48e86-50af-4345-a64a-4f1941267d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d539171ed8fd5ce61727cd7a8ca3ce0", "srcset": "https://si.imgix.net/1e8e3f26/uploads/origins/bda48e86-50af-4345-a64a-4f1941267d90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d539171ed8fd5ce61727cd7a8ca3ce0, https://si.imgix.net/1e8e3f26/uploads/origins/bda48e86-50af-4345-a64a-4f1941267d90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&