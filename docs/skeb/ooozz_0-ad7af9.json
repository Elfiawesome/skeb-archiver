&w=200&h=200&blur=200&s=bcbac37a2314116f9ce78fde6da83140 2x, https://si.imgix.net/32a029cf/uploads/origins/a4cdec39-dcb9-4b95-9b60-aefd45134768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c82f52bd503e183920e7571cd7470996 3x"}, "body": "\u3053\u3093\u306b\u3061\u306f\uff01\n\u3074\u306e\ud83d\udcdb\u3055\u3093\u306e\u7d75\u304c\u5927\u597d\u304d\u3067\u3059\uff01skeb\u5b09\u3057\u3044\u3067\u3059(T . T)\uff01\n\n\u305c\u3072\u3074\u306e\ud83d\udcdb\u3055\u3093\u306b\u79c1\u306e\u306d\u3053\u3061\u3083\u3093\u305f\u3061\u3092\u64ec\u4eba\u5316\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\n\u69cb\u56f3\u3084\u30dd\u30fc\u30b8\u30f3\u30b0\u306a\u3069\u306f\u304a\u307e\u304b\u305b\u3044\u305f\u3057\u307e\u3059\u3002(\u643a\u5e2f\u306e\u5f85\u53d7\u3084\u5370\u5237\u3057\u3066\u30b9\u30de\u30db\u30b1\u30fc\u30b9\u306a\u3069\u306b\u5165\u308b\u6bd4\u7387\u3067\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\ud83d\ude47)\n\n\u3010\u7279\u5fb4\u3011\n  \u8584\u8272\u306d\u3053(\u7537\u306e\u5b50):\u304a\u3063\u3068\u308a\u3001\u9752\u3044\u77b3\u3001\u77ed\u3044\u3057\u3063\u307d\u300110\u6b73\n\u30cf\u30c1\u30ef\u30ec\u306d\u3053(\u7537\u306e\u5b50):\u5143\u6c17\u306a\u7518\u3048\u3093\u574a\u3001\u7dd1\u306e\u77b3\u3001\u9577\u3044\u3057\u3063\u307d\u30016\u6b73\n\u9ed2\u306d\u3053(\u5973\u306e\u5b50):\u7518\u3048\u3093\u574a\u3001\u9ec4\u8272\u306e\u77b3\u3001\u77ed\u3044\u3057\u3063\u307d\u30014\u6b73\n\n\u3010\u95a2\u4fc2\u3011\n\u30cf\u30c1\u306d\u3053\u306f\u307f\u3093\u306a\u3068\u4ef2\u826f\u3057\u3067\u3059\u3002\u4e00\u756a\u7518\u3048\u3093\u574a\u3067\u4eba\u9593\u306b\u3082\u307b\u304b\u306e\u306d\u3053\u306b\u3082\u7518\u3048\u3066\u307e\u3059\u3002\u4e00\u756a\u5143\u6c17\u30671\u4eba\u904a\u3073\u56de\u3063\u3066\u3044\u307e\u3059\u3002\n\u8584\u306d\u3053\u306f\u304a\u3060\u3084\u304b\u306a\u306e\u3067\u6012\u3063\u305f\u308a\u3061\u3087\u3063\u304b\u3044\u3092\u304b\u3051\u305f\u308a\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u9ed2\u306d\u3053\u304c\u4e00\u65b9\u7684\u306b\u8584\u306d\u3053\u306b\u53cd\u6297\u3057\u3066\u3044\u307e\u3059\u3002\u55a7\u5629\u3059\u308b\u3053\u3068\u3082\u3057\u3070\u3057\u3070\u3067\u3059\u3002\n\u8584\u306d\u3053\u306f\u304a\u3060\u3084\u304b\u3067\u3059\u304c\u3001\u3088\u305d\u306e\u306d\u3053\u304c\u6765\u308b\u3068\u3044\u306e\u4e00\u756a\u306b\u5a01\u5687\u306b\u3057\u884c\u304d\u307e\u3059\u3002\u5bb6\u3092\u5b88\u3063\u3066\u304f\u308c\u308b\u983c\u3082\u3057\u3044\u306d\u3053\u3067\u3059\u3002\n\u9ed2\u306d\u3053\u306f\u30d3\u30d3\u3063\u3066\u51fa\u3066\u304d\u307e\u305b\u3093\u3002(\u305d\u3053\u304c\u53ef\u611b\u3044)\n\n  \u53c2\u8003\u8cc7\u6599\u3068\u3057\u3066\u3001\u305d\u308c\u305e\u308c\u306e\u7279\u5fb4\u304c\u5206\u304b\u308b\u5199\u771f\u3092\u6dfb\u4ed8\u3044\u305f\u3057\u307e\u3059\u3002 \n\nhttps://drive.google.com/drive/folders/1QBNQP3NSYIFKnun3hkZpuU-7_d8RBJvl\n\n\u91d1\u984d\u306f\u3054\u5e0c\u671b\u306b\u5408\u308f\u305b\u3066\u518d\u9001\u3092\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n3\u5339\u304c\u53b3\u3057\u3044\u5834\u5408\u8584\u8272\u306d\u3053\u3061\u3083\u3093\u306e\u307f\u3067\u3082\u5927\u5909\u5b09\u3057\u3044\u3067\u3059\u2026\uff01\n\u96e3\u3057\u3044\u30ea\u30af\u30a8\u30b9\u30c8\u3067\u3057\u305f\u3089\u304a\u65ad\u308a\u3044\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\u2026\uff01\n\u4f55\u5352\u5b9c\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u2026\uff01\n\nhttps://drive.google.com/drive/folders/1QBNQP3NSYIFKnun3hkZpuU-7_d8RBJvl", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ooozz_0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2589461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdf54c89/uploa