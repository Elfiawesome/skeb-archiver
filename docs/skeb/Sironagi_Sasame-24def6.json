ゃなくバストアップで全然問題ないです！\n\n\n指定した範囲以外についてはお任せいたします！髪型もお任せします！\n\n\n長々とリクエスト連ねましたが、従わずなんでも好きに描いてもらってもぜんぜん喜びます！\n\nなにとぞよろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 301758, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひるね@最短納品4月末", "screen_name": "HRN__xn", "avatar_url": "https://pbs.twimg.com/profile_images/1829864154037190656/6S65WzCD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1182579797446123520/1747742553/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 128}, {"id": 693924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "がみー", "screen_name": "my11gum", "avatar_url": "https://pbs.twimg.com/profile_images/1555701840930832385/PtA1qzs1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2164532954/1766905336/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1717914, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "武", "screen_name": "tkp_work", "avatar_url": "https://pbs.twimg.com/profile_images/1649730807442055169/F8nPBiEa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1380853402364567553/1677948702/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2620286, "creator": true, "n