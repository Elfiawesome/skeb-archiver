c2c96151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40724753930862a22f1319822a2ffa4f 2x, https://si.imgix.net/04e5fe8e/uploads/origins/70f4c7c6-245c-4535-91ce-a84cc2c96151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5afa815ebe983ab8cfdc500d99c6fca0 3x"}, "body": "初めまして！いつも素敵なモリアーティ等のイラスト拝見しております。大好きです。\n二次創作も受け付けいるとの事で崩壊:スターレイルの丹恒を渋レあめさんの絵柄で見たいと思い依頼をお願いしにきました。\nポーズはカメラを向けられて無表情ながらもノってピースしてくれてる感じでお願いします。\nこちら公式から公開されている資料です。\nhttps://www.famitsu.com/images/000/333/786/y_65c3417eaed46.jpg\n\nご検討の程よろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@C4_ble15/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2374898, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3c2fd172d9b24d45fe3255b25195ac", "srcset": "https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3c2fd172d9b24d45fe3255b25195ac, https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2af177c73d951f131755ef88dfa0bd6 2x, https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=180fceea12e659247c21940d1ecdb9c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e705480eafc9ed6333e379fe40a1ba98", "srcset": "https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e705480eafc9ed6333e379fe40a1ba98, https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c87e72082493f24349f38f3e80231ef0 2x, https://si.imgix.net/f495e53b/uploads/origins/8331aca3-c71a-4e8f-ae37-c5d76abcc771?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95ba492720680b691661d1d394ee0b76 3x"}, "body": "初めまして、渋レあめさん。\nFGOでご依頼を掛けられそうな方を探してた所、見つけさせて頂きました。\n絶賛募集中とのポストをお見掛けしましたので、もしろよろしければFGOから、「清少納言ちゃん」に「セミラミスの最終再臨の衣装をコスプレ」をさせたイラストをお願いできるでしょうか……！？\n\n個人的にハマってしまった謎の組み合わせのため、ご理解に苦しむことは百も承知してますが、渋レあめさんがFGOに精通していることや、FGOのあの装飾満載のディティールに対し、真摯に細かく描き出せる絵描きさんとお見受けしましたので、セミ様のあの最終再臨衣装の装飾の細かさも描き上げてくれそうな期待を抱きましたため、お任せさせて頂ければと思った次第です。\n渋レあめさんの推してるキャラたちとはかけ離れてしまい大変恐縮ですが、この個人的な願望を叶えて頂ければ幸いです……！\n\nコスプレがメインとなりますので、なるべく衣装姿を拝める全身絵で描いてくだされば非常にありがたいです。それ以外の表情や構図・ポーズなどについても、渋レあめさんのセンスをそのまま光らせて頂ければOKです。\nまた、清少納言ちゃんの髪は第一再臨のもの（青・赤・黒のマーブルのやつ）を希望いたしますが、もっとセンスを光らせる直感が下りてくださったのなら、その限りではなくてもOKです。\n\n細かいディティールにつきましては、フィギュアの写真にてご確認いただければと存じます。\nhttps://www.goodsmile.info/ja/product/10713/%E3%82%A2%E3%82%B5%E3%82%B7%E3%83%B3+%E3%82%BB%E3%83%9F%E3%83%A9%E3%83%9F%E3%82%B9.html\n\n色んな意味で相当難易度が高いお題とは存じますが、それでも渋レあめさんの可愛さと、お仕事の細かさの伴ったお手前を振るって頂けますと幸いです。よろしければ、何卒お願いいたします……！\n\nhttps://www.pixiv.net/artworks/88419852", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@C4_ble15/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2374898, "client_id": 3510891, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57c24b73/uploads/origins/184ed45a-7dbb-4b06-b707-73e1af54d122?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e62b1aa0eac997c51