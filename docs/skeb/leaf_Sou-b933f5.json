e-42e9-43e2-b09e-8f72d0fa98b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b3a44219ebc9523e33a17f23d2618c, https://si.imgix.net/b50667ac/uploads/origins/15df860e-42e9-43e2-b09e-8f72d0fa98b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=314fa8b0b177538dfbcc148c58db5122 2x, https://si.imgix.net/b50667ac/uploads/origins/15df860e-42e9-43e2-b09e-8f72d0fa98b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fab4482f4a0ea78ac09397a558996d9a 3x"}, "body": "緑葉さん、いつも素敵なイラストをありがとうございます！\n\n今回は、四²葉ちゃんが「探偵風」の衣装に身を包んだ姿を見てみたいと思い、リクエストさせていただきました。最近、謎解きにハマっていまして…\n\n【リクエスト内容】\n■キャラクター名：\n四²葉ちゃん\n■資料URL：\n髪型アレンジのイメージ： https://beauty.hotpepper.jp/catalog/style/L147036605.html?storeId=H000256271&styleCategoryCd=SG01\n■描写範囲：\nおまかせ\n■シチュエーション・表情：\nおまかせ\n■服装：\n探偵風\n※「文豪ストレイドッグス」の太宰治のようなロングコート、または「ダンガンロンパ」の霧切響子が着用しているような、ジャケットスタイルが理想です。最終的には緑葉さんの判断と四²葉ちゃんのイメージで自由にアレンジしていただいて大丈夫です。\n■髪型：\n四²葉の元の髪型をベースにしつつ、今回はアレンジとして資料のように「毛先を少しふんわりさせた」感じでお願いいたします。\n■背景：\nおまかせ\n■納品形式：\nPSDデータ希望\n（可能であれば「人物」と「背景」が分かれていると大変助かります）\n\n■使用目的：\n・SNSのアイコン、告知用\n・SNSやFANBOX（無料公開分）での紹介\n・自作の無料謎解きコンテンツ内での使用\n※営利目的での利用はいたしません。\n\n■その他：\n・作業配信（制作過程の配信）は「なし」でお願いいたします。\n・衣装の細部やポーズなど、緑葉さんの描きやすい解釈で仕上げていただければ幸いです。\n\nご縁がありましたら、ぜひよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@leaf_Sou/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4b407f67/uploads/origins/abfca5c5-be72-4872-9a8a-fb2e287690c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=689045d5ed5af2b48bdd72dad736bcde", "srcset": "https://si.imgix.net/4b407f67/uploads/origins/abfca5c5-be72-4872-9a8a-fb2e287690c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Cc