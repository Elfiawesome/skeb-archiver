す。\n\n②夜ノとばり（よるのーー）\n中学生くらいの心優しい少年。優しく、他人のためなら自己犠牲も厭わない性格です。学生のため学ランを着ています。\n\n\nとばりが燈和の手を引いている、もしくは手を重ねている場面の一枚のイラストをお願い致します。穏やかな雰囲気で描いて頂ければ嬉しいです。その他の構図などはbiyo様にお任せしたいと思っておりますので、気を負わずにお時間のある時に描いていただければと思います！\n\n上記の依頼内容に難しい点があれば、是非断ってください。\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1T8QxRDQ2XxSSBNpKgokl8R2FbCi8oUZE", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@garyu3126/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 68771, "client_id": 2116641, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ddff7c3/uploads/origins/e3ddbd43-28ed-4f77-819d-7ac0a1a41cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0250dd1d24858744da58c22cc733a6d", "srcset": "https://si.imgix.net/3ddff7c3/uploads/origins/e3ddbd43-28ed-4f77-819d-7ac0a1a41cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0250dd1d24858744da58c22cc733a6d, https://si.imgix.net/3ddff7c3/uploads/origins/e3ddbd43-28ed-4f77-819d-7ac0a1a41cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67ffd84dc4a1d13e497b6ebcd260b006 2x, https://si.imgix.net/3ddff7c3/uploads/origins/e3ddbd43-28ed-4f77-819d-7ac0a1a41cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d978e903d0dd71114624f71a083d0ac1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ddff7c3/uploads/origins/e3ddbd43-28ed-4f77-819d-7ac0a1a41cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e525958759a9aaa62181c469c9844a51", "srcset": "https://si.imgix.net/3ddff7c3/uploads/origins/e3ddbd43-28ed-4f77-819d-7ac0a1a41cbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e525958759a9aaa62181c469c9844a51, https://si.imgix.net/3ddff7c3/uploads/origins/e3ddbd43-28ed