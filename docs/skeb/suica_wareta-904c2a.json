.net/76b94f7b/uploads/origins/8e3e7fb9-2b76-459b-bf0c-b0a44c4d325f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efe72a3a81955a70689f0efbe146ee1e 2x, https://si.imgix.net/76b94f7b/uploads/origins/8e3e7fb9-2b76-459b-bf0c-b0a44c4d325f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35806124479472f8db13b1c12b045f43 3x"}, "body": "初めまして、あるくと申します。 \nたろう様の色味や雰囲気がとても素敵で好きです。 リクエストを受け付けていると知り、思いきってメッセージを送らせていただきました。 \n描いていただきたいのは、男女の和風な雰囲気な親戚の幼馴染3人が一緒に映っているイラストです。 黒髪の女性は心霊写真家でぐいぐい2人を引っ張っていく性格、黒髪の男性は怪奇作家であまり人と関わらない性格ですが、それに狼狽え流されるままです。茶髪の男性は医者を目指していて苦労人で心配性なのですが微笑ましく見守っています。\n特に細かい指定はしませんので自由に描いていただけると嬉しいです。  どうぞ、よろしくお願いいたします。  https://drive.google.com/drive/folders/1i6XxW5kJ9r9C8E39fmU8_7FGo448M54i", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suica_wareta/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2116641, "client_id": 1531284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03be6a9f/uploads/origins/62b4fbd7-5249-4ad7-876d-624cd20f8ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cb36fd6e8c7f732807f17b743079ff1", "srcset": "https://si.imgix.net/03be6a9f/uploads/origins/62b4fbd7-5249-4ad7-876d-624cd20f8ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cb36fd6e8c7f732807f17b743079ff1, https://si.imgix.net/03be6a9f/uploads/origins/62b4fbd7-5249-4ad7-876d-624cd20f8ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a19d77388d27ea11abf335f7b6d72b3 2x, https://si.imgix.net/03be6a9f/uploads/origins/62b4fbd7-5249-4ad7-876d-624cd20f8ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c23e9138aaf69058c221cd010b5d9e00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net