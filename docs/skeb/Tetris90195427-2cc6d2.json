悪がり抜け出そうともがいているが徐々に気持ちよくなり始め、それを悟らせまいと強がっているがやがて声が我慢出来なくなり最終的にイカされてしまうという流れでお願いします。\n\nなかなかキワドイリクエストになってしまいましたがよろしくお願いいたします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Tetris90195427/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1425784, "client_id": 328819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c3d77c696a38ff1316912b492adc84", "srcset": "https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7c3d77c696a38ff1316912b492adc84, https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=399c6426b82efbabe031effe66b3ccf7 2x, https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15cbd9c4c824e279d477edba6495b458 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=195a8e012c51bc76035651f0d18c3095", "srcset": "https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=195a8e012c51bc76035651f0d18c3095, https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1ef0ba3fe84550bdd6df51d73331e5 2x, https://si.imgix.net/255809f7/uploads/origins/1cd71def-1725-4b0c-9ace-26f38135f433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac8a47b4a6e1c21591d1df48af147cda 3x"}, "body": "初めまして。いつもXなどで粘着拘束系のイラストを楽しく拝見しております。「適当にセリフを1つ貰ってそれで1コマ描く」ではお世話になりました。その時の仕事の早さや絵のクオリティを見込んで今回この場で依頼します。\n今回依頼するのは、獣三郎さん（https://www.pixiv.net/users/27961420）が手掛ける小説の挿絵として使用するものでキュアパイン（変身後）の粘着拘束です。\n明るい緑色のスライムに両足を拘束されたキュアパインがネバネバを剥がそうとして高く足を上げるというシチュエーションでお願いします。但し靴だけ黄色いパンプスとし、スライムはその側面にまでくっついているものとしてください。表情は特に指定しませんが、しいて言うなら焦っている様子が分かるものならありがたいです。\n\nXにて立った状態での粘着拘束のイラストは苦手だと仰っていたことは重々承知ですが、そこを何とかお願いします。もしどうしても受け付けられないと仰る場合はそれでも構いません。どうかよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Tetris90195427/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3cbe2990/uploads/origins/39799d94-9867-489c-8ba9-90db9a1fa00b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcc521af75baec11a99fa5b7b8240954", "srcset": "https://si.imgix.net/3cbe2990/uploads/origins/39799d94-9867-489c-8ba9-90db9a1fa00b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcc521af75baec11a99fa5b7b8240954, https://si.imgix.net/3cbe2990/uploads/origins/39799d94-9867-489c-8ba9-90db9a1fa00b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36bc32952e8c6d087e12acff99a63b62 2x, https://si.imgix.net/3cbe2990/uploads/origins/39799d94-9867-489c-8ba9-90db9a1fa00b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee173aa6edde335af08d164f6e5b348e 3x"}, "private": true, "genre": "art", "tipped": true, "cr