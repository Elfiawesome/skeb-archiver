動画内での使用\n・SNSでの告知、活動\n・Discordファンサーバー、FANBOXでの投稿\n\n【資料】\n・X（旧Twitter）：https://x.com/noe25maru\n\n・Twitch：https://www.twitch.tv/noe2525maru\n\n・Youtube：\nhttps://youtube.com/@noe2525maru?si=rgMrnfQpt4SNZeXf\n\n・その他資料一式（Google Drive）\nhttps://drive.google.com/drive/folders/1tJOX87D2I-Rrkw85B8Sv1PNaJbbje-9P?usp=drive_link\n\n改めまして、この度はどうぞよろしくお願いいたします🙇‍♀️", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manyak/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2324763, "client_id": 2833308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6ad237d/uploads/origins/2050d97f-6464-4564-9a6e-e1be9b44c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf3ea7ab93f13620fefa96a076338a8", "srcset": "https://si.imgix.net/c6ad237d/uploads/origins/2050d97f-6464-4564-9a6e-e1be9b44c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf3ea7ab93f13620fefa96a076338a8, https://si.imgix.net/c6ad237d/uploads/origins/2050d97f-6464-4564-9a6e-e1be9b44c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=068243f445e8a2a8d9c2582419fdeca2 2x, https://si.imgix.net/c6ad237d/uploads/origins/2050d97f-6464-4564-9a6e-e1be9b44c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8787667c0f463e48da07979a63c24d53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6ad237d/uploads/origins/2050d97f-6464-4564-9a6e-e1be9b44c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4030732f3eb2360838ba468082bfa070", "srcset": "https://si.imgix.net/c6ad237d/uploads/origins/2050d97f-6464-4564-9a6e-e1be9b44c2a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4030732f3eb2360838ba468082bfa070, https://si.imgix.net/c6ad237d/uploads/origin