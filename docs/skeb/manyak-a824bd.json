都合上難しそうであれば縦でも大丈夫です！)  女の子のイメージは、ストブラの妃崎さんのような少しキツめ・クールそうな黒髪の子が嬉しいです。  衣装や背景は、先生のセンスにおまかせさせていただければ助かります。  お忙しいところ恐れ入りますが、何卒よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@manyak/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2324763, "client_id": 189424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2f-436a-bea7-99e1c939ce12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db903f625bfe2790f2b33f03e20be9d4", "srcset": "https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2f-436a-bea7-99e1c939ce12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db903f625bfe2790f2b33f03e20be9d4, https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2f-436a-bea7-99e1c939ce12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51c372776f9d518c42336eb0b75c4312 2x, https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2f-436a-bea7-99e1c939ce12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=575c5bd706a993f90fcfa54e21dbdcbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2f-436a-bea7-99e1c939ce12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4922a3831993fc7e3a49b2490dd0527f", "srcset": "https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2f-436a-bea7-99e1c939ce12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4922a3831993fc7e3a49b2490dd0527f, https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2f-436a-bea7-99e1c939ce12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c7b632a1e67dfeb924cc6dc63fbdcfd 2x, https://si.imgix.net/b3247069/uploads/origins/1307ec27-ef2