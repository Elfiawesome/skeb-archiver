8f\u3063\u3066\u3044\u308b\u306e\u306b\u512a\u3057\u3044\u5272\u306b\u624b\u304c\u51fa\u308b\u3057\u53e3\u304c\u60aa\u3044\u304c\u8336\u76ee\u3063\u6c17\u304c\u5f37\u3044\u305f\u3081\u6163\u308c\u308b\u3068\u6c17\u304c\u7de9\u3093\u3067\u3057\u307e\u3046\u4eba\u304c\u591a\u3044\u3001\u9762\u5012\u898b\u304c\u826f\u3044\u3002\n\u4fdd\u5065\u5ba4\u306e\u304a\u5144\u3055\u3093\u7684\u306a\u7acb\u3061\u4f4d\u7f6e\u3002\n\n27\u6b73\u3001177cm\u3002\u4e00\u4eba\u79f0:\u4ffa \u4e8c\u4eba\u79f0:\u304a\u524d\n\u9aea\u306f\u767d\u9aea\u732b\u6c17\u524d\u9aea\u91cd\u305f\u3081\u3067\u3001\u5de6\u5bc4\u308a\u306b\u3064\u3080\u3058\u3002\u5de6\u5074\u306e\u9aea\u306f\u8033\u306b\u304b\u3051\u3066\u304a\u308a\u3001\u30a4\u30f3\u30ca\u30fc\u90e8\u5206\u306f\u304f\u3059\u3093\u3060\u6c34\u8272\u306b\u67d3\u307e\u3063\u3066\u304a\u308a\u307e\u3059\u3002\u9aea\u306f\u77ed\u3081\u3002\u767d\u629c\u304d\u307e\u3064\u6bdb\u3067\u3064\u308a\u76ee\u3002\u77b3\u306e\u8272\u306f\u304f\u3059\u3093\u3060\u6c34\u8272\u304b\u3089\u4e0b\u306b\u639b\u3051\u3066\u6843\u8272\u306b\u306a\u308a\u307e\u3059\u3002\u7f8e\u5f62\u9854\u3002\n\u4e21\u80331\u3064\u30d4\u30a2\u30b9\u958b\u3044\u3066\u307e\u3059\u3002\n\n\u68b6\u8526\u8389\u7dd2(\u653b\u3081)\u306f\u4e0d\u5e78\u4f53\u8cea\u6301\u3061\u5f37\u30e1\u30f3\u30bf\u30eb\u306a\u5927\u578b\u72ac\u3002\u611f\u60c5\u8868\u73fe\u304c\u8c4a\u304b\u3067\u30b3\u30ed\u30b3\u30ed\u8868\u60c5\u304c\u5909\u308f\u308a\u307e\u3059\u304c\u30c7\u30d5\u30a9\u30eb\u30c8\u3067\u60c5\u3051\u306a\u304f\u3066\u5927\u4f53\u534a\u30d9\u30bd\u304b\u3044\u3066\u307e\u3059\u3002\u529b\u304c\u5f37\u3044\u30b4\u30ea\u30e9\u3067\u3082\u3042\u308a\u307e\u3059\u3002\n\u65ad\u308c\u306a\u3044\u6027\u683c\u306a\u306e\u3067\u30d6\u30e9\u30c3\u30af\u4f01\u696d\u306e\u793e\u755c\u3057\u3066\u307e\u3059\u3002\n\n22\u6b73\u3001185cm\u3002\u4e00\u4eba\u79f0:\u50d5  \u4e8c\u4eba\u79f0:\u3042\u306a\u305f\n\u80a9\u306b\u4ed8\u304f\u304b\u304f\u3089\u3044\u306e\u9577\u3055\u306e\u767d\u9aea\u