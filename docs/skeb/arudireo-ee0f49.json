cb-b312-3f90370e8ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c91eadb48e68e9f3da1a91c81e8a8ce 2x, https://si.imgix.net/43596a72/uploads/origins/2e1dc2a9-f056-45cb-b312-3f90370e8ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=579f6a00ebab622bfce46771a0c0736f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43596a72/uploads/origins/2e1dc2a9-f056-45cb-b312-3f90370e8ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58440fd037778bd2b2caee72ac59a8da", "srcset": "https://si.imgix.net/43596a72/uploads/origins/2e1dc2a9-f056-45cb-b312-3f90370e8ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58440fd037778bd2b2caee72ac59a8da, https://si.imgix.net/43596a72/uploads/origins/2e1dc2a9-f056-45cb-b312-3f90370e8ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb69031feb3a767090b49e3f9b4173c0 2x, https://si.imgix.net/43596a72/uploads/origins/2e1dc2a9-f056-45cb-b312-3f90370e8ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e835c94dfa8ad1ba30bd2ba517609eca 3x"}, "body": "等星様\n\nいつもお世話になっております。朝比奈レオと申します。星さんと星さんの描く子がとても大好きです。\nクトゥルフ神話TRPGの全身立ち絵に使うイラストのリクエストとなります。以下、箇条書きとなってしまいますがその内容です。\n\n・CoCシナリオ『NapFrappe』の弊HO：STARである、「Never Mind（ネバーマインド）」\n・服装についておおまかに指定はあるが、細部や装飾についてはお任せしたい\n・立ち絵として使用できる透過したものだと嬉しい\n・ディスプレイがあると星さんの描く子の素晴らしさをふぉふぉふぁーに布教できるためとても嬉しい\n\n【ヒアリングシートが規約違反っぽかったので、そこに記載しようと思っていたやつをこっちに載せています】\n性別：女性\n目の色：黒と薄緑のオッドアイ\n髪色：白と黒のツートンカラー（左右問わず）\n服装：白の軍服+黒のマント\n小物：手元か腰に拳銃を携帯していると嬉しい\nテーマカラー：白+黒\nその他：補足情報\n・目のハイライト無し\n・140cmの無表情系ジト目合法ロリ\n・スカートよりも短いズボンに黒のスパッツという形が好ましい　〈キック〉をするので\n・北欧系っぽい顔立ちだと嬉しい　\n\n【参考画像のURL（スクリーンショット）】\n→［https://drive.google.com/file/d/1tvz4PAJgLurUflzpchE4kdATlFmBnHJH/view?usp=drive_link］\n\n────\n\n（規約的にいあきゃらを載せるのもちょっとグレーっぽいので、概要だけ抜き出してまとめました。長いので読み飛ばしていただいて大丈夫です。）\n\n【概要】\n　国家警察に所属するエリート警察官。外見年齢は女児といって差し支えないが、中身は二十代中頃の女性。\n　国家秩序を何より尊重し、遵守する。少数の犠牲による多数が幸福になることも肯定している。\n　その“少数”に自分がなるときまで、頑張って働こうね〜というスタンス。\n\n【性格】\n　行き過ぎた功利主義者。トロッコ問題なら一瞬で一人の方にレバーを切るタイプ。\n　平和を愛しており、誰かの笑顔を見るのが好き。しかし、それを守るための犠牲には躊躇しない。\n　情に流されず、仕事は的確。いざとなれば自分の身を捧げる度胸を持つ。\n　総評として、彼女は実に優秀なエージェントだ──その分、自分を大切にするつもりがないとも言えるが。\n\n　決して硬いだけの人物というわけではなく、仕事外であれば冗句の類も言ったりする。\n　また同僚や友人を大切にしているが、たとえ死んだり裏切られたりしても気にしたりはしない。\n　畢竟、マシーンのような女である。\n\n【セリフ例】\n「ネバーマインドよ。ドンマイちゃんって呼んで」\n「私はシステムなの。国家警察というシステム。過度で且つ偏った期待はしない方がいいわよ」\n「秩序が保たれてこそ、平和がある。混沌はどこまでも追いやられるべきなの」\n「たとえ一人の笑顔を奪ってでも、百人の笑顔を守りたいわ、私」\n\n────\n\nリクエストの内容は以上です。伝えるべき内容が欠けていた場合は本当にごめんなさい。\nお時間ございましたら、どうぞよろしくお願いいたしします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arudireo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2639418, "client_id": 3024872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9ecadd9/uploads/origins/b8577112-2c8c-4e9e-9190-faf7857c3f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac272a65c05b1a48c1e9a97613a64ead", "srcset": "https://si.imgix.net/a9ecadd9/uploads/origins/b8577112-2c8c-4e9e-9190-faf7857c3f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac272a65c05b1a48c1e9a97613a64ead, https://si.imgix.net/a9ecadd9/uploads/origins/b8577112-2c8c-4e9e-9190-faf7857c3f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=119c195c74a4d5ddcf7e77b0679fa23e 2x, https://si.imgix.net/a9ecadd9/uploads/origins/b8577112-2c8c-4e9e-9190-faf7857c3f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=987002ca442666613c563d1f9722ad7c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9ecadd9/uploads/origins/b8577112-2c8c-4e9e-9190-faf7857c3f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&