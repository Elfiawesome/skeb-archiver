  ピアスやタトゥーが多く、ストリートファッションやグランジファッションが好き。カフェイン（コーヒー、紅茶、エナジードリンク）、エレキベースを弾くこと、メタル／ゴシック／ヴィジュアル系の音楽を聴くこと、ビデオゲームをすること、昼寝をすることが大好き。疲れていることが多く、家猫のように不機嫌になることもある。^^\n\n表情やコスチュームは自由に描いてください！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1iJZ6Gs2aLtAsaQ3aT0LRqWZ-g5bhY7vl?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Wakaran_all/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3245431, "client_id": 3434968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07229c25/uploads/origins/423af17e-eae1-488e-ad40-5da8ed4faba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5017ceef7aeb7cc5f12ed59f591b88b3", "srcset": "https://si.imgix.net/07229c25/uploads/origins/423af17e-eae1-488e-ad40-5da8ed4faba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5017ceef7aeb7cc5f12ed59f591b88b3, https://si.imgix.net/07229c25/uploads/origins/423af17e-eae1-488e-ad40-5da8ed4faba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c882a36a165ca061f3192ec817ed1e25 2x, https://si.imgix.net/07229c25/uploads/origins/423af17e-eae1-488e-ad40-5da8ed4faba6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b6529a82f7352e9260e2eb3cf43370d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07229c25/uploads/origins/423af17e-eae1-488e-ad40-5da8ed4faba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdf56c0bca393d85e777e6ee0ae649e7", "srcset": "https://si.imgix.net/07229c25/uploads/origins/423af17e-eae1-488e-ad40-5da8ed4faba6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdf56c0bca393d85e777e6ee0ae649e7, https://si.imgix.net/07229c25/uploads/origins/423af17e-eae1-488e-ad40-5da8ed4faba6?bg=%23fff&auto=format%2Ccompre