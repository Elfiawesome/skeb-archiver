7c-b43558bfc151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f73b37e80602b70c064eb5a17c6da90d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44500b85/uploads/origins/f8efe87b-ffeb-4caa-867c-b43558bfc151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7fddc1be3f751d3febf7769d4335ee", "srcset": "https://si.imgix.net/44500b85/uploads/origins/f8efe87b-ffeb-4caa-867c-b43558bfc151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7fddc1be3f751d3febf7769d4335ee, https://si.imgix.net/44500b85/uploads/origins/f8efe87b-ffeb-4caa-867c-b43558bfc151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6d59d3805e336fd921f8ad6d555a363 2x, https://si.imgix.net/44500b85/uploads/origins/f8efe87b-ffeb-4caa-867c-b43558bfc151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a857c388b70c7c84105a2c989ba33434 3x"}, "body": "のと様\n初めまして！アピールありがとうございます！！\n是非描いていただきたく、リクエストを送らせていただきました。\n\n‣【リクエスト内容】\n当方のオリジナルキャラクターをお願いします。\n構図やポーズなどはお任せしたいのですが、通常の等身イラストでお願いしたいと思っております。\n衣装の簡略化やアレンジなど問題ありません。\n\n‣【キャラクターイメージ】\nモチーフは水龍で全体のイメージカラーは青緑。\n瞳の色が赤と黄色のオッドアイなのですが、赤は真っ赤というより朱色のイメージです。\n口は緩やかな猫口で、上の歯の犬歯は両方尖っています。\n雰囲気はミステリアスぶっているものの、本質はいたずらっ子/お茶目といった性格。\n身長はおよそ165cm。\n特徴である「腰の中サイズの翼」「龍の4本ツノ/尻尾」「尖った耳」を抑えてもらえればアレンジが加わっても大丈夫です。\n爪を描いてもらえる場合長めに描いていただきたいです。\nまた無性なので、中性的な雰囲気で描いてもらえたら幸いです。\n\n‣【使用用途】\n・個人観賞\n・SNSのアイコン/ヘッダー等への使用\n・参考資料として他の方への依頼時に提示の可能性有\n　Googleドライブを使用。\n　またその際は転載防止の透かしを入れさせていただきます。\n・その他個人的に金銭の絡まない範囲での利用\n※上記利用不可があった場合は別レイヤーにご記載頂けますと幸いです。\n\n金額や条件が難しければ再送/キャンセルをして頂ければと思います。\nお忙しい中恐縮です、ご検討のほど宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1j4pPO_qz60XC9PrsyK8y513ESL-SQlOI", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Wakaran_all/works/4", "private_thumbnail_image_urls": null, "private"