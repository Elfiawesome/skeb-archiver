, https://si.imgix.net/0f078ca0/uploads/origins/fe35e658-ba2a-457e-b8c9-434b71cc48bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=311dd4d45529dc79be92407a324e8d30 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2694770, "client_id": 1291989, "nc": 17}, {"path": "/@Zi_V_0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2694770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfdc43910f89fc3919aeea99751b0158", "srcset": "https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfdc43910f89fc3919aeea99751b0158, https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c502e138c893b4928b412b85f7b0e30a 2x, https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d476b4aab57662065b78ee525aa22f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84085fea7455fab610c7c9c199392c60", "srcset": "https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84085fea7455fab610c7c9c199392c60, https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7116ca9f4c5a3038efe7ca6646a14eda 2x, https://si.imgix.net/1124ec0b/uploads/origins/74d71b40-0513-4f53-a67f-cb666c674927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79189625a6f2d1589cf4013c62ae6687 3x"}, "body": "こんばんは、以前にリクエストした者です。前回ZIV様にお応え頂いた作品が本当に好きで気に入っており、現在も壁紙として大切に重宝させてもらっているのですがそこで是非他のキャラクターもリクエストさせて頂けたらと思った所存です。\n\nリクエスト内容はこちらです。少しブロマンス〜BL要素がOC達に含まれます。苦手な場合はキャンセルしていただいて構いません。\n\n\n\n\n\n\n\n\n-----------------------------\n￤キャラクター（OC/TRPGキャラクター）\n名前：Edgar･Blossom（エドガー・ブロッサム）/受け\n性別：男\n年齢：27\n身長：180cm\nカラーコード：シグナルレッド(#e8383d)\n\n性格：表ではミュージシャンのような楽器関連の職業（ギターやピアノなど）、裏ではMI6に所属するエージェント。\n端正で綺麗な顔付きでプライドが高く、自信家。優雅で余裕のある紳士的一面を持つが、大胆で無鉄砲なヘクターに振り回されているところもあるし自信家故にヘクターを振り回しているところもある。\nプロファイリング能力を持っているがヘクターに対してだけはどうも上手くいかず、心理を読むことが出来ない。\n日本が好きで特におにぎりや柿が好き。タコや虫を苦手としている。\n特徴：白髪赤眼、はね毛、アホ毛、つり目で睫毛が長い、ホクロがある、腰周りは細いが筋肉のついたしっかりとした体格\n台詞：「こうして偶然出会えたのも何かの縁ですから、是非少しお茶でも。もちろんご馳走しますよ」（他人）\n「俺の前でその名を出すなよ。最悪手元が狂っても責任は取れない」（虫に関すること）\n\n\n名前：Hector･Coret（ヘクター・コレット）/攻め\n性別：男\n年齢：27\n身長：178cm\nカラーコード：千草色(#21A0DB)\n\n性格：表では新聞記者、裏ではMI6に所属する情報屋。\n可愛らしい顔付きだが無邪気で大胆で男気がある。優秀な頭脳派だが脳筋な一面があり、エドガーを振り回すところがあるが譲らないプライドを持っているエドガーに振り回されているところもある。\n他人の顔色や心理を読むのが得意であり、エドガーに対しても心理を読んでは図星をついている。\nチョコレートが大好物で好物の紅茶とよく嗜んでいる。スプラッタ系や虫が苦手。\n特徴：茶と黒のツートン髪水色目、サイドが長い、タレ目、女顔、触覚、モノクル、全体的に体が薄い\n台詞：「お久しぶりです。元気にしてましたか？……はは、とんでもない。貴方の提供してくださった話の質が良かったからですよ」（他人）\n「キッショ！マジでありえねぇ！！」（虫やスプラッタ映画見た時）\n\n関係性：エージェントと情報屋の相棒であり、人生の半分以上を共にした幼馴染兼親友。戦闘技能に優れたエドガーと優秀な頭脳を持つヘクターのコンビ。互いに素を出せる関係値にあり、互いに互いの一番であると自覚している。恋人関係では無いが一夜の過ちとしてそういった経験が一度ある。\n台詞：\nエドガー・ブロッサム「お前が相棒でよかったよ」\nヘクター・コレット「そうだろ？俺は最高の男だからな」\n\n資料：https://drive.google.com/drive/folders/1-85U9NJ30rmSP_BC1sbGmyuBhT0Czn2v\n（ヘクターのコートの前の閉め方が逆になっているのでそこだけ逆にして貰えたら嬉しいです…！）\n\n希望：人物メインであると嬉しいですが、背景が多くを占めても構いません。下記のキーワードを参考にして頂いても大丈夫です！\nキーワード：イギリス、諜報員と情報屋、バディ、親友、チェス、白猫とミニチュアダックス、紅茶、心理戦、青空、夜空\n構図：お任せします…！\n\n使用用途：個人鑑賞、アイコンや壁紙への使用、私用目的とした非商用のもの。\n-----------------------------\n\n以上となります。初心者故に金額などに不備がありましたら遠慮なくキャンセルや再送信などして頂けたら幸いです。長文ですが気兼ねなく思ってください😭！\n何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Zi_V_0/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/affa8363/uploads/origins/d7baf3c2-fb72-49de-9407-1377fa349ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6b1a1adfd349026d5791c90c8e1efe0", "srcset": "https://si.imgix.net/affa8363/uploads/origins/d7baf3c2-fb72-49de-9407-1377fa349ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6b1a1adfd349026d5791c90c8e1efe0, https://si.imgix.net/affa8363/uploads/origins/d7baf3c2-fb72-49de-9407-1377fa349ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18a74a7117b7c714334e08fdaccbfc96 2x, https://si.imgix.net/affa8363/uploads/origins/d7baf3c2-fb72-49de-9407-1377fa349ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9892238092150c4730ca2919a4a7dc4a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2694770, "client_id": 2919887, "nc": 128}, {"path": "/@Zi_V_0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2694770, "client_id": 193145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9c34eed/uploads/origins/c9951953-9563-4148-abc9-b2b2b2e28447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bda79efe178dc76e4858ffc79bc93c82", "srcset": "https://si.imgix.net/d9c34eed/uploads/origins/c9951953-9563-4148-abc9-b2