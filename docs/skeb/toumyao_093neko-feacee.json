59\u304c\u3001\u4eca\u56de\u306e\u30bf\u30a4\u30df\u30f3\u30b0\u7684\u306b\u672c\u65e5\u3001\u81ea\u5206\u306e2025\u5e74\u5ea6POG1\u4f4d\u6307\u540d\u306e\u3010\u30a2\u30af\u30bb\u30b9\u3011\u541b\u304c\u898b\u4e8b\u306b\u30c7\u30d3\u30e5\u30fc\u52dd\u3061\u3092\u53ce\u3081\u3066\u304f\u308c\u305f\u306e\u3067\u3001\u662f\u975e\u5984\u60f3\u30a6\u30de\u5a18\u5316\u3057\u3066\u9802\u304d\u305f\u3044\u306a\u3068\u601d\u3063\u3066\u307e\u3059\u3002\n\n\u8c46\u82d7\u3055\u3093(\u81ea\u5206\u306e\u4e2d\u3067\u306f\u8c46\u82d7\u3055\u3093\u306a\u306e\u3067\u3059\u304c\u3001\u3069\u306e\u547c\u3073\u65b9\u304c\u7406\u60f3\u304b\u3044\u3064\u304b\u6559\u3048\u3066\u9802\u3051\u308c\u3070)\u304c\u3001\u305d\u3053\u307e\u3067\u99b4\u67d3\u307f\u306e\u7121\u3044\u99ac\u3060\u3068\u601d\u3046\u306e\u3067\u3001\u3068\u308a\u3042\u3048\u305a\u81ea\u5206\u304c\u77e5\u308a\u5f97\u308b\u9650\u308a\u306e\u60c5\u5831\u3068\u3001\u81ea\u5206\u306a\u308a\u306e\u89e3\u91c8\u3092\u66f8\u304d\u9023\u306d\u3066\u3044\u304f\u306e\u3067\u3001\u5275\u4f5c\u306e\u53c2\u8003\u306e\u4e00\u52a9\u306b\u3067\u3082\u3057\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3002\n\n\u99ac\u540d\u3000\u30a2\u30af\u30bb\u30b9\n\n2023\u5e7403\u670803\u65e5\u4e0b\u6cb3\u8fba\u7267\u5834\u751f\u307e\u308c(\u304a\u7236\u3055\u3093\u306e\u30ad\u30bb\u30ad\u3068\u304b\u30bd\u30a6\u30eb\u30e9\u30c3\u30b7\u30e5\u304c\u751f\u307e\u308c\u305f\u3068\u3053\u308d\u3067\u3059)\n\n\u99ac\u540d\u306e\u30a2\u30af\u30bb\u30b9\u306f\u3010\u63a5\u8fd1\u3011\u3063\u3066\u610f\u5473\u3089\u3057\u3044\u3067\u3059\u3002\n\n\u7236\u30ad\u30bb\u30ad\n\u6bcd\u30c8\u30ea\u30cb\u30c6\u30a3\u30d7\u30ec\u30a4\u30b9\n\u6bcd\u7236\u30de\u30f3\u30cf\u30c3\u30bf\u30f3\u30ab\u30d5\u30a7\n\n\u77f3\u5ddd\u9054\u7d75\u30aa\u30fc\u30ca\u30fc(\u3053\u308c\u3082\u30ad\u30bb\u30ad\u3068\u304b\u30bd\u30a6\u30eb\u30e9\u30c3\u30b7\u30e5\u306e\u3001\u767d\uff0c\u7dd1\u4e8c\u672c\u8f2a\uff0c\u767d\u8896\u52dd\u8ca0\u670d\u306e\u4eba)\n\n\u6027\u683c\u3001\u7279