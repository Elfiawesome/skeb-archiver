dcf-d0716248f9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c00397134f24779f6d821c499a1c371d 3x"}, "body": "みつはもち先生初めまして。朱繕と申します。\n\n先生が描いたSkebイラストをXのタイムラインでお見かけし、非常に可愛く塗りも素敵だったためリクエストをお送りさせて頂きました。\n\nもしよろしければ私のアバターのイラストを描いて頂けないでしょうか?\n\n# 資料について\nGoogleフォトにアバターの写真を格納していますので、こちらを参考にお願いしたいです。\n\n# 構図について\nアイコンやヘッダーなどのイラストで行われているような、眼の上に透けた髪を描かれるのが非常にハイクオリティで素敵だと感じています。なので可能であればこの方法で私のアバターも描いて貰えないでしょうか?\nその他全てお任せでお願いいたします。可愛く描いて頂けると嬉しいです。\n\nまた、衣装の細かい装飾にこだわりはありませんので、必要に応じて省略や描きやすいものに置換して頂ければと思います。\n\n# 用途について\nSNSアイコンとしての利用、VRSNS空間での展示、私的利用に収まる範囲での自分用オリジナルグッズ作成などを考えています。\n\nご検討よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/8dHB4K3vsfbckGsT6", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MitsMochi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2308203, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/347dc59e/uploads/origins/c8cd0ebc-3a4e-4542-beee-8a4f8674e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7e17d0c5abe4426ddf64a3b7491436", "srcset": "https://si.imgix.net/347dc59e/uploads/origins/c8cd0ebc-3a4e-4542-beee-8a4f8674e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d7e17d0c5abe4426ddf64a3b7491436, https://si.imgix.net/347dc59e/uploads/origins/c8cd0ebc-3a4e-4542-beee-8a4f8674e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc9eb97640b09a2c579de9e16fd86307 2x, https://si.imgix.net/347dc59e/uploads/origins/c8cd0ebc-3a4e-4542-beee-8a4f8674e00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5ffe4dee556f150ec3d4dd8ade68d97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/347dc59e/uploads/origins/c8cd0ebc-3a4e-4542-beee-8a4f8674e00d?bg=%23fff&auto=format%2Ccompress&fm