aring\n(シナリオネタバレは含まれておりません！)\n\n【関係性】\n臨海旅行というシナリオを通過したPC達です。\nオカルト研究部に所属する大学生で、大学ではいつも一緒に過ごしています。\n\n【リクエスト】\nこの三人が楽しそうにわちゃわちゃしている感じのイラストをお願いしたいです‥！！\nもし場所が海の場合は、漣音はカナヅチで水が苦手＆海呑は海が苦手なので、ビーチなど海から離れた場所に配置していただけるとありがたいです！\n\nまた、PCのモニター背景に使用させていただきたいので、横長のキャンバスだと大変嬉しいです‥！\n\nその他はすべておまかせします！\n衣装も描きやすいように変更していただいて構いません。\nMOFUさんのお好きなように、楽しんで描いていただけたら嬉しいです！\n\n【使用用途】\n-非商用利用・個人観賞用\n・自陣PLへのイラストの共有\n・PCのモニター背景\n\n料金の不足などありましたら気兼ねなく再送/キャンセルしてください！\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JATOOWL57HBX8Cqng4RW5nfkUffOSKaR?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@illu_kamo/works/404", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 122893, "client_id": 3145678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67ba31ce/uploads/origins/ad633fe6-c1d0-47f7-bdd9-c4cff63a9076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c0ee547e67a206cef19101ae62917c4", "srcset": "https://si.imgix.net/67ba31ce/uploads/origins/ad633fe6-c1d0-47f7-bdd9-c4cff63a9076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c0ee547e67a206cef19101ae62917c4, https://si.imgix.net/67ba31ce/uploads/origins/ad633fe6-c1d0-47f7-bdd9-c4cff63a9076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=227dfe4a7ebf7a6c81df1905d628842f 2x, https://si.imgix.net/67ba31ce/uploads/origins/ad633fe6-c1d0-47f7-bdd9-c4cff63a9076?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27d60c8b065d54e1b8be61accd6a0731 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67ba31ce/uploads/origins/ad633fe6-c1d0-47f7-bdd9-c4cff63a9076?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f73494a180e07afc1c735444d079a108", "srcset": "https://si.imgix.net/67ba31ce/uploads/origins/a