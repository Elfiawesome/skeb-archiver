9f6f77a-6b70-4c86-94a3-45e2042a693f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a58ad6aba1407efcf50b1231bc65c69, https://si.imgix.net/cc99c9fc/uploads/origins/19f6f77a-6b70-4c86-94a3-45e2042a693f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=105616ed4c8962ece51427461d8caadc 2x, https://si.imgix.net/cc99c9fc/uploads/origins/19f6f77a-6b70-4c86-94a3-45e2042a693f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22c25d3a59feb4c9545c7d42ec245b23 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc99c9fc/uploads/origins/19f6f77a-6b70-4c86-94a3-45e2042a693f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b1ca51fda583e82d76f42e7002b24e3", "srcset": "https://si.imgix.net/cc99c9fc/uploads/origins/19f6f77a-6b70-4c86-94a3-45e2042a693f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b1ca51fda583e82d76f42e7002b24e3, https://si.imgix.net/cc99c9fc/uploads/origins/19f6f77a-6b70-4c86-94a3-45e2042a693f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=587daaeda08de44ce01d7987a1b17d32 2x, https://si.imgix.net/cc99c9fc/uploads/origins/19f6f77a-6b70-4c86-94a3-45e2042a693f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df765dacb1317e7233482131c9ee92ce 3x"}, "body": "くにさん、リクエスト失礼します！\n\nくにさんが描かれるSDイラストの柔らかな色使いや、ころっとしたシルエットのもちもちイラストが大好きです！\nぜひ私の探索者達を描いていただきたいと思い、リクエストさせていただきました。\n\n【資料】\nhttps://drive.google.com/drive/folders/1JhOqDJXuJofbKKWsr1c_EB4nTZaSynvv?usp=sharing\n\n【リクエスト】\n自探索者たちをアニマル化したイラストをお願いしたいです…！\n資料の中からお好きな子を選んで描いてください！\n人数はおまかせします。\n\n・鉛筆風のペンを使用したくにさんのSDイラストが見てみたいので、鉛筆風の線画をリクエストしたいです！\n太さ等は普段通りに、描きやすい形にしていただければと思います‥！\n・パステル調 またはくにさんのお好きな色合いで、明るくまろやかな雰囲気だととても嬉しいです\n(上記について、書きにくいと感じられましたら、これに当てはまらなくても構いません！)\n\nその他詳細はくにさんのセンスにお任せします！\n衣装や装飾も描きやすいよう、自由に改変していただいて構いません。\nくにさんのお好きなように、楽しんで描いていただけたら嬉しいです！\n\n【使用用途】\n-非商用利用・個人観賞用\n・SNSアイコン\n・個人利用でのグッズ化\n・ココフォリア盤面での使用\n・探索者の相方PLへのイラストの共有\n\nご検討いただけますと幸いです！\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JhOqDJXuJofbKKWsr1c_EB4nTZaSynvv?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@404B09/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3365817, "client_id": 3145678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cecd66b5e110215b103ae9a028fd6341", "srcset": "https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cecd66b5e110215b103ae9a028fd6341, https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a870a3ebe7ec9990bf5c92d2e747ee8 2x, https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7982132c001323e4399c195299672238 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33b9b2fa566ad76122861ae15d443ab7", "srcset": "https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33b9b2fa566ad76122861ae15d443ab7, https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49632bb70f9d9bec929a77a8338a763f 2x, https://si.imgix.net/46c8e8c8/uploads/origins/4b2ac553-9bca-49a2-9d66-9d083010b1f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=def5cb7ed73cae4bd4f7581ed87063cd 3x"}, "body": "BOKUさん、リクエスト失礼いたします！\n\nBOKUさんが描かれる、低彩度でまるみを帯びたシルエットの可愛らしいSDキャラクターが本当に大好きです！\nずっとずっとBOKUさんにSDのご依頼をしたいと考えており、この度リクエストさせていただきました！\n\n【資料】\nhttps://drive.google.com/drive/folders/1xPrftOf9AMTGGHXohKEYiWbO927h4NCv?usp=sharing\n\n【リクエスト】\n私の自探索者たちを描いていただきたいです‥！\nお互い特に関係性があるわけではないので、BOKUさんの解釈でご自由に描いていただければと思います。\n個人利用でグッズ化させていただく可能性があるので、それぞれの透過データもいただけますと幸いです‥！\n\nポーズ等はすべておまかせします！\n衣装も描きやすいように変更・省略していただいて構いません。\nBOKUさんのお好きなように、楽しんで描いていただけたら嬉しいです！\n\n【使用用途】\n-非商用利用・個人観賞用\n・TRPGサブ垢でのTwitterアイコン、ヘッダーへの使用\n・ココフォリア盤面へ飾りとして配置\n・個人利用でのグッズ化\n\n料金の不足などありましたら気兼ねなく再送/キャンセルしてください！\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1xPrftOf9AMTGGHXohKEYiWbO927h4NCv?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pakoko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3289801, "client_id": 3145678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8ca8d8c4d8401aa125a68e2cb29dfe", "srcset": "https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af8ca8d8c4d8401aa125a68e2cb29dfe, https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ca06a488d6a28e01c447b0c8d48b119 2x, https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d826f3a9277d8bdb7db9e431e05a256 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19235986e0da96e7055c1ea913942d5f", "srcset": "https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19235986e0da96e7055c1ea913942d5f, https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64838b5388faa276cde8900b8e1015cf 2x, https://si.imgix.net/48ee919b/uploads/origins/4ec27ad3-53e4-41e3-93ef-1facc15fc1bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=780856378ad54861620756d4e6717a9b 3x"}, "body": "パーキング太子様こんばんは、skebを開始されたとのことで早速クエスト失礼いたします！\nパーキング太子様が描かれる洗練されたキャラクターデザインと、筆の質感を残した厚塗り感のあるイラストが大好きです！\nぜひ私の探索者を描いていただきたく、リクエストをお送りさせていただきました。\n\n【資料】\nhttps://drive.google.com/drive/folders/1lpeVrTea7V_rN8olhTdmHHMjrWKzflpI?usp=drive_link\n上記ドライブに資料をまとめました\n２キャラクターおりますが、青髪のほうが今回お願いしたい探索者になります。\n\n【キャラクターについて】\n三鼓 楽(みつづみ がく)というディレッタントの青年です。\n年の離れた二人の兄に甘やかされて育った三男で、普段は投資で得たお金を使って世界中を飛び回り旅をしています。\n甘やかされることに何の抵抗もないですが、優秀でモラルのある兄達に囲まれてまっすぐ育ったので行動は紳士的です。\n性格面での問題はないですが、金銭感覚はお察し・・・かつオカルト的な事象が大好きで、芸術的なものにも目がなく、気に入ったものはどんどんコレクションする収集癖の持ち主です。\n\n【リクエスト】\n見本としてTwitterに上げられていたような雰囲気で、三鼓 楽のイラストをお願いしたいです！\n詳細についてはおまかせいたします。\n(服装についても、そのままでも新しくデザインしていただいても構いません)\nパーキング太子様のお好きなように、自由に描いていただけたらと思います！\n\n完全個人用でグッズ展開させていただく可能性がありますので、可能でしたらそれぞれの背景透過pngもいただけましたら幸いです‥！\n\nまた、もし金額が見合いましたら、相方PCのイラストもどこかに描いていただけたらとても嬉しいです‥！\n（相方PCについても同じくディレッタントで、楽より少し年上ですが仲の良い幼馴染です。\nあまり感情が表に出ることがないクールな性格ですが、楽に対しては面倒見が良いお兄ちゃんのような一面を見せてくれるキャラクターです。)\n金額が見合いません場合は、どうか無理なさらないようにお願いいたします！；；\n\n【使用用途】\n・個人観賞用\n・個人利用でのグッズ化\n・相方PLへのイラストの共有\n・Twitterアイコン、ヘッダーなどへの使用\n\n長文でのリクエスト失礼いたしました。\n料金の不足や不都合などありましたら、再送またはキャンセルしていただいて構いません！\nご検討よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MnRkgk/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2923911, "client_id": 3145678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85bc9a2e1f29806bec03a507fa406118", "srcset": "https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85bc9a2e1f29806bec03a507fa406118, https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84a889689eb91c8ccd8843fcfd602d22 2x, https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6342ef5ec15e1981d3083a4c2f9556c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81361b1f103cbd83c8327cb10fb787b0", "srcset": "https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81361b1f103cbd83c8327cb10fb787b0, https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f547f887889c7daff891967af70fdeb 2x, https://si.imgix.net/7ecd2fdc/uploads/origins/e977b36e-4189-4eca-9bc6-cf2b5cd729ae?bg=%23fff&auto=format%2Cco