-4b74-a9ae-fc4ff9ca473c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=161e99347168f20e7ad77ff1c7a302f3", "srcset": "https://si.imgix.net/acc53c46/uploads/origins/0e643f80-c199-4b74-a9ae-fc4ff9ca473c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=161e99347168f20e7ad77ff1c7a302f3, https://si.imgix.net/acc53c46/uploads/origins/0e643f80-c199-4b74-a9ae-fc4ff9ca473c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3eeb561856cb8aac78531f407992c438 2x, https://si.imgix.net/acc53c46/uploads/origins/0e643f80-c199-4b74-a9ae-fc4ff9ca473c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03627beab58c3308a409c6c3829be788 3x"}, "body": "匿名にて失礼します。\n以下の内容でリクエストいたします。\n\n【キャラクター】\n『ヒーリングっど♥プリキュア』より「花寺のどか」\n\n【シチュエーション】\n　就寝中に襲われ、『美少女戦士セーラームーンS』に登場する「ピュアな心の結晶」を胸から抜き取られてしまったシチュ。\n\n【詳細】\n・アングル\n　正面または斜め前から。\n\n・ポーズ\n　ベッドの上で体を起こされていますが、ぐったりとして力なくヘッドボードにもたれています。\n　手はシーツを掴んでいましたが、力が抜けて緩んでいます。\n\n・表情\n　口は半開き、虚ろな瞳で虚空を見つめています。\n　意識は辛うじて残っているイメージでお願いします。\n\n・服装\n　パジャマ。\n　トップスは前のボタンが弾け飛んだり外れたりして、完全にはだけています。少し脱げかかっていてもOKです。\n　上半身は肌着やブラを着けておらず、バストからお腹まで露わになっています。\n　胸は小ぶりだけど膨らみが分かる感じの描写（大きさは普段描かれている程度）でお願いします。\n　\n　ボトムスは抵抗した際に多少下にずり落ち、ピンクのショーツがチラ見えしています。\n\n・部屋\n　花寺のどかの自室。薄暗く、胸元に輝く心の結晶が辺りを照らしています。\n\n【その他】\nのどかちゃんとピュアな心はそれぞれレイヤーを分けていただけると嬉しいです。\n\n【資料】\n・花寺のどか、自室\nhttps://i.pinimg.com/originals/d1/62/e0/d162e0ab58a5f819557c9d95586e32b8.jpg\nhttps://douga.tv-asahi.co.jp/uploads/attachment/file/58573/61630551-fc0c-4846-a4b9-02b525bc73c8.\nhttps://i0.wp.com/precurematome.com/wp-content/uploads/2020/03/4fajGxD.jpg\n\n・ピュアな心の結晶\nhttps://i.imgur.com/yLdZ2xY.png\n\n・ピュアな心を抜き取る光線\nhttps://i.imgur.com/gViyy2C.png", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pokkegarage/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 103460, "vtt_url": nu