9a7-550bd6dd6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9cd600e1ac63c3a932413aa0f4447b52 2x, https://si.imgix.net/4e7ecd40/uploads/origins/5cdc56e5-be42-4219-99a7-550bd6dd6a82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=addee84ea4bbb88fa20d3108f6b5d2eb 3x"}, "body": "MIKIWO様初めまして。\n\nMIKIWO様のイラストがすごく素敵で今回リクエスト送らせていただきました。\nぜひ活動垢で活動している姿をお願いしたいです。\n\n◆資料について\n→まだ三面図がありませんのでキャラクターデザイン資料と立ち絵、表情、キービジュアルとなります。\n(性別は女の子です)\n\n◆構図\n髪型アレンジ〇です！\n可能であればFPSが大好きなので銃を持たせて欲しいです…！\nまた、見切れないようにお願いできますと幸いです。\n\n◆使用用途について\nVTuber活動（XやDiscordのアイコン、サブ限鯖での公開、スタンプ）で使用します。\nその旨をご了承いただけましたら幸いです。\n\n◆その他\n可能であればレイヤー別にしたPSD形式でお願いできれば幸いです。\n難しい場合はPNG形式での納品をお願い致します。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/1ZtzHOFiPa8SVhtKKeLW2kzCyGvtHKeiU", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikimikiwo_UwU/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3849541, "client_id": 1627320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae6eeafd/uploads/origins/6f2ccd59-c953-458f-b23c-07e731c0c045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=364e4d0c00902cfc6773b96dc7f6d7ac", "srcset": "https://si.imgix.net/ae6eeafd/uploads/origins/6f2ccd59-c953-458f-b23c-07e731c0c045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=364e4d0c00902cfc6773b96dc7f6d7ac, https://si.imgix.net/ae6eeafd/uploads/origins/6f2ccd59-c953-458f-b23c-07e731c0c045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc50c809612a3c24a2e81f6e2c64ae9a 2x, https://si.imgix.net/ae6eeafd/uploads/origins/6f2ccd59-c953-458f-b23c-07e731c0c045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bca61ebd9e5dc926e5988af43ce1c009 3x"}, "duration": null, "nsfw": false, "hardcore": false, "conso