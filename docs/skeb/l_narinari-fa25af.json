.net/d2a03ae2/uploads/origins/cff872b0-5169-48ac-9048-e4c711ac8d98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d168d9ba848116028ce1d993644625b3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2a03ae2/uploads/origins/cff872b0-5169-48ac-9048-e4c711ac8d98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6022a21880c074425141aba7f61fd15c", "srcset": "https://si.imgix.net/d2a03ae2/uploads/origins/cff872b0-5169-48ac-9048-e4c711ac8d98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6022a21880c074425141aba7f61fd15c, https://si.imgix.net/d2a03ae2/uploads/origins/cff872b0-5169-48ac-9048-e4c711ac8d98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8e7dcbe4ddc7795d4f569a05802b16b 2x, https://si.imgix.net/d2a03ae2/uploads/origins/cff872b0-5169-48ac-9048-e4c711ac8d98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3530b2ce2f19c49b82823047c3c54206 3x"}, "body": "始めてリクエストさせて頂きます。\n\n「お兄ちゃんはおしまい」の千川みなと君と桜田ゆうた君のキスシーンのイラストをお願いできるでしょうか。\n肩や腰に手を回したり恋人繋ぎをさせるなど、イチャラブキスのイラストにしてください。\n\n同人誌やpixivでは2人を女装やTSさせていますが、女装やTSなしの2人のキスを描いて頂くことは可能でしょうか。\n男の子同士がNGの場合は違うイラストをリクエストしますので、キャンセルして頂いても大丈夫です。\n\n服装の指定はありませんので制服や下着、全裸など描きやすいものにしてください。\n\nよろしくお願いします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@l_narinari/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 177308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9542690/uploads/origins/f060ca7b-1755-447f-bab2-2e86dcafc903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5017afb088edfffc79a46759ff452110", "srcset": "https://si.imgix.net/e9542690/uploads/origins/f060ca7b-1755-447f-bab2-2e86dcafc903?bg=%23fff&auto=format%2Ccompress&