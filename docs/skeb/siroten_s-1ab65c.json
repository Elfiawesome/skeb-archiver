ive.google.com/drive/folders/1njDdjof1gZGBgsnzkqb-n_awM51hI400?usp=sharing\nhttps://twitter.com/home\n\nポーズや構図等はお任せいたしますが、後記の使用用途があるため少し大きめの画像サイズで描いていただけると助かります。\n\n・使用用途\n個人観賞以外にYoutube、SNSで使用したいため（サムネイル、アイコン等）可能でしたら背景とキャラクター、サインでのレイヤー分けされたpsd形式か透過画像ファイルでも納品頂けますと幸いです。\n\nお忙しいところ恐れ入りますがご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1njDdjof1gZGBgsnzkqb-n_awM51hI400?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siroten_s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2714531, "client_id": 2049215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9796ae22/uploads/origins/c1ffc642-7fc8-46fb-9d88-040a63cf83dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ca7b741513b9be23baa945ea6127ce2", "srcset": "https://si.imgix.net/9796ae22/uploads/origins/c1ffc642-7fc8-46fb-9d88-040a63cf83dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ca7b741513b9be23baa945ea6127ce2, https://si.imgix.net/9796ae22/uploads/origins/c1ffc642-7fc8-46fb-9d88-040a63cf83dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf1f1105dfd10a84dee3605bf6a171b9 2x, https://si.imgix.net/9796ae22/uploads/origins/c1ffc642-7fc8-46fb-9d88-040a63cf83dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9725773b6b69a395af29d63e157754b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9796ae22/uploads/origins/c1ffc642-7fc8-46fb-9d88-040a63cf83dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1837f19e26e3ea6e4058e2543ea5dc0", "srcset": "https://si.imgix.net/9796ae22/uploads/origins/c1ffc642-7fc8-46fb-9d88-040a63cf83dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1837f19e26e3ea6e4058e2543ea5dc0, htt