it=crop&crop=top&w=200&h=200&blur=200&s=ce55947c68b4270b35e4005865e2509e", "srcset": "https://si.imgix.net/989aa938/uploads/origins/c42b4394-0202-4067-96ef-0d5575a835e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce55947c68b4270b35e4005865e2509e, https://si.imgix.net/989aa938/uploads/origins/c42b4394-0202-4067-96ef-0d5575a835e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1dbf093de8af914a02f6ede3b30efaeb 2x, https://si.imgix.net/989aa938/uploads/origins/c42b4394-0202-4067-96ef-0d5575a835e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dea2011299512a2eefc9f6fd2727d2ec 3x"}, "body": "あなたのアートスタイルはとてもキュートだと思う。僕のVTuberのOC、ネコたんの作品をぜひお願いしたいんだ。参考資料のリンクを貼っておきます。ありがとう！\n\nいくつか考慮すべき点があります：\n- 格闘ゲームをする\n- ギャグマンガのキャラクターのように、必ず勝つ（たとえ死んでも、世界のどこかに別の彼が現れる）。\n- 猫でありながらガチャゲーマーでもある。\n- 諸星あたるに似た、ちょっと変態キャラ。\n\nhttps://twitter.com/TannerOfDaNorth/status/1628714515796729857?t=iWGnhUsBdpvvbVvFkG9thw&s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chibi_dora_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777644, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f6bba3d5330ba498b9b8e923ad8060", "srcset": "https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f6bba3d5330ba498b9b8e923ad8060, https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd2ab551deafe3528c4d3d2b02e829d7 2x, https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4811b2c43a1165888aec7dc9405b1678 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d00292684190901a96b0f65cf18759c6", "srcset": "https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d00292684190901a96b0f65cf18759c6, https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff89ae38039e26536e2f128c76659438 2x, https://si.imgix.net/bb927ce6/uploads/origins/ce60bbb3-9deb-414b-8528-a532826676c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=247b325171e52a793f155dc311de139b 3x"}, "body": "宇佐見菫子にグリモワール・オブ・宇佐見(タブレット端末)で「猫型配膳ロボット」を見せてもらい目を輝かせている橙と火焔猫燐。\n菫子は両脚を前方に投げ出して座っており、その後ろに橙と燐がしゃがんでいる。\n橙の目は従来からの書き方(プロフィール画像の仔の様な感じ)、燐の目は最近のツリ目で書いて頂きたく存じます。\n「猫型配膳ロボット」の姿はグリモワール・オブ・宇佐見の上に吹き出しで描写されている\n↓\n細かすぎて伝わらないモノマネの大納言光子さんめいて「猫型配膳ロボット」の真似に興じる橙と燐。\n資料URLの動画の18秒位の所を斜め上からの俯瞰で見ている様なアングル。\n二匹とも https://www.pixiv.net/artworks/67966271 の今泉影狼と同じ凄い三白眼のツリ目・ω型の口の表情(唾液は出ていない)で、服装は二人とも\n・菅牧典の衣服の緑色の箇所を銀色にした物\n・肘まである黒い長手袋\n・白いニーハイソックス\n・頭髪は銀髪になっている\n・顔面全体に墨を塗っている。塗り方にはややムラがあり、地肌の色が少し見える\n・目の周りに白い丸、鼻の下にプリングルスのパッケージめいた白い口ヒゲを書いてある\nというイデタチ。\n二匹の手前を豪徳寺ミケが通り過ぎ、振り返って驚いている(彼女の表情は描写しないで下さい)\n\nという2コマ構成の作品を所望します。\nなお、2コマ目は https://twitter.com/Chibi_dora_/status/1741835106858463374/photo/1 の様な線太目でカッチリした塗りで書いて頂きたく存じます\n\nhttps://www.youtube.com/watch?v=cMEmQmXCL7g", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chibi_dora_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777644, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c89e0af0a6a8c34d1abbdf88a49d0be7", "srcset": "https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c89e0af0a6a8c34d1abbdf88a49d0be7, https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61f7924e7cc0e61f3bcffeb1aba5250c 2x, https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e0249d40801ff335fa23761dea7e04b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4788ca26a4d0f4989c85c2856a2e7bd3", "srcset": "https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4788ca26a4d0f4989c85c2856a2e7bd3, https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49846fcf37e24f02e6c623e8996edf3b 2x, https://si.imgix.net/199df6ef/uploads/origins/668515e5-1d4f-4e34-b91a-8d0cf353b560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=afa290989e8325c11cd22214e042405b 3x"}, "body": "今年「悪魔城ドラキュラX 血の輪廻」はリリース30周年を迎えるという事で、アニバーサリー絵として歴代のマリア・ラーネッドが勢揃いした作品を所望します\n・正方形のカンバスが対角線で四等分されていて、中央にはいつもの「血の輪廻」版のマリア(フルカラー)。\n対角線に沿う様に両腕・両脚をナナメ前方にX字状に突き出し、右手の三本の指と左手のOKサインで「30」のハンドサインを作っている。\n表情は(｀>ワ<´)の様な元気一杯の笑顔で、彼女はこの作品の様な主線太目で勢いのある感じで描いて頂きたく存じます: https://www.pixiv.net/artworks/26044898\n・上側の区画には黒背景に「Castlevania X 30th Anniv.!!!」の文字。Xは原作ロゴのそれを模して頂きたく存じます\n・向かって左側の区画には白背景にパステルピンクのモノトーンで描かれた「ドラキュラXクロニクル(DXC)」版と「Harmony of Despair」版のマリア。\n中央寄り手前にいるDXC版マリアは使い魔の白虎を抱え、笑顔で目線を輪廻版マリアに向けている。\n端寄り奥にいるHoD版マリアは口元で両手を組んで祈る様な仕草をし(口は組んだ手で完全に隠れている)、片目を閉じてもう片方の目の目線は輪廻版マリアに向いている。\n・向かって右側の区画には青緑色の背景に青緑色のモノトーンで描かれた「月下の夜想曲」版と「XX」版のマリア。\n中央寄り手前にいる月下版マリアは身体全体を真横に向け、口元に微笑みを浮かべて目線だけを輪廻版マリアに向けている。(彼女のみ他のマリアよりも頭身高めで描いて頂きたく存じます)\nXX版マリアは月下版マリアの奥からひょっこりと顔を出し緊張の面持ち。身体・目線は真正面を向き、両手は面接の時めいて身体の前で重ねている\n・下側の区画には赤背景に赤のモノトーンで描かれた「Judgment」版マリア。\n俯瞰気味のアングルで、両手で得物の杖(鳥は入っていない)を構え、輪廻版マリアの足元に追いやられたせいか不服そうな表情(頭部横側に怒りマークを伴っている)で彼女に目線を向けている\n\nhttps://twitter.com/sedaoseda/status/1634667469985177600", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chibi_dora_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 777644, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=568504fe6f75322e7f29fb5e963980b8", "srcset": "https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=568504fe6f75322e7f29fb5e963980b8, https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d45f537d9a4fcc096ea0182c59b59a68 2x, https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb06919e3ba7849df91cecc3f67f2589 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fa4ec0453484ee4d4fda069c7f0e818", "srcset": "https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fa4ec0453484ee4d4fda069c7f0e818, https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1b1ca9e3d42479b8006d38e797a238c 2x, https://si.imgix.net/7b11e77c/uploads/origins/172f7080-e7a7-463e-ab49-8725bf4cdbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6be4b880f75a0af5937be9997803d58b 3x"}, "body": "毎度同じキャラクターですみませんが、道化師に扮した「悪魔城ドラキュラX 血の輪廻」のマリア・ラーネッドが玉乗りをしている絵を所望します\n道化師の衣装は「聖剣伝説3: Trials of Mana」のシャルロットのダボっとした衣服から前掛け(？)やマントを取り除き、代わりにヒダ襟(中世ヨーロッパ貴族が付けている分厚いシャンプーハットの様な奴)を首元に付け、クラウンピースの衣服と同じ星条旗模様の衣服にした物で、帽子はシャルロットの物の柄をクラウンピースのそれと同じ紫地に白い水玉模様にして先端のポンポンを単純な白い球体にした物、靴もドナルドの様な爪先が過剰に長く伸びた物で、顔面は白塗り+右目に十字模様、鼻には赤い球体を付けた道化師の化粧にして下さい\nポーズは片脚を水平に上げてもう片方の脚一本で球体(いわゆる「マジカル☆さくやちゃんスター」(白い一つ星が描かれた青い球体))の上に乗り、両腕を水平に広げてバランスを取っています\nまた、可能ならば白塗りや十字模様の化粧が無く鼻の赤い球体だけを付けている状態の奴、及び赤い球体も付けていない素顔の状態の奴を差分として用意して頂く事は可能でしょうか\n\nhttps://mobile.twitter.com/sedaoseda/status/1598425543254609920", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chibi_dora_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777644, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fefbe264042d6e1068c02109fde4c960", "srcset": "https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fefbe264042d6e1068c02109fde4c960, https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=505a30fb4f6850b26d45a7618b25d8dc 2x, https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d379e91b4988465357cf971be1f5a418 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e14b7e57d71827970e282190be695b7a", "srcset": "https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e14b7e57d71827970e282190be695b7a, https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0ade9b69d96588ddb14acdb2c56e829 2x, https://si.imgix.net/327c0faf/uploads/origins/d619f15b-11cc-4b5b-b294-a9d45eb62e9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90a5af96857ca17f651c882cb2f9881a 3x"}, "body": "どこぞのビーチ的な場所に、人魚になった「悪魔城ドラキュラX 血の輪廻」のマリア・ラーネッドと「悪魔城ドラキュラ 奪われた刻印」のシャノアがいる。\n　マリアは画面左手前で両腕を力一杯振りながら脚ヒレを用いてぴょんぴょんと飛び跳ねて走っている。彼女の脚ヒレは原典における彼女のドレスと同じ様なピンク色で、人間部分と魚部分の境界や尾びれはリトルマーメイドのアリエルの様な形状になっている。また、胸にはパステルピンクの貝殻の水着を、頭にはリボンの代わりに赤い星形の髪飾りを付けており、力んでいる様な表情をしている。(目は開いている)\n　Shanoaは画面右奥で岩に腰かけている。彼女の脚ヒレは原典における彼女のスカートの色をもう少し鮮やかにした様な紺色で、人間部分と魚部分の境界や尾びれは波打ち際のムロミさんの様な形状になっている。また、胸にはサラシを巻いて腕を組み、右手には何かしらの赤い液体が満たされた水色の貝殻の盃を手にし、ジト目気味の真顔でマリアの方を見ている。\n　なお、今回のShanoaの目は https://twitter.com/chibi_dora_/status/1406610022017105921?s=21 のみす丸さんと同じ様な黒目中央が白くなっている描写にして下さい\n\nhttps://twitter.com/sedaoseda/status/1400770386069909509?s=21", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chibi_dora_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 777644, "client_id": 128546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=617102214ef40ea7cdca90012b4273b6", "srcset": "https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=617102214ef40ea7cdca90012b4273b6, https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33bcc64c40df716aafbf784767729a33 2x, https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1844c36a30dcd17866fd21a3d2ba4aca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10b2f6e2918c9fa7329616d402b4b1a", "srcset": "https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f10b2f6e2918c9fa7329616d402b4b1a, https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b00e1e3be23920430d85e38ed70d8d1d 2x, https://si.imgix.net/2bb33834/uploads/origins/f0f76bbb-05f2-4559-b519-bacd3a9d09ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cro