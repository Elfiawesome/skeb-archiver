れている人を妬んでいる。\n短気で暴力的。口も素行も頭も悪い。武器はナイフを使う。\n\n🍓ストロベリー・チーズタルト\n14歳145cm\n美少女￤小さい￤幼め\n皆が欲しがる美少女。裕福な家で生まれ父と兄からの歪んだ愛情を浴びて育つ。目の前で家族を殺されるも🍪を運命の王子様だと思い込み着いて行ってしまう。🍪に異常に依存している。\n\nhttps://drive.google.com/drive/folders/1XujmGTndtFdmarewqfxubWTYfaanAVUZ", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mamimu3mumi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 103028, "client_id": 1622191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21e10142/uploads/origins/f476f53b-b7a2-4815-89a9-4303775c51c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeacf0e4f101b7fa5c36af52ffbbfdb4", "srcset": "https://si.imgix.net/21e10142/uploads/origins/f476f53b-b7a2-4815-89a9-4303775c51c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeacf0e4f101b7fa5c36af52ffbbfdb4, https://si.imgix.net/21e10142/uploads/origins/f476f53b-b7a2-4815-89a9-4303775c51c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18a48d569802935bb527ed7b13c2ce49 2x, https://si.imgix.net/21e10142/uploads/origins/f476f53b-b7a2-4815-89a9-4303775c51c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a89bc0b8bd63f3abcd05b0d65fe7dcf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21e10142/uploads/origins/f476f53b-b7a2-4815-89a9-4303775c51c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03be793c019468ceaa8eba5a8e9621a1", "srcset": "https://si.imgix.net/21e10142/uploads/origins/f476f53b-b7a2-4815-89a9-4303775c51c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03be793c019468ceaa8eba5a8e9621a1, https://si.imgix.net/21e10142/uploads/origins/f476f53b-b7a2-4815-89a9-4303775c51c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w