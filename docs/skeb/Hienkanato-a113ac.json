7-a41f-c37426c4c8ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2b1de83d116eca0444b80e140d191b7, https://si.imgix.net/7f58b582/uploads/origins/5ef2f5aa-dac3-4cf7-a41f-c37426c4c8ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=392a1301213c371ea1c5be4612721d93 2x, https://si.imgix.net/7f58b582/uploads/origins/5ef2f5aa-dac3-4cf7-a41f-c37426c4c8ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca1e21af2df15bd08e91b04514684657 3x"}, "body": "アピールありがとうございます\n遅くなりましたが、ガルパンのアズミのイラストをリクエストします\nアズミの服装は、長さは膝の辺りまで丈の長いサイドジップのロングブーツを履いた私服姿でブーツ以外の私服はお任せします\n\nアズミは玄関にいて、ブーツが雑に置かれていることに怒りながらも、自分の片足のブーツのファスナーを下げてブーツを脱ごうとしている状態でお願いします\nアズミのもう片方の足は既にブーツを脱いでいる状態でお願いします\n玄関に置かれているブーツは下記の通りお願いします\n・雑に置かれた履き口に白いファーが付いたロングブーツ\n・雑に置かれたロングブーツ\n・両足が二つ折りになって綺麗に置かれているロングブーツ\n(玄関に置かれているロングブーツはアズミのブーツとは別物、ブーツの色はお任せします)\n\n以上よろしくお願いします", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hienkanato/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3461354, "client_id": 3113568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c1188e85603a079cc6c165d2138cf42", "srcset": "https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c1188e85603a079cc6c165d2138cf42, https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1ef93e4137d49ae6f11d1d76b56a66c 2x, https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da6483b91c249407d011ec8668bcf383 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b6b2203facaceb644bd965015220eba", "srcset": "https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b6b2203facaceb644bd965015220eba, https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=374576e061a07aedf5cf3d27fa1e95aa 2x, https://si.imgix.net/9d89802f/uploads/origins/1c451691-e76e-471c-935d-5ce4dbbd2143?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9b8732ee2d007fc25cae67475e111fe 3x"}, "body": "Hienkanatoさん、こんにちはです。\n私がコンフリクトガール大好きなのはまさしくその通りなのですが、\nHienkanatoさんに自分がリクエストするならで思い浮かんだものがあったので、そちらで依頼させて頂きたいです（かなり特殊な内容かも…）\n\nエネルギー管理士という工場等のエネルギー使用を合理化、管理する資格があるのですが、この資格を可愛い女の子に擬人化したイラストを1枚描いて頂けるでしょうか？\n世間ではウマ娘や艦隊これくしょん等といった作品で競走馬や戦艦を可愛い女の子に擬人化したものがありますが、それをエネルギー管理士という資格でやってみて欲しいと思いました。\n\nエネルギー管理士、通称・エネ管なのですが「えねかん」と書くとなんか可愛らしい気もします(笑)\nリクエストがあまり具体的でなく描きづらいかなとも思われますが、例えばエネルギー管理士の参考書の表紙イラストの依頼が出版社から来て、それが可愛い女の子を1名描いてくださいみたいなイメージだと思ってくだされば…\n\nこれは物理の参考書ですが、この女の子が物理をイメージして描かれてると思われるように\n「えねかん」をイメージして描いて頂けたら！！\nhttps://realsound.jp/wp-content/uploads/2023/02/20230205-gakusan01.jpeg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hienkanato/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3461354, "client_id": 1010830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5cf2107/uploads/origins/523bd85f-844b-4dab-9dbd-0a1e2bed56d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop