a3-4150-9608-5de1b086768a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca052d26ff702320c07a1817e0b59b40", "srcset": "https://si.imgix.net/2a8be822/uploads/origins/3078ea47-a1a3-4150-9608-5de1b086768a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca052d26ff702320c07a1817e0b59b40, https://si.imgix.net/2a8be822/uploads/origins/3078ea47-a1a3-4150-9608-5de1b086768a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb90964ae8d56e40a7aab790e16c100 2x, https://si.imgix.net/2a8be822/uploads/origins/3078ea47-a1a3-4150-9608-5de1b086768a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0cea4d565eadd18d7fd54a196333691 3x"}, "body": "胸ぐらを掴まれた夕ナ卜がループタイを相手の小指に結ぶ作品をお願いいたします。\n\n《夕ナ卜 / 橋本 夕（ハシモト ユウ）》\n【容姿、性格】\n髪、瞳、肌は灰色。つり目つり眉。口内は黒。\n瞳孔が散大している。睫毛、下睫毛が長い。\n瞳のハイライトがうるさいほどに眩しい。\n無性、内臓がなく、血は虹色。\nループタイを着けたオシャンな服装。\n大体フィクション、紙ペラ以下の存在。\n「運命」という単語を好んで使うが、運命自体を好むわけではない。むしろ響きを茶化している。\n誰かの特別（運命）になりたがり、そのくせ自分の特別（運命）は作らない。\n何事においても集中力がない。話し掛けられている最中でも別のことに興味を持つし、その物事もしている間に飽きてくる。\n\n【場面】\n何かしらで誰かを怒らせた、はず。特段興味はなかったので忘れた。\n胸ぐらを掴まれた、ので視界に相手の指が入った。\nせっかくだし巻き付けてみることにした。\n\n【構図、表情】\n胸ぐらを掴む側視点。\n近距離。睫毛の煌めきが見えるほど。\n自身の小指に結び付けられた赤いループタイが見える。運命ごっこの対象にされたようだ。\n視線は完全にこちらを捉えている。強く開かれた瞳孔に怒る気力も吸い込まれてしまいそう。\nヘラりと笑う。真面目に話を聞いてもいないし、結んだことにも徐々に飽き始めている。\n「ごめん聞いていなかった、何？」などと問いかけてくるが、答えを求めているわけではないらしい。\n\nhttps://xfolio.jp/portfolio/AisaiNyawo/series/2434757", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mogumoguritto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3140761, "client_id": 3436783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c7ea1f2/uploads/origins/5fb7087d-b295-43dd-a2b2-011c7ab2a83d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb20d1a6bf1969806e7233b1855c9e18", "srcset": "https://s