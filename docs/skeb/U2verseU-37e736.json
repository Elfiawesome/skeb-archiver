 \"デフォルメ \"フォルダに、カドマスの見た目の参考資料があります！\n- ポーズと背景のリファレンスはあくまで参考ですので、お望みであれば、ポーズをすべてご自分で作っていただいても結構です！\n\nありがとうございました！🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1pe2sQiP_7_DJrjBfcag675CL9X6P8Azj", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@U2verseU/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3268710, "client_id": 2940548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8b4f918/uploads/origins/096331b1-5a2a-43f0-8470-818ea12a6c40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6bbe319275ed9c480ac8562c620e43e", "srcset": "https://si.imgix.net/c8b4f918/uploads/origins/096331b1-5a2a-43f0-8470-818ea12a6c40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6bbe319275ed9c480ac8562c620e43e, https://si.imgix.net/c8b4f918/uploads/origins/096331b1-5a2a-43f0-8470-818ea12a6c40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25290eaca88c573d067fde4b45cb5551 2x, https://si.imgix.net/c8b4f918/uploads/origins/096331b1-5a2a-43f0-8470-818ea12a6c40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a727d87a621eb15879d21eae649cc717 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8b4f918/uploads/origins/096331b1-5a2a-43f0-8470-818ea12a6c40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3935dfa639906367042be2b12a20a5cd", "srcset": "https://si.imgix.net/c8b4f918/uploads/origins/096331b1-5a2a-43f0-8470-818ea12a6c40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3935dfa639906367042be2b12a20a5cd, https://si.imgix.net/c8b4f918/uploads/origins/096331b1-5a2a-43f0-8470-818ea12a6c40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2420b86d644ca65262a79a96dd29b31