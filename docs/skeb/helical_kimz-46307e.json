ruUNa8MEIwjXiodegLgWkUW8DR1dyPt8?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@helical_kimz/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3599342, "client_id": 3741973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f187bb6b7da1a72101b8daf63a609c7", "srcset": "https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f187bb6b7da1a72101b8daf63a609c7, https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fba7567c601c1996b2a8f2d6ae6d074a 2x, https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95d870611a4941821f9adf5d7f7f290d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37e6794135c156fc2f412dad60897340", "srcset": "https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37e6794135c156fc2f412dad60897340, https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d3305716ccf5cb4112befbd1d85ecc 2x, https://si.imgix.net/bcf8a93e/uploads/origins/50e7e0ab-72ea-40dd-86a7-1435d1be5b7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c24453abd1395c1706022b4f23b49ad3 3x"}, "body": "私は日本語を話すことができないので、この依頼には翻訳サービスを利用しています。言いにくい表現があるかもしれませんが、ご容赦ください。\n\nこんにちは。依頼したい内容を説明させていただきます。\n\n描いていただきたいのは、映画「エイリアン」のスラコ号とエンデバー号を融合させたデザインの宇宙船です。船名は「UNS Almayer」です。\n\nこのリンクから内部の俯瞰図を見ることができますが、内部地図なので外形の一部しか見えません：\nhttps://tunguso4ka.github.io/map-viewer/?map=Almayer\n\n参考までに、エンデバー号の画像はこちら：\nhttps://www.artstation.com/artwork/xYenbY\n\nスラコのモデルはこちら：  \nhttps://www.hollywood-collectibles.com/HCG-Exclusive-Aliens-USS-Sulaco.html\n\nさらに、他のコロニアル海兵隊の船はここにある（角度が良くないが、参考までに）：  \nhttps://www.avpcentral.com/colonial-marine-ships\n\nアルメイヤー号は約200名の人員を収容できる大型船である。\n\nご希望のイラストには、船体の「横顔」（側面から見たもの）を解像度1920x1080px以上でご提供ください。また、船体側面に「Almayer」の名前が見えるようにしてください。可能であれば、背景を入れるか、青写真／テクニカルスケッチ風にレンダリングしていただけると大変ありがたいです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@helical_kimz/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3599342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbed2627aad8ed646a479052568d3db8", "srcset": "https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbed2627aad8ed646a479052568d3db8, https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aca6967464f526a2cde2506dfc3263cd 2x, https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e04e3536e0ea2c5edcc8ede984514b88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9867585cb96b31f7e3f5cfe8c44e473b", "srcset": "https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9867585cb96b31f7e3f5cfe8c44e473b, https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32166fc238d9426624b199db46258732 2x, https://si.imgix.net/5ec3d96c/uploads/origins/e86365e8-d5cf-4ebb-8329-3e7ec9c112e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5064e6302ada938ff21e53c2b0fcee2 3x"}, "body": "へりかる様へ。\nへりかる様の絵を拝見し依頼したく思いましたのでリクエストを送らせて頂きます。\n確認お願い致します。\n\n・リクエスト\nPS2版ゲーム宇宙戦艦ヤマトに登場する春藍の改造艦の絵図\n\nコンセプトは「安い春藍」\n大火力戦艦を艦隊に複数配備したいけど春藍そのままではお高いので安めにして数を揃えたい、というイメージ\n\n波動砲×3\n完結編主力戦艦の拡大波動砲イメージの若干小型化したものに交換\n艦体幅縮小を企図\n\n主砲\n3連装砲×5\n艦首側2、艦尾側2、艦底側1で配置は春藍と同じ\n砲塔形状は元のアンドロメダに近いシンプルな形状\n\n副砲\n無し\n全撤去\nこれに伴って左右の張り出しは縮小、翼状構造物やエアインテーク状構造物も無し\n\n対空火器(パルスレーザー)\n3連装×4\n連装×2\n艦橋脇の3連装と艦橋左右の連装はアンドロメダや主力戦艦と同じ\n艦体下部側左右にもいい感じに3連装を装備\n\n艦橋\n元のアンドロメダ(旧作版)に近いイメージ\n左右の耳の部分を若干左右に広げて大型化\n艦橋後ろの謎の構造物は撤去\n\n艦体\n春藍に比べて少し細め、エンジンはメイン×1、サブ×4の元のアンドロメダに近いイメージ\n塗装は完結編戦艦風\n\n・構図\n1、フジミ製プラモデル 1/500 旧日本海軍幻の戦艦 超大和型戦艦の箱絵の構図をモチーフに、戦闘していない状態で宇宙空間を航行している場面\n随伴艦として完結編駆逐艦(主砲を12.7cm連装砲イメージの小型のものに交換、艦底側にも1基追加した架空のもの)を箱絵の松型駆逐艦の位置に配置してください\n\n2、低コスト春藍の側面図と上面図\n図鑑風の感じでお願いします\n\n以上をお願いします。\nお忙しい中恐れ入りますが検討お願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 90338, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "千早ふる", "screen_name": "Full_chihaya", "avatar_url": "https://pbs.twimg.com/profile_images/1606506538503270400/Ua40w-jD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/716977205448867840/177808