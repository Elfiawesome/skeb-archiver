ス魔。\n瞼が重そうなタレ目とツリ眉、尖った犬歯がチャームポイント。\n────────────\n◎二人の関係\n犯罪者仲間。悪友。\n肉体関係あり(リバ）。男子高校生みたいなノリのおじさんたち。\n放っとくとお互い悪ふざけしてずっとゲラゲラ笑っている。\n必要に応じて恋人じみた距離感でイチャつくこともできる。\nあくまで悪ノリであって、恋愛感情はゼロ。\n＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n\n可能であれば「二人で食事をしているシーン」もしくは「二人で悪だくみをしてほくそ笑んでいるシーン」を描いていただけるとうれしいですが、それ以外のゆうたさんの描きやすいシチュエーションでもかまいません！\n服装、構図などはお任せします！表情やポーズなどもお好きなだけ（コミカルに）崩していただいてかまいません！\n\nご検討の程宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/1bv7FYL9Xbn36WNNL5OG8Gz16SpzfrgKf?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpgNu01/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2895535, "client_id": 1673174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cbd382d/uploads/origins/ac737553-e9d7-49e4-abb4-20aa9e8eeb78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030bb4b40b7a00e2d151329e9734b82a", "srcset": "https://si.imgix.net/4cbd382d/uploads/origins/ac737553-e9d7-49e4-abb4-20aa9e8eeb78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030bb4b40b7a00e2d151329e9734b82a, https://si.imgix.net/4cbd382d/uploads/origins/ac737553-e9d7-49e4-abb4-20aa9e8eeb78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9821f1a97f947767a92014e94f0c5b41 2x, https://si.imgix.net/4cbd382d/uploads/origins/ac737553-e9d7-49e4-abb4-20aa9e8eeb78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c71b9d2f7ca28bf6b0ca752a2c52761f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cbd382d/uploads/origins/ac737553-e9d7-49e4-abb4-20aa9e8eeb78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b665e3c382471db3c62b9afc7ff8155", "srcset": "https://si.imgix.net/4cbd382d/uploads/origins/ac737553-e9d7-49e4-abb4-20aa9e8eeb78?bg=%23fff&auto=format%2Ccompress&fm=webp&f