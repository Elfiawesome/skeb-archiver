ther activities.\n\nSize\nPlease use 1920x1080 or larger.\n\nOther \u25c6 \u25c6 Other\nWe would appreciate it if you could provide us with data with separate layers for backgrounds, figures, etc.\n\n\nWe are very sorry for your busy schedule, but we would appreciate it very much.", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 510616, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "\u305f\u304f\u307f", "screen_name": "0taku0", "avatar_url": "https://pbs.twimg.com/profile_images/1321833308674695169/3t-WCoXw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/91051075/1595153664/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 129}, {"id": 536890, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "\u30c1\u30ad\u30f3\u30ab\u30ec\u30fc", "screen_name": "ChickenCurry_V", "avatar_url": "https://pbs.twimg.com/profile_images/1714011180984090624/qjZ6TQdq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1064466185364791296/1697487085/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 32}, {"id": 560681, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "\u3042\u304a\u3044\u30a4\u30aa", "screen_name": "aoichan_io", "avatar_url": "https://pbs.twimg.com/profile_images/1580135055695151105/CdUT3bFR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1212070507907973120/1773134857/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_mast