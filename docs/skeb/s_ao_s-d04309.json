9\u3055\u3093\u306e\u63cf\u304b\u308c\u308b\u30a4\u30e9\u30b9\u30c8\u306e\u7d75\u67c4\u3084\u5857\u308a\u304c\u3081\u3061\u3083\u304f\u3061\u3083\u597d\u304d\u3067\u3059\ud83d\ude0a\ud83d\udc95\nskeb\u3092\u958b\u3044\u3066\u3044\u308b\u3053\u3068\u3092\u77e5\u3063\u3066\u662f\u975e\u3068\u3082\u983c\u307f\u305f\u3044\u3068\u601d\u3044\u30ea\u30af\u30a8\u30b9\u30c8\u9001\u3089\u305b\u3066\u9802\u304d\u307e\u3057\u305f\uff01\n\n\u3010\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\u3011\n\u3007\u4e00\u6b21\u5275\u4f5c(\u30aa\u30ea\u30b8\u30ca\u30eb)\u7537\u6027\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30a4\u30e9\u30b9\u30c8 \n\n\u30ad\u30e3\u30e9\u306f\u6b63\u9762\u53c8\u306f\u5de6\u5411\u304d(\u2190)\u3067\u3001\u80cc\u666f\u3092\u63cf\u304f\u969b\u306f\u591c\u306e\u5ec3\u6559\u4f1a\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u305d\u306e\u4ed6\u306f\u3042\u304a\u30fc\u305f\u3059\u3055\u3093\u306e\u597d\u304d\u306a\u3088\u3046\u306b\u63cf\u3044\u3066\u4e0b\u3055\u3063\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\n\u25cb\u30a2\u30a4\u30b3\u30f3\u53c8\u306f\u30d8\u30c3\u30c0\u30fc\n\u25cb\u7f36\u30d0\u30c3\u30b8\u3084\u30dd\u30b9\u30ab\u7b49\u306e\u500b\u4eba\u7528\u306e\u30b0\u30c3\u30ba\u5236\u4f5c(\u5546\u7528\u5229\u7528\u306a\u3057\u3067\u500b\u4eba\u7528\u306e\u307f)\n\u540d\u524d\u3068ID\u3092\u8868\u8a18\u3057\u305f\u4e0a\u3067\u4f7f\u7528\u3055\u305b\u3066\u9802\u304d\u305f\u3044\u3068\u601d\u3063\u3066\u304a\u308a\u307e\u3059\u3002\n\n\u3010\u5e0c\u671b\u7d0d\u54c1\u5f62\u5f0f\u3011\nPSD\u5f62\u5f0f\u3067\u4eba\u7269\u3068\u80cc\u666f\u306e\u30ec\u30a4\u30e4\u30fc\u3092\u5206\u3051\u3066\u9802\u3051\u308b\u3068\u52a9\u304b\u308a\u307e\u3059\u3002\u3082\u3057\u53ef\u80fd\u3067\u3057\u305f\u3089\u3067\u5927\u4e08\u592b\u3067\u3059\u3002\n\n\u30ad\u30e3\u30e9\u8cc7\u6599\u7b49\u306f\u3053\u3061\u3089\u306b\u306a\u308a\u307e\u3059\u3002 \n\u300a\u7279\u5fb4\u8a73\u7d30\u300b\n\u3010\u808c\u8272\u3011\u8910\u8272\u808c(\u8d6