=200&s=b2541bb9d52d9f4c8fb654cc7146aae6 3x"}, "body": "いつも可愛い朝日さんのイラスト拝見させて頂いております。\n\n艦これのポーラちゃんが好きで、ふんわり系なのがイラストイメージに合いそうなので、リクエストさせて下さい。\n\nキャラは艦これのポーラ\nご存知だと思いますがwikiのリンク記載します\nhttps://wikiwiki.jp/kancolle/Pola\n\nこちらのイラストみたいな、シンプル？パイズリで濃厚らぶらぶ風味なの希望です。\nhttps://media-uploader.work/?mode=detail&id=14697&original=1&key=10469d22-67ba-4f11-a0fd-3851db3111eb\n\n以下は希望要素です\n\n・おっぱい特盛\n\n・ち〇ぽマグナムサイズ\n\n・ハートマーク\n\n・服装は裸に、首元に原作と同じようなリボンとか、首輪とか\n\nご検討宜しくお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poyoooonrikuo2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3325039, "client_id": 448481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9adebcbb84f7d03e3f51f8b798088280", "srcset": "https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9adebcbb84f7d03e3f51f8b798088280, https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d73f61f8caac59891445dfbeda17d6aa 2x, https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad92b266f53f8c3271a27885be92c693 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e0d19f20c7ec30df28dbcb19d7d2ef9", "srcset": "https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e0d19f20c7ec30df28dbcb19d7d2ef9, https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c1382bf9ec282988d0da4c48b7c136b 2x, https://si.imgix.net/9ca4e4f7/uploads/origins/33c67bcc-e17a-42cb-9d38-81b7c14224a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1c6da7e29bce2ba6479a219c2fc94b1 3x"}, "body": "艦これの朝日と提督がぶつかった拍子に身体が入れ替わり、朝日になった提督が姿見鏡を見ながら両手で胸を揉んでいるイラストをお願いいたします。\n・構図は朝日(中身は提督)の一人称視点\n・提督(中身は朝日)の描写は不要です\n・胸を揉むうちに気持ちよくなりとろけた表情\n・朝日の顔からは吹き出しで中身である提督の顔を描いてください(制帽を被った男性とわかる程度で細かな表情は不要です", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poyoooonrikuo2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3325039, "client_id": 1042065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ce66703/uploads/origins/ae55c01a-5b32-4515-b877-f41f70e67951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987780c7c558f1653d831b34f703b283", "srcset": "https://si.imgix.net/7ce66703/uploads/origins/ae55c01a-5b32-4515-b877-f41f70e67951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=987780c7c558f1653d831b34f703b283, https://si.imgix.net/7ce66703/uploads/origins/ae55c01a-5b32-4515-b877-f41f70e67951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0886ac88ab62c97d8c7e11bf75e604a5 2x, https://si.imgix.net/7ce66703/uploads/origins/ae55c01a-5b32-4515-b877-f41f70e67951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95350cba94dcd3c90aea353c1a18ef99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ce66703/uploads/origins/ae55c01a-5b32-4515-b877-f41f70e67951?bg=%23fff&auto=format%2Ccompress