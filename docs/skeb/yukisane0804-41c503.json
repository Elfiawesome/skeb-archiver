たような態度をとりがちの捻くれた皮肉屋。ただ根がポンコツなのでいまいちカッコつかない。\n異性が苦手で露骨に避けている（同性とは気安く距離を詰める）。年下の男の子にめっぽう甘い。\n医師免許持ち。色々あってヤクザと懇ろの闇医者。ポンコツ。\n\n資料が少なく大変申し訳ないのですが、服装は何となくオシャレなハイブランドっぽい感じで？お願いいたします。（ふわふわ過ぎてすみません……）\n\nhttps://drive.google.com/drive/folders/1BYT80bPz7kFXMrp2teBB_Kjr3YIn0-HA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Evild_Evifry/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2741106, "client_id": 2545951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5333649b/uploads/origins/2606adb0-fb1f-46d3-b15f-53a057f45106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85716bc45b754e005e5e9da067b28d4", "srcset": "https://si.imgix.net/5333649b/uploads/origins/2606adb0-fb1f-46d3-b15f-53a057f45106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85716bc45b754e005e5e9da067b28d4, https://si.imgix.net/5333649b/uploads/origins/2606adb0-fb1f-46d3-b15f-53a057f45106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b5bf12d59885e707c81dd65892f9e10 2x, https://si.imgix.net/5333649b/uploads/origins/2606adb0-fb1f-46d3-b15f-53a057f45106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4aab4ad047030293b100379d107ba89c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5333649b/uploads/origins/2606adb0-fb1f-46d3-b15f-53a057f45106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0895f51d9f693e32c10fe4e163bc950", "srcset": "https://si.imgix.net/5333649b/uploads/origins/2606adb0-fb1f-46d3-b15f-53a057f45106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0895f51d9f693e32c10fe4e163bc950, https://si.imgix.net/5333649b/uploads/origins/2606adb0-fb1f-46d3-b15f-53a057f45106?bg=%23fff&auto=format%2Cco