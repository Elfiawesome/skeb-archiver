puApHtsEiURvRIO/view\n\nポイント１．お顔のブラッシュアップ\n    輪郭、髪の分け目、大きさを整えて、より可愛く、スタイリッシュにできますでしょうか\n\nポイント２．バランス感覚の調整\n    左右にナナメ縦線っぽい何かを加えることで、\n    よりシュッっとカッコイイ感じにできますでしょうか\n\nポイント３．シチュエーションの追加\n    何かを切った後のようなシチュエーションを追加できますでしょうか\n    （絵を俯瞰してみて見て、イメージ図のような「X」字の構図ができあがると嬉しいです）\n\nポイント４．全体的なデティール追加\n    全体的な質感アップに挑戦してみていただけないでしょうか\n    （うっすらお顔のチークを追加したり、刀に光芒を追加したり等）\n\n以上、もしご対応いただけたら、とても嬉しいです", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GrayLo_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2597900, "client_id": 2027595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf476445/uploads/origins/594a213e-90de-4c6a-bbac-9da146960814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90ec89e5d882e734b0088299560d5e38", "srcset": "https://si.imgix.net/cf476445/uploads/origins/594a213e-90de-4c6a-bbac-9da146960814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90ec89e5d882e734b0088299560d5e38, https://si.imgix.net/cf476445/uploads/origins/594a213e-90de-4c6a-bbac-9da146960814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2e8f651f441ddbdf95a11b4f3b3f182 2x, https://si.imgix.net/cf476445/uploads/origins/594a213e-90de-4c6a-bbac-9da146960814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6e2f534249f6038ef051c278db970b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf476445/uploads/origins/594a213e-90de-4c6a-bbac-9da146960814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95330590e05c9d0992e9f4da45ebee88", "srcset": "https://si.imgix.net/cf476445/uploads/origins/594a213e-90de-4c6a-bbac-9da146960814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95330590e05c9d0992e9f4da45ebee88, https://si.i