\u30ea\u30af\u30a8\u30b9\u30c8\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u2605\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u2605\n\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u4e16\u754c\u89b3\u3067\u306e\u5192\u967a\u63a2\u7d22\u4e2d\u3001\u5b9d\u7bb1\u8ca1\u5b9d\u3092\u63a2\u3057\u3042\u3066\u4ef2\u9593\u9054\u3068\u6cb8\u304d\u559c\u3073\u5206\u304b\u3061\u5408\u3046\u30a4\u30e9\u30b9\u30c8\n\n\u2605\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u2605\n\u53c2\u7167\u753b\u50cf\u2460\u30ea\u30f3\u3092\u30e1\u30a4\u30f3\u3068\u3057\u3066\u4ef2\u9593\u2461\u30e6\u30ad\u2462\u30d1\u30c6\u30a3\u306e\u30e1\u30f3\u30d0\u30fc\u3067\u306e\u30a4\u30e9\u30b9\u30c8\n(\u3082\u3061\u308d\u3093\u4ed6\u306e\u4ef2\u9593\u3084\u3001\u30a2\u30ad\u30c9\u3055\u3093\u30aa\u30ea\u30ad\u30e3\u30e9\u7d61\u307e\u305b\u3066\u9802\u3044\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\u3002)\n\n\u30fb\u753b\u50cf\u30b5\u30a4\u30ba\u7e26\u9577\u3067\u30ad\u30e3\u30e9\u306e\u8eab\u4f53\u898b\u3048\u308b\u7bc4\u56f2\u591a\u3044\u69cb\u56f3\n\u30fb\u8868\u60c5\u5909\u5316\u306a\u3069\u3042\u308c\u3070\u5b09\u3057\u3044\u3067\u3059\n\u30fb\u30ea\u30f3\u306e\u9aea\u578b\u3001\u53c2\u7167\u753b\u50cf\u306e\u9aea\u578b\u4e0b\u308d\u3057\u30d0\u30fc\u30b8\u30e7\u30f3\n\u30fb\u30d1\u30c6\u30a3\u3001\u53c2\u7167\u753b\u50cf\u30d4\u30f3\u30af\u30e9\u30d5\u8863\u88c5(\u30a2\u30ec\u30f3\u30b8\u5927\u4e08\u592b\u3067\u3059\u3002)\n\u30fb\u30e6\u30ad\u3001\u8863\u88c5\u65b0\u305f\u306a\u9b54\u6cd5\u8077\u30a4\u30e1\u30fc\u30b8\u306e\u8863\u88c5\u30a2\u30ec\u30f3\u30b8(\u6c34\u8272\u30fb\u767d\u3092\u57fa\u8abf)\u2190\u53c2\u7167\u753b\u50cf\u304b\u3089\u30a2\u30ec\u30f3\u30b8\u53c8\u306f\u30a2\u30ad\u30c9\u3055\u3093\u65b0\u305f\u306a\u30c7\u30b6\u30a4\u30f3\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\u3002\n\n\n\u25c6\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u60c5\u5831\u25c6\n\n\u2460\u30ea\u30f3\n\u732b\u7363\u7a2e\u00d7\u30d2\u30e5\u30fc\u30de\u30f3\u306e\u30cf\u30fc\u30d5\n23\u6b73\u5973\u6027\u3000\u300e\u732b\u8033\u300f\u3068\u300e\u30d5\u30b5\u30d5\u30b5\u5c3b\u5c3e\u300f\u3042\u308a\n\u30fb\u3010(\u732b\u8033\u306e\u307f\u3067\u4eba\u9593\u306e\u8033\u306f\u7121\u3057\u3067\u3059)\u3011\n\u30fb\u3010(\u30d5\u30b5\u30d5\u30b5\u5c3b\u5c3e\u306f\u9aea\u8272\u3068\u540c\u3058\u8272\u3067\u3059)\u3011\n\n\u30af\u30fc\u30eb\u3067\u30ab\u30c3\u30b3\u3044\u3044\u7aef\u6b63\u306a\u9854\u7acb\u3061\u3067\n\u7dba\u9e97\u306a\u30d6\u30eb\u30fc\u306e\u77b3\u3068\u8d64\u3044\u30a2\u30a4\u30e9\u30a4\u30f3\n\u91d1\u9aea\u306b\u767d\u3044\u30e1\u30c3\u30b7\u30e5\n158cm\n\u30b9\u30bf\u30a4\u30eb\u304c\u826f\u304f\u3066\u30bb\u30af\u30b7\u30fc\u80f8C\u30ab\u30c3\u30d7 (\u5927\u304d\u904e\u304e\u305a\u306b\u307b\u3069\u307b\u3069\u306e\u7f8e\u4e73\u30b5\u30a4\u30ba)\n(\u753b\u50cf\u2460\u30d0\u30b9\u30c8size)\n\n\u4e16\u754c\u3092\u65c5\u3059\u308b\u5192\u967a\u5bb6\n\u8863\u88c5\u3000\u6d77\u8cca\u670d\u30e2\u30c1\u30fc\u30d5(\u753b\u50cf\u2460\u8863\u88c5)\n\u8272\u5473:@\u753b\u50cf\u306e\u3088\u3046\u306b\u9ed2\u30d9\u30fc\u30b9\n\u753b\u50cf\u3067\u898b\u3048\u306a\u3044\u90e8\u5206\u306f\u30a4\u30e1\u30fc\u30b8\u3067\u30a2\u30ec\u30f3\u30b8\u3057\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\n(\u30ab\u30c3\u30b3\u3044\u3044+\u30bb\u30af\u30b7\u30fc\u3000\u80f8\u5143\u30fb\u592a\u3082\u3082\u30fb\u3078\u305d\u51fa\u3057)\n\u77ed\u9283\u3068\u5263\u3092\u4f7f\u3044\u3053\u306a\u3059\u4e8c\u5200\u6d41\n(\u53c2\u7167\u753b\u50cf\u306b\uff83\uff9e\uff7b\uff9e\uff72\uff9d\u3042\u308a)\n\u30b7\u30eb\u30d0\u30fc\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u597d\u304d\n\u9ed2\u30ec\u30fc\u30b9\u30e9\u30f3\u30b8\u30a7\u30ea\u30fc\u7740\u7528\n\u80f8\u5143\u30bb\u30af\u30b7\u30fc\u30c1\u30e9\u30ea\u3068\u9ed2\u4e0b\u7740\u8997\u304b\u305b\u3066\u3044\u308b\n\u7f8e\u4eba\u30af\u30fc\u30eb\u3067\u30ab\u30c3\u30b3\u3044\u3044\n\u4ef2\u9593\u60f3\u3044\u3067\u307f\u3093\u306a\u304b\u3089\u597d\u304b\u308c\u308b\n\n\n\n\n\u2461\u30e6\u30ad\n\u30a8\u30eb\u30d5\u3068\u30d2\u30e5\u30fc\u30de\u30f3\u306e\u30cf\u30fc\u30d5\n22\u6b73\u3000165cm\n\u808c\u8272\u767d\u30fb\u6c34\u8272\u306e\u9aea\u30fb\u30ad\u30ec\u9577\u76ee\u306e\u7aef\u6b63\u306a\u9854\u7acb\u3061\n\u30b9\u30e9\u30c3\u3068\u3057\u305f\u9577\u8eab\u306e\u7f8e\u3057\u3044\u5973\u6027\n(\u5973\u6027\u306e\u9b45\u529b\u3042\u3075\u308c\u308b\u8eab\u4f53\u3064\u304d\n\u30d0\u30b9\u30c8D\u30ab\u30c3\u30d7\u67d4\u3089\u304b)\n\n\u30a8\u30eb\u30d5\u306e\u91cc\u3067\u7523\u307e\u308c\u80b2\u3063\u305f\u5f7c\u5973\n\u30a8\u30eb\u30d5\u306e\u77e5\u6027\u3068\u7f8e\u8c8c\u3092\u517c\u306d\u5099\u3048\u3066\u3044\u308b\n\u30cf\u30fc\u30d5\u306e\u30d2\u30e5\u30fc\u30de\u30f3\u306e\u8840\u306e\u70ba\u304b\u5468\u308a\u306e\u4fdd\u5b88\u7684\u306a\u30a8\u30eb\u30d5\u305f\u3061\u3068\u306f\u9055\u3044\u597d\u5947\u5fc3\u63a2\u6c42\u5fc3\u304c\u5f37\u304f\u91cc\u5916\u306e\u4e16\u754c\u306b\u8208\u5473\u3092\u6301\u3064\u3088\u3046\u306b\u306a\u308b\u3002\n(\u30d2\u30e5\u30fc\u30de\u30f3\u7236\u89aa\u3082\u5192\u967a\u5bb6\u3067\u73fe\u5728\u3082\u4e16\u754c\u306b\u65c5\u306b\u51fa\u305f\u307e\u307e)\n\u91cc\u3067\u5f97\u3089\u308c\u308b\u77e5\u8b58\u3001\u9b54\u6cd5\u3092\u7fd2\u5f97\u3057\u305f\u6a5f\u306b\u307e\u3060\u898b\u306c\u4e16\u754c\u3078\u5192\u967a\u306b\u51fa\u308b\n\n\u65c5\u306e\u9014\u4e2d\u306b\u30ea\u30f3\u3068\u51fa\u4f1a\u3044\u5171\u306b\u4e16\u754c\u3092\u65c5\u3059\u308b\u3053\u3068\u306b\u306a\u308b\n\n\u203b\u753b\u50cf\u306e\u8863\u88c5\u306f\u4eee\u306e\u3082\u306e\u3067\u3082\u3057\u53ef\u80fd\u306a\u3089\u30a2\u30ad\u30c9\u3055\u3093\u30c7\u30b6\u30a4\u30f3\u3067\u65b0\u305f\u306a\u8863\u88c5\u3092\u7740\u305b\u3066\u6b32\u3057\u3044\u3067\u3059\u3002\n\n\u25c6\u25ce\u8863\u88c5\u30a4\u30e1\u30fc\u30b8\n\u30fb\u653b\u6483\u9b54\u6cd5\u304c\u30e1\u30a4\u30f3\u3067\u7c21\u5358\u306a\u56de\u5fa9\u88dc\u52a9\u9b54\u6cd5\u304c\u4f7f\u3048\u308b(\u7c21\u5358\u306a\u9b54\u6cd5\u306f\u8a60\u5531\u306e\u307f\u3067\u767a\u52d5\u3001\u5f37\u529b\u306a\u653b\u6483\u9b54\u6cd5\u306f\u9b54\u529b\u3092\u5e2f\u3073\u305f\u30e