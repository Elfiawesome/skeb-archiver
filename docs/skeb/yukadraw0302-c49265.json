ix.net/31c2249c/uploads/origins/a7606b87-8c9a-4d9d-8979-b6846aff3f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98df6b07b2a2b45cb13fc8dc77134530", "srcset": "https://si.imgix.net/31c2249c/uploads/origins/a7606b87-8c9a-4d9d-8979-b6846aff3f90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98df6b07b2a2b45cb13fc8dc77134530, https://si.imgix.net/31c2249c/uploads/origins/a7606b87-8c9a-4d9d-8979-b6846aff3f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=418a8c55cd0306a99e1299d06dddc478 2x, https://si.imgix.net/31c2249c/uploads/origins/a7606b87-8c9a-4d9d-8979-b6846aff3f90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=faa7b1b5448f67811cdea7c89baaa416 3x"}, "body": "染山ゆか様\n\n初めまして、VTuberをしております、\n白餅だんごと申します。Xで拝見した温かみのあるイラストがとても素敵でしたので、リクエスト失礼いたします。\n\n【使用目的】\nオリジナル楽曲のMV使用、SNS投稿、YouTubeサムネイル、ファンクラブ会員向けに配布壁紙を検討しております。\n\n\n【イラスト希望】\n夜明け前のシンデレラ、というのが楽曲のタイトルとなります。\nそのためシンデレラ城のお部屋の中で、ベットの上で窓を眺めている様子をお願いできますと幸いです。\n全体的に暗めで外の景色とお部屋の明かりがその中でも黄色やアレンジに燈るような雰囲気だとありがたいです。\n\nお部屋の中の小物などは基本的に全てお任せいたします。星や星座モチーフがたくさんあると嬉しいです。\nまたお願いできると嬉しいのが、白餅だんごは衣装が3着あるため、そちらをトルソーに着せてある表現が可能であれば、お部屋の中に置いてあると大変嬉しいです🙇‍♀️\n（衣装… https://x.com/shiramochidango/status/1814550362910826960?s=46&t=F93zKc_tGxSmUgD2SRwfyw ）\n\nお部屋の中はワンピースの部屋着を着てリラックスしている様な雰囲気だと嬉しいです。\n部屋着のデザインも髪型も、お任せいたします。\n\n\n表情は可能であれば窓を見ている横目開き、閉じ目口元微笑みの二つがあるとありがたいです。\n\n※白餅だんごから見て左上に八重歯がありますので、そちらご記載頂けますとありがたいです。\n狐の尻尾も何卒よろしくお願いいたします。\n\n【白餅だんご参考資料】\nhttps://drive.google.com/drive/folders/1ympYCXkFgb5ROe8REFN3Y6XcttaYSrc8?usp=drive_link\n\n\n大変恐れ入りますがPSDもしくはPNGにてサインなどは別で頂けますと幸いです。\n\n染山ゆかさまの温かなイラストが拝見できることを、心から楽しみにしております\n何卒よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukadraw0302/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1589111, "client_id": 1801055, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71451f10f2a6dd128e5c5e9154bd6d46", "srcset": "https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71451f10f2a6dd128e5c5e9154bd6d46, https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7255a615cbecaba4319a8f8071a076d 2x, https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=379b6436b37cc0245915d23c661a4dbe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f35a7469770f97787c5f1258d8cce09b", "srcset": "https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f35a7469770f97787c5f1258d8cce09b, https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c7717c74f60c560d3f27b25fca8b360 2x, https://si.imgix.net/b4aee912/uploads/origins/747b6057-2a11-4a6f-a9f7-707adce9ab18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82a6e8523484080b5e491319b4a4d45f 3x"}, "body": "はじめまして！VTuberとして活動しているぽたといいます。\n\n所属しているマスコットVTuberのユニット「たんぽぽサンチーム」メンバー複数名での\nskebのご依頼をしたく、ご連絡させていただきました。\n\n以前からXで他のVTuber様のアニメーションなど拝見しており、素敵な空気感があるやさしい染山様のイラストの中にはいれたらなあと思い依頼できればとても幸せです。\n\n【依頼内容】\n「たんぽぽサンチーム」メンバー\nぽた（犬）、ﾊﾑｽﾀｰのきなこ、ぱんのこむぎ（うさぎ）、白・まろやか（シロイルカ）\n４名が入っている「冬」テーマの1枚イラスト\n\n【チーム説明】\nマスコットな見た目のVTuber 12名チームのうち４名\n他メンバーでも別の方にskeb依頼をする予定です。\n\n\n【立ち絵資料】\nhttps://drive.google.com/drive/folders/1XeAdvbuLTmAowRzonfneGcLdGKAwlGpi?usp=share_link\n\n【メンバー簡易説明】\n■ぽた\n　おしゃべりな犬、ごはんとみんなのことがだいすき。顔の形は餃子ににています。\n■きなこ\n　まんまるなハムスター、前髪がチャームポイント、音楽が得意です。宙に浮いててもＯＫです。\n■ぱんのこむぎ\n　パン屋さんのうさぎさん、東北訛りのおっとりした子です。\n■白・まろやか\n　元気なシロイルカ、海で暮らしていますが、陸にいる場合は少し浮いていたり椅子に座っても問題ございません。\n\n衣装等は好きにつけたりアレンジしていただいても大丈夫です\n\n【使用用途】\n納品いただいたイラストを冬の企画としてSNSで公開したいです。\nまた、ネットプリントで自由に印刷ができるようにしたいです。グッズ化の商用利用は行いません。\n\nまた、マスコットVTuberとして、マスコットキャラ好きのより多くの方に発信・周知していけるよう\nいただいたイラストをYouTube・SNSで使用したいです。\nイラストの構図にもよるとおもいますが、キャラクターが横で切れていない・\n単体背景透過画像差分がいただければ配信サムネイルや告知画像などに活用させていただきます！\n\nたんぽぽサンチームアカウント：https://twitter.com/masV_tampopo\n\nご検討をよろしくおねがいいたします！\n\nhttps://drive.google.com/drive/folders/1XeAdvbuLTmAowRzonfneGcLdGKAwlGpi?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukadraw0302/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1589111, "client_id": 3653593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a81de526/uploads/origins/c8982455-1b2e-4096-aa25-0151a25101bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2a25a122921de11b738d15e30eb3c7b", "srcset": "https://si.imgix.net/a81de526/uploads/origins/c8982455-1b2e-4096-aa25-0151a25101bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2a25a122921de11b738d15e30eb3c7b, https://si.imgix.net/a81de526/uploads/origins/c8982455-1b2e-4096-aa25-0151a25101bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40928844b9030f667e515a47d94aafc3 2x, https://si.imgix.net/a81de526/uploads/origins/c8982455-1b2e-4096-aa25-0151a25101bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c39928b2a9abee01a5582a5f58f0ecc8 3x"}, "