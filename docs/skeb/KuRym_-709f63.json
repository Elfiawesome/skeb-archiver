表情はとても幸せそう。\nヒロとエマは自分たちの服（ゲーム内の服）を着ている。姿勢は①と同じで、ヒロは相変わらずエマにキスをするが、ヒロがエマを抱きしめるだけで、エマはヒロには抱きつかない（エマが死んだから）。エマの手は垂れ下がっている。マジックバタフライの血がエマの顔の上を覆っている。ヒロは目を閉じて泣いている。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KuRym_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3402409, "client_id": 2548585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0866f8f6/uploads/origins/617fdd50-e863-4860-8cbb-92b6fcff8d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ee11df40f9ce15819a57d70e774102", "srcset": "https://si.imgix.net/0866f8f6/uploads/origins/617fdd50-e863-4860-8cbb-92b6fcff8d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21ee11df40f9ce15819a57d70e774102, https://si.imgix.net/0866f8f6/uploads/origins/617fdd50-e863-4860-8cbb-92b6fcff8d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2d16a933482d640954a73772b382cee 2x, https://si.imgix.net/0866f8f6/uploads/origins/617fdd50-e863-4860-8cbb-92b6fcff8d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14061ac5f9055c2fec1ee84bb8777602 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0866f8f6/uploads/origins/617fdd50-e863-4860-8cbb-92b6fcff8d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=042818301a6fc09ecab70d477f8b2479", "srcset": "https://si.imgix.net/0866f8f6/uploads/origins/617fdd50-e863-4860-8cbb-92b6fcff8d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=042818301a6fc09ecab70d477f8b2479, https://si.imgix.net/0866f8f6/uploads/origins/617fdd50-e863-4860-8cbb-92b6fcff8d7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2d8349f7bdab09a1d73df9fcc54bcbc 2x, https://si.imgix.net/0866f8f6/u