x.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3e77b10c89d8fd2dab793408d3f0335 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccc114c06ab9c48c46b5ae400dcae0a", "srcset": "https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ccc114c06ab9c48c46b5ae400dcae0a, https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d274a475d85411ffda75c97aec654744 2x, https://si.imgix.net/40edc09d/uploads/origins/1ab9e5c1-c43a-41b4-92dc-94bec7308360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01996f91f82a882c8c43d04a8c43c503 3x"}, "body": "始めまして綾ナギと申します！\nくり抹茶様のtwitterのイラストに一目惚れしました！\n女の子がとてもかわいく素敵だと感じたためリクエストをさせていただきます！\n\n＜内容＞\n個人VTuberの蓮希るいちゃんを描いていただきたいです！\n出来上がったイラストを蓮希るいちゃんへプレゼントさせていただきたいと思います。\n\n＜構図やポーズ＞\n可能であれば16：9のアスペクト比でお願いします。\n構図としてはパジャマ衣装でベッドで座りながら耳かきor寝転がりながら囁きをしようとしている姿でお願いします。\nhttps://x.com/kurimatcha/status/1900751259445194823\nのような雰囲気でお願いします。\nパジャマ衣装はボタンを少し開けて着崩して欲しいです。（中はキャミソールでYouTubeの規約に引っかからない程度のチラ見せでお願いします。）\n他におすすめの構図があればおまかせいたしますのでYouTubeのサムネイルに使用できるようなイラストを描いていただけると助かります。\n耳かき棒を描いていただく場合はON/OFF可能だと助かります。\n頭部や左右が切れないようにしていただけると助かります。\n細かいポーズなどはおまかせでお願いします。\n可能でしたら表情差分をお願いします。\n\n＜ご本人様サイトからの注意点やお願い＞\n以下ご本人様サイトからの文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@ifeelikeagod/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3627091, "client_id": 3574846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f3d0baab6b3375c30e9f3346d02fdc", "srcset": "https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f3d0baab6b3375c30e9f3346d02fdc, https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f15831d941afd1b56a72422c2c377471 2x, https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d15ff4e57570eea139182c06f9f61c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0d2afb9b6827b25f8c191d5707d513f", "srcset": "https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0d2afb9b6827b25f8c191d5707d513f, https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4207b92f106de11dc09aefb63f45c613 2x, https://si.imgix.net/9b26c6bb/uploads/origins/14af3f62-85a5-4c7c-9128-736b7e560ba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=762710a73b9a5054708a71a72a856e03 3x"}, "body": "矢田さん、お世話になっております。くり抹茶です。\n2回目となるのですが、また私のoc「おかしひめ」を描いて頂きたいです！\n\n【キャラクター設定】\nおかしひめは流れ星の妖精であり、魔法でお菓子のドレスをまとったり、周りをお菓子にしたり出来ます。(魔法自体は他にも大体何でも出来ます)\n好奇心旺盛で人懐っこく、普段は街や森をお菓子にして人間たちと遊んでいます。\n\n【イラスト内容】\nおかしひめに深く関わる「星」「姫」「お菓子」のいずれかをテーマにしたイラストを描いて頂きたいです。細かい詳細はおまかせします！\n\n矢田さんの絵柄でまたうちの子が見れるのを楽しみにしております！\n\nhttps://drive.google.com/drive/folders/1xK6ngEjhpYnuQkW9wTjtjGCfWbPm6UVz", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@me1kakuna_1si/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3782287, "client_id": 3574846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33cd430cb8f63b3a77de50c7826cbe90", "srcset": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33cd430cb8f63b3a77de50c7826cbe90, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32c0150d3592aea5ad4e3502f9d00054 2x, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dc19190e09f2d25ef5aba206142b89c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562cfd0fa5f7a7890da82b3df9b44a7f", "srcset": "https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=562cfd0fa5f7a7890da82b3df9b44a7f, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e70c24d5d382ca730cb8292b6a2eede 2x, https://si.imgix.net/9c1556b6/uploads/origins/a8fb635b-b035-40fa-9733-21c822fb315d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be05313ccd19ec8b460e698c20d22b3b 3x"}, "body": "こんにちは、くり抹茶と申します。\n明確な石さんの優しく暖かみがある世界観のイラストが好きで依頼させていただきたいと思いました。\n今回は私のオリジナルキャラクター「おかしひめ」を描いて頂きたいです。\n\n【キャラクター設定】\nおかしひめは元々「流れ星の妖精（画像参照）」で彼らの持つ魔法の力で大好きなお菓子をまとったお姫様の姿に変身しています。\n元気で愛嬌のある性格で、好きなことはお菓子を食べることと人の願いを叶えることです。\n普段は森や街をお菓子に変えたりして遊んでいます。\n\n【イラスト内容】\n上記のおかしひめを用いて明確な石さんが普段描いているような、背景も活かした世界観溢れるイラストを描いて頂きたいです！\n構図等の指定はありませんので、設定などを見て思いついたものを自由に描いて欲しいです。\n\n【希望納品形式】\n画面サイズは9:16の横長にしていただきたいです。\nまた、psdでおかしひめ単体のレイヤーがあると嬉しいです！(構図的に難しい場合などは大丈夫です。)\n\n【使用用途】\n基本は観賞用ですが、SNSのアイコンやヘッダーに使わせて頂くかもしれません。ですが、使いやすいよう描いて頂かなくて大丈夫です。\n\n背景付きで大変かも知れませんがぜひよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1sNmSZCWAl8yH8BGrUeZIBfOKI0W2Xtfy", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ifeelikeagod/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3627091, "client_id": 3574846, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d3bdfdf/uploads/origins/770efbb6-f5be-48ca-b753-6d882553bbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a555358c7d8149860d39b03f350e4df4", "srcset": "https://si.imgix.net/0d3bdfdf/uploads/origins/770efbb6-f5be-48ca-b753-6d882553bbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a555358c7d8149860d39b03f350e4df4, https://si.imgix.net/0d3bdfdf/uploads/origins/770efbb6-f5be-48ca-b753-6d882553bbb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=