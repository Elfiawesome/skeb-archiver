い髪、青い目です。\n\nポーズについては、彼がかっこよく見えるようなものを描いてもらえますか？黒いジャケット（ゆったりした黒いパーカーか革のジャケット）を着て、目を細めてポケットに手を入れてサイズを見ている絵とか。\n\nそうでなければ、脚を組んで退屈そうに座り、腕を膝の上に置いて顎を乗せ、無造作な黒眼鏡を手で強調したポーズもいいかもしれない。\n\nもし髪型や服装を変えたいのであれば、遠慮なく言ってほしい。絵には好みがあると思うので、好きなように描いてほしい！\n\nよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fi/kai64jnvpjadn4e23w6js/Orochi-Design.png?rlkey=fsk1ek66zceldf2lh42z5jjga&st=9mt7amrb&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@IIYO_3/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1960559, "client_id": 2035648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7af5045b/uploads/origins/83593ed1-f4ba-4d8e-a29c-42308664c419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b704a703013d1187d9cc36cca6935984", "srcset": "https://si.imgix.net/7af5045b/uploads/origins/83593ed1-f4ba-4d8e-a29c-42308664c419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b704a703013d1187d9cc36cca6935984, https://si.imgix.net/7af5045b/uploads/origins/83593ed1-f4ba-4d8e-a29c-42308664c419?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18455e90a23f367d317113f3c22afc95 2x, https://si.imgix.net/7af5045b/uploads/origins/83593ed1-f4ba-4d8e-a29c-42308664c419?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dbca9671687406755c53568edf8ab5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7af5045b/uploads/origins/83593ed1-f4ba-4d8e-a29c-42308664c419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb693917d10d9fe393f0f56d8d970cb0", "srcset": "https://si.imgix.net/7af5045b/uploads/origins/83593ed1-f4ba-4d8e-a29c-42308664c419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb693917d10d9fe393f0f56d8d970cb0, https://si.imgix.net/7af50