ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6cc2f5b3784a93445ec471e8d5e54d4 2x, https://si.imgix.net/26a92654/uploads/origins/1aa6a307-4dc0-4cf8-a6a8-96cdd0097fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21d3301f517200090f53daf367315b4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26a92654/uploads/origins/1aa6a307-4dc0-4cf8-a6a8-96cdd0097fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fe8e984ddbbc6b0f3d4268987ba5dad", "srcset": "https://si.imgix.net/26a92654/uploads/origins/1aa6a307-4dc0-4cf8-a6a8-96cdd0097fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fe8e984ddbbc6b0f3d4268987ba5dad, https://si.imgix.net/26a92654/uploads/origins/1aa6a307-4dc0-4cf8-a6a8-96cdd0097fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c38f9e35c76450b05696443a0cfc2d20 2x, https://si.imgix.net/26a92654/uploads/origins/1aa6a307-4dc0-4cf8-a6a8-96cdd0097fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4edfdfc188403fde5e001b4450e991bc 3x"}, "body": "こんにちは、ひにち先生。先生の絵はかわいいですね。戦姫絶唱シンフォギアの小日向未来がポニーテールで、薄紫のビキニに濡れたシースルーの白Tシャツを着ているイラストをお願いできますか？みぞおちと太ももを強調したポーズでお願いします。表情は照れ笑い。\n\n舞台は日の出のリゾート。\n\nキャラクター参考：\nhttps://imgur.com/a/nxmUKf4\nhttps://i.imgur.com/siiSYuW.png\n\nできればシャツを着ているバージョンと着ていないバージョンもあると嬉しい。\n\nご配慮ありがとうございました。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinichi333/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2155215, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5adfd086/uploads/origins/9bbac821-c5ef-4204-bef8-c61e76c2b1d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c14cf02841f9bfc48937cb52d61ae7