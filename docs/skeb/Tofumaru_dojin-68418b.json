ad75-f819-4de1-8c23-4511a454f2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c42a4b9f7992b6e2188910ba8debef8 2x, https://si.imgix.net/b69b9c6d/uploads/origins/34b4ad75-f819-4de1-8c23-4511a454f2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe8097304834028c583d319fbe0c9a00 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b69b9c6d/uploads/origins/34b4ad75-f819-4de1-8c23-4511a454f2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=130b9d27162a4bef14b479a1ae176384", "srcset": "https://si.imgix.net/b69b9c6d/uploads/origins/34b4ad75-f819-4de1-8c23-4511a454f2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=130b9d27162a4bef14b479a1ae176384, https://si.imgix.net/b69b9c6d/uploads/origins/34b4ad75-f819-4de1-8c23-4511a454f2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55e9ad9486e5c83ffc69d1ce4900b6d5 2x, https://si.imgix.net/b69b9c6d/uploads/origins/34b4ad75-f819-4de1-8c23-4511a454f2cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e8ab9aa15a64c66a8889d1a799856ac 3x"}, "body": "とうふまる先生よろしくお願いします。\n第一話放課後の教室での15ページの私のうんこみんな見て、と16ページのうんこシーンのリメイクがみたいです。\n特に16ページの見てる生徒はメス犬登校の三人娘が間近で見てるのが希望です。\nショートの娘は興味深々、長髪の娘はちょっとひいた顔、髪を染めた娘は鼻を摘んで臭そうにしてるのが希望です。\nよろしくお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tofumaru_dojin/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3717465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18863770b00e279665453c218b1d05a0", "srcset": "https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18863770b00e279665453c218b1d05a0, https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=364cb6dfaa3b324ec6555dddfe7a8dcf 2x, https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6686d38c979eebdec4ee7a98f8296a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee9c05d98b3f126eb18d96d9e1916652", "srcset": "https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee9c05d98b3f126eb18d96d9e1916652, https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c457f3ca4c855814e630c715a745fd6a 2x, https://si.imgix.net/8433b69c/uploads/origins/b3610de8-7368-4f52-89e3-123919546b86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=651dafbb4092ca1d1b27124db0c96ad0 3x"}, "body": "とうふまる先生よろしくお願いします。\nメス犬登校の三人娘に揶揄われる岡田さんが見たいです。\n岡田さんは肛門オナニーして裸で寝てしまい寝冷えした設定。\n昼休み前の授業でうんこがしたくて脂汗が出るほど苦しむ岡田さん。\n授業が終わると人気の無い校舎のトイレへダッシュで駆け込む岡田さん。\n大きくて太いうんこを出すと肛門オナニーの余韻が残っており「はあん」と思わず声が出てしまう。\n改めて自分が出したうんこを見て、岡田さんは「女の子なのにこんなに太いうんこ出ちゃった、恥ずかしい」と言ってしまう。\n思わずオナニーしようとしたその時トイレの外からクスクスと笑い声が聞こえる。\nトイレから出ると岡田さんの顔色が悪くて心配してこっそり着いてきた三人娘がそこにいて、「智子がなんともなくて本当に良かったよ」って笑顔で言う。\nその後長髪の娘がハァンとか女の子なのに〜と岡田さんの喋った内容を真似して、他の2人が大笑い。\n顔真っ赤になったデフォルメ岡田さんがやめてーって言いながら三人娘を追いかけて終わる感じでお願いしたいです。", "nc": 176, "word_count": 0, "transcoder": "image", "creato