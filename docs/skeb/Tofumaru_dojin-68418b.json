です。\nスカートが短くて恥ずかしがってる顔と、差分で周りの女子に可愛いと言われてちょっとドヤ顔になってる岡田さんが見たいです。\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tofumaru_dojin/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3717465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c92d0b69bc0ad23dae7f054a36953c9", "srcset": "https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c92d0b69bc0ad23dae7f054a36953c9, https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92ba21bdc9b8d216b630473f7cb1a574 2x, https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1451413ecced99f8498523b5147b99f4 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23fec765d71f569fbce2d6e2f5223e20", "srcset": "https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23fec765d71f569fbce2d6e2f5223e20, https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5317e91f5eda922e593e0d619acbda7 2x, https://si.imgix.net/40957872/uploads/origins/3ce933bf-4098-4fae-8d8a-2c84d8fd7878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ee53d843e5a1bfeda15827405bc40b9 3x"}, "body": "とうふまる先生よろしくお願いします。\nメス犬登校の続きが見たいです。\n教室に置いた犬用トイレに岡田さんがうんこをするも、はみ出してしまい粗相をしたと三人娘に怒られてしまい泣く岡田さん。\nその後お尻を拭いてもらいながら、次からは綺麗に使うんだよと躾けられる岡田さん\n以上よろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tofumaru_dojin/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3717465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/543d9703/uploads/origins/c7e8e8c3-2af4-484a-8eb1-bcbb3bb394cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc181b2188932b8d1d4564a2f0b51327", "srcset": "https://si.imgix.net/543d9703/uploads/origins/c7e8e8c3-2af4-484a-8eb1-bcbb3bb394cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc181b2188932b8d1d4564a2f0b51327, https://si.imgix.net/543d9703/uploads/origins/c7e8e8c3-2af4-484a-8eb1-bcbb3bb394cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0760b9bf6cd7b2c5e4ae5bb31147ac4 2x, https://si.imgix.net/543d9703/uploads/origins/c7e8e8c3-2af4-484a-8eb1-bcbb3bb394cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4e4ea89bd55e41f9b3198c414e82814 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/543d9703/uploads/origins/c7e8e8c3-2af4-484a-8eb1-bcbb3bb394cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e645c5d90228c17a4c94bec1d33cec54", "srcset": "https://si.imgix.net/543d9703/uploads/origins/c7e8e8c3-2af4-484a-8eb1-bcbb3bb394cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e645c5d90228c17a4c94bec1d33cec54, https://si.imgix.net/543d9703/uploads/origins/c7e8e8c3-2af4-484a-8eb1-bcbb3bb394cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c