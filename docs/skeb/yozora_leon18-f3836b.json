b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3bbe884dac15b3105723ea12f346d68", "srcset": "https://si.imgix.net/e2cc7504/uploads/origins/a629d754-5f7d-485b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3bbe884dac15b3105723ea12f346d68, https://si.imgix.net/e2cc7504/uploads/origins/a629d754-5f7d-485b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c543b3273ef9ac95d42198e8c4afa74 2x, https://si.imgix.net/e2cc7504/uploads/origins/a629d754-5f7d-485b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b796da5355ba4fc0899f162d27effe1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2cc7504/uploads/origins/a629d754-5f7d-485b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6463fd7c4588a2093305424d1e5eb471", "srcset": "https://si.imgix.net/e2cc7504/uploads/origins/a629d754-5f7d-485b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6463fd7c4588a2093305424d1e5eb471, https://si.imgix.net/e2cc7504/uploads/origins/a629d754-5f7d-485b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=211bcad405d77ba10210924e035bf40f 2x, https://si.imgix.net/e2cc7504/uploads/origins/a629d754-5f7d-485b-9b67-aa5abed6d5af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3aa49be7f4074a77977c9f57edf3a872 3x"}, "body": "前回はありがとうございました。\n今回は別のオリキャラであるフィーネをお願いします。\n\nフィーネ\n聖女であり託宣の勇者である主人公の婚約者。\n聖女として歴代屈指の才能と実力を持つ。王族の血筋だが早くから聖女として育てられた為世間知らずで純粋。\n主人公の事を心の底から愛しており主人公の為なら自分の身も顧みない献身さを持つ。\nhttps://drive.google.com/drive/folders/1bhgzqnYZfJz2Go0UOol5AQEsWenkZF8f?usp=sharing\n\n構図は正面向き。\n衣装はシルヴィアの物をベースに上半身は同じで下半身部分が長いスカート状になり両側に腰までの深いスリットが入りハイレグのパンツのヒモが見えている。\nスカートにあたる部分は中央部分の面積も小さく太腿以下の部分がほとんど隠せておらずむき出し、幅のイメージは足と足の間部分と両足の内側の端を少し隠せる程度しかなく、それが足元まで徐々に幅が狭くなりつつ伸びている感じです。\n参考としてはプランジングネック等のイブニングドレスなどのイラストでよくある腰ぐらいまでスリットが入り鼠蹊部が見えているようなものです。イブニングドレスのボディコン化みたいなイメージです。\nサイハイソックスは黒めのブラウンで少し透けた感じのタイツのような感じ。\n上手く言葉に出来ないのですが、ナイトクラブで女性が持っているロングマフラーのような白いファーを腰当たりの背中側から両肘にかけている感じにしてもらいたいです。\n今回はタトゥーはなしで他の耳、臍ピアス、ネイルなどはシルヴィアと同じような感じでお願いします。\nボディコンの色はテカテカの紫色。\n表情は悪堕ちした悪そうな感じ。\nもしいけるならボディコンのテカテカ黒、目元をバイザーや仮面のようなもので隠したもの、紫のアイシャドーの差分もお願いしたいです。\n\n\nイメージは悪の組織のボスである間男に堕とされ主人公と行動しつつ裏では間男の女として悪の女幹部になった感じです。\n\n注文が多く申し訳ありません。\n完成品は一部私のXでリンク付きで掲載させていただくと思います。\nもしよければご検討宜しくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yozora_leon18/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3701782, "client_id": 1082723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7caf995/uploads/origins/39146139-c44c-4eba-98e0-82fd1e8d7473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e54882e666ba91d1466a149039d8f2a", "srcset": "https://si.imgix.net/f7caf995/uploads/origins/39146139-c44c-4eba-98e0-82fd1e8d7473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e54882e666ba91d1466a149039d8f2a, https://si.imgix.net/f7caf995/uploads/origins/39146139-c44c-4eba-98e0-82fd1e8d7473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38504b945d4792de21b120e563176398 2x, https://si.imgix.net/f7caf995/uploads/origins/39146139-c44c-4eba-98e0-82fd1e8d7473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cd5fba095406fd36c7d688ab5f321f9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7caf995/uploads/origins/39146139-c44c-4eba-98e0-82fd1e8d7473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b9aa21b6696e229afc4a53cbec4338e"