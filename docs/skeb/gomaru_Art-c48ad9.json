ァイターズトライの星野ふみな(https://static.wikia.nocookie.net/gundam/images/f/f0/Figure-Rise_Standard-Fumina_Hoshino.jpg/revision/latest?cb=20201014023540)をボクシングの試合で見てみたいと思っています。衣装は写真のものから黄色のジャケット（つまりブラとスパッツ）とピンクと白のボクシンググローブ（https://sanabulsports.com/products/womens-easter-egg-boxing-gloves）を除いたものです。ポーズは、床に倒れていて、体と顔にあざがあり、口からは血と唾が出ています（https://www.deviantart.com/mastersaruwatari/art/KO-d-Tiffany-for-my-birthday-By-Azasket-844495938）。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gomaru_Art/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1121765, "client_id": 971388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26074364/uploads/origins/b33efd76-3909-43f7-bdfc-cad38b2df121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6386bc83125aca44e84c2e9f9b436bc2", "srcset": "https://si.imgix.net/26074364/uploads/origins/b33efd76-3909-43f7-bdfc-cad38b2df121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6386bc83125aca44e84c2e9f9b436bc2, https://si.imgix.net/26074364/uploads/origins/b33efd76-3909-43f7-bdfc-cad38b2df121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=891d6485f8c646ddafa6a3ce2f2cc4b8 2x, https://si.imgix.net/26074364/uploads/origins/b33efd76-3909-43f7-bdfc-cad38b2df121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9ddef783ea1c8fe8f46612ecf71eefe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26074364/uploads/origins/b33efd76-3909-43f7-bdfc-cad38b2df121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cb00d6e4e57183b549309f6aa7ad838", "srcset": "https://si.imgix.net/26074364/uploads/origins/b33efd76-3909-43f7-bdfc-cad38b2df121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cb00