net/ab436568/uploads/origins/325fab67-807c-46bc-921b-dced4ad554c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d376930f25908e706ef839d8f7b43c0a, https://si.imgix.net/ab436568/uploads/origins/325fab67-807c-46bc-921b-dced4ad554c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=114f5026429469910e5ac00dccd7188f 2x, https://si.imgix.net/ab436568/uploads/origins/325fab67-807c-46bc-921b-dced4ad554c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87a232d0bd0eda82f07396f1a13a580b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab436568/uploads/origins/325fab67-807c-46bc-921b-dced4ad554c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e303f1676153c2fbe1c013642b35454a", "srcset": "https://si.imgix.net/ab436568/uploads/origins/325fab67-807c-46bc-921b-dced4ad554c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e303f1676153c2fbe1c013642b35454a, https://si.imgix.net/ab436568/uploads/origins/325fab67-807c-46bc-921b-dced4ad554c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd10df5ea01fa5d2f7161369957f9b2b 2x, https://si.imgix.net/ab436568/uploads/origins/325fab67-807c-46bc-921b-dced4ad554c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc0d8335acb5b38621edbb31a4acbfa0 3x"}, "body": "ご依頼失礼します。\n下記資料のこの子を是非ともあなたの絵柄で二つほど描けますでしょうか？\n小物として、天女の領巾(ひれ)的な物が付いておりますので良ければそちらも付けて描いて頂きたいです。\n(資料側の別フォルダに該当の作例を送付してあります)\n\n資料では手や足が隠れて見えなくなっていますが、これに関しては衣装のゆったり長い袖や裾に隠れているというだけで手足が無いわけではないです。\nですがこちらの嗜好の都合上、極力手先足先は衣装に隠して露出させない感じだと嬉しいです。\n\nどのように描かれるかはお任せします。\n\n参考資料↓\nhttps://drive.google.com/drive/folders/1mrAl3HpQQzQOHO2p9fMPoKjM5tWbEhW4", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oekakinokoboy/works/9", "private_thumbnail_im