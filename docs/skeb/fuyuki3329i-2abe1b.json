0&h=200&blur=200&s=e9cf61d6f6f2f83a1e0dcdaf349d5174 2x, https://si.imgix.net/0d9ce431/uploads/origins/3d17fadb-12a1-4231-9dd2-deef8faecc9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bdcc4a3f51ad00adf69b0ce188c15336 3x"}, "body": "初めまして\nフ雪さんの描かれる中二感を前面に押し出したイラストをお願いいたしたいです\n\n\n服装は黒ローブ\nイメージとしましてはキングダムハーツシリーズの13機関のローブです\nフードは被った状態ではなく後ろへ下げた状態\n\nキャラクターは先日投稿された白銀の子\n(https://x.com/fuyuki3329i/status/1838139946936500503)\nこちらの左の子です\nこの子の髪をボブヘアに伸ばしていただけると嬉しいです\n\n装飾として口元を覆うガスマスクを(非フルフェイスでお願いします)\n\nシーンとしては手袋をキュッとはめているところ\nその他の構図や装飾はお任せという形でお願いいたします\n\n\n主な希望は以上です\n総じて曖昧な要望になってしまいましたが、もしよろしければお願いいたします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyuki3329i/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736984, "client_id": 1250371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9736af6e1c4e19cb78488d4410c844cc", "srcset": "https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9736af6e1c4e19cb78488d4410c844cc, https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1f156b3f9f1529f796061b7eabfb346 2x, https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3007d949b2c1c004273305e1422493b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1651fa78841919765c31a3873391974", "srcset": "https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1651fa78841919765c31a3873391974, https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26f05d970245bf4fd17b480c8c497c5b 2x, https://si.imgix.net/533c2a19/uploads/origins/57e6fee7-d19d-460a-8e7d-26cf550d40b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d430547ded337070327e5a0a794ec08 3x"}, "body": "はじめまして、フ雪様。\nツイッターでお見かけし、とても素敵ですので、フ雪様にうちの子を描いてほしいと思い、今回新規リクエストを送信させていただきました。\n投稿されているイラストで、和装も洋装もとても素敵で、描かれ方がとても好みです。\n\n描いてほしいうちの子の資料は下記のツイートの通りです。:\nhttps://twitter.com/littlenight_sh/status/1414542351125471232\nキャラ詳細\n・黒髪ロングストレート\n・緑かかった黒い瞳\n・胸は薄目\n・中高生くらいのイメージ\n資料からの追加事項\n・銀色の狐耳・尻尾をお願いいたします。\n黒い髪の毛に銀色の狐耳(尻尾)となります。\n\n性格は明るく素直純真元気な甘えたがりな子となります。\n\n服装・シチュエーションのイメージとして\n・髪の毛に細いタイプのリボン、上半身は和装、下は洋装のロングスカートのイメージをお願いいたします。\n・うれしそうに、踊っているようなイメージで楽しそうな姿をお願いいたします。\n・桜の花が散り葉桜となっている昨今ですが、緑芽吹き生命あふれる春のようなイメージ(かなり曖昧なご指定ですのでここはご無理なさらなくても大丈夫です)\n\nその他ポーズ・構図についてはフ雪様にお任せいたします。\nご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/littlenight_sh/status/1414542351125471232", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyuki3329i/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=638cdaade328121649eb1a88c0584940", "srcset": "https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=638cdaade328121649eb1a88c0584940, https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ea72992d6ea1feec3cecc798af464a7 2x, https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcd8cc5049377cd8473c52dedeffb056 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf2775caf3d865d4cae2a7b45057a03f", "srcset": "https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf2775caf3d865d4cae2a7b45057a03f, https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97ecf2c51ed468cd77abcdb55d456105 2x, https://si.imgix.net/86c3a8df/uploads/origins/10c5a51b-ae89-4c72-8b14-ec7e2c719ea7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3fde9ffe3832d9c619b1e5dd90a6856 3x"}, "body": "フ雪様\n\n初めまして、突然の依頼失礼いたします。\n投稿されているイラスト、服のデザインに惚れ込み\n是非イラストを描いていただきたいと思い依頼させて頂きました。\n\nイメージとしては、桜吹雪の中、高校生位の女の子、髪の色は銀髪or白髪で髪の長さはミディアム～ロング\n表情や構図、服装等はお任せします。\n\n使用用途としてはPCの壁紙として使用させて頂ければと思っています。\n\nSkebでの依頼が不慣れのため、情報等至らない点があり申し訳りませんが\n宜しくご検討お願いします。", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuyuki3329i/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736984, "client_id": 425230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa5c5c2e/uploads/origins/64e36bb5-cadb-45b0-b234-e0b4f6383b1a?bg=%23fff&auto=for