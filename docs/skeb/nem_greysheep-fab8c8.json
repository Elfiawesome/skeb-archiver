press&fm=webp&fit=crop&crop=top&w=200&h=200&s=6652b97593f3707358c77b681643696d", "srcset": "https://si.imgix.net/5b98ece4/uploads/origins/177d5247-c6fe-4035-8150-0a5757f7c1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6652b97593f3707358c77b681643696d, https://si.imgix.net/5b98ece4/uploads/origins/177d5247-c6fe-4035-8150-0a5757f7c1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bb34eac1ca7b7af90942741d87dd1a6 2x, https://si.imgix.net/5b98ece4/uploads/origins/177d5247-c6fe-4035-8150-0a5757f7c1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db462ac6755163ce037c4c275317c647 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b98ece4/uploads/origins/177d5247-c6fe-4035-8150-0a5757f7c1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdf379f599aa41841649239079fb946d", "srcset": "https://si.imgix.net/5b98ece4/uploads/origins/177d5247-c6fe-4035-8150-0a5757f7c1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdf379f599aa41841649239079fb946d, https://si.imgix.net/5b98ece4/uploads/origins/177d5247-c6fe-4035-8150-0a5757f7c1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1bacf3565e094b44ad2b9b1d25bd1062 2x, https://si.imgix.net/5b98ece4/uploads/origins/177d5247-c6fe-4035-8150-0a5757f7c1e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a35e62311768de89b2987bdd0c187bd6 3x"}, "body": "\u3053\u3093\u306b\u3061\u306f\u3001\u5148\u65e5\u306f\u6700\u5f37\u306b\u7d20\u6575\u306a\u6700\u9ad8\u30a4\u30e9\u30b9\u30c8\u3092\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01\u6bce\u65e5\u76ee\u306b\u5165\u308b\u6240\u306b\u8cbc\u3063\u3066\u305d\u306e\u6700\u9ad8\u3055\u3092\u6bce\u65e5\u6d74\u3073\u3066\u5143\u6c17\u306b\u7206\u767a\u3057\u3066\u304a\u308a\u307e\u3059(\uff1f)\n\n\u3082\u3057\u3088\u308d\u3057\u3051\u308c\u3070\u3001\u4eca\u56de\u306f\u79c1\u306e\u6226\u8a18\u30ed\u30ae\u30a2PC2(\u8a73\u7d30\u306f\u4e0b\u8a18)\u306e\u771f\u306e\u59ff\u6f14\u51fa\u306e\u30a4\u30e1\u30fc\u30b8\u30b9\u30c1\u30eb\u307f\u305f\u3044\u306a\u3082\u306e\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u306a\u3044\u3067\u3057\u3087\u3046\u304b\uff1f\n\n\n\u540d\u524d\u3000\u30aa\u30ea\u30d5\u30a3\u30b9(Oliphis)\n\u9b54\u6cd5\u540d\u3000\u30c4\u30a1\u30a4\u30ac\u30fc(Zeiger)\n\n\u8eab\u9577\uff1a178cm\n\u4f53\u91cd\uff1a56kg\n\u771f\u306e\u59ff\uff1a\u300e\u30bc\u30af\u30f3\u30c7\u30f3\u30fb\u30c4\u30a1\u30a4\u30ac\u30fc\u300f\u3000\u52b9\u679c\uff1a\u9b54\u7d20\u653e\u5c04\n\n\u30fb\u6027\u683c\u3084\u597d\u307f\u306a\u3069\u306f\u5c11\u5e74\u306e\u59ff\u306e\u6642\u3068\u540c\u3058\u3002\n\u30fb\u771f\u306e\u59ff\u306e\u958b\u653e\u306b\u3088\u308a\u5927\u4eba\u306e\u59ff\u306b\u306a\u308a\u3001\u58f0\u304c\u5e74\u76f8\u5fdc\u306e\u4f4e\u3055\u306b\u306a\u308b\u3002\n\u30fb\u670d\u3082\u4f53\u683c\u306b\u5408\u308f\u305b\u305f\u30b5\u30a4\u30ba\u306b\u5909\u5316\u3059\u308b\u304c\u3001\u6bbf\u4e0b\u304b\u3089\u9802\u3044\u305f\u9aea\u98fe\u308a\u3060\u3051\u30b5\u30a4\u30ba\u304c\u5909\u308f\u3089\u306a\u3044\u3002\n\u30fb\u5c11\u5e74\u59ff\u306e\u6642\u306e\u6226\u95d8\u30b9\u30bf\u30a4\u30eb\u306f\u8eab\u8efd\u3055\u304c9\u5272\u3060\u304c\u3001\u771f\u306e\u59ff\u306e\u89e3\u653e\u306b\u3088\u308a\u8eab\u8efd\u3055\u3068\u706b\u529b\u304c\u3088\u308a\u30d0\u30e9\u30f3\u30b9\u306e\u53d6\u308c\u305f\u3082\u306e\u306b\u306a\u308b\u3002\n\u30fb\u5f97\u7269\u306f\u57fa\u672c\u7684\u306b\u69cd\u3002\u9b54\u5263\u53ec\u559a\u306b\u6210\u529f\u3059\u308b\u3053\u3068\u3067\u3001\u9577\u5263\u3068\u77ed\u5263\u304c\u8e0a\u308b\u3088\u3046\u306b\u5b99\u3092\u821e\u3046\u3002\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u9283\u3082\u4f75\u305b\u3066\u4f7f\u7528\u3059\u308b\u3002\n\n\n\u3010\u771f\u306e\u59ff\u89e3\u653e\u6f14\u51fa(\u30cd\u30bf\u30d0\u30ec\u3057\u305d\u3046\u306a\u3068\u3053\u308d\u3092\u7701\u3044\u305f\u3082\u306e\u3067\u3059)\u3011\n[\u30e1\u30a4\u30f3] \u30aa\u30ea\u30d5\u30a3\u30b9 : \u606f\u3092\u5927\u304d\u304f\u5438\u3044\u8fbc\u307f\u3001\u7791\u76ee\u3057\u3001\u3072\u3068\u304d\u308f\u5f37\u304f\u5de6\u80f8\u3092\u53e9\u304f\u3002\n\n\u300c\u2026\u2026\u771f\u540d\u3001\u5b8c\u5168\u958b\u5e33\u300d\n\n[\u30e1\u30a4\u30f3] \u30aa\u30ea\u30d5\u30a3\u30b9 : \u305d\u306e\u8eab\u304b\u3089\u653e\u305f\u308c\u305f\u5149\u306e\u5954\u6d41\u304c\u3001\u5168\u3066\u3092\u98f2\u307f\u8fbc\u3080\u3002\n\u4e16\u754c\u304c\u518d\u69cb\u7bc9\u3055\u308c\u308b\u304b\u306e\u3088\u3046\u306b\u3001\u5c0f\u3055\u304b\u3063\u305f\u30b7\u30eb\u30a8\u30c3\u30c8\u304c\u4f38\u3073\u3066\u3044\u304f\u3002\u77ed\u304b\u3063\u305f\u9aea\u304c\u3001\u98a8\u3068\u9b54\u529b\u3092\u306f\u3089\u307f\u6d41\u308c\u308b\u3088\u3046\u306b\u306a\u3073\u304f\u3002\n\n[\u30e1\u30a4\u30f3] \u30aa\u30ea\u30d5\u30a3\u30b9 : \u5149\u304c\u5f3e\u3051\u308b\u3002\n\n[\u30e1\u30a4\u30f3] \u30aa\u30ea\u30d5\u30a3\u30b9 : \u300e\u9752\u5e74\u300f\u304c\u3001\u9854\u3092\u4e0a\u3052\u305f\u3002\n\n[\u30e1\u30a4\u30f3] \u30aa\u30ea\u30d5\u30a3\u30b9 : \u300c\u3088\u304f\u898b\u3066\u304a\u3051\u3002\u305d\u3057\u3066\u3001\u305d\u306e\u8eab\u306b\u523b\u3081\u3002\n\u3053\u306e\u9053\u306e\u5148\u3092\u793a\u3059\u8005\u3008\u30c4\u30a1\u30a4\u30ac\u30fc\u3009\u306e\u3001\u771f\u306e\u59ff\u3092\u300d\n\u5927\u69cd\u3092\u643a\u3048\u305f\u305d\u306e\u58f0\u306f\u3044\u3064\u3082\u3088\u308a\u4f4e\u304f\u3001\u305d\u3057\u3066\u52c7\u58ee\u306b\u6226\u5834\u306b\u97ff\u3044\u305f\u3002\n\n\u300c\u6587\u5b57\u901a\u308a\u6b7b\u5b88\u3060\u2015\u2015\u3044\u3056\u3001\u53c2\u308b\uff01\u300d\n\n\n\u30aa\u30ea\u30d5\u30a3\u30b9\u306e\u59ff\u306f\u771f\u306e\u59ff\u3001\u6301\u3064\u5f97\u7269\u306f\u69cd\u3067\u304a\u9858\u3044\u3067\u304d\u308c\u3070\u3046\u308c\u3057\u3044\u3067\u3059(\u9b54\u5263\u53ec\u559a\u306f\u3053\u