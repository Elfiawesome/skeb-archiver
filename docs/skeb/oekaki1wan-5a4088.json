e, "tip_acceptable": true, "yearly_report_client_visible": true, "total_appeals_count": 0, "received_works": [{"path": "/@oekaki1wan/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2649348, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=363e405f2baf963b055b2542d48eab05", "srcset": "https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=363e405f2baf963b055b2542d48eab05, https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b01100ab31abc0aaf905a3cf2fca87f3 2x, https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74da5c7529b1aaefcbaa2d37ad73c1af 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a081fe5d61916ffcd9cf24d85ae91c5b", "srcset": "https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a081fe5d61916ffcd9cf24d85ae91c5b, https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f4ad0401f3cd093445bc40c2d32163c 2x, https://si.imgix.net/cebc8016/uploads/origins/cde013d4-89a5-41ad-a415-ca50c35cfb1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca622087061fc3626dbce250f4b92d5d 3x"}, "body": "馬姦でアへ顔アクメをキメる遊戯王OCGの《RAI-MEI》と《ワルキューレ・フィアット》、《ワルキューレ・ツヴァイト》の三人をリクエストします。\n\nキャラの造形は\n・全員頭身高めのむちむち、股間の少し上に届き下半身が普通に見えるくらいの超乳\n・服装はカードと同じ物(RAI-MEIの全身の装飾はシンメトリーでお願いします)で乳首と乳輪は大きめかつ勃起してパフィーニップル状態の物が布地越しにくっきりと浮き出ている。\n・三人が横並びしている姿(中央はツヴァイト固定)を頭から太ももまでを身体の前面がよく見えるように真正面から写す。\n・挿入中の断面図をワイプを三人に被らない位置に付ける。\n・フィアットの髪型は資料だと分かりづらいですがシンメトリーのツインテールです。\n・性格のイメージはそれぞれお好きなようにお願いします。\n\n詳細な内容は以下のような通りです。\n\n挿入前。三人それぞれの後ろに巨大なペニスをぶら下げた馬が立っており、三人はそのペニスに跨がるように立っている。ツヴァイトがマスターに自分達の痴態を見てもらうよう声を掛ける一方他二人は困惑する。そこにツヴァイトから｢破壊されて効果を発揮するカードなのだから思い切り壊されなさい♡｣という旨の言葉を投げられる事でスイッチが入り、恍惚とした表情で全てを受け入れ馬やマスターに媚びた敗北宣言をする。\n↓\n挿入時。始めは徐々に入口を抉じ開けられ苦しそうにしているが、直後に一気に奥まで挿入され、間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しく乱暴なピストンが始まり、アへ顔でオホ声と淫語の絶叫を連発しながらよがっている。\n↓\n絶頂直前。馬ペニスが子宮口を貫通。子宮の一番奥を突かれる感覚に一瞬だけ我に返り呆気に取られる。\n↓\n大量射精&絶頂。そのまま子宮内に大量の精液を発射され小さめのボテ腹になる。完全に理性を失った汚い口調で淫語を絶叫しながらイき、思い切り白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n断面図のワイプに更に受精する瞬間のカットインが入る。\n↓\n射精後。馬ペニスが引き抜かれる際に子宮が巻き込まれて引きずり出され、その感覚で再び大絶叫アクメを披露する。最後は股間から子宮口が飛び出したままそこから精液を垂れ流しながらイキっぱなしになり、放心状態でアヘオホ声を上げ続ける。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1JTPfY698ve9fO6-JxjxkgncH_mtg6dvP", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oekaki1wan/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2649348, "client_id": 1337738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a509f936/uploads/origins/08b72942-5ace-44de-acee-dbc7cfaee62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b17d45a35f6bde822736268e0a0d1f44", "srcset": "https://si.imgix.net/a509f936/uploads/origins/08b72942-5ace-44de-acee-dbc7cfaee62b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b17d45a35f6bde822736268e0a0d1f44, https://si.imgix.net/a509f936/uploads/origins/08b72942-5ace-44de-acee-dbc7cfaee62b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t