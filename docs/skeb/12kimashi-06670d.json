◎イメージ\nリヤン・アメトリン（私自身）絵柄、表情はお任せします！\n自由奔放なエルフ\n趣味であるバックバッカーで旅をしている所をお願いしたいです！(行ったことある国🇺🇸をイメージです。)\n服装、髪型(ショート、ロング、髪を結ぶなど)変えていただいて大丈夫です！\n\n自由に書いて頂けたら嬉しいです！\n\n利用目的\nツイート、サムネ、アイコン、収益化のある配信アプリでの返礼品（デジタルグッズ）\n※直接利益のある返信は致しません\n無理なものは遠慮なく教えてください。\n\n背景と人物分けての透過もあると嬉しいです!\n\nよろしくお願いします！\n\nhttps://x.com/lienametrine/status/1734143741664145706?s=46&t=ycKDkhkO7S2aHW057QxmMg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@sbsw_des/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2898098, "client_id": 3505419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba26b37b/uploads/origins/4fbc52c2-a231-483b-8405-bdfc4c870687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10b985fa3385f05c1d7310b26220cbd6", "srcset": "https://si.imgix.net/ba26b37b/uploads/origins/4fbc52c2-a231-483b-8405-bdfc4c870687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10b985fa3385f05c1d7310b26220cbd6, https://si.imgix.net/ba26b37b/uploads/origins/4fbc52c2-a231-483b-8405-bdfc4c870687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37b6b00f6b452002cf05abc28df87884 2x, https://si.imgix.net/ba26b37b/uploads/origins/4fbc52c2-a231-483b-8405-bdfc4c870687?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=678d5879860c5146aa3d7d3bd81b06f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba26b37b/uploads/origins/4fbc52c2-a231-483b-8405-bdfc4c870687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=772ea229009eb68b5fe3029331f5550d", "srcset": "https://si.imgix.net/ba26b37b/uploads/origins/4fbc52c2-a231-483b-8405-bdfc4c870687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=772ea229009eb68b5fe3029331f5550d, https://si.