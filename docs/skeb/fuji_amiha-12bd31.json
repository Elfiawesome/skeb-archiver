si.imgix.net/d3215732/uploads/origins/4afd3a3f-08b6-46a2-8d0f-85d56a5ac4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a419fafd2fb669688c92ac8c244160b, https://si.imgix.net/d3215732/uploads/origins/4afd3a3f-08b6-46a2-8d0f-85d56a5ac4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26434bd2da027578649435de288d47b8 2x, https://si.imgix.net/d3215732/uploads/origins/4afd3a3f-08b6-46a2-8d0f-85d56a5ac4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00f27a70ef12e5d44d07148bfbf068ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3215732/uploads/origins/4afd3a3f-08b6-46a2-8d0f-85d56a5ac4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe4a19514bf1608c9a7bdb8b7a067d4d", "srcset": "https://si.imgix.net/d3215732/uploads/origins/4afd3a3f-08b6-46a2-8d0f-85d56a5ac4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe4a19514bf1608c9a7bdb8b7a067d4d, https://si.imgix.net/d3215732/uploads/origins/4afd3a3f-08b6-46a2-8d0f-85d56a5ac4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f1776a9ae7515978853aa1c7c9d454a 2x, https://si.imgix.net/d3215732/uploads/origins/4afd3a3f-08b6-46a2-8d0f-85d56a5ac4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=19f59da57062d41bdaa5f492815bcaaa 3x"}, "body": "はじめまして！\n遊戯王OCGから、倶利伽羅天童をリクエストします。\n戦闘中の凛々しい作品をイメージしており、衣装にところどころダメージが入っていたり、簡単に硝煙の舞う背景もお願いします。\n上記以外の要素は先生に自由に描いてただけたらと思います。\nご検討いただけたらと思います。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fuji_amiha/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2737953, "client_id": 2505868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71a5bf95/uploa