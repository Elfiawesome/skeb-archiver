み飛ばして頂いて構いません）\n・裕福な老齢の夫婦に養い育てられた娘\n・幼い頃から血の繋がりはないと認識してるが、そのようなことは些事です、と構わず養父母のことが大好きで敬愛している\n・養父母の前では、いい子であろうととてもお淑やか、でも甘えたがり。\n・養母の影響で植物が好き。特に、名の由来となった山茶花は特に好きな花。\n・養父母から溺愛され、クローゼットには贈られた服でいっぱい\n\n以上となります\n\nhttps://twitter.com/Sasanqua_ykmr", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harutugeyuri/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6217, "client_id": 2651195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62475dec/uploads/origins/66119424-aacd-4878-a16f-e499629985fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db88344ba72a88811fef32e7f320c885", "srcset": "https://si.imgix.net/62475dec/uploads/origins/66119424-aacd-4878-a16f-e499629985fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db88344ba72a88811fef32e7f320c885, https://si.imgix.net/62475dec/uploads/origins/66119424-aacd-4878-a16f-e499629985fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a3aa43a166469d0299fcb28ec3f9555 2x, https://si.imgix.net/62475dec/uploads/origins/66119424-aacd-4878-a16f-e499629985fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b96ec1a17451f91186f0ec240e1e0018 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62475dec/uploads/origins/66119424-aacd-4878-a16f-e499629985fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af5fe8b34a6fab1f59ab5f0f664bc868", "srcset": "https://si.imgix.net/62475dec/uploads/origins/66119424-aacd-4878-a16f-e499629985fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af5fe8b34a6fab1f59ab5f0f664bc868, https://si.imgix.net/62475dec/uploads/origins/66119424-aacd-4878-a16f-e499629985fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20