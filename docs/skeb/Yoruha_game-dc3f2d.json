o use your illustration in my Vtuber Activities (Posts on YouTube, Twitch, SNS sites, and possible produce goods with them)\n\nI will credit you when I use your illustrations!\n\nThank you for considering my request.", "nc": 129, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@Yoruha_game/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 3650719, "client_id": 2054707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b71803a/uploads/outputs/4a85f6d3-50df-4f56-9a22-a80a085b67b3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5c9961b99c90460251f46c16cd46c20a", "srcset": "https://si.imgix.net/7b71803a/uploads/outputs/4a85f6d3-50df-4f56-9a22-a80a085b67b3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=5c9961b99c90460251f46c16cd46c20a, https://si.imgix.net/7b71803a/uploads/outputs/4a85f6d3-50df-4f56-9a22-a80a085b67b3?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=470f89a0165d8a02f599a7ac8fba6252 2x, https://si.imgix.net/7b71803a/uploads/outputs/4a85f6d3-50df-4f56-9a22-a80a085b67b3?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f884f800e36620535113be922ff1bdee 3x"}, "duration": 3, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b71803a/uploads/outputs/4a85f6d3-50df-4f56-9a22-a80a085b67b3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=bf109c86579597f827297b5f2e75ffad", "srcset": "https://si.imgix.net/7b71803a/uploads/outputs/4a85f6d3-50df-4f56-9a22-a80a085b67b3?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=bf109c86579597f827297b5f2e75ffad, https://si.imgix.net/7b71803a/uploads/outputs/4a85f6d3-50df-4f56-9a22-a80a085b67b3?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad1dee6369f197626f9b706c09f02592 2x, https://si.imgix.net/7b71803a/upl