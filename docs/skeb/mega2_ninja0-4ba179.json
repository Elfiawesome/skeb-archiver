f&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b86eaec0e72c5fadb1e4f78eb6b70d4 2x, https://si.imgix.net/952047a6/uploads/origins/b4a8455b-a35d-4d09-933c-fe6cdbee86bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cf28eca97affdc39b92969d9db45de3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/952047a6/uploads/origins/b4a8455b-a35d-4d09-933c-fe6cdbee86bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20664b805f641e99ef87dd11926c8f43", "srcset": "https://si.imgix.net/952047a6/uploads/origins/b4a8455b-a35d-4d09-933c-fe6cdbee86bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20664b805f641e99ef87dd11926c8f43, https://si.imgix.net/952047a6/uploads/origins/b4a8455b-a35d-4d09-933c-fe6cdbee86bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5681cdbc4051df302fb01aeb35bd4681 2x, https://si.imgix.net/952047a6/uploads/origins/b4a8455b-a35d-4d09-933c-fe6cdbee86bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d67dd126ac6b19c296b96d2a90f1f45 3x"}, "body": "リクエストです。\n描いて欲しいキャラは『閃乱カグラ』シリーズの芭蕉と鴇の2人です。\n衣装は2人とも全裸で、イラスト全体の構図はベッドの上で1人が仰向けに、もう1人がその上に覆い被さって2人で「おまんこサンドイッチ(割れ目の上半分が密着していて、下半分ぐらいが丸見えな感じで)」をしていて、画角はお尻側が正面にきて顔やおっぱい(仰向けになってる子の片方の乳が丸見えで、上に乗ってる子の片乳の乳輪が半分ぐらい見えてる感じで)など身体全体が見える感じで描いて欲しいです。\n2人とも陰毛は無しで、お尻の穴も描写して欲しいです。\n「芭蕉が上で鴇が下」と「鴇が上で芭蕉が下」の2パターン描いて欲しく、表情はどちらのイラストも「芭蕉は困り顔でかなり恥ずかしそうにしている」「鴇は誘惑するような自身ありげなドヤ顔」で描いて欲しいです。\nおっぱいやお尻は鴇の方が一回り大きいサイズ感で描いて欲しいです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mega2_ninja0/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1929141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a73ecf71/uploads/origins/e27ad256-fe16-4e96-90cb-c82