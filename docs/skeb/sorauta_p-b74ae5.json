c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b947e83d7ce765bba610715d46b768", "srcset": "https://si.imgix.net/0d6c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b947e83d7ce765bba610715d46b768, https://si.imgix.net/0d6c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75d00dff14f80993dc195e285e83de79 2x, https://si.imgix.net/0d6c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5deaed5c4e25aaaaf50ae90d2e1ccaf2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d6c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a1512384e7875abc1da028da9c5a33f", "srcset": "https://si.imgix.net/0d6c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a1512384e7875abc1da028da9c5a33f, https://si.imgix.net/0d6c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83781ea63a867898c7de05a56ec080a5 2x, https://si.imgix.net/0d6c2b32/uploads/origins/ac478fc4-fe7b-4e99-9f7c-a2daa3ae6dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6395def215b6ed20394085fcb22dc4fc 3x"}, "body": "そらうた様の描かれる学マスのイラストがどれも尊く恐縮ながら学マス×版権コラボの依頼を入れさせて頂きました。\n変化球な案件ではありますが、もし可能でありましたらご検討の程をお願いします。\n\n【キャラクター】\n某キノコの国のお姫様の従来ドレス衣装を着た学マスの紫雲清夏\n\nhttps://drive.google.com/file/d/1UiaJ4MSDMaMIIpv-H4tYkfYcgD3kIi6k/view?usp=drivesdk\n\n【シチュエーション】\nドレスを纏って花畑で振舞っている状況\n\n有頂天の中、花に化けた食中植物が清花に見惚れて背後から大口を開けて迫って来ている