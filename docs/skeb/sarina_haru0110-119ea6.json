髪で隠れて基本的には見えません。\n服装に関しては似合えばなんでも大丈夫です。本人は袴や着物など和物を好み、中でも絵にある袴スカートや、洋服ですとブラウスと膝丈のフレアスカートなどを特に好んで着ます。資料4枚目は着ている洋服の例です(落書きで申し訳ない…)。\nですが前述の通り、基本似合ったと思うものを着せて頂いて大丈夫です！\n性格は明るく、いつもどこかを放浪していて謎が多い印象のあるキャラです。食べることが好きです。(過去は喜怒哀楽の表現が希薄でした)\n\nぜひよろしくお願いいたします。\n\n資料↓\nhttps://drive.google.com/drive/folders/1iLHN67O3Fb4vW-EVncqbYIrEz4thZJKN?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 55476, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "テケ", "screen_name": "teke_oekaki", "avatar_url": "https://pbs.twimg.com/profile_images/1942434637126504448/YkfcnV9a.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3870026838/1751696397/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1137565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七月", "screen_name": "uuuusatama", "avatar_url": "https://pbs.twimg.com/profile_images/1750456735268298752/jzpUpkv-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382566100936781825/1706250438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1608132, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "3kuさく", "screen_name": "3kuiroiro", "avatar_url": "https://pbs.twimg.com/profile_images/1866280269743017984/lD1vZHLU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1452491618183901189/1650856093/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_req