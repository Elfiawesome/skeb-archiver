rigins/6fbc36f8-fa72-4224-bf35-310797e4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5e558e2c649baad42e86933c477f94b, https://si.imgix.net/e19c7c37/uploads/origins/6fbc36f8-fa72-4224-bf35-310797e4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00fe896f5583c3aa6e73198b02a397e3 2x, https://si.imgix.net/e19c7c37/uploads/origins/6fbc36f8-fa72-4224-bf35-310797e4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a019967bee4c89175afc0c16fc5c4bea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e19c7c37/uploads/origins/6fbc36f8-fa72-4224-bf35-310797e4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8acdaee02bb746a652a84ca4cf5e05ef", "srcset": "https://si.imgix.net/e19c7c37/uploads/origins/6fbc36f8-fa72-4224-bf35-310797e4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8acdaee02bb746a652a84ca4cf5e05ef, https://si.imgix.net/e19c7c37/uploads/origins/6fbc36f8-fa72-4224-bf35-310797e4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6fca4505c1a79cac161adf4ca2bcfe8c 2x, https://si.imgix.net/e19c7c37/uploads/origins/6fbc36f8-fa72-4224-bf35-310797e4c469?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59c592821cad6548b02281dfb25f520f 3x"}, "body": "こんにちは。\n早速ですが、二次創作の依頼をさせていただきます。\n対応可能でしたらお願い致します。\n\n\n【作品名】\nティンクルスターナイツ\n\n\n【対象キャラクター】\n桜十路 エルデリーゼ\n\n\n【対象キャラクターのキャラ設定について】\nお金持ちのお嬢様で、箱入り娘として大切に育てられた清楚系な少女です。\n今まで屋敷に籠って育ったため世間知らずで、作品の舞台となる学園で初めて外の世界を見た為か、好奇心旺盛な性格です。\n尚、物語の主人公とは年下(主人公は学園2年生(＝高校生相当)で、エルデリーゼは学園よりも若い生徒たちが通う附属校の3年生(＝中学生相当))なキャラクターです。\nまた、エルデリーゼの個別シナリオでは主人公と恋仲の関係であったりします。\n\n\n【服装】\n全裸\n\n\n【胸の大きさ】\n絶壁であり膨らみがほぼ無いです\n\n\n【シチュエーション】\n１．エルデリーゼが主人公であるクロト君のおちんちんを胸で挟もうとするいわゆるナイズリしているイラストを描いて下さい。\n\n２．シチュエーションのイメージ的には大好きなクロト君に気持ち良くなってもらおうと一生懸命薄い胸を挟もうとしておちんちんを擦っているいる感じです。\n\n\n【備考】\n上記記載以外についてはお任せします。\nもし金額・工数に見合わなかったり、シチュエーション等で内容が描きずらい等あれば「再送依頼」もしくはキャンセルまたは、レ モ ン ぴーる様の裁量で変更・アレンジしてOKです。\n\n\n対応可能でしたら何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/101Mx-2tLlIuO9EnHNG9NR0hQOM6csDYG?usp=sharin", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LemonPEEl2019/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2756549, "client_id": 3904354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e699f08e/uploads/origins/b421d2e5-13bb-4779-a696-1ac7efb2a524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049c7eb83a63b40e1706360e49ad0a9c", "srcset": "https://si.imgix.net/e699f08e/uploads/origins/b421d2e5-13bb-4779-a696-1ac7efb2a524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049c7eb83a63b40e1706360e49ad0a9c, https://si.imgix.net/e699f08e/uploads/origins/b421d2e5-13bb-4779-a696-1ac7efb2a524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d92d3d90afe2efb04af076b3e3b27d6 2x, https://si.imgix.net/e699f08e/uploads/origins/b421d2e5-13bb-4779-a696-1ac7efb2a524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a5170d4d87a43bf1a40ecf119520ad2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e699f08e/uploads/origins/b421d2e5-13bb-4779-a696-1ac7efb2a524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86c2e7400d7b427a96e8673c2300e375", "srcset": "https://si.imgix.net/e699f08e/uploads/origins/b421d2e5-13bb-4779-a696-1ac7efb2a524?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86c2e7400d7b427a96e8673c2300e375, https://si.imgix.net/e699f08e/uploads/origins/b421d2e5-13bb-4779-a696-1ac7efb2a524?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro