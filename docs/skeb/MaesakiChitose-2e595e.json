5/uploads/origins/89d65c16-6324-4b4f-a21c-1022f81cf0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0b2e7a499cada707e082a655e81db9d", "srcset": "https://si.imgix.net/ebe30645/uploads/origins/89d65c16-6324-4b4f-a21c-1022f81cf0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0b2e7a499cada707e082a655e81db9d, https://si.imgix.net/ebe30645/uploads/origins/89d65c16-6324-4b4f-a21c-1022f81cf0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a443d3d1eaa566d41bb0766cacf3524 2x, https://si.imgix.net/ebe30645/uploads/origins/89d65c16-6324-4b4f-a21c-1022f81cf0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02961e016628c8acf33d4d3d538422de 3x"}, "body": "開発者さん、こんにちは。寒さが増す今日この頃、お元気でいらっしゃいますように。\n\nこんなちょっぴり変わったルートからでも、時々ご挨拶できることを嬉しく思います。\n\n最近、ふと思うことがあります。 YouTube村で時々見かけた猫ちゃんがいたのですが、最近姿が見えなくなってしまって……。 もしよろしければ、開発者さんに迷い猫探しを手伝っていただけないかと思いまして。名前は「チトセチコ」というようです。\n\nイメージとしては、以下のようにお願いしたいです。\n\n電柱があって、開発者さんのオーナーキャラが迷い猫の描かれた**「迷子チラシ」** を貼っているシーンです。 冬なので、服装は冬仕様で……焼き芋の帽子とマフラーが可愛いと思います！\n\nその他の部分はおまかせでお願いいたします。 もし楽しいバリエーションなど思い浮かんだら、そちらを優先して描いていただいても構いません。\n\nイェーイ✌️ピースピース✌️\nもし上記のリクエストがご無礼に当たるようでしたら、別のリクエストをお願いしたいと思います。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MaesakiChitose/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3271941, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c5218ca4a8e952415f12c144020b7c3", "srcset": "https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c5218ca4a8e952415f12c144020b7c3, https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6affcd45a07fa56f65d6d9a2eacaa150 2x, https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d76e2cf1b84b62165ba82cf7bde073be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=414319d918b73e2b97da28baa84d374e", "srcset": "https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=414319d918b73e2b97da28baa84d374e, https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee7be7cebb8a1760a2bf0aa23c01b240 2x, https://si.imgix.net/8b17b001/uploads/origins/86f3ad24-6fd1-47c6-a866-c7b849fa88a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6379f6e9d43cfaecaac5027311e7d99f 3x"}, "body": "開発者様、こんにちは。  \n最近日本の天気てとても暑いようですね、健康とコンディションにお気をつけください。  \n\n今回お願いしたいキャラクターは、『艦隊これくしょん』に登場する**天津風 改二**です。  \n個人的に艦これというゲームはしばらくプレイしていませんが、それでも10年以上楽しく遊んだ思い出があり、今でも時々ログインしています。  \nその中で一番好きな子がこのキャラクターです。初めて実装されたとき、私はまだ中高生で、デザインも声も特別な思い出のある子です。  \n\n細かいところはいろいろあるにはあるが\nディテールに関して一番重要にお伝えしたい点は、衣装が半透明の素材であることです。  \nそして、彼女と一緒にいるマスコットキャラクター「延長砲くん」は、描いていただいても、省略していただいても構いません。  \nただし、追加する場合は天津風の体を隠さないように配置していただければ幸いです。  \n\n構図とポーズについて、  \n**片足がロープのようなもの（細くて長い物体で、紐のような別の質感でも構いません）で縛られ、足が上で頭が下になる構図**を必ずお願いしたいです。  \n全身の絵／簡単な背景／シチュエーションはおまかせ（シリアス／ファンタジー／コミカル..さりげない色っぽさを少し込めて..）  \nその他の部分は全ておまかせでお願いいたします。  \n\nよろしくお願いいたします。ありがとうございます", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MaesakiChitose/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3271941, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c05e6277971917f5b7fa7b5379f09394", "srcset": "https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c05e6277971917f5b7fa7b5379f09394, https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c97c709ff8cbb58c687ac70a119d4fe 2x, https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b66949d506873b0daf7d1cce31110035 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52b0071cc424933c994f617dac327b68", "srcset": "https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52b0071cc424933c994f617dac327b68, https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52fe341a1efa9871ad04bbf148293787 2x, https://si.imgix.net/34ef9a3b/uploads/origins/290cfda3-077e-4902-b709-10f0ca2d84a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69a892c9e533dc9fff295eea1a018435 3x"}, "body": "開発者さん、こんにちは。\nお忙しいところ失礼いたします。\n\n私がよく遊んでいるゲームに、最近新しく実装されたキャラクターが二人います。\nどうやらその二人、かなり人気があるようです。\nそこで、最近話題のあの子たちを描いていただけたら嬉しいなと思い、ご連絡させていただきました。\n\n\n\nポーズは、二人が背中を合わせて肘を絡め、一人がもう一人を背負い上げるというものをベースに、\nディテールを追加して描いていただけたら幸いです。\n（animeの体育シーンなどでよく見るポーズです?）\n前髪や横髪が重力に沿って自然かつ華やかに流れるような表現にしていただけると嬉しいです。\nまた、ピースサインやウインクなども加えて、鮮やかで華やかな雰囲気に仕上げていただけたら幸いです。\n\n\n参考になる画像はこちらになります：\nhttps://imgur.com/a/123-AU05Oqt\n\nキャラクターの雰囲気や設定は、以下の動画をご覧いただけると幸いです：\nhttps://youtu.be/rJy_MchSCpM?si=NNB8liRzQwLXZodb\n\n\n金髪と青髪の2人で、魔法少女の衣装を着ています。\nそれぞれの衣装にはけっこう違いがあって、片方はノースリーブ、もう片方は長袖です。\n\nいつも素敵な作品、ありがとうございます", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MaesakiChitose/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3271941, "client_id": 3442727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09145aeed864d875bb36ca6cdcb8cf3a", "srcset": "https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09145aeed864d875bb36ca6cdcb8cf3a, https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84a0d18927eea4e2709fc5f3ea477247 2x, https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8e93f49d4293c148ef9d305fc53b792 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa6539d15c7f28bb31c3e971b51c2bfd", "srcset": "https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa6539d15c7f28bb31c3e971b51c2bfd, https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=059f5e060f2c556e02ecc10ec367da33 2x, https://si.imgix.net/e3278d73/uploads/origins/aa05affb-4c11-4a72-94cc-a0736bb92748?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=058f49f0aeed719e3913140b1d1b40a7 3x"}, "body": "開発者様、こんにちは。\n\n「学園アイドルマスター」というゲームをご存知でしょうか。\n私は最近このゲームを始めたのですが、花海咲季（はなみ さき）というキャラクターにとても惹かれました。\n\n情熱的で自信にあふれるキャラクター、そして印象的な強烈な赤のイメージがとても魅力的で、出会って数秒でファンになってしまいました。\n\nポーズはMVに登場する振り付けの中からおまかせで、\n彼女の持つ「強烈な赤」が際立つように描いていただけると嬉しいです。\n始めたばかりなので、私が何か勘違いしている部分もあるかもしれませんが、とりあえずの第一印象はそうでした。\n\n以下、参考にしていただきたいMVのリンクです：\n↓↓↓\n\nhttps://youtu.be/384XBeDNH6g?si=Zqq2ehVrxIVCzcSd\n\nhttps://youtu.be/yGrf1I9HwVI?si=ohFqf_M2sQiOHyzQ（この cover MVを見て、ゲームを始めました. かっこいい）", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MaesakiChitose/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3271941, "client_id": 3442727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d4132aaad0a76b7714de3ae3fc285a8", "srcset": "https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d4132aaad0a76b7714de3ae3fc285a8, https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4341f419818fb23796a5eb26c7412c6a 2x, https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5da4945239f9d099dea3bc043df91dc9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b4bf6cd6de85ec03c25697823630c8", "srcset": "https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7b4bf6cd6de85ec03c25697823630c8, https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a25f0fb484ef555fae753c19ea68362 2x, https://si.imgix.net/4b11eb20/uploads/origins/aeed2362-ad03-4339-a731-4f0b0d70e914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d06c5a040becfba6caceab02243cd5b 3x"}, "body": "開発者さんこんにちは。\n今回お願いしたいのは、「トリッカル・リバイブ」というゲームに登場するオパールちゃんです。\n（※日本ではサービスされていなくて、ごめんなさい）\n\nオパールちゃんは、いちばん最近のオパールの宝石から生まれたオパールのドラゴンです。\nそれぞれ違うモチーフをルーツにこの世界に生まれてくるっていう設定が、私には幻想郷を思い出させるところがありました。\n\nそれぞれ違う宝石や鉱石から生まれるドラゴンたちは、だいたい年上な子が多いんですけど、\nオパールちゃんは生まれたての、まさに本物のあかちゃんドラゴンです。\n\n泣き虫で、力も弱くて、いろいろと頼りないけど、その分、年相応の純粋さを持っています。\nその純粋さゆえに、周りの目を気にせずに痛いところをズバッと突いちゃうところが、面白いネタにもなっています。\n\nこのキャラを選んだ理由は、単純に「めっちゃかわいいから！」ってだけじゃなくて、\n開発者さんの柔らかい塗りとあたたかい色使いがすごく好きなので、\n洗練されてて、ふんわりしたパステルカラー＋ミルクっぽい白色を持ったオパールちゃんを見てみたいなって思ったんです。\n\n↓以下はキャラのコンセプト映像のリンクです（字幕がなくてごめんなさい）\n「こんな見た目で、こんな声なんだ〜」くらいに思っていただければうれしいです。\n\n-------------------\n-------------------\nhttps://youtu.be/pplps0Uyixc?si=6sfu2xkvYlOrJEBm\nhttps://youtu.be/DDQYbMqPs0A?si=fuamXKR_30ZfkoML\nhttps://www.youtube.com/watch?v=j_xjVigLz38\n\n// 最後の動画の最後のシーンで、ずっと泣いていたのに、仲のいい友達に会えた嬉しさで涙がぴたっと止まって、パッと笑顔になるところ、本当に可愛くないですか？\n\n+++++++++++++++++\n+++++++++++++++++\n\nポーズや構図はオマカセでお願いします。\nただし、オパールちゃんの宝石でできた角や、身につけている日傘はキャラクターにとってとても大事な部分なので、隠れずにちゃんと見えるようにお願いしたいです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MaesakiChitose/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3271941, "client_id": 3271973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759a026aa35fa0fef8f7a07b79c04760", "srcset": "https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759a026aa35fa0fef8f7a07b79c04760, https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b92595e797b65e88245740faee8dd67 2x, https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e5c9f557d8fdf4401c3b3e0192691f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e49544ee83e060e2184a486cf28cc98", "srcset": "https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e49544ee83e060e2184a486cf28cc98, https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=adedcd5ace6ca3aa2fa955e9b8b76a6e 2x, https://si.imgix.net/d9712ba9/uploads/origins/8457ff75-f2ed-47eb-baa9-a4abb3255fe7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e5a074cbc1ff5c165fae51b801bdf38 3x"}, "body": "とんでもない寒波に襲われて思いついたものになります\n\n概要\n4匹の動物がコタツに入っているのを上から見たイラスト\n\n詳細\n・コタツ\n4人用のコタツです。コタツの掛け布団の柄はお任せ致します。\n\n・動物\n4匹です。詳細は以下の通りです\n①イヌ\n・モデルはゴールデンレトリバー(成犬)\n・しっぽと下半身がコタツから出ている状態\n・足を広げて寝ている\n②ネコ\n・モデルはノルウェージャンフォレストキャット(成猫)を考えていますが、他にモデルとして描きやすいネコがあればそちらでも構いません。\n・状態などは①と同じです。\n③キツネ\n・「千年チコが本当のキツネなら...?」という感じで描いていただけると嬉しいですが...\n厳しければキタキツネ(冬毛)でお願いします。\n・状態などは①と同じです。\n④フリー枠\n・ウサギ、シベリアンハスキー、ニワトリ、モルモットなどを考えていましたが、決めきれませんでした。先生の描きたい動物をお描きください。もちろん描かないというのでも大丈夫です。\n・状態などもお任せ致します。\n\n・床\n希望は畳ですが、フローリングでも大丈夫です。\n\n・コタツの上に乗ってる小物類\nみかんを乗せておいてください。(個数、位置、状態【皮がむけているなど】はお任せします)\nそれ以外はお任せ致します。\n\n・条件など\n正月3が日あたりの午後〜夕方の時間帯で描いていただけると幸いです。\nその他の部分(床の小物など)はお任せ致します。\n\n大変寒い中ですが、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MaesakiChitose/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3271941, "client_id": 3442727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b883412/uploads/origins/14f12355-6251-4291-b044-6c2d9089396e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75a11db74366173c86a9ee82c2db8cbb", "srcset": "https://si.imgix.net/0b883412/uploads/origins/14f12355-6251-4291-b044-6c2d9089396e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75a11db74366173c86a9ee82c2db8cbb, https://si.imgix.net/0b883412/uploads/origins/14f12355-6251-4291-b044-6c2d9089396e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65622ed55d49055dc82598906b6f2770 2x, https://si.imgix.net/0b883412/uploads/origins/14f12355-6251-4291-b044-6c2d9089396e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf7186eb52953e3a050621903ecb1c22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b883412/uploads/origins/14f12355-