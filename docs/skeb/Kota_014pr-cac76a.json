 if you keep their huge height difference in mind. I would be happy if you could include a simple background and transparent versions! If you could add for the background some red and blue rose petals and razor blades or knives. If that should be okay for you. \n\nThank you very much for your consideration.\n\nhttps://drive.google.com/drive/folders/1-A7BYIsRbqNhiC5wwOY5Vr7aJ__JFEfQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kota_014pr/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3553015, "client_id": 1698798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df4f966d/uploads/origins/df99cc79-c58e-41c7-b239-4c0f39828a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=910a985f84d4b0b690ce57d896ff39e0", "srcset": "https://si.imgix.net/df4f966d/uploads/origins/df99cc79-c58e-41c7-b239-4c0f39828a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=910a985f84d4b0b690ce57d896ff39e0, https://si.imgix.net/df4f966d/uploads/origins/df99cc79-c58e-41c7-b239-4c0f39828a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7a525371922ef327f2791ec86a460d9 2x, https://si.imgix.net/df4f966d/uploads/origins/df99cc79-c58e-41c7-b239-4c0f39828a78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0c7d1756b7d27e5770e5b63bca457c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df4f966d/uploads/origins/df99cc79-c58e-41c7-b239-4c0f39828a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff4447e205a71440ee375f9233e36449", "srcset": "https://si.imgix.net/df4f966d/uploads/origins/df99cc79-c58e-41c7-b239-4c0f39828a78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff4447e205a71440ee375f9233e36449, https://si