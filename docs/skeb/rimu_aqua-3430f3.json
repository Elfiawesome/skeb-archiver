c2df1545f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=764fef3d85365e24741570e0ff9d7302, https://si.imgix.net/891a6218/uploads/origins/35569fc7-a36c-45ef-acce-a5c2df1545f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0cb584f34fe14f274bfaedbeb9eed61 2x, https://si.imgix.net/891a6218/uploads/origins/35569fc7-a36c-45ef-acce-a5c2df1545f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=865fe45e102e73f7a92e4c8e8964cf78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/891a6218/uploads/origins/35569fc7-a36c-45ef-acce-a5c2df1545f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd025dbe2c38656e8e9159bfde60339f", "srcset": "https://si.imgix.net/891a6218/uploads/origins/35569fc7-a36c-45ef-acce-a5c2df1545f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd025dbe2c38656e8e9159bfde60339f, https://si.imgix.net/891a6218/uploads/origins/35569fc7-a36c-45ef-acce-a5c2df1545f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6f38d44f1fa1266594bbd86256383a9 2x, https://si.imgix.net/891a6218/uploads/origins/35569fc7-a36c-45ef-acce-a5c2df1545f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bb07cb4bd227d3d39e1dfe3c5f11d93 3x"}, "body": "いつもお世話になっております。\nイラストの色塗りをお願いしたいです。イメージとしての色は決まっているのでこれらをベースにお願いしたいです。\n線画は不要な部分があれば剪定していただいて構いません。\n\n【説明】\n猫と暮らす人間の姿をしたAIになります。\n世界が火の海になり、彷徨った末に辿り着いた場所がとても白い図書館。\n人間が滅んでしまったが故に人の感情が分からず、初めて出会った猫ですら時折人間らしからぬ思考を話したりするが、後々過ごしていくうちに人間のように猫吸いをし始めたり、急に撫でまわしたりする。\n皮膚は人間と同じく健康的な色をしています。繋ぎ目などは見えない。本当にただの人間にしか見えないようにお願いします。\nＡＩなので性別はありませんが、男性にも女性にも見えるように描いて頂けるとなお幸いです。人によって男女が分かれるといいと思っています。\n\n【シナリオNPC説明文】\nいつも座って何かをやっている。忙しい時は構ってくれないし、構ってほしくない時に構ってきたりする。ただ、こいつ以外に同じ姿をした「ニンゲン」は見たことがない。\n\n【シナリオ概要】\nニンゲンとは窮屈な生き物だ。少なくともわたしはそう思う。\n偏見の混じった毒を吐き捨てて、わたしたちはいまだ微睡み続けている。\n\n【ボイスサンプル】\n「ねこ～～。無理～～。何もしたくない～～～～」\n「人間には“負の感情”というものがあったみたいなんだ」\n「悲しみ、怒り、憎しみ、苦しみ、妬み、不安、…数えたらキリがない」\n「良いものと悪いものの違いがよくわからないんだけど…元の場所に戻しておいたほうがいい？」\n「私の昔話でもしようか」\n「その温かいモノは私に擦り寄ってはゴロゴロと音を鳴らしていた」\n「…君はソレとそっくりなんだ。ねこって言う名前なのも後から知った」\n\n\n他何か説明があればお聞きください！\n\n\nhttps://drive.google.com/file/d/1zI079_MuYuPiOoMcWONnn9wp5OQvKTc_/view?usp=sharing\nhttps://drive.google.com/file/d/1r9oP-hN1evhOsJTFYg7OwoJf12NfAf4q/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimu_aqua/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2684157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d23fc73c/uploads/origins/270ae67b-efd3-4df1-abd4-62de1b90d1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f51c97f72cf837e4979101649034989a", "srcset": "https://si.imgix.net/d23fc73c/uploads/origins/270ae67b-efd3-4df1-abd4-62de1b90d1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f51c97f72cf837e4979101649034989a, https://si.imgix.net/d23fc73c/uploads/origins/270ae67b-efd3-4df1-abd4-62de1b90d1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec5288b4cc68df477c76e9b3111d09f5 2x, https://si.imgix.net/d23fc73c/uploads/origins/270ae67b-efd3-4df1-abd4-62de1b90d1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33f491f95e4a10fcd9ddf63c2994c0d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d23fc73c/uploads/origins/270ae67b-efd3-4df1-abd4-62de1b90d1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10d705a4404a7efb44cf47bb66daf593", "srcset": "https://si.imgix.net/d23fc73c/uploads/origins/270ae67b-efd3-4df1-abd4-62de1b90d1ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10d705a4404a7e