ている。\n\n真琴は(A)のように黒いスーツとパンツに白いボタンのシャツを着ている。金色のネクタイをしている。真琴は青い猫の尻尾を持ち、参考資料(I)のように尻尾に腰のベルトを余分に巻いている。手首には参考資料(J)と同じデザインのベルカラーを巻いている。\n\nポーズは参考資料(C )と同じような感じで、主なディテールはビール、参考資料(F)のような真琴の酔っぱらいの笑顔、巨大な剣にもたれかかる、剣のデザインはハイテクに見えれば何でもいい。\nすべてのリファレンスは、アルファベットのA～Gでラベル付けされたドライブの中にある。\n\nhttps://drive.google.com/drive/u/4/folders/1jOAJI8bpkDR9sEICmWUPNMet7zNUwAVZ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shana_oh_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3232437, "client_id": 2588067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8a6518c/uploads/origins/8e312338-535d-4732-810c-e4470dc07291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef93e46f455b65149d6d5fb97510c77d", "srcset": "https://si.imgix.net/e8a6518c/uploads/origins/8e312338-535d-4732-810c-e4470dc07291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef93e46f455b65149d6d5fb97510c77d, https://si.imgix.net/e8a6518c/uploads/origins/8e312338-535d-4732-810c-e4470dc07291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3814c33ee1f429b39b8f7fa9abdbbcf2 2x, https://si.imgix.net/e8a6518c/uploads/origins/8e312338-535d-4732-810c-e4470dc07291?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e718ba78e7b611813ee38f43e9a4a1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8a6518c/uploads/origins/8e312338-535d-4732-810c-e4470dc07291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a45cf79f837d0974a00a773724846d00", "srcset": "https://si.imgix.net/e8a6518c/uploads/origins/8e312338-535d-4732-810c-e4470dc07291?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a45cf79f837d0974a00a773724846d00, https://si.imgix.net/e8a6518c/uploads/origins/8