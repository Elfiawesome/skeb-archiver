f-89c054ecb9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c9ca8f254d31964a288d1871a1e9e30, https://si.imgix.net/eb2ad954/uploads/origins/0f7fdf85-ea71-4b61-a37f-89c054ecb9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=876c95ca5587ab1ad186e9ed316c547c 2x, https://si.imgix.net/eb2ad954/uploads/origins/0f7fdf85-ea71-4b61-a37f-89c054ecb9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71fee780c56d79f03e71f7d504114d41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb2ad954/uploads/origins/0f7fdf85-ea71-4b61-a37f-89c054ecb9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a15ed2b74221c6873d1f0d1bb0ec37c", "srcset": "https://si.imgix.net/eb2ad954/uploads/origins/0f7fdf85-ea71-4b61-a37f-89c054ecb9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a15ed2b74221c6873d1f0d1bb0ec37c, https://si.imgix.net/eb2ad954/uploads/origins/0f7fdf85-ea71-4b61-a37f-89c054ecb9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51afe8cf309853a78b4e2c23c68a0170 2x, https://si.imgix.net/eb2ad954/uploads/origins/0f7fdf85-ea71-4b61-a37f-89c054ecb9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b82cb7589307926b1e690b3595556bc 3x"}, "body": "はじめまして。\n絵柄や表情がとても素敵でしたのでリクエストさせていただきました。\n\nゆにふぃ！所属のVTuber「織田詩信」さんへch登録1万人記念のFAプレゼントをしたいと考えています。\n\n【リクエスト内容】\nお祝いで乾杯してるところかケーキを食べるところを希望します。\n※キャラ以外の分も大まかに含めて金額設定させていただきましたが、不足している場合はお手数ですが再送をお願い致します。\n\nその他はお任せいいたします。\n\n【使用目的】\n・FAプレゼント\n・Vtuber本人に限りの配信活動（配信内や配信のサムネイル、Twitter等で使用する可能性があります）において、イラストの使用許諾をいただければ幸いです。\n　※Youtubeは収益化済チャンネルとなります\n\n【その他】\n人物と背景などを分けたPSDでいただけますと幸いです。\n\n宜しくお願い致します。\n\n参考：\n・ゆにふぃ！の二次創作ガイドライン：\n　https://evestar.jp/unifeee/?page_id=350\n\n・三面図\n　https://x.com/Unifee_nobu/status/1763900685563924976\n\n・新衣装\n　http