Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3187a6bfc64905698070dd293444264, https://si.imgix.net/4df827d2/uploads/origins/fbb0c479-9636-463b-be58-396c971a8565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e9678cbb730b8567054ef59406c17c4 2x, https://si.imgix.net/4df827d2/uploads/origins/fbb0c479-9636-463b-be58-396c971a8565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=217c80c16143a6896168fcfd706571ba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4df827d2/uploads/origins/fbb0c479-9636-463b-be58-396c971a8565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26e35904d75071f7c1149c7872e23f28", "srcset": "https://si.imgix.net/4df827d2/uploads/origins/fbb0c479-9636-463b-be58-396c971a8565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26e35904d75071f7c1149c7872e23f28, https://si.imgix.net/4df827d2/uploads/origins/fbb0c479-9636-463b-be58-396c971a8565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c306c2338fedd2c9bfe5369322e9e8ee 2x, https://si.imgix.net/4df827d2/uploads/origins/fbb0c479-9636-463b-be58-396c971a8565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c32f1038ca4840b11119b47b70c1c3df 3x"}, "body": "はじめまして！pixivで絵をお見掛けしていつか依頼をしたいと思っておりskeb再開と聞いて飛んでまいりました！\n今回依頼したいのはうちのこの細身で女の子みたいな白肌銀髪銀眼の美少年です。細身で美少年の割にはちんぽはかなり立派です。\n添付した資料は成年版ですが今回は高●1年を想定します。\n\nシチュは『練習に参加させてもらう代わりに部長から彼女の代わりに生ハメを要求される』です。\n背面騎乗位で乳首やちんぽもいじめてくれればと思います。竿役の部長はモブなので顔などは映らないようにし！うちのこメインの構図にしてください。\n衣装は鈴のついた首輪に猫耳カチューシャ、裸エプロンか布面積の小さい水着を脱がされ、ちんぽには射精管理と辱め用にリボン。\n\n他の部員からの辱めを救ってくれたことから信用しきっていた部長からの裏切りで恥ずかしい格好をさせられ挙句には周りから同様に犯されてるものの、これまで何度もレイプされ開発されきった体はちんぽも乳首も嫌がりながらも感じてしまい中出しと同時に絶頂射精、という流れの差分をお願いします。かっこかわいく汚してください。\nSNS掲載OKです。画面は横向きでpsdでお願いします。修正は海苔でお願いします。\n髪型のはね方に関してはあまり柔らかすぎず原神の重雲のような感じで、色に関しては参考資料の野球絵にあるような完全な銀色を意識してください。\n\n参考\nhttps://drive.google.com/file/d/1iCZaQtq0xbAZnGImCn81--VUR_jCrSin/view?usp=drivesdk\nhttps://drive.google.com/file/d/1LaGY0YiiOPvCiRsgjExYdtlB3wfF3_5m/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1GUG4lhzPcXRRRw_x3AlFAtyZ6ilZAZxF/view?usp=drivesdk", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@furusa5481/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 469828, "client_id": 66065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d654f71c/uploads/origins/fe104c25-88b3-426c-85ba-fd61007301a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc852b09001fdf0f0b923be07f87d5c0", "srcset": "https://si.imgix.net/d654f71c/uploads/origins/fe104c25-88b3-426c-85ba-fd61007301a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc852b09001fdf0f0b923be07f87d5c0, https://si.imgix.net/d654f71c/uploads/origins/fe104c25-88b3-426c-85ba-fd61007301a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54c429463516a75e744181f5d11c9624 2x, https://si.imgix.net/d654f71c/uploads/origins/fe104c25-88b3-426c-85ba-fd61007301a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c11edbec88d962c30766baab1fa6fc79 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d654f71c/uploads/origins/fe104c25-88b3-426c-85ba-fd61007301a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a663bde28ecfbe00ea81e9074e39c0c", "srcset": "https://si.imgix.net/d654f71c/uploads/origins/fe104c25-88b3-426c-85ba-fd61007301a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a663bde28ecfbe00ea81e9074e39c0c, https://si.imgix.net/d654f71c/uploads/origins/fe104c25-88b3-426c-85ba-fd61007301a9?bg=%23fff&auto=format%2Ccompress&fm=we