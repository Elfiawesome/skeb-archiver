23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b999714acb9e236193d5f611a202bba5 3x"}, "body": "うるあきさんのオリジナルキャラクターである伊吹くん（狐くん）が競泳水着を着てポーズを決めているイラストを描いていただきたいです。\n\nhttps://www.pixiv.net/artworks/109655816\nhttps://www.pixiv.net/artworks/90919419\n\n・手を頭の後ろで組んで、腋見せガニ股ポーズで股間を見せつけている。\n・表情は笑みを浮かべている。\n・今回は、いわゆる形くっきりペニスの描き方ではなく、もっこりと丸く膨らんだ感じの描き方にしていただけると嬉しいです。\n・もし可能でしたらラフ段階のイラストなども含めていただけると嬉しいです。\n\n以上のような内容でお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@furusa5481/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 469828, "client_id": 66065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9946c3e193b7f558fc4b14e721e881c0", "srcset": "https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9946c3e193b7f558fc4b14e721e881c0, https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6235fbde071743d5baa943e135f820b1 2x, https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1faebc75a66c667856b08524de9de4b4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1524e35d946ad1a5a9a304ee4cd815b4", "srcset": "https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1524e35d946ad1a5a9a304ee4cd815b4, https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce2d9969fbbbed0d46519d294c92b65 2x, https://si.imgix.net/8ead37dc/uploads/origins/42e7a992-e113-44a3-8581-65ff9da67f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f06506b6b9292b6e23edc950cf435218 3x"}, "body": "先生、こんにちは。\n\nリクエストを受け付けてくださるようになったと知り、とても嬉しく思っています。私のオリジナルキャラクター「サムくん」を描いていただけないかとお願いしたく思っています。彼は小柄で内気な少年ですが、様々なエッチな状況に巻き込まれ（そしてそれを楽しんでいます）。キャラクターの参考画像はこちらです：https://rebrand.ly/9fm6r0q\n\n彼に、可愛くて体にぴったりとフィットする、ゴム製の天使のコスチュームを着せて描いていただけると嬉しいです。そのコスチュームはかなり露出度が高いもので。彼は嬉しそうに自慰行為をしているか、あるいは主人にその役目を任せてやっている様子を描いてください（https://rebrand.ly/b0d2b6）。\n\nその他の詳細は先生にお任せします。お時間を割いてご検討いただき、ありがとうございます。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@furusa5481/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 469828, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4824f8b9/uploads/origins/3d1881ea-287e-4cbf-957e-a311b2fb4e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007504422e1b577f3398041de5376abd", "srcset": "https://si.imgix.net/4824f8b9/uploads/origins/3d1881ea-287e-4cbf-957e-a311b2fb4e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007504422e1b577f3398041de5376abd, https://si.imgix.net/4824f8b9/uploads/origins/3d1881ea-287e-4cbf-957e-a311b2fb4e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a6d94c3d4d65f779af5ecd5cdd8057b 2x, https://si.imgix.net/4824f8b9/uploads/origins/3d1881ea-287e-4cbf-957e-a311b2fb4e93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e802e10c334b884d9afab92c1429b000 3x"}, "duration": null, "nsfw": false, "hardcore": false