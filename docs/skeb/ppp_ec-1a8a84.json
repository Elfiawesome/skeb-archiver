9cb6-61107f924843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7e2bbb6a0610f7b26092fb3d06d25e1 2x, https://si.imgix.net/7e5a2654/uploads/origins/fac1bf99-ff6c-42b5-9cb6-61107f924843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88566be7f9787b8cf84bd5caf73fbf5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e5a2654/uploads/origins/fac1bf99-ff6c-42b5-9cb6-61107f924843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe767ff304cdaf6910d6e30e074aef3e", "srcset": "https://si.imgix.net/7e5a2654/uploads/origins/fac1bf99-ff6c-42b5-9cb6-61107f924843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe767ff304cdaf6910d6e30e074aef3e, https://si.imgix.net/7e5a2654/uploads/origins/fac1bf99-ff6c-42b5-9cb6-61107f924843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abc1ecc5219ec10a738475cc27cc147a 2x, https://si.imgix.net/7e5a2654/uploads/origins/fac1bf99-ff6c-42b5-9cb6-61107f924843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b777fe692d618f08afb1dfef65d391b 3x"}, "body": "白圡さんはじめまして、こんにちは！突然の御依頼失礼致します。\n\n白圡さんの描く色、特に青色の表現や人の表情が大好きで、此の度はよろしければ私がTRPGセッション用に作成したオリジナルキャラクター1名の一枚絵を描いて頂けないかとリクエストを送らせて頂いております。\n以下、見たい構図等と簡易説明・資料になります。具体的にとのことでしたので細かく添えておりますが、遵守して頂かなくとも構いません。描きやすいようにして頂ければと思います。\n\n\n▽キャラクター名：神多羅木桜(カタラギ-ハル)\n　性別：男　年齢：17~18歳(高校三年生)\n　モチーフ：花札『桜に幕』/桜\n▽性格等\n容姿端麗、明朗快活の男子高校生。細身で浮世離れレベルの美人。\n人当たりも人付き合いも面倒見も良く人の中心に居る。いつも笑顔で、呼ばれれば手を振ってる。\n傍から見たら人生かなり楽しそう且つ人に愛されている幸福な男子高校生。\n然し隠しているだけで重度の不幸体質で、その体質故に自分は短命なのだろうと悟っている。そのため、この高校三年を悔いなく思い切り楽しみ、卒業後は消えてしまおうと考えている何処か危うく、儚さがある人。\n見目の美しさとその思想が相俟ってやはり何処か浮世離れしており、何となく概念的な面が強い。(幽霊、神様のような、異様に大人びたような雰囲気がふとした瞬間に覗く)　\nまた、自分のことを皆にとっての『学生時代の友達』という存在(学生時代は印象深い人物だが、卒業後何をしてるか不明で何となく記憶から静かに消えていくだけの存在)だと定義している。\n桜に攫われたり、還ったり。ふとした瞬間に風景に溶けていってしまいそうな青年。\n\n▽資料\nhttps://www.dropbox.com/scl/fo/b6qoymx99z7wkbgttcffb/h?rlkey=94urz09zucj7m1vt4tsydjj7i&dl=0\n\n▽構図\n青空を背景(青空の下でも構いませんし、窓越し等でも空が見えれば構いません)に、目を細めて笑っているような表情だと嬉しいです。\nその他は服装等も含め、白圡さんの描きやすいようにして頂ければと思います。\n\n\n以上です。ご検討いただけますと幸甚です。何か不備等あった際はキャンセル等して頂いて大丈夫です。\nよろしければよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ppp_ec/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b799205f/uploads/origins/da1926eb-0bd1-48a7-82ae-9a6364de3b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92333bec9ec10f4b69cb4dbaba0cde21", "srcset": "https://si.imgix.net/b799205f/uploads/origins/da1926eb-0bd1-48a7-82ae-9a6364de3b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92333bec9ec10f4b69cb4dbaba0cde21, https://si.imgix.net/b799205f/uploads/origins/da1926eb-0bd1-48a7-82ae-9a6364de3b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a8c0867a7b573e49c015c6c55b2c91ac 2x, https://si.imgix.net/b799205f/uploads/origins/da1926eb-0bd1-48a7-82ae-9a6364de3b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2291b82bfb56db7e7a891aa5e3fdb4bb 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2777874, "nc": 16}, {"path": "/@ppp_ec/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f4523aae/uploads/origins/906b0e91-d78f-4a42-93ca-57dc7f4184ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f90