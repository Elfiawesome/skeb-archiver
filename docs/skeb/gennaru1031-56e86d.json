ploads/origins/408c3627-289f-4f41-8b78-9458cb962dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df1be9d95de0cbf91df147f5e21071e8 2x, https://si.imgix.net/8fbaf6ec/uploads/origins/408c3627-289f-4f41-8b78-9458cb962dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0fc9f792b03a0a81aafd189173b18e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fbaf6ec/uploads/origins/408c3627-289f-4f41-8b78-9458cb962dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9746a5f730313930a0cacaf16f0405c", "srcset": "https://si.imgix.net/8fbaf6ec/uploads/origins/408c3627-289f-4f41-8b78-9458cb962dad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9746a5f730313930a0cacaf16f0405c, https://si.imgix.net/8fbaf6ec/uploads/origins/408c3627-289f-4f41-8b78-9458cb962dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2eec7db8f6fc0d3172ebb8d00953530 2x, https://si.imgix.net/8fbaf6ec/uploads/origins/408c3627-289f-4f41-8b78-9458cb962dad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa79bfdf9d599ac39a2afb280ce985f4 3x"}, "body": "ゲッちゃん！\n\nこんにちは！\nゲッちゃんにぜひともうちの子の節分イラストを描いてほしいです！！\n\n·描いてほしいこと\nうちの子2人（紫髪のイツノちゃんとウサ耳のシノちゃん）\n節分とわかる鬼の要素（ツノだったり鬼のパンツだったり、おまかせします！）\n\n·できれば描いてほしいこと\n節分を楽しんでいる雰囲気（豆まきしているとか鬼の仮面被ってるとか、節分を想像できる場面が良いです！）\n\n衣装は2人ともアレンジしてもしなくても良いです！\n描く範囲は顔だけでも腰上でも全身でも良いです！\n立ち絵でもいいし、ポーズしていても良いです！\n大事なのは節分のイラストだということと、できれば節分を楽しんでいる雰囲気がわかることです！！\n\nもし、描いてみたいと思ったらぜひお願いします！！！\n\n参考画像\nhttps://drive.google.com/drive/folders/1Nf7fv6gvQg3wR-8iQN66Zq6MxleGpUXh", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gennaru1031/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3251148, "client_id": 2986862, "vtt