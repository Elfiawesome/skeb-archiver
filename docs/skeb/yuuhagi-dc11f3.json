a73f2-c0a5-4f48-9259-ce579afae900?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b010fdf3b7609c358d02d66620db6856", "srcset": "https://si.imgix.net/74c3988b/uploads/origins/4b0a73f2-c0a5-4f48-9259-ce579afae900?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b010fdf3b7609c358d02d66620db6856, https://si.imgix.net/74c3988b/uploads/origins/4b0a73f2-c0a5-4f48-9259-ce579afae900?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03542a56392799ba45d6f32646a670aa 2x, https://si.imgix.net/74c3988b/uploads/origins/4b0a73f2-c0a5-4f48-9259-ce579afae900?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ebe5aa3941f7c6d7e0d2f0b5f24f38a 3x"}, "body": "日本語が話せないため、翻訳ツールを使わせていただき申し訳ありません！\n悠萩先生、こんにちは！以前から先生の作品の、可愛らしくて温かい雰囲気が大好きです！\n今回、うちの子供を描いていただけないでしょうか！\n\nキャラクター設定の参考：\nhttps://drive.google.com/drive/folders/1q7sF0Ca5nCXCEwGfka_N_U3LEok-0qMS?usp=drive_link\n彼女の名前はメタリス、年齢は10歳くらいで、静かで優しく、そして強い子です。特徴は金色の瞳と、鮮やかな青色の菱形の瞳孔です。\n\n構図：\nメタリスが参考画像のようなシンプルで可愛い白いワンピースを着て、カメラに向かってビーチに立っているイラストをお願いしたいです！服のディテールや具体的な背景などは、お好みで自由にアレンジしてください！\n\n用途：\nソーシャルメディアへの投稿やプロフィール画像として使用したいと思っています。いずれも個人利用です。\n\nご検討いただきありがとうございます。作品を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1q7sF0Ca5nCXCEwGfka_N_U3LEok-0qMS?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhagi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3919261, "client_id": 2014247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d36fd8b625fcca31a9806023703eaa", "srcset": "https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d36fd8b625fcca31a9806023703eaa, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e90720e36e75646d24459dcc86078c71 2x, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf2c85bf990e8330d6cef8be72b84614 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd767f4b4cf47f7ac3cf777870ab5fc", "srcset": "https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd767f4b4cf47f7ac3cf777870ab5fc, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1877d1912b7d0a0223d5f3cd68f0b0b 2x, https://si.imgix.net/62042d53/uploads/origins/765a7f1f-ed67-45c8-9960-cbe874a9b5e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a16527f941a25fcd89e17383268fa7e 3x"}, "body": "こんにちは！あなたのイラストは本当に素敵ですね。描かれる女の子たちはいつもとてもかわいいです！私のキャラクター、ニイリンを描いていただけませんか？[https://imgchest.com/p/ej7mwvmkjyd]\n\n彼女は寒冷な北の国出身の貴族の娘で、その奇妙な魔法を恐れる人々から逃れるために家を出ました。今は冒険者となり、魔法を使って魔法のスノードームの中に居心地の良い住まいを作っています！旅の途中や、スノードームの家でくつろいでいる姿、あるいは全く別のシーンなど、お好きなように描いてください！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhagi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3919261, "client_id": 543260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e13be9e5cfcb1e2090a987353b2d36", "srcset": "https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e13be9e5cfcb1e2090a987353b2d36, https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f089cd813cb50ad38f5f0e5f9b138a15 2x, https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04a26b11e6b908e5f3c102820d352778 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e52a327c1eb624de2a66b06b5d1e0f", "srcset": "https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e52a327c1eb624de2a66b06b5d1e0f, https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ffa5f72d18ccd6890799665e9b92f62 2x, https://si.imgix.net/eda33481/uploads/origins/8434a9ef-e370-483d-8fce-db959ed0ba7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4d3007f578cfc7646522cc8dee806df 3x"}, "body": "制服を着て、靴下は履かずに上履きを半脱ぎにしている白赤のこちゃんをおねがいできますでしょうか…………\n上履きは「上履き　バレーシューズ」で検索して出てくるようなよくあるものでお願いします。つま先のゴムの色はおまかせします。\n場所は教室だと世界観に合わないですかね…？陽のあたる木のベンチとかでうとうとしてるとかわいいかもです…！\n要は足元のだらしない白赤のこちゃんの素足を見たいです……可能でしたらよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhagi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3919261, "client_id": 1792056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6abfbe5f4cf03dc163a9088d06716a98", "srcset": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6abfbe5f4cf03dc163a9088d06716a98, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d7bee025b674a5fd2f59150ac8c22c1 2x, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93b2225322c7308d2bf55ea12178ff69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b6582149261bf0fd87c1e7e3c81775", "srcset": "https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b6582149261bf0fd87c1e7e3c81775, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acc85c6cd0ebcd04afebb282a5a77af6 2x, https://si.imgix.net/fea54aa9/uploads/origins/52df26ea-2094-4b6e-b7ef-9679fb0b3e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a7c1e93862e7c631213bd5a6123ac24 3x"}, "body": "こんにちは、悠萩さん。\n以前からSNSで作品を拝見しているファンです。\n可愛らしくて繊細なキャラクターイラストがとても好きで、この度リクエストさせていただきました。\n\n今回は、キャラクターデザインを含めて、猫耳と猫しっぽのある女の子をお願いしたいです。\n少し臆病だけれど優しい雰囲気の子をイメージしています。\n\n髪は長めのアイボリー系、瞳は淡いミントグリーンで、やさしいグラデーションと明るいハイライトのある感じだと嬉しいです。\n表情については、美しい場所にたどり着いたような、少し前向きで明るさの感じられる雰囲気だと嬉しいです。\n\n衣装は、白に近いごく淡いミント系のシフォンワンピースをイメージしています。\n透け感のあるやわらかなレイヤーが重なった、ふんわりと幻想的な印象だと嬉しいです。\nドレスに蝶結びのリボンを入れていただけたら嬉しいです。大きさや位置は、描きやすいようにご調整いただければと思います。\n\n足元は、メリージェーンシューズと白いフリルソックスでお願いしたいです。\n靴の色合いはお任せします。\n\n髪飾りとして、小さなヘアクリップを付けていただけたら嬉しいです。\n形は、角から見た立方体のように三面が見える、シンプルなキューブ形をイメージしています。\nこちらは参考画像を添付いたします。\nhttps://postimg.cc/bSrCKVmd\n\nシチュエーションは、海辺とオーロラを感じられる、静かで幻想的な雰囲気を希望しています。\n背景、ポーズ、構図などはお任せします。\nその子らしいやわらかさや可愛らしさが感じられる仕上がりだと、とても嬉しいです。\n\n全体として、描きやすい形にアレンジしていただけましたら嬉しいです。\n悠萩さんらしい感性や絵柄を交えて仕上げていただけましたら、とても嬉しいです。\n可能であれば、縦横比は8:5程度ですとありがたいです。\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhagi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3919261, "client_id": 154569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa75dab5b196e0d9829d57eeb9a56a0a", "srcset": "https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa75dab5b196e0d9829d57eeb9a56a0a, https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad8b96bffc32a0be4d576ed1e79dea34 2x, https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ecdf868c0057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8961058fe4689d382cce192c149b32e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccbb49c2/uploads/origins/54e1ca9f-ed9a-4ea5-8e3f-ec