gins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29de1afcd41d7a3a47f344794f5dd4d9", "srcset": "https://si.imgix.net/070262c6/uploads/origins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29de1afcd41d7a3a47f344794f5dd4d9, https://si.imgix.net/070262c6/uploads/origins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf3d9ebe65b04f86f797d40b8f977daf 2x, https://si.imgix.net/070262c6/uploads/origins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a99b00012a2af4dd520c686ee9084c43 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/070262c6/uploads/origins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb57d90d4767c5581d483990b6a67b23", "srcset": "https://si.imgix.net/070262c6/uploads/origins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb57d90d4767c5581d483990b6a67b23, https://si.imgix.net/070262c6/uploads/origins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2770e4ce985672e81069e6d8c5a26e 2x, https://si.imgix.net/070262c6/uploads/origins/428616a1-b2b8-4def-8d49-1fddf8ff6120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ce09343ea9c56d20dcfc0a3731216fd 3x"}, "body": "悠萩様、初めまして。天と申します。\n以前ルセナちゃんのイラストをお見かけし、キャラクターの可愛らしさをはじめ、鮮やかで柔らかな表現や自然豊かな世界観などに惹かれてから、他の子達のイラストもあわせて拝見しております。\n今回Skebを始められたということで、是非リクエストさせて頂ければと思いました。\n\n描いて頂きたいのは自分のオリジナルキャラクターで、「イヴ・エヴァーグリーン」という名前の女の子です。\n\n資料はこちらの2枚をご確認ください。\nhttp://10skyeve.mistysky.net/eve1.png\nhttp://10skyeve.mistysky.net/eve2.png\n\n2枚の画像で衣装デザインが異なっていますが、クリスマスツリーをモチーフにしたキャラクターです。\n頭頂部のアホ毛やハネた髪でモミの木を、星飾りがついたカチューシャや長いもみあげに付いた赤い玉の飾りなどの装飾でオーナメントを表現しています。\nタイツは冬っぽさと木の幹のイメージです。\n年齢は14歳くらいで、特別スレンダーだったりグラマーだったりはせず平均的な体型です。\n\nクリスマスツリーの華やかなイメージから上品なお嬢様風の印象で、落ち着きつつも好奇心が垣間見えるような性格です。\n\n衣装についてですが、よろしければモチーフを踏襲しつつ、悠萩様のセンスでアレンジして頂けると嬉しいです。\n見た目的に現実世界というよりはファンタジー世界の子という印象ですが、特に世界観や設定は決まっていないので、普段から悠萩様が描かれているような雰囲気で大丈夫です。\n（お手間でしたら資料のどちらかお好きな方で、分かりづらい部分だけ補完していただくような形でも問題ありません）\nアレンジ頂いた場合、そのデザインを自分が描く際に使用させて頂くかもしれないので、ご了承頂ければと思います。\n\nポーズ・シチュエーション・背景の有無などについては、お手数ですがお任せ致します。\n先に書いたように特に設定がない子なので、現代っぽい要素・異世界っぽい要素どちらも問題ありません。\n可愛らしく描いて頂ければ嬉しいです。\n\nご検討のほど、よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhagi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3919261, "client_id": 2994140, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/573f5e2d/uploads/origins/253efb29-5696-4b06-9e23-5d39c83c7f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7ba713655ef039bb32a245ea1b00d97", "srcset": "https://si.imgix.net/573f5e2d/uploads/origins/253efb29-5696-4b06-9e23-5d39c83c7f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7ba713655ef039bb32a245ea1b00d97, https://si.imgix.net/573f5e2d/uploads/origins/253efb29-5696-4b06-9e23-5d39c83c7f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f09da8c16f8241296b3739bab70c5192 2x, https://si.imgix.net/573f5e2d/uploads/origins/253efb29-5696-4b06-9e23-5d39c83c7f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8dc244fa558aa5956f4e99d7f41c97a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/573f5e2d/uploads/origins/253efb29-5696-4b06-9e23-5d39c83c7f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c48e91a8ef9f33895589a6