.imgix.net/1deca41f/uploads/origins/f0949dc3-6bc4-40a7-885e-a73a95e1416a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d70302ab4784027edf08b050b3a55ec1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1deca41f/uploads/origins/f0949dc3-6bc4-40a7-885e-a73a95e1416a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65b3ab380cd92592df0019f4c2e00cdb", "srcset": "https://si.imgix.net/1deca41f/uploads/origins/f0949dc3-6bc4-40a7-885e-a73a95e1416a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65b3ab380cd92592df0019f4c2e00cdb, https://si.imgix.net/1deca41f/uploads/origins/f0949dc3-6bc4-40a7-885e-a73a95e1416a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=393e23e65cd334f255d34e64b521b7d5 2x, https://si.imgix.net/1deca41f/uploads/origins/f0949dc3-6bc4-40a7-885e-a73a95e1416a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=382d00ff73671c04ec1915b2447d9d81 3x"}, "body": "初めまして。\nSkebでのギターを持った可愛らしいイラストを拝見させていただきました。\n良ければ、大好きな推しがギターを持ったイラストのリクエストをお願いできればと思います。\n\nキャラクター:美輪椿姫/G線上の魔王\n椿姫の参考資料(年齢指定作品ですが、その類の画像は入れていません)↓\nスチル\nhttps://drive.google.com/drive/folders/1doZKuogc8mP_UOltbXw3hTdM19VM8oYm\n立ち絵\nhttps://drive.google.com/drive/folders/1fkM7lRuomWHEfqX6B3DJD3KukWoggDnu\n公式サイト\nhttps://drive.google.com/file/d/1l0t5D3DSzNo3gOLS6wQjKp5ifQbQjeF-\nギター画像(フェンダー・ジャガーと言うギターです)\nhttps://drive.google.com/drive/folders/1KkwlvwEzPPTlZxSE7sz2JaL-GrvTNgzb\n\n詳細\n・服装は制服でお願いします。(立ち絵フォルダの画像です)\n・秋の学園祭でのライブをイメージしています。\n・可愛らしさと真っ直ぐさを前面に押してほしいです。全く関係ない作品で申し訳ないのですが、イメージ的には『ぼっち・ざ・ろっく！』の学園祭時のぼっちちゃんが一番近いです。いくつか二次創作でイメージに近いイラストのリンクを置いておきます。\nhttps://www.pixiv.net/en/artworks/103262995\nhttps://www.pixiv.net/en/artworks/104150528\nhttps://www.pixiv.net/en/artworks/129262135\nhttps://x.com/sogenshinkan/status/1612456358082916352\n・マイクは無しでお願いします。\n・足は見切れていても構いませんが、浮き毛含む頭部と手先とギターは全て映してほしいです。\n・その他表情、背景、子細な構図、ポーズは全てお任せします。\n・PSDデータも頂ければ嬉しいです。\n\n使用用途：個人用(自分のSNSで使用する予定です)\n\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruno_zzz/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2984242, "client_id": 1193384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da901794ccbfd1d3ebda6c2aacba47f0", "srcset": "https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da901794ccbfd1d3ebda6c2aacba47f0, https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=680a5bdce341c0276a95ac65c92d8853 2x, https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79b156d2f77a0296182d9670cb36ccc5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=033153be33d60619cc2df7a5507052a3", "srcset": "https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=033153be33d60619cc2df7a5507052a3, https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47d3dbce8014fe49d3198ea8f0a0e0a3 2x, https://si.imgix.net/c9f8ff96/uploads/origins/6fc66f41-cf6c-4f91-8951-cf251d4b0f49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4cda4811f58873cd9d4fc3319f997f1a 3x"}, "body": "まるの様\n\nはじめまして、声の活動をして活動している、つばきりむです。\nSNSでお見かけし、是非ともうちの子を描いていただきたくリクエストいたしました。\n\n◆キャラクターについて◆\n私自身のキャラクターを描いていただきたいです。\n立ち絵はこちらになります。\nhttps://drive.google.com/drive/folders/1DtBv16fpUZrAll1j5rIfESHtbx2hwzs_?usp=sharing\n髪型やお洋服はお任せいたします。\n\n◆構図や構成について◆\nhttps://x.com/maruno_zzz/status/1922250990595485784\nTwitterで投稿されていたこちらのイラストの様に、ぺたっと座りながら、片手でハートを作っているような構図でお願いいたします。\n\nイラストの縦横構図はお任せ致しますが、頭から胸辺りまでイラストの範囲内に収まっていると使いやすいです。\n金額の範囲内で可能でしたら背景を描いていただけますと嬉しいです。（簡易的で大丈夫です）可能な場合、背景透過にできるようにpsdで頂けると助かります。\n\n◆使用用途について◆\nTwitterや配布用グッズ、名刺制作、有料支援サイト等、広報活動に使用させていただきたいと考えております。\n\n色々と細かく指示を指定してしまいましたが、ご無理のない範囲で楽しく描いていただければ幸いです。\n\n何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1DtBv16fpUZrAll1j5rIfESHtbx2hwzs_?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruno_zzz/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2984242, "client_id": 8407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bce9fb4/uploads/origins/df0d1156-f28d-43a6-9655-1af6ba4d89e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7dff38e9bba84efe34cd1112878013", "srcset": "https://si.imgix.net/0bce9fb4/uploads/origins/df0d1156-f28d-43a6-9655-1af6ba4d89e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7dff38e9bba84efe34cd1112878013, https://si.imgix.net/0bce9fb4/uploads/origins/df0d1156-f28d-43a6-9655-1af6ba4d89e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e54763d49096d8653b0ed7288eb52fdc 2x, https://si.imgix.net/0bce9fb4/uploads/origins/df0d1156-f28d-43a6-9655-1af6ba4d89e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70de62730b81e8ded5ae6ce5c8f15219 3x"}, "duration":