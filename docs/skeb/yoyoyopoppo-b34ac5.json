a24-9406-86143b30827c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcb42ec39efe809e59860a32d7750662, https://si.imgix.net/699e93dd/uploads/origins/919280da-0fda-4a24-9406-86143b30827c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb98b899dd06f0122af5aabec6d11759 2x, https://si.imgix.net/699e93dd/uploads/origins/919280da-0fda-4a24-9406-86143b30827c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb9c56bb32bc1d22dfd0604a508a5f9e 3x"}, "body": "またまたこんにちは！君が描いてくれたキャラクターでdndをプレイするのはとても楽しいよ。彼の裏の顔が明らかになるのがとても楽しくて、慌ただしかったです。\n\n最近彼がパワーアップして、過去のキャラクターをゴーストとして召喚できるようになったので、おそろいの絵があったらいいなと思いました。\n\n彼女は目を閉じて穏やかな表情を浮かべ、長い髪と長いエルフの耳を持つ幽霊のようなエルフだ。元は冒険家だったので、革の鎧を着せてみたい。彼女は主に爪で攻撃することになるので、ゴーストの姿では爪のようなものを持っているはずだ。また、幽霊の鎖が彼女を取り囲んでいたらクールだと思う。\n\nもちろん、彼女はゴーストなので、鎧も含めて、妖怪のように透けて見えるようにしたい。\n\nもしあなた自身のアイデアがあれば、自由に変更してください。前作は本当に素敵だったので、あなたが一番似合うと思うことをやってくれると信じています。\n\nご配慮ありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoyoyopoppo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2748613, "client_id": 2713162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d3e28d7d3b03c1d398bdd4bdfe4bec", "srcset": "https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92d3e28d7d3b03c1d398bdd4bdfe4bec, https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=632410befecdf2072ed7a11f02170bd3 2x, https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9da1bc452451c5fc22a589dc6a2fe36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30ec5b83fb83a9843f962295178a60b9", "srcset": "https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30ec5b83fb83a9843f962295178a60b9, https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96b0d10d2a62a4efbc6f1156f2ad8611 2x, https://si.imgix.net/4ef27a30/uploads/origins/68ffe418-c7d8-4965-a5cb-c2548a8eb137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31059630922ae624c45c9b82b187c991 3x"}, "body": "こんにちは、あなたのアートが大好きです！\n\nファンタジーのTTRPGで演じたいキャラクターのためのアートが欲しいと思っていたんだ。\n\n彼のキャラクターは、神父になりすました暗殺者です。神父のふりをしている間は友好的な性格をしていますが、それは彼の人を操り、権力に飢えている面を隠すためです。\n\n外見はハンサムな男性で、茶色のミディアムヘアを束ねている。額の上には数本の髪が落ちている。無精ひげを生やしている。目はヘーゼル。平均的な体格で背が高い。表情は温かい微笑み。\n\nフードなしの白いファンタジーの司祭服を着ている。\n服装の参考例を載せておきますので、別の服装に変更したり、別の服を描いても構いません。また、彼が身につけるメダルも同梱しました。\n\n彼の邪悪な面のバージョンも欲しいです。彼の笑顔はもっと不吉で、彼は黒魔術のさざ波を発し、顔にはドクロのタトゥーがあります。\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1eq4Rk6Ul1KchJqtpHnKNY3OW8_645vLS?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoyoyopoppo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2748613, "client_id": 158139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/692901f7/uploads/origins/6de8ea39-97b4-4e3a-86fe-f7379b99b4b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d29fdf7f