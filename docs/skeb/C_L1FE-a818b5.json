ormat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f5d3f4cdc9a8763bafd8173e3f8306, https://si.imgix.net/d0098c41/uploads/origins/0c753cdb-c182-433c-8f82-73ab0e546cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=182d6fbbe01ecec5b9cc02aef9eb1d42 2x, https://si.imgix.net/d0098c41/uploads/origins/0c753cdb-c182-433c-8f82-73ab0e546cd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aee81c54274f38af92e25d86a1f877c9 3x"}, "body": "あけましておめでとうございます、yctさん。もうずいぶん長くあなたにお願いしている気がしますね。今回はリクエストが変わります。アリアではなく、男性主人公のエスポワールを描いていただけませんか？エスポワールは神秘的でありながら優しい男性で、伝説の魔導書を操り、怪物たちを封印しています。 その魔導書には伝説が付きまとっているため、彼は非常に親切で人々を救っているにもかかわらず、世間からは悪魔のように見られています。エスポワールが魔導書を手に持つ姿を描いていただけませんか？彼の魔導書は魔法的な性質を持ち、ページは星空とオーロラが混ざり合ったようなデザインです。その他の詳細は、月が銀色であることだけです。どうぞご自由に想像して描いてください！ シーン設定は自由です。アリアがカルトに拉致された際、廃墟の教会で彼と出会う設定ですが、詳細はご自由に決めてください。ご検討いただき誠にありがとうございます！エスポワール参考画像：https://imgur.com/a/wFRbSm0 グリモア参考画像：https://imgur.com/a/9ioEMpw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@C_L1FE/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290509, "client_id": 3539653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eff4325b5a53bfa7dcc64a026b9c8637", "srcset": "https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eff4325b5a53bfa7dcc64a026b9c8637, https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcb318503a1c59cb31895b8c51deeea8 2x, https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f25ec8f68b887420975951b50a6c7c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9737fe1dc44640499d029a678a042e92", "srcset": "https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9737fe1dc44640499d029a678a042e92, https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a747eb216c69c67a77d5b496a2cb2115 2x, https://si.imgix.net/88e735e8/uploads/origins/449a2cc5-8bf8-42b7-b984-09dbfe415ca3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ac8f43c2d7c865bf5c52bf44a92dcf3 3x"}, "body": "こんにちは、YCTです！またまた美術の依頼です。私のウェブ小説の中で最も重要なシーンの一つを描いていただけたら光栄です。それはアリアが微笑みながら主人公を見つめるロマンチックで感動的なシーンです。アリアは突然抱きついて主剣を落とし、彼にタックルしたところだった。  アリアが初めて彼のことを大切に思っていることを理解した瞬間であり、ロマンチックな感じがする。\n\n舞台は冬で、二人の周りには花が咲き乱れ、満天の星空の下。何度か描いてもらったんだけど、アリアのデザインとキャラクターを完璧に捉えていると思うから、ディテールを加えたり、好みのシーンを描いてもらえると嬉しいわ。追加したいバージョンは何でもできます。\n\n私のストーリーとキャラクターに命を吹き込んでくれて、感謝の気持ちでいっぱいです。ありがとうございました！\n\nアリアの参考文献\nhttps://drive.google.com/drive/u/1/folders/1i7zuLfo5svdEmKtW6hh8lVjhigBoFhiC", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@C_L1FE/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290509, "client_id": 3539653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9de747c34dd8f32444f613de742cce7", "srcset": "https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9de747c34dd8f32444f613de742cce7, https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd50a9cdd05927a459f170f740a25251 2x, https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d93b394b0c0bbd0b3c92e45f2ae20bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50f4b5eb7fafc452e15a4e5bddd1a94e", "srcset": "https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50f4b5eb7fafc452e15a4e5bddd1a94e, https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85ff41d030ba1c93f7e2882d6fc17567 2x, https://si.imgix.net/5e1d0a2e/uploads/origins/da6774ad-f62b-44c5-b470-33d79dc0b523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d255906ec1d643db345222e36385f264 3x"}, "body": "こんにちは、Yoctoです！私のウェブ小説のあるアークにアートインサートをお願いできれば光栄です！https://skeb.jp/@C_L1FE/works/7。\n\nアリアともう一人の主人公エスポワールは、国の士官学校に入ることを余儀なくされた。入試はバトルロワイヤルで、二人は別々のエリアに振り分けられる。私はエスポワールが横たわり、少し傷つき、服が傷んでいるのを想像した。アリアは腰に手を当て、死にかけた彼を叱咤し、彼の上に立っている。エスポワールはアリアに会いたかったと笑っている！\n\n死にかけたエスポワールに少し顔をしかめるアリアと、アリアもエスポワールに会いたかったと柔らかい笑みを浮かべる別バージョンがあってもかわいいと思う。\n\n二人のロマンチックな瞬間、お好きなディテールを追加してください！いつもありがとうございます！\n\nエスポワール\nhttps://drive.google.com/drive/folders/1nBaDp3WaK4cvyvOuy0OMCkgyeActASV3?usp=drive_link\n\nアリア\nhttp