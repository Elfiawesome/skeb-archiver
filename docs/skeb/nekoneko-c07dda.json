9fe7e66e 2x, https://si.imgix.net/4b9936c1/uploads/origins/59d9f124-3cbe-4c8a-9511-2e8d2db4be82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c43001505e56c89396f9687ff503d6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b9936c1/uploads/origins/59d9f124-3cbe-4c8a-9511-2e8d2db4be82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7fb06cbb220d8b39262aadad2930a2f", "srcset": "https://si.imgix.net/4b9936c1/uploads/origins/59d9f124-3cbe-4c8a-9511-2e8d2db4be82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7fb06cbb220d8b39262aadad2930a2f, https://si.imgix.net/4b9936c1/uploads/origins/59d9f124-3cbe-4c8a-9511-2e8d2db4be82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9855be184e4b8af8cf2fe8c6ca8ed4f 2x, https://si.imgix.net/4b9936c1/uploads/origins/59d9f124-3cbe-4c8a-9511-2e8d2db4be82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bfc2971de134fa1c40f6dc65c584997 3x"}, "body": "こんにちは！先ほどSkebを閲覧していたところ、あなたの作品を見つけました。本当に素敵な絵を描かれていますね！そこで、私のオリジナルキャラクター（OC）を描いていただきたいと思い、依頼することにしました。私のオリジナルキャラクター「エマ」を描いていただけないでしょうか。彼女は格闘ゲームの大ファンであり、同時にプロ格闘ゲーマーでもあります。戦っている最中に笑顔でいるようなアクションポーズで描いていただけると嬉しいです。よろしくお願いします！\n\nエマ（キャラクター参考画像）\nhttps://imgur.com/a/Y1Vt59T", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoneko/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2380110, "client_id": 2206871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eec44f6ac9bced7d0d9c1932205d973", "srcset": "https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7eec44f6ac9bced7d0d9c1932205d973, https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d396ebd27956506f645e571b511cb767 2x, https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e20e8157f44776862026d5db92294cd3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec6c2ff263ffc9400ea1cf691331945d", "srcset": "https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec6c2ff263ffc9400ea1cf691331945d, https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b597d0a5bbec1c9d530b2fe9d54d2d89 2x, https://si.imgix.net/3ce20f5d/uploads/origins/2bfa5cad-7c7c-40e0-add8-ebcdaf1661ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b06c7dbede421bb716732d3e23cd30e 3x"}, "body": "NekoNekoさん、こんにちは。\n\nあなたの作風を見て、私とパートナーのオリジナルキャラクター（OC）のイラストをお願いしたいと思いました。\n\n私のオリジナルキャラクター（ニャン）は「多元宇宙探偵の猫少年」で、パートナーのオリジナルキャラクター（ルナ）は「月のプリンセス」です。両方の参考画像を添付しました。ニャンについては、片方の目が灰色（現実の私がその目を失明していることを表しています）で、瞳孔は人間の丸い瞳孔ではなく、猫のようなスリット状になっている点にご注意ください。ルナについては、赤ではなく青く頬を染めるキャラクターです。\n\n夜、ソファで二人が毛布にくるまって寄り添っている、あるいは一緒にテレビで映画を観ている、あるいは暖炉の前でくつろいでいるような、そんな可愛らしいイラストを想像しています。\n\n服装や背景などのその他の詳細は、お任せします。\n\n将来的にはグッズとして、当面は配信やSNSで使用したいと考えています。\n\n透明PNG版と、レイヤーが分離されたPSD版（背景、キャラクター、エフェクトなど）を希望します。\n\nどのような作品になるか楽しみにしています。\n\nhttps://drive.google.com/drive/folders/1eHyv0qMVoyEK1s0JWn5UgI8HWdbt6aLn?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoneko/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2380110, "client_id": 3614621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=974987181d607abaf991c3e1ef5dd892", "srcset": "https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=974987181d607abaf991c3e1ef5dd892, https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb571a2fec86673bfa3b812ac9788165 2x, https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38abb464513fe2b11554e8f8ca566a99 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b34c6bc135913b874b0081abeba37e8f", "srcset": "https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b34c6bc135913b874b0081abeba37e8f, https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dea61fbf30cf2cae2adb5d1b3e7553d0 2x, https://si.imgix.net/8326ae21/uploads/origins/e3521a61-9dae-42fc-b68d-84e84c44acd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f734afb42472440bd48aca7470a70082 3x"}, "body": "前回描いていただいた作品、とても気に入りました。 今回も、前回と同様のポーズ、あるいはこの画像を参考に描いていただくことは可能でしょうか？ 具体的には、青いダイアウルフが、白い魚のキャラクターを抱えているような構図にしていただきたいです。\n\n\nhttps://pbs.twimg.com/media/HD3tbkkXwAAPBLW?format=jpg&name=medium\n\n\nhttps://pbs.twimg.com/media/HD3tbkAWMAA0mTY?format=png&name=large\n\n\nhttps://pbs.twimg.com/media/HD3tbj_WsAAdJ0t?format=jpg&name=large\n\nhttps://pbs.twimg.com/media/HD3tbkkXwAAPBLW?format=jpg&name=medium", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoneko/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2380110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=000fe8f860d8173616fbf0c8b6d67965", "srcset": "https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=000fe8f860d8173616fbf0c8b6d67965, https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38b45e3c90cc1c3faee781b4812711b2 2x, https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea99286bd2e5239fe3c2f3f5eb96b7cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc6c8036d4133c0f9aaf8d7c87c71602", "srcset": "https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc6c8036d4133c0f9aaf8d7c87c71602, https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=503f4d1c2b9e5268fe13c29d2d857d24 2x, https://si.imgix.net/2392979b/uploads/origins/5d9c86de-1ab8-457b-b9bd-1f0280124b5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac93d946ca8a27715d49da2f9d4d1bc 3x"}, "body": "TTRPGのモンスターを描いてもらえますか？\n\nこのモンスターは人間のような魔法の生き物で、人を丸呑みすることができます。\n\nこの生き物は犬娘のような姿をしており、人を丸呑みして魔法の力と能力を奪うことができます。\n\n犠牲者を飲み込んだ後、犬娘は犠牲者の身体的特徴の一部を獲得し、最初の外見を永久に変化させます。\n\nさらに、誰かを飲み込んだ後、この生き物は布と詰め物でできた犬の頭のような、ぬいぐるみのような頭をもう1つ獲得します。\n\n新しい犠牲者を飲み込むたびに、頭がもう1つ増えます。ぬいぐるみの頭は、忠実な犬のように友好的で単純な行動をします。ぬいぐるみの頭は独立して動き、独立して攻撃することができますが、ぬいぐるみの頭であるため、物理的には非常に弱いです。犠牲者がブレス攻撃や遠隔呪文を使っている場合、ぬいぐるみの頭もそれらの能力を犠牲者と同じ強さで使用できます。\n\nこの怪物は人を飲み込むたびに、同時に別の呪文を唱える能力と、より大きな魔力を得るため、非常に危険な存在です。\n\nこの怪物は神話に登場するケルベロスをモチーフにしています。ケルベロスは限界に達する前に、ぬいぐるみの犬の頭のような頭を2つしか追加できません。腹部には口があり、それで餌を食べます。\n\n犠牲者は怪物を倒すことで救出できますが、飲み込む人数が増えるほど倒すのが難しくなります。\n\n\nケルベロスが犠牲者（ウサギの魔女）を飲み込む前の姿はこちらです。\n\nhttps://www.deviantart.com/stash/0297klnxlh2q\n\n犠牲者を飲み込んだ後、ケルベロスはぬいぐるみの頭を1つと、その犠牲者の姿の一部を得ます。このデザインにこだわる必要はありませんが、私のアイデアを気に入っていただければ幸いです。\n\nhttps://www.deviantart.com/stash/0wv8l2bj7xi\n\nケルベロスの犠牲者の姿はこちらです。\n\nhttps://www.deviantart.com/stash/01c6umb150ud\n\nhttps://www.deviantart.com/stash/2rezepslgv0\n\n犠牲者は、大きなヘザーグレーのウサギの耳と尻尾を持つウサギの魔女です。\n\nこのウサギの魔女は非常に強力で、強化魔法と雷魔法を駆使し、パンチとキ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekoneko/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2380110, "client_id": 3926087, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57e482ea/uploads/origins/0c3fd3cc-a2a4-48b4-b42a-238b5b19605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e05d3a7170a58df84481cbd9ed0ae7