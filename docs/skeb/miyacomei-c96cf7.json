308a\u307e\u3059\u3002\n\n\u6700\u8fd1\u3001OC\u306b\u30bb\u30fc\u30e9\u30fc\u670d\u3092\u7740\u305b\u3066\u307f\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u308b\u306e\u3067\u3059\u304c\u3001\u5148\u751f\u306e\u63cf\u304f\u5973\u5b50\u6821\u751f\u306e\u30a4\u30e9\u30b9\u30c8\u304c\u3068\u3066\u3082\u597d\u304d\u3067\u3059\u3002\u3082\u3057\u3088\u3051\u308c\u3070\u3001\u79c1\u306eOC\u304c\u30bb\u30fc\u30e9\u30fc\u670d\u3092\u7740\u3066\u3001\u3061\u3087\u3063\u3068\u4e0d\u6a5f\u5acc\u305d\u3046\u306a\u8868\u60c5\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u307e\u305b\u3093\u304b\uff1f\u5236\u670d\u306e\u30c7\u30b6\u30a4\u30f3\u306f\u304a\u597d\u304d\u306b\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u69cb\u3044\u307e\u305b\u3093\u3057\u3001\u69cb\u56f3\u306a\u3069\u3082\u81ea\u7531\u306b\u6c7a\u3081\u3066\u304f\u3060\u3055\u3044\u3002\u30c0\u30e1\u305d\u3046\u306a\u3089\u3001\u53c2\u8003\u306b\u3042\u308bOC\u306e\u670d\u306e\u3069\u308c\u304b\u3092\u7740\u3066\u63cf\u3044\u3066\u3082\u3089\u3063\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\u3001\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\uff01\n\nhttps://drive.google.com/drive/folders/1Oe-QPy9426wck-Ee7p6dvoLrsr45QvtN", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyacomei/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2162203, "client_id": 169953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38a53b5c/uploads/origins/cda726e4-0da5-42ab-b1bf-515800ba4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6ac4e40d3431e377fa235d746fc78bf", "srcset": "https://si.imgix.net/38a53b5c/uploads/origins/cda726e4-0da5-42ab-b1bf-515800ba4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6ac4e40d3431e377fa235d746fc78bf, https://si.imgix.net/38a53b5c/uploads/origins/cda726e4-0da5-42ab-b1bf-515800ba4094?bg=%23fff&auto=fo