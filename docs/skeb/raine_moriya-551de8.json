150/uploads/origins/9e9ba76f-c3b1-4647-b36d-83e791a86112?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8ddf966d6625b2c17e340775814ea4b 3x"}, "body": "雷音さんこんにちは！\n雷音さんの描く諏訪子様が好きで、ぜひ描いて欲しいイラストがありましたので依頼させていただきました！\n以下依頼内容です\n花嫁衣装の諏訪子様をお願いします！\n和装(白無垢)か洋装(ウェディングドレス)かは描きやすい方で大丈夫です！\n笑顔の諏訪子様がこちらへ左手を差し伸べている構図で、左手の薬指には指輪を付けています。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@raine_moriya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3570463, "client_id": 1836732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9878ccd3ff42b1e2d87641025b31abbf", "srcset": "https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9878ccd3ff42b1e2d87641025b31abbf, https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5c6a7b347cce6654a4926a54902eb0a 2x, https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4218f0166ddb4016a9d91f010ee02a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f58af8626d4fa43d148cfd860b1bb3dc", "srcset": "https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f58af8626d4fa43d148cfd860b1bb3dc, https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad21649c932be59745176d268b8d85e8 2x, https://si.imgix.net/77fbda75/uploads/origins/cea2ce10-07da-450e-a436-cadf6cdcfaf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=058c7e4e9794466ebe57e739f10c9555 3x"}, "body": "こんにちは！\n君の絵を見て、僕のOCの絵を描いてほしいんだ：\n\n彼女の名前はリリで、しっぽが2本ある猫の悪魔（バケネコ）です。白い髪、黄色い目、黒い肌。\n\nアクセサリーを忘れないでください。\n\n代わりの服を着ているところを描いてください：\nhttps://drive.google.com/drive/folders/12RqyPUN81uN3K4n4bMg2XhzxyiWwwrQP?usp=drive_link\nポーズと構図はお任せします\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1gfKUn-0WFs506MYhlmOZUTxxuTx3GRHH", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@raine_moriya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3570463, "client_id": 952778, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6944a00e4556453f41ffe29372baae05", "srcset": "https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6944a00e4556453f41ffe29372baae05, https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40b33834493bd225c519258c209924ee 2x, https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9a3e6c0a93ac7b1ba6860805119cb98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06bef61be89587ad5cb6e08eea3b8023", "srcset": "https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06bef61be89587ad5cb6e08eea3b8023, https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05fa270ec59694588a6bf2db5d21dd64 2x, https://si.imgix.net/b7708371/uploads/origins/14acba54-02ef-4130-a6cc-3c8c0704392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25c2476064245f8efc80c09f051923c5 3x"}, "body": "こんにちは。\n貴方の絵柄でうちの子「にぷら」を描いて頂きたいです。\n\n【にぷら　設定】\n黒長髪、黒尻尾、黒い服を好んで着る猫耳少女。（黒縞パンを穿いている）\n服はおへその見える短い上着、ミニスカート。\nちっちゃいけどお胸はおっきい。いわゆるlo-li巨乳。\nツリ目だけどとっても元気で優しい。\nご主人（飼い主）大好き。鈴のついた首輪をしている。アホ毛がある。\n\n【描いて頂きたいもの】\n両腕で胸を左右から挟んでいる「寄せ乳」をお願いします。\n悪戯っぽく笑っています。全身でも上半身だけでも構いません。\n\n【参考資料】\n私は絵描きではないので自作資料はありません。\n他の方に描いて頂いたうちの子がいくつかありますので\nよろしければURLを参考にしてみてください。\nhttps://x.com/Cat_A_nipla01/status/1892543046946029938\n\n気が向きましたらよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@raine_moriya/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3570463, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11dbe308/uploads/origins/897a0943-f440-4245-ae9d-3dcbe4669822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f88a1ad557869b8dbf3fd064816de4ec", "srcset": "https://si.imgix.net/11dbe308/uploads/origins/897a0943-f440-4245-ae9d-3dcbe4669822?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f88a1ad557869b8dbf3fd064816de4ec, https://si.imgix.net/11dbe308/uploads/origins/897a0943-f440-4245-ae9d-3dcbe4669822?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=