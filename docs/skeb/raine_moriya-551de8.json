ガッツポーズを取っている瞬間、もしくは正面寄りで仁王立ちの姿勢でガッツポーズを取っているシーン。\n試合の勝利場面っぽいイメージです。\n\nなるべくお尻のラインやや太ももがよく見える構図で、表情は目を閉じない形での勝ち気な笑顔で希望。\n\nhttps://drive.google.com/drive/folders/1Ko98lH_oKPFjRYAtH5MrGdlQZg_1iQ7s", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 87518, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めがぎえ/illustrator", "screen_name": "megagieppi", "avatar_url": "https://pbs.twimg.com/profile_images/1679302818560348161/A39Zl2QT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/905302166549786624/1759212470/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2265795, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "m", "screen_name": "mumumo6", "avatar_url": "https://pbs.twimg.com/profile_images/1667807130173464576/w4-yeCbD.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2896707, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アヲ", "screen_name": "en6gtl", "avatar_url": "https://pbs.twimg.com/profile_images/1319409681878585344/0f0YleVE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1218769838908174336/1754318557/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 129}, {"id": 3487333, "creator"