s/origins/853e4853-4533-40ac-814f-3b2f2622a93b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6f18aacfabf809bd2b9547106d71e01 3x"}, "body": "いつもイラストなど拝見しております。\n今回、初めてskebにて依頼させていただきます。\n依頼内容ですが、「ゼノブレイド2」より、プネウマ(本編の衣装で)をお願いしたいと思います。\n可能であれば、本編最終話で仲間達を逃がす為に1人世界樹に残る場面をイメージして描いていただきたいです。\nお引き受けいただけましたら、是非よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Shiorino_Mani/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3868935, "client_id": 3401079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09807fad4da062dee6704b068ac6a16d", "srcset": "https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09807fad4da062dee6704b068ac6a16d, https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6efb005ec1e0d3bb7e509080b16526e 2x, https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2947d33511f3a82595f55550d1407b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5132aef9b281d4a26f5562d4f38a2675", "srcset": "https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5132aef9b281d4a26f5562d4f38a2675, https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ba464181f722cb921957542ce6bf73a 2x, https://si.imgix.net/776c6c31/uploads/origins/22df2f80-83d8-437d-93e0-76cfae39cf0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e129c29d54c1c5e9bad1956f5ce47018 3x"}, "body": "こんにちは！Xのアルゴリズムのおかげであなたの作品をたくさん拝見し、とても目を引きました。それでリクエストを送りたいと思いまして。参考リンクは問題ないと思います。私のオリジナルキャラクターを描いていただけないでしょうか。彼女は強い敵に一人で立ち向かう挑戦を楽しむ孤独なヒロインです。\n\n髪のディテールは必ず正確に描いてください：https://i.gyazo.com/5fb58f5572ba6d0f23d606b39fdaf653.pngゼノブレイド2のピラにコスプレした姿をお願いします。 https://pbs.twimg.com/media/Eh1G8neXgAEF_ES.pngできれば後ろ姿に焦点を当てたポーズをお願いします。参考：https://i.gyazo.com/00eb2ebebf81014a99a0c5e8d0ecaeae.jpg\n\nその他の詳細はご自由にお任せします。ご依頼をご検討いただきありがとうございます！ https://drive.google.com/drive/folders/1XXtdFR4_s0I5u8W6xTmUkczclXvzdV7Q", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Shiorino_Mani/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3868935, "client_id": 2825700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4cf5930/uploads/origins/04dc2bc1-97bc-4aad-b2e6-cad0a2730934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8145b13e70db06292932e8e593d5bf90", "srcset": "https://si.imgix.net/a4cf5930/uploads/origins/04dc2bc1-97bc-4aad-b2e6-cad0a2730934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8145b13e70db06292932e8e593d5bf90, https://si.imgix.net/a4cf5930/uploads/origins/04dc2bc1-97bc-4aad-b2e6-cad0a2730934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e8c17c5bc6ac50e537198cf794187a3 2x, https://si.imgix.net/a4cf5930/uploads/origins/04dc2bc1-97bc-4aad-b2e6-cad0a2730934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfa097b13f7b0cfe8b0db52666952158 3x"}, "dur