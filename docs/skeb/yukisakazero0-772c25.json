aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53e8d3ae0f378f9865da57f770fc46a", "srcset": "https://si.imgix.net/96eafe40/uploads/origins/699e3fac-7cc9-4ab7-b7a6-39c82099ecaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b53e8d3ae0f378f9865da57f770fc46a, https://si.imgix.net/96eafe40/uploads/origins/699e3fac-7cc9-4ab7-b7a6-39c82099ecaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86a5b836e1f31f0218f37187b92e40b8 2x, https://si.imgix.net/96eafe40/uploads/origins/699e3fac-7cc9-4ab7-b7a6-39c82099ecaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b931adc35d6fe48449111ac1e433e1dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96eafe40/uploads/origins/699e3fac-7cc9-4ab7-b7a6-39c82099ecaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc692d0275062e8b1b545c8b3d33f74", "srcset": "https://si.imgix.net/96eafe40/uploads/origins/699e3fac-7cc9-4ab7-b7a6-39c82099ecaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc692d0275062e8b1b545c8b3d33f74, https://si.imgix.net/96eafe40/uploads/origins/699e3fac-7cc9-4ab7-b7a6-39c82099ecaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35c39b50ed62518adb65bf003cb75dda 2x, https://si.imgix.net/96eafe40/uploads/origins/699e3fac-7cc9-4ab7-b7a6-39c82099ecaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec710b7bea5ade69983d9e09a48173d4 3x"}, "body": "初めまして、いつも素敵なイラスト見させて頂いています！\n雪坂さんのキャラデザのセンスがとても好きなので、よろしければ私のオリジナルキャラクターのデザインを考えて頂きたいです！\n\n\n【キャラクターについて】\n\n入れて欲しい特徴、要素\n・小さめの女の子\n・ケモ耳、尻尾(動物の種類はお任せします！)\n・垂れ目かぱっちり目\n・桃色\n\n上記のものはデザインに入れて頂けると嬉しいです。\n\n下記に記載するものを取り入れるかはお任せします、足りなかった場合デザインの参考になるように記載しています。\nこちらから多く取り入れて頂いても、全て使わなくても大丈夫ですし、他に雪坂さんの好きな要素や思いついたものがあればそちらを使っていただいても構いません！\n\n・他の好きな色→水色や黄色\n・植物やお花、果物\n・ぬいぐるみ\n・星\nフリルやリボン、装飾多めの可愛い雰囲気のものも好きです。\n\n【ポーズ・構図】\n描きやすいように描いて頂いて構いません。\n\n【使用用途】\nSNSのアイコンやヘッダー、スマホの壁紙など、\n個人の範囲で使用させて頂きます。\nまた、可能でしたら資料として他の方に見せたり、今回のデザインで自分でイラストを描きたいと考えております。\n\n\n初めての依頼のため、至らぬ点がありましたら申し訳ございません…。\n条件に合いましたらぜひよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukisakazero0/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bbeb9be3/uploads/origins/39dbabd7-f83e-4e68-b78b-869279a2a7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f360ffe860d1ebd660b87dd7ac91872", "srcset": "https://si.imgix.net/bbeb9be3/uploads/origins/39dbabd7-f83e-4e68-b78b-869279a2a7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0f360ffe860d1ebd660b87dd7ac91872, https://si.imgix.net/bbeb9be3/uploads/origins/39dbabd7-f83e-4e68-b78b-869279a2a7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8687996b56e979bb9ad7271141dd1b65 2x, https://si.imgix.net/bbeb9be3/uploads/origins/39dbabd7-f83e-4e68-b78b-869279a2a7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1245249d7aafd46c7f3bc4bf14b24fb9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3559670, "nc": 16}, {"path": "/@yukisakazero0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3559670, "client_id": 2792473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c20176a1/uploads/origins/dea3da04-fe38-46c0-b957-0c71b72ff842?bg=%23fff&auto=format%2Ccom