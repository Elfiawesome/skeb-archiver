庫、尾道、呉を周る聖地巡礼の旅行を計画し、作品の舞台を満喫して来ようと思っています。\n\nまだ作品と出会って一年ですが、そのくらい私にとって「プリズム◇リコレクション！」は影響を与え、ヒロインたちとの恋愛はもちろん、こんな世界観の未来が来たらいいなとワクワクさせてくれた作品です。", "nc": 0, "word_count": 6127, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 140471, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ザロッテン", "screen_name": "thee_rotten", "avatar_url": "https://pbs.twimg.com/profile_images/1249516102423470080/ONyOrhvt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1180034703698432000/1586742829/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "nc": 49}, {"id": 269285, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ZEN", "screen_name": "ZEN_KAMURO", "avatar_url": "https://pbs.twimg.com/profile_images/1987162171860787201/KjMGbd29.jpg", "header_url": "https://pbs.twimg.com/profile_banners/115044354/1762611357/1500x500", "appeal_receivable": false, "popular_creator_rank": 5, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1218443, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "みう", "screen_name": "TwinkleTail_miu", "avatar_url": "https://pbs.twimg.com/profile_images/1154359869056487424/xv-amOe8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1154359593465552896/1564056505/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id":