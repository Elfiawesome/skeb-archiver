: "https://si.imgix.net/03b78ba4/uploads/origins/4321f89d-7a3b-4569-98ba-e4cbaf1d1fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=124dfd825f4d7f6ea72ac3b04e862efa", "srcset": "https://si.imgix.net/03b78ba4/uploads/origins/4321f89d-7a3b-4569-98ba-e4cbaf1d1fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=124dfd825f4d7f6ea72ac3b04e862efa, https://si.imgix.net/03b78ba4/uploads/origins/4321f89d-7a3b-4569-98ba-e4cbaf1d1fff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e0059ae7d13af92503e44d6140def25 2x, https://si.imgix.net/03b78ba4/uploads/origins/4321f89d-7a3b-4569-98ba-e4cbaf1d1fff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65fde84092110b0d7a551350d8730297 3x"}, "body": "お久しぶりです。またまたアイデアが浮かんできましたので、リクエストしたいと思います。\n\nハミダシクリエイティブの竜閑天梨と鎌倉詩桜が、ショッカー女戦闘員のコスプレをして、和泉智宏とイチャラブセックスしているシチュエーションをお願いします。具体積なイメージは、以下の通りです。\n\n<構図>\n・智宏は裸になっていて、天梨と詩桜はショッカー女戦闘員の衣装を着ている。\n・天梨は左手で智宏の胸を抑え、右手で智宏の首輪に繋がる鎖を引っ張りながら、騎乗位で搾精している。\n・詩桜は天梨の後ろに座り、左手で天梨の乳首をいじりながら天梨の胸を揉み、右手は天梨の太ももに置いている。\n\n<ショッカー女戦闘員の衣装>\n・上半身は、首まで覆うハイネックの黒いレオタードにグローブ着用。\n・下半身は茶色ストッキング+網タイツにブーツを履いている。\n・首に赤いネッカチーフ、腰に赤い腰布を巻いている。\n・ベレー帽、アイマスクを着用している。\n・メイクは紫のルージュとアイシャドー。\n・差分として、レオタードの模様が赤戦闘員のものになっているバージョンをお願いします。\n\n注文が多いですが、よろしくお願いします。\n\n参考資料\n\n・ショッカー女戦闘員(1)：https://www.pixiv.net/artworks/119675088\n・ショッカー女戦闘員(2)：https://www.pixiv.net/artworks/129115045\n・ショッカー女戦闘員(3)：https://www.pixiv.net/artworks/113489322\n・赤戦闘員：https://www.pixiv.net/artworks/75110487", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@garage_73/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2910015, "client_id": 2545626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef772cb234e1065d36d5878181703063", "srcset": "https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef772cb234e1065d36d5878181703063, https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2268b4f9c15c89d756194e8ddc81afba 2x, https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=776d720e00e6d8c8e1862fab17170833 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64942898ee738b5e2c64998ab884c54f", "srcset": "https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64942898ee738b5e2c64998ab884c54f, https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf8e27d7c331c35af486ed71fcbcdc8 2x, https://si.imgix.net/392e5e45/uploads/origins/761eee67-756f-4269-bf09-c525096f45d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9383a738587f22418aa28d93db6b01ae 3x"}, "body": "お久しぶりです。今回は以前、お題箱に投稿したネタを基に、初の18禁イラストをリクエストしたいと思います。\n\n欲求不満なラズベリーキューブの桜庭・ヴィクトリア・瑠莉が、秘密戦隊ゴレンジャーの戦闘員：ゾルダーのコスプレをして、吾妻悟にお仕置きをしているシチュエーションをお願いします。具体的なイメージは、以下の通りです。\n\n・悟にすっぽ抜かされ、欲求不満となった瑠璃は、悟を自宅に拉致軟禁している。\n・悟は全裸で、両腕を鎖で吊るしあげられている。\n・瑠莉は右手で結月悠から借りたSFP9/VP9のモデルガンを悟の頭部に突き付けている。\n・瑠莉は左手で悟の陰茎を強く握り、手コキをしている。\n・悟の陰茎の真下には、悟の精液を貯める金属製のバケツが置かれている。\n・瑠莉のメイクは黒のルージュにアイシャドー。\n・ゾルダー衣装の素材感は、参考資料(https://www.pixiv.net/artworks/116449298)に準ずる。\n\nその他の部分はお任せします。どうぞよろしくお願いします。\n\n参考資料\n・ゾルダー(1)：https://www.pixiv.net/artworks/26712015\n・ゾルダー(2)：https://www.pixiv.net/artworks/116449298\n・SFP9/VP9：https://www.pixiv.net/artworks/83392781", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@garage_73/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2910015, "client_id": 1674168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d40acf8d/uploads/origins/09f01a32-d4bb-474d-a073-d6f1256797ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49c029c21590e979018a401b179fb146", "srcset": "https://si.imgix.net/d40acf8d/uploads/origins/09f01a32-d4bb-474d-a073-d6f1256797ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49c029c21590e979018a401b179fb146, https://si.imgix.net/d40acf8d/uploads/origins/09f01a32-d4bb-474d-a073-d6f1256797ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a878abe883e446e67869f9fa71464622 2x, https://si.imgix.net/d40acf8d/uploads/origins/09f01a32-d4bb-474d-a073-d6f1256797ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8979a0c536012a3cab9f0ba302eb8492 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d40acf8d/uploads/origins/09f01a32-d4bb-474d-a073-d6f1256797ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d1bf090cb0293bbe102da2a58b55795", "srcset": "https://si.imgix.net/d40acf8d/uploads/origins/09f01a32-d4bb-474d-a073-d6f1256797ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d1bf090cb0293bbe102da2a58b55795, https://si.imgix.net/d40acf8d/uploads/origins/09f01a32-d4bb-474d-a073-d6f1256797ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53