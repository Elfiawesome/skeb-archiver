92e88-6e97-4a21-80d4-60d6614687f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df61ef2508ef9aa1c6883581fb93494c 2x, https://si.imgix.net/06905d0a/uploads/origins/b6392e88-6e97-4a21-80d4-60d6614687f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=798720cf732449435379445f5a855dce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06905d0a/uploads/origins/b6392e88-6e97-4a21-80d4-60d6614687f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c8546a9341f26d57b27dd6457260b84", "srcset": "https://si.imgix.net/06905d0a/uploads/origins/b6392e88-6e97-4a21-80d4-60d6614687f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c8546a9341f26d57b27dd6457260b84, https://si.imgix.net/06905d0a/uploads/origins/b6392e88-6e97-4a21-80d4-60d6614687f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23f226a085e290c1df57ce66be59df73 2x, https://si.imgix.net/06905d0a/uploads/origins/b6392e88-6e97-4a21-80d4-60d6614687f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e79e61622ff2b6908e3a3f7a50cbac46 3x"}, "body": "朔兎くんをお願いしたいです！\n衣装はおまかせしても、いいですか！？\n髪型変更可能です。\n\n表情豊かでかわいいにんげんです。\n自分のことを銀河一かわいいと思っています。\n\n女装もするので中性的な衣装だと嬉しいです！\n中性的じゃなくても、もちろん嬉しいです。\nかわいい僕が存在していることだけで嬉しい。\n\n〈髪〉\n白寄りの銀髪、長髪(肩甲骨辺りまで)、横髪ピンク\nストレート、アホ毛なし、\n前髪重め(右目、向かって左側が半分隠れるくらい)\n〈顔〉\n切れ長のツリ目、赤目(朱殷)、ギザ歯、口内は黒\n目尻側のまつ毛が長め↓イメージ\nhttps://twitter.com/arukarider/status/1458977039541628930 \n〈肌〉\n不健康な色白、クマあり\nスナッグに埋まりかけのピアス穴\n銀縁の丸眼鏡(フレームは華奢で大きめ)\n\n参考URLの1枚目が朔兎くん、2枚目以降が女装朔兎くんです。1枚目の方をお願いします！\n\n↓ここにも何件かあります\nhttps://skeb.jp/@SakuSak_u_sa_gi\n\nhttps://twitter.com/sakusak_u_sa_gi/status/1716444910251868605", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@saman_sa_tabasa/works/2", "private_thum