限。「数えられる無限」。\nαとℵはそれぞれギリシャ語とアラブ文字の最初の字で。「あ」や「A」と同じだね。\nAktoは反骨精神と正義感が混在してるので悪の科学者を名乗って自分の正義を優先する。\n自分が100%正しいと思ってないので悪を名乗ることにした。\n話すタイプのコミュ障。悪い意味で学者気質だね。\n最近の趣味は科学、小さな環境保護、ゲーム、数学、言語学習、動画制作、学習。最近は文房具にハマってる。\nウェブサイトにていつかは白衣に載せたい記号を提案してる。\n\nhttps://www.akto.earth", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@wasuretai_0717/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 379974, "client_id": 3187084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6943d5de/uploads/origins/1d560fd7-5336-4626-a06f-470555f7f7c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13a5f08b0de942f1bc252796e674341e", "srcset": "https://si.imgix.net/6943d5de/uploads/origins/1d560fd7-5336-4626-a06f-470555f7f7c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13a5f08b0de942f1bc252796e674341e, https://si.imgix.net/6943d5de/uploads/origins/1d560fd7-5336-4626-a06f-470555f7f7c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1930f118d276c99f0029b8ac74593f98 2x, https://si.imgix.net/6943d5de/uploads/origins/1d560fd7-5336-4626-a06f-470555f7f7c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68d8640a6279dc283128d3297316cb64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6943d5de/uploads/origins/1d560fd7-5336-4626-a06f-470555f7f7c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ac7aeee2b91f8de23b5cd0c5b834dd1", "srcset": "https://si.imgix.net/6943d5de/uploads/origins/1d560fd7-5336-4626-a06f-470555f7f7c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ac7aeee2b91f8de23b5cd0c5b834dd1, https://si.imgix.net/6943d5de/uploads/origins/1d560fd7-5336-4626-a06f-470555f7f7c6?bg=%23fff&auto=format%2Ccompre