ation": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2e52fdf/uploads/origins/d574bbc9-f0ed-453d-857b-35fe99565680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b349e46f697bb1a8b51e02d8ed21fd3f", "srcset": "https://si.imgix.net/f2e52fdf/uploads/origins/d574bbc9-f0ed-453d-857b-35fe99565680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b349e46f697bb1a8b51e02d8ed21fd3f, https://si.imgix.net/f2e52fdf/uploads/origins/d574bbc9-f0ed-453d-857b-35fe99565680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a66507e69fba881ff0a8148b5692ef10 2x, https://si.imgix.net/f2e52fdf/uploads/origins/d574bbc9-f0ed-453d-857b-35fe99565680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e2bd2a7c25756c0df699a9ac47826d 3x"}, "body": "こんにちは、あなたの作品にとても興味を持ちました。\n\n新しいカジュアルな服を着て、新しいヘアスタイル（前髪で左目を隠している）にしてほしいんだ。彼女の服装はスケーター服のようなもので、スケートボードも持たせたかったのです。\n\n彼女の普段のデザインは\n* 青い髪（髪は結んでいる。）\n* ♦️ の形の瞳孔を持つ灰色の目。\n* 非常に明るい肌色\n* ヘッドフォン（あなたは新しいものを設計することができます）\n* 穏やかな性格\n\n衣装とデザインはリファレンスにあります。正確さは求めていませんので、ベストを尽くしてください。背景、表情、ポーズ（帽子を持っている感じとか）はお任せします。申し訳ないのですが、オグの全身をお願いしてもよろしいでしょうか。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1K1bnQQMnGsKd0D3IP0Qb7lCGvUWZ12kj", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@narumiyafuri/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3544288, "client_id": 2306057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc56e321/uploads/origins/6b868f59-f086-4843-877d-e9e9e3cb994b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84b6c55cb7c1e6b923b5955ecaba9750", "srcset": "https://si.imgix.net/cc56e321/uploads/origins/6b868f59-f086-4843-877d-e9e9e3cb994b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop