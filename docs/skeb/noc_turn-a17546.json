疲れ果てて愛おしそうな、満足そうな顔をしている。\n- ルーファスの髪は乱れている。\n- ルーファスの肛門からは精液が垂れている。オプションで、ぽっかりアナルや縦割れアナルもOK。\n- ルーファスの体には噛み跡とキスマーク（特に太もも）がある。血はNG。\n- 彼の体にはたくさんのセックスによる精液が飛び散っていることもある。ルーファスにはセックスパートナーが一人しかいないので、グループを暗示するような大量の液体は避けてください。\n\nその他の細かい構図は自由にデザインしてください。背景は、宿の一室、服を毛布代わりにした草原など、何でも構いません。\n\nいずれにせよ、このリクエストを読んでいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1qBgNulI9UQbD6wyvy-NS2ky1G6PgT8_V?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@noc_turn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3125324, "client_id": 1338696, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72ae32a7/uploads/origins/241283a9-4fcf-42d6-8d51-6fe876c414a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88fc40977ceea846e32d6037e8e132ed", "srcset": "https://si.imgix.net/72ae32a7/uploads/origins/241283a9-4fcf-42d6-8d51-6fe876c414a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88fc40977ceea846e32d6037e8e132ed, https://si.imgix.net/72ae32a7/uploads/origins/241283a9-4fcf-42d6-8d51-6fe876c414a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c70779086d7d61f248687b37bf592d4 2x, https://si.imgix.net/72ae32a7/uploads/origins/241283a9-4fcf-42d6-8d51-6fe876c414a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=055b8b9ab9315d0d28d01dd73892db82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72ae32a7/uploads/origins/241283a9-4fcf-42d6-8d51-6fe876c414a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e56eebb61ceaadc08970974b98dd2981", "srcset": "https://si.imgix.net/72ae32a7/uploads/origins/241283a9-4fcf-42d6-8d51-6fe876c414a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e56eebb61ceaadc08970974