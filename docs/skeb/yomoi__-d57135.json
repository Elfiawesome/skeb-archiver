r_acceptable_same_genre": true}, {"path": "/@yomoi__/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 550555, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b2791fe53cef92eb8247d2c375b1958", "srcset": "https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b2791fe53cef92eb8247d2c375b1958, https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b09c232c21d14acf503a2bfdb3fb1757 2x, https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18289511754e56a19091c17f82a63788 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d28ed5c047c5c306bca7c8df49a90db", "srcset": "https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d28ed5c047c5c306bca7c8df49a90db, https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6289c81abc32dc91325ec93559eedf6 2x, https://si.imgix.net/e4f61cae/uploads/origins/f8bd34bd-ea81-4c5f-b236-729bfc221049?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=040996628bcce2f8b69b056a433fcb01 3x"}, "body": "四方井 ぬい様\n\nこんばんは、四方井様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\nhttps://twitter.com/yomoi__/status/1651850000866099200　https://twitter.com/yomoi__/status/1660585699547156482　https://twitter.com/yomoi__/status/1658357837289111552　こちらの絵に惚れました！\n絵の表現のセンスが本当最高です…！！それにデフォルメ可愛くて！\nそんな四方井様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘で四方井様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、なんか美味しいものを食べさせてくださいませ。ちょっと現実味がなくても大丈夫です！\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomoi__/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 550555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=153dbae4f0b05d686cfdafca0c60f411", "srcset": "https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=153dbae4f0b05d686cfdafca0c60f411, https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64af89f4fa21b1adb4131d4547b20a5a 2x, https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2ff1901b5124506d3c3d0839aa11ff1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e135c18f694092f633c828f78fe1bbd2", "srcset": "https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e135c18f694092f633c828f78fe1bbd2, https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=285d526a5cb7bc53b99281218f143384 2x, https://si.imgix.net/3559dbcd/uploads/origins/8869b76b-3af3-4531-91d6-cf9c0b319655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e082b49594840a75c8bec5f9a08c1f01 3x"}, "body": "四方井さんの漫画でおいしそうに食事するキャラたちが、気持ちが伝わってきて好きです。今回の依頼分の報酬の一部をつかって、お好きな食べ物か興味あるけど未知の食べ物を買って、女の子キャラに食べさせてあげてください。もし期待外れの味でもそれはそれでおいしい（？）ですが、なるべく四方井さん自身も嬉しいものを召し上がっていただけると幸いです。完成した作品は、もし良ければTwitter等に自由に投稿して公開して下さい。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomoi__/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 550555, "client_id": 1203336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcb1279b/uploads/origins/865af17b-d547-41f2-be9f-9cfcf18127b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=669b3d0f46fd9783f7ea1924773f0db5", "srcset": "https://si.imgix.net/dcb1279b/uploads/origins/865af17b-d547-41f2-be9f-9cfcf18127b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=669b3d0f46fd9783f7ea1924773f0db5, https://si.imgix.net/dcb1279b/uploads/origins/865af17b-d547-41f2-be9f-9cfcf18127b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=755286ae5f77c74be36693a6229229a6 2x, https://si.imgix.net/dcb1279b/uploads/origins/865af17b-d547-41f2-be9f-9cfcf18127b7?bg