r=200&s=72677f12fc2b0c1c5552b975ec3db1fa, https://si.imgix.net/2ff7fd77/uploads/origins/8245a32f-ed35-4cce-8ba1-e867030ad178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1e7b42208b7ff26f7a9b97f98727295 2x, https://si.imgix.net/2ff7fd77/uploads/origins/8245a32f-ed35-4cce-8ba1-e867030ad178?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84cf629e6bf037b7999d50da291eaa43 3x"}, "body": "お世話になっております。もっそです\n\n前回のお師匠のイラスト本当にありがとうございました。\n尊さのあまり未だに画像倍率を100％で見れませんが最近は50%でおいしく楽しんでいます、たまに等倍にしますがやはり地に伏しています。\nだってかっこよすぎてぇ…………\n\n\n今回の依頼ですが、そうです、お師匠こと八屋蜂膳さんです\nそれと私のキャラクター、オオムラサキ(資料下記記載)とバチバチに喧嘩気味なっているのをお願いいたします\n喧嘩と言うか一触即発状態に近い、喧嘩2秒前みたいなのが良いです。\nもうすでに喧嘩していてもおいしいんですがお互い顔が近いとワクワクします\n喧嘩途中で服がボロボロになっていてもおいしい……こうなっては自分では決められません\n\n個人的にお互いの顔が近く睨み合っていれば最高です!!!!!!!\n喧嘩に関しても血は出てなくて構いません。\n\nオオムラサキの資料\nhttps://www.charasuji.com/users/overskip/illust/u_2023101122032515427\nこちらの服装でもなくてもワイシャツだけでも構いません\n\nかなり内容ふわふわですがどうぞ検討よろしくお願いいたします", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@draw_tkmr/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 65573, "client_id": 607576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65a46287/uploads/origins/4e427595-b188-43e4-9edd-79fba15b387b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bf518d93dd35da92de28bea6573b59d", "srcset": "https://si.imgix.net/65a46287/uploads/origins/4e427595-b188-43e4-9edd-79fba15b387b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bf518d93dd35da92de28bea6573b59d, https://si.imgix.net/65a46287/uploads/origins/4e427595-b188-43e4-9edd-79fba15b387b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb8a2a58cc59b1ab159e691f61bb7fd0 2x, https://si.imgix.net/65a46287/uploads/origins/4e427595-b188-43e4-9edd-79fba15b387b?bg=%23fff&auto=fo