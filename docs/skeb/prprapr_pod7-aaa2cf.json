=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cea9ce9db7b5dc09b3fdf54c3f9a46c", "srcset": "https://si.imgix.net/91d0b7c1/uploads/origins/3e617e33-7d28-4e9a-8674-f3da65f781e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cea9ce9db7b5dc09b3fdf54c3f9a46c, https://si.imgix.net/91d0b7c1/uploads/origins/3e617e33-7d28-4e9a-8674-f3da65f781e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9090f3c6e9d7d36290038cefbef6cb04 2x, https://si.imgix.net/91d0b7c1/uploads/origins/3e617e33-7d28-4e9a-8674-f3da65f781e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec086500519eab71a2d9ff3d0b8196a9 3x"}, "body": "こんにちは！あなたのページを見て、作品に一目惚れしました！特に、蛾の女ジュヴラーを描いた作品がとても気に入ったので、似たようなものを探しています！私のVTuberキャラクター「HELLZY」を描いていただけないでしょうか？彼女は悪魔のような猫です！狂気的で、いたずら好きで、危険な性格で、喧嘩が大好きで、血に飢えています。彼女はタキシード猫で、活動中の召喚陣を通り抜けてしまったのです。 \n\nピアスや目の下のクマも忘れずに描いてください。耳の毛も色違いです！主なテーマは、五芒星、悪魔、血、猫、肉、頭蓋骨と骨、牙、ゴシックです。ポーズや表情はご自由に決めていただいて構いませんが、可能であればホラーや不気味な雰囲気にしてください！\n\n参考画像：https://drive.google.com/drive/folders/1x2dKlmz7GKB1b_OY8ZbWXLsEuZ70FKzJ?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@prprapr_pod7/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526559, "client_id": 104478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43201346d35c07fcbbd2bb573a14267d", "srcset": "https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43201346d35c07fcbbd2bb573a14267d, https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1475a96701c5e2ed87e68b7ee9c40110 2x, https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b84d0aa8288c69928bcd4a321d979190 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=203c704444734dccfac46da8b0b3c2ff", "srcset": "https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=203c704444734dccfac46da8b0b3c2ff, https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c65b83e4a22742b5e2576ae64ccad175 2x, https://si.imgix.net/9972b8b0/uploads/origins/ff4dd249-6c88-4864-b4eb-b15b27171ced?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=370168b8d7f84a1e6ea34020b586fa5f 3x"}, "body": "初めまして山田さん。マイケルと申します。「くるみは今日も眠れない」の魔法使い（？）さんに惚れて前からフォローしていたので、skebがオープンされて嬉しいです。\n\n自創作「Project Nilarth」のキャラクターの一人（？）であるメイドの「チャナ」をお願いします。\n絵は木こりが住んでいるような森のコテージが舞台で、彼女がスカートから中近世ヨーロッパの農民が思いつくような物を何でもかんでもスカートの中から取り出しているイメージです。\n全身が映る構図でチャナがどのような存在なのかが一目でよくわかるようなイラストにしてください。\n\n設定に関しては、下の短編の主役なので、まず読んでいただけると嬉しいです。\nhttps://www.pixiv.net/novel/show.php?id=23624443\n\n\n\n\n\n【小説内でもわかる情報 ここから】\nいつも新たな主を探して、舞台である「アウリアース大陸」を放浪する健気なメイドの少女です。\n彼女のスカートには不思議な能力があり、主様が願えばどんなに大きな物でもスカートの中から取り出してしまいます。しかし、「魔法が使えるようになりたい」と願うと、元のチャナはどこかに逃げてしまい、主が新しいチャナになってしまうのです。\n【小説内でもわかる情報 ここまで】\n\n（あくまで作者のイメージですが）チャナは本質的に人間ではなく、「魔法の現象が人の形をしている」ようなものだと考えています。「全身が魔法でできている」ので、資料のデザイン画では表現しきれなかった様々な不思議な要素があります。\n・衣装の手袋と袖が一体化していたり、留めるためのカフス、肩紐、縫い目、継ぎ目などといった要素がありません。靴も留め具らしき部分が見当たりません。\n・スカートにはパニエやクリノリンらしい物も入っていないのに形状はふわふわしています。\n・スカートの内側はパステルカラーの光（異次元空間？）に繋がっていて、脚の付け根が見えません。暗黒スカートの逆のようなものです。\n・歩く度に足元にこっそり金平糖が現れたり、一見して怪しまれない範囲でそういった不思議な現象がこっそり周りで起きています。\n\n（TRPGの立ち絵で使用する可能性があるので、背景や物体、本体を分けたものがあると嬉しいです。）\n\n※重要※ 資料は世界観のイメージとキャラクターの2つに分かれています。資料URLにあるのがキャラクター本体です。\n世界観：https://imgur.com/a/project-nilarth-ytafVvg\n\nhttps://imgur.com/a/7UmBT81", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@prprapr_pod7/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0ad35f82/uploads/origins/ab7662df-ee78-44b3-b452-2836e1224cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed605d680afa6a42ec53f23cbaec4b0d", "srcset": "https://si.imgix.net/0ad35f82/uploads/origins/ab7662df-ee78-44b3-b452-2836e1224cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed605d680afa6a42ec53f23cbaec4b0d, https://si.imgix.net/0ad35f82/uploads/origins/ab7662df-ee78-44b3-b452-2836e1224cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=82c2bbd631f86153ab0be4b91ebd791b 2x, https://si.imgix.net/0ad35f82/uploads/origins/ab7662df-ee78-44b3-b452-2836e1224cd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=337353fc0f263d02a02fa1266b7680b3 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3526559, "client_id": 950051, "nc": 16}, {"path": "/@prprapr_pod7/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526559, "client_id": 1066697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fc378fd/uploads/origins/9bd875