かわいく描いていただけたらうれしいです。\n\n【キャラクター設定】\n・若い女性\n・ショート黒髪、アホ毛\n・左上のみ八重歯\n\n【シチュエーション】\n冬または春に和服を着ているシーンをひとつおまかせでおねがいします。\n冬なら雪や、春なら桜など、季節を感じやすいものがあるとうれしいです。\n着物や巫女装束のような伝統的なもののほか、和カフェの制服など現代的にアレンジされたものでも、和テイストがある衣装はなんでも好きです。\n\n【参考資料】\nhttps://drive.google.com/drive/folders/18PI6qEc8jvo0TKVWdyIxWiUT48Hbf8Jv\n資料のなかに参考にできそうな和風の衣装がないのですみませんが、かわいい服をなんでもお好きに着せていただければと思います。\n(「目のハイライトすくなめ, ダウナー系」などの基本設定はぜんぜん無視してきらきらの笑顔にしていただいてもとてもうれしいので、こまかいことはあまり気にしないで大丈夫です)", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@prprapr_pod7/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526559, "client_id": 586359, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0d28d38/uploads/origins/6fdc754a-67cd-48ba-b519-0209b5a88693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da3318c2b54d21ef0600139b3efdf7b", "srcset": "https://si.imgix.net/d0d28d38/uploads/origins/6fdc754a-67cd-48ba-b519-0209b5a88693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da3318c2b54d21ef0600139b3efdf7b, https://si.imgix.net/d0d28d38/uploads/origins/6fdc754a-67cd-48ba-b519-0209b5a88693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d3a338d5d072693f2797e46f8b17f26 2x, https://si.imgix.net/d0d28d38/uploads/origins/6fdc754a-67cd-48ba-b519-0209b5a88693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3ae57fe39618fad64d039a5afcb8400 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0d28d38/uploads/origins/6fdc754a-67cd-48ba-b519-0209b5a88693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1258106f2ee7bfa2619a81f124bba239", "srcset": "https://si.imgix.net/d0d28d38/uploads/origins/6fdc754a-67cd-48ba-b519-0209b5a88693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top