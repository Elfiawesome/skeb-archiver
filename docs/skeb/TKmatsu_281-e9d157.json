lur=200&s=ac286e08ab29cde61b4258d08598626d 3x"}, "body": "Greetings again! I really loved the artwork you did for me in the past, and I was hoping you would lend your talents again!\n\nThis is for another FFXIV character, who gives off a distinguished, formal personality. He is a Naval officer of sorts, recently promoted in spite of facing many difficulties. Though he manages to keep a professional disposition at most times, he can have an explosive temper when provoked, and harbors deep shame about crimes of his past.\n\nIn this commission, I would like him to embody the mood of a classical Navy officer portrait of the 19th century. I have included some references here for poses and mood: https://imgur.com/a/yX1kHO9\n\nThank you very much for your amazing work, once again!\n\nhttps://imgur.com/a/tr9oRv8", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TKmatsu_281/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 764065, "client_id": 950104, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aec69854/uploads/origins/ed65ec0e-a0b0-43af-9f7d-b7891ac9145a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da29ebfc6b094cf7555fe73e739c292", "srcset": "https://si.imgix.net/aec69854/uploads/origins/ed65ec0e-a0b0-43af-9f7d-b7891ac9145a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da29ebfc6b094cf7555fe73e739c292, https://si.imgix.net/aec69854/uploads/origins/ed65ec0e-a0b0-43af-9f7d-b7891ac9145a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=786942169e6ca337dc8f0b50ca27ed09 2x, https://si.imgix.net/aec69854/uploads/origins/ed65ec0e-a0b0-43af-9f7d-b7891ac9145a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03edf19c8f34ffbee7ce5d0858f50d13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls