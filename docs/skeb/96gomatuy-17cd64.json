mgix.net/47afe0af/uploads/origins/4524652d-ef5f-4d6f-a2e0-9f011dbcb8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=148dba745fee1d44e41ed0898abef4cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47afe0af/uploads/origins/4524652d-ef5f-4d6f-a2e0-9f011dbcb8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cee583923a9584f1788c23786d9ec257", "srcset": "https://si.imgix.net/47afe0af/uploads/origins/4524652d-ef5f-4d6f-a2e0-9f011dbcb8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cee583923a9584f1788c23786d9ec257, https://si.imgix.net/47afe0af/uploads/origins/4524652d-ef5f-4d6f-a2e0-9f011dbcb8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26fea1cd5924adca16e30c3797448785 2x, https://si.imgix.net/47afe0af/uploads/origins/4524652d-ef5f-4d6f-a2e0-9f011dbcb8c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d7d7a5d7ac9d163321f0ea88b1ad6c7 3x"}, "body": "Hello Myan-sensei, nice to meet you! I saw your works on X and really enjoy your CoC graphics layouts. Your character artwork is very stylish!!\n\nI love the atmosphere in these posters:\nx.com/96gomatuy/status/1805633782202220851\nx.com/96gomatuy/status/1662393781407330307\n\nIf possible, I would like to request a 'fake' scenario poster for two original ttrpg characters. Strange threads of fate have brought these two people together. Their relationship is like siblings who quarrel to show affection.\n\nThe main setting is a Chinese martial arts adventure to solve a mystery. Perhaps the two travellers encounter a strange village, hidden treasures, or slumbering ghosts? The theme is not set, so please draw as you wish!\n\n\u2600\ufe0f OUYANG [\u6b50\u967d] (27 years | 185cm) - A tomb raider, criminal, and keeper of history. He has an unsociable appearance but has a warm heart. He is a monk who relies on his fists. Please use outfit (1A) and note the sharp lower teeth! His themes are the sun, the sea, and there is the shadow of a monstrous snake in his past. He has promised the girl's mentor that he would protect her.\n\n\ud83c\udf0c ZIWEN [\u6893\u95fb] (16 years | 163cm) - A scowling young assassin who burns fiercely for justice. She belongs to a race of bird people but is on the run after having her wings taken away. When she puts on the cloak given to her by her mentor, she can transform into a bird. Her themes are stars and magpies. She finds it difficult to trust, but is slowly learning to rely on her new friend.\n\nReference images: https://drive.google.com/drive/folders/1EQBoDhtyShtiHe2J7L-ct56RIA9bx1a7\n\nI have included some images in the link for inspiration, but I'll leave it up to you! Feel free to draw whatever you want. If it seems too difficult, please feel free to appeal the price or decline!\n\nThank you for considering..! \ud83d\udc9e", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1235017, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "\u30e2\u30a4\u30b8", "screen_name": "moimoiji", "avatar_url": "https://pbs.twimg.com/profile_images/1968053385195819008/wn6HkF34.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1830575754360561664/1736231914/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2368279, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "\u304a\u304f\u3089\u305f\u307e", "screen_name": "sunaoni704", "avatar_url": "https://pbs.twimg.com/profile_images/2006000859457728512/a8gSbZn-.jpg", "header_url": "https://pbs.twimg.com/pr