a7fb6b/uploads/origins/33c0181f-552d-4901-81e2-8964f57092f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=088bd3fdaa609ed7347ea333c79d7dea", "srcset": "https://si.imgix.net/52a7fb6b/uploads/origins/33c0181f-552d-4901-81e2-8964f57092f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=088bd3fdaa609ed7347ea333c79d7dea, https://si.imgix.net/52a7fb6b/uploads/origins/33c0181f-552d-4901-81e2-8964f57092f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de6d830ddcb6070c318ec2237c81cec4 2x, https://si.imgix.net/52a7fb6b/uploads/origins/33c0181f-552d-4901-81e2-8964f57092f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb6b7180716549f60eb7ea8ccf49a99 3x"}, "body": "こんにちは！\n素晴らしいイラストをありがとうございます！\n次のご依頼ですが、ナズーリンがエロティックなコスプレを強制されるシーンを描いていただけませんか？\n例えば、明らかに短すぎて肌を露出しすぎたチアリーダー服をナズーリンに着せられる様子、普段着がミニスカートに変わってしまった姿、あるいは逆バニー服姿など、様々な例が見られれば嬉しいです！\n全てはお任せします。\nいつもありがとうございます！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pnk_wonderful/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3687454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c4c78fceace7e0e7cfd58c4c1eedd29", "srcset": "https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c4c78fceace7e0e7cfd58c4c1eedd29, https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=212dbe0acdd4ac15d14d92bf88912351 2x, https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57babbc2afe764b01c0b73e0d0239e75 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b7ffc4c4c863594786b488e483472c", "srcset": "https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b7ffc4c4c863594786b488e483472c, https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd3b5c6321dc509f2f5485ab83a3033b 2x, https://si.imgix.net/46b11118/uploads/origins/0e84707b-7289-4eba-a910-bf900ef5f3d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c72c4d7c2ae137112d7668ded66187 3x"}, "body": "いつもイラスト・コミック拝見させていただいています。\n東方Projectの秘封倶楽部（宇佐見蓮子・マエリベリー・ハーン）の2人について、短めの漫画をお願いしたいです。宇佐見蓮子がメインになり、マエリベリー・ハーンの出番はそこまで多くないかもしれません。\n\n大まかなストーリーのイメージは以下のとおりです。\nーーーーーーーーーー\n気がつくと寂れた神社（博麗神社）の境内に倒れていた蓮子。\nあれ？なんでこんなところで寝てるんだろう。そうだ、秘封倶楽部の活動で、世界の秘密を暴きに、1人でこの神社を調べに来たんだ。…1人？あれ、誰か一緒にいたような……あれ……？\nなぜか涙が溢れて止まらない。何も記憶にないのに、秘封倶楽部は私1人のはずなのに、たしかに、ずっと私の隣に誰かがいたような気がして。まるでぽっかり心に穴が空いたような、そんな気がして…………。\nいくら思い出そうとしても何も思い出せず、ただただ涙が溢れるだけだった。\nーーーーーーーーーー\nという、マエリベリー・ハーンが外の世界から消失したというバッドエンドの体でお願いしたいです。\n上記のイメージを元に、けぽなさんの浮かんだイメージで描いていただいて問題ありません。イメージに沿っていなくてもOKです。\n\nなお、2人の服装は、蓮台野夜行のものであると嬉しいです。\n\nよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pnk_wonderful/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3687454, "client_id": 628923, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/435e5e2a/uploads/origins/1ae26322-d51b-43e3-802e