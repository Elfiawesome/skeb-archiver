://si.imgix.net/716802e5/uploads/origins/652946cd-b059-4d61-9b09-220840ab2250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0fc8c64422217c9b0504d7df6d5d349 3x"}, "body": "こんにちは！！！！！！！！！！！！！！！！！（笑MP40のSFWボディピロー風の絵をお願いしたいと思います。\n制服を完全に着ていて、できれば帽子を体の横に置いて、手袋と太もものストラップを忘れないでほしいです。\n\n顔は、目を少し閉じた幸せそうな表情がいいですね。参考までに、2月15日に描いていただいたMP40の絵（https://twitter.com/toryu_fufu/status/1361290848156049410?s=20）を見てみると、もう少し顔を赤らめた表情がいいですね。ちょっとしたお願いですが、ゲーム中の絵のように、口元がほんの少し「：3」の笑顔をお願いします。(もし、それがあなたのスタイルに合わないと思われるのであれば、入れなくても構いませんが）。)\n\n服装については、これはエロティックな絵ではないので、ごくわずかなヌードがあるだけです。彼女の制服はボタンを外した状態にしたいのですが、彼女がまだ着ている限り、どのようにでも見えます。シャツのボタンは2つか3つだけ外して、胸の谷間を見せてほしいです。ネクタイは少し乱れていて、あまり調整されていませんが、しっかりと固定されているようにしてください。\n手袋と太もものストラップがあることを確認するだけで、あとはお好きなものを入れてください。\nブーツを履いていても、靴下だけでも構いません。\n\nポーズも自由自在です。ボディーピローのスタイルに合ったものを選んでください。\n\nできれば、あなたのサインが入ったものと入っていないものが欲しいです。できない場合は、何も書かれていないものをお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 33075, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぱにっくかれえるーむ", "screen_name": "oteageinkaree", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F8563c8c9-2b02-4965-8886-d9dc92af9c18.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 667052, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "io2o", "screen_name": "io_oekaki2", "avatar_url": "https://pbs.twimg.com/profile_images/1673566555337097218/UtjRscQs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3193372633/1680835351/1500x500", "appeal_receivable": false, "popular_creator_rank":