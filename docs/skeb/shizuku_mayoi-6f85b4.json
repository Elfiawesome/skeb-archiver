ます！\n\n希望内容\n【シチュエーション】ニーナちゃんが水着でプールに入っている\n【衣装】おまかせ…ビキニタイプだと嬉しいなぁ…\n【プール】スプラトゥーンのオーバーフロッシャーの様な感じで\n【ポーズ】おまかせ\n【表情】おまかせ\n\nイラストは配信のサムネイルやSNSでの投稿などに(ご本人次第ですが)使って頂ければと思います。\nそのため髪の毛や指の先が見切れていない構図でお願いします。\n人物と背景を分けたPSDファイルも用意して頂けるとありがたいです。\n推しの水着が見たいんです！何卒！！何卒！！！\n宜しくお願い致します！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shizuku_mayoi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2175368, "client_id": 3324164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52c05b5f/uploads/origins/cda4684a-04a9-438b-85e3-c5c5d263b9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccd7c3398dccc9c84c862d1106380060", "srcset": "https://si.imgix.net/52c05b5f/uploads/origins/cda4684a-04a9-438b-85e3-c5c5d263b9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccd7c3398dccc9c84c862d1106380060, https://si.imgix.net/52c05b5f/uploads/origins/cda4684a-04a9-438b-85e3-c5c5d263b9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ba432783ff5b54b6028b292dda6ba9d 2x, https://si.imgix.net/52c05b5f/uploads/origins/cda4684a-04a9-438b-85e3-c5c5d263b9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae585c3c8fe4f63cd355373e00396bd2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52c05b5f/uploads/origins/cda4684a-04a9-438b-85e3-c5c5d263b9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f14c836820eaedc89e627ba1db67496f", "srcset": "https://si.imgix.net/52c05b5f/uploads/origins/cda4684a-04a9-438b-85e3-c5c5d263b9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f14c836820eaedc89e627ba1db67496f, https://si.imgix.net/52c05b5f/uploads/origins/cda4684a-04a9-438b-85e3-c5c5d263b9a2?bg=%23fff&auto=format%2Ccompress&f