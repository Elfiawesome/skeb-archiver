を着たイラストを描いて貰いたい\n\n資料について\n・舞原音の三面図的な資料集は無いですが、今までに描いて貰ったイラストをまとめたものがあるので、それを参考イラストとして使ってください。イラストはGoogle Driveにまとめてあり、要項にURLを添付します\n\n絵柄について\n・最近よく描いてらっしゃるハイブリッド絵柄でお願いします\n\n舞原音を描く際の注意点について\n・舞原音の身長は145cm。マチポケ組とほぼ同じくらい\n・髪の毛は向かって左側の髪の毛が一束横にハネている\n・胸のサイズは東雲つむぎ参照\n\nシチュエーション\n・マチポケ組に「着てみて！」とせがまれたので貸してもらった中等部の制服を身に着けてみると、サイズもピッタリで似合ってしまっている自分がいる。\n自分は教師だし、元成人男性だから中等部の制服が似合っている現状が凄く恥ずかしいのに、同時に嬉しさ、背徳感も感じてしまっている\n\n表情\n・顔は赤らめているんだけど、何故か口角が上がっちゃっているような、『恥ずかしいけど楽しいし嬉しい』という感情が表れてると凄く良いです\n\nポーズ\n・手でスカートの裾をぎゅっと握る感じがすっごく可愛いと思っています\n\nhttps://drive.google.com/drive/folders/1DtzcUHMjiFV3yv5-bJwdm974n11tFbEZ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 104917, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "なっちゅ", "screen_name": "I_At3__", "avatar_url": "https://pbs.twimg.com/profile_images/2019073581750304768/MXKoVn8b.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1878694177/1753512405/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 518176, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "５５", "screen_name": "matsudai_d", "avatar_url": "https://pbs.twimg.com/profile_images/1993195974119112707/Ytw8LVIw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1589991650470039553/1763968864/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2452063, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鳶町ジョア", 