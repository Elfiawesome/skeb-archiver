ク衣装のロング・カーディガンあり 』 の衣装でお願いしたいです。\n\n【納品形式希望】\n\nレイヤーの分かれた、psdデータでのお渡しですと幸いです。\n\n【資料】\n\nhttps://drive.google.com/drive/folders/1-Z6taBMPHxDKx8W-hW_dONZi4AmVlQgl\n\n料金等問題がございましたら再送していただけたら幸いです。\nご検討していただけると幸いです。どうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2kashun_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3903199, "client_id": 1308705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb661f1b/uploads/origins/1d5f99c7-300c-4492-b1aa-09d4ab32f4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9065bd7b0b7018eb0623e182387b834b", "srcset": "https://si.imgix.net/cb661f1b/uploads/origins/1d5f99c7-300c-4492-b1aa-09d4ab32f4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9065bd7b0b7018eb0623e182387b834b, https://si.imgix.net/cb661f1b/uploads/origins/1d5f99c7-300c-4492-b1aa-09d4ab32f4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=605618bb086174f8b374c1d84efce08e 2x, https://si.imgix.net/cb661f1b/uploads/origins/1d5f99c7-300c-4492-b1aa-09d4ab32f4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfab12925d5e2dad39e2c3ba777b0d3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb661f1b/uploads/origins/1d5f99c7-300c-4492-b1aa-09d4ab32f4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9335882b0f97a0721e81baa9f161325e", "srcset": "https://si.imgix.net/cb661f1b/uploads/origins/1d5f99c7-300c-4492-b1aa-09d4ab32f4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9335882b0f97a0721e81baa9f161325e, https://si.imgix.net/cb661f1b/uploads/origins/1d5f99c7-300c-4492-b1aa-09d4ab32f4b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&