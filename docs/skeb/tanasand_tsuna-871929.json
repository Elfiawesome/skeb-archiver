bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=420edd5f3e16f79f5d8c2354ee75d0e4 3x"}, "body": "はじめまして\nたなさんど先生のイラストを拝見し、ブルーアーカイブの「春原ココナ」を書いていただきたいと思いました。\n\n服装は園児服で恥ずかしがってる表情を希望します。ポーズはおまかせで構いません。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanasand_tsuna/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 613900, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f00f2e9378a69c33c9789cf1b191ecf", "srcset": "https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f00f2e9378a69c33c9789cf1b191ecf, https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab0efeea7f294ab52841090ef736da77 2x, https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf5bcb5005ab1d81030952cd2f2ea770 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a50b51a25369b86374f9177f276ad17", "srcset": "https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a50b51a25369b86374f9177f276ad17, https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b20ca4d5936702f3aee8f6297db9c6a 2x, https://si.imgix.net/e4630154/uploads/origins/a5a7ba44-57a9-4764-b91c-4e165fafc916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1c3adf4e4ab7cd6f5fe7ffe6aaacfe1 3x"}, "body": "ツナ抜きたなさんど様\n\n犬耳、尻尾の巫女の女の子が種子島(鉄砲)で射撃姿勢を取っている、もしくは射撃している絵を描いていただけないでしょうか。\n\n詳細\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは任せます)\n射撃姿勢　立ち射ち、膝射ち、座り射ち、寝射ちの中からお願いします。指を引き金にかけて、今にも射撃をしそうな状況、あるいは射撃している状況をお願いします。\n種子島　一般的な大きさである小筒のほか、大型である中筒、士筒のどれを使っていても構いません。\n巫女装束　巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n表情　恐怖で怯えている以外でしたら好きに描写して構いません。(例　落ち着いた感じで淡々としている、不敵な笑みを浮かべている、穏やかに微笑んでいる、戦闘狂染みている、自我を失っている等)\n胸部　貧から爆までの範囲でお任せします。\nその他　早合「http://www.xn--u9j370humdba539qcybpym.jp/part1/archives/35」、「https://www.meihaku.jp/arquebus-basic/matchlock-launchmethod/」を首から下げている。(または袈裟懸けで下げている)\n負傷描写等　一切なくても構いませんし、軽傷または重傷でありながらも堪えている、ないしはものともしないような描写でも構いません。また、土や泥の汚れについても任せます。\n巫女装束が損傷していても構いませんが、下着等が露出することがないようにお願いします。\n\nセリフ等差分\n内容等に合うものを委任します。\n\nツナ抜きたなさんど様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanasand_tsuna/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 613900, "client_id": 606875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/187cf707/uploads/origins/49211717-d723-48ac-a570-510ee4521dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf217d5a96b3e66c4c8fdc28de240234", "srcset": "https://si.imgix.net/187cf707/uploads/origins/49211717-d723-48ac-a570-510ee4521dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf217d5a96b3e66c4c8fdc28de240234, https://si.imgix.net/187cf707/uploads/origins/49211717-d723-48ac-a570-510ee4521dc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd40e098296100f07f38ad620ad5cf40 2x, ht