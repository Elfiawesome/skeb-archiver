8e70129e78a770d 2x, https://si.imgix.net/1239e0f7/uploads/origins/8b8bfca4-980d-4da4-b528-1ddf051f9838?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b38bd96a0f2cf126e653e19ca2b83afe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1239e0f7/uploads/origins/8b8bfca4-980d-4da4-b528-1ddf051f9838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43a2162961c23a263ec22ebc269d36e6", "srcset": "https://si.imgix.net/1239e0f7/uploads/origins/8b8bfca4-980d-4da4-b528-1ddf051f9838?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43a2162961c23a263ec22ebc269d36e6, https://si.imgix.net/1239e0f7/uploads/origins/8b8bfca4-980d-4da4-b528-1ddf051f9838?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2218075e10165c1df427b4ceb3fc2c1 2x, https://si.imgix.net/1239e0f7/uploads/origins/8b8bfca4-980d-4da4-b528-1ddf051f9838?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e65b23eac97d09b89a89846eb4ce5e95 3x"}, "body": "自由様へ\n\n　いつもお世話になっております。\n\n　アズリウスのイラストをよくお願いしているものです。いつもリクエストに応えていただいて本当に感謝申し上げます。\n　以前にも似たリクエストをお送りしていますが、スマホの壁紙用にアズリウスのイラストを再びお願いしたいと思い、リクエストをお送りいたします。\n　お願いしたいリクエストの詳細は以下の通りとなります。\n\n・スマホの壁紙に使えそうな縦長サイズにて、またアズリウスのイラストをお願い出来ればと思います。\n・秋が近くなって寒くなってきますので、秋の休日を温かい私服を着て窓辺で過ごすようなイメージのイラストをお願いしたいです。\n・私服のイメージですが、上はもこもこした白の縦セーター。下は濃い茶のスカートと黒のニーハイソックスと言うようなお嬢様っぽいイメージでのコーデをお願いします。それと、温かい飲み物を入れたマグカップを持たせてくれると嬉しいです。\n\n・前回の様にNSFWの差分ないし二組目をお願いできれば幸いです。\n（※上記の内容と一部異なっており、著しい注文だった場合はキャンセルしてください）\n　差分についてはリードの付いた首輪とニーハイソックス、それに緊縛用の青い縄のみの姿でお願いします。縛り方は腕を後ろ手に回す高手後手というのと、股に縄を通す股縄という縛りでお願いします。一枚目の昼間に団らんしたスペースで、夜に窓辺で緊縛露出プレイに付き合っているようなイメージを考えてもらえれば幸いです。\n\n　リクエストの詳細は以上になります。\n　宜しければご検討いただけると幸いです。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JIYU_SheStudio/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3629895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed798e2042dc2a7ff543c0867c8c30b", "srcset": "https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bed798e2042dc2a7ff543c0867c8c30b, https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7999aed1dc81089fa9b1df0031767bb 2x, https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06567e014747a72311884484c3050706 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4cf81ef0e0d27155497916c372899c8", "srcset": "https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4cf81ef0e0d27155497916c372899c8, https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4bebcf06e5cd0c425730e8197321ffa 2x, https://si.imgix.net/8229a91f/uploads/origins/405679ea-7c28-4ac9-8d61-deaba7fbf124?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3944419ee5a46063e4af90a50a1fca73 3x"}, "body": "自由様\n\nいつもお世話になっております。\n自由様のわんこアズリウスのシリーズを始めとしたイラストをいつも楽しみに拝見しております。\n良ければ再びアズリウスのイラストのを拝見したく、リクエストをお送りいたします。\n（もし体調不良やモチベーションの不足などあれば遠慮なくキャンセルしてください）\n\nリクエストさせて頂きたい内容についてですが、「アズリウスが机の下に縛り付けられ、こっそり奉仕させられてる」というようなイメージのものをお願いしたいです。\n（シチュエーションとしては「机の下のフェラ」の緊縛込みの状況で、イメージとしては下記のイラストのようなものになります。shio−bariさんという方のpixivのイラストへのURLリンクです。構図やアングルについてはアズリウスのお顔が描きやすいようにしていただければと思います。\n百科事典：「机の下のフェラ」→\nhttps://dic.pixiv.net/a/%E6%9C%BA%E3%81%AE%E4%B8%8B%E3%81%AE%E3%83%95%E3%82%A7%E3%83%A9\nshio−bari様のイラスト↓\nhttps://www.pixiv.net/artworks/111027700　）\n\n具体的な要素として以下の通りに挙げさせて頂きます。\n\n〇服は無しで、いつもの首輪と身体を縛る縄、それに攻め用の大人の玩具だけの姿でお願いします。\n〇縛り方は後ろ手に縛る高手後手と股縄という縛り方でお願いします。また足についても同様に縛って身動き取れないような姿でお願いいたします。\n縄の色はアズリウスの肌に合いそうな青、または赤だと幸いです。\n参考・pixiv百科事典より\n高手後手→https://dic.pixiv.net/a/%E9%AB%98%E6%89%8B%E5%B0%8F%E6%89%8B\n股縄→https://dic.pixiv.net/a/%E8%82%A1%E7%B8%84\n\n〇シチュエーションとしては「お相手（ドクター）の趣味に付き合い、机の下で縛られて身動き取れない状態で、お相手のを口で奉仕している最中」というようなイメージでお願いします。\n（このシチュだとアズリウスを写す角度と構図的が大変かと思うので、ドクターは見えなくても大丈夫です）\n〇ご面倒でなければ奉仕中のアズリウスの心境を表す簡単な台詞を入れてもらえれば幸いです。\n〇差分に「隠れて口で奉仕中に誰かが部屋を訪れて目を見開いて驚く」「無事バレずに出て行ってもらえるところで射精を口の中で受ける」「その事後」とストーリーの差分もお願いできればと考えていますが、作業量が過多になるかと思われますので、負担が大きすぎれば省略してください。\n\nお願いしたい要素の詳細は以上になります。\n重ねて申し上げますが、もしご体調が悪いようでしたりモチベーションが良くないような状況であればご遠慮なくキャンセルなどして下さい。受けていただけれる場合も無理なく制作して頂けば幸いです。\n自由さんのイラストをいつも楽しみにしております。それではご検討宜しくお願い致します。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JIYU_SheStudio/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3629895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e8adf7b183b9d9fd69181d625f74ca", "srcset": "https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6e8adf7b183b9d9fd69181d625f74ca, https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4f13cfc27f5ea28c05e087d26174f53 2x, https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ca28184e7131e1026b3cbb53cfca2d6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66b53f2000cd4491bced95d2304c340c", "srcset": "https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66b53f2000cd4491bced95d2304c340c, https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cca3edda609d777ccdb652de3d3822da 2x, https://si.imgix.net/0174724c/uploads/origins/f062a71b-e95e-4d2a-922f-300ed9ca32c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74626b80ed2ffb12dd1cb2784cf159e4 3x"}, "body": "自由様\n\nお世話になっております。\n自由さんのわんこアズリウスのシリーズを始めとしたイラストをいつも楽しみに拝見しております。\n良ければまたイラストの制作をお願いしたくリクエストをお送りいたします。\n\nリクエストについてですが、「偽装拘束されて散歩に連れ出されてるアズリウス」をお願いしたいです。\n\n（偽装拘束とは『上着の下は全裸緊縛されている』というような一見すると普通の格好に見えるよう偽装された姿で拘束されてるというジャンルです。参考pixiv百科事典より→https://dic.pixiv.net/a/%E5%81%BD%E8%A3%85%E6%8B%98%E6%9D%9F）\n\n具体的なシチュエーションの希望は以下の通りになります。\n\n〇『一見するとドクターのぶかっとして大きめなコートを羽織っているように見えるが肩に掛けられているだけで袖も通しておらず、その下はリード付首輪+制服の黒タイツ+逆競泳水着のみの裸に近い状態であり、身体はキツく緊縛されている』というようなシチュエーションでお願いします。\n\n〇縛り方は後ろ手に縛る高手後手と股縄という縛り方でお願いします。股縄はタイツの上で、縄の色はアズリウスに合いそうなので青だと幸いです。\n参考・pixiv百科事典より\n高手後手→https://dic.pixiv.net/a/%E9%AB%98%E6%89%8B%E5%B0%8F%E6%89%8B\n股縄→https://dic.pixiv.net/a/%E8%82%A1%E7%B8%84\n\n〇タイツの下の秘部に大人の玩具のバイブレーターをお願いいたします。\n\n〇もし良ければ差分にコート無し、黒タイツとコート無しでの差分を拝見出来れば幸いです。\n\n以上になります。解釈違いや性癖に合わない等が無ければご検討よろしくお願いいたします。", "nc":