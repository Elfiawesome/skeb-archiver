様にお任せ致します。\n動画で使いやすいよう人物や文字や背景等ありましたら分けていただけますととても助かります。\n\nリクエストに問題等無ければ、受理していただけると幸いです。\n金額が足りない場合、そもそも依頼内容のイラストを受け付けていない場合はキャンセルしていただけたらと思います！\n良ければよろしくお願いします！！\n\n以下キャラクターの資料URLになります。\nこちらの参考の画像を確認していただければなと思います！\nhttps://drive.google.com/drive/folders/1CIGdZlqzpUOSynzE21vmH-3uprR0oSaR?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1CIGdZlqzpUOSynzE21vmH-3uprR0oSaR?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomito_0726/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fc2f52be/uploads/origins/a65a78e0-043a-4b73-b1ac-4dd8161f854b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e023f5559940190fc9384c7a7c88f6c3", "srcset": "https://si.imgix.net/fc2f52be/uploads/origins/a65a78e0-043a-4b73-b1ac-4dd8161f854b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e023f5559940190fc9384c7a7c88f6c3, https://si.imgix.net/fc2f52be/uploads/origins/a65a78e0-043a-4b73-b1ac-4dd8161f854b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=165054a0126bc98b19d7b526e764322f 2x, https://si.imgix.net/fc2f52be/uploads/origins/a65a78e0-043a-4b73-b1ac-4dd8161f854b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de6afb3f9d6f5f293f46a4ed2995a2ab 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2965876, "client_id": 2920756, "nc": 0}, {"path": "/@yomito_0726/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2965876, "client_id": 2754404,