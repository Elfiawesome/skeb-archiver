ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab6e27ed01046039ceef483e28d77007 3x"}, "body": "アローラ地方のおきみやげ様、初めまして！\n 素敵なイラストを拝見させていただいております。  \nとても可愛いらしい絵なので、この度是非依頼をしたいと思いリクエストをお送りさせていただきました。  \nダブルクロスというＴＲＰＧで友人の氷雨さんが使っているキャラクター、ヘルカ・エンプラのイラストをお願いしたいです。\n 雪結晶のような天輪を持つ氷使いの高校生の少女になります。  念のため、キャラクターシートもこちらに載せておきます。 \n\n(https://character-sheets.appspot.com/dx3/edit.html?key=ahVzfmNoYXJhY3Rlci1zaGVldHMtbXByFwsSDUNoYXJhY3RlckRhdGEYquGqiAUM)  \n表情並びに構図は、アローラ地方のおきみやげ様にお任せいたします。\n以下、資料のURLになります。ご検討のほどよろしくお願いします ！！\n\nhttps://twitter.com/Hisame0414/status/1692108549562974714\nhttps://skeb.jp/@xoxohyh/works/15\n\n\n\n以下は箇条書きになりますがヘルカさんの外見詳細になります。\nご参考にして頂ければ幸いです。\n・雪結晶のような天輪を持つ(要は透き通ったソシャゲです)\n・身長に対しては足が長く、長い蒼〜水色の髪をツインテールにして纏めている。\n・ 服装は白のセーラー服、スカートと水色のリボンを身につけているが、氷のモチーフが散りばめられたデザインのタイツ等全体的にクールな印象を与える。\n・ 目は氷のように澄んだ青色で、普段は無表情であるが、微かな感情が浮かぶことがある。\n・外出が多いため靴は赤のスニーカーを愛用している。\n・ 黒いマフラーを巻いているがこれは恩師からの思い出の品。\n・ツインテールは赤のリボンでも結ばれ、前髪は赤と黒の髪留め(パフィンのイメージ)で留められている。\n・肌は透き通るように白く、冷たい印象を与える。\n・学園入学後、ファッションとしての身体改造(この世界ではポピュラー)で鳥の因子を取り込み腰より翼が生えている。鳥の種類はパフィン。(要は...透き通ったソシャゲです)\n・白い制服にマフラーと、全体のシルエットはパフィンをイメージしたもの", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 268913, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "タカハラ ヰロハ", "screen_name": "Yellowhlnch", "avatar_url": "https://pbs.twimg.com/profile_images/1688168520994242560/3SmtMZCx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/899856019/1737045061/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 33}, {"id": 595307, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Alala🍣🍕", "screen_name": "sushi_pizza_RRR", "avatar_url": "https://pbs.twimg.com/profile_im