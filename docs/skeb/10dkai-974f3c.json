06e\u30a4\u30e9\u30b9\u30c8\u3092\u62dd\u898b\u3057\u3001\u662f\u975e\u3068\u3082\u79c1\u81ea\u8eab\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3044\u3001\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\u304a\u5f15\u304d\u53d7\u3051\u3044\u305f\u3060\u3051\u308b\u3068\u5927\u5909\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u4f7f\u7528\u7528\u9014\u3067\u3059\u304c\u3001\u63cf\u3044\u3066\u3044\u305f\u3060\u3044\u305f\u30a4\u30e9\u30b9\u30c8\u306fV\u30e9\u30a4\u30d0\u30fc\u3068\u3057\u3066\u306e\u6d3b\u52d5\u306b\u4f7f\u3046\u5834\u5408\u304c\u3042\u308a\u3001\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u30c7\u30b8\u30bf\u30eb\u30b0\u30c3\u30ba\u30fb\u30ea\u30a2\u30eb\u30b0\u30c3\u30ba\u306a\u3069\u306e\u4f5c\u6210\u3001\u305d\u308c\u3089\u3092\u524d\u63d0\u3068\u3057\u3066\u306e\u4f9d\u983c\u306b\u306a\u308a\u307e\u3059\u3002\u2028\u2028\u305d\u306e\u305f\u3081\u3001\u5b9b\u540d\u3084\u80cc\u666f\u306a\u3069\u304c\u3042\u308b\u5834\u5408\u306f\u305d\u308c\u305e\u308c\u306e\u30ec\u30a4\u30e4\u30fc\u3092\u5206\u3051\u3066\u306e\u7d0d\u54c1\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u30a4\u30e9\u30b9\u30c8\u306e\u30b5\u30a4\u30ba\u3067\u3059\u304c\u3001\u30a4\u30e9\u30b9\u30c8\u3092\u30c8\u30ea\u30df\u30f3\u30b0\u3057\u3066\u4f7f\u7528\u3059\u308b\u5834\u5408\u304c\u3042\u308b\u3053\u3068\u3001\u914d\u4fe1\u306b\u5229\u7528\u3059\u308b\u5834\u5408\u4e00\u65b9\u306e\u30b5\u30a4\u30ba\u304c\u9577\u304f\u30663000p\u3042\u308a\u3001\u52a0\u3048\u3066\u30b0\u30c3\u30ba\u5316\u3059\u308b\u969b\u306e\u89e3\u50cf\u5ea6\u3092\u3042\u3052\u305f\u3044\u305f\u3081\u5927\u304d\u3081\u306e\u30ad\u30e3\u30f3\u30d0\u30b9\u3067\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\u2028\u30ad\u30e3\u30f3\u30d0\u30b9\u306f\u7e26\u6a2a\u3069\u3061\u3089\u3067\u3082\u304b\u307e\u3044\u307e\u305b\u3093\u304c\u3001\u53ef\u80fd\u3067\u3042\u308c\u3070\u6a2a\uff08\u767d\u9280\u6bd4 (1:\u221a2)\uff09\u3067\u304a\u9858\u3