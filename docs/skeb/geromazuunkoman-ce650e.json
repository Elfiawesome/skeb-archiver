//si.imgix.net/4b15082a/uploads/origins/2670d6f8-803a-48d2-bf29-e618ca483e47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6372b05faf48a4b136e6cf0c95e18a4e 3x"}, "body": "前回のエロギャルコウテイペンギンありがとうございました！\n\n今回は同じような立ち絵と堕ちの構成でシンフォギアＧＸ版の雪音クリス（イチイバル装備）で依頼させていただきます。\n\n３０代半ば位に成長してムチムチに熟れた体にきつい衣装の状態で恥ずかしがる画から\n\n片手で睾丸を握り潰されてもう片手で陰茎の皮を無理やり剥かれて泣きながら悶絶する流れでお願いします。\n可能なら股間がダメになって小水を漏らしながら膝から崩れ落ちる様も。\n\n恥ずかしがる画は特に衣装の破損はなく股間モッコリで贅肉や睾丸がちょっとはみ出すような感じで。\n\n性器攻めの時は服が前からビリビリに破られて前全開で乳房や性器丸出し。\n\nクリスの体系は爆乳巨乳輪で乳首は小さ目、陰毛アリで陰茎は子供っぽい大きさの包茎、対して睾丸は大きめでミカン位の大きさで希望します。\n\n\nご検討のほどよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@geromazuunkoman/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 546016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc261c4bcb69a9324082dd60b8ce4f0", "srcset": "https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc261c4bcb69a9324082dd60b8ce4f0, https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0aa29cdf94b0a633fe1efceb6cec5ef9 2x, https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea1bebf74a534a194765afd5a8473e6f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06ef6cde2b70bf78f58eaab8caaf233f", "srcset": "https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06ef6cde2b70bf78f58eaab8caaf233f, https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b816811498e6cc10baa08eff0d575d0e 2x, https://si.imgix.net/bd2ea390/uploads/origins/0dfeade5-f668-4a5d-a461-0cf3fc46cea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a92566e64f8dc9b600c1b7934c5519ea 3x"}, "body": "こちらがよかったので\nhttps://skeb.jp/@geromazuunkoman/works/2\n同じキャラを同じ体型で非ふたなり妊娠３か月にしたものでプリキュアシリーズのキュアスカーレットのコスプレさせられた状態で殺人技トーチャースラッシュを喰らった画をお願いします\n\nトーチャースラッシュ参考画像\nhttps://ch.nicovideo.jp/wishstar/blomaga/ar462632\n・キュアスカーレット衣装はノーブラノーパンで豊満な体に大きさが合っていない感じでスカーレットのウィッグ着用\n\n３コマ構成希望で\n・恥ずかしがる立ち絵\n\n・https://f.hatena.ne.jp/tokumeikunkun/20210611213938\nこのような技決め止め画で胸がこぼれだして股間も丸出しになっているのが見えるアングル\n攻め役は適当で\n\n・https://f.hatena.ne.jp/tokumeikunkun/20210611214117\n下半身が裂けて子宮辺りから小さな胎児がこぼれだす\n\n内臓リョナがだめでしたら１，２コマの何れかで構いませんのでお頼みします", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@geromazuunkoman/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 546016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c48f7e42/uploads/origins/08d30771-c24b-43f4-a7b9-f1e9e010236d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96171b254a5c076271d379576a569b04", "srcset": "https://si.imgix.net/c48f7e42/uploads/origins/08d30771-c24b-43f4-a7b9-f1e9e010236d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96171b254a5c076271d379576a569b04, https://si.imgix.net/c48f7e42/uploads/origins/08d30771-c24b-43f4-a7b9-f1e9e010236d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21720218b0bd