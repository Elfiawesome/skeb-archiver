68-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec32b2343a0ed4305d75fcfc27dd16a", "srcset": "https://si.imgix.net/3c664dfa/uploads/origins/87db77d4-c168-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ec32b2343a0ed4305d75fcfc27dd16a, https://si.imgix.net/3c664dfa/uploads/origins/87db77d4-c168-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4f3bc804a652cd76968e7d77f230a58 2x, https://si.imgix.net/3c664dfa/uploads/origins/87db77d4-c168-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ca80380564fe85da1605e30ac3fed2b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c664dfa/uploads/origins/87db77d4-c168-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9417ca790f5333957c95fca26e601dca", "srcset": "https://si.imgix.net/3c664dfa/uploads/origins/87db77d4-c168-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9417ca790f5333957c95fca26e601dca, https://si.imgix.net/3c664dfa/uploads/origins/87db77d4-c168-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12164c12be9aab9223695c9a2ca03836 2x, https://si.imgix.net/3c664dfa/uploads/origins/87db77d4-c168-4295-aeaa-0b7d0ea964b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cc0dd657de83656ae21030e713605fe 3x"}, "body": "癒月ちょこ（ホロライブ）\n\n前設定\n学校内でチンカスを溜めて保健室に行くと抜いてくれると噂が広まる\n（精液どころかチンカスの方が効率よく魔力補給ができるため…といった設定）\n押しかけてきた生徒たちを相手に乱交\n\n構図\n癒月ちょこは基本衣装の白衣なしで胸元や陰部は見えている状態（全裸でも問題ありません）\n胸は大きく尻太腿も大きいが腕や腰回りはスラっとしているイメージ\n乳輪は大きめ、乳首は潰れているというか陥没気味？（1番最初にskebで描かれているヴィーナのイメージ）、色はピンクでお願いします\n生徒は簡単に（全裸など）で問題ありません\nベッドの上で正常位+片手でフェラ+手コキ+1人胸に擦り付けの構図\n\nシチュエーション\n①上記構図の事前の状態、平常を装っているが興奮しているイメージな表情\n②それぞれ挿入、手コキ、擦り付け開始、フェラ側の方を目を瞑りながら笑顔でチン嗅ぎ\n③フェラ開始、発情顔（胸元・手・陰部はチンカス陰毛付着）\n④射精、手コキと胸擦り付けはぶっかけ、フェラは口内射精、正常位は中出し、表情はアヘ顔（口元にもチンカス陰毛付着）\n⑤事後卑猥な表情で口開け精液垂らしながら口内のチンカスと精液を見せる、正常位は竿抜き精液溢れ出し\n\n上記内容をお願いしたいです。\n金額等で厳しい場合①と②は統合していただいても構いません。\nご一考、よろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yatagarasu_000/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2899391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c53d34aa30b26c2c657cfbbbd66191", "srcset": "https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4c53d34aa30b26c2c657cfbbbd66191, https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cbf199773ccb50b6d3b6a5bd2d97ac3 2x, https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dc6facc8008fbbcf063e6af3bb330f3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b3bc7ef53d9e06ec998d62ad01e685d", "srcset": "https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b3bc7ef53d9e06ec998d62ad01e685d, https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7c1851a5d1255f40073f043088612a3 2x, https://si.imgix.net/a3f08820/uploads/origins/5d69162e-3fd2-46e1-a2ec-fdef27aa1c9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72d80a2702e097c52a89b20d4026b729 3x"}, "body": "ホロライブの白銀ノエルをお願いします。\n\nシチュ\nショタたちを誘惑し逆レ乱交\nショタたちのチンカスを目の前にして興奮\n\n容姿\nショタ・白銀ノエル共に全裸\n装飾等も不要です\n白銀ノエルは胸は設定よりも強調、乳輪大きめ、色は淡いピンク？（skeb過去作品のキハダ、ヴィーナ辺りの色合い）\n全身むっちりだが筋肉質なイメージ\n陰毛（黒）やや濃いめ\nショタは身体は小柄め、竿のサイズはそれぞれ、可能なら包茎→皮剥きが欲しいです\nショタの身体で白銀ノエルの顔・胸など要所が隠れる場合は透過？していただきたいです\n\n構図\n①騎乗位の構図でショタ数人に囲まれ眼前に竿がありにやけ顔（要望としては眼前には最低でも3本、多い分にはいくらでも）\n②（包茎の場合ここで皮剥き）皮剥きチンカスお披露目で発情顔\n③ノーハンドフェラしながら竿2本手コキしながら胸に擦り付けし腰振り\n④全員射精しアヘ顔\n⑤全身精液チンカス陰毛まみれでまだまだやれるよね？といった卑猥なにやけ顔\n\n以上でお願いします。\n包茎描写不可な場合②をなくして①から発情状態でお願いしたいです。\nよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yatagarasu_000/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2899391, "client_id": 2289799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b19873d4/uploads/origins/80dc48be-a175-40a1-9578-5582c5dfa642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95ba3ae03fdab6731e0bef382b380be", "srcset": "https://si.imgix.net/b19873d4/uploads/origins/80dc48be-a175-40a1-9578-5582c5dfa642?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f95ba3ae03fdab6731e0bef382b380be, https://si.imgix.net/b19873d4/uploads/origins/80dc48be-a175-40a1-9578-5582c5dfa642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ba49123d921d4782ab47385259d54e4 2x, https://si.imgix.net/b19873d4/uploads/origins/80dc48be-a175-40a1-9578-5582c5dfa642?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b073c9d7fe11d6a9645334e9ef6ebbb4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "ht