たしの誕生花なのです)を取り入れて頂けると舞い上がります…！\n\nそして図々しいのですが、わたし、ようのさんの字も大好きで……イラストと共にコメント等書かれている時は喜んで見ています…マニアックですみません←\n\nこちらも可能であればなのですが、ロゴ的な感じで「k15ring」とようのさんの手描きで書いて頂けると嬉しいです…めちゃくちゃ要望が多くて本当にすみません…！\n\nたくさん書いてしまいましたが、本当に可能な範囲で大丈夫です…！\nようのさんに娘を描いていただける…というだけで本当に嬉しいです！\n夢が叶います！\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/mobile/folders/1_yoyLkm9r0DDoZbYSDghXcn2XvBwwVgW", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@youn_o/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2585412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bea44866/uploads/origins/01d8cbc4-ffa8-4a69-ba37-501078f67538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dc68b06276a5a3fd5a465d2a267784e", "srcset": "https://si.imgix.net/bea44866/uploads/origins/01d8cbc4-ffa8-4a69-ba37-501078f67538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dc68b06276a5a3fd5a465d2a267784e, https://si.imgix.net/bea44866/uploads/origins/01d8cbc4-ffa8-4a69-ba37-501078f67538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b5ae12dffcf336986e4540ed84139ee 2x, https://si.imgix.net/bea44866/uploads/origins/01d8cbc4-ffa8-4a69-ba37-501078f67538?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d79008282db4846f9cb8c660d270e614 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bea44866/uploads/origins/01d8cbc4-ffa8-4a69-ba37-501078f67538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4efea68c4bc73a7e9124b7f1290f67e", "srcset": "https://si.imgix.net/bea44866/uploads/origins/01d8cbc4-ffa8-4a69-ba37-501078f67538?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4efea68c4bc73a7e9124b7f1290f67e, https://si.imgix.net/bea44866/uploads/origins/01d8c