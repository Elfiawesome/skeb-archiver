以下ご本人様サイトからの文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 936968, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "もち@受かれば夏コミ", "screen_name": "riku_mochiduki", "avatar_url": "https://pbs.twimg.com/profile_images/1932892763437346816/5HKVahjZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1529071433024176133/1760719158/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1268584, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しゃけ", "screen_name": "noripasuta", "avatar_url": "https://pbs.twimg.com/profile_images/1405702394411765762/zejFjUQh.png", "header_url": "https://pbs.twimg.com/profile_banners/1071079376735764481/1623983959/1500x500", "appeal_receivable": false, "popular_creator_rank": 87, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "correction"}], "nc": 48}, {"id": 1294199, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "まるろ", "screen_name": "mar_R_o", "avatar_url": "https://pbs.twimg.com/profile_images/1476114111381794823/PAX2KYFH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1233686760296607744/1644659715/1500x500", "appeal_receivable": false, "popular_cre