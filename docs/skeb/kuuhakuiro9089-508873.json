c-4cad-84fa-0c2347eb1657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5645b97cfac1666ad25051ab1ccb3be7, https://si.imgix.net/5148aae5/uploads/origins/c75ed282-cedc-4cad-84fa-0c2347eb1657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d2a7538f18b28caa1edcbc8da30a820 2x, https://si.imgix.net/5148aae5/uploads/origins/c75ed282-cedc-4cad-84fa-0c2347eb1657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=344df3fb49020b5ba4b6aca29c57733e 3x"}, "body": "初めまして。\n新着から作品を拝見させて頂きました。\nとても綺麗な文字で、丁寧に関係系などを深堀して書かれる文字に魅了され、ぜひ自宅とお相手の子の話を書いていただきたいと思いリクエストさせていただきました。\n\nギアーク\n常に怒っている方です\n187cmですが、ンダに身長が負けていることが気に入らず、シークレットブーツを履いて身長を誤魔化しています。\n\nンダ\n203cmの大柄の巨体で、常に無表情なほうです。\n故郷をギアークがいた国に滅ぼされ復讐を果たそうとしていましたが、本人は争いが嫌いで復讐に疲れ、早く死にたいと思っていました。ですが故郷のみんなの無念を思うと復讐をやめることができず、ただ躍起に目の前の敵国出身のギアークを殺すことだけを考えていました。\n\nギアークはそんなンダを連れ、世界を見せてやろうとンダから逃げるように世界を巡り、その後ンダは復讐をやめ自分のために生きます。\nその時のやり取りをきっかけにンダはギアークに惚れ、長い旅時の末「番になりたい」と気持ちを告白し、ギアークはこれを了承しました。\n\n希望するシチュエーションは特になく、めーさんの感性と文字にお任せしたいのですが、もし筆に迷うようでしたら番になったあとの話か、この2人の旅時のふとしたシチュエーションなど書いていただきたいです。\n\n以下資料となります。\nお手数をお掛けいたしますが、お手隙の際にご確認いただけますと幸いです。\nお値段の不備や、資料不備なとございましたらお気軽に差し戻しください。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1j411kpKJYHzKCjUKkl48hCVZRhymDdhZ", "nc": 16, "word_count": 6227, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1335134, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クズ", "screen_name": "masatome01", "avatar_url": "https://pbs.twimg.com/profile_images/1570472883323031553/1TGgoVDU.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1589521, "creator": true, "nsfw_acceptable": true, "acceptable":