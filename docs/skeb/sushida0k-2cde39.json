氏のあきらに対しては、少しお調子者だが、勉強もスポーツも得意である。何事にも一生懸命で、多くの人に頼られている。晶に甘えることが多いが、実は晶に褒められたり甘えられたりするのが大好き。\n\nhttps://scrolller.com/minato-aqua-hololive-bo8yfv42q1?share=u", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sushida0k/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1332417, "client_id": 2296351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b3ef1c5/uploads/origins/b56ff4d8-41a0-4638-a4c7-a03b9e7f979a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5bb8550c1ca2ae728c2a99e6e5c2e46", "srcset": "https://si.imgix.net/0b3ef1c5/uploads/origins/b56ff4d8-41a0-4638-a4c7-a03b9e7f979a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5bb8550c1ca2ae728c2a99e6e5c2e46, https://si.imgix.net/0b3ef1c5/uploads/origins/b56ff4d8-41a0-4638-a4c7-a03b9e7f979a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b61e523b0b81f99c355faa91ac78c742 2x, https://si.imgix.net/0b3ef1c5/uploads/origins/b56ff4d8-41a0-4638-a4c7-a03b9e7f979a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97d036f6837fa556cffd48c1e5b41bfe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b3ef1c5/uploads/origins/b56ff4d8-41a0-4638-a4c7-a03b9e7f979a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b917676f7641a4116b42ee2d8f404ed", "srcset": "https://si.imgix.net/0b3ef1c5/uploads/origins/b56ff4d8-41a0-4638-a4c7-a03b9e7f979a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b917676f7641a4116b42ee2d8f404ed, https://si.imgix.net/0b3ef1c5/uploads/origins/b56ff4d8-41a0-4638-a4c7-a03b9e7f979a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5942503549a2e2ba9d2d3a701f09628b 2x, https://si.imgix.net/0b3ef1c5/