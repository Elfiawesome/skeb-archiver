h=200&s=912e122c002f04ed6cc2cde6712edd30 2x, https://si.imgix.net/d5dd2b17/uploads/origins/9ac1da25-a1da-4cd7-90cd-4a22ae12c51a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb4b2fa82db63780af117d16044d6f01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5dd2b17/uploads/origins/9ac1da25-a1da-4cd7-90cd-4a22ae12c51a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcea7c78fa792cae03262b4abef7441a", "srcset": "https://si.imgix.net/d5dd2b17/uploads/origins/9ac1da25-a1da-4cd7-90cd-4a22ae12c51a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcea7c78fa792cae03262b4abef7441a, https://si.imgix.net/d5dd2b17/uploads/origins/9ac1da25-a1da-4cd7-90cd-4a22ae12c51a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a7d02583381bf689a214312aedc17a28 2x, https://si.imgix.net/d5dd2b17/uploads/origins/9ac1da25-a1da-4cd7-90cd-4a22ae12c51a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6cc32a958793b389b352e3d81aacb6e 3x"}, "body": "ひび様初めまして！🐟と申します！\n以前『アリストステラ魔法学校』を通過し、PLPC共にNPCのレオをとても好いており、ひび様のイラストで弊HO2とレオが見たく依頼させて頂きました！\n\n弊HO2は魔法学校の制服、レオは立ち絵のままの服装でお願いします。構図はひび様の描きやすい構図で大丈夫ですが、二人で笑い合っていたり、仲睦まじい友達のような雰囲気だと有難いです。(構図の指定が必要であれば、二人が一本の箒に乗って夜空でデートしているみたいな感じでお願いします....！)\n\n弊HO2(ドグマ)\n右眼が黄色、左眼が紫に赤い×マークのオッドアイ。\n中性的でよく異性と間違えられるが性別は男性。\n黒髪に紫色のインナーカラー、ウルフカットで肩より少し下くらいの長さ。\n(資料URLにて立ち絵の方貼らせて頂きます。当方かなり不慣れなので万が一閲覧出来ない場合は此方のX(旧：Twitter)のURLを参照くださいませ。 https://x.com/syaket_0000/status/1827640878179213623/photo/1)\n\nこれは出来ればで大丈夫なのですが、ひび様のイラストがとても好きなので、二人のデフォルメイラストも描いて頂けるととても嬉しいです...！(単体でも絡み絵でも可)\n\n\n何卒よろしくお願い致します🙇‍♀️\n\nhttps://drive.google.com/file/d/1k238ugx7EL2lz32MQWsl-X4PbWdlJn30/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 556371, "creator": true, "nsfw_a