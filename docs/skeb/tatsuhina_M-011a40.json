-cd8f-4c15-a60f-7c70bb47ee55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8b2f729275c15f5f5ab64559924ed5f, https://si.imgix.net/979665f2/uploads/origins/5bf3d84c-cd8f-4c15-a60f-7c70bb47ee55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6db52fb2d5f11ee0a0db6070d6468a2 2x, https://si.imgix.net/979665f2/uploads/origins/5bf3d84c-cd8f-4c15-a60f-7c70bb47ee55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8154ef86d444b4546bbd4de69318aa64 3x"}, "body": "たつ雛🎨illustrator様\n初めまして\n個人勢Vtuberのゆすずと申します\n\nXの投稿にて、たぬきくんのイラストがとてもキラキラしていて、是非！たつ雛🎨illustrator様の絵柄で描いて頂けたらな…と思いリクエスト送らせていただきました。\n\n今回は、自身のVtuberの姿のイラストをお願いさせていただきたいと考えております。\n姿についてはお手数おかけいたしますが、\n参考URLの画像を参考にしていただければ幸いです\n\nポーズや構図は全てお任せしたいと思っております。\nキャラデザに関して、画像では判断できない部分はアレンジしていただいて問題ございません。\nもちろん服装等改変していただいても大丈夫です！\n\n使用用途は下記のとおりです。\n・SNS、アイコン、ヘッダー等\n・自身の動画\n・今後の配信活動上のサムネイル等配信に関係するもの\n\n以上になります！\nもし可能であれば頭が見切れていないもの\n背景と人物を分けた状態のデータをいただけますととてもありがたいです。（YouTubeのサムネイル、おはようVTuberに使用させていただきます。）\nお忙しい中恐れ入りますが、ご検討いただけますと幸いです！\n\nhttps://x.com/11Yusuzu14/status/1800183173713920136?s=19", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tatsuhina_M/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3489647, "client_id": 3386535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defe2d325eaf6acd5d785e939d719de8", "srcset": "https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=defe2d325eaf6acd5d785e939d719de8, https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=335c57ce487bc3915bcd3ef62f9e407f 2x, https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4680a138c825969e65be24fc7173e261 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c837fe118385e9740d0f807e53328bb4", "srcset": "https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c837fe118385e9740d0f807e53328bb4, https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7bffd7f19e02e0308972063ff1d4c252 2x, https://si.imgix.net/bc0173ae/uploads/origins/2cbc9cdd-51b7-4d38-a2af-72961fd789bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51cc17b6a0d01d96dc544eaf13aec787 3x"}, "body": "たつ雛様\n\nはじめまして！\n個人でVTuber活動をしております、森永ここあ と申します。\nたつ雛様の陽だまりのような美しさのあるイラストを拝見して、ぜひ私のイラストも描いていただきたいと思い依頼させていただきました！\n\n【依頼内容】\n・森永ここあ（私）のイラストをお願いいたします。\n・髪型も服装も表情も構図も たつ雛様にお任せいたします！\n・やさしく微笑んでいる表情か涙目で「はわわわ」となっているような表情にしていただけると うれしいです！（変な説明で申し訳ありません💦）\n・サムネイル等にも使用させていただきたいので人物の上部と左右が見切れないもの、また可能でしたら背景と人物を分けたデータをいただけると幸いです。\n\n\n【自己紹介】\n名前：森永ここあ🦊🍫\nイチゴとココアが好きな銀色の二尾の妖狐。しっぽの数は2本。\n九尾の狐になるために人間界で修行中。\n本体は銀色の狐だが、人型に化けるときは人間界に馴染むように髪の毛をココア色にしている。\n好きな色は赤と緑。\n\n以下に参考資料を添付させていただきます。\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing\n\n紛らわしいポイントをピックアップさせていただきました。紛らわしくて申し訳ありません！\n・髪の毛はオレンジ味のかかった茶色\n・八重歯と髪飾りは左のみ\n・人耳はなく狐耳のみ\n・しっぽは二本(もっふもふにしていただきたいです)\n・しっぽと狐耳は銀色\n\n重複してしまいますが服装や髪型、装飾品などは変更いただいてかまいません！\n\n\n【使用用途】\nXをはじめとするSNSへの投稿、サムネイルなどのYouTubeでの使用、ネットプリントやグッズに使用させていただく可能性があります。\n使用不可のものがございましたら、お手数ですがイラストデータにご記載いただければと思います。\n\n\nお忙しいと思いますが、ご検討いただけると幸いです。\nどうぞ、よろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tatsuhina_M/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3489647, "client_id": 2497962, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d440b97d/uploads/origins/0def9d91-10a6-41ee-a30c-603b263f5b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae766451c966e7104ce0070d1ce89d2", "srcset": "https://si.imgix.net/d440b97d/uploads/origins/0def9d91-10a6-41ee-a30c-603b263f5b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ae766451c966e7104ce0070d1ce89d2, https://si.imgix.net/d440b97d/uploads/origins/0def9d91-10a6-41ee-a30c-603b263f5b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=092d819a5a4b085186ebe144c3aae416 2x, https://si.imgix.net/d440b97d/uploads/origins/0def9d91-10a6-41ee-a30c-603b263f5b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dde76b8dcf501f5914a4d576a1306b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d440b97d/uploads/origins/0def9d91-10a6-41ee-a30c-603b263f5b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9a064161e918ea4fbb570ec802cae3d", "srcset": "https://si.imgix.net/d440b97d/uploads/origins/0def9d91-10a6-41ee-a30c-603b263f5b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9a064161e918ea4fbb570ec802cae3d, https://si.imgix.net/d440b97d/uploads/origins/0def9d91-10a6-41ee-a30c-603b263f5b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba013f2cd3fb7902f5b3eb6b171df9