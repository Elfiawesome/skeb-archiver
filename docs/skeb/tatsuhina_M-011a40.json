当てたこのアートがとても好きです：\nhttps://www.pixiv.net/en/artworks/124498007\n\nそこで、私のキャラクターを同じようなポーズで、彼女の背中に焦点を当てて描いていただけないでしょうか。\n\n服装はデフォルトの赤いメイジドレスでもいいし、ここみたいな日本の着物でもいい。https://files.catbox.moe/tpywp5.png\n\nもしよければ、少しセクシーなアートにしても構いません。\nその他の詳細はお任せします。\n\nありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1395714, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "篝", "screen_name": "ttji_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/1743269570222448640/-t9z2nq1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382755535154343936/1715440267/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1947065, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "macoteya", "screen_name": "macoteya", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F026ddb5c-331e-40e3-ba83-6618f0568963.webp?avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2095369, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "わかめヨーグルト", "screen_name": "Wakameyogurt", "avatar_url": "https://pbs.twimg.com/profile_images/1994824661000134656/ouflGxCj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1709942207208472576/1769023770/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acce