ation": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8da4919/uploads/origins/7809e815-92d6-44ac-bb35-1e76ed019c70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=442a72cf4b9b64d001503046dd04f96c", "srcset": "https://si.imgix.net/e8da4919/uploads/origins/7809e815-92d6-44ac-bb35-1e76ed019c70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=442a72cf4b9b64d001503046dd04f96c, https://si.imgix.net/e8da4919/uploads/origins/7809e815-92d6-44ac-bb35-1e76ed019c70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e03a613291074878b36bdc986581c20d 2x, https://si.imgix.net/e8da4919/uploads/origins/7809e815-92d6-44ac-bb35-1e76ed019c70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f50ba9271056a21c90bbb118bfad873 3x"}, "body": "こんにちわ\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の20歳位、\n純朴な感じのする黒髪女性のイラストをリクエストしたいです。\n髪型、表情、体型、ポーズ等はお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履きで、手には紺の農作業用の手甲をつけています。\n野良着の色は紺で絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\nもんぺの腰脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/wg5lyu8hc19bmf7ox91ll/si.png?rlkey=bqx1xzta6w4chhlusi4y5li7w&st=z4cecuvy&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tatsuhina_M/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3489647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6a73219/uploads/origins/66b084fc-fbbd-4775-8acd-dc2fdee1fa71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0590ac4348fb177dbb3985