\u30ab\u30af\u30c6\u30eb\uff08\u8cc7\u6599\u53c2\u7167\uff09\u3092\u624b\u306b\u6301\u3063\u3066\u7acb\u3063\u3066\u3044\u308b\u6240\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u3069\u3093\u306a\u98a8\u306b\u6301\u3063\u3066\u7acb\u3063\u3066\u3044\u308b\u304b\u306a\u3069\u3001\u69cb\u56f3\u3084\u8868\u60c5\u306a\u3069\u306f\u3059\u3079\u3066\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\n\n\uff1c\uff1c\u69cb\u56f3\u3084\u8868\u60c5\u306b\u60a9\u3080\u5834\u5408\u306f\u3053\u3061\u3089\u3067\uff1e\uff1e\n\u69cb\u56f3\u30fb\u30fb\u30fb4\u3064\u76ee\u4ee5\u5916\u306f\u3069\u306e\u30ad\u30e3\u30e9\u3067\u3082\u554f\u984c\u306a\u3044\u3067\u3059\n\u30fb\u7247\u624b\u6301\u3061or\u4e21\u624b\u6301\u3061\u3067\u300c\u30cf\u30a4\u3069\u3046\u305e\u30fc\uff01\u300d\u3068\u5dee\u3057\u51fa\u3059\n\u30fb\u300c\u30ab\u30f3\u30d1\u30fc\u30a4\uff01\u300d\u3068\u7247\u624b\u3067\u9ad8\u304f\u63b2\u3052\u3066\u3044\u308b\n\u30fb\u81ea\u5206\u3067\u7f8e\u5473\u3057\u305d\u3046\u306b\u98f2\u3093\u3067\u3044\u308b\uff08\u30b0\u30e9\u30b9\u306b\u53e3\u3092\u4ed8\u3051\u3066\u3044\u308b\uff09\n\u30fb(Tade3)\u30ab\u30af\u30c6\u30eb\u306b\u79c1\u7269\u306eTADENO SWEAT\u3092\u6ce8\u3044\u3067\u3044\u308b\n\n\u8868\u60c5\n\u30fb\u76ee\u306e\u8272\u3092\u898b\u305b\u305f\u3044\u306e\u3067\u4e21\u76ee\u9589\u3058\u4ee5\u5916\u3067\u3057\u305f\u3089\u30a6\u30a3\u30f3\u30af\u3067\u3082\u306a\u3093\u3067\u3082\uff01\n\n\n\uff1c\uff1c\u53ef\u80fd\u3067\u3042\u308c\u3070\u306e\u5e0c\u671b\uff1e\uff1e\u203b\u96e3\u3057\u3044\u5834\u5408\u306f\u30b9\u30eb\u30fc\u3057\u3066\u4e0b\u3055\u3044\n\u30fb\u6a3d\u578b\u30d3\u30fc\u30eb\u30b8\u30e7\u30c3\u30ad(\u4e2d\u8eab\u306f\u30d3\u30fc\u30eb\u30fb\u8cc7\u6599\u53c2\u7167)\u3092\u6301\u3063\u3066\u3044\u308b\u5dee\u5206\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\u30fbTade3\u306e\u5de6\u80f8\u306b\u3082\u30d0\u30c3\u30c2(\u8cc7\u6599\u53c2\u7167)\u3092\u63cf\u3044\u3066\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\n\u3069\u3046\u304b\u307e\u305f\u3088\u308d\u3057\u304f\u3054\u691c\u8a0e\u4e0b\u3055\u3044<(_ _)>\n\n---------------------------------------------------------------\n\n\u3010\u4ee5\u4e0b\u3067\u4f7f\u7528\u3055\u305b\u3066\u9802\u304d\u305f\u3044\u3067\u3059\u3011\n\u30fbVRChat\u5185\u3067\u884c\u3063\u3066\u3044\u308b\u30a4\u30d9\u30f3\u30c8\u306e\u30dd\u30b9\u30bf\u30fc\u306b\u63b2\u8f09\n\u30fb\u30a4\u30d9\u30f3\u30c8\u544a\u77e5\u30fb\u5ba3\u4f1d\u95a2\u9023\n\u30fb\u30a4\u30d9\u30f3\u30c8\u5ba3\u4f1d\u3092\u517c\u306d\u305fVRChat\u51853D\u30a2\u30a4\u30c6\u30e0\u3078\u306e\u4f7f\u7528\n\u3000\u203b\u30a2\u30a4\u30c6\u30e0\u306f\u5ba3\u4f1d\u7121\u6599\u914d\u5e03\u54c1\u3067\u3059\u3002\u5229\u76ca\u76ee\u7684\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\n\u30fb\u30a4\u30d9\u30f3\u30c8\u95a2\u9023\u30ef\u30fc\u30eb\u30c9\n\u30fbTWITTER\n\u30fbDISCORD\n\n\u3010\u5bb9\u59ff\u3084\u8863\u88c5\u306a\u3069\u30fb\u30ab\u30e9\u30fc\u3011\u203bURL\u5148\u306e\u4e09\u9762\u56f3\u53c2\u7167\n\u7dbe777\t\u30fb\u30fb\u30fb\t\u8584\u3081\u91d1\u9aea\u3001\u91d1\u773c\u3001\u30bf\u30fc\u30b3\u30a4\u30ba\u30d6\u30eb\u30fc\u7cfb\u306e\u670d\nTade3\t\u30fb\u30fb\u30fb\t\u9ed2\u9aea\u3001\u9752\u773c\u3001\u9752\u7cfb\u306e\u670d\nEKURI\t\u30fb\u30fb\u30fb\t\u8584\u3081\u30d4\u30f3\u30af\u9aea\u3001\u8d64\u7d2b\u773c\u3001\u30d4\u30f3\u30af\u7cfb\u515a\u306e\u670d\n\n\n\u3010\u30ad\u30e3\u30e9\u306e\u6027\u683c\u3011\u203bURL\u5148\u306e\u30ad\u30e3\u30e9\u30a4\u30e1\u30fc\u30b8\u753b\u50cf\u53c2\u7167\n\u7dbe777\t\u30fb\u30fb\u30fb\t\u30c4\u30f3\u30c7\u30ec\u771f\u9762\u76ee\u30fb\u5143\u6c17\u30fb\u307e\u3068\u3081\u5f79\nTade3\t\u30fb\u30fb\u30fb\u3000\u9762\u767d\u3044\u304a\u5144\u3055\u3093\u30fb\u30dc\u30b1\u62c5\u5f53\u30fb\u4eba\u6c17\u8005\nEKURI\t\u30fb\u30fb\u30fb\t\u771f\u9762\u76ee\u3067\u697d\u3057\u3044\u30c4\u30c3\u30b3\u30df\u62c5\u5f53\u30fb\u535a\u8b58\u30fb\u4e0d\u9047\u82e6\u52b4\u4eba\n\n---------------------------------------------------------------\n