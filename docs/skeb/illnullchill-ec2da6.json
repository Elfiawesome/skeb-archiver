ator_acceptable_same_genre": false}, {"path": "/@illnullchill/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3737121, "client_id": 3874100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b4f895fb4b28e5a1121e682b267319", "srcset": "https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b4f895fb4b28e5a1121e682b267319, https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c498a74d865931365e5877c926391eb 2x, https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bc45a610fb40a721502e7c690f98c76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9e023a6100c20a6ffb3c6439703b066", "srcset": "https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9e023a6100c20a6ffb3c6439703b066, https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=570a3c6ea9c74cc6ebb3f9b37844fb3f 2x, https://si.imgix.net/d88c8eec/uploads/origins/92681be5-9f16-4e20-a697-a3ad89e95fb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b38876912381a5189f6b09a88c832f94 3x"}, "body": "先生、こんにちは！先生のイラストがとてもすきで、この度はリクエストに参りました。\n先生のデザインセンスと、イラストに漂う雰囲気が本当に好きです。\n\nオリジナルキャラクター「シープ」のイラストをお願いしたいです。\n\nキャラクターは「廃城の呪われた守護者」というイメージで、「美女と野獣」のようなAUコンセプトも含まれています。 \nまた、モンスター形態の参考資料は「cheep」フォルダに入っていますが、描くかどうかはお任せします。\n\nかつて「停滞」の呪いを受け、体を獣の姿へと変えられてしまいました。長い年月の中で城の外の世界の記憶を少しずつ忘れていき、城に迷い込んだ侵入者は外へ帰ることができません。守護者として、侵入者を排除する役目を担っています。 \nしかしシープ自身は知らないままですが、その呪いは「大切な誰かのために自己犠牲を選ぶこと」でのみ解けるとされています。 \n何事もない静かな夜には、城の手入れをしたり、庭で一人花冠を編んで過ごしています。 先生のご解釈で自由に描いていただけたら嬉しいです。\n\n【シープ】 \nシープは普段は落ち着いていて穏やかな性格ですが、刺激されると真剣で断固とした一面を見せます。 \n・今回は「extra costumes」と記載のある参考資料の中の、衣装 1 または 2 をご参考にしていただけますと嬉しいです。\n・身長：169cm (人間形態) \n・長くてふわふわした銀白色の髪 \n・羊の耳と角がある （人間の耳がない）\n・中性的でやや女性的な印象 \n・赤いリボンがトレードマーク（位置はどこでも大丈夫です） \n・髪型のアレンジはご自由にしていただいて大丈夫です \n\n内容不備や金額が不足している場合は、アピールをお送りください。\nデザインメモ、没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。 \n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1_7wTl6FJONAFtQdBVHH4NZrUZuTNs3xx?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@illnullchill/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3737121, "client_id": 1500785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9fa0712/uploads/origins/ded7feae-f6e6-4d80-89af-cfa903cdf94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ae22d057e372e2ab62962a66b07b176", "srcset": "https://si.imgix.net/f9fa0712/uploads/origins/ded7feae-f6e6-4d80-89af-cfa903cdf94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ae22d057e372e2ab62962a66b07b176, https://si.imgix.net/f9fa0712/uploads/origins/ded7feae-f6e6-4d80-89af-cfa903cdf94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ef28ffe6805037dfd22b7ef3fe885ee 2x, https://si.imgix.net/f9fa0712/uploads/origins/ded7feae-f6e6-4d80-89af-cfa903cdf94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=101548fe8534528844b3083eb8267bfc 3x"}