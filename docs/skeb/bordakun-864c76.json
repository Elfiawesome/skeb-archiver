u30ea\u30af\u30a8\u30b9\u30c8\u5931\u793c\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u3044\u3064\u3082\u3074\u30fc\u3051\u3057\u69d8\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u62dd\u898b\u3057\u3066\u304a\u308a\u307e\u3059\u3002\n\u307e\u305f\u3001\u6295\u7968\u5236\u306e\u30a4\u30e9\u30b9\u30c8\u3082\u6bce\u56de\u3068\u3066\u3082\u697d\u3057\u307f\u306b\u62dd\u898b\u3057\u3066\u3044\u307e\u3059\uff01\n\n\u3053\u306e\u305f\u3073\u3001\u9ed2\u9aea\u3064\u3093\u3064\u3093\u77ed\u9aea\u306a\u30de\u30c3\u30c1\u30e7\u9752\u26ab\ufe0e\u5e74\u30ec\u30b9\u30e9\u30fc2\u540d(\u5148\u8f29\u3068\u5f8c\u8f29\u306e\u5e2b\u5f1f\u30bf\u30c3\u30b0)\u304c\u7121\u69d8\u6557\u5317\u3059\u308b\u30a4\u30e9\u30b9\u30c8\u3092\u62dd\u898b\u3057\u305f\u304f\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\u3010\u5165\u308c\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u8981\u7d20\u3011\n\u2460\u898b\u305f\u76ee\n\u30fb\u898b\u305f\u76ee\u306f\u30012\u4eba\u3068\u3082\u9ed2\u9aea\u3064\u3093\u3064\u3093\u7cfb\u77ed\u9aea(\u3074\u30fc\u3051\u3057\u69d8\u304c\u63cf\u304b\u308c\u308bThe\u4e3b\u4eba\u516c\uff01\u7684\u306a\u77ed\u9aea\u306e\u5b50\u305f\u3061\u304c\u5927\u597d\u304d\u306a\u306e\u3067\u2026)\n\u30fb2\u4eba\u3068\u3082\u767d\u3044\u30ec\u30b9\u30ea\u30f3\u30b0\u30d6\u30fc\u30c4(\u30b7\u30e5\u30fc\u30ba\uff1f)\u306b\u767d\u30bd\u30c3\u30af\u30b9\uff0b\u30a2\u30fc\u30e0\u30ea\u30f3\u30b0\uff0b\u30b7\u30e7\u30fc\u30c8\u30bf\u30a4\u30c4(\u7af6\u30d1\u30f3\u307f\u305f\u3044\u306a\u30bf\u30a4\u30d7)\n\u30fb\u30b7\u30e7\u30fc\u30c8\u30bf\u30a4\u30c4\u306e\u8272\u306f\u3001\u767d\u3001\u30aa\u30ec\u30f3\u30b8\u3001\u8d64\u3001\u9752\u306e\u3044\u305a\u308c\u304b2\u8272\u3067\u304a\u9858\u3044\u3057\u307e\u3059\uff01\n\n\u2461\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\n\u203b\u30a4\u30e9\u30b9\u30c8\u306b\u3064\u3044\u3066\u306f\u30011\u30682\u3092\u305d\u308c\u305e\u308c\u69cb\u56f3\u306f\u304a\u306a\u3058\u3067\u30011\u30682\u3092\u305d\u308c\u305e\u308c\u5dee\u5206\u30a4\u30e9\u30b9\u30c8\u7684\u306a\u611f\u3058\u3067\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u8003\u3048\u3066\u304a\u308a\u307e\u3059(\u3082\u3061\u308d\u3093\u30011\u679a\u306b\u307e\u3068\u3081\u3066\u3044\u305f\u3060\u3044\u3066\u3082\u5dee\u3057\u652f\u3048\u3042\u308a\u307e\u305b\u3093\uff01)\n\u6557\u5317\u3057\u305f\u9752\u26ab\ufe0e\u5e74\u30d7\u30ed\u30ec\u30b9\u30e9\u30fc2\u4eba\u304c\u3001\n1.\u30ec\u30b9\u30ea\u30f3\u30b0\u30d6\u30fc\u30c4(2\u4eba\u3068\u3082\u767d)\u3092\u8131\u304c\u3055\u308c\u305f\u72b6\u614b\u3067\u3001\u84b8\u308c\u305f\u8db3\u88cf\u306e\u81ed\u3044(\u84b8\u308c\u305f\u767d\u30bd\u30c3\u30af\u30b9\u8db3\u88cf)\u3092\u55c5\u304c\u308c\u5632\u7b11\u3055\u308c\u308b\n2.\u30b7\u30e7\u30fc\u30c8\u30bf\u30a4\u30c4\u3092\u8131\u304c\u3055\u308c\u3001\u305d\u308c\u305e\u308c\u5305\u830e\u7c97\u30c1\u30f3\u3092\u6652\u3055\u308c\u3066\u3044\u308b\u3002\n\u30fb1\u4eba\u306f\u3061\u3093\u307d\u306e\u76ae\u3092\u4f38\u3070\u3055\u308c\u3066\u3044\u308b\u3002\n\u30fb\u3072\u3068\u308a\u306f\u3061\u3093\u307d\u306e\u76ae\u3092\u7121\u7406\u77e2\u7406\u5265\u304b\u308c\u308b\u304c\u3001\u771f\u6027\u5305\u830e\u306e\u305f\u3081\u5265\u3051\u306a\u3044\n\n\u3010\u305d\u306e\u4ed6\u3011\n\u30fb\u76f8\u624b\u30ec\u30b9\u30e9\u30fc\u306f\u3001\u30e2\u30d6\u9854\u3084\u624b\u8db3\uff0b\u30ad\u30e3\u30d7\u30b7\u30e7\u30f3\u306e\u307f\u306e\u767b\u5834\u3067\u3082\u5dee\u3057\u652f\u3048\u3042\u308a\u307e\u305b\u3093\u3002\n\u30fb\u8eab\u4f53\u306b\u30a2\u30b6(\u8179\u90e8\u3092\u8179\u30d1\u30f3\u3055\u308c\u305f\u8de1etc...)\n\u30fb\u6065\u8fb1\u3068\u5c48\u8fb1\u306b\u307e\u307f\u308c\u305f\u8868\u60c5\uff06\u53f0\u8a5e\n\u30fb\u3061\u3093\u3053\u306e\u76ae\u3092\u5265\u304b\u308c\u3066\u75db\u304c\u308b\u53f0\u8a5e\uff06\u30ad\u30e3\u30d7\u30b7\u30e7\u30f3\n\u30fb\u8db3\u306e\u88cf\u304c\u898b\u3048\u308b\u69cb\u56f3\n\u30fb\u76f8\u624b\u30ec\u30b9\u30e9\u30fc\u304c\u3001\u30c1\u30f3\u30dd\u306e\u30b5\u30a4\u30ba\u3084\u76ae\u306e\u4f38\u3073\u5177\u5408\u3001\u5265\u3051\u306a\u3044\u3053\u3068\u3084\u8db3\u88cf\u306e\u5302\u3044\u3092\u5632\u7b11\u3059\u308b\u53f0\u8a5e\n\n\u3059\u3079\u3066\u3092\u7db2\u7f85\u3067\u306a\u304f\u3068\u3082\u3001\u3054\u5bfe\u5fdc\u53ef\u80fd\u306a\u9805\u76ee\u304a\u3088\u3073\u8981\u7d20\u3092\u3044\u308c\u3066\u3044\u305f\u3060\u3051\u307e\u3057\u305f\u3089\u5e78\u751a\u3067\u3059\u3002\n\u307e\u305f\u3001\u30d7\u30ed\u30ec\u30b9\u30e9\u30fc2\u540d\u3068\u8a18\u8f09\u3057\u307e\u3057\u305f\u304c1\u540d\u3067\u3082\u5dee\u3057\u652f\u3048\u3042\u308a\u307e\u305b\u3093\uff01\n\u203b1\u540d\u306e\u5834\u5408\u306f\u3001\u5f1f\u5b50(\u5f8c\u8f29\u304f\u3093\uff1f)\u306b\u75f4\u614b\u3092\u898b\u3089\u308c\u3066\u3044\u308b\u3088\u3046\u306a\u30ad\u30e3\u30d7\u30b7\u30e7\u30f3\u3092\u5e0c\u671b\u3044\u305f\u3057\u307e\u3059\n\n\u3084\u3084\u30de\u30cb\u30a2\u30c3\u30af\u306a\u5c48\u8fb1\u30e2\u30ce\u30ea\u30af\u30a8\u30b9\u30c8\u3067\u306f\u3042\u308a\u307e\u3059\u304c\u3001\n\u4f55\u5352\u3054\u691c\u8a0e\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u7533\u3057\u4e0a\u3052\u307e\u3059\u2026(\uff1e\u4eba\uff1c;)", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bordakun/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ccfdb7b5/uploads/origins/3def8563-0269-4acc-a660-e2f5f2d64a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d57893a7bf78e17bd80d6deb193bc76", "srcset": "https://si.imgix.net/ccfdb7b5/uploads/origins/3def8563-0269-4acc-a660-e2f5f2d64a97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d57893a7bf78e17bd80d6deb193bc76, https://si.imgix.net/ccfdb7b5/uploads/origins/3def8563-0269-4acc-a660-e2f5f2d64a97?bg=%23fff&a