ールの中から選んでください。\n\nポーズはお任せしますが、ストッキングを履いた太ももが見えるようにしてください。\nまた、背景付きでお願いします。\nそしてポートレートで描いてください。\n\nありがとう！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ecoozy2021/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1156019, "client_id": 2341679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a247130d2fa01415b73803925b3d7b", "srcset": "https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a247130d2fa01415b73803925b3d7b, https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b732e2adc483259d2ced0c97be3ee801 2x, https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05e92e25496fb1efa1ec8028c4ba5b04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3de7e60da022e75a2bdd45f1348f66f", "srcset": "https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3de7e60da022e75a2bdd45f1348f66f, https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff540ddf14677fe5dbc91818221c86f1 2x, https://si.imgix.net/eae50f8b/uploads/origins/cb47e143-f20e-4391-a549-9f2e5b1fb3