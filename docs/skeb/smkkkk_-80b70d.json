=200&s=833e17a90de4b70401d8d24080a5fa8e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a811a95d/uploads/origins/1e6e5fcd-351f-48f5-bf66-8bcab86db98d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f4f83061998c3ba0462277e0c87df9f", "srcset": "https://si.imgix.net/a811a95d/uploads/origins/1e6e5fcd-351f-48f5-bf66-8bcab86db98d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f4f83061998c3ba0462277e0c87df9f, https://si.imgix.net/a811a95d/uploads/origins/1e6e5fcd-351f-48f5-bf66-8bcab86db98d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb9d79f0c55681f0c4b822d3c66d7d3c 2x, https://si.imgix.net/a811a95d/uploads/origins/1e6e5fcd-351f-48f5-bf66-8bcab86db98d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43c7088401b5d6ec43866bb0419a4bfa 3x"}, "body": "アーティストへ\nあなたの美しいアートワークを拝見し、イラストを依頼したいと思っています！\n私のララフェルのキャラクターデータはハードディスクにあります！\n背景、ポーズ、構図、その他はすべてお任せしますので、自由に描いてください！\n\n私は日本語が話せないので、曖昧なところは自由に解釈してください！\nhttps://drive.google.com/drive/folders/1SefhHHGf7yggnlETlqUlYyd5JQ5qur78?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@smkkkk_/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3511349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41e251dfca5dced46b2c7abe1ecc43d2", "srcset": "https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41e251dfca5dced46b2c7abe1ecc43d2, https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd98e5c13bd3fcd97130f18076d71b4f 2x, https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cade25b6ea027cb2149a4db534e5e384 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8efaeb68c790bc1cafab17e6fa8155b9", "srcset": "https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8efaeb68c790bc1cafab17e6fa8155b9, https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c19bb837f8b089153408c6d158c8e973 2x, https://si.imgix.net/bdb81270/uploads/origins/5b47f261-2dcb-4031-aa22-29868533e880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e80eacce30a955ac8710322bbf5c1a5a 3x"}, "body": "めぎ様\n\nはじめまして。突然のご連絡失礼いたします。\n\n貴方様の柔らかな色使いと、キャラクターの愛らしい表情の描写に大変魅了され、今回思い切ってご連絡させていただきました。\n\n制作していただくイラストにつきましては、めぎ様のインスピレーションと自由な発想で、全てお任せいたします。\n\n特に細かい指定はございませんので、めぎ様の描きたいように、また、楽しく描いていただけると幸いです。\n\nうちの子（ララフェル）の衣装デザインは、こちらのURLにご用意いたしました。\nもし詳細な雰囲気を掴むのに必要でしたら、ゲーム内のスクリーンショットも添付いたしましたので、ご参照ください。どの衣装を選んでいただいても構いません。めぎ様の気に入った服を、どれでもご自由にお選びください。強いて言えば、個人的にはパジャマや夏服の雰囲気が好みですが、最終的なご選択はめぎ様にお任せいたします。引き続き、どうぞよろしくお願いいたします。\n※URL ※\nhttps://drive.google.com/drive/folders/1xRaPQafW6V26LlwRht2Uc5fDebFpacw9?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@smkkkk_/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6662631f/uploads/origins/fcb72b40-7844-4403-bb4a-41403208869f?bg=%23fff