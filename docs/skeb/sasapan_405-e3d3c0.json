or_id": 2631003, "client_id": 2990276, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b883c2e5c3b336f76865eebaac90888", "srcset": "https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b883c2e5c3b336f76865eebaac90888, https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2eebc87edf12135afcaa6389bf46e8a 2x, https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a624e89be06b383c3a2d4fc59ca7eced 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20043a9f316f36d9a9b3abf7302bf817", "srcset": "https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20043a9f316f36d9a9b3abf7302bf817, https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33d51f68cab144a987e86c0c9ea3ed9e 2x, https://si.imgix.net/8f34965b/uploads/origins/b3edca41-6330-4750-84c4-acd71ccc7455?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08f94bed1f661f75503e6e44b76d7d1c 3x"}, "body": "笹蒲ぼこ🐼 SasakamaBoko様、はじめまして！\nVtuberとして活動をしている\n兎月ネチェトアと申します。\n\n笹蒲ぼこ様の\n一歩一歩絵本の海に沈んでくような\n厚塗りの世界に惹かれて\nこの度はリクエストを送らせていただきました！\n\n《依頼内容 》\n私「兎月ネチェトア」を描いていただきたいです！\n\n・お喋りが大好きなうさぎの豊穣の女神です。\n（デザインのモチーフは日本の月兎とエジプトのウェネト神です）\n・基本はゲラで元気いっぱい。\nゲームが下手なポンコツですが、\n物語の感想のお喋りなどを楽しんで沢山遊んでます。\n\n描いていただきたいテーマは\n「砂漠に花を咲かせましょう」です。\n\nもののけ姫のシシ神様のように\nネチェトアがウアス杖を持ち歩けば\n足跡に草花が生い茂る\n\nうさぎの眷族達と\n笑いあい跳ね回りながら\n乾いた大地に花を咲かす\nうさぎの豊穣の女神様\n\nそんなイメージで\nイラストを描いていただく事は\n可能でしょうか？\n\n衣装は参考資料の\nネチェトアの羽衣付き和風通常衣装で、\nリスナーさんもちうさぎも\n予算内で大丈夫でしたら\n描いてくれたら嬉しいです。\n\n細やかなポーズ、\n構図はおまかせでお願いしたいです。\n衣装の作画コストが高いので、\n描きやすいよう簡易的に\nアレンジしていただいても大丈夫です！\n\n配信のサムネイルに使いたいので、\n胸から上は、なるべく見切れが無く\n描いていただけると嬉しいです！\n\n\n《使用用途》\n収益化済みの YouTubeのサムネや配信、\nコミュニティ、X(旧Twitter)で\n使用させていただきたく思っております。\n\nまた、非営利目的で、私自身が自分で印刷し楽しむ用途と、\nリスナーの皆様にも共有する形での、ネットプリントに\n登録させてもえたらと思っております。\n\n納品の際、出来れば背景と人物を分けてある\n透過のデータをいただけると嬉しいです。\n\n\nイメージテーマががっつりあり\n難しいと思いますが、\nご検討いただけると幸いです！\nよろしくお願いいたします。\n\n\nhttps://x.com/nechetoa/status/1841121158877626808?s=46&t=Oa4ZKTCLf4v-MQwGGYFJGA\n\nhttps://x.com/nechetoa/status/1841121271335305336?s=46&t=Oa4ZKTCLf4v-MQwGGYFJGA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sasapan_405/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2631003, "client_id": 11320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8d7d1f1/uploads/origins/766ead72-793e-447e-bfb2-009605f1ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4333068c5f378a824546c2b8b0ef7d39", "srcset": "https://si.imgix.net/a8d7d1f1/uploads/origins/766ead72-793e-447e-bfb2-009605f1ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4333068c5f378a824546c2b8b0ef7d39, https://si.imgix.net/a8d7d1f1/uploads/origins/766ead72-793e-447e-bfb2-009605f1ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bedd94818928e7a788223a819d84f7f 2x, https://si.imgix.net/a8d7d1f1/uploads/origins/766ead72-793e-447e-bfb2-009605f1ac66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a8489eebad9bf47c0dd5d55e18b5acd 3x"}