る拠点に対し敵軍が奇襲し、桃色潜水服を着用した彼女の元にも敵兵が侵入し、\nそのまま接近戦による取っ組み合いに発展する的な展開をイメージしています\n\nただ水中と違い、地上では桃色潜水服の重量や動きにくいフィンが極めて足枷となり、装備では圧倒的に重装備に見えつつ、\n取っ組み合いにおいては機動性の観点で敵に対して極めて劣勢…みたいなイメージを想像しています\n\nhttps://bouya924.fanbox.cc/posts/10110676\n桃色潜水服について、もし可能であれば直近描いてもらったバックパックに推進装置も付けたタイプで描写してくれると嬉しいです！\n(より敵側との装備格差を引き立てたいなと思いまして…)\n\n任務に向けて潜水するために大層な装備を身に着けたのに、その役割を果たすことなく敵兵に襲撃されて、\nそして恐らくはその毒牙に掛かってしまう…みたいなのも好きで、マニアックなシチュ指定で恐縮ですが、ご検討のほど宜しくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oldcrow924/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2766919, "client_id": 224551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66375d3d/uploads/origins/f6537adc-b252-4913-94d0-0c78f91c899c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f822bd3ff3cfe5e29eb4cefe1ca61cd", "srcset": "https://si.imgix.net/66375d3d/uploads/origins/f6537adc-b252-4913-94d0-0c78f91c899c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f822bd3ff3cfe5e29eb4cefe1ca61cd, https://si.imgix.net/66375d3d/uploads/origins/f6537adc-b252-4913-94d0-0c78f91c899c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa0fcf45353aa7783cc9a5ac147326bb 2x, https://si.imgix.net/66375d3d/uploads/origins/f6537adc-b252-4913-94d0-0c78f91c899c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4489400423c032796b1282942dced951 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66375d3d/uploads/origins/f6537adc-b252-4913-94d0-0c78f91c899c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37219b30ea1377a7dcc4bd36c560b79a", "srcset": "https://si.imgix.net/66375d3d/uploads/origins/f6537adc-b252-4913-94d0-0c78f91c899c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=