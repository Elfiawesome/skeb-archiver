歩く（ときどき謎の物も多い）。\n観葉植物を育てるのが趣味で、静かな時間や小さな幸せを大切にしている。\n\n完成イラストは個人鑑賞のほか、Twitterのヘッダーやアイコン等にも使用予定です。\nお忙しい中恐縮ですが、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JnnKV9UFUvbCmlUhtuZRSu7rIBi2nE-p", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hachi8_8888/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3019024, "client_id": 731446, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9ef7a7e/uploads/origins/3d5cdf87-e8e4-489d-b654-ea4953ed51d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f616a5f6bf672cba8a27d9abfa831b", "srcset": "https://si.imgix.net/b9ef7a7e/uploads/origins/3d5cdf87-e8e4-489d-b654-ea4953ed51d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f616a5f6bf672cba8a27d9abfa831b, https://si.imgix.net/b9ef7a7e/uploads/origins/3d5cdf87-e8e4-489d-b654-ea4953ed51d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db6ce0c7f643d2b63536e06cc6a06a35 2x, https://si.imgix.net/b9ef7a7e/uploads/origins/3d5cdf87-e8e4-489d-b654-ea4953ed51d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df6212857aec7d0276ebdfcd72db000f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9ef7a7e/uploads/origins/3d5cdf87-e8e4-489d-b654-ea4953ed51d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aaf1456f51786253e2df921441c17e9", "srcset": "https://si.imgix.net/b9ef7a7e/uploads/origins/3d5cdf87-e8e4-489d-b654-ea4953ed51d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aaf1456f51786253e2df921441c17e9, https://si.imgix.net/b9ef7a7e/uploads/origins/3d5cdf87-e8e4-489d-b654-ea4953ed51d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de22e9d496f01d835c84