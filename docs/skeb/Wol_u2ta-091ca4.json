fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6732afaff3523f949ab60c881874d06e, https://si.imgix.net/56b99fda/uploads/origins/4dad7a6b-a716-4d49-9f10-21020e4c27cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13f8955a14b0538933a146602096efe8 2x, https://si.imgix.net/56b99fda/uploads/origins/4dad7a6b-a716-4d49-9f10-21020e4c27cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4407cd4fe62997f7576df47c3d235790 3x"}, "body": "多田李衣菜ちゃんのイラストをお願いした者です。今回はアイドルマスターシンデレラガールズの吉岡沙紀ちゃんをお願いします。\n\n服装については、［ボーイッシュエレガント］か［ジャパニーズアート］辺りのイラストを参考に、パーカー（Tシャツ）にショートパンツ、スポーツソックス（ルーズソックス）にスニーカーみたいな感じでお願いします。\n\n今回も全身入る構図に、リアル寄りな絵柄でお願いしたく、沙紀ちゃんの脚の長さを強調したカッコいい感じにお願いしたいです。\n\nまた、依頼文をTwitterされるのは恥ずかしいので、イラストのみのTwitterでお願いできればと思います。\n\n以上、どうぞよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Wol_u2ta/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 744263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c7ecadb/uploads/origins/8bd51e0c-a7fe-423e-ab45-100b4ccbfeb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78dd2c3f5ae77cc8a28c8700f1eaed22", "srcset": "https://si.imgix.net/4c7ecadb/uploads/origins/8bd51e0c-a7fe-423e-ab45-100b4ccbfeb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78dd2c3f5ae77cc8a28c8700f1eaed22, https://si.imgix.net/4c7ecadb/uploads/origins/8bd51e0c-a7fe-423e-ab45-100b4ccbfeb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d06041f829d53a54e1ba21b765af71c 2x, https://si.imgix.net/4c7ecadb/uploads/origins/8bd51e0c-a7fe-423e-ab45-100b4ccbfeb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02a80fe73746499c4168f6ddaeeef78d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image