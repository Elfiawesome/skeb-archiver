m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a4d86f2937a11c6dcba258b9e96a7bca 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2666226, "client_id": 3020752, "nc": 0}, {"path": "/@lessthan_empty/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2666226, "client_id": 3180305, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8602d82ada0f812cd5fa89c52e2406", "srcset": "https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8602d82ada0f812cd5fa89c52e2406, https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fae9efa11c36605cebbf0a8efb8c1a7d 2x, https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4b12a8cac92955cddcf6143c6667e87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7497091b05be0742bee6e29dfe4f3252", "srcset": "https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7497091b05be0742bee6e29dfe4f3252, https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37d1f6799df835a6ad458a17c4654577 2x, https://si.imgix.net/fa34c083/uploads/origins/688de792-bb13-4db6-8b68-519fbb70b38b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d4dc9f2e306d3ff214770a0c465242c 3x"}, "body": "からっぽ未満さん初めまして、Adèleと申します。\nXで先生の作品を拝見し、先生の絵柄とキャラがとても好きなので、リクエストさせていただきました。\nもしよろしければ、私のオリキャラを描いていただきたいです。\n二人は1950年代のフランスを舞台にしたマフィアのキャラクターで、叔父と姪の関係です。その距離感は非常に親密で、実際には父娘のような関係性に近いです。\n服装と髪型は好みでアレンジをしていただいて構いません。\nは少し不安定な雰囲気で描いていただけたら嬉しいです。\n\n▼キャラクター\nオード（Aude）　16歳　145cm\nマフィアの後継者で、先天的な反社会性パーソナリティ障害を持ち、冷淡かつ無情。見た目は優雅な貴族令嬢だが、その本質は小型の猛獣。\nアクセル（Axel） 41歳　185cm\nマフィアの首領。沈着冷静で理性的、強い自制心を持つ。サディスティックな一面と支配欲が強く、慈善事業を通じて上流社会で「温厚で思いやりのある商人」としてのイメージを作り上げている。\n\n▼シチュエーション\n（以下のセリフはあくまで参考用ですので、ご自由に変更・アレンジしていただいて大丈夫です。）\nオードが温室でバラの世話をしていて、アクセルがそばでそれを見ながらコメントしているシーン。\nオードはバラの肥料として死体を使っているという裏設定があります。ふたりはそれをあくまで園芸の話として、ごく普通の口調でやりとりします。\nたとえば、「今回は色の出方がいいな」「こっちは根元の養分がうまく回ってない」「雨で浅く埋めた方が浮き上がってきたのかもしれない」「切断の角度、次は少し調整した方がよさそうだ」といった具合に、ごく冷静に処理を振り返るような会話です。\nアクセルが評価したあと、意味深にこう続けます：「でも、あまり綺麗に咲かせすぎないほうがいい。何を埋めたか、余計なことを聞いてくるやつが出てくるかもしれないからな。」\n\n▼用途\n-個人観賞用\n-skeb等依頼する際の参考資料として用いる可能性があります\n\n金額や内容に不備などございましたら、お手数ですが再申請やキャンセルをしていただけますと幸いです。\nご一考のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Eydl86-uvBs1RKB8jqi5JGBYiU1wD-5q?usp=sharing", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lessthan_empty/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2666226, "client_id": 3512434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5f410ea/uploads/origins/377f7f90-c61b-4670-b953-ca7c8dd8400c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ded4175b77eaba33c68769edd3669bbf", "srcset": "https://si.imgix.net/d5f410ea/uploads/origins/377f7f90-c61b-4670-b953-ca7c8dd8400c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ded4175b77eaba33c68769edd3669bbf, https://si.imgix.net/d5f410ea/uplo