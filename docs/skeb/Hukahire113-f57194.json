200&h=200&s=c3de9b1b41a22641240e23d1f016422b 2x, https://si.imgix.net/c657898e/uploads/origins/3b093de9-c9aa-4f43-8f7b-d73dda063c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e118f4c5a863cc5ef7380b23adec17f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c657898e/uploads/origins/3b093de9-c9aa-4f43-8f7b-d73dda063c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7c78fd0b30fc336929499e3ae242f6", "srcset": "https://si.imgix.net/c657898e/uploads/origins/3b093de9-c9aa-4f43-8f7b-d73dda063c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7c78fd0b30fc336929499e3ae242f6, https://si.imgix.net/c657898e/uploads/origins/3b093de9-c9aa-4f43-8f7b-d73dda063c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5c9d8fb9cd20af4e8306c4e2e48f215 2x, https://si.imgix.net/c657898e/uploads/origins/3b093de9-c9aa-4f43-8f7b-d73dda063c8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4412fd3c523998fc11c0dee19bdf6eef 3x"}, "body": "初めまして！\n過去イラストのアナルくぱぁとちんキスイラストなど、\nフカヒレさんの描く表情や雰囲気がすごくエッチでかわいいものが多かったので依頼させていただきました！\n\n【キャラクター】\n2434のlz皇女\n\n【シチュエーション・構図など】\n・通常衣装のおっぱい部分だけ露出した格好（構図の都合上そこまで見えないかもしれませんが・・・）\n・竿役とlz様は前回のyuhさんのイラスト（https://skeb.jp/@Hukahire113/works/2）と同じ立ち位置で、正面からのアングル（過去イラストのyuhさんの裏の顔がイメージに近いです　https://twitter.com/Hukahire113/status/1470401568482947081?s=20&t=KetCmBHMoE9yXq0_praMvQ）\n\nシーン①\n竿役のおちんちんを両手で包むようにして手を組み、先っぽにキスするlz様\n\nシーン②\nお口を「あーん」してもらい、舌の上に射精されるlz様\n\nシーン③\n口の端から精液を垂らしながらごっくん\n\nまた、もし可能でしたら剥けチン以外に、先まで皮の余った包茎おちんちんバージョンも描いてくださると助かります！\n\nNG項目などあれば遠慮なくキャンセルしていただいて大丈夫です、ご検討よろしくお願いいたします！", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hukahire113/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165