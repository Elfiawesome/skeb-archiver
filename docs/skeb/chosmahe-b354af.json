d let us know in the psd data if something is not allowed.\n\nAbout illustrations\nPlease leave all composition to us.\n\nPreferred delivery format\nI would appreciate it if you could separate the layers for the person and the background if there is one.\nPlease use PSD or PNG files.\n\n\nThank you very much for taking the time to read through this section.\nThank you very much for your consideration.\n\nhttps://drive.google.com/drive/folders/1yTVi_CiIM9bJR74eF_64A-iPQA9OiF02?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chosmahe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3289488, "client_id": 3294174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb76cdde/uploads/origins/2eae32da-a17b-488d-bc11-fc8e698d8cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a9835314a9a5c9ccda0b6f990843859", "srcset": "https://si.imgix.net/cb76cdde/uploads/origins/2eae32da-a17b-488d-bc11-fc8e698d8cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a9835314a9a5c9ccda0b6f990843859, https://si.imgix.net/cb76cdde/uploads/origins/2eae32da-a17b-488d-bc11-fc8e698d8cda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dd73b4277ac7cb4356c47f9788232cf 2x, https://si.imgix.net/cb76cdde/uploads/origins/2eae32da-a17b-488d-bc11-fc8e698d8cda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1f004b0c9a00ab74c89f54bd2b5d663 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb76cdde/uploads/origins/2eae32da-a17b-488d-bc11-fc8e698d8cda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5eb3670424950788dfa418401da56b47", "srcset": "https://si.imgix.net/cb76cdde/uploads/origins/2eae32da-a17b-488d-bc11-fc8e698d8cda?bg=%23fff&auto=for