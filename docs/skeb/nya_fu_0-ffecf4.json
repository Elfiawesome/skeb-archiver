装、蝶）：\nhttps://drive.google.com/drive/folders/1DpPLo9i7gSCs1EF1vOLncMrQUJ5ymj7E?usp=drive_link\n\nポーズのリファレンスについて\npose_ref_1.jpg → メイン・ポーズ（草の上に横たわっている）。\npose_ref_2.jpg → トランジション・ポーズ（場面が変わる前の瞬間）。", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@nya_fu_0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 3782410, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-254e-40c9-a7f7-a97a0f220a2d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8fa5c3671861e1a9fd55f05bd0e7869a", "srcset": "https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-254e-40c9-a7f7-a97a0f220a2d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8fa5c3671861e1a9fd55f05bd0e7869a, https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-254e-40c9-a7f7-a97a0f220a2d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a2684b5d66a718988dae896d775e9bf 2x, https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-254e-40c9-a7f7-a97a0f220a2d?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbb9034f344b9cbd37c50889f462c2a5 3x"}, "duration": 12, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-254e-40c9-a7f7-a97a0f220a2d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6946ab842ed7c8295d9e774be006179b", "srcset": "https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-254e-40c9-a7f7-a97a0f220a2d?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=6946ab842ed7c8295d9e774be006179b, https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-254e-40c9-a7f7-a97a0f220a2d?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=52d13fe2f75570244dc62c31f999fb63 2x, https://si.imgix.net/3d2f6e39/uploads/outputs/1a226b03-25