535f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19e74ca6ad5cabaa551492300e807ed9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d3972c9/uploads/origins/97ae906a-d142-41a1-83a6-9d9a251535f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1571761c92162441e0ae6b6fd0cde3", "srcset": "https://si.imgix.net/0d3972c9/uploads/origins/97ae906a-d142-41a1-83a6-9d9a251535f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd1571761c92162441e0ae6b6fd0cde3, https://si.imgix.net/0d3972c9/uploads/origins/97ae906a-d142-41a1-83a6-9d9a251535f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2fa2afb6a08621649cda6bc76307a9a 2x, https://si.imgix.net/0d3972c9/uploads/origins/97ae906a-d142-41a1-83a6-9d9a251535f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=725822e4a093053c316f1a359b704eae 3x"}, "body": "こんにちは！あなたは素晴らしい芸術を持っています！\n\n僕と友達のキャラクターを一緒に描いて、一人が他の人の肩に腕を回して満面の笑みを浮かべているような感じでお願いします。\n\nお忙しい中、本当にありがとうございました！\n\nリファレンス・オブ・マイ・キャラクター\nhttps://imgur.com/a/bb8k0yD\nマイフレンドキャラクター\nhttps://imgur.com/a/zBNmN8v", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TRPGmutsuki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1820581, "client_id": 1221844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166477921ab4dd109655ca1c161bc5da", "srcset": "https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166477921ab4dd109655ca1c161bc5da, https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66e172667aa3794a9edc3c2d45f70408 2x, https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=670713cb1329d8b42f335e8bfabc5d7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a19678358e54c76388298f3baece595", "srcset": "https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a19678358e54c76388298f3baece595, https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=120b1fd1e070682c9948b4d8031de9c4 2x, https://si.imgix.net/4a7b2e25/uploads/origins/0c70cf03-1a92-4099-96e4-1a0410102b25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26f519f6f919fe7627f455355f2474ff 3x"}, "body": "こんにちは。\nこの度は、skebの素敵な絵柄と作品に惹かれ、イラストをお願いしたくご連絡致しました。\n\n\n🤍リクエスト内容🤍\n・依頼枚数：1枚（2名）\nポーズや構図は、全てお任せいたします。\n洋服等も描きやすいように描き替えていただいて大丈夫です。\n\n\n🤍用途🤍\n「個人鑑賞」及び、「SNSのアイコン／ヘッダー画像での使用」を予定しています。\n（イラストをSNS上に直接投稿することは致しません。）\n\n\n🤍資料🤍\n「オリジナルキャラクター」の絵をお願いしたく存じます。\n2人は、一つの殺人事件を追っていた裏社会の人間です。\n色とりどりの人々が行き交う、ネオン煌めく繁華街で出会いました。\n\n①https://drive.google.com/file/d/1cirjhpYjP-GfIKDNAnMj1khtQNPQeAKP/view?usp=sharing\n名前：サザ・アーガイル\n職業：暴力団組員（ヤクザ）\n容姿：190cm／金髪金目／筋肉質／黒スーツに白いベスト／右手の小指がない\n設定：日本人とイギリス人のクオーター。29歳。\nアルコール依存症で、常に酒を飲んでいる。\n暴力的だが怠惰で、②を事件に巻き込んだ。\n\n\n②https://drive.google.com/file/d/1TBodtPuS0xv97kdYCY5-7VGJpGeNriIN/view?usp=sharing\n※許可を頂き、他の方の画像をお借りしています\n名前： 黒北 鈴流（くろきた れいる）\n職業：ホスト（源氏名：夢人）\n容姿： 178cm／薄ピンク髪金目／端正な甘い顔立ち／細身\n設定：日本人。25歳。少し砕けた敬語で話す。\n若干、精神安定剤に依存している。\n①に巻き込まれて共に行動している。\n\n\n関係性：事件を追う中で多少の衝突をしながらも、同じ時間を共有する新しい友人というポジションに落ち着いている。\n\n参考資料：https://drive.google.com/drive/folders/1PyrRzm4wUBhZrd3-FJRVgIix96Vdk8VL?usp=sharing\n\n\nもし、要望やお日にちに難しい所がございましたら、お気兼ねなくキャンセルしていただいて大丈夫です。\n恐れ入りますが、何卒ご検討のほどを宜しくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TRPGmutsuki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1820581, "client_id": 1505939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cfb3cc9b558a67ea9217f4fab11f5a6", "srcset": "https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cfb3cc9b558a67ea9217f4fab11f5a6, https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ef9d517c9db822f26a8940bec1a69e1 2x, https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36686119fa1ca1abf6602ea4365d34fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9554f8a6abc2a70c6d5621324e1739e", "srcset": "https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9554f8a6abc2a70c6d5621324e1739e, https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8be1d53f69e8124636fa87c46c906e8 2x, https://si.imgix.net/91f6b0f8/uploads/origins/8152e862-8039-49b9-9f24-00674dc40e45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a708614caa04d1c158e6054a69d55d47 3x"}, "body": "こんにちは、むつきさんのTRPGイラストいつも楽しく拝見しております。どの子もとても素敵です！\n特に南ソテツくんのデザインが余りにも好きで、良かったらリクエストさせてください。\nこれからも南くんはじめ他の子ちゃんたちの作品楽しみにしております。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TRPGmutsuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1820581, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28b44ff1/uploads/origins/c0ac3760-73b0-4acf-9044-aaec4966b1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce5def01d1294f553882764e25a165e1", "srcset": "https://si.imgix.net/28b44ff1/uploads/origins/c0ac3760-73b0-4acf-9044-aaec4966b1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce5def01d1294f553882764e25a165e1, https://si.imgix.net/28b44ff1/uploads/origins/c0ac3760-73b0-4acf-9044-aaec4966b1be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb8a3534b9280a5a1c0261723edbaad0 2x, https://si.imgix.net/28b44ff1/uploads/origins/c0ac3760-73b0-4acf-9044-aaec4966b1be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a75de17e0e78175fce446d0194d0ba29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28b44ff1/uploads/origins/c0ac3760-73b0-4acf-9044-aaec4966b1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9967007446d5d33716fafc41bec1372", "srcset": "https://si.imgix.net/28b44ff1/uploads/origins/c0ac3760-73b0-4acf-9044-aaec4966b1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit