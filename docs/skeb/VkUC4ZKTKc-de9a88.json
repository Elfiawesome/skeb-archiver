く恋人らしい雰囲気を感じる事の出来る構図やデザインだと大変嬉しいですが、基本的に希望は無い為、良ければお好きに描いて頂けると嬉しいです。  \n\n頂いたイラストは個人の範囲で楽しみたいと考えております。\n\n金額などに不備がありましたら、御手数ですが再送して頂けますと助かります。ご検討の程、よろしくお願い致します。  \n\n ①日坂蓮弥 \n男／170cm  \n人間。18歳。かなりの気分屋で常に飄々とした態度が目立つが、恋人に対しては悪戯好きなクソガキ。気紛れな猫みたいな性格。  \n\n②ディア・ノクターン \n男／173cm  \n吸血鬼。サプライズが好きな享楽主義の穏健なご隠居吸血鬼さん。恋人に弱い。好奇心旺盛で基本的にはポジティブな性格。\n\nhttps://drive.google.com/drive/folders/10hXl8q0Nn5MCX8j_H5wjcR2nrkE_aHcI?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@VkUC4ZKTKc/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3927604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f9d4142/uploads/origins/90c5e542-e8d0-4e4a-8d04-b591d235cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=115855a6dbc3f60a569655687e621be9", "srcset": "https://si.imgix.net/4f9d4142/uploads/origins/90c5e542-e8d0-4e4a-8d04-b591d235cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=115855a6dbc3f60a569655687e621be9, https://si.imgix.net/4f9d4142/uploads/origins/90c5e542-e8d0-4e4a-8d04-b591d235cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84c50dcd9619ad85ae44b32471887fde 2x, https://si.imgix.net/4f9d4142/uploads/origins/90c5e542-e8d0-4e4a-8d04-b591d235cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a309f6b23427af827eb515201c83eac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f9d4142/uploads/origins/90c5e542-e8d0-4e4a-8d04-b591d235cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1adee3ceac972fe13d14a04973b6ce", "srcset": "https://si.imgix.net/4f9d4142/uploads/origins/90c5e542-e8d0-4e4a-8d04-b591d235cd75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1adee3ceac972fe13d14a04973b6