6cbcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fac9b6ead5ff0fdd832f7555ca6c2595, https://si.imgix.net/3a13228c/uploads/origins/74afb3ac-0269-400e-8ab0-e5304336cbcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e6f6d7ced7b36fdb174cda626b50525 2x, https://si.imgix.net/3a13228c/uploads/origins/74afb3ac-0269-400e-8ab0-e5304336cbcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a39aca703eb4029ace2551e486416223 3x"}, "body": "やっこ様 はじめまして！\nやっこ様の擬カビがとてもかわいくて大好きで、こっそり見させていただいている者です……！\n今回は私のOCを描いていただきたくリクエスト失礼いたします。\n彼女は甘いものが大好きなドジっ娘の女の子です！\n資料内に色々な衣装がありますので、やっこ様のお好きな衣装を選んでいただけたらなと思います₍ᐢ‥ᐢ₎ ♡(装飾が難しかったり分からない場合は描きやすいように変更していただいて大丈夫です…！)\n構図、表情等全てお任せしますので、やっこ様の思い描くリンさんを描いていただけるととても嬉しいです！\nご検討いただけますと幸いです…！最後まで読んでいただき、ありがとうございました(*ᴗˬᴗ)\n\nhttps://drive.google.com/drive/folders/1K34-p33reB3j_QrXo0WxZJBS5LFtgvvD", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pkgkb_yk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3646606, "client_id": 446116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=429d10ab08964b5bcd85c8f58ba82593", "srcset": "https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=429d10ab08964b5bcd85c8f58ba82593, https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ffc156672bbe1cc595b493a5bd498f0 2x, https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c5b3c7d3ea9f345e4fd9a8af44a3bdc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55afc22b795903e5ffe8c2540ec628c8", "srcset": "https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55afc22b795903e5ffe8c2540ec628c8, https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a2fde3b69dbe3029c4a6e23b3533c54 2x, https://si.imgix.net/d33dacd8/uploads/origins/89db8a01-e1e0-4fb3-9063-ca874da6c0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b98170584b35dbde708df14e27e832a3 3x"}, "body": "初めまして、ぺー爺と申します。\nこの度やっこさんのアニメ風イラストが流れてきて一目惚れしてしまいました…！\nアニメ塗りが描けないのと、やっこさんの90年代調の絵柄がドンピシャで好みである為依頼をさせて頂きたいです…！\n\n⭐︎概要\n弊創作のOCであるパラサイトとメシェルトゥルゥーの日常のワンシーンをアニメ風に描いて頂きたいです。\n⭐︎設定\n▶︎メシェルトゥルゥー\n白と黒のバージョンがあり、今回描いて頂きたいのは黒の調査服(難しければ普段着の黒ワンピ)\n深淵にある神の眼でしたが、色々あって弱体化しています。気難しく見えますが一人で過ごすのが好きなだけで自分の力は人類の発展のためにあると考えているため、頼られると嬉しいし良き助言者であろうとします。\n宇宙での調査は極秘任務で、普段は戯曲家で通っています。\n▶︎パラサイト\nクラシックな服装と、ギャルっぽい服装のときがあり今回はギャルっぽい方で描いて欲しいです。\nその名の通り寄生系のクリーチャーで外宇宙からやってきました。本体は穴がたくさん空いた隕石のような姿。\nこちらも色々あって全盛期の力はなく、いまはメシェルトゥルゥーの監視のもと彼の財布に寄生しています。(ヒモ兼マネ)\n\n⭐︎関係\nメシェはパラサイトという厄介な人外が世間に迷惑をかけないように監視しているが、白の方ではいじめられ黒の方でものらりくらりと躱されています。(最終的には捕まるというのがお約束)\n⭐︎内容\nパラサイトがメシェルトゥルゥーに捕まってるところを描いていただきたいです。\nパラサイト→触手でお腹ら辺をぐるぐる巻にされて吊り上げられてる。表情はトホホ〜(目は閉じてる)\nメシェルトゥルゥー→パラサイトを捕縛している。腕を組んでジト目。怒りと呆れの表情が見られる。\n\n何卒よろしくお願いします……！！！\n\n↓パラサイト \nhttps://bsky.app/profile/lfcososaku.bsky.social/post/3lbb4zfakus2b\n↓ギャルっぽい服装(左)\nhttps://bsky.app/profile/lfcososaku.bsky.social/post/3lqsqmwonj22m\n↓メシェルトゥルゥー\nhttps://bsky.app/profile/lfcososaku.bsky.social/post/3lqsqmmukq22m\n\nhttp