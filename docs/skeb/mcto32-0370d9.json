こちらでパーツ分けを行い、アニメーションとして使用\n・グッズ等への印刷\n\n\n【納品形式】\n・サムネイル等にも使用したく、背景とキャラが分離されたPSDファイル、または透過PNGでの納品を希望いたします。\n・可能であれば上と左右が見切れていないと大変ありがたいです。\n・アニメーション用にパーツ分けを行うのはこちらで行いますので、特別な作業は不要です。\n\nhttps://drive.google.com/drive/folders/1-0bzlf3jqZerzjFNEC4nnNFmFHnv_Beu\n\nhttps://drive.google.com/drive/folders/1-0bzlf3jqZerzjFNEC4nnNFmFHnv_Beu", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mcto32/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4bff5d48/uploads/origins/9e5d3325-b60f-4f6e-b2b4-e249b0e0586f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=730311c8cc958fec45df7398b04d0d83", "srcset": "https://si.imgix.net/4bff5d48/uploads/origins/9e5d3325-b60f-4f6e-b2b4-e249b0e0586f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=730311c8cc958fec45df7398b04d0d83, https://si.imgix.net/4bff5d48/uploads/origins/9e5d3325-b60f-4f6e-b2b4-e249b0e0586f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb2f728c19dc9324f1b92081326d9bec 2x, https://si.imgix.net/4bff5d48/uploads/origins/9e5d3325-b60f-4f6e-b2b4-e249b0e0586f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=43c57aa6662c048b168dc997b16c65ce 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3793555, "nc": 144}], "sent_works": [], "similar_creators": [{"id": 43766, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "れんとん", "screen_name": "rent_83", "avatar_url": "https://pbs.twimg.com/profile_images/1652644845599731714/iJzXq9uK.jpg", "header_