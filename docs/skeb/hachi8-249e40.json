&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2618d290070359681fead3fbfdd78abe 3x"}, "body": "COC「ロトカ・ヴォルテラの愛堕討ち」の極道×落語家のうちよそイラストをお願いします！\n\n好きだからこそ素っ気ない態度をとってしまったり素直になれない極道×一枚どころか何十枚も上手な為、極道を振り回してからかう落語家のCPになります！\n極道が押し倒そうとしたら回避初期値クリティカルで避けたり、極道が変なものに取りつかれるとイライラしてキック初期値クリティカル＋最大値を出すような出目のいい落語家と、キック80がまったく通らなかったり「落語家からのアプローチに耐えられるか？」でファンブルを出しまくり落語家にメロメロな出目を出す極道です！\n\n表面上は極道→→→→→落語家ですが、自分を好きな癖に告白をしてこない極道にイライラして、落語家から温泉に誘ったりデートに誘ったりホテルに誘ったりしている極道→⇦落語家です。極道は落語家が大切すぎてどう接したらいいのか分からず、落語家はもっともっと好きになってほしいけど相手から言ってほしいという両片思いが長く、最近ようやくゴールインしました！今は二人とも、相手への愛情を素直に伝えられるようになったので、ひたすらにラブラブな日々を過ごしています！\n\nもし可能であれば、落語家は極道にお姫様抱っこされるのが大好きなので姫抱きか、極道の膝の上に落語家が座っていると嬉しいです！\n\n参考【https://drive.google.com/drive/folders/1Ck82_AR5L0tkx2bJ6c6PiZ8hfyEmwg6l?usp=sharing】", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1924139, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "青井", "screen_name": "yooo009", "avatar_url": "https://pbs.twimg.com/profile_images/1099591570003615744/2uMvUowI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/769007618111045633/1550998036/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 32}, {"id": 2493831, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "motiri", "screen_name": "motiri_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/1854472057826017280/m7p5Ge4h.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1807552151650258944/1730975604/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{