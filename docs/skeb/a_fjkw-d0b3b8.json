て優しく微笑んでいます。\n人物のキャンパスを占める割合は可能であれば多め（大きめ）で。\n\n・背景\n時間帯は晴れた昼。\n①の服装の場合は花畑\n②の服装の場合は、青空が望める窓際。やや風が吹いてる感じ\n\n・その他\n参考絵の髪飾りと服装は、色も含めて急ごしらえのものですので、\n全て藤川様が好きにリデザインしてOK\n絵師様独自の解釈やアレンジが好きですので、寧ろ推奨です。\n髪と目の色も調整して構いません。\n不明な箇所はお任せします。\n\n以上、ご一考いただければ幸いです\n\nhttps://drive.google.com/drive/folders/1YScRN5yljNHkcQk6IhKuL7-C6vlNV5AA?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@a_fjkw/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a51b5dee/uploads/origins/d752b7d2-6f86-4a7c-a3d1-5581900ff55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4821b9bc847050c5b2b63a158983b718", "srcset": "https://si.imgix.net/a51b5dee/uploads/origins/d752b7d2-6f86-4a7c-a3d1-5581900ff55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4821b9bc847050c5b2b63a158983b718, https://si.imgix.net/a51b5dee/uploads/origins/d752b7d2-6f86-4a7c-a3d1-5581900ff55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdf951d3e5d96b8f30a192d2e2ead8fc 2x, https://si.imgix.net/a51b5dee/uploads/origins/d752b7d2-6f86-4a7c-a3d1-5581900ff55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00708e07d3aebb36e368432a2174171e 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 584924, "client_id": 750321, "nc": 144}, {"path": "/@a_fjkw/works/58", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3095c8db/uploads/origins/64daf416-175c-4451-bade-f5b7306fe0de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=2