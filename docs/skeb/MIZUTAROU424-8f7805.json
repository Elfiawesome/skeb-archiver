17b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9ac51e07de72d55cbd6f804a5e77582", "srcset": "https://si.imgix.net/470e435d/uploads/origins/844bfa06-0db4-417b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9ac51e07de72d55cbd6f804a5e77582, https://si.imgix.net/470e435d/uploads/origins/844bfa06-0db4-417b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ea67c65ed3f5029896d94f752a34d67 2x, https://si.imgix.net/470e435d/uploads/origins/844bfa06-0db4-417b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41c7e52fd37828e786eb19c6b7f6c1c8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/470e435d/uploads/origins/844bfa06-0db4-417b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14d3102b5d5914212ab40e416b3675a9", "srcset": "https://si.imgix.net/470e435d/uploads/origins/844bfa06-0db4-417b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14d3102b5d5914212ab40e416b3675a9, https://si.imgix.net/470e435d/uploads/origins/844bfa06-0db4-417b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7946f332ac5915a28fc62b374e2da1db 2x, https://si.imgix.net/470e435d/uploads/origins/844bfa06-0db4-417b-bf3e-b9a79588ab2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e57ccd06792a99b49ddb31b48f8b14ac 3x"}, "body": "ミズタロウさん、お久しぶりです。\n以前は素敵なコミックをありがとうございました。今回も、白塗りネタで\nリクエスト致します。\n今回のキャラクターは既存では\nありませんので、おおよそのイメージから\n描写いただければ思います。\n\nシチュエーション\n\nバラエティ番組で女優が罰ゲームを\n受ける話。\n\n登場人物(以下Ａ)\n\n・年齢は４５〜５０歳くらい\n\n・ちょっとキツい感じの美女\n\n・高飛車でプライドが高く、普段はバラエティなどには出るような人物ではない。\n\n・加齢による肌の衰えを気にしている。\n\n\n以下、詳細な流れ\n\nバラエティ番組で罰ゲームを受けることになったＡ、控え室へ連れていかれる。\n\n衣装を着替えさせられる。\nハイレグレオタードに黒パンストの、\nいわゆるバニーガール姿に。\n\n座ってケープをかけられ、\nヘアバンドもつけられる。\nすっぴんを見せたくないＡだが、\n抵抗虚しくすっぴんにひん剥かれる。\n\n顔面を白粉で真っ白に塗られていく。\nのっぺりした仮面のような顔に。\nその後は派手に色を乗せられ、\n最後は赤い鼻をつけられる。\n出来上がったのは、ピエロのメイク。\n\nウィッグをつけてスタジオへ。\n歓声が上がるが、恥ずかしさに悶えるＡ。\n\n最後の罰ゲームとして、手足を拘束され\n顔面にパイ投げを食らうＡ。\nしかし、使用したパイは特別仕様で\nクリームがトルコアイスのように\n粘度の高いもの。クリームが顔にまとわりつき顔面はまるでお化けのように。\n(目も口も塞がっている。)\n怒って大声を出すＡだが、\nモゴモゴとくぐもった声を出すのが精一杯\nなのであった。\n\n以下、お願いしたいポイント\n\n・すっぴんはメイクしている時に比べて\n　小じわが目立つなど、ちょっと\n　年齢が出る感じです。\n\n・顔の白塗りは顔面のみ、\n　耳や生え際はそのままです。\n　白粉を塗った肌は突っ張って\n　あまり顔を動かせず無表情気味です。\n\n・ピエロのメイクは素顔がわからないくらい\n　派手なメイク。\n　\n・どんなに恥ずかしくても、\n顔には分厚く白粉が塗ってあるので\n顔だけは赤くなりません。\n\n・体型の崩れやデコルテのシワなど、\n年齢を感じさせる描写があると嬉しいです！\n\n・顔面を真っ白にする場面のみ\n段階を踏んで描写いただければと思います。\n\nかなり細かくなって\nしまい申し訳ありません、\nよろしくご検討ください！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIZUTAROU424/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1764756, "client_id": 895502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9d369da/uploads/origins/45633af6-df6c-4830-a6a5-4b4e12ee36e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb692c61be6d84c2e1a08c68684d581e", "srcset": "https://si.imgix.net/a9d369da/uploads/origins/45633af6-df6c-4830-a6a5-4b4e12ee36e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb692c61be6d84c2e1a08c68684d581e, https://si.imgix.net/a9d369da/uploads/origins/45633af6-df6c-4830-a6a5-4b4e12ee36e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d5f56df34ab4f8c8ce512cffc4e433d 2x, https://si.imgix.net/a9d369da/uploads/origins/45633af6-df6c-4830-a6a5-4b4e12ee36e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7afb39bd53edbf4c18a1109b401e62f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9d369da/uploads/origins/45633af6-df6c-4830-a