お願いしたいです！\nハイグレ」のポーズをとってほしいです！\n洗脳され催眠術でハイグレのポーズをさせられ、他の人も改心させたいと思っています！\n\nhttps://drive.google.com/drive/folders/10maI7rHB8S8RF2TE_SppJQBxqgJud8ks?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hypnowriter5/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 773426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216728342855cb8b1e4e9d974345a07b", "srcset": "https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216728342855cb8b1e4e9d974345a07b, https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d4e775ba205beb792678c131ee11d89 2x, https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82112ab4bdcdbd3e7a799f7124c812db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3830dfdf9392ac7f7ce8f0413ee90736", "srcset": "https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3830dfdf9392ac7f7ce8f0413ee90736, https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f03de22ab94512fd6dc05c45c78bf5b5 2x, https://si.imgix.net/78607805/uploads/origins/6754c333-dbc5-455e-8821-f1b8245aae34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b943e0cb11e0eec2261f4ce0475eba17 3x"}, "body": "こんにちは。初めまして。\nいつも楽しみにイラストを拝見しております。\nあきたろうさんの時間停止モノが大好きで、今回思い切ってリクエストさせてもらいます。 \n\n街中で30代ぐらいの真面目そう且つ爽やかなサラリーマンやコンビニ店員、若パパ(ポロシャツとか着てそうな)が時間を止められて並んでいるシチュエーションをお願いしたいです。\n表情はさっきまで普通に生活していてピタッっと止まった感じで、\n下半身は丸出しにされて爽やかな割に意外と毛深いとかでお願いしたいです。\nチンコは勃起してても平常でも良いですが平常なら半剥けが好きです。\n表情は普通なのに、ヤバい状態というギャップな感じが毎回ツボです。\n\n是非ご検討ください。\nよろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hypnowriter5/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f36e527a/uploads/origins/e4642732-f372-4f01-9b57-ec081a397ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=838a4e3ecc0b7772ff2a4117cda41f74", "srcset": "https://si.imgix.net/f36e527a/uploads/origins/e4642732-f372-4f01-9b57-ec081a397ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=838a4e3ecc0b7772ff2a4117cda41f74, https://si.imgix.net/f36e527a/uploads/origins/e4642732-f372-4f01-9b57-ec081a397ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aded6b9cbe2f12b263c5602281ba7279 2x, https://si.imgix.net/f36e527a/uploads/origins/e4642732-f372-4f01-9b57-ec081a397ed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ae2aeddd8520ddf2f14175c049c06e7 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 773426, "nc": 48}, {"path": "/@hypnowriter5/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 773426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9277029cf4fc25d598ba59899bb04b", "srcset": "https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e9277029cf4fc25d598ba59899bb04b, https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b77ee4029e0c9e82010e176ada8d65b 2x, https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99706a833d9a47984e2c6c1c69cfc9bc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27eddb07f860d6a59574c39b12001b8b", "srcset": "https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27eddb07f860d6a59574c39b12001b8b, https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77d3c46521cf9ab2afab48698967d8fd 2x, https://si.imgix.net/52bec75e/uploads/origins/9bd344a0-455e-48b0-b713-ff6744d44dec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29de1a3c931860c6f334adb604ea99a0 3x"}, "body": "こんにちは。あなたの作品をとても楽しんでいます。簡単な催眠術のシナリオをお願いできますか？\n\nとなりの家のクソガキにいつもいじめられているモブ子。しかし、そのモブが「催眠螺旋ディスク」を手に入れると一変する。\n\n「どうした、キモオタおにいさん。まだ彼女いないの？ははは、当たり前だろう！？え？あの螺旋を覗く？何を......え......あ......はい......もうおにいさんを見下すことはありません...おにいさんを見下した記憶は、おにいさんを尊敬する記憶になっています...おにいさんは私が目指すかっこいいアイドルです...\"\n\nみたいな感じでいいんでしょうか？", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hypnowriter5/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 773426, "client_id": 43412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=133c16cbdeebc4f1eed0a58fb4390432", "srcset": "https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=133c16cbdeebc4f1eed0a58fb4390432, https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4dd13d606421bce2dc92c0cf175a979e 2x, https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf1b4a643ab8b3dd36169524bd005f97 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eff1dfc4c5b60551eee957b6a8d8105", "srcset": "https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3eff1dfc4c5b60551eee957b6a8d8105, https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c3d0c3bbd953b42ef9d345acb7981cc8 2x, https://si.imgix.net/5bb3c6f9/uploads/origins/9326fc9e-32da-4f79-90e7-9285c2d70901?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29afb6f4723ef3f1bca357112b0b83aa 3x"}, "body": "こんばんは。\nあどけない顔立ちの少年が別人に化けるのを楽しむ、男皮モノというジャンルの漫画を読んでみたいです。\n中肉中背〜やや小柄な身体に、参考資料のような要領で、筋肉質でガタイも良い、帝国戦隊ワイルドレッドのようなヤンチャそうな顔立ちに黒髪五分刈りの少年の姿を模した着ぐるみを着て、架空の別人に化ける。\n野球のユニフォームを着てリアルな球児のコスプレを姿見に映して楽しみ、気分を上げるべく外見に合わせた男らしい口調で独り言を呟きながら、裏アカ用自撮りを楽しんでいるのを見てみたいです。\n着替え場所や自撮り場所は自室でも他の場所でもOKです。\n\nhttps://www.pixiv.net/artworks/62728004#manga", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hypnowriter5/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 773426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecfcc6489fefa381f7aba267abe647ed", "srcset": "https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecfcc6489fefa381f7aba267abe647ed, https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27060bfab8596993f56e99d094da1b9d 2x, https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ad14ae5e24d02bc8e330c7b320bdedd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=866d8346afcffa7b9948b458af4fec86", "srcset": "https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=866d8346afcffa7b9948b458af4fec86, https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=657a169def803ceccb73e7cb010c7c98 2x, https://si.imgix.net/ce6403d1/uploads/origins/ca15cc65-d474-467d-ab2a-98a1adff3faa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ea976f44563e779bbd78c690db3a04d 3x"}, "body": "いつも素敵な作品をありがとうございます。\n\n催眠系でない上にマニアックなリクエストで申し訳ありませんが可能でしたらお願い致します。\n\n以下リクエスト詳細です。\n\n概要\n喧嘩をした不良少年2人が罰として全裸で晒し者にされている\n\nキャラクター\n不良2人\n体格や雰囲気は先生の作品のフィギア化不良くんのような感じでお願い致しますが、できればで結構ですのでタイプが違う2人(体格自体は同じくらい)にして頂けましたら幸いです。\n\nシチュエーション詳細\n・喧嘩をした罰として人通りの多い場所(廊下、校門等)で全裸にされる\n・悪さをした内容の書かれたプレートを首から下げている(「僕達は喧嘩をしました反省しています」等)\n・前を隠すことは許されない\n・性器は包茎(大きさ、陰毛等はお任せします)\n・周囲からからかいの声が飛ぶ\n・本人たちのは「人生終わった」と思うくらい恥ずかしがっている→涙目、首の辺りまで赤面\n・体毛はどちらでも結構ですが、髭だけはなしでお願い致します。\nまた、さらにマニアックで大変申し訳ありませんが、差分として髪の毛を五厘に断髪かつ白ブリーフ着用(デザイン性の全くない昔ながらの物、年組名前記入)を可能でしたらで結構ですのでお願い致します。\n\nしつこくて大変申し訳ありませんが、「普段イキっているヤンキーが死ぬほど恥ずかしがっている」という点を強調してくださいますようお願い致します。\n\n長々と失礼申し訳ありませんでした。\nよろしくお願い致します。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hypnowriter5/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 773426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bef1a1b6/uploads/origins/a0e64a3e-986c-4402-8add-b5de76b9a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a80e3bba50fd943aa96902d8e27462e", "srcset": "https://si.imgix.net/bef1a1b6/uploads/origins/a0e64a3e-986c-4402-8add-b5de76b9a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a80e3bba50fd943aa96902d8e27462e, https://si.imgix.net/bef1a1b6/uploads/origins/a0e64a3e-986c-4402-8add-b5de76b9a3be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=