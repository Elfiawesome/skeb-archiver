とても可愛らしく、一目惚れいたしました。\n\n私の創作キャラクター「墓場マモル」を恐竜化したイラストをお願いしたく、リクエストさせていただきました。\n\n参考資料はこちらになります：\n\n\n・雰囲気や性格は元のキャラクターのイメージを踏まえていただけますと嬉しいです\n・恐竜の種類やデザインの解釈はお任せいたします\n\n完成したイラストは、個人での鑑賞およびSNSヘッダー等に使用させていただく予定です。\n\nSkebに不慣れなため、不足や不備がございましたら申し訳ありません。\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1bVKlhnPIkLucPQ7fJHDR3uIyOApnOQE2", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pangaea_Pafu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3584459, "client_id": 2005344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13fe0cf1/uploads/origins/9728625f-921a-4c05-910b-0bbb800b7d2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66adbfb75a349aec06d74367a3e34ea5", "srcset": "https://si.imgix.net/13fe0cf1/uploads/origins/9728625f-921a-4c05-910b-0bbb800b7d2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66adbfb75a349aec06d74367a3e34ea5, https://si.imgix.net/13fe0cf1/uploads/origins/9728625f-921a-4c05-910b-0bbb800b7d2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d911b0a8c7b223197b858befddeb4dc1 2x, https://si.imgix.net/13fe0cf1/uploads/origins/9728625f-921a-4c05-910b-0bbb800b7d2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f1024f5f38037a545c7bc9a3b636ded 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13fe0cf1/uploads/origins/9728625f-921a-4c05-910b-0bbb800b7d2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5e4fb59b7b2a0dc65f743b5642dc3a8", "srcset": "https://si.imgix.net/13fe0cf1/uploads/origins/9728625f-921a-4c05-910b-0bbb800b7d2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5e4fb59b7b2a0dc65f743b5642dc3a8, https://si.imgix.net/13fe0cf1/uploads/origins/9728625f-