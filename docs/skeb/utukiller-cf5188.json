_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utukiller/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2866161, "client_id": 3953365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da675aab76ec22d06ebe70edec89ea1a", "srcset": "https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da675aab76ec22d06ebe70edec89ea1a, https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80af42c655500496a9a736c45cc520cd 2x, https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d92a2a622f5469ce9420ca484f00d3f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8ec163cdef891635d5e6fe119b2d982", "srcset": "https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8ec163cdef891635d5e6fe119b2d982, https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1399a74ec77d724731d31a9a905afa43 2x, https://si.imgix.net/5dad0de4/uploads/origins/db334b38-d521-46d9-9d5a-70a7c7ff0cf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe6e6f08382c9e008f8c52ebad07e0dd 3x"}, "body": "見境ない様\nはじめまして！Siaと申します。\nいつもXにて見境ない様のイラストを楽しく拝見させていただいております！\n見境ない様のモノトーンで描かれるダークでありながらもゆるかわいい雰囲気がほんとに大好きで（特にデフォルメ強めのイラストが...!）見境ない様にOCのイラストを描いていただきたいと思い、この度イラストのリクエストをお送りさせていただきました。\n\nリクエストの内容は以下となります。\n\n【依頼内容】\n・歌ってみた動画（色水/おいしくるメロンパン）のサムネイルとして非収益で利用するイラスト１枚\n・サイズ（縦1080×横1920）\n・イラストにOCと青い蝶の要素を何かしらいれていただきたいです。\n\n【oc詳細】\n・左に涙ぼくろあり\n・髪色は青系ですがモノトーンで描いていただきたいです。\n・髪は無造作な感じで襟足短め\n・ocのイラスト資料と歌ってみた音源も添付させていただきます。\n\nOCの服装、全体的な構図などにつきましては見境ない様におまかせでお願いさせていただきたいです。\nまた、納品していただいた作品を利用する際は必ずクレジットの明記もさせていただきます。\nどうかご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_m31gQPaCGzIDPGWuD6gg3VjKWBYyqBF?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@utukiller/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2866161, "client_id": 2759616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a51fec4/uploads/origins/f6850e53-7e4f-46ac-9ba7-f8efab592251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=892b1555882bff66ec5d57dc1cf3fa24", "srcset": "https://si.imgix.net/9a51fec4/uploads/origins/f6850e53-7e4f-46ac-9ba7-f8efab592251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=892b1555882bff66ec5d57dc1cf3fa24, https://si.imgix.net/9a51fec4/uploads/origins/f6850e53-7e4f-46ac-9ba7-f8efab592251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24648a07f6a936fd210c7dbba3edfbdc 2x, https://si.imgix.net/9a51fec4/uploads/origins/f6850e53-7e4f-46ac-9ba7-f8efab592251?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2a0fd898141b52508c9f31e0cb6cff4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a51fec4/uploads/origins/f6850e53-7e4f-46ac-9ba7-f8efab592251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f05