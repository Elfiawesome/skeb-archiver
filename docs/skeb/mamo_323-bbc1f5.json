70c5-42a0-8e98-7d181bcaec50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b84abd3a98879258a00c88ff90846ce, https://si.imgix.net/eb6bd259/uploads/origins/8bcc2739-70c5-42a0-8e98-7d181bcaec50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5194cfddd5cdab3a2603844a50ed010 2x, https://si.imgix.net/eb6bd259/uploads/origins/8bcc2739-70c5-42a0-8e98-7d181bcaec50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1ca0a632ac6d13ebca76f4926a16457 3x"}, "body": "桃瀬まも様\nはじめまして、Vライバー事務所Razzプロダクション所属の星那 柚花と申します。\n\n桃瀬まも様の描かれるイラストがとても可愛く綺麗で、ぜひ私 星那 柚花を描いていただきたいと思いご連絡いたしました。\n\n【使用用途】\n投げ銭機能付配信アプリ、YouTube、ツイキャスでの使用\nSNSでの使用\nデジタル・リアルグッズの制作、頒布、販売\n外部案件での使用\n\n※トリミングや影つけなどの加工を行う場合がございます。\n\n【内容】\n全て桃瀬まも様に一任させていただければと思います。\n好きにアレンジ、デザインしていただけると嬉しいです。\nぜひ、桃瀬まも様の得意な雰囲気で描いていただけると嬉しいです。\n\n＊髪は頭頂部が黒で毛先に行くに連れ紫になるグラデーション\n＊モチーフは柚子の花、星\n＊左目下に泣きぼくろがあります。\n\n【性格や設定】\n天真爛漫だが少し抜けているところがある。\n一生懸命で頑張り屋だがすぐ病みがちなメンヘラな一面も。\n流花群(流星群のように花弁が降る)観測所の管理人だが、観測所自体は閑古鳥が鳴いているため実質ニートな生活を送っている。\n\n【お願い】\n頭部や髪、服が途切れていない(上と左右の途切れていない)キャラクターのみの透過データをいただけますと幸いです。\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/y6blan475ju5chq0c19rf/.png?rlkey=iu0l1ccisheufo6m2g5bn3r55&st=ocm319p0&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mamo_323/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3194930, "client_id": 1106955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28fedea8/uploads/origins/c1655ce6-b331-4e6f-8417-5fa004fdf256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d359b79441377d0675541ce8fa34a69", "srcset": "https://si.imgix.net/28fedea8/uploads/origins/c1655ce6-b331-4e6f-8417-5fa004fdf256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d359b79441377d0675541ce8fa34a69, https://si.im