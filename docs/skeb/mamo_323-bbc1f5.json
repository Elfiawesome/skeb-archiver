に限り、イラストの使用許諾（Twitterアイコン、YouTubeサムネ利用等）をいただければ幸いです。\n\n以上となります、どうぞよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mamo_323/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3194930, "client_id": 3533248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99becfcafab1072c246cff5b5671f35a", "srcset": "https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99becfcafab1072c246cff5b5671f35a, https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d715534c1404c3a517dcb4993fec1d63 2x, https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8653e253b4d3b770f0ae13ab7833ba74 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09c6002a8716da39cf039f77f118e7e6", "srcset": "https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09c6002a8716da39cf039f77f118e7e6, https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd3174edc5a04ed73c1f99b146d71e8 2x, https://si.imgix.net/c563ffa7/uploads/origins/565050a8-8809-49ea-a02f-fe0159fae541?bg=%23fff&auto=format%2Ccom