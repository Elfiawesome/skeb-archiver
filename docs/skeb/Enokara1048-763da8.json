ix.net/2bfcfe90/uploads/origins/daa6cf26-9e83-403e-a877-d0d5a58958e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=befa8a80904972fd2717fa633e9d0d6a 2x, https://si.imgix.net/2bfcfe90/uploads/origins/daa6cf26-9e83-403e-a877-d0d5a58958e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d6855847e50afd75740689d59269887 3x"}, "body": "はじめまして。アピールありがとうございます。\nXで作品を拝見し、色使いやキャラクターそのもの、また背景の書き込み全てが好みで、書いていただきたいと思い、リクエストさせていただきたいと考えています。\nOCの紫苑フブキを描きたいとのことでしたのでぜひお願いしたく思います。\n儚げな少女で歳は14。眠ることが好きな娘です。\n紫苑の花と雪の結晶がモチーフになっております。\nどのように書いてくださっても構いません。好きなように書いて頂きたいです。もちろん衣装にアレンジ及び変更等加えてくださっても構いません。雰囲気も明るめ、暗め問いません。\n\n宛名を書いていただける場合、有り無しどちらのファイルも希望いたします。\n\nどうぞよろしくお願い致します。\n\n資料\nhttps://drive.google.com/drive/folders/1azhWdi6MrEBv2KntLmScWJ65mL2pSTBH", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Enokara1048/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2687799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65a55d61/uploads/origins/9cf336e3-4c70-4cd6-888e-af4d2f8f87a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b33266b80d12347a9908eb514d69b940", "srcset": "https://si.imgix.net/65a55d61/uploads/origins/9cf336e3-4c70-4cd6-888e-af4d2f8f87a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b33266b80d12347a9908eb514d69b940, https://si.imgix.net/65a55d61/uploads/origins/9cf336e3-4c70-4cd6-888e-af4d2f8f87a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e6e6eebeb0eb82dda540ca0ca9de9e1 2x, https://si.imgix.net/65a55d61/uploads/origins/9cf336e3-4c70-4cd6-888e-af4d2f8f87a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b5101eaa1281965bcfc554143220396 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "htt