.aimerfeel.jp/shop/g/g8040662871/\n\n・資料画像では髪を括っていますが、寝起きということで髪はほどけた状態\n\n・表情は涙目で恥ずかしがっていて、(やってしまった、どうしよう)と言った困惑の感情が表れている感じ\n\n・その後恥ずかしがりながら洗濯した布団を干すクロちゃんの絵が入っているととても嬉しいです。\n\n・台詞はお手数かけますがお任せいたします。入っていなくても大丈夫です。\n\nリクエスト内容が多くなりましたが、よろしくお願いいたします。\n\nhttps://p.eagate.573.jp/game/bombergirl/bg/p/girl.html", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sakamata4/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 67715, "client_id": 262830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=117047a6899fb8029033d4fdc3b7413f", "srcset": "https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=117047a6899fb8029033d4fdc3b7413f, https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b0179320dee37ff2a7940593a97f047 2x, https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17b966228a4958829332fb98630e1fb1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb5cd55702d97a2806ed82d3253be20", "srcset": "https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb5cd55702d97a2806ed82d3253be20, https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ed622b975a41e6d09c772dfd549a23 2x, https://si.imgix.net/4f665bc2/requests/131942_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=