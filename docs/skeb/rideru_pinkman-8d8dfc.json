Xへの投稿\n・イリアムのバッジ獲得やイベントで応援してくれたリスナー様への特典に使用\n（デジタルグッズ、リアルグッズ含む）\n※グッズの販売はいたしません\n・背景付きでいただける場合、イベント入賞時に雑誌や駅のポスターの掲載に使わせていただく可能性あり\n\nなどに活動全般に使用予定です。\n背景透過のキャラクターのみのデータもいただきたいので、PNGかPSDデータで納品していただけると大変嬉しいです。\n\nサムネなど使用するため顔や耳、髪の毛などが見切れていないとありがたいです..！\n\nお忙しいところ恐れ入りますが、よろしくお願いします。\n\nhttps://lit.link/mirei111", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2749213, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "山小屋/ご依頼募集中", "screen_name": "Yamagoya_000000", "avatar_url": "https://pbs.twimg.com/profile_images/1658820348039794688/QPVJB9Ra.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1658819970414055424/1774434680/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2843993, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "回（null）", "screen_name": "nullmms", "avatar_url": "https://pbs.twimg.com/profile_images/2028754800960266241/bhbgQygn.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 49}, {"id": 2848643, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Mi©", "screen_name": "pmpmmochi", "avatar_url": "https://pbs.twimg.com/profile_images/1996372999944232960/mpofQ7HM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1885950235677278208/1752005254/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acc