u6708\u306b\u30db\u30c6\u30eb\u30a2\u30f3\u30c7\u30eb\u30bb\u30f3\u3092\u901a\u904e\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u3001\u672a\u3060\u306b\u601d\u3044\u3092\u99b3\u305b\u3066\u3044\u307e\u3059\u3002\n\u6700\u9ad8\u306e\u30b9\u30c1\u30eb\u3092\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u2026\uff01\u30e2\u30d0\u30b2\u301c\u69d8\u306e\u63cf\u304b\u308c\u308b\u30a4\u30e9\u30b9\u30c8\u3001\u5927\u597d\u304d\u3067\u3059\u3002\n\u305d\u3053\u3067\u3001\u30e2\u30d0\u30b2\u301c\u69d8\u306e\u63cf\u304b\u308c\u308b\u30a4\u30e9\u30b9\u30c8\u306e\u81ea\u63a2\u7d22\u8005\u3092\u898b\u305f\u3044\u3068\u601d\u3044\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\u3054\u7e01\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u3069\u3046\u305e\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\uff01\n\n\n\u25bc\u4e0b\u8a18\u4f9d\u983c\u5185\u5bb9\n\u30db\u30c6\u30eb\u30a2\u30f3\u30c7\u30eb\u30bb\u30f3HO1\u3068NPC\u3067\u3042\u308b\u30cf\u30aa\u30f3=\u30c9\u30eb\u3068\u306e2\u4eba\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u601d\u3044\u307e\u3059\u3002\u79c1\u306eHO1\u306f\u6700\u5f8c\u306e\u5c40\u9762\u306b\u3066\u30cf\u30aa\u30f3=\u30c9\u30eb\u306e\u624b\u3092\u53d6\u308b\u304b\u5426\u304b\u3067\u624b\u3092\u53d6\u308a\u3001\u690d\u7269\u5316\u3092\u3057\u3066\u30ed\u30b9\u30c8\u3057\u307e\u3057\u305f\u3002\u306a\u306e\u3067\u3001HO1\u306b\u690d\u7269\u304c\u5dfb\u304d\u3064\u3044\u3066\u3044\u308b\u3088\u3046\u306a\u305d\u3093\u306a\u30a4\u30e9\u30b9\u30c8\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u5b58\u3058\u307e\u3059\u3002\u69cb\u56f3\u7b49\u306f\u304a\u307e\u304b\u305b\u3057\u305f\u3044\u3068\u601d\u3044\u307e\u3059\u306e\u3067\u3001\u30e2\u30d0\u30b2\u301c\u69d8\u306e\u89e3\u91c8\u3067\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\uff01\n\n\n\u25bc\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\nHO1\uff1a\u30aa\u30fc\u30ca\u30fc\n\u540d\u524d\uff1aLoa S