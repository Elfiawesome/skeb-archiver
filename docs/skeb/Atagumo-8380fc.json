b\u3089DP-12\u3092\u30ea\u30af\u30a8\u30b9\u30c8\u3057\u305f\u3044\u3067\u3059\n\n\u30ad\u30e3\u30e9\uff1a\u30c9\u30fc\u30eb\u30ba\u30d5\u30ed\u30f3\u30c8\u30e9\u30a4\u30f3\u304b\u3089DP-12(\u9854\u3001\u4f53\u3064\u304d\u306f\u8cc7\u659904\u30d9\u30fc\u30b9)\n\u9aea\u578b\u3001\u9aea\u8272\uff1a\u8cc7\u659904\u306e\u7d50\u3093\u3067\u3042\u308b\u9aea\u3092\u89e3\u3044\u305f\u72b6\u614b\n\u8863\u88c5\uff1a\u8cc7\u659905\u306e\u3088\u3046\u306a\u30a6\u30a7\u30c7\u30a3\u30f3\u30b0\u30c9\u30ec\u30b9(\u80f8\u304c\u826f\u304f\u898b\u3048\u308b\u611f\u3058\u306e\u30c9\u30ec\u30b9\u3060\u3068\u5b09\u3057\u3044\u3067\u3059)\n\u30b7\u30c1\u30e5\uff1a\u3053\u3061\u3089\u3082\u8cc7\u659905\u306e\u3088\u3046\u306a\u611f\u3058\u3001\u30a6\u30a7\u30c7\u30a3\u30f3\u30b0\u30d6\u30fc\u30b1\u3092\u6301\u3061\u5dee\u3057\u51fa\u3055\u308c\u305f\u6307\u63ee\u5b98\u306e\u624b\u306b\u81ea\u8eab\u306e\u624b\u3092\u6dfb\u3048\u3066\u3044\u308b\n\u80cc\u666f\uff1a\u304a\u4efb\u305b\u3001\u96e3\u3057\u3051\u308c\u3070\u30c9\u30eb\u30d5\u30ed\u306e\u8a93\u7d04\u753b\u9762\n\u6307\u8f2a\uff1a\u8cc7\u659907\u306e\u3088\u3046\u306a\u30b7\u30f3\u30d7\u30eb\u306a\u6307\u8f2a\n\u203b\u8981\u7d04\u3059\u308b\u3068\u8cc7\u659905\u306e\u3088\u3046\u306a\u30b7\u30c1\u30e5\u306eDP\u30de\u30de\u304c\u5e0c\u671b\u3067\u3059\n\n\u5dee\u5206\u304c\u53ef\u80fd\u3067\u3042\u308c\u3070\u4ee5\u4e0b\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\n\u30fb\u6307\u63ee\u5b98\u306e\u624b\u3092ON/OFF\u51fa\u6765\u308b\u3088\u3046\u306b(\u624b\u304c\u7121\u304f\u3066\u3082\u9055\u548c\u611f\u304c\u51fa\u306a\u3044\u611f\u3058\u3060\u3068\u5b09\u3057\u3044\u3067\u3059)\n\u30fb\u8868\u60c5\u306e\u5dee\u5206(\u5b09\u3057\u304f\u3066\u6ce3\u3044\u3066\u3057\u307e\u3063\u3066\u3044\u308b\u8868\u60c5\u3084\u7167\u308c\u3066\u3044\u308b\u9854\u306a\u3069)\n\n\u203b\u7d0d\u54c1\u3055\u308c\u305f\u30a4\u30e9\u30b9\u30c8\u3092\u30bf\u30da\u30b9\u30c8\u30ea\u30fc\u306b\u3057\u90e8\u5c4b\u306b\u98fe\u308a\u305f\u3044\u306e\