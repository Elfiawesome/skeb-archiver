fit=crop&crop=top&w=200&h=200&blur=200&s=c1f76cf8775e9138470642e1b2e94d47", "srcset": "https://si.imgix.net/d32b7fae/uploads/origins/f1382707-0a7a-4897-b72a-5021d07932b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1f76cf8775e9138470642e1b2e94d47, https://si.imgix.net/d32b7fae/uploads/origins/f1382707-0a7a-4897-b72a-5021d07932b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae79dcc2d31718b3e38923b8d7184ee7 2x, https://si.imgix.net/d32b7fae/uploads/origins/f1382707-0a7a-4897-b72a-5021d07932b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=138bf91334c4bbe041b0a95a0a3ca5ca 3x"}, "body": "初めまして。メッセージ失礼致します。\n作品を拝見してぜひイラストを描いていただきたくご連絡させて頂きました！！\n\nキラキラとした絵柄が本当に大好きで、ぜひ\n私の個人的な創作キャラクターくんを是非書いていただきたいです！\n\n◎英国紳士なバリスタ犬獣人さん\n身長が大きい大型犬 \n紳士的で優しく お顔も美しいので女性客にモテモテですが、好きな子には気持ちをなかなか気づいて貰えず進展しないちょっと可哀想なお兄さんです！\n冒険者ギルドに所属しながらギルドに併設されるカフェバーで働いています。コーヒー好きでカフェイン中毒者とギルドの仲間に言われてます。\n\n\nこちらのイラストは個人的鑑賞(個人利用のグッズ制作)やPCの背景、SNSアイコン等使用、など個人利用範囲に使用したいと思っています。\n\nできたら頭が切れてない構図だとうれしいです！！\nその他髪型服装アレンジ等 構図 表情など\n自由にしていただいて構いません！！\n可能でしたらメガネありなしで差分つけてくださると嬉しいです。\n\nこちら資料や設定集となっております。\n\nhttps://drive.google.com/file/d/1-gNGNZN4OfdMELUtBKk3wTlzO139Idis\n\n\nぜひご縁ありましたらよろしくお願いします。\n※金額等不十分な点ございましたら再送信させていただきますのでよろしくお願いします！\n\nhttps://drive.google.com/file/d/1-gNGNZN4OfdMELUtBKk3wTlzO139Idis", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mil_k_DIVE/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2651041, "client_id": 1496594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b950c05e32e6944cbdcd3a933242508c", "srcset": "https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b950c05e32e6944cbdcd3a933242508c, https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37ce483becd9c835da7b888dfc216d2d 2x, https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3d19bd3de9a79aafb70062cd7e509c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad6a37bf94890272b71ecbefe98781f", "srcset": "https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad6a37bf94890272b71ecbefe98781f, https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9646e92c577903589c44c26bf8d00caa 2x, https://si.imgix.net/f0858561/uploads/origins/f0e6fdd8-1e6f-40a5-bfcb-bdaa4d32a2a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=557d78621533dbb51a8d7133fb3f3276 3x"}, "body": "初めまして！Rotirさんのとても素敵な絵が流れてきて、是非描いてもらいたいと思いリクエストさせていただきました！\n\n●リクエスト内容\nCoC「ファウストとショコラ」を通過した自探索者と相方の一枚絵を描いてほしいです！\n\n●使用目的\n個人の観賞用、金銭の発生しない個人使用でのグッズ化、同卓者に見せる等です\n\n●構図やポーズ\n一緒にチョコレートを作っていると嬉しいです。ですが、特にこだわりはないためお好きに描いてください。\n服装も自由にしてください。\n\n\n難しかったり、気に入らなかったり、忙しくて手が開かない等あれば断ってくださって構いません。\nご縁があればよろしくお願いします！\n\n\n下記はキャラクターのプロフィールと関係性です。\n\n▶︎白髪(自PC)\nショコラティエ/180cm/とにかく身内に甘い。常に微笑みを浮かべている。魔法使いがキッチンをひっくり返しても何も思わないくらいに甘い。喜ぶお客さんの顔が好き。\n\n▶︎茶髪(相方)\n魔法使い/175cm/のんびり屋で壊滅的に不器用なくせに人の面倒を見たがる。100%善意で行動を起こすが悉く失敗に終わる。匂い、態度、考え方から詰めまで何もかもが甘い。表情豊か。\n\n▶︎2人の関係性\n一緒にチョコレート屋を営んでいる。ショコラティエの作ったチョコに魔法使いが魔法をかけて魔法のチョコを作る。お互いのことを大切に思っている。おすすめの魔法のチョコはオランジェット、薔薇を模したチョコ、鳥型のチョコ。\n\n\nキャラクターの見た目は添付URLに入ってあります。\nhttps://drive.google.com/drive/u/0/folders/1xjqu7cFNh4lXqDfh1xupwVg9SwzEXhkW?fd=true\n\nhttps://drive.google.com/drive/u/0/folders/1xjqu7cFNh4lXqDfh1xupwVg9SwzEXhkW?fd=true", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mil_k_DIVE/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b3a53d8a/uploads/origins/a7ac4fd9-5fb6-4829-81d1-07802d5a88aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=293ac1df2918e77c628bee66d35afd14", "srcset": "https://si.imgix.net/b3a53d8a/uploads/origins/a7ac4fd9-5fb6-4829-81d1-07802d5a88aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=293ac1df2918e77c628bee66d35afd14, https://si.imgix.net/b3a53d8a/uploads/origins/a7ac4fd9-5fb6-4829-81d1-07802d5a88aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c68a343a2342bdcbcb4cf4319e34736 2x, https://si.imgix.net/b3a53d8a/uploads/origins/a7ac4fd9-5fb6-4829-81d1-07802d5a88aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53d2a5335ae60503d62298c1fe72638f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2651041, "client_id": 2618788, "nc": 128}, {"path": "/@Mil_k_DIVE/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2651041, "client_id": 2550055, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/462c2bbd/uploads/origins/9a6c6d81-0d7