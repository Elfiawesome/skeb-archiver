ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e176391d8ab1b64802d52bb67c9b9f89", "srcset": "https://si.imgix.net/90bf9418/uploads/origins/14e3bb69-6f5c-48c6-a412-bb773599bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e176391d8ab1b64802d52bb67c9b9f89, https://si.imgix.net/90bf9418/uploads/origins/14e3bb69-6f5c-48c6-a412-bb773599bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bc2fed8e85542ea37a2b1afb22ff122 2x, https://si.imgix.net/90bf9418/uploads/origins/14e3bb69-6f5c-48c6-a412-bb773599bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d14f5951d171273148549efac86da3f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90bf9418/uploads/origins/14e3bb69-6f5c-48c6-a412-bb773599bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=876f31817e2e77e2bb74f5bb38ac6c2e", "srcset": "https://si.imgix.net/90bf9418/uploads/origins/14e3bb69-6f5c-48c6-a412-bb773599bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=876f31817e2e77e2bb74f5bb38ac6c2e, https://si.imgix.net/90bf9418/uploads/origins/14e3bb69-6f5c-48c6-a412-bb773599bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=758199cc7cce87eda2404788180c646f 2x, https://si.imgix.net/90bf9418/uploads/origins/14e3bb69-6f5c-48c6-a412-bb773599bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6918724fdcd75553b23bb6e616692372 3x"}, "body": "こんにちは！\n前回リクエストを受けてくださりありがとうございます！\nまた自分のキャラクターを描いていただきたくご依頼させていただきました。\n\nキャラクターの特徴は以下の通りです。\n外見：\n・茶色の燕尾服を纏い、オレンジ色のシャツと紫色のリボンタイを結んでいる。\n・薄紫の長い髪をまとめており、小さな飾り帽子(シルクハット型)を頭につけている。\n・整った顔立ちをしているが目元を仮面で隠している。\n・ファンタジーによく見るようなエルフのように耳が長く尖っている。\n・ギザ歯でニヤリとよく笑っている。\n\n性格面\nオークショニアとして非合法なオークションを取り仕切っていたが、とあることをきっかけに怪人となって復活した。\n初対面やその場限りの関係の人間に対しては友好的・好意的に接するが、長期的な付き合いの人間に対しては本来の性格を隠さず、横柄な態度で厚顔不遜。非常に好戦的で横暴。口調も悪ければ態度も悪い。\n唯一良いのは外面だけかもしれない。\n芝居がかった言い回しやジョークなどを使うこともある。\nプライドは高いが沸点と煽り耐性が低く、喧嘩を売られたと思ったらすぐにキレる。\n見た目が良くセンスもあり、所作が優雅なため、黙っていれば普通に大人っぽい男性。\n\nシチュエーションやシーンはお任せでお願い致します…！\n\n詳細については資料URLのファイルをご参考いただけますと幸いです。\nご検討よろしくお願い致します！\n\nhttps://media-uploader.work/?mode=list&group_key=bc014d77-6ad4-47c1-bb64-2f5700c5252e", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sksm35_d/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1198960, "client_id": 1199708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/918dacda/uploads/origins/4dc7b5f9-4144-4959-b430-e5aa12d4ef44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efaf0ecae66479fdfcbae40478aeb195", "srcset": "https://si.imgix.net/918dacda/uploads/origins/4dc7b5f9-4144-4959-b430-e5aa12d4ef44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efaf0ecae66479fdfcbae40478aeb195, https://si.imgix.net/918dacda/uploads/origins/4dc7b5f9-4144-4959-b430-e5aa12d4ef44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=474f93eed78d1912039b03864792c7dc 2x, https://si.imgix.net/918dacda/uploads/origins/4dc7b5f9-4144-4959-b430-e5aa12d4ef44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc369f90516c884d5026e1336c7b789b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/918dacda/uploads/origins/4dc7b5f9-4144-4959-b430-e5aa12d4ef44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74338c8cde366c1495e4515443d52488", "srcset": "https://si.imgix.net/918dacda/uploads/origins/4dc7b5f9-4144-4959-b430-e5aa12d4ef44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74338c8cde366c1495e4515443d52488, https://si.imgix.net/918dacda/uploads/origins/4dc7b5f9-4144-4959-b43