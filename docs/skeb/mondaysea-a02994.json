ate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1111117, "client_id": 789072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b47f8b261f64216c68159364a421608", "srcset": "https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b47f8b261f64216c68159364a421608, https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e090f8f8ab477bf0fb4e1b6d8dc018ad 2x, https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5b5efbcbad44a92632f11b946c67075 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61d6c28e958adced0f5ca919589aefec", "srcset": "https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61d6c28e958adced0f5ca919589aefec, https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d372045ec96801ae93b2241f913a92c 2x, https://si.imgix.net/6ece32c2/uploads/origins/422f8301-3f42-448c-a29e-051d74cf2d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74db22a5a582f797f99f185b035be201 3x"}, "body": "初めて依頼させていただきます。\n\nラストオリジンのA-1 ブラッディパンサーをお願いします。通常スキンをお願いします。NSFWイラストをお願いします。\n顔とおっぱいがよく見える前または斜めからの構図で、乳首と乳輪は全部出し、\n服装は基本的に脱いでしまっていてよいのですが、上着を羽織っている、ソックスは履いている、といった感じで、全裸ではない、くらいに残っているのが希望です。\n\n\nおっぱいと太ももまたはお尻を両立したものでお願いできればと思います。細かいポーズ、体勢はお任せします。立ち姿でも、座り、開脚、蹲踞、寝そべり等でも大丈夫です。\n\n\n腋毛はなしでお願いします。アンダーヘアは映る描写の場合お任せします。\nその他スキン（服）との兼ね合いはお任せします。ずらし、アクセサリーのみ、パーツが脇に置いてある、等でも大丈夫です。\n\n欲情と興奮が混ざっている、という表情とシチュエーションでお願いしたいのですが、竿役の描写はなし、または最小限にしてください。\nムレ感の描写が強くあると嬉しいです。\nおっぱいと（乳輪と）お尻の大きさはご自身の感覚でお任せで盛っていただければと思います。\n\n可能であれば横長サイズのキャンバスでご製作いただき、差分は描き文字を入れていただく場合、文字なしのものと、ぶっかけ差分（またはおっぱいの間に精液で橋が架かっている描写のもの）があると嬉しいです。\n作業のご都合に合わせていただければと思います。\n\n他、お任せいたします。\nよろしければお願いいたします。\n\nhttps://seesaawiki.jp/lastorigin/d/A-1%20%a5%d6%a5%e9%a5%c3%a5%c7%a5%a3%a5%d1%a5%f3%a5%b5%a1%bc", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mondaysea/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1111117, "client_id": 198849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f511007/uploads/origins/f74df15b-34d3-4631-99bd-3b6a761b4692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f49169541b4ebfb45b9d51bfbb12044b", "srcset": "https://si.imgix.net/8f511007/uploads/origins/f74df15b-34d3-4631-99bd-3b6a761b4692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f49169541b4ebfb45b9d51bfbb12044b, https://si.imgix.net/8f511007/uploads/origins/f74df15b-34d3-4631-99bd-3b6a761b4692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=408376fa11e1916f6bbc3ab840d02c84 2x, https://si.imgix.net/8f511007/uploads/origins/f74df15b-34d3-4631-99bd-3b6a761b4692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05d9217bc1a8779500fafae16c239b23 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f511007/uploads/origins/f74df15b-34d3-4631-99bd-3b6a761b4692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top