compress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=697bae0f35cf78c16e10c27e37a3cd7f 2x, https://si.imgix.net/1f8a4ad3/uploads/origins/f7431852-98a1-4742-95b1-4a8b66038109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f686f777efd57045b4762fdcf59b170 3x"}, "body": "アリスのコアリンク絵が大変素晴らしかったので、依頼させていただきます！\nメインキャラは同じくアリスで、吸収するのはスプリガンとポイです。衣装は指定しませんので、描きやすいようになさってください。\n大まかな流れはシャーロットの時と同じように、尻尾で丸呑みした後にお腹で吸収するというものですが、一点だけ以下のようにしていただけると幸いです。\n最初にポイの頭を尻尾で咥える段階で既にスプリガンはお腹に入れられており、ポイを丸呑みするのと同時進行で吸収されるようにして欲しいです。わかりやすくシャーロットの時のものを用いて説明するならば、資料1の段階で既にお腹が膨れボコボコと揺れており、中にはスプリガンが資料2の状態で収まっていて、そして、資料3と同じくポイの意識が遠のいた所で資料4のようにスプリガンの吸収を開始する、というものです。\n拙い文章ですが、どうかよろしくお願いします。\nこれからも応援しております。\n\n資料1: \nhttps://www.pixiv.net/artworks/90011180#big_1\n資料2:\nhttps://www.pixiv.net/artworks/91030205#big_2\n資料3:\nhttps://www.pixiv.net/artworks/90011180#big_3\n資料4:\nhttps://www.pixiv.net/artworks/91030205#big_4", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mondaysea/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1111117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab639e59230eb8f3c5b74310ee7716a3", "srcset": "https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab639e59230eb8f3c5b74310ee7716a3, https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=384076c582851e781e238e00225f40e6 2x, https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72e91de92936d3d863486497e3b523ae 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e0e5eb64749dd3b8e9cce14a72eba4", "srcset": "https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e0e5eb64749dd3b8e9cce14a72eba4, https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bab50f115c03183baa645c1604e778ba 2x, https://si.imgix.net/b111f046/uploads/origins/c399d083-bbcd-4a59-8565-f8f76fb929c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7f72c0d58f128faf020893cdfc6ac69 3x"}, "body": "ラストオリジンの無敵の龍、ラビアタプロトタイプ、レモネードアルファの3人がhttps://www.pixiv.net/artworks/86111248のような感じでおっぱいをくっつけて並んで立っている絵(ラビアタが真ん中)をお願いします。キャラの間隔は参考画像よりも広めにして、上半身全体と膝上くらいまでを描いて下さい。武装は省略してかまいません。\n\n龍はデフォルトスキンの白スーツでhttps://www.pixiv.net/artworks/91030205の最後の胸に栄養が行ったアリスくらいのおっぱいで胸元を開けて乳輪が見えている、デカケツぶっともも。\nラビアタはデフォルトスキンのメイド服で龍より3回りくらい大きなおっぱい、乳首の形が浮き出て腹肉がたるんでいる(腹肉がおっぱいに隠れてもOKです)、スカートが短くてパンツが見えてる、龍よりさらにデカケツぶっともも。\nレモネードはデフォルトスキンのスーツで龍とラビアタの中間サイズのおっぱいと尻と太もも、ノーパンノーブラで乳輪と大陰唇が見えている。\n一応NSFWを付けていますがラスオリなのでR17.99くらいのギリギリ修正不要な露出でお願いします。\n長文の依頼ですがよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mondaysea/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1111117, "client_id": 564492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c25bc8b/uploads/origins/75af5e7a-a150-4cc1-b9b6-055ffd2a0130?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb981527d165e51d55b6ba4981d0a824", "srcset": "http