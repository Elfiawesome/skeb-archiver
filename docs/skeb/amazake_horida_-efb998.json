re": true}, {"path": "/@amazake_horida_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3025804, "client_id": 175414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a95b2098458f7024aa5c1bb522db218", "srcset": "https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a95b2098458f7024aa5c1bb522db218, https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6594130311d240fc2ae7d21fde764c6f 2x, https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b01471c89c3ce3209c8629ebb067b5c0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5168ed8c60e33628cc095cd9a0104a62", "srcset": "https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5168ed8c60e33628cc095cd9a0104a62, https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebaed8964d5db21d1592add6824c3d12 2x, https://si.imgix.net/1aa78e6b/uploads/origins/57cb3d64-d241-458a-99c5-90ffa3208bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38ba77a68d3058676b94b72eb18b130a 3x"}, "body": "こんにちはです。\nうちの子のメガミラを描いていただくリクエストします。\n\n特徴として以下の内容です。\n身長500cm （今も成長中）\n22歳\n・牛の角と耳と尻尾が生えているメイド。\n・目の色は赤色で、ヤギ目。片目隠れ\n・白い髪でロングヘア、丸メガネをしており大きい黒リボンを付けている。\n・胸の大きさはへそが隠れるほど大きく、下半身もとても大きい（太腿の太さが一般市民の横幅よりもでかい）\n・一人称は私で臆病、オバケが苦手。\n・メイド衣装はロングスカートのものを着用、胸の関係で上のボタンは外している。（ボタンはギリギリ耐えている）\n・腰辺りにポーチを付けており、成長を抑えるための薬を常備している。\n・無限に成長し続けているため薬を毎日飲んでいる。忘れると体が大きくなり続ける。\n・赤いものを見ると興奮してしまい対象に突撃をする。\n・とても力が強い\n・角は通常白だが、感情に応じて色が変わる\n\n・シチュエーションはお任せします。\n・いろんなメイド服がある設定なので資料のメイド服にアレンジが入っても問題ありません。（露出があまりにも多すぎるのは無しでお願いします。）\n・胸はどんなに盛っても良いです。（大きければ大きいほど良い）\n・身長もどんなに大きくしても良いです(大陸サイズ、惑星サイズでも可)\n以下任意\n・大きいので比較としてモブキャラか建造物等がいると良いです。\n\n描いた頂いた絵は資料として使わせていただいたり、\nSNSに載せます。\n\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1EEjl94BygCO4uzS--Qb8E1hGUlDu0qA0", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 15236, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "💎 10電 💎", "screen_name": "10den", "avatar_url": "https://pbs.twimg.com/profile_images/1874774282414485504/1zb1tL16.jpg", "header_url": "https://pbs.twimg.com/profile_banners/739621042138714112/1735884913/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 33}, {"id": 259163, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ブロンガーカイブ公式", "screen_name": "Z17dXSJLyV0POKr", "avatar_url": "https://pbs.twimg.com/profile_images/1352822786641674240/fJDpS2Tx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/881823339928354816/1737381270/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49