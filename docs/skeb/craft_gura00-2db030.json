200&s=ed86ec96ad3a2cbd449c7087ec2cb111", "srcset": "https://si.imgix.net/55ed65c7/uploads/origins/3c501c91-220f-407d-8ce1-9f7b123d7fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed86ec96ad3a2cbd449c7087ec2cb111, https://si.imgix.net/55ed65c7/uploads/origins/3c501c91-220f-407d-8ce1-9f7b123d7fec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a81ab4ef7fb35c0828340a0ce6d9075 2x, https://si.imgix.net/55ed65c7/uploads/origins/3c501c91-220f-407d-8ce1-9f7b123d7fec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9353ecde683ba4a98023070bdf2810e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55ed65c7/uploads/origins/3c501c91-220f-407d-8ce1-9f7b123d7fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e26b3f87460002eb2b5da29ab7755805", "srcset": "https://si.imgix.net/55ed65c7/uploads/origins/3c501c91-220f-407d-8ce1-9f7b123d7fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e26b3f87460002eb2b5da29ab7755805, https://si.imgix.net/55ed65c7/uploads/origins/3c501c91-220f-407d-8ce1-9f7b123d7fec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12a5ddb09809afe045afc4a6d430b51e 2x, https://si.imgix.net/55ed65c7/uploads/origins/3c501c91-220f-407d-8ce1-9f7b123d7fec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e980deaffcbeed3b3cdf6ac495ec9c53 3x"}, "body": "Skebの新着からフォローさせていただいていました。\n此度はもしよろしければ……一つ私の創作の女の子にソチラの考案する蟲を当て……苗床にしてほしいと思っています。\n構図などはあまり指定しませんが……資料通りとても大きな胸をもっています。\nですので搾乳をはじめとした乳責めを採用して頂けたらと思っています。\n\n蟲は基本的にそちらの自由にと思っていますが\n迷われた場合は……今回は蝿、蛆虫で提案しておきます。\n\n以下は参考程度に……\n\nうちの子：シーナ\n性格：母性的で寛容、エッチ大好きな淫乱、蟲などの異種の事も好き\n体質：母乳体質、全身性感帯\n身長：143\n\n胸の大きさは大きすぎる！と言うときは描ける範囲の巨乳にしていただいて結構です。\nご一考のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ymeYfQQ0EVn8ZVz0WIL9m9qg2ddCCU_a?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@craft_gura00/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2787323, "client_id": 121946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f509e98d560ef1873a7a1eff6ce5ce", "srcset": "https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f509e98d560ef1873a7a1eff6ce5ce, https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f532947c5ac48a8f60938115f3584785 2x, https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8dea9dedd9c16d9675f3d5a3c630925 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e30b66d2bb69a040cf0f1d3c1d731730", "srcset": "https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e30b66d2bb69a040cf0f1d3c1d731730, https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a3bc414a355d740f45f641509946b2e 2x, https://si.imgix.net/e3fdc8e5/uploads/origins/6c2c20f2-293a-4bd7-be2e-739679c353fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23ad494caff6e7b547e31452fb721c5e 3x"}, "body": "大まかな内容：\n寄生虫に寄生された蟲と性交をして\n子宮の内側に寄生虫の幼虫を植え付けるように\n子宮の中に幼虫を産み付けられる。\n\nその後、産卵管を抜いた後に\nまた子宮の内側を幼虫が噛みついたり\n暴れたりしてから出産する。\n\nもし可能でしたら蟲研究レポートNo.4であった\n耳クチュも出来そうでしたらお願い致します。\n\n①キャラ：\n医伯さん\n\n②竿役：\nカメレオウォスプ(下URL先画像1,2枚目\nもしくは寄生虫イメージの元のヘビトンボでお願いします。\n・カメレオウォスプ　https://twitter.com/onvivi_/status/1153835015987314688?t=zJjtvC6NGbaQTiqNjbXxuA&s=19\n・ヘビトンボ\nhttps://pet-dictionary.net/archives/3545\n\n寄生虫のイメージ(孫太郎虫)\n下記URLの幼虫を白く寄生虫っぽくしたものをお願いします。\n(蟲研究レポート_No.10の精前虫で書こうとしていたので\n精前虫を短めにして刺々しくしたような虫でお願いします)\nhttps://amanaimages.com/info/infoRM.aspx?SearchKey=32146000070\n\n上記の二つはあくまで大まかなイメージですので、\nお好きなように改造して頂いて大丈夫です。\n\n③構図について：\n蟲研究レポートNo.4 sep.07~10\n(サイトの画像だと4~6枚目)\nhttps://www.fanbox.cc/@guracraft00/posts/6178393\nのような後ろから蟲が女の子に組み付いた構図でお願いします。\n\n⑤服装：\n可能でしたら白衣半脱ぎで裸白衣で\nおっぱいは見えるようにお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@craft_gura00/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/45e69006/uploads/origins/f23c8765-72f9-46f2-b651-51db338a7d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5d6e1594b18884c4e5f1d7a85bfa48b", "srcset": "https://si.imgix.net/45e69006/uploads/origins/f23c8765-72f9-46f2-b651-51db338a7d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5d6e1594b18884c4e5f1d7a85bfa48b, https://si.imgix.net/45e69006/uploads/origins/f23c8765-72f9-46f2-b651-51db338a7d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6fcbc972e21981e787645fc65c86cbfc 2x, https://si.imgix.net/45e69006/uploads/origins/f23c8765-72f9-46f2-b651-51db338a7d5d?bg=%23fff&auto=format%2Ccompress&fm=webp&d