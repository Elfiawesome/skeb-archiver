4f-a525-3600d9ea7b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee25e54d558994858816144204c1d7d 2x, https://si.imgix.net/01a191e9/uploads/origins/1cf7da76-268b-4e4f-a525-3600d9ea7b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b8535e5434bbc9113a9e611a5449d2a 3x"}, "body": "いつも素敵な作品ありがとうございます。\n毎回濡らしながら楽しませて頂いてるので今回はリクエストしにきました。\n\nキャラ　主任さん\n蟲　特殊な寄生虫に寄生されてるゴキブリ(二の腕サイズ)\n\n女性の両穴と乳腺に寄生して繁殖するハリガネムシ状の寄生虫が寄生経路としてゴキブリに寄生して女性を襲うと報告が上がり。\nその研究の被検体になる主任さんという流れでお願いします。\n\n衣服を脱ぎ、迫りくる4匹のゴキブリに体を差し出す主任さん。　\n鈴口から寄生虫がうぬうねとはみ出したゴキペニスに両穴と両乳首を凌辱され、快楽から悦びを感じ、ゴキブリ精液と共に寄生虫を注がれ。\n子宮、直腸、乳腺全てに無数の寄生虫が寄生、数日後にはお腹も胸も膨れ上がり常に寄生虫の幼体をポトポトと産み落とす姿をしっかり記録。\n\nと言う感じです。\n暫く他の蟲と交尾できないかも…と言うくらいに身体占拠されてる主任さんがみたいです！！！よろしくお願いします！！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@craft_gura00/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b412ec33/uploads/origins/08f497a8-5866-4cb3-9d02-6348aa299b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08861157e0d29a68616f7b9792704e2e", "srcset": "https://si.imgix.net/b412ec33/uploads/origins/08f497a8-5866-4cb3-9d02-6348aa299b59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08861157e0d29a68616f7b9792704e2e, https://si.imgix.net/b412ec33/uploads/origins/08f497a8-5866-4cb3-9d02-6348aa299b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=716a553c4459939fbb266826c203a286 2x, https://si.imgix.net/b412ec33/uploads/origins/08f497a8-5866-4cb3-9d02-6348aa299b59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=acc2556e68c950577126e20a71b94107 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2787323, "nc": 161}, {"path": "/@craft_gura00/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2787323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a88311144395f049cd96f3a451b53bc", "srcset": "https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a88311144395f049cd96f3a451b53bc, https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b7eeedd528cbacc62f89ae49cc663ba 2x, https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e2cd8f7266f5ae73306bc8fb7b27978 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fce4d363e8042203244a910b434acc5f", "srcset": "https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fce4d363e8042203244a910b434acc5f, https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da573be7e2c2eb1281d46045842c7ac3 2x, https://si.imgix.net/18e0d2a8/uploads/origins/17bd3f3d-f42d-47af-9310-27060ff20689?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=007c8de9e4c3c7850bdd8e6d35163462 3x"}, "body": "シチュエーション：\nエルフ魔法使いが知らぬうちにワーム系の寄生虫に膣から侵入され、\n子宮内で成長、子宮を変質させられて魔力を吸われる。\nエルフ魔法使いは徐々に魔法が使えなくなる。\n\nキャラクター：\nエルフの魔法使いな冒険者。他者より魔力が高くて調子に乗っているタイプでお願いします。\n\n虫：\nワーム系統の虫であれば形状は問いません。\n生態としては膣から子宮内に侵入し、子宮に憑りついて宿主の魔力を吸いながら成長していきます。\n宿主に排除されないよう、痛みや快楽は与えません。\n\n構図：\n左右どちらかにエルフの全体像、もう片側に膣と子宮、寄生虫の構図を侵食度合い毎の変化差分でお願いします。\nエルフのポーズなどの差分形式はお任せします。表情やセリフのみの差分でも構いません。\n①と③を優先、②は金額に余裕があればで構いません。金額不足であれば②をカット、もしくはキャンセルください。\n\n①：子宮浸食度0％、膣内を徐々に子宮に向かうワーム。気づいていないエルフは自分の魔力の強さに調子に乗っている。\n\n②：子宮浸食が進んでいる。（浸食％の度合い、それによる差分枚数はお任せします。）浸食された部位はピンクから紫になり、変形変質していくイメージです。エルフは魔力に不調を感じています。\n\n③：子宮浸食度100％、完全に変質した子宮の中で大きく育ったワーム。エルフは魔法がほぼ使えなくなって恐怖しています。\n\nよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@craft_gura00/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2787323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fdf5203f5bb96f106aeb0ecc520542a", "srcset": "https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fdf5203f5bb96f106aeb0ecc520542a, https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a79c94c66a594952e3637abfda61c121 2x, https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dac67e37955b36f4524617e088b193a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40a65da5dbe402a8d9f3d9bbbc9c5d24", "srcset": "https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40a65da5dbe402a8d9f3d9bbbc9c5d24, https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=353224f1c4d510acfbc99036f6dd99fe 2x, https://si.imgix.net/075a111a/uploads/origins/d01ff0c2-6624-4188-809b-a7a8182fe90e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=039a578e3ea3ef3073279797b4ccf4f2 3x"}, "body": "はじめまして。\n少年の被験者が、多目的用ゴキブリを体験しているところを研究レポートの流れでお願いします。\n全身に這い回られて感じさせられた後、ペニスを刺激されて射精してしまう感じです。\nよろしくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@craft_gura00/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/501cb4f4/uploads/origins/36221ae5-6858-4176-9aef-1426c60bc139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d20f995420d6596088163d0ea792fdd", "srcset": "https://si.imgix.net/501cb4f4/uploads/origins/36221ae5-6858-4176-9aef-1426c60bc139?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d20f995420d6596088163d0ea792fdd, https://si.imgix.net/501cb4f4/uploads/origins/36221ae5-6858-4176-9aef-1426c60bc139?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c757554e97a53cb397ff00adc12bc75 2x, https://si.imgix.net/501cb4f4/uploads/origins/36221ae5-6858-4176-9aef-1426