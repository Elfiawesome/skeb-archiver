\u30d7\u30ea\u3067\u914d\u4fe1\u3092\u3057\u3066\u3044\u308bkuro\u3068\u7533\u3057\u307e\u3059\u3002\n\nhttps://mobile.twitter.com/96__kuro__\n\n\u30ea\u30f3\u30af\u306e\u7d75\u3092\u62dd\u898b\u3055\u305b\u3066\u9802\u304d\u3001\u3068\u3066\u3082\u60f9\u304b\u308c\u307e\u3057\u305f\uff01\uff01\n\nhttps://twitter.com/yin_yang6/status/1484513803731890181?s=21\nhttps://twitter.com/yin_yang6/status/1452300705188876289?s=21\n\n\u305d\u3053\u3067\u3001\u914d\u4fe1\u6642\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u80cc\u666f\u3068\u3057\u3066\u767a\u9175\u30c1\u30fc\u30ba\u304f\u3093\u3055\u3093\u306e\u7d75\u3092\u4f7f\u7528\u3055\u305b\u3066\u9802\u304d\u305f\u3044\u3068\u601d\u3044\u4f9d\u983c\u3055\u305b\u3066\u9802\u304d\u307e\u3059\u3002\n\n\u9aea\u578b : \u30bb\u30f3\u30bf\u30fc\u30d1\u30fc\u30c8\u3067\u7247\u8033\u304c\u51fa\u3066\u3044\u308b(2\u679a\u76ee\u306e\u3088\u3046\u306a\u611f\u3058)\n\n\u8868\u60c5 \u30fb\u96f0\u56f2\u6c17\n24\u6b73\u306a\u306e\u3067\u3001\u5c11\u3057\u5927\u4eba\u3073\u305f\u611f\u3058\n\u6c17\u3060\u308b\u305d\u3046\u306b\u7b11\u3063\u3066\u3044\u308bor\u30ea\u30f3\u30af1\u679a\u76ee\u306e\u3088\u3046\u306a\u8868\u60c5\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\u5dee\u5206\u304c\u3042\u308b\u3068\u51c4\u304f\u5b09\u3057\u3044\u3067\u3059\u2026\n\n\u670d : \u7de9\u3081\u306e\u30b5\u30a4\u30ba\u611f\u3067\u7740\u7528\u3057\u3066\u3044\u308b\u611f\u3058\u304c\u3044\u3044\u3067\u3059\u3002\u4e0a\u7740\u306b\u9ec4\u8272\u3092\u5165\u308c\u3066\u6b32\u3057\u3044\u3067\u3059\u3002\n\u30c7\u30b6\u30a4\u30f3\u306f\u304a\u4efb\u305b\u81f4\u3057\u307e\u3059\u3002\n\n-\u5c0f\u7269-\n\u30fb\u4eba\u5dee\u3057\u6307\u3068\u5c0f\u6307(\u53c2\u8003\u753b\u50cf\u306e\u30ea\u30f3\u30af\u3092\u8cbc\u3089\u305b\u3066\u9802\u304d\u307e\u3059)\u306b\u30ea\u30f3\u30b0\n\u30fb\u9ec4\u8272\u3044\u30d1\u30c3\u30b1\u30fc\u30b8\u306e\u30a2\u30e1\u30ea\u30ab\u30f3\u30b9\u30d4\u30ea\u30c3\u30c8(\u30bf\u30d0\u30b3)\u3068\u30de\u30c3\u30c1\u3092\u7d75\u306e\u3069\u3053\u304b\u306b\u5165\u308c\u3066\u9802\u304d\u305f\u3044\u3067\u3059(\u4f8b:\u30ba\u30dc\u30f3\u306e\u30dd\u30b1\u30c3\u30c8\u304b\u3089\u843d\u3061\u305f\u4f4d\u7f6e\u3001T\u30b7\u30e3\u30c4\u306e\u80f8\u30dd\u30b1\u30c3\u30c8\u7b49\u2026)\n\u30fb\u30ea\u30f3\u30af2\u679a\u76ee\u306e\u3088\u3046\u306b\u30ea\u30f3\u30b0\u306e\u4ed8\u3044\u305f\u624b\u3067\u30b3\u30fc\u30d2\u30fc\u3092\u6301\u305f\u305b\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\n\u30fb\u30d4\u30a2\u30b9\u7b49\u4ed6\u30a2\u30af\u30bb\u306f\u6709\u7121\u3082\u542b\u3081\u304a\u4efb\u305b\u3057\u307e\u3059\n\n\u80cc\u666f : \u671d\u3092\u9023\u60f3\u3059\u308b\u69d8\u306a\u30a4\u30e1\u30fc\u30b8\n\n\u69cb\u56f3 : \u304f\u3064\u308d\u3044\u3067\u3044\u308b\u69d8\u306a\u63cf\u5199\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\u55ab\u7159\u3057\u3066\u3044\u308b\u304b\u3057\u3066\u3044\u306a\u3044\u304b\u306f\u304a\u4efb\u305b\u81f4\u3057\u307e\u3059\n\n\u30b5\u30a4\u30ba\n\u6a2a:1080 \u00d7 \u7e26:1920\u3060\u3068\u52a9\u304b\u308a\u307e\u3059\n(\u30b9\u30de\u30db\u8868\u793a\u306e\u70ba\u3001\u7e26\u306b\u3086\u3068\u308a\u304c\u6b32\u3057\u3044\u3067\u3059)\n\n\u30c7\u30fc\u30bf\npsd\n\n\u7d30\u3005\u3068\u8981\u671b\u3057\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u304c\u2026\u7b2c1\u306b\u767a\u9175\u30c1\u30fc\u30ba\u304f\u3093\u3055\u3093\u306e\u63cf\u304b\u308c\u308b\u7d75\u304c\u597d\u304d\u306a\u306e\u3067\u3001\u3042\u304f\u307e\u3067\u63cf\u304f\u969b\u306e\u76ee\u5b89\u7a0b\u5ea6\u306b\u3057\u3066\u9802\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\n\u914d\u4fe1\u6642\u3001\u30a2\u30ab\u30a6\u30f3\u30c8\u540d\u306f\u660e\u8a18\u3055\u305b\u3066\u9802\u304d\u307e\u3059\u3002\n\u914d\u4fe1\u6642\u306f\u30e1\u30c3\u30bb\u30fc\u30b8\u306a\u3057\u3092\u4f7f\u308f\u305b\u3066\u9802\u3053\u3046\u3068\u601d\u3046\u306e\u3067\u3001\u30ec\u30a4\u30e4\u30fc\u3067\u5206\u3051\u3066\u9802\u3051\u308b\u3068\u52a9\u304b\u308a\u307e\u3059\u3002(\u7121\u3057\u3067\u3082\u69