//www.pixiv.net/artworks/107402745\n\nミル・ホルスタインの衣装は資料URLにある七福姫バージョンSRのもので\n等身はウシに合わせて3頭身くらいにするか原作通りの頭身にするかはそちらが描きやすい方でお願いします。\nマシンデザインもそちらにおまかせします。\n\n背景は簡易的なものでいいので\n・道路は灰色(アスファルト色)か土色\n・道路の外側は緑色(雑草のイメージ)\n・空は昼～夕までのイメージで青、水色、夕暮れのどれか\nでお願いします。\n\nポーズ等その他のシチュエーション等はそちらにお任せしますが「〇〇さんへ」等の表記は無しでお願いします。\n衣装は細かい部分の省略、アレンジOKです。\n内容が細かいので料金が不足しているなら再送要請を、難しそうならキャンセルをお願いします。\n\nhttps://seesaawiki.jp/uchi_hime/d/%28%C2%E7%B9%F5%C5%B7%29%C6%FD%B6%C8%C9%B1%20%A5%DF%A5%EB%A1%A6%A5%DB%A5%EB%A5%B9%A5%BF%A5%A4%A5%F3", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@modeler3622/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1675652, "client_id": 2939188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e5e84a9/uploads/origins/a88703e5-0310-4109-9b6a-7399c6cb25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bc1e399536142306152ec6c01fefd56", "srcset": "https://si.imgix.net/9e5e84a9/uploads/origins/a88703e5-0310-4109-9b6a-7399c6cb25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bc1e399536142306152ec6c01fefd56, https://si.imgix.net/9e5e84a9/uploads/origins/a88703e5-0310-4109-9b6a-7399c6cb25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8c9e5119c236ca0add4c2e886bbf3e4 2x, https://si.imgix.net/9e5e84a9/uploads/origins/a88703e5-0310-4109-9b6a-7399c6cb25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0508c981f59376064ef866fa151370e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e5e84a9/uploads/origins/a88703e5-0310-4109-9b6a-7399c6cb25a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=837a63f35e2a36e228d6d668861ea4e2", "srcset": "https://si.imgix.net/9e5e84a9/uploads/origins/a88703e5-0310-4109-9b6a-7399c6cb25a9?bg=%23