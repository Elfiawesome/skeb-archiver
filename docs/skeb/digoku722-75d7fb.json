7\u3051\u308c\u3070\u3001\u79c1\u306eVTuer\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u982d\u306e\u4e0a\u306b\u5927\u304d\u306a\u30ec\u30c9\u30fc\u30e0\u3092\u642d\u8f09\u3057\u3066\u3044\u308b\u9752\u808c\u306e\u5e7c\u3044\u30ed\u30dc\u30c3\u30c8\u3067\u3059\u3002\n\u76ee\u306e\u4e0b\u306b\u30ed\u30dc\u30c3\u30c8\u7279\u6709\u306e\u30d1\u30fc\u30c6\u30a3\u30af\u30eb\u30e9\u30a4\u30f3\u304c\u3042\u308a\u3001\u53f3\u982c\u306b\u306f\u301002\u3011\u306e\u6587\u5b57\u304c\u523b\u307e\u308c\u3066\u3044\u307e\u3059\u3002\n\u97f3\u697d\u304c\u597d\u304d\u3067\u3001\u4e21\u8033\u306b\u306f\u30d8\u30c3\u30c9\u30db\u30f3\u3001\u8170\u306b\u306f\u30b9\u30d4\u30fc\u30ab\u30fc\u3092\u88c5\u5099\u3057\u3066\u3044\u307e\u3059\u3002\n\u203b\u6ce8\u610f\u3000Phonon\u306b\u306f\u7709\u6bdb\u304c\u306a\u304f\u3001\u80f8\u306f\u8ca7\u4e73or\u307a\u305f\u3093\u3053\u3068\u3057\u3066\u63cf\u3044\u3066\u9802\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\n\u76ee\u306f\u30ab\u30e1\u30e9\u30a2\u30a4\u3001\u9aea\u306a\u3069\u3082\u30e1\u30ab\u8cea\u611f\u306b\u3057\u3066\u9802\u304f\u306a\u3069\u3001\u30ed\u30dc\u30c3\u30c8\u611f\u3092\u5f37\u304f\u3057\u3066\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u307e\u305f\u3001\u76ee\u3084\u30de\u30bc\u30f3\u30c0\u8272\u306e\u90e8\u5206\u306f\u5149\u3063\u3066\u3044\u308b\u3088\u3046\u306a\u611f\u3058\u306b\u3057\u3066\u9802\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\uff08\u30e1\u30ab\u95a2\u7bc0\u30d5\u30a7\u30c1\u306a\u70ba\u3001\u30ed\u30dc\u30d0\u30ec\u5927\u6b53\u8fce\u3067\u30b7\u30ea\u30f3\u30c0\u30fc\u3084\u914d\u7dda\u306a\u3069\u5185\u90e8\u69cb\u9020\u304c\u898b\u3048\u308b\u3068\u66f4\u306b\u5b09\u3057\u3044\u3067\u3059\u3002\uff09\n\uff08\u30e1\u30ab\u30d0\u30ec\u306f\u66b4\u529b\u7684\u8868\u73fe\u3068\u6349\u3048\u3089\u308c\u3066\u3057\u307e\u3046\u53ef\u80fd\u6027\u3092\u8003\u3048\u3001\u5ff5\u306e\u305f\u3081NSFW