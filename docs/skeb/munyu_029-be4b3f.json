it=crop&crop=top&w=200&h=200&s=2168e3c4d86c03fca3163452f176f095 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01ed04c6/uploads/origins/952004c1-707e-4fc2-8a73-a9bba5e924cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4837593f1a6d05d712028e713b11b70", "srcset": "https://si.imgix.net/01ed04c6/uploads/origins/952004c1-707e-4fc2-8a73-a9bba5e924cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4837593f1a6d05d712028e713b11b70, https://si.imgix.net/01ed04c6/uploads/origins/952004c1-707e-4fc2-8a73-a9bba5e924cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b023d71a9ee63d580488c8f30ea54f4 2x, https://si.imgix.net/01ed04c6/uploads/origins/952004c1-707e-4fc2-8a73-a9bba5e924cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0895a3e106ee5609176bfb7163c169cb 3x"}, "body": "こんにちは！あなたの画風はとても可愛いです！ウサギ系VTuberのキキ・ピョンピョンを描いていただけませんか？キキはとても内気で愛情深く、最近は特に身体作りに力を入れています！エクササイズマットの上でストレッチするのがお気に入りです。重要なディテールは、頭のクローバー、ウサギの耳と尻尾、青い瞳、そしてサイズです。 身長は約144cmで、体型はとてもスリムです。人間の耳はありません。以下に、ジムウェア姿とストレッチポーズの参考画像があります。https://drive.google.com/file/d/1o_q7Aj_1dOWreRMtR0J57iOg8LHXZwa4/view?usp=sharing\nhttps://drive.google.com/file/d/1r6D0m1Iybpug54p28VJlLT-qU9oBYib4/view?usp=sharingエクササイズマットの上で、お好きな背景と共に彼女を描いてください。この作品はSNSやYouTubeサムネイルで使用される可能性があります。可能であれば、透明背景バージョンも追加していただけると幸いです。どうぞよろしくお願いいたします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@munyu_029/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3621341, "client_id": 3616174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c85c5788/uploads/origins/fdc43f71-474f-481d-9cc2-11f240122606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c24c8340ac5cce6ff99ed5732e9ba