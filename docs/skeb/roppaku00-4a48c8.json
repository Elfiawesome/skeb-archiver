u304d\u7d9a\u304d\u30e9\u30a4\u30b9\u30b7\u30e3\u30ef\u30fc\u3001\u30df\u30db\u30ce\u30d6\u30eb\u30dc\u30f3\u3067gaze on me\u8863\u88c5\u306b\u88f8\u8db3\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002 \n\u25ce\u30b9\u30c8\u30fc\u30ea\u30fc\n\u24602\u4eba\u306f\u30c0\u30f3\u30b9\u30ec\u30c3\u30b9\u30f3\u4e2d\u306b\u30e2\u30d6\u30a6\u30de\u5a18\u9054\u304c\u30c8\u30ec\u30bb\u30f3\u5b66\u5712\u306e\u3069\u3053\u304b\u306b\u3042\u308b\u58c1\u306b\u958b\u3044\u3066\u308b\u7a74\u306f\u30a6\u30de\u5a18\u4ed9\u4eba\u306e\u4e16\u754c\u306b\u7e4b\u304c\u3063\u3066\u3044\u3066\u305d\u306e\u7a74\u306b\u4e21\u8db3\u3092\u5165\u308c\u4eee\u7720\u3092\u53d6\u308b\u3068\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u7206\u4e0a\u304c\u308a\u3059\u308b\u3068\u3044\u3046\u7a74\u304c\u3042\u308b\u3068\u3044\u3046\u90fd\u5e02\u4f1d\u8aac\u3092\u805e\u304d\u307e\u3059\u3002\u3000\n\u2461\u30c0\u30f3\u30b9\u30ec\u30c3\u30b9\u30f3\u304c\u7d42\u308f\u308a2\u4eba\u306f\u30c8\u30ec\u30fc\u30ca\u30fc\u5ba4\u306e\u6a2a\u306b\u3042\u308b\u4eee\u7720\u5ba4\u3067\u30d9\u30c3\u30c9\u306b\u5bdd\u8ee2\u3073\u4f11\u61a9\u3092\u3057\u3066\u3044\u308b\u3068\u58c1\u306b\u4e21\u8db3\u3092\u5165\u308c\u308c\u308b\u7a0b\u306e\u7a74\u304c\u3042\u308b\u306e\u306b\u6c17\u4ed8\u304d\u307e\u3059\u3000\n\u24622\u4eba\u306f\u90fd\u5e02\u4f1d\u8aac\u3092\u601d\u3044\u51fa\u3057\u3053\u306e\u7a74\u304c\u305d\u308c\u3060\u30682\u4eba\u306f\u601d\u3044\u307e\u3059\u3002\u3082\u3057\u81ea\u5206\u9054\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u304c\u7206\u4e0a\u304c\u308a\u3057\u305f\u3068\u3057\u305f\u3089\u30c8\u30ec\u30fc\u30ca\u30fc\u304c\u559c\u3076\u3060\u308d\u306a\u3041\u3068\u601d\u3044\u6050\u308b\u6050\u308b2\u4eba\u306f\u7a74\u306b\u4e21\u8db3\u3092\u5165\u308c\u3066\u4ef0\u5411\u3051\u306b\u5bdd\u8ee2\u3073\u4eee\u7720\u3092\u53d6\u308a\u307e\u3059\u3002\u3000\n\u2463\u5834\u9762\u306f\u5909\u308f\u308a\u96a3\u306e\u30c8\u30ec\u30fc\u30ca\u30fc\u5ba4\u306b\u623b\u3063\u3066\u6765\u305f\u30c8\u30ec\u30fc\u30ca\u30fc\u306f\