cc1\u306a\u3069\u306f\u304a\u4efb\u305b\n\u6599\u91d1\u306e\u7bc4\u56f2\u3067\u80cc\u666f\u3092\u63cf\u5199\u3067\u304d\u308b\u306e\u3067\u3042\u308c\u3070\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u4f7f\u7528\u7528\u9014\n\u500b\u4eba\u89b3\u8cde\u3001\u30a2\u30af\u30b9\u30bf\u306b\u3057\u3066\u98fe\u308a\u305f\u3044\u3068\u8003\u3048\u3066\u3044\u307e\u3059\n\n\u5f62\u5f0f\nPSD\u304c\u3042\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u80cc\u666f\u304c\u3042\u308c\u3070\u3001\u80cc\u666f\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u5206\u3051\u3066\u7d0d\u54c1\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\u30b0\u30c3\u30ba\u306b\u3057\u305f\u3044\u306e\u3067\u3001\u30b5\u30a4\u30ba\u306f2000\u00d72000px\u307b\u3069\u3092\u5e0c\u671b\u3057\u307e\u3059\u3002\u4e0a\u4e0b\u3057\u3066\u3082\u69cb\u3044\u307e\u305b\u3093\u3002\n\u30ad\u30e3\u30f3\u30d0\u30b9\u6bd4\u7387\u306f\u304a\u4efb\u305b\u3067\u3059\u3002\n\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\n\u30e1\u30ea\u30fc\u30b4\u30fc\u30e9\u30f3\u30c9\u306e\u30e6\u30cb\u30b3\u30fc\u30f3\u306e\u64ec\u4eba\u5316\u306e\u30db\u30eb\u30f3\u3067\u3059\u3002\n\u5ec3\u5712\u3057\u305f\u904a\u5712\u5730\u306b\u3044\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3067\u3001\u304a\u5ba2\u3055\u3093\u304c\u6765\u306a\u3044\u3053\u3068\u3092\u60b2\u3057\u3093\u3067\u3044\u308b\u73fe\u5b9f\u306e\u59ff\u3068\u304a\u5ba2\u3067\u306b\u304e\u308f\u3063\u305f\u6642\u4ee3\u306b\u99b3\u305b\u308b\u5922\u306e\u4e16\u754c\u306e\u59ff\u304c\u3042\u308a\u307e\u3059\u3002\n\u4e09\u9762\u56f3\u304c\u306a\u304f\u3066\u7533\u3057\u8a33\u306a\u3044\u3067\u3059\u304c\u3001\u308f\u304b\u308b\u7bc4\u56f2\u3067\u63cf\u5199\u3057\u3066\u3044\u305f\u3060\u304f\u5f62\u3067\u5927\u4e08\u592b\u3067\u3059\u3002\n\u670d\u88c5\u306f\u30a2\u30ec\u30f3\u30b8\u3001\u5909\u66f4\u3057\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\n\u8a2d\u5b9a\u3082\u3042\u307e\u308a\u6c17\u306b\u3057\u306a\u304f\u3066\u3082\u5927\u4e08\u592b\u3067