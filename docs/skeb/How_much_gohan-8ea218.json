rop=top&w=200&h=200&blur=200&s=5565a2fb3b4a5e3e8e7e4415e5169a3f, https://si.imgix.net/a713a20c/uploads/origins/4d829720-4aa9-4d1d-8bac-e44362e22f36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12feb4f89c0db2dde87387df96172451 2x, https://si.imgix.net/a713a20c/uploads/origins/4d829720-4aa9-4d1d-8bac-e44362e22f36?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0786f5e7d379d20e9f9913480b49a044 3x"}, "body": "Hi Mira! & thank you for your hard work!\n\nI would like to ask Mira-san to draw my three OC artists as soon as possible!\n\nI would like to see Patrienne, a bright painter, Litelina, a taciturn literary girl, and Silver Symphony, a mature musician, in your drawing! You may add your own arrangement.\n\nPoses are free. Since they are artists, we would be more than happy if you could add some western elements (western decorations, items, etc.) in addition to the characters.\n\nThis is my second request, and I look forward to working with you!\n\nhttps://drive.google.com/drive/u/3/folders/1LPhG0f9h1H0QZI4StEOMwzsQ_WL89BtK", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@How_much_gohan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2629190, "client_id": 1630619, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4829df69/uploads/origins/4a3d6f7d-b916-49e4-b85a-ac7b3d169bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=decf680b395cf1d301a1063ae7b1b075", "srcset": "https://si.imgix.net/4829df69/uploads/origins/4a3d6f7d-b916-49e4-b85a-ac7b3d169bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=decf680b395cf1d301a1063ae7b1b075, https://si.imgix.net/4829df69/uploads/origins/4a3d6f7d-b916-49e4-b85a-ac7b3d169bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d1a675ecc10db