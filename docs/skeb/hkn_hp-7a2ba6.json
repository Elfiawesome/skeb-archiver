)。表はクールと無口、裏は照れ屋さんの性格です。いつも他の人に世話を焼かれるのでなんか面倒くさいな人。耳の飾りは左耳の方だけに付けてお願い致します。\n\n可能ならば、この2人で狐のモチーフを入れて、一枚のイラストをお願い致します。明るい雰囲気で描いて頂ければ大変嬉しいです。その他のポーズや構図などはほし様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zme8Lu3By7Ay44m-CSSQKymAQRRT0M-a?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hkn_hp/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1881843, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6eb9e1e5/uploads/origins/c5049c9e-0db1-4e0e-8644-8e06a417dfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e631c45fb5a260e79899ae5a520831a3", "srcset": "https://si.imgix.net/6eb9e1e5/uploads/origins/c5049c9e-0db1-4e0e-8644-8e06a417dfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e631c45fb5a260e79899ae5a520831a3, https://si.imgix.net/6eb9e1e5/uploads/origins/c5049c9e-0db1-4e0e-8644-8e06a417dfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=972919d993e8e74fde8320d05c39e337 2x, https://si.imgix.net/6eb9e1e5/uploads/origins/c5049c9e-0db1-4e0e-8644-8e06a417dfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=759fd9542d7b21abe79a051def043131 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6eb9e1e5/uploads/origins/c5049c9e-0db1-4e0e-8644-8e06a417dfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82a2d9225d8ca2322b4bbe2260d6e1f0", "srcset": "https://si.imgix.net/6eb9e1e5/uploads/origins/c5049c9e-0db1-4e0e-8644-8e06a417dfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82a2d9225d8ca2322b4bbe2260d6e1f0, https://si.imgix.net/6eb9e1e5/uploads/origins/c5049c9e-0db1-4e0e-8644-8