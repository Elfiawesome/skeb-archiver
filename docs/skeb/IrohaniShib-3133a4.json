難しい場合は描きやすい構図で描いてください！\n\nhttps://drive.google.com/drive/folders/1D04kgzmY-NiK8iMh7Kt2-1NA9yFPK3Y0?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IrohaniShib/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c74ad78/uploads/origins/1db22c08-689f-4c96-9c13-80e8835ebe99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6608e1766dc2cbd143ca64109d8fa4a4", "srcset": "https://si.imgix.net/1c74ad78/uploads/origins/1db22c08-689f-4c96-9c13-80e8835ebe99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6608e1766dc2cbd143ca64109d8fa4a4, https://si.imgix.net/1c74ad78/uploads/origins/1db22c08-689f-4c96-9c13-80e8835ebe99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=894be9fa07303d3f01ae62281c85e4f4 2x, https://si.imgix.net/1c74ad78/uploads/origins/1db22c08-689f-4c96-9c13-80e8835ebe99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7f1de8733c1e12683c125e958d2197f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1133833, "nc": 176}, {"path": "/@IrohaniShib/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1133833, "client_id": 1742587, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f57b7f9/uploads/origins/44015a82-43bf-4f9f-a7c7-4100e68fb49f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb560eafcb797183edaf0b339afb2f12", "srcset": "https://si.imgix.net/1f57b7f9/uploads/origins/440