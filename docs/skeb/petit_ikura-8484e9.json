cc66347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d2b046fca00da3f33c1a59c5c7c577c 2x, https://si.imgix.net/b5a8d975/uploads/origins/0a3a541a-dbfb-4424-a8c0-df2a4cc66347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c70d9ef0b1408061fa7331b478d40182 3x"}, "body": "\u521d\u3081\u307e\u3057\u3066\u3001\u500b\u4eba\u3067Vtuber\u6d3b\u52d5\u3092\u3057\u3066\u3044\u308b\u78a7\u307f\u3069\u308a\u3068\u7533\u3057\u307e\u3059\u3002\n\u4eca\u56de\u306fSNS\u3067\u3044\u304f\u3089\u69d8\u306e\u7d20\u6575\u306a\u30a4\u30e9\u30b9\u30c8(\u7279\u306b\u7518\u7d50\u3082\u304b\u3055\u3093\u30a4\u30e9\u30b9\u30c8\u3001\u7d20\u6575\u3067\u3059)\u3092\u62dd\u898b\u3044\u305f\u3057\u307e\u3057\u3066\u3001\u81ea\u5206\u306eVtuber\u30e2\u30c7\u30eb\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3044\u3001\u6050\u308c\u306a\u304c\u3089\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u4f9d\u983c\u5185\u5bb9\u3011\n\u30fb\u30b2\u30fc\u30de\u30fc\uff08\u30b2\u30fc\u30e0\u5927\u597d\u304d\uff09\u306a\u932c\u91d1\u8853\u5e2b\u3067\u3059\u3002\n\u30fb\u683c\u95d8\u30b2\u30fc\u30e0(\u30b9\u30c8\uff16)\u3068\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u597d\u304d\u3067\u3059\u3002\n\u30fb\u307e\u305f\u3063\u308a\u3086\u308b\u304f\u30b2\u30fc\u30e0\u3092\u697d\u3057\u3093\u3067\u3044\u307e\u3059\u3002\n\n\u898b\u305f\u76ee\u306b\u95a2\u3057\u3066\u306f\u8cc7\u6599URL\u306b\u7acb\u3061\u7d75\u3092\u63b2\u8f09\u3057\u3066\u304a\u308a\u307e\u3059\u306e\u3067\u3001\u304a\u624b\u6570\u3067\u3059\u304c\u305d\u3061\u3089\u3092\u53c2\u8003\u306b\u3054\u5236\u4f5c\u304f\u3060\u3055\u3044\u3002\n\n\u69cb\u56f3\u3084\u30dd\u30fc\u30b8\u30f3\u30b0\u306b\u3064\u3044\u3066\u306f\u5148\u751f\u306b\u304a\u4efb\u305b\u3067\u81ea\u7531\u306b\u304a\u63cf\u304d\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3063\u3066\u304a\u308a\u307e\u3059\u3002\n\n\u307e\u305f\u3001\u901a\u5e38\u306e\u914d\u4fe1\u7b49\u6d3b\u52d5\u5185\uff08\u4e0b\u8a18\u4f7f\u7528\u7528\u9014\uff09\u3067\u4f7f\u7528\u3059\u308b\u30a4\u30e1\u30fc\u30b8\u306e\u30a4\u30e9\u30b9\u30c8\u3067\u304a\u9858\u3044\u3067\u304d\u307e\u3059\u3068\u5e78\u751a\u3067\u3054\u3056\u3044\u307e\u3059\u3002\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\n\u30fbYoutube\u306e\u52d5\u753b\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u914d\u4fe1\u5185\u306e\u4f7f\u7528\n\u30fbTwitter\uff08\u73fe\u30a8\u30c3\u30af\u30b9\uff09\u7b49\u306eSNS\u3067\u306e\u6d3b\u52d5\u306b\u4f7f\u7528\n\u203b\u5168\u3066\u4f7f\u7528\u306e\u969b\u306b\u306f\u5fc5\u305a\u540d\u524d\u3068SNS\u306eURL\u3092\u8a18\u8f09\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u3010\u30c7\u30fc\u30bf\u306e\u5185\u5bb9\u3011\n1920\u00d71080\u4ee5\u4e0a\u3067\u3042\u308c\u3070\u30b5\u30a4\u30ba\u6307\u5b9a\u306f\u3054\u3056\u3044\u307e\u305b\u3093\u3002\n\u30b5\u30e0\u30cd\u30a4\u30eb\u7b49\u306b\u4f7f\u7528\u3059\u308b\u53ef\u80fd\u6027\u3082\u3042\u308b\u305f\u3081\u3001\u9aea\u306e\u6bdb\u306e\u5148\u3084\u6307\u306e\u5148\u304c\u5207\u308c\u3066\u3044\u306a\u3044\u69cb\u56f3\u3067\u3059\u3068\u5927\u5909\u52a9\u304b\u308a\u307e\u3059\u3002\uff08\u4e0a\u534a\u8eab\u306e\u307f\u3084\u819d\u4e0a\u304b\u3089\u306e\u30a4\u30e9\u30b9\u30c8\u306f\u53ef\uff09\uff08\u5e3d\u5b50\u306e\u6709\u7121\u3082\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\u3002\uff09\n\u307e\u305f\u3001\u7d0d\u54c1\u30c7\u30fc\u30bf\u306fPSD\u30d5\u30a1\u30a4\u30eb\u3067\u304a\u9858\u3044\u3057\u3066\u3082\u3088\u308d\u3057\u3044\u3067\u3057\u3087\u3046\u304b\u3002\nPSD\u306e\u4e2d\u8eab\u306b\u95a2\u3057\u307e\u3057\u3066\u3001\u6587\u5b57\u30fb\u4eba\u7269\u30fb\u80cc\u666f\u3067\u5206\u3051\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u751a\u3067\u3059\u3002\n\n\u4e0a\u8a18\u554f\u984c\u3054\u3056\u3044\u307e\u305b\u3093\u3067\u3057\u305f\u3089\u662f\u975e\u3054\u691