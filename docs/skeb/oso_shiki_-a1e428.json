械には疎く、スマホの返信ももたつく。\nモチーフは紫のバラ。幼少期から、大きなシャチのぬいぐるみを抱き枕にしている。\n\n構図・服装はご自由にしていただいて構いません。\n\n使用用途は、個人利用の範囲でSNSやTRPGツールでの利用、自分用のグッズ製作となります。\nご都合があいましたら、どうぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/105hXgB_Hp0g0bG0SDmCzeAiC0eyo4Szt?usp=sharing", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oso_shiki_/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/90e639dd/uploads/origins/101e5fdd-9ed8-46b3-8bc6-84fbc4c08253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54f62dc1695bb980c57ed182b09eba36", "srcset": "https://si.imgix.net/90e639dd/uploads/origins/101e5fdd-9ed8-46b3-8bc6-84fbc4c08253?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54f62dc1695bb980c57ed182b09eba36, https://si.imgix.net/90e639dd/uploads/origins/101e5fdd-9ed8-46b3-8bc6-84fbc4c08253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=76aeb953b67b0eee61e8f81f8c39525a 2x, https://si.imgix.net/90e639dd/uploads/origins/101e5fdd-9ed8-46b3-8bc6-84fbc4c08253?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb4c066be66109f172be0c075049d34d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3625739, "client_id": 1928575, "nc": 17}, {"path": "/@oso_shiki_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e75e2a51/uploads/origins/713224d3-c4ac-4cbc-b3bc-33cc8d63d887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=P