。\n最後に、おやすみの挨拶を、、、。\n（長めのキス）\n\nおやすみ。", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@mutunotatami/works/8", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2030579914056118272%2FIRIPSHXT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79ae8395ee4d62f674059639f970399c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2030579914056118272%2FIRIPSHXT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79ae8395ee4d62f674059639f970399c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2030579914056118272%2FIRIPSHXT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d79910edaf8207621a4578648823172 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2030579914056118272%2FIRIPSHXT.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9056ad5db6057a24604d2a04c9c5a1c 3x"}, "private": true, "genre": "voice", "tipped": false, "creator_id": 622245, "nc": 128}, {"path": "/@mutunotatami/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 622245, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/2ecda34a-4c07-46b4-a0a9-1ff399813bed?response-content-disposition=inline&Expires=1774633652&Signature=LkmMgU7qVb51mFw4SlbhndfzCcjEH7JpSBetApET1Ltve0U4Gupc1a3TMwa0hHgrjAOqTtjU6Np07WKdAjNhgm2m2CHa53w1fJi0l~6xDTmBtoK32iV4Do1rbibXN8Lv