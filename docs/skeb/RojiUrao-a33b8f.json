o. i saw your art and really liked it so i wanted to send a request\n\nI would like for you to draw my oc as a goddess of luck and misfortune.\n\nI would like for her to be looking down at you with her eyes glowing and she has a glowing dice in her hands\n\nI would like for her outfit to be similar to the ones in the reference but i leave it up to you.\n\nCharacter reference: https://imgur.com/a/4VTA3qw and https://imgur.com/a/KbeNkSx\n\nI would love it if you accepted thank youuuuu.", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RojiUrao/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2013667, "client_id": 2227869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eed128c8/uploads/origins/0f1d259b-4177-46f8-8e39-e003442a593c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cc53e4beaf18d1847dc59161898a896", "srcset": "https://si.imgix.net/eed128c8/uploads/origins/0f1d259b-4177-46f8-8e39-e003442a593c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cc53e4beaf18d1847dc59161898a896, https://si.imgix.net/eed128c8/uploads/origins/0f1d259b-4177-46f8-8e39-e003442a593c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=708a5240ee0711f4c49333eabcc5af76 2x, https://si.imgix.net/eed128c8/uploads/origins/0f1d259b-4177-46f8-8e39-e003442a593c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d03a9ecab6ddf7eed1e945efd91fbd4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eed128c8/uploads/origins/0f1d259b-4177-46f8-8e39-e003442a593c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0383b6eb8672d08ce2e9bda11f747044", "srcset": "https://si.imgix.net/eed128c8/uploads/origins/0f1d259b-4177-46f8-8e39-e003442a593c?bg=%23fff&auto=format%2