e225-f60c-4c36-a31f-ce9f923aaed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce71592eb2e779c8b42f6c1de3cd236", "srcset": "https://si.imgix.net/1862f7bf/uploads/origins/3427e225-f60c-4c36-a31f-ce9f923aaed6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ce71592eb2e779c8b42f6c1de3cd236, https://si.imgix.net/1862f7bf/uploads/origins/3427e225-f60c-4c36-a31f-ce9f923aaed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d3ea1aa542c612d5a2f565dff67c5bc 2x, https://si.imgix.net/1862f7bf/uploads/origins/3427e225-f60c-4c36-a31f-ce9f923aaed6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a337ad20f5b644f86cf3c771ba5d52b8 3x"}, "body": "初めまして！SHA様のXでのデフォルメイラストを拝見させていただきました。今回は描いていただきたい2人がおり、依頼させていただきました！！\n金額や条件が合わないようであればキャンセルや再申請要請をいただけますと幸いです。\n\n≪依頼内容≫\nTRPG「同じ空には昇れない。」のPCです。\nskebなどでのPCの使用はお相手にも許可済です。\n2PCキャラのデフォルメイラストを描いていただきたいです。\n等身や構図などはお任せします。\nOCのイメージは下記です。\n\n「奏音（かのん）」character1\n女性/153cm/20歳\n中性的な見た目で、紫がかった黒髪に緑のハイライトと入れている。瞳はオレンジ（夕焼け色）ジト目より\nクールで表情の変化が人よりわかりにくく、飄々としている。人との大人数でのコミュニケーションは苦手で1匹狼になりがちだが、人自体は嫌いではない。オルフェに関しては最初は戸惑っていたが、慣れないながらも楽しく話している。最近ではオルフェの行動に対して照れたり、笑ったりもする。\n\n「オルフェ」character2\n吸血鬼/男/177cm/見た目20代後半\n蝙蝠のようなくせ毛の黒髪、前髪は白髪。紫から黄のグラデの瞳。\n我が輩やそなたなど、しばしば芝居がかったような古臭い口調で話す。エスコートしてくれるなど基本的には紳士的な態度だが、根が元気なため大袈裟な行動に奏音から引かれてしまうことも多々ある。奏音のことを気に入っており、積極的に話しかけている。\n\n≪備考≫\n作品は個人の範囲で利用させてもらいます。個人利用でグッズなども検討しているため、可能であれば透過データもしくはPSDでいただけますと幸いです。\n＿\n\nもしご縁がございましたら、ぜひともよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1srXrU31x150uTi6UCDXFd-HTBWF9_uFb", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dr_app15/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3360944, "client_id": 2755750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e5bdbacc553c84795eea2f5c9d24c5", "srcset": "https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e5bdbacc553c84795eea2f5c9d24c5, https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d95412bcec88ed88ab5bd45f738d261 2x, https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bca75a0aa2e1b63cecab011fad7e48e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e046e93d089e5fba88100a8d9570896", "srcset": "https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e046e93d089e5fba88100a8d9570896, https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=080f8fdc5405f51cdddcc62bc288a7b7 2x, https://si.imgix.net/db389175/uploads/origins/f875b363-0d83-4386-a5cc-7e313ea9ad2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f395039b29aa046d3a4ff24cff5a3c55 3x"}, "body": "社長さま、はじめまして！\nskebの新着欄を拝見しており、デザイン性のある構図とかわいらしいキャラクターのタッチに惹かれ\n是非ともうちよそのOCを描いていただきたく依頼させていただきました。\nリクエスト内容は事前公開されているシナリオの内容に触れますが、それ以上のネタバレは含みません。\n\n2人の関係性：\n同じ村で生まれ育った唯一無二のパートナー。一つ屋根の下、２人で暮らしている。\nスキンシップが多く距離感はかなり近い。\n\nキャラの説明：\n①クラウス：身長174cm。14歳。一人称は俺。\n感情が顔に出づらくぶっきらぼうだがミアには甘い。\nラジオを聴くこと、読書、ミアの面倒をみることが好き。\n\n②ミア： 身長153cm。14歳。一人称はミア。\n子猫みたいに自由できまぐれ。性格や振る舞いは幼い。\nアルパの演奏、歌うこと、クラウスに髪を梳いてもらったり撫でてもらうことが好き。\n\nビジュアル、詳細については資料をご確認ください。\nシチュエーションや構図に関してはご自由にお任せいたします！\n舞台設定が昭和初期レベルのため、文明機器だけは控えていただけると嬉しいです。\n\n使用目的は友人間のデータの共有、PCやスマホの壁紙への個人利用を想定しており、お手数ですがサイン無しのデータもいただけますと幸いです。\n不勉強で恐縮ですが依頼が金額に見合わないようであれば再送要請をお願いいたします。\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1NhmPSHUdfOOUvSckOcS_p5vaakohJoUD?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dr_app15/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3360944, "client_id": 980275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d839de0/uploads/origins/7388ba52-0e67-48fe-b4bf-01a74b1e313d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d3dbeef08fe6c3748d211fb4c3d0858", "srcset": "https://si.imgix.net/0d839de0/uploads/origins/7388ba52-0e67-48fe-b4bf-01a74b1e313d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d3dbeef08fe6c3748d211fb4c3d0858, https://si.imgix.net/0d839de0/uploads/origins/7388ba52-0e67-48fe-b4bf-01a74b1e313d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6173198ee855c7c7c301c4f08a81ac81 2x, https://si.imgix.net/0d839de0/uploads/origins/7388ba52-0e67-48fe-b4bf-01a74b1e313d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2b03fa1b49ffa02de874be848d0e1ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d839de0/uploads/origins/7388ba52-0e67-48fe-b4bf-01a74b1e313d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e19218ad017346509611644bd5335385", "srcset": "https://si.imgix.net/0d839de0/uploads/origins/7388ba52-0e67-48fe-b4bf-01a74b1e313d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e19218ad017346509611644bd5335385, h