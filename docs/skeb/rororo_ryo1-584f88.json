, "creator_acceptable_same_genre": false}, {"path": "/@rororo_ryo1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2899543, "client_id": 148312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f2c7226069e1c15efd05bc3c74eaef2", "srcset": "https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f2c7226069e1c15efd05bc3c74eaef2, https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6e8f114903d1454895599455dcf3d9c 2x, https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ffa0ee44fba4d2d0d49c2cd457a486e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aa9ac8e927a554d100eda21d6a432bd", "srcset": "https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1aa9ac8e927a554d100eda21d6a432bd, https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a9e2e50acb5d49e2481da36ee6e1920 2x, https://si.imgix.net/4da7770c/uploads/origins/a0eb6101-a24d-4cfc-bbdd-e9d7d6cd343a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=796590818b229680071ac50da37f247d 3x"}, "body": "初めまして！\n今回依頼をさせてもらいます！\n\n\n≪キャラクター≫\n◆ファイアーエムブレム烈火の剣に登場するリンをリクエストさせてもらいます。\n　https://i.imgur.com/hqXiHoL.png\n　英雄紹介\n　https://guide.fire-emblem-heroes.com/06001002000010-2/\n\n≪シチュエーション≫\n◆山賊との戦闘に敗北し捕らえられたリン。\n　山賊たちのアジトで山賊たちに輪姦凌辱される…というシチュでお願いします。\n\n≪細かいシチュエーション≫\n◆ろろろ了一さんが描かれているこちらの漫画形式のイラストのような感じでお願いします。\n　https://twitter.com/rororo_ryo1/status/1700678840346169839\n　①右上に少し小さめに敗北し捕らえられている悔しそうな表情のリンの全身像をお願いします。\n　　服は着たままオッパイ部分は破れて大きなオッパイが露出しているという風にお願いします。\n　　リンには「この！」「何をされても屈しないわ！」みたいな感じの台詞をお願いします。\n　②左上に輪姦凌辱されているリンをお願いします。\n　　体位や構図はおまかせします。\n　　服の有無はおまかせします。\n　　全裸でも構いません。\n　　リンには気持ちよさそうな喘ぎ声をお願いします。\n　③右下にマンコとアナルから精液が垂れているお尻のアップをお願いします。\n　　こちらのような中出しカウントマークをお尻に描いてください。\n　　https://i.imgur.com/xDJynkR.jpg\n　④左下に犯されまくった結果快楽堕ち表情になっているリンの表情アップをお願いします。\n　　ろろろ了一さんが描かれているこちらのイラストのジャンヌオルタの表情みたいな感じでお願いします。\n　　https://twitter.com/rororo_ryo1/status/1700678840346169839\n　　「もっとぉ…もっとおチンポちょうだい…♡」みたいな快楽堕ちしている台詞をお願いします。\n　≪NG≫個人的にニガテなのでひょっとこフェラやバキュームフェラ、快楽堕ち表情はアヘ顔は無しでお願いします。≪NG≫\n\n≪その他≫\n◆竿役の男たちは全身写さずに上記のろろろ了一さんが描かれている作品のように下半身周辺が画面に入り込んでいるという風にお願いします。\n　\n　\n長々となりましたがどうぞよろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2278, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "エイジス㌠", "screen_name": "TheoryIV", "avatar_url": "https://pbs.twimg.com/profile_images/1941020228043063296/AeJ4rJaF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/97250256/1751610328/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 33}, {"id": 117490, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "マツダユウスケ100,8", "screen_name": "mazdanakanohito", "avatar_url": "https://pbs.twimg.com/profile_images/786789466178334720/fb3OWJLB.jpg", "h