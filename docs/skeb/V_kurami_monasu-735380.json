347712%2FCPEA0NhL.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c1860a87cc58e18614a67f919e35bbc", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1680923435919347712%2FCPEA0NhL.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c1860a87cc58e18614a67f919e35bbc, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1680923435919347712%2FCPEA0NhL.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67f05a3e739e03411725025ce7c2ae15 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1680923435919347712%2FCPEA0NhL.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c24b870ea677fea996d343b02ca7dc0e 3x"}, "body": "『刺客に襲われる倉見モナさん』\n\nモナ、狙われている……さては例の研究機関の手の者……\nこれはまずい……急がないとこの後の配信予定が……\n\nあきらめてはだめよ、モナ\nこうなったら、野生のクラミドモナスの本能を呼び覚まして……\n\nしまった！！相手は一人じゃない、後ろにも気配が！！\nあぶないっっ！！\n\n…………どこを見てるの！！モナはこっち！！ (←言い放つ感じでお願いします)\nそっちは残像……\n光合成による大気のゆらぎを利用して幻を生み出すことなど、モナにはたやすいこと\n\nそして、これが……\n荒ぶるクラミドモナスのポーズううううう！！！！！！\n\nピシっ！！ (←口で言ってほしいです)\n\n…………ふっ、恐れをなして逃げ出したか\nただの刺客などモナの敵ではないのだ\n\nやっぱりクラミドモナスは、可愛いだけじゃなくて強くてエライっ！！", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@V_kurami_monasu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 2298711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1680923435919347712%2FCPEA0NhL.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=849b27c837fe8218df611779c8cfb199", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1680923435919347712%