f-9221-200725bf38e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89b8ad63e066c6fb3fe86e1cbb534f6e", "srcset": "https://si.imgix.net/33b27e48/uploads/origins/4d60dcfa-91fd-439f-9221-200725bf38e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89b8ad63e066c6fb3fe86e1cbb534f6e, https://si.imgix.net/33b27e48/uploads/origins/4d60dcfa-91fd-439f-9221-200725bf38e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e51f8ef18a658dfe90c7a748cec096a 2x, https://si.imgix.net/33b27e48/uploads/origins/4d60dcfa-91fd-439f-9221-200725bf38e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58f5b5eb19ed7c0b7b343fefe171c9ac 3x"}, "body": "こんにちは！あなたの絵を見て、このお願いを聞いてもらえると思ったの！\n\n私のためにキャラクターをデザインしてほしいです！私は彼のゲーム内のスプライトと彼が身に着けているいくつかの主要なアイテムの他にしっかりとしたイメージを持っていませんが、私は多くの書かれた情報を持っています！これで大丈夫かな？\nhttps://drive.google.com/drive/folders/1cyvFUUtK5aL1ZwiAWnOoVOnOFV2oZB-D?usp=drive_link\n\n重要なストーリーメモ\n彼は異次元に飛ばされた農夫である。以前は芸術家で、自分の作品がギャラリーに展示されることを夢見ていた。彼は都会で生まれたが、都会でのビジネスや騒音が嫌いになった。\n\n外見：\n20代前半の男性だが、性別は不詳。背が低く痩せ型で、顔に3つのほくろがある。いずれも目の下にある。髪の長さは肩にかかるくらい。かわいくて実用的な服を好んで着ており、お気に入りのジャンパーは雲柄のもの。ネイルも洋服と同じものを好む！彼の服は、多少擦り切れたり破れたりしていることをご了承ください。\n\n性格\n農夫で、誰とも話さないほど内向的。無感情で、自分を表現するのが苦手。非常に勤勉で、目標を達成しようとする強い意志を持っている。怪物と話すのが好きで、贈り物をもらうのが好き。ちょっと目立ちたがり屋だが、全体的にはのんびり屋。釣りと彫刻が苦手。\n\nこんな感じでいいかな！リクエスト読んでくれてありがとう\n\nhttps://drive.google.com/drive/folders/1cyvFUUtK5aL1ZwiAWnOoVOnOFV2oZB-D?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5eBd5tNNNMRMXsd/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1475891, "client_id": 1416113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869397d67221ed7f03ea3ae2fe820107", "srcset": "https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=869397d67221ed7f03ea3ae2fe820107, https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bff8593a09b0dfadeee2933ae57f91b4 2x, https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cc6dc49d0ab2639f3e3c3eb9afefa17 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1c2afb5f1373b9580eaf44b9f683d98", "srcset": "https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1c2afb5f1373b9580eaf44b9f683d98, https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e7aa2c0e9d8c14f134b8cdae2cc6284 2x, https://si.imgix.net/3728ba76/uploads/origins/6d8a8378-398f-49cd-baa8-c6766cfceb89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd7a09a447c8191f8b240d970144906d 3x"}, "body": "こんにちは、前回の依頼で杖を持ったキャラクターを描いていただき、とても感動しましたので、依頼をさせていただきます（https://skeb.jp/@5eBd5tNNNMRMXsd/works/5）！私のOCであるUathachを描いていただけませんか？彼は8歳の王子様で、優しいけれど繊細で、魔法の杖を使って人や動物を助けます！すでにデザインはあるのですが、これらを参考に描いてほしいです：\n|\n服とアクセサリー: https://imgur.com/a/gZfykRH\n\n髪型：https://imgur.com/a/eoUhdCM\n\nウアサハの上着には白いマークがついています。見えにくいかもしれませんが、頑張って描いてみてください！ウアサハの髪は、ヘア・リファレンスにあるように描いてください。また、額にある「S」のアザも描いてください！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5eBd5tNNNMRMXsd/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1475891, "client_id": 733859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649c2558b64b9bb64e272ee130be722c", "srcset": "https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649c2558b64b9bb64e272ee130be722c, https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92fef7f148cae2af89a0358586489c08 2x, https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5405eaaf821e21626edc163a0093738 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=642d99e96f6aae2bfffb2a130bfc1dbc", "srcset": "https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=642d99e96f6aae2bfffb2a130bfc1dbc, https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f4cf901681006433c1bd6b3b67f4509 2x, https://si.imgix.net/e25edfc7/uploads/origins/72292c97-9a86-4cca-9b61-bcc5fa031216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af40b7e13aa04869774bba953cc5e630 3x"}, "body": "こんにちは！\n\nファンタジーのキャラクターデザインをお願いしたいです。\n具体的な参考資料がないので、できるだけ詳しく書きます。ゴブリンスレイヤー』のプリーステスや『ファイアーエムブレム』のミカヤからヒントを得ています。\n基本的なアイデアは、若いエルフのヒーラータイプのキャラクターです。\n\n身体的特徴\n-16～18歳くらい\n-明るい肌\n-腰くらいの長さの流れるような白髪（大きなリボンをつけたふわふわのポニーテールでも可。）\n-サファイアのような深いブルーの目\n-とがった長い耳。\n-エルフにしては背が低い（～150cmくらい？）\n-バストはB～C\n\n服装\n-白がメインで、黒がアクセント。\n-ヒーラー／メイジ・スタイルのフード付きローブ。着心地がよさそうなもの。フードは上げても下げてもいい。\n-十字架か他のシンボルの金のペンダント。\n-聖句が刻まれた木の杖を持つ。\n\n優しく心配そうな表情で描いてください。\n\n曖昧な表現、おかしな表現がありましたら申し訳ありません。変更・追加などお気軽にどうぞ。また、金額は高くても構いません。\nご検討のほど、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5eBd5tNNNMRMXsd/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1475891, "client_id": 1735485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61b43b8b/uploads/origins/b147ae57-2eec-4900-a352-f3e681bc9f08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97b626286be74e6228359d842fa9ec5", "srcset": "https://si.imgix.net/61b43b8b/uploads/origins/b147ae57-2eec-4900-a352-f3e681bc9f08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97b626286be74e6228359d842fa9ec5, https://si.imgix.net/61b43b8b/uploads/origins/b147ae57-2eec-4900-a352-f3e681bc9f08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=660fb155ff6f011872f8d44a41be57c3 2x, https://si.imgix.net/61b43b8b/uploads/origins/b147ae57-2eec-4900-a352-f3e681bc9f08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17ea9458adeb58b3b32756d1b43dba46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61b43b8b/uploads/origins/b147ae57-2eec-4900-a352-f3e681bc9f08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e88cdafcbcde8bc294399a4bf9fd9efb", "srcset": "https://si.imgix.net/61b43b8b/uploads/origins/b147ae57-2eec-4900-a352-f3e681bc9f08?bg=%23fff&auto=format%2C