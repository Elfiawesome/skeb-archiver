top&w=200&h=200&s=2dcf883eddbeeea545895ed58c4ea21a 2x, https://si.imgix.net/b64586ee/uploads/origins/101fff44-2afc-4ab9-87b9-d1ead8883fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ce7c943bb66e9ad42aa41c95a0ca779 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b64586ee/uploads/origins/101fff44-2afc-4ab9-87b9-d1ead8883fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48445da57900fac85c04bf22479e486a", "srcset": "https://si.imgix.net/b64586ee/uploads/origins/101fff44-2afc-4ab9-87b9-d1ead8883fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48445da57900fac85c04bf22479e486a, https://si.imgix.net/b64586ee/uploads/origins/101fff44-2afc-4ab9-87b9-d1ead8883fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a45fa3af7e9091182dab43e404251806 2x, https://si.imgix.net/b64586ee/uploads/origins/101fff44-2afc-4ab9-87b9-d1ead8883fb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7fcf8f58b6d18c6052e479fdb6d96fe 3x"}, "body": "こんにちは。キュートなアートスタイルですね。\n\nこの二人のキャラクターを描いてもらえませんか？1980年代のラスベガスを舞台に、恋に落ち、警察から逃げ回る犯罪者たち。二人とも遊び好きのトラブルメーカーです。二人はとても仲が良く、お互いにとても愛し合っています。\n\n場面のアイデアとしては、以下のようなものが考えられます（描きたくない場合は、描かなくても構いません）。\n- 警察から逃げたり隠れたりしているところ\n- 一人がもう一人の傷に包帯を巻く。\n- ホテルのベッドで一緒に暖をとる\n- 砂漠で一緒に迷子になる\n- カジノやゲームセンターで\n- 銃撃戦の中で\n\nでも、好きなように描いてくださいね。\n\nhttps://drive.google.com/drive/folders/1BG0Xh8Ndab4SARnadahbYBtx8yRvVNpO?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mu_musubime/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 979392, "client_id": 1235802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d89eda1/uploads/origins/14d471cb-2b16-4407-9a8a-b443c63d95cc?bg=%23fff&auto=form