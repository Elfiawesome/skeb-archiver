77c58/uploads/origins/7d0fd873-2985-44df-be81-3852fe6c936d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c372c22556bc289a114e0bf461825f1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec377c58/uploads/origins/7d0fd873-2985-44df-be81-3852fe6c936d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea6b5912041f70a4791611ca94b1b5e", "srcset": "https://si.imgix.net/ec377c58/uploads/origins/7d0fd873-2985-44df-be81-3852fe6c936d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea6b5912041f70a4791611ca94b1b5e, https://si.imgix.net/ec377c58/uploads/origins/7d0fd873-2985-44df-be81-3852fe6c936d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1f0da54a4a5adba4e966fcafdd39312 2x, https://si.imgix.net/ec377c58/uploads/origins/7d0fd873-2985-44df-be81-3852fe6c936d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b19a126e0e50635ac0f8472b3461f41 3x"}, "body": "はじめまして。\nPixivでイラストを拝見し、是非オリジナルキャラクターのデザインをお願いしたいと思いリクエストを送らせていただきました。\n\n下記の要素を元に、メカスーツ系少女のキャラクターデザインをお願いしたいです。\n設定画のように三面図の構成だと嬉しいです。\n\n\n↓以下、デザインイメージ↓\n\nヒロイン名:エスフィール\n全体のイメージ:天使モチーフのメカスーツ少女。生体アンドロイドのようなイメージ。\n\nイメージカラー:\n白(インナー・装甲のメインカラー)\n青(装甲のサブカラー)\n水色(エネルギーライン)\n\n容姿:\n・碧眼銀髪ツインテール\n・無表情系\n・手足がすらっと長い\n・胸はある程度大きい(巨乳ではあるが爆乳ではない)\n\n各部デザインイメージ:\n\n1.インナー\n・競泳水着のようなデザイン。光るエネルギーラインが走っている\n・ロングニーソとロンググローブ。同様にエネルギーラインあり\n・胸元に青いクリスタル\n\n2.装甲\n・頭部:ツインテールの基部にメカパーツ\n・両手脚:最低限の装甲(小手や膝当て)\n・腰部:光の翼(ミニサイズ)\n\n3.その他\n・武器:メカニカルな大剣　大砲にもなる\n\n\n以上です。\n上記以外の要素に関してはおまかせします。\nまた、デザイン案の中で不可能そうな部分やより良くなると思われる部分があれば変更/アレンジしていただいて問題ありません。\n\nご一考いただければ幸いです。 \nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shirata98/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 952483, "client_id": 3604651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb301b519ed4150e6ab8f371e9a42601", "srcset": "https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb301b519ed4150e6ab8f371e9a42601, https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6d123406d5f511223602cda409bad89 2x, https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f556b50b76983998a03536c0af5fcf3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0364be046d614a2b322d6bbeee1ba3c2", "srcset": "https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0364be046d614a2b322d6bbeee1ba3c2, https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2c9fc136c6cc1545e383ccdee16bf13 2x, https://si.imgix.net/4c714656/uploads/origins/8a2d55d6-0fef-4190-979e-039083494882?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5413a9c7cb6105c0375e337ec716e900 3x"}, "body": "お世話になっております。\nイリアムで使うサキルの新スタイル立ち絵をお願い致します。\n\nヘアスタイル:ケモミミ(猫)ウェーブがかかったロングヘアー\nファッション:参考に、原神のエミリエっぽいファッションがいいなぁと思ってます、、色は紫〜青  羽あり猫しっぽあり\nポーズ：猫っぽいポーズおまかせします。\n表情:鼻低めの子猫っぽい感じで、のんびり幸せそうな表情。(認識に必要な為、口開け)\n前よ