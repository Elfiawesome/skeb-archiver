9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c8\u306b\u7acb\u3061\u7d75\u304c\u8f09\u308b\u3053\u3068\u306a\u3069\u3001SNS\u3067\u5229\u7528\u3059\u308b\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002\n\n---------------------------------\n\n\u3010\u8cc7\u6599\u3011\n\n\uff1c\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u57fa\u672c\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\uff1e\n-------------------------------------\n\u540d\u524d\u3000\uff1a\u8679\u6ce2 \u5fb9\u864e (\u30cb\u30b8\u30ca\u30df \u30c6\u30c8\u30e9)\n\u4e00\u4eba\u79f0\uff1a\u4ffa\n\u4e8c\u4eba\u79f0\uff1a\u3042\u306a\u305f\u3001\u30ad\u30df\u3001\n\u8eab\u9577\u3000\uff1a186cm\n\u9854\u306e\u826f\u3055\uff1aAPP17(\u3081\u3063\u3061\u3083\u3044\u3044\u307b\u3046\uff01)\n\u8077\u696d\u3000\uff1a\u30db\u30b9\u30c8\n\u30a4\u30e1\u30bd\u30f3\uff1a\u6c34\u661f - tofubeats feat.\u30aa\u30ce\u30de\u30c8\u30da\u5927\u81e3\n\n\u8da3\u5473\u3000\u3000\u3000\u3000\uff1a\u88c1\u7e2b\n-------------------------------------\n\n\u3010\u305d\u306e\u4ed6\u3011\n\u63e1\u308a\u3053\u3076\u3057\u304f\u3089\u3044\u306e\u5927\u304d\u3055\u306e\u4eba\u5f62\u3092\u6301\u3063\u3066\u3044\u308b\u3001\n\u80a9\u3068\u304b\u306b\u4e57\u3063\u3066\u3044\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\uff01\n\n\u3010\u30ad\u30e3\u30e9\u30c7\u30b6\u5e0c\u671b\u3011\n\u30fb\u6027\u5225\uff1a\u7537\u6027\n\u30fb\u5e74\u9f62\uff1a24\u6b73\n\u30fb\u4f53\u7cfb\uff1a\u8eab\u9577\u306f\u9ad8\u3081\u3001\u7b4b\u8089\u306f\u4eba\u4e26\u307f\u7a0b\u5ea6\u3001\u304c\u3063\u3057\u308a\u3057\u3066\u3044\u308b\u3068\u3044\u3046\u308f\u3051\u3067\u3082\u306a\u3044\u3001\u5e73\u5747\u7684\u3002\n\u30fb\u9aea\u578b\u3001\u9aea\u8272\uff1a\u91d1\u9aea\u3001\u53f3\u5074\u306b\u7d2b\u306e\u30e1\u30c3\u30b7\u30e5\u3068\u3001\u4e21\u30b5\u30a4\u30c9\u306b\u30d4\u30f3\u30af\u5bc4\u308a\u306e\u7d2b\u30e1\u30c3\u30b7\u30e5\u304c\u304b\u304b\u3063\u3066\u3044\u308b\uff1f\u3061\u3087\u3063\u3068\u50d5\u81ea\u8eab\u304c\u3053\u3046\u3044\u3063\u305f\u540d\u79f0\u306b\u8a73\u30