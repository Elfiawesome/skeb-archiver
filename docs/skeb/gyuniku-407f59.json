o.gl/e6G4XntZHZFTrpPK7）。他人との付き合い方が分からず、修行か山奥に隠遁する生活を好む。髪は黒、瞳は緑。身長175cm。 仕様面では、彼女のキャラクターにとって重要な白い蝶のヘアクリップは維持すべきです。剣聖は文明から隠れることを好むため、二人はよく偶然出会います。魔女が森で見つけた奇妙な動物や植物を剣聖に見せようとするようなシーンは面白いでしょう。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gyuniku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3837626, "client_id": 155686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1ff90bc/uploads/origins/2f46d828-9a7e-4242-a002-a1c5aa354b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abf285670519b081233b51e35138cfbd", "srcset": "https://si.imgix.net/f1ff90bc/uploads/origins/2f46d828-9a7e-4242-a002-a1c5aa354b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abf285670519b081233b51e35138cfbd, https://si.imgix.net/f1ff90bc/uploads/origins/2f46d828-9a7e-4242-a002-a1c5aa354b46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=757182d6a0dbd802c84e86c41ee80b47 2x, https://si.imgix.net/f1ff90bc/uploads/origins/2f46d828-9a7e-4242-a002-a1c5aa354b46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f21e47404b9e05fb6838310f2b885f0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1ff90bc/uploads/origins/2f46d828-9a7e-4242-a002-a1c5aa354b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bde1f0cbe9fdc3fdd97d5ae3e8bbff2", "srcset": "https://si.imgix.net/f1ff90bc/uploads/origins/2f46d828-9a7e-4242-a002-a1c5aa354b46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bde1f0cbe9fdc3fdd97d5ae3e8bbff2, https://si.imgix.net/f1ff90bc/uploads/origins/2f46d828-9a7e-4242-a002-a1c5aa354b46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b6dced9906aac2a7d21168bc76034a9 2x, http