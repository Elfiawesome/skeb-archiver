5d8f6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=7ba8d32106ff3ed381d60ccbeca9598e, https://si.imgix.net/035afdd8/uploads/origins/fbcd5b65-ef4c-413e-a35f-aa543475d8f6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6e8cc12b5a8729d4fcce3fa9b8ac5d2 2x, https://si.imgix.net/035afdd8/uploads/origins/fbcd5b65-ef4c-413e-a35f-aa543475d8f6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbfa53b2d4f4e32a6c0a591167be8285 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/035afdd8/uploads/origins/fbcd5b65-ef4c-413e-a35f-aa543475d8f6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=598b2cba07b6e4638c2c6cca75b13bb7", "srcset": "https://si.imgix.net/035afdd8/uploads/origins/fbcd5b65-ef4c-413e-a35f-aa543475d8f6?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=598b2cba07b6e4638c2c6cca75b13bb7, https://si.imgix.net/035afdd8/uploads/origins/fbcd5b65-ef4c-413e-a35f-aa543475d8f6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a340ee7638eea3321ba7fcf60e708098 2x, https://si.imgix.net/035afdd8/uploads/origins/fbcd5b65-ef4c-413e-a35f-aa543475d8f6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63e6e1749c8cb6feb2b32245b2d12cf1 3x"}, "body": "緑壱様 \n\nお世話になっております。VSingerの箱乃なかみです。\n先日は素敵なSkebをありがとうございました！歌枠のサムネイルなどで使用させていただいております！\n\n今回シチュエーション指定でお描きいただけたらと思いリクエストしました。\n自分で説明するのがとても恥ずかしいのですが、私自身泥酔すると人に沢山感謝してしまうのをよくいじられているので「お酒を片手に酔っぱらって人に感謝している箱乃なかみ」を描いていただきたいです。\n今後の飲酒配信のサムネイルなどメインで使用出来たらと思っています…！\n\n前回同様腕や頭、服が部分的に切れないような描画範囲でお願いできますと幸いです。\n等身・SDキャラかはおまかせします。\n\n【キャラクター概要】\n箱乃なかみ（Hakono Nakami） \n最高のエンターテイナーになる見習いピエロVSinger。\nオリジナル曲リリース、ライブ出演、歌唱依頼請負を中心とした歌の活動がメイン。ほかにも趣味の競馬配信（毎週日曜）、面白系企画（全員自分語り縛り、参加型クソダサパワポ選手権など）、雑談配信などを行っている。\n毛先の芝色の割合は競馬での回収率が下がるほど増えていき、マイナス収支になると全頭芝色になって闇堕ちする。現状は完全にマイナス収支だがピンクのヘアスプレーで髪を固めて人前に出ている（ということにしている）。\n\nモチーフ：ピエロ、エンターテイナー、プレゼントボックス、リボン、蹄鉄 など  \n\n【納品形式】\n PSDデータで背景と人物、ある場合はエフェクトをそれぞれ分けられるような形での納品ですと助かります。\n\n 以上、何卒ご確認をよろしくお願いいたします。\n\n参考用URL\nhttps://www.youtube.com/@HakonoNakami\nhttps://drive.google.com/drive/folders/1EVAxfJts71YpclvmRHdUzcmgXk7tIJ8l?usp=sharing\n\n酔った時の感謝ポスト（ほんの一部）\nhttps://x.com/nakami_hakono/status/1950993188753453074\n\n感謝耐久配信アーカイブ\nhttps://youtube.com/live/q9h7TV_rqDE?feature=share\nhttps://youtube.com/live/JdtGcUPkgCc?feature=share\nhttps://youtube.com/live/mEsNcgdTXIM?feature=share", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@61_rokuichi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2351783, "client_id": 1995832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4e00ddc91246a51e8a85823e053201ac", "srcset": "https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4e00ddc91246a51e8a85823e053201ac, https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=74b612f6c4d4acf92a4e3db496c4133a 2x, https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5c29877f796257ce3d8826ee55bf0c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=894356d1f8ebcb61549a2db9cf33643b", "srcset": "https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=894356d1f8ebcb61549a2db9cf33643b, https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=095a947f07f649c69ad03308d76d55b9 2x, https://si.imgix.net/645f3262/uploads/origins/7dd1669c-a804-4328-aad9-8adc355ce7ea?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac3c919cb29f8cfd87cfaedbe7d2647 3x"}, "body": "緑壱様  \n\nこんばんは！\n 個人でVTuberをしている、わんこ系VTuberの加々流がろらです！\n\n Xにて緑壱様のホラー系イラストを拝見して、是非僕のホラーイラストも描いていただきたいと思ってリクエストさせていただきます…！  \n\nホラー用の衣装があるのでそちらの和サイバーで描いていただけますと幸いです！\n 目にハイライトない感じのホラーゲームのサムネに合うようなものだと嬉しいです…！\n 絵の雰囲気など構図などは緑壱様のお好きなように描いていただいて問題ございません！  \n\nいただきましたイラストはYouTubeのサムネやXにも公開させて使わせていただけると嬉しいです！\n※可能でしたら人物のみの背景透過もいただけるとありがたいです。 \n\n 拙い文章で申し訳ございませんがどうぞよろしくお願いします。 \n\n今後も緑壱様のイラストを楽しみにしております！！\n\nhttps://drive.google.com/drive/folders/1y3ypZf3_cPfgZBpWipDlGkaW60_ToKVb", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@61_rokuichi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2351783, "client_id": 2307654, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef6de5c6/uploads/origins/bfc5aec4-0faa-4223-a5be-fc447a06cd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7416fe854d3b021b0b0f0f72e1bc2512", "srcset": "https://si.imgix.net/ef6de5c6/uploads/origins/bfc5aec4-0faa-4223-a5be-fc447a06cd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7416fe854d3b021b0b0f0f72e1bc2512, https://si.imgix.net/ef6de5c6/uploads/origins/bfc5aec4-0faa-4223-a5be-fc447a06cd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7d1791972002ded2dd0138a33c72419 2x, https://si.imgix.net/ef6de5c6/uploads/origins/bfc5aec4-0faa-4223-a5be-fc447a06cd0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=667d7a