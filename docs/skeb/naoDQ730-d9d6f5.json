crop=top&w=200&h=200&s=90f47cf9e07f46b8f46e4b0646b7fef2 2x, https://si.imgix.net/1c7083f5/uploads/origins/b537747c-02a9-4f85-aa92-42745132071b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42e1e2251c299818a4167dd22e4e53ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c7083f5/uploads/origins/b537747c-02a9-4f85-aa92-42745132071b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2035dc691ea0f655d359520f0ac71b2", "srcset": "https://si.imgix.net/1c7083f5/uploads/origins/b537747c-02a9-4f85-aa92-42745132071b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2035dc691ea0f655d359520f0ac71b2, https://si.imgix.net/1c7083f5/uploads/origins/b537747c-02a9-4f85-aa92-42745132071b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddae6f727435b178b92393588125345 2x, https://si.imgix.net/1c7083f5/uploads/origins/b537747c-02a9-4f85-aa92-42745132071b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c3f0cf55cec3acfbd0fbf800d3fe0df 3x"}, "body": "山南クラ助様、初めまして。\n銀治（誠刀）と申します。\nいきなり失礼します。\n\n素敵なウェディ族のキャラクター等を描かれており、是非ともリクエストしたくメッセージを送りました。\n\n自機の「ミオ」をお願いします。\n\n天地雷鳴士（白✖️青のソポス装備、カミュの手袋、アクセルギアが特徴）のウェディ単独の方でお願いします。\n\n構図としてですが、可能な限りで構いませんので\n・笑っていない、不機嫌そうな表情（できれば眼差しは冷たい形）\n・シリアス系\nを入れてください。\n\n背景と武器や盾は描かなくて構いません。\n\n資料はURLに載せておりますが、万が一貼れていなかったり等ございましたらスルーして構いません。\n\n長文、駄文失礼しました。\n\nhttps://drive.google.com/drive/u/0/folders/1-lam6h591WAnN8SUaYAVAGd24nzRFyxQ\n\nhttps://drive.google.com/drive/u/0/folders/1-lam6h591WAnN8SUaYAVAGd24nzRFyxQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naoDQ730/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 502659, "client_id": 3557608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si