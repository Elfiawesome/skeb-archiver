感じており、非常に密接な関係を築いています。\n\n-\n\n「使用範囲について」\nこのイラストは個人の鑑賞用として使用させていただきます。\n\n-\n\n性格や関係性などの詳細な設定については、こちらのリンクをご参照ください。  \n\nもし先生に描いていただける機会があれば、とても嬉しいです。 \nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/12jjPatdZj-Mvz1w1D2L0bscs8ta_I8Zg?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sgtdski2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3905708, "client_id": 208307, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9441daaf/uploads/origins/101c2799-4ddb-45eb-9aa0-8d6e5a9b1590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70d3b511819f2b8780deb6ded3eadfdb", "srcset": "https://si.imgix.net/9441daaf/uploads/origins/101c2799-4ddb-45eb-9aa0-8d6e5a9b1590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70d3b511819f2b8780deb6ded3eadfdb, https://si.imgix.net/9441daaf/uploads/origins/101c2799-4ddb-45eb-9aa0-8d6e5a9b1590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7246e0ff8b3d1c417649b88e82dfe94 2x, https://si.imgix.net/9441daaf/uploads/origins/101c2799-4ddb-45eb-9aa0-8d6e5a9b1590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb09ca9de5fdb8e8fe9565a8252a9596 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9441daaf/uploads/origins/101c2799-4ddb-45eb-9aa0-8d6e5a9b1590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d353a405749eb4fc9fc61fa3182fcdab", "srcset": "https://si.imgix.net/9441daaf/uploads/origins/101c2799-4ddb-45eb-9aa0-8d6e5a9b1590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d353a405749eb4fc9fc61fa3182fcdab, https://si.imgix.net/9441daaf/uploads/origins/101c2799-4ddb-45eb-9aa0-8d6e5a9b1590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cro