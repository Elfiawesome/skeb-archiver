439b006b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a44329c9aa5d346996bf37328760b39f 2x, https://si.imgix.net/6808bc1a/uploads/origins/36e98b09-ed98-4282-b8f8-da439b006b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=396948e993d9da8204ce574d4a4cdec8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6808bc1a/uploads/origins/36e98b09-ed98-4282-b8f8-da439b006b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3618e48f5fe2e63897b964a70e6ff58", "srcset": "https://si.imgix.net/6808bc1a/uploads/origins/36e98b09-ed98-4282-b8f8-da439b006b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3618e48f5fe2e63897b964a70e6ff58, https://si.imgix.net/6808bc1a/uploads/origins/36e98b09-ed98-4282-b8f8-da439b006b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa39c1bb644a3f27e24ae3752be3f52f 2x, https://si.imgix.net/6808bc1a/uploads/origins/36e98b09-ed98-4282-b8f8-da439b006b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0623d5959d7d3af9e24044f745d0030d 3x"}, "body": "Thank you for painting our child so beautifully the other day.\n\nThe character I would like to ask you to draw is the mascot character of my site again, and she will be wearing a green jersey, gym uniform and bloomers.\nhttps://twitter.com/Funakiya/status/1444135179837054976\n\nI would like the situation to be of my child playing with a shiba-inu (a Japanese bush dog).\nI will leave the details to you.\n\n\nI would like to use it only within the scope of introduction on my site in order to avoid introduction on social networking sites and twitter freeze.\nThank you in advance.\n\nhttps://twitter.com/Funakiya/status/1444135179837054976", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SddcARCxyjLYx2l/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2487659, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aadf584eda09961815ce1a86f2d61d3c", "srcset": "https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aadf584eda09961815ce1a86f2d61d3c, https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e51fccf59ee8f009b3c2d78e8cf4f83 2x, https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a0d0f91211f0c276b0619ac07561886 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=266549d9eaf7c6e8d16cced637359f7b", "srcset": "https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=266549d9eaf7c6e8d16cced637359f7b, https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b47b90b7e9797d6f3d1b3d3a7780f991 2x, https://si.imgix.net/ba914037/uploads/origins/24df23fd-8b02-466f-9672-49165ae4dae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b497ec642573bb547343ad33275e923 3x"}, "body": "Nice to meet you!\nI requested this because I was interested in your drawing pattern.\nIf you don't mind, would it be possible for me to ask you to draw our OC, \"Rikuzuki Usagi\"?\nFor your reference, the setting is as follows, but you can draw freely.\nMutsuki Usagi\nRikuzuki Usagi (陸月 兎子)\n\nA girl with pigtails, black hair and eyes, and a hair dress decorated with stars.\nShe is curious and good-natured.\n\nShe always carries Boo, a white rabbit, with her.\nShe is the only one who can see Boo, and no one but Boo can touch him.\n\nShe has the ability to interfere with the world and time, and can find herself in another world line or another time axis that matches certain conditions and send images (limited to simple figures such as zeros and x's) telepathically.\n\nIt is difficult for the sender to send the image many times in a row because of the dramatic discomfort involved.\nThe recipient has no inbox or rejection settings, so he or she feels as if his or her consciousness is suddenly jammed. If a large number of messages are received simultaneously from different world lines or different time axes, the recipient will lose consciousness with a nosebleed.\n\nShe herself has no further special powers, but her companion Boo is no exception.\nBoo, like her, has the ability to interfere with the world and time, but it goes beyond the level of sending telepathic messages and randomly rewrites the world (time) itself.\n\nSince Boo's intelligence is about that of a 5-6 year old child, if left unchecked, she will use her abilities at will, and the way the world (time) is distorted without limit.\nIf the distortion becomes too severe, it will even affect another world line (time axis), and if that happens, he will receive a large number of warnings from himself in the other world line (time axis), so he has no choice but to watch over Boo so that he does not use his powers carelessly.\n\nIf Boo inadvertently uses his power, we will have no choice but to ask him to use his power several more times to correct the distortion, but since it is only an act of correcting distortion by distortion, it cannot be completely restored.\n\nSince he is not known as a person of ability, no one has given him a second name. He calls himself \"The Wizard of Time,\" \"The Watcher,\" etc., but these are only self-proclaimed names.\nHe is a \"wizard of time\" and \"watcher,\" but these are only self-proclaimed names.\nI am planning to use this for all my personal activities (illustrations for novels, introduction of characters on SNS and personal websites, announcements of personal activities, etc.).\nIf it is convenient for you, I would appreciate it.\n\nhttps://drive.google.com/drive/folders/1-CVMYZAOuQisUoQ5mG0NPRuoLmySIiQg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SddcARCxyjLYx2l/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2487659, "client_id": 1852720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd7949ce/uploads/origins/39ca2b9b-76b6-4f34-8621-2131249b1e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6f0b5393dc14e455bc2925ac07e226", "srcset": "https://si.imgix.net/cd7949ce/uploads/origins/39ca2b9b-76b6-4f34-8621-2131249b1e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6f0b5393dc14e455bc2925ac07e226, https://si.imgix.net/cd7949ce/uploads/origins/39ca2b9b-76b6-4f34-8621-2131249b1e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc4707d9527ab70e9033c6d2a0423a1f 2x, https://si.imgix.net/cd7949ce/uploads/origins/39ca2b9b-76b6-4f34-8621-2131249b1e3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=354945e982e775e98a081c925af0b85b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd7949ce/uploads/origins/39ca2b9b-76b6-4f34-8621-2131249b1e3c?bg=%23fff&auto=format%2Cco