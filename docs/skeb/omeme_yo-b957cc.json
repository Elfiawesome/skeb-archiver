dpr=3&fit=crop&crop=top&w=200&h=200&s=ed90b5fea4043f8d082ab64038e18469 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ff348a4/uploads/origins/6dac6905-44b8-4820-862e-819cdd74f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fbadb9697bbcefd3190d606a682124d", "srcset": "https://si.imgix.net/1ff348a4/uploads/origins/6dac6905-44b8-4820-862e-819cdd74f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fbadb9697bbcefd3190d606a682124d, https://si.imgix.net/1ff348a4/uploads/origins/6dac6905-44b8-4820-862e-819cdd74f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1554a593df4424912e339913a0cf18e0 2x, https://si.imgix.net/1ff348a4/uploads/origins/6dac6905-44b8-4820-862e-819cdd74f2d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c43038d83b9b2d604321de39f574fca3 3x"}, "body": "おめめ様\n\n失礼致します。\nこの度は是非とも自宅のキャラクターとおめめ様のキャラクターの二人のイラストが見たいと思い、依頼させていただきました。\n\n【イラストの詳細】\n自宅の桃源恋也と、おめめ様の楓真さんの二人のイラストが見たいです。\nシチュエーションは「夜のイルミネーションデート」でお願いします。このシチュエーションに沿っていれば、その他の状況や、構図等は全てお任せします。好きなように描いていただいて構いません。\nまた、冬服につきましても、恋也に関しては自由に着せていただいて構いません。小物などに桃色のものがあると、恋也らしくなるかと思います。\n資料URLの中に、恋也の立ち絵と通常アイコン、恋也が着そうな冬服の例を入れておきますので、参考にしてください。\n\n長くなりましたが、どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1CQ13tHD7qoP3fOFZwVKFda6VPD1xDKf1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omeme_yo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2836960, "client_id": 2751565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dffad56a0edefc0ad015cbdcd1ce664", "srcset": "https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dffad56a0edefc0ad015cbdcd1ce664, https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=663bb75bee4528a59a4695119ebba6b7 2x, https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f08d2cc7fbe937bdea72f90d753d550c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=561b954b9f183601bc4d6af3f96fc36e", "srcset": "https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=561b954b9f183601bc4d6af3f96fc36e, https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2020d882594c95c47ee0ed503111276e 2x, https://si.imgix.net/9f7a2ef3/uploads/origins/3cba0495-6093-471b-943b-e06d6896ec10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b89c7bed0691866ce21566fc0a805053 3x"}, "body": "失礼します。 絵柄がとても大好きなので、私のキャラクターを描いていただきたくリクエストを送らせていただきました。 以下は依頼内容となっております。\n  【依頼種類】イラスト\n 【絵の範囲】おまかせ致します (上半身でも全体図でもどれでも構いません)\n 【サイズ・解像度】お任せします \n【ファイル形式】お任せします\n 【キャラクター】資料用URLを参照 \n公開HOに記載されているので言えますが、吸血鬼の人外です。そして、刑事です。\n【服装】資料用URL を載せています。　\n見えていない腹部分の紐はベルトです。\n特殊な飾りとかもありません。\n不安な場合は聞いてくだされば、詳しい詳細を描いて送ろうと思います。　\n 【背景】夜空と希望を入れていますが、難しければなくてもいいです。\n 【構図】夜空の下微笑む構図を希望します。描きにくい等ございましたら、構図は変更しても構いません。なんでも好きです。  資料として、Dropboxのリンクを貼っています。ご確認ください。  内容が合わなければキャンセルしていただいて大丈夫です。 お忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps: