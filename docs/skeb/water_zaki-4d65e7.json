7a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31f5e8cf7ef7dfcd43f9e2a72c4207b2, https://si.imgix.net/0a85d0ea/uploads/origins/5b0df205-2a9e-40cc-aa24-e0dffae547a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fac2626ada4293ca20c035fcb59583d1 2x, https://si.imgix.net/0a85d0ea/uploads/origins/5b0df205-2a9e-40cc-aa24-e0dffae547a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef44bbe1ab3b0f6fb43d4840a00bbb8b 3x"}, "body": "こんにちは、またご連絡してしまいすみません！\nこの二人のOCを描いていただけたら嬉しいです。\n\n少し特別な雰囲気のある「バニークラブ」のような場所で、\nソファに座っているシチュエーションを想定しています。\n\n褐色肌のキャラクターは首輪をつけていて、黒髪のキャラクターがリードを引いて距離を縮めている（少しぎこちなく、不機嫌そうな様子）。一方で褐色肌のキャラクターは相手の腰に腕を回していて、余裕があり強気な印象です。黒髪のキャラクターは黒いバニー耳をつけています。もちろん、雰囲気に合っていれば自由にアレンジしていただいて大丈夫です！\n\nあなたの描写がとても美しくて本当に大好きです！\n作品はウェブサイトの装飾や、SNSの壁紙として使用する予定です。\nどうもありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Fd2I_OlY2mcWGH3OfghQ_VqML5ThRDMP?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@water_zaki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1687542, "client_id": 2954235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a32dac0291fe6c0d916ac06f4eb886bc", "srcset": "https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a32dac0291fe6c0d916ac06f4eb886bc, https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b5e97c4f1f5b197cde0f946f87018cc 2x, https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c7ce330ed5c86c23c99bc2264c74319 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f29485ce84232fcfb89b41f271a4a69", "srcset": "https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f29485ce84232fcfb89b41f271a4a69, https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a3bb1a55db02b7a980fad67427505b1 2x, https://si.imgix.net/3a824fd1/uploads/origins/4ae71f46-6492-403a-9a79-5aa11f510c2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76bfa3f41646e1af17010f82b6212688 3x"}, "body": "こんにちは、はじめまして。SSと申します。\nミズザキさんの描かれるイラストの色使いと雰囲気に惹かれ、リクエストをお願いしたくメッセージをさせていただきました。\nこの度はご縁があれば是非私と友人のTRPGのOCを描いていただきたいです。友人にも許可は得ております。\nもしリクエストを受けていただけましたら、こちらは個人鑑賞用にポストカード印刷をさせていただいたり、PCの壁紙などにさせていただく予定です。商用利用は絶対にいたしません。\n何卒ご検討よろしくお願いいたします。\n\n～\n\n以下、簡易的な設定になります。\n【人物像】\n①神奈月 白斗(かんなづき はくと)/男/33歳\n髪色：白/目の色：緑\n身長：170㎝\n一見すると気怠げで面倒くさがりのようだが、その実面倒見のよい誠実な青年。実は喜怒哀楽がはっきりしている。ややかっこつけで抜けているところもある。\n素直に好意を示すのが苦手だが、明星のことが大好き。\n明星の経営する古着屋の経理として働いている。\n②古志 明星(ふるし あせい)/男/33歳\n髪色：黒/目の色：赤\n身長：178㎝\nとある町の路地裏で古着屋を営んでいる。\n性格は子供っぽく自分勝手。面白いことや楽しいことが好き。\nあまり物事を深く考えていないようで実際は周りをよく見ており状況を判断する能力が高い。抜け目ないずる賢い男。\n白斗のことが大好きで、愛情表現過多気味。\n【関係性】\n幼少期からの幼馴染。\nお互いに暗い過去があるが、現在はパートナーとして二人で日々を面白おかしく穏やかに過ごしている。\nオープンな性格の明星が白斗にところかまわず構いたおして怒られる、という構図がデフォルト。\nただ白斗も本気で嫌がっているわけではなく満更でもない。\n【依頼内容】\n日常を過ごす二人のイラストを描いていただけると嬉しいです。\n路地裏を歩く二人、古着屋で働く二人、ファーストフードを食べる二人…など。\n服装はミズザキさんの描きやすいように自由に描いていただいて構いません。\nミズザキさんのイメージのままに描いていただきたいです。\n\n～\n\n資料や情報不足で想像が難しい場合は再送あるいはキャンセルをしていただければと思います。\n今回のご縁の有無にかかわらず、ミズザキさんの創作活動をこれからも心から応援しております。\n長文失礼いたしました。\n\nhttps://drive.google.com/drive/folders/1s5BUTSA8j5DdWNDsqDuQ1t3txR_OKVfg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@water_zaki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1687542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a22ce64f0360966258a969fd8519a476", "srcset": "https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a22ce64f0360966258a969fd8519a476, https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c301895ffa66ebf38cc938583b293bd 2x, https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31653c0b1a683948c2184c75c0fe9705 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2a64a20f92d240cad4838497122ea80", "srcset": "https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2a64a20f92d240cad4838497122ea80, https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e30c4c055da18e3e80dcc46080dff77c 2x, https://si.imgix.net/c5438312/uploads/origins/d6b3d6b2-4fa6-4330-bf9e-9a380942d673?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c8277d55eb787d57383f2d0acbbab2 3x"}, "body": "こんにちは！この二人のOCを描いていただけたら嬉しいです。\n二人は大航海時代の海賊という設定なので、船の上や酒場、あるいは賭博をしている場面などを見てみたいです。もちろん、雰囲気に合っていれば自由にアレンジしていただいて大丈夫です！（服装もお任せします）\n\n赤髪のほうは普段とても楽しそうにしていて、茶髪のほうはだいたい不機嫌かツンデレっぽい感じです。\n\n作品はウェブサイトの装飾や、パソコン・スマートフォンの壁紙として使用する予定です。\nどうもありがとうございます！\n\nhttps://drive.google.com/drive/folders/1i6fnJsOI9ANU6fzd1baq_RLiO3t7re2y?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@water_zaki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1687542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4f0b08d/uploads/origins/fbb015dd-069f-441b-8f0e-76ce0f1cd1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab55b29fbd1acd2b7995c3c69b8eec3", "srcset": "https://si.imgix.net/d4f0b08d/uploads/origins/fbb015dd-069f-441b-8f0e-76ce0f1cd1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab55b29fbd1acd2b7995c3c69b8eec3, https://si.imgix.net/d4f0b08d/uploads/origins/fbb015dd-069f-441b-8f0e-76ce0f1cd1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57ad52929405f9a36f3547bc033187b4 2x, https://si.imgix.net/d4f0b08d/uploads/origins/fbb015dd-069f-441b-8f0e-76ce0f1cd1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8798412ae16dcad434188fbfef8472ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4f0b08d/uploads/origins/fbb015dd-069f-441b-8f0e-76ce0f1cd1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b53bea0b98485583ee947cbf3c8b278f", "srcset": "https://si.imgix.net/d4f0b08d/uploads/origins/fbb015dd-069f-441b-8f0e-76ce0f1cd1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=