d7qsyt46hj7xu&st=9q7gvv12&dl=0\n\nA　170cm／女\n世話役。\n人前ではおしとやかで真面目な態度をしているが、根が小学生男児。\n楽しいことにすぐ飛びつくので、お祭りで端から端までのあらゆる屋台飯を食べたいタイプ。\n剣が上手く、護衛のため日本刀を身につけている。\n\nB　172cm／男\n村長の孫。\n上っ面へらへら男。未成年だがタバコを吸うし酒も飲むしピアスもバチバチ。\n好きな人たちを困らせたくないので優等生をしている。\n基本的に弟根性が強いが、張り付けた責任感だけはいつもある。\n\n・関係性\nAの天真爛漫でやんちゃな行動に、Bがしょうがないな…(呆)となるのが常だが、\n根本的にはBがAに執着しているので、余裕がないのはいつもBだし、Bに余裕がなくてもAは自由人なので気にしない。なんだったらちょっと面白いなと思っている。\nBはAに振り回されるのが嫌いじゃないし、Bの側がわがままで振り回しても離れないAに安心感を覚えている。\n\n・使用用途\n友人と共有する他、SNSで自慢したり、個人用にグッズ印刷する可能性があります。\n\n金額に問題があれば気軽に再送ください。\n検討よろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@GiV_81/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3401559, "client_id": 1846493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c72adbaf/uploads/origins/e7afffd0-65c1-4c9a-8278-13f9d5accee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a96fe559289500b9a219a4f9b153396a", "srcset": "https://si.imgix.net/c72adbaf/uploads/origins/e7afffd0-65c1-4c9a-8278-13f9d5accee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a96fe559289500b9a219a4f9b153396a, https://si.imgix.net/c72adbaf/uploads/origins/e7afffd0-65c1-4c9a-8278-13f9d5accee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a57f98a5226b895243e8c8ebebb46e7 2x, https://si.imgix.net/c72adbaf/uploads/origins/e7afffd0-65c1-4c9a-8278-13f9d5accee8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17b36ed80f056cd0206534c00efe430e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c72adbaf/uploads/origins/e7afffd0-65c1-4c9a-8278-13f9d5accee8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00a669d73e93612f41156e8d1a82a43c", "srcset": "https://si.imgix.net/c72adbaf/uploads/origins/e7afffd0-65c1-4c9a-