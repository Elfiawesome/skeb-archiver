ardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2841c240/uploads/origins/0706fc34-55be-4efe-b47b-974d58a27d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c639d233479ba7082f7849474213511", "srcset": "https://si.imgix.net/2841c240/uploads/origins/0706fc34-55be-4efe-b47b-974d58a27d39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c639d233479ba7082f7849474213511, https://si.imgix.net/2841c240/uploads/origins/0706fc34-55be-4efe-b47b-974d58a27d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9afc43df8e418fb719c88780907627bb 2x, https://si.imgix.net/2841c240/uploads/origins/0706fc34-55be-4efe-b47b-974d58a27d39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da3a84dd49bd01897a5988f346113ac1 3x"}, "body": "Apologies for the long request, thank you very much for your consideration! \ud83d\ude47\u200d\u2642\ufe0f\n\nHello, sensei! Would it be possible to request two full body drawings of me and my friend\u2019s OCS? If you could pose them as well, that would be lovely! They are me and my friend\u2019s TRPG OCs and if it is alright, we would like to request matching images so we can print them for personal use. If the price is not sufficient, it would be very helpful for sensei to send a request again!\n\nMikhael (\u653b) : A strong and righteous angel from ancient times. He has a tall, strong physique and handsome, masculine features. His personality is kind, noble, and just. He is a symbol of order that the other angels look up to, and he is currently the most powerful respected angel. Despite his stoic personality, he still smiles sometimes. Overall, he is a genuine and well-liked person. However, he is intimidating to sinners. He is slightly taller and more muscular than Lucifer. \n\nLucifer (\u53d7): \nA fallen angel. Despite his appearance, he actually has a gentle and mature personality, though he is sometimes eccentric. Although he turned his back on God and appears to be evil, it is mostly an act that he puts on. He has a mysterious air to him, and sometimes speaks or answers by omitting truths. In truth, he is kind and even has a sense of humor.\n\nThank you for considering our request!\n\nReferences:\nMikhael: https://drive.google.com/drive/u/1/folders/1Lo-ICcJxr1oAp1bn9CtWn5FE-R4hDGV9\nLucifer: https://imgur.com/a/VHHyPR2\n\nhttps://drive.google.com/drive/u/1/folders/1Lo-ICcJxr1oAp1bn9CtWn5FE-R4hDGV9", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZZ_gorilla/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 144395, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/145fe214/uploads/origins/85d7527d-7be3-4dee-8b5e-7a1d5c92fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76f0df2ea7f62e69de32c8e782ed9a6f", "srcset": "https://si.imgix.net/145fe214/uploads/origins/85d7527d-7be3-4dee-8b5e-7a1d5c92fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76f0df2ea7f62e69de32c8e782ed9a6f, https://si.imgix.net/145fe214/uploads/origins/85d7527d-7be3-4dee-8b5e-7a1d5c92fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89d95c2cd0289cf64b97f8c64ffe1e14 2x, https://si.imgix.net/145fe214/uploads/origins/85d7527d-7be3-4dee-8b5e-7a1d5c92fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59ddd3edda5c0c5aac59ec867355bc72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/145fe214/uploads/origins/85d7527d-7be3-4dee-8b5e-7a1d5c92fd38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=684af8c97608628e2e2f56d45bbc48ef", "srcset": "https://si.imgix.net/145fe214/uploads/origins/85d7527d-7be3-4dee