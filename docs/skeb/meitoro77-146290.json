2c3-0388-4c15-a8fb-89775e5d140b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1239e7fb8c8e4dcd770373f8cace0e", "srcset": "https://si.imgix.net/1dd42f99/uploads/origins/9327b2c3-0388-4c15-a8fb-89775e5d140b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c1239e7fb8c8e4dcd770373f8cace0e, https://si.imgix.net/1dd42f99/uploads/origins/9327b2c3-0388-4c15-a8fb-89775e5d140b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=286b0d854bd8d515f2e93b23cb712da2 2x, https://si.imgix.net/1dd42f99/uploads/origins/9327b2c3-0388-4c15-a8fb-89775e5d140b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=353df127529998a200d526cff58c8c95 3x"}, "body": "はじめまして、先生のヘレナと御蔵のイラストを見て、リクエストしたくお願いです\n想像の幅を持たせるために、敢えてぶつ切り文にて失礼します\n\n定時後、秘書ヘレナ充てに私用の手紙が届いていたので渡した\nその場で開けて読むと、友人に子供が出来たとの報告とあなたも早くパートナーを見つけなさいと書いてあった\nはたから聞いていた提督が、君の子供だと御蔵型のだれに似てる感じかなと言った\n気付くとヘレナは居らず、攫いに行った(御蔵型の描きやすい子で)\n訳も分からず執務室に連れて来られたので、興奮気味のヘレナに変わって提督が経緯を説明\n「ヘレナさんがお母さんですか、そしたら提督がお父さんですか。まぁ、悪くは無いですね」と言うとヘレナが反応\n提督が「〇〇を養子には無理だけど、ヘレナとの結婚は考えておくね」と言うとヘレナは赤面して固まる\n「提督が軽率な事言うから、ヘレナさん固まっちゃたじゃないですか責任取らないと大変ですよ」と言って自室へ帰っていった\n提督のイタズラは続きヘレナの固まっている背中に「提督が予約済み」と張り紙してから少し叩いてヘレナの正気を戻す\n「言霊取りましたからね。キャパオーバーなので///今日はこれで帰ります」\nアメリカ艦寮に戻った所、背中の張り紙を指摘され、紙を握りしめ、嬉しさを噛みしめている\n\nおまかせ額入れておきますが、長いですので、金額は見合うように再送ください", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meitoro77/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 367405, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4491e43d08421be1d9ec2121fcf97752", "srcset": "https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4491e43d08421be1d9ec2121fcf97752, https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3d003d19897c031fed5a592e5fd686f 2x, https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e4b1b1fc793d4e3151c49f052dd5040 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78313c5b62d6b6a8f3695230d85bc979", "srcset": "https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78313c5b62d6b6a8f3695230d85bc979, https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f94da8e6d4123e038e7520b6eec8e2c 2x, https://si.imgix.net/81b55e00/uploads/origins/98b05b1c-f733-4556-b668-4e4cae6ea430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0965405b0131f843c5c03170f3643d48 3x"}, "body": "今回もアーボック時津風をお願いします。\n\n寒くて運動不足を感じた時津風が、アーボックにポケモンバトルみたいに勝負してほしいとお願いし勝負を始めたが、アーボックのほうが素早さが高く、まきつく攻撃を受けたという設定でお願いします。\n\nシーンや表情ですが\n①「巻き付かれちゃった・・・でもこっちも攻撃を・・・」と時津風は苦しみながらも反撃しようとする。\n②しかし攻撃ができず「あれ？攻撃できない・・・？」と時津風は混乱している。\n③「もしかして・・・初代のまきつく攻撃・・・！？」と時津風は気が付き、逃げようと抵抗するがアーボックの攻撃は続いている。\n④アーボックの攻撃が終わり、締め付けがなくなり（身体は拘束されている）「やっと終わった・・・今度はこっちが・・・！」と時津風は苦しみながら攻撃しようとする。\n⑤再度アーボックのまきつく攻撃が始まり、時津風は勝てない事を察し「ごめん！私も負けでいいから許して！」と攻撃をやめるようにお願いする。\n⑥しかしアーボックの攻撃をやめず、何回もまきつく攻撃を繰り返し、時津風は体力がつきる寸前で弱い呼吸ながらも必死に息をしている。\n\n今回⑥のみ目を閉じ、それ以外は開いて下さい。\n\n構図はバトルという事で巻き付き具合や構図は先生が好きなようにお願いします。悩んだ場合は今までのように3～4巻でお願いします。\n又、今回差分が大丈夫でしたら先生が好きな構図でしたら巻きつかれている箇所の追加を、今までと同じ構図でしたら尻尾差分をお願いします。\nその他、できればアーボックの色違いもお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meitoro77/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 367405, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7e02a306a638001830436c9a9c6332", "srcset": "https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7e02a306a638001830436c9a9c6332, https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=015d201ab738542040dfa062dd0cfe28 2x, https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f24a0eda36cf9de982f4e4db05591541 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e08c428528231605977ba93e3d1ac8a5", "srcset": "https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e08c428528231605977ba93e3d1ac8a5, https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2b062057a1ef0d05d1f041d1428079c 2x, https://si.imgix.net/c2073f9c/uploads/origins/e9fbcc9e-62e3-4274-8501-a15edf06fc52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec1cd48c966d1b2a04f591156965c642 3x"}, "body": "９月９日はぎゅうぎゅうの日が近づきましたので今回も時津風アーボックをお願いします。\n\n今回も隙間なく、3～4巻程度で全身を隙間なく巻き付け、時津風の頭の上にアーボックの頭を乗せ、アーボックは口を閉じて舌を出す部分は同じでお願いします。\n今回はアーボックの太い胴体で首も隠れるように巻き付け、時津風の口付近まで締めつけている構図でお願いします。\n\n時津風の表情やシチュエーションは\n①首も締め付けられてしまい、今回は本気でヤバイと焦り始める。\n②ちょうど胴体に噛み付けそうだったので、アーボックに噛みつく。\n③しかし、びくともせず、アーボックは攻撃されたと思いさらに締め付けを強くする。時津風はさらに苦しむ。\n④今回も最終的には助かるだろうと思っているのか、若干安堵の表情を見せながら気を失いそうになる。\n⑤眠るような表情で力尽きる。\n\n①②④は目を明け、③⑤は目を閉じて下さい。\n\n⑤は赤面の差分と、青ざめている差分をお願いします。\n又、今回尻尾の差分を頂けるようでしたら、時津風の口もふさいで、鼻から下が全身巻き付かれいる差分もお願いします。\n更に大丈夫でしたら、色違いの差分もお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meitoro77/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 367405, "client_id": 882135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e88f3d3b99c4a42af90615940039ad4", "srcset": "https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e88f3d3b99c4a42af90615940039ad4, https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c42581503b268b71a6e6280c5f689a3a 2x, https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4ebd6e4d13af7f3695e8e09aeb1ff41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a34f6330351170b50659982af8d3b9", "srcset": "https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a34f6330351170b50659982af8d3b9, https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6261e011e7ae6d8d66b68c65b9c12fe 2x, https://si.imgix.net/63b4172c/uploads/origins/3788a449-d5b4-4627-b802-8e19da856d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7339a0ad239938e63f2fda6cac8532a4 3x"}, "body": "ハローmeitoro\nツイッターなどのプロフィール画像にする少女の絵をお願いします\n左斜め前方向に体を向けて女の子座りをしている\n髪の色は少しだけ緑がかった金色で髪型はポニーテール\nポニテの長さは肩甲骨の中ほどあたりまで\n表情は(⁠◡⁠ ⁠ᴗ⁠ ⁠◡⁠)のように目と口を閉じ笑みを浮かべている\n頭は少し上を向いている\n頭には蓮華の花を画面の正面に向けて飾り付ける\n身長体型は成長期に差し掛かった頃つまり11歳ぐらい\n服装は萌え袖の空色のパーカーと、フレアスカート色は赤以外でおまかせ(というか想像できなかった)\nパーカーにはלְחַסֵל(ヘブライ語)と赤く書かれている\n腕は上腕まで体の横に、前腕は体の前に水平から10度ほど下に\n手には頭のものより一回り大きい蓮華を両手で掬うように\n持っている蓮華の周りには煌めきが十数個ほど舞っていて、薄くモヤがかかっている\n脚にはニーソだけで靴は履いていない\n絶対領域はチラ見レベルで小さい\n背景は無し", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meitoro77/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 367405, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01a99cfc2d270c8cd613e1f864f863a", "srcset": "https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01a99cfc2d270c8cd613e1f864f863a, https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3540378b3d2a4547c308ba07fdfbc523 2x, https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b214e934630ad0714014b0537cf46a38 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=961b786cc6c38f17c244a855c4496ecf", "srcset": "https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=961b786cc6c38f17c244a855c4496ecf, https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fa58a053a4323909c9687d30549d1ee 2x, https://si.imgix.net/d475ce22/uploads/origins/bcec9972-8119-4ca9-9dda-8186d0fd0358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c1a6f37b0441c5e1609dce962290307 3x"}, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n漫画形式か、１シーンごとかはご負担が少ない方で(同じなら１シーン事で)お願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meitoro77/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6324137f/uploads/origins/55f3a8ca-1908-42c2-b5de-1cd20ac67b18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e3e475b0d9a23ab7700d06b710bc40d