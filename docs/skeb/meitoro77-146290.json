します。\n一枚目：能代のセリフ「阿賀野姉ぇ！太もも撫でるのやめてって！」に対して阿賀野(中身は提督)はニヤニヤした表情をしている\n二枚目：能代のセリフ「…あれ？ …提督？」に対して阿賀野(中身は提督)が驚き焦りの表情を浮かべる", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meitoro77/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 367405, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb757ba40cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f3d8f86d5ae236e7f2f79365e3fda5a", "srcset": "https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb757ba40cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f3d8f86d5ae236e7f2f79365e3fda5a, https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb757ba40cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5bf4f322611564e340d61f1598d81fe5 2x, https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb757ba40cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fbc3c151370b76fcd003cc3f9354500 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb757ba40cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e25a30ffe919fbc1a5933980fc909f", "srcset": "https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb757ba40cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11e25a30ffe919fbc1a5933980fc909f, https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb757ba40cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd61efdb03b58a400e3b41c002c6e2d1 2x, https://si.imgix.net/a49186a0/uploads/origins/dafbab6a-898f-4db2-aeae-eb7