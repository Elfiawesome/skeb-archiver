子で結んでいるアリア。\n\nお二人とも夏らしい浴衣姿です。\nディアマンは深紅・茶系の浴衣、神龍様はネイビー系の浴衣です。\n\n浴衣のデザインやディテールはお任せしますが、ディアマンには葉っぱの柄、アリアには龍や小花の柄を提案します。\n\n光の輝きは、花火や提灯をぼかした背景からと、正面から顔にかすかに光が当たるように。\n\n添付の参考資料は雰囲気作りというより、提灯や料理、手をつなぐなど、好きなポーズや小道具を決めることができます。\n\nカラーもお願いします！\n\nhttps://imgur.com/a/zZ2ZMDm", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Illust_mi/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e91e80da/uploads/origins/f201eb34-5760-4a26-aa1c-234b4a91c0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c3b49d9a8e12286fc73fe821c3e4339", "srcset": "https://si.imgix.net/e91e80da/uploads/origins/f201eb34-5760-4a26-aa1c-234b4a91c0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c3b49d9a8e12286fc73fe821c3e4339, https://si.imgix.net/e91e80da/uploads/origins/f201eb34-5760-4a26-aa1c-234b4a91c0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c053781ece303af5f3b954f62cfc8941 2x, https://si.imgix.net/e91e80da/uploads/origins/f201eb34-5760-4a26-aa1c-234b4a91c0c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d4a47f65663d41166e477fb55acc066 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2443618, "client_id": 1260937, "nc": 0}, {"path": "/@Illust_mi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2443618, "client_id": 2658107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a593230b/uploads/origins/5713f448-51b6-40d9-b4c4-08fae9be9f5