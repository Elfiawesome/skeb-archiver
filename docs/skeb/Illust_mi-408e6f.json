EV", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Illust_mi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2443618, "client_id": 2658107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca9e38b0dd917f7eadc49082d2625903", "srcset": "https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca9e38b0dd917f7eadc49082d2625903, https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f4b309ab7a5f7e139080fe78f70798f 2x, https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d406ae02152255a163b8de3538ec6113 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70f84b48eee86a5674a8d47e81dda680", "srcset": "https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70f84b48eee86a5674a8d47e81dda680, https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cda4cb781a5c2cdc3a07cc00ba61fce6 2x, https://si.imgix.net/00921848/uploads/origins/f94e20cc-d842-47d4-bfe8-bf796e91b140?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c20ea9943b55120894f236bccf913d10 3x"}, "body": "Mimumuさん、こんにちは、\n今日のディアリュのキスの作画は、特にリュリュが言い出しっぺなのがとてもよかったです。\n\n同じようなことをお願いできないかと思ったのですが、おそらくリュウルの部屋で、リュウルのベッドの端でリュウルがディアマンにキスをしているのだと思います。\n\nエロかわいいシーンです。\n\nディアマンには、鎧の下にタートルネックのシャツを着たり、ソムニエルのベストを着たりして、上にジャケットを着ないでほしいです。ソムニエルの服を着たリュリュ。\n\n正確なリクエストに違和感がある場合は、ご自身の好みに合わせて自由に修正してください。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Illust_mi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2443618, "client_id": 2658107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc551595/uploads/origins/5ecb4db0-db1a-46a7-aa97-864444ffd96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f03bf21fb959d7e1b55a340d4430fb38", "srcset": "https://si.imgix.net/fc551595/uploads/origins/5ecb4db0-db1a-46a7-aa97-864444ffd96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f03bf21fb959d7e1b55a340d4430fb38, https://si.imgix.net/fc551595/uploads/origins/5ecb4db0-db1a-46a7-aa97-864444ffd96f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c313af6d74b6efda02b362ddfebbb4a3 2x, https://si.imgix.net/fc551595/uploads/origins/5ecb4db0-db1a-46a7-aa97-864444ffd96f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=883ae48c6a8b6f57fcfc3ca97578c250 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc551595/uploads/origins/5ecb4db0-db1a-46a7-aa97-864444ffd96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f06700cc09fb36e12aa814cca880f5e", "srcset": "https://si.imgix.net/fc551595/uploads/origins/5ecb4db0-db1a-46a7-aa97-864444ffd96f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f06700cc09fb36e12aa814cca880f5e, https://si.imgix.net/fc551595/uploads/origins/5ecb4db0-db1a-46a7-aa97-864444ffd9