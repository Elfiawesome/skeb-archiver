ット」は、コラボイベント時の他作品のキャラクターなので、\nコラボキャラ以外でお願いします。\n\n参考用　大まかな各キャラの特徴、属性一覧資料\nhttps://sd.swiki.jp/index.php?%E3%82%AD%E3%83%A3%E3%83%A9%E5%B1%9E%E6%80%A7%E4%B8%80%E8%A6%A7\n\n描いて頂くイラストについて、\nキャラクターの構図やポーズ、背景の有無に関してはお任せ致します。\n\n以上となります、よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shina_hakuryu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 460601, "client_id": 1728470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e297ff53/uploads/origins/f8deab58-0533-4476-b196-9064c8c017e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7097f585ac4eeb666188b2471a24bf05", "srcset": "https://si.imgix.net/e297ff53/uploads/origins/f8deab58-0533-4476-b196-9064c8c017e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7097f585ac4eeb666188b2471a24bf05, https://si.imgix.net/e297ff53/uploads/origins/f8deab58-0533-4476-b196-9064c8c017e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e98ab32ca7076f92f44b3cfaaca1d391 2x, https://si.imgix.net/e297ff53/uploads/origins/f8deab58-0533-4476-b196-9064c8c017e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0fad8a7985554c30d262d848c12112bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e297ff53/uploads/origins/f8deab58-0533-4476-b196-9064c8c017e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b24ed5a114866c0aefd6f40d23555387", "srcset": "https://si.imgix.net/e297ff53/uploads/origins/f8deab58-0533-4476-b196-9064c8c017e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b24ed5a114866c0aefd6f40d23555387, https://si.imgix.net/e297ff53/uploads/origins/f8deab58-0533-4476-b196-9064c8c017e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w