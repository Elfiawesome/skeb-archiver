5f8c\u306e\u5973\u6027\u306e\u3088\u3046\u3067\u3059)\n\u8a95\u751f\u65e5\uff1a1\u67085\u65e5\n\u6027\u5225\uff1a\u5973\u6027\n\u7a2e\u65cf\uff1aBasilisk/\u30d0\u30b7\u30ea\u30b9\u30af\n\u89aa\u548c\u6027\uff1a\u5730/\u5149\n\u8eab\u9577\uff1a\u666e\u901a\u306b\u300c\u7acb\u3063\u3066\u300d\u3044\u308b\u3068\u304d\u306f210cm\u3002(\u982d\u304b\u3089\u5c3b\u5c3e\u306e\u5148\u307e\u3067900cm\u3067\u3059\uff09\n\u5f7c\u5973\u306f\u73fe\u4ee3\u306e\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u306e\u4e16\u754c\u306b\u4f4f\u3093\u3067\u3044\u308b\u3002\n\n\u8a18\u8ff0\uff1a\n-\u6065\u305a\u304b\u3057\u304c\u308a\u5c4b\u3055\u3093\u3002\u4eba\u4ed8\u304d\u5408\u3044\u304c\u60aa\u3044\u3002\u9154\u3046\u3068\u81ea\u5df1\u4e3b\u5f35\u304c\u5f37\u304f\u306a\u308a\u3001\u7537\u6027\u306b\u5a9a\u3073\u3088\u3046\u3068\u3059\u308b\u3002\n-\u30d0\u30b7\u30ea\u30b9\u30af\u306f\u5143\u3005\u5f15\u3063\u8fbc\u307f\u601d\u6848\u306a\u6027\u683c\u3067\u3059\u3002\n-\u5b9d\u77f3\u304c\u5927\u597d\u304d\u306a\u3093\u3067\u3059\u3002\u304a\u9152\u304c\u597d\u304d\u3067\u3001\u3064\u3044\u3064\u3044\u98f2\u307f\u904e\u304e\u3066\u3057\u307e\u3046\u3002\u8f9b\u3044\u3082\u306e\u304c\u597d\u304d\u306a\u3093\u3067\u3059\u3002\n-\u5f7c\u5973\u306f\u5b9d\u77f3\u5e97\u3092\u7d4c\u55b6\u3057\u3066\u3044\u308b\u3002\u5f7c\u5973\u306f\u9b54\u6cd5\u3067\u5b9d\u77f3\u3092\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3002\n-\u30e9\u30df\u30a2\u3002\u30b0\u30ec\u30fc\u306e\u86c7\u306e\u5c3b\u5c3e (\u5c3b\u5c3e\u3068\u76ee\u306f\u540c\u3058\u8272\u3067\u3059)\u3002\u5c3e\u306e\u4e0a\u90e8\u306b\u306f\u3001\u5168\u9577\u306b\u308f\u305f\u3063\u3066\u30b9\u30d1\u30a4\u30af\u304c\u3042\u308b\u3002\u5c3e\u306e\u88cf\u5074\u306f\u767d\u8272\u3067\u3059\u3002\n-\u86c7\u306e\u7259\u304c\u3042\u308b\u3002\u9577\u3044\u30d5\u30a9\u30fc\u30af\u72b6\u306e\u820c\u3002\n-\u5f7c\u5973\u306f\u808c\u304c\u9ed2\u3044\u3002\n-\u5c11\u3057\u307d\u3063\u3061\u3083\u308a\u3057\u3066\u3044\u308b\u3002\u5f7c\u5973\u306f\u3068\u3066\u3082\u5927\u304d\u306a\u80f8\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002\n-\u30e9\u30a4\u30c8\u30b0\u30ec\u30a4\u306e\u77b3\u3002\n-\u9280\u8272\u306e\u9577\u3044\u9aea\u3002\n-2\u672c\u306e\u592a\u3044\u30b0\u30ec\u30fc\u306e\u89d2\u3002\u89d2\u306f\u982d\u306e\u3066\u3063\u307a\u3093\u304b\u3089\u751f\u3048\u3066\u3044\u307e\u3059\u3002\u89d2\u306f\u524d\u65b9\u3092\u5411\u3044\u3066\u3044\u307e\u3059\u3002\u78e8\u304b\u308c\u305f\u77f3\u306e\u3088\u3046\u306a\u3001\u306a\u3081\u3089\u304b\u306a\u8cea\u611f\u3002(\u89d2\u3068\u5c3b\u5c3e\u306e\u30b9\u30d1\u30a4\u30af\u306f\u540c\u8272\u3067\u3059)\n\n\n\n\u8863\u88c5\uff1a\n-\u767d\u3044\u5e03\u88fd\u306e\u30b9\u30c8\u30e9\u30c3\u30d7\u304c\u5f7c\u5973\u306e\u80f8\u3092\u652f\u3048\u3066\u3044\u308b\u3002\u5e03\u306f\u30b7\u30eb\u30d0\u30fc\u306e\u30c1\u30e7\u30fc\u30ab\u30fc\u306b\u53d6\u308a\u4ed8\u3051\u3089\u308c\u3066\u3044\u307e\u3059\u3002\n-\u767d\u3044\u3075\u3093\u3069\u3057\u306e\u3088\u3046\u306a\u3082\u306e\u3092\u306f\u3044\u3066\u3044\u308b\u3002\u8170\u306e\u3042\u305f\u308a\u3067\u30b7\u30eb\u30d0\u30fc\u306e\u30c1\u30a7\u30fc\u30f3\u3067\u7d50\u3070\u308c\u3066\u3044\u308b\u3002\n-\u6d0b\u670d\u306b\u30c7\u30a3\u30c6\u30fc\u30eb\u3092\u52a0\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u670d\u306f\u30e2\u30ce\u30af\u30ed\u3067\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3002\n-\u5f7c\u5973\u306e\u4f53\u306b\u306f\u5b9d\u77f3\u304c\u591a\u7528\u3055\u308c\u3066\u3044\u308b\u3002\u30ab\u30e9\u30d5\u30eb\u306a\u30b8\u30a7\u30e0\u30b9\u30c8\u30fc\u30f3\n-\u6fc3\u3044\u76ee\u306e\u30a2\u30a4\u30e1\u30a4\u30af\u3002\n\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u3092\u30e2\u30ce\u30af\u30ed\u306b\u3059\u308b\u3068\u3044\u3046\u767a\u60f3\u3067\u3059\u3002(\u30b8\u30a7\u30e0\u30b9\u30c8\u30fc\u30f3\u3068\u808c\u3092\u9664\u3044\u3066\u306f\u3002)\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f\u30a8\u30b8\u30d7\u30c8\u98a8\u306e\u30c6\u30a4\u30b9\u30c8\u306b\u3059\u308b\u3068\u304b?\n\nThea\u304c\u6a2a\u5411\u304d\u306b\u5bdd\u3066\u3044\u308b\u3068\u3053\u308d\u3092\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u9154\u3063\u3066\u3044\u308b\u3002\u6deb\u3089\u306a\u8868\u60c5\u3092\u3057\u3066\u3044\u308b\u3002\n(\u79c1\u306f\u9577\u3044\u86c7\u306e\u820c\u304c\u597d\u304d\u3067\u3059)\n\u53ef\u80fd\u3067\u3042\u308c\u3070\u3001\u80f8\u304c\u3080\u304d\u51fa\u3057\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u3082\u5165\u308c\u3066\u304f\u3060\u3055\u3044\u3002\n\u9577\u3044\u30ea\u30af\u30a8\u30b9\u30c8\u3067\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u3002\u304a\u5fd9\u3057\u3044\u4e2d\u3001\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\u3002\n\nhttps://drive.google.com/drive/folders/1MLGNJWjxpeCTeuwLJWAwVIJbqptofTH2?usp=share_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kyu_vuv/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1323522, "client_id": 35729, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4e3d8c1/uploads/origins/aeccad53-4502-4be8-b933-da9ead7c82b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c623c15b297b9b558ddd2be80df2b172", "srcset": "https://si.imgix.net/a4e3d8c1/uploads/origins/aeccad53-4502-4be8-b933-da9ead7c82b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c623c15b297b9b558ddd2be80df2b172, https://si.imgix.net/a4e3d8c1/uploads/origins/aeccad53-4502-4be8-b933-da9ead7c82b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b28f22d064c640b753a55ed05e9cb897 2x, https://si.imgix.net/a4e3d8c1/uploads/origins/aeccad53-4502-4be8-b933-da9ead7c82b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76c55350a0ae7bb29a615a7ff51ad71f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls":