わりのあるOCの資料も入れておりますので、ぜひ雰囲気を掴むために活用していただけたらと思います。\n何か不備があれば申し訳ありません。お忙しいとは存じますが、是非ご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1syB3Ehk_1t3ltSrzzXjFpLPa0j-mlWLe", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashimakino2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3939446, "client_id": 3319390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62a614b5/uploads/origins/897e5544-c62e-457d-a549-7aa2c6e20e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=430e7619b3c62c16682edb60d9c8009a", "srcset": "https://si.imgix.net/62a614b5/uploads/origins/897e5544-c62e-457d-a549-7aa2c6e20e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=430e7619b3c62c16682edb60d9c8009a, https://si.imgix.net/62a614b5/uploads/origins/897e5544-c62e-457d-a549-7aa2c6e20e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c635e8addf05ac5d6d3c9bfce16765c 2x, https://si.imgix.net/62a614b5/uploads/origins/897e5544-c62e-457d-a549-7aa2c6e20e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44c69d6e5c4cb64b1d7c64329500a356 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62a614b5/uploads/origins/897e5544-c62e-457d-a549-7aa2c6e20e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba4392ec0a720842b0063684badf6de7", "srcset": "https://si.imgix.net/62a614b5/uploads/origins/897e5544-c62e-457d-a549-7aa2c6e20e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba4392ec0a720842b0063684badf6de7, https://si.imgix.net/62a614b5/uploads/origins/897e5544-c62e-457d-a549-7aa2c6e20e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=485e5c2f78c7074a370d61fafd181576 2x, https://si.