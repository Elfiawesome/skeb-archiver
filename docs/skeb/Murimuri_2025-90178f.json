30bb\u30df\u30ed\u30f3\u30b0\u306b\u304a\u63cf\u304d\u304f\u3060\u3055\u3044\u3002\n\u982d\u9802\uff5e\u4e21\u5074\u982d\u90e8\u306e\u9aea\u3092\u5f8c\u308d\u306b\u6d41\u3057\u305f\u30cf\u30fc\u30d5\u30a2\u30c3\u30d7\u2026\u8133\u5929\u306e\u30c4\u30e0\u30b8\u304c\u96a0\u308c\u308b\u5f62\u3002\n\u524d\u9aea\u306e\u751f\u3048\u969b\u4e2d\u592e\u90e8\u304b\u3089\u4f38\u3073\u305f\u30012\u672c\u306e\u30a2\u30db\u6bdb\u304c\u30c1\u30e3\u30fc\u30e0\u30dd\u30a4\u30f3\u30c8\u3002\n\u273d\u9854\n\u660e\u308b\u304f\u3001\u30ab\u30c3\u30b3\u53ef\u611b\u3044\u7cfb\u306e\u5c11\u5973\u3002\n\u6dbc\u3057\u3052\u306a\u30af\u30ea\u30af\u30ea\u76ee\u3001\u77b3\u306f\u7070\u8272\u3002\n\u7709\u306f\u9aea\u3068\u540c\u8272\u3002\n\u273d\u4f53\n\u8eab\u9577\uff1a156cm\uff0f\u80f8\u56f2\uff1a85cm(D\u30ab\u30c3\u30d7)\n\u6d3b\u52d5\u7684\u3067\u3057\u306a\u3084\u304b\u306a\u30b9\u30bf\u30a4\u30eb(\u307d\u3063\u3061\u3083\u308a\u30fb\u76db\u308a\u904e\u304e\u306fNG\u3067\u304a\u9858\u3044\u3057\u307e\u3059)\u3002\n\n\uff0a\u670d\u88c5\n\u3053\u306e\u305f\u3073\u306f\u3001\u300c\u901a\u3063\u3066\u3044\u308b\u9ad8\u6821\u306e\u5236\u670d\u59ff(\u51ac\u6625\u79cb)\u300d\u3092\u5e0c\u671b\u3057\u307e\u3059\u3002\n\u273d\u5185\u5bb9\n\u9752\u3044\u30d6\u30ec\u30b6\u30fc\uff1a\u8179\u90e8\u5de6\u53f3\u306b\u30dd\u30b1\u30c3\u30c8\u3001\u524d\u30dc\u30bf\u30f3\u306f\u958b\u653e\u3002\n\u767d\u3044\u30d6\u30e9\u30a6\u30b9\uff1a\u89d2\u895f\u3001\u9577\u8896\u3001\u5de6\u80f8\u306b\u30dd\u30b1\u30c3\u30c8\u3001\u4e00\u756a\u4e0a\u306e\u524d\u30dc\u30bf\u30f3\u306f\u5916\u3057\u305f\u72b6\u614b\u3002\n\u6c34\u8272\u306e\u30cd\u30af\u30bf\u30a4\uff1a\u7537\u5b50\u751f\u5f92\u3068\u5171\u901a\u3002\n\u30dc\u30c8\u30e0\u30b9\uff1a\u819d\u4e0a\u30df\u30cb\u306e\u30d7\u30ea\u30fc\u30c4\u30b9\u30ab\u30fc\u30c8\u3002\n\u305d\u306e\u4ed6\uff1a\u4e0a\u534a\u8eab\u306b\u30b9\u30af\u30fc\u30eb\u30cb\u30c3\u30c8\u3001\u4e0b\u534a\u8eab\u306b\u30b9\u30c8\u30c3\u30ad\u30f3\u30b0\u30fb\u30bf\u30a4\u30c4\u306f\u7