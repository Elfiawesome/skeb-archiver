す。\n\nOC(見た目URL参照)\n特徴的な前髪(男の子ver.)\n髪の毛全体に黒ピンクのリボンが沢山ある(男の娘ver.)\n可愛い格好する時はいつも無理やりさせられてるので恥ずかしいと嫌悪が混ざったような表情をしてる\n普通の男の子の格好してる時は色々な表情をする\nOCのイメージ絵文字は🎀(リボンとフリフリした物が嫌いなので皮肉で🎀)\nツンデレ、案外褒めたりおだてたりしてたらちょろいし言う事聞いてくれる 押しに弱い\n\n服装、表情等全て℃さんにお任せしたいです。℃さんの好きなように描いてください！\n出来れば男の娘ver.と普通の男の子ver.どちらも描いて頂きたいのですが、難しいようでしたら℃さんの好きな方を描いて頂けるととても嬉しいです> < ♡\n\nまた、イラスト、SD絵どちらも出来れば背景透過含め納品して頂けると嬉しいです。\n\nhttps://drive.google.com/drive/folders/10qHq3-ek5JPTZpYMQ_RDCRUc6Z7PxAUQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@guzuzz/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1259884, "client_id": 218389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ce1ce63/uploads/origins/e7f5a286-427c-4201-9997-241b28c25f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34c683bedc44ed023e128c0af20a2b69", "srcset": "https://si.imgix.net/8ce1ce63/uploads/origins/e7f5a286-427c-4201-9997-241b28c25f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34c683bedc44ed023e128c0af20a2b69, https://si.imgix.net/8ce1ce63/uploads/origins/e7f5a286-427c-4201-9997-241b28c25f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b269f2f27a50e5c03790499256535362 2x, https://si.imgix.net/8ce1ce63/uploads/origins/e7f5a286-427c-4201-9997-241b28c25f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=863b892efa874ea6ec8da5cf976665fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ce1ce63/uploads/origins/e7f5a286-427c-4201-9997-241b28c25f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f8578a5e80df16220ca80d4143c5467", "srcset": "https://si.imgix.net/8ce1ce63/uploads/origins/e7f5a286-427c-4201-9997-241b28c25f15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&