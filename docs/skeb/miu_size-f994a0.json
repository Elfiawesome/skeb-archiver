able_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@miu_size/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 441999, "client_id": 52944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84add0b9dcf336b0f51d2093c048dc9e", "srcset": "https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84add0b9dcf336b0f51d2093c048dc9e, https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b336278502882cba2539b95ae17dd2c 2x, https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=791f20a5a0e88384ad4b026614bd5edc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58e505bec63ce00089f84fa83db136a3", "srcset": "https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58e505bec63ce00089f84fa83db136a3, https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9dfeb1869337a04322cf497fac6723d 2x, https://si.imgix.net/ea040d58/uploads/origins/80ea3a74-fbbd-47e1-89ef-795132a579f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08c53ac90fe7880f9ce400d0c525335e 3x"}, "body": "お疲れ様です。\nMiuさんへは初めての依頼になると思います。\n以下のカラーイラストをお願い致します。\n\n【巫女姉妹にお仕置きをしちゃう牡丹さん】\n※3人ともウチの子です\n\n◆背景（御話）\n楽しみにしていた稲荷寿司を姉妹が食べてしまったのでお仕置きと称して２人を縮めた牡丹。\n姉妹はいつもの様にされるのかと両者それぞれの反応をするが何やら様子がおかしい。\n姉妹を持ち上げる代わりに境内の掃除を終えて蒸れに蒸れた足袋、左足のそれを脱ぐ牡丹。\nすると牡丹が「それじゃあ、お仕置きねぇ…♡」と言って姉の方を優しく踏む。\n巨大な親指と人指し指の隙間から上半身を出す形になった六花は濃密なニオイを嗅がされてしまう。\n一方、普段とは違うお仕置きでさらには姉だけ踏まれた妹の莎草は困惑気味。\nそんな莎草を牡丹が左手で持ち上げ、右手で持っていた先程脱いだ足袋に入れてしまう。\n足袋の底までゆっくり落ちてしまう莎草。\n足袋の中の莎草を見透かす様にして、そのまま座った牡丹はにまぁ…♡と悪い笑みを浮かべるのでした。\n\n◆構図\n・場所は神社の一室を想定（和風の室内なら大丈夫）\n・御話準拠の構図\n→床に座った牡丹を正面に見据えて右側（左足）が素足で姉を踏んでいる（右足は足袋のまま）\n→左側（右手）で莎草の入った足袋を持ち上げている（足袋の指先相当の部分が目線に来る高さ）\n・牡丹がにまぁ…♡と興奮気味のわる～い顔で足袋を見ている、服装は資料準拠の巫女服\n・右上の空いたスペースに半透過で足袋内の妖狐のニオイに中てられてむせつつ興奮気味の莎草を\n・左下の空いたスペースに素足で踏まれて足指の隙間で同じくニオイに中てられて抵抗しつつも顔が赤い六花を\n・持った足袋と両足に蒸れた表現（素足の方を強めに）\n・牡丹の巨乳と顔が曲げた足に隠れないアングルで\n\n◆人物（容姿は資料URLをご覧ください）\n「牡丹」（人形態）\n・自称わる～い狐のお姉さん\n・はだけた巫女服に目立つ巨乳が自慢\n\n「莎草」\n・白菫色の方\n・普段は引っ込み事案な垂れ目の妹\n\n「六花」\n・薄桜色の方\n・普段は勝気でツンな釣り目の姉\n\nフェチ度マシマシだと喜びます。\n内容がNGであればキャンセル、金額不足であれば放置してくださいませ。\nまた、依頼が叶いましたらぜひウチの子を紹介する際の資料とさせていただければ幸いです。\nご縁がありましたらぜひお願い致します。\n\nhttps://drive.google.com/drive/folders/18DwlflgWwO18rxS1nfskNrG6WrqkBYK3?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@miu_size/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 441999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee4ace1039271e0740443c361b4734e", "srcset": "https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ee4ace1039271e0740443c361b4734e, https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3247e0025dc06aa6b0e65c12270657e9 2x, https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8885a16a71990914edb1cca3188b3a10 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433bd5d2353cff928d9c77b55a9e4fec", "srcset": "https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=433bd5d2353cff928d9c77b55a9e4fec, https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fbda82adc86d83c8103288d32f0c2389 2x, https://si.imgix.net/4fbddfa4/uploads/origins/89643a57-a827-4880-8b96-f30b22aacacc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a1fdd1bac1ecc860964946eb4db2087 3x"}, "body": "はじめまして、お世話になります。\n以下の内容でリクエストさせて頂きます。\n\n[シチュエーション]\nアクシデントにより女生徒の鞄経由で更衣室まで運ばれてしまった小人族の学生\n何とか抜け出そうとするも見つかってしまいまい、無慈悲な処刑シーンへ\np1:見下ろしながら冷徹に足裏を翳す女生徒を足下の小人学生視点で見上げたあおり構図、足裏メイン\n\np2:床透過視点\n女生徒の容赦ない踏み潰しが小人学生を襲い、巨大な素足が持ち上げられた後に残った蒸れ足跡にはぺちゃんこになった小人学生の姿\n（足袋差分も可能でしたらお願いします）\n※複数ページが難しければP.2のみでもご依頼できれば幸いです\n\n[キャラクター]\n・女生徒\n種族：人間\n性格：冷徹かつ冷酷\n容姿：\n身長175cm\n足はギリシャ型で27cm\n白い肌に濡羽色の髪\n髪型は前髪をラフめのMバング、後ろは腰辺りまでの長さのロングヘア\n美形の中性的顔立ちで切れ長の目、赤色の瞳\n線細めの身体にうっすら脂肪と筋肉の乗った精悍体型\n胸はCカップ程度の膨らみ\n\n\n服装：\n藍色の着物姿に素足\n\n・小人学生\n種族：小人族\nブレザー制服姿\n身長は2cm\n褐色肌に髪は赤銅色で細ポニーテール\n他の容姿はお任せします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@miu_size/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4