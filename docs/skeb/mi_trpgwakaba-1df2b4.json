-ad88-61bbbd596668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=062be52324b1a76e864037aacc8dda4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/092d14d7/uploads/origins/f56d53ee-42f3-4352-ad88-61bbbd596668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e35758dc20b16ca99acd70ce3c4c6838", "srcset": "https://si.imgix.net/092d14d7/uploads/origins/f56d53ee-42f3-4352-ad88-61bbbd596668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e35758dc20b16ca99acd70ce3c4c6838, https://si.imgix.net/092d14d7/uploads/origins/f56d53ee-42f3-4352-ad88-61bbbd596668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afacf809a0a90ed4a3cc350585e0f0b7 2x, https://si.imgix.net/092d14d7/uploads/origins/f56d53ee-42f3-4352-ad88-61bbbd596668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4af6f94f6b27f490187cf44245e3d9a 3x"}, "body": "さばやま様,こんにちは!!\n\nとても可愛いらしく素敵な作品を拝見させていただきました。リクエスト失礼いたします....!!\n\nキャラクターは光と彩斗です\n相棒です!\n資料URLに画像を添付したので参考にして下さい。URL先には彼らのストーリーが掲載されています。お読みいただけましたら幸いです！\n\n八木 光：\n外見：左上から右下にかけて金と黒の斜めグラデーションの髪。左目は黒、右目はオレンジピンク。垂れ目で太眉。左耳たぶに黒いイヤーカフ、右耳たぶにほくろ。  \n身長：175cm  \n年齢：25歳  \n性格：繊細な犬系男子。時に突飛で電波的な思考を持つが、常に笑顔を絶やさない。\n通常は自称として「俺」を使い、改まった場では「私」を用いる。江川に対しては基本的に「彩斗（あやと）」または「彩斗くん」と呼び捨てにする。\n\n江川 彩斗：\n外見：灰白色の髪に左側に虹色のハイライト、もみあげは長めで小さな三つ編みあり。生姜色の切れ長の目に細眉。口角左下にほくろ。長いライン状のイヤリング。中性的で美形。  \n身長：171cm  \n年齢：25歳  \n性格：軽薄系の狐男子。口は軽いが意外と純情で理性的なタイプ。常に笑顔を絶やさない。\n親しい人間の前では「俺」と自称し、それ以外の場では全て「私」を使う。八木に対しては普段「おい」「そいつ」「八木」「おまえ」と呼び、真面目な場では「光（こう）」と呼ぶ。冗談や皮肉を込める際には、女性名の発音である「光（ひかり）」と呼ぶことがある。\n\n---\n\n警視庁捜査一課の刑事で相棒関係。現在は友人以上恋人未満。役割としては「光（攻め）」「彩斗（受け）」。  \n\n関係性：  \n・表面上は喧嘩ばかりする「犬猿の仲」だが、心底では互いを大切に思っている。  \n・仕事では絶妙な連携を見せ、光は接近戦、彩斗は銃器と指揮を得意とする。  \n・プライベートでは些細なことで小学生のような口喧嘩をするが、根本的には憎み合わない。  \n・彩斗はたまに光に軽口を叩いてからかうが、それは単なる遊び心からの行動。\n\n使用目的：個人利用および展示のみを目的としており、商用利用は一切含まれません。\n\n長文をここまで読んで頂き、ありがとうございました。\n何卒ご検討いただければと思います!\n\nhttps://weibo.com/7793451937/5171464116110221\n\nhttps://weibo.com/7793451937/5171464116110221", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mi_trpgwakaba/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3641744, "client_id": 3153663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/256b0709/uploads/origins/85dc5299-561c-49fc-8f3e-1ead574e53bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9522c4210479ef70db636e94549cd2c", "srcset": "https://si.imgix.net/256b0709/uploads/origins/85dc5299-561c-49fc-8f3e-1ead574e53bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9522c4210479ef70db636e94549cd2c, https://si.imgix.net/256b0709/uploads/origins/85dc5299-561c-49fc-8f3e-1ead574e53bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f47f7f0041b439d2b201d0b1c57d344 2x, https://si.imgix.net/256b0709/uploads/origins/85dc5299-561c-49fc-8f3e-1ead574e53bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a988a1705c9bf9a55fb0aa947bd7195d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/256b0709/uploads/origins/85dc5299-561c-49fc-8f3e-1ead574e53bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e79915ab5c8a531b9e0bc7c69ef93eb6", "srcset": "https://si.imgix.net/256b0709/uploads/origins/85dc5299-561c-49fc-8f3e-1ead574e53bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e79915ab5c8a531b9e0bc7c69ef93eb6, https://si.imgix.net/256b0709/uploads/origins/85dc5299-561c-49fc-8f3e-1ead574e53bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d161921987e0901153907eb1da568c6a 2x, https://si.imgix.net/256b0709/up