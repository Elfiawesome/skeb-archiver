み先生が描かれる男性キャラがとても好きなので、今回こうして自分の趣味を全開にしたリクエストをお送りすることができただけでも嬉しいです！///\nかなり好き勝手に要望を記載してしまいましたので、可能な部分がどこまでかをご勘案いただけますと幸いです！\n\nここまでお読みくださり、ありがとうございました！！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1444810, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🏈", "screen_name": "apple_pie_no1", "avatar_url": "https://pbs.twimg.com/profile_images/1986814080896946176/LeUGs2cz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1986813066349346816/1762528885/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 1825019, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とのじ", "screen_name": "TOTOTOTO_TK", "avatar_url": "https://pbs.twimg.com/profile_images/1834564169791922176/k_MHE-ds.png", "header_url": "https://pbs.twimg.com/profile_banners/362002239/1739467323/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1932085, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ホレニナ", "screen_name": "hore__nina_", "avatar_url": "https://pbs.twimg.com/profile_images/2031617183705608200/nfK83k08.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1497696666958581764/1773743336/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 45, "skills": [{"genre