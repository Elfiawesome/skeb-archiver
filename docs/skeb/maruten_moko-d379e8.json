もお願いいたします。\n・可能であれば、PSD形式で納品していただきたいです。\n\n◆本人のSkeb依頼可否について\nリンク先最下部にSkebイラスト依頼が可能な旨明記されています。\nhttps://lit.link/touyalukua\n\n◆新衣装（髪型）\n・https://x.com/touya_lukua/status/1894667468678771013\n・https://x.com/touya_lukua/status/1895331956671611301\n\n以上です。\nよろしければ、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1angDfYNM7eBeXacpoRalf3NliBH2HP9t?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruten_moko/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3841315, "client_id": 1253239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/334292ed/uploads/origins/2b66ca12-8552-459a-8a77-ec59ba4b52a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df75a2b9b29bb233e3f7272db3c4f241", "srcset": "https://si.imgix.net/334292ed/uploads/origins/2b66ca12-8552-459a-8a77-ec59ba4b52a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df75a2b9b29bb233e3f7272db3c4f241, https://si.imgix.net/334292ed/uploads/origins/2b66ca12-8552-459a-8a77-ec59ba4b52a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f31fc87c6c8ad1e0529bdae437310cb7 2x, https://si.imgix.net/334292ed/uploads/origins/2b66ca12-8552-459a-8a77-ec59ba4b52a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23cbeeed34cbbe0ff7ae0c7ad9b398e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/334292ed/uploads/origins/2b66ca12-8552-459a-8a77-ec59ba4b52a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a64e503a7e0970a60411b811bdd3171", "srcset": "https://si.imgix.net/334292ed/uploads/origins/2b66ca12-8552-459a-8a77-ec59ba4b52a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a64e503a7e0970a60411b811bdd3171, https://si.imgix.net/3