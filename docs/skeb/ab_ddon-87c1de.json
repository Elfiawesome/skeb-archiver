7\u3066\u3082\u5c11\u3057\u53b3\u3057\u3081\u3060\u304c\u512a\u3057\u304f\u63a5\u3057\u3066\u304a\u308a\u61d0\u304b\u308c\u3066\u3044\u307e\u3059\u3002 \n\u3068\u3066\u3064\u3082\u306a\u304f\u30b9\u30c8\u30a4\u30c3\u30af\u3067\u3001\u7121\u81ea\u899a\u3067\u30b9\u30d1\u30eb\u30bf\u304c\u904e\u304e\u30d1\u30ef\u30cf\u30e9\u306e\u3088\u3046\u306b\u306a\u3063\u3066\u3057\u307e\u3046\u4e00\u9762\u304c\u3042\u308a\u307e\u3059\u3002 \n\u7518\u3044\u3082\u306e\u304c\u597d\u304d\u3067\u30c4\u30a2\u30fc\u6700\u7d42\u65e5\u306b\u306f\u3054\u8912\u7f8e\u306b\u7518\u3044\u3082\u306e\u3092\u98df\u3079\u307e\u304f\u308b\u914d\u4fe1\u3092\u3057\u3066\u3044\u307e\u3059\u3002 \n\u672c\u6765\u306f\u5fc3\u512a\u3057\u3044\u738b\u5b50\u69d8\u306e\u30a4\u30e1\u30fc\u30b8\u306b\u53cd\u3057\u3001\u30d7\u30e9\u30a4\u30c9\u304c\u3068\u3066\u3082\u9ad8\u304f\u3001\u5f8c\u8f29\u306b\u5bfe\u3057\u3066\u3082\u4ed5\u4e8b\u4ee5\u5916\u3067\u306e\u4eba\u683c\u9762\u306b\u95a2\u3057\u3066\u306f\u7121\u95a2\u5fc3\u5bc4\u308a\u3067\u3059\u3002 \u306a\u3093\u304b\u3064\u3044\u3066\u304f\u308b\u3061\u3044\u3055\u3044\u306e\u7684\u306b\u601d\u3063\u3066\u3044\u308b\u7bc0\u304c\u3042\u308a\u307e\u3059\u3002  \n\n\u91d1\u9aea\u306e\u65b9 \u82b8\u540d:\u904d\u30de\u30e6(\u3042\u307e\u306d\u307e\u3086) 17\u6b73\u3000158cm \n\u672c\u540d:\u7e6d\u7d79\u3055\u306a\u304e(\u307e\u3086\u304e\u306c) \n\u771f\u9762\u76ee\u3067\u5fc3\u512a\u3057\u3044\u5c11\u5e74\u3067\u3059\u3001\u6b73\u306e\u5272\u306b\u5927\u4eba\u3073\u3066\u304a\u308a\u3001\u786c\u3081\u306e\u656c\u8a9e\u3067\u8a71\u3057\u307e\u3059\u3002 \u30a2\u30a4\u30c9\u30eb\u3068\u3057\u3066\u306f\u840c\u3048\u30ad\u30e3\u30e9\u58f2\u308a\u3092\u3057\u3066\u3044\u307e\u3059\u3002 \n\u8096\u306e\u5f8c\u8f29\u3067\u3042\u308a\u3001\u30c1\u30fc\u30e0\u30e1\u30f3\u30d0\u30fc\u3067\u3042\u308a\u306a\u304c\u3089\u8096\u306e\u30ac\u30c1\u30aa\u30bf\u30af\u3067\u3059\u3002 \u3069\u3093\u306a\u306b\u30ad\u30c4\u304f\u3042\u305f\u3089\u308c\u3066\u3082\u8096\u5148\