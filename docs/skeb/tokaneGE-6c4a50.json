h=200&blur=200&s=ffeba4b0bd4c1c15f17afe66804b0fc4 3x"}, "body": "久しぶりのリクエストです。\nSEXを無知な美男子が教室でイケメン男子を背面騎乗位で犯してしまうシチュお願いします。\n\n無知な美男子の髪の色：黒色\nイケメン男子の髪の色：銀色\n\n無知な美男子の服装\n上：裸\n下：裸\n靴下：膝の下まである白ハイソックス\n靴無し\n\nイケメン男子の服装\n上：体育着\n下：裸\n靴下：膝の下まである赤ハイソックス\n靴無し\n\nアングル：全身、2人の顔写ってると嬉しいです。\n※身体が画像からはみ出ないようお願いします。\n挿入前、挿入後（激しい）、事後（精子がハイソックスや太ももなどに飛び散る）でお願いします。\n\n以上よろしくお願いします", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tokaneGE/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e140478d/uploads/origins/cb465739-6a34-4956-96f2-99526171943b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a238a3fd2e6c78c60d90b78f2632072", "srcset": "https://si.imgix.net/e140478d/uploads/origins/cb465739-6a34-4956-96f2-99526171943b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a238a3fd2e6c78c60d90b78f2632072, https://si.imgix.net/e140478d/uploads/origins/cb465739-6a34-4956-96f2-99526171943b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=777a0c5c97d4643ffbaa74fbf0d0bf9e 2x, https://si.imgix.net/e140478d/uploads/origins/cb465739-6a34-4956-96f2-99526171943b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbca8fdd265fa54071f133f5dbf52e20 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1076745, "client_id": 1793917, "nc": 49}, {"path": "/@tokaneGE/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1076745, "client_id": 845086, "vtt_url": null, "thumbnail_image_url