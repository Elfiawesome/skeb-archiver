-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2119028991bc015607a4720b9420e096", "srcset": "https://si.imgix.net/f85d5e27/uploads/origins/d523467d-3f09-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2119028991bc015607a4720b9420e096, https://si.imgix.net/f85d5e27/uploads/origins/d523467d-3f09-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed68ccbbaef8c29d96581ee271f183e2 2x, https://si.imgix.net/f85d5e27/uploads/origins/d523467d-3f09-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bb8814787278087b4092ad543a86c95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f85d5e27/uploads/origins/d523467d-3f09-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b4afcb032ea90b94fb5ee40f46afde", "srcset": "https://si.imgix.net/f85d5e27/uploads/origins/d523467d-3f09-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5b4afcb032ea90b94fb5ee40f46afde, https://si.imgix.net/f85d5e27/uploads/origins/d523467d-3f09-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=057846b2c8db520a5e4236c2d3a47b19 2x, https://si.imgix.net/f85d5e27/uploads/origins/d523467d-3f09-413f-b7ac-3183ecd704db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2fef9860258bdf1015dc96187dd1fe9e 3x"}, "body": "とりにく様、前回は素敵なイラストをありがとうございました！\nとりにく様が描いてくださったイラストが大変素晴らしく、今回もぜひお願いしたくメッセージを送らせていただきました。\nskebでのご依頼にはまだ不慣れな点も多く、至らないことがございましたら申し訳ありません…！\n\n参考資料を添付しておりますので、ご確認いただけると幸いです。\n\n⸻\n\n【リクエスト内容】\n･OCのイラスト\n\n具体的な構図や表情などは、全てとりにく様にお任せできればと思っております。\nとりにく様の表現や解釈を反映していただければ幸いです。\n\n⸻\n\n【使用用途】\n･SNS使用（アイコン/ヘッダー含む）\n･私的利用範囲内でのグッズ化\n第三者へ依頼する際、資料として提示する場合があります。\n\n⸻\n\n【キャラクター概要】\n◇空木葵(うつぎ あおい)\n17歳/高校2年生/150cm\n\n青空を思わせる青と水色のグラデーションの瞳と、濃すぎない黒髪に白寄りの淡い水色インナーカラーが特徴的な少女。\n外見は優しく控えめな印象で、姿勢や仕草から自分を小さく見せようとする癖が見られる。\n\n彼女は本来18歳の高校3年生だが、「変わりたくない」「今のままいたい」という無意識の願いが学校に潜む怪異に拾われ、世界から『高校2年生として固定された存在』となっている。\nなお、選ばれたわけではなく、ただ偶然つけこまれやすい心を持っていただけで、葵自身に特別な理由はない。\n本来の姿や記録は書き換えられ、本人も周囲も違和感なく彼女を2年生として扱っている。\n\nこの状態が続けば、空木葵という1人の生徒ではなく、姿形はそのままに、校内で語られる怪異『進級しない子の噂』として存在が固定される可能性がある。しかし、周囲どころか本人さえも、その異変に気付いていない。\n\nまた、強い自己否定によって破綻した場合は、同じ外見を持つ別存在『青井そら』へ変質し、教室に縫い付けられたような、異質な怪異的存在に姿を変える。\n\n\n⸻\n\n【資料】\nキャラ資料はこちらにまとめております:\nhttps://drive.google.com/drive/folders/1N4zPtfEj1JLTnwirTFQ1gXdNQvawW5Rp\n\n⸻\n\n長文失礼いたしました。\n内容やスケジュールが合わない場合は遠慮なくキャンセルいただいて問題ございません。\nご検討いただけましたら幸いです…！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tori_paku2/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f192f505/uploads/origins/37fb26bc-2885-454d-92a8-dd8ef5245860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c6533f3b05df5280d1eba8f04874804", "srcset": "https://si.imgix.net/f192f505/uploads/origins/37fb26bc-2885-454d-92a8-dd8ef5245860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c6533f3b05df5280d1eba8f04874804, https://si.imgix.net/f192f505/uploads/origins/37fb26bc-2885-454d-92a8-dd8ef5245860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bc01e9168d5f353b6de84e60d58edd0 2x, https://si.imgix.net/f192f505/uploads/origins/37fb26bc-2885-454d-92a8-dd8ef5245860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt