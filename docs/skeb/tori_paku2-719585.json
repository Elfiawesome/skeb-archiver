ins/1d2ed5af-e1b3-45d4-9608-055e9a7abbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb00554a7aa8246568a8b7f3d9367c37", "srcset": "https://si.imgix.net/d5ba6001/uploads/origins/1d2ed5af-e1b3-45d4-9608-055e9a7abbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb00554a7aa8246568a8b7f3d9367c37, https://si.imgix.net/d5ba6001/uploads/origins/1d2ed5af-e1b3-45d4-9608-055e9a7abbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a318d67e159ceebe9f14c7c9ab13e01f 2x, https://si.imgix.net/d5ba6001/uploads/origins/1d2ed5af-e1b3-45d4-9608-055e9a7abbf3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3b68053b129503681a915c5e23536d3 3x"}, "body": "初めまして、IRIAMというアプリでVライバーをしている雨野 緑と申します。\n先日Xにてとりにく🕊️さまのイラストをお見かけし大変素敵だなと思い、良ければ私、雨野緑のイラストも書いて頂きたいと思い今回リクエストを送らせていただきます。\n（特に原神の放浪者のイラストが本当に好きです！！）\n\n・使用用途\nX等のSNSへの掲載、IRIAM活動での返礼品としてのヘッダーなどへの利用（商用利用）を考えております。\nそのため可能であればキャラクターだけの透過画像もいただけると嬉しいです。\n\n・内容\n雨野 緑を描いていただきたいです。\n\n構図などについてはお任せいたします、衣装ついては2種類ありますがとりにく🕊️さまのお好きな方を描いて頂いて構いません。\n\n雨野緑の参考画像はこちらになります。\nhttps://drive.google.com/drive/folders/1Is9bJpFaNp7XgtSkmcnT6pSIx6Ud2lZw\n\n可能であれば髪の毛など見切れないようにしていただけると助かりますがとりにく🕊️さまが描きやすい方でお願いします。\n\nSkebでの依頼がまだ少なく不慣れなことも多く、また希望もたくさん出してしまいましたがご縁があれば何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Is9bJpFaNp7XgtSkmcnT6pSIx6Ud2lZw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tori_paku2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3607648, "client_id": 1033271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2f75769/uploads/origins/244215cc-75ec-494e-8409-4e3c68aa23ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04fe64e1c94ce5e48b654b3e23e33068", "srcset": "https://si.imgix.net/c2f75769/uploads/origins/244215cc-75ec-