rigins/8b9247b8-9890-4bc0-8462-1d9f529d46f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3019dbc5e95ff8642187d2490e4ea5c, https://si.imgix.net/0114180c/uploads/origins/8b9247b8-9890-4bc0-8462-1d9f529d46f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ed56184d8db98547252454afad7609 2x, https://si.imgix.net/0114180c/uploads/origins/8b9247b8-9890-4bc0-8462-1d9f529d46f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=294dc576f4a2825252915da7c2b96173 3x"}, "body": "萌ノうに先生、こんにちは。\n---\nテーマ：うちの子・藤城月乃のお嬢様っぽい雰囲気の一枚絵\n\n1. 普通の子ですが、お嬢様のような上品さがあります（「わたなれ」の瀬名紫陽花に近い雰囲気）\n2. 背景あり（簡単でもOK）\n3. 服装は先生のオリジナルで大丈夫です\n4. 華やかでなくても、更衣中のシーン（下着姿など）でも、お嬢様らしい雰囲気が感じられるイメージです。\n\nPSD形式で、宛名・人物・背景のレイヤー分けを希望します。\n\n用途：\n＊SNS、個人サイト( https://k-y.win/ )展示用\n＊他のイラストレーターの参考用\n\n參考: https://k-y.win/chara/tsukino\n\nお気に入りの先生のイラスト：\nhttps://skeb.jp/@03ioi/works/4\nhttps://www.pixiv.net/artworks/119340927\nhttps://www.pixiv.net/artworks/118777200\nhttps://www.pixiv.net/artworks/88121865\nhttps://x.com/03ioi/status/1930200483651825973\nhttps://x.com/03ioi/status/1854105690073362536\nhttps://www.pixiv.net/artworks/79806466\n\n--\nThanks", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@03ioi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1540826, "client_id": 8407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e456bd2f/uploads/origins/c889c6d9-f627-47ce-80bb-7f9fc0e72a68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80189162178ac9ef8a96007f8da2474f", "srcset": "https://si.imgix.net/e456bd2f/uploads/origins/c889c6d9-f627-47ce-80bb-7f9fc0e72a68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80189162178ac9ef8a96007f8da2474f, https://si.imgix.net/e456bd2f/uploads/origins/c889c6d9-f627-47ce-80bb-7f9fc