g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b49af294e8134ad92e67fe53d85dffd9, https://si.imgix.net/24033b77/uploads/origins/e3bc0fa0-bb55-4e06-b500-54490eee9e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56c9f1211a25aa0950b2e6a09fa5142b 2x, https://si.imgix.net/24033b77/uploads/origins/e3bc0fa0-bb55-4e06-b500-54490eee9e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed7fa44ee3146660eda27593a189542d 3x"}, "body": "初めまして、突然ですがリクエストさせていただいてもよろしいでしょうか？\n\nキャラはラブライブの高坂穂乃果ちゃんでお願い致します！\n\n\nスクール水着姿の穂乃果ちゃんが手刀で気絶させられイタズラされるシチュエーションを希望します。\n\n\n・背後から首筋を手刀で叩かれるシーン\n・「う〜ん…」と気絶し、倒れないように後ろから抱き止められるシーン\n・寝かされるか、座らされて胸を触られるシーン\n\n以上があれば嬉しいです！\n\n気絶してる寝顔はギャグ調ではなく目を閉じて、冷や汗や涙は無しで。スクール水着は肩紐が白い競スクを希望致します。\n\nその他台詞や構図はお任せ致します。\n\n当方気絶フェチのため変なリクエストで申し訳ありませんが、ご検討いただければ幸いです！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aqua_blue/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 388061, "client_id": 999604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ca23c45/uploads/origins/6509c786-1128-4f8d-8d73-246cc485820e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9ef3fe079f0872ba93bb1eb06aa8ba", "srcset": "https://si.imgix.net/0ca23c45/uploads/origins/6509c786-1128-4f8d-8d73-246cc485820e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9ef3fe079f0872ba93bb1eb06aa8ba, https://si.imgix.net/0ca23c45/uploads/origins/6509c786-1128-4f8d-8d73-246cc485820e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0443ac24b1025c42f526dae227c8572 2x, https://si.imgix.net/0ca23c45/uploads/origins/6509c786-1128-4f8d-8d73-246cc485820e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba6e42b9447c51c8c57485f58f4d6861 3x"}, "duration": nul