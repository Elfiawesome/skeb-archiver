rigins/a6e826c6-d7de-46b0-b4c9-bb9b7a5d0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af03fd54dc11ec731d4811fd66b2a178, https://si.imgix.net/ce12c29d/uploads/origins/a6e826c6-d7de-46b0-b4c9-bb9b7a5d0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f22d3c2e5a53b94ee41cfdabb38ff200 2x, https://si.imgix.net/ce12c29d/uploads/origins/a6e826c6-d7de-46b0-b4c9-bb9b7a5d0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40e15ed497227c2eea062f06cecd88a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce12c29d/uploads/origins/a6e826c6-d7de-46b0-b4c9-bb9b7a5d0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ca33ad250951b3e098e7acea2a16ae2", "srcset": "https://si.imgix.net/ce12c29d/uploads/origins/a6e826c6-d7de-46b0-b4c9-bb9b7a5d0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ca33ad250951b3e098e7acea2a16ae2, https://si.imgix.net/ce12c29d/uploads/origins/a6e826c6-d7de-46b0-b4c9-bb9b7a5d0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f1a4ecac5a192b380fc82b8fff02f88 2x, https://si.imgix.net/ce12c29d/uploads/origins/a6e826c6-d7de-46b0-b4c9-bb9b7a5d0f10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8968ffd4dd01ef22f34295025cdd22b 3x"}, "body": "松谷様こんにちは。背景美術が素敵で、ぜひイラストを描いていただきたいと考えています。\n\n【詳細】\n今回お願いしたいのは、創作キャラクターとアイドルマスターSideMの山下次郎の夫婦です。版権が難しい場合は気兼ねなくお断りください。\n\n【用途】\nこのカップルの創作活動を主にしている鍵アカウント(skebに登録しているアカウントとは別のアカウント)で作者様へのメンションをつけてツイートさせて頂きたいと考えています。その際、作者さまが描いてくださったという旨は記載いたします。\n\n【キャラクター】\n女性はキザで清楚な性格で、夫の所属するアイドル事務所の事務員です。\n［身体的特徴］\n163cm\n口の左下にほくろ\n若緑色の髪\n金のシンプルな結婚指輪\n資料にミディアムヘアのものとショートヘアのものがありますが、どちらでも問題ありません。\nオフィスカジュアルや、ナチュラルな服装を好みます。\n\n山下次郎は優しく少し情けない男性です。アイドルです。\n［身体的特徴］\n185cm\n30歳\n口髭、顎髭あり\n猫背ぎみ\n金のシンプルな結婚指輪\n筋肉質\nすね毛が生えている\n人前だと変装として眼鏡やサングラスをします\n資料に髪を上げたものと片目が隠れたものがありますが、できれば片目が隠れたものでお願いしたいです。\n\n女攻めのカップルで、山下はいつも彼女には敵わないと感じています。仲睦まじく、落ち着いたカップルで、三毛猫を飼っています。\n\n【アイデア】\nお好きにアレンジしていただいて構わないのですが、以下が私のアイデアです。また、ここから逸脱してしまっても構いません。\n\n花屋でお花を選んでいるふたりが見たいです。\n二人の顔は見えても見えなくても構いません。背景優先で、お好きなアングルから捉えてください。\n山下はサングラスをしています。(形状は一般的なものであればなんでも構いません。)\n店先でも、店内でも構いません。\n季節は夏か春が好ましく、また夏頃であれば向日葵、春頃であればチューリップが写っていると嬉しいです。\n\nわたしのリクエストをご検討くださりありがとうございます。\n\nhttps://drive.google.com/drive/folders/1-9oUiwSOJ1ghjs9Tdqb81w9iQC34oH0G", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1745659, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ARETE NANI", "screen_name": "28_berakhah", "avatar_url": "https://pbs.twimg.com/profile_images/1919215244586704896/Z650KbeO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1090181716466065409/1741060207/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 17}, {"id": 2647475, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ｻﾄｳｲﾂｷ", "screen_name": "satoitsuki_TRPG", "avatar_url": "https://pbs.twimg.com/profile_images/1993777168195964931/fgtyfndO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1078962356087021568/1764481010/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "nc": 32}, {"id": 2815269, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Qu6o", "screen_name": "Qu6oom", "avatar_url": "https://pbs.twimg.com/profile_images/1915744509360828416/gvJlh