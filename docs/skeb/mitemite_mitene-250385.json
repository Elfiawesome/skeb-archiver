d&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36fdf90dd957f4bbd542990ce414a4e9", "srcset": "https://si.imgix.net/57470437/uploads/origins/19c63217-ce60-4625-9a8a-3a3f68a59765?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36fdf90dd957f4bbd542990ce414a4e9, https://si.imgix.net/57470437/uploads/origins/19c63217-ce60-4625-9a8a-3a3f68a59765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b88448916780990eacae895a620c91ad 2x, https://si.imgix.net/57470437/uploads/origins/19c63217-ce60-4625-9a8a-3a3f68a59765?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2a867204d11848a8d1f6044805333f80 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2586590, "client_id": 2963141, "nc": 16}, {"path": "/@mitemite_mitene/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2586590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37ac4b38044fc0b4042a8f0f0ce9bc95", "srcset": "https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37ac4b38044fc0b4042a8f0f0ce9bc95, https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e46deaa9d9e507c835a14f2a2a8f263 2x, https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d419645fab08e018b4344a0b7ca209c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7db9a7bea8e29a9236c31b17f7fe2d", "srcset": "https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7db9a7bea8e29a9236c31b17f7fe2d, https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f5b3dd5c5358e8dda5708ce32a08ed1 2x, https://si.imgix.net/e7f76ce2/uploads/origins/794f452c-be2c-4775-ae54-d23d54db27de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c37b90f0932ab41ae9e110c6203acc7 3x"}, "body": "Mr. Sekiguchi, it is nice to meet you. Thank you very much for your support.\nI have seen your various absurdly cute illustrations on X (formerly Twitter), and I would like to request your help due to other reasons.\n\nThis time, I would like to ask Sekiguchi-sama to draw two of my favorite characters in a happy and cute way.\nI would like to see two diffs of them in a princess's embrace, pushing down all my embarrassing feelings.\n\nThe first one is of a girl who is happy while being hugged by a princess, with the boy making a face like \"I don't know what's making you happy\" (I'm not sure how happy she is...I don't know...I feel love with an emotion similar to a sense of security).\nI would be happy if you could draw a boy who is kissed by the girl with the difference between the two, and his cool expression collapses and he is excited.\n\nI've posted various reference materials at the URL below, but I'll really leave it up to you to decide how much you want to see.\nAll of them are the best illustrations that saved my life, but many of them are a little sad and angsty, so please just make them happy with Sekiguchi-sama's cute illustrations, I don't care what it was as long as those two are happy.\n\nI would appreciate it if you could look at the first two URLs to understand the relationship and the characters. The rest of them are cute, but if it's too much trouble, it's fine.\nI didn't put illustrations with darker lines as much as possible because it would make it hard for me.\n\nI think that with this much I can draw without having to search for reference materials....\nThere are various kinds of fan art, but I would be happy if you could make me feel cute and cuddly along the lines of Sekiguchi-sama's illustrations.\nI leave it completely up to you how to draw it. If it's too much trouble, you can cancel it at all. If you have any other ideas, you can change the situation.\n\nIf you have any other ideas, you can change the situation.\nThank you for giving me a chance to practice this time.\n\nBy the way, I like both of them very much, but my favorite is the guy.\nPlease make him happy.\n\nDoujinshi of the original illustrator (still available on the net) /Please use this work as a standard.\nhttps://photos.app.goo.gl/s3xJhPsKWLERtnLK8\n\nGhost Ship (a doujinshi of a later version of the main story by someone who later became a professional: it's available for free) / I'd be happy if you could use it to understand the relationships and personalities of the characters.\nhttps://photos.app.goo.gl/SDswo8vnuFFJX5aJA\n\nOfficial pictures: reference picture of heroine's back hair, original scene of princess hugging & others/ Many of them are very painful for me, but for those who don't know, they are just official pictures!\nhttps://photos.google.com/u/1/share/AF1QipPBX_uG5MFpBfEUeSOzbpsHIFuCW0hftxjEg2d7zqnpBkazzQgAm6-bdamOkYGV7Q?key=bXJVNk9qM2hzTGNFbDd 3TnVIMElqZjVsWDlSeTB3\n\nMy favorite painter A's work/ I like his work the most because it fits me the best. I sleep every day looking at his picture of the two smiling faces.\nhttps://photos.google.com/u/1/album/AF1QipM6zL4_CdHsCHxHHs5SbD6n_9FMyWWB19FjGDvE\n\nMy favorite painter B's work/I like his work the most, I feel his sexuality.\nhttps://photos.google.com/u/1/album/AF1QipMhXOsROC7St8vGy1nsbBbJKNITNso1hQfbsxYY\n\nOther cute ones and others/ Various other illustrations that saved my life, the Santa one is too cute.\nhttps://photos.google.com/u/1/album/AF1QipP12uek16nUYe_TxNX_np41oWshL60lR62Ob1wZ\n\nI would really appreciate it if you could help me out.\nPlease draw whatever you really want. I'm happy just to have new illustrations of these two people being happy. Seriously....\n\nSeriously, just do it in your spare time....", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mitemite_mitene/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2586590, "client_id": 2963141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2038c894230ffba59191319b49e6a656", "srcset": "https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2038c894230ffba59191319b49e6a656, https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6be20a4136b19f548933ccc7caa81a1 2x, https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae911e60f5750720fa911df1f3f875a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e3d5c4143606eb78c1f3ed41a08ce5", "srcset": "https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2e3d5c4143606eb78c1f3ed41a08ce5, https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6553b31b5fd7e73239201df5a72ad81f 2x, https://si.imgix.net/4e5a4472/uploads/origins/bd1fb618-e01e-4659-a595-23c490107691?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75996e4d6948d35f300c5023e8e62444 3x"}, "body": "Hi, my name is Koala 🙇‍♀️\n\nThank you for all your wonderful illustrations! I love 🙇‍♀️ sekiguchi's illustrations ✨️\n\nThe OC illustration you did for me before was really wonderful, and I thought I would like to ask you to do it again if you could do it for me!\n\nHere are the details\n\nThe height difference between the two of them and their appearance should be similar to the illustration below.\n\nhttps://drive.google.com/file/d/1T8oMTwC-MrRsHuEjXDHUFUt2LQ5BX1yC/view?usp=drivesdk\n\n［The approximate situation and atmosphere you would like to create.]\n\n(1) OC2 is jealous of OC1 and is messing with him.\n\n2) OC2 is lying in a field of flowers or grass and smiling at OC1.\nI would appreciate it if both of their eyes are open.\n\nPlease choose either (1) or (2) whichever is easier for you to draw. 🙇‍♀️\nWe will also leave the details of the composition and atmosphere to you.\nYou may draw the clothes as you like. 🙇‍♀️\n(It does not have to be a full-length portrait, but we would appreciate it if you can show the expression of the two people in a way that is pleasing to the eye.\nWe would appreciate it if you could include a background if possible for this price!\n\n［Intended use]\nFor personal viewing, for wallpaper on iPads and smartphones.\n\nIf you have any difficulties with the time or the price, please feel free to cancel your request. 🙇‍♀️\nI know I have asked you to be very detailed, but basically you can draw as you like!\nI know it is difficult, but I would appreciate it if you would consider it.\nHere are the details of the two OCs.\nIt is longer than the previous one, so you can read it if you like. 🙇‍♀️\n\n\nOC1 Claudia\n\nAppearance.\nBlonde hair color, hair tied up in a bun on the lower left\nSmall purple earring in diamond shape at lower left\nEyes are a gradient of yellowish green\nHer bone structure is not very stout and slender\n\nHere are some resources: 🙇‍♀️\nhttps://drive.google.com/file/d/1W6VhAyibK6YKMVlDmIMaXhxUkmkuYYlD/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1aSZ9dJQoBvo1z7Vxw-pFTOQh7K9ptxk2/view?usp=drivesdk\n\n27 years old, 178 cm tall, male, uses wind magic\n\nPersonality\nAt first glance, he seems to be a cold person because of his sharp eyes and his inability to show emotion.\nBut in reality, when he sees someone in need, he can't leave them alone and is kind.\nWhen asked to do something, he cannot say no. He is very studious, and when he gets angry, he is scary.\nHe is not very shy when Ralph spoils him, but he thinks it's cute.\n\n［Profession.]\nOriginally a law researcher at a magic school.\nBy order of the director, he changed his occupation to investigate people suspected of using magic to do dangerous things.\nIf asked, she provides free legal advice and prepares documents to be submitted to the court.\n\n OC2 Ralph\nBelow are the documents\n\nhttps://drive.google.com/file/d/1JI3qRQLCMNZb5jMXAaxBQJ1X_LXupY50/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1zE9_9uKxN8wlthH-2_reM6k40XDioxks/view?usp=drivesdk\n\n\nAppearance\nEyes → purple gradient, darker as you go down.\nLeft eye has a pattern unlike the right eye\n\n18 years old, height 168, male\nLives in Claudia's laboratory (with Claudia), uses destructive magic\n\nOccupation\nClaudia's bodyguard\n\nPersonality\nShe has a cute appearance, but has amazing combat ability and magical power.\n\nHe usually wears a cat. Therefore, he is considered by many to be a cute, mischievous, and sweet boy.\nHowever, in his true nature, he is calculating and has a sadistic temperament.\nHe sometimes goes too far in his attacks against his enemies. When he does go too far, he won't stop until Claudia gives him a good beating.\n\nHe is not a fan of\n\nWhen he is alone with Claudia, he is very sweet to her and has a lot of skinship with her.\nShe is dissatisfied with the fact that Claudia treats her like a child.\nShe gets jealous when she sees Claudia talking to other women or being nice to other people.\nHe pretends to be sweet to any woman who has a relationship with Claudia to find out what kind of person she is and whether she likes him or not.\nHe is always trying to show his affection for Claudia, but it seems that he is not taken seriously at all.\n\n［Their relationship.]\n\nIrreplaceable partner?", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mitemite_mitene/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2586590, "client_id": 371232, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d5db24e/uploads/origins/52120bda-72fb-4dea-bc64-4117043d6cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cff87a2988c2ab0d3f51464c842a9ec", "srcset": "https://si.imgix.net/4d5db24e/uploads/origins/52120bda-72fb-4dea-bc64-4117043d6cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cff87a2988c2ab0d3f51464c842a9ec, https://si.imgix.net/4d5db24e/uploads/origins/52120bda-72fb-4dea-bc64-4117043d6cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10e7d40e7af0d1d371b88171668a500f 2x, https://si.imgix