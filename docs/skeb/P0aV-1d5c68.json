大事な仲良しなコンビ\n\nそのほか、衣装などは資料URLの全身図を参考にしていただけますと幸いです。\n\n■希望の納品形式\nレイヤー分けPSDファイル/PNGファイル\n・人物ごとにレイヤーを分けていただけますと幸いです\n・背景ありPNGの場合、人物のみの透過データもいただけますと幸いです\n\n■使用用途\n配信動画のサムネやショート動画、Xのヘッダーや投稿（自己紹介ポストなど）に使用させていただきたいです。当面配信チャンネルは収益化予定はございませんが、将来的に収益化できた際もぜひ長く大事に使用させていただきたいです。\n\nhttps://x.com/futa_isyo/status/1970417591689887881", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P0aV/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2858121, "client_id": 3428919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9d9a30b/uploads/origins/f5412c3f-dbad-42c2-bc20-f6a0a7c6da89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6724cdb66751b946daf08d93b1a8ebee", "srcset": "https://si.imgix.net/a9d9a30b/uploads/origins/f5412c3f-dbad-42c2-bc20-f6a0a7c6da89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6724cdb66751b946daf08d93b1a8ebee, https://si.imgix.net/a9d9a30b/uploads/origins/f5412c3f-dbad-42c2-bc20-f6a0a7c6da89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0bcd70e3677b82db8580b3bfcc3f743 2x, https://si.imgix.net/a9d9a30b/uploads/origins/f5412c3f-dbad-42c2-bc20-f6a0a7c6da89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ea4961b4c1a061db9b259de27f4dcb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9d9a30b/uploads/origins/f5412c3f-dbad-42c2-bc20-f6a0a7c6da89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8d6b82fcafabf5a4cb1c4859b631f6e", "srcset": "https://si.imgix.net/a9d9a30b/uploads/origins/f5412c3f-dbad-42c2-bc20-f6a0a7c6da89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8d6b82fcafabf5a4cb1c4859b631f6e, https://si.imgix.net/a9d9a30b/uploads/origins/f5412c3f-dbad-42c2-bc20-f6a0a7c