ikipediaの「https://ja.m.wikipedia.org/wiki/%E3%82%AF%E3%83%88%E3%82%A5%E3%83%AB%E3%83%95%E7%A5%9E%E8%A9%B1」\nやYou Tubeで検索すると概要が分かると思います。\n飴梨様の精神的に受け付けられない歌ではあるかもしれませんが、何卒よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@kusanoka_ameri/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 1127658, "client_id": 507423, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/d8152a6c-0268-4451-a4f4-5faf584927b4?response-content-disposition=inline&Expires=1779242599&Signature=WuG9A4-EOWjznflPH1BDn~1kkyJ00JbJW8LuGObhkIzjVoNe7xy82JCfz0u9FWrjVqpI8dUqgVyIZ3qQ1kQZ9zZ1y24rkP4-12hsZVHSkKCz-mSW6GBNHVkOrdPnDsksEs-SrhbQdN0JO46rxUQSeYfrQZO~dcXtRI1WHT6Zi~pkZPUjGXM9PfyHpVs3dNEYmJxyk-l13NlzFbODxP5wo9kydVBSKmxcbLbHzPAhIYdA3eisNSTEbNPb0hb6SONXYhusVS6Y0YjC~UrZ3q4VkHl~vBs7NtYbF47K7CcJJM6ZJNGxSj~jQF5iWVN0TljgTBY6FB2S9XwparPvYcYNvg__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985548306429460486%2FxrRpLncj.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a63aaf9024d3a8123dfe8995e9bca231", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985548306429460486%2FxrRpLncj.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a63aaf9024d3a8123dfe8995e9bca231, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985548306429460486%2FxrRpLncj.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09f47038eac4e244d21bc30cf7a16eb9 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1985548306429460486%2FxrRpLncj.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd3beb30bc542f0aa585ed93e8c1238d 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/93a1fae2-1af0-4f9e-93cd-df129f485bcb?