igins/2a10ee8c-8611-44b3-b4bd-3a749d7bc187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e84058b90439fa678ff12496ef98e7be 2x, https://si.imgix.net/0ea83191/uploads/origins/2a10ee8c-8611-44b3-b4bd-3a749d7bc187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8da58512d4016403643c222d4ef32fc5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ea83191/uploads/origins/2a10ee8c-8611-44b3-b4bd-3a749d7bc187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62fd198f468369b3bc567668c78b624a", "srcset": "https://si.imgix.net/0ea83191/uploads/origins/2a10ee8c-8611-44b3-b4bd-3a749d7bc187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62fd198f468369b3bc567668c78b624a, https://si.imgix.net/0ea83191/uploads/origins/2a10ee8c-8611-44b3-b4bd-3a749d7bc187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=920991a7fd7534054a6d0ded955dc245 2x, https://si.imgix.net/0ea83191/uploads/origins/2a10ee8c-8611-44b3-b4bd-3a749d7bc187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7407e4c967c10ddc5a79901fb7e1d4d3 3x"}, "body": "うちの子「でう」による、以下のようなunbirth（胎内回帰）シチュのイラストをお願いしてみてもよろしいでしょうか。\n\n【シチュエーション】\n一人の旅人ケモショタ（以下、A）に出会ったでうはその子を気に入り、魅了させながらの逆レイプの後、unbirthして子宮に呑み込んでしまう。\n半刻ほどして、Aの相方であるもう一人のケモショタ（以下、B）とも出会ったでうは、「みんなまとめて一つになっちゃおう」という発想の元で、Bをもunbirthしてしまおうとする。\n二つある子宮のうち、片方にはA自身、もう片方にはAを逆レイプして中出しさせた精液が現在入っているので、先に精液が吸収されるのを待つ間、Bを自慢の胸毛にうずめさせ、もふもふとフェロモンで魅了させながらあまあまに愛で続ける。\n※この後はBもunbirthされ、二人ともでうに吸収されてしまいます\n\n【描いて欲しいもの】\nでうがBを自身の胸毛に埋めさせているシーン ＋ でうの子宮内にいるAの体内描写。\n\n・でうは元のサイズの姿で、愛液を流し、ハートを沢山出し、Aを呑み込んだ多幸感と後でBをunbirthする期待でゾクゾクしながら、Bを優しく抱えて自身の胸毛にうずめさせ、あまあまに愛でている。\n　※でうのデザインや設定は以下の①の資料をベースに、②のミントグリーンのリボンを付けて欲しい。\n　　なお①の資料では名前が「でかうさキュバス」となっていますが、現在では「でう」と改めて名付けています。\n　①https://imgur.com/EZjL445\n　②https://imgur.com/a/qf6wOUJ\n　\n・Bは抵抗しつつも、次第にもふもふとフェロモンで魅了されつつある様子で、でうの胸毛にうずめられている\n　※脱がされていて裸\n　※身体のほとんど（頭や腕・脚の先以外）が胸毛に隠れている感じ\n\n・Aはでうの二つある子宮のうち片方の中で、とろけたハートを出しながら、虚ろな表情で完全に魅了・安心させられた様子で、肉壁に埋もれながら心地良くうずくまっている。\n　※脱がされていて裸\n　※みっちりぎゅうぎゅうで、身体の2/3ほどが肉壁に隠れている感じ", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ROOM_Kinoko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 563219, "client_id": 3299710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd4b7d2d8fc94dd784d650a10c3ba123", "srcset": "https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd4b7d2d8fc94dd784d650a10c3ba123, https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0159da61448ca98c46d14ab29b57b823 2x, https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b246ab33811d7a794bdb1796f15bbb6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0313a83d933d72f2a8f9ad629a22a7f", "srcset": "https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0313a83d933d72f2a8f9ad629a22a7f, https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3526d99240a4556e96f44513a8e77e 2x, https://si.imgix.net/f0d42ee4/uploads/origins/f635651f-888d-4b05-abc5-c7f353733b75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4fc883839be632fa7e491a71588f544 3x"}, "body": "こんにちは、私はいつもあなたの絵が好きです。そこで、私のヘビのキャラクターとウサギのキャラクターのイラストを描いていただけないでしょうか。\nTheir refs:https://x.com/zhang_gun/status/1893044985613951352\nお腹の膨らみから、まだ獲物が中で蠢いていることがわかるような、お腹がとても膨らんだ蛇を描いていただけたらと思います。膨らんだお腹はセーターでは隠せず、腹部の鱗も伸びて真ん中のピンク色の皮膚が見えています（https://x.com/tianhua64293936/status/1964398899936055439 ）満足そうに、でも恥ずかしそうにお腹を撫でています。\nできれば、蛇のお腹の中にいるウサギも描いてほしい。粘液まみれで、呼吸困難で少し苦しそうな表情だが、オーガズムを感じて興奮している。\n中に別のキャラクターを描くのが面倒だという方は、もちろん描かないという選択肢もありますし、オファーを修正することも可能です。\nとにかく、ありがとうございました！💕。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ROOM_Kinoko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 563219, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e3fb20375c9915e6197bf49d25d96b5", "srcset": "https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e3fb20375c9915e6197bf49d25d96b5, https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26e613db9995b1b0402de3ff7f0b8f2c 2x, https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ce3ba3fbee82f43d0668f48d75a3034 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2b3955ec77f284ef283f9d864e46948", "srcset": "https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2b3955ec77f284ef283f9d864e46948, https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45a50803d8d06186b0e6a66e4e9a7bba 2x, https://si.imgix.net/beb1f48d/uploads/origins/f8529e1b-152f-448a-89df-236bbc30ac8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa13ca66d3c84dd114fb8a68f566d4cc 3x"}, "body": "ヨッシー2匹に舌で絡め取られ引っ張り合いされているルカリオをお願いします。\n舌の一本がルカリオの太ももと腰付近まで巻きついており、もう一本の舌が首と口付近を覆っていてほしいです。\nルカリオは2本の舌で思い切り引っ張られており、泣いていてほしいです。吹き出しでくぐもったセリフがあると有難いですy\n\nもし可能であれば、飲み込まれた後も描いてくださると嬉しいです。\nその場合、ルカリオの頭は下向きに描いてくださると嬉しいです。\n宜しくお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ROOM_Kinoko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 563219, "client_id": 114888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1dca37532c602a81d318ec4928abae4", "srcset": "https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1dca37532c602a81d318ec4928abae4, https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88d02cbf5b4d0ea6cb3dc0369d68bf2c 2x, https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8198d966f7f73687f158302a1a863365 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d864b82d281c22bf9617b5b24412f5a8", "srcset": "https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d864b82d281c22bf9617b5b24412f5a8, https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=023d078aaba1c989e1f3d4c37f0f66bf 2x, https://si.imgix.net/51815f74/uploads/origins/ff69904a-09a2-4628-b6c2-65c452360a6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39d04a8f2ea8fdab9ed7df73ba5988d4 3x"}, "body": "こんにちは、ROOM先生。\n私は以前から先生の作品がとても好きでした。先生は私の性フェチ理解の師匠とも言えます。\nSKEBをオープンされるのをとても楽しみにしています。試してみるつもりでこのリクエストを送ります。承認していただけるとありがたいです。もし却下されたとしても理解しています。\n私はずっとセルペリオールとケルディオのファンで、両者に多くの作品を依頼してきました。\nセルペリオールのお腹の中にケルディオがいて、セルペリオールはなるべく大きく、ケルディオはぼーっとしているような、いつも描いているようなかわいい表情をぜひ描いてほしいです。\nセルペリオールの顔はチャーミングな女王様のようだ。\nケルディオの目は赤く、ケルディオの鼻も小さくしてほしいです。\n遠近法のないバージョンとX線遠近法のあるバージョンがあるといいなと思います。\nこの2人のキャラクターは、下記URLから過去の依頼作品を見ることができます。\nお読みいただきありがとうございました。英語でのお手紙で申し訳ありません。私の思いが伝われば幸いです。\n\nhttps://drive.google.com/drive/folders/1NSpae6FcuYGV2zIJsTpL9rkI8Yst-yN9?usp=sharing", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ROOM_Kinoko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 563219, "client_id": 85135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3cd6fbf/uploads/origins/2b285fe6-9532-4f2b-a772-0f9c1b91be76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to