re! If it's no trouble, may you split the character and the background apart? I would like to animate your drawing! Thank you very much if you accept my request!\n\nhttps://drive.google.com/drive/folders/1aBE0QEuoj6q4Z8JbrYITgabBqnt7sh8s?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kome_egg_shoyu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1125711, "client_id": 896475, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a6d21c3/uploads/origins/7bdb71ab-b840-4c80-ac11-c3e0724ea47a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f72155005de36eb73b9d14d27fdaf65e", "srcset": "https://si.imgix.net/2a6d21c3/uploads/origins/7bdb71ab-b840-4c80-ac11-c3e0724ea47a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f72155005de36eb73b9d14d27fdaf65e, https://si.imgix.net/2a6d21c3/uploads/origins/7bdb71ab-b840-4c80-ac11-c3e0724ea47a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed4374ad2331e3e96582fb95cedda502 2x, https://si.imgix.net/2a6d21c3/uploads/origins/7bdb71ab-b840-4c80-ac11-c3e0724ea47a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b44508571a0ae0d0894cc8f1ba54a41d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a6d21c3/uploads/origins/7bdb71ab-b840-4c80-ac11-c3e0724ea47a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7521d3928552bedf47ad87f762a2022", "srcset": "https://si.imgix.net/2a6d21c3/uploads/origins/7bdb71ab-b840-4c80-ac11-c3e0724ea47a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7521d3928552bedf47ad87f762a2022, https://si.imgix.net/2a6d21c3/uploads/origins/7bdb71ab-b840-4c80-ac11-c3e0724ea47a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr