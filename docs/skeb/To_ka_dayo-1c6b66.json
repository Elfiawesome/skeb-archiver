い）。ストッキングも足の裏が破れており、穴からつま先と足の裏の一部が見えている。両手はさりげなく体の両側の地面に置かれている。歯を食いしばり、目尻から涙のしずくを滲ませながら、どこか恨みを含んだ怒りの表情を見せる。\n差分について\n①彼女は裸足で、片手に靴下を持ち、やや軽蔑的な笑みを浮かべていた；\n②足の裏の匂いと汗。\n私のリクエストにお読みいただき、ありがとうございます。\nhttps://drive.google.com/drive/folders/1QyIu-4wABO-Ce3X4NUfEg-XlRMVhF7_L", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@To_ka_dayo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2826450, "client_id": 977462, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23f6ca7b/uploads/origins/0cf13072-e23d-467e-b4ea-40d8782a94f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e4b68db5eb6a864593436cac2c2d40", "srcset": "https://si.imgix.net/23f6ca7b/uploads/origins/0cf13072-e23d-467e-b4ea-40d8782a94f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e4b68db5eb6a864593436cac2c2d40, https://si.imgix.net/23f6ca7b/uploads/origins/0cf13072-e23d-467e-b4ea-40d8782a94f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d074dab9d66eb05d2b6c1ee84394ed0 2x, https://si.imgix.net/23f6ca7b/uploads/origins/0cf13072-e23d-467e-b4ea-40d8782a94f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c97563db493cfe61a031d35910aab67f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23f6ca7b/uploads/origins/0cf13072-e23d-467e-b4ea-40d8782a94f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6467f3190cf2e9ec88b7bb582ff3626a", "srcset": "https://si.imgix.net/23f6ca7b/uploads/origins/0cf13072-e23d-467e-b4ea-40d8782a94f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6467f3190cf2e9ec88b7bb582ff3626a, https://si.imgix.net/23f6ca7b/uploads/origins/0cf13072-e23d-467e-b4ea-40d8782a94f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&