描いていただけないでしょうか。\nキャラクターは双子の男性で、ともにやや童顔に見える31歳です。\n現代異能力バトルのTRPGシステムで、兄の方は右手が機械の義手になっています。\n双子、もしくは兄と弟のどちらかを描いていただけると嬉しいです。\n衣装やシチュエーションなどもお任せします。\n参考画像は以下になります。\n兄：https://gorgeous-click-34f.notion.site/c99ec53a64c044ed906ca8211f8ac584\n弟：https://gorgeous-click-34f.notion.site/NPC-5918b84fc9aa40dcbd01a8f87a46fff2\n\nご検討いただけますと幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@blanclait_you/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1938064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5de84009/uploads/origins/b697575c-1135-48cf-b6fa-22adcd4f90b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c969aa56abb2357b2b683570a4dcf5", "srcset": "https://si.imgix.net/5de84009/uploads/origins/b697575c-1135-48cf-b6fa-22adcd4f90b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0c969aa56abb2357b2b683570a4dcf5, https://si.imgix.net/5de84009/uploads/origins/b697575c-1135-48cf-b6fa-22adcd4f90b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57e01ef8b2b7b8b5ea219fbaab54877f 2x, https://si.imgix.net/5de84009/uploads/origins/b697575c-1135-48cf-b6fa-22adcd4f90b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=852a3566d5cdab91e975b144b1437bd5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5de84009/uploads/origins/b697575c-1135-48cf-b6fa-22adcd4f90b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c17abc06f70d8faee35b2af20772e3cf", "srcset": "https://si.imgix.net/5de84009/uploads/origins/b697575c-1135-48cf-b6fa-22adcd4f90b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c17abc06f70d8faee35b2af20772e3cf, https://si.imgix.net/5de84009/uploads/origins/b697575c-1135-48cf-b6fa-22adcd4f9