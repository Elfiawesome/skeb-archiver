心棒(不本意)と護衛対象、今は恋人。お互いを大事に思っており、同時に執着してる。なくてはならない存在。 人類が滅びかけた世界で旅をしています。\n\n   具体的な構図、シチュエーション、服装の簡略化等描きやすいように描いていただければ嬉しいです。\n もし金額が足りないようでしたらお手数ですが再送して頂けると嬉しいです。 ご検討何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/19_gw1Ju8gp8rjRq8VqjWwLrW0bDE06Ga?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@coji_hitokuchi/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/15a9bffe/uploads/origins/a9fd9704-87a6-4284-a753-75e893e1da98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cd4e6ba27d8308ded9a61f12729be4f", "srcset": "https://si.imgix.net/15a9bffe/uploads/origins/a9fd9704-87a6-4284-a753-75e893e1da98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0cd4e6ba27d8308ded9a61f12729be4f, https://si.imgix.net/15a9bffe/uploads/origins/a9fd9704-87a6-4284-a753-75e893e1da98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39bf7387c900d6060a7bd6e013f22166 2x, https://si.imgix.net/15a9bffe/uploads/origins/a9fd9704-87a6-4284-a753-75e893e1da98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9082f7d23bf758fc7b49f9f8a92b7132 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3894403, "nc": 1}, {"path": "/@coji_hitokuchi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3894403, "client_id": 2545299, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74afc7b9/uploads/origins/a326e374-01ba-44d8-89cc-de27794d57e9?bg=%23fff