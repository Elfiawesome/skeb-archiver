す。\n例:6人の場合\nAカップ未満 (無乳)\nABC (貧～普乳)\nDEF (普～豊乳)\nGHI (巨乳)\nJKL (爆乳)\nM以上 (超乳)\n\n\n・元絵の0と9にあたるぽっちゃりとマッチョは描かないでOKです。\n\n\n【女の子について】\n・即席のオリキャラでお願いします。\n既存のキャラを出しても大丈夫です。\n\n・出来ればサイズごと別のキャラでお願いします。\n\n・女の子の年齢ですが全員同じでもバストの小さい子だけロリにしても大丈夫です。\n\n・表情は女の子別で違っていても全員無表情でも構いません。(後述するケースを除く)\n\n・バスト大きめの子をよく見ると谷間からザーメンが少しﾀﾗｰと垂れて蠱惑的な笑みを浮かべている描写もいれて下さい。\n\n\n\n以上です。ご承諾いただけますと幸いです。\n\nhttps://gyazo.com/cb07a21901e67927babec64d1328bd5b", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsurumaki_shuu/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/acc1d178/uploads/origins/cd1f9dd2-1318-446a-a794-b6387811e724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb5da44efbb9bd4a8e831dce3f56f698", "srcset": "https://si.imgix.net/acc1d178/uploads/origins/cd1f9dd2-1318-446a-a794-b6387811e724?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb5da44efbb9bd4a8e831dce3f56f698, https://si.imgix.net/acc1d178/uploads/origins/cd1f9dd2-1318-446a-a794-b6387811e724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7f48722c18f12769e102efd64db0084 2x, https://si.imgix.net/acc1d178/uploads/origins/cd1f9dd2-1318-446a-a794-b6387811e724?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8e92349542efe62fb32502accd1c8c9 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 467254, "client_id": 122735, "nc": 161}, {"path": "/@tsurumaki_shuu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id"