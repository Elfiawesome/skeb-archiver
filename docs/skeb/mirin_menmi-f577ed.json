gix.net/cf4cdad1/uploads/origins/83476323-ec3a-4a0d-b62e-85ca94b8971f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1eb13117ba96cd19deef0dd62cb424ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf4cdad1/uploads/origins/83476323-ec3a-4a0d-b62e-85ca94b8971f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=044739d64485367cb84a9054883329cb", "srcset": "https://si.imgix.net/cf4cdad1/uploads/origins/83476323-ec3a-4a0d-b62e-85ca94b8971f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=044739d64485367cb84a9054883329cb, https://si.imgix.net/cf4cdad1/uploads/origins/83476323-ec3a-4a0d-b62e-85ca94b8971f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64493c8a3c432c172c1ea0f913b815ab 2x, https://si.imgix.net/cf4cdad1/uploads/origins/83476323-ec3a-4a0d-b62e-85ca94b8971f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d476732f0c2e30ffd9cc6cd95431616 3x"}, "body": "小説に興味があったのでご依頼しました。\nもしもご都合があえば、うちのOCの「皇すらら」で小説をお願いすることは可能ですか？ \n参考までに設定は以下のとおりですが、舞台背景、その他登場人物等、自由に書いていただいて構いません。\n███\n●皇すらら（すめらぎ すらら）\n人間の少女で記憶力は良い方。ペットのマダマテを溺愛していた。\nオリジナルは数年前に事故死した。彼女と同じ姿をしたクローン体が彼女の代わりに生活している。\nクローン体は彼女を蘇らせるためにマダマテが作ったものだが、無理なクローニングにより深く眠り込むと度々死ぬことがあり、その都度前の個体の記憶と姿を転写されたクローン体が生成されている。クローン体の記憶は皇すららとしての自己の連続性を保つために、マダマテによって改変されている。\n\nアメーバ体は有機生命体がマダマテの胞子により変異したもの。クローン体の生成過程で生じる不完全な粗悪コピーで、皇すららと同一の遺伝情報を持ちながらも醜悪な姿をしている。アメーバ体は走性に従って一定規模の集団を形成し、融合して子実体を形成する。\n子実体はアメーバ体の集団が一つになった状態で、細胞分裂を経てクローン体を身に宿す。クローン体が排出されると子実体は枯れて溶けて消える。クローン体はマダマテによって記憶が改変されているが、アメーバ体や子実体の時に見聞きしたことを悪夢として再体験することがよくある。\n\n●マダマテ\n皇すららのペットの子犬。十年程前に皇すららに拾われ、以来家族同然に暮らしている。皇すららはマダマテを子犬だと思っているが、垂れ耳の兎にも見えないこともない。\n名前の由来は「待て」が覚えられないことから。\nマダマテは周囲の生命体を素材にして事故死した皇すららのクローンを作り続けている。オリジナルが仲良くしていた者にだけ懐き、その者だけはクローンの素材（アメーバ体）にされない。\n███\n著作者様のクレジット表記ありでSNSや個人サイト等でのキャラクター紹介等での掲載、コミッション等での朗読依頼等も考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DC54qVFtGUFP-9T0gu-zLkbOKQFZ6TK", "nc": 137, "word_count": 1068, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 527615, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ユーキ/bravegarden", "screen_name": "bravegarden1", "avatar_url": "https://pbs.twimg.com/profile_images/1273670523377967104/HTTBDAAb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1232406167457951744/1656013727/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 2216883, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "雨谷とうか", "screen_name": "ameya_ayameya", "avatar_url": "https://pbs.twimg.com/profile_images/1708862724112105472/OmX-9n-u.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1094502757405343746/1585108389/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}, {"genre": "correction"}], "nc": 16}, {"id": 2487451, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ふみづきかすか（文月幽）", "screen_name": "Fumiduki_Kasuka", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:3lqag4pktmb3dlbkkwl4vsmy/bafkreie6muct3hywzt5gt4ilzgieggc2zajwswi4fhvaxrjqpyfnduhm7m", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:3lqag4pktmb3dlbkkwl4vsmy/bafkreieqiisfts7vcw6qmhvi6puzss4tyzy2i2kc5lvbphmugjqo5e3sqe", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, 