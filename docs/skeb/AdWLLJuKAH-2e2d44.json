トの目)、メルヘンです。イメージカラーはピンクと水色のコンビです(ミントグリーンに近い水色です)。\n\n■使用用途: ：Youtubeの配信や動画（MV/歌ってみたを含む）、サムネイル/ヘッダーやsnsで使用させていただだければ幸いです。（クレジットを表記させていただきます）\n\n■資料：GoogleドライブのURLをご確認ください。\nhttps://drive.google.com/drive/folders/1upbytWmpC-yQFpqQS_NB0J9L42pYaUSL\n\nポーズや表情お任せします！フォルダー内に表情と衣装の差分もありますので、お好きな方を描いていただければと存じます。\nお忙しいところ恐れ入りますが、どうぞご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1upbytWmpC-yQFpqQS_NB0J9L42pYaUSL", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AdWLLJuKAH/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 459704, "client_id": 2866162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e24b994/uploads/origins/27f3725d-4127-4e22-9c0b-f2ef0a7783ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da3308ee00035a28636cde52bf7b4f9", "srcset": "https://si.imgix.net/0e24b994/uploads/origins/27f3725d-4127-4e22-9c0b-f2ef0a7783ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5da3308ee00035a28636cde52bf7b4f9, https://si.imgix.net/0e24b994/uploads/origins/27f3725d-4127-4e22-9c0b-f2ef0a7783ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f07bc3aca67f0c0193cc7a10e6439e88 2x, https://si.imgix.net/0e24b994/uploads/origins/27f3725d-4127-4e22-9c0b-f2ef0a7783ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c6386ae132a2246d4ae09fa7302e60b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e24b994/uploads/origins/27f3725d-4127-4e22-9c0b-f2ef0a7783ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7c2178ad97fc68421c0feebe82db4fb", "srcset": "https://si.imgix.net/0e24b994/uploads/origins/27f3725d-4127-4e22-9c0b-f2ef0a7783ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7c2178ad97fc68