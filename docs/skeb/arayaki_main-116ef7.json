が海上か地上かなどはお任せします。小さい船など、大きさの比較対象になる物があれば嬉しいです。\n私の好みですが、響はXV通常ギアで見てみたいですが、描きやすいバージョンを優先して問題ありません。\n\nあらやき様のskebでは漫画もOKとのことですが、漫画か1枚絵かもお任せします。また、絵柄が太いものか細いものかもお任せします。\n\n以前に食べフォギアなどで装者の巨大化を描かれていたようですので、そこからバトル系巨大化装者も見てみたいと思ってしまいました。もしお時間ありましたらよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arayaki_main/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736106, "client_id": 667364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1eee7f06/uploads/origins/088a8bd9-526c-4110-a333-e23186034120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36914bef66229956c549334489c51ff5", "srcset": "https://si.imgix.net/1eee7f06/uploads/origins/088a8bd9-526c-4110-a333-e23186034120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36914bef66229956c549334489c51ff5, https://si.imgix.net/1eee7f06/uploads/origins/088a8bd9-526c-4110-a333-e23186034120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3dd21302b725dda9f52ba350285d170 2x, https://si.imgix.net/1eee7f06/uploads/origins/088a8bd9-526c-4110-a333-e23186034120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18c8d433de3a899641540f5b2e55792d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1eee7f06/uploads/origins/088a8bd9-526c-4110-a333-e23186034120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7bf7226cd5903a5222db3b74e1885ae", "srcset": "https://si.imgix.net/1eee7f06/uploads/origins/088a8bd9-526c-4110-a333-e23186034120?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7bf7226cd5903a5222db3b74e1885ae, https://si.imgix.net/1eee7f06/uploads/origins/088a8bd9-526c-4110-a333-e23186034120?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro