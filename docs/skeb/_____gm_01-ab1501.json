見えるが、楽しい事があると人並みにテンションが上がる。\n人付き合いが良く気遣いが出来て優しい。\n\n\n以上です。\nSkeb初利用なので不備等ございましたら申し訳ございません。\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/15IRXLtPLUSiPQJy4YSQEToZxzsFMqBgk", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 904898, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "クロハツモドキ", "screen_name": "LAZY_OYSTER", "avatar_url": "https://pbs.twimg.com/profile_images/1998572915877724160/4r_sfOTi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1307737375691304960/1702872299/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 15, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2715282, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ｼﾞｬﾑﾁｬﾝ", "screen_name": "jktokumori", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-9a90a5da-d144-4895-883d-b8a24b484c62.png?avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 17}, {"id": 3192148, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "グルグル惨蝕", "screen_name": "gurugurusannsyoku", "avatar_url": "https://pbs.twimg.com/profile_images/2052579545044418561/4SRKG99a.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2047535163681419265/1777021402/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_d