740\u8863\u30dc\u30c6\u8179\u304c\u5f37\u8abf\u3055\u308c\u305f\u69cb\u56f3\u6700\u512a\u5148\u3067\u3001\u7537\u6027\u306e\u8089\u4f53\u63cf\u5199\u306f\u30da\u30cb\u30b9\u3084\u305d\u306e\u900f\u904e(\u30da\u30cb\u30b9\u306e\u5f71\u306e\u307f)\u3067\u3001\u4f53\u306e\u65b9\u306f\u63cf\u5199\u306a\u3057\u3084\u534a\u900f\u660e\u3067\u69cb\u3044\u307e\u305b\u3093(\u53ef\u80fd\u3067\u3042\u308c\u3070psd\u5f62\u5f0f\u3067\u306e\u30ec\u30a4\u30e4\u30fc\u6a5f\u80fdON/OFF\u5e0c\u671b)\n\n\u4e21\u65b9\u3068\u3082\u8868\u60c5\u306f\u3001\u30b4\u30df\u3092\u898b\u308b\u51b7\u3081\u305f\u76ee(\u9854\u306e\u4e0a\u90e8\u3084\u76ee\u5143\u307e\u3067\u5f71\u304c\u304b\u304b\u308a\u30cf\u30a4\u30e9\u30a4\u30c8\u306a\u3057)\u3067\u3001\n\u307c\u3063\u3061\u3061\u3083\u3093\u306f\u5acc\u60aa\u3068\u6050\u6016\u304c\u6df7\u3058\u3063\u305f\u602f\u3048\u306a\u304c\u3089\u4fae\u8511\u3057\u3066\u3044\u308b\u8868\u60c5\u3001\u304d\u304f\u308a\u306f\u30c9M\u7537\u3078\u306e\u5acc\u60aaMAX\u4e00\u5207\u96a0\u3059\u3053\u3068\u306e\u306a\u3044\u4fae\u8511\u306e\u5f37\u3044\u8868\u60c5\u3067\u3001\n\u7247\u4e73\u3060\u3051\u3067\u80f4\u4f53\u4ee5\u4e0a\u306e\u30b5\u30a4\u30ba&\u670d\u8d8a\u3057\u306e\u52c3\u8d77\u4e73\u9996(\u3082\u3057\u53ef\u80fd\u3067\u3042\u308c\u3070\u30d4\u30f3\u30af\u8272\u60f3\u5b9a\u306e\u900f\u3051\u4e73\u9996\u5e0c\u671b)\u306e\u7740\u8863\u8d85\u4e73\u3068\n\u8d85\u4e73\u306b\u8ca0\u3051\u306a\u3044\u30b5\u30a4\u30ba\u306e\u7279\u5927\u7740\u8863\u30dc\u30c6\u8179(\u598a\u5a20\u6deb\u7d0b\u4ed8)\u59ff\u304c\u666e\u6bb5\u901a\u308a\u306e\u8863\u88c5\u306e\u4e2d\u306b\u30ae\u30c1\u30ae\u30c1\u306b\u62bc\u3057\u8fbc\u307e\u308c\u5f37\u8abf\u3055\u308c\u305f\u5b8c\u5168\u7740\u8863\u72b6\u614b\u3067\u3001\n\u8d85\u4e73\u3084\u30dc\u30c6\u8179\u5185\u90e8\u306b\u7c98\u6db2\u307e\u307f\u308c\u306e\u89e6\u624b\u3092\u5b55\u307f\u3001\u5927\u91cf\u306e\u89e6\u624b\u3067\u8822\u304d\u5916\u304b\u3089\u898b\u3066\u3082\u6b6a\u306b\u5909\u5f62\u3057\u3066\u3044\u308b\u63c