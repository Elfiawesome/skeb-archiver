0&blur=200&s=1bb7fcae4ba1f9e6dc0b2cdab3622799 3x"}, "body": "はじめまして。\nあいおい様のポストを拝見し、ちみキャライラストがとても可愛らしく、ぜひご依頼したいと思いました。（特に左下の天使の子たちのちみが好きです！）\nぜひ私のOCたちもあいおい様のちみイラストにしていただけたら嬉しいです。\n\n■外見資料\nhttps://drive.google.com/drive/folders/12K7A_9dMP7kHWKwMgCNovtVv4IPP8QDI?usp=drive_link\n\n■使用用途\n・個人観賞、SNSのアイコン・ヘッダーの使用、グッズ作成\n\n金額に不備がございましたらお手数ですが再送のリクエストをいただければと思います。\nどうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Aioi_0606/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3909597, "client_id": 1816549, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d26394dc02a222cedff99782099026", "srcset": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99d26394dc02a222cedff99782099026, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3955ac8a29117d157fbe8de3885826a 2x, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d66a5c74ca2bf6b1aa06f94f7e2ca689 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5e2105d045c6e755b13581b5b8d728", "srcset": "https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5e2105d045c6e755b13581b5b8d728, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21b6846369077f269f7ba00bdaac14b1 2x, https://si.imgix.net/504b9023/uploads/origins/c1c2f597-9aa7-4ba2-9bb4-ed76a8ab5bf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3997ad1f80c6c96a54a52748f957c1cd 3x"}, "body": "あいおい様\n\nいつもお世話になっております！相生さんの絵柄が大好きで、skebを開けられたとのことで早速ご依頼に参りました...！\nもしよければ、私と相方のTRPGキャラクター2人を一枚絵で描いていただけないでしょうか？\n以下詳しいキャラクター説明となります。(シナリオのネタバレはありません)\n\n―――\n\n✘前提条件\n・「Title Lost」というTRPGシナリオ出身の二人。「ミティカ」というルーマニアモチーフの街で暮らしている。\n・二人は悪魔憑きのエクソシストと天使の加護を持つ殺人鬼で、いわゆる腐れ縁に近い存在。職業は違うものの、利害の一致で仕事を共にすることもある。現時点では、主従と呼んだほうが近い。\n・お互い片方の「眼球」をそれぞれ交換している。\n\n咎 璃弌\n右目：黒色\n左目：水色\n\nエルガー\n右目：水色\n左目：黒色\n\n(リンク先の資料によっては目の色が違う場合がありますが、上記が正しいものになります。ややこしくて申し訳ございません。)\n\n―――\n\n✘白髪・右目の下に泣き黒子\n→咎 璃弌(とが - りひと)\n男性/24歳/164cm/利き手：右/職業：エクソシスト(拳銃使い)\n\n・エクソシストをしている24歳。背が低いことを気にしている。職業に似合わず体が弱い。\n・日本人気質故に性格は真面目。だが、ここぞという時は大胆に飛び込んでいく度胸も持ち合わせている。\n・自由奔放なエルガーに振り回されることが多いが、彼のことを唯一と呼べるほど、この世で最も大切な人だと思っている。\n・気恥ずかしさ故に本人は認めていないが、エルガーに対して過保護気味な部分がある。\n\n―――\n\n✘黒髪・瞳孔がダイヤの形\n→Arger＝Martin(エルガー・マーティン)\n男性/28歳/182cm/利き手：左/職業：殺人鬼(ナイフ使い)\n\n・マイペースで自由奔放な性格。基本的に感情に任せて動いており、後先を考えていない。これにより、よく咎 璃弌のことを振り回している。\n・「クルトシュ」という甘いパンが好き。咎 璃弌の家に押しかけてミティカの街を眺めながら一緒にお茶会のをすることもある。\n・咎 璃弌のことを死なせたくないと考えており、彼と交流する上で邪魔だと感じた者(咎 璃弌と敵対していたり、良くない感情を向けている人)を優先的に始末することが多い。本人曰く不快指数が格段に上がるためとのことだが、璃弌から「無闇矢鱈に殺すな」と言われて渋々刃を収めることもある。\n・咎 璃弌のことを主人のように慕っている。信仰心に近い感情も向けており、咎 璃弌が言ったことは全て正しいと思っている節がある。エルガーにとって、咎 璃弌を何者からも優先し守ることが第一事項である。\n\n―――\n\n✘モチーフやイメージ(必ず取り入れる必要はありません。この二人の雰囲気の参考になれば幸いです。)\n宗教、信仰、神、西洋、黒と白、表裏一体、唯一無二、胃痛枠の飼い主と自由奔放な忠犬\n\n―――\n\n容姿については、添付したリンク先を参照していただければと思います。\n構図や服装などはお任せで構いません。\n描いて頂いたイラストは鑑賞用のほか、相方への共有、イラストサイズによってはPCの壁紙やTwitterのアイコンもしくはヘッダーなどに使用する可能性がございます。\n\n金額等足りなければ遠慮なく再送いただけますと助かります...！\nお忙しい中恐縮ですが、ご検討いただけますと幸いです！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ND3Ti-SOm7nc1nhintLDOCLOu8gXCdGu", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Aioi_0606/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3909597, "client_id": 1936599, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4decb1383f1dca57ee0df861558f346b", "srcset": "https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4decb1383f1dca57ee0df861558f346b, https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8834b5a608647d5af2703d29bb99eac7 2x, https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c98fae8da1df4a4f7947de7ab9bf0383 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b1cfd09396348c113af7cd115897e2f", "srcset": "https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b1cfd09396348c113af7cd115897e2f, https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=416624a88e15355f0b90ac423e8058f8 2x, https://si.imgix.net/070d4d73/uploads/origins/13a85755-9270-4099-9cc1-abdfff6d8b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=364abca0cd9571bc0198ab0d039fd5c7 3x"}, "body": "お世話になっております、ろむおぢさんと申します！\nあいおい 様に、ぜひ友人たちと私のOCたちをSDで描いていただきたく思い、リクエストをお送りいたしました。\n\n●ご依頼内容\n耹切 美鶴（おとぎり みつる）\n性別：男性／身長：174cm\n\n可もなく不可もなく、どこにでもいそうな普通の高校生。\n陽キャではないが根暗というほどでもなく、性格・口調ともに穏やかで、誰に対しても分け隔てなく接するタイプ。\n悪く言えば平坦で、誰にとっても「特別」になりにくい存在。\nクラスの空気側にいる生徒で、彼女持ち。\n\n-\n\n胡桃 乙八（くるみ おとは）\n性別：女性／身長：153cm\n\n冷（ややかに）笑（う）系ギャル。\n目つきは悪く愛想もないが、実際は普通に会話ができ、普通に笑うタイプ。\n我儘な一面は多いものの、他人に強要することはない。\n元陸上部で、現在は塾に通いながら時間を作って趣味としてランニングを続けている。\n休み時間に一人でいる時は、ありえないほど自分のInstagramを見ている。\n常日頃からスイーツを食べ歩いており、よくイツメンを誘って甘いものを食べに行く。\n誰も捕まらなければクラスメイトに声をかけ、それでもだめなら一人で行く行動力の塊。\n\n-\n\n鴉宮 澪（からすみや みお）\n性別：男性／身長：171cm\n\n柔和で物腰が低く、感情を荒立てることはほとんどない。\n言葉遣いは丁寧で、年上にも年下にも分け隔てなく接するため、周囲からは真面目で控えめな生徒と認識されている。クラスメイトのことを嫌っているわけではない。\n一方で、たまに会話が噛み合わないことがある。\n相手の意図を汲むのが極端に遅かったり、言葉を文字通りに受け取ってしまったりするためで、本人に悪気はない。姉がおり、しごかれて育っているため胡桃乙八とはよく出かける。荷物持ち担当。写真を撮るのが好きで、皆のことをよく撮っている。耹切 美鶴の彼女と付き合っていると勘違いしている節がある。\n\n-\n\n伊澄 新（いずみ あらた）\n性別：男性／身長：185cm\n\n普段からお喋りというわけではなく、周囲に比べると物静かなことが多い。\nデフォルトが無表情なだけで、普通に話し、普通に笑う。\n他者との交流を嫌っているわけではないが、自分のことを積極的に話す意志もない。\n目指している仕事は秘密で、聞かれても「口に出したら叶わなくなるから」と答えるのみ。\nインターネットが大好きで、誰かに合わせるよりも自分のペースでのらりくらりと楽しむ、自由気ままなSNSライフを送っている。\n\n●使用用途\n・スマホの壁紙\n・X（旧Twitter）のアイコン／ヘッダー\n・個人鑑賞用\n\nあいおい 様の描きやすい形・解釈で、自由にアレンジしていただけましたら嬉しいです。\nまた、金額面で難しい場合は内容を調整して再送いたしますので、その旨お知らせいただけますと幸いです。\n長文となり恐縮ですが、ご検討いただけましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1aj62JwaTd0B1Sh9BJpMzifVnneOkwoPG?usp=drive_link", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Aioi_0606/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3909597, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42581265dbb325eb6eb98f5531d50b17", "srcset": "https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42581265dbb325eb6eb98f5531d50b17, https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=480e7f8b1d42d1ab777b78798db178ad 2x, https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14e14b794216a1e924b8f2d9272359cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b146a5fc5ece994ae5a0fc35e817c408", "srcset": "https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b146a5fc5ece994ae5a0fc35e817c408, https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20b22757ed671b53e962571859ea30cf 2x, https://si.imgix.net/f669c1a0/uploads/origins/eb6804a0-f9ed-436e-a2c0-622ece2d1fe0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2dfae2b024368fe558abcbf02c8b8180 3x"}, "body": "​おいおい様、はじめまして！​！私のTRPGのPCとKPC、2人の「ココフォリア用立ち絵」の制作をリクエストさせていただきたいです。\n​もし可能であれば、2人が「日常的に着ているような私服」姿を見たいです。その他の細かな服装のデザイン、ポーズ、構図などは、すべて先生の自由な発想におまかせいたします！\n​また、もしご対応可能でしたら、PC側のみ「服装の差分」を合計2パターンお願いできないでしょうか。\n・1パターン目：先生に完全におまかせする日常服\n・2パターン目：【黒と赤の配色】を取り入れた日常服\n​もし差分制作などにより金額の調整が必要な場合は、お気軽に再申請（キャンセルして再送）をお願いいたします！制作よろしくお願いいたします。\n\n​【PC】女性 / 24歳 / 165cm\n​タイプ： INTP / 5w4 / 548\n​性格・設定： 面白くない冷たい冗談（オヤジギャグ）を言うのが好きな、クーデレ（無口で感情の起伏が少ない）タイプです。感情がやや希薄で、大抵のことは自分には関係ないと思っています。普段は日本のアニメを見たり、PCやNintendo Switchでゲームをするのが好きです。\n​Bへの感情： 相方であるBのことを骨の髄まで憎んでいますが、やむを得ず彼に借りを作ってしまっている状態です。Bの前にいる時にだけ、感情の起伏（特に「激しい怒り」）を露わにします。\n​【KPC】男性 / 23歳 / 184cm\n​タイプ： INFJ / 6w5 / 641\n​性格・設定： 根暗で陰湿なオタク気質。Aとは元々友人同士でしたが、様々な理由から今では不倶戴天の敵（宿敵）同士になってしまいました。​彼もまた日本のアニメを見たり、AVGをプレイしたりするのが好きです。実家では疎まれている次男であり、兄と弟が一人ずついます。\n内心ではAに対してある程度の罪悪感を抱いていますが……絶対にそれを認めようとはしません。\n\nhttps://drive.google.com/drive/folders/1cRajizrccz2Xz3ky5eEP3WQ5YKm3ZVGR", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Aioi_0606/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3909597, "client_id": 3345909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c0c1edcc1e41e2b729bef14ce5a5bf2", "srcset": "https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c0c1edcc1e41e2b729bef14ce5a5bf2, https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6480700a422be5e86d255aaee34ba3ac 2x, https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f4192dcd1a48a52dbf026babc1d6595 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=952959c287ac2c3fecedd67750dfb578", "srcset": "https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=952959c287ac2c3fecedd67750dfb578, https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=554de86eb912bb8244ce8fa5485bc9cf 2x, https://si.imgix.net/eb15aff7/uploads/origins/c7047cc1-0ca1-4820-9c30-989c65b97595?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=edb0643306078133f798386bb5af4b1a 3x"}, "body": "あいおい様  \nはじめまして。Vtuberの羽梠と申します。 \nあいおい様の生き生きとしたキャラクター描写に惹かれ、ミニキャラクターイラストを依頼させていただけないかと思いご連絡いたしました。\n\n大変お手数ですが、ご検討いただけますと幸いです。\n\n〇使用用途 　\nYoutubeサムネイル、各種SNSでの使用\n\n〇納品形式 \n人物と背景がレイヤー分けされたPSDファイルまたはPNGファイルだと大変助かります。\n\n〇描いていただきたいもの\n「羽梠ときと」と「花蹄みかみ」を描いていただきたいです。\n2人は一緒に旅をしている群れの姉妹です。\n2人とも好奇心旺盛で、こっそり群れを抜け出して遊びに行ったり、秘密の宝物を覗きに行ったりしています。\n精神年齢は羽梠のほうが1~2歳ほど上ですが、実年齢は花蹄のほうが上です。\n羽梠の身長が156cm,花蹄の身長が148cmです。\n\n2人でこそこそ話をしている構図や、手を取って笑いながら走っている構図があると嬉しいですが、基本的にはすべてお任せいたします。\n\n恐れ入りますがご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1bRjAGenixNetI6QHWwkeTBqvIBfbQ7Bl?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 536207, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "渋茶漬け", "screen_name": "Sibutya_814", "avatar_url": "https://pbs.twimg.com/profile_images/1953092823773003780/CMWMtNwA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2884610899/1754466828/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1156322, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヘルプマン", "screen_name": "helpen_hhh", "avatar_url": "https://pbs.twimg.com/profile_images/1709960853137879040/OnXwAjNe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1328729254209540096/1771903800/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_