だけると大変助かります。\n\n〇使用用途：Youtube等の配信やそのサムネイルでの使用、SNSでの使用などを考えております。そのほか、もし可能であれば個人観賞用に印刷をする許可もいただければ嬉しいです(頒布・販売等は致しません)。\n\n〇参考画像： Ｘアカウントとgoogle driveを記載いたします。\n①https://x.com/RyosukeTsukiyo\n②https://drive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nもしもご縁がありましたら、どうぞよろしくお願いします！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nukonuko_4/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1202033, "client_id": 1568139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9203109f/uploads/origins/fe9a9570-adb3-41c1-89af-e0dee0086e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7fc19dec679b382196b134b438ad86", "srcset": "https://si.imgix.net/9203109f/uploads/origins/fe9a9570-adb3-41c1-89af-e0dee0086e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f7fc19dec679b382196b134b438ad86, https://si.imgix.net/9203109f/uploads/origins/fe9a9570-adb3-41c1-89af-e0dee0086e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ece04b422d4310501c4498213959f0a5 2x, https://si.imgix.net/9203109f/uploads/origins/fe9a9570-adb3-41c1-89af-e0dee0086e77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=631dc36aa3f4f4cc913aef8a5c9a7103 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9203109f/uploads/origins/fe9a9570-adb3-41c1-89af-e0dee0086e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f74812c4c49a0946ac7d724787d52cec", "srcset": "https://si.imgix.net/9203109f/uploads/origins/fe9a9570-adb3-41c1-89af-e0dee0086e77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f74812c4c49a0946ac7d724787d52cec, https://si.imgix.net/9203109f/uploads/origins/fe9a9570-adb3-41c1-89af-e0dee0086e77?bg=%23f