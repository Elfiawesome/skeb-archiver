\u30a4\u30c9\u670d\u2642\u306f\u5f8c\u308d\u3067\u4e09\u3064\u7de8\u307f\u3001\u57f7\u4e8b\u670d\u2640\u306f\u9996\u306e\u5f8c\u308d\u3067\u4e00\u3064\u7d50\u3073(\u3044\u308f\u3086\u308b\u3057\u3063\u307d\u9aea)\u306b\u3057\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002)\n\n\u203b\u306c\u3053\u305f\u3055\u3093\u306e\u63cf\u304b\u308c\u308b\u8868\u60c5\u3084\u69cb\u56f3\u304c\u3068\u3066\u3082\u597d\u304d\u306a\u306e\u3067\u3001\u4e0d\u660e\u70b9\u3084\u30a2\u30ec\u30f3\u30b8\u7b49\u306f\u3054\u81ea\u7531\u306b\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u3054\u691c\u8a0e\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\n\u3010\u8cc7\u6599\u3011\n\u25cf\u81ea\u30ad\u30e3\u30e9(\u30a2\u30a4\u30b6) \n\u203bTS\u3057\u3066\u308b\u306e\u3067\u7537\u5973\u3069\u3061\u3089\u306e\u59ff\u3082\u3042\u308a\u307e\u3059\u3002\n\u4e00\u4eba\u79f0:\u79c1\n\u8eab\u9577\u4f53\u91cd:\u2642195cm95kg\u3001\u2640190cm90kg\n\u76ee:\u30c7\u30d5\u30a9\u306f\u9752\u7dd1\u306e\u3064\u308a\u76ee\n(\u9752\u4fe1\u53f7\u307f\u305f\u3044\u306a\u8272\u3067\u3059\u304c\u8272\u306f\u53ef\u5909\u3067\u3059\u3002)\n\u9aea:\u9280\u9aea\u306e\u30ed\u30f3\u30b0\u30d8\u30a2\n(\u5149\u30d5\u30a1\u30a4\u30d0\u30fc\u306a\u306e\u3067\u53ef\u5909\u3067\u3059\u3002\u30b2\u30fc\u30df\u30f3\u30b0\u306b\u767a\u5149\u53ef\u80fd)\n\u25a0\u8033\u306f\u30d8\u30c3\u30c9\u30db\u30f3\u30d1\u30fc\u30c4\u306b\u306a\u3063\u3066\u308b\u306e\u3067\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u4eba\u9593\u8033\u30d1\u30fc\u30c4\u306b\u306a\u308b\u3053\u3068\u3082\u53ef\u80fd\u3067\u3059\u3002\u30d8\u30c3\u30c9\u30db\u30f3\u306e\u8b0e\u30b3\u30fc\u30c9\u306f\u81ea\u5206\u306e\u610f\u601d\u3067\u3046\u306b\u3087\u3046\u306b\u3087\u52d5\u304b\u305b\u307e\u3059\u3002\n\u25a0\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9\u306a\u306e\u3067\u670d\u88c5\u306b\u7f9e\u6065\u306f\u306a\u304f\u3001\u983c\u307e\u308c\u305f\u308a\u547d