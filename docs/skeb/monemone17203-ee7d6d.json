ではないが隊長の勢いと力強さに驚き圧倒されている」というイメージ。\n・居合わせた夜露とシタラが仕事中の文嘉の様子を見て「なんか様子がおかしい？」とハテナマークを浮かべている一コマを入れて頂ければ背徳感が増して個人的に嬉しいです。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@monemone17203/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 9199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9988f00dab86e0af2689d00db5071d4e", "srcset": "https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9988f00dab86e0af2689d00db5071d4e, https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c17df73f25a9ed2efbcd0895344f00a 2x, https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4285645a6e1910273d90e5ead9b65a86 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1359f62c118bfd5f131a80532a7af6bf", "srcset": "https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1359f62c118bfd5f131a80532a7af6bf, https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad5ce025b83340cf98c75f4d486fbe78 2x, https://si.imgix.net/362ed5cd/uploads/origins/6bdaa17c-eb5b-4db4-93de-ecbdab8fcb4f?bg=%23fff