が推しCPですが、BLなためCP要素の有無はどちらでも大丈夫です。\n・構図、シチュエーションなどお任せいたします。ご自由に描いてくださいますと幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\n資料URL\nhttps://www.dropbox.com/scl/fo/iutgeyrya7jv7atabi4fz/h?rlkey=wugwh58r99ctibrs4m2h3tvbd&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Mystuff/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2985317, "client_id": 243317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3177860e/uploads/origins/05a3eb0e-9aa7-4f65-bf7f-92b188165782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891945000cc4a3692a3b4627a1fab6b3", "srcset": "https://si.imgix.net/3177860e/uploads/origins/05a3eb0e-9aa7-4f65-bf7f-92b188165782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891945000cc4a3692a3b4627a1fab6b3, https://si.imgix.net/3177860e/uploads/origins/05a3eb0e-9aa7-4f65-bf7f-92b188165782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f81577fc651ccab7384238ee183f5eef 2x, https://si.imgix.net/3177860e/uploads/origins/05a3eb0e-9aa7-4f65-bf7f-92b188165782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b17a32345042608ca76024061b8f8f51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3177860e/uploads/origins/05a3eb0e-9aa7-4f65-bf7f-92b188165782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49793a3cb31cbf16b32afd8c183ddf10", "srcset": "https://si.imgix.net/3177860e/uploads/origins/05a3eb0e-9aa7-4f65-bf7f-92b188165782?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49793a3cb31cbf16b32afd8c183ddf10, https://si.imgix.net/3177860e/uploads/origins/05a3eb0e-9aa7-4f65-bf7f-92b188165782?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=78367527c87a661b55d58e4