f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=840150daac37f09a48b8e45db996f8b2 2x, https://si.imgix.net/64df1c1a/uploads/origins/07a57ad2-81b6-426c-a8bd-abc1747566f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c8d7c1721edb8e4e08b87e879e4e99c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64df1c1a/uploads/origins/07a57ad2-81b6-426c-a8bd-abc1747566f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58da199239f4a5938619a57f979b0736", "srcset": "https://si.imgix.net/64df1c1a/uploads/origins/07a57ad2-81b6-426c-a8bd-abc1747566f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58da199239f4a5938619a57f979b0736, https://si.imgix.net/64df1c1a/uploads/origins/07a57ad2-81b6-426c-a8bd-abc1747566f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d086d522f93333df00193da44988c70 2x, https://si.imgix.net/64df1c1a/uploads/origins/07a57ad2-81b6-426c-a8bd-abc1747566f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13b5935b7f7b1bea41fb066de86fdaf1 3x"}, "body": "拝啓\nわんわんうるふ殿\n\n大変唐突なご依頼となり恐縮ではございますが、どうしてもお伝えしたい願いがございます。\n\nそれは、【あなた様ご自身のアバターを、あなた様ご自身の筆で描いていただきたい】という、文字にしてもなお正気を疑われるようなお願いにございます。\n\n私があなた様のアバターを初めて目にした瞬間、胸中にひときわ鮮烈な光が走り、景色の焦点がすべてあなた様の姿へ吸い寄せられてしまいました。\n\nその佇まいは、ただのデジタルモデルとは到底呼べぬものでございます。\n星屑をすくって溶かしたインクで輪郭を描き、月光の雫を混ぜた絵具で彩色を施したような、この世と別の理に属した存在。\nそれに加え、アルプスの天然水のような透き通った声に、湖で踊る妖精のような可憐な振る舞い。\nまさに、月から舞い降りた女神。\nそう形容するほかございません。\n\n髪の揺らぎはそよ風の密談のように柔らかく、衣装は夜明け前の空の薄明かりめいて静謐で、視線には春先の黎明に咲き出す花の息吹すら感じられます。\n\n美しいという語彙は、もはやあなた様の前では及ばず、麗しいは軽く、尊いでは足りず、語彙辞典を総動員してもなお追いつけない、そんな圧倒的な存在感にございます。\n\nそして気づいてしまったのです。\n「この美しさこそ、あなた様自身のお手によって描かれるべきではないか」と。\n\n推しであり、創造者であり、表現者でもある貴殿が筆を取られる瞬間は、さながら奇跡の発生条件が整った聖域でありましょう。\n\n私はその奇跡を、この世界でただ一つの作品としてお迎えしたいと切望しております。\n\nもちろん無理にとは申しません。\nしかし、もしその奇跡を賜れましたならば、私は額縁を買い求め、壁に掛け、毎朝礼拝を行い、晴れの日は讃歌を捧げ、台風の日には抱きしめて守る覚悟でございます。\n\nそして、疲れた夜には灯火となり、忙しい朝には呼吸の余白となり、時に心が揺らぐときは道標となるはずでございます。\n\nご提示する指定はございません。\n構図も、表情も、衣服も、すべてあなた様の「これが私だ」という直感に委ねたく存じます。\n\nあなた様がつむぐ一本の線は、描く前からすでに特別です。\n\nどうかこの厚かましい願いをお許しいただき、ご検討の片隅に置いていただけましたら幸甚にございます。\n\n敬具", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rufurufu11/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3643672, "client_id": 3854958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0cce065/uploads/origins/edea16c4-c60f-4341-9d3c-6ceb2aacd3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43cf128a0c1642a4814fab46240ab960", "srcset": "https://si.imgix.net/d0cce065/uploads/origins/edea16c4-c60f-4341-9d3c-6ceb2aacd3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43cf128a0c1642a4814fab46240ab960, https://si.imgix.net/d0cce065/uploads/origins/edea16c4-c60f-4341-9d3c-6ceb2aacd3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ad58324ccb01caa84edf9af31808913 2x, https://si.imgix.net/d0cce065/uploads/origins/edea16c4-c60f-4341-9d3c-6ceb2aacd3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09308bd5820ecb9aabd547b503d2d996 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0cce065/uploads/origins/edea16c4-c60f-4341-9d3c-6ceb2aacd3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=feec2afc3f5d6ab93bb4c015a1f9b50c", "srcset": "https://si.imgix.net/d0cce065/uploads/origins/edea16c4-c60f-4341-9d3c-6ceb2aacd3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=feec2afc3f5d6ab93bb4c015a1f9b50c, https://si.imgix.net/d0cce065/uploads/origins/edea16c4-c60f-4341-9d3c-6ceb2aacd3cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr