s=4fa3be634235d943d653aaed05bf492f, https://si.imgix.net/3cedfdf1/uploads/origins/91a39bf9-f3cb-4947-b67a-98ae44dbde3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8ae0385c42e2c3dc8afb54a50e29151 2x, https://si.imgix.net/3cedfdf1/uploads/origins/91a39bf9-f3cb-4947-b67a-98ae44dbde3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1d791cdf4a22615a6fe340e00411896 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3cedfdf1/uploads/origins/91a39bf9-f3cb-4947-b67a-98ae44dbde3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20116b48dcd32ce81da4534d70b1a700", "srcset": "https://si.imgix.net/3cedfdf1/uploads/origins/91a39bf9-f3cb-4947-b67a-98ae44dbde3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20116b48dcd32ce81da4534d70b1a700, https://si.imgix.net/3cedfdf1/uploads/origins/91a39bf9-f3cb-4947-b67a-98ae44dbde3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=989a135936c4bf2a4307ccb8ee1103c9 2x, https://si.imgix.net/3cedfdf1/uploads/origins/91a39bf9-f3cb-4947-b67a-98ae44dbde3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7df88aeafb53117b3fec86fdbcaee355 3x"}, "body": "こんにちは。\n\n私の2人のOCのアートをお願いしたいのですが。\n\nhttps://drive.google.com/drive/folders/1o5wVZm2_d96skaWohudJzxVatK2kXtGI\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi\n\nDIAはMelodyより少し背が高い。DIAは「クールなお姉さん」っぽいのんびり女の子。常時は生意気だけど、いざって時に頼もしいプロになれる。彼女は意識的、行動前に徹底的な計画を立てるのが好きだ。怠惰な自然によると大体火器で戦って、非常しかないで変身能力を使う。趣味は探偵小説とフィルム・ノワールだ。彼女は甘いペストリーとブラックコーヒーが好きだ。ふっくらとした大きな胸と柔らかそうな体。\n\nMelodyはちょっとおてんば娘。とても自信家で、どんな状況にもすぐに適応できる。とても頼りになるが、気が短い。外向的で、人助けが好きな女の子だ。Melodyが使うのは、大きなレンチと剣、そして体力だ。彼女は他の道具や即席の武器も適当に使う。趣味は特撮番組と漫画。辛い食べ物と甘いコーヒーが好きだ。Melodyは控えめな胸とむっちりとした太もも、そしてキュートなお尻を持っている。引き締まった体つきをしている。肌は少し日焼けしている。\n\n女の子たちがバニーのコスチュームを着ている姿を見てみたいです。表情は自信に満ちたものか、あるいは遊び心のあるものにしたいです。ヌードバージョンの作成をお願いしたいのですが。ポーズや衣装の詳細は先生にお任せします。\n\nご自由に描いてください。先生にとってかっこいいシーンであればうれしいです。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1rbLkQd4qoMdKUfpPmfW6nhO6eHy0H2PM", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@julesvol/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3927690, "client_id": 3848434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d24f4a1/uploads/origins/3d2ebf81-8e33-4bd6-9141-ee0ef2997aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34ef8173e2dd0bbb529b7873ca932b38", "srcset": "https://si.imgix.net/6d24f4a1/uploads/origins/3d2ebf81-8e33-4bd6-9141-ee0ef2997aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34ef8173e2dd0bbb529b7873ca932b38, https://si.imgix.net/6d24f4a1/uploads/origins/3d2ebf81-8e33-4bd6-9141-ee0ef2997aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68c5ad483fee1c3f6500221548b5e7de 2x, https://si.imgix.net/6d24f4a1/uploads/origins/3d2ebf81-8e33-4bd6-9141-ee0ef2997aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5d4b6a76fd4befcf575cb1d981b184d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d24f4a1/uploads/origins/3d2ebf81-8e33-4bd6-9141-ee0ef2997aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c92e0355f16618d2eaba4f0c467232b4", "srcset": "https://si.imgix.net/6d24f4a1/uploads/origins/3d2ebf81-8e33-4bd6-9141-ee0ef2997aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c92e0355f16618d2eaba4f0c467232b4, https://si.imgix.net/6d24f4a1/uploads/origins/3d2ebf81-8e33-4bd6-9141-ee0ef2997aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7729212f52e026