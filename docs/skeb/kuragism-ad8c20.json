す\n（労力的に見合わなければ こちらはスルーされて下さい）\n\n納品データはPNGもしくはPSDデータでお願いします\nどうぞよろしくお願い致しますm(__)m", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuragism/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3954477, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=121b8d04f75fd2255557bf00aef62993", "srcset": "https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=121b8d04f75fd2255557bf00aef62993, https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a94899bd320595b21adc8975b4a40d4 2x, https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25dfbce5f93e7d36673eb4fcbe110c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec97769ffa02f9b3a6727c2a0afd3cf", "srcset": "https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ec97769ffa02f9b3a6727c2a0afd3cf, https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa468b853c1c120a1be6ff5421823875 2x, https://si.imgix.net/58f9fafe/uploads/origins/c3cf3e1f-cdd3-4289-be1e-1e6218005004?bg=%23fff&auto=format%