u4f55\u5352\u5b9c\u3057\u304f\u304a\u9858\u3044\u7533\u3057\u4e0a\u3052\u307e\u3059\u2026\u3002\n\n\uff0a\u5f53\u65b9OC\n\u540d\u524d\uff1a\u5263 \u611b\u7f85(\u3064\u308b\u304e\u30fb\u3042\u3044\u3089)\n\u5e74\u9f62\uff1a15\u6b73(\u9ad81)\n\u8077\u696d\uff1a\u30a2\u30a4\u30c9\u30eb+\u5fcd\u8005\n\u6027\u683c\uff1a\u666e\u6bb5\u306f\u306e\u3093\u3073\u308a\u30d5\u30ef\u30d5\u30ef\uff0f\u30b9\u30c6\u30fc\u30b8\u3067\u306f\u660e\u308b\u304f\u5143\u6c17\n\u273d\u5bb9\u59ff\n\u982d\u9aea\uff1a\u660e\u308b\u3044\u9ec4\u8272\uff0f\u5207\u308a\u63c3\u3048\u305f\u524d\u9aea\u306f\u659c\u3081\u5206\u3051\uff0f\u9854\u5074\u9762(\u8033\u306e\u524d)\u306e\u9aea\u306f\u984e\u3088\u308a\u4e0b\u307e\u3067\u5782\u308c\uff0f\u5f8c\u308d\u9aea\u306e\u30dd\u30cb\u30fc\u30c6\u30fc\u30eb\u306f\u80cc\u4e2d\u306b\u4ed8\u304f\u7a0b\u5ea6\u306e\u9577\u3055\n\u9854\u7acb\u3061\uff1a\u67d4\u548c\u306a\u96f0\u56f2\u6c17\uff0f\u4e38\u3044\u5782\u308c\u76ee\uff0f\u77b3\u306f\u8336\u8272\n\u4f53\u578b\uff1a\u8eab\u9577150cm\u3001\u30d0\u30b9\u30c887cm\uff0f\u5c0f\u67c4\u3067\u30b0\u30e9\u30de\u30e9\u30b9\n\u273d\u670d\u88c5\n\u5fcd\u8005\u88c5\u675f\u3084\u548c\u670d\u306e\u610f\u5320\u3092\u53d6\u308a\u5165\u308c\u305f\u30b9\u30c6\u30fc\u30b8\u8863\u88c5\u3067\u3059\u3002\u30d5\u30ea\u30eb\u306f\u8cc7\u6599\u753b\u50cf\u3088\u308a\u3082\u5927\u304d\u3081\u306b(\u30d5\u30a1\u30f3\u30b7\u30fc\u306b)\u304a\u63cf\u304d\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\u982d\uff1a\u9aea\u7559\u3081\u306f\u30ea\u30dc\u30f3\uff0f\u984d\u306b\u9244\u677f\u304c\u8cbc\u3089\u308c\u305f\u300c\u9262\u91d1\u300d(\u7d50\u3073\u76ee\u306f\u524d\u304b\u3089\u898b\u3048\u307e\u305b\u3093)\n\u4e0a\u534a\u8eab\uff1a\u524d\u5408\u308f\u305b\u30fb\u5e2f\u30fb\u3061\u3087\u3046\u3061\u3093\u8896\u30fb\u624b\u7532(\u4e2d\u6307\u3068\u624b\u9996\u3067\u56fa\u5b9a)\n\u4e0b\u534a\u8eab\uff1a\u30df\u30cb\u30b9\u30ab\u30fc\u30c8\u30fb\u30b5\u30a4\u30cf\u30a4\u30d6\u30fc\u30c4(\u722a\u5148\u304c\u8d