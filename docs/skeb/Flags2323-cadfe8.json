ound!×Lyrical Lily合同LIVE「TWO RHYTHM☆TOURISM」で\n竹下みいこ役 渡瀬結月様宛に有志でフラワースタンドを贈ろうと考えており、\nフラワースタンドに飾るパネルにイラストを使用させていただきたいです。\n\nライブタイトルのTWO RHYTHM☆TOURISMに因んで、ワクワクしながら旅行を楽しんでるみいこちゃんを書いていただければと思います。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Flags2323/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 55594, "client_id": 862496, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25c293b0/uploads/origins/3e159fb3-e97c-4f49-a0d4-ef7825e6d422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69d3350d02da28b30afa9c23ac75ac5a", "srcset": "https://si.imgix.net/25c293b0/uploads/origins/3e159fb3-e97c-4f49-a0d4-ef7825e6d422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69d3350d02da28b30afa9c23ac75ac5a, https://si.imgix.net/25c293b0/uploads/origins/3e159fb3-e97c-4f49-a0d4-ef7825e6d422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef46895ff612700545817b0e675314d0 2x, https://si.imgix.net/25c293b0/uploads/origins/3e159fb3-e97c-4f49-a0d4-ef7825e6d422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a91d9aaa790389ddf0001a8b0c54431e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25c293b0/uploads/origins/3e159fb3-e97c-4f49-a0d4-ef7825e6d422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6285228a82519fde91ab0d9b9031f86", "srcset": "https://si.imgix.net/25c293b0/uploads/origins/3e159fb3-e97c-4f49-a0d4-ef7825e6d422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6285228a82519fde91ab0d9b9031f86, https://si.imgix.net/25c293b0/uploads/origins/3e159fb3-e97c-4f49-a0d4-ef7825e6d422?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=879077af48495c326796ad1bc856c3e9 