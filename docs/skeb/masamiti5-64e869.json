200&h=200&blur=200&s=773068684617e5de128cc86b173488fb", "srcset": "https://si.imgix.net/5bfb9ec1/uploads/origins/896b4b6b-b4c4-4849-b264-32c138526ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=773068684617e5de128cc86b173488fb, https://si.imgix.net/5bfb9ec1/uploads/origins/896b4b6b-b4c4-4849-b264-32c138526ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b4fda518bdd77cc4750b4ea99540d7a 2x, https://si.imgix.net/5bfb9ec1/uploads/origins/896b4b6b-b4c4-4849-b264-32c138526ab6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=949473ad6f45e8459182891dd90cce4f 3x"}, "body": "こんにちは、佳虫\n前回も依頼を受けていただきありがとうございました！\n今回もよろしくお願いします\n\n前回の絵https://skeb.jp/@masamiti5/works/11の続きをお願いします\n「佳虫のアバターの芋虫を呑み込んで艶めかしくお腹をさする絵」をお願いします\n姿勢は白いシーツのベッドの上で状態を少し後ろに反らしたぺたん座りでお願いします\nあと横に胃の中の絵もお願いします\n服装は引き続き黒いブラとパンツとニーソの上にワイシャツを着たカッコでお願いします\n\n以上のよろしければお願いします", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masamiti5/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2350422, "client_id": 897326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dce43345bbab0880e1339dde5639e5b", "srcset": "https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dce43345bbab0880e1339dde5639e5b, https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cef07313b8f2173e7a1ffe56f13f6f92 2x, https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16314e857929c33536fd394b791d93e8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba9ef08d453f60ca0721fc3f1268ba7", "srcset": "https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba9ef08d453f60ca0721fc3f1268ba7, https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87565e6294a1a8b5613184f5ae795fec 2x, https://si.imgix.net/64dddf79/uploads/origins/309fc7ce-ec5f-4802-a0b8-25ca51663047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04403090cb51b60262fdf17eb38d9bf6 3x"}, "body": "何時もお世話になっております。\nこのたび一題、こちらでリクエストさせていただきます。\n何卒、宜しくお願い申し上げます…。\n\n＊人物\n『艦隊これくしょん』の「鳳翔」さんを希望します。\nリアル頭身で、清楚可憐かつ悩ましいお姉さんとしてご描写いただけますと幸いです。漆黒の髪も艶やかに…。\n\n＊状況\n「黒色系の競泳水着」姿で、床の上にしどけなく仰臥している様子。\n周囲には和服・袴・襷・弓矢・弽・艤装などを適度に脱ぎ散らかしていただきたく存じます(全てでなくとも、一部だけでも…)。\n両目は開いてカメラ目線、口も少し半開き…困惑と恥じらいの表情。\n胸は盛らずに(平坦ではない程度に)控えめをお願いします。「胸ポチ」の有無はお任せ。\n水着の表面は半ば濡れた感じで、ツヤツヤにしていただけますと嬉しく存じます。\n背景までお描きいただけます場合、床は木の板張りを希望します。\n\n＊その他\n基本のポニーテールに加え、後ろ髪をロングヘアーに下ろした差分もご添付いただけますと望外の喜びでございます。\n\n以上、長文・乱文につき大変失礼いたしました。ご検討いただけますと有難く存じます…。\n\nhttps://z.wikiwiki.jp/gameheroines/topic/14", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masamiti5/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2350422, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9165c45cdebb49968445459fd22e852f", "srcset": "https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9165c45cdebb49968445459fd22e852f, https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c78821c91a82de04e97a259dc789f9d 2x, https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9af285750f749eafc0568cc2b0c4a569 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c6c66a5f1467052860d2904df523a77", "srcset": "https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c6c66a5f1467052860d2904df523a77, https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8306e2fb47bd1408515cad018681cf 2x, https://si.imgix.net/2b966ad8/uploads/origins/28530d4c-ecf6-49c4-bccb-978f3d687189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed8196626068905fa6c799ded5fc66cd 3x"}, "body": "募集しているのを確認しました、初めて送らせていただきます、\nキャラ：リリカルなのはのシャマル\n検査台の上で全裸で眠っているシャマルをお願いします。\nイメージ的には「身体検査」で検査を受ける前の状態で。\nシャマルの体勢は仰向けで手足はまっすぐ伸ばした状態、そしてパイパン希望です。\n\nこれで宜しければお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masamiti5/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2350422, "client_id": 2901806, "vtt_url":