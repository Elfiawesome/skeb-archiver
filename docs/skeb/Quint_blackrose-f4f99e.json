a3-0f8b-4cf0-a4ac-85d9ac547340?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4495508f99d6b336bc0e8e7f4798919, https://si.imgix.net/446edbcd/uploads/origins/d597b0a3-0f8b-4cf0-a4ac-85d9ac547340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45a2156d00d850f021f04d07bdd06d04 2x, https://si.imgix.net/446edbcd/uploads/origins/d597b0a3-0f8b-4cf0-a4ac-85d9ac547340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac4dfb1164e9922bb48420b9c99898a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/446edbcd/uploads/origins/d597b0a3-0f8b-4cf0-a4ac-85d9ac547340?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff5ec55a9d52b534292f419cfc6f9d4a", "srcset": "https://si.imgix.net/446edbcd/uploads/origins/d597b0a3-0f8b-4cf0-a4ac-85d9ac547340?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff5ec55a9d52b534292f419cfc6f9d4a, https://si.imgix.net/446edbcd/uploads/origins/d597b0a3-0f8b-4cf0-a4ac-85d9ac547340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6f94369d42218b197eec2ad477504be 2x, https://si.imgix.net/446edbcd/uploads/origins/d597b0a3-0f8b-4cf0-a4ac-85d9ac547340?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6d7d304273928c2d2ac0f78e1e63ffa 3x"}, "body": "クイント様の眷属です いつも応援してます\n\n遊戯王OCGシリーズより\nモンスターの”珠の御巫フゥリ”に装備された\n装備魔法 ”諸刃の剣”で\n相手モンスターの”粛声の祈り手ロー”を攻撃するシーンを描いて頂けると元気な依頼主が喜びます\n\n\n\nここからは余談になりますが諸刃の剣を装備した御巫フゥリが祈り手ローを攻撃した際のダメージ計算式として\nフゥリ(ATK0)+諸刃の剣(ATK2000)－祈り手ロー(ATK50)＝1950ダメージという計算になりますが\n諸刃の剣の効果で”与えたダメージ分自分もダメージを受ける”という効果に対して\n御巫モンスターの効果で”受けるダメージを相手が代わりに受ける”と言う効果になる為\n御巫フゥリが与えた1950+受けた1950ダメージで合計3900ダメージを出せるのでもし状況が分かりづらい場合は\n”1発で体力が半分消し飛ぶ攻撃が飛んでくる”と思って頂けると状況が分かりやすいかもしれません\n\n現代遊戯王カードには可愛いキャラか沢山いるので始めなくてもキャラを見るだけでいいんで是非", "nc": 128, "word_count": 0, "transcoder": "image", "crea