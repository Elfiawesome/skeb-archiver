と思い、リクエストさせていただきます。\n\n▶︎参考資料\nhttps://drive.google.com/drive/folders/1rgYSATJw8mpebrRGlsFzXCUWoEWs_x0a\n\n▶︎外見特徴\n・オッドアイ\n・髪に✧の模様\n・雲・雷・雨モチーフの飾り\n\n▶︎構図\n特に指定等ありませんので、ミント山田様のご自由にお描きいただければと思います。\n固定衣装も存在しませんので、お好きに描いていただけますと幸いです。\n\n▶︎使用用途\n・SNSのアイコンやヘッダー、PC・スマホの壁紙としての個人利用\n・アクリルキーホルダーや本など、個人鑑賞目的でのグッズ作成\n・今後skeb等依頼する際の参考資料としての活用\n\n▶︎その他\nキャラクターと背景等を分けたPSD形式のイラストだと嬉しいです。\nまた、ラフ段階のイラストや没になったもの等がありましたら、残していただけると嬉しいです。\n\nご依頼内容や金銭面で不明点や問題がある場合は、遠慮なく再送・キャンセルしてくださいませ。\nご多忙のところ恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rgYSATJw8mpebrRGlsFzXCUWoEWs_x0a", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MintyamadaM/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3941223, "client_id": 3572079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/694e2729/uploads/origins/7d7073ee-c700-42a5-8cc2-03fc99719785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23b05d805869f3d60d64c192e438a497", "srcset": "https://si.imgix.net/694e2729/uploads/origins/7d7073ee-c700-42a5-8cc2-03fc99719785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23b05d805869f3d60d64c192e438a497, https://si.imgix.net/694e2729/uploads/origins/7d7073ee-c700-42a5-8cc2-03fc99719785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff694e71a07ebfd4ff3c751fc895c105 2x, https://si.imgix.net/694e2729/uploads/origins/7d7073ee-c700-42a5-8cc2-03fc99719785?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb4cb45ee589bc7572d3187d7d42312e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/694e2729/uploads/origins/7d7073ee-c700-42a5-8cc2-03fc99719785?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b05048cc297093c7228370f7af2ad47c", "srcset": "https://si.