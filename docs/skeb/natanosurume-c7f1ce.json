/drive/folders/1UATpiYtAZjfOA90nkyZhSryDgeuIRvdZ?usp=drive_link\n\n✦SS（読まなくても大丈夫です）\nhttps://cooc1021.jimdofree.com/novel/血と薔薇-或いはバイ-マイ-サイド/\n\nシチュエーションや雰囲気等お任せいたします。\nご自由に描いていただけると嬉しいです。\n\nまた、完成品は作者IDやskebのURL等明記の上自サイトにて掲載させていただきたいと思っております。\n\nご検討よろしくお願いいたします。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natanosurume/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3210938, "client_id": 3586082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b0f202827a333ab0f7b62b32a241de3", "srcset": "https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b0f202827a333ab0f7b62b32a241de3, https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fae6d5dd4523cf32eddc41f583a236de 2x, https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23023cfcc033e2743018f563073ab841 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6376ecfd073de475f66bbaa525a14f04", "srcset": "https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6376ecfd073de475f66bbaa525a14f04, https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d08ae9d86cd85dc6c5650698e8abfa9 2x, https://si.imgix.net/2d35744b/uploads/origins/a61e2723-109a-4255-ae48-da13bf8c091c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4107895a212ace770bcdd7e6b5b87df0 3x"}, "body": "なたのするめ様、はじめまして\nヤンデレが大好きでXの方で作品を見かけて癖に刺さったので男女ペア画で依頼させていただきます。\n\n【キャラ設定】\n幼い頃からお嬢様をお世話している執事で実は吸血鬼（ヤンデレ男子）\n\nお嬢様（素直で純粋な女の子）\n\n【ヤンデレ執事吸血鬼の容姿】\n・髪→前髪ありの短髪で黒髪、右髪に白色のメッシュがある。\n・目→黄金色\n・服装→スーツ【黒色】\n\n【設定】\n20代前半\nお屋敷に務めていて礼儀作法が完璧で主人からも高い信頼を得ている。\n幼い頃から大切にお世話しているお嬢様のことが大好きすぎて自分以外の吸血鬼に吸血させてたまるか、外の世界を見せたくない思いが強いが気持ちに蓋をしている状態。\n本心は監禁して自分だけを見てほしいくらいにお嬢様への愛が強い。\n大切にしているが吸血衝動が抑えきれないときもあり【お嬢様、申し訳ありません、限界です…】と吸血するときもある。\n\n【お嬢様の容姿】\n・髪→前髪ありで肩下まである髪【ミルクティーベージュ】\n・目→黄金色\n・服装→ドレス【白色】\n\n【設定】\n20代前半\n吸血鬼たちが好む極上の血の持主\n何事にも熱心で気遣い上手\nとても優しく素直すぎて危険な場面に遭遇することもしばしば…\n幼い頃、他の吸血鬼に襲われそうになったが助けてくれた執事のことを高く信頼している。\n内気なので自分から吸血してほしいと言えない。\n\n【構図】\n男子→女の子の顔を見上げて反応を楽しみながら首筋から吸血してる感じてお願いします。\n女の子→右目は涙目、左目は閉じて痛みを耐えているようにお願いします。\n\n大変お忙しいと思いますがご検討よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natanosurume/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ac6bb3fb/uploads/origins/ebdc4f0b-0a35-477c-adc7-850aa1e369d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ba7ba257a23d57ceff686620dcdc70f", "srcset": "https://si.imgix.net/ac6bb3fb/uploads/origins/ebdc4f0b-0a35-477c-adc7-850aa1e369d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6ba7ba257a23d57ceff686620dcdc70f, https://si.imgix.net/ac6bb3fb/uploads/origins/ebdc4f0b-0a35-477c-adc7-850aa1e369d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2485358586fb5a8c1b2d23dfc4c1643 2x, https://si.imgix.net/ac6bb3fb/uploads/origins/ebdc4f0b-0a35-477c-adc7-850aa1e369d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01a1e108e92d7ba92830c5756c5f3084 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3210938, "nc": 128}, {"path": "/@natanosurume/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3210938, "client_id": 1536545, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=650e5691212e3ffeb5bea72a32c7c301", "srcset": "https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=650e5691212e3ffeb5bea72a32c7c301, https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7643b6c0b98160559a537ea3a246827c 2x, https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd92651697e23e13304378a8b789286e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c997c71bb673c853eb9b39d0b5d2deef", "srcset": "https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c997c71bb673c853eb9b39d0b5d2deef, https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdc388f1198adc8fcc1c7d416a09a5d0 2x, https://si.imgix.net/aa020b98/uploads/origins/fa80f24f-e886-4c7d-acd8-e5c6febc2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20f6246653ed6a85c02d61d88b16bf7e 3x"}, "body": "はじめまして。\nヤンデレが好きであなたの作品をお見かけし、あなたの描かれる女の子に一目惚れしました！自創作キャラクター二人をぜひ描いて頂きたいと思い依頼させていただきます。\n18世紀のフランスで片想い中の売れない画家(ヤンデレ男子)と、その片想い相手の女流作家という設定のキャラクターです。\n\n《ヤンデレ画家の容姿》\n・髪や肌が真っ白\n・肩くらいまである髪をひとつに結び、ローポニーテールにしている(髪は少しカールがかっています)\n・前髪で左目が隠れるタイプのメカクレ(目が隠れるほど前髪が長いという設定なので、構図によっては目が見えていても大丈夫です)\n・目も色素が薄くグレー\n・白いシャツを着ている(ボトムスはなんでも大丈夫です。また白いシャツが絵の具で汚れていてもボロボロでも構いません)\n\n《設定》\n20代前半。名はラファエル。\nお嬢様育ちの作家の女の子(売れ始めてる)に恋をしていまして、狂ったように何千何百枚と彼女の絵を描いています。ただ、彼女には友達としてしか見られていません。\n当の彼女は貴族生まれのイケメン音楽家とスキャンダルになっていて、新聞で取り沙汰されている真っ最中。\n傍から見ると彼の恋はどう足掻いても叶わないのですが、彼はヤンデレのため彼女の事しか考えられず、彼女の絵しか描けない状態です。「彼女の絵しか描けない、でも彼女は僕を愛していないかもしれない、でも筆を取ると彼女以外浮かばない」という負のループを延々と繰り返しています。彼女に嫌われるのが怖くて、監禁に踏み出す勇気もありません。\n\n\n\n《作家女の子の容姿》\n・腰まである金髪(巻いてる)\n・前髪あり\n・青い目\n・売れてる、血筋がいい、かつ色んな男に貢がれてるので、ドレスや宝石など良い身なりをしています\n《設定》\n20歳手前。名はマリア。\n天使のような微笑みの裏でわりと浮気性です。\n全ての人に優しいため誰からも好かれるのですが、愛されたがりのため敢えてヤンデレ画家を拒絶しません。\n\n二人は共依存の関係にあり\n「……僕ね、君が好き。好きだよ」\n「ありがとう」\n「君も好きとは言ってくれないんだね」\n「……私にはあなたしかいないのよ」\n「それ、他の男にも言ってるだろう」\n「うふふ、バレた？」\nというような会話ばかりします。\n\nポーズなどはお任せします。\nお忙しいとは存じますがご検討頂けますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13745, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "甘辛猫", "screen_name": "ekk_latek", "avatar_url": "https://pbs.twimg.com/profile_images/1913150388255223808/SY2LbPSm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2678996244/1539181813/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_accept