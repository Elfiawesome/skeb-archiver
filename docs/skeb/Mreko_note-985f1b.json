は「童貞勇者と隠しダンジョン」に登場する村長の娘との対面座位セックスをお願いしたいです。\n勇者の姿は灰色の人型シルエットで書いてほしく、内容は勝手に魔物を討伐しようとした勇者に村長の娘が怒りながらお仕置きセックスをするという感じです。村長の娘は勇者の首に腕を回してる感じでお願いします。勇者は村長の娘のおっぱいを吸ってる感じで村長の娘の腰に手を添えてる感じの体位でお願いします。\nもしよければセリフも追加してくれると嬉しいです。金額や何か不備があれば却下しても構いません。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mreko_note/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 901817, "client_id": 3413255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0895fd31/uploads/origins/4e196c22-4762-44bb-9a5f-6cd722ee6358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9dd160a0ee9342b31f5c38c2e697b9a", "srcset": "https://si.imgix.net/0895fd31/uploads/origins/4e196c22-4762-44bb-9a5f-6cd722ee6358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9dd160a0ee9342b31f5c38c2e697b9a, https://si.imgix.net/0895fd31/uploads/origins/4e196c22-4762-44bb-9a5f-6cd722ee6358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3910c6e380179d0884e6ca93e37cbfcf 2x, https://si.imgix.net/0895fd31/uploads/origins/4e196c22-4762-44bb-9a5f-6cd722ee6358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e63827705e7ec404e852469de8b93075 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0895fd31/uploads/origins/4e196c22-4762-44bb-9a5f-6cd722ee6358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9794c7653c504651b47a2f827f3f883f", "srcset": "https://si.imgix.net/0895fd31/uploads/origins/4e196c22-4762-44bb-9a5f-6cd722ee6358?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9794c7653c504651b47a2f827f3f883f, https://si.imgix.net/0895fd31/uploads/origins/4e196c22-4762-44bb-9a5f-6cd722ee6358?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=20