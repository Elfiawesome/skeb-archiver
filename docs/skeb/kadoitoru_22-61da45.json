は、少し地味で、静かで、瞑想的なものにしたい。夜の自然や、彼の寺院にインスパイアされたものがあればありがたい。\n\nいくつか注意点があります：\n- 彼の顔のマークはオプションで、別のパターンに変えることができます。\n- 彼の肌は青ではなく紫であることに注意してください。\n- 彼は痩せていて、腹筋はありません（あまり筋肉質ではありません）。\n- 彼はいくつかの衣装を持っています。一番描きたい服を選んでください。お好みで細部を変更することもできます。\n\n参考：https://drive.google.com/drive/folders/130xooi-oDHNDokUyQ3iGcFTc8WngNG72?usp=sharing\n\nバイオ：https://toyhou.se/2061814.libra-melia\n\nありがとうございました！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kadoitoru_22/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3222170, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84053b6a/uploads/origins/a8af1bf7-1895-4a5d-8af5-dff9694db7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde7fc624b9da3c49a100407a25f3999", "srcset": "https://si.imgix.net/84053b6a/uploads/origins/a8af1bf7-1895-4a5d-8af5-dff9694db7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde7fc624b9da3c49a100407a25f3999, https://si.imgix.net/84053b6a/uploads/origins/a8af1bf7-1895-4a5d-8af5-dff9694db7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3535f38b695616e3ecbcde02a4f4912 2x, https://si.imgix.net/84053b6a/uploads/origins/a8af1bf7-1895-4a5d-8af5-dff9694db7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2f004303c75814b66b0790f57434376 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84053b6a/uploads/origins/a8af1bf7-1895-4a5d-8af5-dff9694db7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98b2aeffb3d98b5d086a62cd458bb50c", "srcset": "https://si.imgix.net/84053b6a/uploads/origins/a8af1bf7-1895-4a5d-8af5-dff9694db7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98b2aeffb3d98b5d086a62cd458bb50c, https://si.i