rmy2/works/4）。私のOCであるRieraを同じようなスタイルとポーズで描いていただけませんか？\n\nリエラはヴァンパイアになったばかりで、最近コウモリの仲間であるバッツィーに出会いました。リエラがバッツィーを抱きしめているような絵、できれば微笑ましい表情でお願いしますイメージしやすいようにポーズの参考資料を添付します。その他の絵の構成はお任せします。\n\nリクエストにお答えいただき、ありがとうございました\n\nhttps://drive.google.com/drive/folders/1BTB7SZuBWBO7XC7f-4W-qLqbs0ut1lNZ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_mrmy2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2595049, "client_id": 442252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c65b807/uploads/origins/c0685ca4-f4ba-4190-af59-f362d740b2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=646a993c9dd4f00359cdaa8ed977133b", "srcset": "https://si.imgix.net/6c65b807/uploads/origins/c0685ca4-f4ba-4190-af59-f362d740b2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=646a993c9dd4f00359cdaa8ed977133b, https://si.imgix.net/6c65b807/uploads/origins/c0685ca4-f4ba-4190-af59-f362d740b2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2060179aa4fb39cb8ad18ed14870590 2x, https://si.imgix.net/6c65b807/uploads/origins/c0685ca4-f4ba-4190-af59-f362d740b2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7bdc73d0941e2ab18f17da9e45c246a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c65b807/uploads/origins/c0685ca4-f4ba-4190-af59-f362d740b2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1027d51f101843d537368af0f32d23ab", "srcset": "https://si.imgix.net/6c65b807/uploads/origins/c0685ca4-f4ba-4190-af59-f362d740b2ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1027d51f101843d537368af0f32d23ab, https://si.imgix.net/6c65b807/uploads/origins/c0685ca4-f4ba-4190-af59-f362d740b2ba?bg=%23fff&auto=fo