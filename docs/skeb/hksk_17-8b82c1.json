44\u3002\n\n\n\u25fc\ufe0e\u4f7f\u7528\u76ee\u7684\n\u500b\u4eba\u7528\u30b0\u30c3\u30ba\u4f5c\u6210\u3001\u4f9d\u983c\u6642\u306e\u8cc7\u6599\u3001\u9451\u8cde\u7528\u3068\u3057\u3066\n\n\u25fe\ufe0e\u30a4\u30e9\u30b9\u30c8\u306e\u30b5\u30a4\u30ba\n\u5168\u8eab\u7acb\u3061\u7d75\u3001\u80cc\u666f\u3042\u308a/\u306a\u3057\u3001psd\u30d5\u30a1\u30a4\u30eb\u3067\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\n\n\u25fe\ufe0e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3:\n\uff65\u6027\u5225\u25b6\ufe0e\u5c11\u5973(14\u6b73)\n\uff65\u76ee\u306e\u8272\u25b6\ufe0e\u85e4\u8272\n\uff65\u9aea\u578b\u25b6\ufe0e\u524d\u9aea\u306f\u59eb\u30ab\u30c3\u30c8\u3001\u5f8c\u308d\u9aea\u306f\u30ed\u30f3\u30b0\u3001\u30cf\u30fc\u30d5\u30c4\u30a4\u30f3\u3092\u9ed2\u3044\u30ea\u30dc\u30f3\u3067\u7e1b\u3063\u3066\u3044\u307e\u3059\n\u5f8c\u308d\u9aea\u306f\u753b\u50cf\u3067\u306f\u8170\u307e\u3067\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u304c\u9055\u548c\u611f\u304c\u306a\u3044\u7a0b\u5ea6\u306b\u4f38\u3070\u3057\u3066\u6b32\u3057\u3044\u306e\u3068\u3001\u6b8b\u5ff5\u306a\u304c\u3089\u8cc7\u6599\u306b\u4f7f\u3063\u3066\u3044\u308b\u30a2\u30d7\u30ea\u3067\u8a72\u5f53\u306e\u30ea\u30dc\u30f3\u30d1\u30fc\u30c4\u304c\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u306e\u3067\u30ea\u30dc\u30f3\u90e8\u5206\u3060\u3051\u306f\u65e7\u306e\u6fc3\u3044\u9aea\u8272\u306b\u306a\u3063\u3066\u307e\u3059\u3059\u307f\u307e\u305b\u3093\ud83d\ude2d\n\uff65\u9aea\u8272\u25b6\ufe0e\u85e4\u8272\n\uff65\u670d\u88c5\u25b6\ufe0e\u548c\u88c5(\u767d\u7121\u57a2\u3001\u632f\u8896\u3001\u5341\u4e8c\u5358\u306e\u8cc7\u6599\u3092\u6dfb\u4ed8\u3057\u307e\u3059)(\u3069\u308c\u3067\u3082\u5927\u4e08\u592b\u3067\u3059)\n\uff65\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u3001\u5c0f\u7269\u25b6\ufe0e\u30cf\u30fc\u30d5\u30c4\u30a4\u30f3\u3092\u7e1b\u308b\u9ed2\u30ea\u30dc\u30f3\n\uff65\u30e2\u30c1\u30fc\u30d5\u25b6\ufe0e\u85e4\u306e\u82b1\u3001\u6e80\u6708\n\uff65\u30ab\u30e9\u30fc\u25b6\ufe0e\u30e1\u30a4\u30f3\u30ab\u30e9\u30fc\u85e4\u8272\u3001\u30b5\u30d6\u30ab\u30e9\u30fc\u7d14\u767d\u3067\u30a4\u30e1\u30fc\u30b8\u3057\u3066\u3044\u307e\u3059\n\n\u25fe\ufe0e\u69cb\u56f3(\u30dd\u30fc\u30ba):\n\u25b6\ufe0e\u30dd\u30fc\u30ba\u306f\u304a\u4efb\u305b\u306a\u306e\u3067\u3059\u304c\u3001\u8eab\u5206\u304c\u9ad8\u3044\u8a2d\u5b9a\u306e\u30ad\u30e3\u30e9\u306a\u306e\u3067\u3042\u307e\u308a\u52d5\u304d\u306e\u306a\u3044\u30dd\u30fc\u30ba\u3067\u4ee5\u524d\u63cf\u3044\u3066\u3044\u305f\u3060\u3044\u305f\u5c11\u5e74\u3068\u30a2\u30af\u30b9\u30bf\u306b\u3057\u3066\u4e26\u3079\u305f\u3044\u3068\u8003\u3048\u3066\u308b\u306e\u3067\u540c\u3058\u304f\u3089\u3044(140cm)\u3060\u3068\u3042\u308a\u304c\u305f\u3044\u3067\u3059\n\n\u25fe\ufe0e\u8868\u60c5:\n\u25b6\ufe0e\u7f8e\u5c11\u5973\u3089\u3057\u3044\u5fae\u7b11\u307f\u9854\u3067\u6b6f\u3084\u53e3\u5185\u306f\u898b\u305b\u306a\u3044\u304b\u3093\u3058\u3067\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\n\n\u3010\u30ad\u30e3\u30e9\u8a2d\u5b9a\u3011\n\n\u59cb\u7956\u3068\u540c\u3058\u85e4\u8272\u306e\u9aea\u3001\u85e4\u8272\u306e\u773c\u3068\u4e88\u77e5\u80fd\u529b\u3092\u6301\u3063\u3066\u751f\u307e\u308c\u305f\u304c\u70ba\u306b\u5fb9\u5e95\u7684\u306b\u5b58\u5728\u3092\u79d8\u533f\u3055\u308c\u3066\u80b2\u3066\u3089\u308c\u305f\u5c11\u5973\u3067\u3059\u3002\n\u574a\u3061\u3083\u3093\u304c\u5973\u6027\u3068\u3057\u3066\u751f\u307e\u308c\u3066\u3044\u305f\u3089\u2026\u3068\u3044\u3046if\u306e\u5b50\u306a\u306e\u3067\u3053\u3061\u3089\u306f\u658e\u5bae\u3067\u3042\u308a\u658e\u738b\u3092\u517c\u4efb\u3057\u3066\u3044\u305f\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u304c\u4eca\u306f\u305d\u308c\u3092\u8d85\u3048\u3066\u796d\u795e\u3068\u3057\u3066\u306e\u6271\u3044\u3092\u53d7\u3051\u3066\u3044\u307e\u3059\u3002\n\u305d\u306e\u80fd\u529b\u6545\u306b\u6a29\u529b\u306f\u7236\u3067\u3042\u308b\u5e1d\u3092\u8d85\u3048\u3001\u5b22\u3061\u3083\u3093\u76f8\u624b\u306b\u306f\u8ab0\u3082\u9006\u3089\u3046\u3053\u3068\u304c\u3067\u304d\u306a\u3044