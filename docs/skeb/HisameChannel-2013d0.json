0&h=200&s=bbdcfb74b87d9deecf687fa13a0efa97, https://si.imgix.net/1175d49a/uploads/origins/3d7df040-a98d-42ff-81f8-382b910fcc19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99dd570edb991cd93d1e3b470c247391 2x, https://si.imgix.net/1175d49a/uploads/origins/3d7df040-a98d-42ff-81f8-382b910fcc19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de0a6f7007aad86db1124ddd36c4f3bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1175d49a/uploads/origins/3d7df040-a98d-42ff-81f8-382b910fcc19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec83c245fbb122bfcd4881d7747006f9", "srcset": "https://si.imgix.net/1175d49a/uploads/origins/3d7df040-a98d-42ff-81f8-382b910fcc19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec83c245fbb122bfcd4881d7747006f9, https://si.imgix.net/1175d49a/uploads/origins/3d7df040-a98d-42ff-81f8-382b910fcc19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b0ae1a6d9a63e13d1c7b57675c3576d 2x, https://si.imgix.net/1175d49a/uploads/origins/3d7df040-a98d-42ff-81f8-382b910fcc19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90c3799d259a60b388d972c4595c37d9 3x"}, "body": "龍ヶ花緋褪さん、はじめまして。アピールありがとうございます！\nなでしことみみを見てくださってありがとうございます。ハイフェッツをなぞる病、いいですよね……！\nイラストを拝見しまして、可愛らしい絵柄が彼女たちに似合いそうだと思ったので是非お願いしたいと思います！\n\nハイフェッツのエンドとしては、通過したのが結構前なのであまりちゃんと覚えてはおらず……ただ最後まで喧嘩してたのは記憶にあります。\n\nまた、2人はハイフェッツのあとに継続で「未完生」というシナリオに行っています。タイマンシナリオで、みみがKPCです。\n\n現在の2人の関係性は……そうですね、傍から見たらさほど変わっていないと思います。ただ本人たち、特になでしこの中では変化しつつあります。\n通過前は、なでしこはみみのことが正直苦手でした。年下にも関わらず、自分には無い才能を持っている。羨ましくて、悔しくて仕方がなかったです。だからステージ上と裏では大きく態度を変えていました。\nけれどハイフェッツ、そして未完生を通過後はもう色々と吹っ切れています。「君は完璧で究極のアイドル」\n「誰よりも強い君以外は認めない」\nなでしこのイメソンはYOASOBIのアイドルです。なでしこにとってみみは完璧なアイドルだし、みみがミスすることを許せない。そして、そんな完璧で究極のアイドルであるみみに勝ちたいと今でも思っています。ミスをしたみみに勝っても意味は無い。完璧な状態のみみに勝ってこそ意味がある。\n\nみみから見たなでしこは通過前も後も変わらないと思います。「なでしこちゃんはかっこいい！」です。\nみみは純粋無垢に、なでしこを褒めてくれます。だからこそ余計に、なでしこからしたらそれが眩しすぎるんです。\n\nこんな感じで大丈夫でしょうか？伝わりましたかね……。\nそれでは、うちの大切なアイドルたちをよろしくお願い致します！\n\nセンター(宇佐美みみ)\nhttps://iachara.com/view/5121477\n\nリーダー(大上なでしこ)\nhttps://iachara.com/view/5132941", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HisameChannel/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3166709, "client_id": 1937221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72fdde52/uploads/origins/2fb30926-4600-4fe6-b9ac-8ea5f7b6777e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=259d1e8786ea783770bba4a0ff9ea742", "srcset": "https://si.imgix.net/72fdde52/uploads/origins/2fb30926-4600-4fe6-b9ac-8ea5f7b6777e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=259d1e8786ea783770bba4a0ff9ea742, https://si.imgix.net/72fdde52/uploads/origins/2fb30926-4600-4fe6-b9ac-8ea5f7b6777e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ff5ef120546a9dca83a03af9c3f97f7 2x, https://si.imgix.net/72fdde52/uploads/origins/2fb30926-4600-4fe6-b9ac-8ea5f7b6777e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32e177e224d7571d965d664ae213c2ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72fdde52/uploads/origins/2fb30926-4600-4fe6-b9ac-8ea5f7b6777e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2baa6adfcd3f7a842973f7c5be80dff", "srcset": "https://si.imgix.net/72fdde52/uploads/origins/2fb30926-4600-4fe6-b9ac-8ea5f7b6777e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2baa6adfcd3f7a842973f7c5be80dff, https://si.imgix.net/72fdde52/uploads/origins/2fb30926-4600-4fe6-b9ac-8ea5f7b6777e?bg=%23fff&auto=format%2Ccompr