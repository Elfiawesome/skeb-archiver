nメイドものドラマの撮影\n\n・設定\n17歳の誕生日を迎えた菜々は母と同じメイドの道を志し、かつて母が勤めていた屋敷の門を叩く。菜々の教育係になったのは、奇しくも新人時代に菜々の母から指導を受けたメイド長の瞳子であった。\n\n・注文\nメイド服はクラシカルなロングスカートのエプロンドレス(ミリシタのオーディナリィ・クローバー衣装のような)で、二人の身長差(菜々：146cm　瞳子：169cm)を強調するような構図であれば嬉しいです。\n\nご多忙のところ恐れ入りますが、ご検討の程よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AkunoPomp/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 625067, "client_id": 261954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48b30349/uploads/origins/7060d1c6-7111-4532-8fcf-76baa3d6a043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b933978453217efb846c648ec66f57a", "srcset": "https://si.imgix.net/48b30349/uploads/origins/7060d1c6-7111-4532-8fcf-76baa3d6a043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b933978453217efb846c648ec66f57a, https://si.imgix.net/48b30349/uploads/origins/7060d1c6-7111-4532-8fcf-76baa3d6a043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c74589a56b19be80226d4a25ad36de01 2x, https://si.imgix.net/48b30349/uploads/origins/7060d1c6-7111-4532-8fcf-76baa3d6a043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20baac99899e208ee3e8efcfa13fda80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48b30349/uploads/origins/7060d1c6-7111-4532-8fcf-76baa3d6a043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d04697df2a142c2fba82a6af95956f85", "srcset": "https://si.imgix.net/48b30349/uploads/origins/7060d1c6-7111-4532-8fcf-76baa3d6a043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d04697df2a142c2fba82a6af95956f85, https://si.imgix.net/48b30349/uploads/origins/7060d1c6-7111-4532-8fcf-76baa3d6a043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c