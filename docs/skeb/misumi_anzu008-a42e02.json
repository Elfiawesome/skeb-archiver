す。\n\n衣装も、ベーシックなろこちゃの衣装から\n自由なデザインされたものまで、なんでも問題ありません。\n装飾類（アクセなど含む）も自由にしていただければと思います！\n(天真爛漫で少し生意気な子供、すぐに調子に乗る、根は真面目な性格です。)\n\n＊髪の毛の色は３色でユニコーンカラーです。\n\n【お願い】\n頭部や毛先が切れていないキャラクターのみの透過データと背景(もしくはPSD)をいただけますと、使用する際の自由度が高まり助かります…！\nまた、可能な範囲で表情差分も作っていただけますと色んなサムネイルで使用でき助かります…！(厳しければ大丈夫です！)\n\n参考資料\nhttps://drive.google.com/drive/folders/1oGoErux3NjG7LNOkjk8oxiPgKJrOlTRn?usp=sharing\n声・動きのサンプル\nhttps://twitter.com/moko108110/status/1665329666951970816?s=20\n\n何卒ご検討よろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1oGoErux3NjG7LNOkjk8oxiPgKJrOlTRn", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@misumi_anzu008/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2353311, "client_id": 1204692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c3961dd/uploads/origins/69ce13bc-2368-4c33-9186-afbfe859df54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2000fdfadc359e52f79931d3aa3c17f6", "srcset": "https://si.imgix.net/2c3961dd/uploads/origins/69ce13bc-2368-4c33-9186-afbfe859df54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2000fdfadc359e52f79931d3aa3c17f6, https://si.imgix.net/2c3961dd/uploads/origins/69ce13bc-2368-4c33-9186-afbfe859df54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ab839910d9f710c066e4058f64a4ec0 2x, https://si.imgix.net/2c3961dd/uploads/origins/69ce13bc-2368-4c33-9186-afbfe859df54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ba07adce33b1656cc2915736cbc1188 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c3961dd/uploads/origins/69ce13bc-2368-4c33-9186-afbfe859df54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73ae7b6005af2f68cc09e66e05015ea1", "srcset": "https://si.imgix.net/2c3961dd/uplo