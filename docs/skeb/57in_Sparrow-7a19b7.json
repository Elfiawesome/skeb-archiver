まったダージリン様のような感じ）そこへボンテージを来た愛里寿が自身にペニバン（双頭ディルド？）を装着しながらヤバそうな笑みを浮かべている。ルミさん焦るも時すでに遅し。激しく責められて堕ちる。\n2人そろって絶頂した後、ボールギャグを外されたルミさんは、これからも愛里寿さんに可愛がられたいと忠誠を誓うのだった。\n\n以上となります。\n細かな描写、容姿、セリフは八田ノ湯♨さんにお任せいたします。\n内容に対して金額面が見合わないようでしたら、遠慮なく上乗せを希望いただけたらと思います。\nご検討の程何卒よろしくお願い申し上げます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@57in_Sparrow/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2782623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1de58651/uploads/origins/45bd6f2f-04e6-4ac7-b673-671df173e69d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b8279897d3c1a698c524100ece552b5", "srcset": "https://si.imgix.net/1de58651/uploads/origins/45bd6f2f-04e6-4ac7-b673-671df173e69d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b8279897d3c1a698c524100ece552b5, https://si.imgix.net/1de58651/uploads/origins/45bd6f2f-04e6-4ac7-b673-671df173e69d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee8c5fd4a48af5fda2a0a408f7078914 2x, https://si.imgix.net/1de58651/uploads/origins/45bd6f2f-04e6-4ac7-b673-671df173e69d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adc1b50cd8f03b687e0990e5067c7491 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1de58651/uploads/origins/45bd6f2f-04e6-4ac7-b673-671df173e69d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17560cd488c464af6de400e4d68deaf", "srcset": "https://si.imgix.net/1de58651/uploads/origins/45bd6f2f-04e6-4ac7-b673-671df173e69d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17560cd488c464af6de400e4d68deaf, https://si.imgix.net/1de58651/uploads/origins/45bd6f2f-04e6-4ac7-b673-671df173e69d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&