ヤッてたので…結構慣れてて上手い…\n…朝にはすっかりレズセックスの虜になった千代美…\n---------\n千代美「ノンケ?いや男なんて要らんぞ、レズセだよレズセ!\n男は数回イったら終わりなんだろ?その点オンナ同士ならば、気が済むまでイケるんだぞ～!!\nその気になれば丸一日引き込みってセックスなんても～サイコォ～!! なんなら今度一緒にどうだ?!色々教えてあげるぞ!!」\nさおりん「いいよね～レズセ～💛一度アリサさんもヤってみなよ～絶対わかるって～気持ちイイヨォ～!!」\nアリサ「あんたら!!」\n\n…みたいな感じをこう、適度に端折りつつ前回同様まとめて頂けたらと!\n(長すぎですねすみません)", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@57in_Sparrow/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8c3e8197/uploads/origins/e7c2e1f1-89c9-44b6-b629-00d61ce6a547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cdcd20883f766b4b60d9e5512df897d", "srcset": "https://si.imgix.net/8c3e8197/uploads/origins/e7c2e1f1-89c9-44b6-b629-00d61ce6a547?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4cdcd20883f766b4b60d9e5512df897d, https://si.imgix.net/8c3e8197/uploads/origins/e7c2e1f1-89c9-44b6-b629-00d61ce6a547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c698102ef7f0a1b3706e2757f2f4f00 2x, https://si.imgix.net/8c3e8197/uploads/origins/e7c2e1f1-89c9-44b6-b629-00d61ce6a547?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c96d235ac71a2571ca879e061c2d01ed 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2782623, "client_id": 116395, "nc": 48}, {"path": "/@57in_Sparrow/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2782623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dc2e09d/uploads/origins/4b4f945e-c317-4