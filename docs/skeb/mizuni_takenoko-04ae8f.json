ins/2fce3a27-238b-4bc5-bb0c-b89dd5570003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f60010f2116aba708b6e842665e3640", "srcset": "https://si.imgix.net/ffb703af/uploads/origins/2fce3a27-238b-4bc5-bb0c-b89dd5570003?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f60010f2116aba708b6e842665e3640, https://si.imgix.net/ffb703af/uploads/origins/2fce3a27-238b-4bc5-bb0c-b89dd5570003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4543a5d10b64ee249bfa86fccfbba693 2x, https://si.imgix.net/ffb703af/uploads/origins/2fce3a27-238b-4bc5-bb0c-b89dd5570003?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c223b2b391525c694870a4c5f749c85 3x"}, "body": "Hello! Your illustrations are very beautiful! Would you like to draw Nazrin from Touhou Project? If so, please draw a pretty Nazrin however you wish! I’ll leave everything up to you. Thank you very much!\n\nこんにちは！ あなたのイラストはとても美しいです！ 東方Projectのナズーリンを描いてみませんか？ その場合は、お好きなように可愛いナズーリンを描いてください！ 全てお任せします。 ありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizuni_takenoko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3745024, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1603f7a9c363e190060c92ef57cca371", "srcset": "https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1603f7a9c363e190060c92ef57cca371, https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=071f15bca96c290e8a98d1c9cf7199a1 2x, https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79d461388f8ce552fe7332e8366cfb55 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe4486239b1821502c2c7dc6a32d5e5", "srcset": "https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe4486239b1821502c2c7dc6a32d5e5, https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9016a1bed0797cbd4672d05ea591848d 2x, https://si.imgix.net/5acf7ebd/uploads/origins/6fd42f4f-c9c8-49c8-b1fb-f5e87f757231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a27954deee5767dd6d75e11af52fc816 3x"}, "body": "たけのこの水煮さん初めまして、新着クリエイターにでお見かけさせて頂いて、素敵に綺麗に可愛いイラストで東方を扱っている方と存じましたので、是非ご依頼させて頂きましたら幸いです……！\n\nやや奇抜な内容で恐縮ですが、もしよろしければ東方projectの「河城にとり」に格闘ゲーム「ヴァンパイア」シリーズの「リリスの衣装をコスプレ」をさせたイラストをお願いできるでしょうか？\n個人的に直感的にハマってしまった謎の組み合わせなので、他人に説得力を持って説明できるものではないですが、「それでも私はこれが好き」という気持ちで、是非たけのこの水煮さんのお手前にて、可愛く綺麗さも秘めたイラストにて振るって頂けましたら嬉しく存じます……！\n\n一応コスプレがメインとなります、なるべくならで十分ですが、全身が拝める構図にて衣装姿を堪能させていてくだされば非常にありがたいです。\nただ一点、にとりちゃんのいつもの帽子はそのまま被って頂く方が個人的には好ましいので、そこだけ注文をつけさせて頂ければありがたく存じます……！\nその他の表情や構図・ポーズなどについては、たけのこの水煮さんのセンスをそのまま光らせて頂ける形でOKです！\n（しいて言えば恥じらい方向の方が好みですが、より良く仕上げられる構図が降りてくださったのならばそちらで問題ございません！）\n\n無茶な注文とは存じますが、何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/55194620", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizuni_takenoko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3745024, "client_id": 1066697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4b35abe911751b80aae905099712c7e", "srcset": "https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4b35abe911751b80aae905099712c7e, https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=706e519027e55c9f6dadaf8e1ba6d5cd 2x, https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edf659e67d1bff77c0993cf4fb433100 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d68d78f2847c571a97df2f202d40b29b", "srcset": "https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d68d78f2847c571a97df2f202d40b29b, https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=279abc6b6f7a682e674283af38f9ec3d 2x, https://si.imgix.net/d5a902e2/uploads/origins/563ab075-8765-4171-950d-951631b1ba39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c208a895270c5385b451af1b6255e6d9 3x"}, "body": "はじめまして、歪んだむと申します。\nX（旧Twitter）のメディア欄を拝見して可愛らしい絵柄のキャラクターたちが魅力的だったので、リクエストを送りました。\n\nうちの子の角狼「フォルン」をリクエストします。\nキャラデザは参考資料の通りです。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n\n正月のイメージで、おせち料理や雑煮などの正月っぽいものを食べて幸せそうな顔をしている様子、おせち料理の重箱を開けて中身を見て目を輝かせている様子、のどちらかでお願いします。\nおせちの場合、お肉が大好きな子なので、オードブルっぽい感じでもOKです。\nイメージ参考：https://youtu.be/qCNDOMeBgcw?t=89（動画1:28～）\n\n衣装は「和装（着物など）」で、一般的な着物やソシャゲのキャラのようなアレンジされたものまで、タイプやデザインはお任せします。　※キャラデザにある首輪や鎖や外れない設定ですが、衣装との兼ね合いで難しいようなら大半が見えない構図か省略するなどしてください。\n色や柄、装飾品や髪型のアレンジ（髪の長さ含む）などもお任せします。\n\nその他、ポーズや構図、背景などもお任せします。\n\n文字や背景、宛名・サインにつきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインonで投稿）\n\n\nご検討よろしくお願いします。 \n\n\nキャラデザや簡易な設定など\n髪や尻尾の一部に黒いメッシュが入る。\n獣人でなく、狼型のモンスターが封印され弱体化した状態の姿（封印の要となっている首輪や鎖は外れない）\n人の姿にまだ慣れておらず、\n・表情筋がぎこちないため一見すると無表情っぽく見える（無感情ではない）\n・二足歩行が苦手で時折転びそうになる。\nhttps://x.com/gn0083/status/1769019189459870106\n\n上記他、今までの同キャラの納品物なども参考にしていただければと思います。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizuni_takenoko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3745024, "client_id": 1789994, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adb693a7/uploads/origins/2266db26-37ea-4ae3-819c-8b8b5ad81cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2379dca7c375d79653a7e4f4884ef155", "srcset": "https://si.imgix.net/adb693a7/uploads/origins/2266db26-37ea-4ae3-819c-8b8b5ad81cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2379dca7c375d79653a7e4f4884ef155, https://si.imgix.net/adb693a7/uploads/origins/2266db26-37ea-4ae3-819c-8b8b5ad81cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9d3896dd4fae3da5e40d3a90846b8cc 2x, https://si.imgix.net/adb693a7/uploads/origins/2266db26-37ea-4ae3-819c-8b8b5ad81cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52556fce1be68c6ea87cc89349c0bd7a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adb693a7/uploads/origins/2266db26-37ea-4ae3-819c-8b8b5ad81cc