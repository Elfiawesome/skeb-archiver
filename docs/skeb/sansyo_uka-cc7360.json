\n法華津さんに対して分からせレイプ\n体位はお任せしますが、\n可能であれば2人の顔が見えると嬉しいです。\n\n法華津さん→\nロープまたは結束バンドなど、何らかの方法で拘束されており抵抗できない状況。\n髪や服が乱れていたり口の端に血が付着しているなど、暴力の痕跡あり。\n表情はレイプ目でされるがままか\n反抗的な表情かでかなり迷っているのでお任せします…！！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansyo_uka/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 297857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2dbb523c/uploads/origins/6cce8bf2-c69e-4470-91b4-db430e9c50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d7596813066219fa3a7d83b3163a93f", "srcset": "https://si.imgix.net/2dbb523c/uploads/origins/6cce8bf2-c69e-4470-91b4-db430e9c50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d7596813066219fa3a7d83b3163a93f, https://si.imgix.net/2dbb523c/uploads/origins/6cce8bf2-c69e-4470-91b4-db430e9c50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ac8f917763153c937d038cc6fc3b8ae 2x, https://si.imgix.net/2dbb523c/uploads/origins/6cce8bf2-c69e-4470-91b4-db430e9c50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81ea1126c9eee0ca5f87c9ad2a8e9e72 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2dbb523c/uploads/origins/6cce8bf2-c69e-4470-91b4-db430e9c50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5605665157cd9686973393b0da8b1140", "srcset": "https://si.imgix.net/2dbb523c/uploads/origins/6cce8bf2-c69e-4470-91b4-db430e9c50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5605665157cd9686973393b0da8b1140, https://si.imgix.net/2dbb523c/uploads/origins/6cce8bf2-c69e-4470-91b4-db430e9c50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37612398dd2e08c43164a1ac88e47497 2x, https://si.imgix.net/2d