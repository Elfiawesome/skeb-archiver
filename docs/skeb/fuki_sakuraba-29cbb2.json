u3059\u3002\n\n1.\u516b\u4e5d\u5bfa\u771f\u5bb5(\u5e7d\u970a)\u304c\u88f8\u4f53\u306e\u30e2\u30d6\u304a\u5144\u3055\u3093(\u9ad8\u6821\u751f\u306e\u5e7d\u4f53)\u306b\u4fb5\u5165\u3055\u308c\u3066\u4f53\u306e\u4e3b\u5c0e\u6a29\u3092\u4e57\u3063\u53d6\u3089\u308c\u308b\u3002\n\n2.\u982d\u3060\u3051\u516b\u4e5d\u5bfa\u771f\u5bb5\u306e\u4e3b\u5c0e\u6a29\u3067\u670d\u306e\u4e0a\u304b\u3089\u3064\u308b\u307a\u305f\u80f8\u3082\u307f\u80a1\u9593\u3055\u308f\u308a\u30d3\u30af\u30d3\u30af\u7247\u76ee\u3064\u3076\u308a\u3001\u30a4\u304b\u3055\u308c\u308b\u3002\n\n3.\u30c8\u30ed\u9854\u3067\u306a\u3093\u304b\u3080\u305a\u3080\u305a\u3059\u308b\uff1f\u4f53\u304c\u5f35\u308a\u88c2\u3051\u308b\uff01\u5e7c\u5973\u306e\u5e7d\u4f53\u306f\u30e2\u30d6\u304a\u5144\u3055\u3093\u306e\u4f53\u683c\u306b\u8010\u3048\u3089\u308c\u306a\u304b\u3063\u305f\u3002\n\n4.\u305d\u3057\u3066\u670d\u3054\u3068\u307e\u3070\u3089\u306b\u6df7\u3058\u3063\u3066\u3042\u3079\u3053\u3079\u306b\u878d\u5408\u3057\u3066\u3057\u307e\u3046(\u7247\u76ee\u3001\u80f4\u4f53\u306e\u4e00\u90e8\u3001\u7247\u8155\u3001\u7247\u8db3\u304c\u30e2\u30d6\u304a\u5144\u3055\u3093\u3067\u305d\u308c\u4ee5\u5916\u304c\u516b\u4e5d\u5bfa\u771f\u5bb5\u3002\u820c\u306f\u516b\u4e5d\u5bfa\u771f\u5bb5\u3068\u30e2\u30d6\u304a\u5144\u3055\u3093\u306e\u4e8c\u679a\u304c\u91cd\u306a\u308b\u3002\u80a1\u9593\u306f\u3061\u3093\u3053\u304c\u307e\u3093\u3053\u306b\u30bb\u30eb\u30d5\u633f\u5165\u306b\u3082\u898b\u3048\u308b\u3002\u305f\u3060\u3057\u3001\u9aea\u3060\u3051\u306f\u516b\u4e5d\u5bfa\u306e\u307e\u307e\u3067)\u3057\u3083\u3079\u308a\u3082\u3042\u3079\u3053\u3079\u306b(\u8a9e\u5c3e\u3068\u304b\u4e00\u4eba\u79f0\u3068\u304b\u6df7\u3056\u3063\u3066\u3044\u308b(\u306a\u3093\u3067\u4ffa\u306e\u30ed\u30ea\u307e\u3093\u3053\u306b\u79c1\u306e\u3061\u3093\u3053\u304c\u5165\u3063\u3066\u308b\u3093\u3067\u3059\u304b\uff01\uff1f\u3044\u3084\u3001\u4ffa\u306f\u5c0f\u5b66\u4e94\u5e74\u751f\u306e\u516b\u4e5d\u5bfa\u771f\u5bb5\u3060\u3088\u306a\uff1f))\u7d75\u306e\u7aef\u3063\u3053\u306b\u300c\u3053\u306e\u5f8c\u3001\u963f\u826f\u3005\u6728\u66a6\u306b\u52a9\u3051\u3089\u308c\u305f\u300d\n\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u7d39\u4ecb\n\u30fb\u516b\u4e5d\u5bfa\u771f\u5bb5\uff1a\u5c0f\u5b66\u4e94\u5e74\u751f\u306e\u30c4\u30a4\u30f3\u30c6\u30fc\u30eb\u306e\u30ed\u30ea\u5e7d\u970a\u3002\u670d\u306f\u7d3a\u8272\u306e\u540a\u308a\u30b9\u30ab\u30fc\u30c8\u3002\u9053\u7aef\u3092\u3088\u304f\u6563\u6b69\u3057\u3066\u3044\u308b\u3002\u4e00\u4eba\u79f0\u306f\u79c1\u3002\u4e01\u5be7\u8a9e\u3092\u4f7f\u3046\u3002(\u7269\u8a9e\u30b7\u30ea\u30fc\u30ba\u306e\u30ad\u30e3\u30e9\u3002)\n\u30fb\u30e2\u30d6\u304a\u5144\u3055\u3093\uff1a\u7537\u5b50\u9ad8\u6821\u751f\u3067\u602a\u7570\u306e\u529b\u3067\u5e7d\u4f53\u96e2\u8131\u306b\u6210\u529f\u3057\u305f\u30d5\u30c4\u30e1\u30f3(\u8336\u9aea\u30b7\u30e7\u30fc\u30c8\u30d8\u30a2\u306e\u7537\u6027)\u3002\u30ed\u30ea\u5e7d\u970a\u3092\u898b\u3064\u3051\u3066\u4e57\u3063\u53d6\u308d\u3046\u3068\u8a66\u307f\u308b\u3002\u4e00\u4eba\u79f0\u306f\u4ffa\u3002(\u3082\u3061\u308d\u3093\u539f\u4f5c\u4e0d\u5728\u3002)\n\u30fb\u963f\u826f\u3005\u6728\u66a6\uff1a\u5438\u8840\u9b3c\u306e\u7537\u5b50\u9ad8\u6821\u751f\u3002\u516b\u4e5d\u5bfa\u771f\u5bb5\u3092\u4e00\u5ea6\u3001\u6551\u3063\u305f\u3053\u3068\u3042\u308b\u3002(\u7d75\u3068\u3057\u3066\u306e\u51fa\u756a\u306f\u306a\u304f\u3001\u540d\u524d\u306e\u307f\u306e\u51fa\u6f14\u3002\u7269\u8a9e\u30b7\u30ea\u30fc\u30ba\u306e\u30ad\u30e3\u30e9\u3002)\n\n\u771f\u3063\u663c\u9593\u4eba\u901a\u308a\u306e\u306a\u3044\u9053\u3067\u306e\u51fa\u6765\u4e8b\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\nhttps://www.monogatari-series.com/nisemonogatari/chara/index.html#4", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Momono_Aito/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2168952, "client_id": 2569248, "vtt_url": null, "thumbnail_ima