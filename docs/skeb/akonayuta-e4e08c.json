{"screen_name": "akonayuta", "first_seen": 1774576537.386974, "last_updated": 1774701828.389249, "profile": {"id": 17837, "acceptable": true, "creator": true, "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:y5zjrdux4dpf7v3e3l4j6nb5/bafkreidq775iv7ouphdcph625pfo5foxndysynseop4wlodx5uimwi7asy", "name": "鰹節", "nsfw_acceptable": false, "screen_name": "akonayuta", "language": "ja", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:y5zjrdux4dpf7v3e3l4j6nb5/bafkreiedow3etgpomggb3m5z2pef6naxu37avfpbtznioenmxfmdwwdnae", "body_size": 10000, "received_works_count": 6, "received_nsfw_works_count": 0, "sent_requests_average_cancel_time": null, "appeal_receivable": false, "request_master_rank": null, "first_requester_rank": null, "sent_first_works_count": 0, "sent_public_works_count": 1, "popular_creator_rank": null, "instruction": "unspecified", "asct": null, "description": "🇯🇵一次創作民✨フォロバは基本一次創作メインの方のみ⚠️フォローフォロワー数に極端な差がある方はフォロバしない事があります\n\n一次創作民と交流して切磋琢磨したい！1/12のドール服👔作ったり狩猟関係呟いたり\n\n名前は良く変わりますがアイコンは変えません、呼び方に困ったら🐟と呼んで下さい\n\nXfolio→https://xfolio.jp/portfolio/akonayuta\n\n⚠️無断転載・無…", "nijie_id": null, "dlsite_id": null, "fanza_id": null, "pixiv_id": 305384, "booth_id": null, "fantia_id": null, "fanbox_id": null, "skima_id": null, "coconala_id": null, "patreon_id": null, "busy": false, "url": "https://xfolio.jp/portfolio/akonayuta", "wishlist_id": "1QBVN9FH0YRAE", "youtube_id": null, "show_social_profile": true, "accept_expiration_days": 30, "complete_expiration_days": 60, "received_requests_average_response_time": 18234, "completing_average_time": 143079, "nc": 0, "twitter_uid": null, "user_service_links": [{"provider": "bluesky", "screen_name": "akonayuta.bsky.social", "url": "https://bsky.app/profile/akonayuta.bsky.social"}], "banned": false, "banned_by": "", "complete_rate": 1.0, "og_image_url": "https://skeb-avatar.imgix.net/https%3A%2F%2Fskeb.jp%2Fapi%2Fusers%2Fakonayuta%2Fbackground%3Fd%3Defd609?blend64=aHR0cHM6Ly9hc3NldHMuaW1naXgubmV0L350ZXh0P3R4dDY0