ll, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/490e5e62/uploads/origins/1e2f49ce-91fd-463f-ac88-811c5a0bbaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45e491a22c573cc3f52f016eee28a9f8", "srcset": "https://si.imgix.net/490e5e62/uploads/origins/1e2f49ce-91fd-463f-ac88-811c5a0bbaad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45e491a22c573cc3f52f016eee28a9f8, https://si.imgix.net/490e5e62/uploads/origins/1e2f49ce-91fd-463f-ac88-811c5a0bbaad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=050d83c4cdef51a25c146a8e57898f64 2x, https://si.imgix.net/490e5e62/uploads/origins/1e2f49ce-91fd-463f-ac88-811c5a0bbaad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98bb5afc0ef257c8ae71398faca69561 3x"}, "body": "こんにちは、カレー大好き剣次郎、こと、夢骨堂です。\nこの度はmixi2のアイコンのイラストを依頼したく、ご連絡させていただいております。\nイラストの内容はうちの夢骨堂番頭。見た目年齢がスイングするキャラですが、お魚さんの描きやすい年齢で描いていただいて結構です。お任せです。（デフォルメ絵も可）\nアイコン使用目的なので画角は正方形に近いもの、丸型に切り抜いても支障のない構図だと有り難いです。\n急ぎではありませんので、お手すきの時に作業してやってください。\nそれではよろしくです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akonayuta/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17837, "client_id": 3358277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53c37bd3/uploads/origins/bd2d0014-84fd-43e6-aa22-3cacb8d1b4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16afbf89e03ce129472761fbcb6dacf5", "srcset": "https://si.imgix.net/53c37bd3/uploads/origins/bd2d0014-84fd-43e6-aa22-3cacb8d1b4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16afbf89e03ce129472761fbcb6dacf5, https://si.imgix.net/53c37bd3/uploads/origins/bd2d0014-84fd-43e6-aa22-3cacb8d1b4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr