306a\u602a\u7269\u300f\u3063\u3066\u601d\u3063\u3066\u308c\u3070\n\u6b63\u89e3\u304b\u3082(\u7b11)\u3056\u3063\u304f\u308a\n\n\n\u25c6\u7570\u5f62\u306e\u898b\u305f\u76ee\u3001\u7279\u5fb4\n\u203b\u3053\u3053\u304b\u3089\u306f\u304f\u308d\u307d\u3093\u8003\u5bdf\n\u30fb\u9023\u306a\u3063\u305f\u8d64\u3044\u76ee\n\u30fb\u5927\u304d\u304f\u88c2\u3051\u305f\u53e3\n\u30fb\u9b3c\u3001\u5316\u3051\u7269\u3068\u5f62\u5bb9\u3055\u308c\u308b\n\u30fb\u919c\u3044\u304a\u305e\u307e\u3057\u3044\u59ff\n\u30fb\u5927\u304d\u306a\u53e3\u304b\u3089\u306f\u553e\u6db2\u304c\u6ef4\u308b\n\u30fb\u9854\u306e\u534a\u5206\u4ee5\u4e0a\u304c\u53e3\n\u30fb\u4eba\u9593\u3092\u990c\u3068\u3059\u308b(\u4e38\u5451\u307f\u3067\u306f\u306a\u304f\u98df\u3044\u6563\u3089\u304b\u3059\u3088\u3046\u306b\u8fba\u308a\u3092\u6c5a\u3057\u3066)\n\u30fb\u6d44\u5316\u3055\u308c\u6b7b\u306c\u3068\u7070\u306b\u306a\u308b\n\u30fb\u95c7\u304b\u3089\u7a7a\u9593\u3092\u6b6a\u307e\u305b\u73fe\u308c\u308b\n\u30fb\u5f37\u3044\u8005\u306f\u5358\u4f53\u3001\u5f31\u3044\u8005\u306f\u7fa4\u308c\u3092\u6210\u3057\u3066\u73fe\u308c\u308b\n\u30fb\u77e5\u80fd\u306e\u512a\u52a3\u3082\u3042\u308a\u7fa4\u308c\u3092\u7387\u3044\u308b\u30de\u30b9\u30bf\u30fc\u30af\u30e9\u30b9\u3068\u547c\u3070\u308c\u308b\u7279\u6b8a\u306a\u7570\u5f62\u3082\u5c45\u308b\n(\u8eab\u4f53\u304c\u5927\u304d\u304b\u3063\u305f\u308a\u77e5\u80fd\u304c\u305a\u3070\u629c\u3051\u3066\u9ad8\u304b\u3063\u305f\u308a\u7279\u6b8a\u306a\u8eab\u4f53(\u53cc\u982d\u3001\u8155\u304c\u5e7e\u672c\u3082\u3042\u308b\u3001\u89d2\u3084\u5c3e\u3084\u7ffc\u624b\u304c\u3042\u308b\u5834\u5408\u3082\u3042\u308b))\n\u30fb\u53d6\u308a\u8fbc\u3093\u3060\u4eba\u9593\u306e\u9b42\u3092\u81ea\u8eab\u306e\u5206\u8eab\u4f53(\u8907\u6570)\u3068\u3057\u3066\u5410\u304d\u51fa\u3059(\u767d\u3044\u7159\u306e\u3088\u3046\u306a\u5e7d\u970a\u306e\u3088\u3046\u306a\u534a\u900f\u660e\u3067\u5f37\u3044\u8ca0\u306e\u5ff5\u3092\u7e8f\u3063\u3066\u3044\u308b)\n\u30fb\u5206\u8eab\u4f53\u306b\u5b9f\u4f53\u306f\u7121\u3044\u304c\u5f37\u3044\u8ca0\u306e\u30a8\u30cd\u30eb\u30ae\u30fc\u306e\u51dd\u56fa\u4f53\u3067\u3001\u6c17\u3084\u3059\u304f\u89e6\u308c\u308b\u306a\u3069\u3059\u308c\u3070\u53ea\u3067\u306f\u6e08\u307e\u306a\u3044\n\n\n\u25c6\u9663\u5185 \u512a\u4eba (\u30b8\u30f3\u30ca\u30a4 \u30e6\u30a6\u30c8)\n\u5e74\u9f62(\u898b\u305f\u76ee)\uff1a\u9ad8\u6821\u751f\n\u8eab\u9577\u4f53\u91cd\u4f53\u683c\uff1a165cm\u3000\u5c0f\u67c4\u3001\u75e9\u305b\u578b\u3001\u83ef\u5962\u3002\u30a4\u30e1\u30fc\u30b8\u306f\u82e5\u3044\u9ed2\u732b\u3002\n\u9aea\u578b\u9aea\u8272\uff1a\u7de9\u304f\u7656\u306e\u3042\u308b\u9aea\u3067\u3001\u77ed\u9aea\u3067\u306f\u306a\u3044\u304c\u77ed\u3081\u3002\u895f\u8db3\u306e\u77ed\u3044\u30b7\u30e7\u30fc\u30c8\u3002\u6bdb\u91cf\u304c\u591a\u3081\u3067\u5f8c\u982d\u90e8\u306a\u3069\u3075\u3093\u308f\u308a\u30e2\u30b5\u30e2\u30b5\u3057\u3066\u3044\u308b\u3002\u8272\u306f\u512a\u4eba\u306e\u30a4\u30e1\u30fc\u30b8\u30ab\u30e9\u30fc(\u77b3\u306e\u8272)\u304c\u7d2b\u306a\u306e\u3067\u3001\u7d2b\u3092\u3046\u3063\u3059\u3089\u5e2f\u3073\u305f\u9ed2\u3002\n\u77b3\u306e\u5f62\uff1a\u5927\u304d\u3081\u306e\u30a2\u30fc\u30e2\u30f3\u30c9\u30a2\u30a4\u3002\u732b\u76ee\u3002\u776b\u6bdb\u306f\u3070\u3055\u3070\u3055\u3067\u3053\u305d\u306a\u3044\u304c\u3001\u5c11\u5e74\u3088\u308a\u306f\u5c11\u5973\u3088\u308a\u3002\u30e1\u30a4\u30af\u3092\u3057\u3066\u306a\u3044\u6642\u306e\u5973\u6027\u304f\u3089\u3044\u3002\n\u77b3\u306e\u8272\uff1a\u672c\u6765\u306f\u7d2b\u3001\u8304\u5b50\u7d3a\u8272\u3002\u6226\u95d8\u6642\u306b\u81ea\u8eab\u3078\u5f0f\u795e(\u4f7f\u3044\u9b54)\u3092\u6191\u4f9d\u3055\u305b\u308b\u3068\u305d\u306e\u5f0f\u795e\u306e\u77b3\u306e\u8272\u306b\u306a\u308b\u8a2d\u5b9a\u304c\u3042\u308a\u3001\u4eca\u56de\u306f\u6df1\u3044\u7dba\u9e97\u306a\u9752\u8272\u3002\u30d9\u30fc\u30b9\u304c\u7d2b\u3067\u305d\u3053\u306b\u9752\u8272\u304c\u706f\u308b\u3001\u5bbf\u308b\u30a4\u30e1\u30fc\u30b8\u3002\u77b3\u5b54\u3082\u9b54\u7269\u306e\u5f62(\u732b\u306e\u3088\u3046\u306a\u92ed\u3044\u7e26\u9577\u3001\u77b3\u5b54\u304c\u7d5e\u3089\u308c\u3066\u3044\u308b\u30a4\u30e1\u30fc\u30b8)\u3002\n\u7709\uff1a\u666e\u6bb5\u306f\u524d\u9aea\u306b\u96a0\u308c\u3066\u5168\u304f\u898b\u3048\u306a\u3044(\u3042\u3048\u3066\u63cf\u304b\u306a\u3044)\u3001\u8868\u60c5\u304c\u4e4f\u3057\u304f\u898b\u3048\u308b\u30a4\u30e1\u30fc\u30b8\u3002\u6012\u308a\u3084\u60b2\u3057\u307f\u306a\u3069\u3092\u8868\u73fe\u3059\u308b\u6642\u306e\u307f\u3001\u30c7\u30d5\u30a9\u30eb\u30e1\u3055\u308c\u305f\u77ed\u3044\u7c21\u5358\u306a\u7dda\u306b\u3088\u308a\u8868\u60c5\u3092\u51fa\u3059\u70ba\u63cf\u304f\u4e8b\u3082\u3042\u308b\u3002\n\u9854\u3064\u304d\u4f53\u3064\u304d\uff1a\u4e2d\u6027\u7684\u3002\u5973\u6027\u3068\u5c11\u5e74\u306e\u9593\u3092\u30a4\u30e1\u30fc\u30b8\u3002\u83ef\u5962\u3067\u3057\u306a\u3084\u304b\u3001\u3057\u304b\u3057\u7dba\u9e97\u306b\u9069\u5ea6\u306a\u7b4b\u8089\u304c\u3064\u3044\u3066\u3044\u308b\u3002\u3084\u306f\u308a\u3001\u82e5\u3044\u9ed2\u732b\u306e\u30a4\u30e1\u30fc\u30b8\u3002\n\u670d\u306b\u95a2\u3057\u3066\uff1a\u30a4\u30e1\u30fc\u30b8\u30ab\u30e9\u30fc\u7dd1\u306e\u8ecd\u670d\u3063\u307d\u3044\u5236\u670d\u3002\n(\u512a\u4eba\u306e\u9ad8\u6821\u306e\u5236\u670d\u3082\u7dd1\u306e\u30cd\u30af\u30bf\u30a4\u306a\u3069\u7dd1\u8272\u304c\u30c6\u30fc\u30de\u30ab\u30e9\u30fc\u3060\u304c\u3001\u79c1\u304c\u63cf\u304f\u6642\u306b\u5b66\u6821\u306e\u5236\u670d\u3068\u9000\u9b54\u5e2b\u306e\u7d44\u7e54\u306e\u5236\u670d\u3092\u3054\u3061\u3083\u3054\u3061\u3083\u306b\u3057\u3066\u6c7a\u307e\u3063\u3066\u3044\u306a\u304b\u3063\u305f\u70ba\u3082\u3042\u308b\u70ba\u3001\u3053\u3061\u3089\u3082\ud83d\udc1f\u3055\u3093\u306e\u30bb\u30f3\u30b9\u3067\u30c7\u30b6\u30a4\u30f3\u3057\u3066\u8cb0\u3044\u305f\u3044\u3067\u3059\uff01)\n\u8adc\u5831\u90e8(\u4e8b\u52d9\u4ed5\u4e8b)\u304b\u3089\u6226\u95d8\u6642\u306e\u6226\u95d8\u670d\u3082\u3053\u306a\u305b\u308b\u3088\u3046\u306a\u3001\u8ecd\u670d\uff1f\u306a\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u304c\u6b63\u5f0f\u306b\u306f\u4f55\u3082\u6c7a\u307e\u3063\u3066\u306f\u304a\u3089\u305a\u4eca\u307e\u3067\u3082\u3042\u3084\u3075\u3084\u3067\u3084\u3063\u3066\u304a\u308a\u307e\u3057\u305f\u3002\n\u512a\u4eba\u306f\u6226\u95d8\u54e1\u3067\u3042\u308a\u3001\u6d44\u5316\u5e2b(\u9000\u9b54\u5e2b)\u306e\u7d44\u7e54\u306e\u4e2d\u3067\u3082\u4e0b\u3063\u7aef\u306e\u90e8\u985e\u306a\u306e\u3067\u5272\u3068\u8efd\u88c5\u3001\u98fe\u308a\u306a\u3069\u7121\u304f\u52d5\u304d\u3084\u3059\u3055\u91cd\u8996\u3002\u9732\u51fa\u5ea6\u306f\u512a\u4eba\u306f\u5143\u3005\u304c\u4f4e\u3081\u3067\u30cd\u30af\u30bf\u30a4\u306a\u3069\u304b\u3063\u3061\u308a\u30bf\u30a4\u30d7\u3067\u3059\u304c\u3001\u6226\u95d8\u6642\u306f\u591a\u5c11\u52d5\u304d\u3084\u3059\u3044\u3088\u3046\u30eb\u30fc\u30ba(\u3060\u3089\u3057\u306a\u304f\u306a\u3044\u7a0b\u5ea6)\u306a\u9732\u51fa\u3001\u8584\u7740\u306f\u30aa\u30fc\u30b1\u30fc\u3067\u3059\uff01\n\u8155\u7ae0\uff1a\u5de6\u4e8c\u306e\u8155\u306b\u8d64\u3044\u6587\u5b57\u306a\u3057\u306e\u8155\u7ae0\u3092\u3057\u3066\u304a\u308a\u3001\u5b89\u5168\u30d4\u30f3\u304c\u4e00\u3064\u9732\u51fa\u3057\u3066\u3064\u3044\u3066\u3044\u308b\u3002\u3053\u308c\u306f\u9b3c\u72e9\u308a\u306b\u3066\u56ee\u5f79\u3068\u3057\u3066\u547d\u3092\u5f35\u308b\u8005\u306e\u8a3c\u306a\u306e\u3067(\u4eca\u307e\u3067\u79c1\u306f\u30e9\u30d5\u306b\u63cf\u3044\u3066\u304d\u307e\u3057\u305f\u304c)\u5e7e\u3089\u304b\u91d1\u8272\u306e\u7cf8\u3067\u523a\u7e4d(\u7e01\u53d6\u308a\u7a0b\u5ea6\u306e\u30b7\u30f3\u30d7\u30eb\u306a\u3082\u306e)\u306a\u3069\u304c\u3042\u3063\u3066\u3082\u3088\u3044\u304b\u3082\u77e5\u308c\u306a\u3044\u3067\u3059\u3002\n\u30a4\u30f3\u30ca\u30fc\u3092\u7740\u305b\u308b\u306a\u3089\u3001\u30b7\u30f3\u30d7\u30eb\u306b\u767d\uff39\u30b7\u30e3\u30c4\u304b\u52d5\u304d\u3084\u3059\u3055\u91cd\u8996\u306a\u3089\u9ed2\u306e\u30cf\u30a4\u30cd\u30c3\u30af\u304b\u3057\u3089\u3002\n\n\u512a\u4eba\u306e\u80fd\u529b\uff1a\u970a\u529b\u3092\u51dd\u7e2e\u3055\u305b\u5177\u73fe\u5316\u3055\u305b\u305f\u9396\u3067\u306e\u675f\u7e1b\u8853(\u91d1\u7e1b\u308a)\u3001\u540c\u3058\u304f\u305d\u306e\u9396\u306b\u3088\u308a\u76f8\u624b\u3092\u8cab\u3044\u305f\u308a\u3001\u9632\u5fa1\u58c1\u3078\u5229\u7528\u3057\u305f\u308a\u3002\u9396\u306f\u4e00\u672c\u4e00\u672c\u306e\u592a\u3055\u306f\u30ce\u30fc\u30de\u30eb\u3067\u3001\u66f4\u306b\u970a\u529b\u3092\u30d7\u30e9\u30b9\u3057\u3066\u3044\u304f\u3068\u672c\u6570\u304c\u5897\u3048\u675f\u3084\u5927\u675f\u3001\u6ce2\u3001\u5927\u6d2a\u6c34\u3068\u306a\u3063\u3066\u3044\u304f\u30a4\u30e1\u30fc\u30b8\u3002\u6bd4\u8f03\u7684\u4e00\u672c\u4e00\u672c\u306f\u5f31\u304f\u3066\u3082\u7815\u3051\u3064\u3064\u3001\u78c1\u77f3\u306b\u5f15\u3063\u5f35\u3089\u308c\u305f\u30c1\u30a7\u30fc\u30f3\u306e\u5982\u304f\u76f8\u624b(\u6575)\u306e\u4f53\u3078\u5dfb\u304d\u4ed8\u304d\u5f35\u308a\u4ed8\u304d\u52d5\u304d\u3092\u62d8\u675f\u3055\u305b\u308b\u3002\u66f4\u306b\u512a\u4eba\u306e\u970a\u529b\u306b\u306f\u6d44\u5316(\u7834\u9b54)\u306e\u529b\u304c\u6839\u5e95\u306b\u3042\u308b\u306e\u3067\u62d8\u675f\u3055\u308c\u305f\u3060\u3051\u3067\u3082\u76f8\u624b\u304c\u9b54\u3067\u3042\u308b\u4ee5\u4e0a\u306f\u3086\u3063\u304f\u308a\u3086\u3063\u304f\u308a\u3068\u529b\u3092\u524a\u3044\u3067\u3044\u304f\u30a4\u30e1\u30fc\u30b8\u3002\n\u7d50\u754c(\u9632\u5fa1\u58c1)\u3068\u3057\u3066\u5149\u306e\u76fe\u3092\u4f7f\u7528\u3059\u308b\u4e8b\u304c\u3042\u308b\u304c\u3001\u3044\u305a\u308c\u3082\u5186\u3001\u7403\u4f53\u72b6\u304c\u30d9\u30fc\u30b9\u3002\u7403\u4f53\u306e\u5f62\u6210\u304c\u9593\u306b\u5408\u308f\u306a\u304f\u30b3\u30f3\u30bf\u30af\u30c8\u30ec\u30f3\u30ba\u306e\u3088\u3046\u306a\u9014\u4e2d\u5f62\u614b\u3092\u53d6\u308b\u4e8b\u3082\u3057\u3070\u3057\u3070\u3042\u308b\u3002\u5149\u306e\u8272\u306f\u91d1\u8272\uff5e\u767d\u8272\u306a\u30a4\u30e1\u30fc\u30b8\u3067\u795e\u8056\u306a\u3082\u306e\u3001\u967d(\u6b63)\u306e\u529b\u3001\u6d44\u5316\u3001\u7834\u9b54\u2026\u3068\u304b\u305d\u3046\u3044\u3063\u305f\u529b(\