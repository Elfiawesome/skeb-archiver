ゴンの王子です。\n\n好きなように描いてください。クールでハンサムな感じでいいですか？\n\n私が用意したパンツを履いていてもいい。自由に調整したり、色を変えたりしてください。\n\n左手首のタトゥーがあれば入れてもらえますか？見えなければ入れる必要はない。\nこれはタトゥーとして彼と結ばれた精霊の絹の蛾で、彼の龍の気を食べ、お返しに致命的な絹の糸を織る。霊的に姿を現し、飛び回ることができる。\n\n個人的な使用のための印刷の許可もいただきたい。\n\n彼のデザインはBlackbunii on X。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1lS_25YW8RNC4Vno_LiWkrm4lr0T9J_91?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@A_ohkami/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3750723, "client_id": 2388421, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfc8e13f/uploads/origins/1b851fbe-1ace-4ae1-891c-c132142d1665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=273628dfebab171618abcb9dfe897d5b", "srcset": "https://si.imgix.net/dfc8e13f/uploads/origins/1b851fbe-1ace-4ae1-891c-c132142d1665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=273628dfebab171618abcb9dfe897d5b, https://si.imgix.net/dfc8e13f/uploads/origins/1b851fbe-1ace-4ae1-891c-c132142d1665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfd49b3626d651c01e878ab042dbdf92 2x, https://si.imgix.net/dfc8e13f/uploads/origins/1b851fbe-1ace-4ae1-891c-c132142d1665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a6fbe7001840a1a63c1cef0836ffaf4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfc8e13f/uploads/origins/1b851fbe-1ace-4ae1-891c-c132142d1665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed3ddfcee1593125fa7c2866b79086c9", "srcset": "https://si.imgix.net/dfc8e13f/uploads/origins/1b851fbe-1ace-4ae1-891c-c132142d1665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed3ddfcee1593125fa7c2866b79086c9, https://si.imgix.net/dfc8e13f/uploads/