c\u3082\u5927\u597d\u304d\u3067\u3059\u3001\u30aa\u30b7\u30e3\u2026\u2026\u914d\u7f6e\u304c\u672c\u5f53\u306b\u306a\u3093\u304b\u3001\u5fc3\u5730\u3088\u3059\u304e\u308b\u3001\u4e0a\u624b\u3059\u304e\u308b\u3002\n\u2192\u7d50\u69cb \u8efd\u7387\u306b\u30a4\u30c1\u30e3\u2026\u2026\u3057\u51fa\u3059\u306e\u3067\u3001\u5272\u3068\u3057\u3063\u304b\u308a\u7d61\u3093\u3067\u3066\u3082\u9055\u548c\u611f\u306a\u3044\u3001\u3067\u3059\u3002\u3057\u3044\u3066\u8a00\u3046\u306a\u3089\u6643\u4f86\u304f\u3093\u304c\u5f04\u3070\u308c\u308b\u5074\u306b\u306a\u308b\u3053\u3068\u306f \u306a\u3044\u304b\u3089\u3001\u305d\u3053\u3060\u3051\u2026\u3067\u3059\u304b\u306d\u2026\u2026\uff1f\n\n\u21912\u5ea6\u76ee\u306b\u306a\u308a\u307e\u3059\u304c\u3001\u3053\u3053\u307e\u3067\u306e\u4f9d\u983c\u5185\u5bb9\u3092\u5168\u3066\u7121\u8996\u3057\u3066\u304a\u307e\u304b\u305b\u3067\u597d\u304d\u306b\u66f8\u3044\u3066\u6b32\u3057\u3044\u3068\u306f\u601d\u3063\u3066\u3044\u308b\u306e\u3067\u3001\u601d\u3044\u3064\u304b\u306a\u304f\u306a\u3063\u305f\u6642\u306b\u3042\u3093\u306a\u3053\u3068\u8a00\u3063\u3066\u305f\u306a\u2026\u2026\u7a0b\u5ea6\u306e\u3082\u306e\u3060\u3068\u601d\u3063\u3066\u304f\u3060\u3055\u3044\ud83d\ude2d\ud83d\udca6\n\n\u25a0\u4f7f\u7528\u7528\u9014\n\uff0a\u500b\u4eba\u89b3\u8cde\u7528\n\u3000\u2192\u30b9\u30de\u30db\u306e\u58c1\u7d19\u3084SNS\u30a2\u30a4\u30b3\u30f3/\u30d8\u30c3\u30c0\u30fc\u4f7f\u7528\n\uff0a\u500b\u4eba\u7528\u306b\u5370\u5237\n\uff0a\u4e00\u7dd2\u306b\u56de\u3063\u3066\u304f\u308c\u305f\u65b9\u3078\u306e\u5171\u6709\n\n\u25a0\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u95a2\u4fc2\u6027\n\u73fe\u4ee3\u65e5\u672c\u304c\u821e\u53f0\u306e\u3001\u7de8\u96c6\u8005\u00d7\u4f5c\u5bb6\u306e\u30ab\u30c3\u30d7\u30ea\u30f3\u30b0\uff08\u6643\u98a8/\u307f\u3064\u304b\u305c\uff09\u3002\u000b\n\u8abf\u5b50\u304c\u826f\u304f\u3066\u8ddd\u96e2\u306e\u8fd1\u3044\u7de8\u96c6\u8005\u30fb\u85e4\u5d5c\u6643\u4f86\u3068\u3001\u4eba\u4ed8\u304d\u5408\u3044\u304c\u82e6\u624b\u306a\u4f5c\u5bb6\u30fb\u70cf\u67f3\u98a8\u7d00\u3002\u000b\n\u6643\u4f86\u304c\u98a8\u7d00\u3092\u9762\u767d\u304c\u308a\u3064\u3064\u4e16\u8a71\u3092\u713c\u3044\u3066\u304f\u308c\u3066\u3044\u3066\u624b\u304c\u304b\u304b\u308b\u3053\u3068\u306b\u3001\u98a8\u7d00\u306f\u6643\u4f86\u306e\u8a00\u52d5\u306b\u4e00\u559c\u4e00\u6182\u3057\u3066\u30d0\u30bf\u30d0\u30bf\u5fd9\u3057\u3044\u304c\u7de8\u96c6\u3068\u3057\u3066\u4fe1\u983c\u3057\u3066\u3044\u308b\u3057\u3001\u4eba\u3068\u3057\u3066\u604b\u3057\u3066\u3044\u308b\u3002\n\n\u25a0\u70cf\u67f3 \u98a8\u7d00\uff08\u3046\u308a\u3085\u3046 \u304b\u305c\u306e\u308a\uff09\n28\u6b73\uff0f\u7537\u6027\uff0f\u5c0f\u8aac\u5bb6\uff08\u4e3b\u306b\u7d14\u6587\u5b66\u5fd7\u5411\u3001\u5b98\u80fd\u5c0f\u8aac\u3067\u751f\u8a08\u3092\u7acb\u3066\u308b\uff09\uff0f169cm\n\uff65\u7dd1\u9aea\u306e\u65b9\n\n\u6587\u5b66\u304c\u751f\u6d3b\u305d\u306e\u3082\u306e\u306b\u306a\u3063\u3066\u3044\u308b\u4eba\u3002\u000b\u4eba\u4ed8\u304d\u5408\u3044\u304c\u6975\u7aef\u306b\u82e6\u624b\u3067\u3001\u793e\u4f1a\u7684\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u306b\u306f\u4e0d\u5668\u7528\u3001\u672c\u3084\u5275\u4f5c\u306e\u8a71\u306b\u306a\u308b\u3068\u5c11\u3057\u9952\u820c\u306b\u306a\u308b\u3002\u60c5\u666f\u63cf\u5199\u306b\u512a\u308c\u308b\u53cd\u9762\u3001\u5fc3\u60c5\u7406\u89e3\u304c\u4e0d\u5f97\u610f\u3002\u6bd4\u55a9\u7684\u3067\u98db\u8e8d\u3057\u305f\u8a71\u3057\u65b9\u3092\u3057\u304c\u3061\u3067\u3001\u4f1a\u8a71\u304c\u5c11\u3057\u72ec\u7279\u3002\n\u8ae6\u3081\u304c\u65e9\u3044\u4e00\u65b9\u3067\u3001\u4fe1\u3058\u305f\u3082\u306e\u306b\u306f\u4e00\u76f4\u7dda\u3002\u000b\u81ea\u5df1\u8a55\u4fa1\u304c\u4f4e\u304f\u3001\u5bfe\u4eba\u95a2\u4fc2\u306b\u3082\u6d88\u6975\u7684\u3060\u3063\u305f\u304c\u3001\u62c5\u5f53\u7de8\u96c6\u3067\u3042\u308b\u6643\u4f86\u3068\u51fa\u4f1a\u3044\u3001\u4eba\u3068\u95a2\u308f\u308b\u5fc3\u5730\u3088\u3055\u3092\u77e5\u3063\u3066\u5c11\u3057\u305a\u3064\u5909\u5316\u3057\u3066\u3044\u308b\u3002\u8ae6\u3081\u304c\u65e9\u3044\u306e\u3082\u3001\u6700\u8fd1\u306f\u5c11\u3057\u30de\u30b7\u306b\u306a\u3063\u3066\u304d\u305f\u3002\u7a4d\u6975\u7684\u306b\u6587\u5b66\u8cde\u306b\u5fdc\u52df\u3057\u3088\u3046\u3068\u3044\u3046\u610f\u6b32\u3092\u898b\u305b\u3066\u3044\u308b\u3002\u8ae6\u3081\u60aa\u304f\u3001\u597d\u304d\u306a\u7269\u306b\u7e0b\u3063\u3066\u8db3\u63bb\u3044\u3066\u751f\u304d\u3066\u3044\u304f\u899a\u609f\u3092\u6c7a\u3081\u305f\u3002\n\u604b\u611b\u7d4c\u9a13\u306f\u307b\u307c\u306a\u304f\u3001\u604b\u4eba\u3089\u3057\u3044\u8ddd\u96e2\u611f\u306b\u306f\u304b\u306a\u308a\u521d\u5fc3\u3067\u4e0d\u5668\u7528\u3002\u000b\n\u98a8\u7d00\u306b\u3068\u3063\u3066\u6643\u4f86\u306f\u3001\u5e73\u9759\u3067\u3044\u3088\u3046\u3068\u3057\u3066\u3082\u8abf\u5b50\u3092\u4e71\u3055\u308c\u3066\u3057\u307e\u3046\u4eba\u3002\u6643\u4f86\u306e\u524d\u3067\u306f\u611f\u60c5\u304c\u5148\u306b\u96f6\u308c\u3066\u3057\u307e\u3046\u3002\u89e6\u308c\u3089\u308c\u305f\u308a\u512a\u3057\u304f\u3055\u308c\u308b\u305f\u3073\u306b\u6297\u3048\u306a\u304f\u306a\u308a\u3001\u604b\u3092\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u601d\u3044\u77e5\u3089\u3055\u308c\u3066\u3057\u307e\u3046\u76f8\u624b\u3002\n\n\n\u25a0\u85e4\u5d5c \u6643\u4f86\uff08\u3075\u3058\u3055\u304d \u307f\u3064\u304d\uff09\n27\u6b73\uff0f\u7537\u6027\uff0f\u51fa\u7248\u793e\u52e4\u52d9\u306e\u7de8\u96c6\u8005\uff0f175cm\n\uff65\u30d4\u30f3\u30af\u2192\u30af\u30ea\u30fc\u30e0\u8272\u306e\u30b0\u30e9\u30c7\u30fc\u30b7\u30e7\u30f3\u306e\u9aea\u306e\u65b9\n\n\u4eba\u3068\u306e\u8ddd\u96e2\u304c\u8fd1\u304f\u3001\u3078\u3089\u3078\u3089\u3068\u3057\u305f\u7b11\u9854\u304c\u5370\u8c61\u7684\u306a\u9752\u5e74\u3002\u000b\u5a2f\u697d\u3084\u5275\u4f5c\u6587\u5316\u305d\u306e\u3082\u306e\u3092\u611b\u3057\u3066\u3044\u3066\u3001\u300c\u4f5c\u54c1\u3092\u751f\u307f\u51fa\u3059\u4eba\u3092\u652f\u3048\u308b\u3053\u3068\u300d\u3092\u4ed5\u4e8b\u306b\u3057\u305f\u4eba\u3002\n\u8ab0\u306b\u3067\u3082\u512a\u3057\u304f\