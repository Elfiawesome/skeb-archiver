c-bbc1-936c6dfc82a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=542a5b32a21bf3c8bfcf26e2c11a9962, https://si.imgix.net/0fb55961/uploads/origins/77679ae9-abbe-46fc-bbc1-936c6dfc82a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=593144fa21d3db2165b20abc09f1d53e 2x, https://si.imgix.net/0fb55961/uploads/origins/77679ae9-abbe-46fc-bbc1-936c6dfc82a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff6520d505dcbe12fdadd4990ff35f0c 3x"}, "body": "いつもお世話になっております。稀と申します。偶然さんの大大大ファンでして、とてつもなく偶然さんの絵柄、センス、構図で見てみたいと思いリクエストさせていただきます。\n今回CoCの探索者のイラストを描いていただきたいです。以下詳細です。\n\n□用途\n・非営利個人用グッズ（ポスターやアクスタ等）\n・SNSのヘッダー\n\n□依頼内容\n・一枚絵\n・服のデザイン画（できましたら…無理でしたら大丈夫ですし、ラフで結構です）\n\n後述するキャラクターの、一枚絵をお願いしたいです。構図やデザインは偶然さんのお任せでお願いいたします。\n個人用にポスター印刷をしたいため、映画のポスターや雑誌のようなデザインだと嬉しいです！…でもコラージュとかも可愛い…もう何だって嬉しいです…。\n好きなように描いていただきたいです。あくまで偶然さんのイラストが大変大変見たいので！！！！！！\n\n□キャラクター設定\n逢坂時雨\nCoCシナリオ「舐薬」HO2の自探索者\n身長:179\n年齢:25くらい\nアイドルでダンス担当、イメカラ赤\nトップアイドルで、恋愛ドラマ物の俳優などもしています。\n力も強く、割とがっしりしています。売れない時期を乗り越えようやく大成したキャラクターです。割とメンヘラちっくで「どうせ俺は…」となるたびに相方に大丈夫！と言われてケロッとするジメジメとしたメンヘラのような性格です。\n服装ですが、時雨は服が好きで古着からブランド物まで幅広く取り入れています。どちらかというと黒色を好んだり、スポーティ寄りが好きなイメージですが、どんなジャンルも大好きなタイプです。\nまた、首元を隠す服だとありがたいです。チョーカーでも可です。ピアスも開けているので、開いている部分に好きなようにつけていただければ、とてもとても嬉しいです。\n\n□参考資料\n参考URLに添付しています。\n足りないものやリンク不備がありましたら、再送をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1qbHFQ2MbMQEBcOZcRs1_vcSgIb5_aex5", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uzu_mizu2/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/01550877/uploads/origins/a3d960f5-bdae-4ec5-a622-ba4b40037f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=199e67fceb07a490ff1473aba0488860", "srcset": "https://si.imgix.net/01550877/uploads/origins/a3d960f5-bdae-4ec5-a