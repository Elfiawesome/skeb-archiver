d or couch with an oversized or baggy shirt, I think could be a great artwork idea!\n\nRegardless, I hope you have fun and enjoy~\n\nThank you for considering this request! 🤍\n\nhttps://drive.google.com/drive/folders/1by6cpSwWjkj7-3BJz7lOJr2NqaCbC2Hk?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i6_166/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3899700, "client_id": 3584851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f9e2c66/uploads/origins/dba6ee73-2d90-4627-86ea-d70b962fea67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eea03a3372da87f57a76eabc651339b", "srcset": "https://si.imgix.net/0f9e2c66/uploads/origins/dba6ee73-2d90-4627-86ea-d70b962fea67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eea03a3372da87f57a76eabc651339b, https://si.imgix.net/0f9e2c66/uploads/origins/dba6ee73-2d90-4627-86ea-d70b962fea67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e673aba963f83159cc74f4bdb4548262 2x, https://si.imgix.net/0f9e2c66/uploads/origins/dba6ee73-2d90-4627-86ea-d70b962fea67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0574447bcd70be1c6731c34b3eceea1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f9e2c66/uploads/origins/dba6ee73-2d90-4627-86ea-d70b962fea67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803d4319905622b9c618bfb6d0fc2bbc", "srcset": "https://si.imgix.net/0f9e2c66/uploads/origins/dba6ee73-2d90-4627-86ea-d70b962fea67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803d4319905622b9c618bfb6d0fc2bbc, https://si.imgix.net/0f9e2c66/uploads/origins/dba6ee73-2d90-4627-86ea-d70b962fea67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr