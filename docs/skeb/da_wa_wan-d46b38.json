han\nリー (187cm): https://toyhou.se/2425578.leigh\n\n二人とも男の子ですが、ハンはアンドロイドに見えます。ハンはヒーラーで、モチーフは太陽、火、音楽、自然。リーは学者で、モチーフは知識、本、書道、物語を語ること。ふたりはロマンチックで、とても楽しい関係だ。ふたりは一緒にダンスをし、探検をする。\n\nお好きなように描いてください！ギャラリーの中から服を選ぶのも、自分でデザインするのも自由です。現代的な服装でも構いませんので、自由に描いてください！重要な服装は、おそろいのネックレスだけです。ハンの翼はお好みで、リーにはそばかすがあり、目は金色がかったマゼンタ色です。\n\nありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@da_wa_wan/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/935ad41f/uploads/origins/876dc608-7f2d-4c3a-a750-4196c86e8d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cec4d35fd7b4bf734c046d0b143b132", "srcset": "https://si.imgix.net/935ad41f/uploads/origins/876dc608-7f2d-4c3a-a750-4196c86e8d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cec4d35fd7b4bf734c046d0b143b132, https://si.imgix.net/935ad41f/uploads/origins/876dc608-7f2d-4c3a-a750-4196c86e8d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9911f3383535021d70165601294198c8 2x, https://si.imgix.net/935ad41f/uploads/origins/876dc608-7f2d-4c3a-a750-4196c86e8d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36adac35237377a4df534a9854f603c8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1316161, "client_id": 30964, "nc": 145}, {"path": "/@da_wa_wan/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1316161, "client_id": 1983764, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/