9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e27163c6925c2b506a3a31574d30d07 2x, https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95876b08aaaaa503d45bcb163e7359ec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d30aa08fa06b65c30732ecf6fba898fa", "srcset": "https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d30aa08fa06b65c30732ecf6fba898fa, https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df5582ea7ee2b829280997f8d27697d3 2x, https://si.imgix.net/dfabef43/uploads/origins/99c6d219-a22d-48c3-89be-cc76717e649f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b54114f047d25e3d0ea6b7f722511640 3x"}, "body": "こんにちは！前回の配信、本当にありがとうございました。もしよろしければ、また別のキャラクターを演じてほしいです。\n\n彼女は物静かな少女で、巨大な刃物を持っている。それは彼女の最愛の人の背骨をモデルにしたもので、だから彼女は剣と一緒に悪人を切り倒すことで、剣に近づこうとする。この復讐の旅は明らかに独りよがりなので、彼女の旅の荒々しさと最終的な憂鬱さを強調するようなものがいい。\n\nあなたのこの前の作品（https://x.com/kmnm_1403/status/1962456645273014674）のトーンが好きなので、彼女が髪を下ろして剣を引きずりながら歩く後ろ姿が描けたら素晴らしいです。たぶん背景は白で、彼女の剣が残した跡は血まみれです。もしよければ、どんなものができるか見てみたいです。\n\n資料の右端にある服を着た彼女を描いてほしい。たぶん、少し切り傷や涙がある。ここでも、ご自由にどうぞ。\n\nありがとうございました！\n\nhttps://photos.app.goo.gl/tnVep7ztKsJHszj18", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kmnm_1403/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2345616, "client_id": 591360, "vtt_url": null, "thum