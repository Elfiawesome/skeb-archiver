&crop=top&w=200&h=200&blur=200&s=c97687489389f78b0db9991224e44bde 3x"}, "body": "よもぎさんいつもお世話になっております！\n私の自創作のキャラクターを描いていただきたいです。\n\nよもぎさんの描く白髪紫目少女が見たい…………という感情でリクエストさせていただきました。\n自由に描いていただけると嬉しいです！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jHaFtE8ZiL6pP4hwZfg9DACKHPxzJFse?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ym_ncy/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2114174, "client_id": 545997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce67ee2a74476b6c1cbef16c3b5a6d07", "srcset": "https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce67ee2a74476b6c1cbef16c3b5a6d07, https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bca3aca708b7bf3713f5b6997656125 2x, https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d355b724a35cd127882c25c21040a511 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02f0d4ec95829cff4d5b8fca5c2e1f19", "srcset": "https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02f0d4ec95829cff4d5b8fca5c2e1f19, https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d99f3bec09ff6bbc7c809f851c8baa53 2x, https://si.imgix.net/df052667/uploads/origins/13910315-ac1a-4aa0-bdf6-36c756fd0584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59211672c367a38e337469806eb0fb06 3x"}, "body": "こんにちは、こちらでは初めまして！\n以前からよもぎさんの絵柄で見てみたいと思っていたものがあるのでリクエストさせて頂きます\n\n拙宅学戦キャラの英栄華とあきまるさん宅の居鳥依途ちゃん(あきまるさんには許可貰い済です)のうちよそを描いて頂きたいです！\n全体的に夏っぽい雰囲気で海が描いてあったら嬉しいです(描いてなくても大丈夫です)\n二人の服装は夏っぽいラフな感じで描いて頂けたらと思います。構図や表情等はお任せします！\n\nご検討のほど宜しくお願いします…！\n\n【参考資料】\n栄華：https://twitter.com/cs_SDK/status/1657231096759853057?t=I5N6RqTzkOTkCZXY5R_KYw&s=19\n依途ちゃん：https://twitter.com/akimaluuu/status/1259568995755151361?t=0vJ1HHRllafy8CfLp4z69w&s=19", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ym_ncy/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2114174, "client_id": 2241032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db296bcfc6584eaecf6cec47702be6a5", "srcset": "https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db296bcfc6584eaecf6cec47702be6a5, https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3efd3de39a0d5ac86029d6884042e34b 2x, https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=798b60a14ad11f9256560143a44d3ef8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a69770abf2faa3b0c0b89bc07883927", "srcset": "https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a69770abf2faa3b0c0b89bc07883927, https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53a3534592fb88d0a8a18df550fea1a4 2x, https://si.imgix.net/a8de2304/uploads/origins/93811c1e-07a7-41d3-a7bc-0e40a76cb1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9548ff3ab4a6f04de280667a2cdedca9 3x"}, "body": "よもぎさんこんにちは！先日は素敵なイラストを本当にありがとうございました！この度リピートさせていただきたく、依頼させていただきます。\n\nTwitter世界観共有創作企画「きっとその腕に抱きとめて」の私の創作キャラであるエレノア・クリフォードとそのペア相手であるゆうきさん宅のノアレくんをお願いできますでしょうか。(お相手から許可をいただいております！)\n簡単に2人の関係を説明しますと、エレノアは人間であり、ノアレくんは天使、ノアレくんはエレノアが生まれたときからエレノアを見守っています。普段は見えませんが、死の1年前になると天使が見えるようになってしまうためにエレノアは15歳の8月からノアレくんのことが見えるようになります。\nそうして1年を過ごしていくうちに2人はお互いに恋に落ちますが、好きだということは胸の中に隠したままでした。しかし、最期のときに互いに想いを伝えてエレノアはノアレくんの腕に抱きとめられて命を終え、同様にノアレくんも天寿を全うします。\nより詳しい天使と人間の関係性につきましては\nhttps://twitter.com/sonotome/status/1662633240799379456?s=46&t=iVLWIx_tavLZWIPPG2x6iQ\nをお読みいただければと思います。\n\nシチュエーションですが、夜中にエレノアの寮の同室の子が談話室に行くなどしたときにこっそり部屋の窓を開けてノアレくんとお話している……というような、男女の密会のような感じで描いてくれたら嬉しいです……！\n難しいシチュエーションですが、どうぞよろしくお願い致します！\n\n【参考資料】\nhttps://drive.google.com/drive/folders/11mEcZmDavdnoKlS01eZ66P7Qvn66Zswn", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ym_ncy/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/27884836/uploads/origins/42012c2e-c945-45c0-a985-615a12e8be1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0ebab7fbdbcb2a4fddac