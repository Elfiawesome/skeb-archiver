b9a74b7a3a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfcaa528a06e8e1e5a3482a80a2ff3f3 2x, https://si.imgix.net/ade376c1/uploads/origins/12764e61-e7e9-4088-b841-b9a74b7a3a66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=798798a31856b32a992f0787ec01991b 3x"}, "body": "むらさめ様\n\nはじめまして。もやしと申します。\n\nむらさめ様の素敵なSkeb作品を拝見し、ポーズや表情がとても可愛くて好みだったため、この度依頼させていただきました。\n\nVTuber「星乃るる」さんのイラストを描いていただけないでしょうか。\n星乃るるさんの詳細につきましては参考資料をご参照ください。\n\n〇依頼詳細\n・衣装は新衣装(※1)\n・ポーズや表情はおまかせいたします。\n\n〇イラスト使用用途\n・VTuberご本人様へのプレゼントとさせていただきます\n・ファンアートタグをつけてXに投稿\n・星乃るるさんのYouTube(収益化済み)等の配信やサムネイル・動画、XなどSNSでの使用\n\n〇希望納品形式\n・人物と背景等がレイヤー分け出来るPSDデータでいただけると幸いです\n・PSD不可であればpngでも問題ございません\n\n〇参考資料\n・X\nhttps://x.com/hoshinoruru/status/1581115555238465536\n(※1)画像一枚目が新衣装になります\n\n・YouTube\nhttps://www.youtube.com/@hoshi_noru\n\n以上、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sword_of_nmkr/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1477535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09d20db1/uploads/origins/4a5db3a2-732e-4290-85a6-d511ffbd5779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb633d8f3259c6dbbbe46ae59cf68c5b", "srcset": "https://si.imgix.net/09d20db1/uploads/origins/4a5db3a2-732e-4290-85a6-d511ffbd5779?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb633d8f3259c6dbbbe46ae59cf68c5b, https://si.imgix.net/09d20db1/uploads/origins/4a5db3a2-732e-4290-85a6-d511ffbd5779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a62e35c240c5c0841148427038bf7278 2x, https://si.imgix.net/09d20db1/uploads/origins/4a5db3a2-732e-4290-85a6-d511ffbd5779?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c43012c02c7c9fd42586847e801c5d16 3x"}, "duration": nul