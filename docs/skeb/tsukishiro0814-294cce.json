ザインでお任せしてよいでしょうか？お好きなようにアレンジしてくださると幸いです。（ちゃんと決まってなくて申し訳ありません！なんならもう全部服装は描きやすいように変えてしまってください！）\n\n使用用途としましてはASMR用のチャンネルでそちらのサムネイル等に使用させていただきたく（イラストを切り抜いて用途用途で使いたいのでサイズはおまかせで大丈夫です）構図もお任せでお願いしたいです。\n長くなり申し訳ありませんがよろしくお願い致します。\n\nhttps://twitter.com/yoibeni/status/1638032833116803072?s=46&t=zMMiuJYqx-WQuLE_5c_Bcg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukishiro0814/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e44afdcd/uploads/origins/f320edb2-d483-4418-bd8e-ea981e731e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eacf5d8fdf9b0cc1fbba1bbbe95590d1", "srcset": "https://si.imgix.net/e44afdcd/uploads/origins/f320edb2-d483-4418-bd8e-ea981e731e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eacf5d8fdf9b0cc1fbba1bbbe95590d1, https://si.imgix.net/e44afdcd/uploads/origins/f320edb2-d483-4418-bd8e-ea981e731e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8de108418a4598ad044692cf7f5d4931 2x, https://si.imgix.net/e44afdcd/uploads/origins/f320edb2-d483-4418-bd8e-ea981e731e1a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1625c3140e8e7ecd8e74e029e68a092a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1347466, "client_id": 1515469, "nc": 128}, {"path": "/@tsukishiro0814/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5366dc11/uploads/origins/e14ff0c5-098a-41e2-bb8c-63d58baa5979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=