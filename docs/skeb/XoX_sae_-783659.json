imgix.net/c94bb29b/uploads/origins/78af4da3-1b2a-4e8b-a429-e4cacc20fd7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a8e1d0383f3b4bc937698776af42460 3x"}, "body": "SAE*様、はじめまして。\nXでお見かけし、仄暗く彩度低めの絵柄、人物の儚げでアンニュイな表情、背景の書き込み、不穏な雰囲気が素敵だなと思い、ぜひ依頼させていただきたいと思いました。\n\n【使用用途】\nTiktok、YouTubeにて配信活動をしております。\nSNS(主にX)に投稿させていただきたいです。\n収益化済のアカウントで動画投稿させていただく可能性もあるので商用利用を許可していただけるとありがたいです。\nグッズ化の予定はありません。\n\n【キャラクターについて】\n女ですが、体格は凹凸がなく全体的に少年のような雰囲気です。\n年齢は不詳ですが、見た目は10代半ば〜後半くらいのイメージでお願いいたします。\n\n【構図について】\n自身のキャラクターが、肖像画・絵画なので、私の絵(額縁あり)が壁に飾られている1枚絵をお願いしたいです。\n衣装は、参考資料の「特徴」という画像で1番大きく描かれている姿でお願いいたします。\nそして、背景の差分を描いていただきたいです！\n色々な場所を転々としてきた絵画というイメージです。\n背景の差分について\n①美術館\n・鑑賞している客が何人かいる(ぼんやりとで大丈夫です。顔は見えず後ろ姿だったり、影のような感じでも◎)\n②洋館\n・ゴシックな雰囲気の部屋\n③廊下\n・人気のない廊下の突き当たり(②と差別化するために老朽化した建物にしていただけると嬉しいです。日本家屋でも◎)\n\n①、②は必ず描いていただきたいので、金額が見合わなければお手数ですが再送要請をお願いいたします。\n③は省いていただいてもかまいません。\nただ、背景の家具や小物はあまり細かくなくてもいいので、その分3種類描いていただけるようであれば嬉しいです…！\n私の絵も、バストアップでかまいません。\n\n【表情について】\n真顔か、軽く微笑むくらいでお願いいたします。\n背景ごとに、少し表情や目線を変えていただくなど「絵が動いてる」と思わせるような若干の変化があると嬉しいですが、全部同じでもかまいません。\n(変化する場合、美術館で人に見られている時は真顔、人気がない場所では笑っている、目線がそっぽを向いているなど)\n\nたくさん要望を書いてしまい申し訳ありません。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1mba34ptKJoiAkgH02FSrl8hB1JrKft_S", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XoX_sae_/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b8f17483/uploads/origins/03519219-0f35-4fad-8e6c-967bf723f381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd7df264c407f9f459d626e1bd3f5c51", "srcset": "https://si.imgix.net/b8f17483/uploads/origins/03519219-0f35-4fad-8e6c-967bf723f381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd7df264c407f9f459d626e1bd3f5c51, https://si.imgix.net/b8f17483/uploads/origins/03519219-0f35-4fad-8e6c-967bf723f381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30b41b62730c699dbc317375186e3652 2x, https://si.imgix.net/b8f17483/uploads/origins/03519219-0f35-4fad-8e6c-967bf723f381?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7a4932a48cd002bf6cc1ec9b781bbc4 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3317937, "client_id": 1818006, "nc": 16}, {"path": "/@XoX_sae_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3317937, "client_id": 2353631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2e0d157edc20266ce530b8c4486ec0", "srcset": "https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad2e0d157edc20266ce530b8c4486ec0, https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=366f0b23cac0e24eb051394fc12e2c41 2x, https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=861cb390f2fd699edc89be5afa620008 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f098fd5a4daec6448cf982345024b96a", "srcset": "https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f098fd5a4daec6448cf982345024b96a, https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5d186aa1bc815ab3ca13a50573abb90 2x, https://si.imgix.net/e05a3dc7/uploads/origins/8fb6c31f-33f3-4a3d-86e6-2a12d5a70787?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=117c02b2abd30d83e1c3408cfda1adba 3x"}, "body": "SAE*様初めまして！うちゅと申します。TLに流れてきたSAE*様のイラストをお見かけして一目惚れしました！優しい色使いと引き込まれる絵の雰囲気が大好きで、是非お願いしたいと衝動で依頼をお願いしに来ました…！アカウントも覗かせて頂き、さらにSAE*様にお願いしたい……！の気持ちが強くなり、我慢ならずここまで来た次第です…！✨️ \n\n【依頼内容】 \nTRPG探索者二人のイラストをお願いしたいです。ポーズや構図等、はこちらから指定はございません！SAE*様の解釈で描いてくださると嬉しいです……！\n\n‎▮ 霞 透華 かすみ とうか 15歳 155cm 黒髪\nポジティブ。比較的優しく明るく面倒見のいい性格。どんな生き物にも優しく、博愛的な面がある。周りには幸せに笑っていて欲しいというのが基本的思考。そのためなら嘘もつく。誰のことを傷付けたくないし、傷つかないで欲しい。思い出と呼称される記憶を蝕まれる奇病を患っている。ジェイドの咲かせる花が好き。\n\n▮ ジェイド ･ ヴァイン  15歳  180cm\nネガティブ。人間不信の塊。悲観的。口開けば吐くの毒ばかり。警戒心度MAX。威嚇度MAX。唐突に激昂したり、かと思えば冷静になったりと情緒が不安定な所がある。透華といると落ち着く。よく手を引かれている。心臓に根をはり血管から花を咲かせる奇病を患っている。自分が咲かせる花が嫌い。\n\n【使用用途】 \n個人の鑑賞\n創作仲間への共有\nアイコン 壁紙等の使用。  \n\n何か不備等ありましたらすみません。 金額が合わない場合は遠慮なく再送、キャンセルしていただければ幸いです。 ご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/16HZ3M3yg-b8EoQPoGr0NVVckoexNCWT4", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XoX_sae_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3317937, "client_id": 2835442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db912ea8/uploads/origins/f3014cba-a3c4-467c-8ba6-77bb67505604?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca1c5af9f932bd52592a7a38a2e40957", "srcset": "https://si.imgix.net/db912ea8/uploads/origins/f3014cba-a3