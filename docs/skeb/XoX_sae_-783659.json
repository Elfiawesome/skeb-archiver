67bf330a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d36519eafba1ec6dc10c70fb31daa89", "srcset": "https://si.imgix.net/65fbb68c/uploads/origins/23e7ced8-8b83-4ea5-8277-5dd067bf330a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d36519eafba1ec6dc10c70fb31daa89, https://si.imgix.net/65fbb68c/uploads/origins/23e7ced8-8b83-4ea5-8277-5dd067bf330a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f85bf9df57a1195222ff7bd79c19fbd 2x, https://si.imgix.net/65fbb68c/uploads/origins/23e7ced8-8b83-4ea5-8277-5dd067bf330a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e1c5944d3d7fd4bfce233ca12de95ea 3x"}, "body": "初めまして。\nTLに流れてきたSAE*様のイラストの空気感に一目で惹かれ、依頼をさせて頂きたく思いました。\n\n【依頼内容】\nTRPGの探索者である、2人のイラストを描いていただきたいです。\n構図に指定はなく、SAE*様のイメージにおまかせ出来たらと考えています。\n\n・1人目\n男 / 大学生（医学部/病理学者志望） / 182cm\nモチーフ：ハデス、仏教\n幼少期より他者が自分と同じ存在だとは思えず、人に対して無関心な態度を隠さない。しかしながら、優れた才能を持って他人からその在り方を許されてきた。\n恋人である彼女を本心から愛し、彼女にのみ執着心を向けている。\n\n\n・2人目\n女 / 大学生（海洋生物研究専攻） / 154cm\nモチーフ：ペルセポネー、ヒュプノス、水槽\n家族を含めた過去のコミュニティの中に居場所を持つことができず、望まぬ孤独を生きてきた。\n基本的には淡々として人を寄せつけない雰囲気を纏っているが、彼氏である男の前ではその雰囲気を綻ばせる。\n\n\n・2人に共通するテーマ\n冥界、離人感、出会って\"しまった\"2人\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1rU2S2sn1KC8sa5qKNJ2ZomTp3FO0mBn3\n\n【使用用途】\n・SNSでの使用（作者名＆アカウントを記載の上での、依頼報告ツイート･アイコンやヘッダーでの使用）\n・個人鑑賞の範囲内での印刷やグッズ制作\n\n\n不手際があったり金額が合わなかったりする場合は再送要請頂けると助かります。\nどうぞご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rU2S2sn1KC8sa5qKNJ2ZomTp3FO0mBn3", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XoX_sae_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3317937, "client_id": 3411319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a37e7898e1d86fb63d830f9b9f5a8508", "srcset": "https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a37e7898e1d86fb63d830f9b9f5a8508, https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e08f25a1e4df05854cff388bfbbc16f1 2x, https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=744871fc243433ad3ca642adfc96276e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69a912ef4adb0bbcfa4e05ce11bce45a", "srcset": "https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69a912ef4adb0bbcfa4e05ce11bce45a, https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55852fde7fd8105cd3e3b383aa6865d3 2x, https://si.imgix.net/abc02205/uploads/origins/552608fe-d040-42ba-b127-cdc4bf62a45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f364d0c84347c0c9b02946f2e9f0f0f5 3x"}, "body": "はじめまして、かしかと申します。\nタイムラインでお見かけした、空気感のある色彩が鮮やかな作品の雰囲気に惹かれ、\nぜひリクエストしたくご連絡いたしました。\n【依頼内容】\nTRPGで使用しているオリジナルキャラクター\nMichel Carmine（ミシェル・カーマイン）\nのイラストをお願いできればと思っております。\n【設定画リンク】\nhttps://drive.google.com/file/d/1_A_j_KpHm4iHd1zEyaSeciqpxOB3p50p/view?usp=drivesdk\n【設定】\n・年齢：14\n・性別：男性\n・設定／雰囲気：\n教会の聖歌隊に所属している少年です。\n外では素っ気なく反抗的に見える一方、内面には不器用な甘さや弱さを抱えています。\n勝ち気で負けず嫌いですが、言葉よりも行動に本心が出やすく、\n身だしなみや所作を整えることで自分を律している人物です。\nどこか張りつめた、繊細さのある空気感を大切にしていただけると嬉しいです。\n【シチュエーション】\n薄暗い教会の中や回廊、もしくは礼拝堂の一角などをイメージしています。\nステンドグラスやキャンドルの光に照らされているような、\n静かで少し緊張感のある雰囲気だと嬉しいです。\n具体的な構図や演出については、お任せいたします。\n【使用用途】\n個人的な観賞用の印刷、およびPCのデスクトップへの使用を想定しています。\n【備考】\n上記の要望はいずれも厳守ではなく、参考程度で問題ございません。\n可能な範囲で、SAE*様の温度感や自由な発想で描いていただけましたら幸いです。\nお忙しいところ恐れ入りますが、\nご縁がありましたら嬉しく思います。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1_A_j_KpHm4iHd1zEyaSeciqpxOB3p50p/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XoX_sae_/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3317937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb725ceb22697b6454aec7d5fa58f76a", "srcset": "https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb725ceb22697b6454aec7d5fa58f76a, https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2fdfdd77d9165cb93c460956d2321af 2x, https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37297f0d7eb9be71950eeaa4d799b1bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c956fd348cabf6772715485deb93152c", "srcset": "https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c956fd348cabf6772715485deb93152c, https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cce0ca8552105d6c7fd69633dfd9ce1 2x, https://si.imgix.net/207e199b/uploads/origins/f29dd5b5-01fd-497b-a024-4caa2fc74320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f023d395b1b7320d365faf4eba27d5d 3x"}, "body": "こんにちはSAE*様\n貴方の不穏ながらも暖かい絵の世界観が好きで依頼させて頂きました。\nSAE*様にはトウモロコシ畑にいる私のocを描いて頂きたいです。\n\nトウモロコシ畑には、「人間よりも高い背丈」や、「密接に植えられている」ことから来る視界の悪さによって、「迷ったら出られなくなる」、「近くに何かが居る気配がする」などの話が存在しています。\nそのトウモロコシ畑が持つ不気味な一面がSAE*様の絵の雰囲気に合うかと思い、モチーフにさせて頂きました。\n\n私のocは農家の娘で、あまり感情を表に出さない子です。\n服装や持ち物はアレンジされても資料のままでも構いません。\nその他特に指定は無いため、SAE*様のお好きな様に描いていただければと思います。\n検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/18j92uLPjKfkFCBzBN_EZO6wEvWsg6fgG", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XoX_sae_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3317937, "client_id": 3199807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66578d29663fec4aa560dfd5d9611e33", "srcset": "https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66578d29663fec4aa560dfd5d9611e33, https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2f56e0a5cc2ab85cad3e41b073b6b9d 2x, https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ede8d5eca1eccf81bd96580d5545aac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fb2549880e0b7b8d210366b045376cc", "srcset": "https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fb2549880e0b7b8d210366b045376cc, https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db73c8fecd65368dc1d5821f4b994c54 2x, https://si.imgix.net/aec57bbd/uploads/origins/b363fb25-a3a1-4626-bf0f-f1fd973f3520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c33a3f8cf8e179cd295cdc338a7290b4 3x"}, "body": "SAE*様はじめまして。最近TwitterでSAE*さんの作品を拝見して、美しくもどこか不安になるような、見ているだけで心拍数が速くなって抗えない感覚に惹かれてこちらにリクエストをお送りさせていただきました。色づかいや作品を取り巻いている空気の冷たさ、緊張感が私にとって初めての感覚で大好きです。\n\n私が1人で想像を膨らませている、存在しないギャルゲーのメインヒロインの女の子を描いていただきたいです。\nOCの子の名前は月ヶ瀬条といいます。\n\nこの存在しないギャルゲーの説明を少しさせてください‼️\n物語の始まりは高校生の主人公が、学校で急に五人の少女からモテ始めるところです。主人公が恋愛フラグを立てた覚えがないのに、ヒロインから好意を向けられます。\nハーレムに見せかけて、実はすべてが病弱な幼馴染・月ヶ瀬という一人の少女によって生み出された虚構です。\n\n月ヶ瀬は主人公の幼馴染で、家が隣同士、2階の部屋の窓越しに会話できる距離です。小学生の頃からずっと一緒に過ごしてきた存在で、現在は病弱で寝たきり、高校には通えていません。日中はほとんど眠っていて、夜だけが主人公と話せる時間です。\n月ヶ瀬は小学生の頃からずっと主人公が好きで、主人公がプリントを届けてくれたり、寝付けない夜にそばにいてくれた記憶が心の支えになっています。主人公にとって自分が「重荷」になることを何より恐れている、だからこそ、自分自身ではなく“別の女の子”としてでも一緒に高校生活を送りたいという歪んだ願いを選んだ子です。\n高校で主人公に迫る五人の女の子はすべて月ヶ瀬が作り出した人格で、彼女たちはそれぞれ違う個性を持っていますが、\t食べ物は好きなものから食べる、髪を触る癖は、考え事をしているとき、嬉しいとき、ほんの一瞬だけ目を伏せる、怒る沸点が低いわけじゃないけど、悲しむ沸点が低い、誰かに褒められると、必ず一拍遅れて照れるなど、その根底には全て月ヶ瀬がいます。\n病弱な自分では叶えられないから、と、自分の中身だけを切り分けて、別の女の子の姿にしたのです。\n主人公は、昼は月ヶ瀬が作り上げた5人の女の子と交流をしながら、夜は寝る前に月ヶ瀬と窓越しに会話をします。月ヶ瀬は主人公に学校のことを聞いたり恋の相談に乗ったり、「好きな人できた？」と主人公に聞いたりします。\n\n\n長くなってしまいすみません。SAE*さんに描いていただきたいのは、夜、窓越しに主人公が月ヶ瀬と話をするシーンです。一日中ベッドの上で生活している月ヶ瀬の唯一の楽しみです。主人公への激重感情を抱えたまま、穏やかに笑っているとありがたいです。\n\n月ヶ瀬のビジュアルは全く決まっておらず、月ヶ瀬の説明をSAE*さんが読まれて、感じたままに描いていただけると嬉しいです。\n髪色は月の色かなと思っておりますが、自由にお願いします。\nよければ、髪飾りにアンティークな鍵のヘアピンなどがあると嬉しいです。\n\n個人鑑賞用にタペストリー制作をしようと考えておりますが、よろしいでしょうか？もしよろしければ、ご検討ください。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XoX_sae_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3317937, "client_id": 1716797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db4f6cdf69e4d76d800f0f6fb8218394", "srcset": "https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db4f6cdf69e4d76d800f0f6fb8218394, https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65905e8624f4a8a6d12572be25c409dc 2x, https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b160c4357becafc3721ca469410f272b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c421ddca3efba7a8d4e41598837df693", "srcset": "https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c421ddca3efba7a8d4e41598837df693, https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbee08065529b83aefa6684fa599ce65 2x, https://si.imgix.net/7caef002/uploads/origins/366b6100-3b1f-4600-8961-1e26ee76e7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=82855ca1e3a447b63f32758e0534461c 3x"}, "body": "はじめまして、あらのと申します！\nアピール募集ポストからアピール頂きましてありがとうございました！薄暗く仄かに闇を含んでそうなイラストの雰囲気がとても良く、ぜひOCを描いていただきたいと思いリクエスト致しました。\n\n・キャラクター：オリジナルキャラクター(青い子のみ)\n\n設定画のリンク→ https://www.pixiv.net/artworks/132164544  過去skebで依頼したイラスト→ https://skeb.jp/@ichi_1saku/works/17  過去自分で書いたもの→ https://x.com/waikuni11/status/1983822332759294239?s=46&t=2RaNeq5lxbMTN5H7n7sk4Q\n\n・シチュエーション：薄暗い洋館の先の見えない長い廊下を、青白く光るランプを片手に歩いている。廊下には絵画とかかかってるイメージです。\n\n・使用用途：個人利用、PCのデスクトップにしたいので横長だと嬉しいです。\n\n・その他：服装の細かい部分は描きやすいように変えてもらって構いません！\n\n上記の要望は厳守ではなく、参考程度で大丈夫です！SAEさんの自由な発想で書いて頂きたいです！\nご縁がありましたら嬉しいです、よろしくお願い致します！(料金、スケジュールなど合わなければ遠慮なくキャンセルして頂いて大丈夫です！)", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@XoX_sae_/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e3a4ec57/uploads/origins/e9129a67-e410-46a3-92ba-b7a24d8efa38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20559f0f0753da2254e73c1c8b512a16", "srcset": "https://si.imgix.net/e3a4ec57/uploads/origins/e9129a67-e410-46a3-92ba-b7a24d8efa38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20559f0f0753da2254e73c1c8b512a16, https://si.imgix.net/e3a4ec57/uploads/origins/e9129a67-e410-46a3-92ba-b7a24d8efa38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5023255ec7f195177941ec17fa079a4b 2x, https://si.imgix.net/e3a4ec57/uploads/origins/e9129a67-e410-46a3-92ba-b7a24d8efa38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f