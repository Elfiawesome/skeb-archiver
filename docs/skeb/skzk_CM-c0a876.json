す。ゼカ様の描きやすいように描いていただけたら幸いです！\n不穏寄りだと嬉しいですが、他に似合いそうのものがあればお任せいたします！\n\n内容が合わなければキャンセルしていただいて構いません。\nお忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/soa6u59cqgi6yr1ebtwoa/AEoCSxBwrjo-jDWjrUPCM2g?rlkey=y22awaz827ispaaq6ujpd8pu9&st=t35j3lkx&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@skzk_CM/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2682344, "client_id": 3057225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fbe39fa/uploads/origins/6e81e9a0-9b6c-4514-95ff-a70f5523c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62f8295c49f183e98a10a82bb97d89b4", "srcset": "https://si.imgix.net/1fbe39fa/uploads/origins/6e81e9a0-9b6c-4514-95ff-a70f5523c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62f8295c49f183e98a10a82bb97d89b4, https://si.imgix.net/1fbe39fa/uploads/origins/6e81e9a0-9b6c-4514-95ff-a70f5523c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a2854d78a2ad78a430f290049c16942 2x, https://si.imgix.net/1fbe39fa/uploads/origins/6e81e9a0-9b6c-4514-95ff-a70f5523c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc39a4bb2af957918fbd735b2f288aba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fbe39fa/uploads/origins/6e81e9a0-9b6c-4514-95ff-a70f5523c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42a157f1b618e516fcff5bad6d4e119", "srcset": "https://si.imgix.net/1fbe39fa/uploads/origins/6e81e9a0-9b6c-4514-95ff-a70f5523c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42a157f1b618e516fcff5bad6d4e119, https://si.imgix.net/1fbe39fa/uploads/origins/6e81e9a0-9b6c-4514-95ff-a70f5523c6b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c