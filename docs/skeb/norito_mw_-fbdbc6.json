 not very nice. she loves to gossip, and loves drama. i don't have anything particular in mind, so i will leave it up to you.\n\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/46150870_7EFpHvr2p0iPquY.png\nhttps://f2.toyhou.se/file/f2-toyhou-se/images/46564850_iPlwEumKnqUdbtT.png?1647033316 (she is on the left.)", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@norito_mw_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1801621, "client_id": 1510995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ba97222/uploads/origins/7fabfe1c-1a56-443b-8e6a-f42a64a29c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91633fd198fa90db867a2f5912d606f1", "srcset": "https://si.imgix.net/3ba97222/uploads/origins/7fabfe1c-1a56-443b-8e6a-f42a64a29c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91633fd198fa90db867a2f5912d606f1, https://si.imgix.net/3ba97222/uploads/origins/7fabfe1c-1a56-443b-8e6a-f42a64a29c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac5147fd4a448abb994e79a1027b407a 2x, https://si.imgix.net/3ba97222/uploads/origins/7fabfe1c-1a56-443b-8e6a-f42a64a29c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dea8a89e42c63709ac1053bce24522dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ba97222/uploads/origins/7fabfe1c-1a56-443b-8e6a-f42a64a29c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9f6e54487518a20c152f3995a889b5b", "srcset": "https://si.imgix.net/3ba97222/uploads/origins/7fabfe1c-1a56-443b-8e6a-f42a64a29c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9f6e54487518a20c152f3995a889b5b, https://si.imgix.net/3ba97222/uploads/origins/7fabfe1c-1a56-443b-8e6a-f42a64a29c65?