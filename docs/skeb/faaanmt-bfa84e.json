\n・可能であれば、銃か手錠など警察とわかるような小物やポーズにしていただけるととても嬉しいです。\n\n【キャライメージ】\n・新人警察官\n・髪型はピンク色で大きいみつあみ、黒いリボンつき\n・少し萌え袖\n・スカートは左右にスリットあり\n・瞳の色はピンクでお願いします。\n\n【使用用途】\n・Vtuber活動でのSNS投稿やアイコン、ヘッダー\n・配信時サムネイル\n・GTARPサーバーゲーム内でのステッカー、アイコン等\n\n【その他】\nサムネイルで使用させていただきたいため、頭部や髪の毛・腕等が切れないようにしていただけますと幸いです。\n納品形式は可能でしたら人物・背景・宛名を分けたpsdデータもしくはpngでの納品だと大変助かります。\n\nお忙しいところ恐縮ですが、ご検討のほどどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hGJEmk4-IfreCfB7s9czfR5hfquMovSg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@faaanmt/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 278932, "client_id": 3219295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41a78da6/uploads/origins/23e41040-4dfe-459e-b527-fb72c6536362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf29191977a621c57849aca9d6f7d00", "srcset": "https://si.imgix.net/41a78da6/uploads/origins/23e41040-4dfe-459e-b527-fb72c6536362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf29191977a621c57849aca9d6f7d00, https://si.imgix.net/41a78da6/uploads/origins/23e41040-4dfe-459e-b527-fb72c6536362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbb0a40156cb53e917b7df0c1d316f32 2x, https://si.imgix.net/41a78da6/uploads/origins/23e41040-4dfe-459e-b527-fb72c6536362?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d22290553d190d3b1e25b76b5eeb143 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41a78da6/uploads/origins/23e41040-4dfe-459e-b527-fb72c6536362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e88bd94239bffb602fa2a6ce42d5a38d", "srcset": "https://si.imgix.net/41a78da6/uploads/origins/23e41040-4dfe-459e-b527-fb72c6536362?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=