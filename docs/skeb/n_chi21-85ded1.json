ます。\n　記載はしていませんが、身長125㎝になります。\n　●Twitter固定ツイート\n　https://twitter.com/nemuxre/status/1547576611259949056?s=21&t=QFIYiwUS1aiFZ1lVS4s05w\n　●誕生日イラスト（肩回りのデザイン参照用）\n　https://twitter.com/nemUxRe/status/1491064279973302275?s=20&t=CI61w1eadOcSBrCy17gRfA\n　※Twitter固定ツイートの2枚目の一番右側のショートヘアでも肩回りの服装の確認が可能です。\n　●スカートのデザイン\n　https://twitter.com/nemUxRe/status/1611372094507610112?s=20&t=CI61w1eadOcSBrCy17gRfA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n_chi21/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2587782, "client_id": 1309461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e4b2e3b/uploads/origins/50a19717-0bd3-4bcf-8421-07a72ae6a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2453919fe08a887c401baf7e923f586b", "srcset": "https://si.imgix.net/0e4b2e3b/uploads/origins/50a19717-0bd3-4bcf-8421-07a72ae6a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2453919fe08a887c401baf7e923f586b, https://si.imgix.net/0e4b2e3b/uploads/origins/50a19717-0bd3-4bcf-8421-07a72ae6a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd91c4c5db66b02a4baecf05ceedabcb 2x, https://si.imgix.net/0e4b2e3b/uploads/origins/50a19717-0bd3-4bcf-8421-07a72ae6a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f421af85340bc31db7430d979bec4e56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e4b2e3b/uploads/origins/50a19717-0bd3-4bcf-8421-07a72ae6a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73c543c98953dac10c767fc8c9a6cb4f", "srcset": "https://si.imgix.net/0e4b2e3b/uploads/origins/50a19717-0bd3-4bcf-8421-07a72ae6a19d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73c543c98953dac10c767fc8c9a6cb4f, ht