者。大柄で筋肉質。口が悪く人相が悪いが根は善人で面倒見が良い。動物が好き。色々あってマフィアの下っ端だったアガリを診療所兼自宅に住まわせている。振り回されてるが満更でもない。\n\n【構図など】\n銀鮫様のカラフルなパキッとした背景が好きなのと、九龍城砦のような中華風の街に住んでたので、それっぽい建物があると嬉しいです。\nそれ以外はお好きに描いていただいて大丈夫です！！服装に関してもそのままでも、全く違う服装でも構いません。\n良ければご検討いただきたく思います。\n\n【使用用途】\n主に観賞用ですが、私のほかに相方がSNSのアイコン・ヘッダーに使用する可能性があります。\n※その際はもちろん作者名を明記させていただきます。\n\nhttps://drive.google.com/drive/folders/1CV2Xr1bNZT2N_ZhJ2GcI96L6wsgGJpbk?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hyperbencher/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ae44d59c/uploads/origins/73691635-2089-4301-83e9-6c3bf572dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcd189970d6c1dc7ee619eb32dafa211", "srcset": "https://si.imgix.net/ae44d59c/uploads/origins/73691635-2089-4301-83e9-6c3bf572dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcd189970d6c1dc7ee619eb32dafa211, https://si.imgix.net/ae44d59c/uploads/origins/73691635-2089-4301-83e9-6c3bf572dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66fa0b65ec446902a74631dcc762b233 2x, https://si.imgix.net/ae44d59c/uploads/origins/73691635-2089-4301-83e9-6c3bf572dedd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=300cf00c3c45a0f67287a91c39b0252c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2602977, "client_id": 2499496, "nc": 0}, {"path": "/@hyperbencher/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2602977, "client_i