h=200&blur=200&s=4844b55e7747aee7f21d4e84e7aac6a5 3x"}, "body": "mieux filmです。 4回目の依頼になりました！！\n毎回素敵なイラストありがとうございます！\n今回は、新曲「夜のせい」のイラストのリクエストとなります。\n曲と歌詞をご連携いたしますので、銀鮫さんの方でご自由に考えていただきたいのですが、もし思いつかなかった場合は、イラストがURL先にありますので、参考にしていただければと思います。\nイラストの比率は16:9でおねがいいたします！\n\nまた、制作していただくイラストを前回同様ジャケ写に使用したいのですが、可能でしょうか。\n可能でしたら、イラストをトリミングした1:1の正方形のバージョンもいただけますととっても嬉しいです。\n\n どうぞよろしくお願いいたします！！\n\n歌詞、曲の音源（まだ完成版ではないですが・・・）、イラスト等はURL先にございます！\n\nhttps://drive.google.com/drive/folders/1a9Xshc0wN66Tbk_RgoSIPmJ0bWDwK_ya?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hyperbencher/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2602977, "client_id": 3468795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4fcff6b/uploads/origins/e61e5dfb-d291-407a-bf02-11002fd91585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928e7bbbf04033ce48d5cf72ba70ee5a", "srcset": "https://si.imgix.net/d4fcff6b/uploads/origins/e61e5dfb-d291-407a-bf02-11002fd91585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928e7bbbf04033ce48d5cf72ba70ee5a, https://si.imgix.net/d4fcff6b/uploads/origins/e61e5dfb-d291-407a-bf02-11002fd91585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74af86a7562609d15495f8b7ac613221 2x, https://si.imgix.net/d4fcff6b/uploads/origins/e61e5dfb-d291-407a-bf02-11002fd91585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d32872d0c74c482b7398db2b69e0c5a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4fcff6b/uploads/origins/e61e5dfb-d291-407a-bf02-11002fd91585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84782570983c52462fa8b7febb57ca4e", "srcset": "https://si.imgix.net/d4fcff6b/uploads/origins/e61e5dfb-d291-407a-bf02-