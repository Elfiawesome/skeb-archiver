い致します♩\n\nhttps://drive.google.com/drive/folders/12P5zIM9NRlRiqEnWaIPQ4LFjaUoRu0Zm", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1981232, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "電波障害", "screen_name": "denpawarukunai", "avatar_url": "https://pbs.twimg.com/profile_images/1914588133951463424/Cn7ZY6wg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1756700378576662529/1763663700/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 2474907, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "eco", "screen_name": "trpg_Ecology", "avatar_url": "https://pbs.twimg.com/profile_images/1734231775122264064/i6TaDk6I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1540859255510945794/1753442155/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 128}, {"id": 3123173, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "雲之助", "screen_name": "kumono", "avatar_url": "https://pbs.twimg.com/profile_images/971427320786399232/EeJdRmL3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/16420780/1520496941/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 3128982, "creator": true, "nsfw_acceptable