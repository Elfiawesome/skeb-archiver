ような性格。好きな人には愛想がいい。\n- アサのモチーフは深海とゴースト。\n- 手首と首の後ろに鎖をつけている。\n- 髪の毛は雲のように波打っている。\n- 下まつげが多い。\n- 赤いアイラインと赤いチークをしている。\n- 目の形はツリ目\n- お守りを持ち歩くこともあるが、それはオプション。\n- 彼のスーツケースは罠にかかった幽霊でいっぱいだ。\n\n背景は、以前のSKEBのそらしろ先生の作品のようにしたいです。自由に描いてください！\n\nできればPSDファイルもお願いします。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/10EtWTaqBBVfNhHTeEGCuMsJPqDE5U7w2", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemu59872413/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2046884, "client_id": 416486, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b024086/uploads/origins/c43ca79c-7873-42b7-b253-1b2d55334ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649dd4ffa42da63f546e1d4a8fe0a529", "srcset": "https://si.imgix.net/6b024086/uploads/origins/c43ca79c-7873-42b7-b253-1b2d55334ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=649dd4ffa42da63f546e1d4a8fe0a529, https://si.imgix.net/6b024086/uploads/origins/c43ca79c-7873-42b7-b253-1b2d55334ead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2389c36b0e8820c86294ca421610d453 2x, https://si.imgix.net/6b024086/uploads/origins/c43ca79c-7873-42b7-b253-1b2d55334ead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a6f4ff4c2fe345a20b70b99f0022714 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b024086/uploads/origins/c43ca79c-7873-42b7-b253-1b2d55334ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830091aa832ac05cc6044832e5e580fc", "srcset": "https://si.imgix.net/6b024086/uploads/origins/c43ca79c-7873-42b7-b253-1b2d55334ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=830091aa832ac05cc6044832e5e580fc, https://si.imgix.net/6b024086/uploads/origins/c43ca79c-