ate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3925001, "client_id": 326249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddb4c5e074b4d024a06ebae36050365a", "srcset": "https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddb4c5e074b4d024a06ebae36050365a, https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0c65f195ae922a54696d46bdbf92688 2x, https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c8daaadbb72328a3e82b1b8d2b7b31d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6338699b3809b89d9d2509e62596e743", "srcset": "https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6338699b3809b89d9d2509e62596e743, https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32446bc43873d10703b8bf247e0a30e8 2x, https://si.imgix.net/86e55ca9/uploads/origins/5fb141e8-6fe6-417e-be36-ede570ed5a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99c2ea2c5862d3b1d280346ee156f119 3x"}, "body": "こんにちは、先生！お会いできて光栄です。\nOCのイラストをリクエストすることは可能でしょうか？カラーでも、モノクロの鉛筆風（Twitterに投稿されているようなスタイル）でもどちらでも大歓迎です。先生の描かれる雰囲気がとても好きなので、そのようなタッチで描いていただけたら嬉しいです～\n\n物語の舞台はファンタジー世界です。   \n\nNormad: 18歳の少年。身長179cm。太い眉毛と素直で子犬のような目が特徴。自分に厳しく厳しいが、友人（特にアルタラ）には温かく優しい。アルタラとは幼なじみ。ノーマッドはアルタラへの想いが家族以上のものであることを知っている。アルタラがより大きな運命に執着していることを知っているため、ノーマッドはアルタラに自分の気持ちを打ち明けず、アルタラのそばにいてアルタラのために身を捧げることに喜びを感じている。ノーマッドは過剰なまでの自己犠牲の美徳を持ち、強い道徳的良心も持っている。\n趣味はガーデニング。  \nノーマッドは、マールヴォス（アルタラのカラスの使い魔）が甘やかされるのが大好きだと知っているので、時々彼のために可愛いリボンやボンネットを作ってあげる。\n*ノーマドは耳が長めです。\n\nAltara：思いやりがあり好奇心旺盛な16歳の少年。銀髪・銀色のまつ毛を持ち、柔らかな形の紫の瞳をしています。身長は171cmです。  \n彼は伝説に語られる「紫瞳の魔法使い」で、四大元素すべての魔法を扱えると言われていますが、現段階では力をうまく制御できません。そのため、魔力を抑制するために右手に4つの指輪を着けています。現在は仲間たちと共に、他の四つの種族が治める王国へ旅をしており、元素魔法を正しく使いこなせるようになることを目指しています。   \n紫瞳の魔法使いの力は、生まれつき極端な欲望に突き動かされる性質を持っています。 それは両刃の剣のように、持ち主を救世主へ押し上げることもあれば、同時に破滅・狂気へと導き、やがて最も大切な存在さえも自らの手で壊してしまうことがあります。\nAltaraも例外ではありません。彼の心の奥底には、貪欲で傲慢で、欲望に飢えた落ち着きのない一面が潜んでいます。彼はその部分を認めようとせず、必死に抑え込み、いつか消えてなくなることを願っています。\n\n\n自由に描いてください！ \nご配慮ありがとうございました> <❤️\n\nhttps://drive.google.com/drive/folders/1-_qZdBiVePV8nzgM3PQsl8YW2mZ7xrCF", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ix_freesia/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3925001, "client_id": 2995541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/baab9417/uploads/origins/7aa31df8-ed77-4372-9965-deaaff9e34ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b42eb98e9a9cd83d2f57a3b9cfbcf344", "srcset": "https://si.imgix.net/baab9417/uploads/origins/7aa31df8-ed77-4372-9965-deaaff9e34ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b42eb98e9a9cd83d2f57a3b9cfbcf344, https://si.imgix.net/baab9417/uploads/origins/7aa31df8-ed77-4372-9965-deaaff9e34ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=959b2d8a6ca383ed0d84151b3a56f7ce 2x, https://si.imgix.net/baab9417/uploads/origins/7aa31df8-ed77-4372-9965-deaaff9e34ad?bg=%23fff&auto=format%2Ccom