せん\n\n金額が足りない場合や資料に不備があれば再送申請して頂けたら助かります。\nよろしくお願いいたします🎀ིྀ\n\n【キャラクターシート】\n※1部ネタバレ有り、未通過の場合は現行未通過‪✕‬の記載があるメモは開かないようにしてください\n\nhttps://iachara.com/view/11818601", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaq1k/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3340832, "client_id": 3692649, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac91155d/uploads/origins/6d1b462b-9043-4cfb-8777-62c98b75f186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48e708dbc1b2aecc60670f1353c70078", "srcset": "https://si.imgix.net/ac91155d/uploads/origins/6d1b462b-9043-4cfb-8777-62c98b75f186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48e708dbc1b2aecc60670f1353c70078, https://si.imgix.net/ac91155d/uploads/origins/6d1b462b-9043-4cfb-8777-62c98b75f186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79d24e040278f117bf272cd6420f5124 2x, https://si.imgix.net/ac91155d/uploads/origins/6d1b462b-9043-4cfb-8777-62c98b75f186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4ee613b23f392394af9fcfbc072a9d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac91155d/uploads/origins/6d1b462b-9043-4cfb-8777-62c98b75f186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7e144a434eaf2142671eaa6f4567ec3", "srcset": "https://si.imgix.net/ac91155d/uploads/origins/6d1b462b-9043-4cfb-8777-62c98b75f186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7e144a434eaf2142671eaa6f4567ec3, https://si.imgix.net/ac91155d/uploads/origins/6d1b462b-9043-4cfb-8777-62c98b75f186?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26fa9b581c48b6e8b425e69d74de7747 2x, https://si.imgix.net/ac91155d/