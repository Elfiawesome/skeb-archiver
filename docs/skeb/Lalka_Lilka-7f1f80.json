て旅をしています。\n\n全体の雰囲気、衣装等は資料画像を参照してください。\n黒髪の方はセットの神様です。\n資料画像はすべて依頼使用許可・規約確認済みです。\n\n◆希望\n普段は黒や紫ベースのお姉さん系の衣装ですが、青花の魔女さんシリーズが大好きなので可能であればフリルやリボンをあしらった少し可愛らしい魔女さんテイストの衣装で、クレマチスの花と描いていただけると嬉しいです。\n配色、構図、表情などは全てお任せ致します。\n資料画像の衣装でももちろん大歓迎です！\n描きやすいように自由にアレンジしてください。\n可能であればラフ案や没案等を残して頂けるととても嬉しいです。\n\n\n金額不足含め内容に不都合な部分がありましたら遠慮なくキャンセル、再送要請をお願い致します。\n急に寒くなりましたので体調を第一にお過ごしください。\nこれからも応援しております。\n\nhttps://drive.google.com/drive/folders/13lkQcUO2trWMoNTOvHwB7AqZmAFOEkxV", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Lalka_Lilka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3716277, "client_id": 1920721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24ad23cc/uploads/origins/03185447-09f0-46d0-9d19-dfd879dd70e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=183653f7d71f35d30457e67b18b42dd0", "srcset": "https://si.imgix.net/24ad23cc/uploads/origins/03185447-09f0-46d0-9d19-dfd879dd70e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=183653f7d71f35d30457e67b18b42dd0, https://si.imgix.net/24ad23cc/uploads/origins/03185447-09f0-46d0-9d19-dfd879dd70e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb11207414e3183c9968843d9bc8a670 2x, https://si.imgix.net/24ad23cc/uploads/origins/03185447-09f0-46d0-9d19-dfd879dd70e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9299fc52c084d709c2ce2af2a1b2ee4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24ad23cc/uploads/origins/03185447-09f0-46d0-9d19-dfd879dd70e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b7c36a087754b8a9ef926b149546ced", "srcset": "https://si.imgix.net/24ad23cc/uploads/origins/03185447-09f0-46d0-9d19-dfd879dd70e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop