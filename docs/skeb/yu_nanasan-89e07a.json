-52c9-48c6-8b47-5188746c12e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c4e02b9f71b89bd049843ffec57f0da, https://si.imgix.net/80ee1408/uploads/origins/4854d2c0-52c9-48c6-8b47-5188746c12e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4caa47f8393b07c36de1a8bdfff3363b 2x, https://si.imgix.net/80ee1408/uploads/origins/4854d2c0-52c9-48c6-8b47-5188746c12e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bad417de3261cd72b525c683697e02f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80ee1408/uploads/origins/4854d2c0-52c9-48c6-8b47-5188746c12e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64512785c1b920e700455af31cbfbce9", "srcset": "https://si.imgix.net/80ee1408/uploads/origins/4854d2c0-52c9-48c6-8b47-5188746c12e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64512785c1b920e700455af31cbfbce9, https://si.imgix.net/80ee1408/uploads/origins/4854d2c0-52c9-48c6-8b47-5188746c12e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9a29497a712f0cc5375c05b1638dadc 2x, https://si.imgix.net/80ee1408/uploads/origins/4854d2c0-52c9-48c6-8b47-5188746c12e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af39a7dd067accc1ab01da2a083c4b5d 3x"}, "body": "ユウ7先生初めまして、skebにてとても素敵なイラストだなと思った為リクエストさせて頂きました♩\n当方のOCを書いて頂きたいです💎\n\n【構図等】\n構図・表情等はおまかせ致します。\n衣装については下記に記載させていただきます。\n描写範囲の方は全身に近い物だと嬉しいですがお好きにしていただいて構いません。\nまた、背景の方は有りましたら非常に嬉しいです。\n\n【容態等の中で特殊な点】\n・モチーフ：白色ヤモリの妖精\n・性別：♂︎︎ ♀(雌雄同体)の為大きすぎる胸等はNG\n・ヘッドホン\n・歯・耳・爪\n・アイメイク\n・ピアス・フェイスピアス\n・妖精の為地面から浮く事が可能\n・ヤモリの特性があるためまばたきを滅多にしない\n・武器：タンザナイトの宝石＋黒羽の杖又はタンザナイトの双杖\n\n《衣装》\n記載のものを希望しています。\n過去の容姿・現在の容姿のどちらでも構いません。\n\n【使用用途】\nアイコンやSNSでの投稿等個人使用のみ(非商用)\n\n【ファイル形式】\n特に指定はございません\n背景のある場合人物のみも頂けたら嬉しいです。\n\n【参考資料】\n詳細イラストがございます\n参考にして頂けましたらと思います\n\n【その他】\n参考程度に性格等を記載させていただきます。\n\n・宝石が大好き。お金も時間も長い生涯のその殆どを宝石に費やしている。\n・感情の起伏が乏しく見えるが実際はそんなことは無い。戦闘スキルは頭1つ抜けている。\n得意な魔法は氷系。ものづくりの魔法も得意\n・誕生色：ブライト・アクア\n優しさと力強さを併せもつ創造者\n・イメージカラー：白縹(しろはなだ)\n\nお忙しいところ恐縮ですがご検討いただけますと幸いです。\n\n【キャラクター詳細】\nhttps://drive.google.com/file/d/15pWAdZOIYrM_utsaEObEl08gqMadjbaq", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yu_nanasan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3167848, "client_id": 1231709, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ecffa76/uploads/origins/3cf84b2a-b305-44be-bf18-ca44458cafac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b02da15e6f67c318b22f8afc59fae10", "srcset": "https://si.imgix.net/2ecffa76/uploads/origins/3cf84b2a-b305-44be-bf18-ca44458cafac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b02da15e6f67c318b22f8afc59fae10, https://si.imgix.net/2ecffa76/uploads/origins/3cf84b2a-b305-44be-bf18-ca44458cafac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=321d97904a8c68b6460746234572f89c 2x, https://si.imgix.net/2ecffa76/uploads/origins/3cf84b2a-b305-44be-bf18-ca44458cafac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf6791591d196946a8a6b4f01769c2d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ecffa76/uploads/origins/3cf84b2a-b305-44be-bf18-ca44458cafac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5030b0fae0a58974d349fd36aa398de1", "srcset": "https://si.imgix.net/2ecffa76/uploads/origins/3cf84b2a-b305-44be-bf18-ca44458cafac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5030b0fae0a58974d349fd36aa398de1, https://si.imgix.net/2ecffa76/uploads/origins/3cf84b2a-b305-44be-bf18-ca44458cafac?bg=%23fff&auto=