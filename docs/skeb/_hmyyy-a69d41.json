のリクエストは初めてですが、作業期間やお値段などお気軽にお願いします。ありがとうございます！\n\n※ もし私が提示した価格が足りないと思ったらキャンセルしたら余裕がある線でもう一度申請します... (;-;)", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_hmyyy/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2394333, "client_id": 2545687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3106a7de15eaf894d75e30f7dc37c780", "srcset": "https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3106a7de15eaf894d75e30f7dc37c780, https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d43d29f6335e0ca1566af0629d51434 2x, https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a098e983dd6f5fbe2afd18163196bc3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d484da34f7328036de6c6f074b4aca7d", "srcset": "https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d484da34f7328036de6c6f074b4aca7d, https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc859d9dbe0055795dad09cd361ccee1 2x, https://si.imgix.net/01802058/uploads/origins/14adeb5e-b828-4a12-b212-31adb5c7c98a?b