大変嬉しいです。 可能であれば、1920x1080または1080x1920以上のイラストに加え、背景が透明で人物が見えるPNGファイルもいただけると大変ありがたいです！ https://imgur.com/a/sJevv9V https://imgur.com/a/sJevv9V", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tuyu_haruki_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2762472, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9043199/uploads/origins/3ee83e82-41be-4b7e-992e-79336c5c8a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f884db48c7e68c3f35c2a4bab10a99e0", "srcset": "https://si.imgix.net/f9043199/uploads/origins/3ee83e82-41be-4b7e-992e-79336c5c8a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f884db48c7e68c3f35c2a4bab10a99e0, https://si.imgix.net/f9043199/uploads/origins/3ee83e82-41be-4b7e-992e-79336c5c8a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa25c8c745332dbd86585cb4ead885ad 2x, https://si.imgix.net/f9043199/uploads/origins/3ee83e82-41be-4b7e-992e-79336c5c8a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddaa56d0dde4a96d556a1bd25ebee7f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9043199/uploads/origins/3ee83e82-41be-4b7e-992e-79336c5c8a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7e35e14aa2ff913462fd8508d6c6326", "srcset": "https://si.imgix.net/f9043199/uploads/origins/3ee83e82-41be-4b7e-992e-79336c5c8a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7e35e14aa2ff913462fd8508d6c6326, https://si.imgix.net/f9043199/uploads/origins/3ee83e82-41be-4b7e-992e-79336c5c8a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1dcce82c86cedd0a6f3de04e123fa8b9 2x, https://si.imgix.net/f9043199/uploads/origins/