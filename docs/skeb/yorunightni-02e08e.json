=crop&crop=top&w=200&h=200&s=c5d45e302030d99caa6f011e4c225aab 2x, https://si.imgix.net/48ef5614/uploads/origins/35572e10-7413-4490-af0b-3543070fc15f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7737147fbe1452888f8b93cfecc1f03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48ef5614/uploads/origins/35572e10-7413-4490-af0b-3543070fc15f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c75f63aca7ab08440058731f83952b54", "srcset": "https://si.imgix.net/48ef5614/uploads/origins/35572e10-7413-4490-af0b-3543070fc15f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c75f63aca7ab08440058731f83952b54, https://si.imgix.net/48ef5614/uploads/origins/35572e10-7413-4490-af0b-3543070fc15f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8e574a63e57320d6e88135064943464 2x, https://si.imgix.net/48ef5614/uploads/origins/35572e10-7413-4490-af0b-3543070fc15f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f34e190ebd323fc51ed5ece519d260f 3x"}, "body": "なつお様\n\n個人VTuberとして活動している中岡なあかと申します。 \n以前からなつお様のイラストを拝見しており、この度Skebを開設されたとのことでぜひ私のイラストも描いていただきたいと思いリクエストさせていただきます！\n絵本みたいなやわらかな雰囲気の世界観とミニキャラがかわいくすごく好きです…！\n\n▶本人情報\n中岡なあか\nX：https://twitter.com/7naaka\n\n▶使用用途 \n・YouTubeのOP/ED、XやFANBOXでの告知目的での利用\n\n※可能でしたら使用させていただきたいもの\n・収益の発生しないネットプリント、壁紙配布（使用NGの場合お伝えいただければ幸いです…！）\n\n▶リクエスト内容\n・GIFアニメーション（+静止画）\n・資料URLを参考に、通常衣装or和装衣装お好きな方で制作してください\n・横1920×縦1080サイズで制作していただけると助かります\n・雰囲気はなつお様におまかせします！人物像を掴みづらい場合は以下に好きなものを羅列するので参考になりましたら幸いです。\n（好きなもの：チル系のゲーム、ケーキとお肉、お菓子、食べること、楽しいこと、おもしろいこと、くまやうさぎ、かわいいもの、シルバニアの赤ちゃん、お花、黄色）\n\n↑リクエスト内容が多くなってしまいましたが上記すべて必須ではありません！\n可能な範囲で反映していただきご自由に描いていただけると幸いです…！\n\n何とぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1v1Sqf-VZ-zIVu2QP2YJ7Ti9gT8M9PNIP?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorunightni/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3338508, "client_id": 1907471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fda56cc32e34a0eaae08c96ef3cbd726", "srcset": "https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=fda56cc32e34a0eaae08c96ef3cbd726, https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=fead4ca96f4f51335e3f594bf29e8f02 2x, https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=be8c964a1e6cf84ab66e29145f533ac3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e3cbc7b44781db1e405796bd50bb319f", "srcset": "https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e3cbc7b44781db1e405796bd50bb319f, https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be1fbddc3fc0a03f44731d5c79d1112a 2x, https://si.imgix.net/2ffaf7a1/uploads/origins/e9ad7c0c-6b7e-4569-85a4-2ad6c7dbad2c?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02f6acb520a14fea6e550ce9cc814215 3x"}, "body": "なつお 様\n\nいつもぬくもりと優しさの溢れる作品を拝見しております。\n個人鑑賞用として私のOCを描いていただきたく、リクエストを送信させていただきます。\n\n添付資料のキャラクターが花々に水やりをしている様子を描いていただけないでしょうか。一枚絵とGIFアニメーションのどちらを制作いただくかはお任せさせていただきたいです（簡単なGIFアニメーションのお値段の相場がわからず…! 申し訳ありません🙇）。\n\n服装は改変していただいても問題ありません。ポーズ・構図なども特に指定はございませんが、可能であれば以下から取り込めそうな要素を入れていただけると大変嬉しいです。\n\n・ヒルザキツキミソウ（私の創作において特に大切にしている品種の花です。）\n・蝶\n・リボン\n・白いフリル\n・淡いラベンダーカラー\n\n（添付資料にもあるOCについての補足：ヤギやうさぎのような耳を持っています。これといって名付けることのできる品種や名前のない子です。表情豊かでよく泣いたり笑ったりしますが、声はありません。）\n\n——\n\n画像のサイズ / 比率 / 解像度などはおまかせいたします。\nファイル形式はPNG、またはGIFファイル、PSDファイルでいただけますと幸いです（PSD形式での納品が難しい、もしくはその必要がない場合はご放念ください）。\n\n参考資料URL：\nhttps://drive.google.com/drive/folders/1-Inf8aKK-1cm2CW1K2KsTSLEYwndFEFf\n\n\nご検討のほど何卒よろしくお願いいたします。\n\ncute_my_rabbit\n\nhttps://drive.google.com/drive/folders/1-Inf8aKK-1cm2CW1K2KsTSLEYwndFEFf", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1741279, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "次之B🦖", "screen_name": "tugino_666", "avatar_url": "https://pbs.twimg.com/profile_images/1745745838905995264/eL1f9bO2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3052004005/1664545195/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "nc": 33}, {"id": 2043073, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "3punkyouさんぷ", "screen_name": "3kumini", "avatar_url": "https://pbs.twimg.com/profile_images/2025058371632857089/HDbhaHrd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1523188515181572098/1752205654/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2063771, "creator": true, "nsfw_acce