68-ac6f-94a353120e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8536c7a95a9ca685ba470472f16cda79, https://si.imgix.net/cf51696b/uploads/origins/690ed4f6-68e5-4168-ac6f-94a353120e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7eb507bd9deab99f5607fa742d8e1432 2x, https://si.imgix.net/cf51696b/uploads/origins/690ed4f6-68e5-4168-ac6f-94a353120e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8f6d31ddaa6210a83a5f6901a9becde 3x"}, "body": "私の二人の忍者少年キャラクター、ミストとレイヴンを描いていただけませんか？参考資料は以下に添付します。\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link\nオレンジのミスト（17歳）は比較的穏やかで口数が少なく、青のレイヴン（16歳）は外向的で少々やんちゃな性格です。2人は幼い頃からバトルパートナー。\n2人のポーズややりとりは自由に描いてください！すべてはあなたの自由です。彼らの戦闘姿勢を描いてもいいし、どこか心地よい場所で休んで寄り添っている姿を描いてもいい。あなたの画風で少年たちを描いてほしい。\nごゆっくりお楽しみください！\n\nhttps://drive.google.com/drive/folders/1QBrm3u6P2jLlAwK3lKpkJ57MRLH-T4zf?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorunightni/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3338508, "client_id": 3227349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ecdb06389e97897ea8f5eee2ab9709c9", "srcset": "https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=ecdb06389e97897ea8f5eee2ab9709c9, https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=818abbb20055bed22b038dbf8e8c4b35 2x, https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e025056627d4c31e35eb53b717ad5af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c03f5e7db844d6f34a62903b7ef1d7c6", "srcset": "https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=c03f5e7db844d6f34a62903b7ef1d7c6, https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ceb5359cf845ab7a4e5e05d1b33830d 2x, https://si.imgix.net/db38be8c/uploads/origins/d8c0920a-bb54-4e49-923d-364ad8601747?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d71b447a8ce725123dbbefbc1ce91f54 3x"}, "body": "初めまして、藍染アメリと申します。\n絵本風なイラストを探していた所、なつお様の描く可愛らしい絵柄が目に留まり是非ご依頼したいなと思いリクエストをお送りしました。\n\n個人Vtuberとして活動しており、そのオリジナルキャラクターを描いて頂けたらなと思っております。\n\n＜キャラ参考資料＞\n\n立ち絵（固定ツイ）\nhttps://x.com/aizomeameri105\n動いた様子（お披露目時の配信になります）\nhttps://www.youtube.com/watch?v=tcYhQ7NVUZc\n\n★性格・特徴\n・見た目はオオルリアゲハをメインモチーフにした衣装を着ています。\n・声は穏やかなタイプですが、性格は負けず嫌いで脳筋。\n\n＜キャラ資料補足＞\n後ろの髪型はハーフアップに大きな蝶風のリボンがついているイメージです。\nパピヨン（犬）の耳をモチーフにしているので、蝶型ですが周りが少しギザギザしてます。\n腰付近に大きめのリボンがついています。\n\n-----------------------------------------------------------------\n\n＜お願いしたいポーズ・構図＞\n\n・背景\nなつお様にお任せ\n\n・ポーズ\nアフタヌーンティーのようなテーブルにお菓子・デザートがあるイメージで\nキャラクターは椅子に座って紅茶を飲んでいるイメージです。\nアフタヌーンティーはガーリーっぽい雰囲気があると嬉しいです。\n\n※背景については、キャラクターに合うイメージ背景やモチーフデザイン等でまとめて頂いても大丈夫でございます。作業のご負担にならないよう無理のない範囲でご調整頂けると幸いです。\n\n\n＜サイズとデータについて＞\nもし対応可能であればGIFアニメーション（+静止画）でお願いさせて頂きたいなと思っております。\nyoutubeの配信にて待機画面等で使用させて頂きたく「16:9」（1920px×1080px）でご制作をお願いいたします。\n\n\n\n※三面図等がまだない為、衣装で見えない部分や構造がわからない部分については\nなつお様の解釈でデザインを調整頂いて大丈夫です。\n\n\n\n＜使用用途＞\n・youtube配信においての待機画面に使用します。\n・その他、個人で活動する上でSNSやyoutube（収益化済み）でのサムネ・アイコンなどで使用致します。\n・ネットプリントを利用し、ファンの方へイラストをプレゼントする場合がございます。\n（こちらは収益等は発生せず、個々でプリントして頂き楽しんで頂く形となります）\n\nそれではご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorunightni/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3338508, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1f2f54969b999328bf9f722119dcb92", "srcset": "https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1f2f54969b999328bf9f722119dcb92, https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=185260be30bfd55ea4075bdea824d76f 2x, https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a80d7af4dc568e1d17880f9fade7da5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2253fce3562d25b5e9f15307ddc2c7e6", "srcset": "https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2253fce3562d25b5e9f15307ddc2c7e6, https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdb8e73ab27b1664d17dfa2658838c26 2x, https://si.imgix.net/abc9507d/uploads/origins/63d93b36-c781-4958-9a96-81c077fd77af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4af03b262343efd2f3c2fc6fca835c62 3x"}, "body": "初めまして。可愛らしく温かい作風が素敵で、リクエストさせて頂きました。\nご確認ご検討お願い致します。\n\n■キャラクター\n資料の２名をお願いしたいです。\n自作ゲーム（ファンタジーRPG）のキャラクターで、小さいけれど活気のある山間の田舎町に住む青年たちです。たまに冒険したりもします。\n衣装で分かり難いところなどはアレンジしていただいて大丈夫です。\n\n・グレー\n22歳、172センチ、普通体型。\n髪はグレー、瞳は赤の吊り目。\n主人公。町長の息子、且つ生真面目で、町や親友のために行動することを当然と思っています。\n町長の息子としての世間体を守りつつも、親友や民を守るために必要とあらばルールをすり抜ける柔軟性もあります。\n弓使いで、森で狩りをしたりもします。\n\n・赤紫\n22歳、172センチ、痩せ型。\n髪は赤紫、瞳は緑でぱっちりしています。\n貧しい家の長男で忙しく働いていますが、前向きで明るい青年です。\nトラブルに巻き込まれがちな不運体質。\n人前ではしっかりしていますが、親友の前でだけは長男の重荷を下ろして気まま甘えたに振る舞うこともあります。\n\n■シチュエーションなど\nゲーム中に、彼らが裏庭で猫の面倒を見るシーンがあるのですが、そのイメージをお願い出来ればと思います。\n猫は赤紫髪の資料にいる長毛種です。赤紫髪の子には懐いていて甘えん坊、グレーの子には警戒心が強く威嚇したりします。参考にゲーム中のスクショも同梱しています。\n他に何か思いついたものがありましたら、上記は気にせず自由に描いて頂けたらと思います。\n\n■利用用途\n個人観賞です。\n\n以上、ご検討お願い致します。\n\nhttps://drive.google.com/drive/folders/1d-3ixbGC6FfMLuhon-wBkS2kfevGScSO?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yorunightni/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3338508, "client_id": 2005344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7b6b614/uploads/origins/b97418ce-90b9-4382-b052-a7d18ea891d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27edcdd1d8d20947e7afc52fb1666c0f", "srcset": "https://si.imgix.net/c7b6b614/uploads/origins/b97418ce-90b9-4382-b052-a7d18ea891d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27edcdd1d8d20947e7afc52fb1666c0f, https://si.imgix.net/c7b6b614/uploads/origins/b97418ce-90b9-4382-b052-a7d18ea891d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29651093510f707e527a7b881dec249d 2x, https://si.imgix.net/c7b6b614/uploads/origins/b97418ce-90b9-4382-b052-a7d18ea891d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=