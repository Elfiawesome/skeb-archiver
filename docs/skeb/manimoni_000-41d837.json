06e\u3093\u3073\u308a\u3068\u3057\u305f\u96fb\u6ce2\u7cfb\u306e\u5c11\u5e74\u3067\u3059(\u1422\u1d16 \u00b7\u032b \u1d16\u1422)\n\n\u3010\u4e8c\u4eba\u306e\u95a2\u4fc2\u6027\u3011\n\u666e\u6bb5\u306f\u843d\u3061\u7740\u3044\u3066\u3044\u308b\u6c17\u3082\u3001\u671d\u306e\u524d\u3067\u306f\u81ea\u7136\u3068\u8a00\u8449\u304c\u591a\u304f\u306a\u308a\u3001\u5b50\u4f9b\u3063\u307d\u3044\u4e00\u9762\u3092\u898b\u305b\u307e\u3059\u3002\u672c\u97f3\u3092\u5197\u8ac7\u306b\u8fbc\u3081\u305f\u308a\u3001\u8efd\u3044\u53e3\u55a7\u5629\u3092\u3057\u305f\u308a\u3001\u6642\u306b\u306f\u3064\u3044\u7518\u3048\u304c\u51fa\u3066\u3057\u307e\u3046\u3053\u3068\u3082\u3002\u305d\u3093\u306a\u6c17\u306e\u59ff\u3092\u3001\u671d\u306f\u3044\u3064\u3082\u304b\u3089\u304b\u3046\u3088\u3046\u306a\u512a\u3057\u3044\u7b11\u9854\u3067\u53d7\u3051\u6b62\u3081\u3066\u3044\u307e\u3059\u3002\u3053\u306e\u300c\u666e\u6bb5\u3068\u306e\u30ae\u30e3\u30c3\u30d7\u300d\u3053\u305d\u304c\u3001\u4e8c\u4eba\u306e\u7279\u5225\u306a\u95a2\u4fc2\u6027\u3092\u8868\u3057\u3066\u3044\u307e\u3059\u3002\n\n\u3010\u30b7\u30fc\u30f3\u306b\u3064\u3044\u3066\u3011\n\u653e\u8ab2\u5f8c\u3001\u4e8c\u4eba\u304c\u4e00\u7dd2\u306b\u8857\u3092\u6b69\u3044\u3066\u3044\u308b\u60c5\u666f\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u305f\u3089\u5b09\u3057\u3044\u3067\u3059\uff01\n\n\u30a4\u30e1\u30fc\u30b8\u306e\u30dd\u30a4\u30f3\u30c8\uff1a\n\n\u00b7 \u6642\u9593\u306f\u5915\u65b9\u524d\u3001\u7a7a\u306f\u660e\u308b\u3044\u6c34\u8272\u3067\u3001\u3075\u3093\u308f\u308a\u3068\u3057\u305f\u96f2\u304c\u6d6e\u304b\u3076\u6674\u308c\u305f\u65e5\u2601\ufe0f\ud83d\udc99\n\u00b7 \u80cc\u666f\u306f\u65e5\u5e38\u7684\u306a\u8857\u4e26\u307f\uff1a\u5546\u5e97\u8857\u306e\u5165\u53e3\u3084\u4f4f\u5b85\u8857\u306e\u6b69\u9053\u306a\u3069\u304c\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f\uff08\u5c11\u3057\u30ec\u30c8\u30ed\u306a\u611f\u3058\u3082\u53ef\u611b\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\uff01\uff09\n\u00b7 \u4e8c\u4e