8c2\u3051\u305f\u8de1 + \u30ea\u30f3\u30b0\u30d4\u30a2\u30b9 2\u500b\n\n\u59ff\u52e2\u306f\u4e8c\u4eba\u306e\u8863\u88c5\u304c\u3088\u304f\u898b\u3048\u308b\u3082\u306e\u3067\u81ea\u7531\u306b\u304a\u9858\u3044\u3057\u307e\u3059\u3002(\u4ef2\u304c\u3088\u304f\u306a\u3044\u3067\u3059)\n\n\u5f1f\u306eOC\u306f\u8cc7\u6599\u304c\u3042\u307e\u308a\u306a\u304f\u3066\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u3002 \u8863\u88c5\u306f\u304a\u4e92\u3044\u306b\u9055\u3046\u306e\u3067\u753b\u50cf\u3092\u6dfb\u4ed8\u3057\u307e\u3057\u305f\u3002\u4e0b\u624b\u3067\u3059\u304c\u8aad\u3093\u3067\u304f\u3060\u3055\u3063\u3066\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002\ud83d\ude2d\ud83d\ude47\u200d\u2640\ufe0f\n\n+ \u305f\u3044\u3078\u3093\u5931\u793c\u3057\u307e\u3057\u305f\u3002 OC\u306e\u8863\u88c5\u3092\u5909\u66f4\u3057\u307e\u3057\u305f\u3002 \u3054\u8003\u616e\u3044\u305f\u3060\u304d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u00b7\u00b7\u00b7!\ud83d\ude2d\u8cc7\u6599\u3068\u5168\u304f\u540c\u3058\u3088\u3046\u306b\u3059\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002 \u81ea\u7531\u306b\u4f5c\u696d\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\nhttps://drive.google.com/drive/folders/1--2yCTRGEPs-zBQaG0mPNTQmTRoKQNX7", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuhakuchi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2761601, "client_id": 2943476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a87f2cd/uploads/origins/8496ca36-3ece-43a8-a067-7e308174c541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2c2af0837f33f8d4aba8b8694c6b57d", "srcset": "https://si.imgix.net/3a87f2cd/uploads/origins/8496ca36-3ece-43a8-a067-7e308174c541?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2c2af0837f33f8d4aba8b8694c6b57d, https://si.imgix.net/