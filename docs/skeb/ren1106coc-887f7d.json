し後ろにクロスしている。\n\n③その他ご要望\n・髪型について、後ろ髪を首元あたりで毛先を残すタイプのお団子を作る感じで結えています。\n・表情差分として、後ろ髪を下ろしている状態(表情変化なし)の追加制作を希望しております。\n\n[参考用キャラクターシート]\nhttps://iachara.com/sns/3569908/view", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 684693, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ヒルチョルソン", "screen_name": "httrpg", "avatar_url": "https://pbs.twimg.com/profile_images/1453281060020703235/AQH_La5r.jpg", "header_url": "https://pbs.twimg.com/profile_banners/970039808717340672/1660944882/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1039215, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ダニ", "screen_name": "2da_ni", "avatar_url": "https://pbs.twimg.com/profile_images/1801186349812498432/N_7GdzLp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1280873203053690882/1766270060/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1241113, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あさひまままま/新規卓❌", "screen_name": "asatohima88", "avatar_url": "https://pbs.twimg.com/profile_images/1615683580818259968/7WQs66MM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1359438095356108808/1657729317/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genr