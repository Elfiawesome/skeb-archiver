andsome\n\nI hope you can refer to the tweet I attached to the URL for the character design!\nThe gender of the character is female, but I hope you will recognize that her frame is as large as a man's...!\n(You can change the costume to make it easier to draw!)\n\nI would like to use it as an icon or thumbnail if possible!\nThank you very much!\n\nhttps://twitter.com/MGA_piece/status/1620436759485026311?s=20&t=td2wkRuMnn04LF7WNlYlfA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pngnpon/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 110882, "client_id": 818333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c369f708/uploads/origins/fedb734f-36e1-4a03-9f77-aa322abbb52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad8a7679a02cd3d14c9e012d4555d6d4", "srcset": "https://si.imgix.net/c369f708/uploads/origins/fedb734f-36e1-4a03-9f77-aa322abbb52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad8a7679a02cd3d14c9e012d4555d6d4, https://si.imgix.net/c369f708/uploads/origins/fedb734f-36e1-4a03-9f77-aa322abbb52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9887db8b2af28ff669640430bf626f4 2x, https://si.imgix.net/c369f708/uploads/origins/fedb734f-36e1-4a03-9f77-aa322abbb52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64eb57ab37b28fd135997d2a6e2c59ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c369f708/uploads/origins/fedb734f-36e1-4a03-9f77-aa322abbb52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=333e49ede2a55bad73cbb071c40cc83f", "srcset": "https://si.imgix.net/c369f708/uploads/origins/fedb734f-36e1-4a03-9f77-aa322abbb52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=