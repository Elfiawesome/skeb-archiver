cm\n・モチーフ：春風／木枯\n・関係性：同い年・同僚・相棒・幼馴染 \n・基本の服装は黒スーツ\n・猫耳としっぽ、頭に輪っかあり\n・カナタ……思慮深く心優しい苦労人。歳の離れた妹がいる。糸目。\n・アーラン……慇懃無礼な奇人。カナタに雑に懐いている。\n・ふたりは特殊任務を共にこなす同僚で、信頼し合っています。\n\n・絵の用途……SNSのアイコン、ヘッダーや個人観賞用のグッズ制作など。商用利用は行いません。\n\n\nうがや様の世界観で自由に表現していただけたら嬉しいです。構図など全てお任せいたします！\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-jMvUrcoEX_42P1tn5WzaM4c5fg40hHy", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 6874, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "西瀬さめ", "screen_name": "3dsamechan", "avatar_url": "https://pbs.twimg.com/profile_images/1497240781320785927/Tle7nVIm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/965540149105909760/1614362024/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 668506, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "7", "screen_name": "nnkxxxx7", "avatar_url": "https://pbs.twimg.com/profile_images/2037043869603553283/I1UvNwRJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1798130314449162240/1740844656/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 1}, {"id": 778206, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "파 11/4停止します", "screen_name": "oh_misstake", "avatar_url": "https://pbs.twimg.com/profile_images/1551029481933926401/FGVH81oN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1229306054527180800/1633029409/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "re