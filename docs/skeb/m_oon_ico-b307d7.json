/origins/5fa9bcc8-f3b7-4edf-93b2-3dfab6e220f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=453c0b466c87d01be248e1ef55b303c7 2x, https://si.imgix.net/5490614f/uploads/origins/5fa9bcc8-f3b7-4edf-93b2-3dfab6e220f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a5fb6ef24385557b7f36f6c53669e04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5490614f/uploads/origins/5fa9bcc8-f3b7-4edf-93b2-3dfab6e220f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d44a0c9312960be0bb4f4a7ed7d9c7f0", "srcset": "https://si.imgix.net/5490614f/uploads/origins/5fa9bcc8-f3b7-4edf-93b2-3dfab6e220f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d44a0c9312960be0bb4f4a7ed7d9c7f0, https://si.imgix.net/5490614f/uploads/origins/5fa9bcc8-f3b7-4edf-93b2-3dfab6e220f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a5f5dc6d73685742b1bc4c6cb01f061 2x, https://si.imgix.net/5490614f/uploads/origins/5fa9bcc8-f3b7-4edf-93b2-3dfab6e220f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=238a28a2ebd38721714cf1bfd0b0d007 3x"}, "body": "初めまして、TLでmon¡様のキュアワンダフルのイラストを見かけ、とても可愛い絵柄に一目惚れし、ぜひ創作キャラを描いて頂きたいと思いリクエストさせて頂きました。\n\n依頼させていただきたいのは、創作キャラの女の子2人になります…！\n以下キャラクター詳細を失礼いたします。\n\n○1人目\n・紫髪でピンクのメッシュ、腰くらいまでの長めのツインテール\n・ツリ目で薄ピンクの瞳\n・鼻に絆創膏\n・イメージカラー→紫/ピンク\n・モチーフ→ネコ/星\n\n○2人目\n・水色髪のショートヘア\n・パッチリした丸目でオレンジの瞳\n・左目の下に泣きボクロ\n・イメージカラー→水色/白\n・モチーフ→ウサギ/虹\n\n2人はアイドルで、とても仲良しです。\n詳しくはこちらの画像を参考にしていただけたらと思います！↓\n\n1人目\nhttps://x.com/o9rdp/status/1691286157366284288?s=46&t=8YAElb4etvd3oK-rWqXRhg\n\n2人目\nhttps://x.com/o9rdp/status/1782380214401880518?s=46&t=8YAElb4etvd3oK-rWqXRhg\n\n\n○服装について\nフリルやリボンがたくさんのロリィタ服を着せていただきたいです…！細かい所や色はmon¡様にお任せさせていただきたいと思っております。\n\n○構図や雰囲気について\n\nhttps://x.com/m_oon_ico/status/1772223583475138816?s=46&t=8YAElb4etvd3oK-rWqXRhg\n\n↑mon¡様のこちらのイラストのような儚げで夢の中のような雰囲気がとても素敵だなと思いましたので、そのような雰囲気、構図で描いていただけたら嬉しいです…！（勝手ながら引用を失礼いたしました。）\n\n\n長々と大変失礼致しました。お忙しいとは思いますが、ご検討をよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m_oon_ico/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3109306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4496efa01d3e1ba56edeca00670bbeea", "srcset": "https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4496efa01d3e1ba56edeca00670bbeea, https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adf114ea7fe8bb49900b71974544911c 2x, https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfd7a7cfd127f39f7832395ec3aa6722 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=940601990c826e2e118a121d770b2643", "srcset": "https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=940601990c826e2e118a121d770b2643, https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed46ec6d424abe1866c42d414ddc1cf4 2x, https://si.imgix.net/8c4ca924/uploads/origins/435f95f9-c540-4eee-8fb7-cd47a29a24ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75bf99e14be86df15c82daed878fd3c5 3x"}, "body": "本当にお金はないんだ！\n予約のためです\nこんにちは！あなたの絵のスタイルがとても好きです！このサイトを使うのは初めてなので、許してください。私のオリジナルキャラの外見を説明しますと、漫画によくある前髪のある青い髪で、Mの形をしています。サイドの髪（多分もみあげと言います）はあまり長くなく、耳を覆っています。右側にはとても長いねじった三つ編みがお尻まで垂れ下がっています（とても細いです）。彼女の後ろには、上の方で結ばれた2つの大きな三つ編みがあります（これをどう表現していいか本当によくわからないので、最後に私のオリジナルキャラクターの写真を載せます！その写真を参考にしてね）自分のコスチュームをデザインしてもいいよ！私はリボンが好きです💗 アイドルという設定なのですが、あまり表情が豊かではなく、心を閉ざしているので、それを表すようなロックなどがいいです。(ちょっと無理かもしれませんが！学生でお金もないので、こんな感じじゃなくても大丈夫です！少々大雑把でも大丈夫です！\nちなみに、呼び方は「ナイ」でもOKです（別にいいんだけどね）。\n私のオリキャラの参考画像\nhttps://627431.ma3you.cn/static/tourguide/content_show/index.html?v=20240104#/pages/article_view/article_view?article_id=O71Zknn\n\nhttps://627431.ma3you.cn/static/tourguide/content_show/index.html?v=20240104#/pages/article_view/article_view?article_id=O71Zknn", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m_oon_ico/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3109306, "client_id": 1746547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7a0bf47439b045f012ddf3d15098b26", "srcset": "https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7a0bf47439b045f012ddf3d15098b26, https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0c8ef25a08655f425f18ba8739f88ad 2x, https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b52d393336fa536c629f5e94902b77ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f89c2e594beb62d24cb4bb9c0759bf6a", "srcset": "https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f89c2e594beb62d24cb4bb9c0759bf6a, https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c09fd741ba121eaebb3ca03ebbf76789 2x, https://si.imgix.net/041fa471/uploads/origins/0323f741-ea66-4c4b-9973-b6494e9cc76e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa8b5b5da8af3e327f8c0a478cb35ac 3x"}, "body": "mon¡様初めまして。あのにもと申します。\nmon¡様のイラストを新規作品でお見かけして、ふんわりと優しくかわいらしい雰囲気に一目惚れ致しました…！是非イラスト作成をお願いしたいです🙇‍♀️\n\n依頼したいのは私のTRPGキャラクターになります。\n名前：凩　小夜子（こがらし　さよこ）\n年齢：18\n身長：144cm\n好きなもの：日本発祥の芸術作品（日本画、伝統工芸品、ちりめん細工など）\nうさぎのような小動物っぽいイメージのキャラです🐰\n最下部に詳しい設定を記載していますが読み飛ばしていただいても大丈夫ですm(__)m\n\nhttps://x.com/m_oon_ico/status/1687787796147392512?s=20\nこちらのイラストに惹かれましたので、かわいい夢のような雰囲気で描いていただけると嬉しいです。\n表情は微笑み～満面の笑みのイメージでお願いします。\n詳しい構図、髪型や衣装などはお任せさせていただきたいです…！\n制服以外を着せていただけるときは、以下のような甘すぎないけどおさなかわいい感じ……？？\nでお願いできると幸いです！知識が乏しくざっくりした依頼で申し訳ないです；；\nhttps://x.com/m_oon_ico/status/1674015573796360193?s=20\nhttps://x.com/m_oon_ico/status/1749751771722125704?s=20\nまた、ヘアアレンジをする際水色のリボン（普段ハーフアップに使っているもの）はどこかに使用されていると嬉しいです。\n\n金額や内容に不足あった場合は再送依頼いただけますと助かります。\n以上何卒よろしくお願い致します。\n\n彼女は高校3年生の女の子で、幼馴染の女の子に恋をしています。\nしかし、同性愛に理解のない家に生まれたことから、その気持ちを悪いことであると思い込んでおり、一生心の内に秘めることを決めています。\n彼女はこの決意に後悔はなく、何より幼馴染の幸せを望んでいるので、幼馴染に好きな人や恋人ができても心から応援できる自信があります。\nいつもにこにこと微笑みながら人の後ろをついていくタイプで、行動に自主性はない方です。\nひらがなで喋っている様なイメージのふんわりとかわいらしい印象があります。\n\nhttps://drive.google.com/drive/u/0/folders/1XpDhhREoGLsmngrNaz2IwVq8FoRuDxMj", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m_oon_ico/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7f4ef341/uploads/origins/52a52fe2-018f-462f-92e6-97d13efce309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54eb4e7d487b744b4180bb49f49d9753", "srcset": "https://si.imgix.net/7f4ef341/uploads/origins/52a52fe2-018f-462f-92e6-97d13efce309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=54eb4e7d487b744b4180bb49f49d9753, https://si.imgix.net/7f4ef341/uploads/origins/52a52fe2-018f-462f-92e6-97d13efce309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc0ff8163a24d6ed14fb10751d18a0e9 2x, https://si.imgix.net/7f4ef341/uploads/origins/52a52fe2-018f-462f-92e6-97d13efce309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8843095f842af94eda284468d243db5c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3109306, "nc": 16}, {"path": "/@m_oon_ico/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3109306, "client_id": 1396648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95fad45b373d4832727c741ef88c7832", "srcset": "https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95fad45b373d4832727c741ef88c7832, https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bc60667798ee9c517d78d21033e83bc 2x, https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3556908a5c1b9ccd9854da5c6bf64bf0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ba704d12576d648a26cbd60f494e6e7", "srcset": "https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ba704d12576d648a26cbd60f494e6e7, https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55819ef8f7cab0ed7fbda6d1e8d05765 2x, https://si.imgix.net/4443e850/uploads/origins/b543f27f-ec3c-49dc-8fe8-e42306cafa05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1262ca4d7a22a9de850a30a6d7d45233 3x"}, "body": "はじめまして。\n個人vtuberとして活動している、朝久間もにと申します。\n以前からXの方をフォローさせて頂いており、素敵なイラストを見させて頂いておりました･･･！\nあたたかな絵柄と少し寂しげな　夢でみた世界のようなイラストが本当に大好きです。\nこの度SKEB開設されたとのことでもしよければ私のイラストも描いて頂きたいです…！\n以下要望になります。\n\n☆配信のサムネイルやTwitterで使用予定です。\n髪や衣装の上部、左右が切れてないと嬉しいです。\nmoniさんの\nhttps://x.com/m_oon_ico/status/1692873616957055122?s=20\nhttps://x.com/m_oon_ico/status/1687787796147392512?s=20\nhttps://x.com/m_oon_ico/status/1675104930129149952?s=20\nこちらのような寂しげ、儚いような切なげなイラストが特に好きなので\nかわいい、というよりかは　儚いような切なげなイラストをお願いしたいです。\n\n⭐︎→側に涙ぼくろ、少し内向きの悪魔のツノ、羽、しっぽは描いて頂きたいです。\n髪型や構図や衣装,表情等はお任せしますので、お好きな様に描いてください。\nアレンジ大歓迎です！moniさんの世界にお邪魔させてください。\n\n☆人物以外に何か描いてくださる場合は人物とレイヤーを分けてくださると嬉しいです。\n宜しくお願い致します…！\n\n☆朝久間もに（あさくまもに）\nイメージカラー：水色\nモチーフ：くま、あくま、水色のくま　すずらん\nすきなもの：ひつじ　水色のギンガムチェック　スイーツ　\n\nしっかり者の姉に甘やかされ育ち　幼い一面が多い。\nお人よしで心優しい一面と、マイペースで我が道をいく自由な2面性がある。\n優しい性格で悪魔の輪にはなじめず、変わり者だと噂をされている。\n本人は変わり者だと言われることに寂しさは感じているものの、優しい自分のことが好きです。\n\nhttps://drive.google.com/drive/folders/1mo_YBC9e49UQmWvqahZIOqqFvvnbPJ3z?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 367187, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぺろっぱふ🎨", "screen_name": "Meowstic__", "avatar_url": "https://pbs.twimg.com/profile_images/1735875448226373632/LqAcfnUM.png", "header_url": null, "appeal_receivable": true, "popular_creator_rank": 88, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 2582806, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "こぬひさ*Skeb6月末〜再開", "screen_name": "konuhisa", "avatar_url": "https://pbs.twimg.com/profile_images/1184077977845264384/g6PoYxI-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/859713604790083587/1766030210/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"id": 3123046, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "慈路", "screen_name": "rojunu11", "avatar_url": "https://pbs.twimg.com/profile_images/1766472302248722432/_NVT9RKS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1348252451351060484/1706352677/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at"