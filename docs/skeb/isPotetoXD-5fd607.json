drive_link\n外見25歳前後、183cm、痩せ型ですが筋肉はしっかり付いている男性です。\n温厚で物静かな性格で、動植物に好かれるキャラです。寝ていることが多いです。\n髪は銀色、膝まである長髪。耳は出ています。首から下はストレートですが、上は短めで軽く跳ねています。\n瞳は青の吊り目。\n\n■構図など\n他作品の、筆で繰り抜いたような背景と空に惹かれたので、同じようなものをお願いしたいです。ポーズはお任せしたいと思います。\nサイズや形式に希望はありません。描きやすいサイズにして戴ければと思います。\n\n■用途\n個人鑑賞と、SNSのヘッダーに使わせて頂きたいと思います。\n\n以上です、ご検討お願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@isPotetoXD/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 949506, "client_id": 2005069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/291cce70/uploads/origins/a78b092d-0a36-406d-890b-bc260893177e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0beeb8261225dc970013be7403472db", "srcset": "https://si.imgix.net/291cce70/uploads/origins/a78b092d-0a36-406d-890b-bc260893177e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0beeb8261225dc970013be7403472db, https://si.imgix.net/291cce70/uploads/origins/a78b092d-0a36-406d-890b-bc260893177e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dfd59740aa8b660b9fca09409bac987 2x, https://si.imgix.net/291cce70/uploads/origins/a78b092d-0a36-406d-890b-bc260893177e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a28550aaa62f2bdac362101e6fba01ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/291cce70/uploads/origins/a78b092d-0a36-406d-890b-bc260893177e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34f87bc7918bad9dcaedbbbf1601bb57", "srcset": "https://si.imgix.net/291cce70/uploads/origins/a78b092d-0a36-406d-890b-bc260893177e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34f87bc7918bad9dcaedbbbf1601bb57, https://si.imgix.net/291cce70/uploads/origins/a78b092d-0a36-406d-890b-bc2608