3089\u53cb\u662d\u306b\u4e00\u76ee\u60da\u308c\u3001\u305a\u3063\u3068\u80cc\u4e2d\u3092\u8ffd\u3044\u304b\u3051\u3066\u3001\u8ffd\u3044\u3064\u3044\u305f\u3002\n\nhttps://drive.google.com/drive/folders/1IOqAIUVIABGhAApih00PjAgl76lu6xZA?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@POMUPOMU_CURRY/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2618794, "client_id": 2774954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9561680739ab56584e9101ea0e9a9aa4", "srcset": "https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9561680739ab56584e9101ea0e9a9aa4, https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=031c08589d4e0786ecbb08fa980eef76 2x, https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c193a0365f01290e2263c3deb943288c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccb71feeac69e2e6cc98cf41ee869e78", "srcset": "https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccb71feeac69e2e6cc98cf41ee869e78, https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68a378ccbdfcff2cd2bfa7f564b73d4f 2x, https://si.imgix.net/382697c7/uploads/origins/fb30db6f-240c-43a9-a152-1a345f588cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b242d94b5c9b916261ed95f25971f27 3x"}, "body": "Hello!\nA friend recommended you to me, saying you draw wonderful illustrations! Your use of color and line work is absolutely stunning, and I really wanted to see my characters brought to life by you, so I\u2019m placing this commission!\n\nCharacter profiles for the characters I\u2019d like you to draw \u2193\nMr. Tsushima\nHeight: 175 cm\nBrown hair, red eyes. A gentle and soft-spoken teacher.\n\nKouka\nHeight: 164 cm\nBlack hair, red eyes. A laid-back and easygoing boy.\n\nPlease feel free to choose the composition and outfits as you see fit \ud83d\udc4c\n\nSince this is a group illustration, please let me know if the fee isn\u2019t enough.\nI look forward to your consideration.\n\nhttps://drive.google.com/drive/folders/1HYoksUJlClUNXTpFVZxyK5IgzJowsR-W?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@POMUPOMU_CURRY/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2618794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b464745f2b314f4117504907c00cfda", "srcset": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b464745f2b314f4117504907c00cfda, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1536edba9ceaa088af160ebf68971d20 2x, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1597fec569545d13b6ef8e6a5e998c29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f56ec0e6ebda03647ae116e394c76d57", "srcset": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f56ec0e6ebda03647ae116e394c76d57, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4079c786024bf2378cdcc37ad3c2e25b 2x, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f3bbc59ffb7b4e2f35c24ceb0c60002 3x"}, "body": "Hello, Mr. Takahashi!\nI absolutely love your illustrations, and I\u2019d love to see my friend and I as TRPG player characters drawn in your style, so I\u2019m reaching out with a request.\n\n[Request]\nI\u2019d like you to draw the two investigators we used in the CoC scenario titled \u201cBy My Own Hand Shall It Be Trampled\u201d (BLCP).\nThere\u2019s a folder with scenario spoilers in the reference materials, so please feel free to refer to it if spoilers aren\u2019t an issue.\nI\u2019ll leave the specific composition and details up to you.\n\nIf we have the chance to work together, I look forward to it!\n\nhttps://drive.google.com/drive/folders/1xgaYtIJJ4ZmQqoAirRC_omd4lA-3kl8M", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@POMUPOMU_CURRY/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dcc49412/uploads/origins/6ad6da9