lease let me know if the fee isn’t enough.\nI look forward to your consideration.\n\nhttps://drive.google.com/drive/folders/1HYoksUJlClUNXTpFVZxyK5IgzJowsR-W?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@POMUPOMU_CURRY/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2618794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b464745f2b314f4117504907c00cfda", "srcset": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b464745f2b314f4117504907c00cfda, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1536edba9ceaa088af160ebf68971d20 2x, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1597fec569545d13b6ef8e6a5e998c29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f56ec0e6ebda03647ae116e394c76d57", "srcset": "https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f56ec0e6ebda03647ae116e394c76d57, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4079c786024bf2378cdcc37ad3c2e25b 2x, https://si.imgix.net/89991c36/uploads/origins/7be03175-8517-42c7-82c6-f29582eda414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f3bbc59ffb7b4e2f35c24ceb0c60002 3x"}, "body": "Hello, Mr. Takahashi!\nI absolutely love your illustrations, and I’d love to see my friend and I as TRPG player characters drawn in your style, so I’m reaching out with a request.\n\n[Request]\nI’d like you to draw the two investigators we used in the CoC scenario titled “By My Own Hand Shall It Be Trampled” (BLCP).\nThere’s a folder with scenario spoilers in the reference materials, so please feel free to refer to it if spoilers aren’t an issue.\nI’ll leave the specific composition and details up to you.\n\nIf we have the chance to work together, I look forward to it!\n\nhttps://drive.google.com/drive/folders/1xgaYtIJJ4ZmQqoAirRC_omd4lA-3kl8M", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@POMUPOMU_CURRY/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dcc49412/uploads/origins/6ad6da96-f66f-4b60-a0cd-7f19e3ea0d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b06afd16dd75282e5a4ce5416bbb2675", "srcset": "https://si.imgix.net/dcc49412/uploads/origins/6ad6da96-f66f-4b60-a0cd-7f19e3ea0d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b06afd16dd75282e5a4ce5416bbb2675, https://si.imgix.net/dcc49412/uploads/origins/6ad6da96-f66f-4b60-a0cd-7f19e3ea0d9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=335cad319284ee2766828ba8bd2915e0 2x, https://si.imgix.net/dcc49412/uploads/origins/6ad6da96-f66f-4b60-a0cd-7f19e3ea0d9c?bg=%23fff&auto=format%2Ccompress&fm=web