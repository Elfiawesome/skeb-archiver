す\n\n【構図・ポーズ】\n歌っているイラストを依頼したいです\n（マイクの写真は下記リットリンクにあります）\n\n立ち絵（3種類ありますが、一番下の猫耳三つ編み新衣装でお願いいたします）\nhttps://lit.link/ruwanouta\n\n・猫耳三つ編み…猫耳三つ編みにはパール、紫のメッシュあり\nおへそ横のほくろ、ダイヤのピアス、上半身の胸、お腹部分のレース、チャームはRとハート\n\n\nx\nhttps://x.com/ruwanouta\n\n【使用用途】\nskebに依頼したFA絵として、\nおおぐし様のお名前を明記した上でXへ投稿いたします。\nルワ♢ruwaさんのYouTubeやSNSを含む活動にて使用する可能性があります\n・SNSでの投稿\n・収益化済YouTubeチャンネルでの使用\n・配信での使用\n・歌ってみた等の動画での使用\n・サムネイル\n・メンバーシップやFANBOX等の加入者特典としての配布\n・グッズ製作\n\n・可能であれば頭部の切れていない背景透過を頂きたいです。\n\n■特徴\n紫色の瞳に水色の光\n髪色は紫がかった薄いグレーに、毛先が紫色\n鎖骨上のほくろ\nおへそ横のほくろ\n\n何卒ご検討のほどよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@o_gusi/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d0de2761/uploads/origins/1b9a8f17-1e27-4b4a-b2fd-442f7ae8402a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3193108c644ceafb062e0616ef2ee9b5", "srcset": "https://si.imgix.net/d0de2761/uploads/origins/1b9a8f17-1e27-4b4a-b2fd-442f7ae8402a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3193108c644ceafb062e0616ef2ee9b5, https://si.imgix.net/d0de2761/uploads/origins/1b9a8f17-1e27-4b4a-b2fd-442f7ae8402a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40dba14a5ff23141e004e3b08af10998 2x, https://si.imgix.net/d0de2761/uploads/origins/1b9a8f17-1e27-4b4a-b2fd-442f7ae8402a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32c858bd31ea6c4b686a1b17a1bf5283 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3617522, "client_id": 2886341, "nc": 17}, {"path": "/@o_g