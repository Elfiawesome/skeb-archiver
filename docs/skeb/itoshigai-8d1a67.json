}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@itoshigai/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2612531, "client_id": 2833286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c04208919d8da0479d5a47c071a54b7", "srcset": "https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c04208919d8da0479d5a47c071a54b7, https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91a7ba6e83aac03a6b217f621f5f3179 2x, https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2c7628dd88b1b8a3a0e82f1b794ac57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0c2d31d8cb0411cec4c38dc7be2ad20", "srcset": "https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0c2d31d8cb0411cec4c38dc7be2ad20, https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e697fa389e1f204d10db80216038ce05 2x, https://si.imgix.net/2274b484/uploads/origins/d1ce0623-d169-4cea-86d6-2b93dea8cbf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc01d7e30847ca786da108cac24556c 3x"}, "body": "糸織貝さん、こんにちは。\nいつもTwitterで美麗なファンタジーイラストや漫画を拝見しております。\n\n自創作、『果ての輪舞』の主人公カミルのイラストを描いて頂けたらと思い、リクエストいたしました。\n青年姿の方で、衣装は糸織貝さんのお好きなようにデザインして頂きたいです！\n使用用途は主に個人観賞用です。\n以下に設定等をまとめます。ご検討頂ければ幸いです！\n\n【設定】\n\n・様々な種族がいるファンタジー世界観。\n・カミルは種族不明の長命種の魔導士。羽耳。親友と共に各国を旅している。\n・ずっと少年のままだったが、現在の外見は魔法で24歳ほどの青年の姿。(実年齢は現在の本編で230歳くらい)\n・一人称は俺。基本的におおらかな性格。余裕のある態度をとりたがるが、やや子供っぽく口が悪い。\n・魔法は杖などではなく、装身具に魔力をこめて使うのが中心。指輪や腕輪を多くつけている。\n・美しいものとおしゃれが好き。\n\n【参考資料等】\nhttps://www.pixiv.net/artworks/97896967\nhttps://www.pixiv.net/artworks/101201193", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@itoshigai/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2612531, "client_id": 196610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2e0e7cf4dd3a9bca79b7ee3585548f", "srcset": "https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e2e0e7cf4dd3a9bca79b7ee3585548f, https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=260d3ef67928b867fd705658cc8e7eb4 2x, https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fb3c4c241446b6a098c42d1ee9a1f6e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d307c1cd9733b71961b970f7ed255d2", "srcset": "https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d307c1cd9733b71961b970f7ed255d2, https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c8b0b45405172d27cf2228c16a27394 2x, https://si.imgix.net/badcca78/uploads/origins/31d83b0b-c3fd-4596-a267-a0616a93d299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48440859b14491baef309576cfb5aff7 3x"}, "body": "私の2匹のドラゴンガールズを描いていただけませんか？種族が違うので、見た目もかなり違います。羽がある方がシエナで、もう一人がラハリカです。シエナはラハリカより25cmほど背が高いです。姉妹のような関係です。\n\n標準キャラクター参照：https://imgur.com/a/69bLFz5\n\n魔女姿の二人が見たい https://imgur.com/a/uNbub3A", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@itoshigai/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2612531, "client_id": 2005698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde05a06fcee91ef5c179a960a07409e", "srcset": "https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde05a06fcee91ef5c179a960a07409e, https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64aca509fc4fe92208dbf42f91abb584 2x, https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43d58db879c16dbb206277cc2ad2d643 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8578b6c55130d5b6e5f1cb0414f27f70", "srcset": "https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8578b6c55130d5b6e5f1cb0414f27f70, https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68e4072b3a7dbc33684071643a99c6e6 2x, https://si.imgix.net/37b8d282/uploads/origins/51850802-cd33-4e0f-93bc-df186ddbe020?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05abe88d75bfe25a6ad48fb8096d6a8e 3x"}, "body": "はじめまして。壱原と申します。\nいつも幻想的で素敵なイラスト楽しく拝見しております。\nこの度は下記イラストの依頼をお願いしたくご連絡しました。\nご検討のほどよろしくお願いいたします。\n\n①イラスト希望概要\n自創作小説の挿絵\n該当シーン→11ページ、花を受け取って泣いているシーン\nhttps://maho.jp/works/15591043235068278091#15591074771452862657\n※大変お手数ですが10ページから目を通していただけると、なんとなく流れが把握できると思います\n\n②用途\n挿絵としての使用(作品内挿入)\n宣伝用\n(クレジット有、可。使用の際クレジット記載は必ず行います)\n該当作品を製本・印刷する際に使用する可能性があります(表紙としての使用はありません)\n\n③構図\n※カラー希望※\n※縦か横かもお任せいたします※\n\n人物2名(AとB)+背景(Aが噴水に腰かけています。Bは立ってます)\nファンタジー作品なので、星空や夜空の雰囲気が目をひく構図を希望します。\nBがAに花を渡したシーンで、花と受け取る手ごとBがAの両手を掴んでいます。\n\n場所：庭園(植物の写り込みやフォーカス具合はお任せします。なくても構いません)\n時間：深夜、満天の空、月明かり◎\n噴水：腰掛ける部分がある英国式の小さな物\n(噴水に腰掛けているのが分かれば、大きく見切れても問題ありません)\nイメージ(https://ipk-rose.com/barakai/2016/10/12/イングリッシュガーデン/)\n花：薄紫のイタリアンアスター(http://burari2.blog45.fc2.com/blog-entry-4788.html)\n\n表情(心情)：A→泣いてる　(不安と決心の中間)\nB→強ばってて困ってるような感じ (困惑と悔しさ)\n\n④キャラクター詳細\nキャラクターデザイン原案あり↓\n(https://twitter.com/ichi_natsu_1111/status/1665368947317964801?s=46&t=1hhPkwRXYmfQZkQQJzQEPg)\n\nキャラA(原案(21歳)から変わらぬほど童顔)\n名前：エト・アメルス　女性　18歳\n職業：魔法アイテムを作る技術者及び研究者\n　髪　：クリーム色　　ベース#fff3b8\n　　　　 髪型変わりません\n　目　：薄紫色　ベース#e4baf3 \n　　　　目大きめ・左目泣きぼくろあり\n　体格：平均的　160cm\n　特徴：童顔、色白(外出しないため)\n　　　ウェリントン型伊達メガネ(赤フレーム)→顔が小さいのでメガネが大きく見えます\n　その他：天才の人。白衣を着ています。(スカートNG)\n\nキャラB(元デザイン(15歳)より子供時代になります)\n   名前：リアン・アスター　男性　12歳\n　髪　：チャコールグレー　　ベース#4c444d\n　　　　髪型ほぼ変わりません\n　目　：琥珀色　ベース#c76d2b   三白眼気味\n　体格：労働孤児をしていたので細く儚い感じ　約150cm(小さく見えても構いません)\n　特徴：肌はオークル系\n　その他：天才の卵。イメージはこどものオオカミ\n服装：\"約束のネバーランド\"の子供たちのような簡素な物(ベッドから抜け出しているので)\n色味お任せ(華奢を気にしているので半袖半ズボンNG)\n\n※ カラーコードは目安になります\n\n⑤データサイズ、拡張子\n1920×1080\npngまたはjpeg\n\nhttps://twitter.com/ichi_natsu_1111/status/1665368947317964801?s=46&t=1hhPkwRXYmfQZkQQJzQEPg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@itoshigai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2612531, "client_id": 2746964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a65bafe/uploads/origins/28a4f642-7ef1-4884-b4fe-081a2a57bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80ba5796a5e94ce9626c7876cdf19b34", "srcset": "https://si.imgix.net/3a65bafe/uploads/origins/28a4f642-7ef1-4884-b4fe-081a2a57bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80ba5796a5e94ce9626c7876cdf19b34, https://si.imgix.net/3a65bafe/uploads/origins/28a4f642-7ef1-4884-b4fe-081a2a57bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edc86608b674fd7a322d96768fab6b88 2x, https://si.imgix.net/3a65bafe/uploads/origins/28a4f642-7ef1-4884-b4fe-081a2a57bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69309d7780941a6021bb9ac4a7308dbe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a65bafe/uploads/origins/28a4f642-7ef1-4884-b4fe-081a2a57bc48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43bd25f36e19064381f2c2c64976cc16", "srcset": "https://si.imgix.net/3a65bafe/uploads/origins/28a4f642-7e