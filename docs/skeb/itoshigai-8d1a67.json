57\u3066\u304a\u308a\u307e\u3059\u3002\n\u3053\u306e\u5ea6\u306f\u4e0b\u8a18\u30a4\u30e9\u30b9\u30c8\u306e\u4f9d\u983c\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u3054\u9023\u7d61\u3057\u307e\u3057\u305f\u3002\n\u3054\u691c\u8a0e\u306e\u307b\u3069\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u2460\u30a4\u30e9\u30b9\u30c8\u5e0c\u671b\u6982\u8981\n\u81ea\u5275\u4f5c\u5c0f\u8aac\u306e\u633f\u7d75\n\u8a72\u5f53\u30b7\u30fc\u30f3\u219211\u30da\u30fc\u30b8\u3001\u82b1\u3092\u53d7\u3051\u53d6\u3063\u3066\u6ce3\u3044\u3066\u3044\u308b\u30b7\u30fc\u30f3\nhttps://maho.jp/works/15591043235068278091#15591074771452862657\n\u203b\u5927\u5909\u304a\u624b\u6570\u3067\u3059\u304c10\u30da\u30fc\u30b8\u304b\u3089\u76ee\u3092\u901a\u3057\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u3001\u306a\u3093\u3068\u306a\u304f\u6d41\u308c\u304c\u628a\u63e1\u3067\u304d\u308b\u3068\u601d\u3044\u307e\u3059\n\n\u2461\u7528\u9014\n\u633f\u7d75\u3068\u3057\u3066\u306e\u4f7f\u7528(\u4f5c\u54c1\u5185\u633f\u5165)\n\u5ba3\u4f1d\u7528\n(\u30af\u30ec\u30b8\u30c3\u30c8\u6709\u3001\u53ef\u3002\u4f7f\u7528\u306e\u969b\u30af\u30ec\u30b8\u30c3\u30c8\u8a18\u8f09\u306f\u5fc5\u305a\u884c\u3044\u307e\u3059)\n\u8a72\u5f53\u4f5c\u54c1\u3092\u88fd\u672c\u30fb\u5370\u5237\u3059\u308b\u969b\u306b\u4f7f\u7528\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059(\u8868\u7d19\u3068\u3057\u3066\u306e\u4f7f\u7528\u306f\u3042\u308a\u307e\u305b\u3093)\n\n\u2462\u69cb\u56f3\n\u203b\u30ab\u30e9\u30fc\u5e0c\u671b\u203b\n\u203b\u7e26\u304b\u6a2a\u304b\u3082\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\u203b\n\n\u4eba\u72692\u540d(A\u3068B)+\u80cc\u666f(A\u304c\u5674\u6c34\u306b\u8170\u304b\u3051\u3066\u3044\u307e\u3059\u3002B\u306f\u7acb\u3063\u3066\u307e\u3059)\n\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u4f5c\u54c1\u306a\u306e\u3067\u3001\u661f\u7a7a\u3084\u591c\u7a7a\u306e\u96f0\u56f2\u6c17\u304c\u76ee\u3092\u3072\u304f\u69cb\u56f3\u3092\u5e0c\u671b\u3057\u307e\u3059\u3002\nB\u304cA\u306b\u82b1\u3092\u6e21\u3057\u305f\u30b7\u30fc\u30f3\u3067\u3001\u82b1\u3068\u53d7\u3051\u53d6\u308b\u624b\u3054\u3068B\u304cA\u306e\u4e21\u624b\u3092\u63b4\u3093\u3067\u3044\u307e\u3059\u3002\n\n\u5834\u6240\uff1a\u5ead\u5712(\u690d\u7269\u306e\u5199\u308a\u8fbc\u307f\u3084\u30d5\u30a9\u30fc\u30ab\u30b9\u5177\u5408\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\u306a\u304f\u3066\u3082\u69cb\u3044\u307e\u305b\u3093)\n\u6642\u9593\uff1a\u6df1\u591c\u3001\u6e80\u5929\u306e\u7a7a\u3001\u6708\u660e\u304b\u308a\u25ce\n\u5674\u6c34\uff1a\u8170\u639b\u3051\u308b\u90e8\u5206\u304c\u3042\u308b\u82f1\u56fd\u5f0f\u306e\u5c0f\u3055\u306a\u7269\n(\u5674\u6c34\u306b\u8170\u639b\u3051\u3066\u3044\u308b\u306e\u304c\u5206\u304b\u308c\u3070\u3001\u5927\u304d\u304f\u898b\u5207\u308c\u3066\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093)\n\u30a4\u30e1\u30fc\u30b8(https://ipk-rose.com/barakai/2016/10/12/\u30a4\u30f3\u30b0\u30ea\u30c3\u30b7\u30e5\u30ac\u30fc\u30c7\u30f3/)\n\u82b1\uff1a\u8584\u7d2b\u306e\u30a4\u30bf\u30ea\u30a2\u30f3\u30a2\u30b9\u30bf\u30fc(http://burari2.blog45.fc2.com/blog-entry-4788.html)\n\n\u8868\u60c5(\u5fc3\u60c5)\uff1aA\u2192\u6ce3\u3044\u3066\u308b\u3000(\u4e0d\u5b89\u3068\u6c7a\u5fc3\u306e\u4e2d\u9593)\nB\u2192\u5f37\u3070\u3063\u3066\u3066\u56f0\u3063\u3066\u308b\u3088\u3046\u306a\u611f\u3058 (\u56f0\u60d1\u3068\u6094\u3057\u3055)\n\n\u2463\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u539f\u6848\u3042\u308a\u2193\n(https://twitter.com/ichi_natsu_1111/status/1665368947317964801?s=46&t=1hhPkwRXYmfQZkQQJzQEPg)\n\n\u30ad\u30e3\u30e9A(\u539f\u6848(21\u6b73)\u304b\u3089\u5909\u308f\u3089\u306c\u307b\u3069\u7ae5\u9854)\n\u540d\u524d\uff1a\u30a8\u30c8\u30fb\u30a2\u30e1\u30eb\u30b9\u3000\u5973\u6027\u300018\u6b73\n\u8077\u696d\uff1a\u9b54\u6cd5\u30a2\u30a4\u30c6\u30e0\u3092\u4f5c\u308b\u6280\u8853\u8005\u53ca\u3073\u7814\u7a76\u8005\n\u3000\u9aea\u3000\uff1a\u30af\u30ea\u30fc\u30e0\u8272\u3000\u3000\u30d9\u30fc\u30b9#fff3b8\n\u3000\u3000\u3000\u3000 \u9aea\u578b\u5909\u308f\u308a\u307e\u305b\u3093\n\u3000\u76ee\u3000\uff1a\u8584\u7d2b\u8272\u3000\u30d9\u30fc\u30b9#e4baf3 \n\u3000\u3000\u3000\u3000\u76ee\u5927\u304d\u3081\u30fb\u5de6\u76ee\u6ce3\u304d\u307c\u304f\u308d\u3042\u308a\n\u3000\u4f53\u683c\uff1a\u5e73\u5747\u7684\u3000160cm\n\u3000\u7279\u5fb4\uff1a\u7ae5\u9854\u3001\u8272\u767d(\u5916\u51fa\u3057\u306a\u3044\u305f\u3081)\n\u3000\u3000\u3000\u30a6\u30a7\u30ea\u30f3\u30c8\u30f3\u578b\u4f0a\u9054\u30e1\u30ac\u30cd(\u8d64\u30d5\u30ec\u30fc\u30e0)\u2192\u9854\u304c\u5c0f\u3055\u3044\u306e\u3067\u30e1\u30ac\u30cd\u304c\u5927\u304d\u304f\u898b\u3048\u307e\u3059\n\u3000\u305d\u306e\u4ed6\uff1a\u5929\u624d\u306e\u4eba\u3002\u767d\u8863\u3092\u7740\u3066\u3044\u307e\u3059\u3002(\u30b9\u30ab\u30fc\u30c8NG)\n\n\u30ad\u30e3\u30e9B(\u5143\u30c7\u30b6\u30a4\u30f3(15\u6b73)\u3088\u308a\u5b50\u4f9b\u6642\u4ee3\u306b\u306a\u308a\u307e\u3059)\n   \u540d\u524d\uff1a\u30ea\u30a2\u30f3\u30fb\u30a2\u30b9\u30bf\u30fc\u3000\u7537\u6027\u300012\u6b73\n\u3000\u9aea\u3000\uff1a\u30c1\u30e3\u30b3\u30fc\u30eb\u30b0\u30ec\u30fc\u3000\u3000\u30d9\u30fc\u30b9#4c444d\n\u3000\u3000\u3000\u3000\u9aea\u578b\u307b\u307c\u5909\u308f\u308a\u307e\u305b\u3093\n\u3000\u76ee\u3000\uff1a\u7425\u73c0\u8272\u3000\u30d9\u30fc\u30b9#c76d2b   \u4e09\u767d\u773c\u6c17\u5473\n\u3000\u4f53\u683c\uff1a\u52b4\u50cd\u5b64\u5150\u3092\u3057\u3066\u3044\u305f\u306e\u3067\u7d30\u304f\u511a\u3044\u611f\u3058\u3000\u7d04150cm(\u5c0f\u3055\u304f\u898b\u3048\u3066\u3082\u69cb\u3044\u307e\u305b\u3093)\n\u3000\u7279\u5fb4\uff1a\u808c\u306f\u30aa\u30fc\u30af\u30eb\u7cfb\n\u3000\u305d\u306e\u4ed6\uff1a\u5929\u624d\u306e\u5375\u3002\u30a4\u30e1\u30fc\u30b8\u306f\u3053\u3069\u3082\u306e\u30aa\u30aa\u30ab\u30df\n\u670d\u88c5\uff1a\"\u7d04\u675f\u306e\u30cd\u30d0\u30fc\u30e9\u30f3\u30c9\"\u306e\u5b50\u4f9b\u305f\u3061\u306e\u3088\u3046\u306a\u7c21\u7d20\u306a\u7269(\u30d9\u30c3\u30c9\u304b\u3089\u629c\u3051\u51fa\u3057\u3066\u3044