30e9\u30b9\u30c8\u3092\u62dd\u898b\u3055\u305b\u3066\u3044\u305f\u3060\u3044\u3066\u304a\u308a\u307e\u3059\u3002\u4eca\u56de\u306f\u30a2\u30b7\u30ab\u30ef\u3055\u3093\u306b\u81ea\u5275\u4f5c\u306eOC\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3044\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3082\u3089\u3044\u307e\u3057\u305f\u3002\n\u753b\u50cf\u3067\u306e\u53c2\u8003\u8cc7\u6599\u304c\u307b\u3068\u3093\u3069\u306a\u304f\u3001\u6587\u7ae0\u306e\u307f\u306e\u8aac\u660e\u3068\u306a\u3063\u3066\u3044\u308b\u306e\u3067\u9577\u304f\u306a\u3063\u3066\u304a\u308a\u307e\u3059\u304c\u3001\u898b\u305f\u76ee\u306e\u7279\u5fb4\u4ee5\u5916\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306a\u3069\u3092\u8003\u3048\u308b\u969b\u306e\u53c2\u8003\u7a0b\u5ea6\u306b\u8a18\u8ff0\u3057\u3066\u304a\u308a\u307e\u3059\u306e\u3067\u76ee\u3092\u901a\u3055\u306a\u304f\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\u3002\n\u307e\u305f\u3001\u30ad\u30e3\u30e9\u30922\u4eba\u5206\u63cf\u3051\u308b\u5834\u5408\u306f\u4e0b\u8a18\u306b\u8a73\u7d30\u3092\u66f8\u3044\u3066\u3044\u308b2\u4eba\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u30021\u4eba\u306e\u307f\u63cf\u304b\u308c\u308b\u5834\u5408\u306f\u8a73\u7d30\u2460\u306e\u30ad\u30e3\u30e9\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\n\u3010\u30ad\u30e3\u30e9\u8a73\u7d30\u2460\u3011\n\u9aea\u578b:\u8170\u307e\u3067\u306e\u30ed\u30f3\u30b0\u30b9\u30c8\u30ec\u30fc\u30c8\u306b\u524d\u9aea\u306f\u7709\u6bdb\u8fba\u308a\u3067\u63c3\u3048\u3089\u308c\u3066\u3044\u308b\u3082\u306e\u3067\u3059\n\u9aea\u8272:\u767d\u9aea\n\u76ee:\u4e8c\u91cd\u306e\u30a2\u30fc\u30e2\u30f3\u30c9\u578b(\u5782\u308c\u76ee\u3067\u3082\u30c4\u30ea\u76ee\u3067\u3082\u306a\u3044\u3071\u3063\u3061\u308a\u3068\u3057\u305f\u3082\u306e)\n\u76ee\u306e\u8272:\u7dd1(\u30e9\u30a4\u30c8\u30b0\u30ea\u30fc\u30f3\u306a\u3069\u306e\u6de1\u3044\u8272\u5408\u3044)\n\u8868\u60c5:\u57fa\u672c\u7684\u306b\u771f\u9854\u306a\u306e\u3067\u3059\u304c\u30ad\u30e3\u30e9\u2461\u306e\u5b50\u304c\u305d\u3070\u306b\u3044\u308b\u6642\u306f\u8868\u60c5\u8c4a\u304b\u306b\u306a\u308a\u307e\u3059(1\u4eba\u3060\u3051\u63cf\u304f\u969b\u306f\u7121\u8868\u60c5\u3067\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059)\n\u8eab\u9577:175cm\n\u4f53\u91cd:57kg\n\u4f53\u578b:\u7d30\u8eab\u3060\u3051\u3069\u80f8\u306f\u3057\u3063\u304b\u308a\u3042\u308b\u3082\u306e\n\u30d0\u30b9\u30c8:D\u7a0b\u5ea6\n\u670d\u88c5:\u30ef\u30f3\u30d4\u30fc\u30b9\u306e\u3088\u3046\u306a\u670d\u88c5\u3067\u3042\u308c\u3070\u306a\u3093\u3067\u3082\u69cb\u3044\u307e\u305b\u3093(\u4e16\u754c\u89b3\u306e\u30a4\u30e1\u30fc\u30b8\u3068\u3057\u3066\u306f\u4e2d\u4e16\u30e8\u30fc\u30ed\u30c3\u30d1\u304c\u4e00\u756a\u8fd1\u3044\u3082\u306e\u306b\u306a\u3063\u3066\u3044\u307e\u3059)\n\u6027\u683c:\u7269\u4e8b\u3078\u306e\u95a2\u5fc3\u304c\u3042\u307e\u308a\u306a\u304f\u3001\u611f\u60c5\u7684\u306b\u306a\u308b\u3053\u3068\u304c\u307b\u3068\u3093\u3069\u306a\u3044\u3002\u3057\u304b\u3057\u3001\u81ea\u5206\u306e\u5a5a\u7d04\u8005\u306b\u95a2\u3057\u3066\u306f\u611f\u60c5\u7684\u306b\u306a\u308b\u3053\u3068\u306e\u65b9\u304c\u591a\u3044\n\n\u3010\u30ad\u30e3\u30e9\u8a73\u7d30\u2461\u3011\n\u9aea\u578b:\u8033\u304c\u307b\u3093\u306e\u5c11\u3057\u96a0\u308c\u308b\u304f\u3089\u3044\u306e\u9577\u3055\u3067\u5c11\u3057\u3060\u3051\u7656\u304c\u3042\u308a\u3001\u524d\u9aea\u306f\u76ee\u306e\u4e0a\u3042\u305f\u308a\u307e\u3067\u306e\u3082\u306e(\u30b3\u30f3\u30de\u30d0\u30f3\u30b0\u3068\u3044\u3046\u9aea\u578b\u304c\u4e00\u756a\u30a4\u30e1\u30fc\u30b8\u306b\u8fd1\u3044\u3067\u3059)\n\u9aea\u8272:\u30af\u30ea\u30fc\u30e0\u8272(\u8584\u3044\u8272\u7d20\u306e\u8272\u5408\u3044\u3060\u3068\u5b09\u3057\u3044\u3067\u3059)\n\u76ee:\u4e8c\u91cd\u306e\u30a2\u30fc\u30e2\u30f3\u30c9\u578b(\u5c11\u3057\u5782\u308c\u76ee\u6c17\u5473)\n\u76ee\u306e\u8272:\n\u8868\u60c5:\u5e38\u306b\u512a\u3057\u3052\u3084\u7b11\u307f\u3092\u6d6e\u304b\u3079\u3066\u3044\u308b\u597d\u9752\u5e74\u306e\u3088\u3046\u306a\u3082\u306e\n\u8eab\u9577:186cm\n\u4f53\u91cd:77kg\n\u4f53\u578b:\u7b4b\u8089\u8cea\u3060\u3051\u3069\u30ac\u30bf\u30a4\u304c\u826f\u3044\u308f\u3051\u3067\u306f\u306a\u3044\u3001\u3069\u3061\u3089\u304b\u3068\u3044\u3046\u3068\u7d30\u8eab\n\u670d\u88c5:\u30ad\u30e3\u30e9\u2460\u3068\u540c\u3058\u304f\u30ba\u30dc\u30f3\u3068\u30b7\u30e3\u30c4\u306e\u8981\u7d20\u304c\u3042\u308b\u670d\u88c5\u3067\u3042\u308b\u306a\u3089\u3070\u306a\u3093\u3067\u3082\u69cb\u3044\u307e\u305b\u3093(\u4e16\u754c\u89b3\u3082\u540c\u69d8\u306e\u3082\u306e\u3067\u3059)\n\u6027\u683c:\u4eba\u5f53\u305f\u308a\u304c\u3088\u304f\u512a\u3057\u3044\u3068\u547c\u3070\u308c\u308b\u3082\u306e\u3060\u304c\u5b9f\u969b\u306f\u51b7\u9759\u3067\u81ea\u3089\u306e\u7acb\u5834\u4e0a\u305d\u306e\u3088\u3046\u306b\u898b\u305b\u3066\u3044\u308b\n\n\n\u3010\u69cb\u56f3\u3011\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30922\u4eba\u63cf\u3044\u3066\u304f\u3060\u3055\u308b\u5834\u5408\n2\u4eba\u304c\u685c\u304c\u6ca2\u5c71(\u8907\u6570\u672c\u3067\u3042\u308c\u3070\u4f55\u672c\u3067\u3082\u69cb\u3044\u307e\u305b\u3093)\u54b2\u3044\u3066\u3044\u308b\u5c71\u306e\u4e2d\u306e\u91ce\u539f\u306e\u3088\u3046\u306a\u5834\u6240\u3067\u7b11\u3044\u5408\u3063\u3066\u3044\u308b\u3082\u306e\u3001\u80cc\u666f\u3067\u685c\u306e\u82b1\u3073\u3089\u304c\u821e\u3063\u3066\u3044\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\n\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30921\u4eba\u63cf\u3044\u3066\u304f\u3060\u3055\u308b\u5834\u5408\n\u4e0a\u8a18\u3068\u540c\u3058\u5834\u6240\u3067\u4fef\u304d\u306a\u304c\u3089\u7121\u8868\u60c5\u3067\u6d99\u3092\u6d41\u3057\u3066\u3044\u308b\u30ad\u30e3\u30e9\u2460\n\n\u8a18\u8f09\u3057\u3066\u3044\u306a\u3044\u90e8\u5206\u306f\u3082\u3061\u308d\u3093\u3001\u8a18\u8f09\u3057\u305f\u90e8\u5206\u3082\u30ad\u30e3\u30e9\u306e\u5916\u898b\u306e\u7279\u5fb4\u7684(\u9aea\u3084\u76ee\u306e\u8272\u306a\u3069)\u90e8\u5206\u4ee5\u5916\u30a2\u30b7\u30ab\u30ef\u3055\u3093\u304c\u826f\u3044\u3068\u601d\u3063\u305f\u3082\u306e\u306b\u3057\u3066\u3082\u5927\u4e08\u592b\u3067\u3059\uff01\u597d\u304d\u306a\u3088\u3046\u306b\u63cf\u3044\u3066\u3082\u3089\u3048\u305f\u3089\u305d\u308c\u304c\u4e00\u756a\u5b09\u3057\u3044\u3067\u3059\uff01\n\u9577\u6587\u306b\u306a\u308a\u307e\u3057\u305f\u304c\u6539\u3081\u3066\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\ud83d\ude47\u200d\u2640\ufe0f\n\n\n\u3010\u81ea\u5275\u4f5c\u306e\u8a2d\u5b9a\u306a\u3069(\u5177\u4f53\u7684\u306a\u30ad\u30e3\u30e9\u6027\u3092\u63b4\u3080\u305f\u3081\u306e\u8aac\u660e\u306b\u8fd1\u3044\u306e\u3067\u3053\u3053\u3092\u3054\u89a7\u306b\u306a\u3089\u306a\u304f\u3066\u3082\u4f9d\u983c\u306b\u306f\u5dee\u3057\u652f\u3048\u306a\u3044\u3068\u601d\u3063\u3066\u3044\u307e\u3059)\u3011\n\u795e\u69d8\u304c\u5b58\u5728\u3057\u3066\u3044\u308b\u4e16\u754c\u3067\u3001\u30ad\u30e3\u30e9\u2460\u3068\u2461\u304c\u51fa\u4f1a\u3063\u305f\u661f\u306f\u4e2d\u4e16\u30e8\u30fc\u30ed\u30c3\u30d1\u306e\u3088\u3046\u306a\u4e16\u754c\u89b3\u3092\u3057\u3066\u3044\u307e\u3059(\u3044\u308f\u3086\u308b\u7570\u4e16\u754c\u8ee2\u751f\u3082\u306e\u306e\u4e16\u754c\u89b3\u304c\u8fd1\u3044\u3067\u3059)\u3001\u751f\u6d3b\u6c34\u6e96\u306a\u3069\u3082\u4e2d\u4e16\u30e8\u30fc\u30ed\u30c3\u30d1\u306e\u6642\u4ee3\u3068\u307b\u3068\u3093\u3069\u4e00\u7dd2\u3068\u306a\u3063\u3066\u3044\u307e\u3059\n\u30ad\u30e3\u30e9\u2460\u306f\u547d\u4ee4\u3092\u805e\u304f\u30ed\u30dc\u30c3\u30c8\u306e\u3088\u3046\u306a\u751f\u304d\u65b9\u3092\u3057\u3066\u3044\u307e\u3057\u305f\u304c\u30ad\u30e3\u30e9\u2461\u3068\u51fa\u4f1a\u3063\u3066\u304b\u3089\u81ea\u6211\u304c\u51fa\u6765\u59cb\u3081\u3066\u3084\u308a\u305f\u3044\u4e8b\u3092\u3084\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\u30ad\u30e3\u30e9\u2461\u3082\u307e\u305f\u4e00\u56fd\u306e\u738b\u5b50\u3067\u3042\u308b\u304c\u6545\u306b\u672c\u97f3\u3092\u96a0\u3057\u3066\u751f\u304d\