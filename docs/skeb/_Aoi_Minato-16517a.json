メ口\n・呼びかけ(宛名)：ありなし両方を希望します。難しければあり優先でお願いします。敬称はお任せいたします。\n\n無理のない範囲で、みなと様のイメージに合うよう自由に演じていただけたら嬉しいです。\nお忙しいところ恐縮ですが、どうぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@_Aoi_Minato/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 3637253, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/c1da600b-cf0b-4571-83ac-980485d7215a?response-content-disposition=inline&Expires=1779204343&Signature=URwSoiFzLEjDr9lhZlN2motDWR-SigDcGwkHrAkDzYx8otAnaWpVBCFrOs8BWZ5kn7NcnTqbt582xPwAHR5~E~-iocDn-byh6hN9QD00sGWLkiPyrVgXTCpuhM540ZyxXcEym24gdoscezj3cEbPfVf1jKLc~dNQD3l~-qyz0bWBWlMJSPtrHNkn5oy~Xvo93pH8UKLIQN8wdHi1DwzDmWWGxHafKb56WnPHKrzY5q1CvfuVTff6mE8lQPVpk7sLV~vQUUnZqKNAHY3PD9SdSUgKZeEhSRM39JLlwPbOzdyV~BGnFQIx5LrWF7zxnTcwyAyiGBFLZmq02~XIJP~pBg__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1949766343257157632%2FPAyp1IEF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b61a754309c8124d4faf73d5740905", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1949766343257157632%2FPAyp1IEF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b61a754309c8124d4faf73d5740905, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1949766343257157632%2FPAyp1IEF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=426c6341e471400483fe81fa909d8db7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1949766343257157632%2FPAyp1IEF.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65fe29f682ecd17a9e81972f11c148c6 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/e21219fc-b0ad-41c8-bb55-7936ec02fbe8?response-content-disposition=inline&Expires=1779204343&Signature=rAGXjfB