fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44f85c15333d11c7364345d143591a14, https://si.imgix.net/da0f257f/uploads/origins/d24b89eb-cf0f-4854-bc9a-e4796411121f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=193b755b4263b98adf87a9b736fdc4a0 2x, https://si.imgix.net/da0f257f/uploads/origins/d24b89eb-cf0f-4854-bc9a-e4796411121f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffa531a51387f1212a71da4c87701c08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da0f257f/uploads/origins/d24b89eb-cf0f-4854-bc9a-e4796411121f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=500a25cca030be1d02989910481fb13b", "srcset": "https://si.imgix.net/da0f257f/uploads/origins/d24b89eb-cf0f-4854-bc9a-e4796411121f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=500a25cca030be1d02989910481fb13b, https://si.imgix.net/da0f257f/uploads/origins/d24b89eb-cf0f-4854-bc9a-e4796411121f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8023f74ca578ae2979f7d11da3c05dd 2x, https://si.imgix.net/da0f257f/uploads/origins/d24b89eb-cf0f-4854-bc9a-e4796411121f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20f018e6dc039a534ab0e629a54bb114 3x"}, "body": "えむしろ様\n\nこんばんは、えむしろ様。\nツイッターからイラストを拝見させて頂いてファンになったものです。\nhttps://twitter.com/ShinnsennDr/status/2027431989666824611\nこのイラストがTLに流れて来て惚れちゃいました！表情も手も体と服の表現も最高です…！\nそんなえむしろ様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でえむしろ様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、他はどうかご自由にお願いします。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ShinnsennDr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3870991, "client_id": 81523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed726baf/uploads/origins/cd0a70dd-92e6-4573-9528-34ecb33f0238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dba7205e053349f1d33f51563fb1903", "srcset": "https://si.imgix.net/ed726baf/uploads/origins/cd0a70dd-92e6-4573-9528-34ecb33f0238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5dba7205e053349f1d33f51563fb1903, https://si.imgix.net/ed726baf/uploads/origins/cd0a70dd-92e6-4573-9528-34ecb33f0238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff2c6dc3479155d6134b942d39f692ee 2x, https://si.imgix.net/ed726baf/uploads/origins/cd0a70dd-92e6-4573-9528-34ecb33f0238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac5f32f25df2c3e9c3a65de6fff3b2ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed726baf/uploads/origins/cd0a70dd-92e6-4573-9528-34ecb33f0238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f48c2bbb21245b11aa2e348851725f3", "srcset": "https://si.imgix.net/ed726baf/uploads/origins/cd0a70dd-92e6-4573-9528-34ecb33f0238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f48c2bbb21245b11aa2e348851725f3, https://si.imgix.net/ed726baf/uploads/origins/cd0a70dd-92e6-4573-9528-34ecb33f0238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f2f5833c6c2799df416c54de1f15432 2x, https://si.imgix.net/ed726baf/uploads/origin