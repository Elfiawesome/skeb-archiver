n今にも敵に襲い掛かろうとしているような、同じような構図が欲しいです。  カメラに向かって真剣な顔で冷ややかに睨みつけるような構図もいいですね！（笑）。  \n\n動画のサムネイルに使えそうです。\n\nありがとうございました。\n\nhttps://sta.sh/21oje9xy6hvi", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@btks_over/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1284853, "client_id": 1932150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/030cc74b/uploads/origins/fc956cba-5465-4165-a21f-5f627fdd4034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac579267f88f324b310723966467c10", "srcset": "https://si.imgix.net/030cc74b/uploads/origins/fc956cba-5465-4165-a21f-5f627fdd4034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ac579267f88f324b310723966467c10, https://si.imgix.net/030cc74b/uploads/origins/fc956cba-5465-4165-a21f-5f627fdd4034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=117d7c72cdd92d60509b91b26901a040 2x, https://si.imgix.net/030cc74b/uploads/origins/fc956cba-5465-4165-a21f-5f627fdd4034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dff27208cf9c7a2f7a14729a37e30e3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/030cc74b/uploads/origins/fc956cba-5465-4165-a21f-5f627fdd4034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8693462aedc6de920e4d691de3bd53aa", "srcset": "https://si.imgix.net/030cc74b/uploads/origins/fc956cba-5465-4165-a21f-5f627fdd4034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8693462aedc6de920e4d691de3bd53aa, https://si.imgix.net/030cc74b/uploads/origins/fc956cba-5465-4165-a21f-5f627fdd4034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=48a97acabcbcf3f50d51ebb5e133e1db 2x, https://si.imgix.net/030cc74b/uploads/origi