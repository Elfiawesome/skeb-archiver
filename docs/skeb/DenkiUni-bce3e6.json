rks/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3568421, "client_id": 385329, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde3ff0471703540c7c8b4afbc86f036", "srcset": "https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde3ff0471703540c7c8b4afbc86f036, https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a825f758dcd4daf1ae6c5233ba101dc 2x, https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27e756d3d79f9960c80c829def45ae4e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=937dfd1f64766b132df850220bd44815", "srcset": "https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=937dfd1f64766b132df850220bd44815, https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d58308b8d3d18837095e089a3fc3c5d9 2x, https://si.imgix.net/64fc41de/uploads/origins/6d141335-6ba8-48a3-b750-ad74346fd799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2360e8aea2e5b6c248ef60814d9b92d 3x"}, "body": "こんにちは！　またご依頼をさせていただきたいと思います！\nポケスペのイエローちゃんが洗脳されてロケット団のお仲間にされちゃうイラストをお願いします！\n\nシチュエーションは以下の通りです。\nロケット団はイエローちゃんを捕まえ洗脳し、強制的にロケット団に入団させます。洗脳されたイエローちゃんは団員たちに股を開いて性欲の捌け口となり、団員たちのポケモンを癒やし強化し時には自らも戦闘に参加し作戦を支えます。そうしてロケット団との連帯を繰り返したイエローは、洗脳の効果も相まってロケット団として活動することに悦びを感じるようになります。そうなれば後はもう堕ちるだけで、今ではすっかり自分をロケット団の一員と考えるようになりました。今日も作戦を終えてアジトに帰還し、仲間であるロケット団員たちと労いと親愛のセックスに励むのでした。\n\nイエローちゃんはロケット団を最初は嫌っていたが今では大好き、嫌ってた自分が理解できない、といった自認で、洗脳されていることには無自覚です。団員たちとはタメ口で会話し甘え上手、とてもよく可愛がられています。\n服装はロケット団のしたっぱ♀のもので、着衣したまま正常位で犯されています。また繋がっている団員以外のモノを握って扱いています。\n\n団員たちもイエローちゃんを好いており、かなり甘めの対応になっています。それでいてしっかり性欲の捌け口にはするし強盗や人攫い(＆攫った人の洗脳)といった悪事もいっぱいやらせています。\n\n以上の内容でよろしくお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DenkiUni/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b05e42cf/uploads/origins/1acaf27b-a39d-4969-8c2e-6d15788e0424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=308cc6a53887c7d48f5dd2d7a797417f", "srcset": "https://si.imgix.net/b05e42cf/uploads/origins/1acaf27b-a39d-4969-8c2e-6d15788e0424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=308cc6a53887c7d48f5dd2d7a797417f, https://si.imgix.net/b05e42cf/uploads/origins/1acaf27b-a39d-4969-8c2e-6d15788e0424?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff53f575f0b383ec56ca217258c27525 2x, https://si.imgix.net/b05e42cf/uploads/origins/1acaf27b-a39d-4969-8c2e-6d15788e0424?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91d4eec434b2856380e3e7666213f0f0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3568421, "client_id": 104022, "nc": 49}, {"p