d31c58250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5cdebc16de4d22b2d2056d65d0c4f8b 2x, https://si.imgix.net/031a9f8a/uploads/origins/2b1c05d4-f4fe-43c9-86e2-5bdd31c58250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adcf710786d470b3b951cde1b7560956 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/031a9f8a/uploads/origins/2b1c05d4-f4fe-43c9-86e2-5bdd31c58250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3968fcd448ccad15796653a6ac3d2aa", "srcset": "https://si.imgix.net/031a9f8a/uploads/origins/2b1c05d4-f4fe-43c9-86e2-5bdd31c58250?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3968fcd448ccad15796653a6ac3d2aa, https://si.imgix.net/031a9f8a/uploads/origins/2b1c05d4-f4fe-43c9-86e2-5bdd31c58250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66915d8c680b9457004340dbc54587b8 2x, https://si.imgix.net/031a9f8a/uploads/origins/2b1c05d4-f4fe-43c9-86e2-5bdd31c58250?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7eea061773a5d4703ca39c515baff3d8 3x"}, "body": "こんにちは、あおやさんの絵柄が好みで何かお願いしたいなと思っておりました。\nただなかなか題材思いつかないな～と考えていたのですが、\n私の好きな要素を入れ込んだ女の子を描いていただければ間違いないなと思い、今回リクエストさせていただきました。\n以下、希望内容です。\n\n・艶やかな黒髪、おかっぱ(ぱっつんなボブカット、前髪や横～後髪の長さはお任せします)\n・セーラー服(夏服でも冬服でもOK、デザインもお任せします)\n・中学１，２年生くらいのちょっと幼くて素朴or清楚な感じの女の子\n・裸眼\n\n何をしているシーンでも、どんな表情でも構いません。\nよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoyadazoon/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1497775, "client_id": 6708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d16be7114b12fc0c7f1e435afc02af5c", "srcset": "https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d16be7114b12fc0c7f1e435afc02af5c, https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b3ae925407bb63901329340541045a3 2x, https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6d60f175ab44f075a5b2a9805fb83f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=357a30d2dbe841fd41c7af6d51e067a6", "srcset": "https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=357a30d2dbe841fd41c7af6d51e067a6, https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73ba57851e42139a6a7571bdd1243b90 2x, https://si.imgix.net/d6361aa3/uploads/origins/8cd22ceb-a6ac-4023-83a6-96bf821a61c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bd02f39b0896dc21e07e67062d61dc5 3x"}, "body": "先日は大変素晴らしいキャラを描いて下さりありがとうございました。\nとっても良かったので、もしよければまたお願いさせて頂きたいと思います。\nまた誰を描いて貰おうかと決めきれず悩んだのですが…\n前にそばいれの遼さんのご家族のエピソードのマンガがあったと思います。\nあのマンガを読んで、また読み返して気になったのですが、遼さんのお母さんがどんなお母さんだったのかということを知りたいです。前に描いて貰ったお姉さんが母性的だったからか、あおやさんが描いた母性のある作品をもっと見たいと思いました。\nですので、遼さんのお母さんを描いて頂きたいと思うのですが、いかがでしょうか？\n希望としては、遼さんが小学生とかの頃～出ていく間のいずれかの姿（比較的お若い姿）だと嬉しいです。\nお寿司食べに行ったとか温泉行ったとか、あるいは入学式や卒業式に撮った写真風に描いて下さると嬉しいです。写真はお父さんが撮ったという風にしたいので、お父さんの姿は要りません。\n収監中の遼さんの所持品あるいはスマホのデータに残っている、お母さんが写っている唯一の写真…みたいな…こういう頃というか思い出もあったね的な…そういう感じの作品を見ることができたら嬉しいです。\nご検討のほど、よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoyadazoon/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1497775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a199ceb37ef1575b3c76667a1f54c96e", "srcset": "https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a199ceb37ef1575b3c76667a1f54c96e, https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f485b178c2f1170cd4280c0ec5d2491c 2x, https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5104d253e2c651a1bc2964d953f6c3d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1bc1101bef98b66f13aeddf63834e78", "srcset": "https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1bc1101bef98b66f13aeddf63834e78, https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53961dfef29d02e8edd47570998ceda0 2x, https://si.imgix.net/4a871642/uploads/origins/3e039258-90c4-445e-b3b7-43eb56a6d110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=300834af57819ee33e0cdfa2b613d9e7 3x"}, "body": "こんにちは。\nもしよろしければ、以下のようなイラストをお願いできますと大変ありがたいです。\n\nそばいれの神戸君が趣味をしながら\n頭の中で由香ちゃんを心配(？)しつつ\n由香ちゃんの彼氏の遼君について思っていることを描いていただきたいです。\n漫画の時系列でいうと由香ちゃんが家出てネカフェ生活している頃辺りだと嬉しいです。\nカラー・モノクロは問いません。\n\n神戸くんの趣味とか遼君のことどういうふうに見ているか、\n由香ちゃんのことどう思っているか\nそばいれの深堀りしていただけたら幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoyadazoon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1497775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f296a3b0/uploads/origins/182c029c-af8f-419c-8f22-b26f2974af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fbd291f4b419c5dda272461e0790793", "srcset": "https://si.imgix.net/f296a3b0/uploads/origins/182c029c-af8f-419c-8f22-b26f2974af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fbd291f4b419c5dda272461e0790793, https://si.imgix.net/f296a3b0/uploads/origins/182c029c-af8f-419c-8f22-b26f2974af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61fbb2b55db58a4283042d52943e0a1e 2x, https://si.imgix.net/f296a3b0/uploads/origins/182c029c-af8f-419c-8f22-b26f2974af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ee897cdc2daefa1be7c8a706d13b962 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f296a3b0/uploads/origins/182c029c-af8f-419c-8f22-b26f2974af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a11142388a57489814125c5277e45a2a", "srcset": "https://si.imgix.net/f296a3b0/uploads/origins/182c029c-af8f-419c-8f22-b26f2974af6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a11142388a57489814125c5277e45a2a, https://si.imgix.net/