液が、ちんちんからは自分の精液が垂れているようにお願いします。\n胸には歯形が数カ所付いていて、そこから血を滲ませていただけますか。\n永琳のちんちんと乳首は勃起したままでお願いいたします。\nきしまささんの描き易い範囲で胸を大きくお願いできればと思います。\n服装は帽子と首輪のみでお願いいたします。\n表情は息を荒げて顔の紅潮を強くして、涙や涎、鼻水などを流して無様な感じでお願いいたします。\n\nイメージ的には14年、15年の夏コミで出されていたふたなり幽々子本に近いシチュエーションで、悪い人に捕まって慰みものにされているみたいな感じです。\n永琳は性的な事には積極的でなかったものの、潜在的なマゾヒストで、レイプされて屈服させられる事を屈辱を感じつつも内心では悦んでいて、体力的には限界を迎えているのに、興奮冷めたらず、ふたなりのちんちんは勃起したままみたいな感じでお願いできればと思います。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kishimasa/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 125763, "client_id": 1989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71936f09/requests/63749_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84fca34161a32f46397c801f8953f753", "srcset": "https://si.imgix.net/71936f09/requests/63749_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84fca34161a32f46397c801f8953f753, https://si.imgix.net/71936f09/requests/63749_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37823ad6c6cfc4c099e3d1784089c733 2x, https://si.imgix.net/71936f09/requests/63749_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16f92641de95851cd66ebbf41b7f5f4e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71936f09/requests/63749_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0db6aab2d8015dfd7e2d7829b371a35", "srcset": "https://si.imgix.net/71936f09/requests/63749_3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0db6aab2d8015dfd7e2d7829b371a35, https://si.imgix.net/71936f09/requests/63749_3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91a32164675bbe2f38b5c0c0bf1e76c6 2x, https://si.imgix.net/71936f09/requests/637