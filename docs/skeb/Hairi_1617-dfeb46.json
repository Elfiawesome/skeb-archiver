s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hairi_1617/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1149383, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48f88455cd52636a7e4d12b39abf33ff", "srcset": "https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48f88455cd52636a7e4d12b39abf33ff, https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56809161a61815940304d6d2e9add72b 2x, https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0afab26093d4cec54c2c89efc0034ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bc6b3174e996c8ceec86bff6e5ebdaa", "srcset": "https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bc6b3174e996c8ceec86bff6e5ebdaa, https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f18f27619761cbf1689e876c16dbab2e 2x, https://si.imgix.net/587f15bf/uploads/origins/e819bf56-8388-4609-b33c-eea8484a82f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e37536de0c428cce895c9479addf48a 3x"}, "body": "こんにちは。\n度々のリクエストで恐縮です…。\n先日はいり様に描いて頂いたイラストがあまりに素敵でしたので、早速ではありますが、よろしければ是非リピートさせてください！\n\n◆使用用途\ntwitter等SNSでの使用\n\n◆三面図・キャラ参考資料\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20\n\n◆テイスト・シチュエーション等\n毎年夏休みの季節に各出版社がキャンペーンを行う「〇〇文庫の夏」のキービジュアルになりそうな、夏の風情が漂う雰囲気のイラストをお願いしたいです。\nうちの子の描写については、前回のように瑞々しく湿度を感じる雰囲気（汗や水など）でお願いします。\n\n◆姿勢・ポージング等\n夏の縁側に腰かけて、こちらの参考画像のような水桶に足を浸している情景です。\nそこから、そのまま後ろに横たわった感じの姿勢を描いて頂きたいです。\nhttps://imagenavi.jp/search/#!/%E6%A1%B6/%E5%A4%8F/%E5%86%B7%E3%81%9F%E3%81%84/%E9%80%8F%E6%98%8E/%E5%92%8C%E9%A2%A8\n\n寝転んだ傍ら（あるいは胸の上など）には文庫本サイズの本を配置してください。\n（文庫本については別途詳述します）\n\n足の指先については、片足は水桶に浸している状況です。\nもう片足は、水から上げて露出している状況でお願いします。\n前回描いて頂いた足爪の描写が素敵でしたので、露出した片方の足については、全ての足爪が見えるように描いてもらえると嬉しいです。\n（水が滴るような瑞々しい演出でお願いします！）\n\n◆構図\n女の子の姿勢は上記のとおりですが、その情景を上方（真上）から眺めているような俯瞰視点でお願いします。\n膝を曲げて水桶に足を浸した足元や水桶から女の子の頭まで、全身を画面に収めてもらいたいです。\n\n◆服装\n前回と同じく制服ですが、少しアレンジ頂きたいです。\n具体的には、上半身は、制服のジャンパースカートを腰のあたりまでずらして、半袖シャツ姿になっている状況です（シャツのボタンも何個か開けた状態）。\n下半身は、スカートを太もものあたりまでたくし上げている状況です。\n（ショーツはぎりぎり見えないくらいで）\nなお、履いていた紺ソックスを脱いだという設定で、傍らに脱いだ靴下を描いてもらえると嬉しいです。\n\n◆表情\nうちの子の表情は、ひんやりとした冷水に足を浸して気持ちよさそうな様子で。\n具体的にはお任せします。\n\n◆文庫本について\nこちらの文庫本を読んでいる設定でお願いします。\nhttps://www.iwanami.co.jp/book/b246167.html\n\n本の描写については、できれば岩波文庫の青本であることが判別できるように描いてもらいたいですが、再現については可能な範囲で大丈夫です。\n\n◆納品\nPSDとPNG形式でお願いします。\n\n注文が多くて恐縮です…。\n構図的に難しい部分や分かりにくい部分など、ご自由にアレンジ頂いて構いませんので、ぜひ描いて頂けると嬉しいです。\nよろしくお願いいたします。\n\nhttps://twitter.com/silas_012/status/1624678045637550083?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hairi_1617/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1149383, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd98ef90/uploads/origins/0f97471b-77d8-4116-afc0-3d3580a0265d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=740453b5cbac5e10e7f0fb1108bf43e7", "srcset":