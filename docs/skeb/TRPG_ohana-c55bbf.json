mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=940acdabf8fa8d1ef5470280e77732b0", "srcset": "https://si.imgix.net/5112ef4f/uploads/origins/27bcb64c-151a-4c4c-a412-d947cb35d0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=940acdabf8fa8d1ef5470280e77732b0, https://si.imgix.net/5112ef4f/uploads/origins/27bcb64c-151a-4c4c-a412-d947cb35d0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5eeac9e3b3e71a3760194c91c614cda6 2x, https://si.imgix.net/5112ef4f/uploads/origins/27bcb64c-151a-4c4c-a412-d947cb35d0ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae06e3e4b568c37c950c9423e3475037 3x"}, "body": "いつもお世話になっております。\n御崎怪談さんの描かれる素敵なイラストに惹かれ、今回リクエストの方をさせていただきました！\n\nキャラクターは、御崎怪談さん宅の【金有金太郎くん】をお願い出来ればと思います🌻\n\n✦︎︎︎\n\n▋希望シチュ\n・特に指定無し。自由に描いていただければと思います！\n・金太郎くん単体でも、弟くんを混ぜても何でも！完全お任せします。\n\n✦︎︎︎\n\n以上となります。\nお忙しい中、お目通しありがとうございました。 何卒、宜しくお願い致します！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TRPG_ohana/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2369599, "client_id": 1952864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afc8562db5654f0d895c8dd4483948f3", "srcset": "https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afc8562db5654f0d895c8dd4483948f3, https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e082ced39030b85bb7764b555527388a 2x, https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=769faaae81ef870c1361deca387c35e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=542202c6e3aaf01102bba46a83850cba", "srcset": "https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=542202c6e3aaf01102bba46a83850cba, https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edd8b7bef89634024f91beb6e7c0fb65 2x, https://si.imgix.net/34caf50a/uploads/origins/a99ed49e-f405-4a76-a50a-f605a76410f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37a21b3ce7239db465ecb59c33a25cd4 3x"}, "body": "本当に何度も連投失礼します、これが最後の依頼文です。作者様のよそよその絡みを見たい…となった後に｢やっぱりうちよそ(とうちうち)も見てえ｣となってしまった為、改めて依頼を送付させて頂きます。\n\n何度もご依頼文を送るのは、通知の都合上ご迷惑かと思いましたので、2枚分を1度の文章で依頼させて頂きます。金額は2枚分にしております。\n\n【依頼内容1】\n・前月を描いて欲しいです\n・構図は問いません。全身でもバストアップでも。1枚絵でも漫画形式でも。立ってても座ってても。室内でも室外でも、和室でも洋室でも。何かを持っていたり持っていなくても、相手にちょっかい出してても出してなくても、どんな事をしてても大丈夫ですし、どんな構図でも大丈夫です。服を着てても着てなくても全然大丈夫です\n・シチュとしては｢エロティックでムーディな大人びた妖しい雰囲気の空気感の中でマジでヤる5秒前｣みたいな、この先R18！！！！！未成年は帰んな！！！！！みたいな物が見たいです。エロガキですいません\n・もし可能であれば、の話ですが、大前君が\"\"\"\"ド雄\"\"\"\"の表情をしていると…物凄く助かる命があります…\n・その時の月は｢雰囲気(もしくは大前君の表情)に飲まれてしまって普段の喧嘩腰も嫌味口も全部消え失せ、攻めを受け入れる事だけ考えてる受け｣みたいな感じだと思われます\n\n【依頼内容2】\n・星月を描いて欲しいです\n・構図は上記と同じで、どんな背景でも構いません。何なら首輪でも手錠でも付けてて大丈夫です\n・シチュとしては｢月をやっと手に入れられて超嬉しい♡の有頂天星と、コイツに捕まってしまった…みたいに静かに絶望してる月｣みたいな物を見たいです\n・月だけ不幸なメリバカプなので、そんな感じの雰囲気だと、とても嬉しいです。♡僕達ラブラブ♡な空気は星だけが出している感じだと、助かります\n\nまとまりの無い文章になってしまいましたが、良ければご依頼受付を宜しくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TRPG_ohana/works/2", "private_thumbna