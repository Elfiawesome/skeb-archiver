6ed6ed559283ce86e375498dba5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fccdada/uploads/origins/45df544b-a8c8-4152-b952-f608a1706c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4117abf866c7094bb4cbf482c88afd0", "srcset": "https://si.imgix.net/9fccdada/uploads/origins/45df544b-a8c8-4152-b952-f608a1706c73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4117abf866c7094bb4cbf482c88afd0, https://si.imgix.net/9fccdada/uploads/origins/45df544b-a8c8-4152-b952-f608a1706c73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fed98bf4dde2b314584ea4b6bb3b0af9 2x, https://si.imgix.net/9fccdada/uploads/origins/45df544b-a8c8-4152-b952-f608a1706c73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b056a98847a262490e3bf509a337a232 3x"}, "body": "はじめまして。\n貴方様のイラストをを拝見し私の好みに合っていたので今回リクエストさせていただきました。\nキャラクターはにゃんこ大戦争の「シーサイドペガサ」です。\n座っている椅子は除きキャラクターだけ描いてほしいです。\nイラストの仕様用途としましてはSNSのアイコン等の個人利用を目的としたものとなります。\nご検討の程よろしくお願い申し上げます。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Uminako_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1562554, "client_id": 3547855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6087f60/uploads/origins/4f042ec6-51fa-4c20-953a-d885234df654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc0a9536998a77f53ea79fb65f17b159", "srcset": "https://si.imgix.net/b6087f60/uploads/origins/4f042ec6-51fa-4c20-953a-d885234df654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc0a9536998a77f53ea79fb65f17b159, https://si.imgix.net/b6087f60/uploads/origins/4f042ec6-51fa-4c20-953a-d885234df654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=20