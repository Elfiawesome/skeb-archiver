fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf9d399e9b6ce3de5368231bfa9df6d4 3x"}, "body": "skebの募集再開お待ちしておりました。\nヱイザン先生の子宮脱イラストがとても好みで子宮脱のリクエストをさせていただきます。\n\nキャラクター 学園アイドルマスター 十王星南\nhttps://gakuen.idolmaster-official.jp/idol/sena/\n\n衣装\nレッスン着\nhttps://seesaawiki.jp/gakumasu/d/%B0%E1%C1%F5%A5%AE%A5%E3%A5%E9%A5%EA%A1%BC/%BD%BD%B2%A6%C0%B1%C6%EE\n\nポーズ・構図\n腋見せエロ蹲踞(ガニ股スクワット)\n身体を正面から映す形\n\n身体特徴\n乳輪や乳首は大きめでだと嬉しいです\n\nリクエスト内容\nプロデューサー(先輩)の口車に乗せられて限界を突破できる特別レッスンとしておちんぽにガニ股スクワットSEXをし、プロデューサーの巨根チンポ即落ち敗北子宮脱されて子宮を好き放題されてしまう。\n\n希望差分\n①セクシーさ(エロさ)が成長の鍵という説明を受け、「こんな格好をするなんて恥ずかしいわ…」と言いながらもスクワットのポーズで先輩の上に跨る\n②レッスン着を上は胸が出るくらいにたくし上げられ、下も脱がされて先輩の巨根も見せつけられて顔を赤くするも「一番星がおちんちんなんかに負けないわ！」と宣戦布告する。\n③威勢良くスクワットを始めるも一突きで「お゛っ♡」と潮吹き絶頂をしてしまう。\n④腰を掴まれて一気に根元までゴリュッと挿入されて一瞬状況がわからず「おへっ？」とキョトンとした顔になる\n⑤快楽が一気に襲ってきて特大のオホ声アヘ顔&潮吹きアクメをキメる\n⑥アヘって動けなくなったところに追い打ちで大量射精をされる\n⑦チンポを抜くと同時に子宮がデカチンポに強く吸着していたため、子宮も一緒に出てしまう\n⑧ザーメンを垂れ流してる子宮をシコシコされて体験したこともない快感を味わう\n⑨最後に思い切り子宮をギューッとされて潮吹き絶頂\n⑩子宮をぷらーんとさせながらアヘ顔失禁をしてしまう\n\n追記事項\nヱイザン先生の描くアヘ顔やオホ顔がとても好みなので仰け反りはさせずに表情の差分を多めに描いていただけると幸いです。\nまた、セリフなどもよろしければお願いします。\n要望がとても多くなってしまったため、金額不足などありましたら再送処置などをお願いいたします。\n検討のほどよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizieizan/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3472513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9f1cc7f32d850ce3c9a2442c473bf69", "srcset": "https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9f1cc7f32d850ce3c9a2442c473bf69, https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ddf4a0c62f9218703ee971704b25836 2x, https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c2b7938f65432f72d892439603b059c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e4a6e516a0ffef62b53f57dcf333a70", "srcset": "https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e4a6e516a0ffef62b53f57dcf333a70, https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abf868d85f6270dae5b2ccf760b203b4 2x, https://si.imgix.net/39d0645e/uploads/origins/7b789205-b33f-4736-9d46-3cf0027ed948?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e1cff505645baae570b78b8d425a384 3x"}, "body": "再送します。もし、よろしければ、ご一考の程をよろしくお願いします。\n\n『前回は歪原火織編ストーリーの生徒ちゃんの素敵なイラストありがとうございました。今回は同キャラでコミックの方をリクエストさせてください。生徒ちゃんがパパ活で生中出ししてるシーンをお願いします。細かい点ですが、無愛想だけど、でもちゃんと感じちゃってるイメージで。おっぱいの片方が出てる着エロのコマがあるとうれしいです。ご検討の程をよろしくお願いします。』", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizieizan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3472513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d614fae95858c8a23c1abc78a1c4b4c", "srcset": "https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d614fae95858c8a23c1abc78a1c4b4c, https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96bd8d81f04277ce0367cba89b704061 2x, https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6dbebd7576897167ff5e98166a2aa75 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04057690e281d134051779a65732d7c9", "srcset": "https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04057690e281d134051779a65732d7c9, https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc79bfc80c5e5369f6b2c4437f720a29 2x, https://si.imgix.net/3f3be6e4/uploads/origins/7c5b0fec-4ed5-4186-8f88-84fc4e7b78f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57ac6a5fe74f76ece5c54dca266d6609 3x"}, "body": "はじめまして！シャドウバースのキャラクターのイラストを受け付けているとの事でしたので是非とも検討をお願いします。シャドウバースワールドビヨンドの歪原火織編ストーリーの午後0時11分チャプターの黄色いジャケットを羽織った方の生徒ちゃんの着エロイラストを描いていただけないでしょうか？シチュですが太もものホクロと白いパンツが見えるアングルだと嬉しいです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gizieizan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3472513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2ba0650/uploads/origins/333f247d-bc92-443e-9d54-aa10ed67b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&f