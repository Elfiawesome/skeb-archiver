57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ddf3bab9e82dd853dfddac9a109bd18, https://si.imgix.net/062121ed/uploads/origins/dc172dc0-36eb-4684-a913-7e9ff6449157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5458e4722439fdfce32f2b1c60a2dd25 2x, https://si.imgix.net/062121ed/uploads/origins/dc172dc0-36eb-4684-a913-7e9ff6449157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c62a94e548f703e6fa1c4ccc3e8b18d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/062121ed/uploads/origins/dc172dc0-36eb-4684-a913-7e9ff6449157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07ef298237ac1ced8c662157e811d90d", "srcset": "https://si.imgix.net/062121ed/uploads/origins/dc172dc0-36eb-4684-a913-7e9ff6449157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07ef298237ac1ced8c662157e811d90d, https://si.imgix.net/062121ed/uploads/origins/dc172dc0-36eb-4684-a913-7e9ff6449157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bda67e0e123990ddafbe1ddecb0c2afc 2x, https://si.imgix.net/062121ed/uploads/origins/dc172dc0-36eb-4684-a913-7e9ff6449157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c79e839dc2c0834e97a215a0e4fc6ee 3x"}, "body": "お疲れ様です。バカルディです。\n流石に多過ぎるかとも思いつつ依頼です。\n\n自創作で個人的に好きなキャラが出来たのでそれを書いて頂けれたらなと思います。服装等の指定は特にありません。私の中でもふわっとしているキャラなのでご自由にお描きください。\nhttps://x.com/BAKARUDY0912/status/2032636673604137446?s=20\n\nキャンペーンが終わると頻度は下がってしまうと思いますが、定期的に依頼はしたいと思っているのでこれからもよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marimomisadaki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3858797, "client_id": 1383730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c00f9da4a8a1493c84e4c4ed385e3c", "srcset": "https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94c00f9da4a8a1493c84e4c4ed385e3c, https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c39fd15b0d77347b71e64458b9642541 2x, https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b9298efe6782aa66afa1795c565fa28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2596336949dbdbc7e60b6dbc2e7627f9", "srcset": "https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2596336949dbdbc7e60b6dbc2e7627f9, https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f25f435de00ec9ba90e5118a28e5a7a 2x, https://si.imgix.net/c2fa70fb/uploads/origins/cd847d41-877b-4821-a757-734124e065b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3a1330ff017d36437a393190ca88372 3x"}, "body": "まりもみ さだき様、こんにちは。\n(以下、まりもみ様と呼ばせていただきます)\nこの度アピールを頂きました禾ズ真です。\n\nアピール機能に制限が強まった現在のskebにてうちの子を気に入ってくださりお声がけ頂いたこと、とてもありがたく思います。\n過去絵を拝見し、可愛く大きな目の絵柄とアナログ絵ならではの厚みのある塗りの絵に魅力を感じたのでぜひアナログでリクエストさせて頂きたく思います…！\n\nリナリーとフリゼ、どちらをリクエストするかとても迷い決められなかったので今回はまりもみ様の描きたい方を優先していただけると嬉しいです。\n\n資料はこちらになります。\nリナリー\nhttps://note.com/psyan75_17_ra/n/nf22117fe1c2d\n\nフリゼ\nhttps://note.com/psyan75_17_ra/n/nd49c1e4c5f21\n\n■キャラの簡単な解説\n\n・リナリー\nリナリーは青薔薇のアルラウネです。\n自然界に存在しないはずの花から生まれたことで謎が多く、自身の出生の秘密や存在意義を追い求めています。また、青薔薇の花言葉にまつわる奇跡や夢を現実にする才能を秘めています。\n真面目さと無邪気さを併せ持つ性格で、後天的に足を得たため歩く練習が日課です。\n薄青の三つ編みヘアと明るい色の緑肌、青い爪が特徴で、片側の三つ編みの先端が青薔薇に変化しています。(髪を解いた時は消失するかわりに青薔薇の尻尾が生えたりなどします)\n薔薇の棘にあたるピンクの四本ツノがありますが、これは魔力で髪の一部が纏まり硬化したものです。\n\n・フリゼ\n人外が一般化してきた魔法と科学が共存する地球に住んでいるおてんばな雪女亜種です。\n異国生まれの日本育ちで、好物のアイスの食べ過ぎにより変異した子です。\nバニラ色のポニーテール、ミントアイス色の肌、抹茶色の虹彩にブルーベリー色の瞳孔や舌が特徴です。ヘッドホンを外すとエルフ耳だったりします。\nポニーテールは自分の意思でトルコアイスのように伸び自在に操れます。\n\nフリゼの着た服は彼女自身の妖力によりアイスっぽい雰囲気に変化します。チョコミント要素の強い衣装ですが、アイスならゲテモノを除き満遍なく好きです。\n\n説明は以上になります。\nまりもみ様に楽しんで描いていただければ嬉しいです…！\n内容に差し支えなければよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@marimomisadaki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3858797, "client_id": 3858866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff2bd22b/uploads/origins/73f46dae-a285-47bd-a4e5-86640f85b757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ca748e5b388dc4544984f149fb701db", "srcset": "https://si.imgix.net/ff2bd22b/uploads/origins/73f46dae-a285-47bd-a4e5-86640f85b757?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ca748e5b388dc4544984f149fb701db, https://si.imgix.net/ff2bd22b/uploads/origins/73f46dae-a285-47bd-a4e5-86640f85b757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c2e3e3f8e066d466a09b982d1afe49d 2x, https://si.imgix.net/ff2bd22b/uploads/origins/73f46dae-a285-47bd-a4e5-86640f85b757?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=734fab6bcd2d64825b69dcf6a98bf005 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff2bd22b/uploads/origins