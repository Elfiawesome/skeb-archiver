。口を開けば天真爛漫な晴れ女、高身長。  \n\n⟡使用用途  \n収益化済みの配信サムネイルやSNSでの使用  \n(頭や髪の毛、腕などが途切れたりしないようにしていただけますと嬉しいです。)\nメンバー限定の壁紙配布やヘッダー配布\n\n⟡その他 \n人物や背景、表情差分などそれ以外でレイヤー分けされたもの psdデータにていただけますと幸いです。    \n\n使用の際はメンションやXのリンク紐付けにてご紹介させていただきたいです。 \n突然のご連絡失礼いたしました。\n可能であればよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/au3o2k08m3s2zsxdt7txx/.png?rlkey=zfrtkaag6iiys8d0ai6kxrntn&st=pun99kkw&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mofuchyo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3961107, "client_id": 3961602, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3241f051/uploads/origins/8dfd7b6d-a7d7-4219-8654-be09dc24969d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=741568ac72ebe5ab3f1c3541a51491bb", "srcset": "https://si.imgix.net/3241f051/uploads/origins/8dfd7b6d-a7d7-4219-8654-be09dc24969d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=741568ac72ebe5ab3f1c3541a51491bb, https://si.imgix.net/3241f051/uploads/origins/8dfd7b6d-a7d7-4219-8654-be09dc24969d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1fbc84e0f0f4a8592244c103a9a8f33 2x, https://si.imgix.net/3241f051/uploads/origins/8dfd7b6d-a7d7-4219-8654-be09dc24969d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=591a30e5423b1357538d6ca901dbd0fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3241f051/uploads/origins/8dfd7b6d-a7d7-4219-8654-be09dc24969d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98e054f20cd0e7733158860d187a7b2d", "srcset": "https://si.imgix.net/3241f051/uploads/origins/8dfd7b6d-a7d7-4219-8654-be09dc24969d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98e054f20cd0e7733158860d187a7b2d, https://si.imgix.net/3241f0