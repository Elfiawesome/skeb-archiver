と嬉しいです！）\n\n画像形式は透過PNGかPSDを頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@siina____/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3339943, "client_id": 2223302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/130a3219/uploads/origins/a4dbf3ef-34aa-46dd-a1dd-4f55a3190738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22df0876542633e68ab02686fe8d117b", "srcset": "https://si.imgix.net/130a3219/uploads/origins/a4dbf3ef-34aa-46dd-a1dd-4f55a3190738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22df0876542633e68ab02686fe8d117b, https://si.imgix.net/130a3219/uploads/origins/a4dbf3ef-34aa-46dd-a1dd-4f55a3190738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5af6fd154b024053bf5b04af75bdb6c 2x, https://si.imgix.net/130a3219/uploads/origins/a4dbf3ef-34aa-46dd-a1dd-4f55a3190738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdd29860f1cfb12b88f68bcf5c546023 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/130a3219/uploads/origins/a4dbf3ef-34aa-46dd-a1dd-4f55a3190738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38340b54459f9eed9eac83546a76ad05", "srcset": "https://si.imgix.net/130a3219/uploads/origins/a4dbf3ef-34aa-46dd-a1dd-4f55a3190738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38340b54459f9eed9eac83546a76ad05, https://si.imgix.net/130a3219/uploads/origins/a4dbf3ef-34aa-46dd-a1dd-4f55a3190738?bg=%23fff&auto=format%2Ccompr