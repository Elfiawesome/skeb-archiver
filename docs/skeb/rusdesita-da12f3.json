うであればお面は省いていただいて全く問題ございません。\n\n┈┈┈┈┈┈┈┈┈┈\n\n細かいところはらすさんの采配にお任せしたいです。\nにこにこした紫陽花先輩とムスッとした狗鬼灯の対比をらすさんの絵柄で是非また拝見したいなという気持ちです。\n同卓PLさんに共有したり、アイコンに使用させていただいたりできたら嬉しく思います。\n\nhttps://drive.google.com/drive/folders/1jMq-FIH8RIVpTT6jG5q5B7_n_msmFWWC?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsu_gu_ru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2702122, "client_id": 2556553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea5a0737/uploads/origins/ceb79117-0515-4331-9ff9-578046b8979d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef03f7420739575dfcc5a3e8c7ca0e5", "srcset": "https://si.imgix.net/ea5a0737/uploads/origins/ceb79117-0515-4331-9ff9-578046b8979d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ef03f7420739575dfcc5a3e8c7ca0e5, https://si.imgix.net/ea5a0737/uploads/origins/ceb79117-0515-4331-9ff9-578046b8979d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23564e628b6b9306fc111ca7a8d05767 2x, https://si.imgix.net/ea5a0737/uploads/origins/ceb79117-0515-4331-9ff9-578046b8979d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cec38ddbfe5e3fbf77888a2154d3ab11 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea5a0737/uploads/origins/ceb79117-0515-4331-9ff9-578046b8979d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19fa3a7e9c973fd2d0f4b7eaee40df05", "srcset": "https://si.imgix.net/ea5a0737/uploads/origins/ceb79117-0515-4331-9ff9-578046b8979d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19fa3a7e9c973fd2d0f4b7eaee40df05, https://si.imgix.net/ea5a0737/uploads/origins/ceb79117-0515-4331-9ff9-578046b8979d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&