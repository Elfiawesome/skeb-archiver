写、湯気の描写もお願いします\n・行燈の暖色系の光で画面全体を照らしてください\n・全体に散った紅葉と銀杏の葉、桶に入った徳利とお猪口等の小物の描写は雰囲気つくりの為力を入れてください\n・火照らせ、唇がやや赤みを帯び、汗をかかせてください\n\n・差分では男の下半身と挿入、切ない表情、片方の乳房の舐めた涎あと、股間部の愛液の描写をお願いします\n・中出し差分として、アヘ顔気味の表情、溢れた精液、潮吹き、膣内描写（亀頭の先端を僅かに子宮内に入れてください）をお願いします\n\n・キャンパスサイズはA3等の比率でお願いします\n\nお忙しい中恐縮ですが、ご検討よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsumugu_nagato8/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2707448, "client_id": 1190564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9241edd/uploads/origins/7d14384b-106e-4c3b-9210-ea265f140164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1499bec5a374ab7cc38b90b17e9a8b7", "srcset": "https://si.imgix.net/d9241edd/uploads/origins/7d14384b-106e-4c3b-9210-ea265f140164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1499bec5a374ab7cc38b90b17e9a8b7, https://si.imgix.net/d9241edd/uploads/origins/7d14384b-106e-4c3b-9210-ea265f140164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28d74ca52b14bd42a3c952b9dbf6f88e 2x, https://si.imgix.net/d9241edd/uploads/origins/7d14384b-106e-4c3b-9210-ea265f140164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96b18f9b5191edb63426d0725790a037 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9241edd/uploads/origins/7d14384b-106e-4c3b-9210-ea265f140164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e234fcc701859d1fce4f0d499c44d8d", "srcset": "https://si.imgix.net/d9241edd/uploads/origins/7d14384b-106e-4c3b-9210-ea265f140164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e234fcc701859d1fce4f0d499c44d8d, https://si.imgix.net/d9241edd/uploads/origins/7d14384b-106e-4c3b-9210-ea265f140164?bg=%23fff&au