n可能であれば、psdファイル内の別のレイヤーにサインをお願いします\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください\nご検討のほど、何卒よろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@youyongn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3382975, "client_id": 671231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15bc151e1032f3f414051c5bf08172c0", "srcset": "https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15bc151e1032f3f414051c5bf08172c0, https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c84c25ef833ac59f4d79a53480ba3ec 2x, https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a6d75d230e45d78c6a4b65932136335 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a9b8bed0d6baff1d7939b95b078253d", "srcset": "https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a9b8bed0d6baff1d7939b95b078253d, https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2315e437f4078edb2b3dd9add45e965 2x, https://si.imgix.net/88651727/uploads/origins/f653ab64-dd27-4193-a294-42fad085eb6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f504a637ecf8e2ad84d0296855537d2 3x"}, "body": "初めまして！絵がとても気に入っていますので、リクエストさせていただきたいと思います！\n\n下記資料のURLの二人を描いていただきたいです！\n咲苗：辛い過去のため、無感情で無表情になってしまい、生きる意味さえ失った。されたことの復讐を誓い、その後死んでもいいと。\n花：白い菊（真実）\n\n冬夜：咲苗に執着みたいな愛を持つ。彼女のためなら何でもする。過去にあったことは何もできなかったという罪悪感を持っている。すごく恥ずかしいことやったり言ったりするが、行動はほとんど計算ずく。よく自分のこと恥がっている。\n花：勿忘草（真の愛・私を忘れないで）\n\n2人は少し複雑かもしれませんが、ご自由に楽しく描いていただければ幸いです！\n設定などはお好みではなければ、なるべくキャンセルでお願いします。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Ur9D3NKkO7uugNCmqZIGDonQuw-vt22g?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@youyongn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3382975, "client_id": 878973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab4f3769/uploads/origins/3590e434-81b0-4eae-badb-816878c8ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d90267587bfaad8e8730292b7bbf82b5", "srcset": "https://si.imgix.net/ab4f3769/uploads/origins/3590e434-81b0-4eae-badb-816878c8ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d90267587bfaad8e8730292b7bbf82b5, https://si.imgix.net/ab4f3769/uploads/origins/3590e434-81b0-4eae-badb-816878c8ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e15e2ee7a6a8b1e4edf9e5a242f072d6 2x, https://si.imgix.net/ab4f3769/uploads/origins/3590e434-81b0-4eae-badb-816878c8ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a17e65bf0c09a6a7aedf8e5d32dd17e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab4f3769/uploads/origins/3590e434-81b0-4eae-badb-816878c8ed5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=425878e11ec4b4e65ec83e21a76cec2f", "srcset": "https://s