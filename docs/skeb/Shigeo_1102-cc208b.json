Nji3wYs22JBhcVsVM?usp=sharing\n\n使用範囲につきましては、有料小説の宣伝用（SNS）および少部数の印刷物での使用を希望しております。\n\nもしご提示いただく金額がご都合に合わない場合は、金額を修正のうえ、再度ご提案いただいても問題ございません。\nまた、もし内容やご依頼に不都合がございましたら、遠慮なくお断りください。\n\nこの度はご検討いただき、誠にありがとうございます。\nどうぞよろしくお願い申し上げます。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Shigeo_1102/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3488735, "client_id": 3717209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1757f04/uploads/origins/f3cdb928-ad82-40e9-867d-119742cc92a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d262159b1c281221dd333338301a9f7", "srcset": "https://si.imgix.net/e1757f04/uploads/origins/f3cdb928-ad82-40e9-867d-119742cc92a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d262159b1c281221dd333338301a9f7, https://si.imgix.net/e1757f04/uploads/origins/f3cdb928-ad82-40e9-867d-119742cc92a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb1997dfaf4cfb83c83798fc3070c4f2 2x, https://si.imgix.net/e1757f04/uploads/origins/f3cdb928-ad82-40e9-867d-119742cc92a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=538a37b405db7783e79682cffc2ab3a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1757f04/uploads/origins/f3cdb928-ad82-40e9-867d-119742cc92a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0295ce9960b44416cba2d3fee7f8bd83", "srcset": "https://si.imgix.net/e1757f04/uploads/origins/f3cdb928-ad82-40e9-867d-119742cc92a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0295ce9960b44416cba2d3fee7f8bd83, https://si.imgix.net/e1757f04/uploads/origins/f3cdb928-ad82-40e9-867d-119742cc92a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&