webp&fit=crop&crop=top&w=200&h=200&s=d2c244243db7159ab2ae72c2d878e3d2", "srcset": "https://si.imgix.net/26c1f8d3/uploads/origins/a1ced953-68d9-4d4e-b777-de1dfe7d2a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2c244243db7159ab2ae72c2d878e3d2, https://si.imgix.net/26c1f8d3/uploads/origins/a1ced953-68d9-4d4e-b777-de1dfe7d2a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6d44205979ba28bacba281ba970e66b 2x, https://si.imgix.net/26c1f8d3/uploads/origins/a1ced953-68d9-4d4e-b777-de1dfe7d2a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e54f418a45655abd9b4b74755262180 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26c1f8d3/uploads/origins/a1ced953-68d9-4d4e-b777-de1dfe7d2a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8edcfc69ee9337517cc73ef225437bf", "srcset": "https://si.imgix.net/26c1f8d3/uploads/origins/a1ced953-68d9-4d4e-b777-de1dfe7d2a86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8edcfc69ee9337517cc73ef225437bf, https://si.imgix.net/26c1f8d3/uploads/origins/a1ced953-68d9-4d4e-b777-de1dfe7d2a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=619a37d223a2b1e7f175f1a0d2fee411 2x, https://si.imgix.net/26c1f8d3/uploads/origins/a1ced953-68d9-4d4e-b777-de1dfe7d2a86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=163106819e5ae65376754ea60e6ab82c 3x"}, "body": "Hello. The knight mecha you've drawn as requests were amazing, and I was wondering if I could request a similar image that would be used as the cover for a web novel I am currently writing. I'm not sure if that's something you'd be comfortable with, but if not, feel free to decline and I won't be offended.\n\n- The basic robot would be a simple, mass-production military model in dark armor, with ordinary weapons. \n\n- However, the beginning of the story has the main character transported to a medieval world, where their robot is remodeled to resemble the local kind, which resemble knights. It would still have its original frame, but with the armor modified to look like medieval armor.\n\n- In the battle before being transporting, its head was knocked off and has been replaced by a knight's helmet with intimidating eyes. Its weapons were also destroyed, and it now wields a sword and a crossbow.\n\n- These knights are powered by magical gemstones, which have been affixed to the protagonist's machine as well. One would be on its chest, and four smaller ones would be on its arms and legs. \n\n- Since it would be showing off a story, I'd like the robot to be in an eye-catching pose, such as standing with the sword drawn or crouching on one knee. The background would be some plains at night.", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sannbansenzitya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3293678, "client_id": 1883243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b40faab7/uploads/origins/52bc14a3-cf20-46fc-9858-3022b110ecfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c176228fb18af263b8c086c1d2c73ae9", "srcset": "https://si.imgix.net/b40faab7/uploads/origins/52bc14a3-cf20-46fc-9858-3022b110ecfa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c176228fb18af263b8c086c1d2c73ae9, https://si.imgix.net/b40faab7/uploads/origins/52bc14a3-cf20-46fc-9858-3022b110ecfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea18b2cde7bedf04b3d4987ad26a1916 2x, https://si.imgix.net/b40faab7/uploads/origins/52bc14a3-cf20-46fc-9858-3022b110ecfa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14fb53e9eac71141ff718