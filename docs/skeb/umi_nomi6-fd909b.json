h=200&blur=200&s=41e759dbf2634986a63711714f78cef4, https://si.imgix.net/36a4e813/uploads/origins/8a1f9648-4dc4-4805-ab7e-682af127ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea87dc8d8c9d5fbdc6d22da3216751e2 2x, https://si.imgix.net/36a4e813/uploads/origins/8a1f9648-4dc4-4805-ab7e-682af127ec39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9acd2c00d38630f50541372dfd8b091e 3x"}, "body": "初めまして、KOYUと申します。 \nアピールありがとうございました😭\n作品の雰囲気がとても素敵だったため、ぜひｳﾐ様の世界観でうちの子をぜひ描いていただきたくリクエストさせていただきます。  \n\n・希望\n距離が近めのイラスト\n🚺側が🚹側にちょっかいをかけている\n幸せそうな雰囲気\nマフラーやイヤーマフ等冬っぽいモコモコした衣装だと嬉しいです！\nSDや全身もお得意とのことでよろしければ詰め込みだととても嬉しいです。\nその他諸々全てお任せでお願いしたいです。\n\n\n・参考資料 \n男　(紫色)\nhttps://drive.google.com/drive/folders/1-NzwNOOZt_rfYWRHxGnpCFuqG6eNM23z\n\n女　(赤色)\nhttps://drive.google.com/drive/folders/1-EEDT9i8A5djBv4VgRf7cPAkNK43XqOg  \n\n上記に加えskeb内送信リクエスト内\n\n・詳細文\n OC② ディオ\n・髪 \n軽めの髪質のミディアムロング\n(まとめた三つ編みもお気に入り)\n小豆色〜深い紫\n\n前髪は目に少しかかってる\n\n ・目 \nタレ目 くすんだ黄色\n\n得意魔法は癒し(心を操る系)\nよく喋る怪しいお調子者\n底が見えない\n体格が良い\nソルからのスキンシップに顔を赤くする\n\n OC ソル\n・髪 \nふわふわもこもこの赤髪  \n前髪はセンター分け風 \n・目\n切れ長のネコ目(ハイライトは十字のキラキラ) \n薄い水色 \n・口元にほくろ \n・モノクルかけてる  \n\n常に笑顔で優しくリーダーシップのある子 \n得意武器はライフル銃(長い銃)\nディオをいじるのが楽しい(可愛くて仕方ない様子)\n\n ・使用用途 　\n頂いたイラストはSNSアイコンや参考資料への追加pc背景に使用したいと思っています。\n  \n\n不都合があったり、難しいようでしたら断っていただいて大丈夫です。\nとっても好きな絵柄なのでどうぞご縁がありましたらよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umi_nomi6/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3148431, "client_id": 3785808, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d115b110/uploads/origins/0ccf7cf8-e920-474f-b80d-1e1f06411923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10b4c7b867063048eee7cf4e9a1de6b1", "srcset": "https://si.imgix.net/d115b110/uploads/origins/0ccf7cf8-e920-474f-b80d-1e1f06411923?bg=%23fff&auto=for