のSNSでも使用する予定です。料金はいくらでも結構です。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1bUXaOwPnyLO8kaJWZ2eogjh7VChnlG4Y?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umi_nomi6/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3148431, "client_id": 3439041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c0b8425bc06a2f94ad9b025400efa45", "srcset": "https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c0b8425bc06a2f94ad9b025400efa45, https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=827c526e9113b5e600056fe9a063c635 2x, https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7c361299c9726005adc6914fd57f12d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f835faa9b9060bb96b760f282da9deae", "srcset": "https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f835faa9b9060bb96b760f282da9deae, https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ebd0dcbedc3459ac4ac586327c206a7 2x, https://si.imgix.net/8496d68e/uploads/origins/706a7134-466e-4a40-a9b8-91c6471a1aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97b588f6e74b20fff1111a4fbed02197 3x"}, "body": "こんにちは、あなたの作品がとても好きで、ぜひお願いしたくリクエストを送らせていただきました。\n\n描いていただきたいのは、私のOCの少女です。\n彼女は白皮症と妄想症を患っており、長く病院で生活しています。\n\n病の影響で、病院の医師や看護師、他の患者たちを「自分を傷つける怪物」だと幻想しています。\n身を守るために盲目のふりをしていますが、実際は強い近視です。\n周囲への警戒心が強く、人を信じられず冷たく見えますが、本当は安全と理解を求めています。\n\n動きはゆっくりで慎重。\n手探りや観察で「盲目」を装っています。\n病院の庭の柔らかな光の下で過ごすのが好きで、そこだけは少し心が落ち着きます。\n彼女はノートに、幻想の「怪物」たちの特徴や行動を描き留めています。\n\n怪物について\n・裁縫師：細身で、縫い合わせたような黒い影の姿。針を持っている（看護師）\n・白衣の黒影：白衣をまとった黒い霧のような存在。実験をしている（医師）\n・奇形の怪物たち：黒く形の定まらない生物で、それぞれ姿が異なり、廊下をさまよっている（他の患者）\n\n構図はすべてお任せいたします。ご負担をおかけしてしまったら申し訳ありません。\n\n使用用途\n・個人鑑賞\n・SNS掲載\n・完全に個人用としてのグッズ制作\n・今後の依頼資料としての参考\n\nもし金額やその他の条件に不都合がございましたら、大変お手数ですがリクエストをご返却いただければ、改めて修正して再提出いたします。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1d9Utg4EZhMPsx0SuykoeWhSAwJ0xx1W1", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umi_nomi6/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3148431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06e9d67f/uploads/origins/eb320fc5-c2ed-4a99-bef6-77e2420b5535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5a2c524337274b523670518ca0b70bc", "srcset": "https://si.imgix.net/06e9d67f/uploads/origins/eb320fc5-c2ed-4a99-bef6-77e2420b5535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5a2c524337274b523670518ca0b70bc, https://si.imgix.net/06e9d67f/uploads/origins/eb320fc5-c2ed-4a99-bef6-77e2420b5535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1245c188da5a9749ccbc8258e68a0bf1 2x, https://si.imgix.net/06e9d67f/uploads/origins/eb320fc5-c2ed-4a99-bef6-77e2420b5535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=439fdfdb1a49ccd3a61730b5db96142e 3x"}, "duration": null,