ur=200&s=7b14b537011925a4188ef665533fb0b4, https://si.imgix.net/aa22e6e1/uploads/origins/f8d6df7f-caab-485e-b31f-aca5e70e1d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a7395f4146c740b49bcd4a03ba533f7 2x, https://si.imgix.net/aa22e6e1/uploads/origins/f8d6df7f-caab-485e-b31f-aca5e70e1d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb3d2b4f65910accc0330f49bc5977a 3x"}, "body": "skeb募集、お待ちしていました！\n前回の作品が本当に良かったので、また新しく依頼させていただきます。\n\n【キャラ】\n・にじさんじ/月ノ美兎さん\n\n【詳細】\n・https://skeb.jp/@BON_3000/works/12のその後。\n\n【容姿】\n・前回と同じでお願いします。\n\n【構図】\n・背面駅弁でアナルに挿入され、マンコにも別のチンコ挿入されてる。可能であれば両手でチンコを掴んでいて欲しいです。\n\n参考資料 : https://www.pixiv.net/artworks/91652264\n\n【内容】\n・パパのセフレになった美兎。スタッフ達にマンコをシェアさせるので、アナルに挿入する。\n・バイブと子供チンコしか挿入してないアナルはパパのデカチンコを激しく感じてしまう。\n・そんな美兎をよそに激しくピストンするパパに制止を求めるがアナルでイッてしまう。\n・そうしてるうちにスタッフ達が集まり、チンコに囲まれてしまう。\n・パパと同じぐらいの大きさのチンコをマンコにも挿入されてしまい、デカチンで二穴を突かれ激しく感じてしまう。そんな美兎にパパは出して欲しければお願いしろと命令する。\n・命令通りにパパ達に中に出してくださいとお願いする美兎。それを聞き二穴に射精されると同時にイッてしまう。\n・二穴からチンコを抜き、精子が漏れ出す。スタッフ達はまだいるのでこの会合はまだ終わらない\n\n長くなり失礼しました。要望としては以上です。ご検討よろしくお願い申し上げます。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BON_3000/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165942, "client_id": 2158829, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b1c42e680dd798a22a9a8d19ba4bf9", "srcset": "https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96b1c42e680dd798a22a9a8d19ba4bf9, https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bae281efb6a4a33e4b441aaed03489f7 2x, https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ec23a976fde65f4cde4259da283872a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37dd00316f5ce271b005686cb34913fc", "srcset": "https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37dd00316f5ce271b005686cb34913fc, https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a8424e32fc9a3416092644b83f4dba7 2x, https://si.imgix.net/c37927fc/uploads/origins/6b3dedfa-d60f-431c-8c13-70a6d3ee39cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90a91af375f3d8c7c0c9dbe067727f57 3x"}, "body": "はじめまして。Skeb募集、お待ちしていました！\n\n【キャラ】\n ・にじさんじの月ノ美兎さん\n\n【シチュ】\n・BONさんが以前に投稿したシチュhttps://www.pixiv.net/artworks/85847368のその後\n\n【構図】\nhttps://www.pixiv.net/artworks/90239229の下側またはhttps://www.pixiv.net/artworks/87129850みたいにマンコとアナルが丸見え構図\n\n【服装】\nhttps://www.pixiv.net/artworks/86164816のようなおっぱいとマンコとアナルが丸見えの水着\n\n【内容】\n・嫌々ながら上記の服装に着替えさせられた月ノ美兎さんがYTBN父(容姿は太った汚いおっさん)におっぱいを揉まれながら(可能なら乳首責めも)生チンコでマンコを突かれる。セフレにならないかと誘われるが否定する。その後にピストンが激しくなり先に月ノ美兎さんがイッてしまう。\n・文野環(イキすぎて気絶中)さんとヤり終えたYTBN(問題があるようなら容姿を変更)が空いてるアナルにフェラの時に使用したピンクバイブを挿入してほぐし始め再度セフレにならないかと誘われるが否定する。その後激しくバイブでアナルを突かれイク寸前で止められてしまう。(この時マンコにチンコは挿入したまま)。\n・ほぐし終えたアナルにYTBNが生チンコを挿入し父と一緒に二穴を激しく突きはじめる。最初は必死に快楽に耐えるが上々に快楽に堕ちていき最後にはセフレになると宣言し二穴に射精せれると同時にアヘ顔を晒してイッてしまう。(出来たらでいいので最後に二穴からチンコを抜いて精子が溢れ出てくイラストもお願いします)\n\n長くなり失礼しました。要望としては以上です。ご検討よろしくお願い申し上げます。\n\n最後に前までは有償サイトににじさんじの絵を上げることが禁止されていましたが規約の変更で投稿できるようになりました。(ご自身で確認する場合はエニカラ公式の二次創作ガイドラインの6条を読んで頂ければ)", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BON_3000/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 165942, "client_id": 1297131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50a57d070b257dfe09005aab45c3274c", "srcset": "https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50a57d070b257dfe09005aab45c3274c, https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5f75611dcff68a7466dbc404d8bc164 2x, https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd5523f67bfc64fa1a5e1afd77be3305 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8cd15013bf12eac9ce8aeb0c9b25d39", "srcset": "https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8cd15013bf12eac9ce8aeb0c9b25d39, https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a5acda616e9f86565d2120e189aeb12 2x, https://si.imgix.net/2f890ebf/uploads/origins/53d2f398-4bb1-4a37-855b-7648df84b0f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b37c829964b93556a4b206ceea9dd7d0 3x"}, "body": "ぼん先生、こんにちは〜。\n今回は鵜崎華の絵をお願いします。\n\n下のリンクと同じようなポーズ、構図で描いて下さいね\nhttps://www.pixiv.net/artworks/96572310\n元の衣装のまま露出を多くしてほしいです。\n胸は無知なほど大きいです。\n\n個人的にウィンクが嫌いなので、両目は開いています。\n表情はおまかせします。\nお忙しいとは思いますが、ご検討のほどよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BON_3000/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 165942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faa0c5f8d0883657298f044dd4c7b7d1", "srcset": "https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faa0c5f8d0883657298f044dd4c7b7d1, https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd4bf0a817caa96ae5364ece479d3acc 2x, https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31878f50fefbbff244cc5b675ae5a83b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de7916aca6b668dba47c3ba775a55573", "srcset": "https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de7916aca6b668dba47c3ba775a55573, https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=444b57338a646771cb67d2d994b4a35d 2x, https://si.imgix.net/ad8afa4e/uploads/origins/6ee4b9da-8bed-4691-af67-b402253452d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0da2f6cafb46d8f818f2694e99ee5dc3 3x"}, "body": "以前に美琴のリクをした者ですが最高なイラストありがとうございます。\n今回インディアンポーカーの男の続きをお願いします。\n美琴は前回と似たような感じで胸はできれば垂れ乳ではなく普通の貧乳で2ページに分けてもらえたら有難いです。\n\n内容は冬制服の美琴が路地裏に呼び出され両胸が見えるぐらい半裸にされ3Pで立位で男に片足だけ持ち上げられて片乳を弄られながら二穴責めされ美琴はこんな場所で犯さないで！人の気配がするの！(二穴セックスなんて人に見られたら・・・）と言うも\n一晩たったらあんなに乱れたこと忘れてんのかとからかわれあれは一時の快楽で流されて・・・あの時のことは忘れて！と言うととりあえず一発出しとくかと言われ中に出さないで！中が熱い！私もイクー！と一緒にイカされ(ここから美琴の目は\nハートでお願いします。)もう満足したでしょ解放して♡（じゃないと私もう♡）と言うもそのまま続いて休ませて♡イッたばかりで敏感なの♡私の身体またおかしくなっちゃう♡と言うとどうなるんだ淫乱〇学生と言われ(コイツ等セックス上手すぎる♡敵わない♡)\nお願い♡場所変えて♡そしたら何でも言うこと聞くから♡と言うと我慢できないだろと言われ(我慢できない♡もう見られてもいい♡)中出しでイカせて♡と絶頂。仲間がいい物用意してるからついてこいと言われ早く連れてって私の身体もっと犯して♡と言う。\n\nラブホで白バニー姿にされ4Pで首輪をつけられたリールを持っている男のチンポをなめながら仰向けで両手を地面について身体を支えながら両胸が露になり後ろの男から両乳首を弄られながら二穴責めされいいっ♡気持ちいい♡もっと私の\n身体犯して♡と言いやっと堕ちたな淫乱〇学生と言われアンタ達が私の身体をこうしたんだから♡(今日犯されて分かった♡私コイツ達のチンポがないともうダメみたい♡)〇学生にこんな格好させるなんてこのロリコン♡と言うとウサギ狩りさ美琴は俺達みたいな\nロリコンに狩られて調教中のメスウサギってことだと言われなら淫乱〇学生のメスウサギをロリコンのチンポでもっと調教して♡と言い興奮した男達にこんなにいい女はやっぱり俺達だけの物だなと言われアンタ達の物になるから口とマンコとアナルにアンタ達の\n精子頂戴♡とイカされもう美琴は俺達専用の肉便器だからなと言われもっとチンポで淫乱〇学生の身体犯して♡と言う。\n\nよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BON_3000/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 165942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c512835ef1e351c9dc1879eff5fd41", "srcset": "https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c512835ef1e351c9dc1879eff5fd41, https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54592a95072b0fccf232624fe0654109 2x, https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49182e25c8a1717b7b8d253b75f5d71d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7e1ba58078ee212979e394cf96186b9", "srcset": "https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7e1ba58078ee212979e394cf96186b9, https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9546bd7fb7146b35e002f22cb2ef365 2x, https://si.imgix.net/eec9de85/uploads/origins/0d8446bf-0431-4b33-8677-61aa7b784eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d51432c69a731a86371d5842e80e1ac5 3x"}, "body": "FGOの酒呑童子が汚いおじさんに無理やりキスされる姿を見たいです！\n\n汚いおじさん相手にがっしり抱きしめられてディープキスされているシチュです！\n\nキーワードは嫌悪、密着、ディープキスです。 後はお任せしたいと思います！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BON_3000/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 165942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6df89e1/uploads/origins/6f422ace-35c5-4f9a-91e7-4e4196593ed0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f7186f72e101bc3a68b6f26f0027eea", "srcset": "https://si.imgix.net/f6df89e1/uploads/origins/6f422ace-35c5-4f9a-