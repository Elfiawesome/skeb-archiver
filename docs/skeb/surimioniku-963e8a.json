04a\u308a\u307e\u3059\u3001\u7f6a\u4eba\u3068\u7533\u3057\u307e\u3059\u3002\n\n\u524d\u7530\u5869\u3055\u3093\u306e\u30a4\u30e9\u30b9\u30c8\u306e\u5168\u3066\u304c\u672c\u5f53\u306b\u7d20\u6575\u3067\u3001\u96f0\u56f2\u6c17\u304b\u3089\u7dda\u306e\u63cf\u304d\u65b9\u8272\u30c7\u30b6\u30a4\u30f3\u5168\u3066\u304c\u5927\u597d\u304d\u3067\u3059\u3002\n\u3053\u306e\u5ea6\u30b9\u30b1\u30d6\u3092\u958b\u3044\u3066\u3044\u3089\u3063\u3057\u3083\u308b\uff01\uff1f\u3068\u3044\u3046\u3053\u3068\u3067\u4f9d\u983c\u3092\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\u53ef\u80fd\u3067\u3057\u305f\u3089\u3001TRPG\u306e\u81ea\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u25a1\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\n\u30b7\u30ca\u30ea\u30aa\u300cSEVENSTARS\uff06PEACE\u300d\u306e\u81ea\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\n\u3082\u3057\u53ef\u80fd\u3067\u3057\u305f\u30892\u4eba\u306e\u697d\u3057\u305d\u3046\u306a\u96f0\u56f2\u6c17\u306e\u30a4\u30e9\u30b9\u30c8\u3001\u91d1\u984d\u7684\u306b\u8db3\u308a\u306a\u3051\u308c\u3070\u7247\u65b9(\u8336\u9aea\u306e\u7537\u306e\u65b9)\u3067\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\u2026\uff01\uff01\n\n\u25a1\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u3064\u3044\u3066(\u30b7\u30ca\u30ea\u30aa\u30d0\u30ec\u7b49\u306f\u306a\u3057\u3001\u3053\u3061\u3089\u306f\u5168\u3066\u516c\u958b\u60c5\u5831\u3068\u306a\u308a\u307e\u3059)\n\u8eca\u3092\u4f7f\u3063\u3066\u65c5\u3092\u3057\u3066\u3044\u308b\u30022\u4eba\u3068\u3082\u55ab\u7159\u8005\u3067\u3042\u308a\u3001SEVENSTARS\u3068PEACE\u3092\u5438\u3063\u3066\u3044\u308b\u3002\n\u30ad\u30e3\u30f3\u30d7\u30ab\u30fc\u306b\u4e57\u308a\u3001\u8272\u3093\u306a\u3068\u3053\u308d\u3092\u6109\u5feb\u306b\u8d70\u308a\u56de\u3063\u3066\u3044\u308b\u4e8c\u4eba\u3002\ud83d\ude97\u00b3\u2083(\u4e3b\u306b\u697d\u3057\u305d\u3046\u306a\u306e\u306f\u8336\u9aea)\n\n\u611b\u8eca\u306f\u30d5\u30a9\u30eb\u30af\u30b9\u30ef\u30fc\u30b2\u30f3\u306e\u30ef\u30fc\u30b2\u30f3\u30d0\u30b9(\u8d64)\n\n\n\u2606\u30c6\u30aa\u30fb\u30eb\u30fb\u30a8\u30c8\u30ef\u30fc\u30eb (HO\uff1aSEVENSTARS)\n\u30d5\u30e9\u30f3\u30b9\u3068\u65e5\u672c\u306e\u30cf\u30fc\u30d5\u300228\u6b73  183cm\n\u9aea\uff1a\u8336\u9aea        \u76ee\u306e\u8272\uff1a\u8336\u8272\n\n\u8eca\u3092\u904b\u8ee2\u3057\u3066\u3044\u308b\u65b9\u3002\u57fa\u672c\u7684\u306b\u306f\u3054\u6a5f\u5acc\u3067\u5b50\u4f9b\u306e\u3088\u3046\u306b\u306f\u3057\u3083\u3044\u3067\u3044\u308b\u3002\u69cb\u3063\u3066\u8cb0\u3048\u306a\u3044\u3068\u62d7\u306d\u308b\u3002\u5e38\u306b\u5e74\u4e0a\u3068\u306f\u601d\u3048\u306a\u3044\u3088\u3046\u306a\u632f\u308b\u821e\u3044\u3067\u3042\u308a\u3001\u7b11\u3063\u305f\u308a\u6ce3\u3044\u305f\u308a\u3044\u3058\u3051\u305f\u308a\u3059\u308b\u3002\u3075\u3068\u3057\u305f\u6642\u306b\u5f71\u304c\u898b\u3048\u308b\u3002\n\n\n\u2606\u7802\u57dc \u306a\u305a\u306a  (\u3044\u3055\u306e \u306a\u305a\u306a)\n\u65e5\u672c\u4eba\u300221\u6b73  178cm\n\u9aea\uff1a\u767d\u9aea     \u808c\u306e\u8272\uff1a\u8910\u8272     \u76ee\u306e\u8272\uff1a\u9752\u7dd1\n\n\u767d\u9aea\u8910\u8272\u306a\u306e\u306b\u65e5\u672c\u4eba\u3002\u30ca\u30d3\u30b2\u30fc\u30c8\u517c\u66b4\u529b\u62c5\u5f53\u3002\u57fa\u672c\u7684\u306b\u8868\u60c5\u306f\u52d5\u304b\u305a\u3001\u53e3\u6570\u3082\u5c11\u306a\u3044\u3002\u3046\u308b\u3055\u3059\u304e\u308b\u30c6\u30aa\u306b\u5446\u308c\u305f\u308a\u3001\u305f\u3081\u606f\u3092\u3064\u3044\u305f\u308a\u3001\u307b\u307c\u7121\u8996\u3057\u305f\u308a\u3057\u3066\u3044\u308b\u3002\u4e00\u898b\u975e\u5e38\u306b\u51b7\u305f\u3044\u304c\u3001\u5b9f\u306f\u30c6\u30aa\u306b\u3072\u3063\u305d\u308a\u3068\u604b\u3092\u3057\u3066\u3044\u308b\u3002\n\n\u25a1\u95a2\u4fc2\u6027\n\u57fa\u672c\u7684\u306b\u30c6\u30aa(\u8336\u9aea)\u304c\u306a\u305a\u30