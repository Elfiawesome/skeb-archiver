=webp&fit=crop&crop=top&w=200&h=200&s=c55afabca315287c9cd78452cecb171f", "srcset": "https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c55afabca315287c9cd78452cecb171f, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2cdd4fd4fa5d1db85ef50e98f3f001a 2x, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0529130bc522e8f529f0eb3f9c2c6979 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf5cc39a60606a6dd0d43f2e990a13af", "srcset": "https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf5cc39a60606a6dd0d43f2e990a13af, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=316e3c6e0141666325203bb662918181 2x, https://si.imgix.net/d63e3f7f/uploads/origins/4f3b0ed2-5ed1-482c-b64a-e97003704d52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e0c9edfd8d146be432a085bd928b087 3x"}, "body": "こんにちは、はじめまして！以前あなたのアートを見て、スタイルがとても気に入りました。そして、あなたがセールをやっているのを見て、あなたがskebを持っていることに気づいたので、私はリクエストをすることに決めました :3 。ゼノブレイドクロニクル2(https://www.mariowiki.it/images/thumb/0/05/SSBU-Mythra.png/1200px-SSBU-Mythra.png)のマイスラがクリスマスの衣装(こんな感じ: https://x.com/novasvr/status/1995598785163018746?s=20)を着て、顔を赤らめながらプレゼントを渡しているところ(こんな感じ: https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSDMs6eA7uOJ3WSXLc8QTT0tRc9lXzkQhgjJQ&s)を描いてほしいです。できれば、長い髪をなびかせて、胸の谷間を大きく見せてほしい。その他、表情（冷静を装っている、迷惑そうに目をそらしている、慌てているなど）や別シーンなど、バリエーションがあれば自由に追加してください。よろしくお願いします！❤️", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wing223s/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3826124, "client_id": 2412059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/225ae59e/uploads/origins/69013269-6428-4462-a309-9ff5818721a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ecab9f414eca304bfe971d7cadf531", "srcset": "https://si.imgix.net/225ae59e/uploads/origins/69013269-6428-4462-a309-9ff5818721a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ecab9f414eca304bfe971d7cadf531, https://si.imgix.net/225ae59e/uploads/origins/69013269-6428-4462-a309-9ff5818721a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a4349e194963ccda24f6bda1904aa30 2x, https://si.imgix.net/225ae59e/uploads/origins/69013269-6428-4462-a309-9ff5818721a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9606738f1f754927187bc8c6d580d210 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/225ae59e/uploads/origins/69013269-6428-4462-a309-9ff5818721a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2871540c509b7b5631a08c9533c9e9cc", "srcset": "https://si.imgix.net/225ae59e/uploads/origins/69013269-6428-4462-a309-9ff5818721a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2871540c509b7b5631a08c9533c9e9cc, https://si.imgix.net/225ae59e/uploads/origins/69013269-6428-4462-a309-9ff5818721a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6e75e441a79f99a01e24200293c8374 2x, https://si.imgix.net/225ae59e/uploads/origins/690132