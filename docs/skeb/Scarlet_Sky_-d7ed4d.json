291cbc/uploads/origins/acb98c38-b3d5-4ce0-b8bc-2d7e2fff4825?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41e9a87bded258862d169779abe13d0a 3x"}, "body": "空色さん\nお疲れ様です！\n前回はイラストイラ受けてくださりありがとうございます。\n手数料無料期間の最終日で唐突に思いついたのでリクエストを送ります！\n\nリクエスト内容\n私の所でこれから実況を始めるあかりちゃんのイラスト\n\n近いうちに【TEVI】というメトロイドヴァニアで実況動画を出そうと思っているのですが\nその動画内で使えるあかりちゃんの一枚絵をお願いしたいと考えました！\nそのTEVIというゲームの世界観で遊ぶあかりちゃんを描いてほしいなと\n絵柄は空色さんのものでお願いします！\n\n構図とかサイズなども自由にやっていただければと思います。\nまた動画を出してから確認して作ったりなどでもよいので気長にやってもらえれば幸いです。\n\n納品されたものは動画内で紹介などにも使っていきたいと思います\nその時はクレジット表記で空色さんの次のリクエストにもつながるように私も協力していきたいです。\n\nそれではご多忙の中大変恐れ入りますが受けてくだされば嬉しいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Scarlet_Sky_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2782601, "client_id": 291848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ec191d5/uploads/origins/aa71b8bc-cdd2-41a1-8e26-f45ab915f2e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5033ddc09a49ca63e3ce75995c031cf9", "srcset": "https://si.imgix.net/1ec191d5/uploads/origins/aa71b8bc-cdd2-41a1-8e26-f45ab915f2e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5033ddc09a49ca63e3ce75995c031cf9, https://si.imgix.net/1ec191d5/uploads/origins/aa71b8bc-cdd2-41a1-8e26-f45ab915f2e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff1044a6fbff4e4a77fa011d9b51c753 2x, https://si.imgix.net/1ec191d5/uploads/origins/aa71b8bc-cdd2-41a1-8e26-f45ab915f2e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa055735955c6ed4c4f3651ca0b8a32a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ec191d5/uploads/origins/aa71b8bc-cdd2-41a1-8e26-f45ab915f2e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2