f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13ceefd1034bed26a994ec125a6f788e 3x"}, "body": "こんにちは。\nりゅうおうのおしごとの雛鶴あいちゃんと夜叉神天衣ちゃんをお願いできないでしょうか。\n衣装︰マイクロビキニ+猫耳+猫脚+尻尾+赤ランドセル、差分でランドセルや衣装に使用済みコンドームをたくさん引っ掛けて欲しいです。\nまた雛鶴あいちゃんは白色、夜叉神あいちゃんは黒色のビキニ、猫衣装でお願いします。\nポーズ︰エロ蹲踞のポーズ\n\nその他の細かい構図や表情はお任せします。\nもし良ければよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@9RVCLK5P/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1297521, "client_id": 133763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bd96eb4/uploads/origins/a255945f-9dd5-4333-9d8b-9b20f849032e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3974015b561cbb703fba1e3231fc1c2b", "srcset": "https://si.imgix.net/3bd96eb4/uploads/origins/a255945f-9dd5-4333-9d8b-9b20f849032e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3974015b561cbb703fba1e3231fc1c2b, https://si.imgix.net/3bd96eb4/uploads/origins/a255945f-9dd5-4333-9d8b-9b20f849032e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec269f2733ebfa4b9295c2672c030bc 2x, https://si.imgix.net/3bd96eb4/uploads/origins/a255945f-9dd5-4333-9d8b-9b20f849032e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2438d2f277a39e14655fde9e097041a2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bd96eb4/uploads/origins/a255945f-9dd5-4333-9d8b-9b20f849032e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a0163c4f44ecc2487b293d29fc63928", "srcset": "https://si.imgix.net/3bd96eb4/uploads/origins/a255945f-9dd5-4333-9d8b-9b20f849032e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a0163c4f44ecc2487b293d29fc63928, https://si.imgix.net/3bd96eb4/uploads/origins/a255945f-9