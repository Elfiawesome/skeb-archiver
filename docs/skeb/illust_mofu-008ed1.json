%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=062b37cef8107599576f77882ab7c1bc", "srcset": "https://si.imgix.net/30f756a3/uploads/origins/7a6d22e5-54aa-43a5-840c-20005d08c76a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=062b37cef8107599576f77882ab7c1bc, https://si.imgix.net/30f756a3/uploads/origins/7a6d22e5-54aa-43a5-840c-20005d08c76a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6ac09928d980c220f4a3d0d3ec21ec1 2x, https://si.imgix.net/30f756a3/uploads/origins/7a6d22e5-54aa-43a5-840c-20005d08c76a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c459bc1697a78ca0cd54f12e5c258204 3x"}, "body": "\u500b\u4ebaVtuber\u3068\u3057\u3066\u6d3b\u52d5\u3057\u3066\u304a\u308a\u307e\u3059\u3001\u3046\u3089\u98ef\u7d3a\u6c70\u3068\u7533\u3057\u307e\u3059\u3002\nSD\u30a4\u30e9\u30b9\u30c8\u3092\u63cf\u3044\u3066\u6b32\u3057\u304f\u3054\u4f9d\u983c\u3055\u305b\u3066\u9802\u304d\u307e\u3059\ud83d\ude47\u200d\u2640\ufe0f\n\n\uff1c\u4f7f\u7528\u7528\u9014\uff1e\n\u30fb\u53ce\u76ca\u5316\u6e08\u307f\u306eYouTube\u30c1\u30e3\u30f3\u30cd\u30eb\u3067\u306e\u4f7f\u7528\uff08\u914d\u4fe1\u3001\u52d5\u753b\u3001\u30b5\u30e0\u30cd\u30a4\u30eb\u306a\u3069)\n\u30fblitlink\u3084\u9031\u9593\u4e88\u5b9a\u8868\u3001SNS\u4f7f\u7528\n\u30fbFANBOX(\u4ed6\u652f\u63f4\u30b5\u30a4\u30c8\u3084\u30d5\u30a1\u30f3\u30af\u30e9\u30d6\u30b5\u30a4\u30c8\u542b\u3080)\u3084\u30e1\u30f3\u30d0\u30fc\u30b7\u30c3\u30d7\u3067\u306e\u4f7f\u7528\u3001\u7279\u5178\u3068\u3057\u3066\u914d\u308b\u5f85\u3061\u53d7\u3051\u30ab\u30ec\u30f3\u30c0\u30fc\u3084\u30d8\u30c3\u30c0\u30fc\u3001\u58c1\u7d19\u3001\u30fb\u30cd\u30c3\u30c8\u30d7\u30ea\u30f3\u30c8\u7b49\u305d\u306e\u4ed6\u7279\u5178\u306a\u3069\n\u30fb\u672a\u78ba\u5b9a\u3067\u306f\u3054\u3056\u3044\u307e\u3059\u304c\u30b0\u30c3\u30ba\u8ca9\u58f2(\u6848\u4ef6\u542b\u3080)\u3082\u3055\u305b\u3066\u9802\u304d\u305f\u3044\u3067\u3059\u3002\n\uff08\u4e0a\u8a18\u4f7f\u7528\u6642\u3001\u30c8\u30ea\u30df\u30f3\u30b0\u3084\u9802\u3044\u305f\u900f\u904e\u30c7\u30fc\u30bf\u306b\u80cc\u666f\u3084\u7d20\u6750\u3092\u5408\u308f\u305b\u305f\u308a\u306a\u3069\u306e\u52a0\u5de5\u3092\u3055\u305b\u3066\u9802\u304d\u305f\u3044\u3067\u3059\u3002)\n\n\uff1c\u5e0c\u671b\uff1e\n\u30fb\u901a\u5e38\u8863\u88c5(\u548c\u88c5)\u3067\u30dd\u30fc\u30ba\u3084\u8868\u60c5\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\n\u30fb\u51fa\u6765\u308c\u3070\u76f8\u65b9\u306e\u30bb\u30ad\u30bb\u30a4\u30a4\u30f3\u30b3\u3092\u4e00\u7dd2\u306b\u63cf\u3044\u3066\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u30fb\u304a\u9854\u306e\u96f0\u56f2\u6c17\u306f\u53ef\u611b\u3044\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\u30fb\u53ef\u80fd\u3067\u3042\u308c\u3070\u80cc\u666f\u3068\u4eba\u7269\u304c\u5206\u304b\u308c\u3066\u3044\u308b\u900f\u904e\u30c7\u30fc\u30bf(png\u307e\u305f\u306fPSD\u30c7\u30fc\u30bf)\u3092\u9802\u304d\u305f\u3044\u306e\u3068\u3001\u982d\u3084\u9aea(\u8033)\u304c\u5207\u308c\u3066\u3044\u306a\u3044\u30a4\u30e9\u30b9\u30c8\u3092\u5e0c\u671b\u3057\u3066\u3044\u307e\u3059\u3002(\u69cb\u9020\u7684\u306b\u5207\u308c\u3066\u3057\u307e\u3046\u5834\u5408\u3001PSD\u30c7\u30fc\u30bf\u306b\u3066\u5207\u308c\u3066\u3044\u306a\u3044\u30c7\u30fc\u30bf\u3092\u9802\u3051\u307e\u3059\u3068\u5927\u5909\u52a9\u304b\u308a\u307e\u3059\u3002)\n\n\uff1c\u7279\u5fb4\uff1e\n\u30fb\u982d\u306b\u30ad\u30e7\u30f3\u30b7\u30fc\u306e\u900f\u660e\u306a\u304a\u672d\u304c\u3042\u308a\u307e\u3059\n\u30fb\u76ee\u306e\u4e0b\u306b\u8d64\u3044\u96eb\u6a21\u69d8(3\u70b9\u3065\u3064)\u304c\u3042\u308a\u307e\u3059\n\u30fb\u9aea\u306e\u6bdb\u306f\u6240\u3005\u306b\u6c34\u8272\u306e\u30b0\u30e9\u30c7\u30fc\u30b7\u30e7\u30f3\u304c\u3042\u308a\u307e\u3059\n\u30fb\u76ee\u306e\u4e2d\u306b\u306f\u7fbd\u304c\u3042\u308a\u307e\u3059\u3002\n\u30fb\u666e\u6bb5\u306f\u4e5d\u5c3e\u3067\u3059\u304c\u90e8\u5c4b\u7740\u8863\u88c5\u306f\uff11\u672c