a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37de157047007ed0a440758f77db184a", "srcset": "https://si.imgix.net/de06959e/uploads/origins/c34c629e-77b8-4b5a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37de157047007ed0a440758f77db184a, https://si.imgix.net/de06959e/uploads/origins/c34c629e-77b8-4b5a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d380caadf0079cb314c9ec3ba57222a5 2x, https://si.imgix.net/de06959e/uploads/origins/c34c629e-77b8-4b5a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9595d846078289db231ac6d6fabb1277 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de06959e/uploads/origins/c34c629e-77b8-4b5a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=802d0370e8709f50921aa17e43c61c7c", "srcset": "https://si.imgix.net/de06959e/uploads/origins/c34c629e-77b8-4b5a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=802d0370e8709f50921aa17e43c61c7c, https://si.imgix.net/de06959e/uploads/origins/c34c629e-77b8-4b5a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0750256e6f5ed35adc82f9f541d93748 2x, https://si.imgix.net/de06959e/uploads/origins/c34c629e-77b8-4b5a-8cae-a014538c5eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd5b87efe306ce55d0150f7e44539999 3x"}, "body": "こんにちは、こうみｼｬﾝﾀﾝさんが描くイラストが大好きなので、ご依頼させていただきます。\n\n内容はキャラクター2人の絡み絵を僕のオリジナルキャラとよその子のオリジナルキャラ(依頼許可もらってます)を描いて頂きたいです。\n使用用途は、Twitter、Twitchなどでのアイコンや動画、配信、個人利用のグッズ化などです。\n\n①黒髪のOC\n・ダウナー系\n・髪型(黒髪ウルフカット　インナーは暗めの青)\n・装飾品(片耳に小さいピアス(参考資料：黒髪のOC1～4) ,左にヘアピン2本(参考資料：黒髪のOC4,5))\n・OC4のような黒い猫耳カバーのスマホを持ってる事が多いです(描いても描かなくてもお任せします)\n・ケモ耳は猫耳(耳の中などがなく表面がすべすべの猫耳)\n参考資料\n　Googleドライブの\"黒髪のOC\"フォルダ内にある、OC1が基本のOC1～5です。\n\n②よその子のOC\n・あざとい系\n・髪型(白髪ボブ)\n・装飾品(左にヘアピン二本、右にリボンとドーナツのような輪っか)は参考資料(よその子-1～3)の通り\n・ケモ耳は猫耳(耳の中にふわふわあり)\n参考資料\n　Googleドライブの\"白髪のOC\"フォルダ内にある、よその子1～3です。\n\nできれば白髪の子の方は黒髪の方がずっと引っ付いていたいぐらい大好きなのでその感じがわかると嬉しいです。\n2人の服装はおまかせしたいです。\n\nまた、もし可能であればキャラ単体のイラストもいただけると嬉しいです。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1VWVgq7MJ_8vn9cewS_kk7hG3X0PBJhwM?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@asebi_564/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1591944, "client_id": 80610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c323be5/uploads/origins/846441ce-837e-4f3a-9878-d69e08ffc1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10568c46069475e35a7ed4d1d967a4ba", "srcset": "https://si.imgix.net/6c323be5/uploads/origins/846441ce-837e-4f3a-9878-d69e08ffc1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10568c46069475e35a7ed4d1d967a4ba, https://si.imgix.net/6c323be5/uploads/origins/846441ce-837e-4f3a-9878-d69e08ffc1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f000d6f4ad62cfe58813436c6c6833cd 2x, https://si.imgix.net/6c323be5/uploads/origins/846441ce-837e-4f3a-9878-d69e08ffc1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0b798ef3eb1b8f387c0feb3615e6f62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c323be5/uploads/origins/846441ce-837e-4f3a-9878-d69e08ffc1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6a5ea286be8e7a1fe7c42969d4f6737", "srcset": "https://si.imgix.net/6c323be5/uploads/origins/846441ce-837e-4f3a-9878-d69e08ffc1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6a5e