65657868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38c8a3fc56325acf4e6db0a3c7eabda8, https://si.imgix.net/acf18164/uploads/origins/56bdbc8e-c833-4fa5-80f5-180365657868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1e2d203d72740d2d5710f25ce2a46b0 2x, https://si.imgix.net/acf18164/uploads/origins/56bdbc8e-c833-4fa5-80f5-180365657868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aac06be747d305aeb667a232d399165b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acf18164/uploads/origins/56bdbc8e-c833-4fa5-80f5-180365657868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f93e5024e84d4e8f4da60f1721b0a156", "srcset": "https://si.imgix.net/acf18164/uploads/origins/56bdbc8e-c833-4fa5-80f5-180365657868?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f93e5024e84d4e8f4da60f1721b0a156, https://si.imgix.net/acf18164/uploads/origins/56bdbc8e-c833-4fa5-80f5-180365657868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45e60e310a2ed4ca6ce7f8220e83c36f 2x, https://si.imgix.net/acf18164/uploads/origins/56bdbc8e-c833-4fa5-80f5-180365657868?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e93aa404262ac678e0e2804dafbb7d8a 3x"}, "body": "ももさん、こんにちは。\nいつもたくさんの素晴らしいイラストを拝見させていただきありがとうございます。\n\nもうすぐ私の誕生日なので、心機一転と自分へのプレゼントを兼ねてSNSアイコン用のイラストをお願いしたく参りました。\n\n白い髪に紫と緑のオッドアイの女の子を、前回とはまた違ったテイストで描いていただけたらと思います。\n(カラーパレットとして好きなだけで、前回のテイストが気に入らなかったとかではないです！)\n(その節も素晴らしい作品をありがとうございました！！)\n\n最近悪役令嬢系にはまっているので、できれば優しげな感じよりは凛とした雰囲気だと嬉しいです。\nいつものことながらももさんの笑顔のイラストが好きなので、笑っているイラストだとたいへん喜びます。\n\nご検討よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_momo_momo_mo_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "