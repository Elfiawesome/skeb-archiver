w=200&h=200&blur=200&s=f96b39e7b9648fc2a44fdd5d925b277a 3x"}, "body": "先日描かれていたこちらのキャラクター（https://twitter.com/nakamalily/status/1795477085609480311）のイラストをお願いしたいです。\nできればダンスレッスンで着るようなオーバーサイズのトップスやジョガーパンツのような、緩め雰囲気のファッションで見てみたいです。（参考：https://www.instagram.com/p/C5OUYaLvfWa/）\nデザイン等はおまかせします。難しいかもしれませんがよろしくお願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@duka_nkdk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3242006, "client_id": 785992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e45137ec15e3208cb0872f81ff30303a", "srcset": "https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e45137ec15e3208cb0872f81ff30303a, https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbdb14596ac8da8c2fd48db4b5cbb2b5 2x, https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3703b7a0479fe6654076c20a34b5c3f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00641ca9657cd87e599065883feea252", "srcset": "https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00641ca9657cd87e599065883feea252, https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41eb674fb0154fc65eac3889e0f6ec4d 2x, https://si.imgix.net/41cf3acb/uploads/origins/83fda8bc-8ab4-412a-9cae-7e2b78345441?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc21ebd3576efcb5616bb0e5bcbfbb48 3x"}, "body": "はじめまして。\nduka様の描かれるアイマスイラストが大好きで、いつも楽しく拝見しております。特に貴音が可愛らしいドレスを着ている作品が大好きです！\nこの度Skeb開設されたと聞いて、リクエストを送付いたしました。\n検討頂けると幸いです。\n\n【リクエスト内容】\n\n・当方の一時創作のキャラクター\n・容姿19歳程度/160cm/子供っぽく天真爛漫な性格\n・アンドロイドの女の子で、自分を作ってくれた人に恋をしている\n・口元のホクロ、黒い瞳に四角いハイライト、金のピアスが特徴\n・服装・髪形のアレンジ可能です。（いつも色々な格好をさせているので）\n・もし可能であれば、普段描かれているようなガーリィな衣装を着せてもらえたら嬉しいです\n\n描きやすいように描いて頂けたら幸いです！\n\n【使用目的】\n・個人観賞\n・当方がホームページやブログを開設した際、依頼した作品として作者情報付きで掲載\n\n宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/geri4qoq97tnn1f5fi5ci/h?rlkey=9btg7dxxzh4276s1x5lum67at&e=1&st=7te6mmtf&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1258342, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "溟埜", "screen_name": "umiiiooo", "avatar_url": "https://pbs.twimg.com/profile_images/1609230208703533056/zQE2SCoR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1378340501670096900/1754806836/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 1986210, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "垢移動", "screen_name": "nubakko", "avatar_url": "https://pbs.twimg.com/profile_images/1531933397182218242/Md6pYnaY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1280339720057192449/1654075827/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_