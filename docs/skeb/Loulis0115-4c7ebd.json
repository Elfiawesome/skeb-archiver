u96e2\u611f\n\u898b\u3064\u3081\u5408\u3044\u306a\u304c\u3089\u4e21\u624b\u3092\u604b\u4eba\u7e4b\u304e\n\u958b\u3044\u305f\u81a3\u53e3\u304b\u3089\u611b\u6db2\u3092\u6ea2\u308c\u3055\u305b\u51e6\u5973\u819c\u304c\u898b\u3048\u3066\u3044\u308b\u72b6\u614b\u3067\u633f\u5165\u5f85\u3061\n\u2193\n\u548c\u59e6\u6b63\u5e38\u4f4d\u51e6\u5973\u55aa\u5931(\u6839\u5143\u307e\u3067\u633f\u5165\u3057\u3066\u6d41\u8840)\n\u2193\n\u30d4\u30b9\u30c8\u30f3(\u767d\u304f\u6ce1\u7acb\u3063\u305f\u611b\u6db2=\u672c\u6c17\u6c41\u304c\u7aff\u306b\u7d61\u307f\u3064\u3044\u3066\u3044\u308b)\n\u2193\n\u6839\u5143\u307e\u3067\u62bc\u3057\u8fbc\u3093\u3067\u4e0b\u534a\u8eab\u3092\u5bc6\u7740\u3055\u305b\u3001\u5b50\u5bae\u53e3\u306b\u62bc\u3057\u4ed8\u3051\u306a\u304c\u3089\u7834\u74dc\u4e2d\u51fa\u3057\u3068\u540c\u6642\u306b\u7d76\u9802\n\u8179\u90e8\u301c\u30b9\u30ab\u30fc\u30c8\u2192\u5927\u91cf\u306b\u4e2d\u51fa\u3057\u3055\u308c\u305f\u7cbe\u6db2\u304c\u6ea2\u308c\u3066\u7d30\u304b\u304f\u98db\u3073\u6563\u3063\u3066\u3044\u308b\n\u7d50\u5408\u90e8\u53ca\u3073\u5468\u8fba\u2192\u7834\u74dc\u306e\u8840\u30fb\u672c\u6c17\u6c41\u30fb\u7cbe\u6db2\n\u304a\u5c3b\u306e\u4e0b\u306e\u30b9\u30ab\u30fc\u30c8\u88cf\u2192\u8840\u30fb\u672c\u6c17\u6c41\u30fb\u7cbe\u6db2\u304c\u6df7\u3058\u308a\u5408\u3044\u306a\u304c\u3089\u7d50\u5408\u90e8\u304b\u3089\u6d41\u308c\u843d\u3061\u3066\u6e9c\u307e\u3063\u3066\u3044\u308b\n\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n(\u8840\u30fb\u672c\u6c17\u6c41\u30fb\u7cbe\u6db2\u3092\u305d\u308c\u305e\u308c\u30aa\u30f3\u30aa\u30d5\u53ef\u80fd\u306b\u3057\u3066\u9802\u3051\u308b\u3068\u6357\u308a\u307e\u3059)\n\u8868\u60c5\u306f\u76ee\u3092\u7d30\u3081\u305a\u3001\n\u7709\u3092\u516b\u306e\u5b57\u306b\u305b\u305a\u3001\n\u53e3\u3092\u300c\u3042\u300d\u306e\u5f62\u306b\u5927\u304d\u304f\u958b\u3044\u3066\u820c\u306f\u51fa\u3055\u306a\u3044\u30c8\u30ed\u30c8\u30ed\u3067\u5e78\u305b\u305d\u3046\u306a\u304b\u308f\u3044\u3044\u9854\n\u2193\n\u81a3\u5185\u5c04\u