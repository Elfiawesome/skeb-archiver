なように自由に描いて頂きたいです…✽\n\n一応、ざっくりキャラ設定ですが、殺し屋をしていて、機械系にとても強い、20歳です。性格は基本的に無表情がデフォの落ち着いた感じです…喜怒哀楽はちゃんとありしっかり顔にも出ます。変身能力を持っています…あとは甘いものすきです\n\n外見ですが画面に向かってピアスが左4右2です…服装は黒に近い濃いめ紺の普通スーツです。あとは添付画像の通りです…！大体で大丈夫です！\n\n…こんなところでしょうか！本当に未人工さんのご自由に描いていただきたいです…！あとこれからも応援してます…！よろしくお願いいたします！🎀\n\nhttps://drive.google.com/drive/folders/1-8MmZS7YaVYZzWEl8pdIFfO3ZjVHh5A-", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1781075, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "小沼", "screen_name": "konu__ma5", "avatar_url": "https://pbs.twimg.com/profile_images/1419450104000376832/yDjvYitL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1342226345556758528/1642963836/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1816727, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "がく", "screen_name": "noutenki_gaku", "avatar_url": "https://pbs.twimg.com/profile_images/1470567439033274372/izaa9IW-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1453599097319952386/1710506074/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 49}, {"id": 2191839, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "くるぽん", "screen_name": "kurupontaberu", "avatar_url": "https://pbs.twimg.com/profile_images/1682443673374724096/Gn2wAz9i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1484224044220444672/1671730397/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_ra