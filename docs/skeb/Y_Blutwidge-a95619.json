press&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abf6d159d5e9c97bffad5f5a1801461e", "srcset": "https://si.imgix.net/b901aebb/uploads/origins/25396a62-f903-45d1-95c9-08cfb0bbe1cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abf6d159d5e9c97bffad5f5a1801461e, https://si.imgix.net/b901aebb/uploads/origins/25396a62-f903-45d1-95c9-08cfb0bbe1cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b35eb930fed68d769f1bf1a5ff5595f 2x, https://si.imgix.net/b901aebb/uploads/origins/25396a62-f903-45d1-95c9-08cfb0bbe1cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=779c138a0c1549d88371fe1c03400735 3x"}, "body": "こんにちは！\n\nゼノブレイド2(https://xenoblade.fandom.com/wiki/Pneuma)のプネウマのアートワークを作ってくれませんか？彼女の胸のサイズと、見えるのであればお尻のサイズを大きくして、胸の上に緑色のコアクリスタルを描くのを忘れないでください。\nセクシーなシチュエーションを作ってください。自分で選んでもいいですが、胸を見せると最高です。彼女がゲーム内で着ているコスチュームを与えるか、ランジェリーやビキニなど新しいものを与えるか、あなたが思い描く作品にふさわしいものを決めてください。ありがとうございました！\n\nオプション：もし予算内で、あなたの考えているアートに合うのであれば、グリマー（https://xenoblade.fandom.com/wiki/Glimmer）も追加できます。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Y_Blutwidge/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 633254, "client_id": 132656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c315dc09bb0cb2b8f1531833c32aa8b3", "srcset": "https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c315dc09bb0cb2b8f1531833c32aa8b3, https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78a937a3286620b46f623c32e5f54fea 2x, https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=463883054d08a825846552b2ed02c91f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faf7183660b4767c47df9ce9f0d3cb3f", "srcset": "https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faf7183660b4767c47df9ce9f0d3cb3f, https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ef868c4e20411c581832f0c0d9b083d 2x, https://si.imgix.net/0ca0d731/uploads/origins/0898e172-97c6-4d06-9b2e-4f74febdebfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cadf2adfe6cf66d0053fed49c6adca1 3x"}, "body": "こんにちは。お世話になります。今回させていただきます依頼内容は以下の通りでございます。\n\n●キャラクター\n宮本武蔵(水着)\n\n●状況\n日焼けした武蔵ちゃん。水着を引っ張ってずらすことで、日焼け跡を見せつけている。\n\n●表情\nいたずら・からかいを込めた笑顔。\n\n●水着\n第2再臨の星条旗っぽいビキニ。\n\n「どの程度のずらし方なのか」につきましては本依頼の主題が「日焼け跡の見せつけ」のため、大胆なのかチラリなのか、ご判断にお任せいたします。\n\n背景を含め、上述以外に指定はございません。どうかよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Y_Blutwidge/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 633254, "client_id": 132656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2256187eff3e90a38d805c989e150f07", "srcset": "https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2256187eff3e90a38d805c989e150f07, https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3138c6455a99899d1bc214931d31a725 2x, https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7ee572d4ed3ff04bbd041f8fcd750c1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a06fbbccda1d3181fb9f5dc6665d2fce", "srcset": "https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a06fbbccda1d3181fb9f5dc6665d2fce, https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3dd2ee978852eaa85c0cafc0d5fe72d2 2x, https://si.imgix.net/cae54d64/uploads/origins/d82c026d-0587-4a0f-80e2-0d337be5be94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a4efbf32a2e08965d67b22317306c31 3x"}, "body": "こんばんは。いつもお世話になっております。\n今回も、水着スカサハでのリクエストを送信させていただきます。お願いできますでしょうか。\n\n●状況\n砂浜にて胸で棒アイスを挟み、先端を舐めているもの。アイスは少し溶けて垂れている。\nいわゆる疑似パイフェラの構図。\nアイスの冷たさに少し困惑の表情を浮かべている。\n\n以上になります。\nご都合よろしければご検討ください。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Y_Blutwidge/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 633254, "client_id": 132656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd4849fb/uploads/origins/c0202a87-d468-4e13-a399-52f