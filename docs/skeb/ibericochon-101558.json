やももの綺麗セクシーな線、パンプス込みの長い脚の存在感、ロングコート裾の布感が好きです！\n\n淡い色も濃い色も自由自在でまったく浮くことがない美しい色選び、キャラらしい生き生きした表情とポーズ、フェチのあふれる下半身、どれをとっても本当に大好きです。色々と書いてしまいましたが、ぜひ基本おまかせで、でいたく様のセンスで新衣装伊縁こしょんを描いて頂きたく存じます。\n\nお忙しい中大変恐れ入りますが、ぜひご検討頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1lXZLkXXQYmtRrv5Jmhi8JH8DoPTsZGPd?usp=sharing\n\nhttps://drive.google.com/drive/folders/1lXZLkXXQYmtRrv5Jmhi8JH8DoPTsZGPd?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@catsmelted/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2773378, "client_id": 3017728, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b53b8f8e/uploads/origins/70aa8120-1b71-47eb-8152-11ae4b55b955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d83a00360ee028bc071d9a1a883f30a", "srcset": "https://si.imgix.net/b53b8f8e/uploads/origins/70aa8120-1b71-47eb-8152-11ae4b55b955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d83a00360ee028bc071d9a1a883f30a, https://si.imgix.net/b53b8f8e/uploads/origins/70aa8120-1b71-47eb-8152-11ae4b55b955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ded9c0275eda8fd09fcfea73fe86e567 2x, https://si.imgix.net/b53b8f8e/uploads/origins/70aa8120-1b71-47eb-8152-11ae4b55b955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85d1a838dd0eec0ab22c373c5fef9124 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b53b8f8e/uploads/origins/70aa8120-1b71-47eb-8152-11ae4b55b955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fdb3892d812b4f03efd4c9f4b37e4ba", "srcset": "https://si.imgix.net/b53b8f8e/uploads/origins/70aa8120-1b71-47eb-8152-11ae4b55b955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fdb3892d812b4f03efd4c9f4b37e4ba, ht