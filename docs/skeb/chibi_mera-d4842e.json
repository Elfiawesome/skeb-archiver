s/origins/c985028c-3a0d-4953-a8bf-e2f2c744b6d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bd370103384c47a339d42915a821122 3x"}, "body": "はじめまして。VTuberデビューに向けて準備中の苺庭ちひろ（いちにわ・ちひろ）と申します。\nちみっとしてかわいらしい絵柄に惹かれまして、ぜひめーさまに活動で使用するイラストを依頼したくリクエストをお送りします！\n\n◆依頼内容\n「苺庭ちひろ」のデフォルメイラスト。\nおとものうさぎの「うとちゃん」も一緒に描いて頂けますと嬉しいです。\n背景や飾り等を一緒に添えていただける場合は、レイヤーを分けてくださいますと活動に使用しやすく助かります。\n\n◆キャラクター資料\n「苺」×「不思議の国のアリス」がモチーフのVTuberです。\n本編のアリスと同様に好奇心旺盛で、おともの白うさぎ、「うとちゃん」に導かれて現実世界から不思議の国にやってきた女の子です。\n不思議の国の一角に存在する「苺の庭園」を気に入り、時間を見つけては現実世界を抜け出して苺の庭でのんびり遊んでいます。\n資料URLにて立ち絵や三面図、コンセプトストーリー等を格納しておりますのでご確認ください。\n\n◆使用用途\n苺庭ちひろ本人のVTuber活動全般（配信サムネイル、SNSアイコンやヘッダー・告知、ファンクラブ特典など）\n\nお手数をおかけしますが、もしご都合が合いましたらご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-1yiKZqFXbAWkpBBrTyDwbZ-jB9KO5ts?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2435651, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "時雨。", "screen_name": "sigure0210", "avatar_url": "https://pbs.twimg.com/profile_images/1969444301643137026/chquw2qO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1521028186787700742/1758385180/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 144}, {"id": 2802264, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "uzsio", "screen_name": "uzsio00", "avatar_url": "https://pbs.twimg.com/profile_images/1918557391215575040/5G5lG9vv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1499000859040321537/1746254646/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at":