73\u7d20\u3088\u308a\u304a\u4e16\u8a71\u306b\u306a\u3063\u3066\u304a\u308a\u307e\u3059\u3002\n\u4eca\u56deOC\u540c\u58eb\u306e\u3075\u305f\u306a\u308a\u767e\u54083P\u3092\u66f8\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u3001\u3054\u9023\u7d61\u81f4\u3057\u307e\u3057\u305f\u3002\n\u4ee5\u4e0b\u3001\u4e16\u754c\u89b3\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a2d\u5b9a\u7b49\u306b\u306a\u308a\u307e\u3059\u3002\n\n\u300a\u3069\u3093\u306a\u8a71\u304c\u8aad\u307f\u305f\u3044\u304b\u300b\n\u30aa\u30e1\u30ac\u30d0\u30fc\u30b9\u3068DomSub\u30e6\u30cb\u30d0\u30fc\u30b9\u306e\u30d0\u30fc\u30b9\u6df7\u5408\u3075\u305f\u306a\u308a\u767e\u54083P\u3067\u3001\u30da\u30cb\u30d0\u30f3\u88c5\u7740\u3057\u305f\u653b\u30811\u306b\u3088\u308b\u53d7\u3051\u306e\u30a2\u30ca\u30eb\u3078\u306e\u633f\u5165(\u524d\u7acb\u817a\u8cac\u3081\u30fb\u7d50\u8178\u8cac\u3081\u6709)\uff0b\u653b\u30812\u306b\u306b\u3088\u308b\u53d7\u3051\u306e\u5973\u6027\u5668\u3078\u306e\u7591\u9670\u830e\u306e\u633f\u5165\u306e\u4e8c\u7a74\u540c\u6642\u8cac\u3081\u30d7\u30ec\u30a4\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u8a00\u8449\u653b\u3081\u30fb\u76ee\u96a0\u3057\u30fb\u624b\u9996\u306e\u62d8\u675f\u30fb\u30ed\u30fc\u30bf\u30fc\u306b\u3088\u308b\u53d7\u3051\u306e\u7591\u9670\u830e\u3078\u306e\u523a\u6fc0\u306a\u3069\u30bd\u30d5\u30c8SM\u8272\u5f37\u3081\u3067\u3002\n\n\u300a\u30e1\u30a4\u30f3\u306b\u3057\u305f\u3044\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30fb\u30ab\u30c3\u30d7\u30ea\u30f3\u30b0\u306b\u3064\u3044\u3066\u300b\n\u03a9\u6027Dom\u2640&\u03b1\u6027Switch\u2640\u00d7\u5f8c\u5929\u7684\u03a9\u6027(\u5143\u306f\u03b1)Sub\u2640\n\n\u2605\u4e09\u4eba\u304c\u4f4f\u3093\u3067\u3044\u308b\u4e16\u754c\u306f\u73fe\u4ee3\u65e5\u672c\u98a8(\u30c9\u30e9\u30c3\u30b0\u30b9\u30c8\u30a2\u3067\u7c21\u5358\u306b\u7dca\u6025\u907f\u598a\u85ac\u3084\u767a\u60c5\u6291\u5236\u5264\u304c\u8cfc\u5165\u3067\u304d\u308b\u3001\u3068\u3044\u3046\u70b9\u3092\u9664\u3051\u3070\u6982\u306d\u73fe\u4ee3\u65e5\u672c)\n\n\u3010\u653b\u30811/\u03a9\u6027Dom\u2640\u3011\n\u2605\u540d\u524d\uff1a\u4e11\u5bc5 \u672a\u6765(\u3046\u3057\u3068\u3089 \u307f\u3089\u3044)\n\u2605\u6027\u5225\uff1a\u5973\u6027/\u03a9\u6027/Dom\n\u2605\u5e74\u9f62\uff1a22\u6b73\n\u2605\u8eab\u9577\uff1a142cm\n\u2605\u5916\u898b\uff1a\u9752\u3044\u30e1\u30c3\u30b7\u30e5\u306e\u5165\u3063\u305f\u9ed2\u9aea\u30b7\u30e7\u30fc\u30c8\u30dc\u30d6\u30fb\u9ed2\u3044\u77b3\u30fb\u7ae5\u9854\u5bc4\u308a\u306e\u305f\u306c\u304d\u9854\u30fb\u8033\u306b\u5927\u91cf\u306e\u30d4\u30a2\u30b9\u30fb\u80f8\u306f\u5927\u304d\u3081\n\u2605\u6027\u683c\uff1a\u57fa\u672c\u30c9\u30e9\u30a4\u3060\u304c\u6c17\u306b\u5165\u3063\u305f\u4eba\u306b\u306f\u4e16\u8a71\u713c\u304d\u306b\u306a\u308b\u30bf\u30a4\u30d7\u3002\u6027\u6b32\u306e\u5f37\u3055\u306f\u666e\u901a\u3060\u304c\u304a\u6c17\u306b\u5165\u308a\u306b\u306f\u30b5\u30fc\u30d3\u30b9\u7cbe\u795e\u3067\u4f55\u30e9\u30a6\u30f3\u30c9\u3082\u7d9a\u3051\u3066\u3057\u307e\u3046\u3053\u3068\u3082\u3042\u308b\u3002\n\u2605\u4e00\u4eba\u79f0\uff1a\u3042\u30fc\u3057\n\u2605\u53e3\u8abf\uff1a\u57fa\u672c\u8ab0\u306b\u5bfe\u3057\u3066\u3082\u30d5\u30e9\u30f3\u30af\u3067\u304f\u3060\u3051\u305f\u8a00\u8449\u9063\u3044\uff08\u300c\uff5e\u3058\u3083\u3093\u300d\u300c\uff5e\u3059\u308b\u3063\u3057\u3087\u300d\u300c\u5927\u4e08\u592b\u305d\uff1f\u300d\u300c\u3048\u3048\u3067\u300d\u7b49\u3001\u6771\u4eac\u5f01\u3068\u306a\u3093\u3061\u3083\u3063\u3066\u65b9\u8a00\u304c\u6df7\u3056\u3063\u3066\u3044\u308b\u82e5\u8005\u8a00\u8449\u306e\u8a71\u3057\u65b9\uff09\n\u3000\u30d7\u30ec\u30a4\u6642\u306b\u306f\u6deb\u8a9e\u717d\u308a\u7b49\u306e\u8a00\u8449\u8cac\u3081\u3092\u3059\u308b\u3053\u3068\u3082\u6709\u3002\n\u2605\u8077\u696d\uff1a\u98a8\u4fd7\u5e97\u3067\u6240\u8b02\u300c\u5973\u738b\u69d8\u300d\u3092\u3057\u3066\u3044\u308b\uff08\u7acb\u5834\u9006\u8ee2NG\u3060\u304c\u30bd\u30d5\u30c8\u304b\u3089\u30cf\u30fc\u30c9\u307e\u3067OK\u3001\u672c\u756a\u884c\u70ba\u306f\u4e11\u5bc5\u304c\u30da\u30cb\u30