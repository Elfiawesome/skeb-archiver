だきました！\n今回いちプロ所属の「幽々ゆら」ちゃんを描いていただきたいです（公式ガイドラインよりskebなどでリクエストすることに許可が出ています）\nゆらちゃんは200年眠っていたおばけのお嬢様です\n\n服装は資料URLにある通常衣装（三面図に載っているもの）もしくはラジオ衣装（不定期ラジオのサムネに使われている）をお願いします\nまた、資料URL内画像にいる猫の幽霊も一緒に描いていただけると嬉しいです\nポーズや構図などはお任せします\n\n使用用途としてはデスクトップやスマホの背景、ファンアートタグをつけての投稿（その場合マフラ→様のIDを記載します）\nまた、ゆらちゃんが配信のサムネやXで使用することがあります\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Fwtt0Mhi3pJ_CI-tnwWVmia6xDKS_Wwo?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mafura_00/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3331371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae18774fd2671c68a3dcda2e08761ef6", "srcset": "https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae18774fd2671c68a3dcda2e08761ef6, https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=809ffb266e28330846c46c14536693af 2x, https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f888053e2431231d239cbc0b8e84cf84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea59b593af7136c7a640708efb7a14c7", "srcset": "https://si.imgix.net/69dcde46/uploads/origins/12818d03-90ef-44ed-92f7-f28ca57b80c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea59b593af7136c7a640708efb7a14c7,