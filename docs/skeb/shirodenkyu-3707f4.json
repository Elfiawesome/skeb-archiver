は、特にご希望などが無ければ、お取引が完了しましたら閉鎖します。ご了承ください。\n\n金額が足りなかった場合は、再送いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/yjhdicomy34jhq8y6y5iv/h?rlkey=9kugtxip8bsqxlrxpdfaqh592&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nUoxnUn/works/49", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2729948, "client_id": 1687018, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5da2b94e/uploads/origins/12f3b6d0-28c9-4216-b071-26308bb94dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d7de7e2ddacdbe55ae8ba4af4a81d02", "srcset": "https://si.imgix.net/5da2b94e/uploads/origins/12f3b6d0-28c9-4216-b071-26308bb94dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d7de7e2ddacdbe55ae8ba4af4a81d02, https://si.imgix.net/5da2b94e/uploads/origins/12f3b6d0-28c9-4216-b071-26308bb94dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=258c22a13730545d366eeac64ff100c3 2x, https://si.imgix.net/5da2b94e/uploads/origins/12f3b6d0-28c9-4216-b071-26308bb94dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e5df1fb8d183b73a787b96da434ec01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5da2b94e/uploads/origins/12f3b6d0-28c9-4216-b071-26308bb94dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d432f0ccd24edd0e4f6bc6ef8907f5e", "srcset": "https://si.imgix.net/5da2b94e/uploads/origins/12f3b6d0-28c9-4216-b071-26308bb94dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d432f0ccd24edd0e4f6bc6ef8907f5e, https://si.imgix.net/5da2b94e/uploads/origins/12f3b6d0-28c9-4216-b071-26308bb94dd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e58ed3a9ff2b6d676e93e76fa0ead6f5 2x, https:/