の素材として使用したいので、もしできれば、構図的に、キャンバス内に収めて、部位を切り抜きないのように欲しいです！(例：腕、手、耳、髪の毛、尻尾なと)\n\n用途:\nー配信用サムネの素材として使用したいです！(絵師名標柱します)\nもしできれば、PSD系のレイヤー化ファイルが欲しいです！\n特にキャラクターと背景を別レイヤにして欲しいです！\n\nよろしくお願いします!\n\nhttps://drive.google.com/drive/folders/1X9EWFH-bshLH9kYgwxtCKQBFeSuXhPVW?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 292786, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あまさわ", "screen_name": "amasawa83", "avatar_url": "https://pbs.twimg.com/profile_images/2025921422590435328/fyMAir89.jpg", "header_url": "https://pbs.twimg.com/profile_banners/162327454/1750947455/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 645675, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天駆無竜REO🍪", "screen_name": "agolove1125", "avatar_url": "https://pbs.twimg.com/profile_images/1540207791645663232/DZ-3Vsz_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3112629943/1664031793/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 144}, {"id": 1185163, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よっと@skeb open", "screen_name": "drakoyotto", "avatar_url": "https://pbs.twimg.com/profile_images/1078048999465115648/68finwJI.png", "header_url": "https://pbs.twimg.com/profile_banners/1102600952/1570338548/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_