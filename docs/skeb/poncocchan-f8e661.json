0f3-46f4-8158-5a3a9ba2f154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ffbaa1422f02625f8c41adfb9c72871, https://si.imgix.net/e3b0ac26/uploads/origins/c04a8bb1-00f3-46f4-8158-5a3a9ba2f154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9360048593059f5ee1dfe80c5d9b348c 2x, https://si.imgix.net/e3b0ac26/uploads/origins/c04a8bb1-00f3-46f4-8158-5a3a9ba2f154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac24629ebd36f0e2fe40252fb716307b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3b0ac26/uploads/origins/c04a8bb1-00f3-46f4-8158-5a3a9ba2f154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14d6fa795f9d16a04578dc35bcd7bfc4", "srcset": "https://si.imgix.net/e3b0ac26/uploads/origins/c04a8bb1-00f3-46f4-8158-5a3a9ba2f154?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14d6fa795f9d16a04578dc35bcd7bfc4, https://si.imgix.net/e3b0ac26/uploads/origins/c04a8bb1-00f3-46f4-8158-5a3a9ba2f154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=620fd8559f6124a4f372ad43d96d1e2b 2x, https://si.imgix.net/e3b0ac26/uploads/origins/c04a8bb1-00f3-46f4-8158-5a3a9ba2f154?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b28f4a298b795574060203c9b3930f3d 3x"}, "body": "こんばんは。\nおくちものを毎回楽しませていただいております。ハメもマックスも他もDMM電子本棚の上部に常設しているくらい最高です！\n\nOCもよろしいでしょうか。うちのこのおくちをお願いします。\n最下部資料URL内に簡単な資料がございます（裸有り）。\nhttps://twitter.com/shirayukimaru03/status/1513531531327078403\n衣装はこちら↑でお願いします。\n\n〇シチュエーション\n「付けたまま長時間放置されたディルドギャグを外されたうちのこ、口を開けさせられて舌や喉を手で弄ばれる」\n要素は\n・着衣のまま後ろ手拘束でエロ蹲踞\n・足元には落ちてるギャグと喉イキ大洪水の水たまり\n・反抗心の上目遣いニラミ涙目\nでお願いします。\n弄ぶ手無しの喉までぱっくり丸見えverがあると嬉しいです。\nビジュアルはクール系ですが微笑みはキュートな締まった腹筋とおへそがかわいいジト目気味貧乳スレンダー半悪魔っ子です。絶壁ではない貧乳です。\nピアス傷痕刺青がありますが苦手なものは省略していただいて問題ありません。\n\n個人利用の他、他のうちのこ勢に共有し見せたり等することがございます。\n\n\n以上です。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1q8bgUx1sUJm_hQvdLQ7DNy7QYaqQbS_r", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poncocchan/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 34919, "client_id": 1632689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aac60af9e96cbf15d922c02d952eb81", "srcset": "https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aac60af9e96cbf15d922c02d952eb81, https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e66ca9d40e96990d3d0610c64bc638d1 2x, https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81a139bd88ea2c22b6ece310f5dddca3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c85427306571583568a517d3aa39762", "srcset": "https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c85427306571583568a517d3aa39762, https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07b3700ab684916a8022cf8326a0ec87 2x, https://si.imgix.net/abbf7fcf/uploads/origins/0fde3812-a1cf-4f18-a8de-f4dafb656197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bab914ad323859705c90fdef7e40827 3x"}, "body": "ぽんこっちゃん先生、こんにちは。\n\nいつも先生の作品を楽しんでいます。Skebで依頼を受け付けているのを見たので、お願いしたいことがあります。あなたの作品「幼馴染は俺の専属お口メイド」の瑞輝ちゃんのイラストを描いていただけませんか？\n\n中アップでお願いします。裸で、とても興奮した表情で、口を大きく開けてこちらを見ています。彼女は舌を可能な限り突き出し、口蓋垂と大きく開いた喉を私に見せています。\n\nご検討ありがとうございました。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poncocchan/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 34919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f5325e4/uploads/origins/bc0d8cc8-dd8f-4fde-a6f6-69fc0b061e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7edee443926d714466d77b69d245fc0", "srcset": "https://si.imgix.net/5f5325e4/uploads/origins/bc0d8cc8-dd8f-4fde-a6f6-69fc0b061e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7edee443926d714466d77b69d245fc0, https://si.imgix.net/5f5325e4/uploads/origins/bc0d8cc8-dd8f-4fde-a6f6-69fc0b061e42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9f92077a239e784cfe411ff8639d123 2x, https://si.imgix.net/5f5325e4/uploads/origins/bc0d8cc8-dd8f-4fde-a6f6-69fc0b061e42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad4f2c1fddabbb2821ac92810e580f35 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f5325e4/uploads/origins/bc0d8cc8-dd8f-4fde-a6f6-69fc0b061e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=938d309799914a065b45c193099bf98d", "srcset": "https://si.imgix.net/5f5325e4/uploads/origins/bc0d8cc8-dd8f-4fde-a6f6-69fc0b061e42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=938d309799914a065b45c193099bf98d, https://si.imgix.net/5f5325e4/uploads/origins/bc0d8cc8-dd8f-4fde-a6f6-69fc0b06