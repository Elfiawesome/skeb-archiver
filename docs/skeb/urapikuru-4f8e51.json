ipped": true, "creator_id": 169632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad9c8772c20ab0067b00e3e1f727dec3", "srcset": "https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad9c8772c20ab0067b00e3e1f727dec3, https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=393450cb62c84dfecb5bb19a83b417b0 2x, https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8280bdb3003d7631ec3041dce63167d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd3ef1a55086348c561c9b9f18c81e63", "srcset": "https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd3ef1a55086348c561c9b9f18c81e63, https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd842b1c1ac600075c72fa309fa807ba 2x, https://si.imgix.net/f327c2d2/requests/217107_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee8f8228f67369041bc4739618e1303 3x"}, "body": "初めまして、ご検討をお願いします。\nキャラ：アイドルマスターシンデレラガールズの黒川千秋\nhttps://twitter.com/imas_cg_cool/status/1200758990889603073?s=20\n\nシチュエーション：千秋と同じ大学の女子が、自分の好きな男子が\n彼女のファンを公言したことで、奪われたと逆恨み。\n他の友人たちと凌辱を仕掛ける。\n\n描いて欲しいシーン\n・サークル室、体育倉庫等でホワイトボードか黒板に\n「黒川千秋ファン感謝祭！」「９６回抜くまで帰れませんｗ」\n「ヤリマン記念日」「ゴムはイヤン」等の文字。\nお好みで削ったり増やしたりしてください。\n\n・その前でおっぱいと性器が見える状態の千秋。\n赤か黒のパンツが片足に引っかかっている。脱がす破く等はお好みで。\n表情は強気で反抗的。苦痛にゆがむ、レイプ目は良いが、泣く・快楽堕ちは×\n\n・スマホ等撮影機材がある\n\nメイン　男に挿入され、出血するシーン。\n「派手な下着で、清楚ビッチかと思えば、処女とかｗ」\n「ダッセｗ」「後で見返せるなんて羨ましー」等煽るセリフ\n\n差分１　中出し\n男子「そろそろ・・・」女子「出しちゃえ出しちゃえ」\n「まず１ぱ～つ。後９５回ガンバーｗ」\n「さっさと謝ればー。許さないけどｗ」\n\n差分２　しばらく経って、フェラ・パイズリ等で全身にぶっかけられた後\n「さっきの３連続ぶっかけで、あと４６回？」\n「あー・・・適当でいいよ。泣きも謝りもしないし、ツマンネ」\n「そういえば、カラオケのクーポン有る～」\n「じゃあ、そっち行こう。男子ー、見つかる前に帰れよー」\n\nの以上、３シーンお願いします。\n予算は盛りましたが、割に合わない、内容が好みでない等あれば、\n遠慮なくキャンセルしてください。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@urapikuru/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 169632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80dddf68b1458ba649713b281470c5fc", "srcset": "https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80dddf68b1458ba649713b281470c5fc, https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15202d4ded215cf3eab1179d2a3cb585 2x, https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77f3843247d3d8462b55d8c1aa9cdc6a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de83d358b1be3308ee01b1291056b165", "srcset": "https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de83d358b1be3308ee01b1291056b165, https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=702e586414cb58847a7f7202ae5713a2 2x, https://si.imgix.net/48727074/requests/216034_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41c70c0