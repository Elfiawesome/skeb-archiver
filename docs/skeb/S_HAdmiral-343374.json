net/fb9ca7d9/uploads/origins/c3d0f393-67a6-4761-84c9-1606f9114cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8af497013419fce4d5307446b81f1c85", "srcset": "https://si.imgix.net/fb9ca7d9/uploads/origins/c3d0f393-67a6-4761-84c9-1606f9114cce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8af497013419fce4d5307446b81f1c85, https://si.imgix.net/fb9ca7d9/uploads/origins/c3d0f393-67a6-4761-84c9-1606f9114cce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecb4fd4b564a0f670c16050bbfc8df3a 2x, https://si.imgix.net/fb9ca7d9/uploads/origins/c3d0f393-67a6-4761-84c9-1606f9114cce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fce15d9338d3ae7797ad4d56f776410b 3x"}, "body": "⚫︎キャラクター\nアズールレーンの駆逐艦Z46、駆逐艦初霜\n、、、と、空母アークロイヤルと、空母グラーフ\nツェッペリン\n\n⚫︎シチュエーション、構図\nZ46と初霜二人が、それぞれの基本衣装を交換\n画面外の指揮官(イラストには登場しません)に\n披露している様子\n髪型は変更なし、お互いの髪飾りや帽子も\n交換してつけています\n(初霜は改造後の衣装、二人とも艤装なし)\n\nメインは初霜衣装のZ46で、初霜は今回脇役\n\nいつもの無表情を装いつつも顔を赤らめ、\n明らかに露出の高い初霜衣装、特に胸を\n知らずしらず、指揮官へ見せつけてしまう\n大胆なポージングのZ46\n全体は細くスレンダーながら、出る所は\nちゃんと出てる\n胸も、初霜より若干サイズが上なので\n少しキツめで谷間あり\n平静を装いながら、精一杯のアピールを\n指揮官にしてます\n\nその後ろの方、我が子(？)の成長に感極まって\n感激の涙を流しながら目元をハンカチでぬぐう、\n後方保護者顔のグラーフ\n感激の鼻血を流しながらカメラでZ46を激写する\n後方不審者のアークロイヤル\nそんな年長者二人の狂喜乱舞にドン引きしつつ、\nZ 46のバストサイズが自分より上だった事に\n内心焦りが隠せない、後方平たい胸族の初霜\nほぼピッタリながら、若干ゆるいZ 46衣装の\n胸周りを両手で押さえてます\n\n3人ともわき役なので、ディフォルメ調で\nギャグ漫画っぽく\nグラーフ、アークロイヤルは、それぞれの基本衣装\n\nイラスト中に、依頼者の名前やありがとう等の\nメッセージは不用です", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_HAdmiral/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3568832, "client_id": 36593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4e555e7/uploads/origins/4a0b2f85-6dbf-4bec-9692-f9f6c1c08122?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6957acde41251261e68924e3