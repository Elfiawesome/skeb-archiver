ame_genre": false}, {"path": "/@mink_171219/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2103662, "client_id": 2743018, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=470c736bdb7d9b8366373842da8e9494", "srcset": "https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=470c736bdb7d9b8366373842da8e9494, https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd6a5b261d4df7a1b4fd19e878f6a32b 2x, https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3afd496de447a9293e13a5cc9bedfb80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20eb2ce6e03e9db0de10d816ec7f27da", "srcset": "https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20eb2ce6e03e9db0de10d816ec7f27da, https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bef6760de0e4f6fe80fe69a61754a19 2x, https://si.imgix.net/09cee413/uploads/origins/d00955cb-c3f3-4190-937f-ecda41c03f60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4047555606a9e9aab004a8f0c83d419 3x"}, "body": "Dear mink\nI am sorry for the sketch request.\nI saw your illustration on Twitter and thought it was very nice.\n\n Character\nPlease refer to my Twitter URL for the standing picture.\n\nHair style, clothes, and other things (please leave the horns, wings, and tail as they are!) The composition of the picture is entirely up to mink.\nWe would be very happy if you could draw a picture filled with your favorite things.\n\n We would like to use the illustration as a thumbnail for distribution, as a return gift, on Twitter, etc. If you have a background for the illustration, we would like to have a separate transparency for the person only.\n\nThank you very much!\n\nhttps://twitter.com/szk_ftb17/status/1653915972477263874?s=46&t=SjnhWSs0FVYxpvO3NdGjSA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mink_171219/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2103662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b35b4f4693fd678e8b59806df6dcf5", "srcset": "https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b35b4f4693fd678e8b59806df6dcf5, https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cae803151a2f505a7c92cfefb0779e3 2x, https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e6751014962ebb4b888d3c8363617c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8128ea73f67583f61c0f345f3e6010f4", "srcset": "https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8128ea73f67583f61c0f345f3e6010f4, https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c24a7955ac4100fe9059d135faaaf0e 2x, https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2132be56078c4a69cf0f726a942a75bf 3x"}, "body": "はじめまして、スケブでお見かけした女の子がとても可愛らしくて惹かれました。\nTwitterに投稿しているスケッチも素晴らしいですね！\n素朴なタッチの中に生き生きした表情が活写され、センスのよさと才能を感じます。\n\nよろしければ小説家になろうやエブリスタに掲載している自作ホラー小説、「サムワンサム」の表紙（イメージイラスト）を描いてください。\n\n■あらすじ\n父が営むトウモロコシ畑を今日も今日とて駆け回るおてんばサム。\n収穫期に訪れる出稼ぎ労働者たちとも仲良しだ。\n\nある日サムが案山子の根元に埋めた宝箱を掘り返していると、口がきけない大男が現れた。\n過去の惨劇のショックで言葉を忘れた彼は、仲間内でサイレンス・ジョニー……だんまりジョニーと呼ばれている。\nサムはジョニーと大親友になるのだが……。\n（ホラー/ミステリー/短編）\n\n■描いてほしい人物\nサム（7）\n赤毛癖っ毛ショートヘア　鼻梁にそばかす　濃紺のオーバーオール\n見た目はやんちゃそうな可愛い男の子だが実はボーイッシュな女児\n事情があって男の子の格好をさせられている\n上記の特徴を踏まえていればキャラデザ詳細はおまかせ\n自由に楽しく描いてください\n\n■雰囲気\nノスタルジック　オールドアメリカ　ジュブナイルホラー　牧歌的だがほんのり不吉で不気味　トウモロコシ畑に潜む狂気\n\n■シチュ\n真夏のトウモロコシ畑（背景が難しそうなら簡略化ＯＫ）\n時間帯は朝～夜の間でおまかせ\n\n■その他モチーフ\nブギーマン　案山子　麦わら帽子　農具（使えそうなのがあれば使ってください）\n\nアレンジ歓迎\n不明点や詳細おまかせ\n\n完成品はネット小説の表紙や宣伝他、kindleで販売する電子書籍に使わせてください\nお名前とTwitterアカウントは表記します\n下記ページにも挿絵として掲載させていただければと思います\n\nhttps://ncode.syosetu.com/n8408hg/", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mink_171219/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2103662, "client_id": 1035509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d5df6f6/uploads/origins/2cd821be-eb12-469d-872d-893f2722b681?bg=%23fff&auto=format%