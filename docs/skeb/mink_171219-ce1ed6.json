s&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4047555606a9e9aab004a8f0c83d419 3x"}, "body": "Dear mink\nI am sorry for the sketch request.\nI saw your illustration on Twitter and thought it was very nice.\n\n Character\nPlease refer to my Twitter URL for the standing picture.\n\nHair style, clothes, and other things (please leave the horns, wings, and tail as they are!) The composition of the picture is entirely up to mink.\nWe would be very happy if you could draw a picture filled with your favorite things.\n\n We would like to use the illustration as a thumbnail for distribution, as a return gift, on Twitter, etc. If you have a background for the illustration, we would like to have a separate transparency for the person only.\n\nThank you very much!\n\nhttps://twitter.com/szk_ftb17/status/1653915972477263874?s=46&t=SjnhWSs0FVYxpvO3NdGjSA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mink_171219/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2103662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b35b4f4693fd678e8b59806df6dcf5", "srcset": "https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b35b4f4693fd678e8b59806df6dcf5, https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cae803151a2f505a7c92cfefb0779e3 2x, https://si.imgix.net/dd6c0787/uploads/origins/7ef11641-8966-4810-af38-982f70686f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e6751014962ebb4b888d3c8363617c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "co