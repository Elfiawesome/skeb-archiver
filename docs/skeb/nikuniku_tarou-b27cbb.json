nキャラの名前はイルで魔族の男人外です\n身長は208cmでガタイが良い方です\nこのキャラはかわいいものと自分自身の強さが大好きです\n普段は真っ黒なスーツ姿ですが趣味でかわいい格好をすることも多いキャラです\n頭のデザイン、真っ黒な肌、大きい尻尾以外のキャラ以外の部分の指定は特にありません\n構図やポーズの指定はありませんが服装はにくたろうさんがかわいいと感じる服装にして頂けると嬉しいです\n頭部や尻尾のデザインで分かりにくい部分があったら想像で描いて頂けると助かります…\n使用用途はSNSなどのアイコン、端末の待ち受けなどの使用が中心になると思います\n下の資料の通りの服装にはしないで頂きたいです\nhttps://drive.google.com/drive/folders/1E4V_1CkN2amZQ42wr22jpAbvrqCAi4SR", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nikuniku_tarou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1055289, "client_id": 218389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/646ea638/uploads/origins/1594e8f8-6bc9-4263-b7f5-502dbfc0761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75292e15c1d51cad5e38310cdda60932", "srcset": "https://si.imgix.net/646ea638/uploads/origins/1594e8f8-6bc9-4263-b7f5-502dbfc0761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75292e15c1d51cad5e38310cdda60932, https://si.imgix.net/646ea638/uploads/origins/1594e8f8-6bc9-4263-b7f5-502dbfc0761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fd10a123b813cd89c27dbc07cea442b 2x, https://si.imgix.net/646ea638/uploads/origins/1594e8f8-6bc9-4263-b7f5-502dbfc0761a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f31b2421dd9f10ffe39ceabfb6a452f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/646ea638/uploads/origins/1594e8f8-6bc9-4263-b7f5-502dbfc0761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ba47c6ecb312b9c8ead7f0ad4213a0b", "srcset": "https://si.imgix.net/646ea638/uploads/origins/1594e8f8-6bc9-4263-b7f5-502dbfc0761a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ba47c6ecb312b9c8ead7f0ad4213a0b, https://si.