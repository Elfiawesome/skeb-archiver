d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8d9ef8f9ff3bcfa55c5b72c6df49b4", "src_set": ""}, "body": "自我推銷感謝！I’m sorry I can’t speak Japanese😿Your art are beautiful and I love it so much and I’m also glad to hear you like my own character , here’s his information:\nEdgar Clemens\nHeight:178cm\nAge:looks like 25\nBackground: The prototype is the evil god of the black snake that occupies someone's body after he dead，always eager to deceive and seduce humans，and happy to see humanity plunged into terror and despair\nReference：\nhttps://drive.google.com/drive/folders/1-LhnxpVfKlLWq9lFqhl5AKtbWGDOqW6u\n\nYou can draw which cloths you like, thank you for your message again!本当にありがとうございます(=´∀｀=)", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@atelier_roux/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/65e87632/uploads/origins/8527f7f1-e3e7-46ee-acc0-bd674bd92c23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05cb26b8ac3034686c8448b47958d56f", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1561492, "client_id": 3031033, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@atelier_roux/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1561492, "client_id": 1551454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68114fa1/uploads/origins/832efb0e-63af-467f-be69-741ff5fdb812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2f5a490f7fb911486d99d2fb8fa02bd", "src_set": ""}, "duration": null, "nsfw": false, "ha