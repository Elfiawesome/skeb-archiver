53-8492098224e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40f16e04242b1e47bdd099e1d581af50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69ac39ff/uploads/origins/d2c46f7c-1e6f-4364-8053-8492098224e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d62fe1f063d6e25b0f0cd2e2f602191", "srcset": "https://si.imgix.net/69ac39ff/uploads/origins/d2c46f7c-1e6f-4364-8053-8492098224e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d62fe1f063d6e25b0f0cd2e2f602191, https://si.imgix.net/69ac39ff/uploads/origins/d2c46f7c-1e6f-4364-8053-8492098224e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6e00ac0d9c57e76ba8b22251be2862 2x, https://si.imgix.net/69ac39ff/uploads/origins/d2c46f7c-1e6f-4364-8053-8492098224e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea693b96a7801701665c8d9878476bb 3x"}, "body": "skebとfantiaの作品を見て、とても素晴らしいと思いまして、リクエストさせて頂きます。\n\nキャラ：シーラ・ラパーナ女王（聖戦士ダンバイン）\nhttp://hephaestus.michikusa.jp/seela-l0102.jpg\nhttps://auctions.c.yimg.jp/images.auctions.yahoo.co.jp/image/dr000/auc0310/users/860fc16ba0ffe91271a6fc8a8aeba751d061eb4a/i-img898x1198-1665417003rz7cxv321252.jpg\n\n①壁際で触手に囲まれている\n両手は片方ずつ触手によって壁に押し付けるように固定（L字と逆L字）\n首元も触手で顔を上向きにされている（10~20度くらい）\n絶体絶命の状況だが、毅然とした態度と表情\n\n②胸鎧の下に触手は入り込んで胸揉み、足も触手が絡んでガニ股気味にされる\n③胸鎧を外し、触手で乳首責め\n④腰鎧を外す。乳首は勃起\n⑤全身を責める（顔舐め・胸揉み・太もも・股間など）\n⑥インナーの胸部分と股間部分を破り、性器を触手で開く\n⑦細長い触手１本を挿入（ゆっくり奥まで差し込み、ゆっくり抜き差し）\n⑧弱い部分を探りながら⑦を続け、弱い部分を探り当てる→水音が響くようになり、愛液が垂れてくる\n⑨クリ責め乳首責めも追加し、完全に絶頂させる\n⑩ラスト：口と性器の触手を引き抜き、絶頂したてでヒクヒクしている性器とフル勃起したクリと乳首、とろりと性器から触手に出来る愛液の橋、乱れた呼吸。涙目でしかめ面だが、まだ抵抗の意志あり\n\n①～②くらいまでは毅然、③～⑥は毅然としながらも声を押し殺すなど触手への反応有、⑦くらいから弱気が混ざり始め、⑧は必死で声を出すのだけは我慢しながら耐え忍ぶ、⑨で声が抑えられなくなって大声を出す前に触手に口を塞がれる\n\n要求ばかりで恐縮なのですが、金額的に折り合いの付く範囲で描いて頂けたらと思います。\n\nまた、上記のように書いていますが一例程度で、描きやすいように自由にアレンジ改変など増減して頂いて構いません。ただただ触手に責められるシーラ様が見たいのです。\n\n表情のつけ方がとても魅力的ですので、是非とも書いて頂きたいなぁと思っています！\nご検討くださいましたら幸いです。\nよろしくお願いいたします", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ikadaiouR18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2640256, "client_id": 456509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f96c7ac5ca280e62d1582c2c7f1e6eb", "srcset": "https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f96c7ac5ca280e62d1582c2c7f1e6eb, https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2f52044ac9b8d1f5f0314c5a43a6a6a 2x, https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1ffd2d390f7b1f998b7db9558e187b1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f2eafbb10d8bc67ebf7a8ec909d6d51", "srcset": "https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f2eafbb10d8bc67ebf7a8ec909d6d51, https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4931892bb3b8b9c86706b78046ec057 2x, https://si.imgix.net/b54c548f/uploads/origins/b77893c9-f9ef-48e3-bb9b-cfbbfab7fe3e?bg=%23fff&aut