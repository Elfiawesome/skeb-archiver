fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47431dd55f33a4db5f37be44a2d9d17d, https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d70075ba92cbc7154396239290a84318 2x, https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8b07f4697913813afedbb78ab268b2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=726c70d849798e9965f041cd40475998", "srcset": "https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=726c70d849798e9965f041cd40475998, https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7fb7183dbfb647c6b3f386d8fd37c9 2x, https://si.imgix.net/430cc8fa/uploads/origins/66fc247e-d615-40f8-b24d-8b509392ad64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc4bd6a05018c1d50c77933efac5d7bd 3x"}, "body": "彼女達のエッチな世界観がびびっときました\n彼女達のエッチな絵を描いてほしいです\n\n*キャラ\nリベルタ・モルテ＝メルク\nテティア・モルテ＝メルク\n\n*エロ設定\n異種姦（触手）\n種付け前に子宮に開発用のスライムを流し込む\nhttps://skeb.jp/@atsu_kake/works/10\n↑この絵みたいに\n子宮からポルチオ・膣を逆に犯され孕み袋に堕とされる\n\n*構図\n1.触手に捕まって犯され中出しされた直後\n二人ともまだ諦めておらず抵抗強めの表情\n「1回やられたぐらいで屈すると思うな！」\n\n子宮内にスライムが流し込まれている、子宮断面図\n\n2.子宮内でスライムが暴れる\n子宮からも飛び出してポルチオを入念にいじられている\n\nリベルタはすでに快感に翻弄され声がこぼれてしまっている\nテティアも感じているが我慢できている、リベルタに頑張れと鼓舞している\n\n3.　堕ちた二人\n快感に飲まれた二人、迫ってくる無数の触手に早く犯してくれと懇願している\n\n以上です\n\n服はあまり脱がさない感じでお願いします\n\nよろしくお願いします", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiki_ne_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 87369, "client_id": 2346231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8c0eb8fb0139fe2359487552df8c232", "srcset": "https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8c0eb8fb0139fe2359487552df8c232, https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=101623c57e6baa9057bc4fc947fffaf6 2x, https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b453bb0bf2d3d1a84fa9efb42cd7fd36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=861a0d110e1fa540ff4108d788119607", "srcset": "https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=861a0d110e1fa540ff4108d788119607, https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03165d8ada1fd538265a36ab6464a53f 2x, https://si.imgix.net/b126abef/uploads/origins/9bfc9dc1-8839-4724-89f0-863c4411b94d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fd5a18361a626af49ad2b963a1d61cc 3x"}, "body": "式白38さん\nはじめまして\n私のオリジナルキャラクターのイラストをお願いしたいです。\n以下、他の方に描いていただいた物ですがキャラクターの資料のURLです。\nhttps://drive.google.com/drive/folders/10j-i2ENmqyFrXx0j7H4_NiwfTXpxwig6\n\n2枚の衣装資料がありますが、2枚目の肩章の付いた方の衣装でお願いします。\n(シャツや蝶ネクタイ等、2枚目の資料に詳細書いていないものは1枚目の資料に詳細あります)\n蝶ネクタイは大きめにお願いします\n\nお嬢様口調で喋る怪盗の女の子のキャラクターです。\n性格はナルシストで自信満々ですが、ポンコツなアホの子です。\nカッコ付けながら悪い事をしますが、よくドジを踏んで失敗してしまいます。\n\n構図等はお任せします。\n長くなりましたが、ご検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiki_ne_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 87369, "client_id": 1280381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7baf879126628919fbfe5719a8cb397", "srcset": "https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7baf879126628919fbfe5719a8cb397, https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=478d84d89cae6c22c3b49104e35ae9db 2x, https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42b074a115eed416fa6f263eab64b050 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=417d2f23b28850548ffda97956e09287", "srcset": "https://si.imgix.net/afb57ebc/uploads/origins/8ee1f7b5-f1d5-47ec-8ef1-569faac9fb6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=417d2f23b28850548ff