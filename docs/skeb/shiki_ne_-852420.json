d/uploads/origins/0a4b3632-63fd-483b-8009-b3b7af92505d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5a9dd2195b5a3556a2da651c065c3c, https://si.imgix.net/fb489d4d/uploads/origins/0a4b3632-63fd-483b-8009-b3b7af92505d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4dae52d4c34d124e53c0976e9a4739e7 2x, https://si.imgix.net/fb489d4d/uploads/origins/0a4b3632-63fd-483b-8009-b3b7af92505d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bafb0240c154a8bcc03035e6fa17383e 3x"}, "body": "初めて依頼させていただきます。音割れくろとです。\n今回は式白38.先生に一枚絵を依頼したくリクエストをしました。\n\n依頼内容ですが、うちの子のノラコさん（大人の方）を描いてほしいです。\nサイズは『縦1200×横600』か『縦2400×横1200』の式白38.先生の描きやすい方でお願いします。\n\n構図についてですが、太ももまで描くアップでお願いします。顔の向きは正面で、まっすぐ立つようにしてください。\n背景は白で、ノラコさんを逆光で描いてください。空気感が欲しいので式白38.先生の裁量で塵などを描き足してください。\n向かって右手で剣を持ち、向かって左の顔を隠すようにノラコさんに構えさせてください。\nできればでいいのですが顔を隠した剣にクロエちゃんの顔が移りこむ演出があると嬉しいです。\n\n言葉で伝えるのが難しいので構図イメージ合致の助けになる資料URLも貼っておきます。\n\n長く細かくなってしまいましたが、今回の依頼を受けていただければ幸いです。\nよろしくお願いします。\n\nhttps://twitter.com/gw6leuD9RpzhAb9/status/1423533783261663234?s=20", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiki_ne_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 87369, "client_id": 156791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f968e9229793abe41c0b1554836baf12", "srcset": "https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f968e9229793abe41c0b1554836baf12, https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=691e5c0a76265aaeb2303dbf937151f2 2x, https://si.imgix.net/e7720476/requests/149012_1?bg=%23fff&auto=format%2Ccompress&fm=webp&