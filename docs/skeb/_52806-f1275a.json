e-b5d9-2c1438929dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a27f382ab17ee797f08125bf7c53f0fb, https://si.imgix.net/dc9e43f5/uploads/origins/5ce765fe-94bb-4a9e-b5d9-2c1438929dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ee3ff7cde59693f66228d3ac72843de 2x, https://si.imgix.net/dc9e43f5/uploads/origins/5ce765fe-94bb-4a9e-b5d9-2c1438929dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76db1d2112f6f83882ba3fec10009910 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc9e43f5/uploads/origins/5ce765fe-94bb-4a9e-b5d9-2c1438929dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd87aed3aa4bb5fcb8c0e1faf5af19c1", "srcset": "https://si.imgix.net/dc9e43f5/uploads/origins/5ce765fe-94bb-4a9e-b5d9-2c1438929dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd87aed3aa4bb5fcb8c0e1faf5af19c1, https://si.imgix.net/dc9e43f5/uploads/origins/5ce765fe-94bb-4a9e-b5d9-2c1438929dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46f468ebad3035dbf7e35d56bf6488d1 2x, https://si.imgix.net/dc9e43f5/uploads/origins/5ce765fe-94bb-4a9e-b5d9-2c1438929dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bf954fc59138de08519d62d8f2b3bae 3x"}, "body": "meeさんのイラストを一目見たときから大好きです！！一目惚れでした♥\nこのたびはskebを開いてくださってありがとうございます！大好きなmeeさんにＯＣのイラストを描いていただきたく、ご連絡致しました。\n\n今回描いていただきたいイラストは、一枚絵です。人物の描写範囲は全身じゃなくてＯＫです。\n白の十字架が描いてある棺桶の中に、青髪の女の子、それに寄り添うように赤髪の女の子をお願いします。ポーズはお任せいたします。棺桶の周りには赤色の薔薇があったり、白の十字架が立てられたりしているとうれしいです！全体的にダークな雰囲気でお願いします。\n\n服装は、赤髪の子がふわふわとしたウエディングドレス（資料参照）、青髪の子がフランス風マーメイドウエディングドレスでお願いしたいです。ふたりともウエディングベールをつけているとうれしいです！\n\n大事にしてほしいことは、赤髪の子の丸メガネとオン眉パッツン・肌右八重歯。それから、ふたりの髪型は資料の通りの固定でお願いします。\n\n以上の通りになります！なにとぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1__-oWlz70n7cnnIKiAGhYg2jajtYYS-W\n\nhttps://drive.google.com/drive/folders/1__-oWlz70n7cnnIKiAGhYg2jajtYYS-W", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_52806/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3512028, "client_id": 2997980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4b15a8bbe29fa122e743dd06569ea7", "srcset": "https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4b15a8bbe29fa122e743dd06569ea7, https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb6553d451c93db95ae96676ded5d41a 2x, https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7bf677223a87cf77bb6f37944910351 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0947491f25e83daf3141a82dfcd7cc72", "srcset": "https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0947491f25e83daf3141a82dfcd7cc72, https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47f1a6c4e3b1013ea70ae0d057423695 2x, https://si.imgix.net/5d2e95ed/uploads/origins/610b2a4b-1a9c-48ec-bf20-fd8748dc74d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4aeeb36a549967a6d34d644413e21eed 3x"}, "body": "めぇさんこんにちは！いつももちもちで素敵なイラストを拝見しております☺️\n今回めぇさんのイラストで自創作が見たい！と思い、スケブ申請しました。\n\n・描いていただきたいキャラクター\n宵→長髪の青年。海月と同じ家に住んでいる書生で、最初は海月にも冷たい態度をとっていましたが現在は若干過保護なお兄ちゃん的存在のキャラクターです。本人は隠していますが、海月に対して強い信仰心を持っています。\n\n海月→基本的ににこにこしていて、怒ったりすることが少ない、お嬢様のキャラクター。家族に対して愛情が深い。宵のことも家族のように思っています。\nおしゃれがすきで天真爛漫ですが、だれよりも強い心の持ち主です。\n\n・世界観\n大正時代をイメージした和と洋の入り交じる国にふたりは住んでいます。海月の家はその国で1番の豪商の家です。\n\n・服装\n服装は基本設定、軽装（夏服）、学パロ制服、どれでも大丈夫です！めぇさんがこれにしようかなーと思ったもので描いていただけたら嬉しいです。もちろん衣装変更があっても構いません！ドレスやスーツ、ファンタジーっぽいものでも大歓迎です！\n\n・よくあるふたり\n海月の方からハグをする\n一緒に本を読む\nふたりで買い物に行き服を買うor甘味を食べる\n\n・OK!\nハグ お姫様抱っこ一緒にお昼寝\n距離感が近いふたりです！\n\n・NG!\nキスなど恋愛要素を感じられるもの、逆に仲が悪そうなもの\n\n・頭身かSDか\nどっちのイラストも大好きなので、どちらでも大歓迎です！描かれる時の気分で選んでいただいても大丈夫です♪\n\n・使用用途\n鍵垢での掲載、アイコン使用(めぇさんのIDをきちんと記載します)、個人鑑賞、もしかしたらアクリルスタンドにするかもしれません…！有償での販売等はしません。\n\n構図はよくあるふたり↑から選んで描いていただいても構いませんし、めぇさんの描きやすい構図で描いていただいても構いません！\n\nなにとぞよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1-AA9iE--q1DJTbD4QaCHbhgryyk1BTeE", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_52806/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3512028, "client_id": 1518609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fe7bdb5/uploads/origins/840a69b2-26d0-4e45-9691-ee78738bf626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e01c9de2140a6496577edeb5737c61c6", "srcset": "https://si.imgix.net/5fe7bdb5/uploads/origins/840a69b2-26d0-4e45-9691-ee78738bf626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e01c9de2140a6496577edeb5737c61c6, https://si.imgix.net/5fe7bdb5/uploads/origins/840a69b2-26d0-4e45-9691-ee78738bf626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f863d64cca6ef718e7d0eb99c5a05e04 2x, https://si.imgix.net/5fe7bdb5/uploads/origins/840a69b2-26d