a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb2bc98d37c603ff6d1ce5e102ad6900 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c79056b280aa7a7474696c260743996d", "srcset": "https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c79056b280aa7a7474696c260743996d, https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=770f36d9892b2b4f121a2fb9aba79fd1 2x, https://si.imgix.net/7966f16d/uploads/origins/f25cd0a2-f1e1-4a2a-84be-404f19212710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50b17892cc46004e1235cd933735d7e9 3x"}, "body": "Hello!\nI would like to see a cute image of \u30d8\u30e9\u30b8\u30ab from \u3051\u3082\u306e\u30d5\u30ec\u30f3\u30ba.\nIn this image, I would like to see a version of her that looks more like a disheveled NEET (\u5f15\u304d\u3053\u3082\u308a) instead of her usual tough and confident self. As moose build up fat and reduce their activity to survive during the winter. Because of that behavioral trait in her species, think it would be fitting to see a version of \u30d8\u30e9\u30b8\u30ab depicted in this way.\nDue to her altered behavior and extra body fat, \u30d8\u30e9\u30b8\u30ab should be depicted with a slightly bigger chest, soft tummy and plumper thighs. \nhttps://x.com/nia4294/status/1527333000748617728\nhttps://x.com/Victim_Girls/status/1764233329912791043\nIn addition, her hair should look messy and disheveled, as though she hasn't cared for it in some time. Something similar to a character such as Pokemon's Hex Maniac (\u30aa\u30ab\u30eb\u30c8\u30de\u30cb\u30a2) or the vtuber Menace Mamaki (https://x.com/menmakii/status/1782993242381799906) would feel fitting, although you are free to change this however you think would fit best.\nFor the situation, I would like to see something cute that matches how she has changed, making it seem as though she has been relying on the viewer for care for the winter. \nA background with a comfortable looking house or cabin with a fireplace would be fitting, similar to the following references.\nhttps://x.com/past_desiderium/status/1866212838592618640\nhttps://www.pixiv.net/en/artworks/125524262\nThe specifics of this situation are up to you.\nAdditionally, as moose lose their antlers during the late winter I would love to see a variant where she has no antlers.\nAny other details such as her outfit and expression are up to you.\nThank you!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@930tanaka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2045168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/880a0de8/uploads/origins/e10d69eb-a5ba-461d-a307-eed1cca3b8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247f13941af1612f56ea487d8ac587e8", "srcset": "https://si.imgix.net/880a0de8/uploads/origins/e10d69eb-a5ba-461d-a307-eed1cca3b8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=247f13941af1612f56ea487d8ac587e8, https://si.imgix.net/880a0de8/uploads/origins/e10d69eb-a5ba-461d-a307-eed1cca3b8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8453a8cc2ee354373304a62fafdea59 2x, https://si.imgix.net/880a0de8/uploads/origins/e10d69eb-a5ba-461d-a307-eed1cca3b8f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bfc31b5a69987d862d6c392e702ae50 3x"}, "duration": null, "nsfw": false, "hardcor