現実、一度一線を越えてしまったという罪悪感でぐちゃぐちゃになり、行為が常態化、エスカレート。だが『人間形態でやってないからまだ一線は超えていない』とギリギリ自分を正当化。\nずんだもんはかつての優しいつむぎを好意的に思っていて、自身に向けられる好意も好ましく思っていたが、今ではつむぎにおびえつつも従う。性具にされることは苦しみであるが、つむぎがしろと命じれば抵抗なく従う。今の状況は嫌だが、解決方法がわからず、誰にも相談できない。\n\nプチュ様の過去の作品では複雑な背徳的心理、状況を魅力的に描いていることから、このようなシチュを描いていただきたいとリクエストさせていただきました\n\n\nなお、この作品を私の方で何かに利用したいということはありません。\n細かい設定、シチュなどはプチュ様が魅力的に感じる方向に解釈、変更していただいて構いません\nどうかご検討のほどよろしくお願いいたします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@putyuOUT/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805827, "client_id": 1967788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79d826a7/uploads/origins/2766eb8b-ee93-44c0-9daa-c88d93858b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72405f88d1475f8838a35ed873c858da", "srcset": "https://si.imgix.net/79d826a7/uploads/origins/2766eb8b-ee93-44c0-9daa-c88d93858b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72405f88d1475f8838a35ed873c858da, https://si.imgix.net/79d826a7/uploads/origins/2766eb8b-ee93-44c0-9daa-c88d93858b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=044aee1bc5c1fc352570e33cbba40e06 2x, https://si.imgix.net/79d826a7/uploads/origins/2766eb8b-ee93-44c0-9daa-c88d93858b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5d4b32baea8afe78e0bc2c91824fb87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79d826a7/uploads/origins/2766eb8b-ee93-44c0-9daa-c88d93858b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=153b6a7d35dc2dcc6854b4ba40b6ab96", "srcset": "https://si.imgix.net/79d826a7/uploads/origins/2766eb8b-ee93-44c0-9daa-c88d93858b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=153b6a7d35dc2dcc6854b4ba40b6ab9