りやすくするため、リンク先に版権キャラクターとの夢絵もおいています、ご注意ください。また、版権に抵触する部分がありましたら都度改変していただけるとありがたいです。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1JH8Sak3NH48tZUkwR7rxSZ58Ly0ICghu\n\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@santarow_39/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1801363, "client_id": 645977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02706813/uploads/origins/6af0c4e3-224d-40be-8fed-a26f4af04260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94edf5ffd91f7c62545194acf528e38a", "srcset": "https://si.imgix.net/02706813/uploads/origins/6af0c4e3-224d-40be-8fed-a26f4af04260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94edf5ffd91f7c62545194acf528e38a, https://si.imgix.net/02706813/uploads/origins/6af0c4e3-224d-40be-8fed-a26f4af04260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=882913c5214403501a68476ae3458f94 2x, https://si.imgix.net/02706813/uploads/origins/6af0c4e3-224d-40be-8fed-a26f4af04260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4aec6d92350134671a7d84f198a81c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02706813/uploads/origins/6af0c4e3-224d-40be-8fed-a26f4af04260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d9921ee33829e88ec2efe1184ac485", "srcset": "https://si.imgix.net/02706813/uploads/origins/6af0c4e3-224d-40be-8fed-a26f4af04260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d9921ee33829e88ec2efe1184ac485, https://si.imgix.net/02706813/uploads/origins/6af0c4e3-224d-40be-8fed-a26f4af04260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fbc5fa1152b091da6232adff20e4d072 2x,