op=top&w=200&h=200&blur=200&s=6d70da16a52f5cfe09a60233a87aec0b 3x"}, "body": "こんにちわ。またskebの依頼をしたいと思いご連絡いたしました。\nアンジュも復活して安心しましたね。\nそこでアンジュ絵の依頼をさせていただきたいです。\n\n依頼内容　アンジュ・カトリーナ　衣装：水着絵\n構図表情などは全ておまかせでお願いします。\n\n水着絵であればどんなものでも大丈夫です。細かく内容を出したいのですが、如何せんセンスがないので\nハートマンさんのセンスでお願いしたいです。公式衣装がないのでどうかなと思ったのですがハートマンさん絵で見てみたいので是非お願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taman324/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3165679, "client_id": 2564933, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/131b4a7f/uploads/origins/6c03f97a-acca-4a9c-a2da-9f767b05b93f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4420fe31c8b939137e05d1f30f1b962e", "srcset": "https://si.imgix.net/131b4a7f/uploads/origins/6c03f97a-acca-4a9c-a2da-9f767b05b93f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4420fe31c8b939137e05d1f30f1b962e, https://si.imgix.net/131b4a7f/uploads/origins/6c03f97a-acca-4a9c-a2da-9f767b05b93f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb99f644f3e35bb9744f12c63ff03984 2x, https://si.imgix.net/131b4a7f/uploads/origins/6c03f97a-acca-4a9c-a2da-9f767b05b93f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e41abb32d33dda555d55fa232678fc63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/131b4a7f/uploads/origins/6c03f97a-acca-4a9c-a2da-9f767b05b93f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83ec18d04e08f0a11a5e067636cd6798", "srcset": "https://si.imgix.net/131b4a7f/uploads/origins/6c03f97a-acca-4a9c-a2da-9f767b05b93f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83ec18d04e08f0a11a5e067636cd6798, https://si.imgix.net/131b4a7f/uploads/origins/6c03f97a-acca-4a9c-a2da-9f