ogle.com/drive/folders/1XgVYCilh-EuhIeR3LuUxDWKSZmIZRqUm?usp=sharing\n特徴：明るい。横着。飛べない。手が翼なので片手で物が持てない。\n\n◆シーン\n明るめの林の中を散策しているワンシーンでお願いしたいです。\n\n◆衣装・表情・ポーズ\n衣装は無しで大丈夫です。\nまた、表情やポーズはおまかせします。\n\n◆その他\n人物は全身を入れてほしいです。\n画像ファイルの縦横比の希望はありません。\n背景を描いていただける場合は、人物とレイヤーを分けていただきたいです。\n完成したイラストは、Twitterで紹介したりサムネやヘッダー等に使用させていただくかもしれませんので事前にお伝えいたます。（NG事項は納品ファイルにメモしていただければ守ります。）\n\nリクエスト内容が厳しければ、同じキャラですべてお任せでお願いしたいです。\n楽しみにしております！よろしくお願いいたします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@miusmz/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 22426, "client_id": 560862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1627042e/uploads/origins/dcbd450c-a078-46e4-90d5-c50f4dd50b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c87342c49bb7e0dfa5376217dce54f0", "srcset": "https://si.imgix.net/1627042e/uploads/origins/dcbd450c-a078-46e4-90d5-c50f4dd50b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c87342c49bb7e0dfa5376217dce54f0, https://si.imgix.net/1627042e/uploads/origins/dcbd450c-a078-46e4-90d5-c50f4dd50b02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3f4421a0294fa0d594fc298e4542aee 2x, https://si.imgix.net/1627042e/uploads/origins/dcbd450c-a078-46e4-90d5-c50f4dd50b02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06c1a1e3852732540c7623b7e4d2b580 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1627042e/uploads/origins/dcbd450c-a078-46e4-90d5-c50f4dd50b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18b07ee2963aa9a227e3ecb447d2b1bb", "srcset": "https://si.imgix.net/1627042e/uploads/origins/dcbd450c-a078-46e4-90d5-c50f4dd50b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18