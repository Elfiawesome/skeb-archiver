-49f6-a1c0-ef0e58c67e79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c8b928dd3aa60cce7efc36336c9abf6 2x, https://si.imgix.net/59c2eecc/uploads/origins/0f879e6e-91eb-49f6-a1c0-ef0e58c67e79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf22206f8ad124715501ff25618130a7 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59c2eecc/uploads/origins/0f879e6e-91eb-49f6-a1c0-ef0e58c67e79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a7b15d3159a34f5b0096895c9ab615", "srcset": "https://si.imgix.net/59c2eecc/uploads/origins/0f879e6e-91eb-49f6-a1c0-ef0e58c67e79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a7b15d3159a34f5b0096895c9ab615, https://si.imgix.net/59c2eecc/uploads/origins/0f879e6e-91eb-49f6-a1c0-ef0e58c67e79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35010e3830cf4b16013c8ce8425d842d 2x, https://si.imgix.net/59c2eecc/uploads/origins/0f879e6e-91eb-49f6-a1c0-ef0e58c67e79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb240ea118d43151bf621c8a0274b74a 3x"}, "body": "いつもお世話になっております。\nskebを始められたという事なので、宜しければ是非、依頼をさせていただきたいです。\n\n私のブルーアーカイブの二次創作小説、「瓶詰の■■」の一シーンのシチュエーションをお願いしたいです。\n納品いただいた絵は、用途としてpixiv版の小説の挿絵として利用させていただきます。（難しいようでしたらキャンセルをお願い致します。）\n参考資料（本文）：https://www.pixiv.net/novel/show.php?id=20106092\nシーンに至るまでのあらすじの要約：トリニティでの禁固が解け、先生とデートしながら禁固中に先生の身に起こったある出来事について打ち明けられる約束を取り付けた聖園ミカ。しかしデート中に遭遇した戒野ミサキに、ミカが監置されている間に、先生はミサキの彼女になったことを告げられる。話の続きがあるにも関わらず、ミカは先生に、自身を「お姫様」と呼んでくれたことに感謝を告げ、その場から逃げてしまう。\nその次の日、先生はミカにまだ話していない事があるとミカを説得し、ミカは話の続きを私の部屋でしようと先生を呼び寄せる。\nミカは先生を騙し、屋根裏部屋に呼んだ途端に門限が締まり、先生はミカの部屋のベッドに隠れざるを得なくなる。（ミカの絆ストーリー３のオマージュ）\n\n以下が依頼したい部分のシチュエーション、本文になります。\nこの部分のどこかをお願いできればと思っております。\n-------------------------------------------------------------------------\n「先生、もう大丈夫。出てきていいよ。」\n「……ミカ、どういうこと……？」\n私が布団を出ると、そこには夜景に照らされ、風に晒されたミカがいた。\nしーっ。そう云いながら、ミカは指を立てる。\n「……先生、あなたが悪いんだよ。」そう言って、手首のシュシュを外しながら。\n「……！」私は絶句した。\n\nなんでこんなことになるんだ。そう思いながら。\n\n……斬ったよ。斬っちゃった。あはは、ばかみたいだね。涙目になりながら。\nミカの右手首、シュシュで隠していたそれは、深く横一文字に傷が付けられていた。\nミカは縛っていたらしい、血に濡れたシュシュを窓から投げ捨てる。\nこの様子だと、私と会う前に斬ったみたいだ。唖然とするしかなかった。\n\nいつも包帯巻いてるあの子と同じになれば、私のこと、少しはわかってくれるかなって。\n\nやめろ、ミカ。そう思ったが、口から声が出なかった。\n先生、あなたがおもってる以上に、わたしはこわれてたんだよ。\n「……さらに、きずつけば」ミカはそう言って、更に傷をひっかき、血を出そうとする。\nやめろ。やめてくれ。そう思って、私は阻止しようとする。\n……さらに傷つけば、わたしのこと、わかってくれるの？\n……ミカは縋り付いて哭いていた。\n(中略）あなたは、アリウスのミサキに愛を誓っちゃった。……もう、取り返しはつかないんだよ。\nねぇ、その代償は誰が払ってくれるの。……私にはあなたしかいないんだよ、先生？\n------------------------------------------------------------------------\nリクエストは以上になります。\n\nお忙しい中恐縮ではございますが、何卒ご検討宜しくお願い致します。", "nc": 163, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kandenti_0205/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2819762, "client_id": 1601068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7dbff746/uploads/origins/1c6ef8fd-7fc4-4551-a445-ad87d0968626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9fd6999e848f9427a1cc37dd40ca573", "srcset": "https://si.imgix.net/7dbff746/uploads/origins/1c6ef8fd-7fc4-4551-a445-ad87d0968626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9fd6999e848f9427a1cc37dd40ca573, https://si.imgix.net/7dbff746/uploads/origins/1c6ef8fd-7fc4-4551-a445-ad87d0968626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ab881a0eed57b90dba7a1a03a727023 2x, https://si.imgix.net/7dbff746/uploads/origins/1c6ef8fd-7fc4-4551-a445-ad87d0968626?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c442588f5d6f3a4d9346ebcc3218bd82 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7dbff746/uploads/origins/1c6ef8fd-7fc4-4551-a445-ad87