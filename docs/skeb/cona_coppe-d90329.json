/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae418d8a61175ea3823f8ab4be35a97a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=762f45eee51fcbb928dc88632e77735e", "srcset": "https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=762f45eee51fcbb928dc88632e77735e, https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7ecc73849d3e8d416a4dff3936fce6 2x, https://si.imgix.net/37813d4d/uploads/origins/1d318d0c-767f-4692-913d-60f4383bb81d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4228f12df4292946d60d6818998b1ea0 3x"}, "body": "初めまして！\n\nMisskeyIoでいつもカワイイイラストを拝見しています。\nSkeb再開されないかな～とお待ちしていました！\n\nよろしければうちの子（OC）を描いていただきたいです。\n\n◆うちの子はこちらです\nhttps://drive.google.com/file/d/1OVTdRLLAhEoE8LqHfKWsTEj8Jnu3tZgM/view?usp=sharing\n\n◆お願いしたいシチュエーション的に、衣装の資料はあまり意味がないのですが一応載せます\nhttps://drive.google.com/file/d/143tX1tODXthD4RXiXbKAYB39dbJZ9gNA/view?usp=sharing\n\n内容はお風呂に入った後か、入る前のうちの子をお願いしたいです。\n脱衣所で半裸でいるところに、ご主人様が入ってきちゃって驚き→テレテレ////みたいな…！\n\nほぼ服は脱いでいて、タオルだけや、下着だけくらいな状態だと嬉しいです。\nお胸は見えてると嬉しいかもです。\n\nその他、下着にする場合のデザインや髪を下ろしているかどうかなど\n細部はお任せ致します！\n\nうちの子カワイイさせていただけたら嬉しいです。\nよろしければお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cona_coppe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859640, "client_id": 3290628, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf52e02e36efbd93f041ee8b0609b005", "srcset": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bf52e02e36efbd93f041ee8b0609b005, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a44790ff77bb96ee62569f657252b0ea 2x, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8184e8a4ef1b73e89ef67124d3c66dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b7d7ae5135c0d433d16ae4fc5dfb82", "srcset": "https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b7d7ae5135c0d433d16ae4fc5dfb82, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ea8dd9406c24e66fa7315dfa2baa569 2x, https://si.imgix.net/2704cb48/uploads/origins/47ce2d11-6225-418c-b277-ec5de6117aa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8e5183ca31c8983b375ea917d8deab7 3x"}, "body": "こんばんは!こなこっぺさんがskebを開始したと聞いてすっ飛んできました!!\nぜひともうちのこがお風呂に入っているイラストをお願いしたいと思います…!!\n\n☆キャラ…\n「ノイル」\nオレンジ髪、青目の女の子。\nケモミミは薄いクリーム色、尻尾は白色寄り。\nお胸はぜんぜんありません。\n\n☆シチュ…\n湯船に浸かっている、シャワーを浴びている、体を洗っている…\nなどお風呂に入っているとわかる描写であれば特に問いません。\nお風呂の形式なども問いませんので、ご自由に簡単に描きやすいようにお願いできたらと思います!\n\n自キャラの詳細や参考になるかわかりませんが描いたお風呂絵などを下記に添付させていただきます。\nご検討よろしくお願いいたします!\nhttps://misskey.io/notes/a9pr807x2uax08n1\nhttps://misskey.io/notes/af61tcbznogs06mw", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cona_coppe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859640, "client_id": 3150980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fd852e5dc76c09059f4f6081217111b", "srcset": "https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fd852e5dc76c09059f4f6081217111b, https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4abbdf2db2c061f1ac5abb7b18120c1a 2x, https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87396155168ff3ffd57fbce5bbd3cf8e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe720ea4e6f0eb7351173c0524f658ef", "srcset": "https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe720ea4e6f0eb7351173c0524f658ef, https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed9d10c9c8bc7a4a1d8f7914776f82e4 2x, https://si.imgix.net/451e6ed9/uploads/origins/e12f8611-9a1c-41fc-ac9b-32b7ea00609d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e461c3788d601a8e3006f718482d8a2 3x"}, "body": "skeb開設ありがとうございます！\nすべておまかせで、うちのこ花鈴(かりん、男の子)を描いていただけないでしょうか。\nなるだけえっちなものでお願いしたいです。\n\nおさげのリボンと前髪の花飾りを残していただければ、着衣かどうかも含めて自由にしていただいてOKです。\n\nいくつかネタを出しておきますが、これらである必要はありません。\n・裸エプロン\n・裸ポンチョ(雨合羽)\n・寝間着で白いおもらし\n\nいずれのケースでも性器の描写は必須ではありません。手で隠している等でもOKです。\n\n利用目的: 個人サイトとSNSへの掲載／自身で使用することに限定してのグッズ作成\n資料ページ(健全): https://linkage.millibyte.jp/shirin/\n資料ページ(R-18): https://fairysbed.microbyte.jp/karin/\n\nhttps://fairysbed.microbyte.jp/karin/characters/20251123204948_04146680.jpg", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cona_coppe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3859640, "client_id": 73542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e972b15c/uploads/origins/032abd59-1fe0-4bfe-b2fa-e53c46e595ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07dc64fa55356ae4bc5c5a4ca913ca59", "srcset": "https://si.imgix.net/e972b15c/uploads/origins/032abd59-1fe0-4bfe-b2fa-e53c46e595ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07dc64fa55356ae4bc5c5a4ca913ca59, https://si.imgix.net/e972b15c/uploads/origins/032abd59-1fe0-4bfe-b2fa-e53c46e595ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55836833af98a643013181d3960cf3c8 2x, https://si.imgix.net/e972b15c/uploads/origins/032abd59-1fe0-4bfe-b2fa-e53c46e595ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6681e32b9feb3d64efab8d0b2d6fd5d9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e972b15c/uploads/origins/032abd59-1fe0-4bfe-b2fa-e53c46e595ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=662e713695f80a903b1a4c8eca317588", "sr