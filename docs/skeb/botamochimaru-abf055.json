rigins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feac5135eaff3cf0e6e4579ad85a4d0e", "srcset": "https://si.imgix.net/2408eef5/uploads/origins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feac5135eaff3cf0e6e4579ad85a4d0e, https://si.imgix.net/2408eef5/uploads/origins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d872a345cba2231f90621833acd47ed6 2x, https://si.imgix.net/2408eef5/uploads/origins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78ac8988479e8a906fe6ba6d23f9f6e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2408eef5/uploads/origins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcb8942746cc129eb5259d7a45a0efa8", "srcset": "https://si.imgix.net/2408eef5/uploads/origins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcb8942746cc129eb5259d7a45a0efa8, https://si.imgix.net/2408eef5/uploads/origins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=471519770a5d0c43938c920aa0272e46 2x, https://si.imgix.net/2408eef5/uploads/origins/f3a312be-76b5-4204-a084-ac74127f96aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6555329df94c8a1066c90f8ab6af19e 3x"}, "body": "いつもイラスト拝見させておりました、絵柄や色合いが好みで応援しております。\n\nイラストの依頼です、よろしくお願いします。\n一次創作の自作web小説で小説投稿サイトの表紙絵やTwitterなどでの作品宣伝用で使用致します。\n\n（作品名）「魔法使いと繋がる世界」シリーズ。\n\n(イラスト依頼シーン説明）\n早朝に訪れた雪の降る公園で段ボールのなかに捨てられている白いウサギを拾い上げるシーンです。\n\n（人物説明）\n\n高校三年生の生徒会長代理をしている女子生徒です。（人物名:八重塚羽月）\n身長:168cm、眼鏡をしていて、黒髪ロングヘアーです。\n服装はシーンが冬なので紺のコートを着ていて黒いブーツを履いています。\n表情は彼氏と別れた後で、憂いのある切ない表情をしています。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botamochimaru/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1422050, "client_id": 1892483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=763b2067c569161ddc0105955112d622", "srcset": "https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=763b2067c569161ddc0105955112d622, https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d80fa20ed410fbc8216b284ba529d95f 2x, https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d344277719a0d8402cf2e7a789c6e6ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21e1a193838ce38488279b27b7154202", "srcset": "https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21e1a193838ce38488279b27b7154202, https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fba519c57b2533560f04b0140b8707fd 2x, https://si.imgix.net/1bb8c7cb/uploads/origins/becdc70c-c0bd-4947-b097-77afaaf3e605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e29e5e988d7edaa3ae36f46bdd8f0122 3x"}, "body": "初めまして！\nTwitterでお見掛けして、絵柄が好みだったのでこの度はうちの子をご依頼したくリクエストさせていただきました。\n容姿は下記の参考資料で確認をお願いします。\nポーズ、シチュエーション等のその他諸々はお任せいたします。\n是非ご検討の方よろしくお願いします！\n\n参考資料は下記リンク先になります。\n\nhttps://drive.google.com/drive/folders/1eKNcI1Y-KUEYqlPGJM-u1aXDINLeSgf5?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botamochimaru/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fe37ec49/uploads/origins/2dbf558f-b9e6-4409-9427-f2900d3713ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e113fa8b3b63e51387727db0af606686", "srcset": "https://si.imgix.net/fe37ec49/uploads/origins/2dbf558f-b9e6-4409-9427-f2900d3713ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e113fa8b3b63e51387727db0af606686, https://si.imgix.net/fe37ec49/uploads/origins/2dbf558f-b9e6-4409-9427-f2900d3713ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b57a75985b8e5e36e4bd7b062391b78e 2x, https://si.imgix.net/fe37ec49/uploads/origins/2dbf558f-b9e6-4409-9427-f2900d3713ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=940034941a4731ef69ece26307aa7a69 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1422050, "nc": 0}, {"path": "/@botamochimaru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1422050, "client_id": 684040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=573b0bc361f4b1339d3d2fe3ca219034", "srcset": "https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=573b0bc361f4b1339d3d2fe3ca219034, https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0159f3b5da1525cec2cc2f5dcd93179 2x, https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9680760dd9fef80873ec22c3f225e382 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=914f08c0ad1b1ccb3fbd7a0a03ec510b", "srcset": "https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=914f08c0ad1b1ccb3fbd7a0a03ec510b, https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba383430156dcd2fc6fb04d487cb5d44 2x, https://si.imgix.net/e15a7ac2/uploads/origins/2337991e-9fe6-4519-bfbb-3a693875b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc742ce6dabb7cce36c0bd98f22f4738 3x"}, "body": "Twitterではいつもお世話になっております。\n\n　オリジナルキャラクター、「ヴィルフリーデ・レクシア・アルトヴェレア（偽名：ヴィルシア・アルマ）」の全身像（つま先から頭のてっぺんまで）をお願い致します。\n　画像の比率はお任せしますが、構成イメージの都合上縦長の画像を希望します。また、下部（おそらく脚部になると思われます）に別途用意したタイトルロゴを入れる予定でもあるため、併せて記載します。\n　万が一全身が収まらない場合は、膝上から頭頂部まででも構いません。\n\n　塗り方はブラシ塗りを希望します。\n\n　外見的特徴としては、身長は158cm、3sizeは93/58/90のGカップ、体重は55kg、年齢は18歳です。\n　金髪碧眼です。顔や髪型は「艦これ」の「鹿島」と、以下の画像の女性を融合させたものをお願いします。\nhttps://twitter.com/SchwarzRitter05/status/1602521434114650113?s=20&t=btuExC4r3OEIc8umEwUCPw\n\n　また、表情も笑顔（両目・口ともに、自然に開いた状態）でお願いします。ポージングは、「両脚で立っている状態であり、両手を前に突き出してこちら（読者、閲覧者）を抱き寄せようとしている」ものを希望します。ただし、突き出す両腕の角度が下がりすぎて「すしざんまい」のポーズにならないよう注意願います。\n\n　服装も「鹿島」に寄せたものでお願いします（なお、ヴィルフリーデは戦艦モチーフのキャラクターではないため、戦艦を意識させる意匠は省いてください。主に、腹部付近のイカリや艦体風装飾です。また、肩のモップ状装飾“エポレット”も同様に省いてください。後述する別の階級章を入れるためです）。\n　これらに加えて、服装には以下にさらに詳細な条件を入れさせていただきます。\n\n●服、スカートは共に白色（フチどりは黒。フチの定義としては、幅がスカート面積の1/8～1/15程度であることとします）\n\n●スカートは膝上15cmくらい（太ももが見えて、なおかつパンツが見えずに隠れる程度でお願いします。また、後述のホルスターとナイフの描写に支障が生じる場合は、“膝上、かつパンツが見えない長さ”の範囲内で、長短自由に調節してください）\n\n●左右両襟と両肩に階級章。\n　襟は挿入する参考画像のデザインを（垂直な角度はより正確に垂直になるように、幅は均等になるように）リファインしつつ「黒地に金」、階級章のデザインは左右両襟で同一。着用の仕方は、ナチス親衛隊やルーデル大佐（第2次大戦のドイツ空軍エースの一人）の服装を参考に、「左右の襟に、階級の描かれたワッペンを上から縫い付けたもの」でお願いします。\nhttps://twitter.com/SchwarzRitter05/status/1602520510843453440?s=20&t=btuExC4r3OEIc8umEwUCPw\n\n　肩は画像の配色（白地に黒線2本、星は金）。肩章に限っては金色部分が金属製のため、物理的に盛り上がるように（金属の盛り上がり方は、自衛官の3尉～1佐の階級章を参考に）お願いします。また、参考画像の○の部分（ボタンです。色は金色を指定します）が、体の中央（首方面）寄りの位置となるように描きこんでください。\nhttps://twitter.com/SchwarzRitter05/status/1602520610126856193?s=20&t=btuExC4r3OEIc8umEwUCPw\n\n●両袖に、金色の線を3本ずつ（参考：Library of Ruinaに登場する「親指」の幹部クラスの人物、カーロ、デニス、ボリス、カトリエルが着用しているコートの袖。線同士の間隔は参考よりもう少し広めに）\n\n●右胸付近に、銀色で「頂点のみ開いたC字型（ランドルト環）様の月桂冠と、その中心にいる正面角度の、少し斜め上から見た（見下ろしたイメージです）大きな蛇の頭部（舌は出さず、口も開かないこと。また、蛇の顔は『禍々しい』あるいは『おぞましい』と見る人に感じさせる、恐怖心を煽る顔つきだとより良いです）」のエンブレム\n\n●右肩に飾緒（エギュレットとも。飾り紐）を装着。色は金でお願いします\n\n●黒または紺のニーソックス（装飾が何も無いデザインを希望。可能であれば、太ももがムチッと肉感溢れる描き方をお願いします）\n\n●両手に純白の手袋（手首が隠れる程度の長さで結構です）\n\n●右太もも、体の外側に黒色の革製または樹脂製拳銃用ホルスター（拳銃本体は見えなくて構いません。「スカートの下から少し覗く」くらいの描きこみでお願いします。また、「本来引き金がある部分にボタンが付いており、そのボタンを押しながら引き抜くタイプのホルスター」という指定を追加で入れさせていただきます）\n\n●左太もも、体の外側にナイフの刃先端（こちらも、「スカートの下から少し覗く」くらいの描きこみでお願いします。イメージは軍用サバイバルナイフですが、ナイフかスカートの長さに不安がある場合は暗器に用いる小型ナイフでも構いません）\n\n●靴は黒のコンバットブーツ（構成によっては省略可とします）\n\n　勲章や略綬に関しては、ご自由にお描きください（一切描かれなくても大丈夫です）。参考として、彼女の階級は「特務大尉」です。多めに描かれる場合は、「大尉クラス」と釣り合うように（最大でも、勲章で1～2段程度、略綬なら2～3段程度）お願いします。\n\n　また、顔付きは以下の画像のキャラクターたちを参考にしてください。\n　特に希望する点として、鼻の穴は絶対に描かないでください。その一点以外はすべて画風に委ねます。\n（参考キャラクター1）\nhttps://twitter.com/SchwarzRitter05/status/1602521626763227137?s=20&t=3kjEl90KMgTCQx8r8-5txQ\n（参考キャラクター2）\nhttps://twitter.com/SchwarzRitter05/status/1602521692781568001?s=20&t=3kjEl90KMgTCQx8r8-5txQ\n\n　背景は、銀河風のキラキラをお願いします。\n　ただし、銀河の色は夜風の色ではなく、ピンクやオレンジ、黄色などの明るい配色を希望します。詳細な色は、ヴィルフリーデを目立たせるようにしていただければ、どのような色なのかはお任せします。\n\n　使用目的はタイトル画像（表紙とも。単品でも、タイトルロゴと組み合わせても使います）、各種アイコン画像、宣伝用画像です。\n　不本意である場合は本依頼を無視してください。\n\n「○○様ありがとうございました！」を描かれる場合、○○の部分には、“戌石結城（いぬい ゆうき）様＆有原ハリアー様”の連名でお願いします（「戌石結城」は有原ハリアーの公募用ペンネームです）。\n　可能であれば、ロゴ挿入用の素材として、メッセージを省いたイラストをお送り頂ければ幸いです（悪用防止の観点から困難または不本意である場合は、送っていただかずとも大丈夫です）。\n\n　長くなりましたが、どうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botamochimaru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1422050, "client_id": 159502, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4a591cc/uploads/origins/cc6eaf64-99b5-4c10-a8c1-6170cd2f85a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f99d8bb1e04d18b66d4beed4b89aa9e", "srcset": "https://si.imgix.net/a4a591cc/uploads/origins/cc6eaf64-99b5-4c10-a8c1-6170cd2f85a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f99d8bb1e04d18b66d4beed4b89aa9e, https://si.imgix.net/a4a591cc/uploads/origins/cc6eaf64-99b5-4c10-a8c1-6170cd2f85a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=277b5342f5a18342c51158f09d591b35 2x, https://si.imgix.net/a4a591cc/uploads/origins/cc6eaf64-99b5-4c10-a8c1-6170cd2f85a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11f0db09703760b82e816a751ab6cef7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4a591cc/uploads/origins/cc6eaf64-99b5-4c10-a8c