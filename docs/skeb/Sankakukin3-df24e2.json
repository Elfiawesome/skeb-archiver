profile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff9d186314869330760ac9a6801a6888 3x"}, "body": "さんかくきんさんの中でパッと浮かんだキャラクターとして「とある日の眠れなかった夜のこと」を教えてほしいです。\n内容はそのキャラクターに基づいた創作話でも実際のお話でもなんでも構いません。血やグロい描写がなければ本当になんでもいいです。「つい最近眠れなかったことある？何して過ごしてた？」と聞かれたとし、それに返答するといった感じで話してもらえたら嬉しいです。長さも問いません。 依頼として興味を惹くことができていたら受けてもらえたら嬉しいです。ご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Sankakukin3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 2301874, "client_id": 2576020, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/eaf64894-661d-453d-8464-d1a26fcc988c?response-content-disposition=inline&Expires=1779202395&Signature=AK44hL8Vbbv9Dr05UtrInkWAv3DRd31wEH7ocmAvq03SoqL4yfTUlL~EFFmeVdTgbKCseXZAYKUMLWxFwQOzzEsbCcTWlLPJI0iStBWIkSPIVPNwbwnIp4qpInu58k3kbLQG0lrnRp7bHsOPPwcUiu4erNvCaDnKFarQama8cfKIriRUnZ71r2zACl7KWAnFQIPE-wECRD0~XL2e4TR6rGjtcbtnk2KvAUYmYOYeCfiwdLg-iWxo3ACr5GfnTbzXbZX5v7jN96RWHIO2RVQeh7uF24u4WiMn47bIu9Vq885L0OZ-xdEjpM2x~dDHQUlU2td0jCrqYa1sI4duEqL2CA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ae58386c1d65b15269b8757c1c20ad", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ae58386c1d65b15269b8757c1c20ad, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=310e0b86241ad012c9090c7456bc3efa 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_image