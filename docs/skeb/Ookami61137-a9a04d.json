t/276c2b2c/uploads/origins/c2162072-5987-440d-b0d9-7f92f8e111f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6488666a6472df9398c83f11e8841946, https://si.imgix.net/276c2b2c/uploads/origins/c2162072-5987-440d-b0d9-7f92f8e111f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=502e1a6f4751b020241557f512f60c61 2x, https://si.imgix.net/276c2b2c/uploads/origins/c2162072-5987-440d-b0d9-7f92f8e111f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7d17e2fd186735a722291fb108a364c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/276c2b2c/uploads/origins/c2162072-5987-440d-b0d9-7f92f8e111f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a3b5148ca1408f3cee517cbc6d007f", "srcset": "https://si.imgix.net/276c2b2c/uploads/origins/c2162072-5987-440d-b0d9-7f92f8e111f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a3b5148ca1408f3cee517cbc6d007f, https://si.imgix.net/276c2b2c/uploads/origins/c2162072-5987-440d-b0d9-7f92f8e111f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bfccff9a1b8f02f700d969bbfb331d5 2x, https://si.imgix.net/276c2b2c/uploads/origins/c2162072-5987-440d-b0d9-7f92f8e111f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ada9f1fe7d6f816c7e338e90ce50bd9b 3x"}, "body": "お世話になっております。\n相撲母ちゃんの相撲ライバルのアメリカ人女力士をお願いできますでしょうか?\n\nこのアメリカ人女力士は相撲母ちゃんと同等以上の戦力を誇り、日本で息子とふたり暮らし（夫は死別で、戦後間もない設定です。1950年代くらい）\n\n・学校で大会を控えている息子相手に警告（息子は体操着、アメリカ人女力士はトップレスに赤褌一丁、汗だくで全身湯気あり）\n・稽古後、一緒に風呂。（五右衛門風呂に一緒に浸かっている）\n・深夜庭先でアメリカ人女力士が立ちション（着物姿）、豪快に放屁（ポーズはガニ股）\n・息子と同じ布団で眠っている（息子は洋服）\n最後におまけで、相撲母ちゃんとアメリカ人女力士の幼少期（10歳くらい）の比較をお願いします。→トップレスで褌一丁、汗だく\n\nなお、アメリカ人女力士の容姿は、身長200ｃｍ、相撲母ちゃんよりも筋肉質でブロンドヘアの長髪、美人です。", "nc": 34, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path":