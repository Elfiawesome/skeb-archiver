bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aed00ac96836987d31f63042f019094", "srcset": "https://si.imgix.net/887d5aad/uploads/origins/f0c50eb7-93e1-4d8c-bc4f-5f9828bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aed00ac96836987d31f63042f019094, https://si.imgix.net/887d5aad/uploads/origins/f0c50eb7-93e1-4d8c-bc4f-5f9828bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9408b1cfca0027fb6635c6f45293d8fb 2x, https://si.imgix.net/887d5aad/uploads/origins/f0c50eb7-93e1-4d8c-bc4f-5f9828bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2cec83b3bdcdee8c82c28371b0d61e9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/887d5aad/uploads/origins/f0c50eb7-93e1-4d8c-bc4f-5f9828bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52b2a0139010eee4902f4149bb99444e", "srcset": "https://si.imgix.net/887d5aad/uploads/origins/f0c50eb7-93e1-4d8c-bc4f-5f9828bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52b2a0139010eee4902f4149bb99444e, https://si.imgix.net/887d5aad/uploads/origins/f0c50eb7-93e1-4d8c-bc4f-5f9828bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60d99861cfec0664eea9c35240d9277e 2x, https://si.imgix.net/887d5aad/uploads/origins/f0c50eb7-93e1-4d8c-bc4f-5f9828bad44f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83be904a11f2e21f69d67a4d7b2a1a9d 3x"}, "body": "若い男が若い美人の花嫁と一緒にベッドで寝ていたのに、巨乳のふたなり2人が強引に男の上に座って犯してしまった。\n\n若い青年が、寝ている若い美しい花嫁の隣のベッドに寝ている（二人とも仰向けになっている）。二人のふたなりアンが若い少年を犯している。\n登場人物は全員全裸である。ふたなりや青年の体の細部まではっきり見えるようにしてほしい。\n\nそのふたなりは、自分のマンコを青年の顔の上に追いやり、ヴァギナ、クリトリス、睾丸（今は唾液で濡れている）を無理やり舐めさせました。\n双成は青年の顔の上に座っていたが、今度は顔から降りた。彼女のペニスと睾丸ははっきりと見えていた。\nその舐め方で、青年は目を転がして精液を出した。彼の顔、口、舌は膣液で覆われてしまった。膣液の糸が、ふたなりの膣から青年の口まで伸びている。\nふたなりのチンポから予備精液が滴り落ち、青年の顔（口）に落ちる。\n\n別のふたなりさんが若い男性にアナルファック。何らかの屈辱的なポーズを使う。例えば、https://www.pixiv.net/en/artworks/106477039\n\n新郎は若いイケメンがいい。少年は屈辱に顔を赤らめ、少しむせび泣く。しかしその後、目を丸くして快感に呻きながら射精する。\n\n花嫁は若く整った美しい体、B～Cサイズの乳房を持つ。\n清楚な花嫁の清楚な身体と、ふたなりの淫乱な厚い胸や腹、欲望が対照的です。\n\n若く美しい花嫁とは、できるだけ正反対になるようなふたなりにしてみてください。(描くのに抵抗があるディテールがあれば、好きなように描いてください)\n太くて大きなオッパイ。乳首は黒くて太いゴツゴツしたもの。母乳です。乳。太い力強いチンコ（～30cm）と丸いゴツゴツした玉。厚く突き出たノビノビ大陰唇と厚いクリトリス。\n\n卑下した詳細を追加してください。\n\nバリエーションを加える：\n全員が射精する。精液は、若い男性と花嫁の体に、屈辱的な方法で降り注ぐ。\n\n本文です：\n青年：「おい、お前ら誰だ？すぐに俺から離れろ。俺にはもう好きな女がいるんだ」\nふたなり：「抵抗する男子は、私のチンコとマンコに最高の喜びを与えてくれる」\n「婚約者の体より、俺たちのおっぱいやチンコが好きだと認めろ。お前のチンポがどれだけ硬く勃起し、すでに流れているか見てみろ」\n「しーっ。そんなに大きな声で喘ぐと、婚約者が起きてしまうぞ」\n\nhttps://drive.google.com/drive/folders/1ciCzvA45vLLjREHqOPBCQQYFDqSNHZbR#two_futanari_molest_groom_near_sleeping_bride", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ookami61137/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2600984, "client_id": 861296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ece627d/uploads/origins/2b1bfa47-8403-4a3f-a52b-96f1a444d54f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ace84e556a272c5c674502b1591c4d3", "srcset": "https://si.imgix.net/6ece627d/uploads/origins/2b1bfa47-8403-4a3f-a52b-96f1a444d54f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ace84e556a272c5c674502b1591c4d3, https://si.imgix.net/6ece627d/uploads/origins/2b1bfa47-8403-4a3f-a52b-96f1a444d54f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a051a3fe4950887d72e001ab3ff5c25 2x, https://si.imgix.net/6ece627d/uploads/origins/2b1bfa47-8403-4a3f-a52b-96f1a444d54f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=876ec9ae66297f706afa7877b7d8f29f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si