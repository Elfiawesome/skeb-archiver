=200&s=93401eeb11209e03abb1a90039cdb1e3 2x, https://si.imgix.net/cb24fadb/uploads/origins/a140dde1-1fe4-4e7b-a479-3e4554576313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0eca6025ee7c3e5aa4eff706cce7b96d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb24fadb/uploads/origins/a140dde1-1fe4-4e7b-a479-3e4554576313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=639283c45bf1063d4e7c7c98891d4dd5", "srcset": "https://si.imgix.net/cb24fadb/uploads/origins/a140dde1-1fe4-4e7b-a479-3e4554576313?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=639283c45bf1063d4e7c7c98891d4dd5, https://si.imgix.net/cb24fadb/uploads/origins/a140dde1-1fe4-4e7b-a479-3e4554576313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e72840689bef8774368fb5d1e14b856b 2x, https://si.imgix.net/cb24fadb/uploads/origins/a140dde1-1fe4-4e7b-a479-3e4554576313?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a81401b0890d8fc4d1b5cc8bfe9a990c 3x"}, "body": "少年はフタナリ集団に輪姦される。\nプレゼントを手にした童貞のイケメン少年が、若いお気に入りの女の子とのデートに駆けつけ、ついにその女の子とキスをすることを夢見ていた。路地裏で少年は、セックスに飢えた淫乱なフタナリ（売春婦、ホームレス、変態）数人につかまる。フタナリたちは少年に淫らに触れ始め、ディープキスをし、よだれを垂らす指を口に入れ、服を脱がせ、乳首を揉み、ズボンに手を入れ、チンコを掴み、睾丸をしごき始めた。少年は「すでにお気に入りの女の子がいる」と言ったが、女たちはそれに性的興奮を覚えるばかりで、さらに積極的に少年を性的虐待し始めた。\n\n少年の顔をふたなりの睾丸に押し付けると、少年は睾丸を舐めることをきっぱりと拒否した。それから彼女たちはピンク色の媚薬の入った注射器を何本も取り出し、睾丸、乳首、ペニスといった少年の最も敏感な場所に注射した。\n媚薬は少年の性欲と体の感度をニンフォマニアのレベルまで高め、少年が抵抗するのを難しくした。\nふたなりたちは、少年をまるで女の子でクリトリスやマンコやおっぱいがあるかのように言い、絶えず辱める。\n少年は処女を奪わないでくれと懇願する。ふたなりは承諾するが、少年に性的なしゃがみ姿勢を強要し、ふたなりの節くれだった睾丸（とちんぽ）を舐めさせる。\n\nメインシーン。\nしゃがんでいる少年の後ろに座っていたフタナリは、自分のペニスを少年の肛門の下に入れた。少年の懇願と服従をよそに、ふたなりはゆっくりと、そして大きな快感とともに少年を自分のペニスの上に降ろし、少年の処女を奪った。この時、彼女は少年の片方の睾丸をマッサージし、また少年の乳房を揉みしだき、乳房を大きく見せた。両脇にいた他のフタナリたちは少年の口を犯していた。少年は抵抗したが、快感に耐えられず激しく射精した。フタナリたちは勝ち誇ったように笑ったが、少年は処女を奪われた恨みで泣いていた。フタナリ：「あなたは私たちをとても愛している。あなたはガールフレンドにではなく、私たちに処女を捧げることを選んだのです」。その後、フタナリたちは少年とダブル挿入を含む様々な卑猥な体位でセックスし、少年を何度も射精させた。\nフタナリたちは少年を犯し終えると、彼の体に淫らなメッセージを残し、写真を撮った。犯された少年はザーメンまみれで横たわり、まるで路地裏に捨てられたザーメンまみれの売春婦のようだった。\n\nhttps://drive.google.com/drive/folders/15zjr1nqe09hHeKexUxMrRQQwS2HgNtHa#back_alley_futanari", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ookami61137/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c35a16f3/uploads/origins/31f53b5d-0d55-4d47-b1fb-54af74a783ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c95c5f4fee00f2769cc8abb8922fee0d", "srcset": "https://si.imgix.net/c35a16f3/uploads/origins/31f53b5d-0d55-4d47-b1fb-54af74a783ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c95c5f4fee00f2769cc8abb8922fee0d, https://si.imgix.net/c35a16f3/uploads/origins/31f53b5d-0d55-4d47-b1fb-54af74a783ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4f965b8edf9685153918e686ed97d2d8 2x, https://si.imgix.net/c35a16f3/uploads/origins/31f53b5d-0d55-4d47-b1fb-54af74a783ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccc84fa12cbdae4ea8e9ba698ab15685 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2600984, "nc": 51}, {"path": "/@Ookami61137/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1921351c/uploads/origins/06f6d494-a8f2-478d-bca0-b21f00e74bfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsi