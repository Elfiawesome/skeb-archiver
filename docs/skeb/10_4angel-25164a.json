f4-41b4-ae13-48d4fe017f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05013fe1cb3bdfea592042f67980be01", "srcset": "https://si.imgix.net/3cb18909/uploads/origins/d5ae47c9-0cf4-41b4-ae13-48d4fe017f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05013fe1cb3bdfea592042f67980be01, https://si.imgix.net/3cb18909/uploads/origins/d5ae47c9-0cf4-41b4-ae13-48d4fe017f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=391feff97d30607c31eaa7f4f57bf25c 2x, https://si.imgix.net/3cb18909/uploads/origins/d5ae47c9-0cf4-41b4-ae13-48d4fe017f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=082fbef3d93b4ec4a02da138c63088b7 3x"}, "body": "星村 ゆめぁさま\n\nはじめまして。Xで星村 ゆめぁさまのイラストを拝見し、あまりにも絵柄や色使いが可愛らしく一目惚れしました！どの女の子も最高に可愛くてときめきます😭大好きです。\n今回は是非星村 ゆめぁさまに拙宅のキャラクターを描いていただきたくリクエストを送信させていただきました。\n\n女子高生で人気女優をしているキャラクターです。かわいければなんでも着るオシャレ好きな少女です。身長は170cm。普段は明るい少女として演技で振る舞っていますが、実際はメンタルが不安定です。本来はかなり気弱でよく泣く卑屈な性格であり、ストレス過多になると演じている明るい性格と本来の暗い性格が不本意にどちらも不安定に表面に出て二重人格のようになってしまいます。\n\nピンク髪でインナーカラーが水色/瞳は上側がピンクの緑目です。\n\n用途としては、個人での印刷と鑑賞、SNSのアイコンもしくはヘッダーで使用する場合があります。商用利用はいたしません。\n星村 ゆめぁさまの描かれるお洋服やセンスが大好きなのでリボン・フリルを使ったロリータファッションが是非みたいです。髪型を変えたりしても問題ございません。お好きに描いていただきたいです…！表情も明るいもの/気弱そうな顔のどちらも嬉しいのでお任せします。\n色々着せ替えてしまってキャラクターデザインがわかりにくいかもしれませんが、一番標準的なキャラクターデザインは「全身」という画像を参照ください。\n\n宜しければご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tIi2szJZgwplSblYmeiDLKxGvh739Lfi", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@10_4angel/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3596968, "client_id": 3425808, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a03ebea8f3d305ad65699d491b9a03a", "srcset": "https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a03ebea8f3d305ad65699d491b9a03a, https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd49fa2ea675ba4da58c49a8fb48fadd 2x, https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91351fc85d29afc4d659cc900a9b3933 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7054d29e6e1e58235db4aa0760d76ed", "srcset": "https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7054d29e6e1e58235db4aa0760d76ed, https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=230ff7e2acbc6f7f5e180f15522e8c9b 2x, https://si.imgix.net/19376e21/uploads/origins/fcf43d32-574e-44e8-923d-a8992530eab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c43548186d0be19fd86018b0230f3c28 3x"}, "body": "先生こんにちは！本当に先生のイラストが大好きで、どの作品もとても美しくて感動しています…！そこで今回は、私の一人のオリジナルキャラクターのイラストをぜひご依頼させていただきたく思います！\n\n私のOCは、氷の結晶から生まれた真っ白なアルビノリスです❄️\n\n【キャラクター情報】\n名前：アネイラ（Aneira）\n年齢：16歳（美少年）\n目の色：アイスブルー\n髪の色：雪のように純白\n髪型：前から見るとショートヘアですが、首の後ろの髪はとても長く、ふともも〜ふくらはぎほどの長さです。\n特徴：ふわふわの大きな尻尾と大きなとがった耳を持っています。\n中性的な美少年で、性別が分からないくらい可愛らしく、よく女の子に間違われますw\n\n【本来の姿】\n手のひらに乗るほどの純白な小リスで、アイスブルーの瞳はまるでサファイアのよう。\n胸元には小さな黒いリボン、耳には郁金香の花飾り、尻尾にはリボンが結ばれています。\n\n【性格】\n恥ずかしがり屋で内向的、静かな性格の可愛いけれど無表情な子です。\n年上や大人の仲間にとても大切に守られて育ったため、少し純粋で泣き虫なところがあります。\n拗ねたり、大切な人と喧嘩した時は、雪の中に隠れてこっそり尻尾を抱えて泣いてしまうので、周りは彼を責めたり怒ったりできなくなります。\nふわふわの自分の尻尾が大好きで、寝るときは尻尾を抱えて丸まって眠る姿は、まるで白いお団子のようです。\n温泉が好きで、雪を見ながら温泉に入るのが好きです。木の上で食べるのもお気に入り。\n\n【好きな食べ物】\nホットチョコレート、マシュマロ、おでん、いちごミルク、白玉団子、桜餅、いちご、餅\n\n【好きなもの】\nふわふわしたもの。白いネザーランドドワーフというウサギを飼っており、名前は「モチ（Mochi）」です。\n\n【衣装】\n「outfit 3」または「outfit 6」をぜひご使用ください。\n装飾：もし可能でしたら、可愛いステッカー風の装飾もぜひお願いいたします。リボンや花などのモチーフがとても好きです！\n\n【表情】\n先生のご自由にお任せしますが、Aneiraは普段はあまり笑いません。好きな人や家族の前では、ほんの少し微笑みます。\n\n【ポーズ】\nこちらも先生のご自由にお願いいたします。\n\nお忙しい中、最後までお読みいただき本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1iQjK5IGbnHAvI5eNG7tz0e2QJT2Cfdr0?usp=share_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@10_4angel/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3596968, "client_id": 3451045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7651bf33/uploads/origins/a464afe3-1292-439c-b5bf-4a48931ab81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1525e4cd615ce01b8169face70f329d", "srcset": "https://si.imgix.net/7651bf33/uploads/origins/a464afe3-1292-439c-b5bf-4a48931ab81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1525e4cd615ce01b8169face70f329d, https://si.imgix.net/7651bf33/uploads/origins/a464afe3-1292-439c-b5bf-4a48931ab81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3456235220caedfcd13ae40f5fdf5d3e 2x, https://si.imgix.net/7651bf33/uploads/origins/a464afe3-1292-439c-b5bf-4a48931ab81c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d09dc499ed0a2350fce1ff33426b6815 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7651bf33/uploads/origins/a464afe3-1292-439c-b5bf-4a48931ab81c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur