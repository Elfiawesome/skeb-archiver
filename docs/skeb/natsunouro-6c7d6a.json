7b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=366d8793b4f2b4f4746254b9500e5f70 2x, https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68cbf2bb831d542c3569f92097814e03 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9da70c044995cfb4421a039f083e5a9", "srcset": "https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9da70c044995cfb4421a039f083e5a9, https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18ca3ea6034da55feed1a00012711b15 2x, https://si.imgix.net/585ce4a5/uploads/origins/5fccb929-d279-497b-9c76-20dc4063366b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5770c0edf34190bf39d75ad7f21e70d 3x"}, "body": "こんにちは、私はあなたの絵がとても好きです！\n\n絵をお願いしてもいいですか？私のオリジナルキャラクターであるチェンユーを全裸にして、黒いスライムや触手から逃れながら、ペニスをフル勃起させた力強いポーズで描いてほしいです。\n\n髭を生やし、肌は白く、髪は紫か赤、筋肉質で、胸と腕にタトゥーが入っています（タトゥーの詳細はお任せします）。\n\nURLの1枚目の写真は、私が話しているシナリオとポーズの例です。URLの2枚目の写真は、Chenyuの参考写真です。\n\nこの度はご検討いただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/158Z_w7DMZm3ARVj9uM_y0OhMsifnjGY4?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natsunouro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1283237, "client_id": 1242557, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928be84efdeff6a43cfa077b5d7c876d", "srcset": "https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=928be84efdeff6a43cfa077b5d7c876d, https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef606ea6651fcdb019e12f5aea591597 2x, https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4eb4c850f2efbb773ef948e60c120a6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e73a0c3166fd8f64e84371a164e160eb", "srcset": "https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e73a0c3166fd8f64e84371a164e160eb, https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d7369f4f12e8bcb448d5579242a91e6 2x, https://si.imgix.net/358bafc7/uploads/origins/19d52ea3-fda8-41be-9bd8-9a2bb6f26520?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d438b1eed2d3fcea11714490dd0525a 3x"}, "body": "ご挨拶。\n\n私はあなたに絵のリクエストをしたいと思います。私のオリジナルキャラクター、便宜上ブラックさんとホワイトさんと呼ぶことにしますが、この二人の絵が欲しいのです。二人とも全裸で、ホワイトさんがブラックさんに上手にフェラチオをしているような絵をお願いします。\n\nブラックさんはホワイトさんの頭をつかんで、満足そうな、あるいは叫んでいるような表情をしています。ホワイトさんの口やあごからは精液が滴り落ち、ブラックさんのおしりやお尻をつかんでいます。\n\n私のURLに写真を掲載しましたので、参考にしてください。\n\nブラックさんは金色の王冠をかぶっていて、先の尖ったエルフの耳をしています。彼はとても筋肉質で、少し日焼けした肌をしています。\n\nホワイトさんはブラックさんよりも肌が明るく、痩せていて、帽子をかぶっていません。ホワイトは、片側の胸と肩と腕にタトゥーが入っていますが、デザインは鯉のぼりやドラゴンなど日本的なものであれば、お任せします。\n\nまた、フェラチオのポーズの例も参考にしました。\n\nご検討いただき、ありがとうございました。\n\nhttps://drive.google.com/drive/u/0/folders/1cSxzJbCYW0tBLeumNNSJ5d9drV_TdOdA", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1303, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "武侍", "screen_name": "takezamurai", "avatar_url": "https://pbs.twimg.com/profile_images/1965119675362410503/gEaHuwKK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/68666440/1551150026/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 33}, {"id": 67940, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "かげる🌪", "screen_name": "mofnyan", "avatar_url": "https://pbs.twimg.com/profile_images/1990828608991211521/FRDxJLKR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/149750527/1763448656/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 177}, {"id": 70297, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ブロークン", "screen_name": "BROKEN_OSUKEMO", "avatar_url": "https://pbs.twimg.com/profile_images/1948865050015662083/SNOOI2f8.png", "header_url": "https://pbs.twimg.com/profile_banners/1130801800217366530/1753480611/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all"