u6570\u679a\u5dee\u5206\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u3001\u305d\u308c\u305e\u308c\u306e\u5e0c\u671b\u5dee\u5206\u3092\u66f8\u304b\u305b\u3066\u9802\u304d\u307e\u3059\u3002\n\n1. \u304a\u8336\u3092\u305f\u304f\u3055\u3093\u98f2\u3093\u3060\u306e\u3067\u3061\u3087\u3063\u3068\u3057\u305f\u5c3f\u610f\u3092\u611f\u3058\u59cb\u3081\u305f\u6771\u98a8\u8c37\u65e9\u82d7, \u307e\u3060\u6211\u6162\u3067\u304d\u308b\u306e\u304b\u3001\u3082\u3058\u3082\u3058\u3057\u3066\u3044\u307e\u3059\n\n2. \u5c3f\u610f\u304c\u9650\u754c\u9593\u8fd1\u306b\u8feb\u308a\u3001\u5927\u4e8b\u306a\u3068\u3053\u308d\u3092\u304e\u3085\u3063\u3068\u62bc\u3055\u3048\u606f\u3092\u8352\u304f\u3057\u306a\u304c\u3089\u3001\u304c\u304f\u304c\u304f\u3068\u8eab\u4f53\u3092\u9707\u308f\u305b\u306a\u304c\u3089\u5fc5\u6b7b\u306b\u6211\u6162\u3057\u3066\u3044\u307e\u3059\u3002\n\u3053\u306e\u6642\u3001\u5c11\u3057\u305a\u3064\u51fa\u3057\u3066\u3057\u307e\u3048\u3070\u5927\u4e08\u592b\u3060\u3068\u601d\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002\n\n3. \u3064\u3044\u306b\u6211\u6162\u3057\u304d\u308c\u306a\u304f\u306a\u3063\u305f\u304a\u3057\u3063\u3053\u304c\u3001\u30b7\u30e7\u30fc\u30c4\u306b\u5c11\u3057\u305a\u3064\u6ef2\u3093\u3067\u3044\u304d\u307e\u3059\u3002(\u670d\u306e\u8868\u9762\u306b\u307e\u3067\u306f\u307e\u3060\u6fe1\u308c\u3066\u306a\u3044\u611f\u3058\uff09\n\n4. \u5c11\u3057\u3088\u304f\u306a\u308b\u611f\u3058\u3067\u52b9\u679c\u304c\u3042\u308b\u3068\u601d\u3046\u306e\u304b\u3001\u307b\u3063\u3068\u3057\u305f\u8868\u60c5\u3092\u3057\u307e\u3059\u3002\n\n5. \u307e\u305f\u304a\u3057\u3063\u3053\u3092\u5c11\u3057\u305a\u3064\u6d41\u3057\u307e\u3059\u3002 \u6fe1\u308c\u305f\u90e8\u5206\u304c\u5c11\u3057\u305a\u3064\u5e83\u304c\u308a\u307e\u3059\u3002\n\n6. \u3053\u306e\u3068\u304d\u3001\u6b62\u3081\u3089\u308c\u306a\u304b\u3063\u305f\u306e\u304b\u6c34\u306e\u6d41\u308c\u304c\u5f37\u304f\u306a\u3063\u3066\u30b9\u30ab\u30fc\u30c8\u3084\u5e8a\u3082\u6fe1\u308c\u3066\u3044\u304d\u307e\u3059\u3001\u601d\u3063\u305f\u3088\u308a\u5f37\u3044\u5e79\u306b\u5c11\u3057\u9a5a\u3044\u305f\u8868\u60c5\u3067\u3059\u3002\n\n7. \u3064\u3044\u306b\u6c17\u529b\u304c\u5c3d\u304d\u3066\u3057\u307e\u3044\u3001\u304a\u3082\u3089\u3057\u3092\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u3002\u6c34\u306e\u6d41\u308c\u304c\u3068\u3066\u3082\u5f37\u304f\u3066\u4e0b\u7740\u306e\u524d\u90e8\u3068\u7aef\u304c\u307b\u3068\u3093\u3069\u6fe1\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002\n\n8. \u304a\u3082\u3089\u3057\u304c\u7d42\u308f\u308a, \u6065\u305a\u304b\u3057\u3055\u3068\u3068\u3082\u306b\u89e3\u653e\u611f\u3067\u8208\u596e\u3057\u305f\u611f\u3058\u3082\u3059\u308b\u3088\u3046\u3067\u3059\u3002\n\n\u52a0\u3048\u3066\u3001\u3061\u3087\u3063\u3068\u3057\u305f\u30bb\u30ea\u30d5\u3082\u3042\u3063\u305f\u3089\u3044\u3044\u306a\u3068\u601d\u3044\u307e\u3059\u3002 \u3069\u3093\u306a\u30bb\u30ea\u30d5\u3092\u5165\u308c\u308b\u304b\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\n\u3088\u308d\u3057\u3051\u308c\u3070\u304a\u9858\u3044\u3057\u307e\u3059\u3002 \u304a\u5fd9\u3057\u3044\u3068\u3053\u308d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mokotiger/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 37511, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7bde6c8080f6cf6920990b5016c5a03", "srcset": "https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7bde6c8080f6cf6920990b5016c5a03, https://si.imgix.net/97405102/uploads/origins/6a22d415-3db2-4596-ae69-754a3c0d9c64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit