いです。キャンバスサイズが小さいと感じる場合は縦横比はそのままでいくらでも大きくして頂いて構いません)\n\n【キャラクター参考資料】\nhttps://drive.google.com/drive/folders/1-NwALDQsGvgc1Lf-kBQOcGZ2nVjpOzjjに詳細有・googleドライブにジャンプします\n\n【スマートフォンケース作成をご依頼する業者様】\nhttps://www.yotsuba-insatsu.com/ 様\n\n依頼内容は以上となります。是非よろしくお願い致します！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍@くりえいてぃ部 L01･02", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/2039687848933421056/N4XqcZ9C.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 160}, {"id": 74702, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ReNiA", "screen_name": "xxx_WG_869", "avatar_url": "https://pbs.twimg.com/profile_images/1970326426693050371/d8vJiDJ7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1302773748848762885/1763805501/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 161}, {"id": 1708009, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "放電映像", "screen_name": "nevion_jp", "avatar_url": "https://pbs.twimg.com/profile_images/1473644889737154566/PlRFX9zG.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30