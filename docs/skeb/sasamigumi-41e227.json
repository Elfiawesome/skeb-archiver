ur=200&s=af375ced1a3018831036e1cec76508f2 2x, https://si.imgix.net/dc705c75/uploads/origins/d5baa40f-e641-48e7-a0e5-6d3cdd9d09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb6b1fe42bb85116267ee2595d0c9df 3x"}, "body": "ささみグミ先生、こんにちは！先生の作品が大好きで、私のイラストを描いていただけませんか？構図も色もお任せしますので、自由に描いていただけたらと思います！詳しい設定は url を参考にしてもらえるので検討してほしい，【設定図10】の衣装を描いていただきたいです\nもし金額がご希望に合わない場合は、調整して再送することも可能です！\nこのたびのご依頼に関して、どうぞご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14Rfoh01EI2Y38yZQnP2HVRZCArQaPRY0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sasamigumi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2776307, "client_id": 34152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08cfee86e04421665bc2100b5c5703b9", "srcset": "https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08cfee86e04421665bc2100b5c5703b9, https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ea2d01722f414242364bb1b6a02fe44 2x, https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=096c91c5028e3683b5e5cb7c1eb10875 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=501b406c8cd44544706d5e0e6fd97653", "srcset": "https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=501b406c8cd44544706d5e0e6fd97653, https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39acc97da809eb92ea1deb394ceeef8e 2x, https://si.imgix.net/c8ed9db6/uploads/origins/33ffe40b-0030-4514-8867-7da685b5b965?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f32e22d9fce3d54b4863704db2bd2907 3x"}, "body": "ささみｸﾞﾐ先生、はじめまして。\n\nブルアカに登場するノノミが学校で発情してしまい、制服半脱ぎの格好で自分のおっぱいを自分で吸いながら気持ちよさそうにセルフ乳吸いオナニーしてしまうカラーイラストをリクエストしてもよろしいでしょうか？\n\n希望する主な要素と内容は・・\n・上着から両胸と両肩を曝け出し、片足パンツの格好でオナニー\n・片方の手で自分のおっぱいを自分の口元まで寄せて、自分の乳首を丸ごと咥えながら気持ちよさそうにセルフ乳吸い\n・もう片方の手で余った乳首をクリクリ弄る\n・両方の胸に唾液が垂れている\n・セルフ乳吸いオナニーが気持ちよくてアソコが濡れている\n・激しく自慰行為に浸ってしまい、体中汗塗れ\n・快感によりハート目＋涙目\n\nシチュエーションに合った適当な台詞やエッチな擬音も入れていただけると嬉しいです。\n\nイッちゃう差分もあると嬉しいですけど、負担になるようでしたら無くても結構です。\n\n納品形式はpsdを希望します。\n\nご検討のほどよろしくお願い致します。\n\n参考URL:\nノノミ\nhttps://bluearchive.wikiru.jp/attach2/E3838EE3838EE3839F_E3838EE3838EE3839F5F302E706E67.png\n\nセルフ乳吸い\nbit.ly/3SEjZ6W　（４ページ目）\nbit.ly/3AbhzWi\nbit.ly/3vYk2AW\nbit.ly/3daUnyb", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sasamigumi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2776307, "client_id": 2772219, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6d7071d/uploads/origins/b96777d5-c5c7-4c3f-814b-a3b560a7d829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9246425c140de7f5b6bf93d46f62ba67", "srcset": "https://si.imgix.net/e6d7071d/uploads/origins/b96777d5-c5c7-4c3f-814b-a3b560a7d829?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9246425c140de7f5b6bf93d46f62ba67, https://si.imgix.net/e6d7071d/uploads/origins/b96777d5-c5c7-4c3f-814b-a3b560a7d