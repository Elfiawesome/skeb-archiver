a-8ecb-a3a7c28c86df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e79da51a075f0b7e286a90c926a0143 2x, https://si.imgix.net/0ce6cac6/uploads/origins/7e75536b-897e-48fa-8ecb-a3a7c28c86df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97289263ac0955ba006000c908c020a9 3x"}, "body": "いつも素敵なイラスト拝見しております。初めてリクエストを送らせていただきます。よろしくお願いします。\n\n【シチュエーション】\nにじさんじの天宮こころが、トイレ列（大）のカードを持ち、恥ずかしがりながらも便意に抗っている様子。また、列が進みあと少しというところでおしっことうんちを大量に漏らしてしまうところ\n\n服装（https://share.google/TiygCj3TMOrgkvEL7）\n\n決壊する際には、以前描かれている（https://skeb.jp/@m0496nmz/works/7）の茜ちゃんのように立った状態で踏ん張っている様子を描いてほしいです。地面には漏れたおしっこや溢れた健康便が積み上がっている様子を描写してください。\nまた、膨らんでいるパンツの様子も描いてほしいです。\n踏ん張っている声やうんちの擬音なども付けて欲しいです。\n\nご検討よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m0496nmz/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3381390, "client_id": 3014814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc15959aa0fa647b69a7f982deb748db", "srcset": "https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc15959aa0fa647b69a7f982deb748db, https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0ec140f35f798460f26b1c36ad265d3 2x, https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e567ee7cf0dc7d10b6f0c9bc701e569b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066f39a797cc93dcb97e94ceaf390a33", "srcset": "https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066f39a797cc93dcb97e94ceaf390a33, https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe19e4e3cefcc274a3d28dc5b5beb087 2x, https://si.imgix.net/e3029c27/uploads/origins/39ad6618-c5fa-4800-a9a2-9d34d07b6a21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ae67450e1c6f30e7aa859f2ab7f620d 3x"}, "body": "私のオリジナルキャラたちの三者三様の脱糞姿を描いていただけると嬉しいです。\n\n【秋山令　キャラクター設定】\n・黒髪ショートカット\n ・柔和な顔つき、巨乳（B90くらい？）低身長 \n・下の毛が濃い\n参考画像→https://imgur.com/a/bkKZb8C\n\n【戸隠しまい　キャラクター設定】\n癖っ毛とそばかすを気にしているモブ顔っぽい女の子\n妙に自己顕示欲があり、顔を隠して配信などをやっている（らしい）\n普段はマスクを使うことが多い\n参考画像→ https://imgur.com/a/m8gFi9J\n\n【夏海みなと　キャラクター設定】\n・デザイン参考は資料URL参照\n・褐色肌の大学生、水泳経験者でスポーティなイメージ\n・バスト80くらい\n参考画像→https://imgur.com/a/BLkF6wj\n\nそれぞれ普段着姿と排泄姿を描いていただけると嬉しいです。\nプレイとしては\n\n秋山令→裸で口に黒いベルトと白いボールの穴あきボールギャグを咥えてよだれを垂らしながらペットシーツの上に脱糞\n戸隠しまい→普段着姿から下だけを脱いで黒いマスクをして脚をガニ股にし気持ちよさそうに脱糞\n夏海みなと→白いビキニの上下を身につけたままもりもりと着衣脱糞\n\nというシチュエーションで、細部についてはお任せします。\nどうぞよろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m0496nmz/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c3144c42/uploads/origins/eef10deb-6706-4ba4-82e0-920f990cba28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b8ebb1ffeaf46dff99cb4221c7dd52ab", "srcset": "https://si.imgix.net/c3144c42/uploads/origins/eef10deb-6706-4ba4-82e0-920f990cba28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to