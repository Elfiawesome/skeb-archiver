9e38-c6d29171f05a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b67b7610f572930d905ca7b2f6746e04", "srcset": "https://si.imgix.net/300bb32f/uploads/origins/ab11b42c-87b6-411e-9e38-c6d29171f05a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b67b7610f572930d905ca7b2f6746e04, https://si.imgix.net/300bb32f/uploads/origins/ab11b42c-87b6-411e-9e38-c6d29171f05a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7b66d725d4f2d4a552bee3b9738f971 2x, https://si.imgix.net/300bb32f/uploads/origins/ab11b42c-87b6-411e-9e38-c6d29171f05a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a8dde5fb39b9bee0159c61a2e168eab 3x"}, "body": "二人の女子高生が、一枚のおむつを共有して密着するシチュエーションを描いてほしい。\n\n一人目の女子は裕福な家庭の娘で、普段からハイヒールと上品な服を着ている。二人目の女子はゴスパンク風の少女で、黒い服とブーツを身に着けている。二人は知り合いで、性格が衝突するため互いに嫌悪し合っている。\n\nある日の放課後、二人は校内でいじめっ子グループに囲まれる。いじめっ子たちは二人を背中合わせに押し付け、下着を脱がせて一枚のおむつを装着。接着剤で二人の腰に固定すると、服を奪って逃走する。取り残された二人はどうすべきか途方に暮れる。さらに追い打ちをかけるように、二人は必死に排尿と排便を我慢していた。必死におむつを剥がそうとするが無駄だった。互いに罵り合い、責任を押し付け合いながら離れようとする中、ついに二人とも我慢できずにそのおむつに漏らしてしまう。打ちのめされた少女たちは尻餅をつき、混ざり合った排泄物が下でぐちゃぐちゃに潰れる。教師に見つかるまで、二人は泣きながらその不潔さを嘆く。\n\n最後のコマでは、保健室で学校の用意した服を着た二人が手をつなぎ、恥ずかしそうに使い捨ておむつを見つめている。看護師が二人を慰めている。\n\nいじめっ子、教師、看護師は場面に登場する必要はないが、オフスクリーンの台詞で表現可能。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m0496nmz/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3381390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eba5dca6/uploads/origins/4a340086-e39f-44a2-a32f-94c179e8209a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5eb4616ff78dcdcfcf3b36a6619ea81", "srcset": "https://si.imgix.net/eba5dca6/uploads/origins/4a340086-e39f-44a2-a32f-94c179e8209a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5eb4616ff78dcdcfcf3b36