51\u3092\u9802\u304d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01\n\u5fdc\u63f4\u3057\u3066\u3044\u308b\u6d3b\u52d5\u8005\u69d8b\u3055\u3093(bakuhaBoooM)\u306e\u30c4\u30a4\u30ad\u30e3\u30b9\u30b5\u30e0\u30cd\u30a4\u30eb\u3092\u3054\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\n\u2460\u30b3\u30c6\u30ad\u30e3\n_ \u9ed2\u9aea(\u30cf\u30a4\u30e9\u30a4\u30c8\u306f\u304a\u4efb\u305b)\u3001\u3075\u308f\u3075\u308f\u3068\u3057\u305f\u732b\u3063\u6bdb\u306e\u3088\u3046\u306a\u611f\u3058\u3067\u3001\u5916\u30cf\u30cd\u3082\u3042\u308a\u307e\u3059\u304c\u3001\u5168\u4f53\u306e\u30d0\u30e9\u30f3\u30b9\u7684\u306b\u306f\u4e38\u3044\u30d5\u30a9\u30eb\u30e0\u306b\u53ce\u307e\u308b\u3088\u3046\u306a\u9aea\u578b\u3002\n_ \u8868\u60c5\uff1a\u82e5\u5e72\u76ee\u306e\u4e0b\u306b\u30af\u30de\u304c\u3042\u308a\u3001\u7121\u6a5f\u8cea\u306a\u30a4\u30e1\u30fc\u30b8\n_ \u670d\u88c5\uff1aY\u30b7\u30e3\u30c4\u306b\u30d1\u30fc\u30ab\u30fcor\u30e2\u30fc\u30c9\u7cfb\u306e\u670d\u3092\u91cd\u306d\u7740\u3057\u3066\u3044\u308b\u3002(\u30e2\u30fc\u30c9\u7cfb\u306b\u3064\u3044\u3066\u306funited tokyo\u3084HARE\u306a\u3069\u306e\u30d6\u30e9\u30f3\u30c9\u306e\u304a\u6d0b\u670d\u304c\u30a4\u30e1\u30fc\u30b8\u3068\u3057\u3066\u306f\u4f1d\u308f\u308a\u3084\u3059\u3044\u3068\u601d\u3044\u307e\u3059)\n_ \u30c1\u30e3\u30fc\u30e0\u30dd\u30a4\u30f3\u30c8\uff1a\u307e\u3064\u6bdb\u304c\u5973\u6027\u5bc4\u308a\u3067\u3042\u308a\u7f8e\u5f62\u306a\u7537\u306e\u5b50(\u672c\u6570\u3088\u308a\u3082\u675f\u611f\u3067\u8868\u73fe\u3057\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u52a9\u304b\u308a\u307e\u3059)\u3001\u5de6\u76ee\u306e\u4e0b\u306b\u30db\u30af\u30ed\u306e\u3088\u3046\u306a\u00d7\u30de\u30fc\u30af\u304c1\u3064\u3001\u76ee\u306f\u5927\u304d\u3081\u306e\u732b\u76ee\u306e\u3088\u3046\u306a\u611f\u3058\u3067\u5c11\u3057\u3064\u308a\u6c17\u5473\u3002\u7e26\u5e45\u306f\u5e83\u3081\u3067\u3059\u3002\n\n\u2b06\ufe0f\u4e0a\u8a18\u304c\u30b3\u30c6\u30ad\u30e3\u8a73\u7d30\u306b\u306a\u308a\u307e\u3059\u3002\n\n\u2461\u4f5c\u6210\u3057\u3066\u9802\u304f\u30a4\u30e9\u30b9\u30c8\u30a4\u30e1\u30fc\u30b8\u306b\u3064\u3044\u3066\n\u6d3b\u52d5\u8005\u69d8\u304c\u732b\u3061\u3083\u3093\u3059\u304d\u306e\u65b9\u306a\u306e\u3067\u3001\u732b\u3061\u3083\u3093\u3092\u4e00\u7dd2\u306b\u63cf\u304d\u8fbc\u3093\u3067\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u30b5\u30e0\u30cd\u30a4\u30eb\u3068\u3057\u3066\u4f7f\u7528\u3059\u308b\u4e88\u5b9a\u306e\u30a4\u30e9\u30b9\u30c8\u306b\u306a\u308a\u307e\u3059\u306e\u3067\u3001\u30a4\u30e9\u30b9\u30c8\u306e\u4e0a\u90e8\u5206\u306b\u30b9\u30da\u30fc\u30b9or\u67a0\u7d44\u307f\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u3001\u305d\u3053\u306b\u96d1\u8ac7\u914d\u4fe1\u3001\u6b4c\u67a0\u914d\u4fe1\u3001\u30b2\u30fc\u30e0\u914d\u4fe1\u3001\u306a\u3069\u5165\u529b\u3092\u6d3b\u52d5\u8005\u69d8\u304c\u884c\u3044\u30d1\u30c3\u3068\u898b\u3066\u4f55\u306e\u914d\u4fe1\u3092\u884c\u306a\u3063\u3066\u3044\u308b\u304b\u5206\u304b\u308b\u3088\u3046\u306b\u4f7f\u7528\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\u67a0\u7d44\u307f\u306e\u5834\u5408\u306f\u6a2a\u9577\u306e\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u306e\u3088\u3046\u306a\u3082\u306e\u304c\u30a4\u30e1\u30fc\u30b8\u3068\u3057\u3066\u306f\u96f0\u56f2\u6c17\u3092\u58ca\u3055\u306a\u3044\u304b\u306a\u3068\u500b\u4eba\u7684\u306b\u601d\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u30d5\u30ec\u30fc\u30e0\u3082\u304b\u308f\u3044\u3044\u3068\u601d\u3044\u307e\u3059\u3057\u3001\u305d\u3053\u3082\u732b\u30e2\u30c1\u30fc\u30d5\u3067\u3082\u304b\u308f\u3044\u3044\u304b\u306a\u3068\u601d\u3044\u307e\u3059(\u6a2a\u9577\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u306e\u4e0a\u90e8\u5206\u304c\u732b\u3061\u3083\u3093\u306e\u8033\u4ed8\u304d\u306a\u3069)\n\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u306e\u969b\u306b\u306f\u914d\u4fe1\u306e\u5185\u5bb9\u304c\u969b\u7acb\u3064\u3088\u3046\u306b\u767a\u5149\u3057\u3066\u308b\u767d\uff1f\u307f\u305f\u3044\u306a\u3001\u4f1d\u308f\u308a\u3065\u3089\u3044\u3068\u601d\u3044\u307e\u3059\u304c\u3001\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u3092\u7acb\u3061\u4e0a\u3052\u305f\u6642\u306e\u771f\u3063\u767d\u306a\u767a\u5149\u3057\u3066\u308b\u753b\u9762\u306e\u3088\u3046\u306a\u3082\u306e\u3092\u60f3\u50cf\u3057\u3066\u3044\u305f\u3060\u3051\u305f\u3089\u5e78\u3044\u3067\u3059\u3002\n\n\u30e2\u30ce\u30c8\u30fc\u30f3\u00d7\u30cd\u30aa\u30f3\u8abf\u304c\u8272\u5408\u3044\u306e\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\n\u30c4\u30a4\u30ad\u30e3\u30b9\u306e\u914d\u4fe1\u30b5\u30e0\u30cd\u30a4\u30eb\u306f\u30ab\u30e9\u30d5\u30eb\u306a\u3082\u306e\u304c\u591a\u3044\u305f\u3081\u3001\u30e2\u30ce\u30c8\u30fc\u30f3\u306b\u3057\u3064\u3064\u3082\u30cd\u30aa\u30f3\u3055\u3092\u51fa\u3059\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u76ee\u306b\u4ed8\u304f\u3053\u3068\u304c\u76ee\u7684\u3067\u3059\u3002\n\u69cb\u56f3\u306b\u95a2\u3057\u3066\u306f\u3001\u30b2\u30fc\u30df\u30f3\u30b0\u30c1\u30a7\u30a2\u306bb\u3055\u3093\u304c\u5ea7\u3063\u3066\u3044\u308b(\u4e0a\u534a\u8eab\u3001\u4f4d\u7f6e\u5e0c\u671b\u306a\u3057)\u3001\u5c11\u3057\u6c17\u6020\u305d\u3046\u306b\u7247\u624b\u306f\u80a9\u8098\u3092\u3064\u3044\u3066\u304a\u9854\u3092\u8f09\u305b\u3066\u6b32\u3057\u3044\u3067\u3059\u3002(\u982c\u6756\u3092\u3064\u3044\u3066\u3044\u308b\u30a4\u30e1\u30fc\u30b8)\n\u3082\u3046\u7247\u624b\u3067\u914d\u4fe1\u306e\u30bf\u30a4\u30c8\u30eb\u90e8\u5206\u306b\u306a\u308b\u7b87\u6240\u3092\u6307\u3055\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u30b2\u30fc\u30df\u30f3\u30b0\u30c1\u30a7\u30a2\u306b\u5ea7\u3063\u3066\u3044\u308b\u69cb\u56f3\u306a\u306e\u3067\u3001\u673a\uff1f\u30c7\u30b9\u30af\uff1f\u306e\u3088\u3046\u306a\u3082\u306e\u306b\u982c\u6756\u3092\u3064\u304d\u3001\u7247\u624b\u3067\u6307\u3055\u3057\u3092\u3057\u3066\u3044\u308b\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\n\u673a\u306e\u4e0a\u306b\u306f\u732b\u3061\u3083\u3093\u306e\u5f62\u3092\u3057\u305f\u30b3\u30c3\u30d7or\u30de\u30b0\u30ab\u30c3\u30d7\u3001\u622f\u308c\u3042\u3063\u3066\u3044\u308b2\u5339\u306e\u732b\u3061\u3083\u3093\u3001\u30b2\u30fc\u30e0\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc(\ud83c\udfae\u3053\u306e\u3088\u3046\u306a\u3082\u306e)\u3001\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\u30b2\u30fc\u30e0\u306e\u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\u306f\u7121\u9020\u4f5c\u306b\u7f6e\u304b\u308c\u3066\u3044\u308b\u611f\u3058\u3060\u3068\u306a\u304a\u30a4\u30e1\u30fc\u30b8\u306b\u8fd1\u3044\u3067\u3059\u3002\n\u732b\u3061\u3083\u3093\u306f\u30ad\u30b8\u30c8\u30e9\u3068\u3054\u672c\u4eba\u69d8\u304c\u30c0\u30fc\u30af\u306a\u30a4\u30e1\u30fc\u30b8\u306e\u30b3\u30c6\u30ad\u30e3\u306a\u305f\u3081\u3001\u30b0\u30ec\u30fc\u306e\u732b\u3061\u3083\u3093\u306e2\u5339\u3060\u3068\u52a9\u304b\u308a\u307e\u3059\u3002\n\u8868\u60c5\u306b\u95a2\u3057\u307e\u3057\u3066\u306f\u3001\u4f53\u52e2\u306f\u6c17\u3060\u308b\u305d\u3046\u3067\u3059\u304c\u3001\u30f4\u30a3\u30e9\u30f3\u306e\u3088\u3046\u306a\u5c11\u3057\u610f\u5730\u60aa\u306a\u304a\u9854\u3092\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\u306b\u3084\u3064\u3044\u3066\u3066\u3082\u69cb\u3044\u307e\u305b\u3093\u3057\u3001\u5632\u7b11\u3063\u3066\u308b\u3088\u3046\u306a\u8868\u60c5\u3067\u3082\u69cb\u3044\u307e\u305b\u3093\u3002\u3054\u672c\u4eba\u69d8\u306e\u58f0\u3068\u30ae\u30e3\u30c3\u30d7\u304c\u51fa\u305f\u3089\u5c11\u3057\u9762\u767d\u3044\u304b\u306a\u3068\u601d\u3044\u307e\u3057\u305f\u3002\n\u80cc\u666f\u306b\u95a2\u3057\u3066\u306f\u3001\u30cd\u30aa\u30f3\u8abf\u306e\u30b2\u30fc\u30df\u30f3\u30b0\u90e8\u5c4b\u306e\u3088\u3046\u306a\u30a4\u30e1\u30fc\u30b8\u304c\u30e2\u30ce\u30c8\u30fc\u30f3\u306a\u7a7a\u9593\u306b\u30ae\u30e3\u30c3\u30d7\u304c\u52a0\u308f\u3063\u3066\u826f\u3044\u304b\u306a\u3068\u8003\u3048\u3066\u3044\u307e\u3059\u3002\n\u80cc\u666f\u306e\u88c5\u98fe\u306b\u3064\u3044\u3066\u306e\u5e0c\u671b\u306f\u3042\u308a\u307e\u305b\