シークレットが自分で包皮を剥いている例です。\n\nshorturl.at/hAGO9\nshorturl.at/ghuzG\nshorturl.at/noOPZ\n\nこのリクエストを元に、好きなようにキャラクターを描いてみてください。ぜひ楽しんでください。\n\nこの依頼を受けた場合、ファンボックスとパテロンで作品を共有することができます。TwitterでシェアするのもOK!でも、FanboxとPatreonだけでシェアした方が儲かるかもしれませんね :)\n\nもし、この要望を受けられないのであれば、私は理解しています\n\n読んでくれてありがとうございます!あなたのアートワークが大好きです!", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@siretoko_panda/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 736385, "client_id": 864384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fd7ad25/uploads/origins/10d0e59e-9f47-4bcf-baf0-8633fe1b2eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609729ccfea60462c38b4fbd2c73f867", "srcset": "https://si.imgix.net/6fd7ad25/uploads/origins/10d0e59e-9f47-4bcf-baf0-8633fe1b2eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609729ccfea60462c38b4fbd2c73f867, https://si.imgix.net/6fd7ad25/uploads/origins/10d0e59e-9f47-4bcf-baf0-8633fe1b2eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bd838682d5b11c5f1faee523ef607eb 2x, https://si.imgix.net/6fd7ad25/uploads/origins/10d0e59e-9f47-4bcf-baf0-8633fe1b2eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f315f8b7f97bac826e650403860748d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fd7ad25/uploads/origins/10d0e59e-9f47-4bcf-baf0-8633fe1b2eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4705fbc1e5d5f1c836dbd99c95b0905", "srcset": "https://si.imgix.net/6fd7ad25/uploads/origins/10d0e59e-9f47-4bcf-baf0-8633fe1b2eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4705fbc1e5d5f1c836dbd99c95b0905, https://si.imgix.net/6fd7ad25/uploads/origins/10d0e59e-9f47-4bcf-baf0-8633fe1b2eb0?bg=%2