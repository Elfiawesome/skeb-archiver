に未知か禁じられた廃墟や遺跡を探索している、所謂トゥームレイダーの様な存在です。褐色肌の子(179cm)は楽天家でお喋り、髪の内側は宇宙の様に光っている。黒髪の子(185cm)は不器用でクールな性格。対照的な2人ですが、一蓮托生の仲です。\n\n【テーマ】\n・このキャラ2人をご自由に描いてください！衣装をアレンジ、簡略化しても全然構いません。カラフルで楽しい、ポップな雰囲気の一枚をお願い致します。\n・「宇宙を駆ける、冒険、太陽と月、惑星・彗星、地平線」のモチーフをどちらでもご自由に使って大丈夫です。\n・ポーズや構図は他は何でも構いませんので、お気軽に描いてください！\n\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください。ご検討のほど、何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1kLf23QyEII4-8wZi9w3GbItHC70XcIU0?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@popopo2017/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 376179, "client_id": 2855705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d8dbd54/uploads/origins/284fdb6f-b918-448b-a2ce-d85c2c2582dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a1969ef452c9c1cb11cafb285fd08c7", "srcset": "https://si.imgix.net/7d8dbd54/uploads/origins/284fdb6f-b918-448b-a2ce-d85c2c2582dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a1969ef452c9c1cb11cafb285fd08c7, https://si.imgix.net/7d8dbd54/uploads/origins/284fdb6f-b918-448b-a2ce-d85c2c2582dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f824b6757105e4c4651ba6eca1df9cd 2x, https://si.imgix.net/7d8dbd54/uploads/origins/284fdb6f-b918-448b-a2ce-d85c2c2582dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8d0925012544252fb349fc21059f66d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d8dbd54/uploads/origins/284fdb6f-b918-448b-a2ce-d85c2c2582dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2762dcc64e80bccec7bcec8518f89054", "srcset": "https://si.imgix.net/7d8dbd54/uploads/origins/284fdb6f-b918-448b-a2ce-d85c2c2582dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=