berが観れるなんてこれから楽しみです。どうでも良いですが私のYouTubeでのハンドルネームはabyssです！長々となりましたがよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_canno/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2707925, "client_id": 5864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=426193b27c2401593888bc1ba1997ca1", "srcset": "https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=426193b27c2401593888bc1ba1997ca1, https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=929158c4127431d9ff36a8752b62dd75 2x, https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cf9c58c264fdf4267d5a8d00ea0356f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b39223b028e0c62ccd2695840a66a2b4", "srcset": "https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b39223b028e0c62ccd2695840a66a2b4, https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31777a6a9c79b397d78994d70029d43f 2x, https://si.imgix.net/6b842b67/uploads/origins/89457d0f-45a8-4bbe-ac9d-e32ccfa5ef55?bg=%23fff&auto=format%2Ccompress&f