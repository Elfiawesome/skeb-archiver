c-3ae5009df125?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ca0e1a3ec0a7c93f51235bb15542446, https://si.imgix.net/0db7bc20/uploads/origins/faa4c9b1-baeb-4660-a31c-3ae5009df125?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3cd95fa102ee01a3d156f6239f0c840 2x, https://si.imgix.net/0db7bc20/uploads/origins/faa4c9b1-baeb-4660-a31c-3ae5009df125?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c93f44c3ccf5e6010a4ab84ba0975a74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0db7bc20/uploads/origins/faa4c9b1-baeb-4660-a31c-3ae5009df125?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89519f2cf4a35115b4ef16f46065da46", "srcset": "https://si.imgix.net/0db7bc20/uploads/origins/faa4c9b1-baeb-4660-a31c-3ae5009df125?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89519f2cf4a35115b4ef16f46065da46, https://si.imgix.net/0db7bc20/uploads/origins/faa4c9b1-baeb-4660-a31c-3ae5009df125?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee9c1077294010cb22b60ab6ecaad4fb 2x, https://si.imgix.net/0db7bc20/uploads/origins/faa4c9b1-baeb-4660-a31c-3ae5009df125?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e09d953e8a2612c9d2fc6afd711700a 3x"}, "body": "はじめまして。\n村口様の作品が好きで、ぜひ私の創作キャラで漫画を描いていただきたくリクエストいたしました。\n\n\n▼アルジャノン：攻　愛称：アル\n１８５cm。細身。２４歳。イメージカラーは赤。\n英国人男性。赤を基調とした優美・派手な服装。悪の組織の元幹部。欲望に忠実で退屈を嫌い刺激を求めて生きる。常に仮面を付けており道化じみた振舞いをする。足が長くスタイルが良い。左目には星形の痣。瞳は金色でやや釣り目気味。\n\n・口調例\n一人称：ワタシ\n二人称：アナタ\n遠回しな言い方を好み、常に敬語で話す。『簡単過ぎては退屈でしょう？』『ふふ、嫌いではありません。』\n\n\n▽飛龍（フェイロン）：受\n１７９cm。細身。３０歳。イメージカラーは青、黒。\n中国人男性。青や黒、金を基調としたシンプルでありながら美しい服装。中華マフィアの幹部。美しい顔立ちとは裏腹に冷徹。体術や拳法において右に出る者はいない。艶っぽい目元、左目の下には泣きぼくろ。瞳は黒色。完攻だったが、アルに対してのみ受ポジションである。\n\n・口調例\n一人称：俺\n二人称：お前\n荒々しい言葉遣いではないが、特に丁寧というわけでもない。自信がありそうな口調。『いいんじゃないか？』『ふ、悪くないな。』\n\n参考URLを添付いたします。\n\n\n■関係性・雰囲気\n関係性は恋人同士。アルも飛龍も属性で言えば悪であるが、互いに対しては信じており裏切ることはない。\n地獄でもどこでも二人なら生きていけるが、地獄に落ちようとは微塵も思っていない。落ちるくらいなら他人を蹴落とし、周囲よりも自分と相手を優先する。そういった傲慢さや我儘な部分を互いに気に入っている。\n\n■シチュエーション\n好き勝手に生きる二人が、最終的に愛おしそうにキスする姿がみたいです。\nキスするシーンではアルの仮面は外してほしいです・・・！\nその他の事柄についてはおまかせとさせていただきたいです！\n\nお忙しいとは思いますが、ご検討いただけると幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1FWUWwSpj4_IfWHLA04qtQaxBkNthCwh0?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 26348, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "𝑹𝒊𝒐𝒔𝒉𝒊𝒎𝒂🦩", "screen_name": "rosm__ayk", "avatar_url": "https://pbs.twimg.com/profile_images/1833727772445065216/sLZsVq7c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2472749880/1726057847/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2047323, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "まるの🖋️", "screen_name": "SuketoHanaHana", "avatar_url": "https://pbs.twimg.com/profile_images/1705750932863262720/m-hxxCpu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1115364616127766528/1762316633/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2282731, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "亞桃", "screen_name": "ATO_Jiva_", "avatar_url": "https://pbs.twimg.com/profile_images/1980970886887813120/ieG3aRFg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1480827198785605632/1730569576/1500x500", "appeal_receivable"