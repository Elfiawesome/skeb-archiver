e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2af2cdd865e56d06bb2d6be248403081", "srcset": "https://si.imgix.net/ad44fb45/uploads/origins/bd5c3b2c-1cb7-4ef0-8400-eb1b08e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2af2cdd865e56d06bb2d6be248403081, https://si.imgix.net/ad44fb45/uploads/origins/bd5c3b2c-1cb7-4ef0-8400-eb1b08e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddf1a1f0636ff1655ad47a5487e00897 2x, https://si.imgix.net/ad44fb45/uploads/origins/bd5c3b2c-1cb7-4ef0-8400-eb1b08e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=228e8b572034c767952fd0d5d6574b25 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad44fb45/uploads/origins/bd5c3b2c-1cb7-4ef0-8400-eb1b08e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=141c8d3315551e5f177c45fe8e975a16", "srcset": "https://si.imgix.net/ad44fb45/uploads/origins/bd5c3b2c-1cb7-4ef0-8400-eb1b08e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=141c8d3315551e5f177c45fe8e975a16, https://si.imgix.net/ad44fb45/uploads/origins/bd5c3b2c-1cb7-4ef0-8400-eb1b08e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a7f13b7d57c7e46e7501c4426342e87 2x, https://si.imgix.net/ad44fb45/uploads/origins/bd5c3b2c-1cb7-4ef0-8400-eb1b08e694f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1ec8f78e36b1293d4623299e0fc9b78 3x"}, "body": "御世話になります。ホムラが陰毛を先生にチラ見せするイラストを拝見しました。自分も一つ思い浮かんだので、申し込みたいと思います。\n\nホムラが教師にクロロホルムを嗅がされ眠らされるシーンをお願い致します。\n・基本表情に「驚き」差分に「もがき」「目がとろーん」「薬が効き目の焦点が合わない」「目を閉じ気絶」「ハンカチ無しで寝顔が見える」\n・教師は一部分やシルエットでも大丈夫です。背景もこだわりません。\n・全裸で陰毛有りでお願いします。モズパチョさんの好きな陰毛の量や長さで構いません。\n・教師に抱きしめられる感じで眠らされます。\n・ハンカチを持った片手は鼻口をしっかり覆っており、もう片手でホムラのおっぱいを揉んでいる感じです。\n・台詞有無もよろしければお願いいたします。\n・物語の背景としては、おまんまんを見せつけているイラストの後の話で、教師が放課後、理科室にホムラを呼び出し、暗幕カーテンを引き、鍵を閉めて2人きり。\nホムラが全裸になり、教師を誘惑して迫ります･･･しかしホムラに誤算が。\nおまんまんを見せつけられた事によって、欲望を抑えきれなくなった教師は自分が持っていた（理科教師故に）クロロホルムでホムラを眠らせ、Hするつもりで最初から自分のテリトリーである理科室に呼び出していたのです。\nまんまと教師の罠にはまったホムラ（教師のことは実は好きだが、こんな方法を使ってくるのは予想していなかったので驚く）。抵抗するも、次第に薬に心を開いていき、教師の腕の中で穏やかな寝顔を見せる･･･\nといった感じです。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MozukaiWalifu/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/368be45b/uploads/origins/5e527aa3-5a09-4b4a-8014-328357b6a979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea85585475693d9fe275c868d2e83adf", "srcset": "https://si.imgix.net/368be45b/uploads/origins/5e527aa3-5a09-4b4a-8014-328357b6a979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea85585475693d9fe275c868d2e83adf, https://si.imgix.net/368be45b/uploads/origins/5e527aa3-5a09-4b4a-8014-328357b6a979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a97f484c421b8d47a1f6c72c5f42a3ab 2x, https://si.imgix.net/368be45b/uploads/origins/5e527aa3-5a09-4b4a-8014-328357b6a979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0e0e39414d3d96d8276d7968bacf8f7 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2052185, "client_id": 635387, "nc": 49}, {"path": "/@MozukaiWalifu/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cff065c7/uploads/origins/5c80a3d4-d71e-4217-9f85-1a7f817c12ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont