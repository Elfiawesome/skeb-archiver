す。頭には触角があり、背中には虫の羽が生えていることにご注目ください。目もオレンジ色に光っている。\n\nhttps://geeckek.notion.site/Linxiu-2d01d0143d0780faab83f3019ff5e97a", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yugure_a/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2281095, "client_id": 2742181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523a3ce10bf31ce26b9c96a903b69609", "srcset": "https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=523a3ce10bf31ce26b9c96a903b69609, https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1895df45b2a4b09a8632ac406b0692ba 2x, https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a972b5bd3f4dd63e2ccc7e2a5bd3517 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e1d94a693877f5b74c00d035b75532", "srcset": "https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69e1d94a693877f5b74c00d035b75532, https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426-4c070f417a3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a36bcc64bccf16a195aefc315c08f34 2x, https://si.imgix.net/f3f0e921/uploads/origins/129020f3-a25f-4e87-b426