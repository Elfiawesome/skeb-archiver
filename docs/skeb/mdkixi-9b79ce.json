42df7-fa28-4ba6-ac27-c83a42b7e219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7259a3f1c7e122dd2498a61ac5fafca2, https://si.imgix.net/9c399bd7/uploads/origins/c2042df7-fa28-4ba6-ac27-c83a42b7e219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06cd9cd3dae2db12223d6818d5c642f6 2x, https://si.imgix.net/9c399bd7/uploads/origins/c2042df7-fa28-4ba6-ac27-c83a42b7e219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d11485cb5ea0d58c7d0f378e27d6e08f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c399bd7/uploads/origins/c2042df7-fa28-4ba6-ac27-c83a42b7e219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c29af399e3d40dd1395347e25c09949b", "srcset": "https://si.imgix.net/9c399bd7/uploads/origins/c2042df7-fa28-4ba6-ac27-c83a42b7e219?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c29af399e3d40dd1395347e25c09949b, https://si.imgix.net/9c399bd7/uploads/origins/c2042df7-fa28-4ba6-ac27-c83a42b7e219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7691c06887a928a98248622cbfe7f31 2x, https://si.imgix.net/9c399bd7/uploads/origins/c2042df7-fa28-4ba6-ac27-c83a42b7e219?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=feae479eda5468d44d4aa8180e15c332 3x"}, "body": "こんにちは。いつもお世話になっております。\n\n今回、思い切ってリクエストすることにしました。Skebでのリクエストに不慣れなので、ご迷惑をおかけしてしまわないように気を付けます。\n\n【人物】\n私にはシンとヒロという同性愛の恋人同士のオリキャラが居ます。私の落書きよりも、友人が描いた絵の方が参考になるかと思いますので、こちらも合わせてリンクとして貼らせていただきます。\n\nリンク①/私作\nhttps://x.com/nrcprefect1a09/status/1708845803626979512?s=20\n\nリンク②/友人作\nhttps://x.com/nrcprefect1a09/status/1708846365374308810?s=20\n\n【シナリオ】\nシンが運動後(主に踊りの練習や筋トレ)に汗をかいているにも関わらず、ヒロと寄り添って抱きしめ合っている絵をお願いしたいです。通常恋人同士では抱き合わない状況かもしれませんが、ヒロはシンの汗や匂いも含めてシンのことが好きなので、この2人にとっては通常運転のワンシーンです。抱きしめ合っている時の体勢や表情はお任せします。\n\n【服装】\nヒロの服装はお任せします。お気に入りの服はリンク②でも着ている青い襟付きのシャツと赤い長袖のアンダーシャツですが、特に指定はありません。シンは運動用のスリーブレスの服を着ているかと思います。ちなみにですが、シンはアスリート系のムチっとした体系で、腹筋は割れていません。\n\nこんな感じで大丈夫でしょうか？少々変わったシチュなのは十分承知の上ですが、「確認事項」は全て了承しています！\n\nいつもユウくんを初め、mdkさんの世界観をとても楽しませてもらっています。今回はこのような機会を頂けてとても嬉しいです。ありがとうございます！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mdkixi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2477209, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74fc0df5/uploads/origins/77d691c2-0fbf-4ad8-bad5-a74d0349bd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb1c46d703ccf1125bb0d7535796d51", "srcset": "https://si.imgix.net/74fc0df5/uploads/origins/77d691c2-0fbf-4ad8-bad5-a74d0349bd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb1c46d703ccf1125bb0d7535796d51, https://si.imgix.net/74fc0df5/uploads/origins/77d691c2-0fbf-4ad8-bad5-a74d0349bd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85b0bff69e4a21f509c4d7870c315b23 2x, https://si.imgix.net/74fc0df5/uploads/origins/77d691c2-0fbf-4ad8-bad5-a74d0349bd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5687037e6505f121829f5683e820aff4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74fc0df5/uploads/origins/77d691c2-0fbf-4ad8-bad5-a74d0349bd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f40258e8a55b0f4d925234ee8e51bb6", "srcset": "https://si.imgix.net/74fc0df5/uploads/origins/77d691c2-0fbf-4ad8-bad5-a74d0349bd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f40258e8a55b0f4d925234ee8e51bb6, https://si.imgix.net/74fc0df5/uploads/origins/77d691c2-0fbf-4ad8-bad5-a74d0349bd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu