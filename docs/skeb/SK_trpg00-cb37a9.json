なる。これらの要素はオプションです。\n\n特に要望はないので、自由に描いてください。ほろ苦さや暗さを感じられるような絵になるといいと思います!\n\nまた、服装の修正もご自由にどうぞ。\nあまりに難しい依頼であれば、キャンセルしてください。\nありがとうございました。\n\nhttps://sta.sh/2sdq3mwecr6", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SK_trpg00/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2051183, "client_id": 604884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0184a161/uploads/origins/8ab618a2-d550-45dd-abea-7dd01e772494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4aa0e4149b9e5af5304b75e4fa3f312", "srcset": "https://si.imgix.net/0184a161/uploads/origins/8ab618a2-d550-45dd-abea-7dd01e772494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4aa0e4149b9e5af5304b75e4fa3f312, https://si.imgix.net/0184a161/uploads/origins/8ab618a2-d550-45dd-abea-7dd01e772494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20b474bb7e1bee6b2e9ee111f3bcb357 2x, https://si.imgix.net/0184a161/uploads/origins/8ab618a2-d550-45dd-abea-7dd01e772494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f728feab07b02feddf825bbf815620d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0184a161/uploads/origins/8ab618a2-d550-45dd-abea-7dd01e772494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4276d249c7aeb454e08eccd75d586460", "srcset": "https://si.imgix.net/0184a161/uploads/origins/8ab618a2-d550-45dd-abea-7dd01e772494?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4276d249c7aeb454e08eccd75d586460, https://si.imgix.net/0184a161/uploads/origins/8ab618a2-d550-45dd-abea-7dd01e772494?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c5f1a89c1a41ab8c31638bec6f5a8a2 2x, https://si.imgix.net/018