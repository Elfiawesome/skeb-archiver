b2-28f9c0456188?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45f293b129bb43f388698e037165e869, https://si.imgix.net/c678f1fa/uploads/origins/c0b9c0fc-73f5-462a-87b2-28f9c0456188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=60103318ba91b65932c7a4c77d7ba6d7 2x, https://si.imgix.net/c678f1fa/uploads/origins/c0b9c0fc-73f5-462a-87b2-28f9c0456188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4591a3230bd194a66bff418f8d0216ed 3x"}, "body": "ぺんた先生、こんにちは。\nSkebで先生の作品を拝見し、画風がとても素敵で惹かれました。ぜひ私のOCのイラストをお願いしたく、リクエストをお送りいたしました。どうぞよろしくお願いいたします。\n\nキャラクター設定は、フォルダ内の「Hisashi.jpg」をご参照ください。\n20代後半くらいのエンジニアという設定ですが、少し若めに描いていただいても問題ありません。\n宇宙へ行く夢を持っており、仲間たちと共に宇宙船を建造した。という背景のキャラクターです。\n性格は比較的社交的ですが、大人らしい落ち着きも持っています。\n\nもし可能であれば、土星 / 紙とペン / 白い花などのモチーフを取り入れていただけると嬉しいです。\n花については、別画像の赤髪の女の子の目にある花をご参考いただければ幸いです。\n\n【使用目的】\n完全に非商用、個人使用のみです。\nSNSのアイコンやヘッダーなどに使用させていただく可能性があります。\nまた、ポストカード等のグッズを個人的に印刷し、無償で友人（10人以内）に配布することがあるかもしれません。\n\nここまで読んでくださりありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Nxa5hVbJ41MQCHxmynNEDY1L5KvOzG4V?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pnt_no_skeb/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2c3443f2/uploads/origins/a145d3a6-277a-445b-b78e-b9fb2437c7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39ec56c7e6de63814ac75bb5be4c4ad7", "srcset": "https://si.imgix.net/2c3443f2/uploads/origins/a145d3a6-277a-445b-b78e-b9fb2437c7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39ec56c7e6de63814ac75bb5be4c4ad7, https://si.imgix.net/2c3443f2/uploads/origins/a145d3a6-277a-445b-b78e-b9fb2437c7ad?bg=%23fff&auto=format%2