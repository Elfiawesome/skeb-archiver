学生ぐらいの時に身長を抜かされ、ややショックを受けてます。\nあと勉強が苦手で、よく左の子に助けてもらってます。\n困ってる人に手を差し伸べられる、人に好かれるタイプです。\n好きな食べ物は甘いもの、オムライス、ハンバーグなど子供っぽいものが好きです。\n\n・2人は幼馴染で大親友です。お互い支えあって生きてきました！\n高校生ですので学ランを着用していますが、どの様な服でも構いません！\nもし女装や可愛らしい服装の場合は、右の子は恥ずかしがっていると嬉しいです！\n\n【使用用途】\n・スマホやタブレットの壁紙\n・SNS（X）での掲載\n・SNS（X）のアイコン、ヘッダー\n\n【その他】\n可能であれば、署名や背景はレイヤー分けして納品していただけると幸いです！\n資料に不備や、金額が依頼に見合わない場合はお気軽にキャンセルや再送をお願いいたします。\n\nお忙しいとは思いますが、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/148R9LNgrnhJFMrVg9u111Tgd34ESN-V0?usp=sharing", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cu_uv_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3809417, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c94dbe94/uploads/origins/e848af53-0ee5-49f9-b83c-effcd136e8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a951570422cba6873a2ebd49eb3fd9bd", "srcset": "https://si.imgix.net/c94dbe94/uploads/origins/e848af53-0ee5-49f9-b83c-effcd136e8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a951570422cba6873a2ebd49eb3fd9bd, https://si.imgix.net/c94dbe94/uploads/origins/e848af53-0ee5-49f9-b83c-effcd136e8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbb0bbf58ff68375a1cc1a643899b660 2x, https://si.imgix.net/c94dbe94/uploads/origins/e848af53-0ee5-49f9-b83c-effcd136e8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83b17cd8021269938334823865d6d66d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c94dbe94/uploads/origins/e848af53-0ee5-49f9-b83c-effcd136e8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50d6f6064c2e1a52c2bdabfd7574c505", "srcset": "https://si.imgix.net/c94dbe94/uploads/origins/e848af53-0ee5-49f9-b83c-effcd136e8cc?bg=%23fff&auto=format%2Ccompress&