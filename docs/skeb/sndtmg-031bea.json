f3396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9248299bb0ef79b3ff916ed535b25319 2x, https://si.imgix.net/bd98c876/uploads/origins/11fa090f-2aec-45c9-b897-a3c92eff3396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=073b587a42a2588067604c4dae3ee1a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd98c876/uploads/origins/11fa090f-2aec-45c9-b897-a3c92eff3396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8004cdaf3b7bbd0d273b233d9d282296", "srcset": "https://si.imgix.net/bd98c876/uploads/origins/11fa090f-2aec-45c9-b897-a3c92eff3396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8004cdaf3b7bbd0d273b233d9d282296, https://si.imgix.net/bd98c876/uploads/origins/11fa090f-2aec-45c9-b897-a3c92eff3396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd13d9e8a7bdf2c7e171d702ae0d4128 2x, https://si.imgix.net/bd98c876/uploads/origins/11fa090f-2aec-45c9-b897-a3c92eff3396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e4ec1d7e3738a43d622d0bffdb978298 3x"}, "body": "うめまつさま、初めましてこんばんは！\n\nいつも素敵なシナリオをありがとうございます！\nATHENAを通過してからずっとこのシナリオのことを抱きしめています。\nTHESEUSから少年漫画の熱い展開と戦闘、本当に大好きです！\n\nこの度うめまつさんにお願いしたいと思っているのは\nATHENA HO1と飛鳥理王の2人です。\nTHESEUSの最後に飛鳥理王にも手を伸ばしてそれでも助けたいと言ったのですが\n最後には燃えてしまい助けられませんでした。\nそれぞれの正義がぶつかり合って自分が勝ちましたがどこか助けられなかったことがずっと引っかかっていて度々思い返すほどでした。\nATHENA全生還した時に飛鳥理王もどこかで生きていて世界を見て回ると聞いた時本当に嬉しくなりました。\nどこかでまた巡り合いたいという思いがあります。\n\nなのでもしよろしければATHENA後に出会う2人が見てみたいです。\n難しいリクエストかと思いますがご検討いただければ幸いです。\nよろしくお願いします。\n\n▶︎テセウス第一部隊リーダー\nCS：https://iachara.com/view/11843764\n名前：紅石 電気\n184cm/赤髪紫目/切れ目/サングラス着用/~だろ、〜じゃねぇか？口調/戦闘は素手/\n大雑把で破天荒、高いところと喧嘩が好き。脳筋。ATHENAの時は指揮が下がるという理由で自身のことを最後まで言わなかったしひかるとの話合いでも2人とも言わないでおこうとなり肩を組んでみんなの所に戻ってきた。\n最近髪を切りましたがうめまつさんの描きやすい方で調整していただければと思います！\nどうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Ejwd2x7pU3PunC3uWvD9nFuKy60BUiuR?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KRR_4649/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 2696299, "client_id": 319807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dc9490794892bdb4099e2f4d00f9178c", "srcset": "https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=dc9490794892bdb4099e2f4d00f9178c, https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=020ed8eed0c1d7dfa7f146260398278b 2x, https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2bd87871b9b4c665bed7080441edef0 3x"}, "duration": 4, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=df11c80c01d8a6eabb374bdac589bb31", "srcset": "https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=df11c80c01d8a6eabb374bdac589bb31, https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f58f1c93984a884d847786f7802d6ab3 2x, https://si.imgix.net/6c2548b0/uploads/outputs/ed656c8c-eefd-4473-8ade-8492b904236f?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=784da68211896ef60a4ce0