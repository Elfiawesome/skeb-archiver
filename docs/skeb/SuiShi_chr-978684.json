%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7511efbdbbd70bd439528f872dd7fd2f", "srcset": "https://si.imgix.net/0fc2c0dd/uploads/origins/5bcbe564-a831-4fd9-803e-cfd40d527ea5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7511efbdbbd70bd439528f872dd7fd2f, https://si.imgix.net/0fc2c0dd/uploads/origins/5bcbe564-a831-4fd9-803e-cfd40d527ea5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72f74605dfee7d846834e3c6d1a2ba58 2x, https://si.imgix.net/0fc2c0dd/uploads/origins/5bcbe564-a831-4fd9-803e-cfd40d527ea5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=257eb8c2ef83012c78f199467a183dfb 3x"}, "body": "Hello.\n久々にリクエストしに来ました。\nタイトルは「ヴァンパイア部員に狙われたモニカ」\n\n部員達の立ち位置は モニカが真ん中、サヨリはモニカの後ろ、左はナツキ、右はユリ。\n全身ではなく、上半身のみですね。\n\n一枚目が\n全員はカメラ目線でモニカさんがプレイヤーに助けを求めて口を開け、サヨリちゃんは後ろからモニカの頸動脈(首）を噛み、ナツキは鎖骨下動脈(鎖骨) そして最後ユリは橈骨動脈(左手)\n当然 新鮮なブラッドが流れてる描写がありです :3\n\n二枚目が部員 全員 前に向かって笑顔をしてて、ナツキとユリは人差し指でモニカの口を無理やりスマイルをさせるのとモニカさんは目の光が失ってて、涙を流すというイラストを描いてほしいなぁ～\n*R17.9というとブラッドの描写とモニカさんの服が胸元をはだけるって感じだぜ。\n\n内容は以上です。よろしくお願いします ('ω')ノ", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SuiShi_chr/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2205986, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44e41b5f/uploads/origins/788ff820-8dd4-4335-8dfb-a3f08c4f371d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42171ebff27ea4d52eb98d81ab0b7cf7", "srcset": "https://si.imgix.net/44e41b5f/uploads/origins/788ff820-8dd4-4335-8dfb-a3f08c4f371d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42171ebff27ea4d52eb98d81ab0b7cf7, https://si.imgix.net/44e41b5f/uploads/origins/788ff820-8dd4-4335-8dfb-a3f08c4f371d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6034661196de1ac7c9114d