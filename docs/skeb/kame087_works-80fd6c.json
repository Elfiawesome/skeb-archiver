=1cb6d6ae4cbdc597da689a2f3d1a5b8f", "srcset": "https://si.imgix.net/b18dcc57/uploads/origins/37587cc9-5eca-4f1d-8baa-d5e4420b4894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cb6d6ae4cbdc597da689a2f3d1a5b8f, https://si.imgix.net/b18dcc57/uploads/origins/37587cc9-5eca-4f1d-8baa-d5e4420b4894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4090ffc176fe39211796ad4411641238 2x, https://si.imgix.net/b18dcc57/uploads/origins/37587cc9-5eca-4f1d-8baa-d5e4420b4894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ef34f38bf1db0edd0d7ac4599bb4125 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b18dcc57/uploads/origins/37587cc9-5eca-4f1d-8baa-d5e4420b4894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f7ebebb84f0c38d38c979cab8437c05", "srcset": "https://si.imgix.net/b18dcc57/uploads/origins/37587cc9-5eca-4f1d-8baa-d5e4420b4894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f7ebebb84f0c38d38c979cab8437c05, https://si.imgix.net/b18dcc57/uploads/origins/37587cc9-5eca-4f1d-8baa-d5e4420b4894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01238785252a5637fbe33272b9b770d5 2x, https://si.imgix.net/b18dcc57/uploads/origins/37587cc9-5eca-4f1d-8baa-d5e4420b4894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c79c9e71e6c0c09b1cc27759bd37f13c 3x"}, "body": "ほぼキャラデザになってしまったり、変則的な二次創作であったり、もろもろ大変かもなので、もし良ければ\n使用用途的にはまがつ国の世界観をお借りして二次創作小説っぽいものを作りたいなと思ってその登場人物に予定してる子です\n球磨楠うつし\n年齢:13歳\n出身:まがつ国の家具問屋\n趣味:自分で写生した絵を不思議なテイストに描き増すこと\nチャームポイント\n･右側に1本生えた角(反対側をサイドテール等にしないとバランスが悪くてよく転ぶ)\n･櫛のように挿してるハサミ(悪代屋のまじない道具)\n『 まじない･雑貨の悪代屋』の常連客\n思い立ったらどこでもすぐに紙とペンを広げるがそそっかしいため、よく筆記具を無くしていた。たまたま家具の仕入れに来た悪代屋の店主に懐いて店を訪ねたところ、オシャレな筆記具の数々に心を奪われる。以降足しげく店をおとずれてお小遣いの多くを悪代屋の雑貨に使うことになった。筆記具を無くすことはなくなったようだ\n\n髪に挿しているハサミは刃の部分がナマクラな代わりに溝が刻んであって、開閉させると澄んだ音叉のような音が鳴る。寝起きに聴くと眠気が払われるように無くなる。\nこれはハサミの柄に埋め込まれている黒翡翠に宿る獏によるもの。偏食家のこの獏は二度寝の極上の夢心地が好物でこれしか食べられない。ハサミを鳴らして合図すると眠気ごと食べてくれる\n生まれた時から寝起きが悪く遅刻の常習犯だったうつしの夢をとても気に入っているようだ\n\n片思いの男の子と接点が無いという悩みを相談した時に悪代屋店主から勧められた物。男の子はとても早起きで朝から1人で部活動に打ち込んでいるという事と通学路が重なっている事を聞いて、それならあなたも早く起きれれば解決ね。と渡された\nもっとさっくり運命的に引き合わされるような物があるのではと思いつつ受け取ったものの、実際仲は接近していて、休日はお互いの趣味の兼ね合いでよくフィールドワークに出るようになった\n\n以上こんな感じです。駄文長々と書き連ねてしまいましたがイメージ湧いたら幸いです\n絵自体はバストアップでもなんでもだいじょうぶです。よろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 44571, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "まさぺこ", "screen_name": "masapeko33", "avatar_url": "https://pbs.twimg.com/profile_images/1962118609490329600/yRW2lArV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2479236206/1770779976/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 702339, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ガウス＜ぼかし@お仕事募集中5月頃から", "screen_name": "gausebokashi", "avatar_url": "https://pbs.twimg.com/profile_images/1511689677497319427/rdSuGZUb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/229033115/1649249916/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 177}, {"id": 2858065, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "M10", "screen_name": "lycos_zzz", "avatar_url": "https://pbs.twimg.com/profile_images/