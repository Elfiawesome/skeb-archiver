！(ハグなどの距離感が近めの描写があるととても嬉しいです😣)\n服装やヘアスタイルの変更も大歓迎です！\n\n柊真しぎ先生の好みに合うと嬉しいです！\nお忙しいところ恐縮ですが、ご検討よろしくお願いいたします🌸\n\n物語の方も今からちょうど山場ということで更新がとても楽しみです！\nこれからも応援してます！！！\n\nhttps://drive.google.com/drive/folders/1cPlz_WE1etTyv7VwopGkFLwUCchiAIH0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 223287, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Youki", "screen_name": "youki_gdn", "avatar_url": "https://pbs.twimg.com/profile_images/1992177784928768000/CjRMej_1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1038028969243627520/1766118898/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 866772, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しお大福🧂", "screen_name": "sio_anko2", "avatar_url": "https://pbs.twimg.com/profile_images/1867571173472841728/ZgMQRO8p.jpg", "header_url": "https://pbs.twimg.com/profile_banners/854705023271358466/1769681405/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 59, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1415316, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "九重", "screen_name": "kokonoe826", "avatar_url": "https://pbs.twimg.com/profile_images/1834544121056518144/SjE-g13a.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1298538551609499649/1729083272/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by":