いたします。\n\nまた、キャラクターと背景をレイヤー分けしたファイル、またはキャラクター単体の透過pngを頂戴できると助かります。\n提示予算に余裕があるようでしたら表情差分もお作りいただけると大変喜びます。\n\n参考画像として、三面図や衣装詳細が載ったキャラクターシートを提供いたします。\n以下Google driveよりご確認ください。\nhttps://drive.google.com/file/d/1DHgi12JNLhPfb-FDHAae2IAYw-JarziL/view?usp=drive_link\n衣装は白いジャケットなしの方でお願いします。\n\n依頼内容は以上です。\nお忙しいところ恐れ入りますが、ご検討のほど何卒よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 78890, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "名取なと💭@2/22 COMITIA155【R50a】", "screen_name": "___na__10", "avatar_url": "https://pbs.twimg.com/profile_images/1657030971386916870/tsYICuA1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1006178293270249472/1678359880/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 157254, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おはな❄️", "screen_name": "tarao38_sannma", "avatar_url": "https://pbs.twimg.com/profile_images/1945372690912575488/uQbwOFvd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/853198409150283780/1759300185/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1235017, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "モイジ", "screen_name": "moimoiji", "avatar_url": "https://pbs.twimg.com/profile_images/1968053385195819008/wn6HkF34.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1830575754360561664/1736231914/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "