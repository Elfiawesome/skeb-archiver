063\u305f\u305f\u3081\u3088\u308d\u3057\u3051\u308c\u3070\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3044\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\u4eca\u56de\u3001\u79c1\u306e\u30aa\u30ea\u30b8\u30ca\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u5206\u304b\u308a\u306b\u304f\u3044\u3068\u3053\u308d\u3084\u9762\u5012\u306a\u3068\u3053\u308d\u306f\u81ea\u7531\u306b\u7c21\u7565\u5316\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\n\n\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\n\n\u258f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\n\u30fb136cm\u30011871\u6b73\u306e\u7121\u6027\u5225\u3002(\u898b\u305f\u76ee\u306f\u82e5\u304f\u898b\u3048\u307e\u3059\u3002)\n\u30fb\u3088\u304f\u8a00\u3048\u3070\u30d5\u30ec\u30f3\u30c9\u30ea\u30fc\u3001\u60aa\u304f\u8a00\u3048\u3070\u99b4\u308c\u99b4\u308c\u3057\u3044\u3002 \u5927\u80c6\u3067\u5fc3\u306e\u5185\u3092\u4eba\u306b\u5bdf\u3055\u305b\u306a\u3044\u30df\u30b9\u30c6\u30ea\u30a2\u30b9\u306a\u4eba\u7269\u3002\u7a00\u306b\u8a00\u52d5\u304c\u304a\u3058\u3055\u3093\u304f\u3055\u3044\u3067\u3059\u3002\n\u30fb\u5e38\u306b\u5fae\u7b11\u3093\u3067\u3044\u307e\u3059\u3002\u611f\u60c5\u306e\u8d77\u4f0f\u304c\u5206\u304b\u308a\u305a\u3089\u304f\u3001\u4f55\u8003\u3048\u3066\u308b\u304b\u3088\u304f\u5206\u304b\u3089\u306a\u3044\u9854\u3002\n\u30fb\u597d\u304d\u306a\u3082\u306e\u306f\u4eba\u3084\u97f3\u697d\u3084\u304a\u8336\u4f1a\u3001\u30dc\u30fc\u30c9\u30b2\u30fc\u30e0\u306a\u3069(\u4e3b\u306b\u4eba\u3068\u95a2\u308f\u308b\u3053\u3068\u304c\u597d\u304d\u3067\u3059)\u3002\u5acc\u3044\u306a\u3082\u306e\u306f\u7279\u306b\u306a\u3057\u3002\n\u30fb\u30e2\u30c1\u30fc\u30d5\u3084\u95a2\u9023\u5c0f\u7269\u306f\u8594\u8587\u3001\u672c\u3084\u66f8\u7269\u3001\u30c8\u30e9\u30f3\u30af\u3001\u7d05\u8336\u306a\u3069\u2026\n\n\u258f\u69cb\u56f3\u306a\u306