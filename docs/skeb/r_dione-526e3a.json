n\n大変お手数おかけいたしますが、ご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11fWlydAP8WKrXop-myz63aIBLA_ZRNJE?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@r_dione/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 252114, "client_id": 2731728, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2e-443b-9a97-8c2b96aef970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b47c87073784e9abd72984d28530ae16", "srcset": "https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2e-443b-9a97-8c2b96aef970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b47c87073784e9abd72984d28530ae16, https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2e-443b-9a97-8c2b96aef970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6fcb880d2ed34390a44695a4bccbf88 2x, https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2e-443b-9a97-8c2b96aef970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72f5d4eebdc2a6182483774bd0bd6fc1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2e-443b-9a97-8c2b96aef970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d09651d902bcc852fbf5501fb7189c3", "srcset": "https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2e-443b-9a97-8c2b96aef970?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d09651d902bcc852fbf5501fb7189c3, https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2e-443b-9a97-8c2b96aef970?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=407f8bd242419e32abd24dbc9c2a3979 2x, https://si.imgix.net/5b94b56d/uploads/origins/3d96f13b-1f2