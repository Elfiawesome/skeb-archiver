5a18\u00d7\u30c9\u30e9\u30af\u30a8\u306e\u30b3\u30e9\u30dc\u6f2b\u753b\u3068\u3057\u3066\u3001\u81ea\u5275\u4f5c\u30ab\u30d7\u306e\u300eJ2\u4e3b\u30a2\u30a4\u300f\u306e\u6f2b\u753b\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\uff01(\u767b\u5834\u4eba\u7269\u3001\u5e0c\u671b\u306e\u3042\u3089\u3059\u3058\u3092\u304a\u4f1d\u3048\u3057\u307e\u3059\uff01)\n\n\u2460\u767b\u5834\u4eba\u7269\n\u2488\u4e3b\u4eba\u516c(\u30c9\u30e9\u30af\u30a8\u30b8\u30e7\u30fc\u30ab\u30fc2)\n\u30fb\u540d\u524d\u2026JOKER\n\u30fb\u670d\u88c5\u2192\u539f\u4f5c\u901a\u308a\n\u30fb\u30a2\u30fc\u30e2\u30f3\u30c9\u30a2\u30a4\u62c5\u5f53\u30c8\u30ec\u30fc\u30ca\u30fc\n\u30fb\u5973\u306e\u5b50\u6163\u308c\u3057\u3066\u306a\u3044\u6027\u683c\n\u30fb\u5927\u5b66\u306e\u6570\u5b66\u304c\u5f97\u610f\u3002\n\u30fb\u30a2\u30fc\u30e2\u30f3\u30c9\u30a2\u30a4\u306b\u597d\u610f\u3092\u6301\u3064\n\n2.\u30a2\u30fc\u30e2\u30f3\u30c9\u30a2\u30a4(\u30a6\u30de\u5a18)\n\u30fb\u670d\u88c5\u21921.\u306e\u4e3b\u4eba\u516c\u306e\u53cc\u5b50\u30b3\u30fc\u30c7\n\u30fb\u30c8\u30ec\u30fc\u30ca\u30fc\u306e\u4e3b\u4eba\u516c\u306b\u597d\u610f\u3092\u6301\u3064\n\n3.\u30d9\u30ed\u30cb\u30ab(\u30c9\u30e9\u30af\u30a811)\n\u30fb\u670d\u88c5\u2192\u539f\u4f5c\u901a\u308a\n\u30fb\u3053\u3053\u3067\u306f1.\u306e\u4e3b\u4eba\u516c\u306e\u5148\u8f29\u30c8\u30ec\u30fc\u30ca\u30fc\u8a2d\u5b9a\n\n\u2461\u3042\u3089\u3059\u3058\n1.\u3042\u308b\u65e5\u3001\u4e3b\u4eba\u516c\u3068\u30a2\u30fc\u30e2\u30f3\u30c9\u30a2\u30a4\u306f\u304a\u51fa\u304b\u3051\u65e5\u548c\u3067\u30d9\u30f3\u30c1\u306b\u5ea7\u3063\u3066\u4f11\u61a9\u3057\u3066\u305f\u3089\u3001\u30d9\u30ed\u30cb\u30ab\u304c\u300eJOKER\uff01\u3084\u3063\u3068\u898b\u3064\u3051\u305f\u30fc\uff01\u300f\u3068\u4e3b\u4eba\u516c\u3092\u63a2\u3057\u3066\u3044\u305f\u53e3\u3076\u308a\u3067\u73fe\u308c\u308b\u3002\n\u2193\n2.\u30d9\u30ed\u30cb\u30ab\u306e\u4e8b\u3092\u77e5\u3089\u306a\u3044\u30a2\u30fc\u30e2\u30f3\u30c9\u30a2\u30a4\u306f\u4e3b\u4eba\u516c\u304b\u3089\u805e\u304f\u4