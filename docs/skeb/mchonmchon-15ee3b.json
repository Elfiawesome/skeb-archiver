637e47dc-777a-4f2e-b645-1236c6eb4570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e4706cbedde8dfc44479f7c13150853", "srcset": "https://si.imgix.net/8eaac8f1/uploads/origins/637e47dc-777a-4f2e-b645-1236c6eb4570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e4706cbedde8dfc44479f7c13150853, https://si.imgix.net/8eaac8f1/uploads/origins/637e47dc-777a-4f2e-b645-1236c6eb4570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8734cb2bdf27763a2484b779c32e894a 2x, https://si.imgix.net/8eaac8f1/uploads/origins/637e47dc-777a-4f2e-b645-1236c6eb4570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2bcf0af9ce857197a8a0eda25ba3925 3x"}, "body": "こんにちは、以前リクエストさせて頂いた際は、素敵なイラストをありがとうございました！\n今回は他のオリキャラのイラストをお願いしたいと思います。\n\nキャラクター設定：\n- 黒髪ショート / 藍色の目 / 笑わない\n- 貴族出身で無表情なお嬢様 / 士官学校の優等生\n- 思考回路から口調まで、まるで冷徹な戦術AIのようだ。\n\nポーズ、衣装等はお任せします、ご自由に描いてください！\n金額不足や難しいなどの場合、お気軽にキャンセルや再送要請をお願い致します。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nmz1jubj9vS-EoybZenjJs88Mbq-cDJu?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mchonmchon/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2763387, "client_id": 3870576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce771f11d2fc15f66b1c5d8b0bbe6d66", "srcset": "https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce771f11d2fc15f66b1c5d8b0bbe6d66, https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32a503f49263187740002bc5b84085b1 2x, https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=095e6fe195eb0f9f77001d299b5222b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd88c53206b48ac1807a05079258fa9", "srcset": "https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd88c53206b48ac1807a05079258fa9, https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cdf79e8f73577449952f5cde64f0f27 2x, https://si.imgix.net/600845a9/uploads/origins/c5b83960-83ea-4cff-8d3d-cf9973f46ec1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c385ec447c36234e6da0279f52aa1e29 3x"}, "body": "大変お世話になっております。いつもめさん先生のイラスト、楽しく拝見しております！\n\nこの度は、拙宅の創作キャラクターである、リーヴというキャラクターを描いていただきたくリクエストいたしました！\n\n家畜から人間になった少年、という設定で、少し気弱ですが優しい性格の男の子です。少しファンタジー寄りの世界に住んでいます。\n\n参考画像を下記URLにまとめましたので、よければお目通しいただけたらと思います！\n\n使用用途は\n▶ヘッダーやアイコン、壁紙への使用\n▶完全に個人で楽しむ為のグッズ(アクリル製品やタペストリーなど)\nに使用させていただけたらと考えております。もちろん譲渡などは絶対にいたしません。\n\n不備や不足などありましたら、お手数おかけしてしまうのですが、再送要請をお願いいたします…！\n\nご都合がよければで問題ありませんので、ぜひともご検討頂けますと幸いです…！\n\nhttps://www.dropbox.com/scl/fo/hfozcj3pj35j0ba7zt9xp/AHf3oanrSOCIckVd6PWgddk?rlkey=hilci4jp1qeuo9zhmbs2xy8fr&st=orhqtd74&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mchonmchon/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2763387, "client_id": 2010304, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d93d34b053ac5004d1816017871c972", "srcset": "https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d93d34b053ac5004d1816017871c972, https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2a4f58cef461f13de6631ae8c0b2800 2x, https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e36602517a2c03d570f00abddf03569 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecfa41db600c532ffed30fe96bbff720", "srcset": "https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecfa41db600c532ffed30fe96bbff720, https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f77d5a1474eaeaff7a4dbfe6a0a5758f 2x, https://si.imgix.net/e6a03dde/uploads/origins/022bd62f-8a59-430e-b542-fe5ed294c211?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27c789ce6214580fb527dd3b902bf5da 3x"}, "body": "め³さん、お世話になっております！\nskebを募集されていたのでリクエストさせていただきました！\n\n◯キャラクター詳細 \n  34歳　男性　職業：裏向きは支部長、表向きはビジネスマン\n\n支部長としての経歴はまだ短いが優れたカリスマ性や指揮能力が高く、社交的であるため仲間たちと部下からは信頼されている。時間の規律はしっかりと守る、管理することが得意。\n優しい性格の持ち主だが時には現実的で冷徹な、厳しい言葉も放つ。言いたいことはさらっと言ってしまう空気が読めない人。笑顔が多いが半分作り笑い。酒好きで酒を手に入れた時の笑顔は本物