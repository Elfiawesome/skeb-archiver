-8f2c-b84fe066dca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8066cab4883ca34c1daa46d49dab50c7", "srcset": "https://si.imgix.net/0bba5ecd/uploads/origins/2e09c914-bfa8-4acd-8f2c-b84fe066dca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8066cab4883ca34c1daa46d49dab50c7, https://si.imgix.net/0bba5ecd/uploads/origins/2e09c914-bfa8-4acd-8f2c-b84fe066dca6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e71cb6b742e06234ae1cacbdc160a04 2x, https://si.imgix.net/0bba5ecd/uploads/origins/2e09c914-bfa8-4acd-8f2c-b84fe066dca6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e236f7c155de644aae4cb5a86d4a879 3x"}, "body": "紫乃様\n\nはじめまして、舞と申します。\nいつも紫乃様のイラストを拝見させていただいております。\nとても淡くて綺麗で素敵な空気感の最高のイラストだと思っています！！ほんっとうに大好きなイラストです！！今回skebが開かれるのを心待ちにしておりました！\n\n今回私とフォロワーのCoCシナリオ「タナトスは死に何を想う」で使用したOC達を描いていただきたくリクエストを送らせていただきます。\n\n■キャラクター詳細\n【瀬勿望宙】　195㎝　大学生\n雪乃とは幼い頃からの幼馴染\n頭の回転も速く勉強もできる。出来ない人や努力できない人が理解できないため、基本的に全ての人間を見下している。語彙力があるが故に口も悪い。\n唯一幼馴染の雪乃だけは話が通じるし認めている。雪乃以外の友人は居ない\n趣味は天体観測、将来はNASAで技術開発職に就く予定\n雪乃に対してただの幼馴染、友人に抱くには大きすぎる感情を抱えているが、如何せん人付き合い経験が少ないため自分の感情に気付いていない\n\n【三純雪乃】　169㎝　大学生\n望宙とは幼い頃からの幼馴染\nコミュ力◎、友人も多いが輪の中心から一歩引いた位置にいがち。面倒見がよく、望宙の他の人に対する態度に困った顔はするがあまり困ってはいない。\n望宙の良いところを周囲に理解してほしいとは思ってない。かといって自分以外の誰かと仲良くしていてもそれはそれでいい。\n望宙のことを誰よりも凄いやつだと思っているので隣に居るために日々努力している。\n趣味は写真、散歩、日記。望宙と天体観測に行き写真を撮ったりしている\n将来はイラストレータ志望\n望宙に抱く友人以上の感情に気付いてはいるが大事にあっためており表には出していない\n\n■資料\n資料は以下になります。(ネタバレはありません)\nhttps://drive.google.com/file/d/110134CI4AOzr6FQA5jh6h_oymdiVCZsX/view?usp=drive_link\nhttps://drive.google.com/file/d/1VJperVfVmkS9IS8i1ny9hMQzlZBJvmCE/view?usp=drive_link\n\n■イラスト希望　※金額が沿わない場合は無視していただいて構いません\n・デスクトップPCの壁紙にしたいため16:9のアスペクト比でお願いします\n・冬の海や星空イメージだと嬉しいです\n・お互いしか見えていない雰囲気、目が合っているとより嬉しいです\n・構図や衣装、髪型などはお好きに描いていただいて構いません\n\n■使用用途\n個人用pcやスマホの壁紙、個人観賞、個人でのグッツ制作、Xのアカウントのヘッダーとしての利用(紫乃様の作成であること表記いたします)、Xにて紫乃様からのスケブであることを明記の上での投稿、相方のフォロワーへのデータ共有\n\n金額不足などございましたらお手数ですがキャンセル、または金額変更をお願いいたします。\nお忙しいところ恐縮ですが、ご検討宜しくお願い致します！", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@himosu_chou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 976115, "client_id": 348236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f11476a7f8b2e86b3c0d89322b7694", "srcset": "https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90f11476a7f8b2e86b3c0d89322b7694, https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28d41678ed4aa7e624f55ad9862810b1 2x, https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b57e17c68847901bf221e6a7ade3ddbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5361b03085a781406d5f35bd9197de2", "srcset": "https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5361b03085a781406d5f35bd9197de2, https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab9d405fa86c17fe1aedda0c88a07d1c 2x, https://si.imgix.net/0e76b31c/uploads/origins/cbd8e902-adb6-4c4f-ae8a-8c330c41ae13?bg=%23fff&auto=format%2Ccompres