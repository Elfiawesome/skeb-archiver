で魅力的なので、ぜひ私も描いていただきたいと思い、リクエストを送らせていただいております。\n\n先生のかわいらしいイラストと背景の組み合わせのイラストに特に惹かれたので、お願いしたいです。\n詳細はお任せいたします。\n\n未虎キラのSNS（XでのツイートやYoutubeサムネイル収益化予定等）運用等、Vtuberとしての活動において使用させていただきたいです。\n\n未虎キラのキャラクターを添付いたしますので、ご確認お願いいたします\nhttps://drive.google.com/drive/folders/1pj8N8ErfhHXcz6i-LXFBjSsFJ9iMImaJ?usp=drive_link\n\n･平成に囚われている虎の女の子です\n･左目の下にホクロがあります\n･左耳の髪結びはシュシュです\n･金髪の紫メッシュになっております\n添付資料内の「虎ワレちゃん」はファンの皆様のことです。\n\nお手数おかけいたしますが、背景・人物・宛名などが分かれているもので納品いただけると助かります。\n\n以上、ご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1pj8N8ErfhHXcz6i-LXFBjSsFJ9iMImaJ?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetsubousensei/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3399533, "client_id": 2215005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35a4c28d/uploads/origins/de78db5b-f369-4b31-817a-d811f620bff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98912d2a02b65fb9357a03f793c04860", "srcset": "https://si.imgix.net/35a4c28d/uploads/origins/de78db5b-f369-4b31-817a-d811f620bff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98912d2a02b65fb9357a03f793c04860, https://si.imgix.net/35a4c28d/uploads/origins/de78db5b-f369-4b31-817a-d811f620bff9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70b3d1165c8ce4ce831be0f63eb9541e 2x, https://si.imgix.net/35a4c28d/uploads/origins/de78db5b-f369-4b31-817a-d811f620bff9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6b9e53473d0df836ff6a522cd05f780 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35a4c28d/uploads/origins/de78db5b-f369-4b31-817a-d811f620bff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c2938fa3a8e94364674698130e3fbaa", "srcset": "https://si