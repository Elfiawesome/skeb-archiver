5b9a\u3057\u3066\u304a\u308a\u307e\u3059\u3002\n\u4ee5\u4e0b\u30ea\u30af\u30a8\u30b9\u30c8\u307e\u3068\u3081\u3068\u306a\u308a\u307e\u3059\u3002\n\n\u30fb\u5168\u5e74\u9f62\u301cR-15\u5bfe\u8c61\n\u30fb\u30ed\u30ea\u3067\u306f\u306a\u304f\u304a\u59c9\u3055\u3093\u5bc4\u308a\n(\u80f8\u306f\u5927\u304d\u3081\u3067\u5168\u8eab\u306e\u4f53\u578b\u3082\u5927\u4eba\u3063\u307d\u3081)\n\u30fb\u80f8\u5143\u958b\u3044\u305f\u6843\u8272\u306e\u30d9\u30d3\u30fc\u30c9\u30fc\u30eb\u7740\u7528\n\u30fb\u30d8\u30a2\u30d4\u30f3\u305d\u306e\u307e\u307e\u306b\u9aea\u306f\u4e0b\u308d\u3057\u3066\u30ed\u30f3\u30b0\n\u30fb\u30d9\u30c3\u30c9\u306e\u4e0a\u3067\u80cc\u666f\u306f\u304a\u4efb\u305b\u3057\u307e\u3059\n\n\u30fb\u30dd\u30fc\u30ba:\n\u3046\u3064\u4f0f\u305b\u304b\u3089\u534a\u5206\u4e0a\u4f53\u3092\u8d77\u3053\u3057\u305f\u6dfb\u3044\u5bdd\u306e\u59ff\u52e2\u3001\u4e00\u4eba\u79f0\u8996\u70b9\u3067\u306b\u3083\u3082\u3055\u3093\u3092\u898b\u3066\u308b\u3088\u3046\u306a\u69cb\u56f3(\u88ab\u5199\u4f53\u306f\u306b\u3083\u3082\u3055\u3093\u306e\u307f)\u3067\u3001\u53ef\u80fd\u3067\u3042\u308c\u3070\u3001\u6a2a\u305f\u308f\u3063\u305f\u306b\u3083\u3082\u3055\u3093\u306e\u5168\u8eab(\u4e0b\u534a\u8eab\u304c\u5965)\u3092\u5965\u884c\u304d\u306e\u3042\u308b\u63cf\u5199\u3067\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\n\u3082\u3057\u53d7\u3051\u3066\u9802\u3051\u308b\u5834\u5408\u3001\u30c7\u30fc\u30bf\u306fPSD\u3001\u900f\u904epng\u306e\u6dfb\u4ed8\u3092\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\u3002\n\u4f9d\u983c\u7d4c\u9a13\u304c\u5c11\u306a\u304f\u3001\u4f55\u304b\u5931\u793c\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u7533\u3057\u8a33\u3054\u3056\u3044\u307e\u305b\u3093\u3002\n\u4f55\u5352\u3001\u3054\u691c\u8a0e\u306e\u307b\u3069\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u7533\u3057\u4e0a\u3052\u307e\u3059\u3002", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rei_9146/works/3", "private_thum