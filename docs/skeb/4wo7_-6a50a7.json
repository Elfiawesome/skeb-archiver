3-a2308cf2cb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52c5e86c4c16b6c18f5f962c55bfe571 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/414c9ce3/uploads/origins/d857ea20-e6a7-4beb-9753-a2308cf2cb93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73d669cca991f87f1cda9f846c9b89f0", "srcset": "https://si.imgix.net/414c9ce3/uploads/origins/d857ea20-e6a7-4beb-9753-a2308cf2cb93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73d669cca991f87f1cda9f846c9b89f0, https://si.imgix.net/414c9ce3/uploads/origins/d857ea20-e6a7-4beb-9753-a2308cf2cb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbbf59c78e3e642ce1fbcd0bbb4782d 2x, https://si.imgix.net/414c9ce3/uploads/origins/d857ea20-e6a7-4beb-9753-a2308cf2cb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c234a2af90d0b2def56b8db728d5cff4 3x"}, "body": "個人でVTuber活動をしております、天雲はうと申します。\n🎧様にグッズイラストを描いて頂きたく、リクエストを送信させていただきます、\n\n○主な使用用途○\nYoutube動画内やチャンネルヘッダー、サムネイルなど、天雲はうとしての活動（※収益化済み）\nXなどのSNSでの活動（アイコン、ヘッダーも含みます） \n返礼品(PC壁紙)やステッカーなどのグッズ化\n\n○キャラクター○\n私（天雲はう）を描いていただきたいです。  \n銀っぽい薄い青白いの髪の毛で、人耳もあります。 \n別に黒い髪の差分もございます。どちらでも構いません。\n猫耳は外さないでください。 \n目の色は青灰色とピンクの2色あります。どちらでも構いません。（オッドアイではございません） \n服装、髪型はお任せでお願いいたします。\n横顔で、表情差分がいくつかあると嬉しいです！\n\n\n○天雲はうモチーフ \n猫、リボン、ばってん、絆創膏、雲 \n地雷系、ロリータ系、サブカル系  \n\n○仕様など \n背景を描く場合は、背景とキャラクターを分けたものをそれぞれ頂けますと幸いです（背景使用不可の場合は背景はナシで結構です）。  \nPNGとPSDでいただきたいです。\n\n○資料 \nhttps://drive.google.com/drive/folders/1ePS2iIWPbUKEq_qD1A2ZivZVwrM7c75m?usp=drive_link  \n\n何卒よろしくお願いいたします.. .ᐟ\n\nhttps://drive.google.com/drive/folders/1ePS2iIWPbUKEq_qD1A2ZivZVwrM7c75m?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4wo7_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art",