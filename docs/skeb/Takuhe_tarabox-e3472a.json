手に立っている者、ソファで座っている者、着替えている者、などこちらも自由に決めて描いてください！\n\nパイロットスーツについてはこちらから影響を受けたので参考によければご確認ください。\n\nhttps://www.gundam-seed.net/destiny/character/detail.php?id=38\n\nhttps://www.gundam-seed.net/seed/character/detail.php?id=32\n\nいつも拓平さんの描く若い男性キャラは格好良くて大好きですのでSFロボット系パイロットのイラストも見てみたいです！\nぜひよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Takuhe_tarabox/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 389927, "client_id": 752862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf725eeb/uploads/origins/8a5d1e89-aff2-4916-ac93-67c320809a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684c52e445190fa8863314c1ce32f176", "srcset": "https://si.imgix.net/cf725eeb/uploads/origins/8a5d1e89-aff2-4916-ac93-67c320809a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684c52e445190fa8863314c1ce32f176, https://si.imgix.net/cf725eeb/uploads/origins/8a5d1e89-aff2-4916-ac93-67c320809a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3aff3cb75fb74a8ff92f6b1e1831484c 2x, https://si.imgix.net/cf725eeb/uploads/origins/8a5d1e89-aff2-4916-ac93-67c320809a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06ebadcf68e4415c30d2e4b8d564bd6a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf725eeb/uploads/origins/8a5d1e89-aff2-4916-ac93-67c320809a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb599445683da7c1d5bf8b395a817f93", "srcset": "https://si.imgix.net/cf725eeb/uploads/origins/8a5d1e89-aff2-4916-ac93-67c320809a5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb599445683da7c1d5bf8b395a817f93, https://si.imgix.net/cf725eeb/uploads/origins/8a5d1e89-aff2-4916-ac93-67c320809a5f?bg=%23fff&au