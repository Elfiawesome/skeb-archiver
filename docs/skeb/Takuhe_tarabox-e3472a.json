などの目や他の顔のパーツ、髪型等はすべてお任せします。\n\nイラストは、少年兵が吸血生物に吸血されている姿と、吸血後に吸血生物の周辺に放置され倒れている姿をメインにしてほしいです。\n少年兵達は吸血されていく恐怖と苦悶の表情に染まりながら気絶するまで吸血されます。\n\n吸血されている者は痛みで叫んでいたり抵抗している、力が入らず涙を流していたり涎が垂れているなど、麻痺毒の効き目で動けるか否かの時間経過の違いを表現してほしいです。\n\n吸血され意識のない者はその場で放置されて地面に倒れていたり、壁か何かに投げ飛ばされ座り込むような体勢でいます。\n具合の悪そうな表情と服が乱れて吸血の痕跡が見えるように描いてください。\n\nご都合等で難しければお断りして大丈夫ですので何卒ご検討のほどよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Takuhe_tarabox/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 389927, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a237e8fdc99f8a2a43fa702793a7f4c4", "srcset": "https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a237e8fdc99f8a2a43fa702793a7f4c4, https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddbeb31958bcbf7809a2061297a75504 2x, https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22ab32de89f67aa06bee68ba55ddd0d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f06451a2c1ed3ae45b347f650da3e2", "srcset": "https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f06451a2c1ed3ae45b347f650da3e2, https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9912c44304781a793df1bb2cbfe13d22 2x, https://si.imgix.net/158c5a96/uploads/origins/e967d260-5926-46f7-9fa4-3a06cdf95ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9e55ed04a103fb1fbb72abed9a0ca70 3x"}, "body": "前回は『キョウト彩奪ギャングスタア』に登場する黄組モブ集団という超絶マニアックなリクエストを快諾して描いてくださりありがとうございました！一人ひとりじっくり味わいながら眺めさせてもらいました！本当に感謝感激の至りです‼︎\n\nもしまた黄組モブを描いていただけるなら、第五話に登場した「冒頭で央に黄組の支持を強制された青年」と、「侵入した黄組が拘束された場面でこの青年の隣にいた顔のある黒髪らしきモブ」のイラストをお願いします！\n\n荒廃した街のどこかや黄組のアジトなど原作の世界観を感じられる場所 で、2人とも全身が見える構図かつカラーで描いてほしいです。\nポージング、シチュエーション、背景などはすべて拓平さんにお任せします。\n\nもし困難でなければ上記イラストとは別に、青組の安佐間隊長に粛清されて仰向けに倒れるイラストもお願いしてもよろしいでしょうか。\nこちらはカラーかモノクロのどちらでも構いません。\n\nご検討いただけますと幸いです。\n今後も拓平さんのご活躍を願いながら心より応援しております！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Takuhe_tarabox/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bc4cedda/uploads/origins/7a16a8f8-07d2-4c85-9a5c-9353ec9cfedf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd6273a79ff0ce21f220b406eb9fae9d", "srcset": "https://si.imgix.net/bc4cedda/uploads/origins/7a16a8f8-07d2-4c85-9a5c-9353ec9cfedf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd6273a79ff0ce21f220b406eb9fae9d, https://si.imgix.net/bc4cedda/uploads/origins/7a16a8f8-07d2-4c85-9a5c-9353ec9cfedf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=87583622dac3953ad88f2a7a574f4705 2x, https://si.imgix.net/bc4cedda/uploads/origins/7a16a8f8-07d2-4c85-9a5c-9353ec9cfedf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=327ce364605e6104ee3e05df3d0abd58 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 389927, "client_id": 752862, "nc": 128}, {"path": "/@Takuhe_tarabox/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 389927, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24dcb535fea0bd857cbf7c051ef7a7e9", "srcset": "https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24dcb535fea0bd857cbf7c051ef7a7e9, https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52e42af9a42c000550b045205d797722 2x, https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8138c461cc0eb13424ee1900b2d58dd3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e339203dfea06bb5466705f1d53b2e62", "srcset": "https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e339203dfea06bb5466705f1d53b2e62, https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7525f9d29414258682f7d2343a7cd652 2x, https://si.imgix.net/57043018/uploads/origins/83d788c7-d128-4434-a71e-e0feaa2c75f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=087e026769e7ea256f641e1e138ad188 3x"}, "body": "はじめまして！拓平さんの描く漫画もイラストも大好きです！！\n初めて触れた拓平さんの作品が『キョウト彩奪ギャングスタア』です。魅力的なキャラクターたちと壮大かつ衝撃的な展開にどっぷりハマってコミックスも買わせていただきました。素敵な漫画を描いてくださりありがとうございます！！！\n\nリクエストですが『キョウト彩奪ギャングスタア』に登場するカラーギャング『黄組』のモブギャングたちを可能な範囲でたくさん描いてほしいです！\n作中で喋っていたり顔や容姿がはっきり描かれているモブは全員入れてください！\n中でも特に描いてほしいお気に入りのギャングたちは箇条書きで下記にまとめました。\n\n第一話より\n・首チョンパされたモブ3人組（顔の描写はないですが無理でなければ首が繋がったままの彼らをどうか…）\n・それを見た直後春臣からの言葉に反応す？モブ2人\n\n第二話より\n・終盤に阿佐間隊長に粛清されたヘアバンドのモブ二人組\n\n第五話より\n・冒頭で央に首を締め上げられ強制的に黄組を支持することになった青年\n\nまた、みんなの私服に黄色のバンダナを巻いた姿がすごく好きで、服装の色やコーディネートを見て楽しみたいので、全員フルカラーで一人ひとりの全身が見えるように描いていただけると嬉しいです！\n\nそれ以外では背景や構図など他の細かい指定は特にありません。\n\nマニアックなリクで恐れ多くありますが、拓平さんのご都合に支障が無ければ何卒ご検討のほどよろしくお願いします！！！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1133747, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "しらとりゆう / Shiratori U", "screen_name": "yy_108109", "avatar_url": "https://pbs.twimg.com/profile_images/1898643522145935360/FLmJ73ta.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2276960906/1751089373/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1178113, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えきあ", "screen_name": "ekiaroll", "avatar_url": "https://pbs.twimg.com/profile_images/1925976866763972608/S8oveO5Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1011152151182110720/1750993906/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_request