": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/720eecd9/uploads/origins/6cd8bfe1-e02c-4a9c-be01-87dcfe53ccdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2719662b2fb8fdaf141129e5bf9a41c", "srcset": "https://si.imgix.net/720eecd9/uploads/origins/6cd8bfe1-e02c-4a9c-be01-87dcfe53ccdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2719662b2fb8fdaf141129e5bf9a41c, https://si.imgix.net/720eecd9/uploads/origins/6cd8bfe1-e02c-4a9c-be01-87dcfe53ccdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9be94e6c1701081eafe29348db0d35c 2x, https://si.imgix.net/720eecd9/uploads/origins/6cd8bfe1-e02c-4a9c-be01-87dcfe53ccdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1e658ecb54bac318326bdd8b94989ec 3x"}, "body": "いつもお世話になっております。\n先日は自キャラのリクエストを描いていただきありがとうございました。\n\n最近ですと、拓平様のツイートされている、柴犬のちゃむちゃん様のイラストに日々癒されております。\n\n今回は愛犬のちゃむちゃん様と、色奪メンバーのイラストを見てみたいと思い、依頼させていただきました。\n\n\n【依頼内容】\n柴のちゃむ様とキョウト色奪ギャングスタアメンバーが戯れている姿が見たい。\n\n【イラスト形式】\n1枚絵、漫画、カラー、白黒等は問いません。\n全てお任せでお願いします。\n\n【キャラクター希望】\nお任せでお願いします。\n黄組、青組などのメンバーやチームもお任せしたいです。\n\n\nご検討のほどよろしくお願いします🙇🙇", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Takuhe_tarabox/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 389927, "client_id": 2437718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1aa0f9b8/uploads/origins/18a29c2b-22fb-401e-8644-ec1030e6a22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dd5ade5d94c3b7395c558825d109381", "srcset": "https://si.imgix.net/1aa0f9b8/uploads/origins/18a29c2b-22fb-401e-8644-ec1030e6a22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3dd5ade5d94c3b7395c558825d109381, https://si.imgix.net/1aa0f9b8/uploads/orig