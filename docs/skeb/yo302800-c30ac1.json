toyhou.se/147894.ren-aspen/5706489.art?key=ptuuYsvr3YfeWvn\n\nレン： ♂ 。180センチ。ふわふわの白髪にサファイアの瞳。性別を問わない美しい容姿の持ち主。病弱で心優しい少年。テーマは青いバラ、フクロウ、本、魔法。\n\nレンは魔法を使って青いバラを育てる。そのバラの花びらでお茶を淹れ、人々を癒す。そんなテーマでイラストを描いてくれませんか？どんなポーズでも自由に描いてください。構図はお任せします。\n\nご検討ありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yo302800/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2965415, "client_id": 2949657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51ce9032/uploads/origins/2e2a6b66-2c9c-4149-abdc-597cf08dee96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4dafd6b5f2f9991177aac70bcc7778f", "srcset": "https://si.imgix.net/51ce9032/uploads/origins/2e2a6b66-2c9c-4149-abdc-597cf08dee96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4dafd6b5f2f9991177aac70bcc7778f, https://si.imgix.net/51ce9032/uploads/origins/2e2a6b66-2c9c-4149-abdc-597cf08dee96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e664e6f8b945562f88cd0ef9303d147e 2x, https://si.imgix.net/51ce9032/uploads/origins/2e2a6b66-2c9c-4149-abdc-597cf08dee96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73d5f18be1c00e749d3d7613c89f9af5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51ce9032/uploads/origins/2e2a6b66-2c9c-4149-abdc-597cf08dee96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc916948675aec8f8be90dcead91f1e", "srcset": "https://si.imgix.net/51ce9032/uploads/origins/2e2a6b66-2c9c-4149-abdc-597cf08dee96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc916948675aec8f8be90dcead91f1e, https://si.imgix.net/51ce9032/uploads/origins/2e2a6b66-2c9c-4149-abdc-597cf08dee96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t