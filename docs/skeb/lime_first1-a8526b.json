4-fb6e-4e9b-86b6-22c9bb16404f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24d94c6223adebd5db46113746acdc6f, https://si.imgix.net/c6aef499/uploads/origins/2af9c4b4-fb6e-4e9b-86b6-22c9bb16404f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85258682519fc3ac292650179ffe65b6 2x, https://si.imgix.net/c6aef499/uploads/origins/2af9c4b4-fb6e-4e9b-86b6-22c9bb16404f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fee57db40f3ac9946b658028696842b0 3x"}, "body": "ねこ先生、初めまして。先生の素晴らしいイラストをTLで見た時に強く惹かれ、今回依頼させていただきます。\n\n当方のオリキャラである資料URL先①の女子高生キャラクターが、リミナルスペースを探索しているあるいは休憩しているイラストをお願いしたいです。\n\n○キャラ\n・高校生、身長159cm、スポーツをしているしなやかな体型\n・トラックジャージに学生スカート(少し短め)、スニーカーを着ている(色はお任せ)\n・黒のロングソックスを履いている\n・リュックを背負っている\n\n背景は「閉鎖的な屋内」「同じ場所が永遠に続くような奥行きのある場所」「無人」のように前述したリミナルスペースな要素を含むものでお願いしたいです。基本的にはお任せします。\n\nまた資料URL先の画像は①以外は全てイメージです。参考程度にお任せします。\n\n以上となります。可能であればよろしくお願いいたします。\n\nhttps://x.com/ata8q/status/2053442513361584184?s=46&t=QigT77RREdQywVczayiSAA", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lime_first1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3722645, "client_id": 3286184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a54c056df3c33503dee5731bb5821c7", "srcset": "https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a54c056df3c33503dee5731bb5821c7, https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12459f0b4f3ed50b2fe9eb894909b038 2x, https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71415132ffc12ba06ab99d1872501531 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a878e5fd9f93c232eacc7cbeecf1782", "srcset": "https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a878e5fd9f93c232eacc7cbeecf1782, https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fedfedc6a33d2aadae7d8041a3556884 2x, https://si.imgix.net/98e87674/uploads/origins/d89d98e4-e3ee-4e8e-b07f-4cf8702a2d20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c7595742450fd5e881c0435f290940c 3x"}, "body": "初めまして。\nねこ様のイラストがとても大好きで、自分のキャラクターも描いていただきたいと思いご連絡しました。\n「危険」「邂逅」「逃げないでよ」等、暗い背景のイラストが特に大好きです。怖くて美しくて…。\n\nTRPGで使用しているキャラクターとなります。\n23歳、170cmの女の子です。左目にやけどの痕があります。\n左手だけ黒手袋を着用していると嬉しいです。\n編み上げブーツを履いている想定ですが、服装に関しては好きに改変していただいて問題ありません。\n\n一度ご検討いただけますと幸いです。\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/u/3/folders/1oXuvx-sfM5KPHXY3wDIqT6Pre-f9zudK", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lime_first1/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3722645, "client_id": 1825355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b89256d85c1e7ca5b5f173a2a69ecc", "srcset": "https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70b89256d85c1e7ca5b5f173a2a69ecc, https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acfdfbdf2005ea4d7dd9e9139a2aeeb5 2x, https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cb9068fda2ccc6974f383a822169572 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2559a3bfe61322ae3684ae6bdc9068a", "srcset": "https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2559a3bfe61322ae3684ae6bdc9068a, https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2ceb0ea23a8285bbbf8cce3ba7cfe1c 2x, https://si.imgix.net/5cde0be6/uploads/origins/d2f1878e-56a4-433e-ad24-c458c8e4d961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e3ecfc04b83a15d5596369e13889d15 3x"}, "body": "ねこ様\n\n初めまして。\n新着イラストにてとても素敵なイラストを拝見致しました。\n私のキャラクターも描いていただけると嬉しいです。\n\n\n〖キャラクター詳細〗\nキャラクターや世界観のモチーフや引退競走馬と馬術競技です。\n\n身長：168cm\nイメージカラー：黄色・青\n\n優しくてマイペースなふんわりとした性格。\n多くの名声と共にこの世を去った親の背中を追い続けてきたが、父と同じ景色を見ることなくレースを引退。\nその後は自分が自分らしくあれる場所を見つけ、仲間と新たな夢に向かって走り続けている。\n同居人の少女に振り回されつつも楽しい日々を過ごしている。\n\n✤髪の毛について\nボブではなく後ろでお団子にしています。\nヘアアレンジのイメージ画像をドライブに保存しているのでご参考ください。\n\n✤衣装について\n今回は【衣装1】と記載のあるイラストをご参考ください。\n\n✤耳・尻尾について\n耳は馬耳のみで、人耳はありません⚠️\n髪色と同じ、馬のしっぽが生えています。\n\n\nキャラクターシートもドライブに同梱しておりますので、こちらもご参考下さい。\n\n\n私のページにあるイラストは明るい雰囲気のものが多いですが、ねこ