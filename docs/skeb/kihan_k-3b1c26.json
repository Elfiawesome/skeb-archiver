81e67c682cfb4", "srcset": "https://si.imgix.net/ef11b685/uploads/origins/7480e0b4-7bef-42c7-9ac7-2c18387df614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba2ecc71e4d7c64d46581e67c682cfb4, https://si.imgix.net/ef11b685/uploads/origins/7480e0b4-7bef-42c7-9ac7-2c18387df614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5aab72d0c5a5428cc3f90eaa8ff588d 2x, https://si.imgix.net/ef11b685/uploads/origins/7480e0b4-7bef-42c7-9ac7-2c18387df614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ffd3a79d34638d1ead9b7fd69e70d44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef11b685/uploads/origins/7480e0b4-7bef-42c7-9ac7-2c18387df614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be35b6780ebea37d626d2b51e37e1520", "srcset": "https://si.imgix.net/ef11b685/uploads/origins/7480e0b4-7bef-42c7-9ac7-2c18387df614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be35b6780ebea37d626d2b51e37e1520, https://si.imgix.net/ef11b685/uploads/origins/7480e0b4-7bef-42c7-9ac7-2c18387df614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=259fcfe7a6e35bd2f82e8a59293f66a6 2x, https://si.imgix.net/ef11b685/uploads/origins/7480e0b4-7bef-42c7-9ac7-2c18387df614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7deea75943350a74c88d047636627b1 3x"}, "body": "キハンさんへ\nお世話になっております。マイです。\nskeb依頼初です。よろしくお願いします。\ncocシナリオ『蹂躙するは我が手にて』に連れていった私の探索者とお友達の探索者のイラストを描いてほしいです。\n\nキャラクター（3人）\n・ミランダ　短めの金髪に淡い緑色の目\n・リアン　顔の横の髪だけ長くて他は短い銀髪、淡い水色の目\n・キリル　長い黒髪にブルーグレーの目\n顔髪型服装身長等他外見詳細は添付したリンクのイラストから。\n\n状況\n・仲良くお茶会or食事会\n・ドレスコードのあるパーティー(ミランダは赤いドレス+ワイングラス、リアンは軍服、キリルはお任せ)\n・みんなで作戦会議（同じ軍に所属しているif。軍服はだれかひとりのものに統一。描きやすいものを）\n・作戦会議の合間の休憩時間（ifその２。紅茶やコーヒーを飲んだり）\n・ミランダを豪華な椅子に座らせて、他二人を侍らせる(服は各自の軍服かドレス/スーツ。お任せします)\nの中でどれかを描いてもらいたいです。仲の良いみんなが見たい！\nもし「こんなシチュエーションいいんじゃない？」みたいなのがあったらそちらを描いてください。\n\nキハンさんの描くイラストの線が綺麗で大好きなので、線の分かりやすい塗りをしてほしいです。線だけでも好きです。\nキャラの髪の色眼の色服の色を書きましたが、着色はお任せします。良い感じにしてください。\n\n使用目的\n・鑑賞\n・印刷して鑑賞\n・お友達に共有\n\n・資料\nhttps://drive.google.com/drive/folders/1OcdwDQ4ik_angzQs-2HPZbG8brWm1T-d?usp=drive_link\n\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kihan_k/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 852297, "client_id": 1287513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11e35b0f/uploads/origins/467aedbc-1304-4cac-b4ba-5d977a43c93b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed705cdfa2058684e9dd88b556db36c9", "srcset": "https://si.imgix.net/11e35b0f/uploads/origins/467aedbc-1304-4cac-b4ba-5d977a43c93b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed705cdfa2058684e9dd88b556db36c9, https://si.imgix.net/11e35b0f/uploads/origins/467aedbc-1304-4cac-b4ba-5d977a43c93b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27aab7be9724ff3d537943516dec936a 2x, https://si.imgix.net/11e35b0f/uploads/origins/467aedbc-1304-4cac-b4ba-5d977a43c93b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc997fa1c0ff51eadd8091b7826da632 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11e35b0f/uploads/origins/467aedbc-1304-4cac-b4ba-5d977a43c93b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b18c1ce7b94145a24b863a1ee0501d5", "srcset": "https://si.imgix.net/11e35b0f/uploads/origins/467aedbc-1304-4cac-b4ba-5d977a43c93b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b18c1ce7b94145a24b863a1ee0501d5, https://si.imgix.net/11e35b0f/uploads/origins/467aedbc-1304-4cac-b4ba-5d977a43c93b?bg=%23fff&auto=f