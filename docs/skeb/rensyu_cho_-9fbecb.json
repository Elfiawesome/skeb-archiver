904256305/373688330/episode/7119844\n\n■二人の関係性\n十年来の腐れ縁の悪友　背中を預け合える相棒　ドケチ霊能者とその助手\n\n構図・表情・ポーズはお好きにどうぞ\nアレンジ歓迎\n本編では26歳になってますがお互い高校の同級生でもあるので、どちらで描くかはお任せします\n高校時代は二人とも学ランでした\n\n完成品は下記サイト掲載の他SNSでシェア、ネット小説の表紙や宣伝に使わせてください\nお名前やアカウントは明記します\nhttps://novel18.syosetu.com/xs8324a/　\n\n内容や金額に不備がございましたら遠慮なくキャンセルか再送依頼してください\nご縁がございましたらよろしくお願いします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2910918, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "♨️", "screen_name": "___hi5_", "avatar_url": "https://pbs.twimg.com/profile_images/1703987627450585088/febqQ0lG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1539866790024454144/1694855332/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2968034, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "前後 歩 @Vtuber", "screen_name": "maeusiro_ayumu", "avatar_url": "https://pbs.twimg.com/profile_images/1925247644114546688/gqdZZfVW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1605468946970263552/1759790331/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 3763267, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "紅月憂羅@skeb募集中", "screen_name": "yuraillust", "avatar_url": "https://pbs.twimg.com/profile_images/2014676311592361984/dhQEtRpz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1392049037793132544/1772555477/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "reque