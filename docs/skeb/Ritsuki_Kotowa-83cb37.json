bp&fit=crop&crop=top&w=200&h=200&s=609754d3a6de31edd390eafec976fda1", "srcset": "https://si.imgix.net/730864cf/uploads/origins/19f699b8-814b-4493-8bea-78daec71577b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=609754d3a6de31edd390eafec976fda1, https://si.imgix.net/730864cf/uploads/origins/19f699b8-814b-4493-8bea-78daec71577b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bd184ff342aa9770d986bd5f882daec 2x, https://si.imgix.net/730864cf/uploads/origins/19f699b8-814b-4493-8bea-78daec71577b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=913d068a360c5e5b6741ac2744af4880 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/730864cf/uploads/origins/19f699b8-814b-4493-8bea-78daec71577b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15eac237c9282d07ed535b47f383a498", "srcset": "https://si.imgix.net/730864cf/uploads/origins/19f699b8-814b-4493-8bea-78daec71577b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15eac237c9282d07ed535b47f383a498, https://si.imgix.net/730864cf/uploads/origins/19f699b8-814b-4493-8bea-78daec71577b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e0428100a734e039bae57f87bf2f0f0 2x, https://si.imgix.net/730864cf/uploads/origins/19f699b8-814b-4493-8bea-78daec71577b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61d33ef5efdc29d75aa79f3083a3250e 3x"}, "body": "はじめまして。心灯和理月様にオリキャラを背景付きで描いていただきたいと思いました。\n\nオリキャラ資料\nhttps://drive.google.com/drive/folders/1GzAfHLWsos6D47uJPWLEy8ueHRK1qjUz?usp=sharing\n・色っぽい雰囲気を出す大人のお姉さん\n・銀色のストレートロングヘア―\n・青色の目\n・髪には画像のような髪飾りをお願いします。\n・これまで磨き上げてきた肌とプロポーションに自信があり、露出高めで胸を強調させる衣装を好んでいます。\n・巨乳です\n・「蒼」い「月」という名前をキャラクターに反映させたような形となります。\n\nベッドで一緒に添い寝をしてくれるシチュエーションをお願いします。関係は恋人の設定です。\n顔を赤くしながらこちらを見つめてくる表情をお願いします。\n\n服装はセクシーなベビードールかパジャマで大丈夫です。心灯和理月様が描いてみたい方を選択していただいて大丈夫です。\nパジャマに関しては心灯和理月様の作品（https://www.pixiv.net/artworks/140084916）のように胸の谷間ぐらいまではだけさせていただけると嬉しく思います。\n胸の主張は強めでお願いします。\n\n縦向きのイラストで全身に近い描写をお願いします。\nサイン有り無しを切り替えることのできるPSD形式を希望します。\n\nそれではご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ritsuki_Kotowa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2690870, "client_id": 2629444, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4db9b6ca/uploads/origins/f86ae2b3-4071-4853-ba75-118995563931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f692273a15ded52a1646dbc809f6763f", "srcset": "https://si.imgix.net/4db9b6ca/uploads/origins/f86ae2b3-4071-4853-ba75-118995563931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f692273a15ded52a1646dbc809f6763f, https://si.imgix.net/4db9b6ca/uploads/origins/f86ae2b3-4071-4853-ba75-118995563931?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6de92a8559aa2e35d153cda3b09174d 2x, https://si.imgix.net/4db9b6ca/uploads/origins/f86ae2b3-4071-4853-ba75-118995563931?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6dd6652e041843b2d3cc9dee0ae3d8d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4db9b6ca/uploads/origins/f86ae2b3-4071-4853-ba75-118995563931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=887c8f898a14cf98f3e1c3217046cf52", "srcset": "https://si.imgix.net/4db9b6ca/uploads/origins/f86ae2b3-4071-4853-ba75-118995563931?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=887c8f898a14cf98f3e1c3217046cf52, https://si.imgix.net/4db9b6ca/uploads/origins/f86ae2b3-4071-4853-ba75-118995563931?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200