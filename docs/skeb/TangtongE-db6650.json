e.com/drive/folders/1rek1MtZsXxND5yyuBRrjhXGRYOGhGhaJ?usp=drive_link\n↑上記フォルダの下層フォルダに一部CoCシナリオのネタバレを含んだものをまとめています、参照しなくても構いません。\nまた髪型や服装はどちらでも構いません。\n\n細かいキャラデザなどはあまり気にせず自由に描いてもらえると嬉しいです。\n\nご検討いただけますと幸いです。よろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TangtongE/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2651272, "client_id": 3427806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999f8b54bf0d329a95d13489e231e399", "srcset": "https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999f8b54bf0d329a95d13489e231e399, https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de4b9fc9bb8d215704bfc0877ab56b2a 2x, https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47cb036a8eb4ec5b5e0b254f813d5ff7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2aaa08963adc444d50cfe3b38500a7", "srcset": "https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2aaa08963adc444d50cfe3b38500a7, https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99