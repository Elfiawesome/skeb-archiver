crop=top&w=200&h=200&blur=200&s=1694c669c0872a4604f64ab42b15fd73 2x, https://si.imgix.net/2a13a94f/uploads/origins/c8a32301-6689-45c0-8d44-342658e4a144?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3fa5dc3c860fe84643a1ec2e7d9d59da 3x"}, "body": "こんにちは！トップページであなたのモンスターのイラストを見かけました。ぜひ応援したいです！\n\n私の二頭身の鳥モンスターを描いていただけませんか？名前は「マルヴドルチェ」です！\n\nhttps://toyhou.se/35892641.malvdolche\n（サムネイル画像をクリックすると、拡大画像が表示されます。）\n\nマルヴドルチェはメンフクロウをモデルにしています。 片方の頭は「生」を、もう片方は「死」を表しています。このキャラクターはとても知性が高く、常に知識を追求しています。ただ、時々食いしん坊な一面もあります。もしよろしければ、様々なスイーツや赤い果物を描いていただけると嬉しいです。\n\n参考画像では紺色の頭が開いた口をしていますが、くちばしは赤色だと想像しています。\n\nありがとうございます！楽しんで描いてくださいね！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TORIKRATOPUSU/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3862724, "client_id": 3656242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/158a0a96/uploads/origins/e44c5a39-4afe-4e0a-9d3f-265f6aa26bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f619bc85451bd440f50295c1810678c5", "srcset": "https://si.imgix.net/158a0a96/uploads/origins/e44c5a39-4afe-4e0a-9d3f-265f6aa26bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f619bc85451bd440f50295c1810678c5, https://si.imgix.net/158a0a96/uploads/origins/e44c5a39-4afe-4e0a-9d3f-265f6aa26bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b5018608109e5f2e5f8a5d14c6f87ad 2x, https://si.imgix.net/158a0a96/uploads/origins/e44c5a39-4afe-4e0a-9d3f-265f6aa26bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c9d7bf04827e4ab97925d789c4c6fc3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/158a0a96/uploads/origins/e44c5a39-4afe-4e0a-9d3f-265f6aa26bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop