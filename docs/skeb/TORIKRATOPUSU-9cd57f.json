1f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86488e7645cc3112c4333154b422b210 2x, https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02714e21789f2efb1bc0062072f4539b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4878d9924a751ca88150ac20e0261792", "srcset": "https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4878d9924a751ca88150ac20e0261792, https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9be7e041eab9f838c2c74bde08218336 2x, https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=892bb1adee8a92806e6d7237ae942768 3x"}, "body": "初めまして。\nXにてトリケラト・プス先生の素敵なモノクロイラストを拝見しリクエストを送らせて頂きました。\n\nもしよろしければ私の獣人OCを描いて頂けないでしょうか？\n設定は以下の通りです。\n\n【キャラクター設定】\n《クレム(クレメンタイン)》\n20代前半。\nクロシロエリマキキツネザルのオス。\n小説家。\n家族や友人を何よりも大切にしますが、親密でない動物(猿と海洋生物を除く)をやや下に見る捻くれた性格をしています。(この性格は都市部へ移住した後、様々な動物たちと関わることで多少丸くなっていきますが、それでも身内以外には少々嫌味な金持ちヴィランという設定です。)\n\n【要望(可能な範囲で構いません)】\nXで投稿されているようなモノクロのイラストで、全身が描かれていると嬉しいです。体の向きの指定は特にありません。\n\n資料そっくりに描く必要はありませんのでメイン資料の赤文字以外は好きにアレンジ、省略してください。\n\n\nお忙しい中、最後までお読みいただきありがとうございます。\n獣人キャラクターですので、難しい場合はお気軽にキャンセル、金額再送等して頂ければ幸いです。\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1f12gyr6KlTQHfq793KB4XjVX6t29X8pK", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{