c94eb/uploads/origins/cb333fdb-7982-4c74-8a21-3a09b77272d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1a2efb3a560decb1a4934abb26b51ec 2x, https://si.imgix.net/c6dc94eb/uploads/origins/cb333fdb-7982-4c74-8a21-3a09b77272d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dab4cd0891539fd7b38c15f85aec5a60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6dc94eb/uploads/origins/cb333fdb-7982-4c74-8a21-3a09b77272d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=827bab10898fbd9a78f72cc3b035e024", "srcset": "https://si.imgix.net/c6dc94eb/uploads/origins/cb333fdb-7982-4c74-8a21-3a09b77272d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=827bab10898fbd9a78f72cc3b035e024, https://si.imgix.net/c6dc94eb/uploads/origins/cb333fdb-7982-4c74-8a21-3a09b77272d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45d25f3457ef085627fcb3d6097404b4 2x, https://si.imgix.net/c6dc94eb/uploads/origins/cb333fdb-7982-4c74-8a21-3a09b77272d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45a06436a4af7e93afd6ac95dfaecda0 3x"}, "body": "こんにちは！\n\nあなたのイラスト、本当に素敵ですね！非人間キャラクターのイラストをお願いしてもよろしいでしょうか？\n\nもしよろしければ、私のオリジナルキャラクター（OC）を描いていただけると嬉しいです！彼は物静かな性格で、野鳥観察や野鳥の写真を撮るのが好きです。\n\n描き方はお任せします。服装や髪型も自由に選んでください。\n\nhttps://drive.google.com/drive/folders/1H7fei7bcZfHq1zhRqoOyLGrB7fWaVVsH", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TORIKRATOPUSU/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3862724, "client_id": 3474000, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ab1112486f507ee1e85b733709d874d", "srcset": "https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ab1112486f507ee1e85b733709d874d, https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86488e7645cc3112c4333154b422b210 2x, https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02714e21789f2efb1bc0062072f4539b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4878d9924a751ca88150ac20e0261792", "srcset": "https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4878d9924a751ca88150ac20e0261792, https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9be7e041eab9f838c2c74bde08218336 2x, https://si.imgix.net/953f7905/uploads/origins/3bbb9243-1a17-4691-91f3-d2a1762dbdb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=892bb1adee8a92806e6d7237ae942768 3x"}, "body": "初めまして。\nXにてトリケラト・プス先生の素敵なモノクロイラストを拝見しリクエストを送らせて頂きました。\n\nもしよろしければ私の獣人OCを描いて頂けないでしょうか？\n設定は以下の通りです。\n\n【キャラクター設定】\n《クレム(クレメンタイン)》\n20代前半。\nクロシロエリマキキツネザルのオス。\n小説家。\n家族や友人を何よりも大切にしますが、親密でない動物(猿と海洋生物を除く)をやや下に見る捻くれた性格をしています。(この性格は都市部へ移住した後、様々な動物たちと関わることで多少丸くなっていきますが、それでも身内以外には少々嫌味な金持ちヴィランという設定です。)\n\n【要望(可能な範囲で構いません)】\nXで投稿されているようなモノクロのイラストで、全身が描かれていると嬉しいです。体の向きの指定は特にありません。\n\n資料そっくりに描く必要はありませんのでメイン資料の赤文字以外は好きにアレンジ、省略してください。\n\n\nお忙しい中、最後までお読みいただきありがとうございます。\n獣人キャラクターですので、難しい場合はお気軽にキャンセル、金額再送等して頂ければ幸いです。\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1f12gyr6KlTQHfq793KB4XjVX6t29X8pK", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 424140, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "すもっふ", "screen_name": "mikigumimiku6", "avatar_url": "https://pbs.twimg.com/profile_images/1280307481084784645/qtDzs4-I.png", "header_url": "https://pbs.twimg.com/profile_banners/2446935912/1583437939/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 1500892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ろっぷちょっぷ/Illustrator", "screen_name": "ropchopgraphic", "avatar_url": "https://pbs.twimg.com/profile_images/1822579655125475328/IL0q13av.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2584537100/1767125723/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 1}, {"id": 1615005, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あし丸", "screen_name": "ashi00ashi", "avatar_url": "https://pbs.twimg.com/profile_images/1389411380713824257/hHxNFRaL.png", "header_url": "https://pbs.twimg.com/profile_banners/2277647558/1671885982/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_exp