91/uploads/origins/73ea5f7e-726a-47c7-be33-94cc88e91f75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83659647a30eb7837364cdc407ee5bb8, https://si.imgix.net/19c76091/uploads/origins/73ea5f7e-726a-47c7-be33-94cc88e91f75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a98b26655dce0bd236fa938e17fb62ee 2x, https://si.imgix.net/19c76091/uploads/origins/73ea5f7e-726a-47c7-be33-94cc88e91f75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66539b23ba3b1294e974feb43526d901 3x"}, "body": "はじめまして。いつも鮫崎さんのゲーム進捗やイラストなどを楽しく拝見しております。\n4死とわんヒュが大好きです……！凝ったUIデザインや素敵なキャラクターなど、無料とは思えないクオリティに毎度驚かされています。\n幽囚の魔法使いも楽しみにしています！\n\n今回は鮫崎さんの絵柄でOCを描いていただきたいと思い、リクエストを送らせていただきました。\n用途は個人鑑賞のみになります。\nキャラクター詳細は資料URLにまとめております。\n服装や髪型は描きやすいようにアレンジしていただいても構いません。\n構図などは全ておまかせします。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1J6X3zPLnYjZiim48ECtdv1v5Kc7n0PwJ/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samexxki/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2765918, "client_id": 3831506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c46ed15699a96ec4eab9a15ba9bcad4", "srcset": "https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c46ed15699a96ec4eab9a15ba9bcad4, https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7706fc446c237516450e31f9d5033513 2x, https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=658536eb804c8082cf15056145dc9bb7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f625abb12185368469ad749411329822", "srcset": "https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f625abb12185368469ad749411329822, https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4c4c9ae32c5c3cbdba4dc77f6c51b15 2x, https://si.imgix.net/81f94853/uploads/origins/bd553a03-a1f5-4b8b-8ec2-bf43472d869a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29cecc49d4666da994955a7c01c19204 3x"}, "body": "はじめまして、VTuberとして活動しております\n白星コメタと申します。 \n\n鮫崎様の製作されたゲーム『就労！！わんわんヒューマン』をとても楽しく遊ばせていただきました！\nあの時々明るくも闇深い世界観と、キャラクターの喜怒哀楽の表情のギャップに強く惹かれ、ぜひ私のイラストを描いていただきたくリクエストをお送りいたしました。\n\n今回お願いしたいのは、白星コメタの\n「地球人擬態モードと宇宙人モード(本性)のギャップ」をメインにした1枚絵です。\n \n使用用途としては、今後の配信サムネイルやSNSでの活動報告等に使用させていただきたいと考えております。\n\n 「地球人への擬態ホログラムがバグり、本来の姿（宇宙人モード）が露わになってしまう瞬間」を、可能であれば2枚組でお願いしたいです。\n\n 地球人擬態用のホログラムにノイズやグリッチが走り、人型の肌を突き破る(あるいは透過する)ように、所々から宇宙人モードのパーツ（触手、目、その他ギャップのあるパーツなど）が露出している状態でお願いします。\n\n鮫崎様の描く「格好良いダークさ」と「崩れたパニック顔」の両方が見たいので、以下の2パターンを表現していただければ幸いです。\n\n【余裕の悪役顔】 \nノイズが走る中で、「あ～あ、バレちゃった……」という雰囲気の、不敵にあるいは冷酷に微笑んでいる姿。悪役感のあるダークな雰囲気。\n\n【内心パニック顔】\n 「やばいやばい…！」「見られた！終わった！」と焦りまくっている姿。\nホログラムが完全に解け、100%宇宙人モードになって、情けないパニック表情。\n\n鮫崎様の独創的なタッチで、\n「異形の魅力」と「情けないギャップ」を描いていただけたら最高に嬉しいです。\n\nご多忙とは存じますが、\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1VG9nNbqsJVcib52z57FuQGeaar5v067n", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samexxki/works/13", "privat