t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5eebfc5e0a52cf267e325d7944225f8, https://si.imgix.net/999c0866/uploads/origins/a84ddd21-d371-44c9-9248-2a6d75bbac26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dd113df0b156b45d3c31c2f17e3ddb4 2x, https://si.imgix.net/999c0866/uploads/origins/a84ddd21-d371-44c9-9248-2a6d75bbac26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfb8a1906b20d0944b77e872a282a1db 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/999c0866/uploads/origins/a84ddd21-d371-44c9-9248-2a6d75bbac26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66c3903e149caf4775872b34d46a68bb", "srcset": "https://si.imgix.net/999c0866/uploads/origins/a84ddd21-d371-44c9-9248-2a6d75bbac26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66c3903e149caf4775872b34d46a68bb, https://si.imgix.net/999c0866/uploads/origins/a84ddd21-d371-44c9-9248-2a6d75bbac26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81b7d08e7b2c11c7c6ff16cc1157330d 2x, https://si.imgix.net/999c0866/uploads/origins/a84ddd21-d371-44c9-9248-2a6d75bbac26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8af63d0d2468791e515e4448c576644a 3x"}, "body": "こんにちは！\n\nグランブルーファンタジーのナルマヤの黒蝶の衣装でお願いしたいです。お腹が大きく、おへそが出ている彼女のシナリオが欲しいのです。納屋で干し草の中に寝そべって、妊娠したお腹を露わにして、母親らしい表情で描いていただけませんか？あるいは、お腹が見えていれば、四つん這いになって機械でおっぱいを搾乳されている妊娠中の彼女を同じ設定で描くこともできる。彼女はお腹の中に馬の仔馬を抱えています。彼女のお腹の中で馬の仔馬が育っている様子を描いた別バージョンもお願いできますか？同じようなシナリオで最近行ったリクエストの参考資料も載せておきます。ご検討のほど、よろしくお願いいたします！\n\nナルマヤと衣装の参考文献\nhttps://drive.google.com/drive/folders/1LtPw_cCJIrkzhSACztIsA--7J0cGmMej?usp=sharing\n\n最近のリクエスト\nhttps://drive.google.com/file/d/1SrOTefGsNc5c1Zr6hHtB396_q_MDdx_U/view?usp=sharing\nhttps://drive.google.com/file/d/1XzIIa7Mfs-mKhdoPnV1cPRtuHKqDk9iM/view?usp=sharing", "nc"