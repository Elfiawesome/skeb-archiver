ut their intense fight while Selene struggles to hide her happiness at Gaile's growth. For the dinner scene, you are free to give Gaile simple clothes of your own choice. ^^\n\nhttps://drive.google.com/drive/folders/1CANdpmczGB2xngivklARaoOxAqcEjv2r?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NINJAiraibashi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3652355, "client_id": 1109203, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb085839/uploads/origins/18e1d68a-2f8a-4241-8c1e-fc7dbb37f540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da8de41bed779f1ec401090fd9639d8e", "srcset": "https://si.imgix.net/eb085839/uploads/origins/18e1d68a-2f8a-4241-8c1e-fc7dbb37f540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da8de41bed779f1ec401090fd9639d8e, https://si.imgix.net/eb085839/uploads/origins/18e1d68a-2f8a-4241-8c1e-fc7dbb37f540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb81503ee5a17e09a90467e28d23a784 2x, https://si.imgix.net/eb085839/uploads/origins/18e1d68a-2f8a-4241-8c1e-fc7dbb37f540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5630a57f83ae6f4ead790a07752d8240 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb085839/uploads/origins/18e1d68a-2f8a-4241-8c1e-fc7dbb37f540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=947c96cde8844c4ef1fa0c25460bc9bb", "srcset": "https://si.imgix.net/eb085839/uploads/origins/18e1d68a-2f8a-4241-8c1e-fc7dbb37f540?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=947c96cde8844c4ef1fa0c25460bc9bb, https://si.imgix.net/eb085839/uploads/origins/18e1d68a-2f8a-4241-8c1e-fc7dbb37f540?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=