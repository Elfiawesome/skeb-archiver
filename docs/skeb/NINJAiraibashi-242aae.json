gle.com/drive/folders/1cWdUQAL-jbdaSxA5Snp1XnrJvANj4yL2?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NINJAiraibashi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3652355, "client_id": 177290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d78ab5d07b9a3e7ca3c59835abf6c31", "srcset": "https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d78ab5d07b9a3e7ca3c59835abf6c31, https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5e1776046316b17b1425090770731e0 2x, https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f6cbf9d48818053d105d3a52cc6f0d1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2588b3c23436e1acadb6559da9f6751", "srcset": "https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2588b3c23436e1acadb6559da9f6751, https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec5603e4a8a47d3752024a9d03c82c6 2x, https://si.imgix.net/080c1f87/uploads/origins/a558ebd7-ad3b-466d-8394-3af302f7c304?bg=%23fff&auto=format%2Ccompress&