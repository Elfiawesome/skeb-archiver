0/uploads/origins/e6ce24ed-1c8b-41b5-89c3-8244d321ffe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8c49742f6cf30a604f5f858c7a293b4 2x, https://si.imgix.net/59de5eb0/uploads/origins/e6ce24ed-1c8b-41b5-89c3-8244d321ffe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32f1146b5a50c320e928c3fbdfa8213d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59de5eb0/uploads/origins/e6ce24ed-1c8b-41b5-89c3-8244d321ffe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5899705018b827719644a462e4c31409", "srcset": "https://si.imgix.net/59de5eb0/uploads/origins/e6ce24ed-1c8b-41b5-89c3-8244d321ffe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5899705018b827719644a462e4c31409, https://si.imgix.net/59de5eb0/uploads/origins/e6ce24ed-1c8b-41b5-89c3-8244d321ffe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d833d178adb48fd28553d83ef8ce34df 2x, https://si.imgix.net/59de5eb0/uploads/origins/e6ce24ed-1c8b-41b5-89c3-8244d321ffe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a7665de566bfc89a9f18d9b391d5f5d 3x"}, "body": "魔無 王罪様\n\nリクエスト失礼致します！\n先生の作品がすごく好きです、もしよろしければオリキャラ二人のイラストを描いていただきたいです。\n\nキャラクターの詳細な設定については、こちらのURLからご確認いただければと思います。\n可能でしたら、先生のご自由なイメージで二人のバンドパロを描いていただけたら嬉しいです！（男性はドラマー＆ボーカル、女性はベース担当です。）衣装や楽器は先生のオリジナルデザインでも、参考URLフォルダ内の原設定衣装でも大丈夫です。\nもし難しければ、原設定に沿った自由なイラストでももちろん問題ありません！キャラクターの印象や関係性に基づいて、自由に描いていただければと思います。\n\n没ラフや下描きなどがあれば残したままにしていただけると嬉しいです。不備な点がございましたら、お気軽にキャンセルまたは再送依頼のご対応をしてくださればと思います。\n依頼を読んでいただき、ありがとうございました...！ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1_ykl6Vf41Q6FPc6uHL3sEgag9JascwCF?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MTouzai/works/11", "private_thumbnail_image_urls": null, "private