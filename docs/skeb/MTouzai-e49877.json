ix.net/2655bcd2/uploads/origins/229014bd-fcc0-4420-8940-c9def5549c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8e101a18cb34f642f5f893295add57f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2655bcd2/uploads/origins/229014bd-fcc0-4420-8940-c9def5549c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55ea5dab7c12fc9178ba3913bb5231b8", "srcset": "https://si.imgix.net/2655bcd2/uploads/origins/229014bd-fcc0-4420-8940-c9def5549c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55ea5dab7c12fc9178ba3913bb5231b8, https://si.imgix.net/2655bcd2/uploads/origins/229014bd-fcc0-4420-8940-c9def5549c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6718ee293d0aa895b46b06fa5b070f94 2x, https://si.imgix.net/2655bcd2/uploads/origins/229014bd-fcc0-4420-8940-c9def5549c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8760b8a5953a932ab9151253a9623df 3x"}, "body": "こんばんは！\n魔無 王罪さんの描かれる絵柄とスタイリッシュな構図のイラストが大好きです！この度は是非とも魔無 王罪さんの作風でTRPGのOCを描いて頂きたくリクエストに参りました。（資料内ネタバレはありません）\n\n▼詳細\n目元に影のある大柄な軍人×美しく自由奔放なサーカス団団長。\n大きな飼い犬と飼い主のような関係性です。\n\n◆軍人\n髪／赤\n瞳／ターコイズ、目元は影がかかっている\n30歳。195cm。陸軍大尉。\n武器はハルバード。\n圧はあるが中身は礼儀正しく真面目な軍人気質。\n戦闘時は血気盛んではあるが、他人の指示を聞ける程度の理性はある。\nベルンを愛しており、自然と隣に立っていたり守ったりと大型犬のようなイメージがある。\n非常に力が強く、血が似合う。\n首輪を付けられど飼い慣らされるつもりはなく、ベルンが自分の身を犠牲にしようとするならば、逆に手綱を引くことができる。\n\n◆サーカス団-団長\n髪／金髪に白のインナー、後ろ髪は斜めぱっつん\n瞳／金色のマーブル\n32歳。180cm。\n武器はサーベル。\n自身が経営するサーカス団の団長。自由奔放で声が大きい。\n人並外れた美貌を持っており、自分は愛されるべきで他人も自分から愛されるべきだと考えている。\n初対面でも親しいと感じた相手のことは「団員」扱いし、皆に愛を分け与える。\n実際は死んだ眩い兄を演じており、弟である本質は寂しがりやで不安定、愚かであどけなくて傲慢。眩く輝き、皆を取り込み離さない光。（弟である一面は表に出さないよう振る舞う）\n\n▽モチーフ等\n・サーカス、血、薔薇、火星と金星\n\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いていただいても、好きな服を着せてもらっても構いません！\n魔無 王罪さんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います！\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か金額等失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1McTbG_V5SCrO3xKKTDomsm9pTosTvJhn?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1764613, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "大倉ねろた🛸", "screen_name": "nero_okura", "avatar_url": "https://pbs.twimg.com/profile_images/1775078653828960256/-r_gmcYF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1451443549682077705/1686147977/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1971762, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "N", "screen_name": "nnhr07", "avatar_url": "https://pbs.twimg.com/profile_images/2009585775005069312/c_75axll.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1440209384424939523/1663992229/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 128}, {"id": 2541821, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヤマ", "screen_name": "yama_ym0000", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F5624cbbd-150f-478a-a3e4-8e4255d82e8c.jpg&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/2f2fbd3e-e40e-4d2d-8de8-d619d825c57e.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration