かであどけなくて傲慢。眩く輝き、皆を取り込み離さない光。（弟である一面は表に出さないよう振る舞う）\n\n▽モチーフ等\n・サーカス、血、薔薇、火星と金星\n\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いていただいても、好きな服を着せてもらっても構いません！\n魔無 王罪さんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います！\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か金額等失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1McTbG_V5SCrO3xKKTDomsm9pTosTvJhn?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 400738, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "25キメラ⛧️Busy,,,✍️", "screen_name": "25_Kimera", "avatar_url": "https://pbs.twimg.com/profile_images/1742126801386954753/gEBPUUU9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2922595374/1645912010/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 492924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "エイゴニ", "screen_name": "eisuri", "avatar_url": "https://pbs.twimg.com/profile_images/1262578213672202246/VMjpGqpK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/801718896881324032/1591199555/1500x500", "appeal_receivable": false, "popular_creator_rank": 48, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1198454, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "宇都屁ぷ", "screen_name": "udohepu", "avatar_url": "https://pbs.twimg.com/profile_images/1303050676260413442/RiDeEK6R.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4913519827/1690934804/1500x500", "appeal_receivable": true, "popular_creato