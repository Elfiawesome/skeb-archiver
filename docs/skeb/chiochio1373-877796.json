t=OwXBcU4AhzOf552pMvN3EQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chiochio1373/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4edd4965c6b9b12a99c3a239b1171d97", "srcset": "https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4edd4965c6b9b12a99c3a239b1171d97, https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f518a83dd2678c6cb34102c1b7c20537 2x, https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=398de71ca2cd16afd4fad72866b9557f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3187af90af973bf2d2a4afb43d2ef24b", "srcset": "https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3187af90af973bf2d2a4afb43d2ef24b, https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a1d70b4cdaf3a3033dff955a0cf8ace 2x, https://si.imgix.net/aaa0a935/uploads/origins/33fd3cc4-1939-4d6d-9ad2-621b274c3e94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb3a8b740e2a89cf18dc7c4a2ae451cf 3x"}, "body": "ちお様\n\n初めまして。\nVTuber準備中の泡雪むたと申します。\n素敵なイラストをお見かけして、私のイラストを描いていただきたいと思いリクエストさせていただきます。\n\n以下がわたしの詳細となります。\n\n名前:泡雪むた\nモチーフ:雪、リボン、レース\n姿やロゴ等のイメージ:https://drive.google.com/drive/folders/1GAVFEeCHiMWbVpqXYMpisOoqF7drNgOi\n細かい容姿：向かって右上のお口に八重歯が生えているため、口を開ける表情を描写される際にはご注意ください。\n構図やポーズ：おまかせしますが、髪の毛・上と右左が見切れない形ですと嬉しいです。\n\n納品形式：人物とそれ以外がレイヤー分けされたPSD希望ですが、不可の場合全体PNGと人物以外透過PNGを共にいただきたいです。\n使用媒体：YouTubeやTwitchやツイキャス、X等SNSでの使用となります。(配信サイト収益化予定)\n用途：VTuber活動全般での使用。サムネ、動画や配信内、メンシプ、Xでの宣伝・おはV等のポストで使用予定です。\n\n \nもし追加料金必要なようでしたら再送要請いただけますと幸いです。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1GAVFEeCHiMWbVpqXYMpisOoqF7drNgOi", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chiochio1373/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3496010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b87e7305/uploads/origins/a5e60f4b-92f7-479b-9266-5150f90207d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe4a61475653872b4cfb48b48e3752e", "srcset": "https://si.imgix.net/b87e7305/uploads/origins/a5e60f4b-92f7-479b-9266-5150f90207d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abe4a61475653872b4cfb48b48e3752e, https://si.imgix.net/b87e7305/uploads/origins/a5e60f4b-92f7-479b-9266-5150f90207d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03733b0d619ac2cdd484266798c84c0e 2x, https://si.imgix.net/b87e7305/uploads/origins/a5e60f4b-92f7-479b-9266-5150f90207d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cfe3ba19bb5be6fb9630aaa6dc96646a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b87e7305/uploads/origins/a5e60f4b-92f7-479b-9266-5150f90207d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=