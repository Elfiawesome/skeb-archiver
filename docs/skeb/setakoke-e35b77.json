\u30b9\u30a2\u30f3\u30bd\u30ed\u30b8\u30fc\u3092\u62dd\u898b\u3057\u304a\u8a71\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30c7\u30b6\u30a4\u30f3\u3001\u7d75\u67c4\u306e\u3069\u308c\u3082\u3068\u3066\u3082\u597d\u304d\u3067\u3001Skeb\u3092\u4f9d\u983c\u3057\u306b\u53c2\u308a\u307e\u3057\u305f\u2026\uff01\n\u500b\u4eba\u7684\u306b\u304a\u307e\u308f\u308a\u3055\u3093\u306e\u6027\u683c\u3084\u30c7\u30b6\u30a4\u30f3\u5927\u597d\u304d\u3067\u3059\u2026\uff01\uff01\n\n\u4eca\u56de\u306eOC\u306fTRPG\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u306a\u308a\u307e\u3059\u3002(\u30cd\u30bf\u30d0\u30ec\u306f\u3042\u308a\u307e\u305b\u3093)\n\u81ea\u5206\u3068\u76f8\u65b9\u69d8\u306e\u63a2\u7d22\u8005\u3067\u3001\u8a31\u53ef\u306f\u9802\u3044\u3066\u3044\u307e\u3059\u3002\n\n\u3010\u4f7f\u7528\u76ee\u7684\u3011\n\u30fb\u500b\u4eba\u7528\u9451\u8cde\n\u30fb\u30a2\u30af\u30b9\u30bf\u306a\u3069\u306e\u30b0\u30c3\u30ba\u4f5c\u6210(\u975e\u5546\u7528)\n\u30fbSNS\u30a2\u30a4\u30b3\u30f3\u3084\u30d8\u30c3\u30c0\u30fc\u3078\u306e\u4f7f\u7528(\u500b\u4eba\u306e\u307f)\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u3064\u3044\u3066\u3011\n\u300c\u5893\u7a74\u306b\u7d0d\u307e\u308b\u300d\u3068\u3044\u3046\u30b7\u30ca\u30ea\u30aa\u306eOC\u306b\u306a\u308a\u307e\u3059\u3002\u4e16\u754c\u89b3\u3068\u3057\u30661950~1980\u5e74\u9803\u3067\u3001\u7537\u5973\u95a2\u4fc2\u306a\u304f\u7d50\u5a5a\u3068\u3044\u3046\u6982\u5ff5\u304c\u5b58\u5728\u3057\u307e\u3059\u3002\n\n\u30fb\u8a2d\u5b9a(CS\u629c\u7c8b)\n\u30d9\u30f3\u30b8\u30e3\u30df\u30f3\u30fb\u30de\u30f3\u30c1\u30cb\u30fc\u30eb\n24\u6b73/\u7537/188cm/\u592b\n\u81ea\u5206\u306b\u81ea\u4fe1\u304c\u3042\u308b\u30bf\u30a4\u30d7\u306e\u6027\u683c\u3002\u306a\u306b\u304b\u3068\u6109\u5feb\u305d\u3046\u306b\u3044\u3064\u3082\u7b11\u3063\u3066\u3044\u308b\u3002\n\u666e\u6bb5\u306f\u559c\u6012\u54c0\u697d\u304c\u3057\u3063\u304b\u308a\u3042\u308b\u304c\u3088\u304f\u308f\u3056\u3068\u3089\u3057\u3044\u3068\u8a00\u308f\u308c\u3066\u3057\u307e\u3046