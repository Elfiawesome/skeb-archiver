，還可以看到肚腩）\n背景天空的顏色就像艾爾登法環，碎星場境的微紅色天空\n\n天空上原本應該存在的月球變成巨大的卵子，而且被精子包圍著，被受精就只是時間問題，位置大約在少女頭頂的正上方\n\n少女的外觀：\n有超長的頭髮、白頭髮\n眼睛的顏色 ：左邊黃色 右邊紅色\n身材高度偏高、巨乳、乳暈範圍偏大\n\n表情：\n無表情，但其中一邊的眼睛（左眼）正在流淚\n\n簡單來說比較象是少女站在自己的子宮裏，頭頂上自己的卵子正被侵犯受精的感覺，像已經遇上不想回憶的可怕的事（被強暴）封閉自己的心，無法阻止一切發生，最後最壞最壞（受精、妊娠、懷孕）的事情也沒法阻止，最後的感情順著最後的眼液落下\n\n謝謝！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shrimp_cc/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 12618, "client_id": 57223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff069747/uploads/origins/f87762da-0414-45c3-82b5-d768388585af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab1eeea174aa6c4e1b06ac8a56ef16f6", "srcset": "https://si.imgix.net/ff069747/uploads/origins/f87762da-0414-45c3-82b5-d768388585af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab1eeea174aa6c4e1b06ac8a56ef16f6, https://si.imgix.net/ff069747/uploads/origins/f87762da-0414-45c3-82b5-d768388585af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ce7ce1ec5d7f66937c1e3f6ccbac3fd 2x, https://si.imgix.net/ff069747/uploads/origins/f87762da-0414-45c3-82b5-d768388585af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4d910b5a95cb923c7745db92b7a945e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff069747/uploads/origins/f87762da-0414-45c3-82b5-d768388585af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ab068c8a1088b04747e1374624fe76a", "srcset": "https://si.imgix.net/ff069747/uploads/origins/f87762da-0414-45c3-82b5-d768388585af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ab068c8a1088b04747e1374624fe76a, https://si.imgix.net/ff069747/uploads/origins/f87762da-0414-45c3-82b5-d768388585af?bg=%23fff&auto=f