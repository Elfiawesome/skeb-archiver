いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でneri様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、森の中を散歩のように歩いてるのがみたいです。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neri918/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 476463, "client_id": 1089374, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bd43452/uploads/origins/d081a44b-f92f-4e84-90cc-1e226d240793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb08637ef83a2a6e8cfd92d98f7eba56", "srcset": "https://si.imgix.net/5bd43452/uploads/origins/d081a44b-f92f-4e84-90cc-1e226d240793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb08637ef83a2a6e8cfd92d98f7eba56, https://si.imgix.net/5bd43452/uploads/origins/d081a44b-f92f-4e84-90cc-1e226d240793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67537be996a9dde6a52d4ac7a30e1b61 2x, https://si.imgix.net/5bd43452/uploads/origins/d081a44b-f92f-4e84-90cc-1e226d240793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a20d9da2eb62bd650cc40621673b6a17 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bd43452/uploads/origins/d081a44b-f92f-4e84-90cc-1e226d240793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afb57a13cec1073821accffd28fed969", "srcset": "https://si.imgix.net/5bd43452/uploads/origins/d081a44b-f92f-4e84-90cc-1e226d240793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afb57a13cec1073821accffd28fed969, https://si.imgix.net/5bd43452/uploads/origins/d081a44b-f92f-4e84-90cc-1e226d240793?bg=%23fff&auto=forma