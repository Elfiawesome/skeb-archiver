-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86c5d5a509240668542d3a8d4a040b85", "srcset": "https://si.imgix.net/9e69a861/uploads/origins/4283051c-00e4-4704-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86c5d5a509240668542d3a8d4a040b85, https://si.imgix.net/9e69a861/uploads/origins/4283051c-00e4-4704-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52c07815db1ee85cff91248664ef6333 2x, https://si.imgix.net/9e69a861/uploads/origins/4283051c-00e4-4704-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=519b168bdacdf4f1237dbeb2b37b3e6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e69a861/uploads/origins/4283051c-00e4-4704-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a8e6de65ff7cdedc43fb9f3302d2e5", "srcset": "https://si.imgix.net/9e69a861/uploads/origins/4283051c-00e4-4704-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a8e6de65ff7cdedc43fb9f3302d2e5, https://si.imgix.net/9e69a861/uploads/origins/4283051c-00e4-4704-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b559d8487e415df8ecbdda1a850ff19 2x, https://si.imgix.net/9e69a861/uploads/origins/4283051c-00e4-4704-9c72-e9e1a92d8000?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=054ff4bf4b53aad67fc10f42fa4b15b3 3x"}, "body": "RubisCO様のアズールレーンイラストが好きなのでリクエストします\n\nアズールレーンのZ11(https://x.com/azurlane_staff/status/1868936672043561326)\nを描いてほしいです。\n\nZ11の衣装チェンジという内容で描いてほしいです。\n\n詳細は以下の通りです。\nZ11は同作品のセントーの服を着ている\n\nそんなZ11は右手と右腕を使って、着衣胸元部分を上からおさえている\n\n左手はスカートをおさえている。\nその左手の薬指にはケッコン指輪がついている\nケッコン指輪参考：https://x.com/azurlane_staff/status/918013882622394368\n\n\nセントーの服着たZ11はとても恥ずかしがっており\nZ11の顔は赤く、グルグル目で涙目\n顔からは湯気のようなものがでている。\n内股で全身震えて\n全身からは大量の汗をかいて\n顔の汗は両頬を伝って、あご下まで垂れている  \n\n余談ですが、スカート回りにあるヒラヒラを描き忘れないでほしいのと\n膝位置まで正面から見た構図で描いてほしいです\n\nセントー服参考\n\nhttps://x.com/azurlane_staff/status/1030363975941152769", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RuBP_carboxy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3657400, "client_id": 2190412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450166fc1e6abc59cd8094452ed39ab7", "srcset": "https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=450166fc1e6abc59cd8094452ed39ab7, https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1961082381e65e2a8dad92ac64dbf2a3 2x, https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5dba1631ded0979924c6163f911e430 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0986d679c96e8ead0844cd079f1efa0d", "srcset": "https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0986d679c96e8ead0844cd079f1efa0d, https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=733b7ee648e84bf2a4f955ea7ca27eb4 2x, https://si.imgix.net/2b0bae38/uploads/origins/6478f630-cb77-424e-8cdb-6269e9f8441c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9da8d53a9f08bf96e1900d7f16ff9c1a 3x"}, "body": "RubisCO様のイラストを素晴らしいと思い、リクエストします。\n\nアズールレーンのジャーヴィスちゃんを描いてほしいです。\n\nジャーヴィスちゃんの衣装はデフォルト\n\n顔は赤くなって、目線をそらして照れ隠しの表情\n顔からたくさんの汗をかいている。\n\n彼女は左手の人差し指に髪の毛をクルクル巻いて\n右手でスカートを抑える仕草をしている。\n\nそんな彼女を正面から見た図で\nスカート下まで描いてほしいです。\n\n補足ですが、ジャーヴィスの帽子は実装当時から修正されており\n帽子は修正版のデザインでお願いします。\nジャーヴィス立絵\n\nhttps://azurlane.wikiru.jp/?plugin=attach&refer=%E3%82%B8%E3%83%A3%E3%83%BC%E3%83%B4%E3%82%A3%E3%82%B9&openfile=%E3%82%B8%E3%83%A3%E3%83%BC%E3%83%B4%E3%82%A3%E3%82%B9%E4%BF%AE%E6%AD%A3.jpg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 756, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "墨ノ村☕︎", "screen_name": "nashiki_053", "avatar_url": "https://pbs.twimg.com/profile_images/1939372494890082304/aBWu19Rd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/847496873354997761/1660367558/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 25}, {"id": 1137983, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Mlko A1fnad", "screen_name": "ooke", "avatar_url": "https://pbs.twimg.com/profile_images/1995860623469514752/OCeOeEIp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1374026715895275526/1764684698/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": 