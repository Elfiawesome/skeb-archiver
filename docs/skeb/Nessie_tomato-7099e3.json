/1185556093826547718?s=46\n\nフレン1(衣装は、下の画像のどちらでも描きやすい方で大丈夫です。)\nhttps://x.com/kokomaruextfsss/status/1757773890393358673?s=46\nフレン2\nhttps://x.com/furen_2434/status/1606979303010619393?s=46\n\nリアクション参考動画\nhttps://twitter.com/OCHtldYikXvgVmy/status/1687014070116036608?s=20\nリアクション参考動画2\nhttps://twitter.com/OCHtldYikXvgVmy/status/1687014604768223232?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 59927, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "せいしろ", "screen_name": "seishiro830", "avatar_url": "https://pbs.twimg.com/profile_images/1157630090345189376/7zVrwyoG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1123640098191396864/1573268723/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 176}, {"id": 82892, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おぐも🔞", "screen_name": "Contrail_mk1", "avatar_url": "https://pbs.twimg.com/profile_images/2041524807075016704/Du3BOf06.jpg", "header_url": "https://pbs.twimg.com/profile_banners/766531241394921472/1775570522/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 161}, {"id": 219708, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "超暇神Ｚ", "screen_name": "gnk4649", "avatar_url": "https://pbs.twimg.com/profile_images/1980968108996149248/JK1JioTD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/998995199773691905/1567631847/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request