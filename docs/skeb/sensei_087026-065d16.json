いうちに触手に肉体改造され膨乳化した乳房や股間\n全身をめちゃくちゃに犯されているというものになります\nアスモデウス自身は自分が酷い目に遭っているなど想像もしておらず、\n落とし穴にハマったことに困っているだけというイメージです\n服装はソシャゲキャラなので資料には進化別外見、アレコス等がありますが\n破られて胸と股間が露出している感じならどんな資料にとらわれず\nどんな衣装でも構いません(下着や全裸などでもOKです)\nまた差分として感覚遮断が解除されて無様にアクメを晒して絶頂する描写もお願いしたいです\n\n以上が依頼内容になりますが、筆が乗るように自由にやって頂いて構いません。\nヒールなしで186cmの態度も尻もデカい銀髪爆乳デカ乳筋肉質汗臭なアスモさんを題材に、\n是非先生にえっちな雰囲気マシマシのイラストを描いていただきたい！という主旨のリクエストになります。\nアレンジ大歓迎です！\n\nお忙しい中とは存じますが、ご一考の程宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ilC97vq9s5v4zgq15MmU5muX8DcmWyyX?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sensei_087026/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1589521, "client_id": 860653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f08636a0/uploads/origins/bc24dcb8-6ab0-41a9-9179-b2fe9f67c502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c54a6a5e45f00fe9371c1a5fab13c68e", "srcset": "https://si.imgix.net/f08636a0/uploads/origins/bc24dcb8-6ab0-41a9-9179-b2fe9f67c502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c54a6a5e45f00fe9371c1a5fab13c68e, https://si.imgix.net/f08636a0/uploads/origins/bc24dcb8-6ab0-41a9-9179-b2fe9f67c502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65b9efa846625ee39660965aa635896e 2x, https://si.imgix.net/f08636a0/uploads/origins/bc24dcb8-6ab0-41a9-9179-b2fe9f67c502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d47563e8aae03878b849c2d6d5730d1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f08636a0/uploads/origins/bc24dcb8-6ab0-41a9-9179-b2fe9f67c502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dc4d2c5c421cf772b7f9b33238b3075", "srcset": "https://si.imgix.net/f08636a0/uploads/origins/bc24dcb8-6ab0-41a9-91