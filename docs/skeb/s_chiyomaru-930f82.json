いくらでも待てます！！！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AyA42lIEYHJb57QXgG4GJmVEKRWks3KW?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_chiyomaru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3089145, "client_id": 2845552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-22fd8766242e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd073ffcd8a017dcf2ddc0d182e61bed", "srcset": "https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-22fd8766242e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd073ffcd8a017dcf2ddc0d182e61bed, https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-22fd8766242e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79af290a195c4f720005247f47645082 2x, https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-22fd8766242e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=525e8ca640376555bff35efd439de1f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-22fd8766242e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=602e5d98c67e668363bacf884e183b0e", "srcset": "https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-22fd8766242e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=602e5d98c67e668363bacf884e183b0e, https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-22fd8766242e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b1b12a5ca7084adaefb54d71388303e 2x, https://si.imgix.net/a4117aea/uploads/origins/ee51bfea-5638-4afd-bf08-