igins/25cfede1-44ad-43e6-ba08-1207d4bff535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e05e3760a83d0bc87c0929ae4f7f754 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9775007/uploads/origins/25cfede1-44ad-43e6-ba08-1207d4bff535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f08594c54020eb0b04a6c185fa53af3", "srcset": "https://si.imgix.net/e9775007/uploads/origins/25cfede1-44ad-43e6-ba08-1207d4bff535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f08594c54020eb0b04a6c185fa53af3, https://si.imgix.net/e9775007/uploads/origins/25cfede1-44ad-43e6-ba08-1207d4bff535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f45179b0cb5b09f600eb9d5a61236181 2x, https://si.imgix.net/e9775007/uploads/origins/25cfede1-44ad-43e6-ba08-1207d4bff535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4afb5c50a3c9a65cf55494417e0211a 3x"}, "body": "登場人物原初マルゼノ（セメ、兄）♂×マルゼノ（ウケ、弟）♂。\n\nテーマヤンデレ、近親相姦、逆レイプ\n\nストーリーキュリアの感染により、マルゼノは兄への愛情を欲望へと変質させてしまった。歪んだ精神状態のマルゼノは、原初のマルゼノを自分の伴侶にしようと考え、そのためには手段を選ばない。マルゼノは、兄の精子を受ければ永遠に自分の伴侶になると信じている。弟に正気に戻ってほしいというマルゼノの願いは聞き入れられない。\n\n構図：マルゼノに拘束された原初マルゼノが騎乗位でセックスをする。マルゼノは淫らな表情を浮かべ、原初マルゼノはマルゼノにやめてくれと懇願しているような表情をしている。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chemical_lulu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2857083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6faf1c9c1c21e32724df79f01ac37798", "srcset": "https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6faf1c9c1c21e32724df79f01ac37798, https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28300ca1e89a6cbfaa606b9c3a0a927b 2x, https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66ddc17a8ad6bd71d737869b6b987164 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e718adac7e10a073d1a7b47ae49bd4ec", "srcset": "https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e718adac7e10a073d1a7b47ae49bd4ec, https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e97ffa53a1e40ca0e9ecc0246eef39a 2x, https://si.imgix.net/182e9fa7/uploads/origins/90b366bc-d760-450c-8b4d-5058e3a3ea12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=666e9e522c3525cf3449c0e8b91c0551 3x"}, "body": "初めまして。ニッチなシチュエーションで失礼しますがリクエストさせていただきます！\nモンスターハンターライズにてヨツミワドウに丸呑みされるうちの子ハンターをお願いします。\n\n【内容】\nこちらの画像（https://i.imgur.com/LKm3NIU.png）のようにヨツミワドウが大口を開けながらハンターを口の中に掻き込んでいるシーンをお願いします。\n具体的な構図はお任せしますが、ハンターは顔と両腕がヨツミワドウの喉奥から出ている状態（足から呑み込まれているイメージ）で、両腕を伸ばし「ヤバい！」というような焦りと恐怖を感じているような表情でお願いします。\n表情を描くのが難しかったり大変だったりする場合はヨツミワドウの舌などで顔が隠れている構図でも大丈夫です。（舌に押しつぶされている構図も好き好き）\n\nまた上記のシチュエーションを描くのが難しかったり大変だったりするようでしたら、こちらのイラスト（https://i.imgur.com/LEakPDe.jpg ※以前同じようなリクエスト内容で描いていただいたイラストです。）みたいな感じで膨れたお腹の中にハンターが窮屈そうに閉じ込められている様子が透過で映し出されたようなシチュエーションでも大丈夫です。\n\n背景はお任せします。単色でも大丈夫です。\n\nその他差分等はお任せします。\n\n【ハンターデザインの参考資料】\nhttps://i.imgur.com/ZwxgOjN.png\nヨツミワドウもですが、細かいところまでキャラクターデザインを再現しなくて大丈夫です。\n分からない部分は省略・簡略化してください。\nくりぷとんさんの画風で描きやすいようにお願いします。\n\n情報不足等ありましたら申し訳ないですが、よろしくお願いします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chemical_lulu/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/602b4b42/uploads/origins/776f1f7d-b6ee-4663-9ed2-3322cd3e48cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13fce034265659a6666262ee37f57399", "srcset": "https://si.imgix.net/602b4b42/uploads/origins/776f1f7d-b6ee-4663-9ed2-3322cd3e48cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13fce034265659a6666262ee37f57399, https://si.imgix.net/602b4b42/uploads/origins/776f1f7d-b6ee-4663-9ed2-3322cd3e48cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e49ca89f80cbde84476202775d9e716 2x, https://si.imgix.net/602b4b42/uploads/origins/776f1f7d-b6ee-4663-9ed2-3322cd3e48cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c71b31612428770c6754b2bb75df110 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2857083, "nc": 161}, {"path": "/@chemical_lulu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2857083, "client_id": 251120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50c7290e/uploads/origins/efb867e9-8971-486d-9f22-cac764700460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bcd935522437bb363ba6f977775ddcc", "src