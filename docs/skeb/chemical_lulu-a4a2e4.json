urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2857083, "client_id": 121731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82be97397c6b274a68775b4142d2cd74", "srcset": "https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82be97397c6b274a68775b4142d2cd74, https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da324fa13fe9d16c5118e6e31ab4886c 2x, https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0541151ed3bab23a71fc76b7a93477d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f39823ed6aae6ec0cc3b88df872c7810", "srcset": "https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f39823ed6aae6ec0cc3b88df872c7810, https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1efddb6e3f276abf5504baabd79f2335 2x, https://si.imgix.net/1cc1f73f/uploads/origins/c5089434-4e94-409c-8227-dcaf6fc1e171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c23aad065c4617b78ced4b7808a955d 3x"}, "body": "フォロー外から失礼します。\nいつも素敵なメルゼナやイヴェルカーナのイラストを拝見させていただいております。\nくりぷとん様の描かれるメルゼナの目の雰囲気がとりわけ好きです。\n\nくりぷとん様の絵柄でうちのOCの竜人/竜を描いていただきたくリクエストをさせていただきます。\n竜人姿or竜の姿、構図、シチュエーションなどお任せしますので自由に描いていただければと。\n以下設定です。\n\n・見た目20代後半。竜と獅子型魔獣のハーフ。\n・竜人姿で身長2m～4m超え。可変。竜姿もサイズは5m~とまちまち、大きさご自由に。\n・魔王(の血族)。徒手空拳と爆炎魔術を扱う。\n・理知的で寡黙。威風堂々。\n\n以上、よろしくお願いします。\n\nhttps://www.dropbox.com/sh/lk0yj6orpksg8op/AADy9JVglsnqFdN2Q3y2CxSZa?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chemical_lulu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2857083, "client_id": 1577895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f08523fc/uploads/origins/a04b7e75-5b04-4ee0-84ce-9ccdd1477f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c4cd616aa99e5b6cf87e70cb03898fe", "srcset": "https://si.imgix.net/f08523fc/uploads/origins/a04b7e75-5b04-4ee0-84ce-9ccdd1477f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c4cd616aa99e5b6cf87e70cb03898fe, https://si.imgix.net/f08523fc/uploads/origins/a04b7e75-5b04-4ee0-84ce-9ccdd1477f25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8269a540d153f22cc68c42a717fc876f 2x, https://si.imgix.net/f08523fc/uploads/origins/a04b7e75-5b04-4ee0-84ce-9ccdd1477f25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c93bd74fc97a0e1f87febc7ab8de05a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f08523fc/uploads/origins/a04b7e75-5b04-4ee0-84ce-9ccdd1477f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23ca703e5e85e476d09919fc505ee46d", "srcset": "https://si.imgix.net/f08523fc/uploads/origins/a04b7e75-5b04-4ee0-84ce-9ccdd1477f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23ca703e5e85e476d09919fc505ee46d, https://si.imgix.net/f08523fc/uploads/origins/a04b7e75-5b04-4ee0-84ce-9ccdd1477f25?bg=%23fff&auto=format%2Ccompres