n\n\n以上をお願いします。\nお忙しい中恐れ入りますが検討をお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sairuikan/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2348822, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=591a0bbd8fe265c80c7f0e5b620642d9", "srcset": "https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=591a0bbd8fe265c80c7f0e5b620642d9, https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9531d95fa97bc00ebef85feb519851f9 2x, https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e0154af92b018c76953bf6c2ae8dc6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8dfd30a4ddc9d9dd9bfb88be992f7bc", "srcset": "https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8dfd30a4ddc9d9dd9bfb88be992f7bc, https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f7a835c46d76928d60a785573ad8799 2x, https://si.imgix.net/02946200/uploads/origins/9f1aecfb-7a1d-47ad-a2f9-e03e212a1c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64ee5e2a771afe871ea52fbf8b7d0014 3x"}, "body": "りゅーかありる様へ、突然の連絡失礼します。\n以前リクエストしてこちらの都合でキャンセルした者です。\nその際は失礼しました。\n何度もリクエストして申し訳ないのですが、よろしければ確認お願い致します。\n\nキャラクター\nVOICEROID琴葉茜、葵\n身長160程、120超-60程-90程のイメージ\n茜はゲームヴァンパイアシリーズのリリスのコスプレ\n葵は同モリガンのコスプレ\n髪色と髪型は琴葉カラーのまま\n背中の翼は大きめでお願いします\n実際に淫魔化していて頭と背中の翼は本物のイメージ\n茜はぽわぽわ優しい、葵は落ち着いていて優しい性格のイメージ\nでお願いします\n\n詳細\n琴葉姉妹がマスターの男性(2人より長身)を籠絡しようと自身を淫魔化させて襲うシチュで姉妹交互に騎乗位\n着衣のままペタン座りの騎乗位で腰を振らずに膣内の刺激だけで水溜まりが出来るくらい大量射精させている状態\n茜は射精させるのが楽しいという感じで、葵は男性を気持ち良くさせようと丹念に快楽を与える感じ\n姉妹は優しげな笑顔のまま余裕綽々で男性は異常な快楽で痙攣状態\n騎乗位してない方は男性を膝枕して優しく頭を撫でている、という感じでお願いします\n\n\n以上をお願いします。\n恐れ入りますがご検討お願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sairuikan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2348822, "client_id": 3282056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f707c46b/uploads/origins/99cf2505-c615-4930-925f-747d04ce2fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d747caa2b3f2b9fa9e2885b333da178", "srcset": "https://si.imgix.net/f707c46b/uploads/origins/99cf2505-c615-4930-925f-747d04ce2fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d747caa2b3f2b9fa9e2885b333da178, https://si.imgix.net/f707c46b/uploads/origins/99cf2505-c615-4930-925f-747d04ce2fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58639c97d333832c4745468ba6bf6c63 2x, https://si.imgix.net/f707c46b/uploads/origins/99cf2505-c615-4930-925f-747d04ce2fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de3eed368c76c8a5685ab545e9ef0f0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f707c46b/uploads/origins/99cf2505-c615-4930-925f-747d04ce2fa3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a6928381c00f6fc8503374104d489c0", "s