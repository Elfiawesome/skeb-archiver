ins/f9288c08-f91a-4a5c-910a-16bef93a29f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a39df5cc6a7b75490a407e1128580781, https://si.imgix.net/611751df/uploads/origins/f9288c08-f91a-4a5c-910a-16bef93a29f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f01ac9dcc60f8ff45b20929c233898a2 2x, https://si.imgix.net/611751df/uploads/origins/f9288c08-f91a-4a5c-910a-16bef93a29f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a196c9598c984b305a3cf363e6d30e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/611751df/uploads/origins/f9288c08-f91a-4a5c-910a-16bef93a29f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e99a726d816ede8971b0527dc423348", "srcset": "https://si.imgix.net/611751df/uploads/origins/f9288c08-f91a-4a5c-910a-16bef93a29f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e99a726d816ede8971b0527dc423348, https://si.imgix.net/611751df/uploads/origins/f9288c08-f91a-4a5c-910a-16bef93a29f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2db1ce9422ad433bef319d20b9640183 2x, https://si.imgix.net/611751df/uploads/origins/f9288c08-f91a-4a5c-910a-16bef93a29f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53ecedb352cdb79fa9c21858aa3acc85 3x"}, "body": "ちっちゃいお人形のような可愛いミニキャラが目に止まりました。\n私のMMOのアバターキャラクターを描いて欲しいです。\n\n\n■全体イメージ\n資料フォルダの女の子のイラストを、下記URLの作品のようなチビスタイルでお願いします。\n左上のイラストと似たポーズ・表情をベースにしたものが欲しいです。\nhttps://skeb.jp/@5UDLkZpHzqSn9Hi/works/14\n\n衣装ですが、サブフォルダにある「衣装Ａ」「衣装Ｂ」の２パターンで制作をお願いします。\n絵柄や描きやすさに合わせて衣装のアレンジ・簡略化はもちろんOKです。\nなお衣装Ａについては、キャラシートご参照の上、二の腕の布は不要なのと、頭のリボンも白色という２点にご注意いただければ幸いです。\n\nまた、こちらの金額内で表情差分・ポーズ差分・ぬいぐるみ（小物）の追加など可能でしたら、ご対応可能な範囲でお願いできるととても嬉しいです。\nご可能の場合、内容はすべてお任せします。\n\n\n■キャラクターについて\nふわふわした優しい雰囲気でたまに天然です。\nファンタジーの世界で魔導書を武器に戦うヒーラー職をしています。\n\nツリ目・ツリ眉はＮＧで、瞳はピーコック色、髪は紫ががった赤色です。※茶髪ではありません。\n人外で人のような耳はなく、ツノ・尻尾・鱗があります。\n尻尾はスカートの下から出ているように描いてください。\nツノの形のイメージがつきにくい場合は、資料内のイラストや「FF14 アウラ 前角」で画像検索をお願いします。\n\n\n■作品について\n観賞用です。\nデータ形式はPSDで、キャラと背景でレイヤーを分けたものを一緒にいただきたいです。\n\n\nなお、もし過去作品のクライアント様の書かれていた懸念事項（絵柄の適用範囲）的に私のキャラクターがNGでしたら、ご遠慮なくキャンセルをお願いします。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1_4BpmR-L9RauQg1nMPP3I81daWUS7uA1?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5UDLkZpHzqSn9Hi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 539423, "client_id": 2721225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ba081aab22fe9487a69a17dccb59b5", "srcset": "https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24ba081aab22fe9487a69a17dccb59b5, https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84666ab3d0e531c0012af77c1dc7162e 2x, https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e65c269e5697cc9826b31e40ca9d992a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0979072ebc3acbfd82969d84eefe0c27", "srcset": "https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0979072ebc3acbfd82969d84eefe0c27, https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e6fe687aa0c7383b275215c4e6b9e0c 2x, https://si.imgix.net/da762b27/uploads/origins/47794de4-d068-4ed6-bf20-09c39b55d48b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a1ff947e88c5c5ee9501e37a73047df 3x"}, "body": "まぁまぁ様\n\nいつも作品楽しみ拝見しております。\nまた日々のまぁまぁ様のイラストにおける多様な挑戦が、大好きです。\n\nさて、今回依頼したいイラストの内容になります。\nまぁまぁ様が、最近描かれているミニキャラを描いて頂くことは可能でしょうか？\n描いて頂きたいのは、以前お願いしましたまぁまぁ様デザインキャラクターです。\n\nミニキャラのイメージとしましては、まぁまぁ様が切り抜きで主に描かれているホロライブさんのミニキャラデザインが近いです。\nもう少し詳細にお伝えいたしますと、最近まぁまぁ様が受賞されたホロライブさん主催イラストのようなミニキャラをお願いしたいです。\n勿論、まぁまぁ様の日ごろからのホロライブさんへの熱意は、少なからず理解しているつもりです。\nもしもホロライブさん限定でのデザインということでしたら、断っていただいて何ら問題ございません。\n\nもしミニキャラが可能でしたら、以下が制作希望のものとなります。\n\n【依頼内容】\n私が以前発注したまぁまぁ様デザインイラストのミニキャラ\n(顔のみ、バストアップのみなどは、まぁまぁ様の判断でお願いいたします)\n金額が可能な範囲で、表情差分もお願いしたいです。\n\n表情差分の優先順位は以下となります。\n1 まぁまぁ様が考える、デザインに合う表情\n\n2 最高に嬉しい顔\n3 最悪に絶望している顔\n4 考え事をしている顔\nただし、これはあくまでも例ですので、勿論まぁまぁ様が描きやすい表情差分で問題ございません。\n\n【使用用途】\nSNSやyoutubeでの、サムネやアイコンの利用\n最近の予定ですと、shortに使いたいと考えております。\n商用利用はしません。\n\n【立ち絵】\n下記リンク、もしくはTwitterの固定にてデザイン画像ございます。\nhttps://photos.app.goo.gl/6qDub7a72G9KBYrU6\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/6qDub7a72G9KBYrU6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@5UDLkZpHzqSn9Hi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 539423, "client_id": 1165317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb97757c/uploads/origins/e9f3d387-56bc-4207-96e6-3ec1307eb626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86e80efebe9bad21d6f666d6c405f68b", "srcset": "https://si.imgix.net/bb97757c/uploads/origins/e9f3d387-56bc-4207-96e6-3ec1307eb626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200