n\n■背景\n風景はへやの中のイメージです！TVゲームまたはPCゲームをコントローラーでしてる雰囲気になります！\nまた配信のサムネイルでも使用したいので背景透過済みもいただきたく思います。\n\n\n■使用用途\nTwitterへの投稿及び配信時のサムネイル使用、Twitterのアイコン使用等\n活動全般に使用したいです。\n\nhttps://drive.google.com/drive/folders/1gUPKaXZEn_iT4ERNjc33MQTcWL8osfQS?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tautano/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 583758, "client_id": 1707656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e845da24/uploads/origins/e39a3020-0b47-4382-904c-4f93c6c6bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9769714e1aa879c5bd4e4d115d29583", "srcset": "https://si.imgix.net/e845da24/uploads/origins/e39a3020-0b47-4382-904c-4f93c6c6bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9769714e1aa879c5bd4e4d115d29583, https://si.imgix.net/e845da24/uploads/origins/e39a3020-0b47-4382-904c-4f93c6c6bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=adf2d64838e7f1060d6c7c90e9f89757 2x, https://si.imgix.net/e845da24/uploads/origins/e39a3020-0b47-4382-904c-4f93c6c6bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75dfc4749a9c65e8e5f01550ee24e313 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e845da24/uploads/origins/e39a3020-0b47-4382-904c-4f93c6c6bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5798b8a9cee7c5ecd5ac37bc43b52d56", "srcset": "https://si.imgix.net/e845da24/uploads/origins/e39a3020-0b47-4382-904c-4f93c6c6bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5798b8a9cee7c5ecd5ac37bc43b52d56, https://si.imgix.net/e845da24/uploads/origins/e39a3020-0b47-4382-904c-4f93c6c6bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=to