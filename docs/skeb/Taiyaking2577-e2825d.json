で描いて頂けるようでしたら銃器の描写、腐れ縁のような感じの雰囲気・表情を是非詳細にして頂けたらと思います！\n\nこの度はこの様な機会を設けて頂き誠にありがとうございます！ご縁がありましたら大変嬉しく思います。よろしくお願い致します！\n\nhttps://twitter.com/momo_1tt/status/1616059069005197314?s=46&t=ZMypOTz1SQlY_zNfDBLAkw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Taiyaking2577/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 99446, "client_id": 1459073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a658bf7/uploads/origins/90881b47-4a85-44a5-8b5a-47f3a3e92934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58a759e04a56332c4c1b4f3a352a739", "srcset": "https://si.imgix.net/5a658bf7/uploads/origins/90881b47-4a85-44a5-8b5a-47f3a3e92934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d58a759e04a56332c4c1b4f3a352a739, https://si.imgix.net/5a658bf7/uploads/origins/90881b47-4a85-44a5-8b5a-47f3a3e92934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=765b9055b42d21d6904dd6f0ef3ce7a4 2x, https://si.imgix.net/5a658bf7/uploads/origins/90881b47-4a85-44a5-8b5a-47f3a3e92934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0f64c52e85ad6dfdf31de03379c6e34 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a658bf7/uploads/origins/90881b47-4a85-44a5-8b5a-47f3a3e92934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0846706f3c8ba74751dbb8c0c47edc3b", "srcset": "https://si.imgix.net/5a658bf7/uploads/origins/90881b47-4a85-44a5-8b5a-47f3a3e92934?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0846706f3c8ba74751dbb8c0c47edc3b, https://si.imgix.net/5a658bf7/uploads/origins/90881b47-4a85-44a5-8b5a-47f3a3e92934?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f89076d1192f9c