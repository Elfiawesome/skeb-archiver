79363816dfd6dbc8bdc00aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4effc5ca/uploads/origins/bc475652-d737-46e6-ae13-aa948ecf50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2daa2333926d5b398c1ed6c16e79ad81", "srcset": "https://si.imgix.net/4effc5ca/uploads/origins/bc475652-d737-46e6-ae13-aa948ecf50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2daa2333926d5b398c1ed6c16e79ad81, https://si.imgix.net/4effc5ca/uploads/origins/bc475652-d737-46e6-ae13-aa948ecf50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c727296789ba5aefc9fd14ab6623a19 2x, https://si.imgix.net/4effc5ca/uploads/origins/bc475652-d737-46e6-ae13-aa948ecf50d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c80d21d943484113de81b9565424e1d 3x"}, "body": "Nice to meet you! I saw your illustrations on my timeline and fell in love at first sight, so I'm sending you a request. I'd really love for you to draw the characters from the reference URL. They're characters I use in TRPGs, but the reference material contains no spoilers for the scenario. \uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\n\n\u25a0About the Characters A childhood friend pair used in the TRPG scenario \"BREAD AND BUTTER.\" They're extremely close and still see each other daily even as adults. Their relationship is friendly, romantic, and familial all at once\u2014they haven't labeled it as any one thing, but they care deeply for each other. For the character designs and detailed settings, please refer to the materials at the link below.\n\n\u25a0Detailed Setting Materials https://drive.google.com/drive/folders/15zCPVMQOWpuGbsu3aE7-Npse1nmPyjOO \u25a0Request Details I'm requesting this because I'm completely captivated by the way you depict body proportions and expressions in your male/female art, Mr. Shiro! I'd be thrilled if you could interpret and draw it however feels most natural for you!!\nRomantic expressions and close-proximity depictions are perfectly fine (and vice versa). The situation can be bright or dark\u2014either is great! \uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f That covers everything. Feel free to freely arrange, omit, or modify hairstyles and clothing! Also, any situation or composition is welcome. I'd be grateful if you could draw it however you find easiest.\n\nThe illustrations received may be used for: \u30fbSNS icons or headers (with the artist credited; measures will be taken to prevent AI training). \u30fbCreating goods for strictly personal use. If the payment amount is insufficient, or if the request text/attached materials are incomplete, we kindly ask you to cancel or resubmit your request. We sincerely appreciate your consideration!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biginu_smallinu/works/114", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2657686, "client_id": 2793621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dc85785/uploads/origins/bcfadde4-0c26-45a0-8a90-3af6ef7be37d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b3bd5ce61a4c00e89f0e2dd59843358", "srcset": "https://si.imgix.net/6dc85785/uploads/origins/bcfadde4-0c26-45a0-8a90-3af6ef7be37d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b3bd5ce61a4c00e89f0e2dd59843358, https://si.imgix.net/6dc85785/uploads/origins/bcfadde4-0c26-45a0-8a90-3af6ef7be37d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=363a68504e2282f9a0b00c264937dcd5 2x, https://si.imgix.net/6dc85785/uploads/origins/bcfadde4-0c26-45a0-8a9