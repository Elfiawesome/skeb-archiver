ardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04020cf9/uploads/origins/11b7b2d7-8057-4bd9-9e4a-021e2eadd1b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97057a6d8bc9edcf0446b0cba42aecfe", "srcset": "https://si.imgix.net/04020cf9/uploads/origins/11b7b2d7-8057-4bd9-9e4a-021e2eadd1b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97057a6d8bc9edcf0446b0cba42aecfe, https://si.imgix.net/04020cf9/uploads/origins/11b7b2d7-8057-4bd9-9e4a-021e2eadd1b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b7bd3480fbe1f3e01dbca81f4b16950 2x, https://si.imgix.net/04020cf9/uploads/origins/11b7b2d7-8057-4bd9-9e4a-021e2eadd1b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dbe772a0309f81ccaedf6267b7876658 3x"}, "body": "ゆきんこ様\n\n初めまして。個人でVtuber活動をしております笹熊りゅいと申します。Twitterのイラストどれも本当に本当に可愛く、キュアプレシャス生誕祭のイラストに一目惚れしました。どうしてもゆきんこ様の絵柄で私のVも見たい…！と思い、お願いしにまいりました。\n\n◾︎お願いしたい内容\n自分のVTuberを描いて頂きたいです。\n2月19日に半年記念日を迎えるため、お祝い系のイラストを希望です。\n\n◾︎利用予定\nYouTubeサムネイル、アイコン、Twitterでの画像投稿に使わせていただきたいです。商用利用予定はございません。\n\n◾︎お願いしたいイラストにつきまして\n資料をURLに貼らせていただきました。可能でしたらロングヘアーでお願いしたいです。パンダなので人耳はございません。\nもし可能でしたらケーキを持っていてくれると嬉しいです。また、背景を描いていただけるのでしたら人物と別レイヤーでいただけると非常に嬉しいです。\n\n初めてのおねがいのため、なにか失礼や不備がありましたら大変申し訳ございません。\nご検討いただけますと幸いです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1lxpZg0wuSuJJhWo7bAH6n9q1XwiOBCDs", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yukiwork/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2316460, "client_id": 1548999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/806d863a/uploads/origins/e84f5b81-9f65-4929-9f94-a3938c1f4c23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daf2bfa690dd17bbaa805e22bc0670db", "srcset": "https://si.imgix.