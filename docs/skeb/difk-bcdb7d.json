85b8702-b76e-44d9-bf1a-f719afebd3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8f904f32721b0e4f04376571f266700 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43159c1c/uploads/origins/885b8702-b76e-44d9-bf1a-f719afebd3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=317c6e066e5f3fb074aca78fb0345db5", "srcset": "https://si.imgix.net/43159c1c/uploads/origins/885b8702-b76e-44d9-bf1a-f719afebd3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=317c6e066e5f3fb074aca78fb0345db5, https://si.imgix.net/43159c1c/uploads/origins/885b8702-b76e-44d9-bf1a-f719afebd3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c6ba5bbb2cfd3fae95d60efd2a2c2bc 2x, https://si.imgix.net/43159c1c/uploads/origins/885b8702-b76e-44d9-bf1a-f719afebd3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e52cdad99119f63a167062a528506ce4 3x"}, "body": "こんにちは！腕と脚を拘束された状態で、プラズマウナギに快楽を与えられ、さらに屈辱を味わわされるマイ・バレンタインのイラストを希望します。マイはバトルシティの衣装を着ており、大きな胸と豊かな谷間がある設定にしてください。マイは抵抗しようとしますが、最終的には我を忘れ、お腹がふくらむほど快感に浸る様子を描いてください。より官能的な作品にするため、お好きなディテールを自由に追加してください。 \nhttps://www.pixiv.net/en/artworks/136416825\nhttps://skeb.jp/@honotomo7/works/106\nhttps://www.pixiv.net/en/artworks/140055496\nhttps://skeb.jp/@warukuriboo/works/121\n\nhttps://skeb.jp/@bara_no_oniku/works/102\n\nその他の「マイが腕を抱える」参考画像：\nhttps://skeb.jp/@Kta_osushi/works/160", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@difk/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3559554, "client_id": 2792903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9750cedda5f4dbdf414254365421ef3", "srcset": "https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9750cedda5f4dbdf414254365421ef3, https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=acd78dac3ac69b62ced6673502effeae 2x, https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffc416a2bd29c1882b515eb418b84a48 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f180a0cea9b07bf49676a98322051280", "srcset": "https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f180a0cea9b07bf49676a98322051280, https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f65681d9d8ae4451a5b8c341f8656de 2x, https://si.imgix.net/a0ff5364/uploads/origins/22a47d5f-b7cb-40dc-8a04-e1fd29bcec8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95c6b7e0b89e98eeceaa7ad943097df5 3x"}, "body": "こんにちは。バトルシティの制服を着たマイ・バレンタインが、バイザー・デスとバイザー・ショックに捕らえられた様子を描いていただけませんか？（白いチューブトップのコルセットに紫のレース、紫のジャケットとスカート、そして手のひらから上腕の中ほどまでを覆う白い長袖を着用していることを必ず確認してください）。参考資料は以下の通りです！\nhttps://skeb.jp/@Kta_osushi/works/192\nhttps://skeb.jp/@rakuraku_kmczk/works/134\n\nhttps://www.pixiv.net/en/artworks/131598448\n\nhttps://www.pixiv.net/en/artworks/129479985\n\nマイは大きな胸と豊かな谷間を持つことができます。マイの衣装は、白いチューブトップと半袖、そして紫のジャケットとスカートです。\n\n\nhttps://ske