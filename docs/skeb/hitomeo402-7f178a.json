://umamusume.gamedbs.jp/image/costume/3d/1680060344003_n96soclh.webp\n\nそして全体を描いてほしいです。\n\nでは、もう一度よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitomeo402/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3211692, "client_id": 124151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f0de5afd27199bfe3b6f72a9ebca8fb", "srcset": "https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f0de5afd27199bfe3b6f72a9ebca8fb, https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5536c2f9bdd51196a0d104d54cfff1f2 2x, https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9bf9620980d60f671b0243b338eddca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bc21bdefc5f2088d97958ede0e8c227", "srcset": "https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bc21bdefc5f2088d97958ede0e8c227, https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0daa39be6fce0572e74a774e95a48fd 2x, https://si.imgix.net/97166bce/uploads/origins/8597dff8-53dd-42a3-80f1-2156d0b6d458?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=976cab0f23e5e9a3d59a91fa50fed047 3x"}, "body": "こんにちは、あんくすと申します。\nいつもイラスト拝見させていただき、貴重な癒しを摂取させていただいております！\n季節の変わり目などと言いますが、想定外の激しい切り替わりに体がついていかない日々が続いていますので、お互いに太陽に負けず健康に気を付けて、この酷暑を生きていきましょうね……！\n\nさて、今回はイラストの依頼をお願いしたくご連絡差し上げました。\n要望内容は以下の通りです。\n\nキャラクター　　：グラスワンダー（ウマ娘）\n服　　　　装　　：私服\nシチュエーション：笹の葉にかけた自分の短冊を夜に手に取り、はにかみながら眺めている様子\n\nアングルや描画範囲、場所などそのほか指定のない部分に関しましては日留尾先生にお任せいたします。\n\n以上、お手隙の際にご一考いただければ幸いです。\nよろしくお願いします。\n\n\nこれから気温も上昇の一途を辿り、試される夏となることが予想されます。\n熱中症や夏バテには、くれぐれもお気をつけください。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitomeo402/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3211692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=814d999a33d3648656149377c2675742", "srcset": "https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=814d999a33d3648656149377c2675742, https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a3601b7a005120c7bfd4e8afafbfcc6 2x, https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=462843b425f46b66cc15baf737add3e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32061326775b0a0724e00a9d75ab3070", "srcset": "https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32061326775b0a0724e00a9d75ab3070, https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8f212ce611ae7cabd51fe720eb4f960 2x, https://si.imgix.net/9a51f217/uploads/origins/a07f1282-4ab8-4bf0-8b14-65dda020ac0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cbee4c515ee3e5ae5be1f536f041178 3x"}, "body": "以前からウマ娘のイラストを拝見しており惹かれていたので依頼を出したいなと考えていました\n今回その依頼を送らせていただきます\n\n海岸に居る水色ビキニ姿のデアリングタクトをお願いします\n\nイメージとしてはトレーナーと海へ遊びに来て、タクトが着替えてビキニ姿を見せに来たのをトレーナー目線で見ているようなシチュです\nスリーサイズなど公式で出ていますが美乳美尻と表現できるくらいの大きさでスラっとした体つきで描いていただきたいです\nポーズ、背景、ビキニのデザインなどはお任せしますが照れて恥ずかしそうな顔、トレーナーの体などは入れずタクトがビキニ姿と分かる構図でお願いします\n\n可能でしたら白ワンピースを上に着てビキニが透けている差分もお願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitomeo402/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3211692, "client_id": 2629643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea874dd85f5dc72dc2ac0e833e0fad0d", "srcset": "https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea874dd85f5dc72dc2ac0e833e0fad0d, https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=724bf3fd780b3ee9e96a522863783ef6 2x, https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3228676f5ef37765535eaba2d369a90f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1323492e5ff24891807777258d6bef1f", "srcset": "https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1323492e5ff24891807777258d6bef1f, https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98bd866ecfbc563eed5fd7d81510927e 2x, https://si.imgix.net/9583cc71/uploads/origins/7c0b7a54-6bed-488d-bee2-415ec04abf42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79bc9cdd5d9a9c541310f04a00086e05 3x"}, "body": "お久しぶりですモントブレチアとです\n今回ご依頼したいのはオリジナルウマ娘のデザインです\n名前は「ペシュレオンシオ」と言います\nデザインするに当たってお願い出来れば私服や制服姿など、いくつかの差分を頂ければ幸いです、もちろん無理には言いません\n構図などはお任せしますが、出来るのであれば全身図でお願いしたいです\nまた、不足している点については「お好きなよう」にデザインして頂いても構いません\n細かな設定や外見はお手数ですが下に詳細を表記しておきますのでご確認をお願い致します\n複雑なご依頼なので難しそうであればご辞退なさっても構いません\nどうぞご検討をよろしくお願いします\n\nペシュレオンシオ\n\n愛称:ペシュ\n年齢:13〜15(中等部)\n性別:ウマ娘\n一人称:僕\n身長:160cmぐらい\n体重:普通…かな？\n誕生日:4月19日\n誕生花\n\nアザミ:「独立」「報復」「厳格」「触れないで」\n\nデルフィニウム:「清明」\n\nイチハツ:「使者」「火の用心」「付き合い上手」\n\nスリーサイズ:B84(E)・W52・H83\n\n性格:大人しめで真面目\n\n容姿\n\n髪色:桃色\n　\n瞳の色:薄桃色\n\n外見\n\n・ミディアムロング\n・サイドテール(腰に届く長さ)＆結び目にリボン\n・優しげでとろんとした目\n・幼い顔つき\n・毛先が薄い水色に帯びている\n・ベレー帽\n・(正面から見て)右耳に桜の花の髪飾り\n\n耳の事:白いメンコを着けている\n\n尻尾の事:毛先が薄い水色\n\n勝負服のイメージカラー\nhttps://x.com/n_seitan/status/1878782157822562651?s=46\n\n私服\nhttps://x.com/minaze_73/status/1887475193884647629?s=46\n\n勝負服\nhttps://x.com/wiluga/status/1878829615692808614?s=46\n(これを桃色と白色に変えている感じ)", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitomeo402/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3211692, "client_id": 2629643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33cf38c50b7dadaa7f82e28cc3c9f92e", "srcset": "https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33cf38c50b7dadaa7f82e28cc3c9f92e, https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c63626ab1ec145d6d41828148173cca 2x, https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23c281cdcad31772916d6f7246113c0e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6465ceab2a46e4e46d7857ae19bf938a", "srcset": "https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6465ceab2a46e4e46d7857ae19bf938a, https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67966cb173de8f120173fb180a1db8e6 2x, https://si.imgix.net/82a87b02/uploads/origins/f812e466-dc5c-4be5-9927-0dc73851b8f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5dccb5984800eb69c14192178c296af0 3x"}, "body": "お久しぶりです、モントブレチアです\n今回ご依頼したいのは「アスター姉妹」を描いて頂きたいと思っております\n服装に関しては「体操服」、あるいは「水着」をお願いしたいです(トレーニング中と言う形で)\n構図などはお任せしてみたいと思っております\nご都合が悪かったり難しいと思いならばご辞退なさっても構いません\nどうかご検討をよろしくお願いします\n\n詳しい資料は下のURLからご確認ください\n\nhttps://www.pixiv.net/novel/show.php?id=19434392#44", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitomeo402/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3211692, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4839268106ba1ffb4f9898e5bf1bf1", "srcset": "https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e4839268106ba1ffb4f9898e5bf1bf1, https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=256ab32b292241de776b063a02eefab9 2x, https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8095d781d69d63ae51879eb397d6b2cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15b04493685fbe180ee0a3a98d60919c", "srcset": "https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15b04493685fbe180ee0a3a98d60919c, https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=742865620e58105d4124e20188d2d260 2x, https://si.imgix.net/c70f2c5b/uploads/origins/cec639cc-90fa-465a-acc8-d53c10e96bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fd7e79c0fb3af7cf409d7bab57de539 3x"}, "body": "こんにちは日留尾さん。\n前回は素敵過ぎるくらいしっくり着こなすアルダンさんをありがとうございました。\n改めて日留尾さんに描いて頂きたいお題目ができましたため、ご依頼させて頂けますと幸いです！\n\nもしよろしければウマ娘の「ヒシミラクル」に「トサキントレオタード」をコスプレさせた一枚をお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n衣装の造形につきましては資料ページをご参考頂ければ幸いです！\n\n衣装の元ネタはご存じないとは思いますが、手袋とセットの白系レオタード（厳密には淡い水色ですが）が私の性癖ド真ん中にヒットしてるので、日留尾さんのお手前を振るって頂ければと思ったこと。\nまた、私事ながら直近のチャンミで意外にもミラ子が活躍してくれたことで、ミラ子熱が沸き上がってること。\nそして、日留尾さんが描かれたミラ子の描き味がとてもグッときたことも相まって、全部満たせる美味しいトコ取りをさせて頂ければと思い（笑）、お願いさせて頂ければと存じます。\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、日留尾さんが良いと思ったまま、日留尾さんのご想像されるミラ子のリアクションで描いて頂ければOKです。ただコスプレ（衣装）姿がメインなので、せめて全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います。\nまた、ウマ娘の規約的にセンシティブ配慮し、ストッキングを履かせる等の微アレンジを加えて頂く等は問題ないです、もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋は性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……！）\nそれから、日留尾さんならバニー系のレオタに長けているお方と勝手に目を掛けていましたので（笑）、レオタについてはエナメルバニーチックにアレンジ加えて頂いて問題ありません！　縫い目とか光沢とかこっそり期待！ｗ\nですが、もちろん原作に寄せるのが良いと思われましたら、日留尾さんが一番しっくりくる質感で出力頂いて問題ありません。\n\nまたも知らないジャンルとの掛け合わせたご依頼となりますが、それでもお受けいただければ幸いです！\n何卒よろしくお願いいたします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hitomeo402/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3211692, "client_id": 2629643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee85ae51/uploads/origins/c8822f00-480d-45b6-8acc-71c4fc3a69cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f78800d26c01afb75be5ddbc93bcbdec", "srcset": "https://si.imgix.net/ee85ae51/uploads/origins/c8822f00-480d-45b6-8acc-71c4fc3a69cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f78800d26c01afb75be5ddbc93bcbdec, https://si.imgix.net/ee85ae51/uploads/origins/c8822f00-480d