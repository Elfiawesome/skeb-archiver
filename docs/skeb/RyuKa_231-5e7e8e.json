\n\n〖使用用途〗\nSNSやサムネイル(収益化済)、広報活動等、\n音声作品のジャケット、FCの返礼品などに使用予定です。\n\n〖納品形式〗\n可能であればPSD希望です。(PNGでも大丈夫です)\n背景と人物を出来れば分けて頂けると助かります。\n色々な場面で使用したい為、\n頭の見切れがないと大変助かります。\n\n\n以上、\nよろしくお願い致します☺️\n\nhttps://lit.link/ulgsl", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RyuKa_231/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2018423, "client_id": 3143432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f22939c/uploads/origins/ad3cbd0f-6e56-460b-8c99-4b362e8e9fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f6200b6c6eb9f38e36e3d8a7a94dc1", "srcset": "https://si.imgix.net/7f22939c/uploads/origins/ad3cbd0f-6e56-460b-8c99-4b362e8e9fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f6200b6c6eb9f38e36e3d8a7a94dc1, https://si.imgix.net/7f22939c/uploads/origins/ad3cbd0f-6e56-460b-8c99-4b362e8e9fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=402e0e14fc2fbd1e61468bb41003cfc1 2x, https://si.imgix.net/7f22939c/uploads/origins/ad3cbd0f-6e56-460b-8c99-4b362e8e9fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=951886e89d64e2978efdf87830259e6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f22939c/uploads/origins/ad3cbd0f-6e56-460b-8c99-4b362e8e9fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=798e59c7cb362ae7121d7771e6c13469", "srcset": "https://si.imgix.net/7f22939c/uploads/origins/ad3cbd0f-6e56-460b-8c99-4b362e8e9fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=798e59c7cb362ae7121d7771e6c13469, https://si.imgix.net/7f22939c/uploads/origins/ad3cbd0f-6e56-460b-8c99-4b362e8e9fbb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8387a6ed3cca11a