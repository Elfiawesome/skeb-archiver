、と思っています。\nまた、ご本人たちお2人が配信の際のサムネ等YouTube、SNSに使用できることを想定しています。\nそのため、お1人ずつ分かれたデータ、背景があれば背景の透過版・背景がレイヤー分けされているPSDデータなどもあるとありがたいです。\n\nどうぞ、ご検討のほどよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RuiAitsugawa/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4257, "client_id": 5858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4d28400/uploads/origins/305d850b-f168-41e2-8669-d500c5c57821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb438cb4983a2e61a49c26352ec9c180", "srcset": "https://si.imgix.net/e4d28400/uploads/origins/305d850b-f168-41e2-8669-d500c5c57821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb438cb4983a2e61a49c26352ec9c180, https://si.imgix.net/e4d28400/uploads/origins/305d850b-f168-41e2-8669-d500c5c57821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f090ddf7b0b3b65c4d9483fad705917 2x, https://si.imgix.net/e4d28400/uploads/origins/305d850b-f168-41e2-8669-d500c5c57821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68a255dd9ae4e7a41ef51842c2d53b45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4d28400/uploads/origins/305d850b-f168-41e2-8669-d500c5c57821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14e156574809f47bebcd4deb5fc19864", "srcset": "https://si.imgix.net/e4d28400/uploads/origins/305d850b-f168-41e2-8669-d500c5c57821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14e156574809f47bebcd4deb5fc19864, https://si.imgix.net/e4d28400/uploads/origins/305d850b-f168-41e2-8669-d500c5c57821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=890e15cc974e7c0c46c6d38e10246eac 2x, https://si.imgix.net/e4d28400/uploads/