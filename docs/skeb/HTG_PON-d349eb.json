lur=200&s=f427c944ef80fd75a642b3a9fa6b92bf 2x, https://si.imgix.net/f17601cd/uploads/origins/74212250-520c-45a9-8610-247a0b989727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b14edb8f85648cf3001d7fe85dc67353 3x"}, "body": "アダルト絵の依頼を致します。\n【キャラ】\n蟹沢きぬ：つよきす\n\n【内容】\n海（烏賊島）で、ビキニの上を忘れ、ヒトデをビキニ（上）の代わりにしようとして、両胸に付けてヒトデの口に乳首をコリコリと噛まれ、感じ悶えながら絶頂をしてしまう絵\n※勢いのあるエロバカ\n※噛まれて勃起した乳首だけアップもコマもほしい\n\n【その他】\nPSDデータ希望\n※レイヤーは一つのPDFデータに纏めほしい", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HTG_PON/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 993369, "client_id": 396932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba99fd251793f5e4cd4ab738b8687c8", "srcset": "https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ba99fd251793f5e4cd4ab738b8687c8, https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=406fc00a97b3c0c2cdc6722f063308e8 2x, https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=414f59d9d6d023b141e4abfcdae2a0fa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b392ac845dff539ca400881bc0f2e24b", "srcset": "https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b392ac845dff539ca400881bc0f2e24b, https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de6af15f14bc8b3f254a669b72075fa9 2x, https://si.imgix.net/4910cb89/uploads/origins/a59baa49-0811-4de6-a9bd-d8c46ccb8fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60bbb07e2f9a27580f6d452349406117 3x"}, "body": "前回の依頼ありがとうございました。今回もつよきすキャラのアダルト絵の依頼をします。\n\n【内容イメージ】\n近衛素奈緒が、いつもより騒いでいる２－C組の教室に注意を行いに来て、蟹沢きぬと口論になり、きぬが、フカヒレをベイブレードみたくベルトを素早く抜き高速回転させ、素奈緒に目掛けて蹴り飛ばし、高速回転したフカヒレが素奈緒の真横を通りすぎ、後ろの壁に回転しながらめり込んでいるが、フカヒレの高速回転によって偶然産まれた、かまいたち現象みたいな真空系の斬り技で、素奈緒の制服が斬り刻まれ、制服姿→下着姿→全裸みたくなってしまい、恥を掻くシチュエーション\n\n【キャラ】\n近衛素奈緒：つよきす\n\n【服装】\n・制服姿\n・制服姿（細かく布切れになる）\n・下着姿\n・下着姿（細かく布切れになる）\n・全裸（陰毛あり）\n・全裸（陰毛が斬られパイパン化）\n※靴や靴下は斬らずに残しても良い。\n\n【表情】\n怒り顔\n驚き顔\n赤面(泣き顔)\n\n【資料】\n服ビリは大雑把で構いません。乳首や股間等は見える様に破く\nhttps://www.pixiv.net/artworks/108008803\nhttps://www.pixiv.net/artworks/109130352\nhttps://www.pixiv.net/artworks/85225555\nhttps://www.pixiv.net/artworks/105088727\n\n【ポーズ】\nポーズは一任致します。\n\n【その他】\n・PSDデータ\n・サインのオンオフ差分\n・背景は一任します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HTG_PON/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 993369, "client_id": 396932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22b618be/uploads/origins/76f423d8-4819-4004-b05c-f601e6bebc12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effa28fa279dbb01d12445d7e53c9821", "srcset": "https://si.imgix.net/22b618be/uploads/origins/76f423d8-4819-4004-b05c-f601e6bebc12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effa28fa279dbb01d12445d7e53c9821, https://si.imgix.net/22b618be/uploads/origins/76f423d8-4819-4004-b05c-f601e6bebc12?bg=%23fff&auto=format%2Ccompress&