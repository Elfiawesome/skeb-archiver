le/n/nb8bf1bf01015\nhttps://note.com/369chronicle/m/mde6f56513755\n\nご対応いただけるかどうかまずはご検討いただければ幸いです。\nなにとぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1q16khb7PlF3xHVHb9D0ydNEaIpAu4MB0/view", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agyo09umegae/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3864969, "client_id": 3076601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea5b778a/uploads/origins/c13df05d-f9e3-40d0-9d77-83684ddfdc05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16247c42342fe5ae8ecf7e5d89a67378", "srcset": "https://si.imgix.net/ea5b778a/uploads/origins/c13df05d-f9e3-40d0-9d77-83684ddfdc05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16247c42342fe5ae8ecf7e5d89a67378, https://si.imgix.net/ea5b778a/uploads/origins/c13df05d-f9e3-40d0-9d77-83684ddfdc05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c4296210cf45f62465fe9997542f481 2x, https://si.imgix.net/ea5b778a/uploads/origins/c13df05d-f9e3-40d0-9d77-83684ddfdc05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c0ae883252364c5e3720d478525994e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea5b778a/uploads/origins/c13df05d-f9e3-40d0-9d77-83684ddfdc05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=565a0d7b1bfe79964ff7d45d26473848", "srcset": "https://si.imgix.net/ea5b778a/uploads/origins/c13df05d-f9e3-40d0-9d77-83684ddfdc05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=565a0d7b1bfe79964ff7d45d26473848, https://si.imgix.net/ea5b778a/uploads/origins/c13df05d-f9e3-40d0-9d77-83684ddfdc05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1297482bb9621e4d7be5a5ddc70dc5