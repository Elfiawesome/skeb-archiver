のほどよろしくお願いします。\n\nhttps://x.com/hitotsubarococo/status/1860645595452678442?s=46&t=xb7HYq9G6uJVol35vpKRCQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agyo09umegae/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3864969, "client_id": 1665711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd60256f0957d2216e28b93e84e8d1c", "srcset": "https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd60256f0957d2216e28b93e84e8d1c, https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3cc14c3f301a17828289154f91ae5aa 2x, https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=152918e8c60f01d6ae22810e1c447f11 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4113308c4b6b38813d9ea5eb8f0c1207", "srcset": "https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4113308c4b6b38813d9ea5eb8f0c1207, https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c599bb79a9847aceb0663622eb631e7e 2x, https://si.imgix.net/76abdf12/uploads/origins/b037aef6-066d-494b-85db-9553d390a3ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26d24b1a3a2efbe756e798a15b3b0a4c 3x"}, "body": "はじめまして\n個人Vtuber の雨之庭紫陽花と申します。\n先日Xにて灰原あや様の描かれる背景と髪が溶け込んでいる素敵なイラストに一目惚れしました。\n素敵な色使い、柔らかく愛らしい表情がとても好きで今回リクエストを送りました\n\n【描いてほしいイラスト】\n私 「雨之庭紫陽花」の人型\n服装:学生服(https://x.com/hydrangea2015_8/status/1862104157790130602?s=46&t=XarozWFLQpOT6cRmIQtU5g )\n帽子はなしでも問題ございません。\n\n【設定】\n紫陽花の妖怪や妖精みたいな存在で最後の時を待つ花たちがいる農園でお手伝いをしています\n本体は紫陽花の化け物みたいな見た目で分体と人の見た目と犬の形態があります\n\n見た目がおとなしめですが、元気な感じで配信を行なっていますので茶目っ気ある元気な雰囲気ですが、不穏なことを話したり、ホラーチックな様子もあります。\nまた推理や考察が好きですが、かなり逸脱したサイコな考えを出したりします\n喜怒哀楽が激しく、漫画やアニメ小説・メイクやコスメがなどが好きなタイプです　\n\n【構図やポーズ希望など】\n特にポージングなどの指定はございません。\nぜひ灰原さまが私のデザインを見て、イメージしたポージングでお願いしたいです。\nもし特になければ学生服ですので、学生らしい無邪気な感じや恥じらっている感じの表情またははにかむように笑っている感じでお願いします。\n全身や上半身・バストアップなどの指定などありませんがサムネなどに利用したいと思っていますので、できるだけ途切れがないイラストでお願いします。\n\n【活用内容】\n描いていただいたイラストは、Twitterのアイコンや活動ツイート、YouTubeのサムネイル等・非収益(ネットプリントなど)の各種活動に使用したいと考えております。\nそのため、可能でしたらキャラのみ使用できるよう透過したものやPSDファイルもいただけますと幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://x.com/hydrangea2015_8/status/1605994890533404672?s=46&t=XarozWFLQpOT6cRmIQtU5g", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@agyo09umegae/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3864969, "client_id": 2976786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b22bc585/uploads/origins/d110b26e-f009-480a-9016-68c640892907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9a1c24062f5f16c17f6013020d9df2", "srcset": "https://si.imgix.net/b22bc585/uploads/origins/d110b26e-f009-480a-9016-68c640892907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9a1c24062f5f16c17f6013020d9df2, https://si.imgix.net/b22bc585/uploads/origins/d110b26e-f009-480a-9016-68c640892907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18fb9ef996153