d-c5631c7b71b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b31ea326cae883750eeaa595bd936de", "srcset": "https://si.imgix.net/563af916/uploads/origins/c1d3100e-b4c8-402c-abad-c5631c7b71b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b31ea326cae883750eeaa595bd936de, https://si.imgix.net/563af916/uploads/origins/c1d3100e-b4c8-402c-abad-c5631c7b71b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0814131a9951f6124cb52b235844e807 2x, https://si.imgix.net/563af916/uploads/origins/c1d3100e-b4c8-402c-abad-c5631c7b71b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59f6618b4767a28dafe283d0e7a00000 3x"}, "body": "こんにちは。\n以前からえーろくさんの描かれるかわいらしいショタを拝見していましたので、skebで募集を始められて嬉しく思います。\nもしよろしければ、スパークくんのイラストをリクエストさせて頂けないでしょうか。\nスパークくんが紐のような細さのマンキニ水着をデザインに取り入れたスケベアーマーを装備しているシチュエーションでお願いしたいです。\nきわどい衣装に羞恥心を覚えつつも、能力値が高いため恥ずかしさをこらえながら着用している風にして頂きたいですが、もし解釈違い等ございましたらスパークくんのリアクションはお任せ致したいです。\nどうぞ、ご一考頂けますと幸いです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@ikanoodashi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1302185, "client_id": 2576885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abdb1f9c/uploads/origins/2ef1296f-09d6-4469-9b9c-4e3d7b51c9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36cdef54098f95a844c9650e963decac", "srcset": "https://si.imgix.net/abdb1f9c/uploads/origins/2ef1296f-09d6-4469-9b9c-4e3d7b51c9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36cdef54098f95a844c9650e963decac, https://si.imgix.net/abdb1f9c/uploads/origins/2ef1296f-09d6-4469-9b9c-4e3d7b51c9e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b051e4684dc1460e64e5bd12f1747eae 2x, https://si.imgix.net/abdb1