5d-4928-bb9a-b5d0571ad87b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0ff709ef9ea8f361ec2232d7ae1f5df 2x, https://si.imgix.net/141a0d0c/uploads/origins/38dc7333-135d-4928-bb9a-b5d0571ad87b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c737c93187445a0d5934c1b641505da8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/141a0d0c/uploads/origins/38dc7333-135d-4928-bb9a-b5d0571ad87b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42223fd5b2b47facf532194cf0bab885", "srcset": "https://si.imgix.net/141a0d0c/uploads/origins/38dc7333-135d-4928-bb9a-b5d0571ad87b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42223fd5b2b47facf532194cf0bab885, https://si.imgix.net/141a0d0c/uploads/origins/38dc7333-135d-4928-bb9a-b5d0571ad87b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a50122700a894f8f090c7fb66e8d20bb 2x, https://si.imgix.net/141a0d0c/uploads/origins/38dc7333-135d-4928-bb9a-b5d0571ad87b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63fffeafbadfe273fefe0a9ed3b181bb 3x"}, "body": "よもぎ様\n\nこんばんは、よもぎ様。\nアピールありがとうございます。\nアピールのお陰様で星導さんの素敵なイラストがたくさん見れました！愛を感じました…！\nそれにこちらのオリキャラのことを褒めてくださりありがとうございます！\nではアピールでおっしゃってくださったケモミミ子の万里香をぜひお願いします。\n「感情によって豊かに動くお耳としっぽ」「様々な表情差分」て、素敵なアイデアですね！\n設定と設定画はもう見ましたかと思いますけど念の為リンク先に貼ります。\n衣装は設定画のうちの一つで、他はどうかご自由にお願いします！\nご検討くださいませ。\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101876/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3846960, "client_id": 3927701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/040dd975/uploads/origins/e1