s/1553013532022964224?s=21&t=3Lqx5UzcRVQqovr9a2NUcw\n\n\n○設定\n花染 鸞丸(赤髪/攻め)\nダウナー系、身長202㎝、マイペース\nへらへらと掴み所が無い性格で神出鬼没\nだったが…歌代橙利への依存が激しく、嫉妬深い束縛男になっていった。\n歌代橙利を亡くしてからはSAN0ゾンビみたいな感じ。\n\n歌代 橙利(黒髪/受け)\n真面目な元警察官。元バディを亡くしてからは目の下にクマがでしたり病んだりしたが、現バディの花染と組んでからメンタル面は回復してきた。付き合うようになって花染の悪戯に翻弄されている。付き合う前は尊敬、付き合ってからは呆れるところがありつつもぞっこんです。現在は既に故人…。\n\n※創作企画「機密隊高月」に現行参加中\n※二人はお付き合いをしてから同棲しています。\n※本編世界線では歌代はロスト済み\n※本編世界線では歌代がエネミーとして復活\n※企画ロゴ素材は有償依頼時使用不可の為、見えない構図、または記載無しでお願い致します。\n\n\n○構図\n詳細に沢山あると描きやすいとおっしゃっていたので、いくつか上げさせていただきます。カゴヤマさん的にビビっ！ときたものを描いていただけたら嬉しいです…！！\n\n・キッチンに立って二人で料理してる(体格差、身長差とか分かるとかわいいなぁと思いました。)\n・歌代に膝枕をしてもらっていちゃつく\n・公式サブイベント時のバニー服の二人(衣装など決まっていないので、カゴヤマさんの描きやすいものでお願いします)\n・歌代のもこもこかわいいパジャマがカゴヤマさんのSDでみたいです…かわいくて！\n・戦闘イラスト(祓の雷札を使ってる花染、手甲鉤をだして構えてる歌代)\n・歌代に怒られてる花染(歌代は怒っても怖くないが圧をかけられると飄々としてる花染もたじ…となる)\n・なんかいちゃいちゃ幸せそうな二人…(キスでもハグでも幸せそうな…)\n・一緒のベッドで身を寄せあって寝る二人\n・花染のボーイ時代、歌代の警官時代のイラスト\n・寝ぼけてる花染の髪を結う歌代\n・歌代の肩を組んで楽しそうに会話してる二人\n・照れ顔の歌代にちょっかいかける花染\n\nなどなど…考えてみました…！！\nもしよろしければ、まだ間に合えば！\nよろしくお願い致しします！！！！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ssr_Tutinoko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1222596, "client_id": 1368650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=189885e7a2e4a6de36f8c57f0d764e2f", "srcset": "https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=189885e7a2e4a6de36f8c57f0d764e2f, https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fe50f90c9de07e3f37c80f97035d8af 2x, https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=048d3472c5d4d19a005d7d457de422bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=142222b17dfb1a74476948fa200d2856", "srcset": "https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=142222b17dfb1a74476948fa200d2856, https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9115edff3d2417079a79f14268d38a2 2x, https://si.imgix.net/9995aaeb/uploads/origins/dc64da09-7350-40dc-ac80-4f4ff4842972?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f243de5f523c469dba8a7a1c76e692f0 3x"}, "body": "酒呑てんぱいにセクハラしたかったんですけどなんかもうつちのこ先生の描かれる都市伝説課自陣が見たいです…！背中合わせでも向かい合ってても…なんかアニメとかの広告みたいにエモい感じに並んでる二人をよろしくお願いします！！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kagoyama_a11/works/73", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 466721, "client_id": 1368650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e863999250cc89d42dd65248df53f28", "srcset": "https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e863999250cc89d42dd65248df53f28, https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0afd511bf96e8da7f8627b1dba6ec64d 2x, https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8851d835c57cb031a0dae34c8c84c8e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06b2908ba104d68786784d370f7469b3", "srcset": "https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06b2908ba104d68786784d370f7469b3, https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=639c3049cb267c401a357b87a347661d 2x, https://si.imgix.net/e4cc7e9a/uploads/origins/9486001c-9e5a-4abc-8c4d-b37074c9868f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be574f9039360041f0c938a1d6db12f3 3x"}, "body": "こんにちは、カゴヤマさんのイラストのファンです。キャラデザの細かさや線画の美しさ、構図もじっくり細部まで見てしまうほど好きです。他のコミッションイラストもどれも素敵でいつかカゴヤマさんにお願いしたいと思って、うちよその厳選をしてきました。よければうちのTRPGのうちよそイラストを描いてください。\nよろしくお願いします。\n\n未だステガノグラフィというシナリオしか通過していない二人なので、ステガノグラフィのネタバレにならない範囲の設定を参考のために記載させていただきます。\n\n・設定\n青い方、高校教師(保健室の先生)\n30代前半、ヘラヘラとした気さくで明るく生徒とも仲良しで調子のり。教師らしからぬ緩さと子供っぽさがあり、貞操観念まで緩い。表情がコロコロ変わるしよく笑うがたまに天然か確信犯なのか、真顔でとんでもないこという。ボケ。\n名前は馬鹿 黔(ましか くろむ)\n\n赤い方、高校教師(化学の先生)\n30代前半、ダウナー。にやっとしたり呆れたりと言う表情が多い。馬鹿とは別ベクトルの緩さがある。冷静に周りを見ているタイプなので馬鹿に振り回されてくれる。呆れつつなんやかんやと悪友のような関係で楽しんではいる。ゆるキャラやビビッド、ピンクなどが好き。常識の範囲内の悪ノリはすき。よく保健室にお菓子を持ってサボりにいく。ツッコミ。\n名前は水蜜 終平(みなみつ しゅうへい)\n\n身長は同じくらい、体格は少し馬鹿の方がいいです。連れションしたり、タバコではなくココアシガレットでシガレットキスなんかをするような子供っぽさもあるけどお互い精神的には自立している悪友のようなブロマンスという関係です！BLでいうなら完リバ。\nそういう関係をイラストに表していただけるととても嬉しいです。\n\nカゴヤマさんのちびキャラも等身の高い絵も好きです。構図などお任せになってしまい申し訳ありませんが、カゴヤマさんの構図やキャラのポージング、体の描き方や装飾の細かさ、服の皺、髪の毛のはねかたなどがもう大好きなのでお好きなように料理してやってくださいませ…！！\nどうぞよろしくお願いします…！！\n\nhttps://twitter.com/ma__________1/status/1487227259165757440?s=21", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sakuraba_01/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 676241, "client_id": 1368650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dee9349/uploads/origins/8933589b-f9dd-44aa-ae6f-0310f65ca75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e910329a18f9384aa050ec95773d14de", "srcset": "https://si.imgix.net/6dee9349/uploads/origins/8933589b-f9dd-44aa-ae6f-0310f65ca75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e910329a18f9384aa050ec95773d14de, https://si.imgix.net/6dee9349/uploads/origins/8933589b-f9dd-44aa-ae6f-0310f65ca75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a983b9014a10584b9ed6efad2b24780a 2x, https://si.imgix.net/6dee9349/uploads/origins/8933589b-f9dd-44aa-ae6f-0310f65ca75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a26058aead855145288675d071f0f7f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dee9349/uploads/origins/8933589b-f9dd-44aa-ae6f-0310f65ca75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2876b5dfee4a3228b4011765bf1e3a8", "srcset": "https://si.imgix.net/6dee9349/uploads/origins/8933589b-f9dd-44aa-ae6f-0310f65ca75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2876b5dfee4a3228b4011765bf1e3a8, https://si.imgix.net/6dee9349/uploads/origins/8933589b-f9dd-44aa-ae6f-0310f65ca75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d67aa96a717df73b40d66b13b849d61 2x, https://si.imgix.net/6dee9349/uploa