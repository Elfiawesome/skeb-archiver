fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10da63b405defd138b0cb599de351720", "srcset": "https://si.imgix.net/6d76cef8/uploads/origins/e4f8101e-2c2a-425d-9492-b2315e605260?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10da63b405defd138b0cb599de351720, https://si.imgix.net/6d76cef8/uploads/origins/e4f8101e-2c2a-425d-9492-b2315e605260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23a0925757ce80c3de2291d160aab06d 2x, https://si.imgix.net/6d76cef8/uploads/origins/e4f8101e-2c2a-425d-9492-b2315e605260?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3224faa9b75dd9f8b67aa54246d02db5 3x"}, "body": "Good morning! Thank you so much for your interest in my characters! I received your appeal looking to possibly do work of them. I am very open to poses, moods, and environments. I've found they work well in any situation. \n\nI really enjoy how you draw close/ almost intimate reactions between characters. However, I am open to anything you would enjoy drawing most. \n\nMarie is a scholar of water magic. Marie is often very protective of Flauros. She sees past his dark nature.\nFlauros is a powerful demon who chose to bound himself to Marie. Flauros is Marie's fighting force when she needs it. \n\nhttps://drive.google.com/drive/folders/1Ex0secCczZVkMpzJDpv_fuXd7BghROnq\n\n\nhttps://drive.google.com/drive/folders/1vRjnSEAS_edQLxEF0hwUR9II6_NOz09O", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@c__appuccino/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2567397, "client_id": 3093906, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2343d0cfd6df9e29a85ba4752e97429", "srcset": "https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2343d0cfd6df9e29a85ba4752e97429, https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=847831c9e5f714d39a4e7c3d6f4cbd8e 2x, https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bba984bec77b314d2cbfe940214e7ab0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b41c302eded44910e735bdc644c05417", "srcset": "https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b41c302eded44910e735bdc644c05417, https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ce0a0b4155450d42002b80a1eadf518 2x, https://si.imgix.net/303d7767/uploads/origins/f05df9f1-68be-4845-99b9-ea7c95005172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d441fbf2e6c6054cb2b1b969b484be70 3x"}, "body": "Hello!\n\nThank you for your Appeal! I really like your art style and illustrations and I was hoping to commission you for an illustration of my Vtuber!\n\nMy Vtuber is called Larity and she is a superhero who lives in space and has the power of gravity. Her personality is energetic and she has a fun sense of humour.\n\nI would love an illustration that focuses on her personality!\n\nHere is a folder full of reference pictures:\nhttps://drive.google.com/drive/folders/1thlP00uzlr7Y-MwnnQKTt7MxAfhJn_8C?usp=drive_link\n\nI would love to use your art as decoration for my VTuber schedule or YouTube thumbnail in the future and I will credit you if that is okay with you?\n\nThank you for your consideration!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@c__appuccino/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2567397, "client_id": 1980644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2e07872/uploads/origins/f6c26631-d622-407b-ba97-4817c1074384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049b581853ddf989aa764174cd1eb6ee", "srcset": "https://si.imgix.net/f2e07872/uploads/origins/f6c26631-d622-407b-ba97-4817c1074384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049b581853ddf989aa764174cd1eb6ee, https://si.imgix.net/f2e07872/uploads/origins/f6c26631-d622-407b-ba97-4817c1074384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a4b0802c6cdca90c0adda197928de69 2x, https://si.imgix.net/f2e07872/uploads/origins/f6c26631-d622-407b-ba97-4817c1074384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cb1c6c14f6c51f61ad8c2d92d97f4d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2e07872/uploads/origins/f6c26631-d622-407b-ba97-4817c1074384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52e6216b386cad5b162c126fd28aa7f6", "srcset": "https://si.imgix.net/f2e07872/uploads/origins/f6c26631-d622-407b-ba97-4817c1074384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52e6216b386cad5b162c126fd28aa7f6, https://si.imgix.net/f2e07872/uploads/origins/f6c26631-d622-407b-ba97-4817c1074384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t