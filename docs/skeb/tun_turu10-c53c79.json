ue, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5d9ffc2/uploads/origins/e05e287d-bf4f-4ae1-b309-a3c839de2d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d9b91986d64e3c81cbc367f394f3614", "srcset": "https://si.imgix.net/f5d9ffc2/uploads/origins/e05e287d-bf4f-4ae1-b309-a3c839de2d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d9b91986d64e3c81cbc367f394f3614, https://si.imgix.net/f5d9ffc2/uploads/origins/e05e287d-bf4f-4ae1-b309-a3c839de2d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36206a3361d01a9a36ba3f9d1556d610 2x, https://si.imgix.net/f5d9ffc2/uploads/origins/e05e287d-bf4f-4ae1-b309-a3c839de2d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7314f02a2dfea7a19a69463df5e4c01 3x"}, "body": "お久しぶりです\n今回はうちの子の胡桃ちゃん(※1)が負けるイラストをお願いします\n\n詳細\n・服装は制服\n・胡桃ちゃんの持ってる武器のセツラ(※2)は身長165cmの胡桃ちゃんより長いです\n・真正面から斬られてセツラの柄で受け止めようとしたけど折られて肩から袈裟斬りにされる\n・胡桃ちゃんは悲鳴を上げてて制服が破れて胸や下着が露出してる感じです\n・下着とおっぱいの大きさは以前の依頼(※3)と同じです\n・敵のデザインは真っ黒い日本刀を持った黒いオーラを纏って顔が分からない黒い男性\n・可能であれば下着だけ差分/全裸差分もお願いします\n\n資料\n※1：https://x.com/sky12176/status/1705417627701760100\n※2：https://x.com/MrGING5/status/1820484047392702679\n※3：https://skeb.jp/@tun_turu10/works/14", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tun_turu10/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 842399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c3a2078/uploads/origins/a7e1d054-58cb-4b91-9b63-30f3bdf8cc1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcdd51c4c3f9274c6918c6b364140f7", "srcset": "https://si.imgix.net/8c3a2078/uploads/origins/a7e1d054-58cb-4b91-9b63-30f3bdf8cc1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcdd51c4c3f9274c6918c6b364140f7, https://