ませんでしょうか？\n難しければ、こちらのキャラをベースにお好きに描いて頂いて構いません\n\n\n構図や画像サイズなどはお任せ致します\n内容や金額等諸々に不都合等ございましたら、お気軽に再送・キャンセルをお願いします\nご検討頂けますと幸いです、よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1uFj_UWL0axRc9WznI0uQWsjv_SURLIT8", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2449281, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "羽山はるや🪶", "screen_name": "hnhr_gt", "avatar_url": "https://pbs.twimg.com/profile_images/2035639356191621120/T8xzijbz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/974644100367450112/1758283287/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 9}, {"id": 2882014, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こめくる　おむ💛🍽", "screen_name": "omuomu_0620", "avatar_url": "https://pbs.twimg.com/profile_images/2003813841294196736/4NrAgmpP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4911214502/1766581434/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 129}, {"id": 2977069, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "どろ", "screen_name": "kno_chen206", "avatar_url": "https://pbs.twimg.com/profile_images/1800236489026228224/oFP3xrBa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429120231197220866/1718044811/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all"