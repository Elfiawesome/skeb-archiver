f-d3ca341020ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3870b83a9a25b6ec0bdee963b7223387", "srcset": "https://si.imgix.net/1843afd5/uploads/origins/00e19e6a-4abc-4b65-921f-d3ca341020ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3870b83a9a25b6ec0bdee963b7223387, https://si.imgix.net/1843afd5/uploads/origins/00e19e6a-4abc-4b65-921f-d3ca341020ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c8381c957a8d505e8087bfd6e3b7202 2x, https://si.imgix.net/1843afd5/uploads/origins/00e19e6a-4abc-4b65-921f-d3ca341020ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad1799336bded40f4b2851f221878124 3x"}, "body": "Hello, I would like to request a outfit for my demon / fallen angel character \"Lequiste.\"\n\nHe typically wears aristocratic and military fashion, but please design whatever you like. \n\nHe is a slightly yandere demon character with a sweet side. Over a few thousand years old and uses a lance as his weapon of choice. His favorite colors for clothing are usually blue, red, and white, but other colors are also fine too, please do as you prefer.\n\nHis reference: https://imgur.com/a/cxvXCCE\nHis clothing: https://imgur.com/a/Fmr3Q7A\n\nHope this is alright, thank you!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidaihuku_sub/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6c7c5f8c1e970a852be8b13f2f61101", "srcset": "https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6c7c5f8c1e970a852be8b13f2f61101, https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1de15aefad0ba4d1b47ab6d438781151 2x, https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6a554c40c5ffc253ce73411e2e820c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d4c8d47cb5c5409d8f0ec03d898beb", "srcset": "https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d4c8d47cb5c5409d8f0ec03d898beb, https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f25c3a3fb0190a56e391093be7bd58f1 2x, https://si.imgix.net/1b0c845f/uploads/origins/eb89a047-1591-466b-8e20-c6d74c8bf1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f1cccbb4a8467f84218a557e15812ee1 3x"}, "body": "初めまして。\nとても素敵なキャラデザを拝見してぜひご依頼したいと思いリクエスト致しました！\n下記要素をいれてキャラデザをお願いできますでしょうか？\n\n◾︎全体のイメージ:殺生が苦手な悪魔または死神モチーフが嬉しいです。\nお花や動物を愛でたいのに触れることができず、遠くから優しく見守っている子。\n儚げな雰囲気で、やる気が無さそう、眠そうな感じにしていただけますと幸いです！\n\n◾︎長いモフモフのしっぽ\n◾︎ケモ耳(角なし)\n◾︎眠いようなおっとりした目(ジト目気味)\n◾︎唯一のオトモのような相棒がいると嬉しいです\n◾︎女の子っぽい感じでお願いしたいです。\n\nたくさんお伝えしてしまい申し訳ございません。\nご検討のほどよろしくお願いいたします🙇‍♂️\n\n匿名でのリクエストさせていただいておりますが、納品後の実績公開やポストはしていただいても大丈夫でございます🙇‍♂️", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daidaihuku_sub/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913180, "client_id": 1362859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bae1fe825e091ad8197479e5369c27e", "srcset": "https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bae1fe825e091ad8197479e5369c27e, https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0edbf8d669287f0c1e45fd1a16138415 2x, https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76528ba14dd716751adefb01013ccb64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89b70524ca0c9de7584bad7d650e38d5", "srcset": "https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89b70524ca0c9de7584bad7d650e38d5, https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=830a5387c776d2ddc67de6c5705f89eb 2x, https://si.imgix.net/dd23761d/uploads/origins/da2e8d43-0be5-4920-884a-dde57e930dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08695ce2baa60d5bac24b37cac48fd65 3x"}, "body": "だいだいふく様\n初めまして、怠惰ヌキと申します！\nXにてイラストを拝見させていただき、是非当VTuberのイラストをお願いしたいと思い、リクエストを送りました。\n\n▮リクエスト内容\n\n▷使用想定\n・各種SNSでの画像投稿\n・Youtube/Twitch(収益化済み)での配信・動画内イラスト、サムネイル 等\n\n▷仕様\n宛名/背景など複数レイヤーがある場合、各レイヤーが分かれたPSD