://twitter.com/kobu_ride/status/1617719085353115648/photo/2\nhttps://twitter.com/kobu_ride/status/1615952323599077376/photo/1\n\nできれば、この赤毛のドラゴンは、あなたのかわいい女の子のスタイルで描いて、よりかわいく・女性らしい姿を表現してほしいです。\n\n自由な発想で描いてください。服装を変えてもいいし、新しい服をデザインしてもいい。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kobu_ride/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2548040, "client_id": 439085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afb4419c/uploads/origins/2a009673-3439-423f-9381-591deea46d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d537374260b7e665d103cc8d882c760", "srcset": "https://si.imgix.net/afb4419c/uploads/origins/2a009673-3439-423f-9381-591deea46d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d537374260b7e665d103cc8d882c760, https://si.imgix.net/afb4419c/uploads/origins/2a009673-3439-423f-9381-591deea46d42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=327c78762a49486bada310f342416209 2x, https://si.imgix.net/afb4419c/uploads/origins/2a009673-3439-423f-9381-591deea46d42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=931f59b74c77c18fbd7c0571a060b93f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afb4419c/uploads/origins/2a009673-3439-423f-9381-591deea46d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6118aba8bfa456c68d118852561d380", "srcset": "https://si.imgix.net/afb4419c/uploads/origins/2a009673-3439-423f-9381-591deea46d42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6118aba8bfa456c68d118852561d380, https://si.imgix.net/afb4419c/uploads/origins/2a009673-3439-423f-9381-591deea46d42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu