\u5ea6\u3067\u3059\u304c\u30c9M\u5c0f\u8aac\u306e\u633f\u7d75\u306b\u5229\u7528\u3057\u305f\u3044\u3067\u3059\n\u30ad\u30e3\u30e9\uff1a\u685c\u5742\u8a69\u7e54\u3001\u6e21\u8fba\u661f(\u30c9\u30ec\u30b9)\u3001\u6e21\u8fba\u661f(\u30cd\u30b0\u30ea\u30b8\u30a7)\u3001\u30bf\u30cb\u30a2\u3001\u5973\u9b54\u8853\u5e2b\u3001\u30bf\u30cb\u30a2(\u30cd\u30b0\u30ea\u30b8\u30a7)\n\u30b7\u30c1\u30e5\uff1a\n\u958b\u811a\u3057\u3066\u3044\u308b\u7279\u5927\u30dc\u30c6\u8179\u7537\u304c\u685c\u5742\u8a69\u7e54\u3068\u6e21\u8fba\u661f(\u30c9\u30ec\u30b9)\u306e\u4e8c\u4eba\u306b\u5de6\u53f3\u304b\u3089\u4e21\u8155\u3092\u8d85\u4e73\u3067\u631f\u3093\u3067\u62d8\u675f\u3055\u308c\u3001\n\u80cc\u5f8c\u306b\u7acb\u3064\u5973\u9b54\u8853\u5e2b\u306b\u5598\u304e\u9854\u3092\u8d85\u4e73\u3067\u5c01\u3058\u3089\u308c\u7d76\u9802\u3057\u3066\u3044\u308b\u59ff\u3092\u30bf\u30cb\u30a2&\u30bf\u30cb\u30a2(\u30cd\u30b0\u30ea\u30b8\u30a7)\u306e\u4e8c\u4eba\u306b\u89b3\u5bdf\u3055\u308c\u306a\u304c\u3089\n\u6e21\u8fba\u661f(\u30cd\u30b0\u30ea\u30b8\u30a7)\u304c\u7740\u8863\u8d85\u4e73\u30dc\u30c6\u8179\u3092\u5e8a\u306b\u5727\u3057\u6f70\u3057\u306a\u304c\u3089\u30a2\u30ca\u30eb\u304b\u3089\u9019\u3044\u51fa\u3066\u304f\u308b\uff08\u51fa\u6765\u308c\u3070\u592a\u817f\u3088\u308a\u4e0a\u307e\u3067\uff09\u30c9M\u30db\u30a4\u30db\u30a4\u30b7\u30c1\u30e5\n\u8868\u60c5\u306f\u5168\u54e1M\u7537\u3092\u30b4\u30df\u3092\u898b\u308b\u51b7\u3081\u305f\u76ee(\u9854\u306e\u4e0a\u90e8\u3084\u76ee\u5143\u307e\u3067\u5f71\u304c\u304b\u304b\u308b\u611f\u3058\u3067\u77b3\u306e\u30cf\u30a4\u30e9\u30a4\u30c8\u306a\u3057\u5e0c\u671b)\u3067\n\u685c\u5742\u306f\u60aa\u3068\u602f\u3048\u304c\u96d1\u3058\u308b\u4fae\u8511\u3001\u6e21\u8fba(\u30c9\u30ec\u30b9)\u3068\u30bf\u30cb\u30a2(\u30cd\u30b0\u30ea\u30b8\u30a7)\u306f\u5909\u614b\u30de\u30be\u73a9\u5177\u3092\u5f04\u3076\u5632\u7b11\u3001\n\u6e21\u8fba(\u30cd\u30b0\u30ea\u30b8\u30a7)\u3001\u30bf\u30cb\u30a2\u3001\u5973\u9b54\u8853\u5e2b\u306f\u5909\u614b\u3078\u306e\u5a