2\u30fc\u30b7\u30e5\u306e\u8a95\u751f\u82b1\u3067\u3059\u3002\n\u80cc\u666f\u306f\u30b5\u30b5\u30e6\u30ea\u306e\u82b1\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u524d\u666f\u306b\u300cHappy Birthday Lilliaush!\u300d\u306e\u6587\u5b57\u3068\u3001\u9d09\u691b\u3055\u3093\u306e\u30b5\u30a4\u30f3\u3092\u3044\u308c\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u4ee5\u4e0b\u3001\u30ea\u30ea\u30a2\u30fc\u30b7\u30e5\u306e\u8a73\u7d30\u3067\u3059\u3002\n\n\u30fb\u7a2e\u65cf\u2026\u4eba\u9593\n\u30fb\u5e74\u9f62\u202617\u6b73\n\u30fb\u8eab\u4f53\u7684\u7279\u5fb4\u2026\u8eab\u9577170cm\u3002\u5168\u8eab\u306b\u3057\u306a\u3084\u304b\u306a\u7b4b\u8089\u304c\u3064\u3044\u3066\u3044\u3066\u3059\u3089\u308a\u3068\u3057\u3066\u3044\u308b\u3002\u30d0\u30b9\u30c8\u306fAAA\u30ab\u30c3\u30d7(\u8ca7\u4e73\u30b3\u30f3\u30d7\u30ec\u30c3\u30af\u30b9\u306f\u306a\u3044)\u3002\n\u30fb\u9aea\u3068\u76ee\u3068\u307e\u3064\u6bdb\u306e\u8272\u2026\u30e1\u30bf\u30ea\u30c3\u30af\u30d6\u30eb\u30fc(\u5149\u306e\u5f53\u305f\u308a\u5177\u5408\u3067\u91d1\u5c5e\u306e\u3088\u3046\u306a\u5149\u6ca2\u304c\u51fa\u308b\u9752)\n\u30fb\u9854\u3064\u304d\u2026\u7aef\u6b63\u306a\u9854\u7acb\u3061\u3002\u5c11\u3057\u5730\u5473\u3081\u306e\u7f8e\u5f62\u3002\u76ee\u5143\u306f\u6dbc\u3057\u3052\u3067\u5c11\u3057\u30c4\u30ea\u76ee\u3002\u4e8c\u91cd\u77bc\u3002\u7709\u306f\u5c11\u3057\u7d30\u3081\u3002\n\u30fb\u670d\u88c5\u2026\u30a2\u30aa\u30b6\u30a4+\u9769\u93a7+\u7de8\u307f\u4e0a\u3052\u30d6\u30fc\u30c4\u306e\u30a4\u30e1\u30fc\u30b8\uff08\u8cc7\u6599\u3067\u306f\u958b\u895f\u306e\u3088\u3046\u306b\u63cf\u304b\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u30a2\u30aa\u30b6\u30a4\u98a8\u306e\u9589\u3058\u305f\u895f\u306b\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\uff09\u3002\u8170\u306e\u5de6\u5074\u306b\u9752\u3044\u5200(\u65e5\u672c\u5200)\u3092\u3001\u53f3\u5074\u306b\u8d64\u3044\u5200(\u8107\u5dee)\u3092\u4f69\u3044\u3066\u3044\u308b\u3002\n\u30fb\u6027\u683c\u2026\u7a4f\u3084\u304b\u3067\u512a\u3057\u3044\u30