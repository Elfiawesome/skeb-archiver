好きで森や花畑に縁があり、その他戦場、北欧風の街並みなどに馴染みがあるキャラクター達ですが、全く違うものでも構いません。\n神々しいものや禍々しいもの、おだやかなものなんでも嬉しいです。\n服装は基本資料のものでお願いいたします。\n\n\n何か問題あれば御手数ですがキャンセル、もしくは再送いただけますと幸いです。\nご縁があれば何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1L5Fwf9q2IamFl1OX6Vd86m1RXVFhY4Rb", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cabbage6491/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3843468, "client_id": 2752312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be77dd82/uploads/origins/834040b4-7ec0-45b9-967c-a41f1fc463e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68231bad84832df8147aa8d39d9e8ffc", "srcset": "https://si.imgix.net/be77dd82/uploads/origins/834040b4-7ec0-45b9-967c-a41f1fc463e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=68231bad84832df8147aa8d39d9e8ffc, https://si.imgix.net/be77dd82/uploads/origins/834040b4-7ec0-45b9-967c-a41f1fc463e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05b6c8b5ccca1effc19ecefeb2fd0f05 2x, https://si.imgix.net/be77dd82/uploads/origins/834040b4-7ec0-45b9-967c-a41f1fc463e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b49cbc40501407e904b64376116ff745 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be77dd82/uploads/origins/834040b4-7ec0-45b9-967c-a41f1fc463e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=183f1500875f0015103657f8db6f2a4b", "srcset": "https://si.imgix.net/be77dd82/uploads/origins/834040b4-7ec0-45b9-967c-a41f1fc463e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=183f1500875f0015103657f8db6f2a4b, https://si.imgix.net/be77dd82/uploads/origins/834040b4-7ec0-45b9-967c-a41f1fc463e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=c