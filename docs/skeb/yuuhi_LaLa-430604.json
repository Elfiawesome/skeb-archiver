&h=200&s=5d66639213f12048f2bbc24a163b3eff", "srcset": "https://si.imgix.net/36639a53/uploads/origins/d2930c10-418a-4186-a4c8-496c31209a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d66639213f12048f2bbc24a163b3eff, https://si.imgix.net/36639a53/uploads/origins/d2930c10-418a-4186-a4c8-496c31209a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bedf07df83a9eb3b31cc732c887bb2c4 2x, https://si.imgix.net/36639a53/uploads/origins/d2930c10-418a-4186-a4c8-496c31209a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=047f64dc4bcf84489c4da656fd1ac5ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36639a53/uploads/origins/d2930c10-418a-4186-a4c8-496c31209a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f393e0fac430622b2d31ac72c20b4cf6", "srcset": "https://si.imgix.net/36639a53/uploads/origins/d2930c10-418a-4186-a4c8-496c31209a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f393e0fac430622b2d31ac72c20b4cf6, https://si.imgix.net/36639a53/uploads/origins/d2930c10-418a-4186-a4c8-496c31209a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b3fbcdec21919a220b3be2789f6f7b8 2x, https://si.imgix.net/36639a53/uploads/origins/d2930c10-418a-4186-a4c8-496c31209a5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c41d290b0e5df66b7a2ff36551055418 3x"}, "body": "私のツイッターアイコン(https://pbs.twimg.com/profile_images/1073575089671593985/QWzE7sh_.jpg)のキャラ、ルークが、一口サイズくらいのサイズ感で、せいやくんに丸呑みされてしまい、生きたままお尻から出されちゃう作品をお願いします\n\n丸呑みは\n①翼を摘まれて持ち上げられて口に運ばれている様子\n②口に入れてしまいもぐもぐな様子\n③飲み込まれてしまう様子\n④お腹に入れられてしまった様子\n⑤「数時間後…」等の表記後、体内でたっぷり弄ばれてぐったりなルークとそれに対するせいやくんの様子\nを漫画形式または差分形式で、②〜⑤は、せいやくんの様子＋体内のルークの様子を吹き出しで…といった形でお願いしたいと思います\n\nお尻から出しちゃう部分は\n⑥「数日後…」等の表記の後、お腹が鳴って排泄が近いことを感じるせいやくん(お腹痛い感じでなくトイレに行きたいくらいの感覚)\n⑦トイレで排泄しようとする、または排泄途中なシーン\n⑧排泄を終え、すっきりなせいやくんと出されてしまったルーク\n⑨ルークがトイレに出てしまったのに気づき、からかうせいやくん\n⑩トイレを流してしまうシーン\nといった感じでお願いします\n\n丸呑みシーンと排泄シーンでページが分かれると良さそうです\n\n全体的にせいやくんがルークをバカにするような、からかうようなセリフがあると嬉しいです\n\nまた、ツイートによる紹介を許可頂きたく思います\nよろしくお願いします", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuuhi_LaLa/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 667956, "client_id": 1168567, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c96179f/uploads/origins/ad33dcbb-6e20-4ea6-a81e-58c37315e809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d3df8a2082cd92ba38f6f6eea20c79", "srcset": "https://si.imgix.net/2c96179f/uploads/origins/ad33dcbb-6e20-4ea6-a81e-58c37315e809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d3df8a2082cd92ba38f6f6eea20c79, https://si.imgix.net/2c96179f/uploads/origins/ad33dcbb-6e20-4ea6-a81e-58c37315e809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62ff8a26ed883397a72161d0d15af8ec 2x, https://si.imgix.net/2c96179f/uploads/origins/ad33dcbb-6e20-4ea6-a81e-58c37315e809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7caea7f9c9cd0c2d1b6a28d324c10ac5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c96179f/uploads/origins/ad33dcbb-6e20-4ea6-a81e-58c37315e809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a170aa0283cfeb4fb838cd81be8fdded", "srcset": "https://si.imgix.net/2c96179f/uploads/origins/ad33dcbb-6e20-4ea6-a81e-58c37315e809?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a170aa0283cfeb4fb838cd81be8fdded, https://si.imgix.net/2c96179f/uploads/origins/ad33dcbb-6e20-4ea6-a81e-58c37315e809?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&