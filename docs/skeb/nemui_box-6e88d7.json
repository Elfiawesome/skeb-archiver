ation": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67f03d7a/uploads/origins/1f511dea-c17a-4132-b8d1-985ea1250488?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=691a0936538af4d722050c4c2d4e71c6", "srcset": "https://si.imgix.net/67f03d7a/uploads/origins/1f511dea-c17a-4132-b8d1-985ea1250488?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=691a0936538af4d722050c4c2d4e71c6, https://si.imgix.net/67f03d7a/uploads/origins/1f511dea-c17a-4132-b8d1-985ea1250488?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81b7ff8b1f5d77c462ea1b967b759d25 2x, https://si.imgix.net/67f03d7a/uploads/origins/1f511dea-c17a-4132-b8d1-985ea1250488?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b1449370073b4b680b1c04484582a77 3x"}, "body": "こんにちは！なつきです。いつも素敵なイラストありがとうございます！\n今回はほしこさんにコテキャを描いて頂きたいです！\n\n<容姿の特徴>\n黒髪黒目\nハーフアップ(アレンジして頂いて大丈夫です！)\n前髪は左目にかかるくらい\n桜柄の着物、袴(こちらもある程度ほしこさんのデザインでアレンジしていただけるとうれしいです💕)\n和洋折衷みたいな感じで可愛いめにしてもらえるととても喜びます…！そのままでももちろん大丈夫です。\n\n<表情など>\n基本的にはおまかせします！\nおしとやか系ではなく、活発なタイプです！\n\nずっと応援してます！！🙌🙌\n楽しみに待っています～！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemui_box/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2227193, "client_id": 2207365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=818cebeb0aa263be015babfe11e9a2a7", "srcset": "https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=818cebeb0aa263be015babfe11e9a2a7, https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c8bad3f74760fbda45c0b07fbec2a63 2x, https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58f14d6dff8059c881fda98853345920 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39508aaef944cd97f79e27037d94bb30", "srcset": "https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39508aaef944cd97f79e27037d94bb30, https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c953b6647f8f3c8282625dd5b8fd4bd 2x, https://si.imgix.net/60ce680f/uploads/origins/d4fd9203-e306-478d-832e-83dc93d58050?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1008aaf7b792f53ca0583778a8e5f66c 3x"}, "body": "🪬ねむいほしこ💫様\n\n初めまして！\n個人Vtuberとして活動している、ねこたぬきと申します。\nぜひ私ねこたぬきを描いていただきたくリクエストを送らせていただきました！\n\n■内容\n\n🪬ねむいほしこ💫様の描く女の子がかわいいのはもちろん、\nデザインされているお洋服もとってもとってもとーーーってもかわいいので、\nこちらのお洋服（https://x.com/nemui_box/status/1831341937364001042）\nを着せていただけると嬉しいです🎀\n（金額内でもし可能でしたらスカウター?有り無し差分か表情差分を描いていただけると嬉しいです！\n少しでもご負担であれば無視してください！）\n\n構図、ポーズは無邪気、元気、かわいい感じでおまかせでお願いいたします！\n\n髪型は現在３種類（ショートヘア、ロングヘア、リボンヘア）あるのですが、そちらから選んで頂いても構いませんし、\nお好きにアレンジしていただいて構いません！\n\n▲ねこたぬきの瞳の中に、頭につけてるキャンディと同じ色のハイライトがあります。\n▲肩の上にいるのはたぬきぱんつという生き物です。たぬきぱんつがいるかいないかはお任せいたします！\n\n【使用用途】\n・サムネイルや動画内、SNS、アイコン、バナー、有料支援サイトでの使用\n・メッセージ等を入れてネットプリントでの期間限定の配布(メンバーシップ加入者様限定にする場合もあり)\n・メンバーシップ、有料サイト支援者様向けに配布する壁紙\n作品のイメージを損なわない程度の軽微な加工(例；色調補正やトリミングなど)をご許可頂きたいです！\n\n上記使用用途が難しい場合、大変お手数ですがキャンセルしていただけますと幸いです。