f14c0b283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eba75390837683008713755e22379cd7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7281384/uploads/origins/cef27872-9c69-4577-bf0a-220f14c0b283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08262529b2fec36e7ce9bfb0d66d1576", "srcset": "https://si.imgix.net/f7281384/uploads/origins/cef27872-9c69-4577-bf0a-220f14c0b283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08262529b2fec36e7ce9bfb0d66d1576, https://si.imgix.net/f7281384/uploads/origins/cef27872-9c69-4577-bf0a-220f14c0b283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=252426501a05596eaad15a1d2f0393d0 2x, https://si.imgix.net/f7281384/uploads/origins/cef27872-9c69-4577-bf0a-220f14c0b283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5b72e650c7a8efd1b63796acbcfd468 3x"}, "body": "楽しげな表情のアニメキャラクターが描かれている。このキャラクターは、エルフのような特徴的な大きく尖った耳と、ブロンドの髪から突き出た2本の小さな黒い角を持っている。髪は長く、ウェーブがかかっており、風になびいたように見える。このキャラクターの目は大きく琥珀色で、目に見える光の反射は光沢のある表面を示唆している。頬にはほのかな赤みがあり、歯を見せて穏やかな笑みを浮かべている。\n\nキャラクターの肌は色白で、健康や活力を暗示するような柔らかな輝きを放っている。背景はピントが合っていないが、おそらく自然光と思われる暖かい光で照らされているように見え、全体的に心地よく穏やかな雰囲気を醸し出している。光の角度が首とあごの下に影を作り、イメージに奥行きを与えている。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ur_lilith/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2733304, "client_id": 1794155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b0305c2/uploads/origins/42f65294-70b1-4775-9194-1a340f0bf582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1dd33d9a29ef3b75f7fd6d6cb8ed3591", "srcset": "https://si.imgix.net/2b0305c2/uploads/origins/42f65294-70b1-4775-9194-1a340f0bf582?bg=%23fff&aut