/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c5b83183092cea13a287a0ea53dab96", "srcset": "https://si.imgix.net/7275c071/uploads/origins/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c5b83183092cea13a287a0ea53dab96, https://si.imgix.net/7275c071/uploads/origins/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69c81c209a7938bc812216ec4c4eeb37 2x, https://si.imgix.net/7275c071/uploads/origins/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7afea0b50bb41dee873b188c456cd51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7275c071/uploads/origins/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021f580bb70183cad9fc5adc7f56207b", "srcset": "https://si.imgix.net/7275c071/uploads/origins/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=021f580bb70183cad9fc5adc7f56207b, https://si.imgix.net/7275c071/uploads/origins/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2cdba1b15bb3e0ae40682dc247e53d3 2x, https://si.imgix.net/7275c071/uploads/origins/fd6c563d-c828-4dbc-bd50-629b030c18d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed1754662abbe83ea44a5272f133ee0f 3x"}, "body": "水素様\n\n初めまして、YouTubeでvtuber活動してるアストレア･フレーズと申します。アピールありがとうございます！\n固定の過去絵を拝見させていただき絵柄がとても好みだったのでリクエストを送らせていただきました！\n\n\n☆依頼内容:アストレア･フレーズを描いて欲しいです。\n\n\n･Xに上げていたステンノ様がとても可愛くて素敵でしたので\n可愛い雰囲気に仕上げていただければ嬉しく思います！\n最終的な雰囲気や構図などは水素様にお任せお願いしたく思います。\n（服装なども好みに替えていただいても大丈夫です！）\n\n\n･抱いているくまは描かなくても大丈夫です。\n\n･使用用途上多くの場面で使用したいので髪等の上半身の見切れがないように描いていただきたいです。\n\n･またサムネイル等でも使用したいので\n人物のみ透過されている物、または背景と人物は別レイヤーで描いて頂けますと幸いです（PSD）\n\n☆使用用途\nYouTubeサムネイル、SNSでの投稿やアイコンやヘッダーでの使用。\n\n☆設定\n立派な女神になる為に見習い天使として人間界でお仕事と修行をしている。\n元々はいちごの国出身の妖精だったが天界から女神になる素質を見出され天界へ\n歌うことが3度のご飯よりも好きでより多くの人に歌を届けたくYouTubeで活動を始める。\n可愛い物や可愛い人に目がない。\n\n三面図がないので正面の資料のみ失礼致します。\nお忙しいところ申し訳ありませんがご検討よろしくお願い致します。\nhttps://x.com/asuko_ichigo15/status/1699117184889545074\n\nhttps://x.com/asuko_ichigo15/status/1699117184889545074", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@modotteku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3321743, "client_id": 3143432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe4350b6/uploads/origins/25e6a8cf-2eaf-4806-9cae-39f82c95eb07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9e6cc8da525ebe5aab0a06f7e20fd0c", "srcset": "https://si.imgix.net/fe4350b6/uploads/origins/25e6a8cf-2eaf-4806-9cae-39f82c95eb07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9e6cc8da525ebe5aab0a06f7e20fd0c, https://si.imgix.net/fe4350b6/uploads/origins/25e6a8cf-2eaf-4806-9cae-39f82c95eb07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2b1b88d7cdbf4039f5e5eb9373cab54 2x, https://si.imgix.net/fe4350b6/uploads/origins/25e6a8cf-2eaf-4806-9cae-39f82c95eb07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb42c720e9f119b61adcf6a057f1acb4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe4350b6/uploads/origins/25e6a8cf-2eaf-4806-9cae-39f82c95eb07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cea15dbc4e2dc5830e2e84207c25128", "srcset": "https://si.imgix.net/fe4350b6/uploads/origins/25e6a8cf-2eaf-4806-9cae-39f82c95eb07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t