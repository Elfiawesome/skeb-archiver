8b3a 2x, https://si.imgix.net/9fcf05b2/uploads/origins/5ff38eda-3331-4dd2-9db3-545c50625ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e46158d72eac838a8fb264dd2bec49b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fcf05b2/uploads/origins/5ff38eda-3331-4dd2-9db3-545c50625ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66ff8403167af4d2b99e051a08e09aa4", "srcset": "https://si.imgix.net/9fcf05b2/uploads/origins/5ff38eda-3331-4dd2-9db3-545c50625ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66ff8403167af4d2b99e051a08e09aa4, https://si.imgix.net/9fcf05b2/uploads/origins/5ff38eda-3331-4dd2-9db3-545c50625ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c38b23018381aab59fc1c853e6bafa3 2x, https://si.imgix.net/9fcf05b2/uploads/origins/5ff38eda-3331-4dd2-9db3-545c50625ce5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16619bbb8798ecbcb9bc58ddf43abb1c 3x"}, "body": "こんにちは！今回は僕のオリジナルキャラクター、ヘルツの新しい服を描いてほしいんだ。\nもしこの3つの服を描きたくなければ、彼のために新しい服を好きなようにデザインしてください。彼の新しい服は3セットあり、選んで描くことができます。もし一緒に描けるようなものが複数ある場合は、必要に応じて量を増やしてください。\nヘルツはパンクが好きな悪魔のような白熊の少年です。顔には十字架が描かれ、左目には白い丸があり、2本の尖った吸血鬼の歯もあります。バッドでキュートな彼を描いてほしい。\nポーズや構図は自由です！できれば、クマの耳があるバージョンとないバージョンが欲しいです。背景とキャラクターを別々のレイヤーにできることを望みますが、もちろんなくても構いません。\n 私の要望を考慮していただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1GlOVjNU0rdpQfoToQPpqShKdHPd5mytC?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoi_666/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3225636, "client_id": 2553206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2236eba6defe5014c5c649b0abd50c85", "srcset": "https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2236eba6defe5014c5c649b0abd50c85, https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78f92f2970b928dfbd5fada7da9282c5 2x, https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dfd2b89e0b7483f21a8ddbef4223276 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b11250b66c5684cddbd1bb0c051c979", "srcset": "https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b11250b66c5684cddbd1bb0c051c979, https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d0da271b51a5f37dddff809ce388eda4 2x, https://si.imgix.net/c4b324ff/uploads/origins/c523a7e8-767f-4974-8b43-00a5cc55bfb2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9653577090a2ad68c50fa1a3f728d37b 3x"}, "body": "はじめまして。結月単勝谷と申します。\nA⊖I様のゴシック、パンク？で可愛いイラストを検索より拝見し、\nぜひIRIAMライバーの「華咲結月」さんを描いていただきたいと思いました。\n\n■希望のイラスト\n構図･ポーズ:特に指定ありませんが、馬券や馬が居たり、その他ざっくりで申し訳ないのですが、ギャルっぽいと嬉しいです。\n\n服装:参考資料参照\n納期時期に合わせた季節感のイラストだと嬉しいです。\n（難しければA⊖I様におまかせいたします）\n▼キャラクター像▼\n･三度の飯と競馬と可愛い女の子が好きなギャル\n･金髪ツインテール\n･地雷系\n･ピンク、ブラックがイメージカラー\n\n※本人とわかる程度の髪型、服装改変はokです！\n\n■使用用途\n商用利用の可能性あり。\n･IRIAM（収益が発生いたします）にてサムネイルとして使用\n･返礼品としての使用（ネットプリント等）\nおはよう（挨拶）ポストにて使用。\n\n■サイズ\nおまかせ\nサムネイル等に使用するため、\n髪の毛の先や耳、指の先等が切れていない構図ですと幸いです。\n\n■その他\n人物のみの背景透過もお願いいたします。\nファイル形式は、キャラクターと背景を分けたファイルでいただけると幸いです。\n※PDSではなく、Jpeg又はpngで納品して頂けたら幸いです。\n\n参考資料\nhttps://twitter.com/hanayui_umajo/status/1820660106972803464?s=46&t=kXiTD9w-Xs4LyfXSayGznQ\n\nskeb初めて利用するため、不慣れなもので、至らぬ点はどうかご容赦くださいますようお願い申し上げます。\nまた、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iQjU9wHrC0xBl2TCKUhr-gb2Ot6BJ22Q", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aoi_666/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3225636, "client_id": 2412221, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68f51cdf/uploads/origins/797a5723-e399-4fe7-b074-795556073562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aff9528c0db325d92424550051c8a3ca", "srcset": "https://si.imgix.net/68f51cdf/uploads/origins/797a5723-e399-4fe7-b074-795556073562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aff9528c0db325d92424550051c8a3ca, https://si.imgix.net/68f51cdf/uploads/origins/797a5723-e399-4fe7-b074-795556073562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80e75e0b719c3e2fb363ad3327b10b00 2x, https://si.imgix.net/68f51cdf/uploads/origins/797a5723-e399-4fe7-b074-795556073562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02d0d582855c401d0167892a74a21038 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68f51cdf/uploads/origins/797a5723-e399-4fe7-b074-795556073562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64136cbbcbba196b23af7e43a66c8a44", "srcset": "https://si.imgix.net/68f51cdf/uploads/origins/797a5723-e399-4fe7-b074-795556073562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20