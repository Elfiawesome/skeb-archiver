bp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54cb34c6c752910fe8f133455f7b7d10 3x"}, "body": "こんにちは！あなたの作品が大好きです。私のVTuberを描いていただけたら嬉しいです。彼女は眠そうなウサギ娘で、ピンク、ぬいぐるみ、ウサギ、イチゴ、そして可愛いものが大好きです！ポーズと背景はご自由に選んでください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1mXesjWs9fnpo7YiqmAtWTwqUVyn6L-Rf?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@muxxxx__/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3603883, "client_id": 3329826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0eb10f8/uploads/origins/6bfecde6-4cb1-40cc-8dd8-fa6052bd3f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a1e2eed170d3aaad459dabd3d9af4d", "srcset": "https://si.imgix.net/a0eb10f8/uploads/origins/6bfecde6-4cb1-40cc-8dd8-fa6052bd3f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1a1e2eed170d3aaad459dabd3d9af4d, https://si.imgix.net/a0eb10f8/uploads/origins/6bfecde6-4cb1-40cc-8dd8-fa6052bd3f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1451d0e39dbdba0c8c64b316981eca13 2x, https://si.imgix.net/a0eb10f8/uploads/origins/6bfecde6-4cb1-40cc-8dd8-fa6052bd3f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1899b730df7f9bfa9e6771f3f745e67a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0eb10f8/uploads/origins/6bfecde6-4cb1-40cc-8dd8-fa6052bd3f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=224fb524680137f64f0f9715c3f3e125", "srcset": "https://si.imgix.net/a0eb10f8/uploads/origins/6bfecde6-4cb1-40cc-8dd8-fa6052bd3f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=224fb524680137f64f0f9715c3f3e125, https://si.imgix.net/a0eb10f8/uploads/origins/6bfecde6-4cb1-40cc-8dd8-fa6052bd3f70?bg=%23fff