t/46e20a1d/uploads/origins/9cb8eb3a-4d02-4edf-8b86-c58b61b373ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f15fff30debe7a542fe4344577cf50ba 3x"}, "body": "先ほど失礼致します！\nこんにちは！寝ドコ先生の絵がとても好きです！ \n よければ、友人とのTRPGの探索者ちを寝ドコ先生の絵柄で見てみたい！相手の許可はもう得ています。\n\n\n①と②の中からお好きな二人組を描いていただければ大丈夫で、構図などはお任せします！\n\n海外からのリクエストなので、文法の誤りがあった場合はご了承ください。\n金額の問題であれば、再送要請をしていただけますと幸いです……！\nPSDデータで納品いただけると幸いです。また背景や宛名がある場合は、別レイヤーにしていただけますと大変嬉しいです。\n以下は参考資料です。\n①\nhttps://drive.google.com/drive/folders/1-dowBFHCojkgRgbLQdXBp7tsFxo9VmB6\n②\nhttps://drive.google.com/drive/folders/1vnBmPiHdq331sSU1gXckPEjudmZ_mOde", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nedokodko/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3380346, "client_id": 2959888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4bf3973244a0c315630b73567190f90", "srcset": "https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4bf3973244a0c315630b73567190f90, https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8e4577a62fcb2fd70995e4b1cef4102 2x, https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd068d60cbceafb821437795ea0ce724 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=941a55e0cf221fbae51ed972f09a702e", "srcset": "https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=941a55e0cf221fbae51ed972f09a702e, https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26ce54f393add8b32ce3515648e2ae37 2x, https://si.imgix.net/650c43e4/uploads/origins/3e5bc20d-fbed-44af-b6a9-74c0b48916d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb74017a57b1742789982c5687cca7ea 3x"}, "body": "先生、こんにちは。先生の作品が大好きです！もし可能であれば、私のキャラクターを描いていただけないでしょうか？\n\n以下は、キャラクターに関する情報である： \n\nhttps://drive.google.com/drive/folders/1Q-VFJcQcIp-Tcu8LZXLPKJ39IT4azvOr\n\n複数のキャラがやり取りする詰め込みを描いてほしいです。テーマは現代でお願いしたいです。\n\n料金に問題がございましたら、お手数ですがご再送いただけますと幸いです。もしキャラクターに難がある場合は、キャンセルすればいい。 \n\nご検討のほど、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nedokodko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3380346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=752e7eeba2a87d99751b4853ecc17cd8", "srcset": "https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=752e7eeba2a87d99751b4853ecc17cd8, https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11def41854026b66fc7c9f475bf06d81 2x, https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0f93680000dd4007b2b31141e1e8928 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4b34b108ff708381ea17ed444ed7343", "srcset": "https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4b34b108ff708381ea17ed444ed7343, https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4271d01dee7ad4ca5818f9c7489fb9b7 2x, https://si.imgix.net/e51f40e4/uploads/origins/67197e36-9550-4d4a-964c-e0168a4a294f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fc66355ee93b5f472d88bcf4b6b653e 3x"}, "body": "寢ドコさん、初めまして。\nSNSで寢ドコさんの素敵なイラストを拝見して、とても素敵で魅力的だったのでぜひイラストを描いていただきたいと思いリクエストさせていただきました。\n今回、お願いしたいのはTRPGで使用している探索者のイラストをお願いしたいです。\n\n▽使用用途\n個人観賞(PC壁紙等)及びSNSなどでの画像アップロード、自陣への共有\n\n【キャラクター】\nTRPGの探索者を2名お願いします。\n1人目\nプロフィール：\n男性/23歳/175cm\n性格：\nチャラそうな見た目に反し、温厚な好青年。\n誰に対しても優しい一面がある、子供ぽい一面もちょっとだけある。\n\n2人目\nプロフィール：\n女性/16歳/155~160cm辺り\n性格：\nとても明るく元気。\n困っている人を放っておけない。常に笑顔を絶やさない。\n\n【シチュエーション】\n背景：ひまわり畑、難しい場合は青空でも大丈夫です！\nポーズ：女の子に手を引かれる男の子(2人とも笑顔)\n人物以外はお任せのため、こちらの内容は採用していただかなくても大丈夫です。\n\nキャンセル・再送依頼をしていただいても構いません。\n寢ドコさんのご都合や体調を優先していただければと思います。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-WM_fMAsG9dXeldsv5q9ls2LV7vFdCUS", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nedokodko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3380346, "client_id": 2087673, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=790e9e2a2fa01b55f12ca4c9cb47a42e", "srcset": "https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=790e9e2a2fa01b55f12ca4c9cb47a42e, https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0ffca0d28569ab20ed5ae925d4083c2 2x, https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec98d61502c9c8cde41233f6c9e04171 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9b53c409be1eed53b77d827b3b8892", "srcset": "https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9b53c409be1eed53b77d827b3b8892, https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20c7f1bbd382cf08e6b9eeb64f1b29ae 2x, https://si.imgix.net/03d539ef/uploads/origins/b7d05a91-0fe7-4956-995e-87bbaa695614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2dbca1a297124bfe9e61f45d9eea280f 3x"}, "body": "こんにちは！\nTwitterのおすすめ欄でみて絵柄が可愛く惹かれました。\nとらあちくんが可愛くてニヨニヨしながら見てます……。\n\n\nhttps://drive.google.com/drive/folders/1rXMgnB_sCecifov-TwXnouE3VBpQxfj9?usp=drive_link\n\nこの度は上記リンクにキャラ詳細を載せている二人を書いていただきたく依頼しました。\n内容としては最近寒くなってきたので、「お互いで暖を取る二人」を描いていただきたいです。\nシチュエーションとしては、現場に行くまでの間の会話中で寒いという話になり寒さから相手で暖を取ろうとする、みたいなシチュエーションで。台詞に起こすと以下になります。\n\n「最近寒くなってきたね」\n「そうですね」\n「えいっ」（紫の子の手をポケットに入れてから自分の手を入れ、ぴとっとくっつく）\n「えっ」\n「あったかーい」\n「……（まぁいいか）手、冷たいですね」（ポケットの中で手をぎゅ）\n「寒いからね」\n\n※わかりにくいと思うのでお好きに描いていただいて構いません！できるだけくっついていると嬉しいです！\n\n\nキャラ詳細のせておきます。\n・白髪の子：身長172センチ。刑事。班長で上司。細身。紫の子に対して我儘をよく言う。\n・紫髪の子：身長192センチ。刑事。部下。筋肉質。敬語でおどおどした口調で遠慮しい。\n\n●一緒に住んでて距離感は近いです。付き合ってる？と言われるくらいには近いですが付き合ってないです。お互いのことを大事に想っていて夜は一緒に寝てるくらいの距離感です。なのでぴとっとくっつくのもいつものことかもしれません。\n\n\nお手数をおかけしますが、何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1rXMgnB_sCecifov-TwXnouE3VBpQxfj9?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nedokodko/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3380346, "client_id": 3280149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38c51e2455a094ed9e59bf6994aa3732", "srcset": "https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38c51e2455a094ed9e59bf6994aa3732, https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e84af99a9ffe9649ae022e8f01cfc80 2x, https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce006a7222340bf9aed0e724c72b86f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbdd358e6edc19567eef103ce661376c", "srcset": "https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbdd358e6edc19567eef103ce661376c, https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43ec2c550898844566974bceff322f68 2x, https://si.imgix.net/ce6cfd0e/uploads/origins/5ece25bf-c655-42f1-804f-b95f3fc9aff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d53bf75c63ca564379dec780fa03de58 3x"}, "body": "寝ドコ先生、はじめまして！私は先生の絵がとても好きですが、私のOCを描いてもらえますか？\n\nキャラクター↓\n\n女性：ミハイル（MIHA）\n165cm\n黒髪、緑の目。エア・インテーク。単眼鏡。顔にそばかすがある。\n落ち着いていて、冷静なお嬢さんは、感情を表現するのが苦手です。寿命が二年残っている天才。中国とロシアの混血。\n趣味：読書、撮影\n好きな食べ物：チョコレート、アップルケーキ\n\n男性：アニエット（Agnele）\n187cm\n金髪、青い目。傲慢な天才は、他人を駒として使う。MIHAにだけ優しい。ロシア人。\n趣味：料理\n好きな食べ物：ピザ、ドーナツ\n\n関係↓\n\n女性はチェス大会で一位を獲得し、男性はテレビ中継でこのシーンを見て、輝く女性に惹かれ、二人は友達になった。男性が女性にプロポーズしようとした時、彼女が記憶喪失症にかかっていることが分かりました。これは天賦の才能を使った代償です。記憶だけでなく、生活の仕方、呼吸の仕方、全部忘れてしまう。そのため、男性は自分の目を捧げた。\n\n構図は先生に渡して、自由に描いてください。\n当リクエストが難しいようでしたり、気乗りしないようであれば、どうかご遠慮なくキャンセルや金額の再送等のご対応をしてくださればと思います。文字を読んでくださってありがとうございます！\n\nhttps://drive.google.com/drive/folders/1lBiWaKwxgTeITh3KNv6ND1Modg2-RC62", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nedokodko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3380346, "client_id": 1999010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d01b3d0f/uploads/origins/d5b4cefe-c46f-4ac5-acd1-fa55ad18b467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3f03f8d82b5997ab4e201aaa44e693", "srcset": "https://si.imgix.net/d01b3d0f/uploads/origins/d5b4cefe-c46f-4ac5-acd1-fa55ad18b467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d3f03f8d82b5997ab4e201aaa44e693, https://si.imgix.net/d01b3d0f/uploads/origins/d5b4cefe-c46f-4ac5-acd1-fa55ad18b467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2