n◆\n\n\n詳細な指示\n基本的には氏田さんに一任したいです。\n強いて言うなら、アングラなシナリオ出身ですのでそういった仕事をしているワンシーンなどを希望します。釘バット片手に淡々と仕事している鉄血と、後ろで真剣に向き合っている純潔の図があればうれしいです。\n\nご一考よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1In6NHo_ltGzkAOrzxN5pzX1FkG7BnaHs?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3so57u/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d0420934/uploads/origins/dab86fde-ac52-4e40-afd8-83ba345846bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c8f34d525c4a99edb1eee036ee8e3d7", "srcset": "https://si.imgix.net/d0420934/uploads/origins/dab86fde-ac52-4e40-afd8-83ba345846bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c8f34d525c4a99edb1eee036ee8e3d7, https://si.imgix.net/d0420934/uploads/origins/dab86fde-ac52-4e40-afd8-83ba345846bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdb1d6fa1dba637c72f58c39a4302d58 2x, https://si.imgix.net/d0420934/uploads/origins/dab86fde-ac52-4e40-afd8-83ba345846bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd828e1ccc4cfcbebba3e0207abea691 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2744067, "client_id": 3157058, "nc": 128}, {"path": "/@3so57u/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2744067, "client_id": 2589226, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03a4cb5a/uploads/origins/beed99e6-6d00-4fe4-9ae1-b90ae814e61d?bg=%23fff&auto=format%2Ccompress