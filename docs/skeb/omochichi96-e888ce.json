070\u306e\u5973\u306e\u5b50\n \u8eab\u9577\u25b7160\u301c165cm \n\u5916\u898b\u25b7\u6de1\u3044\u9280\u9aea\u3001\u78a7\u773c\u3001\u6bdb\u5148\u3092\u7de9\u304f\u5dfb\u3044\u305f\u30ed\u30f3\u30b0\u3001\u5de6\u53f3\u306b\u8033\u4ed8\u8fd1\u307e\u3067\u4e09\u3064\u7de8\u307f \nMBTI\u25b7ISFJ \n \u9b54\u6cd5\u5177\u5e97\u306e\u5e97\u54e1\u3055\u3093\u3067\u3059\u2755(\u5f7c\u5973\u81ea\u8eab\u306f\u9b54\u6cd5\u304c\u4f7f\u3048\u307e\u305b\u3093\u3002) \n\u82b1\u3068\u672c\u304c\u597d\u304d\u306a\u672c\u306e\u866b\u3067\u3001\u3069\u3053\u304b\u795e\u79d8\u7684\u306a\u5370\u8c61\u304c\u3042\u308b\u5973\u306e\u5b50\u3067\u3059\u2755\n  \u8776\u3001\u30ea\u30dc\u30f3\u3001\u30cd\u30e2\u30d5\u30a3\u30e9\u3001\u30ab\u30b9\u30df\u30bd\u30a6\u3001\u96ea\u306e\u7d50\u6676\u3000coquette core\u3084bull core\u7b49\u304c\u4f3c\u5408\u3044\u307e\u3059\u2755(\u7121\u8996\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u5927\u4e08\u592b\u3067\u3059)  \n\u30a4\u30e1\u30fc\u30b8\u30bd\u30f3\u30b0\u3092\u307e\u3068\u3081\u305f\u30d7\u30ec\u30a4\u30ea\u30b9\u30c8\u3092\u6dfb\u4ed8\u3055\u305b\u3066\u3044\u305f\u304d\u307e\u3059\u3002\u3088\u308d\u3057\u3051\u308c\u3070\u3054\u6d3b\u7528\u304f\u3060\u3055\u3044\u3002\nhttps://youtube.com/playlist?list=PLSVCShTbzebsGFB64ZPXeB1G80LBT2G1b&si=ZqtGDXQXrYD7DNNG\n\n \u3010\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\u3011 \n\u53ef\u80fd\u3067\u3042\u308c\u3070\u6a2a\u9577\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u2755\n\u305d\u306e\u4ed6\u69cb\u56f3\u3001\u8868\u60c5\u3001\u8863\u88c5\u306a\u3069\u5168\u3066\u304a\u307e\u304b\u305b\u3044\u305f\u3057\u307e\u3059\u3002\n\u304a\u30e2\u30c1\u5148\u751f\u306e\u597d\u304d\u306a\u3088\u3046\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u305f\u3089\u5b09\u3057\u3044\u3067\u3059\u2755 \n\u8863\u88c5\u306f\u30d5\u30a9\u30eb\u30c0\u5185\u304b\u3089\u304a\u597d\u304d\u306a\u3082\u306e\u3092\u9078\u3093\u3067\u3044\u305f\u3060\u3044\u3066\u3082\u3001\u