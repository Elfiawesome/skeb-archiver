f1a\u8b66\u5bdf\u5b98\n\u8eab\u9577\uff1a179cm\u3000\u4f53\u91cd\uff1a75kg\u3000\u77b3\u8272\uff1a\u4e0d\u5b9a(\u8679\u8272)(\u30c4\u30ea\u76ee\u3060\u3068\u5b09\u3057\u3044)\u3000\u9aea\u8272\uff1a\u30aa\u30ec\u30f3\u30b8(\u30c4\u30f3\u30c4\u30f3\u3057\u305f\u30a4\u30e1\u30fc\u30b8\u3067\u304a\u3067\u3053\u304c\u898b\u3048\u308b\u9aea\u5f62\u3060\u3068Good)\u3000\u808c\u8272\uff1a\u5065\u5eb7\u7684\n\u53c2\u8003\u30b9\u30c6\u30fc\u30bf\u30b9\uff1aSTR 16\uff5cAPP 15\uff5cSIZ 14\uff5cINT 8\n\n\u30fb\u8868\u60c5\u5dee\u5206\u3001\u88c1\u91cf\u3067\u3044\u304f\u3064\u304b\n\u2514\u901a\u5e38\u306f\u5143\u6c17\u30cf\u30c4\u30e9\u30c4\uff01\u306a\u7b11\u9854\u5e0c\u671b\n\u2514\u306a\u304f\u3066\u3082\u3088\u3044\n\u30fb\u670d\u88c5\u6307\u5b9a\u3042\u308a(\u8a73\u7d30\u4e0b\u8a18)\n\u30fb\u69cb\u56f3\u6307\u5b9a\u306a\u3057(\u9759\u306e\u30a4\u30e1\u30fc\u30b8\u3088\u308a\u3082\u52d5\u306e\u30a4\u30e1\u30fc\u30b8)\n\u30fb\u79d8\u533fHO\u306b\u76f4\u63a5\u95a2\u4fc2\u3057\u306a\u3044\u305f\u3081\u958b\u793a\u3057\u307e\u3059\u304c\u3001\u30bb\u30eb\u30d5\u79d8\u533f\u3067\u300c\u4ea4\u901a\u4e8b\u6545\u304b\u3089\u4eba\u7269\u3092\u5e87\u3063\u3066\u982d\u90e8\u640d\u50b7\u3057\u305f\u904e\u53bb\u300d\u300c\u305d\u308c\u306e\u5f71\u97ff\u3067\u6d77\u99ac\u306b\u5f8c\u907a\u75c7\u304c\u6b8b\u308a\u3001INT\u6fc0\u6e1b\u300d\u3068\u3044\u3046\u8a2d\u5b9a\u3092\u6301\u3061\u307e\u3059\u3002\n\u2192\u2192\u305d\u306e\u4e0a\u3067\u2026\u2026\u5358\u7d14\u306a\u300c\u30d0\u30ab\u300d\u3068\u3044\u3046\u3088\u308a\u3082\u7279\u6b8a\u306a\u4e16\u754c\u89b3\u3092\u6301\u3064\u300c\u7406\u89e3\u3057\u96e3\u3044\u4eba\u300d\u3068\u3044\u3046\u30a4\u30e1\u30fc\u30b8\u306eINT\u6700\u4f4e\u5024\u4eba\u9593\u3067\u3059\u3002\u5e38\u306b\u4eba\u9593\u306e\u4e16\u754c\u306b\u6eb6\u3051\u8fbc\u3080\u30d0\u30b1\u30e2\u30ce\u306e\u3088\u3046\u306a\u6c17\u5206\u3067\u3001\u7121\u610f\u8b58\u306e\u3046\u3061\u306b\u5468\u56f2\u3092\u8b66\u6212\u3057\u306a\u304c\u3089\u751f\u304d\u3066\u3044\u3