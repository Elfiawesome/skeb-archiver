ab-a2a2-2750d30c0f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59946e6513e6ee659d5a63ebb8834c58", "srcset": "https://si.imgix.net/279ab163/uploads/origins/c0ede727-8650-4dab-a2a2-2750d30c0f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59946e6513e6ee659d5a63ebb8834c58, https://si.imgix.net/279ab163/uploads/origins/c0ede727-8650-4dab-a2a2-2750d30c0f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd0f6100f520f3357ec420f3fdb6c7c8 2x, https://si.imgix.net/279ab163/uploads/origins/c0ede727-8650-4dab-a2a2-2750d30c0f7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1593a7d7e74b39e29eb5888db7d90d37 3x"}, "body": "初めまして。BBC系のイラストを書いてためリクエストをお願いしたいと思いました。\n作品　IDOLY PRIDE\nキャラ　長瀬麻奈\nIDOLY PRIDEとは全く関係ないですがあくまでIDOLY PRIDEの世界に対魔忍が存在し長瀬麻奈が表ではアイドル、裏では対魔忍として働いている設定でお願いします。シチュエーションとしては優秀な新人対魔忍の長瀬麻奈がアイドルの立場を生かして雌奴隷の調教の元締めの疑いがある男のダンスレッスントレーナーの元に泊まり込みでダンスレッスンの名目で潜入調査を行うが裏では作戦は筒抜けで定期報告の度にバイブやローターを挿入してなんとかバレないようにこちらに報告するシチュエーションでお願いしたいです。そして差分をお願いしたいです。まず可能であれば右上に経過日数のカウントを出して最初は潜入前の報告で格好は長瀬麻奈の白いアイドル衣装を元にした対魔忍スーツで心配するマネージャーに大して簡単な任務だからすぐに終わるし何かあっても自分なら余裕だと楽天的な報告を、\n次は潜入後で白いアイドル衣装でローターとバイブを挿入して連絡をしてる場面で思ったよりガードが固そうだからまずは時間をかけて警戒を解く事にしたと話すが顔も赤く汗をかきセリフも途切れ途切れ、モーター音もしてる状態で大丈夫か？と聞かれてもレッスンがキツくて疲れただけと誤魔化す感じで身体には少しBBC風のタトゥーか落書きを着けて欲しいです。\n次の場面は対魔忍スーツ姿で前の場面より更に乱れてる感じでお願いします。表情はビッチ風の悪い顔で潜入中だけど暇だから連絡したと話すがセリフは喘ぎ声混じりだし、モーター音もかなり大きめで身体のタトゥーも増えてる状態で本当に大丈夫か？と聞いても大丈夫としか答えないし、格好についてもこの方が彼が喜ぶからと悪びれもせず答える始末で画面外から愛しの彼が心配してるぞwと男の声が聞こえる状態でお願いします。\n最後の場面はエロ改造されたアイドル衣装で連絡して男の専属雌オナホになったとの報告でお願いします。身体は日焼けしてローターやバイブだけではなくピアスも着けて欲しいです。出来れば男が隣に立ち片手はこちらに向けて中指を立てるファックサインのポーズをしてもう片方の手は男の股間をズボン越しに撫でてるポーズにしてセリフは短小男なんてどうでもいいけど彼ピが報告しろって言うから仕方ない報告してるけど見ての通りだから二度と連絡しないで下さい♥️余計な事をしたら殺すからね♥️などのセリフを言って男といちゃついて欲しいです。またこの場面のエロ改造された対魔忍スーツバージョンもよろしければお願いします。\n要望が大いですがよろしければお願いします。\nhttps://idolypride.jp/character/mana-nagase/\n\nhttps://idolypride.jp/character/mana-nagase/", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eessuwa2525/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3653430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d39c346ec3d47a882aec8e4c1230ee32", "srcset": "https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d39c346ec3d47a882aec8e4c1230ee32, https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5f6fcd5a616af39125aa2dc003520dc 2x, https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9953f66a1994af01389d7e3ea5a78436 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=652a38679a6607cacb438ce14d91a5b0", "srcset": "https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=652a38679a6607cacb438ce14d91a5b0, https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39e8e6b3ba5e9d17c40f33deaf9cb0f2 2x, https://si.imgix.net/afd48217/uploads/origins/ca64408c-a55f-40da-80b3-de0a4af763d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b24e657ff9739cb6615ac05b619280c 3x"}, "body": "えっすわ先生初めまして\nSkebで見た先生のNTRイラストがとても好きで、今回依頼させていただきました\n依頼内容はこちらです（海外の人なので、変な文章があったらすみません）\n\n■キャラ\nホロライブ所属のVTuber、「風真いろは」と「AZKi（あずきち）」、通称「あずいろ」の二人をお願いします\n今回は参考画像の「あずいろ_制服」+αの衣装を描いてほしいです。詳しい内容は以下のシチュを参照してください\n\n■シチュ\n密やかに好意を抱いてる幼馴染の二人が、学校の変態ヤリチン教師に寝取られて、清楚な姿からどんどんヤリチン好みの姿に染められた感じのシチュです\n\n■構図\n基本的な構図は先生が描いたこのイラストみたいな、正面向きな立ち絵という感じでお願いします\n差分は以下の説明を参照してください\nhttps://skeb.jp/@eessuwa2525/works/6\n\n■差分\n① まだ先生にやられる前の清楚な姿\n二人が主人公と日常会話してる時に、クラスメイトから「いろは、あずき、先生が呼んでるよ」って言われて、二人が「じゃあ行ってきます」「終わったらまた話しましょう～」って言ったが、しばらくして二人とのLINEで「ごめん、先生の手伝いがもう少し時間かかりそうで、先に帰ってね」「また明日」というメッセージが来て、主人公がそのまま帰った\n\n② 翌日、二人を見かけた時、何故か二人が先生と一緒にいて、顔が赤らめて、服も少し透けてる状態になってて、二人の口の周りにチン毛みたいなものがついてて、太ももから液体が少し垂れ流してる感じになってる\n話しかけたら、二人が少し驚いた感じで、「○○くん！？」「お、おはよう…」って言って、「昨日一緒に帰れなくてごめんね」「一緒に帰りたいけど、今日も先生の『お手伝い』があるから…」って言った後、「おい、二人そろそろ行くよ」って先生が言って、そのまま二人が先生と別のところに行った\n\n③ 二人の衣装が清楚な制服姿から、露出度が高い『アメスク』という感じの衣装になります\n改造された上シャツと、ヒョウ柄のブラ＋ハイレグのパンツ、そして短くてパンツが見えるスカートという感じの衣装です（参考画像参照）、できればニーソックスも追加して、ニーソックスで使用前のコンドームを挟んでる描写もお願いします\n主人公を見て、「あ、○○くん～」「お久しぶりだね♡」って言って、「二人の服はどうした」って聞いたら、「○○くん知らないの？最近一番流行ってる服ですよ」「先生のお手伝いしてる時いろいろ教えてもらってね♡」って言って、主人公が「でもちょっと露出度が…」みたいなことを言うと、二人がちょっと軽蔑な顔になって、「もう…○○くんの変態」「だから○○くんはずっと童貞なんだよね」って罵って、「そろそろ先生の所に行くから」って言って二人が離れた。その後、しばらくしたら二人が不登校になりました\n\n④ あずいろの二人が不登校になってから数か月、二人とのLINEグループに謎の動画が送られてきた\nその動画は、えっちなウェディングドレス（参考画像参照）を着て、先生とのNTRビデオを撮影するあずいろでした\n「○○くんごめんね～私たちはご主人様のモノになっちゃった♡」「○○くんのことが大好きだったけど、ずっと告白してくれないから、もう待てないよ」「これからご主人様とのえっちな動画いっぱい送るから、それ見て一人でシコシコしてね」というあずいろを見て、主人公がスマホの画面に敗北射精して、終わり\n\n以上です。かなり複雑なリクエストなので、難しかった部分や台詞は先生が自由に調整してもOKです\n\nhttps://drive.google.com/drive/folders/1tsHzzXXbk5jaNEkXFSMCcuxnWNMWfbFT?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eessuwa2525/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3653430, "client_id": 93511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0200339583035a8ddb509bbfb8ba4272", "srcset": "https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0200339583035a8ddb509bbfb8ba4272, https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56f6f494ba6f6a1f62b48196cd4ae2c9 2x, https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7ec67bdf9fa43b39bb8a206d507f6e2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8ac70ddc0c248f8bbe2f216eaa377a1", "srcset": "https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8ac70ddc0c248f8bbe2f216eaa377a1, https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4aed8104b65a9e145954a3f86083503b 2x, https://si.imgix.net/075adeb4/uploads/origins/ab5e6bb6-5f82-4a59-9c99-734bfebe71c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3cee2c2dc378efab38240d7845eaf050 3x"}, "body": "前回は素晴らしい作品をありがとうございました。\n今回も、前回に引き続き当方の看板娘「エィミィー」をお願いしたく思います。\n\nというのも、前回納品いただいた作品\nhttps://skeb.jp/@eessuwa2525/works/5\nのシチュエーションが大変に好いものでしたので、\n今回はこのシチュエーションの続きをリクエストできないかと思います。\n\n前回シチュエーションの最後「ベッドで続きを」という事でしたので\nこの後ベッドにて…というものをお願いしたく思います。\n\n詳細な体位や内容、構図差分などは全てお任せしたいと思いますが\n前回に続いて無理矢理ヤり潰すような強引なものになると嬉しく思います。\nよろしくお願いいたします<(_ _)>\n\nhttps://x.com/DarksidePot/status/1893959784153350335", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eessuwa2525/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3653430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18bb9f9fd8d031e35ab22e254c9fbbd5", "srcset": "https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18bb9f9fd8d031e35ab22e254c9fbbd5, https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eeb609a02aa307cecaaa3618b72f600c 2x, https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48535fb851801e996103e9a09e7fbe61 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81e9ade2732906ec49543d71d1d9f831", "srcset": "https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81e9ade2732906ec49543d71d1d9f831, https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ff1211bc2b530b9ea07f5a471f14f46 2x, https://si.imgix.net/d0dc8ae5/uploads/origins/52fd9487-72de-4f72-aaa1-bd0311a14bea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a66682bedb7052a24e6de2d52efff4d0 3x"}, "body": "前回東郷さんにてお世話になりました。\n今回新たにご依頼させていただきました。\n以下が内容となります。  \n\nキャラクター・結城友奈(結城友奈は勇者である) 変身前でお願いします。\n衣装・えっすわさんの考えるビッチな衣装にしてください。\n肌・テカテカで汗だくな感じ 。\n体・少し下品な感じの体にしてください。乳首は大きすぎず長すぎずノーマルより少し大きいくらいで尻を少し大きく。陰毛は少し。日焼け褐色の肌で何らかの入れ墨やピアスをお願いします。\nポーズ・蹲踞、腋見せ、フェラ素振りの挑発する感じ。\nシチュエーション・QOS、BBCな感じですでにビッチ堕ちしている。\n可能であれば修正は黒棒、ノーマルな肌色、使用済みコンドームが複数括り付けられさらに手に持っている事後、全裸差分が欲しいです。\n\n以上となります。 \nよろしければご承認お願いいたします。  \n\n資料1 \nhttps://yuyuyu.tv/season1/character/#yuna\n資料2 \nhttps://www.volks.co.jp/jp/charagumin/chara158.html\n資料3\nhttps://yuyuyu.tv/daimankai/character/#/yuna", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eessuwa2525/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3653430, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fccf1a6a75764112f776576013792783", "srcset": "https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fccf1a6a75764112f776576013792783, https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b06831e3ee0ebe7bc089c5ceecf8059 2x, https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48ab1cd3205b5daef438f38468bcc622 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a46a89a65a1d5ecaae3dcf287474150d", "srcset": "https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a46a89a65a1d5ecaae3dcf287474150d, https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=794a73d1966a94e9becd2f15aaa904f7 2x, https://si.imgix.net/8f51fc1b/uploads/origins/291e67bd-6860-462b-a693-a5b86d650ffc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e552d561cfeb26c02409601fd1fee55 3x"}, "body": "マスターの眼前で双頭ディルドハメ二穴責め4Pレズセックスを披露する遊戯王の《RAI-MEI》と《WW-アイス・ベル》、《WW-グラス・ベル》、《WW-フリーズ・ベル》をリクエストさせて頂きます\n\n受け:RAI-MEIとアイス・ベル。\n\n竿役:グラス・ベルとフリーズ・ベル。極悪サイズの双頭ディルドを装着(自分達も片側を挿入済み)している。\n\n体型は全員全身むちむちの頭身高めで、乳のサイズは頭より大きく上半身を目一杯覆い、股間がギリギリ見えるくらいの超乳。乳首と乳輪はともに大きめ。またRAI-MEIのツインテールは腰に届く位の長さです。\n服装は全員元のカードのイラストで着ているスーツで、股間と胸部の先端が♡型の穴空きで乳首と乳輪、女性器が露出している状態にして下さい。\n\nRAI-MEIとアイス・ベルが二人並んで寝ており、それをグラスとフリーズの二人が正常位で攻めている構図で、受け二人を正面から写し、攻め役二人の様子は顔から胸全体が写るまでのワイプを別枠で写すようお願いします。\n\n挿入前。攻め二人が挿入を焦らし、受け二人はそれに対し完全に堕ちきった様子で媚びながら挿入を懇願しつつ、全員でマスターに自分達の痴態を見てもらうよう声を掛ける。\n↓\n挿入時。攻め二人が同時に挿入し、受け二人はその衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しくピストンしながら全員とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n同時絶頂。4人とも汚い口調で淫語を絶叫しながらイき、白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\n…という流れで、4人それぞれにセリフを付けて頂きたいです。キャラの性格や口調はお好きなイメージでおまかせ致します。\n\n何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1yeOlG9NXJhZMvs9_5H8d9gdFUck23rnn", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eessuwa2525/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3653430, "client_id": 3123949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a28fabd9/uploads/origins/85781dcc-9af1-401b-b507-a5ec604872a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=844bf57f9cd9db0f21a1b7158f570198", "s