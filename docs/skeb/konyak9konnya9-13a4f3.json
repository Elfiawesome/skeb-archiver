c73/uploads/origins/f2c33450-51af-4b73-bad7-6f22d1e5e961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b95b725859023378ffca2fcf8530e9", "srcset": "https://si.imgix.net/89b95c73/uploads/origins/f2c33450-51af-4b73-bad7-6f22d1e5e961?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42b95b725859023378ffca2fcf8530e9, https://si.imgix.net/89b95c73/uploads/origins/f2c33450-51af-4b73-bad7-6f22d1e5e961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2cc200b2f0b72e32ec3f38edb7e2fb88 2x, https://si.imgix.net/89b95c73/uploads/origins/f2c33450-51af-4b73-bad7-6f22d1e5e961?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eab3c81fc7fad1379a35ec9954d069d4 3x"}, "body": "灰村のいり様。初めましてこんにちは\nＳＮＳでイラストを拝見致しまして\n（※個人的に大好きなゲームの世界樹の迷宮シリーズの\nアリアンナやダンサーちゃん他諸々など）\n一目でビッ！と感じちゃいまして\n是非頼んでみたいなと思い、リクエストを投げてみます。\n\n◎【今回リクエスト内容】\n私のうちの子、新しいＯＣ変身ヒロインである\n「リュミエルハート・ノノ」\nを描いて頂けますでしょうか。\n\nキャラ設定⇒\nhttps://x.com/brave_akane/status/2033140782602023081?s=20\nhttps://skeb.jp/@SolaMeteorite/works/63\n\n※勿論、変身後の姿でお願いします。\n\nイラストの内容は、灰村のいり様にお任せします\n可愛い系からヒロイック系から、変身ヒロインという題材ですので\n闘う系からカットイン系、はたまた苦戦ボロボロ系まで！\nとにかく楽しく描いて頂ければそれでＯＫです！\nアドリブ投げします！\n\n♦【使用用途】\n　①Twitter(X)及びmisskey含む外部SNSのアイコン・ヘッダー使用予定\n　②今回納品予定のイラスト紹介（Twitter(X)掲載）\n　③絵師様へ紹介ツイート\n　④２次創作の資料、及び他リクエストする際に引用。\n\n■以上になります。\nもし今回のリクエスト内容及び掲載理由で厳しい。\n作業量に対して金額が合わない！（値上げが必要）\n他等、何か理由が御座いましたら\n遠慮なくキャンセルして頂いて構いません。\n　\nお忙しい中大変恐縮ではございますが\n何卒御確認、御検討の程宜しくお願い致します。\n\nhttps://x.com/brave_akane/status/2033140782602023081?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konyak9konnya9/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3933291, "client_id": 1985095, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92e8ccc3/uploads/origins/850bd894-d9e5-497a-bf88-2c7d9e05410c?bg=%2