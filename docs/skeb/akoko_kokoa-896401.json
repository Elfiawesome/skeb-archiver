77040c6dec0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eff1acbc49be7ca1be0705bb692467d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9424516/uploads/origins/3fe4ee85-9325-4751-86e8-77040c6dec0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=949700fb1e934a7fbe08f6486ca3cf46", "srcset": "https://si.imgix.net/a9424516/uploads/origins/3fe4ee85-9325-4751-86e8-77040c6dec0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=949700fb1e934a7fbe08f6486ca3cf46, https://si.imgix.net/a9424516/uploads/origins/3fe4ee85-9325-4751-86e8-77040c6dec0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c028355978f3776fb41200f96e0c6d7 2x, https://si.imgix.net/a9424516/uploads/origins/3fe4ee85-9325-4751-86e8-77040c6dec0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=592623ca498eda2163d7dfb49dfd2332 3x"}, "body": "初めまして、新着でアココ様の可愛いイラストを拝見しまして一目惚れしたのでぜひリクエストしたいと思いました！\n\nもし宜しければ私のOCのシラヌイさんを描いて頂けないでしょうか？\n\nシラヌイさんは黒に近い紫のポニーテールの長髪に赤と青のオッドアイの瞳（赤い瞳に特殊な紋様）、黒いマスクに、赤いネクタイ（金色の模様）に黒いコート状の服を着ている男性です。\n一人称は私で、口調は「〜だ」「〜だな」といった感じで外見年齢は20代後半です。実際は1000年以上生きており人の姿をしてますが人ではない異種族です。\n無表情で感情を表に出すことがほとんどない強者ですが一緒にいるミカド君には心を許しています。\n\nhttps://drive.google.com/drive/folders/1M4Yd2lBK6RoEVqsX_eUdQSuPi6265Wkp\n\nポーズや構図などはお任せしますので自由に描いて頂けましたら幸いです！\n\nアココ様の可愛く素敵な絵柄で我が最推しOCであるシラヌイさんを見てみたく思います！\n\nこちらの内容で良ければご検討の程よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akoko_kokoa/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3922034, "client_id": 3838145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c6910f6/uploads/origins/392b3141-e8f1-4d7d-b9fe-766f49b49370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&