2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24579b8a85c0d03c4e894079e2112956, https://si.imgix.net/4b55708e/uploads/origins/5a06d275-3cee-4476-9826-eed8c284af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=edac806cda403796ce216e584ac00894 2x, https://si.imgix.net/4b55708e/uploads/origins/5a06d275-3cee-4476-9826-eed8c284af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=509a78b0b4f607f332c670efdee7cab7 3x"}, "body": "初めまして。みるひかさんに頭身絵をご依頼できることをとてもたのしみにしていました。\n絵柄が大好きなのは勿論のこと、その画力・デザインセンスの高さにも毎度尊敬の意を抱いております。特に人体と服の皺の描き方が造形フェチに大変刺さります。大好きです。\n\nつきましては、私の創作キャラクターを描いていただきたく存じます。\n以下は参考程度のキャラクタープロフィールです。読んでも読まなくても大丈夫です。\nーーーーーーーーーーーーーーー\n【名前】クルミ\n【身体情報】\n・無性別\n・145cm\n・見た目は10代前半の少女\n【その他設定】\n・生物兵器\n・高位な知能を持つが、幼なさ故に無垢で純粋。人外的倫理観。\n・可愛いお洋服が好き。しかし見かけにそぐわず辛党。\nーーーーーーーーーーーーーーー\n\nまたURL先の資料の中には人外形態も存在しますが、今回は主に少女形態で描いていただきたく思っております。\n髪型や衣装、一部人外化等のアレンジは自由にしてくださってかまいません。みるひかさんのお好きなように描いてくださると嬉しいです。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Y5BAZLXyqsXrc5a_n2o9j8A5znDq7yzf", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mlii_nj/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3833973, "client_id": 3489534, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=101f33a9e97647b99968f56bb8abea7b", "srcset": "https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=101f33a9e97647b99968f56bb8abea7b, https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32e892c4320a707449105340af65998d 2x, https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=206e3240ff0a298227ffae8ef9daca9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf8cbc2104f8ca17b8d3a39f03937ff", "srcset": "https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf8cbc2104f8ca17b8d3a39f03937ff, https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad6f36a4e7a23e503c58782986df6088 2x, https://si.imgix.net/e27c5e2f/uploads/origins/7ae72761-5a8e-4e7d-adbd-de420744392e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80ebb743ab98bd4a807740b9af9b1de2 3x"}, "body": "みるひか様\n\nいつも大変お世話になっております！\nみるひか様のイラストが大好きなので、リクエストを送らせていただきました。もしご縁がありましたら、私のTRPGのOC（資料内の少女）の衣装デザインと立ち絵を描いていただけないでしょうか？ \n\n 【OC】  \n26歳、146cm。髪色は明るいアッシュグレーで、青のメッシュやインナーが入っている。 \n少女の恰好をしているが、異端と呼ばれる人ではない存在。身体の一部が冷たい灰色の炎で構成されている為、見た目はある程変えることができる。警視庁所属の刑事であり、仕事の際は女性あるいは青年の姿で過ごしている。\n生真面目ゆえに我慢しがちな性格で、仕事では誰に対しても柔和に対応しているが、内面は情緒不安定。気を許した相手にはツンデレみたいになり、照れると逃げ隠れる。完全に心を開いている相手であれば、どこにでもいる少女のように笑う。 \n\n【希望】\n髪型と服装(チョーカー以外)を自由にアレンジして欲しいです！和っぽい雰囲気の衣服だと嬉しいですが、みるひか様の好きに描いていただければ幸いです。\n (URL先にあるイラストは絵師様より他コミッションにて参考資料として使用する許可を得ております) \n\n 【使用用途】  \n・他依頼時での参考資料  \n・個人用にアクスタの作成 \n・SNSアイコン\n・個人鑑賞\n\n以上、金額や内容に不明・不足点等ありましたら再送もしくはキャンセルいただけますと幸いです。 \n ご検討の程よろしくお願い致します。\n\n※納品締切日数の変更前にリクエストを送付してしまっていた為、再送させていただきました\n\nhttps://drive.google.com/drive/folders/1syJ6qbmCol3PbTIs4f8MasAJ06QTlFHx", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sen