敵で、感動いたしました。\n\nそこでぜひ、私のオリジナルキャラクターの制作をお願いしたくご連絡させていただきました。\n\n彼は西洋の世界に生きるドラゴン族の少年で、容姿が非常に優れており、元気で活発な性格です。\n可能であれば、白系統または黒系統の配色を希望します。\n\n白系統の場合：百合の花の要素を加えていただけると嬉しいです。\n\n黒系統の場合：体に装飾的な小さな翼のデザインを残してください。\n\nまた、太めの眉と交差したもみあげ、片目を見せる表情は必ず残してください。\nその他の髪型については、先生の自由なデザインにお任せいたします。\n\n避けてほしい服装：太ももが見えるショートパンツ。\n\n全体的には自由に創作していただければと思います。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1FgL421zNUNkXDewSmBxh2f1h1IcJ41-J/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mlii_nj/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3833973, "client_id": 2224464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/caefdead/uploads/origins/d99ea7f0-67f7-47f7-b62f-c4569cb2f16d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ce1270738486b777bddb64a30ac8de0", "srcset": "https://si.imgix.net/caefdead/uploads/origins/d99ea7f0-67f7-47f7-b62f-c4569cb2f16d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ce1270738486b777bddb64a30ac8de0, https://si.imgix.net/caefdead/uploads/origins/d99ea7f0-67f7-47f7-b62f-c4569cb2f16d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b6502b92a703dec3dc7cbe290e9c1a6 2x, https://si.imgix.net/caefdead/uploads/origins/d99ea7f0-67f7-47f7-b62f-c4569cb2f16d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e261d1b86d9d6781f0b484d6c3d83860 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/caefdead/uploads/origins/d99ea7f0-67f7-47f7-b62f-c4569cb2f16d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67d7e4e833971ea108f48bb1fd9bfbb4", "srcset": "https://si.imgix.net/caefdead/uploads/origins/d99ea7f0-67f7-47f7-b62f-c4569cb2f16d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur