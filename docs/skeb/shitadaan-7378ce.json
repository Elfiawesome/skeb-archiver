-7a52ee4c2c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73d6bcf41953f3cdbf53e77bce3d572c 2x, https://si.imgix.net/b67f6a4d/uploads/origins/16ed1d5b-399d-4746-a383-7a52ee4c2c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ec5911241df132bae8036e7f51ef55d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b67f6a4d/uploads/origins/16ed1d5b-399d-4746-a383-7a52ee4c2c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3a2ba7da5c5a8f5b91f711b5eb32e99", "srcset": "https://si.imgix.net/b67f6a4d/uploads/origins/16ed1d5b-399d-4746-a383-7a52ee4c2c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3a2ba7da5c5a8f5b91f711b5eb32e99, https://si.imgix.net/b67f6a4d/uploads/origins/16ed1d5b-399d-4746-a383-7a52ee4c2c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5856d1f91b233f705ccf707af8097892 2x, https://si.imgix.net/b67f6a4d/uploads/origins/16ed1d5b-399d-4746-a383-7a52ee4c2c7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfaa76646810d6ee1b3992c8cd5002e6 3x"}, "body": "しただ様の生き生きと自然体で可愛らしいイラストに惹かれて、リクエストを送らせていただきました。\n\n《リクエスト内容》\n自分の代理キャラクターを描いていただきたいです。\nキャラクターの資料はURLをご参照ください。\n\n《使用用途》\nSNSでの活動やサムネイルなど\n\nもしよろしければ、「おうちデート」をテーマにしたイラストをお願いしたいです。\n私服（パーカーやシャツなど）で映画を観ているシーンを想定しています。\n楽しそうな表情や、怖がって少し涙目になっている差分があると嬉しいです。\n\nご都合が合いましたら、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_lUU2KdEG2S-z_fyNs2b2Ri8TebontvC?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shitadaan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1232950, "client_id": 2108321, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0dbf9847/uploads/origins/4b5eb1a3-2d3a