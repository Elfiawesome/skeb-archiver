675b7e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd080401fe394f936c31da7d496e068f, https://si.imgix.net/54e7454c/uploads/origins/25059b93-651d-42f2-b093-1d50675b7e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8676d52b921cf55d5550e0f01033ffd7 2x, https://si.imgix.net/54e7454c/uploads/origins/25059b93-651d-42f2-b093-1d50675b7e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe8c221b5c676a79eabd9a452f9f6af1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54e7454c/uploads/origins/25059b93-651d-42f2-b093-1d50675b7e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fba876897a80a1c41dd088cab51cddf", "srcset": "https://si.imgix.net/54e7454c/uploads/origins/25059b93-651d-42f2-b093-1d50675b7e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fba876897a80a1c41dd088cab51cddf, https://si.imgix.net/54e7454c/uploads/origins/25059b93-651d-42f2-b093-1d50675b7e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=607ac2217ec304bd5da21363af304915 2x, https://si.imgix.net/54e7454c/uploads/origins/25059b93-651d-42f2-b093-1d50675b7e8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=147cc6d181007496ee31c5117a5a66dc 3x"}, "body": "ふであこ様\n前回は素晴らしいイラストをありがとうございました\n今回も前回と同じくPSO2NGS（オンラインゲーム）で作成した、オリジナルキャラクターイラストをお願い致します\n\n【キャラクター描写】\n服装：パーカーの前をはだけている　パーカーは完全に脱衣しない\nマフラー：着用　口元は見えている　マフラーも完全に脱衣しない\n胸：ゲーム内画像より大き目　googledrive内サンプル画像参照\n目：ハイライトなし いわゆるレ〇プ目\n瞳：催〇を掛けられており、ハートマーク（白抜き）が浮かんでいる\n\n【シチュエーション】\n●オリジナルキャラクターが催〇を掛けられ、竿役男性と騎乗位を行っている。\n\n①イラスト\n「000ふであこ様参考イラスト」をご参考下さい\n・竿役男性（一般的な体格、男性器のサイズ）に跨っている\n・男性器は女性器に「３分の１ほど飲み込まれ、竿に粘った体液が伝っている」\n・キャラクターは見下ろすように竿役男性を見つめている（※視線をカメラ側に向けている）\n・表情は催〇に掛けられているように虚ろで、わずかに快感で紅潮している　ハート目（白抜き）\n・口はゆるくあけ、わずかに開いた口からよだれが垂れている\n・背景はお任せ致します\n\n【以下、可能であればお願い致します】\n・射精差分\n・表情差分（催〇が解け非、快感に耐えるように顔をゆがめ、睨みつけている・歯を食いしばっている・顔は快感で紅潮している）\n\n・前回イラストの胸の描写が大変素晴らしかったので、胸の表現にこだわって頂ければと思います\n\n【NG描写】\n・排尿などのスカ描写\n・母乳\n・陰毛\n※可能であれば、モザイクではなく黒線修正でお願い致します\n\n少しでも応援になればとリクエスト送らせて頂きました\nお受け頂けますとありがたく思います\n\nhttps://drive.google.com/drive/folders/1hDAbdJvHccJIHcCoznpqf8O5dcj72I3f", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hudeako/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1926898, "client_id": 262166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e85e5e68519510f1e57c7daeb625dc11", "srcset": "https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e85e5e68519510f1e57c7daeb625dc11, https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f927bf16351239b984e4da09d1570b79 2x, https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=310fe9c521587ea78b54877a691054a7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b79ade5be4b01cf06681dadfaa4c7508", "srcset": "https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b79ade5be4b01cf06681dadfaa4c7508, https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a361139edf586ba2648a9791c876d60 2x, https://si.imgix.net/3edf1bbe/uploads/origins/c5bce61a-6f92-4bb9-817f-722b36d68f4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cd823493b3ea8b5f523fb3771cce2b1 3x"}, "body": "ふであこ様\nはじめまして\nskeb利用は不慣れのため、不手際等あればご容赦下さい\nPSO2NGS（オンラインゲーム）で作成した、オリジナルキャラクターイラストをお願い致します\n\n【キャラクター描写】\n服装：パーカーの前をはだけている　パーカーは完全に脱衣しない\nマフラー：着用　口元は見えている　マフラーも完全に脱衣しない\n胸：ゲーム内画像より大き目　googledrive内サンプル画像参照\n瞳：絶頂時にはハートの模様が浮かんでいる、ハート目（白抜き）\n\n【シチュエーション】\nhttps://skeb.jp/@hudeako/works/3\nこちらのイラストが大変素晴らしかったので、同じ構図でお願い致します\nダンジョンで罠にかかり拘束され、偶然通りがかった雑魚モンスターのゴブリンに犯されるというシチュエーションでお願い致します\n・両手を上に挙げ、拘束されている\n・怯えた表情でこちらを見つめている　目は見開き、歯は食いしばっている\n・パーカーの前面をはだけ、両胸、女性器をが露出している\n\n以下、差分をお願い致します\n差分①　ゴブリン（オリキャラの半分以下の背丈、男性器は不釣り合いに大きく、イボがついている）にのしかかられ、男性器を挿入されている　ゴブリンは胸に顔をうずめている　ゴブリンを見つめ驚きの表情　口は開けている\nゴブリンは表情は不要ですが、結合部が見えるように描写頂ければと思います\n\n差分②　事後　女性器から大量に精液が漏れ出し、顔、胸にも精液を掛けられている　表情は快感で目が上転し、口をだらしなく開けている　白抜きのハート目\n\n【NG描写】\n・排尿などのスカ描写、アナルプレイ\n・母乳\n・陰毛\n\n※可能であれば、モザイクではなく黒線修正でお願い致します\n\n少しでも応援になればとリクエスト送らせて頂きました\nお受け頂けますとありがたく思います\n\nhttps://drive.google.com/drive/folders/1MAHCE5bOnfCffBfvHz30LjgJu3qldBpE", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hudeako/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1926898, "client_id": 1062591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d0384b0/uploads/origins/32bd42f7-ef2b-49a7-88a8-d422296ba83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=739657f31782d85fd2d671bd4f8f01e8", "srcset": "https://si.imgix.net/2d0384b0/uploads/origins/32bd42f7-ef2b-49a7-88a8-d422296ba83c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=739657f31782d85fd2d671bd4f8f01e8, https://si.imgix.net/2d0384b0/uploads/origins/32bd42f7-ef2b-49a7-8