=top&w=200&h=200&s=59808a7560bbbc4b6f675ec11b265534 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99675bac/uploads/origins/6899139e-01ad-4b77-ae66-d575d2cc8150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a599871956459e3d94fcd3ddae49328c", "srcset": "https://si.imgix.net/99675bac/uploads/origins/6899139e-01ad-4b77-ae66-d575d2cc8150?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a599871956459e3d94fcd3ddae49328c, https://si.imgix.net/99675bac/uploads/origins/6899139e-01ad-4b77-ae66-d575d2cc8150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d32162c8a758af1a0b7660801f3ae46 2x, https://si.imgix.net/99675bac/uploads/origins/6899139e-01ad-4b77-ae66-d575d2cc8150?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5a9c7f424e62fce5a58e50b27cbdf6 3x"}, "body": "こんにちは！カンコレの翔鶴と瑞鶴をフィーチャーしたリクエストを出すことは可能でしょうか？\nhttps://cdni.fancaps.net/file/fancaps-animeimages/20427918.jpg\n\n二人ともこの潜水服とバブルヘルメットをかぶってほしいです：\nhttps://www.pixiv.net/en/artworks/47021138\nhttps://www.pixiv.net/en/artworks/49779721\n\n二人は一緒にダイビングベルの中に座っています。潜水ベルは水中にある。翔鶴は落ち着いた表情で、瑞鶴は緊張した表情で翔鶴と手をつないでいる。\n\nありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssns02609486/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 429745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e8963b4374565d0f7717719eae863dc", "srcset": "https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e8963b4374565d0f7717719eae863dc, https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b150c181d3f69a17c740980d1d07ca9 2x, https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=146dfc1cd5400e13dfa83a7e3c9ee61d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f88c45eb47c7e367e9faca549ca2d6d0", "srcset": "https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f88c45eb47c7e367e9faca549ca2d6d0, https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ee94630c2f376fcfb58df105665f7ea 2x, https://si.imgix.net/1c24d909/uploads/origins/8f67ecf1-8328-4b3c-8e1b-e5c475f2d52b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c6801fb419ed2fb09722b3674c01217 3x"}, "body": "いつも素敵な作品を拝見しております。\nFanboxに掲載されているようなラフイラストについて、こちらからご依頼することは可能でしょうか。\n\nFANBOXで描かれていた「ストレイ3名が乗る打ち上げロケット内部での爆発シチュエーション」がとても印象的で気に入っています。\nhttps://www.fanbox.cc/@ssns/posts/8647062\n\n同じくkit様デザインのアストロガールを着用したアイドルマスターシャイニーカラーズの「イルミネーションスターズ」の3人で、可能であれば以下の2シーンをお願いしたいです。\n\nシーン1\n搭乗口へ向かうタラップ上で、宇宙服を着用した3人が手を振っている場面。\n見送るスタッフや群衆の描写は不要で、イルミネの3名のみで構いません。\nヘルメットは装着済みの状態を希望します。\n\nシーン2\nロケットの爆発により、3名全員が爆炎に呑み込まれる瞬間。\nストレイ3名が次々と呑まれていく描写も非常に魅力的でしたが、今回は1枚の作品となるので、\n3名が一度に消し飛ぼうとする場面として描いていただければと思います。\n\n参考イメージ：https://www.fanbox.cc/@ssns/posts/7486770\n こちらの最後のイラストのように、顔や胴体はある程度原形を留めつつも、爆発に巻き込まれる瞬間を描いていただきたいです。\n損傷の程度はお任せいたしますが、ヘルメットの表面が砕け散る描写を取り入れていただけると嬉しいです。\n\nどうぞよろしくお願いいたします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssns02609486/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 429745, "client_id": 224551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02ddd432bb66cf1112302578549d5581", "srcset": "https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02ddd432bb66cf1112302578549d5581, https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cad1c2161e2cca15036a50d5b904f7e 2x, https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bebbeb8b2197fc781d530356e3bc663 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fedc091c71bd736804345005329b7c1", "srcset": "https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fedc091c71bd736804345005329b7c1, https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=abf7e98341578d40932e242f81d4cf5f 2x, https://si.imgix.net/d961b367/uploads/origins/d30c91a0-c834-43cf-a6cf-21bddd8a0f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=715835463775838ab4b27eef1d4a87f1 3x"}, "body": "以前リクエストしたこちら\nhttps://www.pixiv.net/artworks/131014799\nの出撃前(全身立ち絵)を描いて頂きたいです。", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ssns02609486/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 429745, "client_id": 54516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33318a591dc27f89809d9b14faf32919", "srcset": "https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33318a591dc27f89809d9b14faf32919, https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c00e8b2ad4fd24258fdb1c5fce8221a 2x, https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc1898da6f3aafd45bbd4d41406bb700 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9107ac7b687449358315bbdaefce9916", "srcset": "https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9107ac7b687449358315bbdaefce9916, https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55b84a9b021cd82ca8ec2b0d378bc82d 2x, https://si.imgix.net/7259b214/uploads/origins/617604ae-d772-4854-896b-d8654e2768e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e41a9a482ffaac6caf8dc185f3eb2f5 3x"}, "body": "リクエスト失礼します。\nよければ、ウェットスーツとがっつり重装備のダイビング装備を付けたうちの子をお願いします。\n\nキャラ：うちの子ですが、下記URLのものよりも幼く、中学１～２年生くらいの年頃にアレンジしたうちの子をお願いします。\nうちの子：https://twitter.com/qualialibrary/status/1335490102768766983?s=20\n\nシチュ：初めての重装備潜水訓練でなおかつ拘束状態からの脱出をプール内でさせられたというシチュでお願いします。\nポーズは大の字拘束で、プールの上から鎖でぶら下げているため倒れることもできないという形でお願いします。\nまた、プールはあちこちに照明があって、監視員が見やすいように壁は透明なガラス等という設定でお願いします。\n\n初めての潜水訓練＋重装備＋拘束ということで半パニックになり、泣きながら訓練をギブアップをさせてほしいと懇願する。\nしかし、施設員は拘束が解けなくても一定時間は潜っていなければならないとして放置する。\nその後、プールの水を抜いてもらえるまで不安と恐怖に泣きながら耐え続ける。\nようやくプールの水を抜いてもらえて一安心したが途中でギブアップした罰として、\n水が抜けたプールの底でタンクのエアが尽きるまで重装備かつ拘束状態のまま放置され、\n施設員の見世物にされる。\n水中から気中になったことで水を吸ったウェットスーツやダイビング機材フル装備の重さでどんどん疲弊して汗をかき、ダイビング装備もつけたまま外せないのでいつ窒息するかわからない恐怖も合わさって、\n泣きながら身動きがとれなくなっているというシチュでお願いします。\n\n実はこの訓練、初回は誰もクリアできた者はおらず、あえてクリアできないような難易度にし、\n一度ピンチの状況を経験させるという趣旨があり、\n合わせて、失敗した者を眺めて笑いものにするというのが施設の風物詩となっている。\nという裏設定があります。\nそのため、プールはあちこちに照明があり、拘束も全身が見えやすい大の字という設定です。\nウェットスーツは水色を基調として黄色を挿したデザインでお願いします。\n\nその他の機材の配色はお任せいたします。\n\nよければご検討のほどよろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 97621, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "たのの@Skebリクエスト募集中", "screen_name": "tanonosan", "avatar_url": "https://pbs.twimg.com/profile_images/2026609967952965633/5Oe8Si-d.png", "header_url": "https://pbs.twimg.com/profile_banners/101954990/1765669976/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 32}, {"id": 164353, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "uga@Skebやってます", "screen_name": "ugandam_00", "avatar_url