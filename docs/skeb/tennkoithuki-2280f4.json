0&h=200&blur=200&s=509ba49e02532c5febb65fbe2b49774a 3x"}, "body": "天鼓 樹　さま\n\nこの度は嬉しいアピールいただき，ありがとうございます！\n夏らしい，透明感のある衣装、とても見てみたいです…！\nぜひリクエストさせていただきたいと思います！\n\n依頼内容としては　ぜひ衣装デザイン込みでお願いしたいです、\nデザインは個人の創作活動のほか，他依頼への利用を許可いただけたら幸いです。\n\n\nデザインに関してですが，ocに関しては全体的な色味、褐色であることだけ合わせていただけたら，髪型などなどいくらでもアレンジしていただいて構いません。\n個人的にはフリルとレースはいくらでも盛り盛り盛るタイプですが、\n天鼓 樹さまの好みを詰め込んでいただけた方が嬉しいです。\n\n\noc は百合の花、ミルククラウン、翼などがモチーフ。skebにはいないですが、お相手キャラが太陽のような赤いモチーフのため、赤いワンポイントや赤い靴などのリクエストも何度かしています、\nモチーフは取り入れても、取り入れなくても、どちらでも構いません。\n\n\n参考資料ですが、Googleドライブを導入しましたので、依頼品などまとめたフォルダを添付いたします。\n（Googleドライブ初心者のため、資料見れないなど不備あったら、再送依頼お願いします。）\n自由に描いてください、\nよろしくお願いします！\n\nよろしくお願いいたします〜\n\nhttps://drive.google.com/drive/folders/1L5ul0b1PTDCrwrViLdeUFYe7QdL18W8r", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tennkoithuki/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2613833, "client_id": 942310, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96a6ed47/uploads/origins/132ff0bf-4af3-4f81-b909-6b7d1953d684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a9890a2f14a92b4b4c7c446418bf95", "srcset": "https://si.imgix.net/96a6ed47/uploads/origins/132ff0bf-4af3-4f81-b909-6b7d1953d684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39a9890a2f14a92b4b4c7c446418bf95, https://si.imgix.net/96a6ed47/uploads/origins/132ff0bf-4af3-4f81-b909-6b7d1953d684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a4762ce5fa6b43b8bf24165525083d7 2x, https://si.imgix.net/96a6ed47/uploads/origins/132ff0bf-4af3-4f81-b909-6b7d1953d684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de9492621dcc763cf294cb96eb3fb5df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96a6ed47/uploads/origins/132ff0bf-4af3-4f81-b909-6b7d195