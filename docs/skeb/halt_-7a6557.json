をご依頼させていただきたく思います\n希望するポーズは、バージルがダンテの上に跨がり、手で彼の顔を丁寧に撫でる様子。ダンテは顔を横に向け、バージルの手にできるだけ近づけるようにしています。\n（大まかな雰囲気としては、視覚障害のためダンテの容貌を見ることができないバージルが、触れることで彼の姿を確かめようとしている様子。ダンテもまた、バージルに親密さを求めているような感覚です）\nそれ以外の部分は、どうぞご自由に描いてください。\n\nhttps://drive.google.com/drive/folders/14-19fVw-WoqLN-6Jslp-fassLjMsaq8H?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@halt_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1c2436d4/uploads/origins/8db53303-3016-4c46-9be3-4779fd6585ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7b3da271aa6131503cb716869f496e7", "srcset": "https://si.imgix.net/1c2436d4/uploads/origins/8db53303-3016-4c46-9be3-4779fd6585ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7b3da271aa6131503cb716869f496e7, https://si.imgix.net/1c2436d4/uploads/origins/8db53303-3016-4c46-9be3-4779fd6585ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8d106ca6eae2cd659416058d356ccd15 2x, https://si.imgix.net/1c2436d4/uploads/origins/8db53303-3016-4c46-9be3-4779fd6585ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=707ad2cdf489302846d12f32cfcc30ac 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 492583, "client_id": 300885, "nc": 1}, {"path": "/@halt_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 492583, "client_id": 3885938, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4ddd970/uploads/origins/60c7240