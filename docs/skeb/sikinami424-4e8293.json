ーに分けてお願いします。）\n\n\n■利用目的\n資料URLのキャラの宣伝として、販促画像等に使用して、当方のSNS等に投稿させて頂きたいです。\n\n＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊＊\n\n以上となります。\nご検討のほどよろしくお願いいたします。\n\nhttps://www.dlsite.com/maniax/work/=/product_id/RJ389425.html", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sikinami424/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3366974, "client_id": 5580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd61e5b3/uploads/origins/f982f192-2cc7-438b-8b5f-80c0166f3acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c9ff86d8430363444c5aa50d81377c", "srcset": "https://si.imgix.net/fd61e5b3/uploads/origins/f982f192-2cc7-438b-8b5f-80c0166f3acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65c9ff86d8430363444c5aa50d81377c, https://si.imgix.net/fd61e5b3/uploads/origins/f982f192-2cc7-438b-8b5f-80c0166f3acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=958088b94ed7c588e4af5d979246bf2e 2x, https://si.imgix.net/fd61e5b3/uploads/origins/f982f192-2cc7-438b-8b5f-80c0166f3acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa0a31e5c4d0f0d14645713483d151aa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd61e5b3/uploads/origins/f982f192-2cc7-438b-8b5f-80c0166f3acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb3b29fbf2d3c4685c2d6df3331551e9", "srcset": "https://si.imgix.net/fd61e5b3/uploads/origins/f982f192-2cc7-438b-8b5f-80c0166f3acd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb3b29fbf2d3c4685c2d6df3331551e9, https://si.imgix.net/fd61e5b3/uploads/origins/f982f192-2cc7-438b-8b5f-80c0166f3acd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c92ca270988390e6837bbe213c12cd36 