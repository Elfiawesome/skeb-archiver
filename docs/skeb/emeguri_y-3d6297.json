ed": true, "creator_id": 3541525, "client_id": 3433287, "nc": 32}, {"path": "/@emeguri_y/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3541525, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d57e2fe8fedecf1fb3899bed2bd532b", "srcset": "https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d57e2fe8fedecf1fb3899bed2bd532b, https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af703c1ec810a409a0c538a72a1b8fca 2x, https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d38ad93f5d9d8ca405a45e25be9eb3b7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2159e35fe1fa6d6d7f87ac27e9865b8", "srcset": "https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2159e35fe1fa6d6d7f87ac27e9865b8, https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=047ca31c1d4edf660845f606e2466a1b 2x, https://si.imgix.net/63abf375/uploads/origins/cc17522c-7b70-4b42-86ad-bb47547d1f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6596640e087e288e76d7e43514ed25fd 3x"}, "body": "始めまして、こちらの要望に合わせたキャラを作って頂くお題感覚のオリジナル百合の依頼をお願いします\n\n【キャラ】\nツンデレ同士のケンカップル百合\n\n髪型はどっちもツインテールで髪の色はそれぞれemgrさんが普段描かれておられるような濃い色と明るい色（白黒漫画的に言うと濃い目のトーンと白抜き系）、背丈や胸の大きさなどは完全に同じサイズ（どっちも背は中～小で胸の大きさは大から小まで互角サイズならおまかせ）性格もプライドが高くツンツン同士\n他にも何もかも互角の似た者同士でライバル同士、\n出会った時から真似しないでとか私の方が上！などいつも喧嘩ばかりしてて（周りに仲がいいね～と言われて、良くない！ってハモるようなタイプ）\n\n世界観は普段かかれている学生同士でもいいですし、例えばファンタジーで魔法使い同士や魔法学校、西洋の貴族が舞台などでも可\n\n\nなにかと張り合う互角の喧嘩ばかりして常に互角だったり相打ちしてばかりの二人、\n段々とお互いを見てると何故かドキドキしててなんであんなやつの事を考えちゃうの!?と、相互ツンデレ状態になり、\n事故キスとかして、私の事が好きなんでしょ！？など言い合い、紆余曲折あって同時にずっと一緒にいなさいよ！いいわね！？などプライドが高い告白がハモって恋人同士になる二人。\n\nだけど相変わらずどっちも素直になれずに喧嘩ばかり、\nエッチしたい時も、どっちも張り合って自分がリードしようとする激しい逝かせ合いのレズバトルになる。\n\n【本編】\n私の方が上よ！だからあんたが私のものなのよ！（例えばお金持ち同士だったらどっちもあんたが嫁に嫁ぎなさいよ、とかでもいいかも）など言い争いの喧嘩をしながらキスをする二人、\nどっちも自分がリードしようとして強引に口を塞ぎ合う互角のキスバトル、どっちも真っ赤になり、指摘し合って否定し合ってムキーとなり、主導権の奪い合いのエッチに。\n私の胸の方が大きいと張り合いながら同じサイズの胸を押し付け合ったり、キスしながら相互手マンしたり貝合わせしたりして、同時にイく。\nそのあと私の勝ちだと主張し合って、はぁ！？とハモったりする\n\n細かい所は微調整して頂ければと。よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@emeguri_y/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3541525, "client_id": 1794785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61fe6c3c/uploads/origins/bce0cf44-b3f0-490b-9a99-5aa4c4eed1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6e29204ac6d3b1f457cf1bd5ee2763a", "srcset": "https://si.imgix.net/61fe6c3c/uploads/origins/bce0cf44-b3f0-490b-9a99-5aa4c4eed1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6e29204ac6d3b1f457cf1bd5ee2763a, https://si.imgix.net/61fe6c3c/uploads/origins/bce0cf44-b3f0-490b-9a99-5aa4c4eed1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4929fba55609cfea07054c2d75d70676 2x, https://si.imgix.net/61fe6c3c/uploads/origins/bce0cf44-b3f0-490b-9a99-5aa4c4eed1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1854a67bd