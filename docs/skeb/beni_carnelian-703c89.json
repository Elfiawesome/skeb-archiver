322-d3a2-4ffd-b839-7ea3a7beba23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b61559138ce3b0db11edf1d1d4eb9e27", "srcset": "https://si.imgix.net/7b4b73f0/uploads/origins/8628c322-d3a2-4ffd-b839-7ea3a7beba23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b61559138ce3b0db11edf1d1d4eb9e27, https://si.imgix.net/7b4b73f0/uploads/origins/8628c322-d3a2-4ffd-b839-7ea3a7beba23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc7e379bd9459e1241b78f5f16f296ba 2x, https://si.imgix.net/7b4b73f0/uploads/origins/8628c322-d3a2-4ffd-b839-7ea3a7beba23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5510bced30c147cc6d658fd468d4bda3 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、幸せそうな雰囲気であれば大丈夫です。)\n\n特徴　けもみみ(キツネ耳)\n\n髪のスタイル　おまかせします\n髪の色　狐のイメージ色でおまかせします。白狐等も可\n\n服装　白無垢\n　(白色又は、少し黄色味のある白色等。お好きな他色を薄く混ぜ可。模様等もご自由に)\n\n使用しないで欲しい物のお願い\n(小物や背景、装飾品での使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため。半透明のものは可)\n赤色和傘の所持　なし　(人物より目立つため)\n狐のお面の装着　なし　(顔が隠れるため。斜め掛けや所持は可。狐面と猫面の違いにご注意)\n\nその他の装飾品や小物等はおまかせします\n\n季節　春～秋\n（季節は参考のため、冬でも大丈夫です）\n天候　天気雨又は、雨上がりの晴れ　\n（天候も参考情報です。気にせず自由に描いてください。夜間の狐火などの描写も可です。）\n\n構図、解像度はおまかせします\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報・配布品製作、地域の祭り等、非商用に限る)\n\n展覧用のため、宛名はナシでお願いします\n\n参考資料等\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n稲穂、巻物、宝珠、鍵の他、狐などの描写も歓迎です\n\n上記の各種設定にとらわれず、お好きなように自由に描いても大丈夫です。\nもし可能でしたら、おしとやかな箱入り娘のイメージでお願いいたします。\nご検討お願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@beni_carnelian/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2610512, "client_id": 7990, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e20b5c5a452ca6b37acb9ba21ba99bc", "srcset": "https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e20b5c5a452ca6b37acb9ba21ba99bc, https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7d18a3fb424a81ab8d1106d51afe286 2x, https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ddd9131b04446a284ee3810693d4e50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06d66b12964bc069e75a0d029e60a159", "srcset": "https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06d66b12964bc069e75a0d029e60a159, https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=930c886ebe57cbdc0b1b2bd456a80ac6 2x, https://si.imgix.net/4a4b7df9/uploads/origins/20481e24-d088-4c7a-a328-c58b3779459d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98ae30521b0b866b9e1200a53d820ff3 3x"}, "body": "CARNELIAN様\n\n初めましてシシンと申します。\nうちの子「天理」のイラストをお願いしたいです。\n\nコンセプトはお淑やかで礼儀正しい巨乳の箱入り娘\n身長１６５ｃｍ、体重６０ｋｇ\nスリーサイズＢ：９０（Ｅ）　Ｗ：６４　Ｈ：８９\n\n腰まである黒いロングストレートの髪に黒い瞳、落ち着いた雰囲気の美人。\nスタイルがよく着痩せするタイプ。\nシンプルで露出の少ない落ち着いた雰囲気の服装を好む。\n\n両親や幼馴染には天真爛漫に振る舞い甘えるが、それ以外には大人しく社交的。物事は大抵器用にそつなくこなす。\n探究心旺盛で興味を持った事に関してはとことん識ろうと行動して、それは止まる事を知らず暴走とも呼べるほど突っ走るので、いつも幼馴染みにフォローされている。\n\nその他の部分は詳細や不明な点を含め全てお任せします、アドリブも歓迎ですので好きにやっちゃってください。\nご都合が合わなかったり、難しいようでしたらキャンセルしてください。\n金額が合わないなどがありましたら条件付き再送依頼頂けると幸いです。\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1IjYWiV9pyJUwLcdxazkH7O6pSfUQguyQ/view?usp=sharing\nhttps://drive.google.com/file/d/1G-cx5I9qDrBgD1MiqSamDosTPCvd7d1X/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@beni_carnelian/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2610512, "client_id": 1621507, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/436d09f7/uploads/origins/53be5847-976a-4696-98b1-33f64432ffe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2faaa200b5fb0e1fa9451ecdcae18291", "srcset": "https://si.imgix.net/436d09f7/uploads/origins/53be5847-976a-4696-98b1-33f64432ffe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2faaa200b5fb0e1fa9451ecdcae18291, https://si.imgix.net/436d09f7/uploads/origins/53be5847-976a-4696-98b1-33f64432ffe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45da79b2da881e3b14b77e0af03092dc 2x, https://si.imgix.net/436d09f7/uploads/origins/53be5847-976a-4696-98b1-33f64432ffe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8d4d390298ea8820580c68a51d41609 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/436d09f7/uploads/origins/53be5847-976a-4696-98b1-33f64432ffe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36340b6492b9919dd8124b2292816e0e", "srcset": "https://si.imgix.net/436d09f7/uploads/origins/53be5847-976a-4696-98b1-33f64432ffe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36340b6492b9919dd8124b2292816e0e, https://si.imgix.net/436d09f7/uploads/origins/53be5847-976a-4696-98b1-33f64432ffe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2682fde4836959bf96f4