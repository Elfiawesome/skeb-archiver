tion": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20417183/uploads/origins/2e03d067-ea54-42b8-9332-593f6cab54a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9efe71b6a0ae45365ccdd4c49af58fbf", "srcset": "https://si.imgix.net/20417183/uploads/origins/2e03d067-ea54-42b8-9332-593f6cab54a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9efe71b6a0ae45365ccdd4c49af58fbf, https://si.imgix.net/20417183/uploads/origins/2e03d067-ea54-42b8-9332-593f6cab54a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ec5496299b40cede6e51778a35cd2e0 2x, https://si.imgix.net/20417183/uploads/origins/2e03d067-ea54-42b8-9332-593f6cab54a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71b0eaf4b0cdadf3ae607297b4110b95 3x"}, "body": "こんにちは、初めて来ました！\n今年は想像以上に難しかったですが、平田ひろた先生の絵はとても綺麗です\n私は絵を描くのがあまり得意ではありません、そのため参考画像が非常に少ない...\nあなたの美しい作品は、いつも私が絵く意欲を掻き立ててくれる理由です！\n\nキャラクターがどんな服を着るか、どんなスタイルにするかは、すべて平田先生次第です！\n\nあ！できればこのキャラクターを優しく扱って頂ければ幸い欲しい、柔らかい毛布や熱いお茶を与えれば、彼はゆっくり休むことができます\n\nhttps://drive.google.com/drive/folders/1P-_kXNLbk5kgkNAwnMnALS994RNoxALB?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hirota_hirata/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 961, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2040e4a2/uploads/origins/ec69fee7-37a9-42d2-92ed-dddf71592285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dea5139846afbc67344868df303e025c", "srcset": "https://si.imgix.net/2040e4a2/uploads/origins/ec69fee7-37a9-42d2-92ed-dddf71592285?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dea5139846afbc67344868df303e025c, https://si.imgix.net/2040e4a2/uploads/origins/ec69fee7-37a9-42d2-9