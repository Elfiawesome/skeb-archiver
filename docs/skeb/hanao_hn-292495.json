auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39da07f6a2c2fb02d6686bd8e9d7ca76, https://si.imgix.net/664da99f/uploads/origins/af2c9fca-5b4f-4297-b0e6-89f8a180b7a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=088f4e4bd7e4431e497de29af0c3b8b9 2x, https://si.imgix.net/664da99f/uploads/origins/af2c9fca-5b4f-4297-b0e6-89f8a180b7a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12446672b8f1e11b5f1ced4f32108e79 3x"}, "body": "Hello sensei! Your art style is so beautiful and elegant. I hope I can request a drawing of my OC.\n\nBASIL (29):\n- A high-ranking bodyguard in a security firm. He was once a low-level lackey, but he survived many fights and outlived all of his superiors.\n- Prideful, mistrusting, and stubborn. In public, he has a calm and confident demeanor, but in private, he is paranoid, easily frustrated, and insecure. He acts coldly towards his teammates, keeping them at a distance out of fear of being betrayed.\n- His hand, fingers, and teeth were cut off by an enemy. He replaced them with gold to show that he is proud of surviving. Deep down, however, he is afraid that his injuries make him weaker than other people.\n- He is a boxer. When he gets frustrated with work, he goes to bars and picks fights with people to let off steam.\n\nMotifs: gold, spilled paint, paper money, whiskey glasses; the pawn chess piece turning into the queen chess piece\n\nFeel free to change his clothes. Thank you for considering my request! ٩(｡•́‿•̀｡)۶\n\nReference images: https://drive.google.com/drive/folders/1vt9WIIJWEOUJvp1AsR1iHjflF9SceJ8U?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanao_hn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1003760, "client_id": 1208881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd6905ad8bc41c69522415af3dc81c3e", "srcset": "https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd6905ad8bc41c69522415af3dc81c3e, https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0edeec7adc5a4cef6dfc34064bc40999 2x, https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00e7280642031d77e9e9030512bd5ab7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4b4104caf88eea443d7d4ace21da570", "srcset": "https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4b4104caf88eea443d7d4ace21da570, https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d53c2d243ad92a1b6f0151b64f34cd 2x, https://si.imgix.net/a7be2b10/uploads/origins/5601f808-8fe4-4daf-9c65-95c1edbe78ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa677fa9a92cc145ce6d674f60e3d42a 3x"}, "body": "こんにちは！あなたの画風がとても好きで、私のオリジナルキャラクターを描いていただけたら嬉しいです。\n\n❓ シカモア | 188cm | 38歳\n\n職業は医師で、鋭い知性と医療の才能を持つ。時々間抜けで軽薄に見えることもあるが、本心は善良だ。\n\n穏やかで落ち着いた雰囲気。常に微笑みを浮かべているように見える。優しいオーラを放ち、冗談で子供っぽく振る舞うこともあるが、人々は概して彼を親切な人物と評価する。実のところ、彼は裏の意図なく温かい心を見せているふりをしているが、実際には無関心な人物であり、過去に多くの愛する者を失い、深い悲しみを経験してきた。悲しむ資格など自分にはないと信じているからこそ、友好的で親切なふりをしているのだ。\n\n家族を奪った災厄の「唯一の生存者」として生きるこの人生に疲れているが、まだ死ぬ資格はないと考えている。深い慈愛と優しさを持ちながらも、それを全て押し殺し、親切で温かい仮面を被りながら、誰からも距離を置いている男。\n\nモチーフ：銀杏の葉。秋の日々。手術台。砕けたガラス。メス。\n\n※ シカモアの両目下にある二つのほくろ、および右目の上の傷跡に注意。\n※ 傷痕、あざ、包帯で覆われていることが多く、常に手袋を着用している。\n※ 首に巻くように走る傷跡を隠すため、チョーカーを着用している。\n※ 右腕には花びらの模様を模した大きな墨絵調のタトゥーがある。\n\nポーズや構図は完全に自由です。衣装を変えて描いても大歓迎です！\n\nいかなる理由でもこの依頼をお断りいただいても構いません。ご配慮いただきありがとうございます！\n\nhttps://imgur.com/a/Bl6M8Hn", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanao_hn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1003760, "client_id": 2496306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51273fa9/uploads/origins/81fab103-1c34-48c6-a782-418197d6ea81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=184410808201cc370a801e987d3e4692", "srcset": "https://si.imgix.net/51273fa9/uploads/origins/81fab103-1c34-48c6-a782-418197d6ea81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=184410808201cc370a801e987d3e4692, https://si.imgix.net/51273fa9/uploads/origins/81fab103-1c34-48c6-a782-418197d6ea81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=351c0f03bc8d344d183aa2242ce224a3 2x, https://si.imgix.net/51273fa9/uploads/origins/81fab103-1c34-48c6-a782-418197d6ea81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a8d401a3109242218ad0b5c5472c730 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51273fa9/uploads/origins/81fab103-1c34-48c6-a782-418197d6ea81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cb23c06b5347e9ebf70f032c603c53e", "srcset": "https://si.imgix.net/51273fa9/uploads/origins/81fab103-1c34-48c6-a782-418197d6ea81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8