uploads/origins/edb663b0-c95e-424f-b8a8-1664bfd35281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979ae9fbf491560f9b05987dbe0d9f0d, https://si.imgix.net/3debbe97/uploads/origins/edb663b0-c95e-424f-b8a8-1664bfd35281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8037e0d429157502193c7b5a3f50c9d 2x, https://si.imgix.net/3debbe97/uploads/origins/edb663b0-c95e-424f-b8a8-1664bfd35281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e4b363dc837d751ae2daf02f13bd3fe 3x"}, "body": "お久しぶりです。再び依頼失礼いたします。\n自探索者の汎用立ち絵の服飾デザインをお願いしたいです。\n服装は春夏秋冬の４種類、髪型はショートからじわじわと伸びていく感じでお願いしたいです。\n髪型や服装は改変可能とさせていただけると大変助かります。\n参考までに自作立ち絵を共有させていただきます。\nhttps://drive.google.com/drive/folders/1nZCYq1z4CjYRIS1vVdyC7SxR8QM_j9KE?usp=sharing\n以上、よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiorikikaku1/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 561143, "client_id": 382967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f509e75cef5b80eb2381d77884944f13", "srcset": "https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f509e75cef5b80eb2381d77884944f13, https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8453421ecd8bbd939b4963cb73a15c1 2x, https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=395e10deb177ffa703193bae086370ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dabc00b3bebee1ac642e84bd2afb18fa", "srcset": "https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dabc00b3bebee1ac642e84bd2afb18fa, https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea1f00854152ad5b692f37203f2e59eb 2x, https://si.imgix.net/b824f54b/uploads/origins/d2a3e47f-edf0-4f11-a3e6-792075eae32f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb3da58a47e2821e02f0c4548abbd02 3x"}, "body": "こんにちは。しおりさんの服飾デザインセンスが好きなため、自作CoCシナリオ「RE:ANIMATION」のNPCが着用する制服をデザインしていただきたいです。\n\nRE:ANIMATIONの詳細ですが、HO1,HO2が恋人同士、HO3,HO4が兄弟などの血縁関係で、導入シナリオでそれぞれHO1,HO3が死亡してしまいます。\nそれを復活させるため、HO2,HO4は禁術を使いHO1,HO3をキョンシーにしてしまいます。それが監視機関の目に留まり、探索者たちは対神話生物殲滅組織に所属し、神話生物を相手にした事件を解決していくキャンペーンシナリオとなっております。\n\n以下にあらすじを貼らせていただきます。\n-----------------------------\n【あらすじ】\nあなたたちは、恋人ないしは家族である。\nどんな困難が起きようと、いつまでもこの平和な日々が続くと思っていた。\n\n──大切な片割れに、死が訪れるまでは。\n\n嘘であってくれ。何度そう思ったかわからない。\nこの人を生き返らせるためにはどんなことでもすると、そう思った。\n……そう、どんなことでも。\n\nそれは、人の理を離れたもの。\n死者を冒涜する禁術。\n\n片割れの死体を用いて、僵尸──キョンシーを作り上げる。\n気づけば、あなたはそんな信じがたい奇跡を起こしていた。\n\nコツ、コツ、コツ。ハイヒールが床を鳴らし、あなたたちの前で止まる。\n「暫伴月將影，行樂須及春。──しばらくの間、月と影とが仲間になり、楽しみは春まで続くべきだ」\n「わが機関へようこそ。歓迎しよう、同胞」\n金色の瞳が、あなたを見てそっと細められた。\n-----------------------------\n\n今回依頼する制服は男女共通で使えるようなデザインで、キョンシーと道士でそれぞれデザインを変更していただきたいです。\nまた、各探索者やNPCごとに、白、青、朱、黒（紫）、黄の色が割り振られているため、制服に反映できる場所があると嬉しいです。\n\n制作いただいたデザインはシナリオに添付して配布させていただくほか、NPCの衣装として起用、またpicrewなどで首から上だけ作れば全身立ち絵ができるような、首から下の立ち絵素材を作成して配布、またシナリオトレーラーに活用させていただきたいと思っております。\n\nまた、今回作成いただいた制服デザインは各自の判断で改変可能、また使用する・しないも個人の裁量に任せたいと思っているため、その点もご承知の上、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiorikikaku1/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/93375c45/uploads/origins/487a900b-5a7a-4fce-ab38-a35292496393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e6d5569f00b16da42277b1c7cb4fba6", "srcset": "https://si.imgix.net/93375c45/uploads/origins/487a900b-5a7a-4fce-ab38-a35292496393?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e6d5569f00b16da42277b1c7cb4fba6, https://si.imgix.net/93375c45/uploads/origins/487a900b-5a7a-4fce-ab38-a35292496393?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10c4556255432ff2be1fa55f54dfd73f 2x, https://si.imgix.net/93375c45/uploads/origins/487a900b-5a7a-4fce-ab38-a35292496393?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2b06c2046fe3b8d77fb0a02e77e69fd 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 561143, "client_id": 3151820, "nc": 145}, {"path": "/@shiorikikaku1/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 561143, "client_id": 3107269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9dc5a06/uploads/origins/335b63a2-8efd-4e50-9f24-eb2563506b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c440be58c881915e65f9e9a7410ac6c7", "srcset": "https://si.imgix.net/a9dc5a06/uploads/origins/335b63a2-8efd-4e50-9f24-eb2563506b66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c440be