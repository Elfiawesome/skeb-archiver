ただけたら思います。\n\n＜資料＞\n三面図、動画画像\nhttps://x.com/y_ha_ag_y/status/1971541950026441019\nYOUTUBE\nhttps://www.youtube.com/@y_ha_ag_y/featured\nX\nTwitter: https://x.com/y_ha_ag_y\nhttps://x.com/y_ha_ag_y/status/1923332617652322446", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 42736, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "白菜ポンズ🎨8931ponzu", "screen_name": "8931ponzu", "avatar_url": "https://pbs.twimg.com/profile_images/1857058675182948352/KA4RQNcC.png", "header_url": "https://pbs.twimg.com/profile_banners/873952680/1731592886/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1385055, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🩷🍽🩶", "screen_name": "Hinari_RIP", "avatar_url": "https://pbs.twimg.com/profile_images/1671131001622532096/Gb16vWro.jpg", "header_url": "https://pbs.twimg.com/profile_banners/756489009375817728/1753567051/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "nc": 33}, {"id": 2320961, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぎゃん", "screen_name": "00Gvq", "avatar_url": "https://pbs.twimg.com/profile_images/1431243186417008645/BkO55V7b.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills"