%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c100669a0853168e0cb7e36d0c09aedf 3x"}, "body": "先生、こんにちは、\n\nあなたの絵がとても好きです。優しい色合いが大好きです。私のVtuber/OCを描いていただけませんか？\n\nマユは神話に登場するメイドで、旅館で巨大な猫に仕えています。彼女は4つの異なる姿を持っています：人間、猫、ヤギ、そしてピカ。彼女は穏やかで、優しくて、柔らかくて、思いやりがある。あまり外に出ず、スポーツも苦手だが、自然が大好き。お菓子作りと猫のご主人様のお世話が好き。\n\n目が花のようなクロスになっている。\n\nポーズや構図は自由ですし、服装も変えられます。また、服装の変更も可能です。\n\nSNSやYoutubeで使用させていただきます。ギャラはいくらでも結構です。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1pT6ZFlArvsjH0hDv4JxWNpxQk6k7tmtn?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@schyoyu82/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1821860, "client_id": 253670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242aa281254395e3798cd07fc7c97706", "srcset": "https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242aa281254395e3798cd07fc7c97706, https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38d22ff1fd815596e1fc47a800500623 2x, https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52711e571752abfd9d9c2e748308b9cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97ded2b63d660a58ee1202a9f7fd2a81", "srcset": "https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97ded2b63d660a58ee1202a9f7fd2a81, https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce11e23ecf299cff0b42fc916c4b6b37 2x, https://si.imgix.net/146729a1/uploads/origins/ff28bf97-dfaa-4500-9828-484390dd1268?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cc8ac075e30b7d1d439151bba2d5178 3x"}, "body": "お世話になっております。\nあつとさんの描かれるイラストの、丁寧で繊細な塗りや人物の豊かな表情が好きで、絵を拝見しては楽しませていただいております。\nこの度は、あつとさんとTRPGで作成したCoC「海も枯れるまで」のふたりを依頼したくリクエストさせていただきました。\n以下、キャラクターの簡易な説明になります。外見等はgoogle driveにて改めて参考にしていただければ幸いです。\n\n○叢雲 ヒメル(むらくも ひめる)\n金髪/眼鏡/男性/180センチ/27歳\nやや皮肉屋で眉目秀麗な男性。英語系配信者。ドイツ人の母と日本人の父のダブル。手先がだけでなく生活•運動動作含めて、ひどく不器用。控えめに、張り詰めた糸を緩めるように笑う。\n\n○波津 希里(なみつ きさと)\n白髪/褐色肌/男性/172センチ/15歳\n好奇心旺盛で天真爛漫な少年。海に囲まれた島で育ち、海も島も好きだがなにより新しいものが好き。砂浜に何か漂着していないか探すのが日課。にこにこと弾けたように笑う。\n\n構図、シチュエーションなど全てお任せします。お好きなままに描いていただければ幸いです。\nお忙しい中恐縮ですがよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/12IcZGIxyEQAIOqR5HwhZ7Pby_aCDj7-3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@schyoyu82/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1821860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a83341f533e0717f3140c60a40b39ae", "srcset": "https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a83341f533e0717f3140c60a40b39ae, https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ac84911e1e688d8e0edeb2edb30ba57 2x, https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=828f8a67815ad702c637788ed69156b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a544b63fdfbab72bf4539df82932552e", "srcset": "https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a544b63fdfbab72bf4539df82932552e, https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9fe3970e1362c03adc4051df61ed3435 2x, https://si.imgix.net/02d5bf0e/uploads/origins/fa75bbb2-e492-4683-b962-bca098805582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f56cffe7a78a5e3e55b02e13d793305c 3x"}, "body": "初めまして。素敵なイラストをいつも楽しく見させていただいています。\n今回、私と友人のCoCで使用している探索者のイラストをお願いしたいと思い、リクエストしました。\n\n〈構図〉\nコンビであると変わるような向き合った構図であれば自由に描いていただいて大丈夫です。\nまた、セッションの立ち絵として使用したいと考えておりますので、可能でしたら個別でも配置できるようにしていただけると幸いです。なお、横並びになる際は①が左、②が右側になるようにしていただけますと嬉しいです。\n\n〈探索者の特徴など〉\n①宇佐見 弥人\n31歳、落語家、男性\n髪：青灰色、少しうねりのある髪質、ハーフアップ、真ん中分けで左の前髪の方が厚い\n瞳：灰色の細長なつり目、太めの眉\n服装：紫色の着物に黒い羽織、紫の扇子をいつも持ち歩いている、細身のフレームのメガネをしている\n他特徴：左目の下に泣きぼくろ、手が大きい\n\n性格：ファンや同業関係者に対しては愛想よく接し、仕事に対しても真面目で真摯な態度でウケがいいが、嫌いな相手に対しては容赦なく笑顔で毒を吐いて煽る嫌味な男。\n「珍しい事もあるもんだ。お前が僕の言葉を気にかけるなんて…明日は台風かな？」\n「僕が他の誰かに取られないように、守ってね。お前以外に振り回されるの、嫌だからさ」\n\n②亜久野緒一\n29歳、極道(若頭)、男性\n髪：茶色背中まである髪を項近くで結わえている、前髪は右側だけで右目がほとんど隠れている\n瞳：ハイライトの無い黒、つり目、左目元にピアスをしている、太めの眉\n服装：白のカッターシャツ(上ボタンは二つほど開けているためネクタイはしない)、ノースリーブスーツ(濃灰無地)を身に着け、肩にスーツの上を羽織ってる(黒無地)、黒寄りの青色の指のラインが出る手袋、革靴\n他特徴：口元にほくろ、顔は美人だが筋肉がしっかりとついている\n\n性格：馬鹿正直、組長に対して絶対の信頼をおいていて真面目に仕事に取り組む。\n組を大切に思っているため、敵対するものに対して容赦がない。ただし、武力を持たない物に対しては乱暴なことはしない、怒らせなければウブで大人しい男。\n「まさかお前が僕達の存在に対して「ゴミ」と言っているのなら、キツい灸でも据えてやらなければと考えただけだ」\n「…いつもの、お前なら。…笑うにしたって、馬鹿にしたように笑うだけだろう。見慣れない顔を、するな」\n\n容姿などの詳細は添付URLをご確認ください。\nよろしくお願いいたします。\n\nhttps://ccfolia.com/rooms/D_DBeHYeU", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@schyoyu82/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1821860, "client_id": 965905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc379942271c858a26d563e0ea2cbd6", "srcset": "https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fc379942271c858a26d563e0ea2cbd6, https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bea4eeecbb85a6845025cd4587fc1d23 2x, https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=456ef810be0dbc00d0e565f50207ed2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98323302a5bdf3f97d5c21767887811a", "srcset": "https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98323302a5bdf3f97d5c21767887811a, https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=459221b6b3e3cdcdf9a27da4397810e4 2x, https://si.imgix.net/2bb058c6/uploads/origins/91f88a6b-a9e7-491b-96f4-bae63e5e2a60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d88202c7d40a064b1b94c7da43a2f67 3x"}, "body": "初めまして、待方といいます。あつと様が描いた探索者様のかわいさに惹かれてぜひうちの子も描いて欲しいと思いリクエストを送らせていただきます。\n以下、男女の夫婦のキャラクター設定・イメージ画像等です。NLが苦手でしたら遠慮なくキャンセルしてください。\n\n■伊織\n32歳 182cm\n嫁ちゃんLOVE娘ちゃん息子くんLOVEな旦那。\nヘラヘラしたチャラい人に見えるが、根は真面目で仕事ができる。派手シャツ(特に花柄)が好き。\n\n■しーちゃん\n32歳 159cm \n案外気が強く料理は少し苦手。気を許した人にはなんでも無い顔して褒める。\n今は2人の子どもの方が大切だが、伊織のことは心から愛している。\n\n▷2人について\n6歳の娘と2歳の息子がいる夫婦。\n高校のクラスメイトだったが、グループが違ったため接点があまりなく、別々の大学に進学したあとに偶然であったことから仲良くなり付き合うことになった。\n伊織は言葉より行動派(キスやハグ、スキンシップをよくする)\nしーちゃんは行動より言葉派(「好き」「かっこいい」等をよく言う)\nお互い得意じゃない方は恥ずかしがる\n\n■構図等について\nしーちゃんからキスされてガチ照れしてる伊織と、普段自分からはしないため照れてしまったしーちゃんを描いていただけるとうれしいです。\n\n服装は完全にお任せ致します。\nこのリクエストを読んでいただきありがとうございます。どうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1pAIprnSuu0o8QxFJx2J6J37WA3HS0KlI", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@maxojima_game/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1992624, "client_id": 1821860, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8279cc78/uploads/origins/e62b8ed4-b15f-4776-849f-6768a1b4d8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8b6f0b3c5a28b6b23cdcfe50750d55", "srcset": "https://si.imgix.net/8279cc78/uploads/origins/e62b8ed4-b15f-4776-849f-6768a1b4d8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8b6f0b3c5a28b6b23cdcfe50750d55, https://si.imgix.net/8279cc78/uploads/origins/e62b8ed4-b15f-4776-849f-6768a1b4d8f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a543cf11d2a11073d6a2d09e0aa1a096 2x, https://si.imgix.net/8279cc78/uploads/origins/e62b8ed4-b15f-4776-849f-6