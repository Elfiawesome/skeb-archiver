s/origins/4f9744f4-8dad-493b-91b5-ab4a692eac0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=102b9c71981e4c2e130872f4c70d978a 2x, https://si.imgix.net/a5e66e1c/uploads/origins/4f9744f4-8dad-493b-91b5-ab4a692eac0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f097fcef8d37a5883da209d8b770c1c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5e66e1c/uploads/origins/4f9744f4-8dad-493b-91b5-ab4a692eac0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=017e571a25edac86be4506e96e0db2b3", "srcset": "https://si.imgix.net/a5e66e1c/uploads/origins/4f9744f4-8dad-493b-91b5-ab4a692eac0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=017e571a25edac86be4506e96e0db2b3, https://si.imgix.net/a5e66e1c/uploads/origins/4f9744f4-8dad-493b-91b5-ab4a692eac0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=422113dc704adb154ec4f365c739b7a5 2x, https://si.imgix.net/a5e66e1c/uploads/origins/4f9744f4-8dad-493b-91b5-ab4a692eac0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=afad96d126b34a94933a6c8d643bb032 3x"}, "body": "はじめまして、アピールありがとうございます。\n違うキャラになりますが、薄雲レースクィーン姿の深雪(艦これ)をお願いします。\n\n薄雲レースクィーンの衣装については資料をご参考ください。\nレースクィーン衣装ですが、胸の番号を4、首のチョーカーの文字をMIYUKIにしていただけると嬉しいです(もし、描かれる場合ですが)。また、脚の魚雷発射管(武装)は描かなくても大丈夫です。\n\nその他、構図や背景、手に持っているもの等は全てお任せします。\n\n以上です。\nご検討のほど、よろしくお願いします。\n\n<資料>\n深雪(艦これ)：https://blog-imgs-112-origin.fc2.com/k/c/w/kcwiki/No014_0_CD.jpg\n薄雲RQ衣装：https://pbs.twimg.com/media/Fd8NZwjaAAAlHJD?format=jpg&name=large", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@017b7GPZOXMaMaI/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3169722, "client_id": 1524117, "vtt_url": null, "thumbnail_image_