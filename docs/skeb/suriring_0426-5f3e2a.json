52-be72-e715c6810206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7815cf530005e911fa589074b3616dd0, https://si.imgix.net/dde74f16/uploads/origins/a408e6c3-312a-4552-be72-e715c6810206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ba408c20d22b3f8550290c772b2d773 2x, https://si.imgix.net/dde74f16/uploads/origins/a408e6c3-312a-4552-be72-e715c6810206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58f4a8e4302eba0016aebe6a01363607 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dde74f16/uploads/origins/a408e6c3-312a-4552-be72-e715c6810206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cbe5fe47a93da9c47be3c4e9cafd4f1", "srcset": "https://si.imgix.net/dde74f16/uploads/origins/a408e6c3-312a-4552-be72-e715c6810206?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cbe5fe47a93da9c47be3c4e9cafd4f1, https://si.imgix.net/dde74f16/uploads/origins/a408e6c3-312a-4552-be72-e715c6810206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad69ff78baccbcc72376b67daec051a 2x, https://si.imgix.net/dde74f16/uploads/origins/a408e6c3-312a-4552-be72-e715c6810206?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfca0a5ae1ae150c9a5058cf37860bb7 3x"}, "body": "こんばんは、私のＯＣのおねショタイラストをお願いしてもよろしいでしょうか。\n邪悪な敵のお姉さんなので、そういうタイプもＯＫ描きたいと思っていただけたら受けてほしいです。\n\n■キャラ\n占い師ティエナ\nhttps://drive.google.com/file/d/1hDC8NdkdEw39dw7kIKxiejAE3EuuDZDV/view?usp=drive_link\n（頭巾のピラピラした飾りは面倒だと思うので適当に減らすか無くしてokです）\nショタ勇者一行を貶めようとする魔物の幹部的な存在。\n人間に化けて街で接近し、堕としていこうとする。精神に作用する魔法が得意。\n性格はＳ。表面上は優しい姉もしくはママ的な穏やかなふるまいだが、内心は自分の魔法と身体で正義感にあふれるショタの魂を邪悪に穢していくのが楽しみでたまらない。\n\n身体の特徴\nデカい！（https://x.com/suriring_0426/status/1795470148436107482）くらいの差がある。もっとあってもいい。\n魔族っぽく黒目が横長なので注意。\n胸はシチュが生えるように盛ってもヨシ\nすりりんぐさんの絵のようにもっとムチっとさせてもヨシ\n\n\n\n魔法使いくん\n金髪（シチュ的に見えないけど）\n大人しくて自信がない。\nとても背が小さい\n\n■シチュ（これ全部描いてくれという訳ではなく、こういうイメージの絵という参考にしてくれればという感じ。創作意欲の足しになったら嬉しいです。）\n勇者たちが訪れた町で長期滞在することとなった。仲間たちの成長についていけない魔法使いのショタくんは自信を無くし、なにかのきっかけにと町はずれの占いの館を一人で訪問した。そこで出会った占い師ティエナは優しく話を聞いて占いをしてたが水晶玉を見ていると意識が朦朧とし…気づけば服の中に囚われて洗脳調教を受けていた…。（前置き）\n始めは抵抗していた魔法使いくんは浴びせられる魔法と甘い言葉で誘惑され朦朧としていき、唯一拘束が緩い股間周りをヘコヘコと動かしはじめてしまう。一度、二度、三度と腰を打ち付けるほど快楽が増え続け腰は止まらなくなり、遂に射精してしまう魔法使いくん。しかし魔法によって性欲は全く収まらず、魔力が精液に変換されひたすら射精をしていく…。\n数時間後、精液が水たまりになるほど出し空っぽになった魔法使いくん。このことは秘密にして、また来るのよという言葉に、ぎゅぅっと服の中でおっぱいにしがみいて肯定する姿をみてティエナは邪悪に微笑むのだった。的な感じ。\n\n■画面\n画面比は４：３で作成をお願いしたいです。\n\n■構図（下記に全体的イメージを出すので最終的なイラストの構図はお任せします。）\nイメージ（https://drive.google.com/file/d/1Gde0fxpTGcXihbXRpWOYO-eGhZQK9Thz/view?usp=drive_link）\n服の中に拘束ってどんな感じという参考（https://www.pixiv.net/artworks/105821670）\nイメージは大体こんな感じということでキャラ資料に自分で描き足したものです。ポーズはお任せ、あくまでサイズ感とかざしてる手とか魔法のイメージの参考に。\n魔法使いくんは服の中に入れられ、ミチミチにおっぱいと服の間に裸で拘束されている。\n妖美に微笑むティエナは、まるで水晶玉に手をかざすように両手を服で覆われた魔法使いくんの頭にかざし、キィィンとピンク色の魔法を頭の中へ注ぎ、頭の部分が服の中で妖しく発光している…的な状態。\n\n差分に関しては細かく指定しないので、金額内で自由に描写してくれればと思います。\n射精だけお願いがあり、魔法によって精液は大量射精にされているという事で、\nバケツ一杯流したみたいに谷間から糸引いて流れてる精液描写が欲しいです。ブシャァと爆発するような感じではなく、ドロォ…という感じで谷間から流れ落ちていく感じのイメージでおねがいします。\n\n以上となります。\n長くなってしまいすいません！もしもこういう悪いデカ女に調教されるシチュが描きたいと思っていただけたらよろしければお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suriring_0426/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6261d0c1/uploads/origins/7a0381cf-7257-4316-b6d6-605b16837d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8058f5e297c1d92d16e06c1a4be17de9", "srcset": "https://si.imgix.net/6261d0c1/uploads/origins/7a0381cf-7257-4316-b6d6-605b16837d84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8058f5e297c1d92d16e06c1a4be17de9, https://si