200&h=200&blur=200&s=5659042dc1d7e25150ebe92c02ac1e19 2x, https://si.imgix.net/7a3d79d6/uploads/origins/e0b03803-0423-4a82-8399-6f39047d7beb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=597af0dd83eb71d0cedcaedf123ceb26 3x"}, "body": "こんにちは\n\nVTuberのMiilkywayz（https://imgur.com/a/ai71o09）のアートを依頼したい。\n\nミルキーの胸の間に金髪のショタがいるはずです。シーンはこんな感じ（https://files.catbox.moe/525jf3.png）。\nミルキーはショタに母性的で甘い。ショタはミルキーの柔らかさに包まれるのが大好きだ。\nミルキーは乳房からミルクを漏らしているはずだ。\nできればオーガズムの違いが欲しい。\n\nよろしくお願いします。", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suriring_0426/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1882836, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376001212c1637058c1ad95219c69674", "srcset": "https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376001212c1637058c1ad95219c69674, https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0808346e9a6c988c6d7693a64ff88011 2x, https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1ce6c61c834e3bb32c38f143951c9d3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d205959fbd3ee59119010fe16d20a97", "srcset": "https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1d205959fbd3ee59119010fe16d20a97, https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b72ac1d19ba31d580985d72d3c7b83c 2x, https://si.imgix.net/d5f785a0/uploads/origins/5ee7ee71-e52d-481e-b914-eb8a84effe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ecf7df47d43de66fef02c0aac33e97c 3x"}, "body": "自分の持ち主であるマスターに魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で爆乳化即堕ちアへ顔アクメをキメる遊戯王OCGのRAI-MEIをリクエスト致します。\n\n・下記のポーズの立ち姿を真正面から見て膝下までの写した図\n・脚を大きく開いて腰を深めに落としたガニ股\n・両手は顔の横に持ってきてダブルピース\n・ほぼ白目を剥いた状態のアへ顔で潮吹き絶頂している\n・ウエストと同じくらいの太さの太もも\n・バストサイズは頭より大きく、へそが隠れて下腹部が見えるくらい\n・コスチュームは元のカードのイラストと同じ物で、布越しに乳首と乳輪(どちらも大きめ)がくっきりと浮き出ている\n\nといった要素を指定致します。\n\n加えて、以下のシチュに沿った台詞のテキストを付けて頂きたいです。\n\n・目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され訳も分からぬまま間抜けな叫び声を上げて絶頂する。\n・微かに残った意識で止めさせようとするも快楽に負け更に汚い淫語を満載したアへオホ声で絶叫しながらイキっぱなしになる。\n\n…といった内容で、キャラクターの性格や口調はお好きなイメージで構いませんので、とにかく下品で無様なワードで画面を埋め尽くして欲しいです。\n\nまた、絶頂する直前の表情とセリフの差分を一枚目として付けて頂きたいです。こちらはニヤニヤした顔で自分の事をエッチな目で見てくるマスターを小馬鹿にするような態度(好感度は高め)で、自分から上記のポーズを取ったシーンということでお願いします。\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suriring_0426/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1882836, "client_id": 26970, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/956741e7/uploads/origins/06d28477-38b6-4059-9bf1-a48c13451401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2034906d9529b24494147633a06508bd", "srcset": "https://si.imgix.net/956741e7/uploads/origins/06d28477-38b6-4059-9bf1-a48c13451401?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2034906d9529b24494147633a06508bd, ht