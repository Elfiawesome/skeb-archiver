s/origins/b56edf73-ddfe-4cd3-894f-5e1f4b64db4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19bc36b6725268babbea59be7bc1b8d9, https://si.imgix.net/e0ab0577/uploads/origins/b56edf73-ddfe-4cd3-894f-5e1f4b64db4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ca9ae8973899e50872c77d83947e893 2x, https://si.imgix.net/e0ab0577/uploads/origins/b56edf73-ddfe-4cd3-894f-5e1f4b64db4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4cb3b8d773d64d664ed7fbcb1ccc88d1 3x"}, "body": "グランブルーファンタジーでついに！　実装された推しキャラクター！\nSSR土キャラクター「ベルソー」をお願いします！\n\nグラブルで依頼時点の現在（2025/08/29～2025/09/06）実施中のイベント「Apocrypha:After the Fall」で絶賛活躍中、初出はSSR土キャラクター「オリヴィエ」のフェイトエピソード内に出てくる子です！\nガチャにもつい先日、恒常キャラクターとして実装されました！！\n\n耳の形、頭の角、大きな胸。女の子ドラフ目線で考えると、ほんの少し背が高いですけど、152センチという小柄な背丈。星晶獣（堕天司）で初めて、明確に「女の子のドラフ」を参考にしたなと思えるベルソーちゃんが、もう本当に本ッ当に大好きで大好きで…！　どうか琴乃さんの描いた彼女が見てみたいです！！　おねがいしまーす！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@genshin_koto/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1030947, "client_id": 2735288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8de29fb7419e9491dcd908b37d05f07", "srcset": "https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8de29fb7419e9491dcd908b37d05f07, https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c06f6c81148f777e15a5fe25abd1f99f 2x, https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1cc0d67168c1512802ce00ced86cee7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f2f1c7c4efa98386ef59b03f93fed3c", "srcset": "https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f2f1c7c4efa98386ef59b03f93fed3c, https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe86a0be7cd07ad370a9ca51203fe54a 2x, https://si.imgix.net/1522eaef/uploads/origins/810601f7-5d43-476b-aa2c-a7d20ea729c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84b24b2163af5249fa3198eb880e933a 3x"}, "body": "私のOCのアートが欲しい。彼女はソーダがベースで、髪と目に泡がある。また、彼女は幽霊のように青白い肌をしていますが、吸血鬼です。彼女のリファレンスシートはリファレンス1にあります。参考資料2はアートピースの例です。誰かが目を覚ますと、隣に彼女が横たわっているように、ベッドに横たわっていてほしい。参考資料3は、私が描いているポジションの例です。夜にしてほしい。彼女の真っ赤な目が一番目立つように。あとはお任せします。貴重なお時間を割いていただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1rZiUkhdbU9BxVeo410dEyXsdseh8-JGC?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@genshin_koto/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1030947, "client_id": 3143746, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46e7f01e/uploads/origins/4c8fb453-f6c6-41bb-b219-5405e611f366?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6bdbbc691afb936aacd17d7e478264a", "srcset": "https://si.imgix.net/46e7f01e/uploads/origins/4c8fb453-f6c6-41bb-b219-5405e611f366?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6bdbbc691