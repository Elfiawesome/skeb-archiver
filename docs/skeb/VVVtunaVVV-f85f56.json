4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c334619d11da44301ebdb4bc1624caa4, https://si.imgix.net/25b78cca/uploads/origins/c139b1a1-32cb-4b9b-9ffd-dade03000b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05f2849276f3588ff498ad36e10f7f39 2x, https://si.imgix.net/25b78cca/uploads/origins/c139b1a1-32cb-4b9b-9ffd-dade03000b74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e40445f0d2251d94a40a4822b5507692 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2142707, "nc": 128}, {"path": "/@VVVtunaVVV/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2142707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc37c9d18d06b303d80515360b80d16", "srcset": "https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc37c9d18d06b303d80515360b80d16, https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4db2572014eda7f09e0b53c3863fe238 2x, https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=562104725dc7b42009d9391dbc9f2922 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0967122a67aac450516f599e69e7bca7", "srcset": "https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0967122a67aac450516f599e69e7bca7, https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44effd84b468097049ac2be897f43ecc 2x, https://si.imgix.net/fdefd856/uploads/origins/6694bf18-e441-4f80-ac87-7cd5067c2308?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec93262cf51991dc14b0707883b052e 3x"}, "body": "はじめまして\nかっこよくてかわいいイケメンたちに一目惚れしました！\n\nよければムーンライトノベルスやエブリスタに掲載している自作BL小説、触手を飼うの受けと攻め（＋触手）をお願いします\n\n■あらすじ\n大学生の小田原瞬平はバイト帰りの橋の上で瀕死の触手を拾った。\n弱った触手をほうっておけずアパートに連れ帰り、見切り品弁当のからあげを与え、様々な芸を仕込む瞬平。\n友人の沢尻は瞬平が飼い始めた内緒のペットを知りたがるが、のらりくらり適当にごまかす。\nとはいえ現実は非情である。\n最初はキモかった触手がだんだん可愛く見えてきた頃、恐るべき「本性」を目の当たりにして……。\n\n■描いてほしいキャラ\n瞬平（20）\n強気平凡受け\nトイプーの飼い主の大学生。\n性格　少々お調子者　ドジ　面倒見が良い\n趣味　YouTubeで犬猫動画を視聴すること\n好物　バイト先のコンビニの見切り品のからあげ弁当\n\n沢尻（20）\nイケメン隠れオタク攻め\n大学生　瞬平の友人　見た目はモデルのようにシュッとした高身長のイケメン\n周囲には内緒にしてるが実は宇宙人マニア\n瞬平に片想い\n性格　スマート　誠実　友達想い　趣味の話になると饒舌になる\n\nこの二人の2ショット＋ピンク色の触手をお願いします\n触手はマスコット風にデフォルメされたもので\n\n雰囲気\nほのぼの　仲良し　キュート　ポップ\n\nモチーフにしてもらえると嬉しいもの\nUFO　SF　星　宇宙\n・強制ではありません。採用していただける場合は一個でも複数組み合わせでもご自由にどうぞ\n\n受け攻めのキャラデザはカッチリ決まってないので、お好みでどうぞ\n矛盾点や不明点おまかせ　アレンジ歓迎\n\n完成品はネット小説の表紙・挿絵・宣伝ほか、kindleで販売している電子書籍の表紙に使わせてください\nお名前とTwitterアカウントは明記します\n\nご縁がございましたらよろしくお願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@VVVtunaVVV/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2142707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18957038/uploads/origins/8efb31c4-edd3-4779-8e81-efd1ba721