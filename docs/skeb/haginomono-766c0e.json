n160cm/17歳（※社員歴はかなり長いが、班内最年少）\n人種：エキゾチックな南アジア系。幼い頃に日本に移民したため、日本の文化も言葉もしっかり馴染んでいる。\n性格：職務に真面目。年齢より大人びている。無愛想。素直になれない。自由な年上の班員たち（自陣）に振り回されがち。カレーはナン派。\n補足：派手な黄色いアジアンストールは両親からの贈り物で\"刀を振る時以外\"は基本身につけている。\n\n用途：個人鑑賞+クレジット表記またはSkebの完成イラストページURLを記載の上で、SNSや他者に画像を紹介させていただくかもしれません。（※問題ありましたら再送依頼お願いします）\n\n宜しければご検討くださると幸いです。\n\nhttps://drive.google.com/drive/folders/1-cKwYDnxOCH_8NJ40G6f82el_pjLd7UP", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@OekakiAsari/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1803893, "client_id": 1011335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69339d16/uploads/origins/404acc2b-3dd8-4744-a4cf-b4fcd26cc835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=757b09582240b32376d0b60f6a578d6e", "srcset": "https://si.imgix.net/69339d16/uploads/origins/404acc2b-3dd8-4744-a4cf-b4fcd26cc835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=757b09582240b32376d0b60f6a578d6e, https://si.imgix.net/69339d16/uploads/origins/404acc2b-3dd8-4744-a4cf-b4fcd26cc835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aadad8c0a7ce46b07ca20f09cec4ecb9 2x, https://si.imgix.net/69339d16/uploads/origins/404acc2b-3dd8-4744-a4cf-b4fcd26cc835?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4a16451c9adf2a9e9b1f0d10f20a902 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69339d16/uploads/origins/404acc2b-3dd8-4744-a4cf-b4fcd26cc835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a2cc20f356606126300556fe9ad06bd", "srcset": "https://si.imgix.net/69339d16/uploads/origins/404acc2b-3dd8-4744-a4cf-b4fcd26cc835?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a2cc20f356606126300556fe9ad06bd, 