ody": "まめぴ先生\n猛暑の毎日でございますが、いかがお過ごしでしょうか\n\n今回、夏ということでイラストのご依頼をしたく連絡させていただきました\nお願いしたいイラストは、前回の依頼で描いていただいたイラストのキャラデザインをベースに\n暗めの紺色の甚平と、綿あめを片手に持った構図で描いていただけないでしょうか？\n\n御多忙の中読んでくださりありがとうございました\nこれからもっと暑くなるかと思いますので、ご自愛くださいませ\n\n一応前回描いていただいたものを貼っておきます。\nよろしくお願いします。\nhttp://imepic.jp/20220802/746690\n\nじん", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@krmmjj2/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b1a1aa08/uploads/origins/2841d11c-7979-4008-99a8-b9272205a28d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=800ac775a5ca572239139dac9777357e", "srcset": "https://si.imgix.net/b1a1aa08/uploads/origins/2841d11c-7979-4008-99a8-b9272205a28d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=800ac775a5ca572239139dac9777357e, https://si.imgix.net/b1a1aa08/uploads/origins/2841d11c-7979-4008-99a8-b9272205a28d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=615206b962c6809874565c25216bcdc2 2x, https://si.imgix.net/b1a1aa08/uploads/origins/2841d11c-7979-4008-99a8-b9272205a28d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d436ada75945fa6c33727f523ca8bbc 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1320798, "client_id": 1210641, "nc": 145}, {"path": "/@krmmjj2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1320798, "client_id": 1424633, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8c71b90/uploads/origins/68627