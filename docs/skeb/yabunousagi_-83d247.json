6bdc8f880823f80f7369dc5cd60c4 2x, https://si.imgix.net/21944dcd/uploads/origins/035f9e2f-c320-4584-9c94-dfb783ec212b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec1a893ebc0b1268729018e8716d1b28 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21944dcd/uploads/origins/035f9e2f-c320-4584-9c94-dfb783ec212b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51841f4cd42e085c43f63e08da0a4714", "srcset": "https://si.imgix.net/21944dcd/uploads/origins/035f9e2f-c320-4584-9c94-dfb783ec212b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51841f4cd42e085c43f63e08da0a4714, https://si.imgix.net/21944dcd/uploads/origins/035f9e2f-c320-4584-9c94-dfb783ec212b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4ff4bc17169831dce33644d75706cad 2x, https://si.imgix.net/21944dcd/uploads/origins/035f9e2f-c320-4584-9c94-dfb783ec212b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48c49ebab259db498999cf6c6384a401 3x"}, "body": "どうも、いつも素晴らしい絵を拝見させて頂いております。おかげさまでラバースーツの性癖に目覚め、私めの性癖と「超融合」して悟りを開けました。\nあなた様には私めの“境地”を描いて頂きたく存じます。\n\n横長の絵にはなりますが\nエゾヒグマ、カムチャッカオオヒグマ、コディアックヒグマのL♡Lベアーズの三人がラバースーツを着て鼻あたりまで出ている全頭マスクを付けて鼻フックで上と左右から鼻の穴を広げられており、開口器を付けられて、さらにフレームバインダーで腕を頭のうしろで組んだ状態で全身を拘束されている絵を描いて頂きたいです。\n\n差分としては\n全裸差分(鼻フックと開口器はそのまま)と首から下のラバースーツを脱いだ差分、全頭マスクだけ脱いだ差分をよろしくお願いします。\n全裸差分とラバースーツを脱いだ差分では股をグチョグチョに濡らしてほしいです。\n\n何卒よろしくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yabunousagi_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2154523, "client_id": 3389601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05a80854/uploads/origins/f5b2c992-4c21-4316-b9dd-443c9d08c8bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=