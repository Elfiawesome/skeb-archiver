crop&crop=top&w=200&h=200&blur=200&s=08e450410e4705579d154c9ae1cf2d69, https://si.imgix.net/5f6c7bee/uploads/origins/cbe1c71a-ad0b-473e-a9e7-91cf9a13bf74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c937d02ec8fadcb7675766a36d83b30 2x, https://si.imgix.net/5f6c7bee/uploads/origins/cbe1c71a-ad0b-473e-a9e7-91cf9a13bf74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=692b7774082179e7e117a932ef75b2c8 3x"}, "body": "再びお願いします。私のオリジナルキャラクター、カウガール・サブリナを描いていただきたいです。彼女は田舎出身の身長230cmのカウガールです。おてんばで強い田舎訛りがあり、カウボーイに憧れています。普段は自信家ですが、帽子を取られると実はとても恥ずかしがり屋です。二丁拳銃「星条旗」の狙撃の名手です。\nクールでセクシーな印象を与えつつ、田舎娘らしさとガンマンとしての側面も少し感じさせるポーズ／構図をお願いします。ご自由にアレンジを加えていただいて構いません。作品をお待ちしております！サブリナ：https://photos.app.goo.gl/DFmVSrj8HnNHuPjr5", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamafuzi_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1753828, "client_id": 281705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eec963cea9866d819ab1aa68e13eca4", "srcset": "https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eec963cea9866d819ab1aa68e13eca4, https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f434fb8c5623c5ec85fea7d053f8d44 2x, https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b03d1d5e1c9e74bf4026f46460b7affa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23879196b8aa59ddff42a8036c6a5535", "srcset": "https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23879196b8aa59ddff42a8036c6a5535, https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3101819fa0705209dcf117499b3d11e4 2x, https://si.imgix.net/5a6df1a5/uploads/origins/721eff66-8fca-4df7-ac4e-3784ffdf0a75?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6502dba308e02fa98d6f1a5e8ae6516e 3x"}, "body": "こんにちは、こんにちは！私のキャラクター、タカラのイラストを描いていただけませんか？彼女はお茶目なジェスターのようなゴーストガールです。吸血鬼のような牙を持ち、比較的下半身が重い。いつも満面の笑みを浮かべていて、気になる人にイタズラをして愛情を示しています。普段はゴーストのようなピンク色だが、ダークエルフの兄妹に似た姿のコーポリアル・フォームもある！\n\n説明文をもとに自由に描いてください！\n\nhttps://drive.google.com/drive/folders/1grFhVzlTSA4eG8_FHcNv3UF_fH91nDUZ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamafuzi_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1753828, "client_id": 1625790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51c3a3e1c29fd1c3c28369de838f61d6", "srcset": "https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51c3a3e1c29fd1c3c28369de838f61d6, https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a49d68003736fd5aba2392c04a0989cf 2x, https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4927fd2437ec4d00a8f5a11bae43c841 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7903cdf91bae4a4d52b50584fe9e0f93", "srcset": "https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7903cdf91bae4a4d52b50584fe9e0f93, https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=156b830490d76d0d3dec6e890e3b924c 2x, https://si.imgix.net/a6106985/uploads/origins/56cbe029-bfa2-4c50-987c-f1ef889fb1c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc225db4256ed258e75494a788a9409 3x"}, "body": "こんにちは、あなたのアートスタイルが大好きです。僕のキャラクター、アマニを描いてもらえませんか？アマニは商売に夢中な雑貨商。人の笑顔を見るのが大好きだからです。お金の輝きも。アマニは、繊細な手だけがお金を動かすことができると信じているので、手や爪を手入れしている。  ダークブラウンの肌に、黒く太いアフロヘア。彼女の全身イラストがないので、服装はお好みで変更してください。ポーズとしては、片手にコインの入った袋を持ち、もう片方の手は腰に当てています。でも、ポーズやシーンはお好きなように描いていただいて構いません。リクエストを読んでいただき、ありがとうございました。\n\nアマニ 参考：https://drive.google.com/file/d/1nRgT5GGV8GfXxQjINdibPn7AXCjXeZF3/view?usp=sharing\n\nコインの入ったバッグ：https://media.gettyimages.com/id/185109326/photo/money-bag.jpg?s=612x612&w=gi&k=20&c=Ad6kJ7AgN0ZLy9g44i0QiSrgQ7vdt3BHnzFr4WyGSp8=\n\nアマニの手：https://pin.it/71QD3cOvw\n\nアマニの肌色: https://i.pinimg.com/736x/10/a2/d8/10a2d85d88eaa300b5107e7deb60f56f.jpg\n\nhttps://drive.google.com/file/d/1nRgT5GGV8GfXxQjINdibPn7AXCjXeZF3/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamafuzi_/works/11", "private_t