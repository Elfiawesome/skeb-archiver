webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2be1ef331bee358067d32fda60900633 2x, https://si.imgix.net/6f76625f/uploads/origins/19c210b7-4877-48c4-b1af-d862f7aca679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b6d337bc386152065de11a6f7f4483f 3x"}, "body": "\ud06c\ub9bc\uc2a8 \uc694\ub9c8 \ub300\uc804\uc758 \uc8fc\uc778\uacf5, \uc544\uc0ac\uce74 \uc774\ube0c\uac00 \ud504\ub85c\ub355\uc158\uae4c\uc9c0 \uc57c\ub77c \ubc84\ub9ac\ub294 IF \ubc30\ub4dc \uc804\uac1c\ub97c \ubd80\ud0c1\ud569\ub2c8\ub2e4. \uce90\ub9ad\ud130 \uc758\uc0c1 : \uc774\uc57c\uae30 \ucd08\uae30\uc758 \uc774\ubbf8\uc9c0\uc774\ubbc0\ub85c, [\ubcf4\ud1b5\uc744 \uc6d0\ud558\ub294 \uc0ac\ub78c]\uc758 \uc81c\ubcf5 \ubaa8\uc2b5 \ub610\ub294 [\uc8fc\ubaa9\uc758 \ub8e8\ud0a4]\uc758 \ubb34\ub140\ud48d \uc720\ub2c8\ud3fc \uc758\uc0c1 \uc2dc\ucd94 : \uc694\ub9c8 \ud1f4\uce58\uc758 \uc784\ubb34\ub85c \uc5b4\ub5bb\uac8c\ub4e0 \uc2b9\ub9ac\ud558\ub354\ub77c\ub3c4 \ud798\uc744 \ub2e4 \uc18c\uc9c4\ud558\uace0 \uae30\uc808\ud558\uace0 \uc758\uc2dd\uc744 \uc783\uc5b4 \ud0c0 \uc774\ube0c\ub97c \ucc3e\uc740 \ub0a8\uc790\uc5d0 \uc758\ud55c \ud14c\uc774\ud06c \uc544\uc6c3 (\uc790\ud0dd\uc774\ub418\uc5b4 \ud3d0\ud5c8 \ub098\ub984) \uc774\ud558\uc758 \uce7c\ub77c \uc77c\ub7ec\uc2a4\ud2b8 & \ub300\uc0ac \ucc28\ubd84\uc744 \ubc1b\uc744 \uc218 \uc788\uc73c\uba74 \uae30\uc069\ub2c8\ub2e4. \u2460\uc800\ud56d\ud558\ub294 \ud798\uc774 \uac70\uc758 \ub3cc\uc544\uc624\uc9c0 \uc54a\uc740 or \uc591\uc190\uc774 \ubb36\uc5ec \uc788\ub294 \ub4f1\uc758 \uc0c1\ud0dc\ub85c \ucc98\ub140\uad6c\uba4d\uc758 \uc785\uad6c\uc5d0 \uc774\uce58\ubaa8\ud2b8\ub97c \ubc00\uc5b4 \ub123\ub294\ub2e4(\uc815\uc0c1\uc704) \u2461\uc800\ud56d\uc744 \uc2dc\ub3c4\ud558\ub824\uace0 \ud558\uc9c0\ub9cc \ubab8\uc774 \uc6c0\uc9c1\uc774\uc9c0 \uc54a\uace0, \ub9c8\uce68\ub0b4 \uadc0\ub450\ub97c \uc0bd\uc785\ub418\ub294 \uc774\ube0c\u2462\uc0bd\uc785\uc774 \uc9c4\ud589\ub418\uc5b4, \uc774\uce58\ubaa8\uce20\ub85c \ub9c9\uc744 \uaf42\uc544, \uc774\ube0c\ub294 \ucc98\ub140\ub9cc\uc740 \uc6a9\uc11c\ud574 \uc8fc\uc5c8\uc73c\uba74 \uac04\uccad\u2463\uc6a9\uc11c \uc5c6\uc774 \ucc98\ub140 \uc0c1\uc2e4\u2464\uaca9\ub82c\ud55c \ud53c\uc2a4\ud1a4\uc5d0 \ud5d0\ub5a1\uc774\ub294 \uc774\ube0c\u2465\ucd5c\uc548\uc5d0 \uc9c8 \ub0b4 \uc0ac\uc815\ub418\uc5b4 \uc808\uc815", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ww04045/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1101256, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80714a95dce0f5860d3f9afbd1e910d6", "srcset": "https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80714a95dce0f5860d3f9afbd1e910d6, https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b61706e16e775dc68cfa6aef0913be44 2x, https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ad1987912ced35fc27e0f488771a602 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dff208f29900f68ee35c105cf5817bf", "srcset": "https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dff208f29900f68ee35c105cf5817bf, https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d1a74443d443243d657604d65653f25 2x, https://si.imgix.net/a0c61535/uploads/origins/2922064f-b9df-4254-92ae-445198e96ece?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e78a64a11b276242bbcbc7ed9794521e 3x"}, "body": "\ubd80\ud0c1\uc774 \uc788\uc5b4\uc694 \ud1a0\ubaa8\uce74 \uc720\uc6b0\ub9ac - https://imgur.com/a/BTvZS7L https://kinpiray.livedoor.blog/archives/6487424.html \ubaa8\uce58\ub2e4 \uc544\uc988\uc0ac - https://imgur.com/ED6seZa https://kinpiray .livedoor.blog/archives/6487004.html \ub458 \ub2e4 \ud14c\uc774\ud504\ub85c \ubb36\uc774\uace0 \uc7ac\uac08\uc744 \ubb3c\ub838\uc2b5\ub2c8\ub2e4. \ub4a4\uc5d0\uc11c \ub354\ub4ec\uae30.", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ww04045/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1101256, "client_id": 1202629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffab07850d527775b970ebace0a8a28", "srcset": "https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffab07850d527775b970ebace0a8a28, https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3205b8384aa40131829b9fadf8d15a14 2x, https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7adea7850df295c587a790310b08c805 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7db3a1aeb607deb3bec3c41c02b2ca", "srcset": "https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7db3a1aeb607deb3bec3c41c02b2ca, https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8950ee94ff559f093ca7586aa955dbb1 2x, https://si.imgix.net/dc052a00/uploads/origins/2d8af720-5038-47f0-a4e0-c98646d6bb65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e68bddbc238148cc6a97b0d97cc0941f 3x"}, "body": "\uc5b4\ud544 \uac10\uc0ac\ud569\ub2c8\ub2e4! \uc6d0\ud55c\ub2e4\uba74 \uc694\uccad\ud558\uc2ed\uc2dc\uc624. \uce90\ub9ad\ud130\ub294 \ud06c\ub9bc\uc2a8 \uc791\ud488\ubcf4\ub2e4 \ucfe0\ub85c\ubc14 \ubbf8\uce20\ub85c \uc2dc\ucd94\uc5d0\uc774\uc158\uc740 \ubc1c \ucf55\uc2dc\uce04\ub97c \ubd80\ud0c1\ud569\ub2c8\ub2e4 \uc0c1\uc138\u30fb\ud480 \uceec\ub7ec\ub85c \ubd80\ud0c1\ud569\ub2c8\ub2e4\u30fb\ucfe0\ub85c\ubc14 \ubbf8\uce20\uc758 \uc678\ubaa8\ub294 \ud1b5\uc0c1 \uc758\uc0c1\ubd84(\uac78 \ubcf5\uc7a5)\uc73c\ub85c \ubd80\ud0c1\ud569\ub2c8\ub2e4 \ubc14 \ub300\uc0ac\ub3c4 \ubd80\ud0c1\ud569\ub2c8\ub2e4. \uc5b4\ub808\uc778\uc9c0 \ud574 \uc8fc\uc154\ub3c4 \uc0c1\uad00 \uc5c6\uc2b5\ub2c8\ub2e4 \u00b7 \uc124\uc815\uc740 \ud06c\ub9bc\uc2a8 \uac78\uc988 2\ub85c \ubbf8\uce20\uac00 \uc0bd\uc785 \uc9c1\uc804\uc758 \uacf3, \ub3c4\uc6b8 \uc218 \uc788\uace0, \uadf8\ub300\ub85c \uac1c\uc778\uc2e4\uc5d0\uc11c\ub77c\uace0 \ud558\ub294 \uc774\ubbf8\uc9c0\uc785\ub2c8\ub2e4 \u2460\uae30\ubcf8 \uad6c\ub3c4\ub294 \uc0c1\ub300\ub97c \ub0b4\ub824\ub2e4 \ubcf4\ub294 \ub290\ub08c\uc73c\ub85c \ud45c\uc815\uc740 \ub2f9\ud669\ud558\uace0 \uc788\ub294 \ub290\ub08c , \ub2e4\ub9ac \ucf54\ud0a4\ud558\uace0\uc788\ub294 \ubd84\uc758 \ub2e4\ub9ac (\ud55c\ucabd \ub2e4\ub9ac)\ub294 \uc0dd\uc871\uc73c\ub85c. \ub2e4\ub9ac\ub294 \ub540\uc73c\ub85c \ucc10\ub2e4. \u300c\ub3c4\uc6c0 \ubc1b\uc558\ub2e4\uace0\ub294 \ud574\ub3c4 \uc774\ub7f0 \uc77c\uc744 \uc2dc\ud0a8\ub2e4\ub2c8\u30fb\u30fb\u300d \u2461 \uacf5\uaca9\ud558\ub294 \uac83\uc5d0 \ucf8c\uac10\uc744 \uae30\uc5b5\ud574 \uac00, \ubbf8\uce20\uc758 \uc9c8\ubd80\ub85c\ubd80\ud130\ub294 \uc560\uc561\uc774 \uac00\ub4dd \ub204\ucd9c\ud558\uace0 \uc788\ub294, \uc7a5\uc5ed \uc0ac\uc815. \ud45c\uc815\uc740 \ub180\ub9ac\ub294 \ub290\ub08c\uc758 S \uae30\ubd84 \uc788\ub294 \ud45c\uc815\uc73c\ub85c \"\uc774\ub7f0 \uac83\uc774 \uc88b\ub2e4\ub2c8 \ub108\ub294 \uc9c4\uc9dc \ubcc0\ud0dc\ub124! \ucc9c\uacfc \uac19\uc740 \uc758\uc0c1 \ucc28\ubd84, \uc5ec\uac04\ubd80\ud48d \uc758\uc0c1 \ucc28\ubd84\ub3c4 \uac00\ub2a5\ud558\uba74 \ubd80\ud0c1\ud569\ub2c8\ub2e4.\n\nhttps://drive.google.com/drive/folders/1fBeoCvhXs7AmM5V3e7Udy74r9ZQzQV60?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ww04045/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5dfbaf1b/uploads/origins/c6c9b5ba-2a91-46eb-a6f6-6b8826548916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3327c9a81a5fc9714c4833ea3adf67a", "srcset": "https://si.imgix.net/5dfbaf1b/uploads/origins/c6c9b5ba-2a91-46eb-a6f6-6b8826548916?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a3327c9a81a5fc9714c4833ea3adf67a, https://si.imgix.net/5dfbaf1b/uploads/origins/c6c9b5ba-2a91-46eb-a6f6-6b8826548916?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=930463a859394893eb43bd1290cd