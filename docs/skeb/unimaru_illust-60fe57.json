067\u3046\u306b\u3002\u69d8\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u62dd\u898b\u3057\u3001\u69d8\u3005\u306a\u8272\u3067\u5857\u308a\u8fbc\u307e\u308c\u3066\u3066\u3001\u8276\u611f\u304c\u3042\u308a\u76ee\u304c\u60f9\u304b\u308c\u308b\u30a4\u30e9\u30b9\u30c8\u304c\u80f8\u306b\u523a\u3055\u3063\u305f\u305f\u3081\u662f\u975e\u30a4\u30e9\u30b9\u30c8\u3092\u3054\u4f9d\u983c\u3055\u305b\u3066\u9802\u304d\u305f\u304f\u30ea\u30af\u30a8\u30b9\u30c8\u304a\u9001\u308a\u3055\u305b\u3066\u9802\u304d\u307e\u3057\u305f\uff01\uff01\n\n\u3010\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u3011\n\u540d\u524d\uff1aROCO.\n\u6027\u5225\uff1a\u5973\u6027\n\u5916\u898b\u5e74\u9f62\uff1a20\u4ee3\u524d\u534a\n\u8eab\u9577/\u4f53\u91cd\uff1a158cm/\u7de0\u307e\u308b\u3068\u3053\u308d\u306f\u7de0\u307e\u3063\u3066\u308b\u7a0b\u3088\u3044\u8089\u4ed8\u304d\n\u9aea\u8272/\u77b3\u8272\uff1a\u30d4\u30f3\u30af\u30d7\u30e9\u30c1\u30ca/\u4eba\u7269\u7684\u306b\u5de6:\u6c34\u8272\u3001\u53f3:\u30d4\u30f3\u30af\n\u5099\u8003\uff1a\u4eba\u7269\u7684\u306b\u5de6\u982c\u306b2\u70b9\u9ed2\u5b50\u3001\u53f3\u80f8\u306b1\u70b9\u9ed2\u5b50\nFA\u30bf\u30b0\uff1a#roconat\n\n\u3010\u30a4\u30e9\u30b9\u30c8\u5185\u5bb9\u3011\n\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u3082\u306e\uff1a(\u4e0a\u8a18\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u8cc7\u6599\u53c2\u7167)\n\u30fb\u69cb\u56f3\u3001\u8863\u88c5\u3001\u80cc\u666f\u306a\u3069\u306f\u304a\u307e\u304b\u305b\u3067\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\u3002\n\u3000\u5929\u4f7f\u306a\u306e\u3067\u3001\u4ed6\u30c7\u30b6\u30a4\u30f3\u3067\u306f\u8f2a\u3063\u304b\u306a\u3057\u306e\u5929\u4f7f\u306e\u7fbd\u3042\u308a\u30d0\u30fc\u30b8\u30e7\u30f3\u3082\u3042\u308a\u307e\u3059\u304c\u3001\u3042\u3063\u3066\u3082\u306a\u304f\u3066\u3082\u3069\u3061\u3089\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\uff01\n\u3000\u3046\u306b\u3002\u69d8\u306e\u63cf\u304b\u308c\u308b\u820c\u304c\u597d\u304d\u306a\u306e\u3067\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\uff01\n\u305f\