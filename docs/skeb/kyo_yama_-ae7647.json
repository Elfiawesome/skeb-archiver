i06/h?rlkey=rjbxb6uxyebeknm1nqmf7c1c6&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hosoba_haguma/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 576560, "client_id": 2691122, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dc502fcd343db66682423c256801694", "srcset": "https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dc502fcd343db66682423c256801694, https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1f81dd0cd6b987fd3959fcb18a76d6f 2x, https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=468a2826bb4d33a5fb26cb0ecba6dda4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf97f3c13336d1f527055b61155789f", "srcset": "https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf97f3c13336d1f527055b61155789f, https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97a5ec48e6340812a6ba5c8e2cc268f0 2x, https://si.imgix.net/539a895a/uploads/origins/14665fee-98be-49be-9b6d-5a2de637554e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe421b6705ab7faae5ddf4c7754096ac 3x"}, "body": "細葉白熊様、はじめまして。京山と申します。\n以前細葉様の作品を拝見し広がる色彩に一目惚れして以来、いつかイラストをお願いしたいと考えておりました。\nさて、今回は「架空の舞台作品の公演ポスター」という想定でのイラストをお願いしたく本文を綴っております。以下に詳細を記しますので、ご検討いただければ幸いです。\n\n■リクエスト内容\n架空の舞台作品の公演ポスター(縦型)を想定とした一枚絵\n必ずしもポスターの規格(A版、B版等)に沿っていなくても構いません。また、文字入れ等は不要ですがご随意に。\n\n■構図イメージ等\nあたたかく柔らかな色彩と一人の少年(少女)を含むイラストをイメージしていますが、具体的な指定はありません。こちらのイメージに関してもこの限りではなく、細葉様の感性にお任せできればと思います。\n\n■舞台作品詳細\n題名…ネモ\n「──きっとおとなになれば忘れてしまう。\n柔らかくて、ふしぎで、ちょっぴり寂しいぼくらのこと。」\n対象…子供から大人まで\n題名は“誰でもない”を意味する“nemo”から。\n魔法めいた時間も、簡単に消えてしまう儚さも、ぼくらの不確かさも、それでいて幻想などではないことも──あらゆる意味で“夢みたい”なストーリー。軽やかで可愛らしい絵本のような、一欠片の寂しさを綿あめで包んだ優しい演目。\n演目の主題は「貴方が貴方であること」の肯定。誰しもが「誰でもない」で「誰か」にはなれない寂しさを有していながら、「誰か」ではない「貴方」をただ認める柔らかさを謳っている。観る者は「誰でもない貴方」を愛せるようになるだろう。\n\n■用途\n個人鑑賞用、お名前を記載した上でのSNSへの公開\n※ポスター用にレイアウトする上での拡大切り抜きや文字入れ等の加工が発生する場合がございますが、イラスト自体に加筆等の変更は行いません。\n※あくまで架空の作品であり実際にポスターとして使用及び収益化に利用されることはありません。\n\n■その他\n感情が色彩に溢れるような細葉様の作風が、柔らかく優しくもどこか儚く不思議な空気感にぴったりだと感じております。かなりふんわりとしたリクエストではございますが、細葉様の感じたままに仕上げていただければ幸いです。\n\nどうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tsu2mi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 160728, "client_id": 2691122, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cd20b08/uploads/origins/81fb424b-0510-41d2-adb6-0c8a80bddafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5d4c47500dae0410dab8e6eabcb77f", "srcset": "https://si.imgix.net/8cd20b08/uploads/origins/81fb424b-0510-41d2-adb6-0c8a80bddafc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c5d4c47500dae0410dab8e6eabcb77f, https://si.imgix.net/8cd20b08/uploads/origins/81fb424b-0510-41d2-adb6-0c8a80bddafc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61ef3c2d9841c230b353db86ac604c30 2x, https://si.imgix.net/8cd20b08/uploads/origins/81fb424b-