発揮し、怯えることはほとんどない。 \n兄のことを「お兄さま」と呼び、深い愛情を抱いている。\n\n男性、27歲、身長172cm。\nいつも闇深い笑顔を浮かべており、何を考えているのか掴みどころのない人物。\n普通の人間だが、作家としてアイデアを探す方法が少しずれており、国語の高校教師も兼ねている。\n様々な感情を持つ人類を愛し、そして妹を溺愛している。\n妹が災難に遭う時、邪神と交換条件を結び、自分の身体を差し出して妹を救う。\n嫌なことに遭遇すると、遠回しに言葉の中で不満を表す。\n\n【使用用途】\nSNSでの投稿、個人の所蔵用、友人への共有\n\n【内容】\n構図等全てお任せいたします。\n\n描きたくなければお断りしても構いません。\nもし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。\n\n長文となってしまい申し訳ございません！ご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/15DXhgJHCnaKhg7xUNBLZiPxAL17zcu8t?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kojac_mm/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3544736, "client_id": 3249786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7872884b/uploads/origins/b8450a0e-a2f6-47fb-9f29-9f86b3dd4d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca160fb91e5e511f8ad2dd59553c5cb", "srcset": "https://si.imgix.net/7872884b/uploads/origins/b8450a0e-a2f6-47fb-9f29-9f86b3dd4d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eca160fb91e5e511f8ad2dd59553c5cb, https://si.imgix.net/7872884b/uploads/origins/b8450a0e-a2f6-47fb-9f29-9f86b3dd4d04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=057bac30c26bc2803fb176d387332bf1 2x, https://si.imgix.net/7872884b/uploads/origins/b8450a0e-a2f6-47fb-9f29-9f86b3dd4d04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99c4f08fa187674b83c0fd42b3d35218 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7872884b/uploads/origins/b8450a0e-a2f6-47fb-9f29-9f86b3dd4d04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07d6936fb750fb233d05d4b50d8936d3", "srcset": "https://si.imgix.net/7872884b/uploads/origins/b8450a0e-a2f6-47fb-9f29-9f86b3dd4d04?bg=%23fff&