e395a6ea6bd6e1325ac870268fb28 2x, https://si.imgix.net/3e0de5bd/uploads/origins/83f2d61d-596e-4aae-bc49-a652ad891f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c04975444030d0d6759e4a9c7578eeaf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e0de5bd/uploads/origins/83f2d61d-596e-4aae-bc49-a652ad891f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d345a7b1a84d65e478fa56f195da6eff", "srcset": "https://si.imgix.net/3e0de5bd/uploads/origins/83f2d61d-596e-4aae-bc49-a652ad891f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d345a7b1a84d65e478fa56f195da6eff, https://si.imgix.net/3e0de5bd/uploads/origins/83f2d61d-596e-4aae-bc49-a652ad891f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25f515ed6f6791b90bdc350b5345b710 2x, https://si.imgix.net/3e0de5bd/uploads/origins/83f2d61d-596e-4aae-bc49-a652ad891f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ee390d108104202e0e6667762839e4c 3x"}, "body": "こんにちは、あなたのドラゴンは素晴らしいです！私のキャラクターを描いていただければ幸いです。\nこの作品をパソコンの背景画に使いたいので、16:9に設定してください。\nキャラクターはクリスタルドラゴンで、その角と背中の棘は青色の水晶で、他の部分は鱗です。\n空中を飛ぶその姿を描いていただきたいです、背景は水晶のある洞窟。その他は自由です！\nあなたのスタイルで自由に描いてください！\n\nhttps://drive.google.com/drive/folders/1DDP5jJDc4rD8k3RHvUHPGGVb09DFARZG?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usui_togu_1228/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2615945, "client_id": 584710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53c05025b7bde24fa31483e0a5dbf9b", "srcset": "https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53c05025b7bde24fa31483e0a5dbf9b, https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=50809a3c32b613e6bc42c0218582a640 2x, https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3619dfcb33d5a0ac2072fb75fef2c749 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0812b4478744370b864cfd96f2004a40", "srcset": "https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0812b4478744370b864cfd96f2004a40, https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df4a4e6a2fdc15ab99636a7b19137fe2 2x, https://si.imgix.net/292cabd5/uploads/origins/9d0c3d71-ef18-43d8-889f-e1458f8b48c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=04994b0cf6b4d02879cbdff7c9eef09c 3x"}, "body": "いつも大変魅力的なドラゴンたちを描いた作品を拝見させて頂いております！\n今回はぜひうちの子を手掛けて頂きたくて、リクエストをお送りさせて頂きました。\n良ければうちの子の姿と、その差分の姿とを手掛けて頂けませんか？\n\nお願いしたい子は、エリクシルという名前の白竜になります。\n頭から後ろ脚まで30mくらいになる大柄めなドラゴンで、性格は大人のお姉さん系ながら、話してみると意外と気さくで面倒見の良い一面もあったりする子です。\n魔法全般、特に自然を司る強い力を持っている子です。\n\n今回は、このドラゴンのすらりとした優美な姿をぜひ羽翠とぐ様のスタイルで手掛けて頂けますと嬉しく思います！\n構図やポーズなどはお任せでお願い出来ませんか？\n\nまたお願いしたい差分の内容なのですが、この子の普段はシュッとしたお腹周りを、たっぷりの魔力を吸収して丸々と大きく膨らましている様子の姿を手掛けて頂けないでしょうか。\n普段は細身の竜なのに膨らむととっても大きくなるというギャップが大好物でして、ぜひお願い出来ますと大変嬉しく思います。\n\nぜひご検討をよろしくお願いいたします。\n\nご参考\nベース\nhttps://x