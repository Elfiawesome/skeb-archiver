用は行いません。 \n\n以上が依頼内容となります。 衣装は細かい部分適宜省略していただいて構いません。\n構図もお任せいたします。\n金額や記載内容に不備等ございましたらお手数おかけいたしますが再送など行っていただければと思います。 \nそれでは何卒ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11wtlAdFRh0mgjKRfcs546qHnXH0asmyJ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kxxxta/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3565668, "client_id": 3240810, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f6d16c5/uploads/origins/22b1cacb-1d38-4f62-9df6-da7c98063637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2acd6aaaedf02f7414005132484133d3", "srcset": "https://si.imgix.net/4f6d16c5/uploads/origins/22b1cacb-1d38-4f62-9df6-da7c98063637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2acd6aaaedf02f7414005132484133d3, https://si.imgix.net/4f6d16c5/uploads/origins/22b1cacb-1d38-4f62-9df6-da7c98063637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b06e87907cf755c4318d12576528c2ee 2x, https://si.imgix.net/4f6d16c5/uploads/origins/22b1cacb-1d38-4f62-9df6-da7c98063637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23ce645881b954755f848331d8879a0e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f6d16c5/uploads/origins/22b1cacb-1d38-4f62-9df6-da7c98063637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b4858bf62f63e4cb95a9a57ba558ae", "srcset": "https://si.imgix.net/4f6d16c5/uploads/origins/22b1cacb-1d38-4f62-9df6-da7c98063637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6b4858bf62f63e4cb95a9a57ba558ae, https://si.imgix.net/4f6d16c5/uploads/origins/22b1cacb-1d38-4f62-9df6-da7c98063637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03503