ix.net/635aa376/uploads/origins/76568b8e-dc2f-4376-86cf-145919090a25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d1e91265e939afade31f8b21528b70e 2x, https://si.imgix.net/635aa376/uploads/origins/76568b8e-dc2f-4376-86cf-145919090a25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32cb1370a9471dfa832305584ebf9c77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/635aa376/uploads/origins/76568b8e-dc2f-4376-86cf-145919090a25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baa470d908c183cb32f889820d9e9ebc", "srcset": "https://si.imgix.net/635aa376/uploads/origins/76568b8e-dc2f-4376-86cf-145919090a25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baa470d908c183cb32f889820d9e9ebc, https://si.imgix.net/635aa376/uploads/origins/76568b8e-dc2f-4376-86cf-145919090a25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=149523627f22ee804a2623a5c243566d 2x, https://si.imgix.net/635aa376/uploads/origins/76568b8e-dc2f-4376-86cf-145919090a25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bdb280ff475e93990a836376b78c4d2e 3x"}, "body": "るどな様\n\nはじめまして。さやかと申します。\n嗜好のそそられるイラストを拝見し、良ければ私のオリジナルキャラクターで同様のイラストを描いて頂きたく、リクエストをお送りさせて頂きます。もしよろしければ、受けて頂けますと嬉しいです！\n\nキャラクタ：紗香(アサルトリリィのオリジナルキャラクター)\n容姿・衣装 : 資料URL先を参照ください。\n               　　 ※一番左の立ち絵(衣装は脱がさないでください。)\n\nイラストの内容 :以前お描きになられていた、曙が底なし沼に嵌っていくイラスト( https://skeb.jp/@mildnate0429/works/7)のように、うちの子が底無し沼に足を踏み入れて沈んでく様子を描いて頂きたいです。\n\nただ、４枚目のイラストは内容を変更頂き、沼から脱出し、横に立っている状態(靴や衣装、髪が泥だらけ、全身が見える構図)で描いて頂きたいです。\n\n以上、要望が多くなり、お手数をお掛けしますが、ご検討の程、宜しくお願い致します。\n\nなお、依頼金額につきましては任意で増額致しましたが不足する場合は再送申請を頂けますと幸いです。\n\nhttps://drive.google.com/file/d/17vNXoes-QQVhqleMXSUPOSzUFbGisVY7/view?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": t