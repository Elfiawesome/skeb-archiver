%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c185560d084290c29784446a2cad0fd, https://si.imgix.net/afff663b/uploads/origins/9e533c87-4dd0-4182-ab4f-2333cecef588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=253a4bcba3a33aee8d9572497eeb0580 2x, https://si.imgix.net/afff663b/uploads/origins/9e533c87-4dd0-4182-ab4f-2333cecef588?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99ce980b7371f1eb41c5a078a22fa3b9 3x"}, "body": "はじめまして。前の粘着拘束のリクエストが素晴らしかったので依頼させていただきます！\n状況はファイアーエムブレム ifのカムイ♀がダンジョンの粘着床トラップを踏んで両足の裏をネバネバが纏わりついて離れない、武器が床にくっつく、ネバネバから足を引き剥がそうと必死な姿をお願い致します、ありがとうございます。\n衣装はデフォルトのもの、すべて着衣のままをお願いします。\n可能であればこのリクエスト(https://skeb.jp/@mamemochi1226/works/8)のようにいくつか小さいコマでネバネバに足が引っかかるの描写欲しいです。\n癖が強いのリクエストで申し訳ないですが、ご検討頂けると幸いです。よろしくお願いします！\n\n◯参考 \nカムイ♀ \nhttps://imgur.com/a/N7FuLUT\nカムイの足装備の参考 \nhttps://www.pixiv.net/artworks/95167622", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mildnate0429/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 266184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bfb3cce4e59a3a86afadda839f8586b", "srcset": "https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bfb3cce4e59a3a86afadda839f8586b, https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a30b7fe702d418038130ba6e914f03f2 2x, https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c9e41c6fb0e18704ae63f998e0dd4dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2480a29654f94ae162d413fc77091b1d", "srcset": "https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2480a29654f94ae162d413fc77091b1d, https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c53845ff5cbf24c0d4d84ccaec853b4e 2x, https://si.imgix.net/961a358d/uploads/origins/fbd92b1b-ac1a-41f3-a22f-be0a65df2e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b869816a1cfe472a38d3496f96e8e07e 3x"}, "body": "始めてリクエストさせていただきます。過去に納品されていらっしゃる粘着拘束のイラストが非常に魅力的で絵柄も好みだったので自分もリクエストをお願いしたいと思いました。\n\nキャラはSOUND VOLTEXより、SOUNDVOLTEX KAC2023タッチパネルイラストコンテスト最優秀賞のくれなゐに 弐閃瞬く 恋双譚の服装の恋刃と紅刃です。\nおそらくご存知だとは思いますが下記に参考リンクを貼っておきます。カードにはキャラの上半身しか描かれておらずおそらく下半身は公開されてないはずなのでそこは出来ればお任せしたいです。キャラのイメージ的に2人とも裾短めで恋刃はニーソックスで紅刃は生脚とかだと嬉しいです。\n\n内容は恋刃と紅刃が粘着液がたっぷり流し込まれたビニールプールのような場所に2人が入れられてしまい、抜け出そうともがいている状況です。\n構図としては側位のような体勢で恋刃が身体を横向きにしてネバネバに倒れてしまいその上から紅刃が抱き寄せるように身体を密着させている。紅刃の腕は恋刃の胸にネバネバでくっついており、ちょっとエッチな雰囲気でお願いします\n脚も搦めあった状態で密着した身体や脚の間、床と接している部分など様々な箇所に広くネバネバが絡みついていると嬉しいです。\n\nもし可能であるのならセリフを入れていただき、ネバネバに倒れた直後の「なによこれ...！」のような反応でもがいている状態、抜け出そうと身体に力を入れて抵抗した結果意図せず恋刃の胸を揉んでしまい、「んっ...！///」みたいな色っぽい声で反応してしまう恋刃に動揺する紅刃、その後しばらく時間が経ちもがき続けた2人がネバネバ越しに身体の擦れ合う快感とお互いの身体の温もりや顔の近さで甘い空気になり、疲れにより吐息を吐きながら色っぽく見つめ合う、のような展開でお願いしたいです。\n\n以上になります。ご検討のほどよろしくお願いします。\n\nhttps://x.com/mikaze_oto/status/1728249923471344076/photo/1", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mildnate0429/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 266184, "client_id": 328819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22a29ec6a9594b742ea358352c0f1c04", "srcset": "https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22a29ec6a9594b742ea358352c0f1c04, https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66554a6ed740c3c4da71648175c02adb 2x, https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be7c5a71c99cb77e99a9124954862d85 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bde8786309ded197efa75bbedfaab918", "srcset": "https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bde8786309ded197efa75bbedfaab918, https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=848c65f151025d313753b5c2f35649ac 2x, https://si.imgix.net/dbcc072b/uploads/origins/9763af34-11d0-4fd0-8fb8-67bd2b401c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a31ea807c39d83cc8868e029bf71590e 3x"}, "body": "初めまして。るどな様のニッチなイラストに惹かれたのでリクエストします。なお私のリクエストは粘着拘束系のイラストなので、もし専門外であればキャンセルしてくださって構いません。\n\n東方projectの奥野田美宵がピンク色のネバネバした物体（参考：https://ameblo.jp/vanguardshadow/image-12624171695-14817816154.html）を踏んで、足をhttps://www.deviantart.com/yaki0tako/art/Commission-Rosa-1099083973のように上げてネバネバを剥がそうとするも剥がれなくて「えっ!?えっ!?なにこれ!?取れない!!」と焦る→さらにネバネバが飛んできて「きゃっ!」と悲鳴を上げる→https://www.deviantart.com/yaki0tako/art/Commission-Diane-1099059549のような量のネバネバが体中にくっつき、「もうやだぁ...。」と絶望するという流れでお願いします。\n少し多めですがよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mildnate0429/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 266184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=270a402fd1d4ee456bda6075c3267a89", "srcset": "https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=270a402fd1d4ee456bda6075c3267a89, https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66cabf5a599386e24d2cd48cbb8bb354 2x, https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8aea6867cee3c7f47d6b6895946b265 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20a6e393042c81c1cc93f7c35e226ad5", "srcset": "https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20a6e393042c81c1cc93f7c35e226ad5, https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb01e5289384f0a2d84b64438ac2738 2x, https://si.imgix.net/34006d40/uploads/origins/9a6db3fc-347b-4c83-bac4-62316c77fb0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67c6ad8b1564bb1c54b8279816658ad2 3x"}, "body": "こんにちは。リクエストをさせていただきます。\n\n東方の霧雨魔理沙とアリス・マーガトロイドの着衣緊縛イラストをお願いします。\n2人ともしっかりと服を身につけている完全な着衣の状態。\n服装について、魔理沙は鈴奈庵の冬服。原作ではスカートの裾からドロワが見えていますが、今回はドロワ無しでお願いしたいです。アリスは細かい指定等はありませんが原作準拠の衣装でお願いします。\n縛り方は以前描かれたてゐと同じ様な後手高手小手縛りに胸縄、腰縄を追加したものでお願いします。上半身のみの緊縛。股縄や、下半身の縛りは無しで大丈夫です。\n2人が厳重に緊縛された状態で、並んで立っている姿を正面から捉えた構図でお願いします。\nもし、可能でしたらボールギャグの差分を付けていただけると幸いです。背景はお任せします。\n\n以上になります。ご検討の程よろしくお願いします。\n\n【縛り方参考】 https://www.pixiv.net/artworks/82866539\n\nhttps://www.pixiv.net/artworks/82866539", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mildnate0429/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 266184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa8ffd7b/uploads/origins/35b8d867-2de0-4993-991a-b9f994a86b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff90bc47bcc311c3b9ed589ce298779", "srcset": "https://si.imgix.net/aa8ffd7b/uploads/origins/35b8d867-2de0-4993-991a-b9f994a86b10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ff90bc47bcc311c3b9ed589ce298779, https://si.imgix.net/aa8ffd7b/uploads/origins/35b8d867-2de0-4993-991a-b9f994a86b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bda00d578afe9a35c1c0dfb107dc2b4 2x, https://si.imgix.net/aa8ffd7b/uploads/origins/35b8d867-2de0-4993-991a-b9f994a86b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=802d9ba3cf61f84c02f4fb6929de47bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_url