25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38de0618d9b47342965b5e0b62b9a0a5", "srcset": "https://si.imgix.net/aa62be25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38de0618d9b47342965b5e0b62b9a0a5, https://si.imgix.net/aa62be25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a97bdaf1ce0f83454a10f5d9335cc8df 2x, https://si.imgix.net/aa62be25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=458165160c37ae12326d6ca3a4f509fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa62be25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc4612dd65ddd2ae3dad13c55e1b0a0", "srcset": "https://si.imgix.net/aa62be25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc4612dd65ddd2ae3dad13c55e1b0a0, https://si.imgix.net/aa62be25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57b11942fff042f37686b8967ca530e2 2x, https://si.imgix.net/aa62be25/uploads/origins/17875287-d165-4ee6-85e9-7a55bfdfeaf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=689841aceb74e46c8d84afa21141589a 3x"}, "body": "はじめまして、アメと申します。\n今回skeb依頼受付中とのことでリクエストを送らせていただきました。大変お忙しいとは思いますがよろしければお願いいたします。\nいつものえるさん素晴らしいイラスト拝見しました。\nうちのOCの子を依頼したいと思います。\n\n彼は 人間の男の子、左に薄黄色の髪がある。左目の下に涙痣がある。性格は臆病で気が弱い。よろしければファイルにて好きな服をどうぞ自由に選びください、どっちでも構いません。構図などもどうぞ自由に描いてください。\n\nどうぞご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-F8JZ