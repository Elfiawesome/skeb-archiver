image", "creator_acceptable_same_genre": false}, {"path": "/@kyomkyom118/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3706963, "client_id": 1336233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b6091e17624c35ab0c3cae1874af70", "srcset": "https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b6091e17624c35ab0c3cae1874af70, https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ad84fff612dc384c3cc3c3f3bb6f756 2x, https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e0cfc0de14dffd2a6ff2a65d3e0e055 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ff5fb8c3a098ff4b9ecc2ff8cefda6a", "srcset": "https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ff5fb8c3a098ff4b9ecc2ff8cefda6a, https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1bfb10cea7c882eccf76953844536c5 2x, https://si.imgix.net/333383f0/uploads/origins/1b7e58ee-e52a-495c-a672-0b42360c9697?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccaa5c3297b39f3fd15c2148e79890af 3x"}, "body": "こんにちは、先生。\n\n先生の作品がとても大好きです。最近、新しいOCができました。彼女は地雷＋病弱な自傷部門で、名前はアリスです。彼女のイラストを描いてほしい。\n以下、キャラクター説明です：\n名前：アデライス/身長159.5cm\n詳細\n - ちょっと口が悪くて、表情があまりない妹です！ちょっと口数の少ない妹で、表情もあまりない！(モルーテの妹）-左目はカラーでガラス玉（詳細2）、右目は赤で下に3つの点がある（詳細1）。髪は銀白色。\n - 白いスカートを脱ぐと赤いバニーガールのジャンプスーツ。\n - 右側には、蝶が描かれた溶けた時計がある（詳細3、詳細4）。\n - 体にはたくさんの傷があり、影はウサギの形をしている。\n - デザインの全体的なコンセプトは、バニーガール＋純白＋鋭さ（ナイフとハサミ）で、おとぎ話風のモルートの美学（白＋リボンの小花＋キャンディ）と、鋭さや危険な感じを組み合わせたスタイル。 ドレスについているハサミは、状況に応じて適切に取り外すことができる。\n - 以下、アリスのバックストーリーを参照：\nアリスはフランスのモリュートの美学を舞台にしており、私の場合は『ロリータ』のドロレス、幼くして母親を亡くし、愛に欠け、愛と物質的なものを渇望し、自分を見つけるために極端な努力を続け、それでも大人になろうとする少女（13～16歳）。ウサギの魔法を信じ、\"アリス \"に変身した彼女は、おとぎ話の世界で望むものすべてに憧れる。アリスというよりハートの女王に近い。彼女を操るウサギは彼女の影に隠れている。彼女の目の色ガラス玉は妖艶さを、赤い目は欲望を表している。愛の欠如が欲望を解放し、自傷と痛みによって自分の存在を思い出させる。\nアリスは自分自身に空洞があり、夢はすべて欺瞞によって積み上げられ、家庭は貧しい少女である。彼女は物質的なものに値しない。原作のアリスにとって、どんなにたくさんの夢を見ても、深夜に孤独の中で起こされ、何度も何度も絶望感に戻り、自由になるのを待っていた。そして、自分に大きな力を与え、欲望の束縛も解くには、ハートの女王になるしかなかった。\n\n自分の絵の好みやキャラクターの理解度に合わせて、自由にプレイしてくださいと先生にお願いすればいい。\n\nご清聴ありがとうございました！\n\nhttps://imgur.com/a/Wuv7zOU", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 853932, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しちがつ", "screen_name": "sitigatu0984", "avatar_url": "https://pbs.twimg.com/profile_images/1482669903630929924/aKquSAzM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/833203785509920768/1490535895/1500x500", "appeal_receivable": false, "popular_creator_rank": 94, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 976534, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "もちポテト", "screen_name": "motiCHIKUWA", "avatar_url": "https://pbs.twimg.com/profile_images/1978090500214194176/0_2QAdY3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/806449056671088641/174179