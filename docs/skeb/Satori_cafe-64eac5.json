\u306b\u306a\u3063\u3066\u304a\u308a\u307e\u3059\u3002\u91cc\u91cc\u3068\u7533\u3057\u307e\u3059\u3002\uff08\u9375\u57a2\u627f\u8a8d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\uff01\uff09\n\n\u3044\u3064\u3082\u30d5\u30a7\u30c1\u306b\u3076\u3063\u523a\u3055\u308b\u30ef\u30f3\u30d4\u30a4\u30e9\u30b9\u30c8\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002\n\n\u30a4\u30e9\u30b9\u30c8\u3092\u521d\u3081\u30662.5\u5e74\u3068\u306a\u308a\u307e\u3057\u305f\u3002\n\u4eca\u5e74\u306b\u5165\u3063\u3066\u3084\u3063\u3068\u300c\u9811\u5f35\u308c\u305f\u304b\u306a\u300d\u300c\u524d\u3088\u308a\u5d29\u308c\u3066\u306a\u3044\u306a\u300d\u3068\u3044\u3046\u81ea\u5df1\u8a55\u4fa1\u3092\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3088\u3046\u306b\u306a\u308a\u30019\u6708\u306b\u306a\u308a\u300c\u53cb\u4eba\u306b\u3082\u30a4\u30e9\u30b9\u30c8\u304c\u3093\u3070\u3063\u3066\u308b\uff01\u3068\u898b\u305b\u3089\u308c\u308b\u304b\u306a\u300d\u3068\u601d\u3048\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3057\u305f\u3002\n\n\u971e\u7984\u3055\u3093\u304b\u3089\u30a2\u30c9\u30d0\u30a4\u30b9\u3044\u305f\u3060\u304d\u305f\u304f\u3001\u4f9d\u983c\u3044\u305f\u3057\u307e\u3057\u305f\u3002\n\u9854\u2192\u8eab\u4f53\u2192\u670d\u2192\u80cc\u666f..\u306e\u9806\u306b\u6210\u9577\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u307e\u3059\u3002\n\u30fb\u6bce\u56de\u30d5\u30a7\u30c1\u5ea6\u306e\u9ad8\u3044\u30a4\u30e9\u30b9\u30c8\u304c\u7d20\u6674\u3089\u3057\u3044\u306a\u3068\u307f\u3066\u3044\u307e\u3059\u3002\u76db\u308a\u8fbc\u3080\u30b3\u30c4\u306a\u3069\u6559\u3048\u3066\u3044\u305f\u3060\u3051\u307e\u3059\u3067\u3057\u3087\u3046\u304b\uff1f\u670d\u3068\u304b\u3082\u6bce\u56de\u300c\u3053\u306e\u30ad\u30e3\u30e9\u7740\u3066\u305d\u3046\uff5e\uff5e\u300d\u3068\u601d\u3046\u306e\u3067\u3059\u304c\u3001\u3069\u306e\u3088\u3046\u306b\u30c1\u30e7\u30a4\u30b9\u3057\u3066\u3044\u3089\u3063\u3057\u3083\u308b\u306e\u3067\u3057\u3087\u3046\u304b...?\n\u30fb\u7acb\u4f53\u7684\u306a\u5f71\u3082\u304b\u3059\u307f\u3055\u3093\u306e\u9b45\u529b\u3060\u3068\u601d\u3044\u307e\u3059\u3002\n\u3000\u79c1\u306e\u30a4\u30e9\u30b9\u30c8\u306f\u5f71\u304c\u307e\u3060\u307e\u3060\u6de1\u3044\u3067\u3059\u3002(\u52c7\u6c17\u3092\u3082\u3063\u3066\u6fc3\u304f\u3067\u304d\u306a\u3044)\n\u3000\u3069\u306e\u3088\u3046\u306b\u3057\u3066\u529b\u3092\u78e8\u304b\u308c\u305f\u306e\u3067\u3057\u3087\u3046\u304b...?\n\u30fb\u971e\u7984\u3055\u3093\u304b\u3089\u898b\u3066\u76f4\u3059\u3079\u304d\u70b9\u3092\u6559\u3048\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u30fb\u79c1\u306e\u30a4\u30e9\u30b9\u30c8\u3068\u306f\u96e2\u308c\u307e\u3059\u304c\u3001\u3053\u308c\u307e\u3067\u6210\u9577\u306e\u305f\u3081\u306b\u3088\u304b\u3063\u305f\u3082\u306e(\u672c/\u52d5\u753b/\u7fd2\u6163)\u306a\u3069\u3088\u308d\u3057\u3051\u308c\u3070\u6559\u3048\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\n\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\uff3f\n\u4ee5\u964d\u3001\u30a2\u30c9\u30d0\u30a4\u30b9\u306e\u6750\u6599\u306b\u306a\u308b\u304b\u3068\u79c1\u306e\u81ea\u5df1\u5206\u6790\u3092\u8a18\u8f09\u3057\u3066\u304a\u304d\u307e\u3059\u3002\n\u30fb\u30b0\u30ea\u30b6\u30a4\u30e6\u753b\u6cd5\u3067\u63cf\u3044\u3066\u3044\u307e\u3059\u3002\u4ee5\u4e0b\u306e\u3088\u3046\u306a\u624b\u9806\u3067\u3059\u3002\n\u3000\u30e9\u30d5\u21d2\u7dda\u753b\u21d2\u30e2\u30ce\u30af\u30ed\u30d9\u30bf\u5857\u308a\u21d2\uff5b\u30e2\u30ce\u30af\u30ed\u30e9\u30a4\u30c6\u30a3\u30f3\u30b0\u21d2\u30ab\u30e9\u30fc\uff5d\u7e70\u308a\u8fd4\u3057\u21d2\u4ed5\u4e0a\u3052\n\u3000\u76f4\u8fd1\u306e2B\u306e\u30a4\u30e9\u30b9\u30c8\u306f7H\u307b\u3069\u3067\u5b8c\u6210\u3057\u3066\u304a\u308a\u307e\u3059\u3002\n\u30fb\u304b\u308f\u3044\u3044\u00d7\u7f8e\u4eba\u306a\u7d75\u3092\u63cf\u304d\u305f\u3044\uff08\u53ef\u80fd\u3067\u3042\u308c\u3070\u30d5\u30a7\u30c1\u3092\u4ed8\u5c5e\u3057\u305f\u3044\uff09\u3068\u601d\u3063\u3066\u3044\u307e\u3059\u3002\n\u30fb\u9aa8\u683c\u3092\u610f\u