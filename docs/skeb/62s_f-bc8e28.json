全個人利用(SNSのアイコンやスマホの壁紙など)\n・非公開でのLINEスタンプ作成\n\n◇データについて\n\n可能であれば、背景透過にていただけますと幸いです。\n\n◇参考資料\n\nhttps://drive.google.com/drive/folders/1DHeINRNXQM-FD4vqqgCBgAFBdV-_9wkb\n\n\n金額不足、資料不備等ありましたら再送していただけたらと思います。 \nご検討のほど、よろしくお願いいたします。 \nこれからも、ちゃーいちゃんととやた様のご活動を心から応援しております。\n\nhttps://drive.google.com/drive/folders/1DHeINRNXQM-FD4vqqgCBgAFBdV-_9wkb", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1133521, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おおねむちゃ", "screen_name": "YONEZU_nemutya", "avatar_url": "https://pbs.twimg.com/profile_images/1649368132409257985/pX92knKZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/795133786103001088/1697860668/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 2609762, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "𝗞𝗮𝘁𝗮𝗯𝗮𝗺𝗶☘", "screen_name": "Coche_Katabami", "avatar_url": "https://pbs.twimg.com/profile_images/2046609873685934080/TouC9ARL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1618287128550739969/1776783519/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2673078, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Anohi", "screen_name": "anohianotok1", "avatar_url": "https://pbs.twimg.com/profile_images/2004848656709718016/czGYCPuc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1617462766889234432/1766828143/1500x500", "appeal_receivable": false, "popular_crea