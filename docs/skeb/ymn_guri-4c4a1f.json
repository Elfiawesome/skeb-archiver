d-3caa-4ecd-87f6-3a6f5fdec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca8c02146c4ce09f8e5e8b2a29d88a44", "srcset": "https://si.imgix.net/a8e06f0e/uploads/origins/79c4327d-3caa-4ecd-87f6-3a6f5fdec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca8c02146c4ce09f8e5e8b2a29d88a44, https://si.imgix.net/a8e06f0e/uploads/origins/79c4327d-3caa-4ecd-87f6-3a6f5fdec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc67e3d9a1dc3a58579818db6a5e6b55 2x, https://si.imgix.net/a8e06f0e/uploads/origins/79c4327d-3caa-4ecd-87f6-3a6f5fdec2c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d65a57f63d62c69ce1d221762d7e7784 3x"}, "body": "こんにちは、チョコロール東です。いつも創作活動お疲れ様です。\n作品を楽しみにしており、また楽しませていただいておりましたところ。\nskebをされているのを拝見して。早速ですが、リクエストをお送りさせていただきました。\n\n内容は、下記のとおりです。\n\nリクエスト内容=================================\n下記の①～③のうち描きたいものを１点、ヤマネさんの描きたいものの優先度でお願いいたします。\n\n①ヤマネさんの性癖※１・好きなもの・描きたいなと思うもの\n　ＰＬさんの許可もふまえ、ヤマネさんの好きなＰＣさんを描いていただければと存じます。\n　※１適切な言葉が見つからず、Twitterなどでよく見かけるワード「性癖」を使ってしまいました。\n\n\n②ヤマネさんのＲＰ感想漫画・イラスト\n　定期ゲームなどで遊んだ時に、こういうところ面白かったな～を、漫画やイラストで描くことが可能であれば。こちらは面白そうだなと思い。リクエストさせていただきました。\n\n\n③薩日内　敦（暗夜迷宮　作戦番号616）\n　\n　資料（暗夜迷宮のサイトに遷移します）①https://anya-meikyu.reifier.jp/characters/616\n　資料（私のサイトに遷移します）②https://chocorollhigashi.wordpress.com/atsushi/\n　薩日内　敦PLからのコメント：「薩日内敦はなんべんもおもちゃにしていいですよ。なんかいろいろぶつけてください。バッチ恋です」\n\n　Skebはご依頼前後でご依頼のやりとりができない仕様のため、ある情報だけおかせていただきましたが。\n　描きやすいようにアレンジも可能です。\n\n=================================\n\n雰囲気は不問です。以降、私の感想です。\nヤマネさんの描かれるイラストは、すっきりとしたスタイリッシュさ。描かれるキャラクターの要素に執念深さあるいは熱心があるのかな、と受け取れる魅力があるので作品を楽しみにしております。\n\n長くなり申し訳ございません。\nヤマネさんは、定期ゲームや私生活におよび、創作活動などもされていると思いますので。\nご無理のない範囲でリクエストを描いていただけますととても嬉しく思います。\n\n以上になります。何卒よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ymn_guri/works/1", "private_thumbnail_image_urls": null, "private": false, "gen