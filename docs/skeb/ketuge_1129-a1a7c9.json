r=200&s=a7a4ddc3c7ff4f14f6139253086f8122, https://si.imgix.net/1f1e46ac/requests/147466_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4dbd590664fa90f3cad8f4534df31297 2x, https://si.imgix.net/1f1e46ac/requests/147466_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5db751a95251b876c81b28b7a850bc03 3x"}, "body": "はじめまして！アラド戦記の最初期短髪プリーストが時間を停止されて本人の知らない間にモブが好き放題悪戯をしているイラストをお願いしたいです。\n\n片腕を上げられて汗臭い腋を嗅がれながら舐められたり、毛深いアナルを隅々まで舐め尽くされたり、モブの手コキで時間が止まっているのになぜか射精してしまったりしている姿をぜひ見てみたいです…！ペニスは包茎巨根で剥かれたカリには汚れが溜まっている状態だと嬉しいです。\n\nプリーストの時間は止まっているので終始キリッとした真顔のまま無反応なのですが、射精している時だけ身体がビクッと反応していたりするのもそそられます。よろしければ台詞なども付けて頂きたいです！\n\nまた、モブの表現は半透明であったり白ハゲであったりと簡易的なもので構いません。\n犬塚さんが一番描きやすい方法で描いて頂ければ幸いです。\n\n要望が多くて申し訳ありませんがもし宜しければお願い致します！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ketuge_1129/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 643512, "client_id": 117506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f9dd09dbb882706c631580ac78db40", "srcset": "https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f9dd09dbb882706c631580ac78db40, https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4ba484e6d3317e73dcde27d4a31894d 2x, https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5166177edbf353e9c7594d13e3815c58 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108fa279d3fb0773f1b93db658b6ccd2", "srcset": "https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108fa279d3fb0773f1b93db658b6ccd2, https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18bf44546b602aa8b317b84330c8258c 2x, https://si.imgix.net/0250730f/requests/147336_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3989ef22169cd322875df2b99fb2f8c 3x"}, "body": "いつも応援させていただいてます！前から犬塚さんが描いたDNFのキャラが好きで、しかもサムスピの火月君もお気に入りではないかとTwitterで拝見させていただきました。自分もDNFの格闘君、鬼剣士君、あと火月君推しですので、今回踏み切って、格闘君と火竜の一枚をお願いしようと思いました！\n正直、格闘家と覚醒後の真ストライカーでかなり迷いましたが、やっぱ最初は格闘家（服着てる方の）の方をお願いいたします！\n\nシーンの設定：火竜君との闘いに負けた格闘家君が彼の力によって屈服し、淫紋をつけられ、自ら力、スキル能力を火竜君に差し出す（自分でちんぽをしごいて、射精する）一枚をお願いいたします。\n\n格闘家君の設定：指なしの手袋？をストライカーみたいの白い包帯に変更してほしいです。ズボンをキンタマのちょっと下まで下ろす感じで、そのまま左手で自分の乳首を弄りながら、右手でしごく。気持ち良すぎて、腰をガクガクし、涎を垂らしながら、ちょっと蕩けた顔。犬塚さん、特に汗と腋に拘りがあるようで、そこをお任せします。もし可能であれば、汗のあの湯気みたいな感じも好きです！一つだけお願いしたいのが、額、二の腕の赤の鉢巻きは描いていただける嬉しいです。\n\n火竜君の設定：しゃがんで格闘家君の片方のキンタマを吸えて、目はちゃんと開けて、格闘家君の射精姿を見届けて、精液にぶっかけられて、顔と髪の毛と背中に付いてる感じでお願いいたします。\n\n淫紋の設定：火竜の赤いドラゴンの正面の顔のイメージが一番ベストですが、難しいようでしたら、お任せでお願いいたします。\n\nいろいろ難しい要望が多くて、すみません...引き受けていただけるとすごく嬉しいのですが、よろしくお願いいたします！！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ketuge_1129/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a8fde043/requests/147135_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c43824a4d4732b8a416a7c87a6b30d94", "srcset": "https://si.imgix.net/a8fde043/requests/147135_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c43824a4d4732b8a416a7c87a6b30d94, https://si.imgix.net/a8fde043