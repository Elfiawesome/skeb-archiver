d-08c3b661cb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e61afaa695e578440ea3e3095e70819, https://si.imgix.net/d651c912/uploads/origins/35ed5d55-bdf7-4cc0-afdd-08c3b661cb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c26ebf48297d31086a8550363b7eaf8 2x, https://si.imgix.net/d651c912/uploads/origins/35ed5d55-bdf7-4cc0-afdd-08c3b661cb8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd81bc0f9d81d67d240d3414c3270cf 3x"}, "body": "■依頼\n\n私と友人のオリジナルキャラクターのSDイラスト\n\n■詳細\n\n資料:https://drive.google.com/drive/folders/1PC9AWYCn5jRg4XZrSGeCfYZ_I7BRhbPf\n\n・亜音亜 音亜音(あねあ ねあね) (26) 150cm 女\nファンの「お姉ちゃん」がコンセプトの普通のアイドル。\n快活でしっかり者。公私ともに「お姉ちゃん」であろうとしており、自責思考が強い。\nしかし律との交流を経て他人に寄りかかれるようになった。\n律は音亜音にとって初めてできた信頼できる深い関係の友人であり、年下の可愛い男の子。\n\n・柊木 律(ひいらぎ りつ) (23) 190cm 男\n大人気アイドルユニット「R'」の片割れ。\n活発な性格。歌っている姿はクールなので勘違いされがち。おしゃべりが好きで人懐こい。\nこれと決めたことを曲げられない頑固な一面がある。\n音亜音は律にとって初めてできた信頼できる深い関係の友人であり、年上の頼れる女性。\n\nふたりはアイドル番組での共演で知り合い、様々な交流を経て友人となりました。\n交流の中には非現実的な事件も含まれており、そのような事件に巻き込まれながら、互いの胸の内をさらけ出し、周囲には話さないような秘密を共有しています。\n同業者であり友人であり共犯者でもある、互いに人としてリスペクトしている存在です。\n\n資料として立ち絵のほかに、スクリーンショットやコミッションでいただいたイラスト等がありますが、四肢様の裁量で適当に確認し、服装や構図等自由に描いて頂ければと思います。\n\n■用途\n\n・個人観賞用のグッズの作成\n・四肢様の名前を明記したうえでのSNSのアイコンやヘッダーへの使用\n\n金額に不足があれば再送お願い致します。\nご検討の程宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ow_neenn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3097156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4eeef35f1bdc609a87973e5dd41c1b", "srcset": "https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec4eeef35f1bdc609a87973e5dd41c1b, https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3077b7c7acf0a5c8f908683ad5eb71b 2x, https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b236d81d60db6dc578ca8460c2845938 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=197cb94855a8f4d33afeeb39852f2cf4", "srcset": "https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=197cb94855a8f4d33afeeb39852f2cf4, https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0914b690a4ace9afc5fe1ea11351416c 2x, https://si.imgix.net/051abadc/uploads/origins/be5882e4-15f8-4e29-a895-dc6264811e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08b6bdef447c214c09da73d79d0b1f64 3x"}, "body": "四肢様はじめまして。\nSkebの新着でお見かけした際、ポップかつ柔らかさや優しさも同居するカートゥーン調のデフォルメに魅了されてリクエストさせて頂きたいと思いました。\n\n私のオリキャラの少年をお願いさせて頂いても構わないでしょうか？\nhttps://drive.google.com/file/d/1zpCZ6nH-O0r8fzJuNaulzCWIm_wYTEzV/view?usp=sharing\n\n資料のイラストでは目が細めになっていますが、四肢様の他の納品イラストのように大きくパッチリと描いて頂けますと嬉しいです。\nキャラ設定としては、秀才で（ちょっと上から目線なとこもあるけど）人当たりが良く、タイムトラベルを実現させようと勉強している面があります。\n\nまた、完全個人用のアクスタ（決して売買しません）にする可能性もありますので背景透過ファイルも頂けますと助かります。\n\nそれでは以上の内容に差し支えるところなければ、よろしくお願いいたします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ow_neenn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3097156, "client_id": 408908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cb52401ae5688e4aaff5f0a37e54c49", "srcset": "https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cb52401ae5688e4aaff5f0a37e54c49, https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddd5c5a387ac67b9c737cd7540400e6d 2x, https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8edd3cdf8cef659fa28c6a63e229844a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1de38956edcec846c51219207ce30319", "srcset": "https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1de38956edcec846c51219207ce30319, https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=411961bea3c65ac017bf7e209a65696b 2x, https://si.imgix.net/cacbe74e/uploads/origins/b45065e5-6521-487e-af93-6ea2a323a005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f828293853d9e15facb1418360f6605 3x"}, "body": "こんにちは、かわいい画風ですね！私のVtuberのJammyの絵をお願いしたいです。彼女は人間になったユニバン（ユニコーンとウサギのハーフ）で、怠け者で、優しくて、甘えん坊だけど、アートと魔法の才能がとてもあるんだ。構図も含めて可愛ければどんなポーズや表情でもOKです！\n\nジャミーの特徴は、唇の上にビューティーマーク、瞳に瞳孔、一本角、頭に耳、靴なし、髪留め2つ。いつも靴下を履いている！\n\nhttps://drive.google.com/drive/folders/12JbFEQks5liM-RMdLy69qAZBZj9i1_3C?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ow_neenn/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3097156, "client_id": 2650000, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc09ddf1de380fd774c9dd4431c0c0e6", "srcset": "https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc09ddf1de380fd774c9dd4431c0c0e6, https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0be23a4c6666652fa7e467f8ddce0a41 2x, https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55a70e03deb91e47d7acb26f09d2d482 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c39762513eb02180495f9981c12c7aa", "srcset": "https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c39762513eb02180495f9981c12c7aa, https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cf43e8bd53fb32a76abc8631da07431 2x, https://si.imgix.net/c2c3ce72/uploads/origins/eb68d150-2056-4fff-97f8-6f0f00904d1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18e97811b926633b6313bc0fe1e9b259 3x"}, "body": "先生はじめまして、アイオと申します。\n私は台湾人です。文法に間違いあるかもしれませんが、ご容赦ください。\nいつも先生の素敵なイラストを見ていました\n\n【依頼内容】\n私の 2 人の OC を一緒の絵を描いていただけるとよろしいでしょうか？\nキャラ参照は下記のURLをご覧ください。\n\nアイオ：天狗+柴犬亞人。\n陽キャで健氣の天然ボケ、笑うと犬歯が見える、\n時折見せる冗談のような振る舞い\n小悪魔系+天然系\n169.5cm(犬耳は含まれない) 20歳\n人間と犬両方の耳を持っている、\nメッシュの色は気分によって色が変わる\nアイオも三途が好きだが、彼はそれを知らない\n雰囲気に流されて、ついやってしまいがちですが\n\n三途：白髪、ブラッドレッドの瞳（暗いところで光る）\nギザ歯、基本的な表情は冷たく、悪そうに見える\nアイオが子供の頃から一緒にいるお兄ちゃんだ。\nアイオは10歳かそこらで彼の元を去り、別の場所に行ったが、やがて2人は再会した。\n彼はまた、アイオのことを世界で一番大切な人だと思っている、そして、彼がとても好きだ。\nいつもアイオを大切にしている，その場の雰囲気に流されて衝動的に行動してしまうのを防ぐためだ。\n\n服装や髪型をアレンジしていただいて問題ありません。\n細かい設定についてはお好みで調整して構いません。\n依頼内容になにか問題があれば再送要請してください。\n\n【使用用途】\n自分用の壁紙とアイコン、個人用な印刷などの使用\n他の方への依頼の際に資料として使用させていただくことがあります。\nSNS、ネットで公開する時には、先生を注記してから投稿します。\nできれば人物の透過やサインなどは別レイヤーに分けていただけると助かります。\n\nここまでお読み、私のリクエストを考慮していただければ幸いです、本当にありがとうございます。\n\nhttps://drive.google.com/drive/folders/1OiDHYdtJmO_jUXzeO889YhrjNnYbn0N0?usp=sharing\n\nhttps://drive.google.com/drive/folders/1OiDHYdtJmO_jUXzeO889YhrjNnYbn0N0?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ow_neenn/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3097156, "client_id": 192866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c2d80e7/uploads/origins/4a45f043-a0de-4c25-80d6-e3456006b17f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b167d6fb3cf10f676195f3318cab7a", "srcset": "https://si.imgix.net/4c2d80e7/uploads/origins/4a45f043-a0de-4c25-80d6-e3456006b17f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b167d6fb3cf10f676195f3318cab7a, https://si.imgix.net/4c2d80e7/uploads/origins/4a45f043-a0de-4c25-80d6-e3456006b17f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df43a076ed6d1a4c