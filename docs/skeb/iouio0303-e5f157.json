68\u9060\u304f\u306e\u30b9\u30fc\u30d1\u30fc\u306b\u4e00\u7dd2\u306b\u304a\u8cb7\u3044\u7269\n\u76f8\u624b\u5f79\u2192\u540c\u50da\u7537\u306e\u5b50\u3002\u90fd\u4f1a\u306b\u99b4\u67d3\u3081\u3066\u3044\u306a\u3044\n\u3044\u304a\u3055\u3093\u306e\u5f79\u2192\u540c\u50da\u5973\u306e\u5b50\u3002\u660e\u308b\u3044\u6027\u683c\u3002\u306a\u304a\u7530\u820e\u51fa\u8eab\u3002\u307e\u3060\u7537\u306e\u5b50\u3088\u308a\u306f\u99b4\u67d3\u3081\u3066\u3044\u308b\n\n\n\u8a73\u7d30\u3068\u6d41\u308c\n\u203b\u300e\u300f\u2190\u3067\u5f37\u8abf\u3057\u305f\u6587\u7ae0\u306f\u51fa\u6765\u308b\u3060\u3051\u5c0e\u5165\u3057\u3066\u307b\u3057\u3044\u3082\u306e\u3067\u3059\u3002\u4f1a\u8a71\u306e\u9577\u3055\u3084\u305d\u306e\u5f8c\u306e\u4f1a\u8a71\u306e\u5e83\u3052\u65b9\u306b\u95a2\u3057\u3066\u306f\u7279\u306b\u6307\u5b9a\u3057\u307e\u305b\u3093\n\n\n\u30fb\u51fa\u767a\u524d\u3002\u3044\u3044\u5929\u6c17\u306a\u3053\u3068\u3092\u304a\u8a71\u3057\u3057\u306a\u304c\u3089\u7384\u95a2\u3067\u6e96\u5099\n\u300e\u540c\u3058\u5bb6\u3060\u3068\u3054\u3081\u30fc\u3093\u3001\u5f85\u3063\u305f\u30fc\uff1f\uff1f\u304c\u51fa\u6765\u306a\u3044\u306d\u300f\u2192\u5973\u306e\u5b50\u304c\u3059\u3063\u3054\u3044\u5bdd\u574a\u3057\u3066\u7537\u306e\u5b50\u306f\u3081\u3063\u3061\u3083\u5f85\u3063\u3066\u305f\u3063\u3066\u3053\u3068\u3092\u7a81\u3063\u8fbc\u307e\u308c\u308b\n\n\u30fb\u99c5\u307e\u3067\u5230\u7740\u3002\u90fd\u4f1a\u306e\u99c5\u306e\u5e83\u3055\u306b\u56f0\u60d1\u3059\u308b\u7537\u306e\u5b50\u3002\n\u300e\u3088\u30fc\u3057\u3001\u3060\u3063\u305f\u3089\u3053\u306e\u30b7\u30c6\u30a3\u30ac\u30fc\u30eb\u306e\u304a\u59c9\u3055\u3093\u304c\u624b\u3092\u7e4b\u3044\u3067\u3042\u3052\u3088\u3046\uff01\uff01\u3053\u308c\u3067\u8ff7\u5b50\u306b\u306a\u3089\u306a\u3044\u3088\u306d\uff1f\u300f\n\u2192\u7167\u308c\u308b\u7537\u306e\u5b50\u3092\u304b\u3089\u304b\u3046\u2192\u5973\u306e\u5b50\u3001\u3082\u306e\u3059\u3054\u304f\u8155\u3092\u3076\u3093\u3076\u3093\u632f\u308b\u304b\u3089\u624b\u3092\u96e2\u3055\u308c\u308b\n\n\u30fb\u30b9\u30fc\u30d1\u30fc\u5230\u7740\u3002\u30ab\u30ec\u30fc\u306e\u5177\u6750\u3092\u8cfc\u5165\u3059\u308b\u304c\u3001\u5973\u306e\u5b50\u3001\u5177\u6750\u306e\u9593\u306b\u828b\u88fd\u54c1\u306e\u304a\u83d3\u5b50\u3082\u3057\u308c\u3063\u3068\u53d6\u3063\u3066\u3044\u308b\u3002\u5f8c\u534a\u306f\u304a\u83d3\u5b50\u30aa\u30f3\u30ea\u30fc\u306b\u306a\u308a\u3001\u6700\u5f8c\u306f\u9042\u306b\u30ab\u30ec\u30fc\u306e\u5177\u6750\u3092\u623b\u3057\u3066\u3057\u307e\u3046\u3002\u4e2d\u76e4\u306b\u306a\u308b\u306b\u3064\u308c\u65e9\u53e3\u3067\u3002\n\u4f8b:\u306b\u3093\u3058\u3093\u3001\u305f\u307e\u306d\u304e\u3001\u30dd\u30c6\u30c8\u30c1\u30c3\u30d7\u30b9\u3001\u30ab\u30ec\u30fc\u30eb\u30fc\u3001\u3058\u3083\u304c\u3044\u3082\u3001\u3058\u3083\u304c\u308a\u3053\u3001\u304a\u306b\u304f(\u8d85\u9ad8\u3044\u30b5\u30fc\u30ed\u30a4\u30f3)\u3001\u30aa\u30fc\u30b6\u30c3\u30af\u3001\u30b8\u30e3\u30ac\u30d3\u30fc\u3001\u5805\u3042\u3052\u30dd\u30c6\u30c8\u3001\u6700\u5f8c\u306b\u3042\u308c\u3084\u3053\u308c\u3084\u91ce\u83dc\u3092\u623b\u3057\u3066\u7d42\u4e86\n\u2192\u30c9\u30e4\u9854\u3067\u8cb7\u3044\u7269\u5b8c\u4e86\u3092\u544a\u3052\u308b\n\u300e\u5168\u90e8\u3058\u3083\u304c\u3044\u3082\u307f\u305f\u3044\u306a\u3082\u3093\u3060\u304b\u3089\u5b9f\u8cea\u30ab\u30ec\u30fc\u306e\u5177\u6750\uff01\uff01\uff01\u300f\n\n\n\u30fb\u6539\u3081\u3066\u666e\u901a\u306b\u30ab\u30ec\u30fc\u306e\u5177\u6750\u306e\u8cfc\u5165\u3092\u958b\u59cb\u3002\u7537\u306e\u5b50\u3001\u5973\u306e\u5b50\u306e\u4e8b\u3082\u542b\u3081\u30eb\u30fc\u30e0\u30e1\u30a4\u30c8\u306e\u597d\u304d\u5acc\u3044\u3092\u628a\u63e1\u3057\u3066\u3066\u3061\u3087\u3063\u3068\u30c9\u30ad\u30c3\u3068\u3059\u308b\n\u300e\u79c1\u306e\u3053\u3068\u3001\u3059\u3063\u3054\u3044\u898b\u3066\u304f\u308c\u3066\u308b\u3093\u3060\u306d\u30fb\u30fb\u30fb\u300f\u2192\u898b\u3066\u306a\u3044\u3068\u5371\u306a\u3063\u304b\u3057\u3044\u304b\u3089\u3068\u7a81\u3063\u8fbc\u307e\u308c\u3076\u30fc\u305f\