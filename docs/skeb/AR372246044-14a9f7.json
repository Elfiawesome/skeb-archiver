g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb52b0e0e4f486ab755d8a5e8462498c, https://si.imgix.net/13c87fb8/uploads/origins/7cad1367-5f84-42b7-a11c-712d17b63dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e1b884e5008cdef7f21261fce8f54a3 2x, https://si.imgix.net/13c87fb8/uploads/origins/7cad1367-5f84-42b7-a11c-712d17b63dd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d20cb0e1b4e6856a0dbdf29fcde1cc1 3x"}, "body": "ボテ腹の信濃ママ(アズールレーン)がショタ達と乱交してるイラストお願いいたします。\n体位は松葉崩し\n信濃垂れ長乳でデカ巨乳輪，おっぱいの血管が浮き出る\n乳輪が大きいほど良い,一番下品な乳輪が見たい陥没乳首からは母乳が溢れている状態 \n\nありがとうございました\n\n参考URL\nhttps://www.pixiv.net/artworks/95594222\nhttps://www.pixiv.net/artworks/92126436", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AR372246044/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 956129, "client_id": 158139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0edc738c3ae958e816ef822a85dd004f", "srcset": "https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0edc738c3ae958e816ef822a85dd004f, https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ab7536707fbbd80daec2f675e6c8d34 2x, https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7a3703e341774903ce57cd5918bc91f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d81947da0f9ecaee0c482c8b59f16709", "srcset": "https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d81947da0f9ecaee0c482c8b59f16709, https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbe2be69c0187cc71130d74bb9e2351 2x, https://si.imgix.net/dcdb57aa/uploads/origins/5df88de2-f13d-4962-84a2-9670cccebf3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2376ca3460e7c2bfc1a2309a6019e66 3x"}, "body": "初めまして。\n先生の描かれる絵柄が好みであったためリクエスト失礼します。\n\nグランブルーファンタジーのダヌアを描いていただきたいです。\nシチュエーションですが、以前ポストされていたこちら(https://twitter.com/AR372246044/status/1720204121536708971)のベルファストのように精液便所にされているイラストをお願いします。\n\n下記の要素や差分をお願いします。\n・上記のポストのように体液にまみれている\n・大人の玩具を両穴に突っ込まれている\n・↑が抜かれて、両穴から精液が溢れだしている\n・身体中に落書きをされている\n・ボテ腹になっている状態となっていない状態\n\n以上、ご検討のほどよろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AR372246044/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b3dc5ced/uploads/origins/2219ad93-42ca-42df-bbff-5a8bdeabca5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52fce28ac321424558cfa932c948d902", "srcset": "https://si.imgix.net/b3dc5ced/uploads/origins/2219ad93-42ca-42df-bbff-5a8bdeabca5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52fce28ac321424558cfa932c948d902, https://si.imgix.net/b3dc5ced/uploads/origins/2219ad93-42ca-42df-bbff-5a8bdeabca5b?bg=%23fff&auto=format%2Ccompress&f