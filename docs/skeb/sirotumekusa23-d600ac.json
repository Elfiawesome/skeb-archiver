b9\u306f\u5f41\u6765(\uff76\uff72\uff97\uff72)\u81ea\u9663\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u601d\u3044\u307e\u3059\u3002\n\u7acb\u3061\u7d75\u306a\u3069\u306e\u8cc7\u6599\u306f\u30b0\u30fc\u30b0\u30eb\u30c9\u30e9\u30a4\u30d6\u306b\u3066\u63d0\u51fa\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u6027\u683c\u306a\u3069\u306e\u60c5\u5831\u306f\u4ee5\u4e0b\u306b\u8a18\u8f09\u3057\u307e\u3059\u3002\n\nHO1\uff1a\u548c\u9054 \u672a\u6765(\u308f\u3060\u3061 \u307f\u3089\u3044)\n22\u6b73/175cm\u304f\u3089\u3044/\u7537\u6027\n\u7a4f\u3084\u304b\u306b\u751f\u6d3b\u3057\u305f\u304f\u3001\u4eba\u304c\u5927\u5207\n\u3057\u3063\u304b\u308a\u8005\n\u30c8\u30ed\u30c3\u30b3\u554f\u984c\u306b\u3044\u3064\u307e\u3067\u3082\u60a9\u3080\n\u5927\u7fa9\u3068\u76ee\u306e\u524d\u306e\u4eba\u3092\u5929\u79e4\u306b\u4e57\u305b\u305f\u304f\u306a\u3044\n\u597d\u304d\uff1a\u30a2\u30a4\u30b9\u3068\u70ad\u9178\n\nHO2\uff1a\u767d\u5999 \u7406\u793e(\u3057\u308d\u305f\u3048 \u308a\u3068)\n42\u6b73/173cm/\u7537\u6027\n\u51b7\u8840\u975e\u5e38\u3067\u6bd2\u820c\u5bb6\u3002\u5468\u308a\u3078\u306e\u7269\u8a00\u3044\u304c\u8f9b\u8fa3\u3002\n\u3057\u304b\u3057\u3001\u6c17\u306b\u5165\u3063\u305f\u76f8\u624b\u306b\u306f\u8f9b\u8fa3\u3067\u306f\u3042\u308b\u304c\u3001\u88cf\u8179\u306b\u9762\u5012\u898b\u304c\u826f\u3044\u3002\n\u4ed5\u4e8b\u306b\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u306f\u6301\u3061\u8fbc\u307e\u305a\u3001\u5408\u7406\u4e3b\u7fa9\u3067\u624b\u629c\u304d\u306f\u4e00\u5207\u306a\u3044\u3002\n\u597d\u7269\uff1a\u9c39\u306e\u305f\u305f\u304d\u3002\n\nHO3\uff1a\u7684\u4e95 \u84ee\u591c(\u307e\u3068\u3044 \u308c\u3093\u3084)\n27\u6b73/183cm/\u7537\u6027\n\u7d20\u76f4\u3067\u5584\u826f\u306a\u6027\u683c\u3067\u3042\u308a\u3001\u4eba\u306b\u99b4\u308c\u99b4\u308c\u3057\u304f\u63a5\u3059\u308b\u7a0b\u8ddd\u96e2\u611f\u304c\u30d0\u30b0\u3063\u3066\u308b\n\u4e00\u898b\u3059\u308b\u3068\u305f\u3060\u306e\u30af\u30ba\u7537\u306b\u898b\u3048\u308b\u304c\u4e2d\u8eab\u306f\u3069\u3061\u3089\u304b\u3068