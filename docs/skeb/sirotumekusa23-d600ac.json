7\u3059\u3002\n\u7acb\u3061\u7d75\u306a\u3069\u306e\u8cc7\u6599\u306f\u30b0\u30fc\u30b0\u30eb\u30c9\u30e9\u30a4\u30d6\u3067\u63d0\u51fa\u3044\u305f\u3057\u307e\u3059\u3002\n\nPC\u305d\u308c\u305e\u308c\u306e\u6027\u683c\u306a\u3069\u306f\u4ee5\u4e0b\u306b\u8a18\u8f09\u3044\u305f\u3057\u307e\u3059\u3002\n\nHO1/\u56e3\u9577\uff1a\u30b3\u30e9\u30a4\n33\u6b73/179cm/71kg/\u7537\u6027\n\u6e29\u539a\u306a\u6027\u683c\u3067\u8da3\u5473\u306f\u4eba\u9593\u89b3\u5bdf\u3002\n\u56e3\u54e1\u3092\u4f34\u3063\u3066\u306a\u306b\u304b\u3092\u3059\u308b\u306e\u304c\u30aa\u30d5\u306e\u65e5\u306e\u904e\u3054\u3057\u65b9\u3002\n\u5de6\u773c\u3092\u55aa\u5931\u3057\u3066\u304a\u308a\u3001\u30d1\u30d5\u30a9\u30fc\u30de\u30f3\u30b9\u306e\u969b\u306f\u773c\u5e2f\u3084\u30de\u30b9\u30af\u306a\u3069\u3067\u96a0\u3057\u3066\u3044\u308b\u3002\n\u56e3\u54e1\u306b\u5bfe\u3057\u3066\u512a\u3057\u3044\u611b\u60c5\u3092\u6ce8\u3050\u56e3\u9577\u3002\n\u5b63\u7bc0\u3068\u82b1\u306e\u30a4\u30e1\u30fc\u30b8\uff1a\u590f\u3001\u6708\u4e0b\u7f8e\u4eba\n\nHO2/\u66f2\u82b8\u5e2b\uff1a\u30ea\u30b3\u30ea\u30b9\u30fb\u30a2\u30a6\u30ec\u30a2\n17\u6b73/145cm/\u7537\u6027\n\u56e3\u9577\u56e3\u54e1\u3060\u301c\u3044\u597d\u304d\uff01\uff01\u306a\u9752\u5e74\u3001\u8cac\u4efb\u611f\u3068\u5fe0\u7fa9\u5fc3\u304c\u3068\u3063\u3066\u3082\u5f37\u3044\u3002\n\u56e3\u9577\u306b\u62fe\u3063\u3066\u3082\u3089\u3063\u305f\u6069\u5100\u304c\u3042\u308b\u305f\u3081\u3001\u7279\u306b\u61d0\u3044\u3066\u3044\u308b\u3002\n\u5927\u597d\u304d\u306a\u4eba\u306e\u5468\u308a\u3092\u5143\u6c17\u306b\u99c6\u3051\u56de\u308b\u5c0f\u578b\u72ac\u306e\u3088\u3046\u306a\u5b50\u3002\n\u5b63\u7bc0\u3068\u82b1\u306e\u30a4\u30e1\u30fc\u30b8\uff1a\u79cb\u3001\u9ec4\u8272\u306e\u5f7c\u5cb8\u82b1\n\nHO3/\u731b\u7363\u4f7f\u3044\u306e\u5f1f\u5b50\uff1a\u30bb\u30d5\u30a3\u30c9\u30d1\u30e9\u30f3\n26\u6b73/172cm/56kg/\u7537\u6027\n\u3084\u3084\u63a7\u3048\u3081\u3067\u304a\u3063\u3068\u308a\u3057\u305f\u6027\u683c\u3002\n\u6d3b\u767a\u306a\u4eba\u306e