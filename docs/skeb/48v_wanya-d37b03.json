ているのは椅子でも床でも大丈夫です！\nぬいぐるみの種類は、お任せします。\nわにゃちゃんの好きな動物を描いてください。\n\n希望ファイルとしましては、ロック画面(iPhone)用にイラストの子が想像している風(フキダシ風)に時間と日付が入る物と、ホーム用でフキダシなしの物、2パターンで宛名ありと文字なしをお願いしたいです。\nロック画面が難しければ、ホーム用だけでも大丈夫です！\n\nそれ以外の点はお任せさせてください。\n指定が多くなってしまいましたが、全然変更大丈夫ですので、描きやすいように楽しんで描いて欲しいです！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@48v_wanya/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2259479, "client_id": 2308047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab576af1/uploads/origins/7e81df61-5754-48e4-82df-c7d2f965b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a99a670a6ec7204c20d04fb7812ab5", "srcset": "https://si.imgix.net/ab576af1/uploads/origins/7e81df61-5754-48e4-82df-c7d2f965b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87a99a670a6ec7204c20d04fb7812ab5, https://si.imgix.net/ab576af1/uploads/origins/7e81df61-5754-48e4-82df-c7d2f965b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=281cebb4bd56b6eeb50a2ddad8fac2e4 2x, https://si.imgix.net/ab576af1/uploads/origins/7e81df61-5754-48e4-82df-c7d2f965b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=991c202abe0143ba3be8fb2914a97a8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab576af1/uploads/origins/7e81df61-5754-48e4-82df-c7d2f965b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82a1834af965d725e9414823ec62a0b4", "srcset": "https://si.imgix.net/ab576af1/uploads/origins/7e81df61-5754-48e4-82df-c7d2f965b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82a1834af965d725e9414823ec62a0b4, https://si.imgix.net/ab576af1/uploads/origins/7e81df61-5754-48e4-82df-c7d2f965b1de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2