060\u304d\u307e\u3057\u305f\uff01\u304a\u6642\u9593\u3042\u308a\u307e\u3059\u6642\u306b\u4e0b\u8a18\u5185\u5bb9\u3092\u3054\u62dd\u8aad\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\uff01\n\n\u79c1\u306e\u81ea\u5275\u4f5c\u5c0f\u8aac\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092mogani\u5148\u751f\u306e\u7d75\u67c4\u3067\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\uff01\n\u4f5c\u54c1\u540d\u3010\u305d\u3093\u306a\u306b\u53ef\u611b\u304c\u3089\u306a\u3044\u3067\u3011\n\u8cc7\u6599URL\u5148\u306b\u8868\u7d19\u30a4\u30e9\u30b9\u30c8\u306e\u62e1\u5927\u7248\u304c\u3042\u308a\u307e\u3059\u306e\u3067\u3001\u3054\u53c2\u8003\u307e\u3067\u306b\u2026\u2026\uff01\n\u203b\u4f5c\u54c1\u30b8\u30e3\u30f3\u30eb\u304cBL\u3067\u3059\u306e\u3067\u3001\u82e6\u624b\u306a\u5834\u5408\u306f\u9060\u616e\u306a\u304f\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u3066\u304f\u3060\u3055\u3044(>_<)\n\n\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306f\u3010\u653b\u3081\uff08\u30a4\u30e9\u30b9\u30c8\u53f3\u5074\u3001\u91d1\u9aea\u306e\u9752\u5e74\uff09\u304c\u53d7\u3051\uff08\u30a4\u30e9\u30b9\u30c8\u5de6\u5074\u3001\u9ed2\u9aea\u306e\u9752\u5e74\uff09\u3092\u8ffd\u3044\u8a70\u3081\u3066\u7b11\u3063\u3066\u3044\u308b\u3002\u53d7\u3051\u306f\u305d\u3093\u306a\u653b\u3081\u306b\u602f\u3048\u3066\u3044\u308b\u3011\u3068\u8a00\u3063\u305f\u69cb\u56f3\u3067\u3059\uff01\nmogani\u5148\u751f\u306e\u63cf\u304b\u308c\u308b\u30c0\u30fc\u30af\u306a\u5370\u8c61\u306e\u30a4\u30e9\u30b9\u30c8\u304c\u7279\u306b\u5927\u597d\u304d\u306a\u306e\u3067\u3001\u662f\u975e\u3068\u3082\u30ea\u30af\u30a8\u30b9\u30c8\u3057\u305f\u3044\u306a\u3068\u601d\u3063\u305f\u69cb\u56f3\u3067\u3059\uff01///\n\u30ad\u30e3\u30e9\u306e\u30a4\u30e1\u30fc\u30b8\u3068\u3057\u3066\u3001\u653b\u3081\u306f\u3010\u30e4\u30f3\u30c7\u30ec\u3002\u53d7\u3051\u4ee5\u5916\u306f\u3069\u3046\u3067\u3082\u3044\u3044\u304c\u3086\u3048\u306b\u3001\u5e38\u8ecc\u3092\u90