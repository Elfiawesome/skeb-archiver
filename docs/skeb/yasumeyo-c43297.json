外見を漠然と想定していたため今回「ドラゴンの姿」とさせていただきましたが、noakiさんのイメージされる人外の姿を自由にデザインしていただけたら幸いです。\n\n不明な箇所は自由に捉えていただいて大丈夫です。地雷やNGはありません。\n資料の不備や金額の不足、その他問題があれば、遠慮なく再送、またはキャンセルしてください。\nここまでお読みいただきありがとうございます。ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1eFbYj2syhGDPPHjGPd3SbBo75xZa9C-A?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yasumeyo/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/05489e82/uploads/origins/1c98b55b-70ef-4aeb-bed6-2f6fcb1f82b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7cf3fb6b275451a561b149a98987ec9", "srcset": "https://si.imgix.net/05489e82/uploads/origins/1c98b55b-70ef-4aeb-bed6-2f6fcb1f82b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7cf3fb6b275451a561b149a98987ec9, https://si.imgix.net/05489e82/uploads/origins/1c98b55b-70ef-4aeb-bed6-2f6fcb1f82b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb8e14c84b41f9fa21d20581a14baabd 2x, https://si.imgix.net/05489e82/uploads/origins/1c98b55b-70ef-4aeb-bed6-2f6fcb1f82b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ddc11e0723bfb9c8491ed4b694c7d413 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2261920, "client_id": 37489, "nc": 0}, {"path": "/@yasumeyo/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6d2e9280/uploads/origins/9bb70ae3-d3d0-4975-8a47-165c0f7c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtal