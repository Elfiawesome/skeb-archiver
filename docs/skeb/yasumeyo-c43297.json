, "nc": 128}, {"path": "/@yasumeyo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2261920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78794eeab1a7dc205f3c4b96f635d005", "srcset": "https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78794eeab1a7dc205f3c4b96f635d005, https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c81d0e84b66a30e9eebc69ca6bd76cba 2x, https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef8a0e8a9111efd3ef6ca08230f939e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c02bac5bc63ea6b8044dbd2645a9efc7", "srcset": "https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c02bac5bc63ea6b8044dbd2645a9efc7, https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c0c3488e667b7835510c669f39b5689 2x, https://si.imgix.net/b9fc78a8/uploads/origins/b3753ce8-ab48-4eb8-87ed-5d27950b6d0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d57b09012a7c6ea4b8085b83155520a4 3x"}, "body": "noakiさん初めまして、\n素敵なイラストをいつもたのしく拝見しています。noakiさんの魅力的なキャラクターデザイン、あたたかい色使い、美しい背景がだいすきです。もしよろしければ、友人に贈るイラストを描いていただけないでしょうか。\nわたしも友人もRPGがだいすきで、ふたりにとって大切なゲームがあります。わたしと友人のOCがRPGの世界にいるようなイラストを、日頃の感謝を込めて贈りたいと思っています。\n\n草原、青空、白い雲、海、丘、岩などがあるRPGのフィールドを、地図を見ながら探索しているイメージでお願いしたいです。\n友人は宝物探しがすきなので、もし可能でしたら木や岩の影にひっそりと赤い宝箱を置いていただきたいです。\nnoakiさんのポートフォリオにあるコンセプトアートのような雰囲気が理想です。\nふたりはシンプルで素朴なデザインのフード付きのローブを身につけています。(ロング丈で前をとめていて、中の服は省略していただいて大丈夫です！)\nOCたちは2～3等身くらいのかわいいサイズだとうれしいです。\n\nイラストは友人へ贈り、SNSのヘッダーなどに使用させていただきたいので、可能でしたら横長で、サインありとなしをいただけますと幸いです。\n\nざっくり抽象的でありながら要望をたくさん詰め込んでしまい申し訳ございません。不都合がございましたら遠慮なくキャンセルしてください。\nお忙しい中ご覧いただきありがとうございます。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-Uhx4etDVrmjiGbwoaFTODmC3qO2yGFp", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yasumeyo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2261920, "client_id": 2195441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1936107d2b3fa3abc55df91152e811", "srcset": "https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f1936107d2b3fa3abc55df91152e811, https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07537ba1c517f35a295981fb51303cc6 2x, https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c5bd8b4be44b5ce825acc0261723d3a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf20602c95dfd9531815a084207567ee", "srcset": "https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf20602c95dfd9531815a084207567ee, https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d784313bf08c0313c93fef384c08a2f 2x, https://si.imgix.net/dedebcf6/uploads/origins/08c4a8fc-ded6-4e96-9510-acf31ab953e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fbf590e42541980a8fe82e4fc45b2ff2 3x"}, "body": "【依頼内容】\nデフォルメキャラのKP駒\n ポーズおまかせ、全身、背景透過\n\n【入れて欲しい要素】\n必須_\n表情4種(真剣…、微笑み🙂、にっこり！😄、焦り)\n手に古い雰囲気の本（魔導書）を開いて持っている\n\n可能なら_\n薄手の手袋をつけている\n背中に長い杖を背負っている\n\n\n【欲しい許可】\nココフォリアでの使用\nTwitterなどSNSでのアイコン使用\n元絵がわかる範囲のトリミング･加工(反転など)\n今後、有償依頼をする(かもしれない)際の参考画像としての提示\n\n【キャラ、持ち物の補足】\n世界観_モノトーンミュージアム\n名前_ウィズ\n性格_温厚、ひたむき、内罰的\n好む色_柔らかい色、秋色\n持っている杖_背丈ほどの長さ。先端に黒い石が付いている銀の直杖（元師匠のものを譲り受けたため、本人のイメージとはかけ離れている）\n魔導書_古いもの。FGO概念礼装『魔導書』的ないかにも怪しい感じ。イメージカラーは赤。表紙に赤い石がついている\n\n\n\nスケブのリクエストって要するに投げ銭して、クリエイターから完全おまかせで絵を書いてもらおうぜってツールなんだな…！OK理解した！\nえ？相場わからん…全身8000+各表情500のつもりで出しました…安すぎたらごめん…\n今回控えめにさせてもらってしまったので、(足らんな…)って思ったら言ってくれ……言い値を払わせろ……", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@fudotuti/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 731969, "client_id": 2261920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee3314ba/uploads/origins/0de82658-d4c7-4fb3-a0be-a37b2ae54223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a6d27191e4ecc6ae1347a38b8e30a7", "srcset": "https://si.imgix.net/ee3314ba/uploads/origins/0de82658-d4c7-4fb3-a0be-a37b2ae54223?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5a6d27191e4ecc6ae1347a38b8