1 2x, https://si.imgix.net/dd167dba/uploads/origins/081fc8ad-03c0-415e-9537-553b21acd570?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a7a1d304dfd950f777b9f5214931fad 3x"}, "body": "\u521d\u3081\u307e\u3057\u3066\u3002VTuber\u6d3b\u52d5\u3092\u3057\u3066\u304a\u308a\u307e\u3059\u3001\u8056\u3005\u826f\u3057\u304d\u306e\u3068\u7533\u3057\u307e\u3059\u3002\n\u3053\u306e\u5ea6\u306fVTuber\u306e\u6b4c\u3063\u3066\u307f\u305f\u306e\u30a4\u30e9\u30b9\u30c8\u306e\u5236\u4f5c\u3092\u304a\u9858\u3044\u3057\u305f\u304f\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3063\u3066\u304a\u308a\u307e\u3059\u3002\n\n\u8981\u671b\u306f\u4ee5\u4e0b\u3068\u306a\u308a\u307e\u3059\u3002\n\n\u25a0\u4f7f\u7528\u7528\u9014\n\u6b4c\u3063\u3066\u307f\u305f\u52d5\u753b\u7528\n\n\u25a0\u30b5\u30a4\u30ba\nHD\u30b5\u30a4\u30ba(1920\u00d71080)\n\n\u25a0\u30d5\u30a1\u30a4\u30eb\u5f62\u5f0f\npsd\u3082\u3057\u304f\u306fpng\u306b\u3066\n\n\u25a0\u5e0c\u671b\u3059\u308b\u30dd\u30fc\u30ba\u3084\u8868\u60c5/\u7d75\u67c4/\u5c0f\u7269\u3084\u30a8\u30d5\u30a7\u30af\u30c8/\u80cc\u666f/\u4ed5\u4e0a\u304c\u308a\u30a4\u30e1\u30fc\u30b8\n\u63cf\u3044\u3066\u307b\u3057\u3044\u66f2\u2026\u30a2\u30a4\u30c7\u30f3\u30c6\u30a3(Kanaria)\n\n\n\u69cb\u56f3\u306f\u767d\u9aea\u306e\u5b50\u304c\u53f3\u306b\u3001\u9752\u9aea\u306e\u5b50\u304c\u5de6\u306b\u3066\u3001\u670d\u88c5\u306f\u539f\u66f2\u306e\u3088\u3046\u306a\u30e1\u30a4\u30c9\u670d\u3067\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002(\u30e1\u30a4\u30c9\u670d\u3084\u5c0f\u7269\u306e\u30c7\u30b6\u30a4\u30f3\u306f\u304a\u307e\u304b\u305b\u3044\u305f\u3057\u307e\u3059)\n\n\u80cc\u666f\u306f\u539f\u66f2\u306e\u3088\u3046\u306a\u7c21\u7d20\u306a\u611f\u3058\u306b\u3066\u3001\n\n\u8868\u60c5\u5dee\u5206\u3068\u3057\u3066\u3001\n\u2460\u76ee\u3092\u9589\u3058\u305f\u3082\u306e\n\u2461\u76ee\u3092\u958b\u3044\u3066\u304a\u4e92\u3044\u3092\u307f\u3066\u3044\u308b\u3082\u306e\n\u2462\u76ee\u3092\u958b\u3044\u3066\u753b\u9762