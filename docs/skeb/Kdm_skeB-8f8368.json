_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3033689, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f509fe5ed7532fd32ba9395026077a4", "srcset": "https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f509fe5ed7532fd32ba9395026077a4, https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bd388ddd4c19bb3e719f2b90cc8c8a0 2x, https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1903e4b5fa0601643a0728fa99b7329d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f14030222c0af9b250a76c73754adfda", "srcset": "https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f14030222c0af9b250a76c73754adfda, https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45babcdc5db32b5a60daba1ac24fd418 2x, https://si.imgix.net/6a1ddc1f/uploads/origins/201fd2f2-8d7b-485c-bab3-dcb436ed7ac9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=177f536d3842607333918f07ae8de487 3x"}, "body": "初めましてコダマさん。\nもし可能でしたら、「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」したイラストをお願いできるでしょうか。\n\n参考\n・キャラ：メジロアルダン\nhttps://umamusume.jp/character/mejiroardan\n\n・衣装：源頼光／丑御前\nhttps://fgogamemeister.com/archives/39506333.html\n\n発想に至った経緯として、ゲーム内のイベントにてアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。また彼女の勝負服が黒ベースにグリーンをあしらう、丑御前（＝源頼光）を彷彿するカラーリングだったり、身を削る固有スキルと宝具同士……などなど、こじつけるに足る理由に個人的に盛り上がってしまったため、是非この組み合わせにハマってしまった次第です。\n\n一応コダマさんはFGOをご存知のようで、ウマ娘も過去描かれていたようでしたので、今回このご依頼に踏み切った次第です。（ただお見かけしたウマ娘絵が、実は例外的に描いた1枚とかだったら大変恐縮です……）\n\n表情や構図・ポーズついては、コダマさんが思うアルダンさんのイメージのまま描いて頂けましたらOKです。\nあくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（……というか丑御前なりきられると、アルダンさんが暗く病んじゃう感じになり、それは本意ではないのです……ｗ）\nお茶目だったりお淑やかだったり、時々カッコつけたがったり等、コダマさんの解釈するアルダンさんの「らしい」振る舞いとリアクション描いて頂ければと思います！　\n\nまた、ざっと確認しましたコダマさんの絵柄から、デフォルメチックに描いて頂けるのかと想定してご依頼させて頂いてますが、等身高めの絵も描ける方のようですので、どちらでも、コダマさんがやり易い頭身で描いて頂ければOKです！\n一応、コスプレ（衣装）がメインなので、デフォルメならともかく、等身高めで描かれる場合については、なるべくなら全身が見える構図で、衣装姿を堪能させて頂ければ特に嬉しく思います……！\n\nもしかしたらジャンル違いなご依頼の懸念もございますが、もしそれでもよろしければ、何卒よろしくお願いいたします！！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 100221, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふうじゅ", "screen_name": "fujyu_koyo", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-e40547fd-2c5c-413d-87bd-50af32c1868b.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fef9568a-23a4-400d-934d-e586869228fc.gif", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 272924, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Herohero@C107 １日目 東F-24b", "screen_name": "Herohero_illust", "avatar_url": "https://pbs.twimg.com/profile_images/1531555260762050560/dLXE0CjW.jpg", "header_u