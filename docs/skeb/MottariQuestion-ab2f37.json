s/9ec261b5-ee54-4b4c-a057-ee93606742e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d06bd0a312476ec7f0e922cb2732b231 3x"}, "body": "はじめまして！ 個人Vtuberとして活動しております、まじめちゃんと申します。  \nもったり様の作品をおすすめにて拝見し、妖艶な表情に一目惚れしたので、リクエスト失礼いたします！   \n\n━━━━━━━━━━   \n\n【内容】まじめちゃんサムネイルイラスト   \n\n【希望詳細】  \n・企画内容\n→YouTube新企画「お嬢様の怪談ディナー」のサムネイルにて使用。まじめちゃんが怪談を語りながら、美味しい料理を楽しむ配信です。\n・構図\n→ナイフとフォーク(どちらかでも可)を持って食事する様子\nこちらの作品(https://skeb.jp/@MottariQuestion/works/2)のような表情ですとうれしいです。\n・服装&髪型 →三面図参照\n\n・使用用途  \n◯各種SNS(ヘッダーやアイコン、宣伝等) ◯YouTube等動画サイトのサムネイルへの使用(収益化済)  \n◯Fanbox先行公開  \n\n・希望形式→背景と人物、あれば小物等を分けたpsd、もしくは透過PNG形式でいただけるとたすかります。  \n・サイズ →サムネイルで使わせていただくので、髪や頭などが見切れない構図ですと大変助かります。\n ・キャラクター →とびきりの怖い話を探しにやってきた、地方商家の箱入りお嬢様。 怪談と食べるのが大好き。\n\n━━━━━━━━━━   \n\nもったり様の作品と怪談とのマッチが見られるのを大変楽しみにしております。\nよろしくお願いいたします。\n\n  【三面図】 https://drive.google.com/file/d/19bHDLylwBE16FPFClqPO9V0A07p1J8xP/view?usp=drivesdk\n【立ち絵】\nhttps://drive.google.com/file/d/12HNv_enQ0rmdvbi2igumMfVWrE6qVkeJ/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MottariQuestion/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3194827, "client_id": 3205967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bfc19cdde20346288d98c6cda651d91", "srcset": "https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bfc19cdde20346288d98c6cda651d91, https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a56a28d89854cf850bf3164d0773e84 2x, https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1382b28dacc765ecd9722861cd88b7b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3faa11b99eb2f0157cc957325238558b", "srcset": "https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3faa11b99eb2f0157cc957325238558b, https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=195fc80316b76ff8b348e616f579db70 2x, https://si.imgix.net/817ba584/uploads/origins/34a0b905-7e1d-410a-b1e6-21ef55d2e754?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81126ee6f65a373cb2ef2458b243ede2 3x"}, "body": "初めまして！\nVTuber準備中の小波ながれと申します。\n\nTwitterのおすすめ欄でもったり様のイラストをお見かけし、描かれる表情も色遣いも全てが私好みだったため、是非私「小波ながれ」のイラストも描いていただきたいと思い依頼させていただきました。\n\n◎依頼内容\n・人魚の姿の小波をお願いします。\n・表情は目を細めて柔らかく微笑むもしくはウインク、ポーズは画面の目の前の人に囁いてるようなものをお願いします。\n・衣装の装飾部等、描きにくいところは簡略化していただいて大丈夫です。\n\n◎使用用途\nVTuber活動内で使用(SNS上の宣伝画像、アイコン、配信・動画サムネイル等)\n\n可能であれば\n・人物/背景/宛名が分かれているPSDデータ\n・頭の先や左右どちらかの横髪が見切れていない状態\nで納品いただけますと幸いです。\n\nご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1aD9m374ut7ZDSP7BWh0580eiCAxmyz5O", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MottariQuestion/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3194827, "client_id": 2788033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c31edc6afc4a08891e1cf86af290ad3", "srcset": "https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c31edc6afc4a08891e1cf86af290ad3, https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a6f28edb81530ebe9edd824d487f38b 2x, https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4662cad03796b019a5d97a7fe67e855 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d954b1abc7278b893d543c320417b7", "srcset": "https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d954b1abc7278b893d543c320417b7, https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8839fa55b4f2e2f8724d4a5649060620 2x, https://si.imgix.net/602a975e/uploads/origins/6fc75c9d-784a-4615-9593-22c081b20866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=744a96f270c4f151d9319181d37cf423 3x"}, "body": "もったり様\nはじめましてYouTubeにてVTuber活動中の花咲すみれと申します。\n先程Xのタイムラインにオススメで上がってきたイラストを拝見して鮮やかな色使いと描き込まれた表情やポージングに一目惚れしました！！\nSkeb オープンありがとうございます！\n今回は私のファンアート制作をお願いしたくご連絡しました！\n\nデザインは以下URLでご確認ください\n\nhttps://drive.google.com/file/d/1kVq7rFCwYtBGBVj3POP1cy5VSu8-5QT9/view?usp=drivesdk\n\nイメージカラーは薄紫/深緑/ゴールド\n異国のお姫様で、お姉さん/おちゃめ/清楚/庶民派などの要素がキャラのイメージです。\n\n以下3点は強い希望です。\n・キャラクターはサムネイル等に利用させて頂きたいので、髪/耳は見切れず、かつ耳＋耳の中の花はついたままでお願いします\n※注意:ケモ耳があるため人の耳はありません！\n・可能なら背景も含まれた16:9比率1枚絵希望です。\n※難しければ待ち受けサイズでも〇\nその際は腿辺まで描写があると嬉しいです！\n・サイン入りサインなし、背景透過ver.もお願いします\n↑可能ならばレイヤー分けされたPSDファイル希望\n\n↓以下可能であれば希望内容\n・キービジュアルの服・アクセサリー(袖部分はシースルーになっています)または【大人のお姉さん】で思いつく似合うお洋服おまかせ\n・手持ち盾の有無はお任せ\n・髪型はキービジュの衣装の場合はハーフツインテール、オリジナル私服の場合は好きに改変〇\n・可能な範囲内ですまし顔や恥ずかしがっている顔などの表情差分頂けると活動の際とても助かります！\n\n希望内容はもちろん無視していただいても構いません！もったり様が可愛いと思うように好きに楽しく花咲すみれを描いて頂ければ幸いです。\n\n頂いたイラストはツイートや配信FUNBOXなどVtuber活動の一環として利用させて頂きたいと考えております\n\n可能であればグッズ化をさせて頂きたいです。グッズ化は必須ではありませんサイン入り画像の最後に☆☆と記載して頂ければ頂いた全ての画像においてグッズ化は絶対にしません。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/file/d/1UQsf6oJDO-yM_GNyte1NeMgBTGGMO8AU/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MottariQuestion/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/07379ac7/uploads/origins/df6b0c32-266e-461e-ba71-bfadd71fc6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8930d0c12296bbce7f691ac1e5d0e9cc", "srcset": "https://si.imgix.net/07379ac7/uploads/origins/df6b0c32-266e-461e-ba71-bfadd71fc6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8930d0c12296bbce7f691ac1e5d0e9cc, https://si.imgix.net/07379ac7/uploads/origins/df6b0c32-266e-461e-ba71-bfadd71fc6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abca9fd59b4ded6304dfc1e9192b1919 2x, https://si.imgix.net/07379ac7/uploads/origins/df6b0c32-266e-461e-ba71-bfadd71fc6a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dbeb03edeceb31130254820dfdc07351 3x"}, "private": true, "genre": "art", "