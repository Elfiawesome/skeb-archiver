6b61-366e-437d-a9d9-adb7385f2411?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c227ebbf355f37638b595aa8695a41ef, https://si.imgix.net/405b7ca4/uploads/origins/a0d76b61-366e-437d-a9d9-adb7385f2411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df5c8b71fd1ee447dcb99213d336ca14 2x, https://si.imgix.net/405b7ca4/uploads/origins/a0d76b61-366e-437d-a9d9-adb7385f2411?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4480cb77e6be44a75bf708da52df6ec 3x"}, "body": "いつもイラストを拝見しております。リクエストを送らせていただきます。\n\n【あらすじ】\n学校で童話の演劇を行うことになり、下記の女の子が主役のお姫様役に選ばれる。\n演劇は体育館で全校生徒及び父兄の前で行われる中、女の子は醜態を晒してしまうという内容。\n\n【キャラ】\n資料URL(オリジナル)\n\n【内容】\n①演劇本番、少女は慣れないドレスを着て緊張しつつも順調に劇を進める。\n②劇の途中、小道具にドレスが引っかかり転倒。客席側にM字開脚でパンツ丸見え\n③そのまま失禁。静まり返った館内に放尿音が響き渡る。少女はあまりの恥ずかしさに立つことが動くことが出来ず赤面して大粒の涙をボロボロ流すしかできない。\n\n描きやすいように端折ってアレンジして描いていただいてかまいません。\n\nhttps://drive.google.com/file/d/1sKKXEGqbY9XSdxrLDFoXQuLuQNJNJtLv/view?usp=drive_link", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osippotail/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2937479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57a6250a95807be2fb2b688ce925d292", "srcset": "https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57a6250a95807be2fb2b688ce925d292, https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9d42c19fc0220a8975666b81e4b1769 2x, https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df1cb129f2ce17d71c66f021c36e017c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6113455359e72ad8e3488471e0cb56e8", "srcset": "https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6113455359e72ad8e3488471e0cb56e8, https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46f7f698bc1e4a9c217a5c4130db85f4 2x, https://si.imgix.net/d435ccb8/uploads/origins/b8fb1232-71c6-4eb3-9d1f-db097d88b35f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba04f200abfc430643c4663caf6e7e56 3x"}, "body": "海果ちゃんのイラストとてもよかったです！再び、リクエストを送らせていただきます\n\nキャラ：フブキ（オリジナル）。ゲーム好き、明るい、恥ずかしがり屋な私のオリジナルガールです。\nシチュ：店内でおもらしをしてしまい、罰として表通りに立たされてしまう。そのまま再び催してしまいみんなが見ている前で追おもらしをしてしまうのだった。\n詳細：両手に「わたしはおもらしをしました」と書かれたプレートを持っており、服装は全裸にパンツ一丁。パンツはおもらしで黄色く濡れていて、雫が股からしたたり落ちている。表情は羞恥で顔を真っ赤にして涙を流している。周囲に見物人が多数いる。\n（任意）おもらし後、おしっこの重みでパンツがずれ落ちてさらに恥を上塗りしてしまう。\n\nイメージ：\nhttps://www.pixiv.net/artworks/111556269\nhttps://www.pixiv.net/artworks/110980649\nhttps://skeb.jp/@onyaruga0683/works/61\n\nhttps://drive.google.com/file/d/13L8wtlAV68L2hq0xr83UAfCYH7KwKvBJ/view?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osippotail/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2937479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9332e3b69ec3dbd4e73abd2725e0207b", "srcset": "https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9332e3b69ec3dbd4e73abd2725e0207b, https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a56dc144fd90c48a3553bba68f9af99 2x, https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9009f5704ca90e2161613d4a849e0aa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5f1ca5799d3c984e24b3542301e68b", "srcset": "https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5f1ca5799d3c984e24b3542301e68b, https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f3d6ec2bdf9ae7783dfb06aa28ed9d6 2x, https://si.imgix.net/716da304/uploads/origins/63794b36-38af-4263-98bb-85560836c24e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2fa4e429dca0151e35c063c173233fa5 3x"}, "body": "いつもイラストを楽しく拝見しております。Xにてイラストを拝見し、是非リクエストを送りたいと思いました。特殊なシチュですが、ご検討いただければ幸いです。\n\nキャラクターは星屑テレパスから小ノ星海果です。\n\n教室の床が抜けて下の階の天井からパンツが丸出しでぶら下がっているイラストをお願いします。\nその後彼女は失禁し、下の階の教室におしっこを巻き散らかします。教室は阿鼻叫喚ですが、我慢していた彼女は申し訳なさと恥ずかしさで顔を真っ赤にしつつおしっこを垂れ流すことしかできないというシチュです。\nイラストは、下の階から見た様子（パンツを見上げている）をメインとし、カットや別イラストとして彼女の表情も描いてほしいです。羞恥で顔を真っ赤にしており、涙目です。\n\n説明が不足している部分は下記のＵＲＬを参考にしてください。よろしくお願いいたします。\n\n参考\nhttps://www.pixiv.net/artworks/61086988\