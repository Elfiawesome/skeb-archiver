rcset": "https://si.imgix.net/423c817f/uploads/origins/13599df4-965e-4737-8917-4f811a1cca7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be830219fa5127dc740b1262dd0afcb5, https://si.imgix.net/423c817f/uploads/origins/13599df4-965e-4737-8917-4f811a1cca7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcaa1997cc98f95fcf8f1d10002f1b4e 2x, https://si.imgix.net/423c817f/uploads/origins/13599df4-965e-4737-8917-4f811a1cca7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c314fe190752296da2408b2f36ed707 3x"}, "body": "こんにちは！最近描かれた『ZZZ』のスンナのイラスト、とても気に入りました。\n\n『原神』のディオナを、同じようなシチュエーションで描いていただけませんか？カクテルの中に小便をして、飲み物を台無しにしようとしている、悪意に満ちつつも満足げな表情で描いてほしいです。\n\nもし可能であれば、帽子を被っていない姿で描いていただけると嬉しいです。\n\nご検討いただければ幸いです！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osippotail/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2937479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb37989a/uploads/origins/57f99345-9fad-4548-b0d8-d09ea02227d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08b80d696289f4bd2f7e56633172a99", "srcset": "https://si.imgix.net/bb37989a/uploads/origins/57f99345-9fad-4548-b0d8-d09ea02227d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c08b80d696289f4bd2f7e56633172a99, https://si.imgix.net/bb37989a/uploads/origins/57f99345-9fad-4548-b0d8-d09ea02227d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=854b2767a5e6b59283aeb7dbffb76aae 2x, https://si.imgix.net/bb37989a/uploads/origins/57f99345-9fad-4548-b0d8-d09ea02227d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=604267459f2929992eaead5380a56f43 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "ht