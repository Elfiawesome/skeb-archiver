u306a\u69cb\u56f3\u3002 \n\n4. \u30c8\u30fc\u30f3\uff1a \u4e8b\u52d9\u7684\u3001\u7121\u95a2\u5fc3\u3001\u5e73\u71b1\u3002 \n\n5. \u8996\u70b9\uff1a \u5148\u751f\u306b\u304a\u4efb\u305b\u3057\u307e\u3059\u3002 \n\n6. \u76ee\u7684\uff1a \u611f\u60c5\u3092\u6392\u9664\u3057\u305f\u300c\u30d7\u30ed\u30bb\u30b9\u300d\u3068\u3057\u3066\u306e\u6b8b\u9177\u3055\u3092\u63cf\u304d\u3001\u8aad\u8005\u306b\u51b7\u5fb9\u306a\u6050\u6016\u3092\u4e0e\u3048\u308b\u3053\u3068\u3002 \n\n7. \u9577\u3055\uff1a 2\u7ae0\u69cb\u6210\u5e0c\u671b\u3002\u6587\u5b57\u6570\u306f\u4e88\u7b97\u5185\u3067\u8abf\u6574\u3057\u3066\u304f\u3060\u3055\u3044\u3002 \n\nII. \u69cb\u6210\u3068\u30da\u30fc\u30b9\u914d\u5206 \n\n1. \u5148\u751f\u306e\u57f7\u7b46\u30b9\u30bf\u30a4\u30eb\u306b\u5408\u308f\u305b\u3001\u81ea\u7531\u306b\u304a\u6c7a\u3081\u304f\u3060\u3055\u3044\u3002 \n\nIII. \u821e\u53f0\u3068\u30ad\u30e3\u30e9\u30af\u30bf\u30fc \n\n1. \u30ad\u30e3\u30e9\u30af\u30bf\u30fc\uff1a \u60c5\u5831\u30a2\u30af\u30bb\u30b9\u6a29\u9650\u3092\u5236\u9650\u3055\u308c\u305f\u4e8b\u52d9\u8077\u306e\u30b4\u30d6\u30ea\u30f32\u540d\u3002 \n\n2. \u821e\u53f0\uff1a P\u306e\u9928\u5185\u306e\u9000\u5c48\u306a\u5834\u6240\u3002 \n\nIV. \u8ffd\u52a0\u8981\u671b \n\n1. \u4f5c\u54c1\u306e\u516c\u958b\u306b\u3064\u3044\u3066\u306f\u5148\u751f\u306e\u3054\u5224\u65ad\u3092\u5168\u9762\u7684\u306b\u652f\u6301\u3044\u305f\u3057\u307e\u3059\u3002\u3082\u3057\u9031\u672b\u306a\u3069\u306b\u5c11\u3057\u305a\u3064\u516c\u958b\u3055\u308c\u308b\u3088\u3046\u306a\u3053\u3068\u304c\u3042\u308c\u3070\u3001\u4e00\u8aad\u8005\u3068\u3057\u3066\u5927\u5909\u5b09\u3057\u304f\u601d\u3044\u307e\u3059\u304c\u3001\u6700\u7d42\u7684\u306a\u6c7a\u5b9a\u306f\u5168\u3066\u5148\u751f\u306b\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\u3002 \n\n2. \u5185\u5bb9\u304c\u3069\u308c\u307b\u3069\u300c\u975e\u4eba\u9053\u7684\u300d\u3042\u308b\u3044\u306f\u300c\u7570\u69d8\u300d\u3067\u3042\u3063\u3066\u3082\u3001\u4e16\u754c\u89b3\u306b\u9069\u