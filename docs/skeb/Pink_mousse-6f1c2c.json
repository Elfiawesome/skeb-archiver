l free to do anything with her outfit or change it to match your style more ^^ full creative freedom. If the amount is too low for what you would like to do then please appeal. I may post to SNS with full credit to you.\n\nThank you for your time and consideration!\nRef:https://imgur.com/a/2UmRtvd\n\nhttps://drive.google.com/drive/u/0/folders/1uOS5xmu_cY11yMigfro8jzPnliqxFdkh", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pink_mousse/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2502374, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d101fa6/uploads/origins/ae37b42e-b153-4421-a77f-7f999481a39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8545851f7657b50a0099814648de257b", "srcset": "https://si.imgix.net/2d101fa6/uploads/origins/ae37b42e-b153-4421-a77f-7f999481a39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8545851f7657b50a0099814648de257b, https://si.imgix.net/2d101fa6/uploads/origins/ae37b42e-b153-4421-a77f-7f999481a39d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72a923adc0a940264adc5214853d0837 2x, https://si.imgix.net/2d101fa6/uploads/origins/ae37b42e-b153-4421-a77f-7f999481a39d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ac1fe57cc9e7fa16c0dddce8105375f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d101fa6/uploads/origins/ae37b42e-b153-4421-a77f-7f999481a39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbe5f83c94f3ec1855e8587b5043653c", "srcset": "https://si.imgix.net/2d101fa6/uploads/origins/ae37b42e-b153-4421-a77f-7f999481a39d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbe5f83c94f3ec1855e8587b5043653c, https://si.imgix.net/2d101fa6/upload