/uploads/origins/ca861f48-c00f-4f92-a9bc-9099c13cf616?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=122b18de0aa6864d735118b7f0b477c8 3x"}, "body": "こんにちは！僕のドラゴンボールゼノバースキャラを描いてくれませんか？彼女は魔人ブウで、ちょっとクゾガキです。\n\nポーズとしては、3/4ビューのようなものを考えています。彼女の腕は上向きに角度をつけていて（でも頭上には上げていない）、手は拳を作っています。片足は上に上げ、もう片方の足は地面にほとんどついていない。彼女のピンクのオーラは、まるで本当にパワーアップしているかのような絵になるのだろうか......？\n\nスカーフをなくすなど、衣装の調整は自由だが、太ったお尻にタイツというのは重要だ！\n\nhttps://drive.google.com/drive/folders/1zcZoZ7GARQjNpuaEjc1QQzvPHxV_HCUy?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pink_mousse/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2502374, "client_id": 512498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e5d5517/uploads/origins/d1e46d3b-83db-4d1b-8e87-200aca57eefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a9c63a29df766e35884213487bf73f", "srcset": "https://si.imgix.net/1e5d5517/uploads/origins/d1e46d3b-83db-4d1b-8e87-200aca57eefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a9c63a29df766e35884213487bf73f, https://si.imgix.net/1e5d5517/uploads/origins/d1e46d3b-83db-4d1b-8e87-200aca57eefc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e613f32570bdd891f651f179ee93fb7 2x, https://si.imgix.net/1e5d5517/uploads/origins/d1e46d3b-83db-4d1b-8e87-200aca57eefc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e0c09ae2c5d6bf340c11de51debd2e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e5d5517/uploads/origins/d1e46d3b-83db-4d1b-8e87-200aca57eefc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e485a7171d9e879458ea2d9e9c21a66d", "srcset": "https://si.imgix.net/1e5d5517/uploads/origins/d1e46d3b-83db-4d1b