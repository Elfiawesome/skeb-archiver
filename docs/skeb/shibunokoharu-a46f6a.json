な存在の生活水準が近世的なヨーロッパ風ファンタジー世界\n・「青薔薇」が統治する青の国が舞台\n・多種多様な花が咲いているが、青い薔薇は王城にのみ咲いている\n\n【2人の関係】\n体の関係（未遂）から始まり、毎晩一緒に寝るだけ（ド健全）の関係\n\n・①→②への印象\n∟変なやつ\n・②→①への印象\n∟ 「忘れられないあの人」に見た目がよく似ているが、似ているだけの他人。\n\n▼シチュエーション\n野良猫を構っている二人（街中、王城の庭、花畑…等場所は問いません。好きにお描きください。）\n\n【資料】\nhttps://drive.google.com/drive/folders/1sVUCzXoCaIO34_EksxGct9ewbHQ3R3-q?usp=sharing\n\n【用途】\n個人鑑賞、個人利用の範囲で待ち受け、印刷物(個人観賞用にポストカード1枚印刷)などに利用させて頂きます。\n\nご検討をお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shibunokoharu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3869716, "client_id": 1738231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a8fbf55/uploads/origins/79d1db62-fed7-4836-b868-17dc5d23250b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81aa68ae1cc4b2cb279989659b0381ff", "srcset": "https://si.imgix.net/7a8fbf55/uploads/origins/79d1db62-fed7-4836-b868-17dc5d23250b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81aa68ae1cc4b2cb279989659b0381ff, https://si.imgix.net/7a8fbf55/uploads/origins/79d1db62-fed7-4836-b868-17dc5d23250b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c9704928417f464be15c40f9049c2eb 2x, https://si.imgix.net/7a8fbf55/uploads/origins/79d1db62-fed7-4836-b868-17dc5d23250b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=079ff188e49f5fd1aa2f66026822293e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a8fbf55/uploads/origins/79d1db62-fed7-4836-b868-17dc5d23250b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b309beded9f65d4e52bd8673437de98", "srcset": "https://si.imgix.net/7a8fbf55/uploads/origins/79d1db62-fed7-4836-b868-17dc5d23250b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b309b