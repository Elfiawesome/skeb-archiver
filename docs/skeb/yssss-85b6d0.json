rcset": "https://si.imgix.net/6888c049/uploads/origins/43366d3b-294f-4fec-91fe-172a296b8b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e0420c82982c9e5fdfec68cf8f318d7, https://si.imgix.net/6888c049/uploads/origins/43366d3b-294f-4fec-91fe-172a296b8b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4cb130a6ae2d9ea2806706fe21664c0 2x, https://si.imgix.net/6888c049/uploads/origins/43366d3b-294f-4fec-91fe-172a296b8b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fbb47e464768f88f6eadd2bbe999bde 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6888c049/uploads/origins/43366d3b-294f-4fec-91fe-172a296b8b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc20c28c51af35e670b0c2604733778", "srcset": "https://si.imgix.net/6888c049/uploads/origins/43366d3b-294f-4fec-91fe-172a296b8b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbc20c28c51af35e670b0c2604733778, https://si.imgix.net/6888c049/uploads/origins/43366d3b-294f-4fec-91fe-172a296b8b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c675fff1500dd58fdd328df7899d1ed3 2x, https://si.imgix.net/6888c049/uploads/origins/43366d3b-294f-4fec-91fe-172a296b8b91?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a79c488471851f2fb2242ffddbfc540 3x"}, "body": "初めまして！シュンキチさんのイラストの雰囲気がとても好きで、リクエスト失礼致します。\n\nこの度、書いて頂きたいのはTRPGで作成した殺し屋のバディです。\nCoCシナリオ「ドロップアウトディスパイア」出身の二人です。\n基本的に構図などもシュンキチ様の解釈にお任せさせていただきますが、殺し屋の仕事中や二人の関係性が伺える雰囲気を出していただければ嬉しいです。服飾の簡略・アレンジも自由にしていただいて構いません。\n  \n\n❐キャラクター詳細 \n\n｜赤髪\n26歳/174cm/小児科医\n涼しい顔で遺書を書かせたり渡したりする男。それを読んだ人がどんな反応をするのかを楽しみにしている。人懐っこい笑みで他人に近寄っていくが飽きたら捨てる。外聞を気にしており、手を汚すことも嫌い。拳銃を使用している。\n\n｜青髪 \n20代後半の外見/188cm/殺し屋\n気だるげで不機嫌にしている大男。仕事が終わったなら早く帰って休みたい。遺書にも他人にも興味はないが、思い通りにならないと不快感を露わにするこだわり強めの暴君。大きな裁ちばさみを愛用し、首を落とす殺し方を好む 。\n\n\n❐関係性 \n赤髪が青髪を脅して組ませている綱渡りの相棒関係です。\n青髪は仕方なく従っているが殺したいほど相手を嫌っており、赤髪からは気に入られています。どちらもマウントを取りたがるため口論が絶えませんが、考えの相性はとてもいいです。\n\n❐使用用途 \n個人観賞・SNSのアイコン/ヘッダー（名前は記載させていただきます）、ホーム画面等への壁紙設定 \n\n資料の不備や金額が不十分であれば再送・キャンセルしていただいて問題ございません。\nご検討のほど、何卒よろしくお願いいたします。\n\nhttps://1drv.ms/f/s!Aoev7qaOQfkZnQCFALJYhCp3A69E?e=begIph", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 967254, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ap1os", "screen_name": "ap1os", "avatar_url": "https://pbs.twimg.com/profile_images/2020351551160934400/aa5VHcot.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1345180934077702144/1715133409/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1924139, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "青井", "screen_name": "yooo009", "avatar_url": "https://pbs.twimg.com/profile_images/1099591570003615744/2uMvUowI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/769007618111045633/1550998036/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 33}, {"id": 3086424, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "愛犬", "screen_name": "tasuketei_i", "avatar_url": "https://pbs.twimg.com/profile_images/1954490532258033664/Oqb3FDfR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1679528163058290689/1759068088/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_ra