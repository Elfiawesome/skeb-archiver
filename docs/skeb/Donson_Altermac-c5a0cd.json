imgix.net/d76142f5/uploads/origins/31712ec7-1179-49e5-9f7e-47f524978c17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6e258ba67b38ab4d72b2bebbfcda452 3x"}, "body": "こんにちは。再びイングリッドのイラストをお願いしたいのですが。前回のシーンの続きを描いてください。校長がイングリッドを自分の部屋に呼び出したところから始まります。彼女はジャケットを着て校長室に到着します。校長は、自分の命令に従ったかどうか尋ねます。イングリッドはコートを脱ぎ、その下は全裸であることを露わにします。一日中シャワーを浴びていないため、誘惑的な匂いを漂わせています。校長は嘲笑混じりに彼女を褒めます。 彼女はすでに濡れており、その様子は校長の目にも逃れていません。校長は彼女に心の準備をするよう告げ、今夜は眠らせてやらないと言います。これから起こることを予感して、イングリッドは認めたくはないものの、興奮してしまいます。\nその他の詳細や台詞については、お任せします。\nまた私の依頼をご検討いただき、ありがとうございます。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Donson_Altermac/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3839602, "client_id": 192594, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5686ee7b71f2e378914d73502af5c408", "srcset": "https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5686ee7b71f2e378914d73502af5c408, https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70515b331c1a900f60eadb717cf0cd5f 2x, https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90fafd9540ce6363a745eeb423987272 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19d57721d9f9c22e31caf539fe4d7d71", "srcset": "https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19d57721d9f9c22e31caf539fe4d7d71, https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85ce16a8296d6e1c3c2d8d1e44797b76 2x, https://si.imgix.net/df2b8527/uploads/origins/0490c718-d34f-4b10-a6ea-5b72184da742?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07e44e417bd3f53cfcf77c8162f9b33d 3x"}, "body": "こんにちは。イングリッドのイラスト、特にパイズリシーンの続編を、改めてお願いしたいのですが。\n\n校長はイングリッドのポニーテールを引っ張りながら、後ろから彼女を貫いています。彼女は「もう射精したばかりだし、授業に戻らなきゃ生徒たちにバレちゃう」と抗議します。校長は「イングリッドの匂いでまた興奮してしまった」とコメントします。突然、外から生徒が授業が終わったと彼女を呼びます。イングリッドはパニックになり、生徒には片付けて次の授業に行くよう言い、校長にはやめてくれと懇願します。 校長は当然のように拒否し、彼女自身がこの状況に興奮していると告げる。イングリッドは否定するが、確かに興奮が高まっていることに気づく。ついに校長は彼女の中に射精し、イングリッドも絶頂を迎える。校長はその後シャワーを浴びることを禁じ、「またすぐ会おう」と言い、嘲るように「それでいいか？」と尋ねる。断る余地のないイングリッドは、しぶしぶ同意する。\n\nリクエストをご検討いただきありがとうございます", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Donson_Altermac/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e4a5f7a9/uploads/origins/9cafabf4-1218-44f0-87b1-d4d3212a48b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd9af0e547d953f4e8a7e02846afeb59", "srcset": "https://si.imgix.net/e4a5f7a9/uploads/origins/9cafabf4-1218-44f0-87b1-d4d3212a48b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd9af0e547d953f4e8a7e02846afeb59, https://si.imgix.net/e4a5f7a9/uploads/origins/9cafabf4-1218-44f0-87b1-d4d3212a48b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtc