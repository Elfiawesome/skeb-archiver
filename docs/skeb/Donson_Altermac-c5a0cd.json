ore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19693890/uploads/origins/c9717c34-7bb7-4c88-b2af-fe4312635a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=459ed01527ef827962feff840e13a95f", "srcset": "https://si.imgix.net/19693890/uploads/origins/c9717c34-7bb7-4c88-b2af-fe4312635a88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=459ed01527ef827962feff840e13a95f, https://si.imgix.net/19693890/uploads/origins/c9717c34-7bb7-4c88-b2af-fe4312635a88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dea6a6cf2ef8a4cfcd95d77b305f8f80 2x, https://si.imgix.net/19693890/uploads/origins/c9717c34-7bb7-4c88-b2af-fe4312635a88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d98b81c4cf867a1951461e07b9d36b82 3x"}, "body": "こんにちは、イングリッドを題材にしたイラストを再度お願いしたいです。前回のシーン（https://skeb.jp/@Donson_Altermac/works/11）の続きを希望しています。 校長がイングリッドを男子トイレに連れ込み、個室の中で性行為を行っています。イングリッドは前屈みの姿勢（こんな感じ：https://www.pixiv.net/artworks/72435102 ※ちなみにこの画像、すごく気に入っています）で、校長が背後から挿入しています。 イングリッドは強い快感に浸っているが、校長が指摘すると否定する。突然生徒たちが入室し、イングリッドは驚いて気づかれないよう声を潜める。校長が再び動き始めると、イングリッドは必死に静かにしようとする。校長が中出しすると同時に彼女も絶頂を迎える。イングリッドは排尿を始めるが、生徒たちが既に退出していることに気づいていない。ご検討いただきありがとうございます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Donson_Altermac/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e364eedf/uploads/origins/68c462de-7f34-4abc-aed1-55cc255bcddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4bbc326d6b726adc4da9bcf2e960d082", "srcset": "https://si.imgix.net/e364eedf/uploads/origins/68c462de-7f34-4abc-aed1-55cc255bcddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsi