t=crop&crop=top&w=200&h=200&blur=200&s=73d72bf8c216f2d0937caf1729f26a4c, https://si.imgix.net/b67e7ecf/uploads/origins/d8f6c181-605b-4c3f-abb8-0583ac12251e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c191f07520c0e0441170f724fd4c2fbd 2x, https://si.imgix.net/b67e7ecf/uploads/origins/d8f6c181-605b-4c3f-abb8-0583ac12251e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df01b52902f959fc826760071b6d91ea 3x"}, "body": "こんにちは。\n\nカジノでウェイトレスとして働いているイェンコのキャラクターを描いて欲しいです。服装はスーツかそれに近いものを希望します（例：リファレンスドライブのClothes_Uniform.jpg）。できれば、彼女が持っているトレイの上に、彼女のマスコットであるブナードが座っているか、寝ているかして欲しいです。\n\n円光のいくつかの例を添付したリファレンスを参照してください。( Character_Yenkoes から始まるファイル )\n\nhttps://drive.google.com/drive/folders/1q-Z1pdZGKxFOyTJ2QImXZ9bcB6GpW1lc?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nrmk_norinori/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1320257, "client_id": 1807877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73169920/uploads/origins/de185be2-5fa0-4bbd-a8dd-1804be34c826?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b630c0284f164178f7997c8d5a799499", "srcset": "https://si.imgix.net/73169920/uploads/origins/de185be2-5fa0-4bbd-a8dd-1804be34c826?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b630c0284f164178f7997c8d5a799499, https://si.imgix.net/73169920/uploads/origins/de185be2-5fa0-4bbd-a8dd-1804be34c826?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=569ab664ceafb3e4277102bd72eea947 2x, https://si.imgix.net/73169920/uploads/origins/de185be2-5fa0-4bbd-a8dd-1804be34c826?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d18e0807752a6d6a3acd222b428e0c41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls"