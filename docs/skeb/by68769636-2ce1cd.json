0&h=200&s=8de0181a7e24509b44d5ed339139a7b3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c53425af/uploads/origins/6409abc1-ac61-4f3b-8333-9ad75f0ffbcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62067fe831927c4cc6d871e8cb6a3c1b", "srcset": "https://si.imgix.net/c53425af/uploads/origins/6409abc1-ac61-4f3b-8333-9ad75f0ffbcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62067fe831927c4cc6d871e8cb6a3c1b, https://si.imgix.net/c53425af/uploads/origins/6409abc1-ac61-4f3b-8333-9ad75f0ffbcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6d23d034ab741a20582196730c385a7 2x, https://si.imgix.net/c53425af/uploads/origins/6409abc1-ac61-4f3b-8333-9ad75f0ffbcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b88d85db139cedc09437a55a7ea1d1b 3x"}, "body": "夜桜さんちの大作戦の夜桜六美の吊るし上げをお願いします。\n大体の構図はアニメ第七話の吊るされている太陽の所と同じですが、胸回りにも腕を巻き込みつつ縄が巻かれています（+肩縄とシンプルな股縄）。\n衣装は六美が就寝時に着ているものでお願いします。\n\n資料\n六美のパジャマ姿\nhttps://mouseion.blog.jp/archives/24342293.html\nhttps://www.animatetimes.com/news/details.php?id=1720320276", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kokonoeseiya/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 147433, "client_id": 1920956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc9b2d8a35f8d3a67b4d1e416b9839f2", "srcset": "https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc9b2d8a35f8d3a67b4d1e416b9839f2, https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a772ad62f96e9cb1064dc2ccbd96d1f7 2x, https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d608d5c505ef9379952de3137e9e5c9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a57df1322677fe8251425bec20f11c3", "srcset": "https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a57df1322677fe8251425bec20f11c3, https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dd24494756767a4e9a94cf82f7175bf9 2x, https://si.imgix.net/305e7443/uploads/origins/9b5000c1-e21a-4c7b-9608-075fa668b624?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a967f0fd0044a041a1e36fd0ece61d0 3x"}, "body": "ミラとイリスの緊縛訓練の話をお願いします。\nまずは通常の縄でイリスを縛ろうとするが、いつも以上の拘束に不安になったイリスにお手本見せるために仕方なく自分を縛るミラ。\n手首以外をきつく縛り上げ、猿轡をかけたあとに背中と足首から伸びる長い縄を手首に器用に縄を巻きながら横たわり、逆海老のような体制になりながら巻き終わると、\n起きながら足を水平にする勢いで手首を固定するようにして自縛完成。\n足は太もも、膝、足首等で一纏めにし、その上で折りたたんだ状態ですねと太ももをまとめて縛った上に手首と胸の縄と繋げているため、立つことができない正座状態となっています。\n自縛とはいえ、あまりにもきつい拘束に後悔するミラ。\nミラが縄抜けしたあと、イリスも縄抜けに挑戦する。\nほとんどミラの自縛と一緒だが最終的な体制が体育座りに近いイリス。\n縄抜けしようともがくが、あまりにもきつく縄抜けできない。\n流石に一回で連れて行くのは怪しまれるか、と思ったミラによりイリスはほどかれ、次の訓練に移る。\nモンスターのように自在に動き回る魔法の縄に縛られないようにする、または縛られたあとに縄抜けする訓練。\nイリスに最初やろうとしたが、またお手本がみたいと言ったイリスに動揺したミラに縄が飛びかかる。\n最初は驚いたが、冷静に巻かれまいと冷静に対応するミラ、しかし、躍起になった縄により捕まり、\n猿轡もかけられて股縄ありの逆海老縛りにギチギチに縛られる。\nそこから縄抜けしようともがく様子にイリスが少し赤らめた所で無理やり縄を破り、少し普通とは違う縛り方も体験しましょう、と言ってイリスを両手を頭の上で縛ってから背中に持っていくようにして縛る。\nイリスは恥ずかしがりながらも懸命に縄抜けを試みる。\nそろそろ連れ出そうかとミラが考えていると、\n先ほどよりは緩めにされていたのでイリスが縄抜けできたその瞬間、\nベッドから転げ落ちミラに追突、\nそして魔法の縄が暴走して二人を縛り上げて連結してしまう。\nイリスは普通に縛られた上から簀巻きと言えるほどにぐるぐる巻きにされていて、\nミラは足を曲げられないように縛られた上で、イリスを胴体と足の間に挟みながら胴体に足を上げた状態でくくりつけられた状態に。\n更に縄でできた口枷同士も繋げられてきつい状態。\nここからしばらくもがくが、水を被ったりして縄が固くなったりなどして、どんどん状況が悪化していく。\n最終的にはオリヴィアも巻き込んで三人の緊縛連結状態（オリヴィアはミラと背中合わせ+逆さまの逆海老縛り）になり、ここからどうする、どうなる、といった感じです。", "nc": 59, "word_count": 25515, "transcoder": "text", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 600402, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "いちえん 東２つ26b", "screen_name": "ichien_ekaki", "avatar_url": "https://pbs.twimg.com/profile_images/1698671914783490048/o8FF7YEw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/968859044004839424/1755617116/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1490304, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "、", "screen_name": "konosepu", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 129}, {"id": 3195832, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さぼくら　ゲダン2C-2", "screen_name": "sabouncle777122", "avatar_url": "https://pbs.twimg.com/profile_images/1752307747272728577/Gmqjdggc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1330747436625661954/1706617783/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "