r=200&s=11952892c04423ac8c98746995b3964f 2x, https://si.imgix.net/f170d42c/uploads/origins/8e892732-205c-46eb-901d-38696d6258a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26805cc91c4d6fea44ff1fcdff1fb1c5 3x"}, "body": "結月ゆかりの\nアンドロイドっぽい感じのをお願いします\n（メンテドッグに入ってる感じので\n\n配線最高", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FiveseveN/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 10116, "client_id": 2467332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4c7e370e4a5cc2801cb9aec8085edcc", "srcset": "https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4c7e370e4a5cc2801cb9aec8085edcc, https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62b614332bb4915ce97a57ad595f5fb6 2x, https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16243a9f47e0f7384d34e46616e6a498 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bb0ba71b3a020710a9f4768459fc322", "srcset": "https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bb0ba71b3a020710a9f4768459fc322, https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f134727422b7381ceac552b5fa0f2d23 2x, https://si.imgix.net/ab44c46c/uploads/origins/5fcc397d-9c3f-4c91-bfb8-f8a75bc9c796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d1c4b81268201a1e3fc7874d5424733 3x"}, "body": "お疲れ様です。\n前回のイラストがとッッても魅力的だったので、\n早速ですがまたリクエスト送らせていただきました。\n\n今回は、刀剣乱舞の大倶利伽羅をぜひ描いていただきたいです。\n\n「”非戦闘時に少し気が緩んで穏やかな表情をしている大倶利伽羅”と、何の気なしに目が合った」……という場面を、Five-seveN先生のタッチで見てみたいです。\n（”目が合った”という部分が作品作りにおいてネックになってしまう事があれば、当該部分は飛ばしていただいても大丈夫です！）\n\n表情以外の、ポーズや構図は全て先生にお任せいたします。\nきっとまた素敵に描いていただけると思うので……！！\n\n\n◇キャラクター：大倶利伽羅（出典／刀剣乱舞）\n\n◇ポージング・構図：--（指定なし）\n\n◇表情：落ち着いた、少し優しめの顔\n\n◇服装：軽装、内番、戦装束、のどれでも構いません\n\n◇資料：\n（戦装束”極”）https://i.gyazo.com/fcc258c4bf6cd1c2458a8c9cc0181d9a.png\n（内番）https://i.gyazo.com/3014281235b263224ba0b8c55806c233.png\n（軽装）https://i.gyazo.com/47523d619e61b711573f1a544c3b9389.png\n\n\n修行から帰って来て、\n以前よりも主（プレイヤー）に信頼を置くようになった大倶利伽羅くんが見せる、\n「一見無表情に見えるけど、よく見るともしかして少ーしだけ笑ってくれてる……？」というような、滅茶苦茶に繊細な表情の大倶利伽羅くんをぜひ！検討いただければ幸いです！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FiveseveN/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 10116, "client_id": 2467332, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9848180632356ca01ea179d7440a19cc", "srcset": "https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9848180632356ca01ea179d7440a19cc, https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f5b48f7729bc333f5e227cb6491ed86 2x, https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=707d7a4d520b197ef5c22b6045b1c3e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61463ef219ef42eeba0c8506dd0c0d18", "srcset": "https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61463ef219ef42eeba0c8506dd0c0d18, https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9877312d97c6f081a983483e3461c7d 2x, https://si.imgix.net/8915350b/uploads/origins/39333021-9852-449c-a40f-41838f45fc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a9a410183ca62f3821f8060216a916b0 3x"}, "body": "こんにちは。いつも陰ながら応援しております。\n今回はルスランというキャラクターの幼少期イラストを、リクエストさせていただきたく存じます。\n\n◇キャラクター：ルスラン（出典／鏡の中のプリンセス）\n\n◇構図：出来れば脚が魅力的に見える様なポーズ、もしくはアングル。裸足ならより良いかと思われます。\n\n◇表情：にかっ、とした爽やかな笑顔\n\n◇資料：https://i.gyazo.com/e0d5a0aaaa0cf3d732d343f4c3981d90.png\n　　　　https://i.gyazo.com/555ea20141f1ab182408dece7ab6c07a.jpg\n（あまりメジャーではない作品なので幼少期の資料画像は恐らく検索してもあまり数が見つからないかと思われます。申し訳ない限りですが、描かれる上で不明瞭な部分があればFive-seveN様の方で素敵にアレンジしていただければ幸いです）\n\n\n後に非道王と国民から恐れられるルスランというキャラクターの、誕生日イベントでたった１度だけ登場した幼少期の姿です。\n幼すぎず、かといって成人でもない絶妙な年代の少年を、ぜひFive-seveN様の魅力的なタッチで描いていただければと思います！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FiveseveN/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 10116, "client_id": 80865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1950aaa3/uploads/origins/711a4