itterでの使用、Youtubeなどの配信やサムネイル等での使用、可能でしたら背景透過verも頂けたらと思います。\n・個人での使用（個人観賞以外でTwitterに投稿する場合はskebで依頼して描いて貰ったと記載します。）\n・PSDとPNGデータを頂けると嬉しいです。\n\n【イラストについて】\n・髪型、アクセサリー等はそのままでお願いします。\n・表情やポーズなどは先生にお任せいたします。\n\nお忙しい中、申し訳ありません。\nご検討の程、宜しくお願いいたします。\n\nhttps://rena-shiratori.fanbox.cc/", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0_N1ar_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1133837, "client_id": 1659096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c802c172/uploads/origins/1b9867f6-2c59-40b8-a2c4-a5ffb9355840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e972a4cef46ec9eb667547925361770a", "srcset": "https://si.imgix.net/c802c172/uploads/origins/1b9867f6-2c59-40b8-a2c4-a5ffb9355840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e972a4cef46ec9eb667547925361770a, https://si.imgix.net/c802c172/uploads/origins/1b9867f6-2c59-40b8-a2c4-a5ffb9355840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46d21e920f3159ec2d384b15f6ac1f89 2x, https://si.imgix.net/c802c172/uploads/origins/1b9867f6-2c59-40b8-a2c4-a5ffb9355840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c0e4a0501de2e099b7be3b0c2e66544 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c802c172/uploads/origins/1b9867f6-2c59-40b8-a2c4-a5ffb9355840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be6150ab0e143a776d224c763df3b63c", "srcset": "https://si.imgix.net/c802c172/uploads/origins/1b9867f6-2c59-40b8-a2c4-a5ffb9355840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be6150ab0e143a776d224c763df3b63c, https://si.imgix.net/c802c172/uploads/origins/1b9867f6-2c59-40b8-a2c4-a5ffb9355840?bg=%23fff&auto=format%2Ccompress&fm=w