2c77/uploads/origins/7893db09-bc44-4991-836d-b82c9d0168ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec1bde5f061c5b2adf361e359e61cd7b 3x"}, "body": "千早さん、こんにちは\n\n私のキャラクターを描いてくださるとのこと、ありがとうございます。着物やテキスタイルのイラストがお好きとのことで、興味津々です。どんな作品を描かれるのか、とても楽しみです。私は日本の伝統的なファッションや衣装が大好きなので、大正時代の衣装でキャラクターを描いていただけませんか？(私の過去のリクエストの中には、着物や浴衣姿などもありましたので、もしよろしければ参考にしてください)ゼノスが洋装なのに対して、私のキャラクターは着物や袴など東洋的な服装にしてほしいです。もしよろしければ、ポーズと背景も決めていただきたいです。二人はカップルで、お互いを心から愛し合っています。性格は優しく穏やかでソフトですが、人見知りするところがあります。どんな作品が出来上がるか楽しみにしています。\n\nビビ: https://imgur.com/a/8Cm6kwO\nゼノス: https://imgur.com/a/a90xKFw", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ChisayaMatsuhisa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2936657, "client_id": 3010956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7f9a6d3/uploads/origins/108b83e7-e1c1-46b0-a10c-0f1ec79497af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71d3bc90af267e75b863cbf0ae710dd2", "srcset": "https://si.imgix.net/a7f9a6d3/uploads/origins/108b83e7-e1c1-46b0-a10c-0f1ec79497af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71d3bc90af267e75b863cbf0ae710dd2, https://si.imgix.net/a7f9a6d3/uploads/origins/108b83e7-e1c1-46b0-a10c-0f1ec79497af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5094e7b9536e4dae17a9bc22c27651d 2x, https://si.imgix.net/a7f9a6d3/uploads/origins/108b83e7-e1c1-46b0-a10c-0f1ec79497af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc04bf2b8b36dcfd5c6d0814902e2c36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7f9a6d3/uploads/origins/108b83e7-e1c1-46b0-a10c-0f1ec79497af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8b172b7733d452f