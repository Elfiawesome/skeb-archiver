01\u79c1\u304c\u3042\u3093\u305f\u3089\u306e\u70ba\u306b\u50cd\u304f\u3068\u601d\u3063\u3066\u308b\u306e\uff1f\u300d\u300c\u304d\u3083\u3001\u306a\u3001\u4f55\u3059\u3093\u306e\uff01\u300d\n4.\u201d\u306b\u9752\u3056\u3081\u305f\u3001\u30bb\u306f\n\u54e11\u3001\u3042\u3056\u308f\u3089\u3046\u3088\u3046\u306b\u85ac\u306e\u8aac\u660e\n\u30a2\u300c\u306f\u3001\u306f\u3041\u301c\uff1f\u305d\u3093\u306a\u85ac\u3042\u308b\u308f\u3051\u300d\n\u304a\u8179\u304c\u9cf4\u308b\n5.\u201d\u3068\u6ce3\u304d\u305d\u3046\u306a\u3001\u30bb\u306f\n\u30a2\u300c\u3042\u3063\u3084\u3070\u3044\u3001\u3067\u308b\uff01\uff1f\u3044\u3084\u3060\u3053\u3093\u306a\u6240\u3067\u7d42\u308f\u308a\u305f\u304f\u7121\u3044\uff01\u8ab0\u304b\u52a9\u3051\u3001\u300d\n6.\u201d\u306b\u30a2\u306e\u5c3b\u304b\u3089\u4eba\u683c\u30bc\u30ea\u30fc\u304c\u51fa\u3066\u5730\u9762\u306b\u305f\u308c\u308b\u3001\u8868\u60c5\u306f\u30a2\u30d8\u9854\u30bb\u306f\n\u30a2\u300c\u304a\u307b\u301c\u2764\ufe0f\u3042\u305f\u3057\u304c\u3067\u3066\u30a4\u30c3\u3061\u3083\u3046\u301c\u2764\ufe0f\u2764\ufe0f\u300d\n7.\u201d\u306b\u4eba\u683c\u30bc\u30ea\u30fc\u304c\u5730\u9762\u306b\u843d\u3061\u5207\u3063\u3066\u3042\u301c\u3063\u3066\u865a\u308d\u306a\u76ee\u306b\u306a\u308a\u5929\u4f7f\u306e\u8f2a\u304c\u7121\u304f\u306a\u308b\u3001\u30bc\u30ea\u30fc\u304b\u3089\u306f\u301c\u301c\uff01\u307f\u305f\u3044\u306a\u5439\u304d\u51fa\u3057\u304c\u51fa\u3066\u3044\u308b\u3001\u30bb\u306f\n\u54e11\u300c\u3078\u3078\u3001\u5973\u306e\u4eba\u751f\u304c\u7d42\u308f\u308b\u77ac\u9593\u306f\u3044\u3064\u898b\u3066\u3082\u697d\u3057\u3044\u305c\u3001\u304a\u3063\u8f2a\u304c\u306a\u304f\u306a\u3063\u305f\u300d\n\u54e12\u300c\u3042\u3068\u306fDr.\u30ad\u30e2\u30fc\u30a4\u69d8\u306b\u4efb\u305b\u308b\u3068\u3059\u308b\u304b\u3001\u3078\u3078\u3069\u3046\u306a\u308b\u304b\u697d\u3057\u307f\u3060\u305c\u300d\n8.\u5916\u898b\u306f\u3079\u3093\u304d\u6226\u95d8\u54e1\u8a66\u4f5cA\u578b\u3092\u30d9\u30fc\u30b9\u306b\u4eba\u683c\u30bc\u30ea\u30fc\