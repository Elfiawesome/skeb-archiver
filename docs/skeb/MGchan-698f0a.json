め（B程度）\n・表情：恥ずかしさ全開で、顔を鬱向けて目を逸らしている。\n・下着：ピンク色/参考画像の2番のようなデザインでお願いします。クロッチは別色にして頂けると幸いです。\n\n以上になります。\nご検討頂けますと幸いです\n何卒、よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1WdazILsU10ZDFSGi5A-zGHiPd7qPvz8N", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MGchan/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3185736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbe19c95/uploads/origins/aca8f9b9-2912-4b8d-8777-c9810b23c70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=798f717d5821026e97d5347e1132c3dd", "srcset": "https://si.imgix.net/fbe19c95/uploads/origins/aca8f9b9-2912-4b8d-8777-c9810b23c70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=798f717d5821026e97d5347e1132c3dd, https://si.imgix.net/fbe19c95/uploads/origins/aca8f9b9-2912-4b8d-8777-c9810b23c70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3994478f4d10eb6d54937c49c52781d7 2x, https://si.imgix.net/fbe19c95/uploads/origins/aca8f9b9-2912-4b8d-8777-c9810b23c70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=321a2831c411961859aa0efaf9dd11de 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbe19c95/uploads/origins/aca8f9b9-2912-4b8d-8777-c9810b23c70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03ee8402189871e225e0efa153afff8b", "srcset": "https://si.imgix.net/fbe19c95/uploads/origins/aca8f9b9-2912-4b8d-8777-c9810b23c70d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03ee8402189871e225e0efa153afff8b, https://si.imgix.net/fbe19c95/uploads/origins/aca8f9b9-2912-4b8d-8777-c9810b23c70d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2cda0e4db5c2582a0ee033e506f34c68 2x, htt