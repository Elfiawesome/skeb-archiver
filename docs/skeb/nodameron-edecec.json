PCデスクトップ壁紙\n・グッズ制作（個人観賞のみ）\n\n\n\n・納品形式は可能であれば…人物・背景・小物（←もしあれば）を分けたpsdデータもしくは透過画像での納品だと大変助かります。\n\n\n何卒、ご検討のほど宜しくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cfvn5759b/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3903001, "client_id": 3895868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9e9c-2da5cdf6f1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0a0b4a433501c4113026070a218ec32", "srcset": "https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9e9c-2da5cdf6f1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0a0b4a433501c4113026070a218ec32, https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9e9c-2da5cdf6f1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=010a39668a5841cab872969c2ea1f544 2x, https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9e9c-2da5cdf6f1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55c18f5d0e2ff52b505282ddad1a306d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9e9c-2da5cdf6f1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15135e242e2e902f02b5f75a6ac46d53", "srcset": "https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9e9c-2da5cdf6f1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15135e242e2e902f02b5f75a6ac46d53, https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9e9c-2da5cdf6f1a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44b69f91d39768294f3057045b52d83d 2x, https://si.imgix.net/484c632c/uploads/origins/06748041-73f1-45bf-9