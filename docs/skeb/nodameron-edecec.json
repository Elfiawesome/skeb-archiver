ため、頭部や髪の毛、腕などが見切れていないと嬉しいです！（←構図的に椅子などで隠れたりする場合、気にしないでください！）\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル・配信バナー・動画\n・SNSのアイコン、ヘッダー、投稿等\n・PCデスクトップ壁紙\n・グッズ制作（個人観賞のみ）\n\n\n\n・納品形式は可能であれば…人物・背景・小物（←もしあれば）を分けたpsdデータもしくは透過画像での納品だと大変助かります。\n\n\n何卒、ご検討のほど宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arabikicoffee/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3912227, "client_id": 3895868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa62a950/uploads/origins/0e3d3e44-6e33-4a5e-aa55-33f08265027c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1557e75357853e7f3afcd1797832d7a", "srcset": "https://si.imgix.net/fa62a950/uploads/origins/0e3d3e44-6e33-4a5e-aa55-33f08265027c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1557e75357853e7f3afcd1797832d7a, https://si.imgix.net/fa62a950/uploads/origins/0e3d3e44-6e33-4a5e-aa55-33f08265027c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8391b58f5c4abac121ff0a457bb5bfa3 2x, https://si.imgix.net/fa62a950/uploads/origins/0e3d3e44-6e33-4a5e-aa55-33f08265027c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54fb9e33de03e0dd641755d269a9dbd7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa62a950/uploads/origins/0e3d3e44-6e33-4a5e-aa55-33f08265027c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f558d9f861e9c264aec04cccff9b3f9c", "srcset": "https://si.imgix.net/fa62a950/uploads/origins/0e3d3e44-6e33-4a5e-aa55-33f08265027c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f558d9f861e9c264aec04cccff9b3f9c, https://si.imgix.net/fa62a950/uploads/origins/0e3d3e44-6e33-4a5e-aa55-33f08265027c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&