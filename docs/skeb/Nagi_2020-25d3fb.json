.net/36383e2e/uploads/origins/15fbee88-0ce3-44c2-a3c1-85e208a2aae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7adaefd5ca81818144adebe0b4241c97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36383e2e/uploads/origins/15fbee88-0ce3-44c2-a3c1-85e208a2aae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab01dfb23ef249a9d52f4189b8c29168", "srcset": "https://si.imgix.net/36383e2e/uploads/origins/15fbee88-0ce3-44c2-a3c1-85e208a2aae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab01dfb23ef249a9d52f4189b8c29168, https://si.imgix.net/36383e2e/uploads/origins/15fbee88-0ce3-44c2-a3c1-85e208a2aae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f379e5235a838a1b35808ade06b13dd8 2x, https://si.imgix.net/36383e2e/uploads/origins/15fbee88-0ce3-44c2-a3c1-85e208a2aae1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=002e4aa78e521698a24f497ae40e07ee 3x"}, "body": "はじめまして。\nMk12 Mod.H風の銃を持った女の子の絵をご依頼させていただきたく思います。\n\n以下参考画像になります。\nhttps://www.dropbox.com/sh/j3pqf5tbchjbgdt/AABuekH1OdiS3FvPQ8kmT2Yua?dl=0\n\nキャラクターのイメージにつきましては「キャラ01～03」の感じです。\n髪の色は分かりづらいかと思いますが、カラーコードだと#e2dbd1のあたりです。\n（顔の書き方などは元デザインに寄せず、叢島様の感じで描いたいただいて大丈夫です！）\n\n服装については「キャラ03」の「服装イメージ」欄がサイズ感などの参考になります。\n服装のデザインに関しましては、別途添付されているTシャツの画像（黒地のシャツ）のデザインを、オーバーサイズで着ている感じで描いていただけると嬉しいです。\n\nポージングはお任せいたします。\n\nまた、銃のセットアップは「銃01/02」の画像を参照していただきたく思います。\n迷彩塗装が施されていますが、柄を絵で再現するのが難しかった場合、タンカラーベタ塗りor単純なグラデーションで迷彩風にするのみでも大丈夫です。\nまた構図次第でである程度銃に角度が付いてしまうような場合は、参考程度に「銃角度参考～」という画像群を添付いたしますのでそちらをご使用ください。\n（「銃角度参考～」の画像は古いセットアップなので、重ねてになりますが銃のセットアップは「銃01/02」の方を参考にお願いします！）\n\n納品に際してですが、PCの壁紙などで使用したい為、可能なかぎり大きな解像度（ピクセル数）で納品していただけると大変助かります。\nまたその際には、レイヤーを統合したPSDで最終データをいただけると大変助かります。（わからない場合、PNGorJPGでも大丈夫です）\n\n何卒宜しくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_s