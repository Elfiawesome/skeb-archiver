uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46daffb7/uploads/origins/6d7b2bcc-2212-46b5-a1ee-3f87733710a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=478fada0fc4bcf3cf4517c3714b39e10", "srcset": "https://si.imgix.net/46daffb7/uploads/origins/6d7b2bcc-2212-46b5-a1ee-3f87733710a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=478fada0fc4bcf3cf4517c3714b39e10, https://si.imgix.net/46daffb7/uploads/origins/6d7b2bcc-2212-46b5-a1ee-3f87733710a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcd18dd9cdfe6113ef55a8b8be2c7da2 2x, https://si.imgix.net/46daffb7/uploads/origins/6d7b2bcc-2212-46b5-a1ee-3f87733710a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=976d7a7b976921e6b8075ceb9afe22a2 3x"}, "body": "あろ様\n\nはじめまして！\n個人VTuberのねむこぴあと申します。\n\nあろ様のイラストが本当に大好きでして、募集の再開を心待ちにしておりました…！！\nぜひ私、ねむこぴあのイラストを描いていただきたくリクエストさせていただきました！\n\n【依頼内容】\n衣装変更は無し、構図などはお任せでお願いいたします。\n可能であればで構いませんので、猫耳や顔周りの髪などが見切れていない、背景等とレイヤー分けした人物のみのデータもいただけると大変助かります。\n\n【使用用途】\n・YouTubeのサムネイルや配信、動画\n・SNSでの投稿、告知、アイコンやヘッダーなど\n・ファンクラブでの投稿\n\n【キャラクター資料】\nhttps://x.com/taidaneko_zzz/status/1930367251435401311?s=46&t=u99A6Qoqr1_GxZDEvpp2HQ\n人間の耳はありません。\n怠惰でマイペースな引きこもりの白猫です。\n立ち耳・伏せ耳の差分がございますので、お好きな方で描いていただけますと嬉しいです。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://x.com/taidaneko_zzz/status/1930367251435401311?s=46&t=u99A6Qoqr1_GxZDEvpp2HQ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ARoHa252538/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2949721, "client_id": 810575, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/180b3be7/uploads/origins/5f828712-d88b-4ef1-a23e-b88f897af33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99aef83f8ff391