 "はじめまして、個人Vtuberの大海原つつむと申します。\nskebでお見かけして、とても素敵なイラストだと思ってフォロー＆リクエスト再開を待っておりました…！\nぜひご検討いただけますと幸いです。\n\n【使用用途】\n各種SNSへの掲載（X,Youtubeサムネイル,shorts動画等）\nグッズ等には使用しません\n\n【依頼内容】\n大海原つつむの一枚絵\n構図やポーズはお任せいたしますが、\n頭や髪の毛が見切れていないと嬉しいです。\n背景がある場合は、透過されたデータもいただけますと幸いです。\n\n大海原つつむについて\n海辺にある小さな喫茶店「はしっこ」の店員。\nコーヒーを入れたり料理などはできず、お掃除やお給仕だけをしている。\n\n難しい内容や金額不足等ございましたら再送していただけますと幸いです。\nご検討のほど何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1EWkdeubeIP62Sw_OOBk3cRMXLN768_bw?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ARoHa252538/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2949721, "client_id": 3664380, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59a4c1bb/uploads/origins/91a7712d-1502-412b-87aa-45fb3bdf8ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b1dc3d7b02664803614e73887f792a", "srcset": "https://si.imgix.net/59a4c1bb/uploads/origins/91a7712d-1502-412b-87aa-45fb3bdf8ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b1dc3d7b02664803614e73887f792a, https://si.imgix.net/59a4c1bb/uploads/origins/91a7712d-1502-412b-87aa-45fb3bdf8ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fda6b9d63dcc78703a5e8fe8ac08374 2x, https://si.imgix.net/59a4c1bb/uploads/origins/91a7712d-1502-412b-87aa-45fb3bdf8ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0336d56f9aa988f760cb89682f5ba944 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59a4c1bb/uploads/origins/91a7712d-1502-412b-87aa-45fb3bdf8ecb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adecd72563ff7f509df10fac61dc5638", "srcset": "https://si.imgix.net/59a4c1bb/uploads/origins/91a7712d-1502-412b-87aa-45fb3bdf8ecb?bg=%23fff&auto=format%2Ccompr