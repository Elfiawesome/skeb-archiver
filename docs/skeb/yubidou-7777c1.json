=crop&crop=top&w=200&h=200&s=5bc03d2a5031a8c91c2246a3eccc5fbd, https://si.imgix.net/3a01b319/uploads/origins/1789ea9d-3b05-4f5b-a10b-266df99b0fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d74a4ef7bfa22fad4059637e3a1f50ac 2x, https://si.imgix.net/3a01b319/uploads/origins/1789ea9d-3b05-4f5b-a10b-266df99b0fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=282c9f1761d0ea55fd12cc94f490b8c1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a01b319/uploads/origins/1789ea9d-3b05-4f5b-a10b-266df99b0fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c80aa19cc21cf80485c36860ffeb4e9f", "srcset": "https://si.imgix.net/3a01b319/uploads/origins/1789ea9d-3b05-4f5b-a10b-266df99b0fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c80aa19cc21cf80485c36860ffeb4e9f, https://si.imgix.net/3a01b319/uploads/origins/1789ea9d-3b05-4f5b-a10b-266df99b0fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5eeb70b3edec91738d618d1863db1d8 2x, https://si.imgix.net/3a01b319/uploads/origins/1789ea9d-3b05-4f5b-a10b-266df99b0fe1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2117315a012f8b01cec82684a6619b1 3x"}, "body": "あなたの作風で私のオリジナルキャラクターのイラストを依頼したいと思っています。スーパーロボット大戦OGシリーズのキャラクターのように描いていただけませんか？エクセレン・ブラウニングの衣装を基にした服装で、スナイパータイプのキャラクターにふさわしいと思われるものを着せていただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1SfRNIIQjd9gZwm6tlC98X42X4kjR6Mls?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yubidou/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3470625, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc54b03fb1486fa1380b2b170f8a3d7", "srcset": "https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cc54b03fb1486fa1380b2b170f8a3d7, https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fe6f6252351162abdbafed9cb8b5a77 2x, https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3d2b0a86e442b38cceb565572cdf5c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c7809148e5205288632828e4b21b4b1", "srcset": "https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c7809148e5205288632828e4b21b4b1, https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cecd1c15b134241187bfbeaffb13e50 2x, https://si.imgix.net/fb15f21d/uploads/origins/4f62c7bb-86f7-49c1-bdae-dcb7cbc9c1b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12e94d28e38484d74418b7b2d5deff57 3x"}, "body": "UDOさん、いつもお世話になります。先日は素敵アルダンさんをありがとうございました！\n今回、ウマ娘×FGOシリーズを頼めるお方として、再びリピート依頼をさせて頂ければと存じます！\nよろしければ、「ウマ娘のワンダーアキュートにFGOの不夜城のキャスターのコスプレ」したイラストをお願いできるでしょうか。\n\n・衣装参考：不夜城のキャスター（※一応ゲームのネタバレ注意です）\nhttps://appmedia.jp/fategrandorder/75728107\n\n発端としては、アキュートさんのアプリ内のイベントにて、「ダートの語り部さんになる」とセリフがあり、そこから着想をこじつけたものになります。（いつもながら自分好みにこじつけて大変失礼します……ｗ）\n\nあくまでアキュートさん×不夜キャスさん概念が成立すればOKという状態でもあるので、衣装の再臨段階については第一から最終までどれもアリと思ってます。むしろ自分では選びきれてないくらいなのでお任せできれば幸い……とはいえ、正直最終再臨だとウマ娘のセンシティブ判定的に厳しい気がするため、UDOさんにリスクが発生しない程度に、無理のない再臨段階を選んで頂ければ十分です……ｗ\nまた、もし第一再臨を選んで下さった場合、口の布をつけてくださるのは大歓迎になりますが、外してお顔も拝める差分も頂ければ幸いです！（あくまでメインは顔出しを希望ですが、正直口布タイプも見たいと言えば見たいので……！！！！）\nアレンジといえば、もちろん今回も差分でメガネをつけて頂く分には構いません！！ｗ\n\n表情や構図・ポーズついては、今回もUDOさんの思うイメージで、「ワンダーアキュート」としての振る舞いやリアクション描いて頂ければと思います！　あくまで本人の気持ちのままのリアクションを取って貰う形が望ましいので、無理に肌を褐色にするなどまでしてなりきりに徹する必要まではないです。（なりきるよりは、よく分かってないまま渡されて着て戸惑う感じとかの方が好きですｗ）\n今回もコスプレ（衣装）がメインなので、なるべくならで十分ですが、衣装姿を堪能できる構図で描いて頂ければ嬉しく思います！\n\nまた無茶なご依頼となりますが、UDOさんのディティールに負けない描き込み力と、明るく可愛い描き味、そしてメガネ愛！！（爆）を期待して、今回もよろしくお願いできればと存じます！\n\nhttps://skeb.jp/@sasakamakue/works/53", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yubidou/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3470625, "client_id": 156034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80489fc954a5ff5e4a37967eacc99a8c", "srcset": "https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80489fc954a5ff5e4a37967eacc99a8c, https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b49cd6aaeb4c8d5e50061d19185a1c93 2x, https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=383640264bb2065fcb150f475fce5f1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1ff827aee9624def38b47cfef7e7e4b", "srcset": "https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1ff827aee9624def38b47cfef7e7e4b, https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3831cc5f9b3de11e80f08fc207cf5726 2x, https://si.imgix.net/502c2d7b/uploads/origins/519b183e-5f4a-4aa1-b481-9c56d85ba2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5f7b1f3a0b377637dde14eb8ea2fcd7 3x"}, "body": "メタルサーガというゲームで作成したパーティーキャラについてイラストを\nお願いできますでしょうか。\n\n\n外見および衣装サンプル\nhttps://imgur.com/a/HaR2vBb\n\n\n元絵というものが存在せず、またゲーム自体デフォルメの効いているデザインのため、\n頭身やデザイン等については特徴さえ押さえて頂ければ描き慣れたバランスのもので\n構いません。\n※一応、ゲーム内のキャラメイキング素材としては大人の体型を使用しています\n\n・構図についてはお任せ致します。\n銃器を扱う人物ではありましたが、あまり活発に動き回るようなキャラクターではないので、\n木箱かなにかの上に座る、棍棒代わりに銃器を雑に担ぐ等でも構いません。\n武器自体頻繁に持ち替えておりましたので、サンプルの中で描き易いものを選んで頂ければ幸いです。\n\n・着せ替えが醍醐味であったためいくつか衣装くサンプルを用意致しましたが、固定の衣装はなく\nこちらも描き易いものを選択、ならびに描き易く変更して頂いて構いません。\n手持ちの武器についても同様の扱いで構いません。持たせるかどうかも含めてお任せします。\n\n・背景についてもお任せします。\n（荒廃した世界という舞台設定上、荒れ地や廃墟を背にする機会は多かったです）\n\n・人物像としては『受け答えと見た目だけは大人しい蛮族』です。\n基本的に判断に困ったら筋力と火力で解決するはた迷惑な人物と思って頂ければ幸いです。\n\n\nサービスの終了したゲームではありますが相応に思い入れがあり依頼したく思いました。\nご検討頂けると幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yubidou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3470625, "client_id": 80604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ca4dd89/uploads/origins/65c7d9ff-cad2-4faf-9ebc-941453bd433f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdabeb8157f982940545fb3a00170128", "srcset": "https://si.imgix.net/4ca4dd89/uploads/origins/65c7d9ff-cad2-