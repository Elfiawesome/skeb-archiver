23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=273a14aabb4c66596e0edc2616f81ebe", "srcset": "https://si.imgix.net/661fcb69/uploads/origins/7174c336-1978-4e85-b9e8-c21fc8f2c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=273a14aabb4c66596e0edc2616f81ebe, https://si.imgix.net/661fcb69/uploads/origins/7174c336-1978-4e85-b9e8-c21fc8f2c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23322cb2e2c4244dbe6a34876458b421 2x, https://si.imgix.net/661fcb69/uploads/origins/7174c336-1978-4e85-b9e8-c21fc8f2c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a089c6e6c3c3405b5efc74fe39f08ce4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/661fcb69/uploads/origins/7174c336-1978-4e85-b9e8-c21fc8f2c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cea4163d7337cdc3e27eeba19350936", "srcset": "https://si.imgix.net/661fcb69/uploads/origins/7174c336-1978-4e85-b9e8-c21fc8f2c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cea4163d7337cdc3e27eeba19350936, https://si.imgix.net/661fcb69/uploads/origins/7174c336-1978-4e85-b9e8-c21fc8f2c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5468d0e72a7d5e2238b7dc73fa66d2c3 2x, https://si.imgix.net/661fcb69/uploads/origins/7174c336-1978-4e85-b9e8-c21fc8f2c20c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a40307ce716b92b32be668db5061a47e 3x"}, "body": "初めましてUDOさん。\n本当にたまたま新着クリエイターでお見かけさせて頂きました所、UDOさんがウマ娘とFGOの両ジャンルがお分かりになりる方とお見受けしましたため、よろしければ「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」したイラストをお願いできるでしょうか。\n\n・衣装参考：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯として、ゲーム内のイベントにてアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。また彼女の勝負服が黒ベースにグリーンをあしらう、丑御前（＝源頼光）を彷彿するカラーリングだったり、身を削る固有スキルと宝具同士……などなど、こじつけるに足る理由に個人的に盛り上がってしまったためです……。\n両ジャンルを分かる人でなければ厳しいという理由からご依頼させて頂くため、キャラや衣装がUDOさんの好みとは異なっていましたら大変恐縮ですが、衣装の細かい装飾まで描き込めるお方だとお見受けしたこともあり、FGOの装飾ゴテゴテな衣装もお任せできるならばと思った次第ですｗ\n\n表情や構図・ポーズついては、UDOさんが思うアルダンさんのイメージのまま描いて頂けましたらOKです。あくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（……というか丑御前なりきられると、アルダンさんが暗く病んじゃう感じになり、それは本意ではないので……ｗ）\nお茶目だったりお淑やかだったり、時々カッコつけたがったり等、UDOさんの解釈するアルダンさんの「らしい」振る舞いとリアクション描いて頂ければと思います！　一応、コスプレ（衣装）がメインなので、なるべくなら全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います……！\nまた、メガネっ子が大好きとのことですので、もしモチベに繋がるならば、差分でメガネをつけて頂く分には構いませんｗ（あくまで基本はメガネなし、という方針ではございますがｗ）\n\nジャンルが分かる、という動機での依頼のため、キャラや衣装はワガママをお願いしているのは承知ですが、それでもよろしければ何卒お願いいたします！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 88659, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "R.シュタットフェルド/Ryuno Stadtfeld ☆Skeb募集中", "screen_name": "ryuno_stadtfeld", "avatar_url": "https://pbs.twimg.com/profile_images/1841667279777628164/5muhUAA4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/127416968/1773754224/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}, {"id": 118230, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "キユー", "screen_name": "KIYU_queue", "avatar_url": "https://pbs.twimg.com/profile_images/1992938738151030784/7XaOegQW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/30816721/1595238661/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}]