xIOgRwVidr0hy-qtQjsg&s=19\n\n　イラストは、元気いっぱいな様子の未夜ちゃんを描いていただきたいです。ポーズ指定は無いのでおまかせいたします！服装もおまかせいたします！\n　背景は電子的な雰囲気で未夜ちゃんの内部メカの図解が断片的に映っているような感じでお願いいたします(内部メカに関しましては一応は上記の資料を参考にしていただければ幸いですがUDOさん独自のアレンジをしていただいても大丈夫です)。\n\n　また、UDOさんといえば眼鏡とお聞きいたしましたので未夜ちゃんの眼鏡の有り無し差分があると嬉しいです！\n　眼鏡有り差分の眼鏡の種類はおまかせいたします…！(未夜ちゃんに似合いそうな眼鏡をチョイスしていただければ…！)\n\n以上になります。リクエストを受けていただけましたら、よろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yubidou/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3470625, "client_id": 1093664, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77e7012c/uploads/origins/9e6ab9cf-6e1f-441e-9d53-a17f68390436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311cc2210e7d0e83983d27e39b4a8cfa", "srcset": "https://si.imgix.net/77e7012c/uploads/origins/9e6ab9cf-6e1f-441e-9d53-a17f68390436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311cc2210e7d0e83983d27e39b4a8cfa, https://si.imgix.net/77e7012c/uploads/origins/9e6ab9cf-6e1f-441e-9d53-a17f68390436?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74740eb6c64ddeeac7144b1733fea07d 2x, https://si.imgix.net/77e7012c/uploads/origins/9e6ab9cf-6e1f-441e-9d53-a17f68390436?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bf897137547923e97283f5c4dd59353 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77e7012c/uploads/origins/9e6ab9cf-6e1f-441e-9d53-a17f68390436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a53a554f565f543026becb4a535a430", "srcset": "https://si.imgix.net/77e7012c/uploads/origins/9e6ab9cf-6e1f-441e-9d53-a17f68390436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a53a554f565f543026becb4a535a430, https://si.imgix.net/77e70