body": "\u304b\u3044\u3048\u69d8\u3000\u306f\u3058\u3081\u307e\u3057\u3066\uff01\n\u500b\u4ebaVtuber\u306e \u6dbc\u96f2(\u3059\u305a\u304f\u3082) \u3055\u304f \u3068\u7533\u3057\u307e\u3059\u3002\n\n\u304b\u3044\u3048\u69d8\u306e\u4f5c\u54c1\u3084pixiv\u306e\u30a4\u30e9\u30b9\u30c8\u898b\u3066\u4f9d\u983c\u3057\u305f\u304f\u8003\u3048\u307e\u3057\u305f\uff01\n\u4e0b\u8a18\u4f9d\u983c\u5185\u5bb9\u306b\u3082\u3042\u308a\u307e\u3059\u304c\u3001\u8af8\u3005\u304a\u4efb\u305b\u3067\u4f9d\u983c\u3055\u305b\u3066\u9802\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\uff01\n\u3054\u691c\u8a0e\u306e\u7a0b\u4f55\u5352\u5b9c\u3057\u304f\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\u3002\n\n\u3007\u4f9d\u983c\u5185\u5bb9\n\u30fb\u79c1\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u3067\u3059\uff08\u3067\u304d\u308c\u3070\u8eab\u4f53\u306e\u5927\u90e8\u5206\u304c\u5165\u3063\u3066\u3044\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\uff09\n\u30fb\u80cc\u666f\u306a\u3069\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u3001\u81ea\u5206\u3068\u30ec\u30a4\u30e4\u30fc\u5206\u3051\u3055\u308c\u3066\u3044\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\n\u30fb\u30b5\u30a4\u30ba\u6307\u5b9a\u306f\u306a\u304f\u3001\u30ec\u30a4\u30e4\u30fc\u5206\u3051\u3055\u308c\u305fpsd\u30d5\u30a1\u30a4\u30eb\u53c8\u306fpng\u30d5\u30a1\u30a4\u30eb\u304c\u597d\u307e\u3057\u3044\u3067\u3059\n\u30fb\u80cc\u666f\u3001\u8868\u60c5\u3001\u69cb\u56f3\u7b49\u3005\u304a\u4efb\u305b\u3067\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\n\n\u25cb\u81ea\u5df1\u8aac\u660e\n\u30fb\u9b42(\u4e2d\u8eab)\u306f\u7537\u6027\u3067\u3059\u304c\u3001\u6dbc\u96f2\u3055\u304f\u81ea\u4f53\u306e\u6027\u5225\u306f\u4e0d\u8a73\u3068\u3057\u3066\u304a\u308a\u307e\u3059\n\u3000\u7537\u5973\u3069\u3061\u3089\u306b\u5bc4\u305b\u308b\u304b\u5426\u304b\u3001\u80f8\u306e\u6709\u7121\u3082\u4e00\u4efb\u81f4\u3057\u307e\u3059\n\u30fb\u5206\u304b\u308a\u306b\u304f\u304f\u6050\u7e2e\u3067\u3059\u304c\u3001\u53f3\u76ee\u304c\u7dd1\u3001\u5de6\u76ee\u304c\u9752\u306b\u8fd1\u3044\u8272\u306e\u30aa\u30c3\u30c9\u30a2\u30a4\u3068\u306a\u3063\u3066\u304a\u308a\u307e\u3059\n\u30fb\u53c2\u8003\u307e\u3067\u306b\u30a4\u30f3\u30ca\u30fc\u306f\u30ce\u30fc\u30b9\u30ea\u30fc\u30d6\u53c8\u306f\u534a\u8896\u306e\u30cf\u30a4\u30cd\u30c3\u30af\u30bb\u30fc\u30bf\u30fc(\u8584\u624b)\u3068\u3057\u3066\u3044\u307e\u3059\n\u4e0b\u534a\u8eab\u306e\u30bf\u30a4\u30c4\u5730\u306e\u90e8\u5206\u306f\u30bf\u30a4\u30c4\u3067\u3082\u30ec\u30ae\u30f3\u30b9\u3067\u3082\u30cf\u30a4\u30bd\u30c3\u30af\u30b9\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\u3001\u3069\u306e\u5c65\u7269\u3067\u3082\u5168\u3066\u79c1\u3067\u3059\n\u30fb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u6027\u3068\u3057\u3066\u306f\u63b4\u307f\u3069\u3053\u308d\u306e\u306a\u3044\u5909\u308f\u308a\u8005\u3067\u3042\u308a\u305f\u3044\u3001\u305d\u3093\u306a\u751f\u304d\u7269\u3067\u3059\n\u30fb\u4e0b\u8a18\u30b0\u30fc\u30b0\u30eb\u30c9\u30e9\u30a4\u30d6\u3001\u30ea\u30c3\u30c8\u30ea\u30f3\u30af\u306eURL\u306b\u6b63\u9762\u306e\u307f\u3067\u306f\u3054\u3056\u3044\u307e\u3059\u304c\u3001\u5916\u89b3\u306e\u8cc7\u6599\u304c\u3042\u308a\u307e\u3059\n\n\u3007\u4f7f\u7528\u7528\u9014\n\u30fbVtuber\u6d3b\u52d5\u3067\u306e\u4f7f\u7528\uff08Twitter\u3001Youtube\u30b5\u30e0\u30cd\u30fb\u52d5\u753b\u3001\u914d\u4fe1\u7b49\uff09\n\u30fb\u305d\u306e\u4ed6\u5e83\u5831\u6d3b\u52d5\u306e\u70ba\u306e\u4f7f\u7528\n\u203b\u4e0a\u8a18\u7528\u9014\u306e\u305f\u3081\u4e00\u90e8\u5207\u308a\u629c\u304d\u30fb\u6587\u5b57\u5165\u308c\u30fb\u306a\u3058\u307e\u305b\u308b\u305f\u3081\u306e\u8efd\u5ea6\u306a\u8272\u5473\u52a0\u5de5\u3092\u884c\u3046\u53ef\u80fd\u6027\u304c\u3054\u3056\u3044\u307e\u3059\u3002\n\u203b\u4f7f\u7528\u7528\u9014\u306b\u3064\u3044\u3066NG\u306a\u3082\u306e\u304c\u3042\u308b\u5834\u5408\u3084\u3001\u4f7f\u7528\u4e0a\u900f\u304b\u3057\u3092\u5165\u308c\u308b\u5fc5\u8981\u304c\u3042\u308b\u306a\u3069\u6ce8\u610f\u4e8b\u9805\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u3001\n\u3000\u5927\u5909\u304a\u624b\u6570\u3092\u304a\u304b\u3051\u3057\u3066\u3057\u307e\u3044\u307e\u3059\u304c\u30ec\u30a4\u30e4\u30fc\u306b\u3054\u8a18\u8f09\u9802\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\u203b\u53ce\u76ca\u5316\u5f8c\u306e\u52d5\u753b\u30fb\u914d\u4fe1\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u7b49\u3067\u4f7f\u7528\u3059\u308b\u53ef\u80fd\u6027\u304c\u3054\u3056\u3044\u307e\u3059\n\u3000\uff08\u305a\u3063\u3068\u5148\u306e\u8a71\u3001\u3082\u3057\u304f\u306f\u6210\u3089\u306a\u3044\u304b\u3082\u3057\u308c\u306a\u3044\u8a71\u3067\u3059\u304c\u30fb\u30fb\u30fb\uff09\n\n\u9577\u6587\u5931\u793c\u81f4\u3057\u307e\u3059\n\u3054\u691c\u8a0e\u306e\u7a0b\u4f55\u5352\u5b9c\u3057\u304f\u304a\u9858\u3044\u81f4\u3057\u307e\u3059\n\nhttps://lit.link/SuzukumoSaku#\n\nhttps://drive.google.com/file/d/1JROyFTNbDd0v3nFOlhyRRlac5slmSfR2/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaie_5214/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3512587, "client_id": 3059214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c123e871832b54f3d5aea6055bdd3a2", "srcset": "https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c123e871832b54f3d5aea6055bdd3a2, https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90645163105c9a65e3fba62538bb8f97 2x, https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70c7d9fe3412cf7ab4557e10f988503b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13464fa8394c670997e26e625c6ce1e6", "srcset": "https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13464fa8394c670997e26e625c6ce1e6, https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=774edb130fd81fbfb7a9f32392db9b6c 2x, https://si.imgix.net/4e6560b8/uploads/origins/f6ed5199-c8ea-411a-863f-bf18d2ba4aa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56b00c15c7ad27b43bb61bf208dd2825 3x"}, "body": "\u304b\u3044\u3048\u69d8\u3001\u306f\u3058\u3081\u307e\u3057\u3066\u3002\n\u500b\u4ebaVTuber(\u6e96\u5099\u4e2d)\u306e\u7d3a\u767d\uff08\u3053\u306f\u304f\uff09\u3068\u7533\u3057\u307e\u3059\u3002\n\n\u3053\u306e\u5ea6\u304b\u3044\u3048\u69d8\u306eTwitter(X)\u3067\u6295\u7a3f\u3055\u308c\u3066\u3044\u308b\n\u30a4\u30e9\u30b9\u30c8\u306e\u6570\u3005\u3092\u62dd\u898b\u3057\u3001\u52d5\u304d\u306e\u3042\u308b\u30dd\u30fc\u30ba\u306e\u30d0\u30ea\u30a8\u30fc\u30b7\u30e7\u30f3\u304c\u8c4a\u304b\u3067\u3001\u751f\u304d\u751f\u304d\u3068\u3057\u305f\u8868\u73fe\u304c\u672c\u5f53\u306b\u7d20\u6575\u3060\u3068\u611f\u3058\u3001\u305c\u3072\u79c1\u306e\u30a4\u30e9\u30b9\u30c8\u3082\u63cf\u3044\u3066\u9802\u304d\u305f\u304f\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\u25c8\u4f7f\u7528\u7528\u9014\n\u4e00\u822c\u7684Vtuber\u6d3b\u52d5\u3078\u306e\u4f7f\u7528\n\u30fbYouTube\u914d\u4fe1\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u30d8\u30c3\u30c0\u30fc\u3001Shorts\u52d5\u753b\u3078\u306e\u4f7f\u7528\n\u30fbX\u3067\u306e\u30a2\u30a4\u30b3\u30f3\u3084\u629