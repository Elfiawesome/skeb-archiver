fba03/uploads/origins/8160b7a4-620b-47de-8316-ddfc99a157e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0715b33890a0bd78c9d3771f906a3dfb 3x"}, "body": "ゆるして様\n\nいつも素敵な作品をありがとうございます。楽しく拝見させていただいております✨\n今回もしよろしければ、当方のOC女の大人時をお願いしたく思っております。\n\n・使用用途\n　個人鑑賞\n　SNSへのアップロード\n　キャラクターの参考資料への使用\n\n年代以外の指定は特にありません。イラストのNG等も特になく、どんな雰囲気のものでも大丈夫です(ギャグ〜なものからエログロ不穏まで本当になんでも大丈夫です)ので、ゆるして様の好きに描いていただけたらとても嬉しいです。\n\nまた、skebを利用するのは今回が初めてのため、至らぬ点がございましたら申し訳ございません。何かありましたら再送していただけますとありがたいです。\n\nご検討のほどよろしくお願いいたします🙇🏻\n\nhttps://drive.google.com/drive/folders/1nBogtHBGBy1kKhm-U8l3MEFD7ARIzqBl", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yurushite_2004/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3776071, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f24c07bc4f17f58afb02aadcd9d5ce2", "srcset": "https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f24c07bc4f17f58afb02aadcd9d5ce2, https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f3019b72147988bb38c0bc7e98c2e37 2x, https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7c45e25bef5134a75dec195fadd9958 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15a456650228dc2d1627581251289a7e", "srcset": "https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15a456650228dc2d1627581251289a7e, https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5660fe31dab04afe740118515182798 2x, https://si.imgix.net/9d4bc103/uploads/origins/b926f0c8-297a-462e-881a-4681244e54dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c0566ff1d6f50d1e0176fe588ffb70e 3x"}, "body": "ゆるして様、こんにちは！\n今回は、贖罪さんの新衣装でのイラストをリクエストさせていただきたいです！\n\n【使用用途】\n・PC用壁紙（横向きのキャンバスでお願いします）\n・もしよろしければ、先生ご自身の配信サムネイル等でもご自由にお使いください。\n\n【キャラクター】\n・贖罪さん（1人）\n・衣装：最近実装された「新衣装」\n\n【構図・雰囲気】\n・ちょっとだけヤンデレ感のある、ゾクッとするような「可愛いけど少し怖い雰囲気」でお願いしたいです。\n・構図の詳細はお任せいたします。\n\n【こだわりポイント】\n先生の描く瞳の表現が大好きです。特に赤い瞳が好きなので、もし可能であれば「赤い瞳の差分」をいただけると非常に嬉しいです。\n\n資料としてイメージに近い画像を添付いたしますが、あくまで参考ですので、先生の自由な解釈で描いていただければ幸いです。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://imgur.com/a/V3RxBDR", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yurushite_2004/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3776071, "client_id": 2679960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81372f83308100b8e1b9ed4f96241b90", "srcset": "https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81372f83308100b8e1b9ed4f96241b90, https://si.imgix.net/e47ce6ef/uploads/origins/c2d6e9a2-5f10-4c86-bd16-80301d94448c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=822ffc4e81b1b66de3c3ac5b3d4d3f81 2x, https://si.imgix.net/e4