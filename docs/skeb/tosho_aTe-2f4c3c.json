17317890%2FNYVXA1Ot.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df0ca7e8c99fdf0e237df155818279b9", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918508300817317890%2FNYVXA1Ot.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df0ca7e8c99fdf0e237df155818279b9, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918508300817317890%2FNYVXA1Ot.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b38a163513bbd6eca016c6724e276dfb 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918508300817317890%2FNYVXA1Ot.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd72c58ad0fe459572bbd5f7a11590d 3x"}, "body": "凍傷のエト様\n\nはじめまして。\n『うつつと空の放送』を拝聴し、その独特で繊細な音楽センスに強く惹かれ、今回思い切ってご連絡させていただきました。\n新曲もとても素敵でした……！！本当に好きです！！\n\nもし可能でしたら、\n儚く浮遊感のある音の中に、一滴の不穏さが紛れ込んだような曲調の楽曲を制作していただけないでしょうか。\n\n\n■ 使用範囲\n\n自作のフリーホラーミステリーゲームの\n\n・テーマソング（ゲームのオープニング・エンディングなどに使用）\n・ゲームの宣伝用動画\n\n上記用途で使用させていただきたいと考えております。\n\n\n\n■ 楽曲イメージ\n•\t謎が浮かび上がるような浮遊感\n•\tどこか後味の悪さが残る雰囲気\n\nゲームの題材にタイムリープの要素があるため、可能であれば時計の針を思わせる音などを取り入れていただけると、とても嬉しいです。\n\n\n■ ゲーム内容\n『ナーサリー・ヴェール』\nひょんなことから怪異事件の現場へとタイムリープし、事件の真相を追うことになった主人公・ミスミ。\n果たして彼は無事に真相へ辿り着くことができるのか。\nそして、他者との関わりの中でミスミはどのように変化していくのか——。\n※ホラー・鬱・残酷描写を含みます。\n\n\nなお、楽曲を使用させていただく際には、\nゲーム内クレジットおよび使用箇所にて必ず「凍傷のエト」様のお名前を明記いたします。\n\nご多忙のところ恐れ入りますが、\nご検討いただけましたら幸いです。\n\n何卒よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@tosho_aTe/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3297540, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1918508300817317890%2FNYVXA1Ot.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t