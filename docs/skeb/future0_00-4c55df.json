79dbb69b49eae8c2bb205b05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3339f30c/uploads/origins/d413a10b-6532-4c81-bfd0-0af384f5527c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cef6871004161a6637f663038e550706", "srcset": "https://si.imgix.net/3339f30c/uploads/origins/d413a10b-6532-4c81-bfd0-0af384f5527c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cef6871004161a6637f663038e550706, https://si.imgix.net/3339f30c/uploads/origins/d413a10b-6532-4c81-bfd0-0af384f5527c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ee843eb29c3a1e924a00db292473903 2x, https://si.imgix.net/3339f30c/uploads/origins/d413a10b-6532-4c81-bfd0-0af384f5527c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df8164391a4e07effaa11beadc37d660 3x"}, "body": "目玉様\n\n初めまして、とても可愛らしいイラストに心惹かれ前々からご依頼させていただける機会を伺っておりました。\nもし可能でしたら私の探索者の子ども時代の全身立ち絵をご依頼させていただけないでしょうか？\n金額、資料の不足などありましたらお手数ですがキャンセルまたは再送をしていただけたら嬉しいです。\n\n使用用途\n・TRPG(ジャンル：CoC6版）でのオンラインセッション\n・個人観賞用のグッズ製作（アクスタやポストカード、自分用のログ本での印刷）\n\n【依頼内容】\n資料のキャラクターの子ども時代の全身立ち絵。\n可能ならば喜怒哀楽の差分。\n幼少期はあまり恵まれた環境におらず、女の子のように髪の毛が伸びておりぼさぼさしています。\nできればポーズは体育座りだと嬉しいですがデザイン、服装などなど含めて好きなようにしていただければ嬉しいです。目玉様のデザインがとても素敵でしたので……！\n\nhttps://drive.google.com/drive/folders/1c5_bjZWtBISdT40C9wyQs-yq14JhBOT2?hl=ja", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@future0_00/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2674515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78fa3623/uploads/origins/007cc311-1b40-4975-abef-cd3ace2cf6d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7562a63c5747db40434e9fe86ffdb46a", "srcset": "https://si.imgix.net/78fa3623/uploads/origins/007cc311-1b40-497