・性格は明るい、子供っぽい、元気。\n・モテるためにVTuberをしている。\n・楽しいを共有するのが好き。\n・配信内容は主にゲーム実況(PCホラーゲーム、乙女ゲーム、Switchなど)。歌ってみたも投稿している。\n・お酒が好き。\n\n依頼詳細は以上になります。\n依頼内容に不備等ございましたら申し訳ございません…！\nお忙しいところ恐縮ですが、何卒よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1gDDI7dDozSGGwDo88x0NWYineZxEl8tP", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@agetanasu55/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2931125, "client_id": 949520, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bd93e76/uploads/origins/c50b2b23-bcd6-49c2-ba78-9a4b34d35449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1064ed732533b52efa67336e6f73d9bb", "srcset": "https://si.imgix.net/7bd93e76/uploads/origins/c50b2b23-bcd6-49c2-ba78-9a4b34d35449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1064ed732533b52efa67336e6f73d9bb, https://si.imgix.net/7bd93e76/uploads/origins/c50b2b23-bcd6-49c2-ba78-9a4b34d35449?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6649559fb942bf82835fb491afee7322 2x, https://si.imgix.net/7bd93e76/uploads/origins/c50b2b23-bcd6-49c2-ba78-9a4b34d35449?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=436859e71f7816b6a2682a087fbe971b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bd93e76/uploads/origins/c50b2b23-bcd6-49c2-ba78-9a4b34d35449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b035cc9b9f06ad00b631e8e4316df7b", "srcset": "https://si.imgix.net/7bd93e76/uploads/origins/c50b2b23-bcd6-49c2-ba78-9a4b34d35449?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b035cc9b9f06ad00b631e8e4316df7b, https://si.imgix.net/7bd93e76/uploads/origins/c50b2b23-bcd6-49c2-ba78-9a4b34d35449?bg=%23fff&auto=format%2Ccompress&fm=webp&dp