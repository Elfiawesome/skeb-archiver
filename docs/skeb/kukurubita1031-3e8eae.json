2b-4197-baab-2003518d8162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e9c216af157390ddea9a5075cfe19e5, https://si.imgix.net/7570ba01/uploads/origins/37434292-a42b-4197-baab-2003518d8162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46c1af754cfab872302a1628b18a5cc0 2x, https://si.imgix.net/7570ba01/uploads/origins/37434292-a42b-4197-baab-2003518d8162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9912aee02de718f9466c6ecb62d215d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7570ba01/uploads/origins/37434292-a42b-4197-baab-2003518d8162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5173e3a004b43a7098c801c4a0ccce08", "srcset": "https://si.imgix.net/7570ba01/uploads/origins/37434292-a42b-4197-baab-2003518d8162?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5173e3a004b43a7098c801c4a0ccce08, https://si.imgix.net/7570ba01/uploads/origins/37434292-a42b-4197-baab-2003518d8162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c74167cf4b9fd5faab18ea48a085cc95 2x, https://si.imgix.net/7570ba01/uploads/origins/37434292-a42b-4197-baab-2003518d8162?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d61763cf9a10380603e11328d6f93b69 3x"}, "body": "初めまして。\nSkeb新着でバイトターキー様のイラストを拝見し、線の力強いタッチと表情の描き方に惹かれリクエストさせていただきました。\nこの度は自身のOC二人組をお願いしたいです。\n\n【OC】\nA\n・20代半ばの青年の姿をした元人間の人外。\n・黒髪、赤目。眼帯(のようなもの)を装着。\n・にこやかで人当たりが良さそうな態度を取っているが、バレないよう裏で悪事を働いたり他人を騙すことに躊躇がないタイプ。\n\nB\n・20歳前後の青年の姿をした生まれつきの人外。\n・黒髪、赤目。長めのローポニーテール。\n・表情変化に乏しい。感情や思考は口頭で積極的に伝えるタイプ。\n\n二人は友人兼兄弟のような関係です。\n西洋風ファンタジー世界が舞台ですが、割と何でもありの世界観です。\n\n【資料】\nhttps://drive.google.com/drive/folders/1ej9RTzXo1ZbcZC0qSA-jHh_zCLahWsBZ?usp=drive_link\n資料の「その他」フォルダの内容は、制作の際なにかアイデアの切っ掛けになればの温度感で入れておりますので無視していただいても大丈夫です。\nデザインの詳細や分かりにくい箇所は、省略・アレンジしていただいて大丈夫です。\n\n【使用用途】\n個人の観賞用\n\nバイトターキー様のご自由な発想で描いていただけますと幸いです。\n金額に不足がございましたら、お手数ですが再送要請をお願い致します。\n\n何卒、ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ej9RTzXo1ZbcZC0qSA-jHh_zCLahWsBZ?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kukurubita1031/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3731925, "client_id": 3717340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35f5af04dbb5e8517843258ce16c8f2", "srcset": "https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e35f5af04dbb5e8517843258ce16c8f2, https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72eaac0bee4b908c2651e6792b5fe334 2x, https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0f2929e3b0860037affba6061b32eb8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5200d725b28954ef6fa56b1cc8c7171", "srcset": "https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5200d725b28954ef6fa56b1cc8c7171, https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5036c8b5ccf086101157a7af2fe2c340 2x, https://si.imgix.net/a6349d0b/uploads/origins/23b40e4d-af5f-4119-a9ab-caed3b2578c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=104caa0e9c4f904d0c9bb4c0e1ffd4d5 3x"}, "body": "バイトターキー様\nいつも素敵な作品拝見しております。バイトターキー様の色遣いが光るカラーイラストももちろん大好きなのですが、モノクロ画の雰囲気も素晴らしくすごく好きです……！！\n自分の一次創作に出てくるキャラクターをその素敵な画風で拝見してみたく、この度リクエストさせていただきます。バディものなので2人載せますが、片方でももちろんOKです。サイズ・構図含めお任せします！\n\n■ヘンリー\n宇宙探査船パイロット1年目 25歳 170cm\n丸顔で童顔(芋っぽい)。ややタレ目、つり短眉。鼻小さめ。そばかす多め(鼻、頬、首、肩などにも)。\n髪はプラチナブロンド、短髪(ベリーショート)。目の色は薄い水色(黒目サイズはお任せします)。\n肩幅狭め、いかり肩。着痩せするので目立たないが、全体的に分厚い。いわゆるガッチビ体型。シルエットとしては楕円形の連続で、太ももが特に太い。性格を一言で表すと、良くも悪くも繊細な利他的主義者。\n\n■タッカー\n宇宙探査船整備士10年目 29歳 188cm\n真ん中に一つの単眼(NGの場合は隻眼でもOK。その場合は片方を隠さず閉じた目でお願いします)。面長。眉無し。鼻筋が通っている(単眼ですがしっかりめの鼻あり)。低視力で目を細めがちで、目つきが悪く見える。下瞼がやや上がった、いわゆるかまぼこ目。\n髪は黒、短髪(モンキーボウズ)。目の色は黒で、黒目部分はハイライト無しでお願いします。\n肩幅やや広め、なで肩。筋肉不足で、かなりの瘦せ型。全体的に薄っぺらく細長い、長方形のシルエット。性格を一言で表すと、ライン越えの合理的現実主義者。\n※常に無愛想無表情で作中通して2,3回しか笑わないため、笑顔は避けてほしいです。作中で肉食ミミズのような異形に寄生されてしまう場面があり、それが背中から生えているverも資料に載っていますが、こちらの有無はお任せします。\n\n■服装\n作業用ツナギとピットクルースーツを足して二で割ったような宇宙船船内服を着ています。\n首元はボタン付きの立ち襟、サイドにライン入り。その他のデザインはお任せします。二人の服は色が違いますが、デザインは共通です。\n\nキャラデザご参考資料：資料URLに記載\n※自分の中でも完全に固まっていないので、良いようにアレンジしていただいてOKです！画像資料の中の注釈は自分で描く時用なので、どうかお気になさらず。\n一次創作の雰囲気としては、ややグロ不穏SFバディもの、みたいな感じです……\n\n使用用途：\n　基本的に私個人の観賞用ですが、今後自分でこのキャラ達を描く時のヒントにさせていただくことがあるかもしれません。トレース、商用利用は致しません。\n\n長文になってしまい恐縮ですが、急ぎませんのでもしよろしければ是非、何卒よろしくお願い申し上げます。\n\nhttps://www.dropbox.com/scl/fo/194i39xabjavj6u478g5r/AHZi-YYBcTaT_lpmnpWEBkg?rlkey=knimtxwhjktml40wn0avqdoc1&e=3&st=vk1g7pdi&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 663892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "コバヤシ⁉️", "screen_name": "iaia_58", "avatar_url": "https://pbs.twimg.com/profile_images/1879864942024916993/qF118kpe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1668309895777763328/17