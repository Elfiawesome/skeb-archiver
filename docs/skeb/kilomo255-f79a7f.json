c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ee85be09279d08a437eeeb633985004, https://si.imgix.net/dad6c74d/uploads/origins/8648d96d-65b7-4aee-ab91-c0c5d38808c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=484c3d0559aa547d7076dc6ef167e360 2x, https://si.imgix.net/dad6c74d/uploads/origins/8648d96d-65b7-4aee-ab91-c0c5d38808c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c212c3809d776f39c2ddeb8ca12deb 3x"}, "body": "あなたのアートはとてもキュート！\n\nVtuberの友達の絵を描いてほしいな。彼女はゾンビの魔女なんだ。彼女の名前はMayveUndead。\n\nどんなポーズでもOKです。彼女は帽子が大好きなので、もしそれが絵の中に入っていたら嬉しいです。\n\n依頼を検討していただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1EEtS2b3QKkeOkh_cO934WsR8IM80ygQ1?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1EEtS2b3QKkeOkh_cO934WsR8IM80ygQ1?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kilomo255/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2250290, "client_id": 1173866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75942f0f74121752c5254ceaf12267d9", "srcset": "https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75942f0f74121752c5254ceaf12267d9, https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b7aea19276dbfbecf0734d84e43e97d 2x, https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4341636f2f9d85c7741f19c1d4e9b7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccac4e3e3455a9bbdee796c5c47be5af", "srcset": "https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccac4e3e3455a9bbdee796c5c47be5af, https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9478c47dc0e49d91fb1e6c20c627b34 2x, https://si.imgix.net/44d997c2/uploads/origins/9b88d39b-dbee-4653-9b56-7be19fed5c65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f6c371dd65311dfac4352612aeb7a99 3x"}, "body": "ご依頼失礼いたします。\nきろも様のとても可愛い絵柄と風景とのマッチ度に惹かれ初依頼させていただきます。\n二次創作のご依頼かつ、ご存知ないキャラかと思いますが、もしよろしければご検討いただけますと幸いです。\n\n■キャラ：神山識（作品名：summer pockets RB）\n■希望の構図\nきろも様の作品の中でも特に下記の2作品はとても素晴らしい表現をされていて、大好きなイラストでございます。\nなので、もしよろしければその2作品の内、どちらかのイラストの構図・視点・シチュと近しい形にてイラストを希望をさせていただいてもよろしいでしょうか。\n\n〇きろも様作品\n・https://www.pixiv.net/artworks/103199671\n・https://www.pixiv.net/artworks/95954762\n\n①ターボ師匠のイラスト（https://www.pixiv.net/artworks/103199671）\nこちらのイラストのベースでお描きいただける場合は下記の構図をお願いしたく思います\n・画面中央にて女の子、背景に夏空（入道雲や飛行機雲）\n・女の子は体の向きはイラストの右寄りを向きながら、顔の向きは左側を向いているイメージ\n（風が吹いて、風の吹き抜けた方向に目を向けた……みたいなイメージで伝わりましたら幸いです）\n・女の子は微笑むような笑顔（ターボ師匠のイラストと同じく、八重歯を表現した微笑みで描写をいただけますと幸いです）\n・女の子の髪が、右から左に風が吹いているのに合わせて、少したなびいているような表現がありますと嬉しいです。\n\n②ネイチャのイラスト（https://www.pixiv.net/artworks/95954762）\nこちらのイラストのベースでお描きいただける場合は下記の構図をお願いしたく思います\n・画面右側に女の子、位置はネイチャのイラストを左右反転したぐらいか、もう少し画面端に寄っているぐらいだと嬉しいです。背景は夕空（夕方～夜の合間の表現が最高でしたので、ぜひ近しい表現だと嬉しいです）\n・こちらも女の子は体の向きはイラストの右寄りを向き、顔の向きは左側を向いているイメージでお願いいたします。\n・女の子は微笑むような笑顔（ターボ師匠のイラストと同じく、八重歯を表現した微笑みで描写をいただけますと幸いです。またこちらの場合は、郷愁を感じる優しい笑顔……のようなイメージの表情を描いていただけますと最高です。わかり辛い内容で申し訳ございません）\n・こちらでも女の子の髪が、右から左に風が吹いているのに合わせて、たなびいているような表現がありますと嬉しいです。\n\n■その他\n・女の子の服装は桃色の和服パーカー＆白い制服の衣装にて描写をお願いできますでしょうか。\nまた特にフードは頭に被っていなくて大丈夫です。\n（一応、公式のキャラ一覧URLを記載いたします。『神山識』のキャラ項目に直接繋がっておらず申し訳ございませんが、必要がありましたらご参照いただけますと幸いです→https://key.visualarts.gr.jp/summer_rb/character.html）\nまた、イラストの表現によって女の子の腕～手先までの描写を描いてくださる場合、桃色の和服パーカーの袖が手をスッポリ覆っている状態（いわゆる萌袖）で描写いただけますと最高です。\n\n・女の子の腕は特に髪を抑える等のアクションはなく、体の横にあるようなイメージでお願いできますでしょうか。\n\n・もしよろしければで大丈夫でございますが、各希望構図の空の部分に『七影蝶』という作品内に出てくる蝶が飛んでいる描写をお願いできますでしょうか。\nターボ師匠のイラスト構図でありましたら、中央女の子の真上＆イラスト天井近く。\nネイチャのイラスト構図でありましたら、女の子の位置とは真反対の左上辺り……のイメージでお願いさせていただきたいです。\n\n以上、長文にて細かく希望を記載してしまい申し訳ございません。\n上記希望内容はきろも様のイラスト表現に合わせて随時アレンジいただけますと幸いです。\nご面倒おかけいたしますが、ご検討の程どうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kilomo255/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2250290, "client_id": 3314963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48f99e74/uploads/origins/8814e583-0143-429c-8b21-1c044e0a440a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e658df5861b2d10d4b768e592d689670", "srcset": "https://si.imgix.net/48f99e74/uploads/origins/8814e583-0143-429c-8b21-1c044e0a440a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e658df5861b2d10d4b768e592d689670, https://si.imgix.net/48f99e74/uploads/origins/8814e583-0143-429c-8b21-1c044e0a440a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48c2e4c19c17d847519499b1651868b0 2x, https://si.imgix.net/48f99e74/uploads/origins/8814e583-0143-429c-8b21-1c044e0a440a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ab01009b90fca6a0cf0ff6a4b978d37 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48f99e74/uploads/origins/8814e583-0143-429c-8b21-1c044e0a440a?bg=%23fff&auto=format%2Ccompr