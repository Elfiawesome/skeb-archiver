知らない箱入り娘でもある。優しくて思いやりの深い性格。\n［キーワード］\n夢の中で会える人・夜明けに見える星・空を飛ぶ鯨\n\n念のため資料をお送りしますが、キャラクターデザインは参考程度にしていただいて構いません。\nふたりが穏やかな時間を過ごしているところが見れたら幸せです。\n\nもし難しい依頼でしたら遠慮なく捨て置いてください！\n描いていただけた暁には皆とSNSなどで見せびらかして喜びます。\nご検討のほどよろしくお願いします。\n\n追伸：クランとして作品も引き続き楽しみにしています！！\n\nhttps://drive.google.com/drive/folders/1fTmtd0TFbZkE0K7SjRtiOo3QdzKkqwer?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1502952, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "za!", "screen_name": "monogusatar", "avatar_url": "https://pbs.twimg.com/profile_images/1697102063820513280/8-twf6qS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1422460477167136770/1693453772/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2365008, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "田中ばらん@合本版2巻目発売中！", "screen_name": "lunchboxGorilla", "avatar_url": "https://pbs.twimg.com/profile_images/1776570061844860929/VhY8Oqn4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1469870970169335808/1713160748/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 17}, {"id": 2978422, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まよい寝子", "screen_name": "mayoineko0915", "avatar_url": "https://pbs.twimg.com/profile_images/2007335876431622149/iu7qANF6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1690411687709646850/1774015194/1500x500", "appeal_receivable": f