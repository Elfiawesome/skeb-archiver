e-8994-e95597399e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=687329b2d067c980359d802ccf915f0d", "srcset": "https://si.imgix.net/9c94a59d/uploads/origins/af7a3ba8-e5e3-4d1e-8994-e95597399e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=687329b2d067c980359d802ccf915f0d, https://si.imgix.net/9c94a59d/uploads/origins/af7a3ba8-e5e3-4d1e-8994-e95597399e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab0f9b07653b12f6845328c4dee44d7c 2x, https://si.imgix.net/9c94a59d/uploads/origins/af7a3ba8-e5e3-4d1e-8994-e95597399e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9759fe902fc4f90676207a638a9ff831 3x"}, "body": "はじめまして。ぶしのふじ様のイラストが可愛く、パンツの描写も素晴らしいためリクエストさせていただきます。\n\nシチュエーション：艦これのプリンツ・オイゲンちゃんが、赤面し恥ずかしがりながらも自らスカートをたくしあげてパンツを見せてくれるイラスト。\n服装については艦装・帽子なしに変更。\n\nイラスト①：リボンまで丸見えになるまでたくしあげている立ち絵。下半身はニーソが見えるように膝上まで描くようお願いします。\n\nイラスト②：後ろ向きで前かがみになった状態でスカートをたくしあげてお尻・パンツが丸見えになっているイラスト。\n下記イラストのように、顔は正面(こちら)を向いていて、こちらもニーソが見えるように膝上まで描いてほしいです。\nhttps://drive.google.com/file/d/1eDLZBYaPnqVskbkJdePyH-3oWb-GRYLZ/view?usp=drivesdk\n・パンツは下記のような白リボン付きの白。\nhttps://drive.google.com/file/d/1CxttaRb5jDRfYMZPeA8LlTrGt2pLQxM2/view?usp=drivesdk\n\n・どちらのイラストも表情差分(眉、口の開閉など)とパンツ差分をおねがいします。差分はぶしのふじ様にお任せします。\n・背景についてもぶしのふじ様にお任せします。\n・金額が足りない場合は再送していただいて構いません。\n\nご検討のほどよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bushinohuji/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 238924, "client_id": 130865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a45c2a878b64661c5ed0ebf55c2dc6", "srcset": "https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78a45c2a878b64661c5ed0ebf55c2dc6, https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04c8b7fba89af437a7782128f7c0688e 2x, https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93d8fb9e6cb1cf3fc6a6071a5a42369c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c13b95952eabc64b899d5a196211f86", "srcset": "https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c13b95952eabc64b899d5a196211f86, https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae62fdb594596dc642e9318e024ebe18 2x, https://si.imgix.net/28bece29/uploads/origins/ba532eeb-455b-4d1f-8f40-8fd3e7f02b01?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5dde4e9421f5b92c95762b0a1842a785 3x"}, "body": "お久しぶりです！\nいつもお世話になっております！\nまたドルフロのP90ちゃんのイラストをお願いできないでしょうか？\n\nP90ちゃんの新しいコラボスキンの太ももがすごいですのでそのとこを強調するイラストが見たいです…！\nシチュはP90ちゃんがどこかで仕事から休憩中で座っています。\n汗がかかるのはいいかもしれませんがお任せします。\n視点の位置は両ひざの間の周りがいいと思います。\n太ももがよく見えて、そしてローアングルで顔を見るのも魅力的だと思っています。\n衣装はもちろん新しいコラボスキンです。\nP90ちゃんの視線や表情はお任せします。\n前に向かって気づいていないような感じでも、カメラ目線で少し生意気な表情でもいいかもしれません。\n\n差分もお願いしたいです。\n①ショートパンツが履いていなくて、下着が見えます。\nかっこよくてエロい感じの戦術サイドタイパンツがいいかもしれませんがお任せします。\n②何も履いていません。\n\nご検討よろしくお願いします。\n\nコラボスキン\nhttps://iopwiki.com/images/4/43/P90_costume3.png\nhttps://iopwiki.com/images/0/08/P90_costume3_D.png\nhttps://iopwiki.com/images/8/8d/Arena_Breakout_Login_Wallpaper.jpg\n\n他の立ち絵\nhttps://iopwiki.com/wiki/P90#Gallery\nhttps://www.gfwiki.org/w/P90", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bushinohuji/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 238924, "client_id": 190032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54915090964c999db08176ff9f352295", "srcset": "https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54915090964c999db08176ff9f352295, https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07a1af18d80a2e3a58746a8dc6ea7917 2x, https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d9f1e88fc03fd58226a8a3880b56f56 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=827ffd9405467763a2b76a8d46fc5f24", "srcset": "https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=827ffd9405467763a2b76a8d46fc5f24, https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d690a2da7214cfe0e94ab00dc9d3677b 2x, https://si.imgix.net/e269e6c8/uploads/origins/f48225a8-6d21-4949-99ae-c99caa29ff69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1fe94f55d7624b3919ce9da2667ea2e4 3x"}, "body": "プリコネのレイのエロ絵をお願いします。\n\n●レイはコッコロタイプの儀装束を着用。髪型は水着レイ(サマー)時の髪型で(サマー時のヘアピンは不要)\n●レイは手を頭の後ろで組む＆がに股立ちのポーズをさせられている\n●レイは服越しに乳首を勃起させている\n●男がレイの後ろに立ち、片方の手でレイの乳首を服越しに責めながら、もう片方の手をレイの股間にやり手マン責めをし(手マン責めは直接的に見えなくてもOK)、レイの片側の腋を舐めている。男は腕や顔のみでOKで顔も表情は不要です\n●レイは涙と涎を垂らし、太ももに愛液を大量に垂らしている\n●レイは羞恥と屈辱にまみれながら絶頂\n●設定とシチュ　とある事情により儀装束を着てとある儀式を行う必要に迫られたレイ。儀式前の契約により儀式中は儀式進行役の男に逆らえなくなり、儀式場に焚かれた媚香で強制発情させられ、男に好き放題いやらしいことをされる\n●上記内容に合う擬音と喘ぎ声・セリフを付ける\n●修正が必要な場合はモザイクではなく白線消しでお願いします\n●目隠し(眉毛は隠さない)付き差分も作っていただけたら幸いです\n\n以上、ご検討をお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bushinohuji/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 238924, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff06103cf3c77fde4714046865728a63", "srcset": "https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff06103cf3c77fde4714046865728a63, https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5043b8149c39e3e4f2e98a7e8244f5bc 2x, https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e7d1e042a1ce763482d8567910088ae 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5605b875c378be841ea7d5cc8b15d38b", "srcset": "https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5605b875c378be841ea7d5cc8b15d38b, https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f83da625f6d6051c2e10eaf669d85b64 2x, https://si.imgix.net/32d474fc/uploads/origins/4b7a03d4-2aee-4923-8a01-013f5761670a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb24547fd69a625f58db73207136f170 3x"}, "body": "はじめまして。先生のユイちゃんのイラストを見て\n今回はぜひ描いていただきたいキャラクターがあってリクエストしました。\n\n▪️キャラクター\n漫画「ちょっといっぱい！」より「藍川凪」ちゃん\n\n▪️構図、シチュなど\n衣装は添付資料の居酒屋制服で、主観視点でバストアップの構図で、座り込んでいる凪ちゃんを上から見下ろしているイメージ\n胸元を開いて谷間を見せて、おっぱいを両腕で寄せるポーズ\nその谷間にお酒を貯めて恥じらいながらこちらを上目遣いで見つめている様子\nまた、料金の範囲でよろしければ、全裸差分を希望したいです。\n\nジャンル外で馴染みのないキャラクターかと存じますが、ご検討いただけると嬉しいです。\n\n是非ともご検討のほどよろしくお願いいたします。\n\nhttps://tadaup.jp/loda/0308215244602784.jpg\n\nhttps://tadaup.jp/loda/0412013346516823.jpg", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bushinohuji/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 238924, "client_id": 1920961, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25f0278a/uploads/origins/0bc5b9bf-f2b4-4668-b0f9-0aa4c4045e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcacbfcb2b4eefce6340add4fe585c8b", "srcset": "https://si.imgix.net/25f0278a/uploads/origins/0bc5b9bf-f2b4-4668-b0f9-0aa4c4045e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcacbfcb2b4eefce6340add4fe585c8b, https://si.imgix.net/25f0278a/uploads/origins/0bc5b9bf-f2b4-4668-b0f9-0aa4c4045e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d17f