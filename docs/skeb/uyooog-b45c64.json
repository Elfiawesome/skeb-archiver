2-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e58fb39f2195baf3a1057d0754483c86", "srcset": "https://si.imgix.net/bd0c55e2/uploads/origins/999b9a1b-8692-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e58fb39f2195baf3a1057d0754483c86, https://si.imgix.net/bd0c55e2/uploads/origins/999b9a1b-8692-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4700f10360b0a8e6e68451beea44f5b3 2x, https://si.imgix.net/bd0c55e2/uploads/origins/999b9a1b-8692-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bfaba77b8cc0bab294c5ccf2d51334f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd0c55e2/uploads/origins/999b9a1b-8692-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=156ea411ad1b4f9103f019d3d1ff3c1e", "srcset": "https://si.imgix.net/bd0c55e2/uploads/origins/999b9a1b-8692-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=156ea411ad1b4f9103f019d3d1ff3c1e, https://si.imgix.net/bd0c55e2/uploads/origins/999b9a1b-8692-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05fd9429ec4edde7c3068d072a2a2557 2x, https://si.imgix.net/bd0c55e2/uploads/origins/999b9a1b-8692-4995-962c-05257d80e21f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93f29d3a74e912c516a2c440e3d2930f 3x"}, "body": "なyo様\n\nお世話になっております！前回は素敵な作品をありがとうございました。\n\n今回も私のOCとへし切長谷部(刀剣乱舞/版権)を描いていただきたくリクエストを送りました。\n\n⚠️刀剣乱舞(版権)について、下記5点に当てはまる二次創作において許諾がおりていますので、ご検討いただけますと幸いです。\n1.創作性があること\n2.直接販売であること\n3.販売数量の総累計数が200個以内であること\n4.売上予定額が小規模(10万円以下)であること\n5.その他、絶対的禁止事項に該当しないこと\n以下リンク先ガイドラインより抜粋\nhttps://www.nitroplus.co.jp/license/\n\n\n【ざっくりとした設定】\nOC→わがままで自己中。長谷部の全てを支配したいと思っている。\n長谷部→OCのことを主(あるじ)と呼び、OCの所有物(刀)であることに喜びを感じている。OCのいちばんの存在になりたいと思っている。\n詳細な関係性→ https://note.com/preview/n3635b7861a13?prev_access_key=a0f9109c31c7430de4618fdf376651e4\n\n\n【描いていただきたい内容】\n①OCの好みがスレンダー女性だと思い込み、勝手に後天性女体化をするへし切長谷部\n\n②へし切長谷部にセクハラをしまくるOC\n\n以上２つのうちどちらか描きやすい方をよろしくお願いいたします。アホ漫画だと嬉しいです！\n\n\nもし料金が足りない場合は、リクエストの再送申請を送っていただけますと幸いです。(再送申請を送っていただいた場合は、料金を上乗せしたのち再送いたします)\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1EwxzPLgTppdOjAwrMRjow1VMtz-T_2e2", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uyooog/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3dd11777/uploads/origins/ad4537b7-3ce0-4c0c-b964-04889a304a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f49d7bb83bca1cb8019376716b17448", "srcset": "https://si.imgix.net/3dd11777/uploads/origins/ad4537b7-3ce0-4c0c-b964-04889a304a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f49d7bb83bca1cb8019376716b17448, https://si.imgix.net/3dd11777/uploads/origins/ad4537b7-3ce0-4c0c-b964-04889a304a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13bc493ad0cfbe984f3a6cc6c70ef633 2x, https://si.imgix.net/3dd11777/uploads/origins/ad4537b7-3ce0-4c0c-b964-04889a304a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4936b03fb0d841a22baf7e6c272ae0df 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3375412, "client_id": 2573096, "nc": 0}, {"path": "/@uyooog/works/5", "private_thumbnail_image_urls": {"src": "htt