0a2\u30d4\u30fc\u30eb\u3092\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01\n\u305d\u308c\u3067\u306f\u3001\u3054\u6307\u540d\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u5f53\u65b9\u306e\u30aa\u30ea\u30ad\u30e3\u30e9\u300c\u30af\u30ec\u30a2\u30fb\u30ea\u30f3\u300d\u3092\u5b9c\u3057\u304f\u304a\u9858\u3044\u7533\u3057\u4e0a\u3052\u307e\u3059\u2026\u3002\n\n\uff0a\u4eba\u7269\n\u56fd\u7c4d\uff1a\u4e2d\u56fd(\u9999\u6e2f)\n\u73fe\u4f4f\u5730\uff1a\u65e5\u672c\n\u5e74\u9f62\uff1a14\uff5e15\u6b73\n\u6027\u8cea\uff1a\u611f\u60c5\u306e\u8d77\u4f0f\u306b\u4e4f\u3057\u3044\uff0f\u6de1\u3005\u3068\u3057\u3066\u3044\u308b\uff0f\u6642\u306b\u8f9b\u8fa3\u306a\u7269\u8a00\u3044\uff0f\u57fa\u672c\u7684\u306b\u7121\u8868\u60c5\n\u7406\u7531\u3042\u3063\u3066\u5b66\u6821\u306b\u306f\u901a\u3063\u3066\u304a\u3089\u305a\u3001\u4e0b\u5bbf\u5148\u3067\u5b66\u8005(\u5927\u5bb6\u3067\u3082\u3042\u308a\u307e\u3059)\u304b\u3089\u52c9\u5f37\u3092\u6559\u308f\u3063\u3066\u3044\u307e\u3059\u3002\n\n\uff0a\u5916\u898b\n\u6050\u308c\u5165\u308a\u307e\u3059\u304c\u3001\u9aea\u3068\u77b3\u306e\u8272\u306f\u8cc7\u6599\u753b\u50cf\u306e\u300c\u4e09\u9762\u56f3\u300d\u306b\u3054\u6e96\u62e0\u304f\u3060\u3055\u3044\u307e\u305b\u3002\n\u273d\u670d\u88c5\n- \u3053\u306e\u305f\u3073\u306f\u8cc7\u6599\u753b\u50cf\u306e\u30ab\u30f3\u30d5\u30fc\u670d\u3067\u306f\u7121\u304f\u3001\u300c\u30b8\u30e3\u30fc\u30b8\u4e0a\u4e0b\u300d\u3092\u304a\u7740\u305b\u304f\u3060\u3055\u3044\u3002\n- \u30b8\u30e3\u30fc\u30b8\u306f\u30b7\u30f3\u30d7\u30eb\u306a\u30c7\u30b6\u30a4\u30f3\u3067\u3001\u4e3b\u8272\u306f\u7d3a\u307e\u305f\u306f\u30d4\u30f3\u30af\u3092\u5e0c\u671b\u3057\u307e\u3059\u3002\n- \u4e0a\u8863\u306e\u524d\u30d5\u30a1\u30b9\u30ca\u30fc\u306f\u9589\u3058\u305f\u72b6\u614b\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n- \u30af\u30ec\u30a2\u306f\u304a\u6d12\u843d\u306b\u5168\u304f\u8208\u5473\u304c\u7121\u3044\u305f\u3081\u3001\u30ab\u30f3\u30d5\u30fc\u670d\u4ee5\u5916\u306f\u4f55\u7740\u304b\u306e\u30b8\u30e3\u30fc\u30b8\u3068T\u30b7\u30e3\u30c4\u3067\u4e8b\u8db3\u308a\u308b\u3068\u8003\u3048\u3066\u3044\u307e\u3059(\u5468\u56f2\u306f\u8272\u3005\u3068\u7740\u305b\u305f\u304c\u3063\u3066\u3044\u308b\u306e\u3067\u3059\u304c\u2026)\u3002\n\u273d\u982d\u9aea\n- \u524d\u9aea\u306f\u7709\u3092\u8986\u3046\u9577\u3055\u3067\u3059\u304c\u3001\u5207\u308a\u63c3\u3048\u3066\u306f\u3044\u307e\u305b\u3093\u3002\n- \u9854\u306e\u4e21\u6a2a(\u3082\u307f\u3042\u3052)\u306b\u5782\u3089\u3057\u305f\u9aea\u675f\u306f\u3001\u80f8\u306e\u4e0a\u534a\u5206\u307e\u3067\u306e\u9577\u3055\u3002\n- \u592a\u817f\u306e\u4f4d\u7f6e\u307e\u3067\u4f38\u3070\u3057\u305f\u5f8c\u308d\u9aea\u3092\u3001\u592a\u3044\u4e8c\u3064\u7d50\u3073\u306e\u4e09\u3064\u7de8\u307f\u306b\u7d50\u3063\u3066\u3044\u307e\u3059\u3002\n\u273d\u9854\u7acb\u3061\n- \u808c\u306f\u8272\u767d\u3002\n- \u5207\u308c\u9577\u306e\u540a\u308a\u76ee\u3002\u8cc7\u6599\u753b\u50cf\u306e\u300c\u5168\u8eab\u56f3\uff0f\u4e09\u9762\u56f3\u300d\u3088\u308a\u3082\u7d30\u3044\u30b8\u30c8\u76ee\u306b\u304a\u63cf\u304d\u304f\u3060\u3055\u3044\u3002\n\u273d\u4f53\u3064\u304d\n- \u8eab\u9577152cm\u3001\u30d0\u30b9\u30c881cm\u3002\n- \u6c7a\u3057\u3066\u30b0\u30e9\u30de\u30fc\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u826f\u3044\u30b9\u30bf\u30a4\u30eb\u3067\u3059\u3002\n\n\uff0a\u60c5\u666f\n- \u3042\u308b\u96e8\u306e\u65e5\u3002\n- \u7528\u4e8b\u3067\u3069\u3046\u3057\u3066\u3082\u5916\u51fa\u3057\u306a\u3044\u3068\u3044\u3051\u306a\u304f\u306a\u3063\u305f\u30af\u30ec\u30a2\u3002\n- \u8857\u89d2\u3067\u30d3\u30cb\u30fc\u30eb\u5098\u3092\u5dee\u3057\u3001\u3069\u3053\u304b\u6182\u3044\u306e(\u5207\u306a\u305d\u3046\u306a)\u8868\u60c5\u3067\u7a7a\u3092\u898b\u4e0a\u3052\u3066\u3044\u307e\u3059\u3002\n- \u304b\u3064\u3066\u5f7c\u5973\u306e\u6069\u4eba\u304c\u4ea1\u304f\u306a\u3063\u305f\u306e\u3082\u3001\u3053\u3093\u306a\u96e8\u5929\u3067\u3057\u305f\u3002\n- \u300c\u79c1\u3001\u96e8\u306e\u65e5\u306f\u5acc\u304