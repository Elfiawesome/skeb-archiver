ire.\n\nReference for clothing and facial expressions\u2193.\nhttps://x.com/daisukiinorin/status/1875478829722169710?t=4UuDsPH05VtGA7xsLtvYSA&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wagashi425/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2146247, "client_id": 2214027, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8dc6146b/uploads/origins/3c190563-d048-4718-a972-cfb35b367943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=472819e6663a42c21a9e554112668e8e", "srcset": "https://si.imgix.net/8dc6146b/uploads/origins/3c190563-d048-4718-a972-cfb35b367943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=472819e6663a42c21a9e554112668e8e, https://si.imgix.net/8dc6146b/uploads/origins/3c190563-d048-4718-a972-cfb35b367943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79ad19ef681a0575173780c547b76f05 2x, https://si.imgix.net/8dc6146b/uploads/origins/3c190563-d048-4718-a972-cfb35b367943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cee501bea432d3ff066c2ac4781085b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8dc6146b/uploads/origins/3c190563-d048-4718-a972-cfb35b367943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd05be11a4e544b3a14e157e7b6c47d0", "srcset": "https://si.imgix.net/8dc6146b/uploads/origins/3c190563-d048-4718-a972-cfb35b367943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd05be11a4e544b3a14e157e7b6c47d0, https://si.imgix.net/8dc6146b/uploads/origins/3c190563-d048-4718-a972-cfb35b367943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=002ec0658b5e0e11fe6281eacb79630c 2x, https://si.imgix.net/8dc6146b/uploads/o