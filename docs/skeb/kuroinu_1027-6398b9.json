at%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=608607a80a595561a22d63e56eb53c84 2x, https://si.imgix.net/55fa46f4/uploads/origins/a5f52a22-ad68-4356-8870-968eb29a2132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f373a890a2e98b780b81eab9d6cead 3x"}, "body": "メス化のコミックをリクエストさせてください！\n心は全く変わらず男のままなのに、身体だけ取り返しのつかないレベルでメスに変えられて絶望するシチュが好きなので、そういうコミックをお願いします！！\n\n高◯生くらい。「好きな女の子に告白する度胸が無くて、「女の子の気持ちが分かる男になれたら良いのに」という男の子の願いを叶えるために、神様が男の子の身体をメス化させる話。\n「女の子の気持ちが分かるように」だったら女体化だったのに、「男」と指定したのでメスになる。\n\nおちんちんは完全に男性機能を失い、竿も玉も萎縮している。勃起することは二度と無い。女性ホルモンを5~10年くらい接種し続けたような身体に変えられる。\nおっぱいが膨らんで、お尻は縦割れアナルになってる。髪型は変化前後で変わらない。喉仏が残っていて、変えられるまで男だった名残がある。縦割れアナルの直接描写は任意。そういう身体に変えられたことだけ神様から口頭で伝わるくらいでOKです。\n変身は徐々にかわるタイプではなく、パッと身体だけ変えられるようなイメージ。服装も変わらず身体だけ瞬間的に変えられるような形。\nお願い→身体の変化→家で服を脱いで、変えられた身体に愕然としているというような話の流れでお願いします。\n\nその他：\n・男の子の一人称は「ボク」でお願いします。一人称を具体的に書いていただくというより、ボクと言うようなキャラ付けと思っていただければと。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinu_1027/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 131148, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a08079ac444b65487e98a7577791abd6", "srcset": "https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a08079ac444b65487e98a7577791abd6, https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8c7a07e1f3ca67541150fabea79d632 2x, https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9db2068007bb1993294d3b1a8313a964 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d69fa01b5ce1bc74f15d61a5395e5e1", "srcset": "https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d69fa01b5ce1bc74f15d61a5395e5e1, https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3e30c07660b31b951d5df4716ed53ff 2x, https://si.imgix.net/550585de/uploads/origins/6d4ba7d4-6d34-43a3-b6cb-59c2e0ae317e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27f0e87cfb0c2dfc1ab68c01a387b85a 3x"}, "body": "こんにちは！可愛い男の子が不可逆の肉体改造を受けて男の娘として生きていくイラストをリクエストさせてください。\nおっぱいを大きく巨乳にされて、おちんちんが切り落とされて玉だけ股間に残っている男の娘です。\n元に戻れないけど物理的に改造されていて、女の子と二度とセックスできない身体になって泣きながらお尻でオナニーしていて、おちんちんのあった根本から射精しているシチュでお願いします。\nいわゆるfemboチックな女の子みたいな雰囲気の男の娘でお願いします。\nセリフやキャラデザ、構図はお好みでお願いしますが、おちんちんがなくて玉しか残っていない股間であることがわかる構図でお願いします！！", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinu_1027/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 131148, "client_id": 2030655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=738a8a31bcd9cf2ad5e774c11afb6822", "srcset": "https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=738a8a31bcd9cf2ad5e774c11afb6822, https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=829041e69b7d3b6e2d6791e3d16f4216 2x, https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=019a941c31512fdbde5bfb4c1e1ffcfd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a29d1367294e762dbbfaf55f0426b098", "srcset": "https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a29d1367294e762dbbfaf55f0426b098, https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=baf2c01c5e6a2475cbc186f76c3139f1 2x, https://si.imgix.net/a41c86f3/uploads/origins/85a2af45-0108-4e3d-9bf9-cbec928f68b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72d6df5ddc7f5037417c2ccfe4517db7 3x"}, "body": "前回描いてくれた作品、本当に大好きだよ！\nそして、私の男性OCであるエインズリー・セントリー（通称 \"エインズリー\"）の物語をリクエストするアイデアをくれました。\n\n今回はエインズリーのマンガをリクエストしたいと思います。\n初めての依頼なので、表紙とタイトルデザイン＋最初の数ページ分の金額でお願いしたいです。\nまた、長編をお願いしてもよろしいでしょうか？もしよろしければ、依頼するたびに数ページずつストーリーの進行を描いていただいても構いません。\n*フェムボーイの娼婦に堕とされたエインズリーが、司令官に調教され、再び司令官のいい子になるだけでなく、今度は司令官専属のメイドになる......というストーリーです。\n\nシナリオ（最初の依頼）\n物語はエインズリーが化粧を終え、今夜の娼婦としての仕事を始めるところから始まる。\nそして、自分のフェチにぴったりの男がいることに気づく...しかし、近づいてみると、それは実は前の司令官だった。\nエインズリーはパニックと恥ずかしさを感じ、言い訳を考えてその場から立ち去ろうとするが、司令官は片手に彼の腕を持ち、もう片方の手には札束を持っていた...。\nエインズリーはまだ恥ずかしさを感じていたが、司令官が持っている札束の大きさに気づき、うなずいて承諾し、二人はラブホテルに向かった。\n最終的には、司令官がエインズリーを後背位で犯し、強欲でムラムラしたメス豚に堕ちた彼をスパンキングして叱りつける。\n*エインズリーは、司令官の大きなペニスで激しく犯されることに耐えられず、呻きながら謝り続けるのだった......。\n\nこのリクエストの説明があまり長くならないことを願っています。\nしかし、もしそうであれば、もっと早い段階で一時停止ポイントを与えることもできます。\n*もし短すぎるようなら、何でも自由に描いてください。\n\n参考文献\nhttps://drive.google.com/drive/u/1/folders/12gEGnJC_JfEImZJ2RorLfYSFyBU8Aqpk\n\nもしよろしければ、テキストなしバージョン（psdファイルを送っていただけますか？）\nご検討ありがとうございます。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuroinu_1027/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6acb9066/uploads/origins/f92c7507-29f4-46c5-8b19-85d25d30319c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89b4e8f1d6ba52ddcef6efc97ec250e2", "srcset": "https://si.imgix.net/6acb9066/uploads/origins/f92c7507-29f4-46c5-8b19-85d25d30319c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89b4e8f1d6ba52ddcef6efc97ec250e2, https://si.imgix.net/6acb9066/uploads/origins/f92c7507-29f4-46c5-8b19-85d25d30319c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e81566677e11735f9f4b0c9ef7d96da9 2x, https://si.imgix.net/6acb9066/uploads/origins/f92c7507-29f4-46c5-8b19-85d25d30319c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7c10a74f5b4bf0681b038d6d10fb9fd 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 131148, "nc": 33}, {"path": "/@kuroinu_1027/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 131148, "client_id": 2030655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed1dc3c5/uploads/origins/ad7ab61e-2c6c-4637-ae15-fe520aa38014?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro