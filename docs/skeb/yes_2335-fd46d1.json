\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yes_2335/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2021897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=758c1595f1461e7a0501e6cbae3b83f6", "srcset": "https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=758c1595f1461e7a0501e6cbae3b83f6, https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baa3036d049a7a7d5d28f3d2938a51ad 2x, https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2821d500affb4c7da4bb20e1220f1b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20742450c8d94114098041f80d65782c", "srcset": "https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20742450c8d94114098041f80d65782c, https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b358d23c057c4e0d2093e203e8688540 2x, https://si.imgix.net/dd3b5827/uploads/origins/40edf941-abb7-4a39-8475-085ce90eccd1?bg=%23fff&auto=format%2Ccompress&f