チの絵を見て、私もお願いしたいと思いました\n私のvtuberキャラとその友達のハリネズミを描いていただけませんか？\n夏の日に海で水着でくつろいでいる姿が見たいです。\n\nハリネズミのリファレンスはこちらです。\nhttps://drive.google.com/drive/u/0/folders/1xwklQvKTUQvl4LjHb9c7GjVGAzvWOPFA\n\n水着と水泳ゴーグル姿でも、ヘルメットは被ったまま描いていただけませんか？\n\nこれが私のキャラクターのリファレンスです。\nhttps://drive.google.com/drive/folders/19uKNqm-oMlFf55pamVPauF5PMpUsWuSY?usp=sharing\n\nご検討よろしくお願いします。♥", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@volseed/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2709, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84f0b432/uploads/origins/c563e961-1bdc-4492-9040-9ac77e4e0009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d70f4c7306a96fb27862e861909da91", "srcset": "https://si.imgix.net/84f0b432/uploads/origins/c563e961-1bdc-4492-9040-9ac77e4e0009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d70f4c7306a96fb27862e861909da91, https://si.imgix.net/84f0b432/uploads/origins/c563e961-1bdc-4492-9040-9ac77e4e0009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d4798b324251581e129b71a72348b71 2x, https://si.imgix.net/84f0b432/uploads/origins/c563e961-1bdc-4492-9040-9ac77e4e0009?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1314e39700f9aa1d6bf1f6ded85f167 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84f0b432/uploads/origins/c563e961-1bdc-4492-9040-9ac77e4e0009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a19e73cf783d82f3d7a80ce39b283030", "srcset": "https://si.imgix.net/84f0b432/uploads/origins/c563e961-1bdc-4492-9040-9ac77e4e0009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a19e73cf783d82f3d7a80ce39b283030, https://si.imgix.net/84f0b432/uploads/origins/c563e961-1bdc-4492-9040