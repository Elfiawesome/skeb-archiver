を見せてくれるかい？  彼女は水の流れについて道教に似た哲学を持っている。  彼女の体はキノコのコロニーの宿主であり、彼女は本質的に半分キノコ人間で、それを隠している。   ヤギを連れて旅をする。  武器はショートボウで、魔法はキノコと胞子を使ったミステリアスなもの。  ストイックでミステリアス、曖昧なことを言う傾向がある。\n\n好きなようにポーズをとったり、ディテールを変えたりしてください。\n\n価格は高くても構いません。  \n\nよろしくお願いします！\n\n(もっと正しく；キノコが生える）https://pbs.twimg.com/media/GjUEshAa8AAKlji?format=jpg&name=4096x4096\n\n(間違った弓) https://vgen.co/crabocalypse/portfolio/showcase/commission-work-brassknight-s-character-sheet/ddad6690-f34b-452d-a857-8edbad9f5bf1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Shin_Apost/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2564848, "client_id": 1632433, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c96b8564/uploads/origins/337f2a7b-3e10-4694-a4c6-dcccc0fa68ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e2ec67e0da290364ffed6edc0dc491", "srcset": "https://si.imgix.net/c96b8564/uploads/origins/337f2a7b-3e10-4694-a4c6-dcccc0fa68ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e2ec67e0da290364ffed6edc0dc491, https://si.imgix.net/c96b8564/uploads/origins/337f2a7b-3e10-4694-a4c6-dcccc0fa68ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6eb3460f7cea3489908f3eed3aac45f 2x, https://si.imgix.net/c96b8564/uploads/origins/337f2a7b-3e10-4694-a4c6-dcccc0fa68ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aace81cb44cdc3471a94436eee6f1eed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c96b8564/uploads/origins/337f2a7b-3e10-4694-a4c6-dcccc0fa68ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52bba11929858218c0aad1f1b38308c1", "srcset": "https://si.imgix.net/c96b8564/uploads/origins/337f2a7b-3e10-4694-a4c6-dcccc0fa68ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c