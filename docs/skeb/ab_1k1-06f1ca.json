mbnail_image_urls": {"src": "https://si.imgix.net/67a633f0/uploads/origins/3c8f6cac-684b-43ea-afd9-f58c1468b384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b51b4716d9534ae10ac0e8e221eb781c", "srcset": "https://si.imgix.net/67a633f0/uploads/origins/3c8f6cac-684b-43ea-afd9-f58c1468b384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b51b4716d9534ae10ac0e8e221eb781c, https://si.imgix.net/67a633f0/uploads/origins/3c8f6cac-684b-43ea-afd9-f58c1468b384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3d21f0f88f925572c87cf5b460dbfb 2x, https://si.imgix.net/67a633f0/uploads/origins/3c8f6cac-684b-43ea-afd9-f58c1468b384?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32dc4b7853a92e61e973d33fe8664fe2 3x"}, "body": "こんにちは、ユキウサギと申します。\n初めてABIKIさんのイラストをTwitterにて拝見した際にとても素敵だったので依頼させて頂きたいです!。\n\n<要望>\n(巨ケモイラストで)\nどうぶつの森に登場するアポロというキャラクターが居るのですが、そのアポロくんがビルオナ二ーしているイラストをお願いしたいです！\n\n シチュエーション\n辛抱出来ずに思わず突っ込んじゃって大量射精しちゃう感じがいいです！\n(射精の勢いがすごい➕辺り一面黄ばみザーメンの海でそれの臭いに悶え苦しむ人間たちの声が入ってるととても嬉しいです😭)\n\n場所\n横浜のみなとみらい\nランドマークタワーあたり\n\n以上になります！ぜひお願い致します！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@tonosukedx/works/218", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1529144, "client_id": 1033613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe48c77ae9efede4fe3262a2fe267a37", "srcset": "https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe48c77ae9efede4fe3262a2fe267a37, https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa52bd7dbdf368d2a77f3016d38bf268 2x, https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4826c025d2a23c5afd0d92f7ea8bdad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9586e1ef2aff74d296f13dc1ddfc85ee", "srcset": "https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9586e1ef2aff74d296f13dc1ddfc85ee, https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13e880e8b5a08baa027a189cf24cdbab 2x, https://si.imgix.net/a6dbbf6b/uploads/origins/8bec5aa7-c2d2-4e8c-8c6d-bf9115ed3b00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=564bb339777808ab8f9d7ba8fa85749a 3x"}, "body": "初めまして。\nトオノスケさんが描かれるイラストを、いつも楽しく拝見しております。\n特に、鵜飼木曽長くんがカワウのかわいさと愛らしさが詰まっていて凄く好みです。木曽長くんのこれからの活躍が楽しみです！\n\n本件、巨ケモの依頼内容となります。\n特殊性癖のため、難しいようでしたらキャンセルしていただいて構いません。\n\n【キャラクター】\n・アネハヅルの鳥人(雄)\nhttps://drive.google.com/drive/folders/1tD3tGMcARWhsKOpzpiZTOHE5uFB3zzUS?usp=drive_link\n名前：姉川　鶴慈（あねがわ　かくじ）\n地球とよく似た星からやってきた、地球から見たらいわゆる宇宙人の類です。\nスポーツは苦手ですが身体は丈夫であり、種族由来の抜群の肺活量を有しています。\n体型は筋肉隆々ではないですが、ややがっしりしており脂肪も全体的に少しむちっと付いているイメージです。乳首は煙や手に持っている物等で隠していただいても構いません。\n手の指は５本（人間と同じ）、足の指は３本です。\n\n【服装】\n・サーフパンツ\n上半身は何も着ておらず、靴やサンダル等も履いていません。\n\n【シチュエーション】\n・体の大きさは一般的な怪獣サイズ（絵に合うサイズにしていただいて大丈夫です）\n・右手で報道ヘリコプターを握り、マイク代わりにして熱唱している（歌が上手くカラオケが大好きという設定）\n・左手に電車を握りしめている\n電車は山手線のカラーリングをベースにしていただけると幸いです。また、ヘリ・電車共に握りしめたことでガラスが割れたり形が歪んだりしていると嬉しいです。\n\n【背景】\n場所が東京であることがわかると嬉しいです（東京タワー、都庁等）。あくまでキャラクターがメインとなりますので、細かく描いていただかなくて大丈夫です。\n\n以上、ご検討いただけると幸いです。\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bubonic_imomusi/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 549253, "client_id": 1033613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=466da3fa03c2247b05f88090462b678c", "srcset": "https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=466da3fa03c2247b05f88090462b678c, https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=051c77d38ed89f575cbadb83dfa43cf5 2x, https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce1881259a2869955cb9739b52da6a6c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9e8f5be111e197fca405bfb84b120cb", "srcset": "https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9e8f5be111e197fca405bfb84b120cb, https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=890af90f41a69d6ce916e7fd3bb9a227 2x, https://si.imgix.net/7b3a5ca0/uploads/origins/0191dd8b-354e-4217-89a3-13cd34d4bed8?bg=%23fff&auto=for