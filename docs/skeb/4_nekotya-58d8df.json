き、厨二病ではない。他の人にも｢巻く？｣と言って巻かせようとしてくる。\n\n ▋構図など \n服装は資料添付しているものでも捏造でも、構図含めお好きなように描いていただいて大丈夫です。髪型もアレンジ可です！\n資料と一緒に雰囲気が掴めそうな画像も添付しております(全てネタバレなし)\n\n▋使用用途 \n・個人観賞 \n・SNSのアイコン等での使用 \n・skeb依頼報告でのSNS投稿  \n\n以上になります。\nskeb依頼不慣れなゆえ金額不足等ございましたら再送いただけたらと思います。 お忙しい中恐れ入りますが、ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1JMwu1wDPSM3SiwOydk_isIdhMIlNs21w", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1507713, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🫧𝕤", "screen_name": "_smpcr", "avatar_url": "https://pbs.twimg.com/profile_images/1684983555586473984/K5DT_dkp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/765924812539789312/1701937238/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2051355, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "C7(しいな)🍤", "screen_name": "siinaP_game", "avatar_url": "https://pbs.twimg.com/profile_images/1828940654816440321/Qc_1xXb_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1505583530289803265/1724887934/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2616923, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🦴", "screen_name": "xxx_09127", "avatar_url": "https://pbs.twimg.com/profile_images/1937106402134163456/ASRJxHUe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1677239349342269440/1739428262/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": nul