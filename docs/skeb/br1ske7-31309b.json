ましたが、自分の描きやすい範囲で自由に描いてください。\n\nキャラクター、BG、サインが入ったPSDファイルがあればうれしいです。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hliocBsJZzn62bbwjIWe70QMXcw0Usu3", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@br1ske7/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6b2c0b42/uploads/origins/0dc2b355-ac86-47e6-8e0b-825273901bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=388ea5d69434d05f5ae9ccf361bdc9f2", "srcset": "https://si.imgix.net/6b2c0b42/uploads/origins/0dc2b355-ac86-47e6-8e0b-825273901bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=388ea5d69434d05f5ae9ccf361bdc9f2, https://si.imgix.net/6b2c0b42/uploads/origins/0dc2b355-ac86-47e6-8e0b-825273901bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1f0e8d592745b4f8072a42356bc08d63 2x, https://si.imgix.net/6b2c0b42/uploads/origins/0dc2b355-ac86-47e6-8e0b-825273901bbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7df8dba0b72d2283eca154acb066dfd3 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3518403, "client_id": 1989, "nc": 33}], "sent_works": [], "similar_creators": [{"id": 191670, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぱいせん彼方🦊🦭4/19猫芽展withU出展", "screen_name": "easy_aoninger4", "avatar_url": "https://pbs.twimg.com/profile_images/2033527653878431744/KVET1-W-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/758601504177528832/1772531057/1500x500", "appeal_receivable": true, "popular_creator