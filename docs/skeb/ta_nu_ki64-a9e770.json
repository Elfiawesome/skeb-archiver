情は悔しそうな感じ（怒りと悔しさで涙を浮かべている）でお願い致します。\nまた、衣装は完全着衣でお願いしますが、ブーツが片方脱がされている感じでお願い致します（ブーツの下はボディースーツで、結構蒸れています）。頭のほっかむりとかも脱がされて床に落ちている感じでお願いいたします。\n\nNSFWを有効にさせていただきましたので、露出はありませんが限りなくエロい感じのヒロイン敗北シチュでお願いいたします！！\n注文が多く申し訳ございません…何卒宜しくお願い致します！！\n\nhttps://www.dropbox.com/sh/51vtndt09ts7da6/AACbj8L7h8wP44vw8lgIncEZa?dl=0", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ta_nu_ki64/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 511798, "client_id": 26072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e3c2d03/uploads/origins/4e0fceab-37c1-4926-a0d7-90757f6e589c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2b00355c56c11a54260356cf465b459", "srcset": "https://si.imgix.net/2e3c2d03/uploads/origins/4e0fceab-37c1-4926-a0d7-90757f6e589c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2b00355c56c11a54260356cf465b459, https://si.imgix.net/2e3c2d03/uploads/origins/4e0fceab-37c1-4926-a0d7-90757f6e589c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fed668aec12e166b786bc9f813286b6 2x, https://si.imgix.net/2e3c2d03/uploads/origins/4e0fceab-37c1-4926-a0d7-90757f6e589c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3611f4d9fca79508de5bdfe13976fd30 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e3c2d03/uploads/origins/4e0fceab-37c1-4926-a0d7-90757f6e589c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f1771f478866bef444ef727e41e9d9", "srcset": "https://si.imgix.net/2e3c2d03/uploads/origins/4e0fceab-37c1-4926-a0d7-90757f6e589c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f1771f478866bef444ef727e41e9d9, https://si.imgix.net/2e3c2d03/uploads/origins/4e0fceab-37c1-4926-a0d7-90757f6e589c?bg