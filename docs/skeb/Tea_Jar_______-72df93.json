せん。髪の毛は基本白で、インナーだけピンクになっています。それから、左腕は欠損させて描いていただければ幸いです。(してなくても大丈夫ですが！)\n\n長々と失礼しました。もし描いていただければこの私、一生この栄誉に浸って生きていくものと存じます。何卒、この依頼を受けていただけませんでしょうか。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1hnSPbr34DbmoKLm0NgSZ6k4rc8ZxwHEs", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Enoki_nohito/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2706833, "client_id": 2930381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84cf26aa/uploads/origins/35378df7-efbe-4454-ac36-e9030c2ada59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dce28576e45dd9184885511a954d8c62", "srcset": "https://si.imgix.net/84cf26aa/uploads/origins/35378df7-efbe-4454-ac36-e9030c2ada59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dce28576e45dd9184885511a954d8c62, https://si.imgix.net/84cf26aa/uploads/origins/35378df7-efbe-4454-ac36-e9030c2ada59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1392567dd58d4b6ede9d75c04a9af6fe 2x, https://si.imgix.net/84cf26aa/uploads/origins/35378df7-efbe-4454-ac36-e9030c2ada59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86164e75c0ee7b7eee4b3c160f5ad196 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84cf26aa/uploads/origins/35378df7-efbe-4454-ac36-e9030c2ada59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5375c87c3897caee1dd6c726061b5cc5", "srcset": "https://si.imgix.net/84cf26aa/uploads/origins/35378df7-efbe-4454-ac36-e9030c2ada59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5375c87c3897caee1dd6c726061b5cc5, https://si.imgix.net/84cf26aa/uploads/origins/35378df7-efbe-4454-ac36-e9030c2ada59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=20