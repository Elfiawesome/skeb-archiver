&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a93334cd6bfa715ca22e24599f6b64dc 2x, https://si.imgix.net/b7d216cd/uploads/origins/1e726bb7-cb21-4d89-82e1-bb9f9eb98652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87bfe1f89380c130037a8c3da7c2e2ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7d216cd/uploads/origins/1e726bb7-cb21-4d89-82e1-bb9f9eb98652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=214d1ec133cbe4bca404dbeb7658c69c", "srcset": "https://si.imgix.net/b7d216cd/uploads/origins/1e726bb7-cb21-4d89-82e1-bb9f9eb98652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=214d1ec133cbe4bca404dbeb7658c69c, https://si.imgix.net/b7d216cd/uploads/origins/1e726bb7-cb21-4d89-82e1-bb9f9eb98652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b51e7e56fb01969e0e0514b7c8d7c580 2x, https://si.imgix.net/b7d216cd/uploads/origins/1e726bb7-cb21-4d89-82e1-bb9f9eb98652?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f19b3fbf2003564a55286a705c2aa6a 3x"}, "body": "こんにちは！あなたの作風は素晴らしいですね。私のVTuber「ラメア」のイラストを描いていただけないでしょうか。\n彼女は水竜の冒険者で、元気いっぱいで自信に満ち、遊び心のあるキャラクターです。\n\nあなたの作品が持つ躍動感やアクションポーズがとても気に入っています。このキャラクターをどのように描いてくださるのか、ぜひ見てみたいです。もし攻撃が属性を持つなら、水属性になります。\n\n表情やポーズはあなたにお任せします。また、ポーズに合わせてショートヘアでもロングヘアでも構いません！ \n\n重要なデザイン上の注意点：口の中と舌の色はピンクではなくシアンです\n\nイラストはSNS、YouTube、Twitchで使用させていただきます\n\nhttps://drive.google.com/drive/folders/1Po9C498sfakMX5Z9lgNm-yAaS3pRmQqQ?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@montesquekite/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3914053, "client_id": 1459073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62fb6a237d94fc6c28574a31a483bf79", "srcset": "https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62fb6a237d94fc6c28574a31a483bf79, https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09f526dbfb36cb084c4929c2c1db0f61 2x, https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a449c6cec2d0ccfa840868945bb7d2f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b035b6a392f0f1befa6d2965a9b69e9", "srcset": "https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b035b6a392f0f1befa6d2965a9b69e9, https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91f93bd39dcdd34592b8bfa194bfe9dc 2x, https://si.imgix.net/1761021d/uploads/origins/bb40da6d-95a3-4e4b-9e1e-dae05341a800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b95f8659d152c213ead748ea2704be38 3x"}, "body": "こんにちは！ネットを閲覧していたらあなたのスケッチを見つけました。あなたの画風、とても気に入りました！\n\n私のウサギは錬金術師兼魔法使いで、必要な材料を自分で手に入れるために、危険な生き物を相手に冒険に出かけることが多いんです。その任務を遂行する手段の一つが、召喚魔法です。\n\n今のところ、彼が召喚するのは紫色の岩でできたひげのあるカメです。\n\nあぐらをかいてリラックスした様子で、片方の掌に顎を乗せ、自信に満ちた笑顔を浮かべながら、亀が彼を運んでいる最中の姿を描いていただけると嬉しいです。\n\n周囲の背景は木陰の森でも構いませんが、もしそれが過剰になるようでしたら、背景なしでも構いません。\n\nそれ以外については、何か追加していただいても、シンプルに仕上げても、お好きなように描いてください！\n\nhttps://www.dropbox.com/scl/fi/y157xdsa5olu8gypla74r/3390686-5.output.png?rlkey=dv8z38j49ar2m96wyy3ldb4jp&st=h72d23i7&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 5500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "by4co", "screen_name": "_by4co", "avatar_url": "https://pbs.twimg.com/profile_images/2021599416852037632/NlSlkKo6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1014439178317193216/1772116258/1500x500", "appeal_receivable": false, "popular_creator_rank": 64, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 32}, {"id": 392853, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "はどまん", "screen_name": "texas_bazooka", "avatar_url": "https://pbs.twimg.com/profile_images/1648356256267239426/FtaKKAlx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1247499627990929409/1759807050/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2056091, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "黒尾", "screen_name": "blacktail_hihi", "avatar_url": "https://pbs.twimg.com/profile_images/1522799979902889984/xcYzhsPS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1420661329715601412/1659733989/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre