お忙しいところ恐縮ですが、どうぞよろしくお願いいたします。\n\n軽く紹介をつけさせていただきます。\n\n蜥蜴\n都市伝説課の先輩。後輩である壁虎ちゃんのことを可愛がっている。\n外見的特徴：赤髪、黒メッシュ。斜めカットの前髪。瞳は黄色で、縦長瞳孔。胸がない。\n\n壁虎ちゃん\n都市伝説課の新人。蜥蜴を「お姉様」と呼び、慕っている。ぞっこんである。料理上手で、毎日手作り弁当を自分と蜥蜴用の二人分用意している。\n外見的特徴：セミロングの黒髪、聖子ちゃんカット。瞳は緑で、縦長瞳孔。吊り目で、下まつげが強め。赤いマフラーをいつもつけている。胸が大きい。\n\nhttps://www.dropbox.com/sh/7zohrf6p6wjqlke/AAA1aDMwae0ocTJFqEDWfjMZa?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itodenwa_1/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fa94914b/uploads/origins/38c9d461-d3c7-4c2c-b6e5-3e8a54354a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a96fa658b5b93049c9a16df6e6d1f69d", "srcset": "https://si.imgix.net/fa94914b/uploads/origins/38c9d461-d3c7-4c2c-b6e5-3e8a54354a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a96fa658b5b93049c9a16df6e6d1f69d, https://si.imgix.net/fa94914b/uploads/origins/38c9d461-d3c7-4c2c-b6e5-3e8a54354a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=022f30ab1a15a2ffdce0e13c47f5c5bd 2x, https://si.imgix.net/fa94914b/uploads/origins/38c9d461-d3c7-4c2c-b6e5-3e8a54354a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea3f72b41d7c4b8324e00e93c6a25f17 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 515847, "nc": 16}, {"path": "/@itodenwa_1/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 515847, "client_id": 1031168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix