が本当に大好きです！\n\n私のオリジナルキャラクター（OC）を描いていただけないでしょうか。彼女は普段は人間の女性の姿をとっている宇宙人です。胸まで届くストレートの黒髪で、前髪はストレートにカットされています。左目のすぐ下に小さないぼがあります。\n\n宇宙人であるため、彼女は無意識のうちに冷たく距離感のあるオーラや、ほのかな非人間的な雰囲気を漂わせることがよくあります。\n\n衣装のメインカラーとして、黒、白、シルバー、ライトグレーを使用していただけますか？また、シルバーのアクセサリーをたくさん身につけてもらうことは可能でしょうか？さらに、SF的な雰囲気を出すために、宇宙や星空の要素もイラストに取り入れていただけると嬉しいです。洗練されていて繊細な雰囲気のイラストになることを期待しています。\n\nキャラクターの衣装、ポーズ、背景については、クリエイティブな自由を存分にお楽しみください。視覚的に印象的でインパクトのある作品になることを楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1Zv3duTXXc5w78U0b0_x_JGjaKucb17P1?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ss2veuSs/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3955741, "client_id": 1941335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4e3075e/uploads/origins/452ea50a-582e-40f3-8802-69e903b31a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3846689834fcf746bfa871aa9c16697", "srcset": "https://si.imgix.net/f4e3075e/uploads/origins/452ea50a-582e-40f3-8802-69e903b31a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3846689834fcf746bfa871aa9c16697, https://si.imgix.net/f4e3075e/uploads/origins/452ea50a-582e-40f3-8802-69e903b31a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f42bca2741f98bf50a45645bc72827b4 2x, https://si.imgix.net/f4e3075e/uploads/origins/452ea50a-582e-40f3-8802-69e903b31a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed7969db257cb136972589b06485f5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4e3075e/uploads/origins/452ea50a-582e-40f3-8802-69e903b31a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ee1fdfb89441b7681c75383dca14d7d", "srcset": "https://si.imgix.net/f4e3075e/uploads/origins/452ea50a-582e-40f3-8802-69