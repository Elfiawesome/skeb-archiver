-b5cb-28b822edf84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=befe069721c8dc958693daa0ac8f9fce 2x, https://si.imgix.net/5957c375/uploads/origins/d144600c-4aee-4d76-b5cb-28b822edf84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0759f64cd3f48060406de1bb2152b493 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5957c375/uploads/origins/d144600c-4aee-4d76-b5cb-28b822edf84d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2682a110553c454d786841e86ce3da2", "srcset": "https://si.imgix.net/5957c375/uploads/origins/d144600c-4aee-4d76-b5cb-28b822edf84d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2682a110553c454d786841e86ce3da2, https://si.imgix.net/5957c375/uploads/origins/d144600c-4aee-4d76-b5cb-28b822edf84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0295288e086aa86604ec59cf51fab704 2x, https://si.imgix.net/5957c375/uploads/origins/d144600c-4aee-4d76-b5cb-28b822edf84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fcc34022c571c36b14fa9f4ebc9a1f0c 3x"}, "body": "墨田さま、はじめまして！忙人と申します。\nSkebで墨田さまのイラストを拝見し、墨田さまの絵柄や色遣いに惹かれました！\nもしよろしければ私のOCを描いていただけないでしょうか？\nSFらしさ（？）をベースにイiスラーiム商業（史）をモチーフにしてデザインしたキャラクターなのですが、リンク先には19世紀エジプト、近代オiスマン帝国の行商人とヴェネiツィア交易をモチーフにした衣装の３つがございます。お気に召された時代や衣装をお選びくださるとうれしいです！もし、小物を描かれることがあればその時代や文化にあったものが嬉しいですが、モダンなものであっても全然かまいません！\nポーズやシチュエーションは墨田さまの思ったように描いていただけると大変うれしく思いますのでお任せいたしますが、パーソナリティを表すようなアイディアとしては\n・交渉／商談がうまくいかず不貞腐れている\n・いいカモが見つかったぜ！という表情\n・猫と戯れる\nなどがございます。（基本的にあまり敬虔ではございません。）\n\n衣装の色相などはご自由に描写していただいて構いませんが、肌の色は暗めを意識していただけると幸いです。\n使用用途は観賞用、サイズによってはスマホ壁紙、ディスコードのアイコンなどで、ほかのクリエイターの方に資料としてお見せすることなどはございません。\n\nもしリクエスト内容がお気に召さない、あるいは金額に見合わない等の問題がございましたら気兼ねなく再送していただくか、キャンセルしてください。\n\nお忙しい中目を通していただき誠にありがとうございます。墨田さまの絵柄がとても好きなので、もし受けてくださいましたら大変うれしく思います。何卒宜しくお願い申し上げます