fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=096bacf97f0fa5d01915489df962fad2", "srcset": "https://si.imgix.net/70adadeb/uploads/origins/ee0e6276-a35f-4591-9bf0-ba99c4de07b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=096bacf97f0fa5d01915489df962fad2, https://si.imgix.net/70adadeb/uploads/origins/ee0e6276-a35f-4591-9bf0-ba99c4de07b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7ac9b76ad519bbfba293ee1a9205705 2x, https://si.imgix.net/70adadeb/uploads/origins/ee0e6276-a35f-4591-9bf0-ba99c4de07b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bd1855a3719c8021b84cb0bf86d5fbb 3x"}, "body": "墨田さんの絵ほんとに好きです　ちびでOC2体描いてほしいですっ\n\n■立ち絵などファイル\nhttps://drive.google.com/drive/folders/16Zrr1gPS1rj55Qp6up0oDPh5DrTiWjCK?usp=sharing\n\n■要望など\n・表情の指定もしているのですが（ファイル参照）、必須ではないので描きやすいように描いていただければ幸いです。\n・服の装飾などでわかりづらい・曖昧な部分は適当にしていただいて大丈夫です。（そもそも元の絵が曖昧ですので…）\n・ポーズも自由ですが、仲はよさげにしてもらえるとうれしいです\n\nよろしくおねがいします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botta_kuri_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3268229, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bd259deddf2a9e80ae652ad9db6f43f", "srcset": "https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bd259deddf2a9e80ae652ad9db6f43f, https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e09df023fabb08d5d1a05ee1e050b1d 2x, https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dd46c55a3357125aaed336847eb8d00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26fa76e2e788c1b19fe75467f4cb3aa", "srcset": "https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26fa76e2e788c1b19fe75467f4cb3aa, https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7add62c3aeb00d103501b72ccb81c4a 2x, https://si.imgix.net/b92dd9fa/uploads/origins/8b6c0f4f-6122-4e7b-9d2d-00e537dce6e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e711f69d02306afcfdbf2582c2e31b3b 3x"}, "body": "こんにちは、はじめまして。墨田くり様の画風がとても好きです。オリジナルキャラクター2人の衣装デザインをお願いしたいです。\n\n舞台は17世紀。AとBは青春時代に日本で出会い、別れを余儀なくされ、数年後に再会してスペインに駆け落ちします。二人が落ち着いた時の衣装デザインをお願いします。\n\n🐙 [a] クリストバル\n身長183cm。Bより年上。ポルトガルの船に乗っていたスペイン人の船乗り。強気でのんびり、人懐っこく、感情的な一面も。離れている間に頼もしくなった。現在は漁師。\n\n- 航海服で描いてください。\n- 日誌を持っている\n- A05」のような髪型。髪は黒一色\n- 腕にタトゥーはない\n- 下の犬歯が鋭い\n\n🕯️ [B] KAGAYA\n身長178センチ。不器用だが勤勉な青年で、長年の研究の末に医者になった。語学と生物学に堪能で、貿易商や外国人の通訳の仕事もこなす。困っている人を断れない優しい性格。\n\n- 着心地のよいカラフルな服装で描いてください\n- スカーフをかぶり、薬箱を持っている。\n- 可能であれば、オランダの陶磁器にインスパイアされたパターンを希望します。\n- 髪は真っ黒\n\nありがとうございます！ご要望にそぐわない場合は、遠慮なく却下してください。\n\nhttps://drive.google.com/folder/d/18DcZb5EGq0DAuu0InwIVpARHzGJf6Znz", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botta_kuri_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3268229, "client_id": 698224, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2451177a76b704ec6e24832f74865926", "srcset": "https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2451177a76b704ec6e24832f74865926, https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9298a075e83567aab7a1aec8b4b5551b 2x, https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26832d5565bb37d1c56d1de2fe11af87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0d39d2cc7605ee616dd3300fd3c8a8a", "srcset": "https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0d39d2cc7605ee616dd3300fd3c8a8a, https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d276857db84bc9115ec050f776e770e 2x, https://si.imgix.net/b637e974/uploads/origins/36f98784-956f-44c4-a592-754cd2281f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e01b96b1ef77f065745c077544b4d283 3x"}, "body": "こんにちは、あなたの作風は本当にかわいいと思います！あなたの描く国の擬人化も好きです。国をモチーフにしているわけではありませんが、私は世界中のOCを何人か持っているので、ぜひ描いてほしいです。\n\nグンナリ（略してギイ）はフィンランド出身で、イーダはオランダ人、キワはニュージーランド出身なんだ。この3人が一緒に描かれた作品を作ってほしいんだけど、PFPSとして使えるように、別々にも添付してもらえると助かるよ！\n\nもしよければ、彼らに似合うと思う服装に変えてください。\n\nhttps://drive.google.com/drive/folders/1ElcLBkiqJiv_jOugnWUV-z5yIk0EIZmw?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botta_kuri_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3268229, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110178baeb6d0fb128cb870875739b96", "srcset": "https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=110178baeb6d0fb128cb870875739b96, https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c801a3c286c339d3712e1c93c0276db2 2x, https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97fe9b465ed2579d10bece7017f984f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aab04589a29b045cd157964d15427ebf", "srcset": "https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aab04589a29b045cd157964d15427ebf, https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81acce490c2b77efc8c3acacc93b8006 2x, https://si.imgix.net/f6d2651f/uploads/origins/7cb35f1f-8f0c-4f65-9ab9-3588fde2f071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e512ecd72404779a3fd4a076efd3cdd 3x"}, "body": "墨田くり様、はじめまして！素敵な絵をいつも拝見させて頂きます。可能ならば自キャラに新しい衣装デザインを依頼したいと思っております！\n\n【依頼内容】\nキャラ参照は下記のURLをご覧ください。南東アジアの様なトロピカル島国に旅をしていて、未知か禁じられた廃墟や遺跡を探索している、所謂トゥームレイダーの様な子です。天真爛漫な性格で、楽天家でお喋りなタイプ。髪の内側は宇宙の様に光っている。中性的。身長は179cm。キャラの肌色をご注意ください。\n\n【テーマ】\n➤ 元デザイン：https://www.deviantart.com/stash/21wy7fmnbcvm\n➤ 新衣装のモチーフ＆スタイル：墨田くり様の歴史・民族擬人化はいつも詳細で独特で、歴史に対する熱心がよく伝えられて大好きです。この度、自キャラに歴史と文化にインスパイアされた衣装デザインをお願いしたいです。近世イタリア、オランダ、またはアルメニア、どの地域でも大丈夫です。\n\n∎ 可能であれば、この子の髪型を変えてください！中の宇宙色も衣装に合わせて別色に変えてください。\n∎ 中性的の子ですので、男性か女性用の衣装はどっちでも大丈夫です。\n∎ その他は何でも構いませんので、墨田くり様のテイストをお任せて、お好きに描いてください。\n\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください。ご検討のほど、何卒よろしくお願いします。\n\nhttps://www.deviantart.com/stash/21wy7fmnbcvm", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botta_kuri_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3268229, "client_id": 3422163, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a19a4ddde9088adae5b80e3e80d5e6ac", "srcset": "https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a19a4ddde9088adae5b80e3e80d5e6ac, https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a25a3ca4ac5c4d32da3b8000aaa13630 2x, https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44208d98f797b31a508bdb446543aeca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a5d7f429579f74684f6e13dc1ea2bd0", "srcset": "https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a5d7f429579f74684f6e13dc1ea2bd0, https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a0b6346932ddcd4f48f716f6f61bdc9 2x, https://si.imgix.net/9d9e739e/uploads/origins/376d0f82-a7be-4233-b050-88fdff2726a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bae89af8aa71e7ca3455c621f3d6718b 3x"}, "body": "EN 🇺🇸🇬🇧(preferred)\n\nHi! I would love for you to draw my OC, Cathlockiller:3!\n\nPlease focus on the character in the center of the image (purple hair, cat headphones, black skirt, purple shirt, long white socks, pink tail, and knife). Also she has 2 wings (black with blue and red floating and not attached to her body)\n\nThere is a tiny version of her that shows she wears flats (ballet flats, no straps at all)\n\nShe was a former serial killer and now is dead (got killed by her friend Tyrone who I will not add here). She is vengeful, emotional, and sometimes weird (as terms of silly because of her octopus and penguin colleges).\n\nThe pose is up to you, but I recommend something that fits her personality described above.\n\nI hope this helps! Thank you so much for considering this commission!\n\nJP 🇯🇵🎌\n\nこんにちは！私の OC、Cathlockiller:3 を描いていただけると嬉しいです！\n\n画像の中央にいるキャラクターに注目してください (紫の髪、猫のヘッドフォン、黒いスカート、紫のシャツ、長い白いソックス、ピンクの尻尾、ナイフ)。彼女には 2 つの翼もあります (青と赤が黒の上に浮かんでいて、体に付いていません)。\n\nフラットシューズを履いている彼女の小さなバージョンがあります (バレエ フラット、ストラップなし)。\n\n彼女は元連続殺人犯で、現在は亡くなっています (友人の Tyrone に殺されましたが、ここではそれについては触れません)。彼女は復讐心に燃え、感情的で、時々奇妙です (彼女には友人がいて、タコが 3 匹、ペンギンが 1 匹いるので、ばかげているという意味で)。\n\nポーズはあなた次第ですが、上記の彼女の性格に合ったものをお勧めします。\n\nこれがお役に立てば幸いです。このリクエストを検討していただきありがとうございます。\n\nhttps://x.com/CathlocKil/status/1845848837296132429", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@botta_kuri_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3268229, "client_id": 193145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42d1-a7f0-6859bd1c578b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e6847293635e08b82d6409745ffabc7", "srcset": "https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42d1-a7f0-6859bd1c578b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e6847293635e08b82d6409745ffabc7, https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42d1-a7f0-6859bd1c578b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e49494f939fe1454488b2191e3412a7c 2x, https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42d1-a7f0-6859bd1c578b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dcbf4adeb59e624a64838e25cf14b03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42d1-a7f0-6859bd1c578b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34b86992be0368975a5ba32d2dec8fe8", "srcset": "https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42d1-a7f0-6859bd1c578b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34b86992be0368975a5ba32d2dec8fe8, https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42d1-a7f0-6859bd1c578b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26a1e2626ff1c8fd2f08a5c121621de6 2x, https://si.imgix.net/4e62aa4b/uploads/origins/23263568-1ed5-42