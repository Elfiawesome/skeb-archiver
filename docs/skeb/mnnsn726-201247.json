てある温室に立っているようなイメージでお願いします。体は少し横か斜め向き、目線はちらっとこっちを見ている感じです。(特に花の指定とかはありません。)\n\n服装ですが、参考資料には上半身までしか映ってないので補足です。\n・白のフレアスカート、裾に緑のライン。膝上10cm程度\n・黒のニーハイ、デニールは80くらいのイメージ\n・靴はお任せです\n・一応目の色も参考資料通りで固定です\n\n金額は10000円にしていますが、skebの依頼としてはサイズの大きい(?)絵だと思いますので、追加料金があれば変更して再送をお願いします。\n\nhttps://twitter.com/uni12212uni/status/1304267484330164224?s=20&t=uWySxRYAEcZKKrx4pB-Edw", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "筆禍@くりえいてぃ部 L01･02", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/2039687848933421056/N4XqcZ9C.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}, {"id": 40945, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あらくね。", "screen_name": "Arachne81021", "avatar_url": "https://pbs.twimg.com/profile_images/1434755608310206465/GTOXWkJS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2931247843/1633979117/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1180826, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ْ", "screen_name": "aaa98752", "avatar_url": "https://pbs.twimg.com/profile_images/2006407697621725185/SyHJoMqg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1606300852993462272/1767200151/1500x500", "appeal_receivable": false, "popular_creator_rank":