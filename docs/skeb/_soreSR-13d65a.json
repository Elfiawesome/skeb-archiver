イライトがありません。\n\n肌は白くて、日焼けしていない不健康な感じです。全体的に痩せています。\n\n資料だと服は紫色のスウェットですが、服は描きやすいものに変更しても構いません。\n紫以外だと黒色の服を好みます。\n\n活動に使用するため、背景を透過だと嬉しいです。\n\n活動での使用や印刷、グッズ化等についてNGな場合は使用できない用途について記載したデータを一緒に納品して頂けると助かります。\n\n(版権OKな絵師さんへ)\nポケモンのゲンガーが好きなので、できたら一緒に書いて頂きたいです。二次創作や版権物をNGにしている場合は人物のみで大丈夫ですのでこの部分は無視してください。\nゴージャスボールまたはプレミアボールを好みます。モンスターボールは苦手です。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_soreSR/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1171744, "client_id": 678790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/464c4af1/uploads/origins/644bda88-0a3d-4d00-95e1-6302ed6da855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a1eabed925fc22cfd57d2c6a2d606d", "srcset": "https://si.imgix.net/464c4af1/uploads/origins/644bda88-0a3d-4d00-95e1-6302ed6da855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a1eabed925fc22cfd57d2c6a2d606d, https://si.imgix.net/464c4af1/uploads/origins/644bda88-0a3d-4d00-95e1-6302ed6da855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b49aa3ede2c6a49eed4c9e3449dc9493 2x, https://si.imgix.net/464c4af1/uploads/origins/644bda88-0a3d-4d00-95e1-6302ed6da855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea25e7042638995acbb68ae3b86de309 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/464c4af1/uploads/origins/644bda88-0a3d-4d00-95e1-6302ed6da855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a602b335df19033b7f335d4caea9fd9e", "srcset": "https://si.imgix.net/464c4af1/uploads/origins/644bda88-0a3d-4d00-95e1-6302ed6da855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a602b335df19033b7f335d4caea9fd9e, https://si.imgix.net/464c4af1/uploads/origins/644bda88-0a3