92d9-93c650d56ffb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23b2d78e702ba69bac1b59db7769bba3 3x"}, "body": "こんにちは、芽茶さん！あなたの漫画を読んでいて、あなたの絵がとても好きです。だから、漫画の依頼をしようと思っています。\n\nカワウソが突然、筋肉質で背が高くなり、他の大型種よりもさらに大きくなった。理由は魔法でも何でもいい。カワウソはより支配的になった。そして、犬は同時に急にぽっちゃりになる。カワウソは犬の腹や乳房などをさすって、犬といちゃつく。犬はそれを楽しみ、カワウソの筋肉質な体を崇拝する。変化前の犬とカワウソは標準的な体格で、犬の方が少し背が高い。カワウソの体格は筋肉質だが、腹はやや柔らかく、犬よりはるかに大きい。\n\nメガネはできればそのままで。その他、アドリブはご自由にどうぞ！本当にありがとうございました！\n添付URLの参考文献をご覧ください。\n\nhttps://drive.google.com/drive/folders/1r4MovycCXTl02mQ2soe_BK8NkXbEb-hZ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harapeko_mettya/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2641604, "client_id": 3070614, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d73d5333/uploads/origins/1e3073f5-a91d-4183-b2ad-1dc643f6c797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1689ad14ccc0823b8b5eed1684fa997b", "srcset": "https://si.imgix.net/d73d5333/uploads/origins/1e3073f5-a91d-4183-b2ad-1dc643f6c797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1689ad14ccc0823b8b5eed1684fa997b, https://si.imgix.net/d73d5333/uploads/origins/1e3073f5-a91d-4183-b2ad-1dc643f6c797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85459fdef03d9f68655aa58069e857f4 2x, https://si.imgix.net/d73d5333/uploads/origins/1e3073f5-a91d-4183-b2ad-1dc643f6c797?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e033bdfe758b024314dd8025eebf84c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d73d5333/uploads/origins/1e3073f5-a91d-4183-b2ad-1dc643f6c797?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57f6ca4c429ba6a656d920ea1f8b3b24", "srcset": "https://si.i