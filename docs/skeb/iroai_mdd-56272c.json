081\u307e\u3057\u3066\u3002Vtuber\u306e\u6708\u591c\u731f\u4ecb\u3068\u7533\u3057\u307e\u3059\u3002\n\u8272\u5408\u3055\u3093\u306e\u63cf\u304b\u308c\u308b\u30ab\u30c3\u30b3\u3088\u304f\u3066\u7d20\u6575\u306a\u7b4b\u8089\u306e\u7537\u6027\u30a4\u30e9\u30b9\u30c8\u3092\u62dd\u898b\u3057\u3066\u3001\u305c\u3072\u81ea\u8eab\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3044\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\uff01\n\n\u3010\u3054\u4f9d\u983c\u3057\u305f\u3044\u5185\u5bb9\u3011\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\uff1a\u6708\u591c\u731f\u4ecb(\u8150\u7537\u5b50\u3001\u5143\u30a2\u30a4\u30c9\u30eb\u3068\u3044\u3046\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3067\u3059\u3002\u53c2\u8003\u753b\u50cfURL\u3092\u6dfb\u4ed8\u3044\u305f\u3057\u307e\u3059)\n\u8863\u88c5\uff1a\u53c2\u8003\u753b\u50cf\u5185\u306b\u3042\u308b\u30c7\u30d5\u30a9\u30eb\u30c8\u306e\u30a2\u30a4\u30c9\u30eb\u98a8\u8863\u88c5\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u30dd\u30fc\u30ba\u3084\u69cb\u56f3\u3001\u80cc\u666f\u306a\u3069\uff1a\n\u304a\u307e\u304b\u305b\u3044\u305f\u3057\u307e\u3059\u3002\u5168\u8eab\u306e\u7b4b\u8089\u3001\u7279\u306b\u80f8\u7b4b\u306f\u670d\u8d8a\u3057\u306e\u90e8\u5206\u3067\u3082\u76db\u308a\u4e0a\u304c\u3063\u3066\u3044\u308b\u306e\u304c\u3057\u3063\u304b\u308a\u5206\u304b\u308b\u304f\u3089\u3044\u5927\u304d\u304f\u5f37\u8abf\u3055\u308c\u305f\u3001\u7537\u3089\u3057\u3044\u30a4\u30e9\u30b9\u30c8\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u5b09\u3057\u3044\u3067\u3059(\u307e\u305f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306b\u306f\u4f53\u6bdb\u8868\u73fe\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u63cf\u753b\u306f\u53ef\u80fd\u3067\u3042\u308c\u3070\u3067\u69cb\u3044\u307e\u305b\u3093)\u3002\n\n\u4e0b\u8a18\u306e\u3068\u304a\u308a\u30b5\u30e0\u30cd\u30a4\u30eb\u7b49\u3078\u306e\u4f7f\u7528\u7528\u9014\u306e\u305f\u3081\u3001\u30ad\u30