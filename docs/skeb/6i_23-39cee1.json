weetly sleeping while being bathed in moonlight!\n\nI wish to request for an artwork suitable for EITHER good morning OR good night tweets, if possible!\nI entrust the pose and expression to your discretion\n\nThank you so much, hope you have fun with it\nI'm looking forward to the final result!", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6i_23/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3127627, "client_id": 744951, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72da5b47/uploads/origins/03acc4ee-5fc7-493b-a3f8-308d4dfb1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50b4842e85561af188552c0ed3b774ba", "srcset": "https://si.imgix.net/72da5b47/uploads/origins/03acc4ee-5fc7-493b-a3f8-308d4dfb1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50b4842e85561af188552c0ed3b774ba, https://si.imgix.net/72da5b47/uploads/origins/03acc4ee-5fc7-493b-a3f8-308d4dfb1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f19bb8f4df8c37eb4777b9b12684a526 2x, https://si.imgix.net/72da5b47/uploads/origins/03acc4ee-5fc7-493b-a3f8-308d4dfb1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=156b867fdaf0b9eed6a320d2f2ce5549 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72da5b47/uploads/origins/03acc4ee-5fc7-493b-a3f8-308d4dfb1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a6a4056ad5c31eb65318665a96a94fb", "srcset": "https://si.imgix.net/72da5b47/uploads/origins/03acc4ee-5fc7-493b-a3f8-308d4dfb1b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a6a4056ad5c31eb65318665a96a94fb, https://si.imgix.net/72da5b47/uploads/origins/03acc4ee-5fc7-493b-a3f8-308d4dfb1b33?bg=%23fff&auto=forma