/drive.google.com/drive/u/2/folders/18hNNTd7oaxgTt79IDzK77HZ9RnAE3WM0\n↑ 今回は女装系の服を試してみたいと思っています〜でも、もしほかのものがお好きでしたら、それを選んでいただいても全然大丈夫です！↑\n\nキャラクターに対する自分の考えに基づいて、自由に展開してもかまいません。これらの記述をもとに、自由に作成してください。\nありがとうございました！ (*´I`*)", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@da_10oo0/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2881280, "client_id": 1290734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b57fd8c6/uploads/origins/d2bd6bfc-e9d5-4f07-88fb-d30e7fb40b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8015c4f098eb9e47405ca3d2be930e0", "srcset": "https://si.imgix.net/b57fd8c6/uploads/origins/d2bd6bfc-e9d5-4f07-88fb-d30e7fb40b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8015c4f098eb9e47405ca3d2be930e0, https://si.imgix.net/b57fd8c6/uploads/origins/d2bd6bfc-e9d5-4f07-88fb-d30e7fb40b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=327d28e24f9f9440a7c1dc3394b136e1 2x, https://si.imgix.net/b57fd8c6/uploads/origins/d2bd6bfc-e9d5-4f07-88fb-d30e7fb40b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b6c494331da1add932d33fb12b477d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b57fd8c6/uploads/origins/d2bd6bfc-e9d5-4f07-88fb-d30e7fb40b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=547d5b2c8f1f4785cf86e501d50a6b5d", "srcset": "https://si.imgix.net/b57fd8c6/uploads/origins/d2bd6bfc-e9d5-4f07-88fb-d30e7fb40b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=547d5b2c8f1f4785cf86e501d50a6b5d, https://si.imgix.net/b57fd8c6/uploads/origins/d2bd6bfc-e9d5-4f07-88fb-d30e7fb40b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f