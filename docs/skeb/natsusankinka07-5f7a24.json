となります。\n御検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1089RaFyWNZh0aWmWpaIhfPaMfeNOdoio", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 529427, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦔おてん🦔", "screen_name": "if959u", "avatar_url": "https://pbs.twimg.com/profile_images/1406272195551055876/lM_zqnxg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790832008561692672/1687880086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 16}, {"id": 560681, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あおいイオ", "screen_name": "aoichan_io", "avatar_url": "https://pbs.twimg.com/profile_images/1580135055695151105/CdUT3bFR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1212070507907973120/1773134857/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 776999, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "いちまる", "screen_name": "iiiichimarU_03", "avatar_url": "https://pbs.twimg.com/profile_images/1636547213928333312/LwdyYOo8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/924212890244022272/1715219675/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2574452, "creator": true, "nsfw_accepta