\n可能でしたら、背景と人物は別レイヤーにて頂戴できましたら嬉しいです。\n\n以上ぜひお引き受けいただけた際はよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1tIfoW2U1s6MXDRDi5YaZy4AkYIJ9BN2K?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MikageYue_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3476966, "client_id": 1442577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5743bba4/uploads/origins/14974556-ab0d-436d-a2ec-bb98a04c10f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7165bc6e85a789646cfe234ae9fe6e83", "srcset": "https://si.imgix.net/5743bba4/uploads/origins/14974556-ab0d-436d-a2ec-bb98a04c10f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7165bc6e85a789646cfe234ae9fe6e83, https://si.imgix.net/5743bba4/uploads/origins/14974556-ab0d-436d-a2ec-bb98a04c10f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5b0761fb6b5301270b7ecdbf43d9307 2x, https://si.imgix.net/5743bba4/uploads/origins/14974556-ab0d-436d-a2ec-bb98a04c10f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85c05b495266027bca817169b8590791 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5743bba4/uploads/origins/14974556-ab0d-436d-a2ec-bb98a04c10f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=964d922b43a6bd9d8e0340939b6a11c3", "srcset": "https://si.imgix.net/5743bba4/uploads/origins/14974556-ab0d-436d-a2ec-bb98a04c10f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=964d922b43a6bd9d8e0340939b6a11c3, https://si.imgix.net/5743bba4/uploads/origins/14974556-ab0d-436d-a2ec-bb98a04c10f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5342be6d8d0626400315c50d6d4c053f 2x, https://si.imgix.net/5743bba4/