f2e-94f8-c19f3652a16a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9c861ca5ff95879cd6484b07710af0b", "srcset": "https://si.imgix.net/3a00b79f/uploads/origins/1a67adde-bb77-4f2e-94f8-c19f3652a16a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9c861ca5ff95879cd6484b07710af0b, https://si.imgix.net/3a00b79f/uploads/origins/1a67adde-bb77-4f2e-94f8-c19f3652a16a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6de701ca15ae5e0c1d089c5622a170b8 2x, https://si.imgix.net/3a00b79f/uploads/origins/1a67adde-bb77-4f2e-94f8-c19f3652a16a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0409d80982d1bf8596dc5b6f06ef89e 3x"}, "body": "いつもお世話になっております。この度小鈴さんにまたぜひ描いていただきたいと思うリクエストがあり送らせていただきました。\n遊戯王OCGのマドルチェ・プディンセス、マドルチェ・マジョレーヌ、フレッシュマドルチェ・シスタルトで以前描いていただいたようなJK学生ギャル衣装イラストをお願いしたいです。\n\nシチュエーション\n・TikTok的動画アプリで可愛い振り付けのダンス動画を並んで撮ってるようなイメージ\n\n構図\n・カメラ目線で並んでそれぞれ明るく可愛くギャルっぽいダンス+決めポーズ\n・センターにプディンセス、左右にマジョレーヌとシスタルトが挟む立ち位置\n\n服装\n・JKギャルらしい着こなしのミニスカ学生服+スイーツモチーフのワンポイントアクセサリー等を身につけてる\n\n表情\n・プディンセス：明るく満面の笑顔\n・マジョレーヌ：ちょっとドヤ顔気味+イタズラっ子ぽい笑み\n・シスタルト：優しく柔らかい笑顔\n\n体型\n・身長は三人とも同じくらい\n・ふとももは三人とも極太むっちむちに\n・シスタルトは服の上からしっかり分かるくらい大きいサイズの胸\n\nその他\n・背景は明るいハッピーフェスタのお祭りのようなイメージ\n・上記に加えプリクラっぽいキラキラ可愛い模様や加工・文字などが施されたようなイメージ ・小鈴さんの好みに合わせて髪型等アレンジいただいても構いません。プリクラ風文字無し差分も合わせていただきたいです。\n\nご多忙の中恐れ入りますが、どうかご検討のほどよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekofunjattatta/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1251113, "client_id": 931082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da0f9784/uploads/origins/13820837-8b18-4313-a4b4-ae826b97ed0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd38e8f696d27f57131c1652bc1198f7", "srcset": "https://si.imgix.net/da0f9784/uploads/origin