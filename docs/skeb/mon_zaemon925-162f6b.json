@mon_zaemon925/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3589310, "client_id": 3398775, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab32fe3643fee8d28a2a92015b5a616c", "srcset": "https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab32fe3643fee8d28a2a92015b5a616c, https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b480f7b7f2489eba4ed24a0392dfe702 2x, https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aca6dc491d10ad2a0de42e6cb6a4181f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dee0b308638e95fff18a578ae3c9da9a", "srcset": "https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dee0b308638e95fff18a578ae3c9da9a, https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df9d2a073f7da7ae9a1955fe876db6f6 2x, https://si.imgix.net/381b0f5d/uploads/origins/e322da7b-051a-4af5-b11d-0436a8bed412?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5047ca514f82270531f3b3fbbe6df8a 3x"}, "body": "はじめまして、こんにちは。\nOC「Nami」の新衣装テーマ「手偶師（パペット使い）」のイラストを一枚ご依頼したく思っております。\n\n全体の雰囲気は「かわいい・やさしい・童話風」を希望しています。構図やポーズは自由にお任せしますが、Namiの表情がよく見えて、少し天然でふんわりした可愛さが伝わると嬉しいです。\n\nNamiは人間の世界で暮らす小さな恐竜の女の子で、正体を隠すために手偶師として働いています。少し恥ずかしがり屋で天然ですが、内面はとても感情豊かです。その本当の気持ちは手偶が代わりに表現します。\n\n手偶は天気の魔法を持っており、\n怒ると小さな雲や雷、\n悲しいと小雨、\n嬉しいと虹や星、\n照れるとピンク色の雲が現れます。\n\n先生の作風で、Namiと手偶のやさしい世界を表現していただけたら嬉しいです。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1a-EHB_Jjhs4JjQdpzQ6kAVFukOie3TAM?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mon_zaemon925/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3589310, "client_id": 3867469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0dc8649c/uploads/origins/b74d08da-a965-48fc-9424-ce5b8c5b947d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b8c9da6daa0e987aa384ae5adbc501", "srcset": "https://si.imgix.net/0dc8649c/uploads/origins/b74d08da-a965-48fc-9424-ce5b8c5b947d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7b8c9da6daa0e987aa384ae5adbc501, https://si.imgix.net/0dc8649c/uploads/origins/b74d08da-a965-48fc-9424-ce5b8c5b947d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f011da5050ed24527722cb2817744927 2x, https://si.imgix.net/0dc8649c/uploads/origins/b74d08da-a965-48fc-9424-ce5b8c5b947d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0a41650b4a6f04f94a58b8dd98d7aef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0dc8649c/uploads/origins/b74d08da-a965-48fc-9424-ce5b8c5b947d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e86085d4648ae5a509eadf9f22b5d8e8", "srcset": "https://si.imgix.net/0dc8649c/uploads/origins/b74d08da-a965-48fc-9424-ce5b8c5b947d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e86085d4648ae5a509