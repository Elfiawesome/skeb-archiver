8363531915616\n\n右手は、下記リンクの怪人と同じ剣を持っている。\nhttps://kamenrider.fandom.com/wiki/Knight_Soldiers#Statistics\n\n全身を描いた全身絵。\n\nお忙しいところ恐れ入りますが、ご検討よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotora301/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/95b63668/uploads/origins/7d6b8006-2288-4e91-86f7-291e4095fcab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b129c4628820265f748383336e5ca9f", "srcset": "https://si.imgix.net/95b63668/uploads/origins/7d6b8006-2288-4e91-86f7-291e4095fcab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b129c4628820265f748383336e5ca9f, https://si.imgix.net/95b63668/uploads/origins/7d6b8006-2288-4e91-86f7-291e4095fcab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b08e9ce2a4b3855d198a14ac39629e90 2x, https://si.imgix.net/95b63668/uploads/origins/7d6b8006-2288-4e91-86f7-291e4095fcab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dcea4a759769ed81f175daeb270d2b8f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2718163, "nc": 144}, {"path": "/@kotora301/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2718163, "client_id": 1694533, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c5fb1a0/uploads/origins/3d22ae35-3ece-47cc-ab8d-50469395a2f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f2453df15b893e3e3f352f62080df0", "srcset": "https://si.im