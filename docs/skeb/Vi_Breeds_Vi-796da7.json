f82ef-4373-48d2-9b6f-f87bc454efa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b66e8a311427c3d74ef7d8e31134078 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/defbe965/uploads/origins/861f82ef-4373-48d2-9b6f-f87bc454efa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13e6c3b25c903043174142dec781e7a6", "srcset": "https://si.imgix.net/defbe965/uploads/origins/861f82ef-4373-48d2-9b6f-f87bc454efa2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13e6c3b25c903043174142dec781e7a6, https://si.imgix.net/defbe965/uploads/origins/861f82ef-4373-48d2-9b6f-f87bc454efa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e25c032fcb38f705abe0f77d6fd7b4a 2x, https://si.imgix.net/defbe965/uploads/origins/861f82ef-4373-48d2-9b6f-f87bc454efa2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a35cb19382949135dc5004ff294f7fe0 3x"}, "body": "こんばんは！\n先日は諸星大二郎ワールドと自分のアバターの世界観がうまく融合したイラストを描いて頂きましてありがとうございました。また、ますきゃドレスを着た姿もすごく良かったです。もちふぃったーをまだ触れていないので、時間が取れたら再現してみますね🦊\n\n今回も諸星大二郎ワールドと融合したものを描いて頂きたいです。\n\n## 世界観設定.\n- 『闇の客人』のパラレルワールドで、鬼踊りができる老人は祭の半年以上前に亡くなっている.\n- 大鳥居が再建され, 常世の国の風が僅かに入り込んでいる事を察知した自アバターが大鳥町に逗留.\n- 祭が始まり, 不可解な事件が起こる中, 稗田先生に出会う.\n- 常に事件現場に居合わせていて, 『足跡』のことを調べている様子から事件に関係していると疑われる. \n- 古文書に書かれた『踊り』ができる人間がいないので, 異形の腕の力で『オニ』を送り返す. \n\n## イラストに書いて欲しい要素.\n- 稗田先生(七星七草先生のテイストを活かしてください！)\n- オニ\n- 自アバター(異形の腕を解放した姿. キツネ耳としっぽは無し)\n衣装はワンピース希望です。リンク先資料の『遠野びび_ワンピース』というファイルを参照してください。アバターに合う色を2パターン用意しています。他のキャラや背景とのバランスを考慮して合う選んで欲しいです。自分には決められませんでした。稗田先生が黒いので、白いワンピの方がいいかな？\n\n自アバターが妖怪ハンターシリーズに登場したら・・・いいな！という思いでリクエストしてみました。\n\nhttps://drive.google.com/drive/folders/19qBn7eesuIuKyTqTGnlVzxSlEab1GXD2?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanakusa_sun/works/63", "private_thum