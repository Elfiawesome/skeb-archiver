メージと設定\nクールであまり表情が変わらない感じの美女です。外見年齢は20~25歳くらい。\nくわしくは↓のリンクを参照願います(中二病成分が多いです)。\nイラストには、異形の腕も描いて欲しいです！\n資料URLの「闇の客人 キャラクター設定 虚妄の声 びび skeb用」を参照願います！\n\n#いろいろな角度のお写真\n資料URLの「myAvatar イラスト用資料」のフォルダを参照願います！\n\nわたしも諸星大二郎作品のファンです。なので、自アバターの世界観設定には暗黒神話や妖怪ハンター的な成分が多分に含まれています。できれば、ヒルコやタケミナカタを引き連れて、異形の腕を構えているような構図希望です！\n\nhttps://drive.google.com/drive/folders/19qBn7eesuIuKyTqTGnlVzxSlEab1GXD2?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hopepene/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3383, "client_id": 104422, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7d46282/uploads/origins/0ba3aa15-4f30-42f4-8246-d25d8d22cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be007ea538130abaac0090237d973504", "srcset": "https://si.imgix.net/b7d46282/uploads/origins/0ba3aa15-4f30-42f4-8246-d25d8d22cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be007ea538130abaac0090237d973504, https://si.imgix.net/b7d46282/uploads/origins/0ba3aa15-4f30-42f4-8246-d25d8d22cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7199363ebcd516a312a57d5aa11d120d 2x, https://si.imgix.net/b7d46282/uploads/origins/0ba3aa15-4f30-42f4-8246-d25d8d22cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bafcf8c1975a0ec38a42d2c2eb178590 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7d46282/uploads/origins/0ba3aa15-4f30-42f4-8246-d25d8d22cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=578c2c36dd5a3c0fd7ad1fa8f7d0928c", "srcset": "https://si.imgix.net/b7d46282/uploads/origins/0ba3aa15-4f30-42f4-8246-d25d8d22cbc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=578c2c36dd5a3c0fd7ad1fa8f7d0928c, ht