ていたんです。頬を寄せ合い、観客を見つめ、手をつないでいるようなイメージです。また、彼のキャラクターは恥ずかしそうに無邪気に笑っていて、私のキャラクターはもっと恥ずかしそうに、でも攻撃的な口角を上げているような表情をしていたらいいなと思っていました。どちらも顔を赤らめているはずです。また、ワルツを踊るように指を組み、体を密着させてほしいです。google driveにこのようなポーズの画像を2枚用意し、1枚は私が求めている表情をそのままラベルにしたものです。\n\nキャラクターの衣装は少し機械的な面もあるので、これでいいのかなと思います。あなたのアートスタイルに憧れています。機械的な部分もあるけれど、可愛らしさもあるような、そんな絶妙なミックスを目指しています。どうか、ご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1PtQmZWcRt5wQhVHHICQIIHqj6Auw_-dz?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@makotono_nasu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2338312, "client_id": 2364917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1f4d39a/uploads/origins/e1183866-69fc-42a3-a91a-058e9d419de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b105138d25803629662d05948044c441", "srcset": "https://si.imgix.net/a1f4d39a/uploads/origins/e1183866-69fc-42a3-a91a-058e9d419de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b105138d25803629662d05948044c441, https://si.imgix.net/a1f4d39a/uploads/origins/e1183866-69fc-42a3-a91a-058e9d419de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfc5bdfa018ba3f82e7c17d6d5555730 2x, https://si.imgix.net/a1f4d39a/uploads/origins/e1183866-69fc-42a3-a91a-058e9d419de5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a7ac39e981d6f3c4f305af755d95207a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1f4d39a/uploads/origins/e1183866-69fc-42a3-a91a-058e9d419de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37ec2dc31f4ec25f24d07f6678ba357b", "srcset": "https://si.imgix.net/a1f4d39a/uploads/origins/e1183866-69fc-42a3-a91a-058e9d419de5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w