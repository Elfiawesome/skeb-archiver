 2x, https://si.imgix.net/d8f8e83c/uploads/origins/4a81cfa1-511b-4772-99db-d442ecfcd74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ab0e39cc01c1e397b077ca00e3b6523 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8f8e83c/uploads/origins/4a81cfa1-511b-4772-99db-d442ecfcd74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a84b716e167b50f126d952b574d7cee", "srcset": "https://si.imgix.net/d8f8e83c/uploads/origins/4a81cfa1-511b-4772-99db-d442ecfcd74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a84b716e167b50f126d952b574d7cee, https://si.imgix.net/d8f8e83c/uploads/origins/4a81cfa1-511b-4772-99db-d442ecfcd74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c91622b42e4a3d276f762f635d6e6288 2x, https://si.imgix.net/d8f8e83c/uploads/origins/4a81cfa1-511b-4772-99db-d442ecfcd74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41042696dff8ccc972375bd55706cfff 3x"}, "body": "ブサピョン様\n\nvtuber準備中の牛使メイと申します。\n活動で使用させていただくイラストを描いていただきたいと思ったので、リクエストを送らせていただきました。\n\n【キャラクター】\n牛使メイ(ushitsukamei)\nモチーフ：牛、メイド\n色：緑、白、黒\n配信内容：朝活、ASMR\n\n【キャラクター資料】\nhttps://x.com/ushitsukamei/status/2022596997958733989\nhttps://x.com/ushitsukamei/status/2039367294242165220\n\n【内容】\n・全ておまかせ致します。ヤンデレ化していただいて問題ございません。ASMR配信に使えそうなポーズや表情だと有難いですが、お好きに描いていただければと思います。\n・もし可能でしたら、髪型差分を描いていただけたら嬉しいです。難しいようでしたら、構いません。\n\n【使用用途】\n・収益化YouTubeチャンネルでの使用（配信内、動画内、サムネイル等）\n・ネットプリント\n・商用グッズ\n・SNS利用\nなどvtuber活動全般で使用させていただきたいです。\n\n【希望納品形式】\n可能であればPSD、\nまたは背景やキャラクター等を別々にしたPNGファイルで頂きたいです。\n\nこちらの条件で問題ない場合は、お受けいただけたら嬉しいです。\nご検討、どうぞよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shikabane573/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3935401, "client_id": 951419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42498458ac53346c05c543bc5f010d72", "srcset": "https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42498458ac53346c05c543bc5f010d72, https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e4cda99725ff5f970e185916c8b2fd1 2x, https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f5d01647fd77a8bb67eb42cabb140e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=231fcd44faaec624dd863ebcba345557", "srcset": "https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=231fcd44faaec624dd863ebcba345557, https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77434062214bb914b895a61f69f07bb7 2x, https://si.imgix.net/c3f6afcf/uploads/origins/768512e8-597b-480d-8a75-35b72d3ed4f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd0fe287be249abbecb6aac480157eee 3x"}, "body": "はじめまして、この度はVtuberの瀬尾君のホラーで怖がっているイラストをリクエストいたします。\n瀬尾さんには八重歯をお願いします。\n上着も着た状態で片手に懐中電灯、もう片手は顔か胸元においてください。\n視線はこちらを見ている様にして、怖がりながら涙目を浮かべてほしいです。\n出来れば腰から上くらいで頭等は見切れない様にお願いいたします。\n\n上記のリクエストでモデルの方の配信内での使用、サ