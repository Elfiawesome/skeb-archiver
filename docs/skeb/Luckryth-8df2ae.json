6\u3044\u305f\u3060\u304d\u307e\u3059\u3002\n\u4f55\u5352\u3001\u5b9c\u3057\u304f\u304a\u9858\u3044\u7533\u3057\u4e0a\u3052\u307e\u3059\u2026\u3002\n\n\uff0a\u4eba\u7269\n\u540d\u524d\uff1a\u8449\u53ef\u4e16 \u9ebb\u77e2(\u306f\u304b\u305b\u30fb\u307e\u3084)\n\u6027\u5225\uff1a\u5973\n\u5e74\u9f62\uff1a23\u6b73\n\u56fd\u7c4d\uff1a\u65e5\u672c\n\u901a\u79f0\u300c\u30cf\u30ab\u30bb\u3061\u3083\u3093\u300d\u3002\u300c\u3053\u3093\u306a\u3053\u3068\u3082\u3042\u308d\u3046\u304b\u3068\u300d\u7cfb\u306e\u8d85\u5929\u624d\u79d1\u5b66\u8005\u3002\u98db\u3073\u7d1a\u3067\u6a5f\u68b0\u5de5\u5b66\u3068\u751f\u5316\u5b66\u306e\u535a\u58eb\u53f7\u304a\u3088\u3073\u533b\u5e2b\u514d\u8a31(\u5c02\u9580\u306f\u7cbe\u795e\u79d1)\u3092\u53d6\u5f97\u3002\u30db\u30ef\u30a4\u30c8\u30cf\u30c3\u30ab\u30fc\u3068\u3057\u3066\u306e\u6280\u8853\u306b\u3082\u9577\u3051\u3001\u4eba\u6587\u7cfb\u306e\u6559\u990a\u3082\u6301\u3061\u5408\u308f\u305b\u308b\u30c1\u30fc\u30c8\u3055\u3093(\u305d\u3046\u3044\u3046\u4e16\u754c\u306a\u306e\u3067\u3059w)\u3002\u53e3\u7656\u306f\u300c\u3075\u3080\u2026\u300d\u3002\u6e29\u539a\u304b\u3064\u8d85\u7136\u3068\u3057\u305f\u6027\u683c\u3067\u3001\u6ec5\u591a\u306a\u3053\u3068\u3067\u306f\u53d6\u308a\u4e71\u3057\u305f\u308a\u3057\u307e\u305b\u3093\u3002\n\n\uff0a\u5916\u898b\n\u9aea\u8272\u306e\u30d9\u30fc\u30b9\u306f\u30ed\u30fc\u30ba\u30b0\u30ec\u30a4(RGB:157-137-137)\u3002\u9aea\u578b\u306f\u300c\u5927\u6b63\u30e2\u30c0\u30f3\u30ac\u30fc\u30eb\u307f\u305f\u3044\u306b\u3059\u308b\u3064\u3082\u308a\u304c\u3001\u30ef\u30ab\u30e1\u3061\u3083\u3093\u98a8\u304a\u304b\u3063\u3071\u306b\u306a\u3063\u3061\u3083\u3063\u305f\u300d\u3068\u3044\u3046\u611f\u3058\u306e\u5208\u308a\u4e0a\u3052\u77ed\u9aea\u30fb\u30aa\u30f3\u7709\u3071\u3063\u3064\u3093\u3002\n\u7279\u306b\u56f0\u3063\u3066\u3044\u306a\u304f\u3066\u3082\u4e0b\u304c\u308a\u6c17\u5473\u306e\u7709\u3001\u4e38\u3044\u76ee\u306e\u77b3\u306f\u4e00\u822c\u7684\u306a\u9ed2\u3001\u4f4e\u3081\u306e\u9f3b\u3002\n\u8eab\u