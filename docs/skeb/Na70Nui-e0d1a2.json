ipped": true, "creator_id": 3484378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac458883d0e58045cfe2dcd6e928bec1", "srcset": "https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac458883d0e58045cfe2dcd6e928bec1, https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c2506fe43bdf45b5e96366dfb5c1d63 2x, https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fab6cf5d0d0ef8d2f1268e07cecafe07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4876ea5fd81fe56d0339897c771db56", "srcset": "https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4876ea5fd81fe56d0339897c771db56, https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c802a0008b6d83d09856e30fe46bd91 2x, https://si.imgix.net/1972c444/uploads/origins/60b6038f-2be2-43b8-9997-4042d0d249a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9821a6e7a12c8b41afe8a947593c7a4a 3x"}, "body": "はじめまして。\nTwitchで配信活動をしているありさと申します。先程Twitterで水彩画のような透明感がある中にキラキラに輝く可愛いナースのイラストを見てすぐに依頼したい！！と思いご連絡いたしました。不慣れですので何が不備がございましたら申し訳ございません。\n\n・依頼内容\nくらげもち様の透明感溢れるキラキライラストで魔法少女やセーラームーンのような三日月をモチーフにした世界観で戦うイラストのお願いをしたいです。\n\n・ポーズ\n魔法少女やセーラームーンのステッキの武器ではなく、世界観のイメージに合うような可愛い銃を持っている。お洋服は可愛いレースやフリフリ衣装にハーネスなどをつけて少し戦闘チックな雰囲気も入ると嬉しいです。\n\n参考画のイヤモニ等はなくて大丈夫ですが、ヘアアクセやその他装飾があると嬉しいです。可能でしたら髪の毛、お顔、衣装は見切れないようにしていただけると嬉しいです。\n\n表情差分等あれば嬉しいですが、予算的に難しければ大丈夫です！追加費用で可能でしたら教えてください。\n\n・使用用途\n収益化している配信での使用、サムネイル、おはようVTuber等のXでの利用(使用の際はAI利用されないよう必ず素材等を重ねます)\n\nお手数ですが、PSDでの納品、キャラと背景を分けていただけるとありがたいです。。\n\n・性格\n天真爛漫で明るい性格。たまにツンデレ。\n・相棒\n牛の人形\n・チャームポイント\n三日月のヘアアクセ\n\nご縁がありましたら嬉しいです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1O6R0kZ_ceCxzok0CxEJLDNQrS1VHll9D", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Na70Nui/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3484378, "client_id": 438366, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f07d5c10/uploads/origins/35945302-e55d-4248-8e96-327c0ebca096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1448ee85da211c1fb744f7dd3a95a153", "srcset": "https://si.imgix.net/f07d5c10/uploads/origins/35945302-e55d-4248-8e96-327c0ebca096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1448ee85da211c1fb744f7dd3a95a153, https://si.imgix.net/f07d5c10/uploads/origins/35945302-e55d-4248-8e96-327c0ebca096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e234209ae7d536293d7487eb78ff2e3e 2x, https://si.imgix.net/f07d5c10/uploads/origins/35945302-e55d-4248-8e96-327c0ebca096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f6d3081579641d5f4977dbb0917667a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f07d5c10/uploads/origins/35945302-e55d-4248-8e96-327c0ebca096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7599ca3dc4d87f2a232a844708293e9", "srcset": "https://si.imgix.net/f07d5c10/uploads/or