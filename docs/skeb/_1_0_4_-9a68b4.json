e7/uploads/origins/af010566-27f2-4a7e-a911-27d083f2e175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0211cce08ffed0890ed2958a561ad5b, https://si.imgix.net/ab786fe7/uploads/origins/af010566-27f2-4a7e-a911-27d083f2e175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b9b516c0581a1d8183a3f430b2fa339 2x, https://si.imgix.net/ab786fe7/uploads/origins/af010566-27f2-4a7e-a911-27d083f2e175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77d0ed94d5e52c19256d1bdd8fd5f5ef 3x"}, "body": "先生こんばんは\n服：誇張された形で形が変化できることを強調したい\nタコ足のよう、鋸状の蔓に変わることもできる\n液体状で飛び散ることもある\n差分：服の亀裂は広がった\n先生が面白いと思う変換／シュールなものであれば何でもいいです\n髪型の違いも際立たせたい\n姉：髪が空中で渦を巻く\n赤髪の妹：髪は菊と彼岸花に似ている\n黒い線：亀裂と菌糸\nシナリオ\n超現実的な場所（水／クリームの表面）で踊っている。姉はすごく楽しそうに踊っている。妹は髪でバイオリンのような楽器（目がある）を演奏しながら踊って（動きは繊細）いる\n水平線も湾曲している\n未統合PSDとラフも以前と同様にお願いします。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1owd04vPbb7pqZ5NJhpUMifdloPRWRsr_?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_1_0_4_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 31323, "client_id": 506279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eed90761234811f6e3d19358183ccbae", "srcset": "https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eed90761234811f6e3d19358183ccbae, https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48b49d27e1c2eeb3690217e8424679ff 2x, https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80b97764a52af90ead790bc9f1b699c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9794218306d2508bf909675703382c98", "srcset": "https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9794218306d2508bf909675703382c98, https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=305609ab3c0b9d9696e5c3f6337526c6 2x, https://si.imgix.net/5a0ca07b/uploads/origins/c8c0d1e3-5086-4dec-b3e4-f490db8a839e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27bc8c80b17c0d437caf1275e376076f 3x"}, "body": "104先生こんにちは。\n\nキャラ\n浮いている髪や服はちょっと液体と菌みたい。服の目玉が本当に丸いんです、彼女が見ているものを見ている。ひび割れは深い。\n\nシュールな森\n花や茸があふれている。珍しいものもある。物が濡れている。空には太陽のように光る巨大な抽象的な形があるかも。\n\n赤髪の子がしゃがみこんで花や茸についた珍しいカタツムリを指で触って、調べている。好奇心旺盛な笑顔。\n白髪の子はドレスを使って花や美しい茸を集めている。口を開けて本当に嬉しそう。\n\n素足ですが草履や下駄の差分をぜひ見てみたいです。\n\nサイン、宛名、レイヤー結合しないpsdとラフもお願いできますか？ ありがとうございます！\n\nhttps://drive.google.com/file/d/1w-J45zC0eZVvilZh0pEk3yxUA7C7PeBU/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_1_0_4_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 31323, "client_id": 506279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e12071cb/uploads/origins/38259b96-d3d5-4879-b376-adf80f42dca1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee7e771db0eaf646398b5b98f8b8fde4", "srcset": "https://si.imgix.net/e12071cb/uploads/origins/38259b96-d3d5-4879-b3