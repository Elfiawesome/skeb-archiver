acceptable_same_genre": true}, {"path": "/@samugasamugatta/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3390432, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde7454eea7d1b82de9fc712aba5daba", "srcset": "https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bde7454eea7d1b82de9fc712aba5daba, https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96670299cf2115c7febd0ab4caac294c 2x, https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3067d923567ad9e9062093ba3c096517 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a501aa0fdeb8f7f1df80c15af39eb308", "srcset": "https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a501aa0fdeb8f7f1df80c15af39eb308, https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77ebd3a2b457736d425b1d38fe3fe144 2x, https://si.imgix.net/95884048/uploads/origins/caa045f5-921c-4e60-a73a-9f62320d2dee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5e29522b50ade8391c9ea82174b7134 3x"}, "body": "こんにちは！お忙しいところ大変申し訳ないのですが、