-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c28c6720215a49e5eb411cf00cde843", "srcset": "https://si.imgix.net/b24a67ff/uploads/origins/7374e6ec-a942-4180-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c28c6720215a49e5eb411cf00cde843, https://si.imgix.net/b24a67ff/uploads/origins/7374e6ec-a942-4180-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddb634f7dc1cbf1421fa29df036bfd93 2x, https://si.imgix.net/b24a67ff/uploads/origins/7374e6ec-a942-4180-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22562cc0f733da436b941c9dfa3be5ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b24a67ff/uploads/origins/7374e6ec-a942-4180-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=642e879cd1d70e546f67c5b380b3963a", "srcset": "https://si.imgix.net/b24a67ff/uploads/origins/7374e6ec-a942-4180-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=642e879cd1d70e546f67c5b380b3963a, https://si.imgix.net/b24a67ff/uploads/origins/7374e6ec-a942-4180-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58fb75de1d6d5abc17495248db59062f 2x, https://si.imgix.net/b24a67ff/uploads/origins/7374e6ec-a942-4180-b9a6-5ea10d07b81b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd074af3aa2bcfb503e1d98914f0f2b1 3x"}, "body": "こんにちは。\nすてきなおっぱいをたくさん描かれていますね。\n貴方の絵柄でうちの子「にぷら」を描いて頂きたいです。\n\n【にぷら　設定】\n黒長髪、黒尻尾、黒い服を好んで着る猫耳少女。（黒縞パンを穿いている）\n服はおへその見える短い上着、ミニスカート。\nちっちゃいけどお胸はおっきい。トランジスタグラマー。\nツリ目だけどとっても元気で優しい。\nご主人（飼い主）大好き。鈴のついた首輪をしている。アホ毛がある。\n\n【描いて頂きたいもの】\nhttps://www.pixiv.net/artworks/125218072\nこのような体勢とアングルで、足をＭ字に開いているもの。\nおっぱいもエッチ度も好きなように盛ってもらって結構です。\n表情はきょとん。\n\n【参考資料】\n私は絵描きではないので自作資料はありません。\n他の方に描いて頂いたうちの子がいくつかありますので\nよろしければユーザーページを参考にしてください。\n最近の作品に多いです。\nhttps://skeb.jp/@Cat_A_nipla1\n\nかわいくエッチに描いていただけると嬉しいです。\n気が向きましたらよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotoriobakekai/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1780852, "client_id": 3273322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a27730e0/uploads/origins/cfbd6eeb-35ef-4a26-b6de-325ad35ae681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b345ef6c65bd44a153ad4b90a2c7f38", "srcset": "https://si.imgix.net/a27730e0/uploads/origins/cfbd6eeb-35ef-4a26-b6de-325ad35ae681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b345ef6c65bd44a153ad4b90a2c7f38, https://si.imgix.net/a27730e0/uploads/origins/cfbd6eeb-35ef-4a26-b6de-325ad35ae681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c30ff1d9feef8a4970d589b679ba9ead 2x, https://si.imgix.net/a27730e0/uploads/origins/cfbd6eeb-35ef-4a26-b6de-325ad35ae681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=840077c9de73b275363d9957cd182b23 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a27730e0/uploads/origins/cfbd6eeb-35ef-4a26-b6de-325ad35ae681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f529c6d62ae9eac1cd01f00b7cad88a", "srcset": "https://si.imgix.net/a27730e0/uploads/origins/cfbd6eeb-35ef-4a26-b6de-325ad35ae681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f529c6d62ae9eac1cd01f00b7cad88a, https://si.imgix.net/a27730e0/uploads/origins/cfbd6eeb-35ef-4a26-b6de-325ad35ae681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7d06dc0bccfb99e3829df4c85c6a421 2x, https: