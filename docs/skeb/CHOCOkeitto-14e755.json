\u3066\u304a\u308a\u307e\u3059\u3001\u5802\u672c\u771f\u5f18\u3068\u7533\u3057\u307e\u3059\u3002\n\nX\u306b\u3066\u52df\u96c6\u30dd\u30b9\u30c8\u3092\u62dd\u898b\u3057\u3001\u3051\u3044\u305f\u308d\u69d8\u306e\u30a4\u30e9\u30b9\u30c8\u304c\u7d20\u6575\u3060\u306a\u3068\u601d\u3044\u30ea\u30af\u30a8\u30b9\u30c8\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\uff01\n\u69cb\u56f3\u306f\u304a\u4efb\u305b\u81f4\u3057\u307e\u3059\uff01\uff01\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\nYouTube\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u3084X\u3067\u306e\u6295\u7a3f\u306a\u3069\u3001\u6d3b\u52d5\u5168\u822c\u3067\u4f7f\u7528\u3055\u305b\u3066\u9802\u304d\u305f\u3044\u3067\u3059\u3002\nX\u306e\u30dd\u30b9\u30c8\u306b\u3066\u5546\u7528\u5229\u7528\u53ef\u80fd\u3068\u66f8\u304b\u308c\u3066\u3044\u307e\u3057\u305f\u306e\u3067\u30b0\u30c3\u30ba\u306a\u3069\u306e\u4f5c\u6210\u3092\u3055\u305b\u3066\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u4e0d\u53ef\u306a\u5834\u5408\u5225\u7528\u7d19\u306b\u3066\u8a18\u8f09\u4e0b\u3055\u308b\u3068\u52a9\u304b\u308a\u307e\u3059\n\n\u3010\u304a\u9858\u3044\u3057\u305f\u3044\u5f62\u5f0f\u3011\nPSD\u30c7\u30fc\u30bf\u3067\u306e\u7d0d\u54c1\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n(\u4e0d\u53ef\u306a\u5834\u5408\u305d\u308c\u305e\u308c\u304c\u30ec\u30a4\u30e4\u30fc\u5206\u3051\u3055\u308c\u305fPNG\u30c7\u30fc\u30bf)\n\n\u4eba\u7269\u3068\u80cc\u666f\u304c\u5206\u304b\u308c\u3066\u3044\u308b\u30c7\u30fc\u30bf\u3068\u6587\u5b57\u304c\u5165\u308b\u5834\u5408\u306f\u3053\u3061\u3089\u3082\u30ec\u30a4\u30e4\u30fc\u5206\u3051\u3057\u3066\u9802\u304d\u305f\u3044\u3067\u3059\u3002\n\u4eba\u7269\u306e\u982d\u3084\u5de6\u53f3(\u9aea\u306e\u6bdb\u306a\u3069)\u304c\u5207\u308c\u306a\u3044\u3088\u3046\u306b\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\uff08\u4f7f\u7528\u3055\u305b\u3066\u3044\u305f\u3060\u304f\u969b\u306b\u81ea\u7531\u5ea6\u304c\u9ad8\u307e\u308a\u5927\u5909\u52a9\u304b\u308a\u307e\u3059\uff