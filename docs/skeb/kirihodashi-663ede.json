-8a014f09d598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46704fa71ba8200952c94c0dd0cdea4c, https://si.imgix.net/1de04548/uploads/origins/26153eac-d1c8-4bea-be95-8a014f09d598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2a42d04e0278eb8b78177e0844cbcd9 2x, https://si.imgix.net/1de04548/uploads/origins/26153eac-d1c8-4bea-be95-8a014f09d598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9368cd15d6201ca694f08ad9f521e687 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1de04548/uploads/origins/26153eac-d1c8-4bea-be95-8a014f09d598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e9dcd2ab499e54f68dfb40cd5be5a8", "srcset": "https://si.imgix.net/1de04548/uploads/origins/26153eac-d1c8-4bea-be95-8a014f09d598?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30e9dcd2ab499e54f68dfb40cd5be5a8, https://si.imgix.net/1de04548/uploads/origins/26153eac-d1c8-4bea-be95-8a014f09d598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45b7056ce13507e8bc95335c9df1e3ef 2x, https://si.imgix.net/1de04548/uploads/origins/26153eac-d1c8-4bea-be95-8a014f09d598?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd4704d3bc1bbf9d46b29eead4fba5a 3x"}, "body": "依頼させていただきます。\n\n先日描いていただいた絵の背景に映っていたキャラクターについて依頼させていただきます。\nhttps://twitter.com/kirihodashi/status/1572657249365135362/photo/1\n左のウェイトレス（人間基準で170cm後半、ショートブーツ(脛の中央よりやや下位の丈）を履いている）\n右のモブ兵士（人間基準で170cm前半、黒タイツ、穏やかそうな印象）\nデザインや装飾はお任せします。\n\n今回も２枚構成でお願いします。\n１枚目：設定画\nキャラクターの設定。２名の立ち絵（立ち絵のみでも構いません）\n\n２枚目：一枚絵\n人間（彼女から見て20㎜強）を足で弄んでいる絵（人間は薄い黒塗りで表記願います）\n詳細\n店のバックヤードで低い荷箱（高さ30ｃｍ強位）に座ったウェイトレスがブーツを脱いだ素足で小人を弄び、それをうっとりした嗜虐的な表情で見下ろしている。\nモブ兵士はやや後ろで膝に手を当ててかがんでおり、顔を赤くしてそれを見ている。\n参考：https://twitter.com/koimmd_/status/1317922245868597249/photo/1\n足をかなり強調して大きく描いていただければと思います。\nブーツが足の近くに脱ぎ捨てられており、一つは立ったまま、もう一つは口を向けている。\n参考だと、やや足よりやや後ろにブーツがありますが、足のすぐ横位で描画願います。\n他仔細はお任せします。妙な依頼かもですがよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kirihodashi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 181130, "client_id": 1219786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=303899c2a58bce3866fd39752868c1f8", "srcset": "https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=303899c2a58bce3866fd39752868c1f8, https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48dc251e9abbc8789f814268fa73a97b 2x, https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2912fd0e1ed96631aca990d6d1f66cd9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ddaccc1353c51ae04ad1af78e5fdbb8", "srcset": "https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ddaccc1353c51ae04ad1af78e5fdbb8, https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e59de2b94a3f85945e49b3c7c38b260 2x, https://si.imgix.net/b0221464/uploads/origins/8a1f9d13-090f-4916-b89d-73c543be6a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aca3cb30ff9e9b0b617e9f2464bd2937 3x"}, "body": "初めまして。きさらめ先生のイラストが好みでしたので依頼させていただきます。\n・作品名　ネプテューヌV、同ANIMATION\n・キャラ　キセイジョウ・レイ(タリの女神)\nこのゲームのメインキャラはゲーム機の擬人化で、女神と名乗る変身ヒロインです。\nキセイジョウ・レイはラスボスで、闇の力を使い変身します。\nシアンハートと名乗り悪堕ちしなかった並行世界という二次設定です。\n詳細はこちらをご確認ください。\nhttps://skeb.jp/@danneko_narou/works/2\n\n・衣装 \nプロセッサ(ボディスーツ)\n3Dモデルの肩アーマー\n同ヘッドギア\n3Dモデルのものを両目に広げヒロイックにアレンジしたようなバイザー\nバイザー以外大幅な形状のアレンジなどは無いようにお願いしたいです。\n背景はアニメ最終決戦シーンのような禍々しい雰囲気と神々しいものを差分でお願いします。\nポーズその他等はお任せしますが、セクシーでヒロイックな感じでお願いします。\n描きにくいところは省略していただいて構いません。\n\n料金上可能でしたら以下も差分でお願いします。\n・ヘッドギアとバイザーの着脱\n・バイザー下の眼透過\n難しい依頼かもしれませんが、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/94610189\nhttps://www.models-resource.com/pc_computer/hyperdimensionneptuniarebirth3vgeneration/model/11926/\n\nhttps://drive.google.com/drive/folders/1-3Bi1tVoD4m7rmoNXTMhtbqLoOhsEh2t", "nc": 35, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kirihodashi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 181130, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7722bd9bd03b70df445074361ff7ab9", "srcset": "https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7722bd9bd03b70df445074361ff7ab9, https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48ecf5f0ad5a7ee3bc167bdb32ce91b9 2x, https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e616867b927b26624c0b4e0d75521345 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=815aad71f14bde64c0b6bcb5449f876b", "srcset": "https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=815aad71f14bde64c0b6bcb5449f876b, https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce8fa6cddf2616d2b1f620672ad72c38 2x, https://si.imgix.net/25e9a1eb/uploads/origins/507df287-a529-47c4-9afd-521f5300c762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92718bcfdb1aa9f94dc9afef552cd7f5 3x"}, "body": "オリキャラデザインに惹かれました。\n良ければ下記内容のオリキャラデザインをお願いします。\n\n●設定\n名前はヴィーザ\n荒廃した未来世界で活躍する傭兵部隊《ヒルドルヴ》に所属する神秘的で妖艶な美少女。\n《第3世代強化人間》で、アンドロイドやサイボーグすら凌駕する戦闘力を有する。\n孤児であった彼女は秘密結社に拉致され強化人間とされたが組織の研究所がヒルドルヴに壊滅させられた際に救出され部隊の隊員となった。\n\n・性格\n物静かで感情に乏しい。\n\n●外見\n銀髪、金の瞳。\n涼しげな美貌に巨乳、太めの肉感的な脚をした美少女。\n細胞は老化抑制を施され、骨は軽量剛性チタンに置き換えられている\n\n●髪型\n下記URLのような銀髪ロングヘア。\nhttps://appmedia.jp/wp-content/uploads/2019/09/c37a1670608793fc7d711debf36bf061.jpg\n\n●服\n下記URLのようなタクティカルファッション。\nhttps://img.amiami.jp/images/product/review/221/FIGURE-136253_01.jpg\nオーバーサイズな上着、下乳とヘソを露出したハイレグボディスーツ、そして上記イメージからのアレンジとしてボトムは前垂れではなく下記URLのような張り裂けそうなピチピチのホットパンツ。\nhttps://img.animanch.com/2020/08/6ee97dec8f04462167ac3c1dc5a5fc0c.png\n\n・カラー\n全体的に黒を基調とし、上着の裾には《HILDOLFR》の文字、上着の胸に隊のマーク\n\n・隊のマーク\n下記URLにある《狼》のマーク。\nhttps://twitter.com/er114_k/status/1500467179455913985?s=21&t=f7n6YRLSxr8udD11vrkynw\n\n●武器\n下記URLのような大型機械式の鞘と長い柄のあるビーム刀。\nhttps://pbs.twimg.com/media/FZTkK9waIAAQKz3?format=jpg&name=large\n\n・武器設定\n名称《ビャクヤ》\nジェネレーターを内蔵した大型の鞘でエネルギーを溜め、抜刀すると同時に大出力ビーム刀身を形成する最新鋭の兵器。\n鞘は大型で柄や鍔が日本刀に近い意匠", "nc": 51, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kirihodashi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 181130, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d96c1c0f23ff2de0c6175324db5d02f", "srcset": "https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d96c1c0f23ff2de0c6175324db5d02f, https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2917b354ba5dccfaca141f0b74571a6 2x, https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=069892c84716387444a4131ffcd257ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d76caa1151da5f8296b62a6372360801", "srcset": "https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d76caa1151da5f8296b62a6372360801, https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=919259f33fb18d4a2e6f87d594c5d802 2x, https://si.imgix.net/c4772342/uploads/origins/5f125cd6-4e8f-4775-a4a6-de3d92b23762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=874e70a2af33a30e9866db0aea8e96a9 3x"}, "body": "依頼させていただきます。\n\n先日依頼さえていただき現在描画中のキャラクターについて、依頼させていただきます。\n\n今、パワードスーツ的なものを着用した状態で描いていただきましたが、\n\n今回は平服版（軍隊上の）をお願いします。\n参考：https://twitter.com/flagtype_V01/status/1089553388705001472\nデザインや装飾はお任せします。（近未来的でイメージを損なわない程度に装飾を付けていただければと思います。また、小さい略帽\n参考：https://www.pixiv.net/artworks/68538308の２枚目\nを追加していただければと思います。）\n\n今回も２枚構成でお願いします。\n１枚目：設定画\nキャラクターの設定。右側にキャラの全身図。ポーズ等は前回と異なれば任意でお願いします。\n左側に人間との大きさ比較ができるような足元のアップ（人間は薄い黒塗りで表記願います。なるべく空白がでないように大きく描画願います）\n参考：https://twitter.com/YoHomeboyRaps/status/1466838984009531392/photo/2\n\n２枚目：一枚絵\n人間（彼女から見て５０㎜強）を右手でつまみ上げている絵（人間は薄い黒塗りで表記願います）\n詳細\n右手で人間をつまみ上げ、左手の甲を顎に当てている\n彼女は意地悪そうな笑みを浮かべている。\n服は１枚目と同じ\n参考より広い範囲（上半身のアップ、というのは変わりませんが、胸元の真ん中や右手の袖口が絵に入るように描画願います）\n参考：https://twitter.com/XkonZigzagx/status/1540645643706073088/photo/1\n\n他仔細はお任せします。妙な依頼かもですがよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kirihodashi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 181130, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee49dafc2f0752a05fb74876373b92e", "srcset": "https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ee49dafc2f0752a05fb74876373b92e, https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=298f527094d91f068e7765d3a7294266 2x, https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dac8d6d52e8882d1463f301595dc608c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e93cf29f7a6bd4387d2b8d302a1b917", "srcset": "https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e93cf29f7a6bd4387d2b8d302a1b917, https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36dc8d3a496d98a6936767a0c6da40ba 2x, https://si.imgix.net/930b23d8/uploads/origins/05b2bd77-769e-4f53-bf72-052ed8e69042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fe1089bbbba9b03e0e19e8d10c1c5be 3x"}, "body": "初めまして、依頼させていただきます。\n\n以下のようなオリジナルキャラクターを作っていただけないでしょうか。\n\n〇概要\nコンセプト：巨大インベーダー\nマクロスの巨人種族やガンツ最終章の敵のような感じ（大きさ以外の外見は人間と同じ）\n\n外見\nボディスーツ、ウェットスーツのようなインナーの上にかなりごつい装甲服（パワードスーツ）を着ている。\nイメージ：https://www.pixiv.net/artworks/62255600\n\n容姿等\nクールで落ち着いた印象、２０代前半。スタイルがいい。\n身長５０ｍ強（人間基準では１７０㎝強）\nしかし、戦闘が長引いたり、敵が手ごわかったりすると好戦的かつ狂暴な一面が見える。\nイメージ：https://recreators.tv/character/02/\n\n武装\n近未来的な銃火器、近未来的な実体剣\n\nその他\nhttps://www.pixiv.net/artworks/91816761\nのような設定画（表情と小物類、全身図が入っていれば問題ないです。３面図は省略していただいた構いません）\nhttps://www.pixiv.net/artworks/83795625\nのような絵（近くに大きさの対比ができるもの（ビル等）があり、人間目線位のかなり強い見上げるような構図でキャラの巨大さが際立つ）\n\nの２枚構成でお願いします。\n※２枚が無理そうでしたらキャンセル願います。\n\n他仔細につきましてはお任せします。何卒よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 288315, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こね田ぱん🍞3/27〜大分別府OCF", "screen_name": "ppppin55", "avatar_url": "https://pbs.twimg.com/profile_images/1906853322927292416/em2eFPqB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/877025129376567296/1746282394/1500x500", "appeal_receivable": false, "popular_creator_ran