です、\nショタの靴下姿(特に靴下足裏)が好きですので構図はそんな構成でお願いします。\n\nキャラの背景透過と原寸未統合PSDファイルの提供をお願いします。\n出来た作品(キャラ)は個人用のSNS関連の使用などと\nグッズ化を含めた個人使用予定や作品(キャラ)を他のクリエイターに描いていただくこともございます。\nご検討のほどお願いいたします。\n\nhttps://skima.jp/dl/detail?id=280634", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1sPu2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1986253, "client_id": 430830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dd7710f/uploads/origins/10c500f4-29b8-4b69-b9a7-990a9a34917c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7810a7268b0c83fc49527ef6fd2c0dc7", "srcset": "https://si.imgix.net/5dd7710f/uploads/origins/10c500f4-29b8-4b69-b9a7-990a9a34917c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7810a7268b0c83fc49527ef6fd2c0dc7, https://si.imgix.net/5dd7710f/uploads/origins/10c500f4-29b8-4b69-b9a7-990a9a34917c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=581bc9987a04625aa0501c4b63150497 2x, https://si.imgix.net/5dd7710f/uploads/origins/10c500f4-29b8-4b69-b9a7-990a9a34917c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8fdf06dd9035a8340dc96b9c8453b44 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dd7710f/uploads/origins/10c500f4-29b8-4b69-b9a7-990a9a34917c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=602cd86f0f550fe48c9e71601c7b3752", "srcset": "https://si.imgix.net/5dd7710f/uploads/origins/10c500f4-29b8-4b69-b9a7-990a9a34917c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=602cd86f0f550fe48c9e71601c7b3752, https://si.imgix.net/5dd7710f/uploads/origins/10c500f4-29b8-4b69-b9a7-990a9a34917c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=602118a7e9645b86