si.imgix.net/d6ae2b72/uploads/origins/60805758-6d11-4088-8737-2fbd4e40d13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ae0564c243f56632860036086588e53, https://si.imgix.net/d6ae2b72/uploads/origins/60805758-6d11-4088-8737-2fbd4e40d13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e4885213ad5608ea6b7f22e98c9764e 2x, https://si.imgix.net/d6ae2b72/uploads/origins/60805758-6d11-4088-8737-2fbd4e40d13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9fd5d8361ac5fc6a18f226d92e2a412 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6ae2b72/uploads/origins/60805758-6d11-4088-8737-2fbd4e40d13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7031584b20f75d4790fcf3f55fb64997", "srcset": "https://si.imgix.net/d6ae2b72/uploads/origins/60805758-6d11-4088-8737-2fbd4e40d13c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7031584b20f75d4790fcf3f55fb64997, https://si.imgix.net/d6ae2b72/uploads/origins/60805758-6d11-4088-8737-2fbd4e40d13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69df70678a821915cb4ceaf7c9288328 2x, https://si.imgix.net/d6ae2b72/uploads/origins/60805758-6d11-4088-8737-2fbd4e40d13c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=046448cf9df81014abb422cd5a5fd312 3x"}, "body": "音透さん\n\nいつもお世話になっております、冬原水稀です。大好きな音透さんの絵柄で、私の創作キャラが見たいと思い、ご依頼失礼いたします。\n\n──\n\n【依頼内容】\n自創作『ディー・フレディア』に登場する\n・クリスタル・アーロック（以下「クリス」）\n・ショウスイ（以下「ショウ」）\nの二人組が1つのキャンバスに映った1枚絵\n\n【目的】\n観賞用・私用の待ち受け画面への使用など\n\n【特徴】\n○クリス……感情が欠落しているため、いつも基本無表情。横髪が肩ほどまである。戦闘方法は体術。\n○ショウ……無表情なクリスの代わりに、物腰も表情も柔らかい。髪型はウルフカット。人間ではないので、クリスよりも肌が白い。戦闘方法は双剣。\n\n○2人共通して、イメージカラーは〈透明〉であり、モチーフはクリスタル（水晶）。顔立ちは双子のように似ている。※きちんとした立ち絵は、最後に添付したリンクをご覧いただけますと幸いです。\n\n【その他】\n構図、キャンバスなど特に指定なし。全身が映っていない構図でも大丈夫ですが、ただクリスの水晶のネックレスは映っていると嬉しいです……！\n\n──\n\nよろしくお願いいたします。\n\nP.S. もしも「一回のご依頼で書くことが出来るのは1人」とのことでしたら、クリスのみを描いてくださったら嬉しいです！\n\nhttps://x.com/H_s0mizu0/status/1637058594192642048?t=j7u2xuCdRqxH4KpwG6jAQg&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 56034, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かんきつるい🍊Commission Open", "screen_name": "House_of_citrus", "avatar_url": "https://pbs.twimg.com/profile_images/1946432490765201408/ECw5FNwR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/836057858093404162/1739173269/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 1071372, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "沢田りく", "screen_name": "sawadariku75", "avatar_url": "https://pbs.twimg.com/profile_images/1366755297205784579/flG8Rrhg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1366654487478235140/1754973562/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 160}, {"id": 1848436, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "彩田花道 SAITA Hanamichi", "screen_name": "Hanamichi_pic", "avatar_url": "https://pbs.twimg.com/profile_images/1550026670781788160/r30LYxJ_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1464171286641328128/1668349105/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "a