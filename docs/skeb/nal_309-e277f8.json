33-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7438c0daaedb9e200d5e39d6ddfae157", "srcset": "https://si.imgix.net/96693d07/uploads/origins/5d20573d-5892-4d97-a933-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7438c0daaedb9e200d5e39d6ddfae157, https://si.imgix.net/96693d07/uploads/origins/5d20573d-5892-4d97-a933-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3cf013aacce30de2e4d902170aa70e06 2x, https://si.imgix.net/96693d07/uploads/origins/5d20573d-5892-4d97-a933-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa8b8a682089580feb8cc59281c4a4cd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96693d07/uploads/origins/5d20573d-5892-4d97-a933-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e7afe7bc4bbbe499623db21ef511e3e", "srcset": "https://si.imgix.net/96693d07/uploads/origins/5d20573d-5892-4d97-a933-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e7afe7bc4bbbe499623db21ef511e3e, https://si.imgix.net/96693d07/uploads/origins/5d20573d-5892-4d97-a933-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9973e51193af27dd72adfbdd2bdb41a5 2x, https://si.imgix.net/96693d07/uploads/origins/5d20573d-5892-4d97-a933-d08a500ecb9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c973b463c1fe6ca9722556a8f1c9a504 3x"}, "body": "先日は素敵なイラストをありがとうございます。\nまたリクエストをお願いします。\n\n【キャラ】\n艦これのザラ、狭霧\n\n【シチュエーション】\n裸エプロン！ケッコンザラ姉さま＆狭霧ちゃんのW裸エプロンです！\n\nお出迎え＆新婚三択のイメージですが、裸エプロンであればお出迎えシチュに限らずともOKです。\n裸エプロンで肝要なのは横乳なのです！\n特にザラ姉さまはどーん！どどーん！と強調をお願いします。\n\n二人とも見えるようにケッコン指輪をお願いします。付けてるのがわかれば目立たなくても大丈夫です。\n\n【衣装】\n裸エプロンです！（衣装とは？）\nザラ姉さまは上から見える谷間強調、狭霧ちゃんのエプロンは胸元にハートの穴とかあるのはどうでしょう？えっちに見えるならハート型でなくてもOKです！\nエプロンのデザインや模様は新婚感のある感じだとうれしいです。\n大事なのでここでも記載しますが、二人とも必ずケッコン指輪をお願いします。\n\n【お胸の大きさ】\nザラ姉さまはどーんより大きくどどーん未満、狭霧ちゃんはちょっと大きめで、どーんのぎりぎり手前くらいでお願いします。\nザラ姉さまはどどーん未満でもロケぱいなので、横乳がきっと映えるのです。\n\n【その他】\n提督の呼び方は「あなた」でお願いします。\n「あ・な・た」や「あ❤な❤た❤」などのアレンジもOKです。\n\n詳細や指定していない部分はすべておまかせします。\n\nどうぞ、よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nal_309/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3329562, "client_id": 202590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3380a6a/uploads/origins/8b897c58-a38f-4e55-8953-c4cb7b248175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b284e43acf6318b0a130bac01cb561c", "srcset": "https://si.imgix.net/e3380a6a/uploads/origins/8b897c58-a38f-4e55-8953-c4cb7b248175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b284e43acf6318b0a130bac01cb561c, https://si.imgix.net/e3380a6a/uploads/origins/8b897c58-a38f-4e55-8953-c4cb7b248175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bce24811f52b78dd0adcac10c85cb0ef 2x, https://si.imgix.net/e3380a6a/uploads/origins/8b897c58-a38f-4e55-8953-c4cb7b248175?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26bc38c8ec1bf3b05a1a8dbfed4c4bde 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3380a6a/uploads/origins/8b897c58-a38f-4e55-8953-c4cb7b248175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f28a04fdc15791d4bb7632bd6b43acb", "srcset": "https://si.imgix.net/e3380a6a/uploads/origins/8b897c58-a38f-4e55-8953-c4cb7b248175?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f28a04fdc15791d4bb7632bd6b43acb, https://si.imgix.net/e3380a6a/uploads/origins/8b897c58-a38f-4e55-8953-c4cb7b248175?bg=%23fff&auto=forma