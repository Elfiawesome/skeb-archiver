6e6e0725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8f9781f9eaaa162fe6cb8d440e7817c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f5d3546/uploads/origins/e753ee40-8e01-47eb-81aa-e77d6e6e0725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62ca7e83da3ac41051ad0d0c203e5b6a", "srcset": "https://si.imgix.net/2f5d3546/uploads/origins/e753ee40-8e01-47eb-81aa-e77d6e6e0725?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62ca7e83da3ac41051ad0d0c203e5b6a, https://si.imgix.net/2f5d3546/uploads/origins/e753ee40-8e01-47eb-81aa-e77d6e6e0725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0d5334194836f916b32dc5cd01e0ae4 2x, https://si.imgix.net/2f5d3546/uploads/origins/e753ee40-8e01-47eb-81aa-e77d6e6e0725?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81d16e2094847807c2991d08093e9e41 3x"}, "body": "こちらでははじめまして！\nリクエストの募集を開始されていましたので、早速ですがリクエストをお願いします。\n\n【キャラ】\n艦これの間宮、鳳翔\n\n【シチュエーション】\n狭霧の水着を着た間宮さんと鳳翔さん\n二人がきゃっきゃっうふふしているというか、仲の良い感じだとうれしいです。\n「私たちの水着、どうですか？」と提督にお披露目しているイメージです。\n夏らしく爽やかな雰囲気です。\n\n【衣装】\n前述のとおり、狭霧水着ですが色の変更をお願いします。\n\n間宮さん：狭霧水着・黒\n鳳翔さん：狭霧水着・白（デフォルト）\n\nアクセサリーや小物などの選択はおまかせします。\n髪型のアレンジも歓迎です。\n\n【お胸の大きさ】\n間宮さん：どどーん\n鳳翔さん：どーん\n\n間宮さんの方が大きければ、鳳翔さんもどどーん級になるのはOKです。\n\n【差分】\n可能であれば二人とも白verと黒verをお願いします。\n合計はデフォルト含めて3パターンです。\n①デフォルト　間宮さん黒・鳳翔さん白\n②二人とも白水着\n③二人とも黒水着\n\n加えて間宮さんと鳳翔さんのそれぞれ一人づづのファイルの納品もしていただけますとうれしいです。\n\n\nご検討いただけますと幸いです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 492803, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🌷みずのととり🌷 Skeb募集中🔰", "screen_name": "mizunototori39", "avatar_url": "https://pbs.twimg.com/profile_images/1642027325842931713/WRNeHaPe.jpg", "header_url": "https://pbs.twimg.com