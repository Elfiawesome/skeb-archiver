6f\u304b\u306a\u308a\u306e\u60aa\u515a\u3067\u30a8\u30b4\u30a4\u30b9\u30c8\u3002\n\u7cbe\u795e\u4f53\uff08\u529b\u304c\u5177\u73fe\u5316\u3057\u305f\u5b58\u5728\u3067\u3001\u30da\u30c3\u30c8\u3068\u3057\u3066\u6271\u3046\u3053\u3068\u3082\u3067\u304d\u308b\uff09\u52d5\u7269:\u72fc\n\n\u30a2\u30eb\u30c6\u30df\u30b9(162cm):\n\u91d1\u9aea\u3001\u7dd1\u8272\u306e\u76ee\n\u512a\u7b49\u751f\u3067\u3001\u3088\u304f\u7b11\u9854\u3092\u6d6e\u304b\u3079\u3001\u7fa4\u8846\u306e\u4eba\u6c17\u8005\u3001\u512a\u3057\u3044\u9ad8\u5dba\u306e\u82b1\u3002\n\u5b9f\u306f\u611b\u60c5\u8868\u73fe\u304c\u8584\u304f\u3001\u81ea\u5206\u306e\u3053\u3068\u3057\u304b\u8003\u3048\u3066\u3044\u306a\u3044\u3002\n\u7cbe\u795e\u4f53:\u52d5\u7269:\u732b\n\n\u30a2\u30ec\u30b9(175cm):\n\u6df1\u8336\u8272\u306e\u9aea\u3001\u9752\u7dd1\u8272\u306e\u76ee\n\u5916\u754c\u304b\u3089\u5f37\u5236\u7684\u306b\u30bf\u30ef\u30fc\u306b\u5165\u308c\u3089\u308c\u3001\u305d\u306e\u5168\u3066\u3092\u5acc\u3063\u3066\u3044\u308b\u3002\u8ff7\u60d1\u305d\u3046\u306a\u9854\u3092\u3059\u308b\u3053\u3068\u304c\u591a\u3044\u3002\u4e0d\u826f\u5c11\u5e74\u306e\u611f\u3058\u3001\u3088\u304f\u4ed6\u4eba\u3068\u5bfe\u7acb\u3057\u305f\u308a\u55a7\u5629\u3057\u305f\u308a\u3057\u3066\u602a\u6211\u3092\u3059\u308b\u3002\u4f53\u529b\u306f\u975e\u5e38\u306b\u5f37\u3044\u3067\u3059\u304c\u3001\u6226\u3044\u65b9\u304c\u7121\u8b00\u306a\u306e\u3067\u3088\u304f\u602a\u6211\u3092\u3057\u307e\u3059\u3002\u7518\u3044\u3082\u306e\u304c\u5927\u597d\u304d\u3002\n\u52d5\u7269:\u72ac (\u5f7c\u304c\u666e\u901a\u306e\u5175\u58eb\u305f\u3061\u304b\u3089\u5dee\u5225\u3055\u308c\u3066\u3044\u305f\u305f\u3081\u3001\u300c\u91ce\u826f\u72ac\u300d\u3068\u3044\u3046\u8efd\u8511\u7684\u306a\u3042\u3060\u540d\u3092\u4ed8\u3051\u3089\u308c\u305f\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002)\n\n\u767b\u5834\u4eba\u7269\u306e\u4eba\u9593\u95a2\u4fc2\u306b\u3064\u3044\u3066\u306f\u30ea\u30f3\u30af\u5148\u306e\u60c5\u5831\u3092\u3054\u89a7\u304f\u3060\u3055\u3044\uff01\n\n\u30d8\u30eb\u30e1\u30b9\u3068\u30a2\u30eb\u30c6\u30df\u30b9(\u30d5\u30a9\u30eb\u30c0\uff1a\u65e7\u53cb)\u306b\u3064\u3044\u3066:\n\u4e8c\u4eba\u306e\u9593\u306b\u306f\u604b\u611b\u611f\u60c5\u306f\u306a\u304f\u3001\u3082\u3063\u3068\u8907\u96d1\u3067\u3001\u305d\u3057\u3066\u5e73\u6de1\u3067\u8a00\u8449\u306b\u3067\u304d\u306a\u3044\u611f\u60c5\u304c\u3042\u308a\u307e\u3057\u305f\u3002\n\n\u666e\u6bb5\u306e\u69d8\u5b50\u3084\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u5185\u9762\u7684\u306a\u8003\u3048\uff08\u9670\u9b31\u306a\u611f\u3058\uff09\u306a\u3069\u3001\u3069\u3061\u3089\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\uff01\n\u30d8\u30eb\u30e1\u30b9\u3068\u30a2\u30eb\u30c6\u30df\u30b9\u306e\u7269\u8a9e\u3001\u3082\u3057\u304f\u306f\u4e09\u4eba\u306e\u7269\u8a9e\u3001\u3069\u3061\u3089\u3092\u30c6\u30fc\u30de\u306b\u3057\u3066\u3082\u69cb\u3044\u307e\u305b\u3093\u3002\u81ea\u7531\u306b\u5275\u4f5c\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\n\u8863\u88c5\u3084\u69cb\u56f3\u306a\u3069\u5168\u3066\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\u30de\u30f3\u30ac\u306e\u5c0f\u30cd\u30bf\u3001\u53f0\u8a5e\u3001\u30bb\u30ea\u30d5\u306e\u5909\u5316\u3001\u306a\u3093\u3067\u3082\u81ea\u7531\u306b\u4f5c\u3063\u3066\u304f\u3060\u3055\u3044\uff01\u81ea\u7531\u306b\u63cf\u3044\u3066\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\uff01\n\u53ef\u80fd\u3067\u3042\u308c\u3070\u3001\u5225\u30ec\u30a4\u30e4\u30fc\u306b\u30b5\u30a4\u30f3\u3092\u5165\u308c\u305fpsd\u30d5\u30a1\u30a4\u30eb\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\u30bb\u30ea\u30d5\u306e\u90e8\u5206\u306f\u3001\u3082\u3057\u53ef\u80fd\u3067\u3042\u308c\u3070\u3001\u5225\u306e\u30ec\u30a4\u30e4\u30fc\u306b\u3057\u3066\u307b\u3057\u3044\u3067\u3059\u3002\n\u304a\u5fd9\u3057\u3044\u4e2d\u3001\u3054\u89a7\u3044\u305f\u3060\u304d\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002\u304a\u5f15\u304d\u53d7\u3051\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\n\u3053\u306e\