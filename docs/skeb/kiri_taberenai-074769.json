200&h=200&blur=200&s=d19beb360a4de3dff6b9a54c5fe56d13 2x, https://si.imgix.net/b91d1e03/uploads/origins/0754f187-5a0d-43d0-97e8-e07e39a4d07f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d2125d5852d351de8ffe134bd4b2d11 3x"}, "body": "貝子さんはじめまして！\n前々から貝子さんの素敵なイラストを拝見していて、今回私のOCを描いていただきたくリクエストさせていただきました。\n\nOC\n169cm\nあまり物事を考えずに発言したり、その割には落ち込みがちだったり根暗で気持ちが不安定。好きな人のことをよく考えていて、一喜一憂している。\n\nモチーフ\nホットケーキとハチミツ　朝焼け　クッキー　犬　黄色いアネモネ　ビー玉　クローバー　ほどけかけたリボン\n\n特に指定などはありませんが、リボンを入れたり可愛い雰囲気で描いてくれるととても嬉しいです☺️\n今回skebを送るのが初めてなのですが、どうしても貝子先生の描いたOCが見たくリクエストを送信させていただきました。そのため何か不備がありましたら申し訳ありません💦何卒よろしくお願いします🙇\n\nhttps://drive.google.com/drive/folders/1DXJzvWciLXqD0W-aAmE8Drl2JluoB8rj", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiri_taberenai/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3596021, "client_id": 2772385, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46386c35b2d361c712a561fef11081fc", "srcset": "https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46386c35b2d361c712a561fef11081fc, https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0620c6a74320e676cb170f9a2b29262c 2x, https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34210adad18907ccbbc03b41f37b9b50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90979587a5b9895399ff28229327e240", "srcset": "https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90979587a5b9895399ff28229327e240, https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c034434f92ad28e4850be17246c5b92 2x, https://si.imgix.net/c4b5532e/uploads/origins/fed849b2-2689-40dd-98df-dadb097f1110?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b62f5e08e4cb2991b983a89ed460dd44 3x"}, "body": "貝子さん、こんにちは！外国のファンです。いつも素敵なイラストを楽しく拝見しています。\n\nうちの監督生として使っているオリジナルキャラクター、塩川繭（しおかわ まゆ）を描いていただけたら嬉しいです。\n\n17歳・身長158cmです。\n\n明るく素直な性格で、見た目以上に芯の強い子です。困難があっても簡単には挫けず、前向きに頑張るタイプです。感情が顔に出やすく、好きな気持ちはちゃんと相手に伝えたいと思っています。\n実は猫アレルギーなのですが本人は気づいておらず、グリムと一緒にいるとくしゃみをするのをオンボロ寮の埃のせいだと思っています。\n\n資料はこちらです：\nhttps://drive.google.com/drive/folders/1LFspz3yoZ5X_tYXT35bSLbB4Z4aljz_f?usp=share_link\nジャミ監要素を含む資料フォルダーもありますので、もしご不快でしたらスルーしてください。\n\n貝子さんの描かれるジャミル先輩が大好きなので、もしご縁がありましたらとても嬉しいです。\n\nhttps://drive.google.com/drive/folders/1LFspz3yoZ5X_tYXT35bSLbB4Z4aljz_f?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiri_taberenai/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3596021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd3cfd7a/uploads/origins/f332066b-0280-466e-8bc1-a0e4286ed2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65cb9cef80c249655850539ad6693dab", "srcset": "https://si.imgix.net/fd3cfd7a/uploads/origins/f332066b-0280-466e-8bc1-a0e4286ed2eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65cb9cef80c249655850539ad6693dab, https:/