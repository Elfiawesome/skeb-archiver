200&blur=200&s=ff470714c22180dbd9c70f4dd5d27246 3x"}, "body": "急なリクエスト、失礼します。\nかの人気バラエティ『VS嵐』でのイベント『BABA嵐』で登場した最弱ジャケットを海未ちゃんが着させられたイラストをお願いします。\n手にあのフォークみたいな杖を持ち、頭には白いハット、ポーズは『最弱』の文字が刻まれたジャケットの背中をこちら側に見せながら、悔しそうに涙目でふるふる震えている顔で振り向いてる感じの奴を！\nセリフは「次はあなたの番ですからね…！」\n\nアニメにおいて、BABAで負けまくりな海未ちゃんを見て、つい思いついたアイデアです。ちょっといじめてるようなネタですが、どうしても誰かに書いてほしくてリクをしました。たくさんの人たちにも見てもらいたい。\nよければお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pomuo966/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 909517, "client_id": 28629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=661e6afa731b1d58470e39f3765f4c16", "srcset": "https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=661e6afa731b1d58470e39f3765f4c16, https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac3b2c40bb681ce37e7287a5a8823a4a 2x, https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cff0e194e4156941983754fe73c46986 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c2e237625c46bef82b438c6f7d040d5", "srcset": "https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c2e237625c46bef82b438c6f7d040d5, https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64e2c2bd02f9c576bba68a202e358929 2x, https://si.imgix.net/834facc6/requests/287927_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=25cb2afe1cf1fe6199441a2373c0cb89 3x"}, "body": "いつも楽しく拝見しています。ラブライブ！の園田海未ちゃんが、手のひらの上に矢澤にこちゃん（２～３等身のミニキャラ）を乗せてにっこりしてる絵をお願いできないでしょうか。にこちゃんについては動物アレンジをして頂いていも構いません。\n作品の構想に応じて別の生物（動物化したことり）やキャラが居ても構いませんが、その場合あくまでもメインは海未ちゃん・にこちゃんということがわかる形でお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pomuo966/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 909517, "client_id": 28629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f19911652cd6e0ec454f83906edebc14", "srcset": "https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f19911652cd6e0ec454f83906edebc14, https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4506b27691832a083daa8b0409e0cbaa 2x, https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9af9d065e27b11925cdbebacc57b7bd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82d60fc2bcb06bd47bb47790066b9d6c", "srcset": "https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82d60fc2bcb06bd47bb47790066b9d6c, https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08557e329bf4c00e727e58e5fa7cd866 2x, https://si.imgix.net/92643cb3/requests/212215_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=