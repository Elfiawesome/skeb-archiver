uto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0992f87e9d34b4a3c633e5c4e05d47c2 3x"}, "body": "はじめまして。あなたの絵がとても好きで、私のウェブ小説の登場人物、ライラを描くことに興味を持ってもらえたらと思ったの。彼女は銃で魔法を使う軍司令官です。20代で、肩まであるブロンドのショートヘアと、顔の片方の前髪を長くした、クールでおてんばなデザインをしています。\n\nおっとりとした性格で、陸軍士官学校で教えている生徒たちに親切なOL兼監督のように振る舞っている。カジュアルな部屋着や洋服を着たライラを描いてほしい。ディテールや彼女の魅力は自由に決めてください。できれば、ライラがメガネをかけている別バージョンもお願いします。\n\n私のキャラクターを描いてくださりありがとうございます！\n\nライラの参考資料\nhttps://imgur.com/a/lila-bgmRH8S\n\n彼女のプロフェッショナルな服装\nhttps://imgur.com/a/IY4QX81", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ico_ico0702/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2957589, "client_id": 352722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67b1e6c4/uploads/origins/4cecf237-48f2-4d66-bba0-efadd11ea3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14de7e9d83bb7e6a710aa512f7181e54", "srcset": "https://si.imgix.net/67b1e6c4/uploads/origins/4cecf237-48f2-4d66-bba0-efadd11ea3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14de7e9d83bb7e6a710aa512f7181e54, https://si.imgix.net/67b1e6c4/uploads/origins/4cecf237-48f2-4d66-bba0-efadd11ea3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b495f5c55fd3fe6541d5f417b4d8f29f 2x, https://si.imgix.net/67b1e6c4/uploads/origins/4cecf237-48f2-4d66-bba0-efadd11ea3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28747eeb424f2d75b96fd3e113ec0957 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67b1e6c4/uploads/origins/4cecf237-48f2-4d66-bba0-efadd11ea3b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d256f5c2c6e3e13bc2ea78777e60189d", "srcset": "https://si.imgix.net/67b1e6c4/uploads/origins/4cecf237-48f2-4d66-bba0-efadd11e