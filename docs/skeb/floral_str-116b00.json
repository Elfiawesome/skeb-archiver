1-9142-d3a916c91376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e3e893135a99dd656b6aeb233f59235, https://si.imgix.net/5f63aa93/uploads/origins/389c7a07-ea34-4101-9142-d3a916c91376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af2fd8fa7aa1ef54f5c4fa1446185eb7 2x, https://si.imgix.net/5f63aa93/uploads/origins/389c7a07-ea34-4101-9142-d3a916c91376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d68df4cb9d8be89a01af6f4cbd0d6fc0 3x"}, "body": "アピールありがとうございます。\nキャラクターに興味をもっていただきありがとうございます。\n\nアピール元と同様の女の子のイラストをお願いできればと思います。\nこちらは参考画像ですが、セーラー服のデザイン・表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n好きなシチュエーションは、利き腕である右腕にギプスを巻いて三角巾で吊りつつも、\n左手に何かを持っていたり、何かを頑張ってしているシーンです。\n他には、登校して、他の子に怪我を心配されて、それに対して、大丈夫と返すようなシーンです。\nいくつかシーンを挙げてみましたが、\n頬の絆創膏と右腕のギプス＋三角巾が維持されていれば、あとは自由となりますので、\n他のシーンでも問題ありません。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@floral_str/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2994414, "client_id": 232872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3895455a/uploads/origins/3feda290-0b9d-4c52-998b-ecc4f4f958c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ba68d0c925a086581c78dc12898e012", "srcset": "https://si.imgix.net/3895455a/uploads/origins/3feda290-0b9d-4c5