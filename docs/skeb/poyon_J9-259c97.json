ptable_same_genre": false}, {"path": "/@poyon_J9/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 420860, "client_id": 1205407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca5b4001d208ce66b5d125c3cbfd096b", "srcset": "https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca5b4001d208ce66b5d125c3cbfd096b, https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=528fd9bd230a5c28e250deb32b292d71 2x, https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b8abb1d2c853fd4fb447ff72b13eb3d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00e817f719bf49aba429dabe1e4f8f67", "srcset": "https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00e817f719bf49aba429dabe1e4f8f67, https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ebf7519a870873b2bf396ed0288a8c1 2x, https://si.imgix.net/3f307c8f/uploads/origins/fbf60e9c-4673-4a1c-9f57-4376ccc529ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c886ccfff2a278d7c8f3e20fec318a85 3x"}, "body": "ヘドラ先生の作品には、バチバチにお世話になっております！　ご趣味でなければ恐縮ですが、オリジナル作品で変則的な男尊女卑、お澄ましクール系超絶美少女が彼氏のチンハメペット兼オナホ嫁としてグチャグチャに愛でられる、という概要でお願いしたいです。\n\n希望\n三人称視点\n\nキャラ概要\n雪乃　（高校生）\n・近寄りがたい雰囲気を纏う孤高のマゾ雌。面が歴史的に整っており、黒髪ロング姫カット高身長爆乳安産型の雄に媚び散らした体型をしている。クソボッチ。実家も太い。\n・集団で乱暴されそうな所を彼氏に助けられてから盲信的に彼を愛し、他の雄を毛嫌いしている。\n・優しく愛でられながら物みたいに犯されるのとご奉仕して褒められてペットみたいにワシャワシャ撫でられるのが大好き。特技はアナル舐めパイズリ。\n・クソヤバい名器持ち。\n\n誠那　せな　（高校生）\n・なんかデカくてクソ強い漢。柔和な顔立ちで雪乃をオナホ扱い出来るほど長身。雄々しい筋肉であだ名はゴジ◯。\n・善性の人で襲われる雪乃を見逃せず拳をふるった結果やり過ぎて雪乃のマゾ雌を覚醒させた。\n・体格に相応しい包茎超巨根。童貞卒業時は勢い余って雪乃を抱き潰したが、以降は基本イチャラブエッチだが犬みたいに褒めるのは素。他の雄を貶すのは少し優越感が湧くけど嫉妬するからハメ潰す。気絶した雪乃更に愛でて弄ぶのも好きなサド。\n※キャラ設定の改変は大歓迎です。\n\n概要　ストーリーラインは基本おまかせしたいです。\n・学校にて二人の日常風景。お澄ましで他の雄と人間を近寄らせない雪乃に、「雪乃ちゃん！」と声を掛けて一緒に帰る誠那。周囲からは大型犬と飼い主みたいだと言われる。\n\n・人目がなくなった途端、マゾ犬化して体を押し付けてマーキングしながらキスを強請る雪乃を聞き分けのない愛犬扱いで愛でる誠那。手マンと乳首いじめで雑にイかせて落ち着かせる。\n\n・部屋に入ってまだ「待て」の雪乃を乳や名器を弄んで、巨根グチャグチャにハメ潰す。死に体の雪乃に愛を囁きながらオナホ扱いで使い続ける。\n\nシチュ※こちらもストーリー同様改変大歓迎です\n・巨根崇拝皮剥きフェラ。\n・大量射精を無様顔で飲み込む雪乃をべた褒めしながらキス\n・アナル舐めパイズリ\n・雪乃の超名器なオナホ穴で奉仕させつつ蛞蝓キス。\n・気絶するまで密着種付けプレス。気絶後も愛でながら使い続ける。\n\n　御一考頂けたら幸いです！", "nc": 187, "word_count": 20728, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@poyon_J9/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4fc13461/uploads/origins/be588a3f-9ce2-420f-8d65-63900d6219cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32d204a1d3b4eadabe07eab33640d8bd", "srcset": "https://si.imgix.net/4fc13461/uploads/origins/be588a3f-9ce2-420f-8d65-63900d6219cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32d204a1d3b4eadabe07eab33640d8bd, https://si.imgix.net/4fc13461/uploads/origins/be588a3f-9ce2-420f-8d65-63900d6219cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=