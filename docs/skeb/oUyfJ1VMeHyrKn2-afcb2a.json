dd59d759\n\n\u30d7\u30ec\u30a4\n1.\u30ad\u30b9(\u30b5\u30c8\u30b7\uff1a\u753b\u50cf\u306e\u670d\u88c5\u3001\u30bb\u30ec\u30ca:\u753b\u50cf\u306e\u670d\u88c5)\n(1)\u304a\u4e92\u3044\u30cf\u30b0\u3057\u306a\u304c\u3089\u6c42\u3081\u5408\u3046\u3088\u3046\u306a\u30ad\u30b9\n(2)\u8dea\u3044\u305f\u59ff\u52e2\u306e\u30bb\u30ec\u30ca\u304c\u4ec1\u738b\u7acb\u3061\u3067\u4e0b\u7740\uff11\u679a\u306e\u30b5\u30c8\u30b7\u306e\u30c8\u30e9\u30f3\u30af\u30b9\u306b\u624b\u3092\u304b\u3051\u3059\u308b\u308a\u3068\u30c8\u30e9\u30f3\u30af\u30b9\u3092\u8131\u304c\u305b\u52c3\u8d77\u306b\u6065\u3058\u3089\u3044\u306a\u304c\u3089\u3082\u559c\u3076\n\n2.\u30d5\u30a7\u30e9(\u30b5\u30c8\u30b7\uff1a\u5168\u88f8\u30fb\u4ec1\u738b\u7acb\u3061\u3001\u30bb\u30ec\u30ca:\u753b\u50cf\u306e\u670d\u88c5\u3001\u4e09\u89d2\u30d3\u30ad\u30cb(\u30d5\u30ea\u30eb\u4ed8)\n(1)\u8d64\u9762\u3057\u305f\u30bb\u30ec\u30ca\u304c\u76ee\u3092\u7791\u308a\u30b5\u30c8\u30b7\u306e\u30da\u30cb\u30b9\u306e\u5148\u7aef\u306b\u512a\u3057\u304f\u30ad\u30b9\n(2)\u30bb\u30ec\u30ca\u304c\u5de6\u624b\u3067\u30b5\u30c8\u30b7\u3068\u604b\u4eba\u7e4b\u304e\u3092\u3057\u53f3\u624b\u3067\u30da\u30cb\u30b9\u3092\u6301\u3061\u7167\u308c\u306a\u304c\u3089\u30d5\u30a7\u30e9\n(3)\u30bb\u30ec\u30ca\u304c\u4f11\u61a9\u3067\u30da\u30cb\u30b9\u304b\u3089\u53e3\u3092\u96e2\u3057\u305f\u6642\u306b\u6211\u6162\u6c41\u3068\u553e\u6db2\u304c\u6df7\u3058\u3063\u305f\u6db2\u4f53\u304c\u30bb\u30ec\u30ca\u306e\u53e3\u5143\u306b\u7cf8\u3092\u5f15\u3044\u3066\u304a\u4e92\u3044\u6065\u3058\u3089\u3046\n(4)\u30b5\u30c8\u30b7\u304c\u30bb\u30ec\u30ca\u306e\u30d5\u30a7\u30e9\u306b\u6211\u6162\u3067\u304d\u305a\u306b\u5927\u91cf\u306e\u7cbe\u6db2\u3092\u53e3\u5185\u5c04\u7cbe\n(5)\u30b5\u30c8\u30b7\u306e\u5927\u91cf\u306e\u7cbe\u5b50\u3092\u98f2\u307f\u304d\u308c\u305a\u9854\u5c04\u3001\u4f53\u3001\u8c37\u9593\u3001\u811a)\u306b\u3076\u3063\u304b\u3051\n(6)\u304a\u6383\u9664\u30d5\u30a7\u30e9\n\n3.\u624b\u30b3\u30ad(\u30b5\u30c8\u30b7\uff1a\u5168\u88f8\u30fb\u4ec1\u738b\u7acb\u3061\u3001\u30bb\u30ec\u30ca:\u753b\u50cf\u306e\u670d\u88c5\u3001\u4e09\u89d2\u30d3\u30ad\u30cb(\u30d5\u30ea\u30eb\u4ed8)\n(1)\u8dea\u3044\u305f\u30bb\u30ec\u30ca\u304c\u753b\u50cf\u306e\u59ff\u3067\u624b\u30b3\u30ad+\u5c04\u7cbe\u3001\u30d3\u30ad\u30cb\u59ff\u3067\u306f\u77f3\u9e78\u304c\u3064\u3044\u305f\u624b\u3067\u30da\u30cb\u30b9\u3092\u6d17\u3046+\u5c04\u7cbe\n(2)\u30b5\u30c8\u30b7\u306e\u5074\u9762\u304b\u3089\u30bb\u30ec\u30ca\u304c\u4f53\u3092\u5bc6\u7740\u3055\u305b\u30ad\u30b9\u3057\u306a\u304c\u3089\u624b\u30b3\u30ad+\u5c04\u7cbe\n(3)\u30bb\u30ec\u30ca\u304c\u4e0a\u6c17\u3057\u306a\u304c\u3089\u6311\u767a\u3059\u308b\u3088\u3046\u306a\u8868\u60c5\u3067\u80f8\u3092\u62bc\u3057\u5f53\u3066\u3001\u58c1\u306b\u624b\u3092\u3064\u3044\u305f\u30b5\u30c8\u30b7\u3092\u5f8c\u308d\u304b\u3089\u62b1\u304d\u3057\u3081\u3066\u5f7c\u306e\u4f53\u3092\u5f04\u308a\u306a\u304c\u3089\u624b\u30b3\u30ad+\u5c04\u7cbe\n\n4.\u30aa\u30ca\u898b\u305b(\u30b5\u30c8\u30b7\uff1a\u5168\u88f8\u30fb\u4ec1\u738b\u7acb\u3061\u3001\u30bb\u30ec\u30ca:\u753b\u50cf\u306e\u670d\u88c5\u3001\u4e09\u89d2\u30d3\u30ad\u30cb(\u30d5\u30ea\u30eb\u4ed8)\n(1)\u30b5\u30c8\u30b7\u304c\u30bb\u30ec\u30ca\u3092\u304a\u304b\u305a\u306b\u30aa\u30ca\u30cb\u30fc\u62ab\u9732\u3001\u30bb\u30ec\u30ca\u306f\u5ea7\u3063\u3066\u9854\u3092\u771f\u3063\u8d64\u306b\u3057\u306a\u304c\u3089\u3082\u3001\u6e80\u66f4\u3067\u306f\u306a\u3044\u8868\u60c5\u3067\u5f7c\u306e\u53cd\u5fdc\u3092\u697d\u3057\u307f\u306a\u304c\u3089\u9451\u8cde\n(2)\u9650\u754c\u3092\u8fce\u3048\u305f\u30b5\u30c8\u30b7\u304c\u30bb\u30ec\u30ca\u306e\u898b\u3066\u3044\u308b\u524d\u3067\u52e2\u3044\u3088\u304f\u5c04\u7cbe\u3002\u9854\u3084\u80f8(\u8c37\u9593)\u306b\u304b\u304b\u3063\u3066\u3057\u307e\u3046\u3082\u7b11\u9854\u3067\u53d7\u3051\u6b62\u3081\u30b5\u30c8\u30b7\u306b\u5fae\u7b11\u307f\u304b\u3051\u308b\n\n5.\u30d1\u30a4\u30ba\u30ea(\u30b5\u30c8\u30b7\uff1a\u5168\u88f8\u30fb\u4ec1\u738b\u7acb\u3061\u3001\u30bb\u30ec\u30ca:\