a\u3044\u304c\uff09\u3002\ne) D\u30ab\u30c3\u30d7\u3002\nf) \u8eab\u9577175cm\u3002\ng) \u30ef\u30a4\u30f3\u30ec\u30c3\u30c9\u8272\u306e\u30b7\u30f3\u30d7\u30eb\u306a\u9769\u306e\u8863\u88c5\u3068\u624b\u888b\uff08\u80f4\u4f53\u3001\u80a9\u3001\u4e0a\u8155\u306f\u30ab\u30d0\u30fc\u3057\u3001\u80f8\u306e\u8c37\u9593\u3001\u524d\u8155\u3001\u811a\u306f\u9732\u51fa\u3055\u305b\u308b\uff09\u3002\nh) \u30ed\u30fc\u30de\u30f3\u92cf\u3092\u643a\u5e2f\u3002\u53c2\u7167\n\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u305d\u306e2\u3001\u540d\u524d\uff1a\u30d5\u30a7\u30ea\u30c3\u30af\u30b9\na) \u9752\u767d\u3044\u808c\u3002\nb) \u4e71\u308c\u305f\u9ed2\u9aea\u3067\u3001\u524d\u9aea\u304c\u76ee\u3092\u8986\u3063\u3066\u3044\u308b\u3002\nc) \u524d\u9aea\u306e\u5965\u306b\u306f\u6df1\u7dd1\u8272\u306e\u76ee\u3002\nd) \u30d3\u30fc\u30ba\u4ed8\u304d\u306e\u9f3b\u30d4\u30a2\u30b9\u3002\ne) \u30d3\u30fc\u30ba\u30d4\u30a2\u30b9\u4ed8\u304d\u306e\u4e73\u8f2a\u3002\nf) \u5de8\u6839\uff08\u5f1b\u7de9\u3057\u3066\u3044\u3066\u3082\u975e\u5e38\u306b\u5927\u304d\u3044\uff09\ng) \u5168\u88f8\nh) \u91d1\u5c5e\u88fd\u306e\u9996\u8f2a\u3001\u91d1\u5c5e\u88fd\u306e\u30d6\u30ec\u30b9\u30ec\u30c3\u30c8\u3001\u30a2\u30f3\u30af\u30ec\u30c3\u30c8\u3001\u30ed\u30fc\u30de\u30f3\u30b5\u30f3\u30c0\u30eb\u3092\u7740\u7528\u3002\ni) \u4e0a\u8a18\u4ee5\u5916\u306f\u5168\u88f8\u3002\nj) \u30ed\u30af\u30b5\u30fc\u30ca\u306e\u65b9\u304c\u6570\u30bb\u30f3\u30c1\u80cc\u304c\u9ad8\u3044\u3002\n\nhttps://www.britishmuseum.org/collection/object/H_Eu2000-05-10", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oUyfJ1VMeHyrKn2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 842078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1611e3d5/uploads/origins/1d3bdc47-e621-4bd2-93ba-0d06d4f5a381?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2badbf7ecf5189f9abd2ce14