-47c3-983d-1a35e584f8a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a28ed905793c2f20fb601a65c79d00b0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/259b31a3/uploads/origins/d0f0f7ed-7935-47c3-983d-1a35e584f8a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91403b39975b73776f5814799940c94f", "srcset": "https://si.imgix.net/259b31a3/uploads/origins/d0f0f7ed-7935-47c3-983d-1a35e584f8a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91403b39975b73776f5814799940c94f, https://si.imgix.net/259b31a3/uploads/origins/d0f0f7ed-7935-47c3-983d-1a35e584f8a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ecf5daa2c89b223be59e594ff3cc187 2x, https://si.imgix.net/259b31a3/uploads/origins/d0f0f7ed-7935-47c3-983d-1a35e584f8a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f95fba0da1d6323dceda4c5dab8adfa2 3x"}, "body": "NIKKEとリコリコの千束、たきな、指揮官の作品をお願いしたいです\n\nシナリオは、指揮官が大きな机に座っていて、たきなが机の下に隠れて指揮官にフェラチオをしているというものです。たきなは指揮官を反抗的に睨みつけながら、元気よくフェラチオをしている\n\n千束が部屋に入ってきて、指揮官以外誰もいないのを確認すると、テーブルの下にいるたきなに気づかず、指揮官といちゃつき始める\nたきなは嫉妬と興奮を募らせ、睨みをきかせる。たきなのフェラチオは怒れば怒るほど激しくなる\n\n千束は身を乗り出して指揮官にキスをする。たきなは指揮官と千束のキスを聞き、さらに嫉妬を募らせる。\n指揮官がイキそうになると、たきなは指揮官のペニスを激しくディープスロートし始める。指揮官と千束はディープキスをしながら、指揮官はたきなのの口の中で深く射精した\n\n照れくさそうな千束が、指揮官が自分と同じようにキスを楽しんでくれたら嬉しいと言い、その夜また訪れることを約束する。たきなはテーブルの下で口を開けて舌を出し、指揮官の精液をすべて飲み込んだことを示すエロティックな表情をする\n\nその他、細かいことはお任せします\n\nhttps://drive.google.com/drive/folders/14yUtsqb6UCB9NebnOPv1kMKL7prNZ4uW?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dekabokkuri/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3390769, "client_id": 2880032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d8938