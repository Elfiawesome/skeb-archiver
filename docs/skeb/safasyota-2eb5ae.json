「格闘家は廃業。スティーブ様の肉奴隷として生まれ変わる」みたいなことを、選手宣誓のような敬語で、えげつない淫語で宣言する。両者の上下関係が明確にわかるような描写。\n\nご検討いただけると幸いです。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@safasyota/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c2935eb4/uploads/origins/6b69566d-03ef-44bb-abcc-f17ca8e30f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d204116465dc1ee0d50b97e30c8e98e4", "srcset": "https://si.imgix.net/c2935eb4/uploads/origins/6b69566d-03ef-44bb-abcc-f17ca8e30f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d204116465dc1ee0d50b97e30c8e98e4, https://si.imgix.net/c2935eb4/uploads/origins/6b69566d-03ef-44bb-abcc-f17ca8e30f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1433dd55066b66a4ebb2087248935c9 2x, https://si.imgix.net/c2935eb4/uploads/origins/6b69566d-03ef-44bb-abcc-f17ca8e30f4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=476245b9f6ee6e61e35069b0fb79c0bc 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 512113, "nc": 32}, {"path": "/@safasyota/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 512113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0da0180/uploads/origins/3b7293ab-4dcd-4e05-baf6-b79047230183?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=825df80f6d52e04567637193d400ac45", "srcset": "https://si.imgix.net/d0da0180/uploads/origins/3b7293ab-4dcd-4e05-baf6-b79047230183?bg=%23fff&a