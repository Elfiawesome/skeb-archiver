p&crop=top&w=200&h=200&s=1e931ffea69422e1c8e6451f3ffc899a, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=998f1139596206197f43f5e02066e174 2x, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfc9096d75d9080039dcea43d9d73f62 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c79d9fe2586a87c667e94f19da3fd7", "srcset": "https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c79d9fe2586a87c667e94f19da3fd7, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f658e2f3d630e3dd87842bd29ab7e264 2x, https://si.imgix.net/bdf83eaa/uploads/origins/1ae87d4b-5110-4cb5-86d7-f254bb76e1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb22ca004a156ddb7f97e8d516269a65 3x"}, "body": "お世話になります。\n突然ですがピクシブの絵を拝見してて惹かれました。\nまだリクエストを募集されてましたらお願いを聞いて頂けますか？\n\n以下は詳細になります。\n\n【キャラクター】ブルーアーカイブから「銀鏡イオリ」\n【内容】イオリに先生の包茎チンポを皮フェラをしてもらって大量にぶっかけをするシチュをお願いします！\nシチュとしては…\n俯瞰視点でお願いします。\n激務に追われてる先生に対して軽い罵声と叱咤激励を交えつつ、奉仕する感じで先生の包茎マラの皮の中に舌を入れたり、亀頭を口に含んだりして丁寧にフェラチオする。\nその後はイオリの褐色肌に白濁とした精液を大量にぶっかけるという感じで。\n\nぶっかけ描写がとても素晴らしかったのでリクエストさせて頂きました。\nご都合が悪かったりした場合は遠慮なくキャンセルしていただいて構いません。\nご検討をお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatitanihituji/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "