g=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d7604996b30c37c73cac7264a0625cc 2x, https://si.imgix.net/0ed1722c/uploads/origins/d64dfe75-2bc4-4581-a028-75702de33343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61b8e3e7ebbae9621c53ce98bcd29889 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ed1722c/uploads/origins/d64dfe75-2bc4-4581-a028-75702de33343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f506808ef70f1b2c59f180583acbb809", "srcset": "https://si.imgix.net/0ed1722c/uploads/origins/d64dfe75-2bc4-4581-a028-75702de33343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f506808ef70f1b2c59f180583acbb809, https://si.imgix.net/0ed1722c/uploads/origins/d64dfe75-2bc4-4581-a028-75702de33343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85e86c0b675d67c115e18b1905a2f623 2x, https://si.imgix.net/0ed1722c/uploads/origins/d64dfe75-2bc4-4581-a028-75702de33343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bc74fa73661361a64de4b306d4fc98f 3x"}, "body": "ちょっと諦めきれず再び依頼します。\n本当にダメならキャンセルでお願いします\nキャラの表情が最優先で見たいので血は苦手でしたら描かなくて大丈夫です。\n\n◇テーマ\n私のオリジナルキャラのカワウソの着ぐるみ魔法少女のイラスト(カラー)https://skeb.jp/@hiyamgitune/works/50\n\n◇設定\n資料より頭部を多く着ぐるみが覆っていて前髪が出ている量を少なく作画してほしい。\nへその×マークも忘れないで欲しい。\n\n◇構図\n正面から見た構図\n弱弱しく立ち、顔を血だらけにして魚を咥えながら、呆然としている。\n頭から爪先まで全身を入れて欲しい。\n\n◇シチュエーション\n敵に捕らわれて無理やり動物園の飼育スペースのような場所で生魚を無理矢理食べさせられて顔を血だらけにして本当に動物のような自分の惨めさに呆然としている。(精神的ダメージを描く)\n\n参考資料\n似たシチュの同キャラの依頼小説\nhttps://skeb.jp/@hiyamgitune/works/52\n\n背景イメージ資料\nhttps://i.imgur.com/IZPGJtI.png\n(ある程度簡略化していただいても大丈夫です)\n\nよろしくお願いいたします。", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nensyu5man_e/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 506435, "client_id": 490225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=635e7c8400f0e855ddddc4d4a1908cfe", "srcset": "https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=635e7c8400f0e855ddddc4d4a1908cfe, https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=294c8547faf6b08371e7e7dc74760a46 2x, https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11006c9fb96e473ada6c91cb4c0112d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff8a183277a120bc2c4ed51e4ba466c", "srcset": "https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff8a183277a120bc2c4ed51e4ba466c, https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0e0426f7beb90281febf145c2f036aa 2x, https://si.imgix.net/7728ed18/uploads/origins/a1ca8294-4bb0-4441-90c7-43daa64e22f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4556b197823f28b234ee682416d8d4f0 3x"}, "body": "アサルト年収5万さん、こんにちは。\nまた私の依頼を受けて頂けると嬉しいです。\n\n◇テーマ\n私のオリキャラのイタチ着ぐるみ衣装の魔法少女のイラスト(表情差分付き)\n（資料は他の方に描いていただいたもので許可は取っています）\n参考資料\nhttps://i.imgur.com/jMFKaWL.png\nhttps://i.imgur.com/2Cjiezf.png\n\nアサルト年収5万さんのリアル寄りの画風はどれも素敵なのですが以前の依頼作品のこちらhttps://skeb.jp/@nensyu5man_e/works/5に全体的な画風を寄せて頂く形でお願いします。\n\n◇設定\n足は以前の依頼イラストの着ぐるみ衣装の靴下のような形ではなくもうちょっと指が別れた獣っぽい形。\n手も少し指が太めのような獣っぽい形で。\n参考資料\nhttps://i.imgur.com/I8qs62Y.jpg\nhttps://i.imgur.com/o3I6ZNI.jpg\n極力最初の資料からキャラクターデザイン、配色をを変えず再現してほしいです。(へその×マークも忘れずに)目の色は茶色です。\n衣装のふさふさ感は以前の依頼作品のこちらhttps://skeb.jp/@nensyu5man_e/works/5と似たような感じにしてほしいです。\n\n年齢設定は15歳くらいという設定です\n\n◇構図\n檻の中のような形で頭から爪先まで全身を入れた立ち姿。\n全体的なポーズはお任せ。\n背景は暗めの色。(檻の格子はレイヤーでON/OFF可能にしてほしい)\n格子デザイン\nhttps://i.imgur.com/fVNyPhS.jpg\n色は黒。\n\n◇シチュエーション\n以前依頼したこちらhttps://skeb.jp/@nensyu5man_e/works/6と結構違いはありますが似たような感じで。\n違うのは完全に全身を入れて欲しい事前述したように格子を追加してほしい事です。\n表情差分としてこちらの短文file:///C:/Users/tuki/Downloads/1699656-1.pdfのような絶体絶命の極限の恐怖の表情と。\n本来強気な性格という設定なので暴れる猛獣のように反抗心MAXで牙を剝き出しにして睨みつけているような二種類の表情差分が欲しいです。\n\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nensyu5man_e/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 506435, "client_id": 490225, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4211780c/uploads/origins/7e26d889-b9f5-4f44-80f3-fc0cd0b272b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26cf527611221724663bbebb4fbca1b1", "srcset": "https://si.imgix.net/4211780c/uploads/origins/7e26d889-b9f5-4f44-80f3-fc0cd0b272b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26cf527611221724663bbebb4fbca1b1, https://si.imgix.net/4211780c/uploads/origins/7e26d889-b9f5-4f44-80f3-fc0cd0b272b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cdea3235c7731a88aeacf382f995221 2x, https://si.imgix.net/4211780c/uploads/origins/7e26d889-b9f5-4f44-80f3-fc0cd0b272b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88c6050b399f5e31aa7303802655e896 3x"}, "duration": null, "nsfw": false, "hardcore": false, "con