スを踊ったり、夜食や②が好きなチェリーパイなどのお菓子を①が作って一緒に食べたりしています。 \n\n上記から受けたイメージから、お好きなようにご自由に描いていただけますと幸いです。 \nもしご縁がございましたらご検討いただけますと幸いです。\n何卒よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/vtl7z6sbvrzbqr20h59m3/AI9JA25sIBhqp60iv9Lx1Vo?rlkey=q4ijx876vy1txznuae32s0r2p&st=mudhm48v&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AK1yosh/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 503678, "client_id": 2719178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4f624f0/uploads/origins/47207830-0762-4ceb-9048-96cd0c95dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b95333090ff19d86040b3f8c4b057ef8", "srcset": "https://si.imgix.net/a4f624f0/uploads/origins/47207830-0762-4ceb-9048-96cd0c95dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b95333090ff19d86040b3f8c4b057ef8, https://si.imgix.net/a4f624f0/uploads/origins/47207830-0762-4ceb-9048-96cd0c95dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b0344116e260a58e9cdb1ccb5dae6f5 2x, https://si.imgix.net/a4f624f0/uploads/origins/47207830-0762-4ceb-9048-96cd0c95dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6eb653950763b1e977599852d2c427c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4f624f0/uploads/origins/47207830-0762-4ceb-9048-96cd0c95dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47834dd39c2bf8c96cbdb18a06124a26", "srcset": "https://si.imgix.net/a4f624f0/uploads/origins/47207830-0762-4ceb-9048-96cd0c95dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47834dd39c2bf8c96cbdb18a06124a26, https://si.imgix.net/a4f624f0/uploads/origins/47207830-0762-4ceb-9048-96cd0c95dbac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f