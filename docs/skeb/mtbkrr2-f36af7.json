se go to this link where I have compiled some inspirational photos: https://nyafangs.nekoweb.org/inspo.html\n\nNote: Usage will be for social media like Twitch. Of course, with crediting you as the artist!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mtbkrr2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 548012, "client_id": 3083535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09ef9b70/uploads/origins/6da40f82-9c41-4fde-b233-80856b485ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73cf3bb8148650184a25215872e82442", "srcset": "https://si.imgix.net/09ef9b70/uploads/origins/6da40f82-9c41-4fde-b233-80856b485ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73cf3bb8148650184a25215872e82442, https://si.imgix.net/09ef9b70/uploads/origins/6da40f82-9c41-4fde-b233-80856b485ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27dd48d5aa178b857ebc0a1e6a26390b 2x, https://si.imgix.net/09ef9b70/uploads/origins/6da40f82-9c41-4fde-b233-80856b485ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b179fe759e3fbe3a976835bae7acbb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09ef9b70/uploads/origins/6da40f82-9c41-4fde-b233-80856b485ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ea77f160f64c72937db139f50476441", "srcset": "https://si.imgix.net/09ef9b70/uploads/origins/6da40f82-9c41-4fde-b233-80856b485ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ea77f160f64c72937db139f50476441, https://si.imgix.net/09ef9b70/uploads/origins/6da40f82-9c41-4fde-b233-80856b485ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23c6af5c110b4862f7fa7