なも入れられそうであれば嬉しいですが、必須ではありません。おまかせします！\n\n■概要\n「ねむい」と「おいしい・YUMMY」をかけあわせたショップ名で、\n・食べ物モチーフやゆるめの3Dのお洋服やアクセサリー、素材などを作っていく予定です。\n\n-------------------------------------\n\n【デザインの要望】\n\n■雰囲気\n・uo様のデザインが好きなので基本おまかせしたいため、資料添付はございません。\n（Vの姿に合わせ、パンのモチーフをいれる必要などもございません！）\n\nおまかせのイメージが難しい場合は下記でおねがいします！↓\n・かわいい系、ゆるい系\n・ねむいorもぐもぐなイメージ\n・暖色系だと嬉しいです！\n\n\n■使用用途\n・商用利用有\n・X、BOOTH、HP等SNSに投稿する商品のサムネイルへの画像投稿\n・Youtubeに投稿する商品紹介動画への利用\n・BOOTHショップ等のアイコン、ヘッダー\n・3D衣装のデザインにロゴを一部利用させていただく可能性がございます。例：ヘアピン、刺繍、Tシャツのワンポイントなど\n\n■その他\n・利用の際はuo様のお名前とリンクを各SNSの概要欄やクレジット画像・動画に記載いたします。\n\n-------------------------------------\n\nご検討の程よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MooMooSavonWhip/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3539507, "client_id": 3095578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74b57fad/uploads/origins/0d08f97b-369d-490c-b8b4-b60e9788a969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fa24af30c6fe56e4eb7df6f58444edb", "srcset": "https://si.imgix.net/74b57fad/uploads/origins/0d08f97b-369d-490c-b8b4-b60e9788a969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fa24af30c6fe56e4eb7df6f58444edb, https://si.imgix.net/74b57fad/uploads/origins/0d08f97b-369d-490c-b8b4-b60e9788a969?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52530dd431c1318c3988acdd0dfd7380 2x, https://si.imgix.net/74b57fad/uploads/origins/0d08f97b-369d-490c-b8b4-b60e9788a969?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bb12b7f7b6b37a5102c3107b169c5f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74b57fad/uploads/origins/0d08f97b-369d-490c-b8b4-b60e9788a969?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f02f5eb84d34c64