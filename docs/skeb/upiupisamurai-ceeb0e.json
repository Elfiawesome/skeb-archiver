a\u30af\u30a8\u30b9\u30c8\u3092\u304a\u9001\u308a\u3057\u307e\u3057\u305f\uff01\n\n\n \u3010\u4f9d\u983c\u5185\u5bb9\u3011 \n\u30fbTRPG\u3067\u4f7f\u7528\u3057\u3066\u3044\u308bOC2\u4eba\u306e\u30a4\u30e9\u30b9\u30c8(\u76f8\u65b9\u306b\u8a31\u53ef\u306f\u9802\u3044\u3066\u3044\u307e\u3059)\n\n\u30fb\u69cb\u56f3\u3001\u670d\u88c5\u3001\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306a\u3069\u5168\u3066\u304a\u307e\u304b\u305b\u3044\u305f\u3057\u307e\u3059\u3002\u5f0aOC2\u4eba\u3092\u898b\u3066\u3001\u3046\u30d4\u30d4\u4e38\u69d8\u306e\u597d\u304d\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u5b09\u3057\u3044\u3067\u3059\uff01\n\n\n\u3010\u30ad\u30e3\u30e9\u7d39\u4ecb\u3011\n\u30fb\u677e\u8c37 \u771f\u592a\u90ce(\u307e\u3064\u305f\u306b \u3057\u3093\u305f\u308d\u3046)\n21\u6b73\u3001179cm\u3001\u7537\u6027\u3001\u5de5\u4e8b\u73fe\u5834\u52e4\u52d9\u3002\n\u30cd\u30ac\u30c6\u30a3\u30d6\u601d\u8003\u3067\u3084\u3084\u512a\u67d4\u4e0d\u65ad\u306a\u3068\u3053\u308d\u3082\u3042\u308b\u304c\u6839\u306f\u7d20\u76f4\u3067\u512a\u3057\u3044\u3002\u6065\u305a\u304b\u3057\u304c\u308a\u3067\u7167\u308c\u3084\u3059\u3044\u3002\n\u795e\u8a71\u751f\u7269\u306b\u5bfe\u3057\u3066\u4f55\u6545\u304b\u8010\u6027\u304c\u3042\u308a\u3001\u5371\u6a5f\u7684\u72b6\u6cc1\u306b\u9665\u3063\u305f\u6642\u306e\u884c\u52d5\u529b\u304c\u51c4\u3044\u3002\n\u4f50\u5ce0\u306e\u3053\u3068\u306f\u552f\u4e00\u306e\u53cb\u4eba\u3067\u3068\u3066\u3082\u5927\u5207\u306a\u5b58\u5728\u3067\u3042\u308a\u3001\u3053\u3093\u306a\u81ea\u5206\u3068\u4e00\u7dd2\u306b\u5c45\u3066\u304f\u308c\u3066\u611f\u8b1d\u3057\u3066\u3044\u308b\u3002\u6065\u305a\u304b\u3057\u304f\u3066\u7d20\u9762\u3067\u306f\u8a00\u3048\u306a\u3044\u304c\u3001\u304a\u4e92\u3044\u3092\u826f\u3044\u89aa\u53cb\u3060\u3068\u601d\u3063\u3066\u3044\u308b\u3002\n\u203b\u6700\u8fd1\u4f50\u5ce0\u304b\u3089\u306e\u597d\u610f\u306b\u6c17\u4ed8\u304d\u59cb\u3081\u3066\u3044\u308b\u304c\u3001\u307e\u3060\u534a\u4fe1\u534a\u7591\u306e\u72b6