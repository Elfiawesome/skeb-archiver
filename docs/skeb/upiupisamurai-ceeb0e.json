b\u308b\u88cf\u57a2\u3067\u3044\u3044\u306d\u3092\u7a3c\u304e\u3001\u4ed6\u4eba\u304b\u3089\u306e\u627f\u8a8d\u3067\u5fc3\u3092\u6e80\u305f\u3057\u3066\u3044\u308b\u3002\n\u3044\u3058\u3081\u306e\u30c8\u30e9\u30a6\u30de\u304b\u3089\u4ed6\u4eba\u306b\u8650\u3052\u3089\u308c\u308b\u3053\u3068\u3084\u512a\u4f4d\u306b\u7acb\u305f\u308c\u308b\u3053\u3068\u3092\u6975\u7aef\u306b\u5acc\u3046\u3002\n\n\u8da3\u5473\n\u682a \u7b4b\u30c8\u30ec \u516d\u672c\u6728\u98f2\u307f\n\u597d\u7269\n\u30c1\u30e7\u30b3\u30ec\u30fc\u30c8(\u5e7c\u5c11\u671f\u4ee5\u6765\u98df\u3079\u3066\u3044\u306a\u3044)\n\u82e6\u624b\n\u30ad\u30e5\u30a6\u30ea(\u91ce\u83dc\u306e\u30af\u30bb\u306b\u6804\u990a\u304c\u5c11\u306a\u3044\u305f\u3081) \u8b66\u5bdf(\u4ed5\u4e8b\u306e\u90aa\u9b54)\n \n\u30bb\u30ea\u30d5\u30a4\u30e1\u30fc\u30b8\n\u300c\u304a\u301c\u304a\u301c\u304a\u307e\u308f\u308a\u30ef\u30f3\u30ef\u30f3\u306f\u4eca\u65e5\u3082\u3054\u82e6\u52b4\u306a\u3053\u3068\u3067\u300d\n\u300c\u306f\u30fc\u2026\u2026\u64ae\u5f71\u7981\u6b62\uff1f\u305d\u308c\u3063\u3066\u306a\u3093\u304b\u3084\u307e\u3057\u3044\u3053\u3068\u3042\u308a\u307e\u3059\u3063\u3066\u8a00\u3063\u3066\u308b\u3088\u3046\u306a\u30e2\u30f3\u3060\u308d\uff1f\u300d\n\u300c\u30de\u30b9\u30b4\u30df\u306d\u3047\u2026\u2026\u305d\u306e\u30b4\u30df\u306b\u6ca2\u5c71\u306e\u4eba\u304c\u91d1\u3092\u843d\u3068\u3057\u3066\u304f\u308c\u3066\u4eca\u65e5\u3082\u8d05\u6ca2\u3055\u305b\u3066\u3082\u3089\u3063\u3066\u307e\u30fc\u3059\u300d\n\nhttps://drive.google.com/drive/folders/1-z7bYZGeaROlwOXeWhm0xYKh2nP5VrQk", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@upiupisamurai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3473090, "client_id": 3499681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddd09df9/uploads/origins/da627b4c-c736-41b9-b3be-ed7297881abb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro