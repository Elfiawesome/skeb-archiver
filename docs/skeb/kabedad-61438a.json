人（ブランケ＆サイド）を描いてくれませんか？  \n参考：https://sta.sh/237bcqtssr5\n\nキャラクター\nBlanke(190cm)。マフィアのリーダー。普段は無表情だが、愛情表現の仕方はとても直接的。たまに子供っぽいことをする（デザートを食べたり、猫と遊んだり、サイドをからかったり）。\nサイド(158cm)。リーダーの部下。ツンデレで、普段は真面目な表情をしている。感情の表現がとても繊細で、ブランケに近づきすぎると緊張してしまう。\n\nリクエスト\nカクテルを飲んだ後のセックスの過程を描いてほしいです。シーンは海辺の別荘（バー、寝室、リビングなど）を想定しています。\n\nご検討いただき、ありがとうございます。不適切と感じられた場合は、この依頼をキャンセルしていただいて結構です。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kabedad/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4ac851bc/uploads/origins/f68b3031-5251-4df7-873f-d5444e971875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09fb836a66570a568d28b7302d622836", "srcset": "https://si.imgix.net/4ac851bc/uploads/origins/f68b3031-5251-4df7-873f-d5444e971875?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=09fb836a66570a568d28b7302d622836, https://si.imgix.net/4ac851bc/uploads/origins/f68b3031-5251-4df7-873f-d5444e971875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=51f02c934f21718c296bb05625cdaa49 2x, https://si.imgix.net/4ac851bc/uploads/origins/f68b3031-5251-4df7-873f-d5444e971875?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de3b1e3e5131a787c2c7a3e825c4a527 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2070935, "client_id": 472183, "nc": 49}, {"path": "/@kabedad/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2070935, "client_id": 544969, "vtt_url": null, "thumbnail_image_urls": {