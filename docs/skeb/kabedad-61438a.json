、サイドは少し真剣な表情で、しかし心はブランケのことを思っている。\n\nねこおじさんには、私のお願いを受け入れてほしい。不謹慎だと思ったら、この依頼をキャンセルしてもらってもかまいませんよ。ご検討ありがとうございました。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kabedad/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2070935, "client_id": 1418548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b87984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbab632d6acc31025656199ce3e5306e", "srcset": "https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b87984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbab632d6acc31025656199ce3e5306e, https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b87984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ffbc399528c3e4f915785ae7433329f 2x, https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b87984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ffa617ef4e6f2f8d93ca1dbfa714959 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b87984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=548bd83a13593cecea0ab0fc319bac11", "srcset": "https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b87984?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=548bd83a13593cecea0ab0fc319bac11, https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b87984?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=937e53b114428540749218fba5584576 2x, https://si.imgix.net/c449d99f/uploads/origins/5cade9b9-6310-4d57-ade1-8414f3b