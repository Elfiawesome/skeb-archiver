0&s=ba76ed5efa1cb70065f64ee4141373b9, https://si.imgix.net/5ab66ec0/uploads/origins/5638bcc2-93ac-4793-8044-53ace578759f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d705f0a73c59902f3baa275c7295a5b 2x, https://si.imgix.net/5ab66ec0/uploads/origins/5638bcc2-93ac-4793-8044-53ace578759f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a63bc729ac2b097f171c4757dfc569bd 3x"}, "body": "こんにちは\n\nガーディアンテイルズのナリちゃんを描いて欲しいです。\n尻尾は８本あります。\n\n立ち絵(日本/海外)　のところに見えます。\nhttps://appmedia.jp/guardiantales/27205735\nhttps://x.com/GuardianTalesJP/status/1578324339446845440\nハンモック衣装です。日本は海外版の絵を利用しましたので、日本版はありません。\nhttps://x.com/GuardianTalesJP/status/1546804726834266112\n\n好きな衣装で描いて欲しいです。\n詳細はお任せします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jmjpwxag/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 406227, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90249997b59f22c002a117f8652ca804", "srcset": "https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90249997b59f22c002a117f8652ca804, https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=944aee80f12ee67a8314877e180dde91 2x, https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ada22e0039809842c0e4d35868059809 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a91c09964127f7976530a3f095dd21", "srcset": "https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a91c09964127f7976530a3f095dd21, https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9d1ae620d4950cebfdf5ce9593b2f6 2x, https://si.imgix.net/87e5f46f/uploads/origins/67d12e66-224e-4934-b8b9-433739042fd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e3b37fc44c189b78079b2524e009733 3x"}, "body": "あかし様\n前回は種子島で武装した犬耳巫女さんをありがとうございました。\n今回はあかし様に終戦の日を描いて頂きたく依頼を送ります。\n\n内容\n巫女装束を着た犬耳ロリババアが三八式歩兵銃で半旗の日の丸に捧げ銃をしている絵をお願いします。\n\n詳細\n巫女装束について\n巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。\n\n犬耳、尻尾等について\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは委任します)\n\n体型等について\n人間でいう9〜18歳くらいの外見\n胸部は貧から巨まで委任します。(ロリ巨乳も可)\n\n表情について\nほんの僅かに優しく微笑んでいる、どこか物憂げ、無表情の中から選んでください。\n\nロリババアついて\n「これが描かれていればロリババア」という定義等はありませんが、悠久の時を生きた経験らしさ、威厳なり落ち着いた雰囲気なりが描かれていればと思います。\n\n場所について\n委任します。\n迷うようでしたら神社、海辺、密林、荒れ地、洞窟等あたりをお願いします。\n\nその他解説\n半旗\n特定の日に弔意を表すために旗を少し下げた状態で掲揚する行為\nhttps://ja.wikipedia.org/wiki/%E5%8D%8A%E6%97%97\n\n三八式歩兵銃\nhttps://regimentals.jugem.jp/?eid=3358#gsc.tab=0\n全長127.6cmあるのでロリババアの身長の参考にして下さい。\n\n捧げ銃\n銃で行う敬礼動作の一種\n参考動画\nhttps://youtu.be/4Qn0lU74PUE?si=O1qJ6KvkmZ0196_n\n(23秒あたり)\n\n注意事項等\n「着剣はしない」ようにお願いします。(各個の敬礼でなく隊の敬礼になるため)\nボルトハンドルは横に倒れている(下記pixiv参照)ようにお願いします。\nhttps://www.pixiv.net/artworks/67649363\n毎年色々な絵師様に同一お題で依頼しており、他作品との構図被りは避けられないため、その点に関しては気にしなくて大丈夫です。\n\n今回も大変なお題ではありますがどうか何卒よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jmjpwxag/works/7", "private_thumbnail_image_urls": null, "private": false, "ge