=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eabfebe48a96e98355ae8b3a9bd07f99 3x"}, "body": "またレンとピコの絵をリクエストしてもいいですか？前回のリクエストがとても気に入ったので、レンがさりげなくピコの口を使っているコミュのページを期待していたんです。こんな感じかな？ピコは経験が浅いけど、レンは自分の快楽にしか興味がない。\n\nhttps://www.dropbox.com/scl/fi/rlddwwcvjvqr9a40zyd5h/sample_86f32b542dccfb62bc9ef360640a04cc.jpg?rlkey=2vfo9t5kul7emcgab87x80ra3&st=3udjniii&dl=0\n\n(ここに写っているより、もう少しレンの顔が見たいけどね)。\n\nもしかしたら、レンはこの後どこかへ行く用事があって、無愛想にピコを乱れた状態（顔に精液がついた状態）で放置するのかもしれない。ピコのレンに対する愛情は一方的なものだろうから、こうやって利用されるのがピコの精一杯なのかもしれない。\n\nピコにはその後、照れながらも、レンを気持ちよくさせることができたことを喜んでいるような表情をしてほしい。上の写真の最後のコマと同じような赤面した表情。もしかしたら、レンの精液を口にできてラッキーと思っているのかもしれない。\n\nhttps://www.dropbox.com/scl/fo/56myoecd1r6jlt78rt2ql/AJr-isUHlNLfK6Og1bjpigk?rlkey=jt9axzxb7siyqrwikiaimq1tx&st=n82vzzof&dl=0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_ktro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3392146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df663d94bf715222d3f4bf09e37b238f", "srcset": "https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df663d94bf715222d3f4bf09e37b238f, https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd4797d860b6d57a2462b62de1eb055d 2x, https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a268071c84c5fa4de46fa6a934cb96e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c176e8306d293d68e776409038049fca", "srcset": "https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c176e8306d293d68e776409038049fca, https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9415de20bb2a23f722d9a877682c9776 2x, https://si.imgix.net/8bc68c6c/uploads/origins/2c75a273-b98e-439c-b53a-85070b95eaf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=49f6c858d56870d49c7ced7d26ecad2a 3x"}, "body": "こんにちは、レンくんの描き方がとても好きです。レンくんと歌手音ピコが一緒にいる絵をリクエストしてもいいですか？レンくんはずっと人気のあるアイドルで、ピコくんはあまり有名じゃなくてちょっと自信がないのかなと想像すると楽しいです。人気の差はあっても、ピコがレンに憧れ、恋愛感情を抱く姿を想像するのは楽しい。ピコもレンより少し背が低いかもしれない。\n\nもっと支配的なレンくんが、従順なピコくんとセックスするところをぜひ見てみたい。具体的なポーズは、レンが支配的であれば、お好みにお任せしたいです。オーラルセックスを描くなら、ピコがレンを咥える方がいいですね。アナルセックスを描くなら、レンがピコを犯してほしいです。\n\nありがとうございました！\n\nhttps://www.dropbox.com/scl/fo/nbqc9ak5phao9dcout0ia/h?rlkey=jy6solwqk5yuart86eebm8kow&st=pxu1comb&dl=0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_ktro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3392146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd9fc99f/uploads/origins/438d075e-b143-438e-bf59-45fda6d66dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17906e405ec469b45887b26cff24f537", "srcset": "https://si.imgix.net/dd9fc99f/uploads/origins/438d075e-b143-438e-bf59-45fda6d66dd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17906e405ec469b45887b26cff24f537, https://si.imgix.net/dd9fc99f/uploads/origins/438d075e-b143-438e-bf59-45fda6d66dd7?bg=%23fff&auto=format%2Cco