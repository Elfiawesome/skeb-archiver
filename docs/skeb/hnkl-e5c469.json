8b629345324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57b95045ea428cfea8b60d5c83ed7073 2x, https://si.imgix.net/e5085150/uploads/origins/5512d338-9c2f-4c83-8a4a-58b629345324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=185a68fdce882fa4c136e73f6cf8803d 3x"}, "body": "\u3057\u306e\u3046\u306b\u69d8\u521d\u3081\u307e\u3057\u3066\uff01\n\u6614\u304b\u3089\ud83c\udf38\u6751\u306eFA\u306e\u6f2b\u753b\u3084\u30a4\u30e9\u30b9\u30c8\u3092\u3088\u304f\u898b\u3066\u3044\u3066\u3001\u30a4\u30e9\u30b9\u30c8\u304c\u5927\u597d\u304d\u3067\u3059\uff01\nSkeb\u52df\u96c6\u3055\u308c\u3066\u3044\u308b\u3068\u304a\u805e\u304d\u3057\u3066\u3001\u305c\u3072\u79c1\u306e\u63a2\u7d22\u8005(OC)\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u4f9d\u983c\u3057\u307e\u3057\u305f\u3002\n\u4f9d\u983c\u6587\u3084\u8cc7\u6599\u306bTRPG\u30b7\u30ca\u30ea\u30aa\u306e\u30cd\u30bf\u30d0\u30ec\u306f\u542b\u307e\u308c\u307e\u305b\u3093\u3002\n\n\u3010\u4f9d\u983c\u5185\u5bb9\u3011\n\u30a2\u30a4\u30c9\u30eb\u306e\u5973\u306e\u5b50\u3067\u3059\uff01\n\u8868\u60c5\u3092\u3068\u4ef0\u3063\u3066\u3044\u305f\u306e\u3067\u3001\u3044\u304f\u3064\u304b\u30a2\u30a4\u30c9\u30eb\u3063\u307d\u3044\u8868\u60c5\u3084\u30b7\u30c1\u30e5\u3092\u6319\u3052\u307e\u3059\u304c\u3001\u597d\u304d\u306b\u53d6\u6368\u9078\u629e\uff65\u8ffd\u52a0\u3057\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u304a\u3082\u3044\u307e\u3059\u304b\n\u611f\u60c5\u8868\u73fe\u306f10\u6bb5\u968e\u4e2d4\u304f\u3089\u3044\u304c\u666e\u6bb5\u306e\u69d8\u5b50(\u5143\u6c17\u3059\u304e\u305a\u30af\u30fc\u30eb\u3059\u304e\u306a\u3044)\n\u7d20\u306e\u8868\u60c5\u304c\u307f\u3093\u306a\u3092\u5f15\u304d\u8fbc\u3080\u9b45\u529b\u3042\u308b\u5b50\u3068\u3044\u3046\u30a4\u30e1\u30fc\u30b8\u306e\u5b50\u3067\u3059\n\n\u3010\u8868\u60c5\u3011\n\uff65\u30a2\u30a4\u30c9\u30eb\u306e\u30d5\u30a1\u30f3\u30b5\n\uff65\u30e2\u30c7\u30eb\u307f\u305f\u3044\u306a\u30ad\u30e1\u9854\n\uff65\u756a\u7d44\u3067\u3081\u3061\u3083\u304f\u3061\u3083\u7b11\u3063\u3066\u308b\u9854\n\uff65\u30d0\u30e9\u30a8\u30c6\u30a3\u756a\u7d44\u3067\u4f53\u3092\u5f35\u3063\u305f\u8868\u60c5(\u3059\u3054\u3044\u4e0d\u5473\u3044\u3082\u306e\u98df\u3079\u305f\u3068\u304b\uff1f)\n\uff65\u30db\u30e9\u30fc\u7cfb\u306e\u756a\u7d44\u3067\u6016\u3044\u3082\u306e\u898b\u305f\u9854\n\uff65\u60c5\u5831\u756a\u7d44\u3067\u771f\u5263\u306b\u8b70\u8ad6\u7b54\u5f01\u3057\u3066\u308b\n\u30fb\u30c9\u30e9\u30de\u3067\u7dba\u9e97\u306b\u6d99\u3092\u6d41\u3059\u30b7\u30fc\u30f3\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8aac\u660e\u3011\nTRPG\u30b7\u30ca\u30ea\u30aa\u300e\u30c7\u30a3\u30fc\u30d7\u30d6\u30eb\u30fc\u306b\u30ad\u30e9\u3081\u3044\u3066\u300fHO\u30a2\u30a4\u30c9\u30eb\n\u540d\u524d\uff1a\u795e\u6238\u8a69\u97f3(\u304b\u3093\u3079 \u3057\u304a\u3093)\n\u8eab\u9577\uff1a152cm\n\u4e16\u754c\u4e00\u306e\u30a2\u30a4\u30c9\u30eb\u3092\u76ee\u6307\u3059\u5c11\u5973\u3067\u3059\u3002\n\u30a2\u30a4\u30c9\u30eb\u306b\u306a\u308a\u305f\u3044\u3068\u601d\u3063\u305f\u65e5\u304b\u3089\u52aa\u529b\u3092\u6b20\u304b\u3055\u306a\u3044\u771f\u9762\u76ee\u306a\u5973\u306e\u5b50\u3067\u3059\u3002\n\u300c\u795e\u6238\u8a69\u97f3\u3067\u3059\u3001\u4e16\u754c\u4e00\u306e\u30a2\u30a4\u30c9\u30eb\u306b\u306a\u308a\u305f\u3044\u3067\u3059\u300d\n\u300c\u79c1\u2026\u2026\u9811\u5f35\u308b\u306d\u300d\n\n\u751f\u307e\u308c\u304b\u3089\u30e2\u30c1\u30fc\u30d5\u3092\u53d6\u308a\u5165\u308c\u3066\u3044\u307e\u3059\u3002\n\u9f20\u8272\uff1a\u7f8e\u8c8c\u30fb\u3057\u306a\u3084\u304b\u30fb\u601d\u3044\u3084\u308a/\u4eba\u306e\u9b42\u3092\u865c\u306b\u3059\u308b\u5929\u5973\u306e\u3088\u3046\u306a\u4eba\n\u661f\u8a00\u8449\uff1a\u300c\u9b45\u529b\u3042\u3075\u308c\u308b\u82b8\u8853\u7684\u624d\u80fd\u300d\n\u7279\u5fb4\uff1a\u81ea\u7136\u306b\u3057\u3066\u3044\u3066\u3082\u4eba\u306e\u8996\u7dda\u3092\u60f9\u304d\u3064\u3051\u3066\u3057\u307e\u3046\u3001\u61a7\u308c\u3092\u62b1\u304b\u308c\u30