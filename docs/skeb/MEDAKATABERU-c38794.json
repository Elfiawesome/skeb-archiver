服\n特徴：193cm、眼帯の下に火傷痕がある、大人びている、全てを諦めてるような儚げがある感じ、問題を一人で抱えがち\n\n［金髪の女性］\n名前：八星 千里\n性別：女性\n年齢：20代\n性格：素直、明るい、優しい\n衣装：私服\n特徴：165cm、大人びている、人当たりがよく、気遣いができる\n※立ち絵では目を閉じているのが多いが、糸目ではなく普通の目。瞳の色は赤。\n\n［関係性］\n二人は孤児院時代からの知り合いで、色々あって虐待から救ってもらったことで比良坂は八星を慕っている。\n八星が教祖、比良坂が信者として宗教を立ち上げたが、なんやかんやあって今は共に孤児院を経営している。\n友達以上恋人未満な関係性。\n\n【使用用途】\nスマホやPC等の壁紙、アイコン・ヘッダーへの利用等、\n友人と私の個人の範囲内での利用をしたいと思っています。\n\nご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1u8PhEet6VTvxrCBknF_vbvM6NTVRtd7V?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MEDAKATABERU/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48615, "client_id": 2123003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e6951f2/uploads/origins/aa0186da-a14c-4c6b-9ab1-afb125617059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd920d60567f7fb5836d2509b56c86ed", "srcset": "https://si.imgix.net/5e6951f2/uploads/origins/aa0186da-a14c-4c6b-9ab1-afb125617059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd920d60567f7fb5836d2509b56c86ed, https://si.imgix.net/5e6951f2/uploads/origins/aa0186da-a14c-4c6b-9ab1-afb125617059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b09729bc44684b1bb10b74809ef441a 2x, https://si.imgix.net/5e6951f2/uploads/origins/aa0186da-a14c-4c6b-9ab1-afb125617059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b06b6d88908b3e44ca76de60653b5351 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e6951f2/uploads/origins/aa0186da-a14c-4c6b-9ab1-afb125617059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1349c0b24935dace39a2629b6532eed0", "srcset": "https://si.imgix.net/5e6951f2/uploads/origins/aa0186da-a14c-4c6b-9ab1-afb125617059?bg=%23fff&auto=f