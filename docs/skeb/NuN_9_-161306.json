ーク　🌻💫\n•夏の星座さそり座にある赤い\n　一等星アンタレスの使者\n→みんなに笑顔を届けにバーチャルアースに来た\n\nキービジュアルと三面図の参考資料はこちらのリンクになります▶︎ https://drive.google.com/drive/folders/10L3ilinwkiEbs4rcX4yJUefd5vChV0Zy\n\n\n【お願い】\nサムネイルなどでも使用させていただく可能性があるため\n背景別の頭部が切れていないキャラクターのみの透過データをいただけるととてもありがたいです。\n\n最後まで読んで頂きありがとうございました。\nもし宜しければご検討よろしくお願い致します‼️\n\n夏野星空", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NuN_9_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1147032, "client_id": 3334143, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b25f8594/uploads/origins/8942207c-87ec-4e68-90a7-6af685fbabc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa7d8134b83c3f12ec9c09d7a5216e6", "srcset": "https://si.imgix.net/b25f8594/uploads/origins/8942207c-87ec-4e68-90a7-6af685fbabc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa7d8134b83c3f12ec9c09d7a5216e6, https://si.imgix.net/b25f8594/uploads/origins/8942207c-87ec-4e68-90a7-6af685fbabc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dc709de5856b6b55a61f1224ed59283 2x, https://si.imgix.net/b25f8594/uploads/origins/8942207c-87ec-4e68-90a7-6af685fbabc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f264616f29f1996d371553d05ddde611 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b25f8594/uploads/origins/8942207c-87ec-4e68-90a7-6af685fbabc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bfc391eda576e4543dc0435f0f0ce08", "srcset": "https://si.imgix.net/b25f8594/uploads/origins/8942207c-87ec-4e68-90a7-6af685fbabc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bfc391eda576e4543dc0435f0f0ce08, https://si.imgix.net/b25f8594/uploads/origins/8942207c-87ec-4e68-90a7-6af685fbabc4?bg=%