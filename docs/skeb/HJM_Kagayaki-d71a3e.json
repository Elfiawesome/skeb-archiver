1c82dcdb19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6bca64f60b0c93f65921d9bb6f7ab08b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e14773b3/uploads/origins/705404d0-f535-422a-9b6f-e1c82dcdb19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0aa6e01b3a7946f6f10d631b3e3aa542", "srcset": "https://si.imgix.net/e14773b3/uploads/origins/705404d0-f535-422a-9b6f-e1c82dcdb19f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0aa6e01b3a7946f6f10d631b3e3aa542, https://si.imgix.net/e14773b3/uploads/origins/705404d0-f535-422a-9b6f-e1c82dcdb19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ef409c9ee83fe67482d83183803de31 2x, https://si.imgix.net/e14773b3/uploads/origins/705404d0-f535-422a-9b6f-e1c82dcdb19f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36ae80d0d40ce80f57ccdd2039c9b29c 3x"}, "body": "初めまして。先日の時雨のイラストがとても良かったので依頼いたします。\n\n〈概要〉\n提督のスマホをチェックしながら手コキ寸止をする時雨\n\n〈人物〉\n時雨（改三）:ケッコン済。着衣。\n提督:裸。四肢を拘束されている。\n\n〈構図〉\n提督は椅子に座らされている。時雨は片手にスマホ、もう片方の手で手コキ。古鷹の乳首責め（https://www.pixiv.net/artworks/98942090）のように後ろから手を伸ばし、肩に頭を置く。構図的に厳しければ、横に別の椅子で座ってするような形で。主観視点か客観視点かは任せます。\n\n〈プレイ〉\n片手で提督のスマホの画像フォルダをチェックしながら手コキ。他の艦娘をオカズにしていることが若干不服なようで寸止めを繰り返される。射精シーンで可能ならキスをさせてほしいです。また、途中からハート目をお願いします。\n（セリフ例）\n「迅鯨に…鹿島に、浜風♥村雨もいるね♥みんなのことこんな目で見てたのかい？」\n「違うって、それおちんちんビクつかせながら言うことじゃないよね？」\n「なんで手を止めるの…って？だってこれは提督へのお仕置きだから。」\n「僕のことしか考えられなくなるまで射精はお預けだよ♥」\n「それに…そんな可愛い顔する提督も悪いんだよ…♥」\n「うわ…♥僕のエッチな画像がいっぱい…こんなことしたかったんだ…♥また提督の弱点見つけちゃった。」\n「大丈夫。僕は提督の好みならなんでも受け入れてあげるよ♥したいこと、されたいこと♥全部叶えてあげるから…」\n\n〈備考〉\n時雨は「自分だけを見て欲しい」と思ってはいますが、他の艦娘の画像を削除したりはしません。先日のイラスト同様、愛ゆえの暴走です。\nシチュ、セリフは一例です。必要分だけ採用し、自由に改変して下さい。\n作業量に対して額が足りなければ再送します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HJM_Kagayaki/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/11997747/uploads/origins/d19fdae1-8b8c-4ce6-84be-549acb84d1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6a5a229e2882bd541e4adf65119cae2", "srcset": "https://si.imgix.net/11997747/uploads/origins/d19fdae1-8b8c-4ce6-84be-549acb84d1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6a5a229e2882bd541e4adf65119cae2, https://si.imgix.net/11997747/uploads/origins/d19fdae1-8b8c-4ce6-84be-549acb84d1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3af74817e0e31a3f263717271a536fb 2x, https://si.imgix.net/11997747/uploads/origins/d19fdae1-8b8c-4ce6-84be-549acb84d1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8a376d2483227ceb40695313f0cd56ed 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1828879, "client_id": 349624, "nc": 177}, {"path": "/@HJM_Kagayaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1828879, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d7903425c47e113591fdd7b94c158ab", "srcset": "https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d7903425c47e113591fdd7b94c158ab, https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35de87e4ef10990a4e813d8ac1f98b7f 2x, https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e50996d35189f59cc9d8f6ad665d5ac8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0be6ed603a21d5873b7029a5863ff1de", "srcset": "https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0be6ed603a21d5873b7029a5863ff1de, https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c6a37e559f9d766807affe0129ce372 2x, https://si.imgix.net/38821c95/uploads/origins/813e839d-4ef2-4432-abbe-51e3b66a689b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83f47c824489e72e7bffe4b59fbc9ce9 3x"}, "body": "初めまして。\n度々可愛い大鳳ちゃんをお描きになられていたのは存じていたのですが、此度リクを始められた事にやっと気付きました次第です。\n\n若干マニアックな内容で申し訳無いのですが、以前何度かお描きになられた汗かき大鳳ちゃんとのエッチの延長線上的な匂いフェチ系ネタとして\n「\"ガス\"が溜まりやすい大鳳ちゃん。提督とアナルセックスする段階になって徐々にこみ上げてきてしまいちょっと待ってくれるように懇願するが、逆に提督に(指orアソコの先で)刺激されて思わず(無音で)すかしてしまう。それだけでも既に恥ずかしくて死にそうなのに大鳳の事ならなんだって受け入れるとそのまま挿入する提督。抜き差しの度に何度も漏れてしまい、羞恥にまみれながらもついつい最後まで提督としてしまう」\nという具合でお願いできないでしょうか。\n\nポーズですがイメージとしてはこちら(https://www.pixiv.net/artworks/74023866)のような感じで、大鳳ちゃんは頭から足元まで全部見える形でお願いします。\n衣装は改。スパッツ＆パンツだけ(挿入できる程度に)ずり下げた状態で、艤装は不要ですがそれ以外の艦娘服は完全着衣でお願いします(靴も履いた状態)。\nイメージとしては遠征か何かから帰ってきたばかりの彼女を提督机に上がらせて、そのまましている感じです(夜まで我慢できなかったという設定)。\n\n「すかし」ですが、こちら(https://www.pixiv.net/artworks/65980577)の汗のようなイメージで気体は白いモヤ＆擬音で「ぷすーっ」「ぷっ」等の静音・小さなすかし音を表現していただければと思います(あまり汚い感じになるのもどうかと思いまして…)。\n状況としては「大鳳ちゃんとラブラブえっち」シリーズのケッコン後で多少はそういう変態的なプレイも許容できるようになっている想定ですが、あくまで番外としていただいて問題ありません。\n\n長くなりましたがどうかご検討いただければ幸いです。\n宜しくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HJM_Kagayaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1828879, "client_id": 31515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea202540c1e9d15239a79b750968700f", "srcset": "https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea202540c1e9d15239a79b750968700f, https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60e952377a519928e06c9eece9b779fd 2x, https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df201cba0b0dd7844379a6658938dd26 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=807d1da183efb95a2c23537f93b5eacf", "srcset": "https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=807d1da183efb95a2c23537f93b5eacf, https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9e0f1f51d21aaccc180df199a948373 2x, https://si.imgix.net/c6b7a0a8/uploads/origins/f209d037-91cf-4c54-8e79-72a66513ff7b?bg=%23fff&aut