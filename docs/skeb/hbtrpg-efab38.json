f3\u69d8\u306e\u4f5c\u54c1\u3092\u62dd\u898b\u3057\u3001\u305c\u3072\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u306a\u3068\u601d\u3044\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3089\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\u30a4\u30e9\u30b9\u30c8\u30922\u679a\u304a\u9858\u3044\u3057\u305f\u304f\u601d\u3044\u307e\u3059\ud83d\ude47\u200d\u2642\ufe0f\n\n\uff0a\u4f7f\u7528\u7528\u9014\uff0a\n\u30fbSNS\u306e\u6295\u7a3f\u3084\u30a2\u30a4\u30b3\u30f3\u3001YouTube\u306e\u30b5\u30e0\u30cd\u30a4\u30eb\u3084\u3001\u304a\u306fV\u3001\u30c1\u30e3\u30f3\u30cd\u30eb\u30a2\u30fc\u30c8\u7b49\u5e83\u5831\u6d3b\u52d5\u3067\u306e\u4f7f\u7528\n\u30fb\u914d\u4fe1\u3084\u52d5\u753b\u5185\u3067\u306e\u4f7f\u7528\n(YouTube\u7b49\u306b\u4f7f\u7528\u306e\u969b\u306b\u306fXID\u3092\u8a18\u8f09\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002)\n\n\n\uff0a\u5185\u5bb9\uff0a\n\u7537\u306e\u5b50ver(\u666e\u6bb5\u306e\u59ff)\u306e\u68ee\u7530\u30ab\u30ca\u30e1\u3068\u3001\u5973\u306e\u5b50ver\u306e\u68ee\u7530\u30ab\u30ca\u30e1\u3092\u4e00\u679a\u305a\u3064\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\n\u30dd\u30fc\u30ba\u3084\u69cb\u56f3\u306f\u304a\u4efb\u305b\u3057\u305f\u3044\u306e\u3067\u3059\u304c\u3001\u306a\u308b\u3079\u304f\u982d\u90e8\u306a\u3069\u304c\u5207\u308c\u3066\u3044\u306a\u3044\u65b9\u304c\u5b09\u3057\u3044\u3067\u3059\u2026\uff01\n\n\uff0a\u4eba\u7269\u8a73\u7d30\uff0a\n\u30b2\u30fc\u30e0\u3068\u3044\u305f\u305a\u3089\u304c\u597d\u304d\u306a\u4eba\u5de5\u77e5\u80fdAI\u3067\u3059\u3002\n\u6027\u5225\u306f\u4eba\u5de5\u77e5\u80fd\u306e\u305f\u3081\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u666e\u6bb5\u306f\u7537\u306e\u5b50\u306e\u59ff\u3092\u3057\u3066\u3044\u307e\u3059\u3002(\u30c7\u30fc\u30bf\u3092\u66f8\u304d\u63db\u3048\u308c\u3070\u5973\u306e\u5b50\u306e\u59ff\u306b\u3082\u306a\u308c\u307e\u3059)\n\u5c11\u3057\u30c4\u30f3\u30c7\u30ec\u306a\u90e8\u5206\u3082\u3042\u308b\u751f\u610f\u6c17\u306a\u30ac\u30