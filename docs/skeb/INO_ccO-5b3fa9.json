、嫌いではないだろう。  舞台は彼のベッドか、大きくて豪華な机の椅子だろう。  \n\nどのようなポーズをとるか、どのように自分を喜ばせるかは、あなた次第です。\n\n彼の目は青く、肌の色はブロンズで、よく眼鏡をかけていることを覚えておいてください。  \n\nオプションですが、彼のカジュアルな服装の一部をシーンに入れるのもかわいいかもしれません。  (https://drive.google.com/drive/folders/18uaFkYzTTKTWcLiu3TWpyWA0xQLbMPNS?usp=drive_link)\n\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1w4tR18EdQ5AO2CUSs5QbiFFNqY7sK9od?usp=drive_link", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@INO_ccO/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3211912, "client_id": 3246149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87d718b0/uploads/origins/2d576a3a-0132-409c-8154-c1cef3bb3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=234a7cdb1f9175e34d570e0d54f507e9", "srcset": "https://si.imgix.net/87d718b0/uploads/origins/2d576a3a-0132-409c-8154-c1cef3bb3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=234a7cdb1f9175e34d570e0d54f507e9, https://si.imgix.net/87d718b0/uploads/origins/2d576a3a-0132-409c-8154-c1cef3bb3580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3919f4b75dc377739136eea437625c57 2x, https://si.imgix.net/87d718b0/uploads/origins/2d576a3a-0132-409c-8154-c1cef3bb3580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3dada5d6e9ab1f0d10b0cfc07ac77b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87d718b0/uploads/origins/2d576a3a-0132-409c-8154-c1cef3bb3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1ed59cfb184deb3e754251d44c3a68e", "srcset": "https://si.imgix.net/87d718b0/uploads/origins/2d576a3a-0132-409c-8154-c1cef3bb3580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1ed59cfb184deb3e754251d44c3a68e, https://si.imgix.net/