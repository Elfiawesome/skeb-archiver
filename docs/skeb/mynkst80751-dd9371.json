044\u306a\u3044\u3001\u3068\u3044\u3046\u5834\u5408\u306f\u7121\u8996\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u677f\u69d8\u306e\u63cf\u3044\u305f\u30a4\u30e9\u30b9\u30c8\u3067\u3042\u308c\u3070\u306a\u3093\u3067\u3082\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\n\u3010\u670d\u88c5\u3001\u898b\u305f\u76ee\u3011\n\u30fb\u7537\u6027\u3001\u898b\u305f\u76ee\u306f18\u6b73\u3067\u3059\u304c\u4f55\u5343\u5e74\u3082\u751f\u304d\u3066\u3044\u307e\u3059\u3002\n\u30fb\u984d\u304b\u30892\u672c\u306e\u89d2\u304c\u751f\u3048\u3066\u3044\u308b(\u4f8b\u3048\u308b\u3068FGO\u306e\u9152\u5451\u7ae5\u5b50\u306e\u3088\u3046\u306a)\u9b3c\u65cf\n\u30fb\u8eab\u9577\u306f178cm\n\u30fb\u548c\u670d\u304b\u30d6\u30ec\u30b6\u30fc\u5236\u670d\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\u67c4\u3084\u8272\u306f\u554f\u3044\u307e\u305b\u3093\u3002\n\u30fb\u304a\u5144\u3055\u3093\u306e\u3088\u3046\u306a\u98a8\u8c8c\u3067\u3001\u512a\u3057\u304f\u7b11\u3044\u307e\u3059\u304c\u3001\u77b3\u306e\u5965\u306b\u95c7\u304c\u6f5c\u3080\u2026\u2026\u3068\u3044\u3046\u3088\u3046\u306a\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\n\n\u3010\u9854\u3011\n\u30fb\u82e5\u5e72\u30c4\u30ea\u76ee\u3067\u77b3\u5b54\u306e\u771f\u4e0b\u306e\u6d99\u888b\u306b\u30db\u30af\u30ed\u304c\u3042\u308a\u307e\u3059\u3002\n\u30fb\u30cf\u30a4\u30e9\u30a4\u30c8\u306f\u5c0f\u3055\u3081(\u306a\u304f\u3066\u3082\u3044\u3044\u3067\u3059)\n\u30fb\u5de6\u8033\u306e\u8033\u305f\u3076\u306b\u9ed2\u304f\u3001\u5c0f\u3055\u304f\u3066\u4e38\u3044\u30d4\u30a2\u30b9\u3092\u3072\u3068\u3064\u7740\u3051\u3066\u307e\u3059\u3002\n\n\u3010\u9aea\u578b\u3011\n\u30fb\u524d\u9aea\u306f\u30af\u30ed\u30b9(\u540d\u63a2\u5075\u30b3\u30ca\u30f3\u306e\u5b89\u5ba4\u900f\u3055\u3093\u306e\u3088\u3046\u306a)\u524d\u9aea\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u30fb\u9854\u30b5\u30a4\u30c9\u306e\u9aea\u306e\u6bdb\u306f\u59eb\u30ab\u30c3\u30c8\u307f\u305f\u3044\u306b\u304a\u9858\u3044\u3057\u307e\u3059\u3002\u59eb\u30ab\u30c3\u30c8\u3068\u306f\u8a00\u3063