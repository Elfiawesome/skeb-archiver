op&w=200&h=200&s=1d901850ebb58dc028dbbc25f7d41796", "srcset": "https://si.imgix.net/b68e9187/uploads/origins/9004ec13-9dba-4024-9843-faff4a5f701c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d901850ebb58dc028dbbc25f7d41796, https://si.imgix.net/b68e9187/uploads/origins/9004ec13-9dba-4024-9843-faff4a5f701c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ce657f50c9e3e43fafd0f3c74b68da3 2x, https://si.imgix.net/b68e9187/uploads/origins/9004ec13-9dba-4024-9843-faff4a5f701c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f1d13dc766313e3fa33e5bbb5303eae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b68e9187/uploads/origins/9004ec13-9dba-4024-9843-faff4a5f701c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3af162a5b1b07c99664a656f883eb35d", "srcset": "https://si.imgix.net/b68e9187/uploads/origins/9004ec13-9dba-4024-9843-faff4a5f701c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3af162a5b1b07c99664a656f883eb35d, https://si.imgix.net/b68e9187/uploads/origins/9004ec13-9dba-4024-9843-faff4a5f701c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d141f15591bf0c139becf3535b885a6f 2x, https://si.imgix.net/b68e9187/uploads/origins/9004ec13-9dba-4024-9843-faff4a5f701c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f6ba6777a58ef54df23370ae2777d37 3x"}, "body": "som\u5148\u751f\u3001\u306f\u3058\u3081\u307e\u3057\u3066\u3002 Skeb\uc774 \ub2f9\uc2e0\uc744 \ucd94\ucc9c\ud588\uace0 \ub2f9\uc2e0\uc758 \uc608\uc220\uc774 \uc815\ub9d0 \ub9c8\uc74c\uc5d0 \ub4e4\uc5b4\uc694! \ub450 \uac00\uc9c0 \ubd80\ud0c1\uc744 \ub4dc\ub9ac\uace0 \uc2f6\uc2b5\ub2c8\ub2e4. \ubcf4\ub0b4\uc8fc\uc2e0 \uae08\uc561\uc774 \ubd80\uc871\ud558\uc2dc\uba74 1\ubc88\uc73c\ub85c \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4. (\uc7ac\uc804\uc1a1 \uc8c4\uc1a1\ud569\ub2c8\ub2e4. \uc798\ubabb\ub41c \ub9c1\ud06c\ub97c \ud3ec\ud568\ud588\uc2b5\ub2c8\ub2e4.) \u25b7\uce90\ub9ad\ud130 \uc720\ub098, 17\uc138, \uc5ec\uc131 \uc820\ud2c0 \ud790\ub9c1\ud615 \uc544\uc774\ub3cc. \uadf8\ub140\uc758 \ud32c\ub4e4\uc740 \uadf8\ub140\ub97c \ucc9c\uc0ac\ub77c\uace0 \ubd80\ub985\ub2c8\ub2e4. \ud558\uc9c0\ub9cc \uce74\uba54\ub77c\uac00 \uaebc\uc9c0\uba74 \uc5f0\uc544\ub294 \ub0c9\uc18c\uc801\uc774\uace0 \ub0c9\uc18c\uc801\uc778 \uadf8\ub140\uc758 \uc6d0\ub798 \ubaa8\uc2b5\uc73c\ub85c \ub418\ub3cc\uc544\uac04\ub2e4. \u25b7\uc758\ub8b0 1 \uc568\ubc94 \ucee4\ubc84 \uc2a4\ud0c0\uc77c\uc758 \uc77c\ub7ec\uc2a4\ud2b8\ub97c \uadf8\ub824\uc8fc\uc138\uc694. \uadf8\ub140\ub294 \"2 - \u65b0\u88c5\" \uc774\ubbf8\uc9c0\uc758 \uc758\uc0c1\uc744 \uc785\uace0 \uc788\uc5b4\uc57c \ud558\uba70 \uba38\ub9ac\ub294 \ud2b8\uc708 \ud14c\uc77c \uc2a4\ud0c0\uc77c\uc774\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc568\ubc94\uba85\uc740 'Lemon Life'. \ud3ec\uc988 \uc81c\uc548: (1) \uc78e\uc0ac\uadc0(\uba38\ub9ac\uce74\ub77d\uc5d0 \uc788\ub294 \uac83\uacfc \uac19\uc740 \uac83)\ub97c \ub4e4\uace0 \ubc14\ub78c\uc744 \ubd88\uae30. (2) \ub808\ubaa8\ub124\uc774\ub4dc\ub97c \ub9c8\uc2e0\ub2e4. (3) \uc6d0\ud558\ub294 \ud3ec\uc988. \u25b7\uc758\ub8b02 \uc5ec\uae30 \uadf8\ub824\uc8fc\uc2e0 \uc5f4\uc1e0\uace0\ub9ac \ub108\ubb34 \ub9c8\uc74c\uc5d0 \ub4e4\uc5b4\uc694! (https://twitter.com/Somu_4/status/1576189886767321088) \uc81c OC\ub3c4 \uac19\uc740 \uc2a4\ud0c0\uc77c\ub85c \uadf8\ub824\uc8fc\uc2e4 \uc218 \uc788\ub098\uc694? \uadf8\ub140\ub294 \"2 - \u65b0\u88c5\" \uc774\ubbf8\uc9c0\uc758 \uc758\uc0c1\uc744 \uc785\uace0 \uc788\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uac00\ub2a5\ud558\uba74 \ud5e4\uc5b4\uc2a4\ud0c0\uc77c\ub9c8\ub2e4 \uc5f4\uc1e0\uace0\ub9ac\ub97c \ud558\ub098\uc529 \uadf8\ub824\uc8fc\uc138\uc694. \u203b \uc758\uc0c1\uc744 \ub2e8\uc21c\ud654\ud574\ub3c4 \uad1c\ucc2e\uc2b5\ub2c8\ub2e4. \uc0ac\uc2e4 \uadf8\uac83\uc740 \uad8c\uc7a5\ub429\ub2c8\ub2e4. \u25b7\ub514\ud14c\uc77c \uadf8\ub140\uc758 \ud5e4\uc5b4\ub294 \ud22c\ud1a4\uc785\ub2c8\ub2e4(\uc774\ubbf8\uc9c0 1 \ucc38\uc870). \uadf8\ub140\uc758 \ub208\uc740 \uac08\uc0c9\uc785\ub2c8\ub2e4. PSD\uc758 \ubcc4\ub3c4 \ub808\uc774\uc5b4\uc5d0 \uc11c\uba85\uc744 \ub123\uc5b4\uc8fc\uc138\uc694. \uc81c \uc694\uccad\uc744 \uace0\ub824\ud574 \uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4.\n\nhttps://drive.google.com/drive/u/0/folders/1i7Ql7JXIWUzWP99Btmdd6BP5EFhA0erq", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Somu_4/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634100, "client_id": 2635409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c01385e8/uploads/origins/20d40a26-5612-4f47-9719-2d6ad9c4be25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12e94ad745f879cda359829337fed16b", "srcset": "https://si.imgix.net/c01385e8/uploads/origins/20d40a26-5612-4f47-9719-2d6ad9c4be25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12e94ad745f879cda359829337fed16b, https://si.imgix.net/c01385e8/uploads/origins/20d40a26-5612-4f47-9719-2d6ad9c4be25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13aacc74200b1cba32a1b4c069f37fa9 2x, https://si.imgix.net/c01385e8/uploads/origins/20d40a26-5612-4f47-9719-2d6ad9c4be25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14cbabb696eb1e7ca6cbfd66619a2d92 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c01385e8/uploads/origins/20d40a26-5612-4f47-9719-2d6ad9c4be25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72625e96b256467c8910a9d3d61fb242", "srcset": "https://si.imgix.net/c01385e8/uploads/origins/20d40a26-5612-4f47-9719-2d6ad9c4be25?bg=%23fff&auto=format%2Ccompress&fm=we