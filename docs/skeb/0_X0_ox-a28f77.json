fb2/uploads/origins/4d595d1d-8339-4da2-855b-8bda3af274f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab1e5c69f23ea514d9ee77566557f3ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0715bfb2/uploads/origins/4d595d1d-8339-4da2-855b-8bda3af274f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8b37d954ba7b1ad7b3e76ee07fd90c8", "srcset": "https://si.imgix.net/0715bfb2/uploads/origins/4d595d1d-8339-4da2-855b-8bda3af274f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8b37d954ba7b1ad7b3e76ee07fd90c8, https://si.imgix.net/0715bfb2/uploads/origins/4d595d1d-8339-4da2-855b-8bda3af274f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f893d99da2fdac3478d910e382b61244 2x, https://si.imgix.net/0715bfb2/uploads/origins/4d595d1d-8339-4da2-855b-8bda3af274f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=792ed7fcd1e2c5b186cb2f443c73e37a 3x"}, "body": "葛の葉小月（1963年設定、金子雷蔵アートスタイル）（葛の葉雷蔵XV）のファンアートを依頼したい。\nこの作品では、父（葛の葉雷蔵14世）のポーズを反映し、右手に3本のナイフを持ち、左手には召喚に使うトランシーバーを持っています。髪はバッサリと乱れ、父や母（凪芸林17世）と同じ。ミリタリー柄のジャケットを羽織り、背中には花柄、前から見ると黒色のマントを羽織り、右目には傷跡があり、右腕にはサクラメントがあり、軍手をしている。そしてライドウと同じような剣を持っている。背が高く、年齢の割に大人っぽく、表情は険しく、見る人の参考になるような目をしている：\nhttps://drive.google.com/file/d/19CjK9KPbDokumrSaDiogzWi7thpr7vz3/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0_X0_ox/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2283858, "client_id": 3108934, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f051009/uploads/origins/637b0dd5-1f93-42a5-b474-43aa9ab8d8a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17176f176f7908aaf733a3de58506dda", "srcset": "https://si.imgix.net/3f