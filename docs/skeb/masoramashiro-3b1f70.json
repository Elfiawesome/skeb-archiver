意向により、以下用途の可能性があります。）\n・Youtubeサムネイル\n・SNSでの画像投稿\n・その他個人利用（PC壁紙の設定、観賞用にアクスタの作成等）\n\n【希望ファイル形式】\n・人物のみの透過データも頂けますと幸いです！\n（透過データがない場合、頂いたデータを元に透過データを作成させていただく場合があります。）\n\nまそら ましろ様にご快諾頂けることを心待ちにしております。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/0/folders/121R29D91eVtbSsf5IdfkBgt0MBtfNNTB", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@masoramashiro/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 973219, "client_id": 28537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c9efd17/uploads/origins/29974b14-6094-49ff-a9ef-9cdf7d49c282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c1e27375f5777153112543d331a75aa", "srcset": "https://si.imgix.net/1c9efd17/uploads/origins/29974b14-6094-49ff-a9ef-9cdf7d49c282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c1e27375f5777153112543d331a75aa, https://si.imgix.net/1c9efd17/uploads/origins/29974b14-6094-49ff-a9ef-9cdf7d49c282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25344fcf0839afcb8f86e2613e9cfc02 2x, https://si.imgix.net/1c9efd17/uploads/origins/29974b14-6094-49ff-a9ef-9cdf7d49c282?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d814c3a9a48076fac7b5ba4750f71b29 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c9efd17/uploads/origins/29974b14-6094-49ff-a9ef-9cdf7d49c282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1fff3ce09e608ab593803b1a3c37482", "srcset": "https://si.imgix.net/1c9efd17/uploads/origins/29974b14-6094-49ff-a9ef-9cdf7d49c282?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1fff3ce09e608ab593803b1a3c37482, https://si.imgix.net/1c9efd17/uploads/origins/29974b14-6094-49ff-a9ef-9cdf7d49c282?bg=%23fff&auto=fo