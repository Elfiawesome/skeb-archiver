」\n「俺はこの職に誇りを持ってます。」\n\nとなっております  ご都合などもあり、難しいようでしたら断っていただいて構いません。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1WcLLIkiDkFGAJqZyywNKNdN6FwHpwcvs", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saikusa_2525/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3702053, "client_id": 3691082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9662f096/uploads/origins/49123a1b-2bb5-42b1-a4de-7fcfb39091da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4c63bfc76e952dd736b75759ddd237", "srcset": "https://si.imgix.net/9662f096/uploads/origins/49123a1b-2bb5-42b1-a4de-7fcfb39091da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a4c63bfc76e952dd736b75759ddd237, https://si.imgix.net/9662f096/uploads/origins/49123a1b-2bb5-42b1-a4de-7fcfb39091da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43a4d5f46514c07dcdc5c721317f4f4e 2x, https://si.imgix.net/9662f096/uploads/origins/49123a1b-2bb5-42b1-a4de-7fcfb39091da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18d28f61f5c4d91262a0d9285957924e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9662f096/uploads/origins/49123a1b-2bb5-42b1-a4de-7fcfb39091da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e68766c36e8e43abbd98026dee0c788", "srcset": "https://si.imgix.net/9662f096/uploads/origins/49123a1b-2bb5-42b1-a4de-7fcfb39091da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e68766c36e8e43abbd98026dee0c788, https://si.imgix.net/9662f096/uploads/origins/49123a1b-2bb5-42b1-a4de-7fcfb39091da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb64605f70af154cfa26d7d948271ac 2x, https://si.imgix.net/9662f