ry much.\n\nhttps://lit.link/aoiRuri", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @\u30a2\u30cb\u30e1\u539f\u753b\u98a8skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 33, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 8, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 176}, {"id": 1929346, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "\u3075\u305b\u3093\u308a\u3087", "screen_name": "fusenryo2", "avatar_url": "https://pbs.twimg.com/profile_images/1570380827116343297/3nAQlmbS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429384473171283969/1629629288/1500x500", "appeal_receivable": false, "popular_creator_rank": 44, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 16}, {"id": 2340657, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "\u8fd1\u54b2335", "screen_name": "Ponlen02", "avatar_url": "https://pbs.twimg.com/profile_images/1875573169874202629/-DtAGVlu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1573272377710223360/1722990963/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "com