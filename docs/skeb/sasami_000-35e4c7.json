ての距離感。\nカップリングとしてはA×Bです。\n\n\n【希望シチュエーション】\nバディのような空気感で捜査(推理)をしている様子か、2人の時間を楽しんでいる様子をお願いしたいです。希望としては以下のいずれかですが、さぬきち様の描きやすいようにしていただければ幸いです。\n\n・2人で捜査をしている様子(室内でウェビングマップや資料を広げているような…)\n・町中を2人で調べ回っている様子\n\n・部屋で2人きりで会話をしている様子\n・2人で街に買い物に行っている様子\n\n\nはじめてこうしたリクエストをさせていただくので、何か不備がありましたらすみません。\n金額不足などあった場合は再送させていただきます。\nご検討のほど何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Qm71t0eBGfOzR6ujcSwhZgvd-FfcGbmp?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 583942, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "白畜生🤮強く生きる", "screen_name": "tamagoDX1414", "avatar_url": "https://pbs.twimg.com/profile_images/1485257104672067588/8J4BI7eY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1062268016258236422/1621819069/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2002400, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "れおたろー🐈", "screen_name": "reo_tora12", "avatar_url": "https://pbs.twimg.com/profile_images/1956570632067686400/hvvFHwRX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1063714246146502656/1667964201/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2742776, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "椅子井@多忙", "screen_name": "ISUI_130", "avatar_url": "https://pbs.twimg.com/profile_images/1648514591142608898/p60sZpcD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1620308824203882496/1684105388/1500x500"