じだと嬉しいです。\nケッコン衣装着るにあたって本物は少し恥じらっている感じで、\n指揮官はむしろ衣装を着ることに乗り気な感じでお願いしたいです。\n\nもしも書けそうであればよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eternalrosebud/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 339514, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d897229644dc0061b152c0fb42d7825", "srcset": "https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d897229644dc0061b152c0fb42d7825, https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1dc53773c2e9ec916dc8b54654dbf020 2x, https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=624629f50a69419a8fc034fd5f1f111b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3be5e312b6f9c9cbaa78368491196574", "srcset": "https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3be5e312b6f9c9cbaa78368491196574, https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74ecd38b2fa39db3990ed9a7c2d759e1 2x, https://si.imgix.net/90d77d1e/uploads/origins/c82c078d-1e22-4330-a179-1f8da0b8602b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b23da89323cb22a5967e65d3ac0883e5 3x"}, "body": "前回はスモーリーになってしまう指揮官のイラストを書いて頂きありがとうございます。\nもしよければそのイラストの続きで着任した本物スモーリーとハロウィンスモーリー指揮官が衣装交換する話をお願いできますか？\n本物と指揮官の見分けがつくように髪型は着替えてもそのままで、\n実は指揮官の方が本物より少し背が低い感じだと嬉しいです。\n（理由としてはハロウィン衣装は着任前の少し昔のスモーリーのデータを元に作ってるので少し小さかったからみたいな設定でお願いします）\n\n本物スモーリーがハロウィン衣装着るとものすごい恥ずかしがってしまうし魔法を使おうとしても使えない、\n指揮官が通常衣装着ると少しサイズが合わないからダボッとしてしまうし魔法使おうとしても使えなくなってしまう感じでお願いします。\n\n後、指揮官はハロウィン衣装に慣れて羞恥心がだいぶ無くなってるせいか通常衣装を着る方がむしろ恥ずかしくなってて、\n普段魔法に頼り切ってるせいか魔法が使えないと本物と違って普通の女の子かそれ以下の力しか出せなくなるみたいな感じだと嬉しいです。\n\n\nそれからもし余裕があれば後日談的な感じで元の衣装（指揮官はハロウィン衣装）に着替えた後本物スモーリーが指揮官に運動不足解消のために一緒に筋トレしたり、指揮官が本物スモーリーに魔法を使ってる所を見せるため一緒の箒に乗って飛んで見せたりしつつ親密度が上がってく話とか書いていただけるとすごい嬉しいです。\n\n\n\n結構なわがままな依頼を書いてしまいましたが時間に余裕があって書けそうであればよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eternalrosebud/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 339514, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c2cd77b/uploads/origins/b829c58a-760e-4fbd-b58f-82945a53e6b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82e66c9e3cdf1338f1def42f0848fc1", "srcset": "https://si.imgix.net/1c2cd77b/uploads/origins/b829c58a-760e-4fbd-b58f-82945a53e6b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b82e66c9e3cdf1338f1def42f0848fc1, https://si.imgix.net/1c2cd77b/uploads/origins/b829c58a-760e-4fbd-b58f-82945a53e6b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce13dfbe878ab5327efd5cbe8e48c273 2x, https://si.imgix.net/1c2cd77b/uploads/origins/b829c58a-760e-4fbd-b58f-82945a53e6b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c19f8fb92c1e16f52acc56f9b1eaabf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c2cd77b/up