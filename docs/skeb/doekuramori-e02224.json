い子供に「肉の種」を植えては爆発させ、\n「貴方も駄目なのね・・・そう・・」と残念そうにしている。\n\n触手の中には巨大なエネルギー砲を隠しており、本気で戦う際には触手の中から組み立てて使用する。\n\n\n恋人と結婚した直後に拘束され試験体となる。\n無論恋人は殺され、それを知り発狂したが、色々な薬を飲まされ人格は崩壊している。\n\n触手で人を摂食することが出来、新たな肉とすることが出来る。\n摂食するとなんとなく気持ちよい。夢心地になりながら色々な場所をさまよっては村を襲い、種を植え付けている\n\nhttps://twitter.com/cynoroid/status/1361886957819760641?s=21", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@doekuramori/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 57098, "client_id": 787392, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fcc8b2cf980df067e1904a02106591b", "srcset": "https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fcc8b2cf980df067e1904a02106591b, https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48ebcfa6f06b550673c9a2f7d306e914 2x, https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3afbd044a39c51beaefdd6b3819d139c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75d4bd91ad3b844a9eff4b3f4a8caced", "srcset": "https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75d4bd91ad3b844a9eff4b3f4a8caced, https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c51784e44353565a297e06561994cc05 2x, https://si.imgix.net/d340a995/requests/226700_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=