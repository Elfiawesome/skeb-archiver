です！とても陽気で遊び好きですが、瞑想や旅も好きです。ポーズや服装はお任せしますが、ネックレスは必ず描いてください！ 彼の世界には豊かな自然、古代遺跡、魔法が存在し、モチーフは宇宙・太陽・植物・炎です。ヒーラーとして薬草学や医療知識に精通しています。魔法の描写がとてもお上手なので、炎や陽光でできたドラゴンや鳥を召喚するシーンを描いていただけると嬉しいです。どんな生き物でもご自由に創作してください！よろしくお願いします！", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@c_cutai/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3140964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15301bfd/uploads/origins/da41c87c-48b0-4ce5-a33f-759e6a720750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c755001bfd9893ba7bc16c9a15b9bc", "srcset": "https://si.imgix.net/15301bfd/uploads/origins/da41c87c-48b0-4ce5-a33f-759e6a720750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c755001bfd9893ba7bc16c9a15b9bc, https://si.imgix.net/15301bfd/uploads/origins/da41c87c-48b0-4ce5-a33f-759e6a720750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b538ac6a3fa166b9ebd014c6e68afdf5 2x, https://si.imgix.net/15301bfd/uploads/origins/da41c87c-48b0-4ce5-a33f-759e6a720750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f056359e31b0eed78aa65715d4b359a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15301bfd/uploads/origins/da41c87c-48b0-4ce5-a33f-759e6a720750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c95abc05fbe8e60a035f087eb7e4744d", "srcset": "https://si.imgix.net/15301bfd/uploads/origins/da41c87c-48b0-4ce5-a33f-759e6a720750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c95abc05fbe8e60a035f087eb7e4744d, https://si.imgix.net/15301bfd/uploads/origins/da41c87c-48b0-4ce5-a33f-759e6a720750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aec4ecc02f6739e0057b2095ac2cd8e5 2x