a0b-dc430504f25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad31ebc41036c4fbf3d63f53f3118b83", "srcset": "https://si.imgix.net/8f68e107/uploads/origins/f0aa0c2c-c2bd-4b6d-8a0b-dc430504f25e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad31ebc41036c4fbf3d63f53f3118b83, https://si.imgix.net/8f68e107/uploads/origins/f0aa0c2c-c2bd-4b6d-8a0b-dc430504f25e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=945a8152c4a91a68d266606643bbad06 2x, https://si.imgix.net/8f68e107/uploads/origins/f0aa0c2c-c2bd-4b6d-8a0b-dc430504f25e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d958324e55607b38c34b0fb712b2588e 3x"}, "body": "シャバドゥビ太郎さんこんばんは！リクエストをさせていただきます。内容と値段が不釣り合いな場合は希望額を提示して再送を要請して下さい。検討します。\n\n内容\nケモノノベルゲーム\npawfect apawcalypseのファンゲームであるIFシリーズのボルト君を描いて欲しいです！\n\n構図＆ポーズ\nキャップ帽子を押さえて男の子らしい感じでジャンプしている構図をお願いします。\n\nアングル\nけいおん！のきららジャンプのような感じでお願いします。\n\n服装\nデザインと配色はお任せします。\n上半身     つばを逆さにしてキャップ帽をかぶせて、ゆったり目の大きい半袖のシャツと腕にはリストバンド\n　　　　でおねがいします。\n下半身 　資料では単色の短パンですがポッケがついたタイプで、靴は履かせずにお願いします。\n\n背景\n全面綺麗な青空でお願いします。\n\n表示\n八重歯が見える程に大きく口を開けて元気な笑顔をお願いします。\n\nその他指定\n・シャバドゥビ太郎さんが描くアイムバアル兄弟が大好きなのでこのお二方のように\n　毛皮がモフモフしている感じにして頂くと嬉しいです！\n・頭身は資料と同じ感じで大丈夫です。\n\nhttps://drive.google.com/drive/folders/1dhGvR4SC3ZY213r6nLz9tthojPX8_2Z6?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2_3up/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3964900, "client_id": 878145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1da497d/uploads/origins/dc642dce-4acb-4a35-a7e5-5b9c6776421b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be4fd41e315816ee97e9a3a7bb4e10c0", "srcset": "https://si.imgix.net/a1da497d/uploads/origins/dc642dce-4acb-4a35-a7e5-5b9c6776421b?bg=%23fff&auto=format%2Ccompr