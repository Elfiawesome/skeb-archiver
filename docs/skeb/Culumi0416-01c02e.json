f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c02b1285ae765d58d531a1fc07d03241, https://si.imgix.net/184c353d/uploads/origins/9414834a-2095-4967-80f9-0e645ad7c386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a955fd4b2b6e48db81f0ee43c07ee1af 2x, https://si.imgix.net/184c353d/uploads/origins/9414834a-2095-4967-80f9-0e645ad7c386?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=224bfc88e24f5bfdbedb8ed05209b948 3x"}, "body": "こんにちは。\nCulumi0416さんが描いたキャラクターが美しく、全て保存するくらい大好きです。\n\n先日投稿されたhttps://skeb.jp/@Culumi0416/works/3 の作品の見下ろす視線がとても気に入ったので、https://x.com/Culumi0416/status/1773238901349507152/photo/1で描かれていたような対立さんに見下ろされる絵がまた見たくなりました。\n\n服装は https://x.com/Culumi0416/status/1652648759736807425/photo/1 にあるような学生服を希望しています。眼鏡は有無どちらでも歓迎です。\nポーズは脚組みを希望していますが、よりお好みの構図があったらそちらを採用いただけますと幸いです。\n\nリクエスト内容や金額に不備がある場合はキャンセル頂いて問題ございません。\nご検討の程、宜しくお願いしますm(__)m", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Culumi0416/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2386257, "client_id": 3174199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfaec2e347b97a6c05758129ed9728a9", "srcset": "https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfaec2e347b97a6c05758129ed9728a9, https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c73a274e2bbeee9b35e7c1252d7efb3 2x, https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67201db761f16f0fb65f29fd89ae3a05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efac2e709122974ee235db9e21be5dfb", "srcset": "https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efac2e709122974ee235db9e21be5dfb, https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e38412d661938ffffdb5fead797bb56 2x, https://si.imgix.net/edb987ef/uploads/origins/c24a6bc7-fbbc-4b4b-9218-c3d3ed865af5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a0f3b696320fa2338596cf5c965d6f0 3x"}, "body": "こんにちは！私はCulumi0416さんが描いたオリジナルキャラクターとArcaeaキャラクターの同人作品が大好きで、お絵かきを依頼したいと思っています！\n\nCulumi0416さんに私の好きなゲームキャラクターが丸メガネをかけている姿を描いてもらいたいです。このキャラクターはアーケード音ゲー「CHUNITHM」のオリジナルキャラクターである「冴川芽依」で、キャラクターの立ち絵は「CHUNITHM」公式サイト（https://chunithm.sega.jp/character/#/chunithm-sun/%E5%86%B4%E5%B7%9D%E8%8A%BD%E4%BE%9D）または以下のリンクが表示されます（https://drive.google.com/file/d/1ON8C17U467rqUb8U8tKl_cpBbjAhqZq3/view?usp=sharing）（主に図中左下隅の立ち絵を参照）\n\nこのキャラクターの設定は話劇社のメンバーで、外見の特徴は肩に短髪で、左前側に髷があり、制服を着ていて、性格的には自分を隠すのが上手で、通常は無口で無表情である。こんなキャラクターが丸メガネをかけてどんな感じなのか見たい！と思います。キャラクターの基本的な服装と外見は確定して、元の設定の前提の下でCulumi0416さんは自由に創作することができて、動作の類はすべて制限しないで、好きなようにお願いします！\n\nそして、その上で「キャラクターが見下すような目をしている」という差分図を描いていただきたいと思います。私はCulumi0416さんのpixivでの作品を見たので（https://www.pixiv.net/artworks/117323559)という目つきが大好きなのでお願いします！\n\n作品の用途はSNS上にあり、同人コミュニティに発表される可能性があり、発表時には名前が明記されています。以上が今回の依頼の内容ですので、よろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Culumi0416/works/2", "private_thumbnail_image_urls":