ただければと思います。\n\n簡易人物像：\n真面目でストイックな性格。弱冠14歳にして古流武術を修めており、その戦闘力は驚異的。\nあと発育も暴力的。\n普段は黒髪だが、気が昂ると画像の通り髪色が変わり狐耳、尻尾が生える「妖狐態」に変身する。\n日本刀を常に携帯しており、戦闘の時には雷を刀に纏わせて戦う。\n（今回描いていただきたいのは狐娘verのほうになります）\n\n\n着せていただきたい服について：\n今回はこの子がパイロットの動きにリンクして動くタイプの巨大ロボットのパイロットになった、というシチュエーションで、パイロットスーツを着たものを描いていただければと思います。\n・Gガンダムのモビルファイターみたいな、体型がわかるぴっちりとしたスーツ\n・全体的には白をメインカラーとする\n・脇の部分や鼠径部は素肌が露出しており、レオタード＋ロンググローブ＋サイハイソックスみたいな構成\n\nhttps://drive.google.com/drive/folders/1g_jQWNNzs7AJtkNf2nQ2ZI9bQM5muS8l?usp=sharing", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hagami495/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 73251, "client_id": 32200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bec2b903/uploads/origins/ccd9f1fb-0ece-4734-9a5b-59b7532f4438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c262e77a36cac74053f9a96575fd1ad8", "srcset": "https://si.imgix.net/bec2b903/uploads/origins/ccd9f1fb-0ece-4734-9a5b-59b7532f4438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c262e77a36cac74053f9a96575fd1ad8, https://si.imgix.net/bec2b903/uploads/origins/ccd9f1fb-0ece-4734-9a5b-59b7532f4438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83c17384eec9f237d572221b9e70ea32 2x, https://si.imgix.net/bec2b903/uploads/origins/ccd9f1fb-0ece-4734-9a5b-59b7532f4438?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f102bce550283687345db8608a2908b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bec2b903/uploads/origins/ccd9f1fb-0ece-4734-9a5b-59b7532f4438?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=850bf728e0d3f04f50c342b1d4b7d367", "srcset": "https://si.imgix.net/bec2b903/uploads/origins/ccd9f1fb-0ece-4734-9a5b-59b7532f4438?bg=%23fff&auto=format%2Cco