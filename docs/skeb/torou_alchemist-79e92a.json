Bd0fRnhD-AXvTaXvkm4N", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@torou_alchemist/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3885975, "client_id": 3836217, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=54a54ef95276ea93dfe128afa418dc2c", "srcset": "https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=54a54ef95276ea93dfe128afa418dc2c, https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=60620468c8ab787912d8924ccaf2d776 2x, https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=83575637542346ea23a8ebe1fbd53ca8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=53637460fe2084d0cc231a7af141f612", "srcset": "https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=53637460fe2084d0cc231a7af141f612, https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12a978a7c6527b90804fec2220caaf09 2x, https://si.imgix.net/8ee3bce1/uploads/origins/bb25a1cf-e515-4207-9de2-aa1ee8b57e50?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=559f19f2b0dc694bbdb06dfdb2769c0a 3x"}, "body": "初めまして。素敵なイラストに惹かれて依頼させて頂きました。\n使用用途はあるけみすとというゲームでのアイコン使用です。\n依頼内容は、可愛い現代服又は可愛いミニ丈着物のアイコンです。\n\n資料の黒い子でお願いしたいのですが、もし可能でしたら黒い子から白い子へ形態変化をお願い出来ましたら幸いです。(難しければ黒い子のみでお願い致します)\n\n資料ですと羽がバラバラなのですが、右側に天使の羽、左側に悪魔の羽(蝙蝠羽の様に少し骨張っている)状態です。\n白い子の瞳は黄金色になります。髪の色は黒色です。\n黒い子は目を閉じ、まつ毛が真っ白です。髪の色も真っ白です。\n\n思いっきりあうとろー様のセンスにお任せしてとびきり可愛くして頂けたらと思っております。\n何卒宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1me_h39-3TIumBd0fRnhD-AXvTaXvkm4N", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@torou_alchemist/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3885975, "client_id": 3845541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76bf0202/uploads/origins/00d15b8d-475f-43f7-a5d2-59f63ce3ece8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86256e75997a4744c872aba4a2193d93", "srcset": "https://si.imgix.net/76bf0202/uploads/origins/00d15b8d-475f-43f7-a5d2-59f63ce3ece8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86256e75997a4744c872aba4a2193d93, https://si.imgix.net/76bf0202/uploads/origins/00d15b8d-475f-43f7-a5d2-59f63ce3ece8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac54891a38f4b96708b95f4edbea136d 2x, https://si.imgix.net/76bf0202/uploads/origins/00d15b8d-475f-43f7-a5d2-59f63ce3ece8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df48989b15f6ccdb051927237486790a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76bf0202/uploads/origins/00d15b8d-475f-43f7-a5d2-59f63ce3ece8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=374177c13e6ee427a3598ec99b4b785c", "srcset": "https://si.imgix.net/76bf0202/uploads/origins/00d15b8d-475f-43f7-a5d2-59f63ce3ece8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=374177c13e6ee427a