0&h=200&s=813723710bb97e45267639a62fe14cd9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dcb15ef/uploads/origins/2c79bc64-d5e2-45a8-9287-7435f042486e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0efe75998198c4dcff0bc06429a7a053", "srcset": "https://si.imgix.net/3dcb15ef/uploads/origins/2c79bc64-d5e2-45a8-9287-7435f042486e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0efe75998198c4dcff0bc06429a7a053, https://si.imgix.net/3dcb15ef/uploads/origins/2c79bc64-d5e2-45a8-9287-7435f042486e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=316f2c3abd35312d9177d50b7234542c 2x, https://si.imgix.net/3dcb15ef/uploads/origins/2c79bc64-d5e2-45a8-9287-7435f042486e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=817e72f500efec908c547fd0abb77921 3x"}, "body": "こんにちは、ぺけちーずさん：\n先生が描かれた巨大娘のイラストがとても可愛いと思います。\nできれば、よその子で巨大娘イラストをお願いしませんか？\nキャラ：　http://www.butterfly.cat/ysnk.png\n無口な女の子です。\nキャラが100メートルぐらい巨大化して、ちょっと照れ顔で街にアヒル座り、高層ビルのガラスカーテンウォールを丁寧に掃除している。\n安全掃除のため、キャラがニーハイを履いてる。靴は既に脱がれて、周りに置かれた。それでも、とんでもない体重のせいで地面が少し割れた。\nほかの内容は先生にお任せけど、少しエッチ内容（ローアングル、パンチラとか？）を加えると最高です。\nご検討のほど、よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_peke_peke_s/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3733729, "client_id": 2495490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9c6dedac9883d6fd6b99284adb5671b", "srcset": "https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9c6dedac9883d6fd6b99284adb5671b, https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ecfecf2332e533cb6cfdd78b1a2de8f5 2x, https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd926d0b8eb66dbc73d93514b3f4de6f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72cdbdd8e782e3f1eb919763de251d1a", "srcset": "https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72cdbdd8e782e3f1eb919763de251d1a, https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f4f9b03b60bd43fcc272780921f4cea7 2x, https://si.imgix.net/1d90a214/uploads/origins/ae73d85e-0725-4037-b254-c7ba50639324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a87b077c41b2dff86db27429fa5ec6db 3x"}, "body": "こんにちは！あなたの可愛いイラストを拝見しました。もしよろしければ、私のリクエストを承っていただけませんか？ \n\n私のオリジナルキャラクター2人を、ちょっとしたシチュエーションで描いていただけませんか？姉弟のキャラクター、ニコとネオが登場するシーンです。ニコがネオを縮めて小さな都市にし、それを小さなペトリ皿に入れて飼っています。ニコはネオを見下ろしながらニヤリと笑い、スポイトを手に持っています。そのスポイトから赤い色の縮み液が都市に注がれようとしているところです。\n\nネオとニコの参考画像は以下です：ネオ：https://www.dropbox.com/scl/fi/jdupaidslqe214lhian40/Neo.jpg?rlkey=2s7vkc9u31xcq1i4ck35aebbl&dl=0\nニコ：https://www.dropbox.com/scl/fi/7drulz6b3r3w35dmg0ihf/Nico.png?rlkey=mzxh89yoqyn1tl530xbu5b8bw&dl=0\n\n私が考えていた構図の全体像に関する参考資料も用意していますが、その他の詳細はすべてお任せしたいと思います！構図としては、空にニコの顔を描きつつ、ネオと街が閉じ込められているペトリ皿の一部である「壁」も部分的に見えるようにしてほしいです。\n\n構図参考：https://www.dropbox.com/scl/fi/iwmv2z31f9ur6h01vr2hy/Nico-Comp-Reference.png?rlkey=rjc8tzr4nqplxr4aececodru8&dl=0\n\nもう一点、ニコの目が髪に隠れており、ニヤリと笑いながらネオを見下ろしている様子も表現していただけると幸いです。ご検討いただきありがとうございます！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_peke_peke_s/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3733729, "client_id": 1125178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=94f136816a6c48b6deb5d3e20ae645dc", "srcset": "https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=94f136816a6c48b6deb5d3e20ae645dc, https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=42be245f9faac207f75d7e068dea23d3 2x, https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=45993ca5778729e45d3dccb1b4563826 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=edc017a6aa2a18ff5f9b9ee78786f43c", "srcset": "https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=edc017a6aa2a18ff5f9b9ee78786f43c, https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f02859a6093a9d703f9890b27725a59d 2x, https://si.imgix.net/0acb3d7a/uploads/origins/700d9647-f9f4-49ac-b792-31f98b5e64be?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b245863186394dcabab015c57a0b61e 3x"}, "body": "またまたこんにちは！私は、あなたが私のために完了した以前の依頼が本当に好きでした！もう一人、あなたのスタイルで見てみたいキャラクターを思いつきました。\n\nそのキャラクターとシリーズは\nせんり\nてつなぎこおに。\n\n前回と同じ蒼樹うめさんのシリーズ。幼い鬼の女の子と、彼女が迷い込んだ町の住人たちとの交流を描いたキュートなシリーズだ。ちょっと好奇心旺盛で天真爛漫ですが、それがまた彼女の魅力を引き立てています。今回もポーズや構図はお任せします。\n\n今回もよろしくお願いします。\n\nhttps://imgur.com/a/QRE5oKn", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_peke_peke_s/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3733729, "client_id": 241733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f333ec9c299c63ad65a9b8836f617d", "srcset": "https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91f333ec9c299c63ad65a9b8836f617d, https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d780b717a0b04ff7d8429aaf6cb4ee8 2x, https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c480fa499be49bd560feaa28b70bfdc2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0473b001e4637d4ee9a0b5c206ebfdae", "srcset": "https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0473b001e4637d4ee9a0b5c206ebfdae, https://si.imgix.net/3986b736/uplo