b3b30dcf8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b97baf219626d009bf6d7115aeeddea1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1101457/uploads/origins/949a7cde-e2d2-487e-9d80-d1b3b30dcf8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dc7705e166b4666f0eef73927f254db", "srcset": "https://si.imgix.net/b1101457/uploads/origins/949a7cde-e2d2-487e-9d80-d1b3b30dcf8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dc7705e166b4666f0eef73927f254db, https://si.imgix.net/b1101457/uploads/origins/949a7cde-e2d2-487e-9d80-d1b3b30dcf8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb080e65f966842bd659dc172765c5e 2x, https://si.imgix.net/b1101457/uploads/origins/949a7cde-e2d2-487e-9d80-d1b3b30dcf8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=988d34acb76b89fe8a3b8d79887b67fd 3x"}, "body": "初めまして。 Vライバーのフルパワーあざ美と申します。\nこの度はTLで絵柄を拝見し、是非ご依頼したくご連絡しました。\n\n⬛︎キャラ見た目\n・キャラ見た目&衣装参考資料(新衣装ラフ等含む)\nhttps://note.com/preview/n37e13fa1cd0e?prev_access_key=b5375f6080ca58628bad432a6b6111b5\n\nクリエイター様の横長でまつ毛の長い目が好きなので、是非そのような目でお願いしたいです！\n\n⬛︎イラストについての希望\n・できれば「夏服衣装」で描いていただきたいです。\n・資料にある銃も持っていると嬉しいです。\n・どこか昔のエロゲ―や深夜アニメのようなダークでかわいい、ややヤンデレっぽい空気感があると嬉しいです。\n\n・もし可能でしたらハイライトなし目やハート目(お任せします)の差分があるとすごく嬉しいです…。！\n\n⬛︎形式についての希望\n・背景や宛名を描いていただける場合は、PSDでレイヤーを分けた状態で納品していただくか、別途PNGで「前景/宛名のみ」「背景のみ」「人物のみ透過」をそれぞれいただきたい。\n・サイズはお任せいたしますが、1280×720のサムネイルに使用しても荒くならない画質を希望します。\n・サムネに使いやすいよう、「人物のみ透過」は頭の上や髪の先が全てキャンパス内に収まっている(見切れていない)状態を希望します。\n\n⬛︎利用用途\n→ 収益化済み配信サイトでの使用、Xでの使用、SNSアイコン、収益化予定の動画への使用、グッズ化(販売用のもの含む）、サブスクコミュニティへの投稿、ネットプリント、SHOWROOMでのアバター使用……などを想定しています。\n※NGなものがあれば作品内に記載お願いします。\n\n是非お願いしたいので、もし金額など不適切な点があれば再送依頼お願いいたします。\n\nもし宜しければご承認いただけましたら幸いです。\nご検討ください。よろしくお願いいたします。\n\nhttps://note.com/preview/n37e13fa1cd0e?prev_access_key=b5375f6080ca58628bad432a6b6111b5", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 462023, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゆきじろう", "screen_name": "yukijiro02a", "avatar_url": "https://pbs.twimg.com/profile_images/1864397058498809856/O-thg7a9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1165170121993646081/1677135276/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2022779, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ᴺᵀᴿ ꪔ̤", "screen_name": "r__RIP", "avatar_url": "https://pbs.twimg.com/profile_images/2020967592522022914/qSYqXNg1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1365243675240923142/1767106109/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2320961, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぎゃん", "screen_name": "00Gvq", "avatar_url": "https://pbs.twimg.com/profile_images/1431243186417008645/BkO55V7b.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 161}, {"id": 2822934, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "すい", "screen_name": "suineco_s2", "avatar_url": "https://pbs.twimg.com/profile_images/1773704771700166656/XIIIMgeJ.jpg", 