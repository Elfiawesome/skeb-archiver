背景透過されたものを差分として1枚プラスで納品いただけると幸いです。\n\n【納品形式・サイズ】\n上記記載の差分、使用用途を納品また使用できるものでしたらどの形式、サイズでも大丈夫です。\n【使用用途】\nアイコン、ヘッダーや個人での鑑賞\n【商用利用】\nなし\n\n上記指定なしはkuga様におまかせいたします。\n資料のカラーパレットはあくまで参考です。\n過度な変更が無ければkuga様が決めたカラーや髪型でも大丈夫です。\n\n内容が合わなければキャンセルしていただいて大丈夫です。\nお忙しいなか恐れ入りますがご検討よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@xx_kgaO_o/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3754802, "client_id": 2203238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f3a910d/uploads/origins/405cdb15-2c41-444c-b03f-d0c0fcf1fb9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b4cf04beaa902aebea4219e55bb2a9", "srcset": "https://si.imgix.net/0f3a910d/uploads/origins/405cdb15-2c41-444c-b03f-d0c0fcf1fb9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b4cf04beaa902aebea4219e55bb2a9, https://si.imgix.net/0f3a910d/uploads/origins/405cdb15-2c41-444c-b03f-d0c0fcf1fb9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cd711269a2f1edec5d63a1a99f99b75 2x, https://si.imgix.net/0f3a910d/uploads/origins/405cdb15-2c41-444c-b03f-d0c0fcf1fb9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58d2a2a6c686200c4b7fe8c5eaf7bd4f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f3a910d/uploads/origins/405cdb15-2c41-444c-b03f-d0c0fcf1fb9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a4567d3a482f4e213c9d7afca0e750", "srcset": "https://si.imgix.net/0f3a910d/uploads/origins/405cdb15-2c41-444c-b03f-d0c0fcf1fb9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3a4567d3a482f4e213c9d7afca0e750, https://si.imgix.net/0f3a910d/uploads/origins/405cdb15-2c41-444c-b03f-d0c0fcf1fb9d?bg=%23fff&auto=format%2Ccompress&f