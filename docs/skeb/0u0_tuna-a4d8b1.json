どは特にありませんので好きに描いていただければと思います。この子にかわいさを感じていただけたら幸いです。\nイラストのイメージ補助になるかと思いますので設定などを以下に書かせていただきます、参考までにどうぞです。\nこの子はゲームが好きなAIです。人間のサポートをするために作られました。\nサポートと言っても物理的ではなくメンタル的に、人と話し触れ合うことが自分の使命だと思っています。\nそんな子なのですが表情はあまりうごかなくて不器用な感じです、ただ心がないわけではなくちゃんと感情があります。\n表情には出ませんがしっぽやしぐさに感情が現れます。\nゲームが好きなのは人間と触れ合うことをこれしか知らないから、遊ぶことによって人間を知ろうとしてます。\n好きなものは人と話すこと、かわいいもの\n嫌いなものは独りぼっち、忘れられること\n意外とさみしがり屋でかまってもらえないとすぐ暗くなる不安定な一面もあります。\n\n以上になります、よろしくおねがいします！\n\nhttps://drive.google.com/file/d/13J2smx6y_ICJWcU2QbVVQ6FIAtc8lBZr/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0u0_tuna/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2137928, "client_id": 1071611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bb5157b/uploads/origins/0d81eaa7-a9de-4626-ae6f-78612237d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df9a9162a00efe8dcaddb799149a6069", "srcset": "https://si.imgix.net/3bb5157b/uploads/origins/0d81eaa7-a9de-4626-ae6f-78612237d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df9a9162a00efe8dcaddb799149a6069, https://si.imgix.net/3bb5157b/uploads/origins/0d81eaa7-a9de-4626-ae6f-78612237d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1a259c92deaf21a255d0f2ebc44013a 2x, https://si.imgix.net/3bb5157b/uploads/origins/0d81eaa7-a9de-4626-ae6f-78612237d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=436350b91cb677fc9d7bff1ff615eb67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bb5157b/uploads/origins/0d81eaa7-a9de-4626-ae6f-78612237d8a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a1a3ecaab45f8bfacd2cc6c8f208669", "srcset": "https://si.imgix.net/3bb5157b/uploads/origins/0d81eaa7-a9de-4626-ae6f-78612