好き。\nスナイパーでもある。\n普段の表情はいたずらっぽい笑み。\n体型は長身痩躯。\nどんな服を着せてもいいし、新しい服をデザインしてもいい。\n\nポーズのアイデアとしては\n- クッキーを焼く\n- エイリアンのモンスターと戦う\n- エレキギターを弾くふりをする\n- クールでエッジの効いたアクションポーズ\n- 面白いポーズ\n- その他お好きなポーズ\n\n可能であれば、ケモノミミになっているバージョンとケモノミミになっていないバージョンもお願いします。ディンゴ(https://drive.google.com/file/d/1QB6axJLg56OYqahIvrXZK7NoBMpVrbG8/view?usp=drive_link)の耳と尻尾がついていることが望ましい。\n\nポーズと構図はお任せします！\n\nいずれにせよ、私のリクエストを読んでくださって本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1YQ4Iw4idpFiQBivhMkWU8m5lAriDDkQD?usp=share_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hoshiimo_sukiii/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3220469, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ef86b96/uploads/origins/47d76562-1d35-4aab-ae61-8f532843edc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f056f54e8e51d68c9da50ef35f91f5ce", "srcset": "https://si.imgix.net/6ef86b96/uploads/origins/47d76562-1d35-4aab-ae61-8f532843edc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f056f54e8e51d68c9da50ef35f91f5ce, https://si.imgix.net/6ef86b96/uploads/origins/47d76562-1d35-4aab-ae61-8f532843edc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d65d8d3f071106ad4ad7dafc3abb316d 2x, https://si.imgix.net/6ef86b96/uploads/origins/47d76562-1d35-4aab-ae61-8f532843edc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5c7e15e5d6db9fa22d7c62d545f7292 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ef86b96/uploads/origins/47d76562-1d35-4aab-ae61-8f532843edc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b04e7f107257acea0a213eccfb9d097", "srcset": "https://si.imgix.net/6ef86b96/uploads/origins/47d76562-1d35-4aab-ae61-8f532843edc6?bg=%23ff