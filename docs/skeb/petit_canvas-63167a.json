83271?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=87749e4be803eb662605ed0e6e7abef5 3x"}, "body": "プティ先生、こんにちは！あけましておめでとうございます！先生の絵はとても美しいです！私のキャラクターを描いていただけたら光栄です！\n\n最初にリクエストしたいキャラクターはヘウォンという名前です！彼女は牛である少女だ。とても温かく、思いやりがあり、寛大な女の子です。気遣いはするけれど、必ずしも母性的な感じではありません。本当に焼き菓子作りが大好きで、すぐに夢中になります。\n\n二つ目のキャラクターはカン・テジュンです！彼は牛の少年です。テジュンは明るく友好的で親切な性格で、スポーツへの情熱を持ち、意欲的で自信に満ちています。頭はそれほど良くないかもしれませんが、間違いなく気立てが良く、友達のためにできることは何でもします。彼はヘウォンより約30cm背が高いです。二人の関係では、彼の方が従順な立場に見えます。ヘウォンに愛情を示されると、すぐに慌てふためいてしまいます。\n\n構図についてですが、漫画の表紙のように二人を一緒に描いていただけないでしょうか。それ以外は、お任せしたいのですがよろしいでしょうか！可愛く思えることは何でもお任せします！\n\n\nお値段はご都合に合わせて調整してください！ご検討よろしくお願いします〜！\n\nhttps://drive.google.com/drive/folders/15mOuYgzISj9VgeRSwg1zrvmSP8HQYmZj?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1819245, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かいじゅうくん️🩵🦕", "screen_name": "s2_2_2_2_2_", "avatar_url": "https://pbs.twimg.com/profile_images/2011778429847552004/ZJscNXRS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1333630668396322817/1742560995/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 152}, {"id": 1848932, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴゃんすけさん", "screen_name": "FormulaBrain9", "avatar_url": "https://pbs.twimg.com/profile_images/1324630221270605824/FmDQLlVK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1294983672097984518/1649404469/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_day