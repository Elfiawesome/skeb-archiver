にきた人間とのコミュニケーションを楽しんでるようだ。\n夜は、神様への献上品の酒を飲んでよく酔っ払ってるという噂…\n（子供が酒を飲むなと人間から突っ込まれるが、「巫女はいいんじゃ」と言ってるらしい）\n\nこんな感じであとはゆうねさんのセンスに任せるぜ！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@f10xi_41y/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 505951, "client_id": 1284025, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-472a-bb87-145280f082dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d8c56a67022f8ab660cc2a79c8d2a88", "srcset": "https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-472a-bb87-145280f082dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d8c56a67022f8ab660cc2a79c8d2a88, https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-472a-bb87-145280f082dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ab2b7e6adfbd46365d89f5e90b66249 2x, https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-472a-bb87-145280f082dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52f7be22c876260e1b3857b7c2c27e58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-472a-bb87-145280f082dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6d165ea7634fe2ae1068f43c91894dc", "srcset": "https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-472a-bb87-145280f082dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6d165ea7634fe2ae1068f43c91894dc, https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-472a-bb87-145280f082dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc7beee50cd8eeb1114ebeaf473ff84 2x, https://si.imgix.net/496e885e/uploads/origins/292ebabe-5eeb-