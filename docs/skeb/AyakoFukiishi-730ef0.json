・ネイルの色はボルドーレッドで、リップの色も浮き過ぎなければネイルの色に近い方が嬉しいです。\n・女性の身長とスリーサイズは,183㎝ B:127W:80H:125 です。(可能であれば、ちょっとオーバーな描き方が嬉しいです)\n\nおじさん\n・身長は平均値、体格は筋肉の上に脂肪が乗ってる感じのちょっとがっちりしてるくらい\n・全頭マスク(難しい場合はちょっと嬉しそうにニヤつかせていただけると嬉しいです)\n・赤色でサイドに白いラインが入ったブルマを着用(難しければ全部真っ赤で大丈夫です！)\n・黒い首輪がついている\n\n以上が希望です。\n予算上難しい場合はあやさんにお任せします。\n\nhttps://photos.app.goo.gl/F3HWrvyk2g5UwJ6L9", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AyakoFukiishi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3330506, "client_id": 666352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd5312d5/uploads/origins/b298e0a0-3fea-4573-902e-2541225f338c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb2a20e95276bde5f6a9d3b60aa532e7", "srcset": "https://si.imgix.net/cd5312d5/uploads/origins/b298e0a0-3fea-4573-902e-2541225f338c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb2a20e95276bde5f6a9d3b60aa532e7, https://si.imgix.net/cd5312d5/uploads/origins/b298e0a0-3fea-4573-902e-2541225f338c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3640831266007d7687bc028f3b8f3183 2x, https://si.imgix.net/cd5312d5/uploads/origins/b298e0a0-3fea-4573-902e-2541225f338c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=874e4dd913041d84c6dac52d5f5cea22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd5312d5/uploads/origins/b298e0a0-3fea-4573-902e-2541225f338c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f5607c3cca8d8a76332232225b84fc4", "srcset": "https://si.imgix.net/cd5312d5/uploads/origins/b298e0a0-3fea-4573-902e-2541225f338c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f5607c3cca8d8a76332232225b84fc4, https://si.imgix.net/cd5312d5/uploads/origins/b2