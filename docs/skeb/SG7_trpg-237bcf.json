: false}, {"path": "/@amuneill/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3630808, "client_id": 3536286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812f585f2667c824802cec995cf46186", "srcset": "https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812f585f2667c824802cec995cf46186, https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b06ad2d3e9f7b325586fe257b5b8814 2x, https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f81e6301e80a4f169d7aced896a724c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be9a498a99f61be03439d7bf39c9ecf4", "srcset": "https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be9a498a99f61be03439d7bf39c9ecf4, https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ddd603e26c8e160e7308e0f1b5234bb 2x, https://si.imgix.net/6c114957/uploads/origins/6fd704cf-f4a8-4d4d-9838-ef3c00e11a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86d7e8c6ba6bbe76110dbb74d3a4697a 3x"}, "body": "のあ様\n\n\nリクエスト失礼いたします。\n日頃よりのあ様の表現される世界観や色使い、空間描写に魅了されております。頽廃的なものからずっと目に入れていたい眩しさを感じるような暖かく涼しい空気を感じる夏のイラストなど、とても大好きです。\nこの度は是非のあ様のイラストで描いて頂きたいキャラクターが居り、リクエストを送らせて頂きました。\n\n\n❚ リクエスト内容\n名前：明日海 凪 - あすみ なぎさ\n容姿：白い長髪で毛先は鶴の羽のようなイメージ、雪の結晶の簪で髪を結っている、柔らかく桃色～赤色の瞳、ムーンストーンのブローチ\nその他：冬/27歳/中性的な男性/170cm/甘味と抹茶が好き/暑さが少し苦手/一人称は私\n資料：https://drive.google.com/drive/folders/1it_L3Xib4GziKdLseDkDer3DGuQfnVF8?usp=drive_link\n\n「四季送り」というCoCのシナリオに参加したオリジナルの探索者になります。\nHO肆、冬を題材としており、穏やかでふんわりとした印象を持つ男性です。\n何にも寛容であり自分のミスも他人のミスも許してしまう性格。ベテランの余裕、安定感がありながらどこか天然さを感じる雰囲気を纏っておりゆったりとしています。\n口癖のように毎日\"みんなが大好き\"と言う、皆を可愛がるお兄さんのような存在。\n\n\n上記キャラクターの一枚絵をお願いいたします。\n春夏秋冬いつでも構わないのですが\"その季節\"を感じられるようなものですと凄く嬉しいです。ですがのあ様の表現する世界が好きですので、構図や情景など描きやすいようお好きに解釈し、お考えいただけますと幸いです。\n\n\n❚ 使用用途\n個人観賞、使用の範囲に留まります\n非商用利用です\n・SNSアイコン、ヘッダー\n・PCのデスクトップ使用\n・個人でのグッズ製作\n\n\nリクエスト内容は以上となります。\n金額が足りなければ再送信、キャンセルなどご無理のないよう気兼ねなくお願いいたします。\nご検討いただけますと幸いです。何卒よろしくお願いいたします！\n\n\n\n写玥\n\nhttps://drive.google.com/drive/folders/1it_L3Xib4GziKdLseDkDer3DGuQfnVF8?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kunl__/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3153656, "client_id": 3536286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f62c62e9f6148d7b485a74696d65d11", "srcset": "https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f62c62e9f6148d7b485a74696d65d11, https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c96b0ecf2daa678f7e968f6e9607d52 2x, https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b14b1e1b8841c34776a08f6981589fac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ed8cc33f55d7b2c5fbe75fb58f20a3", "srcset": "https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9ed8cc33f55d7b2c5fbe75fb58f20a3, https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ee18af67dfbefb34e7bcf5c1e760027 2x, https://si.imgix.net/2bb0ecf2/uploads/origins/f5fd7c83-fc32-485c-9493-454796186ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=255ea3f3b6d68809946769dcef5d09b0 3x"}, "body": "くに様\n\n\nリクエスト失礼いたします。\n\n日頃より可愛くキャラクター個性の引き立つ素敵なイラストの数々を拝見しております。\nこの度は是非くに様のイラストで描いて頂きたい2人が居り、リクエストを送らせて頂きました。\nskeb利用が初めてのため、不備などありましたら申し訳ありません。\nまた、金額が足りない場合も再送リクエストなどお願いいたします。\n\n\n\n❚ ご依頼内容\n宇都宮空（水、灰色の髪の女性、20歳）\n月出宿（黒髪に黄色い目の男性、22歳）\n上記2名、キャラクターのデフォルメイラストをお願いいたします。\n\nくに様の過去のイラストを拝見しました。\nどれも素敵な中、特に鉛筆風のペンを使ったイラストがとても可愛らしく大好きです。\nふんわりとした優しく穏やかな雰囲気をお願いしたく思います。\nまた、獣化がとても好きなので獣化した2人を見れると、とても嬉しいです。\n詳細についてはくに様の描きやすいようにお任せしたいです。\n\nキャラクター資料\nhttps://drive.google.com/drive/folders/18LpGdFv8oj8_i37lNMJSQ8e0WIH5K7bp?usp=sharing\n\n\n❚ 使用用途\n個人観賞、使用の範囲に留まります。\n非商用利用。\n・SNSのアイコン、ヘッダー\n・個人でのグッズ製作\n\n\n\n以上になります。\nご検討いただけますと幸いです。何卒よろしくお願いいたします。\n\n\n写玥\n\nhttps://drive.google.com/drive/folders/18LpGdFv8oj8_i37lNMJSQ8e0WIH5K7bp?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://