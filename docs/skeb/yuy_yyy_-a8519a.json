と柔らかい宵というのがわかるシチュ\n\nもしくは③夏、放課後の帰り道、2人で駄菓子屋？コンビニ、自動販売機に寄るシチュエーション(徒歩でも片方自転車でも、暗めの夕方でも夏休みの補習後などの明るい時間でも)\n\nのどれかだと嬉しいです！\n\nhttps://skeb.jp/@yuy_yyy_/works/14\nのような横向き簡易背景付き、表情差分やミニキャラなど同梱してもらえるとめちゃくちゃ嬉しいです……！\n\nご検討どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1nJw3WaTHzJEFqimtaWQww8-sbum0no51?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuy_yyy_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3435657, "client_id": 2651609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2cfdb3d/uploads/origins/8640d855-3768-49ae-9ebb-f98ce6ca5de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=499b54577b8c8e6dc3f6550576827562", "srcset": "https://si.imgix.net/c2cfdb3d/uploads/origins/8640d855-3768-49ae-9ebb-f98ce6ca5de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=499b54577b8c8e6dc3f6550576827562, https://si.imgix.net/c2cfdb3d/uploads/origins/8640d855-3768-49ae-9ebb-f98ce6ca5de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea2bc624d3f2729099bfa48431b138ba 2x, https://si.imgix.net/c2cfdb3d/uploads/origins/8640d855-3768-49ae-9ebb-f98ce6ca5de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0e11eaffeb8c569b89441396cd3a659 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2cfdb3d/uploads/origins/8640d855-3768-49ae-9ebb-f98ce6ca5de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79b91db0766e9faa3e6e502ed5978398", "srcset": "https://si.imgix.net/c2cfdb3d/uploads/origins/8640d855-3768-49ae-9ebb-f98ce6ca5de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79b91db0766e9faa3e6e502ed5978398, https://si.imgix.net/c2cfdb3d/uploads/origins/8640d855-3768-49ae-9ebb-f98ce6