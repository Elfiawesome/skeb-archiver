「sanrio（1）」「sanrio（2）」の服装を描いてください！\n\npsdを渡してくれるなら！ 嬉しいです！描画中に残した下書き図があれば、残してください。\n\nこの納品を快く引き受けてくださるなら、とてもありがたく、嬉しいです。字が多くてごめんなさい！読んでいただきありがとうございました！\n\n金額が足りない場合は、安心してキャンセルするか、再送を提出することができます ！私はできる限りのことをします！ ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1wFIujt3AV2DMJmFjK3G5vQEkrCmOnK3Z", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuy_yyy_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3435657, "client_id": 1407171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec8c082f/uploads/origins/af9a66d6-f42a-4393-996a-f7d400abdd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fbfc6d93b71472d9c5c263d656d2c5c", "srcset": "https://si.imgix.net/ec8c082f/uploads/origins/af9a66d6-f42a-4393-996a-f7d400abdd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fbfc6d93b71472d9c5c263d656d2c5c, https://si.imgix.net/ec8c082f/uploads/origins/af9a66d6-f42a-4393-996a-f7d400abdd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b4724bdb75c42bc81c470a9133d26a7 2x, https://si.imgix.net/ec8c082f/uploads/origins/af9a66d6-f42a-4393-996a-f7d400abdd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c5def9c1da25a21280bc2b16ca9744f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec8c082f/uploads/origins/af9a66d6-f42a-4393-996a-f7d400abdd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60ecf117fa1cf3ec4186582e4a247b1a", "srcset": "https://si.imgix.net/ec8c082f/uploads/origins/af9a66d6-f42a-4393-996a-f7d400abdd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60ecf117fa1cf3ec4186582e4a247b1a, https://si.imgix.net/ec8c082f/uploads/origins/af9a66d6-f42a-4393-996a-f7d400abdd3c?bg=%23fff&auto=