きできないパントの目の前で子作り\nルイーズはエルクの赤ちゃんが欲しいと懇願\nエルクは身体が勝手に動きパントとルイーズに謝りながらも腰を動かし中に出す\nパントは混乱し絶句\n夢オチでパントが目を覚ますとルイーズと一緒にベッドに居て「昨晩は激しかったですね」「悪夢を見ていた」などのやりとり\nこの目覚めたパントと一緒にいるルイーズの正体は兎ロキで本物のルイーズは別の場所でエルクと子作り続行中の夢オチではなかったend", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuchibuenoyoru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 850205, "client_id": 334134, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb86d397/uploads/origins/da91ab50-c191-40f8-832a-55fba439c058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592af0f81100f5fe54735eed2ea1b5af", "srcset": "https://si.imgix.net/cb86d397/uploads/origins/da91ab50-c191-40f8-832a-55fba439c058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=592af0f81100f5fe54735eed2ea1b5af, https://si.imgix.net/cb86d397/uploads/origins/da91ab50-c191-40f8-832a-55fba439c058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=289e3bd391cbc6cc94fcde5496d82de8 2x, https://si.imgix.net/cb86d397/uploads/origins/da91ab50-c191-40f8-832a-55fba439c058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d73a9605371fb540990f7899336d9914 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb86d397/uploads/origins/da91ab50-c191-40f8-832a-55fba439c058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77dec31c1b01fb507047f73ce6db50ce", "srcset": "https://si.imgix.net/cb86d397/uploads/origins/da91ab50-c191-40f8-832a-55fba439c058?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77dec31c1b01fb507047f73ce6db50ce, https://si.imgix.net/cb86d397/uploads/origins/da91ab50-c191-40f8-832a-55fba439c058?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=743ce4a086e7