0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7451d451aa6642ad6bcc0f82fd3f3422 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fa08b73/uploads/origins/2375d768-71b9-418a-8dfd-b4b06113a370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06b3a364b1145d550bf8462f2a3b3f57", "srcset": "https://si.imgix.net/6fa08b73/uploads/origins/2375d768-71b9-418a-8dfd-b4b06113a370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06b3a364b1145d550bf8462f2a3b3f57, https://si.imgix.net/6fa08b73/uploads/origins/2375d768-71b9-418a-8dfd-b4b06113a370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=753bb4c5457767ffc5458c0787784226 2x, https://si.imgix.net/6fa08b73/uploads/origins/2375d768-71b9-418a-8dfd-b4b06113a370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d921935ba584631b915ebee5066e8e67 3x"}, "body": "こんにちは！\n\n私はあなたのキャラクターデザインが好きです。オリジナルキャラクターは作れますか？\n\n彼女は冒険のために家を出たばかりのポケモントレーナーです。他のポケモントレーナーと同じようにとても若いので、おそらく10歳くらいだと思います。しかし、若くて小さいにもかかわらず、とても発達した体をしています。胸も大きく、太ももも太い。\n\nポケモントレーナーのような服装（スカート、ベスト、帽子）を着ているが、ギャル風。ややスケスケでだらしなく見える。彼女の全体的な外見はあなた次第ですが、私は黒い肌にピンクやブロンドなどの明るい髪が好きです。そばかすやペイントした爪などのディテールを追加することもできます。\n\n彼女はこの女の子のように生意気な性格をしている。\nhttps://www.dropbox.com/s/t0079dq1mqfvub0/96808869_p4.jpg?dl=0\n\n彼女はまだセックスをしたことがないが、冒険でセックスするトレーナーやポケモンを楽しみにしている！\n\nできれば、服を着たバージョンと裸のバージョンを入れてください。彼女の名前をつけてもいいです。\n\nありがとう！", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ver61856626/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2287313, "client_id": 64768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c14ee70a/uploads/origins/e151d560-084f-4b93-a0da-fdc16c2ec850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=