igins/9a875df9-0df4-414e-8410-a062206bed95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7f4c5f258a836de52cf7c86e6e5e78a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c228a7e1/uploads/origins/9a875df9-0df4-414e-8410-a062206bed95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd5b29914dc1ef3b8fa5259edef00418", "srcset": "https://si.imgix.net/c228a7e1/uploads/origins/9a875df9-0df4-414e-8410-a062206bed95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd5b29914dc1ef3b8fa5259edef00418, https://si.imgix.net/c228a7e1/uploads/origins/9a875df9-0df4-414e-8410-a062206bed95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c7dba060ab633c74e43d3142458f462 2x, https://si.imgix.net/c228a7e1/uploads/origins/9a875df9-0df4-414e-8410-a062206bed95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b30caeed3bf9afe4f2ab58daad05e78b 3x"}, "body": "こんにちは！\n\n私はあなたが過去に創作した多くのキャラクターが好きで、もっと見たいと思っています。その中から1人または複数を選び、濃厚で蕩けるようなセックスをモノクロで短くシークエンスしてください。そのシーンがキャラクターに合うようにしてください。\n\n興味のあるシーンのアイデアは以下の通り：\n-ふたなり／百合\n-お腹の膨らみ\n-体格差\n-グループセックス\n-獣姦／モンスター・セックス\n-極端な挿入\n\n最も重要なのは、セックスが過激であることだ。スキャットや過激な暴力が含まれない限り、好きなだけクレイジーでバカバカしくてもいい。女の子が楽しんでくれればいいが、キャラクターによっては楽しむ必要はない。\n\nリンク先に私の好きなキャラクターを添付しました。好きなキャラクターはたくさんいるので、とりあえず描きたい人を選んでください。今後もリクエストするかもしれません。\n\nご検討よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/b90p2mjp58wsm5jahc2xd/AIIfvY7C_tv9QAD-46NDGqE?rlkey=0b7txorjjzdmo3qxli1pd0klh&st=hiameqj1&dl=0", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ver61856626/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2287313, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb272ee0c25dd306c1ce89e50c59b3f", "srcset": "https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb272ee0c25dd306c1ce89e50c59b3f, https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b6041d4aca878f59bda2ade1411ea7e 2x, https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79f6a214c358842ed0a8651a6534e0e5 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15fa54b6eb47f8f3d0a6da94112149e7", "srcset": "https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15fa54b6eb47f8f3d0a6da94112149e7, https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c7a860757ff2c1fcb324adb3997c29f 2x, https://si.imgix.net/0f98fa78/uploads/origins/f8d7e53a-6ec7-431b-b467-82ab98353af6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc6b59a53290b61471bd61dfc6d33e6 3x"}, "body": "自分の持ち主であるマスターの見抜き用オナペットになっていたら魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で爆乳化アへ顔アクメをキメる遊戯王OCGのRAI-MEIとトリックスター・ホーリーエンジェルのコンビのカラーイラストをリクエストします。\n\nキャラの造形は\n・二人とも頭身高めのむちむち、もともと巨乳位のサイズはあるが膨乳で更に大きくなる。\n・膨乳後はへそを超え下腹部がギリギリ隠れない程度の超乳寄りまでサイズアップする(大きい分には好きなだけ盛って下さい)\n・服装は原作と同じ物で、乳首と乳輪は共に大きめかつ勃起状態&パフィーニップルが衣装越しにくっきり浮き出ている。\n・性格のイメージは二人とも少しSっ気を持たせつつ、RAI-MEIは凛としたクールビューティ、ホーリーエンジェルは母性を感じさせる甘々なお姉さん\nといった感じでお願いします。\n\n二人の横並びで股間までを写したバストアップを、以下のようなセリフを用意して欲しいです。\n\n1枚目：ニヤけた表情でこちらを煽り、今からオナペットになることを宣言してオナニーを催促してくる。\n\n2枚目：目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され訳も分からぬまま間抜けな叫び声を上げて絶頂する。微かに残った意識で止めさせようとするも快楽に負け更に汚い淫語を満載したアへオホ声で絶叫し、思い切り白目を剥いたアへ顔を晒しながらイキっぱなしになる。淫語をこれでもかと織り込んだ媚びるような喘ぎ声で射精を催促してくる。\n\n3枚目：射精後。勝手にカードを使った事に怒りながらも優しい態度で褒めてくれる。\n\nとにかく下品で無様なワードで画面を埋め尽くして欲しいです。よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 178, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ver61856626/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2287313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97747873/uploads/origins/6549be30-c4cb-4a37-935f-5557b0b202d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59f46dd12eaa402bdbf53b9f8f056565", "srcset": "https://si.imgix.net/97747873/uploads/origins/6549be30-c4cb-4a37-935f-5557b0b202d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59f46dd12eaa402bdbf53b9f8f056565, https://si.imgix.net/97747873/uploads/origins/6549be30-c4cb-4a37-935f-5557b0b202d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f87fd810520116f76adc5303a7e09cd8 2x, https://si.imgix.net/97747873/uploads/origins/6549be30-c4cb-4a37-935f-5557b0b202d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f35911cc1243b7bd8137da36319aa6a3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97747873/uploads/origins/6549be30-c4cb-4a37-935f-5557b0b202d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77c03612ca55ed95196d6726f8f5f326", "srcset": "https://si.imgix.net/97747873/uploads/origins/6549be30-c4cb-4a37-935f-5557b0b202d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cro