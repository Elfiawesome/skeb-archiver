のお好みにお任せします。\nNG、興味が惹かれない等あれば再送や拒否していただいても構いません。\n何卒よろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 687, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "DHA", "screen_name": "dha_l", "avatar_url": "https://pbs.twimg.com/profile_images/925662818598133760/83cWrfaV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/83339216/1758327660/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 345128, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おちゃこ@AiS『C-31』", "screen_name": "KemomimiOchanu", "avatar_url": "https://pbs.twimg.com/profile_images/1591219205567057921/bUtS_mQv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1091925943516520448/1726328462/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 75, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 696930, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "陸りん🍣お絵描き", "screen_name": "okarin0083", "avatar_url": "https://pbs.twimg.com/profile_images/2017331908682870784/7N2WqkUm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/774627123617079297/1608879146/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "voice"}, {"genre": "novel