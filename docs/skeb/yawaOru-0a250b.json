ご検討お願いします。\n\n\n◆全体イメージ\nデザインしていただいたウサギ君の１枚イラストをお願いします。\nテーマは\"メインビジュアル\"で、前回いただいたイラストより動きのあるポーズでお願いします。\n\n今回は小物（肩掛けバッグ）を一緒に描いて欲しいです。\n次の要素を含むものをデザインをお願いします。\n\n・革製の肩掛けバッグで、色は茶～黒あたり。\n・肩紐が長めorバッグが大きいせいでいつも引きずっており、底面には大きな補修の跡がある。\n・物を入れすぎで開け口から中身がはみ出てる。（果物、ファンタジー系のアイテム、アンティーク感のあるものあたりだと嬉しいです）\n\n詳しい内容は全ておまかせしますので、自由に描いて欲しいです。\n背景の有無も問いません。（なくても大丈夫です）\n\n\n◆作品について\n・観賞用の他、SNSやYoutubeの限定配信などで使用する可能性があります。\n　また、今後別のリクエストの際の参考資料としても使用します。\n・商用利用はしません。\n・ご納品は背景透過済みのPNGを別途添付するか、キャラと背景がレイヤー分けされたPSDでお願いします。\n\n\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1cFTRhYdgMvERUZGwKX5ts4Co0ZEY869G?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 362185, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "まみれ", "screen_name": "ekcdayo", "avatar_url": "https://pbs.twimg.com/profile_images/1509685881795350543/lq7fNEq0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/977850878404182017/1689563982/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id": 786180, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "wawa", "screen_name": "wawatiku", "avatar_url": "https://pbs.twimg.com/profile_images/1930047406810509316/scWjWE-1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1316976623724318720/1729758706/1500x500", "appeal_receivable": false, "popular_creator_rank": 19, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1506724, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "うぇ", "screen_name": 