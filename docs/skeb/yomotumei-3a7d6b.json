9\n\u300c\u3048\u3078\u3078\u3078\u3001\u304a\u5144\u3061\u3083\u3093\u2026\u2026\u3060\u301c\u3044\u597d\u304d\u266a\u300d\n\n\u2e3b\n\n\u2463 \u5c11\u5e74\u30dc\u30a4\u30b9\n\u3010\u4f4d\u7f6e:\u4e2d\u592eC\u3011\u3010\u8ddd\u96e2:\u666e\u901a\u3011\uff08\u5143\u6c17\u306b\uff09\n\u300c\u304a\u3044\u3001\u59c9\u3061\u3083\u3093\uff01\u300d\n\u300c\u30aa\u30ec\u306e\u30d7\u30ea\u30f3\u3001\u52dd\u624b\u306b\u98df\u3079\u305f\u3060\u308d\u3049\u301c\uff01\uff1f\u300d\n\u300c\u540d\u524d\u66f8\u3044\u3066\u305f\u306e\u306b\u2026\u2026\u59c9\u3061\u3083\u3093\u306e\u30d0\u30ab\u2026\u2026\u300d\n\n\u3010\u4f4d\u7f6e:\u4e2d\u592eC\u3011\u3010\u8ddd\u96e2:\u5c11\u3057\u96e2\u308c\u3011\uff08\u5c0f\u58f0\u3067\u62d7\u306d\u3066\uff09\n\u300c\u2026\u2026\u4eca\u5ea6\u3002\u4ed5\u8fd4\u3057\u306b\u59c9\u3061\u3083\u3093\u306e\u30a2\u30a4\u30b9\u98df\u3079\u3066\u3084\u308b\u2026\u2026\u300d\n\n\u2e3b\n\n\u2464 \u751f\u610f\u6c17\u59b9\u30dc\u30a4\u30b9\n\u3010\u4f4d\u7f6e:\u4e2d\u592eC\u3011\u3010\u8ddd\u96e2:\u666e\u901a\u3011\uff08\u6311\u767a\u7684\u306b\uff09\n\u300c\u306d\u3047\u306d\u3047\u304a\u5144\u3061\u3083\u301c\u3093\u266a\u300d\n\u300c\u76ee\u3047\u3064\u3080\u3063\u3066\u304f\u308c\u305f\u3089\u3041\u2026\u2026\u3042\u305f\u3057\u304c\u3001\u30a4\u30a4\u3082\u306e\u3042\u3052\u3061\u3083\u304a\u3063\u304b\u306a\u301c\uff1f\u300d\n\n\u3010\u4f4d\u7f6e:\u4e2d\u592eC\u2192\u53f3R\u3011\u3010\u8ddd\u96e2:\u3084\u3084\u8fd1\u3044\u301c\u8fd1\u3044\u3011\uff08\u3044\u305f\u305a\u3089\u3063\u307d\u304f\u9593\u3092\u7f6e\u3044\u3066\u8fd1\u3065\u304d\u3001\u53f3\u8033\u3078\uff09\n\u300c\u3093\u30fc\u2026\u2026\u300d\n\n\u3010\u4f4d\u7f6e:\u53f3R\u3011\u3010\u8ddd\u96e2:\u8fd1\u3044\u3011\uff08\u53f3\u8033\u306b\u56c1\u304d\uff09\n\u300c\u3053\u3057\u3087\u3053\u3057\u3087\u3053\u3057\u3087\u3053\u3057\u3087\u2026\u2026\u300d\n\n\u3010\u4f4d\u7f6e:\u5de6L\u3011\u3010\u8ddd\u96e2:\u8fd1\u3044\u3011\uff08\u5de6\u5074\u306e\u8033\u306b\u3082\u697d\u3057\u3052\u306b\u56