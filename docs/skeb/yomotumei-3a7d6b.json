{"screen_name": "yomotumei", "first_seen": 1771414348.257618, "last_updated": 1771414348.257618, "profile": {"id": 3695585, "acceptable": true, "creator": true, "avatar_url": "https://pbs.twimg.com/profile_images/1967457244754124800/czjMTqkM.jpg", "name": "よもつ冥🔞", "nsfw_acceptable": true, "screen_name": "yomotumei", "language": "ja", "header_url": "https://pbs.twimg.com/profile_banners/1945356559569313793/1757913348/1500x500", "body_size": 10000, "received_works_count": 5, "received_nsfw_works_count": 5, "sent_requests_average_cancel_time": null, "appeal_receivable": false, "request_master_rank": null, "first_requester_rank": null, "sent_first_works_count": 0, "sent_public_works_count": 0, "popular_creator_rank": null, "instruction": "detail", "asct": null, "description": "💜欲望を形に、マルチクリエイターお姉さん。💜\nFANBOX▷https://yomotumei.fanbox.cc/\nFantia▷https://fantia.jp/fanclubs/547653\nskeb▷https://skeb.jp/@yomotumei\n趣味垢▷@yomotumei_VRC", "nijie_id": null, "dlsite_id": null, "fanza_id": null, "pixiv_id": null, "booth_id": null, "fantia_id": 547653, "fanbox_id": "yomotumei", "skima_id": null, "coconala_id": null, "patreon_id": null, "busy": false, "url": "https://yomotumei.fanbox.cc", "wishlist_id": null, "youtube_id": null, "show_social_profile": true, "accept_expiration_days": 30, "complete_expiration_days": 90, "nc": 161, "twitter_uid": "1945356559569313793", "user_service_links": [{"provider": "twitter", "screen_name": "yomotumei", "url": "https://x.com/yomotumei"}], "banned": false, "banned_by": "", "complete_rate": 0.84, "og_image_url": "https://skeb-avatar.imgix.net/https%3A%2F%2Fskeb.jp%2Fapi%2Fusers%2Fyomotumei%2Fbackground%3Fd%3D43ce95?blend64=aHR0cHM6Ly9hc3NldHMuaW1naXgubmV0L350ZXh0P3R4dDY0PVVrVkRUMDFOUlU1RVJVUWdVRkpKUTBVJnR4dGNscj1mZmYmdHh0Zm9udDY0PVFYWmxibWx5TFUxbFpHbDFiUSZ0eHRhbGlnbj1jZW50ZXImdHh0c2l6ZT00MCZ0eHRzaGFkPTEwJmZtPXBuZyZ3PTEyMDA&bm=normal&by=360&mark64=aHR0cHM6Ly9hc3NldHMuaW1naXgubmV0L350ZXh0P3R4dDY0PU1UVXNNREF3SUVwUVdRJnR4dGNscj1mZmYmdHh0Zm9udDY0PVFYWmx