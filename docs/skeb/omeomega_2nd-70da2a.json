o、イケメンアイドルです。現在、ouroborosは中国・上海を拠点に活動中。\nかわいい漫画のイメージで彼女を表現できればと思っており、衣装は黒を選択できます。表情や動きは自由に使ってください。ただし、緑色のハイライトは必ず維持してください。背景は複雑すぎる必要はなく、背景色を一致させるだけで十分です。できれば絵の中のキャラクターの表情を変えてほしいです。可愛くてイケメンな彼女を二次元で表現できると思います！\n使用用途：SNSのファンアート公開。以下は写真と参照用の彼女のアカウントへのリンクです。どうもありがとう。\nhttps://twitter.com/omeomega_2nd/status/1763919326585962939\nhttps://drive.google.com/drive/folders/1uy2R6tItKQZabiC3JLfGdMSt58WC7SD6\n\nhttps://drive.google.com/drive/folders/1uy2R6tItKQZabiC3JLfGdMSt58WC7SD6", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omeomega_2nd/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2620488, "client_id": 2829683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc074fa4/uploads/origins/60f0e7e7-e5ce-4fef-9482-bb4dbc6ea7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=366a69de18111252ac0c9791031bcb9d", "srcset": "https://si.imgix.net/cc074fa4/uploads/origins/60f0e7e7-e5ce-4fef-9482-bb4dbc6ea7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=366a69de18111252ac0c9791031bcb9d, https://si.imgix.net/cc074fa4/uploads/origins/60f0e7e7-e5ce-4fef-9482-bb4dbc6ea7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e56754effa7ec706299e578da6d5db03 2x, https://si.imgix.net/cc074fa4/uploads/origins/60f0e7e7-e5ce-4fef-9482-bb4dbc6ea7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c76e6186d3664f96174e340cd59161cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc074fa4/uploads/origins/60f0e7e7-e5ce-4fef-9482-bb4dbc6ea7c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24ab8884a9e91f81fd6354c41c5987d3", "srcset": "https://si.imgix.net/cc074fa4/uploads/origins/60f0e7e7-e5ce-4fef-9482-bb4dbc6ea7c3?bg=%23fff&auto=format%2Ccompress&