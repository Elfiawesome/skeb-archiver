を変更していただいて構いません ⑅⃛\n\nもし背景が着く場合はかわいらしい空間（お部屋）にして頂きたいです…！\nもちろん背景なし単色等でも大丈夫です ◝✩\n\nおめがさんのイラスト本当に大好きです！これからも応援させて頂きます\nもしご縁がありましたらよろしくお願い致します໒꒱♡\n\nhttps://drive.google.com/drive/folders/1-K83k0hS-bDx09I7WgfjhrUazX5uMX-d", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1329694, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "tomo0111@Retrogamer🎮🀄️", "screen_name": "tomo0111_e", "avatar_url": "https://pbs.twimg.com/profile_images/2038647640376889345/I0jJ0crr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1295853682823553024/1773916874/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "complete_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 2407774, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "けい🍆skeb募集中", "screen_name": "NASUBI_07", "avatar_url": "https://pbs.twimg.com/profile_images/1942787192897822722/6_tpOzZ0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1370246997530218496/1727082850/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 2639157, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ライム@Skeb始めました", "screen_name": "ranse237", "avatar_url": "https://pbs.twimg.com/profile_images/1655577168708087811/4qA2Bwz4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1442048826550878208/1681311875/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_a