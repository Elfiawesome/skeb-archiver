gZuVX5amujWbGFqUDxbff9AiA7E\n\nキャラクター設定：\n・おばけの国の魔王様\n・うさぎのおばけ\n・イタズラ好きで、魔王城の側近や執事などにいたずらをしてよく怒られる\n・魔王としてしっかり業務をこなす反面、甘えたがりの部分も。\n・甘いものやお菓子が大好き！\n・女の子\n・12歳〜13歳を想定したショタ〜中性寄りの幼めな見た目を意識しています\n・髪型やメッシュの位置、特殊目、火の玉のしっぽ、ふわふわの垂れ耳については変えないで頂けると嬉しいです🫶\n\nNG要素：\n・胸を盛る描写\n(肉付きが良いくらいなら特に問題ありません○)\n・過度なつり目\n\n使用用途について：\n・Xでのポストやアイコン、ヘッダーなどでの利用。\n・配信サムネイルでの使用。\nグッズ化などの予定は得にありません！\n\nあたたかみのあるイラストにとっても惹かれまして、是非こてまる様のお好きなように書いてくださると嬉しいです💮\nご迷惑でなければPSDにて人物のみのものも頂けますと幸いです…✨️\nご都合合いましたらご検討よろしくお願いいたします🙏\n\nはなまる るた\n\nhttps://drive.google.com/drive/folders/1aZNUXgZuVX5amujWbGFqUDxbff9AiA7E", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kote_maru_o/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3917279, "client_id": 3181613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2051616/uploads/origins/5007687e-e831-425b-9f08-62bbefe555bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94b601f8b594ce6530fc9f2d5a976e0e", "srcset": "https://si.imgix.net/f2051616/uploads/origins/5007687e-e831-425b-9f08-62bbefe555bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94b601f8b594ce6530fc9f2d5a976e0e, https://si.imgix.net/f2051616/uploads/origins/5007687e-e831-425b-9f08-62bbefe555bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b0448b1cf9a7db646aeb49575c13e7d 2x, https://si.imgix.net/f2051616/uploads/origins/5007687e-e831-425b-9f08-62bbefe555bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=75081f7d7d6886f664d4aa47b933bc92 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2051616/uploads/origins/5007687e-e831-425b-9f08-62bbefe555bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6612f37ea120ce78f223f2590de5dc1", "srcset": "https://si.imgix.n