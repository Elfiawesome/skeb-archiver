drive/folders/1VQpQA2zSCvTbcDCfnmBHTm-7OrF7tzR9?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kote_maru_o/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3917279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496a8f94b0a1520e6a8aaac77929ab01", "srcset": "https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=496a8f94b0a1520e6a8aaac77929ab01, https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=300393e4bea1572133f1ec9d7df18417 2x, https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b3b8d7b6b73dce983129f90828b8428 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c298e71c82a81471836fddfb075e243c", "srcset": "https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c298e71c82a81471836fddfb075e243c, https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71e117d43ae752da6eb47c7f4440747a 2x, https://si.imgix.net/e8c54520/uploads/origins/2d1870d9-f460-4f66-87af-b02350e54cb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t