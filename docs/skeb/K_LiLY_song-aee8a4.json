に対しての異常なまでの愛と、人間や低レベルの相手に対する軽蔑以外は普通。\n仕事のできる長身美女。\n\n\n詳細は資料をご参考ください。\n金額や内容に不備等がある場合は、キャンセルもしくは再送要請をお願いいたします。\n長々と読んで頂き、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1G0GKuuk_7UEke7ZkdXgk8t1PdzQIoU6v", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@senbei1616/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1025088, "client_id": 1316257, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d4dd3c1/uploads/origins/31a7cf13-3be4-45ff-a318-d1726b727229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ba11c60ebbfb918d9ceef19290a255", "srcset": "https://si.imgix.net/1d4dd3c1/uploads/origins/31a7cf13-3be4-45ff-a318-d1726b727229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ba11c60ebbfb918d9ceef19290a255, https://si.imgix.net/1d4dd3c1/uploads/origins/31a7cf13-3be4-45ff-a318-d1726b727229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c09a78e2a490d04e8a4b507acabe3d8 2x, https://si.imgix.net/1d4dd3c1/uploads/origins/31a7cf13-3be4-45ff-a318-d1726b727229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6d17bb21b45ed1d9ced877a8332b40a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d4dd3c1/uploads/origins/31a7cf13-3be4-45ff-a318-d1726b727229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6bb36204918453f843b1598a9b35205", "srcset": "https://si.imgix.net/1d4dd3c1/uploads/origins/31a7cf13-3be4-45ff-a318-d1726b727229?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6bb36204918453f843b1598a9b35205, https://si.imgix.net/1d4dd3c1/uploads/origins/31a7cf13-3be4-45ff-a318-d1726b727229?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=20