。\n・台詞例\n「やぁアラン！暫く見ないうちに背が伸びた？え、別に変わってない？」\n「本当そういう恥ずかしいことよく平然と言えるよねぇ君」\n「──弁えなさい。神の御前だ」\n「イェーイ！ほらアラン笑顔！」\n・資料\nhttps://twitter.com/minasigo54/status/1459926964114915329\nhttps://twitter.com/minasigo54/status/1602758502707253248", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wawawa_kkkk/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 417995, "client_id": 226387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ec0745d/uploads/origins/1e988e04-c4a0-4d32-a257-2f0220e5c8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e20415acf8a1f0e538095535cc0a5cb", "srcset": "https://si.imgix.net/6ec0745d/uploads/origins/1e988e04-c4a0-4d32-a257-2f0220e5c8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e20415acf8a1f0e538095535cc0a5cb, https://si.imgix.net/6ec0745d/uploads/origins/1e988e04-c4a0-4d32-a257-2f0220e5c8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39b218c1a16cc0262054389519376621 2x, https://si.imgix.net/6ec0745d/uploads/origins/1e988e04-c4a0-4d32-a257-2f0220e5c8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=327083b38e4e263e70ed1ccac116cd01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ec0745d/uploads/origins/1e988e04-c4a0-4d32-a257-2f0220e5c8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4672ebb86937aeef2f1072ccadd3a60", "srcset": "https://si.imgix.net/6ec0745d/uploads/origins/1e988e04-c4a0-4d32-a257-2f0220e5c8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4672ebb86937aeef2f1072ccadd3a60, https://si.imgix.net/6ec0745d/uploads/origins/1e988e04-c4a0-4d32-a257-2f0220e5c8ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=2