ins/b3389d93-7be4-423d-bf00-9772f58c1019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25c5a8739c34f339c79eaeb1bdca0d06 2x, https://si.imgix.net/a1cab11c/uploads/origins/b3389d93-7be4-423d-bf00-9772f58c1019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d8efc0d1c46ecfc1cc7e1c268496088 3x"}, "body": "初めまして！skebの新着でしちのぶ様のイラストを見させて頂き一目惚れ致しました…！\nしちのぶ様の描く素敵なイラストを見て私のOCも描いて頂ければ嬉しいと思いましたのでリクエストさせて頂きます！\n\n◇リクエスト内容\n私のOC2人組を描いて頂きたいです！\n2人は恋人同士です。お好きなように描いてください！\n\n◇使用内容\nSNSのアイコンやスマホの壁紙、個人利用のグッズ制作\n\n◇その他\nもし良ければ没案やラフ案、背景透過もファイルに入れて頂けると嬉しいです！\n\nhttps://drive.google.com/drive/folders/1WDzbDhx0Ec7OglGqzget3QmA7Woz38Lv", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__7resaka/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3569503, "client_id": 2650505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8e39cb097190565e781fa1e4bb9c3e", "srcset": "https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d8e39cb097190565e781fa1e4bb9c3e, https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aba183cf6cdb97495b668b25c4e53adc 2x, https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b17c91d37b7db295b6616ced743c22b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55a58f0bd392ea49c4864f236e39b56f", "srcset": "https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55a58f0bd392ea49c4864f236e39b56f, https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3356e73ac891d8603cd422962b1fece4 2x, https://si.imgix.net/b93bc073/uploads/origins/05d8b2fc-4d01-4dac-af44-6f2d3994fdb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79f55009bede4cbb48c0e9e6f28c35d5 3x"}, "body": "慣坂様、こんにちは！\nお世話になっております。\n以前本垢の方でリクエストを送らせていただいた際、同梱されていたおまけの絵を見てじんわり「う、うれし～；；」になったため（もちろん本体のカラーイラストもとてもお気に入りです♪）こちらの方でもリクエスト差し上げました。\n\n【内容】\nTRPGで使用した私と友人のオリジナルキャラクターのイラストをお願いしたいです。\n構図やスタイル、シチュエーションなど完全にお任せします。\n服装等資料にある物に限らず、ご自由にしていただいて構いません。\n\nご検討いただけますと幸いです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1sJ6dOjyFvIh-7Z0XU62HIyaGufqMXw1W?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__7resaka/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3569503, "client_id": 1566948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08710c4af8f8a2ff3daf186fe44cd488", "srcset": "https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08710c4af8f8a2ff3daf186fe44cd488, https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0557bf7de9bbfb1b1c18ad4eb959ec40 2x, https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=583b5657b9aa06afaa81146079f2f870 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d31ad8914151b8ea2e48ebeeae68fb69", "srcset": "https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d31ad8914151b8ea2e48ebeeae68fb69, https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc72244d9f0bb0e931abd1b18106c691 2x, https://si.imgix.net/c08e42f4/uploads/origins/0d4804cb-25bb-42d2-a1aa-8bc5c2cebed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1cd7f3ea36e9c72482a1b62e3c1bd3 3x"}, "body": "はじめまして！\nskebを検索してクリエイター様を探すのが好きで、今回素敵な詰め合わせのイラストを拝見して、リクエストさせていただきました！！\n線だけでこんなにも素敵に詰め込めるのかと感服しております✨👀\n\n今回はTRPGのキャラクターを詰め合わせて描いていただきたいです！\n探偵助手の二人組で、アンティーク調な雰囲気な似合うキャラクター達です。\n\n▼キャラクター\n①金髪の男\n職業：探偵\n身長：179cm\n年齢：29歳\nイメージカラー：赤\n外見特徴：金髪の髪・つり目・光物の装飾品等派手な見た目。\nよくする表情：自身満々・笑う・怒る\n\n②銀髪の男\n職業：探偵助手\n身長:176cm\n年齢：20歳\nイメージカラー：翡翠\n外見特徴：銀髪の髪・しっかり目の眉・でこ出し前髪\nよくする表情：うんざり・ジト目・怒る（コラー！）・笑う\n(資料のデフォルト立ち絵が真顔ですが、表情豊かなキャラクターです)\n\n関係性：\n小さな事務所でひっそりと活動をする探偵と探偵助手。事務所の１階部分が住居スペースとなっており同居している。住居スペースでは大型犬（ゴールデンレトリバー）も飼っている。家事などは全般助手がする。\n基本的には事件解決に勤しむ探偵＆サポートをする助手。家では基本的に探偵の言動が発端で軽い喧嘩はしつつも仲のいい2人。\n\n構図や服装など、全て本当にお任せ致します！\n\nまた、画像資料に一部、「【CoC】Ⅶ・peccata」のネタバレがございます\n画像のファイルは分けておりますが、お気を付けください。\n\nもしも、ネタバレが大丈夫でしたらそちらも入れていただけるととても嬉しいですが、ネタバレ注意となりますので、その旨記載していただけると助かります！\n\n使用用途\n⬛︎個人鑑賞\n⬛︎個人で楽しむ範囲のグッズ作成\n⬛︎友人への共有\n\nよろしくお願いいたします！\n\nhttps://www.notion.so/291886ab6bf680f9b320c4f6f