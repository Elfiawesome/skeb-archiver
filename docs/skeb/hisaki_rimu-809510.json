ラつきながら舌打ちをしている感じだとありがたいです。\n難しい場合はめろうさんのXに載っている表情を参考にお任せで描いていただけると嬉しいです。\n・納品について、サイン、キャラクター、背景のレイヤー分けしたPSDファイルまたは背景透過のPNGファイルでいただけますと幸いです。\n\n〜使用用途〜\n・YouTubeでサムネイル、動画。\n・SNSなどでの利用。\n・FAへの利用。\n\n以上、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hisaki_rimu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3403944, "client_id": 227300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4f4daad/uploads/origins/b0f6dca6-3f28-48bb-9657-29be18af7573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57ca9af7df722190abcdbefaf53ffd0a", "srcset": "https://si.imgix.net/f4f4daad/uploads/origins/b0f6dca6-3f28-48bb-9657-29be18af7573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57ca9af7df722190abcdbefaf53ffd0a, https://si.imgix.net/f4f4daad/uploads/origins/b0f6dca6-3f28-48bb-9657-29be18af7573?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=febe64008326b058cfd8bbdd65efd4fc 2x, https://si.imgix.net/f4f4daad/uploads/origins/b0f6dca6-3f28-48bb-9657-29be18af7573?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76661036adbecaa00b04fe91cf755116 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4f4daad/uploads/origins/b0f6dca6-3f28-48bb-9657-29be18af7573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b940af30ca60a8be801bccfec18c73e", "srcset": "https://si.imgix.net/f4f4daad/uploads/origins/b0f6dca6-3f28-48bb-9657-29be18af7573?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b940af30ca60a8be801bccfec18c73e, https://si.imgix.net/f4f4daad/uploads/origins/b0f6dca6-3f28-48bb-9657-29be18af7573?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64e2d13204e