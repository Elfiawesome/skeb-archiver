c3662c4c9a59a530a576ad4b7, https://si.imgix.net/5cc7ec31/uploads/origins/8fde902e-8fd8-4245-a30f-4b7818bfcdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a552e559ddfd2218501993fd7bb994f0 2x, https://si.imgix.net/5cc7ec31/uploads/origins/8fde902e-8fd8-4245-a30f-4b7818bfcdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81341e1402bb7504cd97fa2baab9ee2f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cc7ec31/uploads/origins/8fde902e-8fd8-4245-a30f-4b7818bfcdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef437796fc0b30bb624a75baa72fb30b", "srcset": "https://si.imgix.net/5cc7ec31/uploads/origins/8fde902e-8fd8-4245-a30f-4b7818bfcdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef437796fc0b30bb624a75baa72fb30b, https://si.imgix.net/5cc7ec31/uploads/origins/8fde902e-8fd8-4245-a30f-4b7818bfcdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=943f75cba74626721a88f5aedfa16708 2x, https://si.imgix.net/5cc7ec31/uploads/origins/8fde902e-8fd8-4245-a30f-4b7818bfcdd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=487ca4409cf7d17f918ee0c0e6b209b5 3x"}, "body": "こんにちは。 恋姫†無双 の袁術 公路/美羽(みう)の作品をお願いしたいです。誘拐され、足を開いた状態で椅子に縛り付けられています。靴を履いておらず、スカートは破れて腰から下がなくなっており、胸には大きな切り傷がたくさんありました。足が少しぶらぶらするように、背の高い椅子に座らせてください。おもらしをしてしまい、恐怖で大もしてしまいます。パンツのシミをできるだけ大きくしてください。おしっこは勢いよく噴出し、椅子に少し溜まってから足を伝って靴下から滴り落ちます。茶色もたっぷりと広げてください。たくさん出たのでできればパンツから少しこぼれてください。椅子の下に大きな水たまりを作ってください。\n\n(誘拐犯は女性なのでテキストをピンクにしてください)\n\nダイアログ: みうはトイレが欲しいと不平を言います。捕らえた人たちは待つように言いました。そこで、みうはさらに不平を言い、ついには彼らがイライラして、黙らなければ指を切り落とすと脅しました。みうは静かになりましたが、抗議の中でおもらししました。誘拐犯は、おもらししても許さないと言い、顔のすぐ横にナイフを刺した。恐怖を感じ、勢いよくおしっこをしながらも大をしてしまいます。誘拐犯は、おしっこをするだけでなく、うんちまでを笑いました。そして、美羽は黙ってないで、汚れたパンツ一枚で許されるわけがない、と言いました。\n\n表現: 最初はミュウをガキのようにさせることができます。 おしっこをするときは真っ赤になります。 うんこをするとき、顔を赤らめてナイフを見つめる恐ろしい表情。\n\n\n服装：みうに高価なワンピースを着せてください。腰から下がなくなっていて白いパンツが露出していてください。ブラジャーが覗いているので、上半分も剥がしてください。靴を履かずにサイハイソックスを履かせてください。靴下のオシッコの汚れを大きく黄色くしてあげてください。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 108810, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "赤井なな", "screen_name": "AKAI_NANA7", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F23bd733b-4c77-4f44-85ef-dbf989190c96.webp&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/61556239-450c-4415-aab4-0b8956cd709a.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 191653, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おいまんじ", "screen_name": "oimanji", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Feb3d5ade-cb81-486e-a7c0-ee056047db21.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/e8470dd3-1823-4864-b041-2e1f665d72b3.png", "appeal_receivable": true, "popular_creator_rank": 30, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 160}, {"id": 317338, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヒャク@関西けもケM-52", "screen_name": "hyaku1063", "avatar_url": "https://pbs.twimg.com/profile_images/1884176296483446784/nIJ0jBA_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1348343887/1603801730/1500x500", "appeal_receivable": false, "popular_creator_rank": 36, "request_master_rank": null, "first_reque