4b\u306f\u3068\u3063\u3061\u3089\u304b\u3063\u3066\u3044\u308b\u3002\n\u6599\u7406\u3082\u3067\u304d\u305a\u30b3\u30f3\u30d3\u30cb\u5f01\u5f53\u3067\u6e08\u307e\u305b\u3066\u3044\u308b\u3002\n\n\u2026\u5927\u4e08\u592b\u304b\uff1f\u3053\u306e\u5148\u751f\u3002\n\n\n\u3057\u304b\u3057\u305d\u306e\u5b9f\u8ab0\u3088\u308a\u751f\u5f92\u60f3\u3044\u306e\u5f37\u304f\u3066\u512a\u3057\u3044\u5148\u751f\u3002\n\n(\u4f55\u6545\u304b\u5b66\u5712\u30e2\u30ce\u306a\u306e\u306b\u6226\u4e89\u304c\u8d77\u304d\u308b)\u4f5c\u4e2d\u3067\u306f\n\u6575\u3092\u4e00\u7db2\u6253\u5c3d\u306b\u3059\u308b\u5148\u751f\u304c\u898b\u3089\u308c\u308b\u3002\n\n\u751f\u5f92\u306e\u3053\u3068\u3092\u4f55\u3088\u308a\u5927\u5207\u306b\u601d\u3063\u3066\u304a\u308a\u4f5c\u4e2d\u3067\u306f\u305a\u3063\u3068\u702c\u5c3e\u305f\u3061\u751f\u5f92\u306e\u3053\u3068\u3092\u8003\u3048\u3066\u3044\u308b\u3002\n\n\u305d\u3057\u3066\u526f\u696d\u3067\u9664\u970a\u5e2b\u3092\u3084\u3063\u3066\u3044\u308b\u3002\n\uff08\u3042\u308c\u2026\u516c\u52d9\u54e1\u2026\uff1f\uff09\n\u663c\u9593\u30b5\u30dc\u3063\u3066\u3044\u308b\u306e\u306f\u6b8b\u696d\u3067\u591c\u4e2d\u306b\u6b8b\u308b\u305f\u3081\u3002\n\n\u591c\u306a\u591c\u306a\u751f\u5f92\u305f\u3061\u306b\u5bb3\u3092\u306a\u3059\u970a\u3092\u9664\u970a\u3057\u3066\u3044\u308b\u3002\n\n\u9996\u304b\u3089\u304b\u3051\u3066\u3044\u308b\u52fe\u7389\u3082\u9664\u970a\u52b9\u679c\u304c\u3042\u308b\u3082\u306e\u3002\n\n\u3069\u3046\u3084\u3089\u304b\u306a\u308a\u91cd\u3044\u904e\u53bb\u304c\u3042\u308b\u3089\u3057\u3044\u3002\n\u3044\u3064\u3082\u8ab0\u304b\u306e\u5f71\u304c\u898b\u3048\u308b\u3002\n\n\u3068\u3044\u3046\u611f\u3058\u3067\u3059\u2026\uff01\n\n\u3068\u306b\u304b\u304f\u751f\u6d3b\u3068\u304b\u5916\u805e\u3068\u304b\u30c0\u30e1\u30c0\u30e1\u3067\u5b66\u6821\u306b\u9152\u3082\u3063\u3066\u304d\u3066\u308b\u306e\u306b\uff01\u3044\u3056\u3068\u8a00\u3046\u6642\uff01\u304b\u3063\u3053\u3044\u3044\u306e\u826f\u304f\u306a\u3044\u3067\u3059\u3088\u306d\uff01\uff1f