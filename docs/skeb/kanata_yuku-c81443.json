pe reference: \u82b1\u3067\u306f\u306a\u304f\u30ef\u30b9\u30ec\u30ca\u30b0\u30b5\nhttps://drive.google.com/file/d/1TRpxmp4sGLdg5uyeVANET55uXZ7wLM40/view?usp=sharing , https://drive.google.com/file/d/1Ta1k-otLSvu1VCN9DOSXNQqyZMSwFOQE/view?usp=sharing\n\nPose: https://drive.google.com/file/d/13nfwGxoIDnm_4vW3_uPXfqcx56P6kHdl/view?usp=sharing\n\u80cc\u666f\uff1a\u82b1\u7551\u3001\u82b1\u3092\u6301\u3063\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3001\u98a8\u306e\u5f37\u3044\u96f0\u56f2\u6c17\n\nPlease let me use this for twitch, twitter. \ntwitch\u3001twitter\u306b\u4f7f\u308f\u305b\u3066\u304f\u3060\u3055\u3044\u3002\n\nI will like to have the psd file with the background separated too, thank you.\n\u80cc\u666f\u3082\u5206\u96e2\u3055\u308c\u305fpsd\u30d5\u30a1\u30a4\u30eb\u304c\u6b32\u3057\u3044\u3067\u3059\u306d\u3001\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3059\u3002\n\nhttps://drive.google.com/file/d/14CzBX2wsxLhlJR-EitHPsqcJUmlL4FO3/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanata_yuku/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 742316, "client_id": 582791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c5401bd/requests/206264_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8155b1624871aaa65958bb5c805ea809", "srcset": "https://si.imgix.net/0c5401bd/requests/206264_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8155b1624871aaa65958bb5c805ea809, https://si.imgix.net/0c5401bd/requests/206264_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf76035ed4ee75a0566453e3fb3ab625 2x, https://si.imgix.net/0c5401bd/requests/206264_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b2a167b678bb1edce9d75edfd58a833 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consor