src": "https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c801ba8a22f34289ae6badc77a7d190a", "srcset": "https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c801ba8a22f34289ae6badc77a7d190a, https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34c68620d33f1af8f7675452039868cf 2x, https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=521a3d4c7b6a879d0f69f4458f7870d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5560b868920e0e8ed09ea49f9686847", "srcset": "https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5560b868920e0e8ed09ea49f9686847, https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f60dd1c896fef7621e8df87ba7d056de 2x, https://si.imgix.net/9b22bac1/uploads/origins/b099e70f-b96b-48d7-aab5-05a72ef3da9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=028e33d253afba281585546c3bee3362 3x"}, "body": "初めまして。\nVsingerのVIER(フィア)と申します。\n\n今回、先生の素敵な絵のタッチで、【通常衣装のオリジナルマイクを持ったVIER】のイラストを描いて頂きたく、リクエストを送らせて頂きました。\nサムネイル使用がメインなので羽が文字とかぶってしまう為下め（もしくは小さ目）につけてくれると嬉しいです。顔だけがっつり横向きにならないようしてほしいです。\n先生のイラストの雰囲気を大事にしたいので、細かい表現方法の点は先生の絵柄を優先してください。\n\n■詳細■\n使用用途：サムネイル・ヘッダー・おはツイ投稿・グッズ使用・メンシプ使用\n上記がOKな場合のみ承諾していただけますと幸いです。\n\nその他予想されるものとしては、ファンボックスやメンシプ壁紙/待ち受け/案件サムネ/グッズ\nこちらはメインの使用方法ではないです。\n\n\n\n■ファイル形式■\n様々な用途で使用させて頂きたいため、＂背景と人物とサインのレイヤーをわけたPSD/背景ありとなし透過PNG形式＂や、描く上で支障がない範囲で左右上が見切れない形で頂けたら嬉しいです。\n\n■ビジュアル特徴■\n・つり目/ジト目\n・お口小さめ\n・色白(立ち絵より白くしてください)\n・低身長\n・イメージカラー：赤or黒\n・モチーフ：鍵/ダブルシャープ/アネモネ\n・口を開けたら向かって右だけ八重歯\n・前髪片目パッツン/白髪で毛先に黒グラデーション\n・目の色は左が赤/右の上部分は薄いグレー/下は薄い水色。両目の白いハイライトの縁が青いです\n・両耳に音符ピアス\n・頭に鍵ヘアピン\n・グラマラスだけどスレンダー\n・右羽だけあり　黒羽で根本が若干白（羽サムネイルで邪魔なので小さ目描写でOK）\n・ヘイローあり\n\nhttps://drive.google.com/drive/mobile/folders/1XUnzs17xpKef8iQ_Zm_KBqWKnvoLqGZf?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ozk9c/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3699799, "client_id": 3839150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85c3593a/uploads/origins/2675cfa4-189c-4655-b6dd-40766e6f6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8156b33287882e997035000c8281edc2", "srcset": "https://si.imgix.net/85c3593a/uploads/origins/2675cfa4-189c-4655-b6dd-40766e6f6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8156b33287882e997035000c8281edc2, https://si.imgix.net/85c3593a/uploads/origins/2675cfa4-189c-4655-b6dd-40766e6f6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4fd447f9f92481003127812b38236415 2x, https://si.imgix.net/85c3593a/uploads/origins/2675cfa4-189c-4655-b6dd-40766e6f6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09e4c519aad596ffbfb5d7967bf72ad6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85c3593a/uploads/origins/2675cfa4-189c-4655-b6dd-40766e6f6db4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc372f95b258a12805d161033abe6017", "srcset": "https://si.imgix.