si.imgix.net/ee32bc78/uploads/origins/70cbfdd7-699a-4a60-af21-88a18ed82a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83c0381447d45fc9dc9b4d3aafabf902 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee32bc78/uploads/origins/70cbfdd7-699a-4a60-af21-88a18ed82a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b5246f1bd601e70d91d651893255fa", "srcset": "https://si.imgix.net/ee32bc78/uploads/origins/70cbfdd7-699a-4a60-af21-88a18ed82a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5b5246f1bd601e70d91d651893255fa, https://si.imgix.net/ee32bc78/uploads/origins/70cbfdd7-699a-4a60-af21-88a18ed82a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5578870d843c83762f5703c8b024179 2x, https://si.imgix.net/ee32bc78/uploads/origins/70cbfdd7-699a-4a60-af21-88a18ed82a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2db65bdaab0a52319fc2cefc31a38e9 3x"}, "body": "こんにちは！あなたのアートが大好きです。\n\nシナリオある男がコンピューターで何かを見ていると、突然白神フブキに変身し、非常に大きなシャツを持ち上げて、混乱と衝撃に満ちた表情で自分の新しい身体を見てから、シャツを脱ぎ捨てる。\n\n最後のコマでは一人称視点になっており、吹雪がIDを持っていて、そのIDが男のIDから吹雪のIDに変わっているのが見える。\n\n髪と目の色を変えない別バージョンも作ってもらえると嬉しいですが、その必要はありません！\n\n白神吹雪の参考文献\n(https://www.deviantart.com/stash/01yhhaiz2ukx)\n(https://www.deviantart.com/stash/03tapj5kyra)\n(https://www.deviantart.com/stash/015pa49yz1hr)\n\n白神吹雪の参考文献\n(https://www.deviantart.com/stash/0f5e2y8dgd3)\n(https://www.deviantart.com/stash/01mrb7vof8ov)", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fu_Me_Kin/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 73841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb3177ca205166f038a1bf260ca1313e", "srcset": "https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb3177ca205166f038a1bf260ca1313e, https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad58bc30f94bf89c0485d87f14705813 2x, https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef2b1e4000866adcc622381413a63117 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d34e23461e727096cf3bc5434244d4", "srcset": "https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87d34e23461e727096cf3bc5434244d4, https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7439682f1cf3ca8cb08c6e40a8882e4d 2x, https://si.imgix.net/f1c3829e/uploads/origins/b9814a92-0fa1-4f75-b4bc-a4b19f315295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c54f1e60f35e7237509c6af9bd2253b 3x"}, "body": "こんにちは、私はあなたの絵のファンです。\n\nシナリオ\nある男性がお風呂に入る準備をしている。浴室では下着しか身に着けていない。床に酒瓶が落ちているのに気づき、手を伸ばそうとする。彼は突然、全裸になった『ぼちぼちザ・ロック』の広井菊理に変身する。慌てて自分の裸体を見下ろす。最後のコマは、自分の体を感じながら自分を見下ろしている彼女の一人称視点だ。\n\n参考：https://drive.google.com/file/d/1XWlUpfR4DaJgVsR_l3v88PzGcf8Sw4Dp", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fu_Me_Kin/works/11", "