d1c/uploads/origins/02900f30-ef14-48b2-ad55-253774df0c33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7df0f5c7dcb2ecebb10d8e93f41b60, https://si.imgix.net/843e9d1c/uploads/origins/02900f30-ef14-48b2-ad55-253774df0c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f6f20c1805d55a7b13ec73864c4a099e 2x, https://si.imgix.net/843e9d1c/uploads/origins/02900f30-ef14-48b2-ad55-253774df0c33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cdce18f6964cd4ac078c68163040e9d 3x"}, "body": "【キャラ】\nにじさんじの『星川サラ』と『倉持めると』をお願いします。\n\n【シチュエーション】\n街中を2人で歩いているとチャラ男にナンパされ、断ろうとするも強引に性感帯を刺激され絶頂させられてしまう。\n\n【服装】\n◯星川サラ：https://x.com/sara_hoshikawa/status/1478008133096456199?s=46\n◯倉持めると：https://x.com/_alicecoco/status/1721126987312566736?s=46\n・鞄なし\n\n【内容】\n◯真ん中を歩く2人を左右から挟み込むようにチャラ男が立って歩いている。\n◯巨乳が好きなので胸の大きさは頭よりも大きい爆乳にしてほしいです。\n◯強気な女性が抵抗しながら無理やり絶頂させられてるのが好きなので完堕ちまではさせないでほしいです。\n\n◯星川サラ\n・チャラ男に背後から手マンされ、軽くガニ股気味に足を開きながら絶頂している。\n・スカートは捲り上げられパンツが見えてしまっている。\n・制服の前面をおへそのあたりまで開かれブラを着用した爆乳が見えてしまっている。\n・悔しそうに睨みながらチャラ男を押し除けようとしている。\n・チャラ男「嫌ならちゃんと抵抗しないと〜、ここ弱いんでしょw」や、星川「うあ゛っ、クソっ！、それやめろぉ゛、またイグっ！！」などのセリフ。\n\n◯倉持めると\n・シャツを開けられ(一番下は結んだまま)、片方の胸が露出している。\n・チャラ男に肩を組まれて露出した胸の乳首を引っ張られている。\n・引っ張られている乳首からは母乳が漏れ出て、もう片方の乳首はシャツに母乳のシミを作っている。\n・チャラ男の腕を掴んで振り解こうとしているが力が強く全く勝てない。\n・チャラ男「母乳出るとかエロすぎでしょ！なぁなぁホテルまで来たらもっと凄いことしてあげるよ！w」や、倉持「ちょ、乳首引っ張る、なぁ゛、んお゛っ！、力強くて、はなれなぃ、イ゛ッ！！」などのセリフ。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wkmt321/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3517915, "client_id": 1714303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ccca6fe8307c712dd3ce3fd87be34fe", "srcset": "https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ccca6fe8307c712dd3ce3fd87be34fe, https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d8accd8ebb73475b3cda2dda982b233 2x, https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=349c084d710673d589608b82944de06f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=603b275beb95eaf1b8de8675dedd9cdc", "srcset": "https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=603b275beb95eaf1b8de8675dedd9cdc, https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62e22681352f754eaa6f198c91654aff 2x, https://si.imgix.net/fc21a3b5/uploads/origins/01365275-851c-422d-8896-6b7c884a6b4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10d5349ca16e819c5491bbdcfdd53bef 3x"}, "body": "シュークリーム先生こんにちは！龍提督と申します。\n先生がpixivに投稿されているイラストが大変好みだったので声を掛けさせて頂きました！\n\n今回は自分がVRChatで使用しているアバターのイラストを依頼させていただきたいです！\n\nシチュエーションとしては\n『海辺の洞窟でタコのような触手に捕らえられ、はち切れそうなほど大量の精液と卵を中出しされるボテ腹苗床にされる』シチュエーションでお願いします。\n\nお願いしたい事としては\n・衣装は脱がさずズラして挿入されている状態で描いて頂きたいです。\n・競泳水着はできるだけ破かずに描いていただけると嬉しいです。\n・口内や子宮へ大量に射精され、ボテ腹(大きめ)/ザーゲロ/顔面や全身へぶっかけられた状態で、めちゃくちゃに犯されている状態を表現して頂きたいです。\n(イメージとして先生のイラスト《https://www.pixiv.net/artworks/129722319》や\n ≪https://www.pixiv.net/artworks/129360508≫ のようにボテ腹を大きく、そしてドボッと感のある精液を描いて頂きたいです)\n\n特に先生の重量感ある液体の表現に惹かれました！\nぜひ描いていただけると嬉しいです！よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1T_dfdnIMxAI9D02HLF7-xOHmG50hv4IO?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wkmt321/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3517915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=182e38754817951e157a4aa51894ad41", "srcset": "https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=182e38754817951e157a4aa51894ad41, https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c2d5ffb0f281346212c6a94e4421224 2x, https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e869ca8a6fbb87c39638f405080ef5a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0603a2688c6705eabf82a342a1943852", "srcset": "https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0603a2688c6705eabf82a342a1943852, https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3cf2f52d59c72d2692c812b72902d731 2x, https://si.imgix.net/6dda910f/uploads/origins/43f18345-0907-491f-8733-a3bc4687ba26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45f669df206e729d2f6a24fd2f6d5c05 3x"}, "body": "リクエスト失礼します！\n\n倉持めるとのリクエストです\n服装：全裸で、乳首とヘソにピアス。\nシチュ：事後に彼氏と写真を撮ってるようなイメージです。\n二人とも並んで立っていて、\n彼氏くんはめるとの肩に腕を回して、片方の乳を鷲掴みにしています。\nめるとは少しがに股気味に脚を開いて、笑顔でダブルピースしています。\nめるとの口の端には陰毛がついていて、頭、胸の谷間にはフェラとパイズリの精液がたっぷりとかけられ、膣内からは大量に精液があふれています。\nまた、つかまれている方の乳からは母乳が絞られて出ており、おしっこを漏らしています。\nめるとと彼氏くんの身長差は頭一つ強あるイメージです。(身長差参考 https://drive.google.com/file/d/1UWnLAiAzkLzEYQOM1QUy2oGxt5X-2mwk/view?usp=drive_link)\n\nまた、精液やおしっこなど別レイヤーにしていただけると、事前のような差分にできるためありがたいです。\nよろしくおねがいします。\n\nhttps://pbs.twimg.com/media/FnyTOq_aAAAMEWr?format=jpg&name=medium", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wkmt321/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1ccb3984/uploads/origins/174925de-f349-4e9c-8b1e-6c1dddd2399c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ee3f2b09f2548c7f761377edc71a77c", "srcset": "https://si.imgix.net/1ccb3984/uploads/origins/174925de-f349-4e9c-8b1e-6c1dddd2399c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1ee3f2b09f2548c7f761377edc71a77c, https://si.imgix.net/1ccb3984/uploads/origins/174925de-f349-4e9c-8b1e-6c1dddd2399c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7a21e6b85c5e3610c040486d722752d 2x, https://si.imgix.net/1ccb3984/uploads/origins/174925de-f349-4e9c-8b1e-6c1dddd2399c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1129d54a9e0970efa428b4832bf7d731 3x