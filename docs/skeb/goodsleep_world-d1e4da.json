胆だ。失敗なんて有り得ない。\n弟に「■■」を抱いている。\n\n\nシナリオリンク\nhttps://booth.pm/ja/items/5200145?srsltid=AfmBOoqPjnzcb76Tb6dBfkWmYjCIuhRNxHnTpPoxatTyyAdm2pJK44KR\n\nキャラクターイメージ画像\nhttps://drive.google.com/drive/folders/1SH1guoxP7hu0P74goI6grYBnxMLMWXZe", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yasaiiove/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2785217, "client_id": 3314192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff4a3481/uploads/origins/d9abe114-66d5-4e00-8f2e-650bfb705812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac0c5e6186ebd5e61265a6b1b17c8209", "srcset": "https://si.imgix.net/ff4a3481/uploads/origins/d9abe114-66d5-4e00-8f2e-650bfb705812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac0c5e6186ebd5e61265a6b1b17c8209, https://si.imgix.net/ff4a3481/uploads/origins/d9abe114-66d5-4e00-8f2e-650bfb705812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f70cc3cc5a5fdf0fa1f681cff9de4223 2x, https://si.imgix.net/ff4a3481/uploads/origins/d9abe114-66d5-4e00-8f2e-650bfb705812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16347dae8ef3442f9a020f7a3aac9c24 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff4a3481/uploads/origins/d9abe114-66d5-4e00-8f2e-650bfb705812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63a33c79edd125a43242cc1786dcea81", "srcset": "https://si.imgix.net/ff4a3481/uploads/origins/d9abe114-66d5-4e00-8f2e-650bfb705812?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63a33c79edd125a43242cc1786dcea81, https://si.imgix.net/ff4a3481/uploads/origins/d9abe114-66d5-4e00-8f2e-650bfb705812?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur