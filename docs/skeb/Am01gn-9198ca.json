c": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Am01gn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2436739, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3955c4f8fd70b8d824cf550ab7b4d899", "srcset": "https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3955c4f8fd70b8d824cf550ab7b4d899, https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ea86ba4e76cbea0a987edfee38e7269 2x, https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e7c454c3e8d51a0ca68e47c911cc9b8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df65a9d09db123e6469de00bca8668fa", "srcset": "https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df65a9d09db123e6469de00bca8668fa, https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6be9b7474f827eb0c3b13fa0aa6dc64 2x, https://si.imgix.net/68af55bc/uploads/origins/9f7a418e-f501-42da-a6e7-5c79cdaa296d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7fb6a32b7fdb375445075f4b1b2c212 3x"}, "body": "はじめまして。\nタイムラインにイラストがおすすめに流れてきて、とても素敵なイラストだったので依頼をしてみたいなと思いました。\nただ、skebに不慣れでして失礼がありましたらすみません。\n\n\n私は絵が描ける人間ではないので、ピクルー等を用いた参考画像ですみません。\n一度だけうちの子を描いてもらったイラストがあるのでそちらも資料に入れておきます。(描いていただいたイラストは参考程度に入れておりますが、お洋服はそれに寄せなくても大丈夫です)\n\n\n\n・見た目のイメージ\n160cm/47kg/G65くらいの骨格ウェーブ\nボブよりは長く、ミディアムな感じ\nふわふわした髪\nくらげモチーフなので、触手のように髪の毛の襟足が伸びてたら嬉しいです(色はインナーの紫と同じ)\nハイトーンの金髪〜白髪でインナーが紫\n瞳は紫で、目はくりっと大きめのまつげぱちぱち\n\n\n・服装のイメージ\nくらげのようなふわっとした感じ、触手のようなふりふりがあったら嬉しいです。\nスカートは短めだと(膝上ではあると)嬉しいです。(ロングがNGというわけではないのでロングで描かれていても大丈夫です！)\n露出は多くても少なくても構いません。お任せします。\n清楚さ、海っぽさを取り入れた色味だと嬉しいです。(好きな色が紫なので、紫でも大丈夫です)\nタイトめなお洋服よりはふわっとした感じだと嬉しいです。\n\n\n・キャラクター\n元気というよりはおとなしめ・おっとり系\nキリッとしているというよりはふんわり系\nくらげモチーフなのでふわふわしてます。\n愛嬌バツグンな感じの子です。\n\n\nポーズや構図など描く内容は諸々お任せいたします。\nもし背景に模様や色をつけてくださる場合、背景透過の差分もありますと嬉しいです。\n\n\n\nskebの勝手がわからず、このような感じでも大丈夫でしょうか？\n無理そうでしたら蹴っていただいて構いません。\nもし受けてくださることになりましたらよろしくお願いいたします。\n\n\nhttps://drive.google.com/drive/folders/1h2S6cz-yPlVIVRyarhP1M-i9N5e7EfED", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 462023, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゆきじろう", "screen_name": "yukijiro02a", "avatar_url": "https://pbs.twimg.com/profile_images/1864397058498809856/O-thg7a9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1165170121993646081/1677135276/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1151334, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🍂", "screen_name": "X10Dareda", "avatar_url": "https://pbs.twimg.com/profile_images/1030907337727344640/-NcsjNUD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1030516734908715008/1702572930/1500x500", "appeal_receivable": false, "popular_creato