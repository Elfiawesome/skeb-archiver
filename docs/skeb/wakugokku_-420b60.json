ttps://drive.google.com/drive/folders/1Go1PeCtt7xHRfGseVEFYSFRaOigMH38W\n\n◆使用用途◆\nID・名前を記載した上でのアイコン使用、\n個人観賞、自陣のみへの共有\n\nお忙しい中大変恐縮ですがご一考いただけますと幸いです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wakugokku_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3809132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3-4985-b401-82ac4400b41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb07f466dc81528d99776b7fbe211ac9", "srcset": "https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3-4985-b401-82ac4400b41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb07f466dc81528d99776b7fbe211ac9, https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3-4985-b401-82ac4400b41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0e54012e466e9e38999a5d804367584 2x, https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3-4985-b401-82ac4400b41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee3906323ae56b1e252aa38c41be75fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3-4985-b401-82ac4400b41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8edd307b9d535abb9713e4ea5f31ff4", "srcset": "https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3-4985-b401-82ac4400b41b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8edd307b9d535abb9713e4ea5f31ff4, https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3-4985-b401-82ac4400b41b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84f2223f2ac44980cd99303716a14de2 2x, https://si.imgix.net/93f1c7f1/uploads/origins/ae9d061f-78b3