な感じの流れでお願いします。\n\n漫画に入れて頂きたい描写や要素\n導入部分で興奮したオークに囲まれこれから何をされるのか予想し「嘘でしょ…？」等言い引き攣った顔のユズキ\n初挿入する前にペニスを女性器に擦りつけどこまで入るか見せ槍するオークと怯えるユズキ\n中出し宣言するオークとそれに慌てるユズキ\nまた漫画の最後はオーク達の輪姦が終わらずそのままつづく様な感じのオチ\nユズキは快楽堕ちせず最後までオーク達を嫌悪する感じでお願いします。\n\nコミック形式のリクエストは初めてなので何か不備があったらすいません不備がある部分はお任せします\n要望が多くなってしまいましたがご検討よろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chikiboneya_0on/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2924735, "client_id": 1257461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1db25af2/uploads/origins/0cda88d2-d554-4730-a4cc-34f88cd59e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c15d6843219392261096caa9bbbf2055", "srcset": "https://si.imgix.net/1db25af2/uploads/origins/0cda88d2-d554-4730-a4cc-34f88cd59e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c15d6843219392261096caa9bbbf2055, https://si.imgix.net/1db25af2/uploads/origins/0cda88d2-d554-4730-a4cc-34f88cd59e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9224a16e357c05bfee6e13dff087f4d2 2x, https://si.imgix.net/1db25af2/uploads/origins/0cda88d2-d554-4730-a4cc-34f88cd59e46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e7ea4a841e1cd3735665f3e35ee2def 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1db25af2/uploads/origins/0cda88d2-d554-4730-a4cc-34f88cd59e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cf93de1bf6bf9c812aa18acc495dd35", "srcset": "https://si.imgix.net/1db25af2/uploads/origins/0cda88d2-d554-4730-a4cc-34f88cd59e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cf93de1bf6bf9c812aa18acc495dd35, https://si.imgix.net/1db25af2/uploads/origins/0cda88d2-d554-4730-a4cc-34f88cd59e46