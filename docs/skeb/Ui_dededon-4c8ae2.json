1-c9a3-41ae-b1e8-e53de0dfa0d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0322e4c00efaa35cf223f9984c55b138, https://si.imgix.net/7ef0ff0c/uploads/origins/df992551-c9a3-41ae-b1e8-e53de0dfa0d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=789a5d03350aa71c1e9a1bfe7c9654aa 2x, https://si.imgix.net/7ef0ff0c/uploads/origins/df992551-c9a3-41ae-b1e8-e53de0dfa0d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa2cec95d5e2d6fa2968e8494a65a85 3x"}, "body": "桜瀬うい様はじめまして。\n虎本タイガと申します。\n\nskebとXでの先生の過去作品を拝見して\n可愛くて暖かみのあるとても素敵なイラストでしたので\nぜひ描いていただきたいと思いリクエストいたします。\n\n【内容】\n応援しているVtuberの妃てぃなさんへのプレゼント用にイラストをお願いします。\n髪型や衣装、構図など全てお任せいたします。\n\n【使用用途】\nSNSでの投稿や収益化済みYouTube等でのサムネイルや動画、配信での使用、ネットプリントでの配布\n\n【お願い】\nサムネイルに使用する可能性があるため髪や頭、服などが両サイドの見切れる箇所がある場合\nレイヤーではすべて描写していただますと大変助かります。\nキャラクターのみの透過PNGまたはPSDデータを追加でいただけますと幸いです。\n\nまた、料金不足の場合は再送いただけますと助かります。\n条件が合いましたらどうぞよろしくお願いいたします。\n\n【X】\nhttps://x.com/kisaki_tina?s=20\n\n【YouTube】\nhttps://www.youtube.com/@kisaki_tina\n\n【キャラクター】\n・現代社会に馴染みすぎてしまったおとぎの国の継母系Vtuber\n・姉御キャラでツッコミが上手くて話好きで歌が上手い\n・お酒とご飯が大好きで半日飲んでいたり定食屋では特盛にしがち\n・明るくて元気で行くと歓迎してくれる飲み屋のお姉さんみたいな人\n\n【資料】\nリットリンク▶ https://lit.link/kisakitina\n\n立ち絵▶ https://drive.google.com/drive/u/0/folders/1hsks6qASvVZejkwgobB3G-x5mM7kMZTj\n※三面図はありません", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ui_dededon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3731192, "client_id": 3324706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e47c6df0/uploads/origins/23679e0e-ab89-4919-88a2-f5410dfd3b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c566779cc257ba7aa9744a181530c5b", "srcset": "https://si.imgix.net/e47c6df0/uploads/origins/23679e0e-ab89-4919-88a2-f5410dfd3b81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit