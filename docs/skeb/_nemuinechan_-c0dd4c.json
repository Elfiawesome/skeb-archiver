2 2x, https://si.imgix.net/c6b0fb46/uploads/origins/ade4d7f7-0d7e-47d4-abb8-7709caaeba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adbcfba57ee8862e6ef8100cb8070468 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6b0fb46/uploads/origins/ade4d7f7-0d7e-47d4-abb8-7709caaeba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=303ad096f2352c853bf16a270a04c2b1", "srcset": "https://si.imgix.net/c6b0fb46/uploads/origins/ade4d7f7-0d7e-47d4-abb8-7709caaeba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=303ad096f2352c853bf16a270a04c2b1, https://si.imgix.net/c6b0fb46/uploads/origins/ade4d7f7-0d7e-47d4-abb8-7709caaeba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82666f53ff027f418e2d501bd6614aae 2x, https://si.imgix.net/c6b0fb46/uploads/origins/ade4d7f7-0d7e-47d4-abb8-7709caaeba1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70c7e3d156e2ec222b05a9891036f5a3 3x"}, "body": "南朱音様初めまして！\n個人勢Vtuberをしております猫川ちぃと申します。\n以前skebで南様のイラストと出会い一目惚れしました、今回Xで受け付けを再開したとお見かけして「逃すわけにはいかない！」と思いご依頼させていただきました.ᐟ\n\nイラストについて：構図、ポーズ、表情、お洋服など全てお任せでお願いいたします！\n南様の色使いや世界観、デザインがとっても大好きなので、お洋服は南様の思うように描いていただきたいです。\n表情は喜怒哀楽どれでも問題ございません！\n使用用途の都合上、耳や髪などが見切れないようにしていただけますと大変嬉しいです🙇🏻\n\n使用用途：収益化済みYouTubeチャンネルでのサムネ、Xなどでの使用となります。\n（グッズを作成しての販売はいたしません）\n南様から使用に関しての条件などがございましたら別レイヤー等に記載いただきますと幸いです。\n\n以上となります。\n条件に合わない場合は遠慮なくキャンセルいただいて問題ございません…！\nご検討のほどよろしくお願いいたします。\n\nhttps://x.com/NekokawaChi/status/1725855505619562878", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_nemuinechan_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2581646, "client_id": 3160336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=714f4eb15142e12c5ad218480c24be23", "srcset": "https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=714f4eb15142e12c5ad218480c24be23, https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63afb2000f7a6141713a13f3c4bf3b23 2x, https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06582975b69aeb997c156ecca7ae5cbb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad43c85c4433fd2c668bf3ff608de608", "srcset": "https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad43c85c4433fd2c668bf3ff608de608, https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7eecbe9d8b6209a1400b6b611f19908d 2x, https://si.imgix.net/14056cce/uploads/origins/e2c744fa-1acb-45e4-9549-300e7260eb97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=671ff9dd75b3021b5801d39731a0d40f 3x"}, "body": "おぎた・廣川のYoutubeから来ました。\n南朱音さんのマイキャラちゃんやノクチルの絵がかわいらしく大変気に入っております。\nskebを募集されていたのでご依頼申し上げます。\n\n声優の厚木那奈美(参考*1, 2)さんを描いてください。\n以前のノイミーちゃんの絵のように特徴を捉えたデフォルメでお願いします。\n\nノクチルFAのようなパステルポップな絵柄が大好きです(参考*3, 4)。\nそのような色使いをしてもらえると喜びます。\n\nその他要望\n・全身絵\n・ポーズおまかせ\n・ヘアアレンジはゆるふわハーフアップ（参考*5）、リボン大きめor多めだとかわいいなと思います。\n・洋服もおまかせしますが、靴は厚底でお願いします。\n・背景の余白にリンゴ、マスカット、ブドウ、アスパラ、野沢菜、えのき、まいたけ、ぶなしめじなど、厚木那奈美さんの出身地の長野県と関連性がある物が描かれていると嬉しいです。\n・背景ありと背景なし透過素材の2パターンのファイルを作ってください。\n\n厚木那奈美さんの特徴\n・骨ストブルベ夏か秋\n・どことなく漂う気品\n・特別天然記念物\n・長野の奇跡（と呼ばれている）\n・誰にでも優しい、争いと無縁\n\n用途\n・厚木那奈美さんのファンアートとしてSNSで公開します。\n・公開の際に「厚木那奈美さんの配信でのサムネイル使用可」の旨併記する予定です。\n\nご検討のほどよろしくお願いいたします。\n\n\n参考URL\n*1 https://www.youtube.com/@atsugi_nanamichan \n*2 https://twitter.com/nanami_7mm \n*3 https://twitter.com/_nemuinechan_/status/1856694348605513936 \n*4 https://twitter.com/_nemuinechan_/status/1805260466106860033 \n*5 https://live.nicovideo.jp/watch/lv346723781 \n\n\n初対面の人はちょっと怖く感じるくらいのクールな顔面が破顔一笑したときの愛らしさがたまらなくかわいいんですよ、厚木那奈美さんの魅力のひとつです。 - あるめりあ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_nemuinechan_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2581646, "client_id": 2668577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddf74a13/uploads/origins/0f5d9a29-9f1b-4668-b232-ecd631899c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=313708ec7ddb04da592919a1c6ed7a08", "srcset": "https://si.imgix.net/ddf74a13/uploads/origins/0f5d9a29-9f1b-4668-b232-ecd631899c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=313708ec7ddb04da592919a1c6ed7a08, https://si.imgix.net/ddf74a13/uploads/origins/0f5d9a29-9f1b-4668-b232-ecd631899c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81f5beb65a665e1bc67de25952795351 2x, https://si.imgix.net/ddf74a13/uploads/origins/0f5d9a29-9f1b-4668-b232-ecd631899c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3aeaba9c3a5bac555ef1801946bbdf8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddf74a13/uploads/origins/0f5d9a29-9f1b-4668-b232-ecd631899c34?bg=%23fff&auto=format%2Ccompress&fm=