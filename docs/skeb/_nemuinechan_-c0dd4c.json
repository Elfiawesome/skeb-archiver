1b482e92a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7138d22ae18869a4b7b51a884af81473 2x, https://si.imgix.net/ac88a796/uploads/origins/97edb2a0-b398-4973-ba9c-d8b1b482e92a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fa9c25aa82755f0d9547539957a9425 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac88a796/uploads/origins/97edb2a0-b398-4973-ba9c-d8b1b482e92a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15ce882213e4d63d0cf52bc19b94b1d4", "srcset": "https://si.imgix.net/ac88a796/uploads/origins/97edb2a0-b398-4973-ba9c-d8b1b482e92a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15ce882213e4d63d0cf52bc19b94b1d4, https://si.imgix.net/ac88a796/uploads/origins/97edb2a0-b398-4973-ba9c-d8b1b482e92a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ebe5607833e9bebeae5a260de69a1b3 2x, https://si.imgix.net/ac88a796/uploads/origins/97edb2a0-b398-4973-ba9c-d8b1b482e92a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=541bb282a9c46ec88dec0aff19a1dcc9 3x"}, "body": "はじめまして。南朱音さんのレトロでドーリーなかわいらしいイラストをいつも楽しく拝見しております。この度は私のOCを描いていただきたいと思います。用途は個人観賞を想定しております。\n\n内容\n綾瀬愛莉という少しツンデレな女の子です。\n\n資料　\n①https://drive.google.com/file/d/1cy5JbSuxG9eQhGf-q4B1Xe0SGafuppcJ/view?usp=drive_link\n②https://drive.google.com/file/d/1CyH4hGyPuGUbuaXjgUttM3VJW14HDqPT/view?usp=sharing\n③https://drive.google.com/file/d/1-YRHazw_z--FzttaqEww2reouFHJyF2l/view?usp=drive_link\n④https://drive.google.com/file/d/1zw47ayeeL4o_9nulv2NJ3QYkjF8FCl25/view?usp=sharing\n\n構図の指定\n・通常の頭身で、スカートまでを描いていただきたいです。金額に見合わなければデフォルメ調でも構いません。\n・①の制服を着せていただきたいです。上着のボタンは線画の色に合わせていただくか、上着部分より暗い青色でお願いします。\n・表情は真顔でお願いします。こちらのイラストが顔の作画のイメージが近いので寄せていただければ幸いです。\nhttps://twitter.com/_nemuinechan_/status/1664225805885652993?s=20\nhttps://twitter.com/_nemuinechan_/status/1617472547007901696?s=20\n・可能であれば④のカギ（一般的な鍵のサイズ）の持ち手を持ったポーズでお願いしたいです。③では首にかかっていますが首ひもは必要ありません。金額に見合わなければ①か②のようなポーズでお願いします。\n・塗りはこちらのイラストのものが好きなので可能であればお願いしたいですが、金額に見合う範囲で構いません。\nhttps://twitter.com/_nemuinechan_/status/1626166786529062913?s=20\n\n指定が多くなってしまい申し訳ありませんが、金額に見合う範囲で描いていただければ幸いです。ご検討のほどよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_nemuinechan_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2581646, "client_id": 1396648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11b6783a2d37496b788c614bf818ba22", "srcset": "https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11b6783a2d37496b788c614bf818ba22, https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b90157600197a57251172fe7a2793bb 2x, https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80dfa177820a17cf7b240368b175e205 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c13a2341979175e95dc177e4657aba8d", "srcset": "https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c13a2341979175e95dc177e4657aba8d, https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed4fd752bd6d4a054f6d5478d14ab7ee 2x, https://si.imgix.net/6b27d8fb/uploads/origins/2b73e818-34f0-45b8-9fd3-30371fbb2af9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3314ef889f676a12e9901d6f4d28b45c 3x"}, "body": "はじめまして。\n個人vtuberとして活動している、朝久間もにと申します🧸🩵\nTwitterでとても可愛いイラストを拝見しました！\nもしよければ私のイラストも描いて頂きたいです…！\n以下簡単な要望になります。\n\n☆配信のサムネイルやTwitterで使用予定です。\n髪や衣装の上部、左右が切れてないと嬉しいです。\n☆参考URL（https://twitter.com/asakuma_morning/status/1639039811817439233?s=46&t=C_fnMnCLtV7ngGyq1NEimQ）\nどの髪型でも大丈夫です！左目側に涙ぼくろがあるので、涙ぼくろも描いてくださると嬉しいです。\n⭐︎衣装ですが、南朱音さんのロリータイラストが好きなので　水色×白のロリータ衣装で描いてくださると嬉しいです！構図や表情はお任せします。\n☆背景を描いて頂ける場合は人物と背景レイヤーを分けてくださると嬉しいです。\n\n宜しくお願い致します…！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_nemuinechan_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2581646, "client_id": 2279334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0e86222da80cc6f67151f5bee77dd45", "srcset": "https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0e86222da80cc6f67151f5bee77dd45, https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=755316eac2b4824e4259a64cbf446a30 2x, https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa241871325df59bd8428f96eba91d40 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be92edfd030c0e2e8f5ccf2f3ee87321", "srcset": "https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be92edfd030c0e2e8f5ccf2f3ee87321, https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39d4dcac5de016ed8e0b6dbfc56a1fda 2x, https://si.imgix.net/5bde47a6/uploads/origins/3837fcdc-a916-46dc-877b-6ecd79bc5b15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc3b226071550e1298c8df8d558ae790 3x"}, "body": "はじめまして、羽咲まなむと申します🐇🌸\n普段は趣味でイラストを描いています✎☡\nまた、ほかの方が描くうちの子が見たい！という気持ちから、いろいろな方にイラストを依頼してうちの子を描いていただき、それを眺めることを楽しみにしています🥰\n\n以前Twitterで南朱音さんのイラストを見かけて一目惚れしてからずっと、このかわいい絵柄でいつかうちの子も描いていただきたい！と思っておりました😳\n今回セールをしてくださるとのことで、お言葉に甘えてこのタイミングでリクエストさせていただきます🌱\n\n【うちの子について】\nうさぎモチーフの、元気で明るく素直な女の子です‪- ̗̀ ꪔ̤  ̖́-‬  ほんのりイースターモチーフでもあります🐣\n普段はいつも笑顔でおしゃべりな甘え上手です🌸でも、すごく悲しいことや嬉しいことがあるとなにも言葉が出てこなくなり代わりに涙が溢れてしまいます。ちゃんと言葉で言えるようになるために、毎日いろんな人とおしゃべりしています📣\n要素：うさぎ、イースター、花、リボン\n\n【内容】\nねねちちゃんの、雑誌表紙風の寝転がってテディベアを持っているイラストが特にすきで……！このようなお人形ぽさ？のある雰囲気の、小物が散りばめられたイラストですととてもうれしいです(*ˊˋ*)\n細かい部分はおまかせいたします！南朱音さんの描くイラストがどれも本当にだいすきなので、南朱音さんが思うように、好きなように描いていただけたらと思います🌷\nまた、デザインセンスもだいだいだいすきで……！ちょっとレトロで華やかなお衣装たちにいつも惚れ惚れしております🎀🩷ですので、可能であれば衣装デザインやヘアアレンジ等もお願いしたいです✨難しければ参考資料内の衣装どちらでも大丈夫です❣️\n\n【使用用途】\n個人鑑賞、キャラクター紹介としてSNS等に掲載\n\n【その他】\n人物のみの透過イラストもいただけるとうれしいです！\n\nよろしくお願いいたします🥰\n\nhttps://drive.google.com/drive/folders/1-BwcCbkdw1pktgeVgXQX0e5HJ1wyYBeg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 361980, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もちょえる", "screen_name": "MTL_ooo",