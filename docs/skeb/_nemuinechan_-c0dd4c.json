字(🍤)をどこかに(絵文字は1つだけ)散りばめ？ていただきたいです。\nぬいぐるみなのですが、版権が難しい場合はこちらの内容は無視していただけたらと思います。\n\nぬいぐるみ参考URL\nhttps://x.com/_t_a_g__37/status/1730220024848171390?s=46&t=cGrW27qBQ1s678o6xi8MfQ\n\n\n使用用途\n個人鑑賞用、旧Twitter\"X\"にてアイコン使用など\n\nとっても語彙が乏しく説明になっていないとは思いますがもしよろしければ嗅いていただけたらと思います…！よろしくお願いします…！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_nemuinechan_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2581646, "client_id": 3016779, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70f6df55/uploads/origins/841386ba-3cb2-4620-bd96-00925d36976a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67e97c6cb3f183521a62d077d7d1388b", "srcset": "https://si.imgix.net/70f6df55/uploads/origins/841386ba-3cb2-4620-bd96-00925d36976a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67e97c6cb3f183521a62d077d7d1388b, https://si.imgix.net/70f6df55/uploads/origins/841386ba-3cb2-4620-bd96-00925d36976a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73e078a20db8ecf27b124a88c6107786 2x, https://si.imgix.net/70f6df55/uploads/origins/841386ba-3cb2-4620-bd96-00925d36976a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e8301526c6aeb74aad4d5b258795ab2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70f6df55/uploads/origins/841386ba-3cb2-4620-bd96-00925d36976a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4d2f0796791974871dc09bbc43f9c0", "srcset": "https://si.imgix.net/70f6df55/uploads/origins/841386ba-3cb2-4620-bd96-00925d36976a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4d2f0796791974871dc09bbc43f9c0, https://si.imgix.net/70f6df55/uploads/origins/841386ba-3cb2-4620-bd96-00925d36976a?bg=%23fff&auto=format%2C