e\u3059\u3068\u8a00\u3063\u3066\u80a1\u9593\u306b\u9854\u3092\u3046\u3081\u3066\u8863\u88c5\u8d8a\u3057\u306b\u6027\u5668\u306b\u8efd\u304f\u30ad\u30b9\u3092\u3059\u308b\n\u54b2\u591c\u304c\u5c11\u3057\u7b11\u3063\u3066\u7acb\u3061\u4e0a\u304c\u308a,\u7aff\u5f79\u3092\u8208\u596e\u3055\u305b\u3088\u3046\u3068\u8003\u3048\u305f\u65b9\u6cd5\u3092\u5b9f\u884c\u3057\u3088\u3046\u3068\u3059\u308b\n\u30a8\u30c3\u30c1\u3092\u3057\u3066\u304f\u308c\u308b\u304a\u793c\u3092\u3059\u308b\u3068\u8a00\u3063\u3066\u7aff\u5f79\u3092\u7acb\u305f\u305b\u308b\n\u7aff\u5f79\u306e\u524d\u306b\u7acb\u3063\u3066\u7247\u624b\u3067\u30a8\u30d7\u30ed\u30f3\u3092\u305f\u304f\u3057\u4e0a\u3052\u3066\u9f20\u5f84\u90e8\u306e\u8863\u88c5\u3092\u9732\u51fa\u3055\u305b,\u7247\u624b\u3067\u534a\u5206\u7a0b\u52c3\u8d77\u3057\u305f\u7aff\u3092\u512a\u3057\u304f\u624b\u306b\u53d6\u308b\n\u559c\u3093\u3067\u304f\u308c\u308b\u3068\u3046\u308c\u3057\u3044\u3068\u8a00\u3063\u3066,\u307e\u3060\u3042\u307e\u308a\u786c\u304f\u306a\u3063\u3066\u306a\u3044\u7aff\u306e\u4e80\u982d\u306e\u88cf\u7b4b\u90e8\u5206\u3092\u9f20\u5f84\u90e8\u306e\u8863\u88c5\u306b\u64e6\u308a\u3064\u3051\u308b\n\u7aff\u3092\u4e0a\u4e0b\u3055\u305b\u3066,\u8863\u88c5\u306e\u9f20\u5f84\u90e8\u304b\u3089\u6027\u5668\u306e\u9593\u306b\u88cf\u7b4b\u3092\u64e6\u308a\u3064\u3051\u308b(\u7aff\u5f79\u306b\u633f\u5165\u3057\u305f\u304f\u306a\u3063\u305f\u3089\u80a1\u5e03\u3092\u305a\u3089\u3057\u3066\u5408\u56f3\u3059\u308b\u3088\u3046\u306b\u8a00\u3046)\n\u54b2\u591c\u304c\u5de6\u53f3\u306b\u7acb\u3061\u4f4d\u7f6e\u3092\u5909\u3048\u3066\u4e80\u982d\u306e\u5de6\u53f3\u5074\u9762\u3082\u8863\u88c5\u306b\u64e6\u308a\u3064\u3051\u3066\u523a\u6fc0\u3059\u308b\n\u5c04\u7cbe\u5f8c\u3067\u4f59\u88d5\u304c\u306a\u3051\u308c\u3070\u3059\u3050\u306b\u5c04\u7cbe\u3057\u3066\u3057\u307e\u3044\u305d\u3046\u306a\u5149\u666f\u3068\u4e80\u982d\u3078\u306e\u523a\u6fc0\u3067\u6025\u901f\u306b\u52c3\u8d77\u3059\u308b\n\u307b\u307c\u5b8c\u5168\u306b\u52c3\u8d77\u3059\u308b\u3068,\u4e0a\u306b\u5411\u3044\u305f\u7aff\u3092\u5de6\u53f3\u306b\u52d5\u304b\u3057\u3066\u9f20\u5f84\u90e8\u306e\u8863\u88c5\u306b\u88cf\u7b4b\u3092\u64e6\u308a\u3064\u3051\u308b(\u6211\u6162\u6c41\u304c\u4ed8\u304b\u306a\u3044\u3088\u3046\u306b\u5148\u7aef\u306f\u907f\u3051\u308b)\n\u6570\u5206\u9593\u54b2\u591c\u306b\u8863\u88c5\u3067\u4e80\u982d\u3092\u8cac\u3081\u3089\u308c\u305f\u5f8c,\u80a1\u5e03\u3092\u305a\u3089\u3057\u3066\u633f\u5165\u3092\u8981\u6c42\u3059\u308b\n\u54b2\u591c\u304c\u7aff\u3092\u9f20\u5f84\u90e8\u306e\u8863\u88c5\u304b\u3089\u808c\u306b\u64e6\u308a\u3064\u3051\u306a\u304c\u3089\u6027\u5668\u306b\u5c0e\u304f\n\n\u672c\u756a2\u56de\u76ee\n\u5148\u7aef\u3092\u6027\u5668\u306b\u5c11\u3057\u5165\u308c\u308b\n\u534a\u5206\u7a0b\u633f\u5165\u3057\u3066,\u7aff\u5f79\u306e\u8170\u3092\u3064\u304b\u3093\u3067\u7aff\u3092\u81a3\u306e\u5965\u307e\u3067\u62bc\u3057\u8fbc\u3080\n\u633f\u5165\u3057\u3066\u3059\u3050\u306b\u81a3\u304c\u7d61\u307f\u3064\u304d\u3068\u7de0\u3081\u4ed8\u3051\u3092\u59cb\u3081\u308b\n\u62b1\u304d\u5408\u3063\u3066\u30ad\u30b9(\u81a3\u3068\u820c\u3067\u7aff\u5f79\u3092\u5473\u308f\u3046)\n\u8863\u88c5\u8d8a\u3057\u306b\u54b2\u591c\u306e\u80cc\u4e2d,\u304a\u5c3b\u3092\u611b\u64ab\n\u4f55\u5ea6\u5c04\u7cbe\u3057\u3066\u3082\u3044\u3044\u304b\u3089\u7aff\u5f79\u306e\u30da\u30fc\u30b9\u3067\u597d\u304d\u306a\u3060\u3051\u30d4\u30b9\u30c8\u30f3\u3092\u3057\u3066\u307b\u3057\u3044\u3068\u8981\u6c42\n\u62b1\u304d\u5408\u3063\u305f\u307e\u307e\u77ed\u3044\u30b9\u30c8\u30ed\u30fc\u30af\u3067\u3086\u3063\u304f\u308a\u8170\u3092\u52d5\u304b\u3059\n\u8170\u306e\u52d5\u304d\u304c\u901f\u304f\u306a\u3063\u3066\u7aff\u5f79\u304c\u54b2\u591c\u3092\u62b1\u304d\u3057\u3081\u3066\u5c04\u7cbe\u3092\u3059\u308b\n\u5c0f\u523b\u307f\u306b\u30d4\u30b9\u30c8\u30f3\u3092\u3057\u3066\u5c04\u7cbe\u3092\u7d42\u3048\u308b\u3068,\u54b2\u591c\u304c\u7aff\u5f79\u306b\u30ad\u30b9\u3092\u3057\u3066\u7e4b\u304c\u3063\u305f\u307e\u307e\u5c0f\u4f11\u6b62\u3059\u308b(\u7aff\u5f79\u306f\u8863\u88c5\u8d8a\u3057\u306b\u54b2\u591c\u306e\u80cc\u4e2d,\u304a\u5c3b\u3092\u611b\u64ab)\n\u7aff\u304c\u5341\u5206\u306b\u786c\u304f\u306a\u308b\u307e\u3067\u30ad\u30b9,\u611b\u64ab,\u81a3\u3067\u7aff\u306e\u7de0\u3081\u4ed8\u3051\u3092\u7d9a\u3051\u308b\n\u305d\u306e\u5f8c\u306f\u7aff\u5f79\u306e\u52c3\u8d77\u304c\u7d9a\u304f\u307e\u3067\u30d4\u30b9\u30c8\u30f3(\u6642\u3005\u4e8c\u4eba\u3067\u7d50\u5408\u90e8\u3092\u898b\u306a\u304c\u3089)\u3092\u3055\u305b\u308b\n\u9014\u4e2d\u3067\u7aff\u5f79\u306b\u7247\u811a\u3092\u62b1\u3048\u3055\u305b\u3066,\u4e0b\u8a18\u306e\u4f53\u4f4d\u3067\u306e\u30d4\u30b9\u30c8\u30f3,\u5c04\u7cbe\u3082\u3059\u308b\nhttps://skeb.jp/@henria_yh/works/352\n\u7aff\u5f79\u304c\u5c04\u7cbe\u3059\u308b\u3068\u54b2\u591c\u304c\u7aff\u5f79\u306b\u30ad\u30b9\u3057\u3066\u7e4b\u304c\u3063\u305f\u307e\u307e\u5c0f\u4f11\u6b62\u3059\u308b\n\u5c04\u7cbe,\u7d76\u9802,\u54b2\u591c\u304c\u7aff\u5f79\u306b\u30ad\u30b9,\u7e4b\u304c\u3063\u305f\u307e\u307e\u3067\u306e\u5c0f\u4f11\u6b62\u3092\u4f55\u56de\u304b\u7e70\u308a\u8fd4\u3059(\u4f55\u5ea6\u304b\u540c\u6642\u306b\u7d76\u9802)\n\u54b2\u591c\u304c\u7d76\u9802\u3059\u308b\u3088\u308a\u3082\u7aff\u5f79\u306e\u307b\u3046\u304c\u591a\u304f\u5c04\u7cbe\u3059\u308b\n\u6700\u5f8c\u306e\u5c04\u7cbe\u304c\u7d42\u308f\u3063\u3066\u7e4b\u304c\u3063\u305f\u307e\u307e\u606f\u3092\u6574\u3048\u308b\n\u54b2\u591c\u304c\u6e80\u8db3\u3057\u305f\u611f\u3058\u3067,\u3082\u3046\u51fa\u305d\u3046\u306b\u306a\u304b\u3063\u305f\u3089\u3044\u3064\u3067\u3082\u629c\u3044\u3066\u3044\u3044\u3068\u8a00\u3046\n\u307b\u307c\u3084\u308f\u3089\u304b\u304f\u306a\u3063\u305f\u7aff\u3092\u3086\u3063\u304f\u308a\u629c\u304f\n\u7cf8\u3092\u5f15\u304d\u306a\u304c\u3089\u6027\u5668\u304b\u3089\u7aff\u3092\u96e2\u3059\n\u6027\u5668\u304b\u3089\u7cbe\u6db2\u3092\u6ef4\u308a\u843d\u3068\u3057\u306a\u304c\u3089\u7aff\u5f79\u306b\u3042\u308a\u304c\u3068\u3046\u3068\u30a8\u30c3\u30c1\u3092\u3057\u3066\u304f\u308c\u305f\u304a\u793c\u3092\u8a00\u3063\u3066\u8efd\u304f\u30ad\u30b9\n\n\u4e8b\u5f8c2\u56de\u76ee\n\u54b2\u591c\u306b\u983c\u307e\u308c\u3066\u5185\u80a1\u306b\u3064\u3044\u305f\u611b\u6db2\u3068\u6027\u5668\u304b\u3089\u51fa\u3066\u304f\u308b\u7cbe\u6db2\u3092\u62ed\u304d\u53d6\u308b\n\u304d\u308c\u3044\u306b\u3057\u305f\u5f8c,\u305a\u3089\u3057\u305f\u80a1\u5e03\u3092\u3082\u3068\u306b\u623b\u3057\u3066\u6027\u5668\u3092\u8986\u3044\u96a0\u3057\u3066\u64ab\u3067\u308b\n\u54b2\u591c\u306b\u7aff\u3092\u62ed\u3044\u3066\u3082\u3089\u3044\u30a8\u30c3\u30c1\u7d42\u4e86\n\u7aff\u5f79\u306b\u8863\u88c5\u3092\u8131\u3050\u306e\u3092\u624b\u4f1d\u308f\u305b\u308b\n\u5168\u88f8\u306b\u306a\u3063\u305f\u5f8c,\u54b2\u591c\u304c\u3044\u305f\u305a\u3089\u3063\u307d\u304f\u88cf\u306f\u3053\u3093\u306a\u611f\u3058\u3068\u8a00\u3063\u3066\u30ec\u30aa\u30bf\u30fc\u30c9\u578b\u306e\u670d\u306e\u80a1\u5e03\u306e\u88cf(\u6027\u5668\u304c\u5f53\u305f\u308b\u90e8\u5206)\u3092\u4e80\u982d\u306b\u64e6\u308a\u3064\u3051\u308b\n\u7aff\u304c\u6025\u901f\u306b\u786c\u304f\u306a\u308a,\u54b2\u591c\u304c\u304a\u3082\u3057\u308d\u304c\u3063\u3066\u80a1\u5e03\u306e\u88cf\u3067\u7aff\u3092\u5305\u3093\u3067\u63c9\u3080\n\u52c3\u8d77\u3057\u3066\u3057\u307e\u3063\u305f\u7aff\u5f79\u3092\u5ea7\u3089\u305b\u3066\u5bfe\u9762\u5ea7\u4f4d(\u4e0b\u8a18\u306e\u4f53\u4f4d)\u3067\u633f\u5165\u3057,\u8efd\u304f\u30ad\u30b9\u3092\u3057\u3066\u62b1\u304d\u7740\u3044\u305f\u307e\u307e\u8170\u3092\u52d5\u304b\u3057\u3066\u5c04\u7cbe\u3055\u305b\u308b\nhttps://skeb.jp/@tsuruyama123/works/153\n\u54b2\u591c\u306f\u7d76\u9802\u3057\u306a\u3044\u3067\u5c04\u7cbe\u304c\u5b8c\u5168\u306b\u7d42\u308f\u308b\u307e\u3067\u8170\u3092\u52d5\u304b\u3059\n\u643e\u7cbe\u3092\u7d42\u3048\u308b\u3068\u6e80\u8db3\u3057\u305f\u611f\u3058\u3067\u8efd\u304f\u30ad\u30b9\u3092\u3057\u3066,\u7aff\u3092\u629c\u3044\u3066\u7aff\u5f79\u3068\u30b7\u30e3\u30ef\u30fc\u3067\u6d17\u3044\u3042\u3046\n\u304a\u4e92\u3044\u306b\u7740\u66ff\u3048\u3