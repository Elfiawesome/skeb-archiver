8863\u88c5\u304c\u5c11\u3057\u898b\u3048\u308b\u9577\u3055\u306e\u8a2d\u5b9a\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u8863\u88c5\u306e\u80f8\u90e8\u5206\u306f\u4e73\u9996\u304c\u6d6e\u304d\u51fa\u306a\u3044\u8a2d\u5b9a\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u80a1\u9593\u90e8\u5206\u306f\u6027\u5668\u304c\u6d6e\u304d\u51fa\u306a\u3044,\u98df\u3044\u8fbc\u307e\u306a\u3044\u8a2d\u5b9a\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u80a1\u5e03\u304b\u3089\u6c41\u304c\u67d3\u307f\u51fa\u306a\u3044\u8a2d\u5b9a\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u54b2\u591c\u306f\u8efd\u3044\u7a0b\u5ea6\u306e\u7d76\u9802,\u7aff\u5f79\u306e\u5c04\u7cbe\u306f\u4e00\u822c\u7684\u306a\u91cf\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u54b2\u591c\u5074\u304c\u7d42\u59cb\u512a\u4f4d\u306a\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u7cbe\u6db2\u306f\u7aff\u3092\u629c\u3044\u305f\u6642\u4ee5\u5916\u306f\u5916\u306b\u51fa\u306a\u3044\u5f62\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u6fc1\u70b9\u5598\u304e,\u30aa\u30db\u58f0,\u30a2\u30d8\u306f\u7121\u3057\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u9014\u4e2d\u6570\u304b\u6240\u3067\u81a3\u5185\u306e\u72b6\u614b\u306e\u63cf\u5199\u3092\u304a\u9858\u3044\u3057\u307e\u3059\n\n\u30d7\u30ed\u30ed\u30fc\u30b0\n\u63a7\u5ba4\u3067\u7aff\u5f79\u304c\u3044\u3064\u3082\u306e\u3088\u3046\u306b\u54b2\u591c\u306e\u7740\u66ff\u3048\u3092\u624b\u4f1d\u3046\n\u4e0b\u306b\u7740\u308b\u30ec\u30aa\u30bf\u30fc\u30c9\u578b\u306e\u670d,\u30d6\u30e9\u30a6\u30b9,\u30d9\u30b9\u30c8,\u30d6\u30fc\u30c4\u7b49\u306e\u624b\u8db3\u306e\u88c5\u5099,\u30a8\u30d7\u30ed\u30f3\u3092\u54b2\u591c\u306b\u6e21\u3059\n\u7f8e\u3057\u3044\u88f8\u306e\u54b2\u591c\u304c\u5f90\u3005\u306b\u8863\u88c5\u59ff\u306b\u306a\u3063\u3066\u3044\u304f\u69d8\u5b50\u3092\u96c6\u4e2d\u3057\u3066\u898b\u308b\n\u7740\u66ff\u3048\u7d42\u308f\u3063\u305f\u54b2\u591c\u306f\u3059\u3050\u306b\u8a66\u5408\u306b\u5411\u304b\u3044,\u623b\u308b\u3068\u3059\u3050\u306b\u8863\u88c5\u3092\u8131\u3044\u3067\u3057\u307e\u3046\u305b\u3044\u3067\u8863\u88c5\u59ff\u306f\u898b\u308c\u308b\u6642\u9593\u304c\u5c11\u306a\u3044\n\u54b2\u591c\u306e\u8a66\u5408\u5f8c\u306e\u697d\u3057\u307f(\u30a8\u30c3\u30c1)\u306b\u5099\u3048\u3066,\u30ec\u30aa\u30bf\u30fc\u30c9\u578b\u306e\u670d\u306e\u611f\u89e6\u3068\u54b2\u591c\u306e\u8863\u88c5\u59ff\u3092\u601d\u3044\u51fa\u3057\u3066\u8208\u596e\u3057\u306a\u304c\u3089\u54b2\u591c\u3092\u5f85\u3064\n\u8863\u88c5\u3092\u7740\u305f\u307e\u307e\u3067\u30a8\u30c3\u30c1\u3092\u3055\u305b\u3066\u307b\u3057\u3044\u304c,\u8e0f\u307f\u51fa\u305b\u306a\u3044\u3067\u3044\u308b\n\u7aff\u5f79\u304c\u4eca\u65e5\u3053\u305d\u304a\u9858\u3044\u3057\u3066\u307f\u3088\u3046\u3068\u6c7a\u610f\u3059\u308b\n\n\u4e8b\u524d\n\u63a7\u5ba4\u3067\u7aff\u5f79\u304c\u5168\u88f8\u3067\u5f85\u6a5f\n\u8a66\u5408\u5f8c\u306e\u54b2\u591c\u304c\u6765\u3066,\u3044\u3064\u3082\u306e\u3088\u3046\u306b\u7aff\u5f79\u306b\u8a66\u5408\u5f8c\u306e\u697d\u3057\u307f(\u30a8\u30c3\u30c1)\u3092\u983c\u3080\n\u7aff\u5f79\u306f\u30a8\u30d7\u30ed\u30f3\u90e8\u5206\u306e\u4e0b\u304b\u3089\u5c11\u3057\u8997\u3044\u3066\u308b\u80a1\u9593\u306e\u8863\u88c5\u306b\u76ee\u3092\u596a\u308f\u308c\u3066\u308b\n\u8863\u88c5\u3092\u8131\u3054\u3046\u3068\u3059\u308b\u54b2\u591c\u306b,\u7aff\u5f79\u304c\u52c7\u6c17\u3092\u51fa\u3057\u3066\u7740\u305f\u307e\u307e\u3067\u3055\u305b\u3066\u307b\u3057\u3044\u3068\u983c\u3080\n\u81ea\u8eab\u306e\u80a1\u9593\u3092\u898b\u3066\u305a\u3089\u305b\u3070\u3067\u304d\u308b\u304b\u3068\u5c11\u3057\u306e\u9593\u8003\u3048\u305f\u5f8c,\u8863\u88c5\u3092\u3042\u307e\u308a\u6c5a\u3055\u306a\u3044\u3068\u3044\u3046\u6761\u4ef6\u3067\u627f\u8afe\u3059\u308b\n\u3044\u3064\u3082\u3088\u308a\u8208\u596e\u3057\u3066\u308b\u7aff\u5f79\u306b\u633f\u5165\u307e\u3067\u5c04\u7cbe\u3057\u306a\u3044\u3088\u3046\u306b\u8a00\u3046\n\u7aff\u5f79\u306e\u4e73\u9996\u5468\u8fba\u3092\u6307\u5148\u3067\u304f\u3059\u3050\u308b\u3088\u3046\u306b\u64ab\u3067\u3066,\u30c7\u30a3\u30fc\u30d7\u30ad\u30b9\n\u30ad\u30b9\u4e2d\u306b\u4f53\u3092\u89e6\u3063\u3066\u3082\u3044\u3044\u3068\u8a00\u308f\u308c\u3066,\u54b2\u591c\u306e\u80cc\u4e2d\u3068\u304a\u5c3b\u3092\u611b\u64ab\u3059\u308b\n\u521d\u3081\u3066\u8863\u88c5\u59ff\u306e\u54b2\u591c\u306b\u89e6\u308c\u3066\u4e0a\u534a\u8eab\u3068\u4e0b\u534a\u8eab\u306e\u8863\u88c5\u306e\u611f\u89e6\u306e\u9055\u3044\u3092\u582a\u80fd\u3057\u3066\u3044\u308b\u3068,\u80cc\u4e2d\u3092\u6307\u5148\u3067\u304f\u3059\u3050\u308b\u3088\u3046\u306b\u64ab\u3067\u3089\u308c\u308b\n\u54b2\u591c\u306b\u633f\u5165\u524d\u306b\u4f53\u3092\u597d\u304d\u306b\u3057\u3066\u3044\u3044\u3068\u8a00\u308f\u308c\u3066,\u8863\u88c5\u59ff\u3092\u521d\u3081\u3066\u3058\u3063\u304f\u308a\u773a\u3081\u308b\n\u3057\u3083\u304c\u3093\u3067\u524d\u304b\u3089\u4e0b\u534a\u8eab\u3092\u773a\u3081\u305f\u5f8c,\u5185\u80a1\u3092\u611b\u64ab\n\u808c\u3068\u8863\u88c5\u306e\u5883\u3092\u6307\u3067\u306a\u305e\u308b\n\u80a1\u9593\u306e\u8863\u88c5\u8d8a\u3057\u306b\u6027\u5668\u306b\u305d\u3063\u3068\u89e6\u308c\u3066\u512a\u3057\u304f\u64ab\u3067\u308b\n\u3059\u3079\u3059\u3079\u3057\u305f\u54b2\u591c\u306e\u8db3\u3068\u3064\u308b\u3064\u308b\u3057\u305f\u4e0b\u534a\u8eab\u306e\u8863\u88c5\u306e\u611f\u89e6\u3092\u582a\u80fd\u3059\u308b\n\u30a8\u30d7\u30ed\u30f3\u90e8\u5206\u3092\u3081\u304f\u3063\u3066\u8863\u88c5\u8d8a\u3057\u306b\u9f20\u5f84\u90e8,\u6027\u5668\u306b\u8efd\u304f\u30ad\u30b9\n\u54b2\u591c\u306f\u611b\u64ab\u3092\u53d7\u3051\u3066\u6c17\u6301\u3061\u826f\u304f\u306a\u308a\u306a\u304c\u3089,\u7740\u305f\u307e\u307e\u3067\u3059\u308b\u306e\u3082\u3044\u3044\u304b\u3082\u3068\u601d\u3046\n\u6027\u5668\u5468\u8fba(\u9f20\u5f84\u90e8,\u6027\u5668,\u5185\u80a1)\u3092\u5922\u4e2d\u306b\u306a\u3063\u3066\u4f55\u5ea6\u3082\u89e6\u308b\n\u30a8\u30c3\u30c1\u306f\u4f55\u5ea6\u304b\u3057\u305f\u3053\u3068\u304c\u3042\u308b\u306e\u306b,\u633f\u5165\u3092\u983c\u3082\u3046\u3068\u3059\u308b\u3068\u306a\u305c\u304b\u7dca\u5f35\u3059\u308b\n\u9650\u754c\u304c\u8fd1\u3065\u3044\u3066\u633f\u5165\u3055\u305b\u3066\u307b\u3057\u3044\u3068\u983c\u3080\n\u54b2\u591c\u306b\u4f53\u4f4d\u3092\u805e\u304b\u308c\u3066\u7acb\u3061\u30d0\u30c3\u30af\u3067\u306e\u633f\u5165\u3092\u304a\u9858\u3044\u3059\u308b\u3068,\u3088\u308d\u3057\u304f\u306d\u3068\u8a00\u308f\u308c\u3066\u8efd\u304f\u30ad\u30b9\u3092\u3055\u308c\u308b\n\u7aff\u5f79\u306b\u80cc\u4e2d\u3092\u5411\u3051\u3066,(\u8db3\u3068\u304b\u58c1\u306b\u624b\u3092\u3064\u3044\u3066)\u4e0a\u534a\u8eab\u3092\u5c48\u3081\u3066\u304a\u5c3b\u3092\u7a81\u304d\u51fa\u3059\n\u8863\u88c5\u59ff\u306e\u54b2\u591c\u306e\u304a\u5c3b\u3092\u524d\u306b\u3057\u3066\u52c3\u8d77\u3057\u3066\u7acb\u3063\u3066\u308b\u3060\u3051\u3067\u5c04\u7cbe\u3057\u305d\u3046\u306a\u307b\u3069\u8208\u596e\u3059\u308b\n\u3053\u308c\u304b\u3089\u633f\u5165\u3059\u308b\u3093\u3060\u3068\u601d\u3044,\u7dca\u5f35\u3068\u8208\u596e\u3092\u3057\u306a\u304c\u3089\u304a\u5c3b\u3092\u773a\u3081\u308b\n\u8863\u88c5\u8d8a\u3057\u306b\u6027\u5668\u306b\u8efd\u304f\u30ad\u30b9\u3092\u3057\u3066\u304a\u5c3b\u306b\u89e6\u308c\u308b\n\u6211\u6162\u3067\u304d\u305a\u306b\u4e7e\u3044\u305f\u7aff\u306e\u88cf\u7b4b\u90e8\u5206\u3092\u304a\u5c3b\u306e\u8863\u88c5\u306b\u3053\u3059\u308a\u3064\u3051\u308b\u3068\u6c17\u6301\u3061\u826f\u304f\u3066\u5c04\u7cbe\u3057\u305d\u3046\u306b\u306a\u308a\u3059\u3050\u306b\u3084\u3081\u308b\n\u8208\u596e\u304c\u304a\u3055\u307e\u308b\u307e\u3067,\u5148\u7aef\u306b\u6211\u6162\u6c41\u3092\u6d6e\u304b\u3079\u305f\u7aff\u3092\u30d4\u30af\u30d4\u30af\u3055\u305b\u306a\u304c\u3089\u54b2\u591c\u306e\u8170\u3092\u3064\u304b\u3093\u3067\u5f85\u3064\n\u3084\u308a\u6b8b\u3057\u305f\u3053\u3068\u306f\u306a\u3044\u304b\u4f55\u5ea6\u3082\u8003\u3048\u308b\n\u843d\u3061\u7740\u3044\u3066\u304d\u3066,\u304a\u5c3b\u306b\u89e6\u308c\u3066\u633f\u5165\u306e\u6c7a\u5fc3\u3092\u3059\u308b\n\u540d\u6b8b\u60dc\u3057\u3080\u3088\u3046\u306b\u8863\u88c5\u8d8a\u3057\u306b\u6027\u5668\u3092\u64ab\u3067\u308b\n\u5c04\u7cbe\u3057\u305d\u3046\u306a\u307b\u3069\u8208\u596e\u3057\u306a\u304c\u3089\u80a1\u5e03\u3092\u3086\u3063\u304f\u308a\u305a\u3089\u3057\u3066\u6027\u5668\u3092\u9732\u51fa\u3055\u305b\u308b\n\u54b2\u591c\u306e\u7f8e\u3057\u3044\u6027\u5668\u306b\u898b\u3068\u308c\u305f\u5f8c,\u9650\u754c\u307e\u3067\u52c3\u8d77\u3057\u305f\u7aff\u3092\u63b4\u3080\n\n\u672c\u756a\n\u8863\u88c5\u59ff\u306e\u54b2\u591c\u306b\u633f\u5165\u3067\u304d\u308b\u306e\u306f\u3053\u308c\u304c\u6700\u521d\u3067\u6700\u5f8c\u304b\u3082\u3057\u308c\u306a\u3044\u3068\u601d\u3044,\u795e\u7d4c\u3092\u7aff\u306b\u96c6\u4e2d\u3059\u308b\n\u54b2\u591c\u306e\u304a\u5c3b\u306b\u7247\u624b\u3092\u3064\u3044\u3066,\u6211\u6162\u6c41\u304c\u6ef2\u3093\u3067\u654f\u611f\u306b\u306a\u3063\u3066\u308b\u5148\u7aef\u3092\u6027\u5668\u306b\u89e6\u308c\u308b\u76f4\u524d\u307e\u3067\u8fd1\u3065\u3051\u308b\n\u6027\u5668\u306b\u62bc\u3057\u5f53\u3066\u308b\u3068\u5148\u7aef\u306b\u67d4\u3089\u304b\u3044\u611f\u89e6\u3068\u54b2\u591c\u306e\u4f53\u6e29\u3092\u611f\u3058\u308b\n\u8170\u3092\u9032\u3081\u3066\u3044\u304f\u3068\u5148\u7aef\u304c\u6027\u5668\u306b\u57cb\u307e\u308a,\u81a3\u306b\u5165\u308a\u8fbc\u3080\n\u81a3\u306e\u30d2\u30c0\u304c\u5148\u7aef\u306b\u7d61\u307f\u3064\u3044\u3066\u5c04\u7cbe\u3055\u305b\u3088\u3046\u3068\u523a\u6fc0\u3092\u4e0e\u3048\u306a\u304c\u3089\u611b\u6db2\u3092\u5857\u308a\u4ed8\u3051\u308b\n\u71b1\u304f\u306c\u3081\u3063\u305f\u67d4\u3089\u304b\u3044\u611f\u89e6\u3092\u5148\u7aef\u3067\u611f\u3058\u3066,\u3053\u308c\u304b\u3089\u7aff\u5168\u4f53\u304c\u81a3\u306b\u5305\u307e\u308c\u308b\u3053\u3068\u3092\u671f\u5f85\u3059\u308b\n\u5c04\u7cbe\u3092\u6211\u6162\u3057\u306a\u304c\u3089\u3086\u3063\u304f\u308a\u633f\u5165\u3059\u308b\n\u4e80\u982d\u307e\u3067\u633f\u5165\u3059\u308b\u3068,\u4e21\u624b\u3067\u54b2\u591c\u306e\u8170\u3092\u3064\u304b\u3093\u3067\u8170\u3092\u62bc\u3057\u9032\u3081\u308b\n\u6027\u5668\u306b\u7aff\u5148\u7aef\u3092\u5f53\u3066\u3066\u304b\u3089\u6570\u5206\u5f8c,\u7aff\u5f79\u306e\u8170\u304c\u54b2\u591c\u306e\u304a\u5c3b\u306b\u5f53\u305f\u3063\u3066\u633f\u5165\u304c\u5b8c\u4e86\u3059\u308b\n\u5c04\u7cbe\u3092\u6211\u6162\u3057\u3066\u5c11\u3057\u3067\u3082\u9577\u304f\u7e4b\u304c\u3063\u3066\u3044\u3088\u3046\u3068\u3059\u308b\n\u4e80\u982d\u304c\u81a3\u3067\u306b\u3085\u308b\u306b\u3085\u308b\u523a\u6fc0\u3055\u308c\u3066,\u7aff\u5168\u4f53\u304c\u6642\u3005\u7de0\u3081\u4ed8\u3051\u3089\u308c\u308b\n\u5c11\u3057\u3067\u3082\u52d5\u304f\u3068\u5c04\u7cbe\u3057\u305d\u3046\u306b\u306a\u3063\u3066,\u54b2\u591c\u306e\u8170\u3092\u63b4\u3093\u3067\u8170\u3092\u304a\u5c3b\u306b\u5f37\u304f\u62bc\u3057\u4ed8\u3051\u305f\u307e\u307e\u6b62\u307e\u3063\u3066\u3044\u308b\n\u54b2\u591c\u306e\u80cc\u4e2d\u3092\u898b\u306a\u304c\u3089\u81a3\u306e\u7d61\u307f\u3064\u304d\u3068\u7de0\u3081\u4ed8\u3051\u306b\u8010\u3048\u3088\u3046\u3068\u3059\u308b\n\u80a1\u9593\u306e\u8863\u88c5\u306e\u8107\u304b\u3089\u81a3\u306b\u7aff\u304c\u5165\u308a\u8fbc\u3093\u3067\u3044\u308b\u306e\u3092\u898b\u3066\u4e00\u6c17\u306b\u8208\u596e\u3057\u3066\u3057\u307e\u3044,\u6f0f\u3089\u3059\u3088\u3046\u306b\u81a3\u306e\u5965\u3067\u5c04\u7cbe\n\u65ad\u7d9a\u7684\u306b\u5c04\u7cbe\u3057\u306a\u304c\u3089,\u8863\u88c5\u59ff\u306e\u54b2\u591c\u306e\u81a3\u306b\u5c04\u7cbe\u3057\u3066\u3044\u308b\u69d8\u5b50\u3092\u8a18\u61b6\u3057\u3088\u3046\u3068\u7d50\u5408\u90e8\u306b\u8996\u7dda\u3092\u96c6\u4e2d\u3059\u308b\n\u54b2\u591c\u306f\u7d76\u9802\u3057\u306a\u3044\u3067\u5c04\u7cbe\u306e\u611f\u89e6\u3068\u7cbe\u6db2\u306e\u71b1\u3092\u582a\u80fd\u3057\u3066,\u30d4\u30b9\u30c8\u30f3\u7121\u3057\u3067\u7aff\u5f79\u3092\u5c04\u7cbe\u3055\u305b\u305f\u3053\u3068\u306b\u6e80\u8db3\u3059\u308b\n\u7aff\u5f79\u306f\u7740\u8863\u3067\u30a8\u30c3\u30c1\u3092\u3067\u304d\u308b\u6a5f\u4f1a\u304c\u3042\u3063\u3051\u306a\u304f\u7d42\u308f\u3063\u3066\u3057\u307e\u3063\u305f\u3068\u601d\u3044,\u305b\u3081\u3066\u5168\u3066\u51fa\u305d\u3046\u3068\u8170\u3092\u5c0f\u523b\u307f\u306b\u632f\u308a\u306a\u304c\u3089\u6b8b\u308a\u306e\u5c04\u7cbe\u3092\u3059\u308b\n\u5c04\u7cbe\u304c\u5b8c\u5168\u306b\u7d42\u308f\u3063\u3066\u54b2\u591c\u306e\u8170\u3092\u63b4\u3093\u3067\u6b62\u307e\u3063\u3066\u3044\u308b\u3068,\u521d\u3081\u3066\u7740\u8863\u3067\u30a8\u30c3\u30c1\u3092\u3057\u305f\u611f\u60f3\u3092\u805e\u304b\u308c\u308b\n\u304a\u5c3b\u306e\u524d\u306b\u7acb\u3063\u3066\u308b\u3060\u3051\u3067\u5c04\u7cbe\u3057\u305d\u3046\u306a\u307b\u3069\u8208\u596e\u3057\u305f,\u901a\u5e38\u3088\u308a\u3082\u591a\u304f\u5c04\u7cbe\u3057\u3066\u3057\u307e\u3063\u305f\u3068\u7b54\u3048\u308b\u7aff\u5f79\u306b,\u6c17\u306b\u5165\u3063\u305f\u306a\u3089\u3088\u304b\u3063\u305f\u3068\u8a00\u3046\n\u54b2\u591c\u306b,\u633f\u5165\u3057\u305f\u3060\u3051\u3067\u5c04\u7cbe\u3059\u308b\u7a0b\u8208\u596e\u3057\u305f\u306e\u306f\u610f\u5916\u3060\u3063\u305f\u3051\u3069\u6c17\u306b\u5165\u3063\u305f\u306a\u3089\u3053\u306e\u307e\u307e\u7d9a\u3051\u3066\u3082\u3044\u3044\u3068\u8a00\u308f\u308c\u3066,\u3046\u308c\u3057\u305d\u3046\u306b\u518d\u6226\u3092\u304a\u9858\u3044\u3059\u308b\n\u7e4b\u304c\u3063\u305f\u307e\u307e\u7aff\u304c\u786c\u304f\u306a\u308b\u307e\u3067\u4f11\u61a9\u3055\u305b\u3066\u3082\u3089\u3046\n\u5c04\u7cbe\u5f8c\u3067\u4f59\u88d5\u304c\u3042\u308b\u7aff\u5f79\u304c\u8170\u3092\u304a\u5c3b\u306b\u64e6\u308a\u3064\u3051\u3066\u808c\u3068\u305a\u3089\u3057\u305f\u80a1\u5e03\u306e\u611f\u89e6\u3092\u582a\u80fd\u3059\u308b\n\u54b2\u591c\u306f\u7aff\u5f79\u306b\u80cc\u5f8c\u304b\u3089\u62b1\u304d\u7740\u304b\u305b\u3066\u80f8\u3092\u63c9\u307e\u305b\u308b,\u81a3\u3092\u7de0\u3081\u4ed8\u3051\u3066\u7aff\u3092\u523a\u6fc0\u3059\u308b\u7b49\u3092\u3059\u308b\n\u81a3\u306e\u4e2d\u3067\u7aff\u304c\u786c\u304f\u306a\u3063\u305f\u306e\u3092\u5bdf\u77e5\u3057\u305f\u54b2\u591c\u304c\u30d4\u30b9\u30c8\u30f3\u3092\u8981\u6c42\u3059\u308b\n\u8170\u3092\u63b4\u3093\u3067,\u81a3\u304b\u3089\u629c\u3051\u308b\u304e\u308a\u304e\u308a\u307e\u3067\u7aff\u3092\u5f15\u3044\u3066\u5965\u307e\u3067\u623b\u3059\n\u9577\u3044\u30b9\u30c8\u30ed\u30fc\u30af\u3067\u3086\u3063\u304f\u308a\u30d4\u30b9\u30c8\u30f3\u3092\u3059\u308b\n\u80a1\u9593\u306e\u8863\u88c5\u306e\u8107\u304b\u3089\u611b\u6db2\u3067\u6fe1\u308c\u305f\u7aff\u304c\u51fa\u5165\u308a\u3059\u308b\u306e\u3092\u898b\u3066,\u8208\u596e\u3057\u3066\u304f\u308b\n\u5c04\u7cbe\u3057\u305d\u3046\u306b\u306a\u308b\u3068\u52d5\u304d\u3092\u6b62\u3081\u3066\u54b2\u591c\u3092\u6c17\u6301\u3061\u3088\u304f\u3055\u305b\u3088\u3046\u3068\u3059\u308b\n\u512a\u3057\u3044\u30d4\u30b9\u30c8\u30f3\u3067\u54b2\u591c\u3082\u8208\u596e\u3057\u3066\u304d\u3066,\u7aff\u5f79\u306b\u4e00\u7dd2\u306b\u7d76\u9802\u3057\u3066\u307b\u3057\u3044\u3068\u983c\u3080\n\u54b2\u591c\u306b\u62b1\u304d\u7740\u3044\u3066,\u80f8\u3092\u63c9\u307f\u306a\u304c\u3089\u81a3\u306e\u5965\u3092\u77ed\u3044\u30b9\u30c8\u30ed\u30fc\u30af\u3067\u30d4\u30b9\u30c8\u30f3\u3059\u308b\n\u305d\u308d\u305d\u308d\u7d76\u9802\u3057\u305d\u3046\u3068\u54b2\u591c\u304c\u8a00\u3063\u3066\u304d\u3066\u30d4\u30b9\u30c8\u30f3\u3092\u901f\u304f\u3059\u308b\n\u62b1\u304d\u7740\u3044\u305f\u307e\u307e\u7aff\u5f79\u304c\u5c04\u7cbe\u3057\u3066\u3059\u3050\u306b\u54b2\u591c\u304c\u7d76\u9802\n\u8170\u3092\u5c0f\u523b\u307f\u306b\u632f\u308a\u306a\u304c\u3089\u6b8b\u308a\u306e\u5c04\u7cbe\u3092\u3059\u308b\n\u305d\u306e\u5f8c\u306f\u7aff\u5f79\u306e\u4f53\u529b\u304c\u7d9a\u304f\u307e\u3067\u4f55\u5ea6\u3082\u5c04\u7cbe\u3055\u305b\u308b\n\u54b2\u591c\u304c\u7d76\u9802\u3059\u308b\u3088\u308a\u3082\u7aff\u5f79\u306e\u307b\u3046\u304c\u591a\u304f\u5c04\u7cbe\u3059\u308b\n\u6700\u5f8c\u306e\u5c04\u7cbe\u304c\u7d42\u308f\u3063\u3066\u62b1\u304d\u7740\u3044\u3066\u7e4b\u304c\u3063\u305f\u307e\u307e\u606f\u3092\u6574\u3048\u308b\n\u8863\u88c5\u59ff\u306e\u54b2\u591c\u306e\u62b1\u304d\u5fc3\u5730\u3092\u5168\u8eab\u3067\u582a\u80fd\u3057\u3066\u8a18\u61b6\u306b\u6b8b\u305d\u3046\u3068\u3059\u308b\n\u54b2\u591c\u304c\u6e80\u8db3\u3057\u305f\u611f\u3058\u3067,\u7d42\u308f\u3063\u305f\u3089\u3044\u3064\u3067\u3082\u629c\u3044\u3066\u3044\u3044\u3068\u8a00\u3046\n\u540d\u6b8b\u60dc\u3057\u307f\u3064\u3064\uff0c\u81a3\u306e\u30d2\u30c0\u306b\u7d61\u307f\u3064\u304b\u308c\u306a\u304c\u3089\u308f\u305a\u304b\u306b\u786c\u3044\u7aff\u3092\u3086\u3063\u304f\u308a\u629c\u304f\n\u7cf8\u3092\u5f15\u304d\u306a\u304c\u3089\u7aff\u3092\u6027\u5668\u304b\u3089\u96e2\u3059\n\u6027\u5668\u304b\u3089\u7cbe\u6db2\u3092\u6ef4\u308a\u843d\u3068\u3057\u306a\u304c\u3089,\u7aff\u5f79\u306b\u3042\u308a\u304c\u3068\u3046\u3068\u8a00\u3063\u3066\u8efd\u304f\u30ad\u30b9\u3092\u3059\u308b\n\n\u4e8b\u5f8c\n\u54b2\u591c\u306b\u983c\u307e\u308c\u3066\u5185\u80a1\u306b\u3064\u3044\u305f\u611b\u6db2\u3068\u6027\u5668\u304b\u3089\u51fa\u3066\u304f\u308b\u7cbe\u6db2\u3092\u62ed\u304d\u53d6\u308b\n\u304d\u308c\u3044\u306b\u3057\u305f\u5f8c,\u305a\u3089\u3057\u305f\u80a1\u5e03\u3092\u3082\u3068\u306b\u623b\u3057\u3066\u6027\u5668\u3092\u8986\u3044\u96a0\u3057\u3066\u3053\u3063\u305d\u308a\u64ab\u3067\u308b\n\u54b2\u591c\u306b\u7aff\u3092\u62ed\u3044\u3066\u3082\u3089\u3044,\u4e8c\u4eba\u3067\u5ea7\u3063\u3066(\u6905\u5b50,\u5e8a\u306e\u3069\u3061\u3089\u3067\u3082\u3044\u3044\u3067\u3059)\u4f11\u61a9\n\u7740\u8863\u3067\u30a8\u30c3\u30c1\u3059\u308b\u306e\u306f\u5acc\u3058\u3083\u306a\u3044\u304b\u3068\u805e\u3044\u3066\u304f\u308b\u7aff\u5f79\u306b,\u8863\u88c5\u8d8a\u3057\u306e\u611b\u64ab\u304c\u6c17\u6301\u3061\u3044\u3044,\u670d\u3092\u7740\u305f\u307e\u307e\u633f\u5165\u3055\u308c\u308b\u306e\u306f\u4e0d\u601d\u8b70\u306a\u611f\u3058\u3067\u60aa\u304f\u306a\u3044\u3068\u7b54\u3048\u308b\n\u88f8\u3067\u30a8\u30c3\u30c1\u3092\u3057\u305f\u6642\u3088\u308a\u3082\u8208\u596e\u3057\u3066\u3044\u305f\u7aff\u5f79\u306b,\u3053\u306e\u8863\u88c5\u304c\u305d\u3093\u306a\u306b\u3044\u3044\u306e\u304b\u805e\u304f\n\u898b\u3066\u308b\u3068\u8208\u596e\u3057\u3066\u304f\u308b\u3051\u3069\u304b\u3063\u3053\u3044\u3044