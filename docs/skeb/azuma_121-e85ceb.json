82, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8d0dc2da8f6a0739bc8a232177950b6", "srcset": "https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8d0dc2da8f6a0739bc8a232177950b6, https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02b407093c474f9e46d7c9b2880ea783 2x, https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63a7a0490bc31f876a7a9f22526098fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d226339e6ff65cc3826f0e51833548a7", "srcset": "https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d226339e6ff65cc3826f0e51833548a7, https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f04683cbb52771a63ccf64892fbd17db 2x, https://si.imgix.net/06bf4f68/uploads/origins/01b01598-8960-469d-8da9-f7f55790f56f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32f93ac1391db45fa0bc6d81731a898a 3x"}, "body": "あずまさん、こんにちは！\nいつもお世話になっております！\nあずまさんのポップ且つ洗練されたアートスタイルや色使いが大好きです…！\nこの度、オリジナルキャラクターを描いていただきたくリクエストを送らせていただきました。\nあずまさんのskebを凄く心待ちにしていたので本当に嬉しいです……！\n\n◇OCについて\n名前：火希タカキ（ほまれ たかき）\n消火器の擬人化。\n消火器からサンプリングした音を無声子音として使用し作られたUTAU音