b\u3066\u6d3b\u52d5\u3057\u3066\u304a\u308a\u307e\u3059\u3001\u5bae\u30f6\u702c\u308a\u3093\u304b \u3068\u7533\u3057\u307e\u3059\uff01\n\nskeb\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u958b\u59cb\u3055\u308c\u305f\u3068\u4f3a\u3044\u662f\u975e\u30a4\u30e9\u30b9\u30c8\u3092\u66f8\u3044\u3066\u9802\u304d\u305f\u304f\u3054\u9023\u7d61\u3055\u305b\u3066\u9802\u304d\u307e\u3057\u305f\u3002\n\n\u30ea\u30af\u30a8\u30b9\u30c8\u5185\u5bb9\u306f\u4e0b\u8a18\u3068\u306a\u308a\u307e\u3059\u3002\n\n==========\n\u30fb\u7d0d\u54c1\u5f62\u5f0f\uff1aPSD(\u4eba\u7269\u3068\u80cc\u666f\u306f\u30ec\u30a4\u30e4\u30fc\u3092\u5206\u3051\u3066\u9802\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059)\n\u30fb\u4f7f\u7528\u7528\u9014\uff1a\u53ce\u76ca\u5316\u6e08\u307f\u306eYouTube\u3084Twitch\u306b\u3066\u914d\u4fe1\u30fb\u52d5\u753b\u30fb\u30b5\u30e0\u30cd\u30a4\u30eb\u3078\u306e\u4f7f\u7528\n\u3000SNS\u3067\u306e\u753b\u50cf\u3092\u4f7f\u7528\u3057\u3066\u306e\u6295\u7a3f\n\u3000\u30b0\u30c3\u30ba\u5236\u4f5c(\u30dd\u30b9\u30c8\u30ab\u30fc\u30c9\u30fb\u30a2\u30af\u30ea\u30eb\u30b9\u30bf\u30f3\u30c9\u30fb\u7f36\u30d0\u30c3\u30b8\u30fb\u6709\u511f\u30e1\u30f3\u30d0\u30fc\u9650\u5b9a\u5f85\u53d7\u7b49)\n\n\u3010\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u30a4\u30e9\u30b9\u30c8\u3011\n\u30fb\u81ea\u8eab\u306eVtuber\u30e2\u30c7\u30eb(\u5730\u96f7\u670dVer.)\u3092\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u3067\u3059\u3002\n\u30fb\u8863\u88c5\u306f\u306d\u3063\u3053\u69d8\u306e\u601d\u3046\u5730\u96f7\u670d\u3068\u3057\u3066\u81ea\u7531\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3044\u3066\u554f\u984c\u3042\u308a\u307e\u305b\u3093\n\u30fb\u77b3\u306e\u8272\u3068\u77b3\u306e\u4e2d\u306e\u685c(\ud83c\udf38)\u3001\u9aea\u306e\u6bdb\u5916\u5074\u306f\u8336\u9aea\u30fb\u30a4\u30f3\u30ca\u30fc\u30ab\u30e9\u30fc(\u7d2b\u301c\u8584\u30d4\u30f3\u30af\u306e\u661f\u7a7a\u67c4)\n\u3000\u203b\u9aea\u306e\u9577\u3055\u3084\u9aea\u578b\u7b49\u306f\u3054\u81ea\u7531\u306b\u30a2\u30ec\u30f3\u30b8\u3044\u305f\u3060\u304