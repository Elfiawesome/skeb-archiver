u3002\n\n\u5e0c\u671b\u5185\u5bb9 :\n\u73fe\u4ee3\u65e5\u672c\u821e\u53f0\u306e\u81ea\u5275\u4f5c\u30ad\u30e3\u30e9(\u5973\u4f53\u5316ver.)\u3092\u3001\u7b49\u8eab\u4e00\u679a\u7d75\u3067\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\uff01\n\n\u4f7f\u7528\u7528\u9014 :\n\u9451\u8cde\u30fb\u500b\u4eba\u5229\u7528(\u30b9\u30de\u30db\u306e\u58c1\u7d19\u5229\u7528\u3084\u3001\u7d19\u30fb\u30a2\u30af\u30ea\u30eb\u7b49\u306b\u5370\u5237\u3057\u3066\u90e8\u5c4b\u306b\u98fe\u308b\u7b49)\u306b\u306a\u308a\u307e\u3059\u3002\u307e\u305f\u3001SNS\u30a2\u30a4\u30b3\u30f3\u306b\u5229\u7528\u3055\u305b\u3066\u3044\u305f\u3060\u304f\u53ef\u80fd\u6027\u304c\u3054\u3056\u3044\u307e\u3059\u3002\u4f7f\u7528\u306e\u969b\u306f\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u6587\u306b\u30dd\u30d4\u30fc\u69d8\u306e\u304a\u540d\u524d\u3092\u660e\u8a18\u3044\u305f\u3057\u307e\u3059\u3002\u4ed6\u8005\u3078\u306e\u914d\u5e03\u30fb\u8ca9\u58f2\u306f\u81f4\u3057\u307e\u305b\u3093\u3002\n\u30dd\u30d4\u30fc\u69d8\u65b9\u3067\u306e\u30b5\u30f3\u30d7\u30eb\u30fb\u914d\u4fe1\u5229\u7528\u7b49\u306f\u52ff\u8ad6\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\uff01\n\n\u7d0d\u54c1\u5f62\u5f0f :\nPSD\u307e\u305f\u306fPNG\u5e0c\u671b\u3067\u3059\u3002\u753b\u50cf\u30b5\u30a4\u30ba\u306f(\u5c0f\u3055\u3059\u304e\u306a\u3044\u7a0b\u5ea6\u306b\u3066)\u6307\u5b9a\u3054\u3056\u3044\u307e\u305b\u3093\u3002\n\n\u63cf\u753b\u7bc4\u56f2\u30fb\u80cc\u666f :\n\u8170\u4e0a\u301c\u5e0c\u671b\u3067\u3059\u304c\u3001\u53ef\u80fd\u306a\u7bc4\u56f2\u3067\u554f\u984c\u3054\u3056\u3044\u307e\u305b\u3093\u3002\u80cc\u666f\u3082\u5e0c\u671b\u306a\u3057\u3067\u3059\u306e\u3067\u3001\u8af8\u3005\u304a\u597d\u304d\u306a\u5f62\u3067\u3054\u8abf\u6574\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a2d\u5b9a :\n\u9ed2\u9aea\u9ed2\u76ee(\u53b3\u683c\u306a\u30ab\u30e9\u30fc\u6307\u5b9a\u7121\u3057)\u300127\u6b73\u3001\u548c\u88c5+\u30cd\u30fc\u30d7\u30b7\u3