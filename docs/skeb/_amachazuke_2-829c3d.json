ます)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 14656, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "天日昇", "screen_name": "ten_nbr", "avatar_url": "https://pbs.twimg.com/profile_images/613295781328478209/_ywDfpQF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1058827321/1672825702/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 128}, {"id": 1611799, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "tefu", "screen_name": "eiftnr", "avatar_url": "https://pbs.twimg.com/profile_images/1667864193750691840/LbRO1G8b.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1333249438144368641/1776431182/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 8, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2739685, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "RamRomLabo（らむろむらぼ）", "screen_name": "RamRomLabo", "avatar_url": "https://pbs.twimg.com/profile_images/1883520290350940160/o-Qfc40s.jpg", "header_url": "https://pbs.twimg.com/profile_banners/917545506603020288/1737901214/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "