焼けした肌に乱れた髪。目の色は紫と赤で、目の下に2つのほくろがある。上のほくろの方が少し大きい。\n\n他人をからかったり、彼らの人生をより困難なものにするのが趣味。いくつかのバッドエンドでテレサを殺す。エデルは家事が苦手で、最悪の紅茶を入れる。\n\n彼らをどう描くかは、彼らの性格に合っていればお任せします。今までのリクエストとは違うものを希望しますが（https://skeb.jp/@Anta）。\n\n使い道：\n試合には出しません。\n\n開発ブログ(https://itch.io/devlogs)やSNSの投稿に使うかもしれません。\n\n参考\nhttps://drive.google.com/drive/folders/1a4zmb8rzSdfXdUJK8NIUDRoNQVMrq-15?usp=sharing\n\nhttps://drive.google.com/drive/folders/1nURkFqYSotKMGBfACAyqfTZloHZUO7ga?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kusitaki_0141/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3694475, "client_id": 3530106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/919a3907/uploads/origins/829844f8-7c7d-4da3-8044-2329e856278a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=367ee6572ed80a03b7867be9efc5e2ac", "srcset": "https://si.imgix.net/919a3907/uploads/origins/829844f8-7c7d-4da3-8044-2329e856278a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=367ee6572ed80a03b7867be9efc5e2ac, https://si.imgix.net/919a3907/uploads/origins/829844f8-7c7d-4da3-8044-2329e856278a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc9ce01adcda9842769dc2c5ea9ff258 2x, https://si.imgix.net/919a3907/uploads/origins/829844f8-7c7d-4da3-8044-2329e856278a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fc7818dcb0ea7e5acb6bd54e774bde2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/919a3907/uploads/origins/829844f8-7c7d-4da3-8044-2329e856278a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3204920b1706716b03e0485bc3094765", "srcset": "https://si.imgix.net/919a3907/uploads/origins/829844f8-7c7d-4da3-8044-2329e856278a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop