\u3055\u3093\u304cSkeb\u3092\u958b\u304b\u308c\u3066\u3044\u308b\u306e\u3092\u77e5\u308a\u3001\u3054\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u3053\u3046\u3068\u601d\u3063\u305f\u6b21\u7b2c\u3067\u3059\u3002\n\n\u4eca\u56de\u306f\u30aa\u30ea\u30b8\u30ca\u30eb\u306e\u30a2\u30d0\u30bf\u30fc\u30ad\u30e3\u30e9\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u3054\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\u3010\u30ad\u30e3\u30e9\u306e\u3056\u3063\u304f\u308a\u3068\u3057\u305f\u898b\u305f\u76ee\u3011\n\u30fb\u6027\u5225\uff1a\u4e2d\u6027\n\u30fb\u9aea\uff1a\u7070\u8272\u30b7\u30e7\u30fc\u30c8\u30d8\u30a2\n\u30fb\u9854\uff1a\u30cf\u30a4\u30e9\u30a4\u30c8\u7121\u30b8\u30c8\u76ee\u516b\u91cd\u6b6f(\u7247\u65b9)\n\u30fb\u670d\uff1a\u732b\u8033\u30d1\u30fc\u30ab\u30fc\n\n\u3010\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u3011\n\u30fb\u540d\u524d\uff1a\u3053\u3082\u308a\n\u30fb\u4e00\u4eba\u79f0\uff1a\u4ffa\u3001\uff08\u4eba\u524d\u3084\u656c\u8a9e\u306e\u6642\u306f\uff09\u50d5\n\u30fb\u4e8c\u4eba\u79f0\uff1a\u541b\u3001\u25cb\u25cb\u3055\u3093\uff08\u53e3\u8abf\u304c\u8352\u308c\u3066\u308b\u3068\u304d\u306f\u300c\u304a\u524d\u300d\u3068\u3044\u3046\u3053\u3068\u3082\u3042\u308b\u2026\uff1f\uff09\n\n\u5f15\u304d\u3053\u3082\u308a\u3002\u8da3\u5473\u3067\u30b2\u30fc\u30e0\u5b9f\u6cc1\u3092\u3057\u3066\u3044\u308b\u3002\u7269\u8a9e\u3084\u4eba\u306e\u611f\u60c5\u304c\u597d\u304d\u306a\u305f\u3081\u30ce\u30d9\u30eb\u30b2\u30fc\u30e0\u3092\u3088\u304f\u597d\u3093\u3067\u5b9f\u6cc1\u3057\u3066\u3044\u308b\u3002\u30db\u30e9\u30b2\u30fc\u306f\u82e6\u624b\u3067\u3088\u304f\u30d3\u30d3\u3063\u3066\u3044\u308b\u3057\u60b2\u9cf4\u3092\u4e0a\u3052\u3066\u3044\u308b\u304c\u3001\u6016\u3044\u8a71\u306f\u597d\u304d\u3002\uff08\u30b8\u30e3\u30f3\u30d7\u30b9\u30b1\u30a2\u3084\u8ffd\u3044\u304b\u3051\u3089\u308c\u308b\u8981\u7d20\u304c\u82e6\u624b\uff09\n\u4eba\u5916\u30ad\u30e3\u30e9\u304c\u597d\u304d(\u7279\u306b\u7570\u5f62\u982d)\u3067\u3001\u5b9f\u6cc1\u4e2d\u4eba\u5916\u304c\u51fa\u308b\u3068\u30c6\u30f3\u30b7\u30e7\u30f3\u304c\u4e0a\u304c\u308b\u3002\u30c7\u30b9\u30b2\u30fc\u30e0\u3082\u597d\u304d\u3002(\u5922\u306e\uff11\u3064\u306b\u30c7\u30b9\u30b2\u30fc\u30e0\u306e\u30b2\u30fc\u30e0\u30de\u30b9\u30bf\u30fc\u306b\u306a\u308a\u305f\u3044\u5922\u304c\u3042\u308b)\n\u82f1\u8a9e\u304c\u82e6\u624b\u8aac\u304c\u3042\u308a\u3001baby(\u30d9\u30a4\u30d3\u30fc)\u3092\u300c\u3070\u3073\u30fc\u300d\u3068\u8aad\u3093\u3060\u308a\u3001d\u3068b\u3092\u63cf\u304d\u9593\u9055\u3048\u3066\u5c0f\u30c6\u30b9\u30c8\u3067\uff10\u70b9\u3092\u53d6\u3063\u305f\u308a\u3057\u305f\u3053\u3068\u304c\u3042\u308b\u3002\n\u30db\u30e9\u30b2\u5b9f\u6cc1\u4e2d\u306b\u300emommy(\u6bcd)\u300f\u3092\u300emoney(\u304a\u91d1)\u300f\u3068\u8aad\u307f\u300c\u30de\u30cb\u30fc\uff1f\u4f55\u3067\u3053\u3053\u3067\u304a\u91d1\uff1f\u300d\u3068\u306a\u3063\u305f\u3053\u3068\u304c\u3042\u308b\u3002\n\n\uff08\u57fa\u672c\u306f\u6f2b\u753b\u5f62\u5f0f\u3067\u7d0d\u54c1\u3055\u308c\u308b\u3068\u306e\u3053\u3068\u306a\u306e\u3067\u3001\u4e00\u5fdc\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u3092\u66f8\u3044\u3066\u306f\u307f\u305f\u306e\u3067\u3059\u304c\u4f55\u3092\u3069\u3046\u66f8\u3051\u3070\u3044\u3044\u306e\u304b\u308f\u304b\u3089\u305a\u2026\u3042\u307e\u308a\u5f79\u306b\u7acb\u305f\u306a\u3044\u304b\u3082\u3057\u308c\u306a\u3044\u3067\u3059\u3059\u307f\u307e\u305b\u3093\u2026\u3002\uff09\n\n\u53ef\u80fd\u3067\u3042\u308c\u3070\u6f2b\u753b\u5f62\u5f0f\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u304c\u3001\u53b3\u3057\u305d\u3046\u3067\u3042\u308c\u3070\u4e00\u679a\u7d75\u306e\u30a4\u30e9\u30b9\u30c8\u3067\u3082\u5927\u4e08\u592b\u3067\u3059\u3002\n\n\u307e\u305f\u3001\u306d\u3053(\u8cc7\u6599\uff11\u679a\u76ee\u3068\uff13\u679a\u76ee\u306b\u3044\u307e\u3059)\u3082\u3044\u308b\u3068\u3068\u3066\u3082\u5b09\u3057\u3044\u3067\u3059\u3002\n(\u306d\u3053\u306e\u8cc7\u6599\u306b\u3064\u3044\u3066\u306f\u3053\u3061\u3089\u306e\u30a4\u30e9\u30b9\u30c8\u3