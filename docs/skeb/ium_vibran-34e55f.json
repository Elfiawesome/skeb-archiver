ss&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3498ab4567346e87bba37dcec6cf30d8 2x, https://si.imgix.net/f453c80c/uploads/origins/9de429da-f8c7-4f7f-9129-87c9a8c1db0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e11309773958cd4d0c5f4268353fed0d 3x"}, "body": "アイマスの北沢志保がショタ4人に輪姦されているイラストをお願いします。\n\n志保\n・胸は頭と同じくらいのサイズの爆乳。\n・既に長時間犯され続けていた様子で、胸からは母乳を垂れ流しながらぐったりと布団やベッドに仰向けになったままショタに弄ばれ続けている。\n・胸の間にはショタ達が乳内射精した精液が溜まっていて、腹や太ももにも精液がぶっかけられている。\n\nショタ\n・全員顔なしでペニス小さめ\n① 横から志保の胸に吸い付いて母乳を飲んでいる。\n② ショタ①とは反対側の胸を揉んで母乳を搾り出しながら乳首にペニスを擦り付けている。\n③ 中出ししようと正常位で激しく突いている。\n④ 志保の顔の横で力の抜けた志保の手に自分のペニスを握らせ、無理矢理手コキさせて顔射しようとしている。\n\nまた、レイヤー分け等でショタ達に射精されて志保が絶頂して噴乳する差分、事後差分をお願いしたいです。\n構図の関係等で描くのが難しいと思われた要素は変更などしていただいて構いません。よろしくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ium_vibran/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 175426, "client_id": 31656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf1e7a2d/requests/210626_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e10b1bf4bdb655738ca93ea23d47441", "srcset": "https://si.imgix.net/cf1e7a2d/requests/210626_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e10b1bf4bdb655738ca93ea23d47441, https://si.imgix.net/cf1e7a2d/requests/210626_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c541f1cdc17ba62fe9804338428b864 2x, https://si.imgix.net/cf1e7a2d/requests/210626_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56081e0d630b93fede3076edef1dd6b8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf1e7a2d/requests/210626_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa4f4dbe2998dde6a95d8e3d44f76b47", "srcset": "htt