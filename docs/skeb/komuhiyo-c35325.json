d7551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08b4c9477ee0d356b66596bee3c84b03", "srcset": "https://si.imgix.net/04dfcea7/uploads/origins/ea43a402-d54c-45df-a81c-ea2e9c8d7551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08b4c9477ee0d356b66596bee3c84b03, https://si.imgix.net/04dfcea7/uploads/origins/ea43a402-d54c-45df-a81c-ea2e9c8d7551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c5a38d43563012f67a1475e095b6de30 2x, https://si.imgix.net/04dfcea7/uploads/origins/ea43a402-d54c-45df-a81c-ea2e9c8d7551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c260c3f3c962a8e728cc9034502ce8 3x"}, "body": "ご無沙汰しております。また、リクエストさせて頂きたく思います。また、前回と同じく複雑なリクエストになりますがお願いしたいです。\n\n・お仕置きされるイータ。アルファに膣を責められ、ベータにイラマチオさせられる。二人とも未知の感覚に夢中で腰を振っている。\n\n・ベータに正常位で抱き締められ、普段雑に扱われる鬱憤も込めて激しく責められるイータ。アルファはバインダーにイータの資料がある事に気付き、イータの中を自分達でより徹底的に調べて上げる、自分達が調査されたのと同じだけ抱き潰すと宣言する。\n\n・仰向けで調べられるイータ。お腹にバインダーを乗せられたままアルファにハメられ、繊細な腰使いで膣内を詳らかにされる。さらに、アルファの対面にはベータが、イータの顔に跨ってイータの胸でパイズリを味わって、胸の使い心地すら調べ上げる。\n・無理が無ければですが、イータのバインダー性器解説は、膣内、アナル、胸、口、手と全身の評価を頂ければと思います。\n\n・何度も何度も、念入りに中出しされるイータ(しれっとアルファとベータもお互いをハメ比べてたら嬉しいです)。種付けプレスでコレでもかと濃縮魔力液を大量中出しされ、満身創痍の中、アルファとベータが我に返りそう甲斐甲斐しく後片付け(イータの身体を拭いたりベッド整えて寝かせてあげたり)をすると、イータにこれに懲りたら自重するようにと言いつける。\n\n・普通に起き上がって客観的な自分のデータと二人のデータ。二人の膣内構造と濃縮魔力液を手に入れられて満足のイータ。他の七陰やナンバーズ、構成員も調べようと一切反省していない。\n\n※金額的に不足でしたら再送お願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komuhiyo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3753541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8430a65bba1b8246f8c6cc6c31582f04", "srcset": "https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8430a65bba1b8246f8c6cc6c31582f04, https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f1cfa5f3d6f98d729eac7fb2496d131 2x, https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e14d7cbb614a64f1717402bc01fcf195 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f668873088019bcdb1e95e6479f9e7e4", "srcset": "https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f668873088019bcdb1e95e6479f9e7e4, https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c7ebf6f87499631b8e85d1df9570734 2x, https://si.imgix.net/3fac8907/uploads/origins/18ad732a-b261-4205-ac68-762404fbca30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6bf9a99af268868f81f4519d2d791e2 3x"}, "body": "イータ　または　ベータ　のパイズリをリクエストしたいです！\n\nパイズリのやり方としては\n\nhttps://www.pixiv.net/artworks/128271216\n\nや\n\nhttps://www.pixiv.net/artworks/107380633\n\nこちらの作品の様に、さらし、紐、スライムスーツを伸ばしたものでおっぱいをギューっと絞ってて強い乳圧で搾り取る感じ!\n\n可能なら射精差分、さきっぽに吸い付いてヂューヂュー啜り上げるものをお願い致します！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komuhiyo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3753541, "client_id": 1205407, "vtt_url": null, "t