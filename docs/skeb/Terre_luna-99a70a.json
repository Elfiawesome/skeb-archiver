": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": []}, "price_history": {"art": [{"amount": 5000, "recorded_at": 1760093875.166156}]}, "from_archive": true, "custom": {"from_archive": true, "custom": {"from_archive": true}}}