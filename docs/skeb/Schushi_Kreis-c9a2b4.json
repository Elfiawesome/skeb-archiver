025f/uploads/origins/eb434366-e25a-4369-a985-b4b573b1215b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b0a090662475764981162ef1540ad6b, https://si.imgix.net/086c025f/uploads/origins/eb434366-e25a-4369-a985-b4b573b1215b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d90ccd9e2e51a8643635168f2e45e257 2x, https://si.imgix.net/086c025f/uploads/origins/eb434366-e25a-4369-a985-b4b573b1215b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=faffc13236f5fe3fb03820fe754fec44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/086c025f/uploads/origins/eb434366-e25a-4369-a985-b4b573b1215b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5821d1f705f22e7850a486bd64c4120c", "srcset": "https://si.imgix.net/086c025f/uploads/origins/eb434366-e25a-4369-a985-b4b573b1215b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5821d1f705f22e7850a486bd64c4120c, https://si.imgix.net/086c025f/uploads/origins/eb434366-e25a-4369-a985-b4b573b1215b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8aead10cc33ccf3be6f87a23edac108a 2x, https://si.imgix.net/086c025f/uploads/origins/eb434366-e25a-4369-a985-b4b573b1215b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e917e13c150cbe9714a4c6a1c7dcdf4 3x"}, "body": "遠野終始 さま\n\nこんにちは、芹沢です。いつもお世話になっております。\nいつもながらリクエストの際に素晴らしいお作品のご納品を誠にありがとうございます。\n\n今回またぜひリクエストを一点申し込めればと思いまして、再び筆を執りました。終始さま以外の方にはもしかするとお願いの難しい内容になるかと思ったので、ぜひにと思い内容をお送りいたします。内容のご精査の方、切にお願い申し上げます。\n\nイラストの用途としましては、SNSへの掲載、個人資料、または私的範疇の鑑賞、実物印刷となります。商業方面に使用する予定は一切ございません。\n\n希望仕様の詳細は以下となります。\n■題材ですが、私が過去に運用しておりましたオリジナルキャラクター\"ゾンド\"の一枚絵カラーイラストとなります。\n以下、キャラクターのビジュアル資料など諸々情報となります。\n文章資料類は過去の活動の覚書など長いものがあるので、キャラクター造形などの重要部分以外は読み飛ばしていただいてお構いないです。\n■キャラクタービジュアル\nhttps://drive.google.com/file/d/1H9lQIFJoADnwYlSOV8XTWr0lKqntYyRj/view?usp=sharing\nhttps://drive.google.com/file/d/1pOAYR4HNgys_t8DOIXS8ULyzYDbRR7aI/view?usp=sharing\n\n■キャラクターのXアカウント（停止中）\nhttps://x.com/system_Zond\n■キャラクターの文書資料、過去の活動の個人的な覚書など\nhttps://www.pixiv.net/novel/show.php?id=11557043\n\n衣装に関しては描写のセーラー服、帽子などのベースは維持して欲しいですが、全体的にゴシック感の要素やアクセサリも盛り込んでいただければ嬉しいです。\n背景は夏感のある太陽の光の明るいリゾート地、青空と白い雲、白い砂浜と清廉な建物、などであれば助かります。\n\n手短となりましたが、希望したい要素は上記のところとなります。\nなにとぞよろしくお願い申し上げます。\n\n芹沢 時雨", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Schushi_Kreis/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 643174, "client_id": 3346715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86a3771c/uploads/origins/0680ba35-6487-4ee4-a7a4-63e6e5bc2ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea2a98bbd56a037431acee48781e10b", "srcset": "https://si.imgix.net/86a3771c/uploads/origins/0680ba35-6487-4ee4-a7a4-63e6e5bc2ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ea2a98bbd56a037431acee48781e10b, https://si.imgix.net/86a3771c/uploads/origins/0680ba35-6487-4ee4-a7a4-63e6e5bc2ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31835954391520c8709c535b5162531d 2x, https://si.imgix.net/86a3771c/uploads/origins/0680ba35-6487-4ee4-a7a4-63e6e5bc2ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c588ff3ad88e10abb44a0d0e5b1f1944 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86a3771c/uploads/origins/0680ba35-6487-4ee4-a7a4-63e6e5bc2ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0f0466125e7b01d6b33c82e60df98f", "srcset": "https://si.imgix.net/86a3771c/uploads/origins/0680ba35-6487-4ee4-a7a4-63e6e5bc2ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&