回に引き続きサトシとうちの子のイラストでお願いしたいです。\nまた、服装についても前回のskebで描いたものと同様でお願いします。\n\nまた、構図についてです。\n・絶望した表情のうちの子が、地面に両膝と両手をつけで涙を流している。\n・サトシが目線を合わせるようにしゃがみこみ、うちの子の両肩に手を置いて、苦しげ且つ奮い立たせるような表情で、うちの子の顔を覗き込む。\n・画角は2人の横髪が見えるようにお願いします。\n\n構図について長々と記載をしてしまい申し訳ありません…！\nお時間についてはいつになっても大丈夫ですし、もし難しいようでしたら、流していただいても構いません。\nお手数をお掛けしますがよろしくお願いします。\n\nまた、年の瀬で寒くなってきていますのでお身体に気をつけてお過ごし下さいませ。\n良いお年をお迎えください。\n\nhttps://skeb.jp/@kankan_no_naka/works/2", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kankan_no_naka/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/93a29cb3/uploads/origins/d5214e15-e12f-44dd-8f09-179e88fbe3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1288d2dcde76c27b09e3ccb2b166fff", "srcset": "https://si.imgix.net/93a29cb3/uploads/origins/d5214e15-e12f-44dd-8f09-179e88fbe3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1288d2dcde76c27b09e3ccb2b166fff, https://si.imgix.net/93a29cb3/uploads/origins/d5214e15-e12f-44dd-8f09-179e88fbe3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8231cc6f8318f475a6174d93686649ec 2x, https://si.imgix.net/93a29cb3/uploads/origins/d5214e15-e12f-44dd-8f09-179e88fbe3ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea5305a8deee9ed86ea5ea8f1a892753 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1199711, "client_id": 3115935, "nc": 17}, {"path": "/@kankan_no_naka/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 11