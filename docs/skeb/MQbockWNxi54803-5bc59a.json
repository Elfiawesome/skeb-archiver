以上のような内容で描いていただきたいです！\n\nまた、skebで描いていただいた旨を添えてイラストを私のXアカウントで投稿したいです。\n\n\n以上となります！ご検討いただければ幸いです🙇‍♂️", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MQbockWNxi54803/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3127878, "client_id": 1032687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a93d941063171f5ab06c5a7e5b77887b", "srcset": "https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a93d941063171f5ab06c5a7e5b77887b, https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=733a41b1d7f2f563fae3d8656a349505 2x, https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ca32fcb181457b0b040b799c8f0f06e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cca956d0de6fd3f5a619de5bdbdef159", "srcset": "https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cca956d0de6fd3f5a619de5bdbdef159, https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57461d6bed13662db0379cd3e3d87d21 2x, https://si.imgix.net/4567db93/uploads/origins/b7d33179-12ee-4e3e-a941-3cdb8dac4e9c?