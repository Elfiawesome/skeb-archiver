63aee15e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db62e0bfe259ad8c750c9c811135a731 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3934f637/uploads/origins/d3115447-1d26-4da6-9f1d-a3163aee15e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857f03b267166c40e2cdc1f2bfe9c687", "srcset": "https://si.imgix.net/3934f637/uploads/origins/d3115447-1d26-4da6-9f1d-a3163aee15e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857f03b267166c40e2cdc1f2bfe9c687, https://si.imgix.net/3934f637/uploads/origins/d3115447-1d26-4da6-9f1d-a3163aee15e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ee2e71f9798a49d3ae14730cd29655d 2x, https://si.imgix.net/3934f637/uploads/origins/d3115447-1d26-4da6-9f1d-a3163aee15e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28f3d6aa6736165d13e259dac3386360 3x"}, "body": "初めまして　ふがく様\nいつもイラスト等楽しく拝見させてもらっています。\n\nさて、今回はシャインポストの氷海菜花ちゃんのレースクイーン衣装が見てぇ～と思いリクエストさせていただきました。\n公式にレースクイーンな資料が無くて恐縮なのですが、こちらから一部イメージをお伝えします。\n\n衣装はセパレート型（トップス・ボトムスが別々）でボトムスがタイトスカートになっているものが望ましいです。\nポーズですがパラソルを持った姿でお願いしたいです。\n\nよろしくお願いします。\n\n追伸：レースクイーンについて調べていたら「ギャルズ・パラダイス」とかいうレースクイーンの雑誌があるようです。サイト内だけでも見ると参考になるかもしれません。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fugakutkt/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2713730, "client_id": 2369785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89ef1538/uploads/origins/c34bdb66-e8bf-40d3-b3f4-0032eefd8a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad3a05bfbd996b8fec331fef01ccfbaf", "srcset": "https://si.imgix.net/89ef1538/uploads/origins/c34bdb66-e8bf-40d3-b3f4-0032eefd8a19?bg=%23fff&auto=format%2Ccom