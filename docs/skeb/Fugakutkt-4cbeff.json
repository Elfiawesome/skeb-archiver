ps://si.imgix.net/98793a02/uploads/origins/3bffeb92-99ea-4550-99f3-090583877e35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d77cdb22a3cd20333fc728bbe2c7f09b, https://si.imgix.net/98793a02/uploads/origins/3bffeb92-99ea-4550-99f3-090583877e35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50fbfd7a9ed1dccd456117f1aa3d37e7 2x, https://si.imgix.net/98793a02/uploads/origins/3bffeb92-99ea-4550-99f3-090583877e35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e3d4572cd2d5f6b5fe0357e9d77ee84 3x"}, "body": "初めまして、Xにてイラストを以前から鑑賞させて頂いておりますが、\n今回イラストをリクエストしたいと思いましたので、\n可能でしたら宜しくお願い致します。\n\n■作品名\nシャインポスト\n■キャラ\n黒金蓮\n■要望\n・青天国春のぬいぐるみを大事に持って、自慢顔して立っている姿でお願いします。\n・服装は緑のSpringのパーカー着た私服姿でお願いします。\n・それ以外はお任せ致します。\n\n以上、宜しくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fugakutkt/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2713730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83a9f9b1/uploads/origins/07155cf3-ecbf-4784-847e-fe36464f5a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=413ea8df8e3c874422f36b5bc95f7e27", "srcset": "https://si.imgix.net/83a9f9b1/uploads/origins/07155cf3-ecbf-4784-847e-fe36464f5a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=413ea8df8e3c874422f36b5bc95f7e27, https://si.imgix.net/83a9f9b1/uploads/origins/07155cf3-ecbf-4784-847e-fe36464f5a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7acf2a834bebe7dfb6807f8e71b4da41 2x, https://si.imgix.net/83a9f9b1/uploads/origins/07155cf3-ecbf-4784-847e-fe36464f5a6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b3a806e712b1d53776c2fb2e9c2c034 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls"