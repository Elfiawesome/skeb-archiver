自キャラのデフォルトではありますが、他の服を描いていただくのも問題はないです！\n\n ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1cq4_h19FEzLaUg3KVRFBENxxXJ6ZkTqS?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ohage_kk/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2129127, "client_id": 1721913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfde5337/uploads/origins/af224939-73f2-4f43-97ce-a611230c8553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df32e1327a005486cf44137d989ee95", "srcset": "https://si.imgix.net/dfde5337/uploads/origins/af224939-73f2-4f43-97ce-a611230c8553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df32e1327a005486cf44137d989ee95, https://si.imgix.net/dfde5337/uploads/origins/af224939-73f2-4f43-97ce-a611230c8553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea071cd813f599a9e3a76148eded6541 2x, https://si.imgix.net/dfde5337/uploads/origins/af224939-73f2-4f43-97ce-a611230c8553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=383e44ad6b020be65f2f1ffd0a71634c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dfde5337/uploads/origins/af224939-73f2-4f43-97ce-a611230c8553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6eb82423948888ca7f1004d33bb7d44", "srcset": "https://si.imgix.net/dfde5337/uploads/origins/af224939-73f2-4f43-97ce-a611230c8553?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6eb82423948888ca7f1004d33bb7d44, https://si.imgix.net/dfde5337/uploads/origins/af224939-73f2-4f43-97ce-a611230c8553?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43ae90cadd19912d2d0e25e95d1f8f62 2x, https://si.imgix.net/dfde5337/uploads