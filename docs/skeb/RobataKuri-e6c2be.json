かったので、彼女の足フェチ漫画をお願いしたいです。\nページ数は金額を見てのご判断で大丈夫です。\n\n練習の後、ファンのモブ男子生徒が来夏ちゃんを連れ去ります。\n来夏ちゃんは制服のまま手を縛られ、男子生徒はネチネチと実況しながら靴下をわざとゆっくり脱がしていきます。\nそして、来夏ちゃんのムレムレ裸足を堪能します(嗅いだり舐めたり、足コキさせたりおまかせします)\n\n以上になります。どうぞよろしくお願いいたします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@RobataKuri/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3798376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02299b43/uploads/origins/7c5df2dc-b501-47f4-807d-0580f1b8be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=263e03760d3fb21c4edf78c5a6ad465a", "srcset": "https://si.imgix.net/02299b43/uploads/origins/7c5df2dc-b501-47f4-807d-0580f1b8be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=263e03760d3fb21c4edf78c5a6ad465a, https://si.imgix.net/02299b43/uploads/origins/7c5df2dc-b501-47f4-807d-0580f1b8be94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9bae1741c86ab07a53470a12f50a494 2x, https://si.imgix.net/02299b43/uploads/origins/7c5df2dc-b501-47f4-807d-0580f1b8be94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1494602f56e15df60cb9f93839772265 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02299b43/uploads/origins/7c5df2dc-b501-47f4-807d-0580f1b8be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=785a7f193c9c2c68f9f7e4437047a32a", "srcset": "https://si.imgix.net/02299b43/uploads/origins/7c5df2dc-b501-47f4-807d-0580f1b8be94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=785a7f193c9c2c68f9f7e4437047a32a, https://si.imgix.net/02299b43/uploads/origins/7c5df2dc-b501-47f4-807d-0580f1b8be94?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ce4dea6631100fb7254c2a706c0b4b