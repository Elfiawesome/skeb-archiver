楽に溺れており、このセックスが続けばいいと思っている\n\nこういう感じでお願いします\n\n後、ろーちゃんの日焼けの跡は、日焼けしてる部分との差を出来るだけ明確にお願いします\n\n細かいところは、お任せします。\n\nよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ootaillust18/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1846287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba507de1cd629dc2ee40fe5cd702cf16", "srcset": "https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba507de1cd629dc2ee40fe5cd702cf16, https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edabba8db4b8ee6b253430fb829de6c0 2x, https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b19930012534ebea551e040427bc6908 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=680d7fa96e7ab2cea281599f4738ed8d", "srcset": "https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=680d7fa96e7ab2cea281599f4738ed8d, https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9236795bafee6e1e0c86d0af832dc700 2x, https://si.imgix.net/5a44554b/uploads/origins/8f784b1d-fed7-4627-a5a2-1bc448f0961b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=945681fe726af01f6b179b480fa54852 3x"}, "body": "艦これの山汐丸でハードSMプレイのイラストをお願いします。カラー・モノクロどちらでもOKです。\n\n・体位はバック（立ち、四つん這い、寝バック等姿勢はお任せします）\n・山汐丸の長い三つ編みを首に巻いて、後ろから締める首絞めックス中\n・アナルに巨根を挿入されており、前の穴は使用済みで精液が垂れている\n・表情はアヘ顔半分トロ顔半分ぐらいの比率\n・陰毛は無し\n\n以上のような感じでお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ootaillust18/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1846287, "client_id": 288621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=421130cedd4d78fa872963f166005ead", "srcset": "https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=421130cedd4d78fa872963f166005ead, https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa44b01f579ecea4120a0a6b85bfbc4c 2x, https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ca9bf190831936d4add257238b08d52 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fb4cafb1d15cc2aef089290e9131b22", "srcset": "https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fb4cafb1d15cc2aef089290e9131b22, https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=407960697ff6ebe5c72df3d0a55ac33f 2x, https://si.imgix.net/0fa133a4/uploads/origins/40811b09-c03c-44c2-a7f7-b160ea6cf22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8758ac7527ee023f2f0e62aef967e24e 3x"}, "body": "リベッチオの産卵、とても素晴らしかったです\nhttps://skeb.jp/@ootaillust18/works/14\nそこで今回も、似たようなシチュエーションでリクエストしたいと思います。\n\n場所は砂浜\nキャラは、艦これのグレカーレ\n衣装は全裸\n\nシチュエーション\nグレカーレが、深海忌雷に一昼夜犯され続け、何十回とイカされ、潮も吹き、上下の口の中に射精させられ\n同時に卵を受け付けられた\nそのせいで、妊娠したようにお腹が膨らんでいる\nその後を、リクエストしたいと思います。\n\nカエルが裏返ったような感じの体勢で、全身を痙攣させながら、肩で息をしながら、絶頂の余韻に浸っているグレカーレ\n乳首もクリトリスも勃起しており、クリトリスは皮からはみ出ている\n散々犯されたせいで、膣口は閉じなくなり、精子がこぼれている\nグレカーレの腰の周りは、何度も絶頂したせいで、潮で砂浜が濡れている\n\n絶頂の余韻に浸っていると、突然、卵を産み出す（５個ほど）\n※卵の大きさは、前回のリベッチオの時と同じくらいでお願いします\n卵を産みながら、絶頂するグレカーレ。潮を吹いている\n\n５個の卵を産んで、落ち着いたかと思いきや、先ほどの卵よりも大きな卵が、膣口を無理矢理広げながら産まれようとしている\nその卵のせいで膣壁を刺激され、イキ続けるグレカーレ\n\n何とか卵を一つ産むのだが、まだ産卵が続いている\n\n結局、大きめの卵を３個産んだところで、落ち着いた\nしかし、大きく開いたグレカーレの膣口は開いたままだった\n\nこういう感じでお願いします\n細かいところは、お任せします。\nよろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ootaillust18/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1846287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b9a4bbdac32b2f343c6f0f55e5332f0", "srcset": "https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b9a4bbdac32b2f343c6f0f55e5332f0, https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16dc923bc2b72328fb3161b7a51989dd 2x, https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88c9c14e61ac38a74d04aa71d4c425c8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52e8536a91d589e441721cd0bb2b6117", "srcset": "https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52e8536a91d589e441721cd0bb2b6117, https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eba703513863b05db06029a324801dd2 2x, https://si.imgix.net/c79e7bad/uploads/origins/910321f7-b174-4b43-aad4-7ce25f956ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=defc6b37353704b2ddd9586c86ebfa94 3x"}, "body": "リベッチオありがとうございました。このまま艦これのシロッコもカラーでお願いします。\n\nベッドに仰向けで寝るシロッコが、未使用のエグいロングディルド（ローションまみれ）をお腹の上に置き、\n開発済みのヴァギナとアナル（こちらもローションまみれ）へ両手ピースをフックのように挿入、左右からぐぽっと開き、\nカメラ目線で「どっちに入れる？」みたいな感じに微笑みを浮かべるイラストでお願いします。\n\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ootaillust18/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1846287, "client_id": 288621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86e07411/uploads/origins/dd159467-f2b8-4da8-97f3-bee6399e649e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f2b94d2bc1f833291790bf63c0f4554", "srcset": "https://si.imgix.net/86e07411/uploads/origins/dd159467-f2b8-4da8-97f3-bee6399e649e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f2b94d2bc1f833291