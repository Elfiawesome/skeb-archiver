mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a261c5cbabcbc1cc12f9ed84643c5aa0 2x, https://si.imgix.net/6069a95d/uploads/origins/2eefbdde-9001-452c-a186-937e06e1ff18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80dc6916ee5242d1cb02bb4530d11709 3x"}, "body": "こんにちは！あなたの画風が大好きなので、何か絵をお願いできればと思います。アークナイツのラップランドの絵をお願いしたいです。いつもはクールな表情や怖い表情が多いので、今回はドクターにしか見せないような温かく愛くるしい表情が見たいです。ポーズは横になってドクターの胸に頭を乗せてドクターを見上げているようなポーズがいいと思います。\n\nここにキャラクターとポーズの参考写真があります： https://drive.google.com/drive/folders/1hQhKChX9tdH9ETb4xackP1yl1Hct5A-q?usp=drive_link\n\nご検討ありがとうございました。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shino_duka/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2515434, "client_id": 1917218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53db386d/uploads/origins/0309abb7-de44-427f-8119-821ece483e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f03baa73f7f586c0233c308ff68414", "srcset": "https://si.imgix.net/53db386d/uploads/origins/0309abb7-de44-427f-8119-821ece483e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0f03baa73f7f586c0233c308ff68414, https://si.imgix.net/53db386d/uploads/origins/0309abb7-de44-427f-8119-821ece483e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d8511e3db78d80f854eb4369ad0f111 2x, https://si.imgix.net/53db386d/uploads/origins/0309abb7-de44-427f-8119-821ece483e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f12dcebe6124169ce90c33ee9168d7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53db386d/uploads/origins/0309abb7-de44-427f-8119-821ece483e4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92da1aee32e417c