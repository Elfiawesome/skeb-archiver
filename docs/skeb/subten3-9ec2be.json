ーⅡのアリスギア版の資料はこちらをご覧下さい\n(https://imgur.io/a/ejM5VgC)\n\n以上が依頼内容となります。\nだいぶ無茶な依頼となってしまいますが、ご一考の程よろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@subten3/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1256816, "client_id": 811237, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e62198298203e1fb17e1ca431d7d9d3", "srcset": "https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e62198298203e1fb17e1ca431d7d9d3, https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e5ebb6f63cd4d66865b8cdb4c880b8c 2x, https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbed64668b1ffee46c55dd61422c5562 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b02925603462569ee87d3623f9d893df", "srcset": "https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b02925603462569ee87d3623f9d893df, https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42968d51e816da1ecf816632b04d49c5 2x, https://si.imgix.net/4ba12ddd/uploads/origins/53fd391c-f10f-4faf-a266-c77584a0513f