0d9/uploads/origins/7f43be8a-659a-4ffc-ae70-fea542345080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89b4bda25e7dd3334dc8fcdbd1d2e0ca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdbe90d9/uploads/origins/7f43be8a-659a-4ffc-ae70-fea542345080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45b50ebfad3163e0eb68aa254104ef04", "srcset": "https://si.imgix.net/cdbe90d9/uploads/origins/7f43be8a-659a-4ffc-ae70-fea542345080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45b50ebfad3163e0eb68aa254104ef04, https://si.imgix.net/cdbe90d9/uploads/origins/7f43be8a-659a-4ffc-ae70-fea542345080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18455093e0059e501e2fcd78070a9349 2x, https://si.imgix.net/cdbe90d9/uploads/origins/7f43be8a-659a-4ffc-ae70-fea542345080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9dfd2475847a460428e05ddd16bf8de5 3x"}, "body": "またまたこんにちは！今回は私の友人2人からのリクエストです：サイモンとトルストイだ！\n\n詳細はこちら：\nhttps://www.furaffinity.net/view/62482018/。\nサイモンとトルストイは、レイを挟むようにお腹を押し付けています。各キャラクターの表情もこの画像と同じようなものになります。\n\nシモンとトルストイの両方がおならをし、大量のガスが辺りに充満する別バージョンもあります（シモンのガスは薄緑色、トルストイのガスは濃緑色）。サイモンは恥ずかしくなり、トルストイは小悪魔的な笑みを浮かべ、レイは臭いに唖然とする。\n\n参考文献\n参考文献：レイ、サイモン、トルストイの参考文献は参考文献URLにリンクされているが、この絵で3人が着ている服は決まっている：\nレイは「服装リファレンス」にある黒のシャツを着るが、グレーの代わりに緑のボクサーパンツを履く。\nサイモンは「服装リファレンス」にある \"Slobby \"の服を着る。\nトルストイは同じ服を着る。\n\nhttps://drive.google.com/drive/folders/1fvZGkENI2uMylgT603LEDB1j_8o5B7KD?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usikuma6/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 24122, "client_id": 1165153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c5325c5/uploads/origins/2b