s=cead7ed763c727e2aeefd69d42014e15 2x, https://si.imgix.net/9d522a72/uploads/origins/d9b104ae-2d95-4735-9d9e-4cf2a34fc196?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a013537d8d0ea039167068d071595949 3x"}, "body": "灯油様\n初めまして！Rincaと申します。\nおしがまVtuberとして活動してます。（https://twitter.com/Rincamovie）\nおすすめのクリエイター紹介でされていて見つけました。\nもしよければ「Rincaちゃん（旧3Dモデル）」を描いていただければ幸いです。\n\n用途：\n・SNSでの掲載\n・収益化済みの動画サイト（YouTubeやニコニコなど）での使用/サムネイル画像\n\nキャラクター：\n狐をモチーフとしたVtuberで、大きなツインテールとふわふわのお耳、まろ眉が特徴的です。\n参考にリンクを貼らせていただきます。\n（https://drive.google.com/drive/folders/1XzWNE7ZZrznhI8VpLZ8MrcM43CcBpeUU?usp=sharing）\n\n性格：\nつるペタで生意気、意地っ張りで、おしがまが好き。\nわからせられたがりなツンデレ系狐っ子、っていう設定です。\n\n髪型や髪の色：\n大きなツインテール、シルバーよりの色\n\n目の形や色：\n大きくてぱっちりした緑色の瞳\n\n表情：\n切り抜きの内容は、「配信中に漏らしてしまって…。」というのが主なテーマになります。\n焦っているor恥ずかしくて赤面しているor「どうしよう」と困惑している等のテーマに合う表情だと切り抜きとして使いやすいです。\n\n背景：\nサムネに使用する予定なので、特に必要ありません。\n\nサイズ：\n1920ｘ1080の画面での使用を想定しています。\n\n透過：有（可能であればPSD希望）\nもし可能であれば、背景とRincaちゃんを別レイヤーに分けてあるものも、いただけると助かります。\nサムネイルなどに使用するため、頭部や耳、顔回りにかかる可能性がある部位が見切れていないようにしていただけると助かります。\n\n内容的に、厳しい場合は、気軽にキャンセル（再送）して頂いて構いません。\n何卒ご検討宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 227941, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "lil Monster（お仕事募集中）", "screen_name": "zbuta_turatan", "avatar_url": "https://pbs.twimg.com/profile_images/1944463169247948800/BVM9lUnG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1026060574042480641/1714745881/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 2552083, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鉢", "screen_name": "HAnechire8", "avatar_u