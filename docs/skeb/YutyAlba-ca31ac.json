\nココフォリアというツールにて使用するため、背景透過のpng画像を納品いただけますと幸いです。\nポーズや服装などは参考資料をご参照ください。\n立ち絵に関しては相方OCと合わせ立ち絵の予定で、相方OCの分はこちらに合わせて描いてもらう予定のためポーズ資料の右側の人物をお願いいたします。\n無理なところがあればアレンジくださっても問題ございません！\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1DoPSC52UDksVRZv70brRnaudUUclL6NQ?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YutyAlba/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3341456, "client_id": 3224973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fea78593/uploads/origins/f4c7c710-05bd-4dc3-bfdb-c06d7c59a68f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769432199b7a75a1d67ec7c42f4e182e", "srcset": "https://si.imgix.net/fea78593/uploads/origins/f4c7c710-05bd-4dc3-bfdb-c06d7c59a68f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=769432199b7a75a1d67ec7c42f4e182e, https://si.imgix.net/fea78593/uploads/origins/f4c7c710-05bd-4dc3-bfdb-c06d7c59a68f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73daec02ee5d660364cb24013c86f59d 2x, https://si.imgix.net/fea78593/uploads/origins/f4c7c710-05bd-4dc3-bfdb-c06d7c59a68f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eba24868776b9b27ba629ac3c8795055 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fea78593/uploads/origins/f4c7c710-05bd-4dc3-bfdb-c06d7c59a68f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e20ba1689e84f67392e6cc2c95253ab", "srcset": "https://si.imgix.net/fea78593/uploads/origins/f4c7c710-05bd-4dc3-bfdb-c06d7c59a68f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e20ba1689e84f67392e6cc2c95253ab, https://si.imgix.net/fea78593/uploads/origins/f4c7c710-05bd-4dc3-bfdb-c06d7c59a68f?bg=%23fff&auto=format%2Ccompres