//si.imgix.net/df9fbb6e/uploads/origins/1b0074ec-c279-4c04-9c8a-859469ca8b4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5688e7a2f53a18570e1af006c5d1fbcb, https://si.imgix.net/df9fbb6e/uploads/origins/1b0074ec-c279-4c04-9c8a-859469ca8b4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c037982508ea5d433db140cd6a2ffe 2x, https://si.imgix.net/df9fbb6e/uploads/origins/1b0074ec-c279-4c04-9c8a-859469ca8b4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b76869470b56af0a0f145f4803e49912 3x"}, "body": "いと様\n\n初めまして、VTuberとして活動しておりますもみじと申します。\n\nデフォルメされたイラストがとても可愛らしく、ぜひお願いしたいと思いリクエストさせていただきました！\n\nポーズや服装ついてはお任せでも大丈夫なのですが、もし可能でしたら、水色の道着に黄色いハチマキの衣装を着ているとイメージに近くなり嬉しいです。\n\n【使用用途】\n・収益化済みYouTubeやX（Twitter）への投稿\n・可能であれば商用利用、グッズへの使用\n\nまた、可能でしたら人物のみの透過素材もご用意いただけますと大変ありがたいです。\n参考URLは下記に添付しております。\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/16WcBd2SZTxXcV0iV3AeprnYVRjZOO7Q3?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toko_iro_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3769467, "client_id": 1922669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a4850f3ebcfff2fa672df5fa0b1a92", "srcset": "https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0a4850f3ebcfff2fa672df5fa0b1a92, https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a72ec7fd2cd363ac8b7bd3ccb10b4ea4 2x, https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec4a3b9349e04225a831b77c9e153dae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd466510d69313185cfc8f6d79597960", "srcset": "https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd466510d69313185cfc8f6d79597960, https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a48c57ace2f7a80531b81633217b883 2x, https://si.imgix.net/d064496e/uploads/origins/ea3db55f-7939-423b-aadb-7432fd6c00fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2adc6fdd45da3c0fa657cc144ffbe7a 3x"}, "body": "こんにちは。私のスペースバニーVTuberのイラストを依頼したいのですが。\n参考画像をフォルダにまとめて添付しました。1枚目はモデルそのものです。2枚目と3枚目は、私が依頼した彼女の他のイラストです。\n\n身長157cmのスペースバニーガール\n髪：\n濃い紫（または紫がかった黒）。[前髪のピンクのグラデーションは任意です！]\n髪の下地は明るい紫で、きらめく星が散りばめられています\nサイドの前髪はピンクで、その上にピンクのアホゲがあります\nボディ：\n紫色の瞳にピンクのハイライトと、輝く星の虹彩\n日焼けした肌で、左（右向き）のお腹に星形のあざが2つあります\n\nポーズについては、エネルギッシュでハッピーな雰囲気であれば何でも構いません。背景も、お任せします。\n\nhttps://drive.google.com/drive/folders/1--4XiaBinCdBDOmwyQ1R-5RzyCD6By6G?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toko_iro_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3769467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9391c96a722bea8749b5be2294b3a85e", "srcset": "https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9391c96a722bea8749b5be2294b3a85e, https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90b8768f535901c023035c7c22a2e167 2x, https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16f07ffd224b648b6748047aedb744ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5453b3aa572e64fec24c68db490dd0ed", "srcset": "https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5453b3aa572e64fec24c68db490dd0ed, https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e7b37e68f848e35732d0357b1e2321e 2x, https://si.imgix.net/55734b2b/uploads/origins/8b32aeb3-6fc8-4f64-b50b-e7f1261c5ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc2a9328895d67fcf156424a73f8b03d 3x"}, "body": "キャラクター：ダイアナ・エアラインズ ― 私のVTuberキャラクター\n彼女は鳥のパイロットであるVTuberです。\n左足はバラに囲まれた檻になっています\nこのイラストをグッズに使用したいと考えています\nこの金額ではご要望にお応えできない場合は、お気軽に価格交渉をご依頼ください\n\nhttps://drive.google.com/drive/folders/12KdVfQQuEB4kcbb9Z8PYYdH1gYJdLJ5k?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toko_iro_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3769467, "client_id": 2097425, "vtt