ださい。\n\n使用用途としては、\n･鑑賞など個人の非商用利用\n･他の絵師様にスケブを依頼する際、資料としての引用\nなどを考えております。\n\n\n学年末や展示･出品など、お忙しいことかと存じますので、もし条件や時間が合い、ご都合等問題なければ受けてくださると幸いです。\nよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eat_orca/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2706067, "client_id": 210632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc363898/uploads/origins/13196fcd-5454-4a82-a285-4d5326ddd309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af35810e6d9eef0483b8efa0a804081a", "srcset": "https://si.imgix.net/bc363898/uploads/origins/13196fcd-5454-4a82-a285-4d5326ddd309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af35810e6d9eef0483b8efa0a804081a, https://si.imgix.net/bc363898/uploads/origins/13196fcd-5454-4a82-a285-4d5326ddd309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69791fce2c37693df2414417734cd318 2x, https://si.imgix.net/bc363898/uploads/origins/13196fcd-5454-4a82-a285-4d5326ddd309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d68fa2d49b3ae7ceb6e5b908736cd2f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc363898/uploads/origins/13196fcd-5454-4a82-a285-4d5326ddd309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4290fe5639aa69fa641b76d9d174ede2", "srcset": "https://si.imgix.net/bc363898/uploads/origins/13196fcd-5454-4a82-a285-4d5326ddd309?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4290fe5639aa69fa641b76d9d174ede2, https://si.imgix.net/bc363898/uploads/origins/13196fcd-5454-4a82-a285-4d5326ddd309?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff273ee545f588c5463f86f56601de81 2x, https://si.imgix.net/bc363898/upload