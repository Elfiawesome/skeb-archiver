て！個人VTuberの赤穂しゅな（あこうしゅな）と申します。\nXでお見かけし、構図がおしゃれで大胆な色使いが綺麗で、ちょっぴりダウナーなイラストに惹かれました。\n今回はXやYouTubeサムネイルで映えるビジュアルイラストをご依頼させていただきたいです。\n\n＜使用用途＞X宣伝画像、Youtubeサムネイル、HP掲載など\n＜サイズ＞　1920x1080サイズだと嬉しいです！！\n＜構図＞　顔周りが切れないようにしていただけるとありがたいです。それ以外はお任せします。ぜひしゃち³様の感性で赤穂しゅなを描いていただきたいです。性格は参考にしてもしなくても構いません。\n\n＜納品形式＞一枚絵と、できれば人物のみ背景透過をpngでお願いします。\n＜参考資料＞https://drive.google.com/drive/folders/1BacGiYfzUrBgy1vxPwx_Bb-EztyjUXAn?usp=drive_link\n\n【赤穂しゅなについて】\n地理と旅行が好きで、地理に関するエンタメ配信を行うVtuberです。\n「知識を持って、意識をすれば、景色が見える」「地図で遊んで、地理を楽しむ」\nがモットーです。\n芯が強くて、楽しいことや興味のあることにまっしぐらで、折れやすいけど回復も早いです。\nお忙しいところ恐縮ですが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1BacGiYfzUrBgy1vxPwx_Bb-EztyjUXAn?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eat_orca/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2706067, "client_id": 3549138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17ab2e37/uploads/origins/52256158-01cf-4075-aa5a-fd346e47d33b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277072f0188275331edbb3c8d77725f3", "srcset": "https://si.imgix.net/17ab2e37/uploads/origins/52256158-01cf-4075-aa5a-fd346e47d33b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=277072f0188275331edbb3c8d77725f3, https://si.imgix.net/17ab2e37/uploads/origins/52256158-01cf-4075-aa5a-fd346e47d33b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02a84d47133fe7f96102b0ba40226100 2x, https://si.imgix.net/17ab2e37/uploads/origins/52256158-01cf-4075-aa5a-fd346e47d33b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bb715deca9f389f51f43209d46046d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17ab2e37/uploads/origins/52256158-01cf-4075-aa5a-fd346e47d33b?bg=%23fff&auto=format%2Ccompress&fm=webp&