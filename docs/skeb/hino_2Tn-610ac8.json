-8a8c-46a0-873b-ff79d2426295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d01d59129c25199b2de295b9deedc7c", "srcset": "https://si.imgix.net/6cdaede2/uploads/origins/7f47a865-8a8c-46a0-873b-ff79d2426295?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d01d59129c25199b2de295b9deedc7c, https://si.imgix.net/6cdaede2/uploads/origins/7f47a865-8a8c-46a0-873b-ff79d2426295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efcc82e0c93c6e09857ffa08865be124 2x, https://si.imgix.net/6cdaede2/uploads/origins/7f47a865-8a8c-46a0-873b-ff79d2426295?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6372c2ad9ca24a315db1c926a7a00e38 3x"}, "body": "こんにちは^^また依頼させてください\n\n新しいコオリッポのキャラクターを作りたいのですが、リアルなコオリッポを作るのを手伝って欲しいです＾＾。\n私のコオリポは女の子で、色は参考文献にあるようなピンクです。\nお腹に大きなピンクのハートマークがある（頭と同じ色）。\n頭のアンテナもハート型にします＾＾。\n表情は、普通のコオリッポより、もっと楽しそうで、かわいい感じにしたいです。\n\nまた、可能であれば私のライチュウのキャラクターとコオリッポのキャラクターが出会っている写真を追加していただけませんか？\nコオリッポが、コオリッポの柔らかいお腹に、私のライチュウを愛おしそうに抱きしめているような、かわいらしいものを考えています。\nライチュウのハートマークがあるところに\nコオリッポのハートマークに頬ずりしながら、コオリッポを抱きしめているライチュウの赤ら顔がかわいい。\n私のライチュウの身長は10センチ、コオリッポの身長は10メートルなので、かなり大きさが違います。\nその絵にサイズを書いてもらえると嬉しいです＾＾。\n\nありがとうございました。\n\nhttps://imgur.com/a/qFPHJLC", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hino_2Tn/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 432029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/780adf4e/uploads/origins/5ecaf131-71e4-4285-aea9-eec84c48dcb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91799bed26bfad59db9e5a0e6992a972", "srcset": "https://si.imgix.net/780adf4e/uploads/origins/5ecaf131-71e4-4285-aea9-eec84c48dcb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91799bed26bfad59db9e5a0e6992a972, https://si.imgix.net/780adf