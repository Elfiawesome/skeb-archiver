n彼女は洋ナシ型の体型（お尻が大きく、胸は平ら）です。しっぽはスカートの下に入っているので、パンツは常に露出しています。お尻、おなら、うんちは、作者が描くのに無理のない範囲で、できるだけ大きく描いてください。\n目は見えていても隠れていても構いません。\n\nhttps://drive.google.com/file/d/1zgNuYVyRO4DXTv6cVjEnVHw4oMmXe6KR/view?usp=drive_link\nhttps://drive.google.com/file/d/1iVizfPdWEH0Yn1axCEYo0B3pCH2NK0VJ/view?usp=sharing\nhttps://drive.google.com/file/d/184hR7CDi1kZZ_rHVy-R4aSGcS8NFWgGE/view?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekaki20241124/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b50964fa/uploads/origins/8da66ca1-ca42-4660-87b5-bc2f83472f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e986f23f6f77500050a85900e3ed7c41", "srcset": "https://si.imgix.net/b50964fa/uploads/origins/8da66ca1-ca42-4660-87b5-bc2f83472f46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e986f23f6f77500050a85900e3ed7c41, https://si.imgix.net/b50964fa/uploads/origins/8da66ca1-ca42-4660-87b5-bc2f83472f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aa68347c17876c121953e593c614ccdf 2x, https://si.imgix.net/b50964fa/uploads/origins/8da66ca1-ca42-4660-87b5-bc2f83472f46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61ddcfe6cc3499514e2f8553b7c661f0 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3935496, "nc": 49}, {"path": "/@oekaki20241124/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3935496, "vtt_url": null, "thumbnail_image_urls": {"src": 