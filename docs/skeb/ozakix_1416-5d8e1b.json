04-d5ce74f31045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=577765dee60b2ec5d9c3632056a1bfb0 2x, https://si.imgix.net/25b262d3/uploads/origins/4cd64532-3f43-48fa-9304-d5ce74f31045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29c6689f90f3be2317fcef73619e7a62 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25b262d3/uploads/origins/4cd64532-3f43-48fa-9304-d5ce74f31045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bbe363ec66c635656f52c90c9731554", "srcset": "https://si.imgix.net/25b262d3/uploads/origins/4cd64532-3f43-48fa-9304-d5ce74f31045?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bbe363ec66c635656f52c90c9731554, https://si.imgix.net/25b262d3/uploads/origins/4cd64532-3f43-48fa-9304-d5ce74f31045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=511b81b43609cdfe846c19f6fd311330 2x, https://si.imgix.net/25b262d3/uploads/origins/4cd64532-3f43-48fa-9304-d5ce74f31045?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09c990b969b2763208e50cbda6115344 3x"}, "body": "再開お待ちしておりました　初めましてツイッターと新着で拝見しフォローさせていただきました。\n緒嵜様の過去作品『 https://www.pixiv.net/artworks/83248827 』の怪盗化シチュを自分のキャラでも依頼したくリクさせていただきました。\nhttps://drive.google.com/drive/folders/1zV36H8vslWyqK_VYGsbrv1G3RnHKPH3w\nこちら顔髪型の男の子が女装し、おとり捜査中に捕らえられて自分の隠していた気持ちを曝け出されて怪盗化してしまうような感じにお願いしたいです。\n(隠していた気持ちは女の子の恰好するのが好きでお願いします)\n先に怪盗化された方のように緒嵜様の過去作品と同じ様に、以下の要素を入れて頂けると嬉しいです。\n・淫紋を刻まれて心を盗まれる(自分の気持ちを曝け出される)\n・エッチな怪盗コスに変身させられる(男の子のまま資料のような隠さないスカートで)\n・御主人様の事を考えて、怪盗コスのままえっちな表情でチクニーアナニー\n・堕ち後は先に怪盗化した二人と同じくご主人様大好きに\n宛名はpsdレイヤーでon/offお願いします。\nよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ozakix_1416/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1158818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6d2d15631dbce160a1001a9c80af317", "srcset": "https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6d2d15631dbce160a1001a9c80af317, https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f413026e33df4fffb87c62a13a318ee1 2x, https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e951ed2cc77a3df7bba273fe40f78523 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3d5cf739aba4d73b606979bde0c70fb", "srcset": "https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3d5cf739aba4d73b606979bde0c70fb, https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7a485ac8f766dc93a7b86604a717799 2x, https://si.imgix.net/06bbe270/uploads/origins/01c3a248-427d-4979-baa0-ee74816d4f14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f786034875ae4f5ab2e0d85e10aff44b 3x"}, "body": "どうも、緒嵜さん。前回は、女幹部が変身ヒロインと同化しダークヒーロー化するシーンを描いていただきありがとうございました。\nまたリクエストをお願いします。\n\nリクエスト内容は、前回の続きで同化して力を手にした女幹部が何らかの要因で強制的にヒロインと分離し、その弊害で身体の特徴が入れ替わってしまい互いに困惑するシーンをお願いします。\n\n分離後ですが、女幹部とヒロインの身体的特徴の一部が下記の通りに入れ替わっているように描いていただきたいです。\n\n女幹部\n・髪型は女幹部のまま\n・髪の色がヒロインの変身前の黒髪\n・瞳の色はヒロインの琥珀の瞳で白目が黒目\n・着ているのはヒロインの制服\n・胸の大きさはヒロインのサイズで体型は女幹部のままのため、制服のスカートから尻が少し見えている状態。\n\nヒロイン\n・髪型はヒロインのまま\n・髪の色が女幹部のピンク髪\n・瞳の色は女幹部の真紅の瞳に白目\n・着ているのは女幹部の鎧\n・胸の大きさは女幹部のサイズで体型はヒロインのまま。\n\n可能であれば、分離後の2人の姿は頭から足先まで見える姿で描いていただきたいです。\nそして、淫紋については分離後は半分に割れ、ヒロインに右半分の淫紋が、女幹部に左半分の淫紋が身体に浮かんでいるように描いていただきたいです。\n\n設定として、ヒロインの持つ力と女幹部の持つ力が肉体の特徴が入れ替わったため力を発揮できず、力を行使するには本来の体に戻るか、再び合体するかのどちらかをする必要があるという程でお願いします。\n\nまた、セリフについては女幹部の方は力が消えたことと、胸がヒロインと入れ替わったため自慢の肉体を失ったことに絶望し悪態をつく感じにしていただきたいです。\n一方ヒロインのほうは、女幹部の衣装を着たことや胸が大きくなっていることに恥ずかしがりつつ、これから学校通うのにどうするか頭を悩ませるような感じでお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ozakix_1416/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1158818, "client_id": 331403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b5b341b292eebbdf2bba960f1c83962", "srcset": "https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b5b341b292eebbdf2bba960f1c83962, https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41682aacdc521ce2284ff47c61691bdc 2x, https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb51afee912125ac702ed96284bd53a0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dc3f45e307737d0dcc40be29f05a659", "srcset": "https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dc3f45e307737d0dcc40be29f05a659, https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3018a2fb22c9abd3c59a3fdaa27d9ce4 2x, https://si.imgix.net/62f3cf75/uploads/origins/eedec8cf-6298-4b15-91e9-43a23000c3ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f690f4d74654e818d540b57e5b61f1f 3x"}, "body": "ウェディングドレスを着た女の子のふたなり淫魔化悪堕ちを依頼させていただきます。\n呪われたマリッジリングを指に嵌めてしまい、抵抗叶わず快楽に飲まれながら淫魔化してしまう、というシチュエーションでお願い致します。\n変化後の姿は、元のドレスをベースに淫猥なモノへ変化させて頂きたいです。\n宜しくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ozakix_1416/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1158818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b1fc63c073838edb344df7233079cb8", "srcset": "https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b1fc63c073838edb344df7233079cb8, https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26e3416e16290e696ba5d126a9c15a35 2x, https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a52752a9bcee4fed5b07548472105c7c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33831d6028feedded848846408f48ed8", "srcset": "https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33831d6028feedded848846408f48ed8, https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a645d5f7cfc3710357864aa7402b5da5 2x, https://si.imgix.net/f94681b0/uploads/origins/752d5c37-8b32-43d3-b815-b04a069a1294?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bb3ce53964243ed4f7a7354e2c36aa2 3x"}, "body": "始めまして！とても素敵な絵柄・シチュに惹かれてご依頼させて頂きました。\nお目通し頂ければ幸いです。\n\n\n●キャラクター\nこちらの金髪っ娘をお願いします。\n『 https://f.easyuploader.app/20210702213709_4e466946.png 』\n『 https://f.easyuploader.app/20210713181628_68647a37.png 』\n\n●シチュエーション\n緒嵜様の過去作品『 https://www.pixiv.net/artworks/83248827 』の怪盗化がとても好きなので、怪盗の仲間入りさせられてしまうシチュをお願いします。\n\"ご主人様\"の屋敷に忍び込むも捕らえられ、操られた怪盗の女の子によって自らも怪盗の仲間入りさせられてしまう…と言った感じにして頂けると理想的です。\n\n●構図\n緒嵜様の過去作品と同じ様に、以下の要素を入れて頂けると嬉しいです。\n・淫紋を刻まれて心を盗まれる\n・エッチな怪盗コスに変身させられる\n・御主人様の事を考えて、怪盗コスのまま顔を赤らめてオナニー\n・堕ち後はご主人様大好きな感じ\n\n\nお手数おかけしますが、ご検討頂ければ幸いです。\nどうぞよろしくお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ozakix_1416/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1158818, "client_id": 159884, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b6bf9d11cf472ac2879f6934ba61866", "srcset": "https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b6bf9d11cf472ac2879f6934ba61866, https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb2ca3d472aefadd9b21fc8dfdebd5d0 2x, https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f4b9a7fcfbc9a4591febca9c7e899bd3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dfd51dd29ae5515ffadad325c0aef68", "srcset": "https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dfd51dd29ae5515ffadad325c0aef68, https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a68db6e12a02ceceb68428ea8aa6965 2x, https://si.imgix.net/bde54267/uploads/origins/3a351883-d4ce-459b-b60f-4420d7335290?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a8db1472e88cf83a0dbeeb393539d5 3x"}, "body": "超次元ゲイムネプテューヌというゲーム作品より、ネプギアの依頼です。\n\nネプギアの悪堕ちイラストを、堕ちる前と後の両方でお願いしたいです。\n\n\n緒嵜先生の悪堕ち作品の発想がいつも天才的だと感じているので、モチーフやシチュエーションについてはお任せしたいと考えております。\n\n\n・世界観、キャラクターについては資料を添付いたしますので、そちらを参考にお願いします。\n・悪堕ちに関しては原作のネタでも、完全オリジナルでもどちらでも構いません。原作の悪堕ち向けのネタもまとめて同梱します。\n・ネプギアには変身後（パープルシスター）の姿があります。こちらの姿や、別の衣装を使用しても大丈夫です(いくつかの衣装は資料に同梱します)。\n・セリフ無し、堕ち前後のみでも問題ありませんが、もしキャプションでセリフを入れていただける場合、口調は敬語、一人称は「わたし」、二人称は「あなた」にすれば大丈夫です。万が一何か間違えても文句をいう人はいません。\n\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11Myr-MBR9zDrFMyMRyxvBv8dhCtGYWr2?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ozakix_1416/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1158818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32c633a13bd56fa0a64e73f84b2a5569", "srcset": "https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32c633a13bd56fa0a64e73f84b2a5569, https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ac54547510552dae8bad69f10c1bd43 2x, https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3268d168ef7ea8439e2872b84e919c5a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e801689b7c25c90e1f1eaa84a3153a8", "srcset": "https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e801689b7c25c90e1f1eaa84a3153a8, https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=929b36758de3c4b788a4761d875b5c10 2x, https://si.imgix.net/582fd7c2/uploads/origins/00868a67-313b-4b2f-8884-52b72f5d314a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43a26d38eeb18e3a5f8bd4798325e5d9 3x"}, "body": "どうも、緒嵜さん。前回は、女子高生の昆虫怪人化を描いていただきありがとうございました。\nまたリクエストをお願いします。\nリクエスト内容は、変身ヒロインが敵組織の策略で組織の女幹部と融合してしまうシーンを描いていただきたいです。\n\n話の流れとして、女幹部に拘束された変身ヒロインが変身解除させられ無防備になった所を抱き付かれて、変身ヒロインと女幹部の身体の境界がなくなり同化し一つの存在へと変化するという流れでお願いします。\n\n女幹部の姿は青肌の淫魔系のスタイルのいいセクシーな姿で、衣装は緒嵜さんが以前描かれた女怪盗のボンテージのような衣装に胸当てもしくはショルダーアーマーのような鎧を加えたようなデザインで描いていただきたいです。\n\n同化後の姿は、衣装は女幹部の衣装をベースに変身ヒロインのスカートや装飾等の衣装の一部がダークなカラーリングで残っている感じにし、髪型や体型は女幹部で髪色や目の色は変身ヒロインの見た目で描いていただきたいです。\n\nそして、シチュエーションについてですが同化するシーンでは、ヒロインと女幹部の意識が徐々に混ざり一つの意思になるような描写にしていただきたいです。\nまた、ラストシーンで同化後の主人格と姿は女幹部寄りですが、思考等はヒロインの強い意思により正義の味方思考になるという、悪堕ちした姿だが中身は正義のヒロインのままという描写にしていただきたいです。\n\n要望が多くて申し訳ないですが、ご一考お願いします。\n\nhttps://drive.google.com/drive/folders/1-Sp6Osmn7h-TUqPlS63PqixZ_pIzrWBG", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ozakix_1416/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1158818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcc9883e/uploads/origins/50237877-9a9d-431a-aa2f-eb8ea41b5e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e45ab7bdf395df60b176cac4ba8a47a0", "srcset": "https://si.imgix.net/fcc9883e/uploads/origins/50237877-9a9d-431a-aa2f-eb8ea41b5e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e45ab7bdf395df60b176cac4ba8a47a0, https://si.imgix.net/fcc9883e/uploads/origins/50237877-9a9d-431a-aa2f-eb8ea41b5e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0aa29d6b7c66ad038b0d2eb87d7a7c90 2x, https://si.imgix.net/fcc9883e/uploads/origins/50237877-9a9d-431a-aa2f-eb8ea41b5e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f069b4d8b51c23ab9f94ddbbbb62792 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcc9883e/uploads/origins/50237877-9a9d-431a-aa2f-eb8ea41b5e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&