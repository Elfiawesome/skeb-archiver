tatus/1800752040043540623\n○右手は、下記リンクの怪人と同じ剣を持っている。\nhttps://kamenrider.fandom.com/wiki/Knight_Soldiers#Statistics\n○体型は、下記リンクと同じボンキュッボンの爆乳。おっぱいの大きさは、頭の大きさと同じ大きさにしてください。\nhttps://www.pixiv.net/artworks/129486913\n○全身を描いた全身絵。\n○頭から下は、下記リンクのように使い回して構いません。\nhttps://www.pixiv.net/artworks/124626491\n\nお忙しいところ恐れ入りますが、ご検討よろしくお願い致します。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@simple3240v/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913184, "client_id": 3834277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3a680c2/uploads/origins/316bf02d-8698-4d6a-81f5-44a87f493b5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86cad959ff036e5e0fe646274fd62068", "srcset": "https://si.imgix.net/a3a680c2/uploads/origins/316bf02d-8698-4d6a-81f5-44a87f493b5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86cad959ff036e5e0fe646274fd62068, https://si.imgix.net/a3a680c2/uploads/origins/316bf02d-8698-4d6a-81f5-44a87f493b5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=138f3c708b83e92072b1e86ee85851e6 2x, https://si.imgix.net/a3a680c2/uploads/origins/316bf02d-8698-4d6a-81f5-44a87f493b5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eeacc315368b7011906749dc468882c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3a680c2/uploads/origins/316bf02d-8698-4d6a-81f5-44a87f493b5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d166b815c80029e60af11ca9942476c9", "srcset": "https://si.imgix.net/a3a680c2/uploads/origins/316bf02d-8698-4d6a-81f5-44a87f493b5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d166b815c80029e60af11ca9942476c9, https://si.imgix.net/a3a680c2/uploads/origins/316bf02d-8698-4d6a