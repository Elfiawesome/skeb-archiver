rmat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a02a34bd2cc6005de02d604e79012807 2x, https://si.imgix.net/35a31ab4/uploads/origins/670131bf-cb4d-4103-8718-4c741be8e191?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99bed72b0263198ed98a7c69cf7a7de4 3x"}, "body": "お世話になります。\nskebの悪堕ち変身シーンが好みでやってきました…\n\n依頼内容ですが、東京ミュウミュウにゅ～の碧川れたすの悪堕ち変身シーンをお願いします。\n\n変身シーン後半（動画資料の0:21あたり）、首のブローチが黒く染まり、強制的に再変身させられるれたす。\n変身衣装が弾けて消え、裸体になり、元々グラマラスだった胸がさらに成長し、衣装が巻き付き、変身が完了する。\n表情は変身を経るごとに恍惚とした表情になり、変身が完了すると妖艶な笑みを浮かべている…\n\nといったシチュでお願いしたいです。\n悪堕ち衣装はpixivリクエストで作成されていたものが刺さりましたので、ベースにしていただければ大変助かります。（https://www.pixiv.net/artworks/107067669）\n以上、ご検討お願いします。\n\nhttps://www.youtube.com/watch?v=S3ptFhLyXnM", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@obakenorururu/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 829031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c139761762df17d336cf2b6e022affa5", "srcset": "https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c139761762df17d336cf2b6e022affa5, https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5120e07d0bd81f339c6a21b40387746 2x, https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6acd9082ca6f5addb3467c3e0069a98d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d733b5a276a78630e164a9269375406b", "srcset": "https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d733b5a276a78630e164a9269375406b, https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=391eb0939095eecb0b01bd8ed83e0fac 2x, https://si.imgix.net/a707f911/uploads/origins/8eee537a-9343-467a-a5d8-04917f4cb4cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0d64dca9e2e9c7dca16bca9e036e2fe 3x"}, "body": "いつもお世話になっております。\n先日は立ち絵verの悪堕ちプリンちゃんをありがとうございました！\n今回は大きめの依頼をお願いしたく、（キャンペーン等の開催があればなお良かったのですが）久しぶりにskebでリクエストを送らせて頂きました。\nお願いしたいのは悪堕ち強化フォームのミュウイチゴちゃんに関する依頼で、デザイン時のお礼でも軽く触れたのですが培養槽のシーンからこの姿になるまでの過程をぜひ見てみたいと思ってまして、変身シーンとして依頼させて頂けると嬉しいです。\n\n以前ここで描いて頂いた、悪堕ちミントちゃんのあまりにも良すぎる変身シーンに脳をすっかり焼かれており、\n詳細なシーンの指示はとても畏れ多いので、とりあえず設定的な部分やここだけは頼んでおきたいという部分だけ以下にふんわりと書いたのですが、基本的にはるるるさんのお気の赴くままにお願いしてもよろしいでしょうか。\n\n＜大まかな設定＞\n・培養槽ではミュウイチゴ状態でしたが、改造完了と共に変身を解除した前提で、今回は変身前・全裸状態のいちごちゃんが悪堕ち強化形態へ覚醒するシーンをお願いします。\n・変身前の身体に悪堕ちミュウミュウ4人の悪の力が注ぎ込まれきった状態のため、抑えきれない溢れる力を欲望のまま爆発させ、自らの肉体を作り変え、コスチュームを形成するような、全裸からの変身・悪堕ち変身ならではの魅力を活かしたセクシーさ全開の変身過程をお願いできると嬉しいです。\n\n＜お願いごと＞\n・通常の悪堕ち形態よりも更に強化された形態への変身なので、肉体変化に関しては一度悪堕ちボディへ巨乳化したあと、まだ足りないと言わんばかりに更にもう一段階大きくなるような2段階の巨乳化をお願いします。胸以外の部位も通常のいちごちゃんと比べるとかなりセクシーな体つきになるので、その辺りが盛られるカットもあるとありがたいです。\n・ツートンカラーのロングヘアも大きな特徴なので、髪が伸びて髪色が変わる様子もぜひお願いします。\n・マントは身体を広く覆うため一通り変身が完了したあとシメに展開するような感じでいかがでしょうか…？\n\nお手間を要する内容ですので、お願いできそうなタイミングで依頼できていればいいのですが、時期的に厳しい場合などは気兼ねなく再送要請などで調整頂ければ幸いです。\n恐れ入りますが、もしよろしければ今回もどうぞよろしくお願いいたします…！\n\nhttps://www.pixiv.net/artworks/126253774", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@obakenorururu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 829031, "client_id": 1202629, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16310ddfb60b1276430324e1bff157cb", "srcset": "https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16310ddfb60b1276430324e1bff157cb, https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ced3da5e43621c1a94b0c338aacb2d3 2x, https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be6d25df1c4c07a98c4443b24f1bd876 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5af290b1eb5c0db5767e06fa58b7ae6b", "srcset": "https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5af290b1eb5c0db5767e06fa58b7ae6b, https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00c4a1c3e8414f382d442207d958980f 2x, https://si.imgix.net/f2a0c755/uploads/origins/c84d8179-7209-4280-bc18-0cefcb91b24b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7de342098b7bd4353bf96fb35e2cfa1d 3x"}, "body": "初めまして。水城結華のイレイザークイーン衣装のイラストが良かったのでリクエストお願いします。\n超速変形ジャイロゼッターのイレイザークイーンが赤名累を洗脳調教しているシチュをお願いします。\n衣装\n・イレイザークイーンの衣装は通常通りの緑色で\n・赤名累の衣装ですがイレイザークイーン衣装で緑の所を赤色に変更をお願いします。\n構図はイレイザークイーンが機械に拘束されて調教されている赤名累を妖絶そうに見ている感じで。\n全身が映る構図で足元まで写っていると嬉しいです。\n可能でしたらイレイザークイーン、赤名累の資料にあるような顔にパーツが残った状態のマスクオフ分もあると嬉しいです。\n\nhttps://drive.google.com/drive/folders/1pI7J8UhhieS71DSKqKL5tlSTBQIXr21t?usp=drive_link", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@obakenorururu/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 829031, "client_id": 956355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1ec521529f43c4edbffafb1fd150e7", "srcset": "https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1ec521529f43c4edbffafb1fd150e7, https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89bc1606eb3d5c44c23ec2c2b6f9905e 2x, https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90c08345a3e8147b85e538aff4ee66a8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c858883a4dbcd203f6f40f2255d0940", "srcset": "https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c858883a4dbcd203f6f40f2255d0940, https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dbea82d09d409ff4a0317ed5c5bc2a43 2x, https://si.imgix.net/23da53a3/uploads/origins/7f9aa273-49ee-41c8-8288-d9bd5ef9c027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01ac84e1159558a25ddc782b9e5da992 3x"}, "body": "はじめまして、びーすとはーとと申します。るるるさんの可愛らしいミュウイチゴのイラストを拝見して、拙作オリキャラ変身ヒロインのリクエストがしたいと思い、依頼させていただきました。\n\n\n・依頼内容\n変身ヒロイン「純真聖女エンジェリックスイート」の１枚絵。一枚目の制服姿ではなく、資料URLの二枚目のピンクと白のコスに変身した姿です。\n\n・構図\n\n細かい構図はおまかせしますが、ステッキを前にかざし、ウインクしながら笑顔を見せるエンジェリックスイートの姿。\n\nイメージ的にはアニメのキービジュアルやアイキャッチ、版権イラストなどのような公式絵っぽい1枚絵で、ヒロインのかわいらしさ、魅力が表現されてるイメージです。ふわっとした言い方になってしまいますが、いつものるるるさんのイラストと同じように目は大きく、女児アニ風のかわいくなおかつエッチな感じで描いていただきたいと思っております。\n\n・希望　ユナ（エンジェリックスイート）は背は低いのですが、ムチムチ体型で胸も大きいので、ムチムチな感じにしていただきたいです。胸に関しては片乳が顔より大きいくらいを目安に、このミュウイチゴのイラスト（https://www.pixiv.net/artworks/123190211）よりも大きく描いていただけたらと幸いです。太もももムチムチで太いと嬉しいです。これはおまかせしますが、ウエストもイメージ的にはいちごほど見事に細いというよりはある程度は普通にお肉がついてるような、等身大の女の子といった感じです。難しいかと思いますが、脚もそんなに長くない感じで描いていただけたら幸いです。\n\nまた、スカートはパンツが見えないギリギリまで短く描いていただいて、へそも見えていたらうれしいです。\n\n・構図イメージ\n\n\n・資料もあるので不要な気もしますが、以下、ユナのキャライメージとプロフィール\n\n垂れ目、幼い印象の童顔、かわいい系の小柄な美少女で、悪党相手の戦いでも心を痛めるような純真で優しい心を持っています。\n身長は151センチと小柄、バスト103、ウエスト62、ヒップ86と、幼い童顔に反した豊満な身体を持っている。\n\n長々と書いてしまいすみません。細かい部分はおまかせします。ご検討いただけたら幸いです。\n\nhttps://www.pixiv.net/artworks/116310941", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@obakenorururu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 829031, "client_id": 598129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/912289c9/uploads/origins/a7209be4-6bea-481e-a9ac-533b0149fb2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94b7316311599c54528ed0e8eeb6fc02", "srcset": "https://si.imgix.net/912289c9/uploads/origins/a7209be4-6bea-481e-a9ac-533b0149fb2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94b7316311599c54528ed0e8eeb6fc02, https: