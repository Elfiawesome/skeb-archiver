i.imgix.net/ca356fb1/uploads/origins/9e88048a-0413-41de-a32e-14b8421d3089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d51e9fc9eacdcb6ab55b12b90cd6f55, https://si.imgix.net/ca356fb1/uploads/origins/9e88048a-0413-41de-a32e-14b8421d3089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a230206c5bccdae9e4cb1acc41e14037 2x, https://si.imgix.net/ca356fb1/uploads/origins/9e88048a-0413-41de-a32e-14b8421d3089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85e2b3574d62192ec5e7b007d8d22a49 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca356fb1/uploads/origins/9e88048a-0413-41de-a32e-14b8421d3089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e46066b966b08000a2bb295176761c", "srcset": "https://si.imgix.net/ca356fb1/uploads/origins/9e88048a-0413-41de-a32e-14b8421d3089?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07e46066b966b08000a2bb295176761c, https://si.imgix.net/ca356fb1/uploads/origins/9e88048a-0413-41de-a32e-14b8421d3089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad6e76aa4c212e437437d38812d8f358 2x, https://si.imgix.net/ca356fb1/uploads/origins/9e88048a-0413-41de-a32e-14b8421d3089?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=afe3298a736fbb6e48c5427a37685443 3x"}, "body": "渋のほうでミュウミュウの悪堕ちイラストをリクエストさせて頂いた者です。\nいつも大変お世話になっています。\n\nちょっと大きめの依頼を考えていたところ、13日までSkebの手数料無料キャンペーンを実施中と伺い、\n丁度いい機会でしたので今回はこちらからリクを書かせていただきました。\n（キャンペーンについてはプロフ設定の条件等があるようですので、お手数ではございますがお引き受け等を検討頂く前に、お知らせのご確認をお願いいたします。）\n結果的に前回からまた日が空かずにお願いする形になってしまい、お忙しい所すみません…！\n\n今回お願いしたいのは、これまで描いて頂いた悪堕ちミュウミュウへの変身シーンのイラストです。\n3人とも本当に秀逸なデザインでしたので、誰か1人を選ぶのは悩ましい所でしたが、\n個人的な好みとシーンが映えそうなイメージから、キャラクターはみんとちゃんでお願いします。\n洗脳済のみんとちゃんが悪の力で悪堕ちミュウミントの姿に変身していく過程をお願いできますでしょうか。\n\n変身前の衣装などは大丈夫ですので、全裸からの変身シーンでお願いします。\nまた、変身後のイラストでは胸を盛って描いて頂きましたが、\n元からではなく変身の際に巨乳化してあのサイズまで大きくなるシーンを挟んで頂けると嬉しいです。\n\nなお、構成や構図、必要に応じたカット分け、総ページ数、その他シチュエーションなどなど、変身シーンの描き方自体は特に指定等はございません。\n変身シーンや変身途中のイラストはるるるさんの方でもこれまでいくつか描かれていると思いますが、どれを拝見しても本当に素晴らしいものばかりでしたので、餅は餅屋…ということで、お気の向くままに描いて頂ければ何よりです…！\n\nこれまでの依頼品への感謝も込めた依頼のつもりではありましたが、やはり複数枚の依頼はご負担も少なくないかと思いますので、\n急ぎませんので、どうか無理のない範囲でお願いさせていただければ幸いです。\n以上につきまして、よろしくお願いします。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@obakenorururu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 829031, "client_id": 157263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0deca2f4/uploads/origins/60809cdb-4b6b-4cf8-894d-4b1b8ee42b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3f55732877b88ea9cbabf13f83c23c9", "srcset": "https://si.imgix.net/0deca2f4/uploads/origins/60809cdb-4b6b-4cf8-894d-4b1b8ee42b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3f55732877b88ea9cbabf13f83c23c9, https://si.imgix.net/0deca2f4/uploads/origins/60809cdb-4b6b-4cf8-894d-4b1b8ee42b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41098a8afd2e81fe89956705f842ad83 2x, https://si.imgix.net/0deca2f4/uploads/origins/60809cdb-4b6b-4cf8-894d-4b1b8ee42b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=808a4726a6304185a92c8949cd160bb6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0deca2f4/uploads/origins/60809cdb-4b6b-4cf8-894d-4b1b8ee42b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac99e8ebebf664792ddea6ba6a0aa6f", "srcset": "https://si.imgix.net/0deca2f4/uploads/origins/60809cdb-4b6b-4cf8-894d-4b1b8ee42b0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac99e8ebebf664792ddea6ba6a0aa6f, https://si.i