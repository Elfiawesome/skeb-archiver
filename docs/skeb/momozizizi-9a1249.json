背景・宛名がレイヤー分け出来るPSDデータで頂けると有難いです。\n・Twitter上で納品報告をする場合は、「#神白ニア」「#ニアの刻印」のタグを付けて頂ければ幸いです。\n\n長文失礼致しました。\n以上、ご検討よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@momozizizi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 874575, "client_id": 49958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-445932bc2832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4eb3a085ac58a2572f66421c12c2c57", "srcset": "https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-445932bc2832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4eb3a085ac58a2572f66421c12c2c57, https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-445932bc2832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2245ed8aab3f2682905ae878603e48f 2x, https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-445932bc2832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=440f6ae0d4de4fce9dba06513a620b7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-445932bc2832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66d32b8418064b45aa0bbd07b488fdff", "srcset": "https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-445932bc2832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66d32b8418064b45aa0bbd07b488fdff, https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-445932bc2832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d613b8c3af9c26adf6ab65f16d22f5b 2x, https://si.imgix.net/0272fd78/uploads/origins/dc1d5a80-3cba-4fed-bd87-