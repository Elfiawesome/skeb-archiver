at makes her seem lazy. Please make her look a bit plump and give her messy hair. You can use the outfit in the pose reference or a different outfit, as long as it makes her look like a lazy otaku.\nFeel free to make adjustments where you see fit. I look forward to your work!\n\nMiho: https://photos.app.goo.gl/oGY5q8NHZAWvv1AUA\nPose: https://photos.app.goo.gl/9BAQKZmUiKuPRaDXA", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mimic_ri/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d033315a/uploads/origins/6cfc417f-2611-4039-aa0a-ecc8a25a728e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3e5b1b205c691cea670582cce014f19", "srcset": "https://si.imgix.net/d033315a/uploads/origins/6cfc417f-2611-4039-aa0a-ecc8a25a728e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b3e5b1b205c691cea670582cce014f19, https://si.imgix.net/d033315a/uploads/origins/6cfc417f-2611-4039-aa0a-ecc8a25a728e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66281ba619b79426c41fef20e28a81b8 2x, https://si.imgix.net/d033315a/uploads/origins/6cfc417f-2611-4039-aa0a-ecc8a25a728e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=031fd505104f832acb6fbe5cdac0ddec 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 878550, "client_id": 11129, "nc": 177}, {"path": "/@mimic_ri/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 878550, "client_id": 3571471, "vtt_url": null, "thumbn