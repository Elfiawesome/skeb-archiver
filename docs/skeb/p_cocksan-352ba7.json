描写も全く問題ありません！キャラクタープロフィールを元に自由に作ってください\nNSFW表現もOKなので、自由に作ってください。\n衣装や構図など全てお任せします。マンガの小ネタ、台詞、セリフの変化、なんでも自由に作ってください！自由に描いて頂けると嬉しいです！\n可能であれば、別レイヤーにサインを入れたpsdファイルをお願いします。\nもし可能でしたら、セリフの吹き出しと文字は別のレイヤーに分けていただけると嬉しいです！\nお忙しい中、ご覧いただきありがとうございます。お引き受けいただけると幸いです。\nこの依頼がお気に召さない場合は、遠慮なくキャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1Jb1eoz36O21fTxu6v_KCq4btMlUrzoFg?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@p_cocksan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 747946, "client_id": 2178819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b25ad73/uploads/origins/7b3bdfb6-05ad-4b70-a8b2-77f363405fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64891199fcc10c10a92d80f89622eeb1", "srcset": "https://si.imgix.net/0b25ad73/uploads/origins/7b3bdfb6-05ad-4b70-a8b2-77f363405fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64891199fcc10c10a92d80f89622eeb1, https://si.imgix.net/0b25ad73/uploads/origins/7b3bdfb6-05ad-4b70-a8b2-77f363405fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=08ea3251c5f3d01f746a2c2fecb46001 2x, https://si.imgix.net/0b25ad73/uploads/origins/7b3bdfb6-05ad-4b70-a8b2-77f363405fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7eacf8eb9626c567450c372e38d6ff56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b25ad73/uploads/origins/7b3bdfb6-05ad-4b70-a8b2-77f363405fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ead7c33eb0c00725e16b8454fd0713e5", "srcset": "https://si.imgix.net/0b25ad73/uploads/origins/7b3bdfb6-05ad-4b70-a8b2-77f363405fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ead7c33eb0c00725e16b8454fd0713e5, https://si.imgix.