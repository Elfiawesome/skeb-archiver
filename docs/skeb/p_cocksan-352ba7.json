3fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=534acda0dbac259daf00011884b52bb4, https://si.imgix.net/243dc4dc/uploads/origins/f151eb21-a9bf-4a63-adb4-73ce138893fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dad91ce86a29fc00c7ab44abf3d68b56 2x, https://si.imgix.net/243dc4dc/uploads/origins/f151eb21-a9bf-4a63-adb4-73ce138893fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b5ace53a86f6c262280c93908dce278 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！\n先生の描かれる圧倒的な表情の描写や、繊細なキャラクター同士のやり取りが大好きです！\n\nもし可能でしたら、私のTRPGキャラクターの短い漫画を描いていただくことはできますか？\nhttps://drive.google.com/drive/folders/15QItc4sHPOi6YEIbLebZdK_sYKRnTE8M?usp=sharing\n\n話の筋が通らないところがあれば、自由にイメージや自分の考えで埋めていけばいいのです。もし人物の服装の造形などについて不確かなところがありましたら、自由に書き直して創作してください。\n\n可能でしたら宛名とサイン、漫画のセリフなど文章の部分はpsdレイヤーでon/offできると嬉しいです。\n\nまた、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！（ただし、これは必須ではありません）\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！\nお気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1QPGw2z6F0JgM2FK8NcxRZzZWxwDb5wzG?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@p_cocksan/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 747946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fba1756c/uploads/origins/1ada3104-bf98-4f36-b49f-4fddd9dff550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dca3120ef05d260cc96bcc6a94c12bfb", "srcset": "https://si.imgix.net/fba1756c/uploads/origins/1ada3104-bf98-4f36-b49f-4fddd9dff550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dca3120ef05d260cc96bcc6a94c12bfb, https://si.imgix.net/fba1756c/uploads/origins/1ada3104-bf98-4f36-b49f-4fddd9dff550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2eaf60957f6230afdb7fd876