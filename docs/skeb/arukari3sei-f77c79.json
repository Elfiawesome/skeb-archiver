3059\uff01\n\uff65\u30dd\u30fc\u30ba\u3084\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u306f\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\uff01\u30a4\u30e9\u30b9\u30c8\u306e\u30b9\u30bf\u30a4\u30eb(\u7b49\u8eaborSD)\u3082\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\uff01\uff01\n\uff65\u8863\u88c5\u306f\u7d30\u304b\u3044\u7b87\u6240\u3084\u3001\u8cc7\u6599\u5c11\u306a\u304f\u5206\u304b\u3089\u306a\u3044\u90e8\u5206\u306f\u6539\u5909\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u69cb\u3044\u307e\u305b\u3093\ud83d\udc93\n\n\u25c6\u4e16\u754c\u89b3\u25c6\n\u65cb\u5f8b\u8005(\u30e1\u30ed\u30c7\u30a3\u30a2)\u3068\u547c\u3070\u308c\u308b\u4fe1\u8a17\u3092\u53d7\u3051\u305f\u8005\u306e\u307f\u3064\u304b\u3048\u308b\u6d44\u5316\u306e\u529b\u304c\u3042\u308b\u3002\n\n\u666e\u901a\u306e\u9b54\u7269\u3068\u306f\u5225\u306b\u9b54\u798d(\u30de\u30ac)\u3068\u547c\u3070\u308c\u308b\u666e\u901a\u306e\u529b\u3067\u306f\u5012\u305b\u306a\u3044\u9b54\u7269\u304c\u5b58\u5728\u3059\u308b\u3002\n\u30e1\u30ed\u30c7\u30a3\u30a2\u306b\u529b\u3092\u5206\u3051\u4e0e\u3048\u3089\u308c\u305f\u3082\u306e\u3057\u304b\u5012\u3059\u3053\u3068\u306f\u3067\u304d\u306a\u3044\u3002\n\u9b54\u798d\u306f\u30e1\u30ed\u30c7\u30a3\u30a2\u306b\u529b\u3092\u4e0e\u3048\u3089\u308c\u305f\u8005\u304c\u5e38\u901a\u308a\u6226\u3044\u3001\u7d50\u6676\u3092\u7834\u58ca\u3057\u305f\u5f8c\u3001\u30e1\u30ed\u30c7\u30a3\u30a2\u3068\u5171\u306b\u846c\u9001\u306e\u97f3\u3092\u594f\u3067\u308b\u3053\u3068\u3067\u5b8c\u5168\u306b\u6d44\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3002\n\u9b54\u798d\u306e\u767b\u5834\u983b\u5ea6\u306f\u4e00\u56fd\u306b\u4e00\u4f53\u73fe\u308c\u3066\u3044\u308b\u9593\u306f\u4ed6\u306b\u306f\u73fe\u308c\u306a\u3044\u3068\u3044\u3063\u305f\u7a0b\u5ea6\u3060\u304c\u3001\u3054\u304f\u7a00\u306b\u4e8c\u56fd\u540c\u6642\u306b\u73fe\u308c\u308b\u3053\u3068\u3082\u3042\u308b\u3002\n\n\u2015\u30e1\u30ed\u30c7\u30a3\u30a2\u306b\u529b\u3092\u4e0e\u3048\u3089\u308c\u3057\u8005\u2015\n\u54