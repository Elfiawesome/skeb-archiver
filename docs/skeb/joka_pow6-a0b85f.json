c294c5-5453-4283-96e8-4629a7129977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f483a29f04605523c96adf40bbf77c8, https://si.imgix.net/92338746/uploads/origins/70c294c5-5453-4283-96e8-4629a7129977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c052ccfa3f5f7414329a0b3b92f59c31 2x, https://si.imgix.net/92338746/uploads/origins/70c294c5-5453-4283-96e8-4629a7129977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90e0576638cdd9ee7deec0947839f1e1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92338746/uploads/origins/70c294c5-5453-4283-96e8-4629a7129977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7abdea65bb491992d393cb4ca7945bfb", "srcset": "https://si.imgix.net/92338746/uploads/origins/70c294c5-5453-4283-96e8-4629a7129977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7abdea65bb491992d393cb4ca7945bfb, https://si.imgix.net/92338746/uploads/origins/70c294c5-5453-4283-96e8-4629a7129977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=702aa6fd51059f80a7ae5f8d3d6cb266 2x, https://si.imgix.net/92338746/uploads/origins/70c294c5-5453-4283-96e8-4629a7129977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61c65b52781c0028e0350f9d8d5fd332 3x"}, "body": "【おしがま前押さえ禁止令】\nはじめまして\nリリアンちゃんが大変可愛く、依頼させて頂きました！\n\n▼キャラクター\nリリアンちゃん\n\n▼衣装\n制服＋パンツ＋白ニーハイ（URLのスカートハーパンなし衣装）\nor\n制服＋ハーパン＋白ニーハイ（URLのスカートなし衣装）\n私の性癖的に前者ですが、キャラクターにそぐわないなら後者で構いません。\n\n▼シチュエーション\nおしっこしたい！けど前押さえできないっ！\nなセルフ我慢プレイを愉しんでるリリアンちゃんが見たいです。\n後ろ手で縛って「前押さえ出来ないよーっ♡」と悶絶しながら尿意に耐えてるイラストをお願いします。\n限界ギリギリで、身をよじって必死の我慢感があると最高です。\n\n角押さえは以前描かれていたので、本当に押さえるの禁止が希望です。\n\n1枚イラストでOKなのですが、もし気が向けば次のカットもあるとなお嬉しいです！\n・後ろ手のまま、まごつきながらトイレのドアと格闘する\n・手が使えず、お尻を壁や出っ張りに擦りつけて、なんとか脱ごうとする（これもセルフ我慢の一環だったり……？）\n・放尿（脱ぎきれず半脱ぎのまま事実上のおもらしでも可、ただしその場合リリアンちゃんが凹みそうなので、悲しむようなら間に合って放尿でOKです！！）\n\nセルフおしがまする娘って最高ですよね……。\n大好きです。\n\nhttps://twitter.com/joka_pow6/status/1456224456045592576?s=46&t=gtOa9fZpXl72mvIElskf8w", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@joka_pow6/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1351458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54800438/uploads/origins/c29144b4-d90e-48f6-884f-2a4bd1a8f9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16159e41c401ff0b05c94117af11d330", "srcset": "https://si.imgix.net/54800438/uploads/origins/c29144b4-d90e-48f6-884f-2a4bd1a8f9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16159e41c401ff0b05c94117af11d330, https://si.imgix.net/54800438/uploads/origins/c29144b4-d90e-48f6-884f-2a4bd1a8f9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90d8ffac8607a18c31947d91dd82feae 2x, https://si.imgix.net/54800438/uploads/origins/c29144b4-d90e-48f6-884f-2a4bd1a8f9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d4b1aa0e6ff76af3debabbc01a846ea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54800438/uploads/origins/c29144b4-d90e-48f6-884f-2a4bd1a8f9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=981801fe4c8dec0db3a1808eb37d23b9", "srcset": "https://si.imgix.net/54800438/uploads/origins/c29144b4-d90e-48f6-884f-2a4bd1a8f9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=981801fe4c8dec0db3a1808eb37d23b9, https://si.imgix.net/54800438/uploads/origins/c29144b4-d90e-48f6-884f-2a4bd1a8f9d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c0de8e84c04723ba16c4ff827f5535e 2x, https://si.imgix.net/54800438/uploads/origins/c29144b4-