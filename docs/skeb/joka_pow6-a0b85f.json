こ、といったシチュエーションをお願いします。終わった後のおまるはおしっこがなみなみとこぼれるぎりぎりまで入っている状態で、リリアンちゃんは「凄いでしょ」と得意げな様子でお願いします\n　今より年齢が低いので、パンツは子供用の女児ショーツでお願いします。本人はおしっこの色も濃いのを出そうとしていたと想像しているので、オレンジ色のおしっこをお願いします。パンツも厚手の生地がしっかりとオレンジに濡れている状態でお願いします。\n　\n　会話などですが、リリアンは前述のとおり得意げな感じの一方、お母さんは怒っていてその理由の「こんなになるまでトイレに行かなかったこと」「おしっこ中におまるの中から跳ね返りが酷く、周囲にしぶきが飛び散っていること」「パンツにしっかりちびっていること」がわかるような感じにお願いします。\n\n　全部がきつそうでしたら、可能な限りでも大丈夫ですのでよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@joka_pow6/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1351458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6fa2381e360705bc5acf7e10dc371f1", "srcset": "https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6fa2381e360705bc5acf7e10dc371f1, https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f732a631473f949de1bc4c601ed70f50 2x, https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8aa2ef42a2b1a9d2cc8ad6bbecc209e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63b589b873a17440d4aceaf1c7d606ea", "srcset": "https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63b589b873a17440d4aceaf1c7d606ea, https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=649bb68c0cd4baa33a643e3cc13ddf55 2x, https://si.imgix.net/125a9bf3/uploads/origins/b6b18ef5-0e4d-48b0-8bee-354a739e3f1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a69d5eaf9f214d44791c966b896ab3cb 3x"}, "body": "リリアンちゃんがおしっこをたくさん貯めて膨らんだ膀胱を友達に触らせて「これな〜んだ？」と聞かれて友達は食べ過ぎ？と勘違いしてしまうけど\n\nこの後リリアンちゃんが「トイレ行ってくる！」っと言ってリリアンちゃんのおしっこが終わるの(音すご…！)って思いながら待っててトイレから出てきたリリアンちゃんがもう一度膀胱を友達に触らせてすぐに友達が膨らみの正体に気づいて赤面しちゃうイラストお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@joka_pow6/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1351458, "client_id": 423188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81865797/uploads/origins/043289d5-2b9b-410b-9979-2d1a6e5f1aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a6c8ffe5c2eec57769d2319093bb6c", "srcset": "https://si.imgix.net/81865797/uploads/origins/043289d5-2b9b-410b-9979-2d1a6e5f1aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a6c8ffe5c2eec57769d2319093bb6c, https://si.imgix.net/81865797/uploads/origins/043289d5-2b9b-410b-9979-2d1a6e5f1aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23376f94b5a2831165d78bc8358289e4 2x, https://si.imgix.net/81865797/uploads/origins/043289d5-2b9b-410b-9979-2d1a6e5f1aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca81baaea8527ac9e87433bf2c254586 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81865797/uploads/origins/043289d5-2b9b-410b-9979-2d1a6e5f1aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c54123540fabab0c9395207e9d1a345