f70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b1f166bd546299e7a56a3362db62e12", "srcset": "https://si.imgix.net/d857b938/uploads/origins/aa2af70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b1f166bd546299e7a56a3362db62e12, https://si.imgix.net/d857b938/uploads/origins/aa2af70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=748547813759a9adf7598ef988cb3a12 2x, https://si.imgix.net/d857b938/uploads/origins/aa2af70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=136fe9d49027853bbf107ef6875e0900 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d857b938/uploads/origins/aa2af70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d165a5b1c2dc824745d412ca57c2066b", "srcset": "https://si.imgix.net/d857b938/uploads/origins/aa2af70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d165a5b1c2dc824745d412ca57c2066b, https://si.imgix.net/d857b938/uploads/origins/aa2af70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=000e23eb3455b5d50242c394bd2aae45 2x, https://si.imgix.net/d857b938/uploads/origins/aa2af70b-6169-4ad9-b688-4416c41b4a50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68d9f36cfe7eefa5ea69792273d473d1 3x"}, "body": "こんにちは。\nあなたの作品を大変気に入っておりますので、この2人のオリジナルキャラクターを基にイラスト制作をご依頼したいと考えております。\n完成した作品は個人利用（壁紙として）を予定しております。\n\n■ キャラクター設定について\n複数のAU（世界観設定）をご用意しております。お好きな設定を選んで創作してください。複雑な衣装は、必要に応じて簡略化しても構いません。\n\n● 黒髪の女の子\n無口で内向的、少しツンデレな性格で、猫のような女の子です。\n感情表現が苦手で、つい素直でない言い方をしてしまいますが、実は茶髪の女の子のことをとても大切に思っており、視線で追ってしまうことがよくあります。\n文学を専攻しており、本を読むことや甘いものが好きです。\n普段は無表情、もしくは不機嫌そうに見えますが、茶髪の女の子の言動に心を動かされ、微笑んだり照れたりすることもあります。\n\n● 茶髪の女の子\n積極的で優しく、少し腹黒い一面もある、狐のような女の子です。\n自分から黒髪の女の子に話しかけ、いつもにこにこと接します。\n黒髪の女の子に素っ気なくされても気にしておらず、相手も自分を好きだと分かっているため余裕があります。\n音楽を専攻しており、ヴァイオリンを学んでいます。音楽を聴くことや、苦味のある食べ物が好きです。\n\n◆ 現実世界（現代）\n二人は高校の同級生です。\n学生らしい日常の一コマ（勉強、買い物、一緒にお弁当を食べるなど）をテーマに、自由に表現していただければ嬉しいです。\n\n◆ 魔女AU\n・黒髪の女の子は不老の魔女で、人里離れた森の中に自ら建てた木の小屋に住み、古代呪文の研究をしています。\n　前世では茶髪の女の子と恋人同士でしたが、相手は普通の人間だったため寿命を迎え、先に亡くなりました。\n　黒髪の女の子は、記憶を失って転生した茶髪の女の子が再び現れるのを、今も変わらず待ち続け、深く愛しています。\n・茶髪の女の子は人間の魔法見習いで、薬草採集の途中に黒髪の女の子が住む森へ迷い込み、小屋の扉を叩きます。\n　その後、魔法を学ぶために一緒に暮らすようになり、家事や身の回りの世話も手伝います（黒髪の女の子が本を散らかしがちなため）。\n\n◆ 天使×悪魔AU\n孤独を好み、厭世的な黒髪の悪魔 × 軽薄そうで腹黒い茶髪の天使。\n\nhttps://drive.google.com/drive/folders/1xQjcmjs_CRdRkRbmmuYPqteQfTZI2bZn?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momimomi258/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3923129, "client_id": 3297432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80d96435/uploads/origins/2c46fb51-0668-48ce-b684-9bf37fcf344b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06247c5922cfea1c68851a84984e5a5", "srcset": "https://si.imgix.net/80d96435/uploads/origins/2c46fb51-0668-48ce-b684-9bf37fcf344b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d06247c5922cfea1c68851a84984e5a5, https://si.imgix.net/80d96435/uploads/origins/2c46fb51-0668-48ce-b684-9bf37fcf344b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fdac8a4eb78448cab4f2f8d6aa563ba 2x, https://si.imgix.net/80d96435/uploads/origins/2c46fb51-0668-48ce-b684-9bf37fcf344b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1af63d497fb56e2d9d7d452777b8ef06 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80d96435/uploads/origins