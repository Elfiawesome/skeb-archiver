.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98ad3970bd2bb0e7a5ac98165b6aa21f", "srcset": "https://si.imgix.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98ad3970bd2bb0e7a5ac98165b6aa21f, https://si.imgix.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bb65854957bbd4a1d7d56f040a3259a 2x, https://si.imgix.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a02a4d025de6bb2a09533e30550cdc76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b799de50f136c073ca59ecfc7734ed5", "srcset": "https://si.imgix.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b799de50f136c073ca59ecfc7734ed5, https://si.imgix.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebea8905ab460e5216ddc881ac3a16ee 2x, https://si.imgix.net/b1144685/uploads/origins/f892c8bd-178a-4217-81fd-20306f58615b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8329db4c7db58e37d892cdc9d30f534 3x"}, "body": "hello i found. your illustrations and drawings so cute! i was hoping you could draw my oc. she is a shy tsundere girl who is very clumsy. feel free to add her pet calico cat, teru! i would prefer if you could draw her eyepatch and various hairstyles if thats okay!\n\nplease draw the MainDesignFlower outfit reference, and the brown dress or sweater version! i attached model and other references for a better idea of what she looks like!\n\nref: https://drive.google.com/drive/folders/10Io45d5uCvraL76HglmdR-EOUFDC-W2T", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sameco_peropero/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2568439, "client_id": 3504050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92fc4264/uploads/origins/059d8637-b538-4dee-ace7-886df945767f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f33024d90e57fc07ded01fedf2d022", "srcset": "https://si.imgix.net/92fc4264/uploads/origins/059d8637-b538-4dee-ace7-886df945767f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67f33024d90e57fc07ded01fedf2d022, https://si.imgix.net/92fc4264/uploads/origins/059d8637-b538-4dee-ace7-886df945767f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c54a691f9b15148911331a83c1faa09e 2x, https://si.imgix.net/92fc4264/uploads/origins/059d8637-b538-4dee-ace7-886df945767f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd5e4b167d4c7099deb5af908c3e8bbf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92fc4264/uploads/origins/059d8637-b538-4dee-ace7-886df945767f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=212106476ab1a3d7aa89f031ec55a42a", "srcset": "https://si.imgix.net/92fc4264/uploads/origins/059d8637-b538-4dee-ace7-886df945767f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=212106476ab1a3d7aa89f031ec55a42a, https://si.imgix.net/92fc4264/uploads/origins/059d8637-b538-4dee-ace7-886df945767f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl