200&h=200&s=e9b93d1488b143a8067108ebc0abbbbe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/619e1ee1/uploads/origins/ecf28074-2601-43d8-899a-fc3f6feda109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84766b798d81bfb8cfc940af8c2be723", "srcset": "https://si.imgix.net/619e1ee1/uploads/origins/ecf28074-2601-43d8-899a-fc3f6feda109?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84766b798d81bfb8cfc940af8c2be723, https://si.imgix.net/619e1ee1/uploads/origins/ecf28074-2601-43d8-899a-fc3f6feda109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae7ba9510dbcdcd4867b35fce3fbb1c7 2x, https://si.imgix.net/619e1ee1/uploads/origins/ecf28074-2601-43d8-899a-fc3f6feda109?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a057c89494a79012c6169c20c343e03c 3x"}, "body": "はじめまして。\nXにて素敵なイラストを拝見し、リクエストさせていただきました。\n\n個人Vtuberの、紫雲しあさんのファンアートを描いていただきたく思っております。\n\nX: \nhttps://twitter.com/Shia_Shigumo\nYouTube: https://m.youtube.com/channel/UC8rXlO7gXuCPHJoJfOCia_w\n\n可能であれば、ピースサインをしている姿で描いていただければありがたく存じます。\n\nご本人様への紹介や、配信活動での使用をご承諾いただけますと幸甚です。\n\n何卒よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsumug1000_b/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2360072, "client_id": 1979419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f4bcd9106b06924a0466a253523c3ba", "srcset": "https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f4bcd9106b06924a0466a253523c3ba, https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f85e08a83e753d123dc708937f5c19ac 2x, https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=401dd445d8b8b3dd52a4416678659656 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faa3715beb67da70ee776f0cc3d7ae63", "srcset": "https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faa3715beb67da70ee776f0cc3d7ae63, https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=47ba5627695946f475e174a98bc21921 2x, https://si.imgix.net/186ccabf/uploads/origins/c7130c12-f634-4d76-8dce-b630dfb8f62f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb52910dff5c0734d178e1c8b2dffbe3 3x"}, "body": "こんにちは　紡木ヨビト先生初めまして　イラストの依頼をさせていただきたいです\n紡木ヨビト先生のこちらのグル目のいろはちゃんが可愛くて依頼させていただきました\nhttps://x.com/tsumug1000_b/status/1834893342477550040\n\n【書いていただきたい方】\nVarium所属　VTuberの「綿宮あひる」さん(@Watamiya_Ahiru)のイラストをお願いしたいです\n（動物のあひるモチーフのVTuberさんです）\n\nガイドライン的に二次創作は大丈夫です\nhttps://varium.jp/guide_line/\n\n【目的】\n綿宮あひるさんのサムネやXなどの使用です\nVTuber活動に使えるように許可をいただけると幸いです\nまたは自分での鑑賞用です\n\n【リクエスト事項】\n後ろが行き止まりで言い寄られて「これ以上近づかないで、恥ずかしい（あたふた）」のような絵で書いて頂きたいです（いろはちゃんの絵のような感じで…）\nそしてグル目でお願いします\n相手の描写は結構です（あっても影ぐらいでお願いします）\n\nもし可能であれば目をつぶってキス待ちの差分などあればとても嬉しいです\n\n綿宮あひるさんがサムネで使えるように背景なし文字なし（レイヤーを分けたPSDファイル）などあると嬉しいです\n\n【参考資料】\nXの三面図です\nhttps://x.com/Watamiya_Ahiru/status/1673995669454086145\n\n事務所の公式HP（タレントページ）です\nhttps://varium.jp/talent/ahiru/\n\n拙い文章で申し訳ありませんがご検討のほどよろしくお願いします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsumug1000_b/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2360072, "client_id": 1493235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=351303ac4ec5b5fc7e3a5f238ce5b479", "srcset": "https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=351303ac4ec5b5fc7e3a5f238ce5b479, https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9187ced6597fd60bc8b193a49581a4d4 2x, https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5b8da7ae6c3e805e329e99094e48353 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0166e229f9b197a66129399db2766b", "srcset": "https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0166e229f9b197a66129399db2766b, https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56856691ba7a08aa7db33db8a326c3c4 2x, https://si.imgix.net/985c8f4f/uploads/origins/14d46295-fa65-4a9d-8031-a42b35ac12f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab4fbd103e2a7416d5bf23fb0ca74e0d 3x"}, "body": "はじめまして。\n紡木ヨビト先生の絵を拝見させて頂き、\nとても好きなので、イラストのリクエストをさせて頂きたいです。\n\nVtuber「花咲くれは」(@_KRHana) さんを描いてお願いしたいです。\n(ご本人からもファンアート依頼の許可はいただいております。)\n\n◆リクエスト内容\nドーナツを幸せそうに食べているイラストを描いていただきたいです。\n構図やシチュエーションなど、他の要素については全てお任せします。\n\nもし可能であれば、顔まわりの髪、髪の毛は画角内に収めていただけると幸いです。\n\n◆使用用途\n花咲くれはさんへのプレゼントとして、\nご本人に限りの配信活動での使用許可を頂きたいです。\n（配信内や、配信のサムネ、X(旧Twitter)等で使用する可能性があります。）\n\n◆その他お願い\n宛名・人物・背景でレイヤー分けされたPSDで頂けますと幸いです。\n\nお忙しいところ申し訳ございませんが、\nご検討を頂けると幸いです、よろしくお願いいたします！\n\n\n参考資料：\nhttps://x.com/_KRHana\nhttps://pbs.twimg.com/media/GPo9iPmaMAAi7gq?format=jpg&name=large", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsumug1000_b/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2360072, "client_id": 2460352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67857ed8dc390bcd3ee45004f8f04b20", "srcset": "https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67857ed8dc390bcd3ee45004f8f04b20, https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68c6925d977eda9b08b494795941b2c6 2x, https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27052b25684e96656e6075d5ab11ff29 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b6186317f3efcef523ee32a5ddb1521", "srcset": "https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b6186317f3efcef523ee32a5ddb1521, https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae5e49913c5772b031777bce8ae1f79 2x, https://si.imgix.net/1735c547/uploads/origins/2ebe3425-502a-43b4-92e1-f65dc9991a09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb735bc323e69b2c847d8f4a5814ac32 3x"}, "body": "個人Vtuberを応援してます、るると申します。\n\n紡木ヨビト様のイラストがとても好きで是非またリクエストしたいと思い\n自分の好きな個人勢Vtuberの\n兎彷魂あみゅ(@usatama amyu)さんのイラストをお願いしたいです。\n\n構図や表情等はお任せいたします。\n納品日に合わせた季節のイラストでお願い致します。衣装も季節に合ったものだと嬉しいです。\n（可能でしたら、お花見のイラストを描いて頂きたいです。）\n\n■使用用途\nあみゅさんのYouTubeのサムネイルやTwitter広報等で\n使用していただきたいため、\nあみゅさんにのみ使用許可をお願い致します。\n\n本人はファンアートをskebで依頼することは許可しております。\n（https://lit.link/usatamaamyu)\n\n金額内で可能でしたら表情差分をいただけると幸いです。\n\n可能でしたら、「キャラクターだけの透過pngかPSDデータ」もいただけると幸いです。\nなにとぞ、ご検討よろしくお願いいたします。\n\n金額不足等ありましたら、再送頂けますと幸いです。\n\nhttps://pbs.twimg.com/media/FtgJIijaAAEcraa?format=jpg&name=small\n\nhttps://usatama-amyu.fanbox.cc/posts/6177435", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsumug1000_b/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2360072, "client_id": 1608439, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0c7d7b3/uploads/origins/0355dbbc-d6e9-424d-93d9-b7cf6ce45bf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cebaf6f2c9fa57bacf593244d5a9f026", "srcset": "https://si.imgix.net/f0c7d7b3/uploads/origins/0355dbbc-d6e9-424d-93d9-b7cf6ce45bf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cebaf6f2c9fa57bacf593244d5a9f026, https://si.imgi