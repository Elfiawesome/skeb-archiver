eptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@unagino_nakano/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3900ef33dbf8edb466f726b678f5d880", "srcset": "https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3900ef33dbf8edb466f726b678f5d880, https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88a79d43fa9ff1f2dd1c06468a1c17cd 2x, https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=874f4fcac87521a91ccb1668fd3179dc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d619241a91f5afdaf7bc5918de73d4d6", "srcset": "https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d619241a91f5afdaf7bc5918de73d4d6, https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25c9d1134363700aa48277f97a6d5d4c 2x, https://si.imgix.net/5367b250/uploads/origins/e0fd9f5b-8fd9-4127-8cf5-de4052f5eb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91256e70a57970f86a9e113dd5616023 3x"}, "body": "中野様\r\nはじめまして、貴作「Fe（裏カジノ）」には大変お世話になりました。新年早々ではありますが、是非その流れでリクエストさせていただければ幸いです。\r\nキャラクター:ゼシカ\r\n　　　　　　ブチュチュンパ→デスバキューム（時間の経過により人の背丈を超えるほど、人を丸呑みにできるほど成長・進化している）※便宜上、以下もブチュチュンパ表記にします。\n\r\n内容\r\n1.\t再び裏カジノに挑んだゼシカ。前回と同様に「射精回数を当てるゲーム」に挑むが、目の前に前回のブチュチュンパと同じ個体が現れる。ただしその体躯は見上げるほどの大きさになっている。\r\n2.\tブチュチュンパの両手で鷲掴みにされて、大きな唇の目の前まで持ち上げられるゼシカ。ブチュチュンパは再開を喜び、前回のプレイが忘れられなかったのか？とからかう。\r\n3.\tゼシカは口では否定するも、完全に勃起しており、一舐めで射精してしまう。\r\n4.\tブチュチュンパはまた「おそうじ」してあげるといい、ゼシカを丸呑みにする。\n唇からゼシカの頭と手のみ（もしくはおっぱいも）見えており、まるでさらし台のような状態。\n参考）\nhttps://ja.wikipedia.org/wiki/%E3%81%95%E3%82%89%E3%81%97%E5%8F%B0）\r\n5.\tそのまま、苛烈な舌攻めとバキュームによって強烈な快楽に悶えながら何度も射精してしまう…\n\r\n上記のようなイメージでリクエストさせてください。\r\n漫画形式、一枚絵形式どちらでも構いませんが、一枚絵の場合は項目4,5の内容をピックアップしていただきたいです。\n金額および工数により適宜調整ください。その他記載のない事項について（カラー/モノクロなど）はお任せいたします。\r\n\r\n要求の多い依頼となりまして恐縮ですが、ご検討のほどお願いいたします。キャンセルもお気軽にどうぞ。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@unagino_nakano/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67efd45dabcec412d1d78e324a6ad11a", "srcset": "https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67efd45dabcec412d1d78e324a6ad11a, https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5e6582a642c679709ee69764db6ef3d 2x, https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bcf5e1098550d311309f39756068fe2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35071eaeb028063938024adba32224db", "srcset": "https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35071eaeb028063938024adba32224db, https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab63108c0d382d40061c94f95d909bc7 2x, https://si.imgix.net/64b9fbae/uploads/origins/08ee0be5-35bb-4d11-90f9-73eb85529811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1528f29c7f6315341d6c44a8db4e297 3x"}, "body": "先生の絵柄が凄く好きなので、もしよければ先生に描いて欲しいシチュをリクエストさせていただきます。\n\nふたなり娘が触手と交尾をするシチュをお願いします。\n包茎チンポの中に複数個の卵を産卵されて皮の先っぽをきつく締められ皮風船状態になったふたなり娘がチンポを触手で扱かれて射精させられ、皮の中の卵を複数の受精カットイン付きで受精させられるシチュをお願いします。\n可能であればその後皮の中で育った触手達に精液を飲まれる様子があると嬉しいです。\nキャラデザ、世界観設定等は先生の描きやすい形で大丈夫です。\n\n可能であれば引き受けていただけると幸いです。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@unagino_nakano/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0997fd3d/uploads/origins/b64cb5ca-8c6a-4375-84e1-73b3ffa9629a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf38cc462155f967b1212a35c4b7b5c0", "srcset": "https://si.imgix.net/0997fd3d/uploads/origins/b64cb5ca-8c6a-4375-84e1-73b3ffa9629a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf38cc462155f967b1212a35c4b7b5c0, https://si.imgix.net/0997fd3d/uploads/origins/b64cb5ca-8c6a-4375-84e1