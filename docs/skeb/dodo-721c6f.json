-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c43d4aa60099470a4c67edb714b075e", "srcset": "https://si.imgix.net/9ac5dd5f/uploads/origins/6274e605-eca1-41c4-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c43d4aa60099470a4c67edb714b075e, https://si.imgix.net/9ac5dd5f/uploads/origins/6274e605-eca1-41c4-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fdc80cb08f5066500127c61ce57221f3 2x, https://si.imgix.net/9ac5dd5f/uploads/origins/6274e605-eca1-41c4-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbd8c97fec25229967824e1095d2e6d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ac5dd5f/uploads/origins/6274e605-eca1-41c4-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49da40c5280ee8a4ae4d87f2eb023caa", "srcset": "https://si.imgix.net/9ac5dd5f/uploads/origins/6274e605-eca1-41c4-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49da40c5280ee8a4ae4d87f2eb023caa, https://si.imgix.net/9ac5dd5f/uploads/origins/6274e605-eca1-41c4-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e035ac1473cfad990d1720b63361c72 2x, https://si.imgix.net/9ac5dd5f/uploads/origins/6274e605-eca1-41c4-a1ff-995e8feb4855?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13ba2377e326434399a85845f88fb749 3x"}, "body": "DODO\ub2d8, \uc548\ub155\ud558\uc138\uc694! Twitter\uc5d0\uc11c \uc120\uc0dd\ub2d8\uc758 \uba4b\uc9c4 \uc791\ud488\uc744 \ubc30\uacac\ud588\uc744 \ub54c, \uaf2d \uce5c\uad6c\uc640\uc758 \uce90\ub9ad\ud130\ub97c \ubd80\ud0c1\ud558\uace0 \uc2f6\ub2e4\uace0 \uac15\ud558\uac8c \uc0dd\uac01\ud588\uc2b5\ub2c8\ub2e4. \ubd84\uba85\ud55c \uadf8\ub9bc\uc790\uc640 \ubd80\ub4dc\ub7ec\uc6b4 \uba38\ub9ac\uce74\ub77d\uc758 \uc9c8\uac10, \u200b\u200b\uadf8\ub9ac\uace0 \uc778\uc0c1\uc801\uc774\uace0 \uc0ac\ub791\uc2a4\ub7ec\uc6b4 \ub208\ub3d9\uc790\uc5d0 \ub9c8\uc74c\uc744 \ub04c\uc5c8\uc2b5\ub2c8\ub2e4. \uc544\ubb34\ub3c4 \uc815\ub9d0 \ub9e4\ub825\uc801\uc785\ub2c8\ub2e4. \uc544\ub798\uc758 \uce90\ub9ad\ud130\uc5d0 \ub300\ud574 \uadf8\ub824 \uc8fc\uc2dc\uba74 \uac10\uc0ac\ud558\uaca0\uc2b5\ub2c8\ub2e4. \u2500\u2500 \uffe4\uce90\ub9ad\ud130 \uc774\ub984\uff1a\uce7c \uc131\ubcc4\uff1a\ub0a8\uc131\uaca9\uff1a\ucf8c\ud65c\uc73c\ub85c \ud45c\uc815 \ud48d\ubd80\ud55c \uc774\ub984\uff1a\ub9c8\ud0a4 \uc131\ubcc4\uff1a\uc5ec\uc131\uaca9\uff1a\ud504\ub77c\uc774\ub4dc\uac00 \ub192\uace0, \ud488\uc704 \uad00\uacc4\uc131\uff1a\uc18c\uc911\ud55c \uce5c\uad6c(\uce7c\uc740 \ub9c8\ud0a4\uc5d0\uac8c \uc5f0\uc560 \uac10\uc815\uc744 \uc548\uace0 \uc788\uc5b4, \uc774\ubbf8 \uace0\ubc31\uc774 \ub05d\ub0ac\ub2e4. \ub9c8\ud0a4\ub3c4 \uc5b4\ub9ac\uc11d\uc740 \uac83\uc774 \uc544\ub2c8\ub77c, \ubc1b\uc544\ub4e4\uc774\ub294 \uae30\ubd84\uc744 \ubcf4\uc5ec\uc8fc\uace0 \uc788\uc2b5\ub2c8\ub2e4.) \ud76c\ub9dd:\uc120\uc0dd\ub2d8. \uc758\uc0c1\uc758 \ubc30\uc5f4\uacfc \uc0c8\ub85c\uc6b4 \ub514\uc790\uc778\ub3c4 \ud658\uc601\ud569\ub2c8\ub2e4. \uc0ac\uc6a9 \uc6a9\ub3c4: \uac1c\uc778 \uac10\uc0c1, SNS \uc544\uc774\ucf58 \ubc0f \ud5e4\ub354 \uc0ac\uc6a9, \ube44\uc0c1\uc5c5\uc801 \uc0ac\uc6a9, TRPG \uc138\uc158 \uc0ac\uc6a9. \uac00\ub2a5\ud558\uba74 \uce90\ub9ad\ud130\uc640 \ubc30\uacbd\uc774 \ub808\uc774\uc5b4\ub85c \uad6c\ubd84\ub41c PSD \ud30c\uc77c\ub85c \ub0a9\ud488\uc744 \ubd80\ud0c1\ud560 \uc218 \uc788\uc73c\uba74 \uae30\uc069\ub2c8\ub2e4. \u2500\u2500 \uc774\uc0c1\uc774 \ub429\ub2c8\ub2e4. \uc694\uae08\uc774\ub098 \ub0b4\uc6a9\uc5d0 \ub300\ud574\uc11c \ubbf8\ube44\uac00 \uc788\uc73c\uba74, \uc544\ubb34\ucabc\ub85d \uc0ac\uc591\uc5c6\uc774 \uce94\uc2ac\u00b7\uc7ac\uc758\ub8b0\ub97c \ubd80\ud0c1\ud560 \uc218 \uc788\uc73c\uba74 \ub2e4\ud589\uc785\ub2c8\ub2e4. \uc544\ubb34\ucabc\ub85d \uc798 \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4 \ud83c\udf38\n\nhttps://drive.google.com/drive/folders/1nwYBXLAeX3rLVSkpnP8_k2o-B5oMIpuE", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dodo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2964097, "client_id": 2587871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98198c4b/uploads/origins/10c7f5a7-3c13-4652-916a-7ab56ef265a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a2a2343fdec9d8b4b2f079fbd10a7a0", "srcset": "https://si.imgix.net/98198c4b/uploads/origins/10c7f5a7-3c13-4652-916a-7ab56ef265a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a2a2343fdec9d8b4b2f079fbd10a7a0, https://si.imgix.net/98198c4b/uploads/origins/10c7f5a7-3c13-4652-916a-7ab56ef265a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1262ad9a9b8ee5073322b31fdf4c8ce2 2x, https://si.imgix.net/98198c4b/uploads/origins/10c7f5a7-3c13-4652-916a-7ab56ef265a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58207db550ee11a428c6f25f7d368f13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98198c4b/uploads/origins/10c7f5a7-3c13-4652-916a-7ab56ef265a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ef4282c774e2eace4aac02d02129689", "srcset": "https://si.imgix.net/98198c4b/uploads/origins/10c7f5a7-3c13-4652-916a-7ab56ef265a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ef4282c774e2eace4aac02d02129689, https://si.imgix.net/98198c4b/uploads/origins/10c7f5a7-3c13-4652-916a-7ab56ef265a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=072ec8391e9f0e88438ddaef52a7e3e9 2x, https://si.imgix.net/9