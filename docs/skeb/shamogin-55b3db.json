ds/origins/ceb5b9e1-37a4-47e1-a20a-7b1479792d28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7855c5c72dc67de6d0306a9f4437d63f, https://si.imgix.net/c4d7dc82/uploads/origins/ceb5b9e1-37a4-47e1-a20a-7b1479792d28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c02fcb894803f15d77759be786cc6c6 2x, https://si.imgix.net/c4d7dc82/uploads/origins/ceb5b9e1-37a4-47e1-a20a-7b1479792d28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecec9fd1a7ceafb619943ca25a96d364 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4d7dc82/uploads/origins/ceb5b9e1-37a4-47e1-a20a-7b1479792d28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37c5414ca059890a25ae32916c7a61db", "srcset": "https://si.imgix.net/c4d7dc82/uploads/origins/ceb5b9e1-37a4-47e1-a20a-7b1479792d28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37c5414ca059890a25ae32916c7a61db, https://si.imgix.net/c4d7dc82/uploads/origins/ceb5b9e1-37a4-47e1-a20a-7b1479792d28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88a471d41a7af0b4af88294d77f62ba9 2x, https://si.imgix.net/c4d7dc82/uploads/origins/ceb5b9e1-37a4-47e1-a20a-7b1479792d28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=289ba113d98e6cc976fb57eac3bca9c4 3x"}, "body": "こんにちは、はじめまして。貴方の作品にすっかり心を奪われました！もし可能であれば、私のキャラクターを描いていただけないでしょうか。 海外からの依頼なので、文法の誤りはご容赦ください。\n検討していただけたら幸いです。\n\n二人はある宗教団体の教祖と信者であり、幼馴染で親友、家族のような大切な存在です。\n\n▶教祖 白髪 男 21歳\n・天真爛漫、優しい、愛想がいいな人。\n・ぼーっとした感じを与える。\n\n▶信者 藤色の髪 男 21歳\n・明るい、礼儀正しいな人。陽キャ。\n・教祖様をお世話し、支えている。\n\n▶関係性\n双方に恋愛感情はありません。\n二人は共依存のような重い感情を抱きつつも、普段は仲の良い親友に見える。\n\n▶テーマ\nもしよろしければ、「ステンドグラス」や「水族館」をテーマにお願いしたいと思っています。ポーズや構図は、どうかお好きなようにお任せいたします。\n\nまた、金額や問題がありましたらお手数おかけしますが再送要望やキャンセルいただければと思います。\nご検討のほど、よろしくお願いいたします。\n\n▶立ち絵と参考に使えそうな落書きなど\n\nhttps://drive.google.com/drive/folders/1zvMSyl6-tKOoItHjcuRd9hCFC--lFm-H?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shamogin/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3411579, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4279adcf566c8cc73b13eb6fa9ecfa0f", "srcset": "https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4279adcf566c8cc73b13eb6fa9ecfa0f, https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ddc7c77d3583c31af6dcad333350205 2x, https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=986f9c550f67fafab8acc8fd0301b25b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f420e1c21b171fb13e72c71c7fdbfcfd", "srcset": "https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f420e1c21b171fb13e72c71c7fdbfcfd, https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=478274a8868713f674114fb2ee4118d0 2x, https://si.imgix.net/c72c517e/uploads/origins/e5ec8073-0940-4711-9795-6ca08fb8625e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bc1f3e44b98435866c8ae15294cef54 3x"}, "body": "はじめまして！\nこのOCのイラストをかっこいい背景で描いていただけませんか？\n\nルーファス\n昆虫の研究が好きな魔道士で昆虫学者。モンスターと戦うよりも、モンスターをペットとして集めるのが好き。彫像、呪文書、宝石など、魔法のアーティファクトを集めるのが好き。\n\nローハン\nルーファスの護衛を務める騎士。敵対するモンスターと仲良くなろうとするルーファスが危険な目に遭ったとき、ローハンはルーファスを助ける。\n\n城や酒場、美しい自然が広がるヨーロッパ中世ファンタジーの世界。\n2人のOCは、モンスターを召喚しようとする邪悪なカルト教団と戦い、邪悪な魔法の暴走を封じ込め、奇妙な生き物を研究しながら世界を旅する。\n\n構成は自由にデザインしてください。例えば\n悪の要塞に近づく\n森で不思議な昆虫を研究する。\n古代の遺跡で宝探し。\n興味深い城下町を通過する。\n自分でデザインした景色の中を旅する。\n\nこのリクエストをお読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/12JjZsvrTmq8ZGrm4bRwT811ZQ4w1WEKf?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shamogin/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3411579, "client_id": 2351236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ac58060/uploads/origins/adc8c29b-e8fd-45c5-892f-9645b803de58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb4128efd3cc5375f073e824771ddeef", "srcset": "https://si.imgix.net/0ac58060/uploads/origins/adc8c29b-e8fd-45c5-892f-9645b803de58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb4128efd3cc5375f073e824771ddeef, https://si.imgix.net/0ac58060/uploads/origins/adc8c29b-e8fd-45c5-892f-9645b803de58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35cc8fd1545825f38d4b3f153eae4d77 2x, https://si.imgix.net/0ac58060/uploads/origins/adc8c29b-e8fd-45c5-892f-9645b803de58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=331b42118eb025fbd3cedf2daf62ab77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ac58060/uploads/origins/adc8c29b-e8fd-45c5-892f-9645b803de58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08a8e11e0d0f98e