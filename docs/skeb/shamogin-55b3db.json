ploads/origins/5cb264cc-c91f-4360-a523-3e30b2d8b043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b2d3e3d91b50f82a9c7520becf567f3, https://si.imgix.net/48ad0370/uploads/origins/5cb264cc-c91f-4360-a523-3e30b2d8b043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb4452ae15b0ddf5ba6f61b24a80a274 2x, https://si.imgix.net/48ad0370/uploads/origins/5cb264cc-c91f-4360-a523-3e30b2d8b043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=142fa88786056d2bd4c3bb7f93f28b78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48ad0370/uploads/origins/5cb264cc-c91f-4360-a523-3e30b2d8b043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=badfe914ba2b771349f222245be66c03", "srcset": "https://si.imgix.net/48ad0370/uploads/origins/5cb264cc-c91f-4360-a523-3e30b2d8b043?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=badfe914ba2b771349f222245be66c03, https://si.imgix.net/48ad0370/uploads/origins/5cb264cc-c91f-4360-a523-3e30b2d8b043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1b0fe61200c2c04035018e28fb48ac5 2x, https://si.imgix.net/48ad0370/uploads/origins/5cb264cc-c91f-4360-a523-3e30b2d8b043?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0c03e947cb76bf55c7e1e20ffbac7c1 3x"}, "body": "こんにちは！あなたの背景イラストはとても美しいですね。\n\nみのり（黒髪）｜画家。臆病で優しく、ちょっと臆病。動物と自然が大好き。霊や悪魔が見える。\n\nココ（ピンク髪）｜いいところもある不良。優しくておおらかだが、すぐキレる。\n\nストーリー\n彼らの物語の舞台は2000年代初頭の孤島。彼らの町では行方不明者が増えていた。彼らは協力してその背後にいる人物を追い詰めるが、それが悪意のある霊であることが判明する。その霊は蝶で表すことができる。\n\n町の様子を説明するコラージュボードを載せました。日本の昔ながらの田舎で、葉っぱや自然がたくさんあります。彼らの町を歩いているところを描いてもらえるとうれしいです。ホラーがテーマだと嬉しいです。\n\nあなたのこれらの作品の構図が好きです：\nhttps://skeb.jp/@shamogin/works/2\nhttps://skeb.jp/@shamogin/works/9\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/13SKRzv84i_ltuaohFINxVD4zNMl9-ENO?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shamogin/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3411579, "client_id": 32470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5204c8223da1707e7624a9b53bcb07b", "srcset": "https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5204c8223da1707e7624a9b53bcb07b, https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67e6b9d28a2081334d85e6245b0bee5a 2x, https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=405fe2e8c34c7e23c9d31e2112c87cf4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e4e90dd9abd6745edf0a862b3f0553c", "srcset": "https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e4e90dd9abd6745edf0a862b3f0553c, https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e96e8b18aaaf591f61215fa9d391d2a 2x, https://si.imgix.net/0510d0d0/uploads/origins/1f943cfe-137b-4a6b-af6c-16df100b804a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6e7fe6ed04d63405a4e8fcaa6d973c8 3x"}, "body": "こんにちは！超常現象を研究し、その危険から人類を守るためのSF的な地下施設の背景を依頼したいです。\nSF的な背景を描くのが苦手である場合は遠慮なくお断りください。\n\n背景は以下の要素を含むものを希望します：\n\n・強化ガラス窓のある少なくとも2つの観察室\n・1つの観察室には、異常な特性を示す平凡なオブジェクトがある（例：グリッチアウトしているように見える木）\n・1つの観察室には、手錠をかけられた人間が座っている\n・豊富な蛍光灯照明\n・冷たく臨床的な雰囲気\n\nイメージ画像を添付します。\nよろしくお願いいたします！\n\nhttps://ln5.sync.com/dl/a6297f240/rfsgdd84-fhx2yjzy-3xmumgc9-d27485bp", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shamogin/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3411579, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31c499bb/uploads/origins/667ed81f-b363-45f9-a693-c80ec1195d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b95a766180f1f3b9bafe7d012174c582", "srcset": "https://si.imgix.net/31c499bb/uploads/origins/667ed81f-b363-45f9-a693-c80ec1195d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b95a766180f1f3b9bafe7d012174c582, https://si.imgix.net/31c499bb/uploads/origins/667ed81f-b363-45f9-a693-c80ec1195d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee00cf7e402fa05abb5437cf2c2b94b9 2x, https://si.imgix.net/31c499bb/uploads/origins/667ed81f-b363-45f9-a693-c80ec1195d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a0046b57e166c176d68a6e1d7405133 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31c499bb/uploads/origins/667ed81f-b363-45f9-a693-c80ec1195d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7245c889742e8d756bf43f1e99a6c89", "srcset": "https://si.imgix.net/31c499bb/uploads/origins/667ed81f-b363-45f9-a693-c80ec1195d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7245c889742e8d756bf43f1e99a6c89, https://si.imgix.net/31c499bb/u