写に際してお苦手でしたり、心証やポリシーなどがありましたら、この点は省いてしまわれても大丈夫です。\n芹沢の公式の各種パーツ原型はあくまで一枚目ですが、できれば外套着用の二枚目のような衣装描写を踏襲して頂ければ助かります。\n\n以上となります。\n\nリクルティカさまのご身辺、いまのところご多忙の極みに不躾に申請をお送りしますところ、たいへん恐悦至極ではございますが、\n余裕のあるお手隙な頃合いにでお構いありませんので、上記内容の何卒ご精査の程、よろしくお願い申し上げます。\n\n芹沢 時雨", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F47994259-bcb8-424d-a8b9-bdb8dcdcf3e9.webp?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/1ea3f764-db03-4376-8bf2-61f2fc087b7b.png", "appeal_receivable": true, "popular_creator_rank": 67, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1309924, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "いずみ👺🌙(Izumi) COMMS OPEN", "screen_name": "izuuumi831", "avatar_url": "https://pbs.twimg.com/profile_images/1904552158185598976/CldGdg_8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1255139317950767106/1692440892/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2806115, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "jon終_♪", "screen_name": "bibokunouta", "avatar_url": "https://pbs.twimg.com/profile_images/2016070723643834369/LJCh1PJD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1531212274706223105/1767453372/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null,