t/5354ccef/uploads/origins/b31078ec-e62c-4e7d-938b-3179911eb261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34719526b6d0aaf2e3788d4f76719726, https://si.imgix.net/5354ccef/uploads/origins/b31078ec-e62c-4e7d-938b-3179911eb261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efe6595fd0cb0e2fcf18977a0a97a9cc 2x, https://si.imgix.net/5354ccef/uploads/origins/b31078ec-e62c-4e7d-938b-3179911eb261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b26c54da870cb29ea38f4586f1f3f0ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5354ccef/uploads/origins/b31078ec-e62c-4e7d-938b-3179911eb261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23497a1d44e1f4dbee466f2f7c67509d", "srcset": "https://si.imgix.net/5354ccef/uploads/origins/b31078ec-e62c-4e7d-938b-3179911eb261?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23497a1d44e1f4dbee466f2f7c67509d, https://si.imgix.net/5354ccef/uploads/origins/b31078ec-e62c-4e7d-938b-3179911eb261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf3f61de13df73626e1bf51776ff2cd9 2x, https://si.imgix.net/5354ccef/uploads/origins/b31078ec-e62c-4e7d-938b-3179911eb261?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7484c008ac611124f2c3d96bd4012044 3x"}, "body": "ソレデ様、はじめまして。\nskeb新着でイラストを目にしまして、pixivも拝見しました。\n民族服や獣耳の描き方がとても素敵です。\nもしよろしければわたしのOCを描いていただけないでしょうか。\n\n\nOC①\nリュシアン(28歳/187cm/男性)\n・竜騎士、騎士団副団長\n・パートナーは黒竜(暴君)\n・狐の獣人(ベースは人間と同じ。狐耳、尻尾。人耳不要)\n・黄金色の短髪\n・青磁色の瞳\n・身丈程ある大斧がお気に入りの武器\n・綺麗な顔立ち\n・自他に厳しいが、エリオットは甘やかしたいし世話を焼きたい\n\n\nエリオット(19歳/167cm/男性)\n・雨を降らせることができる魔術師(人間)\n・各地を回る旅人\n・肩甲骨下あたりまでの黒髪、基本三つ編み\n・黒色の瞳\n・可愛らしい顔立ち\n・臆病だが、芯はしっかりしている\n\n\n◎獣人と人間が共存する世界\n◎竜をパートナーにして戦う竜騎士がいる\n\n使用目的として、SNS(Ｘ)、小説投稿アプリ、印刷して個人鑑賞を予定しています。\nモノクロ、カラー、どちらでも構いません。\nご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s0rdneee16/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3369806, "client_id": 2593266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fd5dd94eaa40e510fbef9d620cdd52", "srcset": "https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74fd5dd94eaa40e510fbef9d620cdd52, https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb9b2f9e588a1010c7fcd1035bd6dcd0 2x, https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96cc740e3326dfe52dbd692c5ab8a28e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd2484f4ffa4e456437ce05d45aa2927", "srcset": "https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd2484f4ffa4e456437ce05d45aa2927, https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d705f7a790021a8d64b9abef966c2b9c 2x, https://si.imgix.net/66914b10/uploads/origins/a5bae746-1cb0-4597-bd28-56b5658f20db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b327e5295f785abbe91b0f8f7b959105 3x"}, "body": "初めまして。ソレデ@skeb募集中さん。skebで貴方のイラストを見て、是非依頼させて戴きたいと思い、送らせて戴きます\n\n　今回は、【栄枯盛衰】と云うオリジナルの異形の獣の描いて戴きたいと思います\n\n　ベース：金毛の狐\n　頭部：身体に比べて小さい。耳の近くに樹木の双角\n　眼：六つ三対の猫目、右：若草色、左：灰色\n　口：大きく裂けて牙が並ぶ\n　脚：肉食獣の四足に、背部に飛膜の付いた脚腕。モンハン的に云うならばマガラ骨格\n　背中：様々な植物が生えている\n　尾：蔦が絡み付く九尾\n　体長：３０m程イメージ。イメージは何となくの例なので、別にかなり大きく感じれば問題ありません\n\n　設定として、ビル等の人工物を崩壊させ、動植物を生み出す能力を持つ異形の獣の様な神性存在です\n\n　シチュエーション等はお任せします\n\nイラストはIRIAMやTwitter等のアイコンに使用したと思っています。\n\n宜しくお願いします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s0rdneee16/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3369806, "client_id": 3357983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b97092aa/uploads/origins/656028dd-c363-4f0f-a488-05e934658e70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40a19486be6957e0ccb1613685c95a6b", "srcset": "https://si.imgix.net/b97092aa/uploads/origins/656028dd-c363-4f0f-a488-05e934658e70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40a19486be6957e0ccb1613685c95a6b, https://si.imgix.net/b97092aa/uploads/origins/656028dd-c363-4f0f-a488-05e934658e70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73ea78a6ce76f673456fec966a28f7e4 2x, https://si.imgix.net/b97092aa/uploads/origins/656028dd-c363-4f0f-a488-05e934658e70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c36f0e1e071b71509313cdca3c0bfa01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b97092aa/uploads/origins/656028dd-c363-4f0f-a488-05e934658e70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48b8754fc908cefd446ff9c7e85518c4", "srcset": "https://si.imgix.net/b97092aa/uploads/origins/656028dd-c363-4f0f-a488-05e934658e70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro