思いますが\n面倒でしたら海は建物で隠れてても良いかなと思います｡\n\n川も建物等で隠れてるかなとは思います｡\n見えたとしても少しですかね｡\n\n岩は高さ18m、地面に埋まってる部分が5〜6m四方なので\n街並みから飛び抜けて岩が見えてる風景となります｡\n\n天気は晴れです｡\n画角的に南の方を向いてるんで\n太陽に向かう方向の構図になるかとは思いますが\n太陽は描かないでも良いかなと思います｡\n\n太陽の位置関係で\n影が撮影者の方に向いてる感じになりますかね｡\n\nこんな感じでよろしくお願いいたします｡", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 5374, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いーたん＆mikokoたん", "screen_name": "mikoko1", "avatar_url": "https://pbs.twimg.com/profile_images/1610031912646750209/1qqEk7cE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/106337453/1592824437/1500x500", "appeal_receivable": false, "popular_creator_rank": 67, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 89083, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こころりP(オカザキ)", "screen_name": "ccll_ok", "avatar_url": "https://pbs.twimg.com/profile_images/1023749560982622208/BZIGxKzh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/182193968/1470010307/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 152}, {"id": 1331846, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "人楽愛一", "screen_name": "jinrakuaiichi", "avatar_url": "https://pbs.twimg.com/profile_images/1472996916393025536/3x8OHJZW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/868718848224014337/1696303599/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acc