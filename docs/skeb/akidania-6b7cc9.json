776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ddeb43d5e04b315f43adb01060e9029 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dab309a092de9d2851fc4df24061190", "srcset": "https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dab309a092de9d2851fc4df24061190, https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75422a885d4577aea32a01bd494be40b 2x, https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6571bf1923e20ca8c3efa77ae702a628 3x"}, "body": "お世話になっております！\nkitaruさんの明るく可愛いイラストが好きです。\n宜しければkitaruさんの明るい絵柄で、当方と友人の創作キャラを思うように描いて頂ければ嬉しいです。\n\n◇キャラクター\nリリー\nジェイド\n\n――\nジェイドに関しては概念、手等の体の一部での描写でも嬉しいです。\n（難しい場合はメイン：リリー一人で大丈夫です…！）\n描写範囲は金額に無理のない範囲でお願いします。\n\n目線こちらでなくて大丈夫ですので、宜しければ日常のような雰囲気のもの。\n難しければ描いて頂けるだけで嬉しいので、描きやすいポーズでおまかせします…！\n服装アレンジ、髪型等も変更していただいて大丈夫です。\n\n◇使用用途\n個人観賞、また、印刷業者を通した個人利用の範囲のグッズ（ポストカード等）にさせて頂きたいと思っております。\n\nご検討のほどよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1yCVUdd4mUwwc5SDBh5_L5HOcc4lwsCwZ?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akidania/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1222028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e7405ab/uploads/origins/1089301b-e5c5-4fde-b9dd-74e259910594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20