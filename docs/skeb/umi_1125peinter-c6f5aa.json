x, https://si.imgix.net/a1d1254f/uploads/origins/a647ecf0-3c95-49f3-af34-b1e80e9c5088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd8f6031da781363087e77902c7e4c8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1d1254f/uploads/origins/a647ecf0-3c95-49f3-af34-b1e80e9c5088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2d6a93ae32bdd95c2b94eaaef330cd", "srcset": "https://si.imgix.net/a1d1254f/uploads/origins/a647ecf0-3c95-49f3-af34-b1e80e9c5088?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2d6a93ae32bdd95c2b94eaaef330cd, https://si.imgix.net/a1d1254f/uploads/origins/a647ecf0-3c95-49f3-af34-b1e80e9c5088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81a28b8d8e1ef889018f40db395c8b21 2x, https://si.imgix.net/a1d1254f/uploads/origins/a647ecf0-3c95-49f3-af34-b1e80e9c5088?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56cabf130a7e9708d5fb85dfd6a674de 3x"}, "body": "いつも素敵な絵をありがとうございます。  今回もキャラクターデザインと一枚絵(個人利用)をお願いします。 通訳クロベさんと同じ世界観のキャラです。特徴は以下です。 描きにくいと思ったら無視していただいて大丈夫です。\n\n・人に擬態した人外です\n・イメージカラーは赤です\n・髪も赤です\n　本人(?)は暮れも明けもしないと言います\n・モチーフはヒオドシジュケイです\n・オネエさんに喧嘩を売って、高値でお買い上げされました\n・真珠のヘッドドレスを装着しています\n　資料のようなイメージです\n　色はお任せします\n・ふわふわの角を持っていますが普段は格納しています\n・紐の多い服装にしてください\n　自前のパーツです\n　人の身体を真似るより、衣服を真似る方が楽だと判断したようです\n・紐はストラップでもタイでもベルトでもコードでも構いません\n・紐のうち少なくとも3本は、明らかに引きずる長さのものをお願いします\n　自分の体なので、転んだり絡まったり千切れたりはしません\n　脚として使うのは稀ですが、平時も良く見れば蠕動してるかも\n・クロベさんにはパリピ輝く配達員だと思われています\n　報告書の存在とイコールになってません\n・瑠璃さんのバー出禁です\n・服のデザインが左右非対称だと嬉しいです\n\n構図は、全身が見えていればどんなものでも構いません。表情もお任せします。\n\n以上です。\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/u5279uggf7ovor7pde8k1/AG4d9z8hX6LE7ODrsJ-tmGk?rlkey=p9ai1ostovmtcaibklouvux9u&st=1d6lgyn6&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umi_1125peinter/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 986012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cf738c3b356e0e82e2a3f34e004758", "srcset": "https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9cf738c3b356e0e82e2a3f34e004758, https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65b95f958817898ed744ee363b27436c 2x, https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f4a11b7753a45eec716994e035774d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3965fd01e4c6d3a231422c0a5305dc2d", "srcset": "https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3965fd01e4c6d3a231422c0a5305dc2d, https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebf150bbcda8049dcc78f7e8b2299c2a 2x, https://si.imgix.net/db646fed/uploads/origins/01c83df9-275d-4a44-a499-0aad16a87a7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60b7f51dd02bc1e94b645ddee9916603 3x"}, "body": "いつも素敵な絵をありがとうございます。 \n今回はデザインと一枚絵(個人利用)をお願いします。 \n前回描いていただいたオネエさんの、カチコミのすがたをお願いします。\n特徴は以下です。\n描きにくいと思ったら無視していただいて大丈夫です。\n\n・イヤーマフ\n　付けてても外してても構いません\n・杭のような武器\n　プラモデルでいうランナーみたいなパーツをつけてください\n　先端(この人から見て遠方、相手側)を平たくしてください\n　これを動く小さい的に当てるのか？というサイズであればなおオッケーです\n・大盾\n　制圧用です\n　ほんのりとした灯りにも鈍器にもなります\n　遠くから見ると宝飾品に見えるかもしれません\n　この人のことだから、きっとどこかで削り出したのでしょう\n・シルエットすっきりの足元\n　布やガレキでひっかけないようにしてます\n・宝石のブローチ\n　勲章の残骸です\n　大部分を千切って捨てて、残ったパーツをブローチに加工しました\n・小道具\n　パイプレンチやらミノやら、工事現場の道具を携行しています\n　その中に、この人の生家の鍵が紛れています\n\n以上になります。\n\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umi_1125peinter/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 986012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dbe95133f4ed16f47bcb1cf6a7a5bdf", "srcset": "https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dbe95133f4ed16f47bcb1cf6a7a5bdf, https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89c1e13f4866586447d77cfd0a835a34 2x, https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbc475b575302c854434eacdd7552a91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcb98ebd8d999fb1482721aca1ffb942", "srcset": "https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcb98ebd8d999fb1482721aca1ffb942, https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9685914b4b97c5c65126384259d45b8f 2x, https://si.imgix.net/8323237b/uploads/origins/68865c55-fcd8-499b-b36e-668c2c4f628b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d18676c68a7d8219b53e303154c2fa46 3x"}, "body": "いつも美麗なイラストを楽しみにしています。\n\n＜キャラクター＞\n・黒髪地雷系のイメージ\n・髪型：黒髪ロング、ピンクメッシュ\n・服装：地雷系ファッション（黒のTシャツ、チェックのミニスカート）\n　参考（https://image.rakuten.co.jp/acdcrag/cabinet/17/jr-488-123_1.jpg）\n\n＜構図＞\n・光源は通常の明るさ（人物や周囲が暗くなったり、逆光になったりしない）\n・シンプルな白背景\n・表情は照れ笑い（目は閉じない、口を開けた状態）\n・ポーズは画面正面向きの体育座り＋内股（両ひざをくっつけて足を左右に開く）\n・手は膝付近に沿える\n・スカートの背面はおしりの下に敷く\n・スカートの裾は足の間に挟まず、パンチラ（白）が見えた状態\n\n参考イメージ\nhttps://skeb.jp/@Yd8wX/works/3\nhttps://skeb.jp/@yashuring/works/95", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umi_1125peinter/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 986012, "client_id": 997748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64bab1114982da57380f8034370221a4", "srcset": "https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64bab1114982da57380f8034370221a4, https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=611006afdf054e85918f255ba469e523 2x, https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd3d593e6704f666b1abf46fef478697 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a97b301bc752a6b54c73b1cf304c85d0", "srcset": "https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a97b301bc752a6b54c73b1cf304c85d0, https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=589dc44e9db712531b94fc3ecca7e2a3 2x, https://si.imgix.net/4f5b7047/uploads/origins/900d9c09-4188-4632-8f2d-8eefaae409da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=047925ba98ebac7cd5a5e27812535857 3x"}, "body": "いつも素敵な絵をありがとうございます。 今回も、キャラクターデザインと一枚絵(個人利用)をお願いします。 またしても通訳さんたちと同じ世界観の人です。 特徴は以下になります。 \n\n・男性\n・ハンドメイドの宝飾デザイナー\n・グラサン常備\n・上着やショールで体格をごまかしている\n・いつもにこにこ強者の微笑み\n・貴金属からガラスまで幅広く取り扱う\n・店舗兼工房には滅多に戻って来ない\n・自分で素材を買い付けに行くタイプ\n・フィジカルお化け。不眠不休で大陸横断して宝石を買い付け、鉱脈探しに専門家がいるとなると専門家とピッケル担いで山に向かう\n・デザイン元の虫とか花とかを近所の子に頼んで取りに行ってもらったり。お仕事の報酬よとお小遣い渡したり。\n・お姉さんに言葉を教えてもらったのでオネエ口調、母語だとやたら古めかしい口調だとか\n・瑠璃さんのバーに出現すると朝まで飲んでいる。瑠璃さんのバーにあるグラスは全部この人の作品\n・解体専門の爆弾魔\n・他の爆弾魔との頭脳戦を楽しんでいるとか、いないとか…\n・親友だと思っていたやつが自分の真作を爆弾に組み込みやがったので、逆上してパイルバンカーとライオットシールドと機関銃担いでカチコミをかけに行ったこ\n・↑の一件で通訳さん一行と初エンカした\n・イメージカラーはモスグリーン\n\n構図は全身が見えていればどのようなものでも構いません。 この人の年齢も指定しません。また、上記の特徴で描きにくいと感じたものがあれば、省略していただいても大丈夫です。 よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umi_1125peinter/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78902898/uploads/origins/5ec375fe-f495-4478-a445-4d5b79fc2888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s