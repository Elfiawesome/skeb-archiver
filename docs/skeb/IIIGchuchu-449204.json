w=200&h=200&blur=200&s=18c4107df393d1e3a8a8e3acbcfa252f 3x"}, "body": "ちゅわわ様\nこんにちは!!VTuberの雨音鈴と申します。\n以前ちゅわわ様にFAを描いて頂き、とても可愛くてもっと見たいな✨となったので\nこの度、雨音鈴のイラストを描いて頂きたくリクエストさせて頂きます。\n\n◇雨音鈴について◇\n水色髪に紫メッシュの入った猫のVTuberです\n主に歌や雑談、ゲーム配信をしています\n紫陽花の花が好きで、色は明るい寒色系が好きです\n◇参考資料◇\nhttps://twitter.com/Amane_Rinv/status/1576193195599593472?s=20\n\n◇使用用途◇\n・Twitterでの利用\n・YouTubeのサムネイルなど\n\n衣装や構図、ポージングなどは、ちゅわわ様におまかせ致します。\n宜しければキャラのみの透過データを別で頂けると幸いです。\n\nお忙しい中恐縮ですが、ご検討の程よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@IIIGchuchu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2118907, "client_id": 1837181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c5f23a9/uploads/origins/989a990e-7c40-40c3-bef1-e455dc24722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eed6b17fc4e173caef465942e4370cb3", "srcset": "https://si.imgix.net/1c5f23a9/uploads/origins/989a990e-7c40-40c3-bef1-e455dc24722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eed6b17fc4e173caef465942e4370cb3, https://si.imgix.net/1c5f23a9/uploads/origins/989a990e-7c40-40c3-bef1-e455dc24722d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e3617233860262f0610b630489a7bf4 2x, https://si.imgix.net/1c5f23a9/uploads/origins/989a990e-7c40-40c3-bef1-e455dc24722d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ca8e5d0e2c3347a7cca7b1f7efa6de9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c5f23a9/uploads/origins/989a990e-7c40-40c3-bef1-e455dc24722d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3f7f0195bfbe081db228828186d0c88", "srcset": "https://si.imgix.net/1c5f23a9/uploads/origins/989a990e-7c40-40c3-bef1-e455dc24722d?bg=%23fff&auto=format%2Ccompress&fm=webp