簡易のものでもあるととても嬉しいです！)\n・♛様の気分で衣装／髪型は改変してしまっても構いません、似合うと思うお洋服を着せていただけると嬉しいです！\n・描写範囲は股下～膝上くらいまであると嬉しいです\n・可能であれば表情差分を頂けますと活動の際とても助かります！\n\n◆使用目的\n・収益化済みのYoutube /各種SNSにて投稿/FANBOXにてイラスト公開/可能であればグッズ化(必須ではありません、NGでも◯）\n\n希望はもちろん無視していただいても構いません♛様の可愛い！と思うように楽しく描いていただけたら幸いです。\n\n筆が進めば是非よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1Q9sWSc6j24fMQ4KhtifVbydZcxSDNvG-", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@f0bLv95bwU32258/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3751441, "client_id": 2330445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/861cfd6a/uploads/origins/1ad6cdfd-b263-49d2-81d9-a847067a43ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85f82a487c1f9b68568300415975de29", "srcset": "https://si.imgix.net/861cfd6a/uploads/origins/1ad6cdfd-b263-49d2-81d9-a847067a43ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85f82a487c1f9b68568300415975de29, https://si.imgix.net/861cfd6a/uploads/origins/1ad6cdfd-b263-49d2-81d9-a847067a43ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2d47b0174add701eb80dfd97a7183ea 2x, https://si.imgix.net/861cfd6a/uploads/origins/1ad6cdfd-b263-49d2-81d9-a847067a43ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=206409d49f07f7706de9c800c6ef1635 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/861cfd6a/uploads/origins/1ad6cdfd-b263-49d2-81d9-a847067a43ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54ea76189bf073ecbd153c59ca0b3162", "srcset": "https://si.imgix.net/861cfd6a/uploads/origins/1ad6cdfd-b263-49d2-81d9-a847067a43ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54ea76189bf073ecbd153c59ca0b3162, https://si.imgix.net/