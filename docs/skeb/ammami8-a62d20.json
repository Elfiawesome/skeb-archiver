さんの他にも資料になりそうな写真を添付しておきます。\n\nアングルなどイラスト全般について全てお任せします。これまでの作品がどれもよかったので。センスを信じています！\n\n宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/10IloCXm9idOF8KpVViXO9ZG44V9RBwfk?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ammami8/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dc0d0e57/uploads/origins/547db645-5ef1-4e6e-af0b-a6772658b9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f066d63f0876c0fed2e44045d4fbd7d", "srcset": "https://si.imgix.net/dc0d0e57/uploads/origins/547db645-5ef1-4e6e-af0b-a6772658b9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f066d63f0876c0fed2e44045d4fbd7d, https://si.imgix.net/dc0d0e57/uploads/origins/547db645-5ef1-4e6e-af0b-a6772658b9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0d1980c4dfc7676aff4be914ade1fa5 2x, https://si.imgix.net/dc0d0e57/uploads/origins/547db645-5ef1-4e6e-af0b-a6772658b9a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a78f3e3957efe952197bf6c37831740c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2292225, "client_id": 3553598, "nc": 163}, {"path": "/@ammami8/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2292225, "client_id": 1088634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b981396/uploads/origins/3a79feed-bbe2-4174-a7c7-1bd2b21b88d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50846aa