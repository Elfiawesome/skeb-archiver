webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ba5e356358e811a1c8abe7d2973b179", "srcset": "https://si.imgix.net/57c90ffa/uploads/origins/8b9d3527-0f8b-4228-93f7-cbcdb8899979?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ba5e356358e811a1c8abe7d2973b179, https://si.imgix.net/57c90ffa/uploads/origins/8b9d3527-0f8b-4228-93f7-cbcdb8899979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac9675be56757a4ebf5159a461bdf8d 2x, https://si.imgix.net/57c90ffa/uploads/origins/8b9d3527-0f8b-4228-93f7-cbcdb8899979?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f020c83ada0a05fdf93428a21b42f9f 3x"}, "body": "先生、こんにちは。私のキャラクターのイラストを1枚依頼したいです。彼は57歳の年老いたカワウソで、障害者であり、左足は義足です。職業はエンジニアです。参考リンク：https://drive.google.com/drive/folders/1-3iZqFqNE8kckvMU1cx100KVfX2IwLMw画面内容は先生のご自由にお任せします。\n\nhttps://drive.google.com/drive/folders/1-3iZqFqNE8kckvMU1cx100KVfX2IwLMw", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ammami8/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2292225, "client_id": 1088634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6c287a2b5f2a7d32f1e2d990cf58930", "srcset": "https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6c287a2b5f2a7d32f1e2d990cf58930, https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30a7f55594cec85ff84096ddc1c34fa0 2x, https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=272bbcdff8b4ffbf5b61ae8d0615afa0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0d72796334adae24d78f5e0c2bb26d2", "srcset": "https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0d72796334adae24d78f5e0c2bb26d2, https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee3506eed3607127315e4e2cdcfe458a 2x, https://si.imgix.net/39b087d4/uploads/origins/aeb675f2-c226-4c7a-8aa7-3870b6ff943c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=497a5dd26e8c7c179a4d7ff1880d778f 3x"}, "body": "こんにちは。先日は素晴らしい作品を仕上げてくださってありがとうございました。\n気に入ってるのは二つ目のファイル。上半身のみにトリミングしてエフェクト？が付いてるものです。イラスト自体は格好いいんですが、背景や表情、エフェクトも合わさってポップで可愛く仕上がっていました。PCの壁紙にぴったり！お気に入りです。\nまだ数日も経っていないんですがまた依頼します。お忙しいのにすいません。\n前回依頼したフロントラットスプレッド、個人的に凄く好きなポージングです。今回正面からでしたが、違った視点？アングル？から見てみたいです。\n勿論ポーズを崩しても構いませんし、身体を曲げてもいい。座ってもいい。でっかい筋肉が強調されていればガンガンアレンジしちゃってもいいです。センスを信じています。\n\n要望としては\n・もし下半身も入れるなら上半身に負けないくらい脚をがっつりデカくしてほしい。\n・股間ですが、資料の股間はゲームの制限上立体的になっていません。玉、竿を意識してボリュームを出して欲しい。デカすぎて枠に入らない、下半身の表現で邪魔なら前作前々作くらいの大きさに縮小してもかまいません。\n\n以上です。勿論スケジュール上無理でしたら断ってください。流石に連続で依頼しすぎて遠慮しなきゃと思いましたが我慢できませんでした。難しい依頼と思いますが、宜しくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ammami8/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/25f6680f/uploads/origins/e5f1c195-69b0-4c49-bd23-d9db11f0c1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e92