表現は以下の通りです。\n\nバリエーション１：ペニスが中心になっています。ネプチューンもノワールもペニスを神経質に見ています。ネプチューンは男の左に、ノワールは男の右にいます。\nバリエーション２：ノワールはペニスを口に含んだまま目を細めているのに対し、ネプチューンはノワールをちらりと見ている。\nバリエーション３：ノワールは男が彼女の口の中でクンニをしている間、目を閉じている。ネプチューンはショックを受けた顔をしています。\nバリエーション４：ノワールがネプチューンを見渡している間、ネプチューンはペニスを咥えたまま目を細めています。\nバリエーション5：ネプチューンは男が彼女の口の中でクンニをしている間、彼女の目を閉じている。Noireは彼女の目を狭くして、まだネプチューンを見ながら微笑む。\n\nhttp://imgur.com/a/B3NBW4L", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nya_roon/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 211656, "client_id": 358355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23ea5478/requests/247060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44dc44be7739542adcd36a5bd38769fd", "srcset": "https://si.imgix.net/23ea5478/requests/247060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44dc44be7739542adcd36a5bd38769fd, https://si.imgix.net/23ea5478/requests/247060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38a24653a8be866b14110135794fd17b 2x, https://si.imgix.net/23ea5478/requests/247060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57c1f6363cf10e5852a77ca53ccc15e5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23ea5478/requests/247060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97e6f0d23f08e3a1f798be315ccd9e3f", "srcset": "https://si.imgix.net/23ea5478/requests/247060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97e6f0d23f08e3a1f798be315ccd9e3f, https://si.imgix.net/23ea5478/requests/247060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4dfc41cfd8ee00e7862ad628bcc752 2x, https://si.imgix.net/23ea5478/requests/247060_0?bg=%2