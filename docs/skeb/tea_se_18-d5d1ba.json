筒子」「風牌（東・南・西・北）」「竹子」などがあります。麻雀の役を調べれば、私の意図がわかるでしょう。竹の組では、1竹から9竹までの牌があり、牌のデザインはその数字を表しています。例えば、2竹の牌には竹が2本描かれています。しかし、1竹の牌については、伝統的な麻雀セットでは、1本の竹に止まる孔雀や雀が描かれています。これは幸運の牌とされています。イベントポスターには、竹の枝に止まる孔雀の絵を描いてほしい。ポスターは大きな麻雀牌のように見えるようにするため、デザインには青・赤・緑のインクのみを使用すること。「SMART KIDS PLAY MAHJONG」というイベント名を、あなたのスタイルでデザインしたポスターがどんな感じになるか見てみたいです\n\nhttps://drive.google.com/drive/u/1/folders/12ji-Bu5c1HcNn2liMNi-nAntLf2ewtpS\n\nhttps://drive.google.com/drive/u/1/folders/12ji-Bu5c1HcNn2liMNi-nAntLf2ewtpS", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tea_se_18/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5b465e09/uploads/origins/117a4b51-8f31-4e25-b368-61a68107a2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c8915321ccc7588ca8008c0fbbbcc24", "srcset": "https://si.imgix.net/5b465e09/uploads/origins/117a4b51-8f31-4e25-b368-61a68107a2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c8915321ccc7588ca8008c0fbbbcc24, https://si.imgix.net/5b465e09/uploads/origins/117a4b51-8f31-4e25-b368-61a68107a2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99731889bc03e34fc27769ea0facf560 2x, https://si.imgix.net/5b465e09/uploads/origins/117a4b51-8f31-4e25-b368-61a68107a2e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=24631e89ca0f190862437249ec5910b5 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3203455, "nc": 144}, {"path": "/@tea_se_18/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "a