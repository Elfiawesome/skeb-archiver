と思います。イギリス人写真家「フランシーン・ウィンハム」の作品も添付しました。写真ですが、その情熱と迫力は伝わると思います。楽器はピアノ、ドラム、サックス、トランペットが最適です。ポーズや楽器の選択はご自由に決めてください。TeaSE さんのIGのイラストに込められた感情や雰囲気が好きです。音楽を聴く人物の指元にフレームを絞った構図は、本当にクールで情感に溢れています。複数のアイデアをお持ちでしたら、ぜひ共有してください。気に入った構図が複数あれば、1点以上のイラスト制作も可能です！\n\n\n\nhttps://drive.google.com/drive/folders/1VUC6Mcuyfw9kerwCbqq4Xb5SJQnIU0NB\n\nhttps://drive.google.com/drive/folders/1VUC6Mcuyfw9kerwCbqq4Xb5SJQnIU0NB", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tea_se_18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3203455, "client_id": 3450661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a18811735d57635f496cc4e6778e34", "srcset": "https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3a18811735d57635f496cc4e6778e34, https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39a69735e656827f1fad4b33b174f08b 2x, https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ccaef69763227475956e8917a8cb321 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49afca8c5eb930a481176cef83636de0", "srcset": "https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49afca8c5eb930a481176cef83636de0, https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b397c50bb4326d2443b9206a9af521 2x, https://si.imgix.net/84773a44/uploads/origins/64738138-7f5f-4cf4-a4fc-9e4b7e9c474f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c08ee4cbb44e22bacc12f3a959b08e5f 3x"}, "body": "こんにちは! ジョンです。\n\n中国の諺「初生牛犢不怕虎（生まれたての子牛は虎を恐れない）」を基にしたイラストを作成したいと考えています。これは「子供は恐れを知らない」という意味で、無知という概念をポジティブに描いている点が気に入っています。好奇心旺盛な少年または少女が子牛の頭蓋骨を抱えたり身につけたりしながら、虎と対峙する姿をイメージしています。サメを描いたこちらの作品が気に入りました。好奇心旺盛な子供を囲むように、伝統的でありながらリアルな虎を描いていただけると想像できます（参考資料を送ります）。また、中国のことわざもイラストに含めていただきたいです。例えばこちらの作品（青い春）のように書道風のスタイルで。\n\nいかがでしょうか？ご返事を楽しみにしております。\n\nhttps://drive.google.com/drive/folders/1nG5VtoaQfpuoshNdvU3ehgtQReAKASiQ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tea_se_18/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3203455, "client_id": 2203238, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4446c84c/uploads/origins/5881c859-f8e8-4901-ae0c-532ae673c701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8851487fb5426a256ac3a03457351e7a", "srcset": "https://si.imgix.net/4446c84c/uploads/origins/5881c859-f8e8-4901-ae0c-532ae673c701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8851487fb5426a256ac3a03457351e7a, https://si.imgix.net/4446c84c/uploads/origins/5881c859-f8e8-4901-ae0c-532ae673c701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8589295a516adedf4cf6c451d5e8b13c 2x, https://si.imgix.net/4446c84c/uploads/origins/5881c859-f8e8-4901-ae0c-532ae673c701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9951bcadc55ca8694eb886db17e7ee7 3x"}, "duration": null, "nsfw": false, "hardcore": false, 