りがたいです。\n\n〇使用用途\n黄白レモさんへのプレゼントとしてXに投稿させていただきます。\nまた、黄白レモさんに限り活動上での使用（SNSでの利用・動画サムネ利用）を許可いただきたいです。\nそれとご本人がロリ声配信企画などで配信上にイラストを映す可能性があります。\n\n〇その他\n可能であればPSDで納品していただけると助かります。\nもし使用用途の内容でNG事項があれば別レイヤーで記載していただけますと幸いです。\n\nご検討よろしくお願いいたします！\n\nhttps://lit.link/kishirolemo", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ptpt_petako/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e52d309b/uploads/origins/d238f55b-a1ec-48a0-90d9-80716a44f910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba735236375d9a53f6c4b99777380681", "srcset": "https://si.imgix.net/e52d309b/uploads/origins/d238f55b-a1ec-48a0-90d9-80716a44f910?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba735236375d9a53f6c4b99777380681, https://si.imgix.net/e52d309b/uploads/origins/d238f55b-a1ec-48a0-90d9-80716a44f910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a660dd89d9dd7282e92dbe09e5f67824 2x, https://si.imgix.net/e52d309b/uploads/origins/d238f55b-a1ec-48a0-90d9-80716a44f910?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed154437e834e5e35b6308000ab8b8cb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2767419, "client_id": 2416320, "nc": 145}, {"path": "/@ptpt_petako/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2767419, "client_id": 2111722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7d59ec3/uploads/origins/2149250a-5fee-4119-b7d8-751d10