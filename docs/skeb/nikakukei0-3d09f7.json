4946498/uploads/origins/57162090-ce7c-4bb5-97fe-9cad0c91d61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2867b9ffcd4858f1d20c2412c8f9b698", "srcset": "https://si.imgix.net/34946498/uploads/origins/57162090-ce7c-4bb5-97fe-9cad0c91d61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2867b9ffcd4858f1d20c2412c8f9b698, https://si.imgix.net/34946498/uploads/origins/57162090-ce7c-4bb5-97fe-9cad0c91d61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eab9cfaa5733ec78ae37032e3785d4ac 2x, https://si.imgix.net/34946498/uploads/origins/57162090-ce7c-4bb5-97fe-9cad0c91d61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa98ec2022ffc59ae3ac64e05a75d5e3 3x"}, "body": "こんにちは！私のエルフサキュバスキャラをあなたのスタイルで描いてほしいです。彼女は「通常形態」と「サキュバス形態」があり、今回は青い肌と追加特徴を持つサキュバス形態で描いてください。サキュバス形態の彼女は、ちょっと間抜けでドジな悪役キャラです。\n\nポーズはご自由にお決めください。ただし、長い煙草パイプを手に高慢な姿勢を取っている様子を希望します。ヤッターマンのドロンジョのようなイメージです。表情は、洗練された悪役に見せようと努力しているような、得意げなものでお願いします。背景もご自由にお選びください。森の夕焼けなどいかがでしょうか？お考えに合うものであれば何でも結構です！\n\n参考となるキャラクター資料と、私のイメージを大まかに描いたスケッチを添付しました。ご検討いただきありがとうございます！https://imgchest.com/p/5xy2gdm697l", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikakukei0/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3822456, "client_id": 792370, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1c82c443ed51e2fca1603e9d0e5f258", "srcset": "https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1c82c443ed51e2fca1603e9d0e5f258, https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cdcdd5d7fa46b809ca3d639e3635a0d 2x, https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b50b5e15131ce4a2e3be7696330a3944 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca38f9bb5a7621ea462e9bfa8d0ed943", "srcset": "https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca38f9bb5a7621ea462e9bfa8d0ed943, https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81ae55829039bc05208ccd783e010d40 2x, https://si.imgix.net/2553c3b8/uploads/origins/91daedb4-ddf1-4755-a927-f94b93ea4f66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b05260ae5a375451ae331b1e7f494333 3x"}, "body": "いつも素敵なイラスト\nありがとうごさいます！\n\n今回の依頼内容なのですが\n先生のアイコンのようなデフォルメされた\n\n四代絶影クオン風のイラストを依頼したいです。\n\nポーズや構図などはおまかせします\n\nもし可能であれば眼帯の\n有り無し差分が欲しいです\n(眼帯を外した場合、オッドアイになっているので下記URLを参考にしてください)\nhttps://shinrabansho.com/archive/images/another/card/1001_009.jpg\n\nご検討頂けますと幸いです\n\nhttps://shinrabansho.com/archive/images/01charalist/card04/086.jpg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikakukei0/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3822456, "client_id": 792370, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca8cf9f3/uploads/origins/b9948dea-5fd1-4161-b371-03e65176cf22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr