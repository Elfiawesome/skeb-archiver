u90e8\u3084\u592a\u817f\u8fba\u308a\u306a\u3069\u8131\u3044\u3060\u6642\u306b\u3060\u3051\u898b\u3048\u308b\u5834\u6240\u306b\u86c7\u30e2\u30c1\u30fc\u30d5\u306e\u523a\u9752\u304c\u3042\u308b\u3001\u666e\u901a\u306b\u7b11\u3046\u3068\u826f\u3044\u4eba\u305d\u3046\u306a\u306e\u306b\u53d7\u3051\u304c\u7d61\u3080\u3068\u6025\u5909\u30e4\u30d0\u30a4\u30ab\u30ec\u7b11\u3044\u306b\u306a\u308b(\u30ae\u30e3\u30c3\u30d7)\u3001\u53d7\u3051\u304c\u30e2\u30c7\u30eb\u4f53\u578b\u306a\u306e\u3067\u66f4\u306b\u8eab\u9577\u9ad8\u3081(188cm\u3068\u304b)\u306e\u30a4\u30e1\u30fc\u30b8\u3067\u51fa\u3057\u3066\u3082\u3089\u3048\u308b\u3068\u5b09\u3057\u3044\u3001\u7b4b\u8089(\u96c4\u3063\u3071\u3044)\u306f\u3042\u3063\u3066\u56f0\u3089\u306a\u3044\u8155\u306e\u592a\u3055\u3082\u3042\u3063\u3066\u3082\u56f0\u3089\u306a\u3044\n\n\u6027\u683c\u306f\u826f\u8b58\u3042\u308b\u30b5\u30a4\u30b3\u30b5\u30c9\u3002\u53d7\u3051\u304c\u597d\u304d\u904e\u304e\u3066\u53d7\u3051\u306b\u5bfe\u3057\u3066\u3060\u3051\u30e4\u30f3\u30c7\u30ec\u5ea6\u304c\u30e4\u30d0\u3044\u57f7\u7740\u611b\u306e\u584a\u3002\u88cf\u793e\u4f1a\u306e\u4e0a\u306e\u65b9\u306e\u30a4\u30a4\u30c8\u30b3\u3067\u751f\u304d\u3066\u308b\u306e\u3067\u30e4\u30af\u306b\u3082\u73a9\u5177\u306b\u3082\u7cbe\u901a\u3057\u3066\u3044\u308b\u3002\u6226\u95d8\u3082\u3067\u304d\u308b\u3002\u4e0a\u8a18\u306e\u86c7\u306e\u523a\u9752\u306e\u304a\u63c3\u3044\u3092\u3044\u3064\u304b\u53d7\u3051\u306b\u5165\u308c\u305f\u3044\u3068\u5922\u307f\u3066\u308b(\u3067\u3082\u305d\u3053\u306f\u7121\u7406\u5f37\u3044\u306f\u3057\u306a\u3044)(\u3084\u3055\u3057\u3044)(\u305d\u3046\u304b\u306a\uff1f)\u3002\u30c9S\u3067\u30e4\u306e\u4eba\u7cfb\u3067\u57f7\u7740\u611b\u306a\u306e\u3067\u4e71\u66b4\u3082\u3059\u308b\u3051\u3069\u3001\u53d7\u3051\u3082M\u5ea6\u304c\u5f37\u3044\u306e\u3067\u53d7\u3051\u5165\u308c\u3066\u304f\u308c\u308b\u76f8\u601d\u76f8\u611b\u305f\u3061\u3067\u3059\u3001\u508d\u304b\u3089\u898b\u308b\u3068\u30e4\u30d0\u3044\u3060\u3051\u3067\u3002\n\n