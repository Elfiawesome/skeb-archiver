u4eba\u3092\u5b9c\u3057\u304f\u304a\u9858\u3044\u7533\u3057\u4e0a\u3052\u307e\u3059\u3002\n\n\uff0a\u4eba\u7269\n\u540d\u524d\uff1a\u4e0a\u539f \u7d75\u8309(\u3046\u3048\u306f\u3089\u30fb\u3048\u307e)\n\u6027\u5225\uff1a\u5973\n\u5e74\u9f62\uff1a27\u6b73\n\u8077\u696d\uff1a\u8b66\u5bdf\u5b98(\u8b66\u90e8)\n\u8eab\u9577\uff1a162cm\n\u30d0\u30b9\u30c8\uff1a82cm(C\u30ab\u30c3\u30d7)\n\u6c96\u7e04\u51fa\u8eab\u3002\u30ad\u30d3\u30ad\u30d3\u30fb\u30c6\u30ad\u30d1\u30ad\u3057\u305f\u4ed5\u4e8b\u3076\u308a\u306e\u7279\u5225\u635c\u67fb\u5b98\u3002\u8eab\u306b\u3064\u3051\u305f\u7a7a\u624b\u306e\u6280\u3068\u611b\u7528\u306e\u30c8\u30f3\u30d5\u30a1\u30fc\u3067\u3001\u51f6\u60aa\u72af\u3092\u3076\u3063\u98db\u3070\u3057\u307e\u3059(\u683c\u95d8\u30b2\u30fc\u30e0\u3084\u7570\u80fd\u30d0\u30c8\u30eb\u6f2b\u753b\u306e\u30d2\u30ed\u30a4\u30f3\u98a8\u30ad\u30e3\u30e9\u30af\u30bf\u30fc)\u3002\n\n\uff0a\u5916\u898b\n\u273d\u982d\u9aea\n\u660e\u308b\u3044\u6817\u8272\u3002\u3046\u306a\u3058\u3067\u4e00\u3064\u7d50\u3073\u306b\u3057\u305f\u30bb\u30df\u30ed\u30f3\u30b0\u3002\n\u273d\u9854\u7acb\u3061\n\u5207\u308c\u9577\u306e\u92ed\u3044\u76ee(\u672c\u4eba\u306f\u3001\u4e00\u822c\u5e02\u6c11\u3084\u5b50\u4f9b\u304b\u3089\u6016\u304c\u3089\u308c\u308b\u306e\u3092\u5c11\u3057\u6c17\u306b\u3057\u3066\u3044\u307e\u3059)\u3002\u77b3\u306f\u9ed2\u8272\u3002\n\u273d\u4f53\u3064\u304d\n\u5de8\u4e73\u3067\u3082\u8ca7\u4e73\u3067\u3082\u306a\u3044\u3001\u9069\u5ea6\u306a\u81a8\u3089\u307f\u306e\u80f8\u3002\u935b\u3048\u3066\u3044\u308b\u305f\u3081\u3001\u5927\u817f\u90e8\u306f\u7b4b\u8089\u8cea\u306b\u3076\u3063\u3068\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u3002\n\n\uff0a\u670d\u88c5\n\u7d3a\u8272\u306e\u5236\u670d\u59ff\u3002\n\u304a\u624b\u6570\u3092\u304a\u639b\u3051\u3057\u307e\u3059\u304c\u3001\u8cc7\u6599URL\u5148\u306e\u30a4\u30e9\u30b9\u30c8\u306b\u3044\u304f\u3064\u304b\u5909\u66f4\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n- \u5236\u5e3d\u306f\u30c4\u30d0\u306e\u524d\u9762\u304c\u3081\u304f\u308c\u3066\u304a\u3089\u305a(\u5074\u9762\u3068\u80cc\u9762\u306f\u3081\u304f\u308c\u3066\u3044\u307e\u3059)\u3001\u307e\u305f\u5e3d\u5b50\u672c\u4f53\u306e\u4e0b\u90e8\u306b\u306f\u91d1\u8272\u306e\u6a2a\u30e9\u30a4\u30f3\u304c1\u672c\u5165\u3063\u3066\u3044\u307e\u3059\u2026\u8cc7\u6599\u753b\u50cf\u306e\u5b9f\u7269\u5199\u771f\u3092\u3054\u53c2\u7167\u304f\u3060\u3055\u3044\u3002\n- \u30b8\u30e3\u30b1\u30c3\u30c8\u306e\u4e21\u8896\u53e3\u306b\u3082\u3001\u540c\u69d8\u306b\u91d1\u306e1\u672c\u30e9\u30a4\u30f3(\u8b66\u90e8\u306e\u968e\u7d1a\u3092\u8868\u3057\u3066\u3044\u307e\u3059)\u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n- \u30c8\u30f3\u30d5\u30a1\u30fc\u306b\u4ed8\u3044\u3066\u3044\u308b\u300c\u685c\u306e\u4ee3\u7d0b\u300d\u306f\u30d7\u30ea\u30f3\u30c8\u67c4\u3067\u306f\u306a\u304f\u3001\u53d6\u308a\u4ed8\u3051\u3089\u308c\u305f\u7acb\u4f53\u7269(\u5927\u304d\u306a\u30d0\u30c3\u30b8\u306e\u3088\u3046\u306a\u30d1\u30fc\u30c4)\u306b\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f4d\u7f6e\u306f\u305d\u306e\u307e\u307e\u3001\u30c8\u30f3\u30d5\u30a1\u30fc\u306e\u6301\u3061\u624b\u306e\u88cf\u5074\u3002\n- \u305d\u308c\u4ee5\u5916\u306f\u5143\u30a4\u30e9\u30b9\u30c8\u306b\u6e96\u62e0\u3067\u304a\u9858\u3044\u3057\u307e\u3059(\u524d\u958b\u304d\u306e\u30b8\u30e3\u30b1\u30c3\u30c8\u3001\u53f3\u80a9\u306b\u767d\u3044\u7d44\u7d10\u3001\u767d\u3044\u30d6\u30e9\u30a6\u30b9\u3001\u30bf\u30a4\u30c8\u306a\u30df\u30cb\u30b9\u30ab\u30fc\u30c8\u3001\u8336\u8272\u306e\u30d1\u30f3\u30b9\u30c8\u3001\u7126\u3052\u8336\u306e\u6728\u88fd\u30c8\u30f3\u30d5\u30a1\u30fc\u00d72)\u3002\n\n\uff0a\u305d\u306e\u4ed6\n\u63cf\u5199\u7bc4\u56f2\u306f\u982d\u9802\u304b\u3089\u819d\u4e0a\u307e\u3067\u3092\u304a\u9858\u3044\u3057\u307e\u3059(\u5c65\u7269\u306f\u8e35\u306e\u9ad8\u304f\u306a\u3044\u30d1\u30f3\u30d7\u30b9\u304b\u30d6\u30fc\u30c4\u3092\u60f3\u5b9a\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u7279\u306b\u304a\u63cf\u304d\u3044\u305f\u3060\u304