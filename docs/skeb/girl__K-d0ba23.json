72(RGB:000)\n- \u7709\u304c\u96a0\u308c\u308b\u524d\u9aea\n- \u8170\u306e\u4e0b\uff5e\u304a\u5c3b\u8fba\u308a\u307e\u3067\u4f38\u3070\u3057\u305f\u5f8c\u308d\u9aea\n- \u9854\u306e\u4e21\u6a2a(\u8033\u306e\u624b\u524d\uff1d\u3082\u307f\u3042\u3052)\u306b\u306f\u3001\u300c\u982c\u307e\u3067\u300d\u3068\u300c\u80f8(\u30c8\u30c3\u30d7\u30d0\u30b9\u30c8\u306e\u5c11\u3057\u4e0a)\u307e\u3067\u300d\u306e2\u6bb5\u968e\u3067\u9aea\u3092\u5782\u3089\u3057\u3066\u3044\u307e\u3059\n- \u524d\u30fb\u6a2a\u30fb\u5f8c\u3001\u5168\u3066\u306e\u6bdb\u5148\u3092\u300c\u3071\u3063\u3064\u3093\u300d\u306b\u5207\u308a\u63c3\u3048\n\u273d\u9854\u7acb\u3061\n- \u67d4\u548c\u3067\u7a4f\u3084\u304b\u306a\u96f0\u56f2\u6c17\n- \u6bd4\u8f03\u7684\u3001\u30b7\u30e5\u30c3\u3068\u3057\u305f\u7d30\u9762\n- \u5c11\u3057\u5782\u308c\u6c17\u5473\u306e\u4e38\u3044\u76ee\n- \u77b3\u306f\u6df1\u3044\u7d3a\u8272\n\u273d\u4f53\u578b\n- \u8272\u767d\u7f8e\u808c\n- \u8eab\u9577160cm\u2026\u30b9\u30e9\u30c3\u3068\u3057\u305f\u7d30\u8eab\u3001\u3057\u304b\u3057\u75c5\u5f31\u3067\u306f\u3042\u308a\u307e\u305b\u3093\n- \u30d0\u30b9\u30c879cm(B\u30ab\u30c3\u30d7)\u2026\u7740\u8863\u306e\u4e0a\u304b\u3089\u3067\u306f\u81a8\u3089\u307f\u304c\u76ee\u7acb\u3061\u306b\u304f\u3044\u3001\u63a7\u3048\u3081\u306a\u30fb\u614e\u307e\u3057\u3044\u80f8\n\n\uff0a\u670d\u88c5\n\u8cc7\u6599URL\u5148\u753b\u50cf\u306b\u3042\u308a\u307e\u3059\u3001\u300c\u6b66\u9053\u7740\u300d\u59ff\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u306a\u304a\u3001\u624b\u6301\u3061\u6b66\u5668\u306e\u985e\u306f\u6301\u3063\u3066\u3044\u307e\u305b\u3093\u3002\n\u273d\u4e0a\u534a\u8eab\n- \u767d\u3044\u4e0a\u8863\u2026\u7b52\u5f62\u306e\u534a\u8896(\u8098\u306b\u88ab\u3089\u306a\u3044\u3001\u77ed\u3081\u306e\u8896\u3002\u9577\u8896\u30fb\u632f\u8896\u3067\u306f\u7121\u304f\u3001\u5f13\u9053\u7740\u3084T\u30b7\u30e3\u30c4\u306e\u3088\u3046\u306a\u72ed\u3044\u5f62\u3067\u3059)\n- \u9ed2\u3044\u30a4\u30f3\u30ca\u30fc\u30a6\u30a7\u30a2\u2026\u624b\u9996\u307e\u3067\u306e\u9577\u8896\u3067\u3001\u9996\u306e\u5927\u90e8\u5206(\u984e\u306e\u30e9\u30a4\u30f3\u8fd1\u304f\u307e\u3067)\u3092\u8986\u3046\u30cf\u30a4\u30cd\u30c3\u30af\u3002\u808c\u306b\u5bc6\u7740\u3059\u308b\u30ec\u30aa\u30bf\u30fc\u30c9\u98a8\n- \u767d\u3044\u9262\u5dfb\u2026\u7709\u3092\u8986\u308f\u306a\u3044\u4f4d\u7f6e\u306e\u984d\u306b\u5f53\u3066\u3066\u3001\u5f8c\u982d\u90e8\u3067\u7de0\u3081\u3066\u3044\u307e\u3059\n- \u6c34\u8272\u306e\u5e03\u88fd\u624b\u7532\u2026\u5de6\u53f3\u5171\u901a\u3002\u8155\u5074\u306f\u77ed\u3081\u306e\u4e08\u3001\u624b\u5074\u306f\u4e2d\u6307\u306b\u7d10\u306e\u8f2a\u3092\u901a\u3057\u3066\u56fa\u5b9a\n\u273d\u80f8\u5f53\u3066\u9632\u5177\n- \u9ed2\u3044\u9769\u3084\u6a39\u8102\u3067\u51fa\u6765\u3066\u3044\u307e\u3059\n- \u30a8\u30ca\u30e1\u30eb\u52a0\u5de5\u306e\u7dba\u9e97\u306a\u5149\u6ca2\n- \u5de6\u53f3\u5bfe\u79f0\u3001\u6a2a\u9577\u306e8\u89d2\u5f62(\u30ab\u30c9\u306f\u53d6\u308c\u3066\u3044\u307e\u3059)\n- \u5916\u5468\u306b\u88dc\u5f37\u306e\u305f\u3081\u306e\u7e01\u53d6\u308a(\u8272\u306f\u4e2d\u5074\u3068\u540c\u3058\u304f\u9ed2)\n- \u4e21\u80a9\u3068\u4e21\u8107\u306b\u54041\u672c\u305a\u3064\u3001\u592a\u304f\u767d\u3044\u56fa\u5b9a\u7528\u306e\u7d10\n- \u786c\u304f\u5206\u539a\u304f\u7acb\u4f53\u7684\u3002\u3057\u304b\u3057\u3001\u7dbe\u9999\u306e\u80f8\u30b5\u30a4\u30ba\u306b\u5408\u308f\u305b\u3066\u3044\u308b\u305f\u3081\u76db\u308a\u4e0a\u304c\u308a\u306f\u3042\u307e\u308a\u5927\u304d\u304f\u3042\u308a\u307e\u305b\u3093\n- \u5f13\u9053\u306e\u80f8\u5f53\u3066\u3092\u5de6\u53f3\u540c\u3058\u306b\u3057\u305f\u5f62\u3067\u3001\u304b\u3064\u5263\u9053\u306e\u80f4\u9632\u5177\u306e\u3088\u3046\u306a\u786c\u8cea\u3055\u3092\u6301\u3063\u3066\u3044\u308b\u611f\u3058\u3067\u3059\n\u273d\u4e0b\u534a\u8eab\n- \u9ed2\u3044\u88b4\u2026\u30d7\u30ea\u30fc\u30c4\u3092\u65bd\u3057\u305f\u30ba\u30dc\u30f3\u30bf\u30a4\u30d7(\u99ac\u4e57\u308a\u88b4)\u3002\u4e21\u8170\u306e\u30b9\u30ea\u30c3\u30c8\u304b\u3089\u306f