mgix.net/1d1d6a51/uploads/origins/2ee6e734-1bb6-4e41-8f84-9d67b8d4acc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29b58ded8a7d53bb9e34ddea18959b95", "srcset": "https://si.imgix.net/1d1d6a51/uploads/origins/2ee6e734-1bb6-4e41-8f84-9d67b8d4acc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29b58ded8a7d53bb9e34ddea18959b95, https://si.imgix.net/1d1d6a51/uploads/origins/2ee6e734-1bb6-4e41-8f84-9d67b8d4acc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a714a22ff3c3719c62825bef842b90b7 2x, https://si.imgix.net/1d1d6a51/uploads/origins/2ee6e734-1bb6-4e41-8f84-9d67b8d4acc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d061a932f99ac3717d65c8d4ff352d0 3x"}, "body": "初めまして。以前他の依頼で描かれていた邪神イリスのイラストと、普段描かれているモンスター娘のイラストが素敵だったので、イリスの擬人化イラストご依頼させていただきます。\n\nイリスについて\n・長身でスタイル抜群、妖艶な雰囲気の女性\n・髪はロングで、イリスの体色のような赤\n・瞳は金色\n・顔や首周りなどは人間と同じ肌色(色白)\n・胸や腹部にある青・黄色の発光体は衣服・装飾ではなく、表皮上にある器官として描いてください\n・腕のブレードや顔・肩・膝の突起、羽、触手もできるだけ描いていただき、可能な限り生物的な感じでお願いしたいです\n\nシチュエーション\n・ガメラ3劇中終盤のように綾奈を腹部の器官から取り込み、満足げな様子\n・劇中ほどの体格差は無く、綾奈を取り込んだことで臨月のように大きく膨らんだ腹部を撫でている\n・腹部の膨らみが分かるように真正面ではなく斜め前からのアングルで、膝あたりまで描いていただければOKです\n・もし可能であれば、水の中を漂う綾奈の様子も脇あたりに描いていただけるとありがたいです(難しければなくても大丈夫です)\n\n以上、注文が多くて大変恐縮ですが、何卒よろしくお願いいたします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryochang2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 797706, "client_id": 2351339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c5b1572/uploads/origins/29cdcc26-c789-420e-b524-3acd4d453b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a4f23577a8b52f1cbaf43d6f0b43238", "srcset": "https://si.imgix.net/6c5b1572/uploads/origins/29cdcc26-c789-420e-b524-3acd4d453b31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h