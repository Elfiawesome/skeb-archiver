%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=503aec2de30d4a9e3246d38bae89bc79", "srcset": "https://si.imgix.net/761e7330/uploads/origins/e0b8fa91-81d2-4a0d-a1fb-54487780f0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=503aec2de30d4a9e3246d38bae89bc79, https://si.imgix.net/761e7330/uploads/origins/e0b8fa91-81d2-4a0d-a1fb-54487780f0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93c4906506ae995b0868c46d2c66e276 2x, https://si.imgix.net/761e7330/uploads/origins/e0b8fa91-81d2-4a0d-a1fb-54487780f0d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14a04d831b68c1f7c820233b3621bad1 3x"}, "body": "こんにちわ\n\nよろしければ、女性のカラー緊縛イラストをお願いしたいです。\nオリジナルキャラで、昔の農家の純朴そうな20歳位の\n黒髪女性で顔だち、髪型、体型等はお任せします。\n\n恰好\n野良着、もんぺ、足袋履きで、\n胸をだしてM字開脚縛りされています。\n表情は号泣している感じにしてほしいです。\n頭から爪先まで全身を描いてほしいです。\n\n服装\n頭に白の手ぬぐいで姉さん被りをしています。\n野良着の色は紺、模様は適当に描いてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n足袋はくるぶしの上までの長さで色はエンジ色、足袋底は白にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/scl/fi/95z0kwwrlcpg9gls7ljm8/ms.jpg?rlkey=b2t0x3r3n57prxgs9ijwsqapp&st=mtjckzvp&dl=0\n足袋イメージ\nhttps://www.dropbox.com/scl/fi/sgzyh9t046l1igi86wgek/etb.png?rlkey=o9ieoa8nnsl58pjq18kp42znj&st=903bkfuw&dl=0\n\n差分として\n頭の姉さん被りのてぬぐいの有無と\nもんぺの股間部分を破られ、陰部に張型が挿入されて\n表情も苦しそうに目をつぶり涙を流して絶叫している状態もお願いします。\n\nつたない説明で恐縮ですが説明不足な点、構図など自由に\n変更、アレンジしていただいて構いません。\n\nご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/khmd5lid6dok2wq94tcgg/m2.png?rlkey=ab5n9miymhygejtchyx3axg5a&st=fxbl8tn1&dl=0", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ihaland_18/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2317078, "client_id": 2278857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbb8893be9f94b08e2aa520f58fd8b15", "srcset": "https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dbb8893be9f94b08e2aa520f58fd8b15, https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd080f7791c8d485aa6a7794b4f0a2ec 2x, https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3d8fb10061e22f908a86d70da16f007 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24067adf55e1fb2bff65ad70a7875396", "srcset": "https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24067adf55e1fb2bff65ad70a7875396, https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=de5051c64629c6f913cdc4a4fe1ec327 2x, https://si.imgix.net/71a167b3/uploads/origins/9885fe40-0245-42b4-ada3-2de058129035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3db3b99fab9e04763212920a4af6cdd 3x"}, "body": "はじめまして。\n以下内容にてリクエストさせてください。\n\nキャラ：櫻木真乃(アイドルマスターシャイニーカラーズ)\n　服装は制服がはだけた状態をベースにしてください。\n\nシチュエーション：真乃がAVデビューさせられプロ男優に徹底的に犯される場面。\n\n竿役：筋肉質&オラオラ系のAV男優\n　自らが主導権を握っての荒々しいSEXを好む。\n\n差分：①本番中差分と、②事後差分を描いていただきたいです。\n　真乃と男優のセリフや擬音も描写していただきたいです。\n　詳細は以下に記載します。\n　\nシーン①本番中差分について\n　体位は真乃が股を開いた状態での後側位\n　SEX開始→ピストン→真乃絶頂→スパート→中出し→事後の流れで差分を希望します。\n　真乃が男優の強いチンポにいじめられるようにイカされまくる感じでお願いします。\n\nシーン②事後差分について\n　真乃は体力を使い果たし、おまんこからザーメンを漏らしながら座り込んでいる。\n　男優は片手で真乃の頭を抑え、もう片手で真乃の笑顔の写真(チェキ)をカメラに向けている。\n　(普段の真乃の笑顔と今の表情とのビフォーアフターみたいな感じで)\n　事後のインタビュー風、もしくはAVパッケージ風に描写していただきたいです。\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1EQ4OsbqRZQY2hRsnRqsEvxwc49MmK6pY", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ihaland_18/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2317078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54409becc8b21ff62e1eaac707e19d6e", "srcset": "https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54409becc8b21ff62e1eaac707e19d6e, https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8d68b2707153023243b2449745fdce0 2x, https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6d54ff81543b808b0f7ba237d23d37e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35bd0421335c6a9bb14906a1e112e8a7", "srcset": "https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35bd0421335c6a9bb14906a1e112e8a7, https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1fd8ce3fd02102f35b59c94935351365 2x, https://si.imgix.net/29a42d64/uploads/origins/99108138-0b84-4fcc-985d-408438e02712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67cd80e1957940862dea0534d58ee0cd 3x"}, "body": "学園アイドルマスターの姫崎莉波の凌辱絵を漫画でお願いしたいです。\n格好はこちらのURL（https://www.goodsmile.com/ja/product/1141725/%E5%A7%AB%E5%B4%8E%E8%8E%89%E6%B3%A2+%E3%83%90%E3%83%8B%E3%83%BCVer.）のバニーガールでお願いします。\n\n1ページ目\n学園祭にて、バニーガールの格好で接客をしている莉波。\nそれを遠目で見ているガラの悪いファン3人が、「りなみんエロすぎだろ・・・」「もう我慢できねえ・・・」「ヤッちまうか・・・？へへへ・・・」と話をする。\n\n2ページ目\n莉波が倉庫等に連れ込まれ、バニー服の胸の部分をずり下ろされて両胸を露出させられる。\nファンの1人目は、後ろから片手で莉波の胸を揉みながら、もう片方の手でバニー服の股間部分に手を入れて秘部をいじる。\n2人目は、莉波の顔を両手で掴んで、口の中に無理矢理舌を入れてベロチューする。\n3人目は、その様子をスマホで録画している（スマホとそれを持つ手だけで結構です）。\n莉波は顔を赤くして両目を瞑って涙を流し、1人目の手を押し退けようとしている（https://skeb.jp/@ihaland_18/works/9の2枚目のような表情）。\n\n3ページ目\nhttps://www.pixiv.net/artworks/126752135の2枚目の構図で挿入・ピストンされる。\n他２人は、莉波の顔の辺り・胸の辺りで自分のブツをシコっていて、そのうち１人はもう片手でスマホを持ち、莉波の全身が映るように録画している。\n3人とも興奮しているような台詞をお願いします。\n莉波は涙を流して喘ぎながら「いやっ・・・！」「誰かっ・・・！」「助け・・・！」と言う。\n\n4ページ目（3ページ目の差分）\n3人から一斉に射精される。\n莉波は思わず両目を瞑り、「あああああっ！」と叫ぶ。\n\n5ページ目（4ページ目の差分）\n莉波は眠るように両目を閉じて気を失う（ハァ・・・ハァ・・・という弱々しい呼吸を入れてください）。\n顔と胸に大量にぶっかけられ、秘部からも精液が溢れ出ている。\n男達は「次は俺な」「バカ、もっとヤらせろ」「お前だけずりーぞ」等と話をする。\n\n以上、よろしければ、お願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ihaland_18/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2317078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b1d5b56610f7462f89f9f7f2fc6f49d", "srcset": "https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b1d5b56610f7462f89f9f7f2fc6f49d, https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bf5019e7a3222a9bb44e2cbd2aac366 2x, https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dd73ffa562fdca9a735122cc4f2db9b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4734a5f0a7ee25e3f3351d8cafd53d48", "srcset": "https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4734a5f0a7ee25e3f3351d8cafd53d48, https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b773a6d89697b6ebc6aa3792e70acf0 2x, https://si.imgix.net/574b4ff5/uploads/origins/f564d029-b753-48bc-8c3e-b188ecd7b4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a636e4cccc81bb3fc9847577026c7c4 3x"}, "body": "初めまして。ちょっと変わったリクエストかもしれませんが、もしお気に召さなかったらご遠慮なくお断りください。\n\nシャイニーカラーズのプロデューサーと七草はづきの体が入れ替わる漫画を描いてください。\n\n二人の体が入れ替わった時、プロデューサーは鏡を見ていると、はづきが服を脱いでいる最中でした。プロデューサーは驚いて何事かと不思議に思っています。突然、にちかが「お風呂の準備ができたよ。早く入れ。」と叫ぶ声が聞こえます。\n\n言われた通りにお風呂に入り。湯船に浸かりながら新しおっぱいを揉み、その感触を語ります。プロデューサーはワクワクし始め、はづきになって楽しいかもしれないと思い始めます。\n\nプロデューサーはお風呂から出て体を拭き、男のようにタオルを腰に巻き、おっぱいを露わにします。このように家の中を歩き、冷蔵庫まで行き、ビールを手に取ります。ビールを開けて飲みながら、はづきの部屋に戻りました。\n\nはづきの部屋に戻ると、プロデューサーははづきの服の中から何か着るものを探していたところ、ディルドを見つけます。興味が湧き、それを使ってオナニーをして絶頂を迎えます。\n\n構成は自由に決めてください。必要であれば変更してください。\nよろしくお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ihaland_18/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tip