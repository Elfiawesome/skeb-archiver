ke an illustration like that of my character!!\n\n\nhttps://drive.google.com/drive/folders/1dMlr5CBhMpqmnAalcjb0etHN7I-SqNIT\n\nhttps://drive.google.com/drive/folders/1dMlr5CBhMpqmnAalcjb0etHN7I-SqNIT", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyawa_e/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1813615, "client_id": 827669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e84b51ea/uploads/origins/45883616-32f7-41e5-a66b-8356a4b4b86e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a94a3e54317899e3609b2f1b78152c", "srcset": "https://si.imgix.net/e84b51ea/uploads/origins/45883616-32f7-41e5-a66b-8356a4b4b86e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41a94a3e54317899e3609b2f1b78152c, https://si.imgix.net/e84b51ea/uploads/origins/45883616-32f7-41e5-a66b-8356a4b4b86e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a9bb21a670641be2226a28b4cf108a6 2x, https://si.imgix.net/e84b51ea/uploads/origins/45883616-32f7-41e5-a66b-8356a4b4b86e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5387818f31cb145171d0485659bf3301 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e84b51ea/uploads/origins/45883616-32f7-41e5-a66b-8356a4b4b86e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac23477a01bf6fa73863cb8b375457c4", "srcset": "https://si.imgix.net/e84b51ea/uploads/origins/45883616-32f7-41e5-a66b-8356a4b4b86e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac23477a01bf6fa73863cb8b375457c4, https://si.imgix.net/e84b51ea/uploads/origins/45883616-32f7-41e5-a66b-8356a4b4b86e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cdb3aab17aef5397737734cf1ccb