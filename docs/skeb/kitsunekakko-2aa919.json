楽に溺れ続けてる。 \n\n・できれば資料URLのようにスライムパッキンされて、体中犯され叫ぶことも微塵も身動きもできないまま苗床オブジェになるぐだ子もうれしいですが、これはなくても大丈夫です。\n\n  という風に考えていますが、「スライムの苗床になるロリぐだ子」という風な感じであれば作者さんの自由で大丈夫です！  よろしければお願いします！\n\nhttps://www.pixiv.net/artworks/89477764", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kitsunekakko/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1783350, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/849e8db3/uploads/origins/fa764b27-3919-47f6-8c7d-d06280fd9c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66bb67787ee2f4e893cc00f147ced160", "srcset": "https://si.imgix.net/849e8db3/uploads/origins/fa764b27-3919-47f6-8c7d-d06280fd9c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66bb67787ee2f4e893cc00f147ced160, https://si.imgix.net/849e8db3/uploads/origins/fa764b27-3919-47f6-8c7d-d06280fd9c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a1daeb41df6c72bc1ccbbe156772493 2x, https://si.imgix.net/849e8db3/uploads/origins/fa764b27-3919-47f6-8c7d-d06280fd9c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1147394e7ec46cec1e7ac843d85d63d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/849e8db3/uploads/origins/fa764b27-3919-47f6-8c7d-d06280fd9c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a2271262593b133103c4f12e8d2d987", "srcset": "https://si.imgix.net/849e8db3/uploads/origins/fa764b27-3919-47f6-8c7d-d06280fd9c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a2271262593b133103c4f12e8d2d987, https://si.imgix.net/849e8db3/uploads/origins/fa764b27-3919-47f6-8c7d-d06280fd9c11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa264a9e1bbb0a8559bcf7bc4125