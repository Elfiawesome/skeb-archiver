}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@negitorodon1/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2811922, "client_id": 1947026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fcd6da8cd11710aad68cec9f3283c21", "srcset": "https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fcd6da8cd11710aad68cec9f3283c21, https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62386ff4e7a5216c72a1eef627d6fd6f 2x, https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51b60edb651a6a81bccb9410a75607c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a5625949ab8a72af5721c42c6379033", "srcset": "https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a5625949ab8a72af5721c42c6379033, https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=238a1143dde6e497c487eedd77677bcb 2x, https://si.imgix.net/1bb37d8f/uploads/origins/37b214e5-be4d-43f3-ad69-a2a55bcf0bc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20c9eaee8d193a380212b8acba2232da 3x"}, "body": "こんにちは！あなたの作風がとても気に入ったので、リクエストさせてください！三枚の画像で構成されるシークエンスを希望します。三つ編みと眼鏡をかけた内気な女子学生が、年月を経てオレンジ色の毛並みの擬人化されたキツネへと変貌していく様子を描いてほしいのです。最初の画像では、キツネの耳と尾が生えた状態で登校し、その変化に完全に恥ずかしがっている様子を描いてください。 2枚目は大学時代。狐のような姿にさらに変化が進み、心も影響を受けている様子。以前の彼女とは違い、狐のようにいたずらっぽく遊び心にあふれています。おしゃれな服装で耳と尾を誇示し、顔も次第に動物的になり、胸の上部など体の一部に毛が生え始めています。 最終的なイメージでは、彼女は完全に人狐（アンソロ）へと変貌し、大きなふさふさした尾を持ち、成功した会社員／管理職のようだ。優雅で自信に満ちた様子でありながら、非常に魅力的で誘惑的、かつ遊び心にあふれている。背景などは不要です。よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negitorodon1/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2811922, "client_id": 333632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58dcabb72a061a883bd81a7ed6cdf77e", "srcset": "https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58dcabb72a061a883bd81a7ed6cdf77e, https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8645edacae35f982d4cf844e7b87dd31 2x, https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6613e23090169e04c1663e3c9fc9632c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=577e2d5ae34cf57f326da9c785fd9c22", "srcset": "https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=577e2d5ae34cf57f326da9c785fd9c22, https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=739fa88b7062bbb06240ab68c842927e 2x, https://si.imgix.net/fa8d340b/uploads/origins/034eef69-228b-4ba8-a969-5105dc942d4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5b5620a5f40dc5c69a6368fd5d40d51a 3x"}, "body": "おはようございます。100の人と申します。いつもなりたみ深いイラストを有り難うございます。\n手数料無料キャンペーンに乗じてリクエストさせてもらいます。\n\nうちよそになるのですが、\n\nうちの子「100の人」(♂・末尾資料参照) の姿が、こちら↓のちびケモ化狼ちゃんの姿へ変わっていき、\nhttps://x.com/negitorodon1/status/1310115816692539392\n完全変化時に、100の人の姿をした何者かにつまみ上げられる\n\nというシチュを描いてもらえないでしょうか？\n\ntransfurに加えて TS していることにうろたえる (あるいは驚いている) ことを示す何らかの描写、\nつまみ上げられたときに本当はちびケモ化狼ちゃんの方が100の人であることを示す (たとえば↓の顔アイコンなど) 何らかの描写を入れて欲しいです。\nhttps://x.com/negitorodon1/status/1808490847270522943\nつまみ上げられる以外の動作にするなど、内容適宜変更してもらってかまいません。\n\n金額不足等ありましたら再送要請してください。\nご検討よろしくお願いします。\n\n\n【100の人についての資料】\n■立ち絵・設定\n↓の右側 (ヒト型)\nhttps://www.pixiv.net/artworks/128487854\n■額の宝石やしっぽ部分の3Dモデル\nhttps://virtualcast.jp/items/acacf505a4d84111c58ade19a42772c3851e0083db9e12b3ab79ae6bb019977a\n※しっぽの文字は省略してもらってもかまいません", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negitorodon1/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2811922, "client_id": 3374895, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cdddeeb9f80b1ed80391821f3b7e431", "srcset": "https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9cdddeeb9f80b1ed80391821f3b7e431, https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e5f80cee7644158fc0d76f45330e1a4 2x, https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6948f5e731b6ea9c9f4f065a2e15d82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6d707c290f6050c8913cafa30e60bb", "srcset": "https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6d707c290f6050c8913cafa30e60bb, https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c342e6e4effa6e457c1ea5c13d64267 2x, https://si.imgix.net/2ae82224/uploads/origins/c5ba7e5c-64f3-45a6-a944-7bd1b8de3a62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea9db4f33e863fdc6755b2e04bb60f34 3x"}, "body": "初めまして、あなたの作品がとても好きです！\nぜひコミッションをお願いしたいと思います。内容は 2ページの漫画 で、私のオリジナルキャラクターが犬に変化していく過程を描いていただきたいです。\n\n大まかなトランスファーの流れは以下の通りですが、コマ割りなどはお好みに合わせて調整していただいて大丈夫です：\n彼のボーイフレンドが彼におやつ（実はドッグフード）を渡し、彼は特に確認もせずに嬉しそうに食べてしまいます。その瞬間、彼の体にすぐ変化が起こり始めます。\n彼の体毛が次第に濃くなり、元々滑らかだった竜の尾もふさふさになります。最初は混乱し、自分の短い口吻が伸びていくのを見て慌てます。鼻は犬の鼻へと変化し、縦長だった瞳孔も丸い瞳孔へと変わっていきます。服やズボンは床に落ち、変化中の性器が露わになります。手は犬の前足へ、足は犬の爪になり、履いていたソックスも変形した爪で破れてしまいます。両手も犬のように地面について支えている。\n\nその後、彼は少し抵抗の表情を見せながらも、ボーイフレンドに首輪をつけられます。しかし体や習性がどんどん犬のものになっていくにつれて、その変化を次第に気に入るようになり、思わず舌を出してハァハァと息をします。ボーイフレンド（主人）がリードを引きながら「伏せろ」と命じると、彼は尻尾を振って嬉しそうに従い、リードで引かれながら素直に主人の前に差し出された足を嗅ぎ、舐め始めます。従順に楽しそうな顔で――彼は主人の命令に従う小さなオス犬に変わってしまったのです。意識自体は残っているものの、犬としての本能と欲望を抑えることができなくなっています。\nもし可能であれば、犬へ変化した後の犬の性器を、適切と思われる位置に描いていただけると嬉しいです。\n\n以上の内容はあくまでストーリーの流れの参考です。できるだけ詳細に書きましたが、2ページの漫画では全ての細部を表現するのは難しいかもしれませんので、お好みで簡略化や調整をしていただいて構いません！\nまた、ボーイフレンドは全身を登場させる必要はなく、必要な場面で手や足だけを見せる程度で大丈夫です。もちろん、もし最後の場面に余裕があれば半身を描いて、満足そうな表情を加えていただけるとさらに素敵です。\n\n以下は設定の参考資料です: https://nam.s-ul.eu/W9TZJJaQ\n\nhttps://nam.s-ul.eu/W9TZJJaQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@negitorodon1/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2811922, "client_id": 40971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29ba9968/uploads/origins/f4fe4b60-c5f7-4181-bcf1-08c6963d5986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed8b2324c3cb58077e55f7b9c1fab195", "srcset": "https://si.imgix.net/29ba9968/uploads/origins/f4fe4b60-c5f7-4181-bcf1-08c6963d5986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed8b2324c3cb58077e55f7b9c1fab195, https://si.imgix.net/29ba9968/uploads/origins/f4fe4b60-c5f7-4181-bcf1-08c6963d5986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42d531b39fde305ccb62a3bc8ccc0213 2x, https://si.imgix.net/29ba9968/uploads/origins/f4fe4b60-c5f7-4181-bcf1-08c6963d5986?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8fe85e7829a5f0b01383b05436917db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29ba9968/uploads/origins/f4fe4b60-c5f7-4181-bcf1-08c6963d5986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92b0da2a8bd106caebcdc3cd081cf79f", "srcset": "https://si.imgix.net/29ba9968/uploads/origins/f4fe4b60-c5f7-4181-bcf1-08c6963d5986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&