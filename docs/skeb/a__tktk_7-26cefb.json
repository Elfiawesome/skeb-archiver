0e/uploads/origins/48a883c2-1e78-4796-baed-3204033eafc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=085842dc2a43530659bb245a5c89d8e3", "srcset": "https://si.imgix.net/ae99bd0e/uploads/origins/48a883c2-1e78-4796-baed-3204033eafc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=085842dc2a43530659bb245a5c89d8e3, https://si.imgix.net/ae99bd0e/uploads/origins/48a883c2-1e78-4796-baed-3204033eafc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d55f33e97ef5abbc93a54bbab56fe806 2x, https://si.imgix.net/ae99bd0e/uploads/origins/48a883c2-1e78-4796-baed-3204033eafc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6829621c8c9e4c3b70c2e10ffc1a0b74 3x"}, "body": "sumi先生こんにちは\n\nVtuberの姫乃あいむさん(@himenoaimu)にイラストを描いて頂けないでしょうか。\nまたSkebでのイラストのリクエストにあたり、ご本人様からは許可は頂いております。\n引用元：https://lit.link/himenoaimu\n\n◯人物、容姿、服装\n歌うことが大好きなロイヤルローズ王国のお姫様で、容姿・服装につきましては下記リンクからご確認をお願いいたします。\nhttps://drive.google.com/drive/folders/1Ir7T6G-kslvGkqDPUJSUGtQpj_TMZ927?usp=drive_link\n\n◯使用用途\n・活動者様ご自身のSNS、PixivFANBOX等の支援サイトでのイラストの投稿、メッセージを添えての配布\n・ 収益化済のYouTubeチャンネルでの配信・サムネイル等でのイラストの使用\n・ 個人での使用、鑑賞\n\n◯イメージ・構図等\n・新衣装の天使衣装で髪型はハーフアップで描いて頂けないでしょうか。\n・可能でしたら顔周りの髪の毛等が見切れていない構図でお願いいたします。\n\n納品形式は人物と背景が透過されたレイヤーを分けたPSDかPNGファイルで納品していただけますと幸いです。\nご縁がありましたらよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@a__tktk_7/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1209280, "client_id": 2740985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52d9fe53/uploads/origins/5ef80511-f5bf-4a39-ad4b-dbc9f114a5ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b16bd5378ace1660c03385e90c18eb2", "srcset": "https://si.imgix.net/52d9fe53/uploads/origins/5ef80511-f5bf-4a39-ad4b-dbc9f114a5ed?bg=%23fff&auto=