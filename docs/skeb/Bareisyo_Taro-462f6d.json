うとする野生児君に「行かないで‼︎」と追い縋るミラ。野生児君は、「俺に服従するか？」とミラが座っていた玉座に腰掛け問うと、「はい」と答え、その証として豊満な胸でパイズリをして、野生児君の巨チンに長い舌を使って奉仕し、出てきたザーメンを一滴も溢さず飲み込む。卵とミラを抱えた野生児君は、ダンジョンを後にし、魔族領へ戻るのでした。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 8530, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "くろニャン", "screen_name": "kuronyan9628", "avatar_url": "https://pbs.twimg.com/profile_images/1768205583004643328/J3uldtxo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/68617492/1710408065/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 276456, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "タバスコパスタ🔞NSFW", "screen_name": "mo38mo", "avatar_url": "https://pbs.twimg.com/profile_images/1577791490738114561/BDIp6p3F.jpg", "header_url": "https://pbs.twimg.com/profile_banners/469160755/1768781696/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 49}, {"id": 436501, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "なか Naka", "screen_name": "cynaka", "avatar_url": "https://pbs.twimg.com/profile_images/1478949162540744711/xlj6lubY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/98102034/1751103088/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 21, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 102406