=crop&crop=top&w=200&h=200&s=625636271481ac66d66ce4f2e7f3865c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7219b154/uploads/origins/f91cc1c4-5cdf-450a-8be8-b59ccc155606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d3346f729c6c03c112b40edde380e46", "srcset": "https://si.imgix.net/7219b154/uploads/origins/f91cc1c4-5cdf-450a-8be8-b59ccc155606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d3346f729c6c03c112b40edde380e46, https://si.imgix.net/7219b154/uploads/origins/f91cc1c4-5cdf-450a-8be8-b59ccc155606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8524b6e4fb8371700938cfd121285e0 2x, https://si.imgix.net/7219b154/uploads/origins/f91cc1c4-5cdf-450a-8be8-b59ccc155606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dbf5632e9b35e007cfe5fc3e0eb42dac 3x"}, "body": "こんにちは、いつもナマツメ先生の絵を楽しく拝見させていただいております、のりしおたろうという者です。アイコンの製作をしていただきたく依頼させてもらいました。\n\nリクエスト内容ですが、「ブルーアーカイブ」より「天童アリス(メイド)」で、任務クリア時のようにモップを片手に持ち、もう片方の手は腰に当て、少しドヤ顔をしている感じの全身絵でお願いしたいです。(リザルト画面の画像を添付します)\n\n宛名はアイコンの範囲外になる右下に「@Norinorishio」と書いてくれると嬉しいです。\n\nお引き受けいただけましたら、是非よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1gi6iLl03ie9fokZFq6jMR32Au55gHsDM/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@namatume/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3657880, "client_id": 3220365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70f93b11/uploads/origins/bb8b5dae-3533-494e-b9f7-e92d2130e357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43d817eb07c2087d45546146545da6e6", "srcset": "https://si.imgix.net/70f93b11/uploads/origins/bb8b5dae-3533-494e-b9f7-e92d2130e357?bg=%23fff&auto=format%2Ccompress&fm=webp&fit