状態\n・中出しでフィニッシュ\n\nその他、具体的な構図や表情等、仔細についてはお任せします。\n思いっきりらぶらぶあまあまな方向性で描いていただけると嬉しいです。\n\n\n(参考)原作中での様子を確認されたい場合は、ゲーム中で「執務室」→「アルバム」→「イベントストーリー」と進み、\n「憧れをファッションに込めて」(2022/5/16～5/30)を選ぶと初登場時のイベントシナリオを閲覧できます。\n\n立ち絵スクリーンショット: https://imgur.com/a/EApLf7Y\nWiki: https://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%9B%E3%83%AB%E3%83%A0%E3%82%B7%E3%83%A7%E3%83%AB%E3%83%87%E3%82%A3%E3%82%A2", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@peroperocino/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3190811, "client_id": 2767745, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66f401d6/uploads/origins/c58d0f87-fd29-40b4-a9a5-338cb02c1dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f164816078888a186338f2fe05ab70e4", "srcset": "https://si.imgix.net/66f401d6/uploads/origins/c58d0f87-fd29-40b4-a9a5-338cb02c1dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f164816078888a186338f2fe05ab70e4, https://si.imgix.net/66f401d6/uploads/origins/c58d0f87-fd29-40b4-a9a5-338cb02c1dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=572925a4747064b85e69b975bfb655b4 2x, https://si.imgix.net/66f401d6/uploads/origins/c58d0f87-fd29-40b4-a9a5-338cb02c1dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1afe2aeb5801f686860c0f88415831c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66f401d6/uploads/origins/c58d0f87-fd29-40b4-a9a5-338cb02c1dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55c8264f5e4c13951f86772dc3674fa4", "srcset": "https://si.imgix.net/66f401d6/uploads/origins/c58d0f87-fd29-40b4-a9a5-338cb02c1dcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55c8264f5e4c13951f86772dc367