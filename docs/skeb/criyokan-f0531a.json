rop=top&w=200&h=200&s=0bb9ba4ab2f43ee8f0aa69c66215bd53, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d2c4d9189c1b1b78329d92a4f9565a0 2x, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=935999e71856048ad1d152ff0676c337 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69edb3c36b2209c7ef80c4a44fbfaa5e", "srcset": "https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69edb3c36b2209c7ef80c4a44fbfaa5e, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9143be2d083ea461f86719d747c5b8d 2x, https://si.imgix.net/d5935e92/uploads/origins/cc1c1b08-e98b-4d80-ab46-a58ea9e40df1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e96e70709cff312ade54754d860636a 3x"}, "body": "はじめまして、Xで募集を見掛けまして、pixivを拝見したところ、可愛い絵柄が好みだったのでリクエストさせていただきます！\n\n描いて欲しいのは、桜弥（おうみ）というOCです。\nこの子に、ホイップあん様が可愛いと思うコスプレをさせてあげて欲しいなと思っています。\n出来れば全身で見たいですが、描ける範囲で描いてくれたら嬉しいです！\n資料に大量に詰め込んであるので、その中からでもいいですし、全く関係なくても大丈夫です。\n※三つ目の資料は千件以上あるので見なくても全然大丈夫です。\n構図やシチュエーションもお任せいたします。\n\n桜弥（おうみ）\n17歳、166cm、Dカップ。ボブヘアー。姉がいるが、姉が巨乳で自分が普通なのがコンプレックス。その割にオシャレのためなら胸をアピールすることも忘れない。姉がコスプレ好きで、それに付き合っていろんな服を着させられたりしている。髪が短いのは姉にアレンジさせられまくるのを回避するため。\n髪にインナーカラーが入っている（三面図参照）目の色はインナーカラーと同じで緑ではないです（AIで資料を制作しているためややこしいですが、三面図参考でお願いします）\n\nもしご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw\nhttps://drive.google.com/drive/folders/1umL6bP_qJsYGhPLdkkSpP8bRMCBOUqkK", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@criyokan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 389339, "client_id": 3731180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=593213656934437678c14a9603a274d6", "srcset": "https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=593213656934437678c14a9603a274d6, https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38ae9c795d4286dd953b68c4169c04a5 2x, https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64086d562e75f3f12d718d223f3d8357 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65fa566075cbcf66cd90f5d9c80b1199", "srcset": "https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65fa566075cbcf66cd90f5d9c80b1199, https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7648419a4580936e10b2ec98af3a8b08 2x, https://si.imgix.net/f1956be7/uploads/origins/35efe70c-243f-4005-bbb6-0d1006d8dd67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b637cb0335f585e8e081e8a4a16b515 3x"}, "body": "ホイップあん様 \n\nはじめまして、柚花しゆと申します。\nイラストを拝見し、ぜひ私【柚花しゆ】を描いていただきたいと思い、\nリクエストさせていただきました。 \n\n【概要】\nサムネイルなどでも使用したいため、頭部や髪、ケモ耳など上半身の左右が切れない形でお願いします。 \n可能であれば、こちら(https://skeb.jp/@criyokan/works/1)のイラストのように動きのある全身イラストでお願いします。\n 構図はホイップあん様にお任せさせてください。\n表情差分もいただけると嬉しいです。（微笑んでいる、焦っている、ウインク、満面の笑み等）\n\n【参考資料】(※目の中に花があり足が透けておりますので、イラストに反映していただきたいです。) \nhttps://drive.google.com/file/d/1ixd36W2PADmelr82pS4gLWCTotrsRXtg/view?usp=drive_link \nhttps://drive.google.com/file/d/12b-88xkVz64t4kj5LtGM-HbgpycVU_DW/view?usp=drive_link \nhttps://drive.google.com/file/d/1KvUP0WCExuovO19ovsDvOm43NOdXwkc1/view?usp=drive_link \n【X】 https://x.com/qoxo89 \n【YouTube】 \nhttps://youtube.com/channel/UC-L1fp6YThBsRp81rq-zdpw?si=hyC1XIA6EA1u8t-u  \n\n【使用用途】\n Youtubeでのサムネイルや配信内（後に収益化あり）、動画内での使用、\n SNSでの宣伝活動、YouTubeや各種SNSでのアイコンやバナー等で使用、 \n配信者や企業とコラボする際に共有、ネットプリント、返礼品、\nFANBOXでの使用、 FANBOXプリント、\nグッズ作成販売、商用利用\n ※上記にNGある場合はお手数ですが、リクエスト拒否をお願いします。\n\n【納品形式】 人物、背景、文字でレイヤーを分けたPSD形式 PSD納品が難しい場合は、背景透過人物画像(PNG)もいただきたいです。\n\nここまでお読みいただき、ありがとうございました。\nご検討のほどよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@criyokan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 389339, "client_id": 2973566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31c1299d/uploads/origins/e5a392a6-7704-4af2-9c6b-247034d906da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e864e5709a6bbcdcc77e8bae93a700ba", "srcset": "https://si.imgix.net/31c1299d/uploads/origins/e5a392a6-7704-4af2-9c6b-247034d906da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e864e5709a6bbcdcc77e8bae93a700ba, https://si.imgix.net/31c1299d/uploads/origins/e5a392a6-7704-4af2-9c6b-247034d906da?bg=%23fff&auto=forma