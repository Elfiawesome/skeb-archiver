-e9f5-4de7-a195-9bc78134f988?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bab0ec019b7b1dd8129a268013063bd, https://si.imgix.net/bc93c270/uploads/origins/b58015cf-e9f5-4de7-a195-9bc78134f988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ebc26cd6e59bf4462abf6524d6cec6e 2x, https://si.imgix.net/bc93c270/uploads/origins/b58015cf-e9f5-4de7-a195-9bc78134f988?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3042c1f0da2264d75c2dbc255ae54def 3x"}, "body": "\ub2a6\uc5b4\uc84c\uc2b5\ub2c8\ub2e4\ub9cc \uc7ac\uc804\uc1a1\uc785\ub2c8\ub2e4, \uce90\ub9ad\ud130\ub97c \ud63c\uc790 \ubcc0\uacbd\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4 \ub610 \ub9c8\uc6b0\uc2a4 \uadf8\ub9bc\uc73c\ub85c \uc8c4\uc1a1\ud569\ub2c8\ub2e4\ub9cc, \uc2dc\ucd94\uc758 \ud76c\ub9dd \uc774\ubbf8\uc9c0\ub97c \ucca8\ubd80\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4 \uc4f8\uc9c0\ub3c4 \uc815\ub3c4\uc785\ub2c8\ub2e4\ub9cc \ub4dc M \uc18c\uc124\uc758 \uc0bd\ud654\uc5d0 \uc774\uc6a9\ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4 \uc2dc\ucd94 : \uc5b4\uae68\uc5d0\uc11c \uc544\ub798\ub97c \uac10\uac01 \ucc28\ub2e8 \ud568\uc815\uc5d0 \uc7a1\ud78c M\ub0a8\uc790\uac00, \ubcf8\uc778\uc774 \ubaa8\ub974\ub294 \uc0ac\uc774\uc5d0 \ud56d\ubb38\uc73c\ub85c \uc5ec\uccb4\ub97c \uc784\uc2e0\u00b7\ucd9c\uc0b0\ud558\ub294 \ud2b9\ub300 \ubcf4\ud14c \ubcf5\ubb18\uc0c1\uc73c\ub85c \uac1c\uc870\ub418\uc5b4 \uad6c\uba4d \uc18d\uc5d0\uc11c \ucd9c\uc0b0\ud55c \ub538\ub4e4(\uc81c\ubcf5 \uc774\ucf54 , \ube0c\ub808\uc774\uc2a4, \uc81c\uc2a4, \ubbf8\uc544, \ud504\ub808\ub370\ub9ac\uce74)\uc5d0 \ud610\uc624\u00b7\ubaa8\uba78\ub418\uba74\uc11c, \ud398\ud2b8\ub77c\ub97c \uc5ed\uc790 \ucd9c\uc0b0\uc2dc\ud0ac \uc218 \uc788\ub294 \ub4dc M\ud638\uc774\ud638\uc774\uc2dc\uce04 \uc721\ubcbd \ub4f1\uc73c\ub85c \ub192\uc774 \ub4f1 \uc870\uc815\ud574 OK\uc774\ubbc0\ub85c, \uc804\uc6d0\uc758 \ud45c\uc815&\uc637\uc758 \ucd08\uc720&\uc637\uc758 \ubcf4\ud14c \ubc30 \uac00 \ud655\uc778\ud560 \uc218 \uc788\ub294 \ubc30\uce58\ub098 \uad6c\ub3c4 \ud55c\ud3b8, \ud45c\uc815\uc740 \uc804\uc6d0 \uc5bc\uad74\uc758 \uc0c1\ubd80\ub098 \ub208\uc55e\uae4c\uc9c0 \uadf8\ub9bc\uc790\uac00 \uac78\ub9ac\ub294 \ub208\ub3d9\uc790\uc758 \ud558\uc774\ub77c\uc774\ud2b8 \uc5c6\ub294 \ud45c\uc815\uc73c\ub85c, \ubcc0\ud0dc \ub9c8\uc870\uc5d0\uc758 \ud610\uc624\uac10\uc744 \uc77c\uccb4 \uc228\uae30\uc9c0 \uc54a\ub294 \uac15\ud55c \ubaa8\uc695\uc758 \ud45c\uc815\uc744 \ud76c\ub9dd\ud569\ub2c8\ub2e4 \ud398\ud2b8\ub77c\uc758 \ub2e4\ub9ac \ub294 \uccb4\uc678\uc5d0 \ub098\uc640 \uc788\uc5b4, \uadf8 \uc774\uc678\ub294 M\ub0a8\uc790\uc758 \ud0dc\ub0b4\uc5d0 \ub4e4\uc5b4\uac00 \uc788\ub2e4(\ub2e4\ub9ac\ub85c\ubd80\ud130 \ub098\uc624\ub294 \uc5ed\uc790 \ucd9c\uc0b0 \uad6c\ub3c4) \ub2e8\uba74\ub3c4 \ubb18\uc0ac \ud76c\ub9dd\uc785\ub2c8\ub2e4 psd \ud615\uc2dd\uc758 \ub808\uc774\uc5b4 \uc804\ud658 \uac00\ub2a5\uc73c\ub85c \ud398\ud2b8\ub77c\uc758 \uc218\ud0dc\uc911 \uc77c\ub7ec\uc2a4\ud2b8& \uc810\uc561 \ud22c\uc131\uc774\uc758 \uc758\uc74c, \uc0ac\uc815 \ub4f1\uc758 \ud6a8\uacfc\uc74c \ucc28\ubd84, \uac01 \uce90\ub9ad\ud130\uc758 \ub208\ub3d9\uc790\uc758 \ud558\uc774\ub77c\uc774\ud2b8\uc758 \uc720\ubb34\ucc28\ubd84, \ub2e8\uba74\ub3c4 \uc5c6\uc74c/\ub2e8\uba74\ub3c4 \uc5c6\uc74c & \ub2e4\ub9ac\ub9cc \ub098\uc640 \uc788\ub294 \ucc28\ubd84 \ud76c\ub9dd\ud569\ub2c8\ub2e4 \uc804\uc6d0 (\ud2b9\ud788 \ucd9c\uc0b0\uc911\uc778 \ud398\ud2b8\ub77c\ub294 \uc591\uc218\ub85c \uc637\uc744 \uc816\uc740 \ubb18\uc0ac \ud76c\ub9dd) , \ubbf8\uc544, \ud398\ud2b8\ub77c\ub294 \ud551\ud06c\uc0c9 \ud22c\uba85) \ubc1c\uae30 \uc816\uaf2d\uc9c0 + \uc591\uc190\uc774 \ubb3b\ud790 \uc815\ub3c4 \ubd80\ub4dc\ub7fd\uace0, \ud55c\uc720\ub9cc\uc73c\ub85c \uc591\ud314\uc5d0\uc11c\ub3c4 \uc548\uc544 \ub123\uc744 \uc218\uc5c6\ub294, \uba38\ub9ac & \ub3d9\uccb4 \uc774\uc0c1\uc758 \uc0ac\uc774\uc988\ub85c, \ucd08\uc720\uc640 \uac19\uc740 \uc0ac\uc774\uc988\uc758 \ud2b9\ub300 \ucc29\uc758 \ubcf4\ud14c \ubc30 (\uc74c\ubb38 \ucca8\ubd80 \uc644\uc804 \uc637\uc758 \uc0c1\ud0dc \ud76c\ub9dd)\uacfc \ud568\uaed8 \uc637\uc744 \ud53c\uce58 \ud53c\uce58\ub85c \ub298\ub9ac\ub294 \ud06c\uae30 \ud76c\ub9dd M\ub0a8\uc790\ub294 \uc5ec\uc790 \ubab8 \ud55c \uba85 \uc785\ud2b9\ub300 \uc0ac\uc774\uc988&\uc784\uc2e0 \uc74c\ubb38 \ucca8\ubd80 \ubcf4\ud14c \ubc30\ub85c \uace0\ud1b5\uc774\ub098 \ub370\ubbf8\uc9c0\ub294 \uc77c\uc808 \uc5c6\uc774 \uc804\ub9bd\uc120\uc5d0\uc758 \ucf8c\uac10\uc73c\ub85c (\uc721\uad34\ub0b4\uc5d0) \ub300\ub7c9 \uc0ac\uc815 \ud558\uc9c0\ub9cc \ub0a8\uc131\uc758 \uc74c\uacbd\uc774\ub098 \uc625\uc8fc\uba38\ub2c8\ub97c \uacc4\ub780 \uc5ed\ud560\uc744 \ud558\ub294 \uc721\uad34\uac00 \ubaa8\uc790\uc774\ud06c \ubd88\ud544\uc694\ud55c \uc218\uc900\uc73c\ub85c \uc644\uc804\ud788 \ub36e\uc5b4 \ub0b4\ubd80\uc5d0\uc11c \uc74c\uacbd\uc744 \ucad3\uc544, \ucd9c\uc0b0\uc2dc \uac15\ub82c\ud55c \uc790\uadf9\uc73c\ub85c \uc721\uad34\uc758 \ub05d\uc5d0 \ud2b9\ub300 \uc815\uc561\uc218 \ud48d\uc120\uc774 \uc0dd\uae30\ub294 \ub300\ub7c9 \uc0ac\uc815 \ud76c\ub9dd \ud55c\uce35 \ub354 \uc5b4\uc870 \ub4f1 \ub9e1\uaca8\uc11c, \ubcf8\uc778\uc774 \ubaa8\ub974\ub294 \uc0ac\uc774\uc5d0, \uc5ec\uc131 \uce90\ub9ad\ud130\uc5d0 \uc758\ud0dc\ud558\ub294 \uc721\uad34 \uc74c\ub9c8\ub97c \ub0b4\ub294 \ubb18\uc0c1\uc73c\ub85c\uc11c \uc721\uccb4\uac00 \uc644\uc804\ud558\uac8c \ucd5c\uc801\ud654\ub418\uc5b4 \ubc84\ub824, \ub0a8\uc790\uc758 \ubc84\ub987\uc5d0 \uc784\uc2e0\ud55c \uac70\uad6c \ub9c8\uc870 \ucd9c\uc0b0 \uc0ac\uc815\ud574, \ub2e4\uc74c \uc721\uad34\ub780\uc5d0 \uc0ac\uc815\ud558\uace0 \uc218\uc815\uc2dc\ud0a4\ub294 \ubb34\ud55c \ub8e8\ud504\uac00 \uacb0\uc815\ub418\uc5b4 \uc55e\uc73c\ub85c\ub294 \ub178\uc778\ub3c4 \uc8fd\uc74c\ub3c4 \uc6a9\uc11c\ubc1b\uc9c0 \uc54a\uace0 \uc0ac\ub791\ud558\ub294 \ucd08\uc720 & \ubcf4\ud14c\ubcf5 \ubbf8\uc18c\ub140\ub9cc \uc601\uc6d0\ud788 \uafb8\uba70\uc838 \uc218\ubc31 \uc218\ucc9c\uba85\ub3c4 \ucd9c\uc0b0\uc2dc\ucf1c \ub418\ub294 \uc6b4\uba85\uc774 \ub41c