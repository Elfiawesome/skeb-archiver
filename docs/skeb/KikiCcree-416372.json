98-4551-bfac-60af479619ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4d0c76ef39ea98b161b1212ebbcc950", "srcset": "https://si.imgix.net/54e49aac/uploads/origins/e82c9c1c-9798-4551-bfac-60af479619ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4d0c76ef39ea98b161b1212ebbcc950, https://si.imgix.net/54e49aac/uploads/origins/e82c9c1c-9798-4551-bfac-60af479619ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d844f5ab362e8bef18bbaec2589d89fc 2x, https://si.imgix.net/54e49aac/uploads/origins/e82c9c1c-9798-4551-bfac-60af479619ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59280f6665e3cadaf5a87af4e31a8c26 3x"}, "body": "初めまして。オリジナル曲を演奏していますアンソロジーロックバンドのTALL TALEと申します。\nこの度、オリジナル曲のジャケットイラストを描いていただきたくリクエストさせていただきました。\nタイトルは「SLEEP IN MOONSHINE」という曲で、サブスク等やライブ映像等のアップなどは予定していない曲で、会場で物販を買っていただいた方への特典ＣＤにして、ライブ会場での演奏かあるいはＣＤのみで聞ける、ライブに足を運んでいただいた方への特別な曲にする予定です。\n曲や歌詞からイメージを本当に自由に描いていただければと思います。\nCDジャケット印刷用（12cm正方形・300dpi・CMYK・塗り足し3mm）で制作をお願いします\n参考資料に音源と歌詞、バンドのアーティスト写真を添付させていただきます。\nどうぞよろしくお願いいたします。\n\nhttps://1drv.ms/f/c/7c8ac4f6b2790f6c/IgDENZu5cHSDRIF8efdvfqffAdYcLjFxtbHd1RdBP1pk_Yg?e=b6fFxZ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KikiCcree/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2724304, "client_id": 3001024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2138a16d80c03fcc2fbb1c2fbae914a", "srcset": "https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2138a16d80c03fcc2fbb1c2fbae914a, https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7617ec3323df230ebda1ed9320bd1a62 2x, https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18d26e3b98d7cc06d246418b32e37ba0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c32c76c0298d18e79d24937ed9760a", "srcset": "https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c32c76c0298d18e79d24937ed9760a, https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=352adbe9d27fa359521a1b41a68b3e2f 2x, https://si.imgix.net/606e8669/uploads/origins/53a6225f-1fe8-434a-aa74-b3d7635b5c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=263e400b831e45b2b412a75183446f1c 3x"}, "body": "ききさん、初めまして！いつも素敵なイラストを拝見しております。特にききさんのバイオリニストのOCを見た時からずっとリクエストしたいと思っていました…バイオリンを凄く丁寧に描くところが素敵だと思っていて、よろしければ私のバイオリニストのOCのイラストをリクエストさせていただきます🙇‍♀️\n\n▶OCの特徴や性格\n・23歳/154cm\n・バイオリニスト、作曲家\n・少し尖った耳、牙（口を閉じているときは見えない）\n・右手の小指にシルバーの指輪\n・内向的、人とはあまり関わりたくない\n・別にわざとしてるわけではないが、他人と話すと少し冷たい\n・ほとんど無表情\n・容姿で人気があるが、友達が少ないから音楽だけに集中してる\n・本当は短気で嫉妬深いが、いい人だと思われたいからあまり表に出せない\n・自己評価が凄く低い、自分に素直なれない\n\n▶リクエスト内容\nバイオリンがあればどんなポーズでも大丈夫です！構図はききさんにお任せします🙇‍♀️服装と髪型を変えていただいても大丈夫です\n\n金額に不足があれば再送要請していただいても構いません。ご検討いただけますと幸いです！よろしくお願いします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1AoMsJah003qisOVmmhRWHJAhoJ2Wsjq2?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KikiCcree/w