動画内及びサムネイルへの利用\n・SNS、ネップリ、FANBOX上での公開、壁紙、アイコン、ヘッダー利用\n\n【納品形式】\n可能であれば未統合PSDファイルあるいはレイヤー別の透過済PNGファイルでの納品を希望します。\n\n●参考資料\nhttps://drive.google.com/drive/folders/18tMZIUNX6XdYCZOT1xv6xX25kB2XNej7?usp=sharing\n\n●凄井カプリ\nX：\nhttps://x.com/sugoi_capri?s=21\nY：\nhttps://www.youtube.com/@sugoicapri\n\n以上、ご検討いただけますと幸いです。\nよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuro015896/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3058389, "client_id": 3511973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c526e08/uploads/origins/c1e092f0-1333-40f6-8163-4ab8eae234c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aa7754eb1f9c90aaeb77ed6ea2bfc61", "srcset": "https://si.imgix.net/3c526e08/uploads/origins/c1e092f0-1333-40f6-8163-4ab8eae234c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aa7754eb1f9c90aaeb77ed6ea2bfc61, https://si.imgix.net/3c526e08/uploads/origins/c1e092f0-1333-40f6-8163-4ab8eae234c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89122dd7ea5820ac69c3d7a24869292f 2x, https://si.imgix.net/3c526e08/uploads/origins/c1e092f0-1333-40f6-8163-4ab8eae234c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c62f68b152c5f6937009c5c2913866e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c526e08/uploads/origins/c1e092f0-1333-40f6-8163-4ab8eae234c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af82c872bedb9f3b07e160cfb9339b1a", "srcset": "https://si.imgix.net/3c526e08/uploads/origins/c1e092f0-1333-40f6-8163-4ab8eae234c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af82c872bedb9f3b07e160cfb9339b1a, https://si.imgix.net/3c526e08/uploads/origins/c1e092f0-1333-40f6-