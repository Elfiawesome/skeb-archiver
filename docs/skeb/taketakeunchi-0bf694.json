なと思った2人のリクエストを送らせていただきました。\n\nお願いしたいのはTRPGCoC『レプリカントの葬列』で作成した2人の創作キャラクターです。\nコンビで怪盗を組んでいる2人になります。\n\n・月森 鵂介／怪盗／モチーフ：みみずく\n・鷺宮 珀玖／贋作師／モチーフ：白鷺\n\n2人の関係性は出会い当初はビジネスとして協力していたが、ある出来事からとても仲良くなりました。\nキャラクターの資料や詳細はURLの方にあげてあります。\n\n構図等は基本的にお任せで好きなように描いていただきたいです。\n基本は私服希望ですが、怪盗姿を描いて頂いても勿論構いません。\n基本衣装などはアレンジしても大丈夫ですし、上記を無視してすべてを描きやすいようにして頂いても大丈夫です。\n\n可能であればどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10yk9x-nv5PI5wHrnaluoVwvjeg2UP5Va?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@taketakeunchi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3752431, "client_id": 3516337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b38d063d/uploads/origins/3bf8195a-90a2-4b0c-8cd2-feb088aebfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76ab00d610a36ed6400678c08b7e0133", "srcset": "https://si.imgix.net/b38d063d/uploads/origins/3bf8195a-90a2-4b0c-8cd2-feb088aebfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76ab00d610a36ed6400678c08b7e0133, https://si.imgix.net/b38d063d/uploads/origins/3bf8195a-90a2-4b0c-8cd2-feb088aebfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e0bd24f15a0fe65bcd05b3f42005feb 2x, https://si.imgix.net/b38d063d/uploads/origins/3bf8195a-90a2-4b0c-8cd2-feb088aebfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c47aa1db13d00291a906dda7b9c4060 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b38d063d/uploads/origins/3bf8195a-90a2-4b0c-8cd2-feb088aebfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34b9960130782cb1c9730ae892335fca", "srcset": "https://si.imgix.net/b38d063d/uploads/origins/3bf8195a-90a2-4b0c-8cd2-feb088aebfa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr