なり化の術式を受けてしまい\n色仕掛けされるシチュを漫画形式でお願いします\n\n内容\nノエルが戦闘中Esの胸をじっと見ていると、Esがノエルを男と勘違いして胸を揺らし誘惑\n(実際は巨乳のEsを見て羨ましがっている)\nノエルが「自分は女です!」と訂正。Esも謝罪するが\nその隙にEsがふたなり化の術式を発動しノエルを誘惑\n誘惑は胸揉ませ→パイズリして射精→射精直後のペニスを更にパイズリ\n→乳圧を強めて射精させる→ノエルにぱふぱふしてメロメロにさせて終了\n\nEsの胸はこちら程の巨乳で→https://skeb.jp/@samentyu/works/9\nノエルは旧衣装のボーイッシュな感じで→https://www.pixiv.net/artworks/113647596\n二人とも着衣でEsはパイズリ＆ぱふぱふのシーンは胸をはだけて\n乳首が見える感じです", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@samentyu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1367226, "client_id": 23911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/292f0288/uploads/origins/5f466639-8d34-45dc-bd93-e7e8d91dc4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f04aa595f5b491b88c75083ac264074", "srcset": "https://si.imgix.net/292f0288/uploads/origins/5f466639-8d34-45dc-bd93-e7e8d91dc4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f04aa595f5b491b88c75083ac264074, https://si.imgix.net/292f0288/uploads/origins/5f466639-8d34-45dc-bd93-e7e8d91dc4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9848f961bc2d9e2197f4e20694d47747 2x, https://si.imgix.net/292f0288/uploads/origins/5f466639-8d34-45dc-bd93-e7e8d91dc4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c0ca2d0959f8b0ecb90caeb3f43ff12 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/292f0288/uploads/origins/5f466639-8d34-45dc-bd93-e7e8d91dc4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d403a126564995d33a334c09ab663694", "srcset": "https://si.imgix.net/292f0288/uploads/origins/5f466639-8d34-45dc-bd93-e7e8d91dc4b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d403a126564995d33a334c09ab663694, https://s