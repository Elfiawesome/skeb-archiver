/llas.gamedbs.jp/chara/show/12/827\n\n海で鍛えた筋肉が自慢の子なので\n先生の普段通りの描写をしていただけたら嬉しいです。\n\n構図\n・表情は優しく微笑んでいてガニ股気味に足を開いた格好\n・全裸汗だくで全身に踊り子のような金色のボディーチェーンを纏っている\n・宝飾付のリングピアスを乳首、クリにつけてボディチェーンと連結\n・裸足にベアフットサンダル\n・下腹部に淫紋\n・背景白シーツで股間付近に潮吹き跡のシミ\n\n可能なら行ける範囲で構いませんので以下差分があると嬉しいです\n・裸体と装飾はレイヤを分けてほしいです\n・局部は装飾や体液、陰毛等で覆って修正が不要になる差分\n・マニキュア、ペディキュア\n・エッチな水着跡の日焼け\n・表情差分（感じている、誘い、怯え、放心等）\n・ぼて腹と母乳があふれている状態\n・他に試してみたいことがあれば\n\n衣装や構図はお任せします。\n以上、難しい内容かもしれませんがご検討いただけると幸いです\n\nhttps://drive.google.com/drive/folders/1SAu9oyXBYCVolyAPL5BUge7XL-3r1lxA?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@massivek11/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3178920, "client_id": 633904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c07f3935/uploads/origins/47b738b9-9ad5-403a-b456-6ed865043bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d05a1ded331b831ceb329e6d2cd63037", "srcset": "https://si.imgix.net/c07f3935/uploads/origins/47b738b9-9ad5-403a-b456-6ed865043bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d05a1ded331b831ceb329e6d2cd63037, https://si.imgix.net/c07f3935/uploads/origins/47b738b9-9ad5-403a-b456-6ed865043bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=399eb330b934c0b18a132aaf9ff94076 2x, https://si.imgix.net/c07f3935/uploads/origins/47b738b9-9ad5-403a-b456-6ed865043bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72a988422feed7f508c2c82b9178b391 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c07f3935/uploads/origins/47b738b9-9ad5-403a-b456-6ed865043bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73ae5012def9c438e99e37b98e771fd4", "srcset": "https://si.imgix.net/c07f3935/uploads/origins/47b738b9-9a