net/4dedc2f7/uploads/origins/5a60796f-6dac-4275-bef4-8601495976bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57ebe32b57792413a9f2b7f3c1b936c, https://si.imgix.net/4dedc2f7/uploads/origins/5a60796f-6dac-4275-bef4-8601495976bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5fe22007b219a76471839753b1529acf 2x, https://si.imgix.net/4dedc2f7/uploads/origins/5a60796f-6dac-4275-bef4-8601495976bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28eaf7a1c53dd7da9fdf233d4f850fa0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dedc2f7/uploads/origins/5a60796f-6dac-4275-bef4-8601495976bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b1845b1a50752742e50ed942d457ae", "srcset": "https://si.imgix.net/4dedc2f7/uploads/origins/5a60796f-6dac-4275-bef4-8601495976bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b1845b1a50752742e50ed942d457ae, https://si.imgix.net/4dedc2f7/uploads/origins/5a60796f-6dac-4275-bef4-8601495976bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84007cd9b26e46a42b97882179485dff 2x, https://si.imgix.net/4dedc2f7/uploads/origins/5a60796f-6dac-4275-bef4-8601495976bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a2cda2cfa33daecf96e16583d960174 3x"}, "body": "CoC「四季送り」の立ち絵をお願いします。\nHO4冬の通常、制服、戦闘差分の３つ\n\n＊通常の服＊\n上の服はパーカー\nズボンはカーゴパンツの七分丈\n歳は２６歳ですが、童顔で見た目２０歳以下っぽい感じでお願いしまうす。\n\n＊戦闘＊\n戦闘差分では注射器持たせてほしい。\nペロってしているのは戦闘中の表情でやってほしくて\n舌はぴくるーの時は下向きについてますが、上向きにしてほしいなって・・・。\n悪戯っ子\n\n表情付けましたがうるせえ一つだけだ！ってなら大丈夫です。\n\n軽いプロフィール\n冬根　小炉李（ふゆね　ころり）\n一人称はおれ\n\n普段は甘味処「あび」でぼーっとしている。\nあびのみんながワイワイしているのを見ているのが好き。\n今日もにぎやかだね。\n\nチーズが好き\nなんにでもチーズをかけようとする\n焼いても、そのままでも美味しいよね\nチーズジャンキー\n\n悪戯するのも好き\nそっと気配を消して急にわってやる\nみんながびっくりしてくれるのが楽しくてついついやっちゃう。\n\n＊殺し方＊\nターゲットを動けなくして、相手に体温が急激に下がる薬液を注入。\n凍死させる。\n寒いって辛いよね。くすくす。\n\nモチーフはハツカネズミ。\n\nhttps://drive.google.com/drive/folders/1ANY7GHwdISQzYe_tEiJLP1WchWOKRUiH?usp=sharing", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inochi01/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2752849, "client_id": 2398426, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/516184a8/uploads/origins/2c1dad18-9d3d-41b6-b564-be0e50bd0df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8554a9862f9358087b3dcb34e4b3b58", "srcset": "https://si.imgix.net/516184a8/uploads/origins/2c1dad18-9d3d-41b6-b564-be0e50bd0df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8554a9862f9358087b3dcb34e4b3b58, https://si.imgix.net/516184a8/uploads/origins/2c1dad18-9d3d-41b6-b564-be0e50bd0df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6870b4d3b9f4aa73b8b6aba7480c8498 2x, https://si.imgix.net/516184a8/uploads/origins/2c1dad18-9d3d-41b6-b564-be0e50bd0df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b624eafaf58b1dd20adbaeb562a1834e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/516184a8/uploads/origins/2c1dad18-9d3d-41b6-b564-be0e50bd0df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aeaa054da3274f91b25964526cf524f7", "srcset": "https://si.imgix.net/516184a8/uploads/origins/2c1dad18-9d3d-41b6-b564-be0e50bd0df0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aeaa054da3274f91b25964526cf524f7, https://si.imgix.net/516184a8/uploads/origins/2c1dad18-9d3d-41b6-b564-be0e50bd0df0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84cbed0d0b55f53f4f8ce3a63fb4d04e 2x, https://si.imgix.net/516184a8/uploads/origins/2c1dad1