200&h=200&blur=200&s=061341da736eaa536a2422a9f1fd6c5e", "srcset": "https://si.imgix.net/60b90689/uploads/origins/6be13503-e127-4f9e-b1fa-bc1409e40f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=061341da736eaa536a2422a9f1fd6c5e, https://si.imgix.net/60b90689/uploads/origins/6be13503-e127-4f9e-b1fa-bc1409e40f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23d8c7666e1116fd47160bcc555553a5 2x, https://si.imgix.net/60b90689/uploads/origins/6be13503-e127-4f9e-b1fa-bc1409e40f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=688aaa8c6e0a3c703c72c68af804c272 3x"}, "body": "skeb依頼です。\n\n世界観:銃火器での戦闘、近未来\n\n・オリジナルキャラクター(オリキャラ)\n・黒髪は10代、オレンジ髪は30代の先輩後輩\nかっこいい姿orてのはしさんの描かれるミニキャラクターが好きなので、お任せします❗️\nよろしくお願いします。\n\nhttps://drive.google.com/file/d/1grt6YlooOc2aRhN4hHtbyhJrTT5oLLgQ/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tenohashi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2056464, "client_id": 3695865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b25fbd0d8a66af14ed5741238f89be5", "srcset": "https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b25fbd0d8a66af14ed5741238f89be5, https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa5f0b64aa07895d575bb52ecb4632de 2x, https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1afd57842bf4179e23bab7dce015364b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef0a0fc3c9ff778adb2c6c627fb5570", "srcset": "https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef0a0fc3c9ff778adb2c6c627fb5570, https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b457ba35d96684cf652588d7cc260dd 2x, https://si.imgix.net/08a1ebc1/uploads/origins/f32065f5-6481-4f3f-959f-46388e5d5b6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61f9d8dddeefacacb8c2556cfe6821c0 3x"}, "body": "短冊と申します。\nこの度は探索者のスチル（イラスト）を依頼させていただきたく、再度ご連絡いたしました。\n資料を添付し忘れ、お手数をおかけして大変申し訳ありません…。\n\n内容としては以下のようなものを考えています。\n\n・・・\n\n灰と甘露 HO.5 不幸体質　蝶化身\nのスチル（ipad airの壁紙にも使用させていただく予定です。）。\n夜の住宅街で、薄ら笑いを浮かべながら立っている恐ろしい雰囲気のPCを、てのはしさんの絵柄で描いていただきたいと思っています。\n衣装は、資料に載っている、白とオレンジの和服でお願いいたします。\n\n・・・\n\nてのはしさんのイラストにはいつも楽しませてもらっています。塗りとキャラクターデザインがとても好みです！特に、はいかんのPCがとても可愛らしく、目のデザインがとても魅力的でした。あ下のPCも良い髪の塗りとデザイン、口の色合いをされてると思います…！いつも新しい探索者のデザインを見られるのを、楽しみにしております！\n\n長々と失礼しました。\nご迷惑をおかけしましたが、ご縁があればよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uZ5vet_fB1I9vR5W3qYsQD0xWHK_Dlf0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tenohashi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2056464, "client_id": 3569389, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30d7ff98/uploads/origins/fe0f947d-f7a8-40cf-84b1-67217fec2070?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d18e463b791844a41f9d98945d