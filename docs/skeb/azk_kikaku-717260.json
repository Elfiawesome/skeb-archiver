われた経験が多々あり、唯一無二の光の関係です。\n普段は道を切り開く主人と、相手を引き立てる従者のようにふるまいますが、お互いが大切な友人同士です。\n二人とも金持ちの息子ではあり、ダンスパーティなどの華やかな場所や、\nカーチェイスや大立ち回りなどの一方でバディアクションシーンも多くこなします。\nロマンチスト同士でもあり、洋画や二人ともディズニーの王子様のような口調で語らうことも多いです。\nまだ年若い青年ですが、決める時は大人っぽく色っぽい雰囲気を醸し出します。\n\nキャラクターの作者同士の間のみで印刷して楽しむ可能性がございます。\n内容的に難しい点があれば、遠慮なく依頼をキャンセルしても問題ありません。\nご検討どうぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1tP08A7KybWGDbHTtDOXgI9ZPkAHEhKgJ?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itoyuhannmi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2578562, "client_id": 717637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afc08afb/uploads/origins/00febbdc-7575-4f1d-91d3-55a44a55214c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ea996fb52c5e30751c65629a3fadca", "srcset": "https://si.imgix.net/afc08afb/uploads/origins/00febbdc-7575-4f1d-91d3-55a44a55214c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8ea996fb52c5e30751c65629a3fadca, https://si.imgix.net/afc08afb/uploads/origins/00febbdc-7575-4f1d-91d3-55a44a55214c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33cd97aecc45b229fed378d11964a9a9 2x, https://si.imgix.net/afc08afb/uploads/origins/00febbdc-7575-4f1d-91d3-55a44a55214c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39e5ea15f200c3a4ce99aa71479ab235 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afc08afb/uploads/origins/00febbdc-7575-4f1d-91d3-55a44a55214c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddce7aab74de87702fa3e5346b360c67", "srcset": "https://si.imgix.net/afc08afb/uploads/origins/00febbdc-7575-4f1d-91d3-55a44a55214c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddce7aab74de