8b-9a0d-cd5ddbf379bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2006e23e8937ae006a20d24875a57174 3x"}, "body": "Hello! I saw your other work on the main page. The atmosphere was so pretty that I wanted to order a request - I would like to request two characters please!\n\nhttps://drive.google.com/file/d/1ftlnxMlyPnF2YduEVxTDpXjACg4qAlfz/view?usp=sharing\nhttps://drive.google.com/file/d/1TsJuf8j9TwdI24ekGtAxxYYAewJvqdz8/view?usp=sharing\n\nThe woman is a vampire and the man is a demon. You can draw them with any pose or activity! Battle, eating, playing game, friendship, or couple-like. Please draw freely~", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@ororooooooops/works/155", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 436837, "client_id": 717637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=deff4e8f043952fef520de341f948e09", "srcset": "https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=deff4e8f043952fef520de341f948e09, https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=409bec980f6ddc9067f462c3c1cd3fba 2x, https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d22bab6906a41cf90e93cf53084e1aec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2f01313f0bc3a5ca2af6e829268ac7d", "srcset": "https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2f01313f0bc3a5ca2af6e829268ac7d, https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9691d0451267c5e206de8167965f1edd 2x, https://si.imgix.net/d79bf078/uploads/origins/f418dbfb-d11e-443d-9ecf-c54f0ea7e333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7811627937bc3c0314185ffc6a3c8c9 3x"}, "body": "オロロ先生、前回はステキなイラストをありがとうございました。\nオロロ先生のパッと華のある印象のイラストが宝物のようにうれしく、大切にさせていただいております。\n改めてリピートとしてご依頼をさせていただきたく思い、連絡をさせていただきました。\nTRPGで発生した（内容にはネタバレはありません）キャラクターになります。\n\n一緒に帰っていたり、梅の咲くお寺の縁側で休んだり、\n和菓子屋でお菓子を食べたり、肝試しをするようなシチュエーションで\nお任せしたく思います。\n\n■3人の関係性\n甘浮高校という高校の2年生で、幼なじみです。\n少し大正や和菓子などの和風モチーフをイメージしています。\nイメージとしては幼なじみ同士の姫＋騎士のような感じ。\n\n私のキャラクター（梅咲）はひなこが好きで、（両片思いくらいの距離感）\n架とは無二の唯一親友の関係性。架とひなこもまた性別を超えた友情があります。\n（遊ぶ継続の中で）怪異現象に巻き込まれることが多く、\nそれぞれがお互いを大切に思っており、それぞれを守ろうとしています。\n\n■キャラクター詳細\n赤髪男性：梅咲初音（うめさき-はつね）\nモチーフ：梅\n身長：183\n外見：赤毛、前髪に白のメッシュ、鶯色目で隠れている方の目は金眼\n体格：やや筋肉質\n性格：硬派で武人のような性格。責任感が強い。\n　　　寺生まれであり、いざとなれば錫杖で戦う\n\n栗色髪女性：藤杜ひなこ（ふじもり-ひなこ）\nモチーフ：藤\n身長：148\n外見：淡い髪色に紫目\n体格：小柄で女性的な体格\n性格：人見知りでおどおどした部分もあるが、芯の強い性格。\n\n紫髪男性：水菖 架（みしょう-かける）\nモチーフ：菖蒲\n身長：175\n外見：紫目に紫髪\n体格：普通\n性格：明るくゲームが大好きな現代っ子、友達想い。\n\n\n■使用用途\n・壁紙等として個人利用\n・友人への共有\n・個人利用の範囲での利益の生じない印刷物作成\n・SNSへの掲載（作者名も明記します）\n\n内容的に難しい点があれば、遠慮なく依頼をキャンセルしても問題ありません。\nご検討どうぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1uNnoU8jkLApIkQmwozxN5cCv8kkBmX-i?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wvr_h/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2227281, "client_id": 717637, "vtt_url": null, "