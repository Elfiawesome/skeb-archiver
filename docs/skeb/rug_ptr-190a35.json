ージ（中に入っているメモには、良い新年を迎えるための願いや希望が書かれています）を海に放つ彼女を想像しています。彼女はドレスを着ていますが、モデルシートにあるように、いつもの髪型をしています。\n\n背景は海の一部で、暗い空を花火が照らしている。\n\n(フォーマットは横長でお願いします）。\n\nVtuberのモデルとリファレンスへのリンクはこちら：\nhttps://drive.google.com/drive/folders/1ft2s_cbxKqnnCBfyhp88Hk8Jg41jHDJy?usp=sharing\n\n本当にありがとうございました！素敵な一日になりますように！♥", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rug_ptr/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17547, "client_id": 2890150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bfac14f/uploads/origins/aec239ee-3417-47f1-a93d-deece02cc24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=304268c9468833f5d2bc716be2a7df6c", "srcset": "https://si.imgix.net/8bfac14f/uploads/origins/aec239ee-3417-47f1-a93d-deece02cc24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=304268c9468833f5d2bc716be2a7df6c, https://si.imgix.net/8bfac14f/uploads/origins/aec239ee-3417-47f1-a93d-deece02cc24e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c66e7bac51e7eeca5ea4ee579aa62e0b 2x, https://si.imgix.net/8bfac14f/uploads/origins/aec239ee-3417-47f1-a93d-deece02cc24e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f58db16e6bfa0b0cccd7a11c54f58af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bfac14f/uploads/origins/aec239ee-3417-47f1-a93d-deece02cc24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f68f3d5271421994350e5fdde122ab", "srcset": "https://si.imgix.net/8bfac14f/uploads/origins/aec239ee-3417-47f1-a93d-deece02cc24e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0f68f3d5271421994350e5fdde122ab, https://si.imgix.net/8bfac14f/uploads/origins/aec239ee-3417-47f1-a93d-deece02cc24e?bg=%23fff&auto=fo