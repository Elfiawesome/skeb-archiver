.net/44ef4e64/uploads/origins/dcae6c9c-677c-4c17-ab4a-0a74e8bfa4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76d681c2c40c7726e9ce1b21d07ec05b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44ef4e64/uploads/origins/dcae6c9c-677c-4c17-ab4a-0a74e8bfa4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7524ac8b29889163113d9b40b5f18f5", "srcset": "https://si.imgix.net/44ef4e64/uploads/origins/dcae6c9c-677c-4c17-ab4a-0a74e8bfa4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7524ac8b29889163113d9b40b5f18f5, https://si.imgix.net/44ef4e64/uploads/origins/dcae6c9c-677c-4c17-ab4a-0a74e8bfa4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6710c96fb78c46dcb09ef6330a915bca 2x, https://si.imgix.net/44ef4e64/uploads/origins/dcae6c9c-677c-4c17-ab4a-0a74e8bfa4ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c7a0da94d9275db20d66a73afca4cda 3x"}, "body": "こんにちは、私は長い間、あなたの美しい妹紅の絵が大好きでした！  素晴らしい作品を本当にありがとうございます！💕💕\n\n過去に、妹紅がプリズムリバーウィズHのファンであることを描いた絵がありましたね。  でもその絵はもうないと思います。\n\nこのテーマのイラストをリクエストしてもいいですか？  妹紅がプリズムリバーウィズHのファンであるところを見たいです！\n\nフルバンドが無理なら、特に妹紅と雷鼓やリリカとの絡みが見たい。  (紅白の仲間...）もしかしたら、妹紅が一緒に写真を撮っているかもしれないし、彼女たちの関連グッズを持っているだけかもしれない。  どんな解釈でも結構です。\n\nよろしくお願いします！🙏\n\n(このテーマに対する私の誠意を表現する個人的な写真...笑) https://railyri.carrd.co/assets/images/gallery07/5012f55f_original.jpg", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@soboro_art0/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3538227, "client_id": 100024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6584ff9b/uploads/origins/e78b0882-402a-4b33-b52f-6bd04628a5d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27