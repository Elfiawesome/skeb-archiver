07e\u3063\u3066\u3082\u96e3\u6613\u5ea6\u306f\u5168\u54e1\u540c\u3058\u3067\u4e0a\u304c\u3063\u3066\u3044\u304f\n\u4f01\u753b\u306e\u90fd\u5408\u4e0a\u30e9\u30a4\u30d0\u30fc\u9054\u3082\u30a4\u30ad\u9854\u6211\u6162\u3068\u3044\u3046\u4e8b\u306f\u77e5\u3063\u3066\u3044\u307e\u3059\u306e\u3067\u6700\u521d\u304b\u3089\u9854\u304c\u6065\u305a\u304b\u3057\u305d\u3046\u306b\u8d64\u304f\u306a\u3063\u3066\u3044\u307e\u3059\n\n\u30fb\u753b\u9762\u306e\u914d\u7f6e\n\u7a2e\u4ed8\u3051\u30d0\u30e9\u30a8\u30c6\u30a3\u306e\u3088\u3046\u306b\u753b\u9762\u4e0a\u3092\u5404\u30e9\u30a4\u30d0\u30fc\u306e\u9854\u30a2\u30c3\u30d7\u3092\u753b\u9762\u4e0b\u5074\u306b\u5404\u30e9\u30a4\u30d0\u30fc\u3092\u6a2a\u4e00\u5217\u306b\u4e26\u3070\u305b\u3066\u304f\u3060\u3055\u3044\n\u30e9\u30a4\u30d0\u30fc\u9054\u306f\u5168\u54e1\u8db3\u3092\u30ac\u30cb\u80a1\u306b\u3057\u3066\u7acb\u3063\u3066\u3044\u3066\u304f\u3060\u3055\u3044\n\n\u30fb\u6d41\u308c\n1.\u300c\u4eca\u56de\u306f\u65b0\u4f01\u753b\uff01\u30e9\u30a4\u30d0\u30fc\u6211\u6162\u30c1\u30e3\u30ec\u30f3\u30b8\u301c\uff01\uff01\u300d\u30e9\u30a4\u30d0\u30fc\u9054\u306f\u6065\u305a\u304b\u3057\u305d\u3046\u306b\u5404\u3005\u306e\u6328\u62f6\u3092\u3059\u308b\n2.\u904b\u55b6\u30b9\u30bf\u30c3\u30d5\u306b\u3088\u308b\u30e9\u30a4\u30d0\u30fc\u7d39\u4ecb\n3.\u300c\u4eca\u56de\u306e\u4f01\u753b\u306e\u30eb\u30fc\u30eb\u306f\u6700\u5f8c\u307e\u3067\u30a4\u30ad\u9854\u3092\u6652\u3055\u306a\u3044\u3088\u3046\u306b\u6211\u6162\u3059\u308c\u3070\u8c6a\u83ef\u8cde\u54c1\u304c\u3082\u3089\u3048\u307e\u3059\uff01\uff01\u30e9\u30a4\u30d0\u30fc\u9054\u3082\u6e96\u5099\u4e07\u7aef\u306e\u3088\u3046\u3067\u3059\u306e\u3067\u65e9\u901f\u59cb\u3081\u307e\u3057\u3087\u3046\uff01\uff01\u300d\n4.\u30ec\u30d9\u30eb1(\u30d1\u30f3\u30c4\u8d8a\u3057\u30ed\u30fc\u30bf\u30fc)\n\u300c\u30ec\u30d9\u30eb1\u306f\u7686\u3055\u3093\u4f59\u88d5\u305d\u3046\u3067\u3059\u306d\u301c\u3001\u3067\u3059\u306e\u3067\u3069\u3093\u3069\u3093\u30ec\u30d9\u30eb\u3092\u4e0a\u3052\u3066\u3044\u304d\u307e\u3057\u3087\u3046\uff01\uff01\u300d\n5.\u30ec\u30d9\u30eb2(\u624b\u30de\u30f3)\n\u300c\u307e\u3060\u5e8f\u76e4\u3067\u3059\u304c\u611f\u3058\u3066\u305d\u3046\u306a\u4eba\u304c\u51fa\u3066\u304d\u307e\u3057\u305f\u306d\u301c\u3001\u307e\u3060\u307e\u3060\u7d9a\u304d\u307e\u3059\u306e\u3067\u9811\u5f35\u3063\u3066\u307b\u3057\u3044\u3067\u3059\u306d\uff01\u300d\n6.\u30ec\u30d9\u30eb3(\u96fb\u30de)\n\u300c\u304a\u304a\u3063\u3068\uff01\u30a4\u30c3\u3066\u3057\u307e\u3063\u305f\u65b9\u304c\u3044\u308b\u305d\u3046\u3067\u3059\u304c\u8868\u60c5\u306b\u306f\u51fa\u3066\u3044\u307e\u305b\u3093\u306e\u3067\u30bb\u30fc\u30d5\u3067\u3059\uff01\u3067\u3059\u304c\u5927\u5206\u3064\u3089\u305d\u3046\u306a\u306e\u3067\u305d\u308d\u305d\u308d1\u540d\u8131\u843d\u8005\u306f\u51fa\u308b\u304b\uff1f\u300d\n7.\u30ec\u30d9\u30eb4(\u624b\u30de\u30f3&\u30ed\u30fc\u30bf\u30fc)\n\u300c\u3053\u3053\u3067\u25ef\u25ef\u30a4\u30ad\u9854\u3092\u3057\u3066\u3057\u307e\u3063\u305f\u306e\u3067\u30a2\u30a6\u30c8\u301c\uff01\u30ea\u30bf\u30a4\u30a2\u3057\u305f\u25ef\u25ef\u306f\u30c1\u30e3\u30ec\u30f3\u30b8\u306f\u7d42\u308f\u308a\u307e\u3057\u305f\u304c\u96e3\u6613\u5ea6\u306f\u7d99\u7d9a\u3057\u3066\u4e0a\u304c\u3063\u3066\u3044\u304d\u307e\u3059\uff01\u300d\n8.\u30ec\u30d9\u30eb5(\u30d0\u30a4\u30d6)\n\u300c\u7d9a\u3044\u3066\u25ef\u25ef\u3082\u30a4\u30ad\u9854\u3092\u3057\u305f\u306e\u3067\u30a2\u30a6\u30c8\u301c\uff01\uff01\u6b8b\u308a2\u4eba\u3082\u9650\u754c\u304c\u8fd1\u3044\u304b\uff1f\uff1f\u300d\n9.\u30ec\u30d9\u30eb6(SEX)\n\u300c\u25ef\u25ef\u3082\u30a2\u30a6\u30c8\u301c\uff01\u5927\u5206\u9811\u5f35\u308a\u307e\u3057\u305f\u304c\u9650\u754c\u306e\u3088\u3046\u3067\u3057\u305f\u306d\u301c\u3001\u3055\u3066\u6b8b\u308b\u25ef\u25ef\u306f\u30af\u30ea\u30a2\u306a\u308b\u304b\uff1f\u300d\n10.\u30ec\u30d9\u30eb7(SEX&\u30ed\u30fc\u30bf\u30fc)\n\u300c\u3042\uff5e\u3068\uff01\u3001\u3053\u3053\u3067\u25ef\u25ef\u3082\u30a2\u30a6\u30c8\u3067\u5168\u54e1\u30c1\u30e3\u30ec\u30f3\u