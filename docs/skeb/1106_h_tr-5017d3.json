fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d0c0680a6db759a0a900cee494b102", "srcset": "https://si.imgix.net/24f9942b/uploads/origins/2eb8ed5c-27bf-44e4-af9d-e8d425ad32cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d0c0680a6db759a0a900cee494b102, https://si.imgix.net/24f9942b/uploads/origins/2eb8ed5c-27bf-44e4-af9d-e8d425ad32cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=794e92945847f79ccd492293b0cf5a37 2x, https://si.imgix.net/24f9942b/uploads/origins/2eb8ed5c-27bf-44e4-af9d-e8d425ad32cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02d1f133c756c9cfb34f938dd55d9f36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24f9942b/uploads/origins/2eb8ed5c-27bf-44e4-af9d-e8d425ad32cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4946b5410e3f4e784614fbca46b4510", "srcset": "https://si.imgix.net/24f9942b/uploads/origins/2eb8ed5c-27bf-44e4-af9d-e8d425ad32cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4946b5410e3f4e784614fbca46b4510, https://si.imgix.net/24f9942b/uploads/origins/2eb8ed5c-27bf-44e4-af9d-e8d425ad32cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3cfd2644a2023e24067e76545108dcbb 2x, https://si.imgix.net/24f9942b/uploads/origins/2eb8ed5c-27bf-44e4-af9d-e8d425ad32cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e45d56b2771ca4dcaa6aff2a78c2ac3 3x"}, "body": "初めまして。  \nいつも素敵なイラストを拝見しており、ぜひお願いしたくリクエストさせていただきました。\n\n【描いてほしい内容】\n・男の子\n・髪型：白と緑のウルフカット（白基調に緑のメッシュやインナーカラーっぽい感じをイメージしています）\n・髪の毛の見える位置に鈴を付けてください（例えば前髪やサイド、毛先などに小さめの鈴をいくつか）\n・全体の雰囲気：かわいらしくて少しミステリアスorクール寄りなど、お好きなテイストで大丈夫です！\n\n【使用用途】\n・配信などのアイコン\n・YouTubeやTwitchなどのサムネイル画\n（アイコン・サムネ用なので、顔が切れにくいバストアップ〜上半身くらいの構図だととても助かります）\n\n【その他お願い】\n・可能であれば人物のみの透過PNGを同梱いただけると、背景を自由に変えられて活動でとても使いやすいです（無理でしたら通常のPNG/JPGでも大丈夫です）\n・もし内容や金額が合わないようでしたら、遠慮なくキャンセルしていただいて大丈夫です！\n\nご多忙の中恐縮ですが、よろしくお願いいたします！素敵なイラストお待ちしております！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1106_h_tr/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 625521, "client_id": 2224464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c593435/uploads/origins/0ed3da91-6d83-4a43-9560-7c56a7c2cd28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b898305247932b8902c6f69497f6fe10", "srcset": "https://si.imgix.net/4c593435/uploads/origins/0ed3da91-6d83-4a43-9560-7c56a7c2cd28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b898305247932b8902c6f69497f6fe10, https://si.imgix.net/4c593435/uploads/origins/0ed3da91-6d83-4a43-9560-7c56a7c2cd28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5e6532b4922d653588e748aa846d4b41 2x, https://si.imgix.net/4c593435/uploads/origins/0ed3da91-6d83-4a43-9560-7c56a7c2cd28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05b51ebce683fb455fb4e156d0dd85e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c593435/uploads/origins/0ed3da91-6d83-4a43-9560-7c56a7c2cd28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0262dd6492ca6b358fc6ccda1b9f6bd", "srcset": "https://si.imgix.net/4c593435/uploads/origins/0ed3da91-6d83-4a43-9560-7c56a7c2cd28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f0262dd6492ca6b358fc6ccda1b9f6bd, https://si.imgix.net/4c593435/uploads/origins/0ed3da91-6d83-4a43-9560-7c56a7c2cd28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=748d28923cf15ed700f5223cdfdc5b2a 2x, https://si.imgix.net/4c593435/uploads/origins/0ed3da91