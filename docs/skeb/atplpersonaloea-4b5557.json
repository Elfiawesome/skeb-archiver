ゲーム配信などになるかと思います）\n使用許可も合わせて頂けますと幸いです。\n\n構図イメージとしては以下の通りです。\n・参考資料URL4枚目のような甲冑姿（ただし、絵柄は1〜2枚目程度のデフォルメ感）\n・配信サムネイルとして使用するため、横長の構図でお願いいたします\n・配信サムネイル使用時には文字などを入れるため、右側にキャラクターを寄せ、左側は背景として開けておいてください\n・おくづまさんの体は画面（こちら）側を向いており、肩から上だけが左奥にいるモンスター（ドラゴンなどの巨大なもの。種類はお任せします）へと振り返ろうとしている感じ\n・強大な敵を発見！挑むぞ！というややりりしめな表情でお願いします\n・背景なしキャラクターのみの差分も頂戴できますと助かります\n・私への宛名は不要です\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://twitter.com/OKZMaMa/status/1416417187292606466?s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@atplpersonaloea/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 340698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a632459/uploads/origins/3118e327-f725-4a7b-9620-891f12277e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d89aaa81746f33d0bc5572442423af0", "srcset": "https://si.imgix.net/0a632459/uploads/origins/3118e327-f725-4a7b-9620-891f12277e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d89aaa81746f33d0bc5572442423af0, https://si.imgix.net/0a632459/uploads/origins/3118e327-f725-4a7b-9620-891f12277e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=37c34392603d202349878948697fdcd7 2x, https://si.imgix.net/0a632459/uploads/origins/3118e327-f725-4a7b-9620-891f12277e50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7fcd9285410b62fa04e7d67b720da0b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a632459/uploads/origins/3118e327-f725-4a7b-9620-891f12277e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b2efb85b8fe7334c9ae7e3186218b1b", "srcset": "https://si.imgix.net/0a632459/uploads/origins/3118e327-f725-4a7b-9620-891f12277e50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b2e