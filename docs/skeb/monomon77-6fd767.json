f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80cf35edfdd184eea0ea62ac1e746554", "srcset": "https://si.imgix.net/2945e6c2/uploads/origins/3b924cbb-4f2c-436d-926b-39f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80cf35edfdd184eea0ea62ac1e746554, https://si.imgix.net/2945e6c2/uploads/origins/3b924cbb-4f2c-436d-926b-39f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba8f860b26afa62494e8e85e519829c6 2x, https://si.imgix.net/2945e6c2/uploads/origins/3b924cbb-4f2c-436d-926b-39f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13b9f22e7ca8509f45851075980a51ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2945e6c2/uploads/origins/3b924cbb-4f2c-436d-926b-39f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78803585d23f70cd45a1f06662da0d84", "srcset": "https://si.imgix.net/2945e6c2/uploads/origins/3b924cbb-4f2c-436d-926b-39f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78803585d23f70cd45a1f06662da0d84, https://si.imgix.net/2945e6c2/uploads/origins/3b924cbb-4f2c-436d-926b-39f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c1267c6bc8670b999261625ef09917c 2x, https://si.imgix.net/2945e6c2/uploads/origins/3b924cbb-4f2c-436d-926b-39f689817e9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94f91acb24e1d6739d4fee99d9419275 3x"}, "body": "こんにちは。私のキャラクター、ミチを描いていただきたいです。彼女はオニです。赤い鬼の角、または黒いサキュバスの角を描いてください。笑うと小さな牙が出てきます。唇や目の近くなどにある小さなほくろを描いてください。また、彼女は小さなセプタムリングといくつかのイヤリング、そして大きな黒いイヤリングを耳たぶにつけています（\"gauges\"）。彼女は黒いチョーカーや首輪をつけるのが好きです。\n\n服装は、日本の伝統的なものでも現代的なものでも構いませんが、腕や太ももは隠してください。カラーテーマは赤とピンクで、「赤鬼」のようなイメージです。^^\n\n彼女は怠け者で、いたずらっ子で、飴やお菓子をかじるのが好きです。青鬼の彼氏がいて、いつも彼のことを考えています。\n\nお役に立てれば幸いです。