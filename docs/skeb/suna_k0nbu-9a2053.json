7f2b166ad8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=873e3a10787a3ca3a5a024ab031cbb4a, https://si.imgix.net/2c8a7f16/uploads/origins/b62501ed-db7f-440d-82b3-7f2b166ad8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac6612bf52892222d88a175d7d567eec 2x, https://si.imgix.net/2c8a7f16/uploads/origins/b62501ed-db7f-440d-82b3-7f2b166ad8ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d603c3ffaead1edb0ffae53d1577d52 3x"}, "body": "私のオリジナルキャラクター、ブライゼンのカイリーを描いてほしい！彼女は22歳のポケモントレーナーで、自ら進んで人間からブライゼンへと変身した。通常のブライゼンとの主な違いは、両手に指が3本と親指があること、尾に棒状の部分がないこと、そして人間のままの薄い青色の髪を残していることだ。\n\nこのイラストでは、服を着ていない状態のカイリーを描いてほしいです。温泉の縁に座り、足を湯に浸している姿です。目を開け、リラックスした表情で微笑んでいる様子をお願いします。ブルースカイに再投稿する際はクレジットを明記します！https://imgur.com/a/xYfvvvK", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suna_k0nbu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3455015, "client_id": 3436971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ca143d55d5711d7925d23df044bc61", "srcset": "https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7ca143d55d5711d7925d23df044bc61, https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f021c2859170ffa794258f9960f70c3e 2x, https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0388260c1279939f3aa0707407ea2a57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7909fee47b4f17e1d3194bf13e71d3c9", "srcset": "https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7909fee47b4f17e1d3194bf13e71d3c9, https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c53b47f7642b1d660a0d64a5565386 2x, https://si.imgix.net/e7315b24/uploads/origins/f5427d2c-e66f-4ed1-bdc4-a27cbe31aa30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=49d5d162d876ee0e3df3d4e9f838d93c 3x"}, "body": "こんにちは！またお願いしたいことがあります。今回は再び2匹のヴァポレオンをイラストに描いてください。1匹目は青いマフラーを巻いたヴァポレオンで、名前はセレンです。2匹目は緑色の目と体全体に濃い青の模様があるヴァポレオンで、名前はスレイオンです。\n\n今回の作品では、スレイオンがセレンにデジタルペンとiPadを使った絵の描き方を教えている場面を描いてほしいです。スレイオンは落ち着いて経験豊富に、筆の運びを優しく実演したりセレンの手を導いたりしている様子で。一方セレンは、理解しようと集中しながらも少し戸惑っている表情にしてください。\n\n表情については、各キャラクターの少なくとも片方の目がはっきりと見えるように（真正面を向いていなくても構いません）。背景は複雑である必要はなく、室内シーンで十分です。その他の部分については、ご自身のスタイルや得意分野に最も合う方法で、自由にディテールや動きを加えてください。あなたの作品は本当に素晴らしく、いつも見るたびに幸せな気持ちになります。\n再びご依頼できて本当に嬉しいです。これからもあなたの創作活動を応援し続けます。あなたの解釈を心待ちにしております、どうもありがとうございます！Serenのオリジナルキャラクター：https://x.com/WATASHISEREN/status/2007311004947104133\nSLEONのオリジナルキャラクター:https://x.com/Sususususulang/status/1774845928689819649/photo/1（また、もしよろしければ、今回の依頼作品や過去の依頼作品をXに投稿していただいても全く構いません。）", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suna_k0nbu/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/753bda67/uploads/origins/8939df51-949e-443e-8794-ae0efb4b862f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&t