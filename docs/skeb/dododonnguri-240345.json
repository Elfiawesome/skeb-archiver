\n資料よりキャラごとの資料を1⃣と2️⃣で分けております。\n簡易的なもので申し訳ございません。 \n\n※2️⃣のキャラクターの頭に着いているリボンの色を赤か白に変更をお願いします。\n\n余裕があれば背景透過も納品していただければと思います。\n\n【使用用途】\n・これから依頼させていただく際の資料\n・SNS掲載、アイコン、ヘッダー等の使用\n\nよろしくお願いいたします！\n\n(金額不足、資料の不備 等ございましたら再送していただいて構いません。)\n\nhttps://drive.google.com/drive/folders/15aORi6J88R0rqs-vBKZodRw2r-5hFma6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dododonnguri/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3453637, "client_id": 3720695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5adff0c9/uploads/origins/ac4dc6df-d4cb-4790-a03d-219fffac9a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5558366896978e9207ebd6f3a8993f7e", "srcset": "https://si.imgix.net/5adff0c9/uploads/origins/ac4dc6df-d4cb-4790-a03d-219fffac9a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5558366896978e9207ebd6f3a8993f7e, https://si.imgix.net/5adff0c9/uploads/origins/ac4dc6df-d4cb-4790-a03d-219fffac9a65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52afa26ee680c351777a6710dc9548dc 2x, https://si.imgix.net/5adff0c9/uploads/origins/ac4dc6df-d4cb-4790-a03d-219fffac9a65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=508f1522e41a75f825a17b7c713fa949 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5adff0c9/uploads/origins/ac4dc6df-d4cb-4790-a03d-219fffac9a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90f29241ffcfbf9b4a7e474fb4f21a99", "srcset": "https://si.imgix.net/5adff0c9/uploads/origins/ac4dc6df-d4cb-4790-a03d-219fffac9a65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90f29241ffcfbf9b4a7e474fb4f21a99, https://si.imgix.net/5adff0c9/uploads/origins/ac4dc6df-d4cb-4790-a03d-219fffac9a