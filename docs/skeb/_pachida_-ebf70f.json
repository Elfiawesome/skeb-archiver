ubeのshort動画・配信内での使用\nXやHP等SNSでの使用（サムネイル等含む）\n\n【納品形式】\n・資料にあるキービジュアルの衣装をお願いいたします。\n※くまの手袋が入っていると嬉しいです\n・背景とキャラクターが分かれたpsdか透過されたpngで頂きたいです。\n・頭が切れていないと嬉しいです。\n・構図や表情はお任せいたします！\n\n【ocについて】\n・クリーム色のふわふわロングに水色のメッシュ\n・エメラルドグリーンの瞳\n・シロクマモチーフ(帽子や手袋)\n・ふわふわおっとりな感じ\n\nお好きなように描いていただけたらと思います！\n\nhttps://drive.google.com/drive/folders/1Tu1xFKD2gHetEZzjgC1S_W_ozDxQSIhe", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_pachida_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3871214, "client_id": 3930321, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/874a686e/uploads/origins/d114ac72-6e02-428a-9706-2b198b10f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4a941392b1bd58be5128bc3a8ec8926", "srcset": "https://si.imgix.net/874a686e/uploads/origins/d114ac72-6e02-428a-9706-2b198b10f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4a941392b1bd58be5128bc3a8ec8926, https://si.imgix.net/874a686e/uploads/origins/d114ac72-6e02-428a-9706-2b198b10f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43cc6f67bf2f6aa083b75bd9c926b079 2x, https://si.imgix.net/874a686e/uploads/origins/d114ac72-6e02-428a-9706-2b198b10f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c4a774fbed6241b5b0d9cef203555d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/874a686e/uploads/origins/d114ac72-6e02-428a-9706-2b198b10f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45347dde2b9cb6917e60cc2905fd9c3d", "srcset": "https://si.imgix.net/874a686e/uploads/origins/d114ac72-6e02-428a-9706-2b198b10f15f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45347dde2b9cb6917e60cc2905fd9c3d, https://si.imgix.net/874a686e/upload