/uploads/origins/4287201d-4041-4e8c-af6e-b0c0cc9d4d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2fc8768905ec7109559168a36724560 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af867079/uploads/origins/4287201d-4041-4e8c-af6e-b0c0cc9d4d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4c1040db2fb4a7d9ec0000e89be2f3", "srcset": "https://si.imgix.net/af867079/uploads/origins/4287201d-4041-4e8c-af6e-b0c0cc9d4d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4c1040db2fb4a7d9ec0000e89be2f3, https://si.imgix.net/af867079/uploads/origins/4287201d-4041-4e8c-af6e-b0c0cc9d4d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc79de539610eaf46aead68ab1b7dce7 2x, https://si.imgix.net/af867079/uploads/origins/4287201d-4041-4e8c-af6e-b0c0cc9d4d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be9c782aba54469677e345ad40c316ea 3x"}, "body": "こんにちは！妖怪ウォッチのアンキーン/破怪と私のキャラクターを描いていただけませんか？https://toyhou.se/31284835.renaarr。\n\n私のOCは小さい海賊の男です...。彼は少し動揺しています。ウンキーンとは友達なんだけど、ウンキーンを超イケメンと思っていて、彼のデカさと強さに夢中になっている...。\nウンキーンは気づいてないし、気にしてないんだろうな。\n\n何がいいのかよくわからないけど、アンキーンの肩の上に座るとか、犬や猫のように抱っこされるとか！あるいは、食べ物を分け合うとか...。仲良くスパーリングとか？どんなアイデアでも構いません！\n\n他は何でもOKです^_^ ご検討よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogizi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3213222, "client_id": 3582558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5e89510/uploads/origins/8d08d775-1d12-4cdb-bb0f-79016d4fdd01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c20cafd983d3d85f72cd6a18c6b3bbc", "srcset": "https://si.imgix.net/b5e89510/uploads/origins/8d08d775-1d12-4cdb-bb0