f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a36c5781e50b552bdeab1893fe39f9de, https://si.imgix.net/90efda20/uploads/origins/38a85606-1e33-4ceb-8f96-b2895b53ccbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4bcc5ec1f8616c0172251eb8bd8b681 2x, https://si.imgix.net/90efda20/uploads/origins/38a85606-1e33-4ceb-8f96-b2895b53ccbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3db7537a5a024befe4ccc774283db99d 3x"}, "body": "\u4eca\u5ea6\u53c2\u52a0\u3059\u308bCoC TRPG\u30bb\u30c3\u30b7\u30e7\u30f3\u306e\u30d7\u30ec\u30a4\u30e4\u30fc\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u63cf\u3044\u3066\u307b\u3057\u3044\u3068\u8003\u3048\u3066\u3044\u307e\u3059\u3002\n\u305d\u306e\u305f\u3081\u3001\u672c\u4f9d\u983c\u306e\u6210\u679c\u7269\u304cCoC TRPG\u30bb\u30c3\u30b7\u30e7\u30f3\u306b\u3066\u4f7f\u7528\u3055\u308c\u308b\u3053\u3068\u3001\u304b\u3064\u5834\u5408\u306b\u5fdc\u3058\u3066SNS\u306b\u540c\u6210\u679c\u7269\u304c\u30af\u30ea\u30a8\u30a4\u30bf\u30fc\u69d8\u306e\u660e\u8a18\u304b\u3064\u8ee2\u7528\u5bfe\u7b56\u52a0\u5de5(\u753b\u50cf\u753b\u8cea\u3092\u843d\u3068\u3059\u3001\u307e\u305f\u306f\u30af\u30ea\u30a8\u30a4\u30bf\u30fc\u69d8\u9298\u900f\u304b\u3057)\u306e\u3046\u3048\u753b\u50cf\u6295\u7a3f\u3055\u308c\u308b\u3053\u3068\u3092\u4e86\u627f\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u3057\u3066\u306e\u30b9\u30c6\u30fc\u30bf\u30b9/\u7279\u5fb4\u306f\u4ee5\u4e0b\u306e\u901a\u308a\u3067\u3059\u3002\n---\n\u5e74\u9f62: 7\u6b73(\u5c0f\u5b661\u5e74\u751f)\n\u6027\u5225: \u7537\u6027\n\u80cc\u683c\u597d: 135-140cm/28-30kg\n\u9aea\u306e\u8272: \u7d3a\u8272\u7cfb\u306e\u9ed2\u9aea\n\u9aea\u578b: \u9577\u9aea\u3001\u8033\u6a2a\u5243\u308a\u3053\u307f\u306e\u30c4\u30fc\u30d6\u30ed\u30c3\u30af\u306e\u3088\u3046\u306a\u5f62\u3092\u8003\u3048\u3066\u3044\u307e\u3059\u304c\u3001\u5de6\u8a18\u3092\u30d9\u30fc\u30b9\u306b\u304a\u4efb\u305b\u3057\u305f\u3044\u3067\u3059\n\u77b3\u306e\u8272: \u9280\u9752\n\u76ee\u306e\u5f62: \u5207\u308c\u9577\u306e\u91e3\u308a\u76ee\u3001\u7d30\u3081\n\u808c\u306e\u8272: \u8272\u767d\u306e\u808c\u8272\n\u670d\u88c5: \u30b7\u30e3\u30c4/\u30d9\u30b9\u30c8/\u30b9\u30e9\u30c3\u30af\u30b9/\u9769\u9774/\u30cd\u30af\u30bf\u30a4(\u30ea\u30dc\u30f3\u304b\u30bf\u30a4\u304b\u306f\u304a\u4efb\u305b\u3057\u307e\u3059), \u30af\u30ed\u7cfb\u3092\u57fa\u8abf\u306b\u30d9\u30b9\u30c8\u3092\u30b7\u30ed\u7cfb\u306b\u3059\u308b\u306a\u3069\u3001\u30af\u30ea\u30a8\u30a4\u30bf\u30fc\u69d8\u90fd\u5408\u3067\u30a2\u30af\u30bb\u30f3\u30c8\u3092\u52a0\u3048\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u5e78\u3044\u3067\u3059\n\n\u307e\u305f\u3001\u4ee5\u4e0b\u306e\u901a\u308a\u8868\u60c5\u5dee\u5206/1\u7a2e\u30a2\u30af\u30bb\u30b5\u30ea\u4ed8\u4e0e\u306e\u5dee\u5206\u304c\u3042\u308c\u3070\u5e78\u3044\u3067\u3059\u3002\u5fc5\u9808\u306e\u9806\u304b\u3089\u4ed8\u8a18\u3057\u307e\u3059\u306e\u3067\u3001\u4f9d\u983c\u91d1\u984d\u3067\u53ef\u80fd\u306a\u7bc4\u56f2\u307e\u3067\u306e\u5b9f\u88c5\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n---\n[\u5fc5\u9808\u8868\u60c5]\n- \u901a\u5e38\n- \u30c9\u30e4\u9854\n- \u559c\u3073\n- \u9a5a\u304d\n- \u4e0d\u5b89\n- \u7126\u308a\n- \u82e6\u75db/\u82e6\u60b6\n\n[\u30af\u30ea\u30a8\u30a4\u30bf\u30fc\u69d8\u306b\u3088\u308a\u5c1a\u53ef]\n- \u305d\u306e\u4ed6\u4efb\u610f\u306e\u4f5c\u3063\u3066\u3044\u305f\u3060\u3051\u308b\u8868\u60c5\n\n[\u30af\u30ea\u30a8\u30a4\u30bf\u30fc\u69d8\u306b\u3088\u308a\u4f9d\u983c\u3067\u304d\u308b\u3088\u3046\u3067\u3042\u308c\u3070\u4ed6\u5b9f\u88c5]\n- \u30f4\u30a1\u30a4\u30aa\u30ea\u30f3\u3092\u5f3e\u3044\u3066\u3044\u308b(\u6301\u3064)\u5225\u5dee\u5206\n    - \u624b\u3084\u8155\u3001\u5834\u5408\u306b\u3088\u3063\u3066\u306f\u80f4\u306e\u52d5\u304d\u307e\u3067\u5225\u306b\u306a\u308b\u3068\u601d\u3046\u306e\u3067\u4e0d\u53ef\u3067\u3042\u308c\u3070\u5225\u4f9d\u983c\u3068\u3057\u3066\u6539\u3081\u306