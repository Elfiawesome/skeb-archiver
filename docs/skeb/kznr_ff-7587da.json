4b-0e50-4902-b831-f8ad8d5be215?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2aa4e9358a156ad877bfb8fda8c40ab6 2x, https://si.imgix.net/eefa63d0/uploads/origins/4af8654b-0e50-4902-b831-f8ad8d5be215?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f78048d29db96c84dc1411ad9597de6 3x"}, "body": "Hiharu Hara is a big sister otokonoko (\u7537\u306e\u5a18). He is an ex-wife to a yakuza. His parents are very rich, and forced him to marry a yakuza for political and financial reasons. He agreed because he was always disappointing his parents when he did not grow up as a proper man. The yakuza husband found out he was a man and they started to fight. Hiharu tried to kill his yakuza husband and is now on the run from the yakuza organization and his family. \n\nHe is in hiding,  sneaky, but also very sexy and cool. Smokes, and wears skimpy clothes, and is silly and funny. The yakuza is after him but he still lives very carefree and unbothered.\n\nPlease draw Hiharu laying down in the back seat of a car, asleep. He is tied up by the yakuza but is sleeping shamelessly without a care in the world. He is even drooling. Please make it very sexy, cool and a little funny!\n\nPlease choose me, I love your art style and I think it suits Hiharu. I like the BL style more than shoujo. \n\nThank you! \u2661\n\nhttps://drive.google.com/drive/folders/1rOYlbQigFTXFinl9Z6JO4Wfg_Wbtfaqn?usp=sharing", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kznr_ff/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1679682, "client_id": 1316301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/750baf95/uploads/origins/134fdb1a-816f-4e8c-a4a7-aa936008d9e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfc76e357b394c5cedb6967daaa0de1e", "srcset": "https://si.imgix.net/