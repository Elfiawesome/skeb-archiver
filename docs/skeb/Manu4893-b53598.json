6c\uc131] https://www.pixiv.net/ko/artworks/118075709 \uc640 \ube44\uc2b7\ud55c \uc2a4\ud0c0\uc77c\ub85c \uadf8\ub824\uc8fc\uc2dc\uba74 \uc88b\uaca0\uc2b5\ub2c8\ub2e4. \ud070 \ubaa8\uc790 \ub300\uc2e0 \uc120\ubc14\uc774\uc800\ub97c \uc368\uc92c\uc73c\uba74 \uc88b\uaca0\uc5b4\uc694! \uc218\uc601\ubcf5\uc774\ub77c\uae30\ubcf4\ub2e4\ub294 \ubab8\uc5d0\uc11c \ub540\uc774 \ub69d\ub69d \ub5a8\uc5b4\uc9c0\ub294 \uccb4\uc721\ubcf5 \uac19\uc558\uc73c\uba74 \uc88b\uaca0\uc5b4\uc694. \ub098\ub294 \uadf8\ub140\uac00 \ud0c4\ud0c4\ud55c \ubcf5\ubd80\ub97c \uac16\uae30\ub97c \ubc14\ub78d\ub2c8\ub2e4. \ud3ec\uc988\uc640 \ubc30\uacbd\uc740 \uc5ec\ub7ec\ubd84\uaed8 \ub9e1\uae30\uaca0\uc2b5\ub2c8\ub2e4! [\uc0ac\uc6a9\ubc95] SNS\uc5d0 \uac8c\uc2dc\ud558\uace0 \uc720\ud29c\ube0c/\ud2b8\uc704\uce58 \uc378\ub124\uc77c\ub85c \uc0ac\uc6a9\ud558\uaca0\uc2b5\ub2c8\ub2e4. [\ubc30\uc1a1] \uac00\ub2a5\ud558\uba74 \ubc30\uacbd \ub808\uc774\uc5b4\uc640 \uce90\ub9ad\ud130 \ub808\uc774\uc5b4\ub97c \ubd84\ub9ac\ud574 \uc8fc\uc138\uc694. \uac10\uc0ac\ud569\ub2c8\ub2e4. \ub0b4 \uc694\uccad\uc744 \uc77d\uc5b4\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4!\n\nhttps://drive.google.com/drive/folders/1sF0trogAIJ3raXb6v47W5dJBeMy6kvH8", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Manu4893/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 783997, "client_id": 940726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d55ee18/uploads/origins/e0bb6781-11fb-4053-a98d-a0441e296f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63f46f4b4023332d5b9d8bf4d21aaeca", "srcset": "https://si.imgix.net/3d55ee18/uploads/origins/e0bb6781-11fb-4053-a98d-a0441e296f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63f46f4b4023332d5b9d8bf4d21aaeca, https://si.imgix.net/3d55ee18/uploads/origins/e0bb6781-11fb-4053-a98d-a0441e296f9d?bg=