: {"src": "https://si.imgix.net/20eb8feb/uploads/origins/60f78c5f-ef17-4ccb-99b1-c15f68bfd1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c36e970048015cd77d43ba7b5fd42ade", "srcset": "https://si.imgix.net/20eb8feb/uploads/origins/60f78c5f-ef17-4ccb-99b1-c15f68bfd1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c36e970048015cd77d43ba7b5fd42ade, https://si.imgix.net/20eb8feb/uploads/origins/60f78c5f-ef17-4ccb-99b1-c15f68bfd1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85ce9761d03ef6aea1f413cb77001d23 2x, https://si.imgix.net/20eb8feb/uploads/origins/60f78c5f-ef17-4ccb-99b1-c15f68bfd1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d06768cb837d3cd458070caed2298da2 3x"}, "body": "\uc548\ub155\ud558\uc138\uc694 Maanu, \ub9cc\ub098\uc11c \ubc18\uac11\uc2b5\ub2c8\ub2e4! \ub2f9\uc2e0\uc758 \uc544\ud2b8 \uc2a4\ud0c0\uc77c\uc774 \ub9e4\uc6b0 \uc544\ub984\ub2f5\ub2e4\uace0 \uc0dd\uac01\ud574\uc11c \uc77c\ub7ec\uc2a4\ud2b8\ub97c \uc758\ub8b0\ud558\uace0 \uc2f6\uc2b5\ub2c8\ub2e4! Date A Live\uc758 \ucfe0\ub8e8\ubbf8 \ud1a0\ud0a4\uc0ac\ud0a4\uac00 \uc591\uce58\uc9c8\uc744 \ud558\ub294 \uc77c\ub7ec\uc2a4\ud2b8\ub97c \uc6d0\ud569\ub2c8\ub2e4. \uadf8\ub140\ub294 \uc695\uc2e4\uc5d0\uc11c \uc591\uce58\uc9c8\uc744 \ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ubc29\uae08 \uae68\uc5b4\ub098\uc11c \uc878\ub9b0 \ud45c\uc815\uc744 \ud558\uace0 \uc788\uace0 \uba38\ub9ac\uac00 \uc57d\uac04 \uc9c0\uc800\ubd84\ud569\ub2c8\ub2e4. \uadf8\ub140\ub294 \ud770\uc0c9 \uc154\uce20\uc640 \ubc18\ubc14\uc9c0\ub97c \uc785\uace0 \uc788\uc2b5\ub2c8\ub2e4. \ub208\uc744 \uac10\uac70\ub098 \ub728\uac8c \ud560\uc9c0 \uc120\ud0dd\ud558\uac8c \ud558\uaca0\uc2b5\ub2c8\ub2e4. \ub208\uc744 \ub728\uace0 \uc788\ub2e4\uba74 \ucc38\uace0 \uc790\ub8cc\uc5d0 \ub098\uc640 \uc788\ub294 \uac83\ucc98\ub7fc \ub450 \ub208\uc744 \ubaa8\ub450 \ube68\uac04\uc0c9\uc73c\ub85c \ub9cc\ub4e4\uc5b4 \uc8fc\uc138\uc694. \uc774 \uc694\uccad\uc744 \uace0\ub824\ud574 \uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4!\n\nhttps://drive.google.com/drive/folders/14CSzhAZRCM_3_RyioSwB56FSQ5MveAON?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Manu4893/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 783997, "client_id": 2588067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00911de2f4a3680fac8a33abfb7be97e", "srcset": "https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00911de2f4a3680fac8a33abfb7be97e, https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bda77011c68fe182fc5fcab26d6fe30 2x, https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c150801c1baa6b28e7e42501adeb0e6f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a336e5203c667eb980af2aa16560d654", "srcset": "https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a336e5203c667eb980af2aa16560d654, https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d069c56dd78197f7c6db57b9496378a 2x, https://si.imgix.net/6ce27b26/uploads/origins/baf74bf3-d1a2-411a-9877-d1ae21f49002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aee59e61703ca028536b17fc5137079a 3x"}, "body": "\uc548\ub155\ud558\uc138\uc694. \uc800\ub294 \ub2f9\uc2e0\uc758 \uadf8\ub9bc \uc2a4\ud0c0\uc77c\uacfc \uc545\ub9c8\ub97c \uc798 \uadf8\ub9ac\ub294 \uac83\uc744 \uc88b\uc544\ud569\ub2c8\ub2e4! \uc81c \uce5c\uad6c\uc758 \uce90\ub9ad\ud130\ub97c \uadf8\ub824\uc8fc\uc2dc\uaca0\uc5b4\uc694? \uadf8\ub140\ub294 \ud76c\uc0dd\uc790\ub97c \ud6a8\uacfc\uc801\uc73c\ub85c \uc720\ud639\ud558\uae30 \uc704\ud574 \uc790\uc2e0\uc758 \ubaa8\uc2b5\uc744 \ubc14\uafb8\ub294 \uc11d\ud050\ubc84\uc2a4\uc785\ub2c8\ub2e4. \uadf8\ub140\uac00 \uc9c1\uc7a5\uc778 \ubcf5\uc7a5\uc744 \ud558\uace0, \uc5bc\uad74\uc5d0 \uad50\ub9cc\ud558\uace0 \uc545\ub9c8 \uac19\uc740 \ud45c\uc815\uc744 \uc9c0\uc73c\uba70 \uc2dc\uccad\uc790\ub97c \ub0b4\ub824\ub2e4\ubcf4\ub294 \ubaa8\uc2b5\uc744 \ubcf4\uace0 \uc2f6\uc2b5\ub2c8\ub2e4. URL\uc5d0\ub294 \uce90\ub9ad\ud130, \uc758\uc0c1, \uc6d0\ud558\ub294 \ud3ec\uc988\uc5d0 \ub300\ud55c \ucc38\uc870\uac00 \uc788\uc2b5\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \ucc3d\uc758\ub825\uc744 \ubc1c\ud718\ud558\uace0 \ub354 \ub098\uc740 \ud3ec\uc988\uac00 \uc0dd\uac01\ub09c\ub2e4\uba74 \ub2e4\ub978 \ud3ec\uc988\ub97c \uc120\ud0dd\ud574\ub3c4 \uc88b\uc2b5\ub2c8\ub2e4. \ud5e4\uc5b4\uc2a4\ud0c0\uc77c\uacfc \ub098\uba38\uc9c0 \uc138\ubd80 \uc0ac\ud56d\uc740 \uadc0\ud558\uac00 \uc120\ud0dd\ud574\uc57c \ud569\ub2c8\ub2e4! \uc644\uc804\ud788 \ub80c\ub354\ub9c1\ub41c \ucc38\uc870 \uc774\ubbf8\uc9c0\uac00 \ubd88\uc644\uc804\ud574\uc11c \uc8c4\uc1a1\ud569\ub2c8\ub2e4. \uc81c \uc694\uccad\uc744 \uace0\ub824\ud574\uc8fc\uc154\uc11c \uac10\uc0ac\ud569\ub2c8\ub2e4!\n\nhttps://drive.google.com/drive/folders/15ZA7RDjtUVpyVBix8EeWXu2vUz81b88v", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Manu4893/wor