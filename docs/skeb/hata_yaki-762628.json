\nユニ　アムドゥス　26歳/175㎝\n温厚で常に笑顔を絶やさない男性。\n女性には優しく、男性は基本どうでもいい典型的なイタリア男。\n数年前にとあるカルト宗教からアンジェリカを誘拐し、2人で逃げている。\n自身よりアンジェリカを優先しがち。\n彼女の言うことなら基本なんでも聞いてあげたいし、叶えてあげたいと思っている。\n自分の幸せの中心に彼女がいると言っても過言では無い。\n彼女となら添い遂げてもいいと思っている。\nアンジェリカに対してたまにキザなセリフを言って赤面させている。\n\nhttps://drive.google.com/drive/folders/1mm-FnM7oEexdX-hJq7KQqlqnVrO-196Y", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hata_yaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2589840, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c19377d/uploads/origins/e33e6fd1-02a3-4e9b-970a-109ce48d5461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f4193756522e8391fad24e090455868", "srcset": "https://si.imgix.net/1c19377d/uploads/origins/e33e6fd1-02a3-4e9b-970a-109ce48d5461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f4193756522e8391fad24e090455868, https://si.imgix.net/1c19377d/uploads/origins/e33e6fd1-02a3-4e9b-970a-109ce48d5461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=261aef56a36fdd231b04e2ce1d820703 2x, https://si.imgix.net/1c19377d/uploads/origins/e33e6fd1-02a3-4e9b-970a-109ce48d5461?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12725a639fe9813a0d042a8638914001 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c19377d/uploads/origins/e33e6fd1-02a3-4e9b-970a-109ce48d5461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61a26751f04f460fcc2c01f6a88ed699", "srcset": "https://si.imgix.net/1c19377d/uploads/origins/e33e6fd1-02a3-4e9b-970a-109ce48d5461?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61a26751f04f460fcc2c01f6a88ed699, https://si.imgix.net/1c19377d/uploads/origins/e33e6fd1-02a3-4e9b-970a-109ce48d5461?bg=%23fff&au