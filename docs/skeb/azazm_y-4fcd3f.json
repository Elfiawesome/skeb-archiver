いる感じです！\n私は中島の事をパパ…と思っちゃっているんですが、中島の父性…？をぜひ感じたいな…と思っております…！\n\n長々と欲望垂れ流しのリクエスト失礼しました…！\nこれからもあんどうさんの創作活動を応援しております！\n\nhttps://www.dropbox.com/sh/xb3vp0ru46kcpgh/AACyipPZD4WBSNrXTImPejB4a?dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OKAMOCHI_/works/76", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 322789, "client_id": 722565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67ad9667/uploads/origins/9df2f57a-49fd-4f56-ab7c-2c8f996419fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28c058d4bbbe6aded517b4b32a49a606", "srcset": "https://si.imgix.net/67ad9667/uploads/origins/9df2f57a-49fd-4f56-ab7c-2c8f996419fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28c058d4bbbe6aded517b4b32a49a606, https://si.imgix.net/67ad9667/uploads/origins/9df2f57a-49fd-4f56-ab7c-2c8f996419fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10dface450e3d7734c6db06d8466432d 2x, https://si.imgix.net/67ad9667/uploads/origins/9df2f57a-49fd-4f56-ab7c-2c8f996419fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4134ea3a4402fa02a7846092f92178a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67ad9667/uploads/origins/9df2f57a-49fd-4f56-ab7c-2c8f996419fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdf9094ad6c665f2950d26590ef6b31b", "srcset": "https://si.imgix.net/67ad9667/uploads/origins/9df2f57a-49fd-4f56-ab7c-2c8f996419fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdf9094ad6c665f2950d26590ef6b31b, https://si.imgix.net/67ad9667/uploads/origins/9df2f57a-49fd-4f56-ab7c-2c8f996419fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bb280377ccbea501b9042791d72c93c 2