pr=3&fit=crop&crop=top&w=200&h=200&s=06b7aab0ef1b712e3af4979ae5de6b3b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/544c0fe3/uploads/origins/9e74514f-d887-4d71-a658-df775822896c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=246f057cd4762fe475a9ad216266a7f3", "srcset": "https://si.imgix.net/544c0fe3/uploads/origins/9e74514f-d887-4d71-a658-df775822896c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=246f057cd4762fe475a9ad216266a7f3, https://si.imgix.net/544c0fe3/uploads/origins/9e74514f-d887-4d71-a658-df775822896c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3c1e75359924fbe6c74924e0dc5376e 2x, https://si.imgix.net/544c0fe3/uploads/origins/9e74514f-d887-4d71-a658-df775822896c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbf21ceacc96d86b55a9861e4cb96f8 3x"}, "body": "あんどうさんこんにちは！\n\nもしよろしければ、サイレンHO4と山海経工業の絡みを再び見たいと思いリクエストお願いしに来ました！\n\n他のシナリオで出るのかも…！とは思いつつ、鮫島と中島が推しでっ…………宜しければサイレン清掃で可能な部分だけでも絡みが見たいです！\n\nほのぼのひよこクラブなのか、ビシバシブラックなのか、特にお互いに過干渉は無いのか、どんな山海経工業でも大好きなので、あんどうさんがお好きに山海経工業の皆さんを描いていただけたらとても嬉しいです！うちのHO4はおまけ程度で添えるだけでもいいので…！\n\nあんどうさんのシナリオを沢山通らせていただき、毎回素敵な感情で帰ってきています！来月には「999」も通過させていただきます！楽しみです！\n\n気温もだいぶ下がり、本格的に冬の気候になって来ましたが、無理せずお体をお大事にしてお過ごしください！\n\nhttps://www.dropbox.com/sh/xb3vp0ru46kcpgh/AACyipPZD4WBSNrXTImPejB4a?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamagoDX1414/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 583942, "client_id": 722565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0287531a1cb1af5070800d3ec46b727a", "srcset": "https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0287531a1cb1af5070800d3ec46b727a, https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09a09bc5120f8765c03b1b3bb0d30e1d 2x, https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1176103c5fa1582bd70540c19539cc8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92f66103a2b53704fd7105d9d781279a", "srcset": "https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92f66103a2b53704fd7105d9d781279a, https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f6b0fc8db36271f07ea051707cfc121 2x, https://si.imgix.net/e328ca83/uploads/origins/71935c2a-4585-497c-a9d0-0c2c6da4a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55560ac2fa75b41ba65cc871aa8ccba1 3x"}, "body": "あんどうさんこんにちは！\n先日ムーンギフテッドを通過させていただきました！\n大きな物語の中で、とても美しい景色を見ることができました！ムーンギフテッド、偶造神環という物語を作って下さり本当に感謝しています！\n\nそこでかなりムーンギフテッドという世界に狂ってしまい、今回は自PCとNPCのイラストを描いていただきたいと思い、リクエストに参りました…！\n描いて欲しいのは、自PCのムンギフHO4と、武藤玉望、そして音桐良夜です！\n2人ともとても家族思いで、シナリオを読んだ際の2人の行動理念や感情につい泣いてしまいました…！2人とも大切な兄弟となりました…！\n私たちのセッションでは母も玉望も生存しており、生き残ったPC、NPC全員で大きなお家で暮らそうというお話をしています！\n\n自PCは、現在プロボクサーとして活躍している190cmの女です！\nガサツで傲慢ですが、頑張っている人が好きで皆と沢山ワイワイしているタイプです！\nシナリオ中は玉望のマイペース具合に翻弄されていましたが、節々でHO4を心配してくれる玉望が大好きです！\n描いていただきたいシーンなど沢山あるのですが、いくつか候補をあげる中であんどうさんの描きやすいものを描いていただければ幸いです。\n\n描いていただきたいもの\n・停電の時に玉望がHO4を多々良池に迎えに来てくれるシーン\n・良夜のデザインした服を着ているところ(良夜の目が開眼されていると嬉しいです…！)\n・3人で並んでいるところ\n・自PCが神話生物として覚醒した姿(デザインなど全てお任せになってしまうのですが、もし可能であればで大丈夫です…！)\n\n以上になります！\nあくまで参考程度のものなので、あんどうさんが描きやすいものを描いていただければ幸いです…！\n\n\nサイレン、アイラス、ムンギフを通って、このシナリオをとってもとっても楽しみ尽くさせていただきました！銀蝋もとてもとても楽しみです！\n現時点での推しは吉田新と西本リンとRです、もし今後Rが出てくるシナリオがあれば、泣いて喜んでしまう命がここにあります…！\n\n沢山わがままを言ってしまいましたが、無理をせず、これからもあんどうさんが素敵な創作活ができることをお祈りしております！\nどうぞよろしくお願いします！🙇‍♂️\n\nhttps://www.dropbox.com/sh/6p8xkci3uinp5s3/AACJ3JIYu-qsBtqbfVtG-TzXa?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4kumauo/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 349483, "client_id": 722565, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4b0edee/uploads/origins/e4032e66-86f3-404c-8199-57247f679832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4611384e6326874ea29be7949df60706", "srcset": "https://si.imgix.net/a4b0edee/uploads/origins/e4032e66-86f3-404c-8199-57247f679832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4611384e6326874ea29be7949df60706, https://si.imgix.net/a4b0edee/uploads/origins/e4032e66-86f3-404c-8199-57247f679832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ae79a198afba8b8287f93ace136854b 2x, https://si.imgix.net/a4b0edee/uploads/origins/e4032e66-86f3-404c-8199-57247f679832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7e373007a61119a884008a66537cb82 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4b0edee/uploads/origins/e4032e66-86f3-404c-8199-57247f679832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b60230d290a8898381e17f0b6077d5b", "srcset": "https://si.imgix.net/a4b0edee/uploads/ori