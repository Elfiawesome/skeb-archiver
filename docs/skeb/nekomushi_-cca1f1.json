aa-078723bc403e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb5dea743bdbfe2bc06be5957698435, https://si.imgix.net/e4a7b53d/uploads/origins/f48766a2-7b39-4072-9caa-078723bc403e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9dac58210754a20f840e0a71bdd5c9b3 2x, https://si.imgix.net/e4a7b53d/uploads/origins/f48766a2-7b39-4072-9caa-078723bc403e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d08df918fbf2c02f4e59227cf4821ea 3x"}, "body": "ネコムシさん、こんにちは。またお願いがあるんですが、ぜひ検討していただけると嬉しいです！今回お願いしたいのは、『ストライク・ザ・ブラッド』の姫萩雪菜です。https://www.pixiv.net/en/artworks/126384640 https://www.pixiv.net/en/artworks/94504860\n\n以下の参考画像のように縛ってほしいです。 https://skeb.jp/@hamuta086/works/66 https://skeb.jp/@hamuta086/works/86 彼女はピンクの下着姿で、制服を着たまま縛られています。ベッドに横たわり、こちらを見つめています。涙を浮かべながら顔を赤らめ、睨みつけてくるような表情をしています。 \n\nシャツは一部開いており、ブラジャーが見えています。胸と胴体は縛られています。股間のロープがパンティを通ってスカートを持ち上げています。パンティは濡れています。脚にはロープが巻かれていますが、結ばれてはいません。脚にはロープの跡が見えます。下の参考画像のように、彼女の上にコジョウが乗っているため、コジョウの腕が見えます。\n\nhttps://www.pixiv.net/en/artworks/48183139 ギャグなし、OTNギャグ、ボールギャグのバリエーションを希望します。納品はPSDファイルで結構です。ご依頼をご検討いただきありがとうございます！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekomushi_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 643364, "client_id": 45058, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d9ddea14c201f93f5a158f9f982ab9", "srcset": "https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d9ddea14c201f93f5a158f9f982ab9, https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64e41adac3ac9487ac8249efbcf3d794 2x, https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01ea6c55aca686a21c3271018f3054e4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=405698d258cb61f4e1243115d6f19aba", "srcset": "https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=405698d258cb61f4e1243115d6f19aba, https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9eb1ecb8e8773740d80493f0d0e01550 2x, https://si.imgix.net/53c513b0/uploads/origins/fc80611d-3dc3-449e-b6bd-a802b82dacc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de86da2caab94a39efcefb8ad1809005 3x"}, "body": "一部訂正・再送します。申し訳ありません。\n\nアイドルマスターシンデレラガールズから、新田美波（「ノーブルヴィーナス」の競泳水着）がプールサイドで緊縛されている絵をお願いします。\n縛り方は、上半身はURLの絵のような縄を使った後ろ手縛りにしてください。水着は腰の辺りまで下ろし、両胸の乳首にローターをテープで貼り付けてください。\n下半身はM字開脚で縛り、秘部にバイブを挿入して水着の股の部分を引っかけてください（これもURLの絵のイメージとなります）。股を閉じられないように、ピンと張る縄を背中の後ろに通して両脚を繋げる、脚を縛る縄と上半身を縛る縄を別の縄で結び付ける等してください。秘部から大量の愛液もしくは潮が溢れ出ている様子もお願いします。\n顔を赤くし、助けを求めるような表情で涙を流しながらこちらを見ている様子にしてください。\n口には赤いボールギャグを噛ませて、涎が顎を伝って糸を引くように顎から下に垂れている様子もお願いします。\n差分として、両目を瞑って悶えているもの、黒い布で目隠しをされているもの、録画している様子を表す「●REC」の表示と四隅の白い枠もお願いしたいです。\nPSDのようなので、それらはレイヤーでオン・オフもしくは切り替えられる状態にしていただけたらと思います。\n\n以上、よろしければ、お願いいたします。\n\nhttps://skeb.jp/@gn_nanon/works/77", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekomushi_/works/9", "private_thumbnail_image_urls": {"src": "https