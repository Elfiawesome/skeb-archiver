si.imgix.net/4441adee/uploads/origins/7d64cc1b-3f80-486f-9c50-8aa1e4f6ebc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71b6d71442a9bc9179cabf8f2c56d7e2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4441adee/uploads/origins/7d64cc1b-3f80-486f-9c50-8aa1e4f6ebc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2af2ebf5a9bfbf41d8b6842348ce9d96", "srcset": "https://si.imgix.net/4441adee/uploads/origins/7d64cc1b-3f80-486f-9c50-8aa1e4f6ebc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2af2ebf5a9bfbf41d8b6842348ce9d96, https://si.imgix.net/4441adee/uploads/origins/7d64cc1b-3f80-486f-9c50-8aa1e4f6ebc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b9fd1ffb9e7f86837831b49a8753a39 2x, https://si.imgix.net/4441adee/uploads/origins/7d64cc1b-3f80-486f-9c50-8aa1e4f6ebc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=104a87ae18f2bc5b9b52316d8d17c0df 3x"}, "body": "Hi!❤️\n\nI’m reaching out because I loved the illustration you created for me last time and was hoping to get another illustration ^^\n\nI’d like to request art of my friend’s original character. \nHer personality is sweet, kind, soft, very loving, loves flowers and nature\n\nPlease draw her as you like. Pose and expression are up to you and if the reference is not enough, you can change her outfit.\n\nhttps://imgur.com/a/xnRtN7I", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanata87ha/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2093776, "client_id": 2337667, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ecffad10/uploads/origins/64dc626d-dc1e-485f-b293-303fc333cb73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c