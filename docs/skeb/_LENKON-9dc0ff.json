2\u304d\u307e\u3057\u305f\u3002\n\n\ud83d\udc15\u4f7f\u7528\u7528\u9014\uff1a\u500b\u4eba\u7684\u306a\u89b3\u8cde\u7528(\u89aaKP\u3001\u540c\u5353PL\u306b\u898b\u305b\u305f\u308a\u3082\u3057\u305f\u3044\u3067\u3059)\n\n\ud83d\udc15\u69cb\u56f3\u306a\u3069\uff1a\u8ddd\u96e2\u306e\u8fd1\u3044\u611f\u3058\u3067\u304a\u9858\u3044\u3057\u307e\u3059\u3002\u4ee5\u4e0b\u306f\u4f8b\u3067\u3059\u304c\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\n\u4f8b)\u8eab\u9577\u306e\u4f4e\u3044HO1\u304c\u6301\u3063\u3066\u308b\u66f8\u985e\u3092\u5f8c\u308d\u304b\u3089\u78ba\u8a8d\u3059\u308b\u6d12\u6383\u3001\u30bd\u30d5\u30a1\u3067\u96a3\u306b\u5ea7\u308b\u3001\u30bd\u30d5\u30a1\u306b\u5ea7\u3063\u3066\u308b\u6d12\u6383\u306e\u5f8c\u308d\u304b\u3089\u8eab\u3092\u4e57\u308a\u51fa\u3057\u3066\u8997\u304d\u8fbc\u3080HO1\u2026\u2026\n(\u4f59\u88d5\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u3001HO1\u3068\u6d12\u6383\u306eSD\u30a4\u30e9\u30b9\u30c8\u3082\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\ud83d\ude4f)\n\n\ud83d\udc15HO1\u306b\u3064\u3044\u3066\n\u30fb160cm/\u7537\u6027/\u5e74\u9f62\u4e0d\u8a73(25)\n\u30fb\u7656\u6bdb\u9280\u9aea/\u7247\u76ee\u96a0\u308c(\u6d12\u6383\u3068\u306f\u9006\u306e\u76ee\u304c\u96a0\u308c\u3066\u3044\u307e\u3059)/\u30ae\u30b6\u6b6f\n\u30fb\u77b3\u8272\uff1a\u660e\u308b\u3044\u9ec4\u8272/\u96a0\u308c\u3066\u3044\u308b\u65b9\u306f\u50b7\u3092\u8ca0\u3063\u3066\u304a\u308a\u96bb\u773c\n\u30fb\u72ac\u8033\u307f\u305f\u3044\u306b\u3074\u3087\u3053\u3093\u3068\u3057\u305f\u7656\u6bdb\u304c\u7279\u5fb4\u7684\n\u30fb\u4e00\u4eba\u79f0\u30ef\u30b7(\u6d12\u6383\u30682\u4eba\u304d\u308a\u3060\u3068\u300c\u304a\u308c\u300d)\n\u30fb\u304a\u558b\u308a\u5927\u597d\u304d\u306a\u95a2\u897f\u5f01\u53e4\u682a\u5e74\u9577\u8005(\uff1f)\n\u30fb\u6b74\u304c\u6b74\u306a\u306e\u3067\u81ea\u9663\u3001NPC\u5168\u54e1\u306e\u3053\u3068\u3092\u5bb6\u65cf\u306e\u3088\u3046\u306b\u601d\u3063\u3066\u308b\n\n\ud83d\udc15HO1\u304b\u3089\u898b\u305f\u6d12\u6383\u8b99\u306b\u3064\u3044\u3066\