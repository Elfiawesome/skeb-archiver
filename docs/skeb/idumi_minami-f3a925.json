": "art", "tipped": true, "creator_id": 2497597, "client_id": 3622507, "nc": 145}, {"path": "/@idumi_minami/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2497597, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71d9db6633cada7709acfe0c89d0ca53", "srcset": "https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71d9db6633cada7709acfe0c89d0ca53, https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac4fcb890f185945ebdc38444f681fa9 2x, https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15dfefd848f1154452e9e6db450232b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c23176d70c214b60bff2f6c7cab2ca10", "srcset": "https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c23176d70c214b60bff2f6c7cab2ca10, https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f39578343a7ce47e56039ed13b5931de 2x, https://si.imgix.net/ec619a1d/uploads/origins/f2906f9e-0396-45e1-8693-9c1fde80b69f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08a797441ad33c0e849edf5607883296 3x"}, "body": "こんにちは、いづみみなみさん。こっそりと昔からずっと応援させて頂いております。\nもしろよろしければFGOの「清少納言ちゃん」に「セミラミスの最終再臨の衣装をコスプレ」をさせたイラストをお願いできるでしょうか……！？\nこの度いづみさんが、ガイドライン的にOKな二次創作ならばskebを受け付けて頂けると聞き及びまして、FGOならばガイドライン的にOKなのでは？との淡い期待の上、ご依頼をさせて頂ければと存じます。\n（一応FGOの公式ガイドラインの方をば載せさせて頂きます。→ https://www.fate-go.jp/guidelines/）\n\n個人的にハマってしまった謎の組み合わせのため、ご理解に苦しむ組み合わせとは百も承知ですが、いづみみなみさんがFGOに相当精通していることや、表情の豊かさや感情表現が満載に描けるいづみさんだからこそ、あの元気いっぱいなぎこちゃんを描いて頂けましたらと思った次第です。\n\nコスプレがメインとなりますので、なるべくならで十分ですが、全身が拝める構図にて、衣装姿を堪能させて頂ければ特に嬉しく思います……！\nまた、清少納言ちゃんの髪は第一再臨のもの（青・赤・黒のマーブルのやつ）を希望いたしますが、もっとセンスを光らせる直感が下りてくださったのなら、その限りではなくてもOKです。\nそれ以外の表情や構図・ポーズなどについては、いづみみなみさんのセンスをそのまま光らせて頂ければOKです。\n\n衣装の細かいディティールにつきましては、フィギュアの写真にてご確認いただければと存じます。\nhttps://www.goodsmile.info/ja/product/10713/%E3%82%A2%E3%82%B5%E3%82%B7%E3%83%B3+%E3%82%BB%E3%83%9F%E3%83%A9%E3%83%9F%E3%82%B9.html\n\n色々と難しいことが絡んでいるは承知の上ですが、その上でも引き受けて頂き、ずっと応援しているいづみさんの絵で、元気っ子にゴージャスなセミ様ドレスを着せるという私好みのなぎこちゃんを描いて頂けるのでしたら、本当に嬉しく存じます。\n何卒よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/88419852", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@idumi_minami/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afcce85c/uploads/origins/fdd64d9c-a7b2-4fb1-bd78-d0e1da6b6d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95ed33f029e3096391112d2ffa778e9b", "srcset": "https://si.imgix.net/afcce85c/uploads/origins/fdd64d9c-a7b2-4fb1-bd78-d0e1da6b6d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95ed33f029e3096391112d2ffa778e9b, https://si.imgix.net/afcce85c/uploads/origins/fdd64d9c-a7b2-4fb1-bd78-d0e1da6b6d89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRI