o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c554a279b9235425290dc6808948bd", "srcset": "https://si.imgix.net/d27eda71/uploads/origins/8c2fb219-1d8a-4bbf-abbf-d217aa57e7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3c554a279b9235425290dc6808948bd, https://si.imgix.net/d27eda71/uploads/origins/8c2fb219-1d8a-4bbf-abbf-d217aa57e7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b1a722d3cb82ab38f7ff98aa61b90a6 2x, https://si.imgix.net/d27eda71/uploads/origins/8c2fb219-1d8a-4bbf-abbf-d217aa57e7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e798b7614ff73ebea47789a1734a502 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d27eda71/uploads/origins/8c2fb219-1d8a-4bbf-abbf-d217aa57e7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b88bf7deeb050fdaee4b820e009ef7f", "srcset": "https://si.imgix.net/d27eda71/uploads/origins/8c2fb219-1d8a-4bbf-abbf-d217aa57e7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b88bf7deeb050fdaee4b820e009ef7f, https://si.imgix.net/d27eda71/uploads/origins/8c2fb219-1d8a-4bbf-abbf-d217aa57e7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efe30a426a7e03d89c9d9e1ad4dc6ac1 2x, https://si.imgix.net/d27eda71/uploads/origins/8c2fb219-1d8a-4bbf-abbf-d217aa57e7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d175d25f6a7b666a1b5977735fb800e 3x"}, "body": "お世話になっております緋色です。\n今回は違う人物をモチーフに一枚描いて頂きたいです。\nゲームは７dtdという核戦争後と未知のゾンビウイルスにより世界人口の９割が死滅した世界で汚染を免れた某国の辺境で唯一生き延びる人類としてサバイバルな日々を過ごしますポストアポカリプスな世界観の作品です。\nゲームの主目的は７日毎に襲来してくるゾンビの大群に備えて民家や基地などを巡り物資を持ち帰り自分の拠点を強化して終末世界を一日でも長く生き残る事。映画で言うとウォーキングデッドや２８日後が近いでしょうかね。\n人物は今回は資料に入っているちょっとパンクなジャンパーを着て帽子をかぶってる女の子（なすさん、なこちゃん）描いて貰いたいです。\nXアカウントはこちら：https://x.com/nasty_nasu\n衣装はビキニ水着、もしくはインナーとしてビキニ水着を着こんでてショーパンや前開き状態のジャンパーを着てる状態でならどういうシーンでも良いです。\nSNSでの投稿とYouTubeなどでの利用を想定しています。なすちゃんがお借りするケースもあります。\n\nhttps://drive.google.com/drive/folders/12jmiTSS60W7EDUd4FxtNbXf-2f1k6EpM", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ro_tanu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 403063, "client_id": 757395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcaae367/uploads/origins/75476aef-1f7a-4ecd-9950-c4d0e47c6932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054821aee34a1ccf208053543a67a83d", "srcset": "https://si.imgix.net/fcaae367/uploads/origins/75476aef-1f7a-4ecd-9950-c4d0e47c6932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=054821aee34a1ccf208053543a67a83d, https://si.imgix.net/fcaae367/uploads/origins/75476aef-1f7a-4ecd-9950-c4d0e47c6932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2e4d763acacf022b91c50e0fda96c11 2x, https://si.imgix.net/fcaae367/uploads/origins/75476aef-1f7a-4ecd-9950-c4d0e47c6932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e98d6b56105d647081396137bd7a4fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcaae367/uploads/origins/75476aef-1f7a-4ecd-9950-c4d0e47c6932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e64fb699e0e21785d9093d9286ca6356", "srcset": "https://si.imgix.net/fcaae367/uploads/origins/75476aef-1f7a-4ecd-9950-c4d0e47c6932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e64fb699e0e21785d9093d9286ca6356, https://si.imgix.net/fcaae367/uploads/origins/75476aef-1f7a-4ecd-9950-c4d0e47c6932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d43b0a096194d62b2a4cf42b669eeb00 2x, https://si.i