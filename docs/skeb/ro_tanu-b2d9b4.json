w=200&h=200&blur=200&s=ee86b45d5086d9f4ed9eae110c0ee53a", "srcset": "https://si.imgix.net/6ea49e10/uploads/origins/8abfe07a-e733-4716-81b0-f193de45b8c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee86b45d5086d9f4ed9eae110c0ee53a, https://si.imgix.net/6ea49e10/uploads/origins/8abfe07a-e733-4716-81b0-f193de45b8c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e73d107b6b2737ec36b80b1e9096ecff 2x, https://si.imgix.net/6ea49e10/uploads/origins/8abfe07a-e733-4716-81b0-f193de45b8c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63c37be0c5b19f36349e868b15b5df5c 3x"}, "body": "モチーフ:城星メイ\nかつてELDEN RINGをやろうとしてたのですがストームヴィル城に行く前の関門の時点でビビってしまったり、レベル上げをしないと進めないタイプ\n魔法使いタイプの癖に鎧来てドッスンローリングしながら殴りかかったりしていたので華麗な戦闘をする星の魔術師(理想)を描いて本物の星の魔術師とはこんな感じだよと理想像を教えてあげたい。\nトロルにビビっていたり兵士に追っかけられてる様子でも犬に手を噛まれる様子など狭間の地ならではのあるあるならなんでも可\n\n進行度的にはまだマルギットと会ってません(怖いから)\n使用用途はSNSやYouTubeでの使用になります。\n本人がクレジットアリでお借りする場合があります。\n\nhttps://drive.google.com/drive/folders/1fMaI4EPK3uv51BQCyDxsMoQnYNyi7J2R", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ro_tanu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 403063, "client_id": 2549593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d2bf6e2/uploads/origins/bbd79d5d-61a5-45ff-bdf1-074bed56e00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef0fdb2cc3086437a8929755589ba07d", "srcset": "https://si.imgix.net/8d2bf6e2/uploads/origins/bbd79d5d-61a5-45ff-bdf1-074bed56e00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef0fdb2cc3086437a8929755589ba07d, https://si.imgix.net/8d2bf6e2/uploads/origins/bbd79d5d-61a5-45ff-bdf1-074bed56e00c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ab86c6d75c37058cfb02e460e24aceb 2x, https://si.i