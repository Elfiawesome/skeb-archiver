いないものだと有難いです。\n表情や細かいデザイン、ポーズはお任せいたします！\n\n◾︎利用目的、使用用途\n・Twitterにてクレジット表記ありの1枚絵として投稿\n・アイコン等のSNSで使用\n・デジタルグッズ制作\n商用利用の許可をいただけると有難いです。\n\n◾︎形式\n・縦3 横4\n・人物と背景を分けたPNGファイル\n\nご縁がありますと幸いです。\nご検討のほどよろしくお願いいたします🙇🏻\n\n※なにか不足しておりましたらお手数おかけしますが再リクエスト送ってくださると幸いです。\n\nhttps://pin.it/3KUKbpuCF", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizuki_hayu/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d07f905d/uploads/origins/2df4e5a2-46d5-42c1-a04a-1f8e64b79947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77ce0cc20fc16074bc29ab2178b0111d", "srcset": "https://si.imgix.net/d07f905d/uploads/origins/2df4e5a2-46d5-42c1-a04a-1f8e64b79947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77ce0cc20fc16074bc29ab2178b0111d, https://si.imgix.net/d07f905d/uploads/origins/2df4e5a2-46d5-42c1-a04a-1f8e64b79947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=831b1a94d418e997fed00061da541f3b 2x, https://si.imgix.net/d07f905d/uploads/origins/2df4e5a2-46d5-42c1-a04a-1f8e64b79947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c25e80884bf7a4a8cad5da49382d9677 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1350507, "client_id": 2855932, "nc": 1}, {"path": "/@mizuki_hayu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1350507, "client_id": 3151727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0322ba7d/uploads/origins/901707f4-1168-444