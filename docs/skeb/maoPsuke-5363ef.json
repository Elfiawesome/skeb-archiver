\u30c8\u3068\u7533\u3057\u307e\u3059\u3002 X\u306b\u3066\u9b54\u738b\u3074\u30fc\u3059\u3051\u69d8\u306e\u7d20\u6575\u306a\u4f5c\u54c1\u3092\u62dd\u898b\u3044\u305f\u3057\u307e\u3057\u305f\u3002\u3068\u3066\u3082\u7f8e\u3057\u3044\u96f0\u56f2\u6c17\u306e\u4f5c\u54c1\u306b\u76ee\u3092\u596a\u308f\u308c\u3001\u305c\u3072\u79c1\u3082\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3044\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\n\n \u3010\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u4eba\u7269\u3011\n\u6731\u702c\u30aa\u30c8(\u81ea\u5206) \n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u8a73\u7d30\u3011\n \u30fb\u900f\u660e\u611f\u3068\u511a\u3055\u3092\u5927\u5207\u306b\u3057\u3066\u3044\u308b\u732b\u304b\u3076\u308a\u7cfbVTuber \n\u30fb\u6027\u5225\u4e0d\u8a73\u3001\u5e74\u9f62\u4e0d\u8a73\n\u30fb\u30a4\u30e1\u30fc\u30b8\u30ab\u30e9\u30fc\u306f\u8584\u7d2b/\u767d\u3067\u3001\u511a\u3055\u3092\u611f\u3058\u3089\u308c\u308b\u3088\u3046\u8272\u7d20\u304c\u8584\u3044\u611f\u3058\u304c\u597d\u307f\u3067\u3059\u3002\n \u30fb\u914d\u4fe1\u5185\u5bb9\u306f\u6b4c\u67a0\u3092\u4e2d\u5fc3\u306b\u96d1\u8ac7\u3084\u30b2\u30fc\u30e0\u307e\u3067\u8272\u3005\n \u30fb\u30c8\u30ec\u30fc\u30c9\u30de\u30fc\u30af\u306f\u732b\u3001\u5929\u4f7f\u306e\u7fbd\u3001\u30de\u30a4\u30af\u3067\u3059\u3002\n\n\u305d\u306e\u4ed6\u30a4\u30e1\u30fc\u30b8\u3084\u8a73\u7d30\u306fGoogle\u30c9\u30e9\u30a4\u30d6\u306b\u3066\u5931\u793c\u3044\u305f\u3057\u307e\u3059\u3002 \n\n\u25b7\u9aea\u306e\u6bdb\u306f\u3001\u30b7\u30e7\u30fc\u30c8\u30dc\u30d6\u3084\u30b7\u30e7\u30fc\u30c8\u30a6\u30eb\u30d5\u3092\u30a4\u30e1\u30fc\u30b8\u3057\u3066\u304a\u308a\u307e\u3057\u3066\u3001\u6839\u672c\u2192\u6bdb\u5148\u304c\u767d\u8272\u2192\u8584\u3044\u30d4\u30f3\u30af\u3068\u306a\u3063\u3066\u304a\u308a\u307e\u3059\u3002 \n\u25b7\u77b3\u306e\u8272\u306f\u7d2b\u3068\u8d64\u7d2b\u306e2\u8272\u3067\u3059\u3002\n\n\u26a0\ufe0e\u4eca\u56de\u306f\u9ed2\u9aea\u30dc\u30d6\u306e\u59ff\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059...!\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011 \uff08\u4f7f\u7528\u3055\u305b\u3066\u3044\u305f\u3060\u304f\u53ef\u80fd\u6027\u304c\u3042\u308b\u3082\u306e\u5168\u3066\u8a18\u8f09\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\uff09\n \u30fb\u914d\u4fe1\u30b5\u30e0\u30cd\u30a4\u30eb\u3001SNS\u6295\u7a3f\u306a\u3069VTuber\u6d3b\u52d5\u5168\u822c\n\n  \u3010\u304a\u9858\u3044\u3011 \n\u30fb\u8868\u60c5\u3084\u69cb\u56f3\u306f\u304a\u307e\u304b\u305b\u3067\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\u30fb\u305f\u3060\u5143\u6c17\u3063\u5b50\u3067\u306f\u306a\u3044\u306e\u3067\u5168\u529b\u7b11\u9854\u306f\u907f\u3051\u3066\u304f\u3060\u3055\u3044\u3002\uff08\u5fae\u7b11\u307f\u306f\u25ce\uff09\n \u30fb\u80cc\u666f\u3001\u4eba\u7269\u3001\u30b5\u30a4\u30f3\u306a\u3069\u3054\u3056\u3044\u307e\u3057\u305f\u3089\u3001\u3082\u3057\u53ef\u80fd\u3067\u3042\u308c\u3070\u304a\u624b\u6570\u3067\u3059\u304c\u30ec\u30a4\u30e4\u30fc\u304c\u305d\u308c\u305e\u308c\u5206\u304b\u308c\u305f\u3082\u306e\u306e\u7d0d\u54c1\u3092\u304a\u306d\u304c\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\n\u30fb\u4f5c\u6210\u306e\u6ce8\u610f\u70b9\u3068\u3057\u3066\u6027\u5225\u4e0d\u8a73\u3068\u3044\u3046\u70b9\u304c\u3042\u308a\u307e\u3059\u306e\u3067\u3001\u53ef\u611b\u3059\u304e\u306a\u3044\u3001\u30ab\u30c3\u30b3\u826f\u3059\u304e\u306a\u3044\u3092\u5c11\u3057\u610f\u8b58\u3057\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5e78\u3044\u3067\u3059\u3002\u307e\u305f\u6027\u683c\u4e0a\u3001\u5143\u6c17\u3063\u5b50\u3067\u306f\u306a\u3044\u306e\u3067\u511a\u304f\u900f\u660e\u611f\u306e\u3042\u308b\u30a2\u30f3\u30cb\u30e5\u30a4\u306a\u96f0\u56f2\u6c17\u3067\u4ed5\u4e0a\u3052\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u3046\u308c\u3057\u3044\u3067\u3059\uff01\n\n  \u3010\u305d\u306e\u4ed6\u3011\n \u30fb2022\u5e74\u306e11\u6708\u3088\u308a\u6d3b\u52d5\u3057\u3066\u3044\u305f\u306e\u3067\u3059\u304c\u30012024\u5e743\u6708\u3092\u6301\u3063\u306