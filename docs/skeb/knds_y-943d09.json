を思いやる。\n恋人同士。特にシチュエーションは考えていないので、2人が幸せであれば自由に描いてください！\n私が提案できる活動としては\n- ヒスイのポケモンずかん」を一緒に読む。\n- 一緒に食べる（いももち、おだんご、ベリー類、何でもOK!）\n- 相手の髪を弄る。\n- かわいいシチュエーションやロマンチックなシチュエーションなら何でもOK(笑)！\n\nこのリクエストに抵抗がある方はキャンセルをお願いします！\nお忙しい中、本当にありがとうございました💙 ！\nhttps://drive.google.com/drive/folders/1yijYvYV-vNV5Dy4HItqqvtgGROhdbPvm", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@knds_y/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2960887, "client_id": 1308705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/537b3184/uploads/origins/95d2c09d-7f6e-43b6-bb1e-e627ce3ff727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d9b31b9a51d0ce4141744d554aa844a", "srcset": "https://si.imgix.net/537b3184/uploads/origins/95d2c09d-7f6e-43b6-bb1e-e627ce3ff727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d9b31b9a51d0ce4141744d554aa844a, https://si.imgix.net/537b3184/uploads/origins/95d2c09d-7f6e-43b6-bb1e-e627ce3ff727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f9c597cb9ea6da33fbd9ef5eb3dce90 2x, https://si.imgix.net/537b3184/uploads/origins/95d2c09d-7f6e-43b6-bb1e-e627ce3ff727?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51e520334e2f04e60a9860e74591dfe1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/537b3184/uploads/origins/95d2c09d-7f6e-43b6-bb1e-e627ce3ff727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cefc6fd0f050f8c6a1f58e1b07eefdd", "srcset": "https://si.imgix.net/537b3184/uploads/origins/95d2c09d-7f6e-43b6-bb1e-e627ce3ff727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cefc6fd0f050f8c6a1f58e1b07eefdd, https://si.imgix.net/537b3184/uploads/origins/95d2c09d-7f6e-43b6-bb1e-e627ce3ff727?bg=%