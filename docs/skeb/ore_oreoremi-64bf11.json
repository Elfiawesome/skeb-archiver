n・縄、枷などの拘束もNG、ローターなどの機械もNG\n\n◇構図\nお任せ\n\n◇シチュエーション\n『滑稽な姿なのマジにリョナられる』を大まかなシチュとし。\n作者様の過去作品のこちら\nhttps://skeb.jp/@ore_oreoremi/works/10のような。\n\nこちら　\nhttps://skeb.jp/@hiyamgitune/works/23\nhttps://skeb.jp/@hiyamgitune/works/24\nhttps://www.pixiv.net/artworks/116197147\n(私の過去依頼)\nのような敵に捕らわれて滑稽な姿を馬鹿にされながら見世物、晒し者にされるようなシチュでお願いします。\nよろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ore_oreoremi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3109760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e45bd2bd/uploads/origins/1e37c0c9-9845-42f2-9701-1905b0eea61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf1f0e5d9adcd9fd42baf04e799cd8b", "srcset": "https://si.imgix.net/e45bd2bd/uploads/origins/1e37c0c9-9845-42f2-9701-1905b0eea61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf1f0e5d9adcd9fd42baf04e799cd8b, https://si.imgix.net/e45bd2bd/uploads/origins/1e37c0c9-9845-42f2-9701-1905b0eea61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b726eda5f7e3e46de30b1e9af1ac5848 2x, https://si.imgix.net/e45bd2bd/uploads/origins/1e37c0c9-9845-42f2-9701-1905b0eea61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fd0c53477126e1de0b1f120fda544cd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e45bd2bd/uploads/origins/1e37c0c9-9845-42f2-9701-1905b0eea61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0ec79147ee74a15d1bb48ea8fc1cbef", "srcset": "https://si.imgix.net/e45bd2bd/uploads/origins/1e37c0c9-9845-42f2-9701-1905b0eea61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0ec79147ee74a15d1bb48ea8fc1cbef, https://si.imgix.net/e45bd2bd/uploads/origins/1e37c0c9-9845-42f2-9701-1