/status/1994731268748227063/photo/1\n\n【用途】\nX（旧Twitter）の投稿、配信用のサムネ、配信中に使用するイラストとして利用させていただきたいと考えております、\nキャラクターと背景のレイヤー別々でお願いします。\n\nYouTubeのサムネイルに使用する為、頭の先や髪の毛などは、先端まで切れないように作画頂けますと嬉しいです。\n\nお忙しいところ恐れ入りますが、ご確認のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/file/d/1-tntsABIx-WprdLtxONG-Z8lFnID4MKo/view?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cloudy_Crow96/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3090124, "client_id": 3143746, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75f3c279/uploads/origins/40628ecc-f2c7-4ee5-acaf-765d0242fccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6b883ca4e3186cf19c4e6f382d03926", "srcset": "https://si.imgix.net/75f3c279/uploads/origins/40628ecc-f2c7-4ee5-acaf-765d0242fccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6b883ca4e3186cf19c4e6f382d03926, https://si.imgix.net/75f3c279/uploads/origins/40628ecc-f2c7-4ee5-acaf-765d0242fccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6aa0d4827d4d97b09e2434bca39c6443 2x, https://si.imgix.net/75f3c279/uploads/origins/40628ecc-f2c7-4ee5-acaf-765d0242fccd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddde00a842438c5b391c1a910e747cac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75f3c279/uploads/origins/40628ecc-f2c7-4ee5-acaf-765d0242fccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb7f959f1e21f149e86fd401a63c902c", "srcset": "https://si.imgix.net/75f3c279/uploads/origins/40628ecc-f2c7-4ee5-acaf-765d0242fccd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb7f959f1e21f149e86fd401a63c902c, https://si.imgix.net/75f3c279/uploads/origins/40628ecc-f2c7-4ee5-acaf-765d