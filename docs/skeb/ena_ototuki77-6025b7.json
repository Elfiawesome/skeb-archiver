op&w=200&h=200&s=0b8bc5090360914ee83031d6061fd36a 2x, https://si.imgix.net/6f923312/uploads/origins/b2caffe1-9a30-4aa2-bb0f-db9ccdce9f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0df166733e80f6a0d68fd207a9b22e9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f923312/uploads/origins/b2caffe1-9a30-4aa2-bb0f-db9ccdce9f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108809dc1a3f41c1b6183820fb5d0e90", "srcset": "https://si.imgix.net/6f923312/uploads/origins/b2caffe1-9a30-4aa2-bb0f-db9ccdce9f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=108809dc1a3f41c1b6183820fb5d0e90, https://si.imgix.net/6f923312/uploads/origins/b2caffe1-9a30-4aa2-bb0f-db9ccdce9f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1cd6f5ca9648f2e68fe6a2a753028ad0 2x, https://si.imgix.net/6f923312/uploads/origins/b2caffe1-9a30-4aa2-bb0f-db9ccdce9f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84bd3b6f81d6fe5bc77cd08448732613 3x"}, "body": "音月瑛名 様\n\n初めまして！\n個人Vtuberとして活動している、ねこたぬきと申します。\nぜひ私ねこたぬきを描いていただきたくリクエストを送らせていただきました！\n\n■内容\n音月瑛名 様のこちらの作品がとってもとっても可愛くて素敵でしたので、\nhttps://www.pixiv.net/artworks/101276717\nぜひ「水着を着たねこたぬき」を描いていただきたいです！\n\n表情や構図などはおまかせいたします！\nかわいい水着を着せて頂けると嬉しいです🎀\n\n頭部が見切れないよう描いて頂きたいです！\n肩の上にいるのはたぬきぱんつという生き物です。たぬきぱんつがいるかいないかはお任せいたします！\n\n▲現在ねこたぬきは髪型が２種類あり、\n今回音月瑛名 様に描いていただきたいのは「ショートヘア」の方になります！\n▲瞳の中に、頭につけてるキャンディと同じ色のハイライトがあります。\n\n【使用用途】\n・サムネイルや動画内、SNS、アイコン、バナーなどでの利用\n・メッセージ等を入れてネットプリントでの期間限定の配布(メンバーシップ加入者様限定にする場合もあり)\n・メンバーシップ加入者様向けに配布する壁紙\n作品のイメージを損なわない程度の軽微な加工(例；色調補正やトリミングなど)をご許可頂きたいです！\n\n上記使用用途が難しい場合、大変お手数ですがキャンセルしていただけますと幸いです。\n\nPSDデータにて納品して頂けると嬉しいです！\n\nご検討よろしくお願い致します！\n\n■ねこたぬきについて\nhttps://lit.link/nekotanuki\n■新髪型(ショートヘア)お披露目時の配信アーカイブ\nhttps://www.youtube.com/live/Je-UPgNmOwU?si=G_UF9e0HuEXuqu8W\n■資料\nhttps://x.com/nekotanuki6/status/1739375158715179098?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ena_ototuki77/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3171, "client_id": 2676564, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1589874d5fd905916e16fff1912408c8", "srcset": "https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1589874d5fd905916e16fff1912408c8, https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92a0737b38d9167c6baaca650a0fd0af 2x, https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f89c12f7daf5e54ac93f3f904e771c18 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e78c418812c36335e6898fdc6c790ff", "srcset": "https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e78c418812c36335e6898fdc6c790ff, https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b8f5dae045b8f0a18e31fada17acf0c 2x, https://si.imgix.net/141af365/uploads/origins/341721d3-c626-4fe0-942b-888872c8d408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=cr