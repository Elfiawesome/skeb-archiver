4ab3aef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba83ba8a9a480fb61c06685f5c2e9cce", "srcset": "https://si.imgix.net/df259647/uploads/origins/cc74b686-f109-444f-8aab-54984ab3aef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba83ba8a9a480fb61c06685f5c2e9cce, https://si.imgix.net/df259647/uploads/origins/cc74b686-f109-444f-8aab-54984ab3aef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bf02d0c81831d40ee8dd4d4ecb71f5a 2x, https://si.imgix.net/df259647/uploads/origins/cc74b686-f109-444f-8aab-54984ab3aef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d8e823295079bb82b52dacee9d56353 3x"}, "body": "ととそな〜様\n\n初めまして、βαliμγnαと申します。\nskebの新着からイラストを拝見し、ぜひ私のOCを描いていただきたいと思い、リクエストさせていただきます。\n\n▶︎参考資料\nhttps://drive.google.com/drive/folders/1rgYSATJw8mpebrRGlsFzXCUWoEWs_x0a\n\n▶︎外見特徴\n・オッドアイ\n・髪に✧の模様\n・雲・雷・雨モチーフの飾り\n\n▶︎構図\n特に指定等ありませんので、ととそな〜様のご自由にお描きいただければと思います。\n固定衣装も存在しませんので、お好きに描いていただけますと幸いです。\n\n▶︎使用用途\n・SNSのアイコンやヘッダー、PC・スマホの壁紙としての個人利用\n・アクリルキーホルダーや本など、個人鑑賞目的でのグッズ作成\n・今後skeb等依頼する際の参考資料としての活用\n\n▶︎その他\nキャラクターと背景等を分けたPSD形式のイラストだと嬉しいです。\nまた、ラフ段階のイラストや没になったもの等がありましたら、残していただけると嬉しいです。\n\nご依頼内容や金銭面で不明点や問題がある場合は、遠慮なく再送・キャンセルしてくださいませ。\nご多忙のところ恐れ入りますが、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rn_9j/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1180907, "client_id": 2544199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24cbb638d095e051933566d84207f849", "srcset": "https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24cbb638d095e051933566d84207f849, https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=528dd9f908dc7b73d852efd2a33aa09d 2x, https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e47890af3583098724bdceb6999c13d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3092f1b4714af644c766ca6e27c04c52", "srcset": "https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3092f1b4714af644c766ca6e27c04c52, https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e78d5a20444980ba5ae36ed54057653 2x, https://si.imgix.net/6d63f11d/uploads/origins/102ea7f8-6f85-4b2c-891a-8e05eb46a270?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1922ae015554242b2db91603496e46c8 3x"}, "body": "初めまして！\n新着でととそな〜さんの可愛らしく魅力的な絵柄に一目惚れし、是非ともととそな〜さんの作風で男女OCを描いて頂きたくリクエストに参りました。\n\n✧セス（男）\n髪／金髪\n瞳／青、下睫毛\n20歳。188cm。次期国王（現王子）。\n冷酷かつ氷のような男。有能。基本スン…としておりあまり表情が変わらないが、姉の前では言動が少し柔らかい。\n嫉妬深く、姉と誰かが会話していると普通に姉さん。と割り込んでくる。後方腕組み彼氏面もする。\n幼い頃、冷遇されていた自分に関わり続け受け入れてくれた姉にかなり依存している。\n\n✧ミラ（女）\n髪／茶色、インテークの中が桃色\n瞳／緑と桃\n24歳。152cm。王女。\n天真爛漫、ゴーイングマイウェイお姫。人を振り回しがち。\nセスは義理とはいえ初めてできた自分の弟であり、うんと可愛がり、ヨシヨシとしてきた。\nふわふわにこにことしているが、セスが思っているより現実がしっかりと見えている。\n懐に入り込んでから手をすり抜ける女。(全て善から来る行動であるが天使のような悪魔のような…)\n\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いても、好きにデザインしていただいても構いません！\nととそな〜さんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います。\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か金額等失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1DdZZJURoKDORea2vvUdX2-OTxY3rpHBM?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rn_9j/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1180907, "client_id": 173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48a75938/uploads/origins/b11f9c6d-50c5-4fdc-a7ea-38dac208d74d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b9a1b0baa8af577052b6e74992609dc", "srcset": "https://si.imgix.net/48a75938/uploads/origins/b11f9c6d-50c5-4fdc-a7ea-38dac208d74d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b9a1b0baa8af577052b6e74992609dc, https://si.imgix.net/48a75938/uploads/origins/b11f9c6d-50c5-4fdc-a7ea-38dac208d74d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d32ba0c0e597de4a6a084b920d884cdc 2x, https://si.imgix.net/48a75938/uploads/origins/b11f9c6d-50c5-4fdc-a7ea-38dac208d74d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eae20a005888e82f9df873f8534d789b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48a75938/uploads/origins/b11f9c6d-50c5-4fdc-a7ea-38dac208d74d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=424a674d2146d3b95544e9bc65b5253a", "srcset": "https://si.imgix.net/48a75938/uploads/origins/b11f9c6d-50c5-4fdc-a7ea-38dac208d74d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=424a674d2146d3b95544e9bc65b5253a, https://si.imgix.net/48a75938/uploads/origins/b11f9c6d-50c5-4fdc-a7ea-38dac208d74d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=11644930580cfd2dac482bedabc63f4f 2x, https://si.imgix.net/48a75938/uploads/origins/b11f