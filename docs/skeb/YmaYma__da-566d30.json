f4-9a20-0628d0ddd415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8293b28a50066e76ff68b84413e7e169 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99b24272/uploads/origins/97350e02-e781-43f4-9a20-0628d0ddd415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f18725569dba3d3442df4646c3c73a2", "srcset": "https://si.imgix.net/99b24272/uploads/origins/97350e02-e781-43f4-9a20-0628d0ddd415?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f18725569dba3d3442df4646c3c73a2, https://si.imgix.net/99b24272/uploads/origins/97350e02-e781-43f4-9a20-0628d0ddd415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a62afdb69b014bd8d444a9b1720cd07c 2x, https://si.imgix.net/99b24272/uploads/origins/97350e02-e781-43f4-9a20-0628d0ddd415?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=688b89c34940c7d54dbe6ee116bcd6a5 3x"}, "body": "使用用途\nすとふぇす2026 応援のぼり\n\n制作内容\nロゼくん&みかさくん 1枚絵（背景あり）\n\n画像サイズ（px）と解像度（dpi）\n･キャンバスサイズ：2441px ✕ 7165px\n･ 解像度 : 100dpi\n･カラーモード: CMYK\n\nキャラクターの詳細\n【衣装】すとふぇす2026キービジュアル\n【ポーズ】ロゼくんとみかさくんが背中合わせに立っていて、腕を絡ませてほしいです。絡ませていない方の手は、みかさくんがハートショットの手（ピストルの形）、ロゼくんも同じくハートショットを真似している感じでお願いします。\n【表情】みかさくんはウィンク（ハートショットにノリノリな感じ）\nロゼくんはみかさくんのハートショットに付き合ってあげてる、少し微笑みを浮かべている感じでお願いします。\n（ふたりはプリキュアのキュアブラックとキュアホワイトにすごく理想的な構図があるのでお手数でなければ検索して見ていただきたいです、、、！これよりもう少し背中合わせ感があると良いです。）\n\n【背景】ライブ会場風、ピンクと赤のペンライト\n\n【主催】桃瀬ちゃん、いちかちゃん、湯湯", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YmaYma__da/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3288385, "client_id": 3787177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=248dbc351fb7373e5803c8c5e3184898", "srcset": "https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=248dbc351fb7373e5803c8c5e3184898, https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5b15ef298b7566f1114b43bcb619858 2x, https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3ae5d6f46e2251c0addccbbce24e112 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6d821a3a5ec6468d04735573291bd8b", "srcset": "https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6d821a3a5ec6468d04735573291bd8b, https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70ab43ba05af13152cef565722e744f4 2x, https://si.imgix.net/a531cbd5/uploads/origins/07137dc6-3542-41e8-afe4-c6964318a665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61258449dd4c3960bd3e481d140b6876 3x"}, "body": "こんにちは！\nあなたの画風がとても気に入っています。\n\n「HempieVT」というVTuberのイラストをお願いしたいです。\n彼女は普段から眠そうで、少しぼんやりとした雰囲気をしており、目の下にクマがあります。\nまた、髪に赤いストライプがあり、瞳の中にはX（エックス）型の模様があります。\n添付の参考画像のどの衣装を使っていただいても大丈夫です。\n\nポーズや構図、雰囲気などはすべておまかせします。\n自由に、あなたの思うままに描いていただけると嬉しいです。\n\nHempieは、上官の命令に逆らったためにチェルノブイリの立入禁止区域に追放されたスリーパーエージェントです。\n放射線の影響で彼女自身も放射性を帯びており、孤独の中で廃墟の建築や放棄された軍用車両、武器（SVD、DP-27など）を研究しながら静かに暮らしています。\nまた、酒に酔うのが好きで、時々飲みすぎてしまうこともありますが、それでも楽しんでおり、よく飲んでは物思いにふけり、時々タバコを吸うこともあります。\n\n彼女のそばには、放射能の影響で変異したマスコットの「Pyp（ピップ）」がいます。\nPypは小さな粘性のある生物で、手足がなく、頭上に光る輪（ハロー）が浮かんでおり、いつもHempieの頭の上や近くにいます。\n\nこのキャラクターは、『serial experiments lain（シリアルエクスペリメンツ・レイン）』や『少女終末旅行』のような作品に影響を受けています。\n静けさ、不安定さ、そして虚無感を感じるトーンで表現していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HKpUvqulI6HbCdDdFmdSel-kAK-mqZ6k?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YmaYma__da/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3288385, "client_id": 3651312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c10078c/uploads/origins/b244124e-a0eb-414f-9272-830738c35cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cabc962a58f79209387af05c8f55cabb", "srcset": "https://si.imgix.net/2c10078c/uploads/origins/b244124e-a0eb-414f-9272-830738c35cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cabc962a58f79209387af05c8f55cabb, https://si.imgix.net/2c10078c/uploads/origins/b244124e-a0eb-414f-9272-830738c35cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d72fc50f9fe1ccb09efc0754561cbc58 2x, https://si.imgix.net/2c10078c/uploads/origins/b244124e-a0eb-414f-9272-830738c35cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7850c00470bd09e8e521830eef7ed962 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c10078c/uploads/origins/b244124e-a0eb-414f-9272-830738c35cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a4c1080d3c4ad932cbf737cdaea2e35", "srcset": "https://si.imgix.net/2c10078c/uploads/origins/b244124e-a0eb-414f-9272-830738c35cc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a4c1080d3c4ad932cbf737cdae