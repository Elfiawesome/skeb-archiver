7-4411-bcac-ad4c2511a28b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8c6b0e48b4b9f8ed56131bc21994d4e 3x"}, "body": "I am always looking at your beautiful paintings! \ud83d\udc96\ud83d\udc96\ud83d\udc96\nI would like you to paint me and my friend oc! \ud83d\udc96\ud83d\udc96\nClothes are welcome to be original or omit decorations, though,\n\ud83d\udc96 Hair color, two-tone\nWe are open to any design (\ud83d\ude46\u200d\u2640\ufe0f).\nPlease do not leave out the elements of angels and demons, bunnies and cats.\nPlease do not leave out any of the following elements! \ud83d\ude47\u200d\u2640\ufe0f\nPlease make sure that the expression of the demon Berry-chan is not too bright, and the angel Frill-chan is innocent and energetic \ud83d\ude4f.\nI'll leave it up to you to draw them as you see fit \ud83d\udc96\ud83d\udc96\ud83d\udc96\ud83d\udc96.\n\nhttps://drive.google.com/drive/folders/1xXtB6pXjsdDS1zQr-hSlu7-9h-UdvAjP", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ojaga_moi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2555446, "client_id": 2107247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a21b05d4/uploads/origins/ea0ad969-fe24-4fdf-b3f3-e6eddbb1d447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb99762b19aec52ec751a55e507037b", "srcset": "https://si.imgix.net/a21b05d4/uploads/origins/ea0ad969-fe24-4fdf-b3f3-e6eddbb1d447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fb99762b19aec52ec751a55e507037b, https://si.imgix.net/a21b05d4/uploads/origins/ea0ad969-fe24-4fdf-b3f3-e6eddbb1d447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8884ff30d2ec338ac46b3bc4d2ca88e7 2x, https://si.imgix.net/a21b05d4/uploads/origins/ea0ad969-fe24-4fdf-b3f3-e6eddbb1d447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&