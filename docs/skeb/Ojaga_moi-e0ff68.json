 cute! I would like to request artwork for my OC Peak. She is a short catgirl vampire with fangs, red eyes, pretty hair, stupid hair and burn marks all over her body. She has ribbons on her left ear and on the end of her tail. She has big eye bags and always looks tired!\nShe is a violent, collected, gentle vampire, so blood/slight girth is not a problem at all on the www.\nShe is also free to pose.\n\nWell then.\nBest regards !\n\nhttps://imgur.com/a/V6kGyrw\n\nhttps://imgur.com/a/V6kGyrw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ojaga_moi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2555446, "client_id": 1093311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/360b4322/uploads/origins/e72e55df-d4bf-4fc0-8252-2d1107fc7436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0644ea67173eaf822e1c7b132acd759c", "srcset": "https://si.imgix.net/360b4322/uploads/origins/e72e55df-d4bf-4fc0-8252-2d1107fc7436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0644ea67173eaf822e1c7b132acd759c, https://si.imgix.net/360b4322/uploads/origins/e72e55df-d4bf-4fc0-8252-2d1107fc7436?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af36c454158c19538ea315cd91d209e8 2x, https://si.imgix.net/360b4322/uploads/origins/e72e55df-d4bf-4fc0-8252-2d1107fc7436?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86c124e2e8be9c0797f48b3796f9c4d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/360b4322/uploads/origins/e72e55df-d4bf-4fc0-8252-2d1107fc7436?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=255fe461dce40cc65aa85c70b840dbd3", "srcset": "https://si.imgix.net/360b4322/uploads/origins/e72e55df-d4bf-4fc0-8252-2d1107fc7436?bg=%23fff&auto=fo