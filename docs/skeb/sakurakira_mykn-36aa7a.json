4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce56e66bde05da0c237308f25a15be90", "srcset": "https://si.imgix.net/7e166139/uploads/origins/5ffdb694-ad12-4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce56e66bde05da0c237308f25a15be90, https://si.imgix.net/7e166139/uploads/origins/5ffdb694-ad12-4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca41696283e79643b3c92a3790e4be6f 2x, https://si.imgix.net/7e166139/uploads/origins/5ffdb694-ad12-4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae87b48c82db885c0045c100e426847d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e166139/uploads/origins/5ffdb694-ad12-4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8fabf0d94bc9621025fdd8b8bbcb637", "srcset": "https://si.imgix.net/7e166139/uploads/origins/5ffdb694-ad12-4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8fabf0d94bc9621025fdd8b8bbcb637, https://si.imgix.net/7e166139/uploads/origins/5ffdb694-ad12-4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63fc9b9f1164b81495a18c2ea1b0d451 2x, https://si.imgix.net/7e166139/uploads/origins/5ffdb694-ad12-4a90-a0fb-8d4b2cf499c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35aee9603af7afb238efca589702a8c9 3x"}, "body": "桜倉きら 様\n\nこんばんは。夜分遅くにすみません。\n依頼募集のポスト拝見しました。桜倉様の描く華やかで可愛らしく、時には儚く切ない印象のイラストにいつも魅せられています。特に瞳や宝石のきらきらした色使い、光の表現が美しくて好きです。\n\n今回skebにてリクエストの募集を開始されたとの事で、\n【糸雫撚葉氏の『言いたいことはひとつだけ』に登場するルーノちゃんのバストアップイラスト】\nをぜひお願いしたく送らせていただきました。\n\nさらに、もし余裕があるなら以下の内容もリクエストしたく思います。\n▼笑顔や微笑んでいるような好感情の表情\n▼瞳が見えること\n▼ルーノちゃんに似合う宝石をイラストに含む\n▼イラスト全体として華やかな印象\nどれも桜倉様のイラストの中で特に好きだと感じている部分なので、もし叶うなら大変喜びます。瞳の描き込みが深いとさらに喜びます。\n\nまた、頂いたイラストは糸雫撚葉氏にプレゼントしたく思っているので、万が一の可能性として氏が配信素材及び小説の宣伝として使用する許可も頂けると幸いです。\n\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1542844, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "き", "screen_name": "kirentono", "avatar_url": "https://pbs.twimg.com/profile_images/1688908908889604097/R8I-Rtx-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1317394677469831168/1691721492/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1563560, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "HojA", "screen_name": "hoja1214", "avatar_url": "https://pbs.twimg.com/profile_images/1481283643821916160/8iA7LhJg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1337758177358618626/1649920296/1500x500", "appeal_receivable": false, "popular_creator_rank": 14, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 2660080, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "necoze", "screen_name": "5_necoze", "avatar_url": "https://pbs.twimg.com/profile_images/1400784821492744200/OYfJQbaB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1008265217279528965/1642158479/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre"