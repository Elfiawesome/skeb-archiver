e91098bad629b1d0300b 2x, https://si.imgix.net/5e3fa335/uploads/origins/bc688840-c70b-4d10-a2f9-1e1a9f70eef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3ec2c2677f97f9fd34d492e1aef0c06 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e3fa335/uploads/origins/bc688840-c70b-4d10-a2f9-1e1a9f70eef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d72944d08f9d6beb6459d132afcbe65a", "srcset": "https://si.imgix.net/5e3fa335/uploads/origins/bc688840-c70b-4d10-a2f9-1e1a9f70eef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d72944d08f9d6beb6459d132afcbe65a, https://si.imgix.net/5e3fa335/uploads/origins/bc688840-c70b-4d10-a2f9-1e1a9f70eef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e50fd6c98f3472d5a46c1486f9377f6 2x, https://si.imgix.net/5e3fa335/uploads/origins/bc688840-c70b-4d10-a2f9-1e1a9f70eef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4afacb7ab384cd09195a4dd1e12eeb4e 3x"}, "body": "こんにちは\n青ブタの桜島麻衣ちゃん3人の絵をお願いします。\n\nhttps://x.gd/II7GJ\n↑絵のように同キャラ3人という設定です\n\n一人はオリジナル高校生麻衣先輩\n\n一人はアニメ2話で登場した中学生バージョンの麻衣先輩\nhttps://i.imgur.com/nD9BKUk.jpg\n\n一人は大学生バージョンの麻衣先輩設定でお願いします。\nhttps://i.imgur.com/SL8H6Wr.jpg\nhttps://i.imgur.com/i9EFHzf.jpg\n\n3人の衣装はバニーガールの衣装でお願いします。\nhttps://x.gd/TMAaN\t\nhttps://x.gd/Erinh\n\nストッキングは黒オーバーニーソックスストッキングで設定してください 作家さんが望まないなら、オリジナルバージョンでもいいです。\nhttps://x.gd/lx8mr\t\n\n設定は3人は一緒についていますが3人のポーズだけそれぞれ違う設定にしてください。\nhttps://x.gd/R6LqU\n\n中間にある高校生麻衣先輩は片手で頭を触りながら微笑むポーズを\nhttps://x.gd/6C4hq\t\nhttps://i.imgur.com/B4NKTGB.jpg\n\n真横に中学生麻衣先輩ははにかんだ表情で絵のポーズを\nhttps://x.gd/RMX48\n⬆絵では腰を曲げましたが、リクエスト絵では腰をまっすぐピン設定にしてください\n\n真横に大学生麻衣先輩はバニーガールの衣装が小さくて微笑んでいますが、少し不機嫌な表情で⬇絵のポーズをしている設定でお願いします。\nhttps://x.gd/B7O6l\t\n\n両方の2人の体の向きは真ん中の人に向くようにお願いします\nhttps://x.gd/rlkFh\n\nできれば絵の視点は3人を正面から眺めている視点でお願いします。\nhttps://x.gd/