, https://si.imgix.net/55067684/uploads/origins/e2430e0e-d069-4cbd-9de7-234838a6a193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7759a78bba6062b2cdaaf8f05a576327 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55067684/uploads/origins/e2430e0e-d069-4cbd-9de7-234838a6a193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=695080b878fc6caae137b70c8cfa8ed6", "srcset": "https://si.imgix.net/55067684/uploads/origins/e2430e0e-d069-4cbd-9de7-234838a6a193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=695080b878fc6caae137b70c8cfa8ed6, https://si.imgix.net/55067684/uploads/origins/e2430e0e-d069-4cbd-9de7-234838a6a193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e0e13cf37849ec0df0cb8506d54c3d1 2x, https://si.imgix.net/55067684/uploads/origins/e2430e0e-d069-4cbd-9de7-234838a6a193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=553e32b6993e105cce316fbd6421f5ab 3x"}, "body": "依頼失礼します。\n\nオリキャラのキャラ立ち絵を描いていただきたく依頼させていただきました。\nイメージとしては綺麗系からかっこかわいい系のキャラでお願いします。\n\n用途としましては以下を想定しています。\n・配信、動画活動の立ち絵\n・グッズ制作（クリアファイル、タペなど）\n\n\n参考画像を用意しましたのでご確認お願いします。\nhttps://drive.google.com/file/d/1zSv0_17u8jpkCrHuKGO8SgcSZz8GL-e0/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Klee_0303/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2348267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5722e5d9/uploads/origins/3d8dfb34-1cc9-4215-8c84-95edcd6d642d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e99ce361d042bf18fce4f0f2fc42677", "srcset": "https://si.imgix.net/5722e5d9/uploads/origins/3d8dfb34-1cc9-4215-8c84-95edcd6d642d?bg=%23fff&auto=format%2Ccompress&fm=we