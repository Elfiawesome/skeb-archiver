装を仕立ててほしいなと思っています！\n細かいデザインなどはきよこさんのセンスにお任せしたいです！\n\n【使用用途】\n\n・各種SNS(Twitter、Discordなど)での共有\n・SNSでのアイコンなどへの使用\n\n【資料】\nhttps://drive.google.com/drive/folders/1P3ukvd5v0AzoUBIfjjLjO7h1fmAEjmy3\n\n金額、内容の不備などありましたら、お手数をおかけしますが再送をお願いします。\nリクエストお受けいただけると嬉しいです！\nよろしくお願いします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@R_945_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2673775, "client_id": 3182905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f40a9ff8/uploads/origins/57ff50df-eb39-4634-a06b-3e925bbe476a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4124b66b2ce71082c0724d2a5ee77c4a", "srcset": "https://si.imgix.net/f40a9ff8/uploads/origins/57ff50df-eb39-4634-a06b-3e925bbe476a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4124b66b2ce71082c0724d2a5ee77c4a, https://si.imgix.net/f40a9ff8/uploads/origins/57ff50df-eb39-4634-a06b-3e925bbe476a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee8dddf0a15546906d0c7f1a013432fc 2x, https://si.imgix.net/f40a9ff8/uploads/origins/57ff50df-eb39-4634-a06b-3e925bbe476a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f110a849f95b4f7511daa51baa9c6f70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f40a9ff8/uploads/origins/57ff50df-eb39-4634-a06b-3e925bbe476a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06fc4da3a16697ff7a9a8b1a23999fd4", "srcset": "https://si.imgix.net/f40a9ff8/uploads/origins/57ff50df-eb39-4634-a06b-3e925bbe476a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06fc4da3a16697ff7a9a8b1a23999fd4, https://si.imgix.net/f40a9ff8/uploads/origins/57ff50df-eb39-4634-a06b-3e925bbe476a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2