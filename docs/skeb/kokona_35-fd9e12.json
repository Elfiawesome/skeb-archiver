耳かき中に投稿されてる耳かきボイスのようにかく音も共にお願いします。\n耳掃除の手順は\n右耳の耳かき→ピンセット→綿棒→梵天→耳ふーで右耳が終わった後に左耳の耳掃除もしていく。\n左耳の掃除が終わった後に無反応なご主人を見ると眠っていたので起こさない様に静かにゆっくりと下ろす。\n最後に囁きながら、「また耳が痒くなったら言ってよね。ちゃんと耳掃除してあげるから」「私はご主人の専属メイドなんだからさ」と言って終了。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 192644, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "せーちゃん☃️", "screen_name": "sesese___cha", "avatar_url": "https://pbs.twimg.com/profile_images/2011882661741228032/JITE0Iev.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1017679510756454400/1759083463/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 332602, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "梅糖めと", "screen_name": "umetoumeto", "avatar_url": "https://pbs.twimg.com/profile_images/1901261805378473984/x7QDjyvY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1029921250779398144/1647408949/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 1242035, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "餠鳥", "screen_name": "motidori_46", "avatar_url": "https://pbs.twimg.com/profile_images/1457323991421833216/y4m7PipP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/716533064311025664/1706610844/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_