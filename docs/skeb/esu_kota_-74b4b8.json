bc25-4ab1-9908-155b92a16217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d943602f3e3ce269e24ea67e4c3881a, https://si.imgix.net/3c2b2313/uploads/origins/db88e215-bc25-4ab1-9908-155b92a16217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68dd2d3f9dd6c11ffefa9aa6e2893202 2x, https://si.imgix.net/3c2b2313/uploads/origins/db88e215-bc25-4ab1-9908-155b92a16217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b89aee3e8bba2cfc50017a7bde01d460 3x"}, "body": "\u3053\u305f\u5148\u751f\uff01\u3053\u3093\u306b\u3061\u306f\u2014\u2014\n\u5148\u751f\u306e\u30a4\u30e9\u30b9\u30c8\u304b\u3089\u4f1d\u308f\u308b\u3001\u771f\u646f\u306a\u611f\u60c5\u306e\u8868\u73fe\u304c\u3068\u3066\u3082\u597d\u304d\u3067\u3059\u3002\u7279\u306b\u3001\u7b11\u9854\u3084\u62b1\u304d\u3057\u3081\u308b\u30b7\u30fc\u30f3\u306b\u5fc3\u3092\u6253\u305f\u308c\u307e\u3059\u3002\u79c1\u306e\u30aa\u30ea\u30b8\u30ca\u30eb\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u63cf\u304f\u3053\u3068\u3092\u4f9d\u983c\u3057\u305f\u3044\u3068\u601d\u3044\u307e\u3059\u3002\n\u91d1\u984d\u306b\u306a\u306b\u304b\u554f\u984c\u304c\u3042\u308c\u3070\u518d\u9001\u8981\u8acb\u3057\u3066\u304f\u3060\u3055\u3044\u3002\n\u96e3\u3057\u3051\u308c\u3070\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u3066\u5927\u4e08\u592b\u3067\u3059\u3002\n\n\u25bc\u53c2\u8003\u30ea\u30f3\u30af\u3067\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8a2d\u5b9a\u306a\u3069\u3001\u7d75\u306e\u53c2\u8003\u60c5\u5831\u3092\u3054\u89a7\u3044\u305f\u3060\u3051\u307e\u3059\u3002\n\n\u25bc\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306a\u3069\uff1a\n\u7269\u8a9e\u306e\u821e\u53f0\u306f\u3001\u897f\u6d0b\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u306e\u4e16\u754c\u89b3\u3067\u3059\u3002 (\u305f\u3060\u3057\u3001\u53c2\u8003\u6587\u732e\u3064\u306a\u304c\u308a\u3067\u73fe\u4ee3\u30d1\u30ed\u306e\u8bbe\u5b9a\u3082\u6df7\u3056\u3063\u3066\u3044\u307e\u3059\u304c)\n\n\u8d64\u9aea=F\u3001\u91d1\u9aea=L\n\nF\uff1a187cm, \u4eba\u9593\u738b\u56fd\u306e\u738b\u3001\u6c11\u8846\u304b\u3089\u611b\u3055\u308c\u308b\u5584\u826f\u306a\u6307\u5c0e\u8005\u3002\u5e38\u306b\u81ea\u5206\u306e\u8cac\u4efb\u3068\u56fd\u5bb6\u306e\u554f\u984c\u3092\u6700\u512a\u5148\u3059\u308b\u3002\u6700\u7d42\u306b\u56fd\u3092\u5b88\u308b\u305f\u3081\u306b\u81ea\u5206\u3092\u72a0\u7272\u306b\u3059\u308b\u3002\nL\uff1a175cm, \u738b\u306e\u5074\u8fd1\u3068\u3057\u3066\u6700\u5f37\u306e\u88dc\u4f50\u5f79\u3060\u3063\u305f\u3002 \u5f8c\u306b\u738b\u3092\u88cf\u5207\u308a\u3001\u6575\u306e\u5074\u306b\u3064\u304f\u3053\u3068\u3092\u9078\u629e\u3057\u305f\u3002\n\n\u4e8c\u4eba\u306e\u95a2\u4fc2\uff1a\u4e8c\u4eba\u306f\u4e00\u7dd2\u306b\u80b2\u3063\u305f\u5144\u5f1f\u3067\u3042\u308b\u3002\uff08\u8840\u306e\u3064\u306a\u304c\u308a\u306f\u306a\u3044\u3002\uff09 \u5e38\u306b\u304a\u4e92\u3044\u3092\u6700\u3082\u4fe1\u983c\u3057\u5408\u3044\u3001\u6700\u9ad8\u3067\u7279\u5225\u306a\u89aa\u53cb\u3067\u3042\u3063\u305f\u3002\nF to L\uff1a\u4e16\u754c\u3067\u4e00\u756a\u7279\u5225\u79c1\u306e\u5f1f\u3002 \u56fd\u306e\u884c\u4e8b\u4ee5\u5916\u306e\u3053\u3068\u306b\u6700\u3082\u95a2\u5fc3\u3002F\u306f\u306a\u305cL\u304c\u81ea\u5206\u3092\u88cf\u5207\u3063\u305f\u306e\u304b\u308f\u304b\u3089\u306a\u3044\u3002 F\u306f\u60b2\u3057\u307f\u3068\u6012\u308a\u3092\u611f\u3058\u306a\u304c\u3089\u3082\u3001L\u306e\u9078\u629e\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3092\u9078\u3076\u3002\nL to F\uff1a \u5f7c\u306e\u305f\u3081\u306b\u5168\u3066\u3092\u6367\u3052\u305f\u3044\u3068\u601d\u3046\u307b\u3069\u611b\u3057\u3066\u3044\u307e\u3057\u305f\u3002 \u3057\u304b\u3057\u3001\u305d\u3093\u306a\u6c17\u6301\u3061\u3092\u8868\u73fe\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u306a\u3044\u3002 \u56fd\u3092\u5b88\u308b\u7fa9\u52d9\u306e\u305f\u3081\u306b\u3001\u9045\u304b\u308c\u65e9\u304b\u308cF\u304c\u6b7b\u3093\u3067\u3057\u307e\u3046\u3053\u3068\u3092\u6050\u308c\u3066\u3001L\u306f\u53bb\u308b\u3053\u3068\u3092\u9078\u3093\u3060\u306e\u3060\u3002L\u306fF\u306b\u5bfe\u3057\u3066\u308f\u3056\u3068\u6575\u5bfe\u3067\u98c4\u3005\u3068\u3057\u305f\u614b\u5ea6\u3092\u3068\u308b\u304c\u3001\u5b9f\u969b\u306f\u8ab0\u3088\u308a\u3082F\u3092\u5927\u5207\u306b\u601d\u3063\u3066\u3044\u308b\u3002\n\n\u304b\u3064\u3066L\u306fF\u3092\u3068\u3066\u3082\u8a87\u308a\u306b\u601d\u3044\u3001\u5f7c\u306e\u5922\u306e\u5b9f\u73fe\u306b\u5354\u529b\u3057\u3088\u3046\u3068\u601d\u3063\u3066\u3044\u305f\u3002 \u3057\u304b\u3057\u3001F\u304c\u9078\u3093\u3060\u9053\u306f\u3001\u6c7a\u3057\u3066\u826f\u3044\u7d50\u679c\u3092\u3082\u305f\u3089\u3059\u3082\u306e\u3067\u306f\u306a\u3044\u3053\u3068\u306b\u3001\u6b21\u7b2c\u306b\u6c17\u3065\u3044\u3066\u3044\u3063\u305f\u306e\u3067\u3059\u3002 \u5f7c\u306f\u82e6\u60a9\u3057\u3001F\u304c\u8cac\u4efb\u306e\u6e26\u306b\u98f2\u307f\u8fbc\u307e\u308c\u308b\u306e\u3092\u98df\u3044\u6b62\u3081\u308b\u5225\u306e\u65b9\u6cd5\u3092\u6a21\u7d22\u3059\u308b\u3002L\u306fF\u306e\u7121\u79c1\u306e\u7cbe\u795e\u3068\u5bdb\u5927\u3055\u3092\u618e\u307f\u59cb\u3081\u308b\u3068\u540c\u6642\u306b\u3001\u81ea\u5206\u304c\u4e00\u756a\u597d\u304d\u306a\u306e\u306f\u3001\u3084\u306f\u308aF\u306e\u512a\u3057\u3055\u3068\u6c7a\u65ad\u529b\u3067\u3042\u308b\u3053\u3068\u306b\u6c17\u3065\u304f\u3002\nF\u306b\u3068\u3063\u3066\u306f\u3001L\u304c\u81ea\u5206\u306b\u5bfe\u3057\u3066\u611f\u3058\u3066\u3044\u308b\u611f\u60c5\u306b\u6c17\u3065\u304f\u3053\u3068\u306f\u306a\u304b\u3063\u305f\u3002 L\u306e\u88cf\u5207\u308a\u3092\u5bb9\u8a8d\u3057\u3001\u76f8\u5909\u308f\u3089\u305a\u306e\u5fc3\u914d\u308a\u3092\u3059\u308b\u3002 \u3057\u304b\u3057\u3001\u3082\u3057\u81ea\u5206\u306e\u56fd\u3068L\u306e\u3069\u3061\u3089\u304b\u3092\u9078\u3079\u3068\u8a00\u308f\u308c\u305f\u3089\u3001\u5f7c\u306f\u65ad\u56fa\u3068\u3057\u3066\u81ea\u5206\u306e\u56fd\u3092\u9078\u3076\u3060\u308d\u3046\u3002 (\u540c\u6642\u306b\u3001L\u306f\u8ff7\u308f\u305aF\u3092\u9078\u3076\u3060\u308d\u3046\uff09\u3002\n\n\u3064\u307e\u308a\u3001\u304a\u4e92\u3044\u3092\u6df1\u304f\u601d\u3044\u306a\u304c\u3089\u3082\u3001\u5225\u3005\u306e\u9053\u3092\u6b69\u3093\u3067\u3044\u304f\u4e8c\u4eba\u306e\u7269\u8a9e\u3002\n\uff08L\u306e\u7247\u601d\u3044....\uff08\uff1f\uff09\uff09\n\u4f53\u578b\u5dee\u304c\u3042\u308b\uff01\uff08\u72d7\u732b...\uff09\n\n\u25bc\u5185\u5bb9\u306a\u3069\uff1a\n\u3082\u3057\u53ef\u80fd\u3067\u3057\u305f\u3089\u3001F\u304cL\uff08\u77ed\u9aea\uff09\u3092\u62b1\u304d\u3057\u3081\u308b\u30b7\u30fc\u30f3\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u306a\u3044\u3067\u3057\u3087\u3046\u304b\u3002\n\n\u3053\u308c\u306f\u3001L\u304cF\u3092\u88cf\u5207\u3063\u305f\u5f8c\u3001\u3075\u305f\u308a\u304c\u521d\u3081\u3066\u518d\u4f1a\u3059\u308b\u5834\u9762\u3067\u3059\u3002\n\u5f37\u5927\u306a\u6575\u56fd\u306e\u5c06\u8ecd\u3068\u3057\u3066\u6570\u3005\u306e\u57ce\u3092\u9665\u843d\u3055\u305b\u3001\u4eee\u9762\u3092\u3064\u3051\u3066\u73fe\u308c\u305fL\u3068\u3001\u738b\u3068\u3057\u3066\u6226\u5834\u306b\u7acb\u3064F\u3002\u6c7a\u95d8\u306e\u672b\u3001F\u304cL\u306e\u4eee\u9762\u3092\u5265\u304c\u3057\u307e\u3059\u3002L\u306f\u7121\u8868\u60c5\u306e\u307e\u307e\u300c\u81ea\u5206\u306f\u53cd\u9006\u8005\u3068\u3057\u3066\u3053\u3053\u3067\u51e6\u5211\u3055\u308c\u308b\u300d\u3068\u601d\u3063\u3066\u3044\u307e\u3057\u305f\u3002\u3057\u304b\u3057F\u306f\u3001\u305f\u3060\u9ed9\u3063\u3066\u4e21\u8155\u3092\u5e83\u3052\u307e\u3059\u3002\u305d\u3057\u3066\u3001\u5b50\u4f9b\u306e\u9803\u304b\u3089\u4f55\u5ea6\u3082\u611f\u3058\u3066\u304d\u305f\u2015\u2015\u5144\u304b\u3089\u306e\u3001\u3042\u307e\u308a\u306b\u3082\u61d0\u304b\u3057\u3044\u62b1\u64c1\u304c\u8a2a\u308c\u307e\u3059\u3002\n\n\u3053\u306e\u6642\u306eL\u306f\u3001\u3068\u3066\u3082\u9a5a\u304d\u3001\u305d\u3057\u3066\u3069\u3053\u304b\u82e6\u3057\u3052\u306a\u8868\u60c5\u3092\u3057\u3066\u3044\u307e\u3059\u3002\n\u300c\u88cf\u5207\u3063\u305f\u306f\u305a\u306a\u306e\u306b\u3001\u50b7\u3064\u3051\u305f\u306f\u305a\u306a\u306e\u306b\u2026\u2026\u3069\u3046\u3057\u3066\u3001\u30d0\u30ab\u307f\u305f\u3044\u306b\u62b1\u304d\u3057\u3081\u308b\u3093\u3060\uff1f \u4eca\u306e\u81ea\u5206\u306f\u6575\u306a\u306e\u306b\u300d\u3068\u3001\u5fc3\u306e\u4e2d\u3067\u6238\u60d1\u3063\u3066\u3044\u308b\u3088\u3046\u306a\u96f0\u56f2\u6c17\u3067\u3059\u3002\n\nF\u306e\u8868\u60c5\u306f\u3001\u60b2\u3057\u307f\u3068\u559c\u3073\u304c\u5165\u308a\u6df7\u3058\u3063\u305f\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002\n\u6575\u306b\u6355\u3089\u3048\u3089\u308c\u3066\u884c\u65b9\u4e0d\u660e\u3060\u3063\u305f\u3001\u5927\u5207\u306a\u4eba\u2015\u2015\u305a\u3063\u3068\u6c17\u306b\u304b\u3051\u3066\u3044\u305f\u305d\u306e\u4eba\u304c\u3001\u751f\u304d\u3066\u3044\u3066\u304f\u308c\u305f\u3002\u305d\u308c\u3060\u3051\u3067\u3001F\u306b\u3068\u3063\u3066\u306f\u5341\u5206\u3067\u3057\u305f\u3002\n\u5f7c\u304c\u3053\u306e\u77ac\u9593\u306b\u62b1\u304d\u3057\u3081\u3066\u3044\u308b\u306e\u306f\u6575\u3067\u306f\u306a\u304f\u3001\u304b\u3051\u304c\u3048\u306e\u306a\u3044\u53cb\u3067\u3042\u308a\u3001\u5bb6\u65cf\u306a\u306e\u3067\u3059\u3002\n\n\u2026\u2026\u3082\u3061\u308d\u3093\u3001\u77ed\u3044\u62b1\u64c1\u306e\u3042\u3068\u3001\u3075\u305f\u308a\u306f\u307e\u305f\u6575\u540c\u58eb\u306b\u623b\u308a\u307e\u3059\u3002\nL\u306f\u4f55\u3082\u8a00\u308f\u305a\u3001\u9003\u3052\u308b\u3088\u3046\u306b\u305d\u306e\u5834\u3092\u53bb\u308b\u306e\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\n\n\u670d\u306e\u30c7\u30b6\u30a4\u30f3\u306f\u81ea\u7531\u306b\u5909\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u30dd\u30fc\u30ba\u3084\u8868\u60c5\u3082\u81ea\u7531\u3067\u3059\u3002\n\n\u6ca1\u30e9\u30d5\u3084\u4e0b\u63cf\u304d\u306a\u3069\u304c\u3042\u308c\u3070\u6b8b\u3057\u305f\u307e\u307e\u306b\u3057\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u79c1\u306e\u4f9d\u983c\u3092\u8003\u616e\u3057\u3066\u3044\u305f\u3060\u304d\u3001