\n\n2人の抱きしめるシーンをいただければ嬉しいです。構図・演出・解釈はお任せします。\n年下は包帯から顔出し希望。服装のアレンジは自由です。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1QKjoouQST3Xoa_vIL4YD4VyIlilfbxX8", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@esu_kota_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3662482, "client_id": 2424897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09337e7d/uploads/origins/22ec5472-455a-4f42-9b55-30d9ad7734e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c8758c4b00a949bb12f40aab1eb6dc0", "srcset": "https://si.imgix.net/09337e7d/uploads/origins/22ec5472-455a-4f42-9b55-30d9ad7734e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c8758c4b00a949bb12f40aab1eb6dc0, https://si.imgix.net/09337e7d/uploads/origins/22ec5472-455a-4f42-9b55-30d9ad7734e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36d08ccc449bdd81379a1c36f419989c 2x, https://si.imgix.net/09337e7d/uploads/origins/22ec5472-455a-4f42-9b55-30d9ad7734e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=662848eea2bdafdcb8bc31e77ceb9e49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09337e7d/uploads/origins/22ec5472-455a-4f42-9b55-30d9ad7734e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f261708af6c542eafaff9d35ae8b22f3", "srcset": "https://si.imgix.net/09337e7d/uploads/origins/22ec5472-455a-4f42-9b55-30d9ad7734e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f261708af6c542eafaff9d35ae8b22f3, https://si.imgix.net/09337e7d/uploads/origins/22ec5472-455a-4f42-9b55-30d9ad7734e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73f2f52334dce70f1be78904e8f7a970 2x, https://si.imgix.net/