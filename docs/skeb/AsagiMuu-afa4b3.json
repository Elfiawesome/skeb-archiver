ins/23beab31-e961-4230-b447-cc85c5fc02d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8212d87f7a6821955de631f435c31384", "srcset": "https://si.imgix.net/fd34eaba/uploads/origins/23beab31-e961-4230-b447-cc85c5fc02d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8212d87f7a6821955de631f435c31384, https://si.imgix.net/fd34eaba/uploads/origins/23beab31-e961-4230-b447-cc85c5fc02d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a724c6a5ddb26d7c49748e0e1351d38f 2x, https://si.imgix.net/fd34eaba/uploads/origins/23beab31-e961-4230-b447-cc85c5fc02d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f7020068489555df6b02bdaec02ceb0 3x"}, "body": "初めまして！！\nIRIAMで活動をしている郷月湊と申します。儚かっこいい、イラストをご依頼したくリクエストさせていただきます。\n 構図 ↓\n\n世界観の作り方が雰囲気があってとても好きだったので、無雨様のイメージで、少しの設定だけ置いておきます。\n\n顔なるべくメイン\n顔のペインティングはそのまま\n少し暴力を振るわれている\n怯えたような反抗心があるような目をしている\n\n\n服装↓\n\nはだけた部屋着\n\n背景↓\n\n暗めの部屋の中でロウソクの火の光が顔をハッキリ照らしている感じ\n\n使用用途↓\n\nサムネイル、返礼品等の商用利用\n\n透過もお願いします！\n\n私の立ち絵等参考画像\nhttps://drive.google.com/drive/folders/1VHFIbdhe0cqbUnRO7huUVKo7WXzer9Ve", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AsagiMuu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3375015, "client_id": 3055188, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b41112fcbae91c5f20876816ed6e174", "srcset": "https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b41112fcbae91c5f20876816ed6e174, https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2028f9adc3c7070f2e8780527956e5df 2x, https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f3af4458851fce39d9e361b88c01ada 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97929fcfc03633ad4d427999676532f6", "srcset": "https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97929fcfc03633ad4d427999676532f6, https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02bb25812a3f54152a6b85c3fa2f8b9d 2x, https://si.imgix.net/b1505553/uploads/origins/8140d531-3f53-4139-812e-51db8f72b479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a10b7446a0493ae647be8c20625f8a70 3x"}, "body": "はじめまして。\n浅葱無雨先生のイラストがTLで流れてきて一目惚れしてしまったので私のOCを依頼させていただきます。\n \n 〈依頼内容〉\n・キャラクターについて\n名前:鬼咲 椿珀（おにさき ちはく）\n年齢:19歳\n出身地:響界（こことは違う鬼たちの世界みたいなものです）\n誕生日:1月2日\n血液型:AB（RH-）\nキャラクター設定:\n真っ白な長髪に黒く鋭く生えた角を持つ少女。\n赤色の瞳を持ち、髪は椿の簪で纏めている。\nパッと見はキリッとしたお姉さん系美人だが、中身はただの天然で子供っぽい子。\nその実、力と術の扱いには長けていてその能力の高さ故、鬼族の長を務めている。\n当の本人はナルシストなくせに自己嫌悪を始めるめんどくさいタイプ。\n一人称は妾。他人への敬語は基本使わない。\n「〜だ。」「〜せぬ。」「〜よの。」などが語尾につく。\n座右の銘は『死んだ勝者より生きた敗者』\n本人曰く理由は、「死には次がないから無駄だ。敗北には糧があるゆえ有用だ。そこの違いが分からぬ輩は1度の勝利で何も残せぬ。」\n\n・衣装に着いて\n黒を基調として赤が含まれている和服でお願いします。\n\n・イラストイメージ\nおまかせいたします\n\n・使用用途などについて\ntrpgの立ち絵、SNS等のアイコンなど\n\n・構図\ntrpgの立ち絵に使わせていただきたいので全身絵でお願いします\n\n・サイズ\n指定はありません\n \n お忙しいなか恐れ入りますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1wrNeG7vMCGWgqO6OcACFbW9_RheYrOCM/view?usp=drivesdk", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AsagiMuu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3375015, "client_id": 3676848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29da5783e637d7648f25521464989b48", "srcset": "https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29da5783e637d7648f25521464989b48, https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6c03daf328edfdf8b24f032bc1f886b 2x, https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a9313f90daab51bd20d848d2e140a0a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54fa1bea61a2ecbe33d474282e230f61", "srcset": "https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54fa1bea61a2ecbe33d474282e230f61, https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f520ed19bbf6b865ac03b11c3fb37cbb 2x, https://si.imgix.net/7794d8c9/uploads/origins/882255da-3e53-4eb8-b08c-ea49967ad233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d79b931f69677fa1b68b62501ed9634 3x"}, "body": "はじめまして｡TLにて貴方の作品を拝見し､是非とも拙宅の子を描いて頂きたくリクエストを送らせていただきます｡\n\n〇依頼内容\n下記URLの〈荊〉をお願いいたします｡\n\nhttps://x.com/majima_san4/status/1850858492095074457?s=46&t=5ggQqV_ECII6TATabP2B7A\n\n等身資料\n\nhttps://x.com/majima_san4/status/1967529060105626092?s=46&t=5ggQqV_ECII6TATabP2B7A\n\n〇キャラデザの特徴\n･拙宅唯一の糸目くん\n･衣装は軍服をイメージ\n･狼の獣人\n･ベルトのワンポイントはめんだこ\n\n拙宅の子の中ではイケメン枠になります\n\nイメージですが､こちらをじっと見ている感じがいいです｡\n(その際に､糸目が開いていても大丈夫です)\n\n\n構図やポーズ等は全てお任せします｡\n\n\n金額等不足がありましたら､再送請求をお願いいたします｡\n\nお忙しいところ恐縮ですが､ご検討の程よろしくお願いします｡\n\nhttps://x.com/majima_san4/status/1967529060105626092?s=46&t=5ggQqV_ECII6TATabP2B7A", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AsagiMuu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3375015, "client_id": 2720944, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=033880ea83cbec510beab81244d7421c", "srcset": "https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=033880ea83cbec510beab81244d7421c, https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=466674a32c6c90243e3c4553a25874ae 2x, https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdc2adbc14c21b17ac0f9e1330ee29a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff32ad2abb80eca10a717b5895188b89", "srcset": "https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff32ad2abb80eca10a717b5895188b89, https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff84566671c752ce9e68d73a61d7754d 2x, https://si.imgix.net/67717dc4/uploads/origins/4c1ae8b4-9a82-4c6f-b94d-e2a69bfdb217?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6e38af654c7a39f57f69b62760cca6b 3x"}, "body": "こんにちは！あなたのページを偶然見つけました！\n不吉で不気味なシルエットの作品を作りたかったんだ！あなたのページと似たようなアートスタイルを見つけたので、参考にしました！\nキャラクターについては、私のキャラクターであるアストレアと彼女のクリーチャーコンパニオンを手に入れたかった！残念ながら彼女のキャラクターはチビバージョンしか持っていないので、もっと大人っぽく仕上げてください！彼女のクリーチャーの仲間に関しては、私が提供した参考画像にはこれらのクリーチャーが3体いますが、1体の方が似合うと思うのであれば、その判断はお任せします！シルエットだけでなく、アステアの体に魔法が流れ出るような緑色の輪郭線を加えてください！どんなものができるか楽しみにしています！\n\nアートスタイルとポーズの参考資料とキャラクターのリンクはこちらです。\n\nキャラクターとクリーチャー：https://drive.google.com/drive/folders/1y6_DyggXlJxPz1Yg0eicjvANzAQy4AL0?usp=sharing\n\nポーズと参考作品：https://drive.google.com/drive/folders/1-9xq1Q4eGKnXtmcJy0cPgYfObPrlUXDt?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AsagiMuu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3375015, "client_id": 2850616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af3cf35566bb48121200894ccb488423", "srcset": "https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af3cf35566bb48121200894ccb488423, https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2648388a99460c9fbdda7a48d9db39fa 2x, https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4c262f5b38b7097cbc8bc68e1519bb95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cf3daa68c09a7053e39c5b9fe79d150", "srcset": "https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cf3daa68c09a7053e39c5b9fe79d150, https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=086a0afa76e3e1f051d5b3f293d24fb1 2x, https://si.imgix.net/7f71bc71/uploads/origins/7ca3c5a7-5cd8-4ef5-9b12-3140a5193907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a26bd5b79f2b5bc0d0e3a4f320063625 3x"}, "body": "浅葱無雨/AsagiMuu様\n\n前回は素敵なイラスト、誠にありがとうございました。\n今回もご依頼したくご連絡いたしました。\nもし、ご提示しております内容につきまして、現在お受け付けされていない種類のご依頼でございましたらキャンセルをお願い致します。\n\n■ご依頼内容詳細\n動画のサムネイル等に使用するイラストの制作をお願いしたく存じます。\n楽曲は『ドゥーマー』という楽曲です。\nURL：https://youtu.be/YcO-MxPf_Vg?si=gOJ9xf11eG8_l3KP\n\n下記に具体的な要望をまとめましたので、ご確認いただけますでしょうか。\n浅葱無雨/AsagiMuu様のご負担にならない範囲でご検討いただければ幸いです。\n\n基本イメージ：私のイラスト（参考資料）をベースに、原曲が持つ世界観を浅葱無雨/AsagiMuu様の独創的な感性で表現していただきたいです。\n構図・背景：青や黒などの寒色系でお願いできますでしょうか。\n仮面の要素： イラストのどこかに仮面の要素を取り入れていただきたく存じます。 （例：仮面を装着している、顔ではなく頭部に付けている等） 表現方法につきましては、お任せいたします。\n表情・瞳の色： 仮面を装着していない場合の表情や顔立ちは、浅葱無雨/AsagiMuu様の自由な発想で描いていただけますと幸いです。瞳の色は青色でお願いできますでしょうか。\nイラストの比率： 16:9の比率で制作をお願い申し上げます。\n文字について：可能であれば、曲名をレイヤー別に追加していただけると幸いです。\nその他：仮面と髪の毛以外はキャラクターの頭身等も含め浅葱無雨/AsagiMuu様の自由な発想で描いていただけますと幸いです。\n\n■使用用途\nYouTubeでのサムネイル、配信・動画内での使用\nX（旧Twitter）などの各種SNSでの投稿・告知等\nその他、自身のVTuber活動全般における使用\n\n■納品データについて\n可能でしたらPSD形式にて、人物、背景、また文字等が含まれる場合にはそれぞれレイヤー分けしていただけますと、大変ありがたく存じます。こちらに関しましても、浅葱無雨/AsagiMuu様のご負担にならない範囲でご判断いただければと存じます。\n\n上記内容でご検討いただき、もしお受けいただけるようでしたら大変幸いに存じます。\n浅葱無雨/AsagiMuu様にご縁をいただけましたら、これ以上嬉しいことはございません。\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1CIGdZlqzpUOSynzE21vmH-3uprR0oSaR?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AsagiMuu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3375015, "client_id": 880066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e83cddab9bafde247ef5d0aa341a1e", "srcset": "https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4e83cddab9bafde247ef5d0aa341a1e, https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=845aa8552ee7ea81c17253dc82cbcbf4 2x, https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6f63b0aebd6aeacca75f1c9be46a058 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01624e55b9a23b7aaa2f0085e3187250", "srcset": "https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01624e55b9a23b7aaa2f0085e3187250, https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61fbb0cb19414dea235c73c6346c0fe7 2x, https://si.imgix.net/398a4202/uploads/origins/7b316547-fc4a-4dbc-9843-b7dc79e611f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f00e5d6aa139cb5f831be53bcbf3967 3x"}, "body": "はじめまして、こんにちは。\n素敵なイラストを描かれていたので投げさせていただきました。\nもしよろしければ私のOCを描いて頂けないでしょうか。\n\n＜依頼内容＞\n○キャラクターについて：\n一課課長：長谷川 廉\n身長：175cm\n年齢：43歳\n出生地：静岡県\n誕生日：6/6 A RH+\n所属：独立行政法人 文化遺産警保局 無形民俗遺産管理部 逝物1課\n\n長髪、薄目で細身長身と、後ろから見ると完全に女性。美しい顔立ちであるため、正面から見ても女性と間違われる。\n美月も最初間違えて接していた。旧家の出であり、とある神社の系譜と血を受け継ぐ。\nちなみに実家が茶農家もやっているので茶積みの時期は休む。茶積みが終わって戻るとその白い肌が真っ黒に日焼けしている。\nその場に漂う匂いのようなものを感知し、実際に触れることで多少の操作を行うことが可能ではあるが、逆にその効力を自身に受けたりとリスクが高い為、現場では使い捨てマスクとニトリル手袋を着用している。\n現場や周囲に漂う匂いで大体の目星をつける調査方法を主体としており、匂いの違いで今回のケースがどういったものであるかを判断することが可能。(自身の過去の経験に基づく)\n呪術系の知識に長けており、髪を伸ばしているのも呪術による対応が求められた際に必要になる場合があることから伸ばしている。\n体質として脅威の影響を受けやすいことから基本的には遠方からのサポートを主体としている。ただ必要であれば現地にも行く現場主義者。\n危険かつ人命を失う可能性がある場合、率先して自らを犠牲にする思考をしており非常に部課思い。\nあくまで目が薄いだけで、集中したりするときに大きく目を開きます。開いた目は金色の目で、黒い瞳孔は小さい。\nフェネックのような長めの耳を持ち、その見た目は遠目から見ると完全に女性。初対面の人や最初に配属される部下には間違えられることが多いが、本人はその様子が面白くて容姿を変える気は毛頭ないです。\n落ち着いた物腰で、その場の空気を読みながらふんわりと撫でるように会話をする。その話し方からか、上司からはクドクド言われ、本人はそれを受け流している。\n事務所内や業務中に感情的になることはあまりないが、怒るときには拳を出してくる武闘派。危険かつ人命を失う可能性がある場合、率先して自らを犠牲にする思考をしており非常に部下思い。\n\n○衣装について：\nスーツ姿でお願いします。\n\n◯イラストイメージ・構図・サイズ等：\nおまかせします。\n\n対応不可と言う事であればキャンセルして頂いて構いませんので、ご検討いただければと思います。\n\nhttps://drive.google.com/drive/folders/1-dxPR-_RQmyf0KDC2yrgugr2SkefkoJy?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AsagiMuu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3375015, "client_id": 3149400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b95b499179aed2affaf6b57c0db0f00", "srcset": "https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b95b499179aed2affaf6b57c0db0f00, https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2209817d06084b0e32b0af81c2a0159a 2x, https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a369089151d1381e809dd70098d306b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7495011fd4d87b7a2e304b15cc69396f", "srcset": "https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7495011fd4d87b7a2e304b15cc69396f, https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=98d718d3fd4ff9a677306d6566d761ba 2x, https://si.imgix.net/9b1539b5/uploads/origins/ce3ade97-0f2f-47ab-a021-277667b22317?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86b66ff27b56b134f44ebb0ea147ba63 3x"}, "body": "初めまして。IRIAMで配信をさせていただいております不知郡(しらずこおり)と申します。\nXでイラストを拝見し、是非とも書いていただけないかと思い連絡させて頂きました。\n簡単なイラストのイメージなのですが、キャラクターが見下ろしてるような、それも少し寂しそうな顔をしているイラストをお願いしたいです！資料の方には立ち絵を載せさせていただきます。ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1gUIvNHbLfasoTPNSrtgZu0iPleLRf6u3", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": 