\n【作品データ】\n資料URL欄に記載\n\n【気になっている点】\n・可読性の低さ\n・文字のバランス\n\n【取り入れた要素】\n・遠未来の砂漠化した地球が舞台のため、砂紋をイメージした流線\n・科学と幻想が入り混じる世界観のため、鋭い直線とやわらかい曲線を組み合わせる\n・「旅」や「終末」という世界コンセプトがあるため、骨太過ぎず少し寂しげに\n\n【目指したいイメージに近い作品】\nhttps://www.foriio.com/works/1008928\nhttps://www.foriio.com/works/1008937\nhttps://www.foriio.com/works/904130　(下段中央)\n\n金額が低い場合は再送依頼いただければそのようにいたします。それではご検討よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/3izbteovjh14bmbujftys/AMBa0HrIaYVUiF5TqABZ8cs?rlkey=y2kjmloazdk8zz14r2ucggedk&st=8kz7m0l0&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mojiasobi_typo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2555761, "client_id": 1327194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8767c4b8/uploads/origins/a0a979aa-2dea-40a9-be8e-77e4fa65d7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d923b64d81bbdf35fea77ec5893134b", "srcset": "https://si.imgix.net/8767c4b8/uploads/origins/a0a979aa-2dea-40a9-be8e-77e4fa65d7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d923b64d81bbdf35fea77ec5893134b, https://si.imgix.net/8767c4b8/uploads/origins/a0a979aa-2dea-40a9-be8e-77e4fa65d7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bcb0ea2046f7b5a5db5e1947f9f67f0 2x, https://si.imgix.net/8767c4b8/uploads/origins/a0a979aa-2dea-40a9-be8e-77e4fa65d7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c64d57fabda5f5d728de60693c5abdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8767c4b8/uploads/origins/a0a979aa-2dea-40a9-be8e-77e4fa65d7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a61fbe32a5177c693f8780a730141cee", "srcset": "https://si.imgix.net/8767c4b8/uploads/origins/a0a979aa-2dea-40a9-be8e-77e4fa65d7e0?bg=%23fff