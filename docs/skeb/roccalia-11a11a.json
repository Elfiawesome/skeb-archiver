7c-dc793391a695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0c00435987f6971abc2fb3ddfecda8", "srcset": "https://si.imgix.net/44953735/uploads/origins/c3cf82ba-0512-4dc6-8c7c-dc793391a695?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0c00435987f6971abc2fb3ddfecda8, https://si.imgix.net/44953735/uploads/origins/c3cf82ba-0512-4dc6-8c7c-dc793391a695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d62848ca6ff6f205c92759f4f8972bc2 2x, https://si.imgix.net/44953735/uploads/origins/c3cf82ba-0512-4dc6-8c7c-dc793391a695?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1244414461d510294fb47e056128ef83 3x"}, "body": "はじめまして。六菓と申します！\nMisskeyにていつも素敵なイラストを拝見しておりまして、\nこの度ご依頼をしたく、リクエストを送らせていただきました。\n\n●依頼内容\n「みーくん」という自創作のキャラクターを\"二人\"描いていただきたいです。\n一人目はオリジナルの、二人目は\"明けの金糸雀\"というパーティに属している別世界のみーくんです。\n描きにくければどちらか片方でも大丈夫です。\n\n●オリジナルのみーくんについて\n・電脳世界に生きる可愛らしい中性的な男の子\n・自由奔放で明るく、元気いっぱい\n・電脳世界を魚のように泳ぎ、くるくると回ったり、跳ねたりと自由に過ごしている\n・肌八重歯がチャームポイント\n\n●明けの金糸雀のみーくんについて\n・ファンタジー世界に生きるアンドロイドの男の子\n・オリジナルのみーくんより少年っぽい雰囲気\n・明るく元気なトラブルメーカーでありムードメーカー\n\n装飾や小物は省略・改変していただいて構いません。\n\n●資料\n・オリジナルみーくん三面図\nhttps://drive.google.com/file/d/1kCfRsd1mFY1rVF9yZzi94pJzOTYPuag4/view?usp=sharing\n・オリジナルみーくん_装飾・小物\nhttps://drive.google.com/file/d/1KYMDVwKO8g3pz6qi2rM_DPrYNH3K0AA7/view?usp=sharing\n・明けの金糸雀みーくん立ち絵\nhttps://drive.google.com/file/d/1q1F86Mh-wdb91qNRtTKD9qXGKpeUbsXu/view?usp=sharing\n・みーくんの顔まわりの装飾について\nhttps://drive.google.com/file/d/1-fgrxofiH3LGN3Bv8rQEKszNESOmXhmb/view?usp=sharing\n\n●使用用途\n・PCやスマホの壁紙として\n・Misskey他SNSにて描いていただいた報告をする目的でのアップロード\n・非営利目的の個人観賞用のグッズ制作\n\nぜひご検討いただければと思います。よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wata_post0_/works/158", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1612326, "client_id": 2775133, 