ix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3192a059f9d9b0b221ad9d5cc3b0dfc3", "srcset": "https://si.imgix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3192a059f9d9b0b221ad9d5cc3b0dfc3, https://si.imgix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=705cad9b4529ccb5ec89114f957e3586 2x, https://si.imgix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7017be5dd0f94e0a879dbf6ef47ef99d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a40a6013478969ef7d868dc5ad8b3f3", "srcset": "https://si.imgix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a40a6013478969ef7d868dc5ad8b3f3, https://si.imgix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1871a03dbed823b2f9837eef5cd1aa3 2x, https://si.imgix.net/e1195443/uploads/origins/c8c8663d-ad74-4a7b-920d-ceb4d85869ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bb641d760c73163775f145e443d6deb 3x"}, "body": "Rデコさん、こんにちは！いつも創作楽しく見ております🎶もしよければ、こちらのOCを描いていただけませんか？\n\n▼資料（2人とも200cm超えの大男です）\nhttps://drive.google.com/drive/folders/1G0920QYYO4ltrcE8QkMgqeadyeggXTfi\n\nシチュエーションや服装の指定は特にありませんが、強いて言えば黒い人が青い人にイラついてると嬉しいです……\n\n黒い人のタトゥーは省略してもらってもOKです！（服で隠しても全然オッケーです）服装などは改造してもらって大丈夫なので、お好きなように描いていただけたらと思いま