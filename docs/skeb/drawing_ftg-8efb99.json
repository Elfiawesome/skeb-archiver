mgix.net/93b36d0b/uploads/origins/5955e92d-9384-4341-8aee-8b5d94d77a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49a39356efbecd45c2b199fdeb272976 2x, https://si.imgix.net/93b36d0b/uploads/origins/5955e92d-9384-4341-8aee-8b5d94d77a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7d7bcf6a2ac4e5ec864440b4451d9af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93b36d0b/uploads/origins/5955e92d-9384-4341-8aee-8b5d94d77a33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5091faf8844fe167039e44793b56d980", "srcset": "https://si.imgix.net/93b36d0b/uploads/origins/5955e92d-9384-4341-8aee-8b5d94d77a33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5091faf8844fe167039e44793b56d980, https://si.imgix.net/93b36d0b/uploads/origins/5955e92d-9384-4341-8aee-8b5d94d77a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c043cb31004c214ae519f6be816f10f5 2x, https://si.imgix.net/93b36d0b/uploads/origins/5955e92d-9384-4341-8aee-8b5d94d77a33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5bb4a092f1b7c330ae2b3eb4dfc53fd 3x"}, "body": "こんにちは。お世話になってます。\n前回に引き続き、P名刺に使用するイラストをお願いしたいです。\nつきましては、以下の通り依頼内容を記載させていただきます。\n\n\n\nキャラクター：\n「アイドルマスター」より、「秋月律子」\n\n\nサイズ：\nサイズに指定はありませんが、縦横比については、正方形に近い形もしくは少し横長でお願いできればと思います。\n\n\n服装、衣装：\n資料動画にて着用している衣装「スモールステップ・ライフ」でお願いします。\n髪型・眼鏡についても、資料動画のデザインに近い形だと嬉しいです。\n\n\nポーズ、構図など：\n細かいポーズや構図についてはお任せしたいのですが、小さく印刷する都合上、アップめにお願いします。\n具体的には、仮に資料そのままの頭身でまっすぐ立った場合、髪の頂点から腰あたりまでが入るくらいの距離感です。\n\n\nイメージ、コンセプトなど：\nぼやけた伝え方で大変恐縮ですが、精一杯ニュアンスをお伝えします。\n\n・カッコよくキメた感じでお願いします。\n・カッコよさの方向性としては、理知的でクールなイメージです。ラグナよりはジン、ノエルよりツバキみたいな感じです。\n・平場の立ち姿ではなく、ステージ上で振りとしてポーズを取っているまたは動いているイメージです。\n・カメラ目線でなくても構いません。\n\n背景：\n透過でお願いします。\n\n\nその他指定：\n・\n・セクシーな表現は抑え目、もしくは控えて頂けると幸いです。\n\n\n\n資料URL：https://youtu.be/801nsXXbnGc?si=N7ssoLDLIcaj5L2l\n\n\n指定、要望が多く非常にご負担の多い内容になってしまい、大変恐縮ではございますが、どうか宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@drawing_ftg/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1926973, "client_id": 2194379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa6bb6beab155154615745ad54d2bd57", "srcset": "https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa6bb6beab155154615745ad54d2bd57, https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=070e74ca81bfb8a835636d1701b55388 2x, https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c6a3de92199fa07b093cb596e79aa619 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ede40f13a055053a232dbf2102c1a36a", "srcset": "https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ede40f13a055053a232dbf2102c1a36a, https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2296f2584f15046f1b74b66fab0ad22 2x, https://si.imgix.net/0a927a5f/uploads/origins/4f567771-b6ef-4de6-aae0-8f81d7926cdd?bg=%23fff&