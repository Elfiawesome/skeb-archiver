f4b9037-860c-4c5b-a88e-a2cee4ba8158?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=219e0a42f9ca6b24f92717d1eb44f51b 3x"}, "body": "こんにちは、私の申請を受け入れてくださりありがとうございます。こちらが私のキャラクターで、青みがかった青い犬です。これまでの作風で描いていただき、少しぽっちゃりして可愛らしく描いていただけると嬉しいです。横長の構図で、キャラクターの全身が見えるようにしてください。白いシャツにネクタイを着て、布団をかけずにベッドで寝ています。シャツがめくれ上がり、ぽっこりしたお腹が見えています。頭を少し傾け、口元からよだれが垂れています。手足の裏の肉球が見え、ベッドのそばにはスマホやおやつが散らばり、仕事から帰宅したキャラクターが疲れながらも眠りの中でリラックスしている様子を表現してください。以下の2つのリンクから私のキャラクターについてご確認いただけます。ご制作を楽しみにしております！\nhttps://drive.google.com/file/d/1Vf3xw0KoWxAlUGtQinoK6W5J5cZj5IMJ/view?usp=sharinghttps://drive.google.com/file/d/12UcGwd17bDJwDJUI9JKkoSJMk1z8K4dT/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@musuti22/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3839270, "client_id": 3470161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62da4880d87ad7b55a3409ed396f4645", "srcset": "https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=62da4880d87ad7b55a3409ed396f4645, https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bbc4281f8becf4292fff9fde6eb677b 2x, https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68e0a8767f12aa9231004eb8dcaadb3c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0df220e369c4d304080a40920647fcf", "srcset": "https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0df220e369c4d304080a40920647fcf, https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ae7f12885c90293f9f07fa001e1e044 2x, https://si.imgix.net/c1247236/uploads/origins/2d05cecb-942c-4b5a-89a1-a76d99524614?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56703f1a493888ea3808b36ed3fa1ca2 3x"}, "body": "ムスティーさん、こんにちは。あなたの作品、本当に大好きです。2人のキャラクターを一緒に描いてほしいです。名前はオーム（白、黒、黄色の狼）とゼヴリム（白、青、黒の悪魔狼）です。2人がシャツを捲り上げながら、お腹を擦り合わせている様子を描いてください。 体型は、コダジーが描かれている作品（https://x.com/musuti22/status/1938220765369012683）のスタイルがとても気に入っています。両キャラクターともこの体型でお願いしたいです。表情は、オームはコダジーのように赤面しながらも微笑んでいる様子で。 ゼヴリムは慌てふためき、片手でシャツを引っ張り上げながらもう片方の手で股間を隠す様子です。ゼヴリムの股間はふわふわにしてください！可能であれば、ゼヴリムのそばかすは描かないでください。以下がキャラクターリファレンスです。リファレンスシートの筋肉質な体型は無視してください。よろしくお願いします！ぜひコミッションをお受けいただけますと幸いです。\n\n参考リンク: https://drive.google.com/drive/folders/1VoJuwYUKpBJ4Wzp3wuw-ytHhnv7xFAG3?usp=sharing https://drive.google.com/drive/folders/1VoJuwYUKpBJ4Wzp3wuw-ytHhnv7xFAG3?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@musuti22/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3839270, "client_id": 2681991, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d208d5ae/uploads/origins/120de296-b747-4317-98a8-4b8027513098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de9c3498575f6041d1ead6fc23c7b82", "srcset": "https://si.imgix.net/d208d5ae/uploads/origins/120de296-b747-4317-98a8-4b8027513098?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d