5c0f\u3055\u3044\u307e\u307e\u958b\u304d\u307e\u305b\u3093\u3002\n\u9aea\u578b\u306f\u5f8c\u308d\u306b\u6d41\u3057\u3066\u3044\u308b\u3060\u3051\u3067\u7e1b\u3063\u3066\u306f\u3044\u307e\u305b\u3093\u3002\u6bba\u4eba\u3092\u72af\u3059\u6642\u306f\u6016\u304f\u898b\u3048\u308b\u53f3\u76ee\u3092\u5f37\u8abf\u3057\u3001\u4ed5\u4e8b\u6642\u306f\u512a\u3057\u304f\u898b\u3048\u308b\u5de6\u76ee\u3092\u5f37\u8abf\u51fa\u6765\u308b\u3088\u3046\u53cd\u8ee2\u3057\u305f\u524d\u9aea\u306b\u3057\u307e\u3059\u3002\n\u666e\u6bb5\u306f\u3001\u30cf\u30f3\u30c1\u30f3\u30b0\u5e3d\u3084\u30cf\u30c3\u30c8\u3092\u88ab\u3063\u305f\u308a\u30b9\u30fc\u30c4\u59ff\u3060\u3063\u305f\u308a\u30b3\u30fc\u30c8\u3092\u7740\u3066\u3044\u305f\u308a\u8272\u3093\u306a\u683c\u597d\u3067\u3059\u3002\u30b7\u30e3\u30c4\u3060\u3051\u306e\u6642\u3082\u3042\u308a\u307e\u3059\uff01\n(1920\u5e74\u306e\u30ed\u30f3\u30c9\u30f3\u306e\u670d\u88c5\u306f\u53c2\u8003\u753b\u50cf\u7b49\u3054\u89a7\u4e0b\u3055\u3044\uff01)\n\n\u300a\u7279\u5fb4\u300b\u60aa\u5f79\u3002\n1920\u5e74\u306e\u30ed\u30f3\u30c9\u30f3\u306e\u65b0\u805e\u8a18\u8005\u3002\u30ab\u30e1\u30e9\u304c\u8da3\u5473\u3002\n\u6bba\u4eba\u3092\u72af\u3057\u81ea\u8eab\u3067\u305d\u308c\u3092\u8a18\u4e8b\u306b\u3059\u308b\u624b\u6cd5\u3067\u300e\u30b8\u30e3\u30c3\u30af\u30b6\u30ea\u30c3\u30d1\u30fc\u518d\u6765\u300f\u3068\u79f0\u3057\u5287\u5834\u578b\u72af\u7f6a\u3092\u884c\u3044\u307e\u3057\u305f\u3002\u4f7f\u7528\u3057\u305f\u51f6\u5668\u306f\u30d0\u30bf\u30d5\u30e9\u30a4\u30ca\u30a4\u30d5\u3067\u3059\u3002\n\u6c11\u8846\u3092\u6247\u52d5\u3057\u3066\u4e0b\u3089\u306a\u3044\u5927\u72c2\u9a12\u3092\u8d77\u3053\u3057\u305f\u3044\u304c\u305f\u3081\u3060\u3051\u306b\u3084\u3063\u3066\u307e\u3059\u3002\n\u81ea\u8eab\u306e\u982d\u8133\u3092\u8a87\u3063\u3066\u304a\u308a\u3001\u6bba\u4eba\u73fe\u5834\u306b\u6b8b\u3057\u305f\u6697\u53f7\u3068\u81ea\u8eab\u306e\u8a18\u4e8b\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u6b21\u306e\u6bba\u4eba\u73fe\u5834