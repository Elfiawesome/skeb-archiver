格は自由で、ちょっと腹黒いところがあって、時々恋人を苛める。\nキャラクターB（目の色が違う）\nカジノでバイトしているフリーター。犬系男子、甘えることが好き。恋人に対して病態な執着心を持つ。\n\n二人は二年前からずっと付き合っている恋人、今は同棲中です。\n\n特に指定したいものはないので、先生が自由に描いてください。\n\nご検討宜しくお願い致します。\n金額が足りない場合、再送要請をお願い致します。\nリクエストを読んでいただき、ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1_xdT1iUbjpI_xFGmADZLM5v_9uyVImji?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anohi_moicido/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3461117, "client_id": 2956173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96d2fc82/uploads/origins/eee7a4b7-da84-429b-9cd8-3e2b9a47669d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0117c68fff61178d0184b3b765c1d140", "srcset": "https://si.imgix.net/96d2fc82/uploads/origins/eee7a4b7-da84-429b-9cd8-3e2b9a47669d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0117c68fff61178d0184b3b765c1d140, https://si.imgix.net/96d2fc82/uploads/origins/eee7a4b7-da84-429b-9cd8-3e2b9a47669d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deb4c123c43fdb812468ab1fca871485 2x, https://si.imgix.net/96d2fc82/uploads/origins/eee7a4b7-da84-429b-9cd8-3e2b9a47669d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ae2f6e2eaa105f74237f0d4047fa845 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96d2fc82/uploads/origins/eee7a4b7-da84-429b-9cd8-3e2b9a47669d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99d2f93dfb7b83a37ead5b891fe5918c", "srcset": "https://si.imgix.net/96d2fc82/uploads/origins/eee7a4b7-da84-429b-9cd8-3e2b9a47669d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99d2f93dfb7b83a37ead5b891fe5918c, https://si.imgix.net/96d2fc82/uploads/origins/eee7a4b7-da84-429b-9c