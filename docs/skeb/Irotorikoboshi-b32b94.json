3089\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u304f\u308c\u308b\u3068\u5b09\u3057\u304f\u3066\u6b7b\u306c\u3002\n\u524d\u63cf\u3044\u3066\u304f\u308c\u305f\u4e38\u67a0\u5ec3\u5b50\u3055\u3093\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u30a2\u30c3\u30d7\u7248\u306e\u30a4\u30e1\u30fc\u30b8\u304b\u306a\uff1f\n\u30ea\u30dc\u30f3\u306f\u30d6\u30e9\u30a6\u30b9(\u751f\u6210\u308a)\u304b\u9aea\u306e\u30ea\u30dc\u30f3(\u6697\u3081\u306e\u8d64)\u3068\u540c\u8272\u3067\u3001\u30b9\u30ab\u30fc\u30c8\u3082\u3057\u5165\u308c\u308b\u306a\u3089\u30d9\u30b9\u30c8(\u8336)\u3068\u540c\u3058\u304b\u305d\u308c\u3088\u308a\u5c11\u3057\u6697\u3081\u306e\u8336\u3067\u3059\uff01\u30d9\u30b9\u30c8\u306e\u30dc\u30bf\u30f3\u306f\u91d1\u30dc\u30bf\u30f3\u3067\u3082\u3044\u3044\u3057\u30d9\u30b9\u30c8\u3068\u5171\u5e03\u306e\u304f\u308b\u307f\u30dc\u30bf\u30f3\u307f\u305f\u3044\u306a\u3084\u3064\u3067\u3082OK\u3001\u5de6\u80f8\u306b\u306f\u30dd\u30b1\u30c3\u30c8\u304c\u3042\u3063\u3066\u91d1\u306e\u61d0\u4e2d\u6642\u8a08\u5165\u308c\u3066\u307e\u3059\u306d\u3001\u3058\u3063\u3061\u3083\u306e\u5f62\u898b\u306a\u306e\u3067\u3059\u3054\u304f\u5927\u4e8b\u306b\u3057\u3066\u308b\u3084\u3064\u3002\n\u9aea\u3068\u76ee\u306e\u8272\u306f\u524d\u306b\u3082\u8a00\u3063\u305f\u304b\u3082\u3060\u3051\u3069\u3001\u9aea\u304c\u67d4\u3089\u304b\u8336\u9aea(\u3044\u3064\u3082\u63cf\u3044\u3066\u304f\u308c\u3066\u308b\u611f\u3058\u3067\u5927\u4e08\u592b)\u3067\u3001\u5411\u304b\u3063\u3066\u53f3\u76ee\u304c\u7dd1\u8336\u307f\u305f\u3044\u306a\u7dd1\u76ee\u3001\u5de6\u76ee\u304c\u5149\u306b\u900f\u304b\u3057\u305f\u30b9\u30c8\u30ec\u30fc\u30c8\u306e\u7d05\u8336\u307f\u305f\u3044\u306a\u8d64\u8336\u8272\u3067\u3059\u3002\n\n\u4f7f\u7528\u7bc4\u56f2\u306fTwitter\u306e\u8868\u57a2\u306e\u30a2\u30a4\u30b3\u30f3\u3068\u3001\u3046\u3061\u306e\u5b50\u30d7\u30ec\u30a4\u30ea\u30b9\u30c8\u306e\u30ab\u30d0\u30fc\u753b\u50cf\u3092\u8003\u3048\u3066\u307e\u3059\u3002\u4ed6\u306b\u3082\u500b\u4eba\u7684\u306b\u4f7f\u7528\u3059\u308b\