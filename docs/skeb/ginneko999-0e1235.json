net/1ef7ab47/uploads/origins/34999319-071b-4c0a-a7da-cb063f49fac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=400822d55e8051e3a7e1483a53f6939f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ef7ab47/uploads/origins/34999319-071b-4c0a-a7da-cb063f49fac1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c4c933e91ce394e8ea487c1e5597443", "srcset": "https://si.imgix.net/1ef7ab47/uploads/origins/34999319-071b-4c0a-a7da-cb063f49fac1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c4c933e91ce394e8ea487c1e5597443, https://si.imgix.net/1ef7ab47/uploads/origins/34999319-071b-4c0a-a7da-cb063f49fac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07ca9fde8bfb8058d6791f9d5048ea33 2x, https://si.imgix.net/1ef7ab47/uploads/origins/34999319-071b-4c0a-a7da-cb063f49fac1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9d99355676ca56b361a26ed1a3edcfa 3x"}, "body": "おっぱい最高だったので可能な範囲でお願いします！\n優先は着衣超乳&着衣ボテ腹で、スライム要素は無視でも構いません。\n\n作品名：スライム倒して３００年、知らないうちにレベルＭＡＸになってました\nキャラ名：アズサ、ペコラ\nシチュ：\nスライムに寄生・苗床にされた着衣超乳&着衣ボテ腹姿の二人にゴミを見るような冷めた目(顔の上部や目元まで影がかかる感じでハイライトなし希望)で嫌悪・侮蔑されながら、二人がそれぞれ持っているスライム満タンの巨大注射器を見せつけられるドMホイホイシチュ。\n身長はアズサ＞ペコラのような感じでアズサの方が外見年齢年上といった感じでお願いします。\n\n注射器内は高粘度の半透明スライム(アズサは青色、ペコラは紫色)で充填されており、注射器の先端からスライムが溢れている他、\n二人それぞれも耳の中やスカートの下からスライムが零れている寄生・洗脳要素を加えて頂ければ幸いです。\nまた背景は青色と紫色のスライムに満たされた感じか、それが難しいようでしたら単色やグラデーションでも構いませんのでダーク系背景にして頂ければ幸いです。\n\n二人とも手が簡単に沈む程で顔以上のサイズかつ服の上からでも乳首(もし透け乳首表現ありの場合は乳首はピンク色を希望します)が立っているのがわかる感じの着衣超乳&特大着衣ボテ腹で、\n服に関しては超乳とボテ腹がギチギチに詰められたようなボテ腹用に調整して頂いて構いませんので、肌は服で隠れてしまっている様子でお願いします。\nまた着衣ボテ腹内部は粘液まみれの大量のスライムを孕んだようなイメージで、下腹部に怪しく光る淫紋の描写を希望します。\nまたこちらは可能ならで構いませんが乳首の位置から母乳代わりにスライムが服越しに溢れているような描写が予算的に可能でしたらお願いします(優先度低)。\n\nまた可能でしたらpsd形式でON/OFFで切り替えられる形式で二人の瞳のハイライトの有無、\n注射器内で蠢くスライムの水音やスカート下から零れているスライムが蠢く効果音の有無差分を入れて頂ければ幸いです。\n\n予算やシチュ的に採用可能な範囲で構いませんので何卒宜しくお願い致します。\n\nアズサ、ペコラ参考：https://imgur.com/a/Cj6WFsZ\nシチュ参考：\n\nhttps://www.pixiv.net/artworks/79015867", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 47190, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "メルデス🔞Skeb依頼募集中🦀", "screen_name": "merudesukiki", "avatar_url": "https://pbs.twimg.com/profile_images/2002525169836044293/IzZsX8Ib.jpg", "header_url": "https://pbs.twimg.com/profile_banners/364198563/1737157666/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 177}, {"id": 91492, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "dorachan@C107火曜東U-16a", "screen_name": "dorachan_r", "avatar_url": "https://pbs.twimg.com/profile_images/1261664174607753217/zyKYTYKN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/946796859388985344/1653702115/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 641873, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "朱身つめ🔞", "screen_name": "akemitsume", "avatar_url": "https://pbs.twimg.com/profile_images/2030157615897137155/MSZzNfej.png", "header_url": "https://pbs.twimg.com/profile_banners/1293938823286501376/1721172118/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "comi