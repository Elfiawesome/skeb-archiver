a10b-1d4e8c8c35bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8162e166825b657b9535f34c2aea7b0f, https://si.imgix.net/186a0b2d/uploads/origins/4f2fe842-5a41-4e2a-a10b-1d4e8c8c35bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfe924a3bd82e2ab6775548fe99ece93 2x, https://si.imgix.net/186a0b2d/uploads/origins/4f2fe842-5a41-4e2a-a10b-1d4e8c8c35bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5303e7aeb909ff24e574f00e405b6b2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/186a0b2d/uploads/origins/4f2fe842-5a41-4e2a-a10b-1d4e8c8c35bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c872ad3cd96b790c404b9c7ab5a8c209", "srcset": "https://si.imgix.net/186a0b2d/uploads/origins/4f2fe842-5a41-4e2a-a10b-1d4e8c8c35bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c872ad3cd96b790c404b9c7ab5a8c209, https://si.imgix.net/186a0b2d/uploads/origins/4f2fe842-5a41-4e2a-a10b-1d4e8c8c35bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa49fdc8e277a2748123d622abd73e51 2x, https://si.imgix.net/186a0b2d/uploads/origins/4f2fe842-5a41-4e2a-a10b-1d4e8c8c35bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4258af0928a3a77c93e48f9f86c55b2b 3x"}, "body": "あいさんこんばんわ。毎回無茶苦茶なリクエストに素晴らしすぎるイラストでお応えくださり、本当にありがとうございます!!\n今回は当初、燕青×ぐだ子でお願いする気マンマンだったんですが…あんなゲス顔らんらん×面食いえんえん見せられましたら…orz\nすみません！毎月3日の「あいさんほも描き読みDAY」を利用して、ダダ漏れ脳内妄想シチュリクエストさせてください!!!!\nドSゲス顔のらんらんと、そんならんらんの床上手っぷりに完堕ちしたアヘトロえんえんくんを！をねがいいたします!!!!\n\nキャラ：蘭陵王×燕青（『Fate/GrandOrder』）\n体形：2人ともあいさんの描かれる体型でお願いします。腋毛や下の毛だけは無毛でお願いします。\n表情：\n蘭陵王→ドSゲス顔 頬は紅潮\n燕青→らんらんのゲスな一面と見事な床上手っぷりに、完全に快楽堕ちしたアヘトロ顔\n服装：2人とも全裸\n擬音・セリフ：おまかせします。なくてもOKです。\nもし可能であれば、擬音は乳揺れ音・腰振り音\nセリフは、\n蘭陵王→最初は冷静な感じ 徐々に燕青を軽く言葉攻めしていく、どSな感じのセリフ\n燕青→らんらんの名前を呼びつつ、感じまくったアヘ声嬌声を口にしまくっている\n体位：後背位\nシチュエーション：\nベッドの縁に腰かけたらんらんが、燕青を膝にのせつつ鬼ピストンをキメている\n燕青は両手を頭の上に高く上げて、ロープで吊るされているような自由を奪われた体勢 燕青の両手首は、らんらんが片手でつかんでいる\nらんらんは残りの手で燕青の乳首をいじっていて、燕青は自由を奪われた背徳的な体勢と、らんらんからの強烈な快感に酔いしれて、\nアヘトロ以外の意識はブッとんでおり、らんらんの鬼ピストンで勃起チンコからトコロテン射精している\n\n今回も指定が細かく申し訳ございませんm(_ _)mぜひよろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ddt_lark/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 555651, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6151a830/uploads/origins/81e6710e-58a2-4b1e-a5d3-b6845c5f5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d417e793dd989e785be50fcbdb4766cc", "srcset": "https://si.imgix.net/6151a830/uploads/origins/81e6710e-58a2-4b1e-a5d3-b6845c5f5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d417e793dd989e785be50fcbdb4766cc, https://si.imgix.net/6151a830/uploads/origins/81e6710e-58a2-4b1e-a5d3-b6845c5f5066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d650b0a6f9888456ccf3c207d7099357 2x, https://si.imgix.net/6151a830/uploads/origins/81e6710e-58a2-4b1e-a5d3-b6845c5f5066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=532e1d641148166108eaac79e66f08fa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6151a830/uploads/origins/81e6710e-58a2-4b1e-a5d3-b6845c5f5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2269a043cfee61bddaa3c1866ad2340", "srcset": "https://si.imgix.net/6151a830/uploads/origins/81e6710e-58a2-4b1e-a5d3-b6845c5f5066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2269a043cfee61bddaa3c1866ad2340, https://si.imgix.net/6151a830/uploads/origins/81e6710e-58a2-4b1e-a5d3-b6845c5f5066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200