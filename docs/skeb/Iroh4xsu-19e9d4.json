抜いたら大変申し訳ないのですが、夢絵ぽいのを描いて頂きたいです。\n絵を見ているこちらが尻もちを着いたような低い目線状態で見上げていて、左手の薬指に指輪を付けた霧島改二丙と村雨改二が中腰になったりして目線を低い姿勢のこちら側に近づけているような構図でお願いしたいです。\nその状態で、喧嘩をしている様子ではなく「今日はどっちを選ぶの？」と見つめられていたり手を伸ばされているようなのを描いて欲しいです。\n\n細かい注文、わかりにくい内容ですが紅芭さんの絵柄でのうちのお嫁艦を見せてください……！\n\n限界オタクすぎて画力が伴わない構図参考を置きますが、こうでなくてもいいです！紅芭さんの素敵な描きやすい世界がありましたら見せてほしいです。よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1oQOpZ3hl9LLPTHvLxHPRMFf9hsjxW3b3/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Iroh4xsu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3195368, "client_id": 502537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7227d936772d7878b18f57e3a0ea38cb", "srcset": "https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7227d936772d7878b18f57e3a0ea38cb, https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf7ae3dcb8bc24ed8b8d7d21710622d8 2x, https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05886c412e918459345dd8d1da08e41f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34f3ad0ff20b96b3a0af251c7b9f2a23", "srcset": "https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34f3ad0ff20