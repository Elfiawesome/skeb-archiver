t=crop&crop=top&w=200&h=200&blur=200&s=ba62ed15e0c1fa9c9d27bd44007b6d0b, https://si.imgix.net/8238e44b/uploads/origins/b3ea2b52-15bb-43cc-aad8-5a915e534400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=390978cd44e9d96d95d588800db4e036 2x, https://si.imgix.net/8238e44b/uploads/origins/b3ea2b52-15bb-43cc-aad8-5a915e534400?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80c53e543c2b8e1c6d2160c4e862cd5c 3x"}, "body": "紅笆さんこんにちは。飛び石と申します。\nいつも楽しくイラストを拝見しております。\n今回、艦隊これくしょんの霧島さんでイラストをお願いしたく、依頼を送ります。\n描いて欲しい内容は以下の通りです\n◯キャラクター:艦隊これくしょんの霧島さん\n◯シチュエーション:カラオケボックスでストレス発散の為にマイクを握りしめて熱唱している霧島さん\n◯服装、構図の指定はありませんので、紅笆さんの好きに描いていただいて構いません。また、背景も無しで構いません\n◯普段理知的な霧島さんが歌う時だけは羽目を外して、全力で歌ってるシチュエーションを紅笆さんの絵柄で見たいため、ご検討いただけましたら幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Iroh4xsu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3195368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026a49630d8792bd16bbd754cccb00ba", "srcset": "https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026a49630d8792bd16bbd754cccb00ba, https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86d7ac7bb4a3433a8b632c6312681d46 2x, https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40f896623a7fc7a4fe8ebaad3bd307eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd96b4672cfb867474086bcbf08eb53e", "srcset": "https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd96b4672cfb867474086bcbf08eb53e, https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cde68b5515e83266662615857a79dd2 2x, https://si.imgix.net/8e2e6747/uploads/origins/8802c9aa-d962-47b6-8599-4148617cbe21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f78c4e6856af1844b3028c5b64a2b7e 3x"}, "body": "いつも楽しくイラストを拝見させて頂いています。霧島合同もとても楽しみに待っています！\n\n地雷を踏み抜いたら大変申し訳ないのですが、夢絵ぽいのを描いて頂きたいです。\n絵を見ているこちらが尻もちを着いたような低い目線状態で見上げていて、左手の薬指に指輪を付けた霧島改二丙と村雨改二が中腰になったりして目線を低い姿勢のこちら側に近づけているような構図でお願いしたいです。\nその状態で、喧嘩をしている様子ではなく「今日はどっちを選ぶの？」と見つめられていたり手を伸ばされているようなのを描いて欲しいです。\n\n細かい注文、わかりにくい内容ですが紅芭さんの絵柄でのうちのお嫁艦を見せてください……！\n\n限界オタクすぎて画力が伴わない構図参考を置きますが、こうでなくてもいいです！紅芭さんの素敵な描きやすい世界がありましたら見せてほしいです。よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1oQOpZ3hl9LLPTHvLxHPRMFf9hsjxW3b3/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Iroh4xsu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3195368, "client_id": 502537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7227d936772d7878b18f57e3a0ea38cb", "srcset": "https://si.imgix.net/17b86069/uploads/origins/8ac1de23-b14c-4de6-9e12-6cc370b1850e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7227d936772d7878b18f57e3a0ea38cb, https://si.imgix.net/1