uff01\n\u7d20\u6575\u306a\u7d75\u3092\u63cf\u304b\u308c\u308b\u306a\uff5e\u3068\u601d\u3063\u305f\u306e\u3067\u662f\u975e\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002  \n\u4e88\u7b97\u306e\u90fd\u5408\u3067\u63a7\u3048\u3081\u306a\u91d1\u984d\u3067\u63d0\u793a\u3055\u305b\u3066\u3044\u305f\u3060\u3044\u3066\u3044\u308b\u306e\u3067\u3001\u898b\u5408\u308f\u306a\u3044\u3068\u611f\u3058\u3089\u308c\u307e\u3057\u305f\u3089\u3054\u9060\u616e\u306a\u304f\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u3066\u304f\u3060\u3055\u3044\u3002       \n\n\u25c6\u30ad\u30e3\u30e9\u8a2d\u5b9a\n\u524d\u63d0\uff1a\n\u30fb\u300cVOID\u300d\u3068\u3044\u3046\u30b7\u30ca\u30ea\u30aa\u3092\u904a\u3076\u305f\u3081\u306b\u4f5c\u3063\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3067\u3001\u8fd1\u672a\u6765SF\u306e\u4e16\u754c\u89b3\u3067\u3059\u3002\n\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9\u304c\u5b9f\u7528\u5316\u3055\u308c\u3001\u69d8\u3005\u306a\u5834\u9762\u3067\u6d3b\u7528\u3055\u308c\u3066\u3044\u3066\u3001\u751f\u6d3b\u306b\u6eb6\u3051\u8fbc\u3093\u3067\u3044\u308b\u4e16\u754c\u3067\u3059\u3002\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u305f\u3061\u306f\u3001\u5211\u4e8b\u3068\u3057\u3066\u3001\u4eba\u9593\u3068\u30a2\u30f3\u30c9\u30ed\u30a4\u30c9\u3067\u30d0\u30c7\u30a3\u3092\u7d44\u307e\u3055\u308c\u3066\u3044\u307e\u3059\u3002\n\n\n\u30fbHO1 \u4fdd\u5fd7 \u6717\u4e5f\n22\u6b73/\u7537\u6027/\u4eba\u9593\u30fb\u65b0\u7c73\u5211\u4e8b\n\u81ea\u5206\u304c\u512a\u79c0\u3060\u3068\u81ea\u899a\u3057\u3001\u3084\u3084\u50b2\u6162\u306a\u6027\u683c\u3067\u30b9\u30c8\u30ec\u30fc\u30c8\u306a\u7269\u8a00\u3044\u3092\u3059\u308b\u5b50\n\u6c34\u6708\uff08\u5f8c\u8ff0\uff09\u306b\u5bfe\u3057\u3066\u3001\u7247\u601d\u3044\u3092\u3057\u3066\u3044\u3066\u3001\n\u6c34\u6708\u306e\u7121\u90aa\u6c17\u306a\u884c\u52d5\u306b\u5bfe\u3057\u3066\u6319\u52d5\u4e0d\u5be9\u306b\u306a\u308b\u6642\u304c\u3042\u308b\u3002\n\u65e5\u672c\u5200\u3067\u6226\u3046\u3002\n\n\u30fbHO2\u3000\u6c34\u6708\n\u65b0\u578b\u30a2\u30f3\u30