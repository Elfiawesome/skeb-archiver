068\u7533\u3057\u307e\u3059\uff01\uff01\n\n\u3042\u3066\u304a\u3093\u3055\u3093\u306e\u30a4\u30e9\u30b9\u30c8\u304cRP\u3067\u6d41\u308c\u3066\u304d\u305f\u308a\u3001\n\u77e5\u3063\u3066\u3044\u308bPNGTuber\u3055\u3093\u306e\u7d75\u3092\u3042\u3066\u304a\u3093\u3055\u3093\u304c\u624b\u639b\u3051\u3089\u308c\u3066\u304a\u308a\u3001\n\u305c\u3072\u3042\u3066\u304a\u3093\u3055\u3093\u306b\u30a4\u30eb\u30af\u3082\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3068\u601d\u3044\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u304a\u9001\u308a\u3057\u307e\u3057\u305f\ud83d\ude4f\n\n\u3010\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3011Vtuber\uff1a\u685c\u96c5 \u30a4\u30eb\u30af\uff08\u7adc\u3068\u72fc\u306e\u30cf\u30fc\u30d5\uff09\n\u3010\u30ad\u30e3\u30e9\u306e\u7279\u5fb4\u3011\u5de6\u8033\u306e\u307f\u98fe\u308a\u6bdb\u3067\u5782\u308c\u6c17\u5473\u3001\u76ee\u306f\u30b8\u30c8\u76ee\u6c17\u5473\u3001\u624b\u306f4\u672c\u6307\n\u3010\u30ad\u30e3\u30e9\u306e\u6027\u683c\u3011\u30de\u30a4\u30da\u30fc\u30b9\u3067\u306e\u3093\u3073\u308a\u5c4b\u3001\u914d\u4fe1\u3057\u3066\u308b\u3068\u305f\u307e\u306b\u30a6\u30c8\u30a6\u30c8\u3057\u3061\u3083\u3046\n\u3010\u7d75\u306e\u7a2e\u985e\u3011\u30ab\u30e9\u30fc\uff11\u679a\u7d75\n\u3010\u30d5\u30a1\u30a4\u30eb\u5f62\u5f0f\u3011PSD(\u30ec\u30a4\u30e4\u5206\u3051\u3057\u3066\u3059\u3079\u3066\u30d1\u30c3\u30af\u3057\u305f\u3082\u306e) \u307e\u305f\u306f PNG\n\u3010\u69cb\u56f3\u3011\u63cf\u753b\u7bc4\u56f2\u3084\u8868\u60c5\u306a\u3069\u3059\u3079\u3066\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\uff01\n\uff08\u306d\u3080\u306d\u3080\u30fb\u7126\u308a\u30fb\u30ab\u30c3\u30b3\u3064\u3051...etc\uff09\n\u3010\u670d\u88c5\u3011\u300a3.\u30e9\u30a4\u30c0\u30fc\u30b9\u30b8\u30e3\u30b1\u30c3\u30c8(\u9769\u30b8\u30e3\u30f3) \u300b\u307e\u305f\u306f\u300a\u3042\u3066\u304a\u3093\u3055\u3093\u30aa\u30ea\u30b8\u30ca\u30eb\u300b\n\u203b\u30b8\u30e3\u30b1\u30c3\u30c8\u306f\u30b8\u30c3\u30d1\u30fc\u659c\u3081\u3001\u30b8\u30e3\u30b1\u30c3\u30c8\u6709\u71