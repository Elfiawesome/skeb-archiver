io", "creator_acceptable_same_genre": true}, {"path": "/@Oyasumi_guuguu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3880031, "client_id": 1811952, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=98197cce4766b04669b2e5542634299d", "srcset": "https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=98197cce4766b04669b2e5542634299d, https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f3135d298099596fde07e546d572952 2x, https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3ec2f724d896bd29836f807c19880bf 3x"}, "duration": 2, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a7ff0f0bb4e7c28cac6f6a15403be5", "srcset": "https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a7ff0f0bb4e7c28cac6f6a15403be5, https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df1001067596c8c60e70c2038ee6d092 2x, https://si.imgix.net/7a4c9717/uploads/outputs/c5a768df-34b8-44d3-b5f1-561b30890335?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d72e8e6532ae709500693bf09f482a8f 3x"}, "body": "初めまして！\n個人Vtuberの一匹兎之夜(ichihito koyoru)と申します。\n新着にてShimbo様の描かれるドットイラストの雰囲気に惹かれ、ぜひ描いて