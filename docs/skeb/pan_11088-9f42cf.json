めふたりが一緒にいる描写として屋内や夕方のイメージがあります。パンさんが描きやすいように自由に描いてくださると嬉しいです。\n\n【使用用途】\n鑑賞、アイコンやヘッダーへの使用 など\n商用利用の予定はございません。\n\n料金に対しての内容や資料不備あれば再送かキャンセルくたまさい。\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1C0_Yl2TAI0g80UMlNinEzY6QBmy7XdOT", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pan_11088/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3209296, "client_id": 1328807, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9524660b/uploads/origins/ee151bb5-ed68-4b25-b21f-9f0f4a003b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c49f95d804a572183ef679cac80b42c", "srcset": "https://si.imgix.net/9524660b/uploads/origins/ee151bb5-ed68-4b25-b21f-9f0f4a003b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c49f95d804a572183ef679cac80b42c, https://si.imgix.net/9524660b/uploads/origins/ee151bb5-ed68-4b25-b21f-9f0f4a003b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd8fdaf67c589639cba6b7c77d47ba06 2x, https://si.imgix.net/9524660b/uploads/origins/ee151bb5-ed68-4b25-b21f-9f0f4a003b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a12a3620412b3054c653b7579a79b3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9524660b/uploads/origins/ee151bb5-ed68-4b25-b21f-9f0f4a003b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=961a160677cc865215b62034f89d5125", "srcset": "https://si.imgix.net/9524660b/uploads/origins/ee151bb5-ed68-4b25-b21f-9f0f4a003b48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=961a160677cc865215b62034f89d5125, https://si.imgix.net/9524660b/uploads/origins/ee151bb5-ed68-4b25-b21f-9f0f4a003b48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&