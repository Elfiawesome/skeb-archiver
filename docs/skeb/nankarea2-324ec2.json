rticle/19c8e6a3ee83e2f16eb73a45408ab2716669f3ca.png@1192w_1192h.avif\n[4] https://www.duitang.com/blog/?id=1317589951\n[5] https://www.pixiv.net/artworks/122515648\n[6] https://www.pixiv.net/artworks/128382652\n[7] https://www.pixiv.net/artworks/119830738", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nankarea2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2979734, "client_id": 3469411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce9ef42a63f0241224aa9d6a92d75147", "srcset": "https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce9ef42a63f0241224aa9d6a92d75147, https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afbaf99fb55f81e27783babdac6d3319 2x, https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d85074097746d477119ac59378bdadf8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a5d873f6ad42e54e9adf3fe6266117", "srcset": "https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a5d873f6ad42e54e9adf3fe6266117, https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46af35dbf89c26ab46bab9385944e79e 2x, https://si.imgix.net/08e0319c/uploads/origins/92041d0d-978c-4896-857d-5987f6606ae5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2a0546928c75b836b70405d813f4646 3x"}, "body": "こんにちは、縄縛りフィギュアのリクエストです。\nキャラクターはグランブルーの小手川ちさ（茶髪ショート）です。\nスクリーンショットをいくつか：[https://grand-blue.fandom.com/wiki/Chisa_Kotegawa/Image_Gallery](アニメパート)と[https://www.bilibili.com/opus/966235678766530565?from=search&spm_id_from=333.337.0.0]。\nポーズ：ソファに寝転んでカメラ目線。または[https://www.pixiv.net/artworks/100749628]を参考にしてください。\n服装：上半身は元Fandomサイトの紹介ページ、右側のアニメの写真を参考にしてください。黒のショートスカート。黒いパンスト。靴はない。\nロープ：上半身に飾りをつける。股縄（スカートの裾を持ち上げ、パンストの内側にパンツの影が見える）。脚は結んである。https://www.pixiv.net/artworks/123421106]、[https://www.pixiv.net/artworks/95199647]、[https://www.pixiv.net/artworks/95365443]を参考にしてください。\n表情：やや赤ら顔。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nankarea2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2979734, "client_id": 3469411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3cc0cc8/uploads/origins/e0dddaa5-a9ed-4f28-a641-e2cab5402fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf5c8632d73a61866710b87f2627a9d", "srcset": "https://si.imgix.net/a3cc0cc8/uploads/origins/e0dddaa5-a9ed-4f28-a641-e2cab5402fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf5c8632d73a61866710b87f2627a9d, https://si.imgix.net/a3cc0cc8/uploads/origins/e0dddaa5-a9ed-4f28-a641-e2cab5402fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e15fbe8f2877c83b520e2dcffc5be65 2x, https://si.imgix.net/a3cc0cc8/uploads/origins/e0dddaa5-a9ed-4f28-a641-e2cab5402fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7699d7224ebbfe9ea7056d7828989800 3x"}, "duration": null, "nsfw": tru