ている。股縄。https://www.pixiv.net/artworks/136615637]のように上半身に飾り縄をつける。\n上半身には[]のような飾り縄。彼女は見る人を見ています。ポーズ参考[https://www.pixiv.net/artworks/136549183]。\n恥ずかしそうに笑っています。\n普通のロープです。そして、金色に輝く魔法のロープを使った差分イラスト。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nankarea2/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9edd05d3/uploads/origins/b85261a9-f032-473f-b6d5-800c4268f11e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22db86e2e6e79d4519e14fb72a867564", "srcset": "https://si.imgix.net/9edd05d3/uploads/origins/b85261a9-f032-473f-b6d5-800c4268f11e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22db86e2e6e79d4519e14fb72a867564, https://si.imgix.net/9edd05d3/uploads/origins/b85261a9-f032-473f-b6d5-800c4268f11e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88fe074c85f158f40f33c439bc030fab 2x, https://si.imgix.net/9edd05d3/uploads/origins/b85261a9-f032-473f-b6d5-800c4268f11e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9bfce87fc649800e79bd3f075f1c59c7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2979734, "client_id": 3469411, "nc": 48}, {"path": "/@nankarea2/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/340b2433/uploads/origins/1e525a08-ead3-4d3f-9e98-3410572e46fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb5aaf8d45d7c909e8c157cd10fc2431", "srcset": 