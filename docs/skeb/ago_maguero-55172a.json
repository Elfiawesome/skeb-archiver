s/4）\n\n差分よろしければ\n１：行為中\n２：お互いイって潮吹き\n３：事後\nでお願いします。\n\n二人とも狐娘なので、尻尾を相手に絡ませたり、尻尾同士を絡ませるのも入れていただけましたら。\nよろしければお願いいたします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ago_maguero/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1246993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c0d9fbc15f7349b9620fe73a74cf6d", "srcset": "https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9c0d9fbc15f7349b9620fe73a74cf6d, https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bb93f60c3ed2d8f756db86357846511 2x, https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8839b7d4e4ff854539ff5b6842d652cf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=004cc83bc69675ac6c2ec67853a66112", "srcset": "https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=004cc83bc69675ac6c2ec67853a66112, https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77b794079c772b2f2dc2411689f5e3ac 2x, https://si.imgix.net/16d53d58/uploads/origins/9ee8b11a-6490-4e96-9d15-11da56a20e5a?bg=%2