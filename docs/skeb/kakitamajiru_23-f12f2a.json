同じ構図でお願いできればと思います。\n\nキャラクターは「ヒヨリ」を、添付の衣装イメージで描いていただきたいです。ただし、垂れた耳、アホ毛、オオカミの尻尾、そして髪に付いている小さな白い花はそのまま残していただけますと幸いです。彼女はオオカミの女の子です。可能であれば、MV制作に使用するため、背景とキャラクターを別々のデータでいただくことは可能でしょうか。\n\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします。先生の作品を心より楽しみにしております！\n\nhttps://drive.google.com/drive/folders/1Mp1sn3Sc3E15d7d3iUETXJtIgBEAOT6E?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kakitamajiru_23/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3770645, "client_id": 3465115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f93e8136/uploads/origins/8df45b04-7abc-4e3e-822a-1204bc686dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5abfc5def5cf9fd398f3f67e7cfb059d", "srcset": "https://si.imgix.net/f93e8136/uploads/origins/8df45b04-7abc-4e3e-822a-1204bc686dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5abfc5def5cf9fd398f3f67e7cfb059d, https://si.imgix.net/f93e8136/uploads/origins/8df45b04-7abc-4e3e-822a-1204bc686dae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b92ca827aa79ec776855481c6764cc69 2x, https://si.imgix.net/f93e8136/uploads/origins/8df45b04-7abc-4e3e-822a-1204bc686dae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf60cd68d736014a43dd3ccd82694abc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f93e8136/uploads/origins/8df45b04-7abc-4e3e-822a-1204bc686dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe3a331ff774b4aadfc92e535bfaace9", "srcset": "https://si.imgix.net/f93e8136/uploads/origins/8df45b04-7abc-4e3e-822a-1204bc686dae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe3a331ff774b4aadfc92e535bfaace9, https://si.imgix.net/f93e8136/uploads/origins/8df45b04-7abc-4e3e-8