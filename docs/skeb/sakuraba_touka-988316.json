u305f\u3044\u3068\u8003\u3048\u3066\u304a\u308a\u307e\u3057\u305f\u3002\n\u79c1\u306eOC\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u3054\u4f9d\u983c\u3057\u305f\u3044\u3067\u3059\u3002\n\u30d5\u30a1\u30f3\u30bf\u30b8\u30fc\u306a\u4e16\u754c\u3067\u81ea\u4f5c\u306e\u9b54\u6cd5\u85ac\u306e\u884c\u5546\u3092\u751f\u696d\u3068\u3057\u3066\u3044\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3067\u3001\u7279\u5b9a\u306e5\u5e74\u9593\u3057\u304b\u751f\u304d\u3089\u308c\u305a\u3001\u6b7b\u306c\u305f\u3073\u306b\u3069\u3053\u304b\u306b\u300c\u30ea\u30b9\u30dd\u30fc\u30f3\u300d\u3057\u306613\u6b73\u306b\u623b\u308b\u3068\u3044\u3046\u546a\u3044\u3092\u53d7\u3051\u3066\u3044\u307e\u3059\u3002\n\n\u540d\u524d: \u30ad\u30e3\u30f3\u30c7\u30a3\u30b9\u30fb\u30a2\u30b3\u30cb\u30c3\u30c8(Candice Aconite)\n\u5e74\u9f62: 13\uff5e18\u6b73\uff08\u5e74\u9f62\u611f\u306f\u304a\u307e\u304b\u305b\u3044\u305f\u3057\u307e\u3059\u3002\uff09\n\u8eab\u9577: \u4f4e\u3081\uff08\u8a2d\u5b9a\u306f145cm\uff5e\u3067\u3059\u3002\uff09\n\u80f8: \u5c11\u3057\u3042\u308b\n\u9aea\u578b: \u5de6\u76ee\u5074\u306b\u30b5\u30a4\u30c9\u30c6\u30fc\u30eb\u3001\u6bdb\u5148\u306f\u80a9\u3088\u308a\u4e0a\u3067\u3001\u5f8c\u9aea\u306f\u77ed\u3081\n\u9aea\u8272: \u30eb\u30d3\u30fc\u30ec\u30c3\u30c9\u3001\u524d\u9aea\u306b\u767d\u306e\u30e1\u30c3\u30b7\u30e5\n\u7709: \u30c4\u30ea\u7709\n\u77b3: \u4e2d\u304f\u3089\u3044\u306e\u5927\u304d\u3055\u3067\u8272\u306f\u9ec4\u8272\n\u53e3: \u30ae\u30b6\u6b6f\uff08\u63a7\u3048\u3081\uff09\n\n\u670d\u88c5: \u304a\u597d\u304d\u306a\u3088\u3046\u306b\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\u7279\u306b\u7740\u305b\u305f\u3044\u670d\u304c\u306a\u3051\u308c\u3070\u4e0b\u8a18\u306e\u670d\u88c5\u3067\u3082OK\u3067\u3059\u3002\n[\u30b5\u30a4\u30c9\u30c6\u30fc\u30eb\u90e8\u5206\u306b\u30ea\u30dc\u30f3\u3068\u3001\u30b1\u30fc\u30d7\u3001\u30b9\u30ab\u30fc\u30c8\uff08\u5168\u3066\u6df1\u3044\u7d2b\u7cfb\uff09\u3068\u30b7\u30e7\u30fc\u30c8\u30d6\u30fc\u30c4\uff08\u305d\u306e\u4ed6\u306e\u90e8\u5206\u306f\u304a\u307e\u304b\u305b\u3067\u3059\uff09]\n\u6301\u3061\u7269\uff08\u306a\u304f\u3066\u3082OK\u3067\u3059\uff09: \u9784\uff08\u30d0\u30c3\u30af\u30d1\u30c3\u30af\u3067\u3082\u80a9\u639b\u3051\u3067\u3082\uff09\u3001\u9b54\u5c0e\u66f8\uff08\u624b\u306b\u6301\u3064\u304b\u3001\u8170\u306b\u63d0\u3052\u308b\uff09\u3001\u85ac\u74f6\n\u9b54\u5c0e\u66f8\u306f\u3001\u6587\u5b57\u306b\u89e6\u308c\u308b\u3053\u3068\u3067\u8a60\u5531\u3092\u7701\u7565\u3057\u3066\u9b54\u6cd5\u3092\u4f7f\u3046\u305f\u3081\u306e\u300c\u30de\u30af\u30ed\u30c4\u30fc\u30eb\u300d\u7684\u306a\u3082\u306e\u306a\u306e\u3067\u3001\u6301\u305f\u305b\u308b\u5834\u5408\u306f\u5fc5\u305a\u3057\u3082\u8aad\u307e\u305b\u306a\u304f\u3066\u3082OK\u3067\u3059\u3002\n\n\u5916\u898b\u4ee5\u5916\u306e\u6027\u8cea:\n\u3044\u305f\u305a\u3089\u3092\u597d\u307f\u307e\u3059\u304c\u3001\u6839\u306f\u8aa0\u5b9f\u3067\u6b63\u7fa9\u611f\u306e\u5f37\u3044\u6027\u683c\u3092\u3057\u3066\u3044\u307e\u3059\u3002\n\u751f\u304d\u3066\u3044\u308b\u671f\u9593\u306f\u5b50\u4f9b\u3068\u3057\u3066\u904e\u3054\u3059\u5834\u5408\u304c\u591a\u3044\u305f\u3081\u3001\u305d\u308c\u306b\u5f15\u3063\u5f35\u3089\u308c\u305f\u3084\u3084\u5e7c\u3044\u30fb\u8ca0\u3051\u305a\u5acc\u3044\u306a\u9762\u3082\u3042\u308a\u307e\u3059\u3002\n400\u5e74\u8fd1\u304f\u751f\u304d\u6b7b\u306b\u3092\u7e70\u308a\u8fd4\u3057\u3066\u3044\u308b\u305f\u3081\u77e5\u8b58\u3084\u7d4c\u9a13\u304c\u8c4a\u5bcc\u3067\u3059\u304c\u3001\u9b54\u529b\u3092\u8eab\u4f53\u306b\u84c4\u3048\u3089\u308c\u305a\u3001\u85ac\u7b49\u3067\u88dc\u5f37\u3057\u306a\u3051\u308c\u3070\u72ec\u529b\u3067\u306f\u5927\u304d\u306a\u9b54\u6cd5\u3092\u4f7f\u3048\u307e\u305b\u3093\u3002\n\u4e00\u5fdc\u306f\u3044\u308d\u3044\u308d\u306a\u9b54\u6cd5\u306b\u3064\u3044\u3066\u3001\u300c\u5b89\u5168\u306a\u74b0\u5883\u3067\u88dc\u5f37\u3057\u305f\u9b54\u529b\u3092\u4f7f\u3044\u3001\u4e00\u5ea6\u306f\u8a66\u3057\u6483\u3061\u3057\u3066\u3044\u308b\u300d\u3068\u3044\u