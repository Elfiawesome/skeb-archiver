茶会というイメージのように、中華風の塔（建築物）のなかでファミ（ふたつある資料URL参照のこと）と高級紅茶が中国茶を嗜んでいる・・・というイメージでお願いします。\nゲーム大会という特性上、ゲームパッドやアーケードゲーム機などが置いてあるとより良いと思います。服装についてはお任せしますが、普段の衣装か、もしくは中華風がいいと考えています。\nよろしくお願いします。\n\nhttps://twitter.com/83FAMI/status/1527555522639310849\n\nhttps://twitter.com/83FAMI/status/1572484182332551169", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@torxmo8/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2240801, "client_id": 403044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d1767d2/uploads/origins/459a3593-4dda-4ba2-a0ce-cc0b8b59ada7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d810a2cdf6dc130e628068c8849afd", "srcset": "https://si.imgix.net/0d1767d2/uploads/origins/459a3593-4dda-4ba2-a0ce-cc0b8b59ada7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d810a2cdf6dc130e628068c8849afd, https://si.imgix.net/0d1767d2/uploads/origins/459a3593-4dda-4ba2-a0ce-cc0b8b59ada7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eab32170323cb211784b60597e6a2c02 2x, https://si.imgix.net/0d1767d2/uploads/origins/459a3593-4dda-4ba2-a0ce-cc0b8b59ada7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9d50c334592756e0b16301d12ed43e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d1767d2/uploads/origins/459a3593-4dda-4ba2-a0ce-cc0b8b59ada7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0045e2aa201f76ea0c863bfd38648612", "srcset": "https://si.imgix.net/0d1767d2/uploads/origins/459a3593-4dda-4ba2-a0ce-cc0b8b59ada7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0045e2aa201f76ea0c863bfd38648612, https://si.imgix.net/0d1767d2/uploads/origins/459a3593-4dda-4ba2-a0ce-cc0b8b59ada7?bg=%23fff&auto=for