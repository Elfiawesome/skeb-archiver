とに気づいた。例えば、センダグの物語の最初の大きな出来事のひとつは、氷のドラゴンに憑依されたことで、彼らは氷のエレメントと関連づけられるようになった。うまく説明できないんだけど、ドラゴンの氷、虚空の暗い孤独、\"ヴィルトゥオーゾ \"の死のような美しさなど、彼らのキャラクターには、迫り来る寒さという中心的なテーマがあるんだ。\n\nあなたは彼らのキャラクターをよく理解していると思います。あなたのアイデアをぜひ拝見したいです。\n\nご検討ありがとうございました。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@knn_jn00/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3293494, "client_id": 3603517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/754d073b/uploads/origins/a22bbd0f-aa5c-455d-bfb0-87855e8a9f52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=552df652d98d1eda113d36da50e950b4", "srcset": "https://si.imgix.net/754d073b/uploads/origins/a22bbd0f-aa5c-455d-bfb0-87855e8a9f52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=552df652d98d1eda113d36da50e950b4, https://si.imgix.net/754d073b/uploads/origins/a22bbd0f-aa5c-455d-bfb0-87855e8a9f52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18b3f93b8e62459b42220c7d6d4aac7a 2x, https://si.imgix.net/754d073b/uploads/origins/a22bbd0f-aa5c-455d-bfb0-87855e8a9f52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d7ae346d2b64f20ef6402af8ba93190 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/754d073b/uploads/origins/a22bbd0f-aa5c-455d-bfb0-87855e8a9f52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7436bdc1ff6e878df624e9b7a63bea0", "srcset": "https://si.imgix.net/754d073b/uploads/origins/a22bbd0f-aa5c-455d-bfb0-87855e8a9f52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7436bdc1ff6e878df624e9b7a63bea0, https://si.imgix.net/754d073b/uploads/origins/a22bbd0f-aa5c-455d-bfb0-87855e8a9f52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blu