/@5oma_3Do/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2660761, "client_id": 2501412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6aa160f967d2128d1cb7da3dbfb1717", "srcset": "https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6aa160f967d2128d1cb7da3dbfb1717, https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a11365af590f65b3c72285f0cf700d03 2x, https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=954542240479de1a632dada121376ee3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=517040d37737e6574e9e4360e98a49f7", "srcset": "https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=517040d37737e6574e9e4360e98a49f7, https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=118f65c69cedd3c9da4a4bde0762397d 2x, https://si.imgix.net/a0d2fed1/uploads/origins/b583797a-d2fc-4633-b0dd-b28a7cb81d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=34a93bc5017da03ad30c9a24db688271 3x"}, "body": "三度さん\n\nこんにちは、はいくり/ビスコでございます。\n\n今回skebを開かれたということで是非！早速！リクエストさせて頂けたらと思います。\n\n一応①から順に強い希望にはなりますが、三度さんに負担のないリクエストを受けていただければ幸いです。\n\n①伐村 チガヤ\n三度さんのこのキャラクターのドがつくファンなので是非見れたら嬉しいです！\n1番描きやすい形のポーズや、表情で結構です。\n\n②火間土 翔\n自身のオリジナルキャラクターになります。表情はややムッとした顔が見たいなと思っております。\n\n③木下 亮\n②と同じく自身のオリジナルキャラクターとなっております。バットなどを持っていますが大変であれば省略して頂ければと思います。\n\n\n※②と③はURL先に資料添付致します。\n\nこのいずれかのSDキャラが見れたらめちゃくちゃ嬉しいなと思いますのでよろしくお願いいたします……！\n\nまた、頂いたイラストは個人的な観賞用でアクスタ作成などさせて頂くかもしれません。\n\nご無理のない範囲で検討していただけたらと思います。\nよろしくお願いいたします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1-Tq5rGfq5z1Ejlx9ouoMDz2_WW7-gp3p", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moon_mg328/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2597131, "client_id": 2501412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e353feb91b8d963982c7deeeb5ba873", "srcset": "https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e353feb91b8d963982c7deeeb5ba873, https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a88371e0547c824561c1607bf26f5ce 2x, https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ea0ea570a11dc0a2d8e27dd9e040230 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551f1de3af98479418028e46aec9ca95", "srcset": "https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=551f1de3af98479418028e46aec9ca95, https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ea6e70390f421ecea5b8f288891681b 2x, https://si.imgix.net/00d0b3a6/uploads/origins/b7997470-62cc-410b-8770-460dd54d8a5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4bd9f58e86eab0453b5f295a5ec7822e 3x"}, "body": "月咲様\n\nいつもお世話になっております、はいくり/ビスコです。\n\n今回は月咲様に自創作のキャラをリクエストしたくご連絡させて頂きました！\n\nジャンルとしては虫擬人化にはなりますが、触角部分のみ虫っぽさがあるという感じです\n\nまた、リクエストとしては以下のいずれかで結構ですので月咲様が1番描きやすいものでよろしくお願いいたします。\n\n①火間土 翔単体(資料1枚目)\n②木下 亮単体(資料2枚目)\n③上記二人をセットにしたイラスト\n\n特に内容については指定ありませんので、いちばんやりやすい形でお願いいたします！\n\nまたグーグルドライブにて資料を添付しておりますので参考にしていただければ幸いです。\n\nリクエスト自体が2回目のため不慣れな部分や失礼な部分ありましたら申し訳ありません。\nご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-Tq5rGfq5z1Ejlx9ouoMDz2_WW7-gp3p", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamagoDX1414/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 583942, "client_id": 2501412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0f87b822bbce877f7afcf93b942b13e", "srcset": "https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0f87b822bbce877f7afcf93b942b13e, https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9394dbc47d94e1ac629e891f94651caf 2x, https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c810082de66d6c1371ca68ba020622c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f87722f11cc46f7601abb314764dc63", "srcset": "https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f87722f11cc46f7601abb314764dc63, https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64dd3b64cbfb6afbd354f22ade35aa25 2x, https://si.imgix.net/3848d8aa/uploads/origins/b552bc0c-b729-4d8c-8508-5f8d74d73d5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e53c52f38c0753019df367252a806dc1 3x"}, "body": "あんどう様\n\nお初にお目にかかります、はいくりと申します。\n\n今年からあんどう様のシナリオを通過する機会ができまして、私自身あんどう様の描かれる描写や展開のファンになっております！まだ行っていないシナリオもありますので今後も機会を狙って、遊んで行けたらな、と思ってる所存です。\n\n特に、つい先月遊ばせて頂きました【サイレン清掃会社】がとてつもなく楽しく、心にとても刻まれたセッションとなりました！\n私はHO2をやらせて頂いたのですが、シナリオが始まる前からキャラ設定を考えるのが楽しく、実際始まってからも仲間とのやりとりと復讐の葛藤、洒掃さんからのメッセージや想い、Sとの交流などなど本当に楽しいところが盛りだくさんで、何度生まれ変わってもHO2がやりたい！と強く思ってしまうほどに大好きなシナリオ、そしてHOとなりました！ちょこちょこ始まる少しツイてないような要素にはとても笑顔になり、キャラクター性も上手くハマって楽しませてもらいました！\n\nどのNPCも魅力的でみんなのファンではあるのですが、特に私も自探索者も藍くんのことがとても好きになってしまいました！\n初見から三白眼の見た目が可愛い男の子が出てきて喜んでいたのですが、話が進む事に藍くんのことが分かり、藍くんの想いを強く感じとってしまい……藍くんと1度別れた後もHO2はすごく彼を気にしてたのですが、エンド1であったため、この清掃会社に来てくれて本当に嬉しく思ってしまいました！！最後のスチルの笑顔も見れて、胸がいっぱいに…！\n追加資料にもHO2に懐きやすいとあり、なおのこと好きになってしまいました！HO2自身も彼のことをとても気に入ってるので今後も仲良くしていきたいなぁと思っております！\n\nそこで、今回ご依頼したい内容なのですが、もし問題がなければ\n\n①自探索者のHO2が藍くんを抱きしめてる(抱っこしている)シーン\n②自探索者HO2と藍くんの日常シーン(例:食卓を一緒に囲む、泥団子を一緒に作る、テレビを見るなど)\n\nの2点を描いて頂けないでしょうか。\n①②の藍くんの反応に関しては、あんどう様が描きやすい方向で構いません。\nまた、自探索者の資料に関しましても添付させて頂きますが、あんどう様が描きやすいように解釈していただいて構いません。\n\n非公開NPCで難しい内容かと思いますが、どうかご無理のない範囲でご検討頂けますと幸いです。\n\nまた、最近はだいぶ冷え込んできました。\nどうかご体調にはお気をつけて、あんどう様がのびのびと活動できるようにお過ごしください。\nお忙しい中ではありますが、よろしくお願いいたします。\n\nこれからも応援しております…！\n\nhttps://drive.google.com/drive/folders/1SO-_P7sQPYercORLcNN6hyeqt-Awfvus?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 247005, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ミトコンチョ", "screen_name": "tontototoooon", "avatar_url": "https://pbs.twimg.com/profile_images/1641998227686969346/v2toaiZz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1051611149450412032/1709626614/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 48}, {"id": 583942, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "白畜生🤮強く生きる", "screen_name": "tamagoDX1414", "avatar_url": "https://pbs.twimg.com/profile_images/1485257104672067588/8J4BI7eY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1062268016258236422/1621819069/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1224329, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "わぴ", "screen_name": "tumumiko1210", "avatar_url": "https://pbs.twimg.com/profile_images/1585582083694809089/ugoajOPE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1327212809181020163/1737600101/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accep