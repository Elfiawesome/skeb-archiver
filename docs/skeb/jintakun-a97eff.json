見てみたくはある、といった感じ。\n\n受け：乃々(グラデ髪の方)\n顔がかわいい、天真爛漫、ぽやぽやしている、攻めの事をからかいがち。\n攻めの事が大好きなので攻めになら何されても許す。嫌いになる事もない。\n攻めのどす黒い感情については全く気付いていない、勝手に病んでる時あるのもおれの事大好きでかわい～と思っている。\n\n資料は表面にある物、資料になりそうな物フォルダ以外は参考になればと思い置いているものですので、見ても見なくても大丈夫です。\nまた、身長差は攻めの方がでかければ適当で大丈夫です。\n服装など描きやすいようにアレンジ/省略して頂いて構いません。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1wMm6owqq3ztEcSLnaGjaNDhOijpZbrip?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jintakun/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3111905, "client_id": 3449176, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/958c0054/uploads/origins/d9fd1aa3-6c4d-414b-a5a4-fc2cfef88551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b9b3edd506b9245af05f8fcadc2555", "srcset": "https://si.imgix.net/958c0054/uploads/origins/d9fd1aa3-6c4d-414b-a5a4-fc2cfef88551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b9b3edd506b9245af05f8fcadc2555, https://si.imgix.net/958c0054/uploads/origins/d9fd1aa3-6c4d-414b-a5a4-fc2cfef88551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c80f9bb6b238223f5bec102b7b88328a 2x, https://si.imgix.net/958c0054/uploads/origins/d9fd1aa3-6c4d-414b-a5a4-fc2cfef88551?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=905928a987d10cbecf52f81dd0e67bce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/958c0054/uploads/origins/d9fd1aa3-6c4d-414b-a5a4-fc2cfef88551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=975f98a3654cd7f90895d2d0299a7a69", "srcset": "https://si.imgix.net/958c0054/uploads/origins/d9fd1aa3-6c4d-414b-a5a4-fc2cfef88551?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=975f98a3654cd7f90895d2d0299a7a69, https: