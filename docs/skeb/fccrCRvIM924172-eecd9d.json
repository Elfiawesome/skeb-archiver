rop&crop=top&w=200&h=200&s=162bbcda538c3aeab4f56003c7a2b854 2x, https://si.imgix.net/ab7459a8/uploads/origins/e52c2a5e-7c2b-42f9-bcd7-41dc18f3054c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=639ba3f24d9c86694f0f7ca707b21489 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab7459a8/uploads/origins/e52c2a5e-7c2b-42f9-bcd7-41dc18f3054c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1145b531159af8683edced4177b5d5f9", "srcset": "https://si.imgix.net/ab7459a8/uploads/origins/e52c2a5e-7c2b-42f9-bcd7-41dc18f3054c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1145b531159af8683edced4177b5d5f9, https://si.imgix.net/ab7459a8/uploads/origins/e52c2a5e-7c2b-42f9-bcd7-41dc18f3054c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c285adc75808f5e88b332bad4d89ee9e 2x, https://si.imgix.net/ab7459a8/uploads/origins/e52c2a5e-7c2b-42f9-bcd7-41dc18f3054c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12b88872f9a4afd69e1de3f115961ea7 3x"}, "body": "テルノミヤさん、こんにちは！シルバーです、よろしくお願いします👋\n数ヶ月前、あなたの『Desscaras』のイラストを見てから、ずっとフォローしています。一目見た瞬間、そのスタイルにすっかり魅了されました！いつも素晴らしい作品を作ってくださってありがとうございます。あなたの作品を見るのをいつも楽しみにしています！😊\n私も『WSJ』の大ファンで、毎週発売されるやいなや読んでいます！ 現在連載中の作品では『茜物語』が一番のお気に入りです。テルノミヤさんのお気に入りは何なのか、とても気になります👀\n数週間前、skebで2件目のリクエストを拝見し、リクエストを受け付けていることを知りました！その瞬間、私もリクエストを送らなきゃと決心し、ようやくその機会が巡ってきて嬉しいです🙏\n\n私のオリジナルキャラクター、ネレザ・エカイツァを描いていただけないでしょうか。彼女のキャラクターは、あなたの作風にとても合うと思います。具体的なイメージは特にありませんので、詳細はすべてお任せします🙇‍♂️\nまだ彼女のプロフィールを完全に書き上げていないので、以下に簡単な情報を記載します：\nネレザは「ザ・ギャラント・サイレンズ」号の海賊船長です。カリスマ性があり、機知に富んでいます。乗組員を非常に大切にし、溺愛しています。彼女の乗組員は、社会から疎外されていた女性や、貧困や虐待などの状況から彼女が救い出した女性たちだけで構成されています。彼女は海怪との戦いで乗組員を守るために尾を失い、それを機械製の尾に置き換えました。\n\n彼女のプロフィールとアートギャラリーは、私のサイトのこちらからご覧いただけます：\nネレザ (Nereza): https://argentumgaleria.carrd.co/#nereza-ekaitza\n\nご依頼をご検討いただき、ありがとうございます 💗", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fccrCRvIM924172/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3824555, "client_id": 383657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c117eb4e13b44617ad22c8bf901590e2", "srcset": "https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c117eb4e13b44617ad22c8bf901590e2, https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a4fb0f0be58899d20c3d6032270ac79 2x, https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7953f673af0a74f6b457421831262331 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1deab4851f8337e38b17daf3a8086aa", "srcset": "https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1deab4851f8337e38b17daf3a8086aa, https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8bf8ca0f587ce4553b041b4c523dfff2 2x, https://si.imgix.net/44bb4088/uploads/origins/65091e01-61e8-4f0a-8f91-a6f81a5d1e89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc73c1ac6ea128d88986669814c2cf13 3x"}, "body": "こんにちは！あなたのユニークでカラフルな画風が大好きなので、私のアバターを描いていただけたら嬉しいです！彼女は風変わりで、おっちょこちょいで、衝動的で、かなり得意げなところがあり、カオスな性格で、ビールで酔っ払うのが大好きです。得意げなサメのようなニヤリとした笑みを浮かべたバージョンと、シンプルな:3顔のバージョンを描いていただけると嬉しいです。\n\nシャツの代わりに胸元に白いさらしを巻き、裾にピンクのラインが入った黒のプリーツミニスカートを着せてください。ポーズは完全にあなたにお任せします！お時間をいただき感謝します。完成した作品を見るのを楽しみにしています！https://imgur.com/a/ApWX8Iw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fccrCRvIM924172/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a9adf052/uploads/origins/a9f0108c-0955-4d89-b756-0c927da99562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c84e61fe3437749cd4ab6be2b552cd4d", "srcset": "https://si.imgix.net/a9adf052/uploads/origins/a9f0108c-0955-4d89-b756-0c927da99562?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c84e61fe3437749cd4ab6be2b552cd4d, https://si.imgix.net/a9adf052/uploads/origins/a9f0108c-0955-4d89-b756-0c927da99562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18aff50954c657bad847db0e55eba20d 2x, https://si.imgix.net/a9adf052/uploads/origins/a9f0108c-0955-4d89-b756-0c927da99562?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4eb3f06f1529f2493dd9f4e08ddc904 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3824555, "client_id": 3550610, "nc": 129}, {"path": "/@fccrCRvIM924172/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3824555, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {