ba\u69d8\u306e\u3049\u3001\u62f3\u304c\u6df1\u304f\u5165\u3063\u305f\u3068\u3053\u2661\u30b8\u30f3\u30b8\u30f3\u3063\u3066\u3057\u3066\u3001\u3048\u3078\u3078\u3001\u5b09\u3057\u3044\u306a\u3041\u2661\n\n\u306d\u3048\u3001\u3054\u4e3b\u4eba\u69d8\u3001\u3055\u3063\u304d\u50d5\u306e\u3053\u3068\u3061\u3087\u3063\u3068\u5acc\u304c\u3063\u3066\u305f\u3088\u306d\uff1f\u305d\u3057\u305f\u3089\u3055\u3041\u3001\u305d\u3093\u306a\u5acc\u306a\u5974\u306e\u9854\u3001\u6bb4\u308a\u305f\u304f\u306a\u3063\u3061\u3083\u3046\u3067\u3057\u3087\uff1f\n\u826f\u3044\u3093\u3060\u3088\u3001\u50d5\u306e\u9854\u3044\u3063\u3071\u3044\u6bb4\u3063\u3066\u3002\u3075\u3075\u3001\u5927\u4e08\u592b\u3060\u3088\u3002\u9854\u304c\u816b\u308c\u305f\u3063\u3066\u50b7\u304c\u3064\u3044\u305f\u3063\u3066\u3001\u50d5\u306e\u3053\u3068\u8650\u3081\u3066\u304f\u308c\u308b\u3054\u4e3b\u4eba\u69d8\u306e\u3053\u3068\u3092\u8ab0\u304b\u306b\u8a00\u3063\u305f\u308a\u306a\u3093\u3066\u3057\u306a\u3044\u304b\u3089\u2661\n\u307b\u3089\u3041\u3001\u306d\u3001\u6c17\u304c\u6e08\u3080\u307e\u3067\u6bb4\u3063\u3066\u307b\u3057\u3044\u30ef\u30f3\u2661\n\n(\u9854\u3092\u6bb4\u308b)\n\u3093\u3050\u3063\u3063\u3063\u3063\u3063\u3063\uff01\uff01\uff01\uff01\uff01\u2661\u2661\u2661\u2661\n\u3041\u3001\u3053\u308c\u3001\u75db\u3042\u3044\u2026\u2661\u3054\u4e3b\u4eba\u69d8\u3001\u3044\u3064\u3082\u50d5\u306e\u9854\u6bb4\u308b\u3068\u304d\u3088\u308a\u3082\u529b\u5165\u3063\u3066\u305f\u3088\u306d\uff1f\u3042\u30fc\u2026\u50d5\u306b\u3061\u3087\u3063\u3068\u30a4\u30e9\u3064\u3044\u3066\u308b\u304b\u3089\u3001\u6c17\u6301\u3061\u4e57\u3063\u3061\u3083\u3063\u305f\u306e\u304b\u306a\uff1f\u6c17\u6301\u3061\u3044\u30ef\u30f3\u2661\u3082\u3063\u3068\u3001\u3082\u3063\u3068\u3001\u5f37\u304f\u3076\u3063\u3066\u2661\n(\u6bb4\u308b)\u3093\uff9e\u3063\u3063\u3063\u3063\u3063\u3063\u3063\uff01\uff01\uff01\uff01\uff01\u2661\n(\u6bb4\u308b)\u3041\u304c\u3063\u3063\u3063\u3063\u3063\u3063\uff01\uff01\uff01\uff01\uff01\uff1f\uff1f\uff