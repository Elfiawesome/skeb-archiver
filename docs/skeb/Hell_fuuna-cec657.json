クはペンギンの帽子ですが、今回のイラストではヘアピンもしくは服などの色味をペンギンにしてほしいです。\n　\n・目の色→水色 \n   雪の結晶の形のハイライト\n\n・髪型→ボブ\n・髪色→紺色？毛先にかけて\n   青みの増すグラデっぽい感じ\n・肌の色→色白\n・カップ数→Hかっぷ・爆乳\n\nhttps://drive.google.com/drive/folders/1ovAdmf9cAm6NqpdgSkifAoyte6dBsm61\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ovAdmf9cAm6NqpdgSkifAoyte6dBsm61", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hell_fuuna/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1225745, "client_id": 1500863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/429f589a/uploads/origins/3a3aacd3-fb35-41bc-86ca-5d839195d8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2fe762e9e3df7b3b39adc6b7d77514c", "srcset": "https://si.imgix.net/429f589a/uploads/origins/3a3aacd3-fb35-41bc-86ca-5d839195d8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2fe762e9e3df7b3b39adc6b7d77514c, https://si.imgix.net/429f589a/uploads/origins/3a3aacd3-fb35-41bc-86ca-5d839195d8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccedc294a964cabc1a0d3f74bd65af5c 2x, https://si.imgix.net/429f589a/uploads/origins/3a3aacd3-fb35-41bc-86ca-5d839195d8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ed6bddaf5e54b52e088aa75a6ca6da2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/429f589a/uploads/origins/3a3aacd3-fb35-41bc-86ca-5d839195d8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2cad6e5086a134ee4d17c7bcc147fe6", "srcset": "https://si.imgix.net/429f589a/uploads/origins/3a3aacd3-fb35-41bc-86ca-5d839195d8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2cad6e5086a134ee4d17c7bcc147fe6, https://si.imgix.net/429f589a/uploads/origins/3a3aacd3-fb35-41bc-86ca-5d83