compress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed68d6ff15c5692b48dcf274ab6682df 2x, https://si.imgix.net/bffdca4b/uploads/origins/440b53be-3616-4cf1-9ea3-d830f00b0c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c9fa8eaef2d743f2b71a015c53c05b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bffdca4b/uploads/origins/440b53be-3616-4cf1-9ea3-d830f00b0c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9b433b4fd8875480a4e8f445a0d336a", "srcset": "https://si.imgix.net/bffdca4b/uploads/origins/440b53be-3616-4cf1-9ea3-d830f00b0c90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9b433b4fd8875480a4e8f445a0d336a, https://si.imgix.net/bffdca4b/uploads/origins/440b53be-3616-4cf1-9ea3-d830f00b0c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2efb8b739a6d9e637adef0793fcc90e8 2x, https://si.imgix.net/bffdca4b/uploads/origins/440b53be-3616-4cf1-9ea3-d830f00b0c90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8b7a69b9a9e19fe2ced02c9d96a1f54 3x"}, "body": "こんにちは！あなたの絵を見て、かわいいと思いました。私のキャラクターを2人使った作品をお願いしたいと思いました！\n\nキャラクターは、私の魔女とその人形の召使いです。魔女は常に冷淡で感情のない顔をしていて、身長は254cmです。人形は109cmで、礼儀正しく控えめ。どちらもヴィクトリア朝をイメージしています。\n\n詳細はお任せしますが、冬をテーマにしたシナリオが希望です！こんな風に手をつないで雪の公園を散歩するのもいいかもしれません。https://files.catbox.moe/lrkw5u.png\n\n人形の参考資料です：\nhttps://files.catbox.moe/ahvm9q.png\nhttps://files.catbox.moe/j42o8a.png\nhttps://files.catbox.moe/r4qp5w.png\nhttps://files.catbox.moe/2l5bar.png\n\n魔女の参考文献はこちら：\nhttps://files.catbox.moe/lbaj0m.png\nhttps://files.catbox.moe/daw703.jpg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kubo_manami_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3475176, "client_id": 2991552, "vtt_