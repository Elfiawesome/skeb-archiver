236\u4f5c\u306b\u3064\u3044\u3066\u30a2\u30c9\u30d0\u30a4\u30b9\u3044\u305f\u3060\u304d\u305f\u304f\u3001\u3054\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3002\n\n\u3010\u4f9d\u983c\u5185\u5bb9\u3011\n\u4eca\u5f8c\u306e\u5236\u4f5c\u3067\u306e\u30af\u30aa\u30ea\u30c6\u30a3\u30a2\u30c3\u30d7\u3092\u306f\u304b\u308b\u305f\u3081\u306b\u3067\u304d\u308b\u3053\u3068\u304c\u3042\u308c\u3070\u3054\u6307\u5c0e\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\n\u3072\u3068\u307e\u305a\u306f\u6b21\u306b\u793a\u3057\u305f\u66f2\u306b\u3064\u3044\u3066\u3001\u7dad\u6301\u3059\u3079\u304d\u70b9\u30fb\u6539\u5584\u70b9\u3092\u3054\u6559\u793a\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\nhttps://www.youtube.com/watch?v=FnHC7L-RGe8\n\n\u3053\u306e\u697d\u66f2\u306f\u4e0b\u8a18\u306e\u8003\u3048\u3067\u5236\u4f5c\u3057\u305f\u697d\u66f2\u3067\u3059\u3002\n1. \u97f3\u697d\u30b2\u30fc\u30e0\u3067\u306e\u30d7\u30ec\u30fc\u3092\u60f3\u5b9a\u3001\u306a\u308b\u3079\u304f\u96e3\u3057\u304f\u306a\u308b\u3088\u3046\u306b\u300c\u901f\u304f\u30fb\u7d30\u304b\u304f\u300d\n2. \u81ea\u5206\u306e\u597d\u304d\u306a\u8981\u7d20\u3092\u306a\u308b\u3079\u304f\u305f\u304f\u3055\u3093\u5165\u308c\u308b\uff01\uff08\u97f3\u30b2\u30fc\u30b3\u30a2\u3068\u30b8\u30e3\u30fc\u30b8\u30fc\u30af\u30e9\u30d6\u3068\u6b6a\u3093\u3060\u30ad\u30c3\u30af\u3068\u30f4\u30a9\u30b3\u30fc\u30c0\u30fc\u306b\u3088\u308b\u30e1\u30ed\u30c7\u30a3\u3068\u2026etc.\uff09\n3. \u300c\u660e\u308b\u3044\u5b87\u5b99\u300d\u3092\u30a4\u30e1\u30fc\u30b8\u3057\u3066\u3001\u97f3\u8272\u306f\u30ad\u30e9\u30ad\u30e9\u3068\u3001\u97f3\u306e\u5e83\u304c\u308a\u306f\u6df1\u304f\u3001\u3068\u304d\u306b\u9695\u77f3\u306e\u3088\u3046\u306b\u6fc0\u3057\u304f\n\n--\n\n\u53c2\u8003\u3068\u3057\u3066\u3001\u4e0b\u8a18\u306b\u81ea\u8eab\u304b\u3089\u307f\u305f\u6c17\u306b\u306a\u308b\u70b9\u3092\u793a\u3057\u307e\u3059\u3002\n\uff08\u5185\u5bb9\u306b\u89e6\u308c\u3066\u3044\u305f\u3060\u304b\u306a\u304f\u3066\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093\uff01\uff09\n\n[\u611f\u899a\u7684\u306a\u6c17\u306b\u306a\u308b\u70b9]\n- \u5168\u4f53\u7684\u306b\u306f\u6c17\u306b\u5165\u3063\u3066\u3044\u308b\u306e\u3067\u3059\u304c\u7d30\u304b\u306a\u3068\u3053\u308d\u304c\u3044\u307e\u3044\u3061\u3067\u300c\u7c97\u524a\u308a\u300d\u306a\u3088\u3046\u306b\u611f\u3058\u307e\u3059\u3002\u3067\u3059\u304c\u539f\u56e0\u304c\u3044\u307e\u3044\u3061\u660e\u78ba\u306b\u306a\u3063\u3066\u3044\u307e\u305b\u3093\u3002\n  - \u306a\u304a\u79c1\u306e\u5236\u4f5c\u65b9\u6cd5\u306f\u300c\u305d\u306e\u6642\u305d\u306e\u6642\u3067\u77e5\u8b58\u3092\u88dc\u3044\u306a\u304c\u3089(how to\u3084\u30ea\u30d5\u30a1\u30ec\u30f3\u30b9\u3067)\u3001\u4f5c\u308a\u305f\u3044\u30a4\u30e1\u30fc\u30b8\u306b\u8fd1\u3065\u3051\u3066\u3044\u304f\u300d\u3068\u3044\u3046\u30b9\u30bf\u30a4\u30eb\u3067\u3057\u305f\u3002\u4f53\u7cfb\u7684\u306a\u97f3\u697d\u306e\u5b66\u7fd2\u306f\u3057\u3066\u304a\u3089\u305a\u3001\u3072\u3068\u3064\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u65e5\u3005\u3053\u306d\u306a\u304c\u3089\u6642\u9593\u3092\u304b\u3051\u3066\u5b8c\u6210\u3055\u305b\u3066\u3044\u307e\u3057\u305f\u3002\n\n[\u8a73\u7d30\u306a\u6c17\u306b\u306a\u308b\u70b9]\n- 0:35 \u4ed8\u8fd1\u3067\u66f2\u8abf\u304c\u5909\u308f\u308b\u3068\u3053\u308d\u306b\u9055\u548c\u611f\u304c\u3042\u308b\u3068\u601d\u3063\u3066\u3044\u307e\u3059\uff08\u5f53\u6642\u306f\u7de0\u3081\u5207\u308a\u304c\u3042\u3063\u305f\u305f\u3081\u305d\u306e\u307e\u307e\u5b8c\u6210\u3055\u305b\u3066\u3044\u307e\u3059\uff09\u3002\n- 1:16~1:25 \u306e\u30d1\u30fc\u30c8\u3067\u306f\u3001\u7d42\u76e4\u3068\u540c\u3058\u30e1\u30ed\u30c7\u30a3\u3092\u512a\u3057\u3044\u97f3\u8272\u3067\u9cf4\u3089\u3057\u3066\u3044\u307e\u3059\u304c\u3001\uff08\u30b5\u30d3\u304b\u3089\u7d42\u76e4\u3078\u7e4b\u3050\u305f\u3081\u306b\u30c6\u30f3\u30b7\u30e7\u30f3\u3092\u843d\u3061\u7740\u304b\u305b\u308b\u306b\u3057\u3066\u306f\uff09\u3061\u3087\u3063\u3068\u7269\u