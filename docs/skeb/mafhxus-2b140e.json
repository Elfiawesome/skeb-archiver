3-ac7e-523c93882efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f13000a6f0fb7f738b2eb22c724dfc3a, https://si.imgix.net/a98e6e49/uploads/origins/f3a334c9-ec96-4213-ac7e-523c93882efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9a152ac4b6deb6b49fe50bddb270d02 2x, https://si.imgix.net/a98e6e49/uploads/origins/f3a334c9-ec96-4213-ac7e-523c93882efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e798219db7943aef1a8f21479f644b8 3x"}, "body": "こんにちは！私のキャラクター、孟新（メンシン）と雅文（ヤーウェン）のイラストを依頼したいです。二人は古代中国を舞台にしたカップルです。 :)孟新 | 170cm彼女は黒猫のような存在——冷たく、危険な表情を浮かべていることが多い。愛する相手に対しても、とげとげしい態度を見せる。内心では雅文を独占したいと思っている。\n\nヤウェン｜180cm誠実で意志が強い。人の良い面を見ようとする楽観主義者。孟新への愛情を非常にオープンに表現する。孟新は昔の恋人に執着し、その人を追いかけて命を落としかけた。ヤウェンは「自分のために生きるべきだ」と説得し、二人はカップルになった。\n\n参考画像とポーズ例です :)（特に2、4、6番のポーズがお気に入り！）ただし、お好きな構図や雰囲気で自由に描いてください！https://drive.google.com/drive/u/1/folders/1FSDp8iF3RRFtpQcd1N-tmkNym4UMZAXf", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mafhxus/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4e32c53b/uploads/origins/e588e255-80d2-49f4-8452-09076d798940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=176a0dcc15ea0faf4b47f54278f91136", "srcset": "https://si.imgix.net/4e32c53b/uploads/origins/e588e255-80d2-49f4-8452-09076d798940?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=176a0dcc15ea0faf4b47f54278f91136, https://si.imgix.net/4e32c53b/uploads/origins/e588e255-80d2-49f4-8452-09076d798940?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=007e8ab11c41b