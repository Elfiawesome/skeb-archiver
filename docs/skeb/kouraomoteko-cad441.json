でありながら虫化\n・　頭は一見触覚が生えた程度の変化ですが、口を大きく開くと虫の顎のようにガバっと割れて開く（内部にハエの口吻のような器官が生成されていると、なおよいです）\n・　効率よく繁殖するため、昆虫でいう「腹」の部分にも乳房が複数形成されている\n・　手足の先が五本指であったり、性器の形に人間の面影を残している\n虫化後のイメージとしては、エルデンリングというゲームの「腐敗の眷属」というクリーチャーがイメージに近いので参考としてください。\n\n注文が多くお手間かとは思いますが、ご検討よろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kouraomoteko/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2570803, "client_id": 2593227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bfc76a3/uploads/origins/872e621d-37f8-431d-a262-a9b85dbb1fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73d847b0c92014d06fa9ed16a6110d4", "srcset": "https://si.imgix.net/1bfc76a3/uploads/origins/872e621d-37f8-431d-a262-a9b85dbb1fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73d847b0c92014d06fa9ed16a6110d4, https://si.imgix.net/1bfc76a3/uploads/origins/872e621d-37f8-431d-a262-a9b85dbb1fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49c9e084c714cf97637a5f01e863f6c1 2x, https://si.imgix.net/1bfc76a3/uploads/origins/872e621d-37f8-431d-a262-a9b85dbb1fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f43a96d40a38b883bbae362e815ebc06 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bfc76a3/uploads/origins/872e621d-37f8-431d-a262-a9b85dbb1fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13e94c9d9e30eb313c2227c3ffdaf024", "srcset": "https://si.imgix.net/1bfc76a3/uploads/origins/872e621d-37f8-431d-a262-a9b85dbb1fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13e94c9d9e30eb313c2227c3ffdaf024, https://si.imgix.net/1bfc76a3/uploads/origins/872e621d-37f8-431d-a262-a9b85dbb1fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2