mgix.net/1306cb11/uploads/origins/b3acf073-95b6-41fe-bc35-eef555f5bbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=424d9369176bec5398cf3da57e0437c9", "srcset": "https://si.imgix.net/1306cb11/uploads/origins/b3acf073-95b6-41fe-bc35-eef555f5bbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=424d9369176bec5398cf3da57e0437c9, https://si.imgix.net/1306cb11/uploads/origins/b3acf073-95b6-41fe-bc35-eef555f5bbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=144169c31a15b99d6c60a7b68c6affcd 2x, https://si.imgix.net/1306cb11/uploads/origins/b3acf073-95b6-41fe-bc35-eef555f5bbc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=758aafa54e8338836a08b71c3bd171cd 3x"}, "body": "やしろさんこんばんは！いつも自陣ではしゃいでるさま見守っていただきありがとうございます！\nやしろさんの素敵な自陣のイラスト・落書きも本当に眼福です…オタクの命が助かっております…！\n今回はskeb再開ということで、GODARCA本編のHO魔術師とHO戦車を、ぜひやしろさんの絵で見たい……！！\nと思い、PL二人の合同リクエストを私が代表で送らせていただきました。\n飲食のシーンが好きと聞いたので、そのような1シーンを見てみたいです！\n\n・場面：魔術師が酒を飲んでおり戦車がそれに付き合っている（酒盛りの一角・どちらかの部屋か等お任せします。背景無くても全然かまいません！）\n・時間軸：シナリオ本編のちょっとしたif時間帯みたいな……戦車が魔術師に既に恋をしている状況が良いです……！\n・あると嬉しい要素\n　・酒が入って上機嫌な魔術師\n　・それを見て、いつもとは違い表情を緩めている戦車\n\n穏やかな感じでもらぶ…♡な感じでもからかい♡な感じでも、やしろさんのお好きな𝒏𝒊𝒄𝒆 𝒄𝒐𝒖𝒑𝒍𝒊𝒏𝒈…に解釈して描いていただけるとHAPPYです！\n参考資料は以下となります。\n(設定はあくまで参考ですので書きやすいように省略などしていただけると嬉しいです！)\n\nよろしければご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1u9dpw3S1EffDTVHit8GVigqlQfgQT2Ft?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yashir0_outside/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2970767, "client_id": 2973948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=811792880834faafb036e9ac7eb018e6", "srcset": "https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=811792880834faafb036e9ac7eb018e6, https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bf5bb6574f98a6b248f8885c94f466bd 2x, https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f37ad6853f50c52fca9c6dfe6809cc04 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46b0db8479890f54306c4adeda8eea00", "srcset": "https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46b0db8479890f54306c4adeda8eea00, https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d1e54fec1a955e59d0b035f2e35bd98 2x, https://si.imgix.net/0a810095/uploads/origins/793e34a2-869e-43a9-b1cd-39e55ed7a90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7d04629ed2969e11d7cccf2faa0a36 3x"}, "body": "やしろさんこんばんは！！\n日々、色々とお世話になっております…！\n一緒に遊んでくださったり、素敵なイラストを描いてくださったり本当にありがとうございます！！\n\n早速本題なんですが、今度、ゴダルカHO塔とHO皇帝の現代コンバートで、「ParaDogs Converge」というシナリオに行くことになりまして…。\nまだ未通過でなにも分からない状況ですが、トレーラーの雰囲気のうちのこ(征徒)と律揮さん(現コバ皇帝)を、是非やしろさんの絵で見たくって…この度リクエストさせて頂きました…！(お相手様には許可を頂いております)(通過前で私も概要以上の事は分かりませんのでネタバレもございません)\n\n依頼内容としては、マズルガードと金属の首輪をつけた征徒(反抗的で睨みつけるような顔)と、首輪についた鎖を持ってる律揮さん(目を細めた優しげな微笑み)のイラストをお願いしたいです！\n服装は、お任せでも結構ですが、もし指定があった方が楽であれば征徒は着崩した白ワイシャツに黒ズボン、律揮さんはジャケットオフのスリーピーススーツ(首元緩め)などですと嬉しいです…！\n(律揮さんとリチャードさんとの外見の変化は瞳のローマ数字が無くなることと服装のみと伺っております)\n\n背景も特にございませんが、概要には天蓋付きのベッドとありましたので、そのような雰囲気だと有難いです…！\n\n色々と言ってはおりますが、やしろさんの解釈でお好きに描いていただいて結構ですので…！\n\n参考資料は以下に添付させて頂きます…。\n\nお忙しいとは思いますが、条件が合えばで結構ですので、ご検討頂ければと存じます…！\nよろしくお願い致しますっ！！！！\n\nhttps://drive.google.com/drive/folders/1v8SUF3VNRX0p_T3jjW2PAC-BQ8e4aVUH", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yashir0_outside/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2970767, "client_id": 3496752, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b69e0f9f/uploads/origins/734fa1ee-e537-491b-9042-7df4ae18264f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b51475c96428ff6c7144f366a7ddc13d", "srcset": "https://si.imgix.net/b69e0f9f/uploads/origins/734fa1ee-e537-491b-9042-7df4ae18264f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b51475c96428ff6c7144f366a7ddc13d, https://si.imgix.net/b69e0f9f/uploads/origins/734fa1ee-e537-491b-9042-7df4ae18264f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51693587eec64f99a57385cd500ba0a7 2x, https://si.imgix.net/b69e0f9f/uploads/origins/734fa1ee-e537-491b-9042-7df4ae18264f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d802f8c6fe06e4645b60a58cf2c778b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b69e0f9f/uploads/origins/734fa1ee-e537-491b-9042-7df4ae18264f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd2b99137808bca54ce6bbe57a75b14a", "srcset": "https://si.imgix.net/b69e0f9f/uploads/origins/734fa1ee-e537-491b-9042-7df4ae18264f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd2b99137808bca54ce6bbe57a75b14a, https://si.imgix.net/b69e0f9f/uploads/origins/734fa1ee-e537-491b-9042-7df4ae