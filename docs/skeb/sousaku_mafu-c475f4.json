3&fit=crop&crop=top&w=200&h=200&s=7c3fa786d52383656b33376128f38af6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/303a1e1d/uploads/origins/da9b4a08-02fb-4064-ac9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7827bd30d6a89965e1bdbdb62c2e4ab7", "srcset": "https://si.imgix.net/303a1e1d/uploads/origins/da9b4a08-02fb-4064-ac9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7827bd30d6a89965e1bdbdb62c2e4ab7, https://si.imgix.net/303a1e1d/uploads/origins/da9b4a08-02fb-4064-ac9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a87a6794f7ed2f8c8d61ca794807613 2x, https://si.imgix.net/303a1e1d/uploads/origins/da9b4a08-02fb-4064-ac9c-722482dd7298?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b0f42fc5fca091e6d40d98fa22188d2 3x"}, "body": "リクエスト失礼致します\n\n―――\n\nもし！よかったら！！虫干しのために屋内で本を広げて並べている最中の乙部江さん(いつもの大正ロマン系統なお姿)の絵を見たいです！！！\n亡夜様の古書店(兼住居？)のどこかに丁度いい和室があるようでしたら、畳にぺたんと座って本の山傍らにその作業をされているようなご様子だと嬉しいです、よろしくお願いします……！\n\n―――\n\n微力ながら栄養のあるものを召し上がるお力添えになれれば幸いです", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sousaku_mafu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 709499, "client_id": 2116567, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2c22591/uploads/origins/a8d5adca-54f0-45dc-ab87-e83751350e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05c9edbea0d3ef9217e88062d685591a", "srcset": "https://si.imgix.net/c2c22591/uploads/origins/a8d5adca-54f0-45dc-ab87-e83751350e4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05c9edbea0d3ef9217e88062d685591a, https://si.imgix.net/c2c22591/uploads/origins/a8d5adca-54f0-45dc-ab87-e8375