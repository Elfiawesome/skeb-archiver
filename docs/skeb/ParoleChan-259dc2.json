SNSでの宣伝活動、YouTubeや各種SNSでのアイコンやバナー等で使用、 \n配信者や企業とコラボする際に共有、ネットプリント、返礼品、FANBOXでの使用、 FANBOXプリント、\nグッズ作成販売、商用利用\n ※上記にNGある場合はお手数ですが、リクエスト拒否をお願いします。\n\n【納品形式】\n 人物、背景、文字でレイヤーを分けたPSD形式 PSD納品が難しい場合は、背景透過人物画像(PNG)もいただきたいです。\n\nここまでお読みいただき、ありがとうございました。\nご検討のほどよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ParoleChan/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3909066, "client_id": 2549593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aaa55727/uploads/origins/44345815-9b6c-459f-bd99-ea4c047ed326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2811a51d442ef28adf5449e1916f7a7e", "srcset": "https://si.imgix.net/aaa55727/uploads/origins/44345815-9b6c-459f-bd99-ea4c047ed326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2811a51d442ef28adf5449e1916f7a7e, https://si.imgix.net/aaa55727/uploads/origins/44345815-9b6c-459f-bd99-ea4c047ed326?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e8af8d5c3568a4fcf0fd288b6af5331d 2x, https://si.imgix.net/aaa55727/uploads/origins/44345815-9b6c-459f-bd99-ea4c047ed326?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14c1b0d3be08ccff5f9a7b3c7b4318a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aaa55727/uploads/origins/44345815-9b6c-459f-bd99-ea4c047ed326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=460cb9e2937ebb532a7b5bd39e48aef7", "srcset": "https://si.imgix.net/aaa55727/uploads/origins/44345815-9b6c-459f-bd99-ea4c047ed326?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=460cb9e2937ebb532a7b5bd39e48aef7, https://si.imgix.net/aaa55727/uploads/origins/44345815-9b6c-459f-bd99-ea4c047ed326?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit