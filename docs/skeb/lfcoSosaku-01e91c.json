-40ab-a76c-dea14f14446b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1774ae106722da99af1819cf43b5b69", "srcset": "https://si.imgix.net/ab6915a5/uploads/origins/97cc51eb-5166-40ab-a76c-dea14f14446b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1774ae106722da99af1819cf43b5b69, https://si.imgix.net/ab6915a5/uploads/origins/97cc51eb-5166-40ab-a76c-dea14f14446b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d437fbf8114f5a6f2de8691bcfbafa23 2x, https://si.imgix.net/ab6915a5/uploads/origins/97cc51eb-5166-40ab-a76c-dea14f14446b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c84fa72cae0450fab0e029a9bf658e0f 3x"}, "body": "\u30da\u30fc\u723a\u3055\u3093\u3001\u3053\u3093\u306b\u3061\u306f\u3002Misae Mamiya\u3068\u7533\u3057\u307e\u3059\u3002\u30da\u30fc\u723a\u3055\u3093\u753b\u306e\u714c\u3073\u3084\u304b\u306a\u8272\u9063\u3044\u3092\u62dd\u898b\u3057\u3001\u4f9d\u983c\u3057\u3088\u3046\u3068\u601d\u3044\u307e\u3057\u305f\u3002\n\u3067\u3059\u304c\u4eca\u56de\u306e\u4f9d\u983c\u304c\uff12\u4eba\u7d44\u4e14\u3064\u7d61\u307f\u7d75\u306a\u306e\u3067\u3001\u96e3\u3057\u304b\u3063\u305f\u3089\u304a\u6c17\u8efd\u306b\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u3066\u3044\u305f\u3060\u304d\u69cb\u3044\u307e\u305b\u3093\u3002\n\n\u300c\u30aa\u30da\u30e9\u5ea7\u306e\u602a\u4eba\u300d\u8981\u7d20\u304c\u3042\u308b\u3001\u81ea\u5b85\u306e\u30aa\u30ea\u30ad\u30e3\u30e9\u300c\u30d5\u30a1\u30f3\u30c8\u30e0\u300d\uff06\u300c\u30de\u30c9\u30f3\u30ca\u300d\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\uff12\u4eba\u304c\u51fa\u3066\u308b\u8a71(\u672c\u7de8\u3068\u3057\u3066\u66f8\u3044\u3066\u306f\u3044\u306a\u3044\u306e\u3067\u3059\u304c)\u306f\u3001\u300c\u304a\u829d\u5c45\u3067\u30aa\u30da\u30e9\u5ea7\u306e\u602a\u4eba\u3092\u3084\u308b\u3053\u3068\u306b\u306a\u308b\u306e\u3060\u304c\u3001\u30d5\u30a1\u30f3\u30c8\u30e0\u5f79\u306e\u5e7d\u970a\u304c\u3044\u308b\u5642\u304c\u3042\u308a\u2026\u300d\u3068\u3044\u3046\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\n\n\n\uff3b\u30ad\u30e3\u30e9\u7279\u5fb4\uff3d\u30d5\u30a1\u30f3\u30c8\u30e0(The Phantom)\n\u30d5\u30a1\u30f3\u30c8\u30e0\u5f79\u306e\u5c11\u5e74\u3002\u7126\u8336\u8272\u306e\u77ed\u9aea\u3067\u3042\u308a\u3001\u708e\u306e\u3088\u3046\u306b\u71c3\u3048\u3066\u3044\u308b\u76ee\u306e\u8272\u304c\u7279\u5fb4\u3002\n\u81ea\u5275\u4f5c\u3067\u306f\u300c\u304a\u829d\u5c45\u672c\u756a\u524d\u306b\u4e0d\u616e\u306e\u4e8b\u6545\u3067\u53bb\u3063\u305f\u4ea1\u970a\u300d\u306e\u3088\u3046\u306a\u5b58\u5728\u3002\u4eee\u9762\u3092\u5265\u304e\u53d6\u3089\u308c\u308b\u3068\u82e6\u3057\u307f\u3001\u66ab\u304f\u306e\u9593\u6d88\u3048\u3066\u3057\u307e\u3046(\u970a\u4f53\u306e\u3088\u3046\u306b\u306a\u308b)\u3002\n\u4e3b\u4eba\u516c\u306e\u3053\u3068\u3092\u300c\u30e9\u30a6\u30eb\u300d\u3068\u547c\u3073\u3001\u6575\u8996\u3057\u3066\u308b\u3068\u3053\u308d\u304c\u3042\u308b(\u672c\u4eba\u306f\u300c\u9055\u3046\u3063\u3066\u300d\u3068\u4f55\u5ea6\u3082\u8a02\u6b63\u3057\u3066\u308b\u304c\u805e\u304b\u306a\u3044)\u3002\n\n\uff3b\u30ad\u30e3\u30e9\u7279\u5fb4\uff3d\u30de\u30c9\u30f3\u30ca(Madonna)\n\u6b64\u51e6\u3067\u306f\u30af\u30ea\u30b9\u30c6\u30a3\u30fc\u30cc\u5f79\u3092\u52d9\u3081\u308b\u5c11\u5973\u3002\u8336\u8272\u3092\u307b\u3093\u306e\u5c11\u3057\u542b\u3093\u3060\u91d1\u9aea\u3067\u9aea\u3092\u7d50\u3063\u3066\u304a\u308a\u3001\u30ab\u30c1\u30e5\u30fc\u30b7\u30e3\u3092\u4ed8\u3051\u3066\u3044\u308b\u3002\u76ee\u306f\u8d64\u7d2b\u8272\u3002\n\u30c9\u30ec\u30b9\u306f\u30da\u30fc\u723a\u3055\u3093\u306e\u30bb\u30f3\u30b9\u306b\u304a\u4efb\u305b\u3057\u307e\u3059\u3002\n\u4f59\u8ac7\uff1a\u666e\u6bb5\u306e\u5f7c\u5973\u306f\u9ad8\u98db\u8eca\u306a\u6027\u683c\u3067\u3001\u300c\u30de\u30c9\u30f3\u30ca\u300d\u3068\u547c\u3070\u306a\u3044\u3068\u6012\u308b(\u672c\u540d\u306f\u300c\u30a2\u30c9\u30f3\u30ca\u300d)\u3002\u4e3b\u4eba\u516c\u66f0\u304f\u300c\u3042