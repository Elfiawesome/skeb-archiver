mgix.net/d5a5f4c7/uploads/origins/459c96dc-20e3-43ca-b75b-1ed8b94ba65a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c2bb9dd840c598e20d919195f83c1b4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5a5f4c7/uploads/origins/459c96dc-20e3-43ca-b75b-1ed8b94ba65a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaee3233c7d0fe9666c06f922b0363e6", "srcset": "https://si.imgix.net/d5a5f4c7/uploads/origins/459c96dc-20e3-43ca-b75b-1ed8b94ba65a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aaee3233c7d0fe9666c06f922b0363e6, https://si.imgix.net/d5a5f4c7/uploads/origins/459c96dc-20e3-43ca-b75b-1ed8b94ba65a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7cbf71f1ca9132ac6e4963d40fd1545b 2x, https://si.imgix.net/d5a5f4c7/uploads/origins/459c96dc-20e3-43ca-b75b-1ed8b94ba65a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bca5d597dd8db4c394af10fd926acbc2 3x"}, "body": "おつかれさまです。お久しぶりです。\nお知らせで気づきましたので宜しければ以前描いて頂いた舞ちゃん里乃ちゃんイラストの続きをご依頼させてください。\n今回は里乃ちゃんが男のキンタマが空になるまで搾り取ろうと男の上で艶めかしく激しく踊るイラストをお願いします。\n\n男に跨って踊りで強化されてえぐいサイズに勃起したバキバキチンポの先端をアソコにあてがう里乃ちゃん。\n里乃ちゃんは笑みを浮かべながらゆっくりと腰を落としてズップリ根元まで挿入してお尻を小気味よく打ち付けたり腰をくねらせて精液を搾ろうとするも、想像以上に身体の相性が良く舞ちゃんとどちらがより精液を搾り取れるかの遊びのつもりが本気になってしまう。\n男の限界を察知した里乃ちゃんが更に激しく動いて一際強くお尻を打ち付けた所で男は堪らず射精。男は快感でカクカクと腰を跳ね上げながら大量の精液を里乃ちゃんの最奥に注ぎ込む。\n長い射精に子宮を満たされ陶酔した満足げな笑みを浮かべる里乃ちゃん。\n\n無理のない可能な範囲で上記シーンのイラストをお願いします。\n\n\nご無理でしたらキャンセルして下さい。\nご検討願います。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 40886, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "みさほみ", "screen_name": "misaho_mi", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-76fa3aba