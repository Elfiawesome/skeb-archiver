苦手なものの、彼を嫌う人はかなり少ない素敵な性格をしています。\n\n\nどんな構図、表現でも構いません。衣装にアレンジを加えても問題ありません。巣鴨様が解釈したイラストを見てみたいです。\n難しければ、口角を片方のみ上げて不敵な笑みを浮かべている表情をお願いします。\n\n使用用途は私的利用(スマホ、デスクトップ背景)のみです\n\n\n初めてのskebリクエスト故、何か不手際があれば申し訳ありません。ご不快になられましたらキャンセルしていただければと思います。\nお忙しいと思いますがご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ENsX-BZofOS50ZSst4kEkVgPqRSeQtmw", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 734496, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "石川", "screen_name": "Y7tRb", "avatar_url": "https://pbs.twimg.com/profile_images/1707930305146114048/ixuJo1Oh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/845613767522041856/1742888368/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 1207844, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Touva@sketch", "screen_name": "Touvasketch", "avatar_url": "https://pbs.twimg.com/profile_images/2032874653430198276/0lV0TgTf.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 1209903, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さえき", "screen_name": "hill_yoll", "avatar_url": "https://pbs.twimg.com/profile_images/1908163147724423168/H6aqMp6u.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1205813486128730112/1718105560/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted