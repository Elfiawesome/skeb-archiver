er.com/kotoboooookey/status/1585865077508698113\nhttps://twitter.com/kotoboooookey/status/1537805814282723328\n着色やレンダリングはあまり必要ありません。\n価格内で適切と思われる分だけを自由に描いてください。\n\nこの2人のオリジナルキャラクターのスケッチを何枚かもらえたらうれしいです。\nhttps://sta.sh/21acrnfx8r30?edit=1\n自由に解釈して描いてください。\n\nご配慮いただき、誠にありがとうございます不適切な場合は遠慮なくキャンセルしてください!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotoboooookey/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 324584, "client_id": 2458666, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1da1890a/uploads/origins/b10f2465-98fe-42bb-babb-5a1c36a70d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb0e357aacdafca0f2d15db46410c69", "srcset": "https://si.imgix.net/1da1890a/uploads/origins/b10f2465-98fe-42bb-babb-5a1c36a70d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb0e357aacdafca0f2d15db46410c69, https://si.imgix.net/1da1890a/uploads/origins/b10f2465-98fe-42bb-babb-5a1c36a70d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49a518dbd297575b58f06e7283723b0e 2x, https://si.imgix.net/1da1890a/uploads/origins/b10f2465-98fe-42bb-babb-5a1c36a70d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d686912acbeead1894c86f481e9f64bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1da1890a/uploads/origins/b10f2465-98fe-42bb-babb-5a1c36a70d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f095678e7331bd9b6aa0d29973b7730", "srcset": "https://si.imgix.net/1da1890a/uploads/origins/b10f2465-98fe-42bb-babb-5a1c36a70d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f095678e7331bd9b6aa0d29973b7730, https://si.imgix.net/1da1890a/uploads/origins/b10f2465-98fe-42bb-babb-5a1c36a70d14?bg=%23fff&