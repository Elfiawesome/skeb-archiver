mascot.\n\nDo what you like with him! You have complete freedom to do as you wish. I just love your art!\n\nWould it be possible for it to be drawn in the style of this commission: https://skeb.jp/@kotoboooookey/works/10\n\nAnd thank you so much for considering!\n\nhttps://imgur.com/a/DBkFdQY", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotoboooookey/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 324584, "client_id": 2591967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2688a94b/uploads/origins/5821f05e-ef59-4f92-b2cd-92c6ce6d3aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76bb4e26c4910b625ca8ebbf6118bd69", "srcset": "https://si.imgix.net/2688a94b/uploads/origins/5821f05e-ef59-4f92-b2cd-92c6ce6d3aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76bb4e26c4910b625ca8ebbf6118bd69, https://si.imgix.net/2688a94b/uploads/origins/5821f05e-ef59-4f92-b2cd-92c6ce6d3aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58686235382ad8631680bf53a4b37aa5 2x, https://si.imgix.net/2688a94b/uploads/origins/5821f05e-ef59-4f92-b2cd-92c6ce6d3aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27889b242d42402bd856a9edbe930b8b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2688a94b/uploads/origins/5821f05e-ef59-4f92-b2cd-92c6ce6d3aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57b65178f4f26bd447c071d40d21d44c", "srcset": "https://si.imgix.net/2688a94b/uploads/origins/5821f05e-ef59-4f92-b2cd-92c6ce6d3aaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57b65178f4f26bd447c071d40d21d44c, https://si.imgix.net/2688a94b/uploads/origins/5821f05e-ef59-4f92-b2cd-92c6ce6d3aaf?bg=%23fff&auto