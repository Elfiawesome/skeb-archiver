://si.imgix.net/0e4778f8/uploads/origins/449efb50-1f8b-4f16-ab69-00088bf9f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bcde2ce6869d605959f4bab33560ab1 2x, https://si.imgix.net/0e4778f8/uploads/origins/449efb50-1f8b-4f16-ab69-00088bf9f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26d1866c4f0d227a3446b3ae202c1e94 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e4778f8/uploads/origins/449efb50-1f8b-4f16-ab69-00088bf9f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=074db33bcc1269d8b3d949299139bb0f", "srcset": "https://si.imgix.net/0e4778f8/uploads/origins/449efb50-1f8b-4f16-ab69-00088bf9f895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=074db33bcc1269d8b3d949299139bb0f, https://si.imgix.net/0e4778f8/uploads/origins/449efb50-1f8b-4f16-ab69-00088bf9f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a2a5f0cd912f8c38be5b5c6871b339c 2x, https://si.imgix.net/0e4778f8/uploads/origins/449efb50-1f8b-4f16-ab69-00088bf9f895?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3698eeb56f652d65a8ed5c9da802abc9 3x"}, "body": "みーちゃさんこんにちは！\n以前よりみーちゃさんのXをリストに入れて定期的に見させていただいておりました。とてもかわいくて素敵なみーちゃさんの画風が好きで、過去のイラストの中に好きな作品も多いです。私はきららアニメや日常系アニメが好きで、とくにごちうさが好きです。アイコンのシャロちゃんもかわいいですね！\n\nリクエストはごちうさではないのですが、私が一番好きなキャラクターである、アニメ『天体のメソッド』のノエルちゃんを描いてほしいです。\n作品やキャラクターをご存じかどうかわかりませんので、ノエルちゃんの簡単な性格(？)を紹介しておきます。すごく元気いっぱいで無邪気な女の子で、年齢は明かされていませんが子どもっぽい容姿や言動がまたかわいい子です。ざっくりな見た目は、中学のチノちゃんを少し幼くした容姿、ごちうさSFYの幼少期チノちゃんよりは明らかに年上といった感じで、普段のチノちゃんの髪型をツーサイドアップ風にした感じと言えば伝わりやすいでしょうか。\n天体のメソッドのストーリーは友人同士の関係が多少拗れるため日常系が好きな自分には辛かったのですが、ノエルちゃんがもうとにかくかわいくて癒されておりました。\n\n現在天体のメソッド公式サイトは閉鎖なのか不具合なのかわかりませんが閲覧できない状態です。資料URLにノエルちゃんの画像を載せておきますので、参考になさってください。\n服装は資料のようないつもの服で、元気いっぱいで笑顔のノエルちゃんを描いていただきたいです。その他細かい部分はお任せします。\n\n先日リクエストしようと思っていた矢先、入院されたとのポストを見て大変心配しておりましたが、現在はお元気そうでなによりです。もし可能でしたらリクエストを引き受けてくださると幸いです。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1L_hb3fBgNPSRQJ7uekVEsRiGNcq_ok1_?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MityaStar/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2856715, "client_id": 585415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e56dddbb/uploads/origins/7ccbe9db-4e6f-489b-ab85-1510f7dfa1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b7f9d78847894ae6174f6f8d9565b2", "srcset": "https://si.imgix.net/e56dddbb/uploads/origins/7ccbe9db-4e6f-489b-ab85-1510f7dfa1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b7f9d78847894ae6174f6f8d9565b2, https://si.imgix.net/e56dddbb/uploads/origins/7ccbe9db-4e6f-489b-ab85-1510f7dfa1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15dee6b05d60e7c7429a70f158f4b61a 2x, https://si.imgix.net/e56dddbb/uploads/origins/7ccbe9db-4e6f-489b-ab85-1510f7dfa1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf26d16d59b489fa4f685454a4b5e799 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e56dddbb/uploads/origins/7ccbe9db-4e6f-489b-ab85-1510f7dfa1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf80c5bf7a3926ab3b7890891a925e7", "srcset": "https://si.imgix.net/e56dddbb/uploads/origins/7ccbe9db-4e6f-489b-ab85-1510f7dfa1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf80c5bf7a3926ab3b7890891a925e7, https://si.imgix.net/e56dddbb/uploads/origins/7ccbe9db-4e6f-489b-ab85-1510f7dfa1ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=643c0615ce0f9ccf4e5cb9b8fff7d020 2x, https://si.