=top&w=200&h=200&s=a11cc10b4956dd68e996ac1f0af95a41, https://si.imgix.net/f0f0ffde/uploads/origins/be9898fc-5195-4e4b-8dd8-c77ef4b34927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c872456b53cf54fc8c081d77429147ae 2x, https://si.imgix.net/f0f0ffde/uploads/origins/be9898fc-5195-4e4b-8dd8-c77ef4b34927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec025039ad749b366d71458ac1165a4f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0f0ffde/uploads/origins/be9898fc-5195-4e4b-8dd8-c77ef4b34927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd0fcc7309c77318dbd08342c6276a41", "srcset": "https://si.imgix.net/f0f0ffde/uploads/origins/be9898fc-5195-4e4b-8dd8-c77ef4b34927?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd0fcc7309c77318dbd08342c6276a41, https://si.imgix.net/f0f0ffde/uploads/origins/be9898fc-5195-4e4b-8dd8-c77ef4b34927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6665477ab96a7b526bc388fe07fbf67e 2x, https://si.imgix.net/f0f0ffde/uploads/origins/be9898fc-5195-4e4b-8dd8-c77ef4b34927?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f62a27f21742337270137e680bda785b 3x"}, "body": "お久しぶりです。うちの子をこよなく愛するkaintsです。\n暁ランスReさんに以前描いてもらった一条アリスちゃんの男の娘バージョンのイラストをお願いしたいと思い依頼します。\n\nBBC、QOSを含むどうしてもえぐい依頼内容になりますので趣味に合わなければ気軽にお断りください。\nまた、男の娘なアリス君を今回は「アリシアちゃん」と呼称します。\n\n・依頼内容\n後述URL先の依頼イメージのようなアリスちゃんとアリシアちゃんのイラスト\n二人ともメイドビキニでBBCご主人様を待ってる感じ\n二人の間に吹き出しをつくるなどして「♡」を描いてほしいです。\nタトゥーや文字の程度はお任せしますが、タトゥーを入れる場合はタトゥー有り無しの差分を頂きたいです。\nアリシアちゃんの髪の長さはお任せします。\n\n背景はなくても構いません。\n\n・男の娘アリス君イメージ\nhttps://drive.google.com/drive/u/1/folders/1MtOdUzKdWx0fmCeRTEE9icrsNpzo_A1n\n身長は150cm前半、アリスちゃんより華奢な女の子体系\n男らしいことに憧れて背伸びしてる系男子\n\n・設定\nアリスちゃんとアリシアちゃんは恋人同士\n転校生のBBC君の男らしさに惹かれてしまったアリスちゃんが彼色に染まり、アリシアちゃんは雄として負けているのを実感し雌として開花\n極上の雌とマゾ化男の娘を手にしたBBC君は優越感に浸っている。\nいまだ恋人同士の二人は倒錯的な関係を楽しんでいる。\n\n以上、もしよろしければ描いてもらえないでしょうか。\n重ねてになりますが気軽に断って頂いて構いませんのでご検討よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LanceUra/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1860031, "client_id": 2898177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2802648164dbb24295b61602a32e9112", "srcset": "https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2802648164dbb24295b61602a32e9112, https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5375babccc770439092b91a9826a2a5d 2x, https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df21ab480f447c65e32dbe0105acdb25 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff1d99e8ad8309bbe6749747b1ac214d", "srcset": "https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff1d99e8ad8309bbe6749747b1ac214d, https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23fab4d6e7fbedc0c425e51692be04f4 2x, https://si.imgix.net/80b5817c/uploads/origins/954ffcd4-6cde-4a6c-be86-bba49ecb724c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f0b863dad1576b1332e144cc20f1b2e 3x"}, "body": "暁ランスさん、アピールありがとうございます。うちの子をこよなく愛するkaintsと申します。\nあなたの描く黒テカイラストに惹かれて依頼します。\n\nアリスちゃんのこちらのスクショのようなイラストをお願いします。\nhttps://x.com/Kaints31/status/1836643185860440087/photo/1\n\n・衣装デザイン\n赤紫のテカテカなボディコン、テカテカ網タイツ、中指だけ通してる長手袋、ボディコンに乳首ピアスを通す穴有り\nhttps://www.pixiv.net/artworks/119077266\n\nボディコンの結び目っぽい部分や長手袋の網にするなどの大きく変えないデザイン変更はオッケーです。\n\n・ポーズなど\nアリスちゃんの魅力にタジタジになってる彼氏君をからかうような表情とポーズで攻め攻めの感じでお願いします。\n下品なイヤリングなどを見せつけるのも良いかもしれませんね。\n\n・アリスちゃん設定\n自分のプロポーションに自信満々で彼氏君に見せつけるのが好き。彼氏君に対して主導権を握るのが好き。時々主導権を握り返されるのはもっと好き。\nエロい衣装を着るのが案外好き(段々過激に・・・)\n\n・シチュエーション\n彼氏君と二人きりになれる場所に連れ込み、いつものようにコスプレして高まった気分でイチャラブセックスする前の場面\n見慣れてきたという彼氏君、しかし今日のアリスちゃんも魅力的過ぎていつも通りに主導権を握られ・・・\n\n以上のような感じで彼氏君の反応を見て楽しそうなアリスちゃんを見たいです。\nどうかよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LanceUra/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1860031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01330646/uploads/origins/5523de75-563f-4410-988d-c423a2b13a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3842f6e44e5115cc0b4d7b93f43df416", "srcset": "https://si.imgix.net/01330646/uploads/origins/5523de75-563f-4410-988d-c423a2b13a22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3842f6e44e5115cc0b4d7b93f43df416, https://si.imgix.net/01330646/uploads/origins/5523de75-563f-4410-988d-c423a2b13a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d59c7bf031abba152230c5b259ba213 2x, https://si.imgix.net/01330646/uploads/origins/5523de75-563f-4410-988d-c423a2b13a22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43e56462322652155075a03753dd167e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumb