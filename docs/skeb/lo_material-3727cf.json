199\n\u30fb\u5b50\u5bae\u65ad\u9762\u56f3\u306f\u5375\u5de3\u3001\u5375\u7ba1\u306e\u3042\u308b\u30bf\u30a4\u30d7\u3067\u51fa\u6765\u308c\u3070\u30ad\u30e3\u30e9\u306b\u30aa\u30fc\u30d0\u30fc\u30ec\u30a4\n\n\u3010\u5dee\u5206(PSD\u5f62\u5f0f\u3067\u5dee\u5206\u306eON \u30fbOFF\u304c\u53ef\u80fd)\u3011\n\u30fb\u633f\u5165\u524d\u304f\u3071\u3041(\u51e6\u5973\u819c\u3001\u81a3\u53e3\u3001\u5b50\u5bae\u53e3\u306e\u3069\u308c\u304b\u306f\u898b\u3048\u308b)\n\u30fb\u81a3\u53e3\u304b\u3089\u7c98\u308a\u6c17\u306e\u3042\u308b\u304a\u308a\u3082\u306e\u304c\u5782\u308c\u308b(\u7537\u304c\u5371\u967a\u65e5\u3092\u5bdf\u3059\u308b)\n\u30fb\u81a3\u53e3\u306b\u7537\u6027\u5668\u3092\u3042\u3066\u304c\u3046(\u4f55\u3059\u308b\u306e\u2026\uff1f\u3068\u8a00\u3063\u305f\u611f\u3058\u3067)\n\u30fb\u633f\u5165(\u7537\u6027\u5668\u3092\u900f\u904e\u3057\u7a81\u304b\u308c\u3066\u3044\u308b\u81a3\u5185\u3001\u5b50\u5bae\u53e3\u304c\u898b\u3048\u308b)\n\u30fb\u81a3\u5185\u5c04\u7cbe\n\u30fb\u5f15\u304d\u629c\u304d\u5f8c\u65ad\u9762\u56f3(\u7cbe\u6db2\u304c\u5375\u7ba1\u3092\u901a\u3058\u5c11\u3057\u5375\u5de3\u306b\u304b\u304b\u308b)\n\u30fb\u4e2d\u51fa\u3057\u5f8c\u304f\u3071\u3041\n\u30fb\u53d7\u7cbe\u63cf\u5199(\u5927\u91cf\u306e\u7cbe\u5b50\u304c\u5375\u5b50\u306b\u7fa4\u304c\u308a\u53d7\u7cbe)\n\u203b\u7740\u5e8a\u63cf\u5199(\u7d30\u80de\u5206\u88c2\u3057\u5b50\u5bae\u5185\u819c\u306b\u7740\u5e8a)\n\u203b\u3064\u308f\u308a(\u5614\u5410\u611f\u3092\u611f\u3058\u3066\u3044\u308b\u63cf\u5199)\n\u203b\u7740\u5e8a1\u301c2\u30f6\u6708\u306e\u80ce\u82bd\u304c\u3042\u308b\u5b50\u5bae\u65ad\u9762\u56f3(\u304a\u8179\u304c\u5c11\u3057\u3060\u3051\u81a8\u3089\u3080)\n\u30fb\u30cf\u30a4\u30e9\u30a4\u30c8\u7121\u3057(\u30ec\u30a4\u30d7\u76ee)\n\u30fb\u30dc\u30c6\u8179(\u5927\u304d\u304f\u81a8\u3089\u3093\u3060\u304a\u8179\u3001\u80f8\u5927\u304d\u3081\u3001\u9ed2\u305a\u307f\u7121\u3057\u3001\u6bcd\u4e73)\n\n\u203b\u306e\u5dee\u5206\u306b\u306f\u30c8\u30af\u30f3\u2026\u30c8\u30af\u30f3\u2026\u3068