がとうございました\nゼン\n\nhttps://drive.google.com/drive/folders/1pCDezh_ta0hNSET4F09RS39dkMH0_RGf?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Suku_Iwana/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1784296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f99d4cf745fa5a19e48d9b8374f15a78", "srcset": "https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f99d4cf745fa5a19e48d9b8374f15a78, https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b48fee6a3c8912fbcd0856188079f2b 2x, https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c9aca33c773ed818e09266ba24a895f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c2c93f8536a55cf4592a51e950c9fa0", "srcset": "https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c2c93f8536a55cf4592a51e950c9fa0, https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4bda82857d8539521038a3b92470d72a 2x, https://si.imgix.net/06fb61da/uploads/origins/ed412fe9-571e-4098-a43f-b9889ff55734?bg=%23fff&auto=format%2C