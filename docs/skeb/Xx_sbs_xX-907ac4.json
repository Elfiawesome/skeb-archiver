e\u3059\u3002\n\n\u69cb\u56f3\n - \u8179\u3070\u3044\u306b\u306a\u3063\u3066\u8db3\u3092\u4e0a\u3052\u3066\u3044\u308b\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3002\n - \u30d9\u30c3\u30c9\uff08\u9ed2\u307e\u305f\u306f\u30d9\u30fc\u30b8\u30e5\uff09\u306b\u6a2a\u305f\u308f\u3063\u3066\u3044\u308b\u3002\n - \u30b3\u30f3\u30c8\u30ed\u30fc\u30e9\u30fc\uff08\u9ed2\u3068\u7dd1\uff09\u3092\u6301\u3063\u3066\u3044\u308b\u3002\n - \u9262\u690d\u3048\u3092\u5de6\u53f3\u306b2\u3064\u305a\u3064\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\u3002\n - \u5f7c\u5973\u306e\u524d\u306b\u306f\u306c\u3044\u3050\u308b\u307f\u304c5\u4f53\u3044\u307e\u3059\uff1a\n\n1.\u30d3\u30fc\u30cb\u30fc\u3092\u304b\u3076\u3063\u305f\u30a8\u30f3\u30c0\u30fc\u30de\u30f3\u306e\u306c\u3044\u3050\u308b\u307f\n2.\u30d4\u30f3\u30af\u306e\u5c0f\u3055\u306a\u306c\u3044\u3050\u308b\u307f\n3.\u30b5\u30e1\u306e\u7740\u3050\u308b\u307f\u3092\u7740\u305f\u30ab\u30ef\u30a6\u30bd\u306e\u306c\u3044\u3050\u308b\u307f\n4.\u30ea\u30dc\u30f3\u4ed8\u304d\u30d0\u30cb\u30fc\u306c\u3044\u3050\u308b\u307f\n5.\u30b5\u30af\u30e9\u306e\u82b1\u3092\u3064\u3051\u305f\u30af\u30de\u306e\u306c\u3044\u3050\u308b\u307f\n\n\u8aac\u660e\u304c\u3061\u3087\u3063\u3068\u308f\u304b\u308a\u306b\u304f\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u3059\u3079\u3066\u306e\u306c\u3044\u3050\u308b\u307f\u3092\u4e00\u7dd2\u306b\u3057\u305f\u5199\u771f\u3092google\u30c9\u30e9\u30a4\u30d6\u306b\u8f09\u305b\u3066\u3044\u307e\u3059\u3002\u307e\u305f\u3001\u30dd\u30fc\u30ba\u306e\u53c2\u8003\u8cc7\u6599\u3001\u79c1\u306eVtuber\u30e2\u30c7\u30eb\u3001\u305d\u306e\u4ed6\u53c2\u8003\u306b\u306a\u308b\u5199\u771f\u3082\u3042\u308a\u307e\u3059\uff01\n\n\u50d5\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u9577\u6240\n - \u5927\u304d\u306a\u80f8\n - \u6bdb\u5148\u304c\u30c0\u30fc\u30af\u30d6\u30e9\u30a6\u30f3\u306e\u30d6\u30ed\u30f3\u30c9\u30d8\u30a2\n - \u76ee\u306e\u5468\u308a\u306e\u6fc3\u3044\u30a2\u30a4\u30b7\u30e3\u30c9\u30a6\n - \u30ea\u30dc\u30f3\u306e\u30dc\u30bf\u30f3\n - \u9577\u65b9\u5f62\u306e\u91d1\u8272\u306e\u30e1\u30ac\u30cd\n - \u305d\u3070\u304b\u3059\n - \u9854\u306e\u771f\u3093\u4e2d\u306b\u9577\u3044\u524d\u9aea\n\n\u5fc5\u8981\u30d5\u30a1\u30a4\u30eb\nPSD\u30d5\u30a1\u30a4\u30eb\u3067\u3001\u690d\u7269\u306f1\u3064\u306e\u30ec\u30a4\u30e4\u30fc\u306b\u3001\u30d9\u30c3\u30c9\u306e\u4e0a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306f2\u756a\u76ee\u306e\u30ec\u30a4\u30e4\u30fc\u306b\u3001\u306c\u3044\u3050\u308b\u307f\u306f\u5225\u306e\u30ec\u30a4\u30e4\u30fc\u306b\u3002\n\nhttps://drive.google.com/drive/folders/1r4FEG65XVa3OApv0Mi8i2Wmz1wu5rWAp\n\n\u5fc5\u8981\u3067\u3042\u308c\u3070\u3001\u4fa1\u683c\u306f\u3044\u304f\u3089\u3067\u3082\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\uff01\n\nhttps://drive.google.com/drive/folders/1r4FEG65XVa3OApv0Mi8i2Wmz1wu5rWAp", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Xx_sbs_xX/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3408404, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4cae070/uploads/origins/7e998fad-89d7-45c7-b5f0-a4ef564379ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8c543a778ce3b75a3a1e12bef4ed02", "srcset": "https://si.imgix.net/c4cae070/uploads/origins/7e998fad-89d7-45c7-b5f0-a4ef564379ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d8c543a778ce3b75a3a1e12bef4ed02, https://si.imgix.net/c4cae070/uploads/origins/7e998fad-89d7-45c7-b5f0-a4ef564379ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc19959db4e979192beaa056ad736258 2x, https://si.imgix.net/c4cae070/uploads/origins/7e998fad-89d7-45c7-b5f0-a4ef564379ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f71fb703eb121189cbe9c0fcffe1f67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consor