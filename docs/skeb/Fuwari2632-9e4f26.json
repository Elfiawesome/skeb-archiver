3-4ebf-bce5-b97e8ffb528d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e5ff14144d46df2ec9a70af272d5dfc, https://si.imgix.net/2d6c73c6/uploads/origins/bf16ca26-6333-4ebf-bce5-b97e8ffb528d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8882cffe76be4dd1f3c6ab0192804881 2x, https://si.imgix.net/2d6c73c6/uploads/origins/bf16ca26-6333-4ebf-bce5-b97e8ffb528d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=325f5ce3af20ed08b27c36b4a38353d4 3x"}, "body": "Hello.\nI'd got your appeal and I'd like to request on art piece.\n\nThe character will be Ayanna.\nIt's like for you to draw her in her ghoulish princess outfit.\nhttps://sta.sh/098m9ld2jp4\nhttps://sta.sh/0130fjglq8ws\nhttps://sta.sh/072ja8uous3\n\nI like the idea of her sitting on a throne. \nI'll give your full creative freedom on her throne room design.\nAll I ask is you make it look ghoulish and Halloween like. \nPlease do not make it demonic or demon like.\n\nFor her pose, Ayanna is a very sweet and kind hearted princess. She will be happy and waving to her subjects.\nGet creative and have fun", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Fuwari2632/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1397008, "client_id": 1968201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/278dc166/uploads/origins/da249ed0-17d1-4c7c-8815-629aafc1a74a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5a147141baca9de3861f67fd96a73c1", "srcset": "https://si.imgix.net/278dc166/uploads/origins/da249ed0-17d1-4c7c-8815-629aafc1a74a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5a147141baca9de3861f67fd96a73c1, https://si.imgix.net/278dc166/uploads/origins/da249ed0-17d1-4c7c-8815-629aafc1a74a?bg=%23fff&auto=format%2Ccompress&fm=webp&