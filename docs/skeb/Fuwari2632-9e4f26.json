ll, "private": false, "genre": "art", "tipped": true, "creator_id": 1223457, "client_id": 1397008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbf8297ad1f98a2b56d7b8d773b7080", "srcset": "https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acbf8297ad1f98a2b56d7b8d773b7080, https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b62cfd1b6e5ad1f2cad568c8cbe9d95 2x, https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdbbc1d54f7f66f16a351a54f10d76c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6dc4fa7ee8105c0ac8f0bd0b7a2b9eb", "srcset": "https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6dc4fa7ee8105c0ac8f0bd0b7a2b9eb, https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ee8fde56cf7566a1acc1d6546c8c95 2x, https://si.imgix.net/25085647/uploads/origins/715b1fd3-9f4b-4d81-b059-f4445bf2d62e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4787a652781c547065f8a132e7e8f9cf 3x"}, "body": "こんにちは、ふぇると申します！\nこの度ははこさんに鰯と柊自陣を描いていただきたくリクエストさせていただきました。\n以下、設定、使用用途をお送りいたします。\n\n▼設定\n(秘匿情報以外の、自分たちでつけた設定のみ抜粋しています)\nHO鰯(教祖)：久世 祈(くぜ いのり)\n性別：女性(公には非公開)\n身長：178cm\n\n・信者数1000人程度の新興宗教『拝掌教』の教祖。\n・よく言えば利他的、悪く言えば自己犠牲的な性格で、自分が抱え込むことで周囲が幸せになるならそれが一番だと無自覚に考えている節がある。\n・教祖自身は信者たちを家族として捉えており自身を過度に信仰されることを快く思っていない。\n・諦めたように微笑んでいることが多い。\n・拝掌教の教祖になってからは、多忙のあまり柊一(HO柊)と関わる機会が少なくなってしまったり、距離を感じたりして寂しく感じている。(ただ、それは自分のわがままだから…と気持ちを伝えていない)\n\nHO柊(信者)：柊一(しゅういち)\n性別：男\n身長：201cm\n\n・図体の割りに小心者。自分如きが教祖様と長時間話すこと、隣に立つことは恐れ多いと思っている自己肯定感の低さ。\n・祈のことを自分を救ってくれた唯一の神だと思っている。\n・彼女が望む世界を実現するためなら、自分という存在に価値など要らない。どんな罪でも、どんな犠牲でも、命すら差し出そうという考えがある。\n・たとえ自分の死が礎となるだけのものであっても構わない。\n・彼女には、今よりもさらに、誰よりも眩く輝いていてほしい。それこそが、自分の存在理由だと思い傍にいる。\n\n▼イラストの使用用途\n・個人利用\n・相方に見せる\n・アイコン、ヘッダー\n・グッズ作成\n\n外見は資料URLをご覧くださいませ。\n\nはこさんのSDキャライラストがとても可愛らしいと思い、リクエストさせていただきました✨ご検討いただけると幸いです😌\n\nhttps://drive.google.com/drive/folders/1xgV7fo-ZQBqok9V-4xsFmG-eMvlOlsBU", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 67600, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もつにଳ", "screen_name": "Doxxvz", "avatar_url": "https://pbs.twimg.com/profile_images/1996618916278542336/CE5s1ARy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4926361315/1763236465/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 161}, {"id": 2414966, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "奏井カナ🐣11/4電子単行本配信開始🐾", "screen_name": "kanai_kw", "avatar_url": "https://pbs.twimg.com/profile_images/1687689328343064577/p6Ckb5xw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1509882029613416450/1764927891/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "comp