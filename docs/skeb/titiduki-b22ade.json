tps://skeb.jp/@titiduki/works/3 so I want similar stuff : \n\n\u6575\u306b\u6355\u307e\u308a\u7e1e\u6a21\u69d8\u306e\u56da\u4eba\u670d\u3092\u7740\u305b\u3089\u308c\u3066\u624b\u9320\u3068\u9244\u88fd\u306e\u9996\u8f2a\u3092\u639b\u3051\u3089\u308c\u3001\u540d\u524d\u3068\u756a\u53f7\u304c\u66f8\u304b\u308c\u305f\u30d7\u30e9\u30ab\u30fc\u30c9\u3092\u6301\u305f\u3055\u308c\u3066\u308b\u3088\u3046\u306b\u3057\u3066\u4e0b\u3055\u3044\u3002\n\u30fb\u69cb\u56f3: \u5f7c\u5973\u306e\u4e73\u623f/\u4e73\u9996\u3068\u9670\u90e8/\u9670\u6bdb\u306e\u8996\u754c\u3092\u906e\u3089\u306a\u3044\u3067\u304f\u3060\u3055\u3044\n\u30ad\u30e3\u30e9 : \u30de\u30ea\u30e5\u30fc\u30fb\u30e9\u30df\u30a2\u30b9 (\u30ac\u30f3\u30c0\u30e0seed)\n\u30d7\u30e9\u30ab\u30fc\u30c9 : \n\u30fb\u30ab\u30fc\u30c9\u306f3\u5217\u306b\u8a2d\u8a08\u3055\u308c\u3066\u3044\u307e\u3059 : \u756a\u53f7 / \u72af\u884c / \u540d\u524d, \u305d\u308c\u306f\u82f1\u8a9e\u3067\u66f8\u304b\u308c\u3066\u3044\u307e\u3057\u305f\n\u30fb\u756a\u53f7\u306f\u30e9\u30f3\u30c0\u30e0\u306b\u3067\u304d\u307e\u3059 (10\u6841\u4ee5\u4e0a)\n\u30fb\u72af\u884c : Treason\n\u30fb\u540d\u524d : Murrue Ramius\n\u30fb\u56da\u4eba\u670d\u306e\u4e0a\u534a\u8eab\u306f\u304a\u8179\u304c\u898b\u3048\u308b\u3088\u3046\u306b\u77ed\u304f\u3057\u3066\u6b32\u3057\u3044\u3067\u3059\u3002 --> \u53c2\u8003:\u56da\u4eba\u670d.jpg\n\u30fb\u5168\u88f8\u5dee\u5206\u3082\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u30fb\u8db3\u9320 (\u5168\u8eab\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059) --> \u53c2\u8003:\u624b\u9320\u8db3\u9320.jpg\n\u30fb\u80f8\u306f\u5927\u304d\u3044\u304c\u5927\u304d\u3059\u304e\u306a\u3044\u7f8e\u5de8\u4e73\n\u30fb\u8868\u60c5 (\u9854\u306f\u6094\u3057\u3052 vs \u9854\u306f\u6065\u305a)\n\n\u4ee5\u4e0b\u5dee\u5206\u3092\u5207\u308a\u66ff\u3048\u3089\u308c\u308b\u3088\u3046\u306b\u7d30\u304b\u304f\u30ec\u30a4\u30e4\u30fc\u5206\u3051\u3092\u304a\u9858\u3044\u3057\u307e\u3059:\n\u30fb\u6fe1\u308c\u305f\u9670\u9580 (\u6709/\u7121)\n\u30fb\u624b\u9320\n\u30fb\u8db3\u9320\n\u30fb\u9244\u88fd\u306e\u9996\u8f2a --> \u53c2\u8003:\u9244\u88fd\u306e\u9996\u8f2a.jpg\n\u30fb\u8868\u60c5\n\u30fb\u50b7\u8de1 (\u6709/\u7121)\n\u30fb\u5168\u88f8\n\u30fb\u30d7\u30e9\u30ab\u30fc\u30c9\n\u30fb\u9670\u6bdb --> \u53c2\u8003:\u9670\u6bdb.jpg\n\u30fb\u80cc\u666f\n\u5b8c\u6210\u54c1\u30b5\u30a4\u30ba\u306f\u4e00\u8fba4000\u4ee5\u4e0a\u7a0b\u5ea6\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u53ef\u80fd\u306a\u7bc4\u56f2\u3067\u69cb\u3044\u307e\u305b\u3093\u306e\u3067\u3001\u30ad\u30e3\u30e9\u3084\u80cc\u666f\u306a\u3069\u30ec\u30a4\u30e4\u30fc\u7d50\u5408\u524d\u306ePSD\u5f62\u5f0f\u3067\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\u3002\n\u5c0f\u8aac\u306e\u633f\u7d75\u306e\u3088\u3046\u306a\u4f7f\u3044\u65b9\u3067Pixiv/SNS\u63b2\u8f09\u3059\u308b\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002\n\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\uff01\n\nhttps://drive.google.com/drive/folders/14kGLTCrZIrismObwfrrgy293AfETQoLu?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@titiduki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 780692, "client_id": 138627, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c65b8d70/uploads/origins/5bd16987-3f4a-4e61-81da-aca947fb3891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10114ef5089f7ab40361683fa299a79b", "srcset": "https://si.imgix.net/c65b8d70/uploads/origins/5bd16987-3f4a-4e61-81da-aca947fb3891?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10114ef5089f7ab40361683fa299a79b, https://si.imgix.net/c65b8d70/uploads/origins/5bd16987-3f4a-4e61-81da-aca947fb3891?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=759126ad9bc2c157820bf06337ec5a47 2x, https://si.imgix.net/c65b8d70/uploads/origins/5bd16987-3f4a-4e61-81