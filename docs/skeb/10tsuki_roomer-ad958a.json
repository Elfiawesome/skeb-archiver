色でフチが紫、影の部分は緑がかって見える\n下がり眉・泣きぼくろ・黒ネイル\nモチーフ：逆さまの紫ハート、毒\n\n\n以下は自己紹介になりますが、ポーズや構図などの参考になりましたら幸いです。\n\n妄想が趣味の一般人Vtuberです。\n部屋に引き篭もりがちで、心の中の大切な誰か(“同居人くん”)と一緒に暮らす妄想に浸りながら生活しています。(ユニコーンのような生物も妄想上の存在です)\nあまり自信が無く、緊張したり照れたりすることが多めです。\n多少のヤンデレ要素を含みますが、普段は抑え気味に、穏やかな言動を心がけています。\n\n\n不慣れなもので、不手際がありましたら申し訳ございません……。\nお忙しい中恐れ入りますが、ご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1nJkV8EjdGKOigZufhUgZPGF9Lxywx_sr/view", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@you_night/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2405523, "client_id": 2500434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf1b6fab/uploads/origins/bce90004-acf8-4790-a922-048253c6a13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3135ab58d941e708afbc5d35df4e968e", "srcset": "https://si.imgix.net/cf1b6fab/uploads/origins/bce90004-acf8-4790-a922-048253c6a13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3135ab58d941e708afbc5d35df4e968e, https://si.imgix.net/cf1b6fab/uploads/origins/bce90004-acf8-4790-a922-048253c6a13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc3fabaf3bc263169a2c0041dd012e35 2x, https://si.imgix.net/cf1b6fab/uploads/origins/bce90004-acf8-4790-a922-048253c6a13d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cc921d716cf1a2d6da7679d2a4ac7151 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf1b6fab/uploads/origins/bce90004-acf8-4790-a922-048253c6a13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3359c7f279eb6f98352da71ed4be396d", "srcset": "https://si.imgix.net/cf1b6fab/uploads/origins/bce90004-acf8-4790-a922-048253c6a13d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3359c7f279eb6f9835