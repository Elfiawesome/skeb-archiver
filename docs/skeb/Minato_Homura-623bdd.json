a-b83c-b5601cfe2955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e15e780be1393b1ed0b77bdf7abefea6 2x, https://si.imgix.net/24ab379b/uploads/origins/eccd2c6c-fab1-401a-b83c-b5601cfe2955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cf125fd9a8b0b363fe21d5a9dd43e8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24ab379b/uploads/origins/eccd2c6c-fab1-401a-b83c-b5601cfe2955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf5720d6b193a6c574d7193a5c03ff05", "srcset": "https://si.imgix.net/24ab379b/uploads/origins/eccd2c6c-fab1-401a-b83c-b5601cfe2955?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf5720d6b193a6c574d7193a5c03ff05, https://si.imgix.net/24ab379b/uploads/origins/eccd2c6c-fab1-401a-b83c-b5601cfe2955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8950ee3f421f002272bc3fbb5ff37652 2x, https://si.imgix.net/24ab379b/uploads/origins/eccd2c6c-fab1-401a-b83c-b5601cfe2955?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca1ff493376d1583e3e0ed4d3194da8b 3x"}, "body": "HoMURAさん初めまして。\nウマ娘にてskeb依頼を掛けられそうな方を探していた所、HoMURAさんのことを見つけさせて頂きました。\nお可愛い絵柄と溢れんばかりのスズカさん愛を見込みまして、よろしければウマ娘の「サイレンススズカ」に「トサキントレオタード」をコスプレさせたイラストをお願いできますか。\n（※トサキントレオタード→初代のポケモンアニメ43話「ナッシーぐんだん　だいこうしん！」で、カスミがマジシャンのアシスタントの際に着用していた、トサキントを模した衣装を指してます）\n\n衣装の造形につきましては資料ページのURLを添付いたしますので、ご参考頂ければと存じます。\nコスプレ絵なのは完全に自分の趣味となりますため、元ネタをご存じないだろうことは覚悟の上ですが、それでもよろしければお願いさせて頂きたく存じます……！\n※余談ですが、Xにて呟かれていた直近の企画の1枚として使って頂いても問題ないです。（むしろ多くの人に見せて頂ける方が本望ですｗ）\n\n表情や構図・ポーズ、あと多少のアレンジなどについては、HoMURAさんが良いと思ったまま、ご想像されるままのスズカのリアクションで描いて頂ければOKです。薄着に恥じらうスズカさんも良し、身軽で走りやすさが先立って満更でも着こなすでも良し、水着スズカさんの水面を走る固有のイメージを参考にしてもしなくても、とにかくHoMURAさんがイメージするスズカさんでアウトプットして頂ければと存じます！\n\nまた、コスプレ（衣装）姿がメインなので、せめて全身絵で衣装姿を堪能させて頂ければ特に嬉しく思います。センシティブに配慮してストッキング履かせる等の微アレンジを加えて頂く等は問題ないです。もちろん原作デザインそのままに素足で描かれてもOKです！\n（だけどロングな手袋が性癖なので、アレンジしても手袋は忘れないで頂ければとてもすごく嬉しいです……）\n\n知らない衣装のため、やや無茶な依頼は承知しておりますが、それでもよろしければ何卒お願いいたします！\n\nhttps://bulbapedia.bulbagarden.net/w/index.php?title=File:Misty_Goldeen_outfit.png", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Minato_Homura/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3463824, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bb77ade/uploads/origins/43e7578f-8b2f-4cc9-ad59-9bb778f1c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0946fe2e28a4ed471a23af08627771f9", "srcset": "https://si.imgix.net/7bb77ade/uploads/origins/43e7578f-8b2f-4cc9-ad59-9bb778f1c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0946fe2e28a4ed471a23af08627771f9, https://si.imgix.net/7bb77ade/uploads/origins/43e7578f-8b2f-4cc9-ad59-9bb778f1c061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=491f63baa1b2b8bffde6058e8a0ac59c 2x, https://si.imgix.net/7bb77ade/uploads/origins/43e7578f-8b2f-4cc9-ad59-9bb778f1c061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0adf7a919e564841884470c370213ee4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bb77ade/uploads/origins/43e7578f-8b2f-4cc9-ad59-9bb778f1c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f787aad12c6ead97d70dfb5d9a1e781c", "srcset": "https://si.imgix.net/7bb77ade/uploads/origins/43e7578f-8b2f-4cc9-ad59-9bb778f1c061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f787aad12c6ead97d70dfb5d9a1e781c, https://si.imgix.net/7bb77ade/uploads/origins/43e7578f-8b2f-4cc9-ad59-9bb778f1c061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5