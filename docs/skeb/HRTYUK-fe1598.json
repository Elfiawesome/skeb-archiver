-4bff-b311-04f7d4ae9eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63cd06f0d461aff45b94ab24a96cb193, https://si.imgix.net/7a101a1b/uploads/origins/fa3cf48c-e763-4bff-b311-04f7d4ae9eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac23316112768095401627239e515b13 2x, https://si.imgix.net/7a101a1b/uploads/origins/fa3cf48c-e763-4bff-b311-04f7d4ae9eb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e6da4e65cda73684194c7d4b4924946 3x"}, "body": "小倉んぱん さま\n\nはじめまして。\nむっちりでかわいい女の子のイラストをpixivで見てきました。\n私が推している活動者さんのイラストを描いて頂きたく、リクエストを送らせていただきます。\n\n【希望内容】\n個人VTuberの「YuuRi」さんのイラストを描いて頂きたいです。\n資料：https://clinkme.jp/yuuriu\n※二次創作は許可されています。\n\n性格(イメージ)は、ドSのお姉さんです。\n悪酔いしてだる絡みしてくる色気たっぷりのお姉さんが見てみたいです。\n魅惑の谷間もあれば嬉しいです。\n\n【構図・衣装など】\n構図、ポーズ、背景等はお任せします。\n頭と肩などが見切れないイラストを希望します。\n通常衣装（ショートヘア）でお願いします。\n\n【使用目的】\n本人次第となりますが、YuuRiさんが活動に使用することを許可いただきたいです。\nSNSでの利用および収益化されているYouTubeでのサムネイルや有料記事を含むFANBOX等での使用が想定されます。\n上記が大丈夫な場合に、受け入れていただければ幸いです。\n\n【納品形式】\nPSDデータ（キャラクターと背景は別レイヤー）でお願いできれば嬉しいです。\n\nご検討のほど、よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HRTYUK/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2081028, "client_id": 2909469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddb6f6fe/uploads/origins/dab3b015-8d37-4c29-8c43-fd91ad1fbe31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a739d2a434353b998bab19662e1c9bf", "srcset": "https://si.imgix.net/ddb6f6fe/uploads/origins/dab3b015-8d37-4c29-8c43-fd91ad1fbe31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a739d2a434353b998bab19662e1c9bf, https://si.imgix.net/ddb6f6fe/uploads/origins/dab3b015-8d37-4c29-8c43-fd91ad1fbe31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=636d059d7b90