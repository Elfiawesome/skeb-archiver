ガウェアを着た、豊満な胸の肉付きの良い熟女。トップスは透けている。1: 試合前のリング上での対峙。女性はグローブを打ち鳴らして挑発し、欲情した表情を浮かべている2: 試合中盤。 女性は完全に圧倒され、痣だらけで乳首がトップから滑り出している。腹部にストレートパンチを受けロープに叩きつけられる。3: ロープにぶら下がり、完全に露出した両胸が左右同時に殴打され押しつぶされる。4: 強烈な腹部パンチを受け、息が完全に抜ける。パンチでロープに押し付けられ、潮を吹く。\n5: KOシーン。一人称視点ではない。床に顔を下にして横たわり、胸の間に顔を挟まれ、尻を突き上げ、びしょ濡れの股間からまだ液体が滴り落ちている。カウントを8から10まで記述してください。https://drive.google.com/drive/folders/1qevxyz8Pjhbookl_Uc3dxhd4MC-N2JQL?usp=sharing", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harada_19/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a558e58b/uploads/origins/af414377-b078-46af-a47a-e618093afbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9d959544244cbd99619ff9e95a1784e", "srcset": "https://si.imgix.net/a558e58b/uploads/origins/af414377-b078-46af-a47a-e618093afbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9d959544244cbd99619ff9e95a1784e, https://si.imgix.net/a558e58b/uploads/origins/af414377-b078-46af-a47a-e618093afbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0018788c0e822a9c0781cb80b010c513 2x, https://si.imgix.net/a558e58b/uploads/origins/af414377-b078-46af-a47a-e618093afbb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=13de48d1cf1f1110d9e434aa1c195706 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3164193, "nc": 48}, {"path": "/@harada_19/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3164193, "client_id": 3817963, "vtt_url":