ator_acceptable_same_genre": true}, {"path": "/@twyunan/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6ed58e36/uploads/origins/92bf978d-c150-41cd-b264-fa70708387f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df74823682258627f71cc7ca87c7a04e", "srcset": "https://si.imgix.net/6ed58e36/uploads/origins/92bf978d-c150-41cd-b264-fa70708387f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=df74823682258627f71cc7ca87c7a04e, https://si.imgix.net/6ed58e36/uploads/origins/92bf978d-c150-41cd-b264-fa70708387f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=61de93d5ae812907827ac8ecbfffe3dd 2x, https://si.imgix.net/6ed58e36/uploads/origins/92bf978d-c150-41cd-b264-fa70708387f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65c8e0f65e97bc24d9cdda316d390bd6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 627285, "client_id": 1339366, "nc": 129}, {"path": "/@twyunan/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 627285, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17018974/uploads/origins/cd39279e-33e6-46f5-a3d7-c110e285168b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3716a8d1f05c481d231271340faac085", "srcset": "https://si.imgix.net/17018974/uploads/origins/cd39279e-33e6-46f5-a3d7-c110e285168b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3716a8d1f05c481d231271340faac085, https://si.imgix.net/17018974/uploads/or