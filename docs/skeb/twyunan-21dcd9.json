縮ですが、ご検討のほどよろしくお願いいたします。\nhttps://drive.google.com/drive/folders/1mh8MJa-2FFF-T0mIz09jVI66MupUbkFi?usp=share_link", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@twyunan/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 627285, "client_id": 3381692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b7256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812e8e398db7eb9f1141a2b848571c86", "srcset": "https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b7256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=812e8e398db7eb9f1141a2b848571c86, https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b7256?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=753e05901f06991e1f2bf0881b938c4d 2x, https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b7256?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4fc3d3178ee0354625eb819cc3f1aa5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b7256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd020f70d3792b6ac2c13bb459564ac1", "srcset": "https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b7256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd020f70d3792b6ac2c13bb459564ac1, https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b7256?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e435f310dee05c2f24707acfc490675 2x, https://si.imgix.net/b2252f9b/uploads/origins/8e2241a4-2b71-4d02-9021-1ddca94b