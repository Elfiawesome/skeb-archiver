描いて、にやにやしてほしい。\n\nゲームのスクリーンショットがジャックの正確な服装だが、他のアートワークで見られるような修正を加えた。違う目の形、スパイクのついた襟、黒い爪、ダークジムのロゴのピン、スマイリーフェイス、トランスジェンダーの旗、バイセクシャルの旗。また、スクリーンショットのスタッズ付きスーツケースの代わりに、黒いギターケースを右肩にかけている。また、耳にはピアスがいくつかあり、髪の左側には黒いハイライトが入っている。\n\nこのリクエストが受け入れられることを願っています！\n\nhttps://drive.google.com/drive/folders/1-5NtfiIRucWQtpK3RGbQ4p-YpfyR9Khq", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@34_59201063652/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78f8cbec/uploads/origins/ca2b6627-427d-4978-a221-d62fd02c3364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9183887dd521a484447903908e876e12", "srcset": "https://si.imgix.net/78f8cbec/uploads/origins/ca2b6627-427d-4978-a221-d62fd02c3364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9183887dd521a484447903908e876e12, https://si.imgix.net/78f8cbec/uploads/origins/ca2b6627-427d-4978-a221-d62fd02c3364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1824fdd6d17508f5401e33bc38b0e1d9 2x, https://si.imgix.net/78f8cbec/uploads/origins/ca2b6627-427d-4978-a221-d62fd02c3364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=85bc6d87ac517c8bdfad46c7f410446b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2301377, "client_id": 2807637, "nc": 129}, {"path": "/@34_59201063652/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2301377, "client_id": 2698681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.i