293-4a4a-9d4d-defc398f2a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70c813e1d0ca382d2a67b0c6402085eb, https://si.imgix.net/5cd026d3/uploads/origins/61af5b06-8293-4a4a-9d4d-defc398f2a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67642e1920c427dc8328bf0374aec6fa 2x, https://si.imgix.net/5cd026d3/uploads/origins/61af5b06-8293-4a4a-9d4d-defc398f2a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16f64f7ac44ca4030067c930a81612b8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5cd026d3/uploads/origins/61af5b06-8293-4a4a-9d4d-defc398f2a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15f2452028c02ef51b405e279fab75e4", "srcset": "https://si.imgix.net/5cd026d3/uploads/origins/61af5b06-8293-4a4a-9d4d-defc398f2a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15f2452028c02ef51b405e279fab75e4, https://si.imgix.net/5cd026d3/uploads/origins/61af5b06-8293-4a4a-9d4d-defc398f2a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd342d0455c7a56103f2c1cd892e3303 2x, https://si.imgix.net/5cd026d3/uploads/origins/61af5b06-8293-4a4a-9d4d-defc398f2a14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b82c2c572149e79a12eec51a51e0e4e2 3x"}, "body": "除湿様、こんにちは~！私は貴方が描かれた「競走馬少年」が大変好きです！！そこで関連するお願いがあります：私のOCはボディスーツ一枚のみを着用し（ヘッドホン・手袋・靴は無し、但しドラゴンの尾と角あり、体格は競走馬少年より若干逞しい）、競走馬少年のベッドの上に横たわっています。レーシング用のコンテンショントップとタイツを着た競走馬少年が私の上に覆い被さり、私の身長は競走馬少年より半頭分高く、少年の股間は私の臀部に密着しています。少年の両足が開いてベッドの上に跪いている、少年は舌を出し、非常に絶頂的な表情で私の両眼を見つめ、両手で私のコンテンショントップの胸部を触っています。同時に私は両掌で少年のコンテンショントップの胸部を揉みながら、両脚で少年の腰と臀部を絡み抱え、私の尾の先端は少年の尻穴に挿入されピストン運動しています。二人とも汗まみれで、コンテンションには明確な身体の筋肉の輪郭が浮き出ています。私は快楽の表情で「最優秀な種馬は毎日人工採精が必要ですぞ〜私は貴方の全ての良質な精子を受け入れます〜」と語りかけ、少年は「んぁ…また射精しちゃう…もう止まらない…種馬最高だ…」などと喘ぎながら断片的に応答します。身体部位を遮らない位置に【少年の陰茎が私の尻穴に挿入され大量射精する断面図】を入れて頂きたいです。ベッド脇の棚には競走馬少年の優勝カップが数個置かれています。全体の視点から二人の身体の大部分が見えるようにお願い致します。\n\nhttps://drive.google.com/drive/folders/1AQonX9rRt3dNWNG7vYNAG2GXuT4ptKRh?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jyositsu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3366812, "client_id": 201020, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b44eb28/uploads/origins/41b8499d-88cc-4544-9ae0-9ad938ebd55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efb29696757d3668748abe680c025567", "srcset": "https://si.imgix.net/5b44eb28/uploads/origins/41b8499d-88cc-4544-9ae0-9ad938ebd55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efb29696757d3668748abe680c025567, https://si.imgix.net/5b44eb28/uploads/origins/41b8499d-88cc-4544-9ae0-9ad938ebd55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db8de01a8a79af2a7875eb2730a65bcb 2x, https://si.imgix.net/5b44eb28/uploads/origins/41b8499d-88cc-4544-9ae0-9ad938ebd55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b36232e383617914c4cdfc647964dfd5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b44eb28/uploads/origins/41b8499d-88cc-4544-9ae0-9ad938ebd55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dd65f9692dcab57476a8e914d83eba2", "srcset": "https://si.imgix.net/5b44eb28/uploads/origins/41b8499d-88cc-4544-9ae0-9ad938ebd55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dd65f9692dcab57476a8e914d83eba2, https://si.imgix.net/5b44eb28/uploads/origins/41b8499d-88cc-4544-9ae0-9ad938ebd55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a1f6cecb8eca4dcc7cb6da8678e4be7 2x, https://si.imgix.ne