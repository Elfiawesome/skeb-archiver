納豆菌が強すぎて、ワイン、焼酎、日本酒の酵母が全部納豆菌に汚染されてしまい、お酒の作れない身体にされてしまったと号泣する・・・・・というオチで。\n\nhttps://togetter.com/li/1147949", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Asano_g/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1159096, "client_id": 103857, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bf24a04f32f8315fca24bfa5f0fc781", "srcset": "https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bf24a04f32f8315fca24bfa5f0fc781, https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f27b789614b0cd8e2ba6e8433bac5c1 2x, https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d72df9a06f17252c08a40888fceddd6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6973b81ce0ffa036a5cc83ebb7bfca0", "srcset": "https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6973b81ce0ffa036a5cc83ebb7bfca0, https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80a857daecc556b6e6ae426163df212a 2x, https://si.imgix.net/2f5e1075/uploads/origins/bfff43b2-1f5e-4522-afd5-e377a0f21029?