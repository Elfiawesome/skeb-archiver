u30eb\u3067\u4f7f\u3044\u305f\u3044\u306e\u3067\u8170\u4e0a\u4ee5\u4e0a\u3001\u307e\u305f\u306f\u5168\u8eab\u3060\u3068\u5b09\u3057\u3044\u3067\u3059) \n\u30fb\u4e0a\u3001\u5de6\u53f3\u3001\u9aea\u306e\u6bdb\u7b49\u898b\u5207\u308c\u3066\u3044\u306a\u3044\u72b6\u614b\u3067\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059 \n\u30fb\u30dd\u30fc\u30ba\u3084\u8868\u60c5\u306f\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059 \n\u30fb\u8868\u60c5\u5dee\u5206\u3082\u3042\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u304c\u96e3\u3057\u3044\u5834\u5408\u306f\u5927\u4e08\u592b\u3067\u3059\uff01 \n\u30fb\u53ef\u80fd\u3067\u3057\u305f\u3089\u80cc\u666f\u306f\u30b5\u30e0\u30cd\u30a4\u30eb\u3067\u4f7f\u3044\u3084\u3059\u3044\u3088\u3046\u306b16:9\u3067\u3059\u3068\u3042\u308a\u304c\u305f\u3044\u3067\u3059...\uff01(\u96e3\u3057\u3044\u5834\u5408\u306f\u5927\u4e08\u592b\u3067\u3059\uff01) \n\u30fb\u4e09\u9762\u56f3\u306f\u306a\u3044\u306e\u3067\u3001\u898b\u3048\u306a\u3044\u90e8\u5206\u3084\u308f\u304b\u308a\u3065\u3089\u3044\u90e8\u5206\u306f\u88dc\u5b8c\u3057\u3066\u3044\u305f\u3060\u3044\u3066\u69cb\u3044\u307e\u305b\u3093 \n\u30fbpsd\u307e\u305f\u306f\u3001\u80cc\u666f\u3068\u4eba\u7269\u3092\u5206\u3051\u305f\u30c7\u30fc\u30bf\u3067\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059  \n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\n \u30fbTwitter\u3067\u306e\u544a\u77e5\u3001\u30b5\u30e0\u30cd\u30a4\u30eb\u5229\u7528(\u53ce\u76ca\u5316\u6e08\u307f)  \n\n\u203b\u80cc\u666f\u306b\u95a2\u3057\u3066\u3001\u30b5\u30e0\u30cd\u30a4\u30eb\u306b\u4f7f\u3046\u5834\u5408\u3001\u96d1\u8ac7\u3084\u6b4c\u67a0\u306a\u3069\u306e\u30ed\u30b4\u3084\u30d5\u30a9\u30f3\u30c8\u3068\u7d44\u307f\u5408\u308f\u305b\u3066\u4f7f\u7528\u3044\u305f\u3057\u307e\u3059 \u307e\u305f\u3001\u4ed6\u30a4\u30e9\u30b9\u30c8(\u4ed6\u306e\u30a4\u30e9\u30b9\u30c8\u30ec\u30fc\u30bf\u30fc\u3055\u3093\u304c\u63cf\u3044\u305f\u4eba\u7269\u30a4\u30e9\u30b9\u30c8\uff0b\u307d\u3063\u3077\u3061\u3083\u3093\u304c\u63cf\u3044\u305f\u80cc\u666f