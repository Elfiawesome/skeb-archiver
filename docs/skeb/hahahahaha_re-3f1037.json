8df7472f1917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=945f60fd52ed9d3466bb4117c101239f", "srcset": "https://si.imgix.net/07f1db21/uploads/origins/d2d3fbff-e903-4f3b-8338-8df7472f1917?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=945f60fd52ed9d3466bb4117c101239f, https://si.imgix.net/07f1db21/uploads/origins/d2d3fbff-e903-4f3b-8338-8df7472f1917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd69ec7d1d36a21148f04bdb6096c0f6 2x, https://si.imgix.net/07f1db21/uploads/origins/d2d3fbff-e903-4f3b-8338-8df7472f1917?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=725a3dda6364d4820ee7bb2380ea02df 3x"}, "body": "ゆきちゃんのイラストありがとうございました！最高でした…！\n昨日の今日で恐縮ですが、またリクエストさせていただけたらと思います。\nまた、まなみちゃんと照井くんをお願い出来ますでしょうか。\n照井くんを四つん這いにさせて、まなみちゃんがお尻をいじってひたすら喘がせている構図で、下記のとおり3つ差分を、挙げているようなセリフ込みでお願いしたいです。\n服装については、まなみちゃんが制服、照井くんは上は制服、下は制服のズボン脱ぎかけでお願いします。また、陰茎にはゴム装着させていただけたらと思います。\n\n①指でお尻をほじるまなみちゃん\nま「またお尻でごめんね、楽しくて♡このあたりが前立腺かな？どう？気持ちいい？」\n照「お、おい、やめ……あ゛っ♡」\nま「こんなかわいい声出るんだ〜♡そろそろ解れてきたかな？じゃ、私がいつも使ってるの入れるね…♡」\n②太いディルドでお尻をいじるまなみちゃん\n照「そ、そんな大きいの入ら…お゛っ」\nま「入っちゃったね…♡あ、この辺りが気持ち良いのかな…？♡」\n③果てる照井くん\n照「も、もうやめ…あ゛っ、お゛お゛っ〜♡」\nま「たくさん出したね…♡ちゃーんと全部飲んであげるからね♡」\nこの時のは強調するくらいたくさんの射精量でお願いできたらと思います。\n\n超長文となりすみません！よろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hahahahaha_re/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3483411, "client_id": 31503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03084b415f36bbb73e6762b120d4ace1", "srcset": "https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03084b415f36bbb73e6762b120d4ace1, https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65071c8af42fc2848be611dd58972e8d 2x, https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65356704caecd0d2d17e9816a5c6b4ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=126b119385cd8c87b5595e378c637031", "srcset": "https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=126b119385cd8c87b5595e378c637031, https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e680bb57bc0056dd7eaea69cccfbf0a 2x, https://si.imgix.net/9bbde981/uploads/origins/d82d1700-8354-4c80-9fb6-adb385797679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca80a7ee809cd14481a112250484e8d4 3x"}, "body": "リクエストさせていただきます。\nひみつのアイプリ　五十嵐じゅりあちゃんと六堂えるちゃんのW太ももで射精シチュお願いします。\n\nえるちゃんのH小説執筆活動+皮被りおちんちんがお気に入りのH覚えたてじゅりあちゃんによるひみつのおちんちん搾精。\n\nアイプリバース配信では特にラブジュリエルのむちむちな太ももでティッシュやオナホールへ精液をコキ捨ててきたプリトモ男性。生じゅりえるとの対面に興奮が止まらない状況。\n\n至近距離にはパラダイス学園の女子生徒がふたり。\n股間がウズウズしてくるようなギャル声と口調はアイプリのじゅりあちゃんのそれで、そしてもう一人の物静かな少女は耳元で湿度が籠った囁き声で…\n\n「…まんこ」♡\nこの声は間違いなくアイプリのえるちゃんなのにイメージと正反対な下品な言葉づかいで脳がバグってしまい、同時にガチガチに膨れあがる肉棒。\nたったひと言でおちんちんが一番喜ぶ言葉を言い当てられて、耳元で再び繰り返せばビクンビクンと跳ねるおちんちん♡\n完全に射精の主導権を握られてじゅりあちゃんからは「バズかわいい〜♡」と皮かぶり勃起ペニスを愛でられ、恥ずかしさから足を閉じようとするもふたりの太ももでぎゅっと挟まれてしまい、そのまま包茎ちんぽを剥き剥きされてしまう。\n剥かれた皮に溜まったおちんちんの汚れとニオイがふたりをムラムラさせてパンツの中を濡らし、じゅりあちゃんも「アソコ」ではなく「まんこ」と口から発して男の射精を煽りはじめる。\nそしてじゅりあちゃんが隣にいると積極的にいやらしい表情になっていくえるちゃん。\n\n「えるとじゅりあにちょーだい」♡と精液をねだるえっちな天使と悪魔の太ももまんこでびゅるびゅる射精するところをじっくり見つめられちゃうシチュをお願いします。\n\nふたりの衣装はパラダイスがくえんせいふく1ねん+スカート部分が捲れて一部パンチラしている状態。\n\n男性の体毛や陰毛ありで、ふたりのペニスの呼び方は先生にお任せいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hahahahaha_re/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3483411, "client_id": 2307606, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed43061a/uploads/origins/b0d73499-b1fc-4574-9b31-ac31c335d665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed6299ebf11b2a23b7ef144aa24bd99a", "srcset": "https://si.imgix.net/ed43061a/uploads/origins/b0d73499-b1fc-4574-9b31-ac31c335d665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed6299ebf11b2a23b7ef144aa24bd99a, https://si.imgix.net/ed43061a/uploads/origins/b0d73499-b1fc-4574-9b31-ac31c335d665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d12c21168634526a744a73198c825c1 2x, https://si.imgix.net/ed43061a/uploads/origins/b0d73499-b1fc-4574-9b31-ac31c335d665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41d3c606f0c66a9dad3816c360f23cfd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed43061a/uploads/origins/b0d73499-b1fc-4574-9b31-ac31c335d665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da59f6b37631cb413a42722afba79098", "srcset": "https://si.imgix.net/ed43061a/uploads/origins/b0d73499-b1fc-4574-9b31-ac31c335d665?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da59f6b37631cb413a42722afba79098, https://si.imgix.net/ed43061a/uploads/origins/b0d73499-b1fc-4574-9b31-ac31c335d665?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200