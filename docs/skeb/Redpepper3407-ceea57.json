U6e7o\nhttps://imgur.com/a/3zpoOMJ\n邪心に染めされられ敵の尖兵に\nhttps://imgur.com/a/qjMjvOa\nhttps://imgur.com/a/meBPl5b\nhttps://imgur.com/a/mlFQZtI\nhttps://imgur.com/a/jwB4w4s\nhttps://imgur.com/a/MbB9R5e\nhttps://imgur.com/a/AQj43bV\n支配に抗い切る時\nhttps://imgur.com/a/bRkYvz1\nhttps://imgur.com/a/zAyMwH6", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Redpepper3407/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/521d6164/uploads/origins/ecc78bff-7afe-44bc-a32d-3decb45cb840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc425bc66024b85c1d1cfaf20be1d692", "srcset": "https://si.imgix.net/521d6164/uploads/origins/ecc78bff-7afe-44bc-a32d-3decb45cb840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc425bc66024b85c1d1cfaf20be1d692, https://si.imgix.net/521d6164/uploads/origins/ecc78bff-7afe-44bc-a32d-3decb45cb840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e23601acee0dab97e4cd48327807d18d 2x, https://si.imgix.net/521d6164/uploads/origins/ecc78bff-7afe-44bc-a32d-3decb45cb840?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57b9f4e68ffa9c8905917632247a8e5b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1422576, "nc": 161}, {"path": "/@Redpepper3407/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1422576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7dd66d1/uploads/origins/23dc229f-a399-44c5-b59d-df41c75df130?bg=%23ff