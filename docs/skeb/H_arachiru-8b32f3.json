bp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b132b94e6f168e371a239f3badba38d5 3x"}, "body": "こんにちは！\n\n美麗なイラスト、楽しみに拝見しております！はらちるさんの描かれる美し格好良い男子が大好きです！\n\n今回お願いしたいのは、私の創作漫画のヴィンスというキャラです。\n\n古いですが設定資料↓\nhttps://x.com/karamomo_hana/status/1436341174839623685?t=uMvebT4kH9jyYRc0aVD8Vg&s=19\n\n最新絵↓\nhttps://x.com/karamomo_hana/status/1889591891076784154?t=cX2x6J3KUB8ko-RVnycNpw&s=19\n\n固定の衣装はないのですが、作中では基本的にスーツを着用させています。(私の)好みは上がワイシャツ＋ベストで、腕まくりしていたら最高です。\nそこそこお顔も楽しみたいので、全身構図でなくて大丈夫です。\n設定資料に使う色を載せていますが資料が古く参考にしづらいと思いますので、最新絵から色を取って何となく色付けしていただいてかまいません。\n\nざっくりとした内容ですが、ご検討いただけると幸いです。\nよろしくお願いします。\n\nhttps://x.com/karamomo_hana/status/1436341174839623685?t=uMvebT4kH9jyYRc0aVD8Vg&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@H_arachiru/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2391002, "client_id": 2859885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a56a8f4f35c0aa041f8e0838ee9bb3d", "srcset": "https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a56a8f4f35c0aa041f8e0838ee9bb3d, https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bac8626531c93ccae40eb7a8d7c4f748 2x, https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cc3e948cfa4baf153f68e946da3bb6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b46bd85df268c0366b9916c3abbd81a7", "srcset": "https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b46bd85df268c0366b9916c3abbd81a7, https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83360da894e49d22fddcb169f438201c 2x, https://si.imgix.net/2da4bbf6/uploads/origins/2c8e579f-bf89-4012-8f20-57f7d94c4448?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3477f7cdf6367f55fa57be456385fa8 3x"}, "body": "はらちる様こんにちは！いつもお世話になっております！アラレです(*'ω'*)\nこの度手数料無料とのことでしたのでリクエストいたします！\n私のオリジナルキャラクター「アナザー」をはらちるさんに是非描いていただきたいです。\n用途は個人観賞です\nどういったキャラクターなのかは資料にまとめております。\n全身の資料がまだ作ってなくて申し訳ないのですが、、、、\n今回はバストアップでお願いしたいです。\n\nリクエストのテーマは「支度」\nポーズは服を脱ぐ途中。または着る途中のどちらかでお願いしたいです。\n参考のポーズなども資料よりご確認ください。\n一つだけ注意点なのですがアナザーくんの地区Bの表現は無しの方向でお願いしたいです。\nハーネスは付けていただいても大丈夫ですし、無しでも大丈夫です。\n片眼鏡もあってもなくても大丈夫です。\n後ろ姿も大好きなので後ろ姿だけでも大丈夫です。\n服装に関しましては基本的には白いワイシャツや黒のインナーが多いですがはらちるさんの好きなお洋服を選んでもらえると嬉しいです。\n背景はあってもなくても大丈夫です。\nキャンバスサイズなどもすべてお任せ致します。\n\n少し艶っぽい感じですととても嬉しいですが無理そうでしてらご自由に描いていただいて大丈夫です(*'ω'*)\n金額不足やリクエスト内容がそぐわない場合はキャンセル、または再送お願いいたします。\nではよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1RyOnZWyZ0LhWWIPICbM8Tk_LGfUMHbn5?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@H_arachiru/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2391002, "client_id": 407156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a0c5df8a47c693620fbbb046df36893", "srcset": "https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a0c5df8a47c693620fbbb046df36893, https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff04938ef31b3cf07fb15dc84fc9d432 2x, https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe4bbba6c1c773cc079460bbff266626 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c5200edeb3eb9a03a7f818139b1862", "srcset": "https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c5200edeb3eb9a03a7f818139b1862, https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28814c28d26404f3f55ee0d15898a4e6 2x, https://si.imgix.net/ae86dc7b/uploads/origins/a7d10f50-d042-4600-bd13-4e3582820005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=178b5fcd91ca68042ba80232375514e1 3x"}, "body": "いつもお世話になっております。是非お願いしたいキャラを思いつきましたので、よろしければお願いいしたく思います。\n今回書いていただきたいキャラは、SKIMAで書いていただいた「石動くん」の派生キャラです。同じ特殊部隊の所属している後輩くんになります。\n設定としては\n①\t可愛い系のキャラで、髪はオレンジ系。茶髪か金髪もあり。\n②\t一人称は「僕」。先輩である石動くんの事を尊敬しており、いつも「先輩」と言って慕っている。(先輩に対してかなり大きな感情を抱いている)\n③\t体型はスリ筋で背の高さは石動くんと同程度。年齢も2歳ぐらいしか違わない。\n④\t剣術は石動くんには若干劣るもののかなりの腕前。\nようなイメージです。(怪獣8号の市川レノ君のような立ち位置です。)\n\nイラストとしては立ち画で、部隊の制服で真剣を構えているようなキリッとした感じでお願いしたく思います。可能であれば複数表情があると嬉しいです。\n(なお、彼も先輩を慕って「志願」する格好になるという設定…)\n\nその他の設定、構図などはすべておまかせします。かっこよく描いていただくことを希望します。よろしくご検討ください。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@H_arachiru/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2391002, "client_id": 407156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05eb427047801a5ffcebc2bd19f79169", "srcset": "https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05eb427047801a5ffcebc2bd19f79169, https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f46eabc59f10877d925189d94ce970a 2x, https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94b67a9e1b9e6c4f55d6084e617b6ec3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7c2cb696f923d29e5f952886bcfefb", "srcset": "https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7c2cb696f923d29e5f952886bcfefb, https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fec0e40adae6c75fc2dda66ec48e8260 2x, https://si.imgix.net/597e02a4/uploads/origins/dca785cc-dbef-418a-835f-b438b0180a4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e749d4c0b1e088ee14a037e727bfd788 3x"}, "body": "こんにちは、SKIMAでお世話になりました。前回描いていただいたキャラクターの派生キャラを描いていただきたく、スケブでお願いさせていただきたいと思います。\n\nキャラの概要は、前回のキャラクターと同じ高校に転校してきた後輩で、中性的なイメージのイケメンです。印象的な赤い瞳を持っていて身長は170cm前後、体型は顔に似合わずしっかり鍛えているイメージです。実は闇の組織の構成員で、サイボーグ化されていて、前回のキャラクターを自らの仲間に「悪堕ち」させるために近づくといった感じです。\n今回、描いていただきたいのは、前述のキャラの制服姿と、「闇の組織」のアーマーを全身に装備した、戦闘用モードです。\n装備については、頭部に関しては表情が分かるように顎から耳のあたりにかけてアーマーがあります。また、カラダにはフィットするような形で装着された強化スキンとその上からアーマーが装着されています。具体的には、肩、肘、胸部、腹部、股間部、膝からスネにかけて、そして背骨に沿って、アーマーが装着されているような感じです。\n\nその他の構図、デサイン、カラーはすべておまかせします。\nかなりマニアックな内容とはなりますが、よろしくご検討ください。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@H_arachiru/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d30abb72/uploads/origins/c9af58f2-e121-4ab9-bcb0-b701f8d77a89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b79dde17fbfef25a666a4553a7b1be52", "srcset": "https://si.imgix.net/d30abb72/uploads/origins/c9af58f2-e121-4ab9-bcb0-b701f8d77a89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b79dde17fbfef25a666a4553a7b1be52, https://si.imgix.net/d30abb72/uploads/origins/c9af58f2-e121-4ab9-bcb0-b701f8d77a89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=297637c34cb14ccca28fa53ec3b2283d 2x, https://si.imgix.net/d30abb72/uploads/origins/c9af58f2-e121-4ab9-bcb0-b701f8d77a89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a1b995f834a97be09b7e94b8e6ee4be 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2391002, "nc": 128}, {"path": "/@H_arachiru/works/2", "private_thumbnail_image_urls