\n使用用途\n・X(旧Twitter)などのSNSでの使用\n・収益化済みのTwitchチャンネルやyoutube(サムネイルや動画、スタンプなど)の配信活動での使用\n\nイラスト詳細\n・RPG系でのサムネイルに使えるイラストをお願いします。好きなジョブは魔法使い(どちらかというと黒魔法)やシーフや忍者です。その中からイメージの湧くものでお願いしたいです。\n・構図はお任せします。お好きなようにお願い致します。\n・服装などに関しては変えていただき、そのジョブにあったものにしていただきたいですが、髪型だけはそのままでお願いします。\n・左目の下にほくろがあります。\n\nその他\n・サムネイルに使用するため体や髪などが見切れないようにお願い致します。\n・背景がある場合は人物と背景が分けられるようにしていただきたいです。\n\nお忙しいと思いますが、ご検討いただければと思います。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1VREJNRQGb2u9yIqEaE3d9Hj3P5rYLjvm?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@736NAZ/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2562159, "client_id": 505726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b646638e/uploads/origins/8dcffb5d-0967-49db-9ca1-969f3af9f3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da16f9489c8c266cee8fea64897e2f9a", "srcset": "https://si.imgix.net/b646638e/uploads/origins/8dcffb5d-0967-49db-9ca1-969f3af9f3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da16f9489c8c266cee8fea64897e2f9a, https://si.imgix.net/b646638e/uploads/origins/8dcffb5d-0967-49db-9ca1-969f3af9f3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5212da2c273c6dc49a795fe374984130 2x, https://si.imgix.net/b646638e/uploads/origins/8dcffb5d-0967-49db-9ca1-969f3af9f3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f43a62972bc89878a9f4ac3bf269f98c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b646638e/uploads/origins/8dcffb5d-0967-49db-9ca1-969f3af9f3b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7752891c6bc9f2f350607a89cf9daa7", "srcset": "https://si.imgix.net/b646638e/uploads/origins/8dcffb5d-0967-49db-9ca1-969f3af9f3b2?bg=%23fff&auto