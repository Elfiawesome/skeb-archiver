op&w=200&h=200&blur=200&s=3177920ba7d9160d7356b15ac0275538, https://si.imgix.net/a25a9046/uploads/origins/786379e1-6c0b-4e65-9452-8fe580c84594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcd705a419079cbd73b46f1c948f5301 2x, https://si.imgix.net/a25a9046/uploads/origins/786379e1-6c0b-4e65-9452-8fe580c84594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4aa8905d80cd6d360d013e06447f11f4 3x"}, "body": "初めまして。ユメザメ様の描くイラストを拝見して、ぜひリクエストをお願いしたいと思いました。\nSNSのアイコンに使用したいです。\n\n白い百合の花を髪に挿した人魚の女性を描いていただきたいです。\n尾びれも髪も青みのある白色、髪は肘下くらいの長さで前髪は流してくださると嬉しいです。\n構図などはユメザメ様のお好きに描いていただきたいです。\n\nご検討いただけますと嬉しいです。\n不適切と感じた際はキャンセル、もしくは再送リクエストをお願いいたします。\n長々と失礼しました。ぜひ、よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JJJJ_y11/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3666756, "client_id": 3713317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d534ea5338be8a9efacc71b56ad17ffc", "srcset": "https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d534ea5338be8a9efacc71b56ad17ffc, https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a4917510e6ac9fc3a8495bc40afdf4f 2x, https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5446e4d54209124505161e4c92cf3647 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5667f308601ff618d277654085a8eac2", "srcset": "https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5667f308601ff618d277654085a8eac2, https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62be127aab6499ff3fc99e4c763b9d47 2x, https://si.imgix.net/275dca98/uploads/origins/91c44da8-39fa-423e-b488-3e1c04573aad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=597e09e53b350c680b34c5bb11f0315c 3x"}, "body": "ユメザメさん、はじめまして。\nあなたのアートスタイルが好きなので、ぜひポートフォリオ制作の支援をさせて頂きたいと思いリクエストを送らせて頂きました。\n\n୨୧依頼内容\nわたしのOCを描いてくださると嬉しいです。前髪に乗っている３匹の蝶は目印のようなものなので、それさえ描いてくだされば服装も構図もシチュエーションも自由で大丈夫です。お好きなように描いてください。\n\n୨୧使用用途\n各SNS(Discord等)のアイコンに使用する場合があります。\n\nまたこのリクエストはあなたのことを支援するためのものですので、用途が難しいものがある場合、再送リクエストもしくはキャンセルをお願いいたします。\n\n何か失礼がありましたら申し訳ありません。\nよろしくお願いします…!\n\nhttps://drive.google.com/file/d/1eBrljfPTR7jwYHjsI5KGEEREBh5IA59b/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@JJJJ_y11/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3666756, "client_id": 2752692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa8bb723/uploads/origins/cb82d9c5-013e-449e-a0a2-0bbb9a448284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c1fa48ccf1677d29b12d28cd846a00", "srcset": "https://si.imgix.net/aa8bb723/uploads/origins/cb82d9c5-013e-449e-a0a2-0bbb9a448284?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7c1fa48ccf1677d29b12d28cd846a00, https://si.imgix.net/aa8bb723/uploads/origins/cb82d9c5-013e-449e-a0a2-0bbb9a448284?bg=%23fff&auto=for