-9e02-e32aae14ec6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d6d06bd7ab77c20f9b60c4031ee1af, https://si.imgix.net/64bbd413/uploads/origins/d1c212b4-3cb8-4804-9e02-e32aae14ec6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab17dd8d5d961a447f0dc67020f7e7b6 2x, https://si.imgix.net/64bbd413/uploads/origins/d1c212b4-3cb8-4804-9e02-e32aae14ec6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=501d8a5b91f17dc301afa7065534b837 3x"}, "body": "以前からパクハブ様のSSにお世話になっておりました…！\n特に英霊食品化工場に脳を焼かれ続けていたのでFGOの無様変化SSをリクエストさせて頂きたいのであります\n【リクエスト内容】\nFGOの女性サーヴァント達が敵に敗北or罠にかかって食品化され、食べられて最終的に纏めて排泄物にされてしまうSSをよろしくお願いいたします\nプリズマ☆イリヤの3人やランサーのメデューサ辺りが被害者に入っていて描写多めだと非常に嬉しいです\n敵や変化後の品目などの描写は自由にお任せいたします", "nc": 58, "word_count": 8314, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@PakukupaDX/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 339173, "client_id": 11092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1310ff7/uploads/origins/d1109141-6fd7-4e9b-b5e7-f70230e0080c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8242ffa52fea9c8c73bf38723736e40d", "srcset": "https://si.imgix.net/d1310ff7/uploads/origins/d1109141-6fd7-4e9b-b5e7-f70230e0080c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8242ffa52fea9c8c73bf38723736e40d, https://si.imgix.net/d1310ff7/uploads/origins/d1109141-6fd7-4e9b-b5e7-f70230e0080c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57808b87110ec9373606521d9b45abd4 2x, https://si.imgix.net/d1310ff7/uploads/origins/d1109141-6fd7-4e9b-b5e7-f70230e0080c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3257cae5b9a1743ae03e7ca5f376e5ff 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https