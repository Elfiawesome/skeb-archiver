々とした性格。頭脳明晰。無愛想。\n\n\n使用用途は鑑賞、個人の利用範囲でのグッズ制作です。\n資料で分かりにくい所は想像で描いていただいて構いません。\n地雷、こだわり等は特にありませんので、とり（仮）様の自由に表現して頂けますと幸いです！\n\nその他の理由で不都合等ありましたら 遠慮なくお断りください。\nここまで読んでいただき、ありがとうございました！\nご検討よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Wf_uVg-rA_lXoNwdvPvAViZK-QtrdTYQ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 652002, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぷりFさん@skeb募集中", "screen_name": "printfsan", "avatar_url": "https://pbs.twimg.com/profile_images/2001748247417888768/XnEBCnTz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1782776583117484032/1745092682/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 128}, {"id": 1613683, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "@なつ", "screen_name": "at_natsu", "avatar_url": "https://pbs.twimg.com/profile_images/1638533302067011585/9lu7bbXK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4637972785/1686889207/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2046335, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ルヰ", "screen_name": "lui_sanndesuyo", "avatar_url": "https://pbs.twimg.com/profile_images/1535199008196804608/UCfFbSaH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1525367745248100352/1654854909/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": 