55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=590525abc5045ad0c8dcc097d31894d9 2x, https://si.imgix.net/ba8fd147/uploads/origins/45edb163-2a6a-4cec-9d96-60fbf969bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be7db4492b8195c6b12d76adbd401c32 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba8fd147/uploads/origins/45edb163-2a6a-4cec-9d96-60fbf969bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=059fb076ce729064023c26ec86e6fbd9", "srcset": "https://si.imgix.net/ba8fd147/uploads/origins/45edb163-2a6a-4cec-9d96-60fbf969bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=059fb076ce729064023c26ec86e6fbd9, https://si.imgix.net/ba8fd147/uploads/origins/45edb163-2a6a-4cec-9d96-60fbf969bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49da826eba465e260683379764167eaa 2x, https://si.imgix.net/ba8fd147/uploads/origins/45edb163-2a6a-4cec-9d96-60fbf969bd55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e986423bcc846cd0fb601be38466cf41 3x"}, "body": "【キャラクター】\n1. でびで◯でびる（メイン）\n2. 黒井◯ば（下半身のみで可）  \n\n【シーン】\n1. でびでび◯びるが、鼻や口から精液を垂らした状態で、黒◯しばの太くて長い犬ちんぽを執拗に咥えてしゃぶっている様子\n2. 犬ちんぽは獣臭そうで、何度も射精した後なのにビンビンに勃起している  \n3. ◯井しばは下半身のみで十分。上半身（顔など）は見切れてあえて見えないようにしつつ、いつも身につけている黄色のスカーフが少し見切れて入っていると嬉しいです（これで黒◯しばだとわかる目印）。\n\n【スタイル】   \n1. 構図やアングルはお任せ\n2. 背景はシンプルでOK\n\nよろしくお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@listkun_yes/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3089201, "client_id": 2680607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94a18990/uploads/origins/52e0e914-86fd-4a9b-b4ff-31e94135c31a?bg=%23fff&auto=format%2Ccompress&fm=webp&fi