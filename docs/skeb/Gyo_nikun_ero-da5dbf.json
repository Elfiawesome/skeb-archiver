n\n表情は男を責めるのを楽しんでいるようなSっ気のある感じで目線をこちらに送って下さい。\nまた、画面左上にスパッツを履いた状態の女性器のアップをお願いします。\n\nその他のお願い\n男は下半身、もしくは男性器だけ画面に映っていれば大丈夫です\n男の台詞は無しでお願いします。\n女性の台詞はあっても無くてもどちらでも大丈夫です、お任せします。\n衣装の模様などは大変でしたら簡略化していただいて大丈夫です。\n\n以上です、よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gyo_nikun_ero/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7327e608/uploads/origins/dc2c8a17-b52c-4712-b6d2-01608db08c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8f3f4bf3b95dc10e563f98c73f02883", "srcset": "https://si.imgix.net/7327e608/uploads/origins/dc2c8a17-b52c-4712-b6d2-01608db08c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8f3f4bf3b95dc10e563f98c73f02883, https://si.imgix.net/7327e608/uploads/origins/dc2c8a17-b52c-4712-b6d2-01608db08c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7326717e6a0cd1d365d1ff27f1cc1dcd 2x, https://si.imgix.net/7327e608/uploads/origins/dc2c8a17-b52c-4712-b6d2-01608db08c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fea69305f304d54bb1c51efca1cf5fe4 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3626487, "client_id": 2324085, "nc": 163}, {"path": "/@Gyo_nikun_ero/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3626487, "client_id": 2236192, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd070b28/uploads/origins/d4a08a26-d582-4745-92e7-afc416f51e9b?bg=%23fff&auto=format%2Ccom