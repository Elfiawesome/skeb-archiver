ました。\n\n制作していただいた楽曲は、個人で楽しむ他、今後私のこのキャラクターに関する動画作品等に使わせていただくかもしれません。   \n\nご検討　よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1huz2hqDhsHtQp_nfB5F3tjaNRrRVBECZ?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1483405, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "静定", "screen_name": "ridicule_ous", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2647869, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちしやな@skeb募集中", "screen_name": "cheshirena3", "avatar_url": "https://pbs.twimg.com/profile_images/1939663349748543488/lEoUzNIl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1579493635195777033/1717033983/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2668845, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ながと", "screen_name": "milxs0", "avatar_url": "https://pbs.twimg.com/profile_images/1624409019132817408/IrKOtd09.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1622291832012177408/1704542569/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 3278901, "creator": true, "nsfw_acceptable": false, "acceptable": tr