ff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27d5b1e53b1f76dd59af9276abcfa0af 2x, https://si.imgix.net/fa96f4ad/uploads/origins/9c21499c-415f-4446-9831-e3b42a1ee1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55a9df523d0c0a4b6fd5273267ac5dee 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa96f4ad/uploads/origins/9c21499c-415f-4446-9831-e3b42a1ee1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee7d6ef3aea12f2d791138d5b129f518", "srcset": "https://si.imgix.net/fa96f4ad/uploads/origins/9c21499c-415f-4446-9831-e3b42a1ee1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee7d6ef3aea12f2d791138d5b129f518, https://si.imgix.net/fa96f4ad/uploads/origins/9c21499c-415f-4446-9831-e3b42a1ee1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f93d4adb9df975160142ab0cb49d3016 2x, https://si.imgix.net/fa96f4ad/uploads/origins/9c21499c-415f-4446-9831-e3b42a1ee1c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53ac1577b205b9ed977bf7a1f5ae282b 3x"}, "body": "初めまして。pixivでお見かけしたケモミミきつねっ娘ちゃんのイラスト(https://www.pixiv.net/artworks/130199731)がかわいかったので、彼女のイラストをリクエストさせていただきます。\n\nきつねっ娘ちゃんが、男性に顔面騎乗でクンニをさせているイラストをお願いします。\n\n衣装は以前のイラストと同じで、はだけ方も同じような感じでお願いします。今回は胸も見えるように描いていただけるとありがたいです。\n\nシチュエーションは、半ば強引にクンニさせていて、きつねっ娘ちゃん優位で気持ち良さそうなイメージでお願いします。\n可能であれば、そろそろ挿入したいとねだる男性に「まだだめ。もっと気持ちよくしてくれたら挿入させてあげるから、いっぱいおまんこ舐めなさい」と焦らす&クンニのおねだりをセリフ等の差分で描いていただきたいです。\n\n男性の描写は最低限で良いのと、セリフもあってもなくてもどちらでも良いです。\nきつねっ娘ちゃんのセリフも、シチュエーションに合わせてアレンジしていただいて構いません。\n\nお忙しいところ恐縮ですが、ご検討よろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Zinann1919/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3379285, "client_id": 3385348