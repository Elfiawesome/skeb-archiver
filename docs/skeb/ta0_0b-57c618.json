ee\u3092\u4e38\u304f\u3057\u3066\u76f8\u624b\u3092\u898b\u3066\u3044\u3066\u3001\u5c11\u3057\u832b\u7136\u3068\u3057\u3066\u3044\u305f\u3002\u3067\u3082\u5927\u4eba\u3057\u304f\u30ad\u30e3\u30f3\u30c7\u30a3\u30fc\u3092\u53e3\u306b\u542b\u3081\u3066\u3044\u307e\u3059\u3002\n\nAr9n(\u2642)\u306e\u6027\u683c\u306f\u3001\u611f\u50b7\u7684\u3067\u6d3b\u767a\u3002 \u77b3\u306e\u8272\u306f\u660e\u308b\u3044\u9ec4\u8272\u306e\u7425\u73c0\u8272\u3002 \u9aea\u306e\u8272\u306f\u9ed2\u3067\u3001\u5f8c\u308d\u306b\u304a\u3055\u3052\u304c\u3042\u308b\u3002\n\u3053\u306e\u7d75\u3067\u306f\u3001Ar9n \u306f\u4e0a\u534a\u8eab\u306bT\u30b7\u30e3\u30c4\u3092\u7740\u3066\u3001\u30cd\u30c3\u30af\u30ec\u30b9\u3092\u3064\u3051\u3066\u3044\u308b\u3002\uff08\u53c2\u8003\u30d5\u30a9\u30eb\u30c0\u30fc\u306eBANDSHIRT\u3068\u30cd\u30c3\u30af\u30ec\u30b9(AR9N)\u306e\u753b\u50cf\uff09\n\u5de6\u624b\u9996\u306b\u306f\u30b7\u30f3\u30d7\u30eb\u306a\u9ed2\u306e\u30d6\u30ec\u30b9\u30ec\u30c3\u30c8\u3002\u88fe\u306b\u5927\u304d\u306a\u30dd\u30b1\u30c3\u30c8\u304c\u4ed8\u3044\u305f\u9ed2\u3044\u30b7\u30e7\u30fc\u30c8\u30d1\u30f3\u30c4\u3067\u3059\uff08\u819d\u307e\u3067\uff09\u3002\n\nRoundy(\u2642)\u306e\u76ee\u306e\u8272\u306f\u30a8\u30e1\u30e9\u30eb\u30c9\u30b0\u30ea\u30fc\u30f3\u3001\u9aea\u306f\u30d4\u30f3\u30af\u3067\u3059\u3002 \u53f3\u5074\u306b\u5782\u308c\u4e0b\u304c\u3063\u3066\u3044\u308b\u9aea\u306e\u675f\u306e\u5185\u5074\u306f\u3001\u767d\u3044\u30d4\u30c3\u30af\u306b\u306a\u3063\u3066\u3044\u308b\u3002Roundy\u306f\u7a4f\u3084\u304b\u306a\u6027\u683c\u3067\u3001Ar9n\u306e\u597d\u307f\u306b\u5408\u308f\u305b\u3066\u304f\u308c\u308b\u3053\u3068\u304c\u591a\u3044\u3002 \u305f\u307e\u306b\u81ea\u5df1\u4e3b\u5f35\u306e\u5f37\u3044\u4e00\u9762\u3092\u898b\u305b\u308b\u3053\u3068\u3082\u3042\u308b\u304c\u3001\u305f\u3044\u3066\u3044\u306e\u5834\u5408\u306f\u3068\u3066\u3082\u89aa\u3057\u307f\u3084\u3059\u3044\u3002\n\u3053\u306e\u7d75\u3067ROUNDY\u306f\u5c16\u3063\u305f\u9b54\u5973\u5e3d\u3092\u3