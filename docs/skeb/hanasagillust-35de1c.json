e435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d65a211da351b6bb4c3417d149e55956", "srcset": "https://si.imgix.net/bc4b2450/uploads/origins/42e62104-7ba1-4cfb-923f-05e10150e435?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d65a211da351b6bb4c3417d149e55956, https://si.imgix.net/bc4b2450/uploads/origins/42e62104-7ba1-4cfb-923f-05e10150e435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eff228028190fd592e5e47da4c8c8298 2x, https://si.imgix.net/bc4b2450/uploads/origins/42e62104-7ba1-4cfb-923f-05e10150e435?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07897a6e628de82f9684e7a9d50460ad 3x"}, "body": "ミリオンライブからリクエストお願いします。\n\nシチュエーション\n自主レッスン終了後レッスン室でミリオン中学生組(未来、百合子、杏奈など)がグラビアでセクシーポーズの練習。\n未来や百合子がバストを強調しているセクシーポーズでPをメロメロにしようとセクシーポーズの研究をしてるところに志保が合流。\n\n志保の冷静なツッコミでお開きになり志保以外は退室。誰もいないレッスン室で鏡の前でなんとなく未来たちが行なっていたバストを強調するセクシーポーズを研究しているとPが入室してきて顔真っ赤の志保。\n\n\n要望\n入れて欲しいアイドル\n・北沢志保\n・春日未来\n・七尾百合子\n\n\n描写しやすいようにシチュエーションを変更しても構いません。\n\nこんな感じですが、ご検討よろしくお願いします。", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanasagillust/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1425453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e805b5e87b2d1d8f835a2a8e9cb97ab", "srcset": "https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e805b5e87b2d1d8f835a2a8e9cb97ab, https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7dddabe509d663da407064a73a5613f 2x, https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d7763dbca99c7bd549769bd32c093ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb973693bc3a27431a7241d68195b109", "srcset": "https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb973693bc3a27431a7241d68195b109, https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57b2acbde6e022a82a6026bb20bc4a80 2x, https://si.imgix.net/ba5b5a31/uploads/origins/90ac621e-55b5-45a1-86fc-8ba40073ccd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a222e19f355f66e6a273b5108efb97ba 3x"}, "body": "Pのことを好きだと自覚してる春日未来とPのイチャイチャ漫画でリクエストお願いします。\n\n\nシチュエーション\n1.一度入るとキスしないと出れない部屋に閉じ込められたPと未来。\n\n2.Pが出る方法をいろいろ試していると、身だしなみを整えソワソワしていた未来が覚悟を決め目を瞑り上目遣いで唇を差し出してくる。\n\n3.未来の可愛いキス顔に負け唇に触れる程度の軽いキスをする。\nキスしたことで部屋の扉が開くが、嬉し恥ずかし顔真っ赤の未来がもう一度キスしてもらおうとわざと扉を閉める。\n\n\n\n可愛いみらいちゃが見たいのでよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanasagillust/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1425453, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1505f908aa75dbb3d571be97777c5f", "srcset": "https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a1505f908aa75dbb3d571be97777c5f, https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=805eea321494b458ed4260ae5b986829 2x, https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2528cbb403cfe9579388cdc5c7b84f6d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=454025a8ce125a114a7fd05b343707c0", "srcset": "https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=454025a8ce125a114a7fd05b343707c0, https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d71e3392386c6c3a75a0619919369c4 2x, https://si.imgix.net/c1c93116/uploads/origins/872a33ed-50e9-4c4f-b4f5-daacfdb52852?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd48c1e22b5cbd9f81a4911e238c3b37 3x"}, "body": "はじめまして。\n先日北沢志保がPに膝枕してあげていたイラストの続きのようなものをお願いします。\n\n\nシチュエーション\n志保がPに膝枕していると寝てしまったP。そんな姿が可愛いと感じた志保が頭をナデナデしてあげイチャイチャ。\n最後に周りに人がいないことを確認し寝てるPの唇にキスをするデレ沢志保。\n\n\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanasagillust/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1425453, "client_id": 345937, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d9184e8/uploads/origins/1c55209d-1ec9-4e9f-b752-72c757c3409d?bg=%23fff&auto=for