t%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82b44eaefe4f1fc4d0940c54d3e831a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ac9a64f/uploads/origins/4743c3e4-d19c-42ae-9878-3ecf8192082f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57581ac84056299159af81f07c07de12", "srcset": "https://si.imgix.net/4ac9a64f/uploads/origins/4743c3e4-d19c-42ae-9878-3ecf8192082f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57581ac84056299159af81f07c07de12, https://si.imgix.net/4ac9a64f/uploads/origins/4743c3e4-d19c-42ae-9878-3ecf8192082f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae00226fbc395f986e1d74ae3242e994 2x, https://si.imgix.net/4ac9a64f/uploads/origins/4743c3e4-d19c-42ae-9878-3ecf8192082f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=304ce3bdff860cf834913718a0201925 3x"}, "body": "初めまして。VTuberのアンティークドールしあと申します。\n\n愛らしいイラストを拝見し、ご連絡させていただきました。\nぜひpiso様が可愛いと思うイメージでしあを描いてください。\n\n●キャラクター\nSiaは球体関節のフランス人形です。身長60cm。髪は白色。\nフランス生まれの日本文化オタクです。\nデザインにつきましては、URLの資料画像にてご確認ください。\n（長髪verでお願いいたします）\n\n●使用用途\n・VTuber活動全般。収益済のYoutube・X各種SNS等での使用\n・グッズとして商用利用\n\n●形式\n・可能でしたら全身でお願いしたいです。\n・キャラクター、文字とレイヤーが分かれているPSDデータでいただけると大変ありがたいです。\n\nご縁があることを願っております。ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uxfftQszyz6UV70O6sGO5blQjlIyl6fy?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@piso0219/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3841071, "client_id": 2845229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6b6dc4f/uploads/origins/3e9d6e05-c3b0-44b5-97da-91953747c4bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a06e7b1f42e17700c83c86709fdae8c", "src