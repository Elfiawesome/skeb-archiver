n【キャラクターについて】\n・魔法図書館で使い魔猫に囲まれて暮らす白猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@piso0219/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/207f65f7/uploads/origins/695f5d51-71f1-40ce-ad5c-e00d14be34de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f37d52b6fc30a33a56595062c57d0909", "srcset": "https://si.imgix.net/207f65f7/uploads/origins/695f5d51-71f1-40ce-ad5c-e00d14be34de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f37d52b6fc30a33a56595062c57d0909, https://si.imgix.net/207f65f7/uploads/origins/695f5d51-71f1-40ce-ad5c-e00d14be34de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9631793463edd4b3cd6195ab823cdd0 2x, https://si.imgix.net/207f65f7/uploads/origins/695f5d51-71f1-40ce-ad5c-e00d14be34de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18d50445bfc6a2dbea73af764d745875 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3841071, "nc": 1}, {"path": "/@piso0219/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3841071, "client_id": 460168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b176219f/uploads/origins/d98babd9-942e-4c1e-b820-3c33f4c71b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8076