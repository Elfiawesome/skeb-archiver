オリジナルですが、当初はファン作品で使用するためのものでした。服装は公式のものを参考にしないように変更しました。\n\nそれがダメなら遠慮なく断ってください、別のオリジナルキャラで新たに依頼を出します。\n\nなお、キャラクターは男ですが、髪は腰まであります。目は紺色。性格は優しいけどお茶目。\n\nその他はお任せしますので、自由に描いてください！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/10nLox9uO6B5zH8eiMKrJyvCtGPzMmWk9?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@otitioti/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1360773, "client_id": 1923050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d3d65ab/uploads/origins/8fe4b796-4776-45b0-9443-32f5ccd2e7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b22efc2600ff35557cca31ff3686e2f3", "srcset": "https://si.imgix.net/4d3d65ab/uploads/origins/8fe4b796-4776-45b0-9443-32f5ccd2e7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b22efc2600ff35557cca31ff3686e2f3, https://si.imgix.net/4d3d65ab/uploads/origins/8fe4b796-4776-45b0-9443-32f5ccd2e7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5665e6d87a8764046580c50094d2b3d8 2x, https://si.imgix.net/4d3d65ab/uploads/origins/8fe4b796-4776-45b0-9443-32f5ccd2e7da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e78485f10c1c01724fb61e3a1584fdd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d3d65ab/uploads/origins/8fe4b796-4776-45b0-9443-32f5ccd2e7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb3e30189972a658b7288a610113faf", "srcset": "https://si.imgix.net/4d3d65ab/uploads/origins/8fe4b796-4776-45b0-9443-32f5ccd2e7da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb3e30189972a658b7288a610113faf, https://si.imgix.net/4d3d65ab/uploads/origins/8fe4b796-4776-45b0-9443-32f5ccd2e7da?bg=%23fff&auto=format%2Ccompress&fm=we