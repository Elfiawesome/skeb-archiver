=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f72a97cdcf4bfa1e0021df3b891f4653 2x, https://si.imgix.net/b7aee98e/uploads/origins/63846453-da2b-43fb-ac65-47f45ddf37d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa5a2356e0ab5ad533db124b2535c9fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7aee98e/uploads/origins/63846453-da2b-43fb-ac65-47f45ddf37d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4045edd30bd67ffc9844fc049dffb737", "srcset": "https://si.imgix.net/b7aee98e/uploads/origins/63846453-da2b-43fb-ac65-47f45ddf37d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4045edd30bd67ffc9844fc049dffb737, https://si.imgix.net/b7aee98e/uploads/origins/63846453-da2b-43fb-ac65-47f45ddf37d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3daa205888803f6354cdf405b677759a 2x, https://si.imgix.net/b7aee98e/uploads/origins/63846453-da2b-43fb-ac65-47f45ddf37d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f557392b7976267adb7d60c59154467e 3x"}, "body": "初めてになりますがリクエスト失礼致します。\n恥ずかしながら私の描いたこちらの作品（https://x.com/kemo_miracle/status/1888909277714395254?s=46&t=KgjNqE_VtTk0qcsJbEhedg）のキャラをふくさんに描いていただきたいです。\n難しいかもしれませんが、TF感が多く感じられる様なイメージ（体格矯正や表情連結してたりなど）でお願いしたいです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fukufuku5686skeb/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1650444, "client_id": 655978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c52ab2e8/uploads/origins/df45ad06-84ba-43d8-aeff-6f34821da3f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f28540525ece60aa4eae787858f0f8", "srcset": "https://si.imgix.net/c52ab2e8/uploads/origin