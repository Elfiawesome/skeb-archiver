のピンクと紫のイラストのような感じでリラックスしている猫ちゃんを何匹か描写していただきたいです。(色は白、白+グレー)\n猫フォルダに好きな系統の猫ちゃんを入れておりますので参考にしていただけますと幸いです。(ノルウェージャンフォレストキャット、マンチカン、ミヌエットなど)\n\n【好きなモチーフ】\n骨、ハート、フリル、雲、肉球、リボン、スタッズ(ハートやトゲトゲなど)、月、ふわふわなもの、お洋服、動物\n\n全て入れなくても大丈夫です◎\n\n┈┈┈┈┈┈┈┈┈┈┈┈\n\nたくさん記載してしまいましたが可能な限りで問題ございません。\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1sxIh3IZXd28k8oGj7rF8wMqIxuDKx3tu", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mzwawawao/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3482240, "client_id": 631465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08befd38/uploads/origins/498e2a09-f439-439d-a455-2eed3f1148f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfb6b5f1ce1070620843480d8bcb9ad0", "srcset": "https://si.imgix.net/08befd38/uploads/origins/498e2a09-f439-439d-a455-2eed3f1148f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfb6b5f1ce1070620843480d8bcb9ad0, https://si.imgix.net/08befd38/uploads/origins/498e2a09-f439-439d-a455-2eed3f1148f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5638e9c9a095ea2e386f26a6e00a4a8 2x, https://si.imgix.net/08befd38/uploads/origins/498e2a09-f439-439d-a455-2eed3f1148f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e175dbf7b6feea05d1081f511336850 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08befd38/uploads/origins/498e2a09-f439-439d-a455-2eed3f1148f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6873f6190ce718602ddd253e8cb05678", "srcset": "https://si.imgix.net/08befd38/uploads/origins/498e2a09-f439-439d-a455-2eed3f1148f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6873f6190ce718602ddd253e8cb05678, https://si.imgix.net/08befd38