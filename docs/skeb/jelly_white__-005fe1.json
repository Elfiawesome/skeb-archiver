rmat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3311210eb3a1791942c3f8cd5ce20cc 3x"}, "body": "Hi!  Nice to meet you!  Would you please draw me?  I saw your recent work!  I couldn't resist asking for a request because it's so cute!  \n\nI would love to use your art for my ending screen for my streams!  Please draw in a 16:9 format please!  I would love my character to be in a cute cafe and her playing the nintendo switch!  \n\nI hope we can work together!\n\nhttps://drive.google.com/drive/folders/1p8jQ25y1WU4_NSwR7d6PILfqONN1b8s1?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jelly_white__/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2240247, "client_id": 1395468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a44037d6/uploads/origins/a574a029-a857-482f-854f-816beb995155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f985bef51cdf71379c925ae507bb838", "srcset": "https://si.imgix.net/a44037d6/uploads/origins/a574a029-a857-482f-854f-816beb995155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f985bef51cdf71379c925ae507bb838, https://si.imgix.net/a44037d6/uploads/origins/a574a029-a857-482f-854f-816beb995155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=340747a8e338858071e1b63825220e7c 2x, https://si.imgix.net/a44037d6/uploads/origins/a574a029-a857-482f-854f-816beb995155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=210757e183bb54cf85ad3dbdb66dd6e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a44037d6/uploads/origins/a574a029-a857-482f-854f-816beb995155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c177863fc2b524b547f3f5b4a8033ab3", "srcset": "https://si.imgix.