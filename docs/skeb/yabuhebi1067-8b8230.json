7\u305f\u3002\n\n\u30ea\u30af\u30a8\u30b9\u30c8\u306e\u5185\u5bb9\n\u85ea\u86c7\u3055\u3093\u304cbooth\u3067\u516c\u958b\u3057\u3066\u3044\u308b\u30a2\u30ea\u30a2\u30eb\u3055\u3093\u306e\u7acb\u3061\u7d75\u306e\u8ffd\u52a0\u5dee\u5206\u3068\u3057\u3066\n\u30fb\u5168\u9aea\u578b\u306b\u9aea\u8272\u306e\u5dee\u5206\u306e\u8ffd\u52a0(\u8272\u306f\u53c2\u8003\u753b\u50cf\u3092\u53c2\u7167\u3001\u5143\u3005\u3042\u308b\u767d\u8272\u306e\u9aea\u578b\u306f\u6b8b\u3059)\n\u30fb\u9aea\u578b\u306e\u8ffd\u52a0(\u9aea\u578b\u306f\u53c2\u8003\u753b\u50cf\u3092\u53c2\u7167\u3067\u524d\u9aea\u306e\u5206\u3051\u76ee\u3060\u3051\u5de6\u53f3\u9006\u306b\u3059\u308b\u3001\u5143\u3005\u3042\u308b\u767d\u8272\u7248\u3068\u8ffd\u52a0\u306e\u9aea\u8272\u7248\u3069\u3061\u3089\u3082\u5165\u308c\u308b)\n\u30fb\u5168\u3066\u306e\u76ee\u306e\u30cf\u30a4\u30e9\u30a4\u30c8\u306e\u30aa\u30f3\u30aa\u30d5\u3092\u5207\u308a\u66ff\u3048\u3089\u308c\u308b\u3088\u3046\u306b\u3059\u308b\n\u30fb\u5168\u3066\u306e\u76ee\u306b\u7d2b\u8272\u306e\u5dee\u5206\u306e\u8ffd\u52a0\n\u30fb\u3071\u3063\u3061\u308a\u76ee\u306e\u77b3\u3092\u4e00\u56de\u308a\u5927\u304d\u304f\u3057\u305f\u3082\u306e\u901a\u5e38\u76ee\u3068\u3057\u305f\u76ee\u306e\u5dee\u5206\u306e\u8ffd\u52a0(\u5143\u3005\u3042\u308b\u9280\u8272\u3068\u7d2b\u8272\u3069\u3061\u3089\u306e\u3082\u5165\u308c\u308b\u3001\u5143\u3005\u3042\u308b\u76ee\u306e\u5dee\u5206\u306f\u305d\u306e\u307e\u307e\u6b8b\u3059\u3001\u6b63\u9762\u5dee\u5206\u3068\u86c7\u76ee\u5dee\u5206\u3082\u5165\u308c\u308b)\n\u30fb\u85ea\u86c7\u3055\u3093\u304cbooth\u3067\u516c\u958b\u3057\u3066\u3044\u308b\u5ca1\u5d0e\u5922\u7f8e\u306e\u7acb\u3061\u7d75\u306b\u3042\u308b\u30d3\u30fc\u30e0\u30bd\u30fc\u30c9\u3068\u5341\u5b57\u30d3\u30fc\u30e0\u30bd\u30fc\u30c9\u3092\u6301\u3063\u305f\u5dee\u5206\u306e\u8ffd\u52a0(\u5263\u5148\u3092\u4e0a\u306b\u5411\u3051\u305f\u3082\u306e\u3068\u3001\u5263\u5148\u3092\u4e0b\u306b\u9006\u624b\u6301\u3061\u3057\u305f\u5dee\u5206)\n\u30fb\u9375\u306e\u5f6