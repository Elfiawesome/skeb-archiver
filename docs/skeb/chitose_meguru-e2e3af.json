2508\u2508\u2508\u2508\n\u2460(HO1)\u7537\u6027\n\u8eab\u9577\uff1a175cm\n\u5e74\u9f62\uff1a21\u6b73\n\u6027\u683c\uff1a\u30b2\u30fc\u30de\u30fc\u3002\u53e3\u6570\u306f\u591a\u3044\u65b9\u3067\u306f\u7121\u3044\u3002\u3044\u3064\u3082\u534a\u6b69\u5f8c\u308d\u3067\u898b\u5b88\u3063\u3066\u304f\u308c\u3066\u3044\u308b\u3002\u2461\u3068\u2462\u306e\u3053\u3068\u304c\u5927\u4e8b\u3060\u304c\u3001\u305d\u308c\u306f\u8868\u306b\u51fa\u3055\u306a\u3044\u3002\u3060\u304c\u3001\u7d50\u69cb\u8eab\u5185\u4e3b\u7fa9\u3002\u5927\u5207\u3060\u3068\u601d\u3063\u3066\u304f\u308c\u3066\u3044\u308b\u3002\n\n\u2461(HO2)\u5973\u6027\n\u8eab\u9577\uff1a158cm(\uff0b\u539a\u5e955cm)\n\u6027\u683c\uff1a\u5e7c\u306a\u3058\u307f\u306e\u3053\u3068\u306f\u5927\u597d\u304d\u3060\u3057\u3001\u79c1\u304c\u5b88\u3089\u306a\u304d\u3083\uff01\u3068\u3044\u3046\u59c9\u5fa1\u808c\u307f\u305f\u3044\u306a\u3068\u3053\u308d\u304c\u3042\u308b\u3002\u5e7c\u306a\u3058\u307f\u306b\u306f\u512a\u3057\u3044\u304c\u3001\u8efd\u5ea6\u306e\u4eba\u9593\u6050\u6016\u75c7\u304c\u3042\u308b\u305f\u3081\u3001\u8eab\u5185\u306e\u307f\u306b\u3072\u3063\u3064\u3044\u305f\u308a\u62b1\u304d\u3064\u3044\u305f\u308a\u611b\u3092\u4f1d\u3048\u305f\u308a\u3059\u308b\u3002\n\n\u2462(HO3)\u5973\u6027\n\u8eab\u9577\uff1a160cm\u8d85\u3048\n\u5e74\u9f62\uff1a21\u6b73\n\u6027\u683c\uff1a\u30c4\u30f3\u30c7\u30ec(\u30c4\u30f3\u304c\u3068\u3066\u3082\u591a\u3044)\u3002\u5b9f\u9a13\u304c\u597d\u304d\u3002\u2460\u3084\u2461\u306e\u3053\u3068\u306f\u5927\u5207\u3060\u3068\u601d\u3063\u3066\u3044\u308b\u304c\u3001\u5916\u306b\u3042\u307e\u308a\u51fa\u305a\u4ea4\u6d41\u304c\u6700\u3082\u8584\u3044\u3002\u2461\u306e\u3072\u3063\u3064\u304d\u7656\u3092\u5acc\u304c\u308a\u306f\u3059\u308b\u304c\u672c\u5f53\u306f\u7d20\u76f4\u306b\u306a\u308c\u306a\u3044\u3060\u3051\u3002\n\n\uff3b3\u4eba\u306e\u95a2\u4fc2\uff3d\n\u5c0f\u5b66\u6821\u304b\u3089\u306e\u5e7c\u306a\u3058\u307f\u3002\n\u2461\u306f\u5e7c\u306a\u3058\u307f\u304c\u5927\u597d\u304d\u306a