背景があると嬉しいです。 \nその他のポーズ・構図やシチュエーション等はお任せいたしますが、目が特徴的なため顔がしっかりと映えるようにお願いしたいです。\n\nPSDファイルはキャンバスサイズ大きめ(フルHD以上)で、レイヤーが分かれていると助かります。\n (キャラクター/背景/サイン　など)\n\n・使用用途 \nSNSやVRChatのアイコン・サムネイル、PC・スマホの壁紙等の私的利用(非商用)\n\n何か問題がございましたら差し戻し下さい。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1C3qQoeDCskoeFT0hgQXxD8b9v4GH7uvn?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@CoconToozai/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6a0550e0/uploads/origins/ee040c63-67e4-4e09-a334-d6edddf4f6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10fb2f40c3fb52e2fa6a1297feed6ecb", "srcset": "https://si.imgix.net/6a0550e0/uploads/origins/ee040c63-67e4-4e09-a334-d6edddf4f6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10fb2f40c3fb52e2fa6a1297feed6ecb, https://si.imgix.net/6a0550e0/uploads/origins/ee040c63-67e4-4e09-a334-d6edddf4f6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=351a9c81e5cba87ba12bd33308f43c3a 2x, https://si.imgix.net/6a0550e0/uploads/origins/ee040c63-67e4-4e09-a334-d6edddf4f6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7b86df6f28b12173c70a70443e9a7ae5 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3457836, "client_id": 2948996, "nc": 0}, {"path": "/@CoconToozai/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/55ed56a9/uploads/origins/c01bbce1-ce8c-454e-8e21-8d44887da487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h