130ac63e45e4d23f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5d19904/uploads/origins/e5ffe4ec-090b-463e-86f0-e6894eec1815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a14de26639a44b7dcb4b4a20e13ce10", "srcset": "https://si.imgix.net/f5d19904/uploads/origins/e5ffe4ec-090b-463e-86f0-e6894eec1815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a14de26639a44b7dcb4b4a20e13ce10, https://si.imgix.net/f5d19904/uploads/origins/e5ffe4ec-090b-463e-86f0-e6894eec1815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c15b7931df6850dfbaa200c0ddd7cbdb 2x, https://si.imgix.net/f5d19904/uploads/origins/e5ffe4ec-090b-463e-86f0-e6894eec1815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d6c19179547b4200328b221e9541666 3x"}, "body": "こんにちは。\nスーツに上はブルゾン？(ジャンパー？)作業着姿の男性がとても好きなのでリクエストしたいです。顔は覆面で、生身の手は苦手とのことでしたので手袋着用で大丈夫です。\n上着のジッパーを開けてても閉じてても問題ありませんが、ネクタイが見えているとうれしいです。\nフルフェイスとスーツの組み合わせが見たかったのですが、もしスーツが苦手でしたら申し訳ありません。\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kankitsukankan/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2833458, "client_id": 2281708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7ac0b3e/uploads/origins/3894b07a-d740-47fc-91af-c9e4850a77ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4cffca22f6f6c6208b438606bee53e2", "srcset": "https://si.imgix.net/d7ac0b3e/uploads/origins/3894b07a-d740-47fc-91af-c9e4850a77ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4cffca22f6f6c6208b438606bee53e2, https://si.imgix.net/d7ac0b3e/uploads/origins/3894b07a-d740-47fc-91af-c9e4850a77ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr