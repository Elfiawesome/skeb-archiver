-15fe05703561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a67ccf5a41a5cd15a94aeb0f1afbcb1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b578c7f5/uploads/origins/7ced6a13-4ca6-49f9-b573-15fe05703561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3442fd41e03d4728a1d1e86e1c6e2de0", "srcset": "https://si.imgix.net/b578c7f5/uploads/origins/7ced6a13-4ca6-49f9-b573-15fe05703561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3442fd41e03d4728a1d1e86e1c6e2de0, https://si.imgix.net/b578c7f5/uploads/origins/7ced6a13-4ca6-49f9-b573-15fe05703561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f660c458571c42ca367db87621e4fca 2x, https://si.imgix.net/b578c7f5/uploads/origins/7ced6a13-4ca6-49f9-b573-15fe05703561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2bda9a245c6bff145c55f953391ef44 3x"}, "body": "立て続けにリクエスト失礼します…！\n「おもいでシークエンス」に出演されていたギャレットさんとライリーさんを描いていただきたいです。\n\nお二人の関係性を良く存じず申し訳無いのですが、お二人が仲睦まじくしているところを見てみたいです。\n映像を見ていると、一瞬顔を赤らめて突き飛ばしているシーンがあり、好意はあれど素直になれない性質なのかな…？可愛いなと思いました…\n\n仲睦まじくといかなくとも、お二人の距離感や関係性が垣間見える姿を見られたら嬉しいです。\nよろしければ宜しくお願いします…", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gg_prm/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3199, "client_id": 3640646, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1058c306/uploads/origins/4b9270e5-7ff2-4fab-a784-9e2025b585f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5555744e8f73244930db428165c09f4f", "srcset": "https://si.imgix.net/1058c306/uploads/origins/4b9270e5-7ff2-4fab-a784-9e2025b585f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5555744e8f73244930db428165