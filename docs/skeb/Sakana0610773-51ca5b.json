いません。\nラフや下書きなどの途中経過を見せても良い場合は、レイヤー下に残していただけますととても嬉しいです。\nどうぞよろしくお願いします！\n\nまとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n資料URL\n\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sakana0610773/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1801961, "client_id": 2500427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0642ea6/uploads/origins/ccda39b8-f361-461d-bfdf-f1dba61ec41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6207ec163f6af78fab740e684855ca9", "srcset": "https://si.imgix.net/f0642ea6/uploads/origins/ccda39b8-f361-461d-bfdf-f1dba61ec41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6207ec163f6af78fab740e684855ca9, https://si.imgix.net/f0642ea6/uploads/origins/ccda39b8-f361-461d-bfdf-f1dba61ec41c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51a5475763189826036490c57ea0cba5 2x, https://si.imgix.net/f0642ea6/uploads/origins/ccda39b8-f361-461d-bfdf-f1dba61ec41c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04d9e73d84e06c151f3dd28cbb3bf755 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0642ea6/uploads/origins/ccda39b8-f361-461d-bfdf-f1dba61ec41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74bedab95d29cea763330987d288444f", "srcset": "https://si.imgix.net/f0642ea6/uploads/origins/ccda39b8-f361-461d-bfdf-f1dba61ec41c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74bedab95d29cea763330987d288444f, https://si.imgix.net/f0642ea6/uploads/origins/ccda39b8-f361-461d-bfdf-f1dba61ec41c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffd01b0a99acdd8f345844