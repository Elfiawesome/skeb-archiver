-4bb5-8340-10689abe9692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c0805ccdaba55e507e7f5e1f00df5cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/436a3dea/uploads/origins/315e9602-f862-4bb5-8340-10689abe9692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed85880a6e1ab6edf48870a18efeae28", "srcset": "https://si.imgix.net/436a3dea/uploads/origins/315e9602-f862-4bb5-8340-10689abe9692?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed85880a6e1ab6edf48870a18efeae28, https://si.imgix.net/436a3dea/uploads/origins/315e9602-f862-4bb5-8340-10689abe9692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=706bfa1fd07a018e41d2a373ae21325e 2x, https://si.imgix.net/436a3dea/uploads/origins/315e9602-f862-4bb5-8340-10689abe9692?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cacd617d387ac98fabd6d8910d003224 3x"}, "body": "Sakana様はじめまして！\nVtuber準備中の古森れびと申します。\n\n素敵なイラストをお見掛けし、ぜひイラストを描いていただきたくリクエストをさせていただきました。\nご検討のほどよろしくお願いいたします！\n\n【使用用途】\n・Youtubeのサムネイル、配信での紹介\n・SNSのアイコンやヘッダー、ポスト投稿での使用\n・透過画像の加工\n・ネットプリント\n・グッズ作成、販売\n　不可なものがありましたら、レイヤーなどに記載していただければ幸いです。\n\n【内容】\n8/31にご投稿された初音ミクちゃんのイラストが大好きです。\n似たような構図、塗りだと嬉しいです。\n\n背景、キャラクター(透過)、文字等のレイヤーを分けてのPNG納品希望です。\n\n【キャラクター】\n左目の下に涙ぼくろがあります。口を開けると犬歯が見えます。\n髪の色が薄いところがありますが、他と同じ色です。(耳、尻尾の先端のみ白色)\n雰囲気はおっとりぽわぽわ、ふわふわな感じです。\nイメージは狼、お花、クローバー、太陽です。\n\nご縁があったら嬉しいです。よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1V_PCpNn4GuzUtW3El5nJr9w5J_oiz4iV/view?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2265795, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "m", "screen_name": "mumumo6", "avatar_url": "https://pbs.twimg.com/profile_images/1667807130173464576/w4-yeCbD.jpg", "hea