=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f060a124e8649a25b3f2de3ad1d1245a", "srcset": "https://si.imgix.net/2faa4ed3/uploads/origins/c9c0c772-610a-43af-b731-01f79c29a017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f060a124e8649a25b3f2de3ad1d1245a, https://si.imgix.net/2faa4ed3/uploads/origins/c9c0c772-610a-43af-b731-01f79c29a017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad25beceee2db8ffdeecfb0d1af15586 2x, https://si.imgix.net/2faa4ed3/uploads/origins/c9c0c772-610a-43af-b731-01f79c29a017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e09b0b6ce165d5bedf4aeb67a63b1e6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2faa4ed3/uploads/origins/c9c0c772-610a-43af-b731-01f79c29a017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1e55d89df166bfb9f5f25dbec0a6a97", "srcset": "https://si.imgix.net/2faa4ed3/uploads/origins/c9c0c772-610a-43af-b731-01f79c29a017?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1e55d89df166bfb9f5f25dbec0a6a97, https://si.imgix.net/2faa4ed3/uploads/origins/c9c0c772-610a-43af-b731-01f79c29a017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec34d2c43334f09a14831b37603ba842 2x, https://si.imgix.net/2faa4ed3/uploads/origins/c9c0c772-610a-43af-b731-01f79c29a017?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a04c7ad633baa44edf23420a2526aa2f 3x"}, "body": "saso様\n\nキャラデありがとうございました！\nせっかくなのでアクション絵で1枚お願いできませんでしょうか。\n\n両手に鉈をもって左右に広げている戦闘中のようなイメージ。\n着地の蹲踞の姿勢や、そこから低く飛び掛かるイメージなど。\n描きやすいものとか描いてみたいものでいいです！\n\n表情は悪い笑顔で。\nデザインの最後のものなどもいい感じです。\n\nデザインは１枚目ベースですが、変更しても可です。\n（左右非対称のブーツは好みなので残したいですが）\n\nご検討お願いします。\n\nhttps://skeb.jp/@saso2010/works/8\n\nhttps://skeb.jp/@saso2010/works/8", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saso2010/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 500353, "client_id": 467724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6cb4c37b356c7fd8b08852a203516ec", "srcset": "https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6cb4c37b356c7fd8b08852a203516ec, https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bac23d86b556196ef324a87b3f6f209f 2x, https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c9753c960289d0b9afcab6f8553aad9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93cc8e85192560e7a46a5ff14ac42875", "srcset": "https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93cc8e85192560e7a46a5ff14ac42875, https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38aa83a4d45a139bc1694fe3d6c9f8c8 2x, https://si.imgix.net/d6668120/uploads/origins/77166725-645c-47c9-9353-ffe77b6b4a10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f56ab1cceb195e64c0be4cec1eb0e27d 3x"}, "body": "sasoさん\n\n初めまして。\n普段描かれているものと雰囲気が違うかもですが、\nキャラデザ依頼をしてみてもよいでしょうか。\nカッチリキャラを作るというより、いろんな方の手癖で描いていただいて、\nキャラを作っていきたく、以下に希望描きますが割と自由で構いません。\n\n<<キャラベース>>\n世界：ファンタジー（和洋どちらも）\nスラム上がりの冒険者的なキャラで気性は荒く攻撃的だが根は世話好き。若干小柄？\n顔＆雰囲気イメージ\nhttps://pbs.twimg.com/media/Fu3de9SaEAAAtbY?format=png&name=900x900\n武器：平刃の山鉈のような鉈剣二刀流。\n服装：軽装の前衛のイメージ。\n　　　　水着、シャツかビキニ鎧をベースに何かしら着こんでいく感じ。\n　　　　軽装鎧や短いジャケット、\n　　　　サンプルのようなヒーローマフラーやボロマントの着込みでも。\n　　　　ただ、できれば足元はゴツめにしてほしいです。\n　　　　レザーアーマーやプロテクターなど。\n\n絵は立ち絵でも構いませんし、何かポーズでも描きやすいものでOKです。\n2面/3面図でなくてOKです。\n\n\n\n一応、先行するうちの子があって和風ですが、\n洋風も遊びたいので、、、なんでもありです。\nhttps://twitter.com/ya_ku_to/status/1647547850933559296\nhttps://skeb.jp/@xx_dang_t_xx/works/37\n\n\nご検討お願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saso2010/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 500353, "client_id": 2599942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57a9ab69/uploads/origins/f53c739b-16f6-4c9a-8dac-8497f8644cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe4bf3ce0c660f3dc1015d8d9c0a505", "srcset": "https://si.imgix.net/57a9ab69/uploads/origins/f53c739b-16f6-4c9a-8dac-8497f8644cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fe4bf3ce0c660f3dc1015d8d9c0a505, https://si.imgix.net/57a9ab69/uploads/origins/f53c739b-16f6-4c9a-8dac-8497f8644cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32f1fabc56eb0b0fa18a26934f49c276 2x, https://si.imgix.net/57a9ab69/uploads/origins/f53c739b-16f6-4c9a-8dac-8497f8644cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec987e92749d61ba7619cf032fae6a32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57a9ab69/uploads/origins/f53c739b-16f6-4c9a-8dac-8497f8644cdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200