ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81a692e8b79daf77845986fbc9613177, https://si.imgix.net/f2c8230e/uploads/origins/754500c1-3d82-4cf2-a113-fdeda4c6a56a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b93a8b58386b8eadb923fee1f92365fa 2x, https://si.imgix.net/f2c8230e/uploads/origins/754500c1-3d82-4cf2-a113-fdeda4c6a56a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ce7741a178a813e9b10b008e4711a14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2c8230e/uploads/origins/754500c1-3d82-4cf2-a113-fdeda4c6a56a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2510a083eb3b4c4501b96f709bffa7b0", "srcset": "https://si.imgix.net/f2c8230e/uploads/origins/754500c1-3d82-4cf2-a113-fdeda4c6a56a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2510a083eb3b4c4501b96f709bffa7b0, https://si.imgix.net/f2c8230e/uploads/origins/754500c1-3d82-4cf2-a113-fdeda4c6a56a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca274166f2203a591c2627c64e1fbcd7 2x, https://si.imgix.net/f2c8230e/uploads/origins/754500c1-3d82-4cf2-a113-fdeda4c6a56a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56871b685ab0f829d0369fc59723e87c 3x"}, "body": "初めましてこんにちは！\n染璃様の描いたイラストを新着で拝見し、とてもとても一目惚れしてしました！\nもし良ければOCのリクエストさせていただきたいです！\nCoC「純潔と鉄血」のOC達ですがシナリオのネタバレはありません·····！\n以下キャラクターの詳細です。\n\n✦︎ HO1 \n性別︰男\n年齢︰23歳\n身長︰187cm\n\n無口の口下手。仏頂面で不機嫌面の為、初めて会う人からは怖がられている。\nその警戒はまぁ間違っておらず、無口な上に口下手なためコミュニケーション能力は壊滅的と言って差し支えはない。\n基本的に誰とも群れず、極狭い交友関係の仲で過ごしている。言葉遣い強め。\n車が好きではあり、車を傷つけられると怒る。\nHO2の指示役でありサポーター。\n\n︎✦︎ HO2\n性別︰女\n年齢︰11歳\n身長︰122cm\n\n真面目で年齢よりも大人っぽい。\n感情が表情に出にくく、読み取りづらいがしっかり感情は存在している。\nどんな相手であろうと敬意を持って接している。\nしかし内面にはちゃんと子供らしい1面もある。純粋無垢。\n\nHO1と組んでおり、主に仕事をするのはコッチ。\n\n︎✦︎ 二人の関係性\n仕事で組んでいる二人組。相棒や友達とはまた違ったような関係性。\nHO1がHO2に弱く、HO2からの頼み事は基本断らずにしてくれます。\nHO2はHO1に対して怖いという感情を抱いたことはなく、家族の一人のように大切に思っています。\n静かめな二人ですが、日常会話は割とのほほんとしています。\n\nHO2の方が運動神経が良く、重たいものを持てます。HO1は非力です。\n\nお願いしたいところは特にございませんのでクリエイター様のお好きなように自由に描いていただけると嬉しいです！\n\nお値段の変更など不備ございましたら再送していただけると嬉しいです。\n\nもしご縁ありましたら、よろしくお願いします🌸\n\nhttps://drive.google.com/drive/folders/1I8YCtlQlLo9jxIFRYaGFyfC2wwPf5EeL", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HANADA_SOMERI/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3454311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e787ec79/uploads/origins/f6929c18-6f3c-4dfe-89ac-702855b1eca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51652fa87bbe82953d4321f28991ba33", "srcset": "https://si.imgix.net/e787ec79/uploads/origins/f6929c18-6f3c-4dfe-89ac-702855b1eca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51652fa87bbe82953d4321f28991ba33, https://si.imgix.net/e787ec79/uploads/origins/f6929c18-6f3c-4dfe-89ac-702855b1eca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=327801694448f23fedd2ea220bdf68a8 2x, https://si.imgix.net/e787ec79/uploads/origins/f6929c18-6f3c-4dfe-89ac-702855b1eca0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ecc2cb0d74abb5779f3231f7bf93431 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e787ec79/uploads/origins/f6929c18-6f3c-4dfe-89ac-702855b1eca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04401380f2892cca793c89b5366adabd", "srcset": "https://si.imgix.net/e787ec79/uploads/origins/f6929c18-6f3c-4dfe-89ac-702855b1eca0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04401380f2892cca793c89b5366adabd, https://si.imgix.net/e787ec79/uploads/origins/f6929c18-6f3c-4dfe-89ac-702855b