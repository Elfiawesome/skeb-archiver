4f1c-b12e-50709263bee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f70f17906a3e8c80bf09e5ffc36ce443, https://si.imgix.net/5f1c2b5a/uploads/origins/94197c0a-0090-4f1c-b12e-50709263bee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0bcbb780581fee8cb05df95e9894289 2x, https://si.imgix.net/5f1c2b5a/uploads/origins/94197c0a-0090-4f1c-b12e-50709263bee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=33c231ff76c52b374fdf81fa3a8b5292 3x"}, "body": "很高兴见到你，我叫 MINI TOROCO，是 Youtube 上的全年龄段 ASMR 爱好者。\n我在 X 上看过很多 AKARi 的作品，一直在关注。我喜欢您作品中的独特氛围！（我也喜欢布依苏波......！）。\n(我也喜欢布依苏波......！）我想请您画一个我在活动中使用的形象人物。\n\n下面是人物参考资料。\n特征\n白色到银色的长发，波浪状。\n眼睛呈红紫色和淡蓝绿色。\n眼睛像猫。\n她有双层牙齿（右侧尤为明显）。\n前额有金色月牙状的网状饰物。\n身高：约 157 厘米。 胸部：不大。\n没有发饰。\n\n衣着。\n乳沟不太明显\n宽松服装（如吊带衫和宽松开衫）\n可开启或关闭的黑色模糊眼镜\n\n用途。\n用于 Youtube 的缩略图、发布屏幕的站立图片和 sns 图标。\n主要用于所有年龄段的 ASMR（刺耳的声音）。\n如果您能完成构图，使头部周围的区域不被切断，将非常有帮助。\n如果您还添加了背景，请将人物层和背景层分开。\n如果可能的话，我还希望 OBS 中眼罩的滑动动画能有一个差异。\n\n非常感谢您的考虑。\n\nhttps://drive.google.com/file/d/1arsvzGe11jU5sXw9jEXEq7KHbd4o7uiA/view", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AKARi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2164885, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/835b9671/uploads/origins/8ea151f0-879d-4787-b7c4-3de4e96eed51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e69f03d92db8589037bac6d9a7ca8b3", "srcset": "https://si.imgix.net/835b9671/uploads/origins/8ea151f0-879d-4787-b7c4-3de4e96eed51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e69f03d92db8589037bac6d9a7ca8b3, https://si.imgix.net/835b9671/uploads/origins/8ea151f0-879d-4787-b7c4-3de4e96eed51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f58a28c930c01dd8e2d7c3a0