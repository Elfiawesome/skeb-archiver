ごちゃしてしまいそうなら濡れ透けだけでも十分です。\n資料だけでは色味や細部など迷うことがあるかもしれませんが、好きにアレンジしてください。\n色々書きましたが、あのぶっかけイラストを別のキャラでも見たい！というだけなので、細かい指定は無視して描いてしまっても構いません。立ち姿じゃなくても問題ないですし極論透けてなくても良いです！ぴろきとーるさんの描く全身ぶっかけイラスト、是非お願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekakiidolneko2/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b4a9aabb/uploads/origins/6d4b3275-fd46-4059-816f-032e0df6d8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c13a7482116133323b72e5ef8c88349", "srcset": "https://si.imgix.net/b4a9aabb/uploads/origins/6d4b3275-fd46-4059-816f-032e0df6d8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c13a7482116133323b72e5ef8c88349, https://si.imgix.net/b4a9aabb/uploads/origins/6d4b3275-fd46-4059-816f-032e0df6d8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eeceec37184f8f22d25b37d02a6794f0 2x, https://si.imgix.net/b4a9aabb/uploads/origins/6d4b3275-fd46-4059-816f-032e0df6d8e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1a32dd6b5f883e849ee5f7b354a7df47 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1514126, "nc": 162}, {"path": "/@oekakiidolneko2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1514126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2812b0e3/uploads/origins/bcd66c8b-032d-4357-9603-07ab2a0e68ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11aa42eeba283e339608dc90f71e