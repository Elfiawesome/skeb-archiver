//kyubihome.booth.pm/items/3390957\n\n使用衣装\nhttps://himeso.booth.pm/items/5271972\n\n使用用途\nvrchatでの使用（ワールドに飾ったり、改変に使用したり）\n\n以上、よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/403htnd817ktjn1fnauao/AL4i4Fhfdyj7UzFDNNiMni8?rlkey=4892cfajsc81r9mdj0elhcybz&st=kg6vb8t0&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amd_vrc/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2869894, "client_id": 1588607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daab008b/uploads/origins/f3e14f64-3456-45f7-b842-d03ad2127497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f630472d489e9da4681093674d0e40a1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daab008b/uploads/origins/f3e14f64-3456-45f7-b842-d03ad2127497?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e992a6fb0bb32dee99344e46df18a234", "src_set": ""}, "body": "いつもお世話になっております！喫茶雨音店主のkinakoです。\nもしよろしければ、喫茶雨音の店内でくつろぐお客さん（任意のアバター）のイラストをお願いしたいです。ワールドへの掲示も予定しています。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amd_vrc/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2869894, "client_id": 1451618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ce8e66c/uploads/origins/c4c18845-a6e5-46ed-ac29-6527f218e114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfceb1a0e5cb64aed1d9cb18177e32a8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ce8e66c/uploads/origins/c4c18845-a6e5-46ed-ac29-6527f218e114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b59f35a04bfcfe6b9d4b619c