200&h=200&s=05b91fde2fe4bc63c04bf2072e95b334 2x, https://si.imgix.net/50363a4b/uploads/origins/ecad8832-7c30-49b0-89f0-b2b17144abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb92ad2f70138275cc3667fc621c4c83 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50363a4b/uploads/origins/ecad8832-7c30-49b0-89f0-b2b17144abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31d0df4416adadf2e8500e6815862059", "srcset": "https://si.imgix.net/50363a4b/uploads/origins/ecad8832-7c30-49b0-89f0-b2b17144abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31d0df4416adadf2e8500e6815862059, https://si.imgix.net/50363a4b/uploads/origins/ecad8832-7c30-49b0-89f0-b2b17144abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a83f05a7e0d53f8084f2505c57111073 2x, https://si.imgix.net/50363a4b/uploads/origins/ecad8832-7c30-49b0-89f0-b2b17144abbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0136d26ec9fd5162627012352a522356 3x"}, "body": "こんばんは。いつもお世話になっています。たまちさんのきらきらつやつやした光のある色の塗り方や可愛い絵柄が好きです。\n\n依頼内容についてです。添付させていただきました資料の自分のキャラと相手のキャラの一枚絵を描いていただきたいです（相手の方には許可を得ています）。\n\n構図、シチュエーションとして、\n・こちら側（画面側）を向いているのではなく、お互いがお互いの方を向いている。出来れば全身絵ではなく上半身のみの絵が好ましい。\n・女性(〈忘却された意思〉)の首には首輪とリードがつけられており、青年（人形）がリードを持って自分の方に引き寄せている。\n・青年はにやりと笑って女性を見下ろしており、対して女性はどこか諦めたような、悲しそうな顔で青年を見上げている。\nといったようなものをお願いしたいです（不可能であった場合は無視して大丈夫です）。\nその他に関しましては自由に描いてくださって大丈夫です。\n\n頂いた作品に関しましては個人観賞の他、相手に見せる、skebの依頼用資料として使用させていただく事を想定しています。\nリクエスト内容が金額と釣り合っていなかったり、内容が難しいようでしたら、お気兼ねなく断っていただけたらと思います。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/18zrEXxe3Bwl0Y3A4-J85pKPtjjQ5-uVz", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0Haniwa0/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "t