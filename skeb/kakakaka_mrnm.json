ka_mrnm/works/30", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/299949ce/uploads/origins/7e3588b0-2de0-405f-a9f0-051361530986?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9f282c771d5ede64cbe8244b0cd3d03f", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1904834, "client_id": 3231204, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kakakaka_mrnm/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1904834, "client_id": 880873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ace637b2/uploads/origins/54e874bb-32db-4057-9fe0-01fe12907e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddec09f780107919efe2595f4c7724a6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ace637b2/uploads/origins/54e874bb-32db-4057-9fe0-01fe12907e53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6735396d5fd38955f08fae77f03103c", "src_set": ""}, "body": "こんにちは、Vtuberの氷室ルキです！\n素敵なvoreイラストを拝見してぜひ描いていただきたくてリクエスト送りました！\nもし不備やプライベート設定にする必要がありましたら再送要求おねがいします！\n\nリクエスト内容\n\n氷室ルキとロピカくん（資料参考）が大きな捕食者に丸呑みされて液体まみれになっちゃっている様子が見たいです！\n二匹の帽子は極力脱がさないでいただけると助かります。\n\n2カットの場合のイメージは\n\n①氷室ルキが捕食者に舌で絡められ食べられそうになっている様子、食べられそうになっているのにゾクゾクして顔を赤く染めちゃっている\n②捕食者の大きく膨れたおなかの中で先に食べられていたロピカくんと一緒におなかの中で恍惚とした表情でぼーっとしちゃっている様子\n\nという具合をイメージしています。\n\n別の作者のイラストなのですが、このようなイメージが大好きです\nhttps://www.pixiv.net/artworks/94614465\n\nかかさんの素晴らしい発想でお好きに捕食させて、おいしいごはんにしていただけるととてもうれしいです！\n\n氷室ルキのイメージ\n・男の娘\n・ピンク色のもふもふ\n・ふわふわ甘ったるい\n・はうっ！と鳴く\n・食べることが好き\n\nロピカくん設定\n本名「ロピカシア・アナスタシス」\n男の子の垂れ耳猫さん\n出不精な性格\nちょっと中二病\nたれ目でちょっとだけ眠そうにしている\nご飯いっぱい食べるので太り気味、おなかぽっこり\n\nレイヤー情報付きの透過PSDファイルがあると嬉しいですが、かかさんにお任せします！！\n\n資料等は下記のグーグルドライブにアップロード致しますので確認お願いします。\n\n氷室ルキ資料\nhttps://drive.google.com/drive/folders/1Sj_LivCVxtepi73XZen5EAsg3D3LOxtk\n\nロピカくん資料\nhttps://drive.google.com/drive/folders/18q1d_iNdU0iyVouPGrQE-VppwkHd5m7C\n\n何卒、よろしくお願いしますっ！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kakakaka_mrnm/works/28", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5fe2432b/uploads/origins/9d962713-5ffd-4e0b-80f5-408513dc9a28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0db2ad36e524b451fa03419dbcd6f24f", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 1904834, "client_id": 966640, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kakakaka_mrnm/works/27", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f11da05a/uploads/origins/c7703cf5-2644-4be7-b9a4-32766472f58d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00f042d6ee227219e43764e2f814e235", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1904834, "client_id": 1492998, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kakakaka_mrnm/works/26", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/21f0455f/uploads/origi