2Fprofile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff9d186314869330760ac9a6801a6888 3x"}, "body": "さんかくきんさんの中でパッと浮かんだキャラクターとして「とある日の眠れなかった夜のこと」を教えてほしいです。\n内容はそのキャラクターに基づいた創作話でも実際のお話でもなんでも構いません。血やグロい描写がなければ本当になんでもいいです。「つい最近眠れなかったことある？何して過ごしてた？」と聞かれたとし、それに返答するといった感じで話してもらえたら嬉しいです。長さも問いません。 依頼として興味を惹くことができていたら受けてもらえたら嬉しいです。ご検討よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Sankakukin3/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 2301874, "client_id": 2576020, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/eaf64894-661d-453d-8464-d1a26fcc988c?response-content-disposition=inline&Expires=1785028484&Signature=SmQXWFYl3qny~SqSUzAJuMWoBR2K9AtW2thxXCsTNFACPuD8WIeuiBy-Ly~7irORc0i2azEXHdtiv4CtNDo1djVgonGlRX7P4ksnJhbc8L~REPbomPe2yLqmhqkdCJ32QvdpE0qJgpaLpV~Gnm334SfHEGlxTD2RcZTDOs6JRDV4lGQu-xz-i2ssniisEQYzYMAPnlUJt4lhd52DlJKX2x~yJP0K2fDpiiZdUprtZ9AAFfxYP9KYPoYjzSHhp-EptOI4zhA6MoMp~sGXF12v2MknEZ3iaTi20CINt4xYVIoFjKMOadpNAQK-hnzkTGniWcgH-b01DrRiCrzcDUC4oA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ae58386c1d65b15269b8757c1c20ad", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ae58386c1d65b15269b8757c1c20ad, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1570012723488129025%2F_RhsOR3e.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=310e0b86241ad012c9090c7456bc3efa 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_ima