。ありがとう！\n\nhttps://catbox.moe/c/l4tajk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@OH_QuQ/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 761434, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0184acadb949dd1bbc5e22deda29ff3b", "srcset": "https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0184acadb949dd1bbc5e22deda29ff3b, https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e35897ea8a0031d63f64f337c1d60560 2x, https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91ca46e5ab907bccb3df86d44fb9adba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b2ca485fabbd49292e97066f1ad45cc", "srcset": "https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b2ca485fabbd49292e97066f1ad45cc, https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95b2ac67031e6efe3109aa1d6c246503 2x, https://si.imgix.net/ea8bad7b/uploads/origins/e1b46c52-e489-4c11-8ab1-12fe94509a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fae