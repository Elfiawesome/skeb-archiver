寄りで、身体を太く描かなくて大丈夫です。\nルーズに見えるのは服のサイズ感によるものです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2861066, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "なごり", "screen_name": "uusdvedp", "avatar_url": "https://pbs.twimg.com/profile_images/1765284976457826304/jaloSp0P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1463769536390316033/1754383010/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2869942, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "からあげ🍗", "screen_name": "karaage_ha_315", "avatar_url": "https://pbs.twimg.com/profile_images/1957078947021324288/BJ2lnNve.jpg", "header_url": "https://pbs.twimg.com/profile_banners/853863355731255299/1781022202/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 3260436, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "328", "screen_name": "_328_", "avatar_url": "https://pbs.twimg.com/profile_images/2025954562545471488/b1__QRR4.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 3286281, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "TNT", "screen_name": "TNTisogabaturn", "avata