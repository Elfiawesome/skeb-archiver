t%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75203bab80568a8822b8761381bee266 2x, https://si.imgix.net/5759a52c/uploads/origins/42c554a0-b82b-45e9-87d7-ed728dbf519c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11df4597c674583c75503822064ea244 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5759a52c/uploads/origins/42c554a0-b82b-45e9-87d7-ed728dbf519c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=586b0b3af6b1c3040042fca09966b0af", "srcset": "https://si.imgix.net/5759a52c/uploads/origins/42c554a0-b82b-45e9-87d7-ed728dbf519c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=586b0b3af6b1c3040042fca09966b0af, https://si.imgix.net/5759a52c/uploads/origins/42c554a0-b82b-45e9-87d7-ed728dbf519c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b31bdc4f8ff388b858635278560f9a4 2x, https://si.imgix.net/5759a52c/uploads/origins/42c554a0-b82b-45e9-87d7-ed728dbf519c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d42bc74897af66b7f6495ec08cd59504 3x"}, "body": "前回のキャバ嬢同士が同一人物で喧嘩する作品ありがとうございました。\n今回良ければまた男絡みの作品をお願いしたいです。\n女の子の名前は仮にA子とB子で女同士で殴り合いの喧嘩になり警察沙汰になりそうですという話しで\n\n飲み会の帰りのA子とB子は中はあまり良くなくバス停で二人で同じバスを待ってる間に取っ組み合いになったという流れです。\n\nA子と同じ大学の同級生でサークルも同じB子から吹っかけられてお腹を殴り合い髪をひっぱりあった後、立たなくなったB子を髪を掴んで立ち上がらせて追撃したみたいです。\nA子もB子もお腹かアザだらけで服もボロボロになって終わり、素人同士の喧嘩で勝ったのはA子です。\n\n話の参照元\nhttps://oshiete.goo.ne.jp/qa/12373904.html?pg=1\n\nバス停で自分と同一人物とあったとか色々いじって貰えたら嬉しいです。バス待ちの間か家最寄りのバス停で降りたらソイツがいたとかお任せしたいです。\n\n電車内で男女が激しく取っ組み合いする動画をこの間見まして。アダルトビデオの電車モノのセットで女同士のキャットファイト作品を描いて頂けたらと思っていたのですがこのバス停での喧嘩と合わせて一つの話しにしてもらったり参考程度で見て頂けたら幸いです。　\n\n電車での取っ組み合い\nhttps://twitter.com/3966/status/1563824346212487173?ref_src=twsrc%5Etfw%7Ctwcamp%5Etweetembed%7Ctwterm%5E1563824346212487173%7Ctwgr%5Eb0e14f710c5fa3f52e729adcc7b48d0f565679b0%7Ctwcon%5Es1_c10&ref_url=https%3A%2F%2Fmatomedane.jp%2Fpage%2F111876\n\n本当に長くなりすみません、流れや人物全てお任せ致します。読んで頂いてありがとうございました。", "nc": 58, "word_count": 4198, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@Oh9lawin1/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1499204, "client_id": 1933920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c60946c9a96e38bd95225bc34f6a4ab2", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c60946c9a96e38bd95225bc34f6a4ab2, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40cd42abcb48e53a56b4b3d9685eaaf7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2f1d58b96da7a8b1c6e61d28b0c5def 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df118df9529f9aa468ab64f08989cdd8", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df118df9529f9aa468ab64f08989cdd8, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9a29169708eac236713513ddc11c9a41 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccd7ea6d3eb2b2c453c42287bac97840 3x"}, "body": "初めてリクエスト失礼します。\n渋谷凛の同一キャットファイトのような話しを\n歌舞伎町であった1人のホストを巡ったキャバ嬢2人で書いて頂けないでしょうか。\n\nホストと交際している女の子、仮にみきとして\n親友のみさき（仮）が自分の彼氏と浮気していてホストクラブの店の前で4Lの焼酎を頭からかけて土下座して厚底のサンダルで踏むという話があったのですが\n\nこれをたたき台で是非話を作って頂けないでしょうか。\nお酒をかけられた事をきっかけで2人がホストクラブ内でキャットファイトを始める流れか、負けた相手がお酒をかけられて土下座の流れ\n\nすべてお任せしたいです。不倫相手がどんな女かと思っていたら自分とまったく同じ女だったというのも面白そうです。是非お願いしたいです。\n\nまとめのサイトですが参考の写真と相関図のリンクになります\n\n参考１\nお酒かけられ土下座\nhttps://www.mudainodocument.com/articles/99143.html?from=98708\n\n参考2\n階段で追い詰められ追い詰め\nhttps://www.mudainodocument.com/articles/99144.html?from=98708\n\n参考3\n相関図\nhttps://www.mudainodocument.com/articles/99145.html?from=98708\n\n長くなりすみません。\nあらすじや場所などの設定お任せ致しますので\n不倫された女と寝取った女の口汚いキャットファイトお願いしたいです。", "nc": 187, "word_count": 4945, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@Oh9lawin1/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/75b67ce3/uploads/origins/61a56512-6f88-401d-a85f-206543b831c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4599ccc0606242c29895f8ed48edaced", "srcset": "https://si.imgix.net/75b67ce3/uploads/origins/61a56512-6f88-401d-a85f-206543b831c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4599ccc0606242c29895f8ed48edaced, https://si.imgix.net/75b67ce3/uploads/origins/61a56512-6f88-401d-a85f-206543b831c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1bf0aca1d665d095b31d9d337b52ec21 2x, https://si.imgix.net/75b67ce3/uploads/origins/61a56512-6f88-401d-a85f-206543b831c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d57133413bfe195bdc48e0623eb0d9a 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 1499204, "nc": 48}, {"path": "/@Oh9lawin1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1499204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f35cc788/uploads/origins/363a59d6-fa7d-4173-a75b-450b66c17e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bf4fa9ab1cbe633492fd44665c6e124", "srcset": "https://si.imgix.net/f35cc788/uploads/origins/363a59d6-fa7d-4173-a75b-450b66c17e46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=