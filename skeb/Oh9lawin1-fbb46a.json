e_same_genre": true}, {"path": "/@Oh9lawin1/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1499204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b022935a40a4fa6ef409b38bd9336c", "srcset": "https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4b022935a40a4fa6ef409b38bd9336c, https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18e21c9ac2fc1f45652814e5ebc94832 2x, https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f58310eb422f9f4e954f32ebf35deb1b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6c31630a398b6626bbf54f558f04b20", "srcset": "https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6c31630a398b6626bbf54f558f04b20, https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b1a367a9f37b203ddc8b58579689682 2x, https://si.imgix.net/b45bb1ce/uploads/origins/b6c01bdd-4989-4ae8-b55f-0eb5c878daa6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4f7b313f2b2c24b7fc33e2c2560ebeb 3x"}, "body": "過去にリクエストしたカントボーイ化小説の続編をリクエストさせてください！\nhttps://www.pixiv.net/novel/show.php?id=19275176\n\n結局ホルモン治療と豊胸手術をして、見た目女になって生活しているお話をお願いします。\n\n◼︎状況\n手術から数年後、家族や知り合いと半ば縁を切って一人で暮らしている。\nホルモン治療で身体は丸みを帯びて乳首も女性らしくなっていて、股間は隠毛が淡く生えて傷口が隠れている。裸でも元男とバレない。\nけど骨格は男なので少し違和感がある。\n男に恋愛感情を抱けず処女。恋愛対象は女。銭湯などで女の裸に興奮する。\n人工的に性同一性障害の状態になってしまっている。\n\n◼︎シーン\n自分の部屋で着替えてるところ。姿見に映る全裸の自分の姿に物憂げ。\n首を下げて身体を見下ろして、男ではありえない形に強い違和感。\nダイレーションで股間の穴が塞がらないよう膣拡張、からのムラムラして自分の身体をオカズにオナニー。", "nc": 169, "word_count": 4431, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@Oh9lawin1/works/9", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a410173b9b1826d9c8fcd475be635283", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a410173b9b1826d9c8fcd475be635283, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5185d4041828f5069d887020552bb49f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878085112908369920%2Fiyr5VoAi.jpg?ble