a/uploads/origins/6dce20c6-5c22-4c42-8310-be2c29c82adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=112db509953667240a96b42841d97bd9", "src_set": ""}, "body": "キャラクターいずみ\nアイデア: 海辺で小さな人たちと遊んでいるいずみ。\n状況：彼女は水の中に座っている。水が彼女の足を少し覆っている間、人々はまるでどこかの水生テーマパークのように彼女と遊んでいる。\n彼女の足や腕に登る人、彼女の手の上に立つ人、彼女の体を滑り降りる人。\n彼女の肩には、彼女の髪を掴んで立っている他のちびっ子たちもいる。\n服装：泉の水着は、あなた自身のデザインと好みで選んでほしい。サプライズして！ 😉。\n見る角度：アングルはローアングルで、妖夢と一緒に描いたこの絵のように、見る人の上にそびえ立ついずみにしてほしい。https://www.deviantart.com/hank88/art/Youmu-at-the-beach-853390492\nそのイラストと同じくらいの大きさにしたい。\nいづみは身長87m、緑色の目をした金髪の犬の女の子で、水色のリボンで結ばれたポニーテールをしていますが、お望みならルーズヘアにしてもかまいません。それはあなた次第です！\nこの度はありがとうございました。\n\nhttps://drive.google.com/drive/folders/12KRiL3M7_p6kuwdpKwqU9pRoSE0ueESn", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noritamagomyon/works/142", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/602c7891/uploads/origins/7f1a0af8-7c66-40dd-89ad-53eafb6a1972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b706a59073c0c9ad89583652a8f5f102", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 555464, "client_id": 1860617, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@noritamagomyon/works/141", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7e609caf/uploads/origins/3c503ac2-0193-4bfa-a57e-139f4659e321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=410dee294176992b9eb47cbcd49674a7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 555464, "client_id