antart.com/hank88/art/Youmu-at-the-beach-853390492\nそのイラストと同じくらいの大きさにしたい。\nいづみは身長87m、緑色の目をした金髪の犬の女の子で、水色のリボンで結ばれたポニーテールをしていますが、お望みならルーズヘアにしてもかまいません。それはあなた次第です！\nこの度はありがとうございました。\n\nhttps://drive.google.com/drive/folders/12KRiL3M7_p6kuwdpKwqU9pRoSE0ueESn", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noritamagomyon/works/142", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/602c7891/uploads/origins/7f1a0af8-7c66-40dd-89ad-53eafb6a1972?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b706a59073c0c9ad89583652a8f5f102", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 555464, "client_id": 1860617, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@noritamagomyon/works/141", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7e609caf/uploads/origins/3c503ac2-0193-4bfa-a57e-139f4659e321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=410dee294176992b9eb47cbcd49674a7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 555464, "client_id": 280874, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@noritamagomyon/works/140", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e84a1002/uploads/origins/3e44d496-066f-4ba4-a4d9-db8639849b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=20