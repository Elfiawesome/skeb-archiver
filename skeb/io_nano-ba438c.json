ploads/origins/7fb98c3e-c473-40ac-bb45-23891f40e1dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22577333bb2716893427bfb9de5995f2 3x"}, "body": "魂魄妖夢\n最近、おっぱいの成長がとても早いです。\n衣服は絶え間ない成長に追いつくことができません。\nシャツはきつく引っ張られています。ボタンは苦戦しています。ボタンの隙間からブラが見えます。\n背中のレントゲン写真では、ブラジャーのホックがかろうじて留められていることがわかります。\nどうやら一息で衣装全体が爆発する準備ができているようだ。\n妖夢は気をつけようとしている。しかし、おそらく長くは続かないでしょう。\nおっぱいはできるだけ大きくしてください。大きいほどいいですよ！\n\nありがとうございました。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@io_nano/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 52956, "client_id": 1388897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b59568891fba14c35caecf551033eb2", "srcset": "https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b59568891fba14c35caecf551033eb2, https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d54030ac540d99a5eefc48f6d50df8e 2x, https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90eafa5f13da90bda97c1b61f407737a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=819e289b4f2c6e14a783c4fcdca8fbd5", "srcset": "https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=819e289b4f2c6e14a783c4fcdca8fbd5, https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f6a3ee266add8d95eb7d57807d3edee 2x, https://si.imgix.net/30005d27/uploads/origins/36313609-9baa-44fc-890f-a6161f5d18d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=980220dfa49f04aee4c4268a5d4a0c20 3x"}, "body": "募集再開を確認しましたので送りたいと思います。\nキャラ：洩矢諏訪子\n内容\nランドセルを背負った小〇生（風）諏訪子ちゃんをお願いします。\n差分有り及び全裸が問題無ければ服を無くした「裸ランドセル」姿もお願いします。\n諏訪子のスタイルはお任せします。\n台詞の有無はお任せしますが、もし有りであれば。\n１：相手の要望でなった（ノリノリか恥じらいの２パターンどちらか）\n２：小〇生のフリして信者勧誘\nと言う状況が伝わるようなのをお願いします。\n\nこれで宜しければお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@io_nano/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 52956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=667e5b7805600ec13cb49ec81071db16", "srcset": "https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=667e5b7805600ec13cb49ec81071db16, https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abbc52911fc0d5ec2641ad667aaace82 2x, https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=623b617d8a935e5cc7f65d9bb4caf475 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d5e3cae182a41acf5633e53dfff66a", "srcset": "https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9d5e3cae182a41acf5633e53dfff66a, https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96d54b649f9fda8c46ad0b7758dbf04a 2x, https://si.imgix.net/abe6c0c8/uploads/origins/284de6a8-277d-4332-9ffe-fc941022316e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01fa5c925d6d31dd14e26b65049f728e 3x"}, "body": "Skeb開けていただきありがとうございます。送りたいキャラや要望等かなり悩みましたが、\n\nまたリクエスト失礼します。\n\n今回リクエストするキャラは、てゐちゃんでドヤ顔でロリ巨乳をメスガキチックに見せびらかす絵をお願いします！\n\nhttps://www.pixiv.net/artworks/130711034\n\n表情や基本構図は、コチラを参考にお願いします。　描写は、お腹くらいまでで大丈夫です。\n\n一枚目は着衣の基本構図、\n\n二枚目は下着姿、　こちらはセクシーな下着であれば唆ります。\n\n三枚目は全裸でお願いします。\n\nこいしちゃんの時みたいなセリフや擬音等あれば良いなと、、、かなり良かったので、、、、\n\n乳の大きさは、いおさんが前に描いた、あうんちゃんくらいが良いなと、乳輪や乳首の大きさはリクエストした小傘さんとバブみこいしちゃんの中間くらいが理想的だなと、、、、、\n\n色々細かい要望リクエストになってしまいますが、お応えいただければ幸いです。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@io_nano/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 52956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fb01192/uploads/origins/a9ffbf00-2ddc-4ce3-8767-c4d77fccbb9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c689711efd5c897af755f0f1910583", "srcset": "https://si.imgix.net/9fb01192/uploads/origins/a9ffbf00-2ddc-4ce3-8767-c4d77fccbb9f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64c689711efd5c897af755f0f1910583, https://si.imgix.net/9fb01192/uploads/origins/a9ffbf00-2ddc-4ce3-8767-c4d77fccbb9f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200