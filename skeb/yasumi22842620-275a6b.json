わっています。\n\n-----------------------------------------------\n\n案②\n【キャラクター】\nFGOより、モルガン（ふたなり）\n\n【シチュエーション】\nマスターへのバレンタインチョコを密かに作っている最中、ボウルに入った湯煎したチョコレートの前に裸で蹲踞かよつん這いのポーズになり、\nふたなりおちんちんから自分の精液を出してミルクチョコレートを作っている様子。\n\n-----------------------------------------------\n\n案③\n【キャラクター】\nFGOより、ジャンヌ・ダルクとジャンヌ・オルタ（両者ともふたなり）\n\n【シチュエーション】\n額当て以外裸になって、立ち状態で兜合わせして、射精するまでの様子\n\n-----------------------------------------------\n\n好みのシチュエーションがない、工数に見合わない、他NGなどありましたら遠慮なくキャンセルしていただいて大丈夫です。\nよろしければご検討お願いいたします！！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 17893, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "今ゾン", "screen_name": "now_zone", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:ajpdy76j5lhxlybyffew3ay4/bafkreih6ha4hxcb5rp2csqbhqfws5alkh4mtihgeocfekpzkicnv6ofkwy", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 33}, {"id": 653620, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "QR", "screen_name": "kataarmd", "avatar_url": "https://pbs.twimg.com/profile_images/1682357578846859267/a9hJZ-T9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3190992588/1700102789/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "nc": 48}, {"id": 871260, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "糞肉与吉🍑skeb open", "screen_name": "kusonikumarukun", "avatar_url": "https://pbs.twimg.com/profile_images/1919253798679416832/teJqj-va.jpg", "header_url": "https://pbs.twimg.