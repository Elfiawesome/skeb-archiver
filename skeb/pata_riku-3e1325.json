します。  一つでも含まれてるのであれば、他にたまごを連想されるモチーフをいくら描いて頂いても問題ありません。 （オムライスなど調理がなされてるモチーフを描いて頂いても問題ありません）  \n\n髪型や服装に関するリクエストは特にありません。モチーフを落とし込んだ上で制作者様の感性におまかせする形になります。お手数おかけします。 背景色に関するリクエストも特にはありません。完成したイラストに合わせた背景色にして頂ければ、幸いです。\n\n  長くなりましたが、ご依頼を受けていただけますと大変ありがたく思います。これからも一ファンとして陰ながらではありますが、応援しております。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pata_riku/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5363, "client_id": 1573383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a82d4220/uploads/origins/59d31e40-740d-41fa-b0c5-d9f8c8a6d66e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e77745e338028eedefb079ecd0231e9", "srcset": "https://si.imgix.net/a82d4220/uploads/origins/59d31e40-740d-41fa-b0c5-d9f8c8a6d66e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e77745e338028eedefb079ecd0231e9, https://si.imgix.net/a82d4220/uploads/origins/59d31e40-740d-41fa-b0c5-d9f8c8a6d66e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5d1c26f613ce971e5ca7539b719cbee 2x, https://si.imgix.net/a82d4220/uploads/origins/59d31e40-740d-41fa-b0c5-d9f8c8a6d66e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a58992a41b318443d58d4fe1c378844e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a82d4220/uploads/origins/59d31e40-740d-41fa-b0c5-d9f8c8a6d66e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=987d3911fcc1d76d57f0322ee6b3a840", "srcset": "https://si.imgix.net/a82d4220/uploads/origins/59d31e40-740d-41fa-b0c5-d9f8c8a6d66e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=987d3911fcc1d76d57f0322ee6b3a840, https://si.imgix.net/a82d4220/uploads/origins/59d31e40-740d-41fa-b0c5-d9f8c8a6d66e?bg=%23fff&auto=format