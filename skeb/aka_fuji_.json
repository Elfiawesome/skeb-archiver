_id": 2333842, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dde7be2b/uploads/origins/1ad21311-7faa-4a40-aeb1-187f3b6b6490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d07f9f1279acf6e005097d8939bbc1d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dde7be2b/uploads/origins/1ad21311-7faa-4a40-aeb1-187f3b6b6490?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=850ad9e0d261bdec172ba98911e556ae", "src_set": ""}, "body": "こんにちは、あなたのアートワークが大好きです！音楽のジャケット用に、私のキャラクターのイラストをお願いしたいです。私のキャラクターは怠け者のゲーマーの女の子で、下のリンクにあるようなポーズをとってほしいです。参考画像には足が描かれていませんが、お好きなように描いてください（裸足でも構いません）。\n\nポーズ参考：https://imgur.com/a/uwX48lf\n\nキャラクター参考：https://imgur.com/a/sitrus-ref-album-8AVG5Qd\n\nhttps://imgur.com/a/sitrus-ref-album-8AVG5Qd", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aka_fuji_/works/549", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2616061, "client_id": 614393, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12dcc4cf/uploads/origins/7cd348e3-bf03-4434-9f74-6ab06e5e1cee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=281dcbc917af57e808609f6c13df9360", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12dcc4cf/uploads/origins/7cd348e3-bf03-4434-9f74-6ab06e5e1cee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1576b390c0a92513f313b242f6bfb19", "src_set": ""}, "body": "こんばんはー！\n個人配信者として活動している右近あすかと申します。\nいつもお世話になっております！\n\n今回も、活動で使用するイラストを依頼したくリクエストさせていただきました。\n描いて頂くたびに、毎回驚くくらい可愛く描いてくださってとっても嬉しいです！\n\n【依頼内容】\n右近あすかのゲームをしている様子のイラスト\n\n今回のポーズは、両手でコントローラーを持ってゲームをプレイしてる様子のイラストをお願いいたします！\n毎回申し訳ないですが、耳の中の毛はこちらのイラストのように\n（https://skeb.jp/@aka_fuji_/works/494）\nいままでよりちょっと長さを抑えていただけると嬉しいです！　いつもすいません（汗\n\nまた、ちょっとしたこだわりなのですが、コントローラーのデザインはPS2コントローラーで描いて頂けると嬉しいです。　実写ですが画像を用意してありますのでよろしくお願いいたします。\n有線コードがあるのが特徴ですが、あかふじさんの可愛らしいイラストの妨げになるようでしたら、コードを省略していただいても大丈夫です！\nps2コンはそこまで書き込まなくても大丈夫です\n\n他の方のイラストですがこちらの構図\n(https://skeb.jp/@enon_kt/works/85)\n(https://skeb.jp/@sana79261827/works/295)をイメージしておりますが、あかふじさんがこのほうが可愛らしいポーズだなとおもったら自由にしていただいて構いません！\n\nまた、表情差分（真面目に集中してる顔、半泣きなどで悲しんでる顔、笑顔)を描いて頂きたいです\n\n\n今回も部屋着を描いて頂きたいです\n正面、横、後ろ姿、三面図を撮影しましたので、衣装の参考になれば幸いです\nPSDデーターを頂けると嬉しいです\n\n【使用用途】\nゲーム内でのプロフィール画像\nSNSでの掲載/アイコン/ヘッダー/グッズ\n配信・動画内での使用/サムネイル\n\n【備考】\n\n下記リンク(googleドライブ)を参考にしてください。\nご検討いただければ幸いです。\nよろしくお願いいたします。\n\n(googleドライブ)\n\nhttps://drive.google.com/drive/folders/1zIaJVXItvglivWteKbklAek74waIN1LU?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aka_fuji_/works/548", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9642bfc5/uploads/origins/a5b1a0ca-9d7e-4ff2-b47e-3ed04a5920fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a10adee02546c6851beaff5040c1f70", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2616061, "client_id": 3143072, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@aka_fuji_/works/547", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2616061, "client_id": 2442996, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de9790fb/uploads/origins/4bbe79b4-e126-4101-b714-ac06e69b169c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199c628a981753aa6933a4926d0ae60b", "src_set": ""}, "duration": null,