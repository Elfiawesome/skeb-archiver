imgix.net/6739b227/uploads/origins/7ac9749b-9ae5-4271-a5e1-b4d3b6cb51fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=657287bafdbb34a2182c732f0acab120, https://si.imgix.net/6739b227/uploads/origins/7ac9749b-9ae5-4271-a5e1-b4d3b6cb51fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=165582db63e241f6e1afca403e8ce937 2x, https://si.imgix.net/6739b227/uploads/origins/7ac9749b-9ae5-4271-a5e1-b4d3b6cb51fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a08a68102053fe17b31f841d9873eff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6739b227/uploads/origins/7ac9749b-9ae5-4271-a5e1-b4d3b6cb51fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec35c5386f2854726dc8a917402b7155", "srcset": "https://si.imgix.net/6739b227/uploads/origins/7ac9749b-9ae5-4271-a5e1-b4d3b6cb51fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec35c5386f2854726dc8a917402b7155, https://si.imgix.net/6739b227/uploads/origins/7ac9749b-9ae5-4271-a5e1-b4d3b6cb51fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db1074c52d072ad29ff5a3aa2268e096 2x, https://si.imgix.net/6739b227/uploads/origins/7ac9749b-9ae5-4271-a5e1-b4d3b6cb51fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=839e52ad721cc059e79df8c338d22b45 3x"}, "body": "えんじさん、いつもお世話になっております！\nこの度、1枚絵の依頼をお願いしたくまいりました、トン･とろ美でございます。\n\n11月をもって、えんじさん卓にて｢偶造神還｣全編の通過が終了しまして、圧倒的な達成感と満足感と喜びと僅かなやるせなさと、その他諸々…… 沢山の思い出と感情を経ることが出来ました。本当に頭が上がりません、ありがとうございます。\n\n今回、｢偶造神還｣に参加した私の探索者達である｢もへじ｣｢白兎はねる｣｢神楽夜月雫｣3名通過おめでとうありがとうの記念のイラストがあったらいいな…… と思っていたので、可能であれば3名がドレスコードをした上で揃って並んでいる1枚絵を依頼させて頂きたいと思っております。\n\n最低限指定をしたい服装や色味は参考資料URL内部で指定させて頂きました。（不足あれば申し訳ありません……）書かれている以外の指定や構図、場所などの指定はございません。\n私はえんじさんのイラストにおいて、線画のタッチも勿論好きですが、色味･色遣いが特別好きなので、色に関しては特に全面的にお任せしたく思っております。\n\n依頼するのが初めてなので、文章が拙くなっている部分があるかもしれません。また、資料内容が不十分でしたら申し訳ないです。\nもし宜しければ、どうぞよろしくお願い致します……！\n\nhttps://drive.google.com/drive/folders/1-2PliCJVKsdsdst9fKwnXUITikJs-PIl", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2086880, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "棚", "screen_name": "tanasan_7", "avatar_url": "https://pbs.twimg.com/profile_images/2029582464432361473/QC2YLXXN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1002821086449360896/1721535851/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2485651, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ふじた鳩🌷本当に多忙", "screen_name": "Lv103000", "avatar_url": "https://pbs.twimg.com/profile_images/1592241489668878336/UI-L4aKb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1358456027574771718/1736968263/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 3334943, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ポコ", "screen_name": "8s4_q", "avatar_url": "https://pbs.twimg.com/profile_images/1737048434836910080/3G7WWZwI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1721565152695427072/1781022936/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"