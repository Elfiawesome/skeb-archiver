fea4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=367917e75a4de6b8a3029a5d1bf779f8", "srcset": "https://si.imgix.net/e6751af3/uploads/origins/fbc15d20-7369-4d07-ab43-da079bfea4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=367917e75a4de6b8a3029a5d1bf779f8, https://si.imgix.net/e6751af3/uploads/origins/fbc15d20-7369-4d07-ab43-da079bfea4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93094e6df4247cd9fe6bf5c5120a0b7a 2x, https://si.imgix.net/e6751af3/uploads/origins/fbc15d20-7369-4d07-ab43-da079bfea4aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=84150adba46b675f966116b9cc1efbc4 3x"}, "body": "はじめまして！\nミッドナイトガールズのシャインちゃんが大好きで、また見たいという気持ちを込めて、今回リクエストを送らせて頂きました。\n\nシチュエーション\n欲張りセットで大人のシャインちゃん、普通のシャインちゃんと主人公くん3人で擬牝台射精量比べをして、3人とも射精してる瞬間を描いて頂きたいです。\n擬牝台の参考画像はこちら　https://pbs.twimg.com/media/Gr2gWv4XwAEkzn_?format=jpg&name=4096x4096\n※擬牝台自体のデザインはお任せします。\n\n擬牝台はコンドーム付きで中身が見れるように半透明して、二人のシャインちゃんは各自のコンドームを丸く膨らむほどの大量射精をして頂いたらありがたいです。\nもしよろしければ、コンドームなしの差分もお願いしてもよろしいのでしょうか。\n\n表情や服装はお任せしますが、やや乱れた感じでお願いします。\nイラストのご検討よろしくお願い致します。\n\nhttps://pbs.twimg.com/media/Gr2gWv4XwAEkzn_?format=jpg&name=4096x4096", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@negitoro_0115/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1792302, "client_id": 466424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/588974d4/uploads/origins/686ab65a-c5c1-4293-857e-6845fd02301a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c0a6b2c4e0d56f95e7f68fee799187", "srcset": "https://si.imgix.net/588974d4/uploads/origins/686ab65a-c5c1-4293-857e-6845fd02301a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c0a6b2c4e0d56f95e7f68fee799187, https://si.imgix.net/588974d4/up