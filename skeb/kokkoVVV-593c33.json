rの羽恋ルルカさんです。\nイラストは本人にもお渡ししようと思っております。\nお手数ですがファイルはpsd形式で、\n背景と文字があれば、それぞれを透過されているレイヤーも合わせて納品頂けますと嬉しいです。\n\n■構図\n楽しそうにゲームをしている姿を描いて頂きたいなと考えております。\nゲーム機のコントローラーを持って遊んでいる姿、服装はそのままで、背景などはお任せ致します。\n\n■使用用途\nSNSへの投稿,アイコン,ヘッダーでの使用\nYouTubeチャンネルにてサムネイルでの使用\nYouTubeチャンネル内の配信画面での使用\nになります。\n\nお忙しいところ恐縮ですが、何卒ご検討のほどよろしくお願い致します。\n\nhttps://twitter.com/HanekoiLuluca/status/1509421156700332033?t=eaFw_QBmcqJReiB1GwaXWQ&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kokkoVVV/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2277588, "client_id": 1739459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d009efda/uploads/origins/51175084-3f05-4891-9036-d66ab907fcef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4234939d1eafb6649f278bc8d88494f1", "srcset": "https://si.imgix.net/d009efda/uploads/origins/51175084-3f05-4891-9036-d66ab907fcef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4234939d1eafb6649f278bc8d88494f1, https://si.imgix.net/d009efda/uploads/origins/51175084-3f05-4891-9036-d66ab907fcef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac5a69c242059fdbe316fe91f5ebe590 2x, https://si.imgix.net/d009efda/uploads/origins/51175084-3f05-4891-9036-d66ab907fcef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=455de44ccaa8f4a28e093e56297b36b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d009efda/uploads/origins/51175084-3f05-4891-9036-d66ab907fcef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4f2747d40df76aaafa3241bc7148199", "srcset": "https://si.imgix.net/d009efda/uploads/origins/51175084-3f05-4891-9036-d66ab907fcef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4f2747d40df76a