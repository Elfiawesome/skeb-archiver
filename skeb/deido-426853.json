3回目のパイズリと一緒に射精差もお願いしたいです。これらはすべて同じセッションの一部で、ザーメンまみれの胸でパイズリを与えるものです。\n\n可能であれば、男が激しく震えるような演出をお願いします。そして、3回目のパイズリでは顔にザーメンをかけてもらってください。\n\nその他はお任せします。\n\nご検討のほど、よろしくお願いいたします\n\n参考までに。\n\nhttps://drive.google.com/drive/folders/1KEExqcFInqEVvPK8pEIaWDVESQh8MwUd", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@deido/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1113420, "client_id": 670557, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d67cd15/uploads/origins/446e6127-5bdf-4fca-aab7-0208574fa3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2f86e3ee33d3a53397269396fd5c0f", "srcset": "https://si.imgix.net/4d67cd15/uploads/origins/446e6127-5bdf-4fca-aab7-0208574fa3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d2f86e3ee33d3a53397269396fd5c0f, https://si.imgix.net/4d67cd15/uploads/origins/446e6127-5bdf-4fca-aab7-0208574fa3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c11a22edfc39f341ec339d8e10f98f5 2x, https://si.imgix.net/4d67cd15/uploads/origins/446e6127-5bdf-4fca-aab7-0208574fa3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4320ec447ce9ab6ce13b14f8e62fbab7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d67cd15/uploads/origins/446e6127-5bdf-4fca-aab7-0208574fa3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e244b9ac455d0d0ddbe68bc81e3941c5", "srcset": "https://si.imgix.net/4d67cd15/uploads/origins/446e6127-5bdf-4fca-aab7-0208574fa3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e244b9ac455d0d0ddbe68bc81e3941c5, https://si.imgix.net/4d67cd15/uploads/origins/446e6127-5bdf-4fca-aab7-0208574fa3ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t