を築いていたはずだった。\n███\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-6zSth9AOGaelJVzorDoClpN4jkidhdW", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 893953, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぷかぁく👾", "screen_name": "game_pklk", "avatar_url": "https://pbs.twimg.com/profile_images/1923158259265044481/MJcyqmgA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/889594256322568192/1723537887/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 1201054, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ぽとわり", "screen_name": "popotowari", "avatar_url": "https://pbs.twimg.com/profile_images/1498235865298259970/cbbi8CTc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1392141413047930880/1640850409/1500x500", "appeal_receivable": false, "popular_creator_rank": 94, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 7, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 2835479, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蒼川(あおかわ)", "screen_name": "aoao_river", "avatar_url": "https://pbs.twimg.com/profile_images/1673586308478824449/kWkbhHdY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1282328354973085696/1703664188/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_