8-41f4-b213-d97fdba92e60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d4d6578bac9b972e0e165c79f61e9d59 3x"}, "body": "こんにちは、ホロライブ・エンのアメリア・ワトソンさんにパイズリをお願いしたいのですが。\n\n参考：https://imgur.com/a/Ie5TsyV\n\n- アメリアには、参考画像の宇宙服を着て、後の2つの画像と同じような方法でファスナーを開けてほしいです（片方を下にして、もう片方を上にしたまま）。\n- アメリアの黒いアンダーシャツも脱いでほしい。\n- 男は座っていて、3/4の角度で描いてほしい。\n- アメリアはドヤ顔でペニスを見下ろしてほしい。\n- アメリアが微笑みながら目を閉じているイクショットのバリエーションも欲しい。\n\nhttps://imgur.com/a/Ie5TsyV", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rururaroru2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1804448, "client_id": 124783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ed1cd48468d5257868a4657f5faa351", "srcset": "https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ed1cd48468d5257868a4657f5faa351, https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea22579d11c2182af6dc748549669064 2x, https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4373652677ac2a30e03cb36fa8e297f6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b11001361d95ca8b6b4f5b492d965c5", "srcset": "https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b11001361d95ca8b6b4f5b492d965c5, https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a921888502a2414e35640ebb530030c9 2x, https://si.imgix.net/aca64128/uploads/origins/43160eac-85b3-44f1-995c-740241ce6568?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=658f204152be4081ddec8e3b763b56d2 3x"}, "body": "〇口ライ〇の〇咲シオ〇ちゃんをお願いします\n\n服装は全裸、髪型は\nhttps://twitter.com/Tam_U/status/1327959896604590080\nこちらのゴスロリ衣装の髪型でお願いします\nまた、個人的な癖の関係で、尻尾も無しでお願いします\n\n体位は後背位、\nhttps://skeb.jp/@244__/works/91\nのような挿入しやすいようにお尻を持ち上げた姿勢でバックから挿入されてたっぷり膣内射精されてる様子を、\n子宮口にぴったりと密着させたペニスから子宮内に直接大量射精されてる断面図付きでお願いします\n\n竿役はブクブクに肥え太った全裸のメタボ体型で、首から上の描写は省いて貰って構いません\nhttps://skeb.jp/@mageDaikon8964/works/4\nの竿役のように〇オンちゃんのお尻を両手で掴みながら上体を反らし、腰を突き出してペニスを根元まで挿入、シオ〇ちゃんの一番奥で気持ちよく射精しています\n\n個人的に〇オンちゃんはわからせるよりもわからせられたいので、\n余裕たっぷりな〇オンちゃんに煽られながら優しく気持ちよ～く膣内射精させて貰ってるイメージで、\n攻められすぎたり、気持ちよすぎてアヘ顔になる等、〇オンちゃんが余裕を無くすような描写は極力避けて、\n子宮内に注がれる大量の精液を笑顔で受け止めて欲しいです", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rururaroru2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1804448, "client_id": 442538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d9899d2/uploads/origins/002ce522-fe88-457d-9311-26991c5a4b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8eed3ae4ca786c05e44af423a5d8928", "srcset": "https://si.imgix.net/9d9899d2/uploads/origins/002ce522-fe88-457d-9311-26991c5a4b47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8eed3ae4ca786c05e44af423a5d8928, https://si.imgix.net/9d9899d2/uploads/origins/002ce522-fe88-457d-9311-26991c5a4b47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7ca363d201c10074007324288a51657 