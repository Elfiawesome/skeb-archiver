t=crop&crop=top&w=200&h=200&blur=200&s=888ead3def1e03b4d853033dbff1aee9 3x"}, "body": "はじめまして。\n水彩画のような繊細かつ柔らかな塗りと表情の優しさや素敵さに惹かれ、もし宜しければ是非ともお願いしたい…とリクエストをさせていただいた次第です。\n\nゲームの自キャラになりますが、口数も表情が少ない感じの落ち着いた三十路の男性です。\n戦場を数多に潜り抜けてきた古強者…だけども日頃は茶を飲んだり、読書をしたりが趣味のインドア派という創作設定にしています。\n\n宜しければご検討いただけましたら幸いです。\n\nhttps://twitter.com/domitaorurosan/status/1762101130140782930?t=vuunL9eulLhBcPmNcmLV4A&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@debondebon_0101/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 866178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae4df14cc2a5a4a29f64cf756468526c", "srcset": "https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae4df14cc2a5a4a29f64cf756468526c, https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66f9fdb9b621dfcfad99a998753745f7 2x, https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fadedf403676396485695415e74bd6f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03915e2162ca730d89d19f47b1c589a6", "srcset": "https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03915e2162ca730d89d19f47b1c589a6, https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ebb86fbfc14c4e5f2bf7ceef2458bc5 2x, https://si.imgix.net/b4bc480f/uploads/origins/72464d58-1c1a-4648-8712-13bedd8255d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=999bc09fc7a07e69cd8ab8379da86840 3x"}, "body": "こんにちは！先日マシュマロを送らせていただいたものです！\n\n自分のSNSのアイコン用にマーモットかゴールデンレトリバー(色がつくなら白とかクリームの子がよいです)のゆる～いイラストを描いて頂きたいです。ハッキリとした色が好きなので蛍光イエローや何かしらの原色が背景色だと嬉しいです。\n\nあのまろすてがさんの普通の等身やデフォルメのイラストも大好きなのですが、日記などに登場している古代生物の表情豊かさが好きなのと、己のアイコンが普通の等身だとドキドキしてしまうのでこのような形のリクエストとなってしまいました。どうかお許しください…。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@debondebon_0101/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 866178, "client_id": 2556769, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/788f6692/uploads/origins/705fef86-8acf-45c5-8974-a77d29022a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d2695c7bc2326e1e378715450691334", "srcset": "https://si.imgix.net/788f6692/uploads/origins/705fef86-8acf-45c5-8974-a77d29022a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d2695c7bc2326e1e378715450691334, https://si.imgix.net/788f6692/uploads/origins/705fef86-8acf-45c5-8974-a77d29022a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1458f7c9866b33820307b48ad8f8e1c 2x, https://si.imgix.net/788f6692/uploads/origins/705fef86-8acf-45c5-8974-a77d29022a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=911032c0e7f944a6d413d908604afec4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/788f6692/uploads/origins/705fef86-8acf-45c5-8974-a77d29022a9a?bg=%23fff&auto=format%2Ccompress&fm=