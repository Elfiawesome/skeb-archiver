ebp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ced41b808b614d1a33ea2da7f31d5c8 2x, https://si.imgix.net/bbb3adc0/uploads/origins/1fdb209c-221f-43bf-85b5-6c707a171e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a34157556aae4f0eaa8caf07e1d54266 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbb3adc0/uploads/origins/1fdb209c-221f-43bf-85b5-6c707a171e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33475d0f431399c4e80180500dccc896", "srcset": "https://si.imgix.net/bbb3adc0/uploads/origins/1fdb209c-221f-43bf-85b5-6c707a171e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33475d0f431399c4e80180500dccc896, https://si.imgix.net/bbb3adc0/uploads/origins/1fdb209c-221f-43bf-85b5-6c707a171e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ef07936fc051a45c838f32d6adfb02d 2x, https://si.imgix.net/bbb3adc0/uploads/origins/1fdb209c-221f-43bf-85b5-6c707a171e4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c9c902ff248fea352616bfac4184aa1 3x"}, "body": "はじめまして！\n\n私のオリジナルキャラクターを描いていただけませんか？現代CoCのTRPG設定です。\n名前はアロイス。侵略してくるエイリアンと戦う秘密組織の一員です。\nとてもエネルギッシュで、いたずら好きで、おちゃめな性格。\n趣味はロック、お菓子作り、スケッチ。\nスナイパーでもある。\n普段の表情はいたずらっぽい大きな笑み。\n体型は痩せ型。\n\n彼がエイリアンの怪物と戦っている、クールでエキサイティングなアクションポーズを描いていただけませんか？\n\nポーズや構図はお任せします！\n\nいずれにせよ、リクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1YQ4Iw4idpFiQBivhMkWU8m5lAriDDkQD?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayare_mon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 769527, "client_id": 1147436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42036569/uploads/origins/a2d3fca2-7f9a-41c3-9cfa-f98fd66041c8?bg=%23fff&auto=fo