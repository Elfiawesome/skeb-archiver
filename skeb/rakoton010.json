: false, "total_appeals_count": 0, "received_works": [{"path": "/@rakoton010/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 127943, "client_id": 1747927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e17b236/uploads/origins/f108f20d-1f33-4677-bb45-631ac37464f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f3a8391513d9419c4eefce97ac78f8b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e17b236/uploads/origins/f108f20d-1f33-4677-bb45-631ac37464f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd73471228e4234918483b93f3df95ba", "src_set": ""}, "body": "始めまして！母にエッチな事されながら出産する娘をお願いします！\n主なシチュエーション\n・「もうすぐ産まれるのね♡」とお腹に耳を当てる母。\n・出産の準備に入り、娘のアソコを舐める母。\n・絶頂と共に破水し母乳を垂らしながら息む娘。\n・赤ちゃんの頭が出てきて、赤ちゃんにキスをする母。\n・赤ちゃんを母の手のひらに産み落とす。\n・産後、赤ちゃんに母乳を飲ますが母も娘の母乳を飲み始める。\n・親子の容姿や細かい台詞はお任せします。\n\n\n以上でご検討よろしくお願いします！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rakoton010/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 127943, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eef65265/uploads/origins/e1b8f8ac-0319-4085-9533-a6410c61ba48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f20f651e222a32aa2b785abf224cd10e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eef65265/uploads/origins/e1b8f8ac-0319-4085-9533-a6410c61ba48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff9df52c3e1e65c81b4431e6700af23b", "src_set": ""}, "body": "ラッコくん飛んドルさん、お久しぶりです！\n以前に「ルーシーとジェーン」のリクエストを送った者です！\nまたリクエストを送りたいです！\n\n今回はラッコくん飛んドルさんのオリジナルキャラである「ぴだかろりゅー」をリクエストしたいです！\n\n内容は…ぴだかろりゅーちゃんの心臓を聴きながらエッチをするシチュを見たいです！\n\n構図…\n・ぴだかろりゅーちゃんはショタとエッチする構図、基本的にろりゅーちゃん一人が映る主観視点、構図によっては二人映る第三者視点\n・最初から二人とも全裸状態で臭いがわかる程に汗だく、更に興奮状態\n\nシチュ…\n・ショタがふとろりゅーちゃんのおっぱいに目が行くと、ろりゅーちゃんが興奮で心臓がバクバク、その鼓動でおっぱいがピクピクと動いているのを見続ける\n・ろりゅーちゃんがその視線に気づき、ろりゅーちゃんが興奮していたのもあり「聴いてみたい？」と誘惑\nショタはろりゅーちゃんの心臓を耳で直に聴いたり、顔を埋めてろりゅーちゃんのおっぱいと心臓の鼓動を感じる\n・正常位でエッチし、ろりゅーちゃんの心臓を耳で直聴きしながら射精\n\nその他…\n・自分は心臓フェチなので最初から最後までろりゅーちゃんの心臓が映ってほしいです！(心臓はリアル調、心音の擬音たくさん)\n・臭いや挿入などの擬音あり\n・ろりゅーちゃんの心臓の鼓動で揺れるおっぱい、ろりゅーちゃんが気づくところ、ろりゅーちゃんの心臓を耳、手、顔や聴診器などで感じる、ディープキスと臭いを嗅ぐシーンは主観視点、それ以外は第三者視点\n・前回のレントゲン風の青い心臓ではなく、赤色のリアル心臓を描いてほしいです！\n\n今回もたくさんの要望と細かなリクエストですが、ご検討のほどをお願いします！", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rakoton010/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 127943, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22875b9a/uploads/origins/84af3ebf-4ba4-4afd-bfa1-5ef995b530a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f63a1bce4b64eca43a001aec23ea221", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22875b9a/uploads/origins/84af3ebf-4ba4-4afd-bfa1-5ef995b530a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=635613ebf17a3cfef162ee346c76fc5b", "src_set": ""}, "body": "はじめまして！\npixivなどで楽しみにイラストを見させてもらっています！\n以前に投稿されていた「ルーシーとジェーン」というおねロリのイラストが特に好きで、リクエストしたいと感じました！\n\nシチュエーションとしましては、「全身ファ○ク」を終えた後のプレイとして「産まれた子の健康チェック」という建前でルーシーがジェーンの身体を弄りながら興奮の感情をより感じるために心臓の音を耳で聴き合ったりエッチしたりするというのが見たいです！\n\n詳細は・・・ルーシーに全身ファ○クされて、その後に出てきたばかりのジェーンにこんなことをしたいとルーシーが耳元でささやいて、ルーシーも興奮状態なのでそれを承諾する\nその後、レズセックスをしてお互いに絶頂する\n\n・全身ファ○ク後なので二人とも全裸\n・ルーシーがジェーンの股間や胸を弄りながら、興奮している心音を聴く\n・ジェーンはなすがままに快楽を感じる、ルーシーの胎内から出てきた直後なのでより身体が汚れている\n・お互いの気分が乗ってきてそのまま事に移る、ディープキスや貝合わせ、お互いの股間・乳首いじりやハグ、時折身体の臭いを嗅ぎ合ったり色んな体の部位を舐め合うなど\n・その間にも心音を聴く、今度はジェーンもルーシーの心音を聴く\n・二人ともお互いのよだれや汗や愛液などでどちらも体全身を濡らし合う\n・最後にセックスして絶頂して二人で強く抱きしめ合ってお互いの心臓の鼓動を感じ合う\n・差分としてお互いの興奮した感情がより分かりやすく映っているシーンとして二人の心臓の透過と心臓の音や身体を弄ったり体液が擦れる擬音ありのカット(心臓はリアル調・擬音多め・特に心音)\n-セリフについては、ルーシーはジェーンに母性を持って甘えるかのような言い方、ジェーンは建前だと気づいても受け入れるようにジェーンも甘える、内容の詳細はおまかせでお願いします\n\n\nリクエスト内容は以上になります！\nどうかご検討の程よろしくお願いいたします！", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 43569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りよ☕️", "screen_name": "Liyocafe", "avatar_url": "https://pbs.twimg.com/profile_images/1910203683641647105/rB76lrWj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/969535290636361728/1658187302/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 43688, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "cocco", "screen_name": "cocco1192", "avatar_url": "https://pbs.twimg.com/profile_images/1756902534944530433/kFbcnU2n.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1465841705912274945/1655047267/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 491430, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "MIY", "screen_name": "MIY58114460", "avatar_url": "https://misskey.io/identicon/miy58114460@misskey.io", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 160}, {"id": 1229034, "creator": true, "nsfw_acceptable": tru