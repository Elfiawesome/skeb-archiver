12-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87132d4159d6081637a4b47e725f0bcb", "srcset": "https://si.imgix.net/95c07279/uploads/origins/18f8b312-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87132d4159d6081637a4b47e725f0bcb, https://si.imgix.net/95c07279/uploads/origins/18f8b312-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6df48292fbcc3d2c24963c678f1a4bcc 2x, https://si.imgix.net/95c07279/uploads/origins/18f8b312-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b49f702dfea3e85bb1281a901615a5b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95c07279/uploads/origins/18f8b312-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8a38313968eff2946388f3aa7842c3a", "srcset": "https://si.imgix.net/95c07279/uploads/origins/18f8b312-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8a38313968eff2946388f3aa7842c3a, https://si.imgix.net/95c07279/uploads/origins/18f8b312-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebfa3da921ec11c87e7d72854d90528a 2x, https://si.imgix.net/95c07279/uploads/origins/18f8b312-8e28-4bd4-bce9-445f4df8e3de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80ce0e601891d5f458fc7c7e50ec2536 3x"}, "body": "はじめまして、ひとでろう先生。\nⅩを拝見し、ごろんしているいろは様やちまっとしたいろは様等、\n全部かわいい！と絵柄に惚れてしまい、ファンアートをお願いしたくリクエストさせて頂いています。\n\n●使用用途：\n　・ご卒業済みなのですが、『愛猫ヤマト』さん『愛猫ひより』さんの兄妹Vtuberさんをお願いしたいです。\n　・PC壁紙として大切に長く使用させて頂きたいと考えております。お２人にも、DMを通してお贈りできればと。。\n\n●リクエスト内容：\n　・PC壁紙に使用出来る比率でお願い出来ますと幸いです。（16:9という比率でしょうか）\n　・ひとでろう先生がお描きになられたいろは様のように、お２人でお昼寝のようにのんびりコロコロしている図が見