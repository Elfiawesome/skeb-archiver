-4621-aef8-30070b9779c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c973a7bd264f8e82852c4d354293937b 2x, https://si.imgix.net/b85f75a0/uploads/origins/94dc5f2f-7952-4621-aef8-30070b9779c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db1a645230c894be71f7ea0813497589 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b85f75a0/uploads/origins/94dc5f2f-7952-4621-aef8-30070b9779c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4678f071e06b08a512f788f2976509a5", "srcset": "https://si.imgix.net/b85f75a0/uploads/origins/94dc5f2f-7952-4621-aef8-30070b9779c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4678f071e06b08a512f788f2976509a5, https://si.imgix.net/b85f75a0/uploads/origins/94dc5f2f-7952-4621-aef8-30070b9779c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7598ebf766f14d501c81562745513cf 2x, https://si.imgix.net/b85f75a0/uploads/origins/94dc5f2f-7952-4621-aef8-30070b9779c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5edc1e9b0eae9206c21351202eb12fef 3x"}, "body": "ゆりはす様。\nはじめまして！\n\nTwitterで見かけましたセッカちゃんがとても可愛かったので、今回リクエストしたいと思いました！\n\nリクエストしたいキャラは、地雷系悪魔娘になります。\n\n<範囲>\n金額に応じておまかせでお願い致します。\n\n<服装>\n黒をメインにした地雷系の服をお願い致します。\n\n<髪型>\n髪型はストレートロングの要素とツーサイドアップの要素を組み合わせた感じでお願い致します。\n(結んでいる2つの髪の長さは耳くらいまでの短めで、おろしている髪はストレートの長めになります。)\nまた、髪で片目隠れている感じでお願い致します(参考画像あり)。\n髪色は黒色でお願い致します。 \n\n<雰囲気・表情>\n表情は舌を出していたずらな表情且つ、少し笑っている感じでお願い致します。\n雰囲気は少し知的ないたずらっ子な感じでお願い致します。\n目の色はお任せでお願い致します。\n\n<その他>\n悪魔の翼と尻尾・小さい角をお願い致します。\n(「近い依頼/リクエスト」のフォルダで似たような作品があるのでそちらを参考にお願い致します。)\n\n以上となります。\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1nZnsX7rF7H6rmAJLMxM8BcnrnjIy6XCB", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yurihasu_work/works/1", "p