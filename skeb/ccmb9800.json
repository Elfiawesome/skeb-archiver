rl": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ff4e678/uploads/origins/4c8a6a9e-7731-4408-bd69-4a9311e76cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2ed3bc600887bbd507bc5776a16c1e2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ff4e678/uploads/origins/4c8a6a9e-7731-4408-bd69-4a9311e76cca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7637ee7849c141b750ac59955c7108a1", "src_set": ""}, "body": "以前はありがとうございます\n再びリクエストさせていただきます\n\n東方LostWordの白こいし(白貌の無為)のイラストをお願いします\n詳細は以下の通りです\n\n・朝起きて鏡を見ると白こいしになっていた。鏡に白こいしが映っている(鏡に映っている為、左右反転でお願いします)。白こいしになった人視点でお願いします\n・大きく驚いている\n・セリフ差分(セリフは「こいしになってる！？」「何で普通のこいしじゃなくて白こいしなんだろう…？」)あり、服は白こいしの服(帽子もあり)でお願いします\n・背景は水中のような感じ(語彙力)でお願いします\n参考\nhttps://www.pixiv.net/artworks/126632998\nhttps://www.pixiv.net/artworks/107828442\nhttps://pbs.twimg.com/media/FlNHt6CakAEtZoD.jpg\n\nまた、アイコン用に単に白こいしが驚いているという差分もお願いします。\nこちらは鏡に映っているものではない為、左右反転は不要です。\nサイズもアイコン用の正方形で、背景は同じでお願いします\n\nよろしくお願いします\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS4UsOdMalZqSpv3VEKC0e2Ut3Tus0g44F4mcnysJKCAA9Ax6PL-Y_-Kbs&s=10", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ccmb9800/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 428878, "client_id": 2681256, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d40dea8c/uploads/origins/6484c443-9399-476b-bd3b-88f687745516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d6832d651ef601fd68f7a344e5e1ea2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d40dea8c/uploads/origins/6484c443-9399-476b-bd3b-88f687745516?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1e2136aff00b7