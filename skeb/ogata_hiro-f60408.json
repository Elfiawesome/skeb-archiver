age", "creator_acceptable_same_genre": true}, {"path": "/@ogata_hiro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2727418, "client_id": 1779, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7349e0bef487f5a8f0770a348bb6f31", "srcset": "https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7349e0bef487f5a8f0770a348bb6f31, https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf7f8afc68b8a188683ced160d84d6dd 2x, https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88d0d49f391f962324faf450bd62295f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b0e63d070b7ca592ca5da667ed91c42", "srcset": "https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b0e63d070b7ca592ca5da667ed91c42, https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=023927fc501d65b73786fd4dd9a1ec70 2x, https://si.imgix.net/ffafb940/uploads/origins/744d1e2d-f7fa-4edb-8b7e-46f39a9ba8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18ae524752c964374f9a0581fefb9a9b 3x"}, "body": "かなり以前に描かれた作品で恐縮なのですが、厄物中毒が好きだったので、鍵山雛とアリスお願いいたします。\n\n厄物中毒の冒頭で雛がアリスの頬を舐めて誘惑するシーン(資料URL2コマ目)が色っぽくて好きなのですが、それの延長のようなイメージで以下のものを真横から描いた構図でお願いします。\n\n相手に正面から抱きついてアリスの頬や唇を舐めたり吸い付いたりしながら、自分の胸や腰を擦り付けてキスやセックスをしようと誘惑する雛。\n\nパチュリーと付き合っている手前、積極的に雛に手を出すのにもためらっているものの、拒むこともせずに遠慮がちに雛の腰に手を回そうとして触れるか触れないかくらいの位置で手を振るわせつつちんちんは勃起しているアリス。\nアリスは顔の随所にキスマークが付いているとありがたいです。\n\n雛はアリスのパチュリーへの愚痴を聞いている間にすっかりアリスに惚れ込んでしまうも、厄物中毒本編とは違いなかなかアリスが手を出さないので、必死に媚を売って誘惑しているようなイメージです。\n厄物中毒で、アリスが当たり前の顔して変態プレイを要求するってパチュリーが怒っていましたが、それに対して当てこするような感じで、何でもしてあげるからみたいな事を奉仕精神やMっ気を全開にして囁きながら誘惑している感じですとなお嬉しく思います。\n雛は相手への好き好きオーラをかなり強めに発している感じでお願いします。\nまた、雛の胸の大きさが強調されているとありがたいです。大きい分には厄物中毒中の描写に限らずどれだけ大きくとも構いません。\n\n雛の相手役に関してはアリスに限らず他のちんちんの生えた東方のキャラクター、もしくはモブ的な男性などでも結構です。\nその場合も恋人等がいて、雛と一線を越えるのに抵抗を感じつつも誘惑に抗いきれないみたいなイメージでお願いします。\nまた、相手がモブ的な人の場合は詳細に描き込んでいただく必要はございません。\n\n上記に限らず御形さんのイメージや思いつき、描きやすさを優先して頂ければと思います。\nskebへの登録を始め、また色々新たにご活動を始めていただいているようで、ファンとして大変嬉しく思います。\nご活動を続けるに当たって何かとご苦労もあるかと存じますが、お体お気をつけて、ご自身のペースで末永くご活動いただければ嬉しく思います。\n\nhttps://www.pixiv.net/artworks/39026685#big_1", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ogata_hiro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2727418, "client_id": 32106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc4b1c70/uploads/origins/f0078273-6867-472d-aad2-630fe69b06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64096258b4ab22b105a30b524552a11f", "srcset": "https://si.imgix.net/fc4b1c70/uploads/origins/f0078273-6867-472d-aad2-630fe69b06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64096258b4ab22b105a30b524552a11f, https://si.imgix.net/fc4b1c70/uploads/origins/f0078273-6867-472d-aad2-630fe69b06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d99aa9ac51001cc03e4463be527baf25 2x, https://si.imgix.net/fc4b1c70/uploads/origins/f0078273-6867-472d-aad2-630fe69b06c1