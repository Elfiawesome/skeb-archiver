・胸は小さめでお願いします。体形はいつも書かれているくらいをイメージしています。\n・状況としては、鏡の前に妖夢が立っていて、ポーズは胸が小さいことを気にして、手で寄せているところをイメージしています。\n・表情は赤面していた方がよいですが、細かいイメージを伝えるのが難しいため、おまかせします。\n・全裸差分もお願いします。できれば服ごとの差分もお願いしたいです。\n・背景は白玉楼（和室）のつもりではありますが、おまかせします。\n\nイメージと似た構図のイラストを資料URLに記載します。\n\nよろしくお願いします。\n\nhttps://www.pixiv.net/artworks/97516388", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kou114z/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1322123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/081db7dc/uploads/origins/ffd64225-a3b9-43f2-afef-41efa7107903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8368c69fe008b19ec749b51762f6e25b", "srcset": "https://si.imgix.net/081db7dc/uploads/origins/ffd64225-a3b9-43f2-afef-41efa7107903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8368c69fe008b19ec749b51762f6e25b, https://si.imgix.net/081db7dc/uploads/origins/ffd64225-a3b9-43f2-afef-41efa7107903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5cfbc2a7e36a0d2c8fc3884dc628f6e 2x, https://si.imgix.net/081db7dc/uploads/origins/ffd64225-a3b9-43f2-afef-41efa7107903?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0949e2762535a3954e5e76600f1eb9e1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/081db7dc/uploads/origins/ffd64225-a3b9-43f2-afef-41efa7107903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef9269c4600c129c766f2679e1f92d6", "srcset": "https://si.imgix.net/081db7dc/uploads/origins/ffd64225-a3b9-43f2-afef-41efa7107903?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef9269c4600c129c766f2679e1f92d6, https://si.imgix.net/081db7dc/uploads/origins/ffd64225-a3b9-43f2-afef-41efa7107903?bg=%23fff&auto=format%2Ccompre