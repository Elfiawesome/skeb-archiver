rue, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@osakana_dash/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2274394, "client_id": 2401425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cae6ab994bcad61470f97b3e8c7ddc0", "srcset": "https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cae6ab994bcad61470f97b3e8c7ddc0, https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed3be66548e6638f56456725ba47dd5a 2x, https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fb763a4d0360728258d907d2cbcba5e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56005d98d56767f3090921cb41b3b461", "srcset": "https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56005d98d56767f3090921cb41b3b461, https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91e0c1f8124b3fa80dec475c7d4fbce2 2x, https://si.imgix.net/312dc0dd/uploads/origins/524fca56-917d-4d03-a570-c26433cd216c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86bb214cfff773c3ba414e68d71fd9ce 3x"}, "body": "お魚屋さん初めまして！\nお魚屋さんのハイセンスな絵柄や色の使い方、服の描き方（ウェディングフォトコンセプトめちゃくちゃおしゃれで大好きです）、人物構図などなど…どれも本当にお魚屋さんの作品全てが大好きです…！\n（再度スケブを開けて頂き本当に本当にありがとうございます…お手数をおかけしてしまい申し訳ございませんでした…！！！）\n\n\nSkeb受付されているのを拝見して、勇気を出してリクエストさせて頂きました。\nもしよければ、TRPG「初恋性ストックホルム症候群」で作成したOCカップルを描いて頂きたいです！（相方には許可を頂いております）\nご縁がありましたら、何卒よろしくお願いいたします。\n（※依頼分にシナリオネタバレはございません）\n\n\n■キャラクターについて\n\n✧若宮 望人　/　攻め\n男　/　32歳　/　180cm　/　女受けしやすい顔立ち\n【性格】\n職業は弁護士。\n明るい、おしゃべり、ラフな感じで接することが多い。関西弁で喋るけど、生まれはバリバリの東京。（昔普通にしゃべると怖いと言われたのを気にして柔らかく聞こえる関西弁に変えているのが理由）\nコミュ強の陽キャ。若王子に一目ぼれして猛アタックした。\n\n\n✧若王子  錦　/　受け\n男　/　30歳　/　176cm　/　男の美人顔、端正な顔立ち\n【性格】\n職業は検事。\nプライドが高く、完璧主義者で隙のない人物。真面目で頭が固すぎるが仕事外はポンコツ。\n恋愛に興味がなかったが若宮の猛アタックに折れて付き合うことになった。今ではすっかり骨抜きにされている。\n\n\n【関係性】\n恋人同士で同棲もしています。\n若宮→→→→→→→→←←若王子の愛情比重です。\n\n\n\n【シチュエーション】\nよければお魚屋さんのウェディングフォトコンセプトのイラストがめちゃくちゃ好きなので、ウェディングフォト風のイラストを描いて頂けないでしょうか…！\n若宮の色の指定はありませんが、若王子は赤色をメインで描いて頂けると幸いです。\n他はお任せ致します！髪型やポーズなど自由に描いて頂けましたら幸いです！\n\n\n\n以上になります。\n金額が足りない場合は、適切な金額の再送要請を頂けましたら幸いです。\nご多忙や内容的に難しい場合は遠慮なくキャンセル下さい！\n何卒よろしくお願いいたします。\n\nこれからも一ファンとして応援しております！\n\nhttps://drive.google.com/drive/folders/1ai1OjL4vd6DZoRGr5psvB0iWu1CZ6PcR?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@osakana_dash/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2274394, "client_id": 3399352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08bbf0b4/uploads/origins/9ab01c9c-bd73-443c-b491-bf8348866c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a20ac2578f53bce735bfbadf3c2f2a", "srcset": "https://si.imgix.net/08bbf0b4/uploads/origins/9ab01c9c-bd73-443c-b491-bf8348866c69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a20ac2578f53bce735bfbadf3c2f2a, https://si.imgix.net/08bbf0b4/uploads/origins/9ab01c9c-bd73-443c-b491-bf8348866c69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w