タ)/検討中\n※対応不可のものがあればキャンセルしてください\n\n◯資料\n三面図をつけさせていただきました！\n\n◯備考\n作品利用の際に馴染ませる為に色味の調整などをさせていただく可能性があります‥‥！\n\nお忙しいところ恐縮ですが、ご検討いただけると嬉しいです。\n季節の変わり目なのでご自愛ください🍁\n\n雲柳傳りゅう\n\nhttps://drive.google.com/file/d/1TU32nd7ie2-LCl61ZPbEQxCOsUc8F4-G/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dear_nightzZ/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1473817, "client_id": 3297958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de6aa35d/uploads/origins/7a62fda6-4489-4348-bc40-28f999a4292a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e9cf3693907efceeadaf5d028f261424", "srcset": "https://si.imgix.net/de6aa35d/uploads/origins/7a62fda6-4489-4348-bc40-28f999a4292a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=e9cf3693907efceeadaf5d028f261424, https://si.imgix.net/de6aa35d/uploads/origins/7a62fda6-4489-4348-bc40-28f999a4292a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=0496b5e1a74de25b1248ba7e5016ce68 2x, https://si.imgix.net/de6aa35d/uploads/origins/7a62fda6-4489-4348-bc40-28f999a4292a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=bd1580b32d69a3f76be323f789c54c2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de6aa35d/uploads/origins/7a62fda6-4489-4348-bc40-28f999a4292a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=2d13c558a294bd749a9f3ab6333ba1be", "srcset": "https://si.imgix.net/de6aa35d/uploads/origins/7a62fda6-4489-4348-bc40-28f999a4292a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=2d13c558a294bd749a9f3ab6333ba1be, https://si.imgix.net/de6aa35d/uploads/origins/7a62fda6-4489-4348-bc40-28f999a4292a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=165f6895a548033acb635e53ac616bd