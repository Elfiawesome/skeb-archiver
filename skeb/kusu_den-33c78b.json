ll leave the rest up to you, from pose, to our clothing fused, to how our hairs would look, thank you!\n\nIf you could do a version of us in base and one in ssj that'd be great, but if not that's okay too!\n\nhttps://drive.google.com/drive/folders/14cHb9znXiJzoUaVLrYEVwFBlU4bnykgO?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kusu_den/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1039292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a882dd82/uploads/origins/47aeb44c-a527-4af4-a598-802885c6c287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6488ba51ca1f21fa581d1b2245acd3c6", "srcset": "https://si.imgix.net/a882dd82/uploads/origins/47aeb44c-a527-4af4-a598-802885c6c287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6488ba51ca1f21fa581d1b2245acd3c6, https://si.imgix.net/a882dd82/uploads/origins/47aeb44c-a527-4af4-a598-802885c6c287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99da9b11916d422f892ce2bd9d8bc8a2 2x, https://si.imgix.net/a882dd82/uploads/origins/47aeb44c-a527-4af4-a598-802885c6c287?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ef63813c7ab3e64eed17809253d028b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a882dd82/uploads/origins/47aeb44c-a527-4af4-a598-802885c6c287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d178e5a9174a3766a6f53ca5417977e2", "srcset": "https://si.imgix.net/a882dd82/uploads/origins/47aeb44c-a527-4af4-a598-802885c6c287?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d178e5a9174a3766a6f53ca5417977e2, https://si.imgix.net/a882dd82/uploads/origins/47aeb44c-a527-4af4-a598-802885c6c287?bg=%23fff&auto=format%2Ccompress&fm=webp