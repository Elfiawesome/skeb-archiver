ン)や配信(サムネイルやOP、ED)での使用\n壁紙や印刷して飾るなどの個人利用\n\n可能でしたら人物のみの透過レイヤー又はPSDファイルがありますととても嬉しいです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-MYLH0Za13ERqPsJWqbV9wyI29CYnAFY", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimu_1112/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b8ea9f83/uploads/origins/85ce4927-edc2-498f-8432-83047f7efc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f801226c6b24e4bd30ac60a707149495", "srcset": "https://si.imgix.net/b8ea9f83/uploads/origins/85ce4927-edc2-498f-8432-83047f7efc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f801226c6b24e4bd30ac60a707149495, https://si.imgix.net/b8ea9f83/uploads/origins/85ce4927-edc2-498f-8432-83047f7efc78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6177635d1e4f885f440ee89c007f9e20 2x, https://si.imgix.net/b8ea9f83/uploads/origins/85ce4927-edc2-498f-8432-83047f7efc78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c91f5f53a87f5d812f293d46a683358 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3428609, "client_id": 3046765, "nc": 128}, {"path": "/@rimu_1112/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3428609, "client_id": 154813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54a20182/uploads/origins/6dfcc970-fcb9-47e5-b909-80d7a0f58aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e638244b294d26