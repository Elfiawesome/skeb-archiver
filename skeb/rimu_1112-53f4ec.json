くお願いします。\nhttps://drive.google.com/drive/folders/1ldnQ85FiD2bewf2m3tZyI8EBekVtrdmj\nhttps://drive.google.com/drive/folders/1vEsUUbtBMMe0u8itbaKtlOKZw4UYNphw", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rimu_1112/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3428609, "client_id": 3516705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca37f140504c71564cce34463f70face", "srcset": "https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca37f140504c71564cce34463f70face, https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa4575d78f98d67443f8f95f1e13d651 2x, https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67dee4032c2d76cda3bf3f4198bd4e67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb4983f33255ecd085456bfab56bd3be", "srcset": "https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb4983f33255ecd085456bfab56bd3be, https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7150d7671ab55c6264016791a16688a4 2x, https://si.imgix.net/255eec43/uploads/origins/75a8f86a-0eda-49b0-90ea-db6f8994b8ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea1e961e7415f2e9c709f491aa9c703e 3x"}, "body": "Rimu様\n\n初めまして、準備中Vtuberの彩生つむぎと申します！\n私もミクちゃんやプロセカのキャラクターの子達が大好きなので、Rimu様の素敵なイラストを以前から拝見しておりました。\nこの度Rimu様のskeb募集のツイートをお見かけし、リクエストをお送りさせていただきました...！！\n\n◎イラストの構図\n私は歌を歌う活動をしているので、マイク等を持たせていただけると嬉しいです...！\nその他の構図や表情などの細かい部分は全てお任せします！\n\n◎デザインについて\nデザインは資料URLの方からご覧いただければと思います！\n衣装は立ち絵のままだと助かりますが、衣装の簡略化などはご自由にしていただいて大丈夫です！\n\n◎可能であればお願いしたいこと\n・サムネイル等に使用させていただく可能性があるため、帽子や髪が見切れない形でのイラストのご制作を希望します。\n・イラストは背景透過された状態のものもいただけると大変助かります。\n・背景がある場合は、背景、人物、宛名が分けられたPSDデータもしくはPNGファイルをいただけると大変助かります...！！\n\n◎イラストの使用用途\nSNS掲載、配信サムネイルに使用、ショート動画に使用などを予定しております。\n使用用途としてNGなものがあれば御手数ですが、レイヤー等にご記載いただけますと幸いです。\n\nお忙しいところ恐れ入りますが、ご検討の程どうぞよろしくお願い致します...！\n\nhttps://lit.link/Ayasetsumugi", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 178519, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よよよ◇", "screen_name": "toyogaippai", "avatar_url": "https://pbs.twimg.com/profile_images/1818588901537464321/FybG6SJZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4233984672/1672421738/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_