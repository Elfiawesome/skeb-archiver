ト】\nさくらみこ7周年記念イラスト\n【シチュエーション】\nflower rhapsody(MV)の最後のコルクボードに思い出の写真とメモが貼ってあるカットのオマージュ\n【イメージ】\n※コルクボードを全体の背景として欲しいです。\n・ボードに思い出の写真を貼る(両サイドの4枚の部分)\n→金コイ、GTA、マリカ、マイクラ\n(細かくなくて大丈夫です)\n・ボードの真ん中の列\n上段→【さくらみこ  7th Anniversary】と記載したメモ\n中段→【ソロライブでの35Pとの記念撮影時の写真】の完全オマージュ\n下段→【目標🌸2ndライブやるぞ‼︎】の完全オマージュ\n【使用用途】\nみこちの7周年のお祝いポスト\n名刺やXのプロフィール(litlink等)に載せたい\n\nカミツレ先生のイラストと共にみこちの7周年を祝いたいと思っております。お忙しい上に連続での依頼…本当に恐縮なのですが、是非ご検討の程宜しくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hul_jion4/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2399113, "client_id": 3663992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3dbdba7/uploads/origins/6f9659f6-cc93-4e02-a997-35c2be63532a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d82b0e8306ac3c3f4fcf488a2c6a8802", "srcset": "https://si.imgix.net/e3dbdba7/uploads/origins/6f9659f6-cc93-4e02-a997-35c2be63532a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d82b0e8306ac3c3f4fcf488a2c6a8802, https://si.imgix.net/e3dbdba7/uploads/origins/6f9659f6-cc93-4e02-a997-35c2be63532a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b4d85424959d7dd34bff0c1df8ef341 2x, https://si.imgix.net/e3dbdba7/uploads/origins/6f9659f6-cc93-4e02-a997-35c2be63532a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49d3f9ebf728ffc191324cceaec309e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3dbdba7/uploads/origins/6f9659f6-cc93-4e02-a997-35c2be63532a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28410c787ba10f5b98ac4783eae6eb9b", "srcset": "https://si.imgix.net/e3dbdba7/uploads/origins/6f9659f6-cc93-4e02-a997-35c2be63532a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28410