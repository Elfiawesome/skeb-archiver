ただきたいと思い依頼いたしました。\n服の装飾やデザインなどわかりにくいところがございましたら省略していただくか、想像で補っていただいて結構です。\n\n【キャラクター・世界観】暦擬人化キャラクターで2月の擬人化です。冷徹ながらも豪快で勢い余って雑なところもありますが、人々の幸せを願う優しい少年です。\n【使用目的】個人観賞用や待ち受け等に利用させていただきます。SNSのアイコンやヘッダーに利用する予定はありません。また商用を目的とした依頼ではありません\n【構図】具体的な指定はありませんが、鬼退治を生業とする少年なので躍動感があると嬉しいです！\n\nお忙しいところ誠に恐縮ではございますがご一考いただけますと幸いです！\n\nhttps://drive.google.com/drive/folders/1QUMUzhxOX_HNABK4LZMA5TESlXT2H-o1?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nobi_kanida/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3737409, "client_id": 3791696, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65786c68/uploads/origins/3d6fb1e6-59ad-4cc9-b82e-62ebba61c0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be11062b853eca47fc372acbb17ee72d", "srcset": "https://si.imgix.net/65786c68/uploads/origins/3d6fb1e6-59ad-4cc9-b82e-62ebba61c0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be11062b853eca47fc372acbb17ee72d, https://si.imgix.net/65786c68/uploads/origins/3d6fb1e6-59ad-4cc9-b82e-62ebba61c0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55e63d1da5431126881dff79be71e7f4 2x, https://si.imgix.net/65786c68/uploads/origins/3d6fb1e6-59ad-4cc9-b82e-62ebba61c0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=243ba6a93ee295b6fda5527cedbdf577 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65786c68/uploads/origins/3d6fb1e6-59ad-4cc9-b82e-62ebba61c0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aab76090ecdfd3244f40654f43eaf74b", "srcset": "https://si.imgix.net/65786c68/uploads/origins/3d6fb1e6-59ad-4cc9-b82e-62ebba61c0b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aab76090ecdfd3244f40654