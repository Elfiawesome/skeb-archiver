f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6243e790e4c64a68b0fd20c97dfee94c", "srcset": "https://si.imgix.net/209163d4/uploads/origins/def95d1f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6243e790e4c64a68b0fd20c97dfee94c, https://si.imgix.net/209163d4/uploads/origins/def95d1f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91fe5e4a00765a591d40d10ce53427cb 2x, https://si.imgix.net/209163d4/uploads/origins/def95d1f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2ff08011a2803de1ec46ebffae0fd97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/209163d4/uploads/origins/def95d1f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf1f93255db8db5db04d87e479e98d0e", "srcset": "https://si.imgix.net/209163d4/uploads/origins/def95d1f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf1f93255db8db5db04d87e479e98d0e, https://si.imgix.net/209163d4/uploads/origins/def95d1f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e362ba75f5541429ce40b2ed45ec477 2x, https://si.imgix.net/209163d4/uploads/origins/def95d1f-923c-40bc-8d89-bb2dba3c7228?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23afe8e6a8f1a7e3778352775b2af819 3x"}, "body": "藍白むゐ様\n初めまして！Rincaと申します。\nおしがまVtuberとして活動してます。（https://twitter.com/Rincamovie）\nおすすめのクリエイター紹介でされていて見つけました。\nもしよければ「Rincaちゃん（旧3Dモデル）」を描いていただければ幸いです。\n\n用途：\n・SNSでの掲載\n・収益化済みの動画サイト（YouTubeやニコニコなど）での使用/サムネイル画像\n\nキャラクター：\n狐をモチーフとしたVtuberで、大きなツインテールとふわふわのお耳、まろ眉が特徴的です。\n参考にリンクを貼らせていただきます。\n（https://drive.google.com/drive/folders/1XzWNE7ZZrznhI8VpLZ8MrcM43CcBpeUU?usp=sharing）\n\n性格：\nつるペタで生意気、意地っ張りで、おしがまが好き。\nわからせられたがりなツンデレ系狐っ子、っていう設定です。\n\n髪型や髪の色：\n大きなツインテール、シルバーよりの色\n\n目の形や色：\n大きくてぱっちりした緑色の瞳\n\n表情：\n切り抜きの内容は、「配信中に漏らしてしまって…。」というのが主なテーマになります。\n焦っているor恥ずかしくて赤面しているor「どうしよう」と困惑している等のテーマに合う表情だと切り抜きとして使いやすいです。\n\n背景：\nサムネに使用する予定なので、特に必要ありません。\n\nサイズ：\n1920ｘ1080の画面での使用を想定しています。\n\n透過：有（可能であればPSD希望）\nもし可能であれば、背景とRincaちゃんを別レイヤーに分けてあるものも、いただけると助かります。\nサムネイルなどに使用するため、頭部や耳、顔回りにかかる可能性がある部位が見切れていないようにしていただけると助かります。\n\n内容的に、厳しい場合は、気軽にキャンセル（再送）して頂いて構いません。\n何卒ご検討宜しくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ai466e/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 3623279, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/3fcd67b3-6e00-40e5-a783-d10236a731a7?response-content-disposition=inline&Expires=1784447863&Signature=ISobrltLqNJrPHC8NOln4~vjI2b~AWlEF~2dtcIEKgsaWyFKA6yJNDNJzK~LvYL3LcbcrQgSEAYmaweHiibynpgoy5hebwayBxif4pz7BU21X98XSqTTfsbhoaQEFi6IpErlcn31YRJT1XhSy-KgjJKhuexbplOKRK2IEOvNjj9Bqa9mfAiCRiUkDHAKYFSGWdSkSoDTKCzgT59oo4T4GxxjryU3mzo9TJeT6qi47Bj9k-e35eaEpDkodwfyizkmUBZ~vCIuZmDlX0ieS1qh3uUeSagQ~L2d5hiiohV9jdBaUO0hkCZRh8CBstzapJL4gSYxY4cLNqBFoVmKGkbkPQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2063238285095559168%2Filvw2o1v.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c9b0d7f7ed515b178e678d89676bb3d", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2063238285095559168%2Filvw2o1v.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c9b0d7f7ed515b178e678d89676bb3d, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2063238285095559168%2Filvw2o1v.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1f4e058e215f8d08aa2fa8f3bbd67