もしも誕生日に間に合わずとも、贈り物にできればと思いますので、お受けいただければ幸いです。\n以下に私とパートナーの特徴を書かせていただきます。一応服装等の情報も書かせていただきますが、イラスト内に服装等は使わない場合もあると思いますので、ぽちさんが必要な情報をお使いいただければと思います。\n\n私\n・男性\n・黒髪のソフトモヒカン\n・前髪はなく、正面から見ると三角の山のような形\n・はっきりとした目の二重のつり目\n・彫りが深い\n・ひげ等はない\n・普通体型\n・黒いチノパンに白いTシャツのに水色のシャツを羽織っている\n\nパートナー\n・女性\n・黒茶のミディアムからセミロング程度の長さ\n・毛先が少しゆるく内側に巻いてある\n・正面から見て右から左側に流れる斜め分けの前髪\n・奥二重の垂れ目たれ眉\n・柔らかい表情\n・笑うと目が細くなる\n・細め体型\n・白いブラウスに紺色のロングスカート\n\n宛名の方は可能でしたら、宛名の名前に誕生日おめでとうございますのような言葉をいただければより嬉しく思います。\n\nこれからもぽちさんの素敵なイラストを癒しとさせていただくとともに、活動を応援しております。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pochi_line/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1221600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de071ae251a7ee20009a3278ef31cb2a", "srcset": "https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de071ae251a7ee20009a3278ef31cb2a, https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc561624ffc3b96baa7548fab8b677d5 2x, https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=438b3dc12a8a2f0de70465817f0d659c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a0bc093c4428f4091598b17680bec08", "srcset": "https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a0bc093c4428f4091598b17680bec08, https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fcf4d558494f235e7647b641a712377 2x, https://si.imgix.net/141174f9/uploads/origins/9f8cf5f8-d23e-4612-ad72-9c23bd424907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a40c673a577520a90b2723a05b954ff9 3x"}, "body": "ぽちさんのイラストの大ファンでいつも素敵な作品に癒されております、ありがとう御座います。\nそんなぽちさんがスケブを始められたので、思いきってリクエストを送らせていただきます。\n\nリクエスト内容は私のオリジナルのキャラクターをぽちさんのイラストで拝見できたらと思いこちらのキャラをリクエストさせていただきます。\nTwitterで「@oruserug アヴァル」で検索いただきますと、私のイラストや、そのキャラに寄せて作ったオンラインゲームキャラの画像等が出てきますので、そちらを参考にしていただければと思います。\n\n金髪青目、ショートヘアだけど少しハネっ毛あり。服装は適当で大丈夫です。\n可愛い小動物(犬や猫)やチョコレートが大好きな青年です。\n\n私はぽちさんのような、ゆるふわな絵が描けない人間なので、ぽちさんテイストな自分の最愛な息子が見れたら幸せだなと思いリクエストさせていただきました。\n公式のキャラクターでもなく、特徴もあまり無い平凡な青年ではあるのですが、ぽちさんが何か落書きしたいなぁ、人の子を描いてみたいなぁと思ったりすることがあれば良かったら…！\n\nこれからもぽちさんのイラストを応援、楽しみにしております！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 263850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えんがわ🍣skeb open!", "screen_name": "engawa110", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2F8f728b08-19a2-4105-829a-adbe7b98fa1f.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fabc4d71-23dc-476a-8210-af0e559474b3.webp", "appeal_receivable": false, "popular_creator_rank": 10, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1450194, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "へんぢん", "screen_name": "hennahitooooooo", "av