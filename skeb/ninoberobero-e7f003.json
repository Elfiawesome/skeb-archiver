-5100-4adf-8251-479bf1d48012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83761b55bd523a81f57ee4b798ab179d", "srcset": "https://si.imgix.net/032ff07e/uploads/origins/478fd4d3-5100-4adf-8251-479bf1d48012?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83761b55bd523a81f57ee4b798ab179d, https://si.imgix.net/032ff07e/uploads/origins/478fd4d3-5100-4adf-8251-479bf1d48012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79914a8f48dbae75b09658f11d57e473 2x, https://si.imgix.net/032ff07e/uploads/origins/478fd4d3-5100-4adf-8251-479bf1d48012?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=acf32051274cf898f2b67ac2d9b1c3a0 3x"}, "body": "初めまして。\nブルーアーカイブの天童ケイがMMD等に出てくるエロ標識にエロい目に遭わされるイラストをお願いします。\n背景ストーリーとしては特異現象の調査していたところエロ標識に出会ってしまったというイメージです。\n\n標識によって\n・ポーズを犬のちんちんポーズの様に足を開き手を前に。手はピースさせて下さい。\n・服装を細い紐マイクロビキニで犬耳とアナル尻尾の格好に。鈴付きの首輪もつける。\n\n上記の格好のもと標識により強制的に腰ヘコダンスさせられる。また同じ標識に禁止マークの標識もあり腰ヘコダンスするとペナルティ(強制絶頂)が発生(怪異は2体いたという感じ)。\nという板挟みの状態で悔しそうや不服そうな表情とセリフを言いながら為すすべなくイキまくるケイをお願いします。\nまた、紳士ハンド(手だけの怪異)に水着をずらされたり引っ張られたり乳首をこねくり回したり動けないケイに好き放題して下さい。\n\n可能でしたら、上記の他にも妄想出来そうな標識を描いて下さい。\nライブ配信、イラスト内にされてる様子は不要でこれからされちゃう、既にされちゃった責めの標識(くすぐりとか羞恥系方向でお願いします)", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ninoberobero/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63509402/uploads/origins/c28b16d0-833f-4523-9466-aeec52b524d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8f43f52578eaa0b9f22b8b71b38e83a", "srcset": "https://si.imgix.net/63509402/uploads/origins/c28b16d0-833f-4523-9466-aeec52b524d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE