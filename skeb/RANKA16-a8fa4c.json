ae5-4256-b6a7-fb2b6e6f4bf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3a8c8901961bf879ce5be8378817e2f, https://si.imgix.net/b1d253a3/uploads/origins/8d12c7bf-2ae5-4256-b6a7-fb2b6e6f4bf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a6011678c07fa3af57a4e02be395991 2x, https://si.imgix.net/b1d253a3/uploads/origins/8d12c7bf-2ae5-4256-b6a7-fb2b6e6f4bf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc07bb52ea3ae24bda573b33f7e81f65 3x"}, "body": "はじめまして、永崎らんかさん。\n\n七海というVの作品をお願いしたいのですが、私の希望する衣装はこちらを参考にしてください。\n[https://drive.google.com/file/d/1g_EN6XzAOIR3mhsPXsVN8pgiDqtGz8gI/view?usp=share_link］\n\nできれば、このキャラクターの【感覚遮断】+【肉体改造】のシーンをお願いしたいです。\n\nこのキャラクターは、全裸で鉄製タンクに入れられ、タンク上部の頭部だけを露出させ（帽子はないが、ヘアピンは残っている）、全身はタンクにセットされ、内部の無数の触手によって改造されます。ただし、首から下の感覚はすべて遮断されているため、その過程を知ることはできない。\n\nもちろん、水槽の中で何が起こっているのかがわかるように、水槽の大部分を透明に描いています。\n\nこんな感じの機械があってもいいと思うのですが、フォーカスポイントはキャラクターが中にいる水槽で、直方体の部分ではないので、背景に置いてください。\n[https://drive.google.com/file/d/1yi_RTUXMG7n-8lPwHD2bvXXt4Tz6EMhb/view?usp=share_link]\nちなみにこの機械はオゾン発生器です。\n\n改造についてですが、主に膨乳と膨腹が欲しいです。これ以外にも乳首と両穴に触手をたっぷり差し込むことができます。脚も触手で固定し、M字開脚のポーズで。また、両乳房からは大量の乳汁がはじけ出ています。\n\nキャラクターの顔はリラックスしているのが望ましいです。\n\n肉体の改造感を高めるために、服や下着（普通の下着で、黒くてコンサバで、他の服の一番上に置く）を機械の前に置くといいと思います。以前は小さかったブラジャーと、今の巨大な乳房を比較するのも楽しいでしょう。\n\nありがとうございました。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RANKA16/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2645624, "client_id": 57819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e8b8c21982a9ea420593232df3ade15", "srcset": "https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e8b8c21982a9ea420593232df3ade15, https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5cd335c5afd7e6864f66b7e1b02b91d 2x, https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2249aade878f4f305690afb1140f83ea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a5eccf6169f2d49cbea0985aeb80675", "srcset": "https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a5eccf6169f2d49cbea0985aeb80675, https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62cac559193f7e0aeb60e4cd76dcc4c3 2x, https://si.imgix.net/d99f5ab7/uploads/origins/ed2c58be-5282-40eb-959a-d9ce35963187?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5f9f353af6ca289be73c339cf5b748 3x"}, "body": "一度描いたキャラの方が作業しやすいような印象を受けましたので\n\nヨル・フォージャーでお願いします\n\n男性主観の両乳揉み騎乗位中出し(主導権は女性側)\n女性は男性の腕を掴んで胸に誘導\n男性、デブやおっさん×\n\n揉みは乳首が隠れるようにしてください。ただ胸は潰しすぎないように\n個人的に胸は長乳や外に流れるのはあまり好みではないです。\n\n乳揉みイメージは僕のヒミツ、お姉ちゃんのヒミツという作品の14-15ページあたり\n\n座り方は膝を地につけてください。\n中出しされてるものの表情はクールに\n\n服装は自由にしてもらって構いません。\n秘部と鼠蹊部と胸は見えるようにしていただければ(めんどくさいなら全裸でも)\nまた挿入は全入れより9-9.5割くらいを\n陰毛は両者無しで\n\n差分はつけてもらえるのは嬉しいですが個人的には1枚でも全然問題ありませんし作業量のこともあるのでお任せします。\n\n背景は気にしないので無しでokです。\n描き方等フルカラーなりモノクロなりカラートーンなりラフでも線画でも\nおかずにできればいいと思ってるので", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"pat