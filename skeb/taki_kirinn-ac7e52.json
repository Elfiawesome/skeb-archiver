tps://si.imgix.net/5f054ae9/uploads/origins/e7e82a2c-e652-435a-8ca9-d656a85cb06e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff9d52e6328598f0b7e191157219626, https://si.imgix.net/5f054ae9/uploads/origins/e7e82a2c-e652-435a-8ca9-d656a85cb06e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6d54a8a835b6ce771b46bb32a14f1e8 2x, https://si.imgix.net/5f054ae9/uploads/origins/e7e82a2c-e652-435a-8ca9-d656a85cb06e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77cd156c5989175a47cc64df4b073964 3x"}, "body": "はじめまして、TAKIさん\nいつも楽しく作品を拝見させていただいております。\n早速ですが、リクエストよろしいでしょうか？\n刀剣乱舞の鶴丸国永VS鉄拳シリーズのキャラクターであるファランが格闘対決をして、とどめにデスプレッシャーという技でとどめを刺すというイラストを描いていただきたいのですが・・・。\n流れとしては、まずファランがデスプレッシャーを仕掛けるが、全然効かず、逆に鶴丸国永に同じデスプレッシャーをくらわされて、ＫＯされるという流れでお願いします。\n\nデスプレッシャーに関しては、下記の動画をご覧ください。\nhttps://youtu.be/ZjenVmeux00\nそしてキャラクターの服装に関してですが、ファランは動画にある通り、テコンドー着で\n鶴丸国永は\nhttps://i.pinimg.com/564x/9f/73/bf/9f73bf029058079bd765d1bc192bf992.jpg\n上記のような服装で、足袋をはいているかと思うのですが、裸足にトレンカという形でお願いします。\n\n追記：足をリアルに描いてほしいことと、足は双方大きめに描いてくれると嬉しいです。\n長くなってしまいましたが、何卒よろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taki_kirinn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 96750, "client_id": 362814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a27469b72895b2d647970ac1608d09f", "srcset": "https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a27469b72895b2d647970ac1608d09f, https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d81d36376e249400924f71b660081b0 2x, https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ebf6b11aaa4d91b2ee9faf9b1a15efec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b7252f859a261a0bfe522ad34d1728", "srcset": "https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b7252f859a261a0bfe522ad34d1728, https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a021ca71afb512a69ac097b6163b3a2d 2x, https://si.imgix.net/ea2325c4/requests/59595_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2928f3c9d63c83b225c763e41437e311 3x"}, "body": "初めまして。\nTwitterの背景サンプルを拝見しまして、壊れたシャッターのある絵みたいな雰囲気がいいなと思い、リクエストさせて頂きます。\n\nカラーの一枚絵をお願いします。\n用途としては使用しているノートPCの壁紙として使用したく、画面サイズは15.6インチ：345mm×194mmなのでできればそのくらいの縦横比率でお願いします。\n負担が大きくなってしまうようであれば適当に横長めで描いて頂ければ大丈夫です。\n\n周囲を田んぼに囲まれた田舎道の夜。\nイラスト中央に一本の古びた電柱と街灯があって、円系に真下の狭い範囲を照らしている。\n電柱や街灯の素材などはお任せします。\n周囲は田んぼである事がわかる程度で結構暗めに。\n遠くの田んぼの中とか電灯が照らしている範囲の外とかに人型の何かの影をひとつポツンと置いてもらって、田舎のよくある原風景だけどちょっと不穏な雰囲気だと嬉しいです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 25387, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "大怪鳥ぶんまる skeb募集中", "screen_name": "bunmaruMOUSOU", "avatar_url": "https://pbs.twimg.com/profile_images/1947080496250515456/irkHY_8i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2755408544/1650685022/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}]