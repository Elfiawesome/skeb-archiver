ator_id": 2437327, "client_id": 2849887, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c422bd8c/uploads/origins/c0ce2a63-f547-495b-81f4-b578aefccd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd532c1d130cafc27dbce6d93c5b2629", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c422bd8c/uploads/origins/c0ce2a63-f547-495b-81f4-b578aefccd6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=434ca984a3a1abcb3f91aa2382703f08", "src_set": ""}, "body": "こんにちは、あなたの絵のカラフルな感じが好きです！私のキャラクターを描いてほしいです。あなたの過去の作品のように、カメラが彼女を見上げるような感じで。https://skeb.jp/@MIZ0_mmm333/works/64\n\n私のキャラクターはサボテンヤマネコで、やんちゃな性格で、大きなおっぱいと大きなお尻がセクシーな体をしています。ポーズはお任せします！\n\n細かいところでは、腕と尻尾のトゲトゲ、鋭い爪、白い猫ひげ、口の中と舌が緑色、耳のてっぺんがヤマネコのようにとがっていて黒いところも見逃せない。\n\nhttps://drive.google.com/drive/folders/1-Hi4ATFq8wW5LrDjA-BieneDBsS3YJ9M", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIZ0_mmm333/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2437327, "client_id": 1136251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbd69a2d/uploads/origins/663fdece-17d5-432a-9fc3-1074d4eb6e08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92479d9c44dfd5e2a6070b7f07fc2d15", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbd69a2d/uploads/origins/663fdece-17d5-432a-9fc3-1074d4eb6e08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4b5a2b2acd8caa4da4159b6f24c86de", "src_set": ""}, "body": "初めまして！素敵なイラストを拝見したので頼みたくリクエスト失礼します…！\n攻めが緑髪の男で受けが白髪のショタです！攻めが基本的に白髪のショタの方を手玉に取っているので、白髪のショタとラブラブですが白髪のショタがイライラしてるえっちなイラストを書いていただけると嬉しいです…！\n緑髪▶️ めぐり→むかでの顔が代々大好きなメイクアップアーティスト。彼のストーカーをしたが気づかれていた。むかでさんのことを神と信仰しているが、むか