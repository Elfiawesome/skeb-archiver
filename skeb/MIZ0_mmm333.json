enre": "art", "tipped": false, "creator_id": 2437327, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fdc62513/uploads/origins/ada3fd4e-c383-4403-bcf5-05080044d71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=583bc1169e0b4cae74ba0373c7bb9cc2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fdc62513/uploads/origins/ada3fd4e-c383-4403-bcf5-05080044d71e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8b3f9cb463f1aa87c411c68fd7edc83", "src_set": ""}, "body": "こんにちは！あなたの気まぐれでカラフルなアートスタイルが本当に大好きで、ぜひ依頼したいと思っています！インスピレーションを得るために参考にしたOCは他にもありますが、あなた自身のキャラクターを自由にデザインして作ってもらいたいと思っています。もっと具体的に言うと、ゴシックでオルタナティブな女の子が好きです。悪魔、サキュバス、吸血鬼、あるいは似たようなもの。アクセサリーは、角、尻尾、牙、タトゥー、宝石など、多ければ多いほどいいです！釣りをしているような設定にしてほしい。魚を持っていたり、釣り竿を持っていたり。もし魚を追加するのであれば、どのような魚がいいかを追加しました。魚のスタイリングは自由にしてください！可能であれば、キャラクター全体が見える全身デザインを希望します。ポーズは自由ですが、セクシーなポーズが好きです。デザインの用途としては、ステッカーを作成することです！依頼を検討していただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1TCJb3GTbaFb41pQjNWNFOfudFVvqnTfu?usp=drive_link", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIZ0_mmm333/works/80", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2437327, "client_id": 2485473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2887604f/uploads/origins/4e405aae-0a3b-46ba-b14c-093460df6c23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2f365ad1d21b9e3ab96aee2c8a4af26", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2887604f/uploads/origins/4e405aae-0a3b-46ba-b14c-093460df6c23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a49a1037cd020449fb50e3fe4a116ce", "src_set": ""}, "body": "こんにちは！YTで配信している春夜と申します\n以前プレゼントしていただいたミ造さまのskebイラストがとても素敵だったので、依頼をお願いしたいです！\n\n【用途】\nYT配信の2周年記念ハロウィンイラスト\n・グッズ化（無償・有償両方想定/アクスタやTシャツにできたらいいなと思っています）\n・動画素材(元のイラストを損なわない程度にアニメーションする可能性があります・live2dで髪揺れや呼吸っぽい動きをつけるなど)\n・サムネイル（上に記載してある用途の方が優先度が高いです）\n上記利用が不可でしたら、お手数ですが条件を変えるように差し戻していただけると幸いです！\n\n【キャラ】\n元気なピンクの小悪魔です\nマスコットキャラのデビちゃん（むらさきのいきもの）も一緒に書いてくださると嬉しいです！\nキャラ参考⇩\nhttps://www.pixiv.net/artworks/117746554\nhttps://www.youtube.com/@haruya3devi/streams\n\n【仕様】\n・サムネや配信でも使うので、1920＊1080画角での使用に耐える解像度で作成してほしいです\n・背景と分離したキャラだけの透過pngもしくはpsdデータをもらえると嬉しいです\n・顔周りに見切れがないと使いやすく嬉しいですが、構図のかっこよさを優先でお願いします\n\n【イメージ】\n・ハロウィンのイメージで、みている人を驚かしているような感じ\n・大胆で動きのあるポーズ・構図だと嬉しいです\n・服装や髪型はキャラが判別できる範囲で似合いそうなデザインをしていただければ幸いです\n・できれば表情の差分があると嬉しいですが、料金が足りなければスルーしてください\n\nよろしくお願いいたします！\n\nhttps://www.canva.com/design/DAGp4LOgFfY/qtYhSyC-LooUbcETrXryOw/edit?utm_content=DAGp4LOgFfY&utm_campaign=designshare&utm_medium=link2&utm_source=sharebutton", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MIZ0_mmm333/works/79", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b378de9a/uploads/origins/07acb957-9dd5-4040-9a2a-7a649adfe7e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b097d2429c7d273030e6b444aacfca03", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2437327, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@MIZ0_mmm333/works/78", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2437327, "client_id": 1369724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ff38195/uploads/origins/cd9dacf5-1d23-4b96-91af-deecd2979