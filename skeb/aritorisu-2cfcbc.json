e-41d3-8e28-017be80b5924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecd5bbe13b921ff6132161f83d6925d1", "srcset": "https://si.imgix.net/ce71237f/uploads/origins/74a5fc37-250e-41d3-8e28-017be80b5924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecd5bbe13b921ff6132161f83d6925d1, https://si.imgix.net/ce71237f/uploads/origins/74a5fc37-250e-41d3-8e28-017be80b5924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f5f16204368cf51ed73cb63e741652a 2x, https://si.imgix.net/ce71237f/uploads/origins/74a5fc37-250e-41d3-8e28-017be80b5924?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41d8348621cec5495788ec3dcd7dd881 3x"}, "body": "有采りす様\n前回は種子島で武装した犬耳巫女さんをありがとうございました。\n今回は有采様に終戦の日を描いて頂きたく依頼を送ります。\n\n内容\n巫女装束を着た犬耳ロリババアが三八式歩兵銃で半旗の日の丸に捧げ銃をしている絵をお願いします。\n\n詳細\n巫女装束について\n巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。\n\n犬耳、尻尾等について\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは委任します)\n\n体型等について\n人間でいう9〜18歳くらいの外見\n胸部は貧から巨まで委任します。(ロリ巨乳も可)\n\n表情について\nほんの僅かに優しく微笑んでいる、どこか物憂げ、無表情の中から選んでください。\n\nロリババアついて\n「これが描かれていればロリババア」という定義等はありませんが、悠久の時を生きた経験らしさ、威厳なり落ち着いた雰囲気なりが描かれていればと思います。\n\n場所について\n委任します。\n迷うようでしたら神社、海辺、密林、荒れ地、洞窟等あたりをお願いします。\n\nその他解説\n半旗\n特定の日に弔意を表すために旗を少し下げた状態で掲揚する行為\nhttps://ja.wikipedia.org/wiki/%E5%8D%8A%E6%97%97\n\n三八式歩兵銃\nhttps://regimentals.jugem.jp/?eid=3358#gsc.tab=0\n全長127.6cmあるのでロリババアの身長の参考にして下さい。\n\n捧げ銃\n銃で行う敬礼動作の一種\n参考動画\nhttps://youtu.be/4Qn0lU74PUE?si=O1qJ6KvkmZ0196_n\n(23秒あたり)\n\n注意事項等\n「着剣はしない」ようにお願いします。(各個の敬礼でなく隊の敬礼になるため)\nボルトハンドルは横に倒れている(下記pixiv参照)ようにお願いします。\nhttps://www.pixiv.net/artworks/67649363\n毎年色々な絵師様に同一お題で依頼しており、過去作品等との構図被りは避けられないため、その点に関しては気にしなくて大丈夫です。\n\n今回も大変なお題ではありますが、どうか何卒よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aritorisu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3582250, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e783ab2206811992da2790f29238146", "srcset": "https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e783ab2206811992da2790f29238146, https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7cdbec7296e31fb7d3584853c3720af9 2x, https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b3528e5909184cf8a1f8cf8bbdfb2a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e60f966ffc3e8aa77ec9cb4b770707ec", "srcset": "https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e60f966ffc3e8aa77ec9cb4b770707ec, https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2dce8a83affb7815e93c2b9eab0547ee 2x, https://si.imgix.net/885cc7eb/uploads/origins/69bafda7-2963-4b74-8743-967e6a1914eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f79e06d4c6f4267c98ae3933ac34112 3x"}, "body": "有采りす様\nはじめまして。有采りす様の絵柄が気に入りましたので、依頼を送らせていただきます。\n犬耳、尻尾の巫女の女の子が種子島(鉄砲)で射撃姿勢を取っている、もしくは射撃している絵を描いていただけないでしょうか。\n\n詳細\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは任せます)\n射撃姿勢　立ち射ち、膝射ち、座り射ち、寝射ちの中からお願いします。指を引き金にかけて、今にも射撃をしそうな状況、あるいは射撃している状況をお願いします。\n種子島　一般的な大きさである小筒のほか、大型である中筒、士筒のどれを使っていても構いません。\n巫女装束　巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n表情　恐怖で怯えている以外でしたら好きに描写して構いません。(例　落ち着いた感じで淡々としている、不敵な笑みを浮かべている、穏やかに微笑んでいる、戦闘狂染みている、自我を失っている等)\n胸部　貧から爆までの範囲でお任せします。\nその他　早合「http://www.xn--u9j370humdba539qcybpym.jp/part1/archives/35」、「https://www.meihaku.jp/arquebus-basic/matchlock-launchmethod/」を首から下げている。(または袈裟懸けで下げている)\n負傷描写等　一切なくても構いませんし、軽傷または重傷でありながらも堪えている、ないしはものともしないような描写でも構いません。また、土や泥の汚れについても任せます。\n巫女装束が損傷していても構いませんが、下着等が露出することがないようにお願いします。\n場所　洞窟、草原、荒野、山岳、森林、村、神社等々候補がありますが、種子島が運用できる場所なら候補外であっても特に問題ありません。\nセリフ等差分\n内容等に合うものを委任します。\n\n有采様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aritorisu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3582250, "client_id": 3585362, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30340d7c/uploads/origins/098011e2-30bc-460d-bd40-02aab231a2a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8aa8ec67f180774e2e3d22a52dbda9", "srcset": "https://si.imgix.net/30340d7c/uploads/origins/098011e2-30bc-460d-bd40-02aab231a2a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8aa8ec67f180774e2e3d22a52dbda9, https://si.imgix.net/30340d7c/uploads/origins/098011e2-30bc-460d-bd40-02aab231a2a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=117ac12da93da1d82ed03f8324e9d9b9 2x, https://si.imgix.net/30340d7c/uploads/origins/098011e2-30bc-460d-bd40-02aab231a2a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9fc97795be4b0917df06a7c780f86151 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30340d7c/uploads/origins/098011e2-30bc-