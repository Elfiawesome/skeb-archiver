ても疲れている表情1つ。\n\n*リスの耳がないバージョン（人間の形）各1種\n\n その他はお任せしますので、彼女のキャラクターデザインや雰囲気に忠実に、肩や胸が服で隠れるようにお願いします。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1QPZtfF70Th9A0kfHg4yOXnpahVIA6Vrz?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsubaki__dayo/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fe66f750/uploads/origins/0391bd9a-ce2c-406f-90d2-f2db90a6a762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a6f9c84aeffffef6d0fea201ab3e0ac", "srcset": "https://si.imgix.net/fe66f750/uploads/origins/0391bd9a-ce2c-406f-90d2-f2db90a6a762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a6f9c84aeffffef6d0fea201ab3e0ac, https://si.imgix.net/fe66f750/uploads/origins/0391bd9a-ce2c-406f-90d2-f2db90a6a762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6462b8f288fe0b7d51792d85b1c382c3 2x, https://si.imgix.net/fe66f750/uploads/origins/0391bd9a-ce2c-406f-90d2-f2db90a6a762?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa8987404cc3c43e3e04fda0a6f289fc 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3349218, "nc": 129}, {"path": "/@tsubaki__dayo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3349218, "client_id": 3032504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/060fc23a/uploads/origins/e3306ca9-23ae-4138-95dc-080f539fde0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=