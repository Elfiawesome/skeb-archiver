able_same_genre": true}, {"path": "/@KOH_YA_hidorinu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1761585, "client_id": 1421230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=204f9d0021cea31a82ff75f512dccc1f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20a848e4/uploads/origins/4c5a3fc3-ba4f-46d7-8cc7-63145036c840?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dbe39c1b930b1e0451674cfed365383", "src_set": ""}, "body": "はじめまして、デュラン×ホークアイの依頼をさせていただきます。\nブラックマーケットでいかがわしいアイテムを買い込んだ2人が宿でお楽しみに耽るという内容で、\n構図は上部がデュランの顔アップ(眼の周りだけで大丈夫です)のカットイン、\n下部がベッドの上で体育座りの姿勢のまま仰向けになり、膝の下に腕をやってお尻を見せつけるように腰を上げているホークアイというものです。\n1枚目：デュランは興奮して目を見開いて凝視。\nホークアイは下半身裸か股間部分を破かれて露出し、使い込まれているのに綺麗にすぼまった穴を見せつけて誘う表情。\n彼の前にはこれを使って弄んでくれとばかりにポトの油や魔法のロープやアナルパール状に数珠つなぎにされたモンスターの瞳が並べられている。\n\n2枚目：ホークアイの尻には繋がれた瞳が突っ込まれ、潤滑液として塗りたくられたポトの油と腸液の混ざり合った液体が溢れてシーツを濡らす。\nデュランは我慢できずこの光景をオカズに自慰行為の最中で、イラスト下部にデュランの男根とそれを扱く手が写る。\nデュランの表情はホークアイの色気に当てられた事が悔しくてならないと目を細めてしかめっ面で、\nホークアイは快楽で頬を染めつつ自慰を始めたデュランの若さをニヤニヤ笑いながら眺めている。\n\n3枚目：デュランの射精後でホークアイに白濁した精液がかけられている。\nアナルパールは引き抜かれたのかいきんで自力で出したのか尻の下に無造作に置かれ、\nぽっかりと広がった孔が物欲しげにひくつく。\n「こっちが誘ってるつもりだったのに、そんなの見せつけられたら我慢できなくなっちゃうよ」とホークアイにねだられ、\nガチガチに勃起するデュランの男根が表示されている。\nデュランの表情カットインは目ではなく口元のアップで、ごくりと唾を飲み込む。\n\nガチエロになってしまいますがお嫌でなければご一考お願いいたします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 100214, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Amirun", "screen_name": "Runami_online", "avatar_url": "https://pbs.twimg.com/profile_images/1339431859621490694/b9s7N7A0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/975693025706885121/1602935859/150