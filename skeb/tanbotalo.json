y_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tanbotalo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3523498, "client_id": 99307, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1cb02ce/uploads/origins/4186531e-ab07-4b1e-991f-1a2f08eb76a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d586d71e5bf1123a6526e84ea1a4de7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1cb02ce/uploads/origins/4186531e-ab07-4b1e-991f-1a2f08eb76a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a922d80b6cf3e6f9b1bc716ad68d7114", "src_set": ""}, "body": "TANBO🌼様、こんにちは。\n\n私のOCのイラストを描いていただけないでしょうか？\nキャラクター図はURLに。\n彼女は小悪魔で、ちょっと生意気なところがある女の子なんです。\nよくイタズラもするけど、本当は悪い子じゃないん。\n\n衣装は簡略化していただいて構いません。\n他には特に指定はありませんので、自由に描いていただけると嬉しいです！\n金額が足りない場合は、再送要請をいただけますと幸いです。\n\nご検討ありがとうございました。\n\nhttps://drive.google.com/file/d/1kt-ggWVP-25xunhtITkV9EcyJ5v5297g/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanbotalo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3523498, "client_id": 3635005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57cd7bfc/uploads/origins/0b48af99-358b-4278-96c0-c6039278ad3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11df7b48d691a7111ade8a0a56bb10a4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57cd7bfc/uploads/origins/0b48af99-358b-4278-96c0-c6039278ad3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c4784f1108d726792b6590524bb7a4f", "src_set": ""}, "body": "TANBOさん、こんにちは！遅ればせながら、お誕生日おめでとうございます！TANBOさんの作品、特にキャラクターのファンタジーっぽい描き方やポーズが大好きです！私のOCのイラストをお願いしたいです。\n\n彼女は悪魔の女王で、死を司り、魂を王国に導き、彼女が好意を寄せる者のために部屋を用意する。ガラス越しに好きな場所を見ることができ、運命に逆らおうとする人間を見て、自分も運命と戦えないかと楽しんでいる。\n\n自信に満ちた笑みを浮かべていることが多いが、自分が支配者であり、ルールに背いた場合は躊躇なく罰することを他の悪魔に思い知らせるような、怖い笑みを浮かべることもある。\n\n人間の魂に対しては優しい表情で現れ、温かい抱擁を与えてから自分の王国へ連れて行き、魂を永遠に休ませる。\n\n血液を黒い水晶のような質感に変え、それで武器を作ることができる。\n\n主な登場ポイントは参考文献に記載。\n\nhttps://drive.google.com/drive/folders/1pYSn_OLcAsNQ3FDCFSyb4PsDsw5_yI4n\n\n彼女が作った武器（彼女は好き嫌いがないので、どんな武器を選ぶかは自由です）を持っていたり、翼を巻きつけていたりと、彼女をかっこよく見せるポーズで描いていただけるとありがたいです（いくつかの例はリファレンスに含まれています）。\n\nご検討のほど、よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanbotalo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3523498, "client_id": 707251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94f65631/uploads/origins/678c5ec0-a3fc-4796-8928-5c5efe1141cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21d36f970d7d860b0dd4dae62dc15407", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94f65631/uploads/origins/678c5ec0-a3fc-4796-8928-5c5efe1141cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=097faf01c49ee0079600c1f46b53d606", "src_set": ""}, "body": "こんにちは！私のOCのためにイラストのリクエストをしてもいいですか？\nあなたのスタイルの色がとても好きです！\n\n🦊 diantha: https://vgen.co/c/dianthus/main-concept\n                         https://sta.sh/2ns56mbctth (バックアップ)\n\n- ポーズはお任せでとても嬉しいです！どうぞ楽しんでください。\n- お値段がもっと必要でしたらリクエストしてください！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanbotalo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3523498, "client_id": 190319, "vtt_url": null, "thumbnail_image_urls": {"src":