て、\n可能あればイラストをお願いしたい。\nギャルマスやギャルシタのアイドルマスターの星井美希が欲しいです。\n例えば、こちらはアイドルマスターの春香のギャルのバージョンです。\n(https://twitter.com/kunikune/status/1641236135073697792?s=20)\nこだわりなポイントは\n1. ダブルカラーの髪。\n2. 長いマニキュア\n3. ギャル服\n4. アイシャドウと口紅\n5. 顔のほくろ(一つだけ十分です)\n\nアクセサリーと詳しいのことがお任せします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uma5um/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 986322, "client_id": 647797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbb07e35c1ff974f5a8df4d0803c97bf", "srcset": "https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbb07e35c1ff974f5a8df4d0803c97bf, https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e71ceb0bb7022023808fe515e58d8e3 2x, https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48564be7d9f37f88b2bdd34259449e59 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1215e9bf0948e87ab7cb99d206a4f2bf", "srcset": "https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1215e9bf0948e87ab7cb99d206a4f2bf, https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fb5be02916c6cff42205b876f473138 2x, https://si.imgix.net/b96f0110/uploads/origins/827ec59c-dc74-4e9e-ad8c-a9de8dca70e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6708a1498d16bc1df2da22aa6948afe8 3x"}, "body": "こんにちは、私はあなたのルカと摩美々がとても好きです。\n私はアイドルマスターシリーズの星井美希というキャラクターをリクエストしたいです。\n\nキャラクターの参考と髪型はこちら(https://mltd.matsurihi.me/cards/1293)で見ることができます。\nこのキャラクターをあなたのスタイルで描いてください。\n1.1.邪悪な笑み\n2.喫煙\n3.濃い目のアイシャドウメイクと目袋\n4.ピアス\n5.服装は自由に描いてください。\n\nリクエストに応えて頂ければ幸いです。\nありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uma5um/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 986322, "client_id": 544657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b469b85/uploads/origins/906ade36-f186-4aa3-a4b6-3f39f5524bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de2f8577f8b11dcaed7d6ad4d62921d9", "srcset": "https://si.imgix.net/9b469b85/uploads/origins/906ade36-f186-4aa3-a4b6-3f39f5524bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de2f8577f8b11dcaed7d6ad4d62921d9, https://si.imgix.net/9b469b85/uploads/origins/906ade36-f186-4aa3-a4b6-3f39f5524bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=960d0c0b619350efcd9d530aad02008a 2x, https://si.imgix.net/9b469b85/uploads/origins/906ade36-f186-4aa3-a4b6-3f39f5524bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2abb8dfcf5a9d9d489900a18ffc079c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b469b85/uploads/origins/906ade36-f186-4aa3-a4b6-3f39f5524bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f32742211a91b9a532b7dc428bfbd5ab", "srcset": "https://si.imgix.net/9b469b85/uploads/origins/9