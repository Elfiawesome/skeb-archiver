す。\n今にも落命しそうな状況ですが、時折痙攣してまだ辛うじて生きている状態です。\n詳細は資料URL記載のGoogleスプレッドシートをご参照して頂ければと思います。\n長くなりましたが以上になります。\nもしよろしければ是非承認して頂ければと思います。\nそれでは失礼致します。\n\nhttps://docs.google.com/spreadsheets/d/1Ul34WBYzgDs8BDZM7XWq1CAdL_Eb5wPpwi_nWjJRWUU/edit?gid=0#gid=0", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nao_11o29/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ba4f91d6/uploads/origins/e5dcc462-878f-4ef1-880e-a68a660d3eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77428f0705543bd58a404e049bee901a", "srcset": "https://si.imgix.net/ba4f91d6/uploads/origins/e5dcc462-878f-4ef1-880e-a68a660d3eec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=77428f0705543bd58a404e049bee901a, https://si.imgix.net/ba4f91d6/uploads/origins/e5dcc462-878f-4ef1-880e-a68a660d3eec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4fbf34d348f04c4a0951c240b325a9fe 2x, https://si.imgix.net/ba4f91d6/uploads/origins/e5dcc462-878f-4ef1-880e-a68a660d3eec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9295d08f384e5e3e533a85ea440ab290 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2077687, "client_id": 2304551, "nc": 48}, {"path": "/@nao_11o29/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2077687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74d0df11/uploads/origins/ef67bb57-b533-4c8a-9204-ab572dc80194?bg=%23fff&auto=format%2Ccompress&fm=webp&fi