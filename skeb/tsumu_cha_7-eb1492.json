____________________________\n\n【参考資料】\n主にYouTubeで活動をしています。セルフ受肉VTuberです。\n歌ってみたや雑談配信、イラスト制作配信などを主にしています。\nHP:https://lit.link/momoyumoyu\nYoutube:https://www.youtube.com/@momoyu_moyu\nTwitter:https://x.com/MomoyuMoyu_\nハートとリボンがモチーフとなったキャラクターです。\n性格やイメージは、可愛く明るい感じのキャラクターです。\n顔は幼め、胸は大きめでお願いします。\nメスガキっぽい雰囲気も似合うと思います。\n\n立ち絵と三面図を送付します。\nご査収ください。\n\n【忘れやすいところ】\n・黒色のネイルをしています。\n・こちら側から見て右胸、左おへそ横、右ふともも(キービジュアルを拡大したら見えます。)にほくろが1つずつあります。\n・イヤリングをつけています。\n・ツインテールの根本と、姫カットの部分にアホ毛があります。\n・前髪にピンをつけています。\n\n【希望イメージ】\nお紡つむ様のイラストが大好きなので、好きに描いていただきたいです。\n\n【納品形式】\n人物と背景を分けた状態のpsd形式\n\n【使用媒体】\n・Youtubeサムネイル\n・Twitterでの宣伝画像\n・Youtubeでの配信、動画内での使用\n\n______________________________________\n\n以上となります。\nよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/4ud1kmsp3jhqwdj106k9u/AKWUc-Ygx-sJsJhr_gGadDg?dl=0&e=1&rlkey=3y3qy91x22kjdzyicu7ky35ey&st=7txkqhow", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsumu_cha_7/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771615, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7faef799/uploads/origins/d19bb1c0-8a7f-497d-ab94-0c68db216aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d4b70eaeade67be33e5f5806e79046e", "srcset": "https://si.imgix.net/7faef799/uploads/origins/d19bb1c0-8a7f-497d-ab94-0c68db216aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d4b70eaeade67be33e5f5806e79046e, https://si.imgix.net/7faef799/uploads/origins/d19bb1c0-8a7f-497d-ab94-0c68db216aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dcd036845be93b7c62b481fad9cace7 2x, https://si.imgix.net/7faef799/uploads/origins/d19bb1c0-8a7f-497d-ab94-0c68db216aa5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00cb4164a71955f3f767523a15c16489 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls"