と嬉しいです。\n\nミナの筋肉質な体つきやおっぱいは可能な範囲で少し強調していただければと思います。\nまたセリフの有無や背景など細部含めアレンジはお好みでお任せいたします。\n（着衣有り無しもお任せしますのでNSFWも有効にしております）\n\nご検討、よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@foxmofumofu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 41954, "client_id": 2026727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5c66f54/uploads/origins/87ff9262-7927-4ebe-874b-28e0407676b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6ec6076128f28e47349af709f79572c", "srcset": "https://si.imgix.net/b5c66f54/uploads/origins/87ff9262-7927-4ebe-874b-28e0407676b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6ec6076128f28e47349af709f79572c, https://si.imgix.net/b5c66f54/uploads/origins/87ff9262-7927-4ebe-874b-28e0407676b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6525e1c78f61b80a1ac53343e302ae0f 2x, https://si.imgix.net/b5c66f54/uploads/origins/87ff9262-7927-4ebe-874b-28e0407676b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e38deabde6487e0c0798a2a487a2f646 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5c66f54/uploads/origins/87ff9262-7927-4ebe-874b-28e0407676b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d718b8d8953cc791d4ec72d149d33034", "srcset": "https://si.imgix.net/b5c66f54/uploads/origins/87ff9262-7927-4ebe-874b-28e0407676b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d718b8d8953cc791d4ec72d149d33034, https://si.imgix.net/b5c66f54/uploads/origins/87ff9262-7927-4ebe-874b-28e0407676b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=974ce2be040269dfc4d8df6f7886a1b4 2x, https://si.imgix.net/b5c66f54/uploads/origins