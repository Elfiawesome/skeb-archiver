外でも構わない。\n\n胸はとても大きく描いてください。青い陰毛は丸見えで濃くしてください。カリカは、恋人が彼女の中に射精するとき、とても興奮しているように見えるはずです。カリカがクライジにクリームパイをあげるように勧める台詞は自由にしてください。胴体の鱗が見える場合は注意してください。尻尾のポーズは自由。\n\nセックスの後、広げた膣から精液が滴り落ちるのをカリカが淫らに眺めるバリエーションも歓迎。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1ql4yYsWUy_oJeswPLRKPi2kvdDXeWeay?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ENKEYES16/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1293748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8ac765a/uploads/origins/09598eaa-d3ac-4ba9-99e0-ec271a7ead28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ce5479d1515da531c0953d51495c5e", "srcset": "https://si.imgix.net/d8ac765a/uploads/origins/09598eaa-d3ac-4ba9-99e0-ec271a7ead28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5ce5479d1515da531c0953d51495c5e, https://si.imgix.net/d8ac765a/uploads/origins/09598eaa-d3ac-4ba9-99e0-ec271a7ead28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cab604cdcdf8b14dc003f9392f36097c 2x, https://si.imgix.net/d8ac765a/uploads/origins/09598eaa-d3ac-4ba9-99e0-ec271a7ead28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0eb02092b37554dc43562413ab211562 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8ac765a/uploads/origins/09598eaa-d3ac-4ba9-99e0-ec271a7ead28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df48c19abfdea90405e0b9b1074cb495", "srcset": "https://si.imgix.net/d8ac765a/uploads/origins/09598eaa-d3ac-4ba9-99e0-ec271a7ead28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df48c19abfdea90405e0b9b1074cb495, https://si.imgix.net/d8ac765a/uploads/origins/09598eaa-d3ac-4ba9-99e0-ec271a7ead28?bg=%23fff&auto=for