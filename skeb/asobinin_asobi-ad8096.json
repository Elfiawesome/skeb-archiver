rop=top&w=200&h=200&blur=200&s=d6179583b038bbe9921acc7e94def16d 3x"}, "body": "最初のミッションで僕のキャラに使ってもらえなかったもう1つの衣装で、違うポーズが欲しいな～。\n\nありがとうございます。\n\nPSO2NGSのOCを描いてくれる\nをお願いしたいのですが、姿勢などはお任せします。\n\n身長は低いはずなので、少し見上げるような感じでお願いします。\n\nまた、できれば、ドヤ顔と自信満々顔の2種類の表情バリエーションが欲しいです。\n\nhttps://drive.google.com/file/d/1hJ8Fl7h0Ng-6qtogIUi2fwUW61QW-BSm/view?usp=sharing\n\nhttps://drive.google.com/file/d/1C4XeoVCNyHtlL2XCPAos_Cr7Ht1n0OiG/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asobinin_asobi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3384856, "client_id": 1231709, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/492aa5be/uploads/origins/55244093-0ae4-442c-b418-e1183b34029e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7df670f5118a95b4186d5794cbc56acd", "srcset": "https://si.imgix.net/492aa5be/uploads/origins/55244093-0ae4-442c-b418-e1183b34029e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7df670f5118a95b4186d5794cbc56acd, https://si.imgix.net/492aa5be/uploads/origins/55244093-0ae4-442c-b418-e1183b34029e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97ef287f13e50e21f7f976018af68ee0 2x, https://si.imgix.net/492aa5be/uploads/origins/55244093-0ae4-442c-b418-e1183b34029e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fd8da160fedcb415f193dba07f1d89f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/492aa5be/uploads/origins/55244093-0ae4-442c-b418-e1183b34029e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fee2c308d64dd6541470d98fbb4d92b", "srcset": "https://si.imgix.net/492aa5be/uploads/origins/55244093-0ae4-442c-b418-e1183b34029e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200