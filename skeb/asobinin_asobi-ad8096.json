の要望\n背景があると嬉しいです。 \nその他のポーズ・構図やシチュエーション等はお任せいたしますが、目が特徴的なため顔がしっかりと映えるようにお願いしたいです。\n\nPSDファイルはキャンバスサイズ大きめ(フルHD以上)で、レイヤーが分かれていると助かります。\n (キャラクター/背景/サイン　など)\n\n・使用用途 \nSNSやVRChatのアイコン・サムネイル、PC・スマホの壁紙等の私的利用(非商用)\n\n何か問題がございましたら差し戻し下さい。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1C3qQoeDCskoeFT0hgQXxD8b9v4GH7uvn?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 551681, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あきお🐾", "screen_name": "torigasukida", "avatar_url": "https://pbs.twimg.com/profile_images/1932106877296660480/9I-SWexT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/173666492/1721926083/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 659585, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "NOU4", "screen_name": "nou4_777", "avatar_url": "https://pbs.twimg.com/profile_images/1656989181472825344/JEGhgep4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1154666120554532864/1683891333/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2660073, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "■", "screen_name": "yas_me4", "avatar_url": "https://pbs.twimg.com/profile_images/2029590755480899584/yzqfKeA8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1277221048761462784/1725146733/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null