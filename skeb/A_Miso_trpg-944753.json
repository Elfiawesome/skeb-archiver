】\n気が強く傲慢であり、こだわりが強い。\n1度自分が思った事はなかなか曲げない所がある。頭がとてもいいため\"私が言ったもの思ったものが全て正しい\"という思想がある。そのため、何かしら否定されると癇癪を起こす可能性がある。\n「みんな私よりも頭が悪いから格下」だと思っている。\n\n 希望のシチュエーションは思い通りにいかなかった莉愛を頭を撫でながら励ましてる大工廻をみたいです！\n兎美、大工廻両方とも服装アレンジ大歓迎ですよろしくお願いします。\n\n2人の場合の料金が分からなかった為、足りない場合は言ってもらえると助かります、増やしてリクエストしに行きます！\n\n詳細URL↓↓↓\nhttps://drive.google.com/drive/folders/17-jtRMVquUj1wLt0oBm656c7qR7JSncx", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@A_Miso_trpg/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3596049, "client_id": 3596103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69bc4c8b/uploads/origins/a684405e-55d7-4c75-8305-cc0ded34ead9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d353a0a361e0b4ad143451096adb2e", "srcset": "https://si.imgix.net/69bc4c8b/uploads/origins/a684405e-55d7-4c75-8305-cc0ded34ead9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d353a0a361e0b4ad143451096adb2e, https://si.imgix.net/69bc4c8b/uploads/origins/a684405e-55d7-4c75-8305-cc0ded34ead9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc5e2e6d8573759195468e717a9e6345 2x, https://si.imgix.net/69bc4c8b/uploads/origins/a684405e-55d7-4c75-8305-cc0ded34ead9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc84595a1a916f011cef36e0dee18276 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69bc4c8b/uploads/origins/a684405e-55d7-4c75-8305-cc0ded34ead9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39b11a2b97740ad2c072a4b256efde1c", "srcset": "https://si.imgix.net/69bc4c8b/uploads/origins/a684405e-55d7-4c75-8305-cc0ded34ead9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39b11a2b97740ad2c072a4b256efde1c, https://si.imgix.net