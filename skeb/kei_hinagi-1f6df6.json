とココアです。\n\nお描きいただける場合、可能であればサムネイルやアイコンなどの活動に利用させていただきたく、人物だけ透過したファイルをいただけますと幸いです。\n\nリクエスト受領のご検討、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/15BKbfueGRuG-ctjI9Cr8aJ2YoBb3yIVS/view?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kei_hinagi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2189186, "client_id": 2489791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b27804b6/uploads/origins/3c6da0ac-ce8b-4276-99cc-394c24c700c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeabf9fa3806b33c01c7bb2fbd7c3712", "srcset": "https://si.imgix.net/b27804b6/uploads/origins/3c6da0ac-ce8b-4276-99cc-394c24c700c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eeabf9fa3806b33c01c7bb2fbd7c3712, https://si.imgix.net/b27804b6/uploads/origins/3c6da0ac-ce8b-4276-99cc-394c24c700c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40de350e0330f767b015975075811422 2x, https://si.imgix.net/b27804b6/uploads/origins/3c6da0ac-ce8b-4276-99cc-394c24c700c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0577f6e5cb96358af8ecb74e0a2d640 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b27804b6/uploads/origins/3c6da0ac-ce8b-4276-99cc-394c24c700c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a9b185c21719e6f5ba1468c8e43b375", "srcset": "https://si.imgix.net/b27804b6/uploads/origins/3c6da0ac-ce8b-4276-99cc-394c24c700c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a9b185c21719e6f5ba1468c8e43b375, https://si.imgix.net/b27804b6/uploads/origins/3c6da0ac-ce8b-4276-99cc-394c24c700c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=965c53c52a79f099c2722