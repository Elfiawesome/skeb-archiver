 so much!   (〃￣︶￣)人(￣︶￣〃) 💖\n\nhttps://drive.google.com/drive/folders/1E9QkW79ydro0VrmkU-BOdgdOr6e3ch8d?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Psydeworks/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d25c3127/uploads/origins/20e45786-0c8d-4b86-b933-ced64ad21f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea98a713fe99dd0dd6c99d2a3429ded0", "srcset": "https://si.imgix.net/d25c3127/uploads/origins/20e45786-0c8d-4b86-b933-ced64ad21f64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ea98a713fe99dd0dd6c99d2a3429ded0, https://si.imgix.net/d25c3127/uploads/origins/20e45786-0c8d-4b86-b933-ced64ad21f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a48e4872c35619770c69608d367c381c 2x, https://si.imgix.net/d25c3127/uploads/origins/20e45786-0c8d-4b86-b933-ced64ad21f64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=518e7e807837dc8986953c1b37734181 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 665615, "nc": 144}, {"path": "/@Psydeworks/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 665615, "client_id": 3033136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d876b870/uploads/origins/5db7c606-1429-459e-84f2-657d1bd907b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29f1b3099fb8ba26121859a394143291", "srcset": "https://si.imgix.net/d876b870/uploads/origins/5db7c6