c54b5a-79ed-459b-9082-65e184aae712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d38164d2c4ed350bad0169ebbdf54ea0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a25cb82/uploads/origins/8ac54b5a-79ed-459b-9082-65e184aae712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f582bc33611bacf353d413db33198c2e", "srcset": "https://si.imgix.net/5a25cb82/uploads/origins/8ac54b5a-79ed-459b-9082-65e184aae712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f582bc33611bacf353d413db33198c2e, https://si.imgix.net/5a25cb82/uploads/origins/8ac54b5a-79ed-459b-9082-65e184aae712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1678e9f0b22f27981d372288afc4d65c 2x, https://si.imgix.net/5a25cb82/uploads/origins/8ac54b5a-79ed-459b-9082-65e184aae712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72376463631551270f6c4235a36ed211 3x"}, "body": "はじめまして！\nSkebの新着で艶やかなお肌が好みでしたのでリクエストを送らせて頂きます。\n\n◆キャラクター\n天穹ノ彼方の錬星郷(ソラカナ)というDMM/FANZAで提供されていた（終了済）ブラウザゲームのキャラクターのジルダ・デルプランクさんです（資料参照）。\n\n\n◆シチュエーションや構図\n・大胆な黒猫なハロウィン衣装で主人公の男の子いっぱいいちゃらぶえっちえっちした後、最後に猫尻尾アナルバイブと猫耳カチューシャだけ残してのとろとろえっち。\n・ベッドの上での対面座位でお顔と胸が見えるような構図で、猫尻尾アナルバイブを掴まれてぐいぐい掴んでいるのが分かる感じで。\n・男性の描写は最小限でOKです。\n・ハート目だったり、えっちな擬音やエフェクトなどあれば是非お願いします。\n\n◆差分\n①蕩けたお顔でまだちんちんが大きいことに微笑んで\n②激しいピストンとバイブ責めで蕩けて（中出し射精前）\n③中に思いっきり射精されてトロ顔絶頂 （中出し射精中）\n④幸せそうに脱力（中出し射精後）\n\n・お好みで胸など盛っても結構です。\n・宛名はレイヤー別でお願いします\n\n以上、他詳細な所は全てお任せいたします。\n\nhttps://drive.google.com/drive/folders/1xOtt1I9Yw4BEy8kfLrHSLvVXVV8jkdd0?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurusu_f/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2498236, "client_id": 7823, "vtt_url": null, "thumbnail_image_urls": {"src": "http