m/playlist?list=PLeGdDFmyZIDVkqZ_g_tkU1HbLugVyhLrX&si=aGzhI7rw70mj9mzJ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumanobansoukoo/works/105", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1533109, "client_id": 1096448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea2e4dd27191edddb0fa051a92940fc", "srcset": "https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ea2e4dd27191edddb0fa051a92940fc, https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57b210ea0642ef13e984d03249b26fff 2x, https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13d099e73a478bf91660520d3e5453f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdbdf30142ae011e54dfb68be7e51d5c", "srcset": "https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdbdf30142ae011e54dfb68be7e51d5c, https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=129754504e1a64765148e2a2c93f7d28 2x, https://si.imgix.net/7384f59e/uploads/origins/328d6eb1-582c-4f17-97ce-4b955fe48431?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c38ca3e637ec590270859e3a7b1118e9 3x"}, "body": "初めまして。\n個人VTuberをしております、両声類謎紳士 月華と申します。\nクマの絆創膏さんが描くむちむちのイラストが大好きで、今回依頼させて頂きました！\n人外ではありますが、是非私のイラストを描いて欲しいです。\n諦めきれず、再度リクエストさせて頂きます。\n\n私は立ち絵ではスラッとしておりますが、潰しているだけでお胸があるという設定です。\n男でも女でもあるので、両性具有（いわゆるふたなり）で、お胸もあれば下もあるのですが……。\nくびれがきゅっとしていれば特に問題ないので、お胸もおしりもむっちりおっきく描いて欲しいです！\nシチュエーションはお任せします。\n\nあと細かいのですが顔についてです。\n基本的に横顔はNGで、口の形は口角が上がったまま変わらない形となります。鼻と耳はありません。\nややこしいデザインで申し訳ないです。\n個人的に動画のサムネイル等でも使えたら……と思うので、透過差分も頂けると幸いです……！\nリクエストが多くて恐縮ですが、何卒よろしくお願い致します。\n\n参考画像となります。よろしくお願い致します。\nhttps://x.com/gekkaguren/status/1667813006208806912?s=20\nhttps://x.com/gekkaguren/status/1722259670545654084?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@liangpe_15/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1760178, "client_id": 1096448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67e3c4d8/uploads/origins/d03f3367-d290-4351-8a72-6be2f8894f81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f877633913954f2cb70e5d3e5bcec308", "srcset": "https://si.imgix.net/67e3c4d8/uploads/origins/d03f3367-d290-4351-8a72-6be2f8894f81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f877633913954f2cb70e5d3e5bcec308, https://si.imgix.net/67e3c4d8/uploads/origins/d03f3367-d290-4351-8a72-6be2f8894f81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa9a7aaba6df993914aba28f7da83cd2 2x, https://si.imgix.net/67e3c4d8/uploads/origins/d03f3367-d290-4351-8a72-6be2f8894f81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f40d2bf0428028c7b8d989a1dd0cf7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67e3c4d8/uploads/origins/d03f3367-d290-4351-8a72-6be2f8894f81?bg=%23fff&au