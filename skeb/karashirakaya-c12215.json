での使用\n※グッズ等への使用は致しません。\n\n■納品形式\n透過pngもしくはpsdデータでいただけますと嬉しいです。\n\nお忙しいところ恐れ入りますが、何卒ご検討の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/19KmWo_pXm36nWE3hqlCntrGGiPU2QHZM", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K_shiokara/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2401246, "client_id": 3583783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c50c697/uploads/origins/e1ee4774-1dc2-4e02-8e0a-3351e0a11605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=693fb9f741eaaf62e489c8c3d30e410a", "srcset": "https://si.imgix.net/0c50c697/uploads/origins/e1ee4774-1dc2-4e02-8e0a-3351e0a11605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=693fb9f741eaaf62e489c8c3d30e410a, https://si.imgix.net/0c50c697/uploads/origins/e1ee4774-1dc2-4e02-8e0a-3351e0a11605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb9163263241b525476d784f15e06c35 2x, https://si.imgix.net/0c50c697/uploads/origins/e1ee4774-1dc2-4e02-8e0a-3351e0a11605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfcac02544cbdf6e34d058c76a9c309f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c50c697/uploads/origins/e1ee4774-1dc2-4e02-8e0a-3351e0a11605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc87a3d83b41296c8a311f0960e70cd3", "srcset": "https://si.imgix.net/0c50c697/uploads/origins/e1ee4774-1dc2-4e02-8e0a-3351e0a11605?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc87a3d83b41296c8a311f0960e70cd3, https://si.imgix.net/0c50c697/uploads/origins/e1ee4774-1dc2-4e02-8e0a-3351e0a11605?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67c02c93937bc7b0c855fac04a2ccb85 2x, https://si.