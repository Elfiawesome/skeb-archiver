0&h=200&s=27113ee74f0de5bd89c5c779332329a8", "srcset": "https://si.imgix.net/ee66730e/uploads/origins/55919bf4-49d0-4a5f-832d-bf7b18c633a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27113ee74f0de5bd89c5c779332329a8, https://si.imgix.net/ee66730e/uploads/origins/55919bf4-49d0-4a5f-832d-bf7b18c633a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff3314416328708dbe2e1c1272aac5ee 2x, https://si.imgix.net/ee66730e/uploads/origins/55919bf4-49d0-4a5f-832d-bf7b18c633a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83e427854e5df6c2ab5f5bf443f353e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee66730e/uploads/origins/55919bf4-49d0-4a5f-832d-bf7b18c633a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98c8f772cf90858c375881b2d30e41ce", "srcset": "https://si.imgix.net/ee66730e/uploads/origins/55919bf4-49d0-4a5f-832d-bf7b18c633a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98c8f772cf90858c375881b2d30e41ce, https://si.imgix.net/ee66730e/uploads/origins/55919bf4-49d0-4a5f-832d-bf7b18c633a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1137877855dc36af026d995845154a0 2x, https://si.imgix.net/ee66730e/uploads/origins/55919bf4-49d0-4a5f-832d-bf7b18c633a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5335e389720a5dd5ee5a1afdd4c33822 3x"}, "body": "否す様\nはじめまして！白茅からしと申します。\nXでとても素敵な2人組SDのポストをお見掛けして、ぜひご依頼したいと思い、TRPGで使用しているOCのコンビをリクエストさせていただきます！\n以下詳細です。\n\n■1人目　\n高校2年生 / 男\n明るく元気で周囲から好かれる。\n甘いものが好きで常に棒付きキャンディを持っている。大型犬のような感じの雰囲気。遅刻や居眠りが多く、先生によく怒られている。\n見た目の特徴→金髪・オレンジ目、キャンディーのピン、双葉のアホ毛、耳にピアス穴、首にチョーカー\n\n■2人目\n高校2年生 / 男\n引っ込み思案で、人と話すことに苦手意識がある。気弱というわけではないので仲良くなれば普通に話せる。\n長い前髪と眼鏡でなるべく顔を隠している。音楽が好き。音楽を聴いて外の音をシャットアウトしている。\n自分にも話しかけてくれる↑とは普通に話せる、彼に振り回されつつ世話を焼いたりしている。\n見た目の特徴→暗い紫の髪・紫の目、眼鏡、目のハイライトが〇、右目の下にホクロ\n\n■2人の関係性\nお互い大切に思っています。友達以上恋人未満みたいな距離感です。\n少なくとも2人目の方は1人目の彼にかなり依存している部分があり、いないと生きていけないと思ってます。\n\n\n\nーーーー\n\n使用用途\n相方PLへの共有、SNSへの掲載・アイコンやヘッダーなどへの使用(相方PL含む）、配信での使用\n（もし問題が無ければ）個人で楽しむ範囲のグッズ制作\n\n長々と失礼いたしました。添付資料も合わせてご確認ください。\nご検討いただけますと幸いです。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1blca7SOMLN-gIXI4RwMLkjq6LaNE08Nc", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K_shiokara/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2401246, "client_id": 3583783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242044dabe2d3f4592b90615049e2507", "srcset": "https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242044dabe2d3f4592b90615049e2507, https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df98b5447e86ce9da3d5c8570d6771d3 2x, https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5017dcfe36f2df6c54930d2d8f800008 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22b352e0c7aa1742de4882811ebb3945", "srcset": "https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22b352e0c7aa1742de4882811ebb3945, https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df63e1626a539601413accdaea66eeec 2x, https://si.imgix.net/beef3e18/uploads/origins/f69f6b36-bc79-4f3d-88fe-b6d8dcaae4c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6e8e135a9aad201307258c34bf6e4d8 3x"}, "body": "しおからさんこんにちは！いつも大変お世話になっております。\n\n私のTRPGの探索者のイラストをさせていただきます！\n服装や構図などはお任せします。\nキャラクターデザインは資料をご参照ください。\n\nーーーーー\n\n通過シナリオ『海も枯れるまで』\n名前：灯浬夕帆\n性別：男\n職業：高校生（通信制）\n年齢：シナリオ開始時15歳→現在16歳\n身長：シナリオ開始時170cm→174cm\n\n元気で素直。海が好き。珊瑚さんと一緒に住んでいて、とても慕っている。家で家事などをしながら、通信制の高校に通っている。\n\n■見た目の特徴\n八重歯とアホ毛が特徴？チャームポイント？です。\n目は真ん中が白抜きハイライトで、なみなみ？の線で上と下の色が分かれてます。（海と太陽のイメージです）\n\n立ち絵の服装のクセがだいぶ強いですが、ファッションセンスが無い訳では多分ないです。（というか普段は珊瑚さんが選んでくれるのでもう少しまともなセンスの服を着てるはずです）\n多分ストリート系とか、スポーティーな私服が似合うのかな～と思っています。\n服装も構図もお任せするので、好きに描いていただけば幸いです！\n\n（※以前MUKUのSkebリクエストで描かれていた探索者の相方です）\n\nーーーーー\n\n■使用用途\nSNSでの使用、配信での使用（みんなに見せたい！）、相方PLへの共有\n自分で楽しむ用の私的なグッズの制作\n\n\n料金不足でしたら再送していただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14XBv5su703i6dDELXDtyhR69xt8u3Nz4", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Aputto_9/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3016809, "client_id": 3583783, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e98beebd/uploads/origins/19964473-f933-439d-b797-e48f7e9a87d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71056f0e5549353b345047215b89fcf1", "srcset": "https://si.imgix.net/e98beebd/uploads/origins/19964473-f933-439d-b797-e48f7e9a87d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71056f0e5549353b345047215b89fcf1, https://si.imgix.net/e98beebd/uploads/origins/19964473-f933-439d-b797-e48f7e9a87d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200