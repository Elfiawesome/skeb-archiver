g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74334ce0cca71a458044bb3b3bc8738f 3x"}, "body": "前回描いていただいたイラストは本当に素晴らしかったです！今回も、私のOCのイラストを描いていただきたく、お願いに参りました。キャラクターは前回描いていただいたソ連の少女将校と政治委員です。\n\n（https://skeb.jp/@munashichi/works/9）。\n\nただし、今回は雪に覆われたロシアを舞台にしてほしい。ルジェフ記念館もコンクリートジャングルも雪に覆われている。厚着をしたOCの2人が、大雪の中で時空を超えたかのように見つめ合う--雪の中の再会。\n\n2人のOCの具体的な姿はリンク先で見ることができる。ルジェフ記念館とソビエト建築の参考文献もリンク先にあります。あなたの創造力を自由に発揮してください！凍てついた広大なコンクリートの風景の中で、この2人の出会いを強調してください。ソビエト風のロマンスを感じさせるように！\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-Pq0WmP7GLjvSIdmqQg8lUbJEd8f88bx\n\nhttps://drive.google.com/drive/folders/1ZcEnw4JKAKjpbL2oP8kyN0_KcH90_kcX?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@munashichi/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2619046, "client_id": 2813992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d94d0025eeda5a979b558ef3f0e738a7", "srcset": "https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d94d0025eeda5a979b558ef3f0e738a7, https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5db5a93422c108724ad787131fca200b 2x, https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0b7ff86c146e27d4ce07f842c3e8805 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8165da6e1376d89ce553dca2440696c5", "srcset": "https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8165da6e1376d89ce553dca2440696c5, https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=29b914ed234442b7c8e1252d7138ecad 2x, https://si.imgix.net/84118c26/uploads/origins/85d283ec-c2f2-450c-b293-27728c101d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=378acdaa6ebd100f4684d98a81c0caf3 3x"}, "body": "こんにちは！\n\n先生の描いた風景と建築物がとても好きです！だから、私のオリジナルキャラクターを描いてほしいと思います。 \n\nhttps://drive.google.com/drive/folders/1-VUpdOMLYFgVaEO0isdKpCWJO2otnf5T\n\n背景をメインにしたいと思っています。キャラクターは植物でいっぱいの大きな廃墟の中にいる絵です。廃墟は西洋風の建物（城など）でも現代都市（工場、市街地）でも構いません。自由に選んでください。\n\n使用用途：壁紙、個人的なコレクションのみの印刷（配布されません）\n\nご検討いただきありがとうございます！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@munashichi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2619046, "client_id": 1659096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc8cf91e89b2678a11e4b7853795ec00", "srcset": "https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc8cf91e89b2678a11e4b7853795ec00, https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33767a2503d23a83580642683f1cefd0 2x, https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dee59ad508739dec32c0f45a68766bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0943459d365ef049d0ff99d22e2ba2e4", "srcset": "https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0943459d365ef049d0ff99d22e2ba2e4, https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43d1ffa97e94cf10676ad936fe79deae 2x, https://si.imgix.net/dffb5a82/uploads/origins/e6c3e96a-ffe2-4f93-8bda-9a1a632eabb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b51ccbf6fe91577d1c0a5107a67a3ccf 3x"}, "body": "六七質先生、初めまして！\n個人VSingerのAurenthelと申します。\n先生の世界観に惚れて、もし宜しければ、私のキャラクターのイラストをお願い頂けますか？\n\n歌ったり絵を描いたりするのが好きな穏やかで神秘的なキャラです。\nとても頼りになり、よく他人のお世話をします。\n中華伝説の人魚に基づく、涙は真珠になります。\nモチーフは黒金魚、水墨画、真珠とお水です。\n\nスケブの中に、先生のこの作品が特に好きです：\nhttps://skeb.jp/@munashichi/works/4\nこの様なファンタジー古代な中華街をお願いできますか？\n人魚に基づいたキャラデザなので、水中も可能です！\n先生が他の発想があれば、是非ご自由に描いてください！\n構図等全部お任せ致します。\n\n可能でしたら宛名、背景、人物でレイヤー分けのpsdを頂けますと幸いです。\n\nイラストを配信、SNS、投稿等で使用させていただく予定です。\n\nご縁がありましたら、どうぞ宜しくお願い致します！\n\nhttps://drive.google.com/drive/folders/10rVTX7cY9urPa4hCLAtDR4tJ55PZnors?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@munashichi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2619046, "client_id": 1418548, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7748581/uploads/origins/8c2f35c6-aba6-4da8-ac6f-f72e8a350cdf?bg=%23fff&au