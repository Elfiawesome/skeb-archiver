少年：\n- 弟\n- 賢く、親切だが慎重な性格。少し生意気なところもあるが、兄ほどではない。\n- 緑色のパーカー（参考資料で提供）を着て、フードを下げた姿でお願いします。\n\nポーズと背景はお任せします。ライブ配信やSNSで使用させていただく場合があります。その際はクレジットを記載させていただきます。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1SydD1LLgTifZTo09pLP_-vtisau0NeZB?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sky_yoichi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2066766, "client_id": 3013504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67e0934e/uploads/origins/eeb16628-e2d6-4b80-9a31-f2ab80c388f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00bc9e834680230ecd76e9c9284eaf7d", "srcset": "https://si.imgix.net/67e0934e/uploads/origins/eeb16628-e2d6-4b80-9a31-f2ab80c388f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00bc9e834680230ecd76e9c9284eaf7d, https://si.imgix.net/67e0934e/uploads/origins/eeb16628-e2d6-4b80-9a31-f2ab80c388f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d45f9b51c41b1462cd7fbf0856d6cca7 2x, https://si.imgix.net/67e0934e/uploads/origins/eeb16628-e2d6-4b80-9a31-f2ab80c388f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44e69ebdf541bde1ff332aedd38c8cdc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67e0934e/uploads/origins/eeb16628-e2d6-4b80-9a31-f2ab80c388f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f74b392029aea2dcca3e5e8b58c2801", "srcset": "https://si.imgix.net/67e0934e/uploads/origins/eeb16628-e2d6-4b80-9a31-f2ab80c388f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f74b392029aea2dcca3e5e8b58c2801, https://si.imgix.net/67e0934e/uploads/origins/eeb16628-e2d6-4b80-9a31-f2ab80c388f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=c