ub.vroid.com/characters/4921369108043309203/models/7567822644843755198\n\nうちの子のどちらか興味を持たれた方のイラストをお願いしたいです\n衣装は下記の中から描いてみたいものを選んでください\n①通常制服姿\n②スク水姿(旧スクor競スク肩紐白)※スク水はセパレート型やスパッツ型、ハイレグ化、魔改造NG\n③競泳水着姿（極端なハイレグNG。色などデザインはお任せ)\n④スカート付きスク水姿（資料内にあるような紺色でスポーティーなタイプのものを参考に。細かなデザインはお任せ）\n⑤ワンピース水着姿（資料内にあるようなフリルやフレアが付いたおしゃれ・かわいい系の水着を参考に。細かなデザインはお任せ）\n⑥私服姿（似合いそうなものを自由に）\n\nその他のポーズや構図、背景など細かな部分はお任せします\nご検討いただけますと幸いです。よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1d3WIZa5D-1Thv4OZucI5VmW4WRBIp_Ok?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yusa_yuyu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4028518, "client_id": 165172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d2d69ee/uploads/origins/163be319-d7fd-4d7e-8c1f-5d048573f750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb98d1eeca24a944c5c234e1259cf0bf", "srcset": "https://si.imgix.net/4d2d69ee/uploads/origins/163be319-d7fd-4d7e-8c1f-5d048573f750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb98d1eeca24a944c5c234e1259cf0bf, https://si.imgix.net/4d2d69ee/uploads/origins/163be319-d7fd-4d7e-8c1f-5d048573f750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a18846fcc4177e88f398fb62f1078f 2x, https://si.imgix.net/4d2d69ee/uploads/origins/163be319-d7fd-4d7e-8c1f-5d048573f750?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d7bba8d536973817e9123b1284adffa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d2d69ee/uploads/origins/163be319-d7fd-4d7e-8c1f-5d048573f750?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc1bfc00c2884098b03f2164b214c6c0", "srcset": "https://si.imgix.net/4d2d69ee/uploads/origins/163be319-d7fd-4d7e-8c1f-5d048573f750?bg=%23fff