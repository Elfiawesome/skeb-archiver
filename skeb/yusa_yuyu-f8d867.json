こだわりがございますので、ご留意いただけますと幸いです🙏\n・3:7分けの前髪\n・二つに分かれたハイポニーテール\n・サイドのキツネ耳のような髪の束×2\n・ピンクと水色のハイライト\n\n衣装デザインと構図につきましては、すべてしょうゆさC様のご自由な感性にお任せいたします。💫\nお手数なさらず、どうぞお好きなようにお描きいただければ、それが何より嬉しいです。\n\n参考資料もご用意しておりますので、よろしければご覧くださいませ。\nhttps://drive.google.com/drive/folders/1c-llNNoYufSnaj8mncdt6RaTh1qEkgp7\n\nお忙しいところ大変恐縮ではございますが、ご検討いただけますと幸いです。😊\n\n何卒よろしくお願い申し上げます。🙇‍♀️✨\n\nhttps://drive.google.com/drive/folders/1c-llNNoYufSnaj8mncdt6RaTh1qEkgp7", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yusa_yuyu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4028518, "client_id": 52048, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/530eff91/uploads/origins/3d620cc7-a494-4ab9-bd3e-b80e50b51710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=613a38374b6ac4b26c5464171d803f04", "srcset": "https://si.imgix.net/530eff91/uploads/origins/3d620cc7-a494-4ab9-bd3e-b80e50b51710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=613a38374b6ac4b26c5464171d803f04, https://si.imgix.net/530eff91/uploads/origins/3d620cc7-a494-4ab9-bd3e-b80e50b51710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca81353d2afdcf5729c0c4dc44161a40 2x, https://si.imgix.net/530eff91/uploads/origins/3d620cc7-a494-4ab9-bd3e-b80e50b51710?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7244ed488628b032be625d359b60ed56 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/530eff91/uploads/origins/3d620cc7-a494-4ab9-bd3e-b80e50b51710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=032c830b50db806a04520b7e56c2c0b7", "srcset": "https://si.imgix.net/530eff91/uploads/origins/3d620cc7-a494-4ab9-bd3e-b80e50b51710?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=20