ivate": false, "genre": "art", "tipped": true, "creator_id": 1197067, "client_id": 3679346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04cfe67b/uploads/origins/f623e7f4-deb3-4c2c-a1d7-7e092755a2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cec9aa458697d49de219b5386150fa60", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04cfe67b/uploads/origins/f623e7f4-deb3-4c2c-a1d7-7e092755a2ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82d94b2b1801544ebddec73065278c27", "src_set": ""}, "body": "岸田メルさん、猫目石アンナと申します。\nずっと岸田メル先生のファンで、『アトリエ「アーランド」シリーズ』、『BLUE REFLECTION』などのゲームをプレイしていました。そこで『Flower Knight Girl』というゲームの「ススキ」というキャラクターキャラクターを描いていただきたくご依頼させていただきました。\n■ご依頼内容\nススキはウサギパーカーを着た、金髪おさげの女のコなのですが、引っ込み思案で人見知りだけど、仲良くなれば元気な女のコです。そのススキが「団長さん！ おはようございます！」（セリフ文字入り）と元気にパッとした笑顔で言っている感じで描いていただけませんいでしょうか。\n\n■使用用途\nスマホとパソコンの壁紙として使用させていただきたいです。\nSNS（X）でも作品を紹介させていただく予定です。\n\n■サイズ\nパソコン用壁紙として使用するため、サイズは2560×1440pxでお願いできますでしょうか。\n\n◆参考資料\nhttps://fkg.jugem.jp/?eid=1234\n\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mellco/works/372", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1d4e6a63/uploads/origins/94770976-ffd0-4f6b-b2d5-377c11f6a437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=30d2443613af974383015c5d8927e569", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1197067, "client_id": 3670080, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mellco/works/371", "private_thumbnail_im