0&h=200&blur=200&s=7bdb52e5826f65250b2e3a290c32b2ee", "src_set": ""}, "body": "こんばんは！この約1年コミッションを通じて素敵なイラストを描いていただき本当にありがとうございました！\n今年最初のリクエストをさせていただきます。\n\n「かわいいサキュバスの女の子」を2人描いていただきたいです。\n2人ともツノは小さめ、短めでお願いします。\n今回も前回描いていただいたイラストのように横長のイラストにしていただきたいです。\n\n以下、簡単なプロフィールになります。\n\n1人目(姉)\n年齢　17〜19位\n胸　　大きめ\n性格　明朗で快活\n\n2人目(妹)\n性格　穏和\n身長　姉より5〜10cm位低い\n\n\n服装　2人ともカラフルで可愛くしてください。\n\n\nその他の事は背景を含めてrisumiさんに全てお任せいたしますのでrisumiさんのご自由に楽しく描いていただきたいたいです。\n\n\n(金額とお時間的に可能であればで構いませんので、差分で「2人ともメガネ」をかけているイラストも描いていただきたいです。ご検討の程よろしくお願いします。)\n\n今年もどうぞよろしくお願いいたします🙏", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@risumilk/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 206955, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b40d8f50/uploads/origins/4000b30a-ac24-4fb3-9a8f-806cb28c8609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87e4620563f45bb23df3b451a32d5a93", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b40d8f50/uploads/origins/4000b30a-ac24-4fb3-9a8f-806cb28c8609?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98255b241ea205a81eaa071898ad177b", "src_set": ""}, "body": "リクエストお願いします。\n資料URLの写真のコスチュームを身に着けたKOS-MOS Re:のイラストです。\n無表情で「こうでしょうか？」と言ってそうな感じで少し首をかしげてます。それ以外のポーズはお任せします。へそと胸部、大腿部がよく見えるものであればokです。\n原典の各部ファー、しっぽ、付け耳の色は紫ですがKOS-MOSに合わせて白でお願いします。ブーツや手袋の色もKOS-MOSに合う色に変えてください。\nあまり関連の無い組み合わせで恐縮ですが、以前のrisumiさんの作品でゼノサーガEP3スイムスーツのKOS-MOS Re:やFGOイシュタルのイラストを見てこの題材はrisumiさんに描いてもらうのが一番良いと思い依頼しました。ご検討をお願いします。\n\nhttps://imgur.com/a/OBmnQ7q", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@risumilk/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 206955, "client_id": 415528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1626e228/requests/195031_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25fe8b867e9016e982a77d23bf157e94", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1626e228/requests/195031_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4040d8cfb786d7c06a480c2a4671a4c", "src_set": ""}, "body": "リクエストさせていただきます！\n創作で一枚絵を描いていただきたいです！\n\n・テーマ\n「ファンタジーな世界観のRPG世界を旅(冒険)する一行」\n\n・キャラクター\n主人公「男性　かっこいい剣士　年齢17歳位の少年」\nヒロイン「かわいい魔法使いの女の子　年齢17歳位の少女」\n装備や服装などはお任せします。\n\n金額的に可能でしたら3人目以降のキャラクターも描いていただきたいです。\nその際の性別、年齢、装備、服装、種族等全てお任せいたしますのでご検討いただければ幸いです。\n\n御本の表紙のみのりちゃんやツインテールのヒカリちゃん、昨日のメレフ様の塗り方がとても綺麗で素敵でしたのでそのような塗りにしていただけるととても嬉しいです！！\n\n今使っているタブレットの壁画に使わせていただきたいと思っています。\nいつも横向きで使用しているので、もし可能でしたら以前投稿していた「ウェディングビキニのプネウマ」のイラストのように横長のイラストを描いていただきたいです。\n\nその他の事は背景含めて全てお任せいたしますのでご検討のほどよろしくお願いします。明るく楽しく、見ていてワクワクする一枚をお願いします！\n\n\n\nフォロワーさん1万人到達本当におめでとうございます！！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 101591, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "YahaKo やはこ", "screen_name": "yahako", "avatar_url": "https://pbs.twimg.com/profile_images/1942779600310046720/uOGWTYc8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/20900940/1724505711/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 17}, {"id": 374059, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "黒井みめい", "screen_name": "mi_me_i", "avatar_url": "https://pbs.twimg.com/profile_images/1959768657271324672/9Xuiyivn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/106860350/1512