のもpsdでいただきたい、画面外で切れてしまった髪や体も可能な範囲で描いていただきたいです。（動画を作る際にとても助かります。）\n\n  参考資料としてキャラクターデザインを添付させていただきます。\n ご検討いただけましたら幸いです。\n よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-OM_GZppN4nP80AuwJGBVLXXn6RqXOK2", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ame612_k/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 931064, "client_id": 1127616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f894170e/uploads/origins/9608206b-4133-4025-b175-e59e177fa1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=467d4a68f294c47795e7c9220062f223", "srcset": "https://si.imgix.net/f894170e/uploads/origins/9608206b-4133-4025-b175-e59e177fa1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=467d4a68f294c47795e7c9220062f223, https://si.imgix.net/f894170e/uploads/origins/9608206b-4133-4025-b175-e59e177fa1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a50f34e28bff39e173b50320552cd6e 2x, https://si.imgix.net/f894170e/uploads/origins/9608206b-4133-4025-b175-e59e177fa1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f39bf459664edc456829467143683dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f894170e/uploads/origins/9608206b-4133-4025-b175-e59e177fa1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74800c2d46cedf273e6c8ca7494fa603", "srcset": "https://si.imgix.net/f894170e/uploads/origins/9608206b-4133-4025-b175-e59e177fa1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74800c2d46cedf273e6c8ca7494fa603, https://si.imgix.net/f894170e/uploads/origins/9608206b-4133-4025-b175-e59e177fa1d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75192f6db05d01f