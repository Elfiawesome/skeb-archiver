しそうにゲームをする表情と差分で2枚納品頂けたらと思います。\n\n●背景について\nサムネイルや配信に使用する際に透過背景だと便利だということがわかったので、できれば透過PNGでお願い致します。システム上難しければ単色背景でお願い致します。\n\n●サイズについて\n特に指定ありません。描きやすいサイズで描いてくださいませ。\n\n\n依頼内容については以上です。\n衣装デザインなど丸投げですし、顔を2回も描かなければならないのは絵師様にとって負担が大きいと思いますので、納品はゆっくりゆっくり無理のないペースでして下さいませ……！\nどうかお体第一でお願いします……！\n\n最後にはなりましたが、これからもひっそりと応援しております！！！またご依頼することがあると思うのでその際もよろしくお願い致します🙇🏻‍♀️\n\nひさぎ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@osyomal_dnrn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1572954, "client_id": 1817683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0581b995/uploads/origins/ab9a99cb-5a56-4929-ae4b-4526ef2a8ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=270f8eba6fe419cc2fdbcb15de4d5ea9", "srcset": "https://si.imgix.net/0581b995/uploads/origins/ab9a99cb-5a56-4929-ae4b-4526ef2a8ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=270f8eba6fe419cc2fdbcb15de4d5ea9, https://si.imgix.net/0581b995/uploads/origins/ab9a99cb-5a56-4929-ae4b-4526ef2a8ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=645ad1ff0c03a9ab1e20734f6c4e2b87 2x, https://si.imgix.net/0581b995/uploads/origins/ab9a99cb-5a56-4929-ae4b-4526ef2a8ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9f7c2b58925d652dd27e7760be594b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0581b995/uploads/origins/ab9a99cb-5a56-4929-ae4b-4526ef2a8ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=318169d815ea6f43b8e94a42a92c4b4f", "srcset": "https://si.imgix.net/0581b995/uploads/origins/ab9a99cb-5a56-4929-ae4b-4526ef2a8ab4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=318169d815ea6f43b8e94a42a92c4b4f, https://si.imgix.net/058