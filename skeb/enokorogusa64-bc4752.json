rs/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@enokorogusa64/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3491481, "client_id": 2893494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da5a8214/uploads/origins/f1a034b1-9edb-4efd-b76d-0f5e59669d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=352bcd957d0b2ae47ef4ef9b93aa7881", "srcset": "https://si.imgix.net/da5a8214/uploads/origins/f1a034b1-9edb-4efd-b76d-0f5e59669d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=352bcd957d0b2ae47ef4ef9b93aa7881, https://si.imgix.net/da5a8214/uploads/origins/f1a034b1-9edb-4efd-b76d-0f5e59669d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90b1bd30f23c03b2069d08dea083b171 2x, https://si.imgix.net/da5a8214/uploads/origins/f1a034b1-9edb-4efd-b76d-0f5e59669d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fca105786468f356eab85721dd20af1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da5a8214/uploads/origins/f1a034b1-9edb-4efd-b76d-0f5e59669d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0077e610d0b871f16ee50d72c6fd7faf", "srcset": "https://si.imgix.net/da5a8214/uploads/origins/f1a034b1-9edb-4efd-b76d-0f5e59669d6c