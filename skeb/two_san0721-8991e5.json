4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c483b38678b5aef7eb3cf14cf846ddc1", "srcset": "https://si.imgix.net/f5b14e45/uploads/origins/de16bf90-029b-4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c483b38678b5aef7eb3cf14cf846ddc1, https://si.imgix.net/f5b14e45/uploads/origins/de16bf90-029b-4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2db12efd979c5afec98df62bf3e04e1 2x, https://si.imgix.net/f5b14e45/uploads/origins/de16bf90-029b-4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=188a5ace0baec36d5772eaa1d8a94323 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5b14e45/uploads/origins/de16bf90-029b-4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7c31d60c5e02d9a80749af88bd3653", "srcset": "https://si.imgix.net/f5b14e45/uploads/origins/de16bf90-029b-4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e7c31d60c5e02d9a80749af88bd3653, https://si.imgix.net/f5b14e45/uploads/origins/de16bf90-029b-4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8e5b3f9f3f1baf4a37e83ca23ceaa2a 2x, https://si.imgix.net/f5b14e45/uploads/origins/de16bf90-029b-4317-b74e-a38762405b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f33a6a08497ea6fb6f161a35555b936 3x"}, "body": "キャクター\nモンスターハンターのギギネブラ。\n・身体的特徴\n最近のフルフルの絵を見て、とても気に入りました。モンスターのギギネブラにも同じようなものが欲しいです。ギギネブラの尻尾が、人がペニスを入れたときに気持ちいいような感じになっていたらいいなと思います。しっぽがとても好きです。\nプレイ\nショタハンター（できれば女性用ギギネブラの鎧を着ている）との邂逅。このハンターもかなり大きなペニスを持っている。\nギギネブラは尻尾の穴を利用して、ショタの大きなペニスを楽しむ。\nギギネブラは、舌、汁（唾液、乳液などの汁）、包皮をむいての勃起など、さまざまな表現で徐々に興奮していく。\n最後はショタとギギネブラの両方からの雑なクライマックス。ギギネブラの尻尾からショタがオルガスム。\nセリフ\nフルフルのように\n\n基本的には、最近の作品のギギネブラバージョンです。\nできれば、フタナリギギネブラの体の「研究者ノート」のような図を最終イメージにしてください。細かいところまで見てみたいですね。もし価格がそれをカバーしていなくても、私は動揺しません。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@two_san0721/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 220710, "client_id": 41872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08f5e589/uploads/origins/6e7adcf3-d059-48fb-994a-18b53c12ec23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36d8b3fb9d0d7e7da993b49cfb753f56", "srcset": "https://si.imgix.net/08f5e589/uploads/origins/6e7adcf3-d059-48fb-994a-18b53c12ec23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36d8b3fb9d0d7e7da993b49cfb753f56, https://si.imgix.net/08f5e589/uploads/origins/6e7adcf3-d059-48fb-994a-18b53c12ec23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cb5a71bd276eea7ea193c1ae8aeeb45 2x, https://si.imgix.net/08f5e589/uploads/origins/6e7adcf3-d059-48fb-994a-18b53c12ec23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45d4499d32297f0775012558e95f0a31 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08f5e589/uploads/origins/6e7adcf3-d059-48fb-994a-18b53c12ec23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b06434bee04664eb7e2a417ec950941d", "srcset": "https://si.imgix.net/08f5e589/uploads/origins/6e7adcf3-d059-48fb-994a-18b53c12ec23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b06434bee04664eb7e2a417ec950941d, https://si.imgix.net/08f5e589/uploads/origins/6e7adcf3-d059-48fb-994a-18b53c12ec23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb355c988ace9a88de25659960f9de83 2x, https://si.imgix.net/08f5e589/uploads/origins/6