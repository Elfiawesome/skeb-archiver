シンメトリーのツーブロック\n髪色は白\n服装は\n黒いロングコートを肩に羽織っており\n白いYシャツでへそが出る位の丈の物で胸元が少し開いている\n下半身は黒いタイトスカート\n首に十字架が付いた\nチョーカーを付けており\n片耳に黒いピアス\n眼球は白目に\n虹彩部分は赤で、瞳孔部分は黒色です。\n眉は細くキリッとしていてお姉さん風\n\nポーズは両手を腰に当て偉そうな感じでお願いします\n\nもし可能であれば\n男性の方には？マークを頭のあたりに\n女性の方には騒がしく文句を言ってるようなマークをつけて頂きたいです\n細かくなりましたが\nご検討頂けると幸いです", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@m_shiraho/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 933439, "client_id": 771268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93f7ce9b/uploads/origins/9bb68ea0-34bf-4e6a-bdeb-17888846ea23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a022fe573060d47aea72bdb8ac7e00be", "srcset": "https://si.imgix.net/93f7ce9b/uploads/origins/9bb68ea0-34bf-4e6a-bdeb-17888846ea23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a022fe573060d47aea72bdb8ac7e00be, https://si.imgix.net/93f7ce9b/uploads/origins/9bb68ea0-34bf-4e6a-bdeb-17888846ea23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d0d4ff58b1cc4e7b49fed83d48a893d 2x, https://si.imgix.net/93f7ce9b/uploads/origins/9bb68ea0-34bf-4e6a-bdeb-17888846ea23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d95408cfe7d00b791b2647d8299399d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93f7ce9b/uploads/origins/9bb68ea0-34bf-4e6a-bdeb-17888846ea23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9744fda36394e82bef1d3f0172f24957", "srcset": "https://si.imgix.net/93f7ce9b/uploads/origins/9bb68ea0-34bf-4e6a-bdeb-17888846ea23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9744fda36394e82bef1d3f0172f24957, https://si.imgix.net/93f7ce9b/uploads/origins/9bb68ea0-34bf-4e6a-bdeb-17888846ea23?bg=%23fff&auto=format%2Ccom