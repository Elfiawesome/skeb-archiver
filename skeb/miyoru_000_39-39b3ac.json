描いていただければ幸いです……！\nなお、私のXでポストさせていただくと思います！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyoru_000_39/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3107697, "client_id": 1937612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7399358b0a2a43b0121c532296a9698b", "srcset": "https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7399358b0a2a43b0121c532296a9698b, https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8df4cfdad440e965ac56c81c1c116928 2x, https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82b99489338c1ddd9ad92bf05f27fe1f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8abc41da916f3ba7a4636c76d1b1dcd0", "srcset": "https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8abc41da916f3ba7a4636c76d1b1dcd0, https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1eeca3fc506cf01b1f4037d5885ef6a 2x, https://si.imgix.net/65317ccd/uploads/origins/988c1423-ebc4-49d5-a429-1a7ba5677e9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro