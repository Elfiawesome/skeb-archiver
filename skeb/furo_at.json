nsored_thumbnail_image_urls": {"src": "https://si.imgix.net/a816a74f/uploads/origins/d6b3b1df-0c4f-4ec0-aded-a164915296d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51b7ae94c574c861da787a9acce97fd0", "src_set": ""}, "body": "こんにちは、ファイアーエムブレムのルキナにフーターズの衣装を着せてほしいのですが。\n\nポーズや表情はお任せします。シャツのフーターズのロゴは、気になる方は省略したり修正したりしても構いません。この衣装は、あなたの好みやスタイルに合わせて多少の変更が可能です。オプションとして、ルキナはビールの入ったジョッキのトレイや、チキンウィングのプレート（フーターズレストランの人気メニュー）を持つことができます。\n\n因みに、過去の例を含めた参考資料はこちらです。https://imgur.com/a/bSvS2Wh", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@furo_at/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 620200, "client_id": 1327266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8462fa1/uploads/origins/b90f4a4b-93f6-4d57-bd18-bf6bd5170e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebbc801a6b9492fc842791186ab34bac", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8462fa1/uploads/origins/b90f4a4b-93f6-4d57-bd18-bf6bd5170e8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f872aa807bac4ad83245fdb145ba89a0", "src_set": ""}, "body": "こんにちは、あなたの作品と前回依頼したスケブがとても気に入ったので、また別の作品を注文したいと思いました。私は、私とvtuberの友人たちが日本の麻雀をしている様子を描いた作品を作りたいと思っています。table ref with names.jpgのように、テーブルを囲むように人が配置されていることが望ましいのですが、ポーズや表情、視点などは自由に作っていただいて構いません。ただし、Enricoは実際には麻雀の打ち方を知らないので、困惑した表情をしているはずです。\n\n参考文献 https://drive.google.com/drive/folders/1RqMHwhhD0q29jC5Fdv08aEDd4ltTlBQn?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@furo_at/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 620200, "client_id": 50648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3575b884/uploads/origins/860f88d9-4b30-405f-aa46-1399ce46385b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6a54a7883cf66231ddd73b5cb4ccafc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3575b884/uploads/origins/860f88d9-4b30-405f-aa46-1399ce46385b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f5ae9d74df96549bc26b1cfdfc17dc9", "src_set": ""}, "body": "風呂あつしさんの絵で、とても好みのものがあったので依頼させていただきます。\n\nヘッダー画像のお姉さんが、恥じらいながら両手で顔を覆う姿をお願いします。\n\n綺麗な女性が恥じらって両手で顔を覆う姿が好きなのですが、\n前に風呂あつしさんが描かれた「無題」のお姉さんがとても魅力的で、\nこんな女性の恥じらう姿を見てみたいと思いまして依頼しました。\n\n顔を全部隠すように覆ってほしいです。\n顔が写らないですが遠慮なく隠しちゃってください。\nただし、できれば両手の外側から閉じた目の端が少しだけはみ出だしてると嬉しいです。\n\nどうかよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@furo_at/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 620200, "client_id": 702946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb2eeb5e/uploads/origins/4c7329b7-85c4-4812-897f-7d89f6d0d842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=460825dfb643663b67191c5d2d119f6b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb2eeb5e/uploads/origins/4c7329b7-85c4-4812-897f-7d89f6d0d842?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1336f157ee5c05e985a8d0acd1196bbc", "src_set": ""}, "body": "自分の趣味全開なリクエストをさせてもらえないでしょうか?\n\nキャラクターはこちらの女性でお願いします。\nhttps://twitter.com/huro_at/status/1359698240350740486\n\nこの映像みたいに、びろーんと伸ばしたスライムを顔にぺたりと張り付けて顔型を浮き出させる女性を描いてもらえないでしょうか?\nhttps://f.easyuploader.app/20210507224130_70394832.gif\nhttps://www.youtube.com/watch?v=DW7ssTLBpgM\n\n全部で2コマと差分を1つ、お願いしたいです。\n\n①両手でスライムを摘まんで持って、こちらを向く女性。表情は少し楽しそうに。\n\n②顔にスライムを張り付けて、顔型を浮き出させながらこちらを向く女性。両手は下です。\nできるかぎり、閉じた瞼や閉じた口、鼻の穴までもがぴっちり浮き出ていると嬉しいです。\n\n②差分　スライムを透過、もしくは半透明化させて女性の表情を見せてください。\n目と口は閉じてください。口は口角が少し上げてほしいです。\n背景は無地でもOKです。\n女性はどちらのコマも、元の女性の絵みたいに真正面を向いてほしいです。\n\n指定が細かく、変わった依頼で申し訳ないです。\n無理そうであれば別の内容を提示しますのでキャンセルお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 312826, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "はる", "screen_name": "harunn2288", "avatar_url": "https://pbs.twimg.com/profile_images/1410635354416185345/H6-VSEbp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1043148022387888129/1639240671/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 765468, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "マリへイホー Skeb募集中", "screen_name": "mariheeiho", "avatar_url": "https://pbs.twimg.com/profile_images/1973042624371322880/SChUWlEy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/704849832456822784/1759244994/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 33}, {"id": 973833, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夏葉🍉", "screen_name": "natuha___", "avatar_url": "https://pbs.twimg.com/profile_images/1719358708076118016/8zVZR1Jj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2938036837/1708744360/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "cor