rmat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccd4bdb4ea1a88f4ec4865781233b503", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce330f31/uploads/origins/f5b323e6-561e-47eb-8e09-ced9cdcf1d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e933f9b3c8de10c5d9edc20c19a7c5d", "src_set": ""}, "body": "こんにちは。\nまた依頼をお願いしたくてメッセージを送りました。\n\nFE風花雪月から\nシャミアとカトリーヌをお願いします。\n\nシチュエーションは\n前回のちょっとした続きのような物で\n\nシャミアは酔っ払うと可愛いとうっかり口を滑らしたベレトから聞いて酔わせてその姿を動画で撮ろうとしたら逆に酔い潰されたカトリーヌと\n\nしてやったと勝ち誇ったように笑う最初から全部お見通しだったシャミアをよろしくお願いします。\n\nご検討してもし承認していただけたらどうか宜しくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@furo_at/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 620200, "client_id": 1438382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd8cc3e6/uploads/origins/c29d44d0-0183-4f40-9874-6008d81deef1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7cff2a0e635c349c07d97b7f65b2f21", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd8cc3e6/uploads/origins/c29d44d0-0183-4f40-9874-6008d81deef1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8acb61d1645f4762fb60f2327e1c17f5", "src_set": ""}, "body": "はじめまして。\n突然のリクエスト失礼します。\nファイアーエムブレム封印の剣・ヒーローズのエリミーヌ様を描いて欲しいです。\nヒーローズの攻撃絵風の構図で、エリミーヌ様が大きく振りかぶって素手でなぐろうとしてるシチュエーションでお願いします。\n表情は笑顔で、嬉しそうに攻撃しようとしてるサイコな感じでお願いします。\nなにとぞよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@furo_at/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/acc707c7/uploads/origins/12a6d573-6ffc-4f5f-a6df-b3c204269e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&