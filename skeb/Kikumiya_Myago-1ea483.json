せていただきますし、もしみゃごさんのイメージを損なうなどであればこのリクエストは完全無視していただいて、適当に一言ボイスを送っていただけるだけでも大丈夫です。\n\nこのリクエストのいかんにかかわらず、これからもみゃごさんの活動を末永く応援させていただければ幸いです。本当に変なリクエストをしてしまい、申し訳ありませんでした。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@Kikumiya_Myago/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3272580, "client_id": 3935939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da0503b9/uploads/origins/4ccb8a5d-278b-4c0d-8bde-6a62f8f15e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3998483904ef8673c394ef973da77ad", "srcset": "https://si.imgix.net/da0503b9/uploads/origins/4ccb8a5d-278b-4c0d-8bde-6a62f8f15e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3998483904ef8673c394ef973da77ad, https://si.imgix.net/da0503b9/uploads/origins/4ccb8a5d-278b-4c0d-8bde-6a62f8f15e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a964bddebd2239ba95b22c6983b2178 2x, https://si.imgix.net/da0503b9/uploads/origins/4ccb8a5d-278b-4c0d-8bde-6a62f8f15e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89277b193c3a9b34badfb7e81f080329 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da0503b9/uploads/origins/4ccb8a5d-278b-4c0d-8bde-6a62f8f15e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f04e37d9895049c8d1e6bdfebee2463f", "srcset": "https://si.imgix.net/da0503b9/uploads/origins/4ccb8a5d-278b-4c0d-8bde-6a62f8f15e22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f04e37d9895049c8d1e6bdfebee2463f, https://si.imgix.net/da0503b9/uploads/origins/4ccb8a5d-278b-4c0d-8bde-6a62f8f15e22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8e7b9a1dc3395514dad6ddb182b071 2x, https://si.imgix.ne