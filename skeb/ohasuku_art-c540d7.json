)\n【重要】息切れや水分補給等の考慮は不要です。とことん弄んでもらって構いません。\nまた、如月蘭ちゃんはいじめられるのをご褒美(?)として捉えているため、多少リミッターが外れても大丈夫です。\n\nセリフ等の有無はお任せします。\n\n全体的なイメージとしては、2023/01/24頃に描いていたイラスト(表情・身体固定もの)が近いと思われます。\n\n如月蘭ちゃんの設定資料(キャラクターイメージ)などは資料URLにあります。\n快楽責めに溺れる如月蘭ちゃんを、よろしくお願いします。\n\nhttps://twpf.jp/Kisargi_ran", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 129657, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "七峰七緒", "screen_name": "nnmn70", "avatar_url": "https://pbs.twimg.com/profile_images/1954290467123933184/0c_8kyzX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/887464403548880896/1752139060/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}], "nc": 177}, {"id": 724247, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "まかろに", "screen_name": "hihiirokane_m", "avatar_url": "https://pbs.twimg.com/profile_images/1270025665631318016/1Rh_Pk5t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/590606698/1664466745/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 49}, {"id": 946655, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "くず餅", "screen_name": "PlwS50e6y1iubCD", "avatar_url": "https://pbs.twimg.com/profile_images/1440182281360973837/zxwHe1i2.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_