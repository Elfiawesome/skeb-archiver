に見えるが、楽しい事があると人並みにテンションが上がる。\n人付き合いが良く気遣いが出来て優しい。\n\n\n以上です。\nSkeb初利用なので不備等ございましたら申し訳ございません。\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/15IRXLtPLUSiPQJy4YSQEToZxzsFMqBgk", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1160171, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あまあま", "screen_name": "amaama_mamama", "avatar_url": "https://pbs.twimg.com/profile_images/1389574644559007746/pR_5GvO9.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 3390290, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "シシロズイ", "screen_name": "iz006_itosiro", "avatar_url": "https://pbs.twimg.com/profile_images/2048350585490141184/dWoPkHe3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1376867632746352641/1776696770/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 3509451, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "につき", "screen_name": "_tri2tario", "avatar_url": "https://pbs.twimg.com/profile_images/1930150312817672192/u_8TUKFp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3177424645/1478636306/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"