に見えるが、楽しい事があると人並みにテンションが上がる。\n人付き合いが良く気遣いが出来て優しい。\n\n\n以上です。\nSkeb初利用なので不備等ございましたら申し訳ございません。\n宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/15IRXLtPLUSiPQJy4YSQEToZxzsFMqBgk", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 2654205, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "千代田 扇佳（声優）", "screen_name": "SenkaChiyoda_va", "avatar_url": "https://pbs.twimg.com/profile_images/2044218898611089411/wDxS5tvV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1238063699316834304/1776214752/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 20, "skills": [{"genre": "voice"}], "banned": false, "nc": 129}, {"id": 3020853, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "幻≠", "screen_name": "Aidatoma5", "avatar_url": "https://pbs.twimg.com/profile_images/1609174298530566144/DoKTKAMn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1409680257217556484/1630064560/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 144}, {"id": 3139752, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "くむ@依頼受付中", "screen_name": "kumuganbaru", "avatar_url": "https://pbs.twimg.com/profile_images/1757315521832435712/9CNArdUp.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "complete_expiration_days": 7, "skills": [{"genre": "art"