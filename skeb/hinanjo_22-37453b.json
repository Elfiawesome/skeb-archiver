クターA 184cm。ハンター。地図を描く。クールで真面目。肩幅が広い。太眉。肌の色に注意してください。A12とA13の服を着て描いてください。\nモチーフ：矢、地図、羊皮紙、コンパス\n\nキャラクターB。旅と空を飛ぶのが好きな元気でかわいいエルフの女の子です！顔のマークと肌の色に注目してください。\nモチーフ：星、星座、春、カラフルな鳥\n\n🤝 二人はどうやって知り合ったの？\n二人はファンタジーのキャラクターです！キャラクターAはキャラクターBの \"師匠 \"的存在。\n\nその他の構図はお任せします！横向きでお願いします。カラフルなイラストだと嬉しいです。何か問題がありましたら、遠慮なくお断りください。ありがとうございました！\n\n参考資料 👇 ←クリック\n\nhttps://www.dropbox.com/sh/o7n3argdhnqgfsd/AACl23fcZ7V3nB1qFPH8Wz53a?dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinanjo_22/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2894027, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54aaacaa/uploads/origins/a61f5603-0114-40a7-8596-76ab03f65cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff44a87453d6c956765237434312c6f4", "srcset": "https://si.imgix.net/54aaacaa/uploads/origins/a61f5603-0114-40a7-8596-76ab03f65cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff44a87453d6c956765237434312c6f4, https://si.imgix.net/54aaacaa/uploads/origins/a61f5603-0114-40a7-8596-76ab03f65cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d192a61ed09d4ce46ca431db3b4db53c 2x, https://si.imgix.net/54aaacaa/uploads/origins/a61f5603-0114-40a7-8596-76ab03f65cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3d0a0396ba0913d0e60a856de2c2738 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54aaacaa/uploads/origins/a61f5603-0114-40a7-8596-76ab03f65cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5df0714188d54f0b53a387f29d2831e9", "srcset": "https://si.imgix.net/54aaacaa/uploads/origins/a61f5603-0114-40a7-8596-76ab03f65cd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5df0714188d5