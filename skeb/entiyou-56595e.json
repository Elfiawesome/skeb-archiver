x.net/4875601d/uploads/origins/3bc9c9fc-2d4e-42bb-8bc1-29dfdf1f445b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9939cef52ed48a2ce09bd91579b29fe, https://si.imgix.net/4875601d/uploads/origins/3bc9c9fc-2d4e-42bb-8bc1-29dfdf1f445b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d393ce936ecfbece996f2515d8fd9b4 2x, https://si.imgix.net/4875601d/uploads/origins/3bc9c9fc-2d4e-42bb-8bc1-29dfdf1f445b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fddccee030f14fab964c63671dcf2388 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4875601d/uploads/origins/3bc9c9fc-2d4e-42bb-8bc1-29dfdf1f445b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50da813b03b781d7c2320bd6129d1f13", "srcset": "https://si.imgix.net/4875601d/uploads/origins/3bc9c9fc-2d4e-42bb-8bc1-29dfdf1f445b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50da813b03b781d7c2320bd6129d1f13, https://si.imgix.net/4875601d/uploads/origins/3bc9c9fc-2d4e-42bb-8bc1-29dfdf1f445b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58dca68f4edb2cb70a9e312bbed972d4 2x, https://si.imgix.net/4875601d/uploads/origins/3bc9c9fc-2d4e-42bb-8bc1-29dfdf1f445b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f82fab676687253bfed17a6231c79245 3x"}, "body": "○延長様\n\n　いつもお世話になっております。\n　オリキャラのVer.2.0の形をデザインしていただきたいのですがお願いできますでしょうか？\n\n　オリジナルの近未来SF退魔師系世界観の欧州版のキャラで、\n　https://w.atwiki.jp/yamikitan/pages/180.html#id_17c39b24\n　同僚たちはこんな感じの外見や装備とかをしております（NSFW用世界観なのでNSFWを入れておきます）\n\n○顔立ち他\n　体格は身長171cm、体重64kg。胸はそこそこあり。\n\n　虹彩は金色、三白眼。表情は硬めのカタブツ感あり。\n　髪色は薄紫～紫で前髪の方に濃淡タイプのメッシュが入っているイメージをしております。髪型や長さはh001をご参照いただけますと。\n（髪の紫度合いはFGOのスカサハ辺り？）\n　イメージカラーとしては髪色の紫もそうですが、全体的に暗めの感じで、明るい差し色とかそんなのがあるのかなぁ、というざっくりした感じです。\n\n○服装\n　頭部にはa003a/a003bの参考画像のキャラが装備しているような感じの鋭角的な（？）装備を。\n　a001がVer.1デザインですが、上半身というかジャケット部をa003a/a003bの感じでショートジャケット（厳密に見ると袖は短いですが裾は長いので、これは腰辺りまでにしてほしいです）で、肩には参考画像のような他のキャラとちょっと違うベルト系っぽい装飾とか、簡易的なプロテクターのようなものとか左右対称非対称気にせずにデザインしていただけると。\n　a002のような腰マント＆腰アーマーは必須でお願いします（割と組織のキャラの装備ベースイメージとして強い意味を持つので、可能な限り装備させた形でお願いします）\n　もちろん、そのままでなく色々引っ付けたりアレンジしていただいて構いません（他のキャラも統一されているという形ではないので）。\n　脚部に関してはタイツ＋a003bな感じの少しごつめのブーツを装備。\n　身体部に関しては、レオタ系＋タイトスカートがいいのか、レオタ系＋前垂れタイプがいいのか、というのがちょっと自分の中ではまとまりがつかなかったので、その辺りは「こうしたろ」という感じでデザインしていただければと……\n\n　服装装備に関しては全体的に形状やサイズも含めてメカニカルなパーツやガジェットなどをつけていただいけますとありがたいです（魔力とか一部で発光するetc.）。\n\n○武器\n　武器はw001のような感じの大型のランス状のもの。魔力による刃生成が可能なタイプ。\n　柄の少し先の根元の方に、リボルバー系のシリンダーパーツが装備されてる想定です。\n　こちらも服装の一部同様にメカニカル的な意匠が強いと嬉しいです。\n\n\n　細かい点が多くて申し訳ないですが、全体的な内容としては以上のような感じになります。\n　また、正面の立ち絵（最初のリンク先のキャラのページにあるような立ち絵）の他、簡易的な背面図をお願いしたいです。\n\n\n　文中に記載させていただきましたとおり、延長さんの「これとかどうだろう」と思い浮かんだ要素なんかは入れていただいて構いませんので、よろしくお願いいたします。\n\n　以上、ざっくりではありますが、ご勘案いただけますと幸いです。\n\nhttp://mkt.la.coocan.jp/ort2.zip", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@entiyou/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 190354, "client_id": 2770236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8a06019/uploads/origins/b6793a4d-ccec-426d-8697-89bd4e2351bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226087d1f1f5fe00d37835682c5be12c", "srcset": "https://si.imgix.net/a8a06019/uploads/origins/b6793a4d-ccec-426d-8697-89bd4e2351bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226087d1f1f5fe00d37835682c5be12c, https://si.imgix.net/a8a06019/uploads/origins/b6793a4d-ccec-426d-8697-89bd4e2351bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d3de7941225488ae23908256762312e 2x, https://si.imgix.net/a8a06019/uploads/origins/b6793a4d-ccec-426d-8697-89bd4e2351bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200