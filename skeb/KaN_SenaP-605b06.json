n画像サイズはA4で、解像度は350dpiでお願いします。 \nご検討いただけますと幸いです。  \n\n衣装指定は \nhttps://x.com/kan_senap/status/1789105417404170532?s=46&t=IgHbglBY9aBgd46aBtHm9w\nこちらのアクティブ（黒パーカー）を希望ですが、小さくて見づらい、谷間はちょっと……などありましたら、資料URLにある初期衣装（黒ノースリーブ）でも構いません。ご参考いただけますと幸いです。\n\nhttps://x.com/kan_senap/status/1875090660359078223?s=46&t=IgHbglBY9aBgd46aBtHm9w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gomomo_gomoku/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 979974, "client_id": 2260086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8069778/uploads/origins/d4485a0a-0d0e-45bb-acae-01004b671b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7725eb6213e17674036eb3d4f3ed992", "srcset": "https://si.imgix.net/a8069778/uploads/origins/d4485a0a-0d0e-45bb-acae-01004b671b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7725eb6213e17674036eb3d4f3ed992, https://si.imgix.net/a8069778/uploads/origins/d4485a0a-0d0e-45bb-acae-01004b671b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4f32c69d7b24a83581d062187311ee2 2x, https://si.imgix.net/a8069778/uploads/origins/d4485a0a-0d0e-45bb-acae-01004b671b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fa8144eb4abdf12069fee74ec3569c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8069778/uploads/origins/d4485a0a-0d0e-45bb-acae-01004b671b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d5c702b76f22a09132298316e5e7718", "srcset": "https://si.imgix.net/a8069778/uploads/origins/d4485a0a-0d0e-45bb-acae-01004b671b6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d5c702b76f22a09132298316e5e7718, https://si.imgix.net/a8069778/uploads/origins/d4485a0a-0d0e-45bb-aca