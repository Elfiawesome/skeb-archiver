si.imgix.net/efa08c0d/uploads/origins/e55af869-2fa9-48f8-9e39-7ae853e2a6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df857858c3a4e74a56c6eb95247afed2", "src_set": ""}, "body": "はじめまして、リクエスト失礼します。\n私のOCの魔女「メアリー・ポーラスター」を描いていただけますでしょうか。\n\n胸の衣装がはだけた状態で、背後から両胸を揉まれている（竿役は腕のみの描写でOKです）。\n胸は乳首が見えるような揉み方で、可能なら乳首を弄る差分などもあると嬉しいです。\n表情はジト目で顔を赤らめている感じでお願いします。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1z6krAPUeRzG-2qK8TU32u80C7lOtTB5u?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1183685, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3d0c813/uploads/origins/d401218e-a60c-4b32-a711-bf0ca0212063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4684574a49d070d31d7154b141d6880f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3d0c813/uploads/origins/d401218e-a60c-4b32-a711-bf0ca0212063?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1769b4e5413c987b1b1ba67252aec40", "src_set": ""}, "body": "未決囚さんはじめまして。\n「ピザ食べあかりちゃん」がかわいかったので、リクエストしたいです！\n\n紲星あかりちゃんがセックスするために服を脱ぎかけているところを描いて欲しいです。\n\n・目は「ピザ食べあかりちゃん」の感じでお願いします。\n・体形は胸は爆乳で、お腹、太ももともに太くお願いします！お腹は垂れているくらい太くて構いません。服を着ていれば多少着痩せするけど、脱ぐと抑えるものがなくなった脂肪がだらんとする感じでお願いします。\n・服は「VOICEROID2 紲星あかり」を脱いでいく感じで、どこまで脱いでいるかはお任せしますが、お腹は見えている。パンツは履いたままだと嬉しいです。\n\n表情は「むふー」という感じの自信ありげな表情でお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1183685, "client_id": 15107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cd9938d/uploads/origins/e8e48f3a-fddd-4a09-995f-c0c8c419174c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef0ff542dbb22c208348d9dd912ae435", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cd9938d/uploads/origins/e8e48f3a-fddd-4a09-995f-c0c8c419174c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96dfe646203999fed1dc459473a14f8e", "src_set": ""}, "body": "【依頼概要】蒼（@saitoumeiji）が帆美様（@homipoke28）依頼して描いていただいた子のえっちなイラスト(依頼として掲載する事やR-18依頼への使用等許可あります)　【希望】またおっぱいがいい感じにお願いします！https://twitter.com/homipoke28/status/1764271360598315369/photo/1\n\nhttps://imgur.com/a/pZ1qPUA", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1183685, "client_id": 15107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2312e48c/uploads/origins/c75382a9-848c-4e0e-814e-d3fbb6719e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f90e78a79d6dea3286a58a8aff6e5f98", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2312e48c/uploads/origins/c75382a9-848c-4e0e-814e-d3fbb6719e12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=756b2fded924e725580d22a9a2f933c4", "src_set": ""}, "body": "【依頼概要】蒼（@saitoumeiji）のキャラクター　ラプリナ　のイラスト　【形式】画像サイズ、形式不問。【キャラ】悪役側のキャラです。享楽的で快楽主義の開放的な悪女です。おっぱいが素晴らしいなぁと見ていたので胸を強調される感じでお願いします！【挨拶】素敵な絵を拝見し、お願いしに参りました！ぜひご一考のほどよろしくお願いします！！\n\nhttps://imgur.com/L0BR1FT", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/195e3297/uploads/origins/e0be601b-c281-4504-9116-3f89ec98bd99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8882478dfc4316ed892e448dd94533a6", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1183685, "client_id": 1353652, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1183685, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d382466/uploads/origins/c5cfd4f3-6f09-4f24-b97b-1d9c683424a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ddc7ace0e0118b330072847b1583966", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d382466/uploads/origins/c5cfd4f3-6f09-4f24-b97b-1d9c683424a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e944cf0dfe17674dcdf7bc3e34cc508f", "src_set": ""}, "body": "こんにちは、お願いがあります！\n\nキャラクター：https://files.catbox.moe/zte875.jpg\n\n名前はドーン。彼女は古代の存在。プライドが高く、傲慢。\n\n彼女の胸を大きくしてくれませんか？こんな感じで。https://skeb.jp/@jack_Jabberwock/works/22\n\n彼女の胸がブラから滑り落ちるバリエーションを描いてもらえませんか？\n\nあなたが描きたくなければ、剣も本も描く必要はありません。\n\nその他は想像にお任せします！\n\nありがとう！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1183685, "client_id": 2395398, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/230b8d42/uploads/origins/1884faa6-87d7-4e42-af08-d5bc3d3930e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cecc0042cbc3c8ee1c46ba588f3d1cce", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/230b8d42/uploads/origins/1884faa6-87d7-4e42-af08-d5bc3d3930e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd119a848872a1a279727508d888a66d", "src_set": ""}, "body": "こんにちは！あなたの画風はとてもかわいいと思います！私のエルフのOCを描いてください。名前はティファニア。ファンタジーの酒場の女給です。彼女をかわいく魅力的に描いてください。\n\nhttps://drive.google.com/drive/folders/1kre8JB7ZbUVkILCTlLe2vcYQDZrua1mp\n\nエルフの耳は長くしてください。胸はこんな感じで大きく描いてください！\nhttps://x.com/Mk2S_Re/status/1929659292346352009?t=f75zy_KHnuaaR5LIw4zlBQ&s=19\n\nご配慮ありがとうございました！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1183685, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4089bab/uploads/origins/743c43f6-17c2-4997-bdf2-e0f9b93b7584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0ec0e1d02a349cc15a9134e581b2652", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4089bab/uploads/origins/743c43f6-17c2-4997-bdf2-e0f9b93b7584?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7416256834c66870ef87c94d05b778ff", "src_set": ""}, "body": "はじめまして。\n\nこちら（https://x.com/Mk2S_Re/status/1921880821301997633）のご主人大好きふと眉デカ乳メイドちゃんの素敵な笑顔に一目惚れしました。\nというわけで、ご主人大好きふと眉デカ乳メイドちゃんの可愛いイラストをお願いします。\n詳細はお任せしますので、お好きに可愛く描いていただければと。\n\nスマホの壁紙などに用いたく、1:2程度の縦長キャンバスでお願いします。\n出来れば白背景ではなく簡単なエフェクトや単色塗りやグラデーションなどでも良いので背景もあると嬉しいです。\n\nそれではご検討をよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jack_Jabberwock/works/20", "private_thumbnail_image_urls": null, "privat