と体重を活かしたパワーファイトが得意。\n・顔立ちはかなりの童顔。\n・髪は黒髪で坊主から少し伸びたくらいの短髪。\n・単純かつ負けん気が強い性格。\n・プロレス経験が浅いため、ベテランやラフファイトを得意とする相手などに弄ばれてやられがち。\n・性的対象は女性で完全にノンケ。\n\n上半身は裸、下はショートタイツのコスチュームで全身の立ち絵を希望しますが、もし差分のリクエストが可能なら普段着の差分もいただけると嬉しいです。\n\n以上、可能でしたらよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konnnezuwrestle39/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 158089, "client_id": 25901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d6e21a8/uploads/origins/1547103c-b97a-4a23-ac2a-bf7246e7ba8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9eb58b03c234ced1c2aac8f41b1df8a", "srcset": "https://si.imgix.net/3d6e21a8/uploads/origins/1547103c-b97a-4a23-ac2a-bf7246e7ba8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9eb58b03c234ced1c2aac8f41b1df8a, https://si.imgix.net/3d6e21a8/uploads/origins/1547103c-b97a-4a23-ac2a-bf7246e7ba8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d362eddb6102d1f7434eb3f8b5306467 2x, https://si.imgix.net/3d6e21a8/uploads/origins/1547103c-b97a-4a23-ac2a-bf7246e7ba8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f12cd90bb40de9720dd9f8a0540ea7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d6e21a8/uploads/origins/1547103c-b97a-4a23-ac2a-bf7246e7ba8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f6a9e026668b7f67ada57cd1ec1b648", "srcset": "https://si.imgix.net/3d6e21a8/uploads/origins/1547103c-b97a-4a23-ac2a-bf7246e7ba8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f6a9e026668b7f67ada57cd1ec1b648, https://si.imgix.net/3d6e21a8/uploads/origins/1547103c-b97a-4a23-ac2a-bf7246e7ba8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20