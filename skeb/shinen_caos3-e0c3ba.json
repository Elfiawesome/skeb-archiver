ように描いていただけたらと思います、改めてどうぞよろしくお願いいたします！！\n\nhttps://skeb.jp/@mansyontintai/works/42", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shinen_caos3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2568539, "client_id": 13725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d55cabe1144becf8da7b0958527515f", "srcset": "https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d55cabe1144becf8da7b0958527515f, https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c6a866ffa74f481ac20c0124b1838f7 2x, https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=415f973e1c81cfa72b89ffb925ddca2b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3305783d83f24d52cb138261bee2859f", "srcset": "https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3305783d83f24d52cb138261bee2859f, https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e705a4dd24bfb8dfe81585f9e8b48a73 2x, https://si.imgix.net/4b54a086/uploads/origins/8deb8e42-9607-424c-85b0-44f6332d9c7b?bg=%23fff&auto=format