x.net/0e813b5a/uploads/origins/cafbcea4-e9e2-4ff3-9646-e9d668f0abf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=572b79f5d9be6e3ab3bd7dc51e1329a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e813b5a/uploads/origins/cafbcea4-e9e2-4ff3-9646-e9d668f0abf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f13c8150472c5b54e10fd7e7d6323261", "srcset": "https://si.imgix.net/0e813b5a/uploads/origins/cafbcea4-e9e2-4ff3-9646-e9d668f0abf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f13c8150472c5b54e10fd7e7d6323261, https://si.imgix.net/0e813b5a/uploads/origins/cafbcea4-e9e2-4ff3-9646-e9d668f0abf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=83057ed8f2dc3fb37c49beb1877b7562 2x, https://si.imgix.net/0e813b5a/uploads/origins/cafbcea4-e9e2-4ff3-9646-e9d668f0abf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3ef53c36ebdfa52aaec4d8d68e46b93 3x"}, "body": "ニルグ･テップ様、初めまして。\n下記書籍のファンアートをリクエストさせていただきます。\nZQワークス刊行(電子書籍)『フォスゲンの初等怪物学』\n\nこの書籍をお持ちではないと思うので資料用ＵＲＬに「フォスゲン」と「ネコちゃん」の画像を共有しておきます。\n２パターン考えたので描きやすい方を選んで、ニルグ･テップ様の手でデフォルメした姿を描いていただければと思います。\n\n【パターンＡ】\n　落胆もしくは虚無の表情をしたフォスゲンさんが、売れ残った書籍に囲まれているもしくは寄りかかっている姿。\n（キャラが主体なので書籍の方は簡単な作画で大丈夫です）\n\n【パターンＢ】\n　穏やかもしくは楽しそうな表情をしたフォスゲンさんがネコちゃんを愛でている。\n膝の上に乗せて撫でていたり、杖の飾りを猫じゃらしのように振っているのが似合うと思います。\n\n\n以上、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1aq0Kqj95NMMyRLkFFSGHvcBqAuZMmAWA?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shinen_caos3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2568539, "client_id": 13725, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c1265e2/uploads/origins/1698e2b8-4ed2-4c88-bc7c-d12bcf1bc30