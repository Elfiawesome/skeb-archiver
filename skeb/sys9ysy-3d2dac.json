たくの別物を描いて頂いてもどちらでも構いません。宵時さんの描きたいように描いてください。\n\n使用用途としては、\n･Twitter、pixivなどSNSのアイコン\n･鑑賞など個人の非商用利用\nなどを考えております。\n\nこのような依頼は初めてなので、何か不都合などございましたら申し訳ございません。\n条件や時間が合い、ご都合等問題なければ受けてくださると幸いです。\nよろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sys9ysy/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2247260, "client_id": 2714740, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/822c24e2/uploads/origins/5bae291f-2016-440a-9a3d-b5e58b65bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8b6d7a2c47f38a71f717346bdb8713", "srcset": "https://si.imgix.net/822c24e2/uploads/origins/5bae291f-2016-440a-9a3d-b5e58b65bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b8b6d7a2c47f38a71f717346bdb8713, https://si.imgix.net/822c24e2/uploads/origins/5bae291f-2016-440a-9a3d-b5e58b65bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e18d469c4a3b27258edd34670fbce034 2x, https://si.imgix.net/822c24e2/uploads/origins/5bae291f-2016-440a-9a3d-b5e58b65bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcdd9ef4102ac7cf64bde5e1c64ddf98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/822c24e2/uploads/origins/5bae291f-2016-440a-9a3d-b5e58b65bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5624540ae0a7d7a7d6dbb4f38255effa", "srcset": "https://si.imgix.net/822c24e2/uploads/origins/5bae291f-2016-440a-9a3d-b5e58b65bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5624540ae0a7d7a7d6dbb4f38255effa, https://si.imgix.net/822c24e2/uploads/origins/5bae291f-2016-440a-9a3d-b5e58b65bc3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70efaf2206efe6ef567117c8