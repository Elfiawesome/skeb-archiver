e, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce06773/uploads/origins/7909f5d5-c55b-4704-ba19-d96fbd6d6b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7e2816ddf3db89d0f5e47a4c437c0b9", "src_set": ""}, "body": "はじめまして！彡さんの絵がとても大好きです、宜しければ私と友人のOCを描いて頂けないでしょうか？\n\n使用用途：主にアイコンなどに使用させて頂く事があります\n\n細かい部分はアレンジして頂いて構いません。\n関係性はお友達です。\n\n自コテ：アイドルの女の子\nお友達：学生\n\n表情はどちらも明るいイメージの笑顔。\n\n構図はおまかせしますが、抱きしめている構図や距離が近すぎるもの、横顔、暗い表情はNGでお願いいたします。\n\n自コテ：人気アイドル、高身長の女の子（170cm）\n前髪と横の部分に白のインナーカラー\n\n自コテにサングラスの描写をお願いいたします、位置の参考までに他の方に描いていただいたイラストを添付します。\n\nお友達：大学生、御相手様をサポートするヒーローの女の子。（154cm）\n\nやや身長差あり（16cm）どちらも明るい性格\n\n服装の雰囲気やイメージに近い写真がドライブ内にございますのでお好きなように描いて頂ければと思います。\n\n自コテがかっこいいお姉さんのイメージ、お友達が可愛い女の子のイメージでお願いいたします！\n\n金額の不足などあれば再送依頼をお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-DsszdKAB59n5KfFflhoS5i4s34XkgZ0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1shikarinabe/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0e44037/uploads/origins/83e89401-73b1-408b-b730-b8a99f966429?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=237db38cb6c72e67c706df738a911b1a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3530061, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@1shikarinabe/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bbf66f56/uploads/origins/e4bbba0f-c273-4b3c-bafe-fc1823b59cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=220ab02978ff970