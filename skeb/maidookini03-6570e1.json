7be6e1-eac9-4d2b-b908-93fd1e28db32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f509edd58088ae1d99f46859cc2a8d0 2x, https://si.imgix.net/03c8a0f9/uploads/origins/947be6e1-eac9-4d2b-b908-93fd1e28db32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84fd7db898dd43f9e540ceec1f2e777a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03c8a0f9/uploads/origins/947be6e1-eac9-4d2b-b908-93fd1e28db32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24637859db53559425e215c10389d4b5", "srcset": "https://si.imgix.net/03c8a0f9/uploads/origins/947be6e1-eac9-4d2b-b908-93fd1e28db32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24637859db53559425e215c10389d4b5, https://si.imgix.net/03c8a0f9/uploads/origins/947be6e1-eac9-4d2b-b908-93fd1e28db32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4beaa11a5bde2b71da309275e2214331 2x, https://si.imgix.net/03c8a0f9/uploads/origins/947be6e1-eac9-4d2b-b908-93fd1e28db32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfcd4bab12b6cf7e476f3878fa8ba7ca 3x"}, "body": "初めまして、オオキ様！\n\n『Paranomal Crime 無印』『Paranomal Crime2 ～Love and Destroy～』をHO2で通過させていただきました。\nとても楽しく遊ばせていただきました。誠にありがとうございました。\nシナリオの一人一人にハイライトが当たる感じから魅力的な登場人物含めて大変満足度の高すぎて、脳に思い出が焼き付きました。\n\n描かれているNPCがどれも魅力的かつ、オオキ様の絵柄がドストライクというのもあり、そんなオオキ様に頼みたく、勇気を出してリクエストさせていただきました。\n\nHO2をやらせていただいたため、義兄弟であるブルーへの思い入れがPLPCともに強くBIGLOVEを向けており、大切な思い出として深く心に残っております。\n通過後もずっと大切な兄弟として愛しみ続けてさせていただいております。\n\nそんなブルーとうちの子HO2の一枚絵を是非ともオオキ様に書いていただけたら嬉しいです。\nご検討のほどいただけますと幸いです。\n\n以下HO2の詳細情報を参考までに\n＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿＿\n▷HO2の外見や性格\n►外見\n37歳 男性　身長183cm\n赤色の癖毛\n三つ編みで後ろ髪をまとめている。\n深い緑色の瞳\nピアスあけてる\n\n►性格\n愛妻家で笑顔が絶えない明るいおじさん。\n家族を一番に愛している。\n慈悲深く誰でも分け隔てなく優しく社交的だが、どこか抜けている。\n人を一人でも多く救いたいと思う正義心で困っている人がいたら助けずにはいられず、手を差し伸べる。\n後方で腕組んで誰かの背を押してあげる存在であろうとする。\n年下の妻と娘を溺愛しており、写真をロケットに入れていつも持ち歩いているほど。\n\n►ブルーに対して\n元が一人っ子でブルーとは歳が近いと感じていたので自分の方が兄貴だと自負している。\n唯一無二の兄弟として愛している。血のつながり？関係ねぇ！！俺達には絆があるそれだけあれば俺らは兄弟だ。ブルーの専門的な話の聞く時間も好き。\n\n資料↓\nhttps://drive.google.com/drive/folders/1PagyteOQ9xans9yZBX_wa4l_o-bmRjMD?usp=drive_link\n\n※立ち絵はパラクラ無印とパラクラ２のものになっておりますがお好きな方で書いていただけたらと思っております。\n\n▍リクエスト内容\n兄弟じゃれ合いのような仲良くしているや一緒に食事をとっているといった日常風景の様子を書いていただけますとうれしいです。\nそのほか構図や服装などはオオキ様の描きやすいようにしていただいて問題ないので好きに描きやすいように書いていただけたらと思います。\n\n以上です。\n改めまして素敵なシナリオを通して最高の自陣とともにとても楽しい時間を過ごす事ができ忘れがたい思い出になりました。本当にありがとうございます。\nこれからのご活躍のほどこれからも応援しております。\nご多忙かと思いますが、何卒宜しくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 70420, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かぼちゃ太郎🎃", "screen_name": "hayashimochiko", "avatar_url": "https://pbs.twimg.com/profile_images/1664663300582555648/3aLt--v2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1031186451021492224/1766013415/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1377534, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "イラストオーダー受付中", "screen_name": "Komozi_r", "avatar_url": "https://pbs.twimg.com/profile_images/1873015636311588871/IA0Isu6H.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1427864233367113733/1712590053/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "complete_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 3162650, "creator": true, "nsfw_acceptable": true, "