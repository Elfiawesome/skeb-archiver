、しかおさんの素敵なストグラFAも拝見出来て本当に大興奮です。もしよければ、今回は私のTRPG探索者を描いていただけますか？\n\n●キャラ設定：\n捜査一課の刑事。銃の操作が上手い。\n普段はほぼ笑えないですが子供相手ならちょっと笑える。\n「EQ低いの男みたい」とよく言われる。けど全然無自覚。\n髪：ブラウン\n目：グレイ\n愛用の武器：トンファーバトンと拳銃\n\n構図などはご自由にどうぞ！お好きなように描いてください！見た目の参考はこちらで↓\nhttps://drive.google.com/drive/folders/1WQaqQR2nFfma8fb3EMOGQXvqw10GkZSd?usp=sharing\nhttps://skeb.jp/@7gyo0125/works/6\nhttps://skeb.jp/@tatei_qwe/works/15", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shikaoYN/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2475337, "client_id": 2676218, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdedebca/uploads/origins/1854df27-106a-4178-9ca8-1150758e979b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91b9e4bdb7c1ae604b98a5011051f1c9", "srcset": "https://si.imgix.net/cdedebca/uploads/origins/1854df27-106a-4178-9ca8-1150758e979b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91b9e4bdb7c1ae604b98a5011051f1c9, https://si.imgix.net/cdedebca/uploads/origins/1854df27-106a-4178-9ca8-1150758e979b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c1baf997663a45bab1182c65058ce3e 2x, https://si.imgix.net/cdedebca/uploads/origins/1854df27-106a-4178-9ca8-1150758e979b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a269471c8f34f7f87b4b159a9c242f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdedebca/uploads/origins/1854df27-106a-4178-9ca8-1150758e979b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9f6d8328877e6ff4f83b56574586495", "srcset": "https://si.imgix.net/cdedebca/uploads/origins/1854df27-106a-4178-9ca8-1150758e979b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9f6d8328877e6ff4f83b56574586495, https://si