age_urls": null, "body": "", "nc": 35, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hasosa02/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3429289, "client_id": 1060228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e404c852/uploads/origins/2c73a4a6-297c-48be-bc03-22bd5a936e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=251c39ce28e2e8ec8e91d505351d5c8b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e404c852/uploads/origins/2c73a4a6-297c-48be-bc03-22bd5a936e73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=811a3e51f9b4cd2a744c5f7bda686c8d", "src_set": ""}, "body": "FGOのアルテミスとのシナリオをお願いします。\nhttps://fategrandorder.fandom.com/wiki/Sub:Orion/Gallery\nシナリオは、フタナリ・アルテミスが別のアルテミスとファックするものです。2番目のアルテミスはサポート召喚でも、別のコピーでも、敵でもかまいません。ふたなりアルテミスにはタマがなく、クリトリスからペニスが生えている。フタナリ・アルテミスは堕落した変態で、他の自分自身とのセックスを楽しみながら、快楽と蕩尽に溺れている。二人目のアルテミスは、もう諦めて快楽を楽しんでいるのか、抵抗しようとするが快楽を我慢できないのか。オーガズムでアソコから潮を吹き、乳房から授乳して妊娠するという違いを見せてほしい。\nシナリオ全体の雰囲気は、この https://skeb.jp/@hasosa02/works/11 に似ています。\n構図は自由に選んでください。このアイデアを気に入っていただけると幸いです。もし量が足りなければ、適切な量でアピールしてください。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hasosa02/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3429289, "client_id": 1166106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c73f5bf/uploads/origins/7d0792b0-7909-4885-abb7-a6704021c73f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=353195e5fa9a3f65fc8d8bb82641ee84", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c73f5bf/uploads/origins/7d0792b0-7909-4885-abb7-a6704021