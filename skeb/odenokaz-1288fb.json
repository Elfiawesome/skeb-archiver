0&txt=PRIVATE&s=7e53b354f8af7c998f502c00fc134a7d, https://si.imgix.net/00c6f747/uploads/origins/af36fdf4-1829-484c-8174-becc252a263c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45ac5df36f9af59b6d0fb14245d9d91c 2x, https://si.imgix.net/00c6f747/uploads/origins/af36fdf4-1829-484c-8174-becc252a263c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=44ac35cf3ba6f48d06a60e3de808514b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2274016, "client_id": 3492967, "nc": 49}, {"path": "/@odenokaz/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2274016, "client_id": 83458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f63eda6d26dd29f430d2d1ca0806630c", "srcset": "https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f63eda6d26dd29f430d2d1ca0806630c, https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f62c26c4263a63f048e704f47444a38b 2x, https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41a85068cacfb5dc6fe08b9e55c86700 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eefe9459ddc655265d0c7fd74abef1d3", "srcset": "https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eefe9459ddc655265d0c7fd74abef1d3, https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4601560dca47d2b85b092b147adb4bf3 2x, https://si.imgix.net/87aa2156/uploads/origins/9b18d20a-58af-45fc-8c4c-c277ae477eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0498758a6d021a04b695a209253f80da 3x"}, "body": "魔理沙と菅牧典の着衣内射精をお願いします。　\n\n◆2人ともふたなり。　\n◆典はいつもの服装。　\n◆魔理沙は資料の服装。　\n（鈴奈冬服をカスタムしました。　変更点はタイツ+ソックスを穿かせ、ソックスと同素材の手袋を追加、ブーツの厚底化。）　\n\n◆内容：【着ている服の中でそのまま射精する】前提で\n2人が服の上からペニスへの手淫を行う。　\n自慰でもいいし、相手のペニスを刺激するのもOK。　\nペニスは直に露出せず、最後まで着衣越し。　\n\n以下、沢山書きますが可能なものを選んでいただければと思います。　\n\n◆場所：鈴奈庵か鯢呑亭。　あるいは天狗の遊楽施設、のいずれか。　\n※2人以外の描写は　無くても問題ありません。　\n\n・鈴奈庵の場合…\n小鈴が認めた妖魔本関係者だけが使用できる秘密のハッテン部屋では客同士のSEXが行われている。　魔理沙と偶然居合わせた菅牧典は部屋の外から中で行われているSEXを見物していたが、我慢できなくなった魔理沙が自分と典のモノを触り始める…。　\n\n・鯢呑亭の場合…\n席について料理や酒を楽しんでいた2人。　\nある客が【裏メニュー】をたのむと美宵の服装や所作が露骨に艶めかしくなった。　\n美宵からおしぼりが配られ、【目立たぬ様に見抜きしてもいい】と伝えられる。　\n席に座ったまま始める2人…。　\n\n・天狗の遊楽施設の場合…\n天狗社会はその堅苦しい構造上、精神修養と度量を示す同性愛が古くから賛美されている。　\n鈴奈庵のそれよりも芝居小屋や遊郭を一緒にしたような大きな施設に天狗側から誘われた魔理沙。　\n酒と料理でもてなされ、目の前で繰り広げられる天狗の情交に興奮する魔理沙。　\n酒を酌み交わす典に「こう楽しむのですよ」と触られ…。　\n\n◆手淫：\n典は股間の勃起や乳首を白服の上から、　\n魔理沙は太もものタイツ内で勃起しその上に穿いたソックス越しに手淫。　\n魔理沙のドロワは扱く部分が見える様に裾を捲り上げるか、ドロワの上から行うか、ドロワ無しでもＯＫ。　\n他は極力脱がさない。　\n2人とも射精染みができ、着衣越しにたくさん精液が漏れて流れる。　\n\n◆補足：\n魔理沙は普段から着衣オナの常習者。　\n（ソックスの凹凸線を描きこんでください）　\nタイツ・ソックスの扱く部分だけに日頃の着衣オナ射精跡が乾いて残り、精液でガビガビしている。　\n長文になりましたが、宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/17lqs7cxtm1W96jM-mxLsS9oWju4Wh_F6?usp=sharing", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@odenokaz/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cc338cf