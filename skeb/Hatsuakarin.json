rin/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 774537, "client_id": 1090471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13e052d5d903f4369e5a995babf3aff2", "srcset": "https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13e052d5d903f4369e5a995babf3aff2, https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6fe8622931c2b903d905822e8be63ca 2x, https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3de3e5e30104e9c739404e96e5ba9959 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b00a362eb28816a0d1aab9b6f369603", "srcset": "https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b00a362eb28816a0d1aab9b6f369603, https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bce0bbe9d145c5d13c63a0fb8c9f007d 2x, https://si.imgix.net/938f16de/uploads/origins/53d44e78-e560-4c31-9239-a496de0dc044?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83e734566b6daf14866f8d4b68946d7e 3x"}, "body": "Hello~\n\nYour art is really pretty and cute!\nI would love to request an artpiece of my Vtuber character Zuki Mya.\nShe is a cute and a bit chaotic catgirl who likes to game and eat snacks.\n\nIf possible a 16:9 canvas would be awesome, to use for sns and twitch. \nI would leave the pose and details to you, but something with her gaming with a controller in hands and maybe snacks around her would be great - the space around her can be a bit messy with wrappers, plushies, open game cases, things like that :)  it doesnt need to be fullbody, half or 3/4 works well too, whatever works best for you!\n\nThank you for considering my request <3\n\nhttps://imgur.com/a/zukimya-reference-H9DdGNx", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hatsuakarin/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 774537, "client_id": 8407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8679e9a7/uploads/origins/029d2676-3290-47cf-8e0b-b669200d21fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4e398a91562e92e70590b2663787b1c", "srcset": "https://si.imgix.net/8679e9a7/uploads/origins/029d2676-3290-47cf-8e0b-b669200d21fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4e398a91562e92e70590b2663787b1c, https://si.imgix.net/8679e9a7/uploads/origins/029d2676-3290-47cf-8e0b-b669200d21fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8f57a2030f4e5b5ecf89c847a11dd37 2x, https://si.imgix.net/8679e9a7/uploads/origins/029d2676-3290-47cf-8e0b-b669200d21fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93f0ebd24a2ac70964b9bd6ac7a35261 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8679e9a7/uploads/origins/029d2676-3290-47cf-8e0b-b669200d21fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eece7dfc2cdba2735ec3c4e9cd3f