mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc0e9437d513c841f7bd85523281374, https://si.imgix.net/8e886c66/uploads/origins/cc5ffcd1-6dbb-4e0d-a5e9-837a971b3487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1437eb7d1d41183085b1ed1d646616d 2x, https://si.imgix.net/8e886c66/uploads/origins/cc5ffcd1-6dbb-4e0d-a5e9-837a971b3487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a3d3deecf56306c04a6a95d1db5ea7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e886c66/uploads/origins/cc5ffcd1-6dbb-4e0d-a5e9-837a971b3487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c685e7bf40616ae6dd871b0061ca688", "srcset": "https://si.imgix.net/8e886c66/uploads/origins/cc5ffcd1-6dbb-4e0d-a5e9-837a971b3487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c685e7bf40616ae6dd871b0061ca688, https://si.imgix.net/8e886c66/uploads/origins/cc5ffcd1-6dbb-4e0d-a5e9-837a971b3487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=535dbe0cc69157ad88b323e88db52392 2x, https://si.imgix.net/8e886c66/uploads/origins/cc5ffcd1-6dbb-4e0d-a5e9-837a971b3487?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5757531ae18a986f8296d10cf8b276 3x"}, "body": "自我の画像欄先生はじめまして、先生のモノクロイラストが大好きです！\n今回は当方の創作カプを書いて頂きたく送らせて頂きます。\n\n書いて頂きたい内容\n詞音（女性ですがトップの男性役※宝塚歌劇団をイメージしてください）が舞台衣装（洋装）のまま、劇場の楽屋前で美々子から花束を受け取っている。\n\n見た目の注意点\n詞音\n･男性役ではあるが女性のような線の細さがある\n･胸を極力小さく書いてください\n･舞台の後の話なのでメイクをしています。\n美々子\n･幼めかつ可愛らしい、優しげな雰囲気にしてください\n･詞音とは恋人です\n･渡す花束ですが、彼女は花屋な為、花言葉などに拘っています。鈴蘭と白いバラを入れてください。\n\n職業や性格などについては詳しくは\n↓\nhttps://lit.link/milkgarden\n\n失礼がありましたら申し訳ないです、よろしくお願いします！\n\nhttps://photos.app.goo.gl/bmzULgrRmgJPG4U19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiganogazoran/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4029432, "client_id": 3544304, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a7618fbababe7dfe15476b03e8765f9", "srcset": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a7618fbababe7dfe15476b03e8765f9, https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e5fb0f4eadd0d7abf61b39a84cc6927 2x, https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d74e126393e695a7df735626c24d509 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7063120666ba4189eb4334e22eb264d", "srcset": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7063120666ba4189eb4334e22eb264d, https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cce5f53e5b2b436ceeb3af57c2c357c6 2x, https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36cc71756ed384321a3d7068a55b5207 3x"}, "body": "こんにちは！あなたの作品を見ましたが、その画風がとても気に入りました。私のオリジナルキャラクター（OC）を描いていただけないでしょうか？\n\n彼女は、ほとんど感情を表に出さない、一風変わった不思議な少女です。その様子は不気味で予測不能に映り、他者に対してはいたずら好きで自己中心的な一面も見せるため、本心が読みづらい存在です。不気味なものや医療器具、そして人体に興味を持っています。様々な形で頻繁に怪我をするため、時には包帯を巻いていることもあります \n\n何かアイデアや変更点があれば、何でも構いません！\n\n参考画像はこちらです：\nhttps://drive.google.com/drive/folders/1Ly4oxSsZpQzaXN8CgFJdKDPsXiuD8Soq?usp=drive_link\n\nご検討いただきありがとうございます", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiganogazoran/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3e5405d8/uploads/origins/b071b990-e0da-4b01-a77b-ff8d4ab9c7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=833582ddeca931c6c36c09ac22b6eda4", "srcset": "https://si.imgix.net/3e5405d8/uploads/origins/b071b990-e0da-4b01-a77b-ff8d4ab9c7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=833582ddeca931c6c36c09ac22b6eda4, https://si.imgix.net/3e5405d8/uploads/origins/b071b990-e0da-4b01-a77b-ff8d4ab9c7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41aac11e001feda0f7a724688a4af5df 2x, https://si.imgix.net/3e5405d8/uploads/origins/b071b990-e0da-4b01-a77b-ff8d4ab9c7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e129be9c381f7db9ecb1d90a3450c681 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4029432, "client_id": 3243168, "nc": 1}, {"path": "/@jiganogazoran/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4029432, "client_id": 2378340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b60f332fb2d3353794bc77dbc3bad1a7", "srcset": "https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b60f332fb2d3353794bc77dbc3bad1a7, https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b70495373355907740bd51df22cddbbc 2x, https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17f9ed46fd09c8499065e9d0f0e0e4c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42a06b8099fa7b8e682207bd1cc4443", "srcset": "https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d42a06b8099fa7b8e682207bd1cc4443, https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09322a7adb6385b2cc4193090e7c42f2 2x, https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4af4c419d2bf6e010a33684f8a4eb842 3x"}, "body": "はじめまして。\n作品の雰囲気と色使いがとても好きで、ぜひ描いていただきたく依頼いたしました。\n\n■ Aki（アキ）\n霧の町に転入してきた謎めいた少年。古典文学とロックが好き。水色の瞳を持ち、耳と唇に複数のピアスを付けている。顔には二本の傷跡があり、時々さらに小さな傷あとが現れる不思議な体質。\n\n■ Rika（リカ）\n町の旧家の娘で、穏やかで優しいがどこか掴めない少女。深い茶色の瞳を持ち、顔には五つのほくろがある。保健室を手伝い、標本作りと神秘学が好き。《黒薔薇日記》という夢の記録帳を持つ。\n\n■ 世界観\n一年中、霧に包まれた小さな閉ざされた町。町外れには昭和末期の施設跡が残り、不思議な噂がある場所です。\n\n参考リンク内のドール写真のような雰囲気で描いていただけると嬉しいです。包帯は少し多めのデザインだとさらに嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/ro6jz4rzm3y1pzflz7r1k/APxGHKwy42TOi1gVUhP3Rl8?rlkey=jt5c9anrp5cxgwlejq5v70gdr&st=ikvxbxqw&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiganogazoran/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4029432, "client_id": 930205, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ec295b609aa511d38ae0e8fd573f77", "srcset": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ec295b609aa511d38ae0e8fd573f77, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca864b3b174ee3b9605fefd276ecd7a 2x, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3b1ac5fa50795ec0aa29e03d0263067 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2453f569dae37f27d341094b8679072", "srcset": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2453f569dae37f27d341094b8679072, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59c72340e00298e433323be24da59166 2x, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4e86f39e91867d4fa7513fa66bd940f 3x"}, "body": "自我の画像欄 様\nはじめまして。\n以前からずっと自我の画像欄様の作品とても好きで、ぜひ今回、白黒の似顔絵をお願いしたくご連絡いたしました。\n髪色は黒または白のどちらでも構いません。\n髪型は斜め前髪で、長めのもみあげがあるショートヘアです。\n顔にほくろがあり、口元にピアスがあります。\n服装については、参考資料通りに描いていただいても構いませんし、自我の画像欄様のご自由な解釈で描いていただいても大変嬉しいです。自我の画像欄様の線の表現や雰囲気が本当に大好きです。\n\n▷こちらの作品の雰囲気が好きです\nhttps://x.com/jiganogazoran/status/2073232602266497345/photo/1\nhttps://x.com/jiganogazoran/status/2073029169114669121/photo/1\nhttps://x.com/jiganogazoran/status/2022605992597606877/photo/1\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1mZFZcvJK8Jm_K79JbMIPiGDS8n8Z7pt0?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiganogazoran/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4029432, "client_id": 2000866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f517fcacf6f20434db467019ea32853d", "srcset": "https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f517fcacf6f20434db467019ea32853d, https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67cf566c85da4c164aa892f4838a488c 2x, https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f959ea8fee3280ac2bc449e87180fcd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.n