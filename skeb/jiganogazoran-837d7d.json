igins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=09322a7adb6385b2cc4193090e7c42f2 2x, https://si.imgix.net/b0954225/uploads/origins/4cd97066-c5c5-4f21-afe3-32251d080bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4af4c419d2bf6e010a33684f8a4eb842 3x"}, "body": "はじめまして。\n作品の雰囲気と色使いがとても好きで、ぜひ描いていただきたく依頼いたしました。\n\n■ Aki（アキ）\n霧の町に転入してきた謎めいた少年。古典文学とロックが好き。水色の瞳を持ち、耳と唇に複数のピアスを付けている。顔には二本の傷跡があり、時々さらに小さな傷あとが現れる不思議な体質。\n\n■ Rika（リカ）\n町の旧家の娘で、穏やかで優しいがどこか掴めない少女。深い茶色の瞳を持ち、顔には五つのほくろがある。保健室を手伝い、標本作りと神秘学が好き。《黒薔薇日記》という夢の記録帳を持つ。\n\n■ 世界観\n一年中、霧に包まれた小さな閉ざされた町。町外れには昭和末期の施設跡が残り、不思議な噂がある場所です。\n\n参考リンク内のドール写真のような雰囲気で描いていただけると嬉しいです。包帯は少し多めのデザインだとさらに嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/ro6jz4rzm3y1pzflz7r1k/APxGHKwy42TOi1gVUhP3Rl8?rlkey=jt5c9anrp5cxgwlejq5v70gdr&st=ikvxbxqw&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiganogazoran/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4029432, "client_id": 930205, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ec295b609aa511d38ae0e8fd573f77", "srcset": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ec295b609aa511d38ae0e8fd573f77, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ca864b3b174ee3b9605fefd276ecd7a 2x, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3b1ac5fa50795ec0aa29e03d0263067 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2453f569dae37f27d341094b8679072", "srcset": "https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2453f569dae37f27d341094b8679072, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59c72340e00298e433323be24da59166 2x, https://si.imgix.net/50f12586/uploads/origins/76caf2f9-3d5b-494f-b690-86cc89076303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4e86f39e91867d4fa7513fa66bd940f 3x"}, "body": "自我の画像欄 様\nはじめまして。\n以前からずっと自我の画像欄様の作品とても好きで、ぜひ今回、白黒の似顔絵をお願いしたくご連絡いたしました。\n髪色は黒または白のどちらでも構いません。\n髪型は斜め前髪で、長めのもみあげがあるショートヘアです。\n顔にほくろがあり、口元にピアスがあります。\n服装については、参考資料通りに描いていただいても構いませんし、自我の画像欄様のご自由な解釈で描いていただいても大変嬉しいです。自我の画像欄様の線の表現や雰囲気が本当に大好きです。\n\n▷こちらの作品の雰囲気が好きです\nhttps://x.com/jiganogazoran/status/2073232602266497345/photo/1\nhttps://x.com/jiganogazoran/status/2073029169114669121/photo/1\nhttps://x.com/jiganogazoran/status/2022605992597606877/photo/1\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1mZFZcvJK8Jm_K79JbMIPiGDS8n8Z7pt0?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiganogazoran/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4029432, "client_id": 2000866, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f517fcacf6f20434db467019ea32853d", "srcset": "https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f517fcacf6f20434db467019ea32853d, https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67cf566c85da4c164aa892f4838a488c 2x, https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f959ea8fee3280ac2bc449e87180fcd4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2e2c449d1a519b19d453b14ff252c5f", "srcset": "https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2e2c449d1a519b19d453b14ff252c5f, https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30671f70a8b2d503715d71365302a3e2 2x, https://si.imgix.net/a35398b7/uploads/origins/fa31ca1a-f5f8-4380-8e84-81787e61d657?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e786f3f663fbc26860a81acb8cf2f2bc 3x"}, "body": "自我の画像欄様、いつも絵を拝見させていただいてます。絵柄や雰囲気がすごく素敵で大好きです！つきましてはオリキャラをリクエストしたく送らせて頂きます。\n\n以下設定文となります。資料の方は漫画(7P)立ち絵などありますので参照いただければと思います。\n\n名前:篝 八尋(かがり やひろ) \n◆性別:男  ◆一人称「私」 ◆身長168cm\n◆舞台設定:大正時代\n◆性格:おどおどしてて人見知り。絵を描くのが好きで主観的。のめり込むタイプ。けど共同アトリエ使用の折、八尋の風景画を気に入って世話を焼く友人は1人いる。\n◆容姿:黒髪長髪後ろ三つ編み。三白眼気味、クマがある。絵を描く時はたすき掛けをする。メインの着物はくすんだ薄青、袴は黒。中には開襟シャツで書生風。\n不眠、不健康、酒やタバコは嗜まないが薬は飲んでる。\n\n◆バックボーン\n売れない画家。金銭苦から自殺未遂をしたがやはり1人は嫌で死にきれなかった。そのため誰かのと心中を望むがそんな良い人はおらず、自分で想像上の女性を描いて共にしようと考えたが描いてるうちに絵の女性に恋をし最終的に自殺をやめた。偶像愛のダメンズです。\n\nお好みで描いていただけたらと思います！\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Vx2cy-94rwgYC62_wN0xFZd8DefDs3_U", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 408097, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "🦴𝔫𝔪𝔢 🦴ᴮₗₛₖ", "screen_name": "nnidotxx", "avatar_url": "https://pbs.twimg.com/profile_images/2069408060834250752/iKN_uV8s.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1223933104751906816/1735664127/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 594066, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kita", "screen_name": "kitachan0v0", "avatar_url": "https://pbs.twimg.com/profile_images/1316817048802979840/YJXuTikh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1454920898/1616063440/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 951222, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "402.", "screen_name": "__o_iii", "avatar_url": "https://pbs.twimg.com/profile_images/2038131351136976896/-MJNfAZn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1156594629732528129/1659889286/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skill