装（洋装）のまま、劇場の楽屋前で美々子から花束を受け取っている。\n\n見た目の注意点\n詞音\n･男性役ではあるが女性のような線の細さがある\n･胸を極力小さく書いてください\n･舞台の後の話なのでメイクをしています。\n美々子\n･幼めかつ可愛らしい、優しげな雰囲気にしてください\n･詞音とは恋人です\n･渡す花束ですが、彼女は花屋な為、花言葉などに拘っています。鈴蘭と白いバラを入れてください。\n\n職業や性格などについては詳しくは\n↓\nhttps://lit.link/milkgarden\n\n失礼がありましたら申し訳ないです、よろしくお願いします！\n\nhttps://photos.app.goo.gl/bmzULgrRmgJPG4U19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jiganogazoran/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4029432, "client_id": 3544304, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a7618fbababe7dfe15476b03e8765f9", "srcset": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a7618fbababe7dfe15476b03e8765f9, https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e5fb0f4eadd0d7abf61b39a84cc6927 2x, https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d74e126393e695a7df735626c24d509 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7063120666ba4189eb4334e22eb264d", "srcset": "https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1a-45b7-b7d0-0adb547b8c0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7063120666ba4189eb4334e22eb264d, https://si.imgix.net/1f9e3599/uploads/origins/37c218ac-7e1