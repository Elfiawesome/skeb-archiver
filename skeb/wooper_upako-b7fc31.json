を守り、他者を傷つけないような行動を心がけることが大切です。\n\n━━━━━\n\nこれは優しく諭すような話し方、といったところでしょうか\n「ここはこうした方がいい」と思う箇所があるならアドリブ/アレンジなどをしてもよろしいので、まずはひとつよろしくお願いいたします", "nc": 17, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@wooper_upako/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 2595096, "client_id": 2223302, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/5d59d284-c475-4204-9b99-a052edef02f7?response-content-disposition=inline&Expires=1780463550&Signature=mzhPGRx7kPri76n9sGknoDfM-00b0O-Nar4W1TCc9iLbiNrEsJNL5p~hQPG7xGTgf4eKwwoJzH2sMReNOw32G7ehGG5RwCT23BEvmZVD7c1mEiJAzg0GeIsjPj4ql4MQGt2y~WtPx9ATOhfL8cESapunzjUa2Daq2Xq94zeVZkjrV3ikf7xnwc9098nfPCfdAPQM3gC3kzOS~B6CgnNW-TIZeK0U8XQ~Yga6-vP0XxKnz6B9654pOdMfYvxbjaP3ZH-KX-2aiJ7wVxX6UqdHxfuym2slg0iE7cNCcihReCGb4KrcDCXZUfHi1xSVL3AAU3ojSASX~AfLuYA2m5BCnw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1722458787129528320%2FCdsp85lo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6cc59b64844437cd646fd28d65f174", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1722458787129528320%2FCdsp85lo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc6cc59b64844437cd646fd28d65f174, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1722458787129528320%2FCdsp85lo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4f4f54ccce7ca0499f8aa44b44a5c85 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1722458787129528320%2FCdsp85lo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9726d671936500ba477fbb0d5b96c26 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/621643fc-e994-40e9-8a3d-1c14ad4af909?response-content-disposition=inline&Expires=1