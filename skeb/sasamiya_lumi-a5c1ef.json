h=200&s=0f0166cd3224f2c61792b8a332a29290", "srcset": "https://si.imgix.net/d7e01c71/uploads/origins/87dfe1f1-5004-4599-8a45-1bd81199b5c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f0166cd3224f2c61792b8a332a29290, https://si.imgix.net/d7e01c71/uploads/origins/87dfe1f1-5004-4599-8a45-1bd81199b5c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf8675500545ed6734f39de47add6e02 2x, https://si.imgix.net/d7e01c71/uploads/origins/87dfe1f1-5004-4599-8a45-1bd81199b5c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1cd6778e4adf27c97cffad0d6a4a06a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7e01c71/uploads/origins/87dfe1f1-5004-4599-8a45-1bd81199b5c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29225ed3192de49d79ed37d819058364", "srcset": "https://si.imgix.net/d7e01c71/uploads/origins/87dfe1f1-5004-4599-8a45-1bd81199b5c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29225ed3192de49d79ed37d819058364, https://si.imgix.net/d7e01c71/uploads/origins/87dfe1f1-5004-4599-8a45-1bd81199b5c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5a7b7c5b677a6e1f34c3d2a11463700 2x, https://si.imgix.net/d7e01c71/uploads/origins/87dfe1f1-5004-4599-8a45-1bd81199b5c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8bd20689c634aa7d55dc7a8c05329e3a 3x"}, "body": "初めてイラストを依頼するので緊張します。\nイメージは私が魔女になって愛娘と呼んでいる私の愛犬を半獣化？イメージはコボルトっぽいです。\nにして頂いて、二人で森の奥で仲良く暮らしている。というイメージです。\n私は特に似ていなくても構いません。髪型だけ前髪ありのセミロングの癖毛で見た感じはゆるふわパーマに見えます。たれ目のへの字口ですｗ悪そうでも強そうでも変人っぽくても何でもOKです。\n名前にちなんで赤毛で目か服か小物でも構いませんがブルーを入れてもらえると嬉しいです。魔女っぽく見えれば大丈夫です。\n犬はもうすぐ9歳の黒のラブラドール♀です。犬としては高齢ですが9歳～12歳の幼女･･･幼犬･･･？くらいでお願いします。とにかく真っ黒です。夜になると紛れてどこにいるのかすら分かりません。ちょっぴりおデブなのでおなかはポッコリしているほうが愛しいと思います。前からみると耳が逆三角形になっています。ビビリな甘えん坊の内弁慶です。\nキャラクター化してもらいたいので背景はそんなに細かくなくて大丈夫です。ぼんやり森の奥で二人っきりなんだなと分かればOKです。服を嫌がりませんので服を着せて頂いても裸？でもどちらでも構わないです。\nササミ屋さんらしい魔女、ササミ屋さんらしい半獣？をお願いしたいです。がっつりファンタジーで！ｗ\n仲良く暮らすイメージなので生活感があるイラストだと嬉しいです。わりと自由に描いて頂いて結構です。\n出来上がったら個人的にプリントアウトしたり、自分専用で使うグッズにしても構わないでしょうか？\nできたらTwitterで自慢もしてみたいですｗ\nどの保存形式で貰ったらプリントアウトとかグッズ化に最適なのか良く分からないのでお任せします。\n犬の写真だけリンクしておきます。\n\nhttps://twitter.com/redblue_17523/status/1494643304264134661?s=20&t=vYixESiGHKarPaHogpHP_g", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1381029, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "suzuno", "screen_name": "suzuno3110", "avatar_url": "https://pbs.twimg.com/profile_images/1745636408021434368/kkrfwyqv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1396366491704991753/1771261656/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1426666, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねぎ(原稿中)", "screen_name": "negi_post_", "avatar_url": "https://pbs.twimg.com/profile_images/1937872725751762944/6XHpuSGQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1322826512/1686145678/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 1684532, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "るいきゅう", "screen_name": "999trpg", "avatar_url": "https://pbs.twimg.com/profile_images/1982796076508708864/swuwzIOK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/11777