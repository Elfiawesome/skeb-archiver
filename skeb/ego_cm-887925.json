rigins/e5a4f38c-97ae-48c6-9542-9c718cd85347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da04169580fc247bb75a783a2b04bb3f 3x"}, "body": "こんにちは！お世話になっております。\n毎度毎度かわいく描いていただきうれしいです！💕今回はこの間描いていただいた子の両親を描いてあげてほしいのです！並べたい…！料理上手でおだやかだけど子を失って精神がむしばまれてる儚げなお父さんと、血はつながっていないけど尊敬している黒魔術やらそこらへんに詳しい不思議なお母さんです！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1g4nWWVKL1miPZWLCSVEb5CK25hfy3-DS", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ego_cm/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4014550, "client_id": 3657402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e70eb7be4e651b47a671c580f1fd15b7", "srcset": "https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e70eb7be4e651b47a671c580f1fd15b7, https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=608a9224b4afcd4a0006fe78bfa61061 2x, https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dfcb79ffce026d3fc31e711252d6014a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23fd03122efa52f54600948b2d551bc5", "srcset": "https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23fd03122efa52f54600948b2d551bc5, https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=161feb644a0faaca32b58517de5f711d 2x, https://si.imgix.net/3cf9213a/uploads/origins/82043e70-34a0-4461-989f-6b1af120e866?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6368fea267f4870320648d7d62c72349 3x"}, "body": "初めまして、Heraと申します。\nたまたまイラストの方を目にし、その素晴らしいイラストに目を惹かれて今回依頼させていただきたくお伺いしました。\n\nCoC｢四季送り学園｣の自探索者（HO2 夏）の陽炎（かげろう）と「烏が群れては、極彩色｣の自探索者（HO2）の石世 唄音の計2名をリクエストさせていただきたいです…！\n\n構図は全てお任せ致します。\nもし金額が見合っていない、構図指定が必要な場合は再送いただけますと幸いです。\n\n◆キャラの詳細◆\n陽炎（かげろう）\n16歳/男/175cm\nシナリオ:｢四季送り学園｣\nHO2 夏\nイメージフラワー:リナリア（「この恋に気づいて」「乱れる乙女心」「幻想」）\n\nオカルト研究部「あび」に所属する、夏組の高等部2年生。\n蠱毒先生の言うことは絶対であり、それに反抗する者にはデッキブラシで鉄槌を下す。\n蠱毒先生に入学当初から片思いしており、「大人になったら付き合ってくれ」と毎日猛アピール中。振られても気にしないし、なんならポジティブに捉える。\n拾い食い常習犯であり、何かと拾い食いやつまみ食いをしては蠱毒先生にやんわりと注意されている。\n特技はバッティングとサバゲー、パルクール。勉強も好きだが、体を動かす方のが好きだったりする。\n\n妖艶な顔立ちから、女子生徒からの人気が高いが、本人は蠱毒先生一筋である。\n\nURL▶︎ https://drive.google.com/drive/folders/14oqR9UcuHxsSj_Q_F6nLHq31XLEvergi\n\n\n〇石世 唄音（せきせい うたね）\n17歳/男/166cm \nシナリオ:鳥が群れては、極彩色\nHO2 大空を求める鳥\nイメージフラワー:カーネーション（緑）（「癒し」「純粋な愛情」）\n\n公開NPCである逆様 八に守られている烏黒の衆の姫。\n姫と言っても性別は男性であり、性格も相まって勘違いされやすい。\n優しく穏やかで純粋な性格であり、恐らく1番年下である。\n見た目の服装は本人の趣味ではなく、あくまで八の為。\n本人は「八くんがそれで喜ぶなら、良いかなぁって」といった感じであまり気にしていないようだ。\n金属バットとナイフの扱いに長けており、\n状況に応じて使い分ける。\nが、基本は金属バットで殴る事のが多い。\n歌を歌うのが好きであり、歌で人を笑顔にするのが何よりも嬉しい。\n\nURL▶︎ https://drive.google.com/drive/folders/1uXfJSkP0DCvkbobIzqVWviEoxfnn6hEQ\n\n◇使用用途◇\n自陣への共有、個人鑑賞、TRPGにてキャラ駒への使用（その際名前やIDを記載いたします）、非商用の個人用グッズの作成\n\nお忙しい中大変恐縮ですがご一考いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ego_cm/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4014550, "client_id": 3655545, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eea