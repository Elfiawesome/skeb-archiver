0&h=200&blur=200&s=655580455f2989178a1caacb8fe8f7c3", "src_set": ""}, "body": "またまたこんにちは！僕のタイガー・ロリのキャラクターを描いてくれないかな！\n\n白いアイススケート靴を除いて、全裸で描いてほしいんだ。https://imgur.com/a/wadiNiP\n\nhttps://skeb.jp/@miyakon22/works/90 前回の依頼のKayoのような表情とポーズが理想です。\n\nhttps://imgur.com/a/captain-sabertooth-taiga-snow-angel-otokoneko-5D9ODJ1", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyakon22/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 98207, "client_id": 809853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35ad0ae6/uploads/origins/55799c2e-8178-4e8a-9284-79552ed11fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42284f2fda1db3aab3d6dc39ba581018", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35ad0ae6/uploads/origins/55799c2e-8178-4e8a-9284-79552ed11fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f931f31dc5a8363021edb1262bd6c93", "src_set": ""}, "body": "ヴァンパイアの女の子を描いてほしい。\n赤い目とブロンドの髪。\n髪型は姫カット。\n胸は完全に平らで、肋骨が見えていること。\n\n胴体を露出した血のように赤いドレスを着ていること。しかし、性器は見えてはいけない。\n\nhttps://imgchest.com/p/o24aaaaz34l", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyakon22/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 98207, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/afaf083a/uploads/origins/95b4dc3b-79cb-4693-8c0c-e7c5aa53c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=688a739e54840458b8e47ed7ead8266e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/afaf083a/uploads/origins/95b4dc3b-79cb-4693-8c0c-e7c5aa53c1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26731ae5d3b9869f04424392aa18a6a4", "src_set": ""}, "body": "こんばんは、いつもpixivの方で作品を拝見し、楽しませてもらっています。少女と少年が裸で立って我慢できずにおしっこをしている、というイラストを依頼したいです。洋館風の暗い背景（省略して色、影のみでも）に、シャツやブラウスを開けて羽織り（胸や下腹は隠れていない）、靴下と少女のみ髪のリボンにアクセサリーをつけている。二人共陰毛は生えていて、少女は茶色の髪に緑の目の色、少年はおまかせします。横目でこっそりお互いのおしっこが出ている部位を見ている感じでお願いします。大や全裸、着衣の差分も可能でしたら、無しでも良いです。尿の色は琥珀色が好きです（癖）水たまりも好きです、よろしくおねがいします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyakon22/works/92", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5f30da4a/uploads/origins/d31846a7-7ae9-428d-a40a-1801324aa890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0aa4e8ee7a0916f772da3d9b087e58c3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 98207, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@miyakon22/works/91", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9c0280ff/uploads/origins/5b2c2102-4124-453a-a576-7d255ef13487?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=680b30bb0fe35a157522bdf3b4fcf445", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 98207, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@miyakon22/works/90", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 98207, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e58e1c3/uploads/origins/8b215586-87f8-4dd4-ae7a-1966be740b43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb676f588fd66c025f82a338c946e22", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e58e1c3/uploads/origins/8b215586-87f8-4dd4-ae7a-1966be740b43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15ea3b734b459af0531f942ebc9a1b5f", "src_set": ""}, "body": "よろしければ、「僕だけがいない街」の雛月加代ちゃんと藤沼悟くんのイラストをお願いします。二人は裸で並んでいます。別に設定はありません。\n\n加代は無表情。この状況を恥ずかしいとは思っていない。胸は平らで陰毛はない。\n\n悟は加代の裸を強く意識している。顔を赤らめ、目をそらしている。おちんちんは小さく、陰毛は生えていない。可能であれば、勃起しているとしていない差分が見たい。差分が無理ならしていないだけをお願いします。\n\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/u/0/folders/1z5dNFlDYDLTPa8DZCB6mn17vwu8JPHpS", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyakon22/works/89", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 98207, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/265a25fe/uploads/origins/60df874e-fb57-403e-bc6b-b27479f63d60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207865a85d97391cd11504d6d1a43a89", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/265a25fe/uploads/origins/60df874e-fb57-403e-bc6b-b27479f63d60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a174d8471eda6326ff6db707faabb87", "src_set": ""}, "body": "こんにちは。机の角でオナニーをするリゼ・ヘルエスタさんのイラストをお願いしたいです。\n顔と身体の前面が見えるようにお願いしたいです。\n脱衣差分があるとたいへんありがたいです。脱衣の場合でも直接は不衛生なので下着は履いているとさらにありがたいです。\nご検討の程よろしくお願い致します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genr