ホール \"というあだ名までつけられている。\n\nバックストーリー彼は密かにファエトンであるが、ギリシャ神話（戦車と転落）に反して、代わりに酔っぱらって演説をした。屈辱的な扱いを受け、引きずられた後、彼は号泣し、誰も自分に同情していないことに気づいて動揺し、川に入る。彼は不思議な力を得て、自分を変えた。\n\n美術の提案としては、彼が森の川でカエルに出会い、それを城やテラリウムで飼うこともできたが、最後にはカエルを放すことにした。\n\n注：彼の服装をシンプルにすることができます。\n\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1VRb-ILoM5jrgsT2lf-ARbt9kijux8PFD?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@170mmm170/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 51214, "client_id": 3501536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d06a963/uploads/origins/ce5bff79-158d-4833-88c1-ecff072ce249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08fb67eb8e43e534054761e35331c428", "srcset": "https://si.imgix.net/5d06a963/uploads/origins/ce5bff79-158d-4833-88c1-ecff072ce249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08fb67eb8e43e534054761e35331c428, https://si.imgix.net/5d06a963/uploads/origins/ce5bff79-158d-4833-88c1-ecff072ce249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb48cc0b8bb295ca98dd0a9563e7c563 2x, https://si.imgix.net/5d06a963/uploads/origins/ce5bff79-158d-4833-88c1-ecff072ce249?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bd4a633c2df600f50d00342f323006b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d06a963/uploads/origins/ce5bff79-158d-4833-88c1-ecff072ce249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803c3e036f4378a205e7efa14868425a", "srcset": "https://si.imgix.net/5d06a963/uploads/origins/ce5bff79-158d-4833-88c1-ecff072ce249?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=803c3e036f4378a205e7efa14868425a, https://si.imgix.net/5d06a963/uploads/origins/