海の家、露天のシャワールームなど）\n\n【その他】\n·手指と足指にマニキュア/ネイルが塗ています\n·肌のツヤ感を表現するハイライトを多めに加えていただけると嬉しいです\n\n金額に不備がある場合は再送やキャンセル頂いて問題ございません\nお忙しいところ恐縮ですが、ご検討のほど宜しくお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 408023, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "獅ノ宮れお／🎨V／7月以降のお仕事募集中", "screen_name": "leonis_g", "avatar_url": "https://pbs.twimg.com/profile_images/2025338060230340608/dxo-k2Hi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3980669425/1771713233/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 536207, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "渋茶漬け", "screen_name": "Sibutya_814", "avatar_url": "https://pbs.twimg.com/profile_images/1953092823773003780/CMWMtNwA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2884610899/1754466828/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 572919, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "黒峯ぽむこ", "screen_name": "pomkokuromine", "avatar_url": "https://pbs.twimg.com/profile_images/2016054157262655489/iRCjVPNk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1091615264494374912/1756647116/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_