\n設定をつらつらと描かせていただきましたが、構図等はお任せで、服装はリンク先にあります二つのうちのどちらか、もしくはご自由に着せて頂いて構いません！\nぜひよろしくお願いいたします……！！\n\nhttps://drive.google.com/drive/folders/1UJxDvcfIaeLGxMOzUpiCdxKHf24YMimo", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YTepid2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 93283, "client_id": 2984555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbe4f8aa/uploads/origins/5382a391-4cab-4a75-b105-449ce0bd80c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fec4edfbe5d90095a8927d2602b9922b", "srcset": "https://si.imgix.net/bbe4f8aa/uploads/origins/5382a391-4cab-4a75-b105-449ce0bd80c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fec4edfbe5d90095a8927d2602b9922b, https://si.imgix.net/bbe4f8aa/uploads/origins/5382a391-4cab-4a75-b105-449ce0bd80c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5a85b4e6bcc810bd6798bebf60f3cbc 2x, https://si.imgix.net/bbe4f8aa/uploads/origins/5382a391-4cab-4a75-b105-449ce0bd80c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3aabe947c18cd19b9e52e84482c59373 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbe4f8aa/uploads/origins/5382a391-4cab-4a75-b105-449ce0bd80c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed391ecc3d661791cd016757b771c5b4", "srcset": "https://si.imgix.net/bbe4f8aa/uploads/origins/5382a391-4cab-4a75-b105-449ce0bd80c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed391ecc3d661791cd016757b771c5b4, https://si.imgix.net/bbe4f8aa/uploads/origins/5382a391-4cab-4a75-b105-449ce0bd80c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c2e1271963090ce8d6c711a890dadb9 2x, https://si.imgix.net/