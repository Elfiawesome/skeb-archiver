でお願い出来ますでしょうか？\n指定した部分はアレンジもしくは変更して頂いても大丈夫です。\n\n以上になります。\n是非先生の絵柄でイラストを描いて頂きたくリクエストをさせて頂きました。\nご検討頂ければ幸いです。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YTepid2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 93283, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eec0528e285df962762cc61e1eb4d240", "srcset": "https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eec0528e285df962762cc61e1eb4d240, https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=064a73de99052cc13679590ad39413e3 2x, https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0d656df2d5b24bb40eb0e636c5db547 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eadc038bf6a7d9336b24d4a8b6dc60bd", "srcset": "https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eadc038bf6a7d9336b24d4a8b6dc60bd, https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c977ffdfa0bb0137fe9a1182aef87b88 2x, https://si.imgix.net/a9a9b3c2/uploads/origins/d6c03ea7-e097-4f08-81a7-9312ebed8c4b?bg=