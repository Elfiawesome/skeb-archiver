）\n＝＝＝＝＝＝＝\n\nもし可能であれば、イラストを制作するにあたって、\nどのようなことを考え、どのように表現として落とし込んだのか等、\nコメントもいただけたらとても嬉しく思います…！\n\n楽しく描いていただけたら幸いです。\nご検討のほどよろしくお願いいたします！\n\nペモリン／TAIL’S LAB\n\nhttps://drive.google.com/drive/folders/1tWb3c-sF6jwqVntx2kuXj30jvLIQ9TXy?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kasuka_ml_LG/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 3058374, "client_id": 3291046, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/d7d2b7a1-3d62-4f25-b44d-2449ec1ac478?response-content-disposition=inline&Expires=1794558020&Signature=OU8uwYzKj5VoRMyIWNFDkmE8KPl7~A3h4mudMnl1LCzXJrCEj6zxpDSfqnKUn4YQqExQEJlhQmXd95Jgmtyi4CYgXlPFISBi~JPmHSXIoFq3wCnXtvMF9F7bZCjZ3gL3uVA9yekCe-oftbt-dGYBrdhuHA7g-A0RcgknWSyJyoxoZMAKATRcaDyYCMP~ZCUrTCs8TCHHYfXDy9RagzVXp06RTRbEAaqIi77m~afctFKcok7B0UDHkxgH9xA1HoYL9k~wXZFE4IRbSQFXXsOOrSCAkgpRyZ4FhPwK-~zYu9D3RNQL-KC5wKy5TTC7JX47cRsrad~WBbYQCfWr0OcH2g__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2097680140616773632%2FI_iRuD_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d49a5b8269631eb19c696d69d9fb4e9", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2097680140616773632%2FI_iRuD_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d49a5b8269631eb19c696d69d9fb4e9, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2097680140616773632%2FI_iRuD_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f452544795e8f50e03f3378e19520649 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2097680140616773632%2FI_iRuD_7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5358a44a37383e92e4b8ae3d3864701b 3x"}, "preview_url": "https://f