4405a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90e143f5612dafaf2839d6e1ba6c86ed 2x, https://si.imgix.net/f2b442b6/uploads/origins/15fc8cca-6826-46d3-9a3a-908e2584405a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=365d49c3e2c33b2472b094c09db709dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2b442b6/uploads/origins/15fc8cca-6826-46d3-9a3a-908e2584405a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf1c8199b1e033f20986396e72c34583", "srcset": "https://si.imgix.net/f2b442b6/uploads/origins/15fc8cca-6826-46d3-9a3a-908e2584405a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf1c8199b1e033f20986396e72c34583, https://si.imgix.net/f2b442b6/uploads/origins/15fc8cca-6826-46d3-9a3a-908e2584405a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17a3efaad9a28676b27c6310f1093471 2x, https://si.imgix.net/f2b442b6/uploads/origins/15fc8cca-6826-46d3-9a3a-908e2584405a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6970e15a883b46d2ff1e765db889276 3x"}, "body": "こんばんは。\n以前描いて頂いたビントロングボムが非常に気に入っておりまして、その子をもとに一枚絵として描いていただけたら…と思い、今回ご依頼いたしました。\n\n背景込みでパソコンの壁紙などにも使えるような構図・雰囲気を希望します。\n背景については基本的にお任せしますが、下記のような雰囲気だと有難いです。\n・警報灯が点滅するような施設\n・他の兵器が眠る古びた倉庫の奥\n・廃遊園地\n・錆びた書棚の前で本の上に鎮座\n\n全体として目が離せない印象が出ると嬉しいです。\nアレンジや装飾、構図の自由度はお任せします。可愛くて不穏で危うさのあるキャラクター性が活きる形で仕上げていただけましたら幸いです。\n\nご検討いただけましたら幸いです。\n素敵な作品をとても楽しみにしております。どうぞよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kasuka_ml_LG/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 3058374, "client_id": 872704, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/18d8f259-1426-4b9e-837a-c505c5ef920c?response-content-disposition=inli