図などは完全におまかせします！！！\n指輪が映る場合は、シンプルでつるっとしたデザインを想定しております。\n衣装については結婚式をイメージしたものだと非常に嬉しいです。\n\nまた、制作いただいたイラストは、「幽枯モルグリリー」・「沢田汐」両アカウントからSNSにアップしたいと考えております。\nSNSアップ用の透かし付き画像をご用意いただける場合は、そちらで投稿させていただきたいと思っております。\n\nお忙しい中とは存じますが、この機会に最高の思い出を頂ければ幸いです。\nご無理のないよう、お身体ご自愛くださいませ。\n\n幽枯モルグリリー", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekomelonRURU/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1099731, "client_id": 3058374, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31606557/uploads/origins/196ccedf-9d93-4e34-b6c1-fd3b719a4451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a942598d765d7938dd26b958b176ffcc", "srcset": "https://si.imgix.net/31606557/uploads/origins/196ccedf-9d93-4e34-b6c1-fd3b719a4451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a942598d765d7938dd26b958b176ffcc, https://si.imgix.net/31606557/uploads/origins/196ccedf-9d93-4e34-b6c1-fd3b719a4451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec49b921f77e50f70db3f683f439d058 2x, https://si.imgix.net/31606557/uploads/origins/196ccedf-9d93-4e34-b6c1-fd3b719a4451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6099dd81a727f5d77c12ce4ce18e9bff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31606557/uploads/origins/196ccedf-9d93-4e34-b6c1-fd3b719a4451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79ecff43cedfdc26c2df175288d339f0", "srcset": "https://si.imgix.net/31606557/uploads/origins/196ccedf-9d93-4e34-b6c1-fd3b719a4451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79ecff43cedfdc26c2df175288d339f0, https://si.imgix.net/31606557/uploads/origins/196ccedf-9d93-4e34-b6c1-fd3b719a4451?bg=%23fff&auto=format%2Ccompress&