2-96c0-4709-be31-cf8776785496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7246298ff64c97ce5cca204442f03823, https://si.imgix.net/76f96849/uploads/origins/69b8d392-96c0-4709-be31-cf8776785496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a7bac0156564b4151259e1fd1b9ae6d 2x, https://si.imgix.net/76f96849/uploads/origins/69b8d392-96c0-4709-be31-cf8776785496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e4c18fa569771e69ac62e336a9406c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76f96849/uploads/origins/69b8d392-96c0-4709-be31-cf8776785496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b93eba574d372dbd4f7dfb89f0586f55", "srcset": "https://si.imgix.net/76f96849/uploads/origins/69b8d392-96c0-4709-be31-cf8776785496?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b93eba574d372dbd4f7dfb89f0586f55, https://si.imgix.net/76f96849/uploads/origins/69b8d392-96c0-4709-be31-cf8776785496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe1e339a934f549dace3d1f1927a6bc3 2x, https://si.imgix.net/76f96849/uploads/origins/69b8d392-96c0-4709-be31-cf8776785496?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=202c30c2d077913ab758ddc6364e6fcc 3x"}, "body": "392様、はじめまして！\nSkeb新着欄より、イラストのかわいらしい絵柄やポップな色味に惹かれ、\nこの度はTRPGで遊んでいるうちよそのOCを、ぜひ392様に描いていただきたくリクエストさせていただきます。\n\n▽関係\n自由奔放な探偵と苦労人の助手/両片想いの幼馴染\n\n▽キャラクター\n①【玉木 奈胡/たまき なこ】\n・探偵\n・161cm、29歳\n・ローテンションでマイペースだが、粘り強くタフな性格\n・感性が独特で、趣味は石碑的なオブジェやゆるキャラなどの置物収集\n・事務所の経費で趣味のものを買うので鏡に叱られている（が、なんだかんだ許されている）\n・幼少期の鏡を探偵助手ごっこに巻き込んだ延長線で鏡を頼った\n・中高時代には鏡を異性として意識していた時期もあったが、関係性を壊したくなくて適度な距離感を保っている\n・鏡と恋仲になったら、関係が終わったとき幼馴染にも戻れないのではと思い恋愛に前向きでない\n・鏡にももっと自分のことを頼ってほしい\n\n②【鏡 遙真/かがみ とうま】\n・助手\n・174cm、30歳\n・兼業助手。本業は弁護士\n・主に経理や契約関係を請け負っているはずが、調査にも駆り出されている\n・外面は穏やかだが、気を許している玉木相手には自然体で軽口が多い\n・自分がエリートであることを自覚していて尊大\n・他人に弱みを見せたくない。玉木には猶更\n・幼少期に家族を亡くしており、玉木家にサポートしてもらったため一家に感謝している\n・玉木が恋愛関係を望んでいなさそうであるため、自分が恋情を抱いていることに罪悪感がある\n\nいただいたイラストは個人観賞のほか、友人間でのデータ共有などさせていただく予定です。\nシチュエーションや服装・構図に関しても、392様にお任せいたします！\nご縁がありましたらとても嬉しいです、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1uHTlJ4_Axb6PELxdkbWPgb9dsS1sS0_e?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@im_392/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3535613, "client_id": 3599694, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/595c927a/uploads/origins/9d210000-c575-4b0a-ba20-e20b0b8b4705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d721acd76c3b9f1dadca2703e8c89cad", "srcset": "https://si.imgix.net/595c927a/uploads/origins/9d210000-c575-4b0a-ba20-e20b0b8b4705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d721acd76c3b9f1dadca2703e8c89cad, https://si.imgix.net/595c927a/uploads/origins/9d210000-c575-4b0a-ba20-e20b0b8b4705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83aed4c18a5f40a10984b9a36b25325f 2x, https://si.imgix.net/595c927a/uploads/origins/9d210000-c575-4b0a-ba20-e20b0b8b4705?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=743fe7d922211b8b4d172565efbad403 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/595c927a/uploads/origins/9d210000-c575-4b0a-ba20-e20b0b8b4705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9314cda912b2e695aabc7d5837f805a", "srcset": "https://si.imgix.net/595c927a/uploads/origins/9d210000-c575-4b0a-ba20-e20b0b8b4705?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9314cda912b2e695aabc7d5837f805a, https://si.imgix.net/595c927a