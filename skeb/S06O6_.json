う)\n御相手様 ちょっと焦ってる、嫌がっている(？)照れている感じでお願いします。嫌がっていると言っても満更でも無い感じです🐾\n\nイラストのサイズは長方形（横）でお願いしたいです。背景や小物などの希望はございませんのでおまかせ致します🙇🏻‍♀️\n\n容姿や関係性などは資料のURLに添付させていただきます。 当方スケブ不慣れで不備等ございましたら申し訳ありません💦お忙しい中ですがご縁があるように祈っております。よろしくお願いします💐\n\nhttps://photos.app.goo.gl/qqxiwrmEuA3vQvMeA", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@S06O6_/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/38b405df/uploads/origins/04092282-73f1-4ab6-a754-84cd9fbae364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c52cd7015405cb8addeb23a09d0d39d0", "srcset": "https://si.imgix.net/38b405df/uploads/origins/04092282-73f1-4ab6-a754-84cd9fbae364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c52cd7015405cb8addeb23a09d0d39d0, https://si.imgix.net/38b405df/uploads/origins/04092282-73f1-4ab6-a754-84cd9fbae364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c3ceea746359d74440219d073da5270 2x, https://si.imgix.net/38b405df/uploads/origins/04092282-73f1-4ab6-a754-84cd9fbae364?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0106a4be43d4208a7898ad7669e27830 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1732557, "nc": 0}, {"path": "/@S06O6_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c59e3cb9/uploads/origins/f7d4ee4e-45ba-460b-988f-8a6ec05172e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a0