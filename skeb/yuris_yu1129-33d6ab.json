春をしていくことになります。\n\n売春を重ねるごとに女の喜びの味を覚えていき、最終的に肥えた金持ちの目に止まり妾となり性技にメロメロになって男に戻ることも忘れてそのまま妊娠、身も心も女となりボテ腹になってからも主人のために進んでセックスしていきその後出産、\n産んだあとも授乳しながら次の子を仕込んでもらうなど完全に女として生きていくというお話が読みたいです。\n\n長々となってしまいましたがご検討よろしくおねがいします。", "nc": 184, "word_count": 12844, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@AlicitruSalt/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3586658, "client_id": 23893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4871d67/uploads/origins/f9287656-19e7-4b9d-a9a5-8b214c1b9ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0211b894cd515713ad59b457661c53", "srcset": "https://si.imgix.net/b4871d67/uploads/origins/f9287656-19e7-4b9d-a9a5-8b214c1b9ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd0211b894cd515713ad59b457661c53, https://si.imgix.net/b4871d67/uploads/origins/f9287656-19e7-4b9d-a9a5-8b214c1b9ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a2142d0863f6630b39e884eb046dda6 2x, https://si.imgix.net/b4871d67/uploads/origins/f9287656-19e7-4b9d-a9a5-8b214c1b9ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d68d15e1a1c1eaa6a53f8b240ac26da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4871d67/uploads/origins/f9287656-19e7-4b9d-a9a5-8b214c1b9ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72d42372572f424efccddcc4ba5e1ee5", "srcset": "https://si.imgix.net/b4871d67/uploads/origins/f9287656-19e7-4b9d-a9a5-8b214c1b9ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72d42372572f424efccddcc4ba5e1ee5, https://si.imgix.net/b4871d67/uploads/origins/f9287656-19e7-4b9d-a9a5-8b214c1b9ea9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&b