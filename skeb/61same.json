%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f643b52a7e1a18b4fccf7ac13876319f", "srcset": "https://si.imgix.net/2c4ddd5d/uploads/origins/c3f5c3d4-74f7-46b7-b28d-fc5fc0e03bfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f643b52a7e1a18b4fccf7ac13876319f, https://si.imgix.net/2c4ddd5d/uploads/origins/c3f5c3d4-74f7-46b7-b28d-fc5fc0e03bfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9064cdc34562bad34551fa86df2756f 2x, https://si.imgix.net/2c4ddd5d/uploads/origins/c3f5c3d4-74f7-46b7-b28d-fc5fc0e03bfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3dfd0396c120b7982c4704aef5f59bea 3x"}, "body": "安藤 言様\n\nこんにちは。\n以前、Skebにて「拝啓、贖イ郵便局の皆様へ」の立ち絵をご依頼させていただきました、エイと申します。\n\n今回は、TRPGで使用する「戦闘立ち絵および表情差分」を描いていただきたく、リクエストをお送りいたしました。\n至らぬ点もあるかと思いますが、どうぞよろしくお願いいたします。\n\n――――――――――\n【通過予定シナリオ】\n拝啓、贖イ郵便局の皆様へ\n\n【シナリオ資料・制服資料】\nhttps://x.com/helpen_hhh/status/1946948364698104055?s=20\nhttps://drive.google.com/file/d/1Nk0TcuxqtgDvZXFnMFnQJG_pVSzSPCGR/view?usp=sharing\n\n【ご依頼内容】\n前回描いていただいたキャラクターが、日本刀を手に戦っている姿をお願いしたいです。\n全体的にかっこよさを重視しつつ、どこか可愛さも残る雰囲気を希望しております。\n\n服装は、前回お送りした制服をベースにしていただけますと嬉しいです。\nそのほかの装飾や細かなデザインにつきましては、安藤様にお任せいたします。\n\n【表情差分】\n以下の4点を希望しております。\n・喜\n・怒\n・哀\n・目にハイライトのない無表情\n\n「喜」「哀」の表情につきましては、安藤様のおまかせでお願いできればと思っております。\n「怒」の表情のみ、怒りすぎて泣いてしまうような雰囲気で描いていただけましたら嬉しいです。\n\nポーズや構図につきましても、すべてお任せいたします。\n安藤様の好きな要素を取り入れていただけましたら、とても嬉しいです。\n\n【使用用途】\n・シナリオ通過時の立ち絵として使用\n・卓報告での使用　等\n\n上記内容で問題ございませんでしたら、お受けいただけますと幸いです。\nご検討のほど、どうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@61same/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 115919, "client_id": 3068529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0fbe90df69fb8e39937911665f70a0", "srcset": "https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0fbe90df69fb8e39937911665f70a0, https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0d446d4241f7a4159a920669c862539 2x, https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbf36fbeb6d1cd638e24f4b03f4db22c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2444fae27edcb3dcca6d207183314fc2", "srcset": "https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2444fae27edcb3dcca6d207183314fc2, https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c76d4dc7c243efaf91ff8897df741e83 2x, https://si.imgix.net/99a64cc8/uploads/origins/900d25d0-b21d-4b0e-87f7-4718b598f1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0441dca83449d1a07e3fd4d0082dc5ee 3x"}, "body": "安藤 言様、こんにちは！私、エイさんと申します。\nいつも可愛くて素敵なイラストや立ち絵を拝見しております。\n\n今回は、TRPGで使用する立ち絵を書いていただきたく、初めてSkebでリクエストさせていただきました。\n至らぬ点が多いかと思いますが、宜しくお願い致します。\n\n\n【通過予定のシナリオ】\n拝啓、贖イ郵便局の皆様へ \n\n【シナリオ資料・制服資料】\nhttps://x.com/helpen_hhh/status/1946948364698104055?s=20 \nhttps://drive.google.com/file/d/1Nk0TcuxqtgDvZXFnMFnQJG_pVSzSPCGR/view?usp=sharing　\n\n【希望内容】\n白うさぎをイメージとした、背の低めな可愛い男の子をお願いしたいと考えています。\n武器が日本刀のため、後ろに背負っていてくれると嬉しいです。\n目は、左に朱色に近い赤と右にオレンジのオッドアイでお願いします。\n\n性格は明るくかわいい子を予定しています。\n服装は、お送りした制服を元に描いてくださると嬉しいです。制服のカラーリングなどは変えずにお願いします。そのほかの装飾などは、安藤様にお任せします。\n安藤様の好きな要素を入れてくださると嬉しいです。私がとても嬉しいです。\n\n髪形、ポーズや構図なども\nすべておまかせいたします\n\n全体的に可愛く、仕上げてもらえたら嬉しいです！\n\n【使用用途】\nシナリオ通過時に立ち絵として使用\n卓報告に使用\n\nこちらの条件で問題ない場合は、お受けいただけたら嬉しいです。\n\nご検討、どうぞよろしくお願い致します！\n\nhttps://drive.google.com/file/d/1Nk0TcuxqtgDvZXFnMFnQJG_pVSzSPCGR/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@61same/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 115919, "client_id": 3792204, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655f0679e41e97f08cd6b7360dc96aad", "srcset": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=655f0679e41e97f08cd6b7360dc96aad, https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5515661d0110bdfa03d43c9f9a5b4736 2x, https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db5156e36159cc0e78dba3a59b380fe8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0ac19330ec0f12e62268a7afcd32453", "srcset": "https://si.imgix.net/3d198b86/uploads/origins/25796676-018e-4737-90a9-2e526a75e6c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0ac19330ec0f12