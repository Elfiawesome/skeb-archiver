core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8f2ca34/uploads/origins/429135ca-3fed-40f0-b775-2fc8c3b7dabb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47e80290e33855cb69fd3d4b274f0f42", "srcset": "https://si.imgix.net/a8f2ca34/uploads/origins/429135ca-3fed-40f0-b775-2fc8c3b7dabb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47e80290e33855cb69fd3d4b274f0f42, https://si.imgix.net/a8f2ca34/uploads/origins/429135ca-3fed-40f0-b775-2fc8c3b7dabb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea2968fd16c921ef11fd2bb12ecfe5a5 2x, https://si.imgix.net/a8f2ca34/uploads/origins/429135ca-3fed-40f0-b775-2fc8c3b7dabb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=656d0d91c92bc2f1359651d34ebea42b 3x"}, "body": "Nice to meet you, my name is Runarin.\n\nI really like the style of skeb that Tsubaki Yumeji used to draw and I would like to request our child in the same way if you don't mind.\nhttps://skeb.jp/@kurutteiruno/works/5\n\nIntended use : Icons, wallpaper, etc. for personal use\nPreferred delivery format: psd file with layered address, etc. would be greatly appreciated.\n\nReference material: https://twitter.com/ruaruaka/status/1599264746586673155?s=46&t=QgpJgKq_zmWSvjQPfXST-g\n\nHair color/eye color: Mocha -> Pink\nImage curler: pink\nMotifs: Sweets, ribbons, hearts\nShe works at a maid cafe.\n\nI would like to leave the outfit to Yumeji-Tsubaki and hope for a cute outfit.\nWe would like to leave the composition and pose up to you.\n\n\nThat's all.\nThank you very much for your consideration.", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurutteiruno/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2308909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8284cf83c384cdbe9157a0554cceb519", "srcset": "https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8284cf83c384cdbe9157a0554cceb519, https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac14e8d7f70e22f3304e381bbb19703c 2x, https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90f09670efe55b2cd1444211d8044922 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22a85ef85ac3a1d54b5dc6c53ba373a6", "srcset": "https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22a85ef85ac3a1d54b5dc6c53ba373a6, https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f53c96e7696f83d769d79f73911fa466 2x, https://si.imgix.net/d02c163c/uploads/origins/5941bdfb-58c3-4b68-a848-d5876ccefc2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9393e2f3f9b727fcd75dbc98540fa03b 3x"}, "body": "Thank you so much for your previous help with Mayaka. I loved it so much.\n\nWould you be interested in another piece for Mayaka Ibara?\n\nCharacter: Mayaka Ibara from Hyouka \n\nPose/Expression: Mayaka eating sweets, anything you choose is perfect. I really liked the blue jelly here for an example! https://twitter.com/kurutteiruno/status/1587446226080800768/photo/2\n\nOutfit: Anything cute and cool please. I am happy with anything.\n\nThank you for your consideration, I understand if this is not possible.", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurutteiruno/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2308909, "client_id": 2434449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b870b32e/uploads/origins/0d06eae0-322d-4c42-aa80-29173f4ec3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5bb9c74fd144ac3c417f0eca4c6bfa", "srcset": "https://si.imgix.net/b870b32e/uploads/origins/0d06eae0-322d-4c42-aa80-29173f4ec3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5bb9c74fd144ac3c417f0eca4c6bfa, https://si.imgix.net/b870b32e/uploads/origins/0d06eae0-322d-4c42-aa80-29173f4ec3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7a0ca71d1856d25b852e579880b3011 2x, https://si.imgix.net/b870b32e/uploads/origins/0d06eae0-322d-4c42-aa80-29173f4ec3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f5a58a9cf79e80f068779e8f8fedc13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b870b32e/uploads/origins/0d06eae0-322d-4c42-aa80-29173f4ec3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=236844fdc217004c85966a395f0e552a", "srcset": "https://si.imgix.net/b870b32e/uploads/origins/0d06eae0-322d-4c42-aa80-29173f4ec3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=236844fdc217004c85966a395f0e552a, https://si.imgix.net/b870b32e/uploads/origins/0d06eae0-322d-4c42-aa80-29173f4ec3dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a44