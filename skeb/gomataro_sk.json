ppeals_count": 2, "received_works": [{"path": "/@gomataro_sk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3720270, "client_id": 3069864, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/369580d1/uploads/origins/28abc57b-383f-457b-8f0c-f243c80ee04f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=784b1b4fa5e2622971f0daf159be712b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/369580d1/uploads/origins/28abc57b-383f-457b-8f0c-f243c80ee04f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f328fa1eeae27a65644b38f12dd22f6", "src_set": ""}, "body": "ごまのすけ様\n\nはじめまして、個人VTuberとして活動している御神ツミカと申します。\nごまのすけ様のイラストを拝見しまして、絵柄がとても好みだったためリクエスト失礼いたします。\n\n【使用用途】\n・YouTubeチャンネルでの使用、Xでの使用\n・ファンクラブサイトでの投稿\n・グッズ化やファン向けの壁紙配布などの商用利用(不可な場合はキャンセルしていただけると幸いです)\n\n料金に不足がございましたら再送要請をお願いいたします。\n\n【依頼内容】\n◆お正月や新年をイメージしたイラストをお願いしたいです\n◆着物や和服を着せていただけたら嬉しいです。髪型、表情、ポーズなどはお任せいたします。\n◆顔周りの左右が見切れないようにしていただけると助かります！\n◆背景透過のデータもいただければ幸いです。\n\n【キャラクター性】\n◆普段は普通の女子高生、素顔は教団で活動している教祖です\n◆しっかり者でカリスマ性を持っていますが、時々抜けているところがあります\n◆謎解きと紅茶が好きです\n◆その他、不明瞭な点は自由な解釈で描いていただければと思います\n\n何か不備がございましたらすみません。\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1XzysVKjAn3Njk6jarP3sfTAInsdvIwrx?usp=drive_link", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gomataro_sk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3720270, "client_id": 2849311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d346978/uploads/origins/c687ee4d-f306-4540-8897-912a8b0f3c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e7e02629004c05da78c37f34642b1c2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d346978/uploads/origins/c687ee4d-f306-4540-8897-912a8b0f3c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72596d596183f0b3089fc7db27e61db0", "src_set": ""}, "body": "はじめまして！\n個人勢VTuber 小鳥遊 千鶴（たかなし ちづる）と申します！\n\nこの度は大変素敵なアピール、本当にありがとうございます。\n\nぜひご縁を結んでいただけたら幸いだと思い、この度ご依頼失礼いたします。\n\n人物:小鳥遊 千鶴\n\n使用用途:サムネ・壁紙・グッズ・おはV等\n\nサイズ、構図:イラスト拝見させていただいたのですが、本当にSDも等身も可愛すぎて選べません…！！！ごまのすけ様のお好きにしていただいて構いません！（白い角、赤いお目目、黒髪であれば髪型服装自由でございます！）\n\n宛名がある場合は別にしていただきたいのと、PSD又はPNG納品ですと助かります。\n\nぜひ楽しんでお好きに描いていただければと思います。\n\nどうぞよろしくお願いいたします！\n\nhttps://lit.link/KotoritoTsuru\nhttps://x.com/kotori_to_tsuru", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1268584, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しゃけ", "screen_name": "noripasuta", "avatar_url": "https://pbs.twimg.com/profile_images/1405702394411765762/zejFjUQh.png", "header_url": "https://pbs.twimg.com/profile_banners/1071079376735764481/1623983959/1500x500", "appeal_receivable": false, "popular_creator_rank": 65, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "correction"}], "nc": 160}, {"id": 2471317, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "和", "screen_name": "kazz8_", "avatar_url": "https://pbs.twimg.com/profile_images/1604866384944451584/GA2iOLNQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1577166385825783811/1716622829/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2716849, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ユキモト", "screen_name": "yukinnko22", "avatar_url": "https://p