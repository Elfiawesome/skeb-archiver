う…と考えています。もしかしたら、テトはその考えに興奮して、パンツの中でチンポが脈打っているかもしれません。\n\n念のため、これはオナラ/スカトロのエロティックなリクエストです。オナラは緑色のガス雲と、ミクのお尻から出る膨らみでパンツが膨らむ様子がはっきりと描かれています。\n\nこの状況では、ミクはトイレまで間に合わず、結局パンツを汚してしまうことになりそうだ。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NpNko5/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8eb81f3a/uploads/origins/248f2479-e912-4868-aba7-f30fa5b2483e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=221e60b10f66246aad2f976830625516", "srcset": "https://si.imgix.net/8eb81f3a/uploads/origins/248f2479-e912-4868-aba7-f30fa5b2483e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=221e60b10f66246aad2f976830625516, https://si.imgix.net/8eb81f3a/uploads/origins/248f2479-e912-4868-aba7-f30fa5b2483e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23e6656723e304dd4fcb146a879889f9 2x, https://si.imgix.net/8eb81f3a/uploads/origins/248f2479-e912-4868-aba7-f30fa5b2483e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71996e4d43c5659456baa759c361023e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3538467, "client_id": 2661990, "nc": 177}, {"path": "/@NpNko5/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3538467, "client_id": 3728173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d3b9b53/uploads/origins/4137294d-b70b-410c-bf75-5f74275d4f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06bbde4d87b94