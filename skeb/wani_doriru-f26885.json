考画像2、3のような表情にしたいです。ちょっとクレイジーに見える目の螺旋は重要なので、ぜひ入れてください。上記リンクのように2分割して、前半は服を閉じて、後半は服を開いてほしい。前編では、ドヤ顔で挑発的な格好から始めてほしい。そして、パジャマを開いて今まで見えなかった胸を露出させ、表情も激しくなる。露出するときはブラジャーをつけてほしい。露出したときにびっくりするような、とても大きな胸にしてほしいです。よろしくお願いします！\n\nhttps://imgur.com/a/Qwo5PdO", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wani_doriru/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 332023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c0f0f49/uploads/origins/07bb9c29-9d84-46db-8c4d-fa1e63d3c4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce52ec36322c808c8cc36f98f12fbd37", "srcset": "https://si.imgix.net/2c0f0f49/uploads/origins/07bb9c29-9d84-46db-8c4d-fa1e63d3c4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce52ec36322c808c8cc36f98f12fbd37, https://si.imgix.net/2c0f0f49/uploads/origins/07bb9c29-9d84-46db-8c4d-fa1e63d3c4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d93f1ac4492f02e69050e55a021b508 2x, https://si.imgix.net/2c0f0f49/uploads/origins/07bb9c29-9d84-46db-8c4d-fa1e63d3c4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41824a0b88f02074f8b38484bea284c5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c0f0f49/uploads/origins/07bb9c29-9d84-46db-8c4d-fa1e63d3c4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4788ca696b4f87f9fcb305ce8bfc43", "srcset": "https://si.imgix.net/2c0f0f49/uploads/origins/07bb9c29-9d84-46db-8c4d-fa1e63d3c4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4788ca696b4f87f9fcb305ce8bfc43, https://si.imgix.net/2c0f0f49/uploads/origins/07bb9c29-9d84-46db-8c4d-fa1e63d3c4a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s