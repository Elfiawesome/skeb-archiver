ール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n分泌される体液や血液は練乳やミルクのようで、\n飲ませた相手を強壮し、軽い依存性をもちます\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fanakaZR/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3485844, "client_id": 2117295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/539970d5/uploads/origins/ada799ef-2bf3-4357-a8b3-eb2c43feaf07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683cce96130137be630723bef72d5f15", "srcset": "https://si.imgix.net/539970d5/uploads/origins/ada799ef-2bf3-4357-a8b3-eb2c43feaf07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683cce96130137be630723bef72d5f15, https://si.imgix.net/539970d5/uploads/origins/ada799ef-2bf3-4357-a8b3-eb2c43feaf07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9deb0999d95eddd16172ecab272e6f3e 2x, https://si.imgix.net/539970d5/uploads/origins/ada799ef-2bf3-4357-a8b3-eb2c43feaf07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8c8e73ac047a50be8af875e1fa28276 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/539970d5/uploads/origins/ada799ef-2bf3-4357-a8b3-eb2c43feaf07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a98cc08998334ca59e9ac1a508d6da8", "srcset": "https://si.imgix.net/539970d5/uploads/origins/ada799ef-2bf3-4357-a8b3-eb2c43feaf07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a98cc08998334ca59e9ac1a508d6da8, https://si.imgix.net/539970d5/uploads/origins/ada799ef-2bf3-4357-a8b3-eb2c43feaf07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f70f738fac4a54a11a4c07d257d