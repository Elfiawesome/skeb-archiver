えておりますので、縦長のイラストだと嬉しいです。\n\n資料は下記のgoogleドライブよりご確認をお願いいたします。\nhttps://drive.google.com/drive/u/1/folders/1RThLDOOcrZXH2hkNqRxwTfNy3ClQWHcr\n\nご検討のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vnlcv5b/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2564367, "client_id": 944700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73f74304/uploads/origins/445b00ab-3bd9-45cb-8645-72d42a9f5096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=843ac6259fc0d898e1c8bb30c4f81ddb", "srcset": "https://si.imgix.net/73f74304/uploads/origins/445b00ab-3bd9-45cb-8645-72d42a9f5096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=843ac6259fc0d898e1c8bb30c4f81ddb, https://si.imgix.net/73f74304/uploads/origins/445b00ab-3bd9-45cb-8645-72d42a9f5096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81497e3ea878adab2cef6baec37d822b 2x, https://si.imgix.net/73f74304/uploads/origins/445b00ab-3bd9-45cb-8645-72d42a9f5096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b60954dc0228f5a3e1b922ea89acba1e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73f74304/uploads/origins/445b00ab-3bd9-45cb-8645-72d42a9f5096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d681431af6abc7fad820ac4d1bd7f6d7", "srcset": "https://si.imgix.net/73f74304/uploads/origins/445b00ab-3bd9-45cb-8645-72d42a9f5096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d681431af6abc7fad820ac4d1bd7f6d7, https://si.imgix.net/73f74304/uploads/origins/445b00ab-3bd9-45cb-8645-72d42a9f5096?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f7e769669edd0dc38b9ae1b5d6ec83e7 2x, https://si.imgix.net/73f74304