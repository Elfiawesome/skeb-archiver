oogle.com/file/d/1rpLusikVaYrd2EsRzcPiohHXhsPSN110/view?usp=sharing\n\nあなたの作品が大好きですし、扱っているテーマもとても気に入っています！\n\nコミッションについては、こちらの雰囲気の作品をお願いできればと思います：https://x.com/Dormicumproject/status/2051168562988151084\n\n医療ホラーは私の大好きなジャンルで、参考画像のように私のキャラクターが縛られている様子が理想的です。\n\n必要であれば、さらに詳細をお伝えすることも可能です！\n\nお時間をいただき、ありがとうございます。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dormicumproject/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3971812, "client_id": 393379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef442703bcf7ef606954b66e342b9d78", "srcset": "https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef442703bcf7ef606954b66e342b9d78, https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9becb2f21d055ce2d499cd171d05f77 2x, https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71e228385a18294bfda802c1e96797c9 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b1b5a0cb420915aa6f13193dff6452d", "srcset": "https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b1b5a0cb420915aa6f13193dff6452d, https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d8460b077922330947767a4123cf1d2 2x, https://si.imgix.net/6997a4e1/uploads/origins/cee8a033-dac0-4303-a738-97eeaf4e4ea1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5353d85b5d81e9c903e3f8729872218 3x"}, "body": "Dormicum様\n\nいつも素敵な作品をありがとうございます。\n仄暗く、猟奇的でありながら繊細で美しいDormicum様の作品がずっと大好きです。\nこの時代この国に生まれ歯を食い縛り生きる日々の励みになっております。\n\nこの度はコミッション募集のポストを拝見し、ぜひOCをお願いしたくリクエストをお送りしました。\n\nご縁がありましたら大変嬉しく思います。\nどうか宜しくお願い致します。\n\nお体にはどうかお気を付けください。\nDormicum様の望まれるものがひとつでも多く叶うような世界をこれからも心より祈っております。\n\n【内容】\nリョナ風イラスト\n\n学用患者のこども\n瞳が大きく、華奢すぎる体躯\n\n両性具有だったため神聖化されつつも学用品扱いされていた。\n12歳を迎えた日に限界を感じ、性器を自らハサミで切り、子宮を抉り出した上で自害。\n\nしかし死にきれず、飛び降りを図り下半身不随になり、「悪魔に取り憑かれて狂ってしまった」と閉鎖病棟で死ぬまで身体を弄ばれた。\n\nキャラクターモチーフ\n・学用患者\n・信仰\n・狂った子兎\n・性別\n\n構図、衣装、表情は全てお任せ致します。\nDormicum様の医療リョナ作品が特に好きなため、拝見できたら大変嬉しいです。\n\n使用用途\n・個人観賞\n・X等のSNSでの投稿やYouTube動画内での使用\n・個人製作の創作本への掲載\n(難しいものがありましたら、別レイヤーにてお伝え頂きたく思います。厳守致します)\n\nhttps://www.dropbox.com/scl/fo/psnghp4wpr7ocpdc2gy5d/AE7wCSG6epjFDM4sPn8defE?rlkey=1x38gfhf1n7vytmq465tc910w&st=2t32d5n3&dl=0", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dormicumproject/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3971812, "client_id": 3881150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eac71b23/uploads/origins/17f58331-19d5-42b7-968f-1010d71c67bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c56db3cca6f7f47256bec2f8f3a846", "srcset": "https://si.imgix.net/eac71b23/uploads/origins/17f58331-19d5-42b7-968f-1010d71c67bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83c56db3cca6f7f47256bec2f8f3a846, https://si.imgix.net/eac71b23/uploads/origins/17f58331-19d5-42b7-968f-1010d71c67bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2