rls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3447571, "client_id": 118255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/768d25da/uploads/origins/bf4a76af-7431-4a7c-a833-8b7b6350f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=576aa7ecc339037d476cb89a7a056516", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/768d25da/uploads/origins/bf4a76af-7431-4a7c-a833-8b7b6350f82f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb9241dc39857b200e0cf50be2449ed7", "src_set": ""}, "body": "こんにちは！僕は君の絵の大ファンで、特にソウルハッカーズの絵が好きなんだ。最近のマリーとヴィクターの絵は素晴らしいと思いました。\nソウルハッカーズのナオミを描いてほしいです。地下の廃墟にいる彼女の雰囲気のある絵がいい。", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tomokoeshi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3447571, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/153e67a6/uploads/origins/8ac60e7f-d46d-4dec-b99e-d8818f656706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4c96f671ebfc23f1605c5f3b8dbcbe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/153e67a6/uploads/origins/8ac60e7f-d46d-4dec-b99e-d8818f656706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caee14977dc5bd0f873b4675099c90b5", "src_set": ""}, "body": "はじめまして\nTanita先生の描かれるスタイリッシュでカッコいいお姉様方に一目惚れしてメッセージを送らせていただきました。\nぜひ先生の絵柄で描いていただきたいキャラがいるので\nもしお時間と作業量で可能でしたら何卒、ご対応お願いします。\n\n依頼ですが メギド72のアスモデウス(資料url参照)のイラストになります。\n納品形式はPSDでお願いしたいです。\n (アスモデウスのキャラ設定としては自分が絶対的な存在であると強く認識しており、 \n実際それに見合った実力の持ち主で、\n強大な力と尊大な態度、 美しく強靭な肉体を持ち合わせる、誇り高き性格の持ち主となります。）\n\n今回はTanita先生の絵柄や世界観で描かれたアスモデウスを見てみたい！\nという主旨のリクエストになりますので\n髪型体型や服装なども必ずしも資料遵守ではなく先生のお好みで\nシチュや構図、表情なども完全におまかせで筆の乗るようにお願いします。\n\nしっとりした美しい一面も、バチバチに傲慢暴力な一面も持ち合わせたまさに混沌の化身である\nアスモさんを先生にぜひ描いていただきたいです。\n\nお忙しい中とは存じますが、ご一考の程お願いします。\n\nhttps://drive.google.com/drive/folders/1m0pcsC9d33CJGD0MIjTNNkT0fRlGe1ya", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1913123, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Nanbu Yasumi/NanbuWorks", "screen_name": "nanbrest", "avatar_url": "https://pbs.twimg.com/profile_images/1717751026965786624/bmltVUPv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1299674314044616707/1699537147/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 2078407, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Sakuma🦇Skeb", "screen_name": "skm_nnm", "avatar_url": "https://pbs.twimg.com/profile_images/1933742729823166464/Ptm4rI-W.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1501628022080012290/1757686108/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 33}, {"id": 2584614, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぶいつ@skeb42%off", "screen_name": "wcv2", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F0f453194-7109-4ac1-a7db-4dd0e6e07f2e.gif?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/1fed095c-1990-4265-b1ab-3856cd8c6def.gif", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acce