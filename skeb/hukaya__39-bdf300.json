す。\n\nもし金額が合わない場合は再送させていただきます。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1iQPWvEB7KbgEuVdXbT6P1WTY5TNLbcMz", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1436387, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ましろか", "screen_name": "mashiroka", "avatar_url": "https://pbs.twimg.com/profile_images/1479424578321809414/33inYoLr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1041882826075848704/1748281474/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1575851, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ひびき澪@君それ⑦巻発売中", "screen_name": "info_hibikimio", "avatar_url": "https://pbs.twimg.com/profile_images/1079732557791387649/A1LKEw9P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/889833875261620224/1612472722/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "comic"}, {"genre": "art"}], "banned": false, "nc": 49}, {"id": 2410085, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "やくしじま", "screen_name": "gugsssccc", "avatar_url": "https://pbs.twimg.com/profile_images/1846106336326832133/y9hMC5Mj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1401198443754758155/1623914475/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "