uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/682f6e86/uploads/origins/0dc95b5a-fccf-4fc3-989e-7445ee3de06e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51cf499fa0189c42eea9d638ccb5d042", "srcset": "https://si.imgix.net/682f6e86/uploads/origins/0dc95b5a-fccf-4fc3-989e-7445ee3de06e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51cf499fa0189c42eea9d638ccb5d042, https://si.imgix.net/682f6e86/uploads/origins/0dc95b5a-fccf-4fc3-989e-7445ee3de06e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0eb53fd3b01f205875fcef17a8b3232 2x, https://si.imgix.net/682f6e86/uploads/origins/0dc95b5a-fccf-4fc3-989e-7445ee3de06e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6726df01299f505c1226d01ec7558b0 3x"}, "body": "初めまして。\n先の依頼のブルーの絵が可愛くて依頼させて頂きました。\n夏っぽい印象を受け、ふと以下の内容を思いついたのでよろしければお願いしたいです。\n\n【キャラ】\nオカルトマニア（XY世代）\n\n【服装】\nお任せで水着、パレオ有でお願いしたいです。\n\n【表情】\n「あわわわ」と恥ずかしくてパニックになっているような表情。\nもし、差分を頂けるなら、顔を赤くしながらも照れ笑いの表情。\n\n以上になります。\nお受けいただけると嬉しいです。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayabon2010/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1786798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/727ae0cf/uploads/origins/24bfc68b-88f5-49ab-a263-8edcbb4971be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adb2f1d072e251b2233e53a7ce9923b5", "srcset": "https://si.imgix.net/727ae0cf/uploads/origins/24bfc68b-88f5-49ab-a263-8edcbb4971be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adb2f1d072e251b2233e53a7ce9923b5, https://si.imgix.net/727ae0cf/uploads/origins/24bfc68b-88f5-49ab-a263-8edcbb4971be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top