e/uploads/origins/16cc4069-61dc-43c3-a3c4-1278f28410bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20556f7de2f27b53deba9a7f6d542c5e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/413bfe8e/uploads/origins/16cc4069-61dc-43c3-a3c4-1278f28410bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d20361eb29e1c7e621322c75003579ab", "srcset": "https://si.imgix.net/413bfe8e/uploads/origins/16cc4069-61dc-43c3-a3c4-1278f28410bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d20361eb29e1c7e621322c75003579ab, https://si.imgix.net/413bfe8e/uploads/origins/16cc4069-61dc-43c3-a3c4-1278f28410bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=493ac1a45107b89212c75257a6793133 2x, https://si.imgix.net/413bfe8e/uploads/origins/16cc4069-61dc-43c3-a3c4-1278f28410bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2197a7dd12cfe0ad216c4a52befe2287 3x"}, "body": "初めまして！リクエストさせていただきます。\nMaGy様のオリキャラ、ルビちゃんorカナちゃんがおしっこを我慢するイラストor漫画をお願いします。\nできれば我慢〜お漏らしまでの過程を詳しく描いてたさいただきたいので、もちろんカラーでなくても大丈夫です。\n尿意ゲージ有りで、見られているのに限界になって恥ずかしながらもガッツリ前押さえしてしまう所などを描いていただきたいです。\nもちろん、キャラの性格によっては限界見せつけお漏らし等でも構いません。\n\nご検討よろしくお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@otokuyou126a/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 78916, "client_id": 2727316, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3343f6f9338c31e01582b2bf29455b5d", "srcset": "https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3343f6f9338c31e01582b2bf29455b5d, https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d7a279bd4ef8975fae5d031c82f8f43 2x, https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1406c19c8255bb388821d6ccd0f377bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6471ac721c6068197db518d751137fad", "srcset": "https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6471ac721c6068197db518d751137fad, https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=250b586c2848b634f52a79bc72e80ba7 2x, https://si.imgix.net/4e464da3/uploads/origins/7c8dc360-8220-4222-940b-5b95e88a0cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7dc6ee8339b19a205a05821c9da2af17 3x"}, "body": "こんにちは！MaGyと申します。\nうちの子のリクエストをお願いしたいです！\n\n【キャラクター】\n　ルビちゃん（設定画を添付します。）\n\n【キャラクターの特徴】\n・おととしリクエストさせていただいたキャラですが、少しデザインが変わりました。髪型は真ん中で分けていますが、右目は隠れており(髪越しに少し見えるくらい)、左目は耳まで出ていて、葉っぱの形をしたピアスをつけています。また、前の服の上に薄い緑のカーディガンを羽織りました。ゆるーく着ているようなものなので、半脱ぎくらいになってます。\n\n・そのほかの特徴は、前と同じです。少し大人びたようなオシャレな雰囲気でお願いしたいです！まつ毛をしっかりと描いていただけると嬉しいです。\n\n【シチュエーション・構図】\n・主観視点の騎乗位セックスをお願いしたいです…！\n\n・場所はラブホテル、怪しい色のライトの光に照らされたベッドの上で、ライトが彼女に対し逆光しているようなリアルな雰囲気をお願いします。\n\n・服は着崩しでお願いします。おっぱいと結合部が見えるよう調整をお願いします。難しそうな場合は、裸カーディガンで構いません。\n\n・結合部がよく見えるよう、女の子が少し反ったような体位にしていただけると助かります。\n\n・https://www.fanbox.cc/@otokuyou126a/posts/10101523\nの2枚目のような、半分透けたような中出しの描写がかなり好きなので、採用していただけると嬉しいです。\n\n・可能であれば仰け反り絶頂が見てみたいです。素直に感度は高い子なので、できる限り激しくぶっとい潮を吹くようなアクメを描いてほしいです！オノマトペも\"ブシィッ\"みたいに勢いの良さが感じられるとありがたいです。\n仰け反りが難しいようであれば、潮吹きのみでお願いします。\n\n・どちらでも構いませんが、もしセリフを入れる場合は、内容は先生におまかせさせてください！ですますで丁寧に、そして事の最中にはねっとりとした誘惑の言葉を使う子です。事後にもう一回戦を誘うようなセリフがあったら嬉しいです！喘ぎ声に関しては好き放題入れちゃってください！\n\n・差分構成についてですが、絶頂と事後以外は枚数も含めお任せします。（入れる場合は）最中のセリフのレパートリーや、表情の差分を増やしていただけるとありがたいです。展開などもお任せさせてください！\n全裸差分は不要です。\n\n・どこかヤンデレじみたニヤケ顔、独占欲が滲み出るような搾り取るような腰使い、丸め込まれそうなほどに蠱惑的で底が見えないけれど、どこか寂しそうで、幼さも見えるような不安定さを持つ彼女をどうかよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1vcan38n5uio_SCXWXXzhkqiN-jF0QpwR?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hamachi_sukebe/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1947077, "client_id": 2727316, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7a607c95f8de46699dc4d63770504c", "srcset": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f7a607c95f8de46699dc4d63770504c, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07b98bc83cb081db4be465ea9ca2f7c6 2x, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a79b1f21d548f991dd777284bf1d9b99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad48c984c1b225601262628debb752d", "srcset": "https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ad48c984c1b225601262628debb752d, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ce5390431ed685581f526dcbe8fa8bd 2x, https://si.imgix.net/91c9da3a/uploads/origins/b527546c-5114-47d6-8d77-6357288fe55d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32ba34a94167c7f0db2097c8d63ea0d3 3x"}, "body": "こんにちは！MaGyと申します。\n作品を拝見して、先生の作風に惚れてしまいました…！自分では描けないような鬼畜極まる強制絶頂モノが、ぜひうちの子でも見てみたくなってしまいまして…！というわけで今回は、うちの子のリクエストをお願いしたいです！\n\n【キャラクター】\n　ルビちゃん（設定画を添付します。）\n\n【キャラクターの特徴】\n・ですます口調で話す子です。\n\n・マイペースでちょっぴりダウナー、健気で可愛らしい、普段はそんな子です。\n\n・でも実は結構なムッツリです、えっちになると相手を煽ってはその様子をニヤニヤと眺めるドSっ子になります。根っからエロを楽しむような、かなり魔性の女。\n\n・ですが今回は、そんな彼女に超苛烈な責めをして、その余裕を無くしていただきたいのです…！\n\n【シチュエーション・構図】\n・拘束され、長時間の寸止めや焦らしを繰り返してから、強烈な連続強制絶頂…という流れが見たいです！\n\n・焦らし方も責め方も先生にお任せします！思いつく限り、何をしちゃっても大丈夫です...！個人的にはグロテスクな形のディルドやら触手やらをねじ込むみたいなのが見てみたいかもです…もちろんそれ以外も併用していただいて結構です！\n\n・余裕綽々に「物好きですね…♡」なんて煽るような様子が、たーーっぷり焦らされて辛抱できなくなって叫び始めて、そして連続絶頂が始まったら、突き刺すような快楽によがり歪み狂い、大きく何度も絶頂して、終わらない快感の恐怖に襲われながらも、下品に喘ぎ散らかして、激しく潮吹きを繰り返して…\n\n・そして、ここが特に見たいのですが…放心した体が勝手に放尿失禁してしまうのを、薄れゆく意識で「み…ないで……くださいぃ…」と、恥ずかしがりながらも懇願する姿を見たいです...！彼女は実は恥ずかしがり屋なところがあるので…！\n\n・とにかく鬼畜に、徹底的にわからせてあげてください♡\n\n【その他】\n・責め立てる側の男モブのセリフはナシでお願いします、描く範囲も手や指先程度に収めてほしいです。\n\n・資料をGoogle Driveに入れておきます！\n\n・描いていただけたらとても嬉しいです…！\n\nhttps://drive.google.com/drive/folders/1vcan38n5uio_SCXWXXzhkqiN-jF0QpwR", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tkus100/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1524900, "client_id": 2727316, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.im