f38d-e4c0-4972-8ba1-6b284328f54c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cef8650a16e5467360f41ce7f730ddc, https://si.imgix.net/86ee8400/uploads/origins/7e8af38d-e4c0-4972-8ba1-6b284328f54c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c34c14db66a6bd6934f2a19034b84f4 2x, https://si.imgix.net/86ee8400/uploads/origins/7e8af38d-e4c0-4972-8ba1-6b284328f54c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8454ceded13e919b81a6dd1456837c0 3x"}, "body": "ひなき様初めまして🌷\nひなき様の描かれる漫画やイラストが大好きなので是非ご依頼させて頂きたいと思いました⸜❤︎⸝‍\n\n場所は居酒屋で、レモンサワーを飲んでほわほわ(だいぶ酔ってる)しているうちの子を描いて頂きたいです...！\n頬を紅くしており、上目遣いだと嬉しいです。\n衣装は資料のままでもまるっきり変えていただいても大丈夫です。\nまた、白黒カラー問いませんのでお好きに描いて頂きたいです！\n\n使用用途はアイコン(顔のみ)または鍵垢でのツイートを予定しております。\n\nskeb初心者の為拙い文章で申し訳ありません。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/file/d/1Svdmc5rq1pU9N143_FCJ8ZKoNcvxGHRY/view?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rhb2x2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2081571, "client_id": 6708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e006c4ec09e21d26ea063c622773ec2f", "srcset": "https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e006c4ec09e21d26ea063c622773ec2f, https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c07bfa70226561db0cc9eaab93365d97 2x, https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d497e2afd6bb5010664c30a0d78f9acb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78f658362d0c0d73b9eca1428e92af19", "srcset": "https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78f658362d0c0d73b9eca1428e92af19, https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f5ac01051e707e5c43f6a5b71070678 2x, https://si.imgix.net/3659b299/uploads/origins/f96a2a99-622b-427b-a916-8f6cb1f913d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5929cb1853b81ab808f20b9e74a598a6 3x"}, "body": "先日はおいしそうなお寿司とうつくしい椎名さんを描いて下さりありがとうございました。\n後になって椎野さんは餃子がお好きという新しい情報を知りました。すみませんでした。\nですので、椎野さんがいちばん好きな餃子を食べている椎野さんの姿をお願いします。\nモノクロで、今回はひとりでおいしく食べてる…自分だけの時間…みたいなのを覗かせて頂きたいのでセリフなどは自由です。お店のものでも、お弁当やスーパーの製品などお家で食べるタイプのものでもどちらでも構いません。椎野さんがいちばんすきな餃子を想像して、いちばん好きな餃子をいちばん好きな食べ方で食べている、ごきげんな椎野さんの姿が見たいです。よろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rhb2x2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2081571, "client_id": 6708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9b0e863c2feaf01bfab572d05acdc7", "srcset": "https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f9b0e863c2feaf01bfab572d05acdc7, https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6188b0b2ecffc3003412910c02305592 2x, https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79c4e366c2c0006ec2b41183dad1f751 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3422eeaf8f5ea97e6330374daaeccbd7", "srcset": "https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3422eeaf8f5ea97e6330374daaeccbd7, https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=792f2cb0a6183b2c5b8d34be3cd80fd2 2x, https://si.imgix.net/f4749879/uploads/origins/52b8d254-3a65-4820-bd58-96ebd80d6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2c87287919175f3edb72c69f93dd9c06 3x"}, "body": "ひなきさんのところの椎野さんのイラストが見たいです。\n私はマンガを読むとき食事シーンやお風呂のシーンとかの日常シーンが好きでついよく見てしまいます。そしてなんとなくですが、椎野さんは和風なものが似合いそうな気がすると思っています。ですのでお寿司を食べる椎野さんの姿を見ることができたら嬉しいです。\nお寿司はお店のものでも出前でも、あるいはスーパーのものでも構いません。\n服装などはお任せします。ひなきさんが着せたい服を着せて頂ければと思います。\nマンガのひとコマみたいなものが好きなのでモノクロだと嬉しいです。\nいただきますとかでももちろん良いので、できれば何かセリフがあると嬉しいです。\nご検討のほど、よろしくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rhb2x2/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5817a24d/uploads/origins/46a49d94-644e-4255-84c0-e2938cc51cb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=midd