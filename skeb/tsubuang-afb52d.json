d69ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20105fb43fca4b4063ada828f0676270, https://si.imgix.net/d65316c0/uploads/origins/6603adbb-8cc5-4a0a-aa3a-7566877d69ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca9b127762d5b61434fafdda04594cad 2x, https://si.imgix.net/d65316c0/uploads/origins/6603adbb-8cc5-4a0a-aa3a-7566877d69ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1f33f86662a70b1f1c7f0e75b105c52 3x"}, "body": "つぶあん様\n\nお世話になっております。\n\nつぶあん様が投稿していたhttps://www.pixiv.net/artworks/130618262に登場するキャラクターのイラストをリクエストします。\n詳細は以下の通りです。\n\n◯見た目\n全裸でお願いします。ただし、黒い網タイツを履かせてください。\n\n◯シチュエーション\nベッドの上で横たわり、足を広げる、マンコを見せる様子を描いてください。\n\n◯その他\nベッドの上には、おしゃぶりやコンドーム、ローションのボトルが散乱した状態にしてください。\n\n◯差分\nキャラクターの体に、ひどい落書きを入れたバージョンを頂きたいです。\n落書きの内容は、下記を参考にしてください。\n\nhttps://www.pixiv.net/artworks/130326142", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsubuang/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 120636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6342be5c2c50cf710a1716beac559448", "srcset": "https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6342be5c2c50cf710a1716beac559448, https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e574736916df45b50e47a1079a363f7 2x, https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01814ae689ea20ddda1e0d0de004c86b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17bb6acf042a6c9430902503d57d0e6f", "srcset": "https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17bb6acf042a6c9430902503d57d0e6f, https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8edbd74c24deaaf7c63c1047332346d 2x, https://si.imgix.net/78081aec/uploads/origins/0423ca15-7566-4536-9c6a-37aa734a3a5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3c98fdd0f3f8f4d21aa60749a8a0c49 3x"}, "body": "こんにちは。もしよければ下記の褐色キャラをお願いできないでしょうか。\n\n■キャラ\nクレア(秘宝伝)\nhttps://imgur.com/a/jrn6YZ8\nhttps://www.pixiv.net/artworks/129027584\nhttps://nijie.info/view.php?id=65944\n・金髪で褐色なエジプト系の元気な女の子です。\n・身長と頭身低めで顔と目が大きく、胸は全くなくぺったんこのまっ平。\n　下記のイラストのように胸板は鎖骨と胸の谷間(?)に縦線が入り胸筋っぽさを強調し、\n　お腹周りもイカ腹っぽくして、くびれもない寸胴体形。\n　影や筋っぽさで立体感あると嬉しいです。(華奢や痩せは控えめで胴体が分厚い感じ)\n　https://www.pixiv.net/artworks/114375011\n　https://x.com/tsubuang/status/900384177207394304/photo/1\n　https://www.pixiv.net/artworks/126362145\n・装飾はティアラ、ピアス、腕輪は装着した状態。\n　服装か全裸か、体を殆ど隠せていないエロ衣装(アラビアンとかエキゾチックな踊り子系)。\n・顔の化粧は無し。\n\n■シチュ\n冒険の旅費の工面のため娼婦としておじさん相手にエッチ。\n一応は無知シチュで本人は行為の意味はよくわかっておらず、\n教わった通りにセクシーなポーズで腰を振り、\nおじさんが喜んでいるようだから本人も嬉しいみたいな感じ。\n\n・構図\n下記のようにほぼ真正面向きの騎乗位。\n顔の向きは正面向き。上半身は両手を頭の後ろにやるか、\n片手を頭の後ろにやるセクシーなポーズ。\n体はやや後ろに反る感じで胸板やお腹など肉体美(?)を強調させる感じ。\nhttps://www.pixiv.net/artworks/132884342\nhttps://www.pixiv.net/artworks/97813491\nhttps://www.pixiv.net/artworks/132625826\nhttps://www.pixiv.net/artworks/114375011\n\n・竿役の男性\n小太りな中年男性。基本的に腰回りしか映らない。\n竿とか陰毛とか下記のようにごつくて少し汚らしいイメージ。\n(陰毛描かれない場合は毛は無しでも可)\nhttps://www.pixiv.net/artworks/134669232\nhttps://www.pixiv.net/artworks/126222458\n\n■その他\n・挿入によるお腹が盛り上がる描写(ボゴォ)は無し。\n・差分を可能な範囲でお願いしたいです。\n　・表情パターン\n　　　笑顔(目は開く)、本人なりに誘惑した色っぽい表情、\n　　　笑顔ベースの感じ顔、イキ顔、気持ちよかった？と両目を閉じる笑顔など。\n　・射精差分(それぞれ個別)\n　　　膣内、胸板回り、顔\n　　　※白濁の汁で褐色の肌が映える感じ。\n\nその他、描きやすいように内容の調整などおまかせします。\n以上、よろしくお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsubuang/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/928f3e29/uploads/origins/0478fe9e-0e12-4b12-b7a6-0889e94cf6ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c1bef07939dedfcb14c9e420c1513ad", "srcset": "https://si.imgix.net/928f3e29/uploads/origins/0478fe9e-0e12-4b12-b7a6-0889e94cf6ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c1bef07939dedfcb14c9e420c1513ad, https://si.imgix.net/928f3e29/uploads/origins/0478fe9e-0e12-4b12-b7a6-0889e94cf6ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=215aeeb1673f0dba7419047eabdf831d 2x, https://si.imgix.net/928f3e29/uploads/origins/0478fe9e-0e12-4b12-b7a6-0889e94cf6ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=684de8ef7a77fda473dbfa0fb8f2650b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 120636, "nc": 176}, {"path": "/@tsubuang/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 120636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ced745d3/uploads/origins/bcdac287-a74e-4a82-8d9a-33db47f143e0?bg=%23fff&auto=format%