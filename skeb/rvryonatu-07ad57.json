=44Gq44Gk44G_44GL44KT&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=0afecd8c52b4a5cb9b76c6cd6a44e2ed", "skills": [{"genre": "art", "default_amount": 5000}, {"genre": "correction", "default_amount": 3000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@rvryonatu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3909503, "client_id": 8144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=423a0299108ef32041fd93fa15c712e4", "srcset": "https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=423a0299108ef32041fd93fa15c712e4, https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=348f9a5c28044707f610a86d6bdb4313 2x, https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b0f134bd29ebe1e8bc31095335e0a8a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25a41779f69730991bde8a7427459797", "srcset": "https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25a41779f69730991bde8a7427459797, https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=085416c4aafa94d1272605c1966a2773 2x, https://si.imgix.net/6a1e0a1a/uploads/origins/0aad4b21-1813-4ac9-9e9e-19bd1511140f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3825e60611f335c5e8f1e2beca866dfb 3x"}, "body": "こんにちは！\n納品されていたイラストの数々がとても素晴らしかったので、ぜひうちの子カップルでもお願いできればと思いリクエストいたします！\n\n●シチュエーション\nデートしてる二人。\n2人で歩いている時に、ハカナが思い切ってシャオロンの腕に抱き着いてみる。\n自分からやっておきながら照れちゃうハカナと、驚くシャオロン。\nやっぱり離れたハカナが、今度はシャオロンともども照れながら遠慮がちに手を繋ぐ。\n\n●世界観\nライトな剣と魔法のファンタジー世界。\n和風、中華風な東方の国を跨いで旅している二人。\n\n●シャオロン\n性別：男\n\n身長：160cm弱(ハカナより若干低め)\n\n武芸を磨くため、腕試しの旅をしている小柄なエルフ。\n魔法の才能がないために寿命任せで何十年も修行していたら、才能が開花し、えらい強さになった。\n\n穏やかで実直・生真面目な性格。\n風体のせいで舐められやすく、行く先々でトラブルに巻き込まれる。\n「儂」「〜じゃよ」など、古風で老人のような喋り方をするが、エルフとしては若造。\nキャラ付けで喋っていたのが素になっただけ。\n\nハカナのことは大事に想っているが、武芸一本で生きてきたので、扱い方がわからず困っている。\nすぐ暴走する彼女を諌めつつ、不器用ながら、時おり好意を返すこともある。\n\n●ハカナ\n性別：女\n身長：約160cm\n\n・概要\nオタク気質で妄想癖のある桜の精。\nとある事件でシャオロンに助けられ、ずっと憧れていた「物語のような運命の恋」を確信し、一目惚れ。\n以降、彼の旅に（勝手に）同行し、押しかけ女房と化した。\n隣で恋人面をしながら、日々節操のないアタックを繰り返している。\n\n普段は明るい女の子口調だが、調子に乗ったり照れ隠しをする際には小物キャラのような口調で話す。\n「へっへっへ、こりゃあたまりませんなあ」\n「旦那、いい女がここにいますぜ！（自分を指さす）」\n\nなお、恋愛小説の執筆を趣味としており、シャオロンとの旅を(恋愛描写マシマシで)小説にしたら大ヒットしてしまった。\nシャオロン本人にはナイショにしている。\n\nhttps://www.dropbox.com/scl/fo/u847f5egllshsr3tah4wp/AEEUqRxzVcu6NCbzO_dldj4?rlkey=1xsc8sk8tions9a4fax2gn2u4&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rvryonatu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3909503, "client_id": 1219454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=468588f3d749f3136398c968ea4cc52a", "srcset": "https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=468588f3d749f3136398c968ea4cc52a, https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba7d6caac697e72c9971d9ca202ee3d8 2x, https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f421aece8cb91ab4aa5b2d62d0181e0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=069c8e826f119d8ff4009da803466a94", "srcset": "https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=069c8e826f119d8ff4009da803466a94, https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a21f596dd751d046599e5cfcedf3c86d 2x, https://si.imgix.net/22cbf1f9/uploads/origins/b0fbe986-f23c-4193-a632-6b76774ad3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1db9307283d8b238f3e8201f088ec673 3x"}, "body": "先生、こんにちは。この2人をもう一度描いていただけると嬉しいです：https://humorous-fibula-b01.notion.site/Revertere-Iterum-126e4e67dd83802b8c5ad053bd01756e\n\n🪶 ソーレン（177cm）：21歳の人間！のんきに暮らしています。よくおバカだったり気楽な印象を与えますが、見た目以上に頭の切れる人物です。 \n\n🔮 ミネット（152cm）：14歳に見えるが、実は3歳の珍しい黒竜。未熟で無鉄砲なミネットは、かなり頑固な面もある。食欲がとてつもなく旺盛だ。\n\n先生、自由に描いてください！心温まるものも、気楽なものでも、どちらでも構いません！ あなたが描く、そんなほのぼのとしたやり取りが本当に大好きです。\n\nhttps://humorous-fibula-b01.notion.site/Revertere-Iterum-126e4e67dd83802b8c5ad053bd01756e", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rvryonatu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3909503, "client_id": 2918365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce3ffba0d0cb5054524e46df6bfea7ce", "srcset": "https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce3ffba0d0cb5054524e46df6bfea7ce, https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4f5398af251dea28fe0fc1759d381c8 2x, https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c64ef6a08250e9bc283f2f02c2dd23fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=612c82a97d8469c34441b266e3ff83e4", "srcset": "https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=612c82a97d8469c34441b266e3ff83e4, https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca760f85a58e91a030e72192df15fdf2 2x, https://si.imgix.net/09794013/uploads/origins/030ceb70-121c-4cb7-b5b5-649ee266584b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=177b3cd7370fd9a4d3d3b6033fdd2947 3x"}, "body": "こんにちは！あなたの作品がとても好きで、イラストのご依頼に伺いました。できれば、日常のほのぼのとした、じゃれ合うようなやりとりを描いていただきたいです。\n\n名前：青司 蛇之目\n髪色：灰白色から緑へのグラデーション\n設定：\n数千年生きる蛇の妖怪。マイペースで、いつもだらりと笑っている。時におちゃめで子供っぽい一面も見せるが、大妖怪として誇り高く傲慢なところもある。長年封印されていたため現代社会に疎く、新しいものへの好奇心が強い。食いしん坊で酒好きだが、極度の酒弱で、基本一杯でダウン。酔うと悪酔いして絡む。\n\n名前：真宮寺 昼\n髪色：灰白色\n設定：\n滅びゆく世界を変えるため未来から来た少年。未来のテクノロジーに詳しいが、本人はアナログ派で、武士のように剣を振るうことにこだわる。ファッションやファストフードが好きで普通のティーンエイジャー。大雑把で熱くまっすぐ、恋愛には鈍感。だが使命の重さゆえ、時折寂しげで重苦しい表情を見せる。\n\n関係性：\n少年は力を得るために神剣を抜き、偶然この大妖怪の封印を解いてしまう。二人は契約を結び、騒がしい同居生活を始める。互いに本来属さないこの時代で、彼らは唯一の居場所となる。\n\n日常の関わり：\n大妖怪は現代社会から大きくズレており、テクノロジーに大騒ぎしたり、人間社会から妙な「常識」を学んではトラブルを起こす。時には泥酔して絡む。\n少年は仕方なく、保護者のように後始末をさせられる。しかし妖怪がトラブルを起こした後、わざとしょんぼりしたり甘えたりすると、少年はどうしても甘やかしてしまう。ただし無闇に酒を飲むことだけは絶対に許さない。\n少年は巨大なペットを飼うように、手料理で餌付けし、街へ連れ出して新しいものを見せる。かつて人々を恐れさせた災厄の妖怪が現代の常識に好奇心や驚きの表情を浮かべるのを見るのは、少年にとって数少ないリラックスの時間である。\n大妖怪として当然プライドが高い。何かを成し遂げたり得意げになったりすると、少年のところへ自慢しに来て褒め言葉を要求する。そのたび少年は「全肯定bot」と化し、無条件に褒めちぎって大喜びさせる。\n\n◼︎ キャラクター参考画像\nhttps://drive.google.com/drive/folders/1BPsqQYxFwGJjuXxjPvbY943v7FDGrsLz?usp=drive_link\n\n金額や内容が合わない場合は遠慮なくキャンセルしてください。\nよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rvryonatu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3909503, "client_id": 1219454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3348c3ca/uploads/origins/5ca0b2e7-5d29-48fc-9c84-ee71e2c00190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dff1abfc4d59e93efdfda255da1bdff1", "srcset": "https://si.imgix.net/3348c3ca/uploads/origins/5ca0b2e7-5d29-48fc-9c84-ee71e2c00190?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dff1abfc4d59e93efdfda255da1bdff1, https://si.imgix.net/3348c3ca/uploads/origins/5ca0b2e7-5d29-48fc-9c84-ee71e2c00190?bg=%23fff&auto=format%2Ccompress&fm=webp