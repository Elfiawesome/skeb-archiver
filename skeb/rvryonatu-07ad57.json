dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ae9d51c608b55d5bb722027ab0d247", "srcset": "https://si.imgix.net/49cf4d12/uploads/origins/0a8f9eaa-908a-4388-bfb4-73f30dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ae9d51c608b55d5bb722027ab0d247, https://si.imgix.net/49cf4d12/uploads/origins/0a8f9eaa-908a-4388-bfb4-73f30dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=724ff69a3965b72ad1de4364e0ed2faf 2x, https://si.imgix.net/49cf4d12/uploads/origins/0a8f9eaa-908a-4388-bfb4-73f30dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e9b373d9c7681286a13dbc63317fe1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49cf4d12/uploads/origins/0a8f9eaa-908a-4388-bfb4-73f30dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b36a7c04f2b092814420a0666e915b6", "srcset": "https://si.imgix.net/49cf4d12/uploads/origins/0a8f9eaa-908a-4388-bfb4-73f30dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b36a7c04f2b092814420a0666e915b6, https://si.imgix.net/49cf4d12/uploads/origins/0a8f9eaa-908a-4388-bfb4-73f30dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32bc24b86c6f0588d4cd50b6385f3281 2x, https://si.imgix.net/49cf4d12/uploads/origins/0a8f9eaa-908a-4388-bfb4-73f30dfab4ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ac342931da7fd0020762c70221fe1d6f 3x"}, "body": "初めまして！絵がとても気に入っていますので、リクエストさせていただきたいと思います！\nもしよろしければ下記URLのうちの子２人を描いていただけますでしょうか。\n\n二人は友達で、よく一緒に授業をサボっている。互いが好きな戦略ゲームで競争し、好きなもの話している。\n表面で共通点が多くとても仲がいいが、裏で二人とも相手のこと「何かがおかしい」と疑いながら互いの隠し事に近づけようとしている。表の言葉や行動で、互いの裏を暴き出そうとしている関係で、どちらも自分の本意のこと猫かぶりしている。いずれ二人ともの目的に互いへの恋の気持ちが邪魔し、この関係から離れたい、または形を変えたいが、曖昧のままでいきなり終わってしまう。\n咲苗は自分に彼への気持ちを自分に許せないし、彼の気持ちのこと知らないふりしながら否定している。冬夜はずっと彼女に告白しよいとしているが、彼女はそれを毎回うまく避けている。2人ともは嘘つきで、冬夜だけはいずれ素直になりたい。咲苗はどんどんウソを重ね、もう彼に、彼女自身にも彼女の本音はどこにあるか分からなくなってしまう。\n\nご自由に描いていただければ幸いです。特徴は、二人の肉体的な親しさと感情的な距離の差です。この関係もかなりメランコリック的で、今しかないみたいな切ない・甘酸っぱい気持ちがどこかにあるのではないかと思いますが、普通に二人でいると楽しいや安心できるとも言える。ちょっと不健康...とも言える。\n一緒にふざけているところ、互いを疑っているところ、のんびりゲームするところなど、なんでもいいです！\n内容はお好みではない、不都合な場合など、なるべくキャンセルでお願いします。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/159Tz-4uFx9DAFXof3RrSOLlzpY5RRD2x?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rvryonatu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3909503, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20ec5cbb/uploads/origins/9af12529-28cf-4e4b-a04c-90b2bc5b8e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c27c5e9159512af6b1e5c841bc29ca81", "srcset": "https://si.imgix.net/20ec5cbb/uploads/origins/9af12529-28cf-4e4b-a04c-90b2bc5b8e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c27c5e9159512af6b1e5c841bc29ca81, https://si.imgix.net/20ec5cbb/uploads/origins/9af12529-28cf-4e4b-a04c-90b2bc5b8e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f61802ea1f0ada7148df9204a6cb8fa 2x, https://si.imgix.net/20ec5cbb/uploads/origins/9af12529-28cf-4e4b-a04c-90b2bc5b8e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6e32cbc5fe69318189b42a2d8a4442a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20ec5cbb/uploads/origins/9af12529-28cf-4e4b-a04c-90b2bc5b8e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfad66ad8ab5d308cdcbd4b852dfd3a7", "srcset": "https://si.imgix.net/20ec5cbb/uploads/origins/9af12529-28cf-4e4b-a04c-90b2bc5b8e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&b