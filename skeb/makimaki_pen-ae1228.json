6ae-b88fbf22609e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3dcabe90580dde10ee9d3d149022538", "srcset": "https://si.imgix.net/2a97aa88/uploads/origins/b709461c-9539-4286-a6ae-b88fbf22609e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3dcabe90580dde10ee9d3d149022538, https://si.imgix.net/2a97aa88/uploads/origins/b709461c-9539-4286-a6ae-b88fbf22609e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65ed92a11d3d5dbcddb4b3b88e3fb65e 2x, https://si.imgix.net/2a97aa88/uploads/origins/b709461c-9539-4286-a6ae-b88fbf22609e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9a69493cdf7f08b307230c369ec7997 3x"}, "body": "初めまして、きこりぃぬ・こまきと申します。\nHERO先生の作品は学生時代より作品を読ませていただいており、『堀さんと宮村くん』のような学校生活に憧れ、『浅尾さんと倉田くん』の傷に寄り添ってくれるような優しい言葉の数々に救われてきました。\nこの度はHERO先生がSkeb依頼を受けているとのことで、本日はイラストの依頼を送らせていただきます。\n\n依頼させていただきたいのは、私が書いている小説のメインカップルとなります。構図等はお任せでお願いしたく思います。\n\n①小栗鼠 美藤（17歳/女）\n・庇護欲をくすぐる小動物のような雰囲気\n・栗色のふんわり癖毛な髪\n・くりくりとしたヘーゼルブラウンの目\n・読書が好きな本の虫\n参考資料\nhttps://x.com/makimaki_pen/status/1898049514554245365\n\n②犬走 紺夜（17歳/男）\n・表情の変化が乏しく、見た目だけだと怖い人\n・癖のつかないブルーブラックのサラツヤショートウルフカット\n・睫毛の長いチャコールグレーの目\n・耳朶と軟骨にピアスをジャラジャラとつけている。\n参考資料\nhttps://x.com/makimaki_pen/status/1900541059589132548\n\n関係性\n・高校の入学式で犬走が小栗鼠に一目惚れしており、クールな顔で内心は「可愛い」だの「尊い」だのと騒いでいる。\n・犬走の好意が溢れて形になった紙飛行機が毎日小栗鼠のもとに届いており、紙飛行機の中に「好き」だの「今日も可愛すぎる」だの書かれているため小栗鼠は犬走の気持ちを知っている。\n・紙飛行機は小栗鼠にしか見えない不思議な紙飛行機である。\n\n\n▼使用用途（利益が発生する使用はしません）\n・個人観賞\n・X、bskyにての掲載/アイコンやヘッダーとしての使用（クレジット表記厳守）\n・スマホ、PCの壁紙\n\n以上となります。ご検討をお願いいたします。\n\nhttps://x.com/makimaki_pen/status/1891731517992300971", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_hesperus/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 696666, "client_id": 2771994, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgi