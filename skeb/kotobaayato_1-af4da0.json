a/uploads/origins/e53df1c9-f7fd-424a-9328-444076d22bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a5a2bd68703bb4ee1c4ed9ae8ad661a, https://si.imgix.net/f502d32a/uploads/origins/e53df1c9-f7fd-424a-9328-444076d22bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ac8506447dc4b56d8006a0962268f7 2x, https://si.imgix.net/f502d32a/uploads/origins/e53df1c9-f7fd-424a-9328-444076d22bb7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa51deeaf2eefe54659594cc1f32bd81 3x"}, "body": "こんにちは。素敵なイラストを描いていただけないでしょうか。\n描いていただきたいのは、関谷スバル（私のオリジナルキャラクター）です。https://skeb.jp/@geso_nj/works/13 。\n（あなたのスタイルで）緊張した様子で座っているスバルを描いていただけると嬉しいです。\nスバルは学校の机に横向きに座っている姿にしてください。\nスバルには制服を着せてください。\n- 濃い色のレギンスを履かせてください。\n設定：スバルは女子の制服を着て学校に通っています。実はスバルは男の子です。\nポーズ・アングル・背景、その他のディテールについては、すべてお任せします。（文字は入れないでください。）\n本当にありがとうございます！ 💕", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotobaayato_1/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3965967, "client_id": 3930655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=152c0bee1d4aa4863a40c3c8ed5d688d", "srcset": "https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=152c0bee1d4aa4863a40c3c8ed5d688d, https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=516f882323b915ff67736521a39b2c60 2x, https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8012cbfae2872e4dfd0706a6b84ec17f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2be0a9366d0fb5b432388b62c87e1306", "srcset": "https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2be0a9366d0fb5b432388b62c87e1306, https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ecbff23e0bd06148b9046dfe1035339 2x, https://si.imgix.net/b0f0a844/uploads/origins/05089f9e-6d6d-4a4a-93fb-862ced16933f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=37b3b10f96f00085673477f6f2043617 3x"}, "body": "言葉綾人様\n\n　初めまして。\n　Xで投稿されていたカヨコのSM調教シリーズに性癖が大変刺激されまして、良ければそのようなR-18系イラストをお願いしたくリクエストをお送りいたします。詳細は下記の通りになります。\n\n【キャラクター】\n　ブルアカの朱城ルミにてお願いしたいです。\n　ルミのスタイルについてですが、以前にも描かれていたカンナやエイミのように胸が大きめのムチムチなスタイルも好きなので、ルミもそのように描いてもらえれば幸いです。\n\n【シチュエーション】\n　大まかに述べるとカヨコのイラストのように「先生と同意の上で緊縛されてSM調教プレイ中」というシチュエーションのイラストをお願いしたいです。\n　ルミの反応や表情についてですが、「既に先生と関係やSM趣味への理解も持っていて、プレイ中は重役の責任や立場を一旦忘れて愛する先生に甘えたり発散したり出来るからとルミ本人もノリノリでSMプレイに付き合っている」というような背景で考えて貰えれば幸いです。\n\n【プレイ内容や小物】\n　具体的なプレイ内容ですが「麻縄で手足を縛りあげて身動きを取れなくし、大人の玩具をつけての放置プレイ中」といった内容でお願いしたいです。先生が業務から戻ってくるまでの前戯で行なっていて、というイメージで描いてもらえれば幸いです。\n　縛り方については腕は後ろ手に高手小手縛りを、身体に亀甲縛りを、両足も逃げられないよう折り畳んで縛りあげてください。また手自体もテープでグルグル巻きにして絶対に縄抜け出来ないよう完全な拘束をされているように描写してもらえると大変嬉しいです（アングル等で不要そうであれば省いてもらって大丈夫です）。\n　大人の玩具については首にSM用の首輪、口にはイラマチオ強要用の口枷のリングギャグを、胸に乳首を挟むようにローターを、秘部にはディルドを跨がらせて根元近くまで差し込んでください。\n　ルミの格好については公式の立ち絵でも履いているタイツ、緊縛拘束用の赤い麻縄、SM用の首輪、それと上記であげている玩具以外は無しの裸でお願いしたいです（他にも捗る小物等あれば自由に追加、添削してもらえれば幸いです）。\n　\n【モノローグまたは台詞等の差分追加のお願い】\n　カヨコのイラストにあったような体験を語る日記調のモノローグ、またはケイのイラストにあったような相手に向けた台詞（口枷付けているのでルミの心の声、反応）等の差分に大変性癖刺激されていましたので、このリクエストのルミにも言葉綾人様の解釈を交えながらご用意頂きたくお願い申し上げます（作業量に見合わなければご指摘頂けますと幸いです）。\n　またこれも可能であればで結構ですが、責められつづけたルミがついにイッた瞬間の表情やイッた後に帰ってきた先生を期待の眼差しで見やる表情等の差分を拝見出来れば幸いです。\n\n　以上になります。\n　プレイ内容のイメージにpixivのイラスト（azmkyoro様の作品）のURLを添付いたしますので参考にお使いいただければ幸いです（構図やアングル等はご自由にご設定ください）。\n　それでは言葉綾人様のお時間と余裕が合いましたらご検討よろしくお願い申し上げます。\n\nhttps://www.pixiv.net/artworks/146446235#manga", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotobaayato_1/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3965967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3459d82/uploads/origins/7cdbdedc-c177-4fc9-93a5-04e9fa9fea99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba6356791d3a5b410a460c219c90465", "srcset": "https://si.imgix.net/b3459d82/uploads/origins/7cdbdedc-c177-4fc9-93a5-04e9fa9fea99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ba6356791d3a5b410a460c219c90465, https://si.imgix.net/b3459d82/uploads/origins/7cdbdedc-c177-4fc9-93a5-04e9fa9fea99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45ab003542c2a3fc8b644359e4ba52a9 2x, https://si.imgix.net/b3459d82/uploads/origins/7cdbdedc-c177-4fc9-93a5-04e9fa9fea99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=789d0b4d8212f7a2864258e643805d80 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3459d82/uploads/origins/7cdbdedc-c177-4fc9-93a5-04e9fa9fea99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93eee28f6ce58b668b6c27bec2e86ff5", "srcset": "https://si.imgix.net/b3459d82/uploads/origins/7cdbdedc-c177-4fc9-93a5-04e9fa9fea99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93eee28f6ce58b668b6c27bec2e86ff5, https://si.imgix.net/b3459d82/uploads/origins/7cdbdedc-c177-