好みで、ぜひ描いていただきたくリクエストさせていただきました。\n今回のリクエストは、TRPGで使用している創作キャラクター2人のイラストになります。 \n\n▼詳細\n下記リンクまとめましたので、ご参考になれば幸いです。 \n\n▼リクエスト内容 \n服装、構図やモチーフの取捨選択、追加・省略などはすべてお任せいたします。 \n👾さまの解釈やアレンジで自由に描いていただけると嬉しいです。\n\n▼使用用途 \n・個人的鑑賞 \n・SNSなどでの公開（アイコン・ヘッダーに使用など） \n・個人でのグッズ化（非営利）\n\n▼備考 \n可能でしたら、背景透過版があると大変ありがたいです。（必須ではありません）\n金額等に不備がございましたら、再送申請やキャンセルをしていただいて構いません。\n\nここまでお目通しいただき、ありがとうございます。 \nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1eysABXEzYPA3F_mr54-bYIUBuNN8LgX-?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ZyAxfwl/works/182", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8fcb80b9/uploads/origins/ae7bfa9d-6f32-4bb5-89c0-efa62b1b5853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c83bee38a983e450a098b8c64009814", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3483125, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ZyAxfwl/works/181", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c77f45de/uploads/origins/68821111-414e-4a1c-a223-93da057486d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dde24b108a4545dbc1f04c265bafb2c9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3483125, "client_id": 3713282, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ZyAx