_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ZyAxfwl/works/186", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3483125, "client_id": 2050581, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3e5515a/uploads/origins/c89896b3-c52a-437d-83d5-07f1d1caa056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f34d66b0cb664b34d18a233d81cbef33", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3e5515a/uploads/origins/c89896b3-c52a-437d-83d5-07f1d1caa056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b3f5820480b8d1c58d0285f80711138", "src_set": ""}, "body": "こんにちは、先生。前回の依頼では、とても美しい作品を描いていただきありがとうございました。今回も依頼をお送りしたいと思います。🥺💕私の友人のOCを描いていただけることを心から願っています。 この絵を彼女にプレゼントしたいんだ。\n私はあまり日本语が上手ではありません。许してください。\n\n使用について\n*自分鑑賞用\n\n構図などもすべてお任せいたします。自由に描いてください。先生の画風は何を描いても素晴らしい！\n\n人物と背景をそれぞれ別にできるよう透過したものをデータに入れていただきたいです。\nサインは.psdファイル内の別のレイヤーに作っていただけるととても嬉しいです。\n\nもし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。🥺\nよろしくお願いいたします!\n詳細な描写はリンクの中に。\nhttps://www.deviantart.com/stash/21bd8jd504g", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ZyAxfwl/works/185", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5dababb1/uploads/origins/e46bf8f9-718e-4cc6-ab00-1d9608118f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05d3ffbf2ea7812b94c3fc15432107ec", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3483125, "client_id": 727718, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "",