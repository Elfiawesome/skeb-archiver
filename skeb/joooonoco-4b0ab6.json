78d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc09485cee04476243d0bf0a9007ddf9, https://si.imgix.net/96d256f0/uploads/origins/f818add3-d74f-4bc2-b7bf-15b4607278d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=997d1e4c5b4f06fbb02101e9c26bca63 2x, https://si.imgix.net/96d256f0/uploads/origins/f818add3-d74f-4bc2-b7bf-15b4607278d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d08bb98fa39836b66056a5c3dc246bf6 3x"}, "body": "こんにちは。TRPGの自キャラの女の子が誕生日を迎えるので、お祝いのイラストをお願いします。\n15歳の誕生日で、世界観的には成人する年です。\nお祝いされてはにかみながら喜んでいる姿をお願いします。\n\n以下キャラクター設定\n全て反映させる必要はありません。\n参考程度にご覧ください。\n服装なども資料から変えていただいても構いません。\n\nキャラクター名：セレシェイラ\nスペルはCerejeira、意味は桜\n誕生日：2月13日\n誕生花：エーデルワイス\n誕生石：アメジスト\n利き手：右\n身長：155cm\n担当カラー：緑\nただし、イメージカラーはピンクとして認識されている。\n\nかつて伝説の6人組冒険者パーティー『欠けた虹』のヒーラーとして活躍した神官。\nペガサスや鳥のゴーレム、妖精なども操れる凄腕魔法使い。\n現在は大神官として神殿の運営を行い、多くの信者に敬愛されている。\n先に誕生石を迎えた同い年の恋人がおり、セレシェイラの成人を機に入籍予定。\nまだわずか14歳ですが生ける伝説であり多くの人に愛され祝福されるべき子です。\nどうぞ喜ばせてあげてください。\n\nhttps://drive.google.com/drive/folders/1SrzDxWnaqCPppyRTPadpnLxYWglvR9S-", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@joooonoco/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2370873, "client_id": 1872748, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0616a0b/uploads/origins/8c7bc239-e366-4ad6-9358-8fa7243f5913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3abaa908ffa5c114dcb0dbb7252495c", "srcset": "https://si.imgix.net/f0616a0b/uploads/origins/8c7bc239-e366-4ad6-9358-8fa7243f5913?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3abaa908ffa5c114dcb0dbb7252495c, https://si.imgix.net/f0616a0b/uploads/origins/8c7bc239-e366-4ad6-9358-8fa7243f5913?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73ffcf636329019