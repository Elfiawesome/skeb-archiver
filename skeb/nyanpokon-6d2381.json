どで使用される予定ですので、背景とキャラクターが分離された透明PNGまたはレイヤー分けされたPSD形式での納品を希望します。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1voktwhdPsiTt1WimXsfpi0ZtDbKx6izR", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nyanpokon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4102314, "client_id": 2991126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=345a0d8f27ce44cd327aca556f82cee6", "srcset": "https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=345a0d8f27ce44cd327aca556f82cee6, https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82fb6c8a40c0bdf0a08cfba4ff0aa5f0 2x, https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a1a541f33decc8d4511a65c5a219081 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ca418c31ff4c7f249b40bc2d087f07", "srcset": "https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ca418c31ff4c7f249b40bc2d087f07, https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd3c730def09dd518aff09128dd18dfe 2x, https://si.imgix.net/3761e16b/uploads/origins/c0e44a7a-f97b-4383-8e2d-90fb25e65f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c699af5e7eaa967d182a46eaa77c9692 3x"}, "body": "先生、こんにちは！先生のイラストが大好きです！私のキャラクター「フェイブル・フェアリーテール」を描いていただけたら嬉しいです！\n\nフェイブルはノンバイナリーで、身長は175cm。巨大で謎めいた組織に所属する超自然的なモンスターハンターとして活動しています。人に憑依したり、周囲の世界を「編集」したりする能力を持っています。 親切で陽気、カリスマ性がある一方で、空想的で純真なフェイブルは、物語に囲まれて育ち、自分こそが他の人々の人生の「語り手」だと信じています。そのため、知らず知らずのうちに人を操ってしまうことがあり、自覚せずに「悪役」を演じてしまうこともあります。 このキャラクターの象徴は、カッコウ、本、図書館、そしてリュートです！\n\nなお、右耳がありませんのでご注意ください。また、このキャラクターが封印したモンスターの受動形態であり、親友の一人でもあるカナリアも描いていただけると大変ありがたいです！それ以外はすべてお任せします。\n\n報酬額が不十分な場合は、お断りいただければ、金額を増やして再送いたします。ご検討いただきありがとうございます！\n\nhttps://toyhou.se/27202189.fable", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nyanpokon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4102314, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68796f10/uploads/origins/f1b76443-c8b9-4004-84c0-facecb3385f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef86ad007f992963dbc21170bbcdb36a", "srcset": "https://si.imgix.net/68796f10/uploads/origins/f1b76443-c8b9-4004-84c0-facecb3385f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef86ad007f992963dbc21170bbcdb36a, https://si.imgix.net/68796f10/uploads/origins/f1b76443-c8b9-4004-84c0-facecb3385f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a2111b88e34da36cb0c0b513ccd0be95 2x, https://si.imgix.net/68796f10/uploads/origins/f1b76443-c8b9-4004-84c0-facecb3385f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e4e3c860ede47020fd88beef750af7a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68796f10/uploads/origins/f1b76443-c8b9-4004-84c0-facecb3385f3?bg=%23fff&auto=format%2Ccom