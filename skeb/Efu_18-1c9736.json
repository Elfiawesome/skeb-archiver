状態。\n少年は脱力して痙攣。\nマキは仕方ないなぁという感じの優しい笑顔で少年を見下ろしている。\n\n2、満面の笑みのマキがペタンと腰を下ろして跨って挿入しているだけの騎乗位で少年を搾り取っている状態。\n少年は激しい快楽に悶え何度も射精している感じで。\n\n3、座ったままの弦巻マキが疲弊しきって完全に脱力した少年を優しく抱き締めながらキスをしている。\n\n※弦巻マキは余裕たっぷりで優しくを意識して描いて頂けるとありがたいです。\n\n内容が合わなければキャンセルしていただいて結構です。\nお忙しい中恐れ入りますがご検討よろしくお願いいたします。\n\nhttps://www.google.com/amp/s/tumidangosan.tumblr.com/post/634157034002153472/%25E5%25BC%25A6%25E5%25B7%25BB%25E3%2583%259E%25E3%2582%25AD/amp", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Efu_18/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/999ba0b9/uploads/origins/d47bfdbe-329d-4fcc-89b0-b6dd62ba62cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9f4b70ed14bbe5643025ff5f7ff2831", "srcset": "https://si.imgix.net/999ba0b9/uploads/origins/d47bfdbe-329d-4fcc-89b0-b6dd62ba62cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9f4b70ed14bbe5643025ff5f7ff2831, https://si.imgix.net/999ba0b9/uploads/origins/d47bfdbe-329d-4fcc-89b0-b6dd62ba62cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b28a1a28a0b2278b5f50d945367c60ec 2x, https://si.imgix.net/999ba0b9/uploads/origins/d47bfdbe-329d-4fcc-89b0-b6dd62ba62cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba2febcaf513d5ee53b6474f867e640f 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2270572, "client_id": 108989, "nc": 49}], "sent_works": [], "similar_creators": [{"id": 174888, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Y4G1", "screen_nam