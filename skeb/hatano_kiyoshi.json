total_appeals_count": 0, "received_works": [{"path": "/@hatano_kiyoshi/works/145", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 202846, "client_id": 638155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6f94800/uploads/origins/6da4f640-de66-4e7f-959b-72259d125bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6c2674739718eaef24d515cf29c0c1f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6f94800/uploads/origins/6da4f640-de66-4e7f-959b-72259d125bb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67691dc0922bac0a3e2153d12588b298", "src_set": ""}, "body": "はじめまして。いつもラドリーなどのOCGイラスト楽しみにしています！\n今回、ドラゴンメイド・ハスキーのイラストリクエストをお願いできますと幸いです\n\n【コンセプト】\n劇場版「超融合！時空を越えた絆」のパラドクスによってSinドラゴンメイド・ハスキーに変えられてしまった姿のイメージ\n\n【デザイン要望】\n・顔は（一応）操られている状態のため虚ろ目、身体はSinスターダスト・ドラゴンのデザインの人間版のような黒いレオタードの上にコートのように白衣を羽織っている風（パラドクスの研究助手兼メイドのようなイメージ）※デザインはあくまでお色気気味程度で大丈夫です\n・細かな装飾は省略可、腕の爪・翼や尻尾はSin パラダイム・ドラゴン風のカラー\n\n【その他要望】\n・立ち絵風の姿と、可能であればメイドとしての本能で研究に没頭しているパラドクスの世話をおせっかいでやっているような場面をお願いできますと幸いです（パラドクスにとっても世話を焼かれるのは想定外で戸惑っているイメージ）。パラドクスの姿は簡略化しても大丈夫です\n\n【資料】\n・Sinスターダスト・ドラゴン\nhttps://x.com/YuGiOh_OCG_INFO/status/1086612992177799168\n・Sin パラダイム・ドラゴン\nhttps://pbs.twimg.com/media/EcPDf7ZVAAA0Ge8.jpg:large\n\nhttps://pbs.twimg.com/media/E2NWsdcVkAMf1oZ.jpg:large", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/144", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 202846, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7ef5b1c/uploads/origins/e0427c5f-a97e-4952-a741-d78744cb011a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15b22e5f4ffd4fd015eed99c969b6115", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7ef5b1c/uploads/origins/e0427c5f-a97e-4952-a741-d78744cb011a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ea601a39b5bc6da18bed3ef2b703304", "src_set": ""}, "body": "ライゼオルに抵抗するラドリー\nティフォンに搭乗して手四つで組み合うラドリー\n強制脱出装置で射出されるラドリー\nアーゼウスに乗り換えて対抗するラドリー\n白旗を上げるラドリー", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/143", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 202846, "client_id": 1937910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/756b8ff6/uploads/origins/60cd143d-5f06-4141-8c3a-63a322e86abd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60e66ec09b10853e014c6a7bda3a3edc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/756b8ff6/uploads/origins/60cd143d-5f06-4141-8c3a-63a322e86abd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f47598d8b8226ae326a8fe9974b4d44", "src_set": ""}, "body": "いつもお世話になっております。\n\n今回は以前描かれていた「OCGファイターズ」のような構図で「創星竜華－光巴」と「聖王の粉砕」の赤い娘のペアと「転惺竜華－闇巴」と「霊王の波動」の青い娘のペアが対立しているイラストを描いていただきたいです。\n\nまたnoteのサムネ等で使用させていただこうと思っております。\nご検討宜しくお願い致します。\n\nhttps://www.pixiv.net/artworks/118672631", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/142", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 202846, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0253831d/uploads/origins/42635914-4a80-4282-a36c-973c18778251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=998068c615ea27cbcd6ff25fafec0bc3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0253831d/uploads/origins/42635914-4a80-4282-a36c-973c18778251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad52c5991eaf410cb2f66d7b1b4781b3", "src_set": ""}, "body": "・「ARG☆S」のカードたち\n・《ＳＲベイゴマックス》と《ＳＲタケトンボーグ》\n・《Ｍ.Ｘ－セイバー インヴォーカー》\n・《影法師トップハットヘア》\n・《斬リ番》\n・《苦紋様の土像》\n・《澱神アポピス》\n・《碑像の天使－アズルーン》\n\n上記のカードたちが同じ方向に向かって仲良く、勇ましく、勢いよく走っているイラストを描いてもらいたいです。\n\n※数が多くてすみません。これら全員は必ずという訳ではなく、描ききれるだけ描いてもらえたらと思います。\n\n「みんな！絶対勝つぞ！チームARG☆S！出動！！」といったノリのイラストにしていただきたいです。\n\n色々指示が多くて恐縮ですが、ご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/141", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 202846, "client_id": 3343396, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f2b575f/uploads/origins/e553eec1-e0f1-43a2-841e-5441d7c345d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=decbf1977abf21cfcbb5abc4a795c572", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f2b575f/uploads/origins/e553eec1-e0f1-43a2-841e-5441d7c345d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01fbc7ee26542a36538b4f40f2082355", "src_set": ""}, "body": "こんにちは！ゲーム「デュエルリンクス」のキャラクターのようなポーズのティルルの絵が欲しいです。デュエルリンクスでは、キャラクターが好きなモンスターを召喚するとき、アニメーションが流れます。それに似たポーズのティルルが欲しいです。参考資料のように左を向かせて。片方の腕を伸ばすとか。口は独白するように開けて。表情は自信に満ちているはずだ。背景のごく遠くで、パーラがティルルを面白がっている。今までの作品のぱるるの表情の描き方が好きです。<3\n\nこのシーンの2つ目のバリエーションも作ってもらいたいです。ティルルの両腕がないバージョンが欲しいです。すごく恥ずかしがっているんですけど、平静を装っている。彼女はまだ、自分の義務だからとポーズをとって一人芝居をしようとしているが、恥ずかしがっている。ぱるらは腕のないティルルを見てもっと驚いている。参考までに、腕のないティルルの写真と、腕のないティルルのドレスのデザインを載せておきます。\n\nこのリクエストは、私のストリームのために使われます。このリクエストは後でアニメーションにする予定です。レイヤー付きのPSDが欲しいです。レイヤーがあった方が作品を分割しやすいので。\n\n私の要望を読んでいただきありがとうございました。私はあなたのドラゴンメイドのアートがとても大好きです。このリクエストが実現したら、とてもうれしいです。\n\nhttps://drive.google.com/drive/folders/1RPCLzcPRin2Q6-y3HDPWBInlX5JnYFj9?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 202846, "client_id": 2488239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67722dd1/uploads/origins/38f027a8-fa70-481c-855a-d9653f37859f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c276906df1211623bdfb72958cde1c71", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67722dd1/uploads/origins/38f027a8-fa70-481c-855a-d9653f37859f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c741a923c23b8d5f58e71515b8b405e1", "src_set": ""}, "body": "いつもイラスト拝見しています\nリクエスト失礼します\n今回はocgのクイーンマドルチェ・ティアラフレースとラッシュのティラミス・ヴァルキリアが、互いの自慢のティラミスで勝負といったイラストをお願いしたいです\n可能であれば早く食べさせろとよだれダラダラでフォークとナイフを突き立てる審査員ラドリーとボケ〜っとティラミスを見つめる審査員エクスキューティー・プラウティ・Fもお願いしたいです\n細かいところはお任せします。\n初めてのリクエストで恐縮ですが、ぜひお願いいたします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/139", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 202846, "client_id": 69935, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb13eeaf/uploads/origins/401ab400-a4b4-475f-9c0e-e780b388c596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=357799072052ec1c2a80663f9feb7cef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb13eeaf/uploads/origins/401ab400-a4b4-475f-9c0e-e780b388c596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1606f22b1915e9142a3fd34577f9dfb4", "src_set": ""}, "body": "以前弱音ハクを描いていただいた者です。よければもう一度同じキャラをリクエストさせていただきます。\n弱音ハクが【魔界劇団】のデッキを用いてデュエルをしている姿を描いていただけないでしょうか。\nよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/138", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 202846, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e91de2ed/uploads/origins/9f01f118-e476-49ee-9010-26c77e2874c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78fb87f96fa1bbb9b129102a5d0259b0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e91de2ed/uploads/origins/9f01f118-e476-49ee-9010-26c77e2874c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4b30c6c658f91c8b8e0e8724ff613d8", "src_set": ""}, "body": "こんにちは。以下の内容のイラストをリクエストさせてください。\n\n・シチュエーション\nラドリーが様々な方法で効果を無効にされる。\n禁じられた一滴を浴びてへにゃへにゃになる、自身の服や洗濯物が無限泡影のイラストのように崩壊する、スキルドレインで力が抜ける、バグースカで酔い潰れたように動けなくなる等々", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatano_kiyoshi/works/137", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/05163d09/uploads/origins/e81827d3-1a42-4648-98c8-4eec23851788?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=781ecb79d4ced1950a73d9f33d7473db", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 202846, "client_id": 1423485, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hatano_kiyoshi/works/136", "private_thumbnail_image_urls"