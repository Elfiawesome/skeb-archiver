ic": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@toteni_kinact/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526636, "client_id": 1252229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeab66bb/uploads/origins/c4ff284d-9f4d-4b8b-8c4d-2dce306008b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1ff88b72a12c14ed8afdb4b5c601853", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeab66bb/uploads/origins/c4ff284d-9f4d-4b8b-8c4d-2dce306008b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a6457abe38c33ab88b9c406bb24a49a", "src_set": ""}, "body": "こんにちは！\n\nあなたのスプラトゥーンのイラストがとても好きです。  私の女性のインクリングを描いていただけませんか？\nhttps://imgur.com/a/new-updated-refs-3CGfOMy\nhttps://imgur.com/a/additional-refs-k5qAwUn\n\n私のインクリングの女の子を好きなように描いてください。\n\n他の人のスプラトゥーンキャラを描かないのであれば、それは理解しているので大丈夫です。\n\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toteni_kinact/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2cb96d2b/uploads/origins/e77765c2-2ee2-4815-99fc-d4244f6eee71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7af59b4d6bf0c8148ee000ab5b71dedb", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3526636, "client_id": 501375, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toteni_kinact/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526636, "client_id": 1677305, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d2af4b5/uploads/origins/96392a3a-ec1e-4982-94f3-d413a9fbdb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c82060ae921b28b759d1b973dc5d2b0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d2af4b5/uploads/origins/96392a3a-ec1e-4982-94f3-d413a9fbdb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3eac5c61ef8ac2f3354c1ab40ed50a1", "src_set": ""}, "body": "スプラトゥーンのイカちゃんの擬人化のイラストをよろしくお願いします。\n・髪型は三つ編み、髪色は青色\n・眉毛は細長く\n・目の色も青色\n・片耳には銀色のイヤリング\n・服は白色のTシャツでお腹が少し見えるくらいの丈の短さでサイズは小さめ\n・Tシャツにはヘビ(シャケ)の刺繍をワンポイントに欲しいです\n・ボトムスは黒の丈が短めでサイドラインありのスパッツ、出来ればピチピチで割れ目が見えちゃうくらいのをお願いします\n・足には青色、水色、緑色の3色を使ったミサンガ\n・武器などは無し\n・ポーズは斜め前を見て胸を張って腰に手を当てる状態\n・表情は元気のある自信ありげな表情\n・アングルは少しローアングルで\n・背景おまかせ\nこちらの内容でよろしくお願いします！！！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toteni_kinact/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8e86c075/uploads/origins/9f22e9cd-9e3b-4e84-99b1-1d434d956778?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf652379b3f482eadf1d711d6c41c788", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3526636, "client_id": 1777245, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toteni_kinact/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526636, "client_id": 172351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33398ded/uploads/origins/3876c5cb-73fb-413e-a820-43028f62df87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d23092e67111c9fbf02c8d2a04a715f2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33398ded/uploads/origins/3876c5cb-73fb-413e-a820-43028f62df87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c631438ef1bf0e2219ccfe3c4ba77bf", "src_set": ""}, "body": "こんにちは！私の黄色いイカを可愛く描いてくれませんか？お尻が見えているポーズで、シャツ一枚で、下半身は何も着ていません！シャツの一部を持ち上げて、何も着ていないことを見せます。アソコは見えなくてもOK！\n\nロリ体型のキュートでハッピーなイカです！\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1VotKkhnsCuenNsQdDLtFOePvgm-n90mY?usp=sharing\n\nhttps://drive.google.com/drive/folders/1VotKkhnsCuenNsQdDLtFOePvgm-n90mY?usp=sharing", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toteni_kinact/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526636, "client_id": 1388164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63addcfa/uploads/origins/93209213-eb45-46b1-a42d-bca7b5e81626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a922a6e9a8cfb351c9dca54cc513186", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63addcfa/uploads/origins/93209213-eb45-46b1-a42d-bca7b5e81626?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57a2a462dc489ab9e2221c6296fed82c", "src_set": ""}, "body": "Hello Toteni-san! I love how Citrus came out and I am now handing over my first character that I created! Anne-Senchō! I have provided the reference for her outfit and I'd also like an alternate with her jacket off like you did the bikini for Citrus! Her weapon is also スプラシューターJr. She is very energetic and her personality is like Luffy from One Piece\n\nhttps://toyhou.se/4143043.-anne-levi-livyatan-/18963640.splatoon-3#63895512", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toteni_kinact/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3526636, "client_id": 1388164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e19e2c2/uploads/origins/6e280ccd-3563-487a-b32d-c0fa8da43823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27bfbc64ff794d3471d6e27d8c9f5555", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e19e2c2/uploads/origins/6e280ccd-3563-487a-b32d-c0fa8da43823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa22f8d104175e9480e897876f87df07", "src_set": ""}, "body": "Hi Toteni-san! Sending a request through Skeb this time! It will be my oc Cas with Fuuka in a romantic setting. https://www.pinterest.com/pin/10836855344995411/ reference for the pose for Fuuka and Cas. The image can be reversed though so Fuuka's eye can be seen.\n\nhttps://toyhou.se/22610254.cas-tsururen#77825718", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toteni_kinact/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526636, "client_id": 1215355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b0e12d2/uploads/origins/887e1229-4add-4205-8d67-890b7fd6e16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9feacb078c0a2e24fc0c9969e13a0df1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b0e12d2/uploads/origins/887e1229-4add-4205-8d67-890b7fd6e16b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34421163f6000c19c81a8c2cd92c8b87", "src_set": ""}, "body": "こんにちは！あなたの作品が大好きです！もし可能であれば、私のインクリングガールのイラストをお願いしたいです。インクリングの女の子は、スポーティーな感じか、明るい感じか、かわいい感じか。服装に関しては、インクリングガールの参考画像でお伝えします。ポーズについては、参考画像にあるようなポーズでお願いします。背景はお好きなもので結構です。ありがとうございました！\nhttps://imgur.com/a/W3iztb2\n\nhttps://imgur.com/a/W3iztb2", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toteni_kinact/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3526636, "client_id": 2971868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a549b623/uploads/origins/42edb0e8-ece4-4384-9b9f-2d5d34f13db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d6725e1a90ec6034b6faeec2f836d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a549b623/uploads/origins/42edb0e8-ece4-4384-9b9f-2d5d34f13db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=531a6a8927a14037a72cf1d7b6eb6ab8", "src_set": ""}, "body": "トテ仁 侑(ﾄﾃﾆ ﾕｳ)さん、こんにちは。\nTwitter(現X)でスプラトゥーンのイラストを拝見しています。\n素敵なイラストを描かれてるのを一目惚れして、今回募集しているのを見かけましてリクエストを送ろうと決めました。\n\nリクエストの内容は、自分のマイイカちゃんを描いていただきたいです。\n名前は\"てぬぐい\"ちゃんと言います。\n温泉×銭湯×サウナ♨️が大好きなぱっつんイカちゃんです。\n\nちょっと季節を先取りして夏のイメージのイラストにしたいので、お気に入りのギア+水着姿\nをお願いしたいです。\nお気に入りのギアはこちらです。\nアタマ→ヤキフグビスケットバンダナ\nフク→わかばイカT\nクツ→ベリベリサン シアン\n\n水着は動かしやすいスクール水着or競泳水着でお好きな方を選んでいただいて構わないです。どちらも好きな水着なので、トテ仁さんのお好みでお願いします。\n首元にアタマギアのスイミングゴーグルを身につけていて、小物類でビート板を持ってるところをお願いします。\nわかばイカTはTシャツの裾を結んでお腹が丸見え姿でお願いします。\n\n前からと後ろからの2パターンあると嬉しいです。\n出来たら差分でフクとクツを無くしたVer.もお願いします。\n(バンダナはチャームポイントなので身につけた状態)\n背景はおまかせします。\n\n温泉が大好きなイカちゃんなので、肌の露出は慣れているため、恥じらいは一切なく楽しそうな感じでお願いします。表情もおまかせします。\nちなみに、温泉の効能のおかげでぷるツヤで綺麗なお肌の持ち主です。他のイカタコちゃん達がつい見とれてしまうお肌をしています。\nインクカラーは水色(ミント色)、お肌の色は小麦肌でお願いします。\n(肌のセレクト画面では真ん中から右1つの肌色です)\n\nトテ仁 侑(ﾄﾃﾆ ﾕｳ)さんのスプラトゥーンのイラストはお肌や髪(ゲソ)のぷるツヤ感やムチッとプリっとした下半身(ヒップや太もも)が強調していて、素敵な作品が多いのでつい見とれてしまいます。\n今回のリクエストは肌の露出が多めなので、上記を思う存分強調していただいて大丈夫です。\nちなみにNSFW設定は無しです。\n\nてぬぐいちゃんの設定と\nイメージ画像は資料URLを開いたら分かります。\n\nこれからも素敵なイラストや同人本を拝見できることを楽しみにしています。よろしくお願いします。\n\nhttps://x.com/yurutabitaku/status/1827911789406822401?s=46&t=UDUub52TLe5PmXH-9E0Ugg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 21322, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おぎノン", "screen_name": "oginon07", "avatar_url": "https://pbs.twimg.com/profile_images/1547515764403367937/u5DhuRbx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/201769199/1641026100/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 33}, {"id": 129732, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にょろ/Nyoro", "screen_name": "h_nyoro", "avatar_url": "https://pbs.twimg.com/profile_images/1900803519680286720/6DX1hMec.jpg", "header_url": "https://pbs.twimg.com/profile_banners/116807800/1757064706/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 48}, {"id": 731470, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "アズマ　ジョウ", "screen_name": "ce_rolan", "avatar_url": "https://pbs.twimg.com/profile_images/1310507911647358977/0HujdGUy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/761957398617567234/1599639134/1500x500", "appeal_receivable": false, "popular_creator_rank": 91, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_exp