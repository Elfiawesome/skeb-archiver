キーを焼く\n- エイリアンのモンスターと戦う\n- エレキギターを弾くふりをする\n- クールでエッジの効いたアクションポーズ\n- その他お好きなポーズ\n\nいずれにせよ、僕のリクエストを読んでくれて本当にありがとう！\n\nhttps://drive.google.com/drive/folders/1YQ4Iw4idpFiQBivhMkWU8m5lAriDDkQD?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_czhih/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2601303, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/648c30dc/uploads/origins/c2179586-520d-435e-9f2f-6c4a5d230b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0cc1f01832cc616fc4011c4121f769d", "srcset": "https://si.imgix.net/648c30dc/uploads/origins/c2179586-520d-435e-9f2f-6c4a5d230b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0cc1f01832cc616fc4011c4121f769d, https://si.imgix.net/648c30dc/uploads/origins/c2179586-520d-435e-9f2f-6c4a5d230b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0781fe72b498919a7c7c152a481e6654 2x, https://si.imgix.net/648c30dc/uploads/origins/c2179586-520d-435e-9f2f-6c4a5d230b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37747ed7693b9dc9f86ee775f1d3ec63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/648c30dc/uploads/origins/c2179586-520d-435e-9f2f-6c4a5d230b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20aa5f4912d7daca062ea0b4b5bccbbb", "srcset": "https://si.imgix.net/648c30dc/uploads/origins/c2179586-520d-435e-9f2f-6c4a5d230b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20aa5f4912d7daca062ea0b4b5bccbbb, https://si.imgix.net/648c30dc/uploads/origins/c2179586-520d-435e-9f2f-6c4a5d230b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f87fe540b844b6b0c0c86679b