687-44c6-b65e-7fc3738d169f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ab5a3f1cb72d6681aa5540e338d03a, https://si.imgix.net/aa61999d/uploads/origins/2bd806ed-4687-44c6-b65e-7fc3738d169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=577c84def146ac27f47eec49c41efb8b 2x, https://si.imgix.net/aa61999d/uploads/origins/2bd806ed-4687-44c6-b65e-7fc3738d169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3530fe3126baf6f1be8e0bce35e76ae6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa61999d/uploads/origins/2bd806ed-4687-44c6-b65e-7fc3738d169f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bca87b61291456a76e92c503ee4aa5c", "srcset": "https://si.imgix.net/aa61999d/uploads/origins/2bd806ed-4687-44c6-b65e-7fc3738d169f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bca87b61291456a76e92c503ee4aa5c, https://si.imgix.net/aa61999d/uploads/origins/2bd806ed-4687-44c6-b65e-7fc3738d169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa45fdede1195cb284b26cdc25fe74aa 2x, https://si.imgix.net/aa61999d/uploads/origins/2bd806ed-4687-44c6-b65e-7fc3738d169f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8097383ec91b0bbeb92c921598a08ee9 3x"}, "body": "はじめまして。\n代理兼、いつもエイプリルフールにVtuberデビューする偽企画に使っているキャラ「百識あきら」のロゴを制作していただきたく思います。\nhttps://x.com/meltyhip/status/1865557034944594046?s=46&t=NAsNHl82PDYfMJ6XAKsZxA\n\nVtuberらしいポップでフラットな、ピンクと差し色の黄緑を基調にした丸っこい文字の横書きのロゴがいいなあと思います。\n\n右下の桃型のキャラ「桃尻」が元になったキャラクターです。\nVtuberのロゴというと周りに色々とモチーフを散りばめている方が多いかと思うのですが、本体が桃尻であるという以上の情報がないのでデフォルメした桃尻や桃のシルエットでなんとか作っていただけると幸いです（すみません）。\n\n百識あきら本人にはそのような属性はないのですが桃尻は表面がスライムのようにとろけています。\n数が増えたり減ったりするので複数体配置していただいても問題ないです（もちろん単体でも）。\nまた(●) ◒(●)顔が特徴的なのでこの顔つきもモチーフになりうるかもしれません。\n\n制作していただいたロゴは今後立ち絵資料に貼ったりエイプリルフール企画の時に使用したりする予定です。\n透過バージョンをいただけると嬉しいです。\n\n情報が少なくて申し訳ないですが、ご検討いただけると幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpg_shiroosan/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 966538, "client_id": 3324706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=468f836bf8e57e9c74c232760f0de20d", "srcset": "https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=468f836bf8e57e9c74c232760f0de20d, https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15ab195e49a8964c5c128edafddb2cba 2x, https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b04f8e61d2b5c6108d418a4a0a25fc93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2595b74dad052e87e077debfb543499e", "srcset": "https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2595b74dad052e87e077debfb543499e, https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=805d35f863c364d23c65a064cdddb661 2x, https://si.imgix.net/b5780447/uploads/origins/e5f115ac-9a3f-43a6-b2f8-5d308dfeb6cd?bg=%23fff&auto=format%2Ccom