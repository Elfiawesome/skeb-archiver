 please just be creative and have fun :)\n\nhttps://drive.google.com/drive/folders/1YdwP_GVTB0FjT26LujGESD7fa8RcvYb4?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@9zininero/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2704914, "client_id": 2392338, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa7-4989-8f9b-d96fb12e8888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e7705d06746c64edfd2932a2c980bb", "srcset": "https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa7-4989-8f9b-d96fb12e8888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e7705d06746c64edfd2932a2c980bb, https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa7-4989-8f9b-d96fb12e8888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49fde601385eeb66392e8ea8eec5594e 2x, https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa7-4989-8f9b-d96fb12e8888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfeba1d75ceab2f0860a2f9aa87520aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa7-4989-8f9b-d96fb12e8888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90e6ed743a7b4f5b812c1ddce15b4551", "srcset": "https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa7-4989-8f9b-d96fb12e8888?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90e6ed743a7b4f5b812c1ddce15b4551, https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa7-4989-8f9b-d96fb12e8888?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fbadbd650ccc6e87e72db328a3a38912 2x, https://si.imgix.net/4246fa4e/uploads/origins/bf2f558c-5fa