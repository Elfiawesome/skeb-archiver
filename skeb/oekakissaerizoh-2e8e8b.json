erest.\nReference: https://drive.google.com/drive/folders/1hFqfXjEST6Ztmoj7V5R6XsIacyRvXrCt?usp=sharing\n\nComposition: 16:9 ratio (9:16 ratio is also OK)\nPose and background can be done as you like.\nYou can use either of the 1.0 or 2.0 figures in the reference material.\nYou are also free to change the clothes (sexy-looking is also OK)\n\nWe will use them as thumbnails for youtube and twitch, or images for PC home\nThank you for your consideration.\nThank you very much", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oekakissaerizoh/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2498312, "client_id": 1493513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3f4bc83/uploads/origins/f85a04d0-fe2a-47a2-b443-24f1863ec04b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f773f200bfad0f2c4ca7b8334ced7297", "srcset": "https://si.imgix.net/e3f4bc83/uploads/origins/f85a04d0-fe2a-47a2-b443-24f1863ec04b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f773f200bfad0f2c4ca7b8334ced7297, https://si.imgix.net/e3f4bc83/uploads/origins/f85a04d0-fe2a-47a2-b443-24f1863ec04b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4b428f88c740a8b7246bea24b998ba2 2x, https://si.imgix.net/e3f4bc83/uploads/origins/f85a04d0-fe2a-47a2-b443-24f1863ec04b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acaad7b39a41ea1a88d287485442fe20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3f4bc83/uploads/origins/f85a04d0-fe2a-47a2-b443-24f1863ec04b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2675cb9f05b0117b2276b0502b3e8c1a", "srcset": "https://si.imgix.net/e3f4bc83/uploads/origins/f85a04d0-fe2a-47a2-b443-24f1863ec04b?bg=%23fff&auto=format%2Ccompre