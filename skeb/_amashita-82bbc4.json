gins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc7c27140eb32f98c7b8cac467b8d546", "srcset": "https://si.imgix.net/4e6ee3c5/uploads/origins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc7c27140eb32f98c7b8cac467b8d546, https://si.imgix.net/4e6ee3c5/uploads/origins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe54c1e0fd06ac0ccb3a8ada88863615 2x, https://si.imgix.net/4e6ee3c5/uploads/origins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=298519e0e2afddf26c912391420715cc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e6ee3c5/uploads/origins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b4c2c777c7054588ad3dde1e62a7bef", "srcset": "https://si.imgix.net/4e6ee3c5/uploads/origins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b4c2c777c7054588ad3dde1e62a7bef, https://si.imgix.net/4e6ee3c5/uploads/origins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7dbbd85cde384f883625adc1dbfc978f 2x, https://si.imgix.net/4e6ee3c5/uploads/origins/d585e1ff-73cf-47ab-a106-6a6d48f4ee24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a94710f23687ea2db7721227672d5f36 3x"}, "body": "・キャラクター\n\n桐間紗路（https://x.gd/gM0XB ）\n\n・衣装と髪型\n\nいつものフルールの衣装/髪型とほぼ同じ、ただし、ドロワーズは履かせないでください\nまた、ニーソックスは\n\n１．履いている\n２．履いていない\n\nの二種類を収録して下さい。靴はソックスの有無によらず、必ず履かせてください。\n\n・ポーズ、カメラ位置、角度\n\nhttps://x.gd/2ehsF の上から二番目と同じ、座りながら紙巻き煙草を吸っているポーズ。カメラの位置と角度もこれと同じ\n\n・着こなしと構図\n\n１．両脚の、靴の表、膝、膝小僧が見える\n２．スカートの前の方の裾は、両脚の膝小僧よりも手前にあるため、スカートの中の両脚の太腿や、太腿の付け根付近が見える。その一方、ぱんつは他に遮るものがないのに見えない、きらら作品によくある「はいてない（https://x.gd/UUGu1 ）」表現にする\n３．スカートの後ろの方は下に垂れ、その裏地が両脚の間などからが見える。裏地のデザインはお任せします\n４．煙草の先端から煙が上がっている\n５．衣装を含む全身が、キャンバスから見切れない\n\n・表情、顔向き、視線\n\nけだるそうに両目を開け、口は煙草を咥えるように閉じている。顔向きはhttps://x.gd/2ehsF の上から二番目と同じで、視線も顔向きと同じ方向を向いている（こちらに視線を向けてはいない）\n\n・背景\n\nフルールの店の裏口付近などの、普段は人がいなさそうな場所を希望しますが、金額や制作にかけられる時間的に難しければ、単色背景以外でお任せします\n\n・納品時のデータ形式\n\n四辺がキャラクターの全身を隙間なく覆う矩形が、短辺2160px以上、長辺3840px以上の、差分の切り替えや主要なコンポーネントの表示/非表示が切り替えられるPSDファイル。金額や制作にかけられる時間の範囲内で、解像度をなるべく高くしてください\n\n・その他\n\n- このような内容のリクエストで誠に恐縮ですが、以前雨下先生が描かれた、紙巻き煙草を吸ってるシャロちゃんのイラスト（https://x.gd/mLK9T ）がとても気に入っているため、本リクエストを出させて頂いております\n\n- 下半身に際どい表現があるため、念のためNSFWにしておりますが、R-18要素を含む必要は必ずしもありません\n\nご検討をお願いします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 337333, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "いきなりもじお", "screen_name": "yosyo_", "avatar_url": "https://pbs.twimg.com/profile_images/1985980432631136256/Q5JBAeTh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1055729439944785920/1760731261/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 32}, {"id": 1052497, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "すろ", "screen_name": "kawasiro17", "avatar_url": "https://pbs.twimg.com/profile_images/1814565134926553088/-fB2v9ky.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4811468982/1734789607/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills"