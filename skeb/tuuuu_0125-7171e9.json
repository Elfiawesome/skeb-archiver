スト失礼します！\n\nキャラクター\n星の翼のシャオリン\nhttps://x.com/6EyxFGJQn225465/status/1890802703866953744\n\nポーズや構図\n初音ミクの曲「好（ハオ）」のポーズ\nhttps://x.com/6EyxFGJQn225465/status/1890803624378269933\n\nこれをシャオリンに置き換えて描いてもらいたいです\n\nご検討の方よろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tuuuu_0125/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1262685, "client_id": 2262659, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de56210c/uploads/origins/1c63e21b-662c-4ee8-86ac-fd67bb79ad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ae92bc1f85a88f7461b76159c9452d2", "srcset": "https://si.imgix.net/de56210c/uploads/origins/1c63e21b-662c-4ee8-86ac-fd67bb79ad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ae92bc1f85a88f7461b76159c9452d2, https://si.imgix.net/de56210c/uploads/origins/1c63e21b-662c-4ee8-86ac-fd67bb79ad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d512703d0a22faf52b1dd4dcd9a26039 2x, https://si.imgix.net/de56210c/uploads/origins/1c63e21b-662c-4ee8-86ac-fd67bb79ad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87171cca2d8210f607f076a19bc4da4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de56210c/uploads/origins/1c63e21b-662c-4ee8-86ac-fd67bb79ad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfeac6316a1b24243004b4e21ed6c7bb", "srcset": "https://si.imgix.net/de56210c/uploads/origins/1c63e21b-662c-4ee8-86ac-fd67bb79ad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfeac6316a1b24243004b4e21ed6c7bb, https://si.imgix.net/de56210c/uploads/origins/1c63e21b-662c-4ee8-86ac-fd67bb79ad5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s