-b0eb-893e33e5af66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e10acfffaa83acdf48656b5f75022e14, https://si.imgix.net/37bbea87/uploads/origins/2badb47a-e8a0-47e3-b0eb-893e33e5af66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42ce724540a8a39fc1a32a9c8dab5385 2x, https://si.imgix.net/37bbea87/uploads/origins/2badb47a-e8a0-47e3-b0eb-893e33e5af66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0aec8b4bf5d749d6dca39100e32876d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37bbea87/uploads/origins/2badb47a-e8a0-47e3-b0eb-893e33e5af66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f047ff9b702c590aafa1110ed8a14eaa", "srcset": "https://si.imgix.net/37bbea87/uploads/origins/2badb47a-e8a0-47e3-b0eb-893e33e5af66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f047ff9b702c590aafa1110ed8a14eaa, https://si.imgix.net/37bbea87/uploads/origins/2badb47a-e8a0-47e3-b0eb-893e33e5af66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=66882caf263574bce21d82329bea8d99 2x, https://si.imgix.net/37bbea87/uploads/origins/2badb47a-e8a0-47e3-b0eb-893e33e5af66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=900bce4e1a90dc7e32b2c2b718987334 3x"}, "body": "はじめまして！\nユキちゃんさん先生の作風で是非描いてほしいキャラがいるので\nご依頼をさせていただけると嬉しいです\n\n依頼はメギド72のアスモデウス(資料url参照)の台詞と差分ありR18イラストになります\n(キャラ設定としては自分が絶対的な存在であると強く認識しており、\n実際それに見合った実力の持ち主で、強大な力と尊大な態度\n美しく強靭な肉体を持ち合わせる、誇り高き性格の持ち主となります）\n体型は盛りに盛って、乳輪や陰毛は濃いめで下品な感じで描いてほしいです\nまた納品形式はPSDでお願いしたいです\n\nシチュは先生が以前描かれた下記のフルルドリスさんのような感じで\nhttps://www.pixiv.net/artworks/114182862\nアスモデウスが下衆なおっさんにニプルファックや乳首をいじられ\n乱交している姿をお願いしたいです\nツンツンしながらもちんぽに虜の雌豚になっていて\n汗だくムレムレの発情状態で犯されるのを心待ちにしているイメージです\n衣装に関しては原作衣装ではなく胸や腋、局部が見えるような\n下品なドスケベ衣装でお願いしたいです(詳細はお願いしたいです)\nまた差分として母乳を吹いての絶頂描写や事後描写をお願いしたいです\n\n台詞イメージとしては\n「ふん…発情豚が…っこんな服を着させて…❤繁殖のことしか頭にないのか❤」\n「望み通り雌豚娼婦になってやったぞ❤今日は特別なんだからな❤」\n口では嫌がりながらも発情している様子\n↓\n「くっ…❤すごい臭い…っ❤すんっすんっ❤水浴びくらいしてきたらどうだ❤先から垂れているぞ❤」\n臭い先走りちんぽを前に一気に雌豚スイッチON\n↓\n「お゛っ❤そうだ…❤いいっ❤ご主人さまのでなければ奥まで届かんのだっ❤️\n早くカリ高のデカマラでおっぱいオナホと子宮ボコボコにして❤️蹂躙してくれっ❤️」\n挿入されて興奮\n↓\n「ん゛おっ❤️これを待っていた❤❤ご主人さまのちんぽえっぐぅ……❤️」\n「お゛っ❤️また、イく❤️そこっ、気持ち❤️あ゛っ、イくイくイく❤️」\n「お゛んお゛ぉぉぉ❤️メス穴に濃厚精子きたあああ❤❤」\n射精されて無様なアヘ顔\n↓\n「次はどこを使う❤ケツ穴？❤腋まんこ？❤焦らさないでぇ❤早くぅ❤」\n汁まみれで完全に堕ちきった事後描写\nイメージなので改変加筆OKです\nその他記載のない要素はおまかせします\n\nよろしくお願いします\n\nhttps://drive.google.com/drive/folders/1ilC97vq9s5v4zgq15MmU5muX8DcmWyyX?usp=sharing", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 3140, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "DOLL🌠", "screen_name": "aqua_dollccc", "avatar_url": "https://pbs.twimg.com/profile_images/1630939562250993666/BQ5CjI4H.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2538986749/1636471402/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 112690, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "赤井", "screen_name": "_akaimono", "avatar_url": "https://pbs.twimg.com/profile_images/1742095151751913472/ujkBTUl6.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 412150, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クツジロー", "screen_name": "kutuziro", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?ur