ds/origins/8502b16e-00d9-4beb-8c5d-f46a84e0e2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f053d56ebb3981fa337005cbda965def 2x, https://si.imgix.net/b75b5fba/uploads/origins/8502b16e-00d9-4beb-8c5d-f46a84e0e2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2022584f6bad92f6917de391198f55a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b75b5fba/uploads/origins/8502b16e-00d9-4beb-8c5d-f46a84e0e2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f9c28d1f340c83587168c507055207a", "srcset": "https://si.imgix.net/b75b5fba/uploads/origins/8502b16e-00d9-4beb-8c5d-f46a84e0e2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f9c28d1f340c83587168c507055207a, https://si.imgix.net/b75b5fba/uploads/origins/8502b16e-00d9-4beb-8c5d-f46a84e0e2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e634b5c67e27fb9e67c9787874614662 2x, https://si.imgix.net/b75b5fba/uploads/origins/8502b16e-00d9-4beb-8c5d-f46a84e0e2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2de7307c69dabb38a7fab6a91856fd1b 3x"}, "body": "はじめまして。\nアピールありがとうございます。\n支援サイトの「天狗のお姉ちゃん」シリーズでも最近描かれている\n東方Projectの犬走椛でいちゃらぶエッチ絵を依頼します。\n\nシチュエーションとしては\n発情期を迎えた椛がお仕事(哨戒任務)終わりに\n恋人の家にお泊りして寝室の布団の上でイチャラブエッチをします。\n恋人は成人男性でショタ要素は一切なしでお願いします。\n\nエッチ時の体位は正常位や騎乗位などの\nお互いが見つめ合えるものでお願いします。\n\n発情期＆お仕事終わりのため全身から汗の匂いと\nフェロモンを漂わせる椛に恋人はとても興奮しており\n恋人の射精が近いことを察した椛は今日は危険日と伝えますが\n興奮した恋人はこのまま中に出したいようです。\n妊娠したらお仕事ができなくなるからダメですと言いますが\n既成事実が欲しい椛はドキドキしながら迫る中出しに期待しています。\nそして中出し絶頂後、責任取ってくださいねと嬉しそうです。\n\nといった内容を、擬音や喘ぎ声ありで以下のような差分をお願いします。\n\n①挿入前\n②挿入中\n③挿入中(射精直前)\n④中出し絶頂\n⑤中出し後の余韻中\n\n入れられるなら孕ませを意識した台詞もお願いします。\n\n衣装は胸と結合部が見えていれば全裸でも半脱ぎでもＯＫで\n頭の赤い頭巾も省略可です。\n\n以上、ご検討ください。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path