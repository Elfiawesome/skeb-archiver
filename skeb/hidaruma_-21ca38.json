rmat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0045715c46639b91d94c003dfe5a075, https://si.imgix.net/e115bf51/uploads/origins/4b23478e-c162-4508-8d96-2a51146bf2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96fa8f0843eff4bc82cafb8d07bb9a80 2x, https://si.imgix.net/e115bf51/uploads/origins/4b23478e-c162-4508-8d96-2a51146bf2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea028f5e4a8430cb97abaf077bfd09cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e115bf51/uploads/origins/4b23478e-c162-4508-8d96-2a51146bf2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54da90f005752b8c459aa749556cbbcb", "srcset": "https://si.imgix.net/e115bf51/uploads/origins/4b23478e-c162-4508-8d96-2a51146bf2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54da90f005752b8c459aa749556cbbcb, https://si.imgix.net/e115bf51/uploads/origins/4b23478e-c162-4508-8d96-2a51146bf2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cd29a2398a24ae246164288fa9748d7 2x, https://si.imgix.net/e115bf51/uploads/origins/4b23478e-c162-4508-8d96-2a51146bf2b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3147665683d09140922e17dc21ebc1b3 3x"}, "body": "ヒダルマさんはじめまして！\nいつも面白い4コマやイラストを楽しませて頂いてます。\n今回描いて頂きたいのは東方の「レミリア・スカーレット」と「宮出口瑞霊」です\n・シチュエーションは「黒柳レミリアの部屋という番組に招待された瑞霊がレミリアにいじられる」というシチュエーションでお願いします。\n・2人の服装は原作と同じで構いません。瑞霊に関しては書籍の白黒でしか登場してないので、ヒダルマさんの裁量で色をつけて頂ければ幸いです。構図は他の方の作品で恐縮ですが、添付した作品のような部屋で、黒柳徹子側に座った笑顔のレミリアが瑞霊に話しかけて、瑞霊はゲスト側の席で冷や汗を浮かべて苦笑いしているという図でお願いたします。\nセリフとして、レミリア「本日は反獄王こと宮出口瑞霊さんをお招きしております。あーた、幻想郷に混沌を取り戻したいそうですけど。あたくし勉強不足でして。混沌って具体的にどんなことを望んでるんですか？」瑞霊「あ、いや今の生ぬるい幻想郷をぶち壊して、昔のように妖怪や神々による混沌をー」レミリア「それ何が楽しいんですか？(瑞霊のセリフを少し遮る)」という内容でお願いします。セリフはあくまで例なので、ヒダルマさんの判断で多少修正して頂いて構いません。\n・画面右下には「本日のお客様は反獄王瑞霊さん」というテロップを、右上には原作ゲームのスペルカード名のようなフォントで「対談『黒柳レミリアの部屋』という文字を載せてください。\n\n一枚絵を想定してリクエストしていますが、描きやすいようでしたら、2コマ等にして頂いても構いません。\n細かい構図やアングル等はヒダルマさんにお任せいたします。\n\n以上がリクエスト内容です。\nご検討何卒よろしくお願いいたします。\n\nhttps://seiga.nicovideo.jp/seiga/im10241959", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hidaruma_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 700631, "client_id": 168315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58f52eb68e54647452ad262ab64c2dc", "srcset": "https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58f52eb68e54647452ad262ab64c2dc, https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67407913e66327c4651c556e8a4cc158 2x, https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bae94c98319f48a441392075254183dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74788a45856283e823618f502e161628", "srcset": "https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74788a45856283e823618f502e161628, https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82cb8340bd62428c61d5d64de1eeaf2d 2x, https://si.imgix.net/22c89526/uploads/origins/57144385-0c03-449d-ae1d-078eba8fb542?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c43585ae25d660b7e2c2e950de8a8787 3x"}, "body": "今回もリクエスト失礼します！\n\n描いていただきたいのは東方の「八雲藍」になります\n「藍様が朝寝起きに洗面台の前で歯磨きしている」というシチュエーションをお願いいたします\n\n・藍様の格好は上はキャミソール、下は下着とサイハイソックス着用のお姿でお願いします。それぞれのでデザインや色はヒダルマさんにお任せいたします。ヒダルマさんが思うプライベートな藍様衣装で描いていただければと思います。かわいらしい雰囲気にしていｔだけると幸いです\n・帽子はかぶった状態で片方の手は歯磨きを、もう片方の手はコップを持った状態で\n・顔はめちゃくちゃ眠そうな感じでかろうじて歯磨きができてるような状態で、しっぽも寝起きで寝ぐせのようにもわもわして四方に散っているような感じで\n・全体の雰囲気や構図などは参考となる作品を添付しましたのでそちらを参照していただけると幸いです\n・その他背景等の細かい点などは全てヒダルマさんにお任せいたします\n\n以上がリクエスト内容になります\nご検討何卒よろしくお願いいたします\n\nhttps://skeb.jp/@syope/works/9", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hidaruma_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 700631, "client_id": 102589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c9f1efd/uploads/origins/83868205-660e-43eb-8795-e8156667256f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8626ea4a177df12d940e8f95bb233bf", "srcset": "https://si.imgix.net/1c9f1efd/uploads/origins/83868205-660e-43eb-8795-e8156667256f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8626ea4a177df12d940e8f95bb233bf, https://si.imgix.net/1c9f1efd/uploads/origins/83868205-660e-43eb-8795-e8156667256f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d840df29f14d45bd4b16005f8949a038 2x, https://si.imgix.net/1c9f1efd/uploads/origins/83868205-660e-43eb-8795-e8156667256f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc168ab753686c92bedbe1474de2053e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c9f1efd/uploads/origins/83868205-660e-43eb-8795-e81566672