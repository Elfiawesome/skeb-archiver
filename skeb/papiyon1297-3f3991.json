4128f8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3f256b226024adc6ba3a5352b365c2d, https://si.imgix.net/a1e64c67/uploads/origins/fb32dbd7-3ff3-45fd-82c7-710d4128f8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af3386b12fa9ebbe0dddda8498fb8666 2x, https://si.imgix.net/a1e64c67/uploads/origins/fb32dbd7-3ff3-45fd-82c7-710d4128f8b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63fda660ca8f969a96dfb377e25d2724 3x"}, "body": "こんにちはパピヨン先生、\n\nブルーアーカイブの三善タカネを、このフィギュアに似たデザインのハイカットバニースーツを着ているイラストをお願いしたいです：https://www.amiami.jp/top/detail/detail?gcode=FIGURE-167719&page=top\n\nバニースーツには以下の特徴を希望します：\n- 赤色\n- 魚網ではなく、ダークグレーのレーストリムが施された太ももまでのストッキング\n- 赤色のスティレットハイヒール\n\nイラストについては、二部構成でお願いします。左側では三善が全身で立っており、少し恥ずかしそうな表情をしています。右側は彼女の衣装の後ろ側のクローズアップで、彼女のヒップとお尻を強調しています。", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@papiyon1297/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3077116, "client_id": 455504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff6cf238/uploads/origins/43257356-ea9e-41c7-829b-a690947e5b76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9fc751d9808df966270499ef6a85647", "srcset": "https://si.imgix.net/ff6cf238/uploads/origins/43257356-ea9e-41c7-829b-a690947e5b76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9fc751d9808df966270499ef6a85647, https://si.imgix.net/ff6cf238/uploads/origins/43257356-ea9e-41c7-829b-a690947e5b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7c7ee2c52850664d12abb2f31b134ac 2x, https://si.imgix.net/ff6cf238/uploads/origins/43257356-ea9e-41c7-829b-a690947e5b76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9fd25f8cc2893582b3d4ff270a28133 3x"}, "duration":