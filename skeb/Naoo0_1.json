広告活動、サムネイルへの使用\n\n希望すること\n顔や髪が端で切れないようにしていただけると幸いです。\nサムネイルに使用するためキャラのみの透過のPNGでデータをいただけると嬉しいです。\n\nお時間合いましたらぜひよろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Naoo0_1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3772671, "client_id": 1810445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8160-0d415b2c737a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba8565afef1a6f5a83f57cd2703a68bd", "srcset": "https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8160-0d415b2c737a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba8565afef1a6f5a83f57cd2703a68bd, https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8160-0d415b2c737a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=297bf35236841f69f8b8135eb399743c 2x, https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8160-0d415b2c737a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4902caeeaac4d90cd1b5c66edda2aff3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8160-0d415b2c737a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe681fe00adc43bbe0fd21816d22f675", "srcset": "https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8160-0d415b2c737a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe681fe00adc43bbe0fd21816d22f675, https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8160-0d415b2c737a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e4a3106b79b08950ca35e9107fc98fb 2x, https://si.imgix.net/26cd2ba6/uploads/origins/83fc27a0-e07f-4052-8