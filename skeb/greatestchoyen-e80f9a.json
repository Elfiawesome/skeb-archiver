ます\n虎柄のフーディーを着崩しています\n中に着ているノースリーブシャツのピンク色の部分の柄は自由です\n白虎モチーフの白黒ネイルをしています\n桃のヘアピンと、金色のピアスリングをつけています", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoshishi_ff/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2014167, "client_id": 2076401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aeaf454e73d75e72fe04472ead68286", "srcset": "https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9aeaf454e73d75e72fe04472ead68286, https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d4dede1a4a6534ffe068453db944b1c 2x, https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee7cee2d6097152461e5dcf9064b9e07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5fa3eea18738a343f351a347acc806e", "srcset": "https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5fa3eea18738a343f351a347acc806e, https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b36c1f100808b7d46db2bd7a32c0527c 2x, https://si.imgix.net/ee157e9e/uploads/origins/0b7fd0cc-8e94-41d4-907b-e776bfe8fe79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3ee5a0a65013b2d9ea7dd39cc8beb64 3x"}, "body": "初めまして！偶然muraさんのイラストを見かけまして、むにっとしたキャラと水彩表現が素晴らしく、また優しい色使いが素敵でしたので、リクエストしたいと思いました\n三国志演義を元ネタにした自創作のオリジナルキャラである劉備をリクエストします\n\n・見た目参考資料\n全身:　https://twitter.com/9999trillionyen/status/1544635805649362944\n\nデフォルメ:　https://twitter.com/9999trillionyen/status/1539595133708304386\nhttps://twitter.com/9999trillionyen/status/1406977557287686149\n\n全身資料の②、または③の段階で描いてほしいです(全身を描く必要はありません)\nですが、衣装は描きやすいように多少アレンジしてくださっても大丈夫です\n\n張飛、関羽と一緒に三人でいつも騒がしく過ごしています\n明るい性格で親しみやすく、どちらかといえばチャラ男な感じです\nそんな劉備が幸せそうにはにかんでいる夏っぽいイラストをお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kaseiyukimitsu/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 53642, "client_id": 2076401, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/410e4b5d/uploads/origins/7aceed8d-a42d-4687-9da4-505a56b80e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f556b1b3a094a3e1057cf94ea101da", "srcset": "https://si.imgix.net/410e4b5d/uploads/origins/7aceed8d-a42d-4687-9da4-505a56b80e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4f556b1b3a094a3e1057cf94ea101da, https://si.imgix.net/410e4b5d/uploads/origins/7aceed8d-a42d-4687-9da4-505a56b80e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b1d3efc59472c70bc5687108daab8a2 2x, https://si.imgix.net/410e4b5d/uploads/origins/7aceed8d-a42d-4687-9da4-505a56b80e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b393bd71e6885dd4cbebedeada7687f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/410e4b5d/uploads/origins/7aceed8d-a42d-4687-9da4-505a56b80e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur