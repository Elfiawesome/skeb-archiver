ーローアカデミアシリーズの筋肉質なミルコをあなたの絵で表現してほしいです。\n1995年の攻殻機動隊で草薙素子少佐が使っていたサーモオプティックカモを全身にまとい、タンクハッチを開けたポーズをしています。正面から見たところ。横顔と筋肉質な背中。彼女の表情は、目を見開き、少し苦しそうな表情をしている。\n\nまた、ヌードバージョンもお願いします。\n\nありがとうございました！\n\n参考資料\nhttps://imgur.com/h9yRx9T\nhttps://imgur.com/rqczRQZ\nhttps://imgur.com/V3JnyRC\nhttps://imgur.com/E0tAb26\nhttps://imgur.com/w6FDd5F\nhttps://imgur.com/p4gJ8Th", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shosho_oekaki/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/659b3526/uploads/origins/71ebd39a-897e-4a1c-ba52-fd843cb0136d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f65407bc5f458bf41853f80a78424025", "srcset": "https://si.imgix.net/659b3526/uploads/origins/71ebd39a-897e-4a1c-ba52-fd843cb0136d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f65407bc5f458bf41853f80a78424025, https://si.imgix.net/659b3526/uploads/origins/71ebd39a-897e-4a1c-ba52-fd843cb0136d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=830e492229707e9700094ec64104365c 2x, https://si.imgix.net/659b3526/uploads/origins/71ebd39a-897e-4a1c-ba52-fd843cb0136d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48ccb39c1d56f93d83c8e796f1884a85 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2708750, "nc": 160}, {"path": "/@shosho_oekaki/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2708750, "client_id": 953222, "vtt_url": null, "thumbnail_image_urls": {"src": "