8-4bcc-81fb-d1d634b18bf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1015a22ffcb10bdd669bcd9fe56aadbe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba7bef23/uploads/origins/a12a706b-7218-4bcc-81fb-d1d634b18bf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff069925c25f872e872434c4aff1743", "srcset": "https://si.imgix.net/ba7bef23/uploads/origins/a12a706b-7218-4bcc-81fb-d1d634b18bf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff069925c25f872e872434c4aff1743, https://si.imgix.net/ba7bef23/uploads/origins/a12a706b-7218-4bcc-81fb-d1d634b18bf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=075f206030f56737b2cbda2dc3fc4a09 2x, https://si.imgix.net/ba7bef23/uploads/origins/a12a706b-7218-4bcc-81fb-d1d634b18bf0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=431646429105f4d3ab9f494b9a35a605 3x"}, "body": "先生、募集再開を首を長くして待っておりました！！先生の素晴らしい作品をいつも楽しみにしております。先生は天才です！！！！！\n\n以前の作品のあまみゃさんが手錠に正常位で中出しされている図は最高でした。ぜひわたしの推しの鷹宮リオンをお願いいたします！\n\nにじさんじの鷹宮リオン嬢が、①パパ活でホテルでおっさんにまんぐり返しで超余裕なフリでぱんつを見せている（膝裏の少し下あたりに手を添えて、脚を外側にぐっと開いている）→②挿入されるやいなや「お前のさあ、そんな粗チンでさあ、このあたしが、気持ちよくなると、思ってるわけ…？」とクッソ感じてしまう→③中出しと同時に超気持ちよく昇天してしまう、という流れでお願いしたいです。\n\n衣装はこちらの\nhttps://x.com/TakamiyaRion/status/1398980300605071363?t=fxTYaTEqLhF5SepdSP82kg&s=19\nギャルみのある制服を希望いたします。\n\nちょっと日焼けさせてくださると大変嬉しいです！！なにとぞよろしくお願いいたします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naga4mangan/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2531012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0db3ff59/uploads/origins/b030d986-99cd-4f8b-a281-8a5daa146e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efc7161