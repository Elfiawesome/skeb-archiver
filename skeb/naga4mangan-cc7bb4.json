てしまう\n\n服装はデフォルトの衣装（へそ出しルック）でお願いします。\nただ、短パンは脱がすか足に引っかけて、胸は捲って露出、黒い紐はズラして挿入されているような形でお願いします。\n\nもし描くのに難しい部分がありましたら、サラさんのえっちなイラストが見られれば満足ですので、\nシチュや構造など変えてくださって構いません！\n\nご検討のほどよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@naga4mangan/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2531012, "client_id": 1834631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/436b4ca7/uploads/origins/ccd59464-91c1-4e22-8fd1-3dc75c6d1619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f58d6669542c1f35720e24f285266d74", "srcset": "https://si.imgix.net/436b4ca7/uploads/origins/ccd59464-91c1-4e22-8fd1-3dc75c6d1619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f58d6669542c1f35720e24f285266d74, https://si.imgix.net/436b4ca7/uploads/origins/ccd59464-91c1-4e22-8fd1-3dc75c6d1619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9674ec118e22858970b548b13e46c69 2x, https://si.imgix.net/436b4ca7/uploads/origins/ccd59464-91c1-4e22-8fd1-3dc75c6d1619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b5a8ef588543f92d5f5f4361e2cb27a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/436b4ca7/uploads/origins/ccd59464-91c1-4e22-8fd1-3dc75c6d1619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ead2851ce513627a46ad2b0cd9dbd25", "srcset": "https://si.imgix.net/436b4ca7/uploads/origins/ccd59464-91c1-4e22-8fd1-3dc75c6d1619?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ead2851ce513627a46ad2b0cd9dbd25, https://si.imgix.net/436b4ca7/uploads/origins/ccd59464-91c1-4e22-8fd1-3dc75c6d1619?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e6945418da02dee9048a66891c6bdd5 2