て歯をがちがち言わせて本気怯えで声量が落ちている若狭良馬。\n\n二人の設定等既にご存知とは思いますが、リンク貼らせていただきます。\n\nskebにいの一番で伺うと言ったというのに見逃していたのが非常に口惜しいです。\n遅くなってしまいましたがご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1-Dy8HDP1u6LkySasHMeFKaNYvF5Hxrsg", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@ragikirin/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1110971, "client_id": 1288794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6609e589/uploads/origins/56c38eb7-b650-4e93-a3bb-b6b314943a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba68af400077bdc424efcb8a8df441a7", "srcset": "https://si.imgix.net/6609e589/uploads/origins/56c38eb7-b650-4e93-a3bb-b6b314943a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba68af400077bdc424efcb8a8df441a7, https://si.imgix.net/6609e589/uploads/origins/56c38eb7-b650-4e93-a3bb-b6b314943a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1160215515fd92916e809d217977d170 2x, https://si.imgix.net/6609e589/uploads/origins/56c38eb7-b650-4e93-a3bb-b6b314943a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48f50fe7eacdac38dce9ea652543a093 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6609e589/uploads/origins/56c38eb7-b650-4e93-a3bb-b6b314943a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3cc8a9099a9268189163463e7c0eac3", "srcset": "https://si.imgix.net/6609e589/uploads/origins/56c38eb7-b650-4e93-a3bb-b6b314943a35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3cc8a9099a9268189163463e7c0eac3, https://si.imgix.net/6609e589/uploads/origins/56c38eb7-b650-4e93-a3bb-b6b314943a35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=