丈夫です\nキャラクター：男の子（中性的な雰囲気）\n資料：キャラクターの資料はURLに掲載しています\n背景：ありでお願いしたいです\n納品形式：背景ありverと透過verの両方をご用意いただけると嬉しいです\n使用目的：X（旧Twitter）やYouTubeのサムネイルなどSNSでの使用予定です\n※SNSは将来的に収益化する可能性があります\n\nざっくりとした内容になってしまい恐縮ですが、クリエイター様のセンスにおまかせできればと思っております。\n可能であればどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1VA7r4T8WnfzYbG-kFIJzqZvlYZZlZfdD?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Fta53dayo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3342017, "client_id": 3403686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bbe40a9/uploads/origins/2b57c452-7117-491d-b551-94dc22e16246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97b503a6ca3d7d068891fd18d51c919", "srcset": "https://si.imgix.net/2bbe40a9/uploads/origins/2b57c452-7117-491d-b551-94dc22e16246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97b503a6ca3d7d068891fd18d51c919, https://si.imgix.net/2bbe40a9/uploads/origins/2b57c452-7117-491d-b551-94dc22e16246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d426eef7dfd8f75a48f251e57f520fc4 2x, https://si.imgix.net/2bbe40a9/uploads/origins/2b57c452-7117-491d-b551-94dc22e16246?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e538d3dcf950d14477862680c0e259e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bbe40a9/uploads/origins/2b57c452-7117-491d-b551-94dc22e16246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3915567a4edc031b6f775858802587e", "srcset": "https://si.imgix.net/2bbe40a9/uploads/origins/2b57c452-7117-491d-b551-94dc22e16246?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3915567a4edc031b6f775858802587e, https://si.imgix.net/2bbe40a9/uploads/origins/2b57