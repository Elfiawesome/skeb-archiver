途の関係上、人物の上・左右（もし可能であれば全身）がキャンバス内に収まっているととても嬉しいです！\n\n〇使用用途\n・Youtube配信（収益化済）サムネイル\n・配信画面内での使用\n・SNSでの画像投稿\n・TwitterでのFAタグでの投稿\n\n〇ファイル形式\npsd or png\n人物のみの透過データも頂けますと幸いです！\n\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/0/folders/1BfVklxSOzCK98uXDgtWJDUAOEune6_qr", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Fta53dayo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3342017, "client_id": 3142675, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86fce245/uploads/origins/0bd7ec64-15f4-47b5-ae69-0ea4238dfade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193e5d2743e8a15c77e5d27bbb3245a2", "srcset": "https://si.imgix.net/86fce245/uploads/origins/0bd7ec64-15f4-47b5-ae69-0ea4238dfade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193e5d2743e8a15c77e5d27bbb3245a2, https://si.imgix.net/86fce245/uploads/origins/0bd7ec64-15f4-47b5-ae69-0ea4238dfade?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88b152f92ee3f478b139e61377e85d83 2x, https://si.imgix.net/86fce245/uploads/origins/0bd7ec64-15f4-47b5-ae69-0ea4238dfade?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=51d01df28bbb6400b130edf6a56d294b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86fce245/uploads/origins/0bd7ec64-15f4-47b5-ae69-0ea4238dfade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdf2179729fda73b9ae283e36d7f46c", "srcset": "https://si.imgix.net/86fce245/uploads/origins/0bd7ec64-15f4-47b5-ae69-0ea4238dfade?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fdf2179729fda73b9ae283e36d7f46c, https://si.imgix.net/86fce245/uploads/origins/0bd7ec64-15f4-47b5-ae69-0ea4238dfade?bg=%23fff&auto=format%2Ccompress&fm=webp&d