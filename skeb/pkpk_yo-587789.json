=200&h=200&s=6ba606efc375f443cbe8be9c6a1d62db, https://si.imgix.net/361f1788/uploads/origins/bdd909a5-b245-4374-82ba-7e53fd843350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3ececc90a99ccbd6719a443ab360d6b 2x, https://si.imgix.net/361f1788/uploads/origins/bdd909a5-b245-4374-82ba-7e53fd843350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19f9a4632dd5ae9f729ff5f15c280f8f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/361f1788/uploads/origins/bdd909a5-b245-4374-82ba-7e53fd843350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=715ed9b9d90883f93b48419d46806db2", "srcset": "https://si.imgix.net/361f1788/uploads/origins/bdd909a5-b245-4374-82ba-7e53fd843350?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=715ed9b9d90883f93b48419d46806db2, https://si.imgix.net/361f1788/uploads/origins/bdd909a5-b245-4374-82ba-7e53fd843350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87c49a6920fc55e3b5a558af6550151a 2x, https://si.imgix.net/361f1788/uploads/origins/bdd909a5-b245-4374-82ba-7e53fd843350?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d00cfcb288adc75490f7d50b3fe250de 3x"}, "body": "ぷかぷか先生様\n\n突然のメッセージに驚かせてしまい申し訳ありません！\nskeb新着クリエイター欄を眺めている際ぷかぷか先生様をお見掛けし、X（旧Twitter）を拝見させていただいたところ、とても素敵な作品の数々に心惹かれました！\n是非ともイラストのリクエストをさせていただきたいなと思い、メッセージをお送りさせていただいた次第です！\nお時間あります時に下記をご拝読いただけますと幸いです！\n\n今回ぷかぷか先生様にお願いしたいのは”私の好みを詰め込んだキャラクター2人が穏やかな日常を過ごしている（お茶をしている）風景”です！\n以下にキャラ詳細や構図イメージ等を記載させていただきます！\n\n▼1人目のイメージ（以下、主さん）\nパッと見ると男なのか女なのか分からない中性的な容姿で、細身のキャラ（10代後半～20歳頃）です！\n髪形は、ぷかぷか先生様が描かれていましたイラストのように”後れ毛が長い（胸より下）”で、後ろ髪は1つ結び（低い位置でのお団子結び）をイメージしています！\n服装はどちらかと言うと男性寄り（パンツスタイル）のもので、ファンタジーっぽいものだと嬉しいです！\n髪の色は赤、目の色は緑色をイメージしているのですが（後述しますが）モノクロでの作画をお願いしたいので参考程度に捉えてください！\n瞳はツリ目気味なのですが（どちらの瞳でもいいのですが）眼帯をさせてほしいです！眼帯の色は黒で、BLEACHという作品のノイトラ・ジルガ様というキャラが付けているような眼帯をイメージしています！\n性格は穏やかだけれど感情の起伏があまりないクールなイメージです！\n\n▼2人目のイメージ（以下、ショタ君）\n10歳頃の可愛らしい少年をイメージしています！\n完全に私の好みで申し訳ないのですが、可愛いフリフリの衣装（例：メイド服）を着せてほしいです！\n髪型はショートボブをイメージしているのですが、髪の色は”グレーだけれど、毛先に向かうにつれて黒く”させてほしいです！\n瞳の色は金色をイメージしています！\n性格は天真爛漫で無邪気な少年をイメージしています！\n\n▼描写イメージ\nショタ君が主さんにティーセットを用意し、主さんがティーカップに口を付けているorティーセットを用意しているショタ君を眺めているイメージです！\nショタ君はニコニコスマイル、主さんはクールながらも口角を少し上げた微笑みを浮かべてほしいです！\nぷかぷか先生様のプロフィールに『モノクロ絵と漫画を描いてます。』と記載されていますので、納品形式は1枚絵でも漫画でも、ぷかぷか先生様の描き易いものをお願いしたいです！\nそして、私はぷかぷか先生様のモノクロイラストが大好きなので、今回はカラーではなくモノクロイラストをお願いします！（Xに1枚だけ投稿されていましたカラーイラストも勿論大好きです！いつか機会がありましたらカラーもお願いしたいなと思っています！///）\n\n※描いていただいたイラストのキャラクターや世界観をイメージして短編小説など（非商用利用）を書くかもしれません！もしも「それはちょっと……」と思われましたら、今回のリクエストは遠慮なくキャンセルしてください！\n\nとっても長文になってしまい申し訳ございませんでした！！\nこの度、こうしてぷかぷか先生様にリクエストメッセージを送ることができて本当に光栄です！\nここまでお読みくださり、ありがとうございました！", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1055466, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "久世", "screen_name": "hk45_x", "avatar_url": "https://pbs.twimg.com/profile_images/1756544667762704384/uK7PnmEO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1317372343195299840/1679572483/1500x500", "appeal_receivable": false, "popular_creator_rank": 66, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2065953, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "WagNeru🎨Skeb/VGen🆗", "screen_name": "Wagu_Neru", "avatar_url": "https://pbs.twimg.com/profile_images/2068286672182378496/A9Za0FEN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1404633496232988673/1770719671/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": nu