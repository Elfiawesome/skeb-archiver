彼らはやはり相手の親友になりたい！\n﻿\n﻿\n描きたいイメージを自由に選ぶことができますが!\n﻿\nもし興味がなければ、キャンセルしてください！価格が不適切な場合は、リクエストを再送信すること自由に尋ねる。ありがとうございました！\n下のリンクは私のキャラクター設定です!お願いします 。\n﻿https://drive.google.com/drive/folders/1-2UimkjLCEhiuzZpWAxpT9GMwfzfwcVQ\n\nhttps://drive.google.com/drive/folders/1-2UimkjLCEhiuzZpWAxpT9GMwfzfwcVQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mituki_paburo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2980344, "client_id": 3198945, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e0e4ec7/uploads/origins/61903108-c166-4727-b8b3-922ffb25354b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50c6f452efb1126f88b2db376dbdea10", "srcset": "https://si.imgix.net/0e0e4ec7/uploads/origins/61903108-c166-4727-b8b3-922ffb25354b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50c6f452efb1126f88b2db376dbdea10, https://si.imgix.net/0e0e4ec7/uploads/origins/61903108-c166-4727-b8b3-922ffb25354b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bff41448a1198c466844208eea9e8486 2x, https://si.imgix.net/0e0e4ec7/uploads/origins/61903108-c166-4727-b8b3-922ffb25354b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3130189231d68f2aef806dfc0b2633de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e0e4ec7/uploads/origins/61903108-c166-4727-b8b3-922ffb25354b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb82eed13dff20303f676715405c8b02", "srcset": "https://si.imgix.net/0e0e4ec7/uploads/origins/61903108-c166-4727-b8b3-922ffb25354b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb82eed13dff20303f676715405c8b02, https://si.imgix.net/0e0e4ec7/uploads/origins/61903108-c166-4727-b8b3-922ffb25354b?bg=%23ff