バーシップでの配布\n\n【他】\n・差分や背景ありのデータを作成いただけるようであれば、背景と人物を分けたpsｄデータも頂けると嬉しいです。\n・使用する場合に、イラストの一部をトリミング、また文字がイラストの上に載る可能性があります。\n\n\nお忙しいとは思いますが、何卒ご検討のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mituki_paburo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2980344, "client_id": 511074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba41b6ec/uploads/origins/84d34288-e29e-45ac-a55e-48723914a839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7dff5eebbd48a4b651d4a6cfb351e6", "srcset": "https://si.imgix.net/ba41b6ec/uploads/origins/84d34288-e29e-45ac-a55e-48723914a839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7dff5eebbd48a4b651d4a6cfb351e6, https://si.imgix.net/ba41b6ec/uploads/origins/84d34288-e29e-45ac-a55e-48723914a839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0281d53a72a35ab2d026319660ecb7b 2x, https://si.imgix.net/ba41b6ec/uploads/origins/84d34288-e29e-45ac-a55e-48723914a839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16c8a0ba9ce9419097c7024fb4ae60ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba41b6ec/uploads/origins/84d34288-e29e-45ac-a55e-48723914a839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a202bd09974e09f0a6532184d4788321", "srcset": "https://si.imgix.net/ba41b6ec/uploads/origins/84d34288-e29e-45ac-a55e-48723914a839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a202bd09974e09f0a6532184d4788321, https://si.imgix.net/ba41b6ec/uploads/origins/84d34288-e29e-45ac-a55e-48723914a839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a8471f781fe7eea6d91d2e56a2f04ac 2x, https://si.imgix.net/ba41