ht and birthday candles, flower fields blooming in winter, crows and doves, key and lock.\n\nPlease draw freely! Alternative clothing & composition OK!\n\nhttps://zippy-stealer-c43.notion.site/Deacon-Seraphina-10e17861336c80cdae1ecd74a53ebaaf", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Aji_11300913/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2842979, "client_id": 2178819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c3633bd/uploads/origins/f6641ab5-efa5-4942-9a71-b8bb2694e353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4f7d0b38f49cade16f0c37037a38bd", "srcset": "https://si.imgix.net/6c3633bd/uploads/origins/f6641ab5-efa5-4942-9a71-b8bb2694e353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c4f7d0b38f49cade16f0c37037a38bd, https://si.imgix.net/6c3633bd/uploads/origins/f6641ab5-efa5-4942-9a71-b8bb2694e353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ee207c7b03c8edb75750e729c4ef0d4 2x, https://si.imgix.net/6c3633bd/uploads/origins/f6641ab5-efa5-4942-9a71-b8bb2694e353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7726a74e3b979e40dd8c1e07485711d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c3633bd/uploads/origins/f6641ab5-efa5-4942-9a71-b8bb2694e353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c08e193dad383328fe7977167bfeb42", "srcset": "https://si.imgix.net/6c3633bd/uploads/origins/f6641ab5-efa5-4942-9a71-b8bb2694e353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c08e193dad383328fe7977167bfeb42, https://si.imgix.net/6c3633bd/uploads/origins/f6641ab5-efa5-4942-9a71-b8bb2694e353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&