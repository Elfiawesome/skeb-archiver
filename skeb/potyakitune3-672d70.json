ipped": true, "creator_id": 2556269, "client_id": 369134, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe3d6bcc71b664706423aa76e73bd368", "srcset": "https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe3d6bcc71b664706423aa76e73bd368, https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74bd7cbb24dec0f50647f9507dd5a721 2x, https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=025f7b1abd280b82edd8831c78b7eb1a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8700ba5c634717fa82c75798b9fe6327", "srcset": "https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8700ba5c634717fa82c75798b9fe6327, https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f89685a6603886674fd9275295d85fed 2x, https://si.imgix.net/138fa8d3/uploads/origins/e8773112-831d-485e-929e-cf669911b9b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48b52e140a7f9330086d3dcbb839aa46 3x"}, "body": "初めましていつもマンガを拝見しております。\n\n棚木防衛さんが先日投稿されていたコトネさん男体化があまりにもカワイイカッコイイすぎるので、コミックのリクエストを希望致します。\n\nリクエストの内容と致しましては、コトネさん男性化状態での生活、女性の時と男性の時の違い、男性の時はこういう事に困る…みたいな男性化しちゃって日常に困るお話をお願いしたいです！(引用で補足されていた男性化すると髪が癖っ毛でゴワゴワで髪デッキブラシのように硬くなるなど感じです)\nその他のマンガの流れやシチュエーションはおまかせ致します！\n\nコトネさん初登場の頃からすっごく大好きなので…もしよろしければお願いします！！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 138887, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "カイガ【KA1GA】", "screen_name": "kaiga_beast1123", "avatar_url": "https://pbs.twimg.com/profile_images/1747227980534108160/2zKIcyXZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/949709461999898624/1709821842/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 75, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 161}, {"id": 304240, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "こなs", "screen_name": "ravinosuke1", "avatar_url": "https://abs.twimg.com/sticky/default_profile_images/default_profile.png", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "nc": 49}, {"id": 318747, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Father@Comms Open", "screen_name": "senakun0530", "avatar_url": "https://pbs.twimg.com/profile_images/1856655027613642752/0TkVBQeH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/177161161/1691073132/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 699447, "creator": true, "nsfw_acceptable": t