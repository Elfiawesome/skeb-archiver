b639-d399-475a-aa3b-55deaefd9e98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64b20b82b212ae889188d4a4f1fac33b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3139a24c/uploads/origins/b6a9b639-d399-475a-aa3b-55deaefd9e98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc63fd146a403a71ae16ecae6319a77", "srcset": "https://si.imgix.net/3139a24c/uploads/origins/b6a9b639-d399-475a-aa3b-55deaefd9e98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc63fd146a403a71ae16ecae6319a77, https://si.imgix.net/3139a24c/uploads/origins/b6a9b639-d399-475a-aa3b-55deaefd9e98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9868cdba40ad1b67deb49b4f19634521 2x, https://si.imgix.net/3139a24c/uploads/origins/b6a9b639-d399-475a-aa3b-55deaefd9e98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5036b61368bc0ef00d6e773e17ccf61f 3x"}, "body": "こんにちは、ワウジャナイヨ！お元気ですか？\n\nもしお手数をおかけするようでしたら申し訳ありませんが、私のリクエストをぜひご検討いただけると嬉しいです！\n\nあなたのペニス変身イラストが本当に大好きなのですが、別のタイプのTSFを描いていただけないでしょうか？\n\n『https://x.com/waujanaiyo_/status/1989817976531685391?s=20』が大好きなので、スキンスーツのコミックを描いていただけないでしょうか\nスキンスーツのPixiv辞書：https://dic.pixiv.net/a/%E7%9A%AE%E3%83%A2%E3%83%8E\n\n• キャラクター\nhttps://i.imgur.com/gMox6OQ.png - 母。普段は娘たちの前では優しく思いやりのある姿で描かれますが、遊び心のある一面も持っています。胸をふっくらと描いていただけると嬉しいです\nhttps://files.catbox.moe/e3x2wl.png- 娘。普段は冷静で頑固ですが、優しく愛らしい少女として描かれます（描きたくない場合は省いていただいても構いません！）\n\n• シナリオ\n母親のキャラクターは家事に追われ、今晩の夕食に何を作ろうかと考えている\n突然、ドアベルが鳴り、彼女は様子を見に玄関へ向かう\nそこにはTSF兵器を使う男がいて、彼女は瞬く間にスキンスーツに変身させられ、男は躊躇なくそれを身にまとう\n母親の皮膚を身にまとった男は、すぐに寝室へ行き、鏡の前で卑猥で露出度の高いランジェリーやビキニを試着し始める； お腹の前から、はっきりと浮き出た勃起の輪郭が描かれていれば最高だ\nやがて男のペニスがスキンスーツから滑り出し、母親が男のペニスへと変身していたことが明らかになる。男はためらうことなく激しく自慰を始め、母親の口から精液が噴き出す\n最後のコマでは、男に身に着けられたままの母親が、露出度の高い服を着て玄関のドアを開け、読者をじっと見つめている様子を描いていただけると最高です。その一方で、娘はドアの脇に立ち、母親の服装に戸惑っている様子を描いてください。\n\n少しセリフを入れていただけると嬉しいですが、必須ではありません。もし入れる場合は、日本語で書いてください！ 男は母親のスキンスーツを着たまま、母親らしからぬ下品な言葉を口にするようにしてください。\n\nこのシナリオに、ご自身のアイデアを自由に追加・変更していただいて構いません！\n\n以上です。リクエストをお読みいただき、ご検討いただき誠にありがとうございます！\nもし不自然な点があれば、申し訳ありません！", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waujanaiyo_/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bd02ab24/uploads/origins/318be856-6e18-4588-b9da-eef07b92b234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9ba139441938f3a61933ae29f5bc00c", "srcset": "https://si.imgix.net/bd02ab24/uploads/origins/318be856-6e18-4588-b9da-eef07b92b234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9ba139441938f3a61933ae29f5bc00c, https://si.imgix.net/bd02ab24/uploads/origins/318be856-6e18-4588-b9da-eef07b92b234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=42f1662adcd24161b546043ebcfd5f9c 2x, https://si.imgix.net/bd02ab24/uploads/origins/318be856-6e18-4588-b9da-eef07b92b234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5dd492950b2f0a23d16fb342bc640178 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3820407, "nc": 163}, {"path": "/@waujanaiyo_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3820407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46b1ab6b/uploads/origins/9cc41689-27ab-4497-9072-f27b046c3101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f52576ab9ab1b2fd84