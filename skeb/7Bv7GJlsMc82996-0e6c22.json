200&h=200&s=8a7798b60e0db0dd65f44fefe49e793b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/995c5eb1/uploads/origins/ccf31dd3-6fe4-491f-9c9e-cdad85895962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c60b45b60fc9171aa2cb174a8261db5b", "srcset": "https://si.imgix.net/995c5eb1/uploads/origins/ccf31dd3-6fe4-491f-9c9e-cdad85895962?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c60b45b60fc9171aa2cb174a8261db5b, https://si.imgix.net/995c5eb1/uploads/origins/ccf31dd3-6fe4-491f-9c9e-cdad85895962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a1ed91b90aa45e43ed97ff9c9589c4a 2x, https://si.imgix.net/995c5eb1/uploads/origins/ccf31dd3-6fe4-491f-9c9e-cdad85895962?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d772ccbf60caac671663648ff26cf4f0 3x"}, "body": "こんにちは！\n\n私のocヴィアを描いてもらえませんか？\n彼女は別の宇宙を旅しているアンドロイドですが、今の宇宙に留まることにしました。ポーズはお任せするので、好みに合わせて少しデザインを変えてみてください。ヴィアは物静かで控えめなタイプで、そのくせとても共感できる人です。右目の下のほくろもお忘れなく。\n\n 参考画像とムードボードはこちら：\nhttps://drive.google.com/drive/folders/1lQ7PN_xUpMw0eZIe5YJEAYZGmfSME7WU?usp=sharing\n\nSNSやサムネイルに使わせていただくことがあります('. - ᵕ -. ` )", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@7Bv7GJlsMc82996/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3785592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5cd026bdc5606f34e02caac009f2a85", "srcset": "https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5cd026bdc5606f34e02caac009f2a85, https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1378f906649f873243f0afe606c922a7 2x, https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d60235fbdfa345022109f6bb7e7a944 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e72ae2e7cf09f65f5f299576fa1f6ab", "srcset": "https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e72ae2e7cf09f65f5f299576fa1f6ab, https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1527989d8ac11291f1846a335359a6b5 2x, https://si.imgix.net/42847a2f/uploads/origins/b3927272-6c9d-46b2-a34b-609b1dd4337f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57b0e3caf43ad6c88d401e7e41f9b1b3 3x"}, "body": "こんにちは！あなたの絵を見て一目惚れしました！僕のOCを描いてほしいです！\n\nカリスト（白髪）\n裕福な家庭のチャーミングな大学生。他人と接することが少なく、\"甘やかされた寵児 \"のような雰囲気を醸し出している。外見は非常に冷徹で計算高いが、好きな人にはロマンチックな一面を見せる。気になる人に関する資料を調べたり消費したりするタイプで、執着心が強くなることもある。\n\n大門（黒髪）\nコスプレをこよなく愛する不器用な大学生。シャイで控えめな性格だが、仲良くなった人にはぶっきらぼうで素直になれる。元中二病で、眼帯をしている（眼に異常はなくても）。コスプレをしていると、その顔立ちから女の子に間違われることもある（でも、少し男らしい体つきで描いてください🙇）。\n\n2人の関係は、甘えん坊の犬×甘えん坊の猫。カリストは一目惚れ、大門はカリストの本心を知らない。\n\n芸術的な自由は十分に残しておきたいが、二人の力関係をよりよく説明するためのシナリオをいくつか残しておこう。(ただし、それを使う必要はない。シチュエーションは少しロマンチックでもいいし、単なるプラトニックでもいい)。\n\n- カリストと大門が一緒にコンピューターでゲームをする。(ファイル \"2 \"に用意されているゲームキャラクターは、2人のインゲームのマスコットなので、自由に使ってください)\n\n- カリストと大門のコスプレ。(衣装のデザインは自由ですが、探偵っぽいシナリオがいいかも？)\n\n- デザートを食べるカリストと大門。(カリストは甘いものが好きだが、大門はそうではない。）\n\n量が足り