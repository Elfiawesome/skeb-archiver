\n\n一応キャラの補足としましては、深窓の令嬢を思わせる雰囲気から、ちょっとお茶目な面や勝負（レース）事に関して覚悟が決まった芯の強さを持つ子で（個人的主観ですがｗ）、ゲーム内のイベントでは「源頼光になった空想をする」というお茶目エピソードがあったことがこじつけの発端となってますｗ\n\nまた、コスプレ（衣装姿）がメインなので、なるべくなら全身の衣装姿を堪能できる構図であれば特に嬉しく思います……！\n\nどちらもノータッチだろう作品を依頼するため無茶は百も承知ですが、それでもカナゴンさんの安定した可愛い絵柄と、その可愛いキャラのまま武装を着せられるギャップ力、それらで出力される武装させたアルダンさんの日常的な仕草や空気感を期待しまして、お願いできましたらと期待させて頂ければと思いました。\n何卒よろしくお願いいたします……！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@aziroyuji/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3926932, "client_id": 3583072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5df32e16/uploads/origins/cea3850c-dc4a-488d-b221-a1ddf27c5c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f8556eabad7a1d92b75814ddfd87117", "srcset": "https://si.imgix.net/5df32e16/uploads/origins/cea3850c-dc4a-488d-b221-a1ddf27c5c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f8556eabad7a1d92b75814ddfd87117, https://si.imgix.net/5df32e16/uploads/origins/cea3850c-dc4a-488d-b221-a1ddf27c5c55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fff5e5e4a001d2fa4e1672a6385e36e5 2x, https://si.imgix.net/5df32e16/uploads/origins/cea3850c-dc4a-488d-b221-a1ddf27c5c55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d971ff57ea1c3cc612d9637c885bb6a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5df32e16/uploads/origins/cea3850c-dc4a-488d-b221-a1ddf27c5c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af4ed6bad9f66c27c491ad10ef12e715", "srcset": "https://si.imgix.net/5df32e16/uploads/origins/cea3850c-dc4a-488d-b221-a1ddf27c5c55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a