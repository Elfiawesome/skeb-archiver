彼を描くことができます。ジャングルの中で植物や水辺に囲まれた彼のアートとか？あるいは、近代的な都市にいる彼の姿を描いてください。私のキャラクターを見て、インスピレーションを受けたものを何でも描いてください。ありがとうございました。\n\nhttps://twitter.com/legendofboomba/status/1458511643982368770", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurokumaa/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 229340, "client_id": 2127186, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f4b74c1/uploads/origins/11038484-6c6d-4529-8106-7841a47d0cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=560bd02e7b2faaeae141d53813cd0fc8", "srcset": "https://si.imgix.net/2f4b74c1/uploads/origins/11038484-6c6d-4529-8106-7841a47d0cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=560bd02e7b2faaeae141d53813cd0fc8, https://si.imgix.net/2f4b74c1/uploads/origins/11038484-6c6d-4529-8106-7841a47d0cac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=723d8239bde1e74065e3f8bd957cac3a 2x, https://si.imgix.net/2f4b74c1/uploads/origins/11038484-6c6d-4529-8106-7841a47d0cac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dd5d577ddeb6489121671b1b52791f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f4b74c1/uploads/origins/11038484-6c6d-4529-8106-7841a47d0cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bab22a9b3bb8b2a6735b2b702175e6a", "srcset": "https://si.imgix.net/2f4b74c1/uploads/origins/11038484-6c6d-4529-8106-7841a47d0cac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bab22a9b3bb8b2a6735b2b702175e6a, https://si.imgix.net/2f4b74c1/uploads/origins/11038484-6c6d-4529-8106-7841a47d0cac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa3ec40a3594a72251b0112db71d30b9 2x, https: