rop&crop=top&w=200&h=200&blur=200&s=af51b8d572b89c0af964ad4c1b20d424 2x, https://si.imgix.net/f27e25f8/uploads/origins/2433e95c-4fc3-44d9-9380-d76c3ab5a7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90bedf0130b0a29d42e73f89197b53d0 3x"}, "body": "お世話になります\n私がVRChatのイベントで使用予定のイラストをお願いしたいと思いご連絡致しました。\n背景や構図はお任せします。\n\n描いていただきたいのは、こよりLabo様のアバター「サリア」のイラストになります\nこちら資料URLのフォルダ「麦茶様へ資料」参照で宜しくお願いします\nhttps://drive.google.com/drive/folders/1rL101f1hoxaVSvvUE2L3c4iD4Jof6Y2x?usp=sharing\n\n作成頂いたイラストの使用用途は\n私のTwitterアカウント (@SSC0529)　(@anomuro_cafe)  (＠sariachan_cafe)\nでのイラスト掲載、SkebURLの記載、アイコンとしての使用、バナーとしての使用、ポスターとしての使用\nVRchat内でのアイコンやバナーとしての使用イベントワールドでの展示の何れかの使用を考えております。\n\n背景無し、文字無し差分の方も頂ければ幸いです\n\nhttps://drive.google.com/drive/folders/1rL101f1hoxaVSvvUE2L3c4iD4Jof6Y2x?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bacon_uw/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2359358, "client_id": 2892596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d3fbcd4/uploads/origins/114a1933-d902-45b8-a2ab-96a1f32fc474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8293e854d3fbd829f58a298385ff9d8a", "srcset": "https://si.imgix.net/1d3fbcd4/uploads/origins/114a1933-d902-45b8-a2ab-96a1f32fc474?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8293e854d3fbd829f58a298385ff9d8a, https://si.imgix.net/1d3fbcd4/uploads/origins/114a1933-d902-45b8-a2ab-96a1f32fc474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f48011c43b1e2bf1ed15918bbbf846c 2x, https://si.imgix.net/1d3fbcd4/uploads/origins/114a1933-d902-45b8-a2ab-96a1f32fc474?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a850c2bf632803841c5408b8bf947a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_im