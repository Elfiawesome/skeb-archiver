n【希望】\nスマホのアイコンで利用したいので秘書のような雰囲気だと嬉しいです。\n全体の雰囲気が伝われば服装や髪型等は研磨様の描きやすいようアレンジいただいて構いません。\n\n\n金額不足や不適切な部分がありましたらお手数ですがキャンセルしてください。 \n\n※資料画像はアイコン作成サイト様にて作成した画像も含まれておりますが、イラストの依頼での使用は問題ないことを規約で確認済みです。\n\nhttps://drive.google.com/drive/folders/1JxnOr5Y-vMcWD5VqOsv1hEZq9JrFC2xA", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kenmamenma410/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4f1afca/uploads/origins/acc1e02d-e29d-46b1-a120-126be75f22de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27c2919530a69f477dd063367d586be1", "srcset": "https://si.imgix.net/c4f1afca/uploads/origins/acc1e02d-e29d-46b1-a120-126be75f22de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=27c2919530a69f477dd063367d586be1, https://si.imgix.net/c4f1afca/uploads/origins/acc1e02d-e29d-46b1-a120-126be75f22de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e03c0b82a9b9bde387fb976887ed239 2x, https://si.imgix.net/c4f1afca/uploads/origins/acc1e02d-e29d-46b1-a120-126be75f22de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6eb9ccab7c7a346b3d4fcb962c130394 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3738269, "client_id": 909927, "nc": 0}], "sent_works": [], "similar_creators": [{"id": 2672, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "槙千あとり", "screen_name": "makisenatori", "avatar_url": "https://pbs.twimg.com/profile_images/1791821149191774208/Nlth8A5l.jpg", "header_url": "https://pbs.twimg.com/pro