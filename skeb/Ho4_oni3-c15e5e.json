-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74dcc155dccba0830226c5b480400c53, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d839958ae988f8428f74d03b326c1887 2x, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d7998d42299ea4264ff6c367e24a3ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab72739cdc8762658dee0f0bb06594f8", "srcset": "https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab72739cdc8762658dee0f0bb06594f8, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aad7aa2995040b69f04ce3c7252632a6 2x, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d2b5b80aca22d39af1b6b9fb8dad90c 3x"}, "body": "こんにちは☺️、翻訳に誤りがあればあらかじめお詫び申し上げます。私は🇺🇸在住のクライアントで英語しか話せないため、SKEBの自動翻訳を使用せざるを得ません。\n\nTwitterであなたの作品投稿を見ました。アートスタイルがとても可愛らしく、髪の描き方や目の表現に強く惹かれました！私のオリジナルキャラクター「Cutiie Gurliie」（発音：カユティ・ガーリー）を描いていただけたら光栄です。参考画像をBlueskyにアップロードしました。リンクは下記に添付します！過去のSKEBリクエストもご覧いただけます！\n\nポーズなどは完全に自由です。ただ、ブルースカイにある完全な参考資料、または私のSKEBページにあるhttps://skeb.jp/@Meによる代替衣装に基づいて描いてください。創作の参考になれば、彼女のバックストーリーを共有します：Cutiie Gurliieは、会社員であるアーティストが趣味で描いた猫娘の絵として存在していました。 しかし、彼女の創造主は世界を滅ぼした戦争で命を落とした。その戦争で使われた化学物質が大気中に残り、キャンバスから彼女を蘇らせた。今、彼女は創造主の廃屋となった家の廊下を彷徨い、この朽ちゆく世界に喜びを見出している。彼女を、生き生きとしているが純真なキャラクターと考えてほしい。自分が存在する世界に興味津々だが、その疑問に答えてくれる者は誰もいない。もちろん、バックストーリーの反映は必須ではありません！\n\nご検討いただきありがとうございます❤️https://bsky.app/profile/cutiiegurliie.bsky.social/post/3mcpg4aq7bk2a", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1067148, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ほがら", "screen_name": "hogara_18", "avatar_url": "https://pbs.twimg.com/profile_images/1186568091590742016/7Pcf8xdI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1186550989291057158/1726721421/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1844279, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "平安. ᵗ ᵒ ᵐ ᵃ ᵗ ᵒ", "screen_name": "heiantomato", "avatar_url": "https://pbs.twimg.com/profile_images/1851114963341017088/uAgC75Lz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252937639352610816/1727544542/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2710539, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "8310", "screen_name": "yasato83", "avatar_url": "https://pbs.twimg.com/profile_images/1965717411241644033/4fo_wz7O.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1650067291995013122/1757498538/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 