43-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74dcc155dccba0830226c5b480400c53, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d839958ae988f8428f74d03b326c1887 2x, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d7998d42299ea4264ff6c367e24a3ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab72739cdc8762658dee0f0bb06594f8", "srcset": "https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab72739cdc8762658dee0f0bb06594f8, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aad7aa2995040b69f04ce3c7252632a6 2x, https://si.imgix.net/3fa41ac3/uploads/origins/afac63d6-ffa7-4143-b8bc-f77b26a212b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d2b5b80aca22d39af1b6b9fb8dad90c 3x"}, "body": "こんにちは☺️、翻訳に誤りがあればあらかじめお詫び申し上げます。私は🇺🇸在住のクライアントで英語しか話せないため、SKEBの自動翻訳を使用せざるを得ません。\n\nTwitterであなたの作品投稿を見ました。アートスタイルがとても可愛らしく、髪の描き方や目の表現に強く惹かれました！私のオリジナルキャラクター「Cutiie Gurliie」（発音：カユティ・ガーリー）を描いていただけたら光栄です。参考画像をBlueskyにアップロードしました。リンクは下記に添付します！過去のSKEBリクエストもご覧いただけます！\n\nポーズなどは完全に自由です。ただ、ブルースカイにある完全な参考資料、または私のSKEBページにあるhttps://skeb.jp/@Meによる代替衣装に基づいて描いてください。創作の参考になれば、彼女のバックストーリーを共有します：Cutiie Gurliieは、会社員であるアーティストが趣味で描いた猫娘の絵として存在していました。 しかし、彼女の創造主は世界を滅ぼした戦争で命を落とした。その戦争で使われた化学物質が大気中に残り、キャンバスから彼女を蘇らせた。今、彼女は創造主の廃屋となった家の廊下を彷徨い、この朽ちゆく世界に喜びを見出している。彼女を、生き生きとしているが純真なキャラクターと考えてほしい。自分が存在する世界に興味津々だが、その疑問に答えてくれる者は誰もいない。もちろん、バックストーリーの反映は必須ではありません！\n\nご検討いただきありがとうございます❤️https://bsky.app/profile/cutiiegurliie.bsky.social/post/3mcpg4aq7bk2a", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 400399, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぬゐめ", "screen_name": "osaihou_nuime", "avatar_url": "https://pbs.twimg.com/profile_images/2039280493339017216/hoN8wkFP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1124300406207668224/1775037343/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 474878, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝐆𝐮𝐮", "screen_name": "Guu8_", "avatar_url": "https://pbs.twimg.com/profile_images/1821217556155527170/6dcGyFzd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1036553916031201280/1686243664/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F1643ff31-9fe7-49c5-a8d6-74e745d202d0.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a2332b22-d895-43ee-8c7f-713a5d903a09.png", "appeal_receivable": true, "popular_creator_rank": 76, "request_master_rank": null, "first_requester_rank": null, "deleted_at": n