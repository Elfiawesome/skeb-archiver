・やや困り眉・オッドアイ(右目:黄色、左目:オレンジ)タレ目・猫目・右目に泣きぼくろ \n性格：無邪気で優しいお姉さん・重度のシスコン・光属性・よく笑いよく泣く・ご飯が大好き \nモチーフ：春・花占い  \nビジュアルおよび詳細等は資料にまとめさせて頂きましたので、お手数ですがご確認くださいませ。\n\n【イメージ】\n構図、ポージングともにお任せしますが、桂花様の指の描き方が好きなため、髪をかける仕草など手が印象的なポーズですと大変嬉しいです。\n\n  【用途】\n・個人鑑賞（アイコン、ヘッダーや壁紙利用） \n・グッズ作成（個人利用のための印刷依頼など） \n・依頼用の資料としてドライブへの掲載  \n\nご検討の程よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1gmWxnxxwqrITQGpe3V0_3f3eDWFj4nhT", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@Ciel_Cats/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3678316, "client_id": 3678340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/682021b4/uploads/origins/5e469abf-a561-44cf-87f1-8352a0ba6afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=497ba8cec674c5f495a4a9c184353a2e", "srcset": "https://si.imgix.net/682021b4/uploads/origins/5e469abf-a561-44cf-87f1-8352a0ba6afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=497ba8cec674c5f495a4a9c184353a2e, https://si.imgix.net/682021b4/uploads/origins/5e469abf-a561-44cf-87f1-8352a0ba6afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=744ef7fbf4ee0640a79450a9af6477ea 2x, https://si.imgix.net/682021b4/uploads/origins/5e469abf-a561-44cf-87f1-8352a0ba6afe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f42271912796156f92ce7ca36a74c95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/682021b4/uploads/origins/5e469abf-a561-44cf-87f1-8352a0ba6afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5ff36dc1b3d871a8639728c43f0723", "srcset": "https://si.imgix.net/682021b4/uploads/origins/5e469abf-a561-44cf-87f1-8352a0ba6afe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da5ff36dc1b