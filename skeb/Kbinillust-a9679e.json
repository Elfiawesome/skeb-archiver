152b0771/uploads/origins/40c10d7c-fb4a-4cc1-abb0-166319de67b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d639f95044bbbd6e4ad9635a6729598c 2x, https://si.imgix.net/152b0771/uploads/origins/40c10d7c-fb4a-4cc1-abb0-166319de67b6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=870f5b98e963df7f360ba2c39f3d72db 3x"}, "body": "いつもお世話になっています。\n初めてskebを利用した依頼なので不備があったら申し訳ございません。\n3月15日で配信1周年なのでKB員さんに是非イラストをお願いしたくリクエストさせていただきました。\n\n描くのは私のアイコン、配信でLive2Dで動かしている人をお願いします。\nキャラクターというか、似顔絵の派生なので設定などは特にありませんが、本人はアルコール飲料を大変好むため、そんな感じだったら嬉しいです。\nあとはいろいろお任せいたします。\nよろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kbinillust/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3100181, "client_id": 3297958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f064ef912ae06f77d4fa286fa3c64dc", "srcset": "https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f064ef912ae06f77d4fa286fa3c64dc, https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e330f221276ee33fd77edaac4822ef41 2x, https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8e614718b3edb4344e28fbfee8295b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb282cbeade115d7736d1c29e93466cb", "srcset": "https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb282cbeade115d7736d1c29e93466cb, https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9600b56a2f7de8f87afa544cab2251a1 2x, https://si.imgix.net/0c37bb3b/uploads/origins/3893205e-7c84-4380-bffb-19612dbf3273?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=def931e0e1bf4c8b2f09b2fc54023297 3x"}, "body": "初めまして！新人Vtuberの米炊らいずと申します。\nKB員🫠様のイラスト(https://skeb.jp/@Kbinlive/works/1やともりちゃんのイラスト)を拝見し、\nとても絵柄が好きでしたので、是非私も描いていただきたいと思いリクエストを送ります。\n\n■作成いただきたい内容\n・私(米炊らいず)の絵\n\n■キャラクター設定\n狼と天使のハーフ。こめたきワールドの王。王なのに偉そうにできない、素朴で照れ屋。\nながーい三つ編みと、太ももと泣きぼくろがチャームポイント。\n住民を増やすためになんでも屋として働きながら人間界でもともと趣味のゲームで配信を始めた。\nお米が大好きで、スト6にハマりすぎている。モダンジュリ使い。\n夢はスト6のCRカップに出場して活躍すること。\n\n■構図など\nすべてお任せします！改変等もOKです！\n\n■使用用途：\nTwitchのオフライン画像として設定したいです。\n\n■サイズについて\nTwitchのオフライン画像の推奨が1080x720でしたので、こちらでお願いしたいです。\n\n■画像形式について\nPNGでお願いしたいです。\n\n■備考\n目元のほくろと宝石が抜けがちになってしまうので、入れていただけると嬉しいです。\nキャラクターのみの透過も併せていただけますと幸いです。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1oze-xsb4q9q5xsISmWDMD2GW1DYkPZLi", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kbinillust/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3100181, "client_id": 2947025, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65fd9b69/uploads/origins/08574507-fbfd-45ba-989b-9c5a29c0045f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f149b518616185cca3a3852de0ce4e8", "srcset": "https://si.imgix.net/65fd9b69/uploads/origins/08574507-fbfd-45ba-989b-9c5a29c0045f?bg=%23fff&auto=format%2Ccompress&fm=w