れた子供時代」から生まれた夢のエルフです。彼女は内気で臆病な性格で、アフタヌーンティーを楽しむのが好きです。\n\nデザインのテーマを決めるのにかなり迷ったので、クリエイティブな方向性はすべてあなたにお任せしたいです。特に、お菓子や花をデザイン要素として取り入れるあなたのスタイルが大好きなので、あなたならではの配色やアイデアを楽しみにしています。\n\n注：彼女の本来の耳はエルフの耳で、ウサギの耳はあくまでアクセサリーです。\nこのオリジナルキャラクターについては、すでに何度も『不思議の国のアリス』をテーマにした作品が制作されているため、そのテーマの使用は避けてください。\n\nhttps://drive.google.com/file/d/19B67YcCHxM4XgiA738lsWROvQUBqMP5y/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dennsnail/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4038614, "client_id": 2870132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bd0c77b/uploads/origins/51c8f1c0-d359-40f5-8364-0de223980f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ff1332811b2df7eb2f543a55e498f0", "srcset": "https://si.imgix.net/5bd0c77b/uploads/origins/51c8f1c0-d359-40f5-8364-0de223980f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9ff1332811b2df7eb2f543a55e498f0, https://si.imgix.net/5bd0c77b/uploads/origins/51c8f1c0-d359-40f5-8364-0de223980f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=942255ca41741c19493ed1ac8a0b2703 2x, https://si.imgix.net/5bd0c77b/uploads/origins/51c8f1c0-d359-40f5-8364-0de223980f74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de4425b3828ed3fc03d971bd10d4a4a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bd0c77b/uploads/origins/51c8f1c0-d359-40f5-8364-0de223980f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f8c9072e2876d2304cec60da6e24917", "srcset": "https://si.imgix.net/5bd0c77b/uploads/origins/51c8f1c0-d359-40f5-8364-0de223980f74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f8c9072e2876d2304cec60da6e24917, https://si.imgix.ne