N6ltlFXS9RdJBxytHb4LaIUb?usp=drive_link\n\nhttps://drive.google.com/drive/folders/19GMqgxNzN6ltlFXS9RdJBxytHb4LaIUb?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Takesan_1113/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2780852, "client_id": 173648, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a-ed89-4d2f-8a4d-66d314904e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d23ed8650bdcd380b7510f2a917bea1", "srcset": "https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a-ed89-4d2f-8a4d-66d314904e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d23ed8650bdcd380b7510f2a917bea1, https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a-ed89-4d2f-8a4d-66d314904e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71710933a953a830d72f17dafb55fd74 2x, https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a-ed89-4d2f-8a4d-66d314904e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32ac83db4181bf4dc74ece230220f10d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a-ed89-4d2f-8a4d-66d314904e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3617150aa3124ccc0c00dbd0182b0175", "srcset": "https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a-ed89-4d2f-8a4d-66d314904e40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3617150aa3124ccc0c00dbd0182b0175, https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a-ed89-4d2f-8a4d-66d314904e40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b7f9a7f452112f7c8ef006d8954f818 2x, https://si.imgix.net/6e3f7a59/uploads/origins/c9f1433a