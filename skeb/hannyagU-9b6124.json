webp&fit=crop&crop=top&w=200&h=200&s=9758cbe9c9a67487f4c14262acfb34a7, https://si.imgix.net/11e0f026/uploads/origins/d567866a-c283-4c28-86f0-121104075a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21c005b40c7d61d1c20cd79f7f58f1b7 2x, https://si.imgix.net/11e0f026/uploads/origins/d567866a-c283-4c28-86f0-121104075a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9967a917c062d0a8e9b2e63a1af4c003 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11e0f026/uploads/origins/d567866a-c283-4c28-86f0-121104075a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=020e92e95f6f82c253efb34390495fc3", "srcset": "https://si.imgix.net/11e0f026/uploads/origins/d567866a-c283-4c28-86f0-121104075a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=020e92e95f6f82c253efb34390495fc3, https://si.imgix.net/11e0f026/uploads/origins/d567866a-c283-4c28-86f0-121104075a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fd4a195419bf3e85cbc276af8e44b92 2x, https://si.imgix.net/11e0f026/uploads/origins/d567866a-c283-4c28-86f0-121104075a3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dadf82f23f6cad32e804fb2783404033 3x"}, "body": "こんにちは、はんにゃじさんの描くイラストの色合いや雰囲気、空気感が大好きなので是非一枚イラストリクエストさせてください。\n\n弊本丸の刀さにを描いてほしいです。\n審神者はアバターとして茶トラ猫の姿を使用しており、普段描いている物を資料に添付しました。\n基本的に茶トラ猫であること以外は設定がふわっとしているので、もしも資料のようなゆるキャラマスコットが描きたい雰囲気と合致しないようならば、四足歩行の普通の猫でも虎サイズでも、バーチャルネコでも猫(概念)の映り込み程度でも、広義で猫に分類されれば何でも大丈夫です。\nお相手は巴形薙刀・極で、押しと我の強いタイプの巴形です。\n一応刀さに表記をしていますが‪厳密には✕‬というよりは＋の方が近く、距離の近い家族のような主従関係です。\n\n私の中での彼らのイメソンがあるので資料先の曲を聴いてはんにゃじさんの受けたイメージで、もしも楽曲からのインスピレーションが難しければ、弊本丸で普段使いしているので藤の景趣のような雰囲気でお願いします。\n詳細はおまかせしますので、はんにゃじさんの描きたいように描いていただければ嬉しいです。\n\n観賞用目的のためサイズや比率には指定無し。\n他用途での使用を想定しない私的なリクエストにはなりますが、もしかしたら他の方へコミッションを依頼する場合の資料や、当方Skebと紐づいていない刀剣乱舞用Twitterアカウントが別に存在するので作者名を明記の上、そちらでも作品をご紹介させていただく可能性があります。\n\nリクエストの方、ご一考頂けると嬉しいです。どうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/10SgFixuaaJjq2L1gUOm5F5975VKZArR7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hannyagU/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f78b1f37/uploads/origins/a1a91ade-b932-4e85-8c8f-b651b400f7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ab316548e66a06643ab37b4b8319421", "srcset": "https://si.imgix.net/f78b1f37/uploads/origins/a1a91ade-b932-4e85-8c8f-b651b400f7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8ab316548e66a06643ab37b4b8319421, https://si.imgix.net/f78b1f37/uploads/origins/a1a91ade-b932-4e85-8c8f-b651b400f7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c9c33fa65bd04b70508e4ccb54abaa43 2x, https://si.imgix.net/f78b1f37/uploads/origins/a1a91ade-b932-4e85-8c8f-b651b400f7cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52163a9feb6830c4128e5ab820e3d217 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 8030, "client_id": 1157853, "nc": 0}, {"path": "/@hannyagU/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/63284364/uploads/origins/0e175777-a4d4-4120-89ae-dc7191fcde4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a64821f0346e4761898e59801ffd5bb", "srcset": "https://si.imgix.net/63284364/u