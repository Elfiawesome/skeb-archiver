レーヘアーの男性。\n普段の表情は笑顔。不遜でカジュアルな性格。クールでチャーミング。\nエイリアン・テクノロジーの研究開発会社を率いる悪役軍人。物作りが好きなエンジニアでもある。\n\n付き合っているラブラブカップル。\n\nポーズのアイデアは以下の通り：\n- ゲイブがアロイスに散髪をしている。\n- ゲイブとアロイスが果樹園で一緒にリンゴ狩りをしている。\n- ゲイブとアロイスが一緒に映画館にいる。アロイスがゲイブに寄り添っているが、ゲイブは眠っている。\n- その他、お好きなキュートでロマンチックなシーン\n\n使用目的SNS、OC活動、印刷など個人的な閲覧のみ\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1atjIzPqghGCslfuaHI8uE5rk5gzVuPSz?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_na_zu_ma_ri/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758684, "client_id": 1988381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7a2d17a1e806733ee6c83239434d85", "srcset": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff7a2d17a1e806733ee6c83239434d85, https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=97e1bf6845cc8df4b5e301cc8e52fbeb 2x, https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45e006d512283f48326b000bb917bdb0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4992ade72eb94c0c9ce34d9c6ca7a7fd", "srcset": "https://si.imgix.net/881bfe82/uploads/origins/59be12ed-6bbb-4564-8c40-2ed97759e473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4992ade72eb94c0c9ce34d9c6ca7a7fd,