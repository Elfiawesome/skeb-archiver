=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536403ed7750ff12b6efa12029bb7287, https://si.imgix.net/4b560de1/uploads/origins/7e75bf32-922a-43cd-9761-b6ff34ecd439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=604d200ffcfafe55542f10e49a82a69b 2x, https://si.imgix.net/4b560de1/uploads/origins/7e75bf32-922a-43cd-9761-b6ff34ecd439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=500652e459af2b76dcdd3d962c02ffff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b560de1/uploads/origins/7e75bf32-922a-43cd-9761-b6ff34ecd439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fc050f9c7f618e14f602565afeeaedf", "srcset": "https://si.imgix.net/4b560de1/uploads/origins/7e75bf32-922a-43cd-9761-b6ff34ecd439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fc050f9c7f618e14f602565afeeaedf, https://si.imgix.net/4b560de1/uploads/origins/7e75bf32-922a-43cd-9761-b6ff34ecd439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3d20d1fa584b3d1f1cde8fd845163b2 2x, https://si.imgix.net/4b560de1/uploads/origins/7e75bf32-922a-43cd-9761-b6ff34ecd439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ccc4c82fcaaf6f55ca7cff49f1628dd 3x"}, "body": "なざ先生、こんにちは！先生の絵柄が本当に大好きです！私のオリジナルキャラクターを描いていただけますと幸いです。\n\n映画シリーズの「ゴーストバスターズ」をベースにしたParoのOCです。\n\nキャラクター情報\nA（黒髪）\n• 垂れ目、クマ\n• 少し太めの眉\n• 左耳にゴールドのイヤーカフ。両耳ピアスもある。\n• 大きな口\n• 非常にカールした、乱れた髪でアンダーカット（サイドと後ろを剃り上げ）\n• がっしりとした体格（183cm / 80kg）\n• クールに見えるが、短気な性格。\n\nB（茶髪）\n• 長いまつ毛、三白眼\n• 厚い唇\n• 少し日焼けした肌\n• ふさふさした眉毛\n• えくぼ\n• あごにほくろ\n• がっしりとした体格（188cm / 90kg）\n• 自信家であり、典型的なフラタニティの男。\n\nもし可能でしたら、先生のこちらの作品のように、二人を別々に描いていただけますと嬉しいです：\nhttps://x.com/ha_na_zu_ma_ri/status/2056719133065228293?s=46\n\n具体的な構図と表情をご自由に描いてください。二人のかっこよく、自信に満ちた姿を描いていただけますと幸いです！\n\nリクエストされた内容と金額が合わない場合に、お気軽に再送・キャンセルしても大丈夫です。ありがとうございます！\n\nhttps://imgur.com/a/fFeirAG", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_na_zu_ma_ri/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758684, "client_id": 1072318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a052b2aa6f44dff3e39d41eea327b1ab", "srcset": "https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a052b2aa6f44dff3e39d41eea327b1ab, https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34d57c50346d98bcaff2c1b7007fb962 2x, https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02b602e5f72862b6b4cf52ddf4f42a35 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65deda62c66bf16ea82bc9de1019b9bc", "srcset": "https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65deda62c66bf16ea82bc9de1019b9bc, https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=468a9e89d68660476aa2a0cece657243 2x, https://si.imgix.net/c2e86fde/uploads/origins/0bcd878e-d746-428e-8126-d90c42fc78e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=822433ae2c5e35bda4d3c878f6a45772 3x"}, "body": "はじめまして！私はナザ先生の作品のファンです。\n\nお手数でなければ、私のオリジナルキャラクターのイラストをお願いしたいのですが。 この漫画の作風が本当に好きなんです！（例：https://skeb.jp/@ha_na_zu_ma_ri/works/5 または https://skeb.jp/@ha_na_zu_ma_ri/works/1）\n\n私のキャラクター、アドレイは元メカパイロットですが、引退して15年が経ち、今ではほとんどタバコを吸ったりギャンブルをしたりして、だらだらと過ごしています。 ところが、突然、引退後初めて任務に就くことになりました。35歳になった今、昔のパイロット服を着るのは少し恥ずかしいようです。\n\n35歳バージョンの彼（参考画像の右側）を、できればタバコを吸っている姿で描いていただけませんか？ソファにだらりと寝転がっていたり、壁にもたれかかっていたり、その他思いつくようなポーズでも構いません。 ポーズはご自由に！\n\n設定はSFですので、未来的な背景であれば何でも構いません。ご依頼をご検討いただきありがとうございます！\n\nhttps://drive.google.com/file/d/1Fer7_MMkJ8JNt3ZemzJSumsJropb90Li/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_na_zu_ma_ri/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3758684, "client_id": 1698488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0ed8ad061eb704abec8c2e0147f09db", "srcset": "https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0ed8ad061eb704abec8c2e0147f09db, https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a0b5d7e8b213b395edc51efe40579ea 2x, https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5afce3067926262e80ad1ca28bafb47d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a8d9eaf5a2f6be2847aac1733c49d9c", "srcset": "https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a8d9eaf5a2f6be2847aac1733c49d9c, https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38b822878e0b1c310b3a755d65e22811 2x, https://si.imgix.net/c00d3376/uploads/origins/4e638553-ce3f-45b5-8eb2-caed93dc6736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=acc8011a47c5490c9eb84fe0b835b24c 3x"}, "body": "こんにちは！私のオリジナルキャラクターであるリリエルとセインの2体をご依頼いたします。1. リリエルは30代に見える魔法使い（実際の年齢は500歳以上）。身長192cm。温厚で風変わり、時に狂気じみた一面も。着飾ることとお茶を飲むことが大好き。\n\nデザインノート：大きく垂れ下がった耳が特徴。2. セインは人間とオークの混血。43歳で身長187cm。小さな町でフリーランスの文筆家として活動し、手紙や書類の作成、新聞・雑誌の仕事も請け負う。厳格で重々しいが、心は優しい。\n\nデザインノート：集中すると牙が時折見える。執筆時は眼鏡をかける。顔に細い傷跡がある。二人は恋人同士であり隣人でもある。自由に描いてください。手をつなぐ、抱き合う、キスするなどの親密な交流や、共に過ごす様子を自由に表現してください。舞台は1930年代ヨーロッパ風のファンタジー世界です。ご検討いただき誠にありがとうございます！\n\nhttps://drive.google.com/drive/folders/10IanwEnpFe2CPS_xcxnBeIwgANpLw-L1?usp=share_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_na_zu_ma_ri/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758684, "client_id": 1563727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d14fd42/uploads/origins/152fec17-9173-498f-a7b3-7e3d7e676507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f54402eade4a3aabf0c5689cf6b704b4", "srcset": "https://si.imgix.net/8d14fd42/uploads/origins/152fec17-9173-498f-a7b3-7e3d7e676507?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f54402eade4a3aabf0c5689cf6b704b4, https://si.imgix.net/8d14fd42/uploads/origins/152fec17-9173-498f-a7b3-7e3d7e676507?bg=%23fff&auto