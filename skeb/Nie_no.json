appeals_count": 0, "received_works": [{"path": "/@Nie_no/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 516160, "client_id": 303842, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c01f861a/uploads/origins/06c4fe31-7022-4357-8b10-e74af8dad112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01232ce87d260dc16f871be081e384e2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c01f861a/uploads/origins/06c4fe31-7022-4357-8b10-e74af8dad112?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d37f4ce7cf074635731b13d5ab852c47", "src_set": ""}, "body": "ニーノさん、こんにちは。\n前回、前々回共に素敵なイラストをありがとうございました！\nまたリクエストを送らせていただくので、良かったらご検討ください。\n小説同人誌に使用する、カバーのイラストをお願いできませんか。\n私が#デレマス140字小説　＋　#各アイドル名生誕祭2024～2025　でXにポストした（Pixivにもアップしています）、誕生日祝いの140字小説を再録した本を出そうと思っています。\n誕生会、誕生日ケーキ、そういったイメージのイラストでアイドルマスターシンデレラガールズのアイドル5名ほど（ボイスありを3人、ボイスのまだない子を2人みたいにボイスのまだない子も）好きな子を選んで、いつもよりやや労力少なめ、ディフォルメな感じで描いていただけないでしょうか。\nもしOKなら資料URLのテンプレート、PSD、CMYKのもので描いていただけないでしょうか（https://www.shimaya.net/bungei/download.html#tmp01、文庫サイズ、カバー用「背幅10mm」のテンプレートでお願いできないでしょうか。アイドル1人につき1ページでも190ページは越えるためクリームキンマリという用紙で本の厚みは10mmを越える予定です）\nタイトルやクレジットはページ数が決まった後に厚みが少し前後するため、こちらで入れさせて頂こうと思いますので少し字がかぶっても大丈夫なところを表表紙（表１）や裏表紙（表４）に作ってもらえると嬉しいです。\n良かったらご検討ください！\nもし私の小説本が手元にあれば今までの本のような感じでイメージしていただければ幸いです。\n\nhttps://www.shimaya.net/bungei/download.html#tmp01", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 516160, "client_id": 303842, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/efc586af/uploads/origins/b70b9f08-4c5e-4fd8-b800-e07dfdcb1f43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be60022f82