ss&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67f7cb6ec212aa10d0f06a51e13d059b", "src_set": ""}, "body": "はーちゃんのイラストが見たいのでリクエストさせて頂きます。\nシチュエーションに関しては純白下着姿のはーちゃんが、\n1枚目:ベッドの上で仰向けに倒される\n2枚目:ブラの中央を掴まれる\n3枚目:ブラを剥ぎ取られる\n4枚目:傍らにブラを添えながらパンツ一丁姿にされる\n5枚目:丸見えになったおっぱいを揉まれる\n6枚目:乳首を弄られる\n7枚目:乳首から母乳が吹き出る\n8枚目:母乳を吸われる\n9枚目:目や乳首からそれぞれ涙や母乳を流しながらおっぱい丸出しなパンツ一丁姿を堪能される\n…といった感じにしてほしいです。\n上記のシーンに台詞を入れた計18枚セットでお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 516160, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0601665/uploads/origins/8cbac603-9927-4967-8ad7-c3f4c7eca0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53362433c8ade23dfc965f65689a018d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0601665/uploads/origins/8cbac603-9927-4967-8ad7-c3f4c7eca0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a637ed053ad978e904de4f78208b355", "src_set": ""}, "body": "はーちゃんのイラストが見たいのでリクエストさせて頂きます。\nシチュエーションはビキニはーちゃん(ビキニのデザインは水色のチューブトップ)がセクシーな背伸びポーズを披露して周囲のファンを喜ばせている、といった感じにしてほしいです。\n差分は上記の通常ver.に加えておっぱい丸出しなビキニパンツ一丁ver.、さらに差分に応じてはーちゃんの表情の変化やセリフも入れた計4枚でお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 516160, "client_id": 1591546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d59a7eda/uploads/origins/9644fa30-5035-4211-ba05-37a20c4aa1d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0592dd5628f66415f8254ee09f444ac", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d59a7eda/uploads/origins/9644fa30-5035-4211-ba05-37a20c4aa1d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aba8dfe2382392458906fd67428a1e8c", "src_set": ""}, "body": "いつもイラスト見させていただいております！私もリクエストよろしいでしょうか？漫画形式のリクエストを希望しています。\n私のオリジナルアイマスキャラ・神山優吾くんと西川保奈美ちゃんをお願いします。\nシチュエーションはオペラの舞台に仕掛けられた爆弾が爆破され、振動で崩れゆく舞台で戸惑い立ちすくむヒロインの保奈美ちゃんと崩落する劇場を掻い潜り助けにいく主人公の優吾くん、爆破で舞台が崩れ落ちる中、シャンデリアが瓦礫ごと落下。それを主人公の優吾くんが保奈美ちゃんの所に飛び込んで間一髪で守り抜くという映画のワンシーンのようなシチュエーションでお願いします。\n優吾くんURL\nhttps://pbs.twimg.com/media/FltY3waaMAAev9A?format=jpg&name=large\n優吾くんに着せて欲しい衣装URL(←白の部分は紺色でお願いします)\nhttps://guide.fire-emblem-heroes.com/wp-content/uploads/celice_enduring_legacy_slide01.png\n保奈美ちゃん(と着せて欲しい衣装)URL←二つの衣装URLを足して二で割った感じのデザインでお願いします(色と模様と装飾品は喝采のディーヴァ衣装ベース、スカートは足が見えなくなるくらいの長さで)。\nhttps://pbs.twimg.com/media/FZKLvOPaQAAs2kA?format=jpg&name=medium\nhttps://i.pinimg.com/originals/0a/ed/95/0aed951a68347115aea41841ba492b27.jpg\n背景は可能であれば崩落と縦揺れを強調する感じでお願いします。オリキャラに関しましては自己解釈で描いて構いません。シチュエーションの参考資料もご用意しますのでご参考にしていただければと思います。\n\nhttps://www.instagram.com/p/CY3mc5nliXZ/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7df0ad6b/uploads/origins/ec50e77c-d281-4d66-b773-197afc9180ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d6300816c2f8af66eb912f1ef22517a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 516160, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Nie_no/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 516160, "client_id": 861050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0bf3b11/uploads/origins/68836d5f-3fd4-4102-85b9-63cb952a2e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63501833bb644bfac76e80efa4cea499", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0bf3b11/uploads/origins/68836d5f-3fd4-4102-85b9-63cb952a2e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd21ed0724c3a1c2a46a9f879c8a117", "src_set": ""}, "body": "みくにゃんの中の人の前職がJR東日本ということで、電車の運転士の前川みくをお願いします。\n\n後ろからの構図で、運転席から指差喚呼をしている姿で、「なんで後ろ姿にゃ！」と心の中のツッコミ付きでお願いできたらと思います。\n\n難しい内容かもしれませんが（特に運転席の画）、よろしくお願いします。\n\n“参考画像”\nhttps://www.google.com/url?sa=i&url=https%3A%2F%2Fblog.goo.ne.jp%2Fyojito_1949%2Fe%2F79a774dc8074a51ece60060dc8a9afc4&psig=AOvVaw3g2dBYApwCeNSsFOT-lEKf&ust=1631618440401000&source=images&cd=vfe&ved=0CAsQjRxqFwoTCOjOrczq-_ICFQAAAAAdAAAAABAJ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 516160, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aae23719/uploads/origins/5f3e2cf4-0d65-4193-9188-7e0614dd40d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3bb6c769b34872c510e159ac54014ba7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aae23719/uploads/origins/5f3e2cf4-0d65-4193-9188-7e0614dd40d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4624f8cb3a7d578473e4f60175a803f", "src_set": ""}, "body": "みくにゃんに対してデリカシーの無い発言をしてしまい、両頬に真っ赤な紅葉(手形)を付けたりーなのイラストをお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 516160, "client_id": 861050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8cf3d25/uploads/origins/ba7fb2a2-949e-4a0a-88f5-856485c306b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a917521e4fe34bd510da3bc0ca230e48", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8cf3d25/uploads/origins/ba7fb2a2-949e-4a0a-88f5-856485c306b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1052dfb37f763ffb16996956a43f679", "src_set": ""}, "body": "2度目のリクエストです。\n\nどんぎつねに扮する前川みくが、星野源Pにおあげを食べられて痛がっている姿をリクエストします。\n\n新田美波ような感じで痛がっているみくにゃんと、シルエット状態のP（Pヘッドでもいいし大雑把な形でOKです）が「食べづら・・・」と呟いている感じの構図でお願いできればと思います。よろしくお願いします。\n\n参考動画：https://youtu.be/ZqFDh8ZrsNA", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 516160, "client_id": 861050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a52329b/requests/285437_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ccf25d35e605d48273b16a7111c1b2d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a52329b/requests/285437_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82e88a074e131074fa39040669e2f527", "src_set": ""}, "body": "初めてリクエストします。\n\nネコ耳着けてるみくにゃんがたい焼きを食べているシーンをお願いします。\n\n理由：なぜかふと35年前に「小学一年生」という雑誌で連載していたマンガを思い出したため\n　　（ウサミンならわかることでしょう）。\n\nなお、構図や服装等はお任せします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nie_no/works/2", "private_thumbnail_image