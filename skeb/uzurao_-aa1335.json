願いします。\n\nhttps://drive.google.com/drive/folders/17ebQL8jq9DQKrF7zZ0PX2eRCosvF2DFi?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uzurao_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2217585, "client_id": 2068817, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b5020182c8f4d2a8826706576d013f9", "srcset": "https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b5020182c8f4d2a8826706576d013f9, https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e52a07efa76b05bc8f7e5c91235740ae 2x, https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b78de7dd30ded17f5ce8c4fea47ec162 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f085ed7ae34efe131b2d2ec5d1e9733b", "srcset": "https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f085ed7ae34efe131b2d2ec5d1e9733b, https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f35dd45e5732aea940b6f70bf7788a1 2x, https://si.imgix.net/a273a1d9/uploads/origins/57ef67ba-616e-42a8-9028-2bbe85895322?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f06289625a51beabe052d4e445d5fe2 3x"}, "body": "こんにちは、私はあなたのスタイルが本当に好きです。私のキャラクターを描いていただけませんか？\n\nもしよろしければ、左手に緑の爪がある悪のバージョンも描いて欲しいです。https://imgur.com/a/prW4erT。\n\nその他は、こちらを参考にしてください。 https://imgur.com/a/QY5coDq\n\n目の色は#52DEADですが、似たような色合いでも大丈夫です。お好きなように描いてください。ご検討のほど、よろしくお願いいたします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uzurao_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2217585, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9c7a727/uploads/origins/b0399fdf-8d5b-497b-b73f-2bb77e07a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85001ed24f94abc45a71f7fa0db2c6ca", "srcset": "https://si.imgix.net/d9c7a727/uploads/origins/b0399fdf-8d5b-497b-b73f-2bb77e07a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85001ed24f94abc45a71f7fa0db2c6ca, https://si.imgix.net/d9c7a727/uploads/origins/b0399fdf-8d5b-497b-b73f-2bb77e07a008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca7ffb0f18f753b568063a66465355d7 2x, https://si.imgix.net/d9c7a727/uploads/origins/b0399fdf-8d5b-497b-b73f-2bb77e07a008?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=444e5c8317b4cecc5ddc4ad6d2cd775d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9c7a727/uploads/origins/b0399fdf-8d5b-497b-b73f-2bb77e07a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b543d94caa360ef4af7d5bb0bba3022", "srcset": "https://si.imgix.net/d9c7a727/uploads/origins/b0399fdf-8d5b-497b-b73f-2bb77e07a008?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b543d94caa360ef4af7d5bb0bba3022, https://si.imgix.net/d9c7a727/uploads/or