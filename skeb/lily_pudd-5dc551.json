ogle.com/file/d/1sZUKhvfbqg2i4e5-hFLYRDUXFiTP4Vfa/view?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lily_pudd/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 2861661, "client_id": 2879721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7598efe2fe1e0dbfc8dada9f1ee24d2", "srcset": "https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7598efe2fe1e0dbfc8dada9f1ee24d2, https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ada191b94d85fba8db017b59030d292 2x, https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccf95b9e30e13dd34bf912208a532e9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f85b137f307b8a75abbd53c1dcd4f7af", "srcset": "https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f85b137f307b8a75abbd53c1dcd4f7af, https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f75dad1eb82371efca142349050037f 2x, https://si.imgix.net/e55773ab/uploads/origins/44a6aeb4-da0d-47c0-ab42-44d76068bf57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db51be86361f5c221c878a53bbf04bed 3x"}, "body": "一応youtubeとかでいろいろな塗り等勉強はしているのですがラフまではうまく描けてる気がしても線画にしてみたり色を塗ってみたりするとうまく描けてないなと感じます。\n線画までの苦手なところは髪の毛や服のしわ最近描いた絵ではしっぽや耳かきの綿などまた、手の形などとにかく顔以外が難しくどうバランスを取ったらいいかわからないです。特に動きのある絵を描けないので動きを出すためにバランスをあえてくずしてみたりとかの手法がありましたら教えてほしいです。\n塗りになると本当に難しく、質感を出せないのはもちろんのこと、下色を置いてからの影がどこにどうかかるのかが、特に服系が全く分かりません。また影の色の選び方などいつも悩んでしまいます。そして、髪の毛のハイライトの入れ方が難しくてイラストを見てると自然なハイライトが落ちていてそれを勉強して自分の絵でやろうとしても違和感のある感じになってしまいます。どういうことを考えてハイライトを入れればいいのでしょうか。。。\n背景は全くできません。とくに夜空とかはある程度誤魔化しているつもりではあるのですが物体を描くことができません。パース定規を使って一応パース通りに描いているつもりではあるのですが質感もつかめなければまっすぐな線を引きたくて直線ツールを使って描くと無骨な感じになってしまいます。自分なりに書き込んでみて質感を出そうとするとイラストになじまないような背景になってしまいます。どんな風にすればイラストになじむような背景にできますでしょうか。\n\n\n文章を作るのが苦手で長くて伝わりにくいと思うのですが僕の今悩んでいる点です。アドバイスぜひお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@3Yjd9fatSW/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3659676, "client_id": 2861661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19a11246/uploads/origins/7b8a8e3a-1931-4842-bbae-2cfe85499ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1db2845e01aba608b9765e5d04f85d4", "srcset": "https://si.imgix.net/19a11246/uploads/origins/7b8a8e3a-1931-4842-bbae-2cfe85499ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1db2845e01aba608b9765e5d04f85d4, https://si.imgix.net/19a11246/uploads/origins/7b8a8e3a-1931-4842-bbae-2cfe85499ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3faeb0bd35c251c424f1d8d605fd3e74 2x, https://si.imgix.net/19a11246/uploads/origins/7b8a8e3a-1931-4842-bbae-2cfe85499ed7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbef180c1233170e3a78b1e0a7ddee45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thum