ゴのイラストのような雰囲気、可愛い感じでお願いします。\n書き込んでいただきたいです。\n屋台でよく売っている飴なので、すこし飴のところがテカってる感じを出して貰えると凄く嬉しいです。\nレースやフリルなども沢山つけてくださると嬉しいです。\nキャラデザを凝っていただきたいです\n構図はバストアップで、\nポーズや容姿などは、お任せします…!\n好きなように書いて頂ければ……！🙇‍♂️🙇‍♂️ Youtube等に投稿するため、クレジットはあるものとないものがあると助かります……！\n\n\n\n\nよろしくお願い致します。🙇‍♂️", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aoao_suke_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1123655, "client_id": 229258, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcffab1c/uploads/origins/8c0d590a-5e5a-4450-b8da-72af7a95b035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c73a2d6bf44c4e10a7c49237868db2a", "srcset": "https://si.imgix.net/fcffab1c/uploads/origins/8c0d590a-5e5a-4450-b8da-72af7a95b035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c73a2d6bf44c4e10a7c49237868db2a, https://si.imgix.net/fcffab1c/uploads/origins/8c0d590a-5e5a-4450-b8da-72af7a95b035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15c2cac2f4625a5956154d6b2f79bb2e 2x, https://si.imgix.net/fcffab1c/uploads/origins/8c0d590a-5e5a-4450-b8da-72af7a95b035?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=697eb1b66b2df2a1b5f9515924d071dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcffab1c/uploads/origins/8c0d590a-5e5a-4450-b8da-72af7a95b035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c73efcdc6f26cd7fdafdceada1b9205c", "srcset": "https://si.imgix.net/fcffab1c/uploads/origins/8c0d590a-5e5a-4450-b8da-72af7a95b035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c73efcdc6f26cd7fdafdceada1b9205c, https://si.imgix.net/fcffab1c/uploads/origins/8c0d590a-5e5a-4450-b8da-72af7a95b035?bg=%23fff&auto=format%2Ccompress&fm=webp&