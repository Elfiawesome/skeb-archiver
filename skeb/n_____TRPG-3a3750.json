le.com/drive/folders/1yDFFjtp_28U30oyebvAhP6KAPiWyOfUy?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n_____TRPG/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3551032, "client_id": 3768449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22829171eabf08358e9198a05b949f99", "srcset": "https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22829171eabf08358e9198a05b949f99, https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bfb26327de824d9a326fdb23f0aac93 2x, https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b60d9b375104674ebb1babe202168e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03dd3c9d1b1114fefc0ed64b7de61cd4", "srcset": "https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03dd3c9d1b1114fefc0ed64b7de61cd4, https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f66cf3e6c628ba84bd642a31967f69e 2x, https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=