a2be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=825298b80fff66b21d6a417378e3b366", "srcset": "https://si.imgix.net/1a9a5b15/uploads/origins/f224ad1c-d37f-4f84-ad1a-519eb47a2be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=825298b80fff66b21d6a417378e3b366, https://si.imgix.net/1a9a5b15/uploads/origins/f224ad1c-d37f-4f84-ad1a-519eb47a2be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d8bc7a3b1af54343e924be600ffd5a7 2x, https://si.imgix.net/1a9a5b15/uploads/origins/f224ad1c-d37f-4f84-ad1a-519eb47a2be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31fe143b0e3853e7c06e53d8a2f11dd7 3x"}, "body": "こんにちは！！タイムラインで素敵な作品を見かけて、どうしてもお願いしたくて来ました！この二人の青年は私と友人のオリジナルキャラクターです！背景情報を少しお伝えしますので、あとは全てお任せします！マコラ：マコラは優しく穏やかな青年で、いつも笑顔を絶やしません。\nかつては悲観的でしたが、イルマとの出会いによって人生と自身の魔法能力に対する新たな視点を得ました。今では意志がずっと強くなっています。マコラは創造的な魔法使いに囲まれた小さな村に住んでいます。彼は独自の魔法能力を持ち、想像した世界の代替バージョンを描き出し、そこへ入り込むことができます。ただし、単独でしか入ることができず、同じ世界へ二度と戻ることはできません。 \n\nイルマ：不治の病を患いながらも気楽な性格の青年で、旅を愛している。貴族の裕福な家庭に生まれ、守られて育った。町の港で通り過ぎる旅人の話を聞くのが日課だった。ある日家出をし、偶然マコラの村にたどり着いた。マコラと出会い親しくなった後、最期を迎えるまで彼と共に過ごすことを決意した。\n\nイルマは鳥や彼らが拾う小物をこよなく愛している。気さくでマコラの魔法に興味津々！イルマはマコラに「自分と魔法に価値がある」と気づかせてくれた。二人は互いに深く愛し合っていた。イルマが逝った後、マコラは力を使って様々な世界へ旅立ち、イルマと幸せになれる世界を探す決意をする。\n\n\n繰り返しになりますが、お好きなように描いてください！どんな表現でも構いません！リクエストにお応えできない場合は遠慮なくお断りください！ありがとうございます！！https://drive.google.com/drive/folders/1yDFFjtp_28U30oyebvAhP6KAPiWyOfUy?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n_____TRPG/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3551032, "client_id": 3768449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/895210c8/uploads/origins/b35d061b-87d1-406e-bddb-4e2d654b7e33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22829171e