85b0-28a447a3321e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe67e0fcf57adaa683194f848e6615d9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2c5f75e/uploads/origins/dddc74ee-ecdc-4335-85b0-28a447a3321e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0d143428cdc96b9fb759f7063c10fea", "srcset": "https://si.imgix.net/e2c5f75e/uploads/origins/dddc74ee-ecdc-4335-85b0-28a447a3321e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0d143428cdc96b9fb759f7063c10fea, https://si.imgix.net/e2c5f75e/uploads/origins/dddc74ee-ecdc-4335-85b0-28a447a3321e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8cb9af35d98a577b6d656aa0c663921d 2x, https://si.imgix.net/e2c5f75e/uploads/origins/dddc74ee-ecdc-4335-85b0-28a447a3321e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08b7918ace53b9a925712fcd13c6d28c 3x"}, "body": "アーモンドマン先生、はじめまして。\nFanbox等でイラストを拝見させていただいております。\n\n以下のようなキャラ・内容でショート漫画を描いていただければと思います。ご検討をお願いします。\n\n【キャラ】\n●羽川ハスミ（ブルーアーカイブ）\n※先生の以前のPixivでの投稿（https://www.pixiv.net/artworks/111299008）のような展開の後に媚薬漬けにされて常時発情状態にされ、政財界を裏から牛耳る大物（適当）に性奴隷として売り飛ばされてしまうという設定でお願いします。\n※衣装はこちらも先生が以前Pixivで投稿されていた水着（資料URL）でお願いします。\n●竿役（政財界の大物おじさん）\n※いかにもな竿役おじさんです。一人称は「わし」で、権力者だけあって態度は傲岸不遜な感じです。肥満体ですが、精力剤などを服用しており絶倫です。また、増大術によりイボ付き（真珠入り）のカリ高巨根の持ち主です。NGでなければ毛深い感じにしていただけると嬉しいです。\n\n【内容】\n①おじさんに買われたハスミが卑猥な服装で現れる。\n②喜ぶおじさんに「心まではあなたのものにならない」と言い放つハスミだが、媚薬漬けの体は少し触られただけですぐ絶頂してしまう。\n③「前戯の必要もない」とおじさんはセックスを始めようとする。おじさんの巨根に驚くハスミだが、絶頂したばかりの体では逃げることもできずに挿入される。\n④そのままいいように犯され、何度も絶頂させられるが、おじさんの「わしの物になれ」という言葉には首を縦に振らない。\n⑤おじさんは「そんな強情な娘にはお仕置きだ」と、子宮の中にまで巨根を突き入れる（NGでなければ、断面図付きの子宮姦描写があると嬉しいです）。子宮を犯され、あまりの快感についに陥落したハスミが性奴隷になることを宣言する。おじさんが「褒美をやる」と言って子宮内に直接射精し、ハスミは本日最大の絶頂を迎える（最後に何か事後の構図があると嬉しいです）。\n\n可能であればアへ顔・オホ声・仰け反り絶頂などもありで、おじさんに無様に犯されるハスミを描写していただければと思います。細かい部分の台詞・構図についてはお任せしますし、上の内容についても不自然な部分があれば改変していただいてかまいません。\nおバカな設定で恐縮ですが、もし条件が合いましたら是非よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/106340991", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@almondnuts117/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1377086, "client_id": 398441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=396f65e0f28bde7ee8f22c222a162b02", "srcset": "https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=396f65e0f28bde7ee8f22c222a162b02, https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e8135aedbe821c8e2b6c2acec4fefc5 2x, https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=458d4bc529ef2c0de55ec95b7cb19fbf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4115f2dd3ee9834107ec39b0d7b765d1", "srcset": "https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4115f2dd3ee9834107ec39b0d7b765d1, https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f77541bd7095ea2cfec8dcaf656176d 2x, https://si.imgix.net/e92e3899/uploads/origins/8fd7d8a1-a45a-4907-ab3a-82b1833a2699?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85d6a83f6652e3a8c33fb44553fd9a1f 3x"}, "body": "ブルーアーカイブの搾乳イラストをリクエストさせて頂きます。\nキャラは羽川ハスミ(髪型は体操服verのロングポニテ)でお願いします。\n\n・服は牛タイツ、牛グローブ、牛耳とツノ付きカチューシャ、ベル付き首輪でお願いします。\n・構図体位は(https://www.pixiv.net/artworks/104644200)のイラストのようなハの字開脚後手拘束で、もう少しだけ正面寄りの視点でお願いします。\n　横長のイラストでお願いしたいです。(縦のほうが長くなければ大丈夫です)\n・牛用の少し細長めの透明な搾乳機をつけられた長乳から母乳を搾られる。乳首は常に見えるようお願いします。\n　ハスミの左右には上側から搾った母乳が出て溜まる母乳タンクが置いてあり、そこに母乳が溜まっていく感じでお願いします。\n・搾乳前の胸、搾乳機を付けられる胸と取り付ける男の腕、搾乳機に母乳を吹き出す胸、さらに母乳を吹く胸と母乳の溜まったタンクの差分をお願いします。\n　また表情もプレイに合わせたものをお願いしたいですが、射乳時はオホ顔と歯を食いしばったんぎぃ顔でお願いしたいです。\n・できればで良いのですが柵に囲まれているとか牛舎のような家畜感強めの場所にいる雰囲気でお願いします。\n・搾乳に特化したいので性交描写はなしで。搾乳機を付ける手以外の男要素は極力省いて頂いて大丈夫です。\n・擬音や効果などもあったら嬉しいですが有無はお任せします。\n\n以上になります、ご検討よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/104644200", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@almondnuts117/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1377086, "client_id": 127447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7dc13ead/uploads/origins/b3e6067a-1c40-4a6b-9a43-60343a967444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f137bdbe5fbf9da5aff1eac4dbe9958b", "srcset": "https://si.imgix.net/7dc13ead/uploads/origins/b3e6067a-1c40-4a6b-9a43-60343a967444?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f137bdbe5fbf9da5aff1eac4dbe9958b, https://si.imgix.net/7dc13ead/uploads/origins/b3e6067a-1c40-4a6b-9a43-60343a967444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=254f0dbe6dc6797bf29e484621db3591 2x, https://si.imgix.net/7dc13ead/uploads/origins/b3e6067a-1c40-4a6b-9a43-60343a967444?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4cc354989e359bb23ef543ec7bbda8cc 3x"}, "duration": null, "nsfw": true, "hardcore": f