crop=top&w=200&h=200&blur=200&s=65344b9062f9be58d58de52890f74cb6, https://si.imgix.net/c0a8cd9f/uploads/origins/636f0465-43d2-4f60-9455-81df820278ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18dc096523d2b907b996398ebb51fc4b 2x, https://si.imgix.net/c0a8cd9f/uploads/origins/636f0465-43d2-4f60-9455-81df820278ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0970f800f8771aef8481aa7bac857b5f 3x"}, "body": "こんにちは。\nPCの壁紙用のイラストをお願いしたいです。（現在の環境は2304px×1296pxです）前回のイラストも大変気に入っているのですが少し気分を変えたくて今回お願いさせていただきました。\n黒色をメインとしたグラフィックで、赤色と黄色を含めていただけないでしょうか？\n赤と黄色の色味やその他の色に関しましてはお任せいたします。\n\nリクエスト受けていただけましたら大変嬉しいです。\nよろしくおねがいします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@co12n_m/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2085359, "client_id": 2034920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=898eb33fde39050539041aaa138fd653", "srcset": "https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=898eb33fde39050539041aaa138fd653, https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=beaf2e285ac4d84360962aae0758b0c2 2x, https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78192a5a7ab80a9fa65d19cdf439a1bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=741edad7ca7709842f6983d199f2b513", "srcset": "https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=741edad7ca7709842f6983d199f2b513, https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7faaa3bc3480b35b5365348eddd7152a 2x, https://si.imgix.net/a5fc7544/uploads/origins/c1d2dbc1-44a0-42be-a7fc-1f130d507e2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcd059ead2b9ce2bc39720f02e5d45d2 3x"}, "body": "はじめまして！アトリモコと申します。\nいつも鍵垢からこっそりとmove nao様の作品を拝見させていただいています。\n数年前にされていた音楽のファンアートのシリーズが大好きでして、クランベリーとパンケーキや白日の絵が特に大好きです…！\n\n一度skebをお願いしたいと前々から思っていたのですが、今回タイミングが合いましたのでリクエストのほどお送りさせていただきます！\n描きにくい・この金額では難しい等あれば遠慮なく差し戻していただければと存じます。\n\n【リクエスト内容について】\n・「薄暗い海・海辺」のイメージでイラストを制作していただきたいです。\nきらきらした明るい海のイメージよりかは、これ以上足を進めれば死んでしまうことがわかっているけれど、でもそうなってもいいと思えるような、暗くおだやかな海のイメージでお願いしたいです。\n（楽曲としてはサカナクション「ナイロンの糸」のPVのような色味や世界観が好きです）\n・部屋にポストカードやポスターとして飾れたらいいなと思っています。\n・それ以外のことについては要望ございませんので、move nao様の解釈や好きなテイストでお願いできればと存じます。\n\nskebをご依頼する側で利用するのが初めてなので、もし失礼がありましたら申し訳ございません。\n今後ともmove nao様の作品を楽しみにしています！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@co12n_m/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2085359, "client_id": 2309457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6db8dcd4/uploads/origins/c9562b00-e574-4871-8bb5-63085ff84bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9060c0db851b3cdde8dd41a0033aa03a", "srcset": "https://si.imgix.net/6db8dcd4/uploads/origins/c9562b00-e574-4871-8bb5-63085ff84bcf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9060c0db85