なくほぼおまかせになるかと思います…お手数お掛けいたします)\n\nhttps://drive.google.com/drive/folders/18iC2NgQWV6SWKWJRYqG60jjUCN3cf8Mq", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 8500, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Watapiki@CottonClub", "screen_name": "Watapiki", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:srredri7z2j55tmt3jkvkh4t/bafkreif3rwkjr3ooljftqrubayhcfii5wtkn5wzdatz5zpel7uq5dpm6p4", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:srredri7z2j55tmt3jkvkh4t/bafkreidqzy53ky5uqhs6bmn3nxf75ibncvrmlaxlqggpflmhszcb3fwoy4", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2616033, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鯔背わや", "screen_name": "hu_nhey", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fc6bee8c4-a14b-4c84-8654-fc681dd01c4b.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/e386596e-44c0-401c-a2b3-52d64770b39c.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2634511, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴ", "screen_name": "pchandayo_", "avatar_url": "https://pbs.twimg.com/profile_images/1734525854007582720/PgjMa983.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1733484939365289984/1748775944/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "reques