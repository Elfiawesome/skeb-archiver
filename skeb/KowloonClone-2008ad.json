FF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a8cb9f8204441639c72f7480b2cbb40 2x, https://si.imgix.net/2d68da95/uploads/origins/e095da62-6be4-4a26-85bb-56c0e945d9bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e9ebd41322a34de18c2304baf6081cf 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 503166, "nc": 177}, {"path": "/@KowloonClone/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 503166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce8f4c1991ec817079ab6bbd31e77545", "srcset": "https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce8f4c1991ec817079ab6bbd31e77545, https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b543cae5d3c09df3cb5539775bb0ecbd 2x, https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9af790b60630b4487e3435aafc9c91b8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa2f5e939de76795dc4126e73396a5a", "srcset": "https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa2f5e939de76795dc4126e73396a5a, https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56a83557c323d22ba6adc4c9ff57ef9b 2x, https://si.imgix.net/3583bbb2/uploads/origins/ab187d88-7e93-4765-a798-1fe9b8b75756?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06151bbf38614c315fc998574a43094e 3x"}, "body": "前回は淫妖蟲のキャラでとても素敵なイラストを描いて頂き誠にありがとうございました。\n早速で申し訳ありませんが…今回キャラは淫妖蟲ではありませんが、同じような展開から続きに当たりそうな感じの変態イラストを描いて欲しいです。\n※ 以下情報量が多くて申し訳ありませんが、内容的に難しければキャンセル頂いて構いません。\n\n●キャラ\n「僕は友達が少ない」より羽瀬川小鳩\n（参考画像：https://www.cospa.com/images/items/pc/79744.jpg）と、「織田信奈の野望」より竹中半兵衛（参考画像：http://odanobuna.com/character/img/chara_color_09.jpg）\n\n●概要\n触手空間でこの2人が超絶変態肉体改造を施された後…\nまず乳を幼い身体に不相応な超乳サイズに膨らませられ太長乳首を有し、合計4本の乳首をまとめて竿役の馬モンスターに強烈に吸引されて快楽射乳（馬モンスターの口元から母乳が溢れている感じ）するところと、お互いの子宮を1つに合体させられ変態融合マ●コ化し、特大馬チンポを融合マ●コに挿入され下から突き上げられ臍から馬モンスターの赤ちゃんを産み人外レベルの快楽絶頂を受け激しく悶絶しているシーンのイラストを描いて欲しいです。\n\n●衣装や体型など\n・どちらも全裸の状態（ツインテについているフリルや髪留めは描写をお願いします）から2人共に乳のデカさと乳首のデカさはそれぞれ、https://skeb.jp/requests/524087\nで描いて頂いた左の桃野李レベルの超乳及び太長乳首のサイズでお願いします。\n竿役も同じ馬モンスター（ナイトメア）で真ん中の奥側にいる感じでお願いします。\n※馬モンスターの表情はお任せします。\n\n・お腹は出産の瞬間を描いて欲しいので臨月腹でお願いしますが、お腹の膨らみ具合は2人の超乳を全て足したくらいの特大サイズでお願いします。臍も1つに合体し真上を向いているようにお願いします。大きさについて、イラストの構図上難しい事があれば調整して頂いて構いません。\n\n・融合マ●コに挿入されているチンポのデカさは女体の対比についてhttps://www.pixiv.net/artworks/96783772#big_1\nくらいの特大サイズで、チンポに真下から突き出された影響で臍マ●コから人外モンスターを出産する感じでお願いします。\n※https://twitter.com/tentacles_love/status/1098578798096740352?s=20&t=5YlPpuz9r3eYhu0TAIBwOw\nの画像4枚目の馬モンスターを臍マ●コから産む感じで。\n\n●背景や構図など\n・小鳩と半兵衛が左右ほぼ真横に向かい合わせで、お互い両手は自分達の母乳をご主人様の馬モンスターに吸って欲しくて太長乳首を握ってる感じでお願いします。\n（可能なら小鳩と半兵衛が両目まで辛うじて見えている具合で）\n両足は触手に拘束されている感じでお願いします。\nそして正面向かって左側が小鳩、右側が半兵衛でお願いします。\n\n・融合マ●コ化の参考イラストは某所でお見せした通り、https://mesudoreidaisuki.com/storage/uploads/images/shinyakuinyouchuu2.jpg\nのような感じでお願いします。（こちらは床にもたれる感じになっていますが、今回希望するのは左右真向かいな感じでお願いします。）\n※エフェクトとして八卦のような紋様が浮かびあがってる感じも可能ならお願いします。\n\n●表情について\n小鳩と半兵衛両方とも、https://www.pixiv.net/artworks/96735348#big_0\nのように両目を見開いてだらしなく舌出ししている感じでお願いします。\n※両目の見開きはもう少し強め、舌も目一杯出してヒーヒー言わせてる感じでお願いします。\n\n●その他\n・臍出産に関する参考画像：https://mesudoreidaisuki.com/storage/uploads/images/shinyakuinyouchuu7.jpg\n\n以上となります。\n長くなり申し訳ありませんが、ご確認をどうぞ宜しくお願いします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KowloonClone/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6a37bc6/uploads/origins/a32b5564-0579-4972-8e73-4ecf5d11d759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=376fd7295072171ede47918f6c7913fc", "srcset": "https://si.imgix.net/a6a37bc6/uploads/origins/a32b5564-0579-4972-8e73-4ecf5d11d759?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=376fd7295072171ede47918f6c7913fc, https://si.imgix.net/a6a37bc6/uploads/origins/a32b5564-0579-4972-8e73-4ecf5d11d759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fdd3beb79a4af39e9c8e711ed86d9da0 2x, https://si.imgix.net/a6a37bc6/uploads/origins/a32b5564-0579-4972-8e73-4ecf5d11d759?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c0a2c819c791270cdf85d4385a780b2 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 503166, "client_id": 51575, "nc": 49}, {"path": "/@KowloonClone/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 503166, "client_id": 313621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6eafee5/uploads/origins/d776862e-7b3a-41f1-97d0-f67c1edaae23?bg=%23fff&auto=format%2Ccompress&fm=webp&fi