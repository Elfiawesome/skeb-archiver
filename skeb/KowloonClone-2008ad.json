s/6001950f-c0bc-4b3e-b4df-0265f72dfed1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a071db9def37416bc56922692fe93af 2x, https://si.imgix.net/83f93c9c/uploads/origins/6001950f-c0bc-4b3e-b4df-0265f72dfed1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=917f6723b3b3534a293ea30fb8ed3045 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83f93c9c/uploads/origins/6001950f-c0bc-4b3e-b4df-0265f72dfed1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b93b60af1b14bfc72d83ff7642b2e113", "srcset": "https://si.imgix.net/83f93c9c/uploads/origins/6001950f-c0bc-4b3e-b4df-0265f72dfed1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b93b60af1b14bfc72d83ff7642b2e113, https://si.imgix.net/83f93c9c/uploads/origins/6001950f-c0bc-4b3e-b4df-0265f72dfed1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51a0f87c43dacce896c710b555023788 2x, https://si.imgix.net/83f93c9c/uploads/origins/6001950f-c0bc-4b3e-b4df-0265f72dfed1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0096334c2bc8aca2ea991c2b25f4af07 3x"}, "body": "以下のようなストーリーを依頼したい。\n\nキャラは大崎姉妹でお願いします\nURL:甘奈(https://shinycolors.idolmaster.jp/idol/alstroemeria/amana.html\n          甜花(https://shinycolors.idolmaster.jp/idol/alstroemeria/tenka.html\n\n深夜、オフィスを出た大崎姉妹は、暗い道で宇宙人に連れ去られる。\n気がつくと、二人ともふたなりに変わっていた。\n宇宙人は生殖実験を行いたいと言っていた\n\n宇宙人は甘奈のチンコに宇宙人のような寄生虫Aをつけた。\nパラサイトAはすぐに開口部から甘奈のチンコを貫通させ、甘奈はオーガズムに満ちた表情を浮かべる。\n\n甘奈は影響を受け、精子を求めて必死になり、チンコは寄生虫Aによって徐々に変化していく。\n甘奈は顔を真っ赤にして、壁に縛り付けられた甜花に近づいていく。\n\n甜花は怯えた様子で、甘奈を起こそうとする。\n甘奈は甜花のチンコを自分のチンコに挿入し（資料1）、二人の姉妹は同時に絶頂に達する。\n\nこの時、甘奈の金玉から針状の小さな触手が複数出て、甜花の金玉を貫き、甜花の金玉に媚薬と成長液を大量に注入し始める。\n\nこれにより、甜花の金玉は精子を生産し、急速に拡大する。\nオーガズムを表現する甜花の表情\n\n同時に甘奈と甜花のチンコが融合する（資料2）\n甜花は大量の射精を開始し、甘奈の金玉に大量の精子を射出し、甘奈の金玉を徐々に拡張させる。\n\nしばらくすると、甘奈の金玉のエイリアンが生成され、2体が合体して、2つの頭と3つの巨大な胸と4本の腕を持つふたなりになり、巨大なチンコが成長します。\nチンコから大量のエイリアンと精液が排出される。 (参考文献3)。\n\n寄生A:ユムシ(https://ja.wikipedia.org/wiki/%E3%83%A6%E3%83%A0%E3%82%B7)\n\n(参考文献1):https://www.pixiv.net/artworks/76748704\n            https://www.pixiv.net/artworks/95734627\n            https://www.pixiv.net/artworks/84112769\n\n(参考文献2):https://www.pixiv.net/artworks/91824924\n\n(参考文献3):https://www.pixiv.net/artworks/86462495", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KowloonClone/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c6513151/uploads/origins/d915d2f5-54ff-4e97-8795-5437865b5b23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79af74e662044f3179e91ce670b12365", "srcset": "https://si.imgix.net/c6513151/uploads/origins/d915d2f5-54ff-4e97-8795-5437865b5b23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79af74e662044f3179e91ce670b12365, https://si.imgix.net/c6513151/uploads/origins/d915d2f5-54ff-4e97-8795-5437865b5b23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7309710e2fb3b1ddcc99157432394b7c 2x, https://si.imgix.net/c6513151/uploads/origins/d915d2f5-54ff-4e97-8795-5437865b5b23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d963dac27e659703d26e3ad69da0234d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 503166, "nc": 35}, {"path": "/@KowloonClone/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/55895373/uploads/origins/bde9e4e2-6d12-4287-9d35-f742e4f8147f?bg=%23fff&auto=forma