be等の配信活動やSNSでの使用があるかもしれませんので、許可をいただけると幸いです。\n　　（配信サムネイルへの利用やSNSでのプロモーション活動等）\n\n\n　・三面図は公開されておらず、\n　　Twitterで公開されている画像を資料URLに格納いたしますので、\n　　容姿や服装について必要であればご確認ください。\n　　資料URL：https://drive.google.com/drive/folders/1EnItCFZDaz9k5tmZ8p2MUF4P7P4N9ECN?usp=sharing\n\n以上、お忙しいとは思いますが、何卒ご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miyai_max/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1358290, "client_id": 179692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d50d890/uploads/origins/d916872f-4a09-437c-ab8a-d9f8cf5251a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d85348eb91058ca96bf0e1f1d87c50", "srcset": "https://si.imgix.net/8d50d890/uploads/origins/d916872f-4a09-437c-ab8a-d9f8cf5251a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d85348eb91058ca96bf0e1f1d87c50, https://si.imgix.net/8d50d890/uploads/origins/d916872f-4a09-437c-ab8a-d9f8cf5251a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25b63ed1aefe3388db2c1c07cbfb55ce 2x, https://si.imgix.net/8d50d890/uploads/origins/d916872f-4a09-437c-ab8a-d9f8cf5251a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f6f2bd3d18b7a472d59ee441532e9d7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d50d890/uploads/origins/d916872f-4a09-437c-ab8a-d9f8cf5251a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eef24678f9f4f7885472da1cb926d599", "srcset": "https://si.imgix.net/8d50d890/uploads/origins/d916872f-4a09-437c-ab8a-d9f8cf5251a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eef24678f9f4f7885472da1cb926d599, https://si.imgix.net/8d50d890/uploads/origins/d916872f-4a09-437c-ab8a-d9f8cf5251a3?bg=%23fff&auto=form