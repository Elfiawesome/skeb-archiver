b5141556/uploads/origins/c515466f-b44d-4ac2-a17e-d87924bfa5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=377819fd98afd95f19eb80e93b2bd31d", "srcset": "https://si.imgix.net/b5141556/uploads/origins/c515466f-b44d-4ac2-a17e-d87924bfa5be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=377819fd98afd95f19eb80e93b2bd31d, https://si.imgix.net/b5141556/uploads/origins/c515466f-b44d-4ac2-a17e-d87924bfa5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14b84ba739088952af30051e5cc402cb 2x, https://si.imgix.net/b5141556/uploads/origins/c515466f-b44d-4ac2-a17e-d87924bfa5be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af6408d95b7cc73f3e9756435cf3f1f3 3x"}, "body": "風花うろこ様\n\nいつもお世話になっております。\n早速なのですが今回は、性癖に刺さりまくった『バニーガールうろこちゃん』を描いていただきたく。\n\n衣装なんですが、色変更よろしいですか？\n・バニースーツ本体はうろこちゃんのイメージカラーのミント？グリーン系\n・黒網タイツは通常の白タイツに\n（バニースーツとタイツの色を交換しても面白いかも...？）\n\nポーズや表情はお任せ...とさせてください。\n個人的にはうさ耳ポーズとか可愛くて好きです。\n描きやすい様に描いていただいて構いません。\n背景特に書き込みは問いません。以前描かれていたあわわちゃんの背景が考えているイメージに近いですね。\n\nPC壁紙(16：9)に使用したいな〜と考えてます。\n\n以上、よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uroco_kazabana/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2765771, "client_id": 2732972, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6fc740ad47cc4375f2a135632cde84", "srcset": "https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b6fc740ad47cc4375f2a135632cde84, https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6b8a1eb37d284ba2a4a24fbcfa26b57 2x, https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a252bd68dbc50c8a30308c8f5373554d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=177ff69e84b9418b6ff9b6f442dbc179", "srcset": "https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=177ff69e84b9418b6ff9b6f442dbc179, https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ebce8f086439aeb3564ca268a35227d 2x, https://si.imgix.net/ab3046b8/uploads/origins/f8b91bdb-c698-4d01-b8ec-05650d9537b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30a994fcf5656a6cfc3758d98812cbb7 3x"}, "body": "こんにちは、Takachihoと申します。\nVtuberの羽純ゆのさんのイラストをお願いしたいです。\n\nポーズや衣装、背景などの詳細はお任せしますが、1周年と誕生日のお祝いを兼ねたイラストのため、皆から祝福されているような温かな雰囲気でお願いしたいです。また、公式と別の衣装にされる場合は、イメージカラーが白のため、それに準じた色でお願いしたいです。それから可能であれば、イラストの上部、または左上等に羽純ゆのさんの名前（ローマ字でも可）と『1st Anniversary ＆ Happy birthday』等の文字を入れたデザインにしていただけると嬉しいです。\n\nファンアートとして利用したいので私個人や羽純ゆのさんによるSNSでの公開、利用や、Youtubeでの利用の許可と、キャラクターのみの透過画像もお願いしたいです。また、オンライン寄せ書きヨセッティでの使用と、そのサービスを使って寄せ書きへプリントして羽純ゆのさんに贈ることの許可もいただきたいです。\n\nヨセッティで使用する際、縦横600px以上の正方形での画像のアップロードが必要なため、それ用の画像もいただけるか、もしくは私個人によるそれ用に限りトリミング等の加工の許可をいただきたいです。\n\n金額面で問題があれば再送要請をお願いします。\nご検討よろしくお願いいたします。\n\n参考（公式画像、三面図）\nhttps://twitter.com/HasumiYuno/status/1584515071350566913", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uroco_kazabana/works/2", "private_thum