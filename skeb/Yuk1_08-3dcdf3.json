\n構成\n創作の自由はあなたに委ねます。\nできればかわいらしさを強調してほしい。\n\n用途\n\nYouTubeライブ配信／動画／コミュニティ投稿サムネイル\nSNS（X（旧Twitter）、Bluesky）への投稿\nプロフィールサイト（Lit.link的プラットフォーム）への投稿\n使用にはクレジットが必要です。\n\nhttps://drive.google.com/file/d/1L1oZhecaQh-27syDbaNVX7OWHDFqi38V/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Yuk1_08/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3779324, "client_id": 3714552, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59bca6735bac6f0a3dd5e3f6c4a0dd30", "srcset": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59bca6735bac6f0a3dd5e3f6c4a0dd30, https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3faa1542c01817f20d172883376b0f6 2x, https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41a568806d5d05ce1b3a285d8fcec349 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401a9e65fa7d639d7ac917727946f381", "srcset": "https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=401a9e65fa7d639d7ac917727946f381, https://si.imgix.net/ad449299/uploads/origins/3baf706e-d32c-498d-8e08-6a5decb790d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&