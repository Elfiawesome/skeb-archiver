ださい。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1dD5NDG5t-wni1FjjTLv0FDSjtqf-NWhk?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisekidia/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2615451, "client_id": 2496524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3fe25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa54c3cc3af0ef06a43ea7f0068a3c05", "srcset": "https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3fe25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa54c3cc3af0ef06a43ea7f0068a3c05, https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3fe25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=627bb91228db52c2a1e8aa811f338305 2x, https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3fe25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=060a78660358bf3ebc172adea7d33616 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3fe25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd820dce7f8f279b0f28f35408f84183", "srcset": "https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3fe25a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd820dce7f8f279b0f28f35408f84183, https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3fe25a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f56d653cd80199fcbe0a1879b2704ab9 2x, https://si.imgix.net/cb596634/uploads/origins/c7f17f59-2abf-40e0-8f1d-cdfb3c3