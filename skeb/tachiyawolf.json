amount": 1000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 9, "received_works": [{"path": "/@tachiyawolf/works/114", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 503745, "client_id": 3198091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bd43548/uploads/origins/5f479cb9-8daa-44f5-930b-91efe822a274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=144718eac3edd509c5eb2d84d697d61e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bd43548/uploads/origins/5f479cb9-8daa-44f5-930b-91efe822a274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6907738bcfb8771bc31e4f3d81215bd2", "src_set": ""}, "body": "タチヤ先生ぇー🐺\nお仕事お疲れ様です🐺\nめちゃくちゃ暑いので小まめに水分補給して下さいね🐺\nタチヤ先生ぇー🐺\nイラストはタチヤ先生ぇーにお任せします🐺✨️", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tachiyawolf/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 503745, "client_id": 2349999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f77923a/uploads/origins/44a87810-5810-4cb3-9df1-84eeb0979421?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e479b437130997e38dc48daadd823e2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f77923a/uploads/origins/44a87810-5810-4cb3-9df1-84eeb0979421?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77e598571f4be2b3652ced0b41a4c0dc", "src_set": ""}, "body": "ぐみうみさんばだよ…あんなあんな、俺とたちゃくん、かふちゃ、あとちゅろちゃがな、楽しそうにしてるイラストを描いて欲しいんだ。出来ればもっと色んな人を入れたかったけど、でもお金がな…\nコマ割りもお任せしたいんだけど、横長のでっかいコマが1つあると嬉しい……\nシーン的には、みんなで何かのテレビゲームを遊んでるみたいな感じのシーンだと嬉しいんだ… 桃鉄とか、マリパとか、スマブラとか、何らかの対戦ゲームで、俺は負け続けて、見える形の罰ゲームを喰らいまくりながらも諦め悪く足掻いてる感じだと嬉しい。他の人はおまかせでいいかな。俺はいつものシキくんグラサン抜き桜角あり、で、みんなの姿はたちゃくんにおまかせでもよろしいか…\n\n分かりにくいクソみたいな依頼文だけど、どうかよろしくお願いします…", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tachiyawolf/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 503745, "client_id": 1169309, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fb7a610/uploads/origins/7aa47043-642b-4dc9-954f-4c462cdf903e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c810a21a2b72b5cd49e4d163f1a5eb35", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fb7a610/uploads/origins/7aa47043-642b-4dc9-954f-4c462cdf903e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=122f34cbd603996d51faa6cd5e4bff0a", "src_set": ""}, "body": "Tach8さんこんにちは。\nいつも素敵なイラスト楽しく見させてもらってます。\nリクエストなのですが、以下ケモVtuberさん3名を描いていただきたくリクエストさせていただきました。\n・斑揚ハンナさん\n・まがみさん\n・熨斗のしろさん\n\nこの御三方はコラボをされているので、サムネ用に使えるようなイラストをお願いします！\n構図などはお任せしたいのですがよろしいでしょうか？\nよろしくお願いします。\n以下Vtuberさんのリンク送らせていただきます。\n\nhttps://lit.link/BuchiageHannah\n\nhttps://lit.link/OokamiMagami\n\nhttps://lit.link/fi5ynl33", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tachiyawolf/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 503745, "client_id": 3198091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9673775/uploads/origins/b0774dad-f1e7-4492-8e99-8da0d9433c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57cda0d26e4b3be3af56bb1aa224dd1a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9673775/uploads/origins/b0774da