たり、あごをさすったり、頭のてっぺんをさすったり。ジェミはおそらく、これに口を尖らせて反応するだろう...。そして顔を赤らめるだろう。彼はエネルギッシュでハッピーな男の子だが、すぐに慌ててしまう。\n\nあなたが自分のOCを持っているかどうかわからないけど、彼をなでる自分のキャラクターも描けるよ！抱きしめたり。あるいは...本当に何でも好きなように！\n\n今までのあなたの作品にはとても感動しています。あなたなら、きっとかわいいイラストになると思います！\n\nhttps://drive.google.com/drive/folders/1DK56UglJX5nbz4Oy2dWZQyiDZLQvqQiu?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@teho__o/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3454969, "client_id": 3433286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76c67a653f6f6020db62eaac537ca62b", "srcset": "https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76c67a653f6f6020db62eaac537ca62b, https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5c981f00cfa74729946936cb6207b67 2x, https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f49bdb22a3d804932add73e5cf5c45d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e61fb86de4a02ce253a35c54e9d6319", "srcset": "https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d5a13334?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e61fb86de4a02ce253a35c54e9d6319, https://si.imgix.net/a91f3bf0/uploads/origins/055aa95e-2252-4dd5-92bf-b466d