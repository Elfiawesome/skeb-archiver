to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad1ffd2984e1eaf02bb3f41b0f009292", "srcset": "https://si.imgix.net/658cf025/uploads/origins/b04050f5-afd0-47eb-a732-66df5c61912f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad1ffd2984e1eaf02bb3f41b0f009292, https://si.imgix.net/658cf025/uploads/origins/b04050f5-afd0-47eb-a732-66df5c61912f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52a981b1b9da7034b36eb3e62a49716b 2x, https://si.imgix.net/658cf025/uploads/origins/b04050f5-afd0-47eb-a732-66df5c61912f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da351a2fb16507ab2974c751e23a126b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/658cf025/uploads/origins/b04050f5-afd0-47eb-a732-66df5c61912f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f3b4bb2f8668da36b439f9ee71dadb4", "srcset": "https://si.imgix.net/658cf025/uploads/origins/b04050f5-afd0-47eb-a732-66df5c61912f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f3b4bb2f8668da36b439f9ee71dadb4, https://si.imgix.net/658cf025/uploads/origins/b04050f5-afd0-47eb-a732-66df5c61912f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b3c278f74c49dc19d7c4c2924db6571e 2x, https://si.imgix.net/658cf025/uploads/origins/b04050f5-afd0-47eb-a732-66df5c61912f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0db1291eb66d6592c154096f32a46fa0 3x"}, "body": "アピールありがとうございます！\nぜひご依頼させて頂ければと思います。よろしくお願い致します。\n\nご依頼させて頂くイラストはアピールにもございました、ブルアカのシロコちゃん（ライディング）を\nお願いします。\n\n【シチュエーション】\n乳首部分と股間部分をハート型にカットされ、乳首と局部を露出した変態サイクルジャージ姿のシロコが、\n深夜の公園のベンチに座る男に両足を持ち上げられる背面座位の格好で局部にペニスを挿入されながら、\n周囲のペニスに自分が着けていた緑色のグローブを被せて手コキしながら犯され、肉便器にされている。\n\n最終的に着衣状態のサイクルジャージはビリビリに引き裂かれ、ボロ布状態のジャージを着たままレイプされ\n全身ドロドロの性液まみれにされながら、恍惚のアヘ表情をしているイラストをお願いします。\n\n・男やペニスの描写は最低限のもので構いません。(男はシルエット、ペニスは肉棒だけ等)\n・可能であればシロコのサイクルジャージは通常状態、ハート穴カット版、\n　破かれたり引き裂かれたボロボロ状態で分けて頂けると嬉しいです。\n・サイクルジャージや素肌に肉便器化っぽく、正の字やおまんこマーク、卑猥な言葉の落書きを\n　お願いします。\n・最終的に竿役のペニスに被せられているグローブ内に射精され、グローブから大量の精液が染みだして\n　こぼれている。\n・ぶっかけられているシロコは全身精液まみれで、背面座位でペニスを挿入されている局部からも\n　中出しされた大量の精液が流れ出ている。\n・もし可能であれば、精液と体への卑猥な落書きの表示・非表示をレイヤー分けしていただけると幸いです。\n\n自分の性癖を凝縮させたイラストをお願いさせて頂き申し訳ございませんが、\n何卒ご検討のほど宜しくお願い致します。\n\nハート穴衣装の参考(他絵師様に依頼させて頂いた作品ですが、参考にしていただけると幸いです）\nhttps://skeb.jp/@TYPE96daikyo/works/9\nhttps://skeb.jp/works/59614\nhttps://skeb.jp/works/11791\n\n【参考】座った状態の男に持ち上げられて犯される体位\n(こちらも他絵師様に依頼させて頂いた作品ですが、参考にしていただけると幸いです）\nhttps://skeb.jp/@sochobz/works/16\nhttps://www.pixiv.net/artworks/90481188\nhttps://skeb.jp/@hardcrom/works/601\nhttps://skeb.jp/@sato_terumasa/works/20\n\nシロコ(ライディング)衣装参考\n\nhttps://bluearchive.wikiru.jp/?%E3%82%B7%E3%83%AD%E3%82%B3%EF%BC%88%E3%83%A9%E3%82%A4%E3%83%87%E3%82%A3%E3%83%B3%E3%82%B0%EF%BC%89", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 10209, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Cra4", "screen_name": "Cra4ura", "avatar_url": "https://pbs.twimg.com/profile_images/1549185390627565569/q2tq1Eez.jpg", "header_url": "https://pbs.twimg.com/profile_banners/892014558/1422077458/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 160}, {"id": 66205, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "📦ダンボる📦", "screen_name": "Cardboard235", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at