議なものと人々を触れて、鮮やかで楽しい雰囲気な一枚をお願い致します。\n・「太陽と月、夜明け/夕焼け、海原、民族風、地平線」のモチーフをどちらでもご自由に使って大丈夫です。\n・ポーズや構図は他は何でも構いませんので、お気軽に描いてください！\n\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください。ご検討のほど、何卒よろしくお願いします。\n\nhttps://sta.sh/21vk9peutk4d", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13154, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ひろさわみち/Michi Hirosawa𓀠お仕事募集中", "screen_name": "hirosaworks", "avatar_url": "https://pbs.twimg.com/profile_images/1097711685152829445/0nEAxtNK.png", "header_url": "https://pbs.twimg.com/profile_banners/105974934/1729996104/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1155457, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ふぬゅ", "screen_name": "fufufu_matsu", "avatar_url": "https://pbs.twimg.com/profile_images/1905546235442057216/OAA19gBR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/997128043155021825/1615584135/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1698702, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "黒酢", "screen_name": "kmkm_sssn", "avatar_url": "https://pbs.twimg.com/profile_images/1641789633146277889/QyQyoV2U.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1467004026684600324/1647787970/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expirat