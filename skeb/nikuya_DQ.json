af4-aa56-0f9f6bc59427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08025a4f3cf4860eb68da1fd5acf6d6d", "srcset": "https://si.imgix.net/9abb40fa/uploads/origins/2893508d-608d-4af4-aa56-0f9f6bc59427?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08025a4f3cf4860eb68da1fd5acf6d6d, https://si.imgix.net/9abb40fa/uploads/origins/2893508d-608d-4af4-aa56-0f9f6bc59427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d1bbf882f322a4cc1a46ef9789428312 2x, https://si.imgix.net/9abb40fa/uploads/origins/2893508d-608d-4af4-aa56-0f9f6bc59427?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=80eb795bc918108b7d69f81aeb8c1768 3x"}, "body": "またまたこんにちは！今回はオーガスタスと新しいOC、カッツァの写真を撮りたかったんだ。\nカッツァは魔術を使う魔王で、オーガスタスと同じように高慢で傲慢だ。彼女が勇者に殺され、弱った体で復活するために魔法を使う前は、2人はライバルだった。彼女とアウグストゥスはお互いを軽蔑しているように見えるが、しばしば情熱的でロマンチックなセックスをする。\n\nこの写真では、収録されている参考資料と同じようなポーズにしたかった。ふたりとも裸だ。カッツァはアウグストゥスの膝の上に座り、彼に貫かれている。カッツァは両手でアウグストゥスを囲み、唾液の糸で舌をつないでいる。アウグストゥスは彼女を強く抱きしめている。両者とも、互いの傷や噛み跡が多数ある。横にはカッツァの尻尾がアウグストゥスの尻尾にしっかりと巻きついているのが見える。二人は厳しい表情で見つめ合っているが、近くで小さなハートをときめかせながら顔を赤らめている。カッツァは胸は平らで、太ももとお尻は大きくしてほしい。\n\nどんな変更もお任せします。二人の愛憎が伝わるような作品にしたいです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/15pCD3EIRux5KGkkKJAf9LhFLa8aB2Ppg?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikuya_DQ/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1621578, "client_id": 2369612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f78a9a3/uploads/origins/2ee15b5e-d2d0-4a17-a025-85e0d06be360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04ea15c7bdf091d90b78ab39f61e91af", "srcset": "https://si.imgix.net/6f78a9a3/uploads/origins/2ee15b5e-d2d0-4a17-a025-85e0d06be360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w