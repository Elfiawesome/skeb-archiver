すが、眼鏡はつけたままの姿でお願いします。\n\n使用用途：SNSのアイコン・ヘッダー、壁紙、他依頼参考資料等\n\n何卒ご検討のほどをよろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1uQhPd6c6QzoBu7xG86GdIT-i3Hl2aX44?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 271282, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "あすて", "screen_name": "asute_W", "avatar_url": "https://pbs.twimg.com/profile_images/1742944799253245952/3NWzRPyh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/710459825725906945/1688129745/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 948093, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にく🔞『融国』創作(25年冬コミor26年夏コミ)", "screen_name": "niku_vacuum", "avatar_url": "https://pbs.twimg.com/profile_images/1758297781025034240/I1yyoUrR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/899666540919873536/1708937870/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 161}, {"id": 1609450, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "TOUMA AKIRA", "screen_name": "tomatomawk", "avatar_url": "https://pbs.twimg.com/profile_images/1444490077120315394/q7gXNJhq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1430924218934255620/1653711499/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2368682, "creator