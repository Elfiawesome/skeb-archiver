グ丈のセーラー服\nシンプルな中に上品さのあるデザインでお願いします。\n\n【納品形式】 \n・全体とメインイラストの透過の2パターンは必須希望させてください。 \n・PSD形式だと嬉しいです。 難しいようでしたらPNGでの納品をお願いいたします。\n \n上記をイメージとしてご依頼を受けていただきたいです。\nこだわりが多く、恐れ入りますが様にお写真を撮っていただきたいです。 \n何卒依頼を受けてくださいますよう、重ねてお願いいたします。\n\nhttps://x.com/iirr_amzw/status/2056497314756473225?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mochimochinc/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3689345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3132b978/uploads/origins/97517428-88e7-4d76-9c31-4803580d3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55386219991fcb6d9a7fe9d43c3abf38", "srcset": "https://si.imgix.net/3132b978/uploads/origins/97517428-88e7-4d76-9c31-4803580d3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55386219991fcb6d9a7fe9d43c3abf38, https://si.imgix.net/3132b978/uploads/origins/97517428-88e7-4d76-9c31-4803580d3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a11bb42e00eff255ff8b0e6ca767ad7 2x, https://si.imgix.net/3132b978/uploads/origins/97517428-88e7-4d76-9c31-4803580d3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8a7b7a17d9fd1bcd5a39d7c7160bc95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3132b978/uploads/origins/97517428-88e7-4d76-9c31-4803580d3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1b5aa3c821bbdd889e9a52b371603dd", "srcset": "https://si.imgix.net/3132b978/uploads/origins/97517428-88e7-4d76-9c31-4803580d3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1b5aa3c821bbdd889e9a52b371603dd, https://si.imgix.net/3132b978/uploads/origins/97517428-88e7-4d76-9c31-4803580d3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&