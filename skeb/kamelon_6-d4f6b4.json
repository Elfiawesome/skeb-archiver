24-49d0-9608-b51601c01f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbf951682c61470955a96685551c8783 2x, https://si.imgix.net/132c16c5/uploads/origins/2a9a64a0-3e24-49d0-9608-b51601c01f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a74d99d830c5ac819e8422cb4a63baa9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/132c16c5/uploads/origins/2a9a64a0-3e24-49d0-9608-b51601c01f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f984176aa186cd7342af55530049bcf4", "srcset": "https://si.imgix.net/132c16c5/uploads/origins/2a9a64a0-3e24-49d0-9608-b51601c01f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f984176aa186cd7342af55530049bcf4, https://si.imgix.net/132c16c5/uploads/origins/2a9a64a0-3e24-49d0-9608-b51601c01f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf1a803527c6a0a059dbf40c963d4605 2x, https://si.imgix.net/132c16c5/uploads/origins/2a9a64a0-3e24-49d0-9608-b51601c01f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aad7a265958a4c692510ef7bd354b800 3x"}, "body": "こんにちは、ののかです。お世話になっております。\nめろんさんのレトロでかわいらしい絵柄と個性的でオシャレな色使い、生き生きとした表情が以前から好きで、是非描いて頂きたいと思いこの度ご依頼に参りました。\n良ければご検討いただきたく思います。\n\n\n\n\nお頼みしたいのはCoCのうちよそOCです。GODARCAというシナリオのPCで、下記の内容にネタバレは含まれません。\n\n\n【キャラクター詳細】\n\n・カマル\n独自の文化を持つ少数民族出身のダンサー。22歳177cm。グラデーションが入った銀の髪、瞳孔が金色の青い目の男性。モチーフはアラビアとタロットの月。\n神秘的な雰囲気を纏っているが性格は天真爛漫で無邪気。誰にでも距離が近くスキンシップが多い。博愛主義だがアダムのことは少し特別に感じている。色恋沙汰に頓着がない。\n一人称：僕　二人称：君\n\n\n・アダム・ホワイト\n無意識で人を口説く天然タラシ 。23歳177cm。白髪に赤い目の男性。モチーフはタロットの恋人。\n物腰が柔らかくいつも穏やか。大人びて見えるがぼんやりとした性格。以前は皆を等しく愛し誰でも口説いていたが自分を救ってくれたカマルに特別な感情を抱いた。無自覚だがメンヘラ気味で感情が重め。カマルの唯一になりたくて頑張っている。\n一人称：僕　二人称：君\n\n\n\n【関係性】\n非常に距離が近く、互いを愛していますが恋愛的な好意は今のところアダムにだけしかありません。カマルの方がスキンシップが多く素直に愛を伝えていますがアダムからの感情の方が大きく重ためです。（アダム×カマル）\n現在は美しく暖かい関係ですが、一方通行気味で破滅が待っていそうな暗い雰囲気が漂っています。\n\n\n\n【構図など】\nこの二人が同じ画面に収まっていればどんな構図でも大丈夫です。\nもし可能でしたら、ヤンデレっぽくて暗い雰囲気だと嬉しいです。めろんさんが描くヤンデレが大好きなので…\n資料に複数衣装がありますがお好きなように描いて頂いて構いません。難しかったら細かい装飾は省いて頂いても構いません。\n\n良ければご検討頂けると幸いです。宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1YLtjSSqtB7-qDj4LTzBoKi45HJMyE0jf", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1166238, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "瀬戸", "screen_name": "ebi_oishiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1680886966345412608/8RWeXDJG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382099772966805507/1771244744/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1357217, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "yrb🥨", "screen_name": "Y0323_", "avatar_url": "https://pbs.twimg.com/profile_images/1697117270177353728/cs23jSgw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1110538805604343809/1681615901/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 1411984, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "日向はび（ひなたはび）＠イラストレーター", "screen_name": "hinata_habi_ss", "avatar_url": "https://pbs.twimg.com/profile_images/1928420657915895808/KY_xZJkj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1321695808358555651/1775374449/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, 