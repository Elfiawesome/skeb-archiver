e6d-c14c3b6fcb67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b671f948f7195df7a391b895074a397, https://si.imgix.net/999eada9/uploads/origins/c40fb3b3-80fa-4e53-9e6d-c14c3b6fcb67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1f924ce13c6c81a5199dfa34ccac722 2x, https://si.imgix.net/999eada9/uploads/origins/c40fb3b3-80fa-4e53-9e6d-c14c3b6fcb67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9bc4b63521814cf22698587136c6ba0e 3x"}, "body": "めろんさんこんにちは。\nめろんさんの色使いがとても好きで、一度自分のキャラクターを描いてみてほしいと思いリクエストさせていただきました。\n今回リクエストしたいのはオリジナルキャラクターの天使と悪魔です。\n---------------------------------------------------------------------------\n【キャラクター】\n□天使\n身長：155㎝\n[外見]\n・外はね気味の三つ編み\n・白のメッシュ\n・青と黄のオッドアイ\n・ヘアピン\n・八重歯\n[性格]\n・天真爛漫で好奇心が旺盛\n・思った事が顔に出やすい→リアクションが良い\n・真面目なのもあり失敗するとへこむ\n\n■悪魔\n身長：165㎝（ヒール込みで170㎝）\n[外見]\n・白髪に紫のインナーカラーとメッシュ\n・両方の角に暗めの赤いリボンをつけている\n・ジト目\n・ギザ歯（大きく口を開けないから見える機会はあまり無い）\n[性格]\n・家族に可愛がられているため自己肯定感が高い\n・趣味は映画鑑賞\n---------------------------------------------------------------------------\n【外見に関して】\n天使、悪魔の特徴としてそれぞれあるのは頭の上の輪っかと角のみです。\n羽はオプションみたいなものなのでエフェクトとして欲しかったらつけるくらいの認識でいます。\n---------------------------------------------------------------------------\n【関係性】\n・友人\n・休日に映画館などに遊びに行く仲\n・悪魔は天使の反応見たさに誘っており、また天使の方は単純に楽しいから誘ってもらえたら快諾しています\n・本人達は天使と悪魔で会っている事に何とも感じていません。それぞれの周りの方が手出したら許さないからなと考えている節があります\n---------------------------------------------------------------------------\n【資料URL】\nhttps://drive.google.com/drive/folders/1t6UFVR4k1SM4AbW8sA1GuVaK3d3SRVgB?usp=drive_link\n---------------------------------------------------------------------------\n\n雰囲気や構図についてはお任せします。\nご検討いただけますと幸いです。よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamelon_6/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2107744, "client_id": 2652985, "vtt_url": null,