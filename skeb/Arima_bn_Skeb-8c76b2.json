ェラチオ、指入れなど）、自分が描いていて楽しいと思うものを描いてください。参考になればと思いますが、ラブラブで優しいポーズ、縄やスパンキングなどの軽いお仕置きポーズ、情熱的な激しいポーズなど、いろいろと選択肢はあります。関係性としては、1804年の船上で密かに愛を育んでいる2人のキャラクター。\n\nいずれにせよ、お読みいただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1RCJQ6fb8f_B1YFfHXOBAqhYfmZw72lhO?usp=sharing", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Arima_bn_Skeb/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1759293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6aa521f/uploads/origins/9881e5ea-65a4-42e3-9c0c-696c66e5aa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d591226fd5b183ba1a1d667b01898717", "srcset": "https://si.imgix.net/c6aa521f/uploads/origins/9881e5ea-65a4-42e3-9c0c-696c66e5aa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d591226fd5b183ba1a1d667b01898717, https://si.imgix.net/c6aa521f/uploads/origins/9881e5ea-65a4-42e3-9c0c-696c66e5aa69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5da60a023519144f68c2aca38fc9bd6e 2x, https://si.imgix.net/c6aa521f/uploads/origins/9881e5ea-65a4-42e3-9c0c-696c66e5aa69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70b26e2934dd178c4e817e3b80086e59 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6aa521f/uploads/origins/9881e5ea-65a4-42e3-9c0c-696c66e5aa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b455f64c513d39586bfe82c36f7dd272", "srcset": "https://si.imgix.net/c6aa521f/uploads/origins/9881e5ea-65a4-42e3-9c0c-696c66e5aa69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b455f64c513d39586bfe82c36f7dd272, https://si.imgix.net/c6aa521f/uploads/origins/9881e5ea-65a4-42e3-9c0c-696c66e5aa69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=