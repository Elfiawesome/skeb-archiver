on": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c19776a8/uploads/origins/3cbefefc-932a-432c-9127-18bbfa9fda12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f64316da11ed5b0b90f9afdcc70a01a", "srcset": "https://si.imgix.net/c19776a8/uploads/origins/3cbefefc-932a-432c-9127-18bbfa9fda12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f64316da11ed5b0b90f9afdcc70a01a, https://si.imgix.net/c19776a8/uploads/origins/3cbefefc-932a-432c-9127-18bbfa9fda12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40d08e9069f8fe2558f4aedb87177e62 2x, https://si.imgix.net/c19776a8/uploads/origins/3cbefefc-932a-432c-9127-18bbfa9fda12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9aa51e88c82b4465a633a8ff91b7f4c 3x"}, "body": "初めまして、いつも揚げ鶏々さんのとても素敵で可愛らしく、美しいイラストを拝見させていただいています！今回はぜひうちの子を描いてもらいたいと思い依頼させていただきました！\n\n下記に貼られているサイトのキャラクター2人をお願いします！アホ毛の子（幽と言います）は可愛く明るく活発で、クールで美人なエアインテークの子（千尋と言います）が世界で一番大好きですが、千尋はそんな幽のことが世界で一番大嫌いで、よく殴り合いに発展したりしている仲です。\n\n揚げ鶏々さんの描かれるイラストがすごく好きなので、構図や衣装などは全ておまかせしたいです。よろしくお願いします！\n\nhttps://www.dropbox.com/sh/nlpy9pi95of08ck/AABmrNEaBYqxaAb-yrFpPWw4a?dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@agedoridori/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1079582, "client_id": 602527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/365896a9/uploads/origins/fe2129b2-50a0-4741-9319-01d3e4bfa7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5349cad3e23d29ea6ede97d0f27f51b7", "srcset": "https://si.imgix.net/365896a9/uploads/origins/fe2129b2-50a0-4741-9319-01d3e4bfa7d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5349cad3e23d29ea6ede97d0f27f51b7, https://si.imgi