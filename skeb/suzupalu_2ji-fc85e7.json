e-cd3f-4d77-9cb3-d87420f1134b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc8fa25f79eb4deff9bbf5e53e819947, https://si.imgix.net/43312f3e/uploads/origins/d429560e-cd3f-4d77-9cb3-d87420f1134b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=077ce52b161b9581ca1a98ea19bacdb6 2x, https://si.imgix.net/43312f3e/uploads/origins/d429560e-cd3f-4d77-9cb3-d87420f1134b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55c35ed02fd33cca62ba848296a17e43 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43312f3e/uploads/origins/d429560e-cd3f-4d77-9cb3-d87420f1134b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19be05fbfbbe3846312210444b91814d", "srcset": "https://si.imgix.net/43312f3e/uploads/origins/d429560e-cd3f-4d77-9cb3-d87420f1134b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19be05fbfbbe3846312210444b91814d, https://si.imgix.net/43312f3e/uploads/origins/d429560e-cd3f-4d77-9cb3-d87420f1134b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d038592bf332c46732f592b9538d338 2x, https://si.imgix.net/43312f3e/uploads/origins/d429560e-cd3f-4d77-9cb3-d87420f1134b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=445b8894430becd0a0d3523e11af06ea 3x"}, "body": "鈴春°さんこんにちは……。\n\n自分でもうんざりするほど性懲りもなくイラストのご依頼に来てしまいました。\nもしダメな場合はお断りください…。\n\n今、趣味でBL描いていて、その表紙に使わせていただくイラストを依頼したいです！\n\n【攻め（殺し屋）】22歳　細マッチョ　茶髪のオールバック。眉毛全剃り。\n祖父を目の前で殺された経験があり、復讐に燃えています。\n単純なところもあるいい奴、という設定です。\n\n【受け（若頭）】26歳　華奢　黒髪　サラサラ。綺麗な顔。\n精神疾患を抱えていて、いつ暴れ出すかわからない闇を抱えています。\n組員には非情な態度を見せますが、自分の部下にはめちゃくちゃ甘い一面もあります。\n\nhttps://twitter.com/oreco730/status/1640145164261011457?s=20\nこの構図が好きで……。\n右を受けにしてもらって、左の攻めのポーズはお任せします。\n表情もこの構図に近く、攻めが流し目でこちらを睨んでいて、受けが不敵に笑ってると嬉しいです。\n\n以上、もし引き受けてくださるなら、よろしくお願いします！\n\n江夏\n\nhttps://twitter.com/oreco730/status/1640145164261011457?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzupalu_2ji/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ebbcc36a/uploads/origins/b6fd0da1-1c1e-448e-84e9-06fc6294373c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f59504c9c450deb796c22a74fb4600b", "srcset": "https://si.imgix.net/ebbcc36a/uploads/origins/b6fd0da1-1c1e-448e-84e9-06fc6294373c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f59504c9c450deb796c22a74fb4600b, https://si.imgix.net/ebbcc36a/uploads/origins/b6fd0da1-1c1e-448e-84e9-06fc6294373c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb4cb2863cd07c4ae085be5af7e9c2c5 2x, https://si.imgix.net/ebbcc36a/uploads/origins/b6fd0da1-1c1e-448e-84e9-06fc6294373c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e14d7741ab9b45b3d22b04e7539cad1d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1341343, "client_id": 489192, "nc": 0}, {"path": "/@suzupalu_2ji/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6625b578/uploads/origins/9d45fcbd-d7cc-49ae-bbee-5576801f4e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6463959ed557b566c445592fbe97b81", "srcset": "https://si.imgix.net/6625b578/uploads/origins/9d45fcbd-d7cc-49ae-bbee-5576801f4e52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20