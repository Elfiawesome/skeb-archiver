694a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac62d06c03bb7f981a7d30df35e3efc3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c408e962/uploads/origins/027c0547-b078-4baf-9b25-cdb0e30694a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e03185fcde7495a099d9e82a8feba8", "srcset": "https://si.imgix.net/c408e962/uploads/origins/027c0547-b078-4baf-9b25-cdb0e30694a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91e03185fcde7495a099d9e82a8feba8, https://si.imgix.net/c408e962/uploads/origins/027c0547-b078-4baf-9b25-cdb0e30694a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9783458d6d59f50554160547261e38b 2x, https://si.imgix.net/c408e962/uploads/origins/027c0547-b078-4baf-9b25-cdb0e30694a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c41853a4fb300a0dd159e6d7a5d7c0ac 3x"}, "body": "こんばんは、突然の依頼失礼します。\n\nオリジナルキャラの「赤鬼くん」のイラストを描いて頂けたらと思いご連絡しました。参考画像は下記の表紙です。\nhttps://estar.jp/novels/25576624\n\n勝手ながら下記にリクエストの詳細を書きますが、もしご都合難しい場合にはお断り頂ければと思います！！！\n\n【使用について】\n・新しく続編小説を書く予定でして、可能であれば小説の表紙に使わせて頂きたいです。\n\n【リクエスト詳細】\n・大学生になった赤鬼くんをお願いしたいです。\n・ヘッドホンを首にかけた髪の赤い男の子で、悪そうに笑っている感じでお願いします。オリジナル時のイラストとの雰囲気違いなどにはこだわりません。鈴春°さんに描いて頂く赤鬼くんを見たいという勝手なお願いです。\n・服装は胸元に鬼の絵が入ったスカジャンを前開きしているイメージです。\n・ポーズは股上から頭までで正面を向いているイメージですが、描きやすいようにお任せ出来ればと思います。（振り向き姿とかでも構いません。描いていて楽しいものだと嬉しいです。）\n・なお赤鬼くんは178cmくらいで兄のテトラよりは細身ですが普通に筋肉はある想定です。（あくまでご参考）\n・まだ小説執筆中なので全く急ぎではありません。\n\n長々とすみません。\n金額など、ご容赦頂けましたらお願い出来ればとてもとても嬉しいです。\nご検討のほど、よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzupalu_2ji/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1341343, "client_id": 1341471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1fcef62b6bbf9977cc102cd3f60b155", "srcset": "https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1fcef62b6bbf9977cc102cd3f60b155, https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=756739560424d2e8dd687a6eab65b0cd 2x, https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07f3609a56a36be18d3815848bfb8514 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9b382e4491a6c6195bf06b427c9d013", "srcset": "https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9b382e4491a6c6195bf06b427c9d013, https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c2fb766b874b86acd27cdc091539649f 2x, https://si.imgix.net/7c3ecdb8/uploads/origins/ff53e5cf-9bba-4a6a-a23c-f4f2a47d50a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d359996f0e0a3e03163913bbcfa00fc 3x"}, "body": "鈴春°さん、こんにちは！すごく悩んだんですけど、依頼に来ました…。\nそしてもし体調・スケジュール的に難しかったら、気にせず秒で断ってください。大丈夫なので。その場合は下記も読まなくて大丈夫です。長いので(笑)\n\n依頼したいのは、自作Fight or Flight３の表紙です。\n今回はカラーでお願いしたいのですが、いざ表紙で使うときは白黒で使います。\n（カラーは挿絵で使います）\nファイフラ２の時は横に2人並べてもらったんですけど、今度は縦に並べていただきたいです。（区切り方は真横でもいいし、斜めでもいいしお任せします）\n上が倉科、下が矢島。\n倉科は白衣を着ていて矢島はなんかちょっとおしゃれ？なジャージにしていただきたいです。\nそしてここがちょっと重要なのですが、二人とも正面から強い光（色は赤～黄の範囲内で）を浴びていて欲しくて。イメージは正面から太陽が迫ってくるような感じです。\n\n光源は目線より少し上で、倉科が（向かって）左寄り、矢島が（向かって）右寄りの正面から光が当たっているような感じ。\n倉科の左眼、矢島の右目は強い光によって、その光の色に染まってるくらいがいいです。\n\n二人の表情は「武者震い」で、笑っていてほしくて……。「やってやるぜ……」的に。\n（口は開いていても閉じていててもどちらでも）\n\n二人で睨み合ってるようにも見えるし、同じもの（光る何か）をそれぞれ別の場所から見ているようにも見えるような、どっちにもとれる絵面にしていただきたい！（無茶ばっかりすみません…）\n\nで、ここも重要なのですが、倉科の髪の毛は、表紙で使うときは黒髪なのか白髪なのかバレたくないのです。\n白黒にしたときに、白く抜けるように描いてもらうって出来ますか？\n（できる範囲で大丈夫です…）\nカラーのときにはじめて光が強く当たっている黒髪だとわかるのが理想です。\n\n二人の年齢は20代前半ですが、そこはとくに感じられなくても大丈夫です。\n\n以上、もしよければよろしくお願いします！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzupalu_2ji/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1341343, "client_id": 1341471, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47ae49622d8fdb346d99532b03a313e2", "srcset": "https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47ae49622d8fdb346d99532b03a313e2, https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae82baa1ed7c2f47dad8fa0f8ced14e3 2x, https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41f88128894d5ff95d2670022b06967e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7dadd80415952ae61d70e57ef40e11", "srcset": "https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7dadd80415952ae61d70e57ef40e11, https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1e25666fa7a25e53687b03bb413bb78 2x, https://si.imgix.net/3ae0b48f/uploads/origins/d194cc02-72fa-4b0f-9d14-fcdb5be79633?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1496a32113993a6230e79b478c059786 3x"}, "body": "鈴春°さん、こんばんは！\n\n先日は素敵すぎるイケメン手錠男子をありがとうございました！\n\nおかげさまで小説もやっと折り返し地点になりました。\nそこで！もう一枚挿し絵としてご依頼させていただきたく、勇気を振り絞って参上いたしました！\n\nこの間のイラストと同一人物の、遺影を描いていただきたいのです。\n白黒写真で、遺影の額縁とリボンもお願いしたいです。\n\n急がないのでスケジュール、体調などのいいときにお引き受けいただければ幸いです。\n\nご検討のほど、よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzupalu_2ji/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8d580c7d/uploads/origins/ff0b33be-330e-4408-91a5-6211ac037ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eeb52e02efa2b433fde2849461b1759f", "srcset": "https://si.imgix.net/8d580c7d/uploads/origins/ff0b33be-330e-4408-91a5-6211ac037ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eeb52e02efa2b433fde2849461b1759f, https://si.imgix.net/8d580c7d/uploads/origins/ff0b33be-330e-4408-91a5-6211ac037ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7572e724acf7d2fba93a977f810f35a 2x, https://si.imgix.net/8d580c7d/uploads/origins/ff0b33be-330e-4408-91a5-6211ac037ffa?bg=%23fff&