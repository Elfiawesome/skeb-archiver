え、首のタトゥーが見える顔の詳細なショットや、手の動きを伴うタトゥーのある手の画像は許容範囲だ。目の下にクマがあってもよい。  逆光や横位置もOK。顔や頭のアップもまったく問題ない。\n\n あなたのページに提出された最後の作品、本当に素晴らしいです。自由に描いてください。\n\n\n****Миша＞で始まるファイルのみ参照してください。\n\nhttps://drive.google.com/drive/folders/1cSEQHZfXC_6HaJOKn6CBtQxuP4nEQ5La?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1cSEQHZfXC_6HaJOKn6CBtQxuP4nEQ5La?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzupalu_2ji/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1341343, "client_id": 2611827, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/666c555c/uploads/origins/712f516d-79da-416a-b959-a10a7011507d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ed900fc43defab8a1f6fd51bf9d527", "srcset": "https://si.imgix.net/666c555c/uploads/origins/712f516d-79da-416a-b959-a10a7011507d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78ed900fc43defab8a1f6fd51bf9d527, https://si.imgix.net/666c555c/uploads/origins/712f516d-79da-416a-b959-a10a7011507d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=860ecf1d935e28021c984814097d8412 2x, https://si.imgix.net/666c555c/uploads/origins/712f516d-79da-416a-b959-a10a7011507d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd2e840690a8cbfb9221cf4750b44be0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/666c555c/uploads/origins/712f516d-79da-416a-b959-a10a7011507d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78c83586935bbb429989fcb92b1c5986", "srcset": "https://si.imgix.net/666c555c/uploads/origins/712f516d-79da-416a-b959-a10a7011507d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78c83586935bbb429989fcb92b1c5986, https://si.imgix.net/666c555c/uploads