なり焦ってる表情が見たいと思っております。\nポーズはおまかせでお願いいたします。\n\nもし難しければ上記の内容は無視して秋山中様のお好きな物をかいていただきたいと考えております。\n\n◆使用用途◆\n・X（旧Twitter）などのSNSでの使用\n・配信での使用\n・壁紙としての配布\n\n◆納品形式◆\nPSD形式で、キャラクター・背景・エフェクトを分けていただけますと嬉しいです。\n\n◆キャラクターのポイント◆\n・うさ耳、尻尾がついています\n・衣装の花はミスミソウとなっております\n・白、水色が基本カラーとなっております\n・前面からの参考画像しかないので見えない部分は雰囲気で描いていただけるとうれしいです\n\n◆参考フォルダ◆\nhttps://drive.google.com/drive/folders/1l4G736PXOY5l7TyET9ENrmTB7eJjMBry?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YzgHbpMVbQmjzfh/works/214", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2956376, "client_id": 3694382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d6ebffa742ad985786a88c267971ae3", "srcset": "https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d6ebffa742ad985786a88c267971ae3, https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18b7e7e593bed6f165db085abcf654f1 2x, https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cb2359208a64a8c867f9f531ed41e59 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=436d726cb14e600b921feaf9c8628560", "srcset": "https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=436d726cb14e600b921feaf9c8628560, https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c2847bdbde9153d8ffb24972e911f2b 2x, https://si.imgix.net/332c5b41/uploads/origins/e76d165f-a7f8-4ac0-9008-8de7d3bfc396?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=279a28189649f930cf46856dffee11d4 3x"}, "body": "お世話になっております。ツイッチで配信しているもぶこと申します。\nねさむま様に描いていただいたイラストがとっても可愛くて、勢いでもう1件リクエストを送ってしまいましたが、お忙しければキャンセルしてください🙇🏻‍♀️\n\n前回、メイド服のイラストを描いていただいたのですが表情が女の子らしく可愛くてとっても良かったです！\n服の影の入れ方もすっごく上手で、本当に期待以上のとっても可愛いイラストを描いて下さり感動しました✨️\n本当にありがとうございます！\n\n◆依頼内容◆\n・オリジナルキャラクターのイラスト\n・配信活動用イラスト、グッズ販売可能なもの。\n・なるべく見切れている部分がないように描いていただけると幸いです。\n・衣装はドレスっぽい形のシスターでお願いします。\n・表情やポーズはおまかせでお願いします。\n\n◆使用用途◆\n・X（旧Twitter）などのSNSでの使用\n・配信での使用\n・グッズ販売\n\n◆納品形式◆\nPSD形式で、キャラクター・背景・エフェクトを分けていただけますと嬉しいです。\n\n◆キャラクターのポイント◆\n・うさ耳、尻尾がついています\n・白、水色が基本カラーとなっております\n・前面からの参考画像しかないので見えない部分は雰囲気で描いていただけるとうれしいです\n\n◆参考フォルダ◆\nhttps://drive.google.com/drive/folders/1l4G736PXOY5l7TyET9ENrmTB7eJjMBry?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YzgHbpMVbQmjzfh/works/200", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2956376, "client_id": 3694382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0604cd40/uploads/origins/1a7b9eb0-2283-47f9-be3c-409b9ff62171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb68fc61ed31223f5945797cd0ea2aa", "srcset": "https://si.imgix.net/0604cd40/uploads/origins/1a7b9eb0-2283-47f9-be3c-409b9ff62171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cb68fc61ed31223f5945797cd0ea2aa, https://si.imgix.net/0604cd40/uploads/origins/1a7b9eb0-2283-47f9-be3c-409b9ff62171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8959715aef10c