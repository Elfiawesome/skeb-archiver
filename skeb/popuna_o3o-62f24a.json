・大きめのサイズであればあるほど嬉しいです！\n\n✦納品形式\n・PSD形式\n\n✦人物像\n・資料用URLにGoogleドライブでの参考画像添付させていただきます。\n・キャラクターイメージは『癒し／朗らか／清楚』です。\n・糸目キャラですので開眼だけはさせませんようお願いします。\n・イメージカラーは白と緑です。\n・糸目は糸目でも、吊り上がった猫のような糸目ではなく、ほんわかした目であると嬉しいです。\n\n---\n\n以上よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1lWlzJG-eXQ00WRvHdQ8HzDXCHr1_DXsN/view", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@popuna_o3o/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/74d0b8fe/uploads/origins/5b95d7bd-7704-4700-a020-ac088addce8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=853f1e8ebfb799dbc4784223db16c703", "srcset": "https://si.imgix.net/74d0b8fe/uploads/origins/5b95d7bd-7704-4700-a020-ac088addce8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=853f1e8ebfb799dbc4784223db16c703, https://si.imgix.net/74d0b8fe/uploads/origins/5b95d7bd-7704-4700-a020-ac088addce8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d151046162cf5bc078189bf65353e74 2x, https://si.imgix.net/74d0b8fe/uploads/origins/5b95d7bd-7704-4700-a020-ac088addce8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f1739a01ed7bc24c63c4b72778d7908 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 135846, "client_id": 514249, "nc": 0}, {"path": "/@popuna_o3o/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/743962ad/uploads/origins/639bb380-c20a-4d6c-a77c-c069fc261de8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50