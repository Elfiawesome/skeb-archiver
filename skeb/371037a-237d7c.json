=200&s=74a5be82f38a76a8b52e098684bffec0, https://si.imgix.net/b69f320e/uploads/origins/5ad2f18c-897d-40c9-8d33-e0f9a03d24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c699eba93c874f422cea6747affe438 2x, https://si.imgix.net/b69f320e/uploads/origins/5ad2f18c-897d-40c9-8d33-e0f9a03d24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bc65663ae1cb7d570c57aa54a30a2e3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b69f320e/uploads/origins/5ad2f18c-897d-40c9-8d33-e0f9a03d24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f53fb3292941205aa4f2d7711369758", "srcset": "https://si.imgix.net/b69f320e/uploads/origins/5ad2f18c-897d-40c9-8d33-e0f9a03d24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f53fb3292941205aa4f2d7711369758, https://si.imgix.net/b69f320e/uploads/origins/5ad2f18c-897d-40c9-8d33-e0f9a03d24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6afae5317c377657e5fe2852bab72984 2x, https://si.imgix.net/b69f320e/uploads/origins/5ad2f18c-897d-40c9-8d33-e0f9a03d24a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8492be93fd459c0b8794b13faae3ab25 3x"}, "body": "お世話になっております。\nまたイラストの依頼をさせて頂きます。\n今回はカードゲームもといアニメもある遊戯王から「ブラック・マジシャン・ガール」（以下BMGと記します）のイラストをお願い致します。\n　今回も前回に引き続きR18差分もお願いしたい且つ、より希望が多くなってしまうのですができる限り分かり易く伝わる様に努力します。全体的な構図としては\nhttps://sp.seiga.nicovideo.jp/seiga/#!/im4010914\nこのニコニコ静画URL先のイラストの様なポーズがベースでお願い致します。加えて胸についても希望がありまして、37さんが以前ピクシブのファンボで2020年4月9日に投稿された松本沙理奈さん位の胸の大きさで、乳首の色はピンク寄りの色合いでお願い致します。それで次にこのベースポーズの右足を、文字数が多かったので下記の「資料URL」にリンクを貼りました。リンク先のグッドスマイルカンパニーのフィギュアの右足の様に伸ばした状態にしてもらいたいです。それで左足に関しましては、フィギュアの画像をスライドして見ていって貰うとBMGは青色のショーツ？の様な下着もしくは衣装と一体物のレオタードかもしれませんが、その下着もとい女性器を覆っている状態の正面から見て分かる様（見せパンみたい）に左足の角度を下げる又は右下方向に伸ばしてもらう様にして頂きたいです。ここは私自身もあまり想像が出来ないイラスト構図のバランス等もあるゆえ37さんにお任せしたい所存であります。上半身に関してはニコニコ静画のベースイラスト通りで大丈夫です。\n　そしてR18差分に関しても希望が御座いまして、ベースイラスト主体としてお話します。まず、表情は脱衣状態の為照れて恥ずかしい感じの描写で、衣装は右手の杖は無くして貰ってピースサインをお願い致します。それから帽子、腕の防具、ブーツは脱いで、胸と股間部の露出にあたる部位も脱衣でお願い致します。ただ、両肩をまわして着けている青色衣装並びにその衣装についてるピンク色のレース？の様な部分、それと似た感じで腰の金色の部分とそこに付いてる同じレースの様な箇所は出来れば残して頂きたいです。最後に左手は帽子が無くなって手ぶらなので左胸の上辺りに胸に乗せる感じで置いて貰えればと思います。\n　色々希望内容で長くなってしまいましたがどうぞ宜しくお願い致します。\n\nhttps://www.goodsmile.info/ja/product/5307/%E3%83%96%E3%83%A9%E3%83%83%E3%82%AF+%E3%83%9E%E3%82%B8%E3%82%B7%E3%83%A3%E3%83%B3+%E3%82%AC%E3%83%BC%E3%83%AB.html#", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@371037a/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1147a5073f445d3a023a451a7ebc583", "srcset": "https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1147a5073f445d3a023a451a7ebc583, https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84d7255505de189b56863183fb987170 2x, https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=749d76ded90175ddc004fee3b11bb032 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fae55aae8a2381398db6ab9b40a05433", "srcset": "https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fae55aae8a2381398db6ab9b40a05433, https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b132841a8bc7710024e6f1f73a305d4 2x, https://si.imgix.net/86e26c94/uploads/origins/6e2dc876-4f65-4b25-9de1-ece7c34610da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27e15b10d4cd41c25faf14cf156f05df 3x"}, "body": "以前に描かれていたセーラー戦士風姫川友紀のピンチシーンをお願いしたいです。\n触手的な長い舌で舐めることによってエナジードレインを行う雑魚敵多数に囲まれた（敵本体は描かないで大丈夫です）という感じで、\n・舌が何本も伸びてきていて、両腕を絡め取られてY字状にされて動きを封じられ、胴体や首にも巻き付かれている\n・セーラースーツにはほぼ破損はないが、袖口や胸元、最小限の穴から長手袋の中やスーツの中に舌が侵入して体を舐め回しているほか、脇や首筋といったむき出しの部分も舐められている\n・特に胸は、襟元や脇から侵入した舌が服の中で巻き付き、服の上から乳首も舐め回されるなど執拗に責められている\n・友紀の表情は、エナジーを吸われて衰弱し、力なく吐息を漏らしているという感じで（差分が可能でしたら、巻き付かれた瞬間の「しまった！」という顔→舐められてエナジーを吸われはじめてしまい、目を閉じての悲鳴を上げる顔→衰弱と変化すると嬉しいです（舐められてからはスーツに唾液・粘液的な染みが入るとなお嬉しいです））\n\n細かい部分は描きやすいようにやっていただいて構いません。よろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@371037a/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1f70ce472cc84ec8e08e2038161b32", "srcset": "https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a1f70ce472cc84ec8e08e2038161b32, https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efa2da4c58abc51acc58ac906acfb794 2x, https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=396bf9f20e69f9ce89ba62d28ff2e709 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d67ecd32635c6ed722ed04b94d22a285", "srcset": "https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d67ecd32635c6ed722ed04b94d22a285, https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af338ca83144e9715327f1c0d8315585 2x, https://si.imgix.net/15993ade/uploads/origins/dcc66718-82b1-48b3-9586-1d9fe895d706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f0073214ceb7fa7f13cfc07ae0711b54 3x"}, "body": "はじめまして、37さんのイラストをいつも楽しく見させていただいており、今回初めてskebでのイラストの依頼をさせていただきます。\n\n・キャラクター\nシンデレラガールズの上条春菜\n・シチュエーション\n・バーニングバスターズのハルナ(上条春菜)が敵の触手怪人に敗れ、変身した姿のままで触手怪人に拷問と称して触手責めでおっぱいや乳首、お〇んこを責められて絶頂(イか)させられてるシチュエーション\n・戦闘後に捕縛されているのでスーツ(資料URLのようなヒーロースーツ)は戦闘後の破れでボロボロなのと触手怪人の特殊な溶解液(お決まりの服だけ溶かす液)でおっぱいが片方見えている(もう片方はスーツ残っていながら責められている)状態で触手責めを受けている状態\n・快楽に負けて変身解除した全裸状態(眼鏡も私服時の眼鏡に戻っている)で更に触手責め絶頂させられている差分もあると嬉しいです。\n\nよろしくお願いいたします！\n\nhttps://imas.gamedbs.jp/cg/idol/detail/128?h=imcgss-c2794", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@371037a/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053352, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4c6d74414bf102af948bd0d72beb086", "srcset": "https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4c6d74414bf102af948bd0d72beb086, https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=716aa490380f926d21c3ad81c1bfbec2 2x, https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5058dc5ca5874c005026a65411d6da7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4174493308d91520d1ad8d511fea2936", "srcset": "https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4174493308d91520d1ad8d511fea2936, https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6e19f24f824df1bd9f17c750b2576ab 2x, https://si.imgix.net/a337c882/uploads/origins/ae10d316-90a6-44e9-926d-0e9d95cb1391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=76b2b9c13c62fa755f4ed95831269d9d 3x"}, "body": "以前に描かれていたセーラー戦士風のアイドルがとても好きでしたので、もしよろしければリクエストさせていただきたいです。\n具体的な内容としては、\n・セーラー戦士風の速水奏さんが十字架かX字状の磔台に磔にされている\n・触手（おちょぼ口的な感じの）が奏の両胸に吸い付いて、エナジーを吸い取っている\n・奏はエナジーを奪われて気が遠くなっていく感じの表情\nという、「敵に敗北して捕らえられ、エナジードレインの刑に処されてしまう」な感じでお願いしたく思います。\n手が磔台にベルトや金具等で拘束されて身動きが取れない（上半身アップの描写でも大丈夫です）ことが描かれているのと、奏のスーツには裸にはならない軽度の、負けた感じのダメージ描写があるとうれしいです。\nもし差分が可能でしたら、\n表情が、『屈しない』という感じの気丈な表情→エナジーを吸われて気が遠くなっていく→吸いつくされて気絶、と差分あるとうれしいですが、これは無理には申しません。\n細かいところはやりやすいように描いて頂ければと思います。\nよろしくお願いします。", "nc"