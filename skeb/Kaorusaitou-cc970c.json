242-b074d9995d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b6b0d1bfeeb31cd39e7113db9abde9b", "srcset": "https://si.imgix.net/80e5bfe1/uploads/origins/2156911d-d698-4b20-9242-b074d9995d03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b6b0d1bfeeb31cd39e7113db9abde9b, https://si.imgix.net/80e5bfe1/uploads/origins/2156911d-d698-4b20-9242-b074d9995d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d34946a27eeaf4c7eb763d4d7deb0f62 2x, https://si.imgix.net/80e5bfe1/uploads/origins/2156911d-d698-4b20-9242-b074d9995d03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=470bbaf383ff35a540e41734c44338e3 3x"}, "body": "いつもお世話になっております。\n今回は、前回描いていただいた海軍少佐通常礼装で立ち姿お願いしたいです。\n1941年3月ごろ、カレーかロリアンあたりでドイツ海軍が夜会を開催しており日本海軍少佐として参加、ドイツ海軍夜会服の大佐と談笑する感じで。構図はお任せします。\n日本海軍少佐通常礼装の方は無帽、剣帯短剣、勲章は前回同様で。ドイツ海軍夜会服大佐は騎士鉄十字佩用。第一次世界大戦とワイマール共和国海軍経て西部海軍区司令部付き。勲章はお任せします。\nわしやん少佐はお酒は飲めないですがシャンパングラス。大佐は葉巻でもワイングラス赤でもお任せします。迷っているのは夜会時はクロークに軍帽と剣預けるかどうかです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kaorusaitou/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 20061, "client_id": 3010956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c67c62a/uploads/origins/f50309b6-c999-44ba-a6e7-2cc4db308f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c43ce8ea0cecd6c59d63bbb00d540718", "srcset": "https://si.imgix.net/1c67c62a/uploads/origins/f50309b6-c999-44ba-a6e7-2cc4db308f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c43ce8ea0cecd6c59d63bbb00d540718, https://si.imgix.net/1c67c62a/uploads/origins/f50309b6-c999-44ba-a6e7-2cc4db308f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91ad730c739a078957342d820d1eee1f 2x, https://si.imgix.net/1