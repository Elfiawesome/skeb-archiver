_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ns2studio/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2496044, "client_id": 1953618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80d21bed/uploads/origins/11b87ba8-9215-44fd-8ae2-b1ca1cb6eb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=530a6eaca6c2642745491a0664b8845f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80d21bed/uploads/origins/11b87ba8-9215-44fd-8ae2-b1ca1cb6eb36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88d36df14f0e3e07f3e2fdc93031896d", "src_set": ""}, "body": "僭越ながら、リクエストを送信させて頂きます。\n　艦これの深雪が恥ずかしそうにビキニの水着を着ている、という内容の全年齢向けの作品を描いて欲しいです。\n　深雪の体型はスポーツが好きそうな少女、という感じのイメージでお願いいたします。\n　私は絵の事は分からないので、作品の詳細は全てお任せいたします。\n　NS2studio様にぜひ依頼を引き受けて欲しいです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ns2studio/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2496044, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/730f6100/uploads/origins/8a5a6c4c-5294-4212-97f6-b8fb2cb0a3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a10668cc9dac8be90207d097ae2a63d4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/730f6100/uploads/origins/8a5a6c4c-5294-4212-97f6-b8fb2cb0a3b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37491459ba501e38187062166fa6e981", "src_set": ""}, "body": "アピールありがとうございます。リクエストいたします。\n\nアピール通りに「ラブライブ！」の小泉花陽を描いてください。\n\n・衣装\n「タカラモノズ」という曲のチアガール衣装にしてください。\n\nhttp://lovelive-schoolfestival.net/wp-content/uploads/2015/04/18280_1411547340_0_640_901.jpg\n\n・シチュエーション\nアピール通りに正面から見る構図で、足をハイキック、スカートがめくれて股間が丸見えにしてください。ノーパン差分も描いてください。\n\nよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ns2studio/works/61", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dfe22c22/uploads/origins/06278b69-07ec-4900-8717-25af42e81729?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d88ce43fcfd713287c6213d9177cdb0e", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2496044, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 50, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 20103, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ナカムラナヲ。", "screen_name": "Tutihumaz77", "avatar_url": "https://pbs.twimg.com/profile_images/1823365687722827776/R-ZR8aQa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/888597383906340865/1688828990/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "nc": 176}, {"id": 28517, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Y2＠C106 お疲れ様でした　Skeb募集中＆作業中", "screen_name": "Y2_sichirin", "avatar_url": "https://pbs.twimg.com/profile_images/1955727056597344257/Iyy6Upnb.jpg", "header_url": "https://pbs.twimg.com/profile_banners/136034906/1565552198/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expir