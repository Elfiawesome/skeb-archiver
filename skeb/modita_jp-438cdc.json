包帯が無数にあります。\nあまり人間社会について理解していません。\n\n∎ HO2薬師 アリス\n薄い茶髪緑眼。\n160cmの女性です。\n頭に花の髪飾りをつけており、割烹着+着物を身に着けています。\nしっかり者で穏やかなお姉さんですが、少し天然です。\n\n※衣装や小物は省力して構いません。詳しくは画像参照をお願い致します。\n\n∎ 構図やシチュエーション\n全てお任せします！ふたりの関係は姉弟の様なイメージです。\n＿＿＿＿＿＿＿＿＿\n\n以上となります。金額的に難しければ、野狗子のみでも構いません◎\n\nここまでお読みいただきありがとうございました🌸\n\nhttps://drive.google.com/drive/folders/1DTR0kNyIGjgWiuSoSBhz_1_gqhQL4_PW", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 857636, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "前野あらね🍓", "screen_name": "MA17_Re", "avatar_url": "https://pbs.twimg.com/profile_images/1611751074599415808/TrBZ-2cU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1295931511254917121/1732707012/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 25, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 1650526, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あいのすけ。", "screen_name": "AINosuke_031", "avatar_url": "https://pbs.twimg.com/profile_images/1541101378348945408/VMwd7o21.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1437775714544091136/1709743819/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1892939, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かづかぞえ", "screen_name": "N0__kiddiNG", "avatar_url": "https://pbs.twimg.com/profile_images/1493184029943685121/IYc1EkhX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1349729320210583558/1644837764/1500x500", "appeal_receivable": false, "popular_creator_