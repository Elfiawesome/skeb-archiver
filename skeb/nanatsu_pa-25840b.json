&h=200&s=bf09a4ca2f23d92f221f173d402dca78 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1dcaeb0f/uploads/origins/b5080397-c14c-4035-978d-83bdd1acd315?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac811ab3612af89d4ffdf726533a47e6", "srcset": "https://si.imgix.net/1dcaeb0f/uploads/origins/b5080397-c14c-4035-978d-83bdd1acd315?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac811ab3612af89d4ffdf726533a47e6, https://si.imgix.net/1dcaeb0f/uploads/origins/b5080397-c14c-4035-978d-83bdd1acd315?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c3dc63a809a451c9e3067afec465983 2x, https://si.imgix.net/1dcaeb0f/uploads/origins/b5080397-c14c-4035-978d-83bdd1acd315?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6154848e34183dfc17c72ba22a6d12a 3x"}, "body": "こんにちは、skebの受付を開始してくれてとても嬉しいです！\n私のOCに依頼したいです。\nどんなnsfw要素も大歓迎だ。是非二人のラブラブなエッチを描いていただきたいです！体位やプレイはお任せします！熟年カップルなのでマニアックなプレイもOKです！\n構図やシチュエーション、服装などの細かいところは全てお任せいたします。\nもし金額が足りないのであれば、適当な金額でのアピールをお願いします。\nもし、不適切と感じたら、この依頼を直接キャンセルしても問題ありません\nhttps://lemon-beauty-455.notion.site/1e943213d26180fe8c32f7012cb6f505", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nanatsu_pa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3537581, "client_id": 2537472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdcc5daf75e0920a788526a7178d75e8", "srcset": "https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdcc5daf75e0920a788526a7178d75e8, https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8707d29780bca7ec22ef6e565cf3bc7b 2x, https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbd1354a9b908b4f32f79644d424b633 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc7f3c99f1adf81901398cc1afb4bc91", "srcset": "https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc7f3c99f1adf81901398cc1afb4bc91, https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f72a24f4c8541c32b21a2484a25a43c5 2x, https://si.imgix.net/9fd6ead0/uploads/origins/ebf13d8c-88a6-4993-be76-fbc6033a067e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28f3f169f5325c38bbd24bc9082f73fe 3x"}, "body": "鈴木様、はじめまして。\n鈴木様の絵柄と線の雰囲気に惹かれ、うちよそのキャラクターを描いていただけたらと思い、リクエストを送らせていただきました。\n（大汐の作品、拝見しております。どれも大好きです、、！）\n\n以下はキャラクターの詳細になります。\n◆黒髪灰色目男（攻め）⇒20歳男、185cm\n大学の軽音部でバンドを組んでいる。キーボード担当。受けとは別のバンド。\n幼い頃からピアノを習っており、コンクール上位常連。受けのことをライバル視していたが、大学で再会したところ存在すら覚えられていなかった。\nそのため、受けには舌打ちをしたり捻くれた態度を取るが、本当は受けのピアノの演奏含めて本気で大好き。\n最近は素直になれるよう努力中。Sっ気が強く真面目な見た目に反して貞操観念は緩い。顔は良い。受けの照れ顔を見るのが好き。\nからかいじゃなく好きという時は嫌そうな顔で照れる。\n酒はかなり弱い。\n\n◆茶髪黄色目男（受け）⇒20歳男、165cm\n攻めと同じ大学の軽音部で、同じく軽音部としてバンドを組んでいる。\n攻めのことは元々喧嘩を売ってくるやつという認識だったが（覚えていなかったことは悪いと思っている）攻めからガンガン来られるのは弱い。押しに弱くチョロい。\n攻めに迫られて照れると反射的に手や足が出ることも。ピアノには複雑な思いがあり、コンクールに出ていた時期の記憶が薄い。攻めを覚えていなかったのもその為。\n酒はかなり強い。\n\n◆二人の関係性\n初めの頃は喧嘩を売られたり買ったりで険悪気味でしたが、攻めが素直に接する努力をし始めたことで少しずつ関係が改善されています。\n\n【服装やシチュエーションについて】\n服装や構図などについては鈴木様にお任せいたします。\n受けが照れているととても嬉しいです。\n\n【使用用途】\n個人の観賞用としてのリクエストですが、SNSのアイコンやヘッダーとして利用する目的もあります。\n\n以上になります。\n乱文失礼いたしました。ご検討頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1R5Ax_omnNdLQ1BdliEVO_nI0QZxH0YAm", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 446962, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "旅行", "screen_name": "3San_325", "avatar_url": "https://pbs.twimg.com/profile_images/2006510538487115779/0wJVgHkv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/757870607211999232/1742906504/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 1133288, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "酒梦猫🦋", "screen_name": "maojiumeng", "avatar_url": "https://pbs.twimg.com/profile_images/2044588109355274240/j4k8v-RX.png", "header_url": "https://pbs.twimg.com/profile_banners/2903124834/1761187646/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1163970, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "参照", "screen_name": "EV_shiro", "avatar_url": "https://pbs.twimg.com/profile_images/1984569596662464513/Nko1Biyu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/847345819342651392/1670548029/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_mast