2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=328fa10d83d888d4da8dfc553c5b275d 2x, https://si.imgix.net/023851bb/uploads/origins/b62d6353-938a-42ba-aad8-abe2a4098932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dd8acf54483cf7ae120b75d71f3717c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/023851bb/uploads/origins/b62d6353-938a-42ba-aad8-abe2a4098932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=239549d543c29cbae3253e446e87630a", "srcset": "https://si.imgix.net/023851bb/uploads/origins/b62d6353-938a-42ba-aad8-abe2a4098932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=239549d543c29cbae3253e446e87630a, https://si.imgix.net/023851bb/uploads/origins/b62d6353-938a-42ba-aad8-abe2a4098932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=655a1435495c001dd55759d029ffff4a 2x, https://si.imgix.net/023851bb/uploads/origins/b62d6353-938a-42ba-aad8-abe2a4098932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9dae10e9d957c11a11e8f8d19178ed0 3x"}, "body": "あまぎり先生、こんにちは。\n\n私は中国カメルゲームマーケティング部の新媒体オペレーター蔣牧雨です。\n先生にエイジオブゼットというゲイムを基に二次創作のフルカラーコマ漫画を依頼するためにご連絡しました。もし漫画は4コマでストーリーを完成できないとしたら、コマの数を増やしても構いません(できるだけストーリーの完全性を保証したいんです)。もしコマが5コマ6コマになったら、支払額はもちろん増やします。漫画が完成次第（或いはネームが完成次第）、先生が望む料金を教えて頂き後、こちらはskebを通じで支払いします。\n\n前日はお世話になりました。(二週前の依頼、本当に素晴らしい作品ですｗ)誠にありがとうございました。\nつきまして、先生に新しい依頼を頼みたいですので、依頼の内容を下記の道理でございます。\n\nもし先生が依頼を受けるとしたら、先生が確認したいかもしれない点は下記の通りでございます：\n\n①漫画の内容はご依頼の文章内にあった内容でお願いいたします。\n内容：\n主人公：血ノ蛾\n\n脇役：忍者御子、紗希、パンダジャック\n\n基地の日本人副官は特に少なく、どう考えても私、忍者御子と紗希（サイボーグを人間と見なした場合）だけであった。アジア人と言ったら、多分パンダジャック君は中国人かもしれない。\n\n末世の4年目に入り、基地内の食料資源はますます充実してきた。 しかし、基地内のアジア人の割合が少ないことと、基地内の多数決制のため、食生活は非常に欧米化していた。 アジア人である日本人である血蛾は、3年間、小麦を主食とするものしか食べずに耐えてきた。条件が整った今、アジアの副官全員と一緒になって、お米の栽培を指揮官に申請したいと思ったのだ。\n\n残念なことに、紗希はサイボーグで普通の人間の食べ物は食べないし、パンダジャックは竹しか食べないと言って暴走するし、御子は長期出張で行方不明。 落胆した血ノ蛾は、もうだめだと思い、それ以上考えようとしない。\n\n数日後、御子が米の種を袋に詰めて基地に戻ってくると、血ノ蛾は大喜び！これで米を食べられるようになったのです。\n\n②血ノ蛾、他のメンバーたち（忍者御子、紗希、パンダジャック）の見本となるキャラクターイラストは添付で送信します。\n\n③データの形式や、納品方法について。\nデータの形式：解像度 リミットなし；PNGファイル（サンプルを添付で送信します。）\n納品方法：skebでよろしくお願いします。\n\n以上でございます、長くなってしまい申し訳ありません、今回もよろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amagi_o_o/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1690110, "client_id": 1836239, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b90ff26/uploads/origins/e335da75-c01c-4680-91e7-525b8a2540d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2807658dabaf75e4dd5518daefed9250", "srcset": "https://si.imgix.net/8b90ff26/uploads/origins/e335da75-c01c-4680-91e7-525b8a2540d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2807658dabaf75e4dd5518daefed9250, https://si.imgix.net/8b90ff26/uploads/origins/e335da75-c01c-4680-91e7-525b8a2540d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=47e9fa4e0ac2dc603580af27e33dc9cb 2x, https://si.imgix.net/8b90ff26/uploads/origins/e335da75-c01c-4680-91e7-525b8a2540d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a97cdae2386ac48b3dffd2f0836e057 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b90ff26/uploads/origins/e335da75-c01c-4680-91e7-525b8a2540d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6bdd02aca3659a4d9a01f23a232ef6f", "srcset": "https://si.imgix.net/8b90ff26/uploads/origins/e335da75-c01c-4680-91e7-525b8a2540d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6bdd02aca3659a4d9a01f23a232ef6f, https://si.imgix.net/8b90ff26/uploads/origins/e335da75-c01c-4680-91e7-525b8a25