5506ae66/uploads/origins/f4ea084a-23e7-48c3-8d67-d435383b611b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5597e7b359776cf181bd3370b72c1e81", "srcset": "https://si.imgix.net/5506ae66/uploads/origins/f4ea084a-23e7-48c3-8d67-d435383b611b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5597e7b359776cf181bd3370b72c1e81, https://si.imgix.net/5506ae66/uploads/origins/f4ea084a-23e7-48c3-8d67-d435383b611b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=636019706814545f76f54d24f901673c 2x, https://si.imgix.net/5506ae66/uploads/origins/f4ea084a-23e7-48c3-8d67-d435383b611b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=083678b8ec9b26d873d2793f1dd9f458 3x"}, "body": "こんにちは、哀憐こおり様。\n雰囲気のある作風がとても好きで、リクエストさせていただきました。\n\nオリジナルキャラクターのイラストをお願いしたいです。\n\nサメ歯・蛇の瞳・斜め前髪が特徴で、少しツンとした性格の子です。\n\n衣装や構図、雰囲気などはお任せいたします。\n雰囲気を大切に描いていただけると嬉しいです。\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1gN4nGFKSDNEoII-ewXRhdRkzsEkSq50d", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@airen_kori/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2576878, "client_id": 1273623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6cadb44f7ff0f1ca078093c230a2238", "srcset": "https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d6cadb44f7ff0f1ca078093c230a2238, https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2aba753b6d0c22aa6ef8724515148d4 2x, https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc9e4404345795a096af429e0fb9519c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=707ed58acd0e0123031fe1cc838b4267", "srcset": "https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=707ed58acd0e0123031fe1cc838b4267, https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfac1671a9ba979604adcb8ca0aa513f 2x, https://si.imgix.net/612cf807/uploads/origins/0ba574d6-ff25-4be4-8387-f5ce55101073?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bdab4cb288210d75986e0685fcf5ae9 3x"}, "body": "哀憐こおり様\n\nはじめまして、個人でVtuber活動をしております、水澄すもも(みすみすもも)と申します。\n哀憐こおり様のイラストを拝見し、かっこよさとセクシーさ、ダークさがとても魅力的で目を奪われましたので、もしよろしければ私のイラストを依頼したくリクエストを送らせていただきました。\n\n〇使用用途\n配信サムネイル(収益化しています)\n\n〇内容\n現在GTAのストリーマーサーバーに参加しており、そのサムネイル用に少し悪い雰囲気の水澄すももをお願いしたいです。現在使っているサムネイル、ゲーム内のアバターもドライブに入れてあります(画質が悪く申し訳ありませんが参考程度に)\n一応ゲーム内の服装としてはピンクの文字が入った黒パーカーにバットを背負ってマスクをしていますが、マスクは下がっていて口が見える状態か着用していなくても問題ありません。\n髪型はゲーム内ではなく私の立ち絵の雰囲気でお願いできればと思います。\nその他装飾品の追加やアレンジ、簡略等はおまかせいたします。\n細かい構図につきましては指定はありませんが、なるべく左右が切れないよう収めていただけると幸いです。\n\n長々と記載させていただきましたが、イメージが付きにくい、描きにくい等あれば服装は上記の通りでなくても構いません。\n\n【最後に】\nデータは人物と背景を分けた、PSDデータ又はPNGデータでいただけると幸いです。\n※背景はそもそもなくても大丈夫です。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1EncrFrDsDDEHx7Bv3I6KCs--sg7RsRtp?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@airen_kori/works/14", "private_thumbnail_image_urls"