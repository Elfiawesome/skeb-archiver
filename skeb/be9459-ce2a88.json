る正面からの構図を希望します。 \nできれば、同じポーズで3つの異なるシチュエーションを描いていただけると嬉しいです。\n1. シェリルが極上の快感に身を委ね、激しく息を切らし、喘いでいる様子。\n2. 視聴者のペニスがシェリルの体内で射精し、彼女のオマンコから精液が流れ出ている様子。 \n3. シェリルの胸の揺れが止まり、シェリルが視聴者を見つめているシーン。シェリルが疲れ気味ながらも、頬を軽く赤らめて視聴者に愛らしい微笑みを送る姿か、口を開けて息遣いはかなり落ち着いているものの、もっと求めているような眼差しで視聴者を見つめる姿のどちらかを選んでください。 \nシェリル、舞台設定、ポーズに関する参考画像のリンクを添付します。このプロジェクトでぜひご一緒できれば幸いです！\n\nhttps://drive.google.com/drive/folders/1KFCWmSUcZ_p9JM4u5X3v11qWyeZMK0Dv", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@be9459/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3971669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d926f62/uploads/origins/6cc21b7c-30e2-4c15-a0a1-28a89f93fb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df944c71ffd73dd60bd308630bc4ce4a", "srcset": "https://si.imgix.net/2d926f62/uploads/origins/6cc21b7c-30e2-4c15-a0a1-28a89f93fb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df944c71ffd73dd60bd308630bc4ce4a, https://si.imgix.net/2d926f62/uploads/origins/6cc21b7c-30e2-4c15-a0a1-28a89f93fb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4727c97b040ca357e4e2cea1f120b112 2x, https://si.imgix.net/2d926f62/uploads/origins/6cc21b7c-30e2-4c15-a0a1-28a89f93fb15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=184dacc88638d8032a9d01c887478d95 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d926f62/uploads/origins/6cc21b7c-30e2-4c15-a0a1-28a89f93fb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e45190e0d1cc5a36b0d4e61ddde06b8c", "srcset": "https://si.imgix.net/2d926f62/uploads/origins/6cc21b7c-30e2-4c15-a0a1-28a89f93fb15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e45190e0d1cc5a36b0d4e61ddde06b8c, http