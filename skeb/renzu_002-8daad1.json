/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2b1739bf1f427631cfa54dde1e14654", "srcset": "https://si.imgix.net/b20569a4/uploads/origins/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2b1739bf1f427631cfa54dde1e14654, https://si.imgix.net/b20569a4/uploads/origins/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0edab74ef15957073bf07fd52fc2acb 2x, https://si.imgix.net/b20569a4/uploads/origins/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62150b8d2581e869096f0ada6ad627bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b20569a4/uploads/origins/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43a42be74375f7882504159eb3ea0dc3", "srcset": "https://si.imgix.net/b20569a4/uploads/origins/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43a42be74375f7882504159eb3ea0dc3, https://si.imgix.net/b20569a4/uploads/origins/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b982e37c60b10dadac75b7c3f16dc76e 2x, https://si.imgix.net/b20569a4/uploads/origins/c43e1899-da94-4acf-8b9d-cfef2498a2d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2884227749b72e4e65800eeeb62bb176 3x"}, "body": "初めまして\nVtuberの桃兎カレンと申します。\n１ファンとして先生にイラストを描いて頂けたら嬉しいな、と考えております…！\n\nイラストはTwitterのアイコンやヘッダー、配信のサムネイルや配信画面、Ci-enのヘッダー・記事のサムネイル・音声作品のジャケット\n等の広報活動に使用させていただきたいと考えております。\n（全てに使用する訳ではなく、分かりやすい例として挙げさせていただきました）\n\nもし使用してもかまわないという場合は、是非よろしくお願いいたします！\n（お手数ですが、不可能な場合はキャンセルしていただければと思います）\n\n【依頼内容】\n・概要：服を着崩して、かなり露出の高い状態でうつぶせに寝そべっているイラスト\n　（可能であればキャラクターの透過差分をいただけますと幸いです）\n\n【キャラクターについて】\nキャラクター：桃兎カレン\n・見た目年齢　18歳くらいのイメージ\n・髪の毛の色　明るめの金\n・ヘアースタイル　肩よりも少し長いツインテール、大きめのうさ耳\n・目の色・形　ピンクがかった赤、少し切れ長な目\n・表情・雰囲気　優しいギャルっぽい雰囲気、感じているような顔だと嬉しいです\n・胸のサイズ　D～Eカップくらい\n\n　構図→横構図だと嬉しいです…！\n　体勢→うつ伏せになって胸を強調している様なポーズで\n　服装→https://www.youtube.com/channel/UC8ExqYNY09bnIC1rewDix3Q（私のチャンネルですので、もしよろしければご参考になさってください）\n面倒であれば、ただの白シャツやタオル等どんな服装でも構いません。\n\n(すべて完全再現ではなくて大丈夫です…！むしろ、れんず先生のイラストが好きなのであくまで参考程度に描いていただけますと嬉しいです…！)\n\n以上、可能でしたら何卒よろしくお願いいたします。\n\nhttps://www.youtube.com/channel/UC8ExqYNY09bnIC1rewDix3Q", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@renzu_002/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3610, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfb6495b/uploads/origins/7f259edd-acfd-4bc1-a8a4-b80f7d9b6734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66e6863f79071a8f12a6a7ede934b5e5", "srcset": "https://si.imgix.net/cfb6495b/uploads/origins/7f259edd-acfd-4bc1-a8a4-b80f7d9b6734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66e6863f79071a8f12a6a7ede934b5e5, https://si.imgix.net/cfb6495b/uploads/origins/7f259edd-acfd-4bc1-a8a4-b80f7d9b6734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a13cf2821b6b882d70cf9dad7f1cac5 2x, https://si.imgix.net/cfb6495b/uploads/origins/7f259edd-acfd-4bc1-a8a4-b80f7d9b6734?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=632adc4ad5de5bde60f38dea4f772ae7 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfb6495b/uploads/origins/7f259edd-acfd-4bc1-a8a4-b80f7d9b6734?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1731a1e0c59c08c8e0702af2a61c12cc", "srcset": "https://si.imgix.net/cfb6495b/uploads/origins/7f259edd-acfd-4bc1-a8