x.net/d9aa2586/uploads/origins/039ccf63-63b8-4735-99fd-beef379a2e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6f6155a8c4633fa0539d9810827ed89 2x, https://si.imgix.net/d9aa2586/uploads/origins/039ccf63-63b8-4735-99fd-beef379a2e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76900265040f3be4a15c9840ec26fae2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9aa2586/uploads/origins/039ccf63-63b8-4735-99fd-beef379a2e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fae8b4bf8106e44e0b3d24313286c5a", "srcset": "https://si.imgix.net/d9aa2586/uploads/origins/039ccf63-63b8-4735-99fd-beef379a2e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fae8b4bf8106e44e0b3d24313286c5a, https://si.imgix.net/d9aa2586/uploads/origins/039ccf63-63b8-4735-99fd-beef379a2e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddd8e9a3b148e3a28cb29d2b3358e799 2x, https://si.imgix.net/d9aa2586/uploads/origins/039ccf63-63b8-4735-99fd-beef379a2e2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d3a050cf25e6f59bb31b0ddcbd611ee 3x"}, "body": "はじめまして、ゆうばりめろんと申します。\nくすなし様の素敵なイラストを新着で拝見し、一目ぼれしてしまいました…！暖かなタッチがとても大好きです！！！\n今回、私と友人がTRPGというゲームで作成したオリジナルキャラクターを描いていただけないかと思い、リクエストを送らせていただきました。\n\n関係性は下記に、見た目はファイルに添付してあります。\n構図はお任せいたしますので、くすなし様の描きやすいように自由に描いていただければと思います。\n2人分となりますのだ、金額など不足がありましたら再送要請してください。\n\nお忙しいとは思いますが、ご検討いただけると幸いです。\n\n\n\n◆師匠\n黒髪の男性。\nよく弟子をニコニコと笑顔で振り回したりからかったりしている。\n\n◆弟子\n紫髪の女性。\n師匠をとても尊敬している。\nからかわれているが、冗談を間に受けるので褒められていると思っている。\n\n◆出身シナリオ\nTRPG(CoC)『魔法使いの水葬』\nhttps://someishitsu.booth.pm/items/3864628\n\n◆関係性\n・師弟関係\n・森に住んでいる師匠の魔法使いの家に、普段町に住んでいる弟子が通っている。\n・よく師匠が弟子をからかっているが、弟子はなんでも信じてしまう性格なので、師匠の言ったことな「そうなんですね！」と間に受けてしまう。\n・弟子は町のカフェで働いていて、お菓子を手土産に師匠に会いに行く。\n・身長差がかなりあるので、よく師匠に頭をボムボムされている。\n\nhttps://drive.google.com/drive/folders/1-3zRU0XhHdO88CYGfIMRTmzqfLutGMRa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cuth_nasi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2487501, "client_id": 2315112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae38ee2f84de35c9114d3a5da4a19355", "srcset": "https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae38ee2f84de35c9114d3a5da4a19355, https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=330ecd4f8c376260f10aff150a63bc1a 2x, https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f12a5dce7fcb93c9f142d7091a860eaa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1793586fd805fd58d149f9211955a26d", "srcset": "https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1793586fd805fd58d149f9211955a26d, https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25a602b89bb6c4528f641b38889db394 2x, https://si.imgix.net/199d917f/uploads/origins/8240c825-def0-4e01-904c-921d0d015680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73bbd32563e946eecb22c23fb4c370df 3x"}, "body": "くすなし様、初めまして。\nもしよろしければ、自作小説に登場するOCを描いていただけないでしょうか。\n\n\n※魔法が使えるファンタジー。人間の他に、竜人、竜、魔物がいる世界観です\n\n\nOC①\nクロ(13)148cm\n・人間、男\n・黒の長髪を一つ結び又は三つ編み、黒い瞳(気が強そうに見える吊り目)\n・華奢、色白肌\n・穏やか、丁寧な言葉遣い、計算高い\n・幼少期に魔物に両親を殺され、竜人に拾われ共に暮らす\n・13歳で再び魔物に襲われ死にかける。治癒不能に陥ったため、竜人の独断で魔法で時間を巻き戻し、一からの人生をOC②レヴィになって送ることに。(記憶消滅、事実上の死亡)\n\n\nOC②\nレヴィ(18)163cm\n・人間、男\n・黒の短髪(ベリーショート)、黒い瞳(気が強そうに見える吊り目)\n・細身、畑仕事で少し日焼けした肌、イエベ\n・活発、器用、表情豊か、世話焼き、すぐ顔に出る\n・捨て子として老夫婦に育てられ、すくすく育つ\n\n\n※直接対話することはできない二人ですが、夢の中で会って話をしているようなイメージ\n\n※高山地帯に住んでいる設定。モンゴルの民族衣装のような長袖、立襟の服を着用\n\n※同じ体なのに、育て方が違うと性格も違う(二人とも幸せに暮らしている)\n\n※植物の描写が素敵でしたので、取り入れていただけると大変嬉しいです\n\n\n使用目的として、SNS、小説投稿アプリ(挿絵)、印刷して個人鑑賞を予定しています。\nご検討よろしくお願いします。\n\nhttps://www.alphapolis.co.jp/novel/64106558/337890015", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cuth_nasi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2487501, "client_id": 2937535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94b1bcf5/uploads/origins/89e94895-ec6e-4c59-90ad-9b03bf8a95a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b6c4f1f9d6c5d435a7d39fdfd86da61", "srcset": "https://si.imgix.net/94b1bcf5/uploads/origins/89e94895-ec6e-4c59-90ad-9b03bf8a95a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b6c4f1f9d6c5d435a7d39fdfd86da61, https://si.imgix.net/94b1bcf5/uploads/origins/89e94895-ec6e-4c59-90ad-9b03bf8a95a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be4c9defc2e0fc85f242e2d32e83157f 2x, https://si.imgix.net/94b1bcf5/uploads/origins/89e94895-ec6e-4c59-90ad-9b03bf8a95a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85582c8188b31b18271023a79ef60c9f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src":