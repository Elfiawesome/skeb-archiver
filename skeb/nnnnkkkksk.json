d1-bf4e-d61259c85b8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=296eefc9febe4da3ecdaa40e3260c5c6", "src_set": ""}, "body": "シークレットエージェント姿のトリュフを描いてください。CIA/FBIのようなもの\n\nまたはマトリックスのエージェント・スミス\n\nありがとう\n\nhttps://drive.google.com/drive/folders/1ZEguDYz4qg3WwuZZ0kILtHLtSMoco2cO", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nnnnkkkksk/works/128", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2828135, "client_id": 3235437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/94c60c99/uploads/origins/297fe7eb-a020-4f97-b161-33364ee6cc21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=207c9136fc0abfbd8fffc7f86c8d3f4c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/94c60c99/uploads/origins/297fe7eb-a020-4f97-b161-33364ee6cc21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=558fd75260b2fd78b67a63b8b1dd275c", "src_set": ""}, "body": "私の擬人化したタランチュラの女性、ランディを描いてほしい！\n\n身長は152cmで、鼻はありません。体も毛むくじゃらです。シャツの前のロゴは、僕が作った架空のスケートボード会社のものです。ロゴの画像はURLの3番目の画像です。\n\n自信家で気取った性格！定期的にスケートボードをしている。\n\nこの写真では、参考資料のようにスケートボードを持ちながら歩いてほしい。4つの目のうち2つを片側に寄せてウインクし、ピースサインを掲げながら遊び心で舌を出している。URLの4番目の画像がポーズの参考です。\n\nhttps://imgur.com/a/fnCI0ei", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nnnnkkkksk/works/127", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2828135, "client_id": 1114517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16808012/uploads/origins/a43d5d1a-c669-43ed-9736-071612581887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd53ed512ca98b1a75a564ff547c5db0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16808012/uploads/origins/a43d5d1a-c669-43ed-9736-071612581887?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72b55e7954216f8ad57c01824ebc275a", "src_set": ""}, "body": "はじめまして、서라비と申します‼️\n\nあなたの絵が本当に大好きです‼️‼️\n\nうちの子のイラストを描いてくれませんか？？\n\n幻想と煙、蝶々をモチーフにした子です\n\n背景は夢のなかにいるようにしてくれたら嬉しいです‼️\n\n髪と尻尾は煙で、半透明です｡\n風に揺られたりする表現もいいですが、難しいなら普通に描いてもオッケーです‼️\n\n🦋のピンは操縦できます\n飛ばしたりすると新しく生まれます！\n\nこれまでが設定です\n\nよろしくお願いします‼️‼️\n\nhttps://drive.google.com/drive/folders/1DLXfBFFdnSnjUEOKAmZPYE1tlbb50veh", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nnnnkkkksk/works/126", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2828135, "client_id": 942464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/503e7387/uploads/origins/2871c4a0-99d7-4f7d-99cc-e705a6ae4fd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38fb7b490f1004a68b01889215d6f01c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/503e7387/uploads/origins/2871c4a0-99d7-4f7d-99cc-e705a6ae4fd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eaa8694c55051ee61773edab5fae1fa2", "src_set": ""}, "body": "のこさん、こんにちは！素敵な絵よく拝見しています！\n\n二人の友達を申請させていただきます！雰囲気は親友のような感じでお願いします！構図や背景は自由にしていただければと思います！\n\nhttps://drive.google.com/drive/folders/12iFhREXdU-p65RKTULysp-gm0Wdb-6_5", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nnnnkkkksk/works/125", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2828135, "client_id": 2358560, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e26f66e/uploads/origins/3f2a4276-c0e0-4392-8071-2c7b753cfccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea34ba6a75dffacbc144ec8dae528314", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e26f66e/uploads/origins/3f2a4276-c0e0-4392-8071-2c7b753cfccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6b1b4f33375616f179e834131a4212b", "src_set": ""}, "body": "老師您好，我非常喜歡您的畫風，希望你能幫我跟我的伴侶畫一張圖：\n角色A:旭比，是一隻白色狐狸，胸前的吊飾是蝦子的吊飾\n角色B:奇諾，是一隻藍色的龍，臉上與腹部有特殊的圖騰\n希望兩隻角色靠在一起，並且往畫面(觀看者)的方向擺出可愛的姿勢\n該圖片會各自放大頭部的部分，並設定為FaceBook的大頭貼，所以希望角色的頭部不要重疊到\n\n若是可以的話，能否額外匯出兩隻角色各自單獨的圖片，以便各自設定為社交帳號的背景圖，若是老師能配合這個需求的話，我會非常感謝老師!!\n\n先生こんにちは。\n先生の絵柄が本当に大好きで、ぜひ私とパートナーのキャラクターのイラストをお願いしたいと思い、ご連絡させていただきました。\n\nキャラクターA：旭比（アサヒ）は白いキツネで、胸元にエビのアクセサリーを付けています。\nキャラクターB：奇諾（キノ）は青いドラゴンで、顔やお腹に特徴的な紋様があります。\n\n2匹のキャラクターが寄り添いながら、画面（見る人の方向）に向かって可愛らしいポーズをとっている構図を希望しています。\nこのイラストは、それぞれのキャラクターの顔部分を拡大して、Facebookのプロフィール画像に使用する予定ですので、キャラクター同士の頭部が重ならないようにしていただけると助かります。\n\nもし可能であれば、それぞれのキャラクターを単体で描いた画像も別に書き出していただけないでしょうか？\nそれらは個別にSNSアカウントの背景画像として使わせていただきたいと考えております。\nもしこのご要望に対応していただけるようでしたら、本当に感謝いたします！\n\nhttps://drive.google.com/drive/folders/1_y8eC9M631JQABAGN_8U-ZSxIjCrojLv?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nnnnkkkksk/works/124", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2828135, "client_id": 1855132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92375f82/uploads/origins/65898b26-27a2-4124-b349-dd846b17601b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56279e380f974c4a32df8ecfe13b05e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92375f82/uploads/origins/65898b26-27a2-4124-b349-dd846b17601b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2a5537ec1a389f8f8520adf90