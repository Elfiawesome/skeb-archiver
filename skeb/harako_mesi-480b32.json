et/cbcb200e/uploads/origins/efb11be1-5455-4c07-b9c2-51c15f7ac31a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=277779bca6491bf575695fe323be2b22 2x, https://si.imgix.net/cbcb200e/uploads/origins/efb11be1-5455-4c07-b9c2-51c15f7ac31a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38bb9b519aad88e26c2a6a7ba4be30f0 3x"}, "body": "こんにちは。あなたは素晴らしい「ウマ娘」のイラストを描かれていますね。筋肉の描き方がとても力強く、本当に大好きです。私のオリジナルキャラクターである人狼の女の子を描いていただけませんか？参考画像のような、体にぴったりとフィットしたドレスを着せたいと思っています。ポーズは参考画像と同じもので構いません。タイトなドレス越しに、彼女の力強い筋肉が浮き出るように描いていただけると嬉しいです。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1HtJ9vs70gzemeHfIwgcGfcQ7MhrJZPsP?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harako_mesi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2597245, "client_id": 1106317, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9071ac98/uploads/origins/95797275-644e-48cc-8c03-356c394e3cef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=562d294dfff7e039b5922993f0b88af1", "srcset": "https://si.imgix.net/9071ac98/uploads/origins/95797275-644e-48cc-8c03-356c394e3cef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=562d294dfff7e039b5922993f0b88af1, https://si.imgix.net/9071ac98/uploads/origins/95797275-644e-48cc-8c03-356c394e3cef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42a288544d04cdc1a797a51f62eeba26 2x, https://si.imgix.net/9071ac98/uploads/origins/95797275-644e-48cc-8c03-356c394e3cef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bff2c0dad28f494bd6ca637b81d25dc6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9071ac98/uploads/origins/95797275-644e-48cc-8c03-356c394e3cef?bg=%23fff&aut