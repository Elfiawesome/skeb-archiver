 not very intimidating since he's short. A lot of his backstory has to do with space, sunsets, and monsters like Cthulhu!\n\nhttps://drive.google.com/drive/folders/1cBAN5pi71M3rhvWiP_L7fTWVyQ2lBo66", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hatsuaki_e/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3315767, "client_id": 1387126, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf35343e/uploads/origins/ede6d861-c620-4df0-9b2d-8635f1000943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a695a35fe83a7e30f62034b5b9d4339c", "srcset": "https://si.imgix.net/cf35343e/uploads/origins/ede6d861-c620-4df0-9b2d-8635f1000943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a695a35fe83a7e30f62034b5b9d4339c, https://si.imgix.net/cf35343e/uploads/origins/ede6d861-c620-4df0-9b2d-8635f1000943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c43d6ac1d311ce69eb4bd815c4a3e38 2x, https://si.imgix.net/cf35343e/uploads/origins/ede6d861-c620-4df0-9b2d-8635f1000943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aec30539de74be35e02f112625dcccff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf35343e/uploads/origins/ede6d861-c620-4df0-9b2d-8635f1000943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd307de02d3b7af1dbee5fa216f29e0d", "srcset": "https://si.imgix.net/cf35343e/uploads/origins/ede6d861-c620-4df0-9b2d-8635f1000943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd307de02d3b7af1dbee5fa216f29e0d, https://si.imgix.net/cf35343e/uploads/origins/ede6d861-c620-4df0-9b2d-8635f1000943?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e66a6811d95098cd9b2c20258e0