を密着されつつ、自身の女体も弄ばれてしまうジュンくんのドキドキ感を表現して下さい。\n\nそれぞれの胸と股間が見えるよう描いて下さい。\nまた原作では女体化しても大して変化がありませんが、盛ってボーイッシュなロリ巨乳体型にして下さい。\nあかねとメアリーは原作でも小学生離れしたスタイルですが、より盛って下さい。\nよろしくお願いします。\n\nhttps://twitter.com/i/events/1446992259933630465", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzurin0224/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 22303, "client_id": 59999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a5e3a16/uploads/origins/5771bb81-e872-41dd-8464-b5695d0c3ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aa764c2af0d4ab3dd232274dbd4b504", "srcset": "https://si.imgix.net/3a5e3a16/uploads/origins/5771bb81-e872-41dd-8464-b5695d0c3ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aa764c2af0d4ab3dd232274dbd4b504, https://si.imgix.net/3a5e3a16/uploads/origins/5771bb81-e872-41dd-8464-b5695d0c3ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27423d288198114d24d34c105a7658a4 2x, https://si.imgix.net/3a5e3a16/uploads/origins/5771bb81-e872-41dd-8464-b5695d0c3ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0fd3faa97a05c8b50311f29e1f21ae2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a5e3a16/uploads/origins/5771bb81-e872-41dd-8464-b5695d0c3ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2e39e57b8ac99b29b4a093c73811530", "srcset": "https://si.imgix.net/3a5e3a16/uploads/origins/5771bb81-e872-41dd-8464-b5695d0c3ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2e39e57b8ac99b29b4a093c73811530, https://si.imgix.net/3a5e3a16/uploads/origins/5771bb81-e872-41dd-8464-b5695d0c3ad4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7f78