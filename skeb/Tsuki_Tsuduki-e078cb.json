るい筋の入った紺色の髪を後ろでポニーテールにして、髪の一部が顔を覆っている。冷静で鋭敏、知的で秘密主義、愛する者を大切にする。\n\nhttps://photos.app.goo.gl/FHVrs4gDZ12KXVFj6\n\n剣を抜き、ファイティングポーズをとっているが、上から手首に紐がつけられており、操り人形のように扱われている。背景は何でも構いませんが、エッジの効いたダークなテーマで描いてください。\n以上です！\n\nhttps://photos.app.goo.gl/FHVrs4gDZ12KXVFj6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Tsuki_Tsuduki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2933807, "client_id": 2768774, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5860060f/uploads/origins/ea812ca9-1715-4748-81ae-0e498279bdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=350961a86ba460c17ec33fd7fcb12abf", "srcset": "https://si.imgix.net/5860060f/uploads/origins/ea812ca9-1715-4748-81ae-0e498279bdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=350961a86ba460c17ec33fd7fcb12abf, https://si.imgix.net/5860060f/uploads/origins/ea812ca9-1715-4748-81ae-0e498279bdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=74db6786ec9b37320ff24b48fe286084 2x, https://si.imgix.net/5860060f/uploads/origins/ea812ca9-1715-4748-81ae-0e498279bdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24c072d246006b6f5d09e2dc0abe31f7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5860060f/uploads/origins/ea812ca9-1715-4748-81ae-0e498279bdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c620c22ccd6d602f524efdaa4d7edc60", "srcset": "https://si.imgix.net/5860060f/uploads/origins/ea812ca9-1715-4748-81ae-0e498279bdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c620c22ccd6d602f524efdaa4d7edc60, https://si.imgix.net/5860060f/uploads/origins/ea812ca9-1715-4748-81ae-0e498279bdfc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f