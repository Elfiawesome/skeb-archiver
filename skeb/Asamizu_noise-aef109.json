g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e535faf2699284a108a6d0c02e511e6, https://si.imgix.net/56601eee/uploads/origins/aef8e4e5-87e2-4ab1-a36d-b1dcc6000e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75754602bc473384a077bf7e3edeffde 2x, https://si.imgix.net/56601eee/uploads/origins/aef8e4e5-87e2-4ab1-a36d-b1dcc6000e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=31311f92d9930e84dbd5601f018baee2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56601eee/uploads/origins/aef8e4e5-87e2-4ab1-a36d-b1dcc6000e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a613f4ada72753deb823d5686eab403", "srcset": "https://si.imgix.net/56601eee/uploads/origins/aef8e4e5-87e2-4ab1-a36d-b1dcc6000e28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a613f4ada72753deb823d5686eab403, https://si.imgix.net/56601eee/uploads/origins/aef8e4e5-87e2-4ab1-a36d-b1dcc6000e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30984309f5c32a7c800fee7124b3201c 2x, https://si.imgix.net/56601eee/uploads/origins/aef8e4e5-87e2-4ab1-a36d-b1dcc6000e28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f46d11df0f9c2676af01829170ff9b1 3x"}, "body": "はじめまして。\nロゴの作成をしていただきたいです。\n\n内容：「浅い水屋さん」（あさいみずやさん）\n詳細：主にイラストを掲載する私のポートフォリオの名前です。漢字のふり仮名（あさ、みずや）もひらがなで入れていただきたいです。また、全体に白い縁取りも付けていただきたいです。\n経緯：キービジュアルにロゴを使用しようと思い自身で作成しましたが、素人故限界を感じ、この度ご依頼させていただこうと思いました。\n使用用途：ポートフォリオ、他サークル名としてイラストなどに使用する可能性あり。\n参考：私のポートフォリオを資料URLとして添付させていただきます。キービジュアルがラフの状態で申し訳ありませんが、ページを開いて最初に出てくるイラストにロゴを使用したいと思っております。\n　拙いながら私が作成したロゴも載せておりますので、空気感の参考にしていただければ幸いです。難しければ水のエフェクトなどは除いていただいて構いません。また、もし可能でしたら、ポートフォリオのテーマであるピンク色もロゴに少し入れていただきたいです。\n\n最後に：もし予算内でしたら、キービジュアルの上下に載っている「浅水のポートフォリオ」「ご依頼受付中！」も、簡単に文字の大小の緩急をつけていただけたら嬉しいです。\n\n長々と描きましたが、全て無視してご自由に作っていただいて構いません。\nご検討いただけたら幸いです。\n\nhttps://xfolio.jp/portfolio/Asamizu_noise", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 7565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🐇", "screen_name": "u_arca_u", "avatar_url": "https://pbs.twimg.com/profile_images/1605160738108035072/YMZZmIvG.png", "header_url": "https://pbs.twimg.com/profile_banners/1049340312571666436/1613799222/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1198750, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヤツメウナギ", "screen_name": "Lamprey_8", "avatar_url": "https://pbs.twimg.com/profile_images/1782375049250607105/k_K4kr5r.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4709905081/1738854033/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 1825019, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とのじ", "screen_name": "TOTOTOTO_TK", "avatar_url": "https://pbs.twimg.com/profile_images/1834564169791922176/k_MHE-ds.png", "header_url": "https://pbs.twimg.com/profile_banners/362002239/1739467323/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2890366, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "らめる🫧", "screen_na