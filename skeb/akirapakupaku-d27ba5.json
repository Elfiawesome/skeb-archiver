h=200&blur=200&s=c6f75d506e0cfe89f63c8d2699591af0", "srcset": "https://si.imgix.net/727306fe/uploads/origins/c6075fb3-baa4-4cd8-903d-271b7fba4010?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6f75d506e0cfe89f63c8d2699591af0, https://si.imgix.net/727306fe/uploads/origins/c6075fb3-baa4-4cd8-903d-271b7fba4010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33f443ac757e849764acf095265236a4 2x, https://si.imgix.net/727306fe/uploads/origins/c6075fb3-baa4-4cd8-903d-271b7fba4010?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da84c0b2d9303983e971d69ed434d21a 3x"}, "body": "リクエスト失礼致します\n\nペン画のイラストに惹かれました！\nocを描いていただきたいです\nかっこいい雰囲気であればどんなイラストでも嬉しいです！\n\nよろしくお願い致します\n\nhttps://drive.google.com/drive/folders/1RXtr-Ix4zHlieBJdVZ3u45ZxGahrrknq", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akirapakupaku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4073222, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2987158f9a70fbab50777cabe094259", "srcset": "https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2987158f9a70fbab50777cabe094259, https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38d820c09a4bd4e814a3ff701bd5cc50 2x, https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=181bdd7b95ce3fee46d4b7eb05aa3911 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1e0273816f68a81fff151d0afdbabc", "srcset": "https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1e0273816f68a81fff151d0afdbabc, https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b6b08491073e14b20f6130abd0a3198 2x, https://si.imgix.net/3c9de34b/uploads/origins/be06c948-0037-4a49-9af5-362f759e5f65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b06533d6310f8d82e2a7479809444dee 3x"}, "body": "翠煌先生初めまして。\n色気とメロさ溢れるペン画があまりにも素晴らしく、是非私のoc男性を先生の絵柄で拝見したい為リクエストを送らせて頂きます…！\n\n資料が少ないキャラクターですが、是非ご検討頂けましたら幸いです。\n\n■使用用途\n個人観賞用、SNSのアイコン、ヘッダー、壁紙(必ず先生のお名前・アカウント名を記載致します)\n\n■キャラクター名\nテネブラエ\n\n■設定\n男\n190⬆cm\n20代後半辺り\n\n⬛︎特徴\n人ではない(世界観でアン・デッドと呼称されている吸血鬼・悪魔のような存在)為、瞳孔が縦長です。\n\n■備考\n重度のメンヘラで被害者意識と思い込みの強いモラ気質です。\nパッと見はクール系ですが、好きな人以外に近寄られたり話しかけられたりすることが大嫌いなだけで、かなり感情的なキャラクターです。\nデフォの表情は不機嫌猫と言う感じで、近寄るなオーラが出ています。\n\n愛情を与えられたいテイカー気質で、生前は恋愛経験が豊富ですが上記のようにモラ気質なので短期間でフラれる→ヤケになって自宅監禁→愛してくれないなら要らない で殺人を繰り返していた猟奇人物です。\n(最終的に監禁していた女の子に背中を刺されました)\n\n現在は裏社会におり、表で可愛がっていた藍という女の子※を支えています。\n\n※藍…15歳くらいまで両親から監視を受けており、苦痛の末に両親を殺害して指名手配→裏社会でしか生きていけなくなりました\n彼女が20歳～あたりで恋敵含め3人で付き合っています。\n子どもに手を出さない倫理観はありますが、それ以外は変な男です。\n\n\n■モチーフ(作画の際に参考になる要素がございましたら…！いずれも描画必須ではございません)\n\nクロネコ\n黒い薔薇\nナイフ\nシルバーアクセ\n漆黒\n\n■構図\n先生のセンスにすべてお任せいたします！\n服装等も自由に弄って頂いて問題ございません。\n\n何か問題等ありましたら、再送して頂けたらと思います。何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1CCELZyZ3i25GPV53zf_26vRVN4Lm3R-5", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1057632, "creator": true, "nsfw_acceptab