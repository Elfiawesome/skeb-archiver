オンリヨーに憑依されているからなのだ。\n少女は、何が自分の行動で、何が幽霊によるものなのかわからなくなっている。そのため、彼女は非常に不規則な行動をとる。\n\n彼女を好きなように描いてください！\nポーズ、シナリオ、表情、すべてあなたの自由です！\n楽しんで描いてくださいね！\n\nありがとうございました😊。\n\nhttps://catbox.moe/c/47gwqr", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@irohazeTH/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3272705, "client_id": 2924414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d0284fcd/uploads/origins/2ef72005-4a77-48a3-94a0-48029712b6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a0ae7da64a30f1ab92864e497c4808e", "srcset": "https://si.imgix.net/d0284fcd/uploads/origins/2ef72005-4a77-48a3-94a0-48029712b6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a0ae7da64a30f1ab92864e497c4808e, https://si.imgix.net/d0284fcd/uploads/origins/2ef72005-4a77-48a3-94a0-48029712b6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26357abbf9a463103ba0e407b4ba9a6f 2x, https://si.imgix.net/d0284fcd/uploads/origins/2ef72005-4a77-48a3-94a0-48029712b6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad4493d458a712f29b595c4ccd261711 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0284fcd/uploads/origins/2ef72005-4a77-48a3-94a0-48029712b6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b29928337fb31899092272f3577c77f", "srcset": "https://si.imgix.net/d0284fcd/uploads/origins/2ef72005-4a77-48a3-94a0-48029712b6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7b29928337fb31899092272f3577c77f, https://si.imgix.net/d0284fcd/uploads/origins/2ef72005-4a77-48a3-94a0-48029712b6cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34e3c70ba06e2fe4cb8de046d9bbb943 2x, 