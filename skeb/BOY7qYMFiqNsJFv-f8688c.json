いボタンピンをつけており、アホゲは黒で3つの十字（X）が描かれています。体のあちこちに縫い目があり、顔の半分、肘から下の腕、膝から上の脚など、一部の部位は薄い灰色をしています。 彼女は長い爪を持っており、指のように2つの関節がある。肉球は黒色だ。顔の反対側と、反対側の脚には、暗灰色の縫い目のある布が貼られている。お腹からは詰め物がはみ出しているが、これはぬいぐるみの詰め物として描くことも、人間の内臓として描くこともできる。\n\nhttps://drive.google.com/drive/folders/1JNA8anG7sz6ruJObsd3Iyrrp4M9FSqPB?usp=drive_link", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BOY7qYMFiqNsJFv/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3380553, "client_id": 2591693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7be20d96/uploads/origins/d1967e09-1f81-4959-b4cd-68466046173f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6582e8f2bc182164fd79482492a8f206", "srcset": "https://si.imgix.net/7be20d96/uploads/origins/d1967e09-1f81-4959-b4cd-68466046173f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6582e8f2bc182164fd79482492a8f206, https://si.imgix.net/7be20d96/uploads/origins/d1967e09-1f81-4959-b4cd-68466046173f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deb4bf3f092e8189591ba63be9b5012a 2x, https://si.imgix.net/7be20d96/uploads/origins/d1967e09-1f81-4959-b4cd-68466046173f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=033c219c9283e18079a9a0bd661f1655 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7be20d96/uploads/origins/d1967e09-1f81-4959-b4cd-68466046173f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3cd16a66b64711c1f8e7278a98755b1", "srcset": "https://si.imgix.net/7be20d96/uploads/origins/d1967e09-1f81-4959-b4cd-68466046173f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3cd16a66b64711c1f8e7278a98755b1, https://si.imgix.net/7be20d96/uploads/origins/d1967e09-1f81-4959-b4cd-68466046173f?bg