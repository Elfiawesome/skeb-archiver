を基調としています。彼は幽霊調査員で、自身も霊であり、調査した霊とよく友達になります。身長175cm、赤褐色の髪、明るい紫の目。髪は短くカールしていて、目は優しい。以下に、インスピレーションを得るために、より多くの例をムードボードに残しておいた！\n\n彼のスタイルはとてもカジュアルですが、ちょっと控えめなパンクでもあります。服装は、大きなジャケットを着たいのですが、他のレイヤーに関しては、皆さんの創造力とアイデアを拝見したいです。服装の例を残しておいたけど、あなたが何を思いつくか見てみたい。あなたが以前作ったデザインが大好きです！\n\n本当にありがとうございました！\n\nhttps://imgur.com/a/spyru-character-reference-35HJghq", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ibara_380/works/143", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/93fb63b6/uploads/origins/072d5944-251c-411e-9cf6-6cc18020a4ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45ca2a15868d49600c28155a880893f3", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1984956, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ibara_380/works/142", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1984956, "client_id": 3231932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cbb7a6a/uploads/origins/3675a476-d8c5-44f6-9c8d-792a70ad5084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=637cdc1cd94ae48336799e8e5c8ec8a0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cbb7a6a/uploads/origins/3675a476-d8c5-44f6-9c8d-792a70ad5084?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f86042a66b0240f7e656d1cb1fe9cd9d", "src_set": ""}, "body": "こんにちは！あなたのイラストが大好きです！\n\nうちのメイブ( https://www.deviantart.com/stash/225wsizgcwtx )のイラストをお願いしたいです！\n\nメイヴは、生活費を稼ぐために格闘大会に参加している喧嘩屋です。\n彼女は自信に満ち、愛想がよく、社交的であるように見えるが、本心ではとても引っ込み思案で、社交的な状況、特に恋愛の経験が浅い。メーヴは、実際に信頼できる人があまりいないように感じている。\n\nポーズや構図はお任せします！よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ibara_380/works/141", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1984956, "client_id": 1910369, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e30fc16a/uploads/origins/b1605bf5-161f-4561-83f8-7572972dcc6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c818670a69ed1eede2451245e101cc38", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e30fc16a/uploads/origins/b1605bf5-161f-4561-83f8-7572972dcc6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a469e720038a0cd857a2daff6415ea5", "src_set": ""}, "body": "Hello again!\n\nI would love to get a picture of my OC, Lupe, holding both of her handguns! She is very devious and naughty.\n\nThank you for considering my request! \n\nhttps://drive.google.com/drive/folders/16_yQdlU_H0SedqE-4FNc1VBri7mrD750?usp=sharing\n\nhttps://drive.google.com/drive/folders/16_yQdlU_H0SedqE-4FNc1VBri7mrD750?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ibara_380/works/140", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1984956, "client_id": 915250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b27ccc0a/uploads/origins/144fcb1a-a8d7-4004-87fc-3743288aff7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a434f2cc0f2838de212513d7011e53d2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b27ccc0a/uploads/origins/144fcb1a-a8d7-4004-87fc-3743288aff