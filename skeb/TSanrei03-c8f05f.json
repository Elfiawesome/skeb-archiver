f9-699a-421a-82e6-44b2ee76d799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28d072adc0d1aaeb26c8df07920dabdb, https://si.imgix.net/ef3d9351/uploads/origins/7c3147f9-699a-421a-82e6-44b2ee76d799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c7d84dfc15c87fdb1704fc3c1ea5063 2x, https://si.imgix.net/ef3d9351/uploads/origins/7c3147f9-699a-421a-82e6-44b2ee76d799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5dca0f529ac5d2b001817af217df173a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef3d9351/uploads/origins/7c3147f9-699a-421a-82e6-44b2ee76d799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4919451e64a3ce563b4201109c7548c8", "srcset": "https://si.imgix.net/ef3d9351/uploads/origins/7c3147f9-699a-421a-82e6-44b2ee76d799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4919451e64a3ce563b4201109c7548c8, https://si.imgix.net/ef3d9351/uploads/origins/7c3147f9-699a-421a-82e6-44b2ee76d799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f990ad7e2627ffc4fa40d9982061c73 2x, https://si.imgix.net/ef3d9351/uploads/origins/7c3147f9-699a-421a-82e6-44b2ee76d799?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f97ad9ed7ad9a79d137880f6386178c6 3x"}, "body": "実はサキュバスの血筋だった男の子がサキュバスとして覚醒、エッチなコトがシたくてカラダの疼きを抑えられない爆乳お姉さんサキュバスになってしまう話をリクエストします。\n肉体と精神の変化をじっくり味わいたいので、その辺りの描写は特に重点的にお願いします。\n\n主人公がサキュバス化した後の瞳の色は紫、髪の毛も紫のロングヘアを想定しています。また、下腹部と胸元に淫紋が出現しているイメージもあります。", "nc": 56, "word_count": 6355, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@TSanrei03/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1612719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ae771bd/uploads/origin