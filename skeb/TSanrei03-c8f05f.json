いる…が…目を下に(足元の方に)向けると視界が無かったハズの胸の膨らみに遮られ、恐る恐る股間を手で確かめてみると…。\n\nなんかこんな感じのあらすじを良い感じに盛って頂けると嬉しいです。", "nc": 160, "word_count": 4212, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 201547, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ごみんと", "screen_name": "GmntTSF", "avatar_url": "https://pbs.twimg.com/profile_images/1904035045310164992/3OZaYJRk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1172146079946559488/1679212987/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 314192, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "おねショタ依頼ブーステッドマン「」", "screen_name": "oneshotaman", "avatar_url": "https://pbs.twimg.com/profile_images/1597960105781125121/POg6tHv8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2294257520/1667465427/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 185}, {"id": 1094696, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ジュウロク", "screen_name": "zyuroku2", "avatar_url": "https://pbs.twimg.com/profile_images/1995447425922973696/vYffO1Dn.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 80, "skills": [{"genre": "novel"}], "banned": false, "nc": 49}, {"id": 1930778, "crea