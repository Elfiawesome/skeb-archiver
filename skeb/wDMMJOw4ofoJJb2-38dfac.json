_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 609953, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "nom", "screen_name": "NomChan_V2", "avatar_url": "https://pbs.twimg.com/profile_images/1727045790185725952/0uTe4xJ5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1422950294753660935/1700613101/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1007494, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しゆしゆ Siyu2", "screen_name": "nijitama_siyu2", "avatar_url": "https://pbs.twimg.com/profile_images/666910741014802434/9SQoy8y4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/267458005/1661511782/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1589381, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "アスモ霰🔞", "screen_name": "hailasumo", "avatar_url": "https://pbs.twimg.com/profile_images/1668255502252253185/Cw5m2oQp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1398603764802617349/1747134257/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2999901, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ネクラズマ", "screen_name": "kkut112