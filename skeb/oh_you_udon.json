amount": 10000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@oh_you_udon/works/319", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 8285, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdac9495/uploads/origins/b48d31c9-28d7-487f-85e0-01d951511009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a330c265e558c47f2b451068a367fc4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdac9495/uploads/origins/b48d31c9-28d7-487f-85e0-01d951511009?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4dc580091323b820eee50dcb791bbefd", "src_set": ""}, "body": "良ければ下記内容が受理可能かご検討よろしくお願いします。\n\n◯キャラ\n下記の難民少女ネル。\nhttps://x.com/er450935/status/1887579569693336043?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\n◯作品\nテーマは苗床少女。\n下記のようなアングル、シチュで、洞窟の中で触手に捕まり、極太の触手を秘部にねじ込まれて激しくピストン、中出し、孕ませされているネルをお願いします。\nhttps://img.amiami.jp/images/product/review/252/LTD-FIG-10988_02.jpg", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_you_udon/works/318", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 8285, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7584d023/uploads/origins/5931a868-6428-4ffc-a221-3027ff4660f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44c9c10d0928b4053764273a2f30b8e4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7584d023/uploads/origins/5931a868-6428-4ffc-a221-3027ff4660f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2523dce95c5d70eb50b951af49d45eb", "src_set": ""}, "body": "https://skeb.jp/@oh_you_udon/works/309\n↑の続きをお願いします。\n\n出産が始まり、何時間も経過した金剛いろは。\nそんな中、拉致られ、新たに人間牧場に連れてこられるもこ田めめめ。\n\nいろはのすぐ隣に同じ体勢で拘束＋搾乳器の取り付けを行い、乳を出させる為に男に犯されるめめめ。\n\n必死に赤ちゃんを産んでいるいろはと、乳を出させる為に種付けされているめめめをお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_you_udon/works/317", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 8285, "client_id": 335896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bb5475e/uploads/origins/78aeb3b3-ad37-43e0-b38b-abda65d284cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b448ad5eba35e510ff4c07f2de9ecd6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bb5475e/uploads/origins/78aeb3b3-ad37-43e0-b38b-abda65d284cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e720275d6b54a8f61afab8b3db6e6ca", "src_set": ""}, "body": "◯キャラクター\n龍造寺ユイ(超昂大戦エスカレーションヒロインズ)\nhttps://escalationheroines.wikiru.jp/?%E3%83%93%E3%83%BC%E3%83%88%E3%83%96%E3%83%AC%E3%82%A4%E3%82%AB%E3%83%BC%E3%83%BB%E3%83%A6%E3%82%A4\nhttps://escalationheroines.wikiru.jp/attach2/E38393E383BCE38388E38396E383ACE382A4E382ABE383BCE383BBE383A6E382A4_E38393E383BCE38388E38396E383ACE382A4E382ABE383BCE383BBE383A6E382A4E7A781E69C8D2E706E67.png\n\n◯シチュエーション\nふたなり改造され、触手で搾精されている敗北BADEND的なシチュエーションをお願いします。\n・四肢を触手で絡め取られているか肉壁に埋め込まれて拘束されている\n・https://skeb.jp/@oh_you_udon/works/218 こちらの作品のような大きくてやや下向き勃起の玉付きふたなり\n・触手で犯されたり、玉を圧迫するような感じで責められたり(竿にはほぼノータッチ)しており、何度も射精させられている(前回依頼したメナドと同じような感じ)\n・絶頂しっぱなしで半分白目を剥いて涙を流している\n・服装の状態はおまかせ、肌露出多めを希望(ほぼ全裸でもOK)、変身後で描かれる場合は目を覆うバイザーはなしでお願いします\n・おっぱい、乳輪、乳首大きめを希望(https://skeb.jp/@oh_you_udon/works/168 こちらの作品と同じくらいかやや上回るくらいのサイズ感)\n\n◯差分の希望(可能であれば)\n・瞳の中にハートが浮かんでいる差分\n・レイプ目で涙を流しておりほぼ無反応になってしまった様子の表情差分\n・玉責めされ続けて勃起不全になり、半勃ち(大きくなっているが固くなっていない)ででろんと垂れ下がった状態でとぷとぷと吐精しているペニスの差分\n・妊娠ボテ腹差分", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_you_udon/works/316", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/af23ded5/uploads/origins/a60c7eb9-b1ac-4848-a4e4-1b26bbaaae2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c3f78b3d27ba4a82fa259b5fbfdfe628", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oh_you_udon/works/315", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f20e0a56/uploads/origins/884fead0-62d9-4456-bb1d-51fe9d4b327c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fc2fb4f0d9c8165708098cae1f6c341b", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 8285, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oh_you_udon/works/314", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 355723, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c99c4d2/uploads/origins/448600f9-80fb-4ff8-aa35-ac19f96d3569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc5ed14c45f6138dc4b3e3f83ef7f58a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c99c4d2/uploads/origins/448600f9-80fb-4ff8-aa35-ac19f96d3569?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12fc11271ed26f867aac50f8e465c72e", "src_set": ""}, "body": "今年もリクエストさせて頂きます。ご検討願います。\nNPCのため資料が少なく、URLには他のクリエイター様のイラストも掲載しております。\n\n◎キャラクター\n勝利の女神NIKKEよりレッドシューズ\n→公式動画：https://www.youtube.com/watch?v=6PdLfmxwZ5Y&t=2s&ab_channel=%E5%8B%9D%E5%88%A9%E3%81%AE%E5%A5%B3%E7%A5%9E%3ANIKKE\n\nピクシブ大百科https://dic.pixiv.net/a/%E3%83%AC%E3%83%83%E3%83%89%E3%82%B7%E3%83%A5%E3%83%BC%E3%82%BA%28%E5%8B%9D%E5%88%A9%E3%81%AE%E5%A5%B3%E7%A5%9E%3ANIKKE%29\n\n◎ふたなり化している状態。\nポーズはエロ蹲踞・M字開脚。レッドシューズの特徴的な武装脚がある程度映る構図でお願いします。\n胸は原作のように豊満で、スーツ越しに乳首が浮き上がるような状態。\n\n◎ふたなりペニスはメタルグレーや赤などモンスター的なデザイン。敵キャラである「ラプチャー」によって彼女に生やされたイメージです。\n→参考で代表的なラプチャーであるブラックスミスのURLを添付します。\nhttps://x.com/NIKKE_japan/status/1823540046294614065\n\n敵存在であるラプチャーと、メインキャラのシンデレラ＝アナキオールに心酔しているキャラです。表情は恍惚・狂気が混じるイメージです。\n\n◎台詞と差分。\n過去にシンのリクエストで使用頂いた台詞画面を流用して下さい。\n射精前台詞：「ああ、アナキオール…このラプチャーの力でもっと貴女を美しくしてあげますからね…！」\n射精後台詞：「妄想で射精してしまいました…。ああ、早く貴女を侵してあげますからね…」\n\nニケのキャラで一番好きなシンを描いて頂きましたが、お湯うどん様のメカ・ガジェット描写力・ふたなり要素はこのキャラクターにマッチするのではと思いリクエスト致しました。\nご検討よろしくお願いします。\n\nhttps://photos.app.goo.gl/RWwRMoDG5c9TUE7r9", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_you_udon/works/313", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ba1bf33/uploads/origins/046bf0de-d141-4865-a46f-d9b3b34d5723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4789c80549e17d9819eb6998a6fae843", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ba1bf33/uploads/origins/046bf0de-d141-4865-a46f-d9b3b34d5723?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d60a20cba05ae0add5b77b31f11d12aa", "src_set": ""}, "body": "はじめまして。 よろしければ下記の内容にてイラストの依頼をさせていただきたく存じます。 \n-------  \n【依頼概要】 \n個人で活動されているVTuber、浅瀬遊希さんの銭湯コラボ風イラストをお願いします。\n\n  【構図】\n ・全身（立ち絵風）\n\n  【外見イメージ】\n 基本的な容姿は遊希さんの現行の最新デザイン準拠。（髪をおろした姿） 金色の髪飾りは装着したままで、ウサ耳は外した状態でお願いします。  \n\n【服装】 \n服装は浴衣＋羽織のお風呂上りスタイルで、胸元は無防備にはだけている状態。（乳輪がギリギリ見えないくらい） 浴衣の色はダークレッド、帯や羽織は黒色。（浴衣の柄は牡丹をあしらったデザインが希望です） 足には下駄を履いている。\n\n  【その他・小道具など】 \n風呂上りらしく首にはタオルを。 また木製の風呂桶を小脇に抱えていて、桶の中には頭から外したウサ耳カチューシャといかがわしいローションのボトルが入っている。  \n\n【表情・シチュエーション】\n お風呂上りにバッタリ会ったリスナーに向かって妖艶に、いたずらっぽく微笑むイメージ \n\n 【備考】\n ・服装や小道具については筆が乗るようにアレンジしていただいて構いません。 \n・イメージとしてはアズールレーンの銭湯コラボ立ち絵が近いと思います。\n ------- \n何卒ご検討のほどよろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_you_udon/works/312", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03ec0205/uploads/origins/4ea8501d-fe4b-447c-96b4-ba9bf18e94d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f84c16afe5a11b56ee814126b0ee3eb9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03ec0205/uploads/origins/4ea8501d-fe4b-447c-96b4-ba9bf18e94d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbc531f60d5d397932592d53b8658e58", "src_set": ""}, "body": "良ければ下記内容が受理可能かご検討よろしくお願いします。\n\n◯概要\n女性上位逆レ、体格差騎乗位。\n\n◯キャラ\n・女\n下記の長身巨乳ムチムチな女騎士ディライナ。\n残忍で好色、非合法の任務に従事する騎士団の実働部隊長。\nhttps://x.com/er450935/status/1877019712007127432?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\n・竿役\n幼い少年、イメージは下記。\n黒髪に緑の瞳、素朴な村人。\nhttps://pbs.twimg.com/media/GVXqqEPboAAvSWE?format=jpg&name=900x900\n\n◯イラスト\n下記のような騎乗位。\n祈るように手を組み、怯えて命乞いする少年の小さなペニスをディライナが騎乗位で咥え込み激しく犯す。\nhttps://pbs.twimg.com/media/GhjfqJtacAE1ayn?format=jpg&name=large\n\n◯詳細\n・場所は焼け落ちた民家、又は焼け落ちた村の広場、又は野営テントの中。\n・前回のユーク王の命令で焼き討ちにされた村、村人を皆殺しにしろと命じられているがディライナの部隊は気に入った女子供を好き勝手に犯している。\n\n◯内容\n①腰を落として嬲るようにペニスを咥え込むディライナ。\nディライナ「震えちゃって…アタシの事が怖いんだろ？\nお前のパパをブチ犯して絞め殺した女のマンコでたっぷり可愛がってやるよ❤️」\n少年「ぁ…こ、…殺さない、で…」\n\n②胸を揺らして激しくピストン。\nディライナ「オラ！これが大人のセックスだぞ！\n小指みてぇな粗チン震わせて感じてんだろ！\n家族も！友達も！全部ブチ壊した女のマンコでチンポ感じてんだろ、ガキ！」\n少年「ぁ、ぁぁー！ぁ、ぁ、ぁー！」\n\n③未精通の少年が何度も絶頂する中、ディライナも絶頂して潮吹き。\nディライナ「ユーク陛下様々だよなぁ！好みのオスガキ喰い散らかし放題の仕事なんてよぉ！\nあーイク！マンコイク！イク、イぐぅぅぅぅ！！」\n\n④少し腰を浮かせると少年の萎えたチンポが抜け、膣から微かに精液が垂れる。\nディライナ「お、中で精通してるじゃん❤️\n仇のマンコは気持ち良かったみたいだなぁ…❤️」", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_you_udon/works/311", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/01fb3bbe/uploads/origins/e14a9831-f906-401d-aac5-25023154c01a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08ea75ec44758fc437f9569787e6fc86", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 8285, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oh_you_udon/works/310", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/742a0292/uploads/origins/48dbfda0-64f9-4c9a-a767-70f0983381bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3233e1c46cb4cf20007e83b2c412034", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oh_you_udo