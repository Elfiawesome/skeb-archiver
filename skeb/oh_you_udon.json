00&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ab406e616c01b2f68db577251698d58", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 8285, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oh_you_udon/works/293", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11ccc046/uploads/origins/87bca876-3b3d-4f0a-90a2-28996bf368c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d837eff8212351f1a666e62060796682", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11ccc046/uploads/origins/87bca876-3b3d-4f0a-90a2-28996bf368c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c74e571735cdbae7a589ee7bbb45cbdf", "src_set": ""}, "body": "良ければ下記内容が受理可能かご検討よろしくお願いします。\n\n◯キャラ\n・受け少年\n連合王国の少年王ユーク。\n賢王と呼ばれるほど優秀であったが、最近は側室スマールの快楽調教により愚王と化しつつある。\nペニスは歳の割には大きめ。\nhttps://x.com/er450935/status/1845923302130569327?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\nhttps://x.com/er450935/status/1846487878685409524?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\n・責め美女\nユークの側室スマール。\n爆乳ムチムチ長身の美女で、幼い頃から身体を改造し性技を叩き込まれている。\n連合掌握を狙う小国の出身で、ユークを快楽調教で骨抜きにしてゆく。\n身長はユークより頭ひとつほど高い。\nhttps://x.com/er450935/status/1840067195143106857?s=46&t=XZhK0QAD7iWUFRfjngt36w\n\n◯イラスト\n下記URLの下コマのように、壁を背に立たされたユークが横に立つスマールに勃起ペニスを手コキされるイラスト。\nhttps://pbs.twimg.com/media/GXxjKXCasAAIgCj?format=jpg&name=large\n\n◯内容\n非人道的な計画をユークに了承させるため、手でチンポを責め寸止めと囁きで洗脳してゆくスマール。\n\n①我慢汁を垂らしフル勃起したチンポの亀頭を掌で、乳首を指でさすりながら耳元に囁くスマール。\nスマール「最近、陛下に不満を持つ連中が潜伏している村があるそうですわ…軍を派遣して焼いてはいかが？」\nユーク「ハァ、ハァ…そ、そんな事、したら…民が…」\n\n②指で輪っかを作り亀頭を扱くスマール、更に我慢汁を漏らしチンポを硬くするユーク。\nスマール「民ごと焼けば良いのですわ❤️\nほら、陛下の逞しいオチンポ様もイきたがってる…首を縦に振るだけで気持ち良くビュッビュ出来ますのに」\nユーク「ぁ…ぅ、で、でもぉ…」\n\n③尿道に指を突き立てるスマール、ユークはたまらず首を縦に振る。\nスマール「強情ですわねぇ…もうオマンコさせてあげませんわよ？」\nユーク「んぃぃっ❤️焼く❤️焼くからっ❤️オマンコして❤️オマンコ入れさせてぇ❤️」\n\n④呆れたように手を離しスマールは耳元で命令、するとユークは触れられてもいないのに痙攣しながら射精してしまう。\nスマール「堪え性がありませんわね、この雑魚チンポは…ほら、もうイけ、射精しろマゾガキ」\nユーク「あっ❤️あああああっ❤️」", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oh_you_udon/works/292", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/95d388d6/uploads/origins/1031036e-eaf4-4c48-9626-f0c392d804da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91653c61cd4c3d8a41b7d13c0eb8d170", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 312600, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oh_you_udon/works/291", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5f59b4a4/uploads/origins/b3779f9d-c080-41e6-8cec-a75a13db8591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d89c5639ee77402b03f23833c80a169", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 8285, "client_id": 86780, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@oh_you_udon/works/290", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8285, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d3a3b69/uploads/origins/3ca82957-7180-4313-a95b-7b0a7a6e6c2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=534477ecfbaefc87f58cdb03a3d5fd35", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d3a3b69/uploads/origins/3ca82957-7180-4313-a95b-7b0a7a6e6c2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fc1434d688a97701d4f4504d0148dd2", "src_set": ""}, "body": "描いてほしいキャラクターは漫画\n「古見さんは、コミュ症です。」のヒロイン古見硝子と只野父です。\n\n只野父は本誌描写が少ないので調べても出てこないですが\n「第一回！笑っちゃダメよ！in只野家」で検索して\nツイマンガで少し映ってる程度の顔です\n正直おっさんで大丈夫です\n\n種無しがわかり、義父に種付けをお願いするお話です。\n\n\n一枚目参考https://www.pixiv.net/artworks/105700269\n参考絵上のような只野家がリビングで話す感じで白黒なりめっちゃラフで大丈夫です。\n只野父「そうか…子供が…人工授精もお金かかるのか…」\n只野母「そうだわ！ウチの旦那とかどうかしら昔から性欲強いし」\nナレーション（こうして、今夜から古見さんが僕の家に泊まり\n父と子作りをすることになった）\n\n参考絵上https://www.pixiv.net/artworks/113325020\n古見「お、大きい」\n父（こんな綺麗な子が息子の彼女か…）（スタイルも良いし…興奮してきた…）\n\n参考絵https://www.pixiv.net/artworks/110620770\n父「じゃー挿入するな」\n古見「ま、まってください…お義父さん…やっぱり…怖いです…」\n只野「親父！…挿入はしないで、精液だけ、かける事はできないか…」\n\n二枚目＋差分参考絵https://www.pixiv.net/artworks/119037037\n古見「お義父さん…ここにください」（すごい大きい…触れそうな距離…）\nシコシコ\n父「こんなんで妊娠するといいけどな…」（くぅ…挿入してぇ…）\n精液をかけられ\n古見「たくさん…ありがとうございます」（熱くて…すごい臭い♡）\nチンコをぐいぐい当てる\n父「少しぐらい、やっぱり中に入れとかないと妊娠できんかもな」（このまま挿入だ！）\n古見「あ、あのお義父さん今日はここまでで…」（このままじゃ…はぁはぁ♡わたし…♡）\n\n差分種付けプレス挿入\nhttps://www.pixiv.net/artworks/102092934\n只野「まって親父！やっぱり最後までしよう」（はぁはぁ///興奮が止まらない）\n父「いいね！もう、我慢の限界だったんだ、息子の彼女を犯したくてたまらない\nたっぷり膣内にだしてあげるからね」\nドク♡ドク♡ビュービュー♡\n古見「大きい…お義父さんのおちんちん種付け中出し気持ちいい♡」\n\n\nセリフは適当です追加効果音などあればうれしいです。\n枚数が多いので只野の有無はお任せで\n描いてほしい案がありすぎて申し訳ないですコミックにするか、一枚にギュッとするか\nお任せします料金＋再送依頼も待つつもりです。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 284047, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あすく＠skeb募集中", "screen_name"