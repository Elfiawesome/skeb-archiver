fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=89317132db652d4bdeec73fb32b85199, https://si.imgix.net/f4791896/uploads/origins/474418c3-ec66-4b48-9872-929e32195c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d013120651d72e5522a4d8ef54fc0122 2x, https://si.imgix.net/f4791896/uploads/origins/474418c3-ec66-4b48-9872-929e32195c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89fc24428a5204dc2ed6db4fab86a119 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4791896/uploads/origins/474418c3-ec66-4b48-9872-929e32195c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a70f5e048e91734be65b7da44c691fe0", "srcset": "https://si.imgix.net/f4791896/uploads/origins/474418c3-ec66-4b48-9872-929e32195c32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a70f5e048e91734be65b7da44c691fe0, https://si.imgix.net/f4791896/uploads/origins/474418c3-ec66-4b48-9872-929e32195c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=325a6b4948cf0beebcfecf51f76b0831 2x, https://si.imgix.net/f4791896/uploads/origins/474418c3-ec66-4b48-9872-929e32195c32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbd6306a5d2a033da4855cda4efb9e8 3x"}, "body": "fujishimaさん初めまして！\nアピールありがとうございます！\nVRをマイペースに楽しんでいるくろすえと申します！\nfujishimaさんがこれまで描かれたイラストを見させていただき、雰囲気が好みなので依頼させていただきました！\n\n・概要\nVRChatというVRSNSで使用している私のアバターと推しのfeathさんのアバターのツーショットイラスト\n※ご本人から許可を頂いております。\n\n・用途\nSNSへの掲載\nモデルになった方へのプレゼント\nVRChatの自作ホームワールド(検索では表示されない非公開設定)への掲載\n※公開・配信・商用利用などの目的ではなく、個人観賞用の展示です。\n\n・キャラクター詳細\nくろすえ\n　- シルバーフレーム眼鏡、太眉、タレ目、人間耳あり\n　- イヤリングは右耳のみ、猫型ネックレス\n　- 詳細は資料URL参照\n\nfeathさん\n　- イヤリングは左耳のみ\n　- 詳細は資料URL参照\n\n・服装\nキャラクター詳細に記載したアクセサリ類は省略しないでいただけると嬉しいです。構図的に見えなくなるのは問題ありません。\n服装等のディテールについては自由にアレンジしていただいて大丈夫です。\n\n・希望する構図\n通常の頭身\n身長はほぼ同じで、若干くろすえの方が低い\n二人のイヤリングが見える構図\n自室等のプライベートな空間でイチャイチャしている\n※これが描きたい！というのがありましたら他のシチュでイチャイチャしているものでも大丈夫です\n\n・希望する表情差分\nお任せします\n\n・背景\nお任せします\n\n・その他\n可能であればキャラクターと背景でレイヤー分けしたPSD形式だと嬉しいです。\n\nご検討、是非ともよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ABXPAHgKHvvJ4XWLd7Lzs0zFM567vw10?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nooimo_nolife/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3694901, "client_id": 978888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eff32e7473b6d17a3f7370f20aa688c", "srcset": "https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0eff32e7473b6d17a3f7370f20aa688c, https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b32d367ce7ec3124c24c81300aaada3a 2x, https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48afd5fc32168f1add61cd670c4f08ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb2454f5f59b34af65ec0e030b23f728", "srcset": "https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb2454f5f59b34af65ec0e030b23f728, https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b1d7b1b069b29c2df275b875583c7fa 2x, https://si.imgix.net/cc31d03f/uploads/origins/cb66beb8-16e3-4a11-ac85-c3ef92d3517d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=320d725963fc69c4cf54af620fece33c 3x"}, "body": "アピールが受け取りしました。パジャマを着たし自宅では甘いお菓子を食べたりのミハイルちゃんは可愛いと思います、興味があるです。Fujishimaさんの絵柄もいい感じと思います。是非あのようなミハイルちゃんが描きください、おすきに！\n\nhttps://imgur.com/a/IA1P8P9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nooimo_nolife/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3694901, "client_id": 1673308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49f66f648a4c178956570d4a8289f611", "srcset": "https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49f66f648a4c178956570d4a8289f611, https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=542751900acf60e084b0beb0bb149526 2x, https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cae848a6f4f417074e23dafa6bf70102 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a3a3af8bfc2ba877787d860d5881fb", "srcset": "https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a3a3af8bfc2ba877787d860d5881fb, https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3fe8131a87312d5d5547def47d1e434 2x, https://si.imgix.net/9107c80a/uploads/origins/17bca6e5-6866-4f7f-acd8-856baba0e775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2dbf222394a211ef1f8ba6f3df1c1938 3x"}, "body": "fujishima先生\n\nはじめまして。アピールありがとうございます！\nXのイラストを拝見して、ぜひ fujishima先生に友人と作成したOC3人のイラストを描いていただきたいなと思い、依頼をおくらせていただきました。\n\n●キャラクターについて\nホラーコメディスプラッター洋画チックな世界観のキャラクターです。表向きはアイスクリーム屋さん、裏では依頼を受けて人を誘拐したり殺したりする犯罪者・殺人鬼です。\n\n（友人のOC）【1人目】ベラ・アイネルス｜182cm・女\nイメージカクテル：ピニャコラーダ\nオススメフレーバー：ココナッツミルク＆パイナップル\n元死体運び屋。アイス屋創設者。\n2人をスカウトしたものベラ。ノリがよく、楽観的な性格。\n2人が好きでいつもちょっかいをかけており、おふざけで愛を囁いてみたり、ボディタッチが多い。\n三人の中で一番筋肉質。\n\n（友人のOC）【2人目】キアラ・マーティン｜179cm・女\nイメージカクテル：チャイナブルー\nオススメフレーバー：トマト・タバスコ\n元軍人。利己的な人間。客に対してもぶっきらぼうで口調が少々荒い。\nだが、仲間思いであり何だかんだ一緒に働いてくれている。\n三人の中で一番スレンダー。\n\n【3人目】アシャ・フィスク｜150cm・女\nイメージカクテル：カシスソーダ\nオススメフレーバー：カシスベリーソーダ\n元ベビーシッター。童顔だが体は成熟している、アイスクリーム屋さんの看板娘。\n少々メスガキっぽさがあるが、沸点は高め。ムードメーカー。\n三人の中で一番肉付きが良い。黒手袋してます！\n\nfujishima先生のお好きに描いていただければと思います！3人の体が入るような1枚絵、難しければ3人分のアイドルチェキ（上半身でファンサのようなポーズを決めている感じ）のようなイラストをお願いします！\nビキニのデザインはお好みに変えていただいても構いません！\n\nhttps://drive.google.com/drive/folders/10RmalpDece28vmtEnWF7hxRxMnaGKtL4?usp=sharing", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nooimo_nolife/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3694901, "client_id": 20169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/266d1d79/uploads/origins/63b0d93e-dc54-4fc5-b638-275c83b86ec9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e596cb867105c3855968e34599a147f", "srcset": "https://si.imgix.net/266d1d79/uploads/origins/63b0d93e-dc54-