キの顔を付けたようなもの（それぞれの顎に上下に分かれたカジキの顎を接合したようなイメージ）で4つ目になる）\n\n分かりにくいと思いますが縁があればよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Z47458030/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3116132, "client_id": 2540647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65050ca535383df02b457c07c6fd4d53", "srcset": "https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65050ca535383df02b457c07c6fd4d53, https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffe5df7550618e59d60e8c6ec97f010b 2x, https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da70ec716034ab73f322dc1ce05a836c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e98f5cf693cc67f7f58ccc59a9a7b7eb", "srcset": "https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e98f5cf693cc67f7f58ccc59a9a7b7eb, https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86a2952acf8190f4b5c838d681cbe80e 2x, https://si.imgix.net/99895332/uploads/origins/8671f04c-94f0-474c-a968-fa28a06cc63d?bg=%23fff&auto=for