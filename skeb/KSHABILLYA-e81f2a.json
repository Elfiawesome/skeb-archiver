ww.dropbox.com/sh/jabipjf23h3nxph/AABHXwJQLSen-4rmDT6jfoLma?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KSHABILLYA/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2764641, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376d484a22cc40d959f06b5b69643179", "srcset": "https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=376d484a22cc40d959f06b5b69643179, https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89e094c265ff7fffba300a0ebc472888 2x, https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56b94095955578786d7e8f3a12df2717 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d08689294520a93e7187194d074cdf2", "srcset": "https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d08689294520a93e7187194d074cdf2, https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6dbb1836c12d35f60316e00bf1240cf9 2x, https://si.imgix.net/fcfe4535/uploads/origins/2402e143-63d7-4f88-a01b-82bda2b88c3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dcb5955606b1628a1beb7fae29dff995 3x"}, "body": "はじめまして、いつも先生のTwitter楽しく拝見しております。\nふと久しぶりにコロコロコミックを購入した際、先生の描かれる漫画の躍動感とキャラクターのかわいらしさ、かっこよさ、そして洗練された線画に心惹かれ、全巻購入させていただきました。\n先生のタイムラプスをいつもわくわくしながら観ております。\n\n今回skebのリクエストの募集を始められたと拝見して、先生の絵柄でTRPGに使用しているオリジナルキャラクターたちのイラストが是非見られたら、と思いリクエストをお送りいたします。\n\n友人のオリジナルキャラクターと私のオリジナルキャラクターの二人組です。\n（友人には許可を頂いており、友人のイラストも資料にまとめております。）\n\n二人とも30過ぎの刑事で、金髪のキャラクターはメタル好きの明るい（が少し神経質な）ギークで、\n茶髪のキャラクターは軟派で砕けた態度（だけど情に厚く勘が鋭い）の青年です。\nちょっとドタバタした仲良しコンビ、というイメージでお描き頂ければ…！\n構図はお任せいたします！\nモノクロ、カラーもお任せします！\n構図の指定があったほうが良い場合は、大型のアメリカンバイクに二ケツ……とか！と思っています。\n\n描いていただいたイラストは個人利用の範囲内でツイートするかもしれませんが、その際は先生のアカウントを必ず併記いたします。\nご検討のほどよろしくお願いします。\n\n末永く応援しております！\n\nhttps://drive.google.com/drive/folders/1EVhclgoTFdjfyqgfApgBRhawBdbfdgVe?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KSHABILLYA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2764641, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ee2a0a9/uploads/origins/53cb8906-a92a-4463-996a-2502c42281ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5cd619a09435ecb82790de47e3bdd2", "srcset": "https://si.imgix.net/4ee2a0a9/uploads/origins/53cb8906-a92a-4463-996a-2502c42281ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a5cd619a09435ecb82790de47e3bdd2, https://si.imgix.net/4ee2a0a9/uploads/origins/53cb8906-a92a-4463-996a-2502c42281ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fde4d6ab15529be16b30f52dc8bf4cb4 2x, https://si.imgix.net/4ee2a0a9/uploads/origins/53cb8906-a92a-4463-996a-2502c42281ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc002c3310d7c29885a0de22bb27d14b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ee2a0a9/uploads/ori