について\n\nXのヘッダーでは左下にプロフィールアイコンが重なるため、ロッシは中央〜やや右寄りに配置していただけると嬉しいです。\n\nまた、顔部分をアイコンとしてトリミングして使用できるよう、可能でしたら顔・髪・耳などが綺麗に収まり、十分な画質を確保できる程度の大きさにしていただけると嬉しいです。\n\n細かなポーズや身体の向き、シッポの形、お花の種類、背景や光の表現などは、こもりさんにお任せしたいです！\n\nよろしくお願いします(*>▽<*)", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komori_yuki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3943370, "client_id": 3331711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3b1bd87/uploads/origins/cd9f73e3-a85a-4d7d-94da-3bd43de4ac11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c1aab29d77d39aa748031821bae1f2", "srcset": "https://si.imgix.net/a3b1bd87/uploads/origins/cd9f73e3-a85a-4d7d-94da-3bd43de4ac11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c1aab29d77d39aa748031821bae1f2, https://si.imgix.net/a3b1bd87/uploads/origins/cd9f73e3-a85a-4d7d-94da-3bd43de4ac11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ae95b3051c04cdff46ceb6e2d0248d6 2x, https://si.imgix.net/a3b1bd87/uploads/origins/cd9f73e3-a85a-4d7d-94da-3bd43de4ac11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fb168acb07c657dd3a1950dd705b531 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3b1bd87/uploads/origins/cd9f73e3-a85a-4d7d-94da-3bd43de4ac11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5feb6d65df4f9f2cf4be2bddcd7c04fc", "srcset": "https://si.imgix.net/a3b1bd87/uploads/origins/cd9f73e3-a85a-4d7d-94da-3bd43de4ac11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5feb6d65df4f9f2cf4be2bddcd7c04fc, https://si.imgix.net/a3b1bd87/uploads/origins/cd9f73e3-a85a-4d7d-94da-3bd43de4ac11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=2