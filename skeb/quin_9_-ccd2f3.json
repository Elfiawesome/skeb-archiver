で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@quin_9_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3649195, "client_id": 1753011, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48bed7f8/uploads/origins/103fdf99-ea6c-48a9-b1d8-be211e7e246f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd76f66edc923b96c249b122ae2594a7", "srcset": "https://si.imgix.net/48bed7f8/uploads/origins/103fdf99-ea6c-48a9-b1d8-be211e7e246f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd76f66edc923b96c249b122ae2594a7, https://si.imgix.net/48bed7f8/uploads/origins/103fdf99-ea6c-48a9-b1d8-be211e7e246f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40b308c4a692af915c251d6a840d5066 2x, https://si.imgix.net/48bed7f8/uploads/origins/103fdf99-ea6c-48a9-b1d8-be211e7e246f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afbe8520f0683e6d65056e61194e177d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48bed7f8/uploads/origins/103fdf99-ea6c-48a9-b1d8-be211e7e246f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06ba3361e9b6b5a85f91b6f68faebef1", "srcset": "https://si.imgix.net/48bed7f8/uploads/origins/103fdf99-ea6c-48a9-b1d8-be211e7e246f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06ba3361e9b6b5a85f91b6f68faebef1, https://si.imgix.net/48bed7f8/uplo