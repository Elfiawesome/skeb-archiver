6/uploads/origins/78e07813-68e6-4c7f-8ba2-01e6078ed6d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8822978821ca8c61648ecc0ae9b948be, https://si.imgix.net/3c920e66/uploads/origins/78e07813-68e6-4c7f-8ba2-01e6078ed6d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0aed56b0ddfb8d949fd8922c3d200d30 2x, https://si.imgix.net/3c920e66/uploads/origins/78e07813-68e6-4c7f-8ba2-01e6078ed6d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e58b21035ce69f48582141996ce5d54f 3x"}, "body": "初めまして、佳虫と申します\n俺タワーでオヤカタをやっておりました\n建姫のくノ一姉妹やポンチ師匠、魔塔放送部やノギスといった素敵な建姫たちを生み出してくれて感謝の気持ちでいっぱいです！\n\n今回この形で依頼を絵師様にお願いするのはとてもドキドキしていますが依頼してみたいと思います\n\n「何らかの力が働いて魔塔サイズに巨大化した鉋姉さんが何かをしでかして魔塔に隠れたと思われるオヤカタを外から覗き込んで探っている様子」をお願いします\n鉋姉さんは片目を開いて覗き込んでることでオヤカタが何かやらかした感がでているととてもいいと思います\n\nシチュエーションがシチュエーションなのでダメと思われたら断っていただいても大丈夫です\n\nよろしければお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@quin_9_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3649195, "client_id": 600676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1309d98142be450ea06a7eef6b07700", "srcset": "https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1309d98142be450ea06a7eef6b07700, https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31e04bec2ec85f80e9348ae38c931145 2x, https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ad12af2d5cb62216f1b050a3fdd1be9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e334094b81682ab612d909a36db9512", "srcset": "https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e334094b81682ab612d909a36db9512, https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91ec33b91ce049545cb6d3961499eed8 2x, https://si.imgix.net/7ff8558c/uploads/origins/2b60c9f8-7eb5-410b-891c-e7ba8bb8bc3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5317c66cfc2de6b83bb58f1b96567b76 3x"}, "body": "いつもお世話になっております\n改めてイラストのご依頼になります\n\n<キャラ>\n毎日こつこつ俺タワーのクラムシェル\n\n<お題>\nもし九印先生にクラムシェル(亜種)を描いて\n頂いた場合のクラムシェルの(浴場イラスト)\n\n※まいこつは全年齢のゲームですので\n先生の思うまいこつレベルの感じでお願いします\n\n※もし可能なら、通常版の浴場絵よりも少し大人で少し髪の長い感じでお願いしたいです\n(他の特種の浴場イラストを見ると通常版と比較して事務所に落ち着いた後とか少し成長した版の様なイメージを感じることが多いためになります)\n\n※今回の依頼の背景としまして、先生の鉋ちゃんやポンチ師匠にノギスちゃんなどの特種の浴場イラストの淡い感じが個人的にとても好きなので是非先生に描いて頂いた版を見てみたいという点が大きいので先生のおもうお好きな浴場絵の感じで\nお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@quin_9_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3649195, "client_id": 600676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fb177d5/uploads/origins/757c4f93-1a03-4291-ba9f-0d8f8c38f2f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e41ad1d8dc7ae96c08a7eb5bfe5cc0b", "srcset": "https://si.imgix.net/2fb177d5/uploads/origins/757c4f93-1a03-4291-ba9f-0d8f8c38f2f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro