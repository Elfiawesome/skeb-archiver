82-84bf994e5ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b939ceb6b3564792397d3356644d46b, https://si.imgix.net/3b1aa6bb/uploads/origins/b210b34e-7c8e-4fc6-8a82-84bf994e5ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=217598f538ec50dcb3a0994dab7397a9 2x, https://si.imgix.net/3b1aa6bb/uploads/origins/b210b34e-7c8e-4fc6-8a82-84bf994e5ab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bae5c9b4959553b1e9fd42c39ca84e82 3x"}, "body": "前回の依頼イラスト(https://skeb.jp/@Phyz_Roze/works/2)の続きイラストをお願いします！\n\nイラストは5コマ構成で\nコマ割りは縦に3段で\n1, 2段目は2コマずつ(コマごとの横幅は同じ)\n3段目は1コマの計5コマとなります。\n段の縦幅は全て同じでお願いします！\n\nコマの内容は以下の通りです。\n(資料URLのイラストと同じようなコマ割りや内容です)\n\n1, 2段目の計4コマ\n星ブドウさんのドルにぇちゃんの喉穴といびきで揺れるのどちんこ。\n\nアングルは前回の3コマ目と全く同じアングルでお願いします！\nまた、舌の描写や、のどちんこの形、喉穴の大きさ、そして色使いなどの描写は前回の3コマ目と全く同じようにして欲しいです‼︎\nまた、「Zzz」などの文字の描写は無しでお願いします！\n\n1, 2段目の1コマ目は、それぞれのどちんこが真正面から見て右、\n2コマ目は左に少しだけ揺れている感じでお願いします！\nこちらも残像の描写は無しでお願いします！\n\n3段目\nロマにぇちゃんが「まーたお口開けて寝てる…全くだらしない…」というような表情をしているのをドルにぇちゃんのお口の中からの目線で見た描写。 ロマにぇちゃんはまるでドルにぇちゃんのお口のなかを覗き込んでいるような感じでお願いします！  \nドルにぇちゃんの自慢のギザ歯、丈夫な奥歯も映ってると嬉しいです。\n\n前回と同じように、虫歯になっている差分もお願いします！\n\nそして、このイラストとは別に\n本イラストの1段目1コマ目と1段目2コマ目を、\nコマの大きさが同じ2コマ構成で配置したイラストもお願いします！\n\nよろしくお願いします！\n\nhttps://skeb.jp/@kokemushi_R/works/114", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Phyz_Roze/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3095562, "client_id": 2901806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd7ce000f984fc1a9faa872c19a569c4", "srcset": "https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd7ce000f984fc1a9faa872c19a569c4, https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=90c4c0699111253a3dabecf73ddc8723 2x, https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b101e43f5aa393aa1d97177e1704682 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eb24cad79160f9b30cb025399db811a", "srcset": "https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eb24cad79160f9b30cb025399db811a, https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7be01fb26ada8ce89df92bc400b4366e 2x, https://si.imgix.net/7e0eddef/uploads/origins/7326299f-add4-498e-9713-c0d50f75a376?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e8070b9a0cba47ffe469be650ca973d 3x"}, "body": "星ブドウさん(@grapebudou)のドルにぇちゃんが、喉穴がはっきり見えるほど大きなお口を開けながらいびきをかいて爆睡しているイラストをお願いします！\n星ブドウさんにもキャラ貸しのOK頂いております🍇\n\nイラストは3コマ構成で、コマの大きさは全て同じでお願いします！\n\n1コマ目は\nお口を開けたまま寝ているドルにぇちゃんの顔の描写。構図は資料URLの「顔」という文字が入った画像のような感じです。\n\n2コマ目は\n喉穴が見えるほどはっきり開いたドルにぇちゃんのお口。構図は資料URLの「口周り」という文字が入った画像のような感じです。\nドルにぇちゃんのお口をコマいっぱいに描いて欲しいです！\nまた、口蓋垂はいびきでぷるるんと少し揺れている描写も入れて欲しいです！\n\n3コマ目は\nドルにぇちゃんの喉穴の描写。構図は資料URLの「喉」という文字が入った画像のような感じです。\nこちらもドルにぇちゃんの喉穴をコマいっぱいに、そして口蓋垂は2コマ目と同様いびきで少しぷるるんと揺れている描写をお願いします。\n\nまた、ドルにぇちゃんの歯が綺麗なバージョンと虫歯で汚れたバージョンの差分を一枚ずつお願いします！\nそして、口蓋垂がぷるるんと揺れている描写については、残像の描写は無しでお願いします！\n\nドルにぇちゃんのキャラ・歯の資料:\nhttps://drive.google.com/drive/folders/1C5VQeCxsmP8v4JuzwdsNdL50bb45E2zR\n\nよろしくお願いします‼︎\n\nhttps://x.com/zivavorefan/status/1884197995991957707?s=46&t=EvkjwesGN-bdahugIKUCcQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Phyz_Roze/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3095562, "client_id": 629765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-48ed-86bb-523be8507484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b843bb659cb6acffae27375190d77a1", "srcset": "https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-48ed-86bb-523be8507484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b843bb659cb6acffae27375190d77a1, https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-48ed-86bb-523be8507484?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8408abc05a50369d7bf61185ac142c2 2x, https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-48ed-86bb-523be8507484?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cf014b552e6fbc1d3c4c3bf15cdda3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-48ed-86bb-523be8507484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2137f47e3607a02cc7088208679d0fc", "srcset": "https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-48ed-86bb-523be8507484?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2137f47e3607a02cc7088208679d0fc, https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-48ed-86bb-523be8507484?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db4a2345fbdeecc5e95cf1248f068ab7 2x, https://si.imgix.net/5d9a88de/uploads/origins/789eff9b-c296-