の個人使用です。グッズ化などは考えていません。\n長文にて失礼しました。お忙しいかと存じますが、よろしくお願いいたします。\n\nhttps://x.com/fsmch/status/1733427045596815794?s=46&t=_4XUnM1oYcS1FdaXCIxsKg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 2066457, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まこと", "screen_name": "makotouF", "avatar_url": "https://pbs.twimg.com/profile_images/907620067176628224/WbaKUrUy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/127184518/1598379432/1500x500", "appeal_receivable": false, "popular_creator_rank": 80, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2616033, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鯔背わや", "screen_name": "hu_nhey", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fc6bee8c4-a14b-4c84-8654-fc681dd01c4b.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/e386596e-44c0-401c-a2b3-52d64770b39c.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2924845, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "じゴ", "screen_name": "Ureyyyyy_", "avatar_url": "https://pbs.twimg.com/profile_images/1705186973915422720/xeoc52A0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1617491384734470144/1723210348/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days"