fit=crop&crop=top&w=200&h=200&s=4630f3cbd9ef7fd98e790839c0c0fd38, https://si.imgix.net/2f871c55/requests/267477_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcec5ec0082d2db83c28c8c2a20d535b 2x, https://si.imgix.net/2f871c55/requests/267477_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9dee3edfc865050d504f5b50984a48d0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f871c55/requests/267477_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed3c9fe2cf0689275035b04c6ae81a5", "srcset": "https://si.imgix.net/2f871c55/requests/267477_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed3c9fe2cf0689275035b04c6ae81a5, https://si.imgix.net/2f871c55/requests/267477_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f296073fcdb50fc14496fd241ce7555 2x, https://si.imgix.net/2f871c55/requests/267477_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7090535cc2bfdc698c2f318d4999c71 3x"}, "body": "ダイパリメイク発表ということで、ポケモンのスズナをお願いいたします。\n以前描かれた腋毛と爆乳の上半身の魅せ方が素晴らしかったので、今度は下半身特化でお願いしたいと思います。\n\n・スカートを自分でめくって、股を開いて縞々パンツの股間を見せている感じでお願いします。陰毛が透けて見え、パンツの隙間からハミ毛している感じでお願いします。\n・靴を脱いで靴下は履いたままの足裏を見せて下さい。靴下の足裏は汚れ気味で、蒸れて湯気がたって足も股間もにおってる感じでお願いします。\n・おっぱいは露出してもしてなくてもお任せします。以前と同じく盛り盛りでお願いします。\n・表情は以前と同じく挑発というか誘惑している感じでお願いします。公式設定ではスズナの眉毛はやや太いので、太眉にすると他の毛も毛深そうな感じが出てそそるのでお願いします。\n・もし可能であれば足コキ差分もお願いしたく思います。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2000mitrasi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 738845, "client_id": 741655, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8b6893d/requests/267535_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=