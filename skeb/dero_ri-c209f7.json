ピチピチの服にしたい。\n\nパンツとストッキングの部分は、ティファと同じアイデアで、よりシンプルにします。\n靴がある場合は、ティファと同じものを参考にしつつ、オリジナルのデザインにすることができます。\n\n最後に彼女の武器です。スタッフの武器は、あなたの一般的なアイデアの参考になりますが、あなた自身のデザインで。\n\nColor（色）については、良いコントラストを保つように心がけましょう。\n\nポーズについては、何がベストなのかを判断してもらうことにしています。\n\nありがとうございます\n\nhttps://drive.google.com/drive/folders/14lbkKAKm6mKIxU27sImWmRftTaVhHTPW?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dero_ri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 626413, "client_id": 267144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7721ba3f/uploads/origins/c0c65388-bf74-4aec-8b1c-64a265c1e758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9163ab5360c5696f9adb8571555efd8", "srcset": "https://si.imgix.net/7721ba3f/uploads/origins/c0c65388-bf74-4aec-8b1c-64a265c1e758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9163ab5360c5696f9adb8571555efd8, https://si.imgix.net/7721ba3f/uploads/origins/c0c65388-bf74-4aec-8b1c-64a265c1e758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c047bf1ac36448400875694a464ea106 2x, https://si.imgix.net/7721ba3f/uploads/origins/c0c65388-bf74-4aec-8b1c-64a265c1e758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81c2636c538da4f6157e07b50b1dff0f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7721ba3f/uploads/origins/c0c65388-bf74-4aec-8b1c-64a265c1e758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=487c9cc46fc9edf754d68dd8f1836e80", "srcset": "https://si.imgix.net/7721ba3f/uploads/origins/c0c65388-bf74-4aec-8b1c-64a265c1e758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=487c9cc46fc9edf754d68dd8f1836e80, https://si.imgix.net/7721ba3f/uploads/origins/c0c65388-bf74