7e6aedc7ce79c237919, https://si.imgix.net/5fc7e3ba/uploads/origins/1751329c-47fe-4187-96d3-c7a496c34704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ae17e70758ca6cfcd87f6c9790eca00 2x, https://si.imgix.net/5fc7e3ba/uploads/origins/1751329c-47fe-4187-96d3-c7a496c34704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43fc07184ffca6bdc7cf53948bbbea32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fc7e3ba/uploads/origins/1751329c-47fe-4187-96d3-c7a496c34704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=643e920be2b9f6f2a0bc310678862917", "srcset": "https://si.imgix.net/5fc7e3ba/uploads/origins/1751329c-47fe-4187-96d3-c7a496c34704?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=643e920be2b9f6f2a0bc310678862917, https://si.imgix.net/5fc7e3ba/uploads/origins/1751329c-47fe-4187-96d3-c7a496c34704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3008ba5ae89349410253da899fb53087 2x, https://si.imgix.net/5fc7e3ba/uploads/origins/1751329c-47fe-4187-96d3-c7a496c34704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4a78cceef2a03122c6fa70770943ab03 3x"}, "body": "こんにちは！\n\nまず最初に、あなたの絵が大好きだと言いたい！\n\n私のリクエストとしては、レヴァリ（リーバル）がたくさんのクローンに増殖するというコンセプトが欲しいです。\n\nレバリのクローンがテバと交流してほしい。どんなシチュエーションで登場させたいか、イメージがあれば自由に使ってください。\n\nもしアイデアが必要なら、レバリのクローンの何人かがテバをからかい、何人かがテバを慰めるとか。そして真ん中では、テバがイライラしている。\n\n別のアイデアとしては、レバリのクローンたちが眠っていて、テバはその間に押し込まれている、というのもいいかもしれない。\n\nおそらく難しいだろうことは理解しているので、自分がやりやすいように必要なことを恐れずにやってほしい。\n\nありがとう！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chikichikitaron/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2594407, "client_id": 2471839, "vtt_url": null, "thumbnail_image_