ばご承認いただけましたら幸いです。 ご検討ください。 \nよろしくお願いいたします。\n\nhttps://note.com/preview/n37e13fa1cd0e?prev_access_key=b5375f6080ca58628bad432a6b6111b5", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ffff02_f/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f8ebeb0a/uploads/origins/7e0bcf80-4aff-4fbe-961f-d81b263bd9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4a6202a409559ed29a5f1d9fc25f716", "srcset": "https://si.imgix.net/f8ebeb0a/uploads/origins/7e0bcf80-4aff-4fbe-961f-d81b263bd9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4a6202a409559ed29a5f1d9fc25f716, https://si.imgix.net/f8ebeb0a/uploads/origins/7e0bcf80-4aff-4fbe-961f-d81b263bd9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9a43509b4b3a871e8099b0e6a0dbe117 2x, https://si.imgix.net/f8ebeb0a/uploads/origins/7e0bcf80-4aff-4fbe-961f-d81b263bd9a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c969b2f4791925e37151f01a7e550c8d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3857929, "client_id": 3660097, "nc": 129}, {"path": "/@ffff02_f/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3857929, "client_id": 3940123, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a4a4f21/uploads/origins/056d9b96-2fc0-4fb1-9506-37398fc782a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d5afefd5fecad6076cc6ab6756f5f00", "srcset": "https://si.imgix