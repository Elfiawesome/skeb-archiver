す。\n\nドットキャラなのでわかりずらいかも知りませんが、\nとりあえず色んなポーズの資料を用意しました。\n\n素材の動物はペルシャ猫とノルウェージャンフォレストキャットです。\nゲームのジョブな感じだと短剣を使う双剣士とかシーフ的なキャラクターでした。\n\n性格はちょい頭悪いというか、単純っていうか…チョロい感じというか…\n調子に乗ってドヤっとしたり…話の内容そこまで詳しく考えない感じ…\nそんなポジションの子です！(謎)\n\n他に構図とかポーズなど詳しいのは全部お任せ致します。\nどうか、お構いなくご自由に描いてください。\n\nもしこの内容で大丈夫でしたら、\n何卒、よろしくお願いします🙇‍♂\n\nhttps://1drv.ms/f/s!Aom0SXByHDbQitRKhXEhD0VPCBgoWA?e=dRmQIm", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shu_mai014/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1808546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7358bfc5/uploads/origins/751a7ae6-2ffe-4a33-8801-bb87ca62b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96cc7d3af7761cdaf92af42967fe9a6b", "srcset": "https://si.imgix.net/7358bfc5/uploads/origins/751a7ae6-2ffe-4a33-8801-bb87ca62b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96cc7d3af7761cdaf92af42967fe9a6b, https://si.imgix.net/7358bfc5/uploads/origins/751a7ae6-2ffe-4a33-8801-bb87ca62b881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f092b2250cce51c14a1421bea1d6002 2x, https://si.imgix.net/7358bfc5/uploads/origins/751a7ae6-2ffe-4a33-8801-bb87ca62b881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13b234800b06533589c735e5de00d44a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7358bfc5/uploads/origins/751a7ae6-2ffe-4a33-8801-bb87ca62b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5f80b5cb6a11f40927a2f359f54b16", "srcset": "https://si.imgix.net/7358bfc5/uploads/origins/751a7ae6-2ffe-4a33-8801-bb87ca62b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c5f80b5cb6a11f40927a2f359f54b16, https://si.imgix.net/7358bfc5/uploads/origi