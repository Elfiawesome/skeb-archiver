atch You Catch Me」の歌ってみた動画を作りたくて、さくらちゃんの冬制服っぽい衣装でお願いしたいです。そんなイメージで、同じデザインである必要はありません。ベレー帽も被せてほしいです。\n\nできれば全身でいただきたくて、もし金額が不足しているようでしたら再送要請頂ければ幸いです。\n\n表情差分もいただきたくて、笑顔、ウインク、顔を赤らめる照れた表情、ちょっとびっくりした表情？などいただけるとありがたいです。\n\n人物が見切れないように描いていただけるとありがたいです。\n\nどうぞよろしくお願いします♡ご縁がありますように♡\n\nhttps://drive.google.com/drive/folders/1PdCJ00sjKqhIzrJFZ9oCkuX6BNvXuuge?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mochico0304/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3642883, "client_id": 2601726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c06411f5/uploads/origins/d53057d9-bb20-4237-a1b1-9c0ecb4e3510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d97a00559a2166afb440df1ab4a80e6", "srcset": "https://si.imgix.net/c06411f5/uploads/origins/d53057d9-bb20-4237-a1b1-9c0ecb4e3510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d97a00559a2166afb440df1ab4a80e6, https://si.imgix.net/c06411f5/uploads/origins/d53057d9-bb20-4237-a1b1-9c0ecb4e3510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9843c9597e11dc95015889982cd1bd1c 2x, https://si.imgix.net/c06411f5/uploads/origins/d53057d9-bb20-4237-a1b1-9c0ecb4e3510?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d4833171a41c9cef0e15cf12bd87ac9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c06411f5/uploads/origins/d53057d9-bb20-4237-a1b1-9c0ecb4e3510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1921e30a782506085d0b81c6e8ca4b13", "srcset": "https://si.imgix.net/c06411f5/uploads/origins/d53057d9-bb20-4237-a1b1-9c0ecb4e3510?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1921e30a782506085d0b81c6e8ca4b13, https://si.imgix.net/c06411f5