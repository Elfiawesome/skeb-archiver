合は背景透過で別ファイルもいただけると助かります。）\n\n宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1FwECCGmOpXtLEDrNXJ5qHQRC-amMmf7p?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@honcha1555/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 1888396, "client_id": 2363010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2c84b26cbc2d77c1e7ac1b7e0b14b088", "srcset": "https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=2c84b26cbc2d77c1e7ac1b7e0b14b088, https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=b0e882780949bf9c3315886411fd05c2 2x, https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c087c94517f64b2000ab5aa5bf3616af 3x"}, "duration": 8, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=aceccfd937bd7a66cb92a1085d117125", "srcset": "https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=aceccfd937bd7a66cb92a1085d117125, https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9613ea8be19248474c25eb7c99516423 2x, https://si.imgix.net/808ef617/uploads/outputs/21b27f70-3df4-4b0b-90a1-e7867ceb74ff?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1f18320592f749918799eba3485a6c7 3x"}, "body": "こんにちは、お疲れ様です。\n私のんりずのアバターであるゲーミングパンダのアニメーションを描いていただきたく依頼をいたしました。\n\nポーズについての要望ですが、\n「どこかに腰掛けて足をぷらぷらとさせているポーズ」をお願いいたします。イメージとしてはコンクリートの建物(廃墟マンション的な)の端に腰掛けている印象です。\n\n足のぷらぷら以外についてはお任せします。\n構図、背景、ポーズ、表情目線なども特に指定はありません。\n繰り返し再生するためループできるアニメーションだと嬉しいです。\n(背景がある場合は取り外せるととても嬉しいです)\n\n用途としては配信プラットフォームでの配信時に、レイアウトに配置することを考えています。\n\nhttps://drive.google.com/drive/folders/1FwECCGmOpXtLEDrNXJ5qHQRC-amMmf7p", "nc": 128, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@arata_0503/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 749648, "client_id": 2363010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eb3502d5009a41e592958705be6ca88", "srcset": "https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eb3502d5009a41e592958705be6ca88, https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30a480fd663977fa7e06696f73607bd9 2x, https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1769b5cfd814a9dab912b2bf93f6f569 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87b3779721caba9dc0c1dd14ea6fe6a7", "srcset": "https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87b3779721caba9dc0c1dd14ea6fe6a7, https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c294a62d9626ab3b165617480bdc3904 2x, https://si.imgix.net/0fb3d23f/uploads/origins/aa547899-f9e5-40ab-843e-3473263de6ca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c60ab9bac02383773ae805eee37da2bd 3x"}, "body": "あら太くんさん先生、お世話になっております。のんりずと申します。\nケモみあるデフォルメイラストがお得意とお聞きしましてここぞとばかりにリクエストをさせて頂きたく馳せ参じました。\n\nのんりずのアバター兼本来の姿である「ゲーミングパンダ」のイラストをお願いしたいです。\n\n【構図】\n待機ポーズのような感じでお願いをしたいです。\n細かい体の向きや姿勢、腕・手のポーズ、座り立ち、表情や目線の向きなどについてはお任せいたします。\n\n【使用用途】\n・動画配信サイトの配信画面レイアウトおよびプロフィール画面への掲載\n・Twitter画像投稿時、他素材や背景と組み合わせての使用\n　　⇒部分掲載（例：腰より上など）、切り取り（円・四角などの枠に収めるため）の可能性があります\n　　⇒イラスト自体への追記加工はいたしません\n・配信中やSNSで自慢してしまう可能性があります\n\n【デザインについて】\n資料URLに記載しましたのでご確認をお願いいたします。\n（イラストのイメージに合わない場合、服などの細かい柄は省略いただいても構いません）\n\n可能であればですが、上記使用用途を検討しているため背景透過された画像だと助かります。\nそれでは、ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/17EKpRSsjtCtZH3Vk10a50739w4h46R26/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@makia274/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 153564, "client_id": 2363010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5244ea5b/uploads/origins/2f6488f2-bc8a-4535-8b36-70bda17b6d22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c9ce5e3c2c40e1ab9be4ce73d8b9442", "srcset": "https://si.imgix.net/5244ea5b/uploads/origins/2f6488f2-bc8a-4535-8b36-70bda17b6d22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c9ce5e3c2c40e1ab9be4ce73d8b9442, https://si.imgix.net/5244ea5b/uploads/origins/2f6488f2-bc8a-4535-8b36-70bda17b6d22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr