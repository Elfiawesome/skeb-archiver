描かれていた\n・潮吹きチャレンジシチュ(https://www.pixiv.net/artworks/108234608)\n・拘束クリ責め(https://www.pixiv.net/artworks/80176417)\nがとても刺さったので、うちの子で拘束されて潮吹きチャレンジの事後絵をお願いしたいです。\n\nその他\n・可能なら潮が注がれたジョッキやキャラの付近に体液の付いた使用済みおもちゃ(電マやバイブ)が転がっている感じで\n・責めの子は写ってなくても大丈夫です。\n\n表情やその他細かな部分はお好きに描いていただいて大丈夫です。\n\n・キャラは人妻味のあるむちむちぽっちゃりのメスドラと言う設定になっております。また、筆が乗りやすいように体型は逆関節のケモ足でなく描きやすい様に変えてしまっても、お腹等を肥大化させてしまっても構いません！\n\nご検討の程、よろしくお願いします。\n\nキャラクター資料\nhttps://drive.google.com/drive/folders/1-GgNgJn9x2mTrGLwbqKX1zRC_xl_B7eg", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_rigi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 886260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba1d72d0/uploads/origins/ca5cf284-630f-4ff5-b86a-7bbdc53210ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d82d6a9d5837458c94ce43ad912462b", "srcset": "https://si.imgix.net/ba1d72d0/uploads/origins/ca5cf284-630f-4ff5-b86a-7bbdc53210ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d82d6a9d5837458c94ce43ad912462b, https://si.imgix.net/ba1d72d0/uploads/origins/ca5cf284-630f-4ff5-b86a-7bbdc53210ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=020520fa647c1d4bde96fab583e9d48a 2x, https://si.imgix.net/ba1d72d0/uploads/origins/ca5cf284-630f-4ff5-b86a-7bbdc53210ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fc002892cfe7943ea574d3289f27a2da 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba1d72d0/uploads/origins/ca5cf284-630f-4ff5-b86a-7bbdc53210ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=278d627f3c89d06eb3e70062ef13e7a1", "srcset": "https://si.imgix.net/ba1d72d0/uploads/origins/ca5cf284-630f-4ff5-b86a-7bbdc53210ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&