イメージですがあまり拘らなくても構いません\n・少女のバイトの理由、少女の実親と養父の関係などはお任せします\n・情景描写重視、性交場面では男性陣の台詞は極力少なめで願います\n\n▽NG\n・バッドエンド\n・ぶっかけ（特に顔）\n・アヘおほ喘ぎ、過度な語尾♡\n・下品な言葉遣い\n・逮捕、捕縛\n\n横書きpdf及び生txt形式が望ましいです。\n以上のような形でよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1GhoBHPQdrZ5wqd_Hv8eSS6EHxdd_hNYh/view?usp=drivesdk", "nc": 56, "word_count": 17581, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@ShowG_skeb/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1792522, "client_id": 2471596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb86df43/uploads/origins/b6781965-bf71-4660-997b-f44436981843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5fcd1869279738a0eb72b64010d724a", "srcset": "https://si.imgix.net/bb86df43/uploads/origins/b6781965-bf71-4660-997b-f44436981843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5fcd1869279738a0eb72b64010d724a, https://si.imgix.net/bb86df43/uploads/origins/b6781965-bf71-4660-997b-f44436981843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8323e7a835365991a9c43f9174cca9df 2x, https://si.imgix.net/bb86df43/uploads/origins/b6781965-bf71-4660-997b-f44436981843?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db836dee4373dff5ac31f2e626d26b1c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb86df43/uploads/origins/b6781965-bf71-4660-997b-f44436981843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7af6c645e4d0f3bb156cd530da04ade", "srcset": "https://si.imgix.net/bb86df43/uploads/origins/b6781965-bf71-4660-997b-f44436981843?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7af6c645e4d0f3bb156cd530da04ade, https://si.imgix.net/bb86df43/uploads/origins/b6781965-bf71-4660-997b-f44436981843?bg=%23f