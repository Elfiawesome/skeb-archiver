クの感じ）が展開されていると最高です。\nポーズはPSO2エトワールの飛翔剣の構えに近いものをイメージしてます。（バウンサーポーズの逆）\n\n場所はパープルトリガー（黄色の空間）で大きい絶望エネミーと対峙しているように\n見上げている感じでお願いしたいです。（前回のイラストと対称的な感じをイメージしてます）\n\n以上になります。色々注文が多く申し訳ございません。\nご多忙だと思いますが、よろしくお願いいたします。\n※資料URLは特にないですが、ツイッターのSSを参考にお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@picoro_o/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 231160, "client_id": 694886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0bffc3e/uploads/origins/0d10ff16-b311-4403-b024-c1ec5bd547b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69c814a17637350607d0c8b7534be3f", "srcset": "https://si.imgix.net/c0bffc3e/uploads/origins/0d10ff16-b311-4403-b024-c1ec5bd547b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e69c814a17637350607d0c8b7534be3f, https://si.imgix.net/c0bffc3e/uploads/origins/0d10ff16-b311-4403-b024-c1ec5bd547b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2dd685b28ca729707663027f2825ed2f 2x, https://si.imgix.net/c0bffc3e/uploads/origins/0d10ff16-b311-4403-b024-c1ec5bd547b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87f4f47bd618f82d36dc63f06bcc046c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0bffc3e/uploads/origins/0d10ff16-b311-4403-b024-c1ec5bd547b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=819be67b8406c1ebc558f250f50dc531", "srcset": "https://si.imgix.net/c0bffc3e/uploads/origins/0d10ff16-b311-4403-b024-c1ec5bd547b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=819be67b8406c1ebc558f250f50dc531, https://si.imgix.net/c0bffc3e/uploads/origins/0d10ff16-b311-4403-b024-c1ec5bd547b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w