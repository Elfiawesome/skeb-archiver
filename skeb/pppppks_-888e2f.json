設から\n半年の記念のイラストを描いていただき、\nありがとうございました！\n\nまんぷくちゃんさんが描いてくださった、\nケーキやプレゼントでご機嫌にこにこ\n＆ほっぺもぷるつやなさきちゅちゃんと、\nそのさきちゅちゃんのお膝の上で\nきゃ～！とはしゃぐシュクルくん、\n二人ともとても可愛かったです！\nありがとうございます！\n\n前回のリクエストから日が開いてしまいましたが、\nまたリクエストさせてください・・！\n\nリクエストですが、サークル・ぴょこっとついんて！の\nえりおさんの代理ちゃんである\nぴょこついちゃんが、ケーキや花束、\nプレゼントでお祝いしてもらっている\nそんなイメージでお願いしたいです！\n\n背景や構図など、\n全てまんぷくちゃんさんにお任せいたします。\n\nまた、このイラストは、\nまんぷくちゃんさんのペースで\nゆっくり描いていただいて大丈夫です。\n\n描いていただいたイラストは、\nえりおさんにプレゼントさせていただけたら・・と\n考えておりますので、\nイラストのプレゼントについても、\n併せて承認していただけると助かります・・！\n\nまた、もし可能でしたら、プレゼント用に\nお祝いのメッセージの入った差分など\n用意していただけたら大変喜びます・・！\n\n受けてくださったらとても嬉しいです！\n何卒よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pppppks_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1666066, "client_id": 1727419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8447cd11/uploads/origins/e5d93e45-71f6-4e8e-9001-53344f7b9f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=515b951d7c0c472949cd1ce268e1aa9f", "srcset": "https://si.imgix.net/8447cd11/uploads/origins/e5d93e45-71f6-4e8e-9001-53344f7b9f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=515b951d7c0c472949cd1ce268e1aa9f, https://si.imgix.net/8447cd11/uploads/origins/e5d93e45-71f6-4e8e-9001-53344f7b9f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b16f0d5ccea3a3c1070eafe7ae5aab40 2x, https://si.imgix.net/8447cd11/uploads/origins/e5d93e45-71f6-4e8e-9001-53344f7b9f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=913ddee80df708123a22241fe7b6b452 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8447cd11/uploads/origins/e5d93e45-71f6-4e8e-9001-53344f7b9f0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa2cd8ccb8d1605aa875932cddca88bf", "srcset