23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1b9cc7c820d02c50be388dfa9cb7d29", "srcset": "https://si.imgix.net/542b80a7/uploads/origins/6abb0408-cfc0-4c55-8ed4-352cd02b42bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1b9cc7c820d02c50be388dfa9cb7d29, https://si.imgix.net/542b80a7/uploads/origins/6abb0408-cfc0-4c55-8ed4-352cd02b42bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44b0d24632fcec209ad71a375b3999ef 2x, https://si.imgix.net/542b80a7/uploads/origins/6abb0408-cfc0-4c55-8ed4-352cd02b42bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a781cc56ad89c974c2e7794390537fdc 3x"}, "body": "真冬様\nはじめまして、個人でVtuberをしているシバと申します。\n今回、私のイラストを描いていただきたくリクエストしました。\n\n衣装ですが、地雷系の服装でお願いします。\nその際、髪形はお任せいたします。\n\n構図ですが、モンスターキューバリブレ（赤）を持たせてほしいです。\n表情は若干病んでる感じでお願いします。\n\n可能でしたら、髪が途中で横に切れないように描いていただきたいです。\n\n立ち絵にあるように私の髪が白くてとても長く、毛量が多いのでその辺りを意識していただけると幸いです。\n※身長は140cmです。\n\n\n【使用用途】\nTwitterへの掲載、YouTube活動におけるサムネ、アイコンとしての使用などを考えております。\nまた、可能であればサムネ等へ使用できるように背景透過のデータ(psdファイルなど)もいただけると幸いです。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14O3evcYwc7AewEPeyJwDsgUNS6QXiSCx?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ying1hua1/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2437797, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d93b253e/uploads/origins/1a9c151e-bc4d-4551-a63c-397cfae15e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba86cb3b69e2c3527d106728148811d", "srcset": "https://si.imgix.net/d93b253e/uploads/origins/1a9c151e-bc4d-4551-a63c-397cfae15e3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ba86cb3b69e2c3527d106728148811d, https://si.imgix.net/d93b253e/uploads/origins/1a9c151e-bc4d-4551-a63c-397c