f095f5-d3b0-43b1-9b73-b6653d26cbad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4f03a07aa5c2e17e478021e9910b2a6, https://si.imgix.net/ae7cb8c7/uploads/origins/25f095f5-d3b0-43b1-9b73-b6653d26cbad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da8c91c0680da403c0ea817a60e2d978 2x, https://si.imgix.net/ae7cb8c7/uploads/origins/25f095f5-d3b0-43b1-9b73-b6653d26cbad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab92b2823841f1bfec1c3c66a00ae1c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae7cb8c7/uploads/origins/25f095f5-d3b0-43b1-9b73-b6653d26cbad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90e3d075e80c54c6f0b1afa4ba0608a1", "srcset": "https://si.imgix.net/ae7cb8c7/uploads/origins/25f095f5-d3b0-43b1-9b73-b6653d26cbad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90e3d075e80c54c6f0b1afa4ba0608a1, https://si.imgix.net/ae7cb8c7/uploads/origins/25f095f5-d3b0-43b1-9b73-b6653d26cbad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e79fced3e1bf04d179714e007680a830 2x, https://si.imgix.net/ae7cb8c7/uploads/origins/25f095f5-d3b0-43b1-9b73-b6653d26cbad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=55227eaf2b39bbb4a62cd02bc6d7f1cf 3x"}, "body": "papipupiさんこんにちは！初めまして、うどんやと申します。\npapipupiさんの描く厚塗りのようなアナログのような質感が大好きでこの度ぜひオリキャラの四ツ谷逝八郎（よつやいきはじろう）を描いていただきたく、ご連絡いたしました。\nお好きな感じに描いていただけると幸いです。\n\n以下、キャラの説明になります。\n四ツ谷 逝八郎(よつや いきはじろう)  名前はペンネーム。29歳。\n表の仕事は小説家。\nしかし裏の仕事の“殺し屋”としての才能のほうが断然あるため、本人は葛藤している。\n性格が歪んでおり、対人恐怖症ぎみ。昼間はほとんど家から出ない。\n編集者ともほとんど会わずメールでやりあうほど。\n金に困って、殺しの仕事も受けているがそのほとんどはメールでのやり取りとなる。\nインターネット上では饒舌。\nサバイバルナイフ、執筆用の鋭利なペンを所持。\nどんなものもネタにしたい為、手帳を持ち歩いている。字が汚いため読解は困難。\n殺し屋の仕事を始めたのは、20代前半のころ。\n唯一付き合ってくれたのある女性が遊びで付き合っていたことが判明しその後殺害。\n自分に殺人の才能があることを知ってしまい、\nその後はインターネットの闇掲示板などに出没し、\n自己顕示欲を満たすために、\n自分と同じような境遇の相手を選び何件もの殺しの依頼を受ける。\nその後、殺し屋としての収入が小説家としての収入を上回っていることに絶望、何度も足を洗おうとするが金の欲に負けてやめられず今に至る。\n小説がヒットしたら今度こそやめようと思っている。\n▼設定画などこちらです。 https://drive.google.com/drive/folders/1CPjxSdfimVrdcZnmgphB5VBHg53g1JwM?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ta_u_la/works/198", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2606459, "client_id": 1230210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a179cbe5/uploads/origins/e4d900a4-e362-4747-b93e-d96d48ed1c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=516a4e2d7aa2d69527a7c629e7ae8ef6", "srcset": "https://si.imgix.net/a179cbe5/uploads/origins/e4d900a4-e362-4747-b93e-d96d48ed1c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=516a4e2d7aa2d69527a7c629e7ae8ef6, https://si.imgix.net/a179cbe5/uploads/origins/e4d900a4-e362-4747-b93e-d96d48ed1c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=509a90426bd840ccc4565a26cbb9f847 2x, https://si.imgix.net/a179cbe5/uploads/origins/e4d900a4-e362-4747-b93e-d96d48ed1c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ead136117d9d083c7d8d99082e5003d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a179cbe5/uploads/origins/e4d900a4-e362-4747-b93e-d96d48ed1c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ebcec435cedf0fb6e665ec0b3a29260", "srcset": "https://si.imgix.net/a179cbe5/uploads/origins/e4d900a4-e362-4747-b93e-d96d48ed1c26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ebcec435cedf0fb6e665ec0b3a29260, https://si.imgix.net/a179cbe5/uploads/origins/e4d900a4-e362-4747-b93e-d96d48ed1c26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop