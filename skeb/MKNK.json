utube.com/watch?v=KHBwef7qTYc", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MKNK/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 35283, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f82a288d/uploads/origins/3fcdd046-88fb-4ac9-b95a-a4f1120967ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5c42df3845f1d92efd4e91b39e2cec3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f82a288d/uploads/origins/3fcdd046-88fb-4ac9-b95a-a4f1120967ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f762f565376c58e587fc8c418013c4d8", "src_set": ""}, "body": "こんにちは、前回は素敵なイラストありがとうございます。\n今回も下のURLの男の子のイラストを、お願いします。\nシチュとしましては、男の子の変身シーンの漫画をお願いします。おおまかな流れとしては、初めに生身の男の子が変身の構えを取る（資料内にあるイラスト）、次々に装備を身に纏っていく、変身を完了した少年がポーズをとる、と言った感じでお願いします。\n装備に関しては、グローブ、ブーツ、スーツ、\nマント、仮面、の５つをお願いします。\n変身後のポーズはお任せします。また表情、構図、などもお任せします。\n最後にセリフを入れて欲しいです。\n変身前「変身！」\n変身後「モンストペンデュラム、ここに見参！」\n\nhttps://drive.google.com/drive/folders/1qgdMvPxAizuJORsMKpTcjpkOhsO7nknC", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MKNK/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 35283, "client_id": 23946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93c90aa3/uploads/origins/8ffb9af6-d010-4778-8253-702c3641dc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49a65f9945eaa454c4a7521b303b9a78", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93c90aa3/uploads/origins/8ffb9af6-d010-4778-8253-702c3641dc04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=