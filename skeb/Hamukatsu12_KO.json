ルダにたくさんの服装から選ぶことができますが、アイデアに合わせて違う服装で描くことができます。例えば、都会的な/都会の雰囲気のスタイルに合うように、https://imgur.com/a/U6D54NF のような素敵なモダンなジャケットなど。\n\nそばかすを忘れないでください。\n\n警告．\n私のお気に入りの衣装には⭐がついています。\nのついたフォルダはヌードがあります。\n彼女の襟、翼、古いデザインは描かないでください（それらを削除できるファイルを提供できる場合のみ、描かないでください）。\n\n私のリクエストを読んでいただきありがとうございます。\n\nhttps://drive.google.com/drive/folders/1R7SCBP9nQYU7N8SVeYZYC-z0HYjXHCA_?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hamukatsu12_KO/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2535533, "client_id": 57223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac85dd4e/uploads/origins/d082c325-8aa1-4ee6-80aa-f673f9de31d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb1c0ace77398aa6b5ac419fcc281816", "srcset": "https://si.imgix.net/ac85dd4e/uploads/origins/d082c325-8aa1-4ee6-80aa-f673f9de31d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb1c0ace77398aa6b5ac419fcc281816, https://si.imgix.net/ac85dd4e/uploads/origins/d082c325-8aa1-4ee6-80aa-f673f9de31d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=611529f14bd060153d61bdef42175338 2x, https://si.imgix.net/ac85dd4e/uploads/origins/d082c325-8aa1-4ee6-80aa-f673f9de31d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72cfcfe24f6ee72fdf983c7718bb44c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac85dd4e/uploads/origins/d082c325-8aa1-4ee6-80aa-f673f9de31d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eea472b01ff1c77c6b248b0dccbd248", "srcset": "https://si.imgix.net/ac85dd4e/uploads/origins/d082c325-8aa1-4ee6-80aa-f673f9de31d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2eea472b01ff1c77c6b248b0dccbd248, https://si.imgix.net/a