の揭載\nを使用させていただきます。\n\n②イラストイメージ\n運転手は私(コマチ)、助手席はGachi、左後ろはBB、右後ろはNaroでございます。\nGachiは歌っていて、BBは前に向いて景色を見ていて、Naroはいい夢を見ています。\nバックミラーでは太陽と珊瑚を飾っております。\n※海外で運転するので、運転席は左側でございます。\n※元の衣装かオリジナルでも構いません。\n※他には先生にお任せいたします！楽しそうなドライブです！\n\n皆の立ち絵、参考資料を下記に格納いたしました。\nどうぞよろしくお願い致します。\nhttps://drive.google.com/drive/folders/1jUr3ZkBAbutKGCZRefkLlN_DrfYswYIA?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jaga__rico/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e6891944/uploads/origins/c9b3b041-516d-476c-aa08-1b48f6b3022c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41465f13699d9b16aa6a6131a6b6e915", "srcset": "https://si.imgix.net/e6891944/uploads/origins/c9b3b041-516d-476c-aa08-1b48f6b3022c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41465f13699d9b16aa6a6131a6b6e915, https://si.imgix.net/e6891944/uploads/origins/c9b3b041-516d-476c-aa08-1b48f6b3022c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=675b5ff500924f8dd0d93ce08a7aa93c 2x, https://si.imgix.net/e6891944/uploads/origins/c9b3b041-516d-476c-aa08-1b48f6b3022c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b3edf7f3573a8c4cfeb78a9b6d8920d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2296704, "nc": 128}, {"path": "/@jaga__rico/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2296704, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgi