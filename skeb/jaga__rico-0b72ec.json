クエスト\n血で汚れた白いスーツを着て、ピストルを持っている姿が見たい。舞台は宴会場でも教会でも構いません。\n銃撃戦のイラストがとても好きです。とてもハンサムです。私のイラストのリクエストも、同じような雰囲気で表現していただけると嬉しいです。\n\nこのようなシーンやアクションが難しい場合は、キャラクターに合わせて自由に描いていただいて構いません。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jaga__rico/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2296704, "client_id": 169953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a24a62a/uploads/origins/91c5881f-3fa9-4b4f-b476-a720ef099138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c3f2c1094f6e3890d697cc8fe6c6caa", "srcset": "https://si.imgix.net/8a24a62a/uploads/origins/91c5881f-3fa9-4b4f-b476-a720ef099138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c3f2c1094f6e3890d697cc8fe6c6caa, https://si.imgix.net/8a24a62a/uploads/origins/91c5881f-3fa9-4b4f-b476-a720ef099138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9df0313c287d1072a8ed27e343ed6fa4 2x, https://si.imgix.net/8a24a62a/uploads/origins/91c5881f-3fa9-4b4f-b476-a720ef099138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=187008c53b5359862e130b1671506280 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a24a62a/uploads/origins/91c5881f-3fa9-4b4f-b476-a720ef099138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf4f5f9f11a706daeb73e403374b09b3", "srcset": "https://si.imgix.net/8a24a62a/uploads/origins/91c5881f-3fa9-4b4f-b476-a720ef099138?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf4f5f9f11a706daeb73e403374b09b3, https://si.imgix.net/8a24a62a/uploads/origins/91c5881f-3fa9-4b4f-b476-a720ef099138?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b57d388a782963cef803ad25a89b57b 2x, https://si