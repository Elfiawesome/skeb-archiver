4…（画像）ツインテールの子。顔での感情表現は乏しく、代わりにタブレットに顔文字を表示して感情表現をしてくれます。\n\nKP…下記参考資料のぼいぼにと一緒に写ってるサンドイッチの妖精さんです。\n\n〈補足〉\n参考資料が雑然としているため、もしかしたら分かりにくいところもあるかもしれません。\n資料不足等がありましたら、フィーリングでやっていただいても問題ないです🙆🏻\n\n去年の6月14日に通過した時に、洋太さんのVOIDのNPC立ち絵にお世話になったので、同じ絵柄で自陣を見たくご連絡させていただきました。\n金額がリクエスト内容に見合っているか、ご検討ください。\n\nhttps://photos.app.goo.gl/pdZf1SfUnB4Pu6Qf9", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FutonCoC/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 652419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d8b3e10/uploads/origins/ff296369-fd73-4a28-a1ee-9f5899f2efd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c1d6559582959116dcdeda4a1ffa15", "srcset": "https://si.imgix.net/4d8b3e10/uploads/origins/ff296369-fd73-4a28-a1ee-9f5899f2efd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c1d6559582959116dcdeda4a1ffa15, https://si.imgix.net/4d8b3e10/uploads/origins/ff296369-fd73-4a28-a1ee-9f5899f2efd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb8fbeb6a26b61848a7cb56fb1d60af7 2x, https://si.imgix.net/4d8b3e10/uploads/origins/ff296369-fd73-4a28-a1ee-9f5899f2efd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5ce4cf2ab557a6ecd66996abca782c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d8b3e10/uploads/origins/ff296369-fd73-4a28-a1ee-9f5899f2efd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158aefd12ac87f4ac0336853d3defb29", "srcset": "https://si.imgix.net/4d8b3e10/uploads/origins/ff296369-fd73-4a28-a1ee-9f5899f2efd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=158aefd12ac87f4ac0336853d3defb29, https://si.imgix.net/4d8b3e10/uploads/origins/ff296369-fd73-4a28-a1ee-9f5899f2efd4?