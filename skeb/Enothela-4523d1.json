fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfee1de1622f170fa3c152b713b659ad 3x"}, "body": "初めまして。Skebでの素敵なイラストをお見かけして依頼させていただきました。\n\n私のオリジナルキャラクターであるエイネラのイラストを描いていただきたいです。\n\n設定としては、メイドとシスターの二足の草鞋を履いて生活している女の子です。主のことが大好きな子で、家事のことなら何でもお手の物。基本的にスペックは高めだけれど、少々自己評価が低めな性格です。\n\n表情はふわりとした笑顔にしていただけると嬉しいです。\nイラストの雰囲気が好きなので、構図はお任せします。\n\nご検討のほど、よろしくお願い致します。\n\nhttps://drive.google.com/file/d/1FgCCZKuA6yWZu3nz6BqRF-d2I7aX_HVh/view", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Enothela/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1004460, "client_id": 2403555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a876d3c8/uploads/origins/914171f4-741b-412b-9af6-047d7077232a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3deef904e9b9c34abe984cb482dc9d1", "srcset": "https://si.imgix.net/a876d3c8/uploads/origins/914171f4-741b-412b-9af6-047d7077232a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3deef904e9b9c34abe984cb482dc9d1, https://si.imgix.net/a876d3c8/uploads/origins/914171f4-741b-412b-9af6-047d7077232a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d88e84b478c67fb8978f62c40798f3b4 2x, https://si.imgix.net/a876d3c8/uploads/origins/914171f4-741b-412b-9af6-047d7077232a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=90973bae9cc6927fc2097efa2174e0e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a876d3c8/uploads/origins/914171f4-741b-412b-9af6-047d7077232a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7cfd850ef0ae50d6955354d4eb1df79", "srcset": "https://si.imgix.net/a876d3c8/uploads/origins/914171f4-741b-412b-9af6-047d7077232a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&bl