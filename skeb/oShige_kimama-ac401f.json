系、タブロイドは緑系だとうれしいです。2人1緒だとピンク系かオレンジ系で……。\n\n保存形式は出来ればPNGがいいのですが都合の良い方法で構いません。(PSDだと開けるか分からないので……)\n\nもし無理なようであれば蹴って頂いても構いませんのでよろしかったらお願い致します！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oShige_kimama/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2804955, "client_id": 2737614, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96fc1b6a/uploads/origins/f87b7ff5-9d04-439d-84a1-8552615e7eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4086a76ac511df27b0c767057fed35b1", "srcset": "https://si.imgix.net/96fc1b6a/uploads/origins/f87b7ff5-9d04-439d-84a1-8552615e7eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4086a76ac511df27b0c767057fed35b1, https://si.imgix.net/96fc1b6a/uploads/origins/f87b7ff5-9d04-439d-84a1-8552615e7eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fb808a5fd6e214ce62fee9d7b11b84a 2x, https://si.imgix.net/96fc1b6a/uploads/origins/f87b7ff5-9d04-439d-84a1-8552615e7eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73d61c36197cc1d033fe8a64106d4b07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96fc1b6a/uploads/origins/f87b7ff5-9d04-439d-84a1-8552615e7eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=371368507b9848155ab4b77e4b0a8ee0", "srcset": "https://si.imgix.net/96fc1b6a/uploads/origins/f87b7ff5-9d04-439d-84a1-8552615e7eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=371368507b9848155ab4b77e4b0a8ee0, https://si.imgix.net/96fc1b6a/uploads/origins/f87b7ff5-9d04-439d-84a1-8552615e7eef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce2e19bb3895211281295230ef80b03e 2x, https://si.imgix.net/96fc1b6a/uploads/ori