したものなども頂けますと幸いです。\n\nご検討、どうかよろしくお願いいたします！\n\nhttps://drive.google.com/drive/mobile/folders/1jd4fvMraFgDMCReQX8sFYhHBHmTqaVQI?usp=drive_link&sort=13&direction", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigatsu_bakaan/works/333", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1673947, "client_id": 895320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a51b1700/uploads/origins/e9be58e0-1d17-4fe1-b355-379fa52ca9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec7db4bb6fa0ef2d6677d5041f4947c3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a51b1700/uploads/origins/e9be58e0-1d17-4fe1-b355-379fa52ca9b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=791dd5d3b368aa9936faa93570794210", "src_set": ""}, "body": "あなたの絵がとても好きで、ぜひ依頼したいと思っています！\n\n私のキャラクターは世界を旅するアーキビストのボイジャーです！どんなポーズでも自由にやってください！\n\nhttps://drive.google.com/drive/folders/1IdpvfRzlAx0GFce0i0mwx52mrxhXumok?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigatsu_bakaan/works/332", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1673947, "client_id": 2902346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c4f3765/uploads/origins/6d6ebf0f-b187-4278-9210-81a81b14ac39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1ae2a9624c81c275d75ccaf55e595a3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c4f3765/uploads/origins/6d6ebf0f-b187-4278-9210-81a81b14ac39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=899ff07474e12ee344522bde62018be2", "src_set": ""}