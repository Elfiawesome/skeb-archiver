TE&s=d65668af043d3f2a22d9aa0d938385b1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1673947, "client_id": 3329747, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@shigatsu_bakaan/works/350", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1673947, "client_id": 2735288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f861de7a/uploads/origins/3e8188f7-5813-400d-a510-6c0da382abc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13f04241e2a957db447c7fbdc40f776f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f861de7a/uploads/origins/3e8188f7-5813-400d-a510-6c0da382abc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=848ed2a2cefde3280b7fa12f5000b31c", "src_set": ""}, "body": "こんにちは。僕の2人のキャラクターが戦っている絵が欲しいんだ。一人は聖騎士で、もう一人は影の悪魔です。聖騎士のリファレンス・シートはリファレンス1の通りです。参考資料2と3はアートピースの例です。騎士の腕と武器は、戦うときに電気で黄色く光る。影の悪魔のデザインは参考資料4に詳しい。彼は体のすべての部位の形と大きさを変えることができる。例えば、腕を巨大化したり、自分を小さくしたりできる。私は、騎士が光る剣を振り回して悪魔に突進するようにしたい。魔物はその攻撃の衝撃を受け止めるために両手を上げている。ボクサーがパンチを受けるために腕を上げるのと似ている。悪魔は背中から蔓を出し、騎士を攻撃する。この蔓は騎士の腕や脚を引っ掻く。騎士は下半身が骸骨なので、これで血を流すことはない。鎧を傷つけるだけだ。騎士は眩しすぎて悪魔の目を傷つけるので、悪魔はうんざりした表情を浮かべるはずだ。あとは君に任せるよ。私の依頼を検討してくれてありがとう。\n\nhttps://drive.google.com/drive/folders/1-y8UYdHl0DY7cLS-hHLYPlDluJ29lI01", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shigatsu_bakaan/works/349", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1673947, "client_id": 3550600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0e7558f/uploads/origins/dff8f28f