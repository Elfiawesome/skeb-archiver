ロフィール\n年齢：33歳\n性別：男\n出身：生まれも育ちも日本\n身長：186cm\n見た目：アイボリー系の灰色の髪、ブルーグリーンの瞳（瞳孔の中心に十字マーク）、白い肌\n職業：私立探偵\n性格：元気、お人好しで困っている人を見捨てられない、仲間想い\nイメージ動物：真っ白いサモエド犬\nその他特徴：とあるビルの中にある探偵事務所の所長。なお、所員は自分一人。猫や人を探したり、浮気調査や借金調査をしている。特別頭は回らないが、地道に張り込むような体力勝負は大の得意。\n眼鏡をかけているのは「賢そうに見える！」から。ただの伊達眼鏡。\n\nhttps://drive.google.com/drive/folders/1IXtj9ykabDxVSbNSB2vkpgxNFv8Is7Xs?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sya_fffu_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3904154, "client_id": 3670322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/619d3037/uploads/origins/967bc5bf-e68c-45c6-99f3-c9dbf74cceee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b628f1f31717e96288a7e886d68236f", "srcset": "https://si.imgix.net/619d3037/uploads/origins/967bc5bf-e68c-45c6-99f3-c9dbf74cceee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b628f1f31717e96288a7e886d68236f, https://si.imgix.net/619d3037/uploads/origins/967bc5bf-e68c-45c6-99f3-c9dbf74cceee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff4f91dd5ff29bfc60655d151d8e1411 2x, https://si.imgix.net/619d3037/uploads/origins/967bc5bf-e68c-45c6-99f3-c9dbf74cceee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56246d10caca41423fa72a5b34328af5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/619d3037/uploads/origins/967bc5bf-e68c-45c6-99f3-c9dbf74cceee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fd203a2f20f48e2708013f4892edbd0", "srcset": "https://si.imgix.net/619d3037/uploads/origins/967bc5bf-e68c-45c6-99f3-c9dbf74cceee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fd203a2f20f48e2708013f4892edbd0, https://si.imgix.net/619d3037/uploa