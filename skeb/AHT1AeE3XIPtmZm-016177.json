03a35310f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=666e275adaae0574db95e5ee81f4c2dc", "srcset": "https://si.imgix.net/6b57807c/uploads/origins/87407219-4259-4e5f-ae04-1803a35310f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=666e275adaae0574db95e5ee81f4c2dc, https://si.imgix.net/6b57807c/uploads/origins/87407219-4259-4e5f-ae04-1803a35310f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67b826ec72f6ae6cbdec9ca0dc7ab7e4 2x, https://si.imgix.net/6b57807c/uploads/origins/87407219-4259-4e5f-ae04-1803a35310f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e689468251728d9cbc4021d4818b943a 3x"}, "body": "白猫プロジェクトのティナと魔獣ヴィシャスが行為してるイラストお願いします。\n【ストーリーの内容】\nまずティナは既にマフィア悪堕ちしていて、所属極悪マフィア団の性奴隷兼女スパイの状態で、他者から踏みつけにされる事に性癖を覚え喜ぶ状態で、背中にはマフィアのマークの双龍を模したタツゥーが彫られ、目の下には♀の輪に♂の輪が刺さってるモノクロのタツゥー、多少口紅やアイシャドウを塗っている\n1枚目\n1、極悪マフィアのティナは魔獣ヴィシャスに対峙するが、屈強な姿に見惚れてワザと負けて完膚なきまでボコボコにされる\n2、※魔獣ヴィシャスの前で全裸で無様土下座するが、寧ろ情けない自分の姿に目をハートに心から喜ぶ\n3、※立ちかなえや寝バックで犯される\n4、※喜びの顔で目をハートにしながら、仰向け上の空で行為後の余韻にふける。\n（2※土下座ティナの横に顔が描かれている状態）\n（3※立ちかなえではティナの背中が見えて横顔も見えて、寝バックでは魔獣ヴィシャスがティナの頭を押さえて、ティナも止めど目となく来る快楽に喜び耐える）\n（4※潰れたカエルのような状態）\n2枚目\nティナの正面が見える状態で、魔獣ヴィシャスがティナの両足を抱きかかえて、陰茎で固定し盛大に喜びながら舌を絡めるキスをし、それを見ている魔獣女王オスクロルが赤ん坊を抱えながらティナの顎を撫でて、ディランも様子を見る、息子はそれを見て恥ずかしながら見てる状態", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AHT1AeE3XIPtmZm/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd7141a4/uploads/origins/6f461d56-b154-434b-ac62-77a1a35e0946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9608512fbc3c9762ce1807b06c15e5b9", "srcset": "https://si.imgix.net/dd7141a4/uploads/origins/6f461d56-b154-434b-ac62-77a1a35e0946?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2