net/c72d37e2/uploads/origins/9f3fefb0-0061-409b-b761-e0f2c7402680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c229193975d1f225b39caaba256e282", "srcset": "https://si.imgix.net/c72d37e2/uploads/origins/9f3fefb0-0061-409b-b761-e0f2c7402680?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c229193975d1f225b39caaba256e282, https://si.imgix.net/c72d37e2/uploads/origins/9f3fefb0-0061-409b-b761-e0f2c7402680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1656cf38dc86b9ed23ae6826eb6018af 2x, https://si.imgix.net/c72d37e2/uploads/origins/9f3fefb0-0061-409b-b761-e0f2c7402680?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e38d719e4f140682a21e7c71a676523 3x"}, "body": "再度リクエストさせて頂きます。\nいつも素敵なイラストを拝見させて頂いております（戦う青年メーカーもTRPGのキャラ外見として使用させて頂きました）。\nSkebの募集をなさっていると知り、ご縁があればと思いリクエストさせて頂きます。\n\n今回は新規キャラをデザインからお願いしたく思っております。\n描いて頂きたいのは、キャラの衣服を着た基本立ち絵＆ローライズボクサーのみで身体の筋肉や身体のラインが分かる裸体の立ち絵（背景付きとキャラのみの透過両方を納品して頂きたいです。TRPG等に使用する可能性があります為、高校生の制服もお願いしたいですがご無理でしたら大丈夫です）、設定資料的な三面図、アイコン等に使える表情何点かといった感じです（穏やかな笑顔、困ったなという感じの少し情けない表情、穏やか故に怒りMAXになったら笑顔で威圧するような表情、他無理のない範囲で思いつくままに表情をつけて頂きたいです）。\n\nキャラ設定等\n田舎暮らしの平凡な男子高校生で実家の農業を手伝っている為、筋力はありそこそこ筋肉は付いていて健康的な日焼けをした褐色男子ですが、身長178cm程度で寸胴の胴長短足気味（この子の体型が非常にツボりました！　https://twitter.com/sagaminnn_022/status/1663229282725019648?t=Ra2__1PMgWsWVNsyYef-ag&s=19　私自身は筋肉大好き人間ですので盛る分には全然大丈夫です）\n顔は男前にちょっと足りない無骨で純朴な、上がり眉のたれ目で頼りなさげだが人が良さそうな印象。瞳の色は焦茶で若干三白眼。\n髪型は短めの直毛を雑にオールバックにしたツンツンヘアーで後ろ刈り上げ。\n髪色は元は焦げ茶だが焼けて自然に田舎くさい茶髪になった感じ。\n\n服装等\n畑仕事用のモスグリーンやカーキ色の上下一体のジッパーツナギを厚い胸板が見えるように着ている。長袖を二の腕が見えるように袖捲り。\nシャレっ気はなく、機能性重視でおそらく長靴（不明点やアレンジ、追加等はお好きにデザインして頂いて大丈夫です）\n制服が可能でしたらカッターシャツの上のボタンを外して中のシャツ（濃緑）と太い首が見えている。\nローライズボクサーはカーキ色でピッチリ（巨根で目立つ）\n\n難しいリクエストかと思いますが、ご一考頂けますと幸いです。\nよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amakusaamegi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 167240, "client_id": 617999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026045d67a3d64eaf09ba9e6f109acf1", "srcset": "https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026045d67a3d64eaf09ba9e6f109acf1, https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ac325f65783683fea58792d67461b8c 2x, https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24d0d2e7859db079cf2e902e2b3e3d8d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=530e6f8170bbb9b5e008b007f766ce2b", "srcset": "https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=530e6f8170bbb9b5e008b007f766ce2b, https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da3db5e9281f5a51b238ab893db7ddc2 2x, https://si.imgix.net/4063cd0f/uploads/origins/e20d2895-22a0-4d30-9735-428eab3eb17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15e154b3bf9cae312f3526b35529e828 3x"}, "body": "飴木絵師様、はじめまして。\nskebを開設なさったとのことで、是非オリジナルキャラの立ち絵をデザインからお願いしたく、リクさせて頂きます。\n\n今回お願いしたいのは、Twitter交流企画の「ワンワンズアーミー」（　https://kwg0x-bf.net/bowwowarmy/　）の私のキャラの全身を透過＆軽い背景付きでデザイン込みで描いて頂きたいです（暗殺任務の際の冷たい瞳をした差分もあると嬉しいです）※切り抜きのバストアップもあると助かります\nこの企画趣旨は、『犬獣人×軍人をテーマに一騎当千の猛者だけを集めた架空の傭兵部隊「ワンワンズアーミー」を作り、オーナー同士で交流を深めていくというものになります。\n\nキャラ設定等\n元ロシア出身の軍人であり、数多の戦場を生き抜いてきた歴戦兵で、ロシアでの階級は中尉と比較的高かったが、軍との軋轢から傭兵部隊「ワンワンズアーミー」の曹長となった。\nロシア軍人だった際は眼光鋭く、自ら汚れ仕事を進んで引き受けるタイプだったが、ワンワンズアーミーに所属してからは、一転してちゃらんぽらんな不良軍人を演じている（書類仕事等貯めがち）\nその一方、暗殺や斥候といった危険な任務は自分がやるべきだと思っている\n年齢は30歳前後を想定\n\n犬種はシベリアンハスキーで瞳の色はエメラルドグリーン、軽薄そうな上がり眉のたれ目\n身長185cm程の高い身長に、輝く銀毛の\nスジ筋マッチョ系の引き締まった、バスケ選手のような体格（毛に覆われていますが胸板や腹筋が鍛えられている）\n\n軍服\n黒のタンクトップインナーの上に緑迷彩柄の陸軍ミリタリージャケットをジッパーを開けた状態で羽織り、ジッパーやポケットの多い迷彩柄のミリタリーパンツを履いている（可能ならその上からカーキ色のオーバーパンツ（チャップス））を履かせて頂きたいです\n靴は、深緑の編み上げブーツ\n軍坊はNGでお願いします\n\n基本の武器は89式5.56mm小銃と89式多用途銃剣（ナイフは普段は背腰に鞘に入れて装着している）\n\nセリフ・性格等\n「おじさんちょっと疲れるのは遠慮したいなあ」\n「任務というのなら従いますけどね～」\n「……了解。敵アジトには俺だけで潜り込む。若い子達が眠っている間に終わらせてくるよ」\n\n不明点等お任せ&小物やアレンジ歓迎！\n\n※R18交流をする可能性もあります\n\nご縁がありますと幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mukumukudori666/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 656274, "client_id": 617999, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d9125d5/uploads/origins/51e2a02a-1e2b-4cea-a9e1-55b384956e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f8d4543bfa81703028cf6d6d8c3cff1", "srcset": "https://si.imgix.net/2d9125d5/uploads/origins/51e2a02a-1e2b-4cea-a9e1-55b384956e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f8d4543bfa81703028cf6d6d8c3cff1, https://si.imgix.net/2d9125d5/uploads/origins/51e2a02a-1e2b-4cea-a9e1-55b384956e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0d16af598389689090983cd89348abf 2x, https://si.imgix.net/2d9125d5/uploads/origins/51e2a02a-1e2b-4cea-a9e1-55b384956e7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a6fe514979dd95fddd7fad9ca7