-cf6cbc6d99dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ee021aa8b847fec9ee934e391b54aa0a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4de8b092/uploads/origins/7242e733-9e0c-4199-b51f-cf6cbc6d99dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba09b4b089216dd8b635b9e8466a1501", "srcset": "https://si.imgix.net/4de8b092/uploads/origins/7242e733-9e0c-4199-b51f-cf6cbc6d99dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba09b4b089216dd8b635b9e8466a1501, https://si.imgix.net/4de8b092/uploads/origins/7242e733-9e0c-4199-b51f-cf6cbc6d99dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=828324202da337f9991f5c3134ceecac 2x, https://si.imgix.net/4de8b092/uploads/origins/7242e733-9e0c-4199-b51f-cf6cbc6d99dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=082ffefdbfcb2bf5fa8435c5002ee3a9 3x"}, "body": "こんにちは！アピールありがとうございます。私のキャラクターを描いてください！4周年のお祝いにイラストをお願いします。\n\n[ポーズや服装など］\n可愛くてハッピーなイラストをお願いします。私のキャラクターは指を4本立てています。両手でピースサインとか？もしくは片手3本、片手1本とか。ポーズは自由です。服装は、小さな天使の羽と花の光輪をつけて描いていただけるとありがたいです。服装は自由にデザインしてください。普段着でも構いません。髪型は変えてもかまいません。髪のピンクのハイライトを忘れないでください。\n\n[画像使用について］\n画像はVTuber活動に使用するつもりです。SNSでのシェアや動画のサムネイルなどに使用する予定です。また、周年記念のステッカーやちょっとしたグッズも作りたいです。\n\n[ファイル希望］\nキャラクターと背景のレイヤーを分けてください。もしくは背景を透過したバージョンもお願いします。表情の違いも大歓迎ですが、必須ではありません。\n\nよろしくお願いいたします！\n\nhttps://imgur.com/a/chiellevt-s0vzehv", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurusu_Han/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3443570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bc95652f8da681d78bce230c2baba19", "srcset": "https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0bc95652f8da681d78bce230c2baba19, https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12fbed2899b2c17f92a07b3a56005d68 2x, https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e900d0ad5bac98c6e677350117740b67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49747976604653c57e59aaef5ba55e2e", "srcset": "https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49747976604653c57e59aaef5ba55e2e, https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6b7732fab269d8eddfb21a2dc73020d 2x, https://si.imgix.net/e3115e34/uploads/origins/2e20e28e-fb53-497d-ad9a-d42fae7d4fa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4ba79abca0769e36d3f0284e5b0a669 3x"}, "body": "こんにちは、あなたのスタイルが大好きです！\n\nvtuberの水木晴さんがサンタドレスを着て、プレゼントの袋を肩にかけてウインクしている姿を描いていただけませんか？はるの参考資料と、サンタドレスのスタイルの参考画像を載せておきます。サンタドレスはこの通りである必要はない。\n\nクリスマスプレゼントのつもりなので、クリスマスまでに仕上げてもらえるとうれしいです！\n\n参考文献：https://drive.google.com/drive/folders/18zdWWonehQAPZAZkC_HyGK9CiLGh44TZ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kurusu_Han/works/4", "private_thumbnail_image_urls": n