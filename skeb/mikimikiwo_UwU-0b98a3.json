す。\n\n●その他\n可能であれば背景を透過したデータを頂けると嬉しいです！\n\nもし不備などがありましたら、キャンセルや再送依頼などをしていただければ幸いです。\nご検討のほどよろしくお願いします！\n\nhttps://x.com/Kei_Todome/status/1397129153258803202", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikimikiwo_UwU/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3849541, "client_id": 2834834, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f931691fd0539d4ff3e486c524a74bcb", "srcset": "https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f931691fd0539d4ff3e486c524a74bcb, https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d03c1c4a8a82c7405688ba1e4791a51 2x, https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a76a85518950f74e627f6c1dba7fc8fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75a83fc0155b3884542905be7a7342fb", "srcset": "https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75a83fc0155b3884542905be7a7342fb, https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5198bf7ff44da080d9fe5cf7a5d3b337 2x, https://si.imgix.net/dd694aee/uploads/origins/65399fe3-3ccd-4248-be6a-01e8e73145ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=937187cb7bd4f2c06ccd071126b1d20a 3x"}, "body": "こんにちは、あなたの画風、特に色彩の選択と陰影の表現が本当に素晴らしいです。ぜひ私のキャラクターをあなたの画風で描いていただきたいです。私のキャラクターは紫色のクマで、ちびキャラ風のデザインです。感情を表現する画面のような顔を持っています。主な服装は、黒いヘッドホン、白いフーディーの上に黒いダウンジャケットを重ね着しています。 \n\nサイバーまたは未来的な街を歩いている様子を描いていただけると嬉しいです。驚きと好奇心に満ちた表情で周囲を見渡している姿をお願いします。キャラクターの外見や表情の参考画像をいくつか添付しました。ポーズや配色、表情など、全てはあなたのスタイルに合わせて自由にアレンジしていただければ幸いです。ご検討いただきありがとうございます。\n\n参考画像: https://imgur.com/a/HdB4rU3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mikimikiwo_UwU/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/73347bfd/uploads/origins/80b965e0-1d7f-48f6-9744-0f2b7c7ccc12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a87575484cc41f5f954356c49b669e77", "srcset": "https://si.imgix.net/73347bfd/uploads/origins/80b965e0-1d7f-48f6-9744-0f2b7c7ccc12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a87575484cc41f5f954356c49b669e77, https://si.imgix.net/73347bfd/uploads/origins/80b965e0-1d7f-48f6-9744-0f2b7c7ccc12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5d4fbb367c798aa972101caf68e4d14 2x, https://si.imgix.net/73347bfd/uploads/origins/80b965e0-1d7f-48f6-9744-0f2b7c7ccc12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c2a17205d11d35c5b2f7d487516040a9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3849541, "client_id": 3875228, "nc": 14