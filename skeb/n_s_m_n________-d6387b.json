genre": "art", "tipped": true, "creator_id": 239306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b78616d8e960c1ed93e579923f168b", "srcset": "https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b78616d8e960c1ed93e579923f168b, https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9640438074623d6e6197dbb08e4fe6f2 2x, https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60087601b08bf39cdfb5947214fa5028 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c84ff333d5ff1e52d9e0ba2950dbaf3b", "srcset": "https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c84ff333d5ff1e52d9e0ba2950dbaf3b, https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed03b6fffad45422785104c16619b8e1 2x, https://si.imgix.net/2d5fbf57/uploads/origins/a977f8f8-13c4-460f-9901-b6040dfedd88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6da735db79a0ae71699b79ce7ed6ac92 3x"}, "body": "偽物さん、こんにちは。\nよろしければリクエストをお願いします。\n\n以前pixivに挙げられたエリーゼ様魅了もの、素晴らしかったです。\nまた、その前のポーランサリタの投げキッス魅了モノも、最高にグッと来ました。\n\nリク主は、色仕掛けや魅了や洗脳されたり、裏切ったりする展開がそれはもう大好きなのです。\nそして、それがキス技によるものだともう……たまらんのです。\n\nなので、リクエストは以下のものになります。\n\n形式→カラーイラスト3枚+文字差分（エリーゼ様キス洗脳イラストを参考にしました）\n\n内容→キスでの魅了洗脳、裏切りモノ。\n\n具体的な内容イメージ（あくまでイメージなので、偽物さんの裁量で変更してください）\n\n仲間の一人がブチュっとキスされている→魅了された仲間に羽交い締めにされて、エリーゼが主人公の唇に迫って来る→主人公も魅了されて、他の犠牲者を探しに行く\n\nという感じです。\n\nキス洗脳って最高です。\n……特にキスマークが複数着いていると嬉しいです。\n\nもし、偽物さんの心境として、アングルや設定の問題で「エリーゼ様より、魔王様の方が描きやすいなぁ……」なんて心境がある場合は、\n魔王様バージョンにして頂いても、大丈夫です。\n\n一応、どちらでも大丈夫なようにリク内容を書いたつもりですしね（笑）\n\nどちらも大好きですから。\n\n※急いで書いたので、誤字や失礼な物言いがあった場合は、大変申し訳ありません。\n\nそれでは、よろしければお願いします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@n_s_m_n________/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 239306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a35bdab45cacf34c282d04a9ec24d15", "srcset": "https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a35bdab45cacf34c282d04a9ec24d15, https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c0cc132463b218e5a8814f7c64fb052a 2x, https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=411ac6421e390a32170a23c98590ac60 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb97454f87b44f9beea249a9bb98304", "srcset": "https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cb97454f87b44f9beea249a9bb98304, https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5876646503b4caf05b85a9d14118df5c 2x, https://si.imgix.net/da20d9bc/uploads/origins/194ebbca-5032-4416-a471-871cc41db185?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0149159b6d4c483847a610067a6f9d85 3x"}, "body": "お世話になります。\nまたポーランサリタのカラーイラストをリクエストさせていただきます。\n\n(第三者視点、真横からのアングルで)対面しあってる男に対して、ポーランサリタが男の顔の前で自分(ポーランサリタ)の口元に手を添えてピンク色の吐息(フェロモン)を男の顔に吹き掛けながら、もう片方の手で手コキをするという全身イラストをお願いします。\n息吹き掛け参考\nhttps://livedoor.blogimg.jp/darkladylaughed/imgs/5/e/5e88137d.jpg\n\n立ち位置参考(雰囲気程度に)\nhttps://movie.eroterest.net/page/14389702/\n(動画ではありません)\n\n可能であれば大量射精の差分もお願いします。\n男は過去のマンガリクエストで魅了されて裏切ってしまった青年のようなキャラでお願いします。(同じキャラでも大丈夫です。)\n\n背景、台詞、擬音等は無くても大丈夫です。\nもし雰囲気的に付けていただけるのであれば有り無し差分もお願いしたいです。(psdファイルでひとまとめでも大丈夫です)\n\n同じキャラ(ポーランサリタ)でのリクエストなのでキャラかぶりを気にされたり、金額的等、食指が動かない場合は遠慮なくキャンセルしてください。\n\nご検討の程、宜しくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@n_s_m_n________/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 239306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a705319e/uploads/origins/5d8e32ae-7d65-43b9-b52a-86083c80f3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ff7a2c1c6375dcea2750fcf1962c50", "srcset": "https://si.imgix.net/a705319e/uploads/origins/5d8e32ae-7d65-43b9-b52a-86083c80f3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42ff7a2c1c6375dcea2750fcf1962c50, https://si.imgix.net/a705319e/uploads/origins/5d8e32ae-7d65-43b9-b52a-86083c80f3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3980919438ee5c897ac069fce9e72fe 2x, https://si.imgix.net/a705319e