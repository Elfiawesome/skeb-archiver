0-ca97-4218-8089-09d263d06bdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e4ddcfcc3709eb2436e972af202bcd0b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2818737, "client_id": 1887205, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@darumennro/works/84", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2818737, "client_id": 2760195, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/069d0bbd/uploads/origins/9718cf6e-7725-4a08-b6b3-815888fdb596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1bf8e9767d7b3630c435ca0fa117c06", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/069d0bbd/uploads/origins/9718cf6e-7725-4a08-b6b3-815888fdb596?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300d2680efe3fdf30e12969c439aee41", "src_set": ""}, "body": "■依頼\n\n私と友人のオリジナルキャラクターのイラスト\n\n■詳細\n\n資料：https://drive.google.com/drive/folders/1kh4GiIH-WNoyY1733mfKG02Ci4oL4NuM?usp=sharing\n\n・天才 一等(あまざえ かずら)(27) 178cm 男\n大人気バンド「No.1」のギター兼ボーカル。陽キャで売れてるバンドマン。\n来るもの拒まず万人と仲良くするウェイ系。周囲に人が絶えないが、両親との不仲が原因で愛に飢えてる。\n\n・雨地 影輝(うち かげてる)(27) 177cm 男\nバンド「UnohanakutasI」のベース兼ボーカル。陰キャで売れてないバンドマン。\nなんにでも噛みつきたがる人見知り。口が悪く、性格もひねくれている為友人がほとんどいない。\n\nふたりはバンドマンとして互いに意識していて、ある出来事をきっかけに深く関わる様になりました。\n一等はメチャメチャ影輝を気に入っており、ベタベタするし隙があればキスなどをします。影輝はそんな一等を鬱陶しく思い拒絶しながらも、今まで人と深く関わったことがなく好意を向けられたこともないので戸惑っています。\n\n資料は天変地異驚天動地様の裁量で適当に確認し、服装や構図等自由に描いて頂ければと思います。距離感近めで明るい雰囲気だと嬉しいです。\n\n\n■用途\n\n・個人観賞用のグッズの作成\n・天変地異驚天動地様の名前を明記したうえでのSNSのアイコンやヘッダーへの使用\n\n金額に不足があれば再送お願い致します。\nご検討の程宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@darumennro/works/83", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d5fa86ae/uploads/origins/d8c0307a-bbf9-4819-9b54-5a82c3aaba39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5cf3cf67b46577b68d20151f0f3f35a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2818737, "client_id": 3231932, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@darumennro/works/82", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ed2e37b8/uploads/origins/d59d8c66-f0f3-464b-9966-9ee1c92b5aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52f9e626e19adbb5208031903a4b0655", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2818737, "client_id": 3249319, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@darumennro/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2818737, "client_id": 3301512, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e73206f1/uploads/origins/c8f63a15-402e-4d8b-b249-d9218ac62119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d8af54d963f8d72eda407f4327bf70e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e73206f1/uploads/origins/c8f63a15-402e-4d8b-b249-d9218ac62119?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05ebb74f9ccbcba641c3394012bfeebf", "src_set": ""}, "body": "こんにちは、前回依頼した時にとても嬉しかったので、また応援したくなりました！この金額で大丈夫でしょうか...（もし追加料金が必要な場合は言ってください！）また、断っていただいても構いません！\n\n白い髪のキャラが【モカ】、黒い髪のキャラが【千田】です！(二人ともOCです！【モカ】は私のもので、【千田】は私の友達のものです！）二人は仲がいいです。(二人の関係を正確に表現するのはちょっと難しいので、恋人同士かな！)[モカ】はとてもシャイで陰気な性格で、心配そうな顔や慌てたような表情をすることが多い。[千田】はとてもぶっきらぼうで冷たいので、それほど愛情深いわけではない。[千田】もあまり表情を見せない。でも、ふたりともお互いのことをよく気にかけていて、【チダ】は【モカ】に愛想を振りまくことを嫌がらない。[モカ】は【チダ】に抱きついたりキスをしたりして愛情を注ぐ傾向がある！\n\n念のため補足を！\n[モカ】と【千田】は大学のルームメイトで、普段から一緒にいることが多い。[千田】は普段はちょっと意地悪で、思ったことをすぐ口にする。[モカ】は【千田】に親切で優しく、よく【千田】のことを考え、【千田】が快適に過ごせるように何でもする。[チダ】はメモやお菓子を置いていくなど、さりげなく愛情を示すが、ぶっきらぼうなところもあるので、たまにいいことも言う。[モカ】は、言葉ではあまり愛情を示さないが、近くにいたり、プレゼントをあげたりと、物理的に愛情を示す。二人ともアイドルとゲームが好きで、意外と気が合う。\n\n大切な情報\n\n[モカ】身長：177cm\n[千田】身長：164cm\n\nともに男子大学生。\n\n千田]は口元のホクロを必ず入れてください。また、【千田】は目に光が入らないようにしてください！\n\n基本的にはどんなポーズでも構わないので、自由にやってください！モカ】が【千田】に抱きついたり、キスしているようなかわいいポーズでもOKです！どちらでも構いません。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1LeWO3ZybOTu_JPVjai2ZG9soXnVbqjpo?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@darumennro/works/80", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0e378454/uploads/origins/62b94539-2bee-4458-bcdf-b9799740f618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=373e735f525f82e2285d0be1f71fa02e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2818737, "client_id": 3362856, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre":