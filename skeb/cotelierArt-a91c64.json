bp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b007571f9fd67e3d9cefee6c1aaa6cef 3x"}, "body": "初めまして、こんにちは。\n\n-イラスト用途\n主推し 兔姬UsagiHime & 友人\nVTuberチャンネル登録4万達成のお祝いイラスト\n\n3人+1吉祥物？\n冒険者ギルド酒場 \n仲間同士で楽しく飲める空間\n\n詳細はあなたにお任せします。\nありがとうございました。\n\n-参考図\nhttps://drive.google.com/folderview?id=1Q9Nm6VqIDmmyjm55XchWdWuB6gTTCIHu\n\nよろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cotelierArt/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1318450, "client_id": 1371347, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a367d5a102e2e84edc87e139bfda639", "srcset": "https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a367d5a102e2e84edc87e139bfda639, https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88795107efa9b967c5f924d1f5809554 2x, https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=156500f9fcd9be216d7d57a449f454f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf13e804715552732215eedc7c843926", "srcset": "https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf13e804715552732215eedc7c843926, https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ce65d475dc9e8afaf2acbc2bae9a8e8 2x, https://si.imgix.net/20f70df9/uploads/origins/98f5eb7b-8499-4839-a422-506bfcc5002f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa203da99c942bea4f797d1e66104d2d 3x"}, "body": "こんにちわ、ビヴ・ロストと申します。\n\n今回お願いしたいのは、私の創作キャラクター「ハクア」のイラストです。\n創作と言っても、ゲームのアバターで作成したものを、自分なりに描いている内に、自分のキャラクターとしたものです。\n（細かい部分は作成したアバターとも違ってきている）\n\nお手数ではありますが、私のアカウントのツイートにあげている絵を参照していただければと思います。\nhttps://twitter.com/bivlost/status/1421437505828659205?s=20\n\nハクアの外見上の特徴は以下の通りです\n・たれ目\n・右目の下にホクロ\n・髪の長さはショート　後ろは首の付け根くらいまで\n（先端が外はねしている事が多い）\n・髪の色は明るいグレー？銀髪？\n・服はハイネックのセーター、ロングスカート\n・身長は低め（150～160cmくらい）、体格も大きくはありません\n\n\n視線は正面（見る側）を向けて。\n表情は口を結んだ笑顔で。\nツイッターアイコンに利用するつもりです。\n大雑把なポーズや顔の向きはお任せ致します。描きやすい構図があればそれで。\n\n以上となります。\n何卒、よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cotelierArt/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1318450, "client_id": 1099638, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeafd906/uploads/origins/c2dcbda5-6696-4376-8fc3-f5b8549c2956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=295987b89b9629b8077aff557069d2f9", "srcset": "https://si.imgix.net/eeafd906/uploads/origins/c2dcbda5-6696-4376-8fc3-f5b8549c2956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=295987b89b9629b8077aff557069d2f9, https://si.imgix.net/eeafd906/uploads/origins/c2dcbda5-6696-4376-8fc3-f5b8549c2956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7799e15f7a02b57c39e3ec51a3f5d2eb 2x, https://si.imgix.net/eeafd906/uploads/origins/c2dcbda5-6696-4376-8fc3-f5b8549c2956?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af8b3b5525cab5b3b015ba8bf213f