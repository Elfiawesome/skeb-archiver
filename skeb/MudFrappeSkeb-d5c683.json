r_acceptable_same_genre": false}, {"path": "/@MudFrappeSkeb/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3022154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5aed4ad5ce0b5e51a8a00b03ee3a161", "srcset": "https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5aed4ad5ce0b5e51a8a00b03ee3a161, https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6c26333a794f31a982923f0dd52090b 2x, https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2e82040a7e055da2cc03608f97f1693 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca5b3896fff36aecd35aa709f55d6edb", "srcset": "https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca5b3896fff36aecd35aa709f55d6edb, https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6576e2f0461a4fa35fb7ad583fa44d12 2x, https://si.imgix.net/5f13f349/uploads/origins/8130d8a1-d345-4ea5-942c-d046626888ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c9501ccdceb62382b3b0254a6a119e0 3x"}, "body": "平素よりお世話になっております。\nこの度、是非お描き頂きたいシチュエーションがございますためリクエストをお送りします。\nよろしくお願いいたします。\n\n■キャラクター\n『十三機兵防衛圏』の『沖野司』\n※公式プロフィールにあるように女装をするキャラです。服装などは後述いたします。\nhttps://13sar.jp/sub_character/#chara1\n\n■シチュエーション\n女装時のセーラー服姿で比治山隆俊を誘惑している。\n本編で比治山の脳内を覗きながら言葉責めをするシチュがあるのですが、その延長で椅子に拘束されている比治山の上へまたがり、股間をグリグリと押し付けるシーンをお願いいたします（比治山はズボン越しに勃起している状態で、下半身のみの描写でお願いします）。\nまたがる向きは対面座位でも背面座位でもどちらでも構いません。\n\n背景・服装含め当該シーンの参考資料は下記をご確認ください。\nhttps://drive.google.com/drive/folders/1YO9ijfpoSn1PjAFxHGBwpJqxlb0OJzG8?usp=sharing\n\nまた、可能でしたら（沖野に股間をグリグリされて）パンツ内に射精した比治山がズボンに精液染みを作ってしまい、それを見た沖野が「本当に変態だな比治山くんは…」と目を細めて愉しそうに微笑む差分も頂けますと有難く存じます。\n\n金額的に難しい要素がありましたら、適宜キャンセルもしくは再送要請を頂けましたら幸いです。\n是非ご検討のほどよろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 31393, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "成田いつみ(バラキー)COMITIA156_@ぬ17a", "screen_name": "TANGANLOVER", "avatar_url": "https://pbs.twimg.com/profile_images/1917976344933380096/dW1AadJZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/160904166/1565554823/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 314671, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "不知火▶︎", "screen_name": "shiranui_0123", "avatar_url": "https://pbs.twimg.com/profile_images/2053069234931200001/Z7yLGnt4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/576355935/1777658841/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 177}, {"id": 503745, "