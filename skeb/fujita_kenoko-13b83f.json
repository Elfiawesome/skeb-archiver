oads/origins/92cac436-785d-49ef-8608-3f502725f8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a5b8c53e7bdd351852ef7ed7c27d454, https://si.imgix.net/d6c5f895/uploads/origins/92cac436-785d-49ef-8608-3f502725f8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c3043f81af219e0e92a5a9514298fc96 2x, https://si.imgix.net/d6c5f895/uploads/origins/92cac436-785d-49ef-8608-3f502725f8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e6a329fc22306ef412fab4fba837cdc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6c5f895/uploads/origins/92cac436-785d-49ef-8608-3f502725f8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=941f78e97d4760aeda670b6aa76955e1", "srcset": "https://si.imgix.net/d6c5f895/uploads/origins/92cac436-785d-49ef-8608-3f502725f8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=941f78e97d4760aeda670b6aa76955e1, https://si.imgix.net/d6c5f895/uploads/origins/92cac436-785d-49ef-8608-3f502725f8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ec738f1aee3579b3bcfa8fa623fd7c1 2x, https://si.imgix.net/d6c5f895/uploads/origins/92cac436-785d-49ef-8608-3f502725f8d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9eb06e95d78ef5ff419dcca9575f3b 3x"}, "body": "こんにちは！\nえっちな漫画のリクエストをしたいです！\n\n原作:グランブルーファンタジー\nキャラ名:クラリス\n\n悪い魔道士を追っていたクラリスが、魔法により辱められてしまうマンガをお願いいたします。\n\n・魔道士を追い詰めていたが、急に勝ち誇り始めた魔道士。魔道士の手にはクラリスのブラジャーとパンツ。ノーブラになったため、乳首が浮いてしまっている。魔道士が何を持っているのか理解できずにいたクラリスだが、それが自分のものだとわかると顔を赤くし胸元とスカートを抑える。\n\n・下着を返すように言うが、魔道士にニーソックス以外の残りの服も奪われ裸にさせられてしまう。\n\n・胸と股間を手で隠しながらぐるぐる目で顔を真っ赤にするクラリス。魔道士は土下座した後ここから立ち去るなら許すが、そうじゃないならその格好のまま街に転送してやる、と言い出す。一瞬怯むが、そんな脅しには屈さないと言い返す。\n\n・魔道士はじゃあしょうがないと、魔法で転送する。\n\n・街中に転送され、注目を浴びてしまう。\nしゃがみこんで体を隠すもお尻は丸見え。\n\n・騒ぎを聞きつけ憲兵がやってきて捕まってしまう。立たせられた上に腕を押さえられ体を隠すことができず晒し者の状態に。\n\n・後ろ手縛りの状態で街中連行される。\n\nぜひご検討をお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fujita_kenoko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1946320, "client_id": 3204946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1496789dd6e15dddc2d71f9f7aff1e89", "srcset": "https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1496789dd6e15dddc2d71f9f7aff1e89, https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cce399b98b8ce07c6424c2f63f600660 2x, https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bafbdc8b454a7a70259b5b6dbc65139 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d8df67da74803a1fec5fc639541fc4", "srcset": "https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d8df67da74803a1fec5fc639541fc4, https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=154da066dd7d6a8beaa5fe0980458902 2x, https://si.imgix.net/1616cd11/uploads/origins/b83ca356-8534-4de0-bffe-4b7531d62237?bg=%23fff&auto=format%2Ccompress&fm=w