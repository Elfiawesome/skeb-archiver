2)ので、個人観賞以外に、コマとして使用できるよう、拝啓透過で描いていただけたら嬉しいです。\nポーズなどはお任せ致します。\n\n以上が依頼内容となります。\n金額が不十分だったり、依頼内容的に難しい、などありましたら断っていただいて構いません。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1zNK_nA5kLNmd3RJ8v-swN2fBnQJ7KlN9?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Andou_Honpo/works/157", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2875278, "client_id": 1571002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66a5b462/uploads/origins/c0b001cd-b7f8-40e3-901f-1cf35df79d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd2a74f3f42bfaeb96ff661e52aaebdc", "srcset": "https://si.imgix.net/66a5b462/uploads/origins/c0b001cd-b7f8-40e3-901f-1cf35df79d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd2a74f3f42bfaeb96ff661e52aaebdc, https://si.imgix.net/66a5b462/uploads/origins/c0b001cd-b7f8-40e3-901f-1cf35df79d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c8cdca763d5cb6902d0ce4e9ad8ec00 2x, https://si.imgix.net/66a5b462/uploads/origins/c0b001cd-b7f8-40e3-901f-1cf35df79d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac495016ab6f170483074ec082ea6361 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66a5b462/uploads/origins/c0b001cd-b7f8-40e3-901f-1cf35df79d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f22d0658dec507ad5ddd928ee74a0cc", "srcset": "https://si.imgix.net/66a5b462/uploads/origins/c0b001cd-b7f8-40e3-901f-1cf35df79d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f22d0658dec507ad5ddd928ee74a0cc, https://si.imgix.net/66a5b462/uploads/origins/c0b001cd-b7f8-40e3-901f-1cf35df79d1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200