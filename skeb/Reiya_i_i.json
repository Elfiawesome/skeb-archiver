mbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Reiya_i_i/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3112240, "client_id": 1309008, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e38f815/uploads/origins/cd29e650-377c-4fa1-9098-2fb4ca363687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aebf43de0ba0cec8a27204ec2f521f74", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e38f815/uploads/origins/cd29e650-377c-4fa1-9098-2fb4ca363687?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cc5dbfd0e588724107a79f07b802a4b", "src_set": ""}, "body": "こんにちは！あなたのアートはとてもキュートで可愛いです！私のOC、アシュリーのアートをリクエストしてもいいですか？ (https://imgur.com/a/vlCZkWx)\n\nアシュリーは、ふわふわの白い体と頬のそばかすが特徴のバニーガールです。アーティストの希望があれば、彼女はふわふわである必要はありません。このアートでは、アシュリーの髪は真っ赤で、爪の色と同じ、本物のイチゴの実のような色にしてほしい。かわいい黒のセーターを着てほしい。これと似たようなスカートを履いてほしいが、丈は長めである。https://imgur.com/a/nhbrUCC\n黒のストッキングかパンストを履いてほしい。もしアシュリーの足が見えるなら、この依頼（https://skeb.jp/@Reiya_i_i/works/2）のように、赤と黒のリボンがついたかわいい靴を履いてほしい。\n\nアシュリーには、片手を顔に近づけてVサインをしながら、幸せそうな笑顔で見る人を見つめてほしい。それ以外のポーズやシチュエーションは、アーティストの自由です。好きなように描いてください！\n\nよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Reiya_i_i/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3112240, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3be2efc7/uploads/origins/32471f0d-fe1b-4413-9326-1bede81a8db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5232ce95119f893ea5e5dab42a7497f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3be2efc7/