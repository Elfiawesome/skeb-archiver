&s=86d936d788cdd465e1012da50c15aa5a 2x, https://si.imgix.net/e6d7ce42/uploads/origins/eeeb682b-e48a-451e-8248-933f6b323549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bcd62ddf795dea5bf7ea21f0a91fa90 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6d7ce42/uploads/origins/eeeb682b-e48a-451e-8248-933f6b323549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3243e43f74df99624f59e5e3b52d2fb", "srcset": "https://si.imgix.net/e6d7ce42/uploads/origins/eeeb682b-e48a-451e-8248-933f6b323549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3243e43f74df99624f59e5e3b52d2fb, https://si.imgix.net/e6d7ce42/uploads/origins/eeeb682b-e48a-451e-8248-933f6b323549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32aac22a3406540320ad32dd2f792b8e 2x, https://si.imgix.net/e6d7ce42/uploads/origins/eeeb682b-e48a-451e-8248-933f6b323549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28277e7476453769740813ad0aa49b5f 3x"}, "body": "ろにさまのふわふわしたイラストが可愛いく、ご依頼させていただきたいです。\n雪ノまいさんと水兜おにく2人が楽しそうにしている雰囲気のイラストをお願いしたいです。\n\n◯希望\n2人が楽しそうにしている雰囲気をお願いしたいです。\nふわふわな感じでお願いします！\n構図やポーズ服装はお任せでお願いいたします。\n\nまた納品時可能であれば、2人のレイヤーを分けた分(別々)も納品いただけますと幸いです。\n背景も描いてくださる場合は、背景なしも納品頂けますと幸いです。\n\n◯使用用途\n\n収益化されたYouTubeにてサムネイルとして使用\nX(旧:Twitter)への投稿・アイコンとしての使用\n\nどうぞ、よろしくお願いします。\n\n雪ノまいさん\nhttps://x.com/_yukino_mai/status/1710146548699672603?s=20\n\n水兜おにく\nhttps://twitter.com/meat_onikuu/status/1619257305979301889?s=46&t=dOoxGy5nYkn0-Y_ndoCvrg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omataro9/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2089168, "client_id": 2341942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb0b798c/u