6d6-677c662739e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2591aad09b3a5efb4a6290778f13847 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db1d5f5e/uploads/origins/381a3574-427e-4073-a6d6-677c662739e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34cb169b5a0f792724450d925452abff", "srcset": "https://si.imgix.net/db1d5f5e/uploads/origins/381a3574-427e-4073-a6d6-677c662739e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34cb169b5a0f792724450d925452abff, https://si.imgix.net/db1d5f5e/uploads/origins/381a3574-427e-4073-a6d6-677c662739e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd71b8bd06eb582968a7bb287289961d 2x, https://si.imgix.net/db1d5f5e/uploads/origins/381a3574-427e-4073-a6d6-677c662739e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2443c2e476c53a35905dd62082535879 3x"}, "body": "はじめまして、歪んだむと申します。\n\nうちの子の「フォルン（シールフォルム/少女姿）」をリクエストします。\n資料で分かりにくい点、不明な点などは描きやすいように調整・アレンジしていただいて大丈夫です。\n\n●リクエスト内容\n「魔法少女」風の衣装を身に着けた、少女姿のフォルンのイラスト。\nファンタジー風でも、リリカルなSFが混じったようなものでも、プリティでキュアキュアな感じでも、どのようなタイプでもOKです。\n武器やステッキなど装備類の有無、\n帽子などある場合はケモミミと角が出るような穴をあける、尻尾も穴から出すか背中が出ているデザインにする…などもお任せします。\n\n●モチーフやイメージカラー\n・角のある狼（本来の姿イメージ）\n・体毛の銀\n・魔力や角、体毛のメッシュ部分の黒\n・氷の青や水色系\n\n※その他捕捉　\n首輪や鎖＆鉄球は据え置き。\n鎖や鉄球を小さいアクセサリー風にアレンジするなども可（参考https://skeb.jp/@kinkan8cc/works/11 ※大人姿のもの）\n\nその他、髪型（長さ含む）のアレンジなどもお任せしますので自由にデザインしてください。\n可能であれば簡易な背面資料などもあるとありがたいです。\n\n\n表情やポーズ、構図などはお任せします。\n\n文字や背景、宛名・サインにつきましてはpsdレイヤーで別々にon/offできるようお願いいたします（投稿時はサインon）\n\n●使用用途（クレジットは明記）\nSNSへの掲載\n依頼時の参考資料としての使用\n\nご検討よろしくお願いします。\n\n●簡易な設定など\nシールフォルム\n褐色の肌に銀毛の、角の生えた狼獣人の少女のような姿。\n獣人ではなく、狼型のモンスターが封印され弱体化した状態。封印の要となっている首輪や鎖は外れない。\n銀毛だが耳や尻尾の先端は色が異なる。髪や尻尾の一部に紋様のような黒いメッシュが入る。\n一見すると無表情っぽいが、人の姿にまだ慣れていないため表情筋がぎこちなく感情が顔に出にくいため。無感情ではない。\n２足歩行にも慣れていないため、時折転びそうになる。\n人の耳はなくケモミミのみ。