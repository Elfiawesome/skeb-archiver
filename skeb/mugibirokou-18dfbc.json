": 2238507, "client_id": 3888230, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df3f3c3e2d70779be7dc11beadfcad79", "srcset": "https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df3f3c3e2d70779be7dc11beadfcad79, https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c07d4c9a0bbc41af991a2d246556491f 2x, https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e6b1bd335a6d414fe9b8e7b6824a46e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c4d7bf6fdba8932b2920b7ac5a9eab", "srcset": "https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35c4d7bf6fdba8932b2920b7ac5a9eab, https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ad1e63219ca6b6216f86b7aa1bccf85 2x, https://si.imgix.net/9ab1146e/uploads/origins/a7c01b8c-e14e-4e4b-90e7-17bc7e6f3651?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee81a6dbc2f256371189d0e4e821f569 3x"}, "body": "はじめまして！\n声で活動予定の冥夢るちと申します。\nイラストを拝見し、ぜひ等身サイズでキャラクターをデザインをしていただきたいと思い依頼を送らせてていただきました。\n\n【キャラクター詳細】\nキョンシーの母とインキュバスの父から生まれた女の子です。\n年齢は83歳ですが見た目は幼くまだ子供です。\n夢の中で誘惑し生命力を奪い、人間を幸せな夢から目覚めさせないようなお仕事をしてます。\n性格は大人しく恥ずかしがり屋の感情が薄めです。\nたまに暴走します。\n好きになると愛は重く、独占欲強めのメンヘラ気質です。\nいつもはまったりおっとりと眠くなるような声でお話しますが、照れたり愛が暴走すると早口になってしまいます。\nキョンシーの御札をおでこに貼り付けると大人しくなります。\n\n【キャラクター見た目】\n髪の毛：腰まであるロング\n髪の色：全体ピンクのだんだん水色（肩くらいから変わっていきます。）\n目の色：右目ピンク、左目水色（画面から見ると左ピンク、右水色です）\n口：八重歯あり\n見た目：幼い（東方プロジェクトのフランちゃんくらいです）\n胸：小さく控えめです\nおへその下に魔術的なハートと悪魔の羽の紋様があります（淫紋のような感じです）\n小さい黒い羽があります。背中にはくっついていません。\n服装：服装は黒色がメインで、ひらひら多めのキョンシー風でデザインしていただいてもよろしいでしょうか。\n足元は片方網タイツにしていただきたいです。\n\n以上になります。\nとても細かくなりますがご縁がありましたらよろしくお願いいたします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mugibirokou/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2238507, "client_id": 1424286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87afdff2/uploads/origins/9ebdbfb4-8351-466a-8bd4-42f13a41be1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6abcddcd32733b304eee57d003c3c175", "srcset": "https://si.imgix.net/87afdff2/uploads/origins/9ebdbfb4-8351-466a-8bd4-42f13a41be1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6abcddcd32733b304eee57d003c3c175, https://si.imgix.net/87afdff2/uploads/origins/9ebdbfb4-8351-466a-8bd4-42f13a41be1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e643c0139cc0b4ce135fb3bc74da99c3 2x, https://si.imgix.net/87afdff2/uploads/origins/9ebdbfb4-8351-466a-8bd4-42f13a41be1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdd3df59cdef302322ccde9857a6c29e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87afdff2/uploads/origins/9ebdbfb4-8351-466a-8bd4-42f13a41be1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=671aeab70d3df02b612fb21b582f8af6", "srcset": "https://si.imgix.net/87afdff2/uploads/origins/9ebdbfb4-8351-466a-8bd4-42f13a41be1f?bg=%23fff&auto=form