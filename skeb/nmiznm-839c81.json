書くのが好きです。身長は152cmです。 彼女は他人に不運をもたらしてしまうという呪いにかかっており、そのせいでとても孤独です。髪は黒で、一筋だけ白い髪が入っており、同じ側の目の下にほくろがある点にご注意ください。\n\n服装については、スカートのファスナーを少し開けた状態で、レインジャケットを着用している様子にしてください。服装のデザインについては、自由に調整や編集をしていただいて構いません。\n\nこのイラストを、キャンペーンが公開されているSNSやYouTubeに投稿したいと考えています。ご検討いただきありがとうございます！！\n\nhttps://drive.google.com/drive/folders/1Kd1UxFE6HOwON1BwiUMW-5905mHoSFEv?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nmiznm/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4011422, "client_id": 3616732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95e55e39/uploads/origins/08229d5d-f96f-4dce-8098-a7dbdb014f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2855a6c141bb3baa5ac1d41ccb72791", "srcset": "https://si.imgix.net/95e55e39/uploads/origins/08229d5d-f96f-4dce-8098-a7dbdb014f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2855a6c141bb3baa5ac1d41ccb72791, https://si.imgix.net/95e55e39/uploads/origins/08229d5d-f96f-4dce-8098-a7dbdb014f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0a1db0c8880b388e289d1da791ef932c 2x, https://si.imgix.net/95e55e39/uploads/origins/08229d5d-f96f-4dce-8098-a7dbdb014f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1991e65b6e4bc33a4474a21980eda7b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95e55e39/uploads/origins/08229d5d-f96f-4dce-8098-a7dbdb014f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c66bff11d0bd8744c695cdb0e2c9d66", "srcset": "https://si.imgix.net/95e55e39/uploads/origins/08229d5d-f96f-4dce-8098-a7dbdb014f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c66bff11d0bd8744c695cdb0e2c9d66, https://si.imgix.net/95e55e39/uploads/or