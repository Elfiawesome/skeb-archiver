ody": "はじめまして、あなたの描かれている男の娘のイラストが大変えっちで素敵だったのでぜひうちのOCを描いて頂きたくリクエストさせていただきます。\n[キャラクター]\n自OCルカ。小悪魔系吸血鬼少年。\nかわいいものと気持ちいいことが好き。\n人の血や精液などの体液を食事としている。\n食事のために夜な夜な男遊びをしている。\n\nシチュエーションや構図はお任せでエッチでかわいく描いて頂ければと思います。\n衣装はお任せであなたの好きな衣装にしていただければと思います。\nもしよろしければお願いします。\n\nhttps://drive.google.com/drive/folders/1DnPE_SK6bxdjgoB8_aAIaqpi6w6mIrqA?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ame/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1020381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8eba227/uploads/origins/84b0af97-0d36-42db-b22b-46f80a73918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db1420a424bf3ea489790a43ff3c9921", "srcset": "https://si.imgix.net/b8eba227/uploads/origins/84b0af97-0d36-42db-b22b-46f80a73918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db1420a424bf3ea489790a43ff3c9921, https://si.imgix.net/b8eba227/uploads/origins/84b0af97-0d36-42db-b22b-46f80a73918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db7b85e62079449a382423906cf7d348 2x, https://si.imgix.net/b8eba227/uploads/origins/84b0af97-0d36-42db-b22b-46f80a73918b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f9b090a58b092395e7f49e8d4e007c6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8eba227/uploads/origins/84b0af97-0d36-42db-b22b-46f80a73918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5ba317eed38fea615ca13560bb6be1", "srcset": "https://si.imgix.net/b8eba227/uploads/origins/84b0af97-0d36-42db-b22b-46f80a73918b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee5ba317eed38fea615ca13560bb6be1, https://si.imgix.net/b8eba227/uploads/origins/84b0af97-0d36-42db-b22b-46f80a7