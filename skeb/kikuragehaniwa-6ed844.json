698f944174a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=367e240594679d121c3a5a68ab0146ce 2x, https://si.imgix.net/3c5839ec/uploads/origins/730448b9-8075-4516-8589-c698f944174a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed24dab547359a03293df65f625314d 3x"}, "body": "こんにちは！あなたの作品を拝見し、とても気に入りました。\nこのキャラクターのリファレンスをお願いしたいです！衣装の変更・デザインは自由です。\n彼女は好きなことをする、独りよがりのウサギの女の子です。\n好きなように描いてください！\n\nよろしくお願いします！\n\nhttps://drive.google.com/file/d/16Yjgdd7YdOmI9b2Bg7kArCrkJHnwAga0/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikuragehaniwa/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3371110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c30578d3af7b8eaf2cfc920636943400", "srcset": "https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c30578d3af7b8eaf2cfc920636943400, https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e93512e7a9aa5b5d6815c32cd12e210b 2x, https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f556a612abd2b8ea909870740fab68a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23d43ce349b7b7f6f4783297df0bb9b4", "srcset": "https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23d43ce349b7b7f6f4783297df0bb9b4, https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ea93f39092851be6b78ca7ab54646d1 2x, https://si.imgix.net/cd5186aa/uploads/origins/da74eafa-8d4c-40ae-bb54-141cdcbe3896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8489f410575992a077cf5ad9fd9de501 3x"}, "body": "こんにちは！このアイソポッドキャラクターのリファレンスを描いていただけませんか？彼女は生意気なニートの妹 \"girlfailure \"です。黒く疲れた目と、頭の虫の触角がポイントです。彼女はどの衣装も平べったくて背が低いです。\n\nこの作品では、3種類の衣装を描いてほしい。メインの衣装、そして最も重要な衣装は、衣装1の \"cozy outfit \"です。ゆったりしたTシャツ、タンクトップ、ショートパンツ。\n\n2つ目の衣装は、衣装2の「通学服」。長袖のワンピースにイソポッドの帽子。かわいいランドセルも持っているので、それも描いてほしい。\n\n3つ目の衣装は、衣装3の「インターネット衣装」。デジタル虫のような格好をしている。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1J30YNor6bGtosETarVKyplHsVqvY3ctj?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikuragehaniwa/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3371110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eed0d7eff263cfc836ebb84065f9d568", "srcset": "https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eed0d7eff263cfc836ebb84065f9d568, https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d1d21c798212ae45c4d589a531bb5b9 2x, https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=637e671f671dd9c3ad196478ce17ae76 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0474e75ab315896734652ec8ed83f2c", "srcset": "https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0474e75ab315896734652ec8ed83f2c, https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a819a7cdd439f40eac4e13a8dd63b77 2x, https://si.imgix.net/e17aea1d/uploads/origins/4a6c662f-78ea-4c2c-9694-022e4e268bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=751bbe760a32d92cfbaccfd7cf1bcdcf 3x"}, "body": "木耳様の作品を拝見し、デフォルメ感やポップな雰囲気がとても可愛かったのでOCをリクエストさせていただきたいです。\n\n【設定】\n・私のスマホに住んでいる AI。元気でお話好きな女の子。\n・可愛いお菓子が好き。食べることはできないのでデータを味わう。\n・面食いでミーハー。恋愛対象は機械やコンピュータ\n・外見は自由に変更可能。\n\n【外見】\n外見年齢：10代後半くらい \n瞳：ピンク。虹彩は水色ですがデフォルメ加減で再現できなくても良いです。 \n髪色:薄紫。光の加減で水色やピンクに見える設定。\n髪型:膝くらいまでのゆるくて太い三つ編みおさげ。\n服装:シンプルなジャージメイド。黒系のミニ丈ジャージワンピで袖は手が隠れるくらいの長さ。エプロンは白。白いルーズソックスに厚底スニーカー。スニーカーの色はお任せします。ヘッドドレス無し。どこかにピンクの大きめのリボンをアクセントにつけていただきたいです。\n\n【備考】\n・後ろ姿があると嬉しいです。\n・SNSアイコン、アクスタやステッカーなど、個人使用のみのグッズにしたいのでキャラのみのレイヤー差分があると嬉しい。\n\n文字ベースの依頼で申し訳ございません。\n全体の雰囲気が伝われば基本的に木耳様のご自由に描いていただきたいと思っています。\n金額不足や不適切な部分がありましたらお手数ですがキャンセルしてください。 \n\n※資料画像はアイコン作成サイト様にて作成。 画像をもとしたイラストの依頼は問題ないことを規約で確認済みです。\n\nhttps://drive.google.com/file/d/1AeWfnEYS4WFKBZUKhRfwVyu-qCK1WX8Z/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kikuragehaniwa/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a566c717/uploads/origins/d09c