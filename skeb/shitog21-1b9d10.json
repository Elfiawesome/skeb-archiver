（沈み過ぎるようなら濃紺）、差し色で白をお願いします。\n（スパッツは黒でお願いします）\n\n首元にチョーカーつけています。おおまかなデザインは資料の方に入れました。\n\n可能であれば表情差分お願いしたいです。\n通常（資料のような微笑み顔）、怒り顔、笑顔（満面の笑み）、アスプロス憑依状態（資料にある三白眼の赤目、挑発的な表情）\n\n塗り、瞳タイプに関してはアニメ系でお願いします。\nまつ毛の長さは男の娘なのですが気持ちちょっと長めを意識でお願いします。（ほぼ女の子くらいになっても大丈夫です）\nよろしくお願いします\n\nhttps://drive.google.com/file/d/1e-nMWKJoWvXk5hZXoBbK23Auzuzzv3Hb/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shitog21/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 223812, "client_id": 352194, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0626e299/uploads/origins/1213a27f-ebbe-417c-9b46-1bcd599094ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97d58ff04b3dd891daaccbf0ccbe85b", "srcset": "https://si.imgix.net/0626e299/uploads/origins/1213a27f-ebbe-417c-9b46-1bcd599094ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97d58ff04b3dd891daaccbf0ccbe85b, https://si.imgix.net/0626e299/uploads/origins/1213a27f-ebbe-417c-9b46-1bcd599094ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a99913129436f797f11c1e31292b370 2x, https://si.imgix.net/0626e299/uploads/origins/1213a27f-ebbe-417c-9b46-1bcd599094ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af0a940b789d1dafa5209da188f09d5f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0626e299/uploads/origins/1213a27f-ebbe-417c-9b46-1bcd599094ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df3ec67e28cb6ad062954ab6f33ef6fd", "srcset": "https://si.imgix.net/0626e299/uploads/origins/1213a27f-ebbe-417c-9b46-1bcd599094ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df3ec67e28cb6ad062954ab6f33ef6fd, https://si.imgix.net/0626e299/uploads/origins/1213