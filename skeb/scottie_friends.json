ls_count": 0, "received_works": [{"path": "/@scottie_friends/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 69320, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/169fcf39/uploads/origins/3065399c-dfa8-4ec8-8ff1-3fff76085e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0df0db364ddfa690cf96771dba76fcc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/169fcf39/uploads/origins/3065399c-dfa8-4ec8-8ff1-3fff76085e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c244f04a8b16ccc740a483b9ae5f49f5", "src_set": ""}, "body": "初めまして！せっか様のファンです！\n弐番館でアーシャとオディーリアが一緒にお菓子を食べているご様子を描いていただきたいです！\nお忙しいところ恐縮ですが何卒よろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@scottie_friends/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 69320, "client_id": 1807877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dc8877f/uploads/origins/ecba3bbc-40a0-45f2-afa9-de74fd2ce133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c20d5f9815373e9c177ab65203d5fe5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dc8877f/uploads/origins/ecba3bbc-40a0-45f2-afa9-de74fd2ce133?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc35ee52b4759a30767eb84bf3e7403c", "src_set": ""}, "body": "こんにちは！ 柔らかな線と優しい色で描かれた可愛らしいイラストに惹かれて、今回うちの子のイラストリクエストをお願い致します！\n『メーテライト・ルミエーラ』という変身ヒロインの女の子です。詳細は資料URLをご参照ください。\n「人懐っこい・優しい・可愛らしい・清楚」モチーフの、少女から少し大人びた雰囲気の女の子です。\nデザインの要素に以下のものがあります。\n・瞳の中には小さな黄色い星のハイライトがある。\n・頭部の髪飾りやティアラ、白いもふもふの装飾はそれぞれ独立してついている。\n・後髪は首元で内側にまとまってから、背中辺りから分け目が外側にふわっと広がる。後髪半ばのシルエットが天使の羽根のようにも見える意図。\n・胴のドレスと二の腕のフリルとはそれぞれ独立した装飾。脇下は繋がっていません。\n\nこの子が変身した姿の一枚イラストをお願いします！\n優し気にふにゃっとはにかむ微笑みの表情で、ふわふわのお胸を強調していただきたい…です！\nキャライメージは可愛らしさに加えて、優しくも凛としたお姉さんみのある魔法少女です。\n上記希望はあくまで提案くらいのゆるい指定で、構図やポーズ・資料から読み取れる細かなキャラ解釈はすべておまかせ致します。\n\n使用用途はTwitter(X)やMastodon、Misskey含む外部SNSでのアイコン、ヘッダー使用・イラスト紹介・紹介ツイートをtogetter(min.t)などの自身のまとめへ追加。\nリクエストする際に上記まとめのURLを引用する場合があります。\n\nPSD形式希望で、恐縮ですが宛名とキャラと背景のレイヤー分けをお願いします。分離不可の場合は統合状態を問いません。\nラフや下書きなどの途中経過を見せても良い場合は、レイヤー下に残していただけますととても嬉しいです。\nどうぞよろしくお願いします！\n\nまとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n資料URL\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm\n\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@scottie_friends/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f73db1f9/uploads/origins/aed6ea1a-ae8d-4ab7-9c4e-396d0282ad39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b96b1220da379ec983d2256e7fc1ed5c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 69320, "client_id": 43142, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@scottie_friends/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 69320, "client_id": 59890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc2412f6/uploads/origins/5c794ac2-d9f5-4578-b644-9206a86f1333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fbc57fb9c2681124fde604cb4f5df25", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": 