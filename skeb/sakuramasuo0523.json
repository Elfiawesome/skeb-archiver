: 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 71, "received_works": [{"path": "/@sakuramasuo0523/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445867, "client_id": 1074147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/441de213/uploads/origins/20be6e2b-0e80-4086-aa15-16fc045518ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e64576b548d534bf52e7d9db06beb7af", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/441de213/uploads/origins/20be6e2b-0e80-4086-aa15-16fc045518ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc63a5182fc68529862b3a58feb95d14", "src_set": ""}, "body": "こんにちは、あなたのアピールを受けたいと思います。\nよろしくお願いします：千賀（私のOC） - https://skeb.jp/@ryohakosako/works/102 .\nアクションポーズでお願いします。\nチガが短剣を斬るポーズをお願いします。\n千賀が横っ跳びしているところとか。\n見せ方：（千賀一人を）ほぼ正面から。\n背景：薄いグレーの無地。\nポーズ、アングル、その他はお任せします。(テキストなし)。\nありがとうございました！💕", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 2178716, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c43f205e/uploads/origins/445c82de-5635-4322-97e6-5e2d732826cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ea4001c73aa6cfa6b6f01cea6894ea1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c43f205e/uploads/origins/445c82de-5635-4322-97e6-5e2d732826cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=272f97ecc0ea91c5d94fc2607d5f2846", "src_set": ""}, "body": "初めまして。\n佐倉様、アピールありがとうございます！\nカッコイイ立ち絵ですね。是非、描いていただこうと思います！\n\n当方のOC桐生ちゃんをお願いします(*´ω｀*)\n瞳の色は茶。\n髪色は色素の薄い金髪にうっすら桃色が入ったような色です。\n肌の色は健康的な小麦色。\n年齢は20歳で、身長168cm/体重59kg。スレンダーですが筋肉はついてる感じです。\n\n\n参考資料OC桐生 翼\nhttps://x.com/dd_uj0/status/1935107116777488493\n\n筋肉バキバキって感じじゃないけど、腹筋は割れてるってくらいの塩梅でお願いします。水着の柄は省いてもらってもかまいません。\nポーズなどはお任せします。\n\n問題なければ宜しくお願いしますm(__)m", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445867, "client_id": 136839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb0a3541/uploads/origins/473b7a63-d16b-4c4d-9c0c-2af995a16085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d541aab033687d9fb7d3f3f29448a9be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb0a3541/uploads/origins/473b7a63-d16b-4c4d-9c0c-2af995a16085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=502e5f275b869d796a48bce8b42a75bc", "src_set": ""}, "body": "佐倉 益生 様\n初めまして。大分前にアピールを頂いていたのですがこちらの都合でなかなかお返事が出来ないままで申し訳ありませんでした。\nこの度手数料無料期間という良い機会が訪れたので、依頼させて頂きたく参上致しました。\nこの度依頼したいのは、ＰＳＯ２のマイキャラクターです。\n　\n資料①全身:顔周り:https://imgur.com/a/7rS5vnQ\n性別は女性、髪色は白、肌の色はやや褐色です。\nハーフトップのシャツにショートパンツ、ニーソックスを履き、長袖のジャケットを羽織っているという感じの服装です。\n髪型はセミロングでうなじ辺りで縛っている感じです。\n帽子に関しては詳細な資料がありませんので無しにして頂くか、キャラ像がギルティギアのジョニーをモチーフにしているので、黒のテンガロンハットに差し替えて頂けると幸いです。\n\n資料②ジョニー:https://imgur.com/a/1610doU\n資料③帽子無し差分:https://imgur.com/a/I0HcjDe\n\n資料④コラボ元服装:髪型:https://imgur.com/a/rQbJZVH\nコスチュームとヘアスタイルがコラボアイテムなので、元キャラの資料です。\n服装のディティールに拘りは無いので細かな装飾等は適宜省いて頂いて構いません。\n(胸元のベルトやマフラー、袖のアームカバーや太もものナイフホルダー等。ジャケットの白いラインも無地にして頂いて結構です)\nブーツの色は茶系の色に変更でお願いします。\n\n資料④体型:https://imgur.com/a/fdQOz7I\nゲームで設定出来る筋肉量のゲージを最大にしてあるので、一見細身に見えても脱ぐとかなりガッシリした体付きです。\n特に重要なのが腹筋で、このキャラの一番の特徴であり、服装も腹筋を強調する為に腹部のみを露出し、他のアクセサリーも控え目にしてあるというコーデです。。\nゲームの表現の限界でそこまで強調されていませんが、光源や角度によっては二枚目の資料くらいハッキリと６パックが表現されています。\n腹筋の強い女性が大好きなのでここは可能な限り盛って頂けると幸いです。\n\n構図等はお任せしますが、上記資料のジョニーの立ち絵を元にした感じにして頂いても大丈夫です。\n使用武器も丁度白鞘の刀です。\n資料⑤https://imgur.com/a/a9ycpi8\n\n以上です。\nご検討のほどよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 1285861, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eaf07be5/uploads/origins/e7395213-deec-4bbe-a249-ce4cdca9edff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0ed434c23cdef7dd59b21ede50a3c05", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaf07be5/uploads/origins/e7395213-deec-4bbe-a249-ce4cdca9edff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91b50ab7b2fcb2d1a8d75eeef42cd5a3", "src_set": ""}, "body": "初めまして。カッコイイ筋肉質の女性の体躯が描ける方とお見受けし、リクエストさせて頂きました。\n\n私のOCである「レネス」を描いて頂けないでしょうか。\n参考URL　https://drive.google.com/drive/folders/1W_ApeF6I0wiY7ZsQZ4DZGZt_6_cSu-Pc?usp=sharing\n\n【設定】\n流浪の冒険者＆魔法剣士で、魔法伝導率が高い特殊な金属を触媒にした剣やナイフ等（そういった仕様の剣等であればデザイン等は問わない）に、魔法を纏わせて攻撃するスタイルです。※必要なければ魔法無しで普通に剣やナイフとして使用したりもします。\n基本的に無表情気味で、無口・クール・怖そう・何考えてるかわかりにくいと思われていますが、根は面倒見は良く優しくてお人好し、良くも悪くも真っ直ぐな人間です。特技は料理＆何でも食べられる事です（好き嫌いが無い・ゲテモノもOK）\n\n【衣装】\n今回は参考URLの資料にもあるようなノースリーブショート丈の、二の腕と腹筋が見えるトップス（下はジーパンでもスパッツでも動きやすいボトムスで構いません）で、筋トレや剣の素振りでも良いのですが、何らかのトレーニング中or後のような感じだと嬉しいです。\n身体つきは冒険者なのでそれなりに、細マッチョ程度に引き締まってる感じでお願いしたいです。\n額の鉢巻だけは一応トレードマークなので残しておいてくれると有難いです。\n\nその他お任せしますのでご自由にお描き頂けたらと思います。\nご検討の程、宜しくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 1460936, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ed87586/uploads/origins/de989555-2793-4081-a7d3-21d80bc705b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=278487b74321de9e56fd3e0dc137dcf0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ed87586/uploads/origins/de989555-2793-4081-a7d3-21d80bc705b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86ca05a9f955086049dbda7bb66a52e3", "src_set": ""}, "body": "こんにちは。私のキャラクター、アルタイルを描いていただけませんか？\n\n参考文献\n\nhttps://drive.google.com/file/d/1zyjmOROnvhVcnniSEUn0OnGwHvZiSqK-/view?usp=drive_link\n\nhttps://drive.google.com/file/d/1N9nw5AesxGmJi46lwd6o6bYqiTpMcVe8/view?usp=drive_link\n\nこんな格好で描いてくれませんか？\n\nhttps://drive.google.com/file/d/1cAQ48-0bpcH0PBH8bY2EyZ4Hzz0oMLEF/view?usp=drive_link\n\n要望としては、アルタイルのスポーツブラは胸の谷間が大きく見えて、胸を収めるのに苦労しているように見えること。あと、アルタイルの筋肉がいつもより膨らんで見えること。まるでワークアウトでもしたかのように。血管が見えるように描けたら最高なんだけど。\n\nそれ以外は、ポーズも何もかもあなた次第です。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 48468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1793f4ad/uploads/origins/3ce1cc12-b276-435e-b158-21bf191de1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e1e10289150b5ac7ccf82ebfc8e6f3c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1793f4ad/uploads/origins/3ce1cc12-b276-435e-b158-21bf191de1a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f55068b645274c0b9806b789be7f33c", "src_set": ""}, "body": "アピールありがとうございます！\n遅くなりましたが早速リクエストを送らせていただきます。\n当方のヨハンナ・クリーブランドを気に入っていただいて嬉しく思います。\n\n内容は上記のうちの子「ヨハンナ・クリーブランド」を描いて頂きたいです。\nシチュエーションはトレーニング終わり等、軽装でラフな格好をしている状態で、首からエンゲージリングをチェーンネックレスとして提げています。\nポーズや構図はお任せいたします。\n筋肉の盛り具合等はお任せいたしますが、胸は大きく、可能な限り大きくして頂きたいです。\n身体の傷痕に関しましては難しい場合は省略していただいて結構ですが、左目の傷痕は消さないようお願い致します。\n\nキャラクターのビジュアル等は資料を参照していただけると幸いです。\nざっくりとした内容ですが、是非ご一考くださると幸いです。\n\nhttps://photos.app.goo.gl/XZvHDUZ9L75HYVVZ9", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445867, "client_id": 1978626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8de3904/uploads/origins/ef1c6553-e421-4597-bde6-d2517ffdef9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4eb47bbb85e70a8ae66973220f497234", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8de3904/uploads/origins/ef1c6553-e421-4597-bde6-d2517ffdef9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7faaedafa3c812c66c7023eb8ff52365", "src_set": ""}, "body": "お世話になっております！\n佐倉 益生さんにオリジナルキャラクターのイラストを描いてもらいたくリクエストを送らせて頂きました！\nもしよろしければお願い致します！\n\n■リクエスト内容\n・オリジナルキャラクターの立ち絵のイラスト\n・背景は単色(orシンプルなグラデーション等)\n・多少の小物があれば好ましいです(後述)\n・イラスト全体の色味は紫、緑系の配色であると嬉しいです\n\n■人物詳細\n角の生えた少女です\n金属だろうとゴミだろうとなんでも食べます\n\nおおよその身体的特徴(目元から伸びる模様、模様付きの角や目の下のクマ、欠けた歯)が一致していれば、細かい部分(顔つきやゴーグルの細かい装飾)等の若干の違いは問題ありません\n\n服装はご都合の良いように変更していただいても構いません(そのままでも全然良いです！)\n\n■ポーズ\n・けだるげのあるポーズでお願いします\n(ポーズに関してはそこまで重要ではないのでなんとなくのイメージとして)\n・ヨダレをさり気なく垂れさせて置くのも良いです\n\n■小物\n・金属片や機械の部品のようなものを少し散りばめてほしいです\n・可能であれば足元にロボット(要資料参照)のモニター付の頭部のみを転がせておいてもらえると嬉しいです\n\n長くなりましたが\nもしよければ承認して頂けると幸いです\n\nhttps://twitter.com/mayuge_smash/status/1618549702726934528?t=QPUY01bNMESEhWvTfxEJuw&s=19", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 794949, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56795871/uploads/origins/56bcfa3c-0fb4-4cbf-b8e8-7d20ead9db45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=633f351e55b062629906c67e0068f577", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56795871/uploads/origins/56bcfa3c-0fb4-4cbf-b8e8-7d20ead9db45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37abc5326588b8c4f8debee5c2e059af", "src_set": ""}, "body": "はじめまして！素敵なイラストを拝見させていただきました！\nウマ娘のヒシアマゾンを描いていただけませんでしょうか？\nかなり筋肉質な感じで、筋トレ後のパンプアップしている感じに描いていただきたいです。\n腹筋や脚はバッキバキにしてもらって構いません。\n服装はおまかせしますが、腹筋や脚の筋肉がしっかりと見えるものにしていただきたいです。\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445867, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c539132/uploads/origins/7239069d-c367-4e5f-bdaa-2904a3717ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=819cda7bfe0e7f972bf5710242169716", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c539132/uploads/origins/7239069d-c367-4e5f-bdaa-2904a3717ef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bc95e3f242176eda185720fc9522d12", "src_set": ""}, "body": "こんにちは　初めて依頼させていただきます\n\n「ファイアーエムブレム暁の女神」より「ワユ」というキャラを描いていただきたいです\n\nhttps://postimg.cc/30rs1X05\n\nhttps://postimg.cc/n9HJ585W\n\n\nポーズはある程度腕を上げていて脇が見えることと、全身イラストだと嬉しいです\n\nご存じない作品かと思われますが、ご検討よろしくお願いいたします", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2445867, "client_id": 445160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0799799/uploads/origins/3059bc3c-14bb-4e54-95c5-450a9dd1d9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03757f68b86682a83dbc2451ab422d63", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0799799/uploads/origins/3059bc3c-14bb-4e54-95c5-450a9dd1d9d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e5644ee4cb20d690dc2e8f8b2211772", "src_set": ""}, "body": "ヘルテイカーよりアザゼルを描いて欲しいです！\nポーズはＩ字バランス、表情は笑顔でお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 202590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/274d1171/uploads/origins/313041ac-bf99-4105-bff3-9de6b9679f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dff78281eae2da0265b1570af224a33", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/274d1171/uploads/origins/313041ac-bf99-4105-bff3-9de6b9679f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=650ba29aaba8b88df8e8021bfcdb0a46", "src_set": ""}, "body": "ご存じない作品かも知れませんが、よろしければご検討下さい。\n描いて頂きたいのはブルーアーカイブの鹿山レイジョです。\nhttps://bluearchive.wikiru.jp/attach2/E383ACE382A4E382B8E383A7_E383ACE382A4E382B8E383A72E706E67.png\n\nレイジョがハイキック(またはカカト落とし)している立ち姿の後ろに、下から覗いた下着を描写して下さい。MtU構図(ウイルス)と言われるものです。\n(イメージとしては下から覗かれた後、レイジョが攻撃してきたという感じです)\n\nMtU構図(ウイルス)についてはこちらをご参考下さい。\nhttps://www.pixiv.net/artworks/107674212\nhttps://www.pixiv.net/artworks/103717817\nhttps://www.pixiv.net/artworks/105912374\nこちらはあくまでMtUの参考になりますので、その通り描いて下さいというわけではありません。\n構図等ご自由にして頂いて結構です。\n\nぱんつは赤系のセクシーなものでお願いします。(ざっくりした指定になりますので解釈が難しいという場合はご自由にして下さい。希望としてはぱんつ見えてる面積多いと嬉しいくらいです)\n\n作業量に対して金額が見合わないなどありましたら、キャンセルもしくは金額調整の上での再送もご検討頂ければ幸いです。よろしくお願いいたします。\n\nhttps://dic.pixiv.net/a/%E9%B9%BF%E5%B1%B1%E3%83%AC%E3%82%A4%E3%82%B8%E3%83%A7", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 28975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec9066e8/uploads/origins/705f9068-aeb7-444d-b2d3-dc6747fd18e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9d7a84f6f2d123e35e0a4337a9b695e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec9066e8/uploads/origins/705f9068-aeb7-444d-b2d3-dc6747fd18e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee9f0787d73b410d4d4b3da347b7fa9b", "src_set": ""}, "body": "こんにちは。\n\n春や夏をテーマにしたイラストで、キャラクターを自由に描いてください。\n\n以下は、キャラクターリファレンスシートです。\nhttps://imgur.com/a/XK2TfGM\n\nデザイン、衣装は自由に変更していただいて問題ありません。 ポーズや構図に特にこだわりはありません。\n\n衣装は似合うと思いますが、調整・変更はご自由にどうぞ。\n\nありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakuramasuo0523/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2445867, "client_id": 8240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0a57b14/uploads/origins/2c798c3d-81dc-40ec-b920-160c3dd864f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=730ef03e1e42f284f23d82e42754f959", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"