サイン、人物、(背景)等を分けたファイルを頂けたら嬉しいです!\n\n長くなってしまいすみません!💦お忙しい中恐縮ですが、ご検討の程よろしくお願い致します…!\n\nhttps://drive.google.com/file/d/137w9fGfA-PU_KlOopZOWwoTPobbM9H91/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/137w9fGfA-PU_KlOopZOWwoTPobbM9H91/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ousssx_x/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8e12fc08/uploads/origins/76a90092-c50c-4b05-9652-dc32fb3e1fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67aee9562befdf8dc367f810c42a6a3f", "srcset": "https://si.imgix.net/8e12fc08/uploads/origins/76a90092-c50c-4b05-9652-dc32fb3e1fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67aee9562befdf8dc367f810c42a6a3f, https://si.imgix.net/8e12fc08/uploads/origins/76a90092-c50c-4b05-9652-dc32fb3e1fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8eb8bb01fec4028f6c60fded9f0fad20 2x, https://si.imgix.net/8e12fc08/uploads/origins/76a90092-c50c-4b05-9652-dc32fb3e1fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=81b0ded2f5c82950bdc9633f82e1ce82 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2757200, "client_id": 3059426, "nc": 129}, {"path": "/@ousssx_x/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2757200, "client_id": 3105938, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a5e3e1b/uploads/origins/14b4fb8e-bf54-429a-8535-2cde768b1eba?bg=%23fff&auto