恋愛感情があり、シナリオ後はお互い穏やかにあびで働いています。\n\n　その他構図なども描きやすいものや描きたいものでお願いします。色々細かく頼んでしまい申し訳ありません！ですが、一番は楽しく描きやすい、描きたいものでお願いします！よろしくお願いします！\n　また化野と恋愛関係がありますのでそういうのは嫌だな、値段に問題がある、資料が足りないなどあれば再送をお願いします…！\n\nhttps://drive.google.com/drive/folders/1dlgppCV3mNXvkqHLs9gv627DxUt4fSF9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ko_0070/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1bf89f80/uploads/origins/70319ae5-6814-4d42-be9a-b2a17c797b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c479cd420974ebf18090053eb1ad3951", "srcset": "https://si.imgix.net/1bf89f80/uploads/origins/70319ae5-6814-4d42-be9a-b2a17c797b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c479cd420974ebf18090053eb1ad3951, https://si.imgix.net/1bf89f80/uploads/origins/70319ae5-6814-4d42-be9a-b2a17c797b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f174e557b0e38b7806c9fb0155bb91eb 2x, https://si.imgix.net/1bf89f80/uploads/origins/70319ae5-6814-4d42-be9a-b2a17c797b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73b55d443f22cfaa0be557fbe40da466 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3783187, "nc": 0}, {"path": "/@Ko_0070/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3783187, "client_id": 3923419, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/735d7afb/uploads/origins/73a51f36-18e1-4122-a478-8d0421ac5abc?bg=%23fff&auto=format%2Ccompres