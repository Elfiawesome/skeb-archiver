がありましたら再送・キャンセルしていただけますと幸いです\nご検討の程よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1o7KRMfSLF45jvhPduTuM2XmKdnH2AQCP", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ko_0070/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3783187, "client_id": 3334119, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45492129d03f451ab0841a17f43b444f", "srcset": "https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45492129d03f451ab0841a17f43b444f, https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bb2cee61a9e8d6b28d7b40f20ea0173 2x, https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=790c2582401e543f1a51e30d96ef83a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0748cf8521394942165f26f037bc5cb", "srcset": "https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0748cf8521394942165f26f037bc5cb, https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a989b2c3d2459aa3644f5a970e1c4fe6 2x, https://si.imgix.net/da4aa6f3/uploads/origins/5096b844-b9d0-4e02-a3c6-409be268a925?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f994c52d0d074137aeba4e5ca9fbb798 3x"}, "body": "こんにちは、いつもイラスト拝見させていただいています。天喰(Furana)です。\nうちの子(探索者)のイラストを依頼させていただきたく思います。以下詳細です。\n\n\n✦依頼内容\n東京ゴーストマティカHO灰のイラスト\n\n\n✦キャラの見た目\n下部にURL記載\n服装や見た目等で描きにくい点やわかりにくい点がありましたら省略して頂いて構いません。\n\n\n✦キャラの性格や設定\n排地 成葵(はいち なき)\n25歳男\n神出鬼没の考えてることがあまり読めないタイプ。自称みんなのお兄さん。\n好きなものはウインナーコーヒーで最近はカフェ巡りにハマっている。\n頼られるのが好きで、ひとりで無理している人がいると怒る。その割に自分のことはあまり話さない。\n\n\n✦構図\nお任せ致します。\nPCの壁紙等に使用させていただきたい為、16:9だと嬉しいです。\n\n\n✦使用用途\n鑑賞,壁紙などの個人的な使用\n\n\nもし不足がありましたら再送していただけますと幸いです。\nご検討の方よろしくお願いいたします。\n\n資料▶https://drive.google.com/drive/folders/17A-zKyjIrT8ASOSr6WJ2ocWdPBsmI0Jf?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ko_0070/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3783187, "client_id": 1528947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e965d2d2/uploads/origins/450cb578-794f-4a95-88cc-dcc57a87711b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73cebf513ac4bfebed4777d746b3feae", "srcset": "https://si.imgix.net/e965d2d2/uploads/origins/450cb578-794f-4a95-88cc-dcc57a87711b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73cebf513ac4bfebed4777d746b3feae, https://si.imgix.net/e965d2d2/uploads/origins/450cb578-794f-4a95-88cc-dcc57a87711b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1e75677b891f3f891fc789501eb4be7 2x, https://si.imgix.net/e965d2d2/uploads/origins/450cb578-794f-4a95-88cc-dcc57a87711b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3ac98e5c3206c8dbe280ec742025502 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e965d2d2/uploads/origins/450cb578-794f-4a95-88cc-dcc57a87711b?bg=%23fff&aut