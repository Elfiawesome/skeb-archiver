ただきました…！\n\n拙宅のキャラクター、及び関係者のペアイラストを描いてはいただけませんでしょうか？\n二人はそれぞれ我の強い兄と姉を持っている幼馴染で、同じ大学の違う学部に通っています。インドアながら、2人で出かける事もあり、水族館やイルミネーションなど静かな場所へ出かけることが多いです！\n構図や等身、場面等はおやま様へ全てお任せ致します。服装も簡略化して頂いて構いません。お好きに描いて頂ければと思います…！\n\nまた、可能であればSNSのアイコンやヘッダー等に使用させていただきたいと考えております…！\n以上要件のみとなりますが、ご一考頂けますと幸いです。\nよろしくお願い致します！\n\nhttps://drive.google.com/folderview?id=1gwEyujDfU0nAediJQUi5oq5Itx8Lx1iI", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 52621, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "幎メイジ", "screen_name": "77___2", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F08b48a5e-3b12-4b9e-b439-067bf92c27b7.png?avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 804287, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "--", "screen_name": "misooo_hnf", "avatar_url": "https://pbs.twimg.com/profile_images/1685896558112550912/Y0nCCLnA.png", "header_url": "https://pbs.twimg.com/profile_banners/834840866678153216/1663367759/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 3507616, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "どんあら", "screen_name": "aradon_seaweed", "avatar_url": "https://pbs.twimg.com/profile_images/2069832546532433920/Ozmuvr4e.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1821518742473584640/1782118641/1500x500", "appeal_receivable": fa