73e94/uploads/origins/142aa452-7522-4903-9465-7e3b9fd340c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dab46448cded588a8660cfdac3bab35", "srcset": "https://si.imgix.net/d9073e94/uploads/origins/142aa452-7522-4903-9465-7e3b9fd340c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dab46448cded588a8660cfdac3bab35, https://si.imgix.net/d9073e94/uploads/origins/142aa452-7522-4903-9465-7e3b9fd340c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26ff51e591b5af42cf3f21d16fd35b71 2x, https://si.imgix.net/d9073e94/uploads/origins/142aa452-7522-4903-9465-7e3b9fd340c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab2c8d58372f7400cbbbdeef1f6f3c48 3x"}, "body": "こんにちは！\n\nあなたの作品の不気味で怖い雰囲気がすごく好きです！\n\n私のキャラクターを描いていただけませんか？\n\nhttps://drive.google.com/drive/folders/1moJkXbV4anuzMcOfaq1wnjFJZpz1-_2-\n\n分かりやすくするためにオリジナルのデザイン参考画像を添付しましたが、キャラクターデザインは@sisoharanakamaさんのバージョンに近い形に仕上げていただけると嬉しいです！\n\nマスクを着用するかどうかは、お任せします！\n\nポーズや設定も、お任せします！\n\n提案をお読みいただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1moJkXbV4anuzMcOfaq1wnjFJZpz1-_2-", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Samezawa/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 4039485, "client_id": 1410689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a17145966edbe8501a679ebae01f022f", "srcset": "https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=a17145966edbe8501a679ebae01f022f, https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=76b9cd67de1273ed3a0a3efd657f0fb8 2x, https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=06d046d02600607f9e16e8c6f4e4de2f 3x"}, "duration": 8, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e4531a9f44e2d8420b78c71d80bcadbd", "srcset": "https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e4531a9f44e2d8420b78c71d80bcadbd, https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dab018e8a80655c6326388b030f5c9df 2x, https://si.imgix.net/7a0849cd/uploads/outputs/2964ba20-2b62-45ae-aa90-0fadd31cda41?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d10a440af33b83b54f7bfcd903ef04ac 3x"}, "body": "こんにちは！あなたの絵のスタイルがとても素敵なので、私のキャラクター「クモメ」を描いていただけないでしょうか。\nhttps://imgur.com/a/kumome-reference-I6BnwJG\n\nクモメには、クモや不気味な要素、歯車、そしてワイヤーをモチーフにしたデザインが随所に見られます。彼が精神的に崩れるときは、ワイヤーが切れる様子で表現されます。\n\n彼は機械やロボットが大好きです。弱いものに対して弱いところがあり、それが、人間ではなく哀れな存在である恋人にこれほどまでに執着する理由の一つでもあります。彼は、様々なスクリーンや配線で覆われた自分の研究室に住んでいます。そこはまるで蜘蛛の巣のようです。 クモメは非常に知的な青年だが、深い不安を抱えており、自分は何の価値もないと信じ込んでいる。それでも、ロボットである恋人を守り、修理することに自らの存在を捧げている。彼は深い不安を抱えた青年であり、恋人への執着によってかろうじて正気を保っている。 \n\nクモメはただ微笑んで黙って苦しむことを心がけているが、限界まで追い詰められるとキレてしまう。キレた時は、微笑みを浮かべたまま残酷な振る舞いをするか、あるいは耐えきれなくなると、穏やかで忍耐強い表情が崩れ、狂気じみた表情を浮かべる。\n\nクモメは感情の起伏が激しい男で、それを表に出さないよう必死に努力しているが、心の中は荒れ狂っている。その思考は、将来の実験やロボット工学に関するアイデアから、自殺願望による死への渇望まで多岐にわたる。彼は、恋人への執着心によって、自らの死についての考えから気をそらそうとしている。 \n\n\n必要であれば、彼の恋人の画像はこちらです https://imgur.com/a/denkai-Cd4vcl1\n\n彼について、お好きなように自由に創作してください！\n\nhttps://imgur.com/a/kumome-reference-I6BnwJG", "nc": 129,