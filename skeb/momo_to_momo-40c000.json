cfde391?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a3c1585609b56553e3b7615b1fe3034 3x"}, "body": "お久しぶりです。いかがお過ごしですか\n\nお誕生日前日という事で\nSkebで依頼を投げておきます。\n\n内容：裳本さん所のオリキャラ同士の\n衣装替えでお願いします。\n\n翔和君（ストライア君）＝初期の雑技団団長の格好\n天灯君＝通常衣装\n\nこの二人の衣装を交換してもらって、二人の間に\n”裳本さんの分身”のナカノヒト（桃色玉姿の鳥？）でお願いします。\nポーズや構図はご自由に。\n\n宜しくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@momo_to_momo/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c330c80a/uploads/origins/1569e846-ddfe-4bd5-a874-94a816ae6b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a2d10fa1ae4065d9ef2aaa595afd774", "srcset": "https://si.imgix.net/c330c80a/uploads/origins/1569e846-ddfe-4bd5-a874-94a816ae6b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a2d10fa1ae4065d9ef2aaa595afd774, https://si.imgix.net/c330c80a/uploads/origins/1569e846-ddfe-4bd5-a874-94a816ae6b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e8e2c65d88d4c182ce7e3f1c4deabc4 2x, https://si.imgix.net/c330c80a/uploads/origins/1569e846-ddfe-4bd5-a874-94a816ae6b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96af8c53a44a72312daf63f1957e2717 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 55967, "client_id": 55900, "nc": 178}, {"path": "/@momo_to_momo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 55967, "client_id": 83319, "vtt_url": null, "thumbnail_image_urls": {"