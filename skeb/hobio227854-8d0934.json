00&h=200&blur=200&s=c352c47b8c818d30ff3c9e5cb62ae1be 2x, https://si.imgix.net/cdcdc698/uploads/origins/0e4b3d7a-2418-42c8-baa9-0e5c9040ddbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38858e8e17519417ddc79021d5465f36 3x"}, "body": "はじめまして、ほびおさん。\n\nTwitterで拝見した綾華さんのイラストがとても魅力的で、ほびおさんの描かれる絵のファンになりました。\nつきましては、Skebにてイラストをリクエストさせていただきます。\n\nリクエスト内容としましては、「原神」の雲菫（Yun Jin）がフォンテーヌ（Fontaine）の優雅な街並みを歩く全身像をお願いしたいです。キャラクターを前景に、美しく描いていただけると嬉しいです。\n\n服装については、オリジナルの案で恐縮ですが、黒を基調としたエレガントなロングドレスを纏った姿を想像しています。例えば、滑らかなシルクやクレープのような生地で、片側のラインやネックラインに沿って、金色の糸で雲紋（雲の模様）や牡丹の花のようなモチーフが繊細に刺繍されているようなデザインはいかがでしょうか。上品で洗練された雰囲気が希望です。\nもちろん、これはあくまでインスピレーションとしての提案ですので、細部はほびおさんの素晴らしいセンスで自由にアレンジ、変更していただいて全く構いません。\n\n表情は穏やかで、フォンテーヌの雰囲気に合った洗練された佇まいだと嬉しいです。\n\nお忙しいところ大変恐縮ですが、このリクエストをご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\nhttps://drive.google.com/drive/folders/16YhvYp0E1n4OGL1wH2QKQnDYUQgNxKCm?usp=sharing\n\nhttps://drive.google.com/drive/folders/16YhvYp0E1n4OGL1wH2QKQnDYUQgNxKCm?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 6142, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "烏丸吾一", "screen_name": "karasu_25", "avatar_url": "https://pbs.twimg.com/profile_images/2052630759593406464/w8nU1fba.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1028965332533170176/1704528923/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 140462, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "右田歩", "screen_name": "akaironotanin", "avatar_url": "https://pbs.twimg.com/profile_images/2073702258131472385/u9LZjz4W.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2827813