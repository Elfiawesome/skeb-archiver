t=crop&crop=top&w=200&h=200&blur=200&s=bed70f82d56dd176fdfd8cfd6a09f308 2x, https://si.imgix.net/41898afb/uploads/origins/41bf36d8-0b90-497d-8c65-80204fbf29fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ade341d27ec8861d96c902343bc7573 3x"}, "body": "Hello! I would like to ask for an illustration of a JK-ized illustration that was previously drawn by another person, but this time in plain clothes. I will leave the color scheme, composition, etc. to you.\n\nOuter: military jacket\nInner: T-shirt (oversized)\nBottoms: Skinny pants\nShoes: boots\nAccessories1:Hat\nAccessories2:Bracelets\n\nThank you for your cooperation.\n\nhttps://drive.google.com/file/d/18eHJ9mHGjSqspH8JDT_Ru7y9V42O9znf/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sohin_3/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 33107, "client_id": 1446099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5d0004d57b9a46ecfad3b0572e58c3", "srcset": "https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb5d0004d57b9a46ecfad3b0572e58c3, https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=004774df5994033118d05909a47b430c 2x, https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=292ef274a5bfa110263d83478b354fca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95e1e46cbe6bcd4c9cc73f0721ebcd2b", "srcset": "https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95e1e46cbe6bcd4c9cc73f0721ebcd2b, https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=147300db8a1528ef9d3b32c8f61a3013 2x, https://si.imgix.net/31cf4129/uploads/origins/a27c22fd-3254-4054-b553-9b05b80bffd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf3d147cc2c1dbfb1828037c29dfd990 3x"}, "body": "はじめまして、こんにちは。\n\n素晴らしい画風ですね。お願いがあります！\n\n私のOCのアキコのイラストをお願いします。キツネ耳とキツネ尻尾のない人間でお願いします。鋭い歯は残してください！これは彼女の魔法の性質が隠されている人間の姿ですが、彼女の神秘的な金色の目と鋭い歯は残っています。\n\nカジュアルな服装です。明子には、チャーミングな大学生のような外見をしてほしい。性格はクールで魅惑的、危険な微笑みで一気に注目を集める。また、明子は背が高く、体格がよく、バストがあり、運動神経がいい。参考にした服装はお好きなように変更していただいて結構です。ポーズも自由です！\n\n参考文献: https://drive.google.com/drive/folders/1oZf7Xn-E7eseU_mLSwcy3EzvY8Xr4zj9\n\nご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1oZf7Xn-E7eseU_mLSwcy3EzvY8Xr4zj9", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sohin_3/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 33107, "client_id": 31308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/539b81d5/uploads/origins/b728fb58-3279-41f4-a05c-a58dde19d116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd91c8a60290e61616f12c356e8956ca", "srcset": "https://si.imgix.net/539b81d5/uploads/origins/b728fb58-3279-41f4-a05c-a58dde19d116?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd91c8a60290e61616f12c356e8956ca, https://si.imgix.net/539b81d5/uploads/origins/b728fb58-