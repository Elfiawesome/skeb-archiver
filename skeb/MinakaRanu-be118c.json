満の関係です。\n女の子は男の子のことを「唯一無二の大切な親友であり家族」のように思っています。\n一方、男の子は彼女に片思いしており、家族のように寄り添っています。\n\n■簡単な紹介\n二人は幼なじみで、現在は高校生です。\n女の子は何にでも興味を持ち、動物が大好きです。\n男の子はロックのCDを集めるのが趣味で、ギターも弾けます。\n普段の関係性としては、女の子が積極的に男の子を遊びに誘ったり、スキンシップを取ったりします。\n男の子は表向きは「面倒くさい」と言いつつも「君が楽しいならそれでいいよ」と応じ、少し子どもっぽい一面もあります。\n\n構図やシチュエーションなどは、基本的にお任せできれば嬉しいです。\nお読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1kL64tQfkaKjahpLUWj7h2nxBCXBa6GuH?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MinakaRanu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3624240, "client_id": 2988473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e2a27a4/uploads/origins/ed3b0052-c831-4ca7-9af0-a81944e70de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e138f645278950c9c41ad11d958e02a6", "srcset": "https://si.imgix.net/6e2a27a4/uploads/origins/ed3b0052-c831-4ca7-9af0-a81944e70de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e138f645278950c9c41ad11d958e02a6, https://si.imgix.net/6e2a27a4/uploads/origins/ed3b0052-c831-4ca7-9af0-a81944e70de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eadd9a336bdc98f4be00a4525f771bea 2x, https://si.imgix.net/6e2a27a4/uploads/origins/ed3b0052-c831-4ca7-9af0-a81944e70de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c8fc3b2049c6c87e5649d06be6eece19 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e2a27a4/uploads/origins/ed3b0052-c831-4ca7-9af0-a81944e70de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3218ea2537fb2f007bd8fb1c7d1e9359", "srcset": "https://si.imgix.net/6e2a27a4/uploads/origins/ed3b0052-c831-4ca7-9af0-a81944e70de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3218