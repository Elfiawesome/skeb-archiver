607?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a23119735e590fbfe08a369416c35609, https://si.imgix.net/947292c4/uploads/origins/1f8775d4-cad7-4c75-a056-910400d44607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e46273343ad6023cdb13b4df4715d35 2x, https://si.imgix.net/947292c4/uploads/origins/1f8775d4-cad7-4c75-a056-910400d44607?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e163700b2ad54f83998d9db89abe819 3x"}, "body": "またこんにちは。前回、私のために描いてくれた2つの作品、本当に素敵でした！ぜひまた描いていただけると嬉しいです。\n\nイノリを描くのに疲れてしまっていないといいのですが！もしスケジュールに合わない場合や、コンセプトが気に入らない場合は、遠慮なくお断りしてください。\n\nコンセプトは、様々なタイプのイノリでいっぱいの電車です。それぞれのデザインが、異なる音楽ジャンルを表しています。参考リンクにすべてのデザインが載っています。\n\n- グランジ\n- フルティガー・エアロ\n- バリスタ（バリスタが仕事中に耳にする、イライラするほど繰り返される音楽）\n- シティポップ\n- ファンタジー\n- EDM\n\n残りは自由です。デザインを調整したり、それぞれに異なる個性を与えたりしても構いません。どのような作品でも、きっと気に入ると思います。ただ一つお願いがあるのは、絵のどこかにiPodを描いてほしいということです。\n\nhttps://drive.google.com/drive/folders/1UsEwtQL4Sz8QBBI9jc12oGDo9sxIlLb_?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MinakaRanu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3624240, "client_id": 2795092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12f94162b3db6253e4138eef291335ed", "srcset": "https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12f94162b3db6253e4138eef291335ed, https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6792b8bc03e4d1440b33962680362ba 2x, https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae96431b2c053dd0f9e583451c5e58d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fe8b973d08a1f09cf4a02bb1db699aa", "srcset": "https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fe8b973d08a1f09cf4a02bb1db699aa, https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e430e2df3592560b6b581e623cd83aa 2x, https://si.imgix.net/b96351b8/uploads/origins/ebe854c0-8770-40d0-a30c-453a717a61f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c315dbf0accaa4503012b55e1521e64 3x"}, "body": "あなたの作品、本当に大好きです！もしお時間のある時に、私のオリジナルキャラクター（OC）のイラストを描いていただけませんか？\n \nキャラクター同士のやり取りが描かれた、複数のシーンを描いていただけたら、本当に嬉しいです。\n \nこちらに4つの世界観を用意しましたので、お好きなスタイルを選んで、自由に創作してください！\n\n \nキャラクターの設定や衣装の組み合わせは、ご自由に調整していただいて構いません。全く問題ありません！\n\nキャラクターと背景が別々のレイヤーになったPSDファイルで提供していただけますか？\n\nhttps://drive.google.com/drive/folders/17dF_KQil2kDbh7UdapvuWpDj1EQOWKTh", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MinakaRanu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3624240, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=276a267fdb9d405559d87ebd3bba1da9", "srcset": "https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=276a267fdb9d405559d87ebd3bba1da9, https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d131175803fbdd30fcd17292def668b8 2x, https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=911cc375b2664934dc718c9c54882520 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd97fa646cc6b99195188f33dfa652a0", "srcset": "https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd97fa646cc6b99195188f33dfa652a0, https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da144f3a2b121ef5fa86f08050d34845 2x, https://si.imgix.net/4d8010ab/uploads/origins/5701abd8-c9c1-4207-8001-3a0ae93eaf79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf05a51a980d94116f02336ba5bb3462 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！先生の作品における鮮やかな色彩と、キャラクター同士の深い感情や友愛に満ちた交流のあり方に、強く惹きつけられました！\nもしよろしければ、私のTRPGキャラクターを描いていただくことは可能でしょうか？\nフォルダ内にある S（ソレル／茶色の髪のキャラクター） を中心に描いていただけたら嬉しいです。\n\n描くキャラの組み合わせやパロ設定は先生のお好きなように選んでいただいて構いません。私は雑食なので（……）、キャラ同士の関係性が少しでも感じられれば嬉しいです！イラスト、漫画、新しいパロディの創作など、すべて先生のお好みにお任せいたします！\nあるいは、もしよろしければ、下記の作品のような形式で描いていただけたら嬉しいです。\nhttps://skeb.jp/@MinakaRanu/works/8\nhttps://skeb.jp/@MinakaRanu/works/6\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！お気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1G2yldDUusWRmjXtyBZvMCJr11FJAh5xc?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MinakaRanu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3624240, "client_id": 51161, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1ce283d01b3fa693d30011cc644942", "srcset": "https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af1ce283d01b3fa693d30011cc644942, https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d08984247abbc99e65f2f631e12c0e36 2x, https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bd527e70904a67eee4ed75b43891af2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97cd1448a8b895c327aab787fb152236", "srcset": "https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=97cd1448a8b895c327aab787fb152236, https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd52dad54f2a22bf8139de42b006bca 2x, https://si.imgix.net/981d40a6/uploads/origins/e32c7b7f-cd09-494e-9dff-7e3a44025d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7e5364d7f36d4ee94d3979496cd6f75 3x"}, "body": "こんにちは。私のキャラクター「キリナ」のイラストを依頼したいです。可能であれば、バナーとして使えるように横長の画像にしていただきたいです。設定としては、海辺に立っているか座っている姿で、夕日や夜間の雰囲気があれば嬉しいです。海を眺めながら、少し悲しげな表情を浮かべている様子で、そよ風が髪をなびかせているような感じだと理想的です。 画像は彩度をかなり抑え、モノクロに近い仕上がりにしてほしいです。全体的な雰囲気もメランコリックなものにしてください。それ以外はすべてお任せします。もし他の表現の方が良いと思われたら、自由に変更してください。ご依頼をご検討いただきありがとうございます。\n\nhttps://postimg.cc/gallery/BKTB9pC", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MinakaRanu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3624240, "client_id": 3943795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb32d72653309e7d1dc34b97b282c9d4", "srcset": "https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb32d72653309e7d1dc34b97b282c9d4, https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afc153ed3d30108850945af030a73e96 2x, https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69a714b194e2664b61961cacf99dab49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=614e0be88b8292bf99f9bee232f0b309", "srcset": "https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=614e0be88b8292bf99f9bee232f0b309, https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5096a07a2ed22c9043a4b51e2a9691a 2x, https://si.imgix.net/be93f09c/uploads/origins/4b215702-ea51-43b9-8a2a-871172f102c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=09b17dad18e22a6de9b2f6dae109640e 3x"}, "body": "先日描いてくれたグレースケールのイラスト、マジで超～クールだった！！ めっちゃめっちゃクール！！ 私のオリジナルキャラ、エディスにも似たようなのを描いてもらえないかな？\n\n彼女は25歳、身長167cmの猫娘で、宇宙海兵隊員としてエイリアンと戦っている。戦闘以外では明るく、ちょっと生意気で、チームメイトをからかうのが好きだけど、戦闘中は頼りになる相棒だ。\n\n可能であれば、歩きながらイヤホンに向かって文句を言っているようなシーン（笑）を描いていただけると嬉しいです。もし衣装がちょっと地味だと感じたら、何か追加していただいても大歓迎です！\n\n本当にありがとうございます！！\n\nhttps://drive.google.com/drive/folders/1KYYaILbhDKNaNKFMZZZyTlr4yXQeYskw?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MinakaRanu/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3624240, "client_id": 3416124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=520198f9a2ee44d6c0b4b6a59e4b1d04", "srcset": "https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=520198f9a2ee44d6c0b4b6a59e4b1d04, https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f9ffd3b64cae81757cef6142861d2a2 2x, https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4248ad7728d4da84b236cd38f10453f5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4620d7b1a4ff53f24b10bbc011b44a4c", "srcset": "https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4620d7b1a4ff53f24b10bbc011b44a4c, https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36e50be47636bc918e9c503aa6912cdd 2x, https://si.imgix.net/571bf704/uploads/origins/16a91134-3a29-44db-89b6-fc468cd687d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd78d0a6803087bc1a183426571d30a4 3x"}, "body": "こんにちは、つまらぬもの先生。\n前回描いていただいた作品、本当にありがとうございました。眼鏡を外すやり取りがとても可愛くて、まさに心に刺さりました！\nぜひもう一度、この二人のオリジナルキャラクターを描いていただきたく、ご連絡いたしました。もしご都合が合わない場合は、遠慮なくお断りください。\n\n■キャラクター設定\n明るく元気で活発ですが、少し体が弱い金髪の女の子と、控えめで内に熱いものを持つ優等生タイプの黒髪の男の子です。\n動物のモチーフはゴールデンレトリバーとボーダーコリーです。\n■関係性\n恋人未満の関係です。\n■紹介\n二人は幼なじみで。女の子は何にでも興味を持ち、動物が大好きです。男の子はロックのCDを集めるのが趣味で、ギターも弾けます。\n普段は、女の子が積極的に男の子を遊びに誘ったり、スキンシップを取ったりします。男の子は表向きは「面倒くさい」と言いながらも、「君が楽しいならそれでいいよ」と応じる、少し子どもっぽい一面もあります。\n■追加設定\n高校進学の際、女の子は体調を崩して海外で治療を受けることになり、その後回復して海外で大学まで進学します。髪を短くし、より外向的で魅力的な性格になります。\n一方その頃、男の子は両親を交通事故で亡くし、天涯孤独となります。一度は自殺を図るも未遂に終わり、その後は抑うつ傾向を抱えながら無気力に日々を過ごします。部屋を片付けている際に女の子からもらったギターを見つけ、それをきっかけに大学で再び音楽に打ち込み、ロックバンドのギタリストになります（女の子は以前からバンド活動を勧めていましたが、彼は反抗的すぎて親に反対されると思い、踏み出せずにいました）。その後、長髪にし、髪を染めています。\n大学時代の数年間で二人は連絡手段を失い、卒業後にようやく再会しますが、お互い大きく変わっており、物事はすでに昔のままではありません。男の子は心を閉ざし周囲を拒絶しますが、女の子は彼を悲しみから救おうとし、彼にとっての「浮き輪」のような存在になろうとします。\n■その他\n成長後の二人にはまだ正式な立ち絵がなく、イメージはキャラメーカーで再現したものになります。\n大人になった男の子はより女の子に依存するようになり、安心感に欠け、やや重く独占欲の強い一面があります。女の子はそんな彼を受け止め、まるで子猫をあやすように\n\nご一読いただき、ありがとうございます\n\nhttps://drive.google.com/drive/folders/1kL64tQf