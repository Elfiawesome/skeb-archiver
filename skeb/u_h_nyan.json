個人用でのグッズの印刷に使用を考えております。\n\n\n内容が長くなってしまい、すみませんでした。\nご多忙のところとは思いますが、何卒ご検討のほど、よろしくお願いします。\n\n\n以上です。\n羅綺紗イツ\n\nhttps://skeb.jp/@Raki_sya_1", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 125730, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🌼こゆい ゆたむ📛2/22 COMITIA155【Ｅ02b】", "screen_name": "koyui_tm", "avatar_url": "https://pbs.twimg.com/profile_images/1550476993548140546/cH7AV0bk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/827527173896491009/1760347967/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 176}, {"id": 1260480, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "メアリー┊︎コミティア155 R27b", "screen_name": "maryo0v0o", "avatar_url": "https://pbs.twimg.com/profile_images/1770094231132196864/xx51IUc1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/974233886401085441/1718602972/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "nc": 145}, {"id": 2053610, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "copi☕️お仕事受付停止中", "screen_name": "Fuji100923", "avatar_url": "https://pbs.twimg.com/profile_images/2023679259555041281/95kAC0lI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1526392541175656448/1771317719/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acc