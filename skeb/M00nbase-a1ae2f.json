ord_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@M00nbase/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3567808, "client_id": 3435604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1f6a761410f6e63443448c50becd1ef", "srcset": "https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1f6a761410f6e63443448c50becd1ef, https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b19e2d6d56e6a6195cb4f49e77a673f 2x, https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9a98100fb66a906965b5507c7ffc145 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11fdc717a5c8ceedbc18387387aa6061", "srcset": "https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11fdc717a5c8ceedbc18387387aa6061, https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a68419e1c18e46b51216ae38013c5876 2x, https://si.imgix.net/04902c01/uploads/origins/2a53bc29-9711-4c99-b32c-8362a77a59c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40b2d50a7f0ea300f61add946e89c48b 3x"}, "body": "翻译时出现了一些错误，所以我在这里直接提供修正后的中文文本：\n\n很高兴见到您，作者先生。\n您的插图给我留下了深刻的印象，我想与您联系，请您为我的原创角色创作一幅插图。\n\n这个角色有狼耳和狼尾，眼睛颜色带有渐变效果，尾巴的颜色越靠近末端越深。\n有关她的更多外貌细节（包括发型），请参考下面链接中的图片。\nhttps://imgur.com/a/NS0TbYe\n\n我们希望背景整体为深色调，明暗对比鲜明，风格类似于艺术家在 X 上发布的以下插图：\nhttps://x.com/M00nbase/status/1853969856514900187\nhttps://x.com/M00nbase/status/1903040759580037598\n\n此外，如果您能够结合角色的设定，在插图中加入令人联想到宇宙和星空的图案或背景元素，我们会非常高兴。\n\n构图和姿势方面将由您自由决定。\n\n提前感谢您的考虑。\n\nhttps://imgur.com/a/NS0TbYe", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 179744, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "てかとり", "screen_name": "tktk_tori", "avatar_url": "https://pbs.twimg.com/profile_images/1342822049786470401/gL0aZPui.png", "header_url": "https://pbs.twimg.com/profile_banners/1193107349134643200/1626785480/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "nc": 129}, {"id": 340340, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こしき", "screen_name": "cosiki_UAU", "avatar_url": "https://pbs.twimg.com/profile_images/1684931543209512960/BVSmpkEO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1673523474281955328/1690553970/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 144}, {"id": 1981232, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "電波障害", "screen_name": "denpawarukunai", "avatar_url": "https://pbs.twimg.com/profile_images/2056089987536621568/FpzHsoiw.jpg", "header_url": 