なたれ目。見透かすような目つき\n〇ベアトップのワンピース。薄く涼しげな布地\n〇はだし\n〇華奢\n中身のAIは37歳の男で、島で出会った自分の妻を再現した軽量化機体をサブ機として採用しています。\n航海士としての役割を果たす自立戦闘用人形なので、機体の重量は重要（わかる）なので妻になりました（わからない）\n構図や表情はお任せします。可憐ながらもうっすらとした違和感が漂う少女であれ。\n色は資料のカラーをスポイトしても自分でとっても大丈夫です！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kawazu_kr/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3658340, "client_id": 1626721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aec5c978/uploads/origins/f99a4209-b3b1-4601-83c0-7007bb6c312f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287dbf2408107ebaf13e8ce39e93388f", "srcset": "https://si.imgix.net/aec5c978/uploads/origins/f99a4209-b3b1-4601-83c0-7007bb6c312f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=287dbf2408107ebaf13e8ce39e93388f, https://si.imgix.net/aec5c978/uploads/origins/f99a4209-b3b1-4601-83c0-7007bb6c312f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64d9a90cc698f07db390246ba19398e6 2x, https://si.imgix.net/aec5c978/uploads/origins/f99a4209-b3b1-4601-83c0-7007bb6c312f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dec2bba5330ee9d04158ee12d8e57993 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aec5c978/uploads/origins/f99a4209-b3b1-4601-83c0-7007bb6c312f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efec1c63256154f407532f940aae1253", "srcset": "https://si.imgix.net/aec5c978/uploads/origins/f99a4209-b3b1-4601-83c0-7007bb6c312f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efec1c63256154f407532f940aae1253, https://si.imgix.net/aec5c978/uploads/origins/f99a4209-b3b1-4601-83c0-7007bb6c312f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200