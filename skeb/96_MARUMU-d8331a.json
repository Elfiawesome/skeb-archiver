200&s=29b5037b4ed69bb6fdad90a8ea52b38d 3x"}, "body": "世原🐟さんはじめまして！魔屡夢と申します。\nSkebであなたのポップな絵に惹かれ、リクエストに来ました。唐突のご依頼ですみません💦\n\n私のオリキャラのサスパー・テリィメアを、玉座を象る具現（本から出ている黒い肉塊のこと）に偉そうに座ってるポーズで描いて頂きたいです。\n\n【詳細】\n・サスパーは、悪夢や幻覚の実体化ができる夢魔という設定です。\n・背景はURLの「サスパー背景」という画像をご参照ください。\n・帽子の上の黒い王冠の形をした部分も入れて欲しいです。\n・本の有無はお任せします。\n・ファイル形式はpsdで、レイヤー分けを希望します。\n\nそれでは、素晴らしい作品をお待ちしております🍎\n\nhttps://drive.google.com/drive/folders/1Msn0hzDveX9F-jxp6_HF2Yj-2BAdsOGe", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tikara_e/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2089021, "client_id": 2980131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34293b05/uploads/origins/71813904-0c80-417a-a40a-607884db965c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad6abac08dadab08e9e581ea3c6bb6af", "srcset": "https://si.imgix.net/34293b05/uploads/origins/71813904-0c80-417a-a40a-607884db965c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad6abac08dadab08e9e581ea3c6bb6af, https://si.imgix.net/34293b05/uploads/origins/71813904-0c80-417a-a40a-607884db965c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a1f530df73a919705da06a6eca1ff45 2x, https://si.imgix.net/34293b05/uploads/origins/71813904-0c80-417a-a40a-607884db965c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca4d0ec64abe8549f9813ece35e4f49c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34293b05/uploads/origins/71813904-0c80-417a-a40a-607884db965c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02dbd62a567f13a1408062b57b8711ac", "srcset": "https://si.imgix.net/34293b05/uploads/origins/71813904-0c80-417a-a40a-607884db965c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu