dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=440d134b15ec4d91616d925b7da2fdb4 3x"}, "body": "こんにちは。素晴らしいイラストをお願いしたいのですが。\n描いていただきたいのは、『Luminous Witches』のリュドミラ・“ミラシャ”・ルスラノヴァです。https://worldwitches.fandom.com/wiki/Lyudmila_Andreyevna_Ruslanova\nミラシャを、汚れのないストームトルーパーの制服姿で描いてください。\nミラシャはアーマーを身に着けた状態で立っている姿で、ヘルメットは被っていない状態にしてください。\nミラシャには、煙を立てている（発砲直後の）ブラスターライフルを持たせてください。\nミラシャは（何度も）標的を外してしまい、がっかりした表情をしています。\n（注：ミラシャは射撃が本当に下手です。）\n構図は：ほぼ正面から。\n背景：ほぼ暗く。\nポーズや状況、その他の詳細は、お任せします。（テキストなし。）\n本当にありがとうございます！ 💕", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@junchan_nyan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1315465, "client_id": 3449157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a01155c/uploads/origins/ea609aaf-2694-45a9-9e23-402b487f20a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47ddb3b22fdb9585a5cbb633f61e0fb", "srcset": "https://si.imgix.net/2a01155c/uploads/origins/ea609aaf-2694-45a9-9e23-402b487f20a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47ddb3b22fdb9585a5cbb633f61e0fb, https://si.imgix.net/2a01155c/uploads/origins/ea609aaf-2694-45a9-9e23-402b487f20a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ffbbd325f46d4a44554b7e2bc6bb3fe 2x, https://si.imgix.net/2a01155c/uploads/origins/ea609aaf-2694-45a9-9e23-402b487f20a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d46410774cdcdc3e09c58ca52dc9621e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a01155c/uploads/origins/ea609aaf-2694-45a9-9e23-402b487f20a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccd7afea84cbfb3e5cfa193a581508da", "srcset": "https://si.imgix.net/2a01155c/uploads/origins/ea609aaf-2694-45a9-9e23-402b487f20a1?bg=%