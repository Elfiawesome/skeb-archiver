\n\nThank you for considering my request! Have a good day!\n\nReference images:\nhttps://drive.google.com/drive/folders/1njatXMZLD-SfZ3H4ebiMNRH79PdwamMb?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ws_it5/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3628047, "client_id": 3854662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea6e9cb2/uploads/origins/331a1fd5-2644-459d-b751-036db16216f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ed31996bbe860ed595c65f4b64cc689", "srcset": "https://si.imgix.net/ea6e9cb2/uploads/origins/331a1fd5-2644-459d-b751-036db16216f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ed31996bbe860ed595c65f4b64cc689, https://si.imgix.net/ea6e9cb2/uploads/origins/331a1fd5-2644-459d-b751-036db16216f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f23f4ca074e7e34d06925bd3c9fbbd4 2x, https://si.imgix.net/ea6e9cb2/uploads/origins/331a1fd5-2644-459d-b751-036db16216f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e3032de44f5f636c73e55d1e190fff3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea6e9cb2/uploads/origins/331a1fd5-2644-459d-b751-036db16216f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1048c04dd5d3366bd642139e11b5ac5d", "srcset": "https://si.imgix.net/ea6e9cb2/uploads/origins/331a1fd5-2644-459d-b751-036db16216f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1048c04dd5d3366bd642139e11b5ac5d, https://si.imgix.net/ea6e9cb2/uploads/origins/331a1fd5-2644-459d-b751-036db16216f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6ea950087994fb4ed8bc2f0311277a3 2x, https://si.imgix.net/ea6e