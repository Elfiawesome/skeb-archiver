9-9283-92e165850da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7efe58d6bc5cad8c6bc207ad10964127, https://si.imgix.net/20ffec6f/uploads/origins/044bd88a-d323-42c9-9283-92e165850da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c76a43a244d94e44648289d5b6d0e958 2x, https://si.imgix.net/20ffec6f/uploads/origins/044bd88a-d323-42c9-9283-92e165850da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7926bf19a7eb42ec2273be2fe7c1549 3x"}, "body": "こんにちは！あなたの作品を見て、すごく気に入りました！私のオリキャラを描いていただけないでしょうか。\n\nフィッシャー／ワシザ（52歳、192cm）\n愛想が良く、狡猾で、貪欲、そして愛情深い。彼はRPGのファンタジー世界の皇帝であり、自国の女神に仕えるという祝福と呪いを背負っている。彼は戦略家であり、将軍であり、チェスの名手であり、物語の結末を迎えるために死ぬ運命にある主人公の父親でもある。 死後、彼は運命から解放され、ソウルメイトと共に数え切れないほどの転生を重ね、共に新たな物語を探し求めていく。ゲームをしたり、物語を語ったり、新しい人々と出会ったりするのが大好きだ。\n\nモチーフ：鷲、カラス、将棋、象棋、戦略ゲーム、柳の木、太陽\n\n宮殿でのシーン、ゲームをしている様子、剣を抜く姿、あるいは桜の木の下でお茶を飲んでいる姿を描いていただけると嬉しいです。宮殿が炎に包まれる中での彼の死の場面も美しいと思います。お好きな伝統的な着物を着せていただいても構いません。どうぞ自由に描いてください！ご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1cfe37eMAxalHti6_6rtl7R-jBin0cIm_?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ws_it5/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3628047, "client_id": 3015400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d466078c/uploads/origins/398d01df-a522-48ae-84d4-f486a606adbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=419e99d376cb05f868b02758ea576faf", "srcset": "https://si.imgix.net/d466078c/uploads/origins/398d01df-a522-48ae-84d4-f486a606adbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=419e99d376cb05f868b02758ea576faf, https://si.imgix.net/d466078c/uploads/origins/398d01df-a522-48ae-84d4-f486a606adbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=131288bd837b6