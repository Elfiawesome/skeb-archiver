も嬉しいです\n(笑いあっていれば他は自由にしてもらって大丈夫です、泣き+笑いにしたっていいです)\n服装に至っては詳細や資料にない服装にしていただいても大丈夫です！\n何らかの不備があればキャンセルしてもらって構いません、長々と失礼しました\nご検討の程よろしくお願い致します🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1QhTGZLHJfL6xD2jIL_DcvsHRMXA0NQZt", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@i6gct3RDdW/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3979696, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b37e5c3/uploads/origins/45d97ef8-7dbf-49e7-aa29-86baa44e13f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a824c988b6bca88085b80ca389c9cad", "srcset": "https://si.imgix.net/4b37e5c3/uploads/origins/45d97ef8-7dbf-49e7-aa29-86baa44e13f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a824c988b6bca88085b80ca389c9cad, https://si.imgix.net/4b37e5c3/uploads/origins/45d97ef8-7dbf-49e7-aa29-86baa44e13f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dcbb9e550cfc91f556b86fe63383811 2x, https://si.imgix.net/4b37e5c3/uploads/origins/45d97ef8-7dbf-49e7-aa29-86baa44e13f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2471dc7428ac3ab658911b6b012dfd06 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b37e5c3/uploads/origins/45d97ef8-7dbf-49e7-aa29-86baa44e13f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a0cbf6bb738fb04676fe9ad87a9ded", "srcset": "https://si.imgix.net/4b37e5c3/uploads/origins/45d97ef8-7dbf-49e7-aa29-86baa44e13f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a0cbf6bb738fb04676fe9ad87a9ded, https://si.imgix.net/4b37e5c3/uploads/origins/45d97ef8-7dbf-49e7-aa29-86baa44e13f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ac5f940e6bbcd23b254b160de