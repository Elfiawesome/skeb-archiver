x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc47afc0/uploads/origins/874fde5d-98fd-4b2f-b4fb-d76846932370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05d2a0352aae6254f95e7b4f4a7544cd", "srcset": "https://si.imgix.net/cc47afc0/uploads/origins/874fde5d-98fd-4b2f-b4fb-d76846932370?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05d2a0352aae6254f95e7b4f4a7544cd, https://si.imgix.net/cc47afc0/uploads/origins/874fde5d-98fd-4b2f-b4fb-d76846932370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f410d40aa02974a8b97e3d055033acfe 2x, https://si.imgix.net/cc47afc0/uploads/origins/874fde5d-98fd-4b2f-b4fb-d76846932370?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7329ed8b5af30c12ad4ca8f06ae3ae2e 3x"}, "body": "はじめまして、旅鈴もぐと申します。\n素敵な背景を描かれる方だったのでリクエストいたします。\n以下内容ご検討のほど、よろしくお願いいたします。\n\n【使用範囲（※可能性あり）】\n・ﾂｲｯﾀｰやYouTube等各種SNSのﾍｯﾀﾞｰ、ｱｲｺﾝ、宣伝画像等への使用\n・YouTubeの動画、Twitch配信、サムネイル等への使用\n・収益化したアカウント等で使用\n\n※投稿の際はウォーターマークをつけさせていただきますが、こちらで加工等をしないほうがよろしければウォーターマークつきのデータもいただけると嬉しいです。\n\n\n\n【内容】\n・1枚絵\n・構図やシチュエーション等はお任せいたしますが、髪や装飾品に見切れがないようにいただけると嬉しいです！\n・PSD形式で人物と背景のレイヤーを分けていただけると助かります。\n\n\n【キャラクターについて】\n・詳細は添付ファイルをご確認ください\n・モチーフは、アリス、ダイナーです\n・Diner10/6のつまみ食い担当🍔\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1T0ky-kFZX4sRg6Bbrwd2tn4pYqSW3LMN?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gecko_takahe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3255310, "client_id": 3944892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a18279c/uploads/origins/d6fd7749-d027-46d7-90cb-e27ea206d40d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f73b82514d20b9cd4530749e41e760db", "srcset