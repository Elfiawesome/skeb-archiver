使い果たしたため、\nVtuberデビューを画策中\n\nhttps://drive.google.com/drive/folders/13NV-95--yBaovPxoP8ftrGchQdK0eYim", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 13987, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ブラニン", "screen_name": "buraninn", "avatar_url": "https://pbs.twimg.com/profile_images/1381521033379733504/EzJcJtjq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/525039013/1732346355/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2180837, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "tr", "screen_name": "LML_love_", "avatar_url": "https://pbs.twimg.com/profile_images/1538517419345735680/RhJURxuT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1535210128961830912/1681382142/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2479316, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "高宮 真", "screen_name": "makoto_t_illust", "avatar_url": "https://pbs.twimg.com/profile_images/2098867298065108992/GahrTkfG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1545434710863540224/1744917941/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": fa