d07e1/uploads/origins/92234af4-ef8f-4852-88ac-19fbd1ea4c7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=679aaf39cd46527114aa3a271929757c 3x"}, "body": "ウェディングピーチが触手に拘束されて段階的に衣装を破壊される18禁イラストの作成をお願いします。\n\n内容はPixivにアップされた「敗北！ウェディングピーチ！」とほぼ同じですが\n着せ替えとしても楽しみたいため基本全裸でその上に衣装、触手、体の傷を乗せる感じでお願いします。\n\nウェディングピーチ\n：上に書いた様に全裸(ハイヒールだけ履いた状態)で股間部分はスジでお願いします\n\n表情\n：怯えた表情、絶頂したアヘ顔、快楽に堕ちたトロ顔の3種類でお願いします。\n\n衣装\n：最初は無傷な状態から徐々に各所を破壊されて行く感じでお願いします。\n　又、レオタードの胸の部分は乳首が浮いた状態で股間は食い込んだ形でお願いします。\n\n触手\n：体を拘束する触手と股間を攻める電マの様な触手の2種類でお願いします。\n\nその他\n：絶頂で飛び散る愛液と母乳をお願いします。\n\nホームページにアップされた画像の衣装は胸部分が開けた服でしたが\n\n又、納品データはPSDファイルで線、色、影や光沢の効果等でレイヤーを分けてレイヤー未統合状態でお願いしたいです。\n\n以上リクエスト内容となります、ご確認の程宜しくお願いたします。\n\nhttps://www.dropbox.com/s/quql4h2mmriv8aq/%E5%8F%82%E8%80%83%E7%94%BB%E5%83%8F0920-1.zip?dl=0", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sodacider350/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1406887, "client_id": 437562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10a4b3ea/uploads/origins/62642aae-9d71-4b8b-a3d5-418a90842a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=027ad20557cfda34478601231fce9310", "srcset": "https://si.imgix.net/10a4b3ea/uploads/origins/62642aae-9d71-4b8b-a3d5-418a90842a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=027ad20557cfda34478601231fce9310, https://si.imgix.net/10a4b3ea/uploads/origins/62642aae-9d71-4b8b-a3d5-418a90842a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9284caf48af693deef28f00fc39f360 2x, https://si.imgix.net/10a4b3ea/uploads/origins/62642aae-9d71-4b8b-a3d5-418a90842a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=953d02883cf8fed5e9e0595deb0040b7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls