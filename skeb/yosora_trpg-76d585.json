=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4225653e9568a9cddfd9235d480cecfd 3x"}, "body": "こんにちは、\n友人のOC、ノアです。ノアは自信家で、ソーシャルメディアで多くのフォロワーを持つヒーローだ。生意気な態度をとることもありますが、謙虚になるべき時も心得ています。可能であれば、ヒーローのコスチュームをバイザーなしで着て、目が見えるようにしてもらえないでしょうか？\n私のリクエストに時間を割いていただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1NwzeI6heNg8Fn9ABCe1PF3Q-fih9l9tb", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yosora_trpg/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3247764, "client_id": 3305994, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39864a48/uploads/origins/c815ce37-7aa7-4c4a-8aa9-671661fbb572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70fbe7b886a57b5040dcd7840a7e0678", "srcset": "https://si.imgix.net/39864a48/uploads/origins/c815ce37-7aa7-4c4a-8aa9-671661fbb572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70fbe7b886a57b5040dcd7840a7e0678, https://si.imgix.net/39864a48/uploads/origins/c815ce37-7aa7-4c4a-8aa9-671661fbb572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c05801252f594ef202f558b32c11b020 2x, https://si.imgix.net/39864a48/uploads/origins/c815ce37-7aa7-4c4a-8aa9-671661fbb572?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4137846e5ca34509415b13a504d34e5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39864a48/uploads/origins/c815ce37-7aa7-4c4a-8aa9-671661fbb572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7d244f536748ad334db07adeea3261", "srcset": "https://si.imgix.net/39864a48/uploads/origins/c815ce37-7aa7-4c4a-8aa9-671661fbb572?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7d244f536748ad334db07adeea3261, https://si.imgix.net/39864a48/uploads/origins/