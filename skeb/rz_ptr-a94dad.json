/uploads/origins/6c5c5893-edea-4001-847f-acc73569060e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23aa5914d4f7bb0a9226b1d205216ca6, https://si.imgix.net/e61c9bf1/uploads/origins/6c5c5893-edea-4001-847f-acc73569060e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ffec53c897c793f9a8e0e5696b866697 2x, https://si.imgix.net/e61c9bf1/uploads/origins/6c5c5893-edea-4001-847f-acc73569060e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af0cd757137b9db54a11c70ba97fa843 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e61c9bf1/uploads/origins/6c5c5893-edea-4001-847f-acc73569060e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44e52e3c11c25de00228e179a345f88", "srcset": "https://si.imgix.net/e61c9bf1/uploads/origins/6c5c5893-edea-4001-847f-acc73569060e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44e52e3c11c25de00228e179a345f88, https://si.imgix.net/e61c9bf1/uploads/origins/6c5c5893-edea-4001-847f-acc73569060e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9b9257808bf0991fdefde76e2c857dd 2x, https://si.imgix.net/e61c9bf1/uploads/origins/6c5c5893-edea-4001-847f-acc73569060e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27ed93be757357f9724d2dfbf14850d4 3x"}, "body": "初めまして、もりーゆと申します。\nぜろ㌫様の丁寧で鮮やかなタッチとかっこいい絵柄に惹かれ、リクエストを送らせていただきました。\n\n【イラスト】\n一枚絵：構図やサイズ、表情などはお任せいたします。可能でしたら背景や小物など、イラスト内に椿の花を描いていただけますと嬉しいです。\n\n【キャラクター】\n当方のオリジナルキャラクターを描いていただきたいです。\nデザインの特徴：くすんだアイボリーっぽい髪色、緑の瞳をしています。色白の不健康そうな顔色をしており、目にも隈ができています。髪型は綺麗なストレート髪で、頭頂部に大きなアホ毛があるのが特徴です。\n設定：20歳の男性です。数年前に魔女が住んでいるとされている、森の奥深くにある屋敷に迷い込んでしまって以降、屋敷の執事として居候をさせてもらっています。とても卑屈な性格で、常に何かに怯えたような顔をしています。外に出ることを極端に嫌がり、常に陽の当たらない場所で過ごそうとする引きこもりです。読書や家事などの仕事をすることが好きです。強い希死念慮を抱えていたせいで、最後には自分の部屋で縄を括って自殺してしまいました。\n\n【使用用途】\n個人での観賞用に使用いたします。\n\n以上、長々と大変失礼いたしました。\nご一考のほど、よろしくお願い申し上げます。\n\nhttps://x.com/i/status/1727297544978616519", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amaunemu_X/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1869865, "client_id": 3746791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9d50c012a29c58ff4074579f479292a", "srcset": "https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9d50c012a29c58ff4074579f479292a, https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4bfe91290898951f1dac0e463ac5254 2x, https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2bb09d5fc85102c98aee396fb15a4697 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ef262c84e59e82488e00c08abfbaab4", "srcset": "https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ef262c84e59e82488e00c08abfbaab4, https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12b6ec46f376db1e5f2ebd2ec11153d0 2x, https://si.imgix.net/d9b0e91b/uploads/origins/0660f9bf-fcf0-40f8-8153-09e34da1d8b3