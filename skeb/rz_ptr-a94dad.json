\n・SNSのアイコン・ヘッダー等での使用(使用時は必ずIDを記載します)\n・個人用グッズの制作(自分用およびお相手の方用のみ。販売・配布はしません)\n・個人鑑賞\n上記の用途で使用したいと思っております。\n\n金額や条件など難しいようでしたらお手数をおかけしますが再送、もしくはキャンセルしていただければと思います。\nお忙しい中恐れ入りますが、ご検討のほどよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/vjoejukozfkv1q0o1pby9/ACtbDnJ1BNre3B8UxZ2K9Fs?rlkey=3n6kffi0uitgxvyuregxwfj34&st=sb0647as&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@u3g1n/works/270", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 444660, "client_id": 3746791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3cefbc5b/uploads/origins/ef8118d5-4b42-4fe7-aa1f-9c81777bce6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b9429df3619d2ec58a38bef7216b7b5", "srcset": "https://si.imgix.net/3cefbc5b/uploads/origins/ef8118d5-4b42-4fe7-aa1f-9c81777bce6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b9429df3619d2ec58a38bef7216b7b5, https://si.imgix.net/3cefbc5b/uploads/origins/ef8118d5-4b42-4fe7-aa1f-9c81777bce6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fad0fdf17cc086210b9ec0f4b828a93a 2x, https://si.imgix.net/3cefbc5b/uploads/origins/ef8118d5-4b42-4fe7-aa1f-9c81777bce6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dc17124a17c7e2e52d8c99bb23ef479 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3cefbc5b/uploads/origins/ef8118d5-4b42-4fe7-aa1f-9c81777bce6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=680487837d8d355865f31eb309e5f680", "srcset": "https://si.imgix.net/3cefbc5b/uploads/origins/ef8118d5-4b42-4fe7-aa1f-9c81777bce6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=680487837d8d355865f31eb309e5f680, https://si.imgix.net/3cefbc5b/uploads/origins/ef8118d5-4b4