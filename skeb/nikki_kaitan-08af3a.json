rop=top&w=200&h=200&s=4407d04d07f8cb66705169a075bdb63d, https://si.imgix.net/590e9e90/uploads/origins/93d4fb5e-dbcc-4d78-80ae-8da98f4c30dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6903ef0125f6b8b78352fc0c61b33023 2x, https://si.imgix.net/590e9e90/uploads/origins/93d4fb5e-dbcc-4d78-80ae-8da98f4c30dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf5f9015c82a39d930db18548da2b206 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/590e9e90/uploads/origins/93d4fb5e-dbcc-4d78-80ae-8da98f4c30dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac7d267169db6283a9e057dc0bad3e9", "srcset": "https://si.imgix.net/590e9e90/uploads/origins/93d4fb5e-dbcc-4d78-80ae-8da98f4c30dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac7d267169db6283a9e057dc0bad3e9, https://si.imgix.net/590e9e90/uploads/origins/93d4fb5e-dbcc-4d78-80ae-8da98f4c30dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94fc928b5a98db99ff5ec888a1f9ab95 2x, https://si.imgix.net/590e9e90/uploads/origins/93d4fb5e-dbcc-4d78-80ae-8da98f4c30dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03028f42bc48b50e1375e0abbc311a97 3x"}, "body": "こんにちは。私のキャラクターであるライチュウの依頼をまた受けたいのですが、今回の依頼では、見る人の顔を舐める舌に重点を置きたいと思います。\n\nこの依頼は、キャラクターが見る人に顔をたくさん舐めてくれるような、見る人の視点になりたいです。\n1コマ目は、キャラクターが視聴者の顔の近くにいて、大きく濡れた舌を垂らしているところを見せたい。\n2コマ目は、前の依頼の3コマ目と同じような舐め方をしたい。\n3コマ目 別の方向に舐める。\n4コマ目 上方向に大きく舐める。\n5フレーム目は、キャラクターの濡れた口の奥が見えるような、口元ショット。\n\nhttps://i.imgur.com/4hopVec.png", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikki_kaitan/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1229447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91e839a4aee10fdd5cb758e1aabc54bd", "srcset": "https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91e839a4aee10fdd5cb758e1aabc54bd, https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2d154b9ed124bfaed1b82cb1524005a 2x, https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe8321b22848b88e68ed873a71778983 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77517d8daf29d2a375eb233e58828156", "srcset": "https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77517d8daf29d2a375eb233e58828156, https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a73e16498b67f031eaf2749d686ec023 2x, https://si.imgix.net/7ea58f61/uploads/origins/62ff75b5-9651-4238-9a09-10ba62d8329e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aaeaf9896f91377e9016d41ea07013f6 3x"}, "body": "こんにちは、あなたの舌の描き方の詳細、特に鳳凰をフィーチャーしたものが気に入りました。\n\nライチュウとリッキトゥンのハイブリッドOCをフィーチャーする予定です。\nこの依頼は、様々な画像やコマの中で、飲み込まれる前に顔を舐められている、見る人の視点になりたいです。\n\nパネル1：ライチュウは鑑賞者の前に立ち、鑑賞者と距離を置いて、にやにやしながら鑑賞者を見る。\nパネル2：ライチュウは大きく、長く、濡れた舌を口から下へ伸ばし、地面についている。\nパネル3：ライチュウはその舌を見る人の顔まで伸ばし、見る人の顔が大きな濡れた舌で覆われるように、舌と唾液のビジョンだけでフレーム全体を占める。\nパネル4：見る者はライチュウの舌に包まれ、大きく開いた口にぶら下がっている。\n5コマ目：ライチュウの喉に飲み込まれる。\n\nhttps://i.imgur.com/4hopVec.png", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikki_kaitan/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1229447, "client_id": 743377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26ea50cc584e6ee5208d65e831ef34f2", "srcset": "https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26ea50cc584e6ee5208d65e831ef34f2, https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=894005946c351f18f2c986d3decf1bf0 2x, https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f9b837d8b8c19ce07f6c506dbdafd3e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58e22da80d28a9679a106ef0e794b075", "srcset": "https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58e22da80d28a9679a106ef0e794b075, https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9838a6d20ec4185630afd9a4bcc232df 2x, https://si.imgix.net/6ced2ec6/uploads/origins/0cff1044-518c-4dbd-91af-2a787f68870f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59344cdb6ab7cf14a796a2b5478594eb 3x"}, "body": "はじめまして！\nXの方でお腹の中のイラストがとても肉感が良くて気になっていました。\nお腹のおっきいドラゴンに丸呑みされて胃袋の中で気持ちよくなってイかされちゃううちの子のイラストをお願いしたいです。\nhttps://twitter.com/nikki_kaitan/status/1781659687924191441/photo/1\nこのイラストの様に柔らかい肉壁に包まれてるのがとても好きなのでこんな感じの断面図をぜひお願いしたいです。\n\nうちのこの注意点\n実物はラバースーツですがスーツっぽさ（ジッパーやエアバルブ、生地の貼り合わせの線など）は無しの　あくまでつるぷになケモノという感じでお願いします。\nよろしくお願いします。\n\n資料\nラバースーツなどふぇちなものを含む\nhttps://drive.google.com/drive/folders/1Q0KAqRufD393ssl5eOWQOzWzGHn0qPqn?usp=drive_link\n\n資料\nイラストのみ\nhttps://drive.google.com/drive/folders/1CjoG4CqR8-jx-mbKb6EWOLCiFmDS8fG1?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikki_kaitan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1229447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9544b9391993c2ba6a3a836c39755313", "srcset": "https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9544b9391993c2ba6a3a836c39755313, https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f86e31cdebe5b37cd63cfe3219572de 2x, https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d1d2b52a6d4498380aecb1d75bd49e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ad47214e194d04335a72f16e9e127f", "srcset": "https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70ad47214e194d04335a72f16e9e127f, https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bad32a718ae99a196ef6cc546fc26187 2x, https://si.imgix.net/ebcff9e7/uploads/origins/15d2f835-03d1-4245-b243-7161f6cbcfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=baa5b64f8f4d88f667ec6f2300352b01 3x"}, "body": "この他のリクエストとよく似たテーマのものをリクエストしたいのですが\n\nhttps://skeb.jp/@nikki_kaitan/works/7\n\nしかし、大きな支配的な女性「メガアンファロス」と従順な男性トレーナーで。 https://assets.pokemon.com/assets/cms2/img/pokedex/full/181_f2.png\n\n トレーナーは頭から子宮頸管を吸われ、足だけが出ている。メガアンファロスは正面に立って足を広げ、下を向いていたずらな笑みを浮かべながら、彼をしごき、性具のように使っている。彼女はお腹に電気を流して、彼を吸い込んでいるのかもしれません。\n\nその後、アンファロスがクンニして大量の液体を放出する間、彼は子宮の中に閉じ込められ、頭を絞られている。彼女のお腹からは電気の火花も出ています。\n\n最後に、彼は完全に入り込み、アンファロスは腹の中の新しい膨らみを見ながら微笑む。 (ここでは内観は必要ないでしょう)", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikki_kaitan/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1229447, "client_id": 831341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=447b45205d8c96caa4717ffda98a5e46", "srcset": "https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=447b45205d8c96caa4717ffda98a5e46, https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10a94f9bc740d074ad9901370d2bb4c6 2x, https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb42b4fa81ee082c94491ba636c85627 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3213d429752754f2f481fa101e2b861c", "srcset": "https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3213d429752754f2f481fa101e2b861c, https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1e0c3aa68234373a481fd5ea997842ec 2x, https://si.imgix.net/5bfeb8f3/uploads/origins/0bdac2e1-754a-42cd-a131-b79683a118fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1509ca975fa84325dbd595319a03fada 3x"}, "body": "ホウオウとうちの子ツリュウとリュナが舐めまわされて丸呑みされるイラストをお願いします！\n\n1枚目1コマ目:ホウオウの嘴から大きな長い舌がべろんっと伸ばされていて、それを見せつけられるツリュウ\n2コマ目:大きな舌に舐められて顔が埋まっているツリュウ\n3コマ目:大きな長い舌の上に乗せられて舐められてるツリュウ\n2枚目1コマ目:長い舌に巻き付かれて嫌そうにするツリュウ\n2コマ目:全身大きな長い舌に巻き付かれてはみ出た手と尻尾をバタつかせるツリュウ\n3コマ目:口の中に入れられて上を向いた嘴にはみ出た手と尻尾がスススッと引き込まれそうになりながら尻尾には舌が巻きついてじゅるんっとしている所\n3枚目1コマ目:呑み込まれ長い首の途中でもごもご蠢く膨らみと大きな長い舌を見せつけられるリュナ\n2コマ目:ホウオウが大きな嘴をぐぱぁっと開いて唾液まみれの大きな長い舌を出し伸ばす所\n3コマ目:寝かせられたリュナの体に大きな舌がべろーんと押し付けられる所\n4枚目1コマ目:ぺちゃぺちゃと大きな舌でリュナの顔を舐めまわす所\n2コマ目:唾液まみれになったリュナに大きな長い舌を巻き付けて嘴へと巻き取る所\n3コマ目:ごくんっとリュナを呑み込み、喉の途中でもごもご蠢く膨らみとお腹でもごもご蠢く膨らみを見つめて舌舐めずりをするホウオウ\n\n以上、4枚12コマでお願いします！", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nikki_kaitan/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1229447, "clie