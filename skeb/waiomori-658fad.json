ds/origins/64c570ea-d001-4ede-be1e-1d7f2d9306bf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7341f542f99e2dabdcbf507fa368dc4a 3x"}, "body": "お世話になっております！！\n\n先日の卓で遊んだロドス職員イメージのうちのOC、バッテリーくんとwaio先生のOC、ヘイティエくんのロドス内でのいち風景を見たいなと思い依頼します。\n\n用途としては壁紙にしてニコニコするのと、もし卓で遊んだメンバーの誰かがリプレイログを作成した場合そこに展示させて頂ければ嬉しく思います（もちろんクレジットは入れます）\n\nよければご検討ください\n\nhttps://x.com/ichiyoshi/status/1860756848749715561", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@waiomori/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2416071, "client_id": 2003983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c21d0ca66c8e6fd02969dd29f7921aa", "srcset": "https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c21d0ca66c8e6fd02969dd29f7921aa, https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b89717f30865f74e6a3d5f51e1d9afb 2x, https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50d7418f1cac55b31183a62be3e199db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a296ab861d55b937fc8154e787ac19", "srcset": "https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a296ab861d55b937fc8154e787ac19, https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9d221b33b656994238f7b2fd90bf8ca 2x, https://si.imgix.net/c2ff3ab3/uploads/origins/cbe48a9a-3dda-4d97-96f0-11c4e3b23091?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=add04171726b90939bcce14c5edf340d 3x"}, "body": "こんにちは、いつもX等にてwaioさんの美麗なイラストを拝見しており、ぜひこの機会にOCを描いていただきたく、今回リクエスト送らせていただきます。\n\n\n〜主要望〜\nオリジナルキャラクター「ルーセ」(資料URL参照)\nプロフィール : 150cm、14歳（♀）、黒髪に赤色の毛先グラデーション、黄色瞳、ネコ耳と人耳がある\n\nリプライ欄に別構図のものがあるので参考になれば幸いです。\n\n性格や趣向の詳細としましては、規律を重んじる、礼儀正しい、少し微笑むような表情筋、職務中はまったりているようでしっかり周囲を把握している、仲良しのネコには帽子を預けたりするほどの信頼がある、苦い飲食品が好き、フリルやリボンや植物が好き、などです。\n\n\n〜構図等 〜\nwaioさんの描かれるダイナミックな構図に毎度とっても目を奪われるので、可能であれば全身をお願いしたいです。\nキャラクターの装飾などの細部は描きやすいようにアレンジしたり省いていただいても大丈夫です。\nまた、仲良しのネコを添えていただけると大変嬉しいですが、構図的に難しいようであれば無視してくださいませ。\n背景の有無についてはwaioさんにお任せいたします。\n\n\nお忙しい場合や依頼文･金額に不備がありましたらキャンセル又は再送要請していただけると助かります。\nご検討よろしくお願いいたします。\n\nhttps://x.com/nabeoec/status/1903273520983089532?s=46", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@waiomori/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2416071, "client_id": 885214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a20873a1395916d5e7c28b3cdf05849", "srcset": "https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a20873a1395916d5e7c28b3cdf05849, https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b9cdba0fa0e5ff431510a92372235a4 2x, https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13cf7ab4586d7c2bc0801afa0eb0f63c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45d18c89f2da0de5e17f8e0d94a0fd9a", "srcset": "https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45d18c89f2da0de5e17f8e0d94a0fd9a, https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6227e1143c8c6185cb68bfb5aa8f47e2 2x, https://si.imgix.net/2c1746ee/uploads/origins/57f2ad9a-02e8-449b-8eb9-09f4798de7c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee6b9ac8043f629f7c3ca2e6ef019ff1 3x"}, "body": "こんにちは！\n私はあなたのアークナイツの作品が大好きで、今年初めの『棘』は私のお気に入りです！\n\nオリジナルキャラでよければ、私のOCのニーコを描いてほしいです！\n彼女はクレイジーな一面を持つ悪魔の軍人で、アークナイツのラップランドの性格にやや似ています。\n手に入る武器は何でも使う。剣、銃器、斧、チェーンソーなど何でもあり。\n\n彼女の描き方は自由にしてください！ポーズも構図も表情も自由です。あなたの作品はどれもとても印象的なので、どんなものでもきっと素晴らしいものになると思います！\n彼女の攻撃的なところとか、支配的なところとか、何でも結構です！\n\n帽子や衣装のパーツを外すのも自由です。参考文献に衣装の内訳があるので、そうしたい場合は参考にしてください。唯一注意したいのは、尻尾と角のディテールです。\n\nご配慮ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-VEiAVgDPT4NatADLJOgaM2Vx6669Jix?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@waiomori/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2416071, "client_id": 103872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c5bd973/uploads/origins/fd117f81-ae25-4ad0-9ab7-dec84ce4