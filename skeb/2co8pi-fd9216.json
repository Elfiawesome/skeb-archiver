合は fujimori mizu）\n・使用用途：noteでのサムネイルデザインや各種ヘッダー、名刺など広報デザインでの使用\n・ロゴイメージ：水のような流動的な印象\n\nまだ自身のモチーフロゴはないのですが、今後使用するモチーフは「羊のツノが生えた魚」を予定しています。\n（水、ナチュラル、オーガニック、クラシックなイメージです）\n\n黒or白一色をイメージしていますが、もしカラーの作字になる場合は、ロゴイメージに沿ったアースカラーだと嬉しいです。\nですが、これは私の素人考えですので、デザインに合わせてお好みで着色いただければと思います。\n\n以上、よろしければご検討いただけますと幸いです！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@2co8pi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3511226, "client_id": 2891782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fc0d8ad/uploads/origins/2394b9cd-7a1a-44e7-89aa-43aa1982cd1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb66e1b991a9fee046dc2c3c719937fc", "srcset": "https://si.imgix.net/8fc0d8ad/uploads/origins/2394b9cd-7a1a-44e7-89aa-43aa1982cd1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb66e1b991a9fee046dc2c3c719937fc, https://si.imgix.net/8fc0d8ad/uploads/origins/2394b9cd-7a1a-44e7-89aa-43aa1982cd1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a0686c15d33970bfbe1a01cd939cd5b 2x, https://si.imgix.net/8fc0d8ad/uploads/origins/2394b9cd-7a1a-44e7-89aa-43aa1982cd1b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6573541c949021d4827697ee381805fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fc0d8ad/uploads/origins/2394b9cd-7a1a-44e7-89aa-43aa1982cd1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=629671eb5e78d8ed03a80238647c0cc8", "srcset": "https://si.imgix.net/8fc0d8ad/uploads/origins/2394b9cd-7a1a-44e7-89aa-43aa1982cd1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=629671eb5e78d8ed03a80238647c0cc8, https://si.imgix.net/8fc0d8ad/uploads/origins/2394b9cd-7a1a-44e7-89aa-43aa1982cd1b?bg=%23fff