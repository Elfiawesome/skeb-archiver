ートをさせていただきたいと考えております。\n\nもしよろしければ、ご検討のほどよろしくお願いいたします…！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 7997, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "壱松ウロ⍤", "screen_name": "uro_odr", "avatar_url": "https://pbs.twimg.com/profile_images/1334381936874164225/As113tZd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/216473126/1537036776/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1290917, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うめまつ🐻春コミ3/20南４『ひ08ab』", "screen_name": "1sou_otkum", "avatar_url": "https://pbs.twimg.com/profile_images/1704689845585727488/WbUjKaTw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/788219811062947841/1719548804/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "voice"}, {"genre": "novel"}], "nc": 16}, {"id": 1758385, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "新保高", "screen_name": "shin_hotaka", "avatar_url": "https://pbs.twimg.com/profile_images/2049512622081585153/IjH0jfc-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1204413080622387205/1643637718/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id":