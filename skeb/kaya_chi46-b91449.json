at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06561276d235ffa3ae608cafd11c12a8", "srcset": "https://si.imgix.net/1d8546cf/uploads/origins/c648054d-6d9e-4f35-8826-f57737fc515f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06561276d235ffa3ae608cafd11c12a8, https://si.imgix.net/1d8546cf/uploads/origins/c648054d-6d9e-4f35-8826-f57737fc515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c79b448969ec494ae6edf6337c007548 2x, https://si.imgix.net/1d8546cf/uploads/origins/c648054d-6d9e-4f35-8826-f57737fc515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01263b7e6c132796add20eb082e8ade8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d8546cf/uploads/origins/c648054d-6d9e-4f35-8826-f57737fc515f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eca27fe7d8727c3eaa1680c92575eba1", "srcset": "https://si.imgix.net/1d8546cf/uploads/origins/c648054d-6d9e-4f35-8826-f57737fc515f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eca27fe7d8727c3eaa1680c92575eba1, https://si.imgix.net/1d8546cf/uploads/origins/c648054d-6d9e-4f35-8826-f57737fc515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32bac414557b9d9ee43a5ac6eee5e2c1 2x, https://si.imgix.net/1d8546cf/uploads/origins/c648054d-6d9e-4f35-8826-f57737fc515f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c8445e5dccb4451fc4d3092319782e 3x"}, "body": "黒電話とおる様\n\nだらだら妹系バーチャルYouTuberの「千城かや」(チシロ カヤ)と申します。\nとおるさんのご活動やイラスト、いつも楽しく見ております！\n\n今回は、私「千城かや」のハロウィン衣装をとおるさんに描いて頂きたいと思っております…！\n\n前提として、普段の少し幼い雰囲気の妹としての千城かやの姿ではなく\n大人（20代後半）のお姉さんな印象の千城かやを描いて頂きたいです。\n背丈も成長した姿（＋ヒール）に合わせて+10〜15cmほど、\n体型もメリハリのある姿に描いて頂きたいです。\n\n髪型は下ろした状態で、参考資料のような脇あたりまでの長さで\nゆるふわウェーブでお願い致します。\n表情は少し色気のあるジト目だととても嬉しいです…！\n\n衣装としては、露出を抑えたバニーガール衣装をお願いしたいです。\n胸元にレースをあしらったバニースーツにジャケットとカフス、\nバックシームの入った網タイツをお願いします…！\n衣装の参考資料を添付しておりますが、細かい所はとおるさんにお任せしたいです。\n\nまた、もし可能であれば以下の差分をお願いしたいです。\n1) ハロウィンとバニー姿の雰囲気に合ったフェイスメイクを施して欲しいです。 (お任せでお願いしたいです)\n2) ジャケットを脱いだ状態の差分を用意して頂きたいです。\n　 こちらもスーツ同様、細かい所はお任せしたいです。\n\n構図に関してはとおるさんにお任せいたします。\n\n今回のイラストの使用用途としまして、\nハロウィンのシチュエーションボイス動画(企画参加含む)に使用させて頂きたいと思っております。\nその為、16:9もしくは16:9に納めやすい構図だとありがたいです…！\n使用する際はTwitter・動画共にとおるさんのお名前とTwitterIDが分かるよう使用したいと思っております。\nイラストについては動画使用以外では基本とおるさんの投稿のRT・引用RTのみで行いたいと思ってます。\n\n以上、大変長くなってしまい申し訳ありませんが\nご都合がよろしければ何卒、よろしくお願い致します…！\n\nだらだら妹系バーチャルYouTuber\n千城かや\n\nhttps://drive.google.com/drive/folders/1W-S6q9X5aFfTJO9CoZjrmRtA_sutYmDC", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@torokan/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3664, "client_id": 289722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe009200/requests/200983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51c576af38577d8d556c6302f6855df", "srcset": "https://si.imgix.net/fe009200/requests/200983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51c576af38577d8d556c6302f6855df, https://si.imgix.net/fe009200/requests/200983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f465e38035f85bab8cc0d66170712d0 2x, https://si.imgix.net/fe009200/requests/200983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7313fdf0c5584b5ef583ca5a6fee1fe8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe009200/requests/200983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59dda5e5925dd7a20dd1dfdb6fa18e24", "srcset": "https://si.imgix.net/fe009200/requests/200983_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59dda5e5925dd7