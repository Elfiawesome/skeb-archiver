\u3067\u7d20\u6575\u306a\u30a4\u30e9\u30b9\u30c8\u3092\u62dd\u898b\u3057\u3066\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3089\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\uff01\n\u6cb3\u4e95\u69d8\u306e\u8272\u3065\u304b\u3044\u3068\u30c7\u30d5\u30a9\u30eb\u30e1\u611f\u304c\u3068\u3066\u3082\u597d\u307f\u3067\u3059\u3002\n\u53ef\u80fd\u3067\u3042\u308c\u3070OC2\u4eba\u3092\u63cf\u3044\u3066\u9802\u304d\u305f\u3044\u3067\u3059\uff01\n\n\u3010\u4f9d\u983c\u5185\u5bb9\u3011\nOC2\u4eba:\u5c11\u5973\u3068\u3061\u3073\u3063\u3053\u306e\u30a4\u30e9\u30b9\u30c8\u3002\n2\u4eba\u4e00\u7dd2\u3067\u3082\u5358\u4f53\u305a\u3064\u3067\u3082\u69cb\u3044\u307e\u305b\u3093\u3002\n2\u4eba\u4e00\u7dd2\u306e\u5834\u5408\u306f\u91d1\u9aea\u306e\u5c11\u5973\u306e\u65b9\u306b\u9ed2\u9aea\u306e\u3061\u3073\u3063\u3053\u304c\u304f\u3063\u3064\u3044\u3066\u3044\u308b\u3088\u3046\u306a\u96f0\u56f2\u6c17\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\n\u3010\u4f7f\u7528\u7528\u9014\u3011\n\u30fb\u500b\u4eba\u9451\u8cde\u3002\u30b9\u30de\u30db\u306e\u58c1\u7d19\u306b\u3057\u305f\u3044\u306e\u306716:9\u3067\u304a\u3055\u307e\u308a\u306e\u3088\u3044\u611f\u3058\u3060\u3068\u5b09\u3057\u3044\u3067\u3059\u3002\n\u30fb\u30b9\u30c6\u30c3\u30ab\u30fc\u3084\u30a2\u30af\u30b9\u30bf\u306a\u3069\u500b\u4eba\u4f7f\u7528\u306e\u307f\u306e\u30b0\u30c3\u30ba\u4f5c\u6210\u3002\n\u30fbSNS\u30a2\u30a4\u30b3\u30f3\u306a\u3069\u3067\u306e\u4f7f\u7528(ID\u306f\u8a18\u8f09\u81f4\u3057\u307e\u3059)\n\u30fb\u4ed6\u30af\u30ea\u30a8\u30a4\u30bf\u30fc\u69d8\u306b\u30a4\u30e9\u30b9\u30c8\u4f9d\u983c\u6642\u306e\u8cc7\u6599\n\n\u3010\u8a2d\u5b9a\u3011\n\u5143\u6c17\u306a\u5973\u306e\u5b50\u306e\u30b7\u30f3\u30c7\u30a3\u3068\u3001\u30b7\u30f3\u30c7\u30a3\u306e\u3053\u3068\u304c\u5927\u597d\u304d\u306a\u60aa\u3044\u795e\u69d8\u306e\u30aa\u30af\u30bf\u30f4\u30a3\u30a2\u306e2\u4eba\u3067\u3059\u3002\n\n\u25c6\u30b7\u30f3\u30c7\u30a3\u306b\u3064\u3044\u3066\n\u30fb\u6027\u5225:\u5973  \n\u30fb\u5e74\u9f62:17\u6b73\u3050\u3089\u3044\n\u30fb\u8eab\u9577:160cm\u53f0\u5f8c\u534a\uff0b\u30cf\u30a4\u30d2\u30fc\u30eb\n\u30fb\u9aea\u578b:\u6de1\u3044\u91d1\u9aea\u3002\u3075\u308f\u3063\u3068\u3057\u305f\u4e38\u3044\u30b7\u30eb\u30a8\u30c3\u30c8\u306e\u30b7\u30e7\u30fc\u30c8\u30dc\u30d6\u3002\n\u30fb\u9854:\u77b3\u306e\u8272\u306f\u6c34\u8272\u3067\u3071\u3063\u3061\u308a\u3057\u3066\u3084\u3084\u3064\u308a\u76ee\u6c17\u5473\u3002\u30a2\u30a4\u30e1\u30a4\u30af\u306f\u6fc3\u3044\u3081\u3002\u5de6\u306e\u76ee\u5c3b\u306b\u6ce3\u304d\u307c\u304f\u308d\u3002\u8868\u60c5\u306f\u8c4a\u304b\u3060\u304c\u3084\u3084\u30ad\u30c4\u304f\u3001\u8a71\u3057\u304b\u3051\u3065\u3089\u3044\u611f\u3058\u3002\n\u30fb\u88c5\u98fe\u54c1:\u53f3\u76ee\u306b\u30e2\u30ce\u30af\u30eb\u3002\n\u30fb\u670d\u88c5:\u30df\u30cb\u4e08\u306e\u30c9\u30ec\u30b9\u3002\u30d5\u30ea\u30d5\u30ea\u7cfb\u3067\u306f\u306a\u304f\u30dc\u30c7\u30a3\u30e9\u30a4\u30f3\u306e\u51fa\u308b\u3088\u3046\u306a\u5927\u4eba\u3063\u307d\u3044\u611f\u3058\u306e\u3082\u306e\u3002\u30ac\u30fc\u30bf\u30fc\u30d9\u30eb\u30c8\u306b\u9ed2\u7cfb\u306e\u30b9\u30c8\u30c3\u30ad\u30f3\u30b0\u3002\u722a\u5148\u7acb\u3061\u306b\u306a\u308b\u304f\u3089\u3044\u9ad8\u3044\u30cf\u30a4\u30d2\u30fc\u30eb\u3002\u5168\u4f53\u7684\u306a\u8272\u5473\u306f\u7d2b\u3068\u9ed2\u306b\u5c11\u3057\u6c34\u8272\u3002 \n\u30fb\u30e2\u30c1\u30fc\u30d5:\u30a2\u30aa\u30b9\u30b8\u30a2\u30b2\u30cf\u3001\u30af\u30ec\u30de\u30c1\u30b9\n\u30fb\u6027\u683c:\u660e\u308b\u304f\u3066\u59c9\u5fa1\u808c\u3002\u6d3e\u624b\u597d\u304d\u3002\u73fe\u4ee3\u306b\u3044\u305f\u3089\u30ae\u30e3\u30eb\u3002\n\u30fb\u305d\u306e\u4ed6: \u30aa\u30af\u30bf\u30f4\u30a3\u30a2\u306e\u3053\u3068\u3092\u5bb6\u65cf\u3068\u3057\u3066\u6eba\u611b\u3057\u3066\u3044\u308b\u304c\u3002\u5468\u308a\u304b\u3089\u898b\u308b\u3068\u98fc\u3044\u4e3b\u3068\u3067\u304b\u3081\u306e\u30da\u30c3\u30c8\u307f\u305f\u3044\u306a\u96f0\u56f2\u6c17\u3068\u6271\u3044\u3002\n\n\u25c6\u30aa\u30af\u30bf\u30f4\u30a3\u30a2\u306b\u3064\u3044\u3066\n\u30fb\u5b50\u3069\u3082\u306e\u6028\u5ff5\u304c\u96c6\u307e\u3063\u3066\u3067\u304d\u305f\u60aa\u3044\u795e\u69d8\u3002\n\u30fb\u6027\u5225:\u306a\u3057\u3002\u4eca\u306f\u7537\u3002 \n\u30fb\u5916\u898b\u5e74\u9f62:9\u6b73\u304f\u3089\u3044\u3002\n\u30fb\u8eab\u9577:130cm\u304f\u3089\u3044\u3002\u5c0f\u67c4\u3067\u30b7\u30f3\u30c7\u30a3\u3088\u308a\u982d\u3072\u3068\u3064\u5206\u4ee5\u4e0a\u5c0f\u3055\u3044\u611f\u3058\u3002\n\u30fb\u9aea:\u9577\u3044\u9ed2\u9aea\u3067\u524d\u9aea\u3082\u9577\u3081\u3002\u982d\u306b\uff12\u672c\u306e\u89d2\u304c\u3042\u308b\u3002\n\u30fb\u9854:\u77b3\u306e\u8272\u306f\u91d1\u8272\u3002\u722c\u866b\u985e\u306e\u3088\u3046\u306a\u7e26\u77b3\u5b54\u3067\u30b8\u30c8\u76ee\u3063\u307d\u3044\u611f\u3058\u3002\u7121\u8868\u60c5\u3002 \n\u30fb\u670d\u88c5:\u9ed2or\u8d64\u30d9\u30fc\u30b9\u306b\u91d1\u306e\u8272\u5473\u3002\u82b1\u9b41\u306e\u3088\u3046\u306a\u524d\u3067\u5e2f\u3092\u7d50\u3076\u548c\u98a8\u306e\u8863\u88c5\u3002\u9774\u306f\u7279\u306b\u6c7a\u3081\u3066\u306a\u3044\u306e\u3067\u304a\u4efb\u305b\u3067\u3059\u3002\n\u30fb\u88c5\u98fe\u54c1:\u53f3\u76ee\u306b\u773c\u5e2f\u3002\u533b\u7642\u7528\u3067\u3082\u306a\u3093\u3067\u3082\u53ef\u3002\n\u30fb\u30e2\u30c1\u30fc\u30d5:\u9ed2\u3044\u91d1\u9b5a\u3001\u8d64\u3044\u693f\u3001\u5e7d\u970a\u3001\u304a\u3070\u3051\u3001\u30aa\u30da\u30e9\u5ea7\u306e\u602a\u4eba\n\u30fb\u6027\u683c:\u5e7c\u304f\u5b50\u4f9b\u3063\u307d\u3044\u3002\u611f\u60c5\u3092\u8868\u306b\u51fa\u3055\u306a\u3044\u304c\u672c\u5fc3\u306f\u5ac9\u59ac\u6df1\u304f\u6211\u5118\u3002\n\u30fb\u305d\u306e\u4ed6:\u5927\u4eba\u306e\u59ff\u306b\u3082\u306a\u308c\u308b\u304c\u3001\u5927\u4eba\u6642\u3068\u5b50\u3069\u3082\u6642\u306e\u670d\u88c5\u306f\u540c\u3058\u3002\u30b7\u30f3\u30c7\u30a3\u3092\u76f2\u76ee\u7684\u306b\u6155\u3044\u306a\u3093\u3067\u3082\u8a00\u3046\u3053\u3068\u3092\u805e\u304f\u6240\u8b02\u30e4\u30f3\u30c7\u30ec\u3002\n\n\u30b7\u30f3\u30c7\u30a3\u306b\u3064\u3044\u3066\u306f\u8272\u3005\u306a\u8863\u88c5\u3092\u898b\u3066\u307f\u305f\u3044\u306e\u3067\u6cb3\u4e95\u69d8\u306e\u81ea\u7531\u306b\u63cf\u3044\u3066\u3044\u305f\u3060\u3051\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u304c\u3001\u8cc7\u6599\u753b\u50cf\u8863\u88c5\u305d\u306e\u307e\u307e\u3067\u3082\u3082\u3061\u308d\u3093\u5927\u6b53\u8fce\u3067\u3059\uff01\n\n\u3010\u8cc7\u6599\u753b\u50cf\u306b\u3064\u3044\u3066\u3011\n\u5168\u4f53\u306e\u96f0\u56f2\u6c17\u306f\u8cc7\u6599\u753b\u50cf(2\u4eba\u5206\u307e\u3068\u3081\u3066\u5165\u3063\u3066\u3044\u307e\u3059)\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002 \n\u30fb\u30a2\u30a4\u30b3\u30f3\u4f5c\u6210\u30b5\u30a4\u30c8\u69d8\u306b\u3066\u4f5c\u6210\u3057\u305f\u753b\u50cf\u304c\u542b\u307e\u308c\u307e\u3059\u304c\u3001\u30a4\u30e9\u30b9\u30c8\u4f9d\u983c\u3067\u306e\u4f7f\u7528\u306f\u554f\u984c\u306a\u3044\u65e8\u3092\u898f\u7d04\u3067\u78ba\u8a8d\u6e08\u307f\u3067\u3059\u3002  \n\u30fb\u7c97\u3044\u3067\u3059\u304c\u30b0\u30e9\u30b9\u30a2\u30a4\u306e\u30c9\u30fc\u30eb\u753b\u50cf\u304c\u3042\u308a\u307e\u3059\u306e\u3067\u3001\u82e6\u624b\u3067\u3057\u305f\u3089\u3054\u6ce8\u610f\u304f\u3060\u3055\u3044\u3002\n\u307e\u305f\u3001\u30c9\u30fc\u30eb\u753b\u50cf\u306f\u76ee\u306e\u8272\u306a\u3069OC\u306e\u8a2d\u5b9a\u3068\u9055\u3046\u90e8\u5206\u304c\u3042\u308a\u307e\u3059\u3002\n\n \n\u5168\u4f53\u306e\u96f0\u56f2\u6c17\u304c\u4f1d\u308f\u308c\u30702\u4eba\u3068\u3082\u670d\u88c5\u3084\u9aea\u578b\u7b49\u306f\u6cb3\u4e95\u69d8\u306e\u63cf\u304d\u3084\u3059\u3044\u3088\u3046\u81ea\u7531\u306b\u30a2\u30ec\u30f3\u30b8\u3044\u305f\u3060\u3044\u3066\u69cb\u3044\u307e\u305b\u3093\u3002\n\u53ef\u80fd\u3067\u3042\u308c\u3070\u4eba\u7269\u90e8\u5206\u306e\u307f\u306e\u30c7\u30fc\u30bf\u304c\u3042\u308b\u3068\u5b09\u3057\u3044\u3067\u3059\u3002  \n\n\u91d1\u984d\u4e0d\u8db3\u3084\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u542b\u3081\u5185\u5bb9\u306b\u4e0d\u90fd\u5408\u306a\u90e8\u5206\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u9060\u61