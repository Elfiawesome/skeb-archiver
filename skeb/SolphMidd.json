s/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3293781, "client_id": 3165053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fd5165e/uploads/origins/d58848f0-fab2-4915-bdea-e8baeb07948e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c8a9b151ac4f489f7d0d116993571d6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fd5165e/uploads/origins/d58848f0-fab2-4915-bdea-e8baeb07948e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c93ef5df18405837e7b2c0d58907d84", "src_set": ""}, "body": "またまたこんにちは！\nちょっとしたシークエンスのアイデアがあるんだ。\n\nフォアードくんがイルカの手下によってキング・クロリンに連れて行かれ、パニックに陥り、もがくが抜け出せず、キング・クロリンの背中のジッパーが開けられるが、彼の中には本物の体はない！\nフォアードくんは疲れ果てて抵抗することもできず、奇妙に空っぽなキング・クロリンのスーツの中に入れられてしまう。\n\nファスナーを閉め直すと、キング・クロリンは嬉しそうにため息をつき、完璧にフィットした体を取り戻し、フォアード君の生命力で彼を支え、忠実な下僕たちに感謝する。\n\nフォアードくんは水着を着ており、連れ去られる前にプールで気軽に泳いでいたことがうかがえる。\n\nhttps://drive.google.com/file/d/1bKMjWn4stx_Ic3lYWtQHGo8RCgryBCIz/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SolphMidd/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/05fd46f4/uploads/origins/edd93f44-599d-43d4-a09c-fab69803e8c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d8795c46368a39a1b038d20c81e1a87c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3293781, "client_id": 51541, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@SolphMidd/works/7", "private_thumbnail_image_urls": null, "private": false, "ge