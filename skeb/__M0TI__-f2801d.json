いく予定です\nいつかマジカルミライのステージで自身の曲が使われることが目標です\n\n鏡もちさんの素敵なイラストでどうかお力を貸して頂けると幸いです\nもしご迷惑でなければアイコンは鏡もちさんに描いて頂いた旨をTwitterに記載させて頂きたいです\n\nご多忙の中でのリクエスト大変恐縮ですがご検討よろしくお願いします", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__M0TI__/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0cf6b7d/uploads/origins/35bb0711-5643-4599-90c1-6b5d359f5ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d53c9f6af38beeb0c7bdca095b8f95d", "srcset": "https://si.imgix.net/b0cf6b7d/uploads/origins/35bb0711-5643-4599-90c1-6b5d359f5ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d53c9f6af38beeb0c7bdca095b8f95d, https://si.imgix.net/b0cf6b7d/uploads/origins/35bb0711-5643-4599-90c1-6b5d359f5ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d0e5802de82b15d5bb2c96d706f64e5 2x, https://si.imgix.net/b0cf6b7d/uploads/origins/35bb0711-5643-4599-90c1-6b5d359f5ad2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d6f67b44bacdedee69c8e7df8202a6c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1143737, "client_id": 1782156, "nc": 1}, {"path": "/@__M0TI__/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8efa40ef/uploads/origins/dc742771-55c9-497a-bb2c-f66971dcc9eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9047c9707c72f141a9bf2c63dfb18a7e", "srcset": "https://si.imgix.net/8efa40ef/uploads/