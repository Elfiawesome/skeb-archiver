や髪の見えない方向(背中等)からのごく簡単なラフ画もあると嬉しいです\n迷ったらお好み・お得意なもの・マイキャラ等を当てはめて下さい\n背景はありでもなしでもOK\n\n宜しくご検討願います\n\nhttps://drive.google.com/file/d/1nwJ55U55jM8KS5ACtXndjRf7x9bagzGA/view?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1768193, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まゆ", "screen_name": "m_w_cat", "avatar_url": "https://pbs.twimg.com/profile_images/1748946461772165120/xEBIYN30.jpg", "header_url": "https://pbs.twimg.com/profile_banners/708122147659448320/1682215769/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2773283, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "窓拭き", "screen_name": "krei_ss_", "avatar_url": "https://pbs.twimg.com/profile_images/1991616267246321664/SkzxoBGs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1991605733805420544/1763672936/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2925287, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "猫背🐈", "screen_name": "mollusk222", "avatar_url": "https://pbs.twimg.com/profile_images/1943305511199297537/5YpMw7qc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1704701938259103744/1710731749/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expi