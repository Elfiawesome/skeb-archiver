\n\nイラストの構図\n真ん中に　「少年の声」4600pv突破感謝と「雪の妖精」もよろしくね　と縦書きの手書き文字で書いてほしいです。\nそして右側に雪代さんを左側に一藤君を立たせてほしいです！\n\nイラストは差分含めて4枚欲しく1枚は上に書いた応援メッセージ付きの物。もう1枚は真ん中に「雪の妖精」と書かれた物。真ん中に何も書いていない登場人物だけが描かれた物、最後に僕宛てのメッセージ付きをお願いします。\n長文で申し訳ないですがよろしくお願いします。\nこれからも創作活動応援しております！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@teikibin_bottle/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 494337, "client_id": 112335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b05227f/uploads/origins/ab1d156a-0779-4418-b2dd-4dfc44e36663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9221eff03308948768031e7a8644227", "srcset": "https://si.imgix.net/3b05227f/uploads/origins/ab1d156a-0779-4418-b2dd-4dfc44e36663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9221eff03308948768031e7a8644227, https://si.imgix.net/3b05227f/uploads/origins/ab1d156a-0779-4418-b2dd-4dfc44e36663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa5c82709a6c77e47650d6c34e8c8a5b 2x, https://si.imgix.net/3b05227f/uploads/origins/ab1d156a-0779-4418-b2dd-4dfc44e36663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4078bd5cdc72ec139eb3ffce98d8b17c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b05227f/uploads/origins/ab1d156a-0779-4418-b2dd-4dfc44e36663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d04401dbe92434b66a8f26ae5ec8c35a", "srcset": "https://si.imgix.net/3b05227f/uploads/origins/ab1d156a-0779-4418-b2dd-4dfc44e36663?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d04401dbe92434b66a8f26ae5ec8c35a, https://si.imgix.net/3b05227f/uploads/origins/ab1d156a-0779-4418-b2dd-4dfc44e36663?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro