クロでお願いできればと思います。お引き受けいただけるようでしたら、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1IukiT3v37IUtx6aufng7lAHVok2JQJMa/view?usp=sharing", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ojo3net/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f4043583/uploads/origins/b56f23f0-bafd-46ee-96e2-cff4b0d7de57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5963411f41fd6c744ca25aab36c08ebe", "srcset": "https://si.imgix.net/f4043583/uploads/origins/b56f23f0-bafd-46ee-96e2-cff4b0d7de57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5963411f41fd6c744ca25aab36c08ebe, https://si.imgix.net/f4043583/uploads/origins/b56f23f0-bafd-46ee-96e2-cff4b0d7de57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7adfca8311f5f1cb8b0b00dd8fc036ed 2x, https://si.imgix.net/f4043583/uploads/origins/b56f23f0-bafd-46ee-96e2-cff4b0d7de57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cb0333e143a5bbe7fc1dd9bc7b0cf0a1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1419574, "nc": 33}, {"path": "/@ojo3net/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1419574, "client_id": 64615, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f485d93e/uploads/origins/9d8915ec-a751-406e-8fec-a81a0dd982e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bcdfcea64acac3d8d1ac0607bf0731f", "srcset": "https://si.imgix.net/f485d93e/uploads/o