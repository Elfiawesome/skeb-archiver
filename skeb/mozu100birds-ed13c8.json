種族は元天使で、現在は背中に小さな翼が残っています。\n■デザイン詳細資料\nhttps://drive.google.com/drive/u/2/mobile/folders/1pbA-134zJxLeevBMI-C4acafTb5hTtY-?pli=1&sort=13&direction=a\n\n■使用用途\n・収益化済チャンネルでのサムネイル\n・「おはようVtuber」などのSNS広報活動\n\n構図や雰囲気につきましては、明菜先生が描きやすい形でお任せできれば幸いです。衣装や細部についても、先生の描きやすいようにアレンジしていただければ嬉しいです。\nリクエスト内容に問題がある場合はキャンセルを、金額に不備がある場合は再申請をお願いできますと助かります。\n\n改めてになりますが、私は明菜先生のイラストが本当に大好きです。これからのご活動も心より応援しております。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Living_deadroom/works/407", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 64235, "client_id": 2794974, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4a1b278/uploads/origins/34a08af1-0be4-4de8-9b4f-b5976f0ca974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab02a3a60ac82756b6abe9303c56d03", "srcset": "https://si.imgix.net/b4a1b278/uploads/origins/34a08af1-0be4-4de8-9b4f-b5976f0ca974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ab02a3a60ac82756b6abe9303c56d03, https://si.imgix.net/b4a1b278/uploads/origins/34a08af1-0be4-4de8-9b4f-b5976f0ca974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c0a6514e85921abdc9357166d53e862 2x, https://si.imgix.net/b4a1b278/uploads/origins/34a08af1-0be4-4de8-9b4f-b5976f0ca974?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=876a0d99b63ca272edb8dac2a6dd46b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4a1b278/uploads/origins/34a08af1-0be4-4de8-9b4f-b5976f0ca974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccdf67a29c80ca7487cef1befc39ac1f", "srcset": "https://si.imgix.net/b4a1b278/uploads/origins/34a08af1-0be4-4de8-9b4f-b5976f0ca974?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccdf67a29c80ca7487cef1befc39ac1