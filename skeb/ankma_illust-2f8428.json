&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1facb7c443e09bfe31981eb7e86613f1 3x"}, "body": "こんにちは！あなたの作品がとても気に入っています。写実的で複雑な画面が好きなので、ぜひイラストを依頼したいです！できるだけ精巧なシーンを描いていただけると嬉しいです～\nキャラクターは以下の通りです。設定はゴキブリの擬人化で、彼女のイラストを描いていただきたいです！ハンマーや斧などのアイテムを収集し、ゴキブリを飼育し、蝶の標本が好きという要素を、描画時の参考としてください！ご協力できることを楽しみにしております。ぜひお描きいただけますと幸いです🥺🥺！キャラクター参考:\nhttps://x.com/NhubaoT11351/status/1834841480323907755?s=20 https://x.com/NhubaoT11351/status/1834841536267534458?s=20服装は自由に選択して描いていただいて結構です\n\nhttps://x.com/NhubaoT11351/status/1834841480323907755?s=20", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ankma_illust/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3126371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f73325a6aa6771a00114564b6e0ad8", "srcset": "https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f73325a6aa6771a00114564b6e0ad8, https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=350881680ba7df9f0fa8c9e02fe0c868 2x, https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bc2e40c1ea8e21670d11b00a0300be4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05571362619879e63b9fd73bc1b2a4c5", "srcset": "https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05571362619879e63b9fd73bc1b2a4c5, https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=954a99400194f53f6398a567986a3b08 2x, https://si.imgix.net/b9033837/uploads/origins/5a6f9789-ee05-423a-9aff-732912ca6a04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f49def0d769367aa127d9343756b39d8 3x"}, "body": "はじめまして！\n\n描いていただきたいイラストについてですが、歌詞に基づいたアルバムカバー風の絵をお願いしたいです。\n\n歌詞はこちらです：\n\n\n白いドレスを着て\n波が寄せるのを見つめる\n今年最後の船が浮かび去る\n\n水平線の向こうに\n花びらを　ひとつひとつ数える\nひとひらひとひら、底に沈んで\n二度と見られぬまま\nあなたの涙も水に溶けて　いく\n\n今日のあなたはいつもより美しいと知って\n振り向くと足元に砂がつく\nその不快感が気分を　悪くさせる\nもしも、あなたが下駄を履いていたなら\n\n\nキャラクターは赤い髪を三つ編みにした若い女の子で、青い目をしており、白いドレスと赤い靴、麦わら帽子を身につけています。\n細かい指定はせず、歌詞から受ける雰囲気で自由に描いていただけると嬉しいです。\n先生のイラストが大好きなので、ぜひご自身の個性を活かしたスタイルで描いていただければ、素敵な作品になると思います。\n\nキャラクターの参考になるイラストはこちらです：\nhttps://drive.google.com/drive/folders/19BRgh4Q2eV75JOiZ-C-TEnZl-M_bpd2p\n\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ankma_illust/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3126371, "client_id": 1656598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ad9bda7/uploads/origins/3d8f14f0-6312-4e60-b2ec-8754984ff265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5952b038566d367d21be4c24044e5fd5", "srcset": "https://si.imgix.net/1ad9bda7/uploads/origins/3d8f14f0-6312-4e60-b2ec-8754984ff265?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5952b038566d367d21be4c24044e5fd5, https://si.imgix.net/1ad9bda7/uploads/origins/3d8f14f0-6312-4e60-b2ec-8754984ff265?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2aaf3be18e8ff37beb5f3390c1ce203d 2x, 