ンを与えてくれる素材がたくさんあります。私が求めている雰囲気は、Y2K的なもので、キュートで不気味な感じ！自由に創造してください！彼女の頭の上の2つの特徴的なカボチャと黄色い目はそのままにしてください。髪型やアクセサリーは自由に変更できます。髪色も自由ですが、オレンジは必須です！\n\n翻訳は大丈夫でしょうか？ありがとうございました！♡\n\nhttps://drive.google.com/drive/folders/1oa7TlbCUmfBqlTiJqqr6Uf-7UJ8BIVll?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LNM330/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3527036, "client_id": 154532, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10b9b3a7/uploads/origins/4e3be05d-9bb3-4e38-95ff-fc67826f20d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47790fa8a869af8db5d47f50e07106d5", "srcset": "https://si.imgix.net/10b9b3a7/uploads/origins/4e3be05d-9bb3-4e38-95ff-fc67826f20d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47790fa8a869af8db5d47f50e07106d5, https://si.imgix.net/10b9b3a7/uploads/origins/4e3be05d-9bb3-4e38-95ff-fc67826f20d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1923023c253b4313a8570959ac9ad183 2x, https://si.imgix.net/10b9b3a7/uploads/origins/4e3be05d-9bb3-4e38-95ff-fc67826f20d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34bee59580f1afe1771cd6bf89d02e66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10b9b3a7/uploads/origins/4e3be05d-9bb3-4e38-95ff-fc67826f20d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e14e2036740386d30a46d51b78d766a", "srcset": "https://si.imgix.net/10b9b3a7/uploads/origins/4e3be05d-9bb3-4e38-95ff-fc67826f20d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e14e2036740386d30a46d51b78d766a, https://si.imgix.net/10b9b3a7/uploads/origins/4e3be05d-9bb3-4e38-95ff-fc67826f20d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro