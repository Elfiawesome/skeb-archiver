見たいので描きやすい構図やシチュエーションでも大丈夫です！\n\n服装\nぐだ子:アニブロ(希望としては原作風にブラウスのボタンを省略してもらえると幸いです) or初期服\n\n静謐:第3臨\n\n透間様のキャプションがとても好きなので、何かしらのキャプションがあれば尚、嬉しいです。\n\nもし猿轡が妨げになるのなら片方は剥がれかけとかでも全然構いません。\n\n以上となります。ご一考の程、よろしくお願い致します。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tome_nngn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1222361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1af9130f/uploads/origins/369ffe4a-0a58-4151-96a0-83ae171969d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4ea53328f6aafdd9cdef75d4396108", "srcset": "https://si.imgix.net/1af9130f/uploads/origins/369ffe4a-0a58-4151-96a0-83ae171969d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4ea53328f6aafdd9cdef75d4396108, https://si.imgix.net/1af9130f/uploads/origins/369ffe4a-0a58-4151-96a0-83ae171969d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be90f235a5bc667ebd1ce73db82936f0 2x, https://si.imgix.net/1af9130f/uploads/origins/369ffe4a-0a58-4151-96a0-83ae171969d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7dd9abf967f4bab7107ccf0c24560d8a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1af9130f/uploads/origins/369ffe4a-0a58-4151-96a0-83ae171969d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aedf1e2af99b74badc5b46b4ee785413", "srcset": "https://si.imgix.net/1af9130f/uploads/origins/369ffe4a-0a58-4151-96a0-83ae171969d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aedf1e2af99b74badc5b46b4ee785413, https://si.imgix.net/1af9130f/uploads/origins/369ffe4a-0a58-4151-96a0-83ae171969d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fd8398aabe26c30a6774c8aeb594cde 2x,