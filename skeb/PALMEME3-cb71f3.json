雨や雲、太陽など天気や自然のモチーフがあると嬉しいです。\n服装などは特に決まっておりませんのでご自由に描いていただけますとありがたいです！資料内の物や、何も着せなくても大丈夫です。\n\n使用用途としては、個人観賞用に印刷、スマホ、PCの壁紙などに使用させていただきたいです。\n\n装飾も思うまま盛っていただけますと嬉しいです！！楽しんで描いていただけましたら幸いです。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wlCHOBDnEeqpqkvl6zgWAQXzL7TaYNbf?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PALMEME3/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0f561fd6/uploads/origins/ff1d53b3-7ad8-45ad-a8b7-e8309488a4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe5a1fe490e62a5ed4f74c0ad53c4e94", "srcset": "https://si.imgix.net/0f561fd6/uploads/origins/ff1d53b3-7ad8-45ad-a8b7-e8309488a4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fe5a1fe490e62a5ed4f74c0ad53c4e94, https://si.imgix.net/0f561fd6/uploads/origins/ff1d53b3-7ad8-45ad-a8b7-e8309488a4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=203175c56e3aff698a188bfdb746a258 2x, https://si.imgix.net/0f561fd6/uploads/origins/ff1d53b3-7ad8-45ad-a8b7-e8309488a4a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f6f894ef77d13e288c95c5bc1ef27a80 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3293636, "nc": 1}, {"path": "/@PALMEME3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3293636, "client_id": 505031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3036744/uploads/origins/d171cbeb-0a1d-420d-a4ad-1155aa846