Gでプレイキャラクターとして使用しているキャラクターです。\n資料内にシナリオ名を記載しておりますが、依頼内容にシナリオのネタバレはありません。\n自身の使用しているキャラと相方のキャラの二人をお願いしたいです。\nキャラクターの詳細は資料をご参照下さい。\n\n二人は天使と悪魔ですが友達です。\n人間の姿と天使/悪魔の姿とありますが、どちらの姿で描いて頂いても構いません！\nPALMEMEさんの描きたいと思った姿で好きに描いて頂ければと思います！\n天使と悪魔でそれぞれ別のイラストでも、1枚のイラストに二人まとめて描いて頂いても嬉しいです！\nまた、PALMEMEさんのイラストが好きなので装飾はゴテゴテに盛っていただけると喜びます！\n\n受けて頂けるようでしたらよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/vi3xhvrrklpj9szg0l444/AO8v1UGj64WPOP_G_9IcOfk?rlkey=ny3m0z3jmfxqod4mm9vniwj42&st=kzh3wy7p&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PALMEME3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3293636, "client_id": 1405252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/877bc305/uploads/origins/717d9be6-0a17-4b7d-8935-96a91e864aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25377a72e2d6e9fc8fcb048342791988", "srcset": "https://si.imgix.net/877bc305/uploads/origins/717d9be6-0a17-4b7d-8935-96a91e864aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25377a72e2d6e9fc8fcb048342791988, https://si.imgix.net/877bc305/uploads/origins/717d9be6-0a17-4b7d-8935-96a91e864aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a2dc2e12c1e331e34337f9b1b16ed06 2x, https://si.imgix.net/877bc305/uploads/origins/717d9be6-0a17-4b7d-8935-96a91e864aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=018204e1c46540fc51661a0a2dcd6fe8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/877bc305/uploads/origins/717d9be6-0a17-4b7d-8935-96a91e864aeb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fea608dbd5c9cf3d536d7eb9ad134ba0", "srcset": "https://si.imgix.net/877bc305/uploads/origins/717d9be6-0a17-4b7d-8935-96a91e864aeb?bg=%23fff&auto=format%2Ccompress&f