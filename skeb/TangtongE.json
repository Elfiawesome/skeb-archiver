ipped": false, "creator_id": 2651272, "client_id": 3427806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=999f8b54bf0d329a95d13489e231e399", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/370f253e/uploads/origins/60aa8b2e-a893-49c7-b7d6-29fdf6ed7118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f2aaa08963adc444d50cfe3b38500a7", "src_set": ""}, "body": "いつもイラストの方楽しんで拝見しております。\n\n今回はMILGRAMのムウとハルカを依頼したくメッセージを送信いたしました。\n\n構図や形式などは担当医様に一任いたしますが、完成したイラストはX（Twitter）上でのみ、担当医様のID、お名前などを記載したうえで、是非アイコンとして使用させていただきたいです。（いわゆるペアアイコンといったものです）\n\nそれに伴い値段の上昇なども承りますので、何卒ご検討のほどよろしくお願いいたします。\n\nまた、こういった有償依頼をお願いするのは当方初めての身ですので、なにか失礼がございましたら大変申し訳ございません。\n\n以上になりますが、よろしくお願いいたします。ご返答お待ちしております。", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TangtongE/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/61387228/uploads/origins/5bb66aa6-3369-4c7b-81e7-a179dda8a64d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=69a60740e0def52e9fedb452e0d2fa63", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2651272, "client_id": 3400200, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@TangtongE/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b85fa51f/uploads/origins/4769a9b3-4689-4c74-9ce9-711b4e48cbed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bo