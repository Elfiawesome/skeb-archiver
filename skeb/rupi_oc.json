7/uploads/origins/3d39e15a-b692-4c86-b61a-76214641299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=919361fc5e2bb471b6be23c0005b465c, https://si.imgix.net/65be9917/uploads/origins/3d39e15a-b692-4c86-b61a-76214641299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27ab25e15feb0412a5f7bb44691c706f 2x, https://si.imgix.net/65be9917/uploads/origins/3d39e15a-b692-4c86-b61a-76214641299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9cdb7239cbd3c048d7b88e942380b80e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65be9917/uploads/origins/3d39e15a-b692-4c86-b61a-76214641299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ab0e265202e125461246f89f5fe7efc", "srcset": "https://si.imgix.net/65be9917/uploads/origins/3d39e15a-b692-4c86-b61a-76214641299f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ab0e265202e125461246f89f5fe7efc, https://si.imgix.net/65be9917/uploads/origins/3d39e15a-b692-4c86-b61a-76214641299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38d067ff2395db3f86d912de3047a22a 2x, https://si.imgix.net/65be9917/uploads/origins/3d39e15a-b692-4c86-b61a-76214641299f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f6a7efa98af6f704d8ebec0603ec4e7 3x"}, "body": "私のオリジナルキャラクターの全身立ち絵(全身でなくとも、デフォルメ化されていない絵)を、カラーで描いていただきたいです。\nビジュアルについては、資料URLをご確認いただきたいですが、下半身の服装については、例えばジーンズなど派手でない黒・灰色っぽいパンツスタイル、靴はスニーカーなどでお願いしたいです。\nまた、私の塗り方の都合で網線での塗りがある箇所がありますが、色を参考にしていただいて、ベタ塗りで大丈夫です。\n衣服の改変などは問題ないです。ちなみに、通常時に来ているのはジャンパーのような上着です。左袖にある単語は、袖の端に行くまで続けて書いていただきたいです。\nあくまで参考ですが、キャラの身長は180cm、体重は60kg、年齢は17〜8歳辺りです。\n\nhttps://drive.google.com/file/d/1_oa27OkuH1qR388Q9-DfHg9eQF7sWz2K/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": tru