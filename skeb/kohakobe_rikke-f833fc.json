df67b1-2a26-4362-b7ba-00800d078836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f588a7bc6e0b84c8514e905f3d6a510a", "srcset": "https://si.imgix.net/a704358b/uploads/origins/24df67b1-2a26-4362-b7ba-00800d078836?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f588a7bc6e0b84c8514e905f3d6a510a, https://si.imgix.net/a704358b/uploads/origins/24df67b1-2a26-4362-b7ba-00800d078836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aae7234530853a03512f96739af4d1e2 2x, https://si.imgix.net/a704358b/uploads/origins/24df67b1-2a26-4362-b7ba-00800d078836?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7af9b1145adc2c9f52e3cb4bbaca702f 3x"}, "body": "こはこべ様 こんにちは あなたの可愛さと無様エロがかけ合わさった作風に惹かれて依頼をしに参りました\n以下が依頼となります\n\n依頼内容\nキャラクター アークナイツからウィーディとリーフ(リーフはウィーディの隣にいるシードラゴン型のロボット、ウィーディの相棒)  https://imgur.com/a/nsQgEV8\nシチュエーション おジャマ化\n内容 どこかに行っていたリーフをウィーディが見つけるがリーフはおジャマ風の見た目になっていて光線銃を持っている ウィーディは「リーフ！？どうしたのその格好！？」と声をかけるが光線銃を照射 当たったウィーディは瞬時におジャマタイツを着て、射精する\n構図的に難しいようでありましたらリーフを省いても構いません\n\n以上の内容となります よろしければ上記の内容でお願いします", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohakobe_rikke/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3830436, "client_id": 199277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c1094e7bf057795e9e870fd656826d6", "srcset": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c1094e7bf057795e9e870fd656826d6, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a158fe601ad40aec7b4073cd1ff4d57 2x, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06716a77a8ed90a49423cc99509331cd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90edd99241e8ae4601aec2d1254b7966", "srcset": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90edd99241e8ae4601aec2d1254b7966, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd238cd03ab77bda01d29a65ad8283d0 2x, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9715616d828ea274a45ee90ab886bf21 3x"}, "body": "初めまして。もともと依頼しようか悩んでいたのですがアーミヤのイラストを見て依頼しようと決意しました。\n\n内容としてなのですが、アークナイツのゴールデングローのハイグレをお願いします。\nハイグレ光線に命中して大の字になって元の衣装が透けていき、ハイレグが見えていくようなシチュと\n蕩けた表情でゴールデングローがハイグレをするシチュをお願いします。\n\n衣装はピンク色のハイレグにロンググローブ、ニーソというこはこべさんの十八番であるマゾハイレグのような感じでお願いします。またｵﾁﾝﾁﾝはなしでお願いします。\n\n差し支えなければですが、pngではなく未統合のpsdで納品してくれるとありがたいです。\nよろしくお願いします。\n\nゴールデングローの資料\nhttps://imgur.com/a/ITT0Wzm\n\nシチュエーションの参考資料\nhttps://imgur.com/a/JUMwHKc\nhttps://imgur.com/a/DtljvMX", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohakobe_rikke/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3830436, "client_id": 3065326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab983711abc912caa30aaec57bd638c9", "srcset": "https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab983711abc912caa30aaec57bd638c9, https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84ed4d30823a9a811ab21d387e0b0fbc 2x, https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f1720c6101c1515af0ccbabb2579d25 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10c3aa6b051818e509be27781dd17ecb", "srcset": "https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10c3aa6b051818e509be27781dd17ecb, https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb3a08732e77243da30bcd8ab33cd317 2x, https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ca2fe639ef0b01a6ba4e4afc612d0f9 3x"}, "body": "こはこべ様はじめまして、照り焼き人と申します。\n\nこはこべ様のマゾハイレグイラストに惚れ惚れしまして、skebの依頼をさせていただきました。\n\n内容としましては\n作品：アークナイツ\nキャラクター：アーミヤ\nアーミヤキャラデザイン参考資料:https://imgur.com/a/XUZ6DcJ\n\n\nこはこべ様が描かれています【マゾハイレグ】になったアーミヤを書いていただきたいです。\n\n構図などについて、ガニ股になってふたなりチンポをシコシコして射精しているシチュエーションでお願いします。\n\nガニ股はガッツリとガバッと両足を開いたイメージでお願いします\n\nおチンチンと胸のサイズ、表情は以前描かれていましたこちらのイラストのようにお願いします(https://x.com/kohakobe_rikke/status/2066532017395867815?s=20)\n\n表情については上記のイラストのように、とろん…とした射精の快楽で惚けているような雰囲気を出してください\n\n衣装については絵チャで描かれていましたメルルのもののようにお願いします\n(https://x.com/kohakobe_rikke/status/2066898115656098091?s=20)\n(明るいピンク色のロンググローブ・タイツ・ハイレグ)\n(ハイレグは胸の部分を🩷型に切り抜いて勃起した乳首とぷっくりした乳輪が見えるようにして頂けると…！)\n\n射精描写について、射精した精液がマゾハイレグを突き破って噴水のように精液が飛び散っているような描写でお願い致します。\n\nその他、ムワッとした臭気の描写や擬音も盛り盛りにして頂けると嬉しいです。\n\n以上、よろしくお願いいたします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 4274, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ナオ", "screen_name": "nao_eg", "avatar_url": "https://pbs.twimg.com/profile_images/1667155742464557058/TMfiSlkh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/558790617/1686315804/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 104095, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "チワワの浩太＠うさむぎいぬもぐ", "screen_name": "geraurgos", "avatar_url": "https://pbs.twimg.com/profile_images/1863885470931042304/OYYqkEB4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3274715192/1770781932/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1120143, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さとみや🐈", "screen_name": "satomiya_yuru", "avatar_url": "https://pbs.twimg.com/profile_images/1675151437524008961/BJ5BZuKp.jpg", "header_url": "https://pb