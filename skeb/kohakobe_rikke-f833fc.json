igins/df444d3f-92cd-4e51-bf2b-12db427886f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3777b47bc88b933a013cd800841f8ddf", "srcset": "https://si.imgix.net/d6f9029e/uploads/origins/df444d3f-92cd-4e51-bf2b-12db427886f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3777b47bc88b933a013cd800841f8ddf, https://si.imgix.net/d6f9029e/uploads/origins/df444d3f-92cd-4e51-bf2b-12db427886f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7503b321966f73cfafef2811f58069d7 2x, https://si.imgix.net/d6f9029e/uploads/origins/df444d3f-92cd-4e51-bf2b-12db427886f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d0dc4e78a4bbed8364bedbd074430e3 3x"}, "body": "お世話になっております。\nまのさばより、ノアのふたなりイラストをお願いしたいです。\nkuromaruにより無理やりチンポロックされている設定でお願いしたいです。\n\n衣装ですが裸をベースに、kuromaru製の黒いラバーの長手袋とニーハイ、kuromaru製の首輪を装着させられていてほしいです。乳首には辱めとして、kuromaru製の、男性器を模した下品なアクセサリーがついたピアスをさせられていてほしいです。\nまた小さな身体に対して不釣り合いに肥大化したチンポロックkuromaruを、重そうに両手で抱えさせられていてほしいです。\n\nシチュエーションですが、処刑としてだんだんチンポロックを肥大化させられ、チンポロックの重量が増加し、痒み液を分泌されてしまうというものでお願いしたいです。\n下記のような流れでお願いいたします。\n1.チンポロックをガニ股で持ちながらではあるが、まだ反抗的で抗おうとしている\n2.チンポロックが肥大化+痒み液を分泌　少し悶えながら痒みと射精欲に耐えている\n3.さらにチンポロックが肥大化、スイカ大ほどの大きさになっており支えるので手一杯になりながら呻き声を出しつつ痒みに悶絶している\n4.kuromaruによって長手袋の手部分が球体となり、バンザイ拘束をさせられてしまう (参考シチュエーション:  https://www.pixiv.net/artworks/117152788#big_6 )\nチンポロックは更に肥大化するが手で支えることができないため、股間部にかなりの重さを感じつつぶらぶらさせるしかなくなり悶絶し、快楽と重さに耐えきれず許してと懇願してしまう\n\nよろしければ承認のほど、よろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohakobe_rikke/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3830436, "client_id": 100968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719c0c705667dcfd622a516276ab1a47", "srcset": "https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719c0c705667dcfd622a516276ab1a47, https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=012082ce5ffa5b064be5b56aa228a322 2x, https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76141da8d63c73bbd97829c377c3550f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42489a8e5bf0932262bb489c9b6f3c43", "srcset": "https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42489a8e5bf0932262bb489c9b6f3c43, https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=329e271f755f08c35d0da2ca2050429f 2x, https://si.imgix.net/e8524030/uploads/origins/786dac85-9c49-41e1-a770-4cb03b4f7bd4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=901ebb6fc2378637152789df8ab71af6 3x"}, "body": "初めて依頼させていただきます。\nまのさばのエマの青肌淫魔化シチュをお願いします。\n\n\n１：青肌淫魔となって性欲が暴走した橘シェリーによってペニスで後ろから犯される桜庭エマ。\n　エマは裸、後背位。\nシェリー「一緒に気持ちよくなりましょうよ～」\nエマ「いやっ！やめてっ！シェリーちゃん！痛いよぉ！」\n\n２：中に射精されるエマ。互いにアへ顔、エマの肌が青く染まっていく。\nシェリー「イクッ！」\nエマ「いやぁぁぁ！！」\n\n３：エマも青肌淫魔と化し互いに怪しく笑う。\nエマ「ハンナちゃんやメルルちゃんも仲間にしなくちゃ…」\nシェリー「みんなで一緒だと楽しそうですね！」\n\n\n淫魔の姿ですが目の強膜部分は白、瞳孔ないタイプの虚ろ目。\n胸も大きくなる感じでお願いします。\nシェリーとエマで青肌の色も少し違うような青でお願いします。\n\nセリフは付けましたがお好みで追加や削減、改変しても大丈夫です。\n\nよろしくお願いします！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohakobe_rikke/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3830436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c07a085b5cc36006a9aa4b89a3ec92", "srcset": "https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c07a085b5cc36006a9aa4b89a3ec92, https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e34e4267161425f4494c85538935285a 2x, https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d8ea58f05ef3011b0aedb8b3746d89e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50bc96f9fec171faf0ae37790bc35986", "srcset": "https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50bc96f9fec171faf0ae37790bc35986, https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=832bcc62822a408c2fb5118c040c2f08 2x, https://si.imgix.net/528b194e/uploads/origins/3510c3bb-78a9-4859-8ea9-2360284af7f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f43868f140703ca8bbb19757f6feebc6 3x"}, "body": "初めてのリクエスト失礼します。リミ解と申します。\n\nまのさばの宝生マーゴちゃんが、モブ男（禿頭で顔無し）を背後からうっとりした表情で乳首責め（爪でカリカリ）するイラストをリクエストさせていただきます。\n\n要望について\n・マーゴちゃんが乳首責めする際は、モブ男の耳元で「カリ…♡カリ…♡」と言葉責めする感じでお願いします。\n・乳首だけで射精してしまう差分（モブ男はビクビクし、出してる間マーゴちゃんは「ウフフ…♡」とだけ）も描いて頂けますと幸いです。\n・画角は正面・斜めどちらでも大丈夫です。\n\n何卒宜しくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohakobe_rikke/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2a4f2d1e/uploads/origins/bcfb13ed-062e-4337-99bd-25965911f00a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=219126b6578aa7d67e903940b3152d65", "srcset": "https://si.imgix.net/2a4f2d1e/uploads/origins/bcfb13ed-062e-4337-99bd-25965911f00a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=219126b6578aa7d67e903940b3152d65, https://si.imgix.net/2a4f2d1e/uploads/origins/bcfb13ed-062e-4337-99bd-25965911f00a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71f8a02f8f745f8dc030244aacb7c7c8 2x, https://si.imgix.net/2a4f2d1e/uploads/origins/bcfb13ed-062e-4337-99bd-25965911f00a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd5752f8b266e3b21fb62d5ddb467097 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3830436, "client_id": 3084080, "nc": 48}, {"path": "/@kohakobe_rikke/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3830436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14a8d775/uploads/origins/f2bd2578-4e2f-4082-bace-ac51