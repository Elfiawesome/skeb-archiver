フ！？どうしたのその格好！？」と声をかけるが光線銃を照射 当たったウィーディは瞬時におジャマタイツを着て、射精する\n構図的に難しいようでありましたらリーフを省いても構いません\n\n以上の内容となります よろしければ上記の内容でお願いします", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohakobe_rikke/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3830436, "client_id": 199277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c1094e7bf057795e9e870fd656826d6", "srcset": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c1094e7bf057795e9e870fd656826d6, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a158fe601ad40aec7b4073cd1ff4d57 2x, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06716a77a8ed90a49423cc99509331cd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90edd99241e8ae4601aec2d1254b7966", "srcset": "https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90edd99241e8ae4601aec2d1254b7966, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd238cd03ab77bda01d29a65ad8283d0 2x, https://si.imgix.net/90621d7b/uploads/origins/6776f81d-8d81-4207-8d6e-95e48b35c46a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9715616d828ea274a45ee90ab886bf21 3x"}, "body": "初めまして。もともと依頼しようか悩んでいたのですがアーミヤのイラストを見て依頼しようと決意しました。\n\n内容としてなのですが、アークナイツのゴールデングローのハイグレをお願いします。\nハイグレ光線に命中して大の字になって元の衣装が透けていき、ハイレグが見えていくようなシチュと\n蕩けた表情でゴールデングローがハイグレをするシチュをお願いします。\n\n衣装はピンク色のハイレグにロンググローブ、ニーソというこはこべさんの十八番であるマゾハイレグのような感じでお願いします。またｵﾁﾝﾁﾝはなしでお願いします。\n\n差し支えなければですが、pngではなく未統合のpsdで納品してくれるとありがたいです。\nよろしくお願いします。\n\nゴールデングローの資料\nhttps://imgur.com/a/ITT0Wzm\n\nシチュエーションの参考資料\nhttps://imgur.com/a/JUMwHKc\nhttps://imgur.com/a/DtljvMX", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohakobe_rikke/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3830436, "client_id": 3065326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab983711abc912caa30aaec57bd638c9", "srcset": "https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab983711abc912caa30aaec57bd638c9, https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84ed4d30823a9a811ab21d387e0b0fbc 2x, https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f1720c6101c1515af0ccbabb2579d25 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cec7a95/uploads/origins/f1123016-2c45-4b7a-b4c8-fdb18a2635f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10c3aa6b051818e509be27781dd17ecb", "srcset"