%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db3706b1633ba9c1129da257a72377ec, https://si.imgix.net/c0fc677e/uploads/origins/6c3ce7c4-1d04-4dbf-936b-bb0ab67378b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61f23af81353f4965ba5a8c22367dbb8 2x, https://si.imgix.net/c0fc677e/uploads/origins/6c3ce7c4-1d04-4dbf-936b-bb0ab67378b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d76b941b6a003754f08068dca29217ca 3x"}, "body": "初めまして！絵柄がとても可愛くていつもあられメーカーを使わせて頂いてます✨\nSNS用アイコンと透過画像を依頼したいです。\n\n〈希望の容姿〉\n･好きな色は白やグレー、差し色やポイントに淡いブルーなど\n･黒髪ウェーブロングにブルーバイオレットのインナーカラー\n･前髪あり\n･目は資料(あられメーカー)のような、ぱっちり二重と青みがかった瞳\n･左目下にほくろ\n･肌は白めで、表情は微笑んでいる\n･ピアスあり(シンプルなもので◎)\n･長毛の白猫を抱いている\n･服装はセーターやニットカーディガンなど\n･ネイルはくすみブルー\n･参考に程度に、雰囲気は資料(あられメーカー)のような感じ\n･その他、ポーズやヘアアクセの希望は特にありませんのでおまかせします…！\n\n\n〈資料〉\nhttps://x.com/_yu76__/status/1725694209284620550?s=46\n資料はあられメーカーで作らせていただいたものと飼っている愛猫の写真です。\n\n参考に写真の子の猫種はサイベリアンですが、描いていただく子は野良とは違う少し毛の長い子だと分かればそれで大丈夫です。\nこの子は模様がありますが、模様なしの白猫で構いません。\n\n細かくなってしまいましたが、とても楽しみにしております！\nよろしくお願いいたします！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arl_mk/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1183363, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=183d16e94958dda9437dd7119aa707a9", "srcset": "https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=183d16e94958dda9437dd7119aa707a9, https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb525cb7f2f0ef4f49dda658112bbfa6 2x, https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad1324b98366f2b085cf3624a0e5cea4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=279952f619bce4ef89a61ffff94d8e29", "srcset": "https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=279952f619bce4ef89a61ffff94d8e29, https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3177177f1ef1c6c5946df9928827fde 2x, https://si.imgix.net/2fc9f1ba/uploads/origins/c93d8057-b646-4312-bbb5-df7111c51b70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd49b4bec4f2f42a5ee53fe52d6e050b 3x"}, "body": "はじめまして！\n\n私のOCの新しい衣装のイラストをお願いしたいです。\n24歳の女性、性格はちょっと捻くれ者。魔法使いのお嬢様です。\n\nhttps://drive.google.com/drive/folders/10igWb5Iwot5uDwQjLuM9JDMdjP77-lzc\nこれらの画像にあるような、ふわっとした素材、草花模様の刺繍、少し色のついたフリル、サッシュベルトといった要素を希望します(1番気に入ってるのはこれです: https://drive.google.com/file/d/1OEoEBHVyu5thfWZbn7mAG4IJfuCAJCAa/view?usp=drivesdk)\n\n参考資料と違って、ドレスの丈はミモレ丈程度、袖口はパフスリーブでもいいですが、画像のものほど大きくなくていいです。少しカジュアルにしたイメージでしょうか。\n\nアクセントカラーは画像のようにシャーベットグリーンを考えていますが、そこにはこだわりません。\n\nhttps://drive.google.com/file/d/1R6ETuH1k9XhVkxkweG75eiNIMB6n8X_L/view?usp=drivesdk\nこちらの左のキャラクターです。\n\nもし可能でしたら髪型は(https://drive.google.com/file/d/1eMHbjfl1BLPUYgROJkyp_gWdYaXGCKER/view?usp=drivesdk) に、両サイドに編み込みがある感じですとなお嬉しいです！(メーカー使わせていただきます！ありがとうございます)\n\nイラストのポーズや背景はお任せします。\n設定画ではちょっと不機嫌な表情ですが、イラストでは上機嫌に微笑んでいたら良いですね。\nできれば文字等が入るなら、別にした画像もあれば嬉しいです。\nよろしくお願いします。\nもし金額等があわなければ再送をかけてください。描いていただいたイラストは、個人鑑賞用ですが他の依頼などの参考資料に使うこともあります。\n\nご検討いただければ幸いです。よろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arl_mk/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1183363, "client_id": 2447704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd04616b88bc13385ab7e589e3bbbfc4", "srcset": "https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd04616b88bc13385ab7e589e3bbbfc4, https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4555989ca9c61558fb0ba17bb7fc6aeb 2x, https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8aa437e88c39a4283188adaa73f4c25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4177f519136f0d4e697bb4639b1fbdd", "srcset": "https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4177f519136f0d4e697bb4639b1fbdd, https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43719ad8e2d00718c81032a8798bd334 2x, https://si.imgix.net/66bcd4e8/uploads/origins/7a5860ff-7996-439e-8ec1-4d57666d5daa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c