赤毛のScimitar catの男性です。\n彼のデザインはアカエリクマタカがモチーフで、目の色、模様やタテガミ、尾の白黒縞はそれをイメージしています。\nポーズなどはお任せいたします。\n\nhttps://x.com/F11_L23/status/1963200503757639728\nhttps://x.com/F11_L23/status/2012230076734345296\n\n（ヘッド製作元の資料）\nhttps://x.com/qijing260570760/status/1927067578813313246\n\nhttps://x.com/F11_L23/status/1963200503757639728", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itat1_0092/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2974567, "client_id": 3519814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22513a7a/uploads/origins/5c5e1e50-ed43-4898-bade-c937873731a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e6474b4a3ae779d68b7186684c6531a", "srcset": "https://si.imgix.net/22513a7a/uploads/origins/5c5e1e50-ed43-4898-bade-c937873731a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e6474b4a3ae779d68b7186684c6531a, https://si.imgix.net/22513a7a/uploads/origins/5c5e1e50-ed43-4898-bade-c937873731a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ece6c4f11324afb51042f2033603a88 2x, https://si.imgix.net/22513a7a/uploads/origins/5c5e1e50-ed43-4898-bade-c937873731a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ee680cb984da18f2d4b50e7d441a8b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22513a7a/uploads/origins/5c5e1e50-ed43-4898-bade-c937873731a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bbe95e486467f4b2ac3fed8875aee7a", "srcset": "https://si.imgix.net/22513a7a/uploads/origins/5c5e1e50-ed43-4898-bade-c937873731a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bbe95e486467f4b2ac3fed8875aee7a, https://si.imgix.net/22513a7a/uploads/origins/5c5e1e50-ed43-4898-bade-c9378