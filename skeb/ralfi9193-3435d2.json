364/uploads/origins/285abbd9-92e6-4bc6-9497-38e06cba522d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a58190eaf8124293c7fd90586f3b0cb8, https://si.imgix.net/8027b364/uploads/origins/285abbd9-92e6-4bc6-9497-38e06cba522d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=743a5fda4633361ea23fdd6307265467 2x, https://si.imgix.net/8027b364/uploads/origins/285abbd9-92e6-4bc6-9497-38e06cba522d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0546132bc3e15f21d88260d245e57d28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8027b364/uploads/origins/285abbd9-92e6-4bc6-9497-38e06cba522d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28db6af0d3aef054f41f694250b861a5", "srcset": "https://si.imgix.net/8027b364/uploads/origins/285abbd9-92e6-4bc6-9497-38e06cba522d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28db6af0d3aef054f41f694250b861a5, https://si.imgix.net/8027b364/uploads/origins/285abbd9-92e6-4bc6-9497-38e06cba522d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82260adcf2c74df4f9b20544e14f201c 2x, https://si.imgix.net/8027b364/uploads/origins/285abbd9-92e6-4bc6-9497-38e06cba522d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=885d4576c8fffb6e557cbccd7a113d12 3x"}, "body": "こんにちは。Sb69をテーマにしたアートにはいつも感心しています。特にチュウチュウとシアンの作品に。だから、あなたがskebを開くのを見るのはとてもエキサイティングです!\n\nでも、もし私のリクエストの内容が気に入らなかったり、価格が妥当でないと思われた場合は、お断りしても構いません。  お断りいただいても大丈夫です!\n\n次回は違うテーマで依頼するように心がけます。でも、やっぱりやってみたい・・・。\n\n私のリクエストは、私のオリジナルキャラクターと公式キャラクターを並べたアートワークが欲しいです！！どちらもSHOW BY ROCK！！シリーズのキャラクターです。シリーズ\n\nテーマとしては、公式キャラのクロウが、私のオリジナルキャラのレスリーの衣装選びを手伝ってくれるような感じでお願いします\n\nクロウはビジュアル系やパンクなどのスタイルに詳しくて、オシャレだと思うんです。クロウはそれをレスリーと共有し、レスリーが彼のように人混みの中で目立つようにしたいと思っています。クロウは誇らしげで、ちょっと嬉しそうな表情をしているはずです。レスリーのワードローブを手助けしながら。\n\nしかし、Leslieはもっとカジュアルで控えめな服装が好きな普通の女の子です。だからLeslieは、カラスのチョイスにちょっと照れくさくて、恥ずかしがっています。しかし、彼女はまだ彼の美学を賞賛し、彼の助けに感謝します。彼女はCrowのために赤面しているはずです。\n\n甘く、かつコミカルな感じの絵にしたいですね。\n\n表情、ポーズ、背景、雰囲気、小道具、細部は全てお任せしますので、好きなもの、楽しくできるものであれば何でもやってください\n\n以下、キャラクターの詳細です。\n\nレスリー（159cm）は、明るくて優しい性格のクマの女の子です。ちょっと平凡で、不器用で、おバカだけど、いつも笑顔で頑張ってるレスリー。カラスに憧れて、カラスを大切に思っている。レスリーはカラスと友達以上の関係になりたいと思っています。\n\nクロウ（165cm）（笑）は、熱血漢で情熱的で自己中心的な男だ。自分がやることなすこと全てにおいて最高だと本気で思っている。しかし、カラスは自分でも少しバカなところがある。Crowは自分の弱さを共有するのが少し苦手だが、金の心を持っていて、友達を大切にする。その中にはLeslieも含まれており、彼はLeslieのサポートと彼に対する優しさにいつも感謝している。たとえ、彼がそれを簡単に認めないとしてもね。\n\n\nキャラクター画像と参考資料はグーグルリンクにあります。\n私のリクエストを考慮していただけると幸いです !読んでくれてありがとうございます\n\nhttps://drive.google.com/drive/folders/11G7rRx4-5uDnHZAI5fIO0vq4CVZd8Trg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ralfi9193/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 920602, "client_id": 916351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/953c554c/uploads/origins/dd465408-1b32-4831-bd16-16870b537a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71fe53be5c1f7cdfc438b78aa47528b8", "srcset": "https://si.imgix.net/953c554c/uploads/origins/dd465408-1b32-4831-bd16-16870b537a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71fe53be5c1f7cdfc438b78aa47528b8, https://si.imgix.net/953c554c/uploads/origins/dd465408-1b32-4831-bd16-16870b537a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ebebc8fcf976bf2c29fb3ca627486c0 2x, https://si.imgix.net/953c554c/uploads/origins/dd465408-1b32-4831-bd16-16870b537a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c847d551ad90ba7dfbc9d7f53f334a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/953c554c/uploads/origins/dd465408-1b32-4831-bd16-16870b537a7a?bg=