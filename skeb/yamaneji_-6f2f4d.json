loads/origins/629c01e4-3dd1-4087-8c5c-640685b5dc95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6e023507df519ee480e20486530799f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4ac1d29/uploads/origins/629c01e4-3dd1-4087-8c5c-640685b5dc95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=223e3d1772590d7b2d6123e4331038bd", "srcset": "https://si.imgix.net/e4ac1d29/uploads/origins/629c01e4-3dd1-4087-8c5c-640685b5dc95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=223e3d1772590d7b2d6123e4331038bd, https://si.imgix.net/e4ac1d29/uploads/origins/629c01e4-3dd1-4087-8c5c-640685b5dc95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2bed6126286cfffa0ab7c7a3c65423a2 2x, https://si.imgix.net/e4ac1d29/uploads/origins/629c01e4-3dd1-4087-8c5c-640685b5dc95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eff8872d218a248b2f2a603b7912191c 3x"}, "body": "やまねじさん、初めまして！あなたのコミックはとても素敵です!よろしければ私のオリジナルキャラクターカップルにリクエストしたいのですが\nBLとGL両方の設定図を添付しました、先生が自由に描いてください。\n金額が足りない場合、再送要請をお願いします。\n\n單靈暄：赤髮のキャラクター(175cm)受け\n明るくて洒脱な性格、犬系男子。\n過去は悲惨なことを経験したが、今は物事を楽観的に見る。\n幼い頃から流浪していた孤児、一目でチャラ男に見えるようにが、実はとても優しい人で、笑顔で悲しみを隠す。\n武器は一つに組むできる双剣。\n一人称/俺\n二人称/お前\n攻めのことは｢蘇にいちゃん｣｢蘇にい｣と呼びます。\n\n蘇硯川：黒髪のキャラクター(180cm)攻め\n名家に生まれた貴公子、猫系男子。\n幼い頃から母親に厳しく残酷に育てられたため、本心を見せないことに慣れ、無関心に人と接し、何事にも完璧で上品だが、赤髪には特別に意地悪。\n武器は絹糸が入った指輪。\n一人称/私\n二人称/アンタ\n受けのことを｢靈くん｣、｢單靈暄｣と呼びますが。\n\n二人の関係: クラスメイト及び同僚(異能警察)\n赤は黒に憧れ、愛している。\n黒は赤に見つめられるのが好きだが、感情を表現するのは苦手。意地悪しても相手も愛されるので、相手をいじめるのが好きだ。\n\nhttps://drive.google.com/drive/folders/1IKU7H7wP53nuDT8HuA_eWWblWZYYN1CD?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamaneji_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3