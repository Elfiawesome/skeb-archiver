f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b77e30d9416f15cc017164dfe81e381, https://si.imgix.net/a3c34bd3/uploads/origins/7c8fb787-cb68-482a-8b48-23dce8697440?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9725958d65a0731e6bb8c57a6cf5f45e 2x, https://si.imgix.net/a3c34bd3/uploads/origins/7c8fb787-cb68-482a-8b48-23dce8697440?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=babfca688c6cd50ded1e7b5637ad4493 3x"}, "body": "初めまして。kystrsのハイグレがめちゃくちゃ刺さったので依頼したいと思います。\nSummer Pocketsの鳴瀬しろはのハイグレイラストをお願いします。\n白色のハイレグ、ロンググローブとロングソックスでお願いします。\n\nシチュエーションとしては\n1.困惑と赤面が交りながらハイグレをする\n2.ハイグレでイってしまう（目を強く閉じて舌を出す）\n3.洗脳が完了して真剣な表情でハイグレをする\n以上の3つで、構図は先日あげていたkystrsのような両腕を動かしているときに胸に当たるような構図でお願いします。\n\nhttps://key.visualarts.gr.jp/summer/character.html", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_i_gu_re/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2118785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ebce1f02ab07f9305cd810846b9849", "srcset": "https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ebce1f02ab07f9305cd810846b9849, https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=548dc44525e87f1ac272920d87af4a30 2x, https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=101d06630b49c184d96ed2ac37c83eec 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af58941addef9f92c810eaa334d85bfa", "srcset": "https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af58941addef9f92c810eaa334d85bfa, https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6b6d5cb20fbb6015500c25505cace5e 2x, https://si.imgix.net/f32c5491/uploads/origins/71a80a0d-89ba-472d-b089-0ec8219d9480?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=177cd9eb1005b26fc134ac354f5dfa5d 3x"}, "body": "物凄く下品でマニアックな内容になりますが、可能であればお依頼を引き受けて頂けると嬉しいです。\n\n『シチュ内容』\n\nブルーアーカイブのニヤニヤ教授に、1枚目は服を着たまま余裕そうな笑顔で、2枚目からは全裸で帽子を被って、股間の部分に穴の空いた黒タイツを履いた状態のガニ股ポーズで三方向鼻フックを着けさせて、舌を垂らしたアヘ顔で鼻の穴をダブルピースした指でほじらせて、3枚目ではピースした指を引き抜いて変態宣言をさせる即堕ち2コマシチュをお願いしたいです。\n(合計3枚)\n\n『参考資料』\n\nhttps://www.pixiv.net/artworks/120994606#manga\n\nhttps://www.pixiv.net/artworks/111384249\n\nhttps://www.pixiv.net/artworks/116678072#manga\n\n『台詞』\n\n 1枚目\n\n「ほむ…この私を屈服させると？その心意気は買いますが、これから何をしようと、貴方程度の頭脳と策略ではこの私に勝つ事など到底不可能だと思いますけどねぇ…」\n\n2枚目\n\n「ほむっ♡むほぉっ♡ほじほじぃ〜♡鼻ほじ♡鼻ほじほじぃぃ〜んっ♡♡鼻ほじブサイクド変態豚女の『ホジホジ教授』でぇ〜っす♡♡鼻水いっぱい垂れ流して♡いっぱいお鼻をホジホジしちゃいまーすっ♡♡」\n\n「知能ダダ下がりの下劣でおバカな変態鼻糞ほじりぃぃ〜んっ♡♡いっぱい馬鹿にしてくだしゃいぃぃっ♡♡ぶほぉっ♡！？ほひぃぃっ♡♡ 鼻毛ジョリジョリしながらっ♡おっきい鼻糞ぉ〜♡いっぱいほじるの気持ちいいぃぃぃ〜んっ♡♡」\n\n3枚目\n\n「ゔっほぉ゛っ゛♡♡見てくだしゃいぃぃっ♡♡ぶっとい鼻毛とおっきい鼻糞ぉっ♡汚いのがこんなにいっぱい取れましたぁぁ〜っ♡♡」\n\n「今度はあなたのぶっとい指で私の鼻の穴をズポズポほじくり回していじめてくださぁ〜いっ♡わたしぃっ♡『ホジホジ教授』はぁ〜♡鼻ほじが大好きなおバカで下品なブッサイクな雌豚女でぇ〜すっ♡♡♡」\n\n『要素』\n3枚目には身体に『変態』、『マゾ豚』、『バカ』といった下品な落書きを施して、もらえたら嬉しいです。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ha_i_gu_re/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c0745577/uploa