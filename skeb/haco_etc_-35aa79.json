.imgix.net/169e1b67/uploads/origins/d8dbc945-f003-4eb6-98a5-2b1c933c2851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9467c77b09dba81feb244ac1c773dcd9, https://si.imgix.net/169e1b67/uploads/origins/d8dbc945-f003-4eb6-98a5-2b1c933c2851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab3992bd25d875149f0d21ca99214fac 2x, https://si.imgix.net/169e1b67/uploads/origins/d8dbc945-f003-4eb6-98a5-2b1c933c2851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e92b0560e4fa355f90d70db074ab2c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/169e1b67/uploads/origins/d8dbc945-f003-4eb6-98a5-2b1c933c2851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e073b59ed269c4566b0bfc69ef2f2fc7", "srcset": "https://si.imgix.net/169e1b67/uploads/origins/d8dbc945-f003-4eb6-98a5-2b1c933c2851?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e073b59ed269c4566b0bfc69ef2f2fc7, https://si.imgix.net/169e1b67/uploads/origins/d8dbc945-f003-4eb6-98a5-2b1c933c2851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9014a4bbf8debac55df27e79d765d612 2x, https://si.imgix.net/169e1b67/uploads/origins/d8dbc945-f003-4eb6-98a5-2b1c933c2851?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f575ed863acf6dd31f13da8a1ad60f65 3x"}, "body": "Nice to meet you, Chikage-sensei! May I request an illustration? The character is a gentle and kind fairy prince with a mysterious nature. \n\nPossible themes: White chrysanthemums, blue morpho butterflies, royalty. If it is helpful, here is some visual inspiration, but please do not feel constrained by it: https://br.pinterest.com/languhiris/adonia-aes/ \n\nFeel free to choose composition and themes freely.\n\nPlease note that the braid is only one small part of his hair. As shown in the back view, he has a lot of long, flowing hair hanging behind him. Braid in front and long hair behind. I hope that helps to clarify the hair style. ^^\n\nThere are four versions of the flowers in his hair. You can either draw him with the first or second versions, \"neutral\" or \"happy\". \n\nPlease put any text on a separate layer in the PSD that can be turned on and off.\n\nThank you very much for considering my request!! (I'm very sorry if the machine translation sounded rude.)\n\nhttps://imgur.com/a/ujUhe8b", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haco_etc_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2402971, "client_id": 1389755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd4c0bac/uploads/origins/9bac2bd2-50eb-4ce3-bed5-ef67508680e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0513a594f0d383ba1f8d8be45272882", "srcset": "https://si.imgix.net/dd4c0bac/uploads/origins/9bac2bd2-50eb-4ce3-bed5-ef67508680e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0513a594f0d383ba1f8d8be45272882, https://si.imgix.net/dd4c0bac/uploads/origins/9bac2bd2-50eb-4ce3-bed5-ef67508680e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b62484f34c3776688f5efdcd88f6ce3c 2x, https://si.imgix.net/dd4c0bac/uploads/origins/9bac2bd2-50eb-4ce3-bed5-ef67508680e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef678e090264533c59959a157969c9be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd4c0bac/uploads/origins/9bac2bd2-50eb-4ce3-bed5-ef67508680e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8635cc01f39dc828dcafe13d2096edee", "srcset": "https://si.imgix.net/dd4c0bac/uploads/origins/9bac2bd2-50eb-4ce3-bed5-ef6