やSNSでの小説の挿絵、キャラ紹介、個人活動の告知、トリミング加工を伴うアイコン・ヘッダー・バナーとしての使用等、コミッションサイトでのイラスト等依頼時に参考資料等）を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 203508, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "るしあん/5月以降納品のお仕事募集中", "screen_name": "rushia_n", "avatar_url": "https://pbs.twimg.com/profile_images/1900361104389529601/-XwUJ508.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2885785903/1669897829/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 754109, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さかな", "screen_name": "paripi_nasubi", "avatar_url": "https://pbs.twimg.com/profile_images/1591957574366232576/IASeNqc7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/805319002750783488/1676094979/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 1221475, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "保住圭 四姉妹＆青三角ドラゴンエイジ誌で連載中", "screen_name": "hozumik", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fmisskey%2Fdf32b0dd-3fb1-410d-9a35-f81457242938.png?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/658ddb8c-1c5b-4ef6-b0fe-0bb6c85e812f.png?sensitive=true", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": nu