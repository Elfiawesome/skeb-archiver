に潜り込むが絶対にバレて悪ガキと怒られる。\n\n要望\n・3人とも元の記憶は持っており、性格そのままと思っているが少しだけ体に性格が引っ張られている。\n・学園の生徒たちは誰も元の3人の事は知らなくなっている。", "nc": 185, "word_count": 6439, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@spankfrom/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/130ffad0/uploads/origins/2cbda470-66f4-491f-b839-68aa4602ea67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fa25db9a1c35444675e7e1a4adfa69c", "srcset": "https://si.imgix.net/130ffad0/uploads/origins/2cbda470-66f4-491f-b839-68aa4602ea67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fa25db9a1c35444675e7e1a4adfa69c, https://si.imgix.net/130ffad0/uploads/origins/2cbda470-66f4-491f-b839-68aa4602ea67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e78ce27cde77a3dd171c6b690918f2b 2x, https://si.imgix.net/130ffad0/uploads/origins/2cbda470-66f4-491f-b839-68aa4602ea67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=93e405bba26856b0786923170a99973b 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 3950915, "nc": 49}, {"path": "/@spankfrom/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3950915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f20c17db/uploads/origins/f60f8923-3b86-4889-8eda-97844ae44bfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01752640d4921f7d2a4b8a6740f08aa1", "srcset": "https://si.imgix.net/f20c17db/uploads/origins/f60f8923-3b86-4889-8eda-97844ae