い方に魅了されました。まるでモザイク画のようですね。とても美しいです！\nもし興味を持っていただけたら、私のユニコーンの女の子のキャラクターを描いていただけたら嬉しいです。とても穏やかなキャラクターです。彼女は中世のタペストリー（\"The Unicorn Rests in a Garden\" / \"The Captive Unicorn\"）に基づいています。このタペストリーを見ると、あなたの作品を少し思い出します。  構図はあまり考えていないので、適当に描いてください。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1AymqAw8Iy62jin7AStK5ugPLprqS1r80", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 909021, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "イチゴ", "screen_name": "156480", "avatar_url": "https://pbs.twimg.com/profile_images/2038496346160959488/RW1K1_Dl.png", "header_url": "https://pbs.twimg.com/profile_banners/280965424/1774851812/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 0}, {"id": 1542844, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "き", "screen_name": "kirentono", "avatar_url": "https://pbs.twimg.com/profile_images/1688908908889604097/R8I-Rtx-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1317394677469831168/1691721492/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2514977, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "奈井", "screen_name": "nai_mng", "avatar_url": "https://pbs.twimg.com/profile_images/1519686414371225600/wv3JGHR8.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at"