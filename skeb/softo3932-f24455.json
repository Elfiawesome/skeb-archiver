6c-a51a-d78623dfa43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1058e98f2d9ac04a2f86e7b71b39c83 3x"}, "body": "こんにちは！あなたの画風は可愛らしく、ぜひ応援したいです！\nもしお忙しくなければ、私のオリジナルキャラクター、ステファニー・フライの健全な緊縛作品を描いていただけませんか？彼女は縛られることにリラックスと安らぎを見出す内気な女の子なので、当然、表現的には縛られる方が嬉しいと思います。\n私はいつも芸術的な自由を評価するので、あなたが好きなように彼女を縛り、あなたが描きたいなら、好きなように猿轡も描かせてあげましょう。\n参考資料は以下にあります。これからもよろしく！\n\nhttps://drive.google.com/drive/folders/1ooMSYKUSAyvAlKvVVgfL_XM36wFYRNMn", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@softo3932/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2691600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a636bd0e7472a4931d71ed10827c273e", "srcset": "https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a636bd0e7472a4931d71ed10827c273e, https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ded3b799d1ba29a4489a41a02a53ba15 2x, https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7952516df9044d8233d69177d1aa83f6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=708a77469e6c57e0ab26e7813ae2398c", "srcset": "https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=708a77469e6c57e0ab26e7813ae2398c, https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d7a68e6ca8ec552bb3100c115e1c099 2x, https://si.imgix.net/bf7af539/uploads/origins/0fd75e05-36fc-4be2-a102-1070b65c2823?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ec0f58a44601608ee1fc4f9055bdc0 3x"}, "body": "おへそが見える着丈の短い襟付きのノースリーブのに股下ギリギリの超ミニスカート、膝下丈の黒のハイソックスのコーデで、手足を縛り上げられたアイドルマスター シンデレラガールズの喜多日菜子ちゃんのイラストを全身でお願いしたいです。\n\n構図は正面からで、悪い人に捕まり手足を縛られ立たされ柱に繋がれた状態にして欲しいです。\n\n服装は\n・ノースリーブは肩を完全に出し、袖口にフリルなどがないシンプルなデザイン。色は薄い黄色でお願いします。袖口は大きめに開いて肩と腋が見える大きさにしてください。着丈はおへそが完全に見える短い丈で、短ければ短いほど嬉しいです。襟はブラウスかポロシャツと同じ感じでお願いしたいです。\n・スカートは股下がほとんどないギリギリの超ミニ丈にしてほしいです。スカート自体がめくれているのではなく、丈そのものが短い感じでお願いします。プリーツスカートで裾が広がるデザイン、タイト系は避けてください。色は白色でお願いします。\n・ハイソックスは黒一色の透けないタイプで、膝下を完全に覆う丈でお願いします。\n・靴は無しか白い靴でお願いします。\n・スパッツ、インナーパンツ等は無し。\n・ふとももは生脚。\n・ガーターリング等ふとももの装具や、ふとももにかかるアクセサリーなどはなし。\n\n縛り方ですが\n・後ろ手に胸の上下を縛り、脚は両足首のみを縛り、ふとももや膝の上下などは縛らない。\n・ロープなど、細い紐状のもので縛ってほしいです。\n・猿轡や目隠しなどは無しで、目と口は見えるようにしてほしいです。\n・可能なら胸の下の縄で腕と体の間にある縦の縄、両足の間に縦に入っている縄も入れてほしいです。\n・股縄はなしでお願いします。\n・脚はやや内股でもじもじしてる感じで願いしたいです。\n・縄は足首のみで、ふとももなどにはかけないでほしいです。\n・日菜子ちゃんは柱ごと縛るのではなく、手足を縛り上げられた日菜子ちゃんを柱の前に立たせ、日菜子ちゃんを縛った手の縄と柱の縄を繋げた感じでお願いしたいです。\n\n\n表情は\n悪い人に捕まって涙目な感じてお願いしたいです。\n\n指定が多く恐縮ですが、検討して頂けると幸いです。よろしくお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@softo3932/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2691600, "client_id": 2956466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/071bc4a3/uploads/origins/097869ab-a47e-4678-8754-ffef481e860b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7db56b5eb7e32f06fdb84905f6f0351", "srcset": "https://si.imgix.net/071bc4a3/uploads/origins/097869ab-a47e-4678-