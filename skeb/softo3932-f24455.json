。\n\nブルアカの陸八魔アルと錠前サオリの緊縛イラストをリクエストさせていただきます。\n\n緊縛・拘束の内容は以下の参照イラストのように、V字胸縄付きで後ろでに縛られ、足首も縄拘束されて、\n二人ともガムテープで口をふさがれて並んで座らされているイラストでお願いします。\n<緊縛参照イラスト>\nhttps://www.pixiv.net/artworks/122978612\n\n衣装はイベント「0068 オペラより愛をこめて！」のときの、ドレス衣装でお願いします。\n<衣装参照>\nhttps://bluearchive.wikiru.jp/?%E3%82%A2%E3%83%AB%EF%BC%88%E3%83%89%E3%83%AC%E3%82%B9%EF%BC%89\nhttps://kamigame.jp/bluearchive/page/304554303501142529.html", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@softo3932/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2691600, "client_id": 1621166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d06677c3/uploads/origins/bfd8fb05-05a1-4835-af5f-3d6a7f20b432?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a09ba197a966fb2b8f17a57f13b7f511", "srcset": "https://si.imgix.net/d06677c3/uploads/origins/bfd8fb05-05a1-4835-af5f-3d6a7f20b432?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a09ba197a966fb2b8f17a57f13b7f511, https://si.imgix.net/d06677c3/uploads/origins/bfd8fb05-05a1-4835-af5f-3d6a7f20b432?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c85772227ac5e8c8d8427c254cc9458b 2x, https://si.imgix.net/d06677c3/uploads/origins/bfd8fb05-05a1-4835-af5f-3d6a7f20b432?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ee0b04b9277fccc5d16477bdd8e1cf3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d06677c3/uploads/origins/bfd8fb05-05a1-4835-af5f-3d6a7f20b432?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22088d98af7f4c6408e57d88bf2939fd", "srcset": "https://si.imgix.net/d06677c3/uploads/origins/bfd8fb05-05a1-4835-af5f-3d6a7f20b432?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22088d98af7f4c6408e57d8