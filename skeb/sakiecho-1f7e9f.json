す。また、中破アイコン（適当で大丈夫です）をつけていただけると嬉しいです。 中破アイコンはレイヤーを分けてください。\n\n中破イラストについて： 雰囲気的には磯風　中破、祥鳳改　中破、大和　中破、筑摩改二　中破　あたりのちょっとえっちな雰囲気のほうでお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 38527, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "鯛噛TAIGAMI", "screen_name": "sushi_dbc", "avatar_url": "https://pbs.twimg.com/profile_images/1983282489323073537/0fGc79di.jpg", "header_url": "https://pbs.twimg.com/profile_banners/896323902917320705/1704192548/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 89076, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ゼフィ", "screen_name": "zephy_full", "avatar_url": "https://pbs.twimg.com/profile_images/1794362231423172608/YjbpQ0cB.png", "header_url": "https://pbs.twimg.com/profile_banners/4419859332/1754218553/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 115627, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ota", "screen_name": "00oooot", "avatar_url": "https://pbs.twimg.com/profile_images/1101772186224717824/Iy_LtukE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1094501846402576386/1705049031/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"ge