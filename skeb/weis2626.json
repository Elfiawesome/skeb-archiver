ぱなしENDが良いかも)\n---\n\n疑似生殖パーツがあるということは、（無排泄にせよ）擬似的おしり穴に相当するパーツが存在するはず...なので、（非人体的・ロボ的な）何かしらおしり穴を発見され、刺激介入用のゲルちんぽなり機械ゴムちんぽなり\nガシュガシュ挿れてもらってsecを強制疑似射精させられたら最高です。\n\n以前描いていただいたこちらロボのおしりの穴のSec版、と言ったらわかりやすいかもしれません。\nhttps://skeb.jp/@weis2626/works/17\n\n僕の依頼物では度々セリフを入れて頂いていますが、\nKにぃさんの台詞回しは大好きでございますので、前回前々回に倣っていただければ幸いです。\n---\n\nそしてこれは納品物PSDについて、「海苔版」と「モザイク版」の２種類をご用意いただくことは可能でしょうか？\nもし可能でしたら是非...！\n\n度々登場する竿機械たちの、そんなSecさん達が機械チンコをボロんボロん出しちゃう前エピソード的の一例になれば…と思っています。\n長文で申し訳ありません、今回もKにぃーさんの可能範囲内で是非どうぞよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@weis2626/works/43", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/421e7068/uploads/origins/8e8f50a7-102f-4577-b8ed-1ada3d2ef1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4328a94ca0dea582f51995e0e5465200", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 598228, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@weis2626/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 598228, "client_id": 25044, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7b7283b/uploads/origins/2534d76c-7388-42a9-a8c9-006cb25fd9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25271f81bfe56656e9b011f9661802c1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7b7283b/uploads/origins/2534d76c-7388-42a9-a8c9-006cb25fd9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=722f983b75b1e91b8a8a3b496