者のごとく凶暴そうで、しかしどこか楽しそうな表情でした。\n衣服は恐らくサイバーチックな肌に密着するタイプのスーツだったと思うのですが、いかんせんその夢を見たのが中学頃だったのではっきりとは不明です。\nこのような内容でも、よろしければ書いていただけないでしょうか？\n\n　　　　　　　　　　　　　SCOPEWOLFより", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@69ON369/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3197864, "client_id": 1884157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6cf723e/uploads/origins/feeeab40-a897-4407-9eb7-43bde43a7e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b407f8e4c212614c90ddbcf7dadb0c39", "srcset": "https://si.imgix.net/c6cf723e/uploads/origins/feeeab40-a897-4407-9eb7-43bde43a7e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b407f8e4c212614c90ddbcf7dadb0c39, https://si.imgix.net/c6cf723e/uploads/origins/feeeab40-a897-4407-9eb7-43bde43a7e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d65d3da76170ce3ebe251e2b0b7ff2ec 2x, https://si.imgix.net/c6cf723e/uploads/origins/feeeab40-a897-4407-9eb7-43bde43a7e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64b3a8d329081f6de2c42fc340882314 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6cf723e/uploads/origins/feeeab40-a897-4407-9eb7-43bde43a7e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19743cf76ce257d97df06b150fbcf9d8", "srcset": "https://si.imgix.net/c6cf723e/uploads/origins/feeeab40-a897-4407-9eb7-43bde43a7e25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19743cf76ce257d97df06b150fbcf9d8, https://si.imgix.net/c6cf723e/uploads/origins/feeeab40-a897-4407-9eb7-43bde43a7e25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e71d92afa980f8898d5e6fbcf2fb132d 2x, https://si.imgix.net/c6cf72