-4c57-83f8-7ba3b75ab933?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f80ec38597457c6f274ebe2bb92f9bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba18e9a4/uploads/origins/9f2e0a3c-fcff-4c57-83f8-7ba3b75ab933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5d986f7564483c46cc652d9e0db909d", "srcset": "https://si.imgix.net/ba18e9a4/uploads/origins/9f2e0a3c-fcff-4c57-83f8-7ba3b75ab933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5d986f7564483c46cc652d9e0db909d, https://si.imgix.net/ba18e9a4/uploads/origins/9f2e0a3c-fcff-4c57-83f8-7ba3b75ab933?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8327573316eeecfc0b6ad43acb3f992 2x, https://si.imgix.net/ba18e9a4/uploads/origins/9f2e0a3c-fcff-4c57-83f8-7ba3b75ab933?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bf4724467aa0877e1e049451a45a73f 3x"}, "body": "庭前様、はじめまして。ボカロPとして活動しております、Rumeciaと申します。\nXにて庭前様のイラストを拝見し、絵柄が好みだったので、ぜひボカロ楽曲のイラストを描いていただきたく思いまして、リクエストを送らせていただきました。\n\n〇依頼内容\n私の楽曲「ミスフォティア（Short ver.）」の\nロングバージョン用にイラストを描いていただきたく思います。\nhttps://youtu.be/fcmDYNPWCVE?si=E6HBbswi9lC3fQOh\n\n〇詳細\n全体の構図は、ショートver.を参考にお願いしたく思います。\n人物の雰囲気はこちらがとても気に入っております。可能でしたらこちらの雰囲気でお願いしたいです。\nhttps://x.com/niwamaee/status/1951976355484270878?s=46\n\n背景に関してですが、ショートver.の雰囲気を参考にしていただき、画面上半分ほどが青空、下半分ほどが地面などを想定しております。\n上半分ほどの青空ですが、差分で花火が上がっている描写もお願いしたく思っていますので（夜空に花火が映るような感じ）、少し濃い青色（ネイビーブルーのような色）でお願いしたいです。\nまた下半分ほどの地面の部分で、ショートver.のイラストと区別をはかりたく思っていまして、例えば草などは似たようなものを不自然のないように書いてみて、追加で地面の一帯を河川敷にしてみるなど、可能な限りで構いませんのでお願いしたく思っております。\n\n人物に関してですが、性別は女性、髪の長さはミディアムほどの長さで、少し風で靡いている感じでお願いします。服装は涼しい感じでおまかせします。ショートver.ではおなかを出していますが、おなかを出した服装ではないものでお願いしたいです。\n人物は中央に配置し、ほぼ全体が映るようにお願いしたいです。\n楽曲としては、モチーフが花火ですが、世の中にある明るい花火の曲ではなく、少し暗い雰囲気で、落ち着いた印象があると嬉しいです。\n\n〇使用用途\n楽曲内イラスト、サブスク配信のジャケット\n\n〇納品形式（4点）\n・背景のみ（空が青色／少し濃い青色）\n・人物のみ（背景透過）\n・背景に映す花火（背景透過）\nサイズは全て16:9の横長でお願いします。\n\nお忙しいところ大変恐れ入りますが、\nご検討いただけますと幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niwamaee/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 686430, "client_id": 2731701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d803ec9d933d640ceca0f72cab4f424a", "srcset": "https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d803ec9d933d640ceca0f72cab4f424a, https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b22f5e4f8b91d571764405518776fd65 2x, https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=123eb04caadfd2d95c382e24ede1be72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b1e3d2b2d9e9328c0345b6e234f3ee0", "srcset": "https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b1e3d2b2d9e9328c0345b6e234f3ee0, https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=722b558e5c831d6830f88edc476e90d3 2x, https://si.imgix.net/3f748bc9/uploads/origins/9f90b489-5cd4-407c-bda8-7141e32642fa?bg=%23