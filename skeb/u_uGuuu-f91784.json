おきましたが、シチュエーションやロケーションはお任せします！\n左がAで、右がBだと助かります。\n表情は二人のアバターを見て感じた印象で設定して貰えると嬉しいです。\n\n頭上の浮いている輪っか（これはバージョンアップで透明になりました。写真は以前の物が多いので黒です。）や身につけているアクセサリーなどの、細かいディティールなどは省略して頂いても構いませんので、好きなようにしてやってください。\n\nそれではよろしくお願いいたします！楽しみにしています！\nちなみに友達には内緒で依頼をしているので驚くと思います。\n\nhttps://drive.google.com/drive/folders/1--TElbfCPohCUvdQJ8Xfab26annjWd8A?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_uGuuu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1845630, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8440c25c/uploads/origins/899dc28f-c8b0-49b8-bcc3-3f69cb738706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8680d43ecfa02900254dd31c09895d35", "srcset": "https://si.imgix.net/8440c25c/uploads/origins/899dc28f-c8b0-49b8-bcc3-3f69cb738706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8680d43ecfa02900254dd31c09895d35, https://si.imgix.net/8440c25c/uploads/origins/899dc28f-c8b0-49b8-bcc3-3f69cb738706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=58f66b20f498b9cac1d2bb7d911ca137 2x, https://si.imgix.net/8440c25c/uploads/origins/899dc28f-c8b0-49b8-bcc3-3f69cb738706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9572d54ea9feb70648a1686cec3218dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8440c25c/uploads/origins/899dc28f-c8b0-49b8-bcc3-3f69cb738706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e4618feeb33d8cc5bcb07211eb7df0d", "srcset": "https://si.imgix.net/8440c25c/uploads/origins/899dc28f-c8b0-49b8-bcc3-3f69cb738706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e4618feeb33d8cc5bcb07211eb7df0d, https://si.imgix.net/8440c25c/uploads/origins/899dc28f-c8b0-49b8-bcc3-