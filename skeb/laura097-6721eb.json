"creator_acceptable_same_genre": true}, {"path": "/@laura097/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3126230, "client_id": 140313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=804a2d1c77c8ea9f4227bdd4ceb2b953", "srcset": "https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=804a2d1c77c8ea9f4227bdd4ceb2b953, https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2d22e374250f3fcc77590093587ba2a 2x, https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2ac359a3a3a7a7e1d9739a82354c8487 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5022e7938381bfb130e38632e8f7b5e", "srcset": "https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5022e7938381bfb130e38632e8f7b5e, https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=195031001cd39b65a204e56388f95a62 2x, https://si.imgix.net/14e76d50/uploads/origins/0bacb3e9-60ff-45ef-901e-9b2f6cc09791?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4df20a0820e1647a513ce60879d23e9f 3x"}, "body": "Please draw my character named Meh.\nSheep, moon, succubus, etc. are included.\nHeight: 118cm, Age: about 10 years old\nShe is a little bit squidgy and has a lot of hair.\n\nThank you for your appeal.\nPlease draw it prettily.\n\nCharacter's personality\nShe is a little bit ennui, a little bit sleepy, and a little bit young.\nHer behavior is quiet and friendly.\nShe likes milk, nuts, chocolate, etc. and has a small appetite.\nHer behavior is harmless and she does not like hostility.\n\nI will leave the composition and situation to you.\nHowever, if you need some ideas, please refer to the following texts\nSleeping curled up on grass or a futon chair.\nLooking into the distance from a high place (chimney, etc.)\nSmiling while being petted by something\nFlying in the air as if he/she feels good.\nBathing in the water\nDripping milk from his fingertips into a bottle\nSnoozing with an animal\nSleeps with a sleeping person and gently drains his energy (luminescence).\nSitting on or embracing a crescent moon, or entangling the moon\nThe animal seems to feel comfortable having its hair sheared by a third party.\nBroken horns (not painful)\nSquatting and peering at small objects\nWalks around at night holding hands with someone.\nSits on a stuffed sheep and looks at the sky\n\nSetting Ability\nMeh is a kind of fairy or demon that lives in people's memories.\nThe edges of her body are faintly luminous, and she is usually floating.\nShe is close to peaches, alcohol, milk, dried bedding, etc.\nShe wears a light sweet fragrance that can throw off a person's guard.\n\nIt induces drowsiness in the person who keeps touching its skin by hugging, etc., and makes them dream.\nIt interferes with the dream and keeps its presence by slipping information about itself into the dream.\nThe body fluid and blood secreted are like condensed milk and milk,\nThe fluid and blood secreted are like condensed milk or milk, tonic and mildly addictive to the person to whom they are given.\n\nPlease refer to the following URL and Skeb's previous deliveries\nhttps://www.pixiv.net/artworks/99333545\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@laura097/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3126230, "client_id": 1285057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839fb06e28864383d53990bd3925118d", "srcset": "https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839fb06e28864383d53990bd3925118d, https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a80071a7e518aa4df2131b74cb2c0776 2x, https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25b8f6b60fabdb2fb9bc1f54048faf53 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ccb8b3138ae66f5414c1546d95a1c6d", "srcset": "https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ccb8b3138ae66f5414c1546d95a1c6d, https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e213606ca4f3683460059ffc716e5ef 2x, https://si.imgix.net/bd4f40c9/uploads/origins/9078ae41-8a06-4dfc-9167-a9307d71d1f3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5cd69d168b22060fcb31a308f1f63fe 3x"}, "body": "Hello I saw the appeal request, I would like you to draw my Vtuber, thank you.\n\nhttps://drive.google.com/drive/u/0/folders/1hHLOGsgjEcqz1sZIjQgg3Q-kj-z43fd7", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@laura097/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3126230, "client_id": 8988, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c97b6c46e7bd95d4590ef57befd17d6", "srcset": "https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c97b6c46e7bd95d4590ef57befd17d6, https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cbdf732ae244a6eda0700a88cd2c387 2x, https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=243ea0b9bd9571c8b1a9c8edf29ff09b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cf1e177c10f7750a7714a6587dc94e1", "srcset": "https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cf1e177c10f7750a7714a6587dc94e1, https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16dfd195f60c8e3b21c425592265d76f 2x, https://si.imgix.net/ae049fff/uploads/origins/d121d513-0956-418d-8cd1-af5b4b2e47fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bcf878210e88f2c6fef2232a9a385fd9 3x"}, "body": "Nice to meet you, Mr. InsertCoin.\nMy name is Rice.\nThank you for your wonderful proposal.\nI hope you will draw our child \"Meyva\".\n\nReference materials\nhttps://drive.google.com/drive/folders/1qgFL198KMzHOrgOGzZg_oVBpOBUshHe_?usp=share_link\nIf you can't see the URL, please refer to my fixed tweets.\n\n■Theme\nThe theme of the illustration is \"That's not right!\" Please use the following theme.\nI leave the interpretation of the theme to the creator's judgment.\nBy the way, I love the work Danganronpa.\nComposition\nPlease be aware of cut-ins.\nWorldview\nThe world in which Meyva lives is an Earth where civilization has collapsed and thousands of years have passed. The majority of the people who live there are wild animals and robots, except for Mayva, and only a few monsters roam the streets. Most of the places that used to be cities are in ruins for various reasons: submergence, greening, desertification, etc. In rare cases, there are places that have been transformed into shapes that clearly defy physics. Mayva is happily strolling through such a world.\n■Settings (Clothing)\nShe wears an exploration outfit when she explores, but when she judges that there is no danger, or when she is not exploring, she wears a one-piece dress (changing clothes is possible in an instant thanks to future technology).\nOthers\nWe would like to be able to turn on/off the address in the psd layer if possible.\nThe image color of Meiva is \"emerald green\".\nWe would like to use your illustrations for our activities, such as posting them on SNS (e.g. CrossFolio) and introducing them as thumbnails or in videos when we have a chance to post videos in the future.\nWe also have a hashtag \"#Meiva's Record Book,\" which you can refer to here.\n\nThank you for your consideration.", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 698176, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "メリーさん", "screen_name": "Merry_San_Xmas", "avatar_url": "https://pbs.twimg.com/profile_images/1944759978075500544/VlpibCgM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1212203739550900228/1756728414/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 65, "skills": [{"genre": "art"}], "banned": false, "nc": 169}, {"id": 1078629, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "SAE", "screen_name": "SAE1293", "avatar_url": "https://pbs.twimg.com/profile_images/2000400572097400832/QmqTCJ0J.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1356851480158904321/1758636689/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 0}, {"id": 2639777, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mochi @イラスト依頼募集中", "screen_name": "oyasumunemui", "avatar_url": "https://pbs.twimg.com/profile_images/2052336771162337280/k4NdbwaV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1612799042223996929/1678092403/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_d