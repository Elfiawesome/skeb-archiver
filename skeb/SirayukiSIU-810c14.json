top&w=200&h=200&blur=200&s=84f767fd3d502e07d7b1be1017cdc4a3 3x"}, "body": "シラユキさん、こんにちは！昨日Twitterで偶然あなたのページを見つけ、ぜひお仕事を依頼したいと思い興奮しています！何週間もあなたのような画風を探していたんです！本当に大好きです！よろしければ、私のオリジナルキャラクター・茜の制服姿を描いていただけませんか？\n身長165cm。控えめで静かだが、良い会話は楽しむ。自由時間は古着探しやベースの練習に費やす。2000年代以前のヴィンテージ品に夢中。何もしないのが大嫌い。趣味：植物、古着探し、ファッション、バンドでのベース演奏好きなもの：スイーツ、リズムゲーム、雨性格：控えめで観察力があるが、恋愛に関しては鈍感\n\n大きな、落ち着いたオリーブ・カーキ色のオーバーサイズジャケットを着ている。その下には、青のストライプ柄のネクタイを合わせた黒の長袖ドレスシャツ。グレーのスカートを履いている。グレーのレッグウォーマーをニューバランス992のスニーカーと合わせて履いている。全てお任せします！背景を描いていただけると嬉しいです、でも無理でも大丈夫です。それと、お誕生日おめでとう！\n\nhttps://drive.google.com/drive/folders/1-kgoQh-09FaBYLQAUa7SvMci8KO7vipt?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SirayukiSIU/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1704166, "client_id": 11365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06cbec15/uploads/origins/9ea55dab-18d4-4c9f-8721-9b74ddf7c17d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0325fc382d59c47b8d49e22d155b03d", "srcset": "https://si.imgix.net/06cbec15/uploads/origins/9ea55dab-18d4-4c9f-8721-9b74ddf7c17d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0325fc382d59c47b8d49e22d155b03d, https://si.imgix.net/06cbec15/uploads/origins/9ea55dab-18d4-4c9f-8721-9b74ddf7c17d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55acb932c48b4bd80884eb11cc2b9d34 2x, https://si.imgix.net/06cbec15/uploads/origins/9ea55dab-18d4-4c9f-8721-9b74ddf7c17d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6171850994342f31cb2c9f91ecbf58f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06cbec15/uploads/origins/9ea55dab-18d4-4c9f-8721-9b74ddf7c17d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe676702