様が描きやすい方向で進めていただければと思います。\n\n◇画像サイズ\n横長で製作していただけましたら幸いです。\n\n◇使用用途\n鑑賞、ホーム画面\n\n◇資料\n設定画↓\nhttps://drive.google.com/drive/folders/1zorzwnuLGN72I_-RXCsnFh4ftHPYHFVe\n世界観などのまとめ↓\nhttps://posfie.com/@____n0_0n____/p/MCmWDAa\n\n\nリクエスト内容に問題がございましたらキャンセルしていただいて構いません。ご検討のほどよろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@illu_stra_tion/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2859634, "client_id": 3607083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbe87b19b12b70fd2897255e4ce28ef4", "srcset": "https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbe87b19b12b70fd2897255e4ce28ef4, https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85546a4362bb26e5a87db89b389dab4a 2x, https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3202090924bbd88a49a2d478a319473 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75ea4b1c5c3213a5a66e2950b40eebdb", "srcset": "https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75ea4b1c5c3213a5a66e2950b40eebdb, https://si.imgix.net/9308ec88/uploads/origins/ca400de0-eb23-41de-a2b8-9edf9a26ca97?bg=%23fff&auto=format%2Ccomp