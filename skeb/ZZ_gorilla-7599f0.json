bKS3V5HggDbwvkZRe1QVk2Z6aj?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZZ_gorilla/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 144395, "client_id": 2004074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33a0d741eb0d471f2aa12de97979f57f", "srcset": "https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33a0d741eb0d471f2aa12de97979f57f, https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94e2551bb6fcbfbcb354e63f02571bb5 2x, https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ad45d4698c9f41db63b376d86e1d516 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edf48596bae7e537de6c35739cb888bd", "srcset": "https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edf48596bae7e537de6c35739cb888bd, https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b01650d3e7818370b020c5a9cca0ccfc 2x, https://si.imgix.net/0d4d67c7/uploads/origins/a43c3585-29c8-4ed6-82b2-50c123f3cf98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=22d092b28592a24e8c3838b749a219e5 3x"}, "body": "ごりらさんこんにちは\nいつも素敵なイラスト拝見しております！\n今回友人のPCたちを描いていただけないかと思いリクエストいたします！\n\n▼構図等\nお任せいたします！\nちび・等身大・ポーズなど、イメージしやすいものを描いていただけたら嬉しいです。\n\n▼関係性\n大学時代からの友人/公安警察\nお互いを大切に思っている\n\n▼時代\n現代日本（2040年）\n\n▼キャラクター\n①女性\n身長：165\n年齢：27\n正義感が強いという自覚がある。\n物腰柔らかだが頑固。体力には自信があり。\n趣味がマラソンで、風景写真集を見るのが好き。\n\n②男性\n身長：192\n年齢：27\n普段からニコニコと笑ってる、開眼するタイプの糸目。\n見た目は怖い印象だが話せば割とにこやかで話しやすいタイプ。\n仕事はきちんとこなすが割と適当。\n\n頂いたイラストを共有フォルダなどで一緒に遊んだ人に共有いたします。\n金額が足りない場合再送してもらえると嬉しいです。\nご縁がいただけましたら嬉しいです。ご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Svn8KnBMqgCviww4P89tbl11O156JpN7?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZZ_gorilla/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 144395, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a270ce4b/uploads/origins/24b4b15b-becd-4ae5-90b8-da10b3e80cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd871221e83eeb77c47f0f1938ccf38c", "srcset": "https://si.imgix.net/a270ce4b/uploads/origins/24b4b15b-becd-4ae5-90b8-da10b3e80cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd871221e83eeb77c47f0f1938ccf38c, https://si.imgix.net/a270ce4b/uploads/origins/24b4b15b-becd-4ae5-90b8-da10b3e80cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3988487607c1c8090bbd9f9ec7e605c7 2x, https://si.imgix.net/a270ce4b/uploads/origins/24b4b15b-becd-4ae5-90b8-da10b3e80cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad7d0358228393f10d19c300f268c97d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a270ce4b/uploads/origins/24b4b15b-becd-4ae5-90b8-da10b3e80cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd