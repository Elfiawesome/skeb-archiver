！\n\n基本事由に書いちゃってください！\n大体のお願い内容は以下です\n\n・見切れなし、\n　待ち受けカレンダーにしたいので、上部に少し（10％～）余白をとってください\n・背景透過、\n　→簡単な背景を書いていただけると嬉しいです\n\n・描画範囲（上半身や全身など）\n　→腰上でお願いします。\n・使用用途（サムネ、ネットプリント、など）\n　→スマホ待ち受けカレンダー（1440px×2560px)で考えています\n　　カレンダー素材は以下を使用する予定です\n\nhttps://booth.pm/ja/items/6429871", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Noir_MK2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2905478, "client_id": 3007921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b674594/uploads/origins/e3a7740b-dd08-4cc0-b582-8ef0169ab0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e6ac4b278d393cdbd28ad0042cdacc8", "srcset": "https://si.imgix.net/4b674594/uploads/origins/e3a7740b-dd08-4cc0-b582-8ef0169ab0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e6ac4b278d393cdbd28ad0042cdacc8, https://si.imgix.net/4b674594/uploads/origins/e3a7740b-dd08-4cc0-b582-8ef0169ab0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d9059fc992975d48bf0bcd6dfcf2c56 2x, https://si.imgix.net/4b674594/uploads/origins/e3a7740b-dd08-4cc0-b582-8ef0169ab0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=070f515b5a855ef99bfc5e512abc9468 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b674594/uploads/origins/e3a7740b-dd08-4cc0-b582-8ef0169ab0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00dc5aa142995790fdd363a0f1d1c22b", "srcset": "https://si.imgix.net/4b674594/uploads/origins/e3a7740b-dd08-4cc0-b582-8ef0169ab0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00dc5aa142995790fdd363a0f1d1c22b, https://si.imgix.net/4b674594/uploads/origins/e3a7740b-dd08-4cc0-b582-8ef0169ab0da?bg=%23fff&auto=format%2Ccompress&fm=we