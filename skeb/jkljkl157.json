t=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1617be572582d9b301667710bdb991c8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3281442, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@jkljkl157/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3281442, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2254d71/uploads/origins/f34c0e95-38b1-42f2-a2a2-29004a46c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c34cc9c9c001a2570edcbd92d31c90", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2254d71/uploads/origins/f34c0e95-38b1-42f2-a2a2-29004a46c79a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40afed86a46fc7f206f9410e726f2c4b", "src_set": ""}, "body": "ウマ娘のゼンノロブロイをお願いします。\n\n・衣装：ライスシャワーの勝負服（通常）\n胸が窮屈で胸や谷間等が結構見えてしまっているため、少し恥ずかしそうにしている感じでお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jkljkl157/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3281442, "client_id": 103242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87a0c1b0/uploads/origins/b6ffc034-dbd3-4963-8f18-bfaac7d1130e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b20369b652fafb64a2738af5c1b8482", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87a0c1b0/uploads/origins/b6ffc034-dbd3-4963-8f18-bfaac7d1130e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a15f928cd4ad9561bdfc55b1c368df90", "src_set": ""}, "body": "こんにちは！\nけものフレンズのヘラジカの画像が見たいです。\n私はあなたのゴールドシップをフィーチャーした以前の作品がとても好きで、リクエストに似たものを見たいと思っています。\nhttps://skeb.jp/@jkljkl157/works/3\nヘラジカのボディが映える、ぴったりとしたセクシーなビキニを着ているところを描いてほしいです。ビキニの種類は問いません。\n前の画像で表現できたキュートな自信がとても楽しいです。ゴールドシップのセクシーさを意識せずに、自分の体をアピールしているところが好きです。ヘラジカにも、淫らな姿を意識させないようなポーズをとってもらえるとうれしいです。胸やお尻を少し誇張してもいい。\n湯気や汗も出してもらえると嬉しいです。\nできれば、ビキニを脱いだヌードバージョンもあると楽しい。ただし、これは必須ではありません。\nその他、ポーズや表情は自由です。\nどうぞ楽しんでください。\nありがとうございました！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jkljkl157/works/40", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/03dde11e/uploads/origins/9bf7c2b3-6b57-456a-9777-47bdf0cda711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2eafc944120a062878dfce214807a51c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3281442, "client_id": 3110106, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@jkljkl157/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3281442, "client_id": 639858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64202799/uploads/origins/65617f5c-dc9f-4848-8158-1fcd02ad6b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9131809c641b0f736bdc024693978036", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64202799/uploads/origins/65617f5c-dc9f-4848-8158-1fcd02ad6b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w