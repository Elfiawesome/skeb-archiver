442, "client_id": 34261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1c668ae/uploads/origins/3f53af06-cd15-45cc-add9-c7bec942c78b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61f8e3907ba8aa80e053cdfd8657794b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1c668ae/uploads/origins/3f53af06-cd15-45cc-add9-c7bec942c78b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32415d1cacdd5042345c24c7269d4563", "src_set": ""}, "body": "すけのはさん、はじめまして！百合栖てぃあと申します！\nしっとりとした肉感的なイラストが大変好みなので、是非リクエストさせていただきたく参りました！\n御一考の程、よろしくお願いいたします！\n\n◆キャラクター\nうちの子「ルシェート・プルメリネ」をお願いします！\nおっぱいのおっきなケモ耳ラミアで、天真爛漫な人懐っこさと小悪魔的な性格を兼ね備えるお姫様です。\n詳細は資料URLを参照ください。\n\n◆衣装\nルシェートには幾つか衣装があるのですが、今回は「姫巫女忍」衣装でお願いします！\n衣装デザインについては資料URLの39ページ辺りに御座いますので、そちらからご確認ください。\n\n◆シチュエーション\nふとしたミスで罠を踏んでしまい、起動した罠によって吊り縛り上げられてドスケベボディを無防備に晒されてしまっているシチュエーションでのイラストをお願いします！\n背景は適当でよくて、構図については描きやすいものか描きたいものでおまかせします！胸を強調するかそれともお尻を強調するか、お好きな方で！\nルシェートの表情については罠に引っかかってしまったこともあり、焦っていたり恥ずかしがってるような感じをイメージしてくださると！\n\n最後に、可能な限りで良いので、ルシェートの122センチQカップのデカ乳やお姫様にあるまじきドスケベボディは遠慮なく強調して描いてくださると嬉しいです！\n\n以上、よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/81537442", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 183960, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "✧･ﾟ𝕞𝕒𝕞𝕒𝕝𝕠𝕟𝕚･ﾟ✦", "screen_name": "CRUNCHY_MMLONI", "avatar_url": "https://pbs.twimg.com/profile_images/1508639704425832449/4FZcFyjT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3371164632/1752307634/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 560692, "creator": true, "nsfw_acceptable": true, "acceptable": tru