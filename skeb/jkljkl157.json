db00c80c28c95d761", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/066a916b/uploads/origins/b09b9161-f1bb-497a-8192-abbd646ac41f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b4520df894dea4b77baf8e0bde24132", "src_set": ""}, "body": "いつも先生のイラスト拝見しております。Skeb開設お待ちしておりました。\nキャラはダンツフレームで、衣装は黒バニーと差分でこちらと同じ競泳水着(https://x.com/jkljkl157/status/1818955164537221269?t=7zQF_Kt-rc61N5SQDRcNqQ&s=19)も描いていただけないでしょうか。\nポーズはこちら(https://x.com/jkljkl157/status/1860977017728205302?t=bpNTpy11dfspS33QRetm-g&s=19)のように全身が写っていて脇が見えるものでお願いします。(同じポーズでなくてもいいです)\n先生の描くイラストの光沢感と汗と蒸れている表現がとても好きなので、今回のイラストでも同じように描いていただけると嬉しいです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jkljkl157/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f5a385f7/uploads/origins/ad218eea-7749-4432-a38e-5766a5504fa6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c5264eac94d0bd4aa540518a88faa7b7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3281442, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@jkljkl157/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3281442, "client_id": 135898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/957b0928/uploads/origins/c1cf9626-8474-4377-9cd8-e0954343e410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c8dfbaf1dbaca1b333b10733c91c6d6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thu