33wcAn9TuOgzWvpuHL5U?usp=sharing\n\n余談ですが、肌色の場合は、素材よりも少し青色で、髪色の場合は人間時代の色を保つように若干の色変更をお願いしたいと思います！\nまた、ポーズの場合、4つの手のうちの1つは自分の性器に触れ、1つは舌に触れ、残りの2つの手は繭を剥がし、自分の繭から出てくる姿をお願いしたいと思います！\n\n繭内部の粘膜とかセシルの体液のため少し湿った感じのような描写もお願いします！\n\nできれば本当にありがとうございます！よろしくお願いします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamatamalaunch1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1094669, "client_id": 1533762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd01d06694f1b9598fbe57393c297db", "srcset": "https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd01d06694f1b9598fbe57393c297db, https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a39566f09419d838c647501acae0df0 2x, https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2825fac0b0aca87c4a4a6d8434793876 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc698dd462741f2c858987a781edf059", "srcset": "https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc698dd462741f2c858987a781edf059, https://si.imgix.net/b997e666/uploads/origins/258de295-e052-48f4-8aa9-0008647bff3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c