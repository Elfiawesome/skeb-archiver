9130-c339cd962cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28635dc201c8de81632f2f5b816f3490, https://si.imgix.net/f69e5f44/uploads/origins/4e102f65-8487-4f30-9130-c339cd962cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc9ab0aa83915ea7bb1d91ad3fb93701 2x, https://si.imgix.net/f69e5f44/uploads/origins/4e102f65-8487-4f30-9130-c339cd962cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0473d61896405ae07188efe5187f830 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f69e5f44/uploads/origins/4e102f65-8487-4f30-9130-c339cd962cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7f93028a142372796ae4ff8d6f501be", "srcset": "https://si.imgix.net/f69e5f44/uploads/origins/4e102f65-8487-4f30-9130-c339cd962cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7f93028a142372796ae4ff8d6f501be, https://si.imgix.net/f69e5f44/uploads/origins/4e102f65-8487-4f30-9130-c339cd962cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=097685310c7e5fe60e1bd460ce4256bd 2x, https://si.imgix.net/f69e5f44/uploads/origins/4e102f65-8487-4f30-9130-c339cd962cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff5fd33097fad47f1a9abb77813299bb 3x"}, "body": "お世話になっております！鈴藤です。\nちいさいいのちのskeb募集と言うことで、つなごっちさんに是非自陣を描いていただきたいと思いリクエストさせていただきました。つなごっちさんの描かれるちいさいいのち、かわいくて大好きです💕\n\n\n今回リクエストするのは「ようこそ！迷冥市役所都市伝説課へ！」の探索者です。\n\n【使用用途】\n・個人鑑賞\n・相方へのイラスト共有\n・Xのアイコンへの使用\n・ココフォリア部屋への配置\n\n立ち絵はリンク先にまとめていますので、そちらを確認していただければと思います。\n構図などはすべておまかせします、描きやすいように描いていただけたら幸いです！\n\n金額不備などありましたら再送しますのでご検討いただますと幸いです、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1do7CZq4hD3i5L9hZesWi-s9COi6KSeZa", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumyum_tuna/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3148566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b2abe973aae54e85fe6918ca7cffb19", "srcset": "https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b2abe973aae54e85fe6918ca7cffb19, https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac845aaeba46ec2342f9689a5e1a200b 2x, https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db0e095b74d8dd11a01891ba25570d43 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d86cfd4644e4aef79cccba6079da8546", "srcset": "https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d86cfd4644e4aef79cccba6079da8546, https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb75bd29a4d495726f181af2e929c886 2x, https://si.imgix.net/eb7d69d2/uploads/origins/1e0679f0-305b-4f6c-b0b2-eb6b7a89d7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3942634fd0531236691320151cfcc7c3 3x"}, "body": "つなごっち様\n\nはじめまして、お豆と申します！\n以前より、描かれている立ち絵を拝見し、いつかご依頼する機会をうかがっておりました。\n\nが、このたび小さき命を募集しており、\n「いつも美麗なイラストなのに、ちいさき命まで！？」と驚いてしまいました。\n\nもしよろしければ、友人の概念ミニキャラを描いていただけないでしょうか？\nキャラデザインなどはなく、要素は下記になるのでお任せしてもよいでしょうか？\n\n［依頼内容］\n・概念ミニキャラ（マスコット）\n・友人へのプレゼント、共有\n・完全個人利用での個人グッズの作成（キャラ印刷ハンカチなど自分用に）\n\n［詳細］\n・モチーフ：椿、のうみそ、和、狐、お面\n・性格：がんばりや、まじめ、たのしいことがすきだが常識人\n\n［その他］\n仲間四人のうちの一人にプレゼントします。\nうち二人は既に自分の概念があり、「枝豆」と「菖蒲＋ポメラニアン」の生き物になります。参考としてファイルを格納させていただきます。サイズ感としては、「ポメラニアンちゃんと同じ大きさか、少し小さいくらい。枝豆ちゃんよりは大きい」を想像しています。\n\n以上となります。\nモチーフなども大変ざっくりとしているので、使いやすいものから取捨選択していただいて構いません。\n是非、描きやすいように描いてくださいませ！\n\nまた、難しいと判断されましたら遠慮なくお断りください。\nこれからの活動を応援しております！\n\nhttps://drive.google.com/drive/folders/1OFC9hbmfPILqChnUj63QERz9f0vFw0dE?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumyum_tuna/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3148566, "client_id": 619588, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20a0f12d/uploads/origins/b180f676-ed5f-44ba-a3ca-121f04158293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c3beda146d857b666da47b4eb7bcae", "srcset": "https://si.imgix.net/20a0f12d/uploads/origins/b180f676-ed5f-44ba-a3ca-121f04158293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35c3beda146d857b666da47b4eb7bcae, https://si.imgix.net/20a0f12d/uploads/origins/b180f676-ed5f-44ba-a3ca-121f04158293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14a0aca23ae08b4ed6969bc029ddf4cc 2x, https://si.imgix.net/20a0f12d/uploads/origins/b180f676-ed5f-44ba-a3ca-121f04158293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fcad88a53b9db55ac3642eadcca59ec 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20a0f12d/uploads/origins/b180f676-ed5f-44ba-a3ca-121f04158293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcdbbacac3f801fc9ca35657ff61139e