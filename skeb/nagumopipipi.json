&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcde057271ed7ed98ef90f3b0336f92a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2617334, "client_id": 1977880, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nagumopipipi/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2617334, "client_id": 2102987, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5e54335/uploads/origins/aba88416-1751-47de-b92e-d7cc1724c8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f22e96905a8542f0602e0d292382050", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5e54335/uploads/origins/aba88416-1751-47de-b92e-d7cc1724c8cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9a9dd3916a9a7514e1a49ad13beb5ef", "src_set": ""}, "body": "こんにちは！アピールをありがとう！\n\n自由に描いてください。お任せします！\n\nhttps://drive.google.com/file/d/17JJn9qA9_avpLRCc1uZel3org46daUrR/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagumopipipi/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2617334, "client_id": 978888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46a8ad99/uploads/origins/d8eebc17-11f2-4af9-94ef-9900803191cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22974c92a497623b4fa38c725f56048c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46a8ad99/uploads/origins/d8eebc17-11f2-4af9-94ef-9900803191cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6918a9228d91c3b9be3253ad2433d6f4", "src_set": ""}, "body": "はじめまして、なぐもさん、こちでアピールが受け取りしました。うちもミハイルちゃんの機械魔法使いのネタと帽子のデサイーが自慢です、なぐもさんもこの細部が好きで嬉しいです。この服は実は彼女の学生時代の制服で自力改造したの産物です。自分の学歴と個人個性を改造した制服から展示するで、うちの魔法使いたちの習慣とうゆことです。\n\nつまり、ギャップ感のイラストがどういますか。なぐもさんの背景絵はいつもキャラの個性をいい表現したとおもいます。だから、うちの提案はこれこそです：\n\n１．通常の服のミハイルちゃんが描きますで、エレガントなお嬢様ぽいの感じを表現する。\n２．背景絵の部分で機械マニアの感じで表現する（歯車や、銃や、その他の機械ものや、等しい）\n\nこの二つがうちからの要望です。よろしくお願いいたします。\n\nhttps://imgur.com/a/IA1P8P9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagumopipipi/works/110", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2617334, "client_id": 1746714, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf4dfc31/uploads/origins/0b0e6000-2a42-4711-976a-a96261dafbd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=043877514fbb44a58b5414036c7d37a5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf4dfc31/uploads/origins/0b0e6000-2a42-4711-976a-a96261dafbd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=752baf058cb86ab98ced79fd31104259", "src_set": ""}, "body": "こんにちは、なぐもさん。\nあなたの絵が大好きです。私のOC、リアンを描いてほしいの。彼女は乙女ゲームが大好きで、特徴的な色はオレンジです。彼女の髪はオレンジのグラデーションでふわふわしています。服装は2色から選べますが、どちらでも構いません。ポーズも自由です！\n\nhttps://drive.google.com/drive/folders/1sh0WL3v3tmepmxqmJ3kv_0NLn5Dyj25m?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagumopipipi/works/109", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2617334, "client_id": 2118903, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f221d1d/uploads/origins/49404dfc-78ac-4fb0-a756-026e0