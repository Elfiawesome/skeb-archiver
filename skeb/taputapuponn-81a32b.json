以上になります\n書きにく所などがあったら改変していただいて大丈夫です。\n追加要望があり大変申し訳ございません。\n検討の方をよろしくお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taputapuponn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3707836, "client_id": 1205407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26232c7ab7efe949907e9302220278fe", "srcset": "https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26232c7ab7efe949907e9302220278fe, https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff552057190ba47fb034250cfd19db9e 2x, https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=096a8593af6c2870369c159efcab1ad1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72c48b6540155b4762c716a1d0b2988a", "srcset": "https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72c48b6540155b4762c716a1d0b2988a, https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=793c144d0c101e22d2931a54b9e3e012 2x, https://si.imgix.net/81dff746/uploads/origins/a2d17639-e36e-4738-891e-dc1c1a290a17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f731c56a701e4d3951c3f8a001dd888f 3x"}, "body": "はじめまして！　悪目さんのオナホシリーズにはいつもお世話になっております。性器解説の作品を拝見し、私もリクエストさせて頂きたいです。\n\nリクエストキャラ:相沢美零さん　(二人以上描いて頂ける場合、相模加奈さん、吸魔族の隠滅師さん)\n\n型式としましては、書きやすいようにして頂ければ幸いですが\n\nhttps://www.pixiv.net/artworks/137025219\n\nhttps://www.pixiv.net/artworks/110384042\n\n上記のような、立ち絵に身体の使い心地、気持ちのいいポイントがあるスタイルでお願い出来ればと思います。\n\n金額的に不満がなければですが、ご一考頂ければと思います。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@taputapuponn/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3707836, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab9abe4c/uploads/origins/3da75f8b-4628-41fe-8847-9d662008cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c76ae83cdee70eb138be836b2cbc2bb", "srcset": "https://si.imgix.net/ab9abe4c/uploads/origins/3da75f8b-4628-41fe-8847-9d662008cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c76ae83cdee70eb138be836b2cbc2bb, https://si.imgix.net/ab9abe4c/uploads/origins/3da75f8b-4628-41fe-8847-9d662008cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=604cf23eea3a09af8f70fe7a6dd2f913 2x, https://si.imgix.net/ab9abe4c/uploads/origins/3da75f8b-4628-41fe-8847-9d662008cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b936d8ba5f44d7ebf90b7dbbd21183a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab9abe4c/uploads/origins/3da75f8b-4628-41fe-8847-9d662008cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0490861baec2316b7851d76587fd2b55", "srcset": "https://si.imgix.net/ab9abe4c/uploads/origins/3da75f8b-4628-41fe-8847-9d662008cc0d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0490861baec2316b