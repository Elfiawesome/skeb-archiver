をしている。\n_サンプルボイス_\n「こんにちは〜私はめとるだよ」\n「依頼〜？暇だっ受けてあげるよ〜」\n「巴弥〜仕事の寄り道でお茶してかない？」\n\nどうか、ご検討の程よろしくおねがいいたします。\n\nhttps://drive.google.com/drive/folders/1TAVWeC6N05_EdANVbvOocq1609WuDLgz", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M0U10lV/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3794173, "client_id": 3563322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81abf98c/uploads/origins/5dd574b2-b7c2-4d75-8782-b952a6897582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc3ae11e0e5c90a0313353a38b83adf0", "srcset": "https://si.imgix.net/81abf98c/uploads/origins/5dd574b2-b7c2-4d75-8782-b952a6897582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc3ae11e0e5c90a0313353a38b83adf0, https://si.imgix.net/81abf98c/uploads/origins/5dd574b2-b7c2-4d75-8782-b952a6897582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f313dc0f0ce344a65358d16509c918fd 2x, https://si.imgix.net/81abf98c/uploads/origins/5dd574b2-b7c2-4d75-8782-b952a6897582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=048855800c839579b9d773758228d30c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81abf98c/uploads/origins/5dd574b2-b7c2-4d75-8782-b952a6897582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b510c4653fb8be5d826feb972f5fe1e", "srcset": "https://si.imgix.net/81abf98c/uploads/origins/5dd574b2-b7c2-4d75-8782-b952a6897582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b510c4653fb8be5d826feb972f5fe1e, https://si.imgix.net/81abf98c/uploads/origins/5dd574b2-b7c2-4d75-8782-b952a6897582?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96ba79bdf3456efe25c43dea7186327d 2x, https://si.