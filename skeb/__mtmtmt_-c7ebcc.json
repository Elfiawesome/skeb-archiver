常的な衣装を着せて欲しいです、残りは気楽に自由にやってください！\n金額や問題がありましたらお手数おかけしますが再送要望やキャンセルいただければと思います。 ご検討のほど、よろしくお願いいたします、ありがとう。\n\nhttps://drive.google.com/drive/folders/1-X0ZxnrlJvY9j1lwpcMMvdg4HCulvIH-", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 881, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みるお", "screen_name": "milleoxox", "avatar_url": "https://pbs.twimg.com/profile_images/1225312996622159872/2us1U7__.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2775804750/1607276190/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 2375585, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "1CH10🍖skebカキマス🖋", "screen_name": "orginval", "avatar_url": "https://pbs.twimg.com/profile_images/1575886837570490369/N5m_xai7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/982204924602736646/1664555686/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 177}, {"id": 2613680, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "無法地帯", "screen_name": "es_tra_", "avatar_url": "https://pbs.twimg.com/profile_images/1690586158722654208/GMb-U8TP.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 2724903, "creator