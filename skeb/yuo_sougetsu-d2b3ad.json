54734220db4d4d624 2x, https://si.imgix.net/a4b5dfc1/uploads/origins/16bb0d10-3083-4cd1-b5d7-f0508c357a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e5bc83c0fa521381bc0f082fc43b0fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4b5dfc1/uploads/origins/16bb0d10-3083-4cd1-b5d7-f0508c357a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f03f902d56623db70d6bb9c9d5546f21", "srcset": "https://si.imgix.net/a4b5dfc1/uploads/origins/16bb0d10-3083-4cd1-b5d7-f0508c357a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f03f902d56623db70d6bb9c9d5546f21, https://si.imgix.net/a4b5dfc1/uploads/origins/16bb0d10-3083-4cd1-b5d7-f0508c357a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=18aa2bd03c00ab7d24c5b24f4b21550f 2x, https://si.imgix.net/a4b5dfc1/uploads/origins/16bb0d10-3083-4cd1-b5d7-f0508c357a9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b258b1236db2184868decfdcbcc1658f 3x"}, "body": "蒼月ゆお様、初めまして！\nイラストを拝見しまして是非ご依頼をしたく思い、リクエストさせていただきました！\nこの度依頼したいのは私が推している個人Vtuberのメラ・アカル(https://twitter.com/mela_akaru)さんです\n\n【構図】\n-衣装\n・和服（黒と赤を基調とした花魁風）\n・煙管持ち\n\n-髪型・化粧\n・伊達兵庫髷\n・白粉は不要（元々色白であるため）で紅のみ\n\n-背景\n・座敷\n\nその他のお任せでお願いしたく思います\n\nまたSNSでの宣伝やサムネで使用をして頂きたいので、使用許可及びキャラクターだけの透過pngかPSDデータを頂けますと嬉しいです\n\nメラさんの資料\nhttps://x.com/mela_akaru/status/1713117649436324244?s=46\nhttps://twitter.com/mela_akaru/status/1826199330711363643\nデフォルト衣装で確認出来ますが小さな赤い角があり、先日公開された新衣装モデルでは角が大きくなっております\n\nご本人様よりの許可等はこちら（注意事項の項目）に記載があります\nhttps://profcard.info/u/mdgGtzOxFHXKC29CWvc7uE6C34u1\n\nご多忙とは思いますがご検討のほどよろしくお願いします！\n\nhttps://x.com/mela_akaru/status/1548270690004250624", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuo_sougetsu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1763062, "client_id": 3056971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08e6e4e2c68a1353fabfba1949437451", "srcset": "https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08e6e4e2c68a1353fabfba1949437451, https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3f4e6c2a0cdbac16e757bd34917e793 2x, https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64cd0e2f56098e15293058d2e08aa50c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39876fb5e43373a63d56b1109d0b7fa9", "srcset": "https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39876fb5e43373a63d56b1109d0b7fa9, https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37a6db263db963c90ddee5ac48517f75 2x, https://si.imgix.net/fe0d4655/uploads/origins/a1d95d39-bf80-472b-890c-57ba7e69e5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec5f495a7367ae0dae6433648b82999a 3x"}, "body": "初めまして\n蒼月ゆお様の和の雰囲気のイラストに魅せられました\n是非、私の推しを描いていただきたいと思い二次創作のリクエストします\n\n\n【人物】\n個人Vsingerの蒼星すい(@aoisui_)様を描いていただきたいです\n話し声と歌声にギャップが魅力で、お姿も宝石のように輝いてキレイな方です\n二次創作OKです(参考資料のHPのリンクにガイドライン記載)\n\n【構図】\n-衣装\n・和服（おまかせ）\n・番傘を差している\n\n-髪型等\n・ポニーテールにアレンジ\n・ケモミミとシッポあり\n\n-背景（背景ありなしはおまかせします）\n・紅葉舞う秋\n\nその他の構図はおまかせします\n\n\n【使用用途】\n・蒼月ゆお様を明記の上、蒼星すい様のタグを付けて投稿\n・蒼星すい様のみの活動(サムネやネットプリント等)での使用と蒼星すい様にデータの譲渡の許可をお願いします\n\n\n【納品形式】\n・蒼星すい様が使用しやすいように人物・背景のレイヤー分けのｐｓｄファイルで納品していただけるとありがたいです\n・ｐｓｄファイルが不可の場合はｐｎｇでお願いします\n\n\n【参考資料】\n雰囲気を掴んでいただくために衣装とカバーMVの再生リストも添付しています\nすみませんが三面図は見当たりませんでした\n\n\n構図指示や金額等至らない点がありましたらお手数ですが再送指示をしてください\nご検討の程よろしくお願いいたします\n\nhttps://docs.google.com/spreadsheets/d/1zw9MdKWySkYfByQmxoqFz9TviWhVY7-1nCYmtHgMqfQ/edit?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuo_sougetsu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1763062, "client_id": 2558266, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e63d158d9f113b909aa83c1c24678e3", "srcset": "https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e63d158d9f113b909aa83c1c24678e3, https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8746afc43527acb60f6d552b08bea6c0 2x, https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7ce246748047b4d9bef4b2988ea2bda 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df727f33dd59d5a8b79a88df29251b1f", "srcset": "https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df727f33dd59d5a8b79a88df29251b1f, https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9600763ce887a57357070ebd25d3d538 2x, https://si.imgix.net/e643aca1/uploads/origins/bfdb507a-7cc9-4247-8866-1887d0a6f641?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=02cdcddf9d38f52a040e7c0efefe9887 3x"}, "body": "はじめまして！！\n和服姿が素敵な透明感溢れるイラストに惹かれ連絡させて頂きました！！\n\n今回お願いしたいイラストは\n和服の花嫁衣裳....です！\n白無垢よりも明るい柄や色の和服だと嬉しいです！\n\n見た目はTwitterのURLを記載させて頂きます！\n複数の見た目のものがあるので\n髪型などはお任せ致します！\nショートでも\nロングで髪の毛を結っていていても大丈夫です！\n\n髪色は銀髪で\n目の色はピンク～赤に近い瞳となっております！\n目の中に小魚が泳いでます！！\n\nアイコンや配信サムネイル、ヘッダーなどに使用予定です！\nなので、人物の横や頭が見切れないようにして頂きたいです！！\n\nまた、FANBOX加入者のみにおそろいヘッダーや壁紙として配りたいとも思っております🙇(可能であれば)\n\nまた可能であれば下記をお願いしたいです\n・いくつか表情差分\n・背景がある場合は背景と人物を分けたパターンでお願いしたいです\n・人物は透過\n\nよろしくお願いします🙇‍♀️\n\nhttps://x.com/amane_none/status/1779419247732809909?s=46&t=rya1z-0E1b10_3B7ypBwOA", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuo_sougetsu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1763062, "client_id": 196005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b12d6b7/uploads/origins/47be969e-78b1-433b-908c-1c701fd741f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=391ba58c6832e3e277e68a80968eb02b", "srcset": "https://si.imgix.net/5b12d6b7/uploads/origins/47be969e-78b1-433b-908c-1c701fd741f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=391ba58c6832e3e277e68a80968eb02b, https://si.imgix.net/5b12d6b7/uploads/origins/47be969e-78b1-433b-908c-1c701fd741f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&