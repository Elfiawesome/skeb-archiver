いバージョンをお願いしたいです。\n\nフード付き\nhttps://sindorei.eu/kina4.png\n(耳はフードの穴から出しています)\n\nフードなし\nhttps://sindorei.eu/kina5.png\nhttps://sindorei.eu/ref/kinatail2.jpg （ポニーテールの長さはこのくらいで、背中の半分くらいまでの長さ）\n\n彼女の耳をとても長くしてください。ちゃんとしたエルフの美しい耳です。\n彼女のベルトからぶら下がっている2つの小さな黒いポーチを追加してください。\n\n可能であれば、このようなアクションポーズをお願いします。\nhttps://sindorei.eu/ref/kinabow.jpg\nhttps://sindorei.eu/ref/kinabow2.jpg\nhttps://sindorei.eu/ref/kinabow3.jpg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Gwine_55/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3182814, "client_id": 2031015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ca24de5/uploads/origins/e08f3538-7bb6-41c3-80dd-60a21d18e74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabd7c521001aaa26191a19ecaf30a1a", "srcset": "https://si.imgix.net/8ca24de5/uploads/origins/e08f3538-7bb6-41c3-80dd-60a21d18e74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eabd7c521001aaa26191a19ecaf30a1a, https://si.imgix.net/8ca24de5/uploads/origins/e08f3538-7bb6-41c3-80dd-60a21d18e74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ea50e17b7cd2138a7ad6a9a9a6f6e58 2x, https://si.imgix.net/8ca24de5/uploads/origins/e08f3538-7bb6-41c3-80dd-60a21d18e74c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a1e020a7d006c777c48304447c016f2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ca24de5/uploads/origins/e08f3538-7bb6-41c3-80dd-60a21d18e74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd855e004db6e3c39fb5100d16ae37ea", "srcset": "https://si.imgix.net/8ca24de5/uploads/origins/e08f3538-7bb6-41c3-80dd-60a21d18e74c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd855e004db6e3c39fb