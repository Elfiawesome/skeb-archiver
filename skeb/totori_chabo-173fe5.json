」を描いて頂きたいです。\n\nキャラクター設定としては\n\n黒澤　光雷（くろさわ　みらい）\n\n年齢：18歳\n身長／体重：166cm／54kg\nスリーサイズ：83／59／83\n\n電気・雷属性の魔法が使えるファンタジーな世界のちょっと強気な性格のポニーテールの女の子。\n強気な性格ではあるが本人は平和な世界が大好きで、平和な街の日常を散歩して見て回るのが趣味だったりする。\n少しツンデレ気質で正直に褒められると少しだけ照れる。\n\nポーズや構図はお任せいたします。\n\nキャラクターデザインはこちらです。\nhttps://drive.google.com/drive/folders/1-2EWfAfZ8BoDA6NQ6T84sryO9rf7Bf8x\n\nご縁があったらよろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@totori_chabo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3430764, "client_id": 3620563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/656e933f/uploads/origins/c6a28b32-1d94-4574-b053-9d6c112c06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=587e9d5cc0a551ce6d09593e38e4246b", "srcset": "https://si.imgix.net/656e933f/uploads/origins/c6a28b32-1d94-4574-b053-9d6c112c06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=587e9d5cc0a551ce6d09593e38e4246b, https://si.imgix.net/656e933f/uploads/origins/c6a28b32-1d94-4574-b053-9d6c112c06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=399791fa9a9c67ed8a661ba6c0253e60 2x, https://si.imgix.net/656e933f/uploads/origins/c6a28b32-1d94-4574-b053-9d6c112c06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1816cf54460aadd5703137ba8bec47ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/656e933f/uploads/origins/c6a28b32-1d94-4574-b053-9d6c112c06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=236af05fe0c150fe0a0c8d3fcb9c28a0", "srcset": "https://si.imgix.net/656e933f/uploads/origins/c6a28b32-1d94-4574-b053-9d6c112c06c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=236af05fe0c150fe0a0c8d3fcb9c28a0, https://si.imgix.net/656e933f/u