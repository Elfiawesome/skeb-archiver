op=top&w=200&h=200&blur=200&s=2c68240716580e0a568654c7e43fcd2a 3x"}, "body": "こんにちはです。\n今回うちの子のフィールを描いて頂くリクエストさせていただきます。\n\n以下の特徴があります\n・研究員\n・身長3m（最小身長）サイズ可変可能\n　最大身長は太陽300個分\n・耳に惑星のイヤリングを付けており、メガネを付けていて色は赤色。\n・髪型は緑色でポニーテール、ヘアピンを付けており、色は赤色\n・目はツリ目で色は緑　\n・胸の大きさはヘソが隠れるほど大きく、なおかつ胸の成長は止まっていない。\n・服は研究員の服装をしているが、胸の関係上白衣は前開きで着ている。\n・中に特注品のワイシャツを着ているが、胸がでかすぎて胸辺りのボタンが今にも飛びそうになっており、隙間から胸が見えている。（第一ボタンと第二ボタン辺りのボタンは外している。）\n・社員証を首から下げているが、谷間に入っているため外見からは紐しか見えない。\n・感情は薄目で淡々と話すが、優しく接してくれるお姉さん（20代後半想定）\n・感情について研究しており、他の人の感情を見ながらレポートを作成している\n・栄養剤等の成長効果を何十倍にも受ける体質持ち\n\n・シチュエーションは成長薬を飲んでしまい、胸が急激に膨らみ続けていくのをお願いします。\n・胸の大きさはどこまでも大きくしてよいです。（大きければ大きいほど良い）\n・念のためNSFWは付けますが本番系は無しでお願いします。\n\nまた描いた頂いた絵は資料として使わせていただいたり、\nSNS等に載せます。\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1nPvia9BbN6qxZfCpCQmvzZ9m4Z0yNZRz?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amazake_horida_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3025804, "client_id": 2758563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/322ab1f2/uploads/origins/68c7cdd1-523f-4367-b7c0-c13875bda597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b06d9ad6b8c3d5a988f0cc4fc549cad", "srcset": "https://si.imgix.net/322ab1f2/uploads/origins/68c7cdd1-523f-4367-b7c0-c13875bda597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b06d9ad6b8c3d5a988f0cc4fc549cad, https://si.imgix.net/322ab1f2/uploads/origins/68c7cdd1-523f-4367-b7c0-c13875bda597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34f7977118db44c95933649d2e5dcf15 2x, https://si.imgix.net/322ab1f2/uploads/origins/68c7cdd1-523f-4367-b7c0-c13875bda597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85899b189293673d850f8faa98651547 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image