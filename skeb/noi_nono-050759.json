。  \n元の衣装の要素を拾っていただいても、完全にオリジナルのデザインでも大丈夫なので、構図やポーズも含めてののい様のセンスで自由に描いていただけたら嬉しいです。\n\nもし可能であればキャラクターと背景を分けて納品していただけますと幸いです。難しい場合は統合されたデータでも問題ございません。\n\nお忙しいところ恐れ入りますが、ご検討いただけますと嬉しいです🎀\n\nhttps://drive.google.com/drive/folders/1Q1d-gCuYelLyWcjfOeucYkhkysLhPIOe", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1357217, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "yrb🥨", "screen_name": "Y0323_", "avatar_url": "https://pbs.twimg.com/profile_images/1697117270177353728/cs23jSgw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1110538805604343809/1681615901/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1515489, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "哀愁", "screen_name": "a___2943", "avatar_url": "https://pbs.twimg.com/profile_images/1627960307162427394/TaeoyHrC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1510304374006095874/1667912120/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 129}, {"id": 2491948, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "きさらぎ", "screen_name": "uodaxz", "avatar_url": "https://pbs.twimg.com/profile_images/1994043715363721217/LLNDzFSU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1816475993529565184/1764252055/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank":