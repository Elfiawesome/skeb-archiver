5-9eff-e06dbcd072af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bb7c889502709043d512ee77efbcf2c", "srcset": "https://si.imgix.net/f010e692/uploads/origins/be758992-03d1-4565-9eff-e06dbcd072af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bb7c889502709043d512ee77efbcf2c, https://si.imgix.net/f010e692/uploads/origins/be758992-03d1-4565-9eff-e06dbcd072af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=498853417b3f33c70710ab67c615b264 2x, https://si.imgix.net/f010e692/uploads/origins/be758992-03d1-4565-9eff-e06dbcd072af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c1eb09c7b825e41534bb9f0e6e325fc9 3x"}, "body": "またまたこんにちは。\n\n\n前回描いていただいたイラストがとても気に入ったので、今回は大きくリクエストさせていただきます。まだ1つ足りないのですが、後日改めてリクエストさせていただきます。\n---\n\n[アーティフィサー】「キャラクター」＋「マウント」。アイデアフォルダです。\n\n[モンク】の場合］\n- \"キャラクター\"＋\"フレンド\"（＋リュックサック）\n- \"フレンド\"（ピンクの毛皮の生き物）。リュックサックの中から顔を出す（アイデアフォルダ）。\n- キャラクター」の髪を白にすることはできますか？\n\n[ドルイド】「キャラクター」は若いゾウです。アイデアフォルダです。\n\n[ソーサラー] 「キャラクター」は小さなウサギです。アイデアフォルダ\n\n[ローグ】「キャラクター」が誰かを威嚇（カベドン）している。暗い服装が好ましい。アイデアフォルダ\n\nhttps://drive.google.com/drive/folders/1_nRFb9Wtpq974MS4sUO2eza1Dqq-juCm?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raune_030/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1780699, "client_id": 1805398, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2bebc40/uploads/origins/5cef4c68-655e-439c-aa20-62f027e7db49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aee66e25854e3b8e98d57c17f96d79cf", "srcset": "https://si.imgix.net/e2bebc40/uploads/origins/5cef4c68-655e-439c-aa20-62f027e7db49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aee66e25854e3b8e98d57c17f96d79cf, https://si.imgix.net/e2bebc40/uploads/origi