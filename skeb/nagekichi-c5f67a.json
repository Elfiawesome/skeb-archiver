f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc5f208121e47d04b33efc75d21357fc, https://si.imgix.net/3075a0fd/uploads/origins/dee6a8f2-750d-4487-8cb0-d171e4ee1d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec376cf846c000e96ada735da03ac58f 2x, https://si.imgix.net/3075a0fd/uploads/origins/dee6a8f2-750d-4487-8cb0-d171e4ee1d8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3551f278da268dc64f46c3d1058df4b 3x"}, "body": "こんにちは。私のオリジナルキャラクター（OC）を描いていただけませんか？彼は追放を余儀なくされた騎士です。他人への信頼を失い、生計を立てるために懸賞金稼ぎをしています。構図は自由ですが、彼には冷たい表情をつけてください。武器は背中に鞘に収めた状態で描いてください。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1Kus1GwiVndyp9wMpqwljmfO3-KvBtbmb", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagekichi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3615980, "client_id": 2304222, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7240d465e5c296cba8c301b99c189858", "srcset": "https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7240d465e5c296cba8c301b99c189858, https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7b8e591f18b4e0a4bd9b31313a4f10f 2x, https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27268c7316689122e5ac2032a158e535 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3def8414494786b688611e966b3e143", "srcset": "https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3def8414494786b688611e966b3e143, https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=01902271b5e2ee6f141f701b99fb1511 2x, https://si.imgix.net/741d3062/uploads/origins/66466305-c46c-48fa-9bdb-14411462a7b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=694988288974231d826e99133f2edf83 3x"}, "body": "こんにちは！あなたの作品に漂うダークな雰囲気とユニークなアートワークにとても惹かれました。もしよろしければ、私のオリジナルキャラクター「ゾルグル」を描いていただけないでしょうか。\n\n彼はオークですが、司祭でもあります。見た目は荒々しいですが、心は驚くほど優しく、長年にわたる戦争で家族や多くの友人を失ったという重荷を背負っています。彼は「光」という、どんな傷も癒やし、罪を懲らしめることのできる、天使のような姿をした異世界の魔法を使います。 \nその優しさと主に癒し手としての役割にもかかわらず、彼はどんなに厳しい世界であっても、守れる者、救える者をすべて守り抜くという強い決意を持っています。呪文使いのように戦うこともできる一方、聖職者のように片手メイスを使うこともできます。時には、魔法によって天使のような姿に変身することもあります。\n彼のモットーは、「闇に光をもたらす、松明を掲げる者たちは祝福される」というものです。\n\n服装はお好きなものを選んで描いていただいても、オリジナルの衣装を考案していただいても構いません。ポーズも自由です。\n\n参考URLには、彼のインスピレーション、装備、外見、魔法に関する必要な情報がすべて掲載されています。\n\nお読みいただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1-QSgHOLnM0JByUEqyVOe5PMLDPQdiwYv", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagekichi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3615980, "client_id": 2850125, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f326ffafcb597c98e12e05d987decd55", "srcset": "https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f326ffafcb597c98e12e05d987decd55, https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c250eb2c4682df0f1dc2a0417a5b8142 2x, https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=548a300308ddc915fdc784fcb2b10147 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca71423ba8a725f76802401f61f560b", "srcset": "https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca71423ba8a725f76802401f61f560b, https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95427d78bb907713ec0eb6a5d87dd900 2x, https://si.imgix.net/aee470ba/uploads/origins/f5e1b7a4-a3c8-4ffd-a8f9-2e4e3de811e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c955ce2d7f4fb452406c3cb18b96663d 3x"}, "body": "こんにちは！\nあなたのアートスタイルの大ファンで、私のオリジナルキャラクター（OC）のイラストを依頼できればと思っています！\n彼はかなりエッジの効いたウォーロックキャラクターです！もしよろしければ、少しアクションシーンの構図にしていただきたいです！血やそれに類する描写も全く問題ありません！\n\nまた、彼はモンスターに変身する能力も持っているので、その要素を取り入れていただけると嬉しいですが、もちろん必須ではありません！ \n\nこちらに、彼の参考画像がすべて入ったフォルダのリンクがあります：\nhttps://drive.google.com/drive/folders/1XJ5-PWAdArj3nVnl8xnu9_xEZlXxhbh2?usp=sharing\n\nご検討いただき、誠にありがとうございます！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagekichi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "ar