t=crop&crop=top&w=200&h=200&blur=200&s=54e4bd243a225aaefa91639ee2b1210b", "src_set": ""}, "body": "FGOに嫁母を名乗る不審サーヴァントことロウヒちゃんが出てきたのでリクエストです\n\n大体の流れ：ロウヒがぐだ子に生やして子作りを迫って中に出させる\nロウヒは１臨か２臨、ぐだ子は非リヨ時空の方でお願いします。\nちんちんは小さめでかわいい感じを希望です。\n\n娘がカルデアにはいないから、嫁候補として新しい娘をこさえるんだよ、と襲いかかる流れで、ぐだ子の方もなんだかんだでまんざらではない感じでお願いします。\n\nコトが終わった直後の姿のまま照れ隠しに、「嫁の母親と浮気するだなんて、悪いムッコはお仕置きだぁよ！」みたいに本場のガンドをぶちこんでくるバーサーカーなギャグ風オチ", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noshigamin/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1732766, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d2caf83/uploads/origins/a031ad24-1b13-4dc4-b0be-4bc3ae796148?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b194a08dfb53f8d1e59b91346a30d49d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d2caf83/uploads/origins/a031ad24-1b13-4dc4-b0be-4bc3ae796148?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b87d42fb6780ac66f689ce50112eca", "src_set": ""}, "body": "水着徐福ちゃん（２臨で帽子なしのやつ）がフレンドリーにマスターさんの童貞捨てさせようと誘惑してくるところをお願いします。\n水着の下は脱げてて、\n「マシュちゃんとヤる時に失敗したくないだろ〜？」みたいな軽いノリなやつを希望します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noshigamin/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1732766, "client_id": 670108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24f44696/uploads/origins/6ee2dec7-e3d2-4039-83cf-e53c414c4274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fac85693510df75e90c142006a82547", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24f44696/uploads/origins/6ee2dec7-e3d2-4039-83cf-e53c414c4274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3164eea5e68d0adea90a230e775f8b2", "src_set": ""}, "body": "Fate/GrandOrderの清少納言（水着１臨）と葛飾北斎（水着）が、半脱ぎで汗だくになって、お互いの巨乳にしゃぶりつきながら揉みしだき合っているところ。\n相手を先にイかせようと勝負をしていて、涙を浮かべ必死な表情で見つめ合い、悔しそうに泣きながら母乳を噴いて同時絶頂する差分をお願いします。\n\nキャラ参考（清少納言のジャケット・北斎の着物、その他ややこしい装飾品は省略して下さい）\nhttps://img.gamewith.jp/article_tools/fatego/gacha/ascension_323_1.jpg\nhttps://pbs.twimg.com/media/E_e_o2nUUAALLU-?format=jpg&name=large\nhttps://img.gamewith.jp/article_tools/fatego/gacha/ascension_264_1.jpg\nhttps://prtimes.jp/main/html/rd/p/000000319.000042572.html\n\n構図参考\nhttps://www.pixiv.net/artworks/95603844\nhttps://www.pixiv.net/artworks/38647529", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noshigamin/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1732766, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d792cdcf/uploads/origins/2c3d782d-6d99-4b50-bf62-91eec5c2c2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d17e12a830d200f209177c33fee04500", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d792cdcf/uploads/origins/2c3d782d-6d99-4b50-bf62-91eec5c2c2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba5fe6b00e4a3f1b77070f23de0de4aa", "src_set": ""}, "body": "タケルくん（女の子ver）とカヤちゃん（中身と格好は？？？？？？）\nが伊織くんの目を盗んでいちゃいちゃえっちなことをしてるところをお願いします。\nNTRとかじゃないけど、事情は伏せておきたいみたいな感じです。\n\n伊織くんは正雪先生とよろしくやってる隙に・・・みたいな\n\n原作の浮気じゃないけど伊織くんに隠れてラブラブしてるのがちょっと背徳的でよかったので、そういうのでえっちいのが見たい感じです。\n\nふたりとも胸は控えめでお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noshigamin/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1732766, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7805c65/uploads/origins/553e3f0f-90ec-4bdd-b805-1123923c2159?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=811aff7ec9811c3c86686133dc28afa6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7805c65/uploads/origins/553e3f0f-90ec-4bdd-b805-1123923c2159?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf0499bc93736688eaf6d72cf7e734b7", "src_set": ""}, "body": "オルタミルクの同人誌の最後で、ジャンヌオルタがサンタリリィを個室に連れ込んでおっぱい見せるとこがツボだったのでリクエストです。\n裸に上着だけのジャンヌオルタが裸にしたサンタリリィにおっぱい飲ませながら（もしくは飲ませた直後で）リリィの膣内に軽く指を入れてる感じの百合イラストをお願いします。\nリリィが「まあ味見くらいはしてやりますか」みたいな感じだったけどクセになってはまっちゃったとか、やらしい気分にさせる効果があったとかみたいなシュチュです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noshigamin/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1732766, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38df5cd1/uploads/origins/a65774f8-f973-454a-a12d-45324b5ac6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1671564c7e4b347246e6695a97c2448", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38df5cd1/uploads/origins/a65774f8-f973-454a-a12d-45324b5ac6b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=256fce98247ecc2ca797410539349d40", "src_set": ""}, "body": "ランサーアルトリアオルタがセルフ授乳ひとりえっちするイラストをお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noshigamin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1732766, "client_id": 357524, "vtt_url": null, "thumbnail_image_url