02a637/uploads/origins/11aa2bea-319a-494d-b2c7-ebef74bc76fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=782d971eb6b233b9f5feb9dbc3bac795, https://si.imgix.net/6e02a637/uploads/origins/11aa2bea-319a-494d-b2c7-ebef74bc76fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=653ad7e09edc3aae37adf55e08b6699e 2x, https://si.imgix.net/6e02a637/uploads/origins/11aa2bea-319a-494d-b2c7-ebef74bc76fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a14ec7905eacb53e2a50b86c868ba1c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e02a637/uploads/origins/11aa2bea-319a-494d-b2c7-ebef74bc76fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a839acc009d5e1f0f6384265c226475c", "srcset": "https://si.imgix.net/6e02a637/uploads/origins/11aa2bea-319a-494d-b2c7-ebef74bc76fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a839acc009d5e1f0f6384265c226475c, https://si.imgix.net/6e02a637/uploads/origins/11aa2bea-319a-494d-b2c7-ebef74bc76fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3548ae39b430a56bfa6d0d1897bef25c 2x, https://si.imgix.net/6e02a637/uploads/origins/11aa2bea-319a-494d-b2c7-ebef74bc76fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e62a453bf701f1ebb9d85cf932488350 3x"}, "body": "いつもお世話になっております。\n今更感ありますがGWではオンラインスケブありがとうございました！\nこっそりコーヒーカップ持たせていただいていて嬉しかったです。\n集合絵が圧巻で今でもたまにちらちら眺めております。\n\n【キャラ】\nゲーム：ケルベロスブレイド\nキャラ：葛篭・咲（e12562）\nステシ：http://tw5.jp/character/status/e12562\nステシURL欄に「Skeb:ttk_EN」の記載を致しますので本人確認お願いします\n\n【内容】\n描いていただけるなら何でも嬉しいのですが、一応何個か案を書いてみます…。\n何か別案浮かびましたらまるっと無視していただいても構いません。\nいずれも詳しい構図・詳細はお任せいたします\n\n・翼メインのイラスト\nお願いしたピンは雰囲気重視で「白めの翼」が「肩から」でしたが、「夜鷹に似た翼」が「腰から」生えてます（ケルカ参照）\nお前真夜中二時過ぎ絵師さんの描く翼が好きすぎだろ案件。\n\n・夏っぽいイラスト\nアイスコーヒーとか夏服とか、夏の花を持ってる、とか。\n肌をあまり露出しないキャラなのでPLもキャラが着そうな夏服があまり思い浮かばず\nもう白Yシャツが一番夏とかキャラらしさあるんじゃないかと思い始めております\n何か似合いそうなのがあったらお願いします…。\n\nSkeb依頼が初めてな為、何か不手際・ご無礼がありましたら申し訳ございません\nご検討よろしくお願い致します。\n\nhttp://tw5.jp/character/status/e12562", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__solo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5880, "client_id": 1368693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6b9b2c0fa225b573968d0c8c0366c5", "srcset": "https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af6b9b2c0fa225b573968d0c8c0366c5, https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38d351c685ee2945fc0cc2f51dc6ceba 2x, https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=426b63f205375b331bc9fcd4e556c0c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6430e3b0adfc56c067ebfa794a72723d", "srcset": "https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6430e3b0adfc56c067ebfa794a72723d, https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e67aa69b95a0c2ae6e2b39dd3834835a 2x, https://si.imgix.net/2b3b1064/uploads/origins/7370289f-8eaf-4a04-878d-79f508fea938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32b63c992f9135f384c5bba601864153 3x"}, "body": "・キャラクター : liberの声優育成ゲームCUE!の丸山利恵\n・服装 : 夏らしい服(ゴシック系な格好のイラストばかりで参考になりそうなのがないのでお任せします)\n・構図など : 夏っぽくて爽やかな雰囲気でお願いします、それ以外はお任せします\n ・キャラクターについての説明\n　　・18歳の女の子\n　　・ロックバンドをやっていたが、新しい表現の仕方として声優に注目し、フリーターしながら事務所に所属し、声優活動をしている\n　　・自分を悪魔エリスと名乗ったり邪気眼的厨二病を患っている\n　　・本当は生真面目な性格で破天荒とは真逆の性格をしている。上記のような振る舞いは、ゴシック好きな趣味というのもあるが、名前も性格も地味なのをコンプレックスにしているから、という理由もある。\n　　・和菓子と乳酸菌飲料がすき\n　　・事務所の4人組のアイドル声優チームとしての売り出しにより、3人の破天荒なメンバーに囲まれながらチームMoonのリーダーを務めている。\n\n以上となります。ゲームの方が4月から休止になってしまったので、さみしいのでリクエストしました。描いていただければ幸いです。よろしくお願いします。\n\nhttps://www.cue-liber.jp/character-13", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@__solo/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1aa8baf2/uploads/origins/8699a000-6114-4934-80d6-eee5d0652786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7b0ce8c79a9d0ca24b26e720d04ceff", "srcset": "https://si.imgix.net/1aa8baf2/uploads/origins/8699a000-6114-4934-80d6-eee5d0652786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e7b0ce8c79a9d0ca24b26e720d04ceff, https://si.imgix.net/1aa8baf2/uploads/origins/8699a000-6114-4934-80d6-eee5d0652786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ede2ef8d421adefc0d694a6b9fb6f239 2x, https://si.imgix.net/1aa8baf2/uploads/origins/8699a000-6114-4934-80d6-eee5d0652786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFF