or_id": 3488945, "client_id": 1722307, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8e8bfd0/uploads/origins/a11416a9-59fa-4043-ba1c-0436816adc0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a82db09864ba07f7b4e70e8274eed4b7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8e8bfd0/uploads/origins/a11416a9-59fa-4043-ba1c-0436816adc0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f19bdd816b58b1cd5dd953770c50d226", "src_set": ""}, "body": "あんず様\n\n\n以前は作家を依頼させて頂いた者です！\n素敵な立ち絵ありがとうございました。\n\n今回も立ち絵を依頼させていただきたく伺いました。\nずるくてメロそうな男でつり目、王道イケメンっぽい、黒髪赤目ハイネック、髪型は癖のない雰囲気で前髪は真ん中にしゅっと入ってるタイプ男を依頼したいです。\n\nあんずさまのキャラビジュが本当に好きなので上記要素を全部取り入れなくても大丈夫です！\n\nなにか不備あれば再送頂けると幸いです。\nよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@babu_2_/works/41", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bb05cc2a/uploads/origins/1af84849-bd63-4f2d-90cf-c2d8ec330132?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b7db7da209d7dbbfb249322166e4bc1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3488945, "client_id": 3251480, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@babu_2_/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3488945, "client_id": 2770414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3b125e5/uploads/origins/6757a1e7-8241-4099-85c6-97dcef5a144b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to