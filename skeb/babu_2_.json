le.com/drive/folders/1wc2w66BoviY7trId6dvE09L9vJvHZFGS\n\n構図の参考↓\n先生は資料の中の軍服に従って描いてください。この軍服は私がデザインし、著作権の問題はありません。そして、先生が描いた暗い色の服はとてもきれいです。先生が描いた軍服を見たいです。この要求を受け入れていただければ幸いです🙏🏻\n二人の動作については、「🐏姫が🐶を抱いて、🐶が書類を読んでいる」というようなことができるかもしれません。\nとにかく、二人は大きな身長差があり、🐶を正太として描くことができます！\nもし金額が足りない場合は、申請を再送させてください！受け入れていただけると嬉しいです！！よろしくお願いします🥺💕", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 247005, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ミトコンチョ", "screen_name": "tontototoooon", "avatar_url": "https://pbs.twimg.com/profile_images/1641998227686969346/v2toaiZz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1051611149450412032/1709626614/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1156969, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "るあ", "screen_name": "yrhruaa", "avatar_url": "https://pbs.twimg.com/profile_images/1504818524694679559/YPqlTYK1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1073233903085735937/1617716451/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 128}, {"id": 2000942, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "7日", "screen_name": "nanoka_san", "avatar_url": "https://pbs.twimg.com/profile_images/1653639904298176512/qmz8H9pU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1262785483630772227/1683344392/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept