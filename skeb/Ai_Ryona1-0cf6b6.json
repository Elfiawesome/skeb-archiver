lign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e0d00dc43e7e710fc65528ab166bbf4 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3361361, "nc": 48}, {"path": "/@Ai_Ryona1/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3361361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b56cea51d9fd3b34e0c1e46f27674a", "srcset": "https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57b56cea51d9fd3b34e0c1e46f27674a, https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5addfe3d31207f4e479538c39b37a73d 2x, https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c4367bc697bfd7910771a34270baaf9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d443d302fe66868cf21469a2938db1de", "srcset": "https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d443d302fe66868cf21469a2938db1de, https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b64311296182e903c6205cd6de8070d4 2x, https://si.imgix.net/cb6147ce/uploads/origins/2782be7a-7520-4e6a-b63a-cdb3df6d926b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee6bcdd0ca811eb828bcc7823e21dc0a 3x"}, "body": "こんにちは、\n\nハリメヌイがサツキを徹底的に倒すマンガをリクエストしたいです。\nオリジナルの「キルラキル」では、サツキは第18話でラギョにひどく敗北しましたが、このバージョンではヌイがサツキを倒し、サツキの革命を潰すシーンを見たいと思っています。\n\nこちらがハリメヌイの画像です https://drive.google.com/file/d/1dWPH3JwUvRc5HFWFm_vOYZl9kNTz7YBp/view?usp=drive_link\nヌイの太ももと太い腕に少しフォーカスしてほしいです。ヌイは可愛い女の子ですが、この特徴が彼女を強そうに見せます。\n\nこちらがクールなサツキです https://drive.google.com/file/d/1k4uIKYus4ycBZ0HUP3hpcIQE-WJXWjPj/view?usp=sharing\nでもサツキがこの戦いでひどく負けるので、この絵がサツキの状態を少しよく表現していると思います https://drive.google.com/file/d/1zQx48nM0pG7tdzDhGdxgYfN8oHUioMIS/view?usp=sharing\nサツキが受けているダメージを描いてほしいです。サツキは戦いの負担で大量に汗をかいており、彼女の服も破れたり傷ついたりしています。\n\n参考として、これらの2人の戦いや関係性を描きたかったので、インスピレーション用のビデオを添付します: https://drive.google.com/file/d/1WK9ynrl7ZItoVyot8H76L-AiSc5xYuLJ/view?usp=sharing\nこのビデオは、2人のキャラクターの性格や階層関係をよく表現しています。\n\n---------------------------------------------------------------------\n戦いは素手での戦い、パンチやキックなどでのみ行われるべきです。\n戦いの開始時に、サツキの剣はヌイによってすでに壊されています。サツキを苦しめることを楽しんでいるヌイは、武器を使わずに戦うことを好みます。このマンガはここから始まり、全4部で構成されています。\n\n第1部\nサツキは必死にヌイに攻撃を試みますが、ヌイは簡単にサツキの攻撃を防ぎ、避けます。サツキは怒りと絶望でいっぱいですが、ヌイにとってそれはただのゲームです。ヌイはサツキの攻撃を反撃し、サツキを愚かに見せつけます。サツキは必死に戦いますが、ヌイはただサツキをからかい、侮辱しているだけです。\n\n第2部\nヌイはその優れた速さを使って、サツキを支配し始めます。サツキはヌイの攻撃を追跡できません。ヌイはサツキの遅さをからかい、速いペースの攻撃でサツキを痛めつけます。\n\n第3部\nサツキは自らの決意と内なる力に集中します。ヌイが再びサツキの後ろに回ったとき、サツキはようやく反応し、ヌイにパンチを放ちます！サツキは「この戦いをここで終わらせる！」と叫びます。\nしかし…ヌイはサツキの拳を掴み、それを潰します。https://drive.google.com/file/d/1C-XH51c0cCqxWvu-MAZd3QgDcMV82rgQ/view?usp=sharingに示されている通りです\nヌイは痛みに叫んでいるサツキを嘲笑いながら、「ごめん、何か邪魔しちゃったかしら〜？ねえ、この戦い終わらせてあげようか？終わらせようか？」とからかいます。\n\n第4部\n嘲笑を浮かべたヌイは、ようやく本気で戦い始めます。サツキは痛みと信じられない思いでいますが、どうやらヌイは今まで本気を出していなかったようです。\nカメラはアクションから外れ、戦いの最後の部分は映されません。代わりに、ヌイの挑発的なセリフとサツキの痛みの叫びをいくつかの吹き出しで表現してください。戦いが画面外で続き、時間が経過したことを示唆することが目的です。\n最後のページは次の通りです：蛇 崩 乃 音 がサツキを助けるために現れたばかりですが、ノノンの顔は信じられない恐怖で歪んでいます。最後のパネルでは、ヌイがサツキを足で逆さまに持ち上げているシーンが描かれています。https://drive.google.com/file/d/1p22NE8aViu8RLwEhS8BILZyqO6OqtTpR/view?usp=drive_link のように。\nオフスクリーンの部分で、さつきはさらに激しく殴打される。純潔の制服は以前よりもさらに破れ、さつきは股間から濡れて漏れている：この殴打がさつきに意思に反して絶頂をもたらしたことを暗示している。\n\nぬいは、敗北中に絶頂を経験したマゾヒストの負け犬であるさつきを嘲笑う最後の台詞を言うことができる。\n\nお時間をいただきありがとうございました。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ai_Ryona1/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6886ed6/uploads/origins/48bed993-1bb3-48ef-ab11-2e8d44fe686f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7e2a3098a86b60260f8fc39a9a4a38f", "srcset": "https://si.imgix.net/b6886ed6/uploads/origins/48bed993-1bb3-48ef-ab11-2e8d44fe686f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d7e2a3098a86b60260f8fc39a9a4a38f, https://si.imgix.net/b6886ed6/uploads/origins/48bed993-1bb3-48ef-ab11-2e8d44fe686f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7738fc7eb9668f52e4a262830ebc734d 2x, https://si.imgix.net/b6886ed6/uploads/origins/48bed993-1bb3-48ef-ab11-2e8d44fe686f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8efd44ae5f850ff0055f22531b4c503 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3361361, "nc": 161}, {"path": "/@Ai_Ryona1/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3361361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174320fd7381afc03abb7b362b5b7471", "srcset": "https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=174320fd7381afc03abb7b362b5b7471, https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a75ee0920f69ce172265c3478f69238 2x, https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1329cc4033d0e2e20e0c52f3dc29724 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30ed2ceb48c68ae1344bca237c7dc724", "srcset": "https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30ed2ceb48c68ae1344bca237c7dc724, https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd568245674f1eec27c4389446d1d5cd 2x, https://si.imgix.net/7ae04a8f/uploads/origins/403fe508-9b7a-4cdf-9744-47920ecff86d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=268640bc6f0416a629d88fc3083adb32 3x"}, "body": "こんにちは、はじめまして。Fanboxで描いていただいた「スーパーヒロインryona」のような漫画を描いていただきたいです。\n\nフェアリーテイルの288章と289章の「ウェンディVSシェリア」の戦いの別の道を示す漫画を描いてください。\nhttps://imgur.com/a/1KGzA5B https://i.imgur.com/Ayo0j87.png の前の戦いはこうでした。\nシェリア・ブレンディはピンクの髪の女の子で、ウェンディ・マーベルは青い髪の女の子です。\n\n原作ではシェリアが必殺技を使うときです。あなたの描く漫画では、シェリアは必殺技を使わないでほしい。シェリアは接近戦では全速力でウェンディに突進する。\n\nここからシェリアは完全にウェンディを支配し、そのスピードと力をフルに使って翻弄する。ウェンディはシェリアのキックとパンチには無力だ。ウェンディにとってシェリアは速すぎ、強すぎ、巧みすぎる。\n\nウェンディは驚き、不安、恐怖、不信、怒り...を経験する。ウェンディが自分の劣勢を受け入れるのは難しい。戦いが進むにつれ、ウェンディは次第に情けなく見えてくる。\nこれとは対照的に、シェリアは楽しんでいる。シェリアは自信に満ちた笑みを浮かべ、楽しんでいる。シェリアにとって、これはただの楽しい時間であり、シェリアはクールで強く見えている。シェリアはちょっとサディスティック。\nファンボックスの漫画でキャラクターの反応を見せるのが好きなので、これは楽しみです。\n\n戦いの振り付けは好きなものを使っていい。シェリアは手刀、キック、パンチしか使わないようにしてほしい。ウェンディがシェリアに攻撃を仕掛けても、シェリアはノーダメージ。\n\nできれば台詞を追加してください。シェリアの遊び心と支配欲を台詞に反映させてほしいです。\n最後に、この漫画はウェンディがノックアウトされた様子で終わります。戦いが正式に終わったかどうかは語られていませんが、ウェンディは敗北したように見えます。\n\n提供された支払いで、できるだけ多くのページを作ってください。\n\nこのリクエストに答えてくれてありがとう", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ai_Ryona1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3361361, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7fb45a7/uploads/origins/e23bef45-110e-4675-9492-cb3fef6432b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37af802ca8d89cd6f4b241ed3ad0b92b", "srcset": "https://si.imgix.net/d7fb45a7/uploads/origins/e23bef45-110e-4675-9492-cb3fef6432b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37af802ca8d89cd6f4b241ed3ad0b92b, https://si.imgix.net/d7fb45a7/uploads/origins/e23bef45-110e-4675-9492-cb3fef6432b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb08f1457063d973c82457831fa40f8b 2x, https://si.imgix.net/d7fb45a7/uploads/origins/e23bef45-110e-4675-9492-cb3fef6432b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c582b224752182f39cc12336cdaf641d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7fb45a7/uploads/origins/e23bef45-110e-4675-9492-cb3fef6432b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bdb654b4251a43d27f3dec8ef51e310", "srcset": "https://si.imgix.net/d7fb45a7/uploads/origins/e23bef45-110e-4675-9492-cb3fef6432b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bdb654b4251a43d27f3dec8ef51e310, https://si.imgix.net/d