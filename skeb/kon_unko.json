えませんか？\n\n20代前半のOLさんです。背が低くて小柄。肌は青白い。このデザインの元になっているメインキャラクターは、ファイアーエムブレムhttps://i.imgur.com/nWakp82.png のリシテアです。\n\nもしあなたがキャラクターデザインの基礎として彼女を使うことができるなら、それは素晴らしいことです！でも、このOCは彼女の古いバージョンになります。\n\n彼女の服装は、この服装をベースにデザインしてもらえますか？\nhttps://i.imgur.com/uZfLKUw.png\n\nシャツの下はボタンを全部閉めて、白いネクタイをしてください。スーツとスカートは白で、シャツの下は黒にしてください。また、彼女にメガネをかけてもらい、メガネを外したバージョンもお願いします。\n\nヘアスタイルはこのスタイルでお願いします：\nhttps://i.imgur.com/nWakp82.png\n\n髪の色はダークレッドでお願いします。\n\nポーズはこれを参考にしてください：\nhttps://i.pinimg.com/736x/84/7f/4d/847f4d7a3b4e7b53571fa57cf312c456.jpg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kon_unko/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aa8fedfe/uploads/origins/d8e2c80b-790f-4166-9fb8-8042933ad4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d0693b7ed8dd54632865f49111abeae8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1169610, "client_id": 1934648, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kon_unko/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1169610, "client_id": 3173637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb861f4c/uploads/origins/e24daca3-00c7-4f19-8a29-fce04555a2f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3137e910a4fac5e9c72e9d0b51b22026", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb861f4c/uploads/origins/e24daca3-00c7-4f19-8a29-fce04555a2f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=