、アクションは自由です。\n女性のコスチュームは描きやすいものを選んでもいいし、二人のコスチュームで遊んでもいい。\n\n自前のマシンを使うので変なところがあるかもしれません。\n合わなければキャンセルも可能です。\n金額が足りなければ再度送ることもできます。\n\nhttps://drive.google.com/drive/folders/1ujlIBPBQBbHhI07y1hUOmZxx1d_vGeYw?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_mgr6/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3362549, "client_id": 2636138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ed5f865/uploads/origins/8ea288e4-d336-47cf-b834-3b2d07b9ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b43b4a56507ca2475e32f5e499c59d3a", "srcset": "https://si.imgix.net/1ed5f865/uploads/origins/8ea288e4-d336-47cf-b834-3b2d07b9ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b43b4a56507ca2475e32f5e499c59d3a, https://si.imgix.net/1ed5f865/uploads/origins/8ea288e4-d336-47cf-b834-3b2d07b9ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14d121c13db0f01addd11b6f06bb2566 2x, https://si.imgix.net/1ed5f865/uploads/origins/8ea288e4-d336-47cf-b834-3b2d07b9ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f39cece5ba2b2ea4d073e015611faa4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ed5f865/uploads/origins/8ea288e4-d336-47cf-b834-3b2d07b9ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6f512eabf70d90ffdaa65b841ccca90", "srcset": "https://si.imgix.net/1ed5f865/uploads/origins/8ea288e4-d336-47cf-b834-3b2d07b9ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6f512eabf70d90ffdaa65b841ccca90, https://si.imgix.net/1ed5f865/uploads/origins/8ea288e4-d336-47cf-b834-3b2d07b9ac83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d973daf2f