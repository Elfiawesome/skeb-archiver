d\u30bf\u30b0\u306e\u3088\u3046\u306a\u30c7\u30d5\u30a9\u30eb\u30e1\u3092\u52b9\u304b\u305b\u305f\u30de\u30eb\u30a3\u3068\u30015~6\u982d\u8eab\u4f4d\u306e\u30de\u30eb\u30a3\u3092\u4e00\u7dd2\u306b\u63cf\u3044\u3066\u304f\u3060\u3055\u3044\n\u4ee5\u4e0b\u306f\u8981\u671b\u306e\u7b87\u6761\u66f8\u304d\u3068\u306a\u308a\u307e\u3059\n1.\u5168\u4f53\u7684\u306a\u30a4\u30e1\u30fc\u30b8\n\u30001).\u30c7\u30d5\u30a9\u30eb\u30e1\u7248\u304c\u30ea\u30a2\u30eb\u982d\u8eab\u7248\u304c\u540c\u3058[\u304a\u9858\u3044\u3059\u308b]\u30dd\u30fc\u30ba\u3092\u3068\u3063\u3066\u3044\u308b\n\u30002).\u30c7\u30d5\u30a9\u30eb\u30e1\u7248\u306f\u300c\u4e0d\u6a5f\u5acc\u305d\u3046\u3067\u3078\u306e\u5b57\u53e3\u3067\u5049\u305d\u3046\u306b\u300d\n\u30003).\u30ea\u30a2\u30eb\u982d\u8eab\u7248\u306f\u30ad\u30e9\u30ad\u30e9\u3057\u3066\u53ef\u611b\u3089\u3057\u3055\u3092\u51fa\u3057\u3066\u3001\u6a2a\u306e\u30c7\u30d5\u30a9\u30eb\u30e1\u7248\u3068\u6bd4\u3079\u3066\u300c\u8ab0\u3060\u3001\u304a\u524d\uff01\u300d\u3068\u611f\u3058\u308b\u3088\u3046\u306a\n2.\u30c7\u30b6\u30a4\u30f3\n\u30001).\u30de\u30eb\u30a3\u306e\u30c7\u30b6\u30a4\u30f3\u306f\u8cc7\u6599URL\u3092\u53c2\u7167\n\u30002).\u8863\u88c5\u306e\u30c7\u30b6\u30a4\u30f3\u5143\u306f\u7b2c\u4e8c\u6b21\u4e16\u754c\u5927\u6226\u6642\u306e\u30ed\u30b7\u30a2\u91ce\u6226\u670d(\u4e0b\u8a18URL\u53c2\u7167)\n\u3000https://www.sovietmilitarystuff.com/sobietochi-jun-wwii-rosiahang-kong-yunihuomum43.html?search=M43&description=true\n\u3000https://genkosha.pictures/illustration/1803074310\n3.\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u9020\u5f62\n\u30001).\u304a\u304b\u3063\u3071\u982d\u3067\u304f\u308b\u304f\u308b\u307e\u3093\u4e38\u307b\u3063\u307a\u3067\u53ef\u611b\u3089\u3057\u3044\u90e8\u985e\u3002\u534a\u76ee\u3067\u4e0d\u6a5f\u5acc\u305d\u3046\u306b\u3078\u306e\u5b57\u53e3\u3002\u552f\u6211\u72ec\u5c0a\u3067\u5049\u305d\u3046\n\u30002).\u8a00\u8449\u306f\u5358\u8a9e\u306e\u3076\u3064\u5207\u308a\n\u30003).\u5927\u7832\u3076\u3063\u653e\u3059\u3068\u304d\u3084\u4eba\u306b\u7121\u7406\u306a\u4e8b\u3092\u304a\u9858\u3044\u3059\u308b\u6642\u306f\u3001\u601d\u3044\u3060\u3057\u305f\u3088\u3046\u306b\u53ef\u611b\u3089\u3057\u3044\u4ed5\u8349\u3092\u3059\u308b\n4.\u305d\u306e\u4ed6\n\u30001).\u304a\u9858\u3044\u3057\u3066\u3044\u308b\u30dd\u30fc\u30ba\u306b\u3064\u3044\u3066\u306f\u304a\u4efb\u305b\u3044\u305f\u3057\u307e\u3059\n\u30002).\u30c7\u30b6\u30a4\u30f3\u306e\u4e00\u90e8\u5909\u66f4\u3084\u30e1\u30ab\u8981\u7d20\u3092\u8db3\u3057\u3066\u3082\u304b\u307e\u3044\u307e\u305b\u3093\n\u30003).\u305d\u306e\u4ed6\u3001\u304a\u307e\u304b\u305b\u3044\u305f\u3057\u307e\u3059\n\n\u4ee5\u4e0a\u3001\u304a\u624b\u6570\u3067\u3059\u304c\u3001\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\u3002\n\nhttps://x.com/vonmanheim/status/1962160708440948773", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NAMEKUJISUPAI2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1323638, "client_id": 54028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d069458d/uploads/origins/349e3a2d-edb1-48b2-a40e-d00622602031?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b3c199519b9bd664837c10045d4c674", "srcset": "https://si.imgix.net/d069458d/uploads/origins/349e3a2d-edb1-48b2-a40e-d00622602031?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b3c199519b9bd664837c10045d4c674, https://si.imgix.net/d069458d/uploads/origins/349e3a2d-edb1-48b2-a40e-d00622602031?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e7ed7da5423b7992b607cb90f4a5cbc 2x, https://si.imgix.net/d069458d/uploads/origins/349e3a2d-edb1-48b2-a40e-d00622602031?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96c2dc9fc6862890091dce333a8e59a1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbn