, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@rei_eichi_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1789560, "client_id": 97109, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef1a05c04369b379dfc18423d8c6cc04", "srcset": "https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef1a05c04369b379dfc18423d8c6cc04, https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=303297111e4a3e5b5a133301c0553540 2x, https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d9511eda7a3de471c1d29fa30aa8a64 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9eb6bb9fe1f7f56c2aca9dc7476fa80b", "srcset": "https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9eb6bb9fe1f7f56c2aca9dc7476fa80b, https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d2c462727ccb844a877c2ee6c0f261e 2x, https://si.imgix.net/dc22bdb8/uploads/origins/eee7fe05-ec1c-4d03-b1dd-20d627570c15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2417fa7918aef5db992f15728d7fd636 3x"}, "body": "Hi, I like your work very much! So I would like to request an illustration of my original character. In the link you will find detailed image references and character descriptions, and I would like you to look at the settings and create your own.\n\nThey are lovers, so I would like an illustration of them touching each other if possible. If possible, I would like you to draw some daily life-like images as well, or I would like to see them playing at an amusement park or having fun together.\n\nI really like the cartoons you draw and would like you to draw this same type of work: https://skeb.jp/@rei_eichi_/works/14\nIf the request is not worth the amount or is otherwise incomplete, please feel free to request a resend. We will do our best to accommodate you.\nIf you still find it difficult, you can cancel your request.\n\nhttps://drive.google.com/drive/folders/1M2qAvVMDMmW6BiuFqR9zHVJaNIVU3DiI", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rei_eichi_/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1789560, "client_id": 2387799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65ab55ed6ce190763a7ca52385bc7c4c", "srcset": "https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65ab55ed6ce190763a7ca52385bc7c4c, https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71a10577c47f51508d0503b91f4d8207 2x, https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d63aeacfbef8fd987ac835ab203ac2d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4c544afa4e997be903432736b26d253", "srcset": "https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4c544afa4e997be903432736b26d253, https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdd5cb801ab6ba7f3fc0a89a2e470016 2x, https://si.imgix.net/79f669c4/uploads/origins/3b3685aa-59ed-4ad7-b088-64a3aee5a640?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd031c3cc963a607d58b1f2a3bc420ac 3x"}, "body": "ともなが⁵様 \nこんにちは、ともなが⁵様の絵がとても魅力と思います。 \nこの度スケブ再開頂きありがとうございます！\n\n良ければこちらのオリジナルBL CP二人のやり取りを描いていただきたいです。  \n\n・キャラクター二人ともホスト。 \n・二人ともタバコを吸わない。  \n\n◆東崎（とうざき） 20歳、181cm、金髪。攻め。 \n不機嫌な顔だけど優しい性格、ほどんど笑ってない。  \n-当店のNo.1ホスト \n-以前、ある事件で彌緋に助けられたため、その後彌緋のことを憧れていて、とても気になるようになった。 \n-言葉より行動派 \n-一人称は「僕」 \n-彌緋を「彌緋先輩」と呼んでいる。  \n\n◆彌緋（びひ） 21歳、177cm、茶色髪、前髪と後ろの内とポニテールに赤いメッシュがある。受け。 \nいつもチャラな言葉を使ってるけど、内心は繊細です。  \n-当店のNo.3ホスト \n-以前東崎のこと後輩しか思ってませんが、最近段々気になってる。 \n-一人称は「僕」だけど、偶に「俺」も使ってる \n-東崎を「東崎」と呼んでいる。  \n\n◆二人の関係：曖昧な関係  \nいつもホストグラブの2枚看板で色んなボディータッチがあるけど、最近彌緋が胸の中に何か変と思ってる。  \nずっとエレガントな先輩として、彌緋が東崎にそういう焦る姿を見せたくない。 \n内心が恥ずかしくなって、目が合わないの回数が増える。  \n———————————— \n\nURL内に二人のやり取りや漫画など参考図がございます。  ご検討のほどよろしくお願い致します。\nここまで読んで頂きありがとうございます！\n\nhttps://drive.google.com/drive/folders/1-EkIfeOfbFvoyS8a7NWbh9W4FvwDDvS7", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rei_eichi_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1789560, "client_id": 2141901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0724d2811ec2ead5e79a20166bbbfa0a", "srcset": "https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0724d2811ec2ead5e79a20166bbbfa0a, https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c62c2e8eefb617301654c1016742bd87 2x, https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9491cfb969bac341b38d08f3d72daa6e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7302bc26f99aa6dc9687190cd53f80c4", "srcset": "https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7302bc26f99aa6dc9687190cd53f80c4, https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d75d41b0803a81f35de30ed40a42afa4 2x, https://si.imgix.net/e98f7093/uploads/origins/bc4528f9-e375-472d-9677-3b85febddf3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ab055fa983d270f1cdcdb78ebadb8f0 3x"}, "body": "Nice to meet you, Mr. Practice, and hello! Thank you for reopening the call for requests! I love your drawings, so please let me make a request!\n\nIf you don't mind, I would like to ask you to draw my original characters. The characters are a twin brother and sister. The older brother is a gentle boy, but a bit cool in front of others. The older brother only shows his kind side in front of his younger sister. The younger sister is a sweet and gentle girl who loves to laugh.\n\nI don't know if this will help you, but we both like to read books!\n\nWhat I would like is a warm interaction between the twins in their daily life. For example, the older brother reading a book while the younger sister makes tea! You don't have to use this composition at all! I'll leave it up to you to decide on the character's costume, the mood of the picture, the pose, etc. based on your impression of the character!\n\nClick here for character references:\n\nhttps://drive.google.com/drive/folders/17m_ppcjHI657WqDTtWtUlA4xEWRuowQi\n\nI hope you'll consider us! Best regards! ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rei_eichi_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1789560, "client_id": 97214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f140370a08b45b9946f9f292dfe92e3", "srcset": "https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f140370a08b45b9946f9f292dfe92e3, https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=622ecb3ea57df84e2ef2013212241642 2x, https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b75e3e33dad90ea0489285d881ed818 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2142b57e7e9b124da332e7af01961d6e", "srcset": "https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2142b57e7e9b124da332e7af01961d6e, https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7517be30e7c46ef7066a60e51eba82f 2x, https://si.imgix.net/e2d3151e/uploads/origins/2018faa7-6139-4ce4-b5f9-a2a41239154a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cf3bc859c4bd33f2a91b5e1e385ef1a 3x"}, "body": "Dear Mr. Practice, it is nice to meet you. I have seen your wonderful illustrations and I think you will be very interested in them. I would like to ask you to illustrate a TRPG character for me and my friend.\n\nPlease see the link for more details. If you like, I would appreciate it if you could draw the interaction between the two of us. I can't think of anything else, so please feel free to draw it. The height difference is about 17cm.\nPlease consider this drawing.\n\nhttps://drive.google.com/drive/folders/1-Uqtfvql4H_2lLwAajV-too0SmiDBB9x", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@rei_eichi_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1789560, "client_id": 727177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3c4c294/uploads/origins/5e75c5ec-7e97-4858-a81c-260fc89b1129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98d19171c8aaf5d92d03e539d17d897d", "srcset": "https://si.imgix.net/e3c4c294/uploads/origins/5e7