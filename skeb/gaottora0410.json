ks/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3008708, "client_id": 1825989, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e744f6d/uploads/origins/5fc36af9-15a9-40a0-9195-f2aa73588f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e82a109aaf669f67b4bf66213735d264", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e744f6d/uploads/origins/5fc36af9-15a9-40a0-9195-f2aa73588f3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daf04ecabebec357061ccb3daa341050", "src_set": ""}, "body": "こんにちは、はじめまして！\nアピールありがとうございます！\n私のアバター/OCを気に入ってくださり、嬉しいお言葉をいただき、ありがとうございます！\nご提案いただいた「4分割の画面に様々な表情を詰め込む」というアイデア、とても気に入っています。\nとてもクールだと思うし、僕のOCのさまざまな魅力を表現するのに役立つと思う。\nなので、このリクエストのスタイルのようなものがあればとてもいいと思います。https://skeb.jp/@gaottora0410/works/13\n\n私のアバターのデザインの参考資料はこちらhttps://imgur.com/a/quinn-PBydfXE。\nhttps://skeb.jp/@Isukan_erty/works/39 この前のリクエストにも、彼のデザインと性格／キャラクター特性に関する参考になる情報が含まれています。\n顔の傷、少し疲れた目、鋭い犬歯が彼の顔の主な特徴です。\n\nよろしくお願いします。\n拙い翻訳をお詫びいたします。\n\nhttps://imgur.com/a/quinn-PBydfXE", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gaottora0410/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3008708, "client_id": 3464457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18242c6e/uploads/origins/f40c6a3a-36f5-47bc-9ca5-29733b6e1146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=303758af2df66f9e053550ceadd7ba20", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18242c6e/uploads/origins/f40c6a3a-36f5-47bc-9ca5-29733b6e1146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=554fa6f1e1b5142fcd