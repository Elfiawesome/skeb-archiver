な雰囲気の要素となる物\n\nキャラが明るいイメージのため上記お気遣いいただければ幸いです。\n\nどうぞよろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fo/wsagaqt7dxxkfilmi5mku/ANUVf9ZLyfAHKAzvBXqT9Xg?rlkey=hzprkgf4e5q2sxsi2joiv4lop&st=mcnpsr56&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuiruri/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 863735, "client_id": 3028671, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69d10438/uploads/origins/49a0ebd4-a6e5-4300-9057-57c6255ce66a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a28000cd3b43b13ddf9e24dd737420a", "srcset": "https://si.imgix.net/69d10438/uploads/origins/49a0ebd4-a6e5-4300-9057-57c6255ce66a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a28000cd3b43b13ddf9e24dd737420a, https://si.imgix.net/69d10438/uploads/origins/49a0ebd4-a6e5-4300-9057-57c6255ce66a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2abeab4ebe1b13473ff261075292ef8 2x, https://si.imgix.net/69d10438/uploads/origins/49a0ebd4-a6e5-4300-9057-57c6255ce66a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e34a1b1f5f02ef13b399d896a51d81b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69d10438/uploads/origins/49a0ebd4-a6e5-4300-9057-57c6255ce66a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4cee483715f5619741bc875372cc4ec", "srcset": "https://si.imgix.net/69d10438/uploads/origins/49a0ebd4-a6e5-4300-9057-57c6255ce66a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4cee483715f5619741bc875372cc4ec, https://si.imgix.net/69d10438/uploads/origins/49a0ebd4-a6e5-4300-9057-57c6255ce66a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=770937aad153201b8c3e504a1d68c06