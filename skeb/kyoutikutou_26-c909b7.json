anscoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyoutikutou_26/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3668179, "client_id": 1124770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2820971e588300be293157acd14319e6", "srcset": "https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2820971e588300be293157acd14319e6, https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=599e7d11ac7e3090be74c5039a7ef451 2x, https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3b82550939d3e11b7c6db2f6e971a10 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5067362cc233b5ca50cb4d637d4a952", "srcset": "https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5067362cc233b5ca50cb4d637d4a952, https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7343c985db240692f6cc636d0e59b918 2x, https://si.imgix.net/f06c7b14/uploads/origins/b57625f4-3a97-46d5-851a-3493b70f54b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e203a57d6a07e5cd0cd4699bf0a2dda6 3x"}, "body": "こんにちは！あなたが新しい依頼を受けるのを楽しみにしていました。あなたのエネルギッシュでほのぼのとしたスタイルがとても好きです。\n\n僕のOCのレイ姫を描いてもらえませんか？最初はAIで描いたのですが、いろいろなアーティストがどのように彼女に命を吹き込むのか見るのが何より好きです！\n\nレイについて\n自信家で甘やかされた砂漠の王女で、\"砂漠の宝石 \"として知られている。軽く日焼けした肌、スリムなウエスト、大きな胸、ウェーブのかかった暗紫色の髪、紫色の目、小さな王冠（普段は傾いている）、たくさんの高価な宝石（ネックレス、ブレスレット、宝石をちりばめたチェーンベルト）を身につけている。\n普段の服装は、紫のホルター・トップ、太ももに高いスリットの入ったロング・スカート、黒のフィンガーレス・グローブ。\n\n私は、あなたが最近投稿したこの記事（花のトップスを着たブルネット）のポーズと表情がとても好きだった。自信に満ちていて、さりげなくセクシーなエネルギーがあった。できれば、同じような雰囲気のものが欲しいです！\n\nそうでなければ、すべてお任せします。ポーズ、構図、背景。どんな作品ができるのか楽しみにしています！ありがとう！\n\nhttps://drive.google.com/drive/folders/1zocnmYJnCWFQMAT9GE0OSog5BfHKu1mr", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyoutikutou_26/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3668179, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fadd7541b48a0246dd790b05b44346d2", "srcset": "https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fadd7541b48a0246dd790b05b44346d2, https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6525bd6a595c385d72e113b9e25ddbad 2x, https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afcc2fa357e10094f18b1ae33c6438d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf49f5bf58d81e6c988efd5a14af6cc4", "srcset": "https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf49f5bf58d81e6c988efd5a14af6cc4, https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95ddb95b1d11854a472388a6ac8fb263 2x, https://si.imgix.net/501a8ff6/uploads/origins/1169766c-9bb1-43fe-829b-6bc3419ed69a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d79b01828724975806b7dee543c12d8 3x"}, "body": "はじめまして。\n夜空先輩か真昼を描いて頂けると嬉しいです。\n衣装はポ○ケさんが新海リンナの絵で描かれていたようなチューブトップのビキニ。\nスタイルは昨年9月に投稿された料理を持ったチャイナあかりちゃん以上を希望です。\nよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyoutikutou_26/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3668179, "client_id": 1220154, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554c13fc6f2c3bbe261781936896d4cc", "srcset": "https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=554c13fc6f2c3bbe261781936896d4cc, https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2e459091dd0412544d936f503b3b24f 2x, https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d69eb56177c3b63f7bed7ff6e3be697 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e0c3bc75939415303c9b5a37468473", "srcset": "https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e0c3bc75939415303c9b5a37468473, https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21e851df466816245cb2b72f5868fdf3 2x, https://si.imgix.net/db917b1a/uploads/origins/5fad13fa-3b3b-4fce-a0c1-985e29397893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=788d1c5f5a077d5883396e36a2291b6b 3x"}, "body": "はじめまして、いつもイラスト楽しみにしています。\nアイカツ！をあまり知らないのですが、夾竹桃様の描くあかりちゃんがとても可愛らしさの中にかっこよさがあり、線の力強さとパキッとした色使いがすごく活かされていて、とても惹かれています。\nもし自分のイラストを描いて頂けたらとても嬉しいなと思い、リクエストを送らせていただきます。\n\nリクエスト内容として、VTuberとして活動している自分、「あるふ先生」をお願いしたいです。\n\n服装、背景などすべてお任せしますが、夾竹桃さんの世界観が大好きなので、描きやすい形にアレンジしていただいて構いません。\nアレンジ頂ける際は、つの、髪の毛はピンクに黒のインナーカラー、ピアス、赤い目はトレードマークなので残して頂けると嬉しいです。\n(資料URL参照)\n\nYouTubeでの配信や、Twitter等SNSの活動に使わせていただきたいと思っています。\nそのため、背景等描いて頂けた場合、人物とレイヤーをわけてpsdで納品頂けるとたすかります。\n\n以下自画像イラストです。もしイメージが掴めなさそうでしたら参考にして頂けると嬉しいです。\nhttps://www.pixiv.net/artworks/89872346\n\nhttps://x.com/aruhuteacher/status/1549929454503206912?s=46&t=MR94dGaYqQj8pnlvoaYPaw", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 563357, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "長崎犬太", "screen_name": "kenta_nagasaki_", "avatar_url": "https://pbs.twimg.com/profile_images/2011846746230681600/SvmyGDJk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252551146637385735/1725421875/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by