プロセッサの簡易図（https://xenoblade.fandom.com/wiki/Trinity_Processor）を指さしながらガレアに何かを説明している。 プネウマは素晴らしい発見をしたため微笑んでいる。ガレアは何かを考え込んでいる表情をしている。モニターを見下ろす二人の少女を、やや低い角度から捉えた構図。ありがとうございます！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@piubiscuit/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3386173, "client_id": 1352208, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0465f62a/uploads/origins/64088960-409c-4aad-a577-ae4da2ca0abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2690ec9a154d951ade40664854fba50", "srcset": "https://si.imgix.net/0465f62a/uploads/origins/64088960-409c-4aad-a577-ae4da2ca0abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2690ec9a154d951ade40664854fba50, https://si.imgix.net/0465f62a/uploads/origins/64088960-409c-4aad-a577-ae4da2ca0abc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d51882f4e7071fdd1a9ef3a09dddcd1 2x, https://si.imgix.net/0465f62a/uploads/origins/64088960-409c-4aad-a577-ae4da2ca0abc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=435834f0d6130d5b84f6cf4dd7e008b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0465f62a/uploads/origins/64088960-409c-4aad-a577-ae4da2ca0abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68b6fe2b11b1b52dded74171de67c679", "srcset": "https://si.imgix.net/0465f62a/uploads/origins/64088960-409c-4aad-a577-ae4da2ca0abc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68b6fe2b11b1b52dded74171de67c679, https://si.imgix.net/0465f62a/uploads/origins/64088960-409c-4aad-a577-ae4da2ca0abc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe4a9cc22911ec0864b04000c2f3b53c 2x, https://si.imgix