2ba-981e-f1104f6ee0df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8477fff57c4e950e81df1a006e35d67f 2x, https://si.imgix.net/9b39a671/uploads/origins/7af4e6ae-c659-42ba-981e-f1104f6ee0df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d97e1844848c33c42c1a06e2f5f6413 3x"}, "body": "\u306f\u3058\u3081\u307e\u3057\u3066\u3002\n\u500b\u4eba\u52e2VTuber\u306e\u6e38\u751f\u30a4\u30eb\u3068\u7533\u3057\u307e\u3059\u3002\n\u4e0d\u5bdd\u69d8\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u521d\u3081\u3066\u304a\u898b\u304b\u3051\u3057\u305f\u3068\u304d\u304b\u3089\u305a\u3063\u3068\u5927\u597d\u304d\u3067\u3001\u4eca\u56de\u305c\u3072\u4f9d\u983c\u3055\u305b\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u3068\u601d\u3044\u3054\u9023\u7d61\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3057\u305f\u3002\n\n\u2193\u4ee5\u4e0b\u4f9d\u983c\u306e\u8a73\u7d30\u3067\u3059\u2193\n\u30fbVTuber\u6e38\u751f\u30a4\u30eb\u306e\u30a4\u30e9\u30b9\u30c8\u3092\u63cf\u3044\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u3067\u3059\n\u30fb\u5e0c\u671b\u306e\u753b\u50cf\u30b5\u30a4\u30ba\u30101920\u00d71080(pixel)\u3011\n(FANBOX\u306e\u30ea\u30bf\u30fc\u30f3\u7279\u5178\u3067\u3042\u308b\u30b9\u30de\u30db\u7528\u58c1\u7d19\u306b\u3082\u4f7f\u7528\u3055\u305b\u3066\u3044\u305f\u3060\u304d\u305f\u3044\u306e\u3067\u3001\u7e26\u3067\u3082\u6a2a\u3067\u3082\u9055\u548c\u611f\u306e\u306a\u3044\u30a4\u30e9\u30b9\u30c8\u3067\u3059\u3068\u5927\u5909\u3042\u308a\u304c\u305f\u3044\u3067\u3059)\n\u30fb\u5e0c\u671b\u306e\u7b49\u8eab\uff1a\u901a\u5e38\n\u30fb\u63cf\u5199\u7bc4\u56f2\uff1a\u5168\u8eab(\u898b\u5207\u308c\u308b\u7b87\u6240\u304c\u306a\u3044\u3068\u5b09\u3057\u3044\u3067\u3059)\n\u30fb\u30dd\u30fc\u30ba\uff1a\u5e8a\u306b\u5bdd\u305d\u3079\u3063\u3066\u304a\u308a\u3001\u76ee\u306f\u7720\u305d\u3046\u306a\u304c\u3089\u3082\u3046\u3063\u3059\u3089\u958b\u3051\u3066\u3044\u308b\u72b6\u614b\n\u30fb\u8868\u60c5\uff1a\u7720\u305d\u3046\u3