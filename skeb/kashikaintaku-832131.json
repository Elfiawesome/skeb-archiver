ーズは立ち絵の資料を参考にして頂けると嬉しいです！\n\n 【使用用途】\n 個人的な観賞用の印刷を想定しています。\n人物のみの透過データがあれば嬉しいです。\n\n【備考】 \n上記の要望はいずれも厳守ではなく、参考程度で問題ございません。 \n お忙しいところ恐れ入りますが、ご縁がありましたら嬉しく思います。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/12RckVjpW8yHnEuWMFcHO1MU_N6iVMazi/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Qd7oyJLD7U/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2609768, "client_id": 3411319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/159e9b39/uploads/origins/e9661b10-9fbf-43ac-a5d5-0245945f2180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91fb10f1757c4dc49fa5b09e1ef03983", "srcset": "https://si.imgix.net/159e9b39/uploads/origins/e9661b10-9fbf-43ac-a5d5-0245945f2180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91fb10f1757c4dc49fa5b09e1ef03983, https://si.imgix.net/159e9b39/uploads/origins/e9661b10-9fbf-43ac-a5d5-0245945f2180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa354f7aca161cf4fba37be9e984bccb 2x, https://si.imgix.net/159e9b39/uploads/origins/e9661b10-9fbf-43ac-a5d5-0245945f2180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44491a79cfb4b49bd559d627fc9b3e1d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/159e9b39/uploads/origins/e9661b10-9fbf-43ac-a5d5-0245945f2180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1500726b101cce39ed238be9e2783624", "srcset": "https://si.imgix.net/159e9b39/uploads/origins/e9661b10-9fbf-43ac-a5d5-0245945f2180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1500726b101cce39ed238be9e2783624, https://si.imgix.net/159e9b39/uploads/origins/e9661b10-9fbf-43ac-a5d5-0245945f2180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&