6b\u3061\u306f\u3001\u3042\u306a\u305f\u306e\u4f5c\u54c1\u306e\u30d5\u30a1\u30f3\u3067\u3059\uff01\u3042\u306a\u305f\u306e\u7537\u6027\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u9854\u306e\u63cf\u304d\u65b9\u304c\u3068\u3066\u3082\u597d\u304d\u3067\u3059\uff01\n\n\u30cd\u30c3\u30c8\u306b\u30a2\u30c3\u30d7\u3055\u308c\u3066\u3044\u308b\u3042\u306a\u305f\u306e\u4f5c\u54c1\u306b\u76ee\u3092\u901a\u3057\u307e\u3057\u305f\u304c\u3001JJBA\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3092\u63cf\u3044\u305f\u4f5c\u54c1\u304c\u672c\u5f53\u306b\u5927\u597d\u304d\u3067\u3059\u3002\u7279\u306b\u30ea\u30be\u30c3\u30c8\u30fb\u30cd\u30ed\u306e\u7d75\u304c\u597d\u304d\u3067\u3059\u3002\u5f7c\u306f\u3042\u306a\u305f\u306e\u30b9\u30bf\u30a4\u30eb\u3067\u3068\u3066\u3082\u9b45\u529b\u7684\u3067\u7f8e\u3057\u304f\u898b\u3048\u308b\u3002\n\nJJBA\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u30a2\u30fc\u30c8\u3092\u304a\u9858\u3044\u3057\u3066\u3044\u308b\u306e\u3067\u3001\u3053\u306e\u3088\u3046\u306a\u30ea\u30af\u30a8\u30b9\u30c8\u3067\u3082\u5927\u4e08\u592b\u3060\u3068\u3044\u3044\u306e\u3067\u3059\u304c\u3002 \ud83d\ude47\u200d\u2640\ufe0f\n\n\u30ab\u30d7\u30c1\u30fc\u30ce\u3068\u30ea\u30be\u30c3\u30c8\u30fb\u30cd\u30ed\u3068\u3044\u3046OC\u306e\u7d75\u3092\u304a\u9858\u3044\u3057\u305f\u3044\u3067\u3059\u3002\u4e8c\u4eba\u306f\u604b\u611b\u95a2\u4fc2\u3067\u6697\u6bba\u8005\u3067\u3059\u3002\n\n[\u30ab\u30d7\u30c1\u30fc\u30ce| Cappuccino]\uff1a\n29\u6b73\u3002\u8eab\u9577166cm\uff08\u9774\u3092\u5c65\u3044\u305f\u72b6\u614b\uff09\u3002\u5973\u6027\u7684\u3067\u7b4b\u8089\u8cea\u306a\u4f53\u683c\u306e\u5927\u4eba\u306e\u5973\u6027\u3002\u6027\u683c\u306f\u7269\u9759\u304b\u3067\u7a4f\u3084\u304b\u3002 \u666e\u6bb5\u306f\u5916\u5411\u7684\u3067\u3001\u30d7\u30e9\u30a4\u30d9\u30fc\u30c8\u3067\u306f\u660e\u308b\u3044\u3002\n\n[\u30ea\u30be\u30c3\u30c8| Risotto Nero\uff3d\n28\u6b73\u3002\u8eab\u9577195cm\u3001\u7b4b\u8089\u8cea\u3002\n\u3068\u3066\u3082\u771f\u9762\u76ee\u3067\u30b9\u3