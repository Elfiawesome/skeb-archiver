.net/7b75c81a/uploads/origins/87f55b7c-3b8e-44f9-a3f0-e25a838a9fe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=167e45e2b37549e44137d817efe734f6", "src_set": ""}, "body": "こんにちは、初めてお目にかかります！ 台湾のvtuberです！\nあなたの作品が大好きなので、16:9のサイズでイラストをお願いしたいです。\n種族はダックス、身長は150、活発な女の子です。\n衣装情報：https://drive.google.com/file/d/1ZK0wNu0YfzQMikvgGSximLCiHJyOrrSq/view?usp=drive_link\n使用ヘアスタイル：https://drive.google.com/file/d/1m_obJbdpHrO2G7JlLV2sE3RzlrdGkUNW/view?usp=sharing\nご自由にお作りください！\n私の作品はライブ配信/映像制作/SNS共有/YTメンバーのテーブルクロス共有で使用させていただきます。\nありがとうございました！ありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2826340, "client_id": 76306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a3ec5d7/uploads/origins/71a27e16-cdc3-404b-8cae-46a0cb94be4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75e71b840bbadec640091a6e2d1c7f9b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a3ec5d7/uploads/origins/71a27e16-cdc3-404b-8cae-46a0cb94be4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d470e745e4c8ec35c5748ddf710350ca", "src_set": ""}, "body": "初めまして。今回ひだねぎ様の躍動感あるイラストと鮮やかな色彩に魅かれてリクエストをしたいと考えました。\n私の創作小説に出てくるオリキャラを用いたイラストを描いていただきたいです。魔法を使用した躍動感ある作品をお願いしたいです。\nhttps://drive.google.com/drive/folders/1DbsjFtrryKn_bFJuqUCoIiDY1a4bJ7Bx?usp=sharing\n\n・王国の第一王女でありながら前線で活躍する気の強い女性\n・炎を用いた広範囲殲滅型のバリバリなアタッカー\n・攻撃魔法にも華やかさと優雅さを取り入れるこだわりがある\n・胸は大きめで、服の上からでもその大きさと起伏が分かる\n\n縦長の作品であればそのほかの構図に関してはひだねぎ様にお任せいたします。\n\nそれではご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/132", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2826340, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a80c367e/uploads/origins/b265e403-8393-4146-8135-279327d0b21d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ee643a56ece7310b8c8eced6e29a7db", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a80c367e/uploads/origins/b265e403-8393-4146-8135-279327d0b21d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8347d7100e45ef5e37af60d350d0e1", "src_set": ""}, "body": "初めまして、VTuber準備中の月影あずみと申します。\nとても素晴らしいイラストをお見掛けし、是非描いて貰いたい！と思いリクエストを送らせていただきました。\n\n以下がリスエスト内容になります。\n\n【使用用途】\n･SNS宣伝やサムネイル（X、YouTubeなど）\n･PCの壁紙\n･ネップリ\nとして使用予定です。\n◎背景とキャラクターが分離されたPSDファイルをいただけると嬉しいです。\n\n【構図】\n･16:9のフォーマットでお願いします。\n･細かい構図はお任せしますが、オフでナイトプールに遊びに来た（カメラ目線）のイラストだと嬉しいです。\nその際、頭のてっぺんは見切れないように描いて頂けると幸いです。\n◎笑っている口と澄まし顔の口の差分を希望します。\n\n【背景】\n･ナイトプールの様な煌びやかな感じでお願いしたいです！\n\n【衣装】\n･水着の色、形はお任せします。\n（（出来れば上下分かれているような水着ですと助かります））\n\n\n【性格】\n明るい子ですが、少し性格がツンとしています。\n\n【参考文献】\n下記に添付します\n\n髪の色は2では無く 【月影あずみ】の方でお願いします。\n\n\nお忙しいところ恐れ入りますが、何卒宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1QRPi1CAQMQ5wBtlAv3Op-CeNYmpsOV_v", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2826340, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a61af43d/uploads/origins/f1b1fa4b-df55-4526-8b4a-22dbbd0da6c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d665b6e3d8e3ec4328755fca81dc31f1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a61af43d/uploads/origins/f1b1fa4b-df55-4526-8b4a-22dbbd0da6c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d26bf6daff1563e6f7d9744836b8c16e", "src_set": ""}, "body": "やあ、\nあなたのアートが大好きです。\nアスペクト比16:9の背景付き壁紙をお願いしたいです。\n私のキャラクターは赤い狐の女の子です。風景、ポーズ、全て自由に選べます。\nできれば、キャラクターと背景を分けてもらえますか？\nありがとうございました！\n\nPs:Twitchで使うかもしれません。\n\nhttps://drive.google.com/drive/u/1/folders/1XYYgRlykhRrj3K3_8pPuLP7XyxqxluDf", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2826340, "client_id": 3517033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34ab6a61/uploads/origins/5d768c60-d842-4c7a-84f5-74131b7d545e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f03bcea3694020cad3ff98856c139be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34ab6a61/uploads/origins/5d768c60-d842-4c7a-84f5-74131b7d545e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19d6919e2ae584ef0ad00e85a9c6caa8", "src_set": ""}, "body": "Thank you so much again for taking my pervious commissions! I was wondering if you could do another one for Yuna this time in her new outfit she just debuted. \n\nHer reference sheet: https://drive.google.com/file/d/1-Jw92UWuuhW6vRUFWanHAV9UvbSIr0s_/view?usp=drivesdk\n\nI'll leave the rest to you!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2826340, "client_id": 1552152, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89bc7e57/uploads/origins/8c2038f8-22c1-488b-b6fd-cec447fb590a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42a85c34930672075369f752da34d5dc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89bc7e57/uploads/origins/8c2038f8-22c1-488b-b6fd-cec447fb590a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4445e0ccf563fece655015616b868daa", "src_set": ""}, "body": "こんにちは！\nフランスのVtuber、Melibelluleのイラストを描いてもらえませんか？\nポーズは自由で、夏に向けてダイナミックでカラフルなものをお願いします！ありがとうございます！\n\nMelibelluleは、海犬と冒険に行くのが大好きな人魚姫です。\n人間界を発見するために、人間の姿になることもできます。\n\nありがとうございました。\n\n参照：https://daevasfashion.fr/melibellule-references/\n\nhttps://daevasfashion.fr/melibellule-references/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/128", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2826340, "client_id": 2564615, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74b2d748/uploads/origins/09742a46-a351-4626-9018-bd6cc26472fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3d1f055786caf3de7389dff6008e582", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74b2d748/uploads/origins/09742a46-a351-4626-9018-bd6cc26472fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e7034d7eea1721d1dbebdf945595d80", "src_set": ""}, "body": "ひだねぎ様\n\n初めてご連絡差し上げます\nCAMILLE と申します \n\nひだねぎ様の躍動感のあるイラストに惹かれてご連絡差し上げました\n\n私が推している麻雀VTuberの鴨神にゅう様(@Kamogami_new)を描いていただけないでしょうか\n\n麻雀で見せ場の一つとなる立直の場面を、躍動感のある形でお願いできますと幸いです\n\n構図は基本的にお任せしたく存じますが、ご参考として麻雀漫画「咲」を題材にした立直シーンが描かれたリンクをあわせてお送りします。\n\nなお、完成したイラストにつきましては、鴨神にゅう様ご本人が気に入られた場合には配信やサムネで使用されることや、私がXに掲載する場合がございます\n\nお忙しいところ恐れ入りますが、何卒宜しくお願い申し上げます\n\nCAMILLE \n\nhttps://youtube.com/@kamogami_new?si=Og1N4sRWWQ1V4BMA\n\nhttps://mangapedia.com/gd/riokco9zj", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/127", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2826340, "client_id": 3517033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b6ee924/uploads/origins/df999ea5-95d1-4f44-a2be-adb933c4b68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=880d3dc5fe13e06a9338f353a2ff8513", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b6ee924/uploads/origins/df999ea5-95d1-4f44-a2be-adb933c4b68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=54e736188bbaa1f66123f65f94fc32fb", "src_set": ""}, "body": "Thank you so much again for doing the artwork for Yuna! She loved it so much!\nI was hoping you could do another illustration, this time for her friend Astria Live\n\nHer reference sheet: https://x.com/AstriaLive/status/1731771553518616947\n\nI'll leave the rest to you!!", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hidanegi/works/126", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2826340, "client_id": 3327537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a3838d6/uploads/origins/04dc300e-7f88-4d50-898a-19ce08306d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=036d2680f9d7d688382fd71d062bbf33", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a3838d6/uploads/origins/04dc300e-7f88-4d50-898a-19ce08306d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d33c54b3a32209b7ad7d75a72ff17e2", "src_set": ""}, "body": "ひだねぎさん、こんにちは！\n\nSkebを探していたところ、幸運にもあなたの作品を発見しました！もしまだ新しい依頼を受け付けているようでしたら、私のゲームキャラクター（FF14）の依頼をお願いしたいです :D\n\n ポーズ、エモーション、背景はお任せしたいです。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/skeb-dnc-KOEo2nQ", "