-d2c8-42d5-a398-ba4f3a2889b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2027ca51bf2951c4e8b069702c51c5ec", "srcset": "https://si.imgix.net/292e497a/uploads/origins/f30e3734-d2c8-42d5-a398-ba4f3a2889b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2027ca51bf2951c4e8b069702c51c5ec, https://si.imgix.net/292e497a/uploads/origins/f30e3734-d2c8-42d5-a398-ba4f3a2889b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f809fd841c1e10cb84489dd014561b6 2x, https://si.imgix.net/292e497a/uploads/origins/f30e3734-d2c8-42d5-a398-ba4f3a2889b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa5689b4e667fa04d658c4b7a51a286c 3x"}, "body": "6月なのにあまりにも暑く、蒸れるので服をはだけて放熱・放湿しているタシュケントちゃん(ケッコン済み・指輪着用)をお願いします。格好としてはhttps://skeb.jp/@satsuki_tohka/works/4のように黒いインナーの上に赤いシャツを羽織るように纏い、白いコートは腰結びにしている感じです。水色のケープや帽子は近くに置いています。体躯はそこらの戦艦級顔負けの恵まれた体つき(特に胸部装甲)です。\n　団扇片手に少しでも涼もうとしているか、涼もうとしているところを提督に見られて赤面している、のどちらかでお願いします。可能であれば何かセリフをお願いしたいです。よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanyo_12/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3390084, "client_id": 485229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efc7c880c1a4c40e26be217f360711f0", "srcset": "https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efc7c880c1a4c40e26be217f360711f0, https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d00ed37ca1d416474d33c5a9aace9b53 2x, https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fea1ab500fee36b7ebd357e520a8120e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29d297addb15d5ca98940eb009f633a7", "srcset": "https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29d297addb15d5ca98940eb009f633a7, https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97576ea9cbb87dbd7943a58425f0f59d 2x, https://si.imgix.net/3d7f3534/uploads/origins/b855d698-ccb0-4011-8379-8acbddea741d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=916771820e3007dd8c40aad2b842949f 3x"}, "body": "どーも。\n\n先日の翔鶴ねえが素敵だったのでリクエストをお送りします。\n袴で締めることで身体のラインを拾うようになった上着に締めていることが伝わる服のシワの表現に感服しました。\n\n今回の仕様については…\n・キャラクターは艦これから荒潮改二\n・衣装ですが、満潮ちゃん秋刀魚モードの赤色芋ジャージ。原典にあるエプロンや腕章は不要です。\nご参考までに満潮ちゃんの全体図を投稿されている方のリンクを貼り付けます。https://x.com/Yuki_GF_/status/1053651564978565121\n・シチュエーションですが、着衣泳をしたレベルで芋ジャージがずぶ濡れになって、布地が肌に張り付いて身体のラインが出ている状態。健康美はあっても色気の欠片もないジャージが、濡れることで全く違う表情を魅せる様をたんよー様の絵柄と表現力で是非見たいのです。\n・身体をどこまで描くかや髪型、髪を濡らすか等の細部はお任せします。\n\n貴方様のレギュレーションに抵触するようでしたら、ご遠慮なく申請を却下してください。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tanyo_12/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3390084, "client_id": 36149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5399a8ce/uploads/origins/4cf7d43d-ded6-49b2-acae-4397809faa20?bg=%23fff&auto=format%2Ccompress&