愛おしくて、大好きすぎて資料のおまけにもあるように自分でも立ち絵めっちゃ錬成しました。\n庄田さまに描いてもらった立ち絵も、継続でもう十数回使わせてもらっています♡(本編現行前に自陣と何度も継続行ってたことがバレるやつ) \nほんまにありがとうございます……いつも感謝しております……(土下座)  \nこのリクは気が向いたらで構いません♡ご体調優先してくださいませ〜！\n\nhttps://drive.google.com/drive/folders/1mcmfFxWnB3p0AV4uvUUfm1oCWhT6AJ2U", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@codvShoda/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3101081, "client_id": 3478190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5dad6c6a/uploads/origins/22c7a671-ecf1-4bb9-acc3-87946086f1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38f6d266c72c487141f720046f396ad", "srcset": "https://si.imgix.net/5dad6c6a/uploads/origins/22c7a671-ecf1-4bb9-acc3-87946086f1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38f6d266c72c487141f720046f396ad, https://si.imgix.net/5dad6c6a/uploads/origins/22c7a671-ecf1-4bb9-acc3-87946086f1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf211f7d9a81c82f43dc7e973b932137 2x, https://si.imgix.net/5dad6c6a/uploads/origins/22c7a671-ecf1-4bb9-acc3-87946086f1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca08d61af730033112fb63c97818bf37 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5dad6c6a/uploads/origins/22c7a671-ecf1-4bb9-acc3-87946086f1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9db335f02c33e3aa6f24fcb9586cc943", "srcset": "https://si.imgix.net/5dad6c6a/uploads/origins/22c7a671-ecf1-4bb9-acc3-87946086f1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9db335f02c33e3aa6f24fcb9586cc943, https://si.imgix.net/5dad6c6a/uploads/origins/22c7a671-ecf1-4bb9-acc3-87946086f1a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=