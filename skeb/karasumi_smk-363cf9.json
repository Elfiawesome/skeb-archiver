まかせ致します。\n\n使用用途はTwitter(X)やMastodon、Misskey含む外部SNSでのアイコン、ヘッダー使用・イラスト紹介・紹介ツイートをtogetter(min.t)などの自身のまとめへ追加。\nリクエストする際に上記まとめのURLを引用する場合があります。\n\nPSD形式希望で、恐縮ですが宛名とキャラと背景のレイヤー分けをお願いします。分離不可の場合は統合状態を問いません。\nラフや下書きなどの途中経過を見せても良い場合は、レイヤー下に残していただけますととても嬉しいです。\nどうぞよろしくお願いします！\n\nまとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n資料URL\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm\n\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 16909, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "れく/れとまクロ：仕事&Skeb歓迎", "screen_name": "rexpace", "avatar_url": "https://pbs.twimg.com/profile_images/1044072305104760833/2kwXgMen.jpg", "header_url": "https://pbs.twimg.com/profile_banners/64716300/1523861264/1500x500", "appeal_receivable": false, "popular_creator_rank": 24, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 48}, {"id": 39910, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Flügel@単行本『くぎづけはーと♥』発売中！", "screen_name": "GUMI710", "avatar_url": "https://pbs.twimg.com/profile_images/1230812662201630720/b8TLh8eH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1440495836/1744669886/1500x500", "appeal_receivable": false, "popular_creator_rank": 92, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 449727, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "桃とまとはどう生きるのか", "screen_name": "MOMOmop_6927", "avatar_url": "http