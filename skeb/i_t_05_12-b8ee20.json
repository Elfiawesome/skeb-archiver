/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3550077, "client_id": 3988715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffd2e2abb705b50386907ae80816577", "srcset": "https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffd2e2abb705b50386907ae80816577, https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8726c201ea26e83cc375dedf64c05dd4 2x, https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd94e3cda425291d0e7c295344066c63 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0dde7696f4357d6b58548fdec5866f9", "srcset": "https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0dde7696f4357d6b58548fdec5866f9, https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c077064e59f4d26b006386e32038979d 2x, https://si.imgix.net/9409e2a9/uploads/origins/c77a6a98-1edb-4cde-a3c2-a0fa324e812a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95b358f4b7cd83d4e736df1773243a53 3x"}, "body": "初めまして！はんぺんさんのイラストが大好きで今回立ち絵リクエストを送信させて頂きました。\nCoC「遺香廻り」HO3の立ち絵を依頼したく思います！\n\n▋身長┊ 176cm男で、タレ目とふわふわした髪が特徴です。\n \n年齢は20代後半、色白でおっとりしていて\nいい匂いがしそうな感じで描いていただけたら助かります。\n\nまた、服装ですが職業警察官ですが、どちらかと言うと香水を作ったり研究向きでもあるので、すこしだぼっとした柔らかめのカーディガンを羽織っている（または肩掛け）とかだとうれしいです。\n基本的には描きやすいように書いて下されば幸いです……！\n\n・おっとりしているが、大人しいわけではなく表情は豊かで話す\n・性格は優しい真面目おっとり\n・なんだかいい匂いがしそう\n・髪は後ろは短く、薄い青みがかった黄緑、ふわふわしている\n・目は薄黄色\n・両頬にひとつずつホクロがある\n・タレ目まつげ長い\n・左耳のみ紫の中が空洞になったピアスをつけています。ここに香水などをいれたりします。\n\nバディの世話をよく焼いています。\n基本は優しいですがなにかダメなことをしたりすると叱ったりします。\n香水を作るのが大好きで夜な夜な新作の香水を作っては次の朝出勤前に自分とHO4にふりかけます。\n香水を作っている時は没頭していてご飯を食べるのも眠るのも忘れて机に突っ伏して寝落ちしていることもあります。\n\n｢新作の香水ができた、ほらHO4腕だして｣\n｢うん、いい香り。｣\n｢ちょっと担がなくてもいいよ！おろして！｣\n\n何事にも素直。\n強く抱き締めてしまえばなんだか壊れてしまいそうな雰囲気を纏っていたら嬉しいです。\n\n⚪️Google Drive(ネタバレなし)\n▶︎\nhttps://drive.google.com/drive/folders/1hNTYpGz6fEYk7F8_-d4isR7AGoYvWZCR\n\nです！\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@i_t_05_12/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afe6f58e/uploads/origins/ce359f66-6e58-40dd-95a0-71fe5e394557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b651f26183eab616062d844520ec13e1", "srcset": "https://si.imgix.net/afe6f58e/uploads/origins/ce359f66-6e58-40dd-95a0-71fe5e394557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b651f26183eab616062d844520ec13e1, https://si.imgix.net/afe6f58e/uploads/origins/ce359f66-6e58-40dd-95a0-71fe5e394557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f19b78b83a2a3c5724df25f796503e6 2x, https://si.imgix.net/afe6f58e/uploads/origins/ce359f66-6e58-40dd-95a0-71fe5e394557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&