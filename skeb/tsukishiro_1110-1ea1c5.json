e sassy cat girl! You can choose the pose and/or scenery! I like idol poses a lot, as well as flowers, hearts, and cat shaped decorations. You can also choose to add a small black cat in as her pet if you want!\n\nI'd love to see what you come up with! Please have fun! ^^ I'd like to share it on twitter if that's okay.\n\nReference: \nhttps://drive.google.com/drive/folders/1kE2rpr1sGIYLbsvx69XI61_6Z7N_YFn6?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukishiro_1110/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2226222, "client_id": 2046653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74ed1542/uploads/origins/449fde51-8450-4cb4-8ea9-f1be274e0ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032b562b5f0d48493e33bfb28f5c7858", "srcset": "https://si.imgix.net/74ed1542/uploads/origins/449fde51-8450-4cb4-8ea9-f1be274e0ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032b562b5f0d48493e33bfb28f5c7858, https://si.imgix.net/74ed1542/uploads/origins/449fde51-8450-4cb4-8ea9-f1be274e0ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f66e90dea4c8563cc9324ed69dde78a 2x, https://si.imgix.net/74ed1542/uploads/origins/449fde51-8450-4cb4-8ea9-f1be274e0ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97b43121d664016f655062fdab2495b4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74ed1542/uploads/origins/449fde51-8450-4cb4-8ea9-f1be274e0ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6081e1ecb757a42059188be1b76dbe40", "srcset": "https://si.imgix.net/74ed1542/uploads/origins/449fde51-8450-4cb4-8ea9-f1be274e0ac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=608