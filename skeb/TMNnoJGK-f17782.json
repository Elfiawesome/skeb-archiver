atsukizuna?t=K1v4acoQQsrTtllVt-8zjw&s=09\n\n（メインは上記キャラなのですが、ちびちゃんを始めシュンキチさんの描かれる緩い生き物も好きなので、可能でしたら世界観フォルダ内のマスコットを隅に添えていただきたいです……！）\n\n\n【その他要望】\n暗くて不穏な雰囲気でお願いします！\nそれから、解釈･解説の文を是非たくさん見せていただきたいです！\n\nまた資料フォルダ内の、企画内未公開設定として分けてあるもの(本名など)は、直接的に描写することは避けていただきたいのですが、解説があってわかる匂わせ程度に取り入れていただけるとすごく嬉しいです。\n匙加減が難しければ無理に取り入れていただかなくても大丈夫です！　ややこしい要望をしてしまい申し訳ありません。\n\n\n【作品の取り扱い】\n個人鑑賞･個人としてタイムラインで身内に共有したいと考えています。企画主催として運営アカウントで使用することはありません。\n\n\n金額不足等、問題ありましたらお手数お掛けしますが再送要請よろしくお願いいたします。\n\n長文失礼いたしました。何卒よろしくお願い申し上げます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@panyanyan_Ch0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2748813, "client_id": 879841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1db23bf0/uploads/origins/d8dbdaa3-bca2-4e9c-bba6-a5126b454163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=689effb6fffaa5a91e8c9ec54a9be1fc", "srcset": "https://si.imgix.net/1db23bf0/uploads/origins/d8dbdaa3-bca2-4e9c-bba6-a5126b454163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=689effb6fffaa5a91e8c9ec54a9be1fc, https://si.imgix.net/1db23bf0/uploads/origins/d8dbdaa3-bca2-4e9c-bba6-a5126b454163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ff0c752c09784dacc465dd53557145d 2x, https://si.imgix.net/1db23bf0/uploads/origins/d8dbdaa3-bca2-4e9c-bba6-a5126b454163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=941c5c2932a48d9acd532b1b58b6a180 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1db23bf0/uploads/origins/d8dbdaa3-bca2-4e9c-bba6-a5126b454163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db31a7d2f98a0462542d71e35c73f3ff", "srcset": "https://si.imgix.net/1db23bf0/uploads/origins/d8dbdaa3-bca2-4e9c-bba6-a5126b454163