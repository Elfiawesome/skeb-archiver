core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cff3996/uploads/origins/b078cb54-33a1-44ba-b6d6-4fa89c807593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c503739a48b92ab7996bb34cbc3997d", "srcset": "https://si.imgix.net/4cff3996/uploads/origins/b078cb54-33a1-44ba-b6d6-4fa89c807593?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c503739a48b92ab7996bb34cbc3997d, https://si.imgix.net/4cff3996/uploads/origins/b078cb54-33a1-44ba-b6d6-4fa89c807593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff4fa1f800ff887bb90b864f13583b2 2x, https://si.imgix.net/4cff3996/uploads/origins/b078cb54-33a1-44ba-b6d6-4fa89c807593?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e797fa4fedbc2d2cc1e834ea34dd627 3x"}, "body": "Thank you for your continued support. I am Shain.\nI have long wanted to see a shishio, and I have made a request to see it.\nI have already become a person whose blood boils with excitement in any form as long as it is Takatani-san's shishio, but I cannot resist my desire to see more shishio, so I am requesting Uchiyo in this way by legal means.\nI am not able to resist the desire to see more shishio, so I am demanding uchiyose in this way by legal means.\nI would like to ask you to do a shishio at the end of my scenario \"Tidal Judgement,\" a scene on a beach at sunrise.\nI really want to see the scene drawn with the clear air and flowing texture of Mr. Takatani's illustration.\nYou are free to do whatever you like with the composition, color scheme, interpretation, and other details.\nI would appreciate it if you could accompany me in my desire to see Takatani's image. Thank you in advance. Please help me. Kashiko.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1tktn1/works/1", "private_thumbnail_image_urls": null, "private": false,