6036a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0847266a1383eaf1c829e8cb41d3735b 2x, https://si.imgix.net/49261a8f/uploads/origins/04674cd9-198d-4350-94d5-804abc6036a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ee220d926fbab97e6492102c8a6aa2d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49261a8f/uploads/origins/04674cd9-198d-4350-94d5-804abc6036a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761d8aa1da305079b18ff0b8d2c800a5", "srcset": "https://si.imgix.net/49261a8f/uploads/origins/04674cd9-198d-4350-94d5-804abc6036a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=761d8aa1da305079b18ff0b8d2c800a5, https://si.imgix.net/49261a8f/uploads/origins/04674cd9-198d-4350-94d5-804abc6036a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=403c19b3badcde3a5a255bdb4d46df8a 2x, https://si.imgix.net/49261a8f/uploads/origins/04674cd9-198d-4350-94d5-804abc6036a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0face04382e09ae61cececad4589d93d 3x"}, "body": "ナコ様、はじめまして\nいつもＸにて素敵なイラストをたくさん拝見させております！skebをご開設されたポストを見かけまして、\nぜひリクエストをお願いしたいです。！\n\nもし可能であれば、私のOC二人をお願いしたいです！  \n\n・海世くらりん \nクラゲをイメージしたキャラで髪色は淡い水色＋毛先ピンクのグラデーションで、目の色はゴールドとなります。髪にはクラゲのクリップをつけている。 天真爛漫で陽気な子で、水族館巡りが趣味です。海にあるものがすきで、塩辛ものが嫌いです。 水族館の隣にある喫茶店を常連している。ブルーハワイのクリームソーダとプリンがいつも注文する。 いつもクラゲのマスコットを持ち歩いている。  よくロード・ナイトのところに甘えたりしていて、スキンシップがすき。  \n\n・ロード・ナイト \n宝石の魔女で、右目はいつも閉じているが、開けたピンク色の涙が出てきます。 彼女は賢くてクールな子で、魔法学校の学生である。普段は錬金術のお仕事もしていて、空いている時間はバレエの練習をする。 家のお庭を定期的にお手入れするのが習慣であって、園芸に対して深い学識を持っている。 お茶会をするのがとてもすきで、ローズのハーブティをよく飲んでいます。 イチゴとラズベリーが大好物です。 傍にはウサギの使い魔がいます。よく魔女さんのガーデニングにサポートし、植物とコミュニケーションをとることができる。耳にいくつかの宝石がついて、その宝石は癒しの力が秘めている。  \n\n 服装もポーズはすべてお任せ致します！ 新しい衣装大歓迎です！！  \n使用用途は個人観賞、SNSアイコンなどとなります。 \nもし金額が不足していましたら、お手数ですが再送のほどよろしくお願いいたします。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1LjTIu6ZOqmjNH2hrPfOR814elQgiCZa_?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@naco_artworks_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2302554, "client_id": 2272271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a281a0cd2cb648730771c47347c62f97", "srcset": "https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a281a0cd2cb648730771c47347c62f97, https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18abf95c52d0d6ee7a6cff6db324fb7e 2x, https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b6cd3e251d25c9544553463f1976a49a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06caa1ca3d073e5beffe8d06325762e7", "srcset": "https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06caa1ca3d073e5beffe8d06325762e7, https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e121b050ffe2dd23ed817fd8fc38b053 2x, https://si.imgix.net/c231107b/uploads/origins/b9764516-3346-4cb6-8dc0-74bfc0904f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26c0849fb3be9c6359184e484030f1c8 3x"}, "body": "こんにちは、こんにちは！またまたBlooです〜 ここでオープンしたのを見た瞬間、応援したくなりました🩵。\n\nナイフを顔の片側に当てながら、遠近法のアングルで座っている制服姿の悔しそうなコハクを見てみたいです。ナイフの反射の中で、メイン衣装のコハクが泣いている。シーンの小道具は、破れたぬいぐるみの詰め物、散乱してクシャクシャになった書類、何枚かのシートに黒い落書き、そして最後に彼女のバッグは開けっ放し。これは私のタフな一面を表現するためですが、心の底ではまだ感情を隠している泣き虫なんです。\n\n彼女の靴下とバッグのアクセサリーの参考を提供した（どんなキーホルダーや装飾があるかは自由！青と白の悲しい美学を貫いてください！)\n\nhttps://drive.google.com/drive/folders/1EW0wBNjru7fZ5OMwY9kJ8B4PKzHgYEhT", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 993483, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "木犀", "screen_name": "mokusei0516", "avatar_url": "https://pbs.twimg.com/profile_images/1717418282679242752/kNfpaaa7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1334448316436762624/1696083071/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2340273, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おᒐ\"ぃ", "screen_name": "marumetu100", "avatar_url": "https://pbs.twimg.com/profile_images/1951615328129323008/wk1q6ont.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1460876608429260800/1749384314/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2595104, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "浅縹のま", "scre