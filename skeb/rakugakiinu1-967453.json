な見た目になりたくて自分で変えています。\n能力は変身能力(手足を恐竜に変化させて戦う)\n\nラズはファージルに6歳の頃に拾われ、それからファージルパパが大好きな設定です。\n2人は仲のいい親子で、お互いにお互いが何より大切な存在で距離感近めです。\n\nもし料金的に難しければファージルのみでかまいません！\n衣装や髪型なども自由に変えて頂いてかまいません🙇‍♂️\n構図やシチュエーションなど全て笑颜様のお好きなように描いていただけますと幸いです( ¨̮ )♡\n長々と失礼しました🙇‍♂️ご検討よろしくお願いいたします。\n\nクロスフォリオのキャラクター欄▶︎ https://xfolio.jp/portfolio/0GRM/free/340667\n\nhttps://drive.google.com/drive/folders/1AneNO27-fam7PqZ_h5-uc8YJrtIKijss", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rakugakiinu1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3795120, "client_id": 2626686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/beb93f95/uploads/origins/5b09e200-c23f-4823-b44a-91fbeb60a5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a8b8402340df2e10e6803d241bb4b63", "srcset": "https://si.imgix.net/beb93f95/uploads/origins/5b09e200-c23f-4823-b44a-91fbeb60a5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a8b8402340df2e10e6803d241bb4b63, https://si.imgix.net/beb93f95/uploads/origins/5b09e200-c23f-4823-b44a-91fbeb60a5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c53352b7d0b9a05ec79a00f1501d0d2 2x, https://si.imgix.net/beb93f95/uploads/origins/5b09e200-c23f-4823-b44a-91fbeb60a5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e3291875dc2e68712d219a36d29c7b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/beb93f95/uploads/origins/5b09e200-c23f-4823-b44a-91fbeb60a5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3c0a9deb1fe0a93736688c88b238617", "srcset": "https://si.imgix.net/beb93f95/uploads/origins/5b09e200-c23f-4823-b44a-91fbeb60a5a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3c0a9deb1fe0a937366