a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45b1c4ea239ba4f7ffcf10cfe111c15f", "srcset": "https://si.imgix.net/ca633ed0/uploads/origins/1970a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45b1c4ea239ba4f7ffcf10cfe111c15f, https://si.imgix.net/ca633ed0/uploads/origins/1970a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f7407bfbd4b41bf34f38e9c6312775f 2x, https://si.imgix.net/ca633ed0/uploads/origins/1970a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59a4ea4cb4c20568298803c619f62762 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca633ed0/uploads/origins/1970a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed6d0f4db1a2cf406bcf73eb3cba0f52", "srcset": "https://si.imgix.net/ca633ed0/uploads/origins/1970a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ed6d0f4db1a2cf406bcf73eb3cba0f52, https://si.imgix.net/ca633ed0/uploads/origins/1970a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87af4267dc294addee33a7c06b92d7ec 2x, https://si.imgix.net/ca633ed0/uploads/origins/1970a22d-eba5-48de-9275-76613c7bff07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=905e530078630fc09bde15f7c77914a3 3x"}, "body": "はじめまして こんにちは\n素敵なイラストにひかれて依頼のリクエストを送りました\nお忙しいところにリクエストをして申し訳ありません\nよろしければうちの仔の鳥人のフェロを描いてもらいたいです！\n\nリクエストの内容は､うちの仔のフェロが武器を持っている姿を描いてください\n後ろ姿から何かを狙っている感じで右手に長弓を持っている感じでお願いします\n【可能であれば長弓と矢筒が見える感じして頂ければ嬉しいです】\n長弓は自身の身長よりも大きい感じです\n矢筒も参考イメージにある長弓の矢と大きさのを尾羽の裏側辺りに着けているイメージです(参考イメージのように矢筒は横向きで口も左側にある感じでお願いします)\n背景などえるみかちゅうさんに全てお任せ致します\n\n【キャラの設定】\n身長は「160㎝」\n年齢は『14歳』\nまったりと冒険を楽しんでいる鳥人の少年\n戦闘スタイル､長弓\n多少だが風を操れたり､自身の周りに気流を起こせる\n\n【分かりにくい部分の補足】\nもみあげと後ろ髪はバラれないよう根元部分を簡単なもので止めています\n翼部分は手の代わりにもなっています\n\nわからない部分などは先生にお任せ致します\nよろしければ､よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/1tYH664GlZuHM1C1nzCKvp09F_YlWEmxp?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@elmikachu_req/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1928007, "client_id": 2765268, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/075f4257/uploads/origins/83e23383-f4dd-4eb2-8891-a74aa7dcb0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1e34608cb4ef02a89839a0f58145de7", "srcset": "https://si.imgix.net/075f4257/uploads/origins/83e23383-f4dd-4eb2-8891-a74aa7dcb0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1e34608cb4ef02a89839a0f58145de7, https://si.imgix.net/075f4257/uploads/origins/83e23383-f4dd-4eb2-8891-a74aa7dcb0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00f0277132a5f1c37e608831f735f24a 2x, https://si.imgix.net/075f4257/uploads/origins/83e23383-f4dd-4eb2-8891-a74aa7dcb0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0d902bdb1c8a3d72837f5748b1815628 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/075f4257/uploads/origins/83e23383-f4dd-4eb2-8891-a74aa7dcb0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea56ed63ec251423fd5183357d26102c", "srcset": "https://si.imgix.net/075f4257/uploads/origins/83e23383-f4dd-4eb2-8891-a74aa7dcb0d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea56ed63ec251423fd5183357d26102c, https://si.imgix.net/075f4257/uploads/origins/83e23383-f4dd-4eb2-8891-a74aa7dcb0d2?bg=%23ff