図等】\nチ桑大様のセンスで好きに描いていただけたら嬉しいです‥！\n髪型もツインテール、ポニーテール、ショートなど色々できますが、お好きな方または自由に変形できるので、お好きに調理していただけたら光栄です。\nそれだと困る場合は下記のシュチュお願いできたら嬉しいです。\n・ツインテを両手に持って顔隠して照れてる\n・仰向けで寝落ち。髪型はおろした状態だと嬉しいです\n・ハンバーガー頬張ってる。または非常食を摘んでる\n\n下記は可能な限りで問題ございません。\n・完全に私欲ですが表情差分が少しでもあると至福です・・！\n・背景と人物が別レイヤーのpsdだとありがたき幸せです。\n・髪の毛や服等が見切れず画面内に納めていただけたら、サムネイルに使いやすいので大変助かります。\n\nご検討いただけたら光栄です。\nどうぞよろしくお願いいたします。\n\n漣月うみ\n\nhttps://kujiraya.work/%e7%a4%be%e5%a4%96%e7%a7%98%ef%bc%9a%e6%bc%a3%e6%9c%88%e3%81%86%e3%81%bf%e5%8f%82%e8%80%83%e8%b3%87%e6%96%99/", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tikuwa_hf7781/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3984535, "client_id": 1623056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58b2da48/uploads/origins/90ba8994-2092-4a3a-9177-c92b83c3f330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc81625ed64ffa6d518058d61c2d7785", "srcset": "https://si.imgix.net/58b2da48/uploads/origins/90ba8994-2092-4a3a-9177-c92b83c3f330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc81625ed64ffa6d518058d61c2d7785, https://si.imgix.net/58b2da48/uploads/origins/90ba8994-2092-4a3a-9177-c92b83c3f330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd11121bfeb57e1b80bcd4f5274e99e8 2x, https://si.imgix.net/58b2da48/uploads/origins/90ba8994-2092-4a3a-9177-c92b83c3f330?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7edbe67163767cbe5e97f5c0c04b603f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58b2da48/uploads/origins/90ba8994-2092-4a3a-9177-c92b83c3f330?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0da47685ff3590883b1728c07b3a3fe", "srcset": "https://si.imgix.net/58b2da48/uploads/origins/90ba8994-2092-4a3a-9177-c