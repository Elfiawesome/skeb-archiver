y16vj7BHrEvqmRw8zTtqVB4ZS\n\n構図等はお任せで、お好きに描いていただければと思います。\n\n【使用用途】\n・個人観賞用で、SNSにも掲載させていただきたいです。商用利用の予定はありません。\n・個人的に楽しむ目的のグッズ(アクスタなど)を作成する可能性があります。\n\nファイル形式はPNGで、可能であれば透過版もいただきたいです。\n金額等の不足がございましたら御手数ですが再送要請をお願いします。\n\nご検討よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 462023, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ゆきじろう", "screen_name": "yukijiro02a", "avatar_url": "https://pbs.twimg.com/profile_images/1864397058498809856/O-thg7a9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1165170121993646081/1677135276/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 871975, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "健康❣️", "screen_name": "pakipakiiishi", "avatar_url": "https://pbs.twimg.com/profile_images/1704723129929736192/R_51ZIhE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1318460478893428741/1738250584/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 1869936, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "rikka🌸", "screen_name": "Sjtih9hMzX", "avatar_url": "https://pbs.twimg.com/profile_images/1904034922714820608/mKPfDckJ.png", "header_url": "https://pbs.twimg.com/profile_banners/1371158234568871938/1743031215/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": n