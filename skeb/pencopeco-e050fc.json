ら、白か水色」\nにしてください。（以前、汲んで頂けなかったことがあるので、強い書き方で申し訳ございません）\n\nご縁がありましたら嬉しいです。\n宜しくお願い足します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pencopeco/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3814654, "client_id": 3653593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8adfa1c697fe1d0bf597f6a6d313859e", "srcset": "https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8adfa1c697fe1d0bf597f6a6d313859e, https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd86e7fe778959493f073b4ebdfc894c 2x, https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecd3bec42460f6a555358244cc3b10e5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fc128b9f7831dc18e0a945c8092a1c6", "srcset": "https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fc128b9f7831dc18e0a945c8092a1c6, https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c0dbad9561d0481b5c663408616f4df 2x, https://si.imgix.net/255d24e2/uploads/origins/fe5eea76-788b-41bd-bda1-a8de03c7e69c?bg=%23fff&auto=for