folders/1yEvdxGIjQDcSo6elaX6gBMYpHSXb5Otk?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kchi_9/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3891642, "client_id": 3963551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=482a6f5e469f29303cecc0fe487fdaa6", "srcset": "https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=482a6f5e469f29303cecc0fe487fdaa6, https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c0ed55352f4202a964e12bdf13dd674 2x, https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8684b0ac567fee8bcf8ce10b78cd37aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6173b5912dfcd9fa1cb31b99137a9ba", "srcset": "https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6173b5912dfcd9fa1cb31b99137a9ba, https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c195aacdb3a1a4e16df39fab8e768490 2x, https://si.imgix.net/ebda8e2b/uploads/origins/2b8819da-a355-4df8-adf6-fba1090ad281?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d51acea29ff98549fb53718777ac6106 3x"}, "body": "遅効性様\n\nはじめまして。\n歌ってみたの動画投稿をしている紫紅メ乃ア(しぐれ めのあ)と申します。\nTwitterのおすすめ欄からイラストを拝見し、素敵な作風に惹かれたのでリクエストのご連絡をいたしました。\n\n▶︎イラスト内容 \n歌い手｢紫紅メ乃ア｣のイラストを背景の有無も含め、遅効性様の思う様に描いていただきたいです。\n\n▶︎希望納品形式 \n可能であればキャラクターと背景(有りの場合)がレイヤー分けされているpsdデータ・キャラクター透過pngデータで頂戴出来ますと嬉しいです。  \n\n▶︎用途 \n個人鑑賞、また、各SNS・プラットフォームでのアイコン・ヘッダー・サムネイル・ショート尺歌ってみた音源との組み合わせ・活動者向け素材との組み合わせ等、活動の際に使用させていただきたいです。 \n(紫紅メ乃アの各SNS・プラットフォームは全て収益化はしておりません。)\n使用の際は、遅効性様のTwitterアカウントを概要欄・Twitterのツイート文に記載させていただきます。\n使用用途によっては透かし等入れさせていただきます。 \n\n何卒、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1D5Zi5Vwld2Mnc2l9TjMsiADhk85yxh1y", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kchi_9/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3891642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/844c0fc3/uploads/origins/45559d7f-6d7e-45e9-a9a2-c408d72a9d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed4a796c310796c822f101a10005f68a", "srcset": "https://si.imgix.net/844c0fc3/uploads/origins/45559d7f-6d7e-45e9-a9a2-c408d72a9d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed4a796c310796c822f101a10005f68a, https://si.imgix.net/844c0fc3/uploads/origins/45559d7f-6d7e-45e9-a9a2-c408d72a9d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e76f2217918f624bee688a51d003371 2x, https://si.imgix.net/844c0fc3/uploads/origins/45559d7f-6d7e-45e9-a9a2-c408d72a9d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71cecb53c91547cd5691301318caa0ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/844c0fc3/uploads/origins/45559d7f-6d7e-45e9-a9a2-c408d72a9d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33fddda3