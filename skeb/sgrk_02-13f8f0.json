igins/2507ad41-885b-4797-be25-f939f1c5ef2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f85a17c26592491d8469d0a6d2e30627, https://si.imgix.net/5013771c/uploads/origins/2507ad41-885b-4797-be25-f939f1c5ef2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98c027f132b306ac72c598dbdad12889 2x, https://si.imgix.net/5013771c/uploads/origins/2507ad41-885b-4797-be25-f939f1c5ef2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c9a0e665e552b3ed66f921c6c491a1c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5013771c/uploads/origins/2507ad41-885b-4797-be25-f939f1c5ef2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d7160c0664e7796c806445ce62e8f9", "srcset": "https://si.imgix.net/5013771c/uploads/origins/2507ad41-885b-4797-be25-f939f1c5ef2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74d7160c0664e7796c806445ce62e8f9, https://si.imgix.net/5013771c/uploads/origins/2507ad41-885b-4797-be25-f939f1c5ef2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28a3ea63f8ba81b1f6289238cd3876f9 2x, https://si.imgix.net/5013771c/uploads/origins/2507ad41-885b-4797-be25-f939f1c5ef2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d260f6bbf0bfca59e02800a1e309886d 3x"}, "body": "Hello! I was instantly captivated by your artwork… I really love your unique style 🥺 It would be wonderful if I could invite you to draw my OC 🩷\n\nPersonality: as a willow spirit who took human form too early, she cannot understand human emotions, so most of her expressions are just clumsy imitations of people.\nBackground: she doesn’t understand death. She once watched someone important to her disappear in flames, buried her in the soil, and waited for spring, believing her friend would bloom again like flowers.\nDesired composition: I’d love to see her in a kimono holding a lit sparkler, showing real emotion for the first time—unaware that she’s revealing a faint sense of loneliness or weariness. (If this pose is difficult, please feel free to design it freely—the main wish is for her to have a subtle, unintentional expression of slight weariness.)\nNote: her eyes are green with touches of red 🥰\n\nI truly love your art, and it would be such a blessing to work with you 💍 Thank you for reading!（If it’s possible, I’d love to request some chibi versions too 🥺🩷🩷 They’re just too cute…）\n\nhttps://drive.google.com/drive/folders/1EmvDPp8nvzsw6RyvwsNc2aCAE0enbIJC", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sgrk_02/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3640869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92cc027cf69f0fdd8da9946ff2671222", "srcset": "https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92cc027cf69f0fdd8da9946ff2671222, https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9fc8caddffab58477cf7a519109712f 2x, https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b76d70758f2f469dc1bf4bd35b84ef62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6444166a38ddeff112e5c0f3b59ba9b0", "srcset": "https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6444166a38ddeff112e5c0f3b59ba9b0, https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4dcf4ebadda0680d62d07d510ac11e1 2x, https://si.imgix.net/99d787bd/uploads/origins/7390e2f7-fe1c-42e9-84b3-5bd72e09575c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1be69297d70dc1ebee7b68faa1187a 3x"}, "body": "62様、初めまして\n\nTwitterにてイラストを見かけた際に「ものすごくとても好みな絵柄の絵師様だ……！！もしskebを依頼するのならこんな魅力的な線で描かれる方にお願いしたい！」と思いまして、リクエストさせていただきました。何卒よろしくお願いします。\n\n自分自身の代理のオリキャラをお願いします。\n\n性別･女\n髪型･長めのウルフカット(長さはおまかせ)\n服装･メンズライクなコーデ\nモード×カジュアルなテーラードジャケットだと嬉しいです\n右か左のどちらかにイヌ科のケモ耳があると嬉しいです(つけ耳のような感じ)\nイメージとしては、普通の現代人っぽいけど、実は妖が化けていて……？みたいな感じです(無視してもらって構いません)\n\n構図やポーズ、シチュエーション等お任せでお願いします！\n使用用途等は特にありません。ファイル形式やサイズ等もお任せでお願いします。\n\nご検討のほどよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sgrk_02/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3640869, "client_id": 3354959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8686ccb3/uploads/origins/f947d9b6-f6b8-4877-865e-7b4fcf662374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef496eaa50bae0ceee1720ecf0efbf1f", "srcset": "https://si.imgix.net/8686ccb3/uploads/origins/f947d9b6-f6b8-4877-865e-7b4fcf662374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef496eaa50bae0ceee1720ecf0efbf1f, https://si.imgix.net/8686ccb3/uploads/origins/f947d9b6-f6b8-4877-865e-7b4fcf662374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=989942717eed81080ca1b2c4934d663e 2x, https://si.imgi