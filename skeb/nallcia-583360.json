rop=top&w=200&h=200&blur=200&s=c1c5b50ea3dc589f04f1482aba1df85a", "srcset": "https://si.imgix.net/11ee60c8/uploads/origins/11e995f7-1415-4f76-ae29-30748ae2d6e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1c5b50ea3dc589f04f1482aba1df85a, https://si.imgix.net/11ee60c8/uploads/origins/11e995f7-1415-4f76-ae29-30748ae2d6e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0276f03f427c4c7fb7c85749e91c9f5 2x, https://si.imgix.net/11ee60c8/uploads/origins/11e995f7-1415-4f76-ae29-30748ae2d6e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d5cee0edb49aaa676f8a40221892df45 3x"}, "body": "ナルさん、こんにちは。あなたの作品が大好きで、イラストを依頼したいと思っています。『ファイアーエムブレム』のルキナが、『原神』のガニュウの衣装を着ているイラストをお願いしたいです。少し照れたような表情が最も似合うと思います。イラストは少なくとも胸から上を、この衣装では胸は小さめにしてください。ルキナのティアラとガニュウの角はそのまま残してほしいです。 ポーズは、片方の腕を下ろし、もう片方の腕を前に伸ばした感じにしてください。左目に印がありますが、小さくて複雑な場合は描かなくても構いません。可能であれば、このイラストはスマホのロック画面用なので、縦横比を9:16にしてください。参考用にリンクを以下に貼っておきます：https://imgur.com/a/q8vdcwA\n\nこのイラストのアイデアをご検討いただき、ありがとうございます", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nallcia/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2131567, "client_id": 3537243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44461fd1703d3b3108a3585eab8ac3b5", "srcset": "https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44461fd1703d3b3108a3585eab8ac3b5, https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9e60f55ae2bcbcd79ef807d696a56cd 2x, https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44d3ad9edbc59cda67124513d7ace871 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b284b25b67840dad05c87cecbd83d607", "srcset": "https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b284b25b67840dad05c87cecbd83d607, https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6539c3e47a74d7e42b43575de4e5c92 2x, https://si.imgix.net/82838169/uploads/origins/514709b8-d997-4402-b3a8-af6050309374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20f058ac8ac15bcf0e42b7ef18a22c46 3x"}, "body": "なる様初めまして。\n\n私の推し「夢未らむ」さんのイラストを依頼したいです。\nX：https://x.com/Lamb_yumemi\nTwitch：https://twitch.tv/ram_2828\n\n◾︎リクエスト内容\n・衣装は【原神】のキャラクター「珊瑚宮心海」\n・その他はお任せ\n・背景ございましたら透過verも頂けると嬉しいです\n頭の先や髪の毛などは、先端まで切れないように作画頂けますと大変嬉しいです。\n\n◾︎用途\n・アイコンやヘッダーとして使用\n・配信での使用（収益化済みのチャンネル）\n・メンバーシップなどの有料コンテンツでの配布\n\n◾︎納品方法\n・PSD形式で頂けると大変助かります\n\nご検討宜しくお願い致します。\n\nもし金額や内容に問題や不足がある場合は大変お手数をお掛けして申し訳ないのですが再送して頂けますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nallcia/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2131567, "client_id": 3206269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc41e3f8/uploads/origins/cb7c352d-7af2-4e6a-b5b2-41c840f89924?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db2f3d8fb64f0b55551abba74a8f55dd", "srcset"