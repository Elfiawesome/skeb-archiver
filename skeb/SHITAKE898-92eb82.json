le.com/drive/folders/1w7komEwWHo4-PFX-3zej4hqhmN-8OZ3_\n\n【希望するシチュエーション】\n椎丈様の暗めの色彩がとても好きなので、良ければこの子を上記のskebイラストのような少し暗いテイスト＆妖しげな人外らしい雰囲気で描いていただけたら嬉しいです。\nその他の構図やポーズ、背景、服装などは全て椎丈様にお任せしたいと思っております。\n\n【使用目的】\n個人鑑賞と、SNSのアイコンやヘッダーに使わせていただけたら嬉しいです。\n\nもし難しいリクエストだったり、不明な点がある場合はお気軽にキャンセル・再送してくださればと思います。\nご検討いただけますと幸いです。よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHITAKE898/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3496217, "client_id": 3159129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/043af28c/uploads/origins/59749053-a36e-4baa-89ef-17f4a5b6abd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d3d3e29c196ad7fa34908dd11652aa", "srcset": "https://si.imgix.net/043af28c/uploads/origins/59749053-a36e-4baa-89ef-17f4a5b6abd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56d3d3e29c196ad7fa34908dd11652aa, https://si.imgix.net/043af28c/uploads/origins/59749053-a36e-4baa-89ef-17f4a5b6abd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0ef587431e3f312b450b4136cec242f 2x, https://si.imgix.net/043af28c/uploads/origins/59749053-a36e-4baa-89ef-17f4a5b6abd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c8fa0b45853cbb35f1999d31b84df6e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/043af28c/uploads/origins/59749053-a36e-4baa-89ef-17f4a5b6abd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3995c99f34200320590e41faa71789a3", "srcset": "https://si.imgix.net/043af28c/uploads/origins/59749053-a36e-4baa-89ef-17f4a5b6abd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3995c99f34200320590e41faa71789a3, https://si.imgix.net/043af28c/uploads/origins/59749053-a36e-4baa-89ef