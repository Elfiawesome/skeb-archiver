というくらい初々しい反応をしている。\n立ち絵にいる幽霊の事は見えてない。\n┈┈┈┈┈┈┈┈┈┈\n 2人の楽しそうor幸せそうな雰囲気のイラストが見たいです\n細かいシチュエーションや構図などは24回転さんの自由に描いてください\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-bk3fVNEcjIbOmB7hSJrRyG9NRaFuWIL", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@kajiki__/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3407760, "client_id": 3405686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f4958f3/uploads/origins/2107476a-5194-49df-940c-88106654be3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69027745bdad3d569448ce9dfa831b6", "srcset": "https://si.imgix.net/6f4958f3/uploads/origins/2107476a-5194-49df-940c-88106654be3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d69027745bdad3d569448ce9dfa831b6, https://si.imgix.net/6f4958f3/uploads/origins/2107476a-5194-49df-940c-88106654be3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb4e637faa93bb6f7dc66eb655696aa0 2x, https://si.imgix.net/6f4958f3/uploads/origins/2107476a-5194-49df-940c-88106654be3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa0bc3a469d192c58e8a5fbaae9e01b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f4958f3/uploads/origins/2107476a-5194-49df-940c-88106654be3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=525026ff22a08e90d855ab038686abc3", "srcset": "https://si.imgix.net/6f4958f3/uploads/origins/2107476a-5194-49df-940c-88106654be3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=525026ff22a08e90d855ab038686abc3, https://si.imgix.net/6f4958f3/uploads/origins/2107476a-5194-49df-940c-88106654be3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9f