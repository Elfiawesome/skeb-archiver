願いします。\n\n\n・シチュエーション\nサトノダイヤモンドがトレーナーの体をダイヤの左手側に向けて仰向けで膝枕しているシチュをお願いします。\n膝枕しながら左手でトレーナーのお腹を撫で、右手でラトル(ガラガラ)を鳴らしてあやしている、でちゅね遊びサトノダイヤモンドバージョンという感じでお願いします。\nダイヤは優しげな笑みでトレーナーを見下ろし、トレーナー側はダイヤの母性に溺れて為す術なく甘やかされている状態。\n\n\n以上をお願いします。\nお忙しい中恐れ入りますがご検討お願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaspe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1445622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76b93998/uploads/origins/55dc4fab-cad8-4d68-9ac8-644f22ff91e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81314ab83e8a0cb717c280d9c7469283", "srcset": "https://si.imgix.net/76b93998/uploads/origins/55dc4fab-cad8-4d68-9ac8-644f22ff91e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81314ab83e8a0cb717c280d9c7469283, https://si.imgix.net/76b93998/uploads/origins/55dc4fab-cad8-4d68-9ac8-644f22ff91e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15852d5d0eaf702683e2102e0e098eda 2x, https://si.imgix.net/76b93998/uploads/origins/55dc4fab-cad8-4d68-9ac8-644f22ff91e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f337e50284e79da2588c9783e6578ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76b93998/uploads/origins/55dc4fab-cad8-4d68-9ac8-644f22ff91e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=621c872cad5d1ea9729950f7ece003ef", "srcset": "https://si.imgix.net/76b93998/uploads/origins/55dc4fab-cad8-4d68-9ac8-644f22ff91e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=621c872cad5d1ea9729950f7ece003ef, https://si.imgix.net/76b93998/uploads/origins/55dc4fab-cad8-4d68-9ac8-644f22ff91e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&