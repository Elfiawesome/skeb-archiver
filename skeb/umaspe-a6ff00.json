ull, "private": false, "genre": "comic", "tipped": false, "creator_id": 1445622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0233c817111cf91793f3c5b4051d35", "srcset": "https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae0233c817111cf91793f3c5b4051d35, https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=994e0c3f5dbfa44261ff146d9fc12524 2x, https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a6428f6e0e24a606611b8feee751c65d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79a3865bdf7847fd80fcb22202f994ff", "srcset": "https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79a3865bdf7847fd80fcb22202f994ff, https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d63f5d93fe7dbb9a148c7aa96f0052 2x, https://si.imgix.net/bd5ce23c/uploads/origins/ddde28c6-3692-4334-bf11-0a1b1389b850?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9973a0fdd00a08f810681888e2bd344e 3x"}, "body": "突然の依頼失礼します。\n漫画描く様の絵柄が好みでしたので依頼したく思いリクエストを送らせて頂きます。\n以下にリクエスト記載しますので確認お願い致します。\n\n・キャラクター\nウマ娘登場人物\nジェンティルドンナ\n衣装は勝負服Regina dei fiori。\nB110以上・W63・H90以上に盛るイメージでお願いします。\n\nジェンティルドンナのトレーナー\n20代半ばの男性。\n身長180センチ少しで相当鍛えられた細マッチョ。\nT頭、T袋等で大丈夫です。\n\n・シチュエーション\nジェンティルドンナとトレーナーの力比べシチュをお願いします。\n\nオーラを発しながら今ならジェンティルと互角以上に力比べが出来る気がする、とジェンティルの前に立つトレーナー。\nせめて感触くらいは味わわせてくださいな、と楽しそうなジェンティルドンナ。\nトレーナーは両手、ジェンティルは片手を合わせて力比べを始める。\nからの、腕や足がパンプアップして体中に青筋が浮かぶほど力を込めながらも全く手も足も出ずに跪かされるトレーナーと余裕綽々の様子で優雅に片手のままトレーナーを跪かせるジェンティル。\nどうにかジェンティルの手を押し返そうと苦しそうに呻きながら奮闘するトレーナーを見下ろして謎の快感と優越感に襲われて悪い笑顔でトレーナーを見下ろしながらゾクゾクしているジェンティル。\n\n\n以上をお願いします。\nお忙しい中恐れ入りますがご検討よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umaspe/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2cbdc77e/uploads/origins/e113d7a8-73d2-4e80-8464-6aaf88ce3360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40fa55e197c5e4282c605ac66ebd66b8", "srcset": "https://si.imgix.net/2cbdc77e/uploads/origins/e113d7a8-73d2-4e80-8464-6aaf88ce3360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40fa55e197c5e4282c605ac66ebd66b8, https://si.imgix.net/2cbdc77e/uploads/origins/e113d7a8-73d2-4e80-8464-6aaf88ce3360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1346a5bc2c347a77680c354975f1d159 2x, https://si.imgix.net/2cbdc77e/uploads/origins/e113d7a8-73d2-4e80-8464-6aaf88ce3360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7493210e90c200a63400b257b0a11c96 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1445622, "nc": 17}, {"path": "/@umaspe/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "a