つけています。\n野良着の色は紺で絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/s6470qhlwdftz8kzbg16s/nk.jpg?rlkey=ve4te44hezclvf9gbnn6zsiw2&st=mglg9oaa&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@minamoays/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 242112, "client_id": 1318189, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bc7ab03/uploads/origins/1f8dbf00-409f-4e0f-b778-e2be941ef78c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4edc714a11ebf5db91780da1f7196711", "srcset": "https://si.imgix.net/3bc7ab03/uploads/origins/1f8dbf00-409f-4e0f-b778-e2be941ef78c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4edc714a11ebf5db91780da1f7196711, https://si.imgix.net/3bc7ab03/uploads/origins/1f8dbf00-409f-4e0f-b778-e2be941ef78c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d80621c438102bc46e8f81a732a33e1c 2x, https://si.imgix.net/3bc7ab03/uploads/origins/1f8dbf00-409f-4e0f-b778-e2be941ef78c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb0353fca6176a0be491b16110bfcaee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bc7ab03/uploads/origins/1f8dbf00-409f-4e0f-b778-e2be941ef78c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3809768f4e7746f5572508a7128da898", "srcset": "https://si.imgix.net/3bc7ab03/uploads/origins/1f8dbf00-409f-4e0f-b778-e2be941ef78c?bg=%23fff&auto=format%2Ccompress&fm=webp&fi