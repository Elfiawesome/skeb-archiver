f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=808ab1063b23e2e9bf1184cc56f738eb, https://si.imgix.net/fa2b2b59/uploads/origins/d99a18e1-b369-4874-8276-9ddd5d5fd8c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c60e119997e7ced9f9bab84d9daf3dfa 2x, https://si.imgix.net/fa2b2b59/uploads/origins/d99a18e1-b369-4874-8276-9ddd5d5fd8c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9cd5e212d9c1c2c98854c17cbd39314 3x"}, "body": "こんにちは。学生時代からあなたの美しい作品を拝見する機会に恵まれました。あなたの広大な世界観と壮大で広大な風景に深く感銘を受け、まるで主人公たちと共に果てしなく広がる世界を探検しているかのようでした。ゲームのUIデザインは、何度もあなたのゲームをプレイしたいという夢を抱かせてくれました。最近、あなたがSkebアカウントをお持ちであることを知りましたので、機会があれば私のオリジナルキャラクターをデザインしていただけたらと思っています。キャラクターについてですが、服装は自由に選べます。もし複雑すぎる場合は、あなたにとってより都合の良いものに変更することも可能です。彼は、国内で最も寒い国境地帯を担当する高貴な尋問官です。そこは、絶望的な密輸業者や犯罪者だけが、危険な霧に覆われた雪に覆われた山林を越えるリスクを冒す場所です。可能であれば、ビジュアルにゲームのUIデザインも加えていただけると嬉しいです。ずっとあなたに描いてもらうことを夢見てきました！もし報酬が不足している場合は、追加資金の申請をお手伝いいただければ、追加でお支払いいたします。デザインしていただけると嬉しいです。改めてありがとうございます！ https://drive.google.com/drive/folders/1peVZsGuYiWlWSCfKbNm1W8ktI37Ad7Kt", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kani_Etizen03/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3081389, "client_id": 3419898, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0436b5c6c13573001f1ba88d2c7020b", "srcset": "https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0436b5c6c13573001f1ba88d2c7020b, https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6d4a92f4cf04ccea9144785ae5f8ec4 2x, https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=40f0355af5821ef7a5bb855c06839273 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eabd0090eaf3d00624589a4043ceb7f8", "srcset": "https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eabd0090eaf3d00624589a4043ceb7f8, https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ca289c4a575be0bd181479903e04f72 2x, https://si.imgix.net/dcdb2380/uploads/origins/9de76824-5e30-47fb-b6e3-e51f9f9df335?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ea2af17966f8de336ba814d4c40632 3x"}, "body": "こんにちは！あなたの素敵なイラストを見て、すっかり魅了されてしまいました！ファンタジーゲームのような雰囲気が大好きです！お手数をおかけして申し訳ありませんが、少し無理なお願いになるかもしれませんが、3点のイラスト（サイズ：16:9）をお願いできないでしょうか。 1枚目は私のキャラクター「ジュウちゃん」と彼女のマスコット「ピカ」を、残り2枚は友達へのプレゼントにしたいので、それぞれ3人の異なるキャラクターのイラストをお願いしたいです。\n\n1人目のキャラクター詳細\nジュウチャンは、食べること、寝ること、そしてペットのマスコット「ピカ」と一緒に冒険することが大好きなサメの女の子です。\n普段は甘えん坊でドジな性格ですが、お腹が空いたり怒ったりするととても恐ろしい姿になります。\n怒ったりお腹が空いたりすると、目と薄紫色の部分が赤くなります。\n（ハッピーモードと、お腹が空いた時や怒った時のモードがあります）\n大食漢で短気な性格です（シーフードとお菓子が大好き！）。\nキャッチフレーズは「Nice to eat cha!（食べるのが好きちゃ！）」です。\n主なモチーフは、魚の骨、絆創膏、縫い目、そしてリボンの触角です。\n衣装は3種類あり、オリジナル衣装、メイド服、アイドル衣装があります。お好きなものをお選びください！\n\n2人目のキャラクター詳細\n宮 奇跡（ミヤ・キセキ）はギルドの受付係で、同僚である伝書鳩たちにいつもいじめられています。\n性格はとってもエネルギッシュで、常に過労気味。おしゃべりな口達者で、おやつを持ってくる冒険者には、隠し持っていたより良いクエストを譲るよう賄賂を贈ることができます。\n\n3人目のキャラクター詳細\nアリエ・ゼイナは、海から陸へと送り込まれたバトルメイジの一人です。彼女の目的は、古代の大戦で人類が悪の勢力と戦うのを助けることでしたが、その戦いはついに終わり、今ではアリエは村で平和に暮らし、自分の好きなように過ごしています。 今の彼女の目的は、人間についてもっと学び、彼らと共存することです。海から来たバトルメイジとして、彼女は戦争のために造られたため、本来は感情を持っていませんが、人間の感情についてもっと知りたいと思い、人間の中に身を置くことを決めたのです。\n\nどうぞ自由に、思いのままに創作してください！お好きなように描いてください、あなたのセンスを信頼しています！\nこの依頼に対してどのくらいの金額を支払うべきか迷っています。もし金額が足りなければ、遠慮なく再依頼してください！もし2ヶ月では時間が足りない場合は、締め切りを延長しても構いません。待っています！\nお時間を割いてご検討いただき、誠にありがとうございます！\n\n使用用途\nTwitch/YouTube\n参考リンク\nhttps://drive.google.com/drive/folders/1oEO2ZmIPmhFgx1bp4h7cqPEmiXo8Y941?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kani_Etizen03/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3081389, "client_id": 3898219, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0676559c634cc6797734ed4359614673", "srcset": "https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0676559c634cc6797734ed4359614673, https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be75fef6650265ccf1e1898f9aa74316 2x, https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf5a4a9c8cb0dfb2d377cb393901b954 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb626bcbe05c7ef2c6608812ee8ac158", "srcset": "https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb626bcbe05c7ef2c6608812ee8ac158, https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=376a782acfb8323c6d52577f06234f1a 2x, https://si.imgix.net/9f77316d/uploads/origins/1005a536-dc75-4570-a0b7-78d3010e5177?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71d5dbf3430923cc0fb2b83ed161b929 3x"}, "body": "越前蟹 参号様\n\n初めまして。VTuberの星海うみると申します。skebに流れてきたイラストを拝見し、空や波の描き方、色合い、そして人物の表情の表現がとても素敵で、一目見た瞬間に惹かれました。ぜひご依頼させていただきたいです。\n\n【使用用途】\n・YouTube（サムネイル、配信、動画内での使用）\n・XをはじめとしたSNSへの掲載\n・ネットプリント（端の方に文字やサインを入れて使用）\n・FANBOX支援者様向け返礼品\n・サブギフト関連での使用\n・収益化済み配信での掲載\n\nまた、歌ってみた動画のイラストとしても使用させていただきたいです。\n\n【楽曲】\nMy Dearest\n\n【ご依頼内容】\n服装はお任せいたします。\n可能でしたら表情差分を2〜3種類ほどお願いできると嬉しいです。\n\n【参考画像】\n▶︎https://drive.google.com/drive/folders/1GIfT3ZFCcO5vleBbbxrHeeUwmbXgBI8q?usp=sharing\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kani_Etizen03/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3081389, "client_id": 3825580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ee76622f66e7294fd921928c6058f5", "srcset": "https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4ee76622f66e7294fd921928c6058f5, https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac075737fb46f0e6f99ad123268246a3 2x, https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f144ee8290076238f0d0c2e52aef33fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=187958ea84c5cf875fee0fb9e0bbaca9", "srcset": "https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=187958ea84c5cf875fee0fb9e0bbaca9, https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=104edf2a4c533475f2878a92b22195d5 2x, https://si.imgix.net/03708cb7/uploads/origins/ee21cc5d-242f-4173-bd79-d47e3d5a9854?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e26e4287c86cc37e4addc0e3c8e40eeb 3x"}, "body": "越前蟹先生、こんにちは！\n\nAlone / Yumeと申します。\n\n先生の描かれる美しく高品質な作品に惹かれ、ぜひSkebでリクエストをさせていただきたくご連絡いたしました。\n\nTwitterに投稿されている先生の作品は、オーロラやゲームのUIといった風景描写の巧みさが本当に素晴らしく、まるで夢や想像の中にしか存在しないような、貴重で美しい光景を描き出しています。\n\nそこで、私の夢の瞬間を捉えるお手伝いをお願いしたいのです。\n\n以下、依頼内容のまとめです。\n\n【キャラクター】\n \nキャル(プリコネ)\n\n【シチュエーション・構図】\n\nこのようなシーンを描いていただけると嬉しいです：\nhttps://x.com/Kani_Etizen03/status/2063456772887814478?s=20\n\n設定として、私は海での10年間の任務を終えた人間の王子（一人称視点）です。最後の瞬間に約束した女の子と景色を眺めながら過ごす、そんな夢のような約束を果たす物語をイメージしています。\n\n彼女を人魚の姿にしたいので、海の要素やストーリーの背景（パイレーツ・オブ・カリビアンのデイヴィ・ジョーンズの物語の、ハッピーエンド版のようなイメージ）が、先生のシナリオ構築やスケッチのヒントになれば幸いです。\n\n例えば、美しい夕日の中、彼女がそっと私のそばに現れ、とても美しく、ついに約束通り彼女に会えた。それは夢のようですが、私はその瞬間がもっと長く続いてほしいと願い、愛する彼女を見つめる時間を過ごします。\n\n彼女は人魚の尾で海と陸のそばに座り、永遠の幸福を彼女にもたらすと約束した人間の王子（私たち一人称視点）と一緒にいる、というシチュエーションです。\n\n夕日やオーロラのような風景を描くときの私の気持ちを表現していただければ幸いです。先生の素晴らしい表現力を楽しみにしております。また、ゲームのUI画面をいくつか含めていただくアレンジも大歓迎です！\n\n【衣装・デザイン】\n\nゲーム内の彼女のオリジナルキャラクターデザインでは三つ編みを結んでいますが、私は長い髪と猫耳だけの姿（髪下ろし）に変更したいです。\n\n上半身は水着(SFW)、下半身は「人魚の尾（マーメイドテール）」の姿。彼女がこの姿で描かれるといいなと思います。きっとすごく素敵に見えると思います！\n\n彼女の手（指）に、ゴールドと花の装飾があしらわれたルビーの婚約指輪をはめさせてください。\n\n彼女の水着についてですが、マーメイドテールや上半身の水着(SFW)の色やデザインにはあまり制限を設けませんので、公式の画像をベースに、先生のセンスで自由にデザインしていただいて構いません！\n\n【その他情報】\n\n詳細資料はこちらにまとめました：[請在此處貼上您的Google Drive連結]\nぜひ先生の創造力を自由に発揮してください！完成品をとても楽しみにしています。\n先生の絵の腕前を存分に堪能できるよう、繊細なタッチで描いていただけると嬉しいです。\n\n【私の物語】\n\n私にとって、このキャラクターは本当に特別な意味を持っています。彼女は私がアニメ業界に夢中になった主な理由であり、私は8年間ずっとゲームをプレイし、サポートし続けています。\n\nキャルは道端で倒れた謎の猫耳魔術師で、普段の態度は少しツンデレ気味ですが、私は彼女のキャラクターとストーリーに惹かれ、今日までずっとこのキャラクターに恋をしています。\n\n私の依頼内容の詳細をご覧いただきありがとうございます。素敵な一日をお過ごしください！╰(´︶`)╯♡\n\nhttps://drive.google.com/drive/folders/1dy677cGEKNZvHkb7gF6KHVSk8nj9NYAl?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kani_Etizen03/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f6e959d2/uploads/origins/e8362ff9-982b-4253-8bad-1d68f318ed7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=833166de6029977eb01abda4a3318fe5", "srcset": "https://si.imgix.net/f6e959d2/uploads/origins/e8362ff9-982b-4253-8bad-1d68f318ed7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=833166de6029977eb01abda4a3318fe5, https://si.imgix.net/f6e959d2/uploads/origins/e8362ff9-982b-4253-8bad-1d68f318ed7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f4d383410229c46a6606e7cf25cc19d1 2x, https://si.imgix.net/f6e959d2/uploads/origins/e8362ff9-982b-4253-8bad-1d68f318ed7e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9db60d6ae18050f7575ee194f0e51a28 3x"}, "private": true, "genre": "art", "tipped": false, "cre