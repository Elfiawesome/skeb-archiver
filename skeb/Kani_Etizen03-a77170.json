657816357/photo/1\n\nこのイラストは、SNS、ソーシャルメディア、YouTube、Twitchで使用します。\n\nありがとうございます！\n\n[ キャラクター詳細 + 備考 ]\n- 衣装の参考は#1を使用、ジャケットなし\n- サイドの髪の下に隠れた犬耳のみ、人間の耳はなし\n- 犬の骨と魚の骨のヘアアクセサリー\n- マネキンの腕は任意\n- 目の色は黄緑色\n\n[ 主な参考画像 ]\nhttps://drive.google.com/drive/folders/1eo2nV1C0-rgTFWRvNFNJiJpDUTqJGSFV\n\nhttps://drive.google.com/drive/folders/1eo2nV1C0-rgTFWRvNFNJiJpDUTqJGSFV", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kani_Etizen03/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3081389, "client_id": 3897168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef3cff2a/uploads/origins/776c4ce4-f034-4005-a981-a802feda3f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=562e86968921dcdffda1eed680a7e090", "srcset": "https://si.imgix.net/ef3cff2a/uploads/origins/776c4ce4-f034-4005-a981-a802feda3f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=562e86968921dcdffda1eed680a7e090, https://si.imgix.net/ef3cff2a/uploads/origins/776c4ce4-f034-4005-a981-a802feda3f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b447dbbe5781353de9dd994ac332137 2x, https://si.imgix.net/ef3cff2a/uploads/origins/776c4ce4-f034-4005-a981-a802feda3f50?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=862afb3293a2ed4d084d2103f0e46c66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef3cff2a/uploads/origins/776c4ce4-f034-4005-a981-a802feda3f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c63512d3fa54b248b591fdb51c4d925", "srcset": "https://si.imgix.net/ef3cff2a/uploads/origins/776c4ce4-f034-4005-a981-a802feda3f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c63512d3fa54b248b591fdb51c4d925, https://si.imgix.net/ef3cff2a/u