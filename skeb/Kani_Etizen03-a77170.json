uploads/origins/0886ca2f-fa53-4811-968c-a548233513af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af1a3ed6f47fbc1d022f583e1ba2d523 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d112be9/uploads/origins/0886ca2f-fa53-4811-968c-a548233513af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e57a429466c26d60b5bb116e0db3fc", "srcset": "https://si.imgix.net/7d112be9/uploads/origins/0886ca2f-fa53-4811-968c-a548233513af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0e57a429466c26d60b5bb116e0db3fc, https://si.imgix.net/7d112be9/uploads/origins/0886ca2f-fa53-4811-968c-a548233513af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce653962f06c8ca9d912615941297720 2x, https://si.imgix.net/7d112be9/uploads/origins/0886ca2f-fa53-4811-968c-a548233513af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce9bf9d84fb2d8b3df41e7c5a82833c8 3x"}, "body": "初めまして。 \nXでお見かけした越前蟹 参号様の作品に惹かれ、リクエストを送信しております。\n画面の外まで広がっていそうな、広大で重厚感のある風景画がとても素敵です…！特に空の表現がとても好きです。\n\n今回描いていただきたいのは、私のOCの、幼馴染で野球部の高校生2人です。\n不明瞭な部分等は簡略化、捏造等していただいて構いません。\nhttps://drive.google.com/drive/folders/11f842IFMmqBDfg4cF_hYLQjuN_CFGTBH\n\n夏のイラストだと大変嬉しく思います。\n構図や時間帯といったその他の指定はございませんので、描きやすいように描いていただければと思います！\n\n依頼文は以上です。\n金額や内容がそぐわなければ、遠慮なくキャンセルしていただいて構いません。\nご縁がありましたら、どうぞよろしくお願いいたします🙇‍♂️", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Kani_Etizen03/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3081389, "client_id": 1171855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c79b5cf/uploads/origins/27498f95-c1e2-41bb-9344-4cbf0f2e7545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e8531e27cce275f924b85268dd8b