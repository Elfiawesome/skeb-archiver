2024年の♐♍セッションまとめ本をいい加減進めろ！という自戒を込め、本の表紙を飾るイラストを描いて頂けたりしないかな！？　と戸を叩きました。\n一応今年中に作れたらくらいで考えています。\n\n現状の仮表紙では立ち絵をふたつ並べているだけです。\nどんなイラストが来るか楽しみに待ちたい気持ちもありお任せしたいのですが、ネタバレがない範囲のイラストだと本完成時にXで自慢出来て嬉しいです。\n（現行の表紙はバチバチにネタバレになっています…）\n\n本で使う画像サイズは300dpiの1866×1866で、こちらに耐えるサイズであればイラストサイズや縦横比にも希望はありません。\n四辺は断ち落とすため見切れる可能性が高いです。また、正方形でない場合はトリミングさせて頂くことになると思います。\n\n金額含め一度ご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HrysmjxCm2cvWri/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2825222, "client_id": 1225993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb18b71e/uploads/origins/dd8a3327-e695-4ea7-834f-c19c871f7e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c799005dc532eb65d5b69400d789cc5a", "srcset": "https://si.imgix.net/bb18b71e/uploads/origins/dd8a3327-e695-4ea7-834f-c19c871f7e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c799005dc532eb65d5b69400d789cc5a, https://si.imgix.net/bb18b71e/uploads/origins/dd8a3327-e695-4ea7-834f-c19c871f7e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc2db7a4364a1c50e40dc151d7e72e35 2x, https://si.imgix.net/bb18b71e/uploads/origins/dd8a3327-e695-4ea7-834f-c19c871f7e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c2b35d4b78c6fadcbc971e85e402b49 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb18b71e/uploads/origins/dd8a3327-e695-4ea7-834f-c19c871f7e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f97d89ee2eb5c7e5c844cc5ca47cdbef", "srcset": "https://si.imgix.net/bb18b71e/uploads/origins/dd8a3327-e695-4ea7-834f-c19c871f7e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f97d89ee2eb5c7e5c844cc5ca47cdbef, https://si.im