d": 40232, "nc": 16}, {"path": "/@akeikou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 40232, "client_id": 140313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edfde706843dea3a32e9048e4be008b9", "srcset": "https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edfde706843dea3a32e9048e4be008b9, https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20421e32da5ba5a29f8793e22d88f946 2x, https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6535b8183bbe1b48701084429116d84c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77266e9776d460829ec050b4239ac8e3", "srcset": "https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77266e9776d460829ec050b4239ac8e3, https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d23a45d11b871cfa7837a8ac2fbc5958 2x, https://si.imgix.net/9a26766a/uploads/origins/2e8e304b-ab77-4c52-b186-7a3913b00b22?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24b6d535ada55ff819a7e5567f0054a0 3x"}, "body": "めぇと言う名前の私のキャラを描いて下さい\n羊・月・サキュバス等の要素が含まれます\n身長:118cm　外見年齢:10歳程度\n若干イカ腹っぽく、髪の毛量が多めです\n\n\nTwitterでパシーラちゃん等のかわいらしくもむちむちなお絵描きを拝見しまして\n依頼したく思いました　よろしければお願いします\n\nキャラの性格等\n口数少なく穏やか、やや幼い性格でややアンニュイ、常に少し眠そうです\n振る舞いはおとなしく、人懐こいです\nミルク、ナッツ、チョコ等を好み、小食です\n行動に害意はなく、敵意を嫌います\n\n構図やシチュエーションなどはお任せします\nですが、もしもアイデアが必要な場合は以下の文章をご参考ください\n・牧草や布団椅子の上で丸まって寝ている\n・高所（煙突など）から遠くを見ている\n・何かに撫でられて微笑む\n・気持ちよさそうに空を飛ぶ\n・水浴びをする\n・指先からミルクを垂らして瓶に入れる\n・動物にくっついてうとうとしている\n・寝ている相手に抱き着いてエネルギーを緩やかに奪う（発光）\n・三日月に腰掛けあるいは抱き着くなど月を絡める\n・伸びた毛を第三者に毛刈りされるのを気持ちよさそうにする\n・角が折れた（痛くはない）\n・小さい物をしゃがみ込んでのぞき込む\n・誰かと手をつないで夜を散歩している\n・ひつじのぬいぐるみに腰かけて空を見ている\n\n設定　能力\nめぇは人々の記憶に住み着く妖精や悪魔のようなもので\n体の縁が淡く発光しており、普段は浮遊しています\n桃、アルコール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n分泌される体液や血液は練乳やミルクのようで、\n飲ませた相手を強壮し、軽い依存性をもちます\n\n資料は以下のURL、Skebの過去の納品を参考にお願いします\nhttps://www.pixiv.net/artworks/99333545\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akeikou/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1f984db9/uploads/origins/ddc6970b-0926-441c-a38a-a57d87de5181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64aee1666f61bf62068040de0db667c7", "srcset": "https://si.imgix.net/1f984db9/uploads/origins/ddc6970b-0926-441c-a38a-a57d87de5181?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64aee1666f61bf62068040de0db667c7, https://si.imgix.net/1f984db9/uploads/origins/ddc6970b-0926-441c-a38a-a57d87de5181?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd0ea465859af70798cf54142526e0f6 2x, https://si.imgix.net/1f984db9/uploads/origins/ddc6970b-0926-441c-a38a-a57