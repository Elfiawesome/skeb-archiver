衣装（コート無しのオフショル衣装）で、その他は全体を通して大也様の筆の乗りやすいよう、お任せでできたら幸いでございます！\n■髪：オーロラのようなハイライトがあります。\n■瞳：縦長で少し人外感があります。\n■右目：黒目の下にほくろがあります。\n\nサムネイル等、配信活動で使わせて頂きたいため、頭部が切れていないことと、背景と自分とで分かれた透過Verもいただけたら嬉しく思います！\n\n難しい場合は遠慮なくキャンセルいただいて問題ございません！\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1y7b-whhVchxIqACKnMHXYr_J-AtpRRFA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@04da15i9ya/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2678540, "client_id": 3100734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5ac8641/uploads/origins/06fcec65-53e1-40c3-b577-119a30f27df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fd71fe9a4837cf40305f5b9be52d4ca", "srcset": "https://si.imgix.net/d5ac8641/uploads/origins/06fcec65-53e1-40c3-b577-119a30f27df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fd71fe9a4837cf40305f5b9be52d4ca, https://si.imgix.net/d5ac8641/uploads/origins/06fcec65-53e1-40c3-b577-119a30f27df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69c4cbb24f23e4b1ba4708cd1f53c2e0 2x, https://si.imgix.net/d5ac8641/uploads/origins/06fcec65-53e1-40c3-b577-119a30f27df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5eb056a65be2c7f54d09f286effc3772 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5ac8641/uploads/origins/06fcec65-53e1-40c3-b577-119a30f27df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faaa5ff90264c3fd6b782c7b9ee21125", "srcset": "https://si.imgix.net/d5ac8641/uploads/origins/06fcec65-53e1-40c3-b577-119a30f27df4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=faaa5ff90264c3fd6b782c7b9ee21125, https://si.imgix.net/d5ac8641/uploads/origins/06fcec65-53e1-40c3-b5