origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94a9156193d7e39633c8d12a09071f6c", "srcset": "https://si.imgix.net/d448719e/uploads/origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94a9156193d7e39633c8d12a09071f6c, https://si.imgix.net/d448719e/uploads/origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66759ed03d269b00f056d568d04bb223 2x, https://si.imgix.net/d448719e/uploads/origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b94169716fb3ae51c461e51a18d7aef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d448719e/uploads/origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f788972d666f7ef0ef06869e1cdac6c4", "srcset": "https://si.imgix.net/d448719e/uploads/origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f788972d666f7ef0ef06869e1cdac6c4, https://si.imgix.net/d448719e/uploads/origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d109ce4313b6326b5042724045dcb7e6 2x, https://si.imgix.net/d448719e/uploads/origins/97e1a0d8-9153-4539-882c-8433e383cce9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb01da18010409d26ba4368fd0805786 3x"}, "body": "はじめまして。先生の描く長髪の美男子がとても好きです。\nもし可能でしたら、私のCPで漫画を一作ご依頼させていただきたく思っております。\n\n二人を簡単に紹介します。\nGは過去のトラウマから、自分を守るために感情や記憶を切り離して生きている。\nPは傷ついた自己愛を埋めるために、手段を選ばず突き進むタイプの人間だ。\n二人の関係は、少し極端に言えばこんな感じかもしれない。\nGは虐待されて捨てられた犬で、Pはそれを拾ったけれど、特別優しいわけでも、根気強いわけでもない。\nそれでも一緒にいるうちに、二人は少しずつ、自分たちなりの距離と関係を見つけていく。\n\n▼参考リンクでは、キャラクターの設定や絵の参考資料をご覧いた