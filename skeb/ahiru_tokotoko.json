QxgBadeUGUOy5j3qaqQqVywRF5", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ahiru_tokotoko/works/84", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ceb1ecca/uploads/origins/60b4e4a9-201a-4293-afdb-61d1609be2f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de102052d5dc1e0ccec7186b239b8870", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2582838, "client_id": 3637794, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ahiru_tokotoko/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2582838, "client_id": 308848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61573a87/uploads/origins/6caeef95-bd4c-4638-a3eb-334ba9104947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27d15b396d9673e104dcc889fe24fe36", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61573a87/uploads/origins/6caeef95-bd4c-4638-a3eb-334ba9104947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93553f35444c4c67129d3f0e0863a63f", "src_set": ""}, "body": "あひる先生はじめまして！\n先生のピクセルアートのキャラの可愛さはもちろん、瞳の透明感や光の表現の美しさが特に大好きです！\n\nリクエストですが、VRChatというゲームで使っているアバターを描いていただきたいです\nそのほかはすべておまかせするので先生の好きなように描いていただけたら嬉しいです\n服装も参考資料から選んでいただいてもオリジナルでも、どのような形でも構いません\n細かいデザインなども描きやすくアレンジしていただいて大丈夫です\n\n▼参考資料になります\nhttps://www.dropbox.com/scl/fo/hw8jtpcub9nxsx6by40rm/AMzwdJ7awFaboelvsxZgjd8?rlkey=uk59cn9axwr9u4fpa3wi3adr0&st=5qpjq2cf&dl=0\n\nご検討よろしくお願いします！\n\nhttps://www.dropbox.com/scl/fo/hw8jtpcub9nxsx6by40rm/AMzwdJ7awFaboelvsxZgjd8?rlkey=uk59cn9axwr9u4fpa3wi3adr0&st=5qpjq2cf&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ahiru_tokotoko/works/82", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2582838, "client_id": 8407, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95b2bf41/uploads/origins/6a817827-93bf-4e21-8b06-ae089588d855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7164e20699f859bbf6335860a7b4c4e1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95b2bf41/uploads/origins/6a817827-93bf-4e21-8b06-ae089588d855?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=942c0c4f460885860c553cefd6e87cbc", "src_set": ""}, "body": "はじめまして！あひる先生のピクセルアートを拝見し、表情もポーズも生き生きとして可愛らしくてすごく惹かれました。リクエストさせてください。\n\nVTuberのたここさん（@takoko_942）のイラストをお願いしたいです。\n表情もポーズも構図もすべて、あひる先生のお好きなように表現していただけますと嬉しいです。\nピクセルアートの世界では、たここさんがどんな風に存在しているのか純粋にワクワクしています。\n\nまた、たここさんご本人による使用許可もいただけますと幸いです。\n\n以下、参考情報です。（衣装や髪型は、和洋どちらでもお任せします）\n\n▼和装参考\nキービジュアル：https://x.com/takoko_942/status/1708631879073808547\n三面図：https://x.com/takoko_942/status/1625774470265995264\n猫耳、表情（動画）：https://x.com/takoko_942/status/1858486160693268693\n\n▼洋装参考\n上半身、髪型複数：https://x.com/takoko_942/status/1848345120980258881\n全体（動画）：https://x.com/nuit_rr/status/1848333541463224357\n\n#たこちゃあーと", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ahiru_tokotoko/works/81", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2582838, "client_id": 3258037, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d173d85/uploads/origins/b1529793-31ca-4e99-b2dc-afd1bec05847?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3f