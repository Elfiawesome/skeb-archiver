6b-a966-0cb5b7cf1d8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b257bd4c886ad4432aecb4e28b760d75", "src_set": ""}, "body": "こんにちは。\n東方Projectの蓬莱山輝夜を描いていただくことは可能でしょうか。\n背景に満月を入れていただけますと幸いです。それ以外の構図や雰囲気につきましては、全て作家様にお任せいたします。\nご検討のほど、何卒よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wankosoradayo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2245423, "client_id": 1765701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7be78b96/uploads/origins/a766a3f3-047a-47df-9179-7e6780632b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d834723ce132a5e70eb94a9e6eb689f1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7be78b96/uploads/origins/a766a3f3-047a-47df-9179-7e6780632b60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcf7b93f0207b13bb4f321e74ce2d008", "src_set": ""}, "body": "はじめまして！\n世界はもっと鍵山雛を必要としています。\n東方projectのキャラクターで可愛い鍵山雛を描いていただけませんか？\n胸が大きくて、ロングストッキングを履いているお雛様を希望します。\n他には特に要望はありませんので、自由にデザインしてください。\nよろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wankosoradayo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2245423, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a6b400a/uploads/origins/24711fdd-e856-442f-91b0-e7c808ae2738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e4c2d67451f779ea096fec576f952e4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a6b400a/uploads/origins/24711fdd-e856-442f-91b0-e7c808ae2738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=945f178d752127ad7df29a92d0fa5cbd", "src_set": ""}, "body": "わんこソラ様\nはじめまして、配信活動をしている個人Vtuberの㐂ツミキ(ななつき　つみき)と申します。\nわんこソラ様のイラストに一目ぼれし、東方のキャラや創作の子たちのポーズもとても素敵で好きでしたのでぜひご依頼したいと思い！リクエストさせていただきました！\n\n\n【使用用途】\n・配信サイト(サムネなど)、SNS等のアイコンやヘッダー、PR活動、ネットプリントへの登録、サブスク限定壁紙として配布です。\nアスペクト比16:9じゃない場合トリミングをする許可をいただけますでしょうか(壁紙配布のため)\n(無理なものがある場合お手数ですがレイヤーに書いていただけると嬉しいです)\n\n\n【キャラの特徴】\n・モチーフは猫\n・普段は髪で隠しているが実はオッドアイ\n・明るい性格＆ポンコツ\n\n【詳細】\n・表情や構図などはわんこソラ様にお任せしたいです\n・人物・背景でレイヤー分けされたPSDデータで納品していただけますと幸いです\n\n\nご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1FIF5XIQQ0sJaB3J42_XOVHqqztBWx5R5", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wankosoradayo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2245423, "client_id": 2289134, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e7b44ec/uploads/origins/85da89a2-1572-4278-880d-dcbc360eca90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ff6cdd7e3cea96ee2be58ae04161f6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e7b44ec/uploads/origins/85da89a2-1572-4278-880d-dcbc360eca90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=744ff8c6526a6e0d9ba5478a20731904", "src_set": ""}, "body": "先生こんにちは！私はあなたの絵画スタイルが大好きです！東方projectの天子の絵をお願いしてもよろしいでしょうか。好きなように絵を描くことができます！本当にありがとうございます。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wankosoradayo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2245423, "client_id": 376081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d7bfb15/uploads/origins/4e63e558-f525-468f-9d94-33206a1839e0?bg=%23fff&auto=format%2Ccompre