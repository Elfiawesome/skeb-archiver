をメインで言葉責めや貝合わせ等でレイプさせてください！！（初めから露出状態でも問題ありません！！！）\nセリフの末尾に「♡」を付けて下さい！\nまた、受けが無意識に自分または攻めの体を弄る描写があると嬉しいです！！\n\n以上、よければよろしくお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toilet_pe_pa_s/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 298346, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3f6a3aa161cf9f20abc1e233d00b443", "srcset": "https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3f6a3aa161cf9f20abc1e233d00b443, https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05308dbf5ed0f32b6fe16940b3a44369 2x, https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8279e4621bdacdb30731a101f76dad89 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=028d1b04855a0417c20c543732f4f0ce", "srcset": "https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=028d1b04855a0417c20c543732f4f0ce, https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c89b122db3b2c19f3baca498f9ecdd3 2x, https://si.imgix.net/993c4449/uploads/origins/422e8eec-6551-4d7c-a0dc-9ad69daa0616?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c35e17e1b7cf23ffd25516792aa0b5c9 3x"}, "body": "パリユリ先生、前回は素敵なコンボルちゃんの絵をありがとうございました。牛の王子様でち＠８６ｋです。\n是非ともリクエストをお受けください。\n\n【作品】フラワーナイトガール\n【キャラクター】オジギソウ（花騎士）\nhttps://i.imgur.com/ywyxyx0.png\n【シチュエーション】\n先日、某所で「花言葉『感度３０００倍』」というパワーワードが出現し、大爆笑しましたので、是非それを表現する絵を描いていただきたいと思い依頼させていただきます。\n漠然とした依頼で誠に申し訳ございませんが、唐突に表れたパワーワードを是非イラストにしていただきたいとの思いからの依頼です。\n\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%82%AA%E3%82%B8%E3%82%AE%E3%82%BD%E3%82%A6", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toilet_pe_pa_s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 298346, "client_id": 1100987, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dac6c1a7eb0bd157c81d53a84e07736", "srcset": "https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dac6c1a7eb0bd157c81d53a84e07736, https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c90be8feb10a7b2b12412e1a35e206ae 2x, https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d424b79ad6e5b2e0ac0db9bfea996817 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59809555bcda99e7af46e303e316d081", "srcset": "https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59809555bcda99e7af46e303e316d081, https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37fb123805e346a7615ebfcc975637fe 2x, https://si.imgix.net/5327ad8d/uploads/origins/867fc57f-a7dd-498f-97e7-19f3883ef535?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff71f894a169080b95f3ae55b31506c 3x"}, "body": "はじめまして、いつもパリユリ先生のイラストを拝見させていただいております。\n今回、先生がskebを始められたということで、是非お願いしたいと思いリクエストを送信させていただきます。\n\n【リクエスト内容】\nFLOWER KNIGHT GIRLの青い悪魔の面々+エニシダが宴会をしている様子を描いていただきたいです。\n\n絵のノウハウを持ち合わせておらず構図などの細かい指定ができないので、内容の大部分をパリユリ先生に一任してしまう形となってしまい申し訳ありませんが、もしよろしければ描いていただけると幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toilet_pe_pa_s/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 298346, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b62941f0a99a00e0130fabeba58460", "srcset": "https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46b62941f0a99a00e0130fabeba58460, https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=431cfce9c8c72694bfd522f6bb530c98 2x, https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f42ddf494c9e1b3eee4724680ceb0ddb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90e71b6264d3cbc807e43583fd7959f6", "srcset": "https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90e71b6264d3cbc807e43583fd7959f6, https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e4c4f68156c3f4ca5887391aa7e20a9 2x, https://si.imgix.net/28b138d6/uploads/origins/4fcd9589-cca5-4d47-a91d-42275634f3e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d07078b69e593b0835a0e2f23b22cfae 3x"}, "body": "パリユリ先生、前回は素敵なヒツジグサ様の漫画をありがとうございました。牛の王子様でち＠８６ｋです。\n立て続けになりますが、以前から温めていたネタがございまして、やはりこれをお願いできるのは先生だと思っての依頼です。\n是非ともリクエストをお受けください。\n\n【作品】フラワーナイトガール\n【キャラクター】コンボルブルス（花騎士）\nhttps://i.imgur.com/e3bj1YD.png\nhttps://i.imgur.com/RJoYZTJ.png\n【衣装】\n好奇心の水着\nhttps://i.imgur.com/aHo6IO0.png\nhttps://twitter.com/flower_staff/status/1153969335435550720\nhttps://twitter.com/flower_staff/status/1161292592308510720\n【シチュエーション】\n好奇心の水着（公式の４コマ漫画でリリィウッド元老院組が来ていた水着です）を着た状態でフラスベルグなどの強敵（戦っている姿のコンボルちゃんが見たいので敵の描写は不要です。）と死闘を繰り広げるコンボルブルスちゃんを描いてください。\n\n私自身、ゲーム内でのコンボルブルスちゃんの頼もしさ、「死んでない、まだいける」や「次は抉る」などの台詞回しのかっこ良さに魅入られた者なのですが\n当時の環境でフラスベルグと戦う際、コンボルブルスちゃんに装備させるＦMが危険な水着を着るんだよ（参考：https://i.imgur.com/m32decf.png）であったため、常々水着姿で戦う姿のコンボルブルスちゃんを想像しておりました。\n\nかっこよく、そしてどこかミスマッチでかつえっちな感じを先生に表現していただきたいのですが可能でしょうか？\nその他詳細は全て先生にお任せいたします。先生のやりやすい様にしていただいて構いません。\n\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%82%B3%E3%83%B3%E3%83%9C%E3%83%AB%E3%83%96%E3%83%AB%E3%82%B9", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@toilet_pe_pa_s/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 298346, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cb3f1855f09e23fe9f744a0bc288ab7", "srcset": "https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cb3f1855f09e23fe9f744a0bc288ab7, https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=244919c9a28407e63c2652d05a95efd1 2x, https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23fad17f3a007ff2cd0687a6197c11a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56435944b2c73e6f54f41d9eb15ebe07", "srcset": "https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56435944b2c73e6f54f41d9eb15ebe07, https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fad0e0063a6ff5957e4395cdd5d96664 2x, https://si.imgix.net/f74826ca/uploads/origins/4bf8f798-7a97-4a79-8aff-ac1704e52d0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c77f5ce94fd1dac4e191f8aa95d225c 3x"}, "body": "パリユリ先生はじめまして、いつもTwitter等を楽しく読ませていただいております。\n牛の王子様でち＠８６ｋと申します。\n先生がskeb