途\n枢目ロプトおよび嫉宮リヴィア、Raptorの配信用アカウント（youtubeなど）・Xにて、配信画面、動画、ツイートの添付画像、サムネイルに使用。\n若干の加工（文字を入れる、トリミングする、枠をかぶせるなど、原形を著しく損なわない範囲）をする可能性があります。\n\nご検討のほどよろしくお願いいたします。", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onotsuki_w2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3878557, "client_id": 3488695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ad1b5a4/uploads/origins/f3cadd04-ce11-4219-8a94-4c5a62c2dd34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde706b2bb68509fc68cd9de43cd2618", "srcset": "https://si.imgix.net/7ad1b5a4/uploads/origins/f3cadd04-ce11-4219-8a94-4c5a62c2dd34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fde706b2bb68509fc68cd9de43cd2618, https://si.imgix.net/7ad1b5a4/uploads/origins/f3cadd04-ce11-4219-8a94-4c5a62c2dd34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4923c4feaae92c69ec56473a13418251 2x, https://si.imgix.net/7ad1b5a4/uploads/origins/f3cadd04-ce11-4219-8a94-4c5a62c2dd34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62f0a077d38666e8fe5638c34ec80672 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ad1b5a4/uploads/origins/f3cadd04-ce11-4219-8a94-4c5a62c2dd34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aa95075ecdb269bf314c52233a76e85", "srcset": "https://si.imgix.net/7ad1b5a4/uploads/origins/f3cadd04-ce11-4219-8a94-4c5a62c2dd34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aa95075ecdb269bf314c52233a76e85, https://si.imgix.net/7ad1b5a4/uploads/origins/f3cadd04-ce11-4219-8a94-4c5a62c2dd34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab21b98317a56d0cea439445e41ee42e 2x, https://si.imgix.net/7ad1b5a4