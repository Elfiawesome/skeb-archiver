にお願いできますでしょうか。\n　https://wikiwiki.jp/arcaea/%E3%83%91%E3%83%BC%E3%83%88%E3%83%8A%E3%83%BC/%E6%9C%9F%E9%96%93%E9%99%90%E5%AE%9A#kouw\n\n・使用用途\n　頂いたイラストはSNSのアイコン、PC壁紙、許可をいただけるのであればプレイマットを2枚（プレイ用、予備）作成して使用したいと考えております。\n　上記使用用途のため、ファイル形式はpsdファイルとpngファイルの2種でお願いいただけますでしょうか。\n\n以上です。ご検討のほどよろしくお願い致します。\n\nhttps://x.com/arcaea_jp/status/1605721634740277249", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Halu__XD/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1229927, "client_id": 1552917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4699f99c/uploads/origins/57912dab-9598-4425-a30b-1bf93a5ec914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3873cbf0b2b456410507307d2c0402a", "srcset": "https://si.imgix.net/4699f99c/uploads/origins/57912dab-9598-4425-a30b-1bf93a5ec914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3873cbf0b2b456410507307d2c0402a, https://si.imgix.net/4699f99c/uploads/origins/57912dab-9598-4425-a30b-1bf93a5ec914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b25de8ff8cd047d7a242502ba2604b0 2x, https://si.imgix.net/4699f99c/uploads/origins/57912dab-9598-4425-a30b-1bf93a5ec914?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bea147c64a23791170d8108a508c064f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4699f99c/uploads/origins/57912dab-9598-4425-a30b-1bf93a5ec914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4a32b8e62c9e04cef70450a44616b07", "srcset": "https://si.imgix.net/4699f99c/uploads/origins/57912dab-9598-4425-a30b-1bf93a5ec914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4a32b8e62c9e04cef70450a44616b07, https://si.imgix.net/4699f99c/uploads/origins/5