b50eb/uploads/origins/98b79fc3-6a2e-4f28-895f-a9c123263fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f0965d9a3d4e15ac4351f8145f71ce0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29eb50eb/uploads/origins/98b79fc3-6a2e-4f28-895f-a9c123263fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b220e531f903ba4da25da06cd7f031c6", "srcset": "https://si.imgix.net/29eb50eb/uploads/origins/98b79fc3-6a2e-4f28-895f-a9c123263fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b220e531f903ba4da25da06cd7f031c6, https://si.imgix.net/29eb50eb/uploads/origins/98b79fc3-6a2e-4f28-895f-a9c123263fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62dd514371b6b607ba56bb39b9f0c5a9 2x, https://si.imgix.net/29eb50eb/uploads/origins/98b79fc3-6a2e-4f28-895f-a9c123263fa8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65e57463362c29ddcf3c93a0bac026a0 3x"}, "body": "Halu先生こんにちは。\nいつも応援しております、たぬぽんです。\n先生がSkebの値段を期間限定で下げているとのことでリクエストさせていただきました。\n以前にも一度描いてもらいましたが今回もうちの子である紅音を描いていただきたいです。\n\n今回、服装に関してですが新しい衣装をデザインしましたので添付している資料の3面図を参考にお願いします。\n構図やシチュエーション等は全てお任せします。\nまた、宛名のレイヤー分けもお願いしたいです。\n\n以上の内容でリクエストさせて頂きましたが、ご都合が悪かったり内容が合わないようでしたらキャンセルしても大丈夫ですのでご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/17KL7Y2bi1d0IMLahmyiw8DPfSmXISrBf?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Halu__XD/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1229927, "client_id": 1610501, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/965cd014/uploads/origins/dbda3769-27af-47b7-86bf-1a2cd27cf29a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49b8bf2e37e52218eecb37cb295fff20", "srcs