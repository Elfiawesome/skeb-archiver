=2&fit=crop&crop=top&w=200&h=200&s=b890d46094279b7ec2a7265634651361 2x, https://si.imgix.net/1cffba14/uploads/origins/75ed5547-919e-4d59-9730-311707f0b2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57a398c7c85c67c05d7a766b06674e73 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cffba14/uploads/origins/75ed5547-919e-4d59-9730-311707f0b2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=036a299a200dec249ab3b1ca122f9f7b", "srcset": "https://si.imgix.net/1cffba14/uploads/origins/75ed5547-919e-4d59-9730-311707f0b2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=036a299a200dec249ab3b1ca122f9f7b, https://si.imgix.net/1cffba14/uploads/origins/75ed5547-919e-4d59-9730-311707f0b2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0cfd5be0c4fc8427f89717d8b5f86898 2x, https://si.imgix.net/1cffba14/uploads/origins/75ed5547-919e-4d59-9730-311707f0b2c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba48788411ff3f694301ad712a1b9838 3x"}, "body": "はじめまして。ブルアカの白尾エリちゃんが自分の好みどストライクだったのでリクエストをお願いします。\nエリちゃんが「全身黒マント姿」で立っている全身イラストをお願いいたします。\n\n \n【イメージ】\n・エリちゃんが「魔法のマント」を手に入れて先生（マスター）に見せるシーンをイメージしています。\n・中は手足も含めて完全に見せず、黒マントで全身をすっぽりと覆い隠した怪しい姿です。\n・マントは参考資料の様な、紐留めの留め具で、襟元はドラキュラのような立ち襟付きの「釣鐘型」になる大きめのシルエットで、体のラインや体格がマントの膨らみでまったく分からないようにして下さい。布の重みを感じるような、ふんわりとした膨らみを意識していただけると嬉しいです。また、裾は床に丸く広がり、大きく引きずる長さです。\n・マントの材質は厚めのサテンまたはベルベット風で、柔らかい光沢がある黒。\n・。\n・それ以外はいつもの魔女帽を着用。\n\n【ポーズ・雰囲気】\n・正面で堂々と立っていて視線は前方へ、自信ありげで少しお茶目な笑みを浮かべています。\n・雰囲気としては「マスターの大好きな黒マントの魔女ですよ〜。中には何が隠れているんでしょうね〜？」とでも言いたげな挑発的で可愛い感じで、ただし実際には脱がず、中身を想像させるだけの構図でお願いします。\n\n 【その他】\n・差分としてセリフ無しのバージョンと、余裕があれば裾を片手（または両手）で軽く持ち上げるポーズをして「今にも脱ぎそうで脱がない」ような、目の前の先生を焦らす雰囲気になっているバージョンもお願いします。\n・背景の有無はお任せします。\n\n【マントの参考資料】\n ① https://m.media-amazon.com/images/I/61iCSI8ZMML._AC_SX679_.jpg \n② https://m.media-amazon.com/images/I/41EDMVGu77L._AC_.jpg ③https://booth.pximg.net/aa9f22e8-b178-430b-af53-ffee2b605924/i/4717148/2ababf56-fe1a-4c4b-98fc-d6f44d88c90f.jpg\n\n \n以上、よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mmisodaizu03/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3543712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f971a3c/uploads/origins/ead480df-e7dc-4d24-8356-4f7deb712fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb275854a361d92d597f7c8941ba6c49", "srcset": "https://si.imgix.net/9f971a3c/uploads/origins/ead480df-e7dc-4d24-8356-4f7deb712fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb275854a361d92d597f7c8941ba6c49, https://si.imgix.net/9f971a3c/uploads/origins/ead480df-e7dc-4d24-8356-4f7deb712fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddcd477ed364e570df181a4a5b5e5604 2x, https://si.imgix.net/9f971a3c/uploads/origins/ead480df-e7dc-4d24-8356-4f7deb712fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3cb45239aab338287324f17d13d25ae 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f971a3c/uploads/origins/ead480df-e7dc-4d24-8356-4f7deb712fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56f0e728087759237af427bb50022476", "srcset": "https://si.imgix.net/9f971a3c/uploads/origins/ead480df-e7dc-4d24-8356-4f7deb712fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56f0e728087759237af427bb50022476, https://si.imgix.net/9f971a3c/uploads/origins/ead480df-e7dc-4d24-8356-4f7deb712fdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=534f8aa594f094524251fbb32c6c97f0 2x, https://si.imgix.net/9f971