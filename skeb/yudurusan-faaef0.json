: null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947327, "client_id": 473292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63af5b90d1674d48c780b026632b12ba", "srcset": "https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63af5b90d1674d48c780b026632b12ba, https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8a08a776d0a151ee02a5f31dcf8af64 2x, https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6941b84af8595acfd633b7e48d48d2f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=599e47e511fbba9314cbd16f328cd8ad", "srcset": "https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=599e47e511fbba9314cbd16f328cd8ad, https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91d62daf3d2893655de478a2f6045dfe 2x, https://si.imgix.net/5d04f33b/uploads/origins/be47b335-8e6f-4b49-a1a9-39b8aef100f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e0f0c1a4d8ca8bcbd1f9f7555cd6d9e 3x"}, "body": "素敵な絵に惹かれました\nもしよければ19世紀ヴィクトリア朝イギリスが舞台の自作BL小説「驚異の部屋≪ヴンダー・カンマー≫」の受けと攻めの2ショットを描いてください\n\n■キャラ設定\nオリバー・スタンホープ\n20歳\nイーストエンドの貧民窟出身\n娼婦の私生児\n赤毛　鼻梁に薄いそばかす　茶色の瞳　エドガーよりは健康的な色合いの肌\n性格は現実主義　毒舌　皮肉屋　やや卑屈でシニカル\n絵の才能を見込まれ名門伯爵家に引き取られる\nエドガーには親友として熱烈に慕われているものの、彼の恵まれた境遇や円満な性格に対し、激しい劣等感や嫉妬・羨望を抱いている\n美術学校の学生\nエドガーに比べ世間ズレし、やさぐれた雰囲気\n属性的には強気流され受け\n趣味は賭け事（ポーカー）\n\nエドガー・スタンホープ\n20歳\n名門伯爵家の長男で父親に溺愛されてる\n心優しく品行方正　聡明な貴公子\n慈善活動に熱心で博愛精神旺盛\n絵の才能に秀でたオリバーに心酔し、彼の為に献身的に尽くす\n（が、オリバーには疎まれてる）\n外見はサラサラの茶髪　利発そうな鳶色の瞳　上品な白い肌\n美術学校の学生　将来の夢は画家\n属性的には執着尽くし攻め\n表情は穏やかで柔和な微笑み\n身長はオリバーと同じ位（170センチ程度）\n趣味は読書やチェス　絵画鑑賞\n\n参考画像\n（左がエドガー　右がオリバー　別絵師さまに描いていただきました）\nhttps://estar.jp/novels/26037062/viewer?page=1\n\n■希望する雰囲気\nヴィクトリア朝ロンドン　友人　日常　平和\n\n■服装\n時代や階級に相応な感じでおまかせ\n\n■関係性\n普段は友人\n伯爵の前では主従らしく振る舞ってるが、平素はもっと自然体で会話する\nエドガーはオリバーが大好き　彼の才能に心酔してる　子供の頃からの大切な親友\nオリバーはエドガーの一方的な好意にややうんざりしてるが、突き放しきれずいる\n\n不明点や絡みの程度はおまかせ　アレンジ歓迎\n完成品は下記サイト掲載他ネット小説の挿絵・宣伝に使わせてください\nお名前とアカウントは明記します\nhttps://www.alphapolis.co.jp/novel/904256305/200690095", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yudurusan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947327, "client_id": 869883, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/817f03ed/uploads/origins/6e3979fc-4437-4b49-86b2-01e54cdbde6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31bfcbc0d4d74f4ed9d1c2ed38857720", "srcset": "https://si.imgix.net/817f03ed/uploads/origins/6e3979fc-4437-4b49-86b2-01e54cdbde6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31bfcbc0d4d74f4ed9d1c2ed38857720, https://si.imgix.net/817f03ed/uploads/origins/6e3979fc-4437-4b49-86b2-01e54cdbde6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f04cfb34f6c426771ba68d12607fa4d 2x, https://si.imgix.net/817f03ed/uploads/origins/6e3979fc-4437-4b49-86b2-01e54cdbde6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2e96e2540075767153622446a7b92ab 3x"}, "duration": null, "nsfw": false, "hardco