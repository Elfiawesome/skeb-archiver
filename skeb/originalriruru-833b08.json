pr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=256a7758ad11f48d646e38008d0685fa 2x, https://si.imgix.net/7556b6a4/uploads/origins/424b953d-8527-4871-9a97-adeec8cbbb38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d5ee0a3362e595e57ac1c8eaded2e2a 3x"}, "body": "うちの子のいちごちゃんを描いて欲しいです！りるるさんの可愛い感じの雰囲気が好きなので衣装も構図も全部おまかせします！好きに楽しく描いていただけると嬉しいです！\n\nhttps://photos.app.goo.gl/ZyNiax2dCvngd1z5A", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@originalriruru/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3555444, "client_id": 3111803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48a690804c963ba33380003af411482e", "srcset": "https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48a690804c963ba33380003af411482e, https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b9a2a570dc183d2d1ea172e2ae731f1 2x, https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60349e02eebd174de60c1a9732fe40eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b99e457e44443dda1a360b7275f6f14e", "srcset": "https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b99e457e44443dda1a360b7275f6f14e, https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10a3fe8007d954385e8c2a674262d0ce 2x, https://si.imgix.net/28758455/uploads/origins/3082cad8-c9d7-4963-8c80-4b0cdde6a4fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79d562ad23f26aa0ffef195e92d8bd1e 3x"}, "body": "前回は、ocの衣装をデザインしてくださりありがとうございました!!凄く気に入っています…!!\nまた是非、しゅめーりるるさんに描いて頂きたいなと思いましたが、もし金額や内容、時期等難しい場合はご遠慮なくキャンセルしてください…!!\n\nわりと漠然としたイメージで、リクエストします。\n投稿されているイラストがどれも素敵で、かつ魅力の幅が広すぎて、作品そのものをおまかせ寄りでお願いしたいなと思いました。\n\n[リクエスト内容] \n・白い髪のocを描いてほしいです \n・デフォルメでなく等身高めで、中性的な大人っぽい顔寄り\n・一応、衣装はファイル内の「衣装1」か「衣装2」か「衣装5」のどれかを希望します(描きやすいようにアレンジ、新規デザインなどお好きなようにして頂いても嬉しいです!)\n\nhttps://x.com/originalriruru/status/1948733889918500904?t=bxeu-9zehCblogMGOUP3zA&s=19\nや\nhttps://x.com/originalriruru/status/1954539880110772522?t=AkVFsvvFo-0W2lahXXQYBQ&s=19\n・こちらのイラストのように、今回は立ち絵や衣装デザインではなく\"概念\"や\"モチーフ\"?、彼女の存在する空間を切り取った、雰囲気重視の作品をお願いしたいです。↑金額のこともありますので、この通りでなくて全然構いません!!!\nこのリクエスト自体を、しゅめーりるるさんに、おまかせしたいなと思いました🙇\n・使用用途は納品されたイラストによって変わるかなと思っておりますが……。彼女の特徴(目の色、浮いてる髪(以前デザインしてくださったリボンで縛っているのが可愛すぎて、とても気に入っています!)、過去の黒髪ocからの流れ/人物背景)など、\"白髪oc本人\"と分かる要素を一つは入れてほしいです。\n\n[希望] \n・雰囲気は『ちょっとニヒル/余裕のある/ぼんやり/おっとり/儚い』辺りのどれかになるのかなと思いました\n\n[NG]\n ・植物、動物、食べ物など自然の物 \n・グロい、病んでいる、ホラー、血、激怒など強すぎるの負の要素 \n・黒髪ocの衣装を着ること\n\n[モチーフ]\n・モチーフに関しては、私が考えたものから、沢山の絵師さんに新たに見いだして頂いた要素など様々なので、\"ご依頼した作品のフォルダ\"や\"自分で描いたやつのフォルダ\"を参照にして頂けたらと思います。\n・こちらもしゅめーりるるさんにお任せします。これまでの物でも新しくでも、一切使わない、という形でも構いません!\n\n [キャラ]  \n・白髪ocが現在の姿、その過去の姿が黒髪ocという関係性です \n二人の設定とキャラビジュ、三面図https://drive.google.com/drive/folders/1zhA5rYHcI-8nvXqSHB8onK-J5GxldwQA  \n※色は\"目の青色を揃える、色白\"以外はぶれても大丈夫です  \n\n [使用用途]  \n・個人での観賞\n・印刷して眺めたいので、個人用のグッズ作成(販売/譲渡は行いません)  \n前回のイラストは、記述した用途内で、個人用に印刷してファイリングしております!開くたびに、対になったお洒落なoc二人の姿が本当に可愛くて、とてもとても気に入っています……!!\n\n今回も、同じく使用用途に沿った範囲内での個人での観賞と印刷の許可をお願いしたいです。\n(例:印刷してスマホのカバー裏に挟む、スマホやタブレットの背景画面、アクリル、用紙印刷でファイリングしたり部屋に飾ったり など)\n使い方は全く決まっておりません!なので、比率も完全にお任せします。\n持ち歩いたり飾ったり、がっつり立ち絵だと少し難しいかなと思ったので、別の角度から表現された作品を見てみたいなと思いました!!\n\n・背景と人物が各々レイヤー分けされたものをPDFで頂きたいです。若しくは、背景とは別に人物を透過したイラストを頂けたら嬉しいです。  \n※snsには一切投稿しません\n\n長々と、失礼しました。\nそして、ふわっとした内容のご依頼文ですみません……\nご検討の程、宜しくお願いします!\n\nhttps://drive.google.com/drive/folders/15OI8aH51oE9VywMHMoW6sT_ZgOajE__E", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@originalriruru/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3555444, "client_id": 1399247, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67d2af950ddd44d6ccf7b4d1ec51c2e5", "srcset": "https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67d2af950ddd44d6ccf7b4d1ec51c2e5, https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba3281aee95fde1c133d76de2b545251 2x, https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=103ce7f376d932348f8bc27e5ca459a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20a78360aa7c16453d7bcdb64a5f488d", "srcset": "https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20a78360aa7c16453d7bcdb64a5f488d, https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb41aa97c11726fcc582d5322b5ff4f9 2x, https://si.imgix.net/dffedda9/uploads/origins/487a80d9-e072-49f1-92db-b8d011a96792?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46db662cd70d5fc74577fe5ddafa8e86 3x"}, "body": "はじめまして！\nSkebでイラスト拝見して、とっても素敵だったのでリクエストいたします！\n\n●依頼\n猫屋敷クロを描いていただけると幸いです\nポーズや表情、背景などすべてお任せします！\n\n●参考画像\nhttps://drive.google.com/drive/folders/1XY6bvLzEihYDD9jy3954xHkLWfQjEF6U?usp=sharing\n\n●用途\nアイコンと動画のサムネイルに使用する予定です\n背景と分離できると嬉しいです！\n\nご検討のほどよろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@originalriruru/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3555444, "client_id": 2199, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c82eb2cfde029f44e52a6eae6f6257b", "srcset": "https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c82eb2cfde029f44e52a6eae6f6257b, https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ff2f57becc786560de03ae0fdf319f5 2x, https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d50b2e4d55ac677fa500443e259001bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74597dbd9672b186a6d76e2e4edde62d", "srcset": "https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74597dbd9672b186a6d76e2e4edde62d, https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75c03929581fa5530a768e4289a8bbff 2x, https://si.imgix.net/b2ae853f/uploads/origins/f6bacdab-2b02-47a2-b650-018118de533e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd6d62cd8c91934b1debe01c4618162b 3x"}, "body": "はじめまして！\n温かみのあるタッチと、素敵な魔女デザインの数々に惹かれてリクエストさせていただきました。\nもし可能であれば、参照資料のオリキャラで新規衣装デザインをお願いしたいです！\nおまかせ要素多めとなってしまっておりますが、ご一考願えれば幸いです……！\n用途は個人鑑賞のほか、イラスト発注時の参照資料としての利用などを想定しております。\nどうぞよろしくお願いいたします。\n\n【イラスト概要】\n・昔わるい魔女をやっていた頃の姿、というコンセプト\n・とんがり帽子にローブ、黒メインのオールドスタイルな魔女衣装\n・棘(眠りの森の美女由来)、裁縫がキャラのメインモチーフなので、可能なら特に前者の要素を強めに\n・目つき悪め、表情不機嫌め\n\n上記要素を踏まえたうえで、詳細はお任せしたいです。\nアレンジ、独自解釈、なんでも大歓迎です！\n\n【キャラ設定など】\n名前：バーバラ\n年齢：不明\n身長：170cm程度\n外見年齢：18~20歳程度\n\n茨や針を操る力を持つ魔女。\n他の魔女たちの服を作りながら暮らしている。\n外見や普段の装いに反し、穏やかで礼儀正しく、のんびりした性格。\nただし、おこると怖い。\n魔法を用いての裁縫と、何もせずぼーっと過ごす時間が至上の幸せ。\n眠り姫の魔女や、裁縫がメインモチーフ。\n\n元は町の仕立て屋の娘。\nかつては喧嘩っ早い跳ねっ返りだった。\n色々あって魔女になってからしばらくはいっそうグレてしまい、邪悪な魔女として周囲から畏怖されていた。\n現在は丸くなったが、今も魔法使うよりフィジカルで戦った方が強い。\n\nhttps://drive.google.com/drive/folders/1iuZ67TRIiio1Xk-NOkRcVhb3kDIVYEw8?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@originalriruru/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b659607a/uploads/origins/7f0a7ef7-bd38-4e64-a7d7-0ecafaf25f3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e8c298e70e10549c60be9ad1f89a2f97", "srcset": "https://si.imgix.net/b659607a/uploads/origins/7f0a7ef7-bd38-