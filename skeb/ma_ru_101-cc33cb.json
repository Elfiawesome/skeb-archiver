igins/510ceb69-968c-4ea5-9e90-14f8a0d6a8fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f33e7cc1bff34406bc381c17d0c8fae5 3x"}, "body": "初めまして！\nマル様の絵柄やキャラクターデザインがとても好きで、オリジナルキャラクターをデザインしていただきたくリクエストさせていただきました。\n\nキャラクターの特徴\n・天使娘(エルフ耳・天使の輪・羽があると嬉しいです)\n・白髪のツーサイドアップのロングヘアにゆるくウェーブがかった髪\n・たれ目でおとなしい感じ\n・少し幼めな顔\n・服装はホワイトロリータ風\n\nあとはすべてお任せいたします。\n描いていただいたイラストは個人で鑑賞させていただきます。\n初めてのskeb依頼で失礼がありましたら申し訳ありません。\nご検討よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ma_ru_101/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3426344, "client_id": 3694581, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c9ea81f66574bc17b6c8bea05156e1", "srcset": "https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03c9ea81f66574bc17b6c8bea05156e1, https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=485dea8f81ee854c91b4a206159f65e3 2x, https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd05a294b835e6eb78720b21afb487df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50620f2a5ce8b3983737a57495ccd4c4", "srcset": "https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50620f2a5ce8b3983737a57495ccd4c4, https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2832a1855c7652f7e2f3e9be665132ad 2x, https://si.imgix.net/39eb7492/uploads/origins/3ac7c99e-d35d-426d-b105-82ea0dbd6eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e751508f1655e097dc07f6699bda8343 3x"}, "body": "はじめまして！あなたのキャラクターデザインがとても気に入ったので、私のキャラクターの怪物形態をデザインしていただけないかお願いしたいです。私のキャラクターは吸血鬼で、バラの眼帯が外れると怪物形態に変身します。キャラクターの全身に棘をあしらうことを考えていますが、怪物形態のデザインはご自由に、思い切り想像力を発揮して描いていただければと思います。 ただ一つお願いしたいのは、本当に怪物的で恐ろしい姿にしてほしいということです。『オーバーロード』のシャルティア・ブラッドフォールンの真の姿を参考にしてもいいですが、それでも私のキャラクターの怪獣形態には少し優雅さも残してほしいです。ご検討いただきありがとうございます！\n\nキャラクターの参考資料はGoogleドライブにリンクしています。\n\nhttps://drive.google.com/file/d/1gmy3kPn-qlqwmEHdf_PIs7-8tTcuMl4M/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ma_ru_101/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7898b068/uploads/origins/f4d03671-96c9-4082-9974-318a4a9cd2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cd5777f831e6cf6d91cf136ebf096e2", "srcset": "https://si.imgix.net/7898b068/uploads/origins/f4d03671-96c9-4082-9974-318a4a9cd2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1cd5777f831e6cf6d91cf136ebf096e2, https://si.imgix.net/7898b068/uploads/origins/f4d03671-96c9-4082-9974-318a4a9cd2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c6469fbef07644efadb06aad48f908b 2x, https://si.imgix.net/7898b068/uploa