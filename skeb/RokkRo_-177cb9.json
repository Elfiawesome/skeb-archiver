ープ可\n・歌声は無し\n\n\nご縁がありましたら、よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@minocchan1007/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3278901, "client_id": 3378765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b3bdacca8fefe8816c2cb7f884db315", "srcset": "https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b3bdacca8fefe8816c2cb7f884db315, https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94e803ca1b816a61546e6c792f1e2ef7 2x, https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1103859d9861ed56e52330ad157e2fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13ab65402c39a8d22a1df471ebaf3fec", "srcset": "https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13ab65402c39a8d22a1df471ebaf3fec, https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e0066be76c4e4e8135d36a5bf057c1d3 2x, https://si.imgix.net/fbc1a798/uploads/origins/f3b70201-199e-4bdf-8415-5c512f912827?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr