③のイラストをそのまま額へ)\n\nという感じのシチュを描いてもらえないでしょうか？\n\n100の人がアリア姫の姿へ変わる要素が含まれていれば、他の内容はガッツリ変えてもらってもかまいません。\n金額不足でしたら再送要請してください。\nご検討よろしくお願いします。\n\n【100の人についての資料】\n■立ち絵・設定\n↓の右側 (ヒト型)\nhttps://www.pixiv.net/artworks/128487854\n■額の宝石やしっぽ部分の3Dモデル\nhttps://virtualcast.jp/items/acacf505a4d84111c58ade19a42772c3851e0083db9e12b3ab79ae6bb019977a\n※しっぽの文字は省略してもらってもかまいません", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FlaTTeneD274/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3867736, "client_id": 2110830, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0eea90dd/uploads/origins/2ee99af1-49ba-40b6-a058-292ffaa56b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fe970b701776e419f1df8bdcdb8200c", "srcset": "https://si.imgix.net/0eea90dd/uploads/origins/2ee99af1-49ba-40b6-a058-292ffaa56b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0fe970b701776e419f1df8bdcdb8200c, https://si.imgix.net/0eea90dd/uploads/origins/2ee99af1-49ba-40b6-a058-292ffaa56b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c2cd35a2953cb4942f78ea40a4f3456 2x, https://si.imgix.net/0eea90dd/uploads/origins/2ee99af1-49ba-40b6-a058-292ffaa56b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=807df2476fc4bbf29e41950f9c25b3a7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0eea90dd/uploads/origins/2ee99af1-49ba-40b6-a058-292ffaa56b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a7677929651e65ecc6ede7a8d53dcfa", "srcset": "https://si.imgix.net/0eea90dd/uploads/origins/2ee99af1-49ba-40b6-a058-292ffaa56b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a7677929651e65ecc6ede7a8d53dcfa, https://si.imgix.net/0eea90dd/uploads/o