97 2x, https://si.imgix.net/5eab8e3a/uploads/origins/e96ab879-0997-4edb-9b88-da0c675c1a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61ae5afe9b1fa0cb15c52439b12212b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5eab8e3a/uploads/origins/e96ab879-0997-4edb-9b88-da0c675c1a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6b6ac848814335a86710d3b0a4407a6", "srcset": "https://si.imgix.net/5eab8e3a/uploads/origins/e96ab879-0997-4edb-9b88-da0c675c1a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e6b6ac848814335a86710d3b0a4407a6, https://si.imgix.net/5eab8e3a/uploads/origins/e96ab879-0997-4edb-9b88-da0c675c1a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1afeb0ea3f11c6ab3965b5f4509438 2x, https://si.imgix.net/5eab8e3a/uploads/origins/e96ab879-0997-4edb-9b88-da0c675c1a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35c7b07ac17b98a8a3c91f32a8e2231b 3x"}, "body": "私はあなたの作品が大好きで、私のオリジナルキャラクター（OC）の仕事をしてもらいたいと思っています。  本当にありがとうございました！ 彼女の姿を見るためのリンクです。 https://drive.google.com/file/d/141a06tgN0fRfsHKpfryx6zSqKGNEEirx/view?usp=drivesdk  他にも、悪役で精神的に参っていて、歯が鋭いのが特徴です。 ぜひ、自由に作ってみてください。 読んでくださった方、ありがとうございました！\n\nhttps://drive.google.com/file/d/141a06tgN0fRfsHKpfryx6zSqKGNEEirx/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@poaro_coffee/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1423672, "client_id": 127734, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2587c9128ceb9ef467367f29598de65", "srcset": "https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2587c9128ceb9ef467367f29598de65, https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64300c40980336286ba45996bbb72fc5 2x, https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4083d34703321c36514069c176b81497 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a903e7defc95c5bfbac93cf52674cf2b", "srcset": "https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a903e7defc95c5bfbac93cf52674cf2b, https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0297ec8936ac0ea925754ff86de7e9b7 2x, https://si.imgix.net/d80b75ad/uploads/origins/d360fb19-e65c-4f2c-865d-6cd365870a61?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79eae83db40f238340eef4b50f3543b3 3x"}, "body": "はじめまして、ぽあろさん。私のキャラの画像をお願いしたいと思って、よろしくお願いします。\n\nこの子の“普通の人間”の状態は髪も目も靴もミントグリーン色です。でも、本来の「通常の姿」になると、髪は\"ボトルミク\"の水髪のようになります。 しかし、髪の毛の構成は水というよりも泡に近い、\nヘアテールは小さな泡を作ります。ふくらはぎ付近までの髪の長さ。髪の毛の反射は、泡のような虹色の光になります。\n\n猫耳や尻尾は、シャボン玉で作ったアクセサリーです。お好みで、他の泡アクセサリーに変えたり、外したりすることができます。\n\n今回はデフォルトの衣装を使用します。また、お好みで、他の衣装を描くこともおｋです。\nお願いしたいことはただ1つだけです。この子をどう描くかはお任せしますので、できるだけ可愛く描いてください。（でも、メグメグは1番かわいいです）\n\nメグメグちゃんのママをリクエストする機会を得られたことを嬉しく思います。ありがとうございます。\n再び、よろしくお願いします🙏\n\nhttps://drive.google.com/drive/folders/1rae3Pc5tJkluwYq0acaQuDS1GO71AZ5F?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@poaro_coffee/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1423672, "client_id": 1275877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491e87eca89dc6d3de86e5c42aef548f", "srcset": "https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=491e87eca89dc6d3de86e5c42aef548f, https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=462ff8e86f9b0220e392ae0119074e58 2x, https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d77027e18eec1ea7555d6c1af0f9d466 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da0d64c3fe76ac1556d438e85df5798", "srcset": "https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8da0d64c3fe76ac1556d438e85df5798, https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a21c0706e8604ca012eb943b0d7b0a5 2x, https://si.imgix.net/70e30a39/uploads/origins/0555e2b4-1452-42ff-b8ef-9d9c7b878e81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=