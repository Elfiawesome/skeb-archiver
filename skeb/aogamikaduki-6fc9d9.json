す。分離不可の場合は統合状態を問いません。\nどうぞよろしくお願いします！\n\nまとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n資料URL\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm\n\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aogamikaduki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 29422, "client_id": 3050113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e123287/uploads/origins/657eb580-55e0-4996-8cd4-6a7669ffeb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4531fcb48a2ed84e18dfe08f815edef9", "srcset": "https://si.imgix.net/4e123287/uploads/origins/657eb580-55e0-4996-8cd4-6a7669ffeb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4531fcb48a2ed84e18dfe08f815edef9, https://si.imgix.net/4e123287/uploads/origins/657eb580-55e0-4996-8cd4-6a7669ffeb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac650b60cff47c472695576d7c19485f 2x, https://si.imgix.net/4e123287/uploads/origins/657eb580-55e0-4996-8cd4-6a7669ffeb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9909ab816c57824edfc33a0a758d17dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e123287/uploads/origins/657eb580-55e0-4996-8cd4-6a7669ffeb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ee42c99b7f1931c3d713e29734b678a", "srcset": "https://si.imgix.net/4e123287/uploads/origins/657eb580-55e0-4996-8cd4-6a7669ffeb46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ee42c99b7f1931c3d713e29734b678a, https://si.imgix.net/4e123287/uploads/origins/657eb580-55e0-4996-8cd4-6a7669ffeb46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&