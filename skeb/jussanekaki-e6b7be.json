2&fit=crop&crop=top&w=200&h=200&s=a0d99d55a766c1315150f1d65c8faa26 2x, https://si.imgix.net/3855856e/uploads/origins/6236824f-cd22-4be6-b482-e26180324c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d2cfdcbd414b5f2149fd768496777bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3855856e/uploads/origins/6236824f-cd22-4be6-b482-e26180324c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfe4708cbcf1957f0d90d68b20dbb3f4", "srcset": "https://si.imgix.net/3855856e/uploads/origins/6236824f-cd22-4be6-b482-e26180324c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfe4708cbcf1957f0d90d68b20dbb3f4, https://si.imgix.net/3855856e/uploads/origins/6236824f-cd22-4be6-b482-e26180324c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e0120ac3c21bc45a317f416b42345c5 2x, https://si.imgix.net/3855856e/uploads/origins/6236824f-cd22-4be6-b482-e26180324c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d15e91cb0a467010f3263c3df2c8346 3x"}, "body": "はじめまして。先生の作品にとても憧れているので、これが採用されたら嬉しいですオリジナルキャラクターのイラストをお願いしたいです。\n\n🐺キャラクターA。184cm。猟師。弓道が得意。地図を描くのが得意。クールで真面目な性格。肩幅が広い。眉毛が太い。肌の色に注目してください。赤い服装でお願いします。髪型は低めのポニーテールでお願いします。\n\nモチーフ：矢、地図、羊皮紙、黒い地平線\n\nそれ以外の構図は、お任せします!依頼内容に問題があれば、遠慮なくお断りください。ありがとうございました!\n\nhttps://www.dropbox.com/sh/xs6ea5vn817keye/AAAgbz6YLBZJCJAudy6TxBN-a?dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jussanekaki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1396974, "client_id": 1249415, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3983cf38/uploads/origins/811f2edf-049c-4749-9997-b5cb17cea537?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97f6