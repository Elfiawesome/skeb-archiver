る。髪の毛は、右に小さな三つ編みをしています。\n\n今回の要望としては、物語の別の時間軸を示す絵が欲しいです。左目の花の代わりに、生気のない黒目を見せることは可能ですか？彼は剣の力で堕落する。彼は不穏な笑みを浮かべ、鞘から剣を抜いているだろう。可能であれば、絵の中にうっすらとした血の気配を入れることができますか？参考資料に表情の写真を掲載しています。どのように解釈するかは自由です。\n\n 可能でしたら宛名とサインはpsdレイヤーでon/offできると嬉しいです。 ご検討よろしくお願いします!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@jussanekaki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1396974, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/186c1080/uploads/origins/aa529e71-0aa4-42cd-af51-c34452eb4d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1758d9217c0901015c4e3516c860dd4", "srcset": "https://si.imgix.net/186c1080/uploads/origins/aa529e71-0aa4-42cd-af51-c34452eb4d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1758d9217c0901015c4e3516c860dd4, https://si.imgix.net/186c1080/uploads/origins/aa529e71-0aa4-42cd-af51-c34452eb4d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b5d3524a8e4260760a0de1cefb037bd 2x, https://si.imgix.net/186c1080/uploads/origins/aa529e71-0aa4-42cd-af51-c34452eb4d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da1b61e4e48623fae54f76ec93a59808 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/186c1080/uploads/origins/aa529e71-0aa4-42cd-af51-c34452eb4d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c085bbfc21793c414376a281c81538e2", "srcset": "https://si.imgix.net/186c1080/uploads/origins/aa529e71-0aa4-42cd-af51-c34452eb4d66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c085bbfc21793c414376a281c81538e2, https://si.imgix.net/186c1080/uploads/origins/aa529e71-0aa4-42cd-af51-c34452eb4d66?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=