fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f69f9c45cd8d53a4361601e82bfc8d13 2x, https://si.imgix.net/36237bf1/uploads/origins/d7c9a4b6-e6d9-422b-aade-ca51a3df593b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff5cecc67bb24b6dbdf37f61e4d250b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36237bf1/uploads/origins/d7c9a4b6-e6d9-422b-aade-ca51a3df593b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a771225f85bfb83a503c4e30ed5810a8", "srcset": "https://si.imgix.net/36237bf1/uploads/origins/d7c9a4b6-e6d9-422b-aade-ca51a3df593b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a771225f85bfb83a503c4e30ed5810a8, https://si.imgix.net/36237bf1/uploads/origins/d7c9a4b6-e6d9-422b-aade-ca51a3df593b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e34ccfc8a73a3bf08994092f44aadd2 2x, https://si.imgix.net/36237bf1/uploads/origins/d7c9a4b6-e6d9-422b-aade-ca51a3df593b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4a0d1dad2ded10807195c039e057dab 3x"}, "body": "えいすけさんはじめまして！\nこの度は一次創作カップルの探偵パロディのコミックを描いていただきたくリクエストしました。\n\n服装などの資料は下記のリンクにてまとめております。\n服装はお好きに簡略化や変更してください。描きづらければ上着や帽子無くて大丈夫です。\n\n人物紹介(探偵パロディ)\n\n女の子(探偵)：高梨 真緒\nミステリー小説の探偵に憧れて小さな探偵事務所をやっている。\n憧れているだけで特に推理が得意な訳ではなく、どんくさくてぼーっとしているため、事務所はいつも閑古鳥が鳴いている。\n暇があれば新作のミステリー小説を読んで満足している。\n頼りになり、料理の上手い助手ができて嬉しく思っている。\n相手の呼び方は、ワンくん。\n「うーん…わからない…」\n「ワンくん、これは一大ミステリの匂いがする」\n「探している猫とは模様が少し違うみたいだけど…」\n\n男の子(助手)：ワン シェンユエ\n知人から紹介された探偵事務所で探偵に一目惚れし、依頼などはもうどうでも良くなって助手にしてくれと頼み込み強引に助手になった。\n探偵のことを恋愛的に好きで、探偵が幸せであれば他はどうでもいい。\n勘と愛想が良く、口が達者。\n事務所が潰れない程度に依頼者を連れてきてくれるが、探偵が好きなことをして毎日を過ごしているのを隣でずっと見ているのが目的なため、解決することにさほど興味や情熱はない。\n相手の呼び方は、先生。\n「先生〜もうこの猫でいいんじゃなイ？」\n「先生、疲れたからケーキ食べヨ〜」\n「ワーッ！依頼書が燃えてルーッ！」\n\n日常の2人は、\n・依頼書を虫眼鏡で見て太陽光で依頼書を燃やしてしまう探偵と、火傷を心配して指をフーフーする助手。後ろでごうごうと燃える依頼書。\n・猫探しでなかなか見つからず、もう似てる猫を渡してしまえばいいんじゃないかと適当なことを言う助手。\n・美味しいケーキを探すという依頼を、助手が用意したものと気づかず、おなかいっぱいになったし解決もできたと満足している探偵。それを見てにこにこしている助手。\n\nなど、ギャグでコメディな感じです。\n上記のエピソードを描いてもいいし、思いつくものを自由に描いていただいてもいいです。\n\nリクエストに難があれば金額不足での再送やキャンセル等遠慮なく対応していただけると幸いです。\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-wLVqtZRbaN0Pzo8zLPCVe8fY3PKVQ8y", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@iesuke/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2349388, "client_id": 3704730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66773501/uploads/origins/39c6ab74-fc92-4208-a5b1-0ea77572dd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11de5823ebfe0ea8d47d7c09c5a12dc", "srcset": "https://si.imgix.net/66773501/uploads/origins/39c6ab74-fc92-4208-a5b1-0ea77572dd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11de5823ebfe0ea8d47d7c09c5a12dc, https://si.imgix.net/66773501/uploads/origins/39c6ab74-fc92-4208-a5b1-0ea77572dd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a8c92dc30a58d2912719925d5c26587b 2x, https://si.imgix.net/66773501/uploads/origins/39c6ab74-fc92-4208-a5b1-0ea77572dd47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbeeb4fa1306007eb9779603acddc140 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66773501/uploads/origins/39c6ab74-fc92-4208-a5b1-0ea77572dd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6a875cd25461b3d567d1b3c9b261db", "srcset": "https://si.imgix.net/66773501/uploads/origins/39c6ab74-fc92-4208-a5b1-0ea77572dd47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6a875cd25461b3d567d1b3c9b261db, https://si.imgix.net/66773501/uploads/origins/39c6ab74-fc92-4208