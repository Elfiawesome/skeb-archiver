&fit=crop&crop=top&w=200&h=200&blur=200&s=399696588a75d30754e43076c71093f5", "src_set": ""}, "body": "こんにちは、あなたの絵と特に照明のやり方が大好きです！私のキャラクターを描いてもらえませんか？\n\nゴールドブロンドのロングヘアで、青い目をしています。年齢は27歳です。大人びた上品なお姉さんタイプで、切なく柔らかい性格です。太陽、海、花が彼女の大きなモチーフです。色は薄いピンク、水色、ラベンダー、黄色。  ポーズや表情はお任せします。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1jnap_URL4x6cZ2CGke3KVC_zwBxR4PfE?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947460, "client_id": 3408227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f9c1589/uploads/origins/0063066a-bb68-468d-815e-c8dc2d83536b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aceb21da6e3058532e125bb12a1c92e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f9c1589/uploads/origins/0063066a-bb68-468d-815e-c8dc2d83536b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e48abc07ed0362884df353cfda49001", "src_set": ""}, "body": "かgrさんこんばんは！ かgrさんの独特な雰囲気があるイラストと色彩感覚が大好きで数年前からずっとご依頼をお願いしたいと思っておりました♡\nもしよろしければ、私のocを描いていただきたいです…！\n以下資料になります。\nhttps://drive.google.com/drive/folders/1BPJtfzHFOzUkiCHBSvPSvbuABg4wV7hG\n\nかgrさんワールド全開でお願い出来たらなと思います。お好きなように描いていただければと幸いです！特にNG等ございません。\n以上、どうぞよろしくお願い致します！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2947460, "client_id": 1622498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35fb148b/uploads/origins/e2ef2622-401c-46e4-aa56-6e1fe521fe71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2273b7b210228eadbc3c6be8ba685511", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35fb148b/uploads/origins/e2ef2622-401c-46e4-aa56-6e1fe521fe71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f174c6b22764ed8b664efcb1b39f6e6", "src_set": ""}, "body": "こんにちは！僕のOCであるLughとFintanの一部をお願いしたかったんだ。\n\nリューとフィンタンは兄弟で、とても仲の良い王子です。リューは10歳、フィンタンは7歳です。二人を囲むように、ハートの形をした蔓があり、そこに複数の花が咲いているようなイメージでお願いします。花の順番は、リューから始まり、フィンタンまででお願いします。\n\n青いアジサイ\nピンクのカーネーション\nアルストロメリア\n菊\nピンクのシャクヤク\nスプレケリア\nサンザシ\nスノードロップ\nアカシア\nオトギリソウ\nピンクローズ\nエーデルワイス\nパープルアイリス\n\nできれば、リンドウの花はリューに、白いクチナシの花はフィンタンに持たせてください。\n\nhttps://imgur.com/a/FhIzdM5\n\n価格が間違っている場合は、お気軽に再送してください。ご配慮ありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c620847b/uploads/origins/bd0fb452-a339-4eaf-96cd-f2c400a9672c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8e9f72d33f1d58f7a47d4deba3d040da", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2947460, "client_id": 2646402, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947460, "client_id": 1532526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbe4e96d/uploads/origins/b807b7ed-44b5-4358-bfd4-da5d6fee06f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f6f5b277ffc302c068f0edcf606849f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbe4e96d/uploads/origins/b807b7ed-44b5-4358-bfd4-da5d6fee06f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c99e4c63f4319d39c490d4a90b7a780", "src_set": ""}, "body": "Hello かgrさん!\nIt's nice to meet you!! I saw your works and really love your style! Your art is so lovely!\n\nCould I please request art of my vtuber character? She is a scarecrow farmer who is rather caring and loves plants, but a little bit clueless about life. She also has a crow friend (but you do not have to draw them if you do not want to!) Apart from that please feel free to draw her in whatever outfit and however you would like!\n\nI would like to use this on SNS, Twitch and/or possible Youtube singing cover, and would like a version with separated/transparent BG if possible!\n\nIf the amount is not enough, please feel free to appeal!\n\nThank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1Wx5QfaVGKtQxvhbRvNuoc3qNsbvA-Q1K?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/91ddd42e/uploads/origins/25abbe6a-be5b-4511-ac8e-572e4eea07da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aaa07651b4c94c091b89fe657cfb9d7d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2947460, "client_id": 2691466, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947460, "client_id": 2141174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3542ee8d/uploads/origins/68dd2a97-1f1f-4835-b18d-9f9de5ec4df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1e8669d5a38f379b909772fbfccb2d9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3542ee8d/uploads/origins/68dd2a97-1f1f-4835-b18d-9f9de5ec4df6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88e94f1519bbb40c54d771a1588ce160", "src_set": ""}, "body": "こんにちは！この度は私のキャラクターに興味を持っていただき、ありがとうございます！以下に私のキャラクター紹介を追加しました！\n\n彼女はふわふわの長い髪をしていて、肌はとても青白く、やや灰色です。彼女はまた、サソリに関連した力のテーマを持っています！彼女のタイプはとてもエーテル/女神のような雰囲気です。彼女の雰囲気にインスピレーションを得るためにPinterestのボードも持っていますhttps://pin.it/374gux8rP（彼女の全体的なテーマはスーパーブルーです）。\n彼女はソフトな性格で、目は眠そうで、あまり表情を見せません。好きなように描いてください！\n\nhttps://drive.google.com/file/d/1I9aLzpodzDzXPobKiCgxVPKNWSpLUpO1/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/388f05cf/uploads/origins/2dafd787-ab1f-4c26-aee6-9f1857854cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32f5cc0cd621b1f0e41ae16667cba81a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2947460, "client_id": 3446390, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2947460, "client_id": 1007314, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb46b6ae/uploads/origins/f9ca5886-c7cc-4977-abd4-4acc5d4603ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed788eb6412f42d1b3e474098ae4dca1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb46b6ae/uploads/origins/f9ca5886-c7cc-4977-abd4-4acc5d4603ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2ed242077ca3e90d99aa25d373b3bab", "src_set": ""}, "body": "初めまして、アピールありがとうございます。うちの子を褒めてくださり凄く嬉しいです。\n\nかgr様のアピール内容とイラストを拝見し、是非かgr様にうちの子を描いていただきたいと思ったので、リクエストを送らせていただきました。\n\n構図などは全てお任せします。\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1DEbh3HgHDpmQVzLLRywlDkprw6XSnnWM?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3a5b4982/uploads/origins/62cbbd53-2c9d-4c1b-919e-342f4a8e0ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cbe60c00cadc29837cd1f2d182b6d21d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2947460, "client_id": 1254072, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kgr0711/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2947460, "client_id": 3136236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38c82b11/uploads/origins/b0746f9c-5bbc-4c2e-843f-e02b2a9a5189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=423dd6da886935e3501c5108046a1262", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"sr