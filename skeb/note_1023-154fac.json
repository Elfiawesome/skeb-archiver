に愛を執拗に確認するようなイメージでめちゃくちゃにして欲しいです。プレイ内容はお任せします。\n\n衣装について、ニューイヤーの温泉シーンでドスケべな水着？が出てきたのでそれでお願いします。\n\nにしてもナーガ種の骨格ってズルいですよね。太くながーい尾で締められるのも良いですし、あの大きな手でゆるゆると扱かれるのも良いし、細長い舌でチロチロされたいって気持ちもあります。\n\n以上、楽しいお話をお待ちしております！", "nc": 48, "word_count": 11244, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@note_1023/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7cadaf75/uploads/origins/2123030a-c1e7-4cb8-be7b-af8d401c74ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63c5fad813122315868096c15e386fef", "srcset": "https://si.imgix.net/7cadaf75/uploads/origins/2123030a-c1e7-4cb8-be7b-af8d401c74ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63c5fad813122315868096c15e386fef, https://si.imgix.net/7cadaf75/uploads/origins/2123030a-c1e7-4cb8-be7b-af8d401c74ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5599faa87d7558863c4589984b6e6568 2x, https://si.imgix.net/7cadaf75/uploads/origins/2123030a-c1e7-4cb8-be7b-af8d401c74ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bced7176573b09753a44aa35d091212 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 1350710, "nc": 33}, {"path": "/@note_1023/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1350710, "client_id": 1053818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16859b31/uploads/origins/24c9d7d8-4cd2-446a-8b42-2fc50686be47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200