200&h=200&s=64ed374b376891284a8c5494d5340f09 2x, https://si.imgix.net/2383a9a6/uploads/origins/be91f6e4-c8f6-4d42-9f89-b3d43ed67353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7d519a2793ac7584bf0f3741a0ff3b6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2383a9a6/uploads/origins/be91f6e4-c8f6-4d42-9f89-b3d43ed67353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20845c15303c87c62aaf38cb79e94325", "srcset": "https://si.imgix.net/2383a9a6/uploads/origins/be91f6e4-c8f6-4d42-9f89-b3d43ed67353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20845c15303c87c62aaf38cb79e94325, https://si.imgix.net/2383a9a6/uploads/origins/be91f6e4-c8f6-4d42-9f89-b3d43ed67353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93ef3308b808efd60b2ac0a515608ecf 2x, https://si.imgix.net/2383a9a6/uploads/origins/be91f6e4-c8f6-4d42-9f89-b3d43ed67353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88b59b991f622c42327776c435442867 3x"}, "body": "初めまして！\n神木様の書かれるキャラや作品の雰囲気、種族差、歳の差、体格差が盛り込まれたシチュエーションが好きです。\n(イマジナリ・ゲノムの二人、隣の老竜の竜神様、新宿牙城Grrrの大崎さんがお気に入りです)\n神木様の作風でうちの子SF龍人(外見参考資料)のイチャラブを書いていただけませんでしょうか？\n\n世界観\n哺乳類種、両生類種、鳥類種など様々な外見をした人類が存在する銀河系宇宙。\n恒星間航行技術が開発され、数多の種族たちが時間と空間を飛び越え旅をする世界。\n\nキャラクター設定\n武官 : 宇宙に進出した様々な種族で構成される『連合(アライアンス)』と呼ばれる統治機関の実行部隊に属する武官。\n日夜アライアンスへと報告が上がってくる無数の事案の中でもとりわけ危険で困難を伴う未知文明の調査、敵対的な生命体の撃退、極限環境下の救助・救出活動等々の解決を任されては宇宙の彼方へ馳せ参じ対処にあたっている。\n几帳面でなかなか逢えない歳上の恋人に深い敬意と愛情を抱いている。\n\n官僚 : 同じくアライアンスに属する事務方で複数の部局上位者とのホットラインを持つ影の実力者的立ち位置。\n事案における企画立案や根回し、外部折衝にあたる。\nいじっぱりの寂しがり屋で歳下の恋人の懐に抱かれて甘えるのが好き。\n共に生殖従事者(既婚者の意味、現在の龍人世界では雌や公的な人口調整機関から精子提供の要請を受けて仔を遺すのが一般的で危険な職業に従事したり能力が高く実績を残した者ほど優遇を受ける)で複数の仔がいる。\n\n見たい表現やシチュエーション\n武官と官僚の甘々イチャラブセックス\n(同性同士の愛情や快楽を目的とした性的接触は普通に行われている)\n二人の馴れ初めや過去エピソード、セックス時のシチュや役割もお任せしますので必要でしたら自由に書いてください\n\n二人の名前は神木様に名付け親になって頂ければ嬉しいです\nもし書くのか難しかったり趣味でなければ設定や背景も自由に変更して設定してください\nわからなかったり迷ったりする部分は神木様の好きな様に解釈して下さい。\n細かい部分なども自身の書きやすさとイメージを優先して自由に楽しく書いて下されば幸いです\nそれでは宜しくお願いします！\n\nhttps://drive.google.com/drive/folders/1BrdjhQeUOJy5-eF_yF6DsiQWqWqC00WF", "nc": 176, "word_count": 30094, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@note_1023/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1834cd43/uploads/origins/658b16fe-c281-415e-80ff-9a86ce9b3fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfb8fe488da1e4a50bb1e45743c4ac87", "srcset": "https://si.imgix.net/1834cd43/uploads/origins/658b16fe-c281-415e-80ff-9a86ce9b3fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dfb8fe488da1e4a50bb1e45743c4ac87, https://si.imgix.net/1834cd43/uploads/origins/658b16fe-c281-415e-80ff-9a86ce9b3fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=371fd80b56229933118f2a7c92d3656a 2x, https://si.imgix.net/1834cd43/uploads/origins/658b16fe-c281-415e-80ff-9a86ce9b3fa0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=907d2e7510f3fd03b9906cdd6a5a139a 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 1350710, "nc": 48}], "sent_works": [], "similar_creators": [{"id": 46684, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "蘇芳", "screen_name": "aden0ph0ra", "avatar_url": "https://pbs.twimg.com/profile_images/1650030940440383488/2g7xV0VM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/392017992/1660734222/1500x500", "appeal_receivable": true, "popu