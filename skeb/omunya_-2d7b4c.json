aatJCk05JlN84nNY0FplkUAxueE?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omunya_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1106688, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b4cc76be6fde65176f0976e702bfa9", "srcset": "https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b4cc76be6fde65176f0976e702bfa9, https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49e18b86538d389ed1ec14fbc5e3290b 2x, https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77d5c2518f307d3f619a36e32873543e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ce0b3a0b31cf191ff3bfbc8ab4c7742", "srcset": "https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ce0b3a0b31cf191ff3bfbc8ab4c7742, https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5a844a9356df2a51fc09ad13e199d6f 2x, https://si.imgix.net/3073f88b/uploads/origins/3ba8281c-290d-4b3e-903c-2ec736018ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ffbd1997bfe1bc8330005649dc4146c 3x"}, "body": "はじめまして。今回は里内さまに、ソーシャルゲーム『プリンセスコネクト！(プリコネ)』シリーズに登場する『ラビリスタ(模索路 晶)』、及びマスコットとしてですが『リノ』『シズル』というキャラクターが写ったイラストを描いていただきたくご相談にあがりました。\n\n　イメージラフ、公式絵等の資料を添付いたしますので、下記のオーダーに加え、添付資料も併せてご確認していただけたらと思います。\n\n　構図としましては、『こちらを見て微笑みながら、リノとシズルのぬいぐるみを両腕でぎゅっと抱き上げているラビリスタ』といった感じでお願いしたいです。\n\n　イメージラフではシンプルな腰上からの構図で動きの少ない感じですが、ポーズ・画角の調整等は里内様の描きやすいようにご自由にしていただいてかまいません。背景の指定はなしですが、イメージ的にはギルドハウス(『プリぐるみ資料』参照)の壁で、面倒でしたら単色やパターン等でも大丈夫です。\n\n　ラビリスタの衣装についてですが、今現在2種類のバトルコスチューム(胸元のデザインがシンプルめで赤・黒・銀の3色のみで構成されたバージョンと、胸元に銀の飾りがあり襟に金色の線が入っているバージョン)が存在しますが、今回はそのうちの前者(『公式絵』資料に添付している方です)で描いていただければと思います。ソシャゲキャラなので細やかな装飾が多いですが、面倒でしたらガッツリ省いていただいて構いません。\n\n　表情についての補足ですが、ラビリスタは少し太めの眉や、笑った時に若干猫口っぽく歪む口、というやや特徴的な顔パーツを持つキャラクターですので、そこら辺を反映していただけると嬉しいです。イメージラフよりももう少し目を細めて微笑んでいる感じだとよりイメージに近いかな、と思います。\n\n　ぬいぐるみ(リノ・シズル)についての補足ですが、こちらは同作に家具として登場する『プリぐるみ』というぬいぐるみがありますので、体型や顔の感じはこちらを参考にしていただけたらと思います。\n　縫い目等のぬいぐるみ的なディテールはお好みで大丈夫(めんどくさかったら無視していただいてかまいません…！)ですが、肌や髪の塗りなどはぬいぐるみっぽくツヤ消しの感じだとよいと思います。\n\n長くなってしまいましたが、以上となります。もしよろしければ描いていただけると嬉しいです。\n\nhttps://drive.google.com/drive/folders/1-Agt3RPbbY_C8TBbacrmV7oNSYolYfDM", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@omunya_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1106688, "client_id": 350814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d57cf57/uploads/origins/08b7191f-1c8e-4faf-bcd8-12c634e62ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef42e295ba2edb4644def95cb0fdd22", "srcset": "https://si.imgix.net/2d57cf57/uploads/origins/08b7191f-1c8e-4faf-bcd8-12c634e62ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ef42e295ba2edb4644def95cb0fdd22, https://si.imgix.net/2d57cf57/uploads/origins/08b7191f-1c8e-4faf-bcd8-12c634e62ddd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec1ae88cd4699d56a