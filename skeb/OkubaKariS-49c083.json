db8ae-451d-40fd-93d0-69255428395f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2dd9689ba33a1fc45a392c1084422b50 3x"}, "body": "こんにちは！\n私のVTuber「アストラ・ラクセル（Astra Raksell）」のイラストをお願いしたいです。\n\n【利用用途】\n・個人利用\n・SNS（アイコン／投稿など）\n\n【キャラクター設定】\n・職業：銀河を旅する冒険者\n・性格：陽気で優しく、冒険心が旺盛で少し頑固\n・好物：チョコレートとコーヒー\n\n【特徴】\n・中性的な見た目のキャラクターです。\n・右腕は人間のような外見ですが、腕の周囲にプラズマのような煙が漂っています。\n・デザインは「通常モード」と「バトルモード」の2種類があります。お好きな方をお選びください。\n・利き手は左です。\n・使用武器の資料もフォルダ内にありますので、ご確認ください。\n\n【キャラクターのインスピレーション元】\n・『ロックマン』、『仮面ライダー』、『メトロイド』などの作品から影響を受けています。\n\n構図や表情は先生のセンスにお任せします。\nお時間ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1r2quPwf2jAiloE5zoBugxrCG4dRLKbuj?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@OkubaKariS/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3932281, "client_id": 1608326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/390b6edb/uploads/origins/f574f134-7c13-444a-a768-8137b4588aca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dd80eb66a4a0e440412b96865f36a10", "srcset": "https://si.imgix.net/390b6edb/uploads/origins/f574f134-7c13-444a-a768-8137b4588aca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0dd80eb66a4a0e440412b96865f36a10, https://si.imgix.net/390b6edb/uploads/origins/f574f134-7c13-444a-a768-8137b4588aca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=101b699b713f206554c57e04a8d8da53 2x, https://si.imgix.net/390b6edb/uploads/origins/f574f134-7c13-444a-a768-8137b4588aca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7522cd52f16029108eb27cf6bb2132c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/390b6edb/uploads/origins/f574f134-7c13-444a-a768-8137b4588aca?bg=%23fff&auto=format%2Ccompress&fm=