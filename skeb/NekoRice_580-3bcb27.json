fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b546e9381577eeb0622aa9d477443fdd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d7bea35/uploads/origins/e7ec1532-3b92-47fd-adae-27fe3caee9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5c41fe936d88167eb2fbc8f39187c4", "srcset": "https://si.imgix.net/8d7bea35/uploads/origins/e7ec1532-3b92-47fd-adae-27fe3caee9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5c41fe936d88167eb2fbc8f39187c4, https://si.imgix.net/8d7bea35/uploads/origins/e7ec1532-3b92-47fd-adae-27fe3caee9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9faf6690797d069d9d2f18ce8cf9257b 2x, https://si.imgix.net/8d7bea35/uploads/origins/e7ec1532-3b92-47fd-adae-27fe3caee9cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d849c7eaa4a4038ebf095cb4113eedd 3x"}, "body": "はじめまして。リクエスト送らせていただきました。\n内容が難しければキャンセルお願いします。\n\nリクエスト内容\n･キャラクター：私のオリキャラ『斗光千梨』\n立ち絵\nhttps://imgur.io/a/4Vdadul\n\n･キャラクターの特徴：\n飄々としていてちょっとクールな雰囲気、スレンダー体型ですが胸は少し大きめ(Eカップ程度)\n10代後半ぐらい\n身長160 cm程度\n\n･シチュエーションなど：\n友人に缶コーヒーを奢っている様子\n表情は上目遣いで「これ、いる？」と言っているような感じ\n服装は黒セーラー服かブレザー制服(Neko様がこのキャラに着せてみたいと思った方で大丈夫です)\nその他要素はおまかせします。\n\n納品はPSDデータで、サインや背景(有の場合)は各データごとに分けていただければ幸いです。\n\n使用用途：\nアイコンなど個人使用範囲内に限る\n\nご検討よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NekoRice_580/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2482191, "client_id": 2442213, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4238dd58/uploads/origins/e6e2def0-8e32-4dcc-becf-db645e4e0035?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d302357999a579687844f53a88505f86", "srcset": "https://si.imgix.net/4