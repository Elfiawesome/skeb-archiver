構いません。もし難しいようでしたらこちらの注文は無視していただいて結構です）\n\nシチュとしてはケロ子ちゃんのことを聞きつけたどこぞの悪の組織がサンプルに捕獲しようとして返り討ちに遭う。暇潰し程度にと考えていたケロ子ちゃんだが、ダメージを快感へと変換させる戦闘員の身体に興味を持つ。様々な技で襲ってきた戦闘員達を嬲り倒し、最後の一人はじわじわと締め上げて失神させる。どこからやって来たのか、そこに強い相手は居るのか――興味の沸いたケロ子ちゃんは、目の前の相手から優しく聞いてあげようと邪悪にほほ笑んだ……という感じです。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@torigoshicrow/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/83abe7fa/requests/43067_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63f5c24fdbc74b832f4a3faa43ac2d4a", "srcset": "https://si.imgix.net/83abe7fa/requests/43067_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63f5c24fdbc74b832f4a3faa43ac2d4a, https://si.imgix.net/83abe7fa/requests/43067_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7523fd1ce1cfb5dca3010992a1153504 2x, https://si.imgix.net/83abe7fa/requests/43067_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bfe1a68da47eb40f8544ca2b7e31b9c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 7727, "client_id": 11854, "nc": 161}, {"path": "/@torigoshicrow/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 7727, "client_id": 117069, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7b45d76/requests/40350_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6254b60dda0d2651562ee60290d02ef7", "srcset": "https://si.imgix.net/a7b45d76/requests/40350_0?bg=%23fff&auto=f