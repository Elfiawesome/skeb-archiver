.com%2Fprofile_images%2F2020856476366209024%2FOtTaWmLF.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c89fc4c47f75c61c66d26bd66da64ca3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020856476366209024%2FOtTaWmLF.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce75014e304ecee9c99528b53a87f905", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020856476366209024%2FOtTaWmLF.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce75014e304ecee9c99528b53a87f905, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020856476366209024%2FOtTaWmLF.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdef1dc548a96214b670a778184aae40 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2020856476366209024%2FOtTaWmLF.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fd46fce50394c1fc894b9e7f46b1403 3x"}, "body": "はじめまして \nいつも素晴らしい作品をありがとうございます\nリクエストを送らせていただきます\n\nアイドルマスターシンデレラガールズの\n主人公　　プロデューサー\nヒロイン　夢見りあむ\nの作品をお願いしたいのですが\n普段拝見させていただいてる作風とは違うテイストの作品をリクエストさせていただくことは可能ですか？\nセリフの前にキャラの名前を付けるセリフ主体の脚本形式の作品ではなく地の文主体の小説形式の作品をお願いしたいです\n\nそれと文字数指定なのですが45000字を希望とさせていただいてもよろしいですか？\nかなりわがままを言ってしまい申し訳ございません\n\nキャラ設定 は以下でお願いします\n\nプロデューサー \n彼女いない歴年齢\n年齢は22〜25歳の間(ストーリーに必要なければ描写しなくて大丈夫です)  \n一人称は「俺」で性格は特別奇をてらった感じじゃなければGaikotsu-mukuroさんの書きやすい様で大丈夫です\n\n以下の公式(ゲーム)で明言されてる設定でお願いします(ストーリーに必要なければ描写しなくて大丈夫です)  \n・ぴにゃこらたに雰囲気が似ている \n・きらりと同じくらい高身長 \n・目付きが悪い \n・イケメン  \n・事務所で唯一のプロデューサー\n\n夢見りあむ \n優秀な身内へのコンプレックスや孤独感から、見かけや態度に反してその内面は以外と自己肯定感低め \n態度には出ない諦めや将来の不安を抱えていたがプロデューサーにスカウトされ仲間や居場所ができ人生が一変する \n出会った時からなんだかんだで自分を肯定してくれて、炎上した時はいつも庇ってくれるプロデューサーに並々ならぬ恋心を抱いてしまう \nピンク髪が違和感ないほど顔面整っててスタイルえげつないのにフェラや顔ズリに抵抗ない \n服の上からですら信じられないぐらい触り心地の良い何万人に1人レベルのモチ肌巨乳 \n唇はぷるぷるで色白ピンク乳首でパイパン処女 \n男と手も繋いだことのないウブなねんねにもかかわらずSNSでは上から目線なシコった報告ばかり届く\nアイドルになってからは昔の知り合いのヤリモクDMも多い\n\n以下の公式(ゲーム)で明言されてる設定を前提でお願いします (ストーリーに必要なければ描写しなくて大丈夫です)  \n・地下アイドルのＬＩＶＥでＰと出会い、アイドルに関する持論を展開した事がきっかけでスカウトされた  \n・通っていたのは看護学校？  \n(デレマスでは中退したかのように取れるセリフがありますがデレステの方では辞めている描写はないためどちらの設定かはお任せします)\n・メンヘラというわけではないとの事 \n・ 「ぼっち」らしく、人付き合いが苦手  \n・ＳＮＳをやっている  \n・Pに雑に扱われるのも嫌いじゃない？(デコピンされたり)  \n・Ｐは暖かく迎えてくれるタイプではなく、またはなからりあむを普通にプロデュースするつもりはない模様  \n・髪は（当然）地毛ではなく染めている  \n・バストサイズは９５  \n・運動は得意ではなく、またレッスンに対するやる気はあまりなく勉強もダメダメ  \n・失敗する自分の姿に耐えられないため、挑戦することが苦手  \n・オタクは信用できない模様  \n・炎上商法に積極的  \n・アイドルになってすぐブレイクし大舞台に立たされている\n・渡米した画家の姉がおり、彼女も「レアネーム」らしい。\n・また両親は海外で仕事をしているため、実家(都内のマンション)で一人暮らしをしている  ・幼い頃は友人がいたが今は顔を完全に忘れており、連絡先も全消去している  \n\n要望 \n・視点はプロデューサーの一人称視点で無理な所はりあむ視点で構いません \n・地名を出す場合はS市とかT区みたいな架空の地名でなく渋谷区とか八王子とか実際の地名でお願いしたいです\n・擬音はなしでお願いします \n・セリフの時は一行開けてもらえると助かります\n・タイトルは短めで説明系はなしでお願いします\n\nストーリーの流れ \n昔から女としてのスペックは飛び抜けているにもかかわらず醸し出す雰囲気や本人の言動のせいか「りあむなら良いだろう」と雑に扱われることが多く\n↓\nアイドルになってもそれは変わらず共演者や裏方やファンに雑に弄られて、そのくせ「女」としては見てきて消費してく毎日\n↓\n2人の時はいじってくるくせに(りあむ的には嫌じゃない)、「そういう時」は必ず行き過ぎないように間に入って庇ってくれたりフォローしてくれるプロデューサーとの日々が1番の支えで\n↓\nある日の仕事終わりの車での送り迎え中“堕ち“気味のりあむに「そういう時」は必ず優しくするプロデューサー\n↓\n普段からは想像も出来ないプロデューサーにしか見せない泣きも入りながらのりあむの止まらい言葉を受け止める\n↓\nしかし何気なく言った「りあむのこと理解してくれる男がいつか現れる」的な言葉が許せなかったようで取り乱すりあむ\n↓\n「プロデューサーとアイドルの話し合い」から「男と女のソレ」にいつからか変わってることに動揺するプロデューサー\n↓\n自分をどう思っているか？問われ驚くほど整った顔立ちや溢れる涙の綺麗さに息をすることも忘れ見入ってしまい唇を奪ってしまう\n↓\nプルプルの唇の感触はそれまで耐えていたプロデューサーの理性を崩すには充分で\n↓\n気付けばラブホテルのベッドで横並びに座る2人、さっきまでと打って変わってシミ一つない透き通る様な色白な肌を赤く染め縮こむりあむ\n\n\n以降の性描写に関してなのですが\n・胸責め描写多めで後ろから着衣越しに執拗に責めて胸でイカせる描写と複数の乳首イキ描写があると嬉しいです \n・フェラやパイズリや顔ズリを入れてもらえると嬉しいです\n・避妊は(ゴム)無しの基本中出し\n・朝まで性行為は続く\n・Mっ気の強いりあむを男性優位でイカせまくる感じでお願いします \n・♡マークはなしでお願いします\n・設定口調な喘ぎはなしでお願いします \n\n\n\nここからは沼っていく二人を性描写たっぷりで書いていただけるとありがたいですが文字数的に無理そうだったら無しで大丈夫です\n\n「彼女がフェラしてくれない」\n「AVじゃあるまいし実際にしてくれる女なんてまずいない」\n「パイズリなんてサイズ的に無理」\n「一度でいいから生でしてみてー」\nなどの業界関係者との猥談を回想し自分が男としてどれだけの幸運に見舞われてるか考えながらのりあむとの情事に溺れるプロデューサー\n↓\nあれからも関係は続いており頼めば何でもやってくれるりあむに男として至上の快楽にふけ、\n一緒に沼っていく二人  \n\n完\n\n\n熱が入ってしまい長文失礼致しました\nまた注文が多くかなり我儘を言ってしまい申し訳ございません\nリクエスト受けていただけると幸いです\nご検討よろしくお願いします", "nc": 41, "word_count": 43464, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 14364, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "瑠璃蛇　スケブあるよ〜", "screen_name": "rurihebi", "avatar_url": "https://pbs.twimg.com/profile_images/1229499913039302656/WcD5RZGW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/926499547345387520/1639438247/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 211810, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Ψ(プサイ)", "screen_name": "psi_petro", "avatar_url": "https://pbs.twimg.com/profile_images/916509231326445569/mLiJXOJK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/754811865633402880/1496339169/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_ex