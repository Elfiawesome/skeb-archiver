_genre": true}, {"path": "/@kohsuke_krsk/works/131", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/279e543d/uploads/origins/03e62491-4f15-48d4-8c96-ac7f37f20990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3250207dc3faddc163f2560276e5ac3e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 236819, "client_id": 412126, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kohsuke_krsk/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 236819, "client_id": 40712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f5e739a/uploads/origins/df7055b9-f7a9-4c52-8780-c8a0dda7ba7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37ecb2ea2de0566177e1ce29a187418", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f5e739a/uploads/origins/df7055b9-f7a9-4c52-8780-c8a0dda7ba7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2a2cd4a15082afec726838e7ad6b2fa", "src_set": ""}, "body": "また崩壊学園のフェミリス (小悪魔ver) のハードでビッチな拘束セックスをお願いできないでしょうか？   \n\n▪️キャラ参考資料\nhttps://drive.google.com/drive/folders/10BC306gOI-4NOMr2VREv-WWrgEr1Gblf\n・瞳孔は白い小さなハート \n•足は比較的長めで美脚\n・靴は履いたままで上記の底が赤色の黒ハイヒール。ヒールかなり高くし、靴の割には結構描きこむ感じ  \n\n▪️シチュ  \n前回のハードに拘束されてノリノリで立ちバックのセックスを主人公が目撃の続きのイメージで、再びペニスギャグも戻され立ちバックで突かれながら首輪を引っ張られてのけ反っているところ\n・首にリード付きの首輪、腕にアームバインダー、足枷、以下のようなペニスギャグ。\nhttps://drive.google.com/drive/folders/10IlQE9iH93OtvDB2TMAoIyY5EmKh4jAB\n•フェミリスはカメラ目線とカメラ目線ではない差分 \n•上記ペニスギャグは装着、半分挿入、未装着の3つの差分\n•ロリなため竿役との体格差大きめ \n•竿役は片手で首輪のリードを持ちもう一方の片手でフェミリスの小さな腰か腕を鷲掴みにし激しく突いている \n・パンパンなど激しそうな効果音や喘ぎ声  \n\n▪️構図  \n・ハイヒール全体(特にヒール部分)までがはっきり見える  \n•挿入された竿が僅かに見える  \n\n▪️台詞\n以下のようなマゾビッチな台詞をお願いします。\n竿役「おらっ、首輪引っ張ると膣内締まるわw」\nフェミリス「んぐ！ん、んぐぅ！」\n主人公「う、嘘だ、こんな可愛いくて幼いフェミリスがエグい拘束セックスで喜ぶなんて」\n竿役「えwフェミリスちゃんはマゾビッチでしょ？」\nフェミリス「んぐぉ！んぐ、んー！、んんー！」\n主人公「ほ、ほらペニスギャグ半分抜けたけどこんな苦しげに、拘束具ギチギチ、ハイヒールをカツカツ鳴らして...」\nフェミリス「ぷはっいい加減覚えろですwハイヒール興奮するからですよ」\nフェミリス「フェミリスは子供なのに性的なハイヒールにエグい拘束具付けて〜」、「色んな男達のチンポで喘ぐのが大好きな非•処•女です♡」\n主人公「そ、そんな」\n竿役「フェミリスちゃんマジ最低w」\nフェミリス「くく、可哀想ですw」", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohsuke_krsk/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 236819, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1542a5a1/uploads/origins/79ed7b1a-084a-454d-9206-d6b6b034bd83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ad1a47920648d75bc955ca2c693a16b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1542a5a1/uploads/origins/79ed7b1a-084a-454d-9206-d6b6b034bd83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8682ceac381ac09912c1504b35b8f21d", "src_set": ""}, "body": "こんばんは、ブルーアーカイブから宇沢レイサと鬼怒川カスミの絵をリクエストしてもよろしいでしょうか。\n\nこれらのキャラクターは両方とも、原木のテラステーブルオブジェクトを使用して、ゲームのカフェエリアに特別なアニメーションがあります。\n両方が同時にテーブルを使用しているイラストが欲しいです。\n\nレイサはいつもの姿勢で、片足をテーブルに乗せて仰向けになって寝ています。彼女は深い眠りに落ちています。\nレイサのお腹の上に座っているカスミ。彼女は目の前のテーブル、一部がレイサの脚の下にある地図に完全に集中しています。\nこの特定のシーンでは、カスミは赤いマーカーで地図上のエリアを一周しています。彼女が特定の場所にたどり着くためには、レイサの足を持ち上げてそこに到達する必要があります。\n\nカスミは嬉しそうに地図に印をつけ、レイサの足を持ち上げ、レイサの下着を少しだけ覗かせています。レイサは眠ったままです。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohsuke_krsk/works/128", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6f51bdfb/uploads/origins/1d833274-b3d5-4c86-8510-19cbd4451366?bg=%23fff&auto=fo