t_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e832021/uploads/origins/704287c9-840b-4700-99d9-306041ef8ded?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6766c6ab5a6ed9aa909ecc2e3d340ce0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e832021/uploads/origins/704287c9-840b-4700-99d9-306041ef8ded?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=652f19519f4fc342c43baf5e7e6f3520", "src_set": ""}, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n一枚（又は複数枚）でまとめて頂くか、一枚づつかはご負担が少ない方で(同じなら一枚づつ)お願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohsuke_krsk/works/138", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 236819, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2248827b/uploads/origins/61e1128b-745f-4896-9315-f716c7c9f6fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76d4383b671b62392baae4c6b19c6474", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2248827b/uploads/origins/61e1128b-745f-4896-9315-f716c7c9f6fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb449a0f18313578472c2f4927de849", "src_set": ""}, "body": "前回はとてもエロかわなユカリをありがとうございました。\n引き続きマニアックなリクエストになりますが、気が向かれましたらお願いいたします。\nまた、予算少額のためラフ仕上げなどご負担にならない範囲でお願いいたします。\n\n\nキャラ：サキ（ブルーアーカイブ）\n\n服装：制服姿で、ご都合に合わせて脱がしたり省略してください\nhttps://bluearchive.wikiru.jp/?%E3%82%B5%E3%82%AD\n\nシチュ：ラブラブアナルセックスしているイラストをお願いいたします。\n\n　　　　体位と構図は結合部が大きく見えるものを希望でそれ以外はお任せいたします。\n　　　　気持ちよさそうな表情を希望です。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohsuke_krsk/works/137", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2a2fb43b/uploads/origins/dd0fde81-fc8a-439d-bc3f-5d6944730bdf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e061f2e6639460d13c35d1518438a8cf", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 236819, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kohsuke_krsk/works/136", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 236819, "client_id": 2652985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcce6444/uploads/origins/cd31713e-7513-4ce8-b05e-6ce79c70ab66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec29978ee1d067b813aa58501df04f5c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcce6444/uploads/origins/cd31713e-7513-4ce8-b05e-6ce79c70ab66?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32447d3349c2f7f15f9532045697a2cc", "src_set": ""}, "body": "うちの子(代理＆くろむ＆りあら)のイラストをお願いしたいです。\nプロフィールやキャラクターデザインについては資料URLを参照願います。\n〇シチュエーション\n　あまりに暑いので三人でビアガーデンに行っている様子。\n　りあらはビールが苦手なので甘めのカクテルとか飲んでます。\n〇うちの子について\n　衣装は下記夏服設定にてお願いします。\n　https://uchinokoskey.com/notes/a9pyn54wkkgk002s\n　その他細かな点についてはおまかせします。\n〇その他参考\n　資料URLはキャラクター紹介となっています(プロフィール等も記載しています)。\n　キャラクターデザイン依頼の納品イラストのURLも記載していますので、併せて参照いただければと。\n　(描き手の数だけ解釈があるという認識ですので、自由にやっていただけたらと思います)。\n\nhttps://uchinokoskey.com/@reima/pages/1739670206034", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kohsuke_krsk/works/135", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8583cde7/uploads/origins/6cc439af-93ba-4db2-9b4a-dc4263b049a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=596f76e281d6d524568c0e49de5c4571", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 236819, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kohsuke_krsk/works/134", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 236819, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc81e0be/uploads/origins/02d2388e-4b1f-4e57-973e-593b1c70f255?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=473771abb20efa80b829521a88b819be", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc81e0be/uploads/origins/02d2388e-4b1f-4e57-973e-593b1c70f255?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e76e7028fe998fde62c02e65171fc448", "src_set": ""}, "body": "こんにちは、ブルーアーカイブシリーズのアラタ、箭吹シュロ、勇美カエデのイラストが欲しいです。\n\nカエデはアラタとシュロに彼女のお気に入りのムシクイーンカードゲームについて教えています。\n右側にカエデ、中央にシュロ、左側にアラタが座っています。\n彼らは皆、ムシクイーンのカードを持っています。\n\nカエデは身を乗り出してカードを見せています。彼女は彼らにゲームについて教えることをとても喜んでいます。\nアラタはカエデのカードを見て右に傾いています。彼女はゲームについて学ぶことに非常に熱心です。\nシュロはカエデとアラタの巨乳に挟まれています。胸の嫉妬は彼女を信じられないほどイライラさせます。", "nc": 152, "word_count": 0, "transcoder": "image",