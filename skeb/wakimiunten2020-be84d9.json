uploads/origins/722b2fd2-aa54-4b57-acb5-212829006947?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb13ca0f724c590599c94f30a6aaa64a 3x"}, "body": "はじめまして。リクエストさせて頂きます。\n\nキャラクターはアイドルマスターの水瀬伊織。\n\nジャンルは巨大娘になります。\n\nシチュエーションはこんな感じの物を見たいです。\n巨大化した全裸の伊織は汗をかきながら、手のひらサイズのロープウェイのゴンドラを側面から自分の股間に押し付けて楽しそうにオナニーしている。\nゴンドラの中は伊織の愛液や陰毛でめちゃくちゃになっている。\n\n陰毛は全く処理されていない、とても濃い感じでお願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wakimiunten2020/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0f4a04b0/uploads/origins/d1fc4263-545a-49d4-b602-fa6fd2e6793d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d446c298ff15cfb0f9834d22d0aa0a83", "srcset": "https://si.imgix.net/0f4a04b0/uploads/origins/d1fc4263-545a-49d4-b602-fa6fd2e6793d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d446c298ff15cfb0f9834d22d0aa0a83, https://si.imgix.net/0f4a04b0/uploads/origins/d1fc4263-545a-49d4-b602-fa6fd2e6793d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdc6f3b7294520eb5e0263927f61cff9 2x, https://si.imgix.net/0f4a04b0/uploads/origins/d1fc4263-545a-49d4-b602-fa6fd2e6793d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6188f2c93453f32ea438aac8fc6666b1 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 367279, "nc": 160}, {"path": "/@wakimiunten2020/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 367279, "vtt_url": null,