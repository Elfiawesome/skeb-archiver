berの栞月つみきちゃんと琥珀ねねちゃんがお料理しているイラストを描いていただきたいです\n\nつみきちゃんはみそ汁を作っている\nねねちゃんはおにぎりを握っている\n\n西本様が思い浮かぶ私服姿(スカートまたはワンピース)にエプロンをつけてポニテまたはショートヘアーでお願いします\n\nつみきちゃんはくまぞくが描かれたエプロン\nねねちゃんは仔ヒョウちゃんが描かれたエプロンでお願いします\n\n使用用途\n栞月つみきちゃん、琥珀ねねちゃんそれぞれの活動での使用(Twitterでの宣伝やYouTubeなどのサムネなどでの使用等)許可をお願いします\nサムネなどにも使うように背景と各々の人物が分けられたPSDまたはPNGで納品いただけると嬉しいです\n\n\n栞月つみきちゃん ①https://lit.link/shidukitumiki\n\n②https://www.fanbox.cc/@siduki-tumiki/posts/2467176\n\nくまぞく 黄色のマスコットです\nhttps://twitter.com/siduki_tumiki/status/1397909821853081602?t=EEvvkME6tS-K3qKglwv-7g&s=19\n\n琥珀ねねちゃん\n①https://lit.link/kohakunene\n②https://kohakunene.fanbox.cc/posts/3534608", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Love_PureGummy/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 600007, "client_id": 2612848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/414d8929/uploads/origins/8b0c409e-12cd-4f4d-9806-a2abdcc27615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ba8af1192eb19470c30b72b383207e0", "srcset": "https://si.imgix.net/414d8929/uploads/origins/8b0c409e-12cd-4f4d-9806-a2abdcc27615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ba8af1192eb19470c30b72b383207e0, https://si.imgix.net/414d8929/uploads/origins/8b0c409e-12cd-4f4d-9806-a2abdcc27615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bd7bb1cdb6f164c88500f5e019d7c01 2x, https://si.imgix.net/414d8929/uploads/origins/8b0c409e-12cd-4f4d-9806-a2abdcc27615?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f2c24606cd1e502c438361282c8b913 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/414d8929/uploads/origins/8b0c409e-12cd-4f4d-9806-a2abdcc27615?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc6cf1070