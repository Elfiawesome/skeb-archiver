b-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc92aaf63ece9653efdea27f193728b", "srcset": "https://si.imgix.net/123c95a8/uploads/origins/b01f0b98-5433-44ab-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5cc92aaf63ece9653efdea27f193728b, https://si.imgix.net/123c95a8/uploads/origins/b01f0b98-5433-44ab-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27c5983abd11bcb7cfc6ae8c8c799271 2x, https://si.imgix.net/123c95a8/uploads/origins/b01f0b98-5433-44ab-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d8f980258ddccb55212c926d285b00a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/123c95a8/uploads/origins/b01f0b98-5433-44ab-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a046ff0138c6176528743df5466e6d7b", "srcset": "https://si.imgix.net/123c95a8/uploads/origins/b01f0b98-5433-44ab-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a046ff0138c6176528743df5466e6d7b, https://si.imgix.net/123c95a8/uploads/origins/b01f0b98-5433-44ab-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10ba6023af1e764c13367f5afb133f15 2x, https://si.imgix.net/123c95a8/uploads/origins/b01f0b98-5433-44ab-aa9c-836a61687342?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecec32d3fe82a13a6ecdd6e245ec8865 3x"}, "body": "Xであなたの絵を拝見しまして、あたたかいタッチでとても素敵だと思いました。パンケーキのくまちゃんや黒猫ちゃんとおばけのランプちゃんの絵がとても好きです。\n今回はうちのねこを描いていただけないかと思いリクエストしました。受けていただけるととても嬉しいです。真四角のキャンバスに印刷して飾れたら素敵だなと思っております。\n\n(以下は参考にしていただきたくねこの特徴を挙げたかったのですが、親バカの語りになってしまいました。申し訳ありません。)\nこの子はラグドールの女の子です。見た目は気品があって美しいと言われるようなタイプだと思っており、我が家ではお姫様のようにかわいがられています。\n運動は苦手でどんくさいところがあり、よく寝返りをうった拍子にソファから落ちています。飼い主にはツンツンしていますが、人間をうまく使ってブラッシングやマッサージをさせるのが得意な子です。\n目はアイスブルー、肉球はピンク色です。前脚に白の靴下をはいています。さわり心地はかなりふわふわとしていて、わたあめか雲のようです。走ってくるときにポンポンと跳ねるようにふわふわする様子がかわいいです。体重が7キロあるので猫にしてはかなり大きめだと思います。\nリンク先に参考となりそうな写真や動画があります。\n\n小物や構図などはお任せしたく思います。かわいらしい感じにしていただけたら嬉しいです。\nなにとぞご検討よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/nyi3iebeh5f7l1w2ybza1/AJNauE67X2zpXmipVWVHRGI?rlkey=7usvsqebc7lohn1vwztt8iwjp&dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@komaoki_illust/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3028368, "client_id": 193145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7737caed27b492a891224fd353527d33", "srcset": "https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7737caed27b492a891224fd353527d33, https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=448e77ec4e50f06344bbde559d41663e 2x, https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e4b7179e29f938d91494237f0b80506 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e583f55e201eee3ca5c66080e2f480d", "srcset": "https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e583f55e201eee3ca5c66080e2f480d, https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5ef0af01e68e851c8d3e28cd4973936 2x, https://si.imgix.net/c21364a2/uploads/origins/6f69c63c-24ef-4f51-82f1-ec3a062ec0ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bc2028b7d7bf49c4075056fce67a4816 3x"}, "body": "はじめまして。素敵なイラストですね！リクエストに応えていただけると嬉しいです。\n\n下記リンクをご確認ください。👇\n\nキャラクターA。14歳。ハンター。アーチェリーが得意。眉毛が濃い。肌の色に注意してください。帽子をかぶる必要はない。真面目な大人に成長したが、若い頃は生意気で自信家。\n\nキャラクターB 170cm猫耳。まつげが長い。しっぽなし。優しい人。笑顔が好き。画像B04のドレスを着用。髪の毛は肩の高さにしてください。ほとんどの場合、目は閉じている。\n\nキャラAとキャラBはお互いを家族のように思っている。\n\n二人は隔離された場所に住んでいる。そこは不思議な場所だが、危険が潜んでいる...。\n\nキャラAがキャラBに、自分が手に入れたさまざまな奇妙な果物を見せているようなシナリオが欲しい。あるいは、チャラBが心配そうな顔をしている間に、チャラAが羊に奇妙な食べ物を与えようとしていてもいい。\n\n背景は奇妙な要素で作ってください。\n\n詳細はお任せします。問題があれば遠慮なく断ってください。金額が足りない場合は再送をお願いします。ありがとうございました！\n\nhttps://www.dropbox.com/sh/tu8kcuhnw9adb0o/AABGbO3UPnXzEBz1UzoeFzT9a?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 959556, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "栴香", "screen_name": "senkatea3", "avatar_url": "https://pbs.twimg.com/profile_images/1667123540708200450/jH3S6_HU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/886625446434975744/1773926330/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1209903, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さえき", "screen_name": "hill_yoll", "avatar_url": "https://pbs.twimg.com/profile_images/2048821674838249472/itZcNpGG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1205813486128730112/1718105560/1500x500