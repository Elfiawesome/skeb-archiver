作権も田村部さんが保有。\n\n以上となります。どうかよろしくお願いいたします。\n\nhttps://sites.google.com/view/prof-tutuji/", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tamurabeson/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 263, "client_id": 29975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b70205b38dc7b208351b301ea315061", "srcset": "https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b70205b38dc7b208351b301ea315061, https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=716f7c025ed8240e59ba94c5cd5cb706 2x, https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58d7661974f0cab7f19596219d2fe444 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e26a90f07c4adb826d51d6e6054d8574", "srcset": "https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e26a90f07c4adb826d51d6e6054d8574, https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6cd65b60177c8ba55739dd6ba8ba4778 2x, https://si.imgix.net/342fd9eb/uploads/origins/554700a5-b4b6-4878-881c-b74a2a10fc0b?bg=%23fff&auto=format%2C