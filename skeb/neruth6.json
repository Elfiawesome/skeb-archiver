count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neruth6/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2660962, "client_id": 2330398, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66a8b72f/uploads/origins/66f51394-59b0-4028-944b-06e131a97693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5ca9c54ec444cb0874668cb5daf8b68", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66a8b72f/uploads/origins/66f51394-59b0-4028-944b-06e131a97693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95e5b800d968b30bdca2a929e8f6ff9c", "src_set": ""}, "body": "シリーズ\nランスシリーズ\n\n\nキャラクター\nパステル・カラー\nhttps://i.imgur.com/OvLh69c.png\n\n\nポーズ\n- こんな風に自分を隠そうとしている（参考：https://www.pixiv.net/artworks/119104983）。\n\n\n衣装\n- レースクイーン（参考：https://www.pixiv.net/artworks/104825773）。\n\n- 衣装のロゴを「TEAM RANCE」に変更してください。\n\n\n注意事項\n- 衣装の色やキャラクターのポーズは自由に調整してください。参考資料と全く同じである必要はありません。\n\n- その他はお任せします。\n\n\nありがとう！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neruth6/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2660962, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3473f0b/uploads/origins/f9f26e8b-4bd2-4286-8177-b902c5d466ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=188220a0b4a27a2c4f11a9bba04d49b3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3473f0b/uploads/origins/f9f26e8b-4bd2-4286-8177-b902c5d466ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8aa95dd809a7596167242aa740f58d92", "src_set": ""}, "body": "お疲れ様です！\n\nクレイ(nikke)のチアガール衣装を着たアネット(ルーンファクトリー)を描いて欲しいです\n\nメインで困った笑顔でI字バランスしているもの、驚いている表情でむっちりとした大きな尻がよく見える構図のものと、赤面してジト目で文句を言いつつ見下ろして蹲踞ポーズでポンポンをフリフリして応援してくれてる感じのものを併せてお願いしたいです。(雑ですが『こんな感じだといいな…』みたいな簡単な構図イメージを付けたので、それとなく参考にして頂けると幸いです)\n\nアネットさんの体型はいつものように非常にグラマーな体型を希望。\n\n服装はクレイのチアガール衣装ですが、サンバイザーの部分をアネットさんの本来の帽子のゴーグル帽子ver.を差分で欲しいです。スカートの下は薄黄緑色のアンスコか縞パンで。\n\n激しく動いいたので暑くて顔が赤く、汗をかいている感じ。淡くムワッとした湯気っぽいものも付けて欲しいです。\n\nまた、シーンを重なって隠れている部分を見れるように単品で見られるようにして欲しいです。\n\nクレイ資料…https://dic.pixiv.net/a/クレイ%28勝利の女神%3ANIKKE%29\n\n構図イメージ…https://drive.google.com/file/d/1d-crhT2m6zgI6kcAo1yw4AmEGfI9bNSl/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neruth6/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4d5e3fd8/uploads/origins/eb4cb8f9-c78b-4b65-87b6-6d31b7e17c2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=271f30e35f7d01204e7f8c1a359053b9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2660962, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@neruth6/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2660962, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6968935/uploads/origins/0223d0b4-1d0d-4d58-8d07-a765d7cd346d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efa72df61eef73b17fbcc24607753601", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6968935/uploads/origins/0223d0b4-1d0d-4d58-8d07-a765d7cd346d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d186e4b8fc4ae6389e58c134d88df59c", "src_set": ""}, "body": "お疲れ様です。前回の依頼のイラスト本当にありがとうございました！壁紙につかってます！\n\n今回はこの前のコハクとルーナのイラストがとても好みで、有償依頼で見てみたいと思いました。幼いキャラを自分好みのグラマーな体型に盛ってくれる所がすごく嬉しいですね…。今回もよろしくお願いします！\n\nルーンファクトリー 4より、コハクとルーナの母娘の2人を描いて欲しいです。\n\n前回の依頼のように、キャラ一人ずつ見れるようにしてもらえると嬉しいです。\n\n参考資料[ https://drive.google.com/file/d/1jGT5k5mhSfYlBC9J1_acpkHmVFsK1Qbh/view?usp=drivesdk ]のように横長の構図で、二人並んで座って誘惑している感じでお願いします。ポーズは変えても問題ないですが、身体が重ならず密着しない程度に寄り添う感じで、脇が見えて欲しいです。また、太い太腿が大好きなので、意識して頂けると嬉しいです。\n特に身体や腕が見切れないように引いた構図にして欲しいです。\n\n前に書いてもらった母娘2人が仮装しているイラストの時と同じような、スタイル抜群な体型でお願いします。2人とも頭装飾はつけたままで。\n\n表情は普段の表情と、ニヤニヤしている表情と、なんだか恥ずかしくなって目を逸らして赤面している感じの3つをお願いします。全体的にコハクは積極的な感じで、ルーナは少し恥じらっている感じでお願いします。\n\n服装は通常衣装、水着の2つをお願いします。可能なら体操服ブルマ姿もお願いしたいです。\n\nコハク水着[ https://drive.google.com/file/d/1PZhUVDMPIXXJC-YPypIslAAnd1rbtcAQ/view?usp=drivesdk ]\nルーナ水着[ https://drive.google.com/file/d/15nZpU31TwtJHpsFabF5Yzx2o-165nhhU/view?usp=drivesdk ]\n(自分で描いたせいで細部が雑なので、自由に補完して貰えると助かります)\n\nブルマはFateシリーズのネロのブルマみたいなデザインで、コハクは紫、ルーナはピンク色でお願いします\n\n今回も詰め込んでしまいましたが、よろしければお願いします！", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@neruth6/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2660962, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/158404e6/uploads/origins/f81a033a-04dd-412a-8554-ed63e2198a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61cbfca0d155f3333cb69aa695f52136", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/158404e6/uploads/origins/f81a033a-04dd-412a-8554-ed63e2198a62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f138feaadeefe2136616df99225a6b26", "src_set": ""}, "body": "こんにちは、\n絵の依頼をしたいのですが。\n絵はルーンファクトリー4のヴェントゥスウィルの大人バージョンの人間の姿を依頼できますか？\nその他の詳細はお任せします。\nありがとうございます。\n\nヴェントゥスウィル（セルザウィード）\nhttps://cdn.imgchest.com/files/k46acgel6a7.png", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 539632, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "なっつん@Skeb募集中", "screen_name": "nattsun018", "avatar_url": "https://pbs.twimg.com/profile_images/1938207829716045826/DcdBbqXA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/845596077424205824/1705212711/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 1032981, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "74", "screen_name": "gx9THqXoF369Eys", "avatar_url": "https://pbs.twimg.com/profile_images/1455138588904288256/pWYZ8VhD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1270277342187753473/1635748730/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 49}, {"id": 1225677, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "木野わかな", "screen_name": "kinowakana", "avatar_url": "https://pbs.twimg.com/profile_images/1822148781384646656/SBeNEAlx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1345013163897438208/1725006763/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1757794, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "みかみまこと mikami makoto@Illustrat