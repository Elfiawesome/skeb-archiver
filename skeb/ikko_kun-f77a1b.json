・我慢の限界でトイレや服を脱ぐ余裕がなく、効率を考え股の部分だけずらして立ちション\n上記のようなシーン（ラッキースケベ）を先生に見られ、流石のトキも感情が顔に出て恥ずかしくなってしまってる\n（できれば乳首は陥没気味にしていただけますと嬉しいです）\n\nその他細かい部分はお任せいたします\nご検討のほどよろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ikko_kun/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2746947, "client_id": 513888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73e8e8ca/uploads/origins/bdd082ad-9e8a-4d95-abf9-6c202859953a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bd13d5fba5225cf34c326c8f37146bd", "srcset": "https://si.imgix.net/73e8e8ca/uploads/origins/bdd082ad-9e8a-4d95-abf9-6c202859953a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8bd13d5fba5225cf34c326c8f37146bd, https://si.imgix.net/73e8e8ca/uploads/origins/bdd082ad-9e8a-4d95-abf9-6c202859953a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb3476c855f485126b45b1e97a7ab194 2x, https://si.imgix.net/73e8e8ca/uploads/origins/bdd082ad-9e8a-4d95-abf9-6c202859953a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d566238278cc212990c9a421e5d4e72 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73e8e8ca/uploads/origins/bdd082ad-9e8a-4d95-abf9-6c202859953a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b48c60eacb5087940a5df5fdfd8b847a", "srcset": "https://si.imgix.net/73e8e8ca/uploads/origins/bdd082ad-9e8a-4d95-abf9-6c202859953a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b48c60eacb5087940a5df5fdfd8b847a, https://si.imgix.net/73e8e8ca/uploads/origins/bdd082ad-9e8a-4d95-abf9-6c202859953a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6caba40d1e983d2bc4242708df27b3a4 2x, https://si.imgix.net/7