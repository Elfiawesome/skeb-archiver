770c-7abe-4eb9-85c4-30b912d38d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0681bd009fbaeab5c553e3d3caebbfac 3x"}, "body": "初めまして、雨十里/照宮さん。\nFGOでご依頼を掛けられそうな方を探してた所、雨十里/照宮さんの過去絵でもFGOをお出しされているのを確認させて頂きました。\nもしろよろしければFGOから、「清少納言ちゃん」に「セミラミスの最終再臨の衣装をコスプレ」をさせたイラストをお願いできるでしょうか……！？\n\n個人的にハマってしまった謎の組み合わせのため、ご理解に苦しむ組み合わせとは百も承知ですが、FGOに精通しているご様子であったこと、またイラストの描き味が綺麗＆カッコイイ感じで装飾もしっかり描き出しながら、躍動感や感情を迸らせる画力に期待させて頂き、元気いっぱいなぎこちゃんのゴージャスなドレス姿を描いて頂けましたらと思い、ご依頼させて頂ければと思った次第です……！\n\nコスプレがメインとなりますので、なるべくならの範疇で十分ですが、全身が収まるような構図にて、衣装姿をご堪能させて頂けましたら非常にありがたいです。それ以外の表情や構図・ポーズなどについては、ご自身のセンスをそのまま光らせて頂ければOKです。\nまた、清少納言ちゃんの髪は第一再臨のもの（青・赤・黒のマーブルのやつ）を希望いたしますが、もっとセンスを光らせる直感が下りてくださったのなら、その限りではなくてもOKです。\n\n細かいディティールにつきましては、フィギュアの写真にてご確認いただければと存じます。\nhttps://www.goodsmile.info/ja/product/10713/%E3%82%A2%E3%82%B5%E3%82%B7%E3%83%B3+%E3%82%BB%E3%83%9F%E3%83%A9%E3%83%9F%E3%82%B9.html\n\n色んな意味で相当難易度が高いお題とは存じますが、それでもよろしければ、お手を振るって頂けましたら幸いです！　何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/88419852", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1506724, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うぇ", "screen_name": "qsefthukaxdvgnj", "avatar_url": "https://pbs.twimg.com/profile_images/1504425092255674373/fDuT6xrj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1317812798055854080/1647517607/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 0}, {"id": 1778068, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ほしのるり", "screen_name": "ruriMAringo", "avatar_url": "https://pbs.twimg.com/profile_images/1704041280249249793/prWHsCZ_.jpg", "header_url": "https: