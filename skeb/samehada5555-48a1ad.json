ンツ/ブーツをそれぞれ個別でレイヤー分けして表示非表示の切り替え可能で、首から下を丸裸にする事も出来る仕様。\n特にパンツは「通常のパンツ/汗でじっとり湿ったパンツ/汗＋愛液で完全に濡れ透けているパンツ」など状態違いもあり。\n\n表情差分も、瞳は左右それぞれ個別で「パッチリ開けた瞳/半分開けた瞳/にっこり閉じた瞳」などの種類あり。(例えば片目だけ瞑らせてウインクさせる事も可能)\nその他にも「通常の眉/八の字型に垂れた眉」「▽型に開けた口/にっこり閉じた口/キス顔の口/笑いながら小さな舌をペロッと出した口」「頬染めあり/無し」「全身の汗ばみ有り/無し」「縦スジから溢れ出る愛液あり/無し」「熱気で周囲にムワッと立ち込める湯気あり/無し」等々、それぞれ自由な組み合わせで切り替え可能。\n\nもし可能であれば完成した後の作品は自分以外にも広く公開して頂ければ嬉しく思います。\n長く細かい依頼になってしまいますが出来れば宜しくお願い致します。\n\nhttps://www.youtube.com/watch?v=uaue5m0UWWI", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@samehada5555/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 58091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c9df4e8/requests/107654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d18590eef55eec59969cf9741196a2", "srcset": "https://si.imgix.net/6c9df4e8/requests/107654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d18590eef55eec59969cf9741196a2, https://si.imgix.net/6c9df4e8/requests/107654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa1a25a6dfe512f679d1eaa944f2eef7 2x, https://si.imgix.net/6c9df4e8/requests/107654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=686a57fd62753b538da0af415fd2bffb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c9df4e8/requests/107654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81d372891b26544add962d1e7add8b6d", "srcset": "https://si.imgix.net/6c9df4e8/requests/107654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81d372891b26544add962d1e7add8b6d, https://si.imgix.net/6c9df4e8/requests/107654_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69b4cc3839a2cf920204d