るときに拡大するので、拡大しても粗くならないサイズが希望です。また、頭や耳、手など人物が見切れないように描いていただけると助かります。\n\n▶︎参考画像、YoutubeCH\nhttps://drive.google.com/drive/folders/1f_lukt44ChhR4FdEl9Olfx272k2VFodz?usp=sharing\nhttps://www.youtube.com/@Inanari\n\n▶︎希望の納品形式について\n・PSD\n・背景、人物等々はレイヤー分けいただけると幸いです。\n\nhttps://drive.google.com/drive/folders/1f_lukt44ChhR4FdEl9Olfx272k2VFodz?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 577024, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かもね❕ﾃｨｱく46b", "screen_name": "kamonekm", "avatar_url": "https://pbs.twimg.com/profile_images/1638900358935384064/OnOtXAaW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1278673086892568576/1723971737/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 995358, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "さいき", "screen_name": "02_saiki_23", "avatar_url": "https://pbs.twimg.com/profile_images/1428385638940700679/_lUUVsfj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3074198940/1676010972/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1787606, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "みそぢる", "screen_name": "misodiru", "avatar_url": "https://pbs.twimg.com/profile_images/2058377647236038656/tQAV8l-v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2609298366/1769926617/1500x500", "appeal_receivable": false, "popular_creator_rank