 true}, {"path": "/@tengoku_jimusyo/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b170221c/uploads/origins/71700cf2-ca04-419e-a9f6-c128c300f0aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6db80e352720a9a054ddc9c310c5ba45", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3596921, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tengoku_jimusyo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3596921, "client_id": 3713411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/deef460e/uploads/origins/70783b74-5167-4987-a758-a94fb4d00e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56ad51ef179c45bd73dd2ffdc7c30d2f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/deef460e/uploads/origins/70783b74-5167-4987-a758-a94fb4d00e51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53eb664b2744c883fb9363c48bf2f9ba", "src_set": ""}, "body": "高級感あるドレスを着た女の子二人が向かい合っている。(バストより上)\n一人の女の子は黒髪ボブかショートブルベ冬小麦肌。\nもう一人は黒髪ロングぱっつんで色白。\n絵画のようなイメージ。\n“高みで会いましょう”という文字を向かい合っている二人の真ん中にできれば大きくパッと読めるように描いて欲しい。\n全体的に可愛らしくて水色など爽やかな色を使って欲しい。\n百合の花も描いて欲しい。\nアイコンに使いたいので1対1の正方形。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tengoku_jimusyo/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c2b4581e/uploads/origins/3fc8ce3c-5def-4f0a-80c7-d9981f4808e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&