_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 7, "received_works": [{"path": "/@Yzmantime/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 137610, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e982714/uploads/origins/45b752ad-fbb8-4029-814e-d1acdb0cdf8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee8d7906f44e2569802d4d56f74c156", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e982714/uploads/origins/45b752ad-fbb8-4029-814e-d1acdb0cdf8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0125a7df9f8cd631990f3779a70154a6", "src_set": ""}, "body": "アピールありがとうございます。依頼させていただきます。\n\n内容は、\n→学校で授業を受けている泉こなた(らき☆すた)。すると突然、ミチミチと制服を軋ませながら胸が頭よりも巨大に膨乳、乳輪の直径が顔よりも大きくなりお椀のように膨らみ、乳首も極太のデカ乳首に巨大化するも制服に押さえつけられ、圧迫により母乳が服越しにドロドロと出てきてしまいました。尻も胸以上の大きさに膨尻しそれに合わせて腰と太ももも極太になってしまいスカートを押し上げ、マンコがパンツを引き裂きつつムクムクと肥大していき、スカートで隠せないどころか股下にバランスボールでも挟んでいるのかというほどの巨マンになってしまいました。肥大化した身体を隠そうとモゾモゾしていると、感度も爆上がりしているために身体をビクつかせ、マンコからは愛液を垂れ流し、抑えているが喘ぎ声が漏れてきてしまいます。追い打ちをかけるように、クリが強烈な快感を発しながら制服の下で巨大化しつつ勃起していき、胸の谷間に挟まる超巨大サイズになって太さもラグビーボールのようになってしまいました。意図せずセルフパイズリの形になってしまい、あまりの快感に歯を食いしばり足をピーンと伸ばし、馬の射精のように乳首からは母乳を巨マンからは本気汁を出しながら強烈な絶頂を迎えました。\nでお願いします。\n\n詳細ですが、\n・胸は[１]のような大きさと乳輪で、合わせて尻や腰の大きさを胸以上に\n・乳首はあまり長くなく、太さは太く\n・マンコは[２]を参考程度にお任せするが、大きさは限界まで大きくしてほしい\n・湯気や汗、汁も多いと嬉しい\n・構成・枚数はお任せする\nでお願いします。\n\n以上でどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/10twtJ5-xJnaXWIV-cYSR5SHltDbp1YVb?usp=sharing", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yzmantime/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 137610, "client_id": 1853984, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.i