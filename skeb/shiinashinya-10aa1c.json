31a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7d57059443ea4bb22578d815355332 3x"}, "body": "こんにちは、Vtuberのノヴァ・アオカミのイラストを依頼します。下記画像のメイド服を着用した状態で乱交シーンを描いてください。中出しされる前後の別々の写真を3枚、最後のシーンは後始末のフェラチオとして描いてください。 \n\nhttps://skeb.jp/@sokosokomichi/works/26https://x.com/i/status/1902375013581291554", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiinashinya/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3877867, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbc39acf2d40491cfc85e87e46641b8", "srcset": "https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8dbc39acf2d40491cfc85e87e46641b8, https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=723617f8884095bb704212f96839066b 2x, https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b3bd422b90c42f32c089673c9180a1e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dec8f7cb21dc2c1eb2be9a732de743b", "srcset": "https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dec8f7cb21dc2c1eb2be9a732de743b, https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57e331264047b7a0eeffaa0fd69cca13 2x, https://si.imgix.net/f3d00d52/uploads/origins/bbfd729f-7258-48c1-b9ab-4fa01a9d8edd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32a3ffb9657123349acf93039cdce7f4 3x"}, "body": "こんばんは\n氷沼悠理という子のカラーイラストをお願いします\nhttp://www.getchu.com/sp/soft.phtml?id=1190\n元お嬢様で常時敬語、読書が趣味のおっとりとした子です\n華奢で胸はわずかにふくらみがある程度(AAカップ)\n乳首は淡い桃色で乳輪乳頭小さめ\n陰毛なし\n\n\n・服装等\nセーラーワンピースの上をはだけて胸露出(腕部分のみ脱がないイメージ、資料参照)\nスカート部そのまま\n+膝下丈の黒ハイソックス\n下着なし\n\n\n・シチュ等\nhttps://drive.google.com/file/d/1pJMklXCz05vThXAp7IHyGPLDYqDXymiZ/\nと同様の構図及び体位で表情変化あり(基本的に目は開いたまま)\n\n和姦処女喪失(破瓜の血の描写をお願いします)\n↓\nピストン(竿に白く濁った愛液=本気汁が絡みつき始める)\n↓\n根元まで押し込んで下半身を密着させ、子宮口に押し付けながら破瓜中出しと同時に絶頂\n腹部〜スカート→大量に中出しされた精液が溢れて細かく飛び散っている\n結合部及び周辺→破瓜の血・本気汁・精液\nお尻の下のスカート裏→血・本気汁・精液が混じり合いながら結合部から流れ落ちて溜まっている\n感じでお願いします\n(血・本気汁・精液をそれぞれオンオフ可能にして頂けると捗ります)\n表情は目を細めず、\n眉を八の字にせず、\n口を「あ」の形に大きく開いて舌は出さないトロトロで幸せそうなかわいい顔\nオンオフ可能な断面図\n↓\n引き抜かれて血・本気汁・精液がべっとり絡みついたモノとアソコとでザーメンブリッジ、\n開いたままの膣口から血と本気汁混じりの精液が溢れて、お尻の下のスカート裏に溜まっている描写(モノが服や体に被らないと嬉しいです)\n↓\n髪・顔・口内・服・ふともも・黒ハイソックスなどもうかける場所がないくらい全身ドロドロな状態\n\n擬音や喘ぎ声等もあると助かります\n喘ぎ声は基本的に「あ」を使用し、\n絶頂時は「あ、あ、あ、あぁぁぁぁぁぁぁぁっ!!」\n\n結合部に\n藻ではなく線を使って頂けると捗ります\n(色は白)\n\nレイヤーは可能な限り細かく\n\n\n・背景\n自室想定で白いシーツのベッド上\n\n\n\n・男性\n同年代想定の特徴がない普通の男性(全裸)\nゲームの主人公のようなボサボサ頭で顔なしor頭部見切れ\n\n\n何卒ご検討下さい。\n\nhttps://drive.google.com/drive/folders/1IwML5k39fvT-axqqDQd9sn5Ym7GOIG2q", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shiinashinya/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3877867, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44b8435d71c8150de3de9525326caa8d", "srcset": "https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44b8435d71c8150de3de9525326caa8d, https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba3d3c5e17a7a5951e1d94c94cb9be87 2x, https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d88cb1c0ad678dec828871609d7feb0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=196e5c8d2047178a4e600f32e48efbd2", "srcset": "https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=196e5c8d2047178a4e600f32e48efbd2, https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0eae05d899015ee8d8ec5e1ab6ebfb39 2x, https://si.imgix.net/198a845e/uploads/origins/05fc0c99-bce8-48dd-abda-8ba10cad09a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f696bb880bafc3f549d169e655063cf 3x"}, "body": "はじめまして、新着クリエイター一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nサービス終了したネットゲームのマイキャラクターがモデルのうちの子になります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子で、お尻が性感帯です\n\n・希望する内容を箇条書きで\n「依頼衣装（ドレスまたは夏服）」というファイルの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n恋人とのいちゃらぶセックス、可能であれば尻尾は無しでアナルセックス\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装は着衣～半脱ぎくらいでお願いします\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\nご検討をお願いいたします\n\nhttps://driv