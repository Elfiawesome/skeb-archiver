ou want to make changes to it or add something to make it look more detailed, that would be awesome. Please leave the background blank. Or if you want to draw a background anyways please also include a version that is without background. Thanks.", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@E_dagi_H_ayuko/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2757347, "client_id": 1765701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba54e2f5/uploads/origins/b13cd855-79de-46e5-bd10-42c1a24b88d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7bc1d17d193b82857e9c5454b53624", "srcset": "https://si.imgix.net/ba54e2f5/uploads/origins/b13cd855-79de-46e5-bd10-42c1a24b88d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b7bc1d17d193b82857e9c5454b53624, https://si.imgix.net/ba54e2f5/uploads/origins/b13cd855-79de-46e5-bd10-42c1a24b88d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29d2119e1e603eaf33c53a079c3ccd60 2x, https://si.imgix.net/ba54e2f5/uploads/origins/b13cd855-79de-46e5-bd10-42c1a24b88d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7079ba3eddcdac0b734b5e458a76afae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba54e2f5/uploads/origins/b13cd855-79de-46e5-bd10-42c1a24b88d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=164a5c012caeed3448e3073c704d4ef0", "srcset": "https://si.imgix.net/ba54e2f5/uploads/origins/b13cd855-79de-46e5-bd10-42c1a24b88d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=164a5c012caeed3448e3073c704d4ef0, https://si.imgix.net/ba54e2f5/uploads/origins/b13cd855-79de-46e5-bd10-42c1a24b88d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=