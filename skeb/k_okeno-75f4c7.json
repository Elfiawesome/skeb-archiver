ベルトタイプのライフジャケットと、ハット手袋が欲しいです。\n　　　ロッドは特別指定はございませんが、リールはスピニングリールだとうれしいです。\n※それぞれのデザインの描き込みは余裕があれば…。\n\n視点：正面、側面、俯瞰、水中、お任せします。\n背景：お任せします。\n\n全体：フルでもバストアップでもお任せします。\n\n備考：上記、よくわからない、というところは自己解釈でお願いします。\n\n用途：可能であればTwitterやLINE（身内用）のヘッダなどの利用を希望します。\n許可いただければ横長（釣りガール右寄り）、鑑賞のみであれば縦長で作成いただければと思います。\n\nこちらの趣味+あまりかかれないタイプだなと思ったので、\nその気になられたらで、どうぞお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_okeno/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 349454, "client_id": 70045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d63c9c688ef8d0995188b2c085b136", "srcset": "https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63d63c9c688ef8d0995188b2c085b136, https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1afc147d7ba7121d0bf25027e0adcc06 2x, https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea5b57f1b90cf94cd306e4b51f374a19 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=417ffdc80cedf5bb45a38cc863295310", "srcset": "https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=417ffdc80cedf5bb45a38cc863295310, https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b61de3f23b3db6259252d1489c082536 2x, https://si.imgix.net/bea2df04/requests/110811_0?bg=%23fff&auto=format%2Ccompress&fm=web