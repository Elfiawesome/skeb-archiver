はすでに堕とされており、仮面をつけた謎の悪の魔法少女（もちろんバレない）として組織のために戦いながら、日常生活では他の女子を堕とすための仕込みを嬉々として行い、家に帰れば自分を堕としたご主人にそれを報告し\"ご褒美\"を頂いているのであった……\nという感じのストーリーをお願いします。\n細かい部分はお任せしますので以上よろしくお願いします。", "nc": 48, "word_count": 6269, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@ookimomota/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 235121, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F807101115980390400%2FRnJ4966L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2abd67865aafbeabf8b291ef7a40c420", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F807101115980390400%2FRnJ4966L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2abd67865aafbeabf8b291ef7a40c420, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F807101115980390400%2FRnJ4966L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9998fd5749fbebd1184e02606334777b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F807101115980390400%2FRnJ4966L.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f072730680d63f9c3790e59ad15a3e5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%