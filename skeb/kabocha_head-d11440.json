200&s=80e413952cd0fcc19eadda5d8d1747d9", "srcset": "https://si.imgix.net/b24cd9f6/uploads/origins/72bd3ec2-6226-4a7e-9937-cb70694ac467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80e413952cd0fcc19eadda5d8d1747d9, https://si.imgix.net/b24cd9f6/uploads/origins/72bd3ec2-6226-4a7e-9937-cb70694ac467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f4bb519ba639ab861b17939477be30d 2x, https://si.imgix.net/b24cd9f6/uploads/origins/72bd3ec2-6226-4a7e-9937-cb70694ac467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3fbeacf1afc04680b5ed47ba14a680cf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b24cd9f6/uploads/origins/72bd3ec2-6226-4a7e-9937-cb70694ac467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa3ced209c6c30003bc3a5cd9108f00e", "srcset": "https://si.imgix.net/b24cd9f6/uploads/origins/72bd3ec2-6226-4a7e-9937-cb70694ac467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa3ced209c6c30003bc3a5cd9108f00e, https://si.imgix.net/b24cd9f6/uploads/origins/72bd3ec2-6226-4a7e-9937-cb70694ac467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8d3fa9bae083bc48c32084cda7c14451 2x, https://si.imgix.net/b24cd9f6/uploads/origins/72bd3ec2-6226-4a7e-9937-cb70694ac467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d03d015713c173ad562e197c98c9f6ec 3x"}, "body": "里美ちゃんのイラストがエロかったのでリクエストします\nデレマスの榊原里美と一対一ボテ腹中出しエッチ\n\n背面座位で後ろから片方のおっぱいを揉まれて母乳噴出\nラブな感じ\nイメージ、アングルは正面\nhttps://www.pixiv.net/artworks/90053691\n里美はまっすぐ前を向いている、余韻に浸っているため後ろの男に振り返らない、男は里美の体で隠れる\nボテ腹のサイズは大きい\n巨乳、垂れ乳にはならない\n射精されてる瞬間のシーン、精液は結合部から溢れている、挿入は膣\nドクドク、ドププといっぱい出されている効果音あり\n尿お漏らし、勢いよく放尿ではなくある程度でた後、じょろ～っとまだ出ている途中、尿は睾丸を伝って床に水たまりを作る、分かりやすいように黄色\n\n表情は3パターン\n1ぽけ～\n初期イラストの表情、おしっこ漏れてる、いっぱい射精されているのに何処か他人事のような表情\nエッチで気持ちよくなってるので顔は少し赤くなる\nhttps://www.pixiv.net/artworks/35930036\n2笑顔\n穏やかに微笑んでいる\nイメージ\nhttps://www.pixiv.net/artworks/45629980\n3ふくれっ面\n口をすぼめる、怒ると言うよりは困ってる表情\nイメージ\nhttps://www.pixiv.net/artworks/52810441\n\n乳首は小さめ\n資料URL参照\n\n髪型はドリルヘアー、リボンは赤の初期イラストの物\n服装はお任せしますがお腹、胸、結合部が隠れないように\n銀髪で瞳の色は紫です\nロケットペンダントを忘れないでください、可能であれば無しの差分をお願いします\nhttps://www.pixiv.net/artworks/24684121\n陰毛は髪色と同じ銀色、可能なら無毛差分\n\nカラーイラスト\n真っ白だと味気ないので流用でもグラデーションでも良いので背景\n修正は黒線か精液とモザイク以外でお願いします、セリフは「ほぇえ」と声が漏れる感じ\nセリフなしもお願いします\nどの表情でも目は開いて紫色の瞳が見える\nおしっこが出ている尿道が見えるように修正をお願いします\n紐付け以外のツイッターアカウントへの投稿許可願います\n難しい場合はキャンセル願います\n\nhttps://www.pixiv.net/artworks/24684121", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kabocha_head/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1539118, "client_id": 670108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3b36ebc/uploads/origins/42d44cf1-8997-47d8-8c2d-808e20bb85de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b57c4836fd4abfd64eb9edc02c56bb2", "srcset": "https://si.imgix.net/b3b36ebc/uploads/origins/42d44cf1-8997-47d8-8c2d-808e20bb85de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b57c4836fd4abfd64eb9edc02c56bb2, https://si.imgix.net/b3b36ebc/uploads/origins/42d44cf1-8997-47d8-8c2d-808e20bb85de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=05db1cf62ca742c3e5e0a93f97f1b8f3 2x, https://si.imgix.net/b3b36ebc/uploads/origins/42d44cf1-8997-47d8-8c2d-808e20bb85de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ede0178d83d595f975940f35b71ce97 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3b36ebc/uploads/origins/42d44cf1-8997-47d8-8c2d-808e20bb85de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d8780af8448dbe8cbbc5dd