青紫メイです。\nいつも魅力的なイラストをありがとうございます。\n今回、星乃もくずさんに、イラストを描いて頂きたくご連絡させて頂きました！\n\nリクエスト等はございません。\n思うがままに描いて頂きたいです！\n\nまた、skebで描いて頂いたイラストは透過済みありでサムネイル等に使わせて頂けると幸いです。\n\n御検討のほど、何卒よろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hoshino_mokuzu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1096970, "client_id": 2681914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cc0347a/uploads/origins/2f30d21d-d246-468f-9823-8464d787abb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6684bbe95079498eb9f342d47c45103f", "srcset": "https://si.imgix.net/4cc0347a/uploads/origins/2f30d21d-d246-468f-9823-8464d787abb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6684bbe95079498eb9f342d47c45103f, https://si.imgix.net/4cc0347a/uploads/origins/2f30d21d-d246-468f-9823-8464d787abb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=687abe3d5ab7c56391d8a5a5fa0b201d 2x, https://si.imgix.net/4cc0347a/uploads/origins/2f30d21d-d246-468f-9823-8464d787abb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1581a65475ffc0b21989cba7e127657b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cc0347a/uploads/origins/2f30d21d-d246-468f-9823-8464d787abb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fb4dff8e0cbc1f7b17b0e37615f648e", "srcset": "https://si.imgix.net/4cc0347a/uploads/origins/2f30d21d-d246-468f-9823-8464d787abb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1fb4dff8e0cbc1f7b17b0e37615f648e, https://si.imgix.net/4cc0347a/uploads/origins/2f30d21d-d246-468f-9823-8464d787abb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8dc24eecdce016473fc12dc533d66b20 2x,