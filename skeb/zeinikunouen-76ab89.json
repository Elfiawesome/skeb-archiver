%ce%a5%df%a5%eb%a5%ad%a1%bcB.B%a1%cf%b5%da%c0%ee%bc%b6\nシチュ\n肉塊アイドルとして大成功をし、世界一ファン数の多いアイドルとなった雫は世界一の大金持ちとなり、稼いだ収入のほとんどを食費にまわし、更なる体重増加を目指している様子でお願いします\n構図\nとにかく雫の巨大感を重視してほしいです\n背景\n大金持ちを強調するため金の延べ棒の山を追加して、\n凄まじさを強調するため世界的な大食い大会で優勝した写真、雫専用のコンサート会場を建てた写真、山よりも巨大な自分の銅像を建てた写真など他にも協調できる思いついたものがあれば追加をお願いします\n台詞\n金銭感覚が明らかにおかしくなっていて、千万、億円分の食材を買い占めるように召使いに頼むようなセリフでお願いします\n資産額も数値化してもらえると嬉しいです\nとにかく非現実的なものでお願いします", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zeinikunouen/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/196e24c0/uploads/origins/3ac978bb-8051-4f85-babb-42759b30dcb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d41c9280d821c7481b7ca358c4cacea", "srcset": "https://si.imgix.net/196e24c0/uploads/origins/3ac978bb-8051-4f85-babb-42759b30dcb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2d41c9280d821c7481b7ca358c4cacea, https://si.imgix.net/196e24c0/uploads/origins/3ac978bb-8051-4f85-babb-42759b30dcb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=122fe47a87a626535aa89ad9eef1d9d8 2x, https://si.imgix.net/196e24c0/uploads/origins/3ac978bb-8051-4f85-babb-42759b30dcb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ed311a65d294ef9ed4343e3abf53abd 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2108109, "client_id": 106912, "nc": 48}, {"path": "/@zeinikunouen/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2108109, "client_id": 1022249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e76579131696d73af324586d7137433c", "srcset": "https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e76579131696d73af324586d7137433c, https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f630bd6911fcc143106e4b81af721851 2x, https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4748982b27b3f8a585f20f3584a5f66 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d8b26268736962fcb046015cf3134a3", "srcset": "https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6d8b26268736962fcb046015cf3134a3, https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53c8e5e273fc8a9f1409768177eb4fdc 2x, https://si.imgix.net/e521e736/uploads/origins/3feb991a-22f7-4ab4-9191-d5b9c0974cb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a60e8872052d496b0618550c6c990fc2 3x"}, "body": "すぐに別のリクエストを送るのは申し訳ないのですが、どうしてもストーリーをもっと見てみたいのです！\n今回は大きめのコミックで、黒子智樹と彼氏（フィーダー）の関係の始まりのあたりも見てみたいです。\n最初はまだ恥ずかしがっていて、人前で彼に気を遣うのが恥ずかしいとか。\nまた、コミックの最初か最後に、痩せた黒子の裸と、休み明けの黒子の姿の比較も見てみたいです。\nそして、ある記念日あたりで、目の前にごちそうがある様子。食べるキャラの描き方も好きなので、ぜひ見てみたいです。\nラストは、最初の依頼とこれから会うことに絡めてください。\n黒子はストレスが溜まっていて、夫に「今、こんなストレスフルな状況になっている」と不平を言いながら、落ち着こうとし続けています。立ち上がろうとしても、全身が震えてしまい、巨大な体をくねらせるだけです。夫はそんな彼女をなだめ、「大丈夫だ」と約束する。そして、ケーキを食べさせて落ち着かせ、彼女は眠りにつく。\n翌朝、彼は彼女の巨大な体を前にして、立ち尽くす。彼女の髪は油で汚れており、不潔である。パンストは臭く汗ばみ、体中が油汚れとパンくず、食べかすだらけだ。携帯電話も油のシワの中に入れている。\n彼は息を吸い込み、仕事に取り掛かる。入浴後すぐにセックスをしないように、彼は彼女に栄養チューブを与え、食事の気を紛らわせ、罪深く彼女を洗う。彼は彼女の皺の一つ一つ、乳房を洗い、彼女の毛も剃る。髪を洗ってから櫛でとかす。\n彼は新しいパンストを履かせ、ブラとパンティをつけるが、彼女はブラジャーをつけるのが嫌だと文句を言う。\nそして、いつも用意しているドレスを着せると、喜びのあまり夫と抱き合い、キスをする。\nこれが一つのアイデアで、その通りにする必要はないのですが、私のアイデアを皆さんにお伝えしたかったのです。\nでも、最終的にはぜひ、全身の写真で彼女の体の発育統計を見たいですね。\nもし量が少なすぎたら増やします、遠慮なく書いてください、必ずしもドイツ語でもう一度マンガをやる必要はありません。とても親切で、私もとても感謝しているのですが、私は日本語を勉強しているので、翻訳することもできます。だから、必要以上の仕事をする必要はない。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zeinikunouen/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2108109, "client_id": 1022249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a218d745e505b4077ae4a827e6ea499", "srcset": "https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a218d745e505b4077ae4a827e6ea499, https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3bfb9193bbfea816eef385d9bbe52992 2x, https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=676f88af4a2184a4f4c708b2cdca1dc2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f814ad90f504dc376dfbbff590a5cedc", "srcset": "https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f814ad90f504dc376dfbbff590a5cedc, https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56ae8267ca26f87c646e30cd0bbcfeda 2x, https://si.imgix.net/47c6d242/uploads/origins/e2ed7bff-14ff-45d9-99a9-03bc201492f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63d5b1a57c20fab0303927c59e1a3c0a 3x"}, "body": "ワタモテの黒木知子が同級生に測られるという小話が欲しいです。無害に始まるはずなのに、彼女はとても居心地がよく、彼が自分のことをこんなに気にかけてくれていることに、少し罪悪感さえ感じてしまうのです。その過程で、彼らはセックスもし、この食事とセックスにあふれた生活は彼女を甘やかす。どんどん体重が増え、その過程で胸も大きくなるはずなのに、時折、怠け癖がついたり、わがままになったりするのです。料理が来るまでに時間がかかると文句を言うし、もう我慢できないからと、そのままセックスしながら体を洗うシーンもあるはずだ。最後はベッドの上だけで、すっかり甘えてしまうほど太っているはずです。彼女は物語中、ずっと黒いパンストを履き続けているはずです。彼女の最初の親切でありがたい振る舞いも見せるべきで、彼氏ができたことがいかに嬉しいか。", "nc": 34, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zeinikunouen/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/31b0208d/uploads/origins/d76f8758-a8ee-4584-96fc-7b24ec3e582d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90bfe01138a8933190708ec8f9d4762b", "srcset": "https://si.imgix.net/31b0208d/uploads/origins/d76f8758-a8ee-4584-96fc-7b24ec3e582d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=90bfe01138a8933190708ec8f9d4762b, https://si.imgix.net/31b0208d/uploads/origins/d76f8758-a8ee-4584-96fc-7b24ec3e582d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr