1-b3cd-42ab-b979-8dabed22c859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0995de0d749bc4315df1a556e4191e3c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0774c520/uploads/origins/e0538941-b3cd-42ab-b979-8dabed22c859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d395c82642d8f2ad047a404d00c18fa8", "srcset": "https://si.imgix.net/0774c520/uploads/origins/e0538941-b3cd-42ab-b979-8dabed22c859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d395c82642d8f2ad047a404d00c18fa8, https://si.imgix.net/0774c520/uploads/origins/e0538941-b3cd-42ab-b979-8dabed22c859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc8e21ddf65e49f30c9bea1ba9277ad8 2x, https://si.imgix.net/0774c520/uploads/origins/e0538941-b3cd-42ab-b979-8dabed22c859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32534a1f97a82b18748accc1a52e58ee 3x"}, "body": "『一人暮らしを始めた妹に呼ばれてみたらブクブク太っていて世話することになった』の妹ちゃんをお願いします。\n\nシチュ\n本編のあと、さらにブクブク太った妹ちゃん。息を切らしながらお兄ちゃんに甘えて、大量の食事を食べながら膨らんだお腹を撫でてほしいとおねだりする。愛しい妹のために腹をさすってやると大きなお腹の音が鳴り、今まさに食事中なのに「おなかすいたぁ、もっと食べたい」と要求する妹。兄はそんな妹に軽く呆れつつも、妹をさらに太らせるため超ハイカロリーな食事をさらに用意する。\n\n体型\n以前pixivに投稿されていた霜降ハラちゃんが10トンを超えたイラストぐらいのイメージで、巨大化した胸は床に着き、お腹は両胸を足してもなお及ばないくらいの大きさ。\n顔は肉に埋もれながらも、可愛さは損なわれていない。お兄ちゃんにお世話してもらって嬉しそうな表情。\n着ることのできる服はなく、常に全裸。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zeinikunouen/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2108109, "client_id": 2490792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d3e41edcb74ef8935d0f305b739f76", "srcset": "https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2d3e41edcb74ef8935d0f305b739f76, https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fc5871a0e6da658ced1a22067b82bd5 2x, https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdcade45f07cb2baa3138df7d6636054 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a346f4e5389ef7753d8eaae59377cbc", "srcset": "https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a346f4e5389ef7753d8eaae59377cbc, https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b43fba5d5fc5b78c2c79f9d8fbcab444 2x, https://si.imgix.net/919b8ff2/uploads/origins/dc369fd6-bc0f-4676-822a-376ab3713e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fe1766df7f7b0c8ed6101d6992ebd24 3x"}, "body": "こんにちは！\n\n私のOCであるぽっちゃりスライム娘、エリッセのアイデアを実現させてほしい。彼女は食べ放題のビュッフェレストランに入り、\"目の前にあるものすべてを、制限なく食べる \"というフレーズを誤解した。彼女はその後、スライム体であるために消化が早く、莫大な体重を増やし、すべての料理、特にレストランにいるすべての他の客を、後悔することなく食べてしまう。\n\nクーデレなので表情が乏しく、本来は中性的。\n\nエリセはもともとかなりぽっちゃりしているので、さらに巨大化するか、動かなくなるか、塊になってほしい。服が破れていたり小さすぎたりしていれば、裸でもほぼ裸でも描ける。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1HohC-vRDiVUuKAg8EIlsR3Zp9zhUXOsF?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, 