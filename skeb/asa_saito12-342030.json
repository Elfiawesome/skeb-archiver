45-5a72d0681066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f96890ab3529433a0b33ce901245de5f 2x, https://si.imgix.net/98244256/uploads/origins/f93f5b4a-0f34-4504-9a45-5a72d0681066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7cf0a231c1d1a2c7e8e4b2f0407fffa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98244256/uploads/origins/f93f5b4a-0f34-4504-9a45-5a72d0681066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60a7203c042703191aa386bc5dea141e", "srcset": "https://si.imgix.net/98244256/uploads/origins/f93f5b4a-0f34-4504-9a45-5a72d0681066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60a7203c042703191aa386bc5dea141e, https://si.imgix.net/98244256/uploads/origins/f93f5b4a-0f34-4504-9a45-5a72d0681066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=693fbea1bf0483f845c4b04db17f1973 2x, https://si.imgix.net/98244256/uploads/origins/f93f5b4a-0f34-4504-9a45-5a72d0681066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=104c6e1a8d528fd4fba0c13b5d7f1205 3x"}, "body": "初めまして。拝見させていただいたイラストの絵柄が好みでしたのでリクエストさせていただきます。\n初代ウルトラマンの擬女化(擬人化且つ女体化させたもの)をお願いしたいです。全身絵でお願いします。\n\n基本的にはお任せしたいのですが瞳の色は黄色でお願いしたいです。そして女の子でお願いしたいです。可愛らしさとカッコ良さ、動きやすさ(戦いやすさ)も兼ね備えた感じでピッタリ感とドレス感が融合したような赤と銀色の衣装であると嬉しいです。ミニスカートで下にスカート丈よりも少し長い赤色のスパッツを着用しているととても嬉しいです。\n\n胸に青色に輝くカラータイマーも付けてください。差分としてエネルギーが少なくなり赤色に変わって激しく点滅しているもの(カラータイマーが赤色になっている色差分)をお願いしたいです。(可能であればピンチ感のある表情差分も)更に可能であればエネルギーが完全に無くなり消灯してしまっているものもお願いしたいです。\n\n何卒よろしくお願いします。\n\nウルトラマン擬女化例イメージ\n↓\n\nhttps://drive.google.com/drive/folders/1TUyyP0OM-JRX0XHQPlDs_GJvkto-weZS", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asa_saito12/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a99868f3/uploads/