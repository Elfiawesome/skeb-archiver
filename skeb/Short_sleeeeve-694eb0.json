メのタグで検索をかけ\nとても素敵な作品を描かれていたJoe.様に作品を描いていただきたくご依頼させていただく次第です！\n\nご依頼しますのは\n『寄宿学校のジュリエット』より狗神玲音ちゃんと\nうちの子であるオリキャラの柄葉五鈴(つかは いすず)ちゃんとのコラボイラストをお願いいたします！\n\n構図はお任せいたします！\n可能なら下記に書く黒タイツ着用という理由から全体像があると嬉しいです！\nしかしこちらがキャンセル理由になるのでしたら、完全にお任せしますのでお好きに描いていただければ幸いです！\n\n\n玲音ちゃんはイメチェン後のショートボブカットでダリア学園　黒犬の寮制服で黒タイツ着用\n\n五鈴ちゃんはダリア学園　黒犬の寮制服or白猫の寮制服で黒タイツor白タイツor柄タイツ　組み合わせはお任せします！！\n\n\n\nうちの子はとても明るい元気な子です！！\n⚠️注意点があるとするとうちの子の資料の中に肌が褐色っぽい物も含まれていますが\n肌の色は通常の肌色であると大変助かります！\n\n以上になります！\nご検討いただければとても幸いです！！\n\n\n資料\n\nhttps://www.dropbox.com/sh/lvyl8io4gnpl9eu/AAA5M7PQzzsBuuELi1bSX6oIa?dl=0\n\n\n五鈴ちゃん資料\nhttps://www.dropbox.com/sh/ry67ocwtc20fgy8/AACve8MF2Y9B5RILo_RFvaeKa?dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Short_sleeeeve/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 206447, "client_id": 375679, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4247dfb0/requests/78981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54d816843ce8d6fa58fdab2aba7d42c9", "srcset": "https://si.imgix.net/4247dfb0/requests/78981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54d816843ce8d6fa58fdab2aba7d42c9, https://si.imgix.net/4247dfb0/requests/78981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95c8db49e0da937f5e50a128410cd5f6 2x, https://si.imgix.net/4247dfb0/requests/78981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8af6eb306ee11786b2fa81d058849b5f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4247dfb0/requests/78981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7d1ed8d917505d3872f8c2591e55cb9", "srcset": "https://si.imgix.net/4247dfb0/requests/78981_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&