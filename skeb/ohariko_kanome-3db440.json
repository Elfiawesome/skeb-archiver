d-4b8d-8100-8ca354033fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4630235cb5431d6f97f86c126aeb8f32", "srcset": "https://si.imgix.net/1af77946/uploads/origins/6456355b-dedd-4b8d-8100-8ca354033fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4630235cb5431d6f97f86c126aeb8f32, https://si.imgix.net/1af77946/uploads/origins/6456355b-dedd-4b8d-8100-8ca354033fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4da61e57db5145962a0d8c6d45b64bd3 2x, https://si.imgix.net/1af77946/uploads/origins/6456355b-dedd-4b8d-8100-8ca354033fc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16fee7986a715fc223236e8171cbb374 3x"}, "body": "はじめまして。杜莎かのめと申します。\nとてもかわいい女の子とキラキラで華やかな雰囲気に惹かれ、ぜひイラストを描いていただきたくリクエストいたしました。\n\nキャラクターが料理を作っている、もしくはお菓子を食べているイラストを頂きたいです。\n静谷様のイラストのテイストがとても好きなので、衣装についてもしご負担でなければ静谷様のテイストで書いていただけたらとても嬉しいです…！\n\n使用用途としては、SNSでの投稿と動画サムネイルなどで使わせていただきたいです。\nサイズについては指定はありませんが、キャラクターを分けられるPSD形式で頂けますととても嬉しいです。\n\nご縁がありましたら幸いです。\nどうぞよろしくお願いいたします。\n\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1KVJCouWGG-NFRltykngpM_vv9VLxeM8i?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saku_nosuke/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 669169, "client_id": 1283267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca4b9cc3/uploads/origins/a21ce0b6-61ef-452d-a68e-f76106c5d844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bab2a82fec7f18d6716000359a7f1749", "srcset": "https://si.imgix.net/ca4b9cc3/uploads/origins/a21ce0b6-61ef-452d-a68e-f76106c5d844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bab2a82fec7f18d6716000359a7f1749, https://si.imgix.net/ca4b9cc3/uploads/origins/a21ce0b6-61ef-452d-a68e-f76106c5d844?bg=%23fff&auto=