サクさんが描いた空の絵が見たいです！\n紫色っぽいマジックアワーな空でお願いします。\n\nパソコンの壁紙に使います。\nサイズは1920×1080以上であれば問題ありません。\n\nまた、作成されたイラストは素材として販売してかまいません。\nたとえば、すでにBOOTHで販売されている雨の降る部屋のように、\n期間限定で無料ダウンロードからの有料販売を行っても大丈夫です。\n\nSkebの規約（第6条 知的財産権の帰属及び使用許諾）を読んだ限り、Skebでリクエストされたイラストを販売しても、問題ないかと思います。\n\n以上です。\nもし良ければ受けていただけると幸いです！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bygvlj_ss/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 55911, "client_id": 94251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c87ad00/uploads/origins/cf63c89e-1c5e-42ea-b213-0056d3b3797d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d458094b10f6d14492a12deddb39a6b", "srcset": "https://si.imgix.net/3c87ad00/uploads/origins/cf63c89e-1c5e-42ea-b213-0056d3b3797d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d458094b10f6d14492a12deddb39a6b, https://si.imgix.net/3c87ad00/uploads/origins/cf63c89e-1c5e-42ea-b213-0056d3b3797d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22406ac8a9ccaa7ea48a00cfbc2bcc18 2x, https://si.imgix.net/3c87ad00/uploads/origins/cf63c89e-1c5e-42ea-b213-0056d3b3797d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb42df8d28f6c2261676c4f4acb6eeef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c87ad00/uploads/origins/cf63c89e-1c5e-42ea-b213-0056d3b3797d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9442c24c9b4d4f2c518bb4ee87a0f92b", "srcset": "https://si.imgix.net/3c87ad00/uploads/origins/cf63c89e-1c5e-42ea-b213-0056d3b3797d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9442c24c9b4d4f2c518bb4ee87a0f92b, https://si.imgix.net/3c87ad00/uploads/origins/cf63c89e-1c5e-42ea-b213-0056d3b3797d?bg=%23fff&auto=format%2C