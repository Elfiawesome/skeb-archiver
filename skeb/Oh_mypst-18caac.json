fa2b9af7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5b03a500f4c39bd259b54855eca6b6, https://si.imgix.net/154c7b95/uploads/origins/386230c8-46ad-489c-8eb2-61dafa2b9af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a30a6e728175afa148d50312cc7de8b7 2x, https://si.imgix.net/154c7b95/uploads/origins/386230c8-46ad-489c-8eb2-61dafa2b9af7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2703b650201b19ab369371c152edfabf 3x"}, "body": "すみの様へ\n\n私のOCのキャラクターシートの依頼をしたいと思い、リクエストを送らせていただきました。\n以下にOCの設定を載せます。\n\n【設定】\n名前：五十鈴 真香（いすず まなか）\n年齢：16\n性別：女性\n性格：優しくて元気\nその他：学校ではダンス部所属で、結構激しいダンスとかも踊れる。\n\n【衣服及び描いてほしい点】\n①上の服\n半袖の白い無地のパーカーを着ている。胸は控えめなサイズ(大きくない)\n②下の服\n無地の黒いスカートを履いており、裾の長さは膝より上。\n③靴\nconverse風の黒いハイカットスニーカー。ハイカットの高さは足首を完全に覆えるくらいまでで、靴紐は結構長め(紐の先端が地面と接触するくらいで)\nソックスは履いていない(素足履き)\n\n※資料URLで容姿等をご確認ください。\n\n出来上がったイラストは基本は他の絵師様へご依頼する際の設定資料や卓ゲー等で利用させていただく形になります。\nぜひリクエストの程、誠によろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/jag67ahkdsmsab5osr6g5/AD0vCmLsEfmAnVpqB2xEndY?rlkey=o7zeghq8yvpvgifg4y90reqhy&st=lgffbww6&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Oh_mypst/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3016334, "client_id": 3000741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4ceae17586bdf838ab6d7d96dabdad4", "srcset": "https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4ceae17586bdf838ab6d7d96dabdad4, https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bcdfa4b8feb86e80144071f0df99fcb 2x, https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=264e3e5c426accbe506e2b5b3ef90770 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07bc760024d504994f49abcbfa922c96", "srcset": "https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07bc760024d504994f49abcbfa922c96, https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dcf42d49d1498cdce8f9251011afa423 2x, https://si.imgix.net/e4134025/uploads/origins/86dc9f0b-2dce-47b6-843b-44cda5de7404?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eea51ce43ebf64046fa127229d5cd708 3x"}, "body": "やあ、住野！\n\nOC/VTuberのキャラシートのキャラデザをお願いしたいです。もしよろしければ、中性的なポーズ、正面、背面、横向きのポーズ、横向きの追加表情を希望します。キャラクターのために持っていた主なアイデアで、下にいくつかの参考文献をリンクしました。彼のデザインで一番大事にしてほしい点は、「少年」という感じです。これは、声だけでなく性格としても、私が彼に提供できるものに一番合っていると思うからです。\n\nもしよろしければ、他のデザイン面についても少し説明したいと思います。まず1つ目は、彼の靴とパンツだ。靴はコンバースのベーシックな赤なんだけど、カーゴパンツで袖口がリブになっていて、くるぶしの少し上まである。ズボンの色は特定の青で、袖口の白はゆっくりと上に向かってにじんでいる。\n\nシャツとフード付きベストに関しては、以前依頼したアートピースと同じ色にしてほしい。Tシャツは黒のまま、フード付きベストは赤のままですが、シャツの白いラインはあまり似合わないと思うので、省いてもらえないでしょうか。\n\nまた、彼に合うアクセサリーもいくつか持っているのですが、以前のアーティストたちはチェーンにシルバーの十字架とシルバーのビーズのネックレスという一貫性を保つのに良い仕事をしてきたと思います。\n\nヘアスタイルはそのままで、もう少し黒くハイライトした髪を増やしたい。顔については、目はヘッドホンをしている描写に近いものにしたい（ヘッドホンはデザインに入れたくないが）。また、『シャドウ・エリミネーターズ』の黒森青葉や『双星のエクソシスト』の閻魔堂ろくろのようなスタイルにすることで、「少年」の雰囲気を出すことができるだろう。また、バラエティーを持たせるために、いろいろな表情を見てみたいと思っています。\n\n最後ですが、一番難しいのは彼の手と手袋だと思います。右手はこの3連のハーフグローブで、手首のバンド部分は『幻影異聞録』のイエランが持っている袖のようなシンプルなデザインで、『活撃ヒットマンリボーン』のグローブのように少し伸びているものにしたい！色は黒で、赤のハイライトもある。左手はこのような鋭利な金属／騎士の爪のようなもので、ほとんど鎧のような上側は赤く、下側は黒い。手首のバンドは青葉のように手錠にすることもできる。\n\n私が彼のデザインに求めているもので、これまで述べたものにマッチすると思われるアパレルや美学をコラージュしてリストアップしてみた。もちろん、あなたの芸術的な専門知識を信頼しているので、私が示したものを自由に拡大したり修正したりしてください。もし価格設定や私の問い合わせに複雑な点があれば、遠慮なく訂正してください。それでは、良い一日をお過ごしください！\n\nhttps://i.imgur.com/PGPWEuN.jpg\n\n敬具\nドラコ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Oh_mypst/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3016334, "client_id": 1714873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/355b64cb/uploads/origins/6864a4b0-7393-4f79-8ec7-e39ffd097861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c8a8565123dc66f28f4508e2e760d1", "srcset": "https://si.imgix.net/355b64cb/uploads/origins/6864a4b0-7393-4f79-8ec7-e39ffd097861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18c8a8565123dc66f28f4508e2e760d1, https://si.imgix.net/355b64cb/uploads/origins/6864a4b0-7393-4f79-8ec7-e39ffd097861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9258cbe84d057936e0256ab1be203451 2x, https://si.imgix.net/355b64cb/uploads/origins/6864a4b0-7393-4f79-8ec7-e39ffd097861?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=538dddf4f4d1f564b37f5de2f890c3dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/355b64cb/uploads/origins/6864a4b0-7393-4f79-8ec7-e39ffd097861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c1cd9eb1809be77b20d0257382c96b9", "srcset": "https://si.imgix.net/355b64cb/uploads/origins/6864a4b0-7393-4f79-8ec7-e39ffd097861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c1cd9eb1809be77b20d0257382c96b9, https://si.imgix.net/355b64cb