=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0a3a1182f30364b4724bc8d9014411d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eaaa4a81/uploads/origins/a832dbae-6cc6-46ae-bab3-db655e50c907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a79e6dde600c63f69a5477d1e9f422", "srcset": "https://si.imgix.net/eaaa4a81/uploads/origins/a832dbae-6cc6-46ae-bab3-db655e50c907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a79e6dde600c63f69a5477d1e9f422, https://si.imgix.net/eaaa4a81/uploads/origins/a832dbae-6cc6-46ae-bab3-db655e50c907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1e5cdf3ea3432ab8bf2553d1503fb40 2x, https://si.imgix.net/eaaa4a81/uploads/origins/a832dbae-6cc6-46ae-bab3-db655e50c907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce5e7c10723e6c55868347c2ecf2163f 3x"}, "body": "こんにちは、\n\nあなたの作品がとても気に入っています。Skebを始めたという投稿も今見ました！\nもしよろしければ、私のキャラクターのイラストを描いていただけないでしょうか？\n\n彼女はかなり明るく気さくで、ちょっといたずら好きかもしれません。音楽とギターが大好きなんです！\nそれ以外では、普段はサポート役を好む傾向があります（特に戦術をテーマにした作品の中では）。\n\nテーマや衣装（衣装は参考画像通りにする必要はありません）、ポーズなどは、お好きなものや、そのキャラクターに合いそうだとお考えのもの、あるいは描いていて楽しそうなものなど、自由に選んでください。新しい衣装のデザインも大歓迎です！\n\nキャラクターの参考画像／過去の作品：\nhttps://drive.google.com/drive/folders/1W82ZBeEXTXJy-37leGWmt55WmlhW5hTf?usp=sharing\n\nご依頼をご検討いただきありがとうございます ^~^", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_ebuna/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3551960, "client_id": 3432950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c73b52ee/uploads/origins/961931a6-6f82-43a6-8c13-1b21ec1101a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=838f682e15b68c9c2c8958d795b54a7e", "srcset": "https://si.imgix.net/c73b52ee/uploads