毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でえぶな様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、他はどうかご自由にお願いします。\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1162495, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まなもこ🐟➰🍌", "screen_name": "m_fancys", "avatar_url": "https://pbs.twimg.com/profile_images/1761750197036830720/R-S0T9I4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/817568651393974273/1708868965/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2021706, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "叶望かなと", "screen_name": "kanato_345", "avatar_url": "https://pbs.twimg.com/profile_images/2058842772522840064/7nokBuxL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1325033498143412225/1705137423/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 16}, {"id": 2944300, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "晩ノ", "screen_name": "LAFU_OSONO", "avatar_url": "https://pbs.twimg.com/profile_images/1922238241648082947/xa--TRzv.jpg", "header_url": "