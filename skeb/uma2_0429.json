-bd21-e4f0c96a6ff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eecb0f09980544ff86e26bb9b4da641c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7603b63e/uploads/origins/89cad3e7-4141-4939-bd21-e4f0c96a6ff9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffd25dafa99b438754cf81bf12ca7b17", "src_set": ""}, "body": "あなたのジャングルポケット(ウマ娘)を見てみたいです。自由に描いてくださってかまいません。よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma2_0429/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3331781, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f35cb9a/uploads/origins/9c7f5b8a-4cf4-41fd-8a95-f1e6cb63a4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67788398f614284c9ed4ee96fba08676", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f35cb9a/uploads/origins/9c7f5b8a-4cf4-41fd-8a95-f1e6cb63a4ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b58510ede03ebb4769dee7d5abc2a4e", "src_set": ""}, "body": "こんにちは！あなたのウマ娘作品が大好きです！私のオリジナルキャラクターをドリームジャーニーのトレーナーとして描いてください！身長差はありますが、怖さは同じです！あなたのビジョンを信じて、気長に待ちます！\n\nhttps://imgur.com/a/l9uvd8I\n\nhttps://umamusume.fandom.com/wiki/Dream_Journey", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma2_0429/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3331781, "client_id": 3551626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04542454/uploads/origins/d39a3f54-492c-45c7-9dc3-b0062f187806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54865262f217100c5af4264eb6d249bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04542454/uploads/origins/d39a3f54-492c-45c7-9dc3-b0062f187806?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d7effe9cb1cf6bae643aa8a3cdf06be", "src_set": ""}, "body": "ねえ、こんにちは、私はあなたの作品が好きです。私もあなたに絵を描いてもらいたいキャラクターがいます。彼の側面を描きます。そして、彼の形は横を向いて、激しく後ろを軽蔑的に見ています。できれば、私は彼の髪型を前の前髪に変えて眉毛を覆います。もちろん、髪型も変えないこともできます。私の要求を受け入れてください。ありがとうございます。\nまた、私が欲しい感じの写真も入れました。参考にしてください。\n\nhttps://drive.google.com/drive/folders/1bkTSOxD-oQpOCNARfhhNXf0RE9OdQwC-", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma2_0429/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3331781, "client_id": 3515914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e51ae1d8/uploads/origins/60cc4e69-be70-4a5c-ad62-daaf6339d576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cbaf8ea2bd6cc742b0707b662f050ef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e51ae1d8/uploads/origins/60cc4e69-be70-4a5c-ad62-daaf6339d576?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8744f667e62b8e48b3f5ed8acb92726", "src_set": ""}, "body": "こんにちは！このノワールというキャラクターの依頼をお願いしたいのですが。彼女の参考画像には、彼女の詳細がたくさん描かれていますが、彼女の絵に描かれている詳細のいくつかは、そこに書かれている言葉を優先するために無視されるべきです。具体的なお願いがあるのですが、2枚目の参考画像によく似たノワールの絵を、マギア・バイザーの衣装なしで描いていただけませんか？同じポーズと表情で、あなた自身のスタイルで。また、無理なお願いなのですが、参考画像と同じ表情のノワールと、口を開けずに唇を噛んでいるノワールの2種類を作っていただけませんか？よろしくお願いします！ https://imgur.com/a/uWezxea https://imgur.com/a/81qBqSb", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uma2_0429/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "