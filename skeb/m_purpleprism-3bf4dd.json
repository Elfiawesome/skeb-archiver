k）での利用。\nグッズ販売等の商用利用。\n※使用不可の項目がございましたらレイヤーでご教授いただけますと幸いです。\n\n●形式\nキャラとレイヤーを分けた形式でいただけると大変ありがたいです。\nデータはPSDデータまたはPNGデータでお願いしたいです。\nサムネイルで使用する場合がございますため、キャンバスから見切れないようにしていただけると大変ありがたいです。\n\nぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nhyqLLUvR262SPDGxgUrcPwRjAD6Fwk6", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m_purpleprism/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3151209, "client_id": 3370600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e63c6171/uploads/origins/143819f3-11fd-4d11-b829-8a46eb4d2d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d578ec3a6482b7e246a7f1b19ec133", "srcset": "https://si.imgix.net/e63c6171/uploads/origins/143819f3-11fd-4d11-b829-8a46eb4d2d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5d578ec3a6482b7e246a7f1b19ec133, https://si.imgix.net/e63c6171/uploads/origins/143819f3-11fd-4d11-b829-8a46eb4d2d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b8ce2882f3321bca5050d488ea183ab 2x, https://si.imgix.net/e63c6171/uploads/origins/143819f3-11fd-4d11-b829-8a46eb4d2d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cce1b3026611e8ea7445a5c1a0d4e718 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e63c6171/uploads/origins/143819f3-11fd-4d11-b829-8a46eb4d2d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=174af4f7b3f2fd2d00fc41f3852e844c", "srcset": "https://si.imgix.net/e63c6171/uploads/origins/143819f3-11fd-4d11-b829-8a46eb4d2d8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=174af4f7b3f2fd2d00fc41f3852e844c, https://si.imgix.net/e63c6171/uploads/origins/143819f3-11fd-4d11-b829-8a46eb4d2d8a?bg=%23fff&auto=format%2Ccomp