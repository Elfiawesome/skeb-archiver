ix.net/6a933233/uploads/origins/1ba1b23a-8f4e-4f79-9538-74779346f2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fe03dfede4c68875a0dc160dd647404", "srcset": "https://si.imgix.net/6a933233/uploads/origins/1ba1b23a-8f4e-4f79-9538-74779346f2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fe03dfede4c68875a0dc160dd647404, https://si.imgix.net/6a933233/uploads/origins/1ba1b23a-8f4e-4f79-9538-74779346f2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=585068c18e551e1c788431d5371820db 2x, https://si.imgix.net/6a933233/uploads/origins/1ba1b23a-8f4e-4f79-9538-74779346f2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=89d4200b4118387a7efced371f340088 3x"}, "body": "着丈が胸のあたりまでしかない胸元が大胆に開いた襟付きノースリーブに超ミニスカート、膝下丈の黒のハイソックスのコーデで、手足を緊縛され横向きに寝かされた鈴木羽那さんのイラストを全身でお願いしたいです。\n\n構図は\n・こちらと同じ感じ（https://www.pixiv.net/artworks/69621787）でお願いします。\n・ふとももと脚が好きなので、なるべくふとももと脚全体が映えるように描いてほしいです。構図のURLと同じように、両脚は揃えてふとももは前面と側面が見える感じでお願いします。\n・脚とふとももは可能でしたら美脚で股下高めで足が長く見えるようにしてほしいです。\n・背景は無しか、単色のシンプルなもので良いです。\n\n服装は\n・襟付きのノースリーブは肩を完全に出し、袖口にフリルなどがないシンプルなデザイン。色は黒でお願いします。襟はポロシャツやブラウスと同じ感じでお願いします。袖口はかなり広めで、ホルターネックと同じくらいのサイズで腋と肩ががっつり見えるようにして下さい。着丈はセーラーミズギと同じくらいかなり短い丈で、胸の辺りしか覆わないくらいでお願いします。胸元は谷間が下の方までガッチリ見えるくらい大胆に開けて欲しいです。\n・スカートは股下がほとんどないギリギリの超ミニ丈にしてほしいです。スカートの着丈も短めで、ウエストの横幅より着丈の方が短くなるようにしてほしいです。プリーツスカートで、タイト系は避けてください。色は黒系でお願いします。\n・ハイソックスは黒一色の透けないタイプで、膝下を完全に覆う丈でお願いします。\n・靴は無し。\n・スパッツ、インナーパンツ等は無し。\n・ふとももは生脚。\n・ガーターリング等ふとももの装具や、ふとももにかかるアクセサリーなどはなし。\n・髪型は初期Rのカードと同じで結んだりせず、下ろした髪型でお願いします。\n・ハイソックスの色は必ず黒でお願いしたいですが、トップスとスカートの色は黒以外でも大丈夫です。\n\n縛り方ですが\n・後ろ手に胸の上下を縛り、脚は両足首のみを縛り、ふとももや膝の上下などは縛らない。\n・ロープなど、細い紐状のもので縛ってほしいです。縛り方は縄の太さはこちら（https://www.pixiv.net/artworks/92020264）と同じで、ひざ上を縛っている縄がない状態でお願いします。\n・猿轡や目隠しなどは無しで、目と口は見えるようにしてほしいです。\n・胸の下の縄で腕と体の間にある縦の縄、両足の間に縦に入っている縄は省略しないでいただきたいです。\n\n表情は\nもう、こういうのが好きなの？と笑顔で顔を赤らめドキドキしている感じでお願いしたいです。\n\n指定が多く恐縮ですが、検討して頂けると幸いです。よろしくお願いいたします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hisamishiny/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1645623, "client_id": 3446945, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=097c11679de5accf8a5fdfe1d4f18ba2", "srcset": "https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=097c11679de5accf8a5fdfe1d4f18ba2, https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4697637c0527d309377285de6a2b2bfa 2x, https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bc5bb27978ce3bd35c8b5232568091a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4444c120dd0a89c04ad4088d4f6785e5", "srcset": "https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4444c120dd0a89c04ad4088d4f6785e5, https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a5b0a8dae29a68010b5cf22252789761 2x, https://si.imgix.net/50f8892e/uploads/origins/c95fc967-e673-48af-850e-31617b353c06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=439