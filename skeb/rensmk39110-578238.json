※身長は140cmです。\n\n\n【使用用途】\nTwitterへの掲載、アイコンとしての使用、YouTube活動におけるサムネなどを考えております。\nまた、サムネ等へ使用できるように背景透過のデータ(psdファイルなど)もいただきたいです\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14O3evcYwc7AewEPeyJwDsgUNS6QXiSCx?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rensmk39110/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2161472, "client_id": 1615271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0a592817/uploads/origins/6ae75542-e217-42de-983c-4830a2afa6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6e77c5096cb541c8905dff5960e158", "srcset": "https://si.imgix.net/0a592817/uploads/origins/6ae75542-e217-42de-983c-4830a2afa6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f6e77c5096cb541c8905dff5960e158, https://si.imgix.net/0a592817/uploads/origins/6ae75542-e217-42de-983c-4830a2afa6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=391d317e6f2aa9203abe641887768671 2x, https://si.imgix.net/0a592817/uploads/origins/6ae75542-e217-42de-983c-4830a2afa6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34b23d0ac0f0cb07aeec4acab93eeecc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a592817/uploads/origins/6ae75542-e217-42de-983c-4830a2afa6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5be0230cf1bf3dfda7b33922ede40399", "srcset": "https://si.imgix.net/0a592817/uploads/origins/6ae75542-e217-42de-983c-4830a2afa6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5be0230cf1bf3dfda7b33922ede40399, https://si.imgix.net/0a592817/uploads/origins/6ae75542-e217-42de-983c-4830a2afa6e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&