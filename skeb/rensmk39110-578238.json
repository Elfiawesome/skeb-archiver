f-439e-b6b1-9d0e35cd46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94044f194f8f2753232b57794a837711", "srcset": "https://si.imgix.net/15dfbb22/uploads/origins/4188124f-dd6f-439e-b6b1-9d0e35cd46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94044f194f8f2753232b57794a837711, https://si.imgix.net/15dfbb22/uploads/origins/4188124f-dd6f-439e-b6b1-9d0e35cd46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=744fee4c5502aa8e0bf7d49e4761e02a 2x, https://si.imgix.net/15dfbb22/uploads/origins/4188124f-dd6f-439e-b6b1-9d0e35cd46a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb1b24fab614c36a75af4bd73534625 3x"}, "body": "はじめましてこんにちは！\nVTuberをやっております、卯花柚希と申します。\n\nお風呂に入っている柚希を描いていただけないでしょうか？\nお風呂は泡風呂(もしくはにごり湯)で肩まで浸かり、お湯にはピンクのアヒルの人形を浮かべてください。\n可能であればアヒル無し差分もお願いします。\nその他髪型や装飾等はおまかせ致します。\nサムネイル使用の関係上、上下左右が切れないようお願いします。\n\n卯花柚希資料(うさぎの髪留めは外さないようお願いします)\nhttps://drive.google.com/file/d/1IVbMGEB8P8m4jSyupI7NJB-PblgIGu86/view?usp=drivesdk\n\n利用用途(作者明記の上)\nTwitterにてFAとしての紹介\nYouTube等のサムネイル画像や宣伝画像等活動用としての使用\n\n納品形式\nPSDの場合、人物と背景(出来れば小物)のレイヤー分けをお願いします。\nPNGの場合、背景透過人物画像も別にお願い致します。\n\nご検討いただけますと幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rensmk39110/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2161472, "client_id": 2092141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44aaed90/uploads/origins/ffc8960f-fe49-488a-9fc2-9cc0307aebf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be0394716452123cf9ceb820f4d63b33", "srcset": "https://si.imgix.net/44aaed90/uploads/origins/ffc8960f-fe49-488a-9fc2-9cc0307aebf4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be0394716452123cf9ceb820f4d63b33, https://si.imgix.net/44aaed90/uploads/origin