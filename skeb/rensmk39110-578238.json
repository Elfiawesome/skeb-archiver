10b13cc150da2c38eacb8b 2x, https://si.imgix.net/a689c4fb/uploads/origins/89186bdf-74cd-4d3f-acf8-f7b48259c39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dee3f61c3f974e7fcb1ef6a28fb71f97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a689c4fb/uploads/origins/89186bdf-74cd-4d3f-acf8-f7b48259c39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78c3d86f408c92c0518f8f612e9b0361", "srcset": "https://si.imgix.net/a689c4fb/uploads/origins/89186bdf-74cd-4d3f-acf8-f7b48259c39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78c3d86f408c92c0518f8f612e9b0361, https://si.imgix.net/a689c4fb/uploads/origins/89186bdf-74cd-4d3f-acf8-f7b48259c39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f32622a04abe8278505b5dd4d3aa355 2x, https://si.imgix.net/a689c4fb/uploads/origins/89186bdf-74cd-4d3f-acf8-f7b48259c39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b08b47abbe9de8434a180ea3a310084 3x"}, "body": "蓮様\n\nはじめまして。\n現在『SHOWROOM』にて活動しております。\n來豆夢生(こまめめい)と申します。\n\nぜひ蓮様に私を描いていただきたいなと思い、今回リクエストさせていただきました。\n\n\n【リクエスト】\n・私を描いていただきたいです。\n・ポーズや表情などは蓮様におまかせします。\n・可愛らしい雰囲気でお願いしたいです。\n・犬耳の先や髪の毛など、見切れないようにレイヤー内に収めていただけるとありがたいです。\n\n【使用用途】\n・SHOWROOMやYoutubeなどのサムネイルや配信画像に使用(SHOWROOMは収益化済)\n・Xや他SNSで使用\n・スケジュール表やアイコン、ヘッダー等に使用\n・ネットプリントや壁紙などに使用\n\n【納品形式】\n・人物透過PNGまたは、人物と背景を分けたPSDでいただけると大変助かります。\n\n\nお忙しい中大変恐縮ですが、ご検討いただけると嬉しいです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1TNLyDiIfsL-0mpxHpi8US54HWcL8TZp1/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rensmk39110/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2161472, "client_id": 1615271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si