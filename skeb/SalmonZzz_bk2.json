875268?s=21\n\n・着衣(胸の鍵穴と髪飾りは特に重要)\n・無数の手によってムリヤリ押さえつけられて、両脚をM字開脚のようにひらかされている\n・衣装の胸のところをずらされておっぱい丸見え\n・下着(薄いピンク色)を強引に横ずらしされている\n・無数の手によって、身体中を愛撫されている\n・両穴がよく見えるアングルで、それぞれ指を挿入されている\n・絶頂潮吹き\n・責めに耐えられず身体を退け反らせている\n\n・陰毛NG\n・破瓜表現NG\n・精液表現(ぶっかけとか)NG\n・胸と太ももを盛らないようにお願いします\n・ウエストの細さ(くびれ)を意識してください\n・瞳の中にハートを描く表現NG\n・責め手の描写は手だけ(いわゆる紳士ハンド)でOKです\n\n以下は可能なら入れて欲しいモノ\n・目を瞑っている表情差分\n・あんあん喘ぐティナの嬌声と、あちこち撫でられたり胸や両穴を責められている擬音 \n・失禁差分\n\n以上です、よろしくお願いします\n\nhttps://twitter.com/xdh3knifepbwtpl/status/1491710957642338307?s=21&t=PwCmEzFNOoAA5bv_XWMmzA", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SalmonZzz_bk2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1307438, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/160aba6c/uploads/origins/7cc7befb-a93a-4816-bdc4-24ee2081f15e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a894af935137d1c7d969292011ff77", "srcset": "https://si.imgix.net/160aba6c/uploads/origins/7cc7befb-a93a-4816-bdc4-24ee2081f15e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99a894af935137d1c7d969292011ff77, https://si.imgix.net/160aba6c/uploads/origins/7cc7befb-a93a-4816-bdc4-24ee2081f15e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=00835bd9c0ff96904ca278e0df9b415b 2x, https://si.imgix.net/160aba6c/uploads/origins/7cc7befb-a93a-4816-bdc4-24ee2081f15e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec02a0fd68dc10ba35a22a232d3cc89d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/160aba6c/uploads/origins/7cc7befb-a93a-4816-bdc4-24ee2081f15e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3ddb5254301393e8812c0330e22c946", "srcset": "https://si.imgix.net/160aba6c/uploads/origins/7cc7befb-a93a-4816-bdc4-24ee2081