x.png\nhttps://files.catbox.moe/5t2toy.png\nhttps://files.catbox.moe/tzjc1k.webp\nhttps://files.catbox.moe/aautcr.webp\n\nThank you very much!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bakusyouryu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 704552, "client_id": 1172470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20357e07/uploads/origins/f76bc678-c78d-446a-a18e-3ff6c3e0f58c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d93f7644a03b1fe497288236d34e0b91", "srcset": "https://si.imgix.net/20357e07/uploads/origins/f76bc678-c78d-446a-a18e-3ff6c3e0f58c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d93f7644a03b1fe497288236d34e0b91, https://si.imgix.net/20357e07/uploads/origins/f76bc678-c78d-446a-a18e-3ff6c3e0f58c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be18413d5c95d726a342df654d0bb9b2 2x, https://si.imgix.net/20357e07/uploads/origins/f76bc678-c78d-446a-a18e-3ff6c3e0f58c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ba6aed60bc8217b2cad38e44cc6560c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20357e07/uploads/origins/f76bc678-c78d-446a-a18e-3ff6c3e0f58c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99da55f16e3fa175a2615f6ff6ff4cac", "srcset": "https://si.imgix.net/20357e07/uploads/origins/f76bc678-c78d-446a-a18e-3ff6c3e0f58c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99da55f16e3fa175a2615f6ff6ff4cac, https://si.imgix.net/20357e07/uploads/origins/f76bc678-c78d-446a-a18e-3ff6c3e0f58c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8036e401b2d135e6bf14cdbe05e429d9 2x, https://si.imgix.net/20357e07/uploads/origins