35d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eda3edc67ff4d2abbd6341ac32934b3", "srcset": "https://si.imgix.net/26270ab1/uploads/origins/1a195485-c906-4ce2-b0bd-f60eeea7835d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eda3edc67ff4d2abbd6341ac32934b3, https://si.imgix.net/26270ab1/uploads/origins/1a195485-c906-4ce2-b0bd-f60eeea7835d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c430b8a107b2d261be3b7a7b2f1dcea6 2x, https://si.imgix.net/26270ab1/uploads/origins/1a195485-c906-4ce2-b0bd-f60eeea7835d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=460b1bcf73ca65bf584bd0851d6b649e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26270ab1/uploads/origins/1a195485-c906-4ce2-b0bd-f60eeea7835d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c407fe5d654d1cc2ab381d85101346d", "srcset": "https://si.imgix.net/26270ab1/uploads/origins/1a195485-c906-4ce2-b0bd-f60eeea7835d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c407fe5d654d1cc2ab381d85101346d, https://si.imgix.net/26270ab1/uploads/origins/1a195485-c906-4ce2-b0bd-f60eeea7835d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9df4d1c2fb28073e2186fe9dd034abc5 2x, https://si.imgix.net/26270ab1/uploads/origins/1a195485-c906-4ce2-b0bd-f60eeea7835d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=407456df5ef318cdcfad4f3036be124f 3x"}, "body": "先生がSkebを始められたと伺いましたので、\n依頼させて頂きます。\n\nキャラクター：ドラゴンクエストⅢの女勇者\n\n構図：立ち絵(全身)\n\n背景：無し\n\n衣装：ビキニアーマー(青色)\n\n小物：首輪・剣・マント\n\n詳細\n構図は、ゲーム等で良く見かけます全身立ち絵でお願いします。\nイメージとしては、男として育てられていた感じです。\n髪は短髪の青みが入った黒色でお願いします。\n衣装は、青色のビキニアーマーで、肌の露出が多めでお願いします。\n特に胸は、先生の普段書かれている限界以上の大きさでアーマーの紐部分が\n胸に食い込んでいる感じで、お願いできましたら幸いです。\n小物として首輪・剣・マントをお願いします。\n後、表情は普通の表情と照れ顔と蕩け顔の3種類頂けたら有難いです。\n\n拙い文面で恐縮ですが、ご承認いただけます様、宜しくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mogudan555/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1854302, "client_id": 67802, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d77a1ee71a63ba7da5f72d3e5a20ffae", "srcset": "https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d77a1ee71a63ba7da5f72d3e5a20ffae, https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da6fc4e1b90c94589cb14056a35c65ed 2x, https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06ba9e45a8764c2a6f098e37b2e05764 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=637eed9de3e4eb986c53e05ce8baf213", "srcset": "https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=637eed9de3e4eb986c53e05ce8baf213, https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f012607a6fdd379c9265245e511154e 2x, https://si.imgix.net/2047711a/uploads/origins/846c6b19-3625-40c7-9ffe-d30b288a17b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38427f9adb2383d8bb3f552612cda64f 3x"}, "body": "※Translatorを使うのでぎこちないかもしれません。\n\nおはようございます\n海外のファンです。\n\nこうやって作家さんに申請することになって\n嬉しいです\n\n作家さんにDog DaysのYukikaze Panettoneをお願いしたいです。\n\n服装 :\nhttps://i1.ruliweb.com/img/22/02/26/17f33db8d1f83374.jpg\n作家さんが担当していた\nScrapped Princessの\n「ラクウェル」の服装でお願いします。\nただし、若干のデザイン変更をお願いします\nマントと袖がなくて脇が\n表れる服装でお願いします\n\n姿勢 :\nhttps://i1.ruliweb.com/img/21/10/23/17cac19b1b983374.jpg\nhttps://i2.ruliweb.com/img/21/10/05/17c4f45cf4c83374.jpg\n\nこれに類する姿勢で\n髪を整理する感じで\n脇、横の胸、ヒップ、太ももが\nよく見える姿勢であってほしいです。\n\n靴なしで足の指も見えたらいいですね。\n\n※巨乳, 陥没乳頭でお願いします\n\n※汗に濡れて熱気が上がってくる姿であれば良いですね。\n\n※可能でしたら\n脱衣バージョンと共に\n陥没乳頭と勃起した乳頭バージョンもお願いします。\n\n※表情や背景などは作家さんにお任せします。\n\nきれいなイラストを期待します\nそして、ごめんね。来月の私！", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mogudan555/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1854302, "client_id": 2070545, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7828cc76/uploads/origins/3aac601b-18e9-41d9-9e83-84b0b937da95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cf7bffd8c878aa5cc2cfd07293326a4", "srcset": "https://si.imgix.net/7828cc76/uploads/origins/3aac601b-18e9-41d9-9e83-84b0b937da95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cf7bffd8c878aa5cc2cfd07293326a4, https://si.imgix.net/7828cc76/uploads/origins/3aac601b-18e9-41d9-9e83-84b0b937da95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11e2a601986a9e440f151edc366be943 2x, https://si.imgix.net/7828cc76/uploads/origins/3aac601b-18e9-41d9-9e83-84b0b937da95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e6a676087bbc8e26e9c83a7293734fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7828cc76/uploads/origins/3aac601b-18e9-41d9-9e83-84b0b9