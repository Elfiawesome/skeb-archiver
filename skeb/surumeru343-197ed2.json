61-84f0-c6eec2352304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a4516cc76a44a90243d741a2c4bb900", "srcset": "https://si.imgix.net/474c5a3d/uploads/origins/5947be65-b14b-4361-84f0-c6eec2352304?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a4516cc76a44a90243d741a2c4bb900, https://si.imgix.net/474c5a3d/uploads/origins/5947be65-b14b-4361-84f0-c6eec2352304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6dccb7b96cd560724dbd7697c8f95e4f 2x, https://si.imgix.net/474c5a3d/uploads/origins/5947be65-b14b-4361-84f0-c6eec2352304?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a757e6e183979da587f2511b19bbff6 3x"}, "body": "初めまして。\n可愛くておいしそうな複乳娘達が気に入りましたので\nリクエストさせていただきます。\n\nショタっ子が6つの複乳を持つスライム娘のおっぱいに埋もれて\nぱふぱふしてるシチュをお願いします。\nスライム娘の複乳は爆乳クラスを希望で、ショタっ子の上半身がおっぱいの中にすっぽり入るほど大きさ。\nショタっ子は上乳の間に顔を埋めて左右から手で揉みながら\n顔を圧迫してる感じにしていただけると嬉しいです。\n（体の大きさは自由に変えていただいてもOKです）\n\nこちらに一例となる資料を載せておきますので\nよろしくお願いします。\n\nスライム娘・ぱふぱふイメージ\nhttps://mega.nz/file/pIZnkSCS#wSxBGYAeALesTiXEDDlSJNqp2XvfvzMD2bd6wAEoQxc\n\n複乳ぱふぱふイメージ\nhttps://mega.nz/file/BMx1ga4I#M0YnyRjuHc8jPgme42nfnkeEePvR2BtWJ8uaF5-RHs0", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@surumeru343/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1834394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8892cb57/uploads/origins/4d39d3fd-77dd-46ae-86cc-9fee1f62d6d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e5417b89f416f09ece5781d0f5495a4", "srcset": "https://si.imgix.net/8892cb57/uploads/origins/4d39d3fd-77dd-46ae-86cc-9fee1f62d6d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e5417b89f416f09ece5781d0f5495a4, https://si.imgix.net/8892cb57/uploads/origins/4d39d3fd-77dd-46ae-86cc-9fee1f62d6d1?bg=%23fff