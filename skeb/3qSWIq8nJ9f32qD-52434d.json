t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8ad1f512cf034810dec0936e0611bf5, https://si.imgix.net/14b396e3/uploads/origins/c5cf705b-26d3-4163-852f-1511aa3eac28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc9682c107f65e299d3755553e70210b 2x, https://si.imgix.net/14b396e3/uploads/origins/c5cf705b-26d3-4163-852f-1511aa3eac28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9f36308cd5c330f58266af42c29618d9 3x"}, "body": "アーボックに巻きつかれているアズールレーンの睦月と如月をお願いします。\n流れでは\n①目の前にアーボックが現れるが、睦月は「おっきい蛇さんだ～」と危機感はないが、如月は危ないよ～と危機感をもつ\n②巻き付かれて始める。睦月はすごーいみたいな感じで抵抗しないが、如月は慌てて逃げようとするがそのまま巻き付かれ始める\n③巻き付きが完了し、睦月は？という感じで、如月はどうしようみたいな感じの表情をし抵抗するが逃げ出せない\n④締め付けが開始され、二人とも苦しむ\n⑤しばらくし、二人とも苦しいが締め付けが快感になってしまう\nをベースに、シーンの追加や変更などはお任せします。\nただし、睦月と如月は別々のアーボックに巻き付かれている設定でお願いします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3qSWIq8nJ9f32qD/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729108, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5db317b0d03dcd452f0e8f5dba3e03ca", "srcset": "https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5db317b0d03dcd452f0e8f5dba3e03ca, https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb5f160dea4cb4770068c9dbd59e5160 2x, https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14a016db81b205a117b4045158e009ff 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f6863549094e90a4c5885691aa2596a", "srcset": "https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f6863549094e90a4c5885691aa2596a, https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac974edf60ffb3e8b969a748de27a3aa 2x, https://si.imgix.net/f829edbd/uploads/origins/8ba8eac8-9fc1-4c13-b9ab-076b9e47076a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59a6557c531702bbc4feae783246eece 3x"}, "body": "今回もアーボック時津風をお願いします。\n\n寒くて運動不足を感じた時津風が、アーボックにポケモンバトルみたいに勝負してほしいとお願いし勝負を始めたが、アーボックのほうが素早さが高く、まきつく攻撃を受けたという設定でお願いします。\n\nシーンや表情ですが\n①「巻き付かれちゃった・・・でもこっちも攻撃を・・・」と時津風は苦しみながらも反撃しようとする。\n②しかし攻撃ができず「あれ？攻撃できない・・・？」と時津風は混乱している。\n③「もしかして・・・初代のまきつく攻撃・・・！？」と時津風は気が付き、逃げようと抵抗するがアーボックの攻撃は続いている。\n④アーボックの攻撃が終わり、締め付けがなくなり（身体は拘束されている）「やっと終わった・・・今度はこっちが・・・！」と時津風は苦しみながら攻撃しようとする。\n⑤再度アーボックのまきつく攻撃が始まり、時津風は勝てない事を察し「ごめん！私も負けでいいから許して！」と攻撃をやめるようにお願いする。\n⑥しかしアーボックの攻撃をやめず、何回もまきつく攻撃を繰り返し、時津風は体力がつきる寸前で弱い呼吸ながらも必死に息をしている。\n\n今回⑥のみ目を閉じ、それ以外は開いて下さい。\n\n構図はバトルという事で巻き付き具合や構図は先生が好きなようにお願いします。悩んだ場合は今までのように3～4巻でお願いします。\n又、今回差分が大丈夫でしたら先生が好きな構図でしたら巻きつかれている箇所の追加を、今までと同じ構図でしたら尻尾差分をお願いします。\nその他、できればアーボックの色違いもお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3qSWIq8nJ9f32qD/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729108, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bc1dcb234da58f5e0e3ec4df0aaef68", "srcset": "https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bc1dcb234da58f5e0e3ec4df0aaef68, https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c18be3f21c643d2cdd89b3d653c8c888 2x, https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e34e1b4ab861f405b7b0f4ed7ecf245e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23bd16a96e3936ff800ee517bd2f8226", "srcset": "https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23bd16a96e3936ff800ee517bd2f8226, https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=111223693449b2d00f757d0537c09bae 2x, https://si.imgix.net/b3d1ebd4/uploads/origins/a988e3d0-c61d-405a-af90-cd639524f5a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e5d0ebfdc0343e51d6766e7b38af61b 3x"}, "body": "今回もアーボックと時津風をお願いします。\n\n蛇年という事で蛇の捕食動画を見た時津風がアーボックに対し、獲物を捕らえているように巻き付いて欲しい事、巻き付かれたら全力で抵抗するから本気で締め付けてほしいとお願いし、襲われている設定でお願いします。\n\n今回の構図ですが、襲われているという設定ですのでいつものような3～4巻などの指定はなく、先生が好きなように（倒されている・乱雑に巻き付かれて時津風の腕などは出ている・時津風が暴れていた為一部部分しか巻き付けていないなどお任せします）描いて下さい（ただし、できればアーボックは口を閉じて、舌を出している感じでお願いします）。構図に迷うようでしたらいつものような構図（隙間なく3～4巻で、アーボックの頭は時津風の頭の上に、口を閉じて舌を出す）でお願いします。\n\n時津風の表情などですが\n①いつもと違いアーボックも獲物を捕らえるように全力で襲っているため、暴れて抵抗している。\n②しかし、息を吐いたと同時に締め付けが強くなり、苦しむ。\n③息を吸おうとしても締め付けが強くうまく吸えずに苦しむ。\n④時津風の呼吸にあわせ、アーボックの力も強くなっていき、抵抗する力がほぼなくなる。\n⑤「ああ、いつもは手加減してくれていたんだ・・・。でも、本気で相手してくれてありがとう・・・」と青ざめ、息を引き取るように力尽きる。\n⑥アーボックも流石にやりすぎた！と思い力を弱める。時津風は無事であり、苦しかったが安堵したような表情でゆっくり呼吸をしている。\n①④は目を開け、②③⑤⑥は目を閉じて下さい。\n\n差分ですが、乱雑で隙間があるようでしたら巻き付きを追加する形で、隙間なく巻き付けている場合は首への締め付けも追加でお願いします。又、今回もアーボックの色違いもお願いします。\n差分などは先生のご負担のないように、構図や表情等はあくまでベースですので、先生が描きやすいように変更や追加などして下さい。\n\n今回もご検討をお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3qSWIq8nJ9f32qD/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729108, "client_id": 1195469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f050a18eb94885057f543b3c948f1d", "srcset": "https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80f050a18eb94885057f543b3c948f1d, https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=497b40d1ff2447437ca408ba9174ae2d 2x, https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3af49bcc9903b38a23eb3f1877c246b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56e7487538503f2015db1dddb0f2bf0c", "srcset": "https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56e7487538503f2015db1dddb0f2bf0c, https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d97a5ade358ab6e156d35b4e5b4efae9 2x, https://si.imgix.net/af927dbb/uploads/origins/5bd36415-cd4e-4600-b03c-451eda34a9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91b58c801624aeb459ccf18169d22fef 3x"}, "body": "ご無沙汰しております。以下の通りリクエストさせていただきます。\nキャラ　「ぴちぴちピッチ」の七海るちあ(人魚の姿)\nシチュ　アニメ「ピュア」7話に登場した海蛇に締め付けられている\n全体的には、私が過去に描いた以下2作品のどちらかお好きな方をリメイクする形で仕上げてください。(効果音やセリフはお任せします)\nhttps://www.pixiv.net/artworks/105349054\nhttps://www.pixiv.net/artworks/106514802\nまた、該当シーンを紹介しているサイトのリンクを添付しますので参考になさってください(海中なので画面全体が青みがかっていますが、今回は自然な色合いでお願いします)\nhttp://blog.livedoor.jp/ryonamoon/archives/1060558496.html\n楽しみにしています。よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3qSWIq8nJ9f32qD/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d22ac5b3cd4347b8dd960d4f56583b0", "srcset": "https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d22ac5b3cd4347b8dd960d4f56583b0, https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b74a8a7abc221924d3b3db0cced2476b 2x, https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf40a5ad0cb277c55b2ea19bba211781 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f913a1dbc3f3a0e30f90b4e94055f514", "srcset": "https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f913a1dbc3f3a0e30f90b4e94055f514, https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b027e3fb90251c381db02459b9612d0 2x, https://si.imgix.net/f70e3712/uploads/origins/9212fe73-0165-46ca-89f8-f7d5c143e813?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cfb645f6a87f45689a423d81f166b72d 3x"}, "body": "アーボックに巻き付かれているアズールレーンの吹雪をお願いします。\n\nアーボックの締め付けがとても強く、とても気持ち良いという噂を聞いた吹雪がアーボックに巻き付いてもらっている設定です。\n\n構図は３〜４巻で全体を隙間なく巻き付け、吹雪の頭の上から口を閉じて下を出してください。よろしければ尻尾で首を締め付けていたり、色違いのもお願いします。\n\n吹雪の表情は\n①全身をまきつかれて「おー」と初めての体験に少し驚いている。\n②しかし、締め付けが思ったより強くなく「なーんだ！強くなくてぷにぷにして気持ちいいじゃん！」と満面の笑みを見せる（吹雪は煽ってるつもりはない）\n③しかし、アーボックの締め付けが開始。急な締め付けに「ちょっとまって！」と慌てる吹雪。\n④息ができなくて「く、苦しい・・・！」と苦しむ。\n⑤アーボックの締め付けは弱まる事がなく、吹雪は泣きながら「ごめんなさい・・・！」と謝るが現状は変わらない。\n⑥締め付けは長く続き、吹雪の目からハイライトが消え「いつまで続くんだろうなあ・・・」という感じでぼーっとしている。\n\n①⑤⑥は目を開け、②③④は目を閉じて頂きたいのですが、②の笑顔は目を開けた方が書きやすいようでしたら開けても大丈夫です。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3qSWIq8nJ9f32qD/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c125a966466bcaf75c263f01c5b385b4", "srcset": "https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c125a966466bcaf75c263f01c5b385b4, https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28a64e27465260b64b523c2ada597c71 2x, https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4057152928fdef9a77963a20d6483450 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4afc40ac0fc9d7c3b9d9ceb8efb0ee67", "srcset": "https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4afc40ac0fc9d7c3b9d9ceb8efb0ee67, https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3646869028fb30e2302bab02dc8801d 2x, https://si.imgix.net/82a651aa/uploads/origins/32eedbc9-5296-40bd-89d9-7100c7604d41?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e113f10718254c9f693da5cd19e5bf5 3x"}, "body": "アーボック時津風のような感じで「アズールレーン」の陸奥をお願いできませんか？\n以降、デビラさんの文章を使わせて頂いております。\n\nアーボックは陸奥の首から下を４巻程で隙間なく巻き付け、陸奥の頭の上に頭を乗せ鼻の付近まで舌を出して下さい。口は閉じて下さい。\n全身巻き付かれている事を強調する為、陸奥の全身（しつこくて申し訳ございませんが首から下は足も見えないぐらい隙間なく全身巻き付けて下さい）を描いて頂けるとうれしいです。\n又、できればアーボックは通常色と色違いをお願いします。\n又、さらに大丈夫ならアーボックの尻尾で首を巻き付けているパターンと巻き付けていないパターン(どちらかでしたら巻き付けていないパターン)をお願いします。\n\n陸奥の表情ですが、大丈夫でしたら複数（無理なようでしたら①と④を優先でお願いします）又、できればどの表情もアーボックは通常色と色違いをお願いします。\n①締め付けられて涙目で苦しんでいる（目は閉じています）\n②苦しんでいるけど若干感じていて赤面になっている（目は閉じています）\n③苦しいけど若干気持ちよくて恥ずかしがっている（目は開けています）\n④嬉しくて締め付けられているのに笑っている（目は開けています）", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3qSWIq8nJ9f32qD/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729108, "client_id": 180981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa226738f30840a64c76d358b74e900", "srcset": "https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aa226738f30840a64c76d358b74e900, https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3927ae3afe70c6f8a15d54be003c057 2x, https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1b0e0f6f2c17ec85905b8236a6b7195 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=058c89a5626b91eddc06e85fa6c826f8", "srcset": "https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=058c89a5626b91eddc06e85fa6c826f8, https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd069f9dc3c4d7c9bbfdfe0bf43cda86 2x, https://si.imgix.net/9eb7f623/uploads/origins/f5c292f9-9c43-4b78-9ed2-ac4201db66be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bddb8ed14d866959d30d68f136fece5 3x"}, "body": "今回も艦これの時津風がポケモンのアーボックに巻き付かれている絵をお願いします。\n\nアーボックに巻き付かれる前からで\n①アーボックが目の前に現れ「大きな蛇さんだー」みたいな表情で危機感がない。\n②巻き付かれ初めて？みたいになっている。\n③半分ぐらい巻き付かれて「やめてよ～」みたいになっている。\n④全身巻き付かれて「は、離せ～」みたいになっている。その時アーボックの頭は時津風の頭の上にあり舌を出している(前回の絵のような感じです)\n⑤締め付けが始まり「嫌！」みたいになっている。\n⑥だが全力ではなく気持ちよくて感じてしまっている。\nをベースにして頂けると嬉しいです（書きやすいようでしたらセリフやシーンを追加して頂いても大丈夫です）　\n\n又、大丈夫ならアーボックの通常色と色違いのをお願いします。\n一枚（又は複数枚）でまとめて頂くか、一枚づつかはご負担が少ない方で(同じなら一枚づつ)お願いします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@3qSWIq8nJ9f32qD/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2729108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/997d8277/uploads/origins/7218c2bf-19b4-456e-902c-0718a359027e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7333e6a3cd4eadf7d6f28efde87a5b5d", "srcset": "https://si.imgix.net/997d8277/uploads/origins/7218c2bf-19b4-456e-902c-0718a359027e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7333e6a3cd4eadf7d6f28efde87a5b5d, https://si.imgix.net/997d8277/uploads/origins/7218c2bf-19b4-456e-902c-0718a359027e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e860e16f2ef1314b579eae546a86a9cb 2x, https://si.imgix.net/997d8277/uploads/origins/7218c2bf-19b4-456e-902c-0718a359027e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=55a1beaf47ff8acc6f30f15e975e31b6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/997d8277/uploads/origins/7218c2bf-19b4-456e-902c-0718a359027e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f50012bf54dd8c81ad121774fc0a1d5", "srcset": "https://si.imgix.net/997d8277/uploads/origins/7218c2bf-19b4-456e-902c-0718a359027e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f5001