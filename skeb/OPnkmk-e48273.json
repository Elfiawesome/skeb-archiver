と、食べること、寝ること\n・海のもの全般\n・ふわふわしたもの\n・お菓子作り、お絵描き、いたずら\n\n《納品について》\nPSD形式又はPNG形式で、背景がある場合は有り・無し(人物のみ背景透過)の2パターンいただけると幸いです。\n\nお願い事が多くて申し訳ありません。\n以上、リクエスト内容に問題がございませんでしたら、お受けいただけますと嬉しいです。\nご検討の程、よろしくお願いいたします。\n\nリットリンク\nhttps://lit.link/yonagiyona\nhttps://drive.google.com/drive/folders/1S1ayorWb--DlrVLDt1FMd2Q-EC5A25xo?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OPnkmk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1585126, "client_id": 3767663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d56bc30c/uploads/origins/b987793b-278d-40f7-893e-160d818ea03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcee9ea02fd169cc72ae9b1c266abbb7", "srcset": "https://si.imgix.net/d56bc30c/uploads/origins/b987793b-278d-40f7-893e-160d818ea03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcee9ea02fd169cc72ae9b1c266abbb7, https://si.imgix.net/d56bc30c/uploads/origins/b987793b-278d-40f7-893e-160d818ea03e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aed81e66604bfcdf4dc507b3241c0de8 2x, https://si.imgix.net/d56bc30c/uploads/origins/b987793b-278d-40f7-893e-160d818ea03e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04755af6c25defc7db32d6250d804f62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d56bc30c/uploads/origins/b987793b-278d-40f7-893e-160d818ea03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0f9da03439c5c1670c4d3a297a58d5", "srcset": "https://si.imgix.net/d56bc30c/uploads/origins/b987793b-278d-40f7-893e-160d818ea03e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b0f9da03439c5c1670c4d3a297a58d5, https://si.imgix.net/d56bc30c/uploads/origins/b987793b-278d-40f7-893e