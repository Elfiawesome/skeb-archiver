gix.net/765b73ad/uploads/origins/88caf9b0-f65b-4176-8188-7d84acd5dc1c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e32c669b4e95a44163b300e9d7db576 3x"}, "body": "こんにちは、私はこのかわいい男の子のキャラクター \"北条時之 \"の作品をお願いしたいです。\n\nトキユキは巨人サイズ（1000m以上）です。\n彼は裸足で、靴も靴下も履いていません。\n彼は立っていて、小さな町を矮小化し、足を宙に浮かせ、今にも降りようとしている。\n裸足の足裏には土と砕けた残骸がこびりついている。その中には、ぺしゃんこになった車、つぶれた建物、街灯がいくつかある。\n彼の左手は、指を宙に浮かせて電車ごと抱えている。\n巨大な少年は、その新しい大きさの割に遊び心にあふれている。\n右上には空に浮かぶ小さなUFO。少年を大きくしたのはUFOであることを示す短いテキスト。\n\nありがとう。\n\nトキユキの参考文献\nhttps://www.pixiv.net/artworks/120474873\nhttps://www.pixiv.net/artworks/128854412 （左の男の子）\n\n頭身のプロポーションに従う。少年体型。\n\n表情と目のデザイン\nhttps://www.pixiv.net/artworks/121126375\n\nポーズと視点の参考：\nhttps://www.pixiv.net/en/artworks/128463448", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tazataza_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116924, "client_id": 2811412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a74748ef67b0f00107b23c4f174c47dd", "srcset": "https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a74748ef67b0f00107b23c4f174c47dd, https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fded9e3a46e8eaade9aadf1ae766f904 2x, https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc6ad24b95aebc5195b642bddda8354c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b53031abd83d01fc6376f5e4ff1986d4", "srcset": "https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b53031abd83d01fc6376f5e4ff1986d4, https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c21bb16f57c820cffb08f4c3f1420f9 2x, https://si.imgix.net/4a6dbaee/uploads/origins/bf022118-3131-42aa-be7d-60e2bff14092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a623e79c7dd900994a45c41d5dd3124f 3x"}, "body": "こんにちは、私のキャラクター（OC）のジェニーとザックを描いていただけませんか？ジェニーはザックのスタミナを鍛えるために、ザックの身長を数センチに縮めています。\nジェニーはザックを足元に置いて床に座っています。ジェニーが片方の足の裏をザックの背中につけている間、ザックは腕立て伏せをしようとしている。ジェニーは両手を口に当て、ザックを励ます言葉を叫んでいる。ジェニーはザックの背中に乗せた足に靴下を履いたままだ。ジェニーのもう片方の足は裸足である。ジェニーは足の裏が見えるように座っている。もう片方の足はザックの顔に近づけ、汗臭さで彼を閉じ込めている。\nザックはシンプルな白いTシャツにアスレチックショーツをはいている。\nジェニーはトレーニングウェアを着ている。ジェニーは事前に自分でワークアウトをしたため、汗で蒸れ蒸れになっている。\nありがとう。\n\nhttps://drive.google.com/drive/folders/1QyK7-7YfTL-IGQwyKlEFIw9vrPVinaYj", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tazataza_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 116924, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1edd3e1d/uploads/origins/7f9d962d-c755-4da5-a5e9-9154d3fd9dbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9972233504a7adcb6a9dc02e06c628ae", "srcset": "https://si.imgix.net/1edd3e1d/uploads/origins/7f9d962d-c755-4da5-a5e9-9154d3fd9dbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9972233504a7adcb6a9dc02e06c628ae, https://si.imgix.net/1edd3e1d/uploads/origins/7f9d962d-c755-4da5-a5e9-9154d3fd9db