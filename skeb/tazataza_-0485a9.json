://www.pixiv.net/artworks/121516609 左側の男の子\n髪のデザインと長さ\nhttps://www.pixiv.net/artworks/92609124\n\nキャラクターは裸足で、足を前に出している。足のアクセサリーはなく、足が露出している。\n右足は手前のテーブルを押している。\nタイニーは参考資料の2倍小さい。\nタイニー1個が足の裏にはまっている。足の指の間に挟まっている。\n一匹のスズがテーブルの上に乗って逃げている。\n足の臭いに苦しんで顔を覆っている。\n一匹のタイニーがキャラクターの右足とつま先で押しつぶされている。\n\nキャラクターはかわいらしく、からかうような表情をしている。\n\n手のポーズと表情：\nhttps://www.pixiv.net/artworks/76748491\n\nバリエーション\nありがとうございます。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tazataza_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 116924, "client_id": 2751907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01e71bcc/uploads/origins/85fbc6ac-bd65-45a6-a17b-e8ddd385540d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0096f57033db88a9d50a7e14b4b15e1", "srcset": "https://si.imgix.net/01e71bcc/uploads/origins/85fbc6ac-bd65-45a6-a17b-e8ddd385540d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0096f57033db88a9d50a7e14b4b15e1, https://si.imgix.net/01e71bcc/uploads/origins/85fbc6ac-bd65-45a6-a17b-e8ddd385540d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4365bf43533b2673c82f5ed37786a9a4 2x, https://si.imgix.net/01e71bcc/uploads/origins/85fbc6ac-bd65-45a6-a17b-e8ddd385540d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bba4dbcfca9e6ebb2c67700936683cc 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01e71bcc/uploads/origins/85fbc6ac-bd65-45a6-a17b-e8ddd385540d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ca31b80a1bd00142ff934a1c4e7e3bb", "srcset": "https://si.imgix.net/01e71bcc/uploads/origins/85fbc6ac-bd65-45a6-a17b-e8ddd385540d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ca31b80a1bd00142ff934a1c4e7e3bb,