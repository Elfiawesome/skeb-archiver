pr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49c9a4f04d48225622717f31ddaa0b86 2x, https://si.imgix.net/af9cd8d2/uploads/origins/ba86e7d6-ed5a-45f9-bfc5-21596e970704?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59035c480cf6e9e4efce51393ca2f1a1 3x"}, "body": "初めまして。匿名で失礼いたします。\nビリーさんの絵柄がたいへん自分の好みで、ひっそりこっそり応援している者です。\n6年前、ローコラがきっかけでビリーさんを知り、当時購入させていただいた豪華な御本を今も大切にしております。\n今回、初めてリクエストというものをさせていただくため至らない点があるかと思いますが、どうかご容赦ください。\n\nさて本題ですが、CP9の頃のルッチとカクを描いていただけませんでしょうか？　絡みがあってもなくてもどちらでも良いです。\nワンピのオタクになりたての頃、リアルタイムで本誌を追いつつ熱を上げていた、私にとって思い入れのあるキャラクターで、たいへん不躾なのは承知ですが、ビリーさんが描かれるルッチとカクをぜひとも拝見したくリクエストを送らせていただきました。\n\nお忙しいところ申し訳ありませんが、ご検討いただけると幸いです。よろしくお願いいたします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bilikenDC/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1341972, "client_id": 1349262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75549fce/uploads/origins/e45215e1-ea9d-49e0-b0e4-8ae530d51e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1248f548e553d7cad9b70ff3fc5de363", "srcset": "https://si.imgix.net/75549fce/uploads/origins/e45215e1-ea9d-49e0-b0e4-8ae530d51e24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1248f548e553d7cad9b70ff3fc5de363, https://si.imgix.net/75549fce/uploads/origins/e45215e1-ea9d-49e0-b0e4-8ae530d51e24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e7a54adc1b01a0055e7711ba6d0ba053 2x, https://si.imgix.net/75549fce/uploads/origins/e45215e1-ea9d-49e0-b0e4-8ae530d51e24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7711a54e34dbee74af89d1639d914fc4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75549fce/uploads/origins/e45215e1-ea9d-49e0-b0e4-8ae530d51e24?bg=%23fff&auto=format%