ていた文香が、人生初めての告白をガチガチに緊張しながら奏にします。奏は一瞬驚きますが、直ぐにいつもの涼しい表情で即答でオッケーします。これからよろしくと頬を撫でて、また今夜電話するわと、いつもと変わらぬ様子で去って行く奏。思いの外呆気なく人生初の恋人ができて、しかも当の奏が普段と全然変わらない態度なので、嬉しいけど何だか拍子抜けする文香。やはり奏さんは素敵な女性ですから経験豊富なのですねと感心すると共に、それでも年上の恋人として恥じぬように頑張らねばと思う文香（19）。\n\n寮の自室に帰ってから、初めて好きな人と付き合う事になって、嬉しさのあまり赤面して悶えている奏（17）。\n\nカジキ様の青春全開なかなふみが見たいというだけです。細かい変更や添削はお任せ致します。お気軽にどうぞ。\n\n普段描かない組み合わせだと思いますが、ご検討の程よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 481633, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "だやま", "screen_name": "3dayama3", "avatar_url": "https://pbs.twimg.com/profile_images/1936349676170571776/-4FR01IS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3303467473/1708355222/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 24}, {"id": 490057, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "平賀まつり", "screen_name": "hiraga_matsuri", "avatar_url": "https://pbs.twimg.com/profile_images/1869399924431073281/6LKgxcV6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/18073825/1643924537/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 176}, {"id": 1086907, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "💫藤城まつり💫", "screen_name": "morisoba1213", "avatar_url": "https://pbs.twimg.com/profile_images/1460300731748339712/npH1ta7c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/9409037376