お城に住んでいるように自分を王族だと思っている。彼女は野良ネズミを捕まえては食べる代わりに下僕にし、強気で要求が多いにもかかわらず、自分は寛大で高潔だと信じている。ぬいぐるみのデザインの多くはハートで飾られており、王冠、襟、鼻、お尻はすべてハート型の模様で、彼女の甘やかされて自己中心的な態度とは対照的である。甘いものも大好き。\n\n私は、ネズミの下僕に甘えられるプラッシュを依頼しようと思っていた。彼女はぬいぐるみのような枕の上でくつろいでいて、ネズミたちに尻尾をブラッシングしてもらったり、デザートをスプーンで食べさせてもらったり、気の向くままに甘やかしてもらいながら、ドヤ顔で視聴者をちらちらと振り返っている。食べ方が汚いので、スプーンで食べさせられて顔はぐちゃぐちゃだ。ぬいぐるみの自信と対比させるために、ネズミたちは彼女に奉仕することにイライラ／不満／恐怖／緊張しているのかもしれない。ありがとう！\n\nhttps://imgur.com/a/W4bAhxY", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tohupony/works/61", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7c5dd583/uploads/origins/95044689-c0c7-4750-9182-0e9984baa949?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9b41bda6ff42c0886559a6a173a8906e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1222198, "client_id": 474722, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tohupony/works/60", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e29d447b/uploads/origins/baa637cf-1186-4f57-b4f9-f78c102d2292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec8c1c21a4f0b1eb1522ad315b495648", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1222198, "client_id": 33399, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tohupony/works/59", "private_thumbnail_image_urls": {"src