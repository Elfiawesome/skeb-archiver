テキで、ぜひまたぱんいち工房様にSDイラストを描いて頂きたいと思いリクエストしました！\n\nお好きなシチュエーション、ポーズで描いていただけたらとても嬉しいです！\n\n【依頼したいデザイン】\nちゃーずのSDイラスト\n\n特徴\n・猫耳\n・犬歯があります\n\n【使用用途】\n主にVtubrer活動に使用したいと思っています。\n用途：収益化されたTwitchでの使用、サムネイルでの使用、グッズでの商用利用、SNSでの使用、返礼品としての使用\n\n【その他】\n資料URLの1か2の衣装を描いていただきたいです。\n（猫耳の色を髪色と合わせてくださると助かります）\nもし可能であれば表情差分があると嬉しいです。\n背景がある場合は人物と分けたpsdデータまたはPNG形式で納品していただけると嬉しいです。\n\n上記、ご負担になる項目は無視していただいて構いません。\nまた、描いていただいたイラストは、🐾ぱんいち工房様のサンプル等に使用していただいても結構でございます。\n\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願い致します。\n\ndrive.google.com/drive/folders/1Xi8PiqBXynH5mZUrhaJKFu-7IyoILR9P?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@panichiatelier/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 3726375, "client_id": 3827855, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13625210/uploads/outputs/3143d4a8-3361-492e-9425-b19dbafbe9ed?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9023b14c3a464f8eb12eda2248f9a67e", "srcset": "https://si.imgix.net/13625210/uploads/outputs/3143d4a8-3361-492e-9425-b19dbafbe9ed?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=9023b14c3a464f8eb12eda2248f9a67e, https://si.imgix.net/13625210/uploads/outputs/3143d4a8-3361-492e-9425-b19dbafbe9ed?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=487c7a25996c420347720f1e19f7be8b 2x, https://si.imgix.net/13625210/uploads/outputs/3143d4a8-3361-492e-9425-b19dbafbe9ed?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8fd8e36a94e5fa524f1727aa65cd682 3x"}, "duration": 25, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13625210/uploads/outputs/3143d4a8-3361-492e-9425-b19dbafbe9ed?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=48ed83b17c2ea5e255cd70eed03227af", "srcset": "https://si.imgix.net/13625210/uploads/outputs/3143d4a8-3361-492e-9425-b19