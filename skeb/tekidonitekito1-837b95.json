願いします！\n\nhttps://drive.google.com/drive/folders/1FbSwIg-7fGN9-SXI1jRHLmKWUWQAUpnj", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tekidonitekito1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4058398, "client_id": 4070675, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fbe3ede3cd9fec8d43c9e7c006745e9", "srcset": "https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fbe3ede3cd9fec8d43c9e7c006745e9, https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d107b7dcb30dd5240ea58827120752ee 2x, https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db20e32d5f72cdedaf27b5b30338e55e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a5cfda90e610c2c142890fbd7393562", "srcset": "https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a5cfda90e610c2c142890fbd7393562, https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e02367bd2ba1c7ce8008c28ffe343c8 2x, https://si.imgix.net/c320db79/uploads/origins/84be1924-d2a5-40f9-b1a5-36927812f048?bg=%23fff&auto=f