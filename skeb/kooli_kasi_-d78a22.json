4-c2021531f8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a21cbd9c1c76432a970808909150e39 2x, https://si.imgix.net/da2f3fcf/uploads/origins/707a6e1e-bb92-4a49-8814-c2021531f8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b0917a96fb703de2900f93efe97a2feb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da2f3fcf/uploads/origins/707a6e1e-bb92-4a49-8814-c2021531f8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dd6807808231e0fb47c23cdd81495b9", "srcset": "https://si.imgix.net/da2f3fcf/uploads/origins/707a6e1e-bb92-4a49-8814-c2021531f8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dd6807808231e0fb47c23cdd81495b9, https://si.imgix.net/da2f3fcf/uploads/origins/707a6e1e-bb92-4a49-8814-c2021531f8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f8811e149a0e32b1299262e2e98587 2x, https://si.imgix.net/da2f3fcf/uploads/origins/707a6e1e-bb92-4a49-8814-c2021531f8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fd063575beee6913dc386f2ce1dff70 3x"}, "body": "氷菓子さん、こんにちは。\n以前は素敵なイラストを描いていただき、ありがとうございました！ \n今回もぜひ自創作のキャラクターを描いていただきたく、リクエスト失礼いたします。\n\n添付資料のキャラクター2名をお願いいたします。 構図や表情、細かな部分などは、氷菓子さんのお好きなように解釈して描いていただけましたら嬉しいです。\n\n描いて頂いたイラストは、鑑賞、個人的なグッズ制作、SNSのアイコン・ヘッダーに使用させて頂きたいと考えています。\n\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1hDyxckD0GnP8YJ0gABcYh1EUNpp5Diqd", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kooli_kasi_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3844672, "client_id": 3862904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09ba2948/uploads/origins/8a32489a-9d3f-4756-8d63-6be23557317f?bg=%23fff&auto=format%2