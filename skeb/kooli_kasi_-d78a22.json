lse, "genre": "art", "tipped": false, "creator_id": 3844672, "client_id": 3787177, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d76b6affdf5900e70b765bf32c029ab", "srcset": "https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d76b6affdf5900e70b765bf32c029ab, https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e750d578a807370c22026c85ce3009e2 2x, https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ef550849bdf9aec71e3145d5712b811 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a24b1c3d518a642d96345f64764172c4", "srcset": "https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a24b1c3d518a642d96345f64764172c4, https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50931c2a30860c2aac33136dc7e893a2 2x, https://si.imgix.net/798d4637/uploads/origins/82447110-bc4f-427f-9510-54790ef01b7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb61cbf942a393bf8b3fd6faa531c8f 3x"}, "body": "こんにちは！\nはじめまして！\n\n「HempieVT」というVTuberのイラストをお願いしたいです。\n彼女は普段から眠そうで、少しぼんやりとした雰囲気をしており、目の下にクマがあります。\nまた、髪に赤いストライプがあり、瞳の中にはX（エックス）型の模様があります。\n添付の参考画像のどの衣装を使っていただいても大丈夫です。\n\nポーズや構図、雰囲気などはすべておまかせします。\n自由に、あなたの思うままに描いていただけると嬉しいです。\n\nHempieは、上官の命令に逆らったためにチェルノブイリの立入禁止区域に追放されたスリーパーエージェントです。\n放射線の影響で彼女自身も放射性を帯びており、孤独の中で廃墟の建築や放棄された軍用車両、武器（SVD、DP-27など）を研究しながら静かに暮らしています。\nまた、酒に酔うのが好きで、時々飲みすぎてしまうこともありますが、それでも楽しんでおり、よく飲んでは物思いにふけり、時々タバコを吸うこともあります。\n\n彼女のそばには、放射能の影響で変異したマスコットの「Pyp（ピップ）」がいます。\nPypは小さな粘性のある生物で、手足がなく、頭上に光る輪（ハロー）が浮かんでおり、いつもHempieの頭の上や近くにいます。\n\nこのキャラクターは、『serial experiments lain（シリアルエクスペリメンツ・レイン）』や『少女終末旅行』のような作品に影響を受けています。\n静けさ、不安定さ、そして虚無感を感じるトーンで表現していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HKpUvqulI6HbCdDdFmdSel-kAK-mqZ6k?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kooli_kasi_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3844672, "client_id": 3818181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13b10d63/uploads/origins/8fff3032-2da4-494d-b300-00a569bff781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=507bf161c8d04ae8af8086e0087607c9", "srcset": "https://si.imgix.net/13b10d63/uploads/origins/8fff3032-2da4-494d-b300-00a569bff781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=507bf161c8d04ae8af8086e0087607c9, https://si.imgix.net/13b10d63/uploads/origins/8fff3032-2da4-494d-b300-00a569bff781?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2cb0b788291b9da0d44d613f07ead98d 2x, https://si.imgix.net/13b10d63/uploads/origins/8fff3032-2da4-494d-b300-00a569bff781?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24946cef72ceb0ace17fd1da6d590093 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13b10d63/uploads/origins/8fff3032-2da4-494d-b300-00a569bff781?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43fe