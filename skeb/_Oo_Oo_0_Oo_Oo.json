51bb69-76b8-4d8b-9449-d85a9dc8aaa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d21bb12d33435b84efded8504d8823ca", "src_set": ""}, "body": "初めまして。\nとろけるまろ様の素敵なイラストを拝見し、\nぜひこの子を描いていただきたいと思いリクエストを送らせて頂きました。\nこの子は中国の動画サイトBilibiliで活動しているVTuberの北柚香（きた　ゆうか）です。\n使用範囲は柚香の配信、動画のサムネイルとBilibiliでのプロモーションです。\n\nポケモンのクワッスを抱いている姿で、表情や背景は自由です！\nお好きに描いてください！\n\n可能であれば背景と人物は別のレイヤーで頂きたいです。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1fqYBlr-foW5l-mtS6LthxZiBDbathsmV/view?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 193076, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "花咲ちゆ🌸Vtuberさきちゅ🐇🎨", "screen_name": "hanasakichu", "avatar_url": "https://pbs.twimg.com/profile_images/1929390706457776128/LgrBqqe-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3011966756/1748837514/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 177}, {"id": 592126, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "２９９", "screen_name": "horisso", "avatar_url": "https://pbs.twimg.com/profile_images/907239064784347138/j6gszfsh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/77210755/1673864827/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 764052, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "バンバンG", "screen_name": "BANBANJIIIIIII", "avatar_url": "https://pbs.twimg.com/profile_images/1901197775016247296/Wg31VTkQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1295225134236631041/17294786