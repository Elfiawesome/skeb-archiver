iこと雪村錬太郎です。\n今回もボイスの依頼です。\n\n声はママのときの声で。\nシチュエーションは、お風呂に入っていたら、バスタオルを巻いたりくすママが背中を流しに入ってきちゃって、りくすママに一通りからかわれたり洗われたりしたあと、中に水着を着ていたとネタバラシされる感じでお願いします。\nでも中の水着もめっちゃ可愛くてセクシーなので、背中を流される側はそれでも照れちゃって、それをまたからかわれたりする感じで。\n呼び掛けは「お主」とか「主様」みたいな感じののじゃロリに似合いそうな感じで宜しくおねがいします。", "nc": 137, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@rikusu_vrc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 951022, "client_id": 1046107, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/7ca14f40-46aa-45ff-a00a-46923edf0ad0?response-content-disposition=inline&Expires=1788911144&Signature=FD0GL3NoGPWahnc2gXsr5pvNIFEDYZjhJlwPYZgBIdtr3FwF3py0DVMW1RYVjNXv800p17xtJuXmMSXmruwJ30MWLJcm8lHk-f57xmup9oeW5v4drhqKotexnkOZQxgIPhYLZ4zE6X~O1vTEsm07-EpDSO-mCZDsfStF1uvPUnEV6IESxJXVyvVa5jxuom1fCV58zPecMmkkCPfVPhxqqhoZEFjBHWg6DKXdbvk~05wUQGJoElhXWPH7ZE-tPEnqlpLq5MNnNXCKrihJXUKrA1E1YEcGweQocI0SzWFKkk2C0YEMTOCNfe13P8VEnhiMp1yVD2EMEOn3YiXgcKa7Zw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061979593444339712%2FLnZQAeR-.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e951d7fce9dc902d2201c5cb4001de53", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061979593444339712%2FLnZQAeR-.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e951d7fce9dc902d2201c5cb4001de53, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061979593444339712%2FLnZQAeR-.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88382119b9ac803f203a095cb22380ab 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2061979593444339712%2FLnZQAeR-.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d5cb45a3fbb97a00a0a98730d071e8 3x"}, "preview_url