: "こんにちは、前に描いてくれたイラストに感謝します。大好きです~もう一枚新しいイラストを描いてもらいたいです。\n【要求】\nキャラクターは転んだ後に泣くポーズ表情が希望ですが、できるだけ今までと同じ服装を選ばないでください、自分でデザインすることもできます。構図その他はお任せしますね\n参考リンクを忘れて、再送一回、十分申し訳ありません😭🙏\n\nhttps://drive.google.com/drive/folders/1L6cn7Df-Qsio8IP6JnDv3Fjqk_fceFRC", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siroi_53/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1118267, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba347970/uploads/origins/88c93712-8d47-457f-a899-642768880279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f8d6647385da266b8238a453f2f1a7e", "srcset": "https://si.imgix.net/ba347970/uploads/origins/88c93712-8d47-457f-a899-642768880279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f8d6647385da266b8238a453f2f1a7e, https://si.imgix.net/ba347970/uploads/origins/88c93712-8d47-457f-a899-642768880279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=930f64528c26b2a761e3a6b109a8fb19 2x, https://si.imgix.net/ba347970/uploads/origins/88c93712-8d47-457f-a899-642768880279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=412b0f69bca8e57f8116240f79464a20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba347970/uploads/origins/88c93712-8d47-457f-a899-642768880279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47460c932d884b24997c610e852f5e87", "srcset": "https://si.imgix.net/ba347970/uploads/origins/88c93712-8d47-457f-a899-642768880279?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47460c932d884b24997c610e852f5e87, https://si.imgix.net/ba347970/uploads/origins/88c93712-8d47-457f-a899-642768880279?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=20