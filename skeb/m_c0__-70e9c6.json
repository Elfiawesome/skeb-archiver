k0nm7Cua_AVtzfydA4ag72vqvsyH", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m_c0__/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d386bcd/uploads/origins/3b572fc0-5529-4737-a7b9-857870e472a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e8bc8b7db48c9dbd57e27085a3745a8", "srcset": "https://si.imgix.net/9d386bcd/uploads/origins/3b572fc0-5529-4737-a7b9-857870e472a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9e8bc8b7db48c9dbd57e27085a3745a8, https://si.imgix.net/9d386bcd/uploads/origins/3b572fc0-5529-4737-a7b9-857870e472a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2bd5bc3a03878341f8ff11f38302665 2x, https://si.imgix.net/9d386bcd/uploads/origins/3b572fc0-5529-4737-a7b9-857870e472a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89fc6e4eef6418d2d88984da520076b0 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3625516, "nc": 145}], "sent_works": [], "similar_creators": [{"id": 1028280, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おきる", "screen_name": "okiru", "avatar_url": "https://pbs.twimg.com/profile_images/1583822043325542401/Z2a3Jbir.jpg", "header_url": "https://pbs.twimg.com/profile_banners/73822147/1666447751/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skil