webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85fb78c2c41ddd95ef685a236b21281c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/418994bb/uploads/origins/20f8ea3e-519c-4e1e-b0f2-aa22f363fc46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55af7abc39866b1ce9ccc7ac81f6025e", "srcset": "https://si.imgix.net/418994bb/uploads/origins/20f8ea3e-519c-4e1e-b0f2-aa22f363fc46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55af7abc39866b1ce9ccc7ac81f6025e, https://si.imgix.net/418994bb/uploads/origins/20f8ea3e-519c-4e1e-b0f2-aa22f363fc46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1172e9b17db9170117f901336fd90e78 2x, https://si.imgix.net/418994bb/uploads/origins/20f8ea3e-519c-4e1e-b0f2-aa22f363fc46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f4f70afb1aa7218c1378202073566b 3x"}, "body": "こんにちは。あなたのイラストは素敵ですね。私のVTuberを描いてください。\n\n- 私のVTuberはネズミの女の子です。\n- 彼女は興奮しやすく、声が大きく、自信家であり、ちょっとカオスな性格です。\n- 顔全体にそばかすがあります。\n- 髪の色は紫の様々な色合いです。\n- 親友でありマスコットは黒猫です。\n- ジャケットを着ていない姿でも描いていただいて構いません。\n- フェイスマスクをしていない姿でも描いていただいて構いません。\n\n私のキャラクターに合うと思うポーズなら、どんなものでも構いません。\n本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1KoouXE4uGo-gtFhHDB4PKJOkGX4oVju0?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shuri2/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913863, "client_id": 3888697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b55db28/uploads/origins/63f01154-e939-48fe-aa62-1639451488c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca222bcd96ee96abeea2b4e69c32c13", "srcset": "https://si.imgix.net/1b55db28/uploads/origins/63f01154-e939-48fe-aa62-1639451488c9?bg=%23fff&auto=format%2Cc