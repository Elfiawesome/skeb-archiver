み。\n〇濃いめの赤のたれ目、たれ眉\n〇アヒル口で口の横、向かって左側の口元にほくろあり　\n\n参考資料URL\nhttps://www.fanbox.cc/@moerupi/posts/11418891\n\n可能であれば納品の際に背景と人物が別レイヤーのPSD、または人物のみの透過PNGデータをいただけると大変助かります。\n\nお忙しいところ恐れ入りますがご検討よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shuri2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3913863, "client_id": 2825061, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c835a655/uploads/origins/9e785188-596c-43f7-9d95-71c0f26a06c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d99bed5e6763841c814118612d339e7c", "srcset": "https://si.imgix.net/c835a655/uploads/origins/9e785188-596c-43f7-9d95-71c0f26a06c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d99bed5e6763841c814118612d339e7c, https://si.imgix.net/c835a655/uploads/origins/9e785188-596c-43f7-9d95-71c0f26a06c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebf76b8f29e54d39f0bfc890a66a9183 2x, https://si.imgix.net/c835a655/uploads/origins/9e785188-596c-43f7-9d95-71c0f26a06c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39cfb4558e6ca469716264e859a40a2b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c835a655/uploads/origins/9e785188-596c-43f7-9d95-71c0f26a06c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c16b02ab23171dd932ee401a3ff9328", "srcset": "https://si.imgix.net/c835a655/uploads/origins/9e785188-596c-43f7-9d95-71c0f26a06c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c16b02ab23171dd932ee401a3ff9328, https://si.imgix.net/c835a655/uploads/origins/9e785188-596c-43f7-9d95-71c0f26a06c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8369f23d1e235364135a240f9c4