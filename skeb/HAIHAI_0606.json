: "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HAIHAI_0606/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6e33a885/uploads/origins/6559d8e5-a5c8-4b14-9101-cb03949b9d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91490cd6dfa4e29b2f01622e2e6f94dc", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2980350, "client_id": 28092, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@HAIHAI_0606/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2980350, "client_id": 2952544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2488de51/uploads/origins/bbe35afb-4362-4c0e-a6fc-f62193004fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1d2ca9f01845ebc4eea59349c5f68d0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2488de51/uploads/origins/bbe35afb-4362-4c0e-a6fc-f62193004fff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b574e39cb130b483d6bcb6942a543457", "src_set": ""}, "body": "カエルくんさん、はじめまして！skeb開設おめでとうございます。いつも楽しくカエルくんさんのイラストを拝見させていたたいているので、skeb本当にうれしいです、、、今回はぜひ私のpcとtrpgシナリオのnpcくんのイラストを依頼したくて、リクエストをお送りさせていただきます。\n\nシナリオは「アルフ·ライラ·ワ·ライラは語らない」です。世界観は、古いアラブ世界に近い架空世界です。\n黒髪の子は19才の王宮騎士で、今は七つの海の怪物を倒すために、主である第二王子と一緒に航海に出ている青年です。勇敢で素直な性格を持っていて、忠義を胸に刻んで、人助けが大好き。頭を動くこと全般が苦手だが、剣術なら誰でも負けない、頼れる太陽みたいな犬系男子で、頬の傷がなければ、けっこう若い顔立ちです。\n\n緑髪の子は同じく19才で、王子のお世話係と策士を担当しています。武術は苦手だが頭脳明晰で臨機応変にさまざまな問題を解決できます。温厚篤実に見えますが、実は負け嫌いで、感情に駆られることも多いです。\n\n二人は幼馴染で、小さい頃から王宮の侍女たちと騎士たちの下で育てられました。よく一緒に授業をサボって芝生の上にひなたぼっこをしたり、深夜厨房のシチューを盗み食いをしたりしていました。ちょこちょこ喧嘩はしますが、お互いのことを相方として認め合い、第二王子の補佐をしています。\n\n服装簡略化と変更、または構図などはお任せします。実写の服装はフリー素材なので、良ければ私服の参考として使ってください。ご自由に描いてください。\n良ければご検討いただきたく思います！\n\nhttps://drive.google.com/drive/folders/1CMXvC_XHrjadeCf2p9PMCvM6D2--TibC?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1593614, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "夢川結女🎨お仕事 skeb募集中", "screen_name": "Yume_kawa__yume", "avatar_url": "https://pbs.twimg.com/profile_images/1929517249859297280/o9DuYMjW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1383429109284364290/1748422664/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "voice"}], "nc": 1}, {"id": 1825019, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "とのじ", "screen_name": "TOTOTOTO_TK", "avatar_url": "https://pbs.twimg.com/profile_images/1834564169791922176/k_MHE-ds.png", "header_url": "https://pbs.twimg.com/profile_banners/362002239/1739467323/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 17}, {"id": 1915525, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "謎のピニャ〜タ人", "screen_name": "zabuzabu_zabuun", "avatar_url": "https://pbs.twimg.com/profile_images/1871895647663824896/CZoyoWxU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1505110223442554881/1684336916/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_b