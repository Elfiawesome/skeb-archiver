m/OSWaLnc\n\nhttps://min.togetter.com/KkUULPB", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ngetyan_p/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2974202, "client_id": 2791639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4219d21fa135680a42486b246d73d36", "srcset": "https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4219d21fa135680a42486b246d73d36, https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9088cd0806ed5d2abcae7d1addbcada9 2x, https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df8ce10f0ca2dd941acefc6e3909df08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=650a7a804fd81e8e402094ff21cb6a29", "srcset": "https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=650a7a804fd81e8e402094ff21cb6a29, https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33660b5ac3dabf7ff7425ba55a96b69b 2x, https://si.imgix.net/44952fe8/uploads/origins/e14e5671-7097-47cb-869f-f9a4d64b759a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=807768c5870b6e927a447db585702cfb 3x"}, "body": "んげちゃんのskebリクエスト募集開始を心待ちにしておりました。\n改めまして開設おつかれさまです＆おめでとうございます！\n早速リクエスト送信させていただきます。\n\n【キャラクター】\nオリジナルキャラクターの女の子「エメスティ」をお願いいたします。\n金髪碧眼・吊り目で八重歯（ギザ歯）が見た目の主な特徴です。\n\n【衣装】\n資料ＵＲＬの3枚目を参考に、ビキニアーマー（＆可能なら武器も）を着用させてあげてください。\n\n【内容】\nんげちゃんがSNSでアップされているイラストのような\n「等身の高い全身イラスト」\n「デフォルメされたチビキャライラスト」\n「上半身カット」の３セットを1枚に収めたイラストをお願いいたします。\n\n・等身の高い全身イラストは\nドヤ顔＆八重歯が見えるような笑顔で、片足を膝から曲げて後ろに上げながら両手で巨大なハンマーを肩で担いでいるポーズです。資料で描かれているような盾は無しで大丈夫です。\n\n・デフォルメされたチビキャライラストは\n髪と同じ色の猫耳としっぽが生えて、よつんばいで猫みたいなポーズをしている、あざとい色っぽい目つきなデフォルメイラストをお願いします。\n\n・上半身カットは\n全身イラストの表情とは逆に、「ガーン！」とショックを受けている涙目で困ってしまっている瞬間の「哀」なカットをお願いいたします。\n\nいずれも細かい角度などはお任せいたします！\n是非ともよろしくお願いいたします！\n\nhttps://postimg.cc/gallery/Zz1Fw1CH", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ngetyan_p/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2974202, "client_id": 1654160, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ddbe725/uploads/origins/9aea80d6-c9f4-4e90-98c7-81b6082cd365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b802e0a41b0b54c905c93e120c39287", "srcset": "https://si.imgix.net/7ddbe725/uploads/origins/9aea80d6-c9f4-4e90-98c7-81b6082cd365?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b802e0a41b0b54c905c93e120c39287, https://si.imgix.net/7ddbe725/uploads/origins/9aea80d6-c9f4-4e90-98c7-81b6082cd365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78fbbd8afe5e29ed8a7a136513aa7a3b 2x, https://si.imgix.net/7ddbe725/uploads/origins/9aea80d6-c9f4-4e90-98c7-81b6082cd365?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a0063cb16854069cb155f47328bfd84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ddbe725/uploads/origins/9aea80