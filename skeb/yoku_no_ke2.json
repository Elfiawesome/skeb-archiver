ずに小さいサイズを無理に着ている為パツパツかつ肌に張り付いていている。\n裾はシャツインしているも袖がつんつるてんな状態(手首から上が拳一つ分くらい短い\n大きめの勃起乳首が透けてくっきり浮き出ている\n・恥じらっている表情 \n\n要望が多く申し訳ありませんが\nご検討の程宜しくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoku_no_ke2/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/91135d09/uploads/origins/12ecc5ea-cfb3-4c95-81de-452b0ce82364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4825b784fcb91c0ec64176f6dccf9dc4", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 724271, "client_id": 976271, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yoku_no_ke2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 724271, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2e1c06d/uploads/origins/feedddf4-c18c-4623-9cdb-350c42aa15fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e062d28a31280760c01553ec0153d60", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2e1c06d/uploads/origins/feedddf4-c18c-4623-9cdb-350c42aa15fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a07b3440c218dc2b8858470728e05217", "src_set": ""}, "body": "初めまして。\nリクエストします。\n\n■キャラクター\n東方Projectの今泉影狼\n\n長い爪は普通の長さでＯＫです。\n尻尾の描写もお願いします。\n\n■シチュエーション\n発情期を迎えてフェロモンムンムンな影狼が\n恋人の家にお泊りして布団(ベッド)の上でイチャラブエッチします\n体位は男性主観の正常位や騎乗位などの\nお互い見つめ合えるものでお願いします。\n\n発情期のため全身からフェロモンを漂わせる影狼は\n恋人の射精が近いことを察して、危険日であることを伝えますが\n恋人は興奮してこのまま中に出したいようで\n中はダメと言いつつも迫る中出しにドキドキ期待しています。\n中出し絶頂後、これで番い(つがい