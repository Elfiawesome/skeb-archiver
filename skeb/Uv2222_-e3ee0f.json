op=top&w=200&h=200&blur=200&s=6cd66817c7ccef332b5c61a7bb4d1f61, https://si.imgix.net/e5f6980e/uploads/origins/507e7a5b-8201-40a5-b54c-fc7ff44368fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ee7cd286c0b98e27fa381028bd1a31b 2x, https://si.imgix.net/e5f6980e/uploads/origins/507e7a5b-8201-40a5-b54c-fc7ff44368fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4af78d93007d6b7c377007bcfc323683 3x"}, "body": "初めまして、ひびきと申します。\n今回はTRPGの全身立ち絵の依頼をさせていただきたく思います。\n描いていただきたいのはURL先の女性です。\n高身長でそれなりに体格のいい、ちょっとぶきっちょな花屋のお嬢さんです。ダイスの気まぐれでやたら美人です。\n明るく快活な性格で表情はコロコロ変わるタイプです。\n服装は動きやすいパンツルックで、仕事中なら上にエプロンをつけています。\n髪は明るい茶色、目の色はマラカイトみたいな濃いグリーン。\nなんとなくイメージカラーがオレンジなので、服か小物にどこかしらその色があると嬉しいです。\n\nセッション時の立ち絵やコマ置き場の形状次第でトリミングしての使用をすることがあります。\n表情差分やエプロンなしの差分があると嬉しいですが、金額的に見合ってなければその辺はスルーで大丈夫です。\n\nご縁がありましたら受けてくださるとうれしく思います。よろしくお願いします。\n\nhttps://iachara.com/view/12007704", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Uv2222_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2548457, "client_id": 2990981, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=006cf7ecd55b27f3c4a38a7578027138", "srcset": "https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=006cf7ecd55b27f3c4a38a7578027138, https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc645094a6c2f00f66fa45e7265bdf8e 2x, https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=875086bbceb0c3b313009013f59c5d86 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=028bce977ce8ea9479fcb7e97a2eaa08", "srcset": "https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=028bce977ce8ea9479fcb7e97a2eaa08, https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcdbba1751155836bda8afd790c6e156 2x, https://si.imgix.net/f756ff76/uploads/origins/ae39b46f-123d-4071-afb9-e1e128afb97f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e374b9ef4541a4d5bb230c4179f841af 3x"}, "body": "中野かの様はじめまして、こんにちは。\nいつも素敵なイラスト拝見させていただいております。\n\n『探索者：Uの証言』と『探索者：Iの献身』のKPCと、『庭師は何を口遊む』のHO4の女性探索者2名のデフォルメイラストを描いていただきたいです。\n以下シナリオのネタバレはありません。\n\n【使用用途】\n・SNS(TwitterやDiscord)等での掲載、アイコンやヘッダー使用\n・セッションでの使用\nココフォリア内で駒として使用する可能性があるため、可能であれば個別の背景透過があると嬉しいです。\n\n【探索者設定等】\n◇撫子(KPC)\n・年齢 : 28\n・性格 : おおらかで明るい性格。喜怒哀楽が全て顔に出る。\n・髪型 : 2段姫カット、鎖骨下までのロング\n・髪色 : 黒に薄灰色のインナー\n・目の形 : つり目\n・目の色 : 右目F35959、左目F35977\n・表情 : 口を開けて笑っている\n左目の下と口の右下にほくろがあります\n◇嵂(HO4)\n・年齢 : 32\n・性格 : 基本落ち着いていて、集団行動よりは少数での行動を好む性格。何だかんだ人を甘やかしてしまいがちで、世話を焼きがち。花が好き。\n・髪型 : 顔の右側でゆるりと1つ結び（サイドアップの1つ結び）\n・髪色 : 黒\n・目の形 : ぱっちり寄りのツリ目\n・目の色 : 右:灰色/左:黒(左目が立ち絵の色と異なります)\n・表情 : 口を閉じて微笑んでいる\n\n塗りはSKIMAにある絵柄1でお願いしたいです。\n服装は立ち絵のまま、全身の構図はかの様にお任せします。\nできれば向き合っているかお互いの目を見ていると嬉しいです。\n\n金額や依頼内容になにか問題等ございましたら再送要請やキャンセルをお願いします。\nご縁がありましたらよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-Gb5OeRVIBuSXMeOJBPm9mtuJigUvlEr", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@xxx_czm/works/219", "private_thumbnail_image_urls"