\n距離感はかなり近め。\n\n↳その他\n身長差15cm（探索者②が高い）\n\n■使用用途\nSNSのアイコン、デスクトップ背景等個人利用の範囲で使用\n\nご縁、お時間等々御座いましたらご検討何卒よろしくお願い致します…！\n金額につきましても、不足等がございましたら再送要請を頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1hhhd5jXp6Ofcg28GzOPh4ndHb3jR0BeC", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_fujiya_4/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/44636834/uploads/origins/5546c0fc-c03c-4606-ac7e-6cf2b36ebacd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd3ec5036cb87f04f8398f6a85e64e61", "srcset": "https://si.imgix.net/44636834/uploads/origins/5546c0fc-c03c-4606-ac7e-6cf2b36ebacd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd3ec5036cb87f04f8398f6a85e64e61, https://si.imgix.net/44636834/uploads/origins/5546c0fc-c03c-4606-ac7e-6cf2b36ebacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5958d09bc92fd9bb9f3d0298f0462a4a 2x, https://si.imgix.net/44636834/uploads/origins/5546c0fc-c03c-4606-ac7e-6cf2b36ebacd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10042b0e906bd99c1cf5f621f42866d5 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1810520, "client_id": 2928917, "nc": 17}, {"path": "/@_fujiya_4/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1810520, "client_id": 2737036, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd12ddcd/uploads/origins/964920ca-e5e3-4213-ab2b-732eb61f9182?bg=%23fff&auto=format%2Ccompress&fm=web