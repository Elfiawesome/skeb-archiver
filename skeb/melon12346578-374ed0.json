だければ嬉しいです(頒布・販売等は致しません)。\n\n〇形式など：mp4でお願いしたいです。\n元イラストをいただける場合はpsd形式だと助かります。\n\n〇参考画像： Twitterアカウントとgoogle driveを記載いたします。\n①https://twitter.com/RyosukeTsukiyo\n②https://drive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@melon12346578/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 571483, "client_id": 2831636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb0cee13/uploads/origins/409038f8-f756-420e-88b6-0370b8c4078c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac76d3e26ac39d27523db3e5fca9f8a1", "srcset": "https://si.imgix.net/eb0cee13/uploads/origins/409038f8-f756-420e-88b6-0370b8c4078c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac76d3e26ac39d27523db3e5fca9f8a1, https://si.imgix.net/eb0cee13/uploads/origins/409038f8-f756-420e-88b6-0370b8c4078c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25e4698371f8707363425c5c0cc6379f 2x, https://si.imgix.net/eb0cee13/uploads/origins/409038f8-f756-420e-88b6-0370b8c4078c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ad1075eabe4366c9f749e66d853ff52 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb0cee13/uploads/origins/409038f8-f756-420e-88b6-0370b8c4078c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf0b471a26c684dc049dd087775431a", "srcset": "https://si.imgix.net/eb0cee13/uploads/origins/409038f8-f756-420e-88b6-0370b8c4078c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcf0b471a26c684dc049dd087775431a, https://si.imgix.net/eb0cee13/uploads/origins/409038f8-f756-420e-88b6-0370b8c4078c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fi