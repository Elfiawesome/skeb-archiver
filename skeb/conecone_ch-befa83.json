-ce438250946d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cdfefab1566eca9325fcc98cf0589ae, https://si.imgix.net/1de14cb6/uploads/origins/1ed54efb-5fdd-405e-a8ec-ce438250946d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9c5358785f7d32ea1a947538363fc55 2x, https://si.imgix.net/1de14cb6/uploads/origins/1ed54efb-5fdd-405e-a8ec-ce438250946d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c78bd06d52a40ead1631fed39b71041 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1de14cb6/uploads/origins/1ed54efb-5fdd-405e-a8ec-ce438250946d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1f16d4eab354a7cca7c86a185fc6a97", "srcset": "https://si.imgix.net/1de14cb6/uploads/origins/1ed54efb-5fdd-405e-a8ec-ce438250946d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1f16d4eab354a7cca7c86a185fc6a97, https://si.imgix.net/1de14cb6/uploads/origins/1ed54efb-5fdd-405e-a8ec-ce438250946d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=32886946b11b695e488733e6f812ae80 2x, https://si.imgix.net/1de14cb6/uploads/origins/1ed54efb-5fdd-405e-a8ec-ce438250946d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fe5669efc19a4f473e472e6d4b0a33e 3x"}, "body": "めぇと言う名前の私のキャラ（うちの子）で何か描いて下さい\n羊・月・サキュバス等の要素が含まれます\n身長:118cm　外見年齢:10歳程度\n若干イカ腹っぽく、髪の毛量が多めです\n\nTwitterから可愛い絵をお見掛けして依頼したく思いました\nよろしければらくがきつめこみお願いします\nお受けいただく場合は露出の多いキャラであることにご注意願います\n\n\nキャラの性格等\n口数少なく穏やか、やや幼い性格でややアンニュイ・ダウナー、常に少し眠そうで\n振る舞いはおとなしく、人懐こいです\nミルク、ナッツ、チョコ等を好み、小食です\n行動に害意はなく、敵意を嫌います\n\n構図やシチュエーションなどはお任せします\n資料は以下のURL、Skebの過去の納品を参考にお願いします\nhttps://www.pixiv.net/artworks/99333545\n\n\nアイデアが必要な場合は以下の文章をご参考ください\n\n・牧草や布団椅子の上で丸まって寝ている\n・高所（煙突など）から遠くを見ている\n・何かに撫でられて微笑む\n・気持ちよさそうに空を飛ぶ\n・水浴びをする\n・指先からミルクを垂らして瓶に入れる\n・動物にくっついてうとうとしている\n・寝ている相手に抱き着いてエネルギーを緩やかに奪う（発光）\n・三日月に腰掛けあるいは抱き着くなど月を絡める\n・伸びた毛を第三者に毛刈りされるのを気持ちよさそうにする\n・角が折れた（痛くはない）\n・小さい物をしゃがみ込んでのぞき込む\n・誰かと手をつないで夜を散歩している\n・ひつじのぬいぐるみに腰かけて空を見ている\n\n\n\n設定　能力\nめぇは人々の記憶に住み着く妖精や悪魔のようなもので\n体の縁が淡く発光しており、普段は浮遊しています\n桃、アルコール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n分泌される体液や血液は練乳やミルクのようで、\n飲ませた相手を強壮し、軽い依存性をもちます\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@conecone_ch/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b36de123/uploads/origins/40ca3c19-f178-4d90-bd21-7ea99a985b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ee2103478c481f8edc9c71e07e1f6a7", "srcset": "https://si.imgix.net/b36de123/uploads/origins/40ca3c19-f178-4d90-bd21-7ea99a985b80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ee2103478c481f8edc9c71e07e1f6a7, https://si.imgix.net/b36de123/uploads/origins/40ca3c19-f178-4d90-bd21-7ea99a985b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4a0c00c7dcda76c83ce3a4831c9cf0d3 2x, https://si.imgix.net/b36de123/uploads/origins/40ca3c19-f178-4d90-bd21-7ea99a985b80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1c6aeda7cfcdde8190f032ae38b23b27 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3795034, "client_id": 3394590, "nc": 144}, {"path": "/@conecone_ch/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3795