6229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6c5de6ae7134f55af0bb155c1593270 2x, https://si.imgix.net/7a283acf/uploads/origins/8ef2cef3-1698-43ae-abf4-fb030ef6229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f371f650623f059c16e1c15f827cd083 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a283acf/uploads/origins/8ef2cef3-1698-43ae-abf4-fb030ef6229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a3aae70b6770c72dddd6a7cf90c64d1", "srcset": "https://si.imgix.net/7a283acf/uploads/origins/8ef2cef3-1698-43ae-abf4-fb030ef6229c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a3aae70b6770c72dddd6a7cf90c64d1, https://si.imgix.net/7a283acf/uploads/origins/8ef2cef3-1698-43ae-abf4-fb030ef6229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e91cb898712c90b16092623c0c2e5f3 2x, https://si.imgix.net/7a283acf/uploads/origins/8ef2cef3-1698-43ae-abf4-fb030ef6229c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66db0afd69c7559265d424e88b24b4c5 3x"}, "body": "①勇者の旅立ち\n王国の門から勇者たちが旅立とうとしている.\n上空からの視点で,彼らは点のような表記でよい.\n辺りは薄暗く,黄色い瘴気の霧に覆われている.\n彼らは魔王のせいであると考え,討伐のため旅立つ.\n\n②大陸の全体\n勇者たちの存在する大陸の全景.\n別の王国や山脈がある.\nそれらに詳細な表現は必要ではない.\n大陸は茶色い谷に挟まるように配置されている.\n大陸の隣には巨石や巨大などろどろした汚れた塊が同様に谷に挟まっている.\n大陸全ては薄暗く,黄色い瘴気の霧に覆われている.\n\n③さらなる全体像\n茶色い平野についた傷に勇者たちの大陸,そして他の大陸が緑の点のように多く挟まっている.\n平野の遠くには巨大な青い壁がある.\n辺りは薄暗く,黄色い瘴気の霧に覆われている.\n\n④世界の真実\n皮のブーツの内部構造に青い肌、そして黒い爪の足がある.\n勇者たちの世界は内部のつま先の空洞にある.\n勇者たちはブーツと足にとってのバクテリアであり，瘴気は足の悪臭のガスである.\n②の岩は砂, 汚れは足の垢である.\n\n⑤足の主\n青い肌，そして全てが黒い目の悪魔の女が皮のブーツを履き,槍を持って立つ.\n彼女は悪魔の世界の弱い戦士であり,魔王ではない.\n彼女の装備品は力に見合った弱いものである.\n勇者たちは悪魔の戦士には存在しないと等しく,真実を彼女も勇者たちも知らない.\n\n①②③④⑤5つの絵,そして物語を頼みたい.\n物語は日本の言葉でよい.\n詳細キャラクターは⑤のみ,しかし多くの数の絵と小説のため値段が足りないかもしれない.\nそうしたら断ることは可能である.\n私はあなたが受諾してくれることを祈る.", "nc": 16, "wor