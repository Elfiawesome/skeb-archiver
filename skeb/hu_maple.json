nt=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=133b42503316beb9247bb8bf3d6715cb", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1795, "client_id": 414298, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hu_maple/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1795, "client_id": 414298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/734f466f/uploads/origins/a5aeefb8-d7bd-4a35-b5fc-41e803164c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=443a86bbcdab79bce5b8bb851624e1ef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/734f466f/uploads/origins/a5aeefb8-d7bd-4a35-b5fc-41e803164c2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1363afefd880b4cb194500d6edd13dbc", "src_set": ""}, "body": "アポロさんにお願いしたいのは、私のキャラクター「テンペスト」のバストサイズを数種類描いてほしいということです。\nAA、A、B、C、Dが描いてほしいカップサイズです。\n\n(AAがテンペストのデフォルトのバストサイズ、A、B、C、Dは代替サイズです)\n\nキャラクターテンペスト\n年齢：18歳\n身長：170cm\nhttps://i.imgur.com/SUTQRQe.png\nhttps://i.imgur.com/6mReptq.png\nhttps://drive.google.com/drive/u/0/folders/1uaMW_xx9n2Z3yoRfaixQgmK0wQunaR0B\n\n彼女の耳の参考にどうぞ。\nhttps://i.imgur.com/ehXtbF9.png\n\n服装はお任せします。\n\n乳房に嫉妬しているような様子はNGです。\nそれ以外は自由に描いてください。\n\nポーズや構図はおまかせします。\nありがとうございました。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hu_maple/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1795, "client_id": 414298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3e6f435/uploads/origins/96fdf01c-70c7-41fb-badf-3ac5ae7b00fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=478ca025f09f933062511117e1d5d8e0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3e6f435/uploads/origins/96fdf01c-70c7-41fb-badf-3ac5ae7b00fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dea5c917f09c1f1c50938e1ab1762f91", "src_set": ""}, "body": "こんにちは、アポロさん。\nテーマを決めてキャラクターをデザインすることに興味はありませんか？\n\n今回お願いしたいのは、サキュバスの作画・デザインです。\n世界設定はファンタジーの世界です。\n\n髪や目、衣装などのデザインはお任せしたいと思います。\n\nサキュバスの特徴としては\n1.エルフのような尖った耳\n2.悪魔の翼\n3.悪魔の尻尾\n4.角はオプションです。\n\n以下の情報を記載してください。\n1.身長\n2.カップサイズ (AA, A, B, C, D)\n\n服装について、以下の2つは描かないでください。\n1.網タイツ\n2.ハイヒール\n\nこのようなリクエストに興味がない方も、どうぞご安心ください。\nありがとうございました。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 215311, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ろぐたろー", "screen_name": "log_008", "avatar_url": "https://pbs.twimg.com/profile_images/1717186026735808513/UpFMBEiQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/293492167/1698938265/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 160}, {"id": 287294, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "はすっぱサン", "screen_name": "hasppa1", "avatar_url": "https://pbs.twimg.com/profile_images/1969853416164966400/kCgwLM9E.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 161}, {"id": 401007, "creator": true, "nsfw_acceptable": true, "acceptable": 