/@Syroeli/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1876650, "client_id": 754180, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=885a7de97ade8d6472752607de173381", "srcset": "https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=885a7de97ade8d6472752607de173381, https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=80f3ded6b326bde9abc84b9479907d3d 2x, https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26180099dc70b2ed07559ee627c5135a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d93b77199a0611bb4747211275cb2e43", "srcset": "https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d93b77199a0611bb4747211275cb2e43, https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d762b25d81797ca056e31a6293f7fa26 2x, https://si.imgix.net/5fd58ed7/uploads/origins/9ea90565-a008-4c3d-bb30-47f898b424c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08896c301b65deee6df567ef4f148125 3x"}, "body": "Character-https://imgur.com/a/o5h0K6n https://imgur.com/a/2jXzPDW\nClothes-https://imgur.com/a/t7ZFMDb \nPlease draw the demon character wearing the clothes linked with the sword in a cool / battle pose. If you dont like the clothes you can choose the clothes you like. Her expression is somber and the background can be ruins or empty or of your choosing. The game is Elden Ring. Thank you.", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Syroeli/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1876650, "client_id": 38550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db7286a548dc8cf646acccf39a13457a", "srcset": "https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db7286a548dc8cf646acccf39a13457a, https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b3bdff1b617863bf4f352026935daf1 2x, https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ee632be3a366c2c7afe1551fb1066aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb178757459f99e5caa827027a3a445", "srcset": "https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cb178757459f99e5caa827027a3a445, https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2c461dc831e6778ad35bd4ae8014e6e 2x, https://si.imgix.net/64dd59e9/uploads/origins/953a5402-8b03-4a40-813e-5a2caec084db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7aa02db3247ad9d045b4141b946dac3a 3x"}, "body": "自分のOCを描いてくれませんか？\n\n人物设定: 帝国騎士団の中でも数少ない貴族女騎士.魔法キャスターと剣の腕は彼女の誇りです．所属する団では副団長を務める．容姿良し，気立て良しと，非常に人気がある．\nOC参考画像：https://imgur.com/UwPugNt, https://imgur.com/inkagk7, https://imgur.com/xK6Vl7d\n\nテロ組織によって開催された闘技場で，彼女前は複数のS級の人造怪物だ．この怪物だちはスーパー再生能力と学習能力を持っている．\n数時間の戦いの後，彼女は自らの装備は不完全，そして持続的魔力を吸収能力がある首輪を無理矢理付けられたによって（魔力は魂と繋がっているので，もしこの首輪を強引に外れば，運がいいならば一日中に意識中断になる），絶境に陥った．\n数匹の怪物を何とか倒したが，彼女は力尽くし，片足が土下座し，剣を地に挿して身を支えてる．\n服も戦いによってボロボロ．彼女は残した怪物たちに囲まれた．\n（…これも錬金術の仕業…何といいう脅威度だ…！このままじゃ…もしここで負ければ，きっとテロの雑魚たちに…何とか逃げ道を探せ，早く騎士団に報告を…！くぅ…どうすれば…！）\n\n※彼女の髪型はポニテで，片側には髪の毛を垂下があります．\n※彼女の衣装は上半身はplain clothes，下半身はmilitary uniform．\nできれば彼女の絶境にいると，ちょっと少し険しくなってきたくらいの表情を表現してください．\n\nご検討のほど何卒よろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 33233, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "朔月八雲@コミティア156 O72b", "screen_name": "hassaku401", "avatar_url": "https://pbs.twimg.com/profile_images/1686756968948473856/4F_SbYWw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/800259115192721409/1758639454/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "correction"}], "nc": 129}, {"id": 272862, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うたぺいん", "screen_name": "U29044241", "avatar_url": "https://pbs.twimg.com/profile_images/1621132556757512194/CHWYgK_Y.jpg", "header_url": "https://pbs.twimg.com/prof