d407?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3dd59a20db993033180f06afc1677c0c 3x"}, "body": "BTMR様\n初めまして。SNSでお見かけし、素敵な絵柄に惹かれ、skebを募集されていたのでリクエストさせていただきました。\n\n〇キャラクター詳細 \n 34歳　男性　職業：裏向きは市の支部長、表向きはビジネスマン\n\n支部長としての経歴はまだ短いが、優れたカリスマ性や指揮能力が高く、リーダー的存在として責任感が強い男性。社交的であり仲間や部下から信頼されている。時間の規律はしっかりと守る、管理することが得意。\n優しい性格の持ち主だが時には現実的で冷徹な、厳しい言葉も放つ合理主義者。\n\n〇使用用途\n・SNSやdiscordのアイコン\n・PCやスマホの壁紙背景\n\n 服装はキャラクターの全身資料の方でお願い致します。その他に関しましては描きやすいように簡略して頂いて構いません。 \n構図やシチュエーションもおまかせします。\nご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1YZ-B3fPIoPTJ4ZZ3mnBEGdF3c8XqsnrX?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BTMR/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4017347, "client_id": 4058931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccfc02abd98ee6e814a09f0ce2ba29c1", "srcset": "https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccfc02abd98ee6e814a09f0ce2ba29c1, https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2fc42330eaf489265d145e49e4ab3978 2x, https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f7e45fc36754f50bed4ef622d577c69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bd509c5e419eee45ab0a6a343409f57", "srcset": "https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bd509c5e419eee45ab0a6a343409f57, https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f1f8777d9f56a48849fc266f753095e 2x, https://si.imgix.net/d2ee8e2a/uploads/origins/17b6d65e-5363-4cd3-a599-0bbc24ed8e8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91a4552cf3eb7a04b5d204627fdf45b2 3x"}, "body": "いつも素敵なイラスト拝見しております!skebをされているのを見て、再開を心待ちにしておりました…!\n本当に線画も色塗りも構図、ポーズ、演出ともう全てにおいて好きです……!\n\nもしよければ私のオリジナルキャラクターをお描きいただけないでしょうか？\n蛇を擬人化させたようなコンセプトの森の神様で、堕落したために普段は人里離れた森にいるけれど現代を楽しむべく都会に溶け込むような姿でいる、年齢も性別も不詳でどこか掴み所がないというキャラクターです。\n女の子が広義の意味で「好き」なので、今は女子高生の姿になっているという設定になっています。\n\n構図や表情、ポーズ等はBTMRさんのセンスが好きなので全てお任せします!!よろしくお願いいたします!\n\nhttps://drive.google.com/drive/folders/1ibwLFeil4wvCpvN-ur4HwoEnY-kDUEXP", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BTMR/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4017347, "client_id": 2850907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffdfe214abfdadb9eea035f0a0867c8", "srcset": "https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ffdfe214abfdadb9eea035f0a0867c8, https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdc2826152eee6bdad36b2154cf7e7c7 2x, https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f60e817a7d47acf7cd052f4fb565cf2a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2934ef39c63f44aba2d9624ff80d2d35", "srcset": "https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2934ef39c63f44aba2d9624ff80d2d35, https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dac359844a75a8b10402310a2ba9545 2x, https://si.imgix.net/a70f3265/uploads/origins/6ac039dd-3a94-4094-a7d3-cbd92098d226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e4f11a87def83f7eff17759cf07a759 3x"}, "body": "初めまして。\nリクエスト失礼します。\n良ければ私のOCを描いていただきたいです…！\n\n以下簡単な説明になります。\n\n名前:シャクヤク\nフリーターを経て裏社会に転がり込んだ、明るい性格の男性。\n・どこか掴みどころがなく、謎に包まれている節がある。少し子供っぽい。\n・まだまだ転がり込みたてなので、組織の下っ端(構成員の数十人をまとめあげる程度)だがボスのお気に入りでもある。\n・服に無頓着なためボスが買ってきた服を何となく着ている。\n・隠し持ったナイフと銃を仕事で使うのが好き。\n・夜〜明け方に活動している。\n\nナイフを振りかぶっていたりなど、動きのある構図だと嬉しいです！ぜひ楽しく描いてください！\n服の着方等も変えて大丈夫です。\n\nラフもあればファイルに残していただけると嬉しいです。\n\n使用用途：観賞用、SNSのアイコン、個人用のグッズの制作\n\n検討していただけますと幸いです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1JysAHA3BjtK1JV4uUiy1CEI5cmRC--uu", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BTMR/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4017347, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdf2c4ab/uploads/origins/25cdd080-9fa0-48d2-bfad-aca6beed6cc0?bg=%23fff&auto=format%2