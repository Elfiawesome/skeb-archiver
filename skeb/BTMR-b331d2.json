&h=200&s=bf7dc2ba31e88d461778b065a8bb5fd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2adb97c8/uploads/origins/17b3b16a-690a-4c38-b78a-0b6dfea73011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1861780067904fabbd915b704f44280", "srcset": "https://si.imgix.net/2adb97c8/uploads/origins/17b3b16a-690a-4c38-b78a-0b6dfea73011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1861780067904fabbd915b704f44280, https://si.imgix.net/2adb97c8/uploads/origins/17b3b16a-690a-4c38-b78a-0b6dfea73011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=044ef6addb8e4dd332799cdeda22569d 2x, https://si.imgix.net/2adb97c8/uploads/origins/17b3b16a-690a-4c38-b78a-0b6dfea73011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6b8e566a7fe7d7e5dcb320f7fce102a 3x"}, "body": "こんにちは！！ あなたのイラストが大好きです。もし私のキャラクターを描いていただけたら、とても嬉しいです。\n\n彼は動物やかっこいいものが好きなトラです。  \nお好きなかっこいいポーズで描いてください。\n\nキャラクターの参考画像：\nhttps://vsona.co/xue-5/xue\n\n別のリンク：\nhttps://drive.google.com/drive/folders/1_f8_T64z7Wlb5IHEnAKSAisG6fU0gqLy\n\nこのイラストをSNS（Twitterなど）に投稿させていただくかもしれません。\n\nよろしくお願いします！( * ॑꒳ ॑*)\n\nhttps://vsona.co/xue-5/xue", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BTMR/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4017347, "client_id": 814521, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b31c1f10/uploads/origins/5fcfb7ea-ea86-4c55-9317-b2fd91db9c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8ef643840b0e52c2ed8952e6f96b1d5", "srcset": "https://si.imgix.net/b31c1f10/uploads/origins/5fcfb7ea-ea86-4c55-9317-b2fd91db9c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8ef643840b0e52c2ed8952e6f96b1d5