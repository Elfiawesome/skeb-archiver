のコンセプトを最大限に活かして、ポーズや色選び、新しい衣装やヘアスタイルのデザインなど、自由に創作してください。 また、ラフスケッチや下絵などがありましたら、ぜひお送りください。\n\nhttps://drive.google.com/drive/folders/191n8LnDMEKOQgJWDE_c4grfmL8Aoc8Nr?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BTMR/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4017347, "client_id": 2885706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff599e23b8f73b8410c490fd5d01e701", "srcset": "https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff599e23b8f73b8410c490fd5d01e701, https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4e4dceec134ea46ba73fb35fa096a39 2x, https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa4e55d1f204df4acd62260405050e20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec8be5aa8ec669c265686383ee80da51", "srcset": "https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec8be5aa8ec669c265686383ee80da51, https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8e2da1012bcb7c0c8b7916130b050c1 2x, https://si.