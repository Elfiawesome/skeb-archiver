c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c8d3190509edf223e9f0d0aff2b5185 3x"}, "body": "先生、こんにちは。先生の作品が大好きなので、私のオリジナルキャラクターを先生のスタイルで描いていただけないでしょうか^^。  \n「バーボン」：白い巻き毛のこのキャラクターは、若い吸血鬼の少女で機械工です。身長155cm、見た目は12～15歳くらい。赤い瞳、白い眉とまつげ、青白い肌、可愛らしい小さな牙、平らな胸、 右足は義足で、明るく無鉄砲、おてんばと小悪魔が混ざったような性格で、人間というよりはむしろ獰猛な動物に近い存在です。武器、おもちゃ、馬、お菓子が大好きで、1880年代のアメリカのスチームパンクな町で小さな機械工房を経営し、困っている人たちのために義足を設計・提供しています。 彼女のモチーフは、時計の歯車、機械、デザート、血と肉、遊園地、荒れ地などです。\n依頼内容については、具体的な指定はありません。詳細やデザインはすべてあなたにお任せします。このコンセプトを最大限に活かして、ポーズや色選び、新しい衣装やヘアスタイルのデザインなど、自由に創作してください。 また、ラフスケッチや下絵などがありましたら、ぜひお送りください。\n\nhttps://drive.google.com/drive/folders/191n8LnDMEKOQgJWDE_c4grfmL8Aoc8Nr?usp=share_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@BTMR/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4017347, "client_id": 2885706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff599e23b8f73b8410c490fd5d01e701", "srcset": "https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff599e23b8f73b8410c490fd5d01e701, https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4e4dceec134ea46ba73fb35fa096a39 2x, https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa4e55d1f204df4acd62260405050e20 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48cf1cdc/uploads/origins/fe1d6d31-f8d7-4d4d-9808-c096751ef64f?bg=%23fff&auto=format%2C