ているのですが、人間モード時です。\n\n服装はこちらのままでも、描きやすいようにアレンジしてしまっても、お好みでお願いできたらと思います！\n\nたくさんご依頼があるかと思うので難しいかと思いますが、\nご縁がありましたらよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 122893, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "巣鴨", "screen_name": "illu_kamo", "avatar_url": "https://pbs.twimg.com/profile_images/1932293968135663616/V7sH5y8Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2920686949/1632544844/1500x500", "appeal_receivable": false, "popular_creator_rank": 89, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 380655, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "×のこちゃま×", "screen_name": "xnokochamax", "avatar_url": "https://pbs.twimg.com/profile_images/2102745135734030336/d7KHHrHq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1203536171663446016/1791800351/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 688621, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "寝晩/ƝᕮᙖᗩƝ🍈", "screen_name": "NEBAN_nebaaan", "avatar_url": "https://pbs.twimg.com/profile_images/1754368452985495552/d_-xP1mE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1154328664378449923/1771678119/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"g