%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b54f6a6cb6a09ad65b9a785081d4c36d", "srcset": "https://si.imgix.net/b8335e64/uploads/origins/f0922062-9b24-4707-866b-f1c7c0718a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b54f6a6cb6a09ad65b9a785081d4c36d, https://si.imgix.net/b8335e64/uploads/origins/f0922062-9b24-4707-866b-f1c7c0718a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6dbb3cd0673f09ec0cb39addaa19870 2x, https://si.imgix.net/b8335e64/uploads/origins/f0922062-9b24-4707-866b-f1c7c0718a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6dc94cc6e4bf98f595556284e8cce771 3x"}, "body": "こんにちは。\n何時も素晴らしい作品をありがとうございます。\n\nリクエストはマギアレコードの十咎ももこちゃんがナンパされているイラストです。\n\n服装はアプリ内で着ていた水着（https://x.com/magireco/status/1026407583257686017）\nナンパ男の「かわいい！」「水着似合ってる！」などの言葉にまんざらでもない様子で。\n\nあと、胸元とお尻のアップをそれぞれ画面の端に描写してほしいです。\n\nあれこれ注文を付けてしまい大変恐縮ではありますが受けて頂けたら幸いです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hataoribeyn/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 649342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eba17425238aa7e718fafdc7ef75be46", "srcset": "https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eba17425238aa7e718fafdc7ef75be46, https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0af9270eebdde7980e120a67bc46c3e 2x, https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe7c64e940a8f72a948a9fc493415caf 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c525f07c38ceafc4b03afd00ee77c60", "srcset": "https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c525f07c38ceafc4b03afd00ee77c60, https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=859bd7db92ad6b8274e8ce08fddea839 2x, https://si.imgix.net/a606738d/uploads/origins/aa2d1d57-c9db-4f59-be64-5464763e2090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=715698055bb9dcf6ba776fc31b8b6cf8 3x"}, "body": "こんにちは。\nいつもはたおりべ様の作品にお世話になっております。\n\n今回リクエストするのは、以前にskebで書かれたサーシャの漫画の続きになります。\n\n今度は男の部屋を訪ねて奉仕することになり、一通りヤリ終えた後\n最後に布団の上で横になりながら、男が撮影した自分と先生が写った写真を\n虚ろな目で眺めるといったカットで終わる。という感じで\n\n今回は「コイカツ」というゲームで作成した画像をご用意しましたので、そちらを参考にしてください。\nhttps://drive.google.com/drive/folders/1aTRYDh5FClJzpbpPJ6u67C60o4LR1ifs?usp=sharing\n\n以下は詳細な要望になります。\n・ページ数は３ページ程。\n・セリフは無く、効果音と喘ぎ声のみ有り。\n・男のみ体毛と陰毛の描写有り。\n・背景は基本無くてもよいですが、布団のしわと脱ぎ捨てられた服や下着、外から構図にある窓の描写はして頂きたい。\n・可能であれば文字無しの差分を希望。\n\nいろいろと注文を付けてしまい誠に申し訳ありませんが、もし受けて頂けたら幸いです。\n\n以上、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1aTRYDh5FClJzpbpPJ6u67C60o4LR1ifs?usp=sharing", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hataoribeyn/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 649342, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b421f02ee5e5c487c76168087453c6", "srcset": "https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83b421f02ee5e5c487c76168087453c6, https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c867649961a18be6a41ede159ad237ed 2x, https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9d4c22b13ab62e325601c24308bd22b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96dc8436eed1b4f231c2c80b1255570b", "srcset": "https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96dc8436eed1b4f231c2c80b1255570b, https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fcd626db6a1137c5a3772444de8bfcc1 2x, https://si.imgix.net/cb5ec599/uploads/origins/1df1769e-3838-4a51-a18a-94a48a059db6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21319361e6faf92b2879c3c12936d76e 3x"}, "body": "はたおりべ先生の描くマギレコのやちよさんのエッチな絵を見てみたいです。\nやちよさんが全裸で煽情的なポーズをとっているイラストをお願いします。\n可能なら優しく微笑んでる顔と嫌そうな顔の差分が欲しいです。\n\nよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hataoribeyn/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 649342, "vt