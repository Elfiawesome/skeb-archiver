00&blur=200&s=a9909a0fc90909755f295520c1bd77bc, https://si.imgix.net/baa44752/uploads/origins/529f78f9-cc6d-48e9-8a6f-9d4a43a819d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1faf4c9c18841286074741fb380c661b 2x, https://si.imgix.net/baa44752/uploads/origins/529f78f9-cc6d-48e9-8a6f-9d4a43a819d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=484d4d2deba0dc185d6b23831d26bfd9 3x"}, "body": "前回は旭ちゃんの漫画ありがとうございました。\nまたリクエストさせていただきます。\n\nまどかマギカの暁美ほむら（メガネ）の漫画をお願いします。\nシチュエーション\n夜の教室で大勢の男子生徒に輪姦される。\n膣とお尻の穴に挿入されて悲鳴を上げている（処女喪失してうっすら血が出ている）\n服は制服、大きめの胸は丸出しで鷲掴みされる\n挿入前の怯えて嫌がってるシーンと射精されて絶頂するシーン、\n何度も輪姦されて大量の精液が付着して息も絶え絶えなシーンがあると助かります。\n途中で三つ編みが解けてくれると嬉しいです。\n\n男子生徒のセリフで「今日から俺たちの肉便器だ」のようなセリフを入れてください。\n\n以前拝見したアオちゃん漫画のような感じでお願いします。\n\nどうぞ宜しくお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hataoribeyn/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 649342, "client_id": 3448943, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19bef54e/uploads/origins/664f4046-9b92-4b96-9420-5b6003244e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe8424d78c7fa39d9f555a82c7563de", "srcset": "https://si.imgix.net/19bef54e/uploads/origins/664f4046-9b92-4b96-9420-5b6003244e57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efe8424d78c7fa39d9f555a82c7563de, https://si.imgix.net/19bef54e/uploads/origins/664f4046-9b92-4b96-9420-5b6003244e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4267e2fc03dcb2032cac87e9e30c285d 2x, https://si.imgix.net/19bef54e/uploads/origins/664f4046-9b92-4b96-9420-5b6003244e57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd7196fac3ddbdd2de654261a314709d 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnai