ても太らないと信じている。ルビーの小さな体ではコンテストに勝つチャンスはないと考え、ルビーをあざけり、軽蔑する。コンテストが終わる頃には、ルマとリサはドーナツの食べ過ぎで太り、肥大化し、負けを認める。一方、ルビーは体重が増えておらず、気にせず食べ続ける。\n\n設定に合わせて、どんなカジュアルな服装を着せてもOK。\n\nhttps://imgur.com/a/BqBz9jJ", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riman13682518/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3108635, "client_id": 2685081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cea95b4e/uploads/origins/bb5923b8-499c-4932-9bba-aeb9de44a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2118673d4f2793327df32b35cb75e91a", "srcset": "https://si.imgix.net/cea95b4e/uploads/origins/bb5923b8-499c-4932-9bba-aeb9de44a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2118673d4f2793327df32b35cb75e91a, https://si.imgix.net/cea95b4e/uploads/origins/bb5923b8-499c-4932-9bba-aeb9de44a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ae156ddd58546934885d0ab3fd72ec8 2x, https://si.imgix.net/cea95b4e/uploads/origins/bb5923b8-499c-4932-9bba-aeb9de44a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdb9ab8d463d0d714634a640802833fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cea95b4e/uploads/origins/bb5923b8-499c-4932-9bba-aeb9de44a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e85ae0da80cabb2d132e8c2b43beb0a", "srcset": "https://si.imgix.net/cea95b4e/uploads/origins/bb5923b8-499c-4932-9bba-aeb9de44a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e85ae0da80cabb2d132e8c2b43beb0a, https://si.imgix.net/cea95b4e/uploads/origins/bb5923b8-499c-4932-9bba-aeb9de44a0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a5b650c6c27a2879c3bfdb9cff32c