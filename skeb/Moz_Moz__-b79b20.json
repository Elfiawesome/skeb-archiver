e22-4c15-b150-d9bea109fae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a91e05397980fa33fb78aff878273b4d 2x, https://si.imgix.net/b305132d/uploads/origins/e3c86355-be22-4c15-b150-d9bea109fae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61fccd5a49150212006f2695d3c80096 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b305132d/uploads/origins/e3c86355-be22-4c15-b150-d9bea109fae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7be0892a0b4050fba232af6a312a18b", "srcset": "https://si.imgix.net/b305132d/uploads/origins/e3c86355-be22-4c15-b150-d9bea109fae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7be0892a0b4050fba232af6a312a18b, https://si.imgix.net/b305132d/uploads/origins/e3c86355-be22-4c15-b150-d9bea109fae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=91dabbccd58230a52de7fed25955eb1a 2x, https://si.imgix.net/b305132d/uploads/origins/e3c86355-be22-4c15-b150-d9bea109fae6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed10f8b1f6eb045500575fca5e25cac6 3x"}, "body": "こんにちは。いつも真坂さんの素敵なイラストを拝見しています。\n真坂さんの暖かな雰囲気の線画や色使いが大好きで、是非skebを依頼したいと思い連絡させていただきました。\n\n今回描いていただきたいキャラクターは私のクトゥルフ神話TRPGのPCです。『白百合の殻』というシナリオをPC2にて通過したキャラクターとなっております。\n（依頼文・資料にシナリオのネタバレは含まれておりません）\n\n構図としては、チョークを持ったキャラクターが目を輝かせ、難しい数式を楽しそうに解いている、といったものでお願いしたいです。\n難しければ変更していただいても構いません。ただ、出来れば数学の要素は取り入れてくださると嬉しいです……！\n\n用途としては個人の鑑賞・待ち受け等の個人使用のみを考えております。\n\n資料や金額の不足等あれば再送要請を送っていただけるとありがたいです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-3tsv3U5DPi2x6w3Dbz0rylrXbLCRGxn", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Moz_Moz__/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1351517, "clie