ont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f63d06279a59056f7e616240929bee0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 648713, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tutinoke3461/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 648713, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3771790b/uploads/origins/c69b0927-2d18-4b52-a4db-e6a6d3165aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a22c57649099a76f4e1d97f6a00f2af", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3771790b/uploads/origins/c69b0927-2d18-4b52-a4db-e6a6d3165aa0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15a9f16ce07d8507b7753ef31b51cd49", "src_set": ""}, "body": "遊戯王OCGのDDパンドラと一対一のボテ腹中出しエッチ\nhttps://pbs.twimg.com/media/CdMJbKiVAAATZRH?format=jpg&name=large\nカラーイラスト\n\nイメージ\n顔、おっぱい、お腹、結合部が見えるものでおまかせ\n中出しの瞬間でビューっと射精、結合部から精液溢れる\n絶頂でおしっこお漏らし\nボテ腹は大きい、臨月のお腹\n相手の男は顔など映らず誰だか分からない\n\nDDパンドラ\n体の下部に鍵穴があり、それがパンドラの性器となる\n鍵穴そのものだとチンポを入れた場合硬そうなので人間のそれの形になる\n箱部分にある緑の装飾がデベソになる、ここがボテ腹部分\n箱の装飾は簡略化しても問題ないです\nそのデザインが難しい、イマイチエッチじゃないだと判断した場合は別でもOK\n\n頭身は低く4頭身、デフォルメ体型\n\n顔はベルトに巻かれ表情は分からないのでハートを浮かべるなどで感情を示す\nイメージ\nhttps://www.pixiv.net/artworks/93778299\n\n服装\n頭にかぶる布\nドレスは体と一体化しているイメージ、ただし胸部より上の肩部分は無しでOK\n胸をペロンと捲っておっぱいを出しても大丈夫\n腕に巻いているベルトは無しでOK\n\nセリフはおまかせ\n難しい場合は無しで大丈夫\n\n・カラーイラスト\n・一応ラブな感じ\n・修正は黒線などモザイク以外\n・痛そうなのは駄目", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tutinoke3461/works/70", "private_thumbnail_image_urls": {"