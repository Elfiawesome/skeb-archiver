412, "client_id": 1717295, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@_k7ya_/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1584412, "client_id": 1717295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e239716/uploads/origins/f9ef10f1-33d2-47ac-8d4f-46dfbdca637b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9340e7b2b9048387fc4a9ba7d605b1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e239716/uploads/origins/f9ef10f1-33d2-47ac-8d4f-46dfbdca637b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d6f4d1f717aab289a08f0f51358277f", "src_set": ""}, "body": "すこしセクシーな私一人のイラストを希望します。\n利用用途はツイッターのヘッダーや、VRCHATのワールド（自作）に貼ったり\nすこし子供っぽいところがあるので、イラストの中ではすこし大人っぽい雰囲気を\n希望します。\n背景の参考資料はドライブあっぷします。\n資料はこちらのURLへアップします\nhttps://drive.google.com/drive/folders/13_kYrYRAaPh844G3BuhjsvNH6fCPyTI1?usp=sharing\n\nhttps://drive.google.com/drive/folders/13_kYrYRAaPh844G3BuhjsvNH6fCPyTI1?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1584412, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8aa146f7/uploads/origins/40067ff6-3956-4139-b07f-0b5cbeba3579?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c1af89f5479cc0da7611a0607978e4a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8aa146f7/uploads/origins/40067ff6-3956-4139-b07f-0b5c