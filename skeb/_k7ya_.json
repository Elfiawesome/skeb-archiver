s/origins/452fa0d9-de17-46b6-80d1-bed0c5c5d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33f7ce7db7ed0ef485f06cad2f7ca29d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f211822/uploads/origins/452fa0d9-de17-46b6-80d1-bed0c5c5d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=587657283ef3f7b111fd55c71b1a3e43", "src_set": ""}, "body": "けぇなさんこんにちは、今回初めてSkebを依頼します。\n現在VRChatで使用している私のアバター(舞夜)のR18絵を依頼したいです！\n\nお題は感覚遮断穴でシチュエーションや服装はお任せして、ふたなり(大きさもお任せします)でお願いします。\nアバターはわたしのTwitterのメディア参考にしていただければ幸いです。\nURLːhttps://twitter.com/isu_vrc\n(画像が少ないかも…）\n\nお題がふわっとしてて申し訳ないですがよろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1584412, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89155cc3/uploads/origins/eda79e7d-7f2b-4d0e-9935-d307a88b91ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e57fee501c7f805ab1fb573d05c441cf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89155cc3/uploads/origins/eda79e7d-7f2b-4d0e-9935-d307a88b91ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57a4feb842d1e03723dea084d10068d7", "src_set": ""}, "body": "こんばんは\n\nVRCで見かけた下記アバターでイラストを描いて頂きたいです。\nhttps://oitan.booth.pm/items/3375647\n\nバージョンなど\n・Hair TypeB\n・角無し\n・Ear Small\n・髪色は変えられるように別レイヤーだと助かります。\n\n構図など\n視点：男性視点\n衣装：半脱ぎで胸は露出\nシチュ：騎乗位\n表情：強気顔からのアヘ顔\n\n以上、よろしければお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a4bda1a2/uploads/origins/6bff72b2-7bad-4706-b669-b9129da0ac54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9620c862e18276f2fa966cae139fe05", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1584412, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@_k7ya_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1584412, "client_id": 999964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3be938f0/uploads/origins/547196c2-1d9a-4d94-8455-832095949582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0da0d3059581319e0a2414467baa253e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3be938f0/uploads/origins/547196c2-1d9a-4d94-8455-832095949582?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4f93f9c9483507ee62449e74aaca0a1", "src_set": ""}, "body": "どうもこんにちわ。\n今回はウチの子の触手催眠姦イラストをお願いしたいです。\n\n○キャラクター　フライア\n竿玉有りのシーメール。\n衣装は前回の退魔シスターのぴっちりスーツ(https://skeb.jp/@_k7ya_/works/9)\n触手の体液か何かでぴっちりスーツの一部が溶かされ穴が空いていて、ちんぽは丸見え、乳房も一部が露出している感じにしてください。\n\n構図は、下記の参考画像の様に、直立した状態で太ももから下を肉壁に飲まれつつ、二の腕から先を触手に掴まれて四肢拘束状態。\n参考画像　https://twitter.com/intent/favorite?tweet_id=1597584002852216833　これの右側のキャラクターのイメージ\n\n以下詳細で、\nフライアの視線の先に、催眠をかけている目玉っぽい触手がいて、フライアと互いに見つめ合っている。\n　目玉触手とフライアの目を同じ色の妖しい感じ色で仄かに光らせて催眠されてる風味にしてください。\n頭上後方から伸びてきた太めの触手を後ろからアナルに入れて、お腹をアナルから入った触手で少し盛り上がらせてください。\n　アナルそのものは見えない構図になって構いません\nちんぽは勃起し、鈴口から触手が侵入して尿道と両方の陰嚢がボコりと触手で盛り上がっている尿道姦＆睾丸姦\nおっぱいに触手が絡んでぎゅっと絞り上げていて、スーツ越しに乳首が立っている。\nフライアの表情は、困り眉で喘ぎ声を上げている風に口を開けながら目の前の目玉触手から目を離せない辛うじて催眠に抗っている状態\n\n催眠完了差分として、\n触手から解放されたが、勃起したまま鈴口からところてん精液を垂らして糸を引いており、前方の肉壁触手の床が精液で汚れている射精済み状態\nアナルに入っている触手の途中の管がいくつか球状に盛り上がり、産卵産み付けしている風に膨らんでいる\nお腹がアナルから入った触手に産み付けられた卵でさらにボコボコっと盛り上がっている\n触手に絞られているおっぱいのスーツの乳首部分が完全に露出していて、立った乳首から母乳が垂れている\n表情は、催眠の光で目を仄かに光らせたまま完全に堕ちたようなレイプ目にして、恋人と愛し合って悦んでいるような幸せな笑顔\nをお願いしたいです。\n\n以上です。\nよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/405a92c5/uploads/origins/42cce083-3567-456c-8e64-6186d922577e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fa2db088a79f506bf31ad3adaf153b36", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1584412, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@_k7ya_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1584412, "client_id": 1621717, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2d80b4b/uploads/origins/6b9b0db9-1208-420a-91cb-d46be53edc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adc48ba1ca8f40eed38270a05c5f52fe", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2d80b4b/uploads/origins/6b9b0db9-1208-420a-91cb-d46be53edc53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=171ce39f3204bb50c7f4015a1d03a8e8", "src_set": ""}, "body": "こんにちは\nまたVRCで使っているわたしのアバターのえっちなイラストをお願いしたくリクエストさせていただきました\n以前に描いていただいた\nhttps://www.pixiv.net/artworks/103958618\nのアバターです\n最近は角の形状が変わったり\nお腹や胸に淫紋が入っているので参考用の資料URLをこちらに置かせていただきます\n\nhttps://drive.google.com/drive/folders/1Y6E9uhRELS9ELW_LeykO0p63oOGOcqlN\n\nシチュエーションとしては\n以前にお願いした\nhttps://skeb.jp/@_k7ya_/works/7\nこちらと同じように\nわたしがVRCのアバターで輪姦レイプ撮影されて、その映像が販売されたときのパッケージ絵をお願いしたいです\n表パッケージ画像は\nまわりを竿役に囲まれた状態で、両腕を掴まれてピースサインとがに股ポーズを強要されて、膣内にさんざん出された精液が零れ落ちているのを撮影されている姿でお願いします\nイメージとしてはこのような形です\nhttps://www.pixiv.net/artworks/99886860\n\n衣装は参考用資料の衣装でも\nけぇなさんの考えたどすけべ衣装でも\n全裸でも歓迎ですが、全裸の場合はやはり首輪か首枷がついていると嬉しいです\n汁を多めにしていただいたり、たくさんひどい目に遭っているとやはり嬉しいです\n\n以上、よろしくお願いします", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1584412, "client_id": 977345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f4220be/uploads/origins/4b5e60ee-57fd-4e5b-adbd-1337bf1e386d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cdaf30a4b5227a8dd910ada8f6e0051", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f4220be/uploads/origins/4b5e60ee-57fd-4e5b-adbd-1337bf1e386d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9b187af9d46f8300e7c8142ef5492a6", "src_set": ""}, "body": "けぇな様こんにちは\n\n私のツイッター、VRC上での姿である鈴蘭ちゃんを描いて頂きたいです\n特に構図指定等はございません\nキャラクターのイメージは幼児、無邪気な感じです\n\n鈴蘭ちゃんの資料となります↓\nhttps://twitter.com/convallatoxin_2/status/1515351667780177920", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1584412, "client_id": 54147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7db6bf6c/uploads/origins/893f143e-ddbd-4dd7-9051-f03c56373699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df19a0b9fc3cd30038d815ddac423721", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7db6bf6c/uploads/origins/893f143e-ddbd-4dd7-9051-f03c56373699?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=255b2424deb1533cfa3c5ceb00c65ded", "src_set": ""}, "body": "依頼文の訂正で再度飛ばしました（ご迷惑をおかけします）\n\nまた是非ともご依頼させて下さい。\n可能であれば前回のように複数枚差分ありでお願いできますでしょうか。\n\n依頼シチュエーションはベッド上で寝転がりガニ股/カエル脚でま○こを指で広げているような誘い受けしているシチュエーションでお願いしたいです。\n・発情顔\n・タイツは破られていて股が見えるように\n・彼シャツで前は開けている\n・新のコンドーム等を口に咥えている\n・首輪ハーネスは残していただきたいです\n\n差分内容\n・全裸\n・サテン系の手袋（肘よりも上）とニーハイのみの差分\n・乳首やクリにピアス着用（形状はお任せします）\n・ボテ腹、乳首等の黒ずみ差分\n・ボールギャグ、目隠し差分\n・使用済みコンドームがちりばめられている、若しくは丁寧に太ももに並べ置かれている\n・中出しされてこっぽりと精液が垂れている\n・仰け反り、アへ顔、痙攣等の描写があると嬉しいです。\n・落書き描写（正文字、ご主人様専用、性処理便女などなど…（資料に参考画像入れておきます。））\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1177L-1xzuiWtNST8uZDt6tuYOqIQb-Q3?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1584412, "client_id": 999964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73b98055/uploads/origins/92f2d744-406e-413f-b027-78fea54ed4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=165af177d7d1bfc8688e640b571a9f18", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73b98055/uploads/origins/92f2d744-406e-413f-b027-78fea54ed4e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0910ca2fe97f355055e507383acab38a", "src_set": ""}, "body": "どうもこんにちわ。\n前回(https://skeb.jp/@_k7ya_/works/2)はウチの子の街娼風イラストを有難うございました。\n今回はウチの子の着せ替え立ち絵イラストをお願いしたいです。\n\n○キャラクター　フライア\n着衣　https://imgbox.com/mo7eF7II\n下着　https://imgbox.com/SQ74RL8q\n裸　https://imgbox.com/6ymkOGWW\n※竿玉有りのシーメールです。\n\nウチの子のシスターの服を以下のような退魔師(退魔忍)風のぴっちりスーツタイプの服に変えて退魔シスターにしてほしいです。\n参考画像1　https://www.pixiv.net/artworks/77831965\n\n装飾品は以下をお願いしたいです。\n・参考画像1と同じく、シスター風帽子とロングブーツ\n・グローブは指抜きグローブにして指の紫色のネイルが見える感じ\n・手持ち武器は無し\n・ロザリオの代わりに首にキャラ参考画像(着衣)の紫宝石のネックレス\n・股間部分は以下の参考画像2のような勃起ちんぽが浮き上がっている竿玉袋の形状に\n参考画像2　https://www.pixiv.net/artworks/74338087　これの2ページ目\n\n構図は以下のような前後2パターンを1枚に収めた感じの立ち絵。\n参考画像3　https://www.pixiv.net/artworks/96070163　これの3ページ目\n\n可能であれば、竿玉袋の無い完全女体バージョンの差分も頂きたいです。\n\n以上です。\nよろしくお願いします。", "nc": 51, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_k7ya_/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9d7f2e4e/uploads/origins/4dc29b77-9235-4d92-8f8a-67539e3654aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d64db1ad6675ef5faa6aa9e05655a99", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1584412, "client_id": 1861992, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@_k7ya_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1584412, "client_id": 1621717, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8288129/uploads/origins/8e102ca2-ab7e-437b-bc11-c6374ffdfaed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=229d112ac7206c35a219dcaa6bf0bd2b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8288129/uploads/origins/8e102ca2-ab7e-437b-bc11-c6374ffdfaed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34f4f0766354a26798f2af9244c06711", "src_set": ""}, "body": "こんにちは\nVRCで使っているわたしのアバターのえっちなイラストをお願い