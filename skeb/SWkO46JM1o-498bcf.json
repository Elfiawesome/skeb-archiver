インを入れていただけますと幸いです。\n\nElda、衣装、シチュエーションの参考資料をGoogle Driveのリンクにまとめております。\n\nご検討いただきありがとうございます！もし金額がご希望に合わない場合は、価格についてご提案いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1eOTq2Kt4_IRoDP7kQ9y7EPHDxeFRldm4?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SWkO46JM1o/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4848f778/uploads/origins/1081a2b0-7aeb-4070-90da-d3aad1f4ba33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c004ca31a0fa426edbafd37e652f89a8", "srcset": "https://si.imgix.net/4848f778/uploads/origins/1081a2b0-7aeb-4070-90da-d3aad1f4ba33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c004ca31a0fa426edbafd37e652f89a8, https://si.imgix.net/4848f778/uploads/origins/1081a2b0-7aeb-4070-90da-d3aad1f4ba33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c882e183f106a389288cb4fdf2244e1 2x, https://si.imgix.net/4848f778/uploads/origins/1081a2b0-7aeb-4070-90da-d3aad1f4ba33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=907e9ffb45827ef898a03c348e6e1106 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3850968, "client_id": 698483, "nc": 160}, {"path": "/@SWkO46JM1o/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3850968, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d8a2bf8/uploads/origins/4e8ba664-deba-4be6-8a99-d5f09642e918?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=