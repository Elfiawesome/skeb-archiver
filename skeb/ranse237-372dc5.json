ix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9df356030f85edd2eda162d92c8eb438", "srcset": "https://si.imgix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9df356030f85edd2eda162d92c8eb438, https://si.imgix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33f2a4578e45bdcfe177133cc830bcb9 2x, https://si.imgix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d938a8a2d82ac04c78585ab8949eda4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7edeb7089a77a785d32ae7c5d029437", "srcset": "https://si.imgix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7edeb7089a77a785d32ae7c5d029437, https://si.imgix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7ecfeb86301a1ab3be2ca4ac55fbf20 2x, https://si.imgix.net/2f5c27d6/uploads/origins/57a81c97-4a9e-41ef-a9d4-175ab71a02a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b442b1e3b1284fa400a92c0c6972577f 3x"}, "body": "こんにちは！ 追加でイラストをお願いしたいのですが、今回は誕生日のイラストです。私のキャラクターはアジサイがモチーフになっています。\n\nポーズや服装はお任せします。別の衣装にしていただいても構いません。デフォルトの衣装でも大丈夫です。\n\nキャラクターレイヤーと背景レイヤーは分けてください。\n\nキャンバスによって体が切り取られないようにしていただけると助かります。全身イラストでない場合は、体の切り取りはキャンバスの下端のみにしてください。上部と側面は切り取らないでください。その理由は、誕生日のお祝いの一環として、このイラストを使ってステッカーを作成し、コミュニティの皆さんにプレゼントしたいと考えているからです。キャラクターが複数の辺で切り取られてしまうと、ステッカーの見栄えが悪くなってしまうのではないかと心配しています。\n\nまた、サムネイルやお知らせなど、他のVTuber関連の活動にも使用する予定です。さらに、ポストカードやマグカップなどの記念グッズを作成する許可もお願いしたいです。ステッカー以外のグッズは作らない可能性が高いですが、万が一に備えて許可をお願いしています。もしこれが許可されない場合は、依頼をキャンセルしてください。\n\nご検討いただきありがとうございます。あなたと仕事ができることを本当に嬉しく思っています！\n\nhttps://imgur.com/a/chiellevt-s0vzehv", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ranse237/works/1667", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2639157, "client_id": 2378543, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ded9007d/uploads/origins/44c5f598-705c-46bd-a22e-d752a151d2ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afdc89749fb9d5a7946135240079b7ce", "srcset": "https://si.imgix.net/ded9007d/uploads/origins/44c5f598-705c-46bd-a22e-d752a151d2ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afdc89749fb9d5a7946135240079b7ce, https://si.imgix.net/ded9007d/uploads/origins/44c5f598-705c-46bd-a22e-d752a151d2ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30c67a87b72b10f7bbe8880070eb3ab1 2x, https://si.imgix.net/ded9007d/uploads/origins/44c5f598-705c-46bd-a22e-d752a151d2ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=142921a89ee35d9d73169b1e9b537e13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ded9007d/uploads/origins/44c5f598-705c-46bd-a22e-d752a151d2ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26e962fcdf2777bf2bf2f35741d7a346", "srcset": "https://si.imgix.net/ded9007d/uploads/origins/44c5f598-705c-46bd-a22e-d752a151d2ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26e962fcdf2777bf2bf2f35741d7a346, https://si.imgix.net/ded9007d/uploads/origins/44c5f598-705c-46bd