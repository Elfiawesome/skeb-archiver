x.net/7b485cab/uploads/origins/afdaf6fb-8a2f-4686-9367-e9a424f6acdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79e05e91768d5b8c9057d97c2ed01cf6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b485cab/uploads/origins/afdaf6fb-8a2f-4686-9367-e9a424f6acdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300ad64a41a386c6065892733f48b12b", "srcset": "https://si.imgix.net/7b485cab/uploads/origins/afdaf6fb-8a2f-4686-9367-e9a424f6acdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300ad64a41a386c6065892733f48b12b, https://si.imgix.net/7b485cab/uploads/origins/afdaf6fb-8a2f-4686-9367-e9a424f6acdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46462f70a60432922b0c07d044bfbb2d 2x, https://si.imgix.net/7b485cab/uploads/origins/afdaf6fb-8a2f-4686-9367-e9a424f6acdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=35d61ef394014a1e8f180d81eb8de507 3x"}, "body": "初めてリクエスト送らせていただきます。\n友人に贈るイラストをお願いする絵師さんをお探ししていた所､大変魅力的で心を惹かれる絵をとうふ様がお描きになっていたため､リクエストを送らせて頂きました。\n\n◆キャラクター詳細\nTwitterからご確認お願いいたします。\nhttps://x.com/koma_nora?t=vI_T1rNhdWI5cPKCodsx6A&s=09\n\n友人であり、個人YouTuberとして活動している、「こまとのら」さんのイラストをお願いしたいと考えております。2人の3周年お祝いイラストをお願いしたいと考えております。\n\n・こましの特徴\nおさげ髪､まろ眉､目の下にホクロがある、髪飾りはお花。特技は歌、性格は明るく話すと皆が元気をもらえる女の子。\n・のらの特徴\n黒猫とリボンがモチーフ､三つ編み､性格はおっとり癒し系。話すと皆が心が浄化されるような女の子。\n\n◆構図\n構図はお任せいたします。3周年のお祝いなので、パーティー感やお祝い感がある雰囲気だと嬉しく思います。衣装は元の衣装でも構いませんが、個人的にとうふさんの「和」の絵柄も好きなので、描きやすい絵柄があれば衣装等も変えていただいて構いません。(元の衣装が描きやすければ変更して頂かなくても大丈夫です)\n\n◆使用用途\n基本的には2人に個人的にプレゼント致します。活動中の2人なため、Twitterで頂いた絵についてツイートしたり､一時的にアイコンにする可能性がございます。グッズ等には使用しません。\n\n◆納品形式\n可能でしたら人物背景透過も合わせていただきたいです。PNG又はPSDでお願いいたします。余裕がございましたら、表情差分をいくつかつけて頂けたら大変嬉しく思います。\n\nお忙しいとは思いますが､ご検討いただけますと幸いです。宜しくお願い致します。\n\nhttps://youtube.com/@komanora?si=wGT1Mjo6C2iVfVcc", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bigLOVE___0808/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2458371, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b991501db81fb09bdf15d2886f25f09", "srcset": "https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b991501db81fb09bdf15d2886f25f09, https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cd5635800c212521c196e0cd33d433f 2x, https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664177ec7aa13d8a47280de4c3d830e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e69f2a9a57b70c1b735796fc2197daa1", "srcset": "https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e69f2a9a57b70c1b735796fc2197daa1, https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9687f1676a6182e10d422452b128669 2x, https://si.imgix.net/18d23345/uploads/origins/bfe690ca-ec99-4647-973c-7a64a35439df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4712d453b6b4e6590c4c273d1ca29d24 3x"}, "body": "は