3e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9081b0fec792c66e1b67d8e78fa3dc", "srcset": "https://si.imgix.net/00bee865/uploads/origins/63947bf6-225e-47e7-9928-73e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b9081b0fec792c66e1b67d8e78fa3dc, https://si.imgix.net/00bee865/uploads/origins/63947bf6-225e-47e7-9928-73e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5c2d4109b57cf803323d98816321029 2x, https://si.imgix.net/00bee865/uploads/origins/63947bf6-225e-47e7-9928-73e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9d655d5a4238b96917aabe40d75bc50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00bee865/uploads/origins/63947bf6-225e-47e7-9928-73e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5818d61c0dd9afa1d9dfbf8cb58da423", "srcset": "https://si.imgix.net/00bee865/uploads/origins/63947bf6-225e-47e7-9928-73e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5818d61c0dd9afa1d9dfbf8cb58da423, https://si.imgix.net/00bee865/uploads/origins/63947bf6-225e-47e7-9928-73e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=856c13d2849945625bc11165168dd708 2x, https://si.imgix.net/00bee865/uploads/origins/63947bf6-225e-47e7-9928-73e0c751f66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea18631778b5dd783f063a2c8a3c0058 3x"}, "body": "こんにちは！あなたのイラスト、とっても可愛いです。このリクエスト、大丈夫でしょうか？もし問題があれば、キャンセルするか、必要に応じて価格を上げてください。\n\nこちらはトールです。彼は第四の壁を破るネット上のヤギです。普段は穏やかで優しい性格ですが、視聴者を見つけると、とても興奮して甘えん坊になり、可愛らしい振る舞いをします。 ただ、視聴者を独り占めしようとすると、ちょっと狂気じみた行動に出ることもあります。いわゆる「ヤンデレ」みたいな感じですね。\nhttps://toyhou.se/29265897.psst-hey-over-here-t/37362943.my-reference-sheet-toru \n\n彼の「平常時」か「狂気モード」のどちらでもお好きな方を選んでください！ただし、必ず視聴者の方を向かせてください。\n彼は主に「吹き出しのしっぽ」を使って視聴者とコミュニケーションを取ります。どちらのバージョンを選んでも、しっぽに好きなテキストを書いてください！\n\n\nデザインノート：\n \n-金属製の首\n-吹き出しの尾\n-天使の羽\n-胸の音楽ディスクの穴\n\nどうもありがとうございます！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aquaira_oO/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3856770, "client_id": 2813859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a725f22/uploads/origins/abd4ee8b-cb26-46f1-b635-5f571b921780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=039ab6e76b6a171a9de6fda5dece087a", "srcset": "https://si.imgix.net/9a725f22/uploads/origins/abd4ee8b-cb26-46f1-b635-5f571b921780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=039ab6e76b6a171a9de6fda5dece087a, https://si.imgix.net/9a725f22/uploads/origins/abd4ee8b-cb26-46f1-b635-5f571b921780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7c9984757cce5ba36be70cb69d0e8faf 2x, https://si.imgix.net/9a725f22/uploads/origins/abd4ee8b-cb26-46f1-b635-5f571b921780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f66eb4b5bdc88528f657f48c582b5ac1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a725f22/uploads/origins/abd4ee8b-cb26-46f1-b635-5f571b921780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3b6079a813d8831c52a6de81f72e7f9", "srcset": "https://si.imgix.net/9a725f22/uploads/origins/abd4ee8b-cb26-46f1-b635-5f571b921780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3b6079a813d8831c52a6de81f72e7f9, https://si.imgix.net/9a725f22/uploads/origins/abd4ee8b-cb26-46f1-b635-5f571b921780?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=239e545e7eae66e3fbaa53e99a34f157 2x, https://si.imgix.