2a-4b8b-be41-a9c7a8dc7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6979aad2b0bdc40c493e7de9b6d3848", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9210005/uploads/origins/52ca4705-ba2a-4b8b-be41-a9c7a8dc7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b386780919607abc43f176d395c24e1c", "src_set": ""}, "body": "こんにちは！あなたの絵がとても好きなので、私のキャラクターラウディを依頼したいです。\nポーズや服装はあなたの好み次第です！\n\nありがとうございます。\n\nhttps://drive.google.com/drive/folders/1Oi7iaoxB_aSUuaDczS9k94IrTlXRSbrM?usp=drive_link\n\nhttps://x.com/rowdy_drusky/status/1743945594677428547", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tooboe_huusuke/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3153, "client_id": 2988965, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57edf8f2/uploads/origins/653386ed-b619-4ca0-9232-3c0fa4cc105e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2c94f8980b5498b06a9a90bcb603c6e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57edf8f2/uploads/origins/653386ed-b619-4ca0-9232-3c0fa4cc105e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8cfc982638c9196f57d4374072c381d8", "src_set": ""}, "body": "初めましてまして、ヴェルクといいます。\nイラストをお願いしたくリクエストを送らせていただきました。\n\nキャラクターを描いてください。\n背景やポーズはお任せします。\n\nよろしくお願いします。\n\nキャラクター資料\nhttps://drive.google.com/file/d/17fknlMRaWULUIVmVr3rSgOomeIoS-xvr/view?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tooboe_huusuke/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3153, "client_id": 2918050, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0425319c/uploads/origins/2475763b-e88d-4a33-bed4-94b6232b4811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=abcd011e41adbc5f478a1f63b47dd262", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0425319c/uploads/origins/2475763b-e88d-4a33-bed4-94b6232b4811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82e1d1d9aaa3e9ab3ed6a6fd96cadd19", "src_set": ""}, "body": "Hello とおぼえ ふうすけさん, nice to meet you! I love your artwork style so much. I would like to request an artwork for Rachi participating in the 百毛夜行 parade for the upcoming FTP 2025 event.\n\nYou can decide which character Rachi will be in the 百毛夜行 parade and draw in the style anyway you like, thank you. Looking forward to it.\n\nRachi:\nhttps://drive.google.com/drive/folders/1b02MM12kM5TfxqqaaklFsWzMfm0qCfPz", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tooboe_huusuke/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3153, "client_id": 753226, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de29cdb8/uploads/origins/5f807f69-b664-4ea0-9d8f-586e278c2861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84e1366be901e13d923278bcb51764de", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de29cdb8/uploads/origins/5f807f69-b664-4ea0-9d8f-586e278c2861?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baed4c7cf0e6b01486b84a9d4734a137", "src_set": ""}, "body": "こんにちは、とおぼえさん！とおぼえさんの作品をずっと見ていて、僕も毛皮を描くようになりました！\n\nうちのOC、あきはるくんが日本の学校の体操服を着て、体育の授業で運動するのをお願いしたいです。運動はランニングでもストレッチでもなんでもいいです。\n\nとおぼえさんは、あきはるくんのデザインの調整、背景の変更などご自由にどうぞ。\n\nありがとうございました！\n\nhttps://x.com/korstudio/status/1840650260240318549/photo/1", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tooboe_huusuke/works/128", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3153, "client_id": 478455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/619e41c1/uploads/origins/ff5f8d43-2441-4fca-8ca5-677df965851b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=137b62c13568432ebac65d3636791e97", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/619e41c1/uploads/origins/ff5f8d43-2441-4fca-8ca5-677df965851b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c1efbf5d1891d2f7e8e3086e1aca3ee", "src_set": ""}, "body": "最近他の方に描いていただく機会が増えてきたので、資料用としてとむたろうの3面図お願いしたいです！ 初めに描いて頂いてから4年経ってるので、代理として今のイメージで変えたいとこあったらおまかせします🙌", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tooboe_huusuke/works/127", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3153, "client_id": 2813228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c408e6c/uploads/origins/d067f73a-1ed8-4473-8162-7aa283898d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fa31d066dc9734365be521d30f3c1a6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c408e6c/uploads/origins/d067f73a-1ed8-4473-8162-7aa283898d2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=436b1dc899f2e72bd8e83b33af5c2f7a", "src_set": ""}, "body": "お世話になっております！　普段配信者として活動しているラルフと申します！\n今回ふうすけさんに依頼したいものですが、今後グッズとしてアクリルスタンドを販売しようと思っており、\nそのイラストを描いていただきたくご依頼させていただきました。\n\n描いていただきたいイラストの詳細ですが、\n・100mm×100mmのものを出そうと