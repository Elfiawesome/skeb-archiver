容をお願いします。\n\n○内容\n「バンバドロ」を描いて下さい\n○詳細\n①バンバドロは「とつげきチョッキ」を身につけた姿にして下さい\n※バンバドロの体型と、とつげきチョッキの形状から割と無理矢理感がありますが、\n\n【犬に犬用の服を着せてる】ような感覚で描いて下さい。\n②バンバドロのそばに四角い枠を描きその中に以下↓の文章を書いて下さい\n\n\nバンバドロ♀（ニックネーム:ハベル）\n性格:やんちゃ（ミント:いじっぱり）\nテラスタイプ:くさ \n持ち物:とつげきチョッキ\n特性:じきゅうりょく\n努力値:HP4攻撃252防御252\n◎技構成\n・じしん\n・ヘビーボンバー\n・ボディプレス\n・テラバースト", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ziware30/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 9427, "client_id": 458845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a406ac34/uploads/origins/b6415d50-8994-4618-b18e-0327b7b39a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eb942013ea8587d1c9c74dfe0de4b50", "srcset": "https://si.imgix.net/a406ac34/uploads/origins/b6415d50-8994-4618-b18e-0327b7b39a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5eb942013ea8587d1c9c74dfe0de4b50, https://si.imgix.net/a406ac34/uploads/origins/b6415d50-8994-4618-b18e-0327b7b39a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=345308632d78c3bc2d9ced58ed1cad8c 2x, https://si.imgix.net/a406ac34/uploads/origins/b6415d50-8994-4618-b18e-0327b7b39a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e02995a04a1e9c397aafe05bd2de89f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a406ac34/uploads/origins/b6415d50-8994-4618-b18e-0327b7b39a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12cbf64391198bc7cfe216fb938688a5", "srcset": "https://si.imgix.net/a406ac34/uploads/origins/b6415d50-8994-4618-b18e-0327b7b39a2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12cbf64391198bc7cfe216fb938688a5, https://si.imgix.net/a406ac34/uploads/origins/b6415d50-8994-4618-b18e-0327b7b39a2b?bg