9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb1bc0df3f9d577e7743a9c9064a57a4", "srcset": "https://si.imgix.net/bc40e4b5/uploads/origins/b102184a-57d6-42c1-ab71-55ab9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb1bc0df3f9d577e7743a9c9064a57a4, https://si.imgix.net/bc40e4b5/uploads/origins/b102184a-57d6-42c1-ab71-55ab9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=62060c4b18cf67c89c75257d1eec76e7 2x, https://si.imgix.net/bc40e4b5/uploads/origins/b102184a-57d6-42c1-ab71-55ab9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6119b837176ead46d6fa77077c6dfdfb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc40e4b5/uploads/origins/b102184a-57d6-42c1-ab71-55ab9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d245a3dca4b75225a60f351e88f212b1", "srcset": "https://si.imgix.net/bc40e4b5/uploads/origins/b102184a-57d6-42c1-ab71-55ab9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d245a3dca4b75225a60f351e88f212b1, https://si.imgix.net/bc40e4b5/uploads/origins/b102184a-57d6-42c1-ab71-55ab9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=442841728d68e3b422257ad2aa2bcf72 2x, https://si.imgix.net/bc40e4b5/uploads/origins/b102184a-57d6-42c1-ab71-55ab9e4050c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4df00ca299d228956e7ce7b74d371423 3x"}, "body": "紫様、skeb開設おめでとうございます！\nいつも素敵なイラストを拝見しております！\n\n今回紫様には、企画キャラクターのうちよそである拙宅のニゲラ(https://www.pixiv.net/artworks/86343069)ニゲラドレス姿（https://www.pixiv.net/artworks/88534582）と、お相手様であるこうた様のシャルロッテさん(https://www.pixiv.net/artworks/86390145)シャルロッテさんドレス姿（https://www.pixiv.net/artworks/88236111）を描いて頂きたく思います\n\n企画概要：https://www.pixiv.net/artworks/85814868\n※GLが主題の企画です。\n舞台は「花園」と呼ばれる、外の世界から隔絶された全寮制の女学園です。学園に来る以前の記憶がない12～17歳の少女が清廉潔白をモットーとした教育を受けていますが、実はこの学園は彼女らを男性の愛人や娼婦として売るための商品として育てる施設でした。「卒業」に際し、はじめてその事実を知らされた少女たちはどうするのか……というストーリーです。\n\n2人とも後半のビジュアルが変わっておりますが、今回は上記に貼っておりますキャラクターシートのまま、またはドレス姿の2人でお願いします（紫さんのロングヘアが好きなのですがドレスイラストも同じくらい好きで選びきれませんでした…）\n\n関係性と致しましては、お互い表向き友人関係ですが、ニゲラ→シャルロッテさんは「セラフという花園で唯一の少女の称号に相応しい、敬愛や尊敬のような『彼女は模範的な少女だ』というようなフィルターを長年かけて見ており、逆にシャルロッテさん→ニゲラに対しては複雑な独占欲の様なドロリとした感情を抱いて頂いております…！\n\n紫様の『気高く上品でありながら可憐な少女らしさがある絵、高尚でありながらたしかに息をしている空気感』が好きなので、ポップなイラストよりかは空気感のある世界に2人きりのようなイラストだと嬉しいです！\nシチュエーションやポーズ諸々一切お任せ致します\n\n個人的に印刷して楽しみたいので解像度350dpiだと有難いです（違ってても構いません）\n何卒宜しくお願い致します〜！", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 738812, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うめづかうめこ♦️skeb募集中", "screen_name": "umeumeduka", "avatar_url": "https://pbs.twimg.com/profile_images/1366750675430821889/_-YTMcX8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1261950118908948486/1732285966/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 1060636, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ワンコインスケブくん（停止中）", "screen_name": "nyo7111", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1198960, "creator": true, "nsfw_acceptable": false, "acceptable": true, "na