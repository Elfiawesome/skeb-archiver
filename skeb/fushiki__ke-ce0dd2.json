ウを描いていただけないでしょうか？\n\nお願いしたい服装は参考資料にもあるのですが、ピンクのゆったりしたジャンパーに長袖、太ももはピンク、下は小さめのキャミソールにブルーのストライプのショーツという感じでお願いしたいです。\n\nリュウジョウは寝室で、ベッドにうつぶせに寝ていてほしい。眠そうな表情で後ろから見る龍城は、かわいい笑顔を浮かべているが、まだ半分眠っている。お尻がジャンパーで覆われていないため、パンティがお尻の頬の間に挟まり、丸見えになっている。\n\nまたもや長文、そしてぎこちないリクエストで申し訳ありませんが、どうかまたお力添えをお願いいたします。\n\nお手数をおかけしますが、よろしくお願いいたします！\n\nhttps://photos.app.goo.gl/McJHqwicn1ofSZVi8", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fushiki__ke/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f95f87d8/uploads/origins/f77c9c6b-1860-42a5-9af8-8d25e9132571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecc95a991567d89fc2cd43fe2b0c1f50", "srcset": "https://si.imgix.net/f95f87d8/uploads/origins/f77c9c6b-1860-42a5-9af8-8d25e9132571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecc95a991567d89fc2cd43fe2b0c1f50, https://si.imgix.net/f95f87d8/uploads/origins/f77c9c6b-1860-42a5-9af8-8d25e9132571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3582ad0a3ad908a166196075cb2ea883 2x, https://si.imgix.net/f95f87d8/uploads/origins/f77c9c6b-1860-42a5-9af8-8d25e9132571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75917927355964e13ab5362a383760c7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 361645, "client_id": 629526, "nc": 176}, {"path": "/@fushiki__ke/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 361645, "client_id": 1473091, "vtt_url": null, "thumbnail_image_u