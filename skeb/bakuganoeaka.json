8b3-85d3-4507-87ef-0dec1355f896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec769fa1c18956d54809aaf281f0f85", "srcset": "https://si.imgix.net/d35addf2/uploads/origins/c37828b3-85d3-4507-87ef-0dec1355f896?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eec769fa1c18956d54809aaf281f0f85, https://si.imgix.net/d35addf2/uploads/origins/c37828b3-85d3-4507-87ef-0dec1355f896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bce0fb7f4b6273d36eda862b294ec92 2x, https://si.imgix.net/d35addf2/uploads/origins/c37828b3-85d3-4507-87ef-0dec1355f896?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69d1e757f981596a5d4f67a790939c32 3x"}, "body": "爆もちおさま\nはじめまして。可愛らしいイラストに惹かれてリクエストさせていただきました。\nよければ、下記キャラクター２人のイラストをお願いしたいです。\n（資料URLをつけ忘れたため再送させていただきました。重複となること誠に申し訳ございません。）\n\n▽キャラクター\nTRPGのうちよそ２人です。\n（参考画像にpicrewを使用していますが、作成者様の利用規約は確認済です）\n\n元宮：\n男性／20歳／170cm\n大学２年生。性格はおとなしめで基本真面目だが、明るいしよく笑うし冗談を言うし通じる。いろんな人に好かれやすい優等生タイプ。橘花からはよくうさぎのグッズや洋服を贈られている（困惑しつつも受け取ってくれるし身に付けてくれる）。\n\n橘花：\n男性／19歳／173cm\n大学１年生。見た目に反してこちらも性格はおとなしめで基本真面目。元宮のことが好きで年下ながらも好かれようと紳士的に接することが多いが、好きすぎるが故にからかってしまうこともしばしば。\n\n２人は高校時代に弓道部で先輩後輩の関係でした。\n現在は恋人関係にありますが、心身ともに距離の近い仲良しな友人 と言ったほうが近いかもしれません。左手薬指にシルバーのペアリングをつけています。\n\n\n▽構図について\nもしよければ、アフタヌーンティーを楽しんでいる２人をお願いしたいです。\n難しそうであれば、お好きな構図で仲良く話したり遊んだりしている２人を書いていただけると嬉しいです。服装についてもお任せ致します。\n\n\n以上、なにかしら不備がありましたら申し訳ありません。\n金額が不足している場合は再送いただけますと嬉しいです。\n\nご検討いただけますと幸いです。どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1iDgdvHsTTcH3nJFRBp7hLHS94n7CzG24?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bakuganoeaka/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3386125, "client_id": 1180324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3d669da/uploads/origins/619514b9-1f46