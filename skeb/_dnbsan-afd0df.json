si.imgix.net/12520688/uploads/origins/86e069cb-bbc1-4465-ab6d-b79889420a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc8c3e93932c1355c60e8a33b59db59c, https://si.imgix.net/12520688/uploads/origins/86e069cb-bbc1-4465-ab6d-b79889420a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b01315432478b8749f8fc761f1f0ae44 2x, https://si.imgix.net/12520688/uploads/origins/86e069cb-bbc1-4465-ab6d-b79889420a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=46ca9e5796736721ceb41beaef4d9aa0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12520688/uploads/origins/86e069cb-bbc1-4465-ab6d-b79889420a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=106c3abba4e897057d6ca122fef7e688", "srcset": "https://si.imgix.net/12520688/uploads/origins/86e069cb-bbc1-4465-ab6d-b79889420a93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=106c3abba4e897057d6ca122fef7e688, https://si.imgix.net/12520688/uploads/origins/86e069cb-bbc1-4465-ab6d-b79889420a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35ef24160795128e3a55326233e17bf9 2x, https://si.imgix.net/12520688/uploads/origins/86e069cb-bbc1-4465-ab6d-b79889420a93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c6834589bc6d05ebbb0f1a8ac2adaf3 3x"}, "body": "はじめまして！いつも土鍋さんの素敵なポケモン絵見ています。私と友達のOC二人、キラトとアイリーンを一緒に依頼したいです\n二人はお揃い騎士テーマのコーデしています〜\n\n▽キャラ詳細\n二人は友達で歳の差によってちょっと親子？か兄弟みたいな親しい関係です（恋愛とかじゃないです。お互いは別の人と交際・結婚しています）\n今回はお互いの友達のパーティに一緒に参加していて、テーマに合わせてマッチング服装です\n\nアイリーン\n23歳、166cm、胸F75\nクールで冷静沈着、美人のお姉さん。時々モデリング仕事などしてます\nスポーティで流行りのファッションなど好き\n・目は薄い紫\n\nキラト\n〜40代、185cm。体型アスレチック\n人気な俳優さん・モデル。メイクとオシャレな柄好き\n感情が顔に出やすい。おじさんなのにわんちゃんみたいに社交的で元気いっぱい\n・タレ目でメイクしてます。目はピンク。目元に薄くシワ\n・チャームポイントは唇あたりにほくろとえくぼ\n・まゆげ茶色\n※日本人・インド人ハーフなので肌色を気をつけて下さい〜\n\n\n二人の服装は自分のデザインですが、ポケモン関係のところ・小物はNGな場合はご自由に変えてもOK\n\n▽依頼内容\n今日は自分の誕.生 日なので二人は愛猫のらんやちゃん（色違いアローラペルシアン）モチーフのお茶会に参加します〜ベルばら・フランスのロココ時代雰囲気のパーティテーマです\n\n二人はお姫様のロイヤルガード・騎士の役してるのでレイピア（細長い剣）を持つポーズだと幸いです。剣のデザインはお任せします、簡単デザインで大丈夫です\nもし二人はお互いの背中を合わせて剣を持って（重なってる）、一緒に戦うみたいなポーズが見たいです（一緒にお姫様を守ろうとしているようなシチュエ）\n背景に何か薔薇のタッチ（花びらとか）を入れたら嬉しいですがお任せします\n\nご検討よろしくお願いします\n\nhttps://sta.sh/2st8o1vydig", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_dnbsan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 175206, "client_id": 2055392, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/716628c2/uploads/origins/ff0e8aec-37be-468b-b4a9-143cb1cb8b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030aa1ffe84a12e635811ab00912f70a", "srcset": "https://si.imgix.net/716628c2/uploads/origins/ff0e8aec-37be-468b-b4a9-143cb1cb8b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=030aa1ffe84a12e635811ab00912f70a, https://si.imgix.net/716628c2/uploads/origins/ff0e8aec-37be-468b-b4a9-143cb1cb8b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a95ed7681205424949d1a27d7b9ab35a 2x, https://si.imgix.net/716628c2/uploads/origins/ff0e8aec-37be-468b-b4a9-143cb1cb8b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=691bd584892fe0ff459fe43555929091 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/716628c2/uploads/origins/ff0e8aec-37be-468b-b4a9-143cb1cb8b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae41adef30a48dabbdc2e6cd4b59c91", "srcset": "https://si.imgix.net/716628c2/uploads/origins/ff0e8aec-37be-468b-b4a9-143cb1cb8b3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae41adef30a48dabbdc2e6cd4b59c91, https://si.imgix.net/716628c2/