高慢な性格で、優越感に浸りがちです。ちょっといじめっ子なところもあります。大きな狐の耳と、頭にコウモリの羽が生えています。 あごにはほくろもあります！\n\n日焼けした肌と小ぶりの胸にもご注目ください。\n\n参考資料として、私のSkebユーザーページもぜひご覧ください！（https://skeb.jp/@Tebr）\n\nポーズ、表情、背景、シチュエーションについては、あなたにお任せします！ あなたが適切だと思う、かわいい、クール、セクシーなど、どんなスタイルでも描いてください！ 衣装も、お好きなものを自由に選んでください！ あなたが思いつくどんな衣装でも大歓迎です。\n\n参考画像1：https://imgur.com/gallery/tebr-reference-sheet-3-Zo40Hy5\n\n参考画像2：https://imgur.com/gallery/tebr-outfit-2-ref-bmd3ryN", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pepu_3_9/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3821922, "client_id": 3520844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ea51805/uploads/origins/5fb84179-b0d9-411c-ba49-93f7e2328821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b31be9bdf23f6731aec400aafc4fef9", "srcset": "https://si.imgix.net/1ea51805/uploads/origins/5fb84179-b0d9-411c-ba49-93f7e2328821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b31be9bdf23f6731aec400aafc4fef9, https://si.imgix.net/1ea51805/uploads/origins/5fb84179-b0d9-411c-ba49-93f7e2328821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7876910982c2905999d0144e32898763 2x, https://si.imgix.net/1ea51805/uploads/origins/5fb84179-b0d9-411c-ba49-93f7e2328821?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c830c5877c0816162ec644130adfebc2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ea51805/uploads/origins/5fb84179-b0d9-411c-ba49-93f7e2328821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb57e68cf4ac7787287d30cbdc9c447f", "srcset": "https://si.imgix.net/1ea51805/uploads/origins/5fb84179-b0d9-411c-ba49-93f7e2328821?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb57e68cf4ac778