%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a6c7773fee19c8b39fab90d499a8ac1", "src_set": ""}, "body": "こんにちは、\nあなたの画風が大好きで、イラストをお願いしたいです。\nイラストはYouTubeのサムネイルやTwitterなどのSNSに掲載させていただく可能性があります。\n今回の依頼はクリスマスプレゼントなので、その前に完成できればと思います。\nよろしければお受けください。よろしくお願いいたします。\n\nVtuberのタマを描いてほしい。\nドラゴンと人間のハーフです。\n\n構図は以下の通りです：\n- 服装：\nこの衣装はあなたの最近の作品にインスパイアされたものです。\nディテールは自由に変更してください。\nhttps://skeb.jp/@pennosuke324874/works/3\n\n- ポーズ: (ポーズ/ポーズ)\n\n- 表情: (表情/face expression)\n魅惑的な微笑み\n\n- 背景\n背景はあなたが自由に決めてください。\n何も思い浮かばない場合は、（ポーズ/ポーズ）の背景を使い、クリスマスのテーマに合うようにデコレーションしてください。\n\n楽しんで描いてください！^^\n\nhttps://drive.google.com/drive/folders/1TmnMCKY24U_2UBxVmPlTFgttQeEfx_RS?usp=sharing\n\nhttps://drive.google.com/drive/folders/1TmnMCKY24U_2UBxVmPlTFgttQeEfx_RS?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pennosuke324874/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3423580, "client_id": 3406092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59009abd/uploads/origins/ca54a59e-6c0d-41c9-8b13-331cda433268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9025319d1f782358d58b84731a7cddb5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59009abd/uploads/origins/ca54a59e-6c0d-41c9-8b13-331cda433268?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1af84c6bb40fee7308e959c66ee79cc", "src_set": ""}, "body": "はじめまして。\nIRIAMで配信活動をしている碧衣ちょこと申します。 \n新着で一目惚れしぜひ私のOCをお願いしたくリクエストさせて頂きました。\n\n\n【特徴】\n・髪:灰色、インナーカラー青、前髪の向かって右が三つ編み、ふわふわロング\n・片耳が出ている\n・胸は大きめだがハリがある\n・タレ目でもつり目でもない普通目、色は青のグラデーション\n・モチーフは宝石、リボン、水色、青 \n\n【テーマ】\n1枚絵イラスト\n・スーツバニーの立ち絵を参考に首元を着崩してる姿\n・表情は色っぽく\n・構図や細かいところはおまかせしたいです！\n・できたら頭部や左右が途切れてないとありがたいです \n\n【使用用途】\n配信・サムネ・SNS・グッズ・印刷物・頒布等 \n\n【お願い】\nスマホでしか保存できないため、PSDファイルの場合はレイヤー数が1つに5枚以下になるようお願いします。\n・背景、人物、コメントを分け、背景透過をお願いします。 \n\nhttps://drive.google.com/folderview?id=1IwdhBarZckaVnekVOYbBxQP4MGt3UF5L\n\nhttps://drive.google.com/folderview?id=1IwdhBarZckaVnekVOYbBxQP4MGt3UF5L", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pennosuke324874/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/65f5fc92/uploads/origins/18a9ee3b-628c-4754-b476-ee11eb955238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3d09a3d99349b4cfc4811945f33d490d", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3423580, "client_id": 351181, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@pennosuke324874/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3423580, "client_id": 2377067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c37e36bd/uploads/origins/7b7c3c1b-5252-4c33-b1e1-9178d8ed2bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a53160d13e92d108f35745fe7f794bd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c37e36bd/uploads/origins/7b7c3c1b-5252-4c33-b1e1-9178d8ed2bda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b19af4ce9610e51dff5b4c101f487a18", "src_set": ""}, "body": "Pennosuke様\n\nはじめまして！\nVtuberのアールテテと申します。\nPennosuke様のXのイラスト作品を拝見し、とても素敵だと思いリクエストいたしました。\nぜひ私を描いていただきたいです。\n\nーーーーーーーーーーー\n\n◆描いて欲しいキャラ\nアールテテ一枚絵\n（白髪、ピンクインナーカラー、赤瞳、アホ毛、王冠、りんごモチーフ、姫）\n→頭や髪の毛が切れないようにしていただけると幸いです。\n\n◆イメージ\n(Pennosuke様がXで投稿されていた竜華キサキちゃんのような(困り顔にムッとしている)表情をイメージしております。)\n「サンタクロース」のオリジナル衣装を嫌々着せられているが、照れてしまっている様子をお願いしたいです。\n構図や衣装詳細は全ておまかせでお願いします。\n→可能でしたら王冠モチーフ・りんごモチーフ・太ももベルトを入れていただきたいです。\n\n◆使用用途\nYouTube、X、FANBOX先行公開など\n\n◆その他\nキャラと背景等を分けて使用する場合があるので\n可能でしたら「.psd」や「.clip」または人物透過画像PNGでいただけると嬉しいです\n\n\n最後まで見てくださりありがとうございます。\nご検討のほどよろしくお願いします！\n\nhttps://photos.app.goo.gl/GoFcronWyvHUhmjGA", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pennosuke324874/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3423580, "client_id": 3276762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e758567a/uploads/origins/2e280e79-cf85-4b1c-bf5b-b6ddea260987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fe787b73779b87bbb33a976f688b6ab", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e758567a/uploads/origins/2e280e79-cf85-4b1c-bf5b-b6ddea260987?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f14c68ec3e3645eb19dc39b8397304d", "src_set": ""}, "body": "はじめまして、アピールありがとうございます！\n VTuber準備中の未来ちるかと申します。\nとても可愛らしいイラストに惹かれてご依頼させて頂きたくリクエストを送らせていただきます。\n\n︎✧構図\n顔に影がかからないものなら構図はお任せで自由に描いていただけると嬉しいです！背景がある場合は別途キャラクターの透過pngかpsd形式で納品頂けますと助かります。\n\n✧使用用途\nXなどのSNSや個人YouTubeチャンネルでの使用が主な用途になります。\n可能でしたらネットプリントやファンコミュニティでの返礼品、グッズ利用もさせて頂きたいなと思っています。使用不可や注意事項等ありましたら別途記載していただけますと幸いです。\n\n✧キャラクター\n基本的な見た目は御手数ですが添付するGoogleドライブ内の資料を参考にして頂けると有難いです。目の中の星と手首の装飾あたりが見落としやすい部位かなと思うので、何卒よろしくお願い致します。\nhttps://drive.google.com/drive/folders/1vhtGFqB9BUYDYFZ1HzcAoRPac19O6zn4\n\n何卒ご検討の程いただけますと幸いです！よろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pennosuke324874/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3423580, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5db2930c/uploads/origins/7b4e45d2-221d-4fcd-afcf-f9f5e5ebdca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7f75137f9dce1c3d53c2ec3e0b309ab", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5db2930c/uploads/origins/7b4e45d2-221d-4fcd-afcf-f9f5e5ebdca4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23347e48e72e13bd479b5d0d48da06b4", "src_set": ""}, "body": "こんにちわ\n\nオリジナルキャラの全身立ち絵で、昭和初期の農家の20歳位、\n純朴な感じのする黒髪女性のイラストをリクエストしたいです。\n髪型、表情、体型、ポーズ等はお任せします。\n\n恰好\n野良着に、もんぺ、地下足袋履きで、手には紺の農作業用の手甲をつけています。\n野良着の色は紺で絣模様にしてほしいです。\nもんぺはへその辺りで紐を結ぶ袴式、長さはくるぶしまでで、色、模様は濃い紫系の縞、\n脇は袴の様にスリットを開けてほしいです。\n地下足袋はくるぶしの上までの長さ、色は黒にしてほしいです。\n服装の大まかなイメージは資料urlをご参照ください。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n地下足袋イメージ\nhttps://www.dropbox.com/scl/fi/0dlq0el8hrwkh15ocjvm7/tb.png?rlkey=id9szwe2vs7xqr6f46enheggn&st=gqb9dkf7&dl=0\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fi/s6470qhlwdftz8kzbg16s/nk.jpg?rlkey=ve4te44hezclvf9gbnn6zsiw2&st=mglg9oaa&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1634817, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おこのみこ", "screen_name": "O_okonomiko", "avatar_url": "https://pbs.twimg.com/profile_images/1764663399324196864/qRhkvrw3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790913043064508416/1723634201/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 16}, {"id": 3016809, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Apu", "screen_name": "Aputto_9", "avatar_url": "https://pbs.twimg.com/profile_images/185042786749633331