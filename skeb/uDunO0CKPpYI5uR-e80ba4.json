ads/origins/eff32db3-292d-453d-822f-667ec8fbde65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8372b79d0a87c3ac73122b1d50636dda 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f092700f/uploads/origins/eff32db3-292d-453d-822f-667ec8fbde65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c290c9fdd472c1d6f47ca1ba1f6c4ab9", "srcset": "https://si.imgix.net/f092700f/uploads/origins/eff32db3-292d-453d-822f-667ec8fbde65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c290c9fdd472c1d6f47ca1ba1f6c4ab9, https://si.imgix.net/f092700f/uploads/origins/eff32db3-292d-453d-822f-667ec8fbde65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbc5ecd3c54f8b14b74271da541b4410 2x, https://si.imgix.net/f092700f/uploads/origins/eff32db3-292d-453d-822f-667ec8fbde65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb7828206997a54385e0d1ce994a1b7b 3x"}, "body": "にじこさんよろしく\nFF6のケフカが三闘神の力を吸収し、神と化す展開がめちゃ好きだから\n今回はそれをモチーフにして、新たなドラゴンを作りたいです\n\n本体のドラゴンは光属性の邪龍、邪悪な本性を持ち、無限な欲望が抑えきれない\nケフカみたいに、この世界の三柱の竜神を倒し、自分の一部になった\nFF6のケフカとのボス戦、ケフカが召喚した神々の像のような姿\n大地から大空に聳えている天柱になる、柱自体は無数の竜で構成した\n柱の上は三体の竜神、柱の一部になった、そしてその頂点に居るのは邪竜の本体です\nそのまま柱から竜神と無数の竜の力を吸収している\n3体の神を次と次へと力を吸い尽くし、成長、もしくは進化\nそして、天樹は、花が咲くように、頂端が展開し、花びらが6つの翼になり、その真ん中はもう神になった邪竜です\n天柱の力をすべて吸収し、成し遂げた究極の姿、空に浮かび、無限の力を味わいながら喜びの咆哮を\nその下、天樹は枯れ、崩し初めた\nまさに天樹（柱）の邪竜\n\nできれば邪竜を多腕、六翼にしたい\n邪竜の邪性と神性を見たいです！\nよろしくお願いいたします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uDunO0CKPpYI5uR/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2901883, "client_id": 1094636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cd5c3bbcd8ef0e85beb7338cd4dea2a", "srcset": "https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2cd5c3bbcd8ef0e85beb7338cd4dea2a, https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84c87176c59f78c9c5d58a19be114a81 2x, https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54591f03827e74f1879b6e405cea7a6b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b58d03f9bc945f18d74cd6f678069c4e", "srcset": "https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b58d03f9bc945f18d74cd6f678069c4e, https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e29ddac3abb918aed189e5d7e464b3c3 2x, https://si.imgix.net/f52cf170/uploads/origins/7b6a3e57-293a-47a6-b5d1-ba075f0142fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db261a3d539843e792da2cfebb811933 3x"}, "body": "にじこさんこにちは\n今回は、赤白ベースで、カードゲームアニメ主人公の切り札的なイメージを持つタウルス型ドラゴンがほしい\n全体的に超竜騎神ボルガウルジャックみたいに、下半身が四足の竜獣、上半身が竜人の組合です\n全身鎧を被って、サムライ風な竜騎神です\n\n上半身\n額から前向きの剣角が一本ほしい、他に後ろ向きの角も二や四本、兜と一体化、\nhttps://skeb.jp/@uDunO0CKPpYI5uR/works/4\nと似てる風な角がほしい、できれば目も四つほしい\n腕が四本、一対の腕は手、もう一対の腕は竜の首です、聖竜ボルシャックウルフェウスのように\n胸にも竜の顔があり、マズルが長いタイプ、主砲みたいに超強力なブレスを出すことができる、口のそこから炎が漏れるポーズならもっと良いと思います\n背中から生える竜首二つ、超竜騎神ボルガウルジャックのように、ブレスで遠距離攻撃、砲台として働くタイプ\n\n下半身\n力強い竜獣がほしい、凶暴さがほしい\n爪が地面に刻む\n\nその他\n武器はお任せします\n竜の口と牙が好き、鋭い牙を詳しく描いてほしい", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uDunO0CKPpYI5uR/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2901883, "client_id": 1094636, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8ae399b63f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65a99217cbeb0c74bd424354c7312f92", "srcset": "https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8ae399b63f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65a99217cbeb0c74bd424354c7312f92, https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8ae399b63f63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79c48a6e61aab816a8f91ced747e73ff 2x, https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8ae399b63f63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=463f72d226e5210f333ae0c597482d2e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8ae399b63f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=723e8344ed49813f7d2ea856edc8dedb", "srcset": "https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8ae399b63f63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=723e8344ed49813f7d2ea856edc8dedb, https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8ae399b63f63?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3809b8f05b3e3fd5536f448cef4cb8d8 2x, https://si.imgix.net/8373923e/uploads/origins/c7965bad-3ea1-43a2-8618-8a