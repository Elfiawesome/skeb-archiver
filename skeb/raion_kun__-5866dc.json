p=top&w=200&h=200&s=833bb57154c549777f110c83ce23b180, https://si.imgix.net/38517dec/uploads/origins/e7192792-7e18-4d76-81a0-bca82e44f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a7d12ebfdf2a5d05dd2a3a4d8e09ef9 2x, https://si.imgix.net/38517dec/uploads/origins/e7192792-7e18-4d76-81a0-bca82e44f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab6357db640b119742f7e9acbeee0d91 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38517dec/uploads/origins/e7192792-7e18-4d76-81a0-bca82e44f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbfacd942f24df7b58e39fa48d9e628c", "srcset": "https://si.imgix.net/38517dec/uploads/origins/e7192792-7e18-4d76-81a0-bca82e44f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbfacd942f24df7b58e39fa48d9e628c, https://si.imgix.net/38517dec/uploads/origins/e7192792-7e18-4d76-81a0-bca82e44f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=446bb9fa161e435f651be92dcc02f04c 2x, https://si.imgix.net/38517dec/uploads/origins/e7192792-7e18-4d76-81a0-bca82e44f5ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10a9e6d931c294cd848892ca8736e8a0 3x"}, "body": "らぃおん様\n\n初めまして。\nXにて素敵なイラストを拝見致しました。\n\n今回は私のキャラクター2人の【男体化】イラストを描いていただきたくリクエストを失礼致します。\n\n\n〖キャラクター詳細〗\nキャラクターや世界観のモチーフや引退競走馬と馬術競技です。\n\n《キャラ①》\n身長：168cm\nイメージカラー：黄色・青\n\n優しくてマイペースなふんわりとした性格。\n多くの名声と共にこの世を去った親の背中を追い続けてきたが、父と同じ景色を見ることなくレースを引退。\nその後は自分が自分らしくあれる場所を見つけ、仲間と新たな夢に向かって走り続けている。\n同居人のキャラ②に振り回されつつも楽しい日々を過ごしている。\n\n✤キャラ① 髪の毛について\nボブではなく後ろでお団子にしています。\nヘアアレンジのイメージ画像をドライブに保存しているのでご参考ください。\n\n\n《キャラ②》\n身長：156cm\nイメージカラー：赤・ピンク\n\n好奇心旺盛でいつも元気なおてんば娘。お嬢様気質で、そんな所が周りから愛されている。\n食べることが大好きで、いつも口がもぐもぐしている。\n3年間レースで走り続けた後に引退。\n引退後もなお、憧れの父に追いつくという夢を叶えるために新たな舞台でも毎日ひたむきに努力している。\n\n✤キャラ② 髪の毛について\n頭頂部のボリュームがある所の内側部分のみ髪の毛が白いです。 \n\n✤キャラ② 耳飾りについて \n立ち絵では右についていますが、全ての衣装で『耳飾りは左』でイラスト制作をお願い致します。\n\n━━━━━━━━━━━━━━━\n\n✤2人の衣装について\n今回は「衣装1」の記載があるイラストをご参考ください。\n男体化にあたり、衣装は自由に改変して頂いて構いませんが、耳飾りはそのままでお願い致します。\n\n✤2人の耳・尻尾について\n耳は馬耳のみで、人耳はありません⚠️\n服に隠れていますが髪色と同じ、馬のしっぽが生えています。\n\n\n構図などはすべてお任せ致します。\nよろしくお願い致します🍒\n\nhttps://drive.google.com/drive/mobile/folders/1GB24GOY__QlGLhmOyusP6_cGfUwr2faG", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 952119, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "蜜園みるら🎀Commission Open", "screen_name": "puryurumeuu", "avatar_url": "https://pbs.twimg.com/profile_images/1791845323670966272/zsk3is5G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1051777102918238208/1716035081/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 3557483, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "みてい", "screen_name": "mimimitenten3", "avatar_url": "https://pbs.twimg.com/profile_images/1995148479178715136/uA0eRvue.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 3730525, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "刺", "screen_name": "sasuyo_love", "avatar_url": "https://pbs.twimg.com/profile_images/1934914705396781057/Yv_Bh74A.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1934914310486282244/1751123400/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master