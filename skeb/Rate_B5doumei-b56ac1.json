auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15673e3c87c8dcf444f05a6fdf421392", "srcset": "https://si.imgix.net/705fd106/uploads/origins/4d86c8a1-430e-416f-9c2f-2e8f80d5f977?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15673e3c87c8dcf444f05a6fdf421392, https://si.imgix.net/705fd106/uploads/origins/4d86c8a1-430e-416f-9c2f-2e8f80d5f977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=607f9517aff0161f56e6767a7527190a 2x, https://si.imgix.net/705fd106/uploads/origins/4d86c8a1-430e-416f-9c2f-2e8f80d5f977?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d65b316ec4cdd53b8319c44c1f87ed2 3x"}, "body": "私はあなたの作品のとても大きなファンです!\n\n私がお願いしたいのは、女性がフタナリに手コキをしていて、そのフタナリが二人の間で精液を出しているという絵です。二人とも胸がとても大きくて、髪の毛が長いといいですね。髪型はあなたが決めてください。\n\nふたなりの女性は、女性の膝の上に寝そべってください。ふたなりの女の子が、女性の胸を吸うようにしてください。私は、彼女が空中に大量の精液を放出していることを望みます。また、フタナリと女性の両方のキャラクターの胸や顔に精液が付着しているはずです。ふたなりは何日も射精していないので、大量の射精となります。女性はフタナリの恋人を射精させたことを喜んでいるかのような笑顔を見せているはずです。\n\n絵はカラーではなく、モノクロでお願いします。Skebのページにカラー版を掲載したい場合は構いませんが、白黒版もお願いします。白黒の作品がとても好きなので。カラーの場合、女性の髪の毛はピンク、フタナリの髪の毛は紫にしてください。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rate_B5doumei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1053555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f00ecec1/uploads/origins/e43a3a83-7b5f-4e2b-80c5-0b155a69ed83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cc73edb8e0bb70f3d0d0d9c8f6454d6", "srcset": "https://si.imgix.net/f00ecec1/uploads/origins/e43a3a83-7b5f-4e2b-80c5-0b155a69ed83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cc73edb8e0bb70f3d0d0d9c8f6454d6, https://si.imgix.net/f00ecec1/uploads/origins/e43a3a83-7b5f-4e2b-80c5-0b155a69ed83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop