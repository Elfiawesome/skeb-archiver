着き、母なる女神に会うことを夢見ています。新しい場所を見つけたり、新しい食べ物を試したり、親しい友人と世界を探索したりするのが好きです。人付き合いは得意ではありませんが、それでも勇敢に振る舞おうとしています。 \n\n備考：\n- 顔の模様は任意です。別のパターンに変更しても構いません。\n- 髪の長さは通常、腰から肩の間ですが、短くしても構いません。\n- 彼は細身で、腹筋はありません（あまり筋肉質ではありません）。 \n- いくつかの衣装があります。お好きなものを選んでください！お好みであれば、オリジナルの衣装を作成しても構いません。\n\nお好きなように描いてください。\nありがとうございます！\n\nバックストーリー／情報：https://toyhou.se/2061814.libra-melia\n\nhttps://drive.google.com/drive/folders/130xooi-oDHNDokUyQ3iGcFTc8WngNG72?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hepuhouhi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4005038, "client_id": 3195820, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d024356a/uploads/origins/4ca2b236-b4a8-48ab-a805-faef3741e93c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d9253383ee07e018144e9d11fb8b495", "srcset": "https://si.imgix.net/d024356a/uploads/origins/4ca2b236-b4a8-48ab-a805-faef3741e93c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d9253383ee07e018144e9d11fb8b495, https://si.imgix.net/d024356a/uploads/origins/4ca2b236-b4a8-48ab-a805-faef3741e93c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ccce27ab150dcf627cf7a641cf7f1b31 2x, https://si.imgix.net/d024356a/uploads/origins/4ca2b236-b4a8-48ab-a805-faef3741e93c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49d98925450a7e7830ec1f70c8ae6520 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d024356a/uploads/origins/4ca2b236-b4a8-48ab-a805-faef3741e93c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5760e2977118aca6044013c2f9a41956", "srcset": "https://si.imgix.net/d024356a/uploads/origins/4ca2b236-b4a8-48ab-a805-faef3741e93c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20