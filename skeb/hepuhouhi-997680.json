ような雰囲気を漂わせている。話し方の癖として「伏見ね……」や「あたし……」と自称することがある。征服欲、支配欲、独占欲、そして勝ち気など、あらゆる欲望が非常に強い人物である。伏見には家紋のタトゥーがあるが、普段は自分のサイズより少し大きめの服を着るのが好きなので目立たない。また、ゆったりとした服を好むため、袖がふんわりとしたデザインになっている。普段はごく普通に見えるが、何かに夢中になると一時的に理性を失い、狂気じみた一面を見せる。彼は月城を気にかけており、月森に対しては想像を絶するほどの好奇心を抱いていて、近づいてはからかい、彼に対して強い所有欲を抱いています。   \n\n二人の性格の範囲内であれば、どのようなやり取りでも自由に描いていただいて構いません！リンク先に詳細な設定や資料を掲載しています。描きたい衣装は自由に選んでください！   https://drive.google.com/drive/folders/1cZmd90dTtnOVahtEIy8KzVNc4KVRZIrH?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hepuhouhi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4005038, "client_id": 1116701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8460b7c1245c51e5a3907c8b4e136de2", "srcset": "https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8460b7c1245c51e5a3907c8b4e136de2, https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5403f9105b641189f1097d51c68ba545 2x, https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6369df1430e08501ab7ffe2fdf3b85b2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=183a5e167fcf134ae283f8652c8b5c83", "srcset": "https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=183a5e167fcf134ae283f8652c8b5c83, https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a8502dc6e8e66bb46614219c138035d2 2x, https://si.imgix.net/12130978/uploads/origins/379bbc76-91d3-404c-96c2-92a0f6e96839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81683cbd15ad4ee9419b811dafa12750 3x"}, "body": "こんにちは、屁さん！あなたの画風、すごく好きです。私のオリジナルキャラクターを描いていただけませんか？\n\nキャラクターは、人生の異なる段階にある同一人物です。雰囲気は、心理的な独白のような感じです。若い頃の自分が作り出した精神病院の独房で、年老いた自分を世話している、という設定です。\n\nテーマとしては、自己抑制、予言、『コヘレトの言葉』、舌の切除、知識と行動などです。\n\nグロテスクな要素は大歓迎ですが、必須ではありません。\nリクエストをお読みいただきありがとうございます。良い一日をお過ごしください。\n\nhttps://drive.google.com/drive/folders/1kQlnsaRWfieOXp6FwKL-3ZCoj-NSrIDZ", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hepuhouhi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4005038, "client_id": 3166067, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a738b9af/uploads/origins/45aa7f26-06e1-448a-ab78-a42f7be3db86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce07d491a62e6cbdef9f528ceca65abf", "srcset": "https://si.imgix.net/a738b9af/uploads/origins/45aa7f26-06e1-448a-ab78-a42f7be3db86?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce07d491a62e6cbdef9f528ceca65abf, https://si.imgix.net/a738b9af/uploads/origins/45aa7f26-06e1-448a-ab78-a42f7be3db86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e0cb5971d694dc0086bdce221699b7d 2x, https://si.imgix.net/a738b9af/uploads/origins/45aa7f26-06e1-448a-ab78-a42f7be3db86?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27752914d45bcb8dda63f6a52263024d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnai