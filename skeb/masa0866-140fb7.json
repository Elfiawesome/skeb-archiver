200&blur=200&s=160c1ae91a2c0442f3d4b605289fbde8 3x"}, "body": "政踏様初めまして。いつも作品を楽しみに見させていただいております。今回はツイッター、インスタグラム、ココナラで使用するアイコン用のイラストを描いていただけないかと思い、skebを利用しました。\n髪型は顎のあたりまでの長さの紺色の癖毛、目はニアとお父様～のルシファーのような雰囲気で色はオレンジ、銀縁のメガネをかけている自信ありげに微笑む色白の少年がいいです。\n服はトリコロールカラーのストライプのシャツを着て、髪と同じ色のネクタイとサスペンダー、半ズボンを着用、靴は茶色のオックスフォード、ソックスは白のハイソックスでソックスガーターをつけてほしいです。\nポーズは右手でメガネを直しながら(顔がはっきりわかるようにツルに手をかける感じでお願いします)、左手は腰にあてている立ち絵がいいです。\n\n当方スマホしか持っておらず、もしかするとあまり大きなサイズのイラストは保存できないかもしれません…注文が多くなってしまい申し訳ありません。政踏様のイラストがとても好きなので、お受けしていただけると大変嬉しいです。これからも応援しております。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@masa0866/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 135665, "client_id": 182601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7bd5c2bf/requests/61375_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39e5bdb678eb8fbb7abe6378facfb664", "srcset": "https://si.imgix.net/7bd5c2bf/requests/61375_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39e5bdb678eb8fbb7abe6378facfb664, https://si.imgix.net/7bd5c2bf/requests/61375_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e3fb5785cce47a33c236f7c5bf44396 2x, https://si.imgix.net/7bd5c2bf/requests/61375_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=17d9fd0dc516dab1be142653f490134b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bd5c2bf/requests/61375_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0cffb0376498fd1c5172de9a9e9590b", "srcset": "https://si.imgix.net/7bd5c2bf/requests/61375_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0cffb0376498fd1c5172de9a9e9590b, https://si.imgix.net/7bd5c2bf/requests/61375_1?bg=%23fff&auto=format%2Ccompres