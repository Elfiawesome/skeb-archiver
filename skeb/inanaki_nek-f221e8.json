最低この額を支払いますという金額を入力しています。）", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inanaki_nek/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1300539, "client_id": 1983670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e945a69bf9dee557719bd22aa3d45655", "srcset": "https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e945a69bf9dee557719bd22aa3d45655, https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b502bdc9a4fb3f917afa2fb1549d3e4c 2x, https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8903e9207f650f8574ba7a978d02365f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e55330634a632b30debdcdc27c829af0", "srcset": "https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e55330634a632b30debdcdc27c829af0, https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd443957bc6b73edd2459a6d2a6ec979 2x, https://si.imgix.net/17ecc1bf/uploads/origins/2d4c3b61-2ee2-4659-9979-88ef5ec6ecac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200