, "total_appeals_count": 0, "received_works": [{"path": "/@eisenadler2/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1947103, "client_id": 528912, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=954b94493d1c657f25dddbf6b882fd45", "srcset": "https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=954b94493d1c657f25dddbf6b882fd45, https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=642d408cc23c384ff8c5de7bb529bd7b 2x, https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a71dd2e01f2c5ba02b37e236c12847c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c560bad34fce8f0300b097652903d05", "srcset": "https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c560bad34fce8f0300b097652903d05, https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4771f8d81961fc7e60e5a628ace4e79e 2x, https://si.imgix.net/6c04cdab/uploads/origins/3bad3161-75e0-4e4e-8172-2745eadf5bb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d84c3aa9315b33bb61cfff0dd2947721 3x"}, "body": "佳奈さんこんばんは！いつもお世話になってます！\nこの間はとても素敵なイラストをありがとうございました！\n今回、先日描いて頂いた二人の装いを新たにしたため、新衣装でまた前回のようなカッコいいイラストを描いて頂けないかと思い、リクエストを送らせて頂きます。\n\n基本的に前回と同じく、佳奈さんの思う「かっこいい犬猿バディ」を詰めて描いて頂けると大変うれしいです！\n前回は篤（赤い方）が手前で、礫（青い方）が後ろにいて背中合わせのようになっていたので、今回は礫が手前・篤が後ろにいて、表情も篤は笑っていなくて、礫が笑ってるような感じだといいな～と考えています。\n立ち位置は前回同様、篤が←、礫が→になるようにして頂けると嬉しいです。\nまた、背景色が前回赤色だったので、今回青色にして頂けると、なんだかこう『コミカライズ第二部の表紙』っぽくてかっこいいな～と勝手に思っております。\n\n資料は下記URLにまとめさせていただきました。（シナリオのネタバレはありません）\nhttps://drive.google.com/drive/folders/1gpfwiHOrAYBsyiGChW4qwDQCSvAb-I85?usp=sharing\n\nこちらの中にある名前に『ver2』とある画像を参考にして頂ければと思います。\n\nまた、今回も個人使用の範疇でA5～B5くらいのサイズで印刷などをして楽しむ可能性があるため、文字などを別にしたPSDデータも頂けると大変うれしいです。\n\n佳奈さんの絵がめちゃめちゃめちゃめちゃ好きなので、よかったらお願いいたします～～！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eisenadler2/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/87d5ba38/uploads/origins/d282219a-82fd-48a5-8ac6-aada5ee4b07c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c0be653c74d1433dee6b9a362d663e8", "srcset": "https://si.imgix.net/87d5ba38/uploads/origins/d282219a-82fd-48a5-8ac6-aada5ee4b07c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3c0be653c74d1433dee6b9a362d663e8, https://si.imgix.net/87d5ba38/uploads/origins/d282219a-82fd-48a5-8ac6-aada5ee4b07c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3fe9f1b05d3da9d5466cb724061a1acd 2x, https://si.imgix.net/87d5ba38/uploads/origins/d282219a-82fd-48a5-8ac6-aada5ee4b07c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ecf327095f2e4656bfec1d9f2cd7c27b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1947103, "client_id": 2503178, "nc": 1}, {"path": "/@eisenadler2/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1947103, "client_id": 528912, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8dae2f3bdf9d3f5a89254b2ec894c7", "srcset": "https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff8dae2f3bdf9d3f5a89254b2ec894c7, https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6436260683f7e498a12be4ac3599fa86 2x, https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45a9fa1bfb2d66ed92febd21c7db9a95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba3cd465c35bfb0268b90e3a7289992", "srcset": "https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba3cd465c35bfb0268b90e3a7289992, https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e1917c872558a99d0c14ab0025f508e 2x, https://si.imgix.net/63d2328a/uploads/origins/473f9974-4076-4042-b4c3-322d7647c739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f249ea6081ba3a57be837ed77d747006 3x"}, "body": "こんばんは！いつもお世話になってます！\n佳奈さんの絵があまりにも好きなため、はじめてスケブを使ってのリクエストを送らせて頂きます。\n\n今回のリクエストで描いて頂きたいのは『DOGMA』というシナリオの自陣探索者二人です。\nいわゆる「うちよそ」の関係ではありますが恋愛要素はなく「犬猿でありながらバディを組んで治安の悪い地区で殺し屋をしているふたり」と言った感じです。\nなのでカップリングと言うよりは、佳奈さんが思う「かっこいい犬猿バディ」を詰めてもらえるととても嬉しいです！\n構図やシチュエーションもろもろはおまかせいたします。\nビジュアルの資料は以下にまとめさせて頂きました。（シナリオのネタバレはありません）\nhttps://drive.google.com/drive/folders/1gpfwiHOrAYBsyiGChW4qwDQCSvAb-I85?usp=sharing\n\n個人使用の範疇でA5～B5くらいのサイズで印刷したりして楽しむ可能性があるため、文字などを別にしたPSDデータも頂けると大変うれしいです。\n\nどうぞよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eisenadler2/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1947103, "client_id": 2374235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ddae3212a320bf06291bca891980aae", "srcset": "https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ddae3212a320bf06291bca891980aae, https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04ad088e75ba3785ec9741c598c81b49 2x, https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a3021df7049f9b8956acbe9501eedf2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f741211a20b6fcfc7cbe6e3d9233de34", "srcset": "https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f741211a20b6fcfc7cbe6e3d9233de34, https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3ed20c82fae94359fb06a0e4718bea 2x, https://si.imgix.net/326b0080/uploads/origins/cb45c8b4-ad65-4f22-be10-3e88a02116c5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d6dff4c2ce1ff8f7060d80b069744c1 3x"}, "body": "佳奈さん、いつもお世話になっております。\n\n先日は『おやすみ、受け止めてやる。』にて佳奈さんと一緒に物語を紡ぐことが出来、本当に嬉しかったです。最高のセッションを有難うございました！\n佳奈さんが私の拙い要望から生み出してくださったKPCのお二人があまりにも素敵で、私自身すぐに大好きになりました。\n設定を詰める段階でお話しさせていただいた様々なエピソード、セッション内での思い出、そしてありささんと郁也先生の存在は淳生と私にとって大切な宝物です。\n自PCに対して思い入れが出来たのも、真摯に向き合ってくださった佳奈さんと魅力的なKPCのお二人のお陰です。\n今後ともどうぞよろしくお願いします！\n\n前置きが長くなってしまいました…。\n今回は、佳奈さんのPCである松永郁也先生のイラストをリクエストさせていただきます。\nシチュエーションについてなのですが、折角なのであまり卓では見られないお姿が良いなと考えまして…\n郁也先生は学生の頃身長の高さと体格の良さから周りのやんちゃに巻き込まれていた（所謂ところの元ヤン的な）過去をお持ちだとお伺いしたのですが、そのややトガっていた頃のお姿を是非拝見したいです！！！\nこの世に存在する森羅万象・天地万物・八百万の『推しで見たい』シチュエーションは今後セッションの中で手に入れることができる…かもしれないので、それならば先生の実際にあった\"\"\"過去\"\"\"を手に入れたいというファン心理です。\n表情や構図などの詳細は佳奈さんにお任せいたします。描きやすいものを描いていただけると嬉しいのですが、あわよくば先生がブレザーだったのか学ランだったのか知ることができるような状況だと有難いです。\n\n私の欲まみれのリクエストとなりますが、ご検討いただけますと幸いです。\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eisenadler2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1947103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f3d0d4fec9a5937c3e2371257b4a004", "srcset": "https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f3d0d4fec9a5937c3e2371257b4a004, https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a1d1145a58adf7c9e8397b02fafc9b7 2x, https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bb252e853aa4d5e42daca3d22b6e796 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5289faa9357d1fd710a7f03d2cea45d2", "srcset": "https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5289faa9357d1fd710a7f03d2cea45d2, https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41a07e900e0bc0acef592fd7cc55bfb7 2x, https://si.imgix.net/bcd62d64/uploads/origins/bebd3586-3013-4c89-b2ed-bfbe785582a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0326a101e377699030257132a8414b3 3x"}, "body": "佳奈先生、前回はうちの子のTRPG用立ち絵をありがとうございました！\n眺めては心洗われる日々です。セッションもとても楽しめました！\n\n佳奈先生のイラストがとても好きなので、またお願いしてもよろしいでしょうか。\nTRPG関係ではありませんが、よろしければご検討ください。\n\n★描いていただきたいキャラクター\n創作キャラです。前回描いていただいた男性と幼馴染の女の子です。\n女の子側が一方的に恋愛感情を向けており、そのすれ違いで仲違いし、敵同士です。\n男性側は相手を家族として愛していますが、立場上、彼女の世界征服を止めなければなりません。\n二人は恋人関係になることはありませんが、最終的には和解します。\nhttps://drive.google.com/file/d/1JALTvb3VS2FDOjN2vMPJoZFoMVewGZz5/view?usp=sharing\n\n★リクエスト詳細\n二人が結ばれた世界線が見たいため、白タキシードとウエディングドレスで結婚式をイメージしたイラストをお願いいたします。\n設定は参考程度ですのでどうかお気になさらず。差分も問いませんので自由に描いていただけましたら幸いでございます。\n可能でしたら、女の子の衣装や髪飾り等、どこかに赤いリボンの要素を入れていただけたら嬉しいです。（髪型もおまかせいたします）\n\n★用途等\n個人観賞用途\n今回もわがままなお願いで恐縮ですが、アクスタまたはタペストリーにして飾ってもよろしいでしょうか？　サイズは描きやすいもので大丈夫です。\n\nお忙しいところ恐れ入ります。何卒よろしくお願い申し上げます。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eisenadler2/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/61b4032c/uploads/origins/1768edc7-0abc-4c56-8337-5ccf5fccea3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d3ab08bdc9532e24dd1061fee68e5f0", "srcset": "https://si.imgix.net/61b4032c/uploads/origins/1768edc7-0abc-4c56-8337-5ccf5fccea3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9d3ab08bdc9532e24dd1061fee68e5f0, https://si.imgix.net/61b4032c/uploads/origins/1768edc7-0abc-4c56-8337-5ccf5fccea3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2bb74230296b83ee560488e82319d12 2x, https://si.imgix.net/61b4032c/uploads/origins/1768edc7-0abc-4c56-8337-5ccf5fccea3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8355defbda0cb3d424381746b31523f9 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1947103, "client_id": 852320, "nc": 1}, {"path": "/@eisenadler2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1947103, "client_id": 389673, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e28bf464/uploads/origins/315f30b8-3ac9-4193-82a3-cf5e2c828a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c5e57634ec5e5bef7cf043bc52317f", "srcset": "https://si.imgix.net/e28bf464/uploads/origins/315f30b8-3ac9-4