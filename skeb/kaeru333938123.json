3b-f9d3-4be2-9a36-3ab5b2037ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6e4811f2670bb06fec1f15d08f16827", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df8fe2f5/uploads/origins/9f7a4f3b-f9d3-4be2-9a36-3ab5b2037ae6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc6eb91688242ffc845098113f88e24e", "src_set": ""}, "body": "東京放課後サモナーズのタケマル×モトスミでラブラブイチャイチャ甘々中出しセックスをお願いします。\nシチュエーションは特になくていいです、背景真っ白でも全然構いません。2人が仲良くセックスしてることが大切なので。布団かベッドくらいはあってもいいですが。\n可能ならば正常位で一発、騎乗位で一発、後背位で一発、それぞれ中出ししてる場面が欲しいです。こちらは優先度はそこまで高くないので余裕があればどれかで構いません。\nラストは2人の顔がこちらから見えるように背面座位でフィニッシュだと嬉しいです。その際モトスミの雄っぱいをタケマルが揉みしだいてる感じでお願いします。片方は乳首を軽くいじってるといいですね。あくまで雄っぱいの柔らかさを堪能するために揉んでる強さにしてください。強く沈むほど鷲掴みにしたり乳首が伸びるほど引っ張るのは見てて痛いのでしてほしくないです。こちらがメインなので必ずお願いします。\nあと受けのモトスミは快感に耐えつつ翻弄される感じといいますか……カエルさんが以前描かれたオリジナルキャラの「クロさん」のような喘ぎ方にしてほしいです。あんまりノリノリでセックスするキャラではないと思ってますので………高校生ですし性欲は旺盛で気持ちいいことも嫌いではないと解釈してますがね。\nタケマルはそんなモトスミをたくさん可愛がってたくさん気持ちよくしてたくさん溢れるほど中出しして欲しいですスケベな鬼なので。\nセックスが終わった後のピロートーク的な一コマが最後にあると嬉しいです。息を荒らげながらも全裸で向かい合って抱き合うタケマルとモトスミとか想像するだけで最高！！ 正常位や騎乗位よりも優先して描いて欲しいです。余裕があればでいいですが。\nあとは細かいことなんですが、体格的にタケマルの方が良いので、肉体やチンコの大きさなどはタケマルの方が大きくしてください。もちろん相対的に小さいだけでモトスミのチンコも立派にしてください。粗チンは嫌いなので。\n注文が多くなってしまいましたが、どうかよろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaeru333938123/works/157", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6e423985/uploads/origins/5d93e465-c2c5-4a28-a498-0059ae45423f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b36c3d824905f949bf72fd2ad8aba1e6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3207743, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kaeru333938123/works/156", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3207743, "client_id": 3442116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83438e84/uploads/origins/9abb421d-3cf7-47d7-83e0-7f4e3badc9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13f1b9c614cdd6d9edfea377649a1f08", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83438e84/uploads/origins/9abb421d-3cf7-47d7-83e0-7f4e3badc9b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b08c6f5b8839a802be0fd906c9d975f", "src_set": ""}, "body": "こんにちは、かえる先生。いつも「1 MORE！」と言っている私をペルソナと呼んでください。\n\nお察しの通り...もっと無名なキャラクターです！今回は、『みんな大好き塊魂』のキャンピングカー少年とカウベア農夫の絵をお願いします。\n\n男については、二人ともすごい毛深くて、二人とも筋肉ガッツリ体型で、キャンピングカーの少年は農夫より少し太ってほしいです。ただし、農夫のほうがまだ毛深く、胸も大きい。キャンピングカーの男の子は自信満々で、農夫の男の子は恥ずかしがり屋で、特におっぱいを揉まれたときに恥ずかしがる。\n\nキャンピングカーは農夫を後ろから犯すべきで、リンク先の投稿（1）のように、横から見られるのではなく、すべて見る人の方を向いている。キャンピングカーはファックしながら農夫の大きな胸を触る。もし差し支えなければ、乳が漏れるように編集していただけると本当にありがたいです。\n\n(1) https://x.com/kaeru333938123/status/1888563844588687486\n\n他のリンク先の投稿(2)のように、二人が横並びになっている別のシーンも描いていただけると（切断者ではなく、手足は残っていますが）、それも最高です。キャンパーはフランネル柄、農夫は牛柄のマンキニを着ている（乳首は隠さないように）。汗まみれのレイヤーと、ザーメンまみれのレイヤーが欲しい。\n\n(2) https://x.com/kaeru333938123/status/1854315112741699688\n\n顔は好きなように解釈してください。ゲーム内のモデルをそのままコピーするよりも、もっと普通の顔にしてほしいです。あなたならきっと素晴らしい仕事をしてくれると思います。\n\nお疲れ様でした！\n\nhttps://www.dropbox.com/scl/fo/fcrsn3kqxf3ya0m74rnsx/AAS07I-ZakklhWqsnzeiabo?rlkey=w2s3422axkd4b4vqozx7nzb0h&st=xbb75i19&dl=0", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaeru333938123/works/155", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3207743, "client_id": 2981541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceb6f08a/uploads/origins/38a4ce27-ca2d-4567-bb0d-616f8e4c5956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ecb24466f5e2987d7747431d07ba11", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceb6f08a/uploads/origins/38a4ce27-ca2d-4567-bb0d-616f8e4c5956?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be34408f563060b6e68b368a270a4295", "src_set": ""}, "body": "こんにちは！モノクロ漫画の依頼を受けたいです。\nキャラクターはリオ https://www.pixiv.net/en/artworks/100723245\n\n学校の体育の先生とレスリングのコーチに捕まったリオ！先生たちはノースリーブの運動ベストを着ている。体育教師はリオをヘッドロックで捕らえ、リオの顔を教師の脇の下に挟み込む。リオは逃げようとするが、教師は彼の顔をより深く脇の下に押し込む。レスリング教師がレッスンの説明をするため、教師はリオの目が見えるようにする。レスリング教師は、二人の教師が一日中、リオの持久力をテストするために、さまざまな姿勢でリオの顔を胸の筋肉で圧迫すると説明する。レスリング教師は黒板に粗雑に描かれた図を示し、その図には筋肉で押しつぶされるリオが描かれている。\n先生たちは交互にリオの顔を大きな胸の筋肉で挟み込む。レスリングの先生はシャツを脱ぐが、体育の先生はシャツを着たままリオを服の下に閉じ込める。リオが捕らえられている間、先生たちは胸の筋肉を曲げたり跳ねさせたりする。彼らはリオの顔を筋肉の谷間にこすりつける。時には先生たちはリオを挟み込む。先生たちは、リオの顔で筋肉の大きさを測りながら、誰が一番胸が大きいかを競い合う。リオはそれを楽しんでおらず、引き離そうとするが、先生たちはいつもリオの顔を彼らの大胸筋に押し戻す。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 29883, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "びーと", "screen_name": "12beat13", "avatar_url": "https://pbs.twimg.com/profile_images/1492918303006015489/g8t9AdJO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1124531270/1544897286/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 48}, {"id": 70382, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "デビロブ", "screen_name": "gurandoherutu", "avatar_