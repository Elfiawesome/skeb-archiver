学生、身長147cm、泣き虫だけどわがままな女の子です。\n2人は生まれた時からの幼馴染みです。\nイメージカラーはルイが赤、ナノが青です。\nまた、目の色はルイが金、ナノが青です。\n\nナノの衣装はこの中から自由に選んでいただければ幸いです。\nルイはぴっちりした黒タートルを着ていればなんでも大丈夫です(黒タートルの上に着込んでも大丈夫です)。\n衣装の描きづらいところはアレンジなどご自由に加えてください。\n左手の薬指に2人とも指輪をしているので、左手が見える構図であればつけていただけると嬉しいです！\n\n構図は2人がいちゃいちゃしているところをお願いします！細かいところはお任せします！\n\nお忙しい中すみません、いつも応援しております！ミツキユイナ先生大好きです！いつもありがとうございます！！\n\nhttps://drive.google.com/drive/folders/1FuNGNglGwkPjd5V9voFGsXLecHJui2lv", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 893881, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しもふり", "screen_name": "nrn_sk", "avatar_url": "https://pbs.twimg.com/profile_images/1213413981391478784/irBvgUgp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3143190162/1599014205/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1221576, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mtn", "screen_name": "mtnmy_", "avatar_url": "https://pbs.twimg.com/profile_images/1859435710383783936/GEK1s5jk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1152227079120801792/1782059042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1502952, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "za!", "screen_name": "monogusatar", "avatar_url": "https://pbs.twimg.com/profile_images/1697102063820513280/8-twf6qS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/14