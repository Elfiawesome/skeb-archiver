d5a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8cab1c6c7139978b289e3a53d4edb71, https://si.imgix.net/d720c831/uploads/origins/3d0a3be6-cba6-427c-8684-f2f5f102d5a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7fdb155923a3e84e39d2e4fdbfa2ab1 2x, https://si.imgix.net/d720c831/uploads/origins/3d0a3be6-cba6-427c-8684-f2f5f102d5a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83816f732e9ecc7bcfb5d8a5733e1f9b 3x"}, "body": "今回もイラストを依頼させていただきます。\n\n以前に描いていただいた双葉シャロちゃんと遊戯王のキャラクターのイラストのシリーズ物で依頼させていただきます。\n\n黒いシャロちゃんと今回は【ティアラメンツ・カレイドハート】を描いていただきたいです。\n\n黒いシャロちゃんについての要望なのですが、今回は赤色や緑色になっていた部分を青色にした黒いシャロちゃんにして欲しいです。キャラクターのイメージとしてはウマ娘でいうライスシャワーみたいな、オドオドした感じというか内気なシャロちゃん、という感じです。\n左腕にはplaymakerのデザインそのままのデュエルディスクをつけて欲しいです。\n\nティアラメンツ・カレイドハートについては、過去に依頼したものと同じような感じで、片目に青色の炎のエフェクトをつけて欲しいです。\n\n背景についてですが、水中に作った大きな泡のシェルターの中でデュエルしてるイメージでお願いします。(ティアラメンツ達の住んでいる世壊は大部分が水で構成されているので)\n\nまた、もし余裕があれば今回の要望のシャロちゃんのみの上半身ぐらいまでのイラストがあると、とても嬉しいです\n\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dyne2358/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2641912, "client_id": 3040795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab1b1694d5e1cc272224be160009f23c", "srcset": "https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab1b1694d5e1cc272224be160009f23c, https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e1cf09331a2f14cda041da0b1130fd6 2x, https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27f00c2453164596baa295a529ed6f1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f36351b1a4b89002d7147b1d3ab38362", "srcset": "https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f36351b1a4b89002d7147b1d3ab38362, https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=945e2f0e6c0aff9d0a43f558679d04f0 2x, https://si.imgix.net/5ec6a1fa/uploads/origins/74bd4089-5421-4aeb-bdea-517a72d80208?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f208c91fcf5d4e1b1c5c64d301f06a29 3x"}, "body": "イラストを依頼させていただきます。\n\n個人Vtuberの双葉シャロちゃんを書いてほしいです。\n今回は、\"シャロちゃんがRe:endさんの【THE OVER】の歌ってみた動画を出したときのサムネイルイラスト\"って感じでお願いしたいです。\n\n衣装は鉄血のオルフェンズ　ウルズハントの主人公、ウィスタリア・アファムの衣装(パイロットスーツじゃない、通常衣装の方)でお願いします。\n小物として、ウルズハントの中で出てくる、旅の目的地を示すリングを持たせて欲しいです。\n背景は宇宙空間みたいな感じでお願いします。\nできればタイトルっぽい感じのフォントで【THE OVER】って書かれているものと書かれていないものの2枚欲しいです。\n\nまた、告知画像って感じでリングを持っているシャロちゃんの手だけのイラストもあると嬉しいです(手首まで出ているけど膝までは出ていないぐらい)。\n\nイラストはYouTubeとかのサムネイルみたいな感じの横長でお願いします。\n\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dyne2358/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2641912, "client_id": 3040795, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d4816f2/uploads/origins/83a9019d-8c2d-4649-8284-5620224e32df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2