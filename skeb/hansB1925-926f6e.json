えて頂きたいです。\n　もし可能なら全裸差分もお願いいたします....！\n\n■その他\n　指揮官の存在感は最低限。描写必要であればふた女性指揮官イメージで描いて頂けると嬉しいです。\n　服装は全裸か正装(この衣装です https://imgur.com/a/LTc2etl )にてお願いします。\n\n　修正は白線か黒線、蒲牢ちゃんアイコンであると助かります。\n\nご検討頂けますと幸いです。\nよろしくお願いいたします(✿ᴗ͈ˬᴗ͈)⁾⁾", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hansB1925/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 53728, "client_id": 35819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a864a041/uploads/origins/090c0eae-58df-4b57-85f1-c85e2cacfc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92fc522aa9b0038a714cb803b26e18d7", "srcset": "https://si.imgix.net/a864a041/uploads/origins/090c0eae-58df-4b57-85f1-c85e2cacfc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92fc522aa9b0038a714cb803b26e18d7, https://si.imgix.net/a864a041/uploads/origins/090c0eae-58df-4b57-85f1-c85e2cacfc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=408c2b94d52005a84cb4f48d737958b8 2x, https://si.imgix.net/a864a041/uploads/origins/090c0eae-58df-4b57-85f1-c85e2cacfc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f402c0c9255f3cda090124a3c8baa63 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a864a041/uploads/origins/090c0eae-58df-4b57-85f1-c85e2cacfc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80b7be1a3531007f4f4bc83a884abc10", "srcset": "https://si.imgix.net/a864a041/uploads/origins/090c0eae-58df-4b57-85f1-c85e2cacfc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80b7be1a3531007f4f4bc83a884abc10, https://si.imgix.net/a864a041/uploads/origins/090c0eae-58df-4b57-85f1-c85e2cacfc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bb3