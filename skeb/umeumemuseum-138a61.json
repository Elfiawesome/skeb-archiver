fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=421959b73287a3735f03f8583dca42dc, https://si.imgix.net/b1222785/uploads/origins/7a49d052-2380-4931-87a4-a5b559aeb390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04362b0ee193e2c65dc4e4e6db7d1c5b 2x, https://si.imgix.net/b1222785/uploads/origins/7a49d052-2380-4931-87a4-a5b559aeb390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6d9291a3bd0fa3e40ed391c54f0899f 3x"}, "body": "はじめまして。\n以前にXにて投稿されていました桜井梨穂子がとても可愛らしく、ぜひ私の推しも描いていただきたいと思い、今回依頼させていただきました。\n\n□希望内容\nアマガミ：森島はるか\n私服(シックで大人っぽい感じ)\n表情は柔らかめ(微笑みくらい)\nデートの待ち合わせ風なシチュエーションでお願いいたします。\n\n□用途\n個人鑑賞用(印刷：アクスタ、アクリルプレート等)\n\n□その他\n印刷想定ですので、A版刷りに適したサイズでお願いいたします。\nまた、納品データに関しては可能であれば宛名、人物、背景をレイヤー分けしていただけますと幸いです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umeumemuseum/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623111, "client_id": 1952341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ab4e5ffc833ea3e869f6c16b91fa22", "srcset": "https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ab4e5ffc833ea3e869f6c16b91fa22, https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2daa8519e9d9fcb228a8fb998f6291cd 2x, https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664971e45afedae91c750bb99f26709e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c2034592dcae58077de05167995314", "srcset": "https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0c2034592dcae58077de05167995314, https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7cd570904356def09338d9fdd61099f3 2x, https://si.imgix.net/839fef79/uploads/origins/2b539499-ce4c-4914-8283-43ec924d4fd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa4e0d216f453a8439d88738e5fa82e8 3x"}, "body": "はじめまして、個人Vtuberとして活動している剣未ヨギと申します！\n\nをきそ様の素敵はイラスト拝見させて頂きました！\n凄く可愛いくて、色味も素敵で、是非私を描いて頂きたいと思いリクエストさせて頂きました！\n\nもうすぐでハロウィンなので、ハロウィンにちなんだ剣未ヨギちゃんがみたいです！\n服装や構図やポーズ全てお任せ致します。\n\n使用用途はTwitchの配信内での使用、Twitter等のSNS投稿を予定しています。\n\n納品時はPSDデータで宛名、人物、背景でレイヤー分けしていただけると嬉しいです。\n\nよろしくお願い致します。\n\n被写体資料↓\nhttps://x.com/yogi_tsurumi/status/1677695800888139776?s=46&t=t8IqNYWX39_2YyDOrbm4gQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umeumemuseum/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623111, "client_id": 2055099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381c1ea073ac678fc87a723faedb3c00", "srcset": "https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381c1ea073ac678fc87a723faedb3c00, https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=588dd1440def827bea1bf2ce281e5ec8 2x, https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d089539330238f0fa31968bbbfc1631 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a886633d3a8a6021a17bd8629e460b41", "srcset": "https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a886633d3a8a6021a17bd8629e460b41, https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d589486b892d5b66b46a84e0537b628 2x, https://si.imgix.net/7acc248a/uploads/origins/ae4d6a76-d141-4570-b05c-bf6bd6c9172f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de110d0452ea61adc34ce492c26384c0 3x"}, "body": "今日は私のリクエストを読んでくれてありがとう！\n\n私のモデルに夏をテーマにしたアートをお願いしたいです。ビーチやリゾートを背景に、幸せそうな笑顔と白いリボンのついた可愛い黄色の日よけ帽子をかぶった彼女を描いていただけませんか？白いワンピースを着てほしいです。\n\n参考になるものはいくつかありますが、アーティスティックな変更を加えても構いません。\n\nキャラクターとポーズの参考：https://rust-scabiosa-2b2.notion.site/Summer-commission-98a6b3ce19d94e62a37e2b560a7854a3?pvs=4\n\nhttps://rust-scabiosa-2b2.notion.site/Summer-commission-98a6b3ce19d94e62a37e2b560a7854a3?pvs=4", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umeumemuseum/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623111, "client_id": 2153521, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93af4cae/uploads/origins/98794122-3327-4004-a4