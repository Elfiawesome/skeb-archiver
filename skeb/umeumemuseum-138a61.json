れないようにしていただきたいです。\n\n・納品時はPSDデータで宛名、人物、背景でレイヤー分けしていただけると嬉しいです。\n\n・参考資料\nhttps://drive.google.com/drive/folders/1195IoIeGotIAG6frZ6EbLgu0B4rWv5xe?usp=sharing\nツインテールかロングヘアのどちらかでお願いしたいです。\n\nどうぞよろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umeumemuseum/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2623111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0552671/uploads/origins/147d87e1-a9d1-4427-b0b8-de86e51523b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fa2bb0b13fec4a347f4a07bcf2e0d8b", "srcset": "https://si.imgix.net/c0552671/uploads/origins/147d87e1-a9d1-4427-b0b8-de86e51523b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2fa2bb0b13fec4a347f4a07bcf2e0d8b, https://si.imgix.net/c0552671/uploads/origins/147d87e1-a9d1-4427-b0b8-de86e51523b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3ddc1a38fc7c49193b205064fc32e51 2x, https://si.imgix.net/c0552671/uploads/origins/147d87e1-a9d1-4427-b0b8-de86e51523b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a02afd999caf3d0f6e5fc6d9626b1dcc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0552671/uploads/origins/147d87e1-a9d1-4427-b0b8-de86e51523b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33f70a880c46a71e12b598abcf582137", "srcset": "https://si.imgix.net/c0552671/uploads/origins/147d87e1-a9d1-4427-b0b8-de86e51523b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33f70a880c46a71e12b598abcf582137, https://si.imgix.net/c0552671/uploads/origins/147d87e1-a9d1-4427-b0b8-de86e51523b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=06bec478d1c27b49a3521962a12f07b6 2x, 