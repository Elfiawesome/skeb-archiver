b3-3cff3181a3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc4f5e703998dd55d6384c6088493531, https://si.imgix.net/39fdf96d/uploads/origins/63c0e15b-81d1-4c89-a0b3-3cff3181a3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=642217baee1d2a96a7ee69853cc11955 2x, https://si.imgix.net/39fdf96d/uploads/origins/63c0e15b-81d1-4c89-a0b3-3cff3181a3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07db24b2ff764cd305b019c7bfe49140 3x"}, "body": "フィオネコ様\n\nお世話になっております。\nシロエです。\n\n前回は素敵なイラストを描いていただき，誠にありがとうございました。\n今回もイラスト依頼をお送りさせて頂きました。\n\nこの度，フィオネコ様に描いて頂きたい方は， 個人勢Vtuberの『柚月きいろ（ゆずき きいろ）』さんのイラストです。\n依頼の内容は下記の通りとなっております。\n\n【参考資料】\n・柚月きいろHP\nhttps://lit.link/yuzucolor\n・柚月きいろXアカウント\nhttps://x.com/YuzukiKiiro\n・立ち絵MV\nhttps://www.youtube.com/watch?v=z-6nrV_DA0U\n\n【イラストイメージ】\n一枚絵で全身イラストです。\nモデルは，「柚月きいろ」さんです。\nチャームポイントは，オレンジ色の丸い瞳，ショートボブ，白のジャケット，縦ニット服，イヤリングや髪留め等のアクセサリー，可愛い絆創膏です。\n体型は，スリムで推定D-Eカップです。\n表情は，大人っぽい表情でお願いします。\n服装は，通常服（ジャケット無し）でお願いします。\nポーズ・その他は，フィオネコ様にお任せいたします。\n\n【納品形式】\n可能であればpsd，難しいようでしたらpngで大丈夫です。\n\n【使用用途】\nXでのファンアート投稿，個人的なTwitterやYoutube動画作成，サムネイル制作等の使用及び『柚月きいろ』さん本人がVTuber活動等（サムネ，告知，グッズ等）で使用します。\nその旨をご了承いただけましたら幸いです。\n\n【その他】\n可能でしたら，人物だけの透過もしくは表情差分があると幸いです。\nまた，サムネに使用しやすいように頭や髪，服装等が切れないよう描いてくださると助かります。\n\n以上が，依頼内容となっております。\nお手数おかけいたしますが，ご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ofjlhjQokic8gDt2g1mEpp1nE0jqg2w8?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@phioneko/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2548280, "client_id": 1616735, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b4e0686/uploads/origins/15d04bdc-4526-421c-ba98-19bde0c9a348?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ccd80ca9f72a8fd415ac081a583085e", "srcset": "http