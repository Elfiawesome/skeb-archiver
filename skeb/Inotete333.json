草色(#21A0DB)\n\n関係性：良き親友であり、良き相棒。\n\n使用用途：個人鑑賞、アイコンや壁紙への使用、TRPGセッションへの使用、非商用のもの。レイヤー別でのpsdファイルでお願いします。\n（AI学習の防止を希望する場合、学習を防止したデータも別でいただけると嬉しいです）\n\nキーワード：イギリス、諜報員と情報屋、バディ、親友、チェス、白猫とミニチュアダックス、紅茶、心理戦、青空、夜空 \n希望：お好きなように描いていただけたら！もし二人合わせての構図でしたら、単体ずつデータで分けていただけると嬉しいです。\n\n-----------------------------\n\n以上となります。初心者故に金額などに不備がありましたら遠慮なくキャンセルや再送信などして頂けたら幸いです。何卒よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-85U9NJ30rmSP_BC1sbGmyuBhT0Czn2v", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Inotete333/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3703053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a694da3e/uploads/origins/c54b409a-1577-4851-8eb9-e682e1d93068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3a3fd5a212c0182f718870988118c4", "srcset": "https://si.imgix.net/a694da3e/uploads/origins/c54b409a-1577-4851-8eb9-e682e1d93068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e3a3fd5a212c0182f718870988118c4, https://si.imgix.net/a694da3e/uploads/origins/c54b409a-1577-4851-8eb9-e682e1d93068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e73498f6bb5b34c08d81fb32ad270ef1 2x, https://si.imgix.net/a694da3e/uploads/origins/c54b409a-1577-4851-8eb9-e682e1d93068?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae14a41b9b040d33a9161385c52ed2f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a694da3e/uploads/origins/c54b409a-1577-4851-8eb9-e682e1d93068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b88208608a1241e1b963a97dbb4e5f90", "srcset": "https://si.imgix.net/a694da3e/uploads/origins/c54b409a-1577-4851-8eb9-e682e1d93068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b882086