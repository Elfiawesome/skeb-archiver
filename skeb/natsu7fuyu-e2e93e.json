ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d313f700d28f81588ae10ed7648e302", "srcset": "https://si.imgix.net/6e51fa5b/uploads/origins/8a6b86ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d313f700d28f81588ae10ed7648e302, https://si.imgix.net/6e51fa5b/uploads/origins/8a6b86ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e545d929e5d1204c1b6ff138bc03047 2x, https://si.imgix.net/6e51fa5b/uploads/origins/8a6b86ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdc1ce61da057291176e2d5f0ed145d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e51fa5b/uploads/origins/8a6b86ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5f2d88b5aac4addf1c9c00460f59811", "srcset": "https://si.imgix.net/6e51fa5b/uploads/origins/8a6b86ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c5f2d88b5aac4addf1c9c00460f59811, https://si.imgix.net/6e51fa5b/uploads/origins/8a6b86ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b93e3eb5f8c921994e9f7d21aca00c2 2x, https://si.imgix.net/6e51fa5b/uploads/origins/8a6b86ab-f30e-47e0-904b-9aecfe89107b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27513f8cdfd97dd2b443b7e44b64d723 3x"}, "body": "夏野まふゆ様\n\nvtuberとして活動しておりますヘノラクと申します。\nskebでお見掛けし、とても素敵なイラストに惹かれ、是非ご依頼したくご連絡いたしました。\n\n■イラスト内容\nVtuber「ヘノラク」を描いていただきたいです。\nたぬきの使い魔で、人間界で修行中の元気な女の子です。\n\n■キャラクター詳細\n髪型：茶色のミディアムロングヘア（肩甲骨くらいまで）\n目：タレ目、瞳は緑\n肌：少し褐色気味\n口：ωで、牙もあります。\n眉：若干マロ眉\n\n■用途\nアイコン（SNS,Discord等）\n収益化YouTubeのサムネイル\nSNSでの広告宣伝活動\nショートなどの動画制作\n\n■構図や要望など\nサムネイル等に使用する為、頭の先や髪の毛などは、先端まで切れないような構図だと嬉しいです。\n服装はジャケットを着ている通常着で、ポーズや表情はおまかせでお願いしたいです。\n\n■希望納品形式\n可能であればPSD、\nまたは背景やキャラクター等を別々にしたPNGファイルで頂きたいです。\n\n上記条件で可能でしたらお受けいただけますと幸いです。\nご検討の程、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Pc6JJyGHFCvPfZbXWDhh0l3bNr9tdhEQ?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natsu7fuyu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3886859, "client_id": 3895868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df153466/uploads/origins/5d7c7534-636d-4662-8ca0-a60d0257c8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6ed51db6863c046e0c2168a96774735", "srcset": "https://si.imgix.net/df153466/uploads/origins/5d7c7534-636d-4662-8ca0-a60d0257c8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6ed51db6863c046e0c2168a96774735, https://si.imgix.net/df153466/uploads/origins/5d7c7534-636d-4662-8ca0-a60d0257c8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=554e46e58c2180d2632f4def868f3369 2x, https://si.imgix.net/df153466/uploads/origins/5d7c7534-636d-4662-8ca0-a60d0257c8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a66230cf444467d20176ad853685ce28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df153466/uploads/origins/5d7c7534-636d-4662-8ca0-a60d0257c8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=936b1647184f197e38c77447a6b7f046", "srcset": "https://si.imgix.net/df153466/uploads/origins/5d7c7534-636d-4662-8ca0-a60d0257c8ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=936b1647184f197e38c77447a6b7f046, https://si.imgix.net/df153466/uploads/origins/5d7c7534-636d-4662-8ca0-a60d0257c8ad?bg=%23fff&auto=format%2Ccompress&