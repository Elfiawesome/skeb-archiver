キャラクターの恋人同士です。\n一見金髪が強気で振り回しているように見えますが、天然でマイペースな茶髪に金髪が翻弄されることもあり、空回りしがちです。スキンシップは茶髪→金髪の方が多めで、茶髪の方が素直に甘えたり触れたりします。\n\nお忙しいところ恐縮ですがご検討ください。\nまた、料金が不十分等がありましたら再送頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1HvcGwZNRYa1uZIkOQPrGXk40CRPA_Mc4?usp=sharing", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@td_a00/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3911583, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d51e780/uploads/origins/c8e018d3-810c-48e0-b0f1-3326715f8504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac97678dc356b331bc367718376d147f", "srcset": "https://si.imgix.net/5d51e780/uploads/origins/c8e018d3-810c-48e0-b0f1-3326715f8504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac97678dc356b331bc367718376d147f, https://si.imgix.net/5d51e780/uploads/origins/c8e018d3-810c-48e0-b0f1-3326715f8504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01c131fdaddd2f7b58b74d2db92dad3c 2x, https://si.imgix.net/5d51e780/uploads/origins/c8e018d3-810c-48e0-b0f1-3326715f8504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a57d2984051e35e8feea594745342aab 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d51e780/uploads/origins/c8e018d3-810c-48e0-b0f1-3326715f8504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9254bfdc66a9ee2ccbbb4e7186d7f77f", "srcset": "https://si.imgix.net/5d51e780/uploads/origins/c8e018d3-810c-48e0-b0f1-3326715f8504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9254bfdc66a9ee2ccbbb4e7186d7f77f, https://si.imgix.net/5d51e780/uploads/origins/c8e018d3-810c-48e0-b0f1-3326715f8504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur