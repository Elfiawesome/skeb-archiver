compress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=815a7d0557198709b21fb1d51fc719ef 2x, https://si.imgix.net/eaa9734d/uploads/origins/0d992865-324a-4364-992f-45d141fc8df4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fe682e235c203e942cb2b8b0a0d443a 3x"}, "body": "きゅどぅ様\n\nはじめまして！日頃きゅどぅ様の作品を拝見し、とてもキャラ性を意識した絵でとても素敵だと思っております！\n今回は、OCのTRPG用全身新規立ち絵を描いていただけないかと思いご連絡いたしました。\n(参考資料内のイラストは他コミッションへの利用許可を頂いております。)\n\n【見た目詳細】\n・APP：9\n・SIZ：7\n・STR：10\n・見た目年齢：8歳\n・身長：140cm\n・見た目性別：女性\n\n【顔詳細】\n・眉：⽩⾊、並行眉\n・⽬形：並行目、ジト目\n・まつ⽑：⽩⾊、⻑めかつ量多め\n・瞳：白色、ハイライト→なし\n・瞳孔：#010066、三日月型\n・⼝：⼝を閉じている、ムッとしている\n・眼帯：黒色、キャラからして右側につけている\n\n【髪型】\n・髪⾊：白色から#010066のグラデーション(花イメージのようなグラデ)\n・前髪：眉下ぱっつん、キャラからして右：左＝2：8 ぐらいの割合で分けている\n・横髪,後ろ髪：ストレート\n・⻑さ：床について引きずるぐらいの超ロング\n・髪質：サラサラ\n\n【服装】\n・サイバーパンク風の服(服イメージ1参照)\n・袖の長さが超長く、手が見えない\n・超短パン\n・太ももあたりにベルトがついている\n・靴は厚底\n・全体的に白色\n\n【立ち方】\n・クソだるそうに座っている\nor\n・クソだるそうに立っている\n\n【使用用途】\n・個人鑑賞\n・他skeb等での依頼の参考資料\n・TRPGでの立ち絵\n・同卓者への共有 \n・SNSでの卓報告(Notion等ワンクッションはさみます) \n・身内間のみのYouTube上での録画限定公開\n\n以上、金額や内容に不明・不足点等ございましたら再送いただきたく思います。\nお忙しいようでしたら、お手数ですがキャンセルいただけますと幸いです。\n ご検討の程よろしくお願いいたします。\n\n花鳥風月\n\nhttps://drive.google.com/drive/folders/1VRYORzWR0w5vMcVohTuKbTnfBeS-87Lz?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KyuDwu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2819633, "client_id": 2554096, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=213ae5d48d4e1113ec943491da473269", "srcset": "https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=213ae5d48d4e1113ec943491da473269, https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11d4ca3543ca76a6fb18dbf90ce5091c 2x, https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38fa4f974d2f57d48c58d678b6e57859 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b75443b5150c1c1ee686a7b768a38eac", "srcset": "https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b75443b5150c1c1ee686a7b768a38eac, https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eea192672a0b8d719073e7785a5421b9 2x, https://si.imgix.net/d996dc75/uploads/origins/e3375cf1-0e4d-4f6f-8ebc-aec436186f05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a41a20b6a100bcf2234a5fbfbd044f7a 3x"}, "body": "きゅどぅさんの描かれるイラストが大好きです！イキイキとしたキャラクターの表情に、見ていてワクワクする気持ちになります。\n\nエモクロアTRPG「双囃子」の共鳴者を描いていただきたくskeb依頼を送りました。ネタバレのない範囲で設定を記載します。\n\n\n【キャラクター設定】\n▽HO1\n蛙月 透士(あつき とうし)\n男性 / 31歳 / 163cm / モチーフ: 雨蛙\n\nお笑いコンビ「甘蛙（あまがえる）」ボケ担当。\nいつの日が”笑いの大舞台で跳ねる瞬間”を夢見ている。\n父親からは実家の八百屋を継ぐよう迫られており、人生の岐路に立たされてもいる。\n\n見栄っ張りだが愚直な性格。日頃から陰でお笑いの研究に励んでおり、他人のネタを無表情でじっ...と見て観察する癖がある。格好付けたいので努力してる様子は他人にあまり見せようとしない。\n\n[外見的特徴]\n・タレ目、タレ口、ツリ眉\n・アホ毛有り。前髪はセルフカットしておりぱっつん気味\n・サスペンダーを着用している\n\n[その他]\n・標準語。友人家族誰に対しても基本的に敬語で話す\n・相方のことは「酉治(ゆうじ)くん」と呼ぶ\n\n\n▽HO2\n甘鷺 酉治(あまさぎ ゆうじ)\n男性/ 29歳/ 177cm / モチーフ: 鳥の甘鷺\n\nお笑いコンビ「甘蛙」のツッコミ担当。\n短気で喧嘩っ早い。目つきが悪い。田舎のヤンキー風。\nお笑いとは縁のない人生だったが、数年前に蛙月に漫才をやろうと誘われ現在に至る。\n\n人気女優のいとこがいて、親戚のあいだで彼女と比べられることが増えている。そんな親戚たちを甘蛙の笑いで跳ねのけてやると意気込んでいる。\n\n[外見的特徴]\n・髪は自分で赤く染めている\n・目つきが悪い。見ていただけで喧嘩を売られる\n・ジャケットを着ていない時はYシャツを腕まくりしている\n\n[その他]\n・関西弁で話す\n・相方のことは「透士(とうし)くん」と呼ぶ\n\n\n【構図例】\n(記載例を参考にしなくても構いません。ふたりの表情が見やすい構図やポーズだと嬉しいですが、自由に描いていただければ幸いです。)\n\n・雑誌の表紙や、特集記事の写真のような構図\n・公園などで漫才の練習をしている構図\n\n\n【用途】\n・鑑賞目的での同卓者への共有\n・個人用のグッズ作成\n\n内容に問題や金額不足などあれば再送信またはキャンセルをよろしくお願いします。ご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/16vfbSvELzmKRV6DyJ9M0XYhiel2ZIxZ5", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KyuDwu/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a198a557/uploads/origins/0a8e3cda-370a-4926-a49e-b0c72f6f5b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac65b791c4f190bd1f3193adb75aa5b5", "srcset": "https://si.imgix.net/a198a557/uploads/origins/0a8e3cda-370a-4926-a49e-b0c72f6f5b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ac65b791c4f190bd1f3193adb75aa5b5, https://si.imgix.net/a198a557/uploads/origins/0a8e3cda-370a-4926-a49e-b0c72f6f5b52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8aea4acf7a47f08b7a6db9831419279f 2x, https://si.imgix.net/a198a557/uploads/origins/0a8e3cda-370a-4926-a49e-b0c72f6f5b52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5641c0a37289cc491eb67f270eb7347 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2819633, "client_id": 2509179, "nc": 17}], "sent_works": [], "similar_creators": [{"id": 124822, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "なかず", "screen_name": "__nakaz__", "avata