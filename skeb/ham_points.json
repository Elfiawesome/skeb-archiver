op&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec22ae438edd4ab8faffe3ecaf7114a9", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 46390, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ham_points/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46390, "client_id": 66065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6129e25e/uploads/origins/b8f77897-993b-46ce-a94e-7f2cb9f3339b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b449a5eab4296693c2f38dcc59aa6bf7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6129e25e/uploads/origins/b8f77897-993b-46ce-a94e-7f2cb9f3339b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89d1045ea2a95334ca0330282a1a6d0b", "src_set": ""}, "body": "再提出\n\n先生、こんにちは、\n\nこの度は、このような依頼をさせていただき、大変嬉しく思っております。私のオリジナルキャラクター「テイラーちゃん」を描いていただけたら嬉しいです。\n\n内気でニンフォマニアックな女の子です。オリーブ色（#afa264くらい）の髪と髪の間の目を見せてください。\n\nキャラクターリファレンス：https://rebrand.ly/b22f74\n\nメイド服を着て、服を脱いだ状態で、エロティックな苦境にある彼女を描いてください。彼女がご主人様やその友人たちに奉仕しているもので、できれば口で。\n\nよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ham_points/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46390, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2569dc33/uploads/origins/4227bf73-6b68-4209-b10c-07b1857eabe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e7295c8cbdac4cc48025606529ee5fa", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2569dc33/uploads/origins/4227bf73-6b68-4209-b10c-07b1857eabe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bce64bcad09c1b12daf84ffe1ba501fc", "src_set": ""}, "body": "風邪を引いて寝ているところを起こされて脱がされて、風邪の治し方実演みたいな名目で朝から夕方まで公開調教陵辱されてる女の子お願いできますか。\n風邪に陵辱の追い打ちで、健気に泣きながらがんばらされてる子に、風邪の子には優しくするという建前のフリはしつつ、やっぱりめいっぱい全力でひどい目に遭わせてもっと泣かせて、泣き顔にぶっかける、みたいなノリで、全部お任せしますのでたくさんハードでかわいそうな目に遭わせてください。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ham_points/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 46390, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8fc448f/uploads/origins/d31471eb-914e-49e0-a0c0-e2349300d7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50a4b9e41f9cdd27a9ebf95a3327953d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8fc448f/uploads/origins/d31471eb-914e-49e0-a0c0-e2349300d7d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e33e4ef3fede9b62b717b7c48067701e", "src_set": ""}, "body": "街中で迷子で泣いていたら脱がされて、顔や髪にぶっかけられて、迎えに来たお母さんの前で立たされて思いっきり器具責めされて泣かされてる女の子お願いします。\n髪はセミロング〜ロング、眼鏡なし。\n泣いてる子に容赦なく追い打ちしてもっと泣かせて、その姿をお母さんや周りの人に見てもらう、泣けば泣くほど褒められてもっと責められる、みたいなかわいそうかわいさでお願いします。\n器具はたくさんのローター詰め込みとか、かわいいけどでっかくてエグいアナル尻尾とか、お任せします。\n設定が必要であれば、街中で泣いてる子を陵辱するドッキリ番組の企画で、子供は泣くのが仕事みたいなところあるので容赦なく泣かされて誰も助けてくれない、みたいな感じですがお任せしますし、女の子メインなので設定描写等は特に無くて大丈夫です。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ham_points/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6627f790/uploads/origins/006c4bec-9a45-4142-9628-fd912e8faf74?bg=%23fff&auto=format%