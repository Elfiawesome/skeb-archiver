解であればそれを説く話でも、何でも結構です。\nこの白狼天狗の性格を鑑みて難しい様であれば、どうぞ本件はお断りになってくださいませ。\n\n具体的なお話や、その他の内容については（別の登場人物が居るか否か等々）すべてお任せ致します。\n\nリクエストは以上となります。\nもしよろしければ、お願い申し上げます。", "nc": 9, "word_count": 3424, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@henpu_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 303346, "client_id": 313622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1677563026348843008%2FbbuTCOgV.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5bfed7a768049b7638a67d688526d6", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1677563026348843008%2FbbuTCOgV.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5bfed7a768049b7638a67d688526d6, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1677563026348843008%2FbbuTCOgV.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c7c916554493a6227ee74b77406dae8 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1677563026348843008%2FbbuTCOgV.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0092873223ca2d1e012716448e696ffb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%