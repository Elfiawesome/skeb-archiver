91-6479-4743-a74b-e82cdc69e83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10db27a578ba88792f92928791390393", "srcset": "https://si.imgix.net/0db70b0d/uploads/origins/c3676991-6479-4743-a74b-e82cdc69e83e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10db27a578ba88792f92928791390393, https://si.imgix.net/0db70b0d/uploads/origins/c3676991-6479-4743-a74b-e82cdc69e83e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c840bc8571ad53ede812992ee61c19df 2x, https://si.imgix.net/0db70b0d/uploads/origins/c3676991-6479-4743-a74b-e82cdc69e83e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f10e1e1af63db0250ba2ef947db01353 3x"}, "body": "前回はていちゃんのイラストありがとうございました。\n\n残暑厳しい9月末に最後の水着イラストが見たく、いすくちゃんとていちゃん二人の水着イラストをお願いしたいです。\n\nhttps://www.pixiv.net/artworks/109773054\n以前Pixivで上げられていたこちらのスク水でもオリジナルの水着でもお任せで、いすくちゃんは最近描かれた日焼け姿だと嬉しいです。\n\n可能なら、ていちゃんサイズの水着で胸元がちょっと（かなり？）ゆるゆるないすくちゃんと、その逆でキツキツなていちゃん、という水着交換した二人も見たいです。\n\nポーズやセリフなどはお任せします。\n\nご検討よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@function_teisk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 952414, "client_id": 1533762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc308ad8dd5d7911ed447b58b67700a5", "srcset": "https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc308ad8dd5d7911ed447b58b67700a5, https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49591a443ea1a0c472f798fc25d54b09 2x, https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b413a2ce07260b00cacc19362072f3bd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7857bc9ae507c39896d2766129bdf38f", "srcset": "https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7857bc9ae507c39896d2766129bdf38f, https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1c2d42fa6f7d6b21f8847ba1ccd44d2b 2x, https://si.imgix.net/5027e84b/uploads/origins/889821ba-52b8-4284-90fb-87ece4563cbf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3733b9d4bd82eb9a669bc0f6fa1a93b3 3x"}, "body": "初めまして。Pixivでイラストを見ていて絵柄が可愛いなぁと思っていましたが、Skeb開設されたということでリクエスト送らせていただきました。\n\nメスガキ感とおっぱいが溢れるていちゃんが好きなのですが、Pixivで上げられていたこちら（https://www.pixiv.net/artworks/109799302）のていちゃんが特にツボでしたので、似たイラストになって恐縮ですが、同じように着衣をたくし上げて乳首が見えるか見えないか位の位置で止めて劣情を煽ってくるていちゃんをお願いします。\n\n・着衣は　ビキニブラorスポブラorタンクトップからお好みで選んでください（色やデザインもお任せ）\n・アングルは下乳を見上げているような感じでもう少し下側から\n・ていちゃんの顔はおっぱいに遮られてちょっと見えきらない位が良いですが、バランス難しければ顔が見えるようなアングルで調整いただいて大丈夫です。\n・元イラストの「ちょっぴり妄想が膨らむ擬音」っていう表現をここでも入れていただき、煽っているていちゃんのセリフがあると嬉しいです。（内容はお任せします）\n\n可能であれば、着衣からぶるんとおっぱいが溢れ出た瞬間と、妄想が吹き出した擬音の差分も頂きたいです。\n\n背景など細かな所もお任せします。\n\nご検討、よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 303000, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヘンリア@skeb募集中", "screen_name": "henria_yh", "avatar_url": "https://pbs.t