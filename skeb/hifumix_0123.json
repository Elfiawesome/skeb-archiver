nly_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hifumix_0123/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63aa45ab/uploads/origins/e3608817-3ce1-4186-86bb-12e608b8cf21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d837af7edd85cf2b63eb989c56f51d7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63aa45ab/uploads/origins/e3608817-3ce1-4186-86bb-12e608b8cf21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6338274c6d1668d62c59551d79a3fd58", "src_set": ""}, "body": "先生こんにちは！\nいつも素敵なイラスト楽しませていただいております。\n先生が描かれるメイド姿の岐阜さんがすごく好きです。もしよろしければ、戦うメイドさんな岐阜さんと執事姿の富山さんを描いてはいただけないでしょうか。\n\nこれからも応援しています！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/96", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bdc78517/uploads/origins/2e0df457-5de8-4eb8-9607-9f083f941edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=19cc84a9ab0bd9671ccfac46742be015", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2983992, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hifumix_0123/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/511d0aca/uploads/origins/e4e6ffc4-420b-4a49-a169-d2d4d998e79b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d43ca0b23d9b04b6e81426ee8ec878cf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/511d0aca/uploads/origins/e4e6ffc4-420b-4a49-a169-d2d4d998e79b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979e2c370167e9f681617f454c3cd566", "src_set": ""}, "body": "いつもワンドロ楽しみにしております。\n夏祭りの時期なので、テーマ「八木節」をお願いします。\n八木節の本場、群馬さんと栃木さんでお願いしたいですが、最近栃木さんのリクエストが多めなので、栃木さんはできればで大丈夫です。宜しくご検討ください。\n\n軽快で賑やかなお囃子の中、輪になって手踊りする人、聴いて楽しむ人。子供の頃に毎年行った町内会の夏祭りの八木節が今も良い思い出です。\nお囃子や踊りが地域によって異なることも大人になって知り、また興味深いです。\nどこの八木節も、みんな楽しんでいますね。これからもずっと続いてほしいです。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c824640/uploads/origins/ef8f54d5-814c-4f51-a4ce-d2beb4911f81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af9b278e9184f043e6fea6bed305d8bf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c824640/uploads/origins/ef8f54d5-814c-4f51-a4ce-d2beb4911f81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35866a7a19b7e2b832004b703b6205b7", "src_set": ""}, "body": "一二三先生、こんにちは！\nマガポケの全話無料をきっかけに四十七大戦を知り、単行本を購入しました…しかしそのときにはすでに、購入特典のゆる神様仮想戦闘ペーパーがなくなってしまっていたのです。推しのゆる神様の戦いを見たかったこの思いを、skebで叶えさせてください…！\nということで、京都さんと滋賀さんの戦闘をリクエストさせてください。どんな内容の戦いでも結構です、おまかせします。\n\n暑い日が続きますのでお身体にお気をつけください。これからもずっと、応援しています。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02e62c93/uploads/origins/0016f110-fa4b-4d07-bc8b-3262f1cb3020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e6bc7be4be8d96bd3dbe6a4e6e3beb8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02e62c93/uploads/origins/0016f110-fa4b-4d07-bc8b-3262f1cb3020?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=205ce345480fb8b89010d2ae2cf81603", "src_set": ""}, "body": "一二三先生こんにちわ！\nいつも配信を楽しみにしています。\n\n気づいたら早いものでもう7月、ユリが美しい季節です。\nなので、「神奈川さんとヤマユリ（神奈川県の花）」の絵をお願いします。\n\nこれから夏本番。\n暑い日が続きますが、熱中症などに気をつけてお過ごしください。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/92", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0dcf2011/uploads/origins/0ec9fe59-5014-47ea-a830-4adcb73de54d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=123ea00cdb7f81b6864f807a4d356f6d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2983992, "client_id": 3493346, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hifumix_0123/works/91", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46789014/uploads/origins/0e63b509-44a8-4d24-9be0-0ff25d690841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=965a47519f80e11a5d4f4b6e1fc636eb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46789014/uploads/origins/0e63b509-44a8-4d24-9be0-0ff25d690841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9bef2843e88977417c55f03dc01d36", "src_set": ""}, "body": "一二三先生、いつも素敵なイラストありがとうございます。\n「栃木さんと九尾の狐」をリクエストしてもよろしいでしょうか？\nお身体に無理のない範囲でよろしくお願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/90", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2983992, "client_id": 3668024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d194894/uploads/origins/07946604-9a9d-4b5a-bc5b-f1034a5163d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dba6226f1d4e2b738e5fa4b17c9b67c4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d194894/uploads/origins/07946604-9a9d-4b5a-bc5b-f1034a5163d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7d76b4cb17400ea7159362968649d7a", "src_set": ""}, "body": "先生こんにちは。いつも作品を楽しく拝見しております。\n早速リクエストなのですが、九州編の回想シーンで登場した「明治時代の熊本さん」のかっこいいイラストをお願いすることは可能でしょうか？\nお忙しいとは思いますがぜひよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/89", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2983992, "client_id": 3541397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2b7c33c/uploads/origins/c0b280f6-06cd-4f05-8d49-1d50c5c2d89e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2730b74593613f61c51d1a24620f8f9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2b7c33c/uploads/origins/c0b280f6-06cd-4f05-8d49-1d50c5c2d89e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0418abb2a51a4438728ac6f857ac59f8", "src_set": ""}, "body": "一二三先生、イラスト配信を楽しく拝見しています。\nイラスト リクエストとしまして、以下の2つの内どちらかを希望いたします。\nイラスト詳細は、一二三先生にお任せいたします。\n\nリクエスト①「麦屋節の男踊りを格好よく踊る富山さん」\nリクエスト②「麦屋節を格好よく踊る富山さん　with 石川さん」\n　　　　　　　石川さんは、男踊り、女踊り、楽器演奏などなど…参加の内容はお任せいたします。\n\n「麦屋節」は、四十七大戦でチラッと、小京都として紹介されました「城端」のお祭で唄われ踊られる民謡です。\n祭りの最後は、「総踊り」で町の方と一緒に、誰でも参加して踊れるお祭なので、個人的に楽しいお祭です。\nご多用とは思いますが、ご検討をお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/88", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ece21344/uploads/origins/382cc1b9-9ed1-40ec-8f8a-8cac83b2e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f29c80ea8e08d8f00adcde6608b60994", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ece21344/uploads/origins/382cc1b9-9ed1-40ec-8f8a-8cac83b2e59c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26ba7401cabc60229f717e2655ec66a1", "src_set": ""}, "body": "先生いつも楽しませていただいています。\n\n以前別の方がリクエストされた「もしも47都道府県が一つのクラスだったら」で沖縄さんと北海道さんの前で鍋を持っているだろう山形さんが気になって仕方ないです！\n彼女は学校に鍋を持ってきているのでしょうか…\n詳細をみてみたいです！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/87", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2983992, "client_id": 3384925, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5075e92/uploads/origins/e90b19b5-60e3-45f4-81f5-0a0c14065ce1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcf6746ccfdfdb3de735de2bf9560286", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5075e92/uploads/origins/e90b19b5-60e3-45f4-81f5-0a0c14065ce1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1407012e6e46351534ff097514fe8289", "src_set": ""}, "body": "一二三先生、こんにちは！\n今回もNow playingのリクエストになるのですが、2014→2015年賀状[http://number1of2lumbers3.blog.fc2.com/blog-entry-50.html]\nの標的と殺し屋っぽい(？)東雲くんと西園寺をお願いしたいです……！詳しい状況などはおまかせします！\nよろしくお願いいたします。\n\nhttp://number1of2lumbers3.blog.fc2.com/blog-entry-50.html", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2983992, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/90c8ee61/uploads/origins/174046d8-a298-4fcb-8fa0-67130afd8e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d51aa574d84371179f573d9e22c2061", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90c8ee61/uploads/origins/174046d8-a298-4fcb-8fa0-67130afd8e07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e0c9da53ae740f55620f658cdb2b0d9", "src_set": ""}, "body": "いつもワンドロ楽しく拝見しています。\nリクエストですが、「FITが幼馴染な関係」というのがどんな風なのか知りたいので、イメージがわくイラストをお願いします。キャラクターはおまかせします。\nどうぞよろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hifumix_0123/works/85", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd34ce1d/uploads/origins/58830b51-ae70-4761-b980-81f5bb1b50f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22ad9972