s/71e14687-e634-412f-8ec5-31ca0ba7e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88e9853143a9cb4ae8144186d1ace7b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0827f648/uploads/origins/71e14687-e634-412f-8ec5-31ca0ba7e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=719001961321885605f2165fc7ebd021", "srcset": "https://si.imgix.net/0827f648/uploads/origins/71e14687-e634-412f-8ec5-31ca0ba7e722?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=719001961321885605f2165fc7ebd021, https://si.imgix.net/0827f648/uploads/origins/71e14687-e634-412f-8ec5-31ca0ba7e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5e579c9ce8533e1e8f0dcf7933177c0 2x, https://si.imgix.net/0827f648/uploads/origins/71e14687-e634-412f-8ec5-31ca0ba7e722?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72161e77bae0f01d4fc32e91ddc887c4 3x"}, "body": "こんにちは！あなたの絵のスタイル、すごく素敵ですね。私のVTuberのキャラクターを描いていただけませんか？これは、ネット上で一番「臭い」（カオスな）フェレットになった私を表現したものです！！予算が限られているので、あなたが一番良いと思うように描いてください！ クレジットを記載してグッズに使わせてもらいたいです！ もし可能なら、マスカラがにじんだ感じも加えてもらえませんか？ こんな感じ：https://x.com/The_Creator589/status/2066558272488788297?s=20\n\n主なポイント：\n- おっぱいはなし。私は超平ら（ノンバイナリー）です\n- 口を閉じた時は牙が1本（左側）だけ見えるように、口を開けた時は両方の牙が見えるように\n- 手には影があり、爪は長い\n- シャツには「DOOK！」と書いてあります。これは幸せなフェレットが出す鳴き声です！ \n- 肩、頬、鼻の上にそばかすがあります\n\n⭐️ テキストと背景を削除可能なPSDファイルを必ず含めてください！（マスコットを含めた場合は、マスコットも削除可能にしてください）\n\nhttps://drive.google.com/drive/folders/10NiEaUWS4hW94YWipB1cInzBkwREcKio", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MedakaNokoz5sn/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3996152, "client_id": 935660, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef731fa4