】 28歳男性/180cm/髪:ホワイトブロンド/瞳:ウィステリア/左耳にイヤカムとピアスをつけている\n物腰柔らかだが、強かさもある。\n顔が良い。(APP15)\n\n【HO6】 34歳男性/199cm/髪:黒髪/瞳:赤/丸メガネ\nマイペースでミステリアス。秘密主義で掴みどころはないが、なんだかんだうまくやっている。\n\n\n(服装など不明瞭なところなどはオオキ様の方で簡略化いただければと思います...！)\n-----  \n  \n\n料金の不足などございましたら、オオキ様からご提示ないしは再送いただければと思います。\n\n大人数の依頼となり大変お手数おかけいたしますが、検討いただければ嬉しく存じます。\nこういった依頼に不慣れのため不手際等ございましたら申し訳ございません。\nどうぞよろしくお願いします。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_A_A_trpg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3233645, "client_id": 425331, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9aa6f3f/uploads/origins/b616a112-6467-45e8-9c5d-60c1693338d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e72353005501207c0451e22db6e3cca8", "srcset": "https://si.imgix.net/a9aa6f3f/uploads/origins/b616a112-6467-45e8-9c5d-60c1693338d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e72353005501207c0451e22db6e3cca8, https://si.imgix.net/a9aa6f3f/uploads/origins/b616a112-6467-45e8-9c5d-60c1693338d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f0b9436f2e47d6e2ac5052228c2e571 2x, https://si.imgix.net/a9aa6f3f/uploads/origins/b616a112-6467-45e8-9c5d-60c1693338d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38ee7c6da429ceedeb44a019ccd302ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9aa6f3f/uploads/origins/b616a112-6467-45e8-9c5d-60c1693338d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b899789e968527af2dc7ad49ae36ebf", "srcset": "https://si.imgix.net/a9aa6f3f/uploads/origins/b616a112-6467-45e8-9c5d-60c1693338d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b899789e968527af2dc7ad49ae36ebf, https://si.imgix.net/a9aa6f3f/up