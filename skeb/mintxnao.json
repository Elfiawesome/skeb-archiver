ator_id": 2855008, "client_id": 76306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02930c2d/uploads/origins/f384a53f-5dc3-4699-b134-9df5b0c63118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d1445d6fc0e60bd08c5976bea368ba3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02930c2d/uploads/origins/f384a53f-5dc3-4699-b134-9df5b0c63118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f59aa4bbea6b1d59d09dae6ed0c116f4", "src_set": ""}, "body": "はじめまして。\n今回一ノ勢七緒様のイラストを拝見し、私のオリキャラを背景付きで描いていただきたいと思いご連絡させていただきました。\n\nキャラクターデザイン資料\nhttps://drive.google.com/drive/folders/1GzAfHLWsos6D47uJPWLEy8ueHRK1qjUz?usp=sharing\n・色っぽい雰囲気を出す大人のお姉さん\n・銀色のストレートロングヘア―\n・青色の目\n・髪には画像のような髪飾りをお願いします。\n\n巫女服でおみくじをこちらに向かって手渡そうとしているような構図をお願いしたいです。\n胸は大きく、さらしなどで抑えつけているわけでもないので胸がしっかりと強調されて隠しきれない谷間が見えるような形で、服装と仕草からいつもよりも艶めかしく見えます。\n\n縦向けのイラストで全身が見えるぐらいの描写にしていただけると嬉しいです。\n\nそれではご検討よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mintxnao/works/526", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8ab5fcd6/uploads/origins/65fd7fa6-f16b-4ec9-98b5-64a6cd3a913b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86a26fe55f51bdd3d0b3f57c28be0182", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2855008, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mintxnao/works/525", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a0212f79/uploads/origins/80690d10-d002-40c2-83d0-2ae5a977ad36?bg=%23fff&auto=