.net/05a930f7/uploads/origins/3630ec59-764a-4ba6-a59b-4e7b49ff8f71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=94584fb91e05c89c819b032237f0d43c 2x, https://si.imgix.net/05a930f7/uploads/origins/3630ec59-764a-4ba6-a59b-4e7b49ff8f71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74ccbc6bf57a1da7353b916879409285 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05a930f7/uploads/origins/3630ec59-764a-4ba6-a59b-4e7b49ff8f71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58a8dc2ea42c994693720f10ca87ccad", "srcset": "https://si.imgix.net/05a930f7/uploads/origins/3630ec59-764a-4ba6-a59b-4e7b49ff8f71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58a8dc2ea42c994693720f10ca87ccad, https://si.imgix.net/05a930f7/uploads/origins/3630ec59-764a-4ba6-a59b-4e7b49ff8f71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fbe5f47d774e01af3d607a018ebf780 2x, https://si.imgix.net/05a930f7/uploads/origins/3630ec59-764a-4ba6-a59b-4e7b49ff8f71?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b81d6c5ca90ec3108da460be9b113466 3x"}, "body": "アピールありがとうございます。これまで描いていただいているのは、FINAL FANTASY XIVで使用している自機です。確かにあなたの絵柄に合いそうだと感じましたので、リクエストさせていただきます。まずはアピール金額のままお出ししますが、不足でしたら遠慮なく再送依頼にしていただければと思います。\n\n過去の作品を拝見しました、手を描かれるのが得意なんですね。リーパーというジョブで相棒のアヴァターと一緒のところばかり描いていただいていまして、ゲーム内でも手のポージングがとても魅力的だなぁと思いながら遊んでいます。アヴァターは妖異と呼ばれる種類の魔物で、一般的に想像される悪魔と似た性質を持っています。人との契約に応じてくれますが、同時に隙を突いて欺き、魂を食べようと企んできます。大鎌を握って戦いながら、不意に見せる怪しいモノを使役している雰囲気を存分に醸し出す手指の角度が、好きなところのひとつです。また、アヴァターと関係のないクエストでも度々「美味しそうな魂」と言われるので、私は、アヴァターもそう思っているのではないかと考えています。それでも一緒に戦ってくれるだけの、好意か打算があるような関係だと素敵だなぁと…。私が単純に妖異好きで、アヴァターがふかふかの怖かわいい生き物に見えているのもありますが。\n\nせっかくですので、既存のモーションに拘らず、妖しく蠱惑的な手元のポーズで描いてみていただきたいです。1人きりだと小恥ずかしいので、アヴァターかそれらしき影とツーショットでお願いします。\n過去の作品の背景も非常に綺麗でしたので、ゲーム内の風景の再現でなくて構いません、自由に描いていただきたいです。同様に、服装や武器もも再現度には拘りませんし、雰囲気に合わせて全く別のものを着せたりしても大丈夫です。\nいつも使用している資料をお付けしますが、不足がありましたら遠慮なく再送依頼していただければと思います。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://photos.app.goo.gl/DWjpYY3eK5VPHkf88\nhttps://photos.app.goo.gl/ZMmgdvFubhRQf5928\nhttps://photos.app.goo.gl/ne3Keun6h6nfoJ2c9", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Saku_0066/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3068637, "client_id": 2471727, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40980b66/uploads/origins/a3008257-4848-4cab-90e0-ec89051cb815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0cabc4be3a8b237262f20897d0d618c", "srcset": "https://si.imgix.net/40980b66/uploads/origins/a3008257-4848-4cab-90e0-ec89051cb815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0cabc4be3a8b237262f20897d0d618c, https://si.imgix.net/40980b66/uploads/origins/a3008257-4848-4cab-90e0-ec89051cb815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8db81ff9874af87744ded7a97d1fb079 2x, https://si.imgix.net/40980b66/uploads/origins/a3008257-4848-4cab-90e0-ec89051cb815?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ed6e546503f1f1e700aeb6657b462af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40980b66/uploads/origins/a3008257-4848-4cab-90e0-ec89051cb815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bf2367b6043270f20a7968682c73416", "srcset": "https://si.imgix.net/40980b66/uploads/origins/a3008257-4848-4cab-90e0-ec89051cb815?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bf2367b6043270f20a7968682c73416, https://si.imgix.net/40980b66/uploads/origins/a3008257-4848-4cab-90e0-ec89051cb815?bg=%23fff&auto=forma