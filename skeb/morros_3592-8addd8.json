/cabinet/06818160/imgrc0095872261.jpg\nhttps://gyazo.com/262f868cf1919f47bc18486d5ad41e15\n\n○表情/構図\n片手には赤ワインが入ったグラスを持ってこちらを見つめています。\n若干の汗を描いて欲しいです。\n\nちょっとエッチな感じでお願いします（誘ってるような感じ）\n\n・背景\n時間帯は夜\nホテルの部屋のイメージで、室内は間接照明の明かりで少しだけ明るいです。\n\n・その他\n巨乳に描いて頂けると嬉しいです。\n黒のニーソ/タイツ大好きです。\n\n宜しければ、ご検討お願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@morros_3592/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1144865, "client_id": 459617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bac9c68/uploads/origins/82c62c7c-fea6-4e8a-856c-36e9f360d55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60002e974693d85e6eb8cef959f34e44", "srcset": "https://si.imgix.net/3bac9c68/uploads/origins/82c62c7c-fea6-4e8a-856c-36e9f360d55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60002e974693d85e6eb8cef959f34e44, https://si.imgix.net/3bac9c68/uploads/origins/82c62c7c-fea6-4e8a-856c-36e9f360d55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61474b1da3e8c3d325cd0aaae063a049 2x, https://si.imgix.net/3bac9c68/uploads/origins/82c62c7c-fea6-4e8a-856c-36e9f360d55a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e95c614eacfd1ee9b6a78aa3f7262dc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bac9c68/uploads/origins/82c62c7c-fea6-4e8a-856c-36e9f360d55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0249d11ec3b4ebdd97c3d1759bdd19", "srcset": "https://si.imgix.net/3bac9c68/uploads/origins/82c62c7c-fea6-4e8a-856c-36e9f360d55a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc0249d11ec3b4ebdd97c3d1759bdd19, https://si.imgix.net/3bac9c68/uploads/origins/82c62c7c-fea6-4e8a-856c-36e9f360d55a?bg=%23fff&auto=