om/a/gXc8KXL", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@morros_3592/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1144865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51c03fd9dd17dcc3830cec44719127d", "srcset": "https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d51c03fd9dd17dcc3830cec44719127d, https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=965d75b34d9fcdebc36c714ddb20616b 2x, https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=48509d148fd7455840d98d6d405370f7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=438453ee296a9af4876a9d51b72a0157", "srcset": "https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=438453ee296a9af4876a9d51b72a0157, https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=411f7ff2817419a56fa7f065cedef1ae 2x, https://si.imgix.net/50dd6e1a/uploads/origins/d55e14dd-706f-4487-997f-d559ba1f69b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40374bf414843309c356eccccf393416 3x"}, "body": "ヴァイス、ルビー、ブレイクをもう一度描いていただけますか？前と同じように描いてください。ワイスは穴のあいたタイツを履いています。太もものあたりで下ろされていて、濡れたアソコが見えています。ルビーはブラジャーをしていますが、下に引っ張られて胸が見えています。ブレイクは、片足に太ももまであるパンストを履いている。もう片方の足はむき出しです。彼女の手は一緒に縛られています。\n二人が隣り合って座っているところを描いてください。ブレイクはルビーとヴァイスの間にいます。二人の足はすべて隣り合っていて、絵の中で見えています。\nワイスはブレイクの足の間に片手を入れて、彼女を喜ばせています。もう片方の手でブレイクの腕を頭の上に上げている。\nルビーがブレイクの唇にキスをしている。ルビーが自分の脚の間に手を入れてオナニーしている。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@morros_3592/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bcffbddb/uploads/origins/618937c7-9e60-4f57-b4be-c5d00ba43b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25bbf5463e12683eaa571b922d12d59c", "srcset": "https://si.imgix.net/bcffbddb/uploads/origins/618937c7-9e60-4f57-b4be-c5d00ba43b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25bbf5463e12683eaa571b922d12d59c, https://si.imgix.net/bcffbddb/uploads/origins/618937c7-9e60-4f57-b4be-c5d00ba43b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4b7a0d218726f0a56938b5dfba13f135 2x, https://si.imgix.net/bcffbddb/uploads/origins/618937c7-9e60-4f57-b4be-c5d00ba43b5f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb8e28dd713522e5506ae4c2f11f0005 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1144865, "nc": 51}, {"path": "/@morros_3592/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1144865, "vtt_url": null, "thumbnail_image_urls": {"src": "h