google.com/drive/folders/1xBk-nwdcolIO-MQazfE7Gw5APQXv7PIF?usp=sharing\n\n要望が多くなってしまい申し訳ございません。\nどうぞご検討のほどよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hokenGGyo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2696001, "client_id": 2375377, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9-ff7e5b766c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0681720f5d30742a6d0c5a4fb3f5270f", "srcset": "https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9-ff7e5b766c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0681720f5d30742a6d0c5a4fb3f5270f, https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9-ff7e5b766c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=351f63dd84eb64541bd835d64a428b15 2x, https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9-ff7e5b766c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3283c267390cec7f4ad4569b388f80af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9-ff7e5b766c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b03dd4dc854242b5b446faa2e4fcca", "srcset": "https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9-ff7e5b766c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8b03dd4dc854242b5b446faa2e4fcca, https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9-ff7e5b766c4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce72d65ad144976caa799e92a3b5516d 2x, https://si.imgix.net/cf4dfd9a/uploads/origins/d5ca1491-1d09-48d1-b1c9