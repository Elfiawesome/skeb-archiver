op=top&w=200&h=200&blur=200&s=d2dde295deba32bdd2a9afdb076eb7cf 3x"}, "body": "こんにちは！前回の依頼がキャンセルになったようなので、値上げしました🙏🙏。\n\nエレナちゃんのイラストお願いします\nhttps://i.imgur.com/iT1A6aP.png\n\n左のような普段着でお願いします。\nまた、このような風景、表情でお願いします。\nhttps://skeb.jp/@nanaju_ko/works/16\n\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@terbell/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2834235, "client_id": 196005, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cf7945f2f6a32f494d5c7969fba5709", "srcset": "https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0cf7945f2f6a32f494d5c7969fba5709, https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6594f2e83e2c4c11b56f3144c0d9521 2x, https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f357e1e6784213d96b54d01d8586e05e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e15f5d58d952fc8866d606b6af55accd", "srcset": "https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e15f5d58d952fc8866d606b6af55accd, https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35a2dd72948d024ec0b442d57ffe0bca 2x, https://si.imgix.net/1745797c/uploads/origins/81b6890c-56e7-4c69-b78a-cfc449af1f70?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8dd6a0ac276329f4a563ac60e405f20b 3x"}, "body": "恒々さん初めまして\n私は寝すぎた黒猫といいます\n\n私の推しであるVtuberの朝比奈美夜(@asahinamiya)さんのイラストを是非描いていただけないでしょうか？\n※有償依頼における二次創作の許可はOKをもらっています\n\n【依頼内容】\n壺風呂に入って空を見ている朝比奈さんを描いていただきたいです\n本人曰く、浮き輪に足と手を掛けるように入るらしいので画像みたいな壺風呂に浮き輪の方の画像みたいに手足を掛けて入り、空を眺めている様子を描いて欲しいです\n\n服装は温泉タオルを巻いている状態\n表情はお任せします\n【仕様用途】\n朝比奈美夜さんへのイラストのプレゼント\n私と朝比奈美夜さんのSNSへの投稿\n朝比奈美夜さんの配信活動における使用とFANBOXにおいての画像加工、再配布を許可していただきたいです\n※直接的な商用利用（グッズ化）などは行いません\n※恒々さんのSNSやサイトのお仕事欄などで紹介するのは問題ないと確認しています\n\n【納品形式】\nサインと背景と人物を分けれるようにPSDファイルにて納品をお願いします\n\n【納品サイズ】\nPC壁紙のサイズでお願いします\n\nご検討頂けましたら幸いです\nよろしくお願いします\n\n『参考資料』\n朝比奈美夜Twitter : https://twitter.com/asahinamiya\n髪型、服装などの資料: https://twitter.com/asahinamiya/status/1605870225437577217?s=20\n\n壺風呂：https://tshop.r10s.jp/yakimono/cabinet/yokusou2/mr-1100-s.jpg?fitin=720%3A720\nhttps://tabetainjya.com/img/1705/suisofuro.jpg\n\n浮き輪に乗っている姿の参考資料：https://img.ponparemall.net/imgmgr/17/00122217/main107/qxy304.jpg?ver=1&size=pict650_650\nhttps://www.toysrus.co.jp/i/6/3/3/633250100AML.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@terbell/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2834235, "client_id": 1378799, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c4ad448/uploads/origins/b651f99a-ff4e-47dd-8cef-cd584f719947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd0d8d71a76e806a4cd68670f366d837", "srcset": "https://si.imgix.net/0c4ad448/uploads/origins/b651f99a-ff4e-47dd-8cef-cd584f719947?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd0d8d71a76e806a4cd68670f366d837, https://si.imgix.net/0c4ad448/uploads/orig