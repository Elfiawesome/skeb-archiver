x.net/69203820/uploads/origins/c64038a3-d7cb-447d-8dce-2999e7f2a7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b78acf0ebd46dedbafebb0867c6215, https://si.imgix.net/69203820/uploads/origins/c64038a3-d7cb-447d-8dce-2999e7f2a7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8eac39577dc51a48f416156b07c3c4b8 2x, https://si.imgix.net/69203820/uploads/origins/c64038a3-d7cb-447d-8dce-2999e7f2a7d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95d1c1196d1eca6acc6e42f3427dc5c5 3x"}, "body": "こんにちは、うちの子男の子CPでお世話になってます。\n何度目になりますがまた同じCPでイラストを依頼をしたく。\n描いて欲しいのは以前の依頼と同じくMMOのうちの子アバターのディペルくんユウロくんで、2人が抱きしめあってるシーンをお願いしたいです。\n詳細としては、ユウロくんがディペルくんに飛びつきハグをしてディペルくんが衝撃でややよろめきながら受け止めてハグしてる格好で、表情は飛びついた衝撃で2人とも片目は閉じつつも嬉しそうな笑顔をしてる感じでお願いします。\n外見については、2人共通して白いマロ眉とほっぺの黄色い模様、ディペルくんは帽子とケモ耳の耳当てと肉球の手袋、ユウロくんは帽子と黄色い羽と短パンはそれぞれ描いて頂きたく、それ以外の部分の衣装に関してはエガサキさんの趣味にお任せします。\n例によって2キャラの構図なのでもし金額に不足があれば申し訳なしです。もし検討して頂ける内容であれば幸いです。\n\nhttps://twitter.com/dipel_monio/status/1387385059255087110?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ege_s_ki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1072472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87cda6478ab3ce30e24dff9ae0e182a6", "srcset": "https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87cda6478ab3ce30e24dff9ae0e182a6, https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7503886df35648f4b83604df38fa1570 2x, https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58239ab01429f059afcadb557c85b8e5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c00c97306a17ce4cd1908fff6473eb16", "srcset": "https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c00c97306a17ce4cd1908fff6473eb16, https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7b76684055aeb2388095709ab0177fd 2x, https://si.imgix.net/06a5bb2c/uploads/origins/2f05b4cb-5b9b-49d6-b437-94ebc47d779f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d4877c9b01b810cf68a0b97927ecdf1 3x"}, "body": "こんにちは、2回ほど男の子CPで依頼したものです。\n3回目の依頼になりますが、前回よりもう少しプレイに踏み込んだ内容のシチュエーションを依頼してみたく。\n描いてほしいのは前回までと同様のうちの子CPのディペルくんユウロくんで、内容としてはディペルくん受けユウロくん責めのフェラシーンを希望です。\n構図としては、ディペルくんが仰向けでユウロくんは互い違いぽい向きでフェラする感じで、アングルはディペルくんのちんちんがカメラにアップ気味に寄ってる感じの形でお願いしたいです。\n着衣は2人ともありで細かな衣装はお任せいたします。責めてるユウロくんは切なそうな感じではなく積極的にやってあげてる雰囲気で、ちんちんを半分ぐらい咥えてフェラしてる感じでそれより下の見えてるちんちんや根本の周りはよだれなどで濡れ濡れになってると嬉しいです。\nディペルくんのほうはビクビク気持ちよさそうに感じてる様子だと嬉しいです。\n2キャラ分のつもりで値段設定してますが見合わないと思われたらごめんなさい。もし引き受けてもらえるようであればよろしくお願いできたらうれしいです。\n\nhttps://twitter.com/dipel_monio/status/1387385059255087110?s=20", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ege_s_ki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1072472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5381f37d1fcf38a77c1935ec4a0458", "srcset": "https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc5381f37d1fcf38a77c1935ec4a0458, https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2b549847bb229237702e0bad4d097e9 2x, https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f252b7e59c1889326949b1ee46b7174c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=905ac1c78ca3473718bf8ef35ccdfe2d", "srcset": "https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=905ac1c78ca3473718bf8ef35ccdfe2d, https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b4d4a105dbeb82b625ad9007faa546e 2x, https://si.imgix.net/a89b4845/uploads/origins/0a7e8415-22e0-4a35-83bd-152b854c5221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2a3353b03eadce067ad4f77ff474692 3x"}, "body": "お久しぶりです、以前男の子2人がアイス食べさせようとしてるシーンのイラストを依頼した者です。\n先日Skebのコミッションを納品されたものを見ましてandとても刺さりましたためコミッション募集されてるようであればまたうちの子CPで依頼をしたいなと。\n描いて頂きたいのは前回同様ネトゲーでの自キャラ男の子のCPのディペルくんユウロくんで、シチュエーションとしましては夜のベッドシーンで2人が横向きに向かい合ってお互いの腰に手を回してる格好でお互いのちんちんをスリスリこすり合わせてる感じの兜合わせ？をしてるシーンを希望です。\n衣装は2人ともパジャマ衣装で、ディペルくんは水色でユウロくんはピンク色のパジャマを希望で、下は太もも途中までズボンを2人とも降ろしてる感じの半脱ぎでお願いしたいです。\nディペルくんの方はケモ耳風の耳当て(耳の外側を覆ってる感じで出来たら)と肉球の手袋、ユウロくんは黄色い羽が映りそうな感じであればある感じだと嬉しいです。\n注文が多くなってしまったかもですが、よろしくお願いできると嬉しいです\n\nhttps://twitter.com/dipel_monio/status/1387385059255087110?s=20", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ege_s_ki/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1072472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d2b2c8d4daba187656daefeed05ca73", "srcset": "https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d2b2c8d4daba187656daefeed05ca73, https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92e7b5752ff72082f3bdb072caa4be92 2x, https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=645084a673f1b9a15dbd3524d49a9ec0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec2a64b2d7c7cff8bbe8e5dacc33ce04", "srcset": "https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec2a64b2d7c7cff8bbe8e5dacc33ce04, https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f7b64d611d00f8fbfb9d3aa5721aca0 2x, https://si.imgix.net/46784d4c/uploads/origins/4e880f71-5e56-48f2-9b1c-cf424bbb2c81?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8c030c1c26a479b9e77510bff8b7391 3x"}, "body": "ダンガンロンパ』の藤崎ちひろとセレスティア・ルーデンベルグが描かれたアートワーク。\n\n藤崎ちひろ参考資料\nhttps://static.wikia.nocookie.net/danganronpa/images/f/f7/Danganronpa_1_Character_Design_Profile_Chihiro_Fujisaki.png/revision/latest?cb=20190808204922\n\nセレスティア・ルーデンベルク参考資料\nhttps://static.wikia.nocookie.net/danganronpa/images/5/57/Danganronpa_1_Character_Design_Profile_Celestia_Ludenberg.png/revision/latest?cb=20190808204236\n\n藤崎千尋は女装したキュートな男の子、セレスティア・ルーデンベルクは洗練されたルックスの女の子です。\n\n絵の中では、千尋が座ったり寝たりした状態で、セレスティアが千尋にアナルセックスのおもちゃを使い、セレスティアが千尋の頬にキスしたり、千尋の耳を舐めたりしています。ちひろを快感で圧倒させながら、セレスティアはずるずると、ちひろを自分の思い通りの場所に連れていく。\n\n千尋は従順で、セレスティアは支配的です。\n\n大まかなイメージはフェムドムですが、キツくはありません。その他細かいことは自由にしてください。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ege_s_ki/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1072472, "client_id": 1309040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54871c89/uploads/origins/79cb6286-35f4-488c-90e8-bed706f4af83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0bff6f63bdfce15ccfa4a1b5ca8ca88", "srcset": "https://si.imgix.net/54871c89/uploads/origins/79cb6286-35f4-488c-90e8-bed706f4af83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0bff6f63bdfce15ccfa4a1b5ca8ca88, https://si.imgix.net/54871c89/uploads/origins/79cb6286-35f4-488c-90e8-bed706f4af83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b0873f6a333fff9b225c3b2aa890d2c 2x, https://si.imgix.net/54871c89/uploads/origins/79cb6286-35f4-488c-90e8-bed706f4af83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6611d124e53fb9e69178ba726e3ce82 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnai