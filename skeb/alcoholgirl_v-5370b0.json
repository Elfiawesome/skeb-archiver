WM7vWKtZTbHKpLusyaVCe65WpNUNDwTGHmdSDvqdUGGifVgpg9MU8URno5ZElbXuQTzduQ4DoMPKMsUpFxn9eUfqI43PyLEl5KfiEWTJBrx4OQcroUp3r-dFX0zVwMbhXs33QByd1Mqm3DtkmyJ9IS2GTOmmPzvFcqPzPbgjQ0CVJT7BRBTgreAJiPkcqzZLUBmavkjRlHKYD4S~He48gDscJnjMLGjcejIOvZQdK3txEU9PiJhop60qaQhJr5T9bbnOieM3Oq4Sr9Mdvy8a4COS~nJPaU4aDakKyk4ou6ECvjWyZSggQMDM5a14ITGpo9YUJQhGuk33~~DgT51SMA__&Key-Pair-Id=K1GS3H53SEO647", "duration": 210, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1746140038633840640%2Fy-LnNpco.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3942318fc64cddc71f8ce8e26d0451c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1746140038633840640%2Fy-LnNpco.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3942318fc64cddc71f8ce8e26d0451c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1746140038633840640%2Fy-LnNpco.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12a764c3818e19fd684bcce5ebddcd69 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1746140038633840640%2Fy-LnNpco.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a43689fc94f9a96edd5cc35c6790510 3x"}, "body": "初リクエストです、よろしくお願いします。\nぜひ八噛あいさんに読み上げてほしいと思いながら書いたシチュエーションボイスです。\n解釈、演技、品質、採用、不採用、すべてお任せします。\n\n今夜もお疲れさま。乾杯……(吐息)\n君が勧めてくれたこのお酒、本当に美味しいよね。\n\n気に入っちゃってさ、家でも、たまに飲んでるんだ。\n\n……やだなぁ。もう飲みすぎたりなんてしないよ。一応、大人なんだから。\n\nそれに、これを飲んでるとさ、\n「飲みすぎないで」って君に言われたの、思い出しちゃって。\nすぐに飲んじゃうのも、なんだかもったいないし。\n\n(少し間)\n\n……ねえ、最近。すごく頑張ってるよね。\n無理してるんじゃないかなって、ちょっと心配になるくらい。\n\nあはは。意地張ってもわかるよ。\n付き合いも長いし、ずっと見てるんだから。\n\nそれにさ、前は「ほどほどでいい」って言ってたのに。\n急に張り切り出すなんて、珍しい。\n\n……もしかして、好きな人でもできた？\nん？\nほら、がみねえに言ってみなって。\n\n(少し間)\n\n……え？　ちょっと、なに顔赤くしてるの？　……ほんとに？\n\nあはは……そっかぁ。ずっとそんな素振り見せなかったのに、いつの間に、ね。\n\nでもさ、バカになんてしてないよ。\n一生懸命な人を、バカにするわけないよ。\n\n(少し間)\n\nへぇ……好きな人が頑張ってるのを見て、自分も頑張らなきゃって思ったんだ。\n……素敵だと思う。\n\n(柔らかい苦笑)\n\nほら、少し褒めたくらいで照れないの。もう。\n\nそれでさ、どんな人なの？\n……っていうか、君、私と同じでほとんど友達いないのに、どこで知り合ったの？\n\n……昔からの飲み友達？\n\n……ふーん。そんな人、いたんだ。(少し寂しそうに)\n\n(少し間、はっとして)ねえ、それって、さ……\n(少し笑って)わかったわかった、詮索はしないって\n\nじゃあさ。どんなところが好きなの？\n\n……もう、顔、真っ赤。\n\n子どもじゃないんだから。うるさいなんて言わないで。\n今夜はさ、ゆっくり飲みながら、語り明かそうよ。", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@alcoholgirl_v/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3822884, "client_id": 3845661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69af2d98/uploads/origins/f0bb318b-6214-4a00-822a-feaf053436ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81818e1fa858c49792d370acc77d8a36", "srcset": "https://si.imgix.net/69af2d98/uploads/origins/f0bb318b-6214-4a00-822a-feaf053436ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81818e1fa858c49792d370acc77d8a36, https://si.imgix.net/69af2d98/uploads/origins/f0bb318b-6214-4a00-822a-feaf053436ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b716dd342611519efbec9a53f3f9bd32 2x, https://si.imgix.net/69af2d98/uploads/origins/f0bb318b-6214-4a00-822a-feaf053436ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e7288b67251cb8fd17ea5ca22d44c89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69af2d98/uploads/origins/f0bb318b-6214-4a00-822a-feaf053436ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f932d333c98cbdeeeb8ff299c3a6434", "srcset": "https://si.imgix.net/69af2d98/uploads/origins/f0bb318b-6214-4a00-822a-feaf053436ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f932d333c98cbdeeeb8ff299c3a6434, https://si.imgix.net/69af2d98/uploads/origi