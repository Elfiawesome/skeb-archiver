す。\n\nキャラ：食べる子ちゃんと緑髪子ちゃん\n恰好：家着（パジャマorラフな服装）\n\nシチュエーション\n床に座り、爪切りで自分の足の爪を切っている最中の緑髪子ちゃんと、\nその横で、足をだらしなく伸ばして床に座りながら、柿の種を食べている食べる子ちゃんをお願いします。\n\n緑髪子ちゃんはこちら側（イラスト正面）を向いていて、用紙に対して大きめで描いていただきたいです。\n食べる子ちゃんの足の間には飲みかけのビール缶を置いていてほしいです。\n\nツイッター等で最近食べる子ちゃん緑髪子ちゃんを描かれているのを見ないのでリクエストさせていただきました。\n上記内容でお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dashiotto/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/feab769f/uploads/origins/9c350826-fe31-4b7e-96d3-c29da33ab3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0da5c72d20da1fbb597668d3bf6fade", "srcset": "https://si.imgix.net/feab769f/uploads/origins/9c350826-fe31-4b7e-96d3-c29da33ab3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e0da5c72d20da1fbb597668d3bf6fade, https://si.imgix.net/feab769f/uploads/origins/9c350826-fe31-4b7e-96d3-c29da33ab3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e1db460840950c942a72e42f7f3b03dd 2x, https://si.imgix.net/feab769f/uploads/origins/9c350826-fe31-4b7e-96d3-c29da33ab3a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04cff279189a8a8fdbfe46add4d9cfba 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 665915, "client_id": 1402387, "nc": 176}, {"path": "/@dashiotto/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/74aa6f39/uploads/origins/c669c829-4955-46fe-8d5e-19139d794067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtc