うとしないため、怠け者で自己中心的な性格に見える。\n\nふたりは互いに伴侶を求め、感情的に支え合い、相手と付き合う。仲の良い兄弟のようなものだ。人生に疲れているところも似ており、同じように酒と疲れに身を任せている。無気力を打破しようと、しばしば激しい肉体のぶつかり合いを楽しむ。\n\n各キャラクターを別レイヤーにしたpsdをお願いします。\n好きな衣装を使ってください。普段の美的センスはそのままに、どの衣装を少し変えても構いません。\n好きなシチュエーションで描いてください！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sng_Walhalla/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ec6d4091/uploads/origins/f7756b8b-ba8c-48a1-b1fa-e2c6211fef16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3f01917079862500750d2a45207a896", "srcset": "https://si.imgix.net/ec6d4091/uploads/origins/f7756b8b-ba8c-48a1-b1fa-e2c6211fef16?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3f01917079862500750d2a45207a896, https://si.imgix.net/ec6d4091/uploads/origins/f7756b8b-ba8c-48a1-b1fa-e2c6211fef16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=86b435154f2254d89b472745e2161ba6 2x, https://si.imgix.net/ec6d4091/uploads/origins/f7756b8b-ba8c-48a1-b1fa-e2c6211fef16?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f297be986b79a26dd8e42a20c993bce 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2963208, "nc": 145}, {"path": "/@sng_Walhalla/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2963208, "client_id": 2125365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/decf16f5/uploads/origins/890918f3-4660-45a8-ae89-d5906733aaf9?bg=%23fff&auto=format%2Ccompress&fm=webp