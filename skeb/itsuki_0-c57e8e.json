\n私の絵の等身が馬鹿なせいでアレなのですがあんま身長差はありません。\n他に身体的特徴として、強いて言うなら相変わらず教祖はカリンチョリン、信者くんは綺麗に筋肉ついとります。\n\n教祖ゴテゴテで申し訳ないんですが、ヒツギスタ背景も中々秀逸なんで見せれるところは見せれるようにしてもらって…\n邪魔なら布はとっぱらっちまってください。\n\nhttps://drive.google.com/drive/folders/1adPqvuwIZIOBG5JZVMwLKXg7HNbehHxo", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itsuki_0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2459943, "client_id": 2775570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33c19d02/uploads/origins/4535169b-f3b3-4069-b5ec-02d4e351302a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a499255db567c58ba00cb3409b4d5f7c", "srcset": "https://si.imgix.net/33c19d02/uploads/origins/4535169b-f3b3-4069-b5ec-02d4e351302a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a499255db567c58ba00cb3409b4d5f7c, https://si.imgix.net/33c19d02/uploads/origins/4535169b-f3b3-4069-b5ec-02d4e351302a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c9c32a6efc97fb581d06860ae903677 2x, https://si.imgix.net/33c19d02/uploads/origins/4535169b-f3b3-4069-b5ec-02d4e351302a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27f8331d28232a7af5073eefdab5a451 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33c19d02/uploads/origins/4535169b-f3b3-4069-b5ec-02d4e351302a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11d5aadbe50c282916fb4a6f73e5ccd1", "srcset": "https://si.imgix.net/33c19d02/uploads/origins/4535169b-f3b3-4069-b5ec-02d4e351302a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11d5aadbe50c282916fb4a6f73e5ccd1, https://si.imgix.net/33c19d02/uploads/origins/4535169b-f3b3-4069-b5ec-02d4e351302a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200