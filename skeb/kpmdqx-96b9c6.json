&h=200&s=e7d199580439f7619d60e3483c0c3910", "srcset": "https://si.imgix.net/d43e2cb6/uploads/origins/7a24ca79-2658-4f61-95da-4a48acff3d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e7d199580439f7619d60e3483c0c3910, https://si.imgix.net/d43e2cb6/uploads/origins/7a24ca79-2658-4f61-95da-4a48acff3d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0424369e8dbba4c2a201c0ec6177f360 2x, https://si.imgix.net/d43e2cb6/uploads/origins/7a24ca79-2658-4f61-95da-4a48acff3d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6eb14302c0093c64aae9663425673de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d43e2cb6/uploads/origins/7a24ca79-2658-4f61-95da-4a48acff3d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d031e4c5bc6cf42a83ca0dfb2b6569", "srcset": "https://si.imgix.net/d43e2cb6/uploads/origins/7a24ca79-2658-4f61-95da-4a48acff3d79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2d031e4c5bc6cf42a83ca0dfb2b6569, https://si.imgix.net/d43e2cb6/uploads/origins/7a24ca79-2658-4f61-95da-4a48acff3d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b63491cf02d3f8e84721b43642904a1 2x, https://si.imgix.net/d43e2cb6/uploads/origins/7a24ca79-2658-4f61-95da-4a48acff3d79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df09e61b3a626412f55e7904f9a5ba59 3x"}, "body": "かぱみ 様\n\n突然のメッセージに驚かせてしまい申し訳ございません！\nskeb新着クリエイター欄を眺めていましたところ、かぱみ様が目に留まりX（旧Twitter）を拝見させていただきました！投稿されていたイラストがとても好きで、可能であれば かぱみ先生 にリクエストができたらなと思い、メッセージをお送りさせていただきました！\nお時間あります時に下記をご拝読いただけますと幸いです！\n\n私の好みを詰め込んだ観賞用のOCをお願いしたいです！\n以下に、容姿等のイメージを記載させていただきます！\n①27歳の、爽やかで元気なイメージの青年。髪は明るく濃い茶色で、髪形は毛先が少し跳ねていると嬉しいです！服装はスーツをお願いしたいのですが、第一ボタンが開いているなど、少し活発さが感じられるスタイルだと嬉しいです！\n②構図なのですが、”1枚絵”と言うよりは”立ち絵”のようなものをイメージしています！背景等はシンプルで構わないのですが、可能であれば立ち絵+表情差分（首から上で可）を2つor3つほど描いていただけると嬉しいです！※立ち絵の描写範囲は全身でも膝上でもバストアップでも、立っている状態でも座っている状態でも、かぱみ先生にお任せします！\n③もしも②で表情差分をいただける場合、立ち絵状態は笑顔（人懐っこさを感じ、実年齢よりも少し若く見えるような笑顔）をお願いしたいです！差分は『なにかを考え込んでいるのか、真剣な様子の表情（例：眉を寄せている、口がへの字）』と『赤面（少しオーバーなほどのド照れ顔）』と『落ち込み顔（泣き顔ではなく、落ち込み）』をお願いしたいです！※3つは難しい場合、どれか1つでも構いません！我が儘を言ってしまいスミマセン……！\n\n毎日イラストを投稿されていて、とても尊敬しています！\nそしてかぱみ先生が描かれる男性キャラがとても好きなので、今回こうして自分の趣味を全開にしたリクエストをお送りすることができただけでも嬉しいです！///\nかなり好き勝手に要望を記載してしまいましたので、可能な部分がどこまでかをご勘案いただけますと幸いです！\n\nここまでお読みくださり、ありがとうございました！！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 849711, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "gumiravi", "screen_name": "gumi0gumi", "avatar_url": "https://pbs.twimg.com/profile_images/1764241029950246912/8m8xdF1u.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1277040021636124673/1703005312/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 10, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1933200, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "といとい", "screen_name": "toitoitoi23", "avatar_url": "https://pbs.twimg.com/profile_images/2106274641069453312/9SmAoAlX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1450694813540487169/1791024687/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2557893, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "夏灯", "screen_name": "natunatu056", "avatar_url": "https://pbs.twimg.com/profile_images/1884523