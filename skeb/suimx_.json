a7c13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=136c84f0b7a8e67b00d391059bf895dc, https://si.imgix.net/60e750a2/uploads/origins/41396e08-ab65-419e-b9d1-2f34151a7c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=224e870002a4bfa98df151b6141bd5fc 2x, https://si.imgix.net/60e750a2/uploads/origins/41396e08-ab65-419e-b9d1-2f34151a7c13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8b575e0010f8b875490bca3dc1620f2 3x"}, "body": "初めまして！個人勢VTuberとして活動させていただいております。翠様がご依頼再開されるのを心待ちにしておりました！\n\n〇使用用途\n･アイコンやヘッダー、サムネイル、投稿、動画素材などVTuber活動全般での使用\n･ネットプリントやデジタル品での使用\n･案件やグッズでの使用\n\n〇キャラクター概要\nだめだめすぎて魔界のお城から追い出された小悪魔。お供のこうもりおばけだけが着いてきてくれました。\n\n〇こだわり\n･右(王冠側)の角は欠けてます\n･白まつ毛/赤と白のオッドアイ\n･人間耳× トンガリ耳です。\n･悪魔の角、羽、しっぽ、の赤グラデ。(割とはっきりした赤色)\n･悪魔の羽は比較的小さく、腰辺りから下方面に生えてます。\n\n〇リクエスト内容\n翠様のイラストどれも大好きなので、構図表情全てお任せさせていただきます！！\n\n頭3点(可能であれば上半身)見切りがないと嬉しいです。\n\n〇納品について\n可能であれば人物透過の画像が保存できるように人物･サイン･背景分けたPSDでいただけたらと思います。人物透過が保存できる方法でしたらどの方法でも大丈夫です！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/18jejpBNc8R87lHlxOFEfRJqTO7GhjzCX", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@suimx_/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3327596, "client_id": 3393234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed1a2df2/uploads/origins/1c7ede34-fe39-441b-a22b-a56a60998ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76919100bdabcd56116bfe77767310a6", "srcset": "https://si.imgix.net/ed1a2df2/uploads/origins/1c7ede34-fe39-441b-a22b-a56a60998ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=76919100bdabcd56116bfe77767310a6, https://si.imgix.net/ed1a2df2/uploads/origins/1c7ede34-fe39-441b-a22b-a56a60998ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s