イストで描いていただけるととても嬉しく思います…！\nよろしくお願い致します。\n\n参考資料URL：\nhttps://twitter.com/bnd5k2g/status/1496310992976113666?t=qOXMiKH-VmwklkahK6kXYw&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sousaku_tako/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 850281, "client_id": 1667326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1e70eb7819cc5dd3abcd3005a3a3ad0", "srcset": "https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1e70eb7819cc5dd3abcd3005a3a3ad0, https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51986da37730da6dddfb07f9ff3bc13d 2x, https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=947ca01f09a1d609ce5ba53f0e7cd0d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a81a32fc4486674500f3864be2e95f86", "srcset": "https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a81a32fc4486674500f3864be2e95f86, https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb4d3adfb3d1ad64e8ae6ac945a2a5b 2x, https://si.imgix.net/509a270f/uploads/origins/dbfcc6b5-0352-4874-8c9d-55e9d49d5d47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af46c8745850b2e0d1face3132bc0d57 3x"}, "body": "お世話になっております、ぶんどきです。\nたこさんのイラストがとても好きで、いつも拝見しております…！Skebを開いていらっしゃるとのことで依頼させていただきます…！\n\n私のイギリス人探索者(ガスライト探索者だったものを現代コンバートしました)なのですが、先日別シナリオで従兄弟がロストしてしまい、葬式に行ったんだろうなということをずっと考えていました。そこで、喪服姿で白い百合の花を持っている彼のイラストを描いていただけないでしょうか。従兄弟は正義感の強い刑事で、葬式で泣きはしませんがとても慕っていました。\nよろしくお願い致します。\n\n参考URL\nhttps://twitter.com/bnd5k2g/status/1416246753246945283?t=-8L-E58sA4eUkh4SaTtwGg&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yasssson/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1515282, "client_id": 1667326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b02789bf/uploads/origins/058d5f94-5c63-4000-a706-883e364ea02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5989d33670381de42945aaae37f8a079", "srcset": "https://si.imgix.net/b02789bf/uploads/origins/058d5f94-5c63-4000-a706-883e364ea02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5989d33670381de42945aaae37f8a079, https://si.imgix.net/b02789bf/uploads/origins/058d5f94-5c63-4000-a706-883e364ea02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fcfcd8f9ad087fa7feaed21142d99bf 2x, https://si.imgix.net/b02789bf/uploads/origins/058d5f94-5c63-4000-a706-883e364ea02c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c78e51b0f0383f918842da1a66ed56e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b02789bf/uploads/origins/058d5f94-5c63-4000-a706-883e364ea02c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0dab9aa4a600cd88361b315e2491343", "srcset": "https://si.imgix.net/b02789bf/uploads/origins/058d5f94-5c63