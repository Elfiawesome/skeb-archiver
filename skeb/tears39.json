{"screen_name": "tears39", "first_seen": "2025-09-27T00:58:17.130753", "last_updated": "2025-09-27T00:58:17.130753", "profile": {"id": 1258, "acceptable": false, "creator": true, "avatar_url": "https://pbs.twimg.com/profile_images/1849473651902758912/LD96WIs2.jpg", "name": "空維深夜🍀連載中", "nsfw_acceptable": false, "screen_name": "tears39", "language": "ja", "body_size": 800, "received_works_count": 88, "received_nsfw_works_count": 9, "appeal_receivable": false, "sent_first_works_count": 1, "sent_public_works_count": 1, "instruction": "unspecified", "description": "イラストレーター・漫画家 ✒ ┋『ボクの理想の異世界生活』～転生したらケモミミだらけの異世界でハーレムに 連載中▶ http://onl.tw/VwAaNE5 ┋skeb▶ http://skeb.jp/@tears39┋🔞▶@tears39_r18", "busy": false, "url": "http://onl.tw/VwAaNE5", "show_social_profile": false, "accept_expiration_days": 30, "complete_expiration_days": 120, "received_requests_average_response_time": null, "completing_average_time": null, "nc": 33, "twitter_uid": "189434775", "user_service_link": [], "banned": false, "banned_by": "", "complete_rate": 1, "og_image_url": "https://skeb-avatar.imgix.net/https%3A%2F%2Ffcdn.skeb.jp%2Fassets%2Fv1%2Fcommons%2Fogp.png?auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=fb919ed2f719addcbe44cbdea9c1851a", "skills": [{"genre": "art", "default_amount": 22000}, {"genre": "correction", "default_amount": 8000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tears39/works/89", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1258, "client_id": 80896, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b47917ff/uploads/origins/b7318de6-e2b0-48aa-b130-0d8b814671be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec557e6992e81113e0f664667b961827", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.