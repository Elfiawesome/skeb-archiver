c_set": ""}, "body": "こんにちは！実現可能なお願いをしたいと思います。\n\nあなたは武器や武器のデザインのギャラリーを持っていますね。あなたは武器の詳細なシートをデザインする技術と才能を持っています。\n\n私のOCのために武器の微調整をお願いできないでしょうか？\n\n柚木来楽のメイン武器です。私がデザインしているサイバーパンク設定の巫女魔法少女鬼。\n\nこの武器はSFで、薙刀に変形する杖で、エネルギーブレードがついている。使い手の意思でこの2つのモードを切り替えることができ、柚木に向いている。棒の部分と根元の部分に持ち手があり、彼女にとって使いやすくなっている。\n\nこの武器のシートを作ってほしいのですが、魔法少女の武器にあなたなりのアレンジを加えても構いません。  おそらくシャイドを長くするとか、ポールアームの刃を長くするとか。\n\nしかし、武器の両方のモードを含めてください。  杖としての状態と薙刀としての状態。\n\nhttps://imgchest.com/p/n87wxg9xzyx", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hajikami75/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/752a11de/uploads/origins/32d9baf0-6521-46e0-bcc8-9f5d4b4a7198?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd872195772f3a3b8df1db51fb3370b2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3251604, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hajikami75/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3251604, "client_id": 2120472, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c730d2fa/uploads/origins/c667e1a6-9060-49e1-8317-49118ccb326f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9057142357e2737f9be13e70e62f731f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c730d2fa/uploads/origins/c667e1a6-9060-49e1-8317-49118ccb326f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=984a10f444364323add52aab4af451f9", "src_set": ""}, "bod