size=30&txt=PRIVATE&s=e6e779680d35c1bbc79d318e756105c0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3042841, "client_id": 547310, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kazutomochiduki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3042841, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9673cba2/uploads/origins/81817b1b-6acc-4f7f-a727-72adb8c50b61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=421bd6eae62a9d727af487625007d3b6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9673cba2/uploads/origins/81817b1b-6acc-4f7f-a727-72adb8c50b61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b73aacf8107138e581756a921a1d32ce", "src_set": ""}, "body": "もちづきかずと様こんばんは。\nいつもエッチでかわいいイラストをありがとうございます！\nまたも他所の子のリクエストになってしまうのですが、sakifox 様の描く魔法少女、倉畑詩音ちゃんがサキュバスさんに股間をプニプニされているイラストを描いて頂けないでしょうか。\nおおまかな構図は、もとます様が描かれたこちらのイラストのような感じでお願いします。\nhttps://twitter.com/moto_masu/status/1667958811498516481/\nhttps://twitter.com/moto_masu/status/1667470627245281285\n\n倉畑詩音ちゃんはスカートの下にスパッツを穿いているのですが、スカートは詩音ちゃん自身がたくし上げている感じでお願いします。\nサキュバスさんイラストのように手だけでかまいません。\n股間はスパッツが食い込んでスジがよくわかるように、胸はコスチューム越しに乳首のポッチがわかるようにお願います。\nスジがよくわかるようにと書きましたが、参考として挙げさせてもらったイラストと同程度のスジでお願いします。\nあと、書き文字と台詞もお願いします。\n書き文字は「ツンっ❤（乳首）」「ぷにっ❤（股間）」「ぬちゅ❤」「ぞく❤」「ピクッ❤」「ぐにっ❤」「はっ❤はっ❤」「ぷしっ❤」等参考イラストみたいな感じで、\n台詞は「はっ♥　くっ♥　　クソっ♥　こんなこと♥　やめろっ♥」\n「イクっ♥　もうイッて♥  あ“っ♥　あ“〜〜♥」等、これも参考イラストみたいな感じでお願いします。\n\n差分もお願いできるならば、全裸差分、黒髪、メガネ、赤色のスパッツ、胸のポッチがわかるスポブラ、参考イラストにあるような「ぷしっ❤」っとイってる描写、股から垂れる経血を、\nあとサキュバスさんの手（指）を下にそのまま移動させて、股間と指の間に愛液の糸が引いたようなものもお願いします。\n経血は前回黒子ちゃんで描いて頂いたものより赤色が強いものでお願いします。\n\nシチュエーションは、催眠暗示でスカートを自分でたくし上げさせられているけどその場から動くことができない。という感じだと思います。（どんなだ）\n\n倉畑 詩音：\nhttps://pixiv.net/artworks/74790790\n\n\n以上です。\nどうぞよろしくお願い致します。\n\nhttps://foxiv.2-d.jp/view.php?target=tag&search=%E5%80%89%E7%95%91%E8%A9%A9%E9%9F%B3&sort=date&desc=0&pages=0", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kazutomochiduki/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/47cc906f/uploads/origins/408d714b-92c5-4478-b03f-4ad868bd8914?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbb2c86948df19550c560bbd25b0d39d", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3042841, "client_id": 547310, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kazutomochiduki/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d41cba9d/uploads/origins/1bf29694-4e40-48d2-823e-5949736aee93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=83d45ca89a584fa798e4c67b33d40958", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3042841, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kazutomochiduki/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c9dd9a48/uploads/origins/0f42b866-b62f-42dd-8936-ee7a4d546d75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20