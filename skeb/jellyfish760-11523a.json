やすいほうでお願いいたします。\n《構図》\n背景等はお任せいたします。\n新着で流れてきましたスケブ納品物がとても素敵でした。\n同じような少し上目遣いな雰囲気だととてもうれしいです。\n\n詳細は添付資料とTwitterををご覧くださいませ。\n\nTwitterID @mela_akaru\n\n胸は小さいです。\n\nSNSやファンクラブサイト、配信のサムネイル等に使わせていただきます。\nそのため、特に頭や肩などが切れない構図だと大変ありがたいです…！\n\nPNGデータで人物と背景別で納品いただけますと幸いです。\nPSDデータでもかまいません。\n\nどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-9oFwBC6UeKyMTXxRmirtrwfC_Tevbue", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jellyfish760/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5775cf31/uploads/origins/a4648a25-04f3-4fee-bb43-7c0d1076e333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e47c3c51d354474f690dea03b9d9882", "srcset": "https://si.imgix.net/5775cf31/uploads/origins/a4648a25-04f3-4fee-bb43-7c0d1076e333?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5e47c3c51d354474f690dea03b9d9882, https://si.imgix.net/5775cf31/uploads/origins/a4648a25-04f3-4fee-bb43-7c0d1076e333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d182f1f8e6445e18646e99e34b8d0e5c 2x, https://si.imgix.net/5775cf31/uploads/origins/a4648a25-04f3-4fee-bb43-7c0d1076e333?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ddba8bab23f4e4ff164802e81712a19 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3831991, "nc": 144}, {"path": "/@jellyfish760/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3831991, "client_id": 3646049, "vtt_url": null, "thumbnail_image_urls