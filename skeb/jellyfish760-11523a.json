女のそばには、放射能の影響で変異したマスコットの「Pyp（ピップ）」がいます。\nPypは小さな粘性のある生物で、手足がなく、頭上に光る輪（ハロー）が浮かんでおり、いつもHempieの頭の上や近くにいます。\n\nこのキャラクターは、『serial experiments lain（シリアルエクスペリメンツ・レイン）』や『少女終末旅行』のような作品に影響を受けています。\n静けさ、不安定さ、そして虚無感を感じるトーンで表現していただけると嬉しいです。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1HKpUvqulI6HbCdDdFmdSel-kAK-mqZ6k?usp=drive_link", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1072124, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ポメライオン／いぬいしょう", "screen_name": "chichucai", "avatar_url": "https://pbs.twimg.com/profile_images/1755247811158024192/e45fYoo4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/993474918988726278/1707610575/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 1123356, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "こふ", "screen_name": "kohuu7305", "avatar_url": "https://pbs.twimg.com/profile_images/2030742967200387072/D7Zqadp5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/911692463957360640/1774248074/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 2820333, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "古鍵(ひさかぎ) ￤🎨5月〜ご依頼受付中！", "screen_name": "hisakagi_", "avatar_url": "https://pbs.twimg.com/profile_images/1802286641706643456/vNawyt2-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/14776265488