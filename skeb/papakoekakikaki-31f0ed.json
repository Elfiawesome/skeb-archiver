・2枚目の参考URLを貼っておきます 2枚ともカラー希望です\n\n1枚目：https://gyazo.com/34582520ee28d1e54aeb5f4180324473\n2枚目：https://gyazo.com/e5b2316d5e03b848b7f3d1ef63e7938b", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@papakoekakikaki/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3693631, "client_id": 1989569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41e8ebc1/uploads/origins/bbe557b0-38f6-4873-bf10-736c625af24c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4f51759d18a9a6dd958a19825c85c80", "srcset": "https://si.imgix.net/41e8ebc1/uploads/origins/bbe557b0-38f6-4873-bf10-736c625af24c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4f51759d18a9a6dd958a19825c85c80, https://si.imgix.net/41e8ebc1/uploads/origins/bbe557b0-38f6-4873-bf10-736c625af24c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5247818615580fc496633c7f82ee5625 2x, https://si.imgix.net/41e8ebc1/uploads/origins/bbe557b0-38f6-4873-bf10-736c625af24c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=922fcfcf4fdd7c897c2e4390f56e87d5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41e8ebc1/uploads/origins/bbe557b0-38f6-4873-bf10-736c625af24c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93763c10d225453881ac473bd71a69de", "srcset": "https://si.imgix.net/41e8ebc1/uploads/origins/bbe557b0-38f6-4873-bf10-736c625af24c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=93763c10d225453881ac473bd71a69de, https://si.imgix.net/41e8ebc1/uploads/origins/bbe557b0-38f6-4873-bf10-736c625af24c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6f86b727bf07f89b9f8151231f46d7a 2x, https://si.imgix.net/41e8ebc1/upload