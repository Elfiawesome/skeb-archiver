た。\n\n〇リクエスト内容\n当アバターの立ち絵。\nスプラトゥーンと普通のゲーム配信用。\n・スプラトゥーンは武器にヴァリアブルローラーを持っている。イカタコにするのではなく、時雨さんやものさんみたいな感じ。ロマンさんっぽく楽しんでいる感じで武器を使用しているポーズが良いです。構図も時雨さんやものさんっぽいのをお願いします。\n・ゲーム配信用はコントローラーを持っていてゲームを楽しんでいる感じでお願いします。詳しいポーズはお任せいたします。\n全身でなくて大丈夫です。ですが腰から上があると嬉しいです。\n後述のため透過版があると助かります。\n画像が綺麗に見えるものが良いです。\n\n○利用用途\nSNSへの掲載やアイコンとしての利用\n配信活動(サムネイルや配信画面、配信告知画像等)への利用\nその他個人活動内の範囲を想定しております。\n\n2つなので大変かと思いますが、手数料無料で全部絵師様につぎ込めると聞いたのでぶちこみました。\nお時間かかると思いますが、ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/u/0/folders/1WLVHShT41op8jG3jX-oxJUmZPq4LSypL", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@n010ij/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2845682, "client_id": 425111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c3174779/uploads/origins/620729a4-b9e3-43ac-95c6-ea8a48a3c8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=778414e33859c430a916b14783fe518f", "srcset": "https://si.imgix.net/c3174779/uploads/origins/620729a4-b9e3-43ac-95c6-ea8a48a3c8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=778414e33859c430a916b14783fe518f, https://si.imgix.net/c3174779/uploads/origins/620729a4-b9e3-43ac-95c6-ea8a48a3c8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e80e899e93558a4c7f6a4765f756b1c 2x, https://si.imgix.net/c3174779/uploads/origins/620729a4-b9e3-43ac-95c6-ea8a48a3c8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26a3a17dd6e34b5a791947f19c5265b5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3174779/uploads/origins/620729a4-b9e3-43ac-95c6-ea8a48a3c8c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=297f8c604a182e931809112baf65d988", "srcset": "https://si.imgix.net/c3174779/uploads/origins/620729a4-b9e3-43a