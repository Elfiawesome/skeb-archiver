bp&fit=crop&crop=top&w=200&h=200&s=e00b94a2bda1035e5c22a350181fbe78", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d45d96fd/uploads/origins/cb3ac732-8e6b-450f-b352-37562f8f52eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29eb5ac381434667eb38effe7f365e58", "src_set": ""}, "body": "はじめまして、ヴォルフと申します。\n友人があるごー様のキタサンブラックのイラストを見て是非自分のオリキャラのイラストを描いてほしいと熱望し、自分が代理依頼人という形で依頼させていただきました。\n\n要望\n船坂華奈（オリキャラ）のイラスト\n表情は誘うような表情で、身体に汗を滴らせている\n\n背景\nあるごー様の以前描かれたキタサンブラックのイラストの際のような海の家の陰にいる形\nhttps://www.pixiv.net/artworks/108864428\n\nポーズ\nこちらのツイートに掲載されている記事のグラビア、その2枚目の黄色い水着の際のポーズでお願いします\nhttps://twitter.com/popnrolltv/status/1325273112334594054?t=bXZ-Wrgi26n_anJnwiWraQ&s=19　\n\n衣装\nアクション対魔忍（Android版）の上原燐の水着衣装（腰や背中にある金具系や腕輪、サングラスは無しで水着のみ）\nhttps://twitter.com/ActionTaimanin/status/1541179503245942787?t=xhIwqL9usoSFbAVq_jznpA&s=19\n\n参考情報\n船坂華奈（オリキャラ）\n身長168cm　バスト 98 ウェスト 54 ヒップ 93\n参考立絵\nhttps://twitter.com/RyoutarouDen_o/status/1727307652190065073?t=9paZ6yaItj27f-u8Qp1H5w&s=19\n\n使用用途\n個人観賞用\n\nリクエスト内容は以上となります。\nどうかご検討よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@argonaut130821/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d2cb45e9/uploads/origins/2d77ef18-83d3-4222-82cc-65f40d3e80d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0e7e5505c1ee247791056c5a2a49b4be", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1904114, "client_id": 145129, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@argonaut130821/works/1", "private_thu