でお願いします！よろしくお願いします！\n　値段に問題がある、資料が足りないなどあれば再送をお願いします…！\n\nhttps://drive.google.com/drive/folders/11aq6wrvN8Fcrc2-JGjJeSPgfPTVA_K2T", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hisuzu_one/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2886619, "client_id": 3707116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0625b402/uploads/origins/4a546352-bfb9-4a3a-b3af-f2763914e6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efb3707798f00371b4919cbd92aae9f4", "srcset": "https://si.imgix.net/0625b402/uploads/origins/4a546352-bfb9-4a3a-b3af-f2763914e6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=efb3707798f00371b4919cbd92aae9f4, https://si.imgix.net/0625b402/uploads/origins/4a546352-bfb9-4a3a-b3af-f2763914e6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e99f75f1a3b7b1b8a5d78df7198572eb 2x, https://si.imgix.net/0625b402/uploads/origins/4a546352-bfb9-4a3a-b3af-f2763914e6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abb96556891669a1ec19d02177a1e796 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0625b402/uploads/origins/4a546352-bfb9-4a3a-b3af-f2763914e6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=608e895061e23638a6e7d9706c9fafdb", "srcset": "https://si.imgix.net/0625b402/uploads/origins/4a546352-bfb9-4a3a-b3af-f2763914e6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=608e895061e23638a6e7d9706c9fafdb, https://si.imgix.net/0625b402/uploads/origins/4a546352-bfb9-4a3a-b3af-f2763914e6cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2677e373fc72bf5daf7dd1b1f1e2eabc 2x, https://si.imgix.net/0625b402/uploads/origins/4a546352-b