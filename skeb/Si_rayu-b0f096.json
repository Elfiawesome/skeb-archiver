ress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6edaea84cde1ba12097f468ab0c2818f 2x, https://si.imgix.net/1d1816a3/uploads/origins/5f19394c-6150-4faf-b237-8f3280dfca4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97adb62b177e6d74f7f87d5419639fce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d1816a3/uploads/origins/5f19394c-6150-4faf-b237-8f3280dfca4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d744964cf6e2918e0ca1a8e53540633f", "srcset": "https://si.imgix.net/1d1816a3/uploads/origins/5f19394c-6150-4faf-b237-8f3280dfca4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d744964cf6e2918e0ca1a8e53540633f, https://si.imgix.net/1d1816a3/uploads/origins/5f19394c-6150-4faf-b237-8f3280dfca4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ff2641e9bd2a517ab4742d5ee6d2e23 2x, https://si.imgix.net/1d1816a3/uploads/origins/5f19394c-6150-4faf-b237-8f3280dfca4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07240811c5fa1e12b2a695ff8e8d3432 3x"}, "body": "期限が過ぎておりましたので再リクエストとして送信させていただきます。\nこちらはいつまでもお待ちいたしますが、もしもご都合が悪いようでしたら無理せずキャンセルをお願いいたします。\n\n【以下以前のリクエスト】\n新規リクエスト失礼いたします。\nいつもお世話になっております。出雲モニカです。\n\nこの度は出雲モニカ(通常・バージョン別)のイラストを描いていただきたくリクエストをお送りさせていただきました。\n\n\n構図は以下でお願いいたしたいです。\n・通常の方は元気いっぱいでお願いします。(１)\n・バージョン別の方は冷たい感じでお願いします。(２)\nそれ以外の構図はしらゆ様にお任せ致します。\n\n差分を以下2枚でお願いいたしたいです。\n・(１)は通常通りの出雲モニカをお願いします。\n・(２)は白髪・赤目バージョンの出雲モニカをお願いします。\n上記差分以外の差分箇所はしらゆ様にお任せ致します。\n\n宛先あり・宛先なし・透過をそれぞれお願いいたしたいです。\n\n【追伸】\nバージョン別の子は初めてリクエストいたしますが、出雲モニカの別側面のようなものなので、出雲モニカ似の冷たい子であると認識していただけたら幸いです。お書きしましたこと以外はしらゆ様の自由にお描きいただければと考えております。\n\n\n使用用途に関しまして、クラファン達成記念のリターン配布用・またSNS等に使用いたします。\nそのため申し訳ございませんがプライベート表示とさせて頂きたく存じます。\n\n資料の方は既にお持ちではあると思いますが、念のためこちらに添付させていただきます。\nhttps://drive.google.com/drive/folders/1TrtYZt9Y1lBqHeYCdsvCOkpfoMz_XCBI?usp=drive_link\n\n長文になってしまい誠に申し訳ございませんでした。\nぜひご検討のほどよろしくお願いいたします！！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Si_rayu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1964373, "client_id": 947198, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7cc8b8e9b70ae8253d4f9e04f81f574", "srcset": "https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7cc8b8e9b70ae8253d4f9e04f81f574, https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d443e4c2f8b0d63fcf1616def97085da 2x, https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf364d00be5b06244728142501640622 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49f578b8153e330942aad88f5e2441dd", "srcset": "https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=49f578b8153e330942aad88f5e2441dd, https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6fe2c913f6db1e45c9786510d4c17f4d 2x, https://si.imgix.net/3930946b/uploads/origins/bfd45147-c80f-40ce-8121-111040fa0a02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=