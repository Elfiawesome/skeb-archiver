ate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3601002, "client_id": 3602023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6cac0fa/uploads/origins/343100b6-bd3b-492a-9683-ab2e9296e05f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21721da65b2d2155d4605eac79dc7127", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6cac0fa/uploads/origins/343100b6-bd3b-492a-9683-ab2e9296e05f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=794b3f2d3bc9a8db9d2c4dd923669b04", "src_set": ""}, "body": "こんにちは、リクエストお願いしますm(_ _)m\n\n秋らしい涼しさを感じられる日が出てきました。\n秋といえば、個人的にライブによく行っていた頃の話があるんです…少し聞いてもらえると嬉しいです。\nライブを観に行くため、NHKホールに行くことが数回ありました。\n原宿から代々木公園沿いに歩いて行くのですが、その道は街路樹としてキンモクセイが植えられており、10月に行く時にはとても良い香りを楽しみながら会場に行くことがありました。\n\nその時の気持ちを大切にしたくて、イラストのリクエストをお願いしようと思いました。\nキンモクセイの街路樹を楽しそうに歩く女の子。\nライブに行く時のような、Tシャツにタオルを巻いて。\n秋の心地よい風でキンモクセイの香りに包まれて。\nそんな1枚、よろしくお願います✨", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mechitonyanko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3601002, "client_id": 3602023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a9f2bf5/uploads/origins/dd7e8752-c4e0-4bc9-b774-4b1c4425f805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54b6e7b801626b398b12a05e833fd89b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a9f2bf5/uploads/origins/dd7e8752-c4e0-4bc9-b774-4b1c4425f805?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0854a4a6ec69bc74043090a16e7639e8", "src_set": ""}, "body": "いつもイラストで癒されています✨\nリクエストよろしくお願いします。\nテーマは、\n\n①淡いピンクの花\n②初夏\n③ポニーテールの女の子\n\n①柔らかいピンク色の花が最近好きです。\nチェリーセージのソフトピンク、サンパラソルのパステルピンク、ハイビスカス。\nできたらこれらの花を入れてもらえると嬉しいです。\n\n②①の花は初夏のイメージがあるので、初夏のイメージで描いて欲しいです。\n5,6月くらいの気温が急に上がった日。\nからっとした心地よい暑さ、空の青さ。\nそんなイメージです。\n\n③3/30に投稿されたポニーテールの子が特に好きで、Xもフォローさせてもらいました。\nこの子で描いてもらいたいです。\n\n長々とすみません。\nいつも更新楽しみにしています。\nこれからもよろしくお願いします☺️", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 833873, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "華龍熊猫🐼個人依頼歓迎勢", "screen_name": "KaryuHana", "avatar_url": "https://pbs.twimg.com/profile_images/1944662041832120320/KsinLOXU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1228844655560671232/1751816038/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 16}, {"id": 1904246, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "詠美びゃく夜 ❄ EIMI Byakuya 【公式】", "screen_name": "byakuyaeimi", "avatar_url": "https://pbs.twimg.com/profile_images/1921560536036286464/XTUYg8_6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1274040346448498689/1739484577/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 16}, {"id": 2093951, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "えのきらぼ", "screen_name": "Enoki_udon", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fd7ab72a3-c258-4056-99c0-a98475ce5ed9.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/0d13fe0a-b25c-468f-b663-84065095e545.png", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_reque