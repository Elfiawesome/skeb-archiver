e_genre": false}, {"path": "/@Ithimi13/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9ed20262/uploads/origins/bc147bcd-54dc-46fa-9b03-0e57a31862bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffe56db951a4e57c6b1cdb69eb006285", "srcset": "https://si.imgix.net/9ed20262/uploads/origins/bc147bcd-54dc-46fa-9b03-0e57a31862bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffe56db951a4e57c6b1cdb69eb006285, https://si.imgix.net/9ed20262/uploads/origins/bc147bcd-54dc-46fa-9b03-0e57a31862bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=221e1f819f142cb6099d60924c6321c1 2x, https://si.imgix.net/9ed20262/uploads/origins/bc147bcd-54dc-46fa-9b03-0e57a31862bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1b697e77f243a42c575a15c304adb48 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 152527, "nc": 32}, {"path": "/@Ithimi13/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 152527, "client_id": 1099873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22c232de033503c51170857b550f8888", "srcset": "https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22c232de033503c51170857b550f8888, https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=070d159c3aab468f47b72477eb4f05cf 2x, https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e82ee48e7356dcf8ba0037ecbc5ff74 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c644673ed6904ab83ed04b4406088299", "srcset": "https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c644673ed6904ab83ed04b4406088299, https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1189cfc087efc73e044cf7c4a25e5e16 2x, https://si.imgix.net/4ffa19b6/uploads/origins/d53a49ea-19e1-442c-8fe3-349a348109bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=887fe2b172748025b610c87f6cfaea74 3x"}, "body": "『退行の果てにヒーローとヴィランは愛を歌う』の続編をお願いします。\n無様エロが多めでボス：竜：部下が5：3：2程度の比率の内容だと嬉しいです。\n\n■大まなあらすじ\nヴィラン組織の1つであるボスのドーベルマン、そしてボスの右腕の竜人や部下たちが裏切り者の狼への報復を協議していた\nその最中、ガントと先生の能力でワープされ気絶するメンバー達\nボスと右腕が目覚めた時にはオムツに涎掛け等の赤ちゃん装備にされており、目の前には自身の部下と似た種族の幼児がエッチな遊びをしていた\n\nその中の1人に先生の能力ですっかり周りの子と同じ幼児となった行方不明だった組織のNO.2の象も居た\n今は自身の磁力を操る能力を用いりジャンク品を土台にし磁場を造って空中で浮きながら『ぞうさん踊り』の真っ最中（両手を頭の後ろに組んで脇を晒しガニ股で”ぞうさん”が描かれたおちんちんを恥ずかし気も無くプラプラ揺らす）\n\n先生曰く他の部下たちは全員愛し終わった後で残りは自分達だけとのこと\nヤラれて堪るかと先生に向かって危害を加えようとするもブレイクの怪力で抑えられる2人\nいくら先生の能力と動き難いオムツを穿かされて上手く身体が動かせないとはいえ大人と幼児ほどの体格差がある奴に負けてしまうとはと焦りと憤りを感じる2人\n\nランスとレイジの補助もあり驚異的な速さで肉体と精神が退行する。竜人特有の強靭の筋肉と鋼のように硬かった鱗がプニプニとした柔らかい身体へと変貌\nボスにはイヌ科特有のずば抜けた嗅覚に目を付け臭い攻めを。強制的に先生の腋やチンポを嗅ぎ舐めさせられるボス。更に顔にドンと先生の尻が乗せられ顔面騎乗位をさせられる\nマズルに濃い臭いが充満しもがき苦しむも段々とその臭いが好みになっていき自ら先生の腋やアナル等の恥部を嗅ぎ舐める\n「こんな奴、仲間にするんじゃなかった･･･」と思いながら先生の愛に沈み溺れる\n\n後日、2人も晴れて先生の望んだ姿になり右腕だった竜人は同じスリット持ちのブレイクと意気投合し貝合わせをするほどの仲に。ボスは元部下たちを引き連れて遊ぼうとする。（元部下たちには『忠誠を誓ったボス』ではなく『手のかかる可愛い弟分』の気持ちで接せられる）\n臭いフェチになったボスは先生のその濃い臭いに射精を通り越して嬉ションまでしオムツを汚す始末\n\nそんな元ヒーローとヴィランの愛しい仔を見ながら今日も先生は愛を歌う", "nc": 169, "word_count": 18736, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@Ithimi13/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/51ac3163/uploads/origins/9796f721-9dee-46a9-a830-8de50d99091e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a85117f84201893767ee16fb8025a66a", "srcset": "https://si.imgix.net/51ac3163/uploads/origins/9796f721-9dee-46a9-a830-8de50d99091e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a85117f84201893767ee16fb8025a66a, https://si.imgix.net/51ac3163/uploads/origins/9796f721-9dee-46a9-a830-8de50d99091e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb2c8f7f8fdb1bba2124c95d3ff2655d 2x, https://si.imgix.net/51ac3163/uploads/origins/9796f721-9dee-46a9-a830-8de50d99091e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0c1cf7898ed7d19edd821d77156ede03 3x"}, "private": true, "genre": "novel", "tipped": false, "creator_id": 152527, "nc": 176}, {"path": "/@Ithimi13/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 152527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7da51bd65755ce1bbcb4593385a85d3", "srcset": "https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7da51bd65755ce1bbcb4593385a85d3, https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b57bcd7269566b7e07b7f7fdfc89a3de 2x, https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1412778755520c7db36c1b2a203d7f99 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9add1ac775066274ad896567a4f4e360", "srcset": "https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9add1ac775066274ad896567a4f4e360, https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdcc1fffd2d89c95b3e6be50111fc8bc 2x, https://si.imgix.net/6ef0eb04/uploads/origins/e0849086-3b6d-41c8-abbd-4220b5c4b906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20813b25e5e925e9459f83b0e1ea29f5 3x"}, "body": "[竜人武道家が不良学生を 成否しに行って屈服する話]\n\n1. 竜人武道家が不良学生に敗北、凌辱\n2. 卑怯な方法(X)、正当な決闘(O)、暴力(O)、R-18(O)\n3. キャラクター\n(1) 竜人武道家(年齢:50以上、竜人、黒鱗、黒帯, 180cm)\n(2) 不良学生(高校生、竜人、赤鱗、170cm, ボクシング3ヶ月[趣味])\n3. ストーリー\n(1) 竜人武道家は不良生徒の家族から依頼を受け、訓育のため不良生徒と出会い。\n(2) 鍛えた肉体で機先制圧しようとしたが、逆に不良生徒の脅威に機先制圧される龍仁武道家。\n(3) スパーリングで実力行使をしようとしたが、1ラウンド敗北宣言（ギブアップ）。\n(4) 不良生徒に性的に凌辱される。雌に堕ちる。\n4. 要請事項\n(1) 格闘技経歴、年齢、同じ種族などを言及する凌辱台詞を含む。\n(2) 不良学生の家族は直接登場せず、竜人武道家が秘密で懲罰しようとしたが敗北するイメージ。", "nc": 185, "word_count": 9709, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@Ithimi13/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 152527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9c59752aa19631d09f6ee60eeb8b14e", "srcset": "https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e9c59752aa19631d09f6ee60eeb8b14e, https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab8a5a9e967e817c6481243cd1ff37e0 2x, https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d54ac7af88abd7b645a139585ce557b5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b767b48fa4b2a08becbf639bec13072f", "srcset": "https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b767b48fa4b2a08becbf639bec13072f, https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55d5a2069a401596e5ca09088869e1ad 2x, https://si.imgix.net/6a1a262b/uploads/origins/728a3738-c1a7-4d0f-9279-6ffb67affe26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&c