uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1342352039b3639a3c87a127b92da617", "srcset": "https://si.imgix.net/c82cf2a5/uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1342352039b3639a3c87a127b92da617, https://si.imgix.net/c82cf2a5/uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6467dbc16ba3fef31ac68941f7341ead 2x, https://si.imgix.net/c82cf2a5/uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73e4cb76d3956ee78f75d7a84945ed30 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c82cf2a5/uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=629185cf2fc5c61387b4775f2a412615", "srcset": "https://si.imgix.net/c82cf2a5/uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=629185cf2fc5c61387b4775f2a412615, https://si.imgix.net/c82cf2a5/uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f21e066c9cb23e5882fc4a0f9b08cdd2 2x, https://si.imgix.net/c82cf2a5/uploads/origins/73fd7039-4195-4c41-8ee8-a87354a2bf47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2320d46ebf6d0632f53a7ef7eacddf1 3x"}, "body": "初めましてこんばんは\nこの度skebの募集を始めたと知り、リクエストを送らせていただきたいと思います。\n\n【依頼概要】\n下記URLに添付している黒狼の神〈ヨル〉と片目義眼、片方義足の白犬〈ライブ〉というキャラクターの事後、ベッドの上で横になっているイラストをご依頼させていただきます。\n\n【依頼詳細】\n上記キャラは私が出した同人誌で描いていただいたキャラとなります。\n\n傲慢高慢自己中心で常に人を見下す神である黒狼のヨルと警察的立場である白犬のライブが身体を寄り添ってる構図でお願いしたいと思います。\n\n2人がベッドで寄り添い白犬のライブが目を閉じて眠っているのに対し\n狼神のヨルが不機嫌ながらも抱き寄せてるようにしていただきたいです。\n\n【描いて欲しい要素】\n・ベッドの上で眠っている白犬ライブ\n・不機嫌、無表情ながらも抱きよせる黒狼神ヨル\n・時代背景が中世なので派手すぎない室内\n\n上記の内容が入っていれば他はお任せいたします。\n体格差などはドライブの立ち絵その通りになります。\n服は着崩れていても裸体でもどちらでも大丈夫です。白犬ライブの義眼義足は着脱式なので外れていても大丈夫です\n黒狼神ヨルの光輪は一部黒ずんでいますが僅かに発光しています。この程度は本人の気分で変わるので発光してなくても大丈夫です。\n\n受けが黒狼神ヨル、攻めが白犬ライブです\n\nお手隙であればよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1OpttXvb_U4deJS1yMunV7pTT0xtm7skF", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@taiyakikurumi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 700862, "client_id": 152527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6381cebc/uploads/origins/0af62261-196e-4d5c-975b-80623f7aa5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=354cc29da2969a042fb88b0961ab1115", "srcset": "https://si.imgix.net/6381cebc/uploads/origins/0af62261-196e-4d5c-975b-80623f7aa5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=354cc29da2969a042fb88b0961ab1115, https://si.imgix.net/6381cebc/uploads/origins/0af62261-196e-4d5c-975b-80623f7aa5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4d6fb2e23599fc3688029add06e73a3 2x, https://si.imgix.net/6381cebc/uploads/origins/0af62261-196e-4d5c-975b-80623f7aa5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb68acad1d9fc379b62d0e7364d89149 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6381cebc/uploads/origins/0af62261-196e-4d5c-975b-80623f7aa5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b00aa35f0e792b36c5017e914a942565", "srcset": "https://si.imgix.net/6381cebc/uploads/origins/0af62261-196e-4d5c-975b-80623f7aa5e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b00aa35f0e792b36c5017e914a942565, htt