or_id": 1155803, "nc": 162}, {"path": "/@B0C8JC807Mhgfvw/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1155803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddbf44b8ce3822f8df0100e4fe0cfe1d", "srcset": "https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddbf44b8ce3822f8df0100e4fe0cfe1d, https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a75b1d6ddb75c041383b097a7aaca89c 2x, https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f242c3d3cda6044aeac5ce7ccd21e71 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc20d58a1eb60cac9143e4fb5030445f", "srcset": "https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc20d58a1eb60cac9143e4fb5030445f, https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=25836162b9831de2661c64ac2dc1ad83 2x, https://si.imgix.net/bd309469/uploads/origins/238065a5-c12c-469b-84ee-47dce1f90e32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9a035f9f573a29e902284e0cd3d179c 3x"}, "body": "初めまして。先生の描かれたこの娘（https://twitter.com/mhgfvw/status/1494646961688907777?t=PCvIgoKg-7cqmT6BGCdLGw&s=19）の排泄姿が見てみたいので、漫画形式でリクエストします。\n\nシチュエーションですが、仕事帰りに２週間以上の便秘を解消するべく便秘専門のクリニックへ通院したOL（以下、OLさん）という設定で、\n\n①：OLさんは便秘治療用の小人（大腸の直径より少し小さい程度のサイズ）２人を飲み込み、パンツとスカートを脱いで処置台の上に四つん這いで跨がりながら便意が来るのを待っている。\n※小人を飲み込む様子は、難しいようであればパスして頂いて構いません。また、小人は過酷な大腸の環境に耐えるため防護服を着ています。\n\n②：大腸内に到達した小人２人がカチカチの便秘ウンコをグッと押し出したおかげか、OLさんの腸内もそれに反応して蠕動運動をし始め、「うっ、あっ……来たっ……２週間ぶりの、お通じっ……！」と片手でお腹を押さえながら手応えを感じて息み始める。\n\n③：「これなら、行けるっ……ウンチ、全部出せそう……！！」とOLさんは歯を食い縛り、顔を赤らめながら必死に息む。\nすると、切れ痔になりそうなくらいに限界まで拡張された肛門から、極太便秘ウンコが腸壁をこすって途中で途切れることなくゆっくりとその全容を表していき、最後はボトンと産み落とされる形でフィニッシュ。その後に続く形で、開ききった肛門から小人も出てくる。\n※大腸内の小人が便秘ウンコを押しまくって、少しずつ前進させていってるシーンも同時に描いて頂けると嬉しいです。\n\n以上でお願い致します。大腸・直腸の中の様子はURLのイラストを参考にして頂ければと思います。\n\nhttps://www.pixiv.net/artworks/83390046", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@B0C8JC807Mhgfvw/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1155803, "client_id": 785229, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/737d0be9/uploads/origins/3537e5d5-c616-497e-ac0d-da8816faa5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5c1e39f1411c2c4c1a22e90d43694f4", "srcset": "https://si.imgix.net/737d0be9/uploads/origins/3537e5d5-c616-497e-ac0d-da8816faa5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5c1e39f1411c2c4c1a22e90d43694f4, https://si.imgix.net/737d0be9/uploads/origins/3537e5d5-c616-497e-ac0d-da8816faa5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=896f7a5fdfff2ced26341f559644c970 2x, https://si.imgix.net/737d0be9/uploads/origins/3537e5d5-c616-497e-ac0d-da8816faa5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=02fe1b57e95519e1bc4ee5fbec63d639 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/737d0be9/uploads/origin