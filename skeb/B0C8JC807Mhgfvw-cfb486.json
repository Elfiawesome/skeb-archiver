PRIVATE&s=e69411cd5e3eb13fbcde5cf02e595f41 2x, https://si.imgix.net/facdee5a/uploads/origins/d0fe128c-fb7d-400b-9e92-6a13b16311eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5ba362dcd996730a12e0b9bea83835c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1155803, "nc": 48}, {"path": "/@B0C8JC807Mhgfvw/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1155803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0024a3797c37c28de720a301b22291a", "srcset": "https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0024a3797c37c28de720a301b22291a, https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4933bb25730b4938687d75ef2a68f5df 2x, https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e0f916f70cf414990e30689e43104536 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edf2f79d1dba7d439c16c053c286c3b5", "srcset": "https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edf2f79d1dba7d439c16c053c286c3b5, https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5f0cac054b8b7a0deb5da2dd9681b937 2x, https://si.imgix.net/6e0fb1ec/uploads/origins/14f8b765-e835-4af7-b6b3-2a80c9c5179d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2931e808ed8c6f7b3b0cd6e49d35247 3x"}, "body": "先日は小人を使った便秘治療を受けるOLさんのイラストを描いて下さり、誠にありがとうございました。\nそれでですが、今回は同じ世界観で先日の依頼より重症度の高い患者（便秘3~4週間以上）である、大人しめで優等生な黒髪ロングの女子高生（以下、JKさん。服装はURLを参照）の便秘治療の様子を漫画形式でお願い致します。\n\nシチュエーションですが、\n①：子供の頃から重度の便秘に悩まされてきたJKさんは、防護服の小人２名を口から飲み込み、ペットシートが敷かれた開脚できるタイプの処置台の上に乗り、さらに肛門から小人３名とゴムカバーで保護された特殊なワイヤーを入れられ、その小人が大腸内で便秘ウンコをワイヤーで螺旋状に縛った後、肛門から入った小人が出て来て綱引きの要領でワイヤーを引っ張る態勢を取り始める。大腸内の小人も便秘ウンコを押し出す準備に入り始め、クリニックの主治医から、「治療の準備が整いましたので、心の準備がよろしければ始めて下さい。あなたが息むのと同時に始めます」と告げられる。\n②：「いきます……」とJKさんが呼吸を整えながら言うと、JKさんは獣の唸るような声を上げながら歯を食いしばって懸命に息み始め、それと同時に処置台の小人が肛門から伸びるワイヤーを全力で引っ張り、大腸内の小人も内側からグッと便を押し出す。すると、徐々に黒くてｺﾞﾂｺﾞﾂした柱のような極太便秘ウンコがゆっくりとその全容を現す。\n③：「ウンチ堅すぎっ、おしりも痛い……！！　痛いのになんでっ……こんなに気持ちいいの…………！！」とJKさんは心の中で呟き、肛門からの快感に戸惑いつつも恍惚としている。\n極太便秘ウンコが全体の半分まで出て来た後、「んあああああああ！！！　出るっ、全部出るぅ！！！」とJKさんが全力を振り絞りながら息むと、処置台のペットシートの上に極太便秘ウンコと大腸内の小人が全てドサッと産み落とされてフィニッシュ。\n全てやり切ったJKさんは、しばらくとろんとした表情でぼーっとしている。\n\n以上、よろしくお願い致します。\n\nhttps://images.app.goo.gl/kaAMwdvcf2uVAHEE8", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@B0C8JC807Mhgfvw/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/febf193b/uploads/origins/6766c8d7-7403-4794-b1aa-2e5a82774f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7dc68f83de6731a8925e808e61d9e29", "srcset": "https://si.imgix.net/febf193b/uploads/origins/6766c8d7-7403-4794-b1aa-2e5a82774f3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7dc68f83de6731a8925e808e