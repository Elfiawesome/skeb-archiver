&s=79d2ff1e667d274f67225acb880fae45 2x, https://si.imgix.net/c9ff3477/uploads/origins/371eb117-b121-43a6-8d4b-815fd055206d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=11d3a21a89034f6e6153e545290d4b82 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1155803, "client_id": 1287423, "nc": 51}, {"path": "/@B0C8JC807Mhgfvw/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1155803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b227039c02f1280ffd0f544d52c77599", "srcset": "https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b227039c02f1280ffd0f544d52c77599, https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=436f8cc9df24c310ca4c7cf7b6a3b326 2x, https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca86230a70dba86f818d85844174579a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a73c8a735884cb7646769d0bd276bb67", "srcset": "https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a73c8a735884cb7646769d0bd276bb67, https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=693d56e15a3ed85b03a0272398016de0 2x, https://si.imgix.net/61cdff32/uploads/origins/34aa2937-d53a-4f80-b98c-d90728e558e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21e70d75249efc46756ec51537fc8d64 3x"}, "body": "初めてリクエストさせて頂きます。\n\n便意を我慢して帰宅してきたJKが、トイレ（洋式）に駆け込みうんちをするシチュを漫画形式でお願いします。\n\n①（もうっ…限界っ…！）帰宅したJKが切羽詰まった表情でトイレに駆け込む。\n\n②スカートをまくり上げ、パンツを膝関節まで下し、脚は内股気味で便器に腰掛ける。\n\n③腰掛けるや否や、おならが漏れ、そして安堵の表情を浮かべながら、バナナ状のうんちをニュルニュルと排泄する。（間に合ったぁ…。）\n\n④（昨日食べ過ぎたからいっぱい出そう…。）再びおならが漏れ、さらに気持ちよさそうな表情で大量の軟らかいうんちを排泄する。（我慢してたから凄く気持ちいい…。）\n\n⑤すっきりした表情でトイレから出ると、双子の姉がトイレ待ちのついでにドア越しに聞き耳を立てていたようで、\n姉「いっぱい出たね！」　JK「えっ…何の事？」と赤面しつつもしらを切ろうとする。\n\n④姉も大量のウンチを排泄する。（ここの描写は可能であればお願いします。） \n\n・便器内視点や便器を透過させるなどうんちが見えるようにお願いします。\n・可能であれば、家のトイレっぽく、便座カバーやトイレマットなどの描写があるとありがたいです。\n\n・JKと姉の容姿は、黒髪ロングで制服（ブラウス、リボン、スカート、黒ニーソックス）でそれ以外はお任せします。\n\n細かな指定が多くなってしまい申し訳ありませんが、ご検討のほどよろしくお願いします。", "nc": 34, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@B0C8JC807Mhgfvw/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1155803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf6bdc4645c262b8c64566add827210", "srcset": "https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7cf6bdc4645c262b8c64566add827210, https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a58891d16da32a2063e375a93b780cfe 2x, https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dad4598baab9b1d3d49c06744203c1b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41340393ed231a934dd276ad46453530", "srcset": "https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41340393ed231a934dd276ad46453530, https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3daa3c9d65d166f4e02dd81951ce94eb 2x, https://si.imgix.net/db08872c/uploads/origins/5d4f7e52-e14c-4ca8-affb-b20f2e879f47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7693a68bfe4da9938c0eaac7224893de 3x"}, "body": "いつもお世話になっております!またリクエストさせていただきます！\n休み時間に便意を我慢していたJKが、和式トイレでうんちをして、友達にバレるシチュを漫画形式でお願いします。\n\n①（どうしよう、、、お腹痛くなってきちゃった、、、そういえば今朝はご飯の後トイレに行ってなかったっけ、、、でも学校のトイレでなんて、恥ずかしくてできないよ…）便意を催すが恥ずかしさから我慢して学校生活を過ごす。\n➁（友達の前だと恥ずかしくて、できないよ…）友人にトイレに誘われ一緒に行くが、便意をこらえつつおしっこをする\n\n③（どうしよう…もう…限界…かも…）和式でしゃがんだ体制になったため、便意が強まりおならが漏れだす。\n\n④（もう…限界…恥ずかしいけど…仕方ないよ…ね？）葛藤の末、健康的なバナナ状のうんちを排泄する\n➄（本当に学校のトイレでうんちしちゃった…でもまだ出そう…）お腹が鳴り、気持ちよさそうな表情でさらにうんちを排泄する。\n\n⑥(こんなにいっぱいしちゃった…うんちしてたの絶対バレてるよね…）うんちを排泄し終わり、出した量を見て恥ずかしくなる\n⑦(やっぱり全部聞こえてた！恥ずかしい…)トイレから出ると、友達にお腹は大丈夫か聞かれおならの音や息み声も聞こえていた事を伝えられ再び赤面する\n\n・便器内視点や便器を透過させるなど表情とうんちが見えるようにお願いします\n\nJKの容姿は黒髪ポニーテールで制服でお願いいたします。友達の容姿はおまかせします。\n　\n細かい設定で恐縮ですが、よろしくお願いいたします!", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@B0C8JC807Mhgfvw/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b78a8fd5/uploads/origins/4af995a3-610c-48ee-8d15-ee9cdaa8f4ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=