 "received_works": [{"path": "/@hide_pau/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1438931, "client_id": 3170313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd166fd42b0f7d4048a5f00b9e0f47b0", "srcset": "https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd166fd42b0f7d4048a5f00b9e0f47b0, https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9531849d4048a385cb5da99f8dc429b2 2x, https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a533a622252668cf8d3dd2cf2215ce02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae3e2c2e867f5cda5a5425c9eed9aa59", "srcset": "https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae3e2c2e867f5cda5a5425c9eed9aa59, https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67795eb8613b1d6ad86f3568c88525a9 2x, https://si.imgix.net/a6859937/uploads/origins/f2e9a098-a11e-4d00-be38-19917c1fee23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7207e96e04e3480cacc91fcd7e0902a6 3x"}, "body": "秀様\nパヤ神を保護したときに偶然TwitterのTLでみてから、すっかり一家の大ファンになりました。\nこの度ぜひ我が家の3匹を描いてほしく、依頼させて頂きました。\n依頼自体初めてなので、不備などあるかもしれません…よろしければ描いて頂ければ幸いです。\n\n■利用目的\nあくまで自分鑑賞用\nケータイの待受とアイコン\nアクリルキーホルダーも作ってみたい\n\n■サイズ\n正方形に近い形\n解像度などは詳しくないのでお任せ\n背景は透過だとありがたいです\n\n■描いてほしいもの\n秀様の絵柄が好きすぎるので、それでお願い致します。擬人化のやつみてみたいです。\n\n①白黒のハチワレ 推定7歳 雌\n1番年上ですが、メスなので1番小柄\n3匹の中では1番賢くて甘え上手、あととてもお喋り\n空きあらばお腹に乗り、毎日腕枕で寝るような甘えん坊さん\n初めて会う人も膝乗ります\n人間が好きすぎるがゆえに他猫をちょっとライバル視してます\n\n②白多めのサバトラ? 推定5歳 雄\n1番我慢強くて優しい\n赤ちゃんの寝かせつけが得意技\nかなりの食いしん坊でふとっちょ\n座ったときに両サイドの模様がハートみたいになるのがチャームポイント\n\n③シルバーダビーにちょっとブラウンダビーが入ってるメインクーン 来月で1歳 雄\n末っ子ながらメインクーンなので体は1番大きい\nよく食べるよく寝るトイレは下手くそ\nいつも隣にいるので人間は嫌いではないですが、抱っこはたぶん嫌いです…\n性格は基本的に温厚ですが、体格がいいので戦闘力自体は高め。\n長毛のふさふさ襟巻と尻尾が美しい。\n\nいくつか写真を載せてみました、かなり雑で大変恐縮です…\n\n依頼は以上となります。\n急ぎではございませんので、秀様のご都合がいいときにご対応頂ければ幸いです。\n\n追伸 たまにはエオルゼアのことも思い出してあげてくださいw\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1zmcwSxOHJzsLaB417Gdamo_jvO_NElGy", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hide_pau/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1438931, "client_id": 577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e302afd06ce2a9e1e3fd54b783596803", "srcset": "https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e302afd06ce2a9e1e3fd54b783596803, https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b9abd24f8c06d8a5a2fa87f068befec 2x, https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47ec04c21537be6ceb4e0111be14fb14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3563707e873eddc86c5d55114e1b2a4", "srcset": "https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a3563707e873eddc86c5d55114e1b2a4, https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffbbc1554b44359998b371fb1ee39cb0 2x, https://si.imgix.net/571f6a2b/uploads/origins/f5d753ce-66d5-4470-b123-fb765f82bf2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a10401e6554241558b9bae150b63753 3x"}, "body": "うおおおお！！！！！秀さんがSkeb開設してる！！！！！！！！\nうちの猫さまをお願いしたいです！！！！\n\nきなこさん：うちの姫・口元のほくろがチャームポイント\nだいふくさん：うちの姫騎士・いつも険しい顔してる・鼻がダイヤの模様になっているのがチャームポイント\n\n力関係的にきなこさん＞＞＞＞だいふくさんで\nいつもきなこさんがだいふくさんを枕にして日向ぼっこしているので\nそういうような感じのイラストがいただければ嬉しいです！\nアクリルスタンドなどにしたいので、全身入っていると助かります。\nご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1_mg0uiCblLv4SijlzUc29KROQwUVq5C3?usp=sharing\n\nhttps://drive.google.com/drive/folders/1_mg0uiCblLv4SijlzUc29KROQwUVq5C3?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hide_pau/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1438931, "client_id": 2875021, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47bdaa93b1143e00983986d4734a7dc6", "srcset": "https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47bdaa93b1143e00983986d4734a7dc6, https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=559689fe461d76d70e1cf355e61410fb 2x, https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a1684774789291051ec4b3e1bc68c8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d498ba04f31a26125a2ea6429615398", "srcset": "https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d498ba04f31a26125a2ea6429615398, https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=499956b65263f696bebbdb3e82b41419 2x, https://si.imgix.net/1ff46762/uploads/origins/2cb1c725-8184-4003-b60e-6b7c6f71f4a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c61484cb67e29489adb17749fe8b1b20 3x"}, "body": "秀さま\n\nいつも作品を楽しく拝見しております。\nこの度は、個人観賞用グッズイラスト制作のお伺いでございます。\nグッズとしてパスケースか財布に印刷して利用したいのですが、難しければリクエストを拒否してください。\nグッズの利用目的は個人が日常の中で使用するのみで、多数に配ったり広告的に使用したりすることはありません。\nアイコン等も規約に則ればできるそうですが、する予定はありません。\n下記、イラスト詳細です。\n\n描いてほしいもの…ぬいぐるみの猫3匹を秀さんの絵柄で。\n\nサイズ…特に希望なし\n（極端に縦長や横長などよりは、1:1に近いアスペクト比だと嬉しいです）\n\n解像度…印刷に耐えられるものだと助かります（大きくても100✕100mmくらいのイメージです）\n\nモチーフの猫…黒猫2匹（大・小）、茶トラ1匹（小）\nいずれも赤い首輪。\n\nお恥ずかしながら、ぬいぐるみですが正格のイメージがあり、参考までにお伝えします。\n・黒猫（小）…元気ハツラツな最年長猫のイメージで描いていただけたら嬉しいです。\n・黒猫（大）…おしとやかな真ん中っ子猫のイメージで描いていただけたら嬉しいです。\n・茶トラ（小）…お転婆な末っ子猫のイメージ。秀さん家の猫ちゃんだとスイちゃんのイメージです。\n経年劣化でどのぬいぐるみも毛がペタッとして細くなってきてます。\n茶トラはトラが薄くなってきているので、絵に反映していただけたらとても嬉しいです。\n\nぬいぐるみの詳細仕様などは資料がないのですが、「サンレモン　ひざねこ（M・S）」で検索すると同様画像が出てくるかと思われます。\n資料としてURLに写真を載せております。\n大体のイメージですので、全てに目を通していただかなくて構いません。\nよろしければご査収ください。\n\nhttps://drive.google.com/drive/folders/1hxaJfVz800v8tuTuUWO3o0kF0pqc6jDa\n\n形式…透過だと嬉しいです\n他おまかせ\n\n以上になります。\nお忙しいとは存じますが、よろしくお願いいたします。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1hxaJfVz800v8tuTuUWO3o0kF0pqc6jDa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 718769, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦊みんとみあ", "screen_name": "Mia_Mint0", "avatar_url": "https://pbs.twimg.com/profile_images/1696492898672582656/HOC-WPgq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2764319137/1708937188/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 1156322, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ヘルプマン", "screen_name": "helpen_hhh", "avatar_url": "https://pbs.twimg.com/profile_images/1709960853137879040/OnXwAjNe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1328729254209540096/1771903800/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1342699, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "シェルディー", "screen_name": "Shelldy_h", "avatar_url": "https://pbs.twimg.com/profile_images/1875910146079305728/dazTbrJ3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1386487532/1626779266/1500x500", "appeal_receivable"