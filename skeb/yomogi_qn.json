auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d67e32dfbfe8cef1cfc4b0695f8bc8b 2x, https://si.imgix.net/937c2226/uploads/origins/c4e61904-0e1f-4892-a254-ce231d01f06c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6a366742cfa5fe269a936b55ca968b9a 3x"}, "body": "こんにちは！再リクエストしていいですか？デスクトップの背景に使えるように、16:9のアスペクト比のアートワークでキャラクターをお願いしたいです！\n大きな耳と大きな煙のような尻尾が特徴の猫の男の子です。しっぽはお線香の煙のように大きくしていただいて構いません！\nあなたの絵の美しく妖しい感じがとても好きです。教会にいるキャラクターをお願いしたいです。ステンドグラスや窓から差し込む光、壊れた天井、建物に生い茂る植物などを入れていただければ完璧です。私のキャラクターは再生がテーマなので、教会の祭壇に座っていたり、棺桶に入っていたりしてもいいかもしれません。好きなように構成してください！とても広く、雰囲気のある空間にしたいです。ご考慮いただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1nDuEn_XZuy4kJ9tAbIopg2c7TveUcI5j?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yomogi_qn/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240628, "client_id": 2618788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d58b335159a4ee8870a9e393175be24", "srcset": "https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d58b335159a4ee8870a9e393175be24, https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f50eea2e525150d212ed03d4f6613e9 2x, https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abba8ed4bea3fdf37257c14cd1fca174 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea6e7e841882380339ed8f4a0c66b0fa", "srcset": "https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea6e7e841882380339ed8f4a0c66b0fa, https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8dfe046dda5d28bf634bfd814b19051 2x, https://si.imgix.net/06e7c62e/uploads/origins/6f4ee69d-326b-40dc-b483-c916d5d433dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e10d86faf3c090ad1d62d89e595622a 3x"}, "body": "こんにちは！skebのリクエストを受け付けてくださって、本当にありがとうございます！本当にありがとうございます！  もしよろしければ、私のオリジナルキャラクターの背景をお願いしたいです！\n\n夢見るラヴレースは、落ち着いていて、大人で、自信に満ちていて、エレガントな第一印象を与えますが、実はいじわるで浮気者です。また、とても母性的で、人の世話をするのが大好きで、特に親しい友人や仕事のクライアントの世話をしています。\n\n夢見がち：\nhttps://www.deviantart.com/stash/07upeb3hxdc\nあなたの作品に描かれる彼女のデザインは、細部までこだわってはいけません！シンプルでいいんです！\n\nあなたの作風で背景を描いてほしいです。ドリーミングのイメージは、夜明けの時間、ピンク、紫（オリジナルカラーでも可）、夜、古いヴィンテージの屋敷や庭、ランタン、不気味な森、怖い童話などですが、他にもアイディアがあれば自由に楽しんでください！\n\n私のリクエストを考慮していただき、本当にありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yomogi_qn/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3240628, "client_id": 2428998, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71409b93/uploads/origins/8e596662-a8a9-4699-9c67-046efe4486ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47ebb6783b836b7bbb4ecb02f1e8a66b", "srcset": "https://si.imgix.net/71409b93/uploads/origins/8e596662-a8a9-4699-9c67-046efe4486ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47ebb6783b836b7bbb4ecb02f1e8a66b, https://si.imgix.net/71409b93/