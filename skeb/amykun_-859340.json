します。\n\nランジュ⇨ミアの水着を素敵と褒めるも他の人に見られたくない気持ちが少し出て(無自覚)パーカーで隠そうとしてる\n\nミア⇨ランジュに褒められて悪い気はしないけどランジュの水着姿と相変わらずの距離感に照れてしまう。一方で自分の水着姿を褒めるのになぜ隠そうとするのかちょっと不満\n\nみたいな感じなのでどうでしょうか…？\nイメージなのとミアちゃんの着てるパーカーはランジュ持参だとランミア好きとして嬉しいな？と思ったものですので解釈違いでしたらすみません…ご検討のほどよろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amykun_/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/055df3bb/uploads/origins/845b5920-5132-44d5-a409-eb5bb5a1c233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2960a8565cfffb71fc9c6de022ca32c3", "srcset": "https://si.imgix.net/055df3bb/uploads/origins/845b5920-5132-44d5-a409-eb5bb5a1c233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2960a8565cfffb71fc9c6de022ca32c3, https://si.imgix.net/055df3bb/uploads/origins/845b5920-5132-44d5-a409-eb5bb5a1c233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=79af089643f149bb61b8c27a24f3ad31 2x, https://si.imgix.net/055df3bb/uploads/origins/845b5920-5132-44d5-a409-eb5bb5a1c233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5a48b77982964451aaba9141efb0cea8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1185898, "nc": 144}, {"path": "/@amykun_/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c59e6437/uploads/origins/29fe9125-633f-4923-8c41-8dc64bda40fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bf2981647cf5c