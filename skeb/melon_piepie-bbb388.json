67-f53ccf73c738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a74250c2a9f63a48e0dd1a8a327a063", "srcset": "https://si.imgix.net/331d4c92/uploads/origins/b5d81a12-e396-4ee9-aa67-f53ccf73c738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a74250c2a9f63a48e0dd1a8a327a063, https://si.imgix.net/331d4c92/uploads/origins/b5d81a12-e396-4ee9-aa67-f53ccf73c738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86b8e1ec01cda5fac5868cc53b531d41 2x, https://si.imgix.net/331d4c92/uploads/origins/b5d81a12-e396-4ee9-aa67-f53ccf73c738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=383c18c7c7ea9c02d2a70505e2cd6ad5 3x"}, "body": "こんにちは先生、また食糞の作品を依頼したい。\n\nキャラ:　【アズールレーン】のカウペンス & 樫野\nキャラ参考:https://www.imagebam.com/view/GAHS6T\n\n「聖女の楽園」という作品がとても気に入ったので、似たような作風のものを希望します。巨乳がメインなので、可能であれば、どのポーズでも胸が完全に見えるようにしてください。\n\n【シチュ】\n樫野とカウペンズはいつもの「巨乳維持運動」を始めようとしていた。服を脱いで挨拶すると、集まった10人の男達が部屋に入ってきた。変態カウガール達は、男達の排泄物を餌にするため、見知らぬ男達に金を払い、口の中に排泄させた。\n\n女の子たちはベッドに座り、牛柄ビキニを脱ぎながら胸を愛撫する。「今回は10人だけ…でもホームレス達もいるから、下痢してたら美味しいよ♡♡」と笑顔で言う。樫野はお腹をさすり、カウペンズは脚を開いてまんこを見せる。「遠慮しないで。その気持ち悪いうんちに見合うだけの報酬をあげるから、来て！」\n\n最初の男性については、カウペンスは男性にパイルドライバーのポーズを取らせ、ペニスを彼女の顔から離して肛門を露出させ、みんなに見せるようにしています。彼女は長い舌を彼の肛門の奥深くまで入れ、どろっとした茶色のうんちが出てくるまで掻き出します。うんちが口と頬を満たすと、彼女はそれをすべて受け止め、舌でうんちが出てくるのを助け、舐めます。そして、嬉しそうに全部噛んで飲み込み、その後、汚れた舌を見せます。彼女は同じポーズの2人目の男性のうんちを食べます。彼女は彼の肛門からクリーミーな黄色のうんちを強く吸い取り、食べる前に口いっぱいに含ませます。うんちがお腹の中に落ちるときの、彼女の胃の内部の小さな詳細図も追加してください。\n\nポーズ:  https://www.imagebam.com/view/GACKNQ\n\n樫野はベッドのヘッドボードに背をもたせかけ、足を広げて自慰行為をしている。最初の男が彼女の顔の前に肛門を突き出し、彼女は肛門を強く吸い、少し引き出す。糞が出始めると、彼女は顔を少し離し、緑色の細くて硬い糞が口の中に流れ込むのが見える。糞は彼女の頬と喉を満たし、彼女はそれを噛み、飲み込み、汚れた舌を出して悪臭を吐き出す。2人目の男が来て、同じ姿勢で吸われるが、黄色い下痢が出て、彼女はそれを射精しながら直接飲む。彼女は最後の一口を飲み干し、口をみんなに見せつける。毎回、糞が彼女の胃に落ちる様子をもう一度見せてください。\nポーズ参考：https://www.imagebam.com/view/GAEWAU\n\n喉: https://www.imagebam.com/view/GAF448\n吸込み: https://www.imagebam.com/view/GAGQ3E\n\n最後の男性達に対して、少女たちは床に座り、ためらうことなく口をトイレとして使うように頼みます。カウペンスは食事をしながら手をつないだり指を絡ませたりするのが好きですが、樫野は自慰を続け、男性のお腹を押して早く排便させます。（1つのフレームで構図が難しすぎる場合は、同じポーズの少女を別のシーンに分けてください。）最初の2人の男性は、カウペンスには喉をいっぱいにして口から突き出た長い茶色のトウモロコシの粒の糞を、樫野にはクリーム色の柔らかい茶色の糞を排便します。カウペンスは舌を使って先端を口の中に入れ、噛んで飲み込みますが、樫野はそれをすべて直接食べて唇を舐めます。2番目のペアは、カウペンスには不健康な緑色の下痢を、樫野には濃い薄茶色の糞を排便し、緑色の先端が口から見えています。カウペンスは飲む前に口いっぱいに食べ物を詰め込み、中に小さな塊が浮いているのを見せます。一方、カシノは楽しそうに噛んで食べ、少しげっぷをします。最後の2人は、カウペンスの鼻孔から溢れそうなほどドロドロとしたクリーム色の緑色のうんちと、樫野には血の混じった部分と未消化の食べ物の破片が混じった茶色のうんちをします。2人とも噛んで飲み込み、汚れた舌を出してうんちの悪臭を生き出します。ポーズで顔が隠れているので、それぞれのうんちを受け取ったときの顔の小さな横からのディテールを含めてください。\n参考:https://www.imagebam.com/view/GAG7U1\n\n最後のシーンでは、2人の裸の女性がソファに座り、大量の糞便を食べてオーガズムに達した後、断面図で胃の中が糞便で満たされている様子が映し出され、彼女たちは微笑んでいる。セリフはおまかせ。\n\n最後のシーン\nhttps://www.imagebam.com/view/ME1A3HJE\n断面図\nhttps://www.imagebam.com/view/GAD4EL", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@melon_piepie/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2856264, "client_id": 2151555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7100ad468bfe06093652994a94c880bd", "srcset": "https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7100ad468bfe06093652994a94c880bd, https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd8ec252ad808d5cfcd449e4856865dd 2x, https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec9c1624dac044faf228e032eb190ea1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c535a484d5ad3a66884c88b6a0c1f7", "srcset": "https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c535a484d5ad3a66884c88b6a0c1f7, https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9a73387e70b40d3bdcca1cc82abf312 2x, https://si.imgix.net/2329d58d/uploads/origins/8780ef26-0b05-4d2d-87af-f63bae4c9731?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27ac4e218d5e92866c50322b142ae859 3x"}, "body": "こんにちは先生、また食糞の作品を依頼したい。\n\nキャラ:　一弘先生の【家族旅行はヤリモクビーチでセックス三昧】の美香さん\nキャラ参考:\nhttps://www.imagebam.com/view/GACAPV\n\n【シチュ】\n美香はイケメンとセックスするのが好きな巨乳ビッチギャル。セックスの後、彼女はその夜、さらにハードコアなセックスをするために借りた小屋に彼らを招待します。この作品の魅力は、若くて美しいギャルが、大好きなスカトロプレイを恐れずに楽しんでいるところです。彼女は、見知らぬ人達の糞を食べることを恐れず、それをしながら楽しい時間を過ごしています。それぞれのポーズやシーンで彼女の全裸体を強調してください。他作家さんのキャラの使用がNGの場合は、同じ設定で美香をアズールレーンのブレマートンに置き換えてください。\nhttps://azurlane.netojuu.com/images/e/eb/BremertonCasual.png\n\n最初の画像: 到着した 4人目の男の視点から、ドアを開けると、美香が他の 3人の男とセックスしているのが見えます。彼女はベッドの上でダブルで挿入され、視聴者に挨拶して、嬉しそうに「遅いわね! そこの下剤を飲んで待ってて。この男たちと終わったら、あなたの糞を食べるわ ♡」と言います。男たちは彼女の中で射精し、彼女は男たちのお尻をしっかりと掴みながらペニスをしゃぶり、男たちは全員彼女の中でおしっこをします。\n最初のシーンの参考：\nhttps://www.imagebam.com/view/GACIT6\nhttps://www.imagebam.com/view/MEVIL1O\n\n彼女は片足を伸ばし、もう片方の足を横に置いてベッドの上に座ります。彼女がオナニーをしながら、男たちに一人ずつ彼女の口の中に排便するように促すと、彼女の穴から精液とおしっこが漏れ出します。 セリフはお任せします。彼女は正面から口の中に直接ウンコを受け、横から見ると、消化されていない食べ物のかけらが詰まった固い茶色のウンコが喉まで口の中に詰まっている（どちらの視点でも、糞便が肛門から出て彼女の口に入っていくのが見えます。）。うんちは喉が膨らんで先端が口から飛び出るほど大きいのですが、彼女は喜んでそれを全部受け入れます。彼女は噛んで飲み込み、次の男を呼ぶ。\nポーズ、視点、受け取り、飲み込みの参考：\nhttps://www.imagebam.com/view/GACI2U\n\n2人目の男は彼女の真上から下痢便をし、彼女は緑色の液状のウンコを受け取って、口いっぱいになるまでそのまま流し込む(彼女の全身が見えており、男の肛門と美香の口の間に隙間があります)。彼女は口を閉じずにそれを飲み干し、上から見ると(上から見た詳細図では、口の中に下痢が詰まった彼女の顔が写っています。以前のうんちの汚れはオプションです。)、口の中がきれいになるまでゆっくりとレベルが下がっていくのがわかる。彼女は唇をなめてもっと欲しいと頼む。\nポーズ参考：\nhttps://www.imagebam.com/view/MEW0W96\nhttps://www.imagebam.com/view/MEW0X7O\n口を開けて下痢を飲み込む：\nhttps://www.imagebam.com/view/GACIU8\n\n3人目の男は彼女の舌の上に柔らかいクリーム状のウンコを排便し、彼女は2口分受け取って噛まずに食べ、ウンコは口の中で溶ける。美香は彼の足をしっかりと抱きながら、胸をマッサージしながら後ろから激しく彼の肛門を舐めます。彼女は食べた後にゲップをし、いたずらっぽい笑顔で最後の男を見る。\n参考:\nhttps://www.imagebam.com/view/GACIUM\n\n最後に、彼女は最後の男に突進し、マングリ返しのポーズで口に含みますが、胸は見えています。彼女は彼の肛門を激しく吸い、舌をくねらせ、彼が茶色、黄色、緑の硬いウンチを吐き出すまで、それを嬉しそうに噛みます。彼女はそれを全部飲み込み、舌と口を見せて「ごちそうさまでした♡」と言います。\n参考:\nhttps://www.imagebam.com/view/GACKNQ\n\n最後の画像は、ベッドの上で裸の彼女が上から「トイレになるのは普通のセックスよりずっと楽しいわ、無料でもできるの！なんて素晴らしい夏休み♡♡」と嬉しそうに言っているところです。胃の断面図を見ると、さまざまな糞便が胃を完全に満たしているのがわかります。\n最後のシーン\nhttps://www.imagebam.com/view/MEVIL1M\n断面図\nhttps://www.imagebam.com/view/GAD4EL", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@melon_piepie/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be400cd7/uploads/origins/a8822587-0a91-4d4e-b60d-ae2ee4b402f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fd3e48473cf7ff90a41eccdced5245c", "srcset": "https://si.imgix.net/be400cd7/uploads/origins/a8822587-0a91-4d4e-b60d-ae2ee4b402f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1fd3e48473cf7ff90a41eccdced5245c, https://si.imgix.net/be400cd7/uploads/origins/a8822587-0a91-4d4e-b60d-ae2ee4b402f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a305e7f7b26cb6159e37ccc61e9c8f8c 2x, https://si.imgix.net/be400cd7/uploads/origins/a8822587-0a91-4d4e-b60d-ae2ee4b402f1?bg=%23fff&auto=format%2Ccomp