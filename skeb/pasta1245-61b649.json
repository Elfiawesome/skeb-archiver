=200&h=200&s=5c3832926b6608ee8462ced425e66c91, https://si.imgix.net/136174d8/uploads/origins/e784ec48-99c5-4502-8c40-ee5d15409585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=798707c8b93bb8855b2ec90bb8ea0ed5 2x, https://si.imgix.net/136174d8/uploads/origins/e784ec48-99c5-4502-8c40-ee5d15409585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d96a29eb3234f7320aad53f44407849 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/136174d8/uploads/origins/e784ec48-99c5-4502-8c40-ee5d15409585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eac9765401c567507a054a0213ecdb07", "srcset": "https://si.imgix.net/136174d8/uploads/origins/e784ec48-99c5-4502-8c40-ee5d15409585?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eac9765401c567507a054a0213ecdb07, https://si.imgix.net/136174d8/uploads/origins/e784ec48-99c5-4502-8c40-ee5d15409585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5d450754223e4129ec6833f7b470bac1 2x, https://si.imgix.net/136174d8/uploads/origins/e784ec48-99c5-4502-8c40-ee5d15409585?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6971c88d374b16dcd92ea0188ee4e929 3x"}, "body": "こんにちは！あなたの作品が本当に大好きなので、私と友達のオリジナルキャラクターを描いていただきたいです！\n\nリーフ\n（20代、中性的な容姿、緑色の髪、身長164cm）\n\nリーフは兄弟と森で暮らしていますが、よく近くの村に遊びに来ます。疲れたような笑顔と不良っぽい性格が特徴です。暴力や乱暴な遊びが好きなので、時々村で喧嘩を仕掛けることもあります。かつては戦争に参加し、熟練のハンターでしたが、それでも友達とは平和な関係を築いています。\n\n\nモチーフ：森、狼、アベリア、弓と剣\n\n参考資料：https://drive.google.com/drive/folders/1g-sULV4undoOXTGS28ZjPpUqMBUmxajI?usp=drive_link\n\nハープ\n（20代、男性、緑と白の髪、身長181cm）\n物静かで、揺るぎなく、感傷的で、穏やかな性格。ファンタジー世界の王の家臣。かつては王女暗殺のために送り込まれた少年暗殺者だったが、改心して王女の守護者、そして友人となった。若き日を武器として過ごした彼は、常に人間になることを切望している。呪いの病で失明したが、それでも希望を失わず、優しい心を持っている。傷跡、目隠し、そして肌の色に注目してほしい。\n\nモチーフ：鳥、タカ、ハヤブサ、風、波、サメ、文字、剣、鋼鉄\n\n参考資料：https://drive.google.com/drive/folders/1BJT9oOjWN_tzDCAhcu5GkKGPwcQZ1G1c\n\nハープとリーフは、パートナーとして、そして人生の伴侶として、強い絆で結ばれています。二人はどんな時も互いを想い、共に旅をすることを望みます。若く無邪気な時代は過ぎ去りましたが、それでも二人は共に踊り、末永く幸せに暮らしたいと願っています。二人が世界を旅する姿を描いていただけたら、とても嬉しいです。", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pasta1245/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3930848, "client_id": 3337777, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=407a5f1cd1b6b3537b34d2b390defbe3", "srcset": "https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=407a5f1cd1b6b3537b34d2b390defbe3, https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29e5384cb38f85f0346314947cac662e 2x, https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8415aaf168d7f3c8ccd45a899203bea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c93759f0e0ecd33af21cbd2d1ad85254", "srcset": "https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c93759f0e0ecd33af21cbd2d1ad85254, https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=731257218a523b2b667a7cf3ef0dd8a0 2x, https://si.imgix.net/7d5ad798/uploads/origins/10d1bf5a-3ea9-4cf2-bf89-6bc6eba313fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c032867033d2fd487d749bab2cc27ef3 3x"}, "body": "はじめまして。突然のリクエスト失礼いたします。\nXにて先生の作品を拝見し、その絵のタッチや表現力に一目惚れいたしました。ぜひ私のオリジナルキャラクター（OC）を描いていただきたく、ご連絡いたしました。\n\n以下にキャラクターの設定とシチュエーションを記載いたします。\n\n【基本情報】\n性別： 男性\n年齢： 25歳\n身長： 188cm\n職業： カメラマン / チンピラ\n\n【外見特徴】\n髪型： 白灰色の髪。襟足（ウルフカットの長い部分）全体が淡い青色になっています。\n顔立ち： 口元（口角付近）にほくろあり。目元には常にやや濃い隈があります。\n耳飾り： 左耳に蛇モチーフのピアス、右耳には複数のピアス・イヤリングを着用。\n傷跡：\n首元を一周するような傷跡。\n左胸から左腹部にかけて2本の横傷。\n右腹部に1本の横傷。\n右股関節から太ももにかけて1本の縦傷。\n\n【性格・雰囲気】\n普段： 蛇のように陰鬱で寡黙なタイプ。冷静で感情が薄く見えます。\n内面： 興味を持った対象には非常に情熱的で、執着心の強い「粘着系」な一面があります。時折、狂気的で偏執的な笑みを浮かべることがあります。\n笑顔： 獲物を狙うような、霧のように掴みどころのない歪な笑顔が特徴です。\n\n【イラストのシチュエーション・ご要望】\n内容： この男性がどこか狂信的でうっとりとした（陶酔したような）表情でカメラを構えて撮影している瞬間、何者かに放たれた「矢」がカメラを射抜き、粉々に砕き割るシーンをお願いしたいです。\nイメージ： 映画『ミスミソウ』のような、残酷さと美しさが共存する情緒的な雰囲気を目指しています。舞台が冬である必要や、映画と全く同じ構図である必要はありません。あの作品特有の空気感を先生の解釈で表現していただければ幸いです。\n服装： 資料リンク内の「衣装資料」を自由にご参考ください。もし先生の方で他に描きたい衣装案があれば、そちらでも構いません。\n構図： 横書き（横長）のイラストでお願いできますと幸いです。\n\n先生の感性で描かれる彼をぜひ拝見したいです。\nお忙しいところ恐縮ですが、ご検討のほど何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1fLwRLeB-ngFy0gNpSJJC0jti00LkuoKa?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pasta1245/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3930848, "client_id": 3918428, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0169e63f46a6fba211d2c51fb6f387f", "srcset": "https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0169e63f46a6fba211d2c51fb6f387f, https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb61a96995f1246f5082a50cb4e9e05e 2x, https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2711c8a898b5b7c775785e34db473de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edd54d11b786d93b0df5d71e7990e230", "srcset": "https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edd54d11b786d93b0df5d71e7990e230, https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a3c9772427d9ea329cd2dca12ceed246 2x, https://si.imgix.net/6cbc616a/uploads/origins/d5984498-ce0d-4c69-9252-36910ce8d91c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0be1c68f1931c8515032d7bb1fcaac7a 3x"}, "body": "先生、こんにちは！先生の絵が大好きです！この2人のオリジナルキャラクターを描いていただけませんか？キャラクターの参考画像は、フォルダ「🐴 Judgment / Valentine」と「⚠️ Mori / Lawson」にあります。\n\n🐴 Judgment / Valentine\n180cm\n混沌を一切許さない、無表情で厳格な悪魔。すぐにイライラし、物事が思い通りにいかないときは暴力で脅すことも多い。厳格なルールに従って生き、誇り高い性格の持ち主。経験不足のため、恋愛に関してはかなり照れ屋な一面もある。ツンデレ。\n\n⚠️ Mori / Lawson\n180cm\n人生に喜びを見出せない、精彩を欠いた貴族。常に死を連想させるような暗い見方をしているが、それを表には決して出さない。他人に対しては友好的でおしゃべりで、いつも笑顔を絶やさない。しかし一人になると静かになり、しばしば物思いにふける。他人には流されやすく、頼まれたことは何でも従うタイプ。有毒な片思い男。\n\n関係性\n🐴は自分の気持ちを表現するのが苦手だが、⚠️は🐴をからかって反応を引き出すのが好きだ。二人は互いに愛し合っており、この世で誰よりも相手を必要としている。\n\nご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1m1X4NY9oHEfj7Lt-2JviSSK2GMyk0zYp?usp=sharing", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pasta1245/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3930848, "client_id": 3175711, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=290d9cae7d79948ba7d829ddd82d48be", "srcset": "https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=290d9cae7d79948ba7d829ddd82d48be, https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e81ab49738444fc1854c7621f8081f99 2x, https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ec406721f681e0812204928825309ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61d88500d4680ac64934bd1728fcbb81", "srcset": "https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61d88500d4680ac64934bd1728fcbb81, https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3ff0d332a1b112f3828b368e840ee683 2x, https://si.imgix.net/84c1bdc6/uploads/origins/73a7accb-9b0a-4f4c-868e-573a87a2a259?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fef23fdc90120b9e6bfd69c099c394dc 3x"}, "body": "こんにちは！先生のイラストに一目惚れしました！霊が見える少年と、その少年に取り憑く霊のイラストをお願いしたいです。\n\n⛔ GUI\n夢を喰らう霊。人間の夢を糧とし、悪夢をより美味しく味わわせるために人々に取り憑く。サディスティックで傲慢、無神経で、自分しか考えていない。\n\n※ 白い肌、口の横のほくろ、左右の目の色が異なる点にご注意ください\n\nテーマ：悪意、瘴気／夢のような霞、甘い夢と悪夢、最後の食事\n\n🪟 XI\n内気で不安がり、人生に迷っている。XIは愛する人たちの幸せを願う優しい人です。他人のためなら進んで立ち上がるものの、自分のためには決してそうしません。ヘッドホン、マスク、帽子の有無は自由です。彼は（自分の弱さを嫌っているため）他人に判断されているのではないかと心配し、他人の視線を恐れています。\n\n※ 銀のリングネックレスにご注意ください\n\nテーマ：夜空、窓（外を眺める）、夜空の小さな星\n\n先生のこれらの作品が好きです！\nhttps://x.com/pasta1245/status/2012427698107257285/photo/1\nhttps://x.com/pasta1245/status/2018642793686786251\nhttps://x.com/pasta1245/status/2028819445381292385/photo/1\n\n自由に描いてください！別の衣装でもOKです！\n\nhttps://taroscakes.notion.site/Gui-Xi-32a384545d1d809095a7f4bf6325a850", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pasta1245/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3930848, "client_id": 2495946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8de3cb9/uploads/origins/7fa8ef09-0278-48f6-82bf-4ad1d6aac08f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226df133b5ac68a9b268bdba210b9aa0", "srcset": "https://si.imgix.net/e8de3cb9/uploads/origins/7fa8ef09-0278-48f6-82bf-4ad1d6aac08f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=226df133b5ac68a9b268bdba210b9aa0, https://si.imgix.net/e8de3cb9/uploads/origins/7fa8ef09-0278-48f6-82bf-4ad1d6aac08f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6eee70d3432e69b357af4c6136b17091 2x, https://si.imgix.net/e8de3cb9/uploads/origins/7fa8ef09-0278-48f6-82bf-4ad1d6aac08f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a6dedb8466a22e6a9ec92bd381d3f65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8de3cb9/uploads/origins/7fa8ef09-0278-48f6-82bf-4ad1d6aac08f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200