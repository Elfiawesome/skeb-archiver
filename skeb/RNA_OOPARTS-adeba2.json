トをお願いさせていただきました。\nページ内への描き込みや加工、またページの追加などもしていただいて構いません。\n\n下書きの下書き状態で大変お見苦しいデータになりますが、ご助言の方何卒よろしくお願いいたします。\n\n\n以下2/27追加文\n\nデータに不備があったとのことで、再送させていただきます。\nリンクしたドライブのフォルダの権限を変更しました。\n\nもしまた不備があったら気兼ねなくキャンセルしただいて構いません。この度はお手数おかけしまして申し訳ありませんでした。\n確認の方何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/179WzL2KaEqOmW2FUGUJTaeoDM6Ex5-7n", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SHIROI_UMA_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3562920, "client_id": 2845078, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53cf8399edf68eab188efd7e566c2cf", "srcset": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53cf8399edf68eab188efd7e566c2cf, https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d8da7179771d686f83475619e47c3ebc 2x, https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1136b64c3b44fe37ae0d988742e90f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5bf62c9f988793c34adabc4873db53", "srcset": "https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e9ce-4776-a288-cbddba78f54e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d5bf62c9f988793c34adabc4873db53, https://si.imgix.net/4cb41f9f/uploads/origins/24ad5bae-e