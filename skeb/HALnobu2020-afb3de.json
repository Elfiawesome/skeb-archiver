1a0-a706-4d23-9fac-097b11bbd16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3958de458d275b5a26147beb577acbd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/002b595c/uploads/origins/6b49c1a0-a706-4d23-9fac-097b11bbd16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ce9b6ec774e756018edd1142a1d1595", "srcset": "https://si.imgix.net/002b595c/uploads/origins/6b49c1a0-a706-4d23-9fac-097b11bbd16e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ce9b6ec774e756018edd1142a1d1595, https://si.imgix.net/002b595c/uploads/origins/6b49c1a0-a706-4d23-9fac-097b11bbd16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07c4a5247d960431446e7995f38e7409 2x, https://si.imgix.net/002b595c/uploads/origins/6b49c1a0-a706-4d23-9fac-097b11bbd16e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1def4863f3f15bec8b77cfe3a6cab6a7 3x"}, "body": "（イラスト依頼内容）\n前回依頼分も含めて２枚。\n\n肝臓くんとお酒のイラストを差分２枚（壁紙用とお酒説明）と\nそのメイキングを見たいです。\nイラストは同様のもので、レイアウトを変更する感じです。\n\n（使用用途）\n個人のパソコン壁紙として使わせてもらおうと思っています。\n\n（締め切り）\n特に急いでいません。\n９月～１０月くらいまでに出来上がれば嬉しいです。\n\n（サイズ・解像度）\n私の使っているWindowsのデスクトップは1366×768です。\n\n（形式）\nレイヤ―情報を使う予定はないので、pngでお願いします。\n\n\n＊＊＊＊＊＊＊＊＊\n\n\n（イラスト内容詳細）\n肝臓くんとビール、ウイスキーが並んでいるイラスト。\nビールとウイスキーは、秋のおススメでスズハルさんチョイスでお願いします。\n\n①一枚はイラストメインでデスクトップ壁紙に使用できるもの。\n②もう一枚はお酒説明を加えた説明中心のもの。（イラスト自体は①と同じでレイアウトが別のイメージ）\n③そのメイキングは動画ではなく、前回のニコラスケイジみたいなノートをイメージしています。\n\n①デスクトップ壁紙\n家のパソコンで実際に使用するので、\nアイコンなどが並んでも違和感がないものが良いです。\nビールはグラスでキラキラしてるのが見たいです。\nウイスキーは丸い氷でかっこいいグラスに入ってるのがいいです。\n肝臓くんはおまかせします。\n\n②説明イラスト\nスズハルさんの説明イラスト好きなので、\nチョイスしたお酒の説明が入っているものが見たいです。\n\n③メイキング\nイラストの描き方を教える・・・というメイキングというよりは\nニコラスケイジの時みたいに、どういう調べ方をして\nどういう点にこだわって作っているかが知りたいです。\n特に知りたいところは、①のお酒の色塗り。\n②はお酒をチョイスした理由、フォント語り。\nそのあたりを知りたいです。\n\n差分とメイキング（これはスケブ的には別なのかな）ということで、依頼２つ分の６０００円でお願いします。", "nc": 16, "word_c