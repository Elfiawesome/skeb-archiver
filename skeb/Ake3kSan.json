4a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb22d37043739d62d74f1cce439e9137 2x, https://si.imgix.net/d2faf1b2/uploads/origins/effda586-d14d-4016-ad80-7919cc4b14a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e41be24379558895085d9859086da5d3 3x"}, "body": "こんにちは！お元気ですか？\n\n前回、あなたの絵がとても気に入ったので、新しい絵を依頼しに来ました！\n\nhttps://drive.google.com/file/d/1EAJkRM6_fFqg4c3E0V9LmXUocIPlcFgM/view?usp=drive_link\n\nプライドが高く、あまり感情を表に出したがらない。人間を見下していることが多く、短命だからバカだと思っている。\n\n最近のハロウィンのアートがとても気に入りました。同じような雰囲気のものを見てみたいですね。\n\nヴァンパイアの半身が欲しいですね。彼は優位に立ったような微笑んだ表情でもいいです。背景は暗く、激しく。手も画面に触るように伸ばしてください。\n\nこれでいいと思います！\n\nできればSNSに使いたいです。\n\nありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ake3kSan/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3110527, "client_id": 3337515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab69a09244f2db68fd593fe2cb6d8fff", "srcset": "https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab69a09244f2db68fd593fe2cb6d8fff, https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53ebcb7edaff5fe615b61f9e69e4a887 2x, https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3807d841fcbd0308da41c309a4e5ca96 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77a71a35724135e47de79dcd9850b002", "srcset": "https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77a71a35724135e47de79dcd9850b002, https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee9342ca96ecbf2af8763cc967d9cbef 2x, https://si.imgix.net/8fa16d0d/uploads/origins/13e2e824-36fe-4561-bf73-f96612415262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ede1a36e95cf6a32e9c7f4399b1839e 3x"}, "body": "Hi! I like your art. I would like to commission you!\nI would really like an illustration like this! https://skeb.jp/@Ake3kSan/works/1\nI would like you to draw my character Lucien. https://toyhou.se/28408399.lucien/gallery\nYou can draw him with either his black jacket, hoodie, pants and sneakers on, or shirtless like in your artwork you created. It is your choice! \nHe is a calm and stoic character, but on the inside he is deeply insecure, struggling with identity. He is very logical. He is anxious and worries about alot of things internally. He acts like he doesn't care about many things even if he does. He struggles socially but is a loyal friend to those he trusts.\nHe likes to excersize (he is very physically active + fit), video games, and performing household duties like cooking or cleaning! He is very responsible. He likes to drink tea in the mornings.\nHis body type is like an average male, with a little bit of muscle. \n\nhttps://toyhou.se/28408399.lucien/gallery\n\nhttps://toyhou.se/28408399.lucien/gallery", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ake3kSan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3110527, "client_id": 3208934, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fede6f939a4b261820042e7a1d4e7b34", "srcset": "https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fede6f939a4b261820042e7a1d4e7b34, https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=124f5ef41621697b93d46b79d83f1920 2x, https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=712d70b411e01b384193b2c02c8851c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00f83f0ed00065ddd61f76a6d2e197f7", "srcset": "https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=00f83f0ed00065ddd61f76a6d2e197f7, https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfabb4aab66eac2d3249898e195ed224 2x, https://si.imgix.net/e978d104/uploads/origins/3d594a59-05d2-44e9-a839-c1f74aa9ba53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=484790fd5178349c5c42f9c19bc1e67e 3x"}, "body": "こんにちは、あなたのページを見つけました！私のキャラクターを描いていただけませんか？必要であれば、彼女の説明を書いておきます：彼女の名前はウェスリーで、映画学校を卒業し、\"Corbeau's \"というコンビニで働いている。神経質で怖がりな女の子で、そこで働くことを嫌がっているが、一生懸命頑張っている。性格は漫画『チェーンソーマン』の小紅に似ている。怖い映画やゴシックな美学が好きなので、ダークで不気味なビジュアルを使ってほしい。ポージングはあなた次第。ウェズリーのビジュアル資料へのリンクを添付します。\n\nhttps://drive.google.com/drive/folders/15we1N7rwrXwKyqYilBXmK9BhXl7G_PPj?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ake3kSan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3110527, "client_id": 1665765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0dc3382e/uploads/origins/8d8bbebc-6174-4d94-8611-70b3d2afe98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=233c08216f3c91d9f5503216ef1934f4", "srcset": "https://si.imgix.net/0dc3382e/uploads/origins/8d8bbebc-6174-4d94-8611-70b3d2afe98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=233c08216f3c91d9f5503216ef1934f4, https://si.imgix.net/0dc3382e/uploads/origins/8d8bbebc-6174-4d94-8611-70b3d2afe98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89410e7a53284d61c8bed813f12db2bd 2x, https://si.imgix.net/0dc3382e/uploads/origins/8d8bbebc-6174-4d94-8611-70b3d2afe98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e72d66857dc429df069afd534754bbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0dc3382e/uploads/origins/8d8bbebc-6174-4d94-8611-70b3d2afe98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69cf55cb0a6d1e56316f14b0125b8ab7", "srcset": "https://si.imgix.net/0dc3382e/uploads/origins/8d8bbebc-6174-4d94-8611-70b3d2afe98e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69cf55cb0a6d1e56316f14b0125b8ab7, https://si.imgix.net/0dc3382e/uploads/origins/8d8bbebc-6174-4d94-8611-70b3d2afe98e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6492638873628a8a705d13fa0c23cdb 2x, https://si.imgix.net/0dc338