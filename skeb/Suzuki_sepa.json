酒場を経営しています。そこで彼はコーヒー、紅茶、アルコール、ポーション、チャーム、そして最も人気のある占いを提供しています。\n\n彼の魔法は、星空のような体をした神秘的なコウモリである彼の身近な存在から生まれます。抹茶はこのコウモリをラヴィと名付けた。Lavyは、必要な時には酒場を見守る目の集まりに、武器が必要な時にはコウモリスタイルのHalberdに、また、やせ細った背の高い獣に変身することができます。\n\n抹茶の目標であり仕事は、客に最高のサービスを提供すると同時に、後で売るための情報をできるだけ多く得て、それを価格で売ることである。彼はずる賢く、生意気で、自信に満ちていて、誰からも嫌われないが、同時に居心地の良さも持ち合わせている。\n\n好きなように描いてください。ただし、ここで紹介したモチーフや参考リンクにあるようなものを入れていただけると嬉しいです。自由に描いてください。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1I_x-9--AamQCN8e8Fg33r9IXIktZ430y", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 232266, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "NIRA", "screen_name": "NI_RA_10", "avatar_url": "https://pbs.twimg.com/profile_images/1034378163847974912/g1XV8jan.jpg", "header_url": "https://pbs.twimg.com/profile_banners/292665990/1674922949/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1792187, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まち(まちかす)", "screen_name": "mate_wm", "avatar_url": "https://pbs.twimg.com/profile_images/1888949657851838464/0Yw6tder.jpg", "header_url": "https://pbs.twimg.com/profile_banners/992665316/1701994207/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2264432, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "とま", "screen_name": "tmty_FL", "avatar_url": "https://pbs.twimg.com/profile_images/1576389516364959744/qyVkbpwR.jpg", "header_url": "https://pbs.twimg.com/profile_