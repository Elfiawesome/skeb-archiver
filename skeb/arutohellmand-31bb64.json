ore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ece0319/uploads/origins/fce181ec-09a1-4407-be72-d62e3a4f6afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b018ed667f81897f81e82c0265f2d508", "srcset": "https://si.imgix.net/7ece0319/uploads/origins/fce181ec-09a1-4407-be72-d62e3a4f6afa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b018ed667f81897f81e82c0265f2d508, https://si.imgix.net/7ece0319/uploads/origins/fce181ec-09a1-4407-be72-d62e3a4f6afa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9dca7514d770754a9a8a01530fcca9c3 2x, https://si.imgix.net/7ece0319/uploads/origins/fce181ec-09a1-4407-be72-d62e3a4f6afa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2561ed14c056ddb3c2e8aa7cbd719e1 3x"}, "body": "こんにちは。\n前回も引き続き可愛らしい子を描いてくださりありがとうございます。\n今回の依頼も引き続き私の子である\n「ルミナス」と言うキャラを描いて下さると幸いです。\n\nキャラ資料\nhttps://twitter.com/arutohellmand/status/1547379119436218368?s=21&t=w7aRLGyPuWaa1TGhuVRU_A\n\nシチュエーション\n・以下の画像の様な(ファンタジー感溢れる夜の街の)背景で\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQyFzGy_EdBzrbw9HWASxwkgDNXa2LjBVkplw&usqp=CAU\n\nルミナスがこちらを見ながら(カメラ目線)\n嬉しそうに歩いてる姿\n\n・右手に菓子パンなどが入った茶色の紙袋を\n抱えて持っている\n\n・この時、周囲に2・3個光る青紫色のダイヤ型のクリスタルを浮かばせて欲しいです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mirumamu_2929/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1390994, "client_id": 544888, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66bf512a/uploads/origins/69e988b9-c0fc-4ac7-91a9-e80abbe8f853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c692aad31deef5074932a5eec93eccb3", "srcset": "https://si.imgix.net/66bf512a/uploads/origins/69e988b9-c0fc-4ac7-91a9-e80abbe8f853?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2