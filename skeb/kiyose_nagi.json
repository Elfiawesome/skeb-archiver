見してとてもかわちいので\nぜひわたしもイラストお願いしたいです！\n\n◆用途\n　・YouTube（収益化済み）等での配信画面表示、サムネイルでの使用\n　・SNS（Xなど）へのポスト\n\n▼構図など\n　　表情は笑顔が好みです\n　　ポーズや構図などはおまかせします\n\n▼参考資料\n月の裏側からやって来た、推し活大好き！かわちいプリンスです\n好き → ガジェット／ゲーム／アイス\n自由な発想で描いていただけたらと思います\n\nhttps://x.com/nonoruna_ch/status/1955326703968063508\n\n■希望納品形式\nPNGファイルでお願いします（背景透過データ）\n装飾品等でレイヤー分が分かれている場合は併せてPSDも頂けるとうれしいです\n\nよろしくお願いいたします\n\nhttps://x.com/nonoruna_ch/status/1955326703968063508", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiyose_nagi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3282456, "client_id": 3408619, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/518eedf6/uploads/origins/04c4d317-db6c-4879-9117-59c1feb40621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a556b59a2ecd1169162bdaeb5ef09e8e", "srcset": "https://si.imgix.net/518eedf6/uploads/origins/04c4d317-db6c-4879-9117-59c1feb40621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a556b59a2ecd1169162bdaeb5ef09e8e, https://si.imgix.net/518eedf6/uploads/origins/04c4d317-db6c-4879-9117-59c1feb40621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cda24654305a8565b882168c6ecfd6f0 2x, https://si.imgix.net/518eedf6/uploads/origins/04c4d317-db6c-4879-9117-59c1feb40621?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a31312e7a71f5c67f644b3001e58e34e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/518eedf6/uploads/origins/04c4d317-db6c-4879-9117-59c1feb40621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58eefbebf7c75395f13629307b1586d6", "srcset": "https://si.imgix.net/518eedf6/uploads/origins/04c4d317-db6c-4879-9117-59c1feb40621?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58eef