il_image_urls": {"src": "https://si.imgix.net/cadc41dd/uploads/origins/871407b3-57ef-4f19-b77a-a737b4208c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c96614aa2136763659efdc957a0878e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cadc41dd/uploads/origins/871407b3-57ef-4f19-b77a-a737b4208c2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99df888049284af9d89ec29827243cee", "src_set": ""}, "body": "今回もいつものベリショちゃんですが、四つん這いで学校の運動場を歩かせられているイラストをお願いします。\n構図は、ツナさまのイラスト集「艶触」で緑髪の四つん這いの女の子のシーンのものと同じでお願いします。https://skeb.jp/@tsuna0/works/35 の体勢から手を地面について、巨大なボテ腹が地面に接地。へそリングを引きずりながら歩いています。乳首リングに錘がつけられ、ちっぱいと乳首が伸ばされて(資料左下参照)母乳がポタポタ地面に滴り、歩いてきた場所に跡が。\n表情は涙を浮かべたジト目、口枷をしていて首輪から画面外に紐でリードされている感じです。\n首、手・足首の枷をつけている他は全裸を基本イラストとして、差分表現で\n①お尻をムチや手で叩かれて赤くなっている(流血表現なしで)\n②白のパンツをはいている(①の表現はなしで)\nをお願いします。\n\n舞台は学校の運動場ですが、背景で普通に走っている子がいたり、楽しそうに遊んでいる子を描いていただけると嬉しいです。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/yPZX0Mw", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 9515, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "tananne（skeb随時募集ちう）", "screen_name": "tanannedraw", "avatar_url": "https://pbs.twimg.com/profile_images/1626507677550653441/PPdQ53Tw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/775767946031312896/1716423024/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 49}, {"id": 26042, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぺに健🔞", "screen_name": "peni_peniken", "avatar_url": "https://pbs.twimg.com/profile_images/1423000309320675332/kcmntRQQ.jpg", "header_url": null, "appeal_receivable": false, "popu