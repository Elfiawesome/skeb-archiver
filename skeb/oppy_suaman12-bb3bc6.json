のぞき込む\n・誰かと手をつないで夜を散歩している\n・ひつじのぬいぐるみに腰かけて空を見ている\n\n\n\n設定　能力\nめぇは人々の記憶に住み着く妖精や悪魔のようなもので\n体の縁が淡く発光しており、普段は浮遊しています\n桃、アルコール、ミルク、干した布団　等に近しい\n相手の警戒を解くような薄甘い香りを纏ってます\n\n抱き着いたりして肌に触れ続けた相手に眠気を植えつけて夢を見せ\n夢に干渉して自分の情報を滑り込ませることで存在を保ちます\n分泌される体液や血液は練乳やミルクのようで、\n飲ませた相手を強壮し、軽い依存性をもちます\n\nhttps://www.pixiv.net/artworks/70796264", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oppy_suaman12/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3505557, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bff9b94/uploads/origins/734feac9-5465-4e15-8701-146cf2646684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1249af441304e41ec42d85f27199502", "srcset": "https://si.imgix.net/3bff9b94/uploads/origins/734feac9-5465-4e15-8701-146cf2646684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1249af441304e41ec42d85f27199502, https://si.imgix.net/3bff9b94/uploads/origins/734feac9-5465-4e15-8701-146cf2646684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc3af70d0cb2061aeb01600d7e471ff3 2x, https://si.imgix.net/3bff9b94/uploads/origins/734feac9-5465-4e15-8701-146cf2646684?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=091718520982689e9e98b05b5f8f56c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bff9b94/uploads/origins/734feac9-5465-4e15-8701-146cf2646684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=454f2243f325af842d76eb5ee414b26b", "srcset": "https://si.imgix.net/3bff9b94/uploads/origins/734feac9-5465-4e15-8701-146cf2646684?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=454f2243f325af842d76eb5ee414b26b, https://si.imgix.net/3bff9b94/uploads/origins/734feac9-5465-4e15-8701-146cf2646684?bg=%23fff&aut