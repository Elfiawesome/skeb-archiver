et/cc628abe/uploads/origins/54138454-93ee-44d1-a665-8656174290f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9fae9126ac35b13bb0723114729de8e6 3x"}, "body": "はじめまして\nこんにちは\nゆうばりさんのイラストをTwitterで見かけて、すごくキラキラでキレイで好みだってのでフォローさせていただいてました。\n今回こちらで募集されていると知りイラストの依頼をお願いしたいと思います。\n描いていただきたいのはVTuberさんです。\nプロプロプロダクション1期生の夢咲ミアさんのイラストをお願いします。\n夢咲ミアさんへのプレゼントとして考えています\n内容はおまかせします。\nご検討よろしくお願いします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuubarish/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1650322, "client_id": 1547770, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c237f4daa0e57aca1299741c2d3731ee", "srcset": "https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c237f4daa0e57aca1299741c2d3731ee, https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6601acb2fde4cdae7206689d1d77fe66 2x, https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93e5b88062f4864c097690833e2af6c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ede04978a45d32800dce65ed95d3c0f", "srcset": "https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ede04978a45d32800dce65ed95d3c0f, https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb7ea2aac058897fe734792966a60535 2x, https://si.imgix.net/0699aa05/uploads/origins/71637da3-ec7f-44f0-aed8-3b30d646fc77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2742ebab80b9be4e10857b7d99f667da 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、優しい感じであれば嬉しいです)\n\n特徴　けもみみ(キツネ耳)\n(作者様判断で「けもみみ無し」でも可です。その場合の注意点を一番下に記載)\n\n髪のスタイル　おまかせします\n髪の色　おまかせします。白狐等も可\n\n服装　白無垢\n服の色　白　又は少し黄色味のある白色等　(お好きな他色を薄く混ぜ可)\n\n使用しないで欲しい物のお願い(小物や装飾品で使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため)\n赤色和傘の所持　なし　(人物よりも目立つため)\n狐のお面の装着　なし　(顔が隠れるため。斜め掛けや所持は可)\n\nその他の装飾品や小物等はおまかせします\n\n季節　収穫の秋(イチョウ、モミジ)、又は芽吹きの季節の春(サクラ)\n　　　（本榊の花を装飾品に使用する場合は７月設定で)\n天候　天気雨又は、雨上がりの晴れ\n（季節と天候は参考情報です。気にせず自由に描いてください）\n\n構図、解像度はおまかせします\n宛名等はナシでお願いします\n\n参考資料等\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報・地域の祭り等、非商用に限る)許可願います\n\n楽しみながら描いてくれると嬉しいです\nご検討お願いします\n\n※例外\nけもみみ無しの場合\n通常の人として扱います\n狐の嫁入り設定のため、白無垢に「白狐のお面」を所持等させてください\n（※狐面と猫面の違いにご注意ください）", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuubarish/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1650322, "client_id": 1552917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f83c2e8b/uploads/origins/0bd737bc-3bce-4eac-9a43-32f8a8f29da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f328f0861c06d1b4f063410dee001c4", "srcset": "https://si.imgix.net/f83c2e8b/uploads/origins/0bd737bc-3bce-4eac-9a43-32f8a8f29da0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f328f0861c06d1b4f063410dee001c4, https://si.imgix.net/f83c2e8b/uploads/origins/0bd737bc-3bce-4eac-9a43-32f8a8f29da0?bg=%23fff