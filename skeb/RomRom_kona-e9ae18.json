てオーラム村に来た。ファータとは悪友。\n「私は罪人だ……罪人に語る名など……」\n\nファータ\n20歳 男性 180cm\n軽薄な男。直進で、踊りが上手い。\n砂漠の国の清め係の神官（男娼）生活が嫌で家出した。自由と酒を愛する。\n酒好きすぎで、ずっと飲んでるイメージ。\n「踊れ！飲め！今日は祭りだ！」\n\nなにか不備があれば再送、キャンセルしてください。\n\n資料リンク\nhttps://drive.google.com/drive/folders/1QEr4D0NjnSdYqubBDoQP_y4vv2-tMGG9", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@user_nip/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3307194, "client_id": 3101491, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e998ea7c/uploads/origins/62157970-385b-4456-83a9-c6f86a3d619e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22873f092eb65b1e886f2aa2b2206f34", "srcset": "https://si.imgix.net/e998ea7c/uploads/origins/62157970-385b-4456-83a9-c6f86a3d619e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22873f092eb65b1e886f2aa2b2206f34, https://si.imgix.net/e998ea7c/uploads/origins/62157970-385b-4456-83a9-c6f86a3d619e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a59398fc7a7b6aa531e779e799716be4 2x, https://si.imgix.net/e998ea7c/uploads/origins/62157970-385b-4456-83a9-c6f86a3d619e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3eaf180eb8d18c9a64e7bb9a39db22c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e998ea7c/uploads/origins/62157970-385b-4456-83a9-c6f86a3d619e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baf0b1beb3b7bdc7e62e0dfe53c1e51f", "srcset": "https://si.imgix.net/e998ea7c/uploads/origins/62157970-385b-4456-83a9-c6f86a3d619e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=baf0b1beb3b7bdc7e62e0dfe53c1e51f, https://si.imgix.net/e998ea7c/uploads/origins/62157970-385b-4456-83a9-c6f86a3d619e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f