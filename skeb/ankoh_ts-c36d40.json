42d-bdc7-26c2a169c6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b35b525f4558226794e5652725ab2c96", "srcset": "https://si.imgix.net/0dbc820e/uploads/origins/0cbd916b-9a0d-442d-bdc7-26c2a169c6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b35b525f4558226794e5652725ab2c96, https://si.imgix.net/0dbc820e/uploads/origins/0cbd916b-9a0d-442d-bdc7-26c2a169c6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=402514bb758fce14fa5ad3c2319e0e74 2x, https://si.imgix.net/0dbc820e/uploads/origins/0cbd916b-9a0d-442d-bdc7-26c2a169c6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8df2a7ab446aa5a67ba43d6bdfd401c 3x"}, "body": "こんにちは、あんこう様！\n\n以前描いていただいた漫画の続きをリクエストしたいのですが： https://skeb.jp/@ankoh_ts/works/13\n\n前回のコマの続きから始めます。アニスはモンスターにパンチを繰り出そうとしていました。\n\nモンスターはアニスのパンチを簡単に手で受け止め、空いた手で反撃のパンチを繰り出す。アニスはモンスターの強さにショックを受けたようだ。\nアニスはカウンターパンチをかわし、モンスターはさらにパンチを繰り出す。\nアニスは次のパンチをかわし、モンスターの頭部に掌打を食らわせて反撃に成功します。\nモンスターは不器用に彼女をつかもうとする。\nアニスは横に避け、片足払いで反撃する。\nモンスターは片足でひざまずいてつまずきます。その頭は、それを露わにするように傾いています。\nアニスはモンスターの頭部に上向きのキックを放ち、クリティカルヒットを決めました。格闘ゲームのように、サイドに「クリティカルヒット」というメッセージが表示されます。\n\nこのリクエストでは、ヘルスバーを表示したくない。\n\nまた、いつかこの続きをリクエストしたいと思いますが、今はこれで十分です。ご参考までに、このリクエストの次のコマでは、モンスターは立ち上がったままですが、めまいがしている状態になっています。\n\nよろしくお願いします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ankoh_ts/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1692081, "client_id": 1185459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49da4506/uploads/origins/6b0aabf6-8e2a-4d00-80c8-a5bfb81ab2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9e7cf046ee7ee6878eb645df6032a0", "srcset": "https://si.imgix.net/49da4506/uploads/origins/6b0aabf6-8e2a-4d00-80c8-a5bfb81ab2e0?bg=%23fff&auto=format%2Ccompress&fm=webp