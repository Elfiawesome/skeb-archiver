t/f0707a09/uploads/origins/fc0948f8-d629-4786-a178-f17e85c627a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db6d830b81b40d51c15a8b3921bcbfc5, https://si.imgix.net/f0707a09/uploads/origins/fc0948f8-d629-4786-a178-f17e85c627a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bce11ea296f30852f34364672cbc60a2 2x, https://si.imgix.net/f0707a09/uploads/origins/fc0948f8-d629-4786-a178-f17e85c627a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=471d0e51d48ad742594f4fc456e2e28d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0707a09/uploads/origins/fc0948f8-d629-4786-a178-f17e85c627a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=427e44708b67b902de26585600c01cf3", "srcset": "https://si.imgix.net/f0707a09/uploads/origins/fc0948f8-d629-4786-a178-f17e85c627a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=427e44708b67b902de26585600c01cf3, https://si.imgix.net/f0707a09/uploads/origins/fc0948f8-d629-4786-a178-f17e85c627a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41e99739bfee4130828833d8fbe9580f 2x, https://si.imgix.net/f0707a09/uploads/origins/fc0948f8-d629-4786-a178-f17e85c627a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6aa72ff11efd997af9374f97ae14714a 3x"}, "body": "あんこう様、先日は大変すばらしいイラストをありがとうございます。\n想定していたイメージを超えた仕上がりに感動いたしましてリピートでリクエストを送らせていただこうと思った次第でございます。\n\nリクエスト内容の方向性が以前と同じで恐縮なのですが、\nオリジナルキャラクター「エメスティ」の全身イラストを、前回は超軽装戦士でしたが今回は同じような露出度の「超軽装魔法使い」でお願いしたいです。\n\nイメージとしましては、「ラグナロクオンライン」のマジシャンをさらに露出度を上げつつ、「ハリーポッターの世界のホグワーツ生徒」のような雰囲気です。\n\n衣装やポーズ、表情のイメージは\n・ドヤ顔な笑顔\n・前面が開いた暗い色の短いケープを肩から羽織っている。\n・二の腕までの長さの密着する暗い色のロンググローブを装着している。\n・体はビキニアーマーの時と同じくらいの露出で肌の主張を激しく（前回の露出具合が大変気に入っております）\n・アンダーリムのメガネ、もしくはミニグラスをかけている\n・杖はハリーポッターのような片手サイズの小さいモノを右手でかまえている。\n・左手には分厚い魔導書のような装丁の本が持たれ、ページが開かれている。\n・足元は暗い色の短めのソックスと黒色のローファーを履いている。\n\nおおまかなイメージは上記の通りですが、自由にアレンジしてくださっても大丈夫です。露出度重視！\n\nそしてまた今回も、前回と同じ流れで衣装差分として「ノーマルからもう一段階レアリティがアップした」という風に装備がレベルアップした差分があると大変嬉しいです。\n\n・特徴であるギザ歯を見せるような笑顔に変化\n・杖の先端にちょっとした光のエフェクト\n・開かれていた本のページの間から「何かうねうねしたモノ」の先端が見えてしまっている。\n・肩までだったケープが一転して足元まで届くほどのマントに変化するが、胸や股間を覆っていた布地はさらに小さく、なんなら「大事な部分だけピンポイントで隠す程度」になってしまう。\n・体を隠す布地は減ったが、ソックスはニーソックスになり、片方のふとももに杖か試験管を仕込めるようなベルトを巻くようになっている。\n\nといった具合の変化をイメージしております。\n背景の有無はおまかせいたします。少し細かい指定をしてしまい恐縮ですが、何卒宜しくお願い致します。\n\nhttps://min.togetter.com/id/AzumayaEmes", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ankoh_ts/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1692081, "client_id": 2791639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d173fba5/uploads/origins/316aff88-38d4-468b-96bc-a445d966c2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e00e033c6bfd36cd3d1778d1339c1cc1", "srcset": "https://si.imgix.net/d173fba5/uploads/origins/316aff88-38d4-468b-96bc-a445d966c2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e00e033c6bfd36cd3d1778d1339c1cc1, https://si.imgix.net/d173fba5/uploads/origins/316aff88-38d4-468b-96bc-a445d966c2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=877d2d88eeddd9f02f1b5e41750aaa79 2x, https://si.imgix.net/d173fba5/uploads/origins/316aff88-38d4-468b-96bc-a445d966c2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd82dcf3b29ad3504998e1c39f4de870 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d173fba5/uploads/origins/316aff88-38d4-468b-96bc-a445d966c2a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad51d9fe18a4cabc8b96c41bb0125339", "srcset": "https://si.imgix.net/d173fba5/uploads/origins/