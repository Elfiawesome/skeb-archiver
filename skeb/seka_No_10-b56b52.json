87-2d4bf63350b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=07c662af6d8091e04b9a12b95f4c669e 3x"}, "body": "先生、こんにちは。\n\n今までのアドバイス、本当にありがとうございました！本当に助かりました。最近作った2つのキャラクターについて、コンセプトや技術的なアドバイスをいただけたらと思います。\n\n1.Alastor。1. Alastor: 彼はヒーラーですが、誰も見ることができません -- もし見たら、その人のパワーをすべて使い果たしてしまいます。自己治癒ができないので、生命活動を支えるために人工チューブが必要です。\n\n2.タロン。暗殺者。サーカスで働く。ポーカーカードを武器にし、皮膚から物を取り出すことができる。\n\nありがとうございました！楽しみにしています。\n\nhttps://drive.google.com/drive/folders/1vnOH8S-vuziGkYe1hYXKEOvKGWWVYBHx?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seka_No_10/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 560466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfa48499c4ab4aa33d5ab7ce3d594874", "srcset": "https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfa48499c4ab4aa33d5ab7ce3d594874, https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=100e5344ad1b82046732a99f9f19a305 2x, https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d5e187b79157019d276c66cd07651f24 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52dddcde75313fdd98701d7f479de86", "srcset": "https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52dddcde75313fdd98701d7f479de86, https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc20e5274c2a248a2f0b16e8c7cd767c 2x, https://si.imgix.net/bb1487fc/uploads/origins/9d927b61-8e50-43b1-a328-b85c4efa3ebe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ed71542477b81e0f4beebbfe4194024 3x"}, "body": "先生、こんにちは。\n\n私は先生のツイッターの作品がとても好きです。最近、私の美術のクラスでは、私たちの中にいるモンスターを作るというプロジェクトがあります。私のアイデアを下書きで添付しました。注釈はすべてDeepL翻訳者の助けを借りていますが、大まかなアイデアは正しいはずです。注釈のないものは、ただの思いつきなので無視していただいて結構です。私は絵を描くのが初めてなので、私のプロトタイプのアイデアを先生の美しい絵のように見せるにはどうしたらいいのか気になっています。先生が2-3枚選んで、各ステップでの考えを交えて、どのようにデザインするか教えていただけると嬉しいです。また、コツを教えてもらえるとうれしいです。好きなように描いて書いてください。言葉の問題は心配しないでください、私は日本語の入力方法を知っているので、自分で翻訳できます。ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1Vjq2Nxoxqqb_htz8nhoFKAQwTtS82C9O?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@seka_No_10/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bcbef482/uploads/origins/47d6d3b1-646d-4fb6-a0d8-feedc38bbd59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=527282ea71722e76c51504e8dccdb3d9", "srcset": "https://si.imgix.net/bcbef482/uploads/origins/47d6d3b1-646d-4fb6-a0d8-feedc38bbd59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=527282ea71722e76c51504e8dccdb3d9, https://si.imgix.net/bcbef482/uploads/origins/47d6d3b1-646d-4fb6-a0d8-feedc38bbd59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&tx