ば1枚に収めず、キャラごとに分けてのご作成でも問題ございません。\nまた、極卒の悪魔らしくダークで強そうな雰囲気を纏わせていただけると嬉しいです。\n\n■資料\n下記のリンク先をご参照ください。\n分かりづらい点の補足として、両者とも縦長の瞳孔をしております。\n詳細なデザイン画をご用意できておりませんので、細部のデザインは省略したり想像で描いていただいて問題ございません。\n\n折角の機会と思い欲張って2体あわせてのご依頼となりましたが、何卒ご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/0/folders/1lf3_3pNTLZv4sbby0vheZD6pwipjA-oA", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onk_pon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 905975, "client_id": 328478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a332b6a4/uploads/origins/4ac0582b-17e6-45a4-a05f-399423ecef56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9161a99c66cdcbd2d287cbc8dc575141", "srcset": "https://si.imgix.net/a332b6a4/uploads/origins/4ac0582b-17e6-45a4-a05f-399423ecef56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9161a99c66cdcbd2d287cbc8dc575141, https://si.imgix.net/a332b6a4/uploads/origins/4ac0582b-17e6-45a4-a05f-399423ecef56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e3d9b4fbd741d966afcb3a98fec48f5 2x, https://si.imgix.net/a332b6a4/uploads/origins/4ac0582b-17e6-45a4-a05f-399423ecef56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a65cf382a20cf23cf3f5da3ffa9ddcc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a332b6a4/uploads/origins/4ac0582b-17e6-45a4-a05f-399423ecef56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2395ef39af31d0f30fcebe8d214b45f", "srcset": "https://si.imgix.net/a332b6a4/uploads/origins/4ac0582b-17e6-45a4-a05f-399423ecef56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2395ef39af31d0f30fcebe8d214b45f, https://si.imgix.net/a332b6a4/uploads/origins/4ac0582b-17e6-45a4-