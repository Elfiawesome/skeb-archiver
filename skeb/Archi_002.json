も満足していたので、また依頼をしたいと思っていました。作品は、『ぼっちザ・ロック！』の後藤ひとりさんが父親と逆さ吊り騎乗位でセックスするというものです。二人とも全裸で、父親が彼女の中でフィニッシュする。ありがとうございました。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Archi_002/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2135325, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5ced47d2afa1ccf7cc965aa450d190f", "srcset": "https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5ced47d2afa1ccf7cc965aa450d190f, https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddcbfce158a20721c9fba4b9c38e82cf 2x, https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe0c31511bb65f07e63cbf19cb38554b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17506743527a5fccea107d4e61aad22", "srcset": "https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a17506743527a5fccea107d4e61aad22, https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0bbde710ebd7128c9586190672d36359 2x, https://si.imgix.net/0d088cd0/uploads/origins/b2b983b4-af86-44b6-961c-c11328029d26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fde8884a7a183c0f70e062f84e59e04 3x"}, "body": "こんにちは！ぼちぼちザ・ロック！の後藤ひとりさんを描いていただくことは可能でしょうか？ピンクのトラックスーツを着て、ファスナーを一部開けて胸を露出させ、父親と騎乗位セックスをしているような感じでしょうか？よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Archi_002/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2135325, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a4816c851a7dc1f42fa41aaad7547ed", "srcset": "https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a4816c851a7dc1f42fa41aaad7547ed, https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf83a7d9bc0defe7aef3c3b5723208a7 2x, https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=772290c94f671a5a71969427decdd0f1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=059fb47dfd715d8a280f0e91b14d76a7", "srcset": "https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=059fb47dfd715d8a280f0e91b14d76a7, https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b15ecf614c2e1b2c0caef31caa285234 2x, https://si.imgix.net/98314901/uploads/origins/ccaa88d7-6df4-4299-902c-8af33c662666?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee68965d7969952e533e1ef0e5dba5b6 3x"}, "body": "はじめまして。\n今は亡き、オルタンシア・サーガ（通称オルサガ）というアプリに登場したカノンというキャラクターのイラストをリクエストします。\n\nシチュエーションとしては、カノンが指笛を吹こうと練習するも上手く鳴らせず咥えた片手が透明な唾液でベタベタになっている状態です。\n長時間練習しても一向に指笛が上手くいかないためか、両目には涙が浮かび、頬は紅潮し、ハァハァと息は漏れ、指を咥え続ける口端からは唾液が伝い垂れています。\n構図としては全身を描く必要はなく、カノンの頭から臍付近までが画面に収まる程度で構いません。正面か斜めかはお任せします。作者様が描きやすく最も力を発揮できる形が望ましいです。\n可能であれば、差分としてぎゅっと両目を閉じて指笛を吹くも「ぷふぅ」と、情けない音と共に唾液が飛散するだけのイラストもリクエストします。\n条件が見合わなければキャンセルをお願いします。\n\n作中、カノンはカジノディーラーの看板の一人として働いているキャラクターです。気弱で鈍臭く、何をやるにも不器用で要領の悪い感じの子で、肝心のディーラーとしての力量も微妙でした。\n\nhttps://www.dropbox.com/scl/fo/2tgoz7oi3sg2ls9i3uumu/AJUZZ1MJ2Wr30Uk5Z7AIGY4?rlkey=qn1t34oqxj2h5yu1chw7ur0hk&st=d8qal8x0&dl=0", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Archi_002/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2135325, "client_id": 1144351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb274266/uploads/origins/f28d782a-457a-41fd-87ec-303e9a621770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cb9ece72a1cdc05b4821b2d0a3292ec", "srcset": "https://si.imgix.net/eb274266/uploads/origins/f28d782a-457a-41fd-87ec-303e9a621770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cb9ece72a1cdc05b4821b2d0a3292ec, https://si.imgix.net/eb274266/uploads/origins/f28d782a-457a-41fd-87ec-303e9a621770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96b2dde31839391f78648d542c254a7b 2x, https://si.imgix.net/eb274266/uploads/origins/f28d782a-457a-41fd-87ec-303e9a621770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7e27c07d29a500b646bc5effeb5e8fa4 3x"}, "duration": null, "nsfw": false, "hardco