私のオリジナルキャラクターをリクエストすることは可能でしょうか？容姿端麗で信心深いと評判の高僧ですが、実は本当の自分を隠しており、仕えている神にも懐疑的です。理性的で論理的な思考を好む人だが、事情と恩人のせいで神父になった。仕事は嫌いではないが、神々に頼る前に自分の頭で考えるよう人々に勧めている。彼をどのように描くかは自由にしてください！私は何でも嬉しいです。構図はお任せします。無理そうなら遠慮なく断ってください。リクエストを見てくれてありがとう！\n\nhttps://drive.google.com/drive/folders/1v-NaUAVT7ZAOtmQH2NJ4ykDrGzdaT2Y3?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@am_sound/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2862409, "client_id": 346700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc1b3d36/uploads/origins/cc5c3ebc-c73a-451a-befc-12bd0bec6f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a852617c97de44b7f1eab139c5a1b4", "srcset": "https://si.imgix.net/bc1b3d36/uploads/origins/cc5c3ebc-c73a-451a-befc-12bd0bec6f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a852617c97de44b7f1eab139c5a1b4, https://si.imgix.net/bc1b3d36/uploads/origins/cc5c3ebc-c73a-451a-befc-12bd0bec6f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abfd98c614633d5ebbb7bec906cb1c35 2x, https://si.imgix.net/bc1b3d36/uploads/origins/cc5c3ebc-c73a-451a-befc-12bd0bec6f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a89f395108638d7b3f7788dc05c85731 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc1b3d36/uploads/origins/cc5c3ebc-c73a-451a-befc-12bd0bec6f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f642b40e27d8a81c0ed9f311f1812ee", "srcset": "https://si.imgix.net/bc1b3d36/uploads/origins/cc5c3ebc-c73a-451a-befc-12bd0bec6f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f642b40e27d8a81c0ed9f311f1812ee, https://si.imgix.net/bc1b3d36/uploads/origins/cc5c3ebc-c73a-451a-befc-12bd0bec6f5