ただきたいです。\n靴も同様に参考画像の方の白い部分を黒色にしていただきたいです(デザインに関しては簡易的なものでも大丈夫です)\nピアスを付けたいのですが、こちらのデザインはよる様にお任せしたいです。\n\n○ポーズについて\nポーズはお任せしますが、等身で描いていただけると幸いです。\n\n問題点等ございましたらキャンセルや再送請求をお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fOmlitGlJQ4uVgaFA9jmK3ViVVpmLV_S", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@am_3zi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2688522, "client_id": 195625, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2545b2ef/uploads/origins/22bed8d2-c513-4920-94c0-709f8f4dfe60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8959101a823dba42d78147f67cfe9c96", "srcset": "https://si.imgix.net/2545b2ef/uploads/origins/22bed8d2-c513-4920-94c0-709f8f4dfe60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8959101a823dba42d78147f67cfe9c96, https://si.imgix.net/2545b2ef/uploads/origins/22bed8d2-c513-4920-94c0-709f8f4dfe60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c03ac729ab8c9951191939f7b1e60d99 2x, https://si.imgix.net/2545b2ef/uploads/origins/22bed8d2-c513-4920-94c0-709f8f4dfe60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e32524cc5200b1af36de2ddff80ee580 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2545b2ef/uploads/origins/22bed8d2-c513-4920-94c0-709f8f4dfe60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08788ad98eece731fe165d8b4b543f5e", "srcset": "https://si.imgix.net/2545b2ef/uploads/origins/22bed8d2-c513-4920-94c0-709f8f4dfe60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08788ad98eece731fe165d8b4b543f5e, https://si.imgix.net/2545b2ef/uploads/origins/22bed8d2-c513-4920-94c0-709f8f4dfe60?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=