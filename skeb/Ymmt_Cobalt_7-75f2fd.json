もスーツのポケットの双葉のぬいぐるみ（自作）を撫でている。\n性格は優柔不断で大人しいが、双葉の為なら何でもする。不器用で怪我をしやすく、メンタルも少し弱い。双葉によく励まされている。\n\n\n見た目の詳細については主に添付した画像を参照して頂けたら幸いです。分かりにくい箇所などは描きやすいようにアレンジして頂いて構いません！\n\nイラストの雰囲気・構図などはお任せ致します！山本さんの思う解釈で2人を描いて頂けたら幸いです✊🏻💚✨（アイドルとマネージャーではありますが、距離が近くても……〇）\n お忙しい中かとは思われますが、よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1iPeZLw8KdVOLq5Ti2C5hSLOEoY-XDVuq", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 482850, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "らぴす教授🍮", "screen_name": "RPS_dot", "avatar_url": "https://pbs.twimg.com/profile_images/1906831474487427073/pRU0GNWB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1078044407188750337/1714597547/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 1185164, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "👻", "screen_name": "u02", "avatar_url": "https://pbs.twimg.com/profile_images/2048068087203966976/CocV6D1o.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1358631367714590720/1757515556/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": tru