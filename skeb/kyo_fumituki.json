815111/uploads/origins/d9fd3dba-5300-47b2-984a-3a0999b3edf0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf51615ffbc8aaa3ca35168215734a87", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 132217, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kyo_fumituki/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 132217, "client_id": 1562942, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad7283d0/uploads/origins/a54d0929-35c5-417e-abd9-7620c376c5e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=451fbd0e49a70695fa7cac98037976db", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad7283d0/uploads/origins/a54d0929-35c5-417e-abd9-7620c376c5e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27ea81e9db66fcf511c247606d069bdf", "src_set": ""}, "body": "はじめまして、リクエストお願いします。\n\nキャラはゴブリンの巣穴で先生が描かれたホビットのペイジちゃんで。\n\n心と身体を淫乱に調教され快楽堕ちするも、無事ゴブリンの手から解放され元の生活に戻った後の世界線を想定の元\nシチュエーションは旅先で出会った心優しく純粋無垢な男の子(7~9歳くらいで表現はお任せします)を好きになり、快楽を知ってしまった身体が男の子の精子を求めてペイジちゃんから勃起ちんちんを挿入させようと男の子を誘惑する描写のイラストをお願いします。\n\n服装は帽子を被り片足にトレンカを、もう片足は生足にパンツをひっかけ他は全裸で。体位は資料のように足裏を見せる開脚ポーズに加えてクパァをするもので。足裏とおまんこに湯気立った蒸れ感も付けてください。\n\nできれば差分表現にて\n・男の子が素股で互いの愛液を馴染ませるよう擦りつけ\n・挿入しピストンして精液を子宮内に大量中出し\n・事後腟口からたっぷりの精液が溢れ出てペイジちゃんの卵子と受精する描写も描いて頂きたいです。\n\n表情は常に快感を求め惚ける感じで。\n\nお手数おかけしますが、何卒よろしくお願いします。\n\nhttp://img.momoniji.com/wordpress/wp-content/uploads/2018/11/mangurigaeshi2018111107.jpg", "nc": 40, "word_count": 0, "transcoder": "image", "creator_accep