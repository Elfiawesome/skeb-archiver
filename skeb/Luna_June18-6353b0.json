していて、口には陰毛が付着している\n\n・主人公の精液と河北のフェロモンで胸が「ムワッ」としている表現の導入をお願いします\n\n・河北「…監督ザーメンくっさ♡♡ どう？ 凄くドキドキするでしょ♡ こんなところ誰かに見られたら私達終わりだね♡ あっ、またチンポ勃起してる！ もうっ♡ ◯◯くん性欲強すぎ♡ お家に帰ったらさっきの続きしようね♪ えっ？ 我慢できないの？ も〜っ♡ じゃあ、今から部室イこっか♡♡」という台詞の導入をお願いします\n\n要望は以上になります。\n\nその他の構図はお任せします。\nもし御都合がよろしければお願いいたします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Luna_June18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2279395, "client_id": 241297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d43a39bd/uploads/origins/cb696ae5-73d7-446c-8c16-6eee2fb490ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe152cf7296111d8b45a6fc4a85872f8", "srcset": "https://si.imgix.net/d43a39bd/uploads/origins/cb696ae5-73d7-446c-8c16-6eee2fb490ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe152cf7296111d8b45a6fc4a85872f8, https://si.imgix.net/d43a39bd/uploads/origins/cb696ae5-73d7-446c-8c16-6eee2fb490ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01d3f643b4c2fe42931af802f4d364d4 2x, https://si.imgix.net/d43a39bd/uploads/origins/cb696ae5-73d7-446c-8c16-6eee2fb490ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5bea9865c10931030ab91f0f61825bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d43a39bd/uploads/origins/cb696ae5-73d7-446c-8c16-6eee2fb490ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95f1bddf46d3c7db2680150858eced92", "srcset": "https://si.imgix.net/d43a39bd/uploads/origins/cb696ae5-73d7-446c-8c16-6eee2fb490ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95f1bddf46d3c7db2680150858eced92, https://si.imgix.net/d43a39bd/uploads/origins/cb696ae5-73d7-446c-8c16-6eee2fb490ef?bg=%23fff&auto=format%2Ccompress&f