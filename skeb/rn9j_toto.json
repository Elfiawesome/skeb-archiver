ou for reading.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rn9j_toto/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3827842, "client_id": 938510, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38061623bc31b8c8a7e16c41052e03e", "srcset": "https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38061623bc31b8c8a7e16c41052e03e, https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61adc756760c667828db1d723c3b7f65 2x, https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b6a99db9016bad6dca327d44e914bde 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb88eeaf30a9dde2e622b39a2a322fe5", "srcset": "https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb88eeaf30a9dde2e622b39a2a322fe5, https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6ba1b06a6bb1ab0e846dcbb86462b1c 2x, https://si.imgix.net/c1a0985f/uploads/origins/ed1ecc4d-843f-4054-b063-0ba25cd4271d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79d9f6521e1760e0f2bbebc62d2cf2aa 3x"}, "body": "こんにちは！私のキャラクター、ハナコのイラストを見たいです。ハナコ：- エリトロン・インダストリーズというロボット企業に勤める熱心な労働者。- エリトロンは、異星の悪魔の肉体の研究に関わる極秘技術を用いてロボットを製造している。この異質な生物学と魔法の融合により、デザイン上、甲虫や昆虫に似たロボットが生み出される。\n\n性格・特技：- 几帳面で組織的。仕事中に深く考え込むと苛立ちやイライラした表情を見せがち- 苛立ちや無愛想な態度の一方で、周囲の努力を認めるよう努めている（表現が不器用なだけ）- エリトロンがロボット製造に用いる研究材料の調達・取引を監督し、長年の経験でロボットに関する豊富な知識を有する\n\n業務は非常に優秀だが、試験場への長距離移動で疲労が蓄積しがち。アート表現：- 圧倒されたり苛立った表情を何らかの形で表現してほしいが、これらの提案を活用しても独自に創作しても構わない。背景色の参考としてロボットと環境の例を添付したが、ロボットや背景要素そのものを描く必要はない。 \n\n- 輸送用木箱（「木箱」参照）に座り、俯瞰視点で描いてください。会社のロゴが入ったコーヒーマグカップを持っているかもしれません。ホログラムの輸送伝票を持ったてんとう虫型ロボットと議論している様子も考えられます- ホログラムのメモに囲まれ、疲れているが状況を掌握している様子ご依頼をご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1H_H7Y9f68estkx5cUi5CXkD3sQBBLXSk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rn9j_toto/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3827842, "client_id": 620402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4759ca73/uploads/origins/246d9598-d33a-4d7c-85db-e6e1bd94827c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70ddca8480b59f24f00e0d2ce3dc483", "srcset": "https://si.imgix.net/4759ca73/uploads/origins/246d9598-d33a-4d7c-85db-e6e1bd94827c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a70ddca8480b59f24f00e0d2ce3dc483, https://si.imgix.net/4759ca73/uploads/origins/246d9598-d33a-4d7c-85db-e6e1bd94827c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4eef84bda7b9a9f33080552a0828014 2x, https://si.imgix.net/4759ca73/uploads/origins/246d9598-d33a-4d7c-85db-e6e1bd94827c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d503c2f0a41aadfae89c038784a59d4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4759ca73/uploads/origins/246d9598-d33a-4d7c-85db-e6e