位は、顔面と雄っぱい\n以上です。それ以外の詳細はお任せします。よろしくお願いします。\nhttps://mana.fandom.com/wiki/Kevin\nhttps://mana.fandom.com/wiki/Godhand\nhttps://mana.fandom.com/wiki/Divine_Fist_(Trials_of_Mana)\n\nhttps://mana.fandom.com/wiki/Kevin", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kkage_ast/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2695500, "client_id": 2062373, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edf55600/uploads/origins/0c9f3f78-98cc-4a88-8dd2-803ecc3a2321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3208e37381e4a25d0e6956b7f50ed1dc", "srcset": "https://si.imgix.net/edf55600/uploads/origins/0c9f3f78-98cc-4a88-8dd2-803ecc3a2321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3208e37381e4a25d0e6956b7f50ed1dc, https://si.imgix.net/edf55600/uploads/origins/0c9f3f78-98cc-4a88-8dd2-803ecc3a2321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1ae6ce44257ca70350009ef636b9496 2x, https://si.imgix.net/edf55600/uploads/origins/0c9f3f78-98cc-4a88-8dd2-803ecc3a2321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aca712955c69474024d003dcfcf737da 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edf55600/uploads/origins/0c9f3f78-98cc-4a88-8dd2-803ecc3a2321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9946d880e3000913d1c86fbb1e08180f", "srcset": "https://si.imgix.net/edf55600/uploads/origins/0c9f3f78-98cc-4a88-8dd2-803ecc3a2321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9946d880e3000913d1c86fbb1e08180f, https://si.imgix.net/edf55600/uploads/origins/0c9f3f78-98cc-4a88-8dd2-803ecc3a2321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2ecca4c2e