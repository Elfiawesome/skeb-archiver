mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a50b30de707cb4e9fb008af971331b4 3x"}, "body": "skebとpixivの絵がすごくえっちだったので、ぜひお願いさせてください！\n聖剣伝説3というゲームのデュランとケヴィンが汗だく汁だくで雄交尾しているところをお願いしたいです。デュランを受け、ケヴィンを攻めで描いて欲しいですが、どちらも男らしく描いて欲しいです。\nふたりはリンク先のパラディンとゴッドハンドの姿でお願いします。ベースは着衣でお願いしたいですが、装備品は適宜パージさせたり脱がせたりして大丈夫です。ふたりとも筋肉質なキャラなので、筋肉はドチドチに盛って大丈夫です！デュランは重装備ですが、装備の上からでも筋肉や汗だく感が伝わるようにえっちに描いていただけるととても嬉しいです。何卒よろしくお願いいたします。\n\n聖剣伝説二次創作ガイドライン\nhttps://www.pixiv.net/artworks/99335815#big_1\n\nデュラン(パラディン)\nhttps://www.pixiv.net/artworks/81587926#big_18\n\nケヴィン(ゴッドハンド)\nhttps://www.pixiv.net/artworks/81587926#big_12\n\n公式サイト\nhttps://www.jp.square-enix.com/seiken3_tom/sp/", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kkage_ast/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2695500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce1d2926abb6fe736676df0db635884d", "srcset": "https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce1d2926abb6fe736676df0db635884d, https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e3821158949264591d0e00cefe05b626 2x, https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a047dc955f90efe6b7c4c19d87beaed0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8f8d5cdab906260c4863b11e7331f0", "srcset": "https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa8f8d5cdab906260c4863b11e7331f0, https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1aeb5363ae3bb116194bbd0626d1142 2x, https://si.imgix.net/e2049b1b/uploads/origins/94296639-ac16-4e02-a1d7-09cfea0f5ed5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=798b9bbcf37fe6eb0e12c12f46a681c9 3x"}, "body": "skebのイラストがとても素敵だったのでお願いさせていただけないでしょうか…！？\n古いマイナーアニメからなのですが「B'T-X」の主人公「高宮鉄兵」をお願いします。\nキャプチャのシーンの様に触手に拘束され陵辱されているシーンをお願いしたいです。\nバトルギア(スーツ)は着せたままでお願いしたいですが、もし可能でしたら雄っぱいや局部が露わになったダメージ差分や射精差分の様なものがあるととても嬉しいです。\n少年キャラですが筋肉も局部も盛っていただいて大丈夫です！\nコヶ”さんの絵がとても素敵だったので、コヶ”さんの得意な様に描いていただけたらと思います。\nご一考くださいませ。\n\n\n触手緊縛\nhttps://i.imgur.com/PeTmhYH.jpg\nhttps://i.imgur.com/zoFr9zd.jpg\nhttps://i.imgur.com/c3Hs0LV.jpg\nhttps://i.imgur.com/KhwIEie.jpg\nhttps://i.imgur.com/tZmN7s9.jpg\n\n設定画\n・パンツ状に分かれていますが一体型のタイツ状に描いて欲しいです\n・鎧部分は金属というより革の様な質感です\nhttps://i.imgur.com/9rceBxw.jpg\n\nその他参考\nhttps://i.imgur.com/jaUiHPs.png\nhttps://i.imgur.com/X8lmydb.png\nhttps://i.imgur.com/cE5imn5.jpg", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kkage_ast/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2695500, "client_id": 1115871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da5bde154850d32db7cf9c566621ecab", "srcset": "https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da5bde154850d32db7cf9c566621ecab, https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e4b3a99911fb9aac36bc2f8b266e875 2x, https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7180009881e10cc6ca618894a4462824 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4880fa5893b3c4cf94792290b17bfb17", "srcset": "https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4880fa5893b3c4cf94792290b17bfb17, https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=12afec976a1211f62daa44861c6ff423 2x, https://si.imgix.net/84f072a4/uploads/origins/f8f569d4-d473-47dc-9da7-79149ad8b2b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=67e54e383fb1e8de2a38a02dc097b744 3x"}, "body": "はじめまして、コゲ様の師弟絵の絵柄や雰囲気がとても好きでこの度はリクエストさせていただきました。\n知らない作品かもしれませんが、シャドウバースというゲームのセージコマンダー（緑髪の男キャラ）とアサルトコマンダー（青紫髪の男キャラ）というキャラを描いていただけたら幸いです。\nとてもマイナーなのですが、この２人の組み合わせが好きなので是非コゲ様の絵柄で拝見できたら嬉しいです…！もし可能でしたら師弟関係（前者が師）ぽく描いていただけたら幸いです。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 6104, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "肉お", "screen_name": "29nikuo_don", "avatar_url": "https://pbs.twimg.com/profile_images/1509785768088068098/0pBBRNQG.jpg", "header_url": "https://pbs.twimg.com/profile_