\nhttps://drive.google.com/drive/folders/1Vvyt7ONu-3wr-lkKY7pFjzdHphUrjC2Y?usp=sharing\n※見えない場合は再送していただけますと幸いです。\n\n◆使用用途\n・XでのSNS活動\n・配信アプリ内でのサムネイル\n・商用利用予定です。\n\n\n◆イラストサイズ、ファイル形式\n・背景、人物をレイヤー分けしていただきたいです。\n（髪の毛やお顔が切れないようにしていただけると嬉しいです！）\n\nskebでの依頼は不慣れですので、失礼がございましたら何卒ご容赦ください。\n\nhttps://drive.google.com/drive/folders/1Vvyt7ONu-3wr-lkKY7pFjzdHphUrjC2Y?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NO4EXPO/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4132304, "client_id": 2618136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af8b043f/uploads/origins/1f5c1f31-8ff2-4a99-9a11-1773f96d5c3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2093f052fcee4c289814df8f79e7e472", "srcset": "https://si.imgix.net/af8b043f/uploads/origins/1f5c1f31-8ff2-4a99-9a11-1773f96d5c3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2093f052fcee4c289814df8f79e7e472, https://si.imgix.net/af8b043f/uploads/origins/1f5c1f31-8ff2-4a99-9a11-1773f96d5c3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ef2ca8d73d1267b6bf9e97a97d71e6e 2x, https://si.imgix.net/af8b043f/uploads/origins/1f5c1f31-8ff2-4a99-9a11-1773f96d5c3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=226ceb6cf461d652a22c41c67091a671 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af8b043f/uploads/origins/1f5c1f31-8ff2-4a99-9a11-1773f96d5c3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55157c0b40a65514f727e1b964a557e9", "srcset": "https://si.imgix.net/af8b043f/uploads/origins/1f5c1f31-8ff2-4a99-9a11-1773f96d5c3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55157c0b40a65514f727e1b964a557e9, https://si.imgix.net/af8b043