記仕様以外はお任せします。よろしくお願いします。\n\nhttps://youtube.com/shorts/ClNogMSniEc?si=KLVKPZA_uxtGVSpP", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@setu_kurokawa/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3677647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a9e9b3806174160b7f4951ff115504", "srcset": "https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9a9e9b3806174160b7f4951ff115504, https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85ead7093356b902080d232bc58ecf32 2x, https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23f80bc59c22e5de8f54dc2f790e355b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd756c703a84a3e65068ed82f7b3922d", "srcset": "https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd756c703a84a3e65068ed82f7b3922d, https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d043d88f3173038d30a73768d63aa437 2x, https://si.imgix.net/c9206b61/uploads/origins/2f562f54-1c47-4ce0-8253-ec7d1ff560f1?bg=%23fff&auto=format%2Ccompress&fm