頭と腕は、ベッドの端から落ちかけてる感じでお願いします\n・酷いアヘ顔をしてます\n・シャツは汗でびっしょりになっていて肌に張り付いて胸が透けて見えます\n・ベッドの上には、脱いだ服や下着が散らかってます(下着の派手でエッチなやつでお願いしたいです)\n・構図ですが真冬先生の頭を左下(右下)として少し引いて斜め上から見た感じでお願いしたいです\n\n以上になります\nよろしくお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yumoteliuce/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8411d869/uploads/origins/e697a1b1-317f-4548-b9e8-6426f42fabac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=339eb0a5ca58e20676f1c552011475cd", "srcset": "https://si.imgix.net/8411d869/uploads/origins/e697a1b1-317f-4548-b9e8-6426f42fabac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=339eb0a5ca58e20676f1c552011475cd, https://si.imgix.net/8411d869/uploads/origins/e697a1b1-317f-4548-b9e8-6426f42fabac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4909212586db6f400db2003b91459347 2x, https://si.imgix.net/8411d869/uploads/origins/e697a1b1-317f-4548-b9e8-6426f42fabac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6bab2f54be6282f07ae27b9464c9fec6 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 12417, "nc": 161}, {"path": "/@yumoteliuce/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6cbb64e9/uploads/origins/595c6b29-f21c-44ba-9a62-0ddd8fc8c02a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e2af1da2f83516c29d96d5e9b2d8240", "srcset": "https://si.imgix.ne