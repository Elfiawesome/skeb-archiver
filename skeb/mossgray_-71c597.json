0&h=200&blur=200&s=9218dd03dfd7ad3b0372da205514f3fd 2x, https://si.imgix.net/9ac4d479/uploads/origins/02927781-beef-4561-a04d-90ba5fc00360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=33e7c93006658df0b4549d6e0164f422 3x"}, "body": "こんにちは！\n私はあなたのキャラクターイラストとアニメーションの熱狂的なファンです。\n私のOCを描いてほしいです。\n\nキャラクターの名前はユキ。\nやんちゃで元気な女の子です。\n水遊びのシーンを描いてください。水着姿が楽しみです！\nどんな水着なのか楽しみです！\n好きなように描いてください！\n\nhttps://drive.google.com/drive/folders/1f2XwceG95cHkMabMzHQVa6LowGDXCD2u?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@sugata_dski/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1337808, "client_id": 1566875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c778a1e/uploads/origins/73ce8d88-bb2b-47cc-94f5-e373db86dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9541a8ec6dc3edc807e7bb794a3bdd34", "srcset": "https://si.imgix.net/6c778a1e/uploads/origins/73ce8d88-bb2b-47cc-94f5-e373db86dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9541a8ec6dc3edc807e7bb794a3bdd34, https://si.imgix.net/6c778a1e/uploads/origins/73ce8d88-bb2b-47cc-94f5-e373db86dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c28d2c92b4707d5d0ecc63a5d3fd831 2x, https://si.imgix.net/6c778a1e/uploads/origins/73ce8d88-bb2b-47cc-94f5-e373db86dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dd0610e24129f799e1cf339da6cbdff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c778a1e/uploads/origins/73ce8d88-bb2b-47cc-94f5-e373db86dd9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cad9d1f3c85c4bebecc58c6eed8fb25", "srcset": "https://si.imgix.net/6c778a1e/uploads/origins/73ce8d88-bb2b-