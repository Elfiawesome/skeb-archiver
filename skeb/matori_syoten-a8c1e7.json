タイよくて筋肉ついてて程よくムチムチだと助かります）\n\n構図やシチュエーションで難しい点がありましたらまとり先生の最もえっちだと思うシチュエーションで描いていただきたいです！！\n何卒宜しくお願い致します！！！！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matori_syoten/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 358330, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f02ba31850120a86aa265f3a02dc4874", "srcset": "https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f02ba31850120a86aa265f3a02dc4874, https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fcc499d56c4a049a8643649e872c31f4 2x, https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cbecb44889448361432a15f1937658dc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16cce67e507e097ba32a4e6e55a2d662", "srcset": "https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16cce67e507e097ba32a4e6e55a2d662, https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1a0b0926bedfd4c19054dbdaf2e217e 2x, https://si.imgix.net/32c2d4e3/uploads/origins/cb29694c-a836-4b30-905d-d35c24f56c9c?bg=%23fff&auto=f