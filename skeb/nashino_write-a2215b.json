20-b7e8-acfcb52787e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24d4936f467221e0cde8d85c8689c0b1 3x"}, "body": "リクエスト失礼します。\nオリキャラ二人のイラストをお願い致します。\n\n〇キャラ詳細\n本名/変身名：フェリシア・ルミナス/紅閃装姫ラグナ　(先輩)\n　　　　　　 狐影 渚/蒼閃装姫ツキヨミ(後輩)\n\n服装：変身後の姿で可能であれば差分でフェリシアはバイザーを取り外し可能に\n　　　渚は仮面とフードを取り外し可能にしてください\n参考画像：https://drive.google.com/drive/folders/1u763fUR_w05_tgnEu_57Low00fpkKXp9?usp=drive_link\n\n〇イラスト内容希望\n・PCの壁紙として使用を考えているので可能であれば画像のサイズ比を16:9に\n・背景はお任せしますが、可能であれば夜の街にネオンが光っている感じでおねがいします\n・構図やポーズはお任せしますが可能であれば戦闘をしているような感じでお願いします\n\n以上になります。\n料金不足等の場合は再送要請をしていただければと思います。\n検討の方をよろしくお願いします", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nashino_write/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3607413, "client_id": 90411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b55a5c84/uploads/origins/64a12c9f-c4e6-4839-a6a4-58c5b4209fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39c61bd65afc799b0c6d4e8d557d462a", "srcset": "https://si.imgix.net/b55a5c84/uploads/origins/64a12c9f-c4e6-4839-a6a4-58c5b4209fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39c61bd65afc799b0c6d4e8d557d462a, https://si.imgix.net/b55a5c84/uploads/origins/64a12c9f-c4e6-4839-a6a4-58c5b4209fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f7b3ad9d078f411c2b63438edd799a9 2x, https://si.imgix.net/b55a5c84/uploads/origins/64a12c9f-c4e6-4839-a6a4-58c5b4209fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e578e954724d2034d35a6627dbab154 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b55a5c84/uploads/origins/64a12c9f-c4e6-4839-a6a4-58c5b4209fd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b88fbfa10e9fa34706d76