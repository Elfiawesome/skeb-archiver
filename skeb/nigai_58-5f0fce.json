mat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=507612011f27821a16f92f575487a5a5 3x"}, "body": "こんにちは、私はあなたのアートワークが大好きです！私のvtuberをあなたのスタイルで描いていただけませんか？ 以下の参考文献を参照してください。図面に黒の水着が欲しいのですが。水着はお好みに合わせてデザインできます。機会を下さりありがとうございます！\n\nこのようなポーズ: https://twitter.com/Saruei_/status/1408259798471168000\nVtuberマミミ: https://imgur.com/a/7zuiTZS", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nigai_58/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1837032, "client_id": 1449517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff38e4f86b2439ba984d0d3ef756ede", "srcset": "https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ff38e4f86b2439ba984d0d3ef756ede, https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72c9f03b3b2be9f337d317896016fa3d 2x, https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d933dc947781510221854f1f8e063a8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f4e5d4dd18468cec19e39fc16915bbc", "srcset": "https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f4e5d4dd18468cec19e39fc16915bbc, https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7de4691431e88165a8ff3277167bc626 2x, https://si.imgix.net/51f92f5a/uploads/origins/cb73461e-32db-47be-969f-1a915d090fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cae4d12afcbeffc766182dd9fa01fa1 3x"}, "body": "こんにちは。\nふとコンビニに立ち寄ったとき、コンビニの前で黒パンが丸見えなのに大胆に座っているギャルJKがいました。\nその姿を見て、同じ格好をしている善子が見たいと思ったのでリクエストを送っています。\n\n参考資料の写真には名前がついています。\n\n「構図」と「構図(上半身)」を参考にスマホを見ながら不良座りをしてパンツが見えているイラストにしてください。\n「パンツのはみ出し方」は黒パンを履いているが、はみ出してパンツが見えてしまっている様子になります。「はみ出しているパンツ」の端の部分を描いてほしいです。\n\n「着せる制服」は白色の長袖のものです。\n実在する高校のものなので、校章は消して、青色の襟のラインとリボンは赤色に変えてください。袖のラインは腕まくりさせるか同じ赤色に変えてください。\nスカートはそのままお願いします。黒色のラインは裏地にもついています。\n\nピアスは構図的に左耳しか見えないかもしれませんが両耳分画像あります。\n残りの装飾は写真の名前の通りで、靴はハイヒールです。\n\n善子の髪型は私が津島善子をツインテールにしたい病なのでツインテールです。\nメイクは全くわからないので曖昧なお願いになってしまうのですが、目元だけ「メイクしてる感」を出していただけると嬉しいです……。\n\n地面だけ色を塗って灰色のタイルの上に座ってる風でお願いします。\n地面は適当でも大丈夫です。\n\n要素てんこ盛りですが、よろしくお願いいたします……。\n\nhttps://drive.google.com/drive/folders/1-O_lqhrd72GvnPeuR0qu8p4T2IK1srHX", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nigai_58/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1837032, "client_id": 1449517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cd38e450d0a87965229f560a4a7e5fb", "srcset": "https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cd38e450d0a87965229f560a4a7e5fb, https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d608055d282ae6a3c77cae6031e2db1 2x, https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=97a63f702de83d6cce6b27176e018e51 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f869e36d9d6eaa41459bd46601f4638", "srcset": "https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f869e36d9d6eaa41459bd46601f4638, https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cf5bc6150150ab08adb5b609992aa4cd 2x, https://si.imgix.net/188740f6/uploads/origins/fb9bea1c-bfa2-4324-b7c7-73cd8a88a20d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f12db905fca94f9c650f34b1aded12b9 3x"}, "body": "こんにちは。\nInstagramを見ていたらインスピレーションが湧いてきたので、ぜひ描いていただきたいと思ってリクエストをしました。\n\n参考資料の「メインのポーズ」の写真を参考にして、赤い丸で囲った部分のようにブラジャーが透けて、黄色の丸で囲んだ部分のようにパンツの線が透けた運動中の善子ちゃんのイラストを描いていただきたいです。\n\n透けているブラジャーは濃いめのピンク(ショッキングピンク)色で、かなりしっかりと透けています。\nシャツは白色、スパッツは黒色のままで、腕時計はなくしてしまってください。パンツの線は中のパンツの色が透けているわけではないのでそのままです。\n\n運動するときはポニーテールやお団子が基本というのは重々わかっているのですが、私は「津島善子をツインテールにしたい病」なので善子の髪型はツインテールにしてください。\nヘアゴムは参考資料のいちごのものでお願いいたします。\n\n表情は「そんなにジロジロ見られると恥ずかしいよ……」という照れた顔だと嬉しいです。\n本人はめちゃくちゃ透けブラしていることに気がついていないという状態ですね。\n\nhttps://drive.google.com/drive/folders/1-6kcPo06mIyV3aNzcVTNZnOsMmRS6Cy4", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nigai_58/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1837032, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/