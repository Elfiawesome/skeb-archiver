ただければと思います。\nもし金額が見合わない、資料が足りないなどあれば再送請求をしていただければ幸いです。\nご検討のほど何よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1MQOPAiEgA4e8TJ0EazBK8i1Z5wJVliuY?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sono_2107/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3518140, "client_id": 2141334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb2896e2/uploads/origins/8b97063f-94b7-418d-901d-c65a8e7e605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e06561451bb07dbcaffb9bdaf768b30", "srcset": "https://si.imgix.net/bb2896e2/uploads/origins/8b97063f-94b7-418d-901d-c65a8e7e605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e06561451bb07dbcaffb9bdaf768b30, https://si.imgix.net/bb2896e2/uploads/origins/8b97063f-94b7-418d-901d-c65a8e7e605e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=206900a5d24ff0d1f91410daa1ed5e81 2x, https://si.imgix.net/bb2896e2/uploads/origins/8b97063f-94b7-418d-901d-c65a8e7e605e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a64f968dbbb30af06a8f40bf99a658ac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb2896e2/uploads/origins/8b97063f-94b7-418d-901d-c65a8e7e605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c23abe1658d1b3936730a1e356b20f78", "srcset": "https://si.imgix.net/bb2896e2/uploads/origins/8b97063f-94b7-418d-901d-c65a8e7e605e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c23abe1658d1b3936730a1e356b20f78, https://si.imgix.net/bb2896e2/uploads/origins/8b97063f-94b7-418d-901d-c65a8e7e605e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0dc1c5ea06687e09e643e253ba62111e 2x, https://si.imgix.net/