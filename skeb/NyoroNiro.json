": 2530669, "client_id": 2508464, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c71909ff/uploads/origins/681ae0e2-7208-47d7-8ad6-d32637cbdca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eb9cbaf1c299e82f4861f446a57f0f1b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c71909ff/uploads/origins/681ae0e2-7208-47d7-8ad6-d32637cbdca8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ea19e2dd62672e8d68c758807c6c592", "src_set": ""}, "body": "初めまして。辰星マキリと申します。\nにろ様のSD作品を拝見し、とっても可愛かったので依頼させて頂きました！\n\n【使用用途】\n・SNS等での使用\n・FANBOXでの使用\n・収益化済みYouTube・Twitchでのサムネイル使用 \n※禁止事項がございましたらPSDデータ内のレイヤーなどでお伝えいただけますと幸いです。 \n\n【要望】\n・衣装やポーズ、構図等はお任せいたします。\n・可能でしたらサムネイルでも使えるよう、キャラクターのみの透過素材もご用意いただけると大変助かります。（PSDファイルなど） \n\n以上となります。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1o7YFrOMbSlEKtpWDlhsxMjpuzxrtI4w3?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NyoroNiro/works/44", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c478f32/uploads/origins/e90bf1e7-8994-4300-bf6f-169da05c8bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da8918fcb5947ad304a401f7bc54e641", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2530669, "client_id": 479242, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@NyoroNiro/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2530669, "client_id": 1032595, "vtt_url": null, "thumbnail_image_urls": {"src": 