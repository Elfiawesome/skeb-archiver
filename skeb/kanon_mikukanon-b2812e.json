-4965-874a-6ce50df10bac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55252122baf90fc694369e2ce8f9e5ae, https://si.imgix.net/6c05903b/uploads/origins/4bf7616e-d852-4965-874a-6ce50df10bac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b89bf3a1b984efedaed807d02b2bb479 2x, https://si.imgix.net/6c05903b/uploads/origins/4bf7616e-d852-4965-874a-6ce50df10bac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a685dacd687938cda3596ba343f67925 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c05903b/uploads/origins/4bf7616e-d852-4965-874a-6ce50df10bac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05b7aaa4f69bcbdf5368fb5f1c861aa0", "srcset": "https://si.imgix.net/6c05903b/uploads/origins/4bf7616e-d852-4965-874a-6ce50df10bac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05b7aaa4f69bcbdf5368fb5f1c861aa0, https://si.imgix.net/6c05903b/uploads/origins/4bf7616e-d852-4965-874a-6ce50df10bac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=131b67361135e5b7feeb477927127450 2x, https://si.imgix.net/6c05903b/uploads/origins/4bf7616e-d852-4965-874a-6ce50df10bac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=346d9d7ea700bde264d37c8792a807fe 3x"}, "body": "はじめまして、Vtuberの紬華ミキです。\nリクエストで私を描いていただきたいです。\n配信や動画を見ていただき、奏音さんのイメージで描いてください。\n完成したイラストは#miki_artを付けてTwitterに投稿していただきたいです。\n\nまた、イラストはアイコン、もしくはヘッダー画像、配信用のサムネイルに使わせていただきます。商用利用はいたしません。よろしくお願いします。\n\nhttps://www.youtube.com/c/mikichandesu", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanon_mikukanon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1179250, "client_id": 1271668, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa27822f2e34a80297607252051c8b1c", "srcset": "https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa27822f2e34a80297607252051c8b1c, https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60ab0004c181c65636171778ad7d01e3 2x, https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ccca61c3eec597062ad5958de651894 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0627d164da2292f3f7d48fd027e4e724", "srcset": "https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0627d164da2292f3f7d48fd027e4e724, https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f4757d14544865ad614ccca6be75682 2x, https://si.imgix.net/ca919c51/uploads/origins/f9c9ce00-350d-42bd-afbf-9f73240b8d40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9407426069330863a753036f764f95bf 3x"}, "body": "初めまして！\n奏音様のデザインされたDream Layerのステージ衣装を始め可愛いミクさんのイラストを拝見しております。\nツイッターのつぶやきを見て、奏音様の描かれる地雷系の女の子を見たいな！と思ってリクエストさせていただきました。\n（ボカロ関係のサムネではないので恐縮ですが…）\n\nもしよかったら私が活動しているVTubeで地雷系の女の子イラストを描いていただけないでしょうか。\nポーズやシチュエーションに細かい指定はなく、アクセサリーや衣服、髪型などもアレンジしていただけたらと思います。\n\n性格はとても怖が