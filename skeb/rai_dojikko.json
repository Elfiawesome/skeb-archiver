2&fit=crop&crop=top&w=200&h=200&blur=200&s=267dde21bb61cfe2cd5818b2ecebee9e 2x, https://si.imgix.net/bfa2154e/uploads/origins/ab49cade-a122-485d-b2b0-c558b8710a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c0c7a8bfd877a5f90261e2b7986ab76 3x"}, "body": "はじめまして。\n木本らい様の描かれた同人誌「キワドい水着も服の上ならＯＫでは？」\nを見て、リクエストさせて頂きました。\n\n依頼内容は\n私服(ノーマルカードのポロシャツとチェックのスカート)\nの上から競泳水着(SSレアカードのノーブルヴィーナスの水着)を着て\n恥ずかしがっている新田美波のモノクロイラストです。\n\n以上、お忙しいと思いますが、よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rai_dojikko/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 803555, "client_id": 14449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=587c186fb97e9dc97bf4c0d42e11da03", "srcset": "https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=587c186fb97e9dc97bf4c0d42e11da03, https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88ce150b3ecd236868a5f52645f9d6b0 2x, https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1192fd3ef6522f526772ac9eae6867c2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=367288ef0b377f9c49e566be009faf2b", "srcset": "https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=367288ef0b377f9c49e566be009faf2b, https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1dfb483ade568ba089484e1d009e9d17 2x, https://si.imgix.net/861d5253/uploads/origins/aac3baf8-c93f-4c7e-b87e-39bd5a074473?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9aec41dea78d5efaf86568145e506d58 3x"}, "body": "相原雪乃さんがサウナで座ってゆっくりしてるイラストをお願いします。\nイメージは\n・アングルはなるべく近め。膝から下はなくて大丈夫です\n・暑いけど気持ちよさそうにしてる感じ\n・白いバスタオル(薄い)を身体に巻いてるけど、水気や汗で肌に張り付いてほぼ透けている\n・下の毛は生えてる\n・髪型はお任せします。\n\n\n凍結から帰ってきてくださりありがとうございます。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rai_dojikko/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 803555, "client_id": 14449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91e966a0/uploads/origins/27212b19-fa2e-4ffd-abd9-367f32ed34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd63ad1c1e082821991b01ba94bacc66", "srcset": "https://si.imgix.net/91e966a0/uploads/origins/27212b19-fa2e-4ffd-abd9-367f32ed34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd63ad1c1e082821991b01ba94bacc66, https://si.imgix.net/91e966a0/uploads/origins/27212b19-fa2e-4ffd-abd9-367f32ed34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a790b202038fdf242bdaf3d76eb02296 2x, https://si.imgix.net/91e966a0/uploads/origins/27212b19-fa2e-4ffd-abd9-367f32ed34eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb7207644eaabcaa510836201b55c9a1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91e966a0/uploads/origins/27212b19-fa2e-4ffd-abd9-367f32ed34eb?bg=%23fff&auto=form