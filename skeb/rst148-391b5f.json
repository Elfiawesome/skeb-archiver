のリンクを添付いたします。\n歌や雑談、ゲームの配信をしており、センシティブな活動内容は一切ございません。\nhttps://twitter.com/GC_melliaC\n\nお忙しいところ恐縮ですが、ご縁がありましたらぜひよろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rst148/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1098187, "client_id": 2794496, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5-8b7b-99e78034a1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ea5090b6aafa9aef0a02c01e34e88af", "srcset": "https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5-8b7b-99e78034a1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ea5090b6aafa9aef0a02c01e34e88af, https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5-8b7b-99e78034a1be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed55dca6b3d614428f07dd5edfe3bd77 2x, https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5-8b7b-99e78034a1be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d62697c97c7cbab1d030112680bf2447 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5-8b7b-99e78034a1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c0bc55893636ea8662ababe7cd0d8fe", "srcset": "https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5-8b7b-99e78034a1be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c0bc55893636ea8662ababe7cd0d8fe, https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5-8b7b-99e78034a1be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b73619459bf427ef00cfaea3917050d 2x, https://si.imgix.net/3f5ad08e/uploads/origins/e7e2903e-eb8a-46c5