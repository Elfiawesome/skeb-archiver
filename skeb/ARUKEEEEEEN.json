dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c490b12245b87fb37fec335b3e58a3f 3x"}, "body": "オーバーウォッチ2のキリコを横ペタにしてバリエーション追加でお願いしたいです。\n\nスチームローラーで轢かれた後の広げた姿を見てみたいです。\n\n腕を上げて両手を広げ、足を組んで、表情は心配そうに照れているような感じ。\n\nあと、服の前を横にずらして股間を見せてほしいです。\n\nさらにバリエーションとして、首を上に剥き、同じく剥いた腕が波打っているのを戸惑いながらも恥ずかしそうに見ている様子を表現してほしいです。\n\nもう片方の腕は、手が地面から剥がれようとしていて、指だけが剥がれている。\n\n片方の足も地面から剥がれようとしている。\n\nどんな意味があるのか、簡単なスケッチをし、彼女のリファレンスをいくつか載せました[ https://www.dropbox.com/sh/pqx1nieoh5xvscz/AACP6KfR3D7Ftia7H5YrR-HPa?dl=0 ]。\n\nありがとうございました。お気をつけて!", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ARUKEEEEEEN/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 242203, "client_id": 126622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99645ee6/uploads/origins/3b92dd43-ba8e-4ee7-83f1-f3bfc845b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8614f4231daef9386f5cbf096ce867d", "srcset": "https://si.imgix.net/99645ee6/uploads/origins/3b92dd43-ba8e-4ee7-83f1-f3bfc845b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8614f4231daef9386f5cbf096ce867d, https://si.imgix.net/99645ee6/uploads/origins/3b92dd43-ba8e-4ee7-83f1-f3bfc845b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=791c52bffe9d5256281e8ed450b4e7b8 2x, https://si.imgix.net/99645ee6/uploads/origins/3b92dd43-ba8e-4ee7-83f1-f3bfc845b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=27c9ac897f8e6bbccc13305dc345be44 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99645ee6/uploads/origins/3b92dd43-ba8e-4ee7-83f1-f3bfc845b2d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04395b90dc02893a6ed867f13d9546d3", "srcset": "https://si.imgix.net/99645ee6/uploads/origins/3b92dd43-ba8e-4ee7-83f1-f3bfc845