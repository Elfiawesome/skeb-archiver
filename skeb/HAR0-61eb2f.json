f408cb93c74b 2x, https://si.imgix.net/04d871d7/uploads/origins/25d18f55-560e-4236-b536-13a8854347e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=664d232a853b5371c2e03e4e13521382 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04d871d7/uploads/origins/25d18f55-560e-4236-b536-13a8854347e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be6a6e14a20656795a4c3bc4a9cc988a", "srcset": "https://si.imgix.net/04d871d7/uploads/origins/25d18f55-560e-4236-b536-13a8854347e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be6a6e14a20656795a4c3bc4a9cc988a, https://si.imgix.net/04d871d7/uploads/origins/25d18f55-560e-4236-b536-13a8854347e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fc752447c085b49305dfe3a1d9ba9c5b 2x, https://si.imgix.net/04d871d7/uploads/origins/25d18f55-560e-4236-b536-13a8854347e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec75bccfbd25be0c552d141f75ce47ba 3x"}, "body": "はじめまして！\nTwitterで素敵なイラストを拝見し、私のキャラクターのイラストを描いていただきたいと思いリクエストしました。\n\nリクエストしたいのは、私が自身の創作活動を行う際に使用している「ことはまきゆ」というアバターです。\n『90年代インターネットの海からやってきた集合的無意識に遍在するインターネットゾンビ』で、多くの場合メイド服を着て、青と紫のパーカーを羽織っています。\n毛先から青→ピンク→黄色のグラデーションがかかった、ウェーブしたショートヘアと、なんらかの形状のメガネが特徴です。瞳の色は不定です。\n\n一応上記のような設定がありますが、HARO様の衣装デザインや画面構成が大変素敵なので、『ホワイトブリムとメガネを装着している』以外の外見・服装、また構図等も含め、自由に描いていただけると嬉しいです。\nまた、性別についても特に設定がないので、自由に描いていただきたいです。\n以下は参考画像です。\nhttps://drive.google.com/drive/folders/1impxySKmbvTeaRg-NpSJkVBTOVlOqe-V?usp=sharing\n\nまた、その他の参考として、以下のようなモチーフがあります。\n・青い花\n・青いアゲハチョウ\n・グリッチノイズ\n・ヴェイパーウェイブ\n\n以上、よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HAR0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2057169, "client_id": 296717, "vtt_u