ており、たまの休日には女・男物問わず気に入った衣服を着用したり、髪型を変えたりしています。\n\nそんな彼を、HAROさん流にアレンジしていただきたいのです。\n・衣服はテックウェア系統のもの（アークナイツを参考にしていただけるとわかりやすいかもしれません）\n・髪型は上記の衣服に合わせたアレンジ\n・ポーズはお任せ\n以上の希望を添えリクエストします。\n\n先生の描かれるイラストの色・筆使い、センスが大好きです！最近アップされたイラストでは女体化ライトニングがドストライクでした！\nよろしければ御一考ください。よろしくお願いします。\n\nhttps://twitter.com/egri__/status/1532325799222968320?s=21&t=z87mo8YFxsRnwIWmjOvQRw", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HAR0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2057169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b33bbd2/uploads/origins/947ca402-ae49-4aaa-b173-e33af5a39880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=598ce7ae47262db06867b538a53e737e", "srcset": "https://si.imgix.net/0b33bbd2/uploads/origins/947ca402-ae49-4aaa-b173-e33af5a39880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=598ce7ae47262db06867b538a53e737e, https://si.imgix.net/0b33bbd2/uploads/origins/947ca402-ae49-4aaa-b173-e33af5a39880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa1963a4c84232aa83fedb8a3bb79fa9 2x, https://si.imgix.net/0b33bbd2/uploads/origins/947ca402-ae49-4aaa-b173-e33af5a39880?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c30111d88ff0f1187465378a0603a86 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b33bbd2/uploads/origins/947ca402-ae49-4aaa-b173-e33af5a39880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c9a42ee44ddab72c607b56ad618f2aa", "srcset": "https://si.imgix.net/0b33bbd2/uploads/origins/947ca402-ae49-4aaa-b173-e33af5a39880?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c9a42ee44ddab72c607b56ad618f2aa, https://si.imgix.net/0b33bbd2/uploads/origins/947ca402-ae49-4aaa-b