=top&w=200&h=200&blur=200&s=c3c4f47f15f09b63c0b2071ac5611648", "src_set": ""}, "body": "リクエスト失礼致します。\n\n自キャラのムンキ猫をお願いしたいです！\n以下装備詳細です\n\n頭　魔戒弓師の頭具・陰：チェリーピンク \n胴　アスレジャー・スーパークロップシャツ：①デフォルト（いわゆる黒）②チェリーピンク \n手　クロウ・オブ・ビースト：メタリックブルー \n脚　アイルファーマー・カットオフボトム：①スートブラック②チェリーピンク \n足　ブラックボゾム・ブーツ\n首　クリスタリウム・レンジャーチョーカーRE\n耳　ゼロオーダー・イヤリング\n\n\nhttps://drive.google.com/drive/folders/1xU1wlJw-vjUguTlVmNZOUp890293hF2y\n\nアクセサリーは省略OKです！（指も何か着けていますが無いものとしてください）\nポイントは胸元の空いたトップス、長めのネイル、オッドアイ、ピンク色のちょいメッシュです！\nリンク先にミラプリの画像と髪、目のRGB値が載っている画像がありますので参考にどうぞ！\nポーズや表情、構図はお任せします。（ネイルが写っていると喜びます）\n体の肉付き（特に胸や太もも）はふわっともちっと盛って頂けるととても刺さります。\n\n前回のスケブチャンスを逃してしまったので…今回は何卒！！どうぞよろしくお願い致します！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YmakinaR/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/00f59d87/uploads/origins/b5c4288d-3706-44f0-87cf-d070c260ab7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bcff6546cea515847d5fabb883b97249", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3536245, "client_id": 472004, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@YmakinaR/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3536245, "client_id": 2912542, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5690fd1b/uploads/origins/6e46cb42-8340-412a-b9db-a7b5bc09fc09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c7a5650842b48807d4bdae8feeb82c4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5690fd1b/uploads