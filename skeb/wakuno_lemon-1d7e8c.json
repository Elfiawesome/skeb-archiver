8799100718e8ddd51cec62dddf9, https://si.imgix.net/7612183b/uploads/origins/cfc9826e-e4e2-4874-b570-dbc04d7510eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=312362a96ab22376e05e63dbd9936d9a 2x, https://si.imgix.net/7612183b/uploads/origins/cfc9826e-e4e2-4874-b570-dbc04d7510eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5455b968aaaf15bd33081e942c77be3 3x"}, "body": "こんにちは！\n あなたのプリキュアとドレミの絵が大好きです。\n私は数年前からあなたの絵の大ファンなので（特にあなたのプリキュアとドレミの絵）、あなたに依頼したかったのです。\n他のおジャ魔女どれみファンやプリキュアファンと繋がるのはとても素敵なことです🫶。\n私のおジャ魔女ocヘーゼルをやってくれませんか？彼女はとても気立てが良くて、エネルギッシュな女の子で、気が強い性格なので、遠慮なく描いてください^ ^。\nまた、皆さんのファンアートで髪を出すのが好きなのをよく見かけるので、髪を出した私のocをやってもらえますか（リンクで紹介する御子神リコの髪を出したように、とても似ていて長いです）。\n彼女の兄はトビー・マグワイアのスパイダーマンなので、もしスパイダーマンを参考にしたいのであれば、自由に追加してください（自分でポージングなどをしたいのであれば、スパイダーマンのぬいぐるみをやる必要はありません。)\nまた、彼女の妖精も自由に追加してください。\n\nありがとうございます!\n\nhttps://drive.google.com/drive/folders/1PpE0wjCKYdhK13T_pYwnYaCdgPTlU414?usp=sharing\n\nhttps://drive.google.com/drive/folders/1PpE0wjCKYdhK13T_pYwnYaCdgPTlU414", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wakuno_lemon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3673706, "client_id": 1431040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/321b6e86/uploads/origins/2eb50280-fc71-483e-a713-b8708e33b98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5af926144affc522c655a74f88d1114", "srcset": "https://si.imgix.net/321b6e86/uploads/origins/2eb50280-fc71-483e-a713-b8708e33b98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5af926144affc522c655a74f88d1114, https://si.imgix.net/321b6e86/uploads/origins/2eb50280-fc71-483e-a713-b8708e33b98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d1c5641da93772a2e3e2e60c400a268 2x, https://si.imgix.net/321b6e86/u