にじさんじ  レオス・ヴィンセント\n\n■希望シチュエーション\n夜のコンビニに買い物に行くレオス博士とまめねこを描いていただきたいです。\n配信で、ファミマの野菜スティックを買って食べた等話すことがあり、自分と地続きの世界で生きていることを感じられ、嬉しい気持ちになることがあります。\n\nシチュエーションの指定が不可であれば、構図等は全てお任せいたします。\n何卒よろしくお願い致します。\n\nhttps://www.nijisanji.jp/talents/l/leos-vincent", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 651410, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ナオ｜Illustrator", "screen_name": "naaa_195", "avatar_url": "https://pbs.twimg.com/profile_images/1766121700746555392/SSH5djox.png", "header_url": "https://pbs.twimg.com/profile_banners/1217451575007801345/1695630502/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 778206, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "파 11/4停止します", "screen_name": "oh_misstake", "avatar_url": "https://pbs.twimg.com/profile_images/1551029481933926401/FGVH81oN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1229306054527180800/1633029409/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1364545, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "おみょ", "screen_name": "omyo", "avatar_url": "https://pbs.twimg.com/profile_images/1813677792757944320/2aghRs0F.png", "header_url": "https://pbs.twimg.com/profile_banners/1015952988907581442/1704042708/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "