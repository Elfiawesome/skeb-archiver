n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@narusegoirai/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3741171, "client_id": 2961431, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0613ad22/uploads/origins/f4d0e195-be3f-492d-a3a5-06fe13286cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09754325e9c3f4f842520dacbdc2fb29", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0613ad22/uploads/origins/f4d0e195-be3f-492d-a3a5-06fe13286cbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1556844efc96a9db443b8a79a3efbc1a", "src_set": ""}, "body": "こんにちは！アピールありがとうございます！私のOC（https://i.imgur.com/xP6A5F6.jpeg、青い目、茶色の髪、大きな胸、色白の肌、赤いリボンとメガネをかけています）と、軌跡シリーズのキャラクター「ルーファス・アルバレア/ルーファス・アルバレア」（https://imgur.com/a/MyJahhV、お好きな服を選んでください）のイラストをお願いしたいです。\n私のOCは、https://i.imgur.com/V43hv4G.png と似たような服を着ているはずですが、髪飾りはありません。\nルーファスは私のOCをとても独占欲が強く、とても愛しています。私のOCは穏やかで優しいお姫様です。  \nOC = 153センチ\nルーファス＝188cm\nよろしくお願いします！必要であればお値段の調整もお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 478244, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "秋入梅せら", "screen_name": "seratanmen", "avatar_url": "https://pbs.twimg.com/profile_images/1504056213637459968/qyZqQBgZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3099791912/1662267429/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"