d8/uploads/origins/f88f45ea-5d82-4737-8bf3-d677389b3e68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4eda5fb44e945844d154555c60235703", "srcset": "https://si.imgix.net/c47fc9d8/uploads/origins/f88f45ea-5d82-4737-8bf3-d677389b3e68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4eda5fb44e945844d154555c60235703, https://si.imgix.net/c47fc9d8/uploads/origins/f88f45ea-5d82-4737-8bf3-d677389b3e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e700e319a521607387ac70f395d39852 2x, https://si.imgix.net/c47fc9d8/uploads/origins/f88f45ea-5d82-4737-8bf3-d677389b3e68?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1921f7d254ebb7f4a608c422827c4d7f 3x"}, "body": "はじめましてま北さん、ヒョウガです。\n今回はま北さんにリクエストしたいイラストがありまして、もしよろしければお願いします。\n\n今回のリクエストしたいキャラはskimaで迎えた男の子、\n詳細な設定はまだですが、DS4年生でちょっとドジな子。\nキャラの外見は下記のサイトに参考にしてください。\n\n今回の依頼内容はこの子のカラーイラストです。\n日常生活や学校内の出来事をイメージにした作品をま北さんにお願いします。\n\nキャラの背景透過と未統合PSDファイルの提供が可能でしたらお願いします。\n出来た作品(キャラ)は個人用のSNS関連のアイコンなどと個人使用予定や\n他のクリエイターに描いていただくこともございます。\nご検討のほどお願いいたします。\n\nhttps://skima.jp/dl/detail?id=88910", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@makita_tyami/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3084623, "client_id": 227300, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e42f9caf/uploads/origins/1f52874c-43b0-48ff-949d-336213bed18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e48f1698951ac89b8d24f314ad9c58", "srcset": "https://si.imgix.net/e42f9caf/uploads/origins/1f52874c-43b0-48ff-949d-336213bed18b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3e48f1698951ac89b8d24f314ad9c58, https://si.imgix.net/e42f9caf/uploads/origins/1f52874c-43b0-48ff-949d-336213bed18b?bg=%23fff&auto=format%2Ccompres