streamerの藪内ぱんだと申します。\n\nXにてAnoyo様の素敵なイラストを拝見し、ゆるskebの募集をされていたので\n今回リクエストをさせていただきました！！！\n\nリクエスト内容は藪内ぱんだの少しセクシーなイラストを描いていただきたいです...!\n衣装や構図、ヘアアレンジ等はお任せします!(肉感は少し盛っていただけますと幸いです...!)\n衣装をそのまま描かれる場合はXにて使用しているイラストタグを参考にしていただけますと幸いです。\n\nイラストタグ #ぱんだのお宝画廊\n\n・使用用途\n配信活動(SNS投稿等)に使用させていただきたいです。\n\n・納品形式\n金額の範囲内で可能であれば人物データと背景、宛名が分かれているPSDでの納品希望です\n\nお忙しいとは思いますが、ご検討の程何卒よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Anoyoskeb/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3169809, "client_id": 40605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbef95b747126cace62beccbc3ed5025", "srcset": "https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbef95b747126cace62beccbc3ed5025, https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bfca8e34846ee8a70815e32da8d67b02 2x, https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10af8c8efaa92bb47e55293242510604 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f1e3e993ce4ddc2bc01510c7bf2646", "srcset": "https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b0f1e3e993ce4ddc2bc01510c7bf2646, https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3741eabed655749e5889b5749b9b75ff 2x, https://si.imgix.net/e5429061/uploads/origins/002f372d-1e53-4b21-9ef4-fe7c5ff90aa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d89012f8c495f5881d7acae85285e84a 3x"}, "body": "Anoyo様初めまして。\nVtuberとして活動しております蒼唯レンと申します。\nいつも素敵なイラストを拝見させていただいております。この度は自身を描いていただきたいと思い、ご依頼いたしました。\n\n衣装などの参考資料はこちらからご確認お願いします。\n描きやすいように髪型などアレンジしていただいても問題ありません。\nhttps://twitter.com/Ao1_Len/status/1652257303050207232\n表情・構図・ポーズなどはお任せいたします。\nSNSのアイコンやサムネイルなどで使わせていただきたいと思っていますので、お手数ですが可能であれば透過差分もしくはレイヤーを分離したpsdにしていただけると助かります。\n\nそれではご検討のほど、よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Anoyoskeb/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3169809, "client_id": 1523235, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f9987c9/uploads/origins/4938e528-ce4f-418f-bfc2-ca3a4a07e331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=978fe80f67fe85684ba5d93e5ac900e9", "srcset": "https://si.imgix.net/9f9987c9/uploads/origins/4938e528-ce4f-418f-bfc2-ca3a4a07e331?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=978fe80f67fe85684ba5d93e5ac900e9, https://si.imgix.net/9f9987c9/uploads/origins/4938e528-ce4f-418f-bfc2-ca3a4a07e331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc38dd892aa151ee7a503378d68ae6c5 2x, https://si.imgix.net/9f9987c9/uploads/origins/4938e528-ce4f-418f-bfc2-ca3a4a07e331?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a970f4a83a22f69f48817d975f6a563 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f9987c9/uploads/origi