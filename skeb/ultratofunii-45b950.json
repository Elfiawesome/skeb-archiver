p&crop=top&w=200&h=200&s=afa30422061828c8c20f00c6dbddd82d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7163e7d9/uploads/origins/9b786dad-c97e-4720-b7a2-5c294b5d24a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3af05e3067b370cdfce504b436725589", "srcset": "https://si.imgix.net/7163e7d9/uploads/origins/9b786dad-c97e-4720-b7a2-5c294b5d24a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3af05e3067b370cdfce504b436725589, https://si.imgix.net/7163e7d9/uploads/origins/9b786dad-c97e-4720-b7a2-5c294b5d24a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=77349220b5bfeb3890971b5c040f4939 2x, https://si.imgix.net/7163e7d9/uploads/origins/9b786dad-c97e-4720-b7a2-5c294b5d24a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3db6fb11d7a92c875f432cb81116141 3x"}, "body": "こんにちは！\n宇崎家（花、柳、月）のシークエンスをお願いします。\nあなたが描いたオードリー／アルヴィスの漫画のように、シャツがどんどん伸びていくようなアイデアです。\n\nある日、はなはブラジャーが大きくなりすぎて、月ちゃんに彼女のブラジャーを使うように頼む。その翌日、柳が同じ悩みを母親に相談する。しばらくすると、花も柳もまた大きくなったことを月ちゃんに報告し、月ちゃんをがっかりさせる。二人とも月より大きいので、彼女は毎回二人に大きなブラジャーを買い与えなければならない。このようなことがさらに2、3回繰り返され、姉妹の成長が、家の中のちょっとした場面（テレビゲームをしたり、朝食の食卓についたり、部屋でごろごろしたりなど）で描かれる。\n\n最後は3人で温泉に入り、月が花と柳と浮き輪に挟まれるシーンで終わる。最後のサイズはお任せします。）ありがとうございました！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 974255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e114a1d3956e846724c36409b7390be7", "srcset": "https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e114a1d3956e846724c36409b7390be7, https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=222b114b63cf015396fc9b013f96b2c8 2x, https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f3dea6888c9339d3a1fce620c43ceed 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6874bc7d998e52359befa921ed486a62", "srcset": "https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6874bc7d998e52359befa921ed486a62, https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8160c07ddc1ab32b9fcebc64e8aabe7 2x, https://si.imgix.net/1f287115/uploads/origins/d8f0a3e0-dc65-4715-9d18-05997f1711fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a19fb7abe9f4dd961c06f91369edb1a 3x"}, "body": "こんにちは！プリズマ☆イリヤのイリヤ、ミユ、クロをフィーチャーした作品のリクエストです。リビングルームでゲームをしている。ミユとクロはソファに座っている。視点はテレビから。クロの胸は膝の上に乗るほど大きく、その上に腕を置いて裸のオーバーオールを着てドヤ顔でコントローラーを持っている。ミユの胸は小さめだが、コントローラーの前に手を伸ばしてコントローラーを持つのがやっと。彼女はノースリーブのパーカーを着ている。イリヤはソファーの後ろで巨大なお手玉のような胸の上に横たわっている。彼女はシャツを着ていますが、オッパイをまったく隠していません。彼女は怒ってクロを指差しています。もし可能なら、ソファの上の2人の女の子のクローズアップを1つ作って、その後ろにあるオッパイの壁と胸の谷間が少し見えるようにして、それからイリヤとシーン全体が見えるワイドショットを作ってもらえますか？", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 974255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b5bc23efec7b597d8c32113c194750e", "srcset": "https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b5bc23efec7b597d8c32113c194750e, https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afdf97dc9cd7db8c3fc221c481b2a6db 2x, https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b7048828b67f972951e9eee9ef5fb728 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56aa95e86024cc12d5b9d029ef04f467", "srcset": "https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56aa95e86024cc12d5b9d029ef04f467, https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04780432179f0e635fecd6f152655108 2x, https://si.imgix.net/6227e6a1/uploads/origins/54fcd61c-4401-45ef-8a5c-1bb0c89dc111?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e6effdebc34bd05a74b8e7bd06d64e87 3x"}, "body": "ポケモンのハルカ、メイ、セレナ\n\nビーチの更衣室にやってきた3人の女性。海水浴客にいい印象を与えたい彼女たちは、それぞれ怪しげな成長薬を飲む。それから数分後、薬はそれぞれの女性にいくつかの効果をもたらす：\n\n* 全身に快感を感じ、徐々にオーガズムに近づいていく。\n\n* オッパイが膝に届くほど大きくなる。\n\n* 身長が適度に伸びる\n\n* お尻と太ももが少し大きくなる\n\n女性たちは最大サイズに達すると、一緒にオーガズムを達成し、かろうじてフィットするビーチウェアに身を包み、新しい体を見せびらかすためにビーチへ歩き出す。\n\nロッカールームで3人の女性が一緒にこの成長を体験しているコミックをリクエストしたい。この成長過程こそ、彼女たちを熱狂させる彼女たちの狙い通りだ。また、彼女たちが一緒に水着に着替えてビーチに出かけていく姿も見てみたい。\n\n衣装、シーン、詳細は先生次第です。ありがとうございました！", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 974255, "client_id": 2758563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970afa80a311877e369270ea31787b11", "srcset": "https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=970afa80a311877e369270ea31787b11, https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fc998efcc2c18b9e7ae144f15f86a83 2x, https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3c6f63fa280912c3a5b9ed0f4866a270 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4117f8c8952920b6e85f5e9dc8175234", "srcset": "https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4117f8c8952920b6e85f5e9dc8175234, https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7348c3ee093615687534a7e132df3729 2x, https://si.imgix.net/55164f67/uploads/origins/c3942a2b-02a1-4ad3-af10-ace5a89d3013?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd019d4d9ab69abc8025861c5b7c048d 3x"}, "body": "こんにちは、ウルトーニ。私のカリスタを描いてほしいわ！  あなたの胸の膨らみの描き方が大好きです！膨らんでいる途中の、恥ずかしがっている彼女を描いていただけませんか？彼女は錬金術師でコーヒーショップを経営しているので、うっかりコーヒー飲料の代わりに薬を飲んでしまって、今はミルクでいっぱいになっているのかなと！\n\nhttps://kallista.carrd.co/#reference", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 974255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a455b9f5a578609a8a4753949d01314c", "srcset": "https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a455b9f5a578609a8a4753949d01314c, https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f28e881c45c144d9374e058abcf23ed5 2x, https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7a82017ae578ab45014b5178dbf0e3f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c43c4023b507f3d65563d45bbfaab14d", "srcset": "https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c43c4023b507f3d65563d45bbfaab14d, https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4776019c0caccee8e00fcdd2f65f4f61 2x, https://si.imgix.net/b5fd6e27/uploads/origins/861488cc-e590-4a28-8d89-7d5b1fb30fa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=344720a5af5a3332835c3f66a3fdb966 3x"}, "body": "こんにちは！シークエンスのリクエストです：ブルーアーカイヴのいづなは、楓の胸がうらやましく、忍者の巻物などを使ってバストを大きくする。最初は喜んでいたが、おっぱいは大きくなり続け、シークエンスでは、おっぱいが大きくなるにつれて、彼女が日常の仕事をこなすのが難しくなっていく様子が描かれる。進行の例：\n1.机や本の上に置いて読むのが困難になる。\n2.おっぱいが大きすぎて、先生をうまく抱きしめることができない。\n3.手を合わせて忍者サインを作ろうとするが、自分のおっぱいの周りに手が届かない。\n4.おっぱいをよけようとして、おっぱいにつまずく。\n(自由に追加してください）\n最終的には、L2Dから先生と一緒にボートに座るが、彼女のおっぱいはボート全体を占め（少し横からこぼれる）、先生はその反対側で胸の谷間に押しつぶされている。\n最後に、楓も湖にいるのですが、彼女のおっぱいがボート全体を占領しています（そして、彼女自身は3つ目のボートか浮き輪か何かに座っているのでしょう(笑)）。\nありがとう！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 974255, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ffab9d1792853833bf4ae45bbc0169", "srcset": "https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2ffab9d1792853833bf4ae45bbc0169, https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef9d5ff0336f3ae8a8976cc9d1edb31d 2x, https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=159a8ca36b55fca9d24aafb6908ca25f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d8db5855075533b1121db7830ae0a69", "srcset": "https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d8db5855075533b1121db7830ae0a69, https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b08d9c0f12cfa174f0ca391365da8d74 2x, https://si.imgix.net/366819d7/uploads/origins/b9639c89-63a7-4c53-8cec-3134da54f3d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b35338780f079b6373d6b107ccd849d5 3x"}, "body": "URL の女の子は、特別な「バストアップ」ジュースがたくさん入った箱を持っています。彼女はそれらのいくつかを使用して、すぐに学校で一番の巨乳の女の子になりました。それ以来、彼女は時々追加のボトルを飲み、楽しみのために大きくなります。ベッドに座り、シャツとブラを脱ぎ、特製ジュースを飲む女の子を描いてください。その後、彼女のおっぱいはゆっくりと 50% 大きくなり、オーガズムに近い状態で次の数分間を過ごします。おっぱいの成長はとても楽しいものです。彼女のゆっくりとした成長を数枚の絵で描いてください。成長が完了すると、新しいサイズに満足しているように見えるはずです。この後、必要に応じて、自由に追加のジュースを飲ませて、さらに大きく成長させてください。彼女が意図的にそうし、成長の快感を楽しんでいる限り、成長スパートの過程で好きなだけ彼女を大きくすることができます。おそらくこれは、短いカラーマンガの形でうまく機能するでしょう。ありがとう！\n\nhttps://imgur.com/a/KPSeYtt", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 974255, "client_id": 707430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0aff6edb/uploads/origins/17c7ca0e-92ef-4e37-b835-6197772cfd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd87235da480f4d723a882148d6bde6e", "srcset": "https://si.imgix.net/0aff6edb/uploads/origins/17c7ca0e-92ef-4e37-b835-6197772cfd7c?bg=%23fff&auto=format%2Ccompress