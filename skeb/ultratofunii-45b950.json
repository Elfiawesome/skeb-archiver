e8a53c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=220dfdd170b5c4827e3b68c436a6ad97, https://si.imgix.net/87aad1bc/uploads/origins/eca18841-26e6-4f99-b0a5-0132e5e8a53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=733dca397953cd9457b58502b95dc29d 2x, https://si.imgix.net/87aad1bc/uploads/origins/eca18841-26e6-4f99-b0a5-0132e5e8a53c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1703d5b456b3f4dd1a29f64c8c666df3 3x"}, "body": "またまたこんにちは！素敵な写真を複数ありがとうございます！\n\n私のキャラクター「ダニ」のショートコミックをお願いしたいです。彼女は身長5cmの狐娘で、ファンタジー世界で泥棒をしています。私は彼女が貴重な魔法の宝石が守られている邸宅に忍び込み、それを手に入れるために警備員の間をすり抜けることを望んでいます。しかし、その宝石を手に入れた後、彼女の胸が大きくなり始める。彼女は逃げようとするが、結局おっぱいが大きくなりすぎてつまづいてしまい、お屋敷全体を埋め尽くすほどおっぱいが大きくなってしまう。\n\n結局、そのせいで彼女は玄関の地面から1.5メートルほどのところに逆さまに吊るされ、心配しながら近づいてくる警備員に自分のおっぱいで支えられている状態になってしまう。\n\n絵を描いてくださった方、リクエストを考えてくださった方、本当にありがとうございました！\n\nhttps://cdn.discordapp.com/attachments/387418784320847874/1057832086154793001/DanniRef_DrGala_on_Twitter.png", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 974255, "client_id": 567993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36afed3e/uploads/origins/6f7a7810-ca33-4253-bd2d-a85c42652a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce4101ebdbe041f1a553a8d869d94ff9", "srcset": "https://si.imgix.net/36afed3e/uploads/origins/6f7a7810-ca33-4253-bd2d-a85c42652a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce4101ebdbe041f1a553a8d869d94ff9, https://si.imgix.net/36afed3e/uploads/origins/6f7a7810-ca33-4253-bd2d-a85c42652a2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6be03ec41a20c97cd485cce34cf15c03 2x, https://si.imgix.net/36afed3e/uploads/origins/6f7a7810-