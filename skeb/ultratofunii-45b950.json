ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f6d4dbd4b37f9f169992265056553d5 2x, https://si.imgix.net/9b7c3cd3/uploads/origins/2460566a-21b5-4a15-8777-26bb72465993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e389922681826bf9acf23f9d6810078 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b7c3cd3/uploads/origins/2460566a-21b5-4a15-8777-26bb72465993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=061f0a618a917ec0cba076d2956d96fc", "srcset": "https://si.imgix.net/9b7c3cd3/uploads/origins/2460566a-21b5-4a15-8777-26bb72465993?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=061f0a618a917ec0cba076d2956d96fc, https://si.imgix.net/9b7c3cd3/uploads/origins/2460566a-21b5-4a15-8777-26bb72465993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84cc94c5752977cd35a5882045cf69d7 2x, https://si.imgix.net/9b7c3cd3/uploads/origins/2460566a-21b5-4a15-8777-26bb72465993?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0860db944dd660b1cc30e9d7f4c4e6ae 3x"}, "body": "こんにちは。\n\n身長120cmのララフェルのオリジナルキャラクターが、青いスラッシーを食べている漫画を描いていただきたいです。スラッシーを飲むと、彼女の胸が膨らみます。\n\n参考画像にあるような、ダークカラーのチュニック姿にしてください。最初は平らな胸かAカップの状態から始まります。\n胸が膨らむにつれてチュニックが張り詰め、谷間がどんどん露わになっていきます。 途中でチュニックを脱ぎ、胸を自由に膨らませる様子も描いてください。\n最終的なバストサイズは少なくとも150cmにしてほしいですが、お好みでさらに大きくしても構いません。\n母乳が出ていても構いません。\n\nhttps://photos.app.goo.gl/HTqZh91ZvMQb2y3E7", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 974255, "client_id": 3524659, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e923a4648397099e9dcc4bc1c0af99d4", "srcset": "https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e923a4648397099e9dcc4bc1c0af99d4, https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8da7f7f112e8c507154783a4596087e 2x, https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12fd154b1478227b77291fcacd568a72 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a84f254727b28f272a2e396683114092", "srcset": "https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a84f254727b28f272a2e396683114092, https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28024e7c08cf4ad9db9e1bf867b6a837 2x, https://si.imgix.net/f25fa0d2/uploads/origins/f0411001-2b7e-448a-971b-acdaa94ceabd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45cd586d7d5392073545ee68c9551c3f 3x"}, "body": "私のソナであるリリーが、数コマあるいは数ページにわたって急速に成長していく様子を描いた漫画や一連のシーンを希望します。どのような形式でも構いませんので、ご都合の良い方法で描いてください。\n\nリリーは身長9フィートのロボット少女で、大きな電力源やその他のエネルギー源の近くにいると、体内のリアクターが反応して制御不能なほど成長し始めます。身長だけでなく、胸やお尻も大きくなります。 彼女は成長すること自体をとても楽しんでいるのですが、そのせいですぐに動揺したり恥ずかしがったりしてしまうため、その喜びを隠そうとします。そのため、制御を失ってそのまま成長し続けてしまうこともよくあります。\n\nそこで、今回の設定として、リリーが廃墟となった発電所を調査している場面を考えています。彼女はスーパーヒーローのような存在として様々な地域を助けているため、この発電所が街の人々にとって危険ではないかと懸念し、調査に訪れたのです。 調査中に何かに手を触れたところ、それは巨大な原子炉だった。触れた瞬間、原子炉が作動し、少女に強烈な衝撃が走った。彼女は一瞬呆然とするが、すぐに自分が急速に成長し始めていることに気づく。その感覚があまりにも心地よかったため、彼女は極度の緊張と動揺を覚える。成長に伴い、服も破れていく。 やがて、彼女は建物よりも背が高くなってしまう。こんなに簡単にそうなってしまったことに少し恥ずかしさを覚えるが、問題が解決したことにほっとし、自分の大きさを楽しんでいる。お好みで彼女を「ウルトラ化」させてください。\n\nhttps://drive.google.com/drive/folders/15uUx6Q3wvAyt7pbetGFklZCgmuYf_SPx", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/37", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 974255, "client_id": 3769253, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3969516bcfea9ecaab9796788c20206a", "srcset": "https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3969516bcfea9ecaab9796788c20206a, https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8467ab14cd3a3938093ba797fc288a21 2x, https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a8a459c95d4e3722c671dc40f11326c4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc6ed2bdf80743ec9edffc28a4fbf3d5", "srcset": "https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc6ed2bdf80743ec9edffc28a4fbf3d5, https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd5a553bc45fde70c766a009072bc373 2x, https://si.imgix.net/8e0aa54e/uploads/origins/4f9ac8a2-7680-4595-9781-8dfea852f736?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0c557ffd2692f741e7f6b824ba4b72 3x"}, "body": "私のオリジナルキャラクターであるルミア・ケントを主人公に、前回の依頼作と同じくグレタ・シュワルツェーガーをサブキャラクターとして、バストアップの連続イラストを作成してください。バストサイズ以外は前回の画像と同じ見た目にしてほしいので、外見の描写は省略します。\nルミアは聡明で冷静、思慮深い女性であり、聖処女から傀儡国家の首長へと転身した、国民を大切にする慈悲深い独裁者です。読書が好きで、仕事熱心です。ルミアは（当初）グレタを嫌っており、「契約」を通じてグレタを利用しているに過ぎません。\nグレタは、偽善的で倒錯的、口が悪いが有能な女性であり、ひどい巨乳フェチだ。彼女は本質的にルミアの「騎士」であり、国家および個人の警護と諜報を担当している。\n\n- 成長は段階的に描くこと。タイムラプスを使用すること。\n- 物語の舞台は冷戦初期。\n- ルミアは自分の体に非常に敏感で、毎日バストサイズを測るようなタイプの人物。\n- 開始時はOカップ（前回のコミックよりかなり小さい）で、最終的には「床に届くが、何とか歩ける程度」になる。\n- (!) 以下の3つのシーンを必ず含めること：個人崇拝のポスター（ルミアは国家元首だ！）、グレタが浴槽でルミアの搾乳を手伝うシーン、リンク先の画像のような移動式自動搾乳機。\n- なぜ胸が大きくなるのか、ある程度理にかなった設定にしてください。自発的なものでなくても構いませんが、ルミアはそれに抵抗してはいけません。例：ルミアが「国の重荷を背負う」よう神々に祈った、など。独自のアイデアも大歓迎です。\n\nそれ以外は創作の自由です。あまり多くはないですが……\n\nhttps://www.pixiv.net/artworks/119555979", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ultratofunii/works/36", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 974255, "client_id": 318928, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87c0101c/uploads/origins/dca98f35-39d0-48e5-91bf-8f47a5b7b50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49948b52dcf84601c3b76860a81b75bc", "srcset": "https://si.imgix.net/87c0101c/uploads/origins/dca98f35-39d0-48e5-91bf-8f47a5b7b50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49948b52dcf84601c3b76860a81b75bc, https://si.imgix.net/87c0101c/uploads/origins/dca98f35-39d0-48e5-91bf-8f47a5b7b50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a52b84b6c6b04