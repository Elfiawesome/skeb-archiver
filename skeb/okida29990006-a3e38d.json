ca56/uploads/origins/c5837180-1b90-4653-84dd-c09806481e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=beb49567fa689201c007b9041188d62f, https://si.imgix.net/9e16ca56/uploads/origins/c5837180-1b90-4653-84dd-c09806481e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83b2f22ee87bea38ee523d20befda8a5 2x, https://si.imgix.net/9e16ca56/uploads/origins/c5837180-1b90-4653-84dd-c09806481e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1182b11c611971478fd6226582361bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e16ca56/uploads/origins/c5837180-1b90-4653-84dd-c09806481e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f4831fe271f2cd00b4e29f38cab4601", "srcset": "https://si.imgix.net/9e16ca56/uploads/origins/c5837180-1b90-4653-84dd-c09806481e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f4831fe271f2cd00b4e29f38cab4601, https://si.imgix.net/9e16ca56/uploads/origins/c5837180-1b90-4653-84dd-c09806481e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d47dbfa829cb9bd7343ccce505391d2 2x, https://si.imgix.net/9e16ca56/uploads/origins/c5837180-1b90-4653-84dd-c09806481e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41559f67ef85df1d2c7e98d33acdcb3b 3x"}, "body": "SSに興味があったのでご依頼しました。\n\nもしよろしければ、うちのOCの「皇すらら」でホラーSSをお願いすることは可能ですか？ \n参考までに設定は以下のとおりですが、舞台背景、その他登場人物等、自由に書いていただいて構いません。\n███\n＜皇すらら＞\n自分はマダマテによって生み出された皇すららのクローンではないかと疑っている。 \nオリジナルは数年前に事故死している。\n無茶なクローニングで蘇らされているため、突然死することも度々あるが、死ぬ度にマダマテにより蘇らされている。\n\n＜マダマテ＞\n皇すららのペットの子犬。\n名前の由来は「待て」が覚えられないことから。\n（実の所は子犬にも見えるだけの兎。兎なので待てが覚えられない。皇すららは子犬と思い込み、そう言い張っている。）\n周囲の生命体を素材に皇すららのクローンを生み出し続ける元凶。\nオリジナルが仲良くしていた者にしか懐かず、その者だけはクローンの素材にされない。 \nマダマテの放つ胞子の影響を受けたものは、アメーバ体と呼称される化け物に変貌する。\nアメーバ体が一定量生み出されると、アメーバ体は一箇所に集合して子実体を形成する。 \n子実体頂部の核内で形成された皇すららのクローンは、急速に成長が促進され、数日ほどで元の姿と記憶を継承して排出される。\nなお、排出される以前の核内での事については個体差もあるが多くのクローンは夢として認識している。\n███\n著作者様のクレジット表記ありでSNSや個人サイト等でのキャラクター紹介等での掲載、コミッション等での朗読依頼等も考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DC54qVFtGUFP-9T0gu-zLkbOKQFZ6TK", "nc": 8, "word_count": 11766, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2216883, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "雨谷とうか", "screen_name": "ameya_ayameya", "avatar_url": "https://pbs.twimg.com/profile_images/1708862724112105472/OmX-9n-u.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1094502757405343746/1585108389/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "novel"}, {"genre": "correction"}], "nc": 145}, {"id": 2487451, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ふみづきかすか（文月幽）", "screen_name": "Fumiduki_Kasuka", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:3lqag4pktmb3dlbkkwl4vsmy/bafkreie6muct3hywzt5gt4ilzgieggc2zajwswi4fhvaxrjqpyfnduhm7m", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:3lqag4pktmb3dlbkkwl4vsmy/bafkreieqiisfts7vcw6qmhvi6puzss4tyzy2i2kc5lvbphmugjqo5e3sqe", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2524911, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柊 秘密子", "screen_name": "himikomiko12", "avatar_url": "https://pbs.twimg.com/profile_images/1653581928782770176/CY9ZHdiI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/145950