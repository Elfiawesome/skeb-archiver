8c6-90e4-280ac4530b10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bbbc9dc44bb311ddf5eea05cf623cc6 3x"}, "body": "こんにちは！\nノギヲさんのイラスト作品、twitterやpixivでよく拝見させていただいています。\n逆バニー競泳水着を始めて見た時は物凄く衝撃を受けました⋯凄く好きです。\n\n今回の依頼に関して、以下のようにお願いしたいです。\nキャラクターは崩壊3rdというゲーム作品のブローニャ・ザイチクさん(大人ver)です。\n(https://drive.google.com/drive/folders/1_BAufjDnkMh0bT6LzMQNUrm57e5uj1rw?usp=share_link)\n\n衣装に関してですが、ノギヲさんが以前描かれていたような競泳水着×装甲逆バニーでお願いします。\nhttps://www.pixiv.net/artworks/81676247\nhttps://www.pixiv.net/artworks/104208071\n\n逆バニーは軽装甲でお願いします。水着を押し上げる胸ぽち状態でお願いしたいです。\n差分で装甲が無い状態もお願いします。\n構図は座っているイラストをお願いしたいです。（https://www.pixiv.net/artworks/104224018\n）\n\n以上となります。よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogiwo/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 439099, "client_id": 2389245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d7d061d244c0e8e5ac13dca15c75048", "srcset": "https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d7d061d244c0e8e5ac13dca15c75048, https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f60e73aedd0c9358a66dd97381bcc66f 2x, https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ee52f93d3bcc297e71edc5f2c5c4519 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ee55b4a7035e597b02f645ed7ef938b", "srcset": "https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ee55b4a7035e597b02f645ed7ef938b, https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=018b0d5069a41cc6457fee6242d6f7fb 2x, https://si.imgix.net/b61c47b2/uploads/origins/2571cf18-3686-4dd7-9377-b9a6530086d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=adcc73ce9b732c0f217168e4993932a7 3x"}, "body": "こんにちは。\n\nうさぎ・メカ風の作品がとても好きです!^^\n\nそこで、もしそのスタイルで男の子を描くことを検討していただけるなら、私のキャラクターであるヴェンナイトを描いていただきたいです。ヴェンナイトは、レジスタンスのリーダーであり、任務を遂行し勝利するために常に戦い、少し「悪」であることを厭わないアライグマの男の子です。\n参考画像はこちら： https://drive.google.com/drive/folders/16M15hcCvgvwmy_xJtkX0Cp60O7Xow7_R?usp=sharing\n\nできれば今の服に近い配色でお願いしたいのですが、よろしければ変更も大歓迎です!あと、武器がカッコイイと最高ですできれば参考画像のように腹筋が見えるようにお願いします（それ以上でも可）。\nポーズはお好みで\n\nもちろん、男の子は描きたくないという方は、遠慮なく依頼を断っていただいて構いません。\n\nありがとうございました。\n禅\n\nhttps://drive.google.com/drive/folders/16M15hcCvgvwmy_xJtkX0Cp60O7Xow7_R?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogiwo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 439099, "client_id": 54516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d70da5d423a111f5391cc143f383c97", "srcset": "https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d70da5d423a111f5391cc143f383c97, https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8305a132d816280d5e51c3fc99fb0743 2x, https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47075db3f7cfcd07dc0f4c04863310d1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=657b45ff339cab32474f9095a91b6175", "srcset": "https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=657b45ff339cab32474f9095a91b6175, https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ada1554b5597f6430c4244defcfbfaa4 2x, https://si.imgix.net/49766e5c/uploads/origins/31c00031-6e4c-466e-a373-269fd080c933?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e46b99ad2f1f95b0fdaa013d393b798 3x"}, "body": "はじめまして。\nTwiiterで逆バニー競泳水着を見て素晴らしいと思いリクエストさせていただきます。\nよければ装甲逆バニー競泳水着を着用したうちの子が敗北レイプされるイラストをお願いします。\n\n\nキャラ：下記URLのうちの子をお願いします。１６歳前後で少し内気な性格という設定です。\nhttps://twitter.com/qualialibrary/status/1335490102768766983?s=20\n\n\n衣装：ハイレグの競泳水着でノギヲさんの作品\nhttps://twitter.com/nogiwo/status/1582641995255726082\nの様に競泳水着に装甲バニーを着せてください。\n競泳水着は長袖で、色は水色を基調として挿色に黄色を入れてください。\nまた、身体の凹凸をなくすために水着のしめつけは強く、胸はつぶれているようにしてください。\n装甲は青色と黒色を基調として、無地ではなく軍属を示すロゴや番号等を黄色で入れたデザインでお願いします。\n\n\nシチュ：敵との戦闘で敗北し、鹵獲され、敵本拠地に輸送される前に前線の倉庫内で輪姦されているというシチュでお願いします。\n装甲部分はあちこちコードが飛び出したりオイルが漏れたりしていて、敗北感があるようにしてください。\n逆に競泳水着部分は破れたり脱がしたりせず、ずらし挿入だけしてください。また、股間部は破瓜の血で少し赤く染めてください。\n姿勢としては両腕をベルトで縛られて頭上に吊るされており、足はM字になるように広げてられて腕と同様にベルトで縛ってください。\nまた、胸や顔、髪にもザーメンをぶっかけられていて、すでに何度もレイプされていることがわかるようにしてください。\n表情は耐えていたのが決壊して泣き叫んで悲鳴を上げているような表情でお願いします。\n\nよければご検討のほどよろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogiwo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 439099, "client_id": 347107, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c315bf1d7d2abbf23fca1d4fee5942c", "srcset": "https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c315bf1d7d2abbf23fca1d4fee5942c, https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0476a28f1c0a0c67936af84915dbd2ed 2x, https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6abb5f28628eb7784d7905013ca7612c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e7895d673009dd2c785738313e0b05f", "srcset": "https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e7895d673009dd2c785738313e0b05f, https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9287c211a7c9760f0ff69b39251693ee 2x, https://si.imgix.net/2be94d82/uploads/origins/9bdec807-7364-4967-ab6c-a2a88ca86777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1299c19f13ae24fcdb89e28773afe1 3x"}, "body": "お世話になっております。また依頼したく思います。\n\n\nキャラはうちの子をお願いします。\nうちの子\nhttps://skeb.jp/@klx230/works/11\nうちの子をデザインしてくれた絵師さんに許可はいただいています。\n\n衣装は前回同様でハイレグの競泳水着でノギヲさんの作品　https://www.pixiv.net/artworks/81676247\nの様に競泳水着に装甲バニーを着せてください。水着を押し上げる胸ぽち状態でお願いします。\n膝から上の描写で大丈夫です。\n今回は軽装甲でお願いします。\n差分で装甲が無い状態もお願いします。\n\n以上となりますがよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nogiwo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 439099, "client_id": 71138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfbd23b3/uploads/origins/898cad30-2239-49fb-8204-eac572d788df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f1edb68860a518f4262f296f0b666f", "srcset": "https://si.imgix.net/bfbd23b3/uploads/origins/898cad30-2239-49fb-8204-eac572d788df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7f1edb68860a518f4262f296f0b666f, https://si.imgix.net/bfbd23b3/uploads/origins/898cad30-2239-49fb-8204-eac572d788df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e3c566e693a96558edcbee9df060cbb 2x, https://si.imgix.net/bfbd23b3/uploads/origins/898cad30-2239-49fb-8204-eac572d788df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=095180690107f15021978f32633b1e6f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfbd23b3/uploads/origins/898cad30-2239-49fb-8204-eac572d788df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98af5a7ca0018a3f480c3ba67b55ac2d", "srcset": "https://si.imgix.net/bfbd23b3/uploads/origins/898cad30-2239-49fb-8204-eac572d788df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98a