ができるかなと思っています。\n例えば、ああいうマスコットキャラ的な可愛くて少しデフォルメされたキャラがお肉を給仕してくれて、乳房の肉、子宮や生殖器付近の肉(牛欢喜)などを皿に盛っていて、それらの肉があったところは切り取られた痕(生傷ではなく、すでに治っている傷痕)があるような、そういう絵が見たいです！\n彼女たちは品種改良されて、自分の肉を切り取られて給仕して食べられることを幸せに感じているから心の底から笑っているし、半ば性的絶頂に近づいているような感じだと嬉しいです。\n全体的にゴアの生々しさは抑えめで、とても生々しくて残酷な描写を可愛さでラッピングするような感じだと嬉しいです。(配膳いぬの加減がとても好きなので、要はあのくらいがいいです。)", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@catwalkkkk/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fdca127c/uploads/origins/0020cf57-aabc-451e-952c-fd37eaa8ffdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9bf23dd43e12934d16300672523a68d", "srcset": "https://si.imgix.net/fdca127c/uploads/origins/0020cf57-aabc-451e-952c-fd37eaa8ffdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f9bf23dd43e12934d16300672523a68d, https://si.imgix.net/fdca127c/uploads/origins/0020cf57-aabc-451e-952c-fd37eaa8ffdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=75b4888cbaeba49415e87eb929af6336 2x, https://si.imgix.net/fdca127c/uploads/origins/0020cf57-aabc-451e-952c-fd37eaa8ffdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6c7bc7d1fd106a5588c79897197970a6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3451052, "nc": 32}, {"path": "/@catwalkkkk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3451052, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf0aa9ef/uploads/origins/54c8126b-57c6-487