t=crop&crop=top&w=200&h=200&s=1423cc01b432867b90f6ad42085da3b2, https://si.imgix.net/bd820755/uploads/origins/6cfab10e-353a-41cc-84fa-264ad89f6ad8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa531349dca15859bd2b5555d7e7557a 2x, https://si.imgix.net/bd820755/uploads/origins/6cfab10e-353a-41cc-84fa-264ad89f6ad8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=191b33172f4e6128c3801a9374cd1db5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd820755/uploads/origins/6cfab10e-353a-41cc-84fa-264ad89f6ad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e1aa26693f87af1bd5a8510bc55a5aa", "srcset": "https://si.imgix.net/bd820755/uploads/origins/6cfab10e-353a-41cc-84fa-264ad89f6ad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e1aa26693f87af1bd5a8510bc55a5aa, https://si.imgix.net/bd820755/uploads/origins/6cfab10e-353a-41cc-84fa-264ad89f6ad8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cee873957636585b6c9b8fd8fed6f151 2x, https://si.imgix.net/bd820755/uploads/origins/6cfab10e-353a-41cc-84fa-264ad89f6ad8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8df48b266274cfa6cf4b70595f5fcbcd 3x"}, "body": "駅メモのファンアートで八日市ゆかりさんを描いて頂けないでしょうか。\n\n画題は雨の日のおでかけが希望です。資料URLに雨の日のセリフを貼っておきますが、雨でも前向きなところが好きなので、楽しげな様子だと嬉しいです。楽しげであればセリフのシチュエーションに拘って頂く必要はありませんので、自由にお願いします。\n\nもし可能なら、近江鉄道沿線に宮荘川という紫陽花が沢山植えられたスポットがあるので、紫陽花を見に行く所という設定の絵が希望です。ただし、背景特に紫陽花は大変だと思うので、そういう設定のみでキャラを重点的に描いて頂いて全く問題ありません。\n\n構図、ラッピングは全身絵に限らず描きたい構図や得意な構図で自由にお任せ致します。髪型やパンタグラフ等、適宜描きやすいように改変や省略をなさってください。\n\n宛名はお任せですが、描いた方のサインやマークはどんな書式でもあったほうが嬉しいです。差し支えなければお願いします。\n\nもし引き受けていただける場合も、決して無理なさらず、御自身のやりたいことや他の依頼等を優先なさってください。\n\n以上、宜しくご検討下さい。\n\nhttps://twitter.com/vgloTDcrhxRn5B2/status/1647702875806777345?t=YPupPRJZxYKDYhe5x71cuQ&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inu_kawaii_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 176133, "client_id": 2099112, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=834aa71956fd274f652a1d723130d4ef", "srcset": "https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=834aa71956fd274f652a1d723130d4ef, https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f610f0f452728805254fd0259c5c93c 2x, https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c89493470a1efe1339ab153fb2036fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b20122fa5b5d5ffffdefda27a49a5ea4", "srcset": "https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b20122fa5b5d5ffffdefda27a49a5ea4, https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73480f8a7587e91692e8c819c172e266 2x, https://si.imgix.net/6aa6df35/uploads/origins/20a51ab2-968f-458a-8f8f-ee16b066a75a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=893edfd8be2352a045a169b5e1f8bd69 3x"}, "body": "いぬ様\n初めまして。\n突然ではありますが、Twitterよりいぬ様の活動を見つけまして、\n駅メモのイラストをリクエストさせていただきます。\nキャラクターは蛍茶屋みなもちゃんで、\n天気が良く一筋の飛行機雲が見える青空と海が見える背景のもとに\nみなもちゃんが待ってくれているシーンをお願いしたいです。\nポーズや衣装につきましてはお任せいたします。\n受けて頂けるのでしたら、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inu_kawaii_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 176133, "client_id": 460484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1125bc41ef269dfb321e17227bb816d8", "srcset": "https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1125bc41ef269dfb321e17227bb816d8, https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6ab011e0717a4269361d0897cf44e13 2x, https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83853d715627209580716ff72b69fcb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b49297f007948a485a0ab088c376c8c", "srcset": "https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b49297f007948a485a0ab088c376c8c, https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ecef97613041acb52b3c5821a055db0 2x, https://si.imgix.net/4c240de4/uploads/origins/b8846ba3-5a8e-4778-a63f-32466175f871?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83ac74ed56a60ad3be7de2cbfc7e2e68 3x"}, "body": "私の書いている小説「ボトムダウンオンライン」に登場する女の子の【ペグ忍者】ちゃんを描いていただきたいです！\n\n見た目は黒い猫耳頭巾を被ったピンク髪ロングヘアーでクノイチ装束を着ていて、首もとに赤色のマフラーを巻いています。\n小学生低学年くらいの身長……という設定です。\n\n真ん中に大きくペグ(キャンプでテントを固定するもの)を手に持って構えている【ペグ忍者】と、端の方に小さくデフォルメされた【ペグ忍者】が居てくれると嬉しいです。\n\n予算の関係でどちらかだけになる場合はお任せします。\n\n\n私の描いたイラストがこのページのあとがきにありますので、URLから見ていただければと思います。\n\nhttps://ncode.syosetu.com/n0809fw/22/", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@inu_kawaii_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 176133, "client_id": 465001, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/997b1d85/uploads/origins/04d9bed0-9f67-4808-9a52-3d27a812dba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aa75f42f5ee8f5f17db665c22c80c8f", "srcset": "https://si.imgix.net/997b1d85/uploads/origins/04d9bed0-9f67-4808-9a52-3d27a812dba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7aa75f42f5ee8f5f17db665c22c80c8f, https://si.imgix.net/997b1d85/uploads/origins/04d9bed0-9f67-4808-9a52-3d27a812dba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d75accf6e5de9aa45c8ee130f43bf67a 2x, https://si.imgix.net/997b1d85/uploads/origins/04d9bed0-9f67-4808-9a52-3d27a812dba3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=580f97c7be6c4c3f036ee7d9d32d22cf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/997b1d85/uploads/origins/04d9bed0-9f67-4808-9a52-3d27a812dba3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3cdcc47d1362bd05f5fc6cac0715adde", "srcset