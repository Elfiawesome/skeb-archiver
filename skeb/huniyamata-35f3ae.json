297417\n二次創作ルール：https://lit.link/crybabysaurus\n\n固定キャラポイント：八重歯、瞳の中の足跡、目の下の三角、お腹と脚の足跡のタトゥー、大きな尻尾\n\n- 依頼内容 -\n\n髪型：ウルフカット\n衣装：小悪魔の二周年新衣装\n構図、ポーズ等：お任せします\n\n- その他 -\n\n希望納品形式：宛名、背景等がレイヤー分けされているpsdでいただけると嬉しいです\n用途：Twitterでファンアートとして投稿、本人様によるTwitterやYoutubeにて使用\n金額の不足等ございましたら再送要請を頂けると幸いです\n\nご検討よろしくお願いします。ありがとうございます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@huniyamata/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2764693, "client_id": 2433459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/239727a0/uploads/origins/509210ee-39e4-4883-a8ac-7103927e4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ff5199ced35d9513513eedc4ff1ea6", "srcset": "https://si.imgix.net/239727a0/uploads/origins/509210ee-39e4-4883-a8ac-7103927e4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ff5199ced35d9513513eedc4ff1ea6, https://si.imgix.net/239727a0/uploads/origins/509210ee-39e4-4883-a8ac-7103927e4320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad426f09045a17483bde2a9d753fa443 2x, https://si.imgix.net/239727a0/uploads/origins/509210ee-39e4-4883-a8ac-7103927e4320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc3142cf3f42dfbf67ec2307da4d6f35 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/239727a0/uploads/origins/509210ee-39e4-4883-a8ac-7103927e4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60bd6dfcc28941345aae2d68232913d2", "srcset": "https://si.imgix.net/239727a0/uploads/origins/509210ee-39e4-4883-a8ac-7103927e4320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60bd6dfcc28941345aae2d68232913d2, https://si.imgix.net/239727a0/uploads/origins/509210ee-39e4-4883-a8ac-7103927e4