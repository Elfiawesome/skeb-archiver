1f1-ffa7-42da-8cc8-718dcaa49faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=49bf5e9fde475ba06f40f79102611aa6 2x, https://si.imgix.net/43cefea8/uploads/origins/577da1f1-ffa7-42da-8cc8-718dcaa49faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d456698049e1ae9e806be32e23777e96 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43cefea8/uploads/origins/577da1f1-ffa7-42da-8cc8-718dcaa49faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3671b974bf0c418fff0075b9db906224", "srcset": "https://si.imgix.net/43cefea8/uploads/origins/577da1f1-ffa7-42da-8cc8-718dcaa49faf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3671b974bf0c418fff0075b9db906224, https://si.imgix.net/43cefea8/uploads/origins/577da1f1-ffa7-42da-8cc8-718dcaa49faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b20fe4fb2dbcea7f28cffbcf0a0a53ce 2x, https://si.imgix.net/43cefea8/uploads/origins/577da1f1-ffa7-42da-8cc8-718dcaa49faf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a54631b00eca9f9235b813aaf5c488b 3x"}, "body": "初めまして、新規リクエストから失礼致します。\n水瀬レイさんの描かれる人物の表情、肌や絵全体の質感が素敵で、今回ご連絡させて頂きました。\nお忙しい中大変恐縮ですが、ご一読頂けますと幸いです。\n\nASMRストリーマーの月待にゃもさん(@TukimachiNyamo)のイラストを依頼したくご連絡致しました。\n使用途は配信用(アイコン、サムネ、配信画面など)を想定しております。\n以下リクエストまとめとなります。\n\n・全年齢〜R-15対象\n・ロリではなくお姉さん寄り\n(胸は大きめで全身の体型も大人っぽめ)\n・胸元開いた桃色のベビードール着用\n・ヘアピンそのままに髪は下ろしてロング\n・ベッドの上で背景はお任せします\n\n・ポーズ:\nうつ伏せから半分上体を起こした添い寝の姿勢、一人称視点でにゃもさんを見てるような構図(被写体はにゃもさんのみ)で、可能であれば、横たわったにゃもさんの全身(下半身が奥)を奥行きのある描写でお願いしたいです。\n\nもし受けて頂ける場合、データはPSD、透過pngの添付をよろしくお願い致します。\n依頼経験が少なく、何か失礼がありましたら申し訳ございません。\n何卒、ご検討のほどよろしくお願い申し上げます。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rei_9146/works/3", "private_thumbnail_image_urls": null, "private": false, "genre":