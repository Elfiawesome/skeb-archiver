り恐縮ですが、よろしければご検討お願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 62902, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "こがくなまイトヒロ3世", "screen_name": "kogaitohiro", "avatar_url": "https://pbs.twimg.com/profile_images/758996973097590786/08Qhl5zD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/758995878765993984/1469794041/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 1191963, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "いずミケ🔞", "screen_name": "izmk1028", "avatar_url": "https://pbs.twimg.com/profile_images/1558959985891360768/QG6Ds4VO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1140648055722532865/1778697242/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1229034, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "浩田島国", "screen_name": "hirotashimaguni", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-20625b71-4e89-4a5b-894b-86b73a98a9eb.webp&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "comic"}, {"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 40}