】\nXをはじめとするSNSへの投稿、サムネイルなどのYouTubeでの使用、ネットプリントやグッズに使用させていただく可能性があります。\n\n\nお忙しいと思いますが、ご検討いただけると幸いです。\nですが、エナたろ様には依頼させていただいてばかりなので、難しければ気にせずにキャンセルしてください！\nどうぞ、よろしくお願いいたします！！\n\nhttps://drive.google.com/drive/folders/1hcdBM2hfYgs7kag96u2faE0yGDPthMzc?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 222940, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "キドリ", "screen_name": "yau5531", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-ee31f795-7549-436b-ae2c-7f278bc43ba8.webp&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-7562ddf5-0e95-4214-9ebc-89cf4ca1edb8.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 893953, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぷかぁく👾", "screen_name": "game_pklk", "avatar_url": "https://pbs.twimg.com/profile_images/1923158259265044481/MJcyqmgA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/889594256322568192/1723537887/1500x500"