at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5c73c1186032159f34d55399fa5ad5a 3x"}, "body": "はじめまして！先生の絵柄がとても素敵だと思い、是非依頼させていただきたいと思います。よろしければTRPGのキャラたちのリクエストを受けていただけないでしょうか？詳しくはURLをご覧ください。\n\n彼らはクトゥルフTRPGシナリオ「ようこそ！迷冥市役所都市伝説課へ！」のPCであり、「都市伝説課」に所属する先輩と後輩です。\n\n『絢火』　あやか（先輩）\n・28歳の男性、身長は184cm。\n・カールの黒髪に鮮やかな紫色の目を持つ。\n・日本人と韓国人のハーフであり、喋る時にたまに韓国語が混ざっている。\n・黒いロングコートにハイネックニットと黒いズボンを着ている。靴は黒いマーティンブーツ。両耳に銀製のイヤリングをつけている。\n・いつも自信満々。面倒がりだが任された仕事はまじめにこなす。\n・後輩にはちょっと過保護。無自覚に甘やかしている。\n・愛用の武器は小型チェーンソー。\n・イメージカラー：#A042FF\n\n『夙夜』　しゅくや（後輩）\n・23歳の男性、身長は174cm。\n・鮮やかな青色の髪に金色の目を持つ。\n・真っ黒なテックウェアに指だし手袋をはいっていて、ゴーグルもつけている。存在感を減らすためにいつもフードをかぶっている。\n・普段は無表情で無口。ぼーっとしているように見えるかもしれないけど実は人の話をちゃんと聞いている。\n・先輩が大好きで、先輩の言うことはなんでも従う。\n・愛用の武器はナイフ。\n・イメージカラー：#4B83F5\n\n彼らが夜の電車で寄り添って一緒に寝ているシーンをお願いします。\nご検討いただければ幸いです。\n\nリクエストを読んでいただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1iX9bZ3LrKPnxC1vy4A0ZUzeR_6v5EosE", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ogino88/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 984150, "client_id": 193145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98f672f2f19a8481e05afd1f182c70f7", "srcset": "https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98f672f2f19a8481e05afd1f182c70f7, https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dad97927d2f993a72f5d1e5b6876784 2x, https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36901651a4e04ff5af5e95c762142e28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=376c6924968b3f8c8a6c7f813c6fcf23", "srcset": "https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=376c6924968b3f8c8a6c7f813c6fcf23, https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b77a598085c786b58a0abf6f30d1b84 2x, https://si.imgix.net/98301428/uploads/origins/e49d2945-0d50-4503-9221-74c2f979218d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79dd51d964c0a79f06a68a83c1157ce4 3x"}, "body": "はじめまして。あなたの作品にとても憧れているので、これが採用されたら嬉しいなと思っています！オリジナルキャラクター2体のイラストをお願いしたいです。\n\nキャラクターA 🐺 184cm。猟師。弓道が得意。クールで真面目な性格。眉毛が太い。めったに笑わない。肌の色に注目してください。服装はお好みでどうぞ。\n\n🐰キャラクターB 176cm。貴族の男性。優しい性格の持ち主。詩が好き。首と両腕に包帯を巻いている。月と縁がある。\n\n🤝 関係：2人は同じ目的地に向かう途中で出会った。見知らぬ者同士だが、もしかしたら友情が芽生えるかもしれない？\n\n平安時代のような雰囲気のものを希望します。イラストは横長でお願いします。ポーズや表情はおまかせします。依頼内容に問題がある場合は、遠慮なくお断りください。\n\nどうもありがとうございました！\n\n以下リンク👇。\n\nhttps://www.dropbox.com/scl/fo/2t0zy5n5c4hlkwjg49v01/h?dl=0&rlkey=e8s9ce8nd4kq8zywe3tqrxxvz", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ogino88/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 984150, "client_id": 2450084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e89caa2ce77304f8c5de1fbcd03e65bb", "srcset": "https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e89caa2ce77304f8c5de1fbcd03e65bb, https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d4ea5a7d3f76d31e3390508df8be053 2x, https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=515f3bee24b40e6b5e4bc90b16f59645 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=209a52d9dbdb5dca7d3484a837cbf3a8", "srcset": "https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=209a52d9dbdb5dca7d3484a837cbf3a8, https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67c94c00a18b8828a503ae6534557376 2x, https://si.imgix.net/b997a261/uploads/origins/96c57f79-1684-4d38-bb6d-66b061d9fa56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b54be43758f9c3e8fa6a07afa8214e29 3x"}, "body": "おぎの様、はじめまして。\nTwitterでおぎの様のイラストを拝見し、その絵柄にとても心惹かれました。絵柄すべてが好みなのですが、特に光の入れ方がすごく大好きです。そんなおぎの様の絵柄で、どうしても私と友人のオリジナルキャラクターが見たいと思い、リクエストを送らせていただきました。\n\n▼キャラクター\nクトゥルフ神話TRPGの探索者たちです。\nうっすらキリスト教要素もある、オリジナル新興宗教の教祖（OC1)とその信者（OC2）となります。\n\n・教祖（OC1）\n182cm、30歳の痩せぎすな男。信者の前では笑顔を絶やさない教祖をやっていますが、実際は常におどおどした情けなく鈍臭い小心者で、年下のOC2にいつも支えられています。OC2とは幼い頃から一緒にいる仲なので、本性はバレています。相手の年齢の上下に関わらず敬語を喋ります。眼鏡をしていますが、伊達です。眉はだいたい八の字で、困ったような笑い方がデフォルトです。\n\n・信者（OC2）\n170cm、22歳のひょろりとした男。幼い頃、OC1に助けてもらったことがあり、OC1を慕ってくれています。年上で教祖なOC1に盲信していましたが、とあることがきっかけで、今は隣に立って一緒に歩いていこうとしてくれています。OC1には少し大人ぶった態度を取りますが、それ以外の人間には年相応に振る舞います。忠誠心の厚い柴犬みたいな子です。\n\n▼シチェーション\n以下からお選びいただけますでしょうか。\n・教会（っぽい場所）にいる二人\n・リラックスした様子で食事をしている二人\n・その他、おぎの様の描きやすいシチュエーション\n服装や表情、構図等、自由に描いてください。\n\n▼資料\nhttps://drive.google.com/drive/folders/1MrcGbFoYQrD9AABXazAW3tnt_9lvZami?usp=drive_link\nいずれもPicrewで作成したイラストを格納しています。\n表情、服装等の参考にしていただければと思います。\n\nもしよろしければ、ご検討いただけますと幸いです。よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1MrcGbFoYQrD9AABXazAW3tnt_9lvZami?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ogino88/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 984150, "client_id": 192290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8147d75/uploads/origins/70edcf19-ef7c-4648-aab7-f9a62891ec65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc4bd0e4b8e5b9fff75bf8a49105444f", "srcset": "https://si.imgix.net/c8147d75/uploads/origins/70edcf19-ef7c-4648-aab7-f9a62891ec65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc4bd0e4b8e5b9fff75bf8a49105444f, https://si.imgix.net/c8147d75/uploads/origins/70edcf19-ef7c-4648-aab7-f9a62891ec65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2df92bb19ab7b9f40de5a56cc4b19c69 2x, https://si.imgix.net/c8147d75/uploads/origins/70edcf19-ef7c-4648-aab7-f9a62891ec65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=520b0046f49b8ba9b35f1f55d901bb39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8147d75/uploads/origins/70edcf19-ef7c-4648-aab7-f9a62891ec65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=121c20a0aea770a0b39d1cb457e94afa", "srcset": "https://si.imgix.net/c8147d75/uploads/origins/70edcf19-ef7c-4648-aab7-f9a62891ec65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=