6f-9c790b2ed7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=411a8834cdc777dd985a57187115b227, https://si.imgix.net/c149b883/uploads/origins/3e2ad655-523d-4ffa-a86f-9c790b2ed7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df65d4f042621acbe5f5c7e7da436a90 2x, https://si.imgix.net/c149b883/uploads/origins/3e2ad655-523d-4ffa-a86f-9c790b2ed7bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1c1ed59ffe37adcf2e789e9ce9e3ada 3x"}, "body": "初めまして。個人勢VTuberの海月ひなつと申します。\nおくたふく様の描かれるキラキラなお目目と可愛らしい表情に惹かれ、\nぜひリクエストさせていただければと思います…！\n特に原神のシグウィンちゃんのイラストが好きです！髪のハイライトのお色やお目目のキラキラ感が素敵だと思いました…！\n\n■依頼内容\n海月ひなつのイラストを描いていただきたく思います。\nサムネイルなどへの使用のため、髪の毛が途切れていないイラストだと大変助かります。\n※腰まで髪がありますので、毛先は途切れていても大丈夫です！\n横髪が途切れていないと助かります。\n\n■使用可能性のある用途\n・YouTubeのサムネイル\n⇒収益化まだのチャンネルですが、今後収益化の可能性がございます。\n・おはよう/おやすみVTuber\n・配布用壁紙\n(FANBOXメンバーに配布。\nそのままお配りではなく、イラストを配置して壁紙作成いたします)\n・ネットプリント\n・ポストカード/チェキ風カードなどなど、販売グッズへの使用\n　※商用利用は不可前提なので、お断りいただいて大丈夫です！\n\n■ファイル形式\nサムネイルなどに使用したいため、 背景ありの場合、PSD、もしくは透過pngをいただけると助かります。\n\n■その他\nカメラ目線でお願いできると嬉しいです！\nその他構図や表情はお任せいたします。\n\n衣装・髪型・小物などご自由にアレンジいただいて大丈夫です◎(資料のままでも勿論大丈夫です！)\n一点だけ、瞳の中と頭にクラゲの傘の模様のハイライトがございまして、そちらは構図的に無理な場合を除き入れていただけたらと思います。\n\nもし可能であれば引き受けていただけますと、大変嬉しく思います…！\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/1HP_YouQiKkfbwuDDfu3U0mQ7bnHVzXAV", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@okuta0_0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3185803, "client_id": 2172002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5b068c5/uploads/origins/0eb4516d-accc-406a-ab13-3e7f761f9cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64cd7be60a652fdbd8cb01ce6eb775db", "srcset": "https://si.imgix.net/c5b068c5/uploads/origins/0eb4516d-accc-406a-ab13-3e7f76