8-4ad9-4f8b-873b-c75c589d2d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a497a8c2d5bbcbaa46a4530ed9508a", "srcset": "https://si.imgix.net/f660f84f/uploads/origins/4c0e5978-4ad9-4f8b-873b-c75c589d2d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70a497a8c2d5bbcbaa46a4530ed9508a, https://si.imgix.net/f660f84f/uploads/origins/4c0e5978-4ad9-4f8b-873b-c75c589d2d25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ef77591b9c384d13e78db862b443f71 2x, https://si.imgix.net/f660f84f/uploads/origins/4c0e5978-4ad9-4f8b-873b-c75c589d2d25?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69e931472d9af77a20a4a15dab44b699 3x"}, "body": "先月のアピールから失礼します\nアピール文面でもありました通り、千年戦争アイギスの雪豹執事ネーヴェのR18イラストをお願いしたく\n\n内容としましては、メイド衣装に着替えたネーヴェが、スカートをたくし上げて挿入部が見えるようにした状態で騎乗位でのご奉仕プレイをしているイメージの物をお願いします\n\n表情に関してですが、クールな彼女が快楽によって感じすぎて余裕の無さそうなとろけ顔になりながら奉仕をする様子をお願いしたく\n\n以上です、可能な範囲で構いませんので宜しくお願い致します\n\nhttps://wikiwiki.jp/aigiszuki/%E9%9B%AA%E8%B1%B9%E5%9F%B7%E4%BA%8B%E3%83%8D%E3%83%BC%E3%83%B4%E3%82%A7", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YamaKou38/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 13720, "client_id": 59172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5245b7cf3995d01b4ffdb83075b9c44", "srcset": "https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5245b7cf3995d01b4ffdb83075b9c44, https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b46e24cd21c0a6b6f20db6cd373b24b 2x, https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ab8350659616761229f3fec5f842d39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c51045753b31a14d8308f3c2ecead6d6", "srcset": "https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c51045753b31a14d8308f3c2ecead6d6, https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccecbce3740255c61092929323861514 2x, https://si.imgix.net/02ad9708/uploads/origins/d35b0148-3ac0-4627-b520-e9b78b1a1e1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=adf03ec4c8a06805d2e8d597d8e9c5c6 3x"}, "body": "おひさしぶりです！\n\n今回はホンダのCBR400Rに乗ったうちの娘キャラのイラストをお願いします。\n\n⚫︎構図\nAKIRA構図のような感じでバイクは横を向いた状態（イラストの左側が前輪）\nキャラの顔はこちらを見ている状態。\n\n⚫︎衣装\nうちの娘キャラの三面図記載の衣装で、かつヘルメットは無し（演出上の都合）。\n武器の有無はお任せします。また、翼の描写は可能であればお願いします。\n\nhttps://x.com/RavenUtrout/status/1666797982682071041?s=20", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YamaKou38/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 13720, "client_id": 59172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3891f006de237929543ce95f7565bd41", "srcset": "https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3891f006de237929543ce95f7565bd41, https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b45ebf51c8a742e1b40bf8007d9b5b5 2x, https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e72f5da0d62f18e78985b74a674798c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bec9f3a59720e8a8cc94f14090634d4", "srcset": "https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bec9f3a59720e8a8cc94f14090634d4, https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=90e97bea24cb02f2221f647410dba359 2x, https://si.imgix.net/0f357619/uploads/origins/0e3b677d-7f36-4c68-9ab5-645d958e9c08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=16c1a3531698437bae36083090bbb511 3x"}, "body": "おひさしぶりです！\n\n今回は砂の国の踊り子をイメージした衣装バージョンのうちの子イラストの依頼となります。\n\n⚫︎衣装について\n元々のオリジナルカラーイメージに近い配色になります。\n\n口元のベールは本来あったりするものですが、今回はあえて無しの方向でお願いします。\n\n⚫︎ポーズについて\n回転しながら風に乗っているかのような印象で、背面ジャンプで高く飛んだ時に近い状態のポーズ。\n（高跳び競技で背中を地面に向ける感じに近い形）\n\n⚫︎背景について\nアフリカや中東の砂漠における灼熱の砂丘。\n遠くに小さく摩天楼とオアシスが見えるイメージで、昼間の燦々とした太陽の光がギラついている。\n\n⚫︎その他備考\nキャラクターの周囲に風のオーラが出ていて、飛翔しているかのような雰囲気。\nウチの娘の翼や尻尾は躍動感という意味で今回は必要かなと考えています。\n\n\n\n★ここからは可能であればのワンシーンとして、叡智イラスト版の部分になります。\n\n⚫︎衣装\n1枚目の踊り子衣装そのまま\n\n⚫︎ポーズ等\n背面座位でウチの娘の顔や正面がしっかり見える感じの構図。\n両手が枷のようなもので拘束されており、上から鎖で吊るされて両腕を挙げさせられている状態。\n\n⚫︎背景について\n屋内のステージ上で、ほとんど押し切られる形でショーとして立つという場面。\n最初は踊りだけだったが、エスカレートしてしまった格好。\n\n⚫︎その他備考\n可能であれば、表情差分もお願いします。\n\n表情は困惑と羞恥心が入り混じった表情で、時間の経過と共に身を感覚に委ねていくイメージ。\n\n\nよろしくお願いします！\n\nhttps://x.com/RavenUtrout/status/1666797982682071041", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YamaKou38/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 13720, "client_id": 1913423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba71a7b6d5a247837bd52567c0263050", "srcset": "https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba71a7b6d5a247837bd52567c0263050, https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=136f5d41c7181c7de679cd170c3d0bed 2x, https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=339bf9e7b5634166f290b69448ed2e56 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f884115345fada64ffd3cf8535712a9b", "srcset": "https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f884115345fada64ffd3cf8535712a9b, https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdaa99cb9165f3fbc631e283c2633338 2x, https://si.imgix.net/138184e3/uploads/origins/a5446ad9-ef11-46a1-bfd4-778053b17ec3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b25a3fa707389de36506849297557b27 3x"}, "body": "yamakou先生アピール頂きありがとうございます！\n銀髪白髪大好きでアンナさんとセーラさんは自分の中でアイギスでトップ3を争う2人ですので、先生が描くアンナさんセーラさん滅茶苦茶大好きです。前に描かれてましたクリスマスアンナさんｘセーラさんのイラストも最高すぎて何万回イイネしたくなったか……yamakou先生にアピール頂けてなんとも惧れ多いです。\n\nアンナさんｘモーティマのイチャイチャ大好き人間なので非正規カプでNTR気味な組み合わせになるのですが、そういった内容でも宜しければご依頼させて頂けないでしょうか。\n\n改めて内容的に無理そうでしたら、ご遠慮なくキャンセルくださいませ。\n\n▼設定\nアンナとモーティマの関係的にはお互いに基本的に戦場に出る事がなく裏方で王子をサポートするもの同士、よく調子に乗るモーティマにアンナさんが突っ込みいれたりなんやかんやで交流も多く仲良くなり好感度MAX状態。戦場の裏で隠れて付き合ってるみたいなそんな設定。\n\n▼内容\n設定からの連想で先生の何かイメージあれば先生のお好きな内容でアンナさんとモーティマ描いて頂きたいのですが（仲良さげな二人が見れればエッチでも健全でも構いません）悩ましければ夜の寝室で下着姿のアンナさんがモーティマに馬乗りになり、最近仕事が忙しくご無沙汰だったためすっかり卑しくなったアンナさんがモーティマを誘惑して迫ってるような感じ希望です。\n※モーティマは全身しっかり描かずとも、腕とかお腹とか見える部分がそれっぽい程度で大丈夫です\n※可能でしたら下着なしの全裸差分、何かそれっぽい二人の台詞などありますと嬉しいです。この辺は可能ならご検討頂けますと幸いです。\n\n▼参考構図\nhttps://skeb.jp/@enjoymixxx000/works/114\nhttps://skeb.jp/@iruka___3_/works/37\nhttps://skeb.jp/@higaragi0209/works/79\n\n改めて、御好みな内容でなければご遠慮なくキャンセルくださいませ。何卒ご検討の程よろしくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YamaKou38/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 13720, "client_id": 59172, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ac57c9d/uploads/origins/bf65d586-a1ff-4902-89c9-0fef39256d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ad52a4491488d9c509ae140b43f9b1", "srcset": "https://si.imgix.net/4ac57c9d/uploads/origins/bf65d586-a1ff-4902-89c9-0fef39256d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ad52a4491488d9c509ae140b43f9b1, https://si.imgix.net/4ac57c9d/uploads/origins/bf65d586-a1ff-4902-89c9-0fef39256d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=c