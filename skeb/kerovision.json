ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea4688c83ea1cb6a71b679c7ba116eb5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0871062b/uploads/origins/594e095d-fded-4eba-8909-66cb66977e48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c029f02911573893bd6665ceab2f218", "src_set": ""}, "body": "肥満化するキャラ:井河アサギ\n登場作品:対魔忍アサギ、対魔忍RPG、アクション対魔忍\n\nbefore\nスリムな姿で対魔忍スーツを着こなしている姿はまさに最強の対魔忍であり鍛えているため腹筋も浮かんでおり筋肉質な体つきhttps://img.atwiki.jp/niconicomugen/attach/11396/30775/Asagi.webp\n\nAfter \n平和になって数ヶ月後、自分が戦う事が無くなり校長室で執務仕事していた結果、だらしなく太ってしまい対魔忍スーツも入れず自慢の腹筋も脂肪に埋もれてしまいトレーニングもしていないから弱くなっており指揮官の仕事をしている。https://pbs.twimg.com/media/F7MJbnjaEAAVwd5?format=jpg&name=medium\n\n以上ですが、どうでしょうか？\n\nhttps://img.atwiki.jp/niconicomugen/attach/11396/30775/Asagi.webp", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kerovision/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6c96a10a/uploads/origins/d19cac54-739b-4fad-a61a-bab7b1620a06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=33e64c84e57b7449ded8cf6023ad92d4", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 615360, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kerovision/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 615360, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33fce3be/uploads/origins/853a8410-e309-4639-8f02-03a559b5b66e?bg=%23fff&auto=format%2Ccompre