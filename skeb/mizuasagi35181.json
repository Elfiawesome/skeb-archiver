ur=200&s=d513dd04c14f2c58c11c3cadaa259853, https://si.imgix.net/eace2887/uploads/origins/08fe1be9-6e8d-4a05-b1b4-27e63ef6688b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f7c2b7e22de93e445d8ae2bb44b3fce 2x, https://si.imgix.net/eace2887/uploads/origins/08fe1be9-6e8d-4a05-b1b4-27e63ef6688b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=554e02f83f03de5a28811cde7de67f6c 3x"}, "body": "Mizuasagi様、初めまして！\nvtuberとして活動しております、にゃんだねむりめと申します。\nMizuasagi様のイラストをXで拝見し繊細で可愛らしいイラストに一目惚れしたので、ぜひ私のＯＣのイラストをリクエストさせてください…！\n \n\n【使用用途】 \n・SNSでの使用 \n・配信活動(配信のサムネイル、グッズ、アイコン)での使用\n\n ※可能な範囲で商用利用の許可をいただければと考えております。 不可の場合はPSDデータに記載いただけましたら幸いです。\n\n【詳細】 \nOCの参考画像はURLに添付しておりますのでご参考下さいませ。\n猫から人間に変身出来る女の子です。\nMizuasagi様のこちらのホタルちゃんのイラストがとても可愛かったので、照れてる表情や構図などを似せて描いて頂けたら嬉しいです。\nポーズなどは全く一緒じゃなくても大丈夫です！\n・服装や髪型は描きやすいほうで構いません。\n\nhttps://x.com/mizuasagi35181/status/1860235769358762233?s=46&t=gl3_ATs-VUqTAABapxnMQw\n\n・サムネイルに使用したいので頭や顔、横髪は見切れてない構図でお願い致します。\n・表情差分を可能でしたらお任せでお願いしたいです。\n\n・形式は人物と背景がレイヤー分けされたPSDデータで頂けますと幸いです。\n\nリクエスト内容については以上になります、金額等で不備やなどございましたら再送していただければと思います。\nお忙しい中恐縮ですが、御検討頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1-0slTUTt6VGJNFOVHrmLuYnfRj_ADnMw", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mizuasagi35181/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3478950, "client_id": 3216958, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fe09214/uploads/origins/ed6687da-11c3-4383-8962-a8f31e59ac68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e90ff8128c45bb0f7d164ed0baa9a0e", "srcset": "https://si.imgix.net/5fe09214/uploads/origins/ed6687da-11c3-4383-8962-a8f31e59ac68?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e90ff8128c45bb0f7d164ed0baa9a0e, https://si.imgix.net/5fe09214/uploads/origins/ed6687