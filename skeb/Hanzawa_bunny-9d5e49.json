fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe73c5afef485ffa6450531a9877b590 3x"}, "body": "とても素晴らしい美遊のイラスト拝見しました。リクエストさせて下さい。\nイメージはこちらの様なポーズで犯されている美遊をお願いします。\nhttps://skeb.jp/@Hanzawa_bunny/works/2\n\n差異として、\n・ポーズについて、腕を上げて足とひとまとめにおっさんの大きな手に掴まれている。\n・服装について、魔法少女版の服装をエロ衣装改造したものでお願いします。\n体部分はほぼ裸で僅かに布がある程度の露出過多の着ている方が恥ずかしい衣装にしてください。\n※イメージつかなければお任せでエロい衣装を着せて下さい。\n※ポーズについても局部丸見えの恥ずかしいポーズであれば描きやすい様にしていただいて大丈夫です。\n\n以下の様な流れをお願いします。\n1、ゴム付きで犯され、使用済みゴムを括り付けられ口に咥えさせられる。\n2、ゴムを落としたらゴム追加と言われ落とさない様に絶頂しない様に堪える。\n3、一際大きい竿を持つおっさんに犯されオホ声絶頂してゴムを落とす。\n4、数時間後、追加のゴムも使い切り中出しされ全身使用済みゴムと精液でドロドロになりアヘ顔ピクピクしているエンド。\n※ハメられ過ぎてマンコは閉じなくなっていて開いたまま\n\n可能でしたら宛名を美遊の体に犯した後の落書き的な感じでon/off可能形式でお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hanzawa_bunny/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3478443, "client_id": 3448762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de26a561/uploads/origins/87f8295b-cd0c-4c7a-a909-191305c9a681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216de8f333a49ce840305a25f7862290", "srcset": "https://si.imgix.net/de26a561/uploads/origins/87f8295b-cd0c-4c7a-a909-191305c9a681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=216de8f333a49ce840305a25f7862290, https://si.imgix.net/de26a561/uploads/origins/87f8295b-cd0c-4c7a-a909-191305c9a681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83a8e681b2ed21bdefa509d42454d28c 2x, https://si.imgix.net/de26a561/uploads/origins/87f8295b-cd0c-4c7a-a909-191305c9a681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0b767d0ea06c7a90ae1e5900c7132ac 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de26a561/uploads/origins/87f8295b-cd0c-4c7a-a909-191305c9a681?bg=%23fff&auto=format%2Ccompress