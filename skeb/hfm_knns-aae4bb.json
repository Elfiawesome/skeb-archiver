絵柄で牙城論莉を描いていただきたいと思い、リクエストさせていただきました。\n下記ご確認いただき、大丈夫でしたらお引き受けいただけますと幸いです。\n\n○サイズ\n動画投稿サイトのサムネイルとして使用できるようなサイズだと嬉しいです。\n\n○イラストについて\n牙城論莉を描いていただきたいです。\n設定は社会人162cmの女性です。\n服装と髪型はこちら(https://drive.google.com/drive/folders/1tutAlS8IbTdrlUaOFPT6KvF_mKwbaZ_y?usp=sharing)のお好きなものでお願いします。\n等身やポーズ、構図、描写範囲等はお任せしたく思います。\n\n○使用用途\nSNSでの告知や動画投稿サイトでの使用（サムネイル、動画・配信内）\n\n○その他\nもし背景や文字がある場合は、可能であれば人物と背景と文字は分けていただけると嬉しいです。\n\n以上です。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1tutAlS8IbTdrlUaOFPT6KvF_mKwbaZ_y?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hfm_knns/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3798198, "client_id": 957311, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8fc3514/uploads/origins/2635d1fd-5dc7-4839-921f-fb1b64113cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b90bc8a97da8d44b939038c9132a75bc", "srcset": "https://si.imgix.net/b8fc3514/uploads/origins/2635d1fd-5dc7-4839-921f-fb1b64113cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b90bc8a97da8d44b939038c9132a75bc, https://si.imgix.net/b8fc3514/uploads/origins/2635d1fd-5dc7-4839-921f-fb1b64113cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c0012d5184098e9df5eb80c830fbcdc 2x, https://si.imgix.net/b8fc3514/uploads/origins/2635d1fd-5dc7-4839-921f-fb1b64113cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1673c7165ed46104516688685cbf3c2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8fc3514/uploads/origins/2635d1fd-5dc7-4839-921f-fb1b64113cc9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1709dc4dc0d9015be8db157ecc7a109c", "srcset": "https://si.imgix.net/b8fc3514/uploads/origins/2635d1fd-5dc7-4839-921f-fb1b64