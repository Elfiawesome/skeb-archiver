": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06e14a69/uploads/origins/8665a3d4-1c00-4fed-a82e-428b05142fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=611f5c08d8a784b1e887f2eaaf379f0a", "srcset": "https://si.imgix.net/06e14a69/uploads/origins/8665a3d4-1c00-4fed-a82e-428b05142fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=611f5c08d8a784b1e887f2eaaf379f0a, https://si.imgix.net/06e14a69/uploads/origins/8665a3d4-1c00-4fed-a82e-428b05142fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=16db52b6bfc44812596fac9d145ba541 2x, https://si.imgix.net/06e14a69/uploads/origins/8665a3d4-1c00-4fed-a82e-428b05142fe9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05e89c713fac2d251d0d495c37d8b5b5 3x"}, "body": "梅屋ミカ様。\nこちらが詳細になります。\nお忙しいところ恐縮ですが、\nよろしくお願いします。\n\nｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰｰ\n➀スマホケース\nサイズ　W90×H157mm\n\n構図\n『夏の香り』のような感じ\n\nメイン\n『ツバキノハナ』の少女と\n椿の花（紅と白）\n\n②アクリルスタンド\nサイズ　W75×H100mm\n\n構図おまかせ（横向き）\n\nメイン\nセクシー過ぎない\nランジェリー姿の少女\n\n出来たらアクセサリーなどに\n使用して欲しいもの\n椿の花\n\n③辰年　お正月イラスト\n\n構図　おまかせ\n\nメイン\n龍と花魁姿の少女\n\n少女の詳細\n『ツバキノハナ』と同様\n黒髪ロング\n姫カット\n赤眼（釣り目）\nおちょぼ口\n\nｰｰｰｰｰｰｰｰｰｰｰｰｰ", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umeya_mika/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1623358, "client_id": 1144171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eca214ec/uploads/origins/0193e48a-da08-4436-979a-5c99915ff3e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=316fe43ad6a79d1c3a337c8f0adb7ae3", "srcset": "https://si.imgix.net/eca214ec/uploads/origins/0193e48a-da08-4436-979a-5c99915ff3e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=316fe43ad6a79d1c3a337c8f0adb7ae3, https://si.imgix.net/eca