42/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8da2aac1fa5e3fa39639e340eab26303", "srcset": "https://si.imgix.net/dcd3a742/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8da2aac1fa5e3fa39639e340eab26303, https://si.imgix.net/dcd3a742/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b11447b4e33a641287bd6bb3782abead 2x, https://si.imgix.net/dcd3a742/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=826ffe8f03aea9e85f13ead56c9a3afc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcd3a742/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3badf66f0a1ba121664be6888e8b7c", "srcset": "https://si.imgix.net/dcd3a742/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3badf66f0a1ba121664be6888e8b7c, https://si.imgix.net/dcd3a742/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9012203aed966a0fc3df77ff4ce908e5 2x, https://si.imgix.net/dcd3a742/uploads/origins/650bd689-324d-4424-a3f2-ed45cdc1dd1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b38f321a2e73dbfcf7c3151b0ecb17e6 3x"}, "body": "ふにふに 様\nこんにちは！いつも配信やSNS楽しく拝見させていただいております！\n\nキャンペーン期間とのことで、わたしが配信で使っているアバター兼うちの子を描いていただけないでしょうか…！？\n白い姿と黒い姿(同一人物で担当ジャンルが違う子たちです)があり、もし可能でしたらそれぞれの姿を描いていただきたいのですが、\n予算等見合わない部分がありましたら、白い姿だけ・またはリクエストのキャンセルをお願いいたします。\n\n描いていただけた際ですが、\n\n・Twitchでのライブ配信時、アバターとして画面上への表示\n・動画のサムネイル(Twitch、YouTube)\n・各種SNSのアイコン、ヘッダー、バナー等\n\nにイラストを使用させていただきたいと考えております。\n収益化された場での使用となりますので、こちらもNGでしたら大変お手数ですがキャンセルをお願いいたします。\n\n以下、うちの子たちのイメージです。長くなりますが目を通していただけましたら幸いでございます。\n何卒ご検討よろしくお願いいたします！\n\nーーー\n【白い子】\nおだやか、ゆるゆる、ふわふわ、純粋、感情豊か、光属性、〇\n\n【黒い子】\nクール、キリッと、ニヒル、表情ちょっと薄め、厨二、白より少しお姉さんっぽい、△\n\nなお、共通して「瞳がオレンジ寄りの暖かみのある黄色(山吹色が近いです)」「裾が金魚のヒレのイメージなワンピースを着用している」というものがあります。\n白は和金や琉金、黒は出目金がモチーフです。\n\nメインの参考資料がわたしの拙いドット絵ですので、想像で補完していただく部分が多く申し訳ありませんが…\n上記の雰囲気やイメージが大きく失われなければ、構図・表情・服の形や装飾など、ふにふに様のお好きにアレンジしていただけますと嬉しいです！\n\nhttps://drive.google.com/drive/folders/1V8HuPiu9v7gRI_TVnQDUA911S4fAiU63", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@funi_funii/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3144729, "client_id": 2921007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6588b4a6/uploads/origins/394ebabe-5274-4504-a79e-def46c92a767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984e9065cf0685b4813db089719d87b9", "srcset": "https://si.imgix.net/6588b4a6/uploads/origins/394ebabe-5274-4504-a79e-def46c92a767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=984e9065cf0685b4813db089719d87b9, https://si.imgix.net/6588b4a6/uploads/origins/394ebabe-5274-4504-a79e-def46c92a767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a99a18081f1fd3c4ff18d1e2b8de8569 2x, https://si.imgix.net/6588b4a6/uploads/origins/394ebabe-5274-4504-a79e-def46c92a767?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3c59a667b03d2b509f0742ed23da00b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6588b4a6/uploads/origins/394ebabe-5274-4504-a79e-def46c92a767?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb807c9da11d1e303d845a93db79398c", "srcset": "https://si.imgix.net/6588b4a6/upload