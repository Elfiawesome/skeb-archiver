ead of SD characters (mini characters). (*It does not have to be a full body.)\nWe would appreciate it if you could make it easy for us to create other characters!", "nc": 144, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 98394, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "peroncho", "screen_name": "peroncho18", "avatar_url": "https://pbs.twimg.com/profile_images/2016509917876899840/HmbGNATT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1035181579717365761/1630677918/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1195371, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Soyokaze＠misskeyにいるよ", "screen_name": "Soyokaze_E2021", "avatar_url": "https://pbs.twimg.com/profile_images/1393857944609988614/KVXMUMSo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393854705269280775/1621334822/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 177}, {"id": 1489240, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ななうえ", "screen_name": "tokeiiiiiii", "avatar_url": "https://pbs.twimg.com/profile_images/1318155455634403328/jdvwQlFP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/923877770383343616/1595099601/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60