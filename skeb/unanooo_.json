/706ed9b6-edbb-4360-8105-533517cf6c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9be82266a201c2e339960814b7f7dfbb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30347f75/uploads/origins/706ed9b6-edbb-4360-8105-533517cf6c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=069b170173504eb4dbc512e372c76f6b", "src_set": ""}, "body": "東方の十六夜咲夜をお願いします\n\n服装は下記の9枚目の衣装で完全に着衣でお願いします\nhttps://www.pixiv.net/artworks/30991785\n衣装の下半身部分はレオタード型で,上にブラウスとベストを着ている形(下記のようなの)でお願いします\nhttps://skeb.jp/@guild_tatsuya/works/4\nサポーター,ガーターベルト,ブーツ等手足の装備品は無しの状態でお願いします\nエプロン部分は股間の衣装が少し見える長さで表示非表示できる形でお願いします\n頭の飾りは無しで髪は解いた状態でお願いします\n衣装の胸部分は乳首が浮き出ない形でお願いします\n股間部分は縫い目は無しで性器が浮き出ない,食い込まない形でお願いします\n股布から汁が染み出ない形でお願いします\n\n下記のような主観視点で正常位でエッチを楽しんでいる様子をお願いします\nhttps://www.pixiv.net/artworks/97197230\n全て着衣で衣装の性器部分を少しずらして挿入する形でお願いします\n竿側に求められて着衣でさせてくれる設定でお願いします\n可能であればそれっぽいセリフ、擬音有りでお願いします\n修正は線,モザイク切り替えられる形か線でお願いします\n可能でしたら奥まで細くなってる断面図(下記のようなの)を表示非表示できる形で余白にお願いします\nhttps://www.pixiv.net/artworks/116253244\n胸の大きさは控え目(下記の位)でお願いします\nhttps://www.pixiv.net/artworks/130927610\n\n可能でしたら下記の差分もお願いします\n股布をずらす前(股間を見せて誘惑中,竿等無し)\n竿先端で衣装越しに股間を擦って前戯\n股布がずれて性器が見えてる\n竿を性器に近づける\n竿先端を性器に当てる\n挿入途中\n奥に到達\n膣内の感触を堪能させながらピストン要求\nピストン中\n中出し直前\n腰を密着させて中出し,軽く絶頂(精液は外に出さないで膣の奥で射精)\n咲夜が満足するまで繋がったまま余韻中\n竿抜き出し中\n竿先端が性器から出る\n竿が糸を引きながら性器から離れる\n事後(性器から精液が少し出てくる)", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6f10edb/uploads/origins/03e46f6c-055f-413c-9bb2-5e17040743c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ae58184b2ff25985edfddc8038c04d2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 3702671, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@unanooo_/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 514283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0b72026/uploads/origins/c1026296-dee8-491f-a5d3-e63ff3b8ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e286ad5fb9ca7ccb13a24e2b7e1511f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0b72026/uploads/origins/c1026296-dee8-491f-a5d3-e63ff3b8ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e85e7c2125c7f8988fb396a618ca7b1a", "src_set": ""}, "body": "初めまして。\n\nXやpixivに上げていましたイラストが可愛くてギリギリを攻めたシチュエーションがめちゃくちゃ好みでしたのでもしよければリクエストしてもよろしいでしょうか？\n\n『東方project』の博麗霊夢ちゃんをお願いします。\n\n格好は２０２５年６月１３日にpixivに上げていました胸にお札を貼っている霊夢ちゃんで。\n\nNSFW可となっていましたのでもし可能であれば霊夢ちゃんが片方のお札をめくり上げている途中のイラストをお願いします。\n\n表情は少し困ったような表情でお札でギリギリ見えていないか輪チラぐらいでお願いします。\n\n後の細かいところはうなの様にお任せします。\n\nもし金額にご無理のない範囲であれば片方の胸はお札無しであらわになっている状態でもう片方はお札をめくり上げて完全にポロリしてしまっている差分がありますとありがたいです。\n\n条件やリクエスト内容が合わなければ遠慮なくキャンセルしてください。\n\nご検討よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 842721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c67f2b6d/uploads/origins/935ec590-9a46-4da2-8593-5e61a7993c60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0141fca2bc97316e5197084ccd41077", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c67f2b6d/uploads/origins/935ec590-9a46-4da2-8593-5e61a7993c60?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e12a11503a818c486fa38566a61f7496", "src_set": ""}, "body": "以前にも甘雨ちゃんのイラストを依頼させていただき、とても素敵なイラストをありがとうございました。\nこのたび、もう一度甘雨ちゃんのイラストを依頼させていただきたいと思います。\n以下の２つのシチュのうち、気に入っていただけた方を描いていただけると幸いです。\n\n①原神の八重神子や東方の霊夢のような、肩や太ももが露出している系の巫女服＋唐笠を持つ甘雨ちゃん\n②アズールレーンのベルファストや東方の咲夜のような、メイド服を着て闘う系の甘雨ちゃん\n\nどちらの場合でもショートスカート＋えっちベルト or ロングスカート＋側面のエグいスリット、のどちらかで太ももを魅せてほしい。\n上半身の衣装は、ノースリーブ＋横乳が映えるような改造を施してほしい。\n\nポーズや衣装の詳細はお任せしたいと思います。\nご検討いただけると幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 842721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6be85b82/uploads/origins/740c0590-561a-452d-a266-a54483262889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0209080e58c2e09c4576533c11187eee", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6be85b82/uploads/origins/740c0590-561a-452d-a266-a54483262889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5940fb57469d876adcf4c9537cffc98a", "src_set": ""}, "body": "以前の甘雨ちゃんのイラストを拝見して依頼させていただきました。\n絵師様のらくがきはパンピーから見ると既に素晴らしかったのですが、もしよろしければ甘雨ちゃんのらくがきの本仕上げを依頼させてください。\n\n勝手を申して申し訳ありませんが、\n・目のハイライトの有無\n・全体的にむわっとした雰囲気のエフェクト\nの差分があると嬉しいです。\n\nご検討いただけると幸いです。\n\nhttps://www.pixiv.net/artworks/132827881", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/39f45583/uploads/origins/c0126b66-bfea-4799-831b-042649edb539?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=652d833ee013d655e3bf806822abf3b3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@unanooo_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c412652/uploads/origins/9b621e37-4cc1-427b-a94a-c2591433ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9129c2da0b2bf44d6a542dee82f34ee", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c412652/uploads/origins/9b621e37-4cc1-427b-a94a-c2591433ca8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7766dac23222a79a60077e1eed9be112", "src_set": ""}, "body": "初めまして。べるs氏の東方project二次創作『魔理沙とアリスと不思議の国の魔獣』に登場する黒アリスの水着姿を描いていただけないでしょうか。\n帽子と腰ユニットの電磁防壁展開/無し差分をお願いします。\nその他、背景・構図やキャラのポーズは全てお任せします。\n\n黒アリス参考：\nhttps://twitter.com/berusyarion/status/1569643087957475330\n\n\n\nまた、人形を描かれる場合は以下のデザインを参考にしてください。\n\n蒼符「博愛のオルレアン人形」(一番上の人形)：\n外見は兜を上に上げた状態でお願いします。\nhttps://skeb.jp/@berusyarion/works/26", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 3230918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba0e77b7/uploads/origins/39eb5635-5fb2-4133-859f-2e966d020186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=911f6007afd49021197a6720693006f9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba0e77b7/uploads/origins/39eb5635-5fb2-4133-859f-2e966d020186?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68f337c2efc866b0fef990ef4b9be448", "src_set": ""}, "body": "こんにちは！『クイーンズブレイド』のナナエルの二次創作イメージをリクエストしたいと思います。\n\nナナエルのオリジナルイメージの参考：\nhttps://ibb.co/7TJX1t4\nhttps://ibb.co/F4jvQysH\nhttps://ibb.co/GQb20fLp\n\n二次創作のイメージはあまり大きく変わりませんが、顔に下記の画像のようなマークを追加してほしいです：\nhttps://fearandhunger.wiki.gg/wiki/File:Symbol_Rher.png\nhttps://fearandhunger.wiki.gg/wiki/Church_of_Alll-mer_(Rher_Dimension_2)#/media/File:Church_of_Alll-mer_(Rher_Dimension_2).png\nこれはゲーム『フィアー＆ハンガー』の古い神Rherのマークです。\n\n（重要）顔のマークの全体像はこちらの画像を参考にしてください：\nhttps://fearandhunger.wiki.gg/wiki/Engrave#/media/File:Marina_Rher_portrait.png\n左目自体が画像内の点の役割を果たします。\n\nキャラクターのポーズについては、少し邪悪で狂気的、かつ狡猾に振り返ってこちらを見るような感じを希望します。\n以下のポーズを参考にしてください：\nhttps://pbs.twimg.com/media/EYfiUeNU8AArc0v?format=jpg&name=4096x4096\nhttps://seiga.nicovideo.jp/seiga/im8297283\nhttps://www.pixiv.net/artworks/88219312\n\nアバターとして使用したいので、半身像で十分です。もし全身を描きたいと思ってくれるなら、さらに感謝します！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d391107/uploads/origins/49dd24d4-168a-4bf5-876c-5c1c8a425092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98bdf602e0e2389ab078d5a5e2535961", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d391107/uploads/origins/49dd24d4-168a-4bf5-876c-5c1c8a425092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7e4665b898fc5c27c7b6c6a4165525e", "src_set": ""}, "body": "初めてのリクエスト失礼します。\n\nこちらの構図を参考に\n\nhttps://www.pixiv.net/artworks/13297533\n\nリクエストするのはドヤ顔でデカい乳を晒すNSWFなヌードモデルする幽香さんの絵をお願いします。\n\n差分は、\n\n1、普通の服\n2、下着姿\n3、全裸姿\nでお願いします。\n\n要望として乳首と乳輪を気持ち大きめに描いていただければ良いなと、\n\n胸の大きさも大きめに描いていただければ、、、\n\n\n検討した上で応えていただければ幸いです。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 3576099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01220c98/uploads/origins/b0b4d47e-1336-4b12-8ca8-649037fb92f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5156c10a42970eda34a5da6104ba363", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01220c98/uploads/origins/b0b4d47e-1336-4b12-8ca8-649037fb92f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=952a6828d726964df0044b99679b0cf4", "src_set": ""}, "body": "うなのさん\n\nお世話になっております。ケィリンと申します！\nこの度はまた配信活動用のイラストを依頼させて頂きたいです！\n\n\n①用途\nイラストをTwitchのビデオプレイヤーバナー（配信オフライン時に表示される画像）として使用したいため、横長い（16：9とか）サイズにして頂ければと思います。SNS投稿、サムネに使用する可能性もあります。\n\n\n②構図\nうなのさんが過去描かれた下記のイラストのように、宙に浮いてて太ももが強調される構図がいいなと思います！\nhttps://x.com/unanooo_/status/1860590829359989005\nhttps://x.com/unanooo_/status/1904970091034472655\nhttps://x.com/unanooo_/status/1902168897295437996\n\n\n③衣装、表情、雰囲気など\n\n・衣装について、可能であれば下記の参考画像のようなルームウェアにして頂きたいですが、難しければキャラ立ち絵の衣装のまあで問題ないです。\nhttps://jp.pinterest.com/pin/803540758542825222/\n衣装もアクセサリーも、うなのさんのセンスにおまかせして、ご自由にアレンジして頂きたいです！\n\n・表情、雰囲気：\n少し色気のあるお姉さんっぽい雰囲気。カジュアル、リラックスした表情。\n\n\n④キャラクター立ち絵：\nhttps://drive.google.com/drive/folders/1sQnhLwSSiUMU1xtQV2iQuUpaX9DbycDc?usp=drive_link\n\n\n⑤その他\n可能であれば、背景透過または白背景のファイルを頂ければ幸いです！\n\n\nご検討の程、よろしくお願いします。🙇", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 3330191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec331626/uploads/origins/fe6d14f5-539d-4929-af0a-2cd3e1840407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64ed015cb0b1ed60cd3ed716a3187540", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec331626/uploads/origins/fe6d14f5-539d-4929-af0a-2cd3e1840407?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=511863415de7045779b0062edcc396b8", "src_set": ""}, "body": "またまたこんにちは、ff14の忍者が戦闘を終えて疲れ切った表情をしているような絵を依頼したいです\n参考：https://drive.google.com/drive/u/0/folders/1r4zGgFoQyirM3EiUY0btal-XMYSCef80", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 612030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13663e23/uploads/origins/fc1b7599-b99a-47fe-9328-1d6176f84808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9fac52193e4f89b1abe5eb14fd797df4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13663e23/uploads/origins/fc1b7599-b99a-47fe-9328-1d6176f84808?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36bb1365946dd6d8159a36f1300e063c", "src_set": ""}, "body": "うなのさん\n\nまたリクエストさせていただきたいのですがよろしいでしょうか?\n\nキャラクターは資料に載せたうちの子で”ファランクス”をお願いしたいです！\n\n服装はナイトドレスやベビードールなどの簡易なものでポーズや細かいところはうなのさんにお任せします！\n\nよろしくお願いいたします🙇\n\nhttps://x.com/Yukiship5/status/1809941774384967901?t=LD4c3hnS9OpIqemrpvP6cw&s=19", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 3330191, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddec7f81/uploads/origins/7ac0b830-8368-4046-8dc4-24256793d8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=896c272286f0d407737b7d182a2c84dc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddec7f81/uploads/origins/7ac0b830-8368-4046-8dc4-24256793d8f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ccfdb460867dedab692b225c1377f7d", "src_set": ""}, "body": "こんにちは、私のOCを好きなポーズ、好きな表情で描いていただけたらと思います。よろしくお願いします。\n参考：https://drive.google.com/drive/folders/1r4zGgFoQyirM3EiUY0btal-XMYSCef80?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 3406092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c1f9251/uploads/origins/c67d863e-89a3-44fc-8e1a-5575a66518d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13df1f9c54110c9592608ed8f6604e4b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c1f9251/uploads/origins/c67d863e-89a3-44fc-8e1a-5575a66518d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1c78781ca652b52af2e7f09cc554a01", "src_set": ""}, "body": "はじめまして。\n新着でお見かけし、先生のぷくっとした頬、惹き込まれる目、今にも動き出しそうな構図が印象的で、ぜひ自分の新衣装の等身を描いてほしくてリクエストさせていただきました。 \n\nIRIAMで配信活動をしてる碧衣ちょこと申します。 \n\n【特徴】\n・髪:青みがかった灰色、インナーカラー青、前髪の向かって右が三つ編み、ふわふわロング(髪型アレンジ歓迎 例:ストレート等)\n・片耳が出ている\n・胸は大きめだがハリがある\n・目の色は青のグラデーション\nhttps://drive.google.com/folderview?id=1-0acnCC-OyEYAVwISGD1tIaATSEUabC6 \n\n【要望】\n・縦長サイズ\n・衣装は魔法学校の学生服↓\nhttps://drive.google.com/folderview?id=1-49I6vkQW1VJKlOQSVqsxzIpvWT13NEF\n・少し上から見下ろしてる構図\nこちらがイメージに近いです↓\nhttps://www.pixiv.net/artworks/125506302 \n・カメラ目線、両目、口は開いていて、笑顔(可能でしたら差分あるととても嬉しいです！)\n・顔に手は被らないようにお願いします。\n・他衣装の等身に比べ幼く、末っ子ぽく\n(ドレスが20代をイメージしてますので、10代の学生をイメージしてほしいです。)\n・ギャル見があると嬉しいです(制服を好きに着崩してください)\n・髪やスカートがなびいている(今にも動き出しそうな構図をイメージしてます)\n・爪が見える場合、寒色系の色にしていただけると嬉しいです\n・頭部から左右、髪の先、足先までキャンパス内に納まるようお願いします。\n長々と大変申し訳ないです。\n最終的には先生のセンスにおまかせします！ \n\n【使用用途】\n配信・サムネ・SNS・グッズ・印刷物・頒布等 、依頼時の参考資料の1つとして \n\n【お願い】\nスマホでしか保存できないため、PSDファイルの場合はレイヤー数が1つに5枚以下になるようお願いします。\n・背景、人物、コメントを分け、背景透過をお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 698483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44591f1e/uploads/origins/dc2a672a-f2a1-4369-a7c5-dd185249540a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4a9662f12069c529cd7ac00987d38c8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44591f1e/uploads/origins/dc2a672a-f2a1-4369-a7c5-dd185249540a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b323e48e6b10122eff9b8cf8ccb703f", "src_set": ""}, "body": "こんにちは。\n僕のOCを好きなポーズや表情で描いてくれないかな。彼女は内気な性格で、ちょっとオタクっぽいところがあるんだ。\nよろしくお願いします。\n\nhttps://sta.sh/21te1qgcanop", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 2547932, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0fd7641/uploads/origins/31a37c06-5dcf-4b92-8e07-49a8e4479774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f35469dfb1f37c597370ba8685e13f98", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0fd7641/uploads/origins/31a37c06-5dcf-4b92-8e07-49a8e4479774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3047c428d6054626da6652b665563bd9", "src_set": ""}, "body": "うなの様はじめまして\nうなの様の絵柄が新着作品で目に留まり、\n是非オリジナルキャラクターを描いていただきたく、リクエストをお送りいたしました。\n\nうなの様が過去描かれた\nhttps://x.com/unanooo_/status/1862779468571643927?s=61&t=HF8GeIcScr2_9AUPvOSJeg\n座り込むイラスト構図でお願いしたいです。\n(スカートが長めなので構図的に難しい場合は、ポーズはうなの様にお任せします)\n\nデザインは厳密には決まっていないので描きやすいように自由に解釈、省略、補完して描いていただいて差し支えありません\n\n設定は\n・表情が薄めで良くも悪くも素直な魔女。（感情がないわけではない）\n\nご検討の程、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jDKOE3xaLbweTmJTMno6MKZ0AyuhrVSR", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3290572, "client_id": 66613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22b00bd4/uploads/origins/f37523f3-7bf9-4877-842d-e38b171acdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c7c4062043c24122068ccd99caf76e3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22b00bd4/uploads/origins/f37523f3-7bf9-4877-842d-e38b171acdc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c1fcd61e8f325f648347d814c7361ae", "src_set": ""}, "body": "はじめまして。\n先日イラストを拝見しまして、是非にと思いリクエストさせて頂きます。\n\n東方Projectの名無しの本読み妖怪（朱鷺子）をお願いします。\nキャラクター資料：\nhttps://www.pixiv.net/artworks/71694694\n10代前半〜中ば（12〜14）くらいのイメージでお願いします。\n\nうなの様が過去描かれている\nhttps://www.pixiv.net/artworks/125029999\nhttps://www.pixiv.net/artworks/124591463\nこれらのイラストと同様の、ギリギリでスカートで隠して太腿〜お尻のラインが露わになった構図でお願いします。\nロングスカートのキャラですが、要望の構図表現に必要であれば丈を短くアレンジされて構いません。\nキャラクターの表情や雰囲気はちょっと勝ち気な元気っ子っぽい感じでお願いします。\n\nその他は全てお任せいたします。\n\n以上、何卒ご一考の程をよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/71694694", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unanooo_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3290572, "client_id": 733498, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca1ebe1b/uploads/origins/46ca2de7-683f-466a-bfc7-dfae67db24d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97af03db74eda88ea53f8d191b4be3f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca1ebe1b/uploads/origins/46ca2de7-683f-466a-bfc7-dfae67db24d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f06f60a5deee27fd0b34f31b9c91d238", "src_set": ""}, "body": "こんにちは、私はあなたの芸術が好きです。\n\n私のキャラクターをこれに似た服装で描いてもらえますか？(https://drive.google.com/file/d/1koPbDysmlea1JGPPC3Z6fuRjRr58ry1U/view?usp=sharing)\n\n娘のためというたった一つの目標のために、自分の幸せのほとんどを捨ててしまう前の、もっと幸せだった頃の彼女を描くつもりです。\n\nできれば、ドレスは小さめで、ロリータファッションを少しミックスしてほしいです。お読みいただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1X663Hz_PHWbyiG-PZcc8um-i2bTxNmhH?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 537170, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ガオK氏", "screen_name": "GAO_KAWA", "avatar_url": "https://pbs.twimg.com/profile_images/572765875388682240/NS8e70i4.png", "header_url": "https://pbs.twimg.com/profile_banners/131486371/1653526962/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all",