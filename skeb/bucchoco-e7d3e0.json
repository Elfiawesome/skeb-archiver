。\n\n以上となります。\nお忙しいところお手数をお掛けしますが、\nご検討の程宜しくお願い申し上げます。\n\n\n以下、Vtuber2名の参考資料\n==============================================\n御剣カガリ　立ち絵、三面図\nhttps://twitter.com/KagariMitsurugi/status/1481900457039908871\n\n月紫ちょび　立ち絵 、イメージ\nhttps://cdn.discordapp.com/attachments/993415175602438235/993418229961728070/Live2D_.png\nhttps://cdn.discordapp.com/attachments/993415175602438235/993422948620849194/PNG.png\n==============================================\n\nhttps://cdn.discordapp.com/attachments/952595143964364890/1027065863792250880/images.jpeg-85-1.jpg", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bucchoco/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1884780, "client_id": 1288717, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b30acc3/uploads/origins/8a886291-14a0-4f24-88a7-0b15f707cb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9342e504f68f3e0d3e6be1ea7aa36d", "srcset": "https://si.imgix.net/6b30acc3/uploads/origins/8a886291-14a0-4f24-88a7-0b15f707cb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb9342e504f68f3e0d3e6be1ea7aa36d, https://si.imgix.net/6b30acc3/uploads/origins/8a886291-14a0-4f24-88a7-0b15f707cb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f600f0320c8b5b78ecea043de0001f0 2x, https://si.imgix.net/6b30acc3/uploads/origins/8a886291-14a0-4f24-88a7-0b15f707cb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54353e7a53ccc2e0221962b7bfb04005 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b30acc3/uploads/origins/8a886291-14a0-4f24-88a7-0b15f707cb3f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3568ec5c9f19cc4598edadb9eb65069", "srcset": "https://si.imgix.net/6b30acc3/uploads/origins/8a