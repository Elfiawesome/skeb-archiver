0-4d96-9918-702cccef5857?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a41e4881be9e84a0f508dcdfc1a23c7 3x"}, "body": "きりモヤさんリクエスト失礼します。\n\n推している個人Vtuberさんへのファンアートをお願いしたくリクエスト送らせて頂きました。ご都合が合いましたらお願いしたく\n\n個人　Vtuber　戌峯ひぐれさん（@higure_inumine ） \n\n【戌峯さんの三面図↓】 https://twitter.com/higure_inumine/status/1702289934961570276?t=mzAyKplo4AD3s3k-WYB87g&s=19\n\n髪の毛や狼耳が見切れてないイラストとお願いさせて頂きたい構図、バストアップ\n戌峯さんが見上げてる構図でお願いしたいです。\nポーズなどのリクエストはこちらからはないのできりモヤさんの描きやすいポーズでお願いさせて頂きたく\n戌峯さんのYouTuberチャンネルのサムネイルに使用される可能性がありますので背景透過データを頂けましたら幸いです。\n\nファンアートリクエストになりますので戌峯ひぐれさんご本人さまのみイラストの使用許可をお願いしたく、YouTuberのサムネイルやX（Twitter）での使用になります。\n\nご検討して頂けましたら幸いです。\nフブちゃんカワイイかったです！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kirimoya7/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2066558, "client_id": 1134496, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2abbce8/uploads/origins/f9c332c2-385c-4701-8089-731da2c5c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7caa2f6b31c0c47e25abfb5c1cf26733", "srcset": "https://si.imgix.net/b2abbce8/uploads/origins/f9c332c2-385c-4701-8089-731da2c5c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7caa2f6b31c0c47e25abfb5c1cf26733, https://si.imgix.net/b2abbce8/uploads/origins/f9c332c2-385c-4701-8089-731da2c5c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4f5a8d42b5144f69a117acc83df4e5d 2x, https://si.imgix.net/b2abbce8/uploads/origins/f9c332c2-385c-4701-8089-731da2c5c64e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91dbbe42b06cb16844cd6998c4c85a3d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2abbce8/uploads/origins/f9c332c2-385c-4701-8089-731da2c5c64e?bg=%23fff&auto=format%2Ccompres