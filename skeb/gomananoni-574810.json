le.com/drive/folders/128dTxzQZiXZc687vETWgXw7K4DEX82g8", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 573558, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "たわし", "screen_name": "hoisassa__Po1ng", "avatar_url": "https://pbs.twimg.com/profile_images/1778643560885268480/RtfZHCQZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/914379699098234880/1736904939/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1806032, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "わたしちゃんさん", "screen_name": "watasi_ch3", "avatar_url": "https://pbs.twimg.com/profile_images/1425076895796797445/KCezURAa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1017645197402886144/1750865107/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 18, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1895349, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "それわたしの", "screen_name": "wat4si", "avatar_url": "https://pbs.twimg.com/profile_images/1337497903888171014/zknL5wsE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/839125877858324481/1607723176/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2285834, "creator": true, "nsfw