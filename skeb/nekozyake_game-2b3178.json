=200&h=200&blur=200&s=4b5d07f0409e4a3ea6be863f77ba0853 3x"}, "body": "こんにちは！ねこはんてんさん！あなたのイラスト、すごく素敵ですね！私のオリジナルキャラクター「アップルちゃん」のイラストを描いていただけないでしょうか？彼女は自然を愛する、優しく愛らしい女の子で、すべての植物に喜びをもたらすような魔法のような力を持っています。\n\nアイドル風の衣装で描いてください。細かい部分はすべてお任せします。\n\n参考画像：\n`https://70centsapple.top/blogs/#/apple-chan-en` または、もしアクセスできない場合は `https://drive.google.com/drive/folders/1fI7hSL0WOFo9ozBNhjcDuqOyEjUUiQvd?usp=sharing` をご覧ください。\n\nhttps://drive.google.com/drive/folders/1fI7hSL0WOFo9ozBNhjcDuqOyEjUUiQvd?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekozyake_game/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3700115, "client_id": 3787879, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8957de786d8aedfa40e5a0973d19c22", "srcset": "https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8957de786d8aedfa40e5a0973d19c22, https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed76313e95a1f564ccddac56fc3aeefd 2x, https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af3216e21c528af0782c48de832f5309 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fea83cf1848e6efdb4eb1263a1a0a3b", "srcset": "https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fea83cf1848e6efdb4eb1263a1a0a3b, https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03c5df496a48546b5e6c42c901572a20 2x, https://si.imgix.net/c049d6ad/uploads/origins/94c6ba3b-0a87-475d-84fd-d17b2c4edaa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad467328ac83919d96c5863c4cefc1d8 3x"}, "body": "こんにちは！\nいつも素敵な絵を拝見しております。\nこの度、skebを解放されたとのことで、幽幻を描いていただきたくご連絡いたしました。\n\n描いていただきたい内容についてですが、構図はおまかせで、猫半纏さんが描きたいと思った幽幻を見せていただけたら嬉しいです。\n\n雰囲気の参考として、こちらのイラストが特に好きです： https://x.com/nekozyake_game/status/1997622265769553950?s=20\n\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekozyake_game/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3700115, "client_id": 3520844, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163aea6f7748ed9b044c2d08c4d43028", "srcset": "https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163aea6f7748ed9b044c2d08c4d43028, https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=546a2ce2c550312c5c78892bfe6177ac 2x, https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5194997d470843a7b8de8e40cb6281b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e95c018642ce3c87e906f5a9aad0b41d", "srcset": "https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e95c018642ce3c87e906f5a9aad0b41d, https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ded04bfe73d4c78045e6f6d42f861b14 2x, https://si.imgix.net/6b6c686b/uploads/origins/cd1d14cb-09d1-4cc8-863a-5636335e47c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f68b1e2ad3eb543bb6f49159529a3175 3x"}, "body": "綾ナギと申します。\n\n猫半纏様の和風なイラストの数々がとても素敵でリクエストをしたいと常々思っておりました。\n\nもしよろしければご依頼を引き受けていただけると嬉しいです。\n\n＜内容＞\n個人VTuberの蓮希るいちゃんを描いていただきたいです！\n出来上がったイラストを蓮希 るいちゃんへプレゼントさせていただきたいと思います。\n\n＜構図やポーズ＞\n浴衣姿でおまかせでお願いします。\n浴衣衣装は存在しないのでデザインはおまかせします。\n猫半纏様の作品はどれも背景や衣装の描き方が素敵ですのでおまかせした方がよいのかと思っております。\n本人に希望したところ、夏の雑談配信に使えるイラストがあればとても助かりますとの事でした。\nそのためサムネイル映えするようなイラストを描いていただけると助かります。\n髪の毛や左右が見切れないようお願いします。\n可能であれば表情差分をお願いします。\n\n補足しておくと蓮希るいちゃんは配信では明るくて幼めで活発な性格です。\nデザインの参考に連絡させていただきます。\n\n＜ご本人様サイトからの注意点やお願い＞\n以下ご本人様サイトからの文章コピーになります。\n依頼をする際には、このページへのリンクまたはFANBOXのリンクを共有したのち蓮希るいのTwitterや収益化されたYoutubeチャンネルで使用される可能性があること」を依頼文で必ず伝えてください。\n\n▼skebまたは依頼したイラスト\npsdファイル/背景透過ファイルがあると嬉しいです。\nイラストレーター様に依頼していただいたイラストは活動面（サムネイル）で使用できるのでとても嬉しいです！\n\nイラストレーター様にご依頼の際は、二次創作プログラム承認済みですので「蓮希るい」の名前を使用して許可済みだということをお伝えください。\n\n長くなってしまいましたがぜひご検討のほどよろしくお願い致します！\n\nhttps://lit.link/Hasukirui", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekozyake_game/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/75cf3696/uploads/origins/161cdf50-28a1-47b8-8616-ce221c090554?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=20