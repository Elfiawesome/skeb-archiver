6493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6718982fee2d0a5120dd6c2f948612c2 3x"}, "body": "こんにちは、私のキャラクター、イージスのイラストをお願いしたいのですが。\n\nイージスは剣士で、ダンジョンで悪魔に堕ちた後、サキュバスになりました。\n彼女の剣には炎と雷の魔法がかけられている。\n性格はおっとりしている。\n\n好きな姿や衣装で描いてください。\n\nよろしくお願いします。\nhttps://drive.google.com/drive/folders/1FPy24cWKbBIRFQ8HJhZgDq6eZKv523yC?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekozyake_game/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3700115, "client_id": 3517246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d0b3af8f6f9be7f789fa4ef5a24f42", "srcset": "https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61d0b3af8f6f9be7f789fa4ef5a24f42, https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7313025787edac6ac241232e793f6edc 2x, https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e830fea038139948377d1ce19c49dbb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23747da1ef7cd5b46c95b6f765f1f907", "srcset": "https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23747da1ef7cd5b46c95b6f765f1f907, https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5307bdefdafc67ef19176c8cb622cb30 2x, https://si.imgix.net/737a7ef7/uploads/origins/1e518df4-d14e-44ff-bcae-bb28ef801de9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6ffb7cd3ece78ed2fdd9363a01b3c51 3x"}, "body": "こんにちは、猫半纏(ねこはんてん)様！！あなたの作品がとても好きです。私のオリジナルキャラクターの絵を描いていただきたいのですが。\n\n⚪白い髪の子：15歳で、ずっと昔に死んでしまったが、黒髪の男によって蘇らされた。コミュニケーションが苦手で、現在のすべてのものに興味を持っている。黒髪の男の血を食べて生きている。\n\n⚫黒髪の子：18歳で、右目は瞳孔の色が赤い義眼（片目として描ける）をしており、顔には自分でナイフで切った傷がある。いつも笑顔を浮かべており、自分が長くは生きられないことを知っていてもなお楽観的である。\n\n二人の感情：白はとても名高い宗師であるにも関わらず、生涯の記録を一切残していない。黒は、白があまりにも高い位置に立ち、真にこの世界を見たことがないため、死をもって現実の世界から逃れていると考えています。そのため、白を復活させ、彼にこの現実の世界をしっかりと見せたいと思っています。同時に、黒自身も真の白を見たいという願望を持っています。白も黒の行動や考えが面白いと感じたので、二人は名を隠して平凡で騒がしい生活を送っている。黒は白に対して非常に直接的で、ほとんど何でも話すが、ただ一つだけどう切り出せばいいかわからないことがある。それは、彼らの命が繋がっているということ、黒はほとんど自分の命を燃やし尽くして白を復活させたため、彼らには残り二年しか生きられないということだ。\n\n\n\n\n閲覧お疲れ様でした！私は日本语があまり得意ではない…以上の文章は流暢ではないかもしれません、ご容赦ください…！依頼を引き受けていただけると嬉しいです。ありがとうございます！もし金額が希望に添えない場合調整していただけたら幸いです！(｡´-ω)(ω-｀｡)\n\n参考：https://drive.google.com/drive/folders/1WNCJj6XgV_BkphsF5X3juknxjnvEw_sq?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nekozyake_game/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd41206c/uploads/origins/03fc46ee-30db-44f5-94a9-0ea6942eb637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b83c95bfbf6f3fc9b0a32cfed8749535", "srcset": "https://si.imgix.net/dd41206c/uploads/origins/03fc46ee-30db-44f5-94a9-0ea6942eb637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b83c95bfbf6f3fc9b0a32cfed8749535, ht