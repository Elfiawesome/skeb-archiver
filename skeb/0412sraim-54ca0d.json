1-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc1da5b867be81ef2fb895618e490af, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=661449e0433c1b581bc94a4d38e05e33 2x, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45cbd6f6dda0db8be1c5f6bad2f30285 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33f67c55489112d577e1b66194b6b1f", "srcset": "https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33f67c55489112d577e1b66194b6b1f, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10c6a37b1a25a80d10a11a2c3439b449 2x, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4456e2e7ba26381f18db8b6936026ed5 3x"}, "body": "こんにちは、とてもかわいい画風ですね！私のVTuber「ジャミー」のイラストをお願いしたいです。ジャミーはユニコーンとウサギのハーフである「ユニブン」で、人間に変身したキャラクターです。彼女は怠け者で心優しく、コーラや食べ物が大好きで、遊び心がある一方でちょっとおバカなところもあります。また、絵や魔法の才能にも恵まれています。 可愛く描いていただければ、ポーズや表情はなんでも構いません！人間、スライム、そして本来の姿の3つの形態から、お好きなものを選んで自由に描いてみてください！\n\n人間形態のジャミーは、唇の上にほくろがあり、瞳には瞳孔があり、角が1本、頭に耳があり、靴は履いておらず、ヘアクリップを2つつけています。どこに行く時も必ず靴下を履いています！\n\nhttps://drive.google.com/drive/folders/1BdSG0oqKeiYaEwPdoZjF1a1NTbPvqCwU?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0412sraim/w