p/@0412sraim/works/1)の作品のような、キャラにアウトラインがあるタイプの作品をお願いしたいです。\n・ポーズや表情、背景等はお任せでお願いしたいです。\n・キャラの全身が画面内に収まっているか、上と左右が切れていない(下だけが画面端で切れている)構図だと嬉しいです。\n・もし可能であれば、キャラ単体の背景透過画像か、キャラと背景がレイヤー分けされている状態のファイルをいただきたいです。\n\nご検討いただけますと幸いです。よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0412sraim/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3865930, "client_id": 408908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc1da5b867be81ef2fb895618e490af", "srcset": "https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebc1da5b867be81ef2fb895618e490af, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=661449e0433c1b581bc94a4d38e05e33 2x, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=45cbd6f6dda0db8be1c5f6bad2f30285 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33f67c55489112d577e1b66194b6b1f", "srcset": "https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33f67c55489112d577e1b66194b6b1f, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10c6a37b1a25a80d10a11a2c3439b449 2x, https://si.imgix.net/e07a269e/uploads/origins/129679b0-8771-4a96-8331-4f03fb2c7483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4456e2e7ba26381f18db8b6936026ed5 3x"}, "body": "こんにちは、とてもかわいい画風ですね！私のVTuber「ジャミー」のイラストをお願いしたいです。ジャミーはユニコーンとウサギのハーフである「ユニブン」で、人間に変身したキャラクターです。彼女は怠け者で心優しく、コーラや食べ物が大好きで、遊び心がある一方でちょっとおバカなところもあります。また、絵や魔法の才能にも恵まれています。 可愛く描いていただければ、ポーズや表情はなんでも構いません！人間、スライム、そして本来の姿の3つの形態から、お好きなものを選んで自由に描いてみてください！\n\n人間形態のジャミーは、唇の上にほくろがあり、瞳には瞳孔があり、角が1本、頭に耳があり、靴は履いておらず、ヘアクリップを2つつけています。どこに行く時も必ず靴下を履いています！\n\nhttps://drive.google.com/drive/folders/1BdSG0oqKeiYaEwPdoZjF1a1NTbPvqCwU?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0412sraim/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3865930, "client_id": 2825544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/700504e2/uploads/origins/4682f2be-8eb6-4b5b-82d6-d8ac1ece250c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f81bb034670b307f6226a29b85c827ff", "srcset": "https://si.imgix.net/700504e2/uploads/origins/4682f2be-8eb6-4b5b-82d6-d8ac1ece250c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f81bb034670b307f6226a29b85c827ff, https://si.imgix.net/700504e2/uploads/origins/4682f2be-8eb6-4b5b-82d6-d8ac1ece250c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=07675cd1e30b908c911774993d6d32df 2x, https://si.imgix.net/700504e2/uploads/origins/4682f2be-8eb6-4b5b-82d6-d8ac1ece250c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fff68182fff2af391c8feb8f9168f1ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/700504e2/uploads/origins/4682f2be-8eb6-4b5b-82d6-d8ac1ece250c?bg=%23fff&auto=format%2Ccompress&f