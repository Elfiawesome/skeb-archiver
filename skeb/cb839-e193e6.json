立って正面を向いた状態でタイツとパンツを少し下げ、片手でスカートをたくし上げて局部がちゃんと見えるようにしてくれている\n反対の手で手コキをしている\n\n嫌悪感は無く、表情はちょっと笑みがある\n余裕とも取れるし母性とも取れるような顔\n\n男は竿だけで←\n\nよろしくお願いします……", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cb839/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1211072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8af2f580f755e010a32d0773f5daf46a", "srcset": "https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8af2f580f755e010a32d0773f5daf46a, https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d906ab8340cf93cbd308fac7d057c1f1 2x, https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23438eafd743c6a26a1c7e8b967a864e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=502dc9872933501fa42c718b2d6d7af3", "srcset": "https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=502dc9872933501fa42c718b2d6d7af3, https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54a4b5ce9a6c2257c6fbb41a1dccfdb7 2x, https://si.imgix.net/d7970dd1/uploads/origins/526d87ff-a6f8-485c-bae7-d9c6f883d3e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2652b6f1a7e7292e50e70eb2ef7a1db1 3x"}, "body": "初めまして。\nいつも素敵なイラストを楽しく見させていただいている者です。\n\nskebを開始されたということでイラストをリクエストさせていただきたく思います。\n\n<キャラクター>\n艦隊これくしょんのヴェールヌイ\n\n<背景>\n・夏の晴れたビーチ\n・海はエメラルドグリーン〜ターコイズブルー(南の海のイメージ)\n・砂浜から水平線を見る形\n・遠くに入道雲\n\n<シチュエーション・特徴>\n・全身が見える構図\n・靴を持ってこちらに振り向いてる\n・優しい感じの笑顔\n・暑いため顔や脚に少しだけ汗が流れる\n・ソックスは履いておらず裸足\n・足首あたりまで海に入っている\n\n・身長は少し高め(以前描かれていたこちらの冬月ほどの頭身でお願い致します)\nhttps://x.com/cb839/status/1776967740013887794?s=46&t=8x6WPLS49eHSuLZZg5ocjA\n\n以上になります。\nもし描いていただけるようであれば楽しみにしております。\nよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cb839/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1211072, "client_id": 784550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4285a290aa9a2ac99a71843ad28111", "srcset": "https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe4285a290aa9a2ac99a71843ad28111, https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6705f447f2810ae7a42e133797e448ba 2x, https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=947e052eb4886a61b174b94d4fd6849f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f24783f7d54a71e7b69a4b69ae299a8", "srcset": "https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f24783f7d54a71e7b69a4b69ae299a8, https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a00b7b2a7988c12094aa13a041d58d4 2x, https://si.imgix.net/8800ee00/uploads/origins/709d462d-093f-41c8-8884-bb7fadcf5f11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9885ad696f53a9e6cde5b06805bf0154 3x"}, "body": "こんにちは、REEEさん。飛び石と申します。\nいつもイラストを楽しく拝見しております。 \n今回、艦隊これくしょんに登場するキャラクターの初月のイラストをお願いできないでしょうか？\nイラストのイメージは以下の通りです。\n○キャラクター\n 初月\n○衣装\n端が所々破れたウェデイングドレス\nドレスに不釣合いなショットガンを一丁手にしている\n○表情\n提督を守る、と決意に溢れた表情\n\n○シチュエーションの補足説明（読まなくても大丈夫です）\n初月と念願のケッコンカッコカリを迎えた提督。\n部下の艦娘達が本物の披露宴に負けないような盛大な宴を催してくれる。気持ちの良い酔いで幸せな心持ちの中、部屋に戻り初夜を迎えようとした提督＆初月を模擬弾の雨が襲う。\n混乱する提督に初月はどこからか取り出したショットガンで応射した後に説明する。\n「この鎮守府では初夜の日の日付が変わる一時間の間だけ、ケッコンカッコカリできなかった艦娘はケッコン艦を倒し、提督との初夜を奪う権利が発生する」と。\n初夜と提督の貞操を賭けた一時間の死闘が今、始まる━━\n\nという艦娘初夜合同に寄稿予定のお話のイメージビジュアルが見たいなぁ、と思ったのが今回の依頼のきっかけです。\n\nドレスのデザインや構図などはお好きに描いていただいて構いません。\nどうぞ、ご検討ください。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cb839/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1211072, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc810bc5/uploads/origins/71de453f-9674-463c-b366-df9aefcb3819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67bcffcdf3729e669fa3734dff5d8fbc", "srcset": "https://si.imgix.net/fc810bc5/uploads/origins/71de453f-9674-463c-b366-df9aefcb3819?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67bcffcdf3729e669fa3734dff5d8fbc, https://si.imgix.net/fc810bc5/uploads/origins/71de453f-9674-463c-b366-df9aefcb3819?bg=%23ff