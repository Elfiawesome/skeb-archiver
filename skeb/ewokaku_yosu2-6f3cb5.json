ルーファスは戻ってきて、ローハンが自分の服の匂いを嗅いでいるのを見つける。\nルーファスはその後、ローハンを性的にいじめる。彼はローハンに本物の匂いを嗅がせようと誘い、ペニスをローハンの顔につける。\n性行為は何でもありだ。例えば、ルーファスが足でローハンのペニスをこする、ローハンがルーファスにフェラチオをする、ローハンがアナルセックスを受けるなど。先生はシナリオを自由に変えることができる。ルーファスに欲情したローハンをルーファスがエロいじめをする、みたいな雰囲気が強ければ嬉しい。\n\nいずれにせよ、このリクエストを読んでくださってありがとうございました！\n\nhttps://drive.google.com/drive/folders/15rErWQX3nqefhfrto8bnBe8kNhev6zTx?usp=drive_link", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ewokaku_yosu2/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5d400537/uploads/origins/ebdfb706-26ac-4928-bacf-c968d6174406?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f0ccc1dbbd42ba6af863ff1f74d8e6c", "srcset": "https://si.imgix.net/5d400537/uploads/origins/ebdfb706-26ac-4928-bacf-c968d6174406?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8f0ccc1dbbd42ba6af863ff1f74d8e6c, https://si.imgix.net/5d400537/uploads/origins/ebdfb706-26ac-4928-bacf-c968d6174406?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c7f8de77439987f97814facc0ec0b6ce 2x, https://si.imgix.net/5d400537/uploads/origins/ebdfb706-26ac-4928-bacf-c968d6174406?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=668f0e1e1f86e4e6101ca067deefe6c2 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2877550, "client_id": 1154223, "nc": 48}, {"path": "/@ewokaku_yosu2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2877550, "vtt_url": null, "thumbnail_image_urls": 