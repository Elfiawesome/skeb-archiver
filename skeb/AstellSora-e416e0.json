29c/uploads/origins/cc5ccbe7-e824-4d4f-8d2a-6c135234cc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f5a21912b2ef973eb50015e5fa5485b", "srcset": "https://si.imgix.net/6436a29c/uploads/origins/cc5ccbe7-e824-4d4f-8d2a-6c135234cc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f5a21912b2ef973eb50015e5fa5485b, https://si.imgix.net/6436a29c/uploads/origins/cc5ccbe7-e824-4d4f-8d2a-6c135234cc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93c65c87eed179df6ecc69170df448cc 2x, https://si.imgix.net/6436a29c/uploads/origins/cc5ccbe7-e824-4d4f-8d2a-6c135234cc6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=795d3fe609f8338f2b219b92e7a7f805 3x"}, "body": "アステル様こんにちは。お世話になります。今回ご依頼したいのは私のオリキャラで、名前を「たまランド」といいます。\n\nたまランドは猫耳の生えた人間です。年齢は２歳、性別は不詳。（私が決めていないことからどちらにも成れるので、お好きな性別で解釈して構いません。）\n涙もろく、感情の起伏が激しいです。自分は可愛いと自覚しており、かわいがることを他人に強要します。\n\n下まつげが三本あり、目はピンク色。口内は黒とピンクでギザギザの歯をしており、歯が見えるように笑うことが多いです。髪としっぽはピンク色、先が黒色をしており、しっぽはハート形の鍵しっぽになっています。\n\n見た目に関する資料を添付していますが、髪型や顔以外の衣装やパーツはアステル様が描きやすいものに好きに変えていただいてもかまいません。\n\n構図などについては、ピンクや黒多めで、手でハートを作っていると嬉しいです。が、なくてもかまいません。アステル様の描きやすい構図で自由に創造していただければと思います。\n\n使用用途は基本鑑賞用で、アイコンに使用したりなどさせていただくと思います。\n何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1S4Lalq6HDR2g1Cn8Zwd15svEUAFpOMUZ?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AstellSora/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1140153, "client_id": 2285277, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/602d979c/uploads/origins/680a282e-5664-4e9d-9ff8-a12529600f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5b27295119a00dad5ccae8f2b166a90c", "srcset": "https://si.imgix.net/602d979c/uploads/origins/680a282e-5664-4e9d-9ff8-a12529600f89?bg=%23f