op&crop=top&w=200&h=200&blur=200&s=1fc55627c8a7a52c956c55ea5ea35ba0 3x"}, "body": "せら みやち様\nサリサイ風味で描いていただけないでしょうか。もしよろしければ。\n\n二コマ風で\n①\nサリアがイフリータと遊んでやっているところに\n画面外のサイレンスがぼそっと「あなた　案外いいママになりそうよね」と言う\n②\nサリアは思いっきり赤面して何も言えない\n画面外のサイレンスが（えっ、何その反応！）と焦っている\nイフリータはにやにやしている\n\nという内容です。適宜アレンジください。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sera_miyachi38/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 737207, "client_id": 103872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed12a1c722887c4b8e373e2c6fe6fd83", "srcset": "https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed12a1c722887c4b8e373e2c6fe6fd83, https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2bd80cc7864c7cd3741b17ccf73ec97 2x, https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89d9647ba1bde490f558caebb317d351 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ec08a4e56c8cfd063afe1107bfb2879", "srcset": "https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ec08a4e56c8cfd063afe1107bfb2879, https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab57ab78ede85b37036b5907fa5d94a3 2x, https://si.imgix.net/74951035/uploads/origins/0cb76a2e-d89c-44da-a1fa-91a624dac6d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eaea16efc1ff4fbc2827656d852bd43e 3x"}, "body": "せら みやちさん、はじめまして。\n\nよろしければアークナイツのロスモンティスを描いていただけないでしょうか。\nポーズやコーデの種類など細かい指定はございません。\n納品形式はpsdだと嬉しいです。\n\nまた以下の通りクライアントに紐付く各種SNS（TwitterやMisskey、Mastodon等）で利用させていただく場合がございます。\n\n・アイコン\n・ヘッダー\n・スマートフォン等の壁紙\n・上記各種SNSへの作品投稿（紹介目的に限定しSkebのURLを必ず併記します）\n・その他Skebの利用規約やガイドラインで許可されていること\n\nご検討くださいますよう、お願いいたします。\n\n※参考：「アークナイツ」二次創作・ゲーム実況配信及び動画投稿に関するガイドライン\nhttps://arknights.jp/fankit/guidelines", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sera_miyachi38/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 737207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9973f618e5e1dff09a9c2766cac43b3f", "srcset": "https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9973f618e5e1dff09a9c2766cac43b3f, https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36264ad67111c87e6109c4e5a8a50ef5 2x, https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcebf1981512d124d6155858b3b5bafe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf3e0677c5bc02f3566a65f6f0e0d5ba", "srcset": "https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf3e0677c5bc02f3566a65f6f0e0d5ba, https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4cf74628ad571126861eedf49faac3f 2x, https://si.imgix.net/ac385ae4/uploads/origins/652308cb-22dc-49a0-8cb9-8baab5f6566b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae722d208b83538ae5263f5a1f04d049 3x"}, "body": "こんにちは、アークナイツの蜜蝋（ビーズワックス）とカーディガン（カーディガン）の百合をリクエストしたいです。\n\n\n蜜蝋（ビーズワックス） - https://drive.google.com/drive/folders/1vi8CUECTZQ5oxrymY7zE35NvaoNYt7k2\n\n\nカーディガン (カーディ) - https://drive.google.com/drive/folders/1bj7fAuRMq2NkuHA6EHtXPGUWHwoe93oC\n\n\nあなたの長所を生かしたい。だから、2人のフレンチキスをリクエストします。\n\nカーディガンはとても執着するように描いてください。彼女は蜜蝋から離れたがりません。\n蜜蝋にはもっと抑制してほしいのですが、彼女はカーディガンを迎えることをとても喜んでいます。\n\nその他の愛情表現も大歓迎です！\n\nその他、百合を盛り上げるために、何でも自由に追加してください。私はそれを奨励する！\n\nhttps://drive.google.com/drive/folders/1UIICDE4UxnDNLNbC-pBSLvb-fWsVOT18?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sera_miyachi38/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 737207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8db33db/uploads/origins/b54e8323-6492-4a46-8585-957f9673e6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84d9728b56a500cd3de31aeee78d98b2", "srcset": "https://si.imgix.net/e8db33db/uploads/origins/b54e8323-6492-4a46-8585-957f9673e6c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84d9728b56a500cd3de31aeee78d98b2, https://si.imgix.net/e8db33db/uploads/origins/b54e8323-6492