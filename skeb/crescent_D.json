ion", "default_amount": 500}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 602, "received_works": [{"path": "/@crescent_D/works/122", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5d4df34/uploads/origins/15348025-0c03-4866-930c-bf3caf17a58a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfbe6d1b0af9a3458538a576a077d295", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5d4df34/uploads/origins/15348025-0c03-4866-930c-bf3caf17a58a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7a5cd857c49d0ea9e8508536116031", "src_set": ""}, "body": "以前に黒アリスの依頼を出した者です。\n今回は、東方ロストワードの「[紅EX]名もなき大きな小さな悪魔 小悪魔」のイラストを描いていただけないでしょうか。\n内容は以下のようなものになります。\n\n○小悪魔が決めポーズを取りながら、アームズフォート・アクアビット本社の主砲の発射を命じる構図\n「アクアビット・イレイザーフォーメーション！！」\n(【東方手書き劇場】ＶＡＮＧＵＡＲＤ　ＯＶＥＲＥＤ　ＣＨＥＡＴ　後編と似たような感じ)\n\n詳細な構図やポーズなどは全てお任せします。\nよろしくお願いします。\n\nアクアビット本社参考：\nhttps://www.nicovideo.jp/watch/sm13130778", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/121", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b1596c7d/uploads/origins/5df0634f-2b20-471d-a42b-619f7f8e2d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c3cee59152aeaa6c6ed21c6dc247d38b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b1596c7d/uploads/origins/5df0634f-2b20-471d-a42b-619f7f8e2d1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9869efac3a2e3ab3509a663b5def7967", "src_set": ""}, "body": "リクエストお願いします。\n\nマクロスFのヒロイン、シェリル・ノームのイラストを数枚お願いしたいです。\n真っ白な花嫁衣装と下着姿が合わさったブライダルランジェリーの格好で、抱き枕の絵のように肢体を魅せながらベッドに横たわっている姿のイラストをお願いします。\n\n一枚目は衣装を全て着用して恥ずかしそうにしながらも相手を見据え「ここにいるシェリルは、あなたのものよ」と相手に身も心も捧げる覚悟を決めるシェリルを描いていただき、差分として2枚目でブラを外され、3枚目でパンツを脱がされ、4枚目で事後っぽく少し乱れて息づかい荒く目がハートになって「アルト…愛してる」と呟く\nこういう流れの絵にしていただければと思います。\n\n\nなお、相手は早乙女アルトを想定しております。\nご検討よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/76418091", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/120", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 203844, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d19f9bf6/uploads/origins/37f4f18d-880e-4304-9ac4-123daece3557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b904addac9875079145effb969723b8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d19f9bf6/uploads/origins/37f4f18d-880e-4304-9ac4-123daece3557?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1a0e6a8c2fa314669364ea3cd08b2a0", "src_set": ""}, "body": "いつも楽しませてもらっております。\n以前、シェリルにエッチなイタズラをする闇ランカのイラスト（https://skeb.jp/@crescent_D/works/84）をリクエストさせて頂いた者です。\nこのイラストの続きの展開を、コミックでリクエストさせていただきたいと思います。\n\n①シェリルが闇ランカの顔面を掴んで握ってお仕置き（いわゆるアイアンクロー）。\n「おイタが過ぎるわよ💢どういうつもり？」と怒る\n②闇ランカは手をばたつかせながら「銀河の妖精の立派なものを鷲掴みするチャンス、一生に一度あるかどうか…」と弁明する。\n③闇ランカは一瞬のスキをついて「セカンドチャンス🩷」といいながら、今度は正面からシェリルの胸を鷲掴みにして揉みしだく\n④驚きのあまり叫びながら手を離してしまうシェリル。そこで更に「ワンモアチャンス！」と叫んでシェリルの胸元の衣装をずり下げて乳房を露出させ、乳房に顔を埋める闇ランカ\n⑤最後に「私は今日（も）銀河の妖精のちちを揉みました」というプレートを首から下げて正座させられて反省させられる闇ランカの絵で終了。\n\nという展開でのコミックを作成していただければと思います。細かく書きましたが、都合に合わせて修正していただいて結構です。\n\nちなみにこの展開は、最近放送された「男女の友情は成立する？（いやしない）」というアニメの第1話のシーンを参考元にしています。\nご検討のほど、よろしくお願いします。\n\nhttps://x.com/chisehatoriban/status/1908226414995767542?s=46&t=Mw4yJ5VUm4H4nE8_xY0i4Q", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/119", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 276741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81bf071c/uploads/origins/51a96d30-7dcb-4a80-b776-c79bb1dee517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f249f46c9e3c82b2c90dee0c46138511", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81bf071c/uploads/origins/51a96d30-7dcb-4a80-b776-c79bb1dee517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94e384d82b2cc443912dc839b4df8515", "src_set": ""}, "body": "いつも楽しみにしております。\nリクエストお願いします。\n\n「ゴブリンスレイヤー」の登場人物である剣の乙女が、主人公のゴブリンスレイヤー（以下、ゴブスレ）に挿入され快感を覚えさせられる絵をお願いします。\n\nシチュエーションとしては\n・場所はベッドの上\n・お互いに裸。ゴブスレは兜は着用後。\n・体位は正常位で、ゴブスレは剣の乙女の下腹部を押さえつけてWポルチオ責めをする。\n\nこうなった状況としては\nかつてゴブリンに凌辱された過去を持つ剣の乙女のトラウマを克服するため、ゴブスレが剣の乙女の身体を抱いて性の快感を覚えさせることで忌まわしい記憶を忘れさせようとする。\n剣の乙女は、最初は未経験の快感に「怖い」「やめて」と怯えるも、ゴブスレから「駄目だ」「お前の中のゴブリンの記憶を打ち消すまで離さない」「お前を苦しめるゴブリンは、俺が殺してやる」と言って責め続ける。\nもともとゴブスレに恋してる剣の乙女は、やがて快感を受け入れて目がハートなトロ顔になる。\nというのを考えてます。セリフについても出来れば入れていただけるとありがたいです。\n\n剣の乙女については、彼女のトレードマークである目隠しをしているバージョン、目隠しを外した状態で怯えた涙目をしてるバージョン、快感を受け入れて目がハートなトロ顔になってるバージョンを用意して頂ければと思います。\n\nご検討よろしくお願い致します。\n\n\n参考画像\n剣の乙女\nhttps://www.pixiv.net/artworks/111285039\nhttps://www.pixiv.net/artworks/92637260\nゴブスレ\nhttps://www.pixiv.net/artworks/89891627", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/118", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 203844, "client_id": 844524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a3d3844/uploads/origins/83914bfe-dd40-4aa2-ada5-4e08e56b2673?bg=%23fff&auto=form