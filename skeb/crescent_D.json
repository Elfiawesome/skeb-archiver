=webp&fit=crop&crop=top&w=200&h=200&s=b28e6c467284b4d76a48aff1e4d40e85", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27a8e4c6/uploads/origins/131bd24a-6bbd-425d-901c-70d5d20cac0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab8702fb51fc11e730eb22ae79f52b4", "src_set": ""}, "body": "お久しぶりです。\n\n以前、リクエストさせていただいたシェリルとクリスマスをテーマに、改めてリクエストさせていただきたいと思います。\n\n\nまず、このクリスマス衣装（https://x.com/uta_macross/status/1075662336021708801）のシェリルにサンタ帽子をかぶせ、右手にクリスマスケーキが乗っているお皿を持ち、もう片方の手にイチゴの刺さったフォークを持たせたイラストを希望します。\n\n続いて2枚目で、誰かの手がシェリルの衣装の胸元をつかんでずり下げたので、豊満な胸が露にされて慌てている構図でのイラストをお願いします。\n\nそして3枚目で、誰かの手がシェリルのスカートをつかんでずり下げたため、下着とガーターベルトも露にされて顔を赤くして涙目になってる構図をお願いします。下着はクリスマスらしく赤い紐パンにしていただければと\n\nシチュエーションとしては\n①「メリークリスマス♪さあ、クリスマスのケーキよ」といってケーキを配ろうとするシェリル\n②そしたら「こっちのプリンのほうが食べたいです」と言わんばかりに胸を露出させられる\n③そして「私はこっちのケーキがいい」と赤い下着を露出される\nというのを想定しています。\n脱がしている相手は手だけ映るような構図でいいですが、私としてはランカと闇ランカの二人を想定しているため、女の子の手にしてくれると幸いです。\n\nクリスマスも近いため、クリスマスにちなんだリクエストとなりますが、ご検討宜しくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/108", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 420085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5506d3c6/uploads/origins/6230facd-58f1-4f4f-b5d0-bec9ddbf3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c26db7f95f2e2e8c6d2d6c5d18d561f6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5506d3c6/uploads/origins/6230facd-58f1-4f4f-b5d0-bec9ddbf3bf8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a75caf4d30e9985fc6f4617223af1ba", "src_set": ""}, "body": "アピールありがとうございます。\n早速リクエストさせていただきます。\n\n依頼内容ですが、大きなシャボン玉の中で服を溶かされてしまい裸にされて、弾力のあるシャボン玉に股を開かされたり顔を膜に押し付けられたりといったようなエッチな格好をさせられてしまうフーナちゃんのイラストをお願いいたします。\nNSFWをオンにいたしましたので、存分にえっちぃく描いていただければと思います。\n\nフーナちゃんは、白人と魔法使いのハーフで金髪ポニテのEカップ、スタイル抜群な女の子になります。 もう1人のうちの子である柚夢の事が大好きすぎて、耳に肉球ピアス、髪には三毛猫柄のリボン、猫モチーフな服装と色々工夫しています。また、人や物を好きなように膨らませるという能力を持っています。 詳細は、資料URLやskebの送信したリクエストを参考にしていただければ幸いです。\n\nあと、宛名については、ゆゆにゃんへ、とさん付けなしでお願いいたします。\n\nまた、もしよろしければなのですが、ミニキャラとかでもいいので、ゆゆにゃんも描いていただけるととても嬉しく思います。\nゆゆにゃんについても資料URLより設定などを確認出来ます。\n\n烏滸がましいリクエストですが、ご検討のほど、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/123502936", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/107", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 456773, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9274cd7/uploads/origins/d3664f52-df91-4e54-889a-02ffac49c364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06d5ea992de9caf71174ac3b1095bfc8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9274cd7/uploads/origins/d3664f52-df91-4e54-889a-02ffac49c364?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1eb82fe2dcd948c940a3af80742040b", "src_set": ""}, "body": "アピールありがとうございました。\nだいぶ時間がたってしまいましたが\nクレセントさんの絵柄でうちの子を見てみたいと思い、今回ご依頼させていただきました。\n\n■依頼内容\nうちの子（薬王樹カカオ）のイラストをお願いします。（資料URL内に画像いくつかおいておきます。）\n\n・ポージングはおまかせします\n・服装はおまかせします\n\nhttps://drive.google.com/drive/folders/1-MBJYScOtdxkPBehrsM_s7sIMQfbopZP?usp=sharing", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/106", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 558031, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53c0c1e0/uploads/origins/8ba51b7d-3d7c-4fcf-978a-af033977f5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=160ed02fa136779e6eb9e986a2ff5445", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53c0c1e0/uploads/origins/8ba51b7d-3d7c-4fcf-978a-af033977f5de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b158a7c2a1377cc0035926d9a0a3b68b", "src_set": ""}, "body": "あなたの絵はどれもすばらしく、私のキャラクター、ステラをあなたのスタイルで見てみたいです。\n\nhttps://files.catbox.moe/htc8al.jpg\n\nhttps://catbox.moe/c/3l4hxd", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/105", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 1383730, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5b59025/uploads/origins/492d30f6-9e9a-47f4-b650-e72a1dfe7634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa0d76e703a527a57124a729861ee534", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5b59025/uploads/origins/492d30f6-9e9a-47f4-b650-e72a1dfe7634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16202eb5b45c5836fe18b481cddc2cf9", "src_set": ""}, "body": "クレセントさん、こんにちは。\nアピールを頂きました禾ズ真と申します。\nこの度は自創作のキャラクター、特にピュリファと紗雪を気に入って頂き嬉しいです。\nありがとうございます！\n\n実は以前からクレセントさんのことを存じていまして、作品を購入したり余裕がある時にpixivの別名義にてささやかながら支援させて頂いたこともあります。なのでアピールをいただいて少しびっくりしております。(人外化しちゃったモンクちゃんが好きです)\n\n今回は紗雪を描いて頂きたいと思います。\n資料はこちらになります。\nhttps://note.com/psyan75_17_ra/n/nd49c1e4c5f21\n\n紗雪は異国に出張してサンタガールのアルバイトをしている雪女で、子供好きなうえに同僚や親友が年下なのもありお姉ちゃんぶる性格をしています。\n雪だるまイメージのお団子ヘアやツララになったモミアゲが特徴で、おもちゃの他には溶けないアイスをプレゼントしたりかまくらを作って遊んであげたりします。\nまた、和洋折衷の服を好んでいます。\nサンタとしては頼れる先輩として振る舞いますが、オフの時はかなり天然な性格です。\n\n以上の説明を元にクレセントさんのイメージで紗雪を描いて頂けるとうれしいです。\n構図はお任せします。\nリクエスト内容に不備がなければ、よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/104", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 55900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f36661b/uploads/origins/7d03d040-bdba-4225-b348-69daa3b9ad1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891f1c1dc8538ae1189746364092407f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f36661b/uploads/origins/7d03d040-bdba-4225-b348-69daa3b9ad1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70101f3a7e5f8e3212975197b1f73a61", "src_set": ""}, "body": "初めまして、アピールありがとうございます。うちの子の「那須野葉月」のイラストの作成をリクエストさせていただきます。\n\nキャラ参考　https://wiki3.jp/minominutinoko/page/15\n\nシチュエーションはアピール内にもありましたが、私が以前他の方にリクエストしたイラスト（https://skeb.jp/@ratunitu_EN/works/88）のような感じで「ダンジョン（あるいは洞窟）内でゴブリンのような小人モンスターに輪姦される」でお願いしたいと思います。\n\nそれと、こちらが提示した予算で可能な範囲で構わないので、「中出し＆ぶっかけられる」「何度も中出し＆ぶっかけられて全身精液まみれ＆ハイライトオフ状態」「凌辱が終わった事後状態」のイラストも作成していただければと思います。アピールをいただいて少々時間が経ってしまいましたが、ご検討よろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/103", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 36992, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b44b03f/uploads/origins/1ad79bab-ea81-4fa1-8050-8742c4dbaba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cae7eeb2a948b9a38e41d1632c0f827c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b44b03f/uploads/origins/1ad79bab-ea81-4fa1-8050-8742c4dbaba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c19673d6619b6c55919bb6b2fa7f3b39", "src_set": ""}, "body": "初めまして、この度はアピール頂きありがとうございます。\n素晴らしい機会を頂けましたので、僭越ながらリクエストさせて頂きます。\n今回描いて頂きたいのはゲーム「アズールレーン」の「ロドニー（META）」になります。\nシチュエーションはロドニー（META）がひざを折った状態で座り込み、右手を地面についていて、左手でその右腕を掴んでいるポーズを取っている状態です。\n全身を頭からつま先まで描いて頂ければと思います。\n胸元の服がはだけて下にずり下がっており、両胸が露出した状態です。\n右腕を掴んでいる左腕の上に両胸が乗っている状態で、胸の豊満さが強調されたポーズになります。\n両胸の乳首からは母乳が噴き出して零れて垂れている状態です。\n表情は公式のイラストのように憂いを帯びた感じですが、よく見ると頬が赤く染まり、控えめに開いた口からは熱い吐息が漏れて性的興奮を感じているものになります。\n背景は特に描いて頂かなくて問題ありません、ロドニーの色白さが映えるように暗い感じの色を置いて頂けるとありがたいです。\nまた艤装やマントは省略して頂いて問題ありませんが、袖の部分は描いて頂ければと思います。\n詳しいイメージや参考資料は下記Googleスプレッドシートにまとめましたので、ご参照頂ければと思います。\n\nhttps://docs.google.com/spreadsheets/d/11-d0tKWT2Q41D06HLyuLrWHT1VZn-u8btEmwINgqav8/edit?gid=0#gid=0\n\nもしよろしければご一考の程、何卒よろしくお願い申し上げます。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/102", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 203844, "client_id": 844524, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/722e49cd/uploads/origins/28a36625-f0f1-4e50-b723-b46b4e5b0adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df75a5d3be9619c4c1c198f2bb56e36d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/722e49cd/uploads/origins/28a36625-f0f1-4e50-b723-b46b4e5b0adf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4a869cea25f181eb147c078674c3203", "src_set": ""}, "body": "コミックでのリクエスト失礼します。\nアリス・マーガトロイドちゃんが永江衣玖さんとの弾幕ごっこに負けてしまい、衣玖さんがアリスちゃんを地上に返そうと思ったらボロボロになって痺れて起き上がれず、苦しそうに息切れしているアリスちゃんを見た衣玖さんが「アリスさんをめちゃめちゃに可愛がりたい」という空気を読み取ってしまい、羽衣で縛り上げられて電撃で可愛がられる漫画をお願いします。\nアへ顔や白目はNGで、両目閉じての悲鳴を上げる表情多めだと嬉しいです。\nどうぞよろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/101", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6531b63/uploads/origins/d58869c4-a84c-4556-a511-e5f54d59f17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c35eacb9721ea9b4f57f29a43e41b0df", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6531b63/uploads/origins/d58869c4-a84c-4556-a511-e5f54d59f17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea8222f5070801f15de6771f26eeef1a", "src_set": ""}, "body": "ダンジョンに鎖でつながれた私の裸のキャラクターを描いてください！\n参考：https://skeb.jp/@crescent_D/works/100\n恥ずかしがって涙目になる表情が欲しい。\n\nこんな流れでお願いします：\n1.彼女は裸で鎖につながれている。\n2.彼女の脇の下、口、ヴァギナの前にチンポが現れる。\n3.すべてのチンコが挿入される。\n4.すべての♂がオーガズムを迎える。\n\n彼女はいくつかの異なる表現を持つことができます。\n\nhttps://drive.google.com/drive/folders/1jJHzHPOjy1y7UA8nGYxavvqxEmpWsSHa?usp=sharing", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/100", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 2180082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a97fc549/uploads/origins/0553d3a6-5d0e-48ef-8210-d91a019512e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=059f626cdfef144e4358a6834841847e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a97fc549/uploads/origins/0553d3a6-5d0e-48ef-8210-d91a019512e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83776c27237d89a49d3528b45c877a9c", "src_set": ""}, "body": "お返事が遅くなりました。もしよろしければ、キリエが縛られ、両腕を頭の上に上げて宙吊りになり、脇の下と足をそれぞれ1本ずつ浮いたペニスにこすりつけられるというのをやっていただけませんか？しばらく擦られた後、それぞれのペニスがイク。\n\n彼女の肛門と膣から精液を垂らして、擦られる前に彼女と謎のペニスがすでにセックスしていたことにしたい。\n\n腋毛があるバリエーションも入れていただけるとありがたいです。\n\nhttps://drive.google.com/drive/folders/1-95vve3TA6naMBdXrAbM3YgaURBk30Sh?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/99", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 3209002, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00a5a632/uploads/origins/47e52d71-3527-4308-9724-9b5e06cf6f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3eac00f64b2fd00138186ac56397486", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00a5a632/uploads/origins/47e52d71-3527-4308-9724-9b5e06cf6f2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65f739d71756739c35f033c6e254d59f", "src_set": ""}, "body": "クレセント　様\n\nいつもお世話になっております、\n酒屋野びぃるです。\n配信、コメント＆登録、しかも私にとって記念の222人目！！大感謝です。\n今回は、Skebのお願いをしたく、ご連絡させていただきました。\nちちがBカップ、身長166センチ、180デニールの黒タイツです。\nつまり、ちっぱいです。\n資料のたまちゃんは浮遊タイプ、缶ビールのデザインは使用可能なものです（使っても使わなくてもOKです）。\n全身でも上半身のみでも、大丈夫です。\n何卒よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fi/8b71cb2vlwb921nvtfmsv/sakayano.zip?rlkey=0co24wvdf7orzuaqqpdrs87au&dl=0\n\nhttps://www.dropbox.com/scl/fi/8b71cb2vlwb921nvtfmsv/sakayano.zip?rlkey=0co24wvdf7orzuaqqpdrs87au&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/98", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 630986, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b92d520/uploads/origins/438d644a-41c3-4e86-83c2-5b6432db0857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fad43156064bfd418b93fd9137d6676c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b92d520/uploads/origins/438d644a-41c3-4e86-83c2-5b6432db0857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=437025130b9a56bcce006a41dddaf153", "src_set": ""}, "body": "アピールをありがとう！遅くなって申し訳ありません。ご提案いただいたシナリオ、とても気に入っています。\n\n宇佐美すみれ子さんには、身長～10kmくらいの巨大になってほしいです。彼女は、あなたが言ったポーズで、人口の多いダウンタウンの上空に座っているでしょう。最も高い高層ビルは、彼女が座っているときに彼女の股間に届くのがやっとで、彼女にとってビルは草ほどの高さだ。全体的に、彼女の体はとても曲線的でセクシーで、両腕の間には大きな胸がすぼまり、太い太ももを広げてふくらんだ股間を見せるだろう。彼女の表情は、ドヤ顔で支配的で、明らかにその巨大なサイズとパワーにムラムラしているように見えるだろう。彼女はスマホを地面に立てかけて自撮りしている。\n\nありがとうございました！\n\nhttps://files.sizecraft.net/~catadioptrictrap/commission_refs/crescent_d/2024-10-29_Sumireko/", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a58da395/uploads/origins/8ff4b51f-9d0c-4423-94e8-8f9006b49fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63038f3618960a4c6877a6223a989a19", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a58da395/uploads/origins/8ff4b51f-9d0c-4423-94e8-8f9006b49fcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48197ff2739fb80db0ab6dae6c25cc39", "src_set": ""}, "body": "クレセント様\nこの度はアピールをありがとうございます。クレセント様のことは「びっくこあ」やニコニコ静画にて「ランカー絵師を確認、クレセントです」にて存じており、クレセント様からアピールが来ましたことを嬉しく思い、今回はクレセント様に終戦の日イラストを描いて頂きたく依頼を送ります。\n\n内容\n巫女装束を着た犬耳ロリババアが三八式歩兵銃で半旗の日の丸に捧げ銃をしている絵をお願いします。\n\n詳細\n巫女装束について\n巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n\n犬耳、尻尾等について\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは委任します)\n\n体型等について\n人間でいう9〜18歳くらいの外見\n胸部は貧から巨まで委任します。(ロリ巨乳も可)\n\n表情について\nほんの僅かに優しく微笑んでいる、どこか物憂げ、無表情の中から選んでください。\n\nロリババアついて\n「これが描かれていればロリババア」という定義等はありませんが、悠久の時を生きた経験らしさ、威厳なり落ち着いた雰囲気なりが描かれていればと思います。\n\n場所について\n委任します。\n迷うようでしたら神社、海辺、密林、荒れ地、洞窟等あたりをお願いします。\n\nその他解説\n半旗\n特定の日に弔意を表すために旗を少し下げた状態で掲揚する行為\nhttps://ja.wikipedia.org/wiki/%E5%8D%8A%E6%97%97\n\n三八式歩兵銃\nhttps://regimentals.jugem.jp/?eid=3358#gsc.tab=0\n全長127.6cmあるのでロリババアの身長の参考にして下さい。\n\n捧げ銃\n銃で行う敬礼動作の一種\n参考動画\nhttps://youtu.be/4Qn0lU74PUE?si=O1qJ6KvkmZ0196_n\n(23秒あたり)\n\n注意事項等\n「着剣はしない」ようにお願いします。(各個の敬礼でなく隊の敬礼になるため)\nボルトハンドルは横に倒れている(下記pixiv参照)ようにお願いします。\nillust/67649363\n毎年色々な絵師様に依頼しており、他作品との構図被りは避けられないため、その点は大丈夫です。\n\n何卒、よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/96", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 203844, "client_id": 781693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf923bdc/uploads/origins/c77b1448-19e7-4afc-b18f-486510c91b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f0f8bf0e579d6ebc254b6072572edcf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf923bdc/uploads/origins/c77b1448-19e7-4afc-b18f-486510c91b0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d06a2a03edea7a478cc98dc33525d08", "src_set": ""}, "body": "いつも素敵なイラストを拝見させていただいております。\n手数料無料期間中ということで、リクエストさせていただきます。\n\n■キャラクター\n白金の城のラビュリンス(遊戯王OCG)\n\n参考画像は以下になります。(以前のリクエストと同じリンクです)\nhttps://twitter.com/yugioh_ocg_info/status/1501890621765656580\nhttps://twitter.com/YuGiOh_OCG_INFO/status/1504789714456350721\n\n■容姿/構図\n衣装は上記リンクのドレス姿にしてください。\n装飾などは可能な範囲でお願いします。\n\n構図は、お嬢様風に口元に手を添えながら\"オーッホッホ\"と笑っているイメージで、こちらを向いて笑っているようにしてください。\n\n可能であれば、胸の衣装が捲れてしまい大きな胸が露わになってしまう様子をお願いします。\n服の捲れ方はバニー衣装が捲れるようなイメージで、胸を覆っている部分が下にペロンと捲れてしまうようなイメージでお願いします。\n\nビックリしている様子と、恥ずかしがりながらもちょっと満更でもなさそうな表情をさせていただけるとありがたいです。\n\n胸は大きめにしていただきたく、衣装からはみ出すくらいか、服の中にぎっしりと詰め込まれているくらいにしていただけるとありがたいです。\n\n■シチュエーション\n楽勝ムードで相手を嘲笑って調子に乗っていたところ、衣装が捲れてしまい赤面するイメージでお願いします。\n\n勝ち誇って満面の高笑いをしていたラビュリンスでしたが、その際に動きすぎたために衣装が捲れて胸がまろび出てしまい、それに気付いて驚きながら赤面してしまうようなイメージです。\n\n前回のリクエストで製作いただいたラビュリンスがとっても素晴らしくて、コミカルな描写とエッチな事になってしまう描写の取り合わせが魅力的でしたため、ぜひ一枚絵でも見てみたく思い今回リクエストさせていただきました。\n\nご検討いただけましたら幸いです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 996174, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45fd78c6/uploads/origins/5d4d0fe1-daf4-4afc-9774-669c3526e857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fb496bf3f8fdd3fa9206ff67f251240", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45fd78c6/uploads/origins/5d4d0fe1-daf4-4afc-9774-669c3526e857?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=531469abcfc9a6db6bf7787af55be1b8", "src_set": ""}, "body": "アピールありがとうございます。\nVRChatのアバターのイラストを描いていただきたいのですが、\n内容はお任せしてもよろしいでしょうか？\n\n見た目\n・通常\nhttps://drive.google.com/drive/folders/1LFZRuKWkcIvXs5DzSlxTQVjhJPgBO9lV\n・全身タイツのみ\nhttps://drive.google.com/drive/folders/11jm0ZHBjK7z14g0lGvL6Ma_T7pTqsve3\n・裸\nhttps://drive.google.com/drive/folders/12EYaqhHn8WQEncplW7IgHayxXIv5KFSt", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@crescent_D/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 203844, "client_id": 1714873, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ede32dbc/uploads/origins/f077cccc-8325-49a4-a930-338ff6146347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e56f6c0090d689cf3e6fb79efd58a563", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls":