&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1aa4b650b09502b781dfeec93a18b659 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1764948, "client_id": 2080497, "nc": 32}, {"path": "/@rorikkokakikaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1764948, "client_id": 2080497, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b7f26aa7db39eab723651d5615a79d", "srcset": "https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55b7f26aa7db39eab723651d5615a79d, https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bd18fa9035fe016c806c073837943182 2x, https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcc62686f628c9890da34e146f3ab026 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63915c81daf00a6bc85ec6dfc29b6c20", "srcset": "https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63915c81daf00a6bc85ec6dfc29b6c20, https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=44315ee0488cce874e7c89b02f62b138 2x, https://si.imgix.net/0fef0607/uploads/origins/6bde5d1a-cd56-4291-89f2-72849c448b21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54e0a773bfa577dda48bc3e022672cfd 3x"}, "body": "(オリジナル用)\n☆＜イラストの種類＞\n一枚絵　背景あり\n☆＜髪型・髪色・目の形と色・眉毛＞\n髪の毛は無しで体毛のみ\nアライグマの体毛は明るめで茶と灰色の間、流れるような毛並みの良さを表現出来ればお願いします。\nトドは灰と黒色の間でお願いします。\nアライグマの目の形はあまり鋭くない感じでお任せします。目の色は薄水色で試していただいて変だったら違和感ない色でお願いします。眉毛は白色で困り眉とまでは行きませんがあまり勇ましくない感じでお願いします。\nトド獣人の目の形は優しさが出るような形でお願いします。目の色は黄色でこちらも変だったら調整願います。眉毛は基本的に無しで変だったら足してください。\n\n☆＜キャラクターの性別・体型・種族＞\n性別は二人とも雄で高校一年生\nアライグマ獣人  身長150cm体重40キロ\nトド獣人 身長190cm、体重130キロ\nトド獣人はアライグマ獣人をすっぽり包み込めるサイズ感でお願いします。\nケモノ具合はサンプルで頂いた感じで上記の要素を足して調整していただければと思います。\n＜キャラクターの性格や癖＞\nアライグマ:中学生の時突然父親に無視されるようになり、愛を欲しがっていた。自己評価が低く誰からも愛されないと思っている。\n\nトド　豪胆なオタクで周りから浮いてても気にしない。小さいものが好き。\n癖は二人とも特にありません。\n＜キャラクター名＞\nアライグマ:月代 相良(つきしろ あいら)\nトド:等々力 白亜(とどろき はくあ)\n＜衣服や小物類など＞\nアライグマは女物の鬼灯(ほおずき)模様の浴衣\n資料URLに貼っています。\nトドは藍色の男物浴衣を着ている。こちらも資料URLを貼っています。\n\n二人とも靴は普通のシューズ。\n\n<シチュエーションやポーズ、構図など>\n告白直後で抱き合う二人。アライグマはトド獣人を嬉し泣きによる涙目+上目使いで見る。トド獣人はやっと手に入れたという安堵と守りたいものが腕の中にある慈しみの優しい目で見る。\nそんな二人を横か斜め上から海が写るような視点で描いていただきたいです。\n＜背景・エフェクト＞\n背景は海で堤防沿い。時間は19:30~20時で月が出ている。飛び飛びで街灯はありますが絵の中にある必要はありません。\n＜イラスト全体の色調について＞ \n告白時なので少し幻想的な色調にしていただければと思います。\n＜推しポイント、魅せたい部分＞\n体格差と青春感\n＜アスペクト比　縦×横(px)＞\n特に指定は無いです。\n＜その他の追記事項＞\nPixivの自分の作品の挿絵に出来ればと思っています。資料のURLは複数送れなかったので繋がってます。httpのところで切ってそれぞれ見ていただければ助かります。\n最後の資料URLはその作品ですがまだこのシーンはありません。長いので特に読んでいただく必要もありません。この作品に使うとだけ認識していただければ大丈夫です。アレな要素あるのでもし目を通される際は注意してください。\nわざわざサンプルまで頂きありがとうございました！\n\nhttps://kyoto-kashiisyo.jp/item/1ds0007000/https://item.rakuten.co.jp/asanoya/1506-1854/https://www.pixiv.net/novel/show.php?id=14620031", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 48171, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "✧︎花鼬-𝕳𝖆𝖓𝖆𝖎𝖙𝖆𝖈𝖍𝖎-/仕事募集中", "screen_name": "hanaitachi7577", "avatar_url": "https://pbs.twimg.com/profile_images/2023600427141656578/6vriSyPh