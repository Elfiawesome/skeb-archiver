re Shalltear (Text only) mentions that Albedo has a hairy pube? She will have shiny oily skin and very hairy public hair. \nDialogues are based on the Overlord Novel/Animation but you can add your own desires.\n\nhttps://drive.google.com/drive/folders/13fBgJkoPHGysGTXAtMqDdbxfczzvfoCa?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ititakaRe/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1369313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad7237e4/uploads/origins/bd492bc4-8ce0-444e-9c66-087c8b3f87fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aede5b8f9093a7e401945541727ac6e", "srcset": "https://si.imgix.net/ad7237e4/uploads/origins/bd492bc4-8ce0-444e-9c66-087c8b3f87fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aede5b8f9093a7e401945541727ac6e, https://si.imgix.net/ad7237e4/uploads/origins/bd492bc4-8ce0-444e-9c66-087c8b3f87fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1813d6aca6ec52f61727d5d904bc6ee 2x, https://si.imgix.net/ad7237e4/uploads/origins/bd492bc4-8ce0-444e-9c66-087c8b3f87fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=315ec710885e86f593583efd597b87b7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad7237e4/uploads/origins/bd492bc4-8ce0-444e-9c66-087c8b3f87fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da08357c4c4e22defd705311f818b57", "srcset": "https://si.imgix.net/ad7237e4/uploads/origins/bd492bc4-8ce0-444e-9c66-087c8b3f87fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da08357c4c4e22defd705311f818b57, https://si.imgix.net/ad7237e4/uploads/origins/bd492bc4-8ce0-444e-9c66-087c8b3f87fd?bg=%23fff&auto=format%2Ccompress&fm=w