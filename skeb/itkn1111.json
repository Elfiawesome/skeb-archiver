-a923-05525af091db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bf808f06608ca364b212f95bd54446a, https://si.imgix.net/5f10aa23/uploads/origins/5fe6cc7d-d46f-4afa-a923-05525af091db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97d930c8a981d2f4c98b714a78ef5a1e 2x, https://si.imgix.net/5f10aa23/uploads/origins/5fe6cc7d-d46f-4afa-a923-05525af091db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=baf78c02dd3833eb297d4d421f335c02 3x"}, "body": "あなたのイラストに一目惚れして依頼しました。\n色使いと雰囲気、衣装のデザインが好きです\n\n私のオリキャラ描いてください\n\nオリキャラ参考イラスト\n私服\nhttps://drive.google.com/file/d/1dcew268F48ZkaDK-UH0-8nt9WPbCQ1pZ/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1eFeZvaxiuRdDtnrVW14g-b7ly9ewJC7-/view?usp=drivesdk\n\n年齢は20代半ばくらい\n\n\nキャラの特徴として\n星がモチーフで服装に星のネックレスをつけてる\n緑の目(星のハイライト) ←これが大事です\n胸は結構大きめ\nピンク髪→薄いピンク色サーモンピンクみたいな\nへそだし衣装などやや露出度高い衣装を着ることが多い\n\n性格はドヤ顔が似合う自信満々な女の子、自称天才\nでも誰よりも寂しがりやで人に認められたい欲が強い\n\n\n書いて欲しいもの\n\nこのオリキャラの子をあなたの絵柄で可愛く描いてください\n服装は今風の女の子が着ているような私服であなたのセンスにお任せします\n表情は自信満々、自分を強いと思ってるが故の不適な笑みみたいな感じ\nポーズも自信が滲み出してる感じで\n服装ら可愛すぎる系より表情やポーズを考えるとややスタイリッシュさがあるといいかも\nまた、星がモチーフの子なのでネックレスは残しておいて欲しいです\n他の依頼絵みたいな全身＋別ポーズor表情の差分みたいな感じでお願いします\n\n\nその他細かいところはお任せします\nレイヤーなどでキャラだけで分けられるようにしてくれると嬉しいです\n\nよろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itkn1111/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3582470, "client_id": 3472349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b61dc8c6/uploads/origins/957a6674-091f-41cf-ba45-95024d20f9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c2433c7b44ecaed03f25b3fc31be03", "srcset": "https://si.imgix.net/b61dc8c6/uploads/origins/957a6674-091f-41cf-ba45-95024d20f9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8c2433c7b44