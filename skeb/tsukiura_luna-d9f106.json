b-a4a1-8e062cf87374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c641787b4c4731c44394a5a69aa7dd59", "srcset": "https://si.imgix.net/94848f05/uploads/origins/46ea33c6-5b59-49eb-a4a1-8e062cf87374?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c641787b4c4731c44394a5a69aa7dd59, https://si.imgix.net/94848f05/uploads/origins/46ea33c6-5b59-49eb-a4a1-8e062cf87374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b371eef4c4817798186bb7b7acf40f40 2x, https://si.imgix.net/94848f05/uploads/origins/46ea33c6-5b59-49eb-a4a1-8e062cf87374?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aeed4278615b076c6e15f296754d9e36 3x"}, "body": "キャラクター：夏樹\nシチュエーション：TS改造直前\n↓のような展開で、\nhttps://www.pixiv.net/artworks/129347536\nTS改造直前に一瞬だけ首輪の力が切れて不可逆の女体化を認識させられる場面。\n\nイヤリングなし、首輪の光なしで、瞳や表情が\n↓のような状態。\nhttps://www.pixiv.net/artworks/135762100\n裸。胸の片方に吸い付く触手。もう片方はまだ細い触手で舐られている状態。\n両足はM字開脚（さっきまで自分で開脚、今は閉じようとしているのを触手が掴んでる）。\nこれから失われる夏樹くんの男の子の部分の手前で触手の先端がぱかっと割れて股間に吸い付く直前。\n夏樹くんは恐れているが、先程までの催眠＋触手とのプレイで体は反応している。\n闇の力をいっぱい注ぐために女の子にしてくれるというボスのありがたい言葉。\n以上です。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukiura_luna/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2872428, "client_id": 2724334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7224970f78a4d857ffdc87ee3055e341", "srcset": "https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7224970f78a4d857ffdc87ee3055e341, https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14dd6d62cf868456c5c73c90d477ef43 2x, https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d359db143119a1c61e0c0526c599b8c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c12247a77d740b19736cce2437cff83c", "srcset": "https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c12247a77d740b19736cce2437cff83c, https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d8aa8d74fe92782a68e748eb083cd627 2x, https://si.imgix.net/9f177909/uploads/origins/ab7aed5a-c9c3-48bf-9a20-6042aff3b5c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fd49f3f8a28e8082e9e255beb08459d 3x"}, "body": "こんにちは。\nいつも素晴らしいイラストをありがとうございます。\n今回は、椿ちゃんが勧誘を試みるも失敗するイラストを描いて欲しいです。\n描写範囲等についてですが、\n\n・描写範囲\nスカートから上\n・椿ちゃんのアングル\n正面(勧誘相手目線)\n・セリフ\n椿ちゃんのみ\n・イラスト枚数\n2枚\n・イラスト毎のシチュエーション\n1枚目\n椿ちゃん、勧誘相手の顔を両手で掴み、自分の目を見るよう促し、催眠状態にしつつ説得しようとする\n2枚目\nしかし、勧誘相手の目線が自分のお腹に向いている事に気づき、顔を真っ赤にして「…って、どこ見てるんですか!」と叫ぶ。\nさらに、相手にお腹とおへそが可愛いと言われ、しどろもどろになる\n\n以上です。\nお手数ですが、よろしくお願いいたします", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukiura_luna/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2872428, "client_id": 1360085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa9db0e0bbf4760f39074736c7b3f4f9", "srcset": "https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa9db0e0bbf4760f39074736c7b3f4f9, https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4832a3d2f3725d833a48cf88f322a73 2x, https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ccdecf17cc1b2e24b1263cd65fdec9a8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6efa0f26fde52b70ff146da25805b146", "srcset": "https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6efa0f26fde52b70ff146da25805b146, https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3177eeb446dacfc50ff2b65a789b157a 2x, https://si.imgix.net/1d0808be/uploads/origins/59995aab-d4d0-4638-baf7-e700b5f44528?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e63158ae11e60cbba02f8f6ecc7ce5e7 3x"}, "body": "度々リクエストにお応えいただきありがとうございます。\n過去のマシュマロの返答から見てみたいシチュエーションがあったのでリクエストさせていただきます。\n題材は「敵の洗脳を中途半端に弾いた反動で錯乱する主人公ちゃんを闇堕ち時の能力の残滓を使って鎮める夏樹君と椿ちゃん(味方サイド帰還済み)の三コマ」です\n\n一コマ目：蘇ってしまった過去のトラウマとかで泣き叫びながら精神ダメージに苦しむ主人公ちゃん。伏字で過去に失った大切な人の名前を叫ぶなど、今の状況が目に入ってないレベルで錯乱したセリフを吐く。\n二コマ目：彼女に何度も助けてもらった身として、絶対に主人公ちゃんを守ろうと力強く主人公ちゃんに念を送り続ける夏樹君。主人公ちゃんの心の強さを信じ、必ず助けて見せるといった感じの事を言っている。\n三コマ目：自分にも救いの手を差し伸べてくれた主人公ちゃんが壊れつつある恐怖から涙を流しつつも能力の行使を続ける椿ちゃん。夏樹君のためにも主人公ちゃんを助けたいことから、神頼み混じりで主人公ちゃんに呼びかけている。\n\n夏樹君と椿ちゃんに関しては、片目だけを闇堕ち時と同じ色にしてください。\nまた、眼の色以外はモノクロで描いていただいても構いません。\n構図や衣装、具体的なセリフなどの細かな点に関してはお任せします。\n差し支えなければ、以上の内容でお願いいたします。\n\nhttps://marshmallow-qa.com/messages/cc1e60c2-6772-45c9-bd82-b8ad6f81e883", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukiura_luna/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2872428, "client_id": 1360085, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc92ec61b1f93a07210e178ba28f72f7", "srcset": "https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc92ec61b1f93a07210e178ba28f72f7, https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c44e6c31f8bc83dbef6ed163e09d43b0 2x, https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa0cc5df0461acc006939137aea90f50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=730b87790c2a66f23ea0d6380088a009", "srcset": "https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=730b87790c2a66f23ea0d6380088a009, https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99edef21d55db7c2dff217682e83b855 2x, https://si.imgix.net/c7f7c6fa/uploads/origins/95683d99-a189-4e3a-ac7e-99ac5eb50fad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c8da089e53cee2a1f37a37f9e67ab5b 3x"}, "body": "前回は素晴らしいイラストをありがとうございました！\n椿ちゃんの衣装を見ていて思い浮かんだシチュエーションがあるので、リクエストさせてください。\n\n・椿ちゃんの衣装に対する夏樹くんの反応とそれに対する椿ちゃんの対応\n・椿ちゃんは洗脳されていたころは恥ずかしさから露出の高い服に抵抗感を持っていたが、正気に戻った後は逆に自分に自信をもって堂々と薄着をしている\n・夏樹くんは洗脳されていたころは椿ちゃんの服装をからかっていたが、正気に戻ったあとはその色香にドギマギしてしまっている\n\n1枚目：お互いに洗脳状態の椿ちゃんと夏樹くん。へそ出しでミニスカートな衣装を夏樹くんにからかわれ、椿ちゃんは組織の支給品だからと赤面しつつ言い訳をしている。\n2枚目：二人揃って正気に戻り、主人公たちの陣営に戻った後の姿。露出の多い格好に慌てている夏樹くんに対して、椿ちゃんは微笑みながらもっと見とれていいのだと軽く誘惑している。\n\n椿ちゃんの方は2枚目ではへそ出し+半袖+ミニスカートはそのままに別の衣装を着せてくださると嬉しいです。またその場合はローライズを履かせる等、お腹の露出面積は1枚目よりも多くしてください。\nセリフを書きこむ際は、なるべく「お腹」「へそ」といった単語を使っていただきたいです。\nお手数ですがよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukiura_luna/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2872428, "client_id": 1602847, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e233e2a2d1b7e04f2d54a0a63aa78d0", "srcset": "https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e233e2a2d1b7e04f2d54a0a63aa78d0, https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc33decf8ede373d917523327e350050 2x, https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1453b14859c3728f8e4c55882db35b1 3x"}, "duration": null, "nsfw"