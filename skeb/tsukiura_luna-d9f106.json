し+半袖+ミニスカートはそのままに別の衣装を着せてくださると嬉しいです。またその場合はローライズを履かせる等、お腹の露出面積は1枚目よりも多くしてください。\nセリフを書きこむ際は、なるべく「お腹」「へそ」といった単語を使っていただきたいです。\nお手数ですがよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukiura_luna/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2872428, "client_id": 1602847, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e233e2a2d1b7e04f2d54a0a63aa78d0", "srcset": "https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e233e2a2d1b7e04f2d54a0a63aa78d0, https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc33decf8ede373d917523327e350050 2x, https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1453b14859c3728f8e4c55882db35b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e597832e7277066d1bb515a3fa8e793", "srcset": "https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e597832e7277066d1bb515a3fa8e793, https://si.imgix.net/35272886/uploads/origins/604a9f61-57d1-44d3-86f3-fdca47070814?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f036b1282f408922373152de0b60763 2x, https://si.imgix.net/35272886/uploads/orig