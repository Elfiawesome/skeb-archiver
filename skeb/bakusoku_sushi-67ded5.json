いので、構図等は全てお任せいたします。\n・あまりがっちりとした体格のキャラクターではないので描きづらい可能性があるのですが、NIKAIDO様の普段の絵柄でも、ハズビンホテルのようなトゥーン調の絵柄でも、どちらでも描きやすい、描きたいと思うものを優先してください！\n・背景と人物のレイヤーを分けてくださると助かります。\n手足や頭が切れないように描いていただけるとサムネイルに使いやすいです。\n\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Pi3cPwW9aKBQ9OzASk_W-_kOqNHb0Z3l?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 772427, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クーラー@skeb募集中", "screen_name": "kuuraaa1u1", "avatar_url": "https://pbs.twimg.com/profile_images/2065586369871958016/gjmJfJlz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2006675433031606272/1768221784/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 2337895, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Cynical", "screen_name": "llcbluckg_c004", "avatar_url": "https://pbs.twimg.com/profile_images/1887345759693266944/NpECA6LD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/490987339/1696763081/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2801106, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ぐるみん.sub", "screen_name": "guruminnSuB", "avatar_url": "https://pbs.twimg.com/profile_images/1784195462628872192/Cx17DCoP.png", "header_url": "https://pbs.twimg.com/profile_banners/1780843961621606400/1753335572/1500x500", "appeal_receivable": false, "popula