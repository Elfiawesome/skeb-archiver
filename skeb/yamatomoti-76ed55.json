x.net/12259661/uploads/origins/f4404089-43f7-492f-8775-3d14ae198082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d69991af7b0fcff64e096d6368453a0f 2x, https://si.imgix.net/12259661/uploads/origins/f4404089-43f7-492f-8775-3d14ae198082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b9f18540e3eb8bc31ce67e795d9a5497 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12259661/uploads/origins/f4404089-43f7-492f-8775-3d14ae198082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66bb16c26d4672928dac929d6d62c3ca", "srcset": "https://si.imgix.net/12259661/uploads/origins/f4404089-43f7-492f-8775-3d14ae198082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66bb16c26d4672928dac929d6d62c3ca, https://si.imgix.net/12259661/uploads/origins/f4404089-43f7-492f-8775-3d14ae198082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d6dc8db1449169ffd4f5d7f0ae8bb8 2x, https://si.imgix.net/12259661/uploads/origins/f4404089-43f7-492f-8775-3d14ae198082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5768ab8a5fc3dcef5d5d35b015bc35c2 3x"}, "body": "はじめまして。以下の内容は可能でしょうか？\n\n○キャラクター\nファリン・トーデン（ダンジョン飯）\n\n○シチュエーション\n現代日本の世界観にて\n愛する人の赤ちゃんを孕みお嫁さんになったファリンが野外露出プレイ中に産気づき、白昼の路上で赤ちゃんを産む\n\n・ムチムチボディの腹ボテ妊婦\n・おっぱいは長乳&爆乳で、妊娠して乳輪も肥大して黒ずんでいる\n・体勢、アングルは参考画像のような感じで\n（両手は震える手でダブルピース）\n（下には段ボールもしくはブルーシートが敷かれている）\n・悲惨な感じは無く、ファリンは見られて興奮していて、\n目を開けて、犬のように舌を出して「はっ♡はっ♡」とよだれを垂らしながら荒く呼吸していて、\n「あぁっ…♡」「くるぅ…」「産まれりゅ…♡」と出産で感じている\n・服装は参考画像のような裸ウェディング\n（白いヒールを履いている）\n・参考画像のように可愛い赤ちゃんが産まれかけている\n（赤ちゃんはファリンと同じ髪色）\n（もし可能であれば、もう一人の赤ちゃんが既に産み落とされている）\n・流血表現は無し、羊水でびしょ濡れになっている\n・母乳が乳頭から水鉄砲のようにぴゅうぴゅう噴き出ている\n・もし可能であれば、外人女性（ファリン）の野外露出出産に集まってきたギャラリーたちのセリフも\n\nそれではよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/r7a299cjh8ed4mpjshxh0/AK1xqdviAAJfvKZ7n_PcZEU?rlkey=pfq7tv8wq6lzkpetj1xdgircb&st=2dg1g25l&dl=0", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamatomoti/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1236491, "client_id": 1646686, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c22ae6582966076c25b786eab69b55ab", "srcset": "https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c22ae6582966076c25b786eab69b55ab, https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=262f5a6ecff3860bbb4ffbd12d70dd4c 2x, https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f97c1abada0c07a610bd3b254f8f1853 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857fdd188fdaa371a016be603bb81bd7", "srcset": "https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=857fdd188fdaa371a016be603bb81bd7, https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=51b6924f06aa0ae58d9c6605f569a595 2x, https://si.imgix.net/22a46d76/uploads/origins/f4b63d9f-1365-4dc6-b699-3fab9d4fb057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83c5b599fb3e7949c2f4f2a69302608e 3x"}, "body": "はじめまして。リクエストさせて頂きます。\nアニメ版Anotherの赤沢さん(165cm)が恒一(168cm)と結ばれてラブラブエッチしているシーンを描いてください。\n体位や構図などはお任せします。必ずしも本番である必要はありません。前戯的なのも好きです。その場合は恒一が赤沢さんを愛撫する形でお願いします。\n差分として絶頂・絶頂後のシーンもお願いします。\n絵柄はなるべく公式に寄せてください。\n資料はURLをご参照ください。\nよろしくお願いします。\n\nhttps://t.co/4QcfIihAZD", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamatomoti/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1236491, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbc98eaf3ef07244e978840cbb008db1", "srcset": "https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbc98eaf3ef07244e978840cbb008db1, https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18df1e32d28971ae25453502c64f6e7c 2x, https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=527f9bb937733e1f30876d4e4071c198 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b68d7efacd11b4ff338147d83991d016", "srcset": "https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b68d7efacd11b4ff338147d83991d016, https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6603352cb4351cdcee748813eabe366a 2x, https://si.imgix.net/076821ce/uploads/origins/af51898f-3850-4219-9be7-50723b0d3e99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bde4ec5dfe83babb4327c7b7fbdab76 3x"}, "body": "こんにちは \nヤマ ともちさんがpixivで描いたファリンがエロくて好みだったので初依頼したいと思います。\n\n作品：ダンジョン飯\nキャラ：ファリン・トーデン\n衣装：バニーガール（黒タイツあり）\n↓（下のURLの衣装を参考）\nhttps://gfkari.gamedbs.jp/girl/detail/100?_cid=10011375\n\n内容：立ちながら授乳手コキ\n・ファリンのおっぱいはpixivで描いてたイラストと同じか少し大きめ\n・竿役はファリンより身長が低めで顔の位置がファリンの胸の高さ程度（目元は描かなくてok）\n・構図は下のイラストみたいに立ちながら授乳手コキする感じ\n↓\nhttps://www.pixiv.net/artworks/118071664#manga\n・竿役はファリンのおっぱい揉みながらもう片方の乳首をしゃぶる\n・おっぱいを揉む手は乳首が見える状態\n・ファリンの両方の乳首は唾液まみれ\n・ファリンは母性溢れる優しい表情\n・竿役の頭を優しく撫でながら授乳手コキする\n・背景とセリフはおまかせ\n【差分】\n・ファリンの乳首を舌で舐めたり、指で乳首を弄る差分追加\n・竿役の射精差分追加\n・ファリンの表情差分追加（赤面で感じてる表情、絶頂、笑顔で微笑んでる表情）\n・事後 ファリンのおっぱいを揉みながら顔を埋めて甘える（この時ファリンは竿役を抱きしめて優しく頭を撫でる）\n\n\nファイルはpsdでレイヤー未統合の状態で納品お願いします。\n是非ともよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 43569, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "りよ☕️", "screen_name": "Liyocafe", "avatar_url": "https://pbs.twimg.com/profile_images/1910203683641647105/rB76lrWj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/969535290636361728/1761772775/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 311083, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ほ", "screen_name": "Heo_taT3DR", "avatar_url": "https://pbs.twimg.com/profile_images/1387747485376937984/NRGzvdWs.jpg", "header_url": "https://pbs.twimg.com/prof