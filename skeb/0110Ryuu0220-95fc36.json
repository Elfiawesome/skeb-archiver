s/origins/d37f43f1-a2c4-4bdb-a9a6-aaf7a1db5c4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2335c9d6b603bc42cd4e92bf4b2cbed4 3x"}, "body": "おナスさん、こんばんは。漆黒の旅人です\n本垢の方で登録してるので匿名で失礼します\n依頼内容ですが、うちの子の漆黒ちゃんのえっちぃ絵をお願いしたいと思っています\n詳細について\nシチュエーション:射精機能付きディルドで自慰行為、疑似中出しで気持ち良くなっちゃう漆黒ちゃん\n体勢:M字開脚で片手でディルドをマ◯コに出し入れ、もう片手で乳首をつねりながら胸を揉む\n表情:\n1:自慰行為開始(ここの表情はおまかせします)\n2:自慰行為最中(目を閉じ、歯を食いしばり絶頂我慢)\n3:絶頂潮吹き&疑似中出し(体を仰け反らせ、舌を出しながら頭を後ろへ反らす)\n4:絶頂潮吹き&疑似中出し後(虚ろ目になりながらだらしなく舌を出し涎を垂らす)\n5:同上(ハート目になりながら薄笑いを浮かべ涎を垂らす)\n差分:通常と服ビリの2種類をお願いします\n\n以上の内容でお願いします。資料URLにうちの子の資料載せておきます。制服は夏制服でお願いします。\n\nhttps://x.com/kenzenkkhu/status/1957775703086121301?t=Jnr2twWAtpW34Q1Ypg48DQ&s=19", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0110Ryuu0220/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1022818, "client_id": 720643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5b8c0df3176bad7abbf1e33c8eb7d91", "srcset": "https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5b8c0df3176bad7abbf1e33c8eb7d91, https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0715051f857f7a4cacca2a7612aaf7b2 2x, https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=579189176eaf9d29ee74bc325413df22 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db9c940ca46fa27c7870f1bda7dfb6fc", "srcset": "https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db9c940ca46fa27c7870f1bda7dfb6fc, https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f23b3657ce76c2a0b8b9bb326fb6a9f 2x, https://si.imgix.net/d069261a/uploads/origins/99c8a680-c74c-4d58-a732-d4de70c4f740?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=673d7923d1f1df0482669231c8f26de8 3x"}, "body": "おナスさん、初の投稿失礼します\nTwitter(現X)でおナスさんの数々のイラストを拝見して今回依頼しようと思いました\n今回依頼する内容は、うちの子の六九と七七四をお願いしたいと思います\nこちら(https://x.com/44_Yoshi_YonYon/status/1842128668266778687?t=6TYusuNdJ9vYNGv_nJDspA&s=19)が自作のうちの子になりますが、あまり絵を描かない為上手くはないので他の方に描いていただいたものも貼っておきます\n・https://x.com/KoGaNe_trans_39/status/1790601979846402199?t=kCVBZHh6_gJWAFSIMccCsA&s=19\n・https://x.com/KoGaNe_trans_39/status/1887464222034174450?t=eDDsqO_4zHazTDcPkjPVHw&s=19\n\nおおまかな設定としまして\n・身長:180cm\n・体重:75kg\n・年齢:25歳\nその他につきましては自作画像に書いてあります。ポーズ等はおナスさんにお任せします\nよろしくお願いいたします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0110Ryuu0220/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1022818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=881c55f9250b9b5e2e57839b940ffa4d", "srcset": "https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=881c55f9250b9b5e2e57839b940ffa4d, https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f660cc47d26c35243a8440d1c5e44663 2x, https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2110a9abb058ff55347e3f4fc1fbb45c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ea0b59f5000172dacd3b8f2fb848e8", "srcset": "https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ea0b59f5000172dacd3b8f2fb848e8, https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2a723795b65fc5baa4cfdb9fa881724e 2x, https://si.imgix.net/e1a8cd5a/uploads/origins/8afe19ee-4854-4abb-86d4-cdec29ba8ffe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1bd24935f147f492a604438c05a5809 3x"}, "body": "こんにちは！私のためにドラゴンの女性を作ってくれませんか？彼女はドラゴンの特徴をたくさん持った大人の女性です。手足には淡いブルーの鱗があり、黒い肌の芯がある。黒い鱗が仮面のように顔の上部を覆っている。彼女の目は金色で、その周りに黒い目がある。\n\n顔はいつもにやにやしている。髪は肩のあたりから後ろにかけて長く（サイドロック）、耳の後ろは短い。大きな耳は鱗状で、先がとがっている。\n\n東洋の龍のようで、手には黒い鱗があり、鳥の足には黒い鱗がある。足の指は前方に4本、後方に1本ある。黒い鱗は炎のように青い鱗へと変化する（参考文献参照）。尾は上部が青い鱗、下部が黒い鱗で、その上部に沿って色のついたたてがみのような毛が生えている。\n\n彼女はヌードでも露出度の高い服を着ていてもいい。ヌードの場合、乳首は青い（舌と同じ色）。胸と太ももの肌は黒い。\n\n参考 https://imgur.com/a/SdlBOAm ありがとうございます！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0110Ryuu0220/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1022818, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd0