んにちは！\n初めまして、🍔🧀みこや🧀🍔さんのイラストを他の方からご紹介いただいて、（その作品は女の子二人のバニーでした！）素敵だったので今回お願いをしたいと思いリクエストさせていただきました。 \n\n【概要】\nディスコードのスタンプとして使いたいです。\n一つの表情につきそれぞれ一キャラのキャラクターを作っていただければと思っています。\n料金が足りなければ再送してください。\n\n①微笑んでいる顔（OK！）\n②普通の顔（デフォルトの表情）\n③ラブラブ（二つでペアになるようなもの。視線がお互いに向いているもの）\n④不機嫌（ナルダはペインティングナイフ持っている。ノックスはオーラが不機嫌そうになる）\n\n【参考URL】\nhttps://skeb.jp/@gyarinrin358/works/250\nhttps://skeb.jp/@gyarinrin358/works/251\n文字が書いてあるのが可愛らしいと思いました！\n【キャラクター】\n ☆ナルダ\n敬語。猫背。法廷画家。警戒心が強く、それを態度に出してしまうことがおおい。\n恋には盲目的な側面があり、少しでも怪しいとペインティングナイフで刺す\n☆ノックス\n褐色肌。無口で無表情。時折雰囲気で機嫌の良しあしがわかる。\n金持ちの御曹司で基本的に冷徹無慈悲。\n【関係性】\n内縁の夫婦関係であり、 仲が良く同棲に至っている。\n\nhttps://drive.google.com/drive/u/2/folders/1jZYgiA0OpX6C5CIj2wqoBioeeQQTZs92", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@waya4696/works/166", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1975093, "client_id": 2041355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b1dd7c6/uploads/origins/19f94e9a-79d7-4bdb-a82c-5c7fe481b6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d90f9d2f75e1bf897c5831ff67735d", "srcset": "https://si.imgix.net/4b1dd7c6/uploads/origins/19f94e9a-79d7-4bdb-a82c-5c7fe481b6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d90f9d2f75e1bf897c5831ff67735d, https://si.imgix.net/4b1dd7c6/uploads/origins/19f94e9a-79d7-4bdb-a82c-5c7fe481b6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d8f29b2e3706e875498ec73760263ee 2x, https://si.imgix.net/4b1dd7c6/uploads/origins/19f94e9a-79d7-4bdb-a82c-5c7fe481b6c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9bc601422d8962394387e9db6cc2e59f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b1dd7c6/uploads/origins/19f94e9a-79d7-4bdb-a82c-5c7fe481b6c8?bg=%23fff&auto=format%2Ccompres