ix.net/2b4d96bf/uploads/origins/8458e0d2-be71-4fc2-a5ea-ad970e1072db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99157f9d23192b62949f4953f7ff6b67", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b4d96bf/uploads/origins/8458e0d2-be71-4fc2-a5ea-ad970e1072db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a81185bf8eff36b7b43e3e0354713f", "src_set": ""}, "body": "こんにちは。ブルーアーカイブの水羽ミモリをリクエストします。\n服装はゲーム内の立ち絵で、それ以外はお任せします。\nご検討いただければ幸いです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 951486, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もつ鍋かマラか", "screen_name": "erotunabe", "avatar_url": "https://pbs.twimg.com/profile_images/1223480277776785408/22XcK4xx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2212689806/1558174963/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1514927, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かぎた", "screen_name": "kagitasuimen", "avatar_url": "https://pbs.twimg.com/profile_images/1969346620669247490/RbTFv_LT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1620260838/1619789075/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "novel"}], "nc": 161}, {"id": 2351758, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "N͜͡atsuᗷerry（ナツベリー）", "screen_name": "BeginningNB", "avatar_url": "https://pbs.twimg.com/profile_images/1963514125688221696