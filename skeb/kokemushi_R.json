c": "https://si.imgix.net/81532fb2/uploads/origins/31a14a3a-0a8a-4cbe-b218-3da1240f3b8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=18fa22f1b6c39d7e7456ac0a2a231c08", "src_set": ""}, "body": "前作は素晴らしかった！また漫画が欲しい。\n疲れ果てたエスピオンは小さくなり、ミロティックとセルペリオールの舌の間に絡みつき、からみつく。最後は飲み込まれる（飲み込むかどうかはあなた次第）。\n開いた口とぐったりしているエスペオンのアップがあるといいですね。エスピオンの腹部が突き出ていたり、他のポケモンに肌を撫でられたりしているところが描ければなおよい。\n\nエスポンoc参照\nhttps://x.com/NormMiguel/status/1894618102320787682", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kokemushi_R/works/104", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/752db3e4/uploads/origins/84ad86db-cf62-4fb1-9338-d5d04ebefe7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5eeeb48c63db481421782fac2176aa2c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2685890, "client_id": 808925, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kokemushi_R/works/103", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2685890, "client_id": 444231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/799435b5/uploads/origins/e9daaa35-a746-4b76-a5ad-734ecf76c24d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eda891bc57417465829082603a49901c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/799435b5/uploads/origins/e9daaa35-a746-4b76-a5ad-734ecf76c24d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34589690a807a6b3357211f27de8f32a", "src_set": ""}, "body": "以前に納品いただきましたジャノーンの和姦イラストが大変気に入りましたため、今回はコミックにて依頼したく存じます。\n\n・以前のイラストの様子を踏襲いただいても構いませんし、変更いただいても構いません。\n・キャラクターのカラーにつきまして、♂側:黄色/♀側:桃色にてお願いいたします。\n　(以前のイラストと同様のイメージです。)\n・性格は♂側:おっとり/♀側:天真爛漫なイメージです。\n　可能であれば、♀側が♂側へ奉仕するような雰囲気ですと嬉しいです。\n・キャラクターの本来の設定ですと、へその部分が人間の乳首に相当するとされています。\n　ですが、♀側は胸部を盛っていただけたら嬉しいです。\n・腰部分の装備品の有無は問いません。\n　また、装備品の無いパターンの画像が準備できましたので、資料へ追加いたしました。\n\nご検討いただけましたら幸いです。よろしくお願いいたします。\n\nhttps://nextcloud.half-moon.org/s/4yLnWD8Jx9i4Cm3", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kokemushi_R/works/102", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5bd941cc/uploads/origins/90a91bbd-640c-4ee0-ade4-9431e6c406a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=34b94d5b362e31af957a6558bbc857f1", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2685890, "client_id": 56657, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kokemushi_R/works/101", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2685890, "client_id": 3215136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0e2c11b/uploads/origins/16152e56-129b-4da5-84c8-f6560245cfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=116276601dc40909fdfbb1fa00bfe932", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0e2c11b/uploads/origins/16152e56-129b-4da5-84c8-f6560245cfb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50f7f456c2a9fcec6383a9a8c3a2c9da", "src_set": ""}, "b