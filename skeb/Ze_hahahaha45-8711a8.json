ge", "creator_acceptable_same_genre": true}, {"path": "/@Ze_hahahaha45/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3765445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049425faa2978cc67cf5c962331c8da8", "srcset": "https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=049425faa2978cc67cf5c962331c8da8, https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1299216f1d95d74daea3ac100f37b96d 2x, https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b37b54ea59e8523e9f2cad056fe90a8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df7d874bc63aa7d5f8b09d5809f0f7c0", "srcset": "https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df7d874bc63aa7d5f8b09d5809f0f7c0, https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d23fd76aaeaa8f56586de5fc3e17ca3 2x, https://si.imgix.net/e71f6658/uploads/origins/8f2738b4-940c-4ba6-b1bb-af404f53a2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69be278e67436821d431508eb3fe405a 3x"}, "body": "こんにちは！ざらすすす先生のイラストが大好きです。 今回、私のvtuberのキャラクターを描いていただきたいです。\nTwitterにてイラストを投稿させていただくかもしれません。使用不可の場合はキャンセルしていただけますと幸いです。\n 名前は『霞蒼（かそう）』、見た目は14歳くらいの中学2年生ですが、実際は124歳です。 メドゥーサの末裔であり、蛇のような縦長の瞳孔を持った真っ赤な瞳と、病的に白い肌、可愛らしい猫口、それから、二重螺旋状にうねった髪の毛が特徴です。 普段は膝丈のセーラー服を着ていますが、性別はなく、たまに学ランを着ることもあります。胸はありません。 髪の毛の毛束は4本に別れており（右2、左2）、4匹の蛇に変化することができます。 髪の毛には痛覚があり、病院服姿のものでは自傷行為として髪を雑に切ってしまっています。 また、左腕にはリストカットの傷跡があり、いつも包帯を巻いています。 主食はヒトで、見境なく人間を食べています。  構図等はお任せしますが、仄暗い雰囲気だと嬉しいです！\n\nただざらすすす先生の世界観が好きなので、お好きに描いていただきたいです。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1wPL97oF72gTeFCyLrtarLo659SnSd2z_", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ze_hahahaha45/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c33f6133e42ba58eaccc3030bd76a5f3", "srcset": "https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c33f6133e42ba58eaccc3030bd76a5f3, https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5d30440daf5960ec25206d4e8fb0028c 2x, https://si.imgix.net/bc8440ea/uploads/origins/a3db9644-2048-4c5b-95e0-ca1941729131?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f44355f042ad61f9aea5553fddcf98cb 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3765445, "client_id": 2089302, "nc": 128}, {"pa