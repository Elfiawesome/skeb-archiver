l islands or buildings are at sea (I put some references in the link, I hope it will help you). G looks very free and happy.\n\nIf you feel something inappropriate about this request, please feel free to cancel it, thank you very much!!><\n\nhttps://drive.google.com/drive/folders/1couOkvpb0pHFwXhFlJgCWnOj6_me1Yvu?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maythtorm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2354887, "client_id": 823165, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aefd6f67/uploads/origins/fea10a6b-9d58-4af3-9464-f510f2c67cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=744709123938ac6164435b96393bf626", "srcset": "https://si.imgix.net/aefd6f67/uploads/origins/fea10a6b-9d58-4af3-9464-f510f2c67cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=744709123938ac6164435b96393bf626, https://si.imgix.net/aefd6f67/uploads/origins/fea10a6b-9d58-4af3-9464-f510f2c67cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f140d7a537eed2b6ce6627882a3c575b 2x, https://si.imgix.net/aefd6f67/uploads/origins/fea10a6b-9d58-4af3-9464-f510f2c67cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af2b8cf8d7d799907801d0faf167dd12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aefd6f67/uploads/origins/fea10a6b-9d58-4af3-9464-f510f2c67cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=291b9c99b415236dc13f4c734119a32c", "srcset": "https://si.imgix.net/aefd6f67/uploads/origins/fea10a6b-9d58-4af3-9464-f510f2c67cdc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=291b9c99b415236dc13f4c734119a32c, https://si.imgix.net/aefd6f67/uploads/origins/fea10a6b-9d58-4af3-9464-f