, "total_appeals_count": 0, "received_works": [{"path": "/@_Worldbugs_/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4102202, "client_id": 3710761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c405d979cae479474c5677d0c2bad3db", "srcset": "https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c405d979cae479474c5677d0c2bad3db, https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0f4920503da198989fbad16fb69c96c 2x, https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a1f2fbee64b6ecadda2cf070b667733 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7e2ace0e926ff429fae6c9710a9b19", "srcset": "https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f7e2ace0e926ff429fae6c9710a9b19, https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10f300d88363cba27ae5d1134eebca95 2x, https://si.imgix.net/35f460a8/uploads/origins/b93beb26-36ea-405c-b501-cfaf4e6e417e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e5aead16b5ac158b69ac9747157015bd 3x"}, "body": "初めまして。\nVtuberとして配信活動をしている狐尾 うにと申します。\n大変素敵な絵柄に惹かれましてぜひイラストをお願いしたいと思い、\nリクエスト失礼します！\n\n【リクエスト内容】\n狐尾 うにのイラストの制作をお願いします。\n・眼鏡をかけた、色気あるお姉さんな雰囲気でお願いしたいです。\n・シチュエーションに合わせて衣装はお好きにアレンジしていただいて構いません。\n・髪型は3種ありますが、ウルフでお願いします。\n・目線はこちら（画面側）を向いていると嬉しいです。\n・頭に乗っている子狐は無しでお願いします。\n・尻尾は9本の描写が難しければ1本またはなしでも大丈夫です。\n\n【使用用途（予定）】\n・Youtubeのサムネや動画内での使用（未収益化）\n・Twitchの配信内やOP等での使用（収益化済み）\n・Xでのツイートやタグツイートへの添付\n・ネットプリントやサブスク特典などデジタルグッズとして配布\n\n【キャラクター詳細】\n・両目元に赤いほくろがある、九尾の狐です。\n・人耳はなく、狐耳のみです。\n\n【その他】\n・サムネでの使用がメインになるので、髪や耳が切れないようにしていただけますと幸いです。\n・尻尾を描写いただける際に構図的に見切れてしまう場合は、別レイヤーで頂けますと大変嬉しいです。\n\nぜひご検討をよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/18-_wgD4iVW5y12b8mMkAr5aIWkELMkkZ?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_Worldbugs_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4d16c215/uploads/origins/c3b94e5c-56ae-462a-9c8a-389ff06e29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0778df365956ed8418423498a466d5c4", "srcset": "https://si.imgix.net/4d16c215/uploads/origins/c3b94e5c-56ae-462a-9c8a-389ff06e29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0778df365956ed8418423498a466d5c4, https://si.imgix.net/4d16c215/uploads/origins/c3b94e5c-56ae-462a-9c8a-389ff06e29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6117f27ca253f7bec0412ee12109c2c9 2x, https://si.imgix.net/4d16c215/uploads/origins/c3b94e5c-56ae-462a-9c8a-389ff06e29d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd74994151d13b1fae744e90ec8b