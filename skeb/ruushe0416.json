ukilubee?t=__seMqIpYUAbey6Z9epd0A&s=09", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 720920, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "健やか", "screen_name": "100hituzi", "avatar_url": "https://pbs.twimg.com/profile_images/1891656441003671552/fmL29lL7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1273594963222130688/1739232042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 33}, {"id": 1244225, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "想乃ぴなの🪄🍀ご依頼1件", "screen_name": "nerikeshi117", "avatar_url": "https://pbs.twimg.com/profile_images/1819323068939993088/pjXr80io.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1260975054881341440/1720195445/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1587816, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Ars（あ～す）", "screen_name": "Ars_RG0412", "avatar_url": "https://pbs.twimg.com/profile_images/1604417614536921088/1FCm6yNS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1445240892210569222/1756968530/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "video"}], "nc": 128}, {"id": 2991136, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "篠崎もちめ", "screen_name": "sisisi_sio", "avatar_url": "https://pbs.twimg.com/profile_images/19403366488913