ーを持つ手（袖あり）\n・ピース（右手のみ、袖あり）\n・覗き込む手（指先だけ）\n上記3点です。\n\nコントローラーは特に特徴のない黒のもので大丈夫です。\n手がドラゴンの状態ですので、分かりやすいよう何点か添付いたしますが、過去のキャラデザも混ざっておりますが、今のキャラデザは髪がストレートの目が紫がかった青色の方になります。袖を描写される際にご注意ください。\n\nピースは手のひらが前を向いているようにお願いします。 お見苦しい上に左手ですが、こちらイメージ画像添付いたします。 \nPsd形式での納品だと助かります。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14IWw6hQxKdbwaBjEC5fCno0MNP1fH_Yn?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mzmz__mzmz/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2229667, "client_id": 2900383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a230d5ad/uploads/origins/25db22c2-6acc-4b71-ad99-535a3488dd95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f3c2660b46d5593565542bfa59a76f", "srcset": "https://si.imgix.net/a230d5ad/uploads/origins/25db22c2-6acc-4b71-ad99-535a3488dd95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f3c2660b46d5593565542bfa59a76f, https://si.imgix.net/a230d5ad/uploads/origins/25db22c2-6acc-4b71-ad99-535a3488dd95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c2bf738cd50f4a582392c22b057410a 2x, https://si.imgix.net/a230d5ad/uploads/origins/25db22c2-6acc-4b71-ad99-535a3488dd95?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d51ecd80f31d1d67b76d09a41972981 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a230d5ad/uploads/origins/25db22c2-6acc-4b71-ad99-535a3488dd95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2238e1f80048c5eaad271924e4bbf28", "srcset": "https://si.imgix.net/a230d5ad/uploads/origins/25db22c2-6acc-4b71-ad99-535a3488dd95?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2238e1f80048c5eaad271924e4bbf28, https://si.imgix.net/