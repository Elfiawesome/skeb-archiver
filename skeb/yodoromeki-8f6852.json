と嬉しいです。ただし、侵入者は彼女を縛るための道具を持ってきていない設定です。そのため、通常のロープやテープの代わりに、彼女の「洗濯物」の寄せ集めで縛られることになります。スカーフ、靴下、パンティなど、何でも構いません。彼女にとって非常に恥ずかしく、屈辱的な状況にしてください。\n\nポーズや構図はあなたにお任せします！服を着ている状態でも、下着姿でも構いません。\n\nhttps://drive.google.com/drive/folders/1fPcfTMfKSl0qloeMr6WH_JQol6CYEeGQ?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yodoromeki/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cc20bf52/uploads/origins/0ccce0a3-3e10-4741-a2a2-1b2dd8a40027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f95040da1d50d1713b3db51f8e81d50c", "srcset": "https://si.imgix.net/cc20bf52/uploads/origins/0ccce0a3-3e10-4741-a2a2-1b2dd8a40027?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f95040da1d50d1713b3db51f8e81d50c, https://si.imgix.net/cc20bf52/uploads/origins/0ccce0a3-3e10-4741-a2a2-1b2dd8a40027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9616d8208e60e75b25baadeaf08e8593 2x, https://si.imgix.net/cc20bf52/uploads/origins/0ccce0a3-3e10-4741-a2a2-1b2dd8a40027?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32c25df58258b71d4f98fcc09e4ae99e 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3741639, "client_id": 58174, "nc": 33}, {"path": "/@yodoromeki/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3741639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6b87a95/uploads/origins/e25940a4-961d-4203-809f-9a267a947320?bg=%23fff&au