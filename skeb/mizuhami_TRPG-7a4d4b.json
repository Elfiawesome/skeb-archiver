が悪い。\nインドアなので日差しにはめっぽう弱い。\n燦歌のことは、「よく絡んでくる鬱陶しい女」と思っており雑に扱ってはいるが、邪険にしすぎてしょげた顔をされると結局絆されてしまうため、邪険にしきれない。\n\n構図や設定などは、お手数をおかけしますがおまかせでお願いしたいです……！\n\nここまでお目通しくださり、本当にありがとうございました……！どうかお体にお気をつけてお過ごしください！\nお時間を割いてくださり、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1MYhVtA5Kpx2Zn3Fwafso9IBbP3rZ9ulx", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_urocochan_/works/66", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 725219, "client_id": 2518809, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31226746/uploads/origins/ca5ad492-0a6b-4e94-bbc4-058073dc5f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecd56ffe64fd713cf620ac13d0b2a961", "srcset": "https://si.imgix.net/31226746/uploads/origins/ca5ad492-0a6b-4e94-bbc4-058073dc5f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ecd56ffe64fd713cf620ac13d0b2a961, https://si.imgix.net/31226746/uploads/origins/ca5ad492-0a6b-4e94-bbc4-058073dc5f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=530cc952c897cdc3cf40afebdab6b977 2x, https://si.imgix.net/31226746/uploads/origins/ca5ad492-0a6b-4e94-bbc4-058073dc5f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2564b8b96705a36476bbde1cd2814bbe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31226746/uploads/origins/ca5ad492-0a6b-4e94-bbc4-058073dc5f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9bfc95b795f44f6721ecbcdcc6305d", "srcset": "https://si.imgix.net/31226746/uploads/origins/ca5ad492-0a6b-4e94-bbc4-058073dc5f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6a9bfc95b795f44f6721ecbcdcc6305d, https://si.imgix.net/31226746/uploads/origins/ca5ad492-0a6b-4e94-bbc4-058073dc5f8b?bg=%23fff&