に逃れようとするも服を引き裂かれ処女喪失\n初めてはマスターと決めていたのに、と悔しさで涙を流すエルメダ。「それでも心までは……！」と必死に耐えるが媚薬効果のあるザーメンを中出しされまくった上に、女を孕ませることに特化したデカちんとテクに他の女同様ついには精神崩壊\nその後は肉便器らしくバックから突かれながらゴブリンちんぽにフェラで串刺しにされたり、二穴されたり、自分からゴブリンに跨りM字開脚でゴブリンちんぽをエロまんこで咥えて両手チンポのトロ顔ご奉仕したりと完全に肉便器堕ち\n最後はボスの巨大オークの極太巨根にフルネルソンで犯され、子宮口をこじ開けられて大量の特濃ザーメンを直接腟内射精されアヘ顔受精アクメ\n種づけ完了で極太巨根を抜くと、ゴブリンにまんぐり返しにされたエルメダのまんこはオークの巨の形のまま開きっぱなしで子宮口まで丸見え、ザーメンを大量逆流させながらハイライト消えた目でアヘトロ笑顔するエルメダで暗転\n\n事後、エルメダはボロ服でボテ腹、太股には何人も産まされた印が\n自分の産んだゴブリンに嬲られおっぱいを吸われながらまんことアナルを犯されるも孕み袋として幸せそうにアヘトロ顔でアクメきめながらEND\n\n修正は黒線or白線、psdグレスケ納品、値段再送許可でお願いします\n\nhttps://arcanadea-official.com/character/ermeda/", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hage28hagewo/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7cd68ca4/uploads/origins/6786e4d2-3469-4d99-b5d5-1829e79281e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=013aeac3c8e8bfa4bfdee43a2e77a9c7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 995842, "client_id": 4440, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hage28hagewo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 995842, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68067397/uploads/origins/ffbaeae2-cfbc-4167-9ff4-7f37fb745ae7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b982a618dff3717da450fd78384a761b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68067397/uploads/origins/ffbaeae2-cfbc-4167-9ff4-7f37fb745ae7?bg=%23