n\nぜひともご検討をよろしくお願いいたします。\n\nご参考\nベース\nhttps://x.com/Haku17/status/1685236847876755456\n\nデザインラフ\nhttps://x.com/Haku17/status/1685237653401427968\n\n美竜お姉さん1\nhttps://x.com/sakaya0313/status/1801781415820005571\n\n美竜お姉さん2\n\nhttps://x.com/_bakuinu_/status/1893296727312027884", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Unyo54525350/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1975911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e3ff448/uploads/origins/aa162c69-9382-4549-82bf-6da6f83f676e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3bcb4f5ba1a8c0aff87e2d0f58247e", "srcset": "https://si.imgix.net/8e3ff448/uploads/origins/aa162c69-9382-4549-82bf-6da6f83f676e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c3bcb4f5ba1a8c0aff87e2d0f58247e, https://si.imgix.net/8e3ff448/uploads/origins/aa162c69-9382-4549-82bf-6da6f83f676e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2fa3abbfdeb0b4123631a544a9275ab 2x, https://si.imgix.net/8e3ff448/uploads/origins/aa162c69-9382-4549-82bf-6da6f83f676e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3da6bcdd8ea45eef0024a646df8c03f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e3ff448/uploads/origins/aa162c69-9382-4549-82bf-6da6f83f676e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5f9b63d859485deec2557fd774e8535", "srcset": "https://si.imgix.net/8e3ff448/uploads/origins/aa162c69-9382-4549-82bf-6da6f83f676e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5f9b63d859485deec2557fd774e8535, https://si.imgix.net/8e3ff448/uploads/origins/aa162c69-9382-4549-82bf-6da6f83f676e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cr